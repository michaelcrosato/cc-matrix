{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-cf248bda-8dc9-4245-96cf-064442c4fd06-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"597→    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n600→        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n610→            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n620→    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n630→            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n640→    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n650→        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n660→            f.pressed = buttons::CONFIRM;\\n            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n670→        script(self.route).get(self.step as usize).copied()\\n    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) => \\\"map\\\",\\n680→            Some(Spec::Way) => \\\"waypoint\\\",\\n            Some(Spec::Reach { .. }) => \\\"reach\\\",\\n            Some(Spec::Fever) => \\\"fever\\\",\\n            Some(Spec::Pill) => \\\"pill\\\",\\n            Some(Spec::Blackout) => \\\"blackout\\\",\\n            Some(Spec::Fight) => \\\"fight\\\",\\n            Some(Spec::EnemyJam) => \\\"enemy_jam\\\",\\n            Some(Spec::Jam) => \\\"jam\\\",\\n            Some(Spec::Break) => \\\"break\\\",\\n            Some(Spec::Rescue) => \\\"rescue\\\",\\n690→            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\\n            Some(Spec::Loot) => \\\"loot\\\",\\n            Some(Spec::Claim) => \\\"claim\\\",\\n            Some(Spec::Shop) => \\\"shop\\\",\\n            Some(Spec::Locker) => \\\"locker\\\",\\n            Some(Spec::Syrette) => \\\"syrette\\\",\\n            Some(Spec::Tracker) => \\\"tracker\\\",\\n            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\\n            Some(Spec::Drive { .. }) => \\\"drive\\\",\\n            Some(Spec::Mono) => \\\"mono\\\",\\n700→            Some(Spec::Ignite(n)) => return format!(\\\"ignite{n}\\\"),\\n            Some(Spec::Tanks) => \\\"tanks\\\",\\n            Some(Spec::Mounted) => \\\"mounted\\\",\\n            Some(Spec::Panic) => \\\"panic\\\",\\n            Some(Spec::Animals) => \\\"animals\\\",\\n            Some(Spec::Bus { .. }) => \\\"bus\\\",\\n            Some(Spec::Night) => \\\"night\\\",\\n            Some(Spec::Boat) => \\\"boat\\\",\\n            Some(Spec::Stealth) => \\\"stealth\\\",\\n            Some(Spec::Dart) => \\\"dart\\\",\\n710→            Some(Spec::Repair) => \\\"repair\\\",\\n            Some(Spec::Rain) => \\\"rain\\\",\\n            Some(Spec::Better) => \\\"better\\\",\\n            Some(Spec::Patch) => \\\"patch\\\",\\n            Some(Spec::Overdose) => \\\"overdose\\\",\\n            Some(Spec::Die) => \\\"die\\\",\\n            Some(Spec::Tape) => \\\"tape\\\",\\n            Some(Spec::Ceasefire) => \\\"ceasefire\\\",\\n            Some(Spec::Convoy) => \\\"convoy\\\",\\n            Some(Spec::Town) => \\\"town\\\",\\n720→            Some(Spec::Ending(n)) => return format!(\\\"ending{n}\\\"),\\n            Some(Spec::Flag(s)) => s,\\n            None => \\\"done\\\",\\n        }\\n        .into()\\n    }\\n\\n    pub fn goal_budget(&self) -> f32 {\\n        match self.current() {\\n            Some(Spec::Reach { .. }) => 160.0,\\n730→            Some(Spec::Drive { .. }) => 140.0,\\n            Some(Spec::Boat) => 160.0,\\n            Some(Spec::Bus { .. }) => 90.0,\\n            Some(Spec::Blackout) => 80.0,\\n            Some(Spec::Break) => 90.0,\\n            Some(Spec::Die) => 55.0,\\n            Some(Spec::Ending(1)) => 200.0,\\n            Some(Spec::Sleep { .. }) | Some(Spec::Tracker) => 50.0,\\n            Some(Spec::Fight) | Some(Spec::EnemyJam) => 25.0,\\n            _ => 30.0,\\n740→        }\\n    }\\n\\n    fn advance_script(&mut self, dt: f32) {\\n        if self.finished {\\n            return;\\n        }\\n        self.step_t += dt;\\n        for _ in 0..12 {\\n            let Some(spec) = self.current() else {\\n750→                self.finished = true;\\n                break;\\n            };\\n            if !self.step_ready {\\n                self.begin(spec);\\n                self.step_ready = true;\\n                self.step_t = 0.0;\\n            }\\n            if self.done(spec) {\\n                self.step += 1;\\n760→                self.step_ready = false;\\n                self.step_t = 0.0;\\n            } else {\\n                break;\\n            }\\n        }\\n    }\\n\\n    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n770→        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n780→            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n790→                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n                let g = self.gun_mut();\\n                g.force_jam = true;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n800→            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n810→                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n            Spec::Rescue => {\\n                self.hp = 0.0;\\n                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n820→                }\\n            }\\n            Spec::Wound(n) => {\\n                self.hp = 15.0;\\n                self.wound = n;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n830→                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n840→                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n850→                    self.ride.fuse = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n860→            }\\n            Spec::Panic => {\\n                self.clear_bodies();\\n                let sx = self.x + 4.0;\\n                let sz = self.z - 4.0;\\n                self.spawn_soldier(sx, sz, 40.0, false);\\n                // Runners sprint +x. One 2 m cell ends before flee passes 3.\\n                for i in 0..6 {\\n                    let _ = self.fire.ignite_disk(sx + i as f32 * 4.0, sz, 3.0, self.tune.burn_time, self.minutes);\\n                }\\n870→            }\\n            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n                self.mark(\\\"night_contract\\\");\\n            }\\n            Spec::Sleep { .. } => {\\n880→                // The short rest already set this. The long rest has to happen on its own.\\n                self.flags.remove(\\\"sleep_used\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                self.ride.kind = 2;\\n                self.ride.seat = 1;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.speed = 0.0;\\n890→                self.ride.health = 100.0;\\n                self.x = wx;\\n                self.z = wz;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n900→                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n910→            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n920→            }\\n            Spec::Rain => {\\n                // The boat step leaves you on the channel. Rain has to quench grass, not water.\\n                let mut lit = false;\\n                for r in [16.0, 22.0, 30.0, 40.0] {\\n                    for (dx, dz) in [(r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r)] {\\n                        if self.fire.ignite_at(self.x + dx, self.z + dz, self.tune.burn_time, self.minutes) {\\n                            lit = true;\\n                            break;\\n                        }\\n930→                    }\\n                    if lit {\\n                        break;\\n                    }\\n                }\\n                self.weather = 1;\\n            }\\n            Spec::Better => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n940→                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = self.x + 1.5;\\n                    c.z = self.z;\\n                }\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n950→                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n960→            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n970→            }\\n            Spec::Town => {\\n                let (tx, tz) = geom::place(\\\"Kilometre 40\\\");\\n                self.x = tx;\\n                self.z = tz;\\n                let _ = self.fire.ignite_disk(tx, tz + 20.0, 10.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"town_burned\\\");\\n            }\\n            Spec::Ending(1) => {\\n                self.clear_bodies();\\n980→                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n                self.hold_t = 0.0;\\n            }\\n            Spec::Flag(s) => self.mark(s),\\n            _ => {}\\n        }\\n    }\\n990→\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n1000→                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n1010→                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n1020→                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n1030→            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n1040→            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n1050→            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\\n            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\\n            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n1060→        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape | Spec::Ending(2) => {\\n                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n1070→            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n1080→            Spec::Fight | Spec::Ceasefire | Spec::Convoy | Spec::Ignite(10) => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die | Spec::Ending(1) => {\\n                if matches!(spec, Spec::Ending(1)) {\\n                    f.held = buttons::CROUCH;\\n                }\\n1090→            }\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n1100→            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n1110→                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n1120→            }\\n            Spec::Drive { x, z } => {\\n                let (tx, tz) = (x, z);\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Bus { .. } => {\\n1130→                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n1140→                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => {\\n                if k == 10 {\\n                    f.held = buttons::PRIMARY;\\n                } else if k == 11 {\\n                    f.held = buttons::INTERACT;\\n1150→                    f.pressed = buttons::INTERACT;\\n                } else {\\n                    f.pressed = buttons::PRIMARY;\\n                    f.held = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Tanks | Spec::Mounted => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n                if matches!(spec, Spec::Mounted) {\\n1160→                    f.pressed |= buttons::USE;\\n                }\\n            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => {\\n                let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 50.0);\\n1170→                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n1180→            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Night | Spec::Better | Spec::Flag(_) | Spec::Town | Spec::Ending(0) => {\\n                f.pressed = buttons::INTERACT;\\n            }\\n            _ => {}\\n        }\\n1190→        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n1200→            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n1210→        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        f.axes.y = 1.0;\\n        f\\n    }\\n\\n    fn bot_aim(&self, tx: f32, tz: f32, ty: f32, fire: bool) -> InputFrame {\\n        let dx = tx - self.x;\\n        let dz = tz - self.z;\\n1220→        let dist = (dx * dx + dz * dz).sqrt().max(0.2);\\n        let desired = dx.atan2(-dz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let perr = ((ty - self.eye) / dist).atan() - self.pitch;\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.5, 1.5);\\n        f.look.y = perr.clamp(-1.2, 1.2);\\n        if fire && err.abs() < 0.2 && perr.abs() < 0.2 {\\n            f.held |= buttons::PRIMARY | buttons::SECONDARY;\\n            f.pressed |= buttons::PRIMARY;\\n1230→        }\\n        f\\n    }\\n\\n    pub fn start_playing(&mut self) {\\n        self.screen = Screen::Playing;\\n        let (x, z) = geom::place(\\\"Airstrip\\\");\\n        self.x = x;\\n        self.z = z;\\n        self.yaw = 0.0;\\n1240→        self.eye = 1.58;\\n        self.idle = 0.0;\\n        self.pitch = 0.08;\\n    }\\n\\n    fn simulate(&mut self, input: &InputFrame, dt: f32) {\\n        self.yaw = geom::wrap_angle(self.yaw + input.look.x);\\n        self.pitch = (self.pitch + input.look.y).clamp(-1.15, 1.15);\\n        if self.fever_state == 2 {\\n            self.roll = (self.minutes * 2.0).sin() * 0.05 * self.tune.fever_severity;\\n1250→        } else {\\n            self.roll *= 0.9;\\n        }\\n        if input.down(buttons::CRAWL) {\\n            self.stance = 2;\\n        } else if input.down(buttons::CROUCH) {\\n            self.stance = 1;\\n        } else if !self.treating {\\n            self.stance = 0;\\n        }\\n1260→        let target_eye = match self.stance {\\n            2 => 0.42,\\n            1 => 1.02,\\n            _ => 1.58,\\n        };\\n        let k = 1.0 - (-dt / 0.12).exp();\\n        self.eye += (target_eye - self.eye) * k;\\n\\n        if input.down(buttons::MAP) {\\n            self.map_t += dt;\\n1270→            if self.map_t > 0.35 {\\n                self.mark(\\\"map_raised\\\");\\n            }\\n        }\\n        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\\n            self.waypoint = Some((0.0, 460.0));\\n            self.mark(\\\"waypoint_set\\\");\\n        }\\n        if input.down(buttons::MONOCULAR) {\\n            self.mono_t += dt;\\n1280→            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\\n                self.mark(\\\"monocular_tag\\\");\\n            }\\n        } else {\\n            self.mono_t = 0.0;\\n        }\\n\\n        self.move_body(input, dt);\\n        self.use_vehicle(input, dt);\\n        self.handle_items(input, dt);\\n1290→        self.handle_gun(input, dt);\\n        self.update_bodies(dt);\\n        self.update_fever(dt);\\n        self.update_rescue(dt);\\n        let rain = self.weather == 1;\\n        let wind = self.wind * self.tune.wind_strength;\\n        let out = self.fire.tick(dt, wind, self.tune.fire_spread, self.tune.burn_time, self.minutes, rain, &mut self.rng);\\n        if out > 0 {\\n            self.mark(\\\"rain_extinguished\\\");\\n            self.weather = 0;\\n1300→        }\\n        if self.fire.burned >= 500 {\\n            self.mark(\\\"cells_500\\\");\\n        }\\n        self.special_actions(input, dt);\\n        if self.hp > 20.0 && self.hp < 100.0 && self.rescue_t <= 0.0 && !self.dev.god {\\n            self.hp = (self.hp + 8.0 * dt).min(100.0);\\n        }\\n        if self.dev.god {\\n            self.hp = 100.0;\\n1310→        }\\n    }\\n\\n    fn move_body(&mut self, input: &InputFrame, dt: f32) {\\n        if self.ride.seat != 0 || self.rescue_t > 0.0 || self.treating {\\n            return;\\n        }\\n        let (sy, cy) = self.yaw.sin_cos();\\n        let fwd = Vec2::new(sy, -cy);\\n        let right = Vec2::new(cy, sy);\\n1320→        let wish = right * input.move_dir.x + fwd * input.move_dir.y;\\n        let sprint = input.down(buttons::FOCUS) && self.stamina > 0.0 && self.stance == 0;\\n        let mut speed = if input.down(buttons::SECONDARY) { 3.0 } else { 4.6 };\\n        if sprint {\\n            speed = 7.0;\\n            self.stamina = (self.stamina - dt).max(0.0);\\n        } else if !input.down(buttons::FOCUS) {\\n            self.stamina = (self.stamina + dt * 2.0).min(12.0);\\n        }\\n        speed *= match self.stance {\\n1330→            1 => 0.55,\\n            2 => 0.28,\\n            _ => 1.0,\\n        };\\n        if self.fever_state == 2 {\\n            speed *= 0.75;\\n        }\\n        speed *= self.tune.player_speed;\\n        let diff = match self.difficulty {\\n            0 => 1.05,\\n1340→            2 => 0.95,\\n            _ => 1.0,\\n        };\\n        speed *= diff;\\n        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\",\"content_concise\":\"597→    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n600→        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n610→            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n620→    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n630→            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n640→    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n650→        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n660→            f.pressed = buttons::CONFIRM;\\n            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n670→        script(self.route).get(self.step as usize).copied()\\n    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) => \\\"map\\\",\\n680→            Some(Spec::Way) => \\\"waypoint\\\",\\n            Some(Spec::Reach { .. }) => \\\"reach\\\",\\n            Some(Spec::Fever) => \\\"fever\\\",\\n            Some(Spec::Pill) => \\\"pill\\\",\\n            Some(Spec::Blackout) => \\\"blackout\\\",\\n            Some(Spec::Fight) => \\\"fight\\\",\\n            Some(Spec::EnemyJam) => \\\"enemy_jam\\\",\\n            Some(Spec::Jam) => \\\"jam\\\",\\n            Some(Spec::Break) => \\\"break\\\",\\n            Some(Spec::Rescue) => \\\"rescue\\\",\\n690→            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\\n            Some(Spec::Loot) => \\\"loot\\\",\\n            Some(Spec::Claim) => \\\"claim\\\",\\n            Some(Spec::Shop) => \\\"shop\\\",\\n            Some(Spec::Locker) => \\\"locker\\\",\\n            Some(Spec::Syrette) => \\\"syrette\\\",\\n            Some(Spec::Tracker) => \\\"tracker\\\",\\n            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\\n            Some(Spec::Drive { .. }) => \\\"drive\\\",\\n            Some(Spec::Mono) => \\\"mono\\\",\\n700→            Some(Spec::Ignite(n)) => return format!(\\\"ignite{n}\\\"),\\n            Some(Spec::Tanks) => \\\"tanks\\\",\\n            Some(Spec::Mounted) => \\\"mounted\\\",\\n            Some(Spec::Panic) => \\\"panic\\\",\\n            Some(Spec::Animals) => \\\"animals\\\",\\n            Some(Spec::Bus { .. }) => \\\"bus\\\",\\n            Some(Spec::Night) => \\\"night\\\",\\n            Some(Spec::Boat) => \\\"boat\\\",\\n            Some(Spec::Stealth) => \\\"stealth\\\",\\n            Some(Spec::Dart) => \\\"dart\\\",\\n710→            Some(Spec::Repair) => \\\"repair\\\",\\n            Some(Spec::Rain) => \\\"rain\\\",\\n            Some(Spec::Better) => \\\"better\\\",\\n            Some(Spec::Patch) => \\\"patch\\\",\\n            Some(Spec::Overdose) => \\\"overdose\\\",\\n            Some(Spec::Die) => \\\"die\\\",\\n            Some(Spec::Tape) => \\\"tape\\\",\\n            Some(Spec::Ceasefire) => \\\"ceasefire\\\",\\n            Some(Spec::Convoy) => \\\"convoy\\\",\\n            Some(Spec::Town) => \\\"town\\\",\\n720→            Some(Spec::Ending(n)) => return format!(\\\"ending{n}\\\"),\\n            Some(Spec::Flag(s)) => s,\\n            None => \\\"done\\\",\\n        }\\n        .into()\\n    }\\n\\n    pub fn goal_budget(&self) -> f32 {\\n        match self.current() {\\n            Some(Spec::Reach { .. }) => 160.0,\\n730→            Some(Spec::Drive { .. }) => 140.0,\\n            Some(Spec::Boat) => 160.0,\\n            Some(Spec::Bus { .. }) => 90.0,\\n            Some(Spec::Blackout) => 80.0,\\n            Some(Spec::Break) => 90.0,\\n            Some(Spec::Die) => 55.0,\\n            Some(Spec::Ending(1)) => 200.0,\\n            Some(Spec::Sleep { .. }) | Some(Spec::Tracker) => 50.0,\\n            Some(Spec::Fight) | Some(Spec::EnemyJam) => 25.0,\\n            _ => 30.0,\\n740→        }\\n    }\\n\\n    fn advance_script(&mut self, dt: f32) {\\n        if self.finished {\\n            return;\\n        }\\n        self.step_t += dt;\\n        for _ in 0..12 {\\n            let Some(spec) = self.current() else {\\n750→                self.finished = true;\\n                break;\\n            };\\n            if !self.step_ready {\\n                self.begin(spec);\\n                self.step_ready = true;\\n                self.step_t = 0.0;\\n            }\\n            if self.done(spec) {\\n                self.step += 1;\\n760→                self.step_ready = false;\\n                self.step_t = 0.0;\\n            } else {\\n                break;\\n            }\\n        }\\n    }\\n\\n    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n770→        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n780→            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n790→                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n                let g = self.gun_mut();\\n                g.force_jam = true;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n800→            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n810→                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n            Spec::Rescue => {\\n                self.hp = 0.0;\\n                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n820→                }\\n            }\\n            Spec::Wound(n) => {\\n                self.hp = 15.0;\\n                self.wound = n;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n830→                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n840→                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n850→                    self.ride.fuse = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n860→            }\\n            Spec::Panic => {\\n                self.clear_bodies();\\n                let sx = self.x + 4.0;\\n                let sz = self.z - 4.0;\\n                self.spawn_soldier(sx, sz, 40.0, false);\\n                // Runners sprint +x. One 2 m cell ends before flee passes 3.\\n                for i in 0..6 {\\n                    let _ = self.fire.ignite_disk(sx + i as f32 * 4.0, sz, 3.0, self.tune.burn_time, self.minutes);\\n                }\\n870→            }\\n            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n                self.mark(\\\"night_contract\\\");\\n            }\\n            Spec::Sleep { .. } => {\\n880→                // The short rest already set this. The long rest has to happen on its own.\\n                self.flags.remove(\\\"sleep_used\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                self.ride.kind = 2;\\n                self.ride.seat = 1;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.speed = 0.0;\\n890→                self.ride.health = 100.0;\\n                self.x = wx;\\n                self.z = wz;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n900→                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n910→            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n920→            }\\n            Spec::Rain => {\\n                // The boat step leaves you on the channel. Rain has to quench grass, not water.\\n                let mut lit = false;\\n                for r in [16.0, 22.0, 30.0, 40.0] {\\n                    for (dx, dz) in [(r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r)] {\\n                        if self.fire.ignite_at(self.x + dx, self.z + dz, self.tune.burn_time, self.minutes) {\\n                            lit = true;\\n                            break;\\n                        }\\n930→                    }\\n                    if lit {\\n                        break;\\n                    }\\n                }\\n                self.weather = 1;\\n            }\\n            Spec::Better => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n940→                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = self.x + 1.5;\\n                    c.z = self.z;\\n                }\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n950→                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n960→            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n970→            }\\n            Spec::Town => {\\n                let (tx, tz) = geom::place(\\\"Kilometre 40\\\");\\n                self.x = tx;\\n                self.z = tz;\\n                let _ = self.fire.ignite_disk(tx, tz + 20.0, 10.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"town_burned\\\");\\n            }\\n            Spec::Ending(1) => {\\n                self.clear_bodies();\\n980→                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n                self.hold_t = 0.0;\\n            }\\n            Spec::Flag(s) => self.mark(s),\\n            _ => {}\\n        }\\n    }\\n990→\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n1000→                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n1010→                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n1020→                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n1030→            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n1040→            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n1050→            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\\n            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\\n            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n1060→        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape | Spec::Ending(2) => {\\n                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n1070→            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n1080→            Spec::Fight | Spec::Ceasefire | Spec::Convoy | Spec::Ignite(10) => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die | Spec::Ending(1) => {\\n                if matches!(spec, Spec::Ending(1)) {\\n                    f.held = buttons::CROUCH;\\n                }\\n1090→            }\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n1100→            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n1110→                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n1120→            }\\n            Spec::Drive { x, z } => {\\n                let (tx, tz) = (x, z);\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Bus { .. } => {\\n1130→                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n1140→                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => {\\n                if k == 10 {\\n                    f.held = buttons::PRIMARY;\\n                } else if k == 11 {\\n                    f.held = buttons::INTERACT;\\n1150→                    f.pressed = buttons::INTERACT;\\n                } else {\\n                    f.pressed = buttons::PRIMARY;\\n                    f.held = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Tanks | Spec::Mounted => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n                if matches!(spec, Spec::Mounted) {\\n1160→                    f.pressed |= buttons::USE;\\n                }\\n            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => {\\n                let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 50.0);\\n1170→                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n1180→            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Night | Spec::Better | Spec::Flag(_) | Spec::Town | Spec::Ending(0) => {\\n                f.pressed = buttons::INTERACT;\\n            }\\n            _ => {}\\n        }\\n1190→        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n1200→            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n1210→        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        f.axes.y = 1.0;\\n        f\\n    }\\n\\n    fn bot_aim(&self, tx: f32, tz: f32, ty: f32, fire: bool) -> InputFrame {\\n        let dx = tx - self.x;\\n        let dz = tz - self.z;\\n1220→        let dist = (dx * dx + dz * dz).sqrt().max(0.2);\\n        let desired = dx.atan2(-dz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let perr = ((ty - self.eye) / dist).atan() - self.pitch;\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.5, 1.5);\\n        f.look.y = perr.clamp(-1.2, 1.2);\\n        if fire && err.abs() < 0.2 && perr.abs() < 0.2 {\\n            f.held |= buttons::PRIMARY | buttons::SECONDARY;\\n            f.pressed |= buttons::PRIMARY;\\n1230→        }\\n        f\\n    }\\n\\n    pub fn start_playing(&mut self) {\\n        self.screen = Screen::Playing;\\n        let (x, z) = geom::place(\\\"Airstrip\\\");\\n        self.x = x;\\n        self.z = z;\\n        self.yaw = 0.0;\\n1240→        self.eye = 1.58;\\n        self.idle = 0.0;\\n        self.pitch = 0.08;\\n    }\\n\\n    fn simulate(&mut self, input: &InputFrame, dt: f32) {\\n        self.yaw = geom::wrap_angle(self.yaw + input.look.x);\\n        self.pitch = (self.pitch + input.look.y).clamp(-1.15, 1.15);\\n        if self.fever_state == 2 {\\n            self.roll = (self.minutes * 2.0).sin() * 0.05 * self.tune.fever_severity;\\n1250→        } else {\\n            self.roll *= 0.9;\\n        }\\n        if input.down(buttons::CRAWL) {\\n            self.stance = 2;\\n        } else if input.down(buttons::CROUCH) {\\n            self.stance = 1;\\n        } else if !self.treating {\\n            self.stance = 0;\\n        }\\n1260→        let target_eye = match self.stance {\\n            2 => 0.42,\\n            1 => 1.02,\\n            _ => 1.58,\\n        };\\n        let k = 1.0 - (-dt / 0.12).exp();\\n        self.eye += (target_eye - self.eye) * k;\\n\\n        if input.down(buttons::MAP) {\\n            self.map_t += dt;\\n1270→            if self.map_t > 0.35 {\\n                self.mark(\\\"map_raised\\\");\\n            }\\n        }\\n        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\\n            self.waypoint = Some((0.0, 460.0));\\n            self.mark(\\\"waypoint_set\\\");\\n        }\\n        if input.down(buttons::MONOCULAR) {\\n            self.mono_t += dt;\\n1280→            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\\n                self.mark(\\\"monocular_tag\\\");\\n            }\\n        } else {\\n            self.mono_t = 0.0;\\n        }\\n\\n        self.move_body(input, dt);\\n        self.use_vehicle(input, dt);\\n        self.handle_items(input, dt);\\n1290→        self.handle_gun(input, dt);\\n        self.update_bodies(dt);\\n        self.update_fever(dt);\\n        self.update_rescue(dt);\\n        let rain = self.weather == 1;\\n        let wind = self.wind * self.tune.wind_strength;\\n        let out = self.fire.tick(dt, wind, self.tune.fire_spread, self.tune.burn_time, self.minutes, rain, &mut self.rng);\\n        if out > 0 {\\n            self.mark(\\\"rain_extinguished\\\");\\n            self.weather = 0;\\n1300→        }\\n        if self.fire.burned >= 500 {\\n            self.mark(\\\"cells_500\\\");\\n        }\\n        self.special_actions(input, dt);\\n        if self.hp > 20.0 && self.hp < 100.0 && self.rescue_t <= 0.0 && !self.dev.god {\\n            self.hp = (self.hp + 8.0 * dt).min(100.0);\\n        }\\n        if self.dev.god {\\n            self.hp = 100.0;\\n1310→        }\\n    }\\n\\n    fn move_body(&mut self, input: &InputFrame, dt: f32) {\\n        if self.ride.seat != 0 || self.rescue_t > 0.0 || self.treating {\\n            return;\\n        }\\n        let (sy, cy) = self.yaw.sin_cos();\\n        let fwd = Vec2::new(sy, -cy);\\n        let right = Vec2::new(cy, sy);\\n1320→        let wish = right * input.move_dir.x + fwd * input.move_dir.y;\\n        let sprint = input.down(buttons::FOCUS) && self.stamina > 0.0 && self.stance == 0;\\n        let mut speed = if input.down(buttons::SECONDARY) { 3.0 } else { 4.6 };\\n        if sprint {\\n            speed = 7.0;\\n            self.stamina = (self.stamina - dt).max(0.0);\\n        } else if !input.down(buttons::FOCUS) {\\n            self.stamina = (self.stamina + dt * 2.0).min(12.0);\\n        }\\n        speed *= match self.stance {\\n1330→            1 => 0.55,\\n            2 => 0.28,\\n            _ => 1.0,\\n        };\\n        if self.fever_state == 2 {\\n            speed *= 0.75;\\n        }\\n        speed *= self.tune.player_speed;\\n        let diff = match self.difficulty {\\n            0 => 1.05,\\n1340→            2 => 0.95,\\n            _ => 1.0,\\n        };\\n        speed *= diff;\\n        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":597,\"limit\":750,\"raw_output\":\"    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n        script(self.route).get(self.step as usize).copied()\\n    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) => \\\"map\\\",\\n            Some(Spec::Way) => \\\"waypoint\\\",\\n            Some(Spec::Reach { .. }) => \\\"reach\\\",\\n            Some(Spec::Fever) => \\\"fever\\\",\\n            Some(Spec::Pill) => \\\"pill\\\",\\n            Some(Spec::Blackout) => \\\"blackout\\\",\\n            Some(Spec::Fight) => \\\"fight\\\",\\n            Some(Spec::EnemyJam) => \\\"enemy_jam\\\",\\n            Some(Spec::Jam) => \\\"jam\\\",\\n            Some(Spec::Break) => \\\"break\\\",\\n            Some(Spec::Rescue) => \\\"rescue\\\",\\n            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\\n            Some(Spec::Loot) => \\\"loot\\\",\\n            Some(Spec::Claim) => \\\"claim\\\",\\n            Some(Spec::Shop) => \\\"shop\\\",\\n            Some(Spec::Locker) => \\\"locker\\\",\\n            Some(Spec::Syrette) => \\\"syrette\\\",\\n            Some(Spec::Tracker) => \\\"tracker\\\",\\n            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\\n            Some(Spec::Drive { .. }) => \\\"drive\\\",\\n            Some(Spec::Mono) => \\\"mono\\\",\\n            Some(Spec::Ignite(n)) => return format!(\\\"ignite{n}\\\"),\\n            Some(Spec::Tanks) => \\\"tanks\\\",\\n            Some(Spec::Mounted) => \\\"mounted\\\",\\n            Some(Spec::Panic) => \\\"panic\\\",\\n            Some(Spec::Animals) => \\\"animals\\\",\\n            Some(Spec::Bus { .. }) => \\\"bus\\\",\\n            Some(Spec::Night) => \\\"night\\\",\\n            Some(Spec::Boat) => \\\"boat\\\",\\n            Some(Spec::Stealth) => \\\"stealth\\\",\\n            Some(Spec::Dart) => \\\"dart\\\",\\n            Some(Spec::Repair) => \\\"repair\\\",\\n            Some(Spec::Rain) => \\\"rain\\\",\\n            Some(Spec::Better) => \\\"better\\\",\\n            Some(Spec::Patch) => \\\"patch\\\",\\n            Some(Spec::Overdose) => \\\"overdose\\\",\\n            Some(Spec::Die) => \\\"die\\\",\\n            Some(Spec::Tape) => \\\"tape\\\",\\n            Some(Spec::Ceasefire) => \\\"ceasefire\\\",\\n            Some(Spec::Convoy) => \\\"convoy\\\",\\n            Some(Spec::Town) => \\\"town\\\",\\n            Some(Spec::Ending(n)) => return format!(\\\"ending{n}\\\"),\\n            Some(Spec::Flag(s)) => s,\\n            None => \\\"done\\\",\\n        }\\n        .into()\\n    }\\n\\n    pub fn goal_budget(&self) -> f32 {\\n        match self.current() {\\n            Some(Spec::Reach { .. }) => 160.0,\\n            Some(Spec::Drive { .. }) => 140.0,\\n            Some(Spec::Boat) => 160.0,\\n            Some(Spec::Bus { .. }) => 90.0,\\n            Some(Spec::Blackout) => 80.0,\\n            Some(Spec::Break) => 90.0,\\n            Some(Spec::Die) => 55.0,\\n            Some(Spec::Ending(1)) => 200.0,\\n            Some(Spec::Sleep { .. }) | Some(Spec::Tracker) => 50.0,\\n            Some(Spec::Fight) | Some(Spec::EnemyJam) => 25.0,\\n            _ => 30.0,\\n        }\\n    }\\n\\n    fn advance_script(&mut self, dt: f32) {\\n        if self.finished {\\n            return;\\n        }\\n        self.step_t += dt;\\n        for _ in 0..12 {\\n            let Some(spec) = self.current() else {\\n                self.finished = true;\\n                break;\\n            };\\n            if !self.step_ready {\\n                self.begin(spec);\\n                self.step_ready = true;\\n                self.step_t = 0.0;\\n            }\\n            if self.done(spec) {\\n                self.step += 1;\\n                self.step_ready = false;\\n                self.step_t = 0.0;\\n            } else {\\n                break;\\n            }\\n        }\\n    }\\n\\n    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n                let g = self.gun_mut();\\n                g.force_jam = true;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n            Spec::Rescue => {\\n                self.hp = 0.0;\\n                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n                }\\n            }\\n            Spec::Wound(n) => {\\n                self.hp = 15.0;\\n                self.wound = n;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n                    self.ride.fuse = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n            }\\n            Spec::Panic => {\\n                self.clear_bodies();\\n                let sx = self.x + 4.0;\\n                let sz = self.z - 4.0;\\n                self.spawn_soldier(sx, sz, 40.0, false);\\n                // Runners sprint +x. One 2 m cell ends before flee passes 3.\\n                for i in 0..6 {\\n                    let _ = self.fire.ignite_disk(sx + i as f32 * 4.0, sz, 3.0, self.tune.burn_time, self.minutes);\\n                }\\n            }\\n            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n                self.mark(\\\"night_contract\\\");\\n            }\\n            Spec::Sleep { .. } => {\\n                // The short rest already set this. The long rest has to happen on its own.\\n                self.flags.remove(\\\"sleep_used\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                self.ride.kind = 2;\\n                self.ride.seat = 1;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.speed = 0.0;\\n                self.ride.health = 100.0;\\n                self.x = wx;\\n                self.z = wz;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n            }\\n            Spec::Rain => {\\n                // The boat step leaves you on the channel. Rain has to quench grass, not water.\\n                let mut lit = false;\\n                for r in [16.0, 22.0, 30.0, 40.0] {\\n                    for (dx, dz) in [(r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r)] {\\n                        if self.fire.ignite_at(self.x + dx, self.z + dz, self.tune.burn_time, self.minutes) {\\n                            lit = true;\\n                            break;\\n                        }\\n                    }\\n                    if lit {\\n                        break;\\n                    }\\n                }\\n                self.weather = 1;\\n            }\\n            Spec::Better => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = self.x + 1.5;\\n                    c.z = self.z;\\n                }\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Town => {\\n                let (tx, tz) = geom::place(\\\"Kilometre 40\\\");\\n                self.x = tx;\\n                self.z = tz;\\n                let _ = self.fire.ignite_disk(tx, tz + 20.0, 10.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"town_burned\\\");\\n            }\\n            Spec::Ending(1) => {\\n                self.clear_bodies();\\n                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n                self.hold_t = 0.0;\\n            }\\n            Spec::Flag(s) => self.mark(s),\\n            _ => {}\\n        }\\n    }\\n\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\\n            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\\n            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape | Spec::Ending(2) => {\\n                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n            Spec::Fight | Spec::Ceasefire | Spec::Convoy | Spec::Ignite(10) => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die | Spec::Ending(1) => {\\n                if matches!(spec, Spec::Ending(1)) {\\n                    f.held = buttons::CROUCH;\\n                }\\n            }\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n            }\\n            Spec::Drive { x, z } => {\\n                let (tx, tz) = (x, z);\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Bus { .. } => {\\n                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => {\\n                if k == 10 {\\n                    f.held = buttons::PRIMARY;\\n                } else if k == 11 {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                } else {\\n                    f.pressed = buttons::PRIMARY;\\n                    f.held = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Tanks | Spec::Mounted => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n                if matches!(spec, Spec::Mounted) {\\n                    f.pressed |= buttons::USE;\\n                }\\n            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => {\\n                let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 50.0);\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Night | Spec::Better | Spec::Flag(_) | Spec::Town | Spec::Ending(0) => {\\n                f.pressed = buttons::INTERACT;\\n            }\\n            _ => {}\\n        }\\n        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        f.axes.y = 1.0;\\n        f\\n    }\\n\\n    fn bot_aim(&self, tx: f32, tz: f32, ty: f32, fire: bool) -> InputFrame {\\n        let dx = tx - self.x;\\n        let dz = tz - self.z;\\n        let dist = (dx * dx + dz * dz).sqrt().max(0.2);\\n        let desired = dx.atan2(-dz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let perr = ((ty - self.eye) / dist).atan() - self.pitch;\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.5, 1.5);\\n        f.look.y = perr.clamp(-1.2, 1.2);\\n        if fire && err.abs() < 0.2 && perr.abs() < 0.2 {\\n            f.held |= buttons::PRIMARY | buttons::SECONDARY;\\n            f.pressed |= buttons::PRIMARY;\\n        }\\n        f\\n    }\\n\\n    pub fn start_playing(&mut self) {\\n        self.screen = Screen::Playing;\\n        let (x, z) = geom::place(\\\"Airstrip\\\");\\n        self.x = x;\\n        self.z = z;\\n        self.yaw = 0.0;\\n        self.eye = 1.58;\\n        self.idle = 0.0;\\n        self.pitch = 0.08;\\n    }\\n\\n    fn simulate(&mut self, input: &InputFrame, dt: f32) {\\n        self.yaw = geom::wrap_angle(self.yaw + input.look.x);\\n        self.pitch = (self.pitch + input.look.y).clamp(-1.15, 1.15);\\n        if self.fever_state == 2 {\\n            self.roll = (self.minutes * 2.0).sin() * 0.05 * self.tune.fever_severity;\\n        } else {\\n            self.roll *= 0.9;\\n        }\\n        if input.down(buttons::CRAWL) {\\n            self.stance = 2;\\n        } else if input.down(buttons::CROUCH) {\\n            self.stance = 1;\\n        } else if !self.treating {\\n            self.stance = 0;\\n        }\\n        let target_eye = match self.stance {\\n            2 => 0.42,\\n            1 => 1.02,\\n            _ => 1.58,\\n        };\\n        let k = 1.0 - (-dt / 0.12).exp();\\n        self.eye += (target_eye - self.eye) * k;\\n\\n        if input.down(buttons::MAP) {\\n            self.map_t += dt;\\n            if self.map_t > 0.35 {\\n                self.mark(\\\"map_raised\\\");\\n            }\\n        }\\n        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\\n            self.waypoint = Some((0.0, 460.0));\\n            self.mark(\\\"waypoint_set\\\");\\n        }\\n        if input.down(buttons::MONOCULAR) {\\n            self.mono_t += dt;\\n            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\\n                self.mark(\\\"monocular_tag\\\");\\n            }\\n        } else {\\n            self.mono_t = 0.0;\\n        }\\n\\n        self.move_body(input, dt);\\n        self.use_vehicle(input, dt);\\n        self.handle_items(input, dt);\\n        self.handle_gun(input, dt);\\n        self.update_bodies(dt);\\n        self.update_fever(dt);\\n        self.update_rescue(dt);\\n        let rain = self.weather == 1;\\n        let wind = self.wind * self.tune.wind_strength;\\n        let out = self.fire.tick(dt, wind, self.tune.fire_spread, self.tune.burn_time, self.minutes, rain, &mut self.rng);\\n        if out > 0 {\\n            self.mark(\\\"rain_extinguished\\\");\\n            self.weather = 0;\\n        }\\n        if self.fire.burned >= 500 {\\n            self.mark(\\\"cells_500\\\");\\n        }\\n        self.special_actions(input, dt);\\n        if self.hp > 20.0 && self.hp < 100.0 && self.rescue_t <= 0.0 && !self.dev.god {\\n            self.hp = (self.hp + 8.0 * dt).min(100.0);\\n        }\\n        if self.dev.god {\\n            self.hp = 100.0;\\n        }\\n    }\\n\\n    fn move_body(&mut self, input: &InputFrame, dt: f32) {\\n        if self.ride.seat != 0 || self.rescue_t > 0.0 || self.treating {\\n            return;\\n        }\\n        let (sy, cy) = self.yaw.sin_cos();\\n        let fwd = Vec2::new(sy, -cy);\\n        let right = Vec2::new(cy, sy);\\n        let wish = right * input.move_dir.x + fwd * input.move_dir.y;\\n        let sprint = input.down(buttons::FOCUS) && self.stamina > 0.0 && self.stance == 0;\\n        let mut speed = if input.down(buttons::SECONDARY) { 3.0 } else { 4.6 };\\n        if sprint {\\n            speed = 7.0;\\n            self.stamina = (self.stamina - dt).max(0.0);\\n        } else if !input.down(buttons::FOCUS) {\\n            self.stamina = (self.stamina + dt * 2.0).min(12.0);\\n        }\\n        speed *= match self.stance {\\n            1 => 0.55,\\n            2 => 0.28,\\n            _ => 1.0,\\n        };\\n        if self.fever_state == 2 {\\n            speed *= 0.75;\\n        }\\n        speed *= self.tune.player_speed;\\n        let diff = match self.difficulty {\\n            0 => 1.05,\\n            2 => 0.95,\\n            _ => 1.0,\\n        };\\n        speed *= diff;\\n        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\\n\",\"total_lines\":2449}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"3c474482-1667-4f34-ab76-2eaa8171ec10"}
{"type":"assistant","message":{"id":"msg_432","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"tool_use","id":"call-318b9894-b811-47d1-820f-2425dd4307e9-11","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs","offset":1344,"limit":700}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8347,"output_tokens":145,"cache_read_input_tokens":56192,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"03631399-5794-4abf-ae43-f4208d38fe95"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-318b9894-b811-47d1-820f-2425dd4307e9-11","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1344→        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\\n            self.z += n.y * speed * dt;\\n        }\\n        let (x, z) = geom::clamp_map(self.x, self.z);\\n1350→        self.x = x;\\n        self.z = z;\\n    }\\n\\n    fn use_vehicle(&mut self, input: &InputFrame, dt: f32) {\\n        if input.just(buttons::USE) && self.ride.kind != 0 {\\n            self.ride.seat = (self.ride.seat + 1) % 3;\\n            if self.ride.seat == 2 {\\n                // gunner\\n            }\\n1360→        }\\n        if self.ride.seat == 0 {\\n            if self.ride.kind != 0 && geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 5.0 && input.down(buttons::INTERACT) {\\n                self.ride.repair += dt;\\n                if self.ride.repair >= 6.0 && self.ride.health < 70.0 {\\n                    self.ride.health = 70.0;\\n                    self.ride.stage = 1;\\n                    self.ride.fuse = 0.0;\\n                    self.ride.repair = 0.0;\\n                    self.mark(\\\"repair_done\\\");\\n1370→                }\\n            }\\n            return;\\n        }\\n        let steer = input.axes.x;\\n        self.ride.yaw = geom::wrap_angle(self.ride.yaw + steer * dt * 1.6);\\n        let mut max_s = 16.0 * self.tune.vehicle_speed;\\n        if self.ride.stage == 2 {\\n            max_s *= 0.6;\\n        }\\n1380→        if self.ride.stage >= 3 {\\n            max_s *= 0.2;\\n        }\\n        if self.ride.kind == 2 && !geom::deep_water(self.ride.x, self.ride.z) {\\n            max_s = 0.0;\\n        }\\n        let throttle = input.axes.y;\\n        self.ride.speed += (throttle.clamp(-0.4, 1.0) * max_s - self.ride.speed) * (dt * 2.5).min(1.0);\\n        let (sy, cy) = self.ride.yaw.sin_cos();\\n        let before = (self.ride.x, self.ride.z);\\n1390→        self.ride.x += sy * self.ride.speed * dt;\\n        self.ride.z += -cy * self.ride.speed * dt;\\n        let (x, z) = geom::clamp_map(self.ride.x, self.ride.z);\\n        self.ride.x = x;\\n        self.ride.z = z;\\n        self.ride.dist += geom::dist(before.0, before.1, self.ride.x, self.ride.z);\\n        let h = geom::height(self.ride.x, self.ride.z);\\n        let h2 = geom::height(self.ride.x + sy * 2.0, self.ride.z - cy * 2.0);\\n        self.ride.pitch = (h2 - h).atan();\\n        if self.ride.roll.abs() > 0.02 {\\n1400→            self.ride.roll *= (1.0 - dt * 3.0).clamp(0.0, 1.0);\\n        }\\n        self.x = self.ride.x;\\n        self.z = self.ride.z;\\n        if self.ride.kind == 1 && self.ride.dist > 20.0 {\\n            self.mark(\\\"technical_driven\\\");\\n        }\\n        if self.ride.kind == 2 && self.ride.dist > 15.0 && geom::deep_water(self.ride.x, self.ride.z) {\\n            self.mark(\\\"boat_driven\\\");\\n            self.boat_dist = self.ride.dist;\\n1410→        }\\n        if self.ride.seat == 2 && input.down(buttons::PRIMARY) {\\n            self.mark(\\\"mounted_gun\\\");\\n        }\\n        if self.ride.stage == 3 {\\n            self.ride.fuse -= dt;\\n            if self.ride.fuse <= 0.0 {\\n                self.ride.stage = 4;\\n                self.ride.health = 0.0;\\n                let _ = self.fire.ignite_disk(self.ride.x, self.ride.z, 6.0, self.tune.burn_time, self.minutes);\\n1420→                self.mark(\\\"ignite_vehicle\\\");\\n            }\\n        }\\n        if self.ride.npc {\\n            let points = [(0.0, 800.0), (0.0, 400.0), (0.0, 0.0), (0.0, -400.0)];\\n            let target = points[self.ride.npc_i % points.len()];\\n            if geom::dist(self.ride.x, self.ride.z, target.0, target.1) < 8.0 {\\n                self.ride.npc_i += 1;\\n            }\\n            let desired = geom::yaw_toward(self.ride.x, self.ride.z, target.0, target.1);\\n1430→            let err = geom::wrap_angle(desired - self.ride.yaw);\\n            self.ride.yaw = geom::wrap_angle(self.ride.yaw + err.clamp(-1.0, 1.0) * dt * 2.0);\\n            self.ride.speed = 10.0;\\n        }\\n    }\\n\\n    pub fn hurt_vehicle(&mut self, dmg: f32) {\\n        if self.ride.kind == 0 || self.ride.stage == 4 {\\n            return;\\n        }\\n1440→        self.ride.health -= dmg / self.tune.vehicle_tough.max(0.2);\\n        if self.ride.health > 70.0 {\\n            self.ride.stage = 0;\\n        } else if self.ride.health > 40.0 {\\n            self.ride.stage = 1;\\n        } else if self.ride.health > 15.0 {\\n            self.ride.stage = 2;\\n        } else if self.ride.health > 0.0 {\\n            if self.ride.stage < 3 {\\n                self.ride.fuse = 8.0;\\n1450→            }\\n            self.ride.stage = 3;\\n        } else {\\n            self.ride.stage = 4;\\n        }\\n    }\\n\\n    fn handle_items(&mut self, input: &InputFrame, dt: f32) {\\n        if input.just(buttons::HEAL) && self.hp >= 20.0 && self.hp < 100.0 && self.syrettes > 0 && self.syrette_t <= 0.0 {\\n            self.syrettes -= 1;\\n1460→            self.syrette_t = 1.5;\\n        }\\n        if self.syrette_t > 0.0 {\\n            let step = dt.min(self.syrette_t);\\n            self.hp = (self.hp + self.tune.syrette_heal / 1.5 * step).min(100.0);\\n            self.syrette_t -= step;\\n            if self.syrette_t <= 0.0 {\\n                self.syrette_t = 0.0;\\n                self.mark(\\\"syrette\\\");\\n            }\\n1470→        }\\n        if self.hp < 20.0 && self.hp > 0.0 && input.down(buttons::HEAL) {\\n            self.treating = true;\\n            self.heal_t += dt;\\n            if self.heal_t >= 4.0 {\\n                self.hp = 40.0;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n                self.mark(wound_flag(self.wound.max(1)));\\n                self.wound = 0;\\n1480→            }\\n        } else if self.hp >= 20.0 {\\n            self.treating = false;\\n            self.heal_t = 0.0;\\n        }\\n        if self.fever_state > 0 && input.down(buttons::PILLS) && self.pills > 0 {\\n            self.pill_t += dt;\\n            if self.pill_t >= 2.5 {\\n                self.pills -= 1;\\n                self.pill_t = 0.0;\\n1490→                self.fever_state = 0;\\n                self.fever_t = 0.0;\\n                self.fever_attack = 0.0;\\n                self.mark(\\\"pill_taken\\\");\\n            }\\n        } else {\\n            self.pill_t = 0.0;\\n        }\\n    }\\n\\n1500→    fn handle_gun(&mut self, input: &InputFrame, dt: f32) {\\n        if self.guns.is_empty() {\\n            return;\\n        }\\n        let infinite = self.dev.infinite;\\n        let no_jams = self.dev.no_jams;\\n        let i = self.slot.min(self.guns.len() - 1);\\n        {\\n            let g = &mut self.guns[i];\\n            if input.just(buttons::RELOAD) {\\n1510→                g.tap_reload();\\n            }\\n            g.tick_clear(dt);\\n            if infinite {\\n                g.ammo = g.ammo.max(30);\\n            }\\n            if no_jams {\\n                g.jammed = false;\\n                g.force_jam = false;\\n            }\\n1520→        }\\n        if self.guns[i].jammed {\\n            self.jam_seen = true;\\n        } else if self.jam_seen {\\n            self.mark(\\\"jam_cleared\\\");\\n        }\\n        let holster = self.ceasefire && geom::in_town(self.x, self.z);\\n        let want = input.down(buttons::PRIMARY) && !self.treating && !holster && self.rescue_t <= 0.0;\\n        if !want {\\n            return;\\n1530→        }\\n        let ads = input.down(buttons::SECONDARY);\\n        let jam = self.tune.jam_chance;\\n        let wear = self.tune.weapon_wear;\\n        let br = self.tune.break_threshold;\\n        let pull = self.guns[i].pull(&mut self.rng, jam, wear, br);\\n        if pull != Pull::Fired && pull != Pull::Broke {\\n            return;\\n        }\\n        self.resolve_shot(ads);\\n1540→        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n1550→        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n1560→        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n1570→            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n1580→                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n1590→        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n1600→            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if self.bodies[i].hp <= 0.0 {\\n                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n1610→                    }\\n                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        if ignites || id == WeaponId::Flare || id == WeaponId::Rpg || id == WeaponId::Flamer || id == WeaponId::Mortar || id == WeaponId::Molotov || id == WeaponId::Frag {\\n            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n1620→        }\\n        // Tracers: every third round, a quarter of them light dry grass.\\n        if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n            if self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n                self.mark(\\\"ignite_tracer\\\");\\n            }\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n1630→                    b.alert = 1;\\n                }\\n            }\\n        }\\n        let _ = noise;\\n    }\\n\\n    fn update_bodies(&mut self, dt: f32) {\\n        let px = self.x;\\n        let pz = self.z;\\n1640→        let stance = self.stance;\\n        let night = self.hour() < 5.0 || self.hour() > 20.0;\\n        let light = if night { 0.45 } else { 1.0 };\\n        let n = self.bodies.len();\\n        let dead_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && !b.alive).count();\\n        let live_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && b.alive).count();\\n        let morale_broken = dead_soldiers >= 2 && live_soldiers > 0 && live_soldiers <= dead_soldiers;\\n        let mut shooters = 0u32;\\n        for i in 0..n {\\n            if !self.bodies[i].alive {\\n1650→                continue;\\n            }\\n            if self.bodies[i].poison > 0.0 {\\n                self.bodies[i].poison -= dt;\\n                if self.bodies[i].poison <= 0.0 && self.bodies[i].hp > 0.0 {\\n                    self.bodies[i].hp = 0.0;\\n                    self.bodies[i].alive = false;\\n                    self.mark(\\\"dart_kill\\\");\\n                    continue;\\n                }\\n1660→            }\\n            if self.bodies[i].kind == 3 {\\n                let d0 = geom::dist(px, pz, self.bodies[i].x, self.bodies[i].z);\\n                if d0 < 40.0 && self.guns.first().map(|g| g.shots > 0).unwrap_or(false) {\\n                    let dx = self.bodies[i].x - px;\\n                    let dz = self.bodies[i].z - pz;\\n                    let len = (dx * dx + dz * dz).sqrt().max(0.1);\\n                    self.bodies[i].x += dx / len * 6.0 * dt;\\n                    self.bodies[i].z += dz / len * 6.0 * dt;\\n                    self.bodies[i].flee += 6.0 * dt;\\n1670→                    if self.bodies[i].flee > 8.0 {\\n                        self.mark(\\\"animals_fled\\\");\\n                    }\\n                }\\n                continue;\\n            }\\n            if self.bodies[i].kind == 5 || self.bodies[i].kind == 6 {\\n                continue;\\n            }\\n            let crouched = stance == 1;\\n1680→            let grass = grass_factor(px, pz, crouched);\\n            let posture = match stance {\\n                2 => 0.3,\\n                1 => 0.6,\\n                _ => 1.0,\\n            };\\n            let motion = 0.5;\\n            let rate = exposure(posture, grass, light, motion) * self.tune.detection;\\n            let dist = geom::dist(px, pz, self.bodies[i].x, self.bodies[i].z).max(1.0);\\n            let falloff = (30.0 / dist).clamp(0.0, 1.5);\\n1690→            let (mx, mz) = ((px + self.bodies[i].x) * 0.5, (pz + self.bodies[i].z) * 0.5);\\n            let smoked = self.fire.cells.get(&geom::cell_of(mx, mz)).is_some_and(|c| c.burning);\\n            if morale_broken && self.bodies[i].kind == 1 {\\n                self.bodies[i].x += 5.0 * dt;\\n                self.bodies[i].flee += 5.0 * dt;\\n                self.bodies[i].alert = 3;\\n                continue;\\n            }\\n            if !self.dev.invisible && !smoked && self.bodies[i].alert < 2 {\\n                self.bodies[i].see += rate * falloff * dt;\\n1700→                if self.bodies[i].see > 1.0 {\\n                    self.bodies[i].alert = 2;\\n                }\\n            }\\n            // Fire under an enemy makes them run.\\n            let (cx, cz) = (self.bodies[i].x, self.bodies[i].z);\\n            let cell = geom::cell_of(cx, cz);\\n            if self.fire.cells.get(&cell).map(|c| c.burning).unwrap_or(false) {\\n                self.bodies[i].alert = 4;\\n                self.bodies[i].x += 4.0 * dt;\\n1710→                self.bodies[i].flee += 4.0 * dt;\\n                if self.bodies[i].flee > 3.0 {\\n                    self.mark(\\\"enemy_panicked\\\");\\n                }\\n            }\\n            if self.bodies[i].kind == 1 && self.bodies[i].alert >= 1 && !self.bodies[i].gun.jammed {\\n                if shooters >= 4 {\\n                    // One extra soldier peels off to the side instead of adding a fifth gun.\\n                    self.bodies[i].x += 3.0 * dt;\\n                    self.bodies[i].z += 1.5 * dt;\\n1720→                    continue;\\n                }\\n                shooters += 1;\\n                let gpull = {\\n                    let jam = self.tune.jam_chance;\\n                    let wear = self.tune.weapon_wear;\\n                    let br = self.tune.break_threshold;\\n                    self.bodies[i].gun.pull(&mut self.rng, jam, wear, br)\\n                };\\n                if gpull == Pull::Jammed {\\n1730→                    self.mark(\\\"enemy_jam\\\");\\n                }\\n                if gpull == Pull::Fired && self.rng.f32() < self.tune.enemy_accuracy * 0.15 {\\n                    let diff = match self.difficulty {\\n                        0 => 0.7,\\n                        2 => 1.3,\\n                        _ => 1.0,\\n                    };\\n                    if !self.dev.god && self.rescue_t <= 0.0 {\\n                        self.hp -= self.tune.enemy_damage * 0.15 * diff * dt.max(0.05) * 10.0;\\n1740→                    }\\n                }\\n            }\\n            self.bodies[i].gun.tick_clear(dt);\\n            if self.bodies[i].hp <= 0.0 {\\n                self.bodies[i].alive = false;\\n            }\\n        }\\n    }\\n\\n1750→    fn update_fever(&mut self, dt: f32) {\\n        if self.dev.no_fever {\\n            return;\\n        }\\n        if self.fever_state == 0 {\\n            self.fever_t += dt;\\n            if self.fever_t >= self.tune.fever_interval {\\n                self.fever_state = 1;\\n                self.fever_warn = 0.0;\\n                self.mark(\\\"fever_warned\\\");\\n1760→            }\\n        } else if self.fever_state == 1 {\\n            self.fever_warn += dt;\\n            if self.fever_warn >= 40.0 {\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n        } else if self.fever_state == 2 {\\n            self.fever_attack += dt;\\n            if self.fever_attack >= 60.0 && self.pills == 0 {\\n1770→                self.blackout();\\n            }\\n        }\\n    }\\n\\n    fn blackout(&mut self) {\\n        let (sx, sz) = geom::nearest_safe(self.x, self.z);\\n        self.x = sx;\\n        self.z = sz;\\n        self.hp = 50.0;\\n1780→        self.diamonds = (self.diamonds as f32 * 0.8).floor() as u32;\\n        self.fever_state = 0;\\n        self.fever_t = 0.0;\\n        self.fever_attack = 0.0;\\n        self.minutes += 6.0 * 60.0;\\n        self.mark(\\\"blackout\\\");\\n    }\\n\\n    fn update_rescue(&mut self, dt: f32) {\\n        if self.hp <= 0.0 && self.rescue_t <= 0.0 && !self.companions.iter().any(|c| c.rescue_spent) {\\n1790→            if let Some(c) = self.companions.iter_mut().find(|c| c.alive && !c.down) {\\n                c.rescue_spent = true;\\n                self.rescue_t = 3.0;\\n                self.hp = 1.0;\\n            }\\n        }\\n        if self.rescue_t > 0.0 {\\n            self.rescue_t -= dt;\\n            let (sy, cy) = self.yaw.sin_cos();\\n            self.x -= sy * dt * 4.0;\\n1800→            self.z -= -cy * dt * 4.0;\\n            if self.rescue_t <= 0.0 {\\n                self.rescue_t = 0.0;\\n                self.hp = 50.0;\\n                self.slot = 0;\\n                self.mark(\\\"player_rescued\\\");\\n            }\\n        }\\n    }\\n\\n1810→    fn special_actions(&mut self, input: &InputFrame, dt: f32) {\\n        let near_cache = geom::dist(self.x, self.z, self.tracker_cache.0, self.tracker_cache.1);\\n        if near_cache < 4.0 {\\n            self.mark(\\\"cache_tracker\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            self.hold_t += dt;\\n        } else {\\n            self.hold_t = 0.0;\\n        }\\n1820→        if input.just(buttons::INTERACT) || (input.down(buttons::INTERACT) && self.hold_t > 0.4) {\\n            self.try_interact();\\n        }\\n        if input.just(buttons::MELEE) {\\n            let crouched = self.stance == 1;\\n            let px = self.x;\\n            let pz = self.z;\\n            let mut stealth = false;\\n            for b in &mut self.bodies {\\n                if b.alive && b.kind == 1 && geom::dist(px, pz, b.x, b.z) < 2.2 {\\n1830→                    b.hp = 0.0;\\n                    b.alive = false;\\n                    if crouched {\\n                        stealth = true;\\n                    }\\n                }\\n            }\\n            if stealth {\\n                self.mark(\\\"stealth_kill\\\");\\n            }\\n1840→        }\\n        // Companion down timer.\\n        for c in &mut self.companions {\\n            if c.down && c.alive {\\n                c.down_t += dt;\\n            }\\n        }\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && c.down_t > 45.0) {\\n            self.companions[i].alive = false;\\n            self.companions[i].down = false;\\n1850→            self.mark(\\\"companion_died\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.down && c.alive && geom::dist(self.x, self.z, c.x, c.z) < 3.0) {\\n                if self.hold_t > 3.0 && self.syrettes > 0 && !c.doomed_enough() {\\n                    // patched below after the borrow... \\n                }\\n            }\\n        }\\n        self.patch_or_dose();\\n1860→        // Scripted igniters that are not shots.\\n        if self.step_ready {\\n            if let Some(spec) = self.current() {\\n                self.script_ignite(spec, input);\\n            }\\n        }\\n    }\\n\\n    fn patch_or_dose(&mut self) {\\n        if self.hold_t < 3.0 || self.syrettes == 0 {\\n1870→            return;\\n        }\\n        let doomed = matches!(self.current(), Some(Spec::Overdose));\\n        let px = self.x;\\n        let pz = self.z;\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && geom::dist(px, pz, c.x, c.z) < 4.0) {\\n            self.syrettes -= 1;\\n            if doomed {\\n                self.companions[i].alive = false;\\n                self.companions[i].down = false;\\n1880→                self.mark(\\\"companion_overdosed\\\");\\n            } else {\\n                self.companions[i].down = false;\\n                self.companions[i].down_t = 0.0;\\n                self.mark(\\\"companion_patched\\\");\\n            }\\n        }\\n    }\\n\\n    fn script_ignite(&mut self, spec: Spec, _input: &InputFrame) {\\n1890→        // Each source lights a fresh patch west of the player. East stays clear for tracers.\\n        let n = match spec {\\n            Spec::Ignite(k) => k as f32,\\n            _ => 0.0,\\n        };\\n        let x = self.x - 24.0 - n * 18.0;\\n        let z = self.z - 16.0;\\n        match spec {\\n            Spec::Ignite(0) => {\\n                if self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes) {\\n1900→                    self.mark(\\\"ignite_flare\\\");\\n                }\\n            }\\n            Spec::Ignite(1) => {\\n                if self.fire.ignite_disk(x, z, 6.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_rocket\\\");\\n                }\\n            }\\n            Spec::Ignite(2) => {\\n                if self.fire.ignite_at(x + 1.0, z, self.tune.burn_time, self.minutes) {\\n1910→                    self.mark(\\\"ignite_flamer\\\");\\n                }\\n            }\\n            Spec::Ignite(3) => {\\n                if self.fire.ignite_disk(x, z + 4.0, 8.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_mortar\\\");\\n                }\\n            }\\n            Spec::Ignite(4) => {\\n                if self.fire.ignite_disk(x, z, 4.0, self.tune.burn_time, self.minutes) > 0 {\\n1920→                    self.mark(\\\"ignite_molotov\\\");\\n                }\\n            }\\n            Spec::Ignite(5) => {\\n                if self.fire.ignite_disk(x + 3.0, z, 6.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_frag\\\");\\n                }\\n            }\\n            Spec::Ignite(6) => {\\n                if self.fire.ignite_disk(x, z, 5.0, self.tune.burn_time, self.minutes) > 0 {\\n1930→                    self.mark(\\\"ignite_barrel\\\");\\n                }\\n            }\\n            Spec::Ignite(7) => {\\n                self.mark(\\\"ignite_vehicle\\\");\\n                let _ = self.fire.ignite_disk(self.x, self.z, 5.0, self.tune.burn_time, self.minutes);\\n            }\\n            Spec::Ignite(8) => {\\n                self.mark(\\\"ignite_person\\\");\\n                let _ = self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes);\\n1940→            }\\n            Spec::Ignite(9) => {\\n                self.weather = 2;\\n                if self.fire.ignite_at(x + 6.0, z - 6.0, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_lightning\\\");\\n                }\\n                self.weather = 0;\\n            }\\n            Spec::Ignite(11) => {\\n                if self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes) {\\n1950→                    self.mark(\\\"ignite_cigarette\\\");\\n                }\\n            }\\n            Spec::Tanks => {\\n                self.blow_tanks();\\n            }\\n            Spec::Ending(0) => {\\n                let _ = self.fire.ignite_disk(self.x, self.z, 8.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"ending_burn\\\");\\n            }\\n1960→            Spec::Ending(1) => {\\n                // The ledger is read under fire. step_t is real time on this step.\\n                if self.step_t >= 180.0 {\\n                    self.mark(\\\"ending_read\\\");\\n                }\\n            }\\n            Spec::Ending(2) => {\\n                self.mark(\\\"ending_chair\\\");\\n            }\\n            Spec::Bus { x, z } => {\\n1970→                let stop = geom::place(\\\"Junction\\\");\\n                if geom::dist(self.x, self.z, stop.0, stop.1) < 14.0 && self.diamonds >= 1 {\\n                    self.diamonds -= 1;\\n                    self.x = x;\\n                    self.z = z;\\n                    self.ride.seat = 0;\\n                    self.minutes += 20.0;\\n                    self.mark(\\\"bus_taken\\\");\\n                    self.mark(\\\"diamonds_spent\\\");\\n                }\\n1980→            }\\n            _ => {}\\n        }\\n        // Tracer step: spray the ground in front.\\n        if matches!(spec, Spec::Ignite(10)) {\\n            self.pitch = -0.25;\\n            for _ in 0..4 {\\n                if self.guns.is_empty() {\\n                    break;\\n                }\\n1990→                let i = self.slot.min(self.guns.len() - 1);\\n                if self.guns[i].ammo == 0 {\\n                    self.guns[i].ammo = 30;\\n                }\\n                self.guns[i].condition = 90.0;\\n                let pull = self.guns[i].pull(&mut self.rng, 0.0, 0.0, 0.0);\\n                if pull == Pull::Fired || pull == Pull::Broke {\\n                    self.resolve_shot(true);\\n                }\\n            }\\n2000→        }\\n    }\\n\\n    fn try_interact(&mut self) {\\n        if geom::dist(self.x, self.z, 170.0, 470.0) < 16.0 || geom::dist(self.x, self.z, -260.0, -700.0) < 16.0 || geom::dist(self.x, self.z, 830.0, 255.0) < 16.0\\n        {\\n            if self.hold_t > 0.3 && matches!(self.current(), Some(Spec::Claim)) {\\n                self.mark(\\\"safe_house_claimed\\\");\\n                self.hp = 100.0;\\n            }\\n2010→            if self.hold_t > 0.8 && matches!(self.current(), Some(Spec::Sleep { .. })) {\\n                let hours = match self.current() {\\n                    Some(Spec::Sleep { hours }) => hours,\\n                    _ => 8.0,\\n                };\\n                self.minutes += hours * 60.0;\\n                self.hp = 100.0;\\n                for c in &mut self.companions {\\n                    c.rescue_spent = false;\\n                }\\n2020→                self.yaw = std::f32::consts::PI;\\n                self.looking_at_post = false;\\n                self.mark(\\\"sleep_used\\\");\\n                if hours >= 24.0 && self.post_clear {\\n                    self.post_clear = false;\\n                    self.mark(\\\"post_remanned\\\");\\n                }\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Shop)) {\\n2030→            let price = 8u32;\\n            if self.diamonds >= price {\\n                self.diamonds -= price;\\n                self.guns.push(Gun::new(WeaponId::Battle));\\n                self.mark(\\\"weapon_bought\\\");\\n                self.mark(\\\"diamonds_spent\\\");\\n                self.infamy += 1;\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Locker)) && self.guns.len() > 1 {\\n2040→            self.slot = self.guns.len() - 1;\\n            self.mark(\\\"locker_used\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Loot)) && !self.guns.iter().any(|g| g.id == WeaponId::Ar) {\",\"content_concise\":\"1344→        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\\n            self.z += n.y * speed * dt;\\n        }\\n        let (x, z) = geom::clamp_map(self.x, self.z);\\n1350→        self.x = x;\\n        self.z = z;\\n    }\\n\\n    fn use_vehicle(&mut self, input: &InputFrame, dt: f32) {\\n        if input.just(buttons::USE) && self.ride.kind != 0 {\\n            self.ride.seat = (self.ride.seat + 1) % 3;\\n            if self.ride.seat == 2 {\\n                // gunner\\n            }\\n1360→        }\\n        if self.ride.seat == 0 {\\n            if self.ride.kind != 0 && geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 5.0 && input.down(buttons::INTERACT) {\\n                self.ride.repair += dt;\\n                if self.ride.repair >= 6.0 && self.ride.health < 70.0 {\\n                    self.ride.health = 70.0;\\n                    self.ride.stage = 1;\\n                    self.ride.fuse = 0.0;\\n                    self.ride.repair = 0.0;\\n                    self.mark(\\\"repair_done\\\");\\n1370→                }\\n            }\\n            return;\\n        }\\n        let steer = input.axes.x;\\n        self.ride.yaw = geom::wrap_angle(self.ride.yaw + steer * dt * 1.6);\\n        let mut max_s = 16.0 * self.tune.vehicle_speed;\\n        if self.ride.stage == 2 {\\n            max_s *= 0.6;\\n        }\\n1380→        if self.ride.stage >= 3 {\\n            max_s *= 0.2;\\n        }\\n        if self.ride.kind == 2 && !geom::deep_water(self.ride.x, self.ride.z) {\\n            max_s = 0.0;\\n        }\\n        let throttle = input.axes.y;\\n        self.ride.speed += (throttle.clamp(-0.4, 1.0) * max_s - self.ride.speed) * (dt * 2.5).min(1.0);\\n        let (sy, cy) = self.ride.yaw.sin_cos();\\n        let before = (self.ride.x, self.ride.z);\\n1390→        self.ride.x += sy * self.ride.speed * dt;\\n        self.ride.z += -cy * self.ride.speed * dt;\\n        let (x, z) = geom::clamp_map(self.ride.x, self.ride.z);\\n        self.ride.x = x;\\n        self.ride.z = z;\\n        self.ride.dist += geom::dist(before.0, before.1, self.ride.x, self.ride.z);\\n        let h = geom::height(self.ride.x, self.ride.z);\\n        let h2 = geom::height(self.ride.x + sy * 2.0, self.ride.z - cy * 2.0);\\n        self.ride.pitch = (h2 - h).atan();\\n        if self.ride.roll.abs() > 0.02 {\\n1400→            self.ride.roll *= (1.0 - dt * 3.0).clamp(0.0, 1.0);\\n        }\\n        self.x = self.ride.x;\\n        self.z = self.ride.z;\\n        if self.ride.kind == 1 && self.ride.dist > 20.0 {\\n            self.mark(\\\"technical_driven\\\");\\n        }\\n        if self.ride.kind == 2 && self.ride.dist > 15.0 && geom::deep_water(self.ride.x, self.ride.z) {\\n            self.mark(\\\"boat_driven\\\");\\n            self.boat_dist = self.ride.dist;\\n1410→        }\\n        if self.ride.seat == 2 && input.down(buttons::PRIMARY) {\\n            self.mark(\\\"mounted_gun\\\");\\n        }\\n        if self.ride.stage == 3 {\\n            self.ride.fuse -= dt;\\n            if self.ride.fuse <= 0.0 {\\n                self.ride.stage = 4;\\n                self.ride.health = 0.0;\\n                let _ = self.fire.ignite_disk(self.ride.x, self.ride.z, 6.0, self.tune.burn_time, self.minutes);\\n1420→                self.mark(\\\"ignite_vehicle\\\");\\n            }\\n        }\\n        if self.ride.npc {\\n            let points = [(0.0, 800.0), (0.0, 400.0), (0.0, 0.0), (0.0, -400.0)];\\n            let target = points[self.ride.npc_i % points.len()];\\n            if geom::dist(self.ride.x, self.ride.z, target.0, target.1) < 8.0 {\\n                self.ride.npc_i += 1;\\n            }\\n            let desired = geom::yaw_toward(self.ride.x, self.ride.z, target.0, target.1);\\n1430→            let err = geom::wrap_angle(desired - self.ride.yaw);\\n            self.ride.yaw = geom::wrap_angle(self.ride.yaw + err.clamp(-1.0, 1.0) * dt * 2.0);\\n            self.ride.speed = 10.0;\\n        }\\n    }\\n\\n    pub fn hurt_vehicle(&mut self, dmg: f32) {\\n        if self.ride.kind == 0 || self.ride.stage == 4 {\\n            return;\\n        }\\n1440→        self.ride.health -= dmg / self.tune.vehicle_tough.max(0.2);\\n        if self.ride.health > 70.0 {\\n            self.ride.stage = 0;\\n        } else if self.ride.health > 40.0 {\\n            self.ride.stage = 1;\\n        } else if self.ride.health > 15.0 {\\n            self.ride.stage = 2;\\n        } else if self.ride.health > 0.0 {\\n            if self.ride.stage < 3 {\\n                self.ride.fuse = 8.0;\\n1450→            }\\n            self.ride.stage = 3;\\n        } else {\\n            self.ride.stage = 4;\\n        }\\n    }\\n\\n    fn handle_items(&mut self, input: &InputFrame, dt: f32) {\\n        if input.just(buttons::HEAL) && self.hp >= 20.0 && self.hp < 100.0 && self.syrettes > 0 && self.syrette_t <= 0.0 {\\n            self.syrettes -= 1;\\n1460→            self.syrette_t = 1.5;\\n        }\\n        if self.syrette_t > 0.0 {\\n            let step = dt.min(self.syrette_t);\\n            self.hp = (self.hp + self.tune.syrette_heal / 1.5 * step).min(100.0);\\n            self.syrette_t -= step;\\n            if self.syrette_t <= 0.0 {\\n                self.syrette_t = 0.0;\\n                self.mark(\\\"syrette\\\");\\n            }\\n1470→        }\\n        if self.hp < 20.0 && self.hp > 0.0 && input.down(buttons::HEAL) {\\n            self.treating = true;\\n            self.heal_t += dt;\\n            if self.heal_t >= 4.0 {\\n                self.hp = 40.0;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n                self.mark(wound_flag(self.wound.max(1)));\\n                self.wound = 0;\\n1480→            }\\n        } else if self.hp >= 20.0 {\\n            self.treating = false;\\n            self.heal_t = 0.0;\\n        }\\n        if self.fever_state > 0 && input.down(buttons::PILLS) && self.pills > 0 {\\n            self.pill_t += dt;\\n            if self.pill_t >= 2.5 {\\n                self.pills -= 1;\\n                self.pill_t = 0.0;\\n1490→                self.fever_state = 0;\\n                self.fever_t = 0.0;\\n                self.fever_attack = 0.0;\\n                self.mark(\\\"pill_taken\\\");\\n            }\\n        } else {\\n            self.pill_t = 0.0;\\n        }\\n    }\\n\\n1500→    fn handle_gun(&mut self, input: &InputFrame, dt: f32) {\\n        if self.guns.is_empty() {\\n            return;\\n        }\\n        let infinite = self.dev.infinite;\\n        let no_jams = self.dev.no_jams;\\n        let i = self.slot.min(self.guns.len() - 1);\\n        {\\n            let g = &mut self.guns[i];\\n            if input.just(buttons::RELOAD) {\\n1510→                g.tap_reload();\\n            }\\n            g.tick_clear(dt);\\n            if infinite {\\n                g.ammo = g.ammo.max(30);\\n            }\\n            if no_jams {\\n                g.jammed = false;\\n                g.force_jam = false;\\n            }\\n1520→        }\\n        if self.guns[i].jammed {\\n            self.jam_seen = true;\\n        } else if self.jam_seen {\\n            self.mark(\\\"jam_cleared\\\");\\n        }\\n        let holster = self.ceasefire && geom::in_town(self.x, self.z);\\n        let want = input.down(buttons::PRIMARY) && !self.treating && !holster && self.rescue_t <= 0.0;\\n        if !want {\\n            return;\\n1530→        }\\n        let ads = input.down(buttons::SECONDARY);\\n        let jam = self.tune.jam_chance;\\n        let wear = self.tune.weapon_wear;\\n        let br = self.tune.break_threshold;\\n        let pull = self.guns[i].pull(&mut self.rng, jam, wear, br);\\n        if pull != Pull::Fired && pull != Pull::Broke {\\n            return;\\n        }\\n        self.resolve_shot(ads);\\n1540→        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n1550→        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n1560→        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n1570→            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n1580→                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n1590→        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n1600→            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if self.bodies[i].hp <= 0.0 {\\n                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n1610→                    }\\n                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        if ignites || id == WeaponId::Flare || id == WeaponId::Rpg || id == WeaponId::Flamer || id == WeaponId::Mortar || id == WeaponId::Molotov || id == WeaponId::Frag {\\n            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n1620→        }\\n        // Tracers: every third round, a quarter of them light dry grass.\\n        if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n            if self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n                self.mark(\\\"ignite_tracer\\\");\\n            }\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n1630→                    b.alert = 1;\\n                }\\n            }\\n        }\\n        let _ = noise;\\n    }\\n\\n    fn update_bodies(&mut self, dt: f32) {\\n        let px = self.x;\\n        let pz = self.z;\\n1640→        let stance = self.stance;\\n        let night = self.hour() < 5.0 || self.hour() > 20.0;\\n        let light = if night { 0.45 } else { 1.0 };\\n        let n = self.bodies.len();\\n        let dead_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && !b.alive).count();\\n        let live_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && b.alive).count();\\n        let morale_broken = dead_soldiers >= 2 && live_soldiers > 0 && live_soldiers <= dead_soldiers;\\n        let mut shooters = 0u32;\\n        for i in 0..n {\\n            if !self.bodies[i].alive {\\n1650→                continue;\\n            }\\n            if self.bodies[i].poison > 0.0 {\\n                self.bodies[i].poison -= dt;\\n                if self.bodies[i].poison <= 0.0 && self.bodies[i].hp > 0.0 {\\n                    self.bodies[i].hp = 0.0;\\n                    self.bodies[i].alive = false;\\n                    self.mark(\\\"dart_kill\\\");\\n                    continue;\\n                }\\n1660→            }\\n            if self.bodies[i].kind == 3 {\\n                let d0 = geom::dist(px, pz, self.bodies[i].x, self.bodies[i].z);\\n                if d0 < 40.0 && self.guns.first().map(|g| g.shots > 0).unwrap_or(false) {\\n                    let dx = self.bodies[i].x - px;\\n                    let dz = self.bodies[i].z - pz;\\n                    let len = (dx * dx + dz * dz).sqrt().max(0.1);\\n                    self.bodies[i].x += dx / len * 6.0 * dt;\\n                    self.bodies[i].z += dz / len * 6.0 * dt;\\n                    self.bodies[i].flee += 6.0 * dt;\\n1670→                    if self.bodies[i].flee > 8.0 {\\n                        self.mark(\\\"animals_fled\\\");\\n                    }\\n                }\\n                continue;\\n            }\\n            if self.bodies[i].kind == 5 || self.bodies[i].kind == 6 {\\n                continue;\\n            }\\n            let crouched = stance == 1;\\n1680→            let grass = grass_factor(px, pz, crouched);\\n            let posture = match stance {\\n                2 => 0.3,\\n                1 => 0.6,\\n                _ => 1.0,\\n            };\\n            let motion = 0.5;\\n            let rate = exposure(posture, grass, light, motion) * self.tune.detection;\\n            let dist = geom::dist(px, pz, self.bodies[i].x, self.bodies[i].z).max(1.0);\\n            let falloff = (30.0 / dist).clamp(0.0, 1.5);\\n1690→            let (mx, mz) = ((px + self.bodies[i].x) * 0.5, (pz + self.bodies[i].z) * 0.5);\\n            let smoked = self.fire.cells.get(&geom::cell_of(mx, mz)).is_some_and(|c| c.burning);\\n            if morale_broken && self.bodies[i].kind == 1 {\\n                self.bodies[i].x += 5.0 * dt;\\n                self.bodies[i].flee += 5.0 * dt;\\n                self.bodies[i].alert = 3;\\n                continue;\\n            }\\n            if !self.dev.invisible && !smoked && self.bodies[i].alert < 2 {\\n                self.bodies[i].see += rate * falloff * dt;\\n1700→                if self.bodies[i].see > 1.0 {\\n                    self.bodies[i].alert = 2;\\n                }\\n            }\\n            // Fire under an enemy makes them run.\\n            let (cx, cz) = (self.bodies[i].x, self.bodies[i].z);\\n            let cell = geom::cell_of(cx, cz);\\n            if self.fire.cells.get(&cell).map(|c| c.burning).unwrap_or(false) {\\n                self.bodies[i].alert = 4;\\n                self.bodies[i].x += 4.0 * dt;\\n1710→                self.bodies[i].flee += 4.0 * dt;\\n                if self.bodies[i].flee > 3.0 {\\n                    self.mark(\\\"enemy_panicked\\\");\\n                }\\n            }\\n            if self.bodies[i].kind == 1 && self.bodies[i].alert >= 1 && !self.bodies[i].gun.jammed {\\n                if shooters >= 4 {\\n                    // One extra soldier peels off to the side instead of adding a fifth gun.\\n                    self.bodies[i].x += 3.0 * dt;\\n                    self.bodies[i].z += 1.5 * dt;\\n1720→                    continue;\\n                }\\n                shooters += 1;\\n                let gpull = {\\n                    let jam = self.tune.jam_chance;\\n                    let wear = self.tune.weapon_wear;\\n                    let br = self.tune.break_threshold;\\n                    self.bodies[i].gun.pull(&mut self.rng, jam, wear, br)\\n                };\\n                if gpull == Pull::Jammed {\\n1730→                    self.mark(\\\"enemy_jam\\\");\\n                }\\n                if gpull == Pull::Fired && self.rng.f32() < self.tune.enemy_accuracy * 0.15 {\\n                    let diff = match self.difficulty {\\n                        0 => 0.7,\\n                        2 => 1.3,\\n                        _ => 1.0,\\n                    };\\n                    if !self.dev.god && self.rescue_t <= 0.0 {\\n                        self.hp -= self.tune.enemy_damage * 0.15 * diff * dt.max(0.05) * 10.0;\\n1740→                    }\\n                }\\n            }\\n            self.bodies[i].gun.tick_clear(dt);\\n            if self.bodies[i].hp <= 0.0 {\\n                self.bodies[i].alive = false;\\n            }\\n        }\\n    }\\n\\n1750→    fn update_fever(&mut self, dt: f32) {\\n        if self.dev.no_fever {\\n            return;\\n        }\\n        if self.fever_state == 0 {\\n            self.fever_t += dt;\\n            if self.fever_t >= self.tune.fever_interval {\\n                self.fever_state = 1;\\n                self.fever_warn = 0.0;\\n                self.mark(\\\"fever_warned\\\");\\n1760→            }\\n        } else if self.fever_state == 1 {\\n            self.fever_warn += dt;\\n            if self.fever_warn >= 40.0 {\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n        } else if self.fever_state == 2 {\\n            self.fever_attack += dt;\\n            if self.fever_attack >= 60.0 && self.pills == 0 {\\n1770→                self.blackout();\\n            }\\n        }\\n    }\\n\\n    fn blackout(&mut self) {\\n        let (sx, sz) = geom::nearest_safe(self.x, self.z);\\n        self.x = sx;\\n        self.z = sz;\\n        self.hp = 50.0;\\n1780→        self.diamonds = (self.diamonds as f32 * 0.8).floor() as u32;\\n        self.fever_state = 0;\\n        self.fever_t = 0.0;\\n        self.fever_attack = 0.0;\\n        self.minutes += 6.0 * 60.0;\\n        self.mark(\\\"blackout\\\");\\n    }\\n\\n    fn update_rescue(&mut self, dt: f32) {\\n        if self.hp <= 0.0 && self.rescue_t <= 0.0 && !self.companions.iter().any(|c| c.rescue_spent) {\\n1790→            if let Some(c) = self.companions.iter_mut().find(|c| c.alive && !c.down) {\\n                c.rescue_spent = true;\\n                self.rescue_t = 3.0;\\n                self.hp = 1.0;\\n            }\\n        }\\n        if self.rescue_t > 0.0 {\\n            self.rescue_t -= dt;\\n            let (sy, cy) = self.yaw.sin_cos();\\n            self.x -= sy * dt * 4.0;\\n1800→            self.z -= -cy * dt * 4.0;\\n            if self.rescue_t <= 0.0 {\\n                self.rescue_t = 0.0;\\n                self.hp = 50.0;\\n                self.slot = 0;\\n                self.mark(\\\"player_rescued\\\");\\n            }\\n        }\\n    }\\n\\n1810→    fn special_actions(&mut self, input: &InputFrame, dt: f32) {\\n        let near_cache = geom::dist(self.x, self.z, self.tracker_cache.0, self.tracker_cache.1);\\n        if near_cache < 4.0 {\\n            self.mark(\\\"cache_tracker\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            self.hold_t += dt;\\n        } else {\\n            self.hold_t = 0.0;\\n        }\\n1820→        if input.just(buttons::INTERACT) || (input.down(buttons::INTERACT) && self.hold_t > 0.4) {\\n            self.try_interact();\\n        }\\n        if input.just(buttons::MELEE) {\\n            let crouched = self.stance == 1;\\n            let px = self.x;\\n            let pz = self.z;\\n            let mut stealth = false;\\n            for b in &mut self.bodies {\\n                if b.alive && b.kind == 1 && geom::dist(px, pz, b.x, b.z) < 2.2 {\\n1830→                    b.hp = 0.0;\\n                    b.alive = false;\\n                    if crouched {\\n                        stealth = true;\\n                    }\\n                }\\n            }\\n            if stealth {\\n                self.mark(\\\"stealth_kill\\\");\\n            }\\n1840→        }\\n        // Companion down timer.\\n        for c in &mut self.companions {\\n            if c.down && c.alive {\\n                c.down_t += dt;\\n            }\\n        }\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && c.down_t > 45.0) {\\n            self.companions[i].alive = false;\\n            self.companions[i].down = false;\\n1850→            self.mark(\\\"companion_died\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.down && c.alive && geom::dist(self.x, self.z, c.x, c.z) < 3.0) {\\n                if self.hold_t > 3.0 && self.syrettes > 0 && !c.doomed_enough() {\\n                    // patched below after the borrow... \\n                }\\n            }\\n        }\\n        self.patch_or_dose();\\n1860→        // Scripted igniters that are not shots.\\n        if self.step_ready {\\n            if let Some(spec) = self.current() {\\n                self.script_ignite(spec, input);\\n            }\\n        }\\n    }\\n\\n    fn patch_or_dose(&mut self) {\\n        if self.hold_t < 3.0 || self.syrettes == 0 {\\n1870→            return;\\n        }\\n        let doomed = matches!(self.current(), Some(Spec::Overdose));\\n        let px = self.x;\\n        let pz = self.z;\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && geom::dist(px, pz, c.x, c.z) < 4.0) {\\n            self.syrettes -= 1;\\n            if doomed {\\n                self.companions[i].alive = false;\\n                self.companions[i].down = false;\\n1880→                self.mark(\\\"companion_overdosed\\\");\\n            } else {\\n                self.companions[i].down = false;\\n                self.companions[i].down_t = 0.0;\\n                self.mark(\\\"companion_patched\\\");\\n            }\\n        }\\n    }\\n\\n    fn script_ignite(&mut self, spec: Spec, _input: &InputFrame) {\\n1890→        // Each source lights a fresh patch west of the player. East stays clear for tracers.\\n        let n = match spec {\\n            Spec::Ignite(k) => k as f32,\\n            _ => 0.0,\\n        };\\n        let x = self.x - 24.0 - n * 18.0;\\n        let z = self.z - 16.0;\\n        match spec {\\n            Spec::Ignite(0) => {\\n                if self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes) {\\n1900→                    self.mark(\\\"ignite_flare\\\");\\n                }\\n            }\\n            Spec::Ignite(1) => {\\n                if self.fire.ignite_disk(x, z, 6.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_rocket\\\");\\n                }\\n            }\\n            Spec::Ignite(2) => {\\n                if self.fire.ignite_at(x + 1.0, z, self.tune.burn_time, self.minutes) {\\n1910→                    self.mark(\\\"ignite_flamer\\\");\\n                }\\n            }\\n            Spec::Ignite(3) => {\\n                if self.fire.ignite_disk(x, z + 4.0, 8.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_mortar\\\");\\n                }\\n            }\\n            Spec::Ignite(4) => {\\n                if self.fire.ignite_disk(x, z, 4.0, self.tune.burn_time, self.minutes) > 0 {\\n1920→                    self.mark(\\\"ignite_molotov\\\");\\n                }\\n            }\\n            Spec::Ignite(5) => {\\n                if self.fire.ignite_disk(x + 3.0, z, 6.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_frag\\\");\\n                }\\n            }\\n            Spec::Ignite(6) => {\\n                if self.fire.ignite_disk(x, z, 5.0, self.tune.burn_time, self.minutes) > 0 {\\n1930→                    self.mark(\\\"ignite_barrel\\\");\\n                }\\n            }\\n            Spec::Ignite(7) => {\\n                self.mark(\\\"ignite_vehicle\\\");\\n                let _ = self.fire.ignite_disk(self.x, self.z, 5.0, self.tune.burn_time, self.minutes);\\n            }\\n            Spec::Ignite(8) => {\\n                self.mark(\\\"ignite_person\\\");\\n                let _ = self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes);\\n1940→            }\\n            Spec::Ignite(9) => {\\n                self.weather = 2;\\n                if self.fire.ignite_at(x + 6.0, z - 6.0, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_lightning\\\");\\n                }\\n                self.weather = 0;\\n            }\\n            Spec::Ignite(11) => {\\n                if self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes) {\\n1950→                    self.mark(\\\"ignite_cigarette\\\");\\n                }\\n            }\\n            Spec::Tanks => {\\n                self.blow_tanks();\\n            }\\n            Spec::Ending(0) => {\\n                let _ = self.fire.ignite_disk(self.x, self.z, 8.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"ending_burn\\\");\\n            }\\n1960→            Spec::Ending(1) => {\\n                // The ledger is read under fire. step_t is real time on this step.\\n                if self.step_t >= 180.0 {\\n                    self.mark(\\\"ending_read\\\");\\n                }\\n            }\\n            Spec::Ending(2) => {\\n                self.mark(\\\"ending_chair\\\");\\n            }\\n            Spec::Bus { x, z } => {\\n1970→                let stop = geom::place(\\\"Junction\\\");\\n                if geom::dist(self.x, self.z, stop.0, stop.1) < 14.0 && self.diamonds >= 1 {\\n                    self.diamonds -= 1;\\n                    self.x = x;\\n                    self.z = z;\\n                    self.ride.seat = 0;\\n                    self.minutes += 20.0;\\n                    self.mark(\\\"bus_taken\\\");\\n                    self.mark(\\\"diamonds_spent\\\");\\n                }\\n1980→            }\\n            _ => {}\\n        }\\n        // Tracer step: spray the ground in front.\\n        if matches!(spec, Spec::Ignite(10)) {\\n            self.pitch = -0.25;\\n            for _ in 0..4 {\\n                if self.guns.is_empty() {\\n                    break;\\n                }\\n1990→                let i = self.slot.min(self.guns.len() - 1);\\n                if self.guns[i].ammo == 0 {\\n                    self.guns[i].ammo = 30;\\n                }\\n                self.guns[i].condition = 90.0;\\n                let pull = self.guns[i].pull(&mut self.rng, 0.0, 0.0, 0.0);\\n                if pull == Pull::Fired || pull == Pull::Broke {\\n                    self.resolve_shot(true);\\n                }\\n            }\\n2000→        }\\n    }\\n\\n    fn try_interact(&mut self) {\\n        if geom::dist(self.x, self.z, 170.0, 470.0) < 16.0 || geom::dist(self.x, self.z, -260.0, -700.0) < 16.0 || geom::dist(self.x, self.z, 830.0, 255.0) < 16.0\\n        {\\n            if self.hold_t > 0.3 && matches!(self.current(), Some(Spec::Claim)) {\\n                self.mark(\\\"safe_house_claimed\\\");\\n                self.hp = 100.0;\\n            }\\n2010→            if self.hold_t > 0.8 && matches!(self.current(), Some(Spec::Sleep { .. })) {\\n                let hours = match self.current() {\\n                    Some(Spec::Sleep { hours }) => hours,\\n                    _ => 8.0,\\n                };\\n                self.minutes += hours * 60.0;\\n                self.hp = 100.0;\\n                for c in &mut self.companions {\\n                    c.rescue_spent = false;\\n                }\\n2020→                self.yaw = std::f32::consts::PI;\\n                self.looking_at_post = false;\\n                self.mark(\\\"sleep_used\\\");\\n                if hours >= 24.0 && self.post_clear {\\n                    self.post_clear = false;\\n                    self.mark(\\\"post_remanned\\\");\\n                }\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Shop)) {\\n2030→            let price = 8u32;\\n            if self.diamonds >= price {\\n                self.diamonds -= price;\\n                self.guns.push(Gun::new(WeaponId::Battle));\\n                self.mark(\\\"weapon_bought\\\");\\n                self.mark(\\\"diamonds_spent\\\");\\n                self.infamy += 1;\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Locker)) && self.guns.len() > 1 {\\n2040→            self.slot = self.guns.len() - 1;\\n            self.mark(\\\"locker_used\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Loot)) && !self.guns.iter().any(|g| g.id == WeaponId::Ar) {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":1344,\"limit\":700,\"raw_output\":\"        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\\n            self.z += n.y * speed * dt;\\n        }\\n        let (x, z) = geom::clamp_map(self.x, self.z);\\n        self.x = x;\\n        self.z = z;\\n    }\\n\\n    fn use_vehicle(&mut self, input: &InputFrame, dt: f32) {\\n        if input.just(buttons::USE) && self.ride.kind != 0 {\\n            self.ride.seat = (self.ride.seat + 1) % 3;\\n            if self.ride.seat == 2 {\\n                // gunner\\n            }\\n        }\\n        if self.ride.seat == 0 {\\n            if self.ride.kind != 0 && geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 5.0 && input.down(buttons::INTERACT) {\\n                self.ride.repair += dt;\\n                if self.ride.repair >= 6.0 && self.ride.health < 70.0 {\\n                    self.ride.health = 70.0;\\n                    self.ride.stage = 1;\\n                    self.ride.fuse = 0.0;\\n                    self.ride.repair = 0.0;\\n                    self.mark(\\\"repair_done\\\");\\n                }\\n            }\\n            return;\\n        }\\n        let steer = input.axes.x;\\n        self.ride.yaw = geom::wrap_angle(self.ride.yaw + steer * dt * 1.6);\\n        let mut max_s = 16.0 * self.tune.vehicle_speed;\\n        if self.ride.stage == 2 {\\n            max_s *= 0.6;\\n        }\\n        if self.ride.stage >= 3 {\\n            max_s *= 0.2;\\n        }\\n        if self.ride.kind == 2 && !geom::deep_water(self.ride.x, self.ride.z) {\\n            max_s = 0.0;\\n        }\\n        let throttle = input.axes.y;\\n        self.ride.speed += (throttle.clamp(-0.4, 1.0) * max_s - self.ride.speed) * (dt * 2.5).min(1.0);\\n        let (sy, cy) = self.ride.yaw.sin_cos();\\n        let before = (self.ride.x, self.ride.z);\\n        self.ride.x += sy * self.ride.speed * dt;\\n        self.ride.z += -cy * self.ride.speed * dt;\\n        let (x, z) = geom::clamp_map(self.ride.x, self.ride.z);\\n        self.ride.x = x;\\n        self.ride.z = z;\\n        self.ride.dist += geom::dist(before.0, before.1, self.ride.x, self.ride.z);\\n        let h = geom::height(self.ride.x, self.ride.z);\\n        let h2 = geom::height(self.ride.x + sy * 2.0, self.ride.z - cy * 2.0);\\n        self.ride.pitch = (h2 - h).atan();\\n        if self.ride.roll.abs() > 0.02 {\\n            self.ride.roll *= (1.0 - dt * 3.0).clamp(0.0, 1.0);\\n        }\\n        self.x = self.ride.x;\\n        self.z = self.ride.z;\\n        if self.ride.kind == 1 && self.ride.dist > 20.0 {\\n            self.mark(\\\"technical_driven\\\");\\n        }\\n        if self.ride.kind == 2 && self.ride.dist > 15.0 && geom::deep_water(self.ride.x, self.ride.z) {\\n            self.mark(\\\"boat_driven\\\");\\n            self.boat_dist = self.ride.dist;\\n        }\\n        if self.ride.seat == 2 && input.down(buttons::PRIMARY) {\\n            self.mark(\\\"mounted_gun\\\");\\n        }\\n        if self.ride.stage == 3 {\\n            self.ride.fuse -= dt;\\n            if self.ride.fuse <= 0.0 {\\n                self.ride.stage = 4;\\n                self.ride.health = 0.0;\\n                let _ = self.fire.ignite_disk(self.ride.x, self.ride.z, 6.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"ignite_vehicle\\\");\\n            }\\n        }\\n        if self.ride.npc {\\n            let points = [(0.0, 800.0), (0.0, 400.0), (0.0, 0.0), (0.0, -400.0)];\\n            let target = points[self.ride.npc_i % points.len()];\\n            if geom::dist(self.ride.x, self.ride.z, target.0, target.1) < 8.0 {\\n                self.ride.npc_i += 1;\\n            }\\n            let desired = geom::yaw_toward(self.ride.x, self.ride.z, target.0, target.1);\\n            let err = geom::wrap_angle(desired - self.ride.yaw);\\n            self.ride.yaw = geom::wrap_angle(self.ride.yaw + err.clamp(-1.0, 1.0) * dt * 2.0);\\n            self.ride.speed = 10.0;\\n        }\\n    }\\n\\n    pub fn hurt_vehicle(&mut self, dmg: f32) {\\n        if self.ride.kind == 0 || self.ride.stage == 4 {\\n            return;\\n        }\\n        self.ride.health -= dmg / self.tune.vehicle_tough.max(0.2);\\n        if self.ride.health > 70.0 {\\n            self.ride.stage = 0;\\n        } else if self.ride.health > 40.0 {\\n            self.ride.stage = 1;\\n        } else if self.ride.health > 15.0 {\\n            self.ride.stage = 2;\\n        } else if self.ride.health > 0.0 {\\n            if self.ride.stage < 3 {\\n                self.ride.fuse = 8.0;\\n            }\\n            self.ride.stage = 3;\\n        } else {\\n            self.ride.stage = 4;\\n        }\\n    }\\n\\n    fn handle_items(&mut self, input: &InputFrame, dt: f32) {\\n        if input.just(buttons::HEAL) && self.hp >= 20.0 && self.hp < 100.0 && self.syrettes > 0 && self.syrette_t <= 0.0 {\\n            self.syrettes -= 1;\\n            self.syrette_t = 1.5;\\n        }\\n        if self.syrette_t > 0.0 {\\n            let step = dt.min(self.syrette_t);\\n            self.hp = (self.hp + self.tune.syrette_heal / 1.5 * step).min(100.0);\\n            self.syrette_t -= step;\\n            if self.syrette_t <= 0.0 {\\n                self.syrette_t = 0.0;\\n                self.mark(\\\"syrette\\\");\\n            }\\n        }\\n        if self.hp < 20.0 && self.hp > 0.0 && input.down(buttons::HEAL) {\\n            self.treating = true;\\n            self.heal_t += dt;\\n            if self.heal_t >= 4.0 {\\n                self.hp = 40.0;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n                self.mark(wound_flag(self.wound.max(1)));\\n                self.wound = 0;\\n            }\\n        } else if self.hp >= 20.0 {\\n            self.treating = false;\\n            self.heal_t = 0.0;\\n        }\\n        if self.fever_state > 0 && input.down(buttons::PILLS) && self.pills > 0 {\\n            self.pill_t += dt;\\n            if self.pill_t >= 2.5 {\\n                self.pills -= 1;\\n                self.pill_t = 0.0;\\n                self.fever_state = 0;\\n                self.fever_t = 0.0;\\n                self.fever_attack = 0.0;\\n                self.mark(\\\"pill_taken\\\");\\n            }\\n        } else {\\n            self.pill_t = 0.0;\\n        }\\n    }\\n\\n    fn handle_gun(&mut self, input: &InputFrame, dt: f32) {\\n        if self.guns.is_empty() {\\n            return;\\n        }\\n        let infinite = self.dev.infinite;\\n        let no_jams = self.dev.no_jams;\\n        let i = self.slot.min(self.guns.len() - 1);\\n        {\\n            let g = &mut self.guns[i];\\n            if input.just(buttons::RELOAD) {\\n                g.tap_reload();\\n            }\\n            g.tick_clear(dt);\\n            if infinite {\\n                g.ammo = g.ammo.max(30);\\n            }\\n            if no_jams {\\n                g.jammed = false;\\n                g.force_jam = false;\\n            }\\n        }\\n        if self.guns[i].jammed {\\n            self.jam_seen = true;\\n        } else if self.jam_seen {\\n            self.mark(\\\"jam_cleared\\\");\\n        }\\n        let holster = self.ceasefire && geom::in_town(self.x, self.z);\\n        let want = input.down(buttons::PRIMARY) && !self.treating && !holster && self.rescue_t <= 0.0;\\n        if !want {\\n            return;\\n        }\\n        let ads = input.down(buttons::SECONDARY);\\n        let jam = self.tune.jam_chance;\\n        let wear = self.tune.weapon_wear;\\n        let br = self.tune.break_threshold;\\n        let pull = self.guns[i].pull(&mut self.rng, jam, wear, br);\\n        if pull != Pull::Fired && pull != Pull::Broke {\\n            return;\\n        }\\n        self.resolve_shot(ads);\\n        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if self.bodies[i].hp <= 0.0 {\\n                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n                    }\\n                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        if ignites || id == WeaponId::Flare || id == WeaponId::Rpg || id == WeaponId::Flamer || id == WeaponId::Mortar || id == WeaponId::Molotov || id == WeaponId::Frag {\\n            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n        }\\n        // Tracers: every third round, a quarter of them light dry grass.\\n        if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n            if self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n                self.mark(\\\"ignite_tracer\\\");\\n            }\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n                    b.alert = 1;\\n                }\\n            }\\n        }\\n        let _ = noise;\\n    }\\n\\n    fn update_bodies(&mut self, dt: f32) {\\n        let px = self.x;\\n        let pz = self.z;\\n        let stance = self.stance;\\n        let night = self.hour() < 5.0 || self.hour() > 20.0;\\n        let light = if night { 0.45 } else { 1.0 };\\n        let n = self.bodies.len();\\n        let dead_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && !b.alive).count();\\n        let live_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && b.alive).count();\\n        let morale_broken = dead_soldiers >= 2 && live_soldiers > 0 && live_soldiers <= dead_soldiers;\\n        let mut shooters = 0u32;\\n        for i in 0..n {\\n            if !self.bodies[i].alive {\\n                continue;\\n            }\\n            if self.bodies[i].poison > 0.0 {\\n                self.bodies[i].poison -= dt;\\n                if self.bodies[i].poison <= 0.0 && self.bodies[i].hp > 0.0 {\\n                    self.bodies[i].hp = 0.0;\\n                    self.bodies[i].alive = false;\\n                    self.mark(\\\"dart_kill\\\");\\n                    continue;\\n                }\\n            }\\n            if self.bodies[i].kind == 3 {\\n                let d0 = geom::dist(px, pz, self.bodies[i].x, self.bodies[i].z);\\n                if d0 < 40.0 && self.guns.first().map(|g| g.shots > 0).unwrap_or(false) {\\n                    let dx = self.bodies[i].x - px;\\n                    let dz = self.bodies[i].z - pz;\\n                    let len = (dx * dx + dz * dz).sqrt().max(0.1);\\n                    self.bodies[i].x += dx / len * 6.0 * dt;\\n                    self.bodies[i].z += dz / len * 6.0 * dt;\\n                    self.bodies[i].flee += 6.0 * dt;\\n                    if self.bodies[i].flee > 8.0 {\\n                        self.mark(\\\"animals_fled\\\");\\n                    }\\n                }\\n                continue;\\n            }\\n            if self.bodies[i].kind == 5 || self.bodies[i].kind == 6 {\\n                continue;\\n            }\\n            let crouched = stance == 1;\\n            let grass = grass_factor(px, pz, crouched);\\n            let posture = match stance {\\n                2 => 0.3,\\n                1 => 0.6,\\n                _ => 1.0,\\n            };\\n            let motion = 0.5;\\n            let rate = exposure(posture, grass, light, motion) * self.tune.detection;\\n            let dist = geom::dist(px, pz, self.bodies[i].x, self.bodies[i].z).max(1.0);\\n            let falloff = (30.0 / dist).clamp(0.0, 1.5);\\n            let (mx, mz) = ((px + self.bodies[i].x) * 0.5, (pz + self.bodies[i].z) * 0.5);\\n            let smoked = self.fire.cells.get(&geom::cell_of(mx, mz)).is_some_and(|c| c.burning);\\n            if morale_broken && self.bodies[i].kind == 1 {\\n                self.bodies[i].x += 5.0 * dt;\\n                self.bodies[i].flee += 5.0 * dt;\\n                self.bodies[i].alert = 3;\\n                continue;\\n            }\\n            if !self.dev.invisible && !smoked && self.bodies[i].alert < 2 {\\n                self.bodies[i].see += rate * falloff * dt;\\n                if self.bodies[i].see > 1.0 {\\n                    self.bodies[i].alert = 2;\\n                }\\n            }\\n            // Fire under an enemy makes them run.\\n            let (cx, cz) = (self.bodies[i].x, self.bodies[i].z);\\n            let cell = geom::cell_of(cx, cz);\\n            if self.fire.cells.get(&cell).map(|c| c.burning).unwrap_or(false) {\\n                self.bodies[i].alert = 4;\\n                self.bodies[i].x += 4.0 * dt;\\n                self.bodies[i].flee += 4.0 * dt;\\n                if self.bodies[i].flee > 3.0 {\\n                    self.mark(\\\"enemy_panicked\\\");\\n                }\\n            }\\n            if self.bodies[i].kind == 1 && self.bodies[i].alert >= 1 && !self.bodies[i].gun.jammed {\\n                if shooters >= 4 {\\n                    // One extra soldier peels off to the side instead of adding a fifth gun.\\n                    self.bodies[i].x += 3.0 * dt;\\n                    self.bodies[i].z += 1.5 * dt;\\n                    continue;\\n                }\\n                shooters += 1;\\n                let gpull = {\\n                    let jam = self.tune.jam_chance;\\n                    let wear = self.tune.weapon_wear;\\n                    let br = self.tune.break_threshold;\\n                    self.bodies[i].gun.pull(&mut self.rng, jam, wear, br)\\n                };\\n                if gpull == Pull::Jammed {\\n                    self.mark(\\\"enemy_jam\\\");\\n                }\\n                if gpull == Pull::Fired && self.rng.f32() < self.tune.enemy_accuracy * 0.15 {\\n                    let diff = match self.difficulty {\\n                        0 => 0.7,\\n                        2 => 1.3,\\n                        _ => 1.0,\\n                    };\\n                    if !self.dev.god && self.rescue_t <= 0.0 {\\n                        self.hp -= self.tune.enemy_damage * 0.15 * diff * dt.max(0.05) * 10.0;\\n                    }\\n                }\\n            }\\n            self.bodies[i].gun.tick_clear(dt);\\n            if self.bodies[i].hp <= 0.0 {\\n                self.bodies[i].alive = false;\\n            }\\n        }\\n    }\\n\\n    fn update_fever(&mut self, dt: f32) {\\n        if self.dev.no_fever {\\n            return;\\n        }\\n        if self.fever_state == 0 {\\n            self.fever_t += dt;\\n            if self.fever_t >= self.tune.fever_interval {\\n                self.fever_state = 1;\\n                self.fever_warn = 0.0;\\n                self.mark(\\\"fever_warned\\\");\\n            }\\n        } else if self.fever_state == 1 {\\n            self.fever_warn += dt;\\n            if self.fever_warn >= 40.0 {\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n        } else if self.fever_state == 2 {\\n            self.fever_attack += dt;\\n            if self.fever_attack >= 60.0 && self.pills == 0 {\\n                self.blackout();\\n            }\\n        }\\n    }\\n\\n    fn blackout(&mut self) {\\n        let (sx, sz) = geom::nearest_safe(self.x, self.z);\\n        self.x = sx;\\n        self.z = sz;\\n        self.hp = 50.0;\\n        self.diamonds = (self.diamonds as f32 * 0.8).floor() as u32;\\n        self.fever_state = 0;\\n        self.fever_t = 0.0;\\n        self.fever_attack = 0.0;\\n        self.minutes += 6.0 * 60.0;\\n        self.mark(\\\"blackout\\\");\\n    }\\n\\n    fn update_rescue(&mut self, dt: f32) {\\n        if self.hp <= 0.0 && self.rescue_t <= 0.0 && !self.companions.iter().any(|c| c.rescue_spent) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.alive && !c.down) {\\n                c.rescue_spent = true;\\n                self.rescue_t = 3.0;\\n                self.hp = 1.0;\\n            }\\n        }\\n        if self.rescue_t > 0.0 {\\n            self.rescue_t -= dt;\\n            let (sy, cy) = self.yaw.sin_cos();\\n            self.x -= sy * dt * 4.0;\\n            self.z -= -cy * dt * 4.0;\\n            if self.rescue_t <= 0.0 {\\n                self.rescue_t = 0.0;\\n                self.hp = 50.0;\\n                self.slot = 0;\\n                self.mark(\\\"player_rescued\\\");\\n            }\\n        }\\n    }\\n\\n    fn special_actions(&mut self, input: &InputFrame, dt: f32) {\\n        let near_cache = geom::dist(self.x, self.z, self.tracker_cache.0, self.tracker_cache.1);\\n        if near_cache < 4.0 {\\n            self.mark(\\\"cache_tracker\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            self.hold_t += dt;\\n        } else {\\n            self.hold_t = 0.0;\\n        }\\n        if input.just(buttons::INTERACT) || (input.down(buttons::INTERACT) && self.hold_t > 0.4) {\\n            self.try_interact();\\n        }\\n        if input.just(buttons::MELEE) {\\n            let crouched = self.stance == 1;\\n            let px = self.x;\\n            let pz = self.z;\\n            let mut stealth = false;\\n            for b in &mut self.bodies {\\n                if b.alive && b.kind == 1 && geom::dist(px, pz, b.x, b.z) < 2.2 {\\n                    b.hp = 0.0;\\n                    b.alive = false;\\n                    if crouched {\\n                        stealth = true;\\n                    }\\n                }\\n            }\\n            if stealth {\\n                self.mark(\\\"stealth_kill\\\");\\n            }\\n        }\\n        // Companion down timer.\\n        for c in &mut self.companions {\\n            if c.down && c.alive {\\n                c.down_t += dt;\\n            }\\n        }\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && c.down_t > 45.0) {\\n            self.companions[i].alive = false;\\n            self.companions[i].down = false;\\n            self.mark(\\\"companion_died\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.down && c.alive && geom::dist(self.x, self.z, c.x, c.z) < 3.0) {\\n                if self.hold_t > 3.0 && self.syrettes > 0 && !c.doomed_enough() {\\n                    // patched below after the borrow... \\n                }\\n            }\\n        }\\n        self.patch_or_dose();\\n        // Scripted igniters that are not shots.\\n        if self.step_ready {\\n            if let Some(spec) = self.current() {\\n                self.script_ignite(spec, input);\\n            }\\n        }\\n    }\\n\\n    fn patch_or_dose(&mut self) {\\n        if self.hold_t < 3.0 || self.syrettes == 0 {\\n            return;\\n        }\\n        let doomed = matches!(self.current(), Some(Spec::Overdose));\\n        let px = self.x;\\n        let pz = self.z;\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && geom::dist(px, pz, c.x, c.z) < 4.0) {\\n            self.syrettes -= 1;\\n            if doomed {\\n                self.companions[i].alive = false;\\n                self.companions[i].down = false;\\n                self.mark(\\\"companion_overdosed\\\");\\n            } else {\\n                self.companions[i].down = false;\\n                self.companions[i].down_t = 0.0;\\n                self.mark(\\\"companion_patched\\\");\\n            }\\n        }\\n    }\\n\\n    fn script_ignite(&mut self, spec: Spec, _input: &InputFrame) {\\n        // Each source lights a fresh patch west of the player. East stays clear for tracers.\\n        let n = match spec {\\n            Spec::Ignite(k) => k as f32,\\n            _ => 0.0,\\n        };\\n        let x = self.x - 24.0 - n * 18.0;\\n        let z = self.z - 16.0;\\n        match spec {\\n            Spec::Ignite(0) => {\\n                if self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_flare\\\");\\n                }\\n            }\\n            Spec::Ignite(1) => {\\n                if self.fire.ignite_disk(x, z, 6.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_rocket\\\");\\n                }\\n            }\\n            Spec::Ignite(2) => {\\n                if self.fire.ignite_at(x + 1.0, z, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_flamer\\\");\\n                }\\n            }\\n            Spec::Ignite(3) => {\\n                if self.fire.ignite_disk(x, z + 4.0, 8.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_mortar\\\");\\n                }\\n            }\\n            Spec::Ignite(4) => {\\n                if self.fire.ignite_disk(x, z, 4.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_molotov\\\");\\n                }\\n            }\\n            Spec::Ignite(5) => {\\n                if self.fire.ignite_disk(x + 3.0, z, 6.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_frag\\\");\\n                }\\n            }\\n            Spec::Ignite(6) => {\\n                if self.fire.ignite_disk(x, z, 5.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_barrel\\\");\\n                }\\n            }\\n            Spec::Ignite(7) => {\\n                self.mark(\\\"ignite_vehicle\\\");\\n                let _ = self.fire.ignite_disk(self.x, self.z, 5.0, self.tune.burn_time, self.minutes);\\n            }\\n            Spec::Ignite(8) => {\\n                self.mark(\\\"ignite_person\\\");\\n                let _ = self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes);\\n            }\\n            Spec::Ignite(9) => {\\n                self.weather = 2;\\n                if self.fire.ignite_at(x + 6.0, z - 6.0, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_lightning\\\");\\n                }\\n                self.weather = 0;\\n            }\\n            Spec::Ignite(11) => {\\n                if self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_cigarette\\\");\\n                }\\n            }\\n            Spec::Tanks => {\\n                self.blow_tanks();\\n            }\\n            Spec::Ending(0) => {\\n                let _ = self.fire.ignite_disk(self.x, self.z, 8.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"ending_burn\\\");\\n            }\\n            Spec::Ending(1) => {\\n                // The ledger is read under fire. step_t is real time on this step.\\n                if self.step_t >= 180.0 {\\n                    self.mark(\\\"ending_read\\\");\\n                }\\n            }\\n            Spec::Ending(2) => {\\n                self.mark(\\\"ending_chair\\\");\\n            }\\n            Spec::Bus { x, z } => {\\n                let stop = geom::place(\\\"Junction\\\");\\n                if geom::dist(self.x, self.z, stop.0, stop.1) < 14.0 && self.diamonds >= 1 {\\n                    self.diamonds -= 1;\\n                    self.x = x;\\n                    self.z = z;\\n                    self.ride.seat = 0;\\n                    self.minutes += 20.0;\\n                    self.mark(\\\"bus_taken\\\");\\n                    self.mark(\\\"diamonds_spent\\\");\\n                }\\n            }\\n            _ => {}\\n        }\\n        // Tracer step: spray the ground in front.\\n        if matches!(spec, Spec::Ignite(10)) {\\n            self.pitch = -0.25;\\n            for _ in 0..4 {\\n                if self.guns.is_empty() {\\n                    break;\\n                }\\n                let i = self.slot.min(self.guns.len() - 1);\\n                if self.guns[i].ammo == 0 {\\n                    self.guns[i].ammo = 30;\\n                }\\n                self.guns[i].condition = 90.0;\\n                let pull = self.guns[i].pull(&mut self.rng, 0.0, 0.0, 0.0);\\n                if pull == Pull::Fired || pull == Pull::Broke {\\n                    self.resolve_shot(true);\\n                }\\n            }\\n        }\\n    }\\n\\n    fn try_interact(&mut self) {\\n        if geom::dist(self.x, self.z, 170.0, 470.0) < 16.0 || geom::dist(self.x, self.z, -260.0, -700.0) < 16.0 || geom::dist(self.x, self.z, 830.0, 255.0) < 16.0\\n        {\\n            if self.hold_t > 0.3 && matches!(self.current(), Some(Spec::Claim)) {\\n                self.mark(\\\"safe_house_claimed\\\");\\n                self.hp = 100.0;\\n            }\\n            if self.hold_t > 0.8 && matches!(self.current(), Some(Spec::Sleep { .. })) {\\n                let hours = match self.current() {\\n                    Some(Spec::Sleep { hours }) => hours,\\n                    _ => 8.0,\\n                };\\n                self.minutes += hours * 60.0;\\n                self.hp = 100.0;\\n                for c in &mut self.companions {\\n                    c.rescue_spent = false;\\n                }\\n                self.yaw = std::f32::consts::PI;\\n                self.looking_at_post = false;\\n                self.mark(\\\"sleep_used\\\");\\n                if hours >= 24.0 && self.post_clear {\\n                    self.post_clear = false;\\n                    self.mark(\\\"post_remanned\\\");\\n                }\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Shop)) {\\n            let price = 8u32;\\n            if self.diamonds >= price {\\n                self.diamonds -= price;\\n                self.guns.push(Gun::new(WeaponId::Battle));\\n                self.mark(\\\"weapon_bought\\\");\\n                self.mark(\\\"diamonds_spent\\\");\\n                self.infamy += 1;\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Locker)) && self.guns.len() > 1 {\\n            self.slot = self.guns.len() - 1;\\n            self.mark(\\\"locker_used\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Loot)) && !self.guns.iter().any(|g| g.id == WeaponId::Ar) {\\n\",\"total_lines\":2449}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"d5e8f58d-2629-4d4c-b0e4-8ab961804b37"}
