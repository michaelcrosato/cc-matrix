r: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\"},{\"line_number\":60,\"content\":\"        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\"},{\"line_number\":61,\"content\":\"        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\"},{\"line_number\":62,\"content\":\"        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\"},{\"line_number\":63,\"content\":\"        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"matches\":[{\"line_number\":1555,\"content\":\"        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\"},{\"line_number\":1558,\"content\":\"    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\"},{\"line_number\":1618,\"content\":\"        if ignites || id == WeaponId::Flare || id == WeaponId::Rpg || id == WeaponId::Flamer || id == WeaponId::Mortar || id == WeaponId::Molotov || id == WeaponId::Frag {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/c