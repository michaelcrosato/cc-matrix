ady {\\n            if let Some(spec) = self.current() {\\n                self.script_ignite(spec, input);\\n            }\\n        }\\n    }\\n\\n    fn patch_or_dose(&mut self) {\\n        if self.hold_t < 3.0 || self.syrettes == 0 {\\n            return;\\n        }\\n        let doomed = matches!(self.current(), Some(Spec::Overdose));\\n        let px = self.x;\\n        let pz = self.z;\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && geom::dist(px, pz, c.x, c.z) < 4.0) {\\n            self.syrettes -= 1;\\n            if doomed {\\n                self.companions[i].alive = false;\\n                self.companions[i].down = false;\\n                self.mark(\\\"companion_overdosed\\\");\\n            } else {\\n                self.companions[i].down = false;\\n                self.companions[i].down_t = 0.0;\\n                self.mark(\\\"companion_patched\\\");\\n            }\\n        }\\n    }\\n\\n    fn script_ignite(&mut self, spec: Spec, _input: &InputFrame) {\\n        match spec {\\n            Spec::Tanks => self.blow_tanks(),\\n            Spec::Ending(_) => {\\n                if self.finale == Some(1) && self.step_t >= 180.0 {\\n                    self.mark(\\\"ending_read\\\");\\n                }\\n            }\\n            Spec::Bus { x, z } => {\\n                let stop = geom::place(\\\"Junction\\\");\\n                if geom::dist(self.x, self.z, stop.0, stop.1) < 14.0 && self.diamonds >= 1 {\\n                    self.diamonds -= 1;\\n                    self.x = x;\\n                    self.z = z;\\n                    self.ride.seat = 0;\\n                    self.ride.x = x;\\n                    self.ride.z = z;\\n                    self.ride.speed = 0.0;\\n                    self.minutes += 20.0;\\n                    self.mark(\\\"bus_taken\\\");\\n                    self.mark(\\\"diamonds_spent\\\");\\n                }\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    fn try_interact(&mut self) {\\n        if matches!(self.current(), Some(Spec::Ignite(11))) && self.fire.ignite_at(self.x, self.z, self.tune.burn_time, self.minutes) {\\n            self.mark(\\\"ignite_cigarette\\\");\\n        }\\n        if self.finale == Some(2) && matches!(self.current(), Some(Spec::Ending(_))) {\\n            self.mark(\\\"ending_chair\\\");\\n        }\\n        if geom::dist(self.x, self.z, 170.0, 470.0) < 16.0 || geom::dist(self.x, self.z, -260.0, -700.0) < 16.0 || geom::dist(self.x, self.z, 830.0, 255.0) < 16.0\\n        {\\n            if self.hold_t > 0.3 && matches!(self.current(), Some(Spec::Claim)) {\\n                self.mark(\\\"safe_house_claimed\\\");\\n                self.hp = 100.0;\\n            }\\n            if self.hold_t > 0.8 && matches!(self.current(), Some(Spec::Sleep { .. })) {\\n                let hours = match self.current() {\\n                    Some(Spec::Sleep { hours }) => hours,\\n                    _ => 8.0,\\n                };\\n                self.minutes += hours * 60.0;\\n                self.hp = 100.0;\\n                for c in &mut self.companions {\\n                    c.rescue_spent = false;\\n                }\\n                self.yaw = std::f32::consts::PI;\\n                self.looking_at_post = false;\\n                self.mark(\\\"sleep_used\\\");\\n                if hours >= 24.0 && self.post_clear {\\n                    self.post_clear = false;\\n                    self.mark(\\\"post_remanned\\\");\\n                }\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Shop)) {\\n            let price = 8u32;\\n            if self.diamonds >= price {\\n                self.diamonds -= price;\\n                self.guns.push(Gun::new(WeaponId::Battle));\\n                self.mark(\\\"weapon_bought\\\");\\n\",\"total_lines\":2752}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e93deaeb-056c-4fd5-a49e-34e3a3793135-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"40→\\n    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        self.ignite_cell(cell_of(x, z), life, minutes)\\n    }\\n\\n    pub fn ignite_cell(&mut self, c: (i32, i32), life: f32, minutes: f32) -> bool {\\n        let (x, z) = cell_center(c);\\n50→        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        if let Some(cell) = self.cells.get(&c) {\\n            if cell.burning {\\n                return false;\\n            }\\n            if minutes < cell.burnt_until {\\n                return false;\\n            }\\n60→        }\\n        self.cells.insert(c, Cell { burning: true, life, burnt_until: 0.0 });\\n        self.burned += 1;\\n        true\\n    }\\n\\n    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\\n        let r = radius.ceil() as i32 + 1;\\n        let (cx, cz) = cell_of(x, z);\\n        let mut n = 0;\\n70→        for iz in (cz - r)..=(cz + r) {\\n            for ix in (cx - r)..=(cx + r) {\\n                let (px, pz) = cell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n80→\\n    /// Step the grid. Returns cells extinguished by rain.\\n    pub fn tick(&mut self, dt: f32, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rain: bool, rng: &mut Rng) -> u32 {\\n        self.wind_for_test = wind;\\n        self.acc += dt;\\n        let mut extinguished = 0;\\n        if rain {\\n            let keys: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n            for k in keys {\\n                self.cells.remove(&k);\\n90→                extinguished += 1;\\n            }\\n            self.acc = 0.0;\\n            return extinguished;\\n        }\\n        while self.acc >= FIRE_DT {\\n            self.acc -= FIRE_DT;\\n            self.spread_once(wind, spread, burn_time, minutes, rng);\\n        }\\n        let done: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning && c.life <= 0.0).map(|(k, _)| *k).collect();\\n100→        for k in done {\\n            if let Some(c) = self.cells.get_mut(&k) {\\n                c.burning = false;\\n                // Two in-game days. One real second is one in-game minute, so 48 hours = 2880 minutes.\\n                c.burnt_until = minutes + 48.0 * 60.0;\\n                c.life = 0.0;\\n            }\\n        }\\n        self.cells.retain(|_, c| c.burning || minutes < c.burnt_until);\\n        extinguished\\n110→    }\\n\\n    fn spread_once(&mut self, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(0.0, -1.0) };\\n        let burning: Vec<(i32, i32)> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n        if burning.is_empty() {\\n            return;\\n        }\\n        // Age the flames.\\n120→        for k in &burning {\\n            if let Some(c) = self.cells.get_mut(k) {\\n                c.life -= FIRE_DT;\\n            }\\n        }\\n        if speed < 0.5 {\\n            // Calm: grow the four extremes together so the scar stays roughly round.\\n            let positives = [\\n                *burning.iter().max_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n130→                *burning.iter().max_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n            ];\\n            let offs = [(1, 0), (-1, 0), (0, 1), (0, -1)];\\n            let p = (spread * 0.35 * FIRE_DT).clamp(0.0, 0.5);\\n            for (tip, off) in positives.iter().zip(offs) {\\n                if rng.f32() < p {\\n                    let _ = self.ignite_cell((tip.0 + off.0, tip.1 + off.1), burn_time, minutes);\\n                }\\n            }\\n140→            return;\\n        }\\n        let proj = |c: (i32, i32)| {\\n            let (x, z) = cell_center(c);\\n            x * dir.x + z * dir.y\\n        };\\n        let down = *burning.iter().max_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        let up = *burning.iter().min_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        self.try_tip(down, dir, true, speed, spread, burn_time, minutes, rng);\\n        self.try_tip(up, dir, false, speed, spread, burn_time, minutes, rng);\\n150→        // Embers jump only above 8 m/s, far enough to cross a road.\\n        if speed > 8.0 && rng.f32() < 0.12 {\\n            let (x, z) = cell_center(down);\\n            let hop = 6.0 + rng.f32() * 9.0;\\n            let _ = self.ignite_at(x + dir.x * hop, z + dir.y * hop, burn_time, minutes);\\n        }\\n    }\\n\\n    fn try_tip(&mut self, tip: (i32, i32), dir: Vec2, downwind: bool, speed: f32, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let step = if downwind { (dir.x.signum() as i32, dir.y.signum() as i32) } else { (-dir.x.signum() as i32, -dir.y.signum() as i32) };\",\"content_concise\":\"40→\\n    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        self.ignite_cell(cell_of(x, z), life, minutes)\\n    }\\n\\n    pub fn ignite_cell(&mut self, c: (i32, i32), life: f32, minutes: f32) -> bool {\\n        let (x, z) = cell_center(c);\\n50→        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        if let Some(cell) = self.cells.get(&c) {\\n            if cell.burning {\\n                return false;\\n            }\\n            if minutes < cell.burnt_until {\\n                return false;\\n            }\\n60→        }\\n        self.cells.insert(c, Cell { burning: true, life, burnt_until: 0.0 });\\n        self.burned += 1;\\n        true\\n    }\\n\\n    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\\n        let r = radius.ceil() as i32 + 1;\\n        let (cx, cz) = cell_of(x, z);\\n        let mut n = 0;\\n70→        for iz in (cz - r)..=(cz + r) {\\n            for ix in (cx - r)..=(cx + r) {\\n                let (px, pz) = cell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n80→\\n    /// Step the grid. Returns cells extinguished by rain.\\n    pub fn tick(&mut self, dt: f32, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rain: bool, rng: &mut Rng) -> u32 {\\n        self.wind_for_test = wind;\\n        self.acc += dt;\\n        let mut extinguished = 0;\\n        if rain {\\n            let keys: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n            for k in keys {\\n                self.cells.remove(&k);\\n90→                extinguished += 1;\\n            }\\n            self.acc = 0.0;\\n            return extinguished;\\n        }\\n        while self.acc >= FIRE_DT {\\n            self.acc -= FIRE_DT;\\n            self.spread_once(wind, spread, burn_time, minutes, rng);\\n        }\\n        let done: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning && c.life <= 0.0).map(|(k, _)| *k).collect();\\n100→        for k in done {\\n            if let Some(c) = self.cells.get_mut(&k) {\\n                c.burning = false;\\n                // Two in-game days. One real second is one in-game minute, so 48 hours = 2880 minutes.\\n                c.burnt_until = minutes + 48.0 * 60.0;\\n                c.life = 0.0;\\n            }\\n        }\\n        self.cells.retain(|_, c| c.bu