>= self.post_reman_at && !self.looking_at_post {\\n            self.post_clear = false;\\n            self.mark(\\\"post_remanned\\\");\\n        }\\n    }\\n\\n    fn clear_bodies(&mut self) {\\n        self.bodies.clear();\\n    }\\n2090→\\n    fn spawn_soldier(&mut self, x: f32, z: f32, hp: f32, jammy: bool) {\\n        let mut g = Gun::new(WeaponId::Ar);\\n        if jammy {\\n            g.condition = 5.0;\\n            g.wear = 0.0;\\n            g.ammo = 400;\\n            g.reserve = 400;\\n            // A break roll can win before the jam roll. This set piece is a known bad gun.\\n            g.force_jam = true;\\n2100→        }\\n        self.bodies.push(Body {\\n            kind: 1,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: if jammy { 2 } else { 0 },\\n            gun: g,\\n2110→            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_animal(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n2120→            kind: 3,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 20.0,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n2130→            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_truck(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 6,\\n            x,\\n2140→            z,\\n            yaw: 0.0,\\n            hp: 80.0,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n2150→            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_tank_farm(&mut self) {\\n        self.clear