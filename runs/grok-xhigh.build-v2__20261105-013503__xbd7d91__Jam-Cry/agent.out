.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/entity.rs\",\"matches\":[{\"line_number\":308,\"content\":\"    pub name: String,\"},{\"line_number\":409,\"content\":\"    pub name: String,\"},{\"line_number\":508,\"content\":\"    pub map: BTreeMap<EntityId, Entity>,\"},{\"line_number\":517,\"content\":\"    pub fn get(&self, id: EntityId) -> Option<&Entity> {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-e4726cca-f849-4f3a-8d74-66eca012e69f-24","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Sparse 2 m fire grid. Spread is a wind-biased front: each tick the downwind tip and the\\n//! upwind tip each get one roll of `spread * fuel * dryness * exp(k * dot * speed) * dt`.\\n\\nuse std::collections::BTreeMap;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::geom::{self, cell_center, cell_of};\\n10→use crate::rng::Rng;\\n\\npub const FIRE_K: f32 = 0.10;\\npub const FIRE_DT: f32 = 0.25;\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Cell {\\n    pub burning: bool,\\n    pub life: f32,\\n    pub burnt_until: f32,\\n20→}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct FireMap {\\n    pub cells: BTreeMap<(i32, i32), Cell>,\\n    pub acc: f32,\\n    pub burned: u32,\\n    pub wind_for_test: Vec2,\\n}\\n\\n30→impl Default for FireMap {\\n    fn default() -> Self {\\n        Self { cells: BTreeMap::new(), acc: 0.0, burned: 0, wind_for_test: Vec2::ZERO }\\n    }\\n}\\n\\nimpl FireMap {\\n    pub fn burning_count(&self) -> usize {\\n        self.cells.values().filter(|c| c.burning).count()\\n    }\\n40→\\n    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        self.ignite_cell(cell_of(x, z), life, minutes)\\n    }\\n\\n    pub fn ignite_cell(&mut self, c: (i32, i32), life: f32, minutes: f32) -> bool {\\n        let (x, z) = cell_center(c);\\n50→        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        if let Some(cell) = self.cells.get(&c) {\\n            if cell.burning {\\n                return false;\\n            }\\n            if minutes < cell.burnt_until {\\n                return false;\\n            }\\n60→        }\\n        self.cells.insert(c, Cell { burning: true, life, burnt_until: 0.0 });\\n        self.burned += 1;\\n        true\\n    }\\n\\n    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\\n        let r = radius.ceil() as i32 + 1;\\n        let (cx, cz) = cell_of(x, z);\\n        let mut n = 0;\\n70→        for iz in (cz - r)..=(cz + r) {\\n            for ix in (cx - r)..=(cx + r) {\\n                let (px, pz) = cell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n80→\",\"content_concise\":\"1→//! Sparse 2 m fire grid. Spread is a wind-biased front: each tick the downwind tip and the\\n//! upwind tip each get one roll of `spread * fuel * dryness * exp(k * dot * speed) * dt`.\\n\\nuse std::collections::BTreeMap;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::geom::{self, cell_center, cell_of};\\n10→use crate::rng::Rng;\\n\\npub const FIRE_K: f32 = 0.10;\\npub const FIRE_DT: f32 = 0.25;\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Cell {\\n    pub burning: bool,\\n    pub life: f32,\\n    pub burnt_until: f32,\\n20→}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct FireMap {\\n    pub cells: BTreeMap<(i32, i32), Cell>,\\n    pub acc: f32,\\n    pub burned: u32,\\n    pub wind_for_test: Vec2,\\n}\\n\\n30→impl Default for FireMap {\\n    fn default() -> Self {\\n        Self { cells: BTreeMap::new(), acc: 0.0, burned: 0, wind_for_test: Vec2::ZERO }\\n    }\\n}\\n\\nimpl FireMap {\\n    pub fn burning_count(&self) -> usize {\\n        self.cells.values().filter(|c| c.burning).count()\\n    }\\n40→\\n    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        self.ignite_cell(cell_of(x, z), life, minutes)\\n    }\\n\\n    pub fn ignite_cell(&mut self, c: (i32, i32), life: f32, minutes: f32) -> bool {\\n        let (x, z) = cell_center(c);\\n50→        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        if let Some(cell) = self.cells.get(&c) {\\n            if cell.burning {\\n                return false;\\n            }\\n            if minutes < cell.burnt_until {\\n                return false;\\n            }\\n60→        }\\n        self.cells.insert(c, Cell { burning: true, life, burnt_until: 0.0 });\\n        self.burned += 1;\\n        true\\n    }\\n\\n    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\\n        let r = radius.ceil() as i32 + 1;\\n        let (cx, cz) = cell_of(x, z);\\n        let mut n = 0;\\n70→        for iz in (cz - r)..=(cz + r) {\\n            for ix in (cx - r)..=(cx + r) {\\n                let (px, pz) = cell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n80→\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/fire.rs\",\"offset\":null,\"limit\":80,\"raw_output\":\"//! Sparse 2 m fire grid. Spread is a wind-biased front: each tick the downwind tip and the\\n//! upwind tip each get one roll of `spread * fuel * dryness * exp(k * dot * speed) * dt`.\\n\\nuse std::collections::BTreeMap;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::geom::{self, cell_center, cell_of};\\nuse crate::rng::Rng;\\n\\npub const FIRE_K: f32 = 0.10;\\npub const FIRE_DT: f32 = 0.25;\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Cell {\\n    pub burning: bool,\\n    pub life: f32,\\n    pub burnt_until: f32,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct FireMap {\\n    pub cells: BTreeMap<(i32, i32), Cell>,\\n    pub acc: f32,\\n    pub burned: u32,\\n    pub wind_for_test: Vec2,\\n}\\n\\nimpl Default for FireMap {\\n    fn default() -> Self {\\n        Self { cells: BTreeMap::new(), acc: 0.0, burned: 0, wind_for_test: Vec2::ZERO }\\n    }\\n}\\n\\nimpl FireMap {\\n    pub fn burning_count(&self) -> usize {\\n        self.cells.values().filter(|c| c.burning).count()\\n    }\\n\\n    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        self.ignite_cell(cell_of(x, z), life, minutes)\\n    }\\n\\n    pub fn ignite_cell(&mut self, c: (i32, i32), life: f32, minutes: f32) -> bool {\\n        let (x, z) = cell_center(c);\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        if let Some(cell) = self.cells.get(&c) {\\n            if cell.burning {\\n                return false;\\n            }\\n            if minutes < cell.burnt_until {\\n                return false;\\n            }\\n        }\\n        self.cells.insert(c, Cell { burning: true, life, burnt_until: 0.0 });\\n        self.burned += 1;\\n        true\\n    }\\n\\n    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\\n        let r = radius.ceil() as i32 + 1;\\n        let (cx, cz) = cell_of(x, z);\\n        let mut n = 0;\\n        for iz in (cz - r)..=(cz + r) {\\n            for ix in (cx - r)..=(cx + r) {\\n                let (px, pz) = cell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n\\n\",\"total_lines\":192}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e4726cca-f849-4f3a-8d74-66eca012e69f-25","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"480→    let mut throttle = InputFrame::default();\\n    throttle.axes.y = 1.0;\\n    run(&mut dry, &throttle, 1.0);\\n    assert!(dry.ride.speed.abs() < 0.2, \\\"boat on grass {}\\\", dry.ride.speed);\\n\\n    let (wx, wz) = geom::nearest_water(0.0, 0.0);\\n    let mut wet = World::fresh(4);\\n    wet.ride.kind = 2;\\n    wet.ride.seat = 1;\\n    wet.ride.x = wx;\\n490→    wet.ride.z = wz;\\n    wet.x = wx;\\n    wet.z = wz;\\n    let (tx, tz) = geom::water_ahead(wx, wz, 40.0);\\n    wet.ride.yaw = geom::yaw_toward(wx, wz, tx, tz);\\n    run(&mut wet, &throttle, 2.0);\\n    assert!(wet.flags.contains(\\\"boat_driven\\\"), \\\"dist {} deep {}\\\", wet.ride.dist, geom::deep_water(wet.ride.x, wet.ride.z));\\n\\n    wet.ride.npc = true;\\n    let z0 = wet.ride.z;\\n500→    run(&mut wet, &InputFrame::default(), 1.0);\\n    assert!((wet.ride.x - wx).abs() > 0.5 || (wet.ride.z - z0).abs() > 0.5);\\n\\n    let seat = wet.ride.seat;\\n    wet.tick(&press(buttons::USE), DT);\\n    assert_ne!(wet.ride.seat, seat);\\n    wet.ride.seat = 2;\\n    wet.tick(&hold(buttons::PRIMARY), DT);\\n    assert!(wet.flags.contains(\\\"mounted_gun\\\"));\\n}\\n510→\\n#[test]\\nfn shop_tracker_and_shell() {\\n    let mut w = World::fresh(1);\\n    w.diamonds = 0;\\n    let guns = w.guns.len();\\n    assert!(!w.try_buy());\\n    assert_eq!(w.guns.len(), guns);\\n    assert_eq!(w.diamonds, 0);\\n\\n520→    w.tracker_cache = (w.x + 10.0, w.z);\\n    let near = w.tracker_rate();\\n    w.tracker_cache = (w.x + 50.0, w.z);\\n    let far = w.tracker_rate();\\n    assert!(near > far && far > 0.0, \\\"{near} vs {far}\\\");\\n\\n    let mut w = World::campaign(2, Route::Human);\\n    assert!(w.rows().len() <= 7);\\n    let screens = [\\n        Screen::Title, Screen::Difficulty, Screen::Merc, Screen::Prologue, Screen::Pause, Screen::Settings, Screen::About,\\n530→        Screen::Dev, Screen::Mp, Screen::Attract,\\n    ];\\n    for screen in screens {\\n        w.screen = screen;\\n        for tab in 0..6 {\\n            w.tab = tab;\\n            for page in 0..6 {\\n                w.page = page;\\n                assert!(w.rows().len() <= 7, \\\"{screen:?} tab {tab} page {page} {:?}\\\", w.rows());\\n            }\\n540→        }\\n    }\\n    w.screen = Screen::Difficulty;\\n    w.focus = 0;\\n    w.apply_menu(MenuInput { up: true, ..MenuInput::default() });\\n    assert_eq!(w.focus, 2);\\n    w.apply_menu(MenuInput { back: true, ..MenuInput::default() });\\n    assert_eq!(w.screen, Screen::Title);\\n\\n    w.focus = 0;\\n550→    w.apply_menu(MenuInput { pointer: Some((400.0, 300.0)), ..MenuInput::default() });\\n    assert_eq!(w.focus, 1);\\n    w.apply_menu(MenuInput { pointer: Some((400.0, 230.0)), click: true, ..MenuInput::default() });\\n    assert_eq!(w.screen, Screen::Difficulty);\\n\\n    assert_eq!(glyph(\\\"confirm\\\", Device::Gamepad, false), \\\"Cross\\\");\\n    assert_eq!(glyph(\\\"confirm\\\", Device::Gamepad, true), \\\"A\\\");\\n    assert_eq!(glyph(\\\"fire\\\", Device::Keyboard, false), \\\"LMB\\\");\\n    assert_eq!(glyph(\\\"reload\\\", Device::Gamepad, false), \\\"Square\\\");\\n\\n560→    w.screen = Screen::Dev;\\n    w.tab = 5;\\n    w.page = 1;\\n    w.focus = 2;\\n    let before = w.tune.fire_spread;\\n    w.apply_menu(MenuInput { right: true, ..MenuInput::default() });\\n    assert!(w.tune.fire_spread > before, \\\"{} -> {}\\\", before, w.tune.fire_spread);\\n    w.page = 3;\\n    w.focus = 3;\\n    w.apply_menu(MenuInput { confirm: true, ..MenuInput::default() });\\n570→    assert!((w.tune.fire_spread - w.tune0.fire_spread).abs() < 1e-4);\\n\\n    let mut w = World::campaign(3, Route::Human);\\n    run(&mut w, &InputFrame::default(), 9.0);\\n    assert_ne!(w.screen, Screen::Attract);\\n    run(&mut w, &InputFrame::default(), 1.2);\\n    assert_eq!(w.screen, Screen::Attract);\\n    let saves = w.saves_written;\\n    let mut acc = 0.0f32;\\n    while acc < 800.0 {\\n580→        w.tick(&InputFrame::default(), 0.5);\\n        acc += 0.5;\\n    }\\n    assert!(w.attract_loops >= 5, \\\"loops {}\\\", w.attract_loops);\\n    assert_eq!(w.attract_seen, (1u16 << 10) - 1, \\\"seen {:b}\\\", w.attract_seen);\\n    assert_eq!(w.saves_written, saves);\\n\\n    let mut w = World::campaign(4, Route::Human);\\n    let mut seen = vec![format!(\\\"{:?}\\\", w.screen)];\\n    for bit in [buttons::CONFIRM, buttons::JUMP, buttons::CONFIRM, buttons::JUMP] {\\n590→        w.tick(&press(bit), DT);\\n        seen.push(format!(\\\"{:?}\\\", w.screen));\\n    }\\n    assert_eq!(w.screen, Screen::Playing, \\\"{seen:?}\\\");\\n    assert!(seen.windows(2).all(|p| p[0] != p[1]), \\\"{seen:?}\\\");\\n}\\n\\n#[test]\\nfn fiction_has_no_source_names_and_no_audio_files() {\\n    let banned = [\\n600→        \\\"jackal\\\", \\\"ufll\\\", \\\"apr\\\", \\\"pala\\\", \\\"mosate\\\", \\\"bowa\\\", \\\"leboa\\\", \\\"oluwagembi\\\", \\\"mike's bar\\\", \\\"marty\\\", \\\"alencar\\\",\\n        \\\"warren clyde\\\", \\\"paul ferenc\\\", \\\"hyppolite\\\", \\\"xianyong\\\", \\\"josip\\\", \\\"hakim\\\", \\\"bilders\\\", \\\"quarbani\\\", \\\"voorhees\\\",\\n        \\\"todo\\\", \\\"tbd\\\", \\\"placeholder\\\", \\\"lorem\\\",\\n    ];\\n    for line in fiction_lines() {\\n        let low = line.to_lowercase();\\n        if low.contains(\\\"far cry 2\\\") {\\n            assert!(line.contains(\\\"Source:\\\"), \\\"{line}\\\");\\n        }\\n        for word in banned {\\n610→            assert!(!low.contains(word), \\\"{word} in {line}\\\");\\n        }\\n    }\\n    let root = Path::new(env!(\\\"CARGO_MANIFEST_DIR\\\")).join(\\\"src/games/merc\\\");\\n    for entry in std::fs::read_dir(&root).unwrap() {\\n        let path = entry.unwrap().path();\\n        let text = std::fs::read_to_string(&path).unwrap_or_default().to_lowercase();\\n        for word in banned {\\n            assert!(!text.contains(word), \\\"{word} in {}\\\", path.display());\\n        }\\n620→    }\\n    let engine = Path::new(env!(\\\"CARGO_MANIFEST_DIR\\\")).join(\\\"../..\\\");\\n    let mut audio = Vec::new();\\n    walk_audio(&engine, &mut audio);\\n    assert!(audio.is_empty(), \\\"shipped audio files: {audio:?}\\\");\\n}\\n\\nfn walk_audio(dir: &Path, out: &mut Vec<String>) {\\n    let Ok(rd) = std::fs::read_dir(dir) else { return };\\n    for entry in rd.flatten() {\\n630→        let path = entry.path();\\n        if path.file_name().and_then(|s| s.to_str()) == Some(\\\"target\\\") {\\n            continue;\\n        }\\n        if path.is_dir() {\\n            walk_audio(&path, out);\\n        } else if let Some(ext) = path.extension().and_then(|s| s.to_str()) {\\n            if matches!(ext, \\\"wav\\\" | \\\"mp3\\\" | \\\"ogg\\\") {\\n                out.push(path.display().to_string());\\n            }\\n640→        }\\n    }\\n}\\n\\n#[test]\\nfn net_loopback_shares_one_fire_cell() {\\n    let mut host = World::fresh(1);\\n    let mut client = World::fresh(2);\\n    assert!(host.fire.ignite_at(200.0, -200.0, 10.0, host.minutes));\\n    let mut link = Link::new(7, 0.15, 0.0, 0.0);\\n650→    host_publish(&host, &mut link, false);\\n    assert!(link.max_bytes < 1200);\\n    for _ in 0..10 {\\n        link.advance(0.1);\\n    }\\n    let bodies = link.poll();\\n    assert!(bodies.iter().any(|b| b.contains(\\\"\\\\\\\"t\\\\\\\":\\\\\\\"fire\\\\\\\"\\\")));\\n    client_apply(&mut client, &bodies);\\n    let shared = host.fire.cells.keys().any(|c| client.fire.cells.get(c).is_some_and(|cell| cell.burning));\\n    assert!(shared, \\\"host and client should share a burning cell within 1s\\\");\\n660→    host_publish(&host, &mut link, true);\\n    assert_eq!(link.finishes, 1);\\n    host_publish(&host, &mut link, true);\\n    assert_eq!(link.finishes, 1);\\n\\n    let mut lossy = Link::new(1, 0.0, 0.0, 1.0);\\n    lossy.send(false, \\\"{\\\\\\\"t\\\\\\\":\\\\\\\"ping\\\\\\\"}\\\".into());\\n    lossy.advance(0.1);\\n    assert!(lossy.poll().is_empty());\\n    lossy.send(true, \\\"{\\\\\\\"t\\\\\\\":\\\\\\\"ping\\\\\\\"}\\\".into());\\n670→    lossy.advance(0.1);\\n    assert_eq!(lossy.poll().len(), 1);\\n}\\n\\nconst COVERAGE: &[&str] = &[\\n    \\\"map_raised\\\", \\\"waypoint_set\\\", \\\"gps_followed\\\", \\\"monocular_tag\\\", \\\"wind_rag\\\", \\\"jam_cleared\\\", \\\"enemy_jam\\\", \\\"weapon_broke\\\",\\n    \\\"weapon_bought\\\", \\\"locker_used\\\", \\\"syrette\\\", \\\"wound_gunshot\\\", \\\"wound_shrapnel\\\", \\\"wound_burn\\\", \\\"wound_fall\\\", \\\"wound_tourniquet\\\",\\n    \\\"wound_graze\\\", \\\"fever_warned\\\", \\\"pill_taken\\\", \\\"blackout\\\", \\\"player_rescued\\\", \\\"companion_patched\\\", \\\"companion_overdosed\\\",\\n    \\\"companion_died\\\", \\\"better_way\\\", \\\"ignite_flare\\\", \\\"ignite_rocket\\\", \\\"ignite_flamer\\\", \\\"ignite_mortar\\\", \\\"ignite_molotov\\\",\\n    \\\"ignite_frag\\\", \\\"ignite_barrel\\\", \\\"ignite_vehicle\\\", \\\"ignite_person\\\", \\\"ignite_lightning\\\", \\\"ignite_tracer\\\", \\\"ignite_cigarette\\\",\\n680→    \\\"cells_500\\\", \\\"enemy_panicked\\\", \\\"animals_fled\\\", \\\"explosion_chain\\\", \\\"rain_extinguished\\\", \\\"stealth_kill\\\", \\\"dart_kill\\\",\\n    \\\"night_contract\\\", \\\"sleep_used\\\", \\\"safe_house_claimed\\\", \\\"post_cleared\\\", \\\"post_remanned\\\", \\\"technical_driven\\\", \\\"mounted_gun\\\",\\n    \\\"repair_done\\\", \\\"boat_driven\\\", \\\"bus_taken\\\", \\\"tape_played\\\", \\\"cache_tracker\\\", \\\"diamonds_spent\\\", \\\"contract_a0\\\", \\\"contract_a1\\\",\\n    \\\"contract_b1\\\", \\\"contract_b2\\\", \\\"contract_b3\\\", \\\"contract_b4\\\", \\\"contract_c1\\\", \\\"contract_c2\\\", \\\"contract_c3\\\", \\\"contract_d1\\\",\\n    \\\"contract_d2\\\", \\\"ceasefire_ended\\\", \\\"town_burned\\\", \\\"ending_burn\\\", \\\"ending_read\\\", \\\"ending_chair\\\",\\n];\\n\\nfn play_route(route: Route, seed: u64) -> BTreeSet<String> {\\n    let mut w = World::campaign(seed, route);\\n    let mut goal = String::new();\\n690→    let mut stuck = 0.0f32;\\n    let cap = 60.0 * 900.0;\\n    let mut t = 0.0f32;\\n    while t < cap && !w.finished {\\n        let input = w.bot_input();\\n        let before = w.goal_name();\\n        w.tick(&input, DT);\\n        t += DT;\\n        let now = w.goal_name();\\n        if now != before {\\n700→            eprintln!(\\\"{route:?} seed {seed}: {before} -> {now} at ({:.0},{:.0}) t={t:.0}\\\", w.x, w.z);\\n            goal = now;\\n            stuck = 0.0;\\n        } else {\\n            stuck += DT;\\n            let budget = w.goal_budget();\\n            if stuck > budget && !w.finished {\\n                panic!(\\n                    \\\"{route:?} seed {seed} stuck on {now} for {stuck:.0}s (budget {budget:.0}) at ({:.1},{:.1}) step {} flags {}\\\",\\n                    w.x, w.z, w.step, w.flags.len()\\n710→                );\\n            }\\n        }\\n    }\\n    assert!(w.finished, \\\"{route:?} seed {seed} did not finish by {t:.0}s goal {} at ({:.0},{:.0})\\\", w.goal_name(), w.x, w.z);\\n    let end = match route {\\n        Route::Read => \\\"ending_read\\\",\\n        Route::Chair => \\\"ending_chair\\\",\\n        _ => \\\"ending_burn\\\",\\n    };\\n720→    assert!(w.flags.contains(end), \\\"{route:?} missing {end}\\\");\\n    w.flags\\n}\\n\\n#[test]\\nfn bot_plays_all_three_endings() {\\n    let mut union = BTreeSet::new();\\n    for seed in [1u64, 2] {\\n        let mut prefix_a = World::campaign(seed, Route::Human);\\n        let mut prefix_b = World::campaign(seed, Route::Human);\\n730→        for _ in 0..40 {\\n            let a = prefix_a.bot_input();\\n            let b = prefix_b.bot_input();\\n            prefix_a.tick(&a, DT);\\n            prefix_b.tick(&b, DT);\\n        }\\n        assert_eq!(prefix_a.fingerprint(), prefix_b.fingerprint());\\n        for route in [Route::Human, Route::Read, Route::Chair] {\\n            union.extend(play_route(route, seed));\\n        }\\n740→    }\\n    let missing: Vec<_> = COVERAGE.iter().copied().filter(|f| !union.contains(*f)).collect();\\n    assert!(missing.is_empty(), \\\"coverage missing {missing:?}\\\");\\n}\\n\",\"content_concise\":\"480→    let mut throttle = InputFrame::default();\\n    throttle.axes.y = 1.0;\\n    run(&mut dry, &throttle, 1.0);\\n    assert!(dry.ride.speed.abs() < 0.2, \\\"boat on grass {}\\\", dry.ride.speed);\\n\\n    let (wx, wz) = geom::nearest_water(0.0, 0.0);\\n    let mut wet = World::fresh(4);\\n    wet.ride.kind = 2;\\n    wet.ride.seat = 1;\\n    wet.ride.x = wx;\\n490→    wet.ride.z = wz;\\n    wet.x = wx;\\n    wet.z = wz;\\n    let (tx, tz) = geom::water_ahead(wx, wz, 40.0);\\n    wet.ride.yaw = geom::yaw_toward(wx, wz, tx, tz);\\n    run(&mut wet, &throttle, 2.0);\\n    assert!(wet.flags.contains(\\\"boat_driven\\\"), \\\"dist {} deep {}\\\", wet.ride.dist, geom::deep_water(wet.ride.x, wet.ride.z));\\n\\n    wet.ride.npc = true;\\n    let z0 = wet.ride.z;\\n500→    run(&mut wet, &InputFrame::default(), 1.0);\\n    assert!((wet.ride.x - wx).abs() > 0.5 || (wet.ride.z - z0).abs() > 0.5);\\n\\n    let seat = wet.ride.seat;\\n    wet.tick(&press(buttons::USE), DT);\\n    assert_ne!(wet.ride.seat, seat);\\n    wet.ride.seat = 2;\\n    wet.tick(&hold(buttons::PRIMARY), DT);\\n    assert!(wet.flags.contains(\\\"mounted_gun\\\"));\\n}\\n510→\\n#[test]\\nfn shop_tracker_and_shell() {\\n    let mut w = World::fresh(1);\\n    w.diamonds = 0;\\n    let guns = w.guns.len();\\n    assert!(!w.try_buy());\\n    assert_eq!(w.guns.len(), guns);\\n    assert_eq!(w.diamonds, 0);\\n\\n520→    w.tracker_cache = (w.x + 10.0, w.z);\\n    let near = w.tracker_rate();\\n    w.tracker_cache = (w.x + 50.0, w.z);\\n    let far = w.tracker_rate();\\n    assert!(near > far && far > 0.0, \\\"{near} vs {far}\\\");\\n\\n    let mut w = World::campaign(2, Route::Human);\\n    assert!(w.rows().len() <= 7);\\n    let screens = [\\n        Screen::Title, Screen::Difficulty, Screen::Merc, Screen::Prologue, Screen::Pause, Screen::Settings, Screen::About,\\n530→        Screen::Dev, Screen::Mp, Screen::Attract,\\n    ];\\n    for screen in screens {\\n        w.screen = screen;\\n        for tab in 0..6 {\\n            w.tab = tab;\\n            for page in 0..6 {\\n                w.page = page;\\n                assert!(w.rows().len() <= 7, \\\"{screen:?} tab {tab} page {page} {:?}\\\", w.rows());\\n            }\\n540→        }\\n    }\\n    w.screen = Screen::Difficulty;\\n    w.focus = 0;\\n    w.apply_menu(MenuInput { up: true, ..MenuInput::default() });\\n    assert_eq!(w.focus, 2);\\n    w.apply_menu(MenuInput { back: true, ..MenuInput::default() });\\n    assert_eq!(w.screen, Screen::Title);\\n\\n    w.focus = 0;\\n550→    w.apply_menu(MenuInput { pointer: Some((400.0, 300.0)), ..MenuInput::default() });\\n    assert_eq!(w.focus, 1);\\n    w.apply_menu(MenuInput { pointer: Some((400.0, 230.0)), click: true, ..MenuInput::default() });\\n    assert_eq!(w.screen, Screen::Difficulty);\\n\\n    assert_eq!(glyph(\\\"confirm\\\", Device::Gamepad, false), \\\"Cross\\\");\\n    assert_eq!(glyph(\\\"confirm\\\", Device::Gamepad, true), \\\"A\\\");\\n    assert_eq!(glyph(\\\"fire\\\", Device::Keyboard, false), \\\"LMB\\\");\\n    assert_eq!(glyph(\\\"reload\\\", Device::Gamepad, false), \\\"Square\\\");\\n\\n560→    w.screen = Screen::Dev;\\n    w.tab = 5;\\n    w.page = 1;\\n    w.focus = 2;\\n    let before = w.tune.fire_spread;\\n    w.apply_menu(MenuInput { right: true, ..MenuInput::default() });\\n    assert!(w.tune.fire_spread > before, \\\"{} -> {}\\\", before, w.tune.fire_spread);\\n    w.page = 3;\\n    w.focus = 3;\\n    w.apply_menu(MenuInput { confirm: true, ..MenuInput::default() });\\n570→    assert!((w.tune.fire_spread - w.tune0.fire_spread).abs() < 1e-4);\\n\\n    let mut w = World::campaign(3, Route::Human);\\n    run(&mut w, &InputFrame::default(), 9.0);\\n    assert_ne!(w.screen, Screen::Attract);\\n    run(&mut w, &InputFrame::default(), 1.2);\\n    assert_eq!(w.screen, Screen::Attract);\\n    let saves = w.saves_written;\\n    let mut acc = 0.0f32;\\n    while acc < 800.0 {\\n580→        w.tick(&InputFrame::default(), 0.5);\\n        acc += 0.5;\\n    }\\n    assert!(w.attract_loops >= 5, \\\"loops {}\\\", w.attract_loops);\\n    assert_eq!(w.attract_seen, (1u16 << 10) - 1, \\\"seen {:b}\\\", w.attract_seen);\\n    assert_eq!(w.saves_written, saves);\\n\\n    let mut w = World::campaign(4, Route::Human);\\n    let mut seen = vec![format!(\\\"{:?}\\\", w.screen)];\\n    for bit in [buttons::CONFIRM, buttons::JUMP, buttons::CONFIRM, buttons::JUMP] {\\n590→        w.tick(&press(bit), DT);\\n        seen.push(format!(\\\"{:?}\\\", w.screen));\\n    }\\n    assert_eq!(w.screen, Screen::Playing, \\\"{seen:?}\\\");\\n    assert!(seen.windows(2).all(|p| p[0] != p[1]), \\\"{seen:?}\\\");\\n}\\n\\n#[test]\\nfn fiction_has_no_source_names_and_no_audio_files() {\\n    let banned = [\\n600→        \\\"jackal\\\", \\\"ufll\\\", \\\"apr\\\", \\\"pala\\\", \\\"mosate\\\", \\\"bowa\\\", \\\"leboa\\\", \\\"oluwagembi\\\", \\\"mike's bar\\\", \\\"marty\\\", \\\"alencar\\\",\\n        \\\"warren clyde\\\", \\\"paul ferenc\\\", \\\"hyppolite\\\", \\\"xianyong\\\", \\\"josip\\\", \\\"hakim\\\", \\\"bilders\\\", \\\"quarbani\\\", \\\"voorhees\\\",\\n        \\\"todo\\\", \\\"tbd\\\", \\\"placeholder\\\", \\\"lorem\\\",\\n    ];\\n    for line in fiction_lines() {\\n        let low = line.to_lowercase();\\n        if low.contains(\\\"far cry 2\\\") {\\n            assert!(line.contains(\\\"Source:\\\"), \\\"{line}\\\");\\n        }\\n        for word in banned {\\n610→            assert!(!low.contains(word), \\\"{word} in {line}\\\");\\n        }\\n    }\\n    let root = Path::new(env!(\\\"CARGO_MANIFEST_DIR\\\")).join(\\\"src/games/merc\\\");\\n    for entry in std::fs::read_dir(&root).unwrap() {\\n        let path = entry.unwrap().path();\\n        let text = std::fs::read_to_string(&path).unwrap_or_default().to_lowercase();\\n        for word in banned {\\n            assert!(!text.contains(word), \\\"{word} in {}\\\", path.display());\\n        }\\n620→    }\\n    let engine = Path::new(env!(\\\"CARGO_MANIFEST_DIR\\\")).join(\\\"../..\\\");\\n    let mut audio = Vec::new();\\n    walk_audio(&engine, &mut audio);\\n    assert!(audio.is_empty(), \\\"shipped audio files: {audio:?}\\\");\\n}\\n\\nfn walk_audio(dir: &Path, out: &mut Vec<String>) {\\n    let Ok(rd) = std::fs::read_dir(dir) else { return };\\n    for entry in rd.flatten() {\\n630→        let path = entry.path();\\n        if path.file_name().and_then(|s| s.to_str()) == Some(\\\"target\\\") {\\n            continue;\\n        }\\n        if path.is_dir() {\\n            walk_audio(&path, out);\\n        } else if let Some(ext) = path.extension().and_then(|s| s.to_str()) {\\n            if matches!(ext, \\\"wav\\\" | \\\"mp3\\\" | \\\"ogg\\\") {\\n                out.push(path.display().to_string());\\n            }\\n640→        }\\n    }\\n}\\n\\n#[test]\\nfn net_loopback_shares_one_fire_cell() {\\n    let mut host = World::fresh(1);\\n    let mut client = World::fresh(2);\\n    assert!(host.fire.ignite_at(200.0, -200.0, 10.0, host.minutes));\\n    let mut link = Link::new(7, 0.15, 0.0, 0.0);\\n650→    host_publish(&host, &mut link, false);\\n    assert!(link.max_bytes < 1200);\\n    for _ in 0..10 {\\n        link.advance(0.1);\\n    }\\n    let bodies = link.poll();\\n    assert!(bodies.iter().any(|b| b.contains(\\\"\\\\\\\"t\\\\\\\":\\\\\\\"fire\\\\\\\"\\\")));\\n    client_apply(&mut client, &bodies);\\n    let shared = host.fire.cells.keys().any(|c| client.fire.cells.get(c).is_some_and(|cell| cell.burning));\\n    assert!(shared, \\\"host and client should share a burning cell within 1s\\\");\\n660→    host_publish(&host, &mut link, true);\\n    assert_eq!(link.finishes, 1);\\n    host_publish(&host, &mut link, true);\\n    assert_eq!(link.finishes, 1);\\n\\n    let mut lossy = Link::new(1, 0.0, 0.0, 1.0);\\n    lossy.send(false, \\\"{\\\\\\\"t\\\\\\\":\\\\\\\"ping\\\\\\\"}\\\".into());\\n    lossy.advance(0.1);\\n    assert!(lossy.poll().is_empty());\\n    lossy.send(true, \\\"{\\\\\\\"t\\\\\\\":\\\\\\\"ping\\\\\\\"}\\\".into());\\n670→    lossy.advance(0.1);\\n    assert_eq!(lossy.poll().len(), 1);\\n}\\n\\nconst COVERAGE: &[&str] = &[\\n    \\\"map_raised\\\", \\\"waypoint_set\\\", \\\"gps_followed\\\", \\\"monocular_tag\\\", \\\"wind_rag\\\", \\\"jam_cleared\\\", \\\"enemy_jam\\\", \\\"weapon_broke\\\",\\n    \\\"weapon_bought\\\", \\\"locker_used\\\", \\\"syrette\\\", \\\"wound_gunshot\\\", \\\"wound_shrapnel\\\", \\\"wound_burn\\\", \\\"wound_fall\\\", \\\"wound_tourniquet\\\",\\n    \\\"wound_graze\\\", \\\"fever_warned\\\", \\\"pill_taken\\\", \\\"blackout\\\", \\\"player_rescued\\\", \\\"companion_patched\\\", \\\"companion_overdosed\\\",\\n    \\\"companion_died\\\", \\\"better_way\\\", \\\"ignite_flare\\\", \\\"ignite_rocket\\\", \\\"ignite_flamer\\\", \\\"ignite_mortar\\\", \\\"ignite_molotov\\\",\\n    \\\"ignite_frag\\\", \\\"ignite_barrel\\\", \\\"ignite_vehicle\\\", \\\"ignite_person\\\", \\\"ignite_lightning\\\", \\\"ignite_tracer\\\", \\\"ignite_cigarette\\\",\\n680→    \\\"cells_500\\\", \\\"enemy_panicked\\\", \\\"animals_fled\\\", \\\"explosion_chain\\\", \\\"rain_extinguished\\\", \\\"stealth_kill\\\", \\\"dart_kill\\\",\\n    \\\"night_contract\\\", \\\"sleep_used\\\", \\\"safe_house_claimed\\\", \\\"post_cleared\\\", \\\"post_remanned\\\", \\\"technical_driven\\\", \\\"mounted_gun\\\",\\n    \\\"repair_done\\\", \\\"boat_driven\\\", \\\"bus_taken\\\", \\\"tape_played\\\", \\\"cache_tracker\\\", \\\"diamonds_spent\\\", \\\"contract_a0\\\", \\\"contract_a1\\\",\\n    \\\"contract_b1\\\", \\\"contract_b2\\\", \\\"contract_b3\\\", \\\"contract_b4\\\", \\\"contract_c1\\\", \\\"contract_c2\\\", \\\"contract_c3\\\", \\\"contract_d1\\\",\\n    \\\"contract_d2\\\", \\\"ceasefire_ended\\\", \\\"town_burned\\\", \\\"ending_burn\\\", \\\"ending_read\\\", \\\"ending_chair\\\",\\n];\\n\\nfn play_route(route: Route, seed: u64) -> BTreeSet<String> {\\n    let mut w = World::campaign(seed, route);\\n    let mut goal = String::new();\\n690→    let mut stuck = 0.0f32;\\n    let cap = 60.0 * 900.0;\\n    let mut t = 0.0f32;\\n    while t < cap && !w.finished {\\n        let input = w.bot_input();\\n        let before = w.goal_name();\\n        w.tick(&input, DT);\\n        t += DT;\\n        let now = w.goal_name();\\n        if now != before {\\n700→            eprintln!(\\\"{route:?} seed {seed}: {before} -> {now} at ({:.0},{:.0}) t={t:.0}\\\", w.x, w.z);\\n            goal = now;\\n            stuck = 0.0;\\n        } else {\\n            stuck += DT;\\n            let budget = w.goal_budget();\\n            if stuck > budget && !w.finished {\\n                panic!(\\n                    \\\"{route:?} seed {seed} stuck on {now} for {stuck:.0}s (budget {budget:.0}) at ({:.1},{:.1}) step {} flags {}\\\",\\n                    w.x, w.z, w.step, w.flags.len()\\n710→                );\\n            }\\n        }\\n    }\\n    assert!(w.finished, \\\"{route:?} seed {seed} did not finish by {t:.0}s goal {} at ({:.0},{:.0})\\\", w.goal_name(), w.x, w.z);\\n    let end = match route {\\n        Route::Read => \\\"ending_read\\\",\\n        Route::Chair => \\\"ending_chair\\\",\\n        _ => \\\"ending_burn\\\",\\n    };\\n720→    assert!(w.flags.contains(end), \\\"{route:?} missing {end}\\\");\\n    w.flags\\n}\\n\\n#[test]\\nfn bot_plays_all_three_endings() {\\n    let mut union = BTreeSet::new();\\n    for seed in [1u64, 2] {\\n        let mut prefix_a = World::campaign(seed, Route::Human);\