::Better) => \\\"better\\\",\"},{\"line_number\":722,\"content\":\"            Some(Spec::Patch) => \\\"patch\\\",\"},{\"line_number\":723,\"content\":\"            Some(Spec::Overdose) => \\\"overdose\\\",\"},{\"line_number\":724,\"content\":\"            Some(Spec::Die) => \\\"die\\\",\"},{\"line_number\":725,\"content\":\"            Some(Spec::Tape) => \\\"tape\\\",\"},{\"line_number\":726,\"content\":\"            Some(Spec::Ceasefire) => \\\"ceasefire\\\",\"},{\"line_number\":727,\"content\":\"            Some(Spec::Convoy) => \\\"convoy\\\",\"},{\"line_number\":728,\"content\":\"            Some(Spec::Town) => \\\"town\\\",\"},{\"line_number\":729,\"content\":\"            Some(Spec::Ending(n)) => return format!(\\\"ending{n}\\\"),\"},{\"line_number\":730,\"content\":\"            Some(Spec::Flag(s)) => s,\"},{\"line_number\":736,\"content\":\"    pub fn goal_budget(&self) -> f32 {\"},{\"line_number\":738,\"content\":\"            Some(Spec::Reach { .. }) => 160.0,\"},{\"line_number\":739,\"content\":\"            Some(Spec::Drive { .. }) => 140.0,\"},{\"line_number\":740,\"content\":\"            Some(Spec::Boat) => 240.0,\"},{\"line_number\":741,\"content\":\"            Some(Spec::Town) => 220.0,\"},{\"line_number\":742,\"content\":\"            Some(Spec::Bus { .. }) => 90.0,\"},{\"line_number\":743,\"content\":\"            Some(Spec::Blackout) => 80.0,\"},{\"line_number\":744,\"content\":\"            Some(Spec::Break) => 90.0,\"},{\"line_number\":745,\"content\":\"            Some(Spec::Die) => 55.0,\"},{\"line_number\":746,\"content\":\"            Some(Spec::Ending(_)) => {\"},{\"line_number\":747,\"content\":\"                if self.finale == Some(1) || (self.finale.is_none() && matches!(self.current(), Some(Spec::Ending(1)))) {\"},{\"line_number\":753,\"content\":\"            Some(Spec::Sleep { .. }) | Some(Spec::Tracker) => 50.0,\"},{\"line_number\":754,\"content\":\"            Some(Spec::Fight) | Some(Spec::EnemyJam) => 25.0,\"},{\"line_number