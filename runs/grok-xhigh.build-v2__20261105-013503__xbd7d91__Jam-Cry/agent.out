        hp,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n590→        self.bodies.len() - 1\\n    }\\n\\n    pub fn add_wall(&mut self, min: [f32; 3], max: [f32; 3]) {\\n        self.walls.push(Wall { min, max });\\n    }\\n\\n    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n600→        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n610→            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n620→    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n630→            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n640→    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n650→        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n660→            f.pressed = buttons::CONFIRM;\\n            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n670→        script(self.route).get(self.step as usize).copied()\\n    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) => \\\"map\\\",\\n680→            Some(Spec::Way) => \\\"waypoint\\\",\\n            Some(Spec::Reach { .. }) => \\\"reach\\\",\\n            Some(Spec::Fever) => \\\"fever\\\",\\n            Some(Spec::Pill) => \\\"pill\\\",\\n            Some(Spec::Blackout) => \\\"blackout\\\",\\n            Some(Spec::Fight) => \\\"fight\\\",\\n            Some(Spec::EnemyJam) => \\\"enemy_jam\\\",\\n            Some(Spec::Jam) => \\\"jam\\\",\\n            Some(Spec::Break) => \\\"break\\\",\\n            Some(Spec::Rescue) => \\\"rescue\\\",\\n690→            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\\n            Some(Spec::Loot) => \\\"loot\\\",\\n            Some(Spec::Claim) => \\\"claim\\\",\\n            Some(Spec::Shop) => \\\"shop\\\",\\n            Some(Spec::Locker) => \\\"locker\\\",\\n            Some(Spec::Syrette) => \\\"syrette\\\",\\n            Some(Spec::Tracker) => \\\"tracker\\\",\\n            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\\n            Some(Spec::Drive { .. }) => \\\"drive\\\",\\n            Some(Spec::Mono) => \\\"mono\\\",\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":250,\"limit\":450,\"raw_output\":\"    Tanks,\\n    Mounted,\\n    Panic,\\n    Animals,\\n    Bus { x: f32, z: f32 },\\n    Night,\\n    Boat,\\n    Stealth,\\n    Dart,\\n    Repair,\\n    Rain,\\n    Better,\\n    Patch,\\n    Overdose,\\n    Die,\\n    Tape,\\n    Ceasefire,\\n    Convoy,\\n    Town,\\n    Ending(u8),\\n    Flag(&'static str),\\n}\\n\\nfn script(route: Route) -> &'static [Spec] {\\n    static S: OnceLock<Vec<Vec<Spec>>> = OnceLock::new();\\n    let all = S.get_or_init(|| vec![build_script(Route::Human), build_script(Route::Burn), build_script(Route::Read), build_script(Route::Chair)]);\\n    let i = match route {\\n        Route::Human => 0,\\n        Route::Burn => 1,\\n        Route::Read => 2,\\n        Route::Chair => 3,\\n        Route::Sandbox => return &[],\\n    };\\n    all[i].as_slice()\\n}\\n\\nfn build_script(route: Route) -> Vec<Spec> {\\n    let mut v = vec![\\n        Spec::Boot,\\n        Spec::Map,\\n        Spec::Way,\\n        Spec::Reach { x: 0.0, z: 460.0, gps: true },\\n        Spec::Fever,\\n    ];\\n    if route == Route::Read {\\n        v.push(Spec::Blackout);\\n    } else {\\n        v.push(Spec::Pill);\\n    }\\n    v.push(Spec::Flag(\\\"contract_a0\\\"));\\n    v.push(Spec::Reach { x: -40.0, z: 640.0, gps: false });\\n    v.push(Spec::Fight);\\n    v.push(Spec::EnemyJam);\\n    v.push(Spec::Jam);\\n    v.push(Spec::Break);\\n    v.push(Spec::Rescue);\\n    for w in 1..=6 {\\n        v.push(Spec::Wound(w));\\n    }\\n    v.push(Spec::Loot);\\n    v.push(Spec::Reach { x: 170.0, z: 470.0, gps: false });\\n    v.push(Spec::Claim);\\n    v.push(Spec::Shop);\\n    v.push(Spec::Locker);\\n    v.push(Spec::Syrette);\\n    v.push(Spec::Tracker);\\n    v.push(Spec::Sleep { hours: 8.0 });\\n    v.push(Spec::Flag(\\\"contract_a1\\\"));\\n    v.push(Spec::Drive { x: -520.0, z: -520.0 });\\n    v.push(Spec::Mono);\\n    for ig in 0..12 {\\n        v.push(Spec::Ignite(ig));\\n    }\\n    v.push(Spec::Tanks);\\n    v.push(Spec::Mounted);\\n    v.push(Spec::Panic);\\n    v.push(Spec::Animals);\\n    v.push(Spec::Flag(\\\"contract_b1\\\"));\\n    v.push(Spec::Bus { x: 0.0, z: 380.0 });\\n    v.push(Spec::Drive { x: -260.0, z: -700.0 });\\n    v.push(Spec::Sleep { hours: 26.0 });\\n    v.push(Spec::Night);\\n    v.push(Spec::Boat);\\n    v.push(Spec::Stealth);\\n    v.push(Spec::Dart);\\n    v.push(Spec::Flag(\\\"contract_b2\\\"));\\n    v.push(Spec::Repair);\\n    v.push(Spec::Rain);\\n    v.push(Spec::Flag(\\\"contract_b3\\\"));\\n    v.push(Spec::Better);\\n    match route {\\n        Route::Read => v.push(Spec::Overdose),\\n        Route::Chair => v.push(Spec::Die),\\n        _ => v.push(Spec::Patch),\\n    }\\n    v.push(Spec::Flag(\\\"contract_b4\\\"));\\n    v.push(Spec::Tape);\\n    v.push(Spec::Ceasefire);\\n    v.push(Spec::Flag(\\\"contract_c1\\\"));\\n    v.push(Spec::Convoy);\\n    v.push(Spec::Flag(\\\"contract_c2\\\"));\\n    v.push(Spec::Town);\\n    v.push(Spec::Flag(\\\"contract_c3\\\"));\\n    v.push(Spec::Drive { x: -760.0, z: 620.0 });\\n    v.push(Spec::Flag(\\\"contract_d1\\\"));\\n    let end = match route {\\n        Route::Read => 1,\\n        Route::Chair => 2,\\n        _ => 0,\\n    };\\n    v.push(Spec::Ending(end));\\n    v.push(Spec::Flag(\\\"contract_d2\\\"));\\n    v\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct World {\\n    pub seed: u64,\\n    pub rng: Rng,\\n    pub route: Route,\\n    pub screen: Screen,\\n    pub focus: usize,\\n    pub tab: usize,\\n    pub page: usize,\\n    pub difficulty: u8,\\n    pub merc: u8,\\n    pub x: f32,\\n    pub z: f32,\\n    pub yaw: f32,\\n    pub pitch: f32,\\n    pub roll: f32,\\n    pub eye: f32,\\n    pub stance: u8,\\n    pub stamina: f32,\\n    pub hp: f32,\\n    pub syrettes: u32,\\n    pub pills: u32,\\n    pub diamonds: u32,\\n    pub infamy: i32,\\n    pub guns: Vec<Gun>,\\n    pub slot: usize,\\n    pub syrette_t: f32,\\n    pub heal_t: f32,\\n    pub wound: u8,\\n    pub pill_t: f32,\\n    pub fever_t: f32,\\n    pub fever_state: u8,\\n    pub fever_warn: f32,\\n    pub fever_attack: f32,\\n    pub bodies: Vec<Body>,\\n    pub walls: Vec<Wall>,\\n    pub fire: FireMap,\\n    pub wind: Vec2,\\n    pub weather: u8,\\n    pub minutes: f32,\\n    pub ceasefire: bool,\\n    pub companions: Vec<Companion>,\\n    pub rescue_t: f32,\\n    pub ride: Ride,\\n    pub flags: BTreeSet<String>,\\n    pub step: u16,\\n    pub step_ready: bool,\\n    pub step_t: f32,\\n    pub step_x: f32,\\n    pub step_z: f32,\\n    pub waypoint: Option<(f32, f32)>,\\n    pub map_t: f32,\\n    pub mono_t: f32,\\n    pub post_clear: bool,\\n    pub post_reman_at: f32,\\n    pub looking_at_post: bool,\\n    pub saves_written: u32,\\n    pub save_blob: String,\\n    pub has_save: bool,\\n    pub idle: f32,\\n    pub attract_t: f32,\\n    pub attract_seen: u16,\\n    pub attract_loops: u32,\\n    pub device: Device,\\n    pub device_lock: u8,\\n    pub xbox: bool,\\n    pub tune: Tune,\\n    pub tune0: Tune,\\n    pub dev: Dev,\\n    pub hub: bool,\\n    pub touch_only: bool,\\n    pub music: f32,\\n    pub finished: bool,\\n    pub hold_t: f32,\\n    pub tracker_cache: (f32, f32),\\n    pub treating: bool,\\n    pub jam_seen: bool,\\n    pub boat_dist: f32,\\n    /// Menu pointer in canvas pixels. The page sets it; the shell consumes it.\\n    #[serde(default)]\\n    pub pointer: Option<(f32, f32)>,\\n    #[serde(default)]\\n    pub pointer_click: bool,\\n}\\n\\nimpl World {\\n    pub fn fresh(seed: u64) -> Self {\\n        let mut w = Self::blank(seed, Route::Sandbox);\\n        w.screen = Screen::Playing;\\n        w.x = 200.0;\\n        w.z = -200.0;\\n        w.guns = vec![Gun::new(WeaponId::Pistol), Gun::new(WeaponId::Ar)];\\n        w.diamonds = 40;\\n        w.syrettes = 3;\\n        w.pills = 3;\\n        w.slot = 0;\\n        w\\n    }\\n\\n    pub fn campaign(seed: u64, route: Route) -> Self {\\n        let mut w = Self::blank(seed, route);\\n        w.screen = Screen::Title;\\n        w.guns = vec![Gun::new(WeaponId::Pistol)];\\n        w.diamonds = 40;\\n        w.syrettes = 3;\\n        w.pills = 3;\\n        w\\n    }\\n\\n    fn blank(seed: u64, route: Route) -> Self {\\n        let tune = Tune::default();\\n        Self {\\n            seed,\\n            rng: Rng::new(seed),\\n            route,\\n            screen: Screen::Title,\\n            focus: 0,\\n            tab: 0,\\n            page: 0,\\n            difficulty: 1,\\n            merc: 0,\\n            x: 0.0,\\n            z: 0.0,\\n            yaw: 0.0,\\n            pitch: 0.05,\\n            roll: 0.0,\\n            eye: 1.58,\\n            stance: 0,\\n            stamina: 12.0,\\n            hp: 100.0,\\n            syrettes: 3,\\n            pills: 3,\\n            diamonds: 40,\\n            infamy: 0,\\n            guns: vec![Gun::new(WeaponId::Pistol)],\\n            slot: 0,\\n            syrette_t: 0.0,\\n            heal_t: 0.0,\\n            wound: 0,\\n            pill_t: 0.0,\\n            fever_t: 0.0,\\n            fever_state: 0,\\n            fever_warn: 0.0,\\n            fever_attack: 0.0,\\n            bodies: Vec::new(),\\n            walls: Vec::new(),\\n            fire: FireMap::default(),\\n            wind: Vec2::new(2.0, 0.5),\\n            weather: 0,\\n            minutes: 12.0 * 60.0,\\n            ceasefire: true,\\n            companions: vec![\\n                Companion { name: \\\"Tomek Wrona\\\".into(), alive: true, down: false, down_t: 0.0, rescue_spent: false, x: 0.0, z: 0.0 },\\n                Companion { name: \\\"Rafael Quintero\\\".into(), alive: true, down: false, down_t: 0.0, rescue_spent: false, x: 0.0, z: 0.0 },\\n                Companion { name: \\\"Mirela Dragan\\\".into(), alive: true, down: false, down_t: 0.0, rescue_spent: false, x: 0.0, z: 0.0 },\\n            ],\\n            rescue_t: 0.0,\\n            ride: Ride::default(),\\n            flags: BTreeSet::new(),\\n            step: 0,\\n            step_ready: false,\\n            step_t: 0.0,\\n            step_x: 0.0,\\n            step_z: 0.0,\\n            waypoint: None,\\n            map_t: 0.0,\\n            mono_t: 0.0,\\n            post_clear: false,\\n            post_reman_at: 1.0e9,\\n            looking_at_post: false,\\n            saves_written: 0,\\n            save_blob: String::new(),\\n            has_save: false,\\n            idle: 0.0,\\n            attract_t: 0.0,\\n            attract_seen: 0,\\n            attract_loops: 0,\\n            device: Device::Gamepad,\\n            device_lock: 0,\\n            xbox: false,\\n            tune0: tune.clone(),\\n            tune,\\n            dev: Dev::default(),\\n            hub: false,\\n            touch_only: false,\\n            music: 0.10,\\n            finished: false,\\n            hold_t: 0.0,\\n            tracker_cache: (90.0, 500.0),\\n            treating: false,\\n            jam_seen: false,\\n            boat_dist: 0.0,\\n            pointer: None,\\n            pointer_click: false,\\n        }\\n    }\\n\\n    pub fn mark(&mut self, flag: &str) {\\n        self.flags.insert(flag.to_string());\\n    }\\n\\n    pub fn gun(&self) -> &Gun {\\n        &self.guns[self.slot.min(self.guns.len().saturating_sub(1))]\\n    }\\n    pub fn gun_mut(&mut self) -> &mut Gun {\\n        let i = self.slot.min(self.guns.len().saturating_sub(1));\\n        &mut self.guns[i]\\n    }\\n\\n    pub fn spawn_dummy(&mut self, x: f32, z: f32, hp: f32) -> usize {\\n        self.bodies.push(Body {\\n            kind: 4,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n        self.bodies.len() - 1\\n    }\\n\\n    pub fn add_wall(&mut self, min: [f32; 3], max: [f32; 3]) {\\n        self.walls.push(Wall { min, max });\\n    }\\n\\n    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n        script(self.route).get(self.step as usize).copied()\\n    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) => \\\"map\\\",\\n            Some(Spec::Way) => \\\"waypoint\\\",\\n            Some(Spec::Reach { .. }) => \\\"reach\\\",\\n            Some(Spec::Fever) => \\\"fever\\\",\\n            Some(Spec::Pill) => \\\"pill\\\",\\n            Some(Spec::Blackout) => \\\"blackout\\\",\\n            Some(Spec::Fight) => \\\"fight\\\",\\n            Some(Spec::EnemyJam) => \\\"enemy_jam\\\",\\n            Some(Spec::Jam) => \\\"jam\\\",\\n            Some(Spec::Break) => \\\"break\\\",\\n            Some(Spec::Rescue) => \\\"rescue\\\",\\n            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\\n            Some(Spec::Loot) => \\\"loot\\\",\\n            Some(Spec::Claim) => \\\"claim\\\",\\n            Some(Spec::Shop) => \\\"shop\\\",\\n            Some(Spec::Locker) => \\\"locker\\\",\\n            Some(Spec::Syrette) => \\\"syrette\\\",\\n            Some(Spec::Tracker) => \\\"tracker\\\",\\n            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\\n            Some(Spec::Drive { .. }) => \\\"drive\\\",\\n            Some(Spec::Mono) => \\\"mono\\\",\\n\",\"total_lines\":2449}}","is_error":false},{"type":"tool_result","tool_use_id":"call-eb0504e6-3401-47e6-a27b-31a30cc084e8-33","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Sparse 2 m fire grid. Spread is a wind-biased front: each tick the downwind tip and the\\n//! upwind tip each get one roll of `spread * fuel * dryness * exp(k * dot * speed) * dt`.\\n\\nuse std::collections::BTreeMap;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::geom::{self, cell_center, cell_of};\\n10→use crate::rng::Rng;\\n\\npub const FIRE_K: f32 = 0.10;\\npub const FIRE_DT: f32 = 0.25;\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Cell {\\n    pub burning: bool,\\n    pub life: f32,\\n    pub burnt_until: f32,\\n20→}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct FireMap {\\n    pub cells: BTreeMap<(i32, i32), Cell>,\\n    pub acc: f32,\\n    pub burned: u32,\\n    pub wind_for_test: Vec2,\\n}\\n\\n30→impl Default for FireMap {\\n    fn default() -> Self {\\n        Self { cells: BTreeMap::new(), acc: 0.0, burned: 0, wind_for_test: Vec2::ZERO }\\n    }\\n}\\n\\nimpl FireMap {\\n    pub fn burning_count(&self) -> usize {\\n        self.cells.values().filter(|c| c.burning).count()\\n    }\\n40→\\n    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        self.ignite_cell(cell_of(x, z), life, minutes)\\n    }\\n\\n    pub fn ignite_cell(&mut self, c: (i32, i32), life: f32, minutes: f32) -> bool {\\n        let (x, z) = cell_center(c);\\n50→        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        if let Some(cell) = self.cells.get(&c) {\\n            if cell.burning {\\n                return false;\\n            }\\n            if minutes < cell.burnt_until {\\n                return false;\\n            }\\n60→        }\\n        self.cells.insert(c, Cell { burning: true, life, burnt_until: 0.0 });\\n        self.burned += 1;\\n        true\\n    }\\n\\n    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\\n        let r = radius.ceil() as i32 + 1;\\n        let (cx, cz) = cell_of(x, z);\\n        let mut n = 0;\\n70→        for iz in (cz - r)..=(cz + r) {\\n            for ix in (cx - r)..=(cx + r) {\\n                let (px, pz) = cell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n80→\\n    /// Step the grid. Returns cells extinguished by rain.\\n    pub fn tick(&mut self, dt: f32, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rain: bool, rng: &mut Rng) -> u32 {\\n        self.wind_for_test = wind;\\n        self.acc += dt;\\n        let mut extinguished = 0;\\n        if rain {\\n            let keys: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n            for k in keys {\\n                self.cells.remove(&k);\\n90→                extinguished += 1;\\n            }\\n            self.acc = 0.0;\\n            return extinguished;\\n        }\\n        while self.acc >= FIRE_DT {\\n            self.acc -= FIRE_DT;\\n            self.spread_once(wind, spread, burn_time, minutes, rng);\\n        }\\n        let done: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning && c.life <= 0.0).map(|(k, _)| *k).collect();\\n100→        for k in done {\\n            if let Some(c) = self.cells.get_mut(&k) {\\n                c.burning = false;\\n                // Two in-game days. One real second is one in-game minute, so 48 hours = 2880 minutes.\\n                c.burnt_until = minutes + 48.0 * 60.0;\\n                c.life = 0.0;\\n            }\\n        }\\n        self.cells.retain(|_, c| c.burning || minutes < c.burnt_until);\\n        extinguished\\n110→    }\\n\\n    fn spread_once(&mut self, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(0.0, -1.0) };\\n        let burning: Vec<(i32, i32)> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n        if burning.is_empty() {\\n            return;\\n        }\\n        // Age the flames.\\n120→        for k in &burning {\\n            if let Some(c) = self.cells.get_mut(k) {\\n                c.life -= FIRE_DT;\\n            }\\n        }\\n        if speed < 0.5 {\\n            // Calm: grow the four extremes together so the scar stays roughly round.\\n            let positives = [\\n                *burning.iter().max_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n130→                *burning.iter().max_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n            ];\\n            let offs = [(1, 0), (-1, 0), (0, 1), (0, -1)];\\n            let p = (spread * 0.35 * FIRE_DT).clamp(0.0, 0.5);\\n            for (tip, off) in positives.iter().zip(offs) {\\n                if rng.f32() < p {\\n                    let _ = self.ignite_cell((tip.0 + off.0, tip.1 + off.1), burn_time, minutes);\\n                }\\n            }\\n140→            return;\\n        }\\n        let proj = |c: (i32, i32)| {\\n            let (x, z) = cell_center(c);\\n            x * dir.x + z * dir.y\\n        };\\n        let down = *burning.iter().max_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        let up = *burning.iter().min_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        self.try_tip(down, dir, true, speed, spread, burn_time, minutes, rng);\\n        self.try_tip(up, dir, false, speed, spread, burn_time, minutes, rng);\\n150→        // Embers jump only above 8 m/s, far enough to cross a road.\\n        if speed > 8.0 && rng.f32() < 0.12 {\\n            let (x, z) = cell_center(down);\\n            let hop = 6.0 + rng.f32() * 9.0;\\n            let _ = self.ignite_at(x + dir.x * hop, z + dir.y * hop, burn_time, minutes);\\n        }\\n    }\\n\\n    fn try_tip(&mut self, tip: (i32, i32), dir: Vec2, downwind: bool, speed: f32, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let step = if downwind { (dir.x.signum() as i32, dir.y.signum() as i32) } else { (-dir.x.signum() as i32, -dir.y.signum() as i32) };\\n160→        let step = if step == (0, 0) { (0, -1) } else { step };\\n        // Prefer the axis the wind actually points along.\\n        let step = if dir.x.abs() >= dir.y.abs() { (step.0.signum(), 0) } else { (0, step.1.signum()) };\\n        let step = if step == (0, 0) { if downwind { (1, 0) } else { (-1, 0) } } else { step };\\n        let dot = if downwind { 1.0 } else { -1.0 };\\n        let wf = (FIRE_K * dot * speed).exp();\\n        let (x, z) = cell_center(tip);\\n        let fuel = geom::fuel(x, z).max(0.5);\\n        let p = (spread * fuel * wf * FIRE_DT).clamp(0.0, 0.95);\\n        if rng.f32() < p {\\n170→            let _ = self.ignite_cell((tip.0 + step.0, tip.1 + step.1), burn_time, minutes);\\n        }\\n    }\\n\\n    /// Reach along the wind axis, in metres, of every cell that has burned.\\n    pub fn reach(&self, origin: (f32, f32), wind: Vec2) -> (f32, f32) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(1.0, 0.0) };\\n        let mut down = 0.0f32;\\n        let mut up = 0.0f32;\\n180→        for c in self.cells.keys() {\\n            let (x, z) = cell_center(*c);\\n            let along = (x - origin.0) * dir.x + (z - origin.1) * dir.y;\\n            if along > down {\\n                down = along;\\n            }\\n            if -along > up {\\n                up = -along;\\n            }\\n        }\\n190→        (down, up)\\n    }\\n}\\n\",\"content_concise\":\"1→//! Sparse 2 m fire grid. Spread is a wind-biased front: each tick the downwind tip and the\\n//! upwind tip each get one roll of `spread * fuel * dryness * exp(k * dot * speed) * dt`.\\n\\nuse std::collections::BTreeMap;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::geom::{self, cell_center, cell_of};\\n10→use crate::rng::Rng;\\n\\npub const FIRE_K: f32 = 0.10;\\npub const FIRE_DT: f32 = 0.25;\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Cell {\\n    pub burning: bool,\\n    pub life: f32,\\n    pub burnt_until: f32,\\n20→}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct FireMap {\\n    pub cells: BTreeMap<(i32, i32), Cell>,\\n    pub acc: f32,\\n    pub burned: u32,\\n    pub wind_for_test: Vec2,\\n}\\n\\n30→impl Default for FireMap {\\n    fn default() -> Self {\\n        Self { cells: BTreeMap::new(), acc: 0.0, burned: 0, wind_for_test: Vec2::ZERO }\\n    }\\n}\\n\\nimpl FireMap {\\n    pub fn burning_count(&self) -> usize {\\n        self.cells.values().filter(|c| c.burning).count()\\n    }\\n40→\\n    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        self.ignite_cell(cell_of(x, z), life, minutes)\\n    }\\n\\n    pub fn ignite_cell(&mut self, c: (i32, i32), life: f32, minutes: f32) -> bool {\\n        let (x, z) = cell_center(c);\\n50→        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        if let Some(cell) = self.cells.get(&c) {\\n            if cell.burning {\\n                return false;\\n            }\\n            if minutes < cell.burnt_until {\\n                return false;\\n            }\\n60→        }\\n        self.cells.insert(c, Cell { burning: true, life, burnt_until: 0.0 });\\n        self.burned += 1;\\n        true\\n    }\\n\\n    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\\n        let r = radius.ceil() as i32 + 1;\\n        let (cx, cz) = cell_of(x, z);\\n        let mut n = 0;\\n70→        for iz in (cz - r)..=(cz + r) {\\n            for ix in (cx - r)..=(cx + r) {\\n                let (px, pz) = cell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n80→\\n    /// Step the grid. Returns cells extinguished by rain.\\n    pub fn tick(&mut self, dt: f32, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rain: bool, rng: &mut Rng) -> u32 {\\n        self.wind_for_test = wind;\\n        self.acc += dt;\\n        let mut extinguished = 0;\\n        if rain {\\n            let keys: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n            for k in keys {\\n                self.cells.remove(&k);\\n90→                extinguished += 1;\\n            }\\n            self.acc = 0.0;\\n            return extinguished;\\n        }\\n        while self.acc >= FIRE_DT {\\n            self.acc -= FIRE_DT;\\n            self.spread_once(wind, spread, burn_time, minutes, rng);\\n        }\\n        let done: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning && c.life <= 0.0).map(|(k, _)| *k).collect();\\n100→        for k in done {\\n            if let Some(c) = self.cells.get_mut(&k) {\\n                c.burning = false;\\n                // Two in-game days. One real second is one in-game minute, so 48 hours = 2880 minutes.\\n                c.burnt_until = minutes + 48.0 * 60.0;\\n                c.life = 0.0;\\n            }\\n        }\\n        self.cells.retain(|_, c| c.burning || minutes < c.burnt_until);\\n        extinguished\\n110→    }\\n\\n    fn spread_once(&mut self, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(0.0, -1.0) };\\n        let burning: Vec<(i32, i32)> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n        if burning.is_empty() {\\n            return;\\n        }\\n        // Age the flames.\\n120→        for k in &burning {\\n            if let Some(c) = self.cells.get_mut(k) {\\n                c.life -= FIRE_DT;\\n            }\\n        }\\n        if speed < 0.5 {\\n            // Calm: grow the four extremes together so the scar stays roughly round.\\n            let positives = [\\n                *burning.iter().max_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n130→                *burning.iter().max_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n            ];\\n            let offs = [(1, 0), (-1, 0), (0, 1), (0, -1)];\\n            let p = (spread * 0.35 * FIRE_DT).clamp(0.0, 0.5);\\n            for (tip, off) in positives.iter().zip(offs) {\\n                if rng.f32() < p {\\n                    let _ = self.ignite_cell((tip.0 + off.0, tip.1 + off.1), burn_time, minutes);\\n                }\\n            }\\n140→            return;\\n        }\\n        let proj = |c: (i32, i32)| {\\n            let (x, z) = cell_center(c);\\n            x * dir.x + z * dir.y\\n        };\\n        let down = *burning.iter().max_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        let up = *burning.iter().min_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        self.try_tip(down, dir, true, speed, spread, burn_time, minutes, rng);\\n        self.try_tip(up, dir, false, speed, spread, burn_time, minutes, rng);\\n150→        // Embers jump only above 8 m/s, far enough to cross a road.\\n        if speed > 8.0 && rng.f32() < 0.12 {\\n            let (x, z) = cell_center(down);\\n            let hop = 6.0 + rng.f32() * 9.0;\\n            let _ = self.ignite_at(x + dir.x * hop, z + dir.y * hop, burn_time, minutes);\\n        }\\n    }\\n\\n    fn try_tip(&mut self, tip: (i32, i32), dir: Vec2, downwind: bool, speed: f32, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let step = if downwind { (dir.x.signum() as i32, dir.y.signum() as i32) } else { (-dir.x.signum() as i32, -dir.y.signum() as i32) };\\n160→        let step = if step == (0, 0) { (0, -1) } else { step };\\n        // Prefer the axis the wind actually points along.\\n        let step = if dir.x.abs() >= dir.y.abs() { (step.0.signum(), 0) } else { (0, step.1.signum()) };\\n        let step = if step == (0, 0) { if downwind { (1, 0) } else { (-1, 0) } } else { step };\\n        let dot = if downwind { 1.0 } else { -1.0 };\\n        let wf = (FIRE_K * dot * speed).exp();\\n        let (x, z) = cell_center(tip);\\n        let fuel = geom::fuel(x, z).max(0.5);\\n        let p = (spread * fuel * wf * FIRE_DT).clamp(0.0, 0.95);\\n        if rng.f32() < p {\\n170→            let _ = self.ignite_cell((tip.0 + step.0, tip.1 + step.1), burn_time, minutes);\\n        }\\n    }\\n\\n    /// Reach along the wind axis, in metres, of every cell that has burned.\\n    pub fn reach(&self, origin: (f32, f32), wind: Vec2) -> (f32, f32) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(1.0, 0.0) };\\n        let mut down = 0.0f32;\\n        let mut up = 0.0f32;\\n180→        for c in self.cells.keys() {\\n            let (x, z) = cell_center(*c);\\n            let along = (x - origin.0) * dir.x + (z - origin.1) * dir.y;\\n            if along > down {\\n                down = along;\\n            }\\n            if -along > up {\\n                up = -along;\\n            }\\n        }\\n190→        (down, up)\\n    }\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/fire.rs\",\"offset\":null,\"raw_output\":\"//! Sparse 2 m fire grid. Spread is a wind-biased front: each tick the downwind tip and the\\n//! upwind tip each get one roll of `spread * fuel * dryness * exp(k * dot * speed) * dt`.\\n\\nuse std::collections::BTreeMap;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::geom::{self, cell_center, cell_of};\\nuse crate::rng::Rng;\\n\\npub const FIRE_K: f32 = 0.10;\\npub const FIRE_DT: f32 = 0.25;\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Cell {\\n    pub burning: bool,\\n    pub life: f32,\\n    pub burnt_until: f32,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct FireMap {\\n    pub cells: BTreeMap<(i32, i32), Cell>,\\n    pub acc: f32,\\n    pub burned: u32,\\n    pub wind_for_test: Vec2,\\n}\\n\\nimpl Default for FireMap {\\n    fn default() -> Self {\\n        Self { cells: BTreeMap::new(), acc: 0.0, burned: 0, wind_for_test: Vec2::ZERO }\\n    }\\n}\\n\\nimpl FireMap {\\n    pub fn burning_count(&self) -> usize {\\n        self.cells.values().filter(|c| c.burning).count()\\n    }\\n\\n    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        self.ignite_cell(cell_of(x, z), life, minutes)\\n    }\\n\\n    pub fn ignite_cell(&mut self, c: (i32, i32), life: f32, minutes: f32) -> bool {\\n        let (x, z) = cell_center(c);\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        if let Some(cell) = self.cells.get(&c) {\\n            if cell.burning {\\n                return false;\\n            }\\n            if minutes < cell.burnt_until {\\n                return false;\\n            }\\n        }\\n        self.cells.insert(c, Cell { burning: true, life, burnt_until: 0.0 });\\n        self.burned += 1;\\n        true\\n    }\\n\\n    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\\n        let r = radius.ceil() as i32 + 1;\\n        let (cx, cz) = cell_of(x, z);\\n        let mut n = 0;\\n        for iz in (cz - r)..=(cz + r) {\\n            for ix in (cx - r)..=(cx + r) {\\n                let (px, pz) = cell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n\\n    /// Step the grid. Returns cells extinguished by rain.\\n    pub fn tick(&mut self, dt: f32, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rain: bool, rng: &mut Rng) -> u32 {\\n        self.wind_for_test = wind;\\n        self.acc += dt;\\n        let mut extinguished = 0;\\n        if rain {\\n            let keys: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n            for k in keys {\\n                self.cells.remove(&k);\\n                extinguished += 1;\\n            }\\n            self.acc = 0.0;\\n            return extinguished;\\n        }\\n        while self.acc >= FIRE_DT {\\n            self.acc -= FIRE_DT;\\n            self.spread_once(wind, spread, burn_time, minutes, rng);\\n        }\\n        let done: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning && c.life <= 0.0).map(|(k, _)| *k).collect();\\n        for k in done {\\n            if let Some(c) = self.cells.get_mut(&k) {\\n                c.burning = false;\\n                // Two in-game days. One real second is one in-game minute, so 48 hours = 2880 minutes.\\n                c.burnt_until = minutes + 48.0 * 60.0;\\n                c.life = 0.0;\\n            }\\n        }\\n        self.cells.retain(|_, c| c.burning || minutes < c.burnt_until);\\n        extinguished\\n    }\\n\\n    fn spread_once(&mut self, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(0.0, -1.0) };\\n        let burning: Vec<(i32, i32)> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n        if burning.is_empty() {\\n            return;\\n        }\\n        // Age the flames.\\n        for k in &burning {\\n            if let Some(c) = self.cells.get_mut(k) {\\n                c.life -= FIRE_DT;\\n            }\\n        }\\n        if speed < 0.5 {\\n            // Calm: grow the four extremes together so the scar stays roughly round.\\n            let positives = [\\n                *burning.iter().max_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n                *burning.iter().max_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n            ];\\n            let offs = [(1, 0), (-1, 0), (0, 1), (0, -1)];\\n            let p = (spread * 0.35 * FIRE_DT).clamp(0.0, 0.5);\\n            for (tip, off) in positives.iter().zip(offs) {\\n                if rng.f32() < p {\\n                    let _ = self.ignite_cell((tip.0 + off.0, tip.1 + off.1), burn_time, minutes);\\n                }\\n            }\\n            return;\\n        }\\n        let proj = |c: (i32, i32)| {\\n            let (x, z) = cell_center(c);\\n            x * dir.x + z * dir.y\\n        };\\n        let down = *burning.iter().max_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        let up = *burning.iter().min_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        self.try_tip(down, dir, true, speed, spread, burn_time, minutes, rng);\\n        self.try_tip(up, dir, false, speed, spread, burn_time, minutes, rng);\\n        // Embers jump only above 8 m/s, far enough to cross a road.\\n        if speed > 8.0 && rng.f32() < 0.12 {\\n            let (x, z) = cell_center(down);\\n            let hop = 6.0 + rng.f32() * 9.0;\\n            let _ = self.ignite_at(x + dir.x * hop, z + dir.y * hop, burn_time, minutes);\\n        }\\n    }\\n\\n    fn try_tip(&mut self, tip: (i32, i32), dir: Vec2, downwind: bool, speed: f32, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let step = if downwind { (dir.x.signum() as i32, dir.y.signum() as i32) } else { (-dir.x.signum() as i32, -dir.y.signum() as i32) };\\n        let step = if step == (0, 0) { (0, -1) } else { step };\\n        // Prefer the axis the wind actually points along.\\n        let step = if dir.x.abs() >= dir.y.abs() { (step.0.signum(), 0) } else { (0, step.1.signum()) };\\n        let step = if step == (0, 0) { if downwind { (1, 0) } else { (-1, 0) } } else { step };\\n        let dot = if downwind { 1.0 } else { -1.0 };\\n        let wf = (FIRE_K * dot * speed).exp();\\n        let (x, z) = cell_center(tip);\\n        let fuel = geom::fuel(x, z).max(0.5);\\n        let p = (spread * fuel * wf * FIRE_DT).clamp(0.0, 0.95);\\n        if rng.f32() < p {\\n            let _ = self.ignite_cell((tip.0 + step.0, tip.1 + step.1), burn_time, minutes);\\n        }\\n    }\\n\\n    /// Reach along the wind axis, in metres, of every cell that has burned.\\n    pub fn reach(&self, origin: (f32, f32), wind: Vec2) -> (f32, f32) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(1.0, 0.0) };\\n        let mut down = 0.0f32;\\n        let mut up = 0.0f32;\\n        for c in self.cells.keys() {\\n            let (x, z) = cell_center(*c);\\n            let along = (x - origin.0) * dir.x + (z - origin.1) * dir.y;\\n            if along > down {\\n                down = along;\\n            }\\n            if -along > up {\\n                up = -along;\\n            }\\n        }\\n        (down, up)\\n    }\\n}\\n\",\"total_lines\":192}}","is_error":false},{"type":"tool_result","tool_use_id":"call-eb0504e6-3401-47e6-a27b-31a30cc084e8-34","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Weapons, condition, jams and breaks. `Gun::pull` is the only shot roll.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum WeaponId {\\n    Pistol,\\n10→    Revolver,\\n    Flare,\\n    Sawnoff,\\n    Ar,\\n    Battle,\\n    Smg,\\n    Shotgun,\\n    Sniper,\\n    Dart,\\n    Lmg,\\n20→    Rpg,\\n    Flamer,\\n    Mortar,\\n    Frag,\\n    Molotov,\\n    Machete,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct Stats {\\n30→    pub name: &'static str,\\n    pub family: &'static str,\\n    pub mag: u32,\\n    pub reserve: u32,\\n    pub rpm: f32,\\n    pub damage: f32,\\n    pub range: f32,\\n    pub wear: f32,\\n    pub noise: f32,\\n    pub pellets: u32,\\n40→    pub ignites: bool,\\n    pub silent: bool,\\n}\\n\\npub fn stats(id: WeaponId) -> Stats {\\n    use WeaponId::*;\\n    match id {\\n        Pistol => Stats { name: \\\"Service Nine\\\", family: \\\"pistol\\\", mag: 12, reserve: 60, rpm: 300.0, damage: 22.0, range: 40.0, wear: 0.10, noise: 120.0, pellets: 1, ignites: false, silent: false },\\n        Revolver => Stats { name: \\\"Old Six\\\", family: \\\"pistol\\\", mag: 6, reserve: 30, rpm: 120.0, damage: 48.0, range: 50.0, wear: 0.05, noise: 140.0, pellets: 1, ignites: false, silent: false },\\n        Flare => Stats { name: \\\"Flare pistol\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 40.0, damage: 10.0, range: 60.0, wear: 0.5, noise: 60.0, pellets: 1, ignites: true, silent: false },\\n50→        Sawnoff => Stats { name: \\\"Sawn-off\\\", family: \\\"shotgun\\\", mag: 2, reserve: 24, rpm: 120.0, damage: 12.0, range: 12.0, wear: 0.3, noise: 150.0, pellets: 8, ignites: false, silent: false },\\n        Ar => Stats { name: \\\"Forty-Seven\\\", family: \\\"rifle\\\", mag: 30, reserve: 180, rpm: 600.0, damage: 26.0, range: 120.0, wear: 0.14, noise: 160.0, pellets: 1, ignites: false, silent: false },\\n        Battle => Stats { name: \\\"Battle rifle\\\", family: \\\"rifle\\\", mag: 20, reserve: 100, rpm: 450.0, damage: 38.0, range: 180.0, wear: 0.12, noise: 180.0, pellets: 1, ignites: false, silent: false },\\n        Smg => Stats { name: \\\"Folding SMG\\\", family: \\\"pistol\\\", mag: 30, reserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n60→        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n70→}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n80→#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Pull {\\n    Waiting,\\n    Dry,\\n    Jammed,\\n    Fired,\\n    Broke,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\n90→pub struct Gun {\\n    pub id: WeaponId,\\n    pub condition: f32,\\n    pub wear: f32,\\n    pub jammed: bool,\\n    pub broken: bool,\\n    pub ammo: u32,\\n    pub reserve: u32,\\n    pub cooldown: f32,\\n    pub clear_left: f32,\\n100→    pub slapped: bool,\\n    pub shots: u32,\\n    pub jams: u32,\\n    pub force_jam: bool,\\n}\\n\\nimpl Gun {\\n    pub fn new(id: WeaponId) -> Self {\\n        let s = stats(id);\\n        Self {\\n110→            id,\\n            condition: 100.0,\\n            wear: s.wear,\\n            jammed: false,\\n            broken: false,\\n            ammo: s.mag,\\n            reserve: s.reserve,\\n            cooldown: 0.0,\\n            clear_left: 0.0,\\n            slapped: false,\\n120→            shots: 0,\\n            jams: 0,\\n            force_jam: false,\\n        }\\n    }\\n\\n    pub fn family(&self) -> &'static str {\\n        stats(self.id).family\\n    }\\n\\n130→    /// One trigger pull. Jam is rolled before the bullet. A break is rolled on a real shot when\\n    /// condition is under the threshold (default 8) at 3 percent.\\n    pub fn pull(&mut self, rng: &mut Rng, jam_mul: f32, wear_mul: f32, break_at: f32) -> Pull {\\n        if self.cooldown > 0.0 {\\n            return Pull::Waiting;\\n        }\\n        if self.jammed {\\n            return Pull::Jammed;\\n        }\\n        if self.broken || self.ammo == 0 {\\n140→            return Pull::Dry;\\n        }\\n        let p = jam_probability(self.condition) * jam_mul.max(0.0);\\n        if self.force_jam || (p > 0.0 && rng.f32() < p) {\\n            self.jammed = true;\\n            self.force_jam = false;\\n            self.jams += 1;\\n            self.cooldown = 0.15;\\n            return Pull::Jammed;\\n        }\\n150→        self.ammo -= 1;\\n        self.shots += 1;\\n        let rpm = stats(self.id).rpm.max(1.0);\\n        self.cooldown = 60.0 / rpm;\\n        self.condition = (self.condition - self.wear * wear_mul.max(0.0)).max(0.0);\\n        if self.condition < break_at && rng.f32() < 0.03 {\\n            self.broken = true;\\n            return Pull::Broke;\\n        }\\n        Pull::Fired\\n160→    }\\n\\n    /// Start clearing a jam, or slap the bolt. A second tap shortens the remaining time by 40%.\\n    pub fn tap_reload(&mut self) {\\n        if self.jammed && self.clear_left <= 0.0 {\\n            self.clear_left = clear_seconds(self.condition);\\n            self.slapped = false;\\n        } else if self.jammed && self.clear_left > 0.0 && !self.slapped {\\n            self.clear_left *= 0.6;\\n            self.slapped = true;\\n170→        } else if !self.jammed && !self.broken {\\n            let s = stats(self.id);\\n            let need = s.mag.saturating_sub(self.ammo);\\n            let take = need.min(self.reserve);\\n            self.ammo += take;\\n            self.reserve -= take;\\n        }\\n    }\\n\\n    pub fn tick_clear(&mut self, dt: f32) {\\n180→        if self.clear_left > 0.0 {\\n            self.clear_left = (self.clear_left - dt).max(0.0);\\n            if self.clear_left == 0.0 {\\n                self.jammed = false;\\n                self.slapped = false;\\n            }\\n        }\\n        if self.cooldown > 0.0 {\\n            self.cooldown = (self.cooldown - dt).max(0.0);\\n        }\\n190→    }\\n}\\n\",\"content_concise\":\"1→//! Weapons, condition, jams and breaks. `Gun::pull` is the only shot roll.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum WeaponId {\\n    Pistol,\\n10→    Revolver,\\n    Flare,\\n    Sawnoff,\\n    Ar,\\n    Battle,\\n    Smg,\\n    Shotgun,\\n    Sniper,\\n    Dart,\\n    Lmg,\\n20→    Rpg,\\n    Flamer,\\n    Mortar,\\n    Frag,\\n    Molotov,\\n    Machete,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct Stats {\\n30→    pub name: &'static str,\\n    pub family: &'static str,\\n    pub mag: u32,\\n    pub reserve: u32,\\n    pub rpm: f32,\\n    pub damage: f32,\\n    pub range: f32,\\n    pub wear: f32,\\n    pub noise: f32,\\n    pub pellets: u32,\\n40→    pub ignites: bool,\\n    pub silent: bool,\\n}\\n\\npub fn stats(id: WeaponId) -> Stats {\\n    use WeaponId::*;\\n    match id {\\n        Pistol => Stats { name: \\\"Service Nine\\\", family: \\\"pistol\\\", mag: 12, reserve: 60, rpm: 300.0, damage: 22.0, range: 40.0, wear: 0.10, noise: 120.0, pellets: 1, ignites: false, silent: false },\\n        Revolver => Stats { name: \\\"Old Six\\\", family: \\\"pistol\\\", mag: 6, reserve: 30, rpm: 120.0, damage: 48.0, range: 50.0, wear: 0.05, noise: 140.0, pellets: 1, ignites: false, silent: false },\\n        Flare => Stats { name: \\\"Flare pistol\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 40.0, damage: 10.0, range: 60.0, wear: 0.5, noise: 60.0, pellets: 1, ignites: true, silent: false },\\n50→        Sawnoff => Stats { name: \\\"Sawn-off\\\", family: \\\"shotgun\\\", mag: 2, reserve: 24, rpm: 120.0, damage: 12.0, range: 12.0, wear: 0.3, noise: 150.0, pellets: 8, ignites: false, silent: false },\\n        Ar => Stats { name: \\\"Forty-Seven\\\", family: \\\"rifle\\\", mag: 30, reserve: 180, rpm: 600.0, damage: 26.0, range: 120.0, wear: 0.14, noise: 160.0, pellets: 1, ignites: false, silent: false },\\n        Battle => Stats { name: \\\"Battle rifle\\\", family: \\\"rifle\\\", mag: 20, reserve: 100, rpm: 450.0, damage: 38.0, range: 180.0, wear: 0.12, noise: 180.0, pellets: 1, ignites: false, silent: false },\\n        Smg => Stats { name: \\\"Folding SMG\\\", family: \\\"pistol\\\", mag: 30, reserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n60→        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n70→}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n80→#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Pull {\\n    Waiting,\\n    Dry,\\n    Jammed,\\n    Fired,\\n    Broke,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\n90→pub struct Gun {\\n    pub id: WeaponId,\\n    pub condition: f32,\\n    pub wear: f32,\\n    pub jammed: bool,\\n    pub broken: bool,\\n    pub ammo: u32,\\n    pub reserve: u32,\\n    pub cooldown: f32,\\n    pub clear_left: f32,\\n100→    pub slapped: bool,\\n    pub shots: u32,\\n    pub jams: u32,\\n    pub force_jam: bool,\\n}\\n\\nimpl Gun {\\n    pub fn new(id: WeaponId) -> Self {\\n        let s = stats(id);\\n        Self {\\n110→            id,\\n            condition: 100.0,\\n            wear: s.wear,\\n            jammed: false,\\n            broken: false,\\n            ammo: s.mag,\\n            reserve: s.reserve,\\n            cooldown: 0.0,\\n            clear_left: 0.0,\\n            slapped: false,\\n120→            shots: 0,\\n            jams: 0,\\n            force_jam: false,\\n        }\\n    }\\n\\n    pub fn family(&self) -> &'static str {\\n        stats(self.id).family\\n    }\\n\\n130→    /// One trigger pull. Jam is rolled before the bullet. A break is rolled on a real shot when\\n    /// condition is under the threshold (default 8) at 3 percent.\\n    pub fn pull(&mut self, rng: &mut Rng, jam_mul: f32, wear_mul: f32, break_at: f32) -> Pull {\\n        if self.cooldown > 0.0 {\\n            return Pull::Waiting;\\n        }\\n        if self.jammed {\\n            return Pull::Jammed;\\n        }\\n        if self.broken || self.ammo == 0 {\\n140→            return Pull::Dry;\\n        }\\n        let p = jam_probability(self.condition) * jam_mul.max(0.0);\\n        if self.force_jam || (p > 0.0 && rng.f32() < p) {\\n            self.jammed = true;\\n            self.force_jam = false;\\n            self.jams += 1;\\n            self.cooldown = 0.15;\\n            return Pull::Jammed;\\n        }\\n150→        self.ammo -= 1;\\n        self.shots += 1;\\n        let rpm = stats(self.id).rpm.max(1.0);\\n        self.cooldown = 60.0 / rpm;\\n        self.condition = (self.condition - self.wear * wear_mul.max(0.0)).max(0.0);\\n        if self.condition < break_at && rng.f32() < 0.03 {\\n            self.broken = true;\\n            return Pull::Broke;\\n        }\\n        Pull::Fired\\n160→    }\\n\\n    /// Start clearing a jam, or slap the bolt. A second tap shortens the remaining time by 40%.\\n    pub fn tap_reload(&mut self) {\\n        if self.jammed && self.clear_left <= 0.0 {\\n            self.clear_left = clear_seconds(self.condition);\\n            self.slapped = false;\\n        } else if self.jammed && self.clear_left > 0.0 && !self.slapped {\\n            self.clear_left *= 0.6;\\n            self.slapped = true;\\n170→        } else if !self.jammed && !self.broken {\\n            let s = stats(self.id);\\n            let need = s.mag.saturating_sub(self.ammo);\\n            let take = need.min(self.reserve);\\n            self.ammo += take;\\n            self.reserve -= take;\\n        }\\n    }\\n\\n    pub fn tick_clear(&mut self, dt: f32) {\\n180→        if self.clear_left > 0.0 {\\n            self.clear_left = (self.clear_left - dt).max(0.0);\\n            if self.clear_left == 0.0 {\\n                self.jammed = false;\\n                self.slapped = false;\\n            }\\n        }\\n        if self.cooldown > 0.0 {\\n            self.cooldown = (self.cooldown - dt).max(0.0);\\n        }\\n190→    }\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/gun.rs\",\"offset\":null,\"raw_output\":\"//! Weapons, condition, jams and breaks. `Gun::pull` is the only shot roll.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum WeaponId {\\n    Pistol,\\n    Revolver,\\n    Flare,\\n    Sawnoff,\\n    Ar,\\n    Battle,\\n    Smg,\\n    Shotgun,\\n    Sniper,\\n    Dart,\\n    Lmg,\\n    Rpg,\\n    Flamer,\\n    Mortar,\\n    Frag,\\n    Molotov,\\n    Machete,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct Stats {\\n    pub name: &'static str,\\n    pub family: &'static str,\\n    pub mag: u32,\\n    pub reserve: u32,\\n    pub rpm: f32,\\n    pub damage: f32,\\n    pub range: f32,\\n    pub wear: f32,\\n    pub noise: f32,\\n    pub pellets: u32,\\n    pub ignites: bool,\\n    pub silent: bool,\\n}\\n\\npub fn stats(id: WeaponId) -> Stats {\\n    use WeaponId::*;\\n    match id {\\n        Pistol => Stats { name: \\\"Service Nine\\\", family: \\\"pistol\\\", mag: 12, reserve: 60, rpm: 300.0, damage: 22.0, range: 40.0, wear: 0.10, noise: 120.0, pellets: 1, ignites: false, silent: false },\\n        Revolver => Stats { name: \\\"Old Six\\\", family: \\\"pistol\\\", mag: 6, reserve: 30, rpm: 120.0, damage: 48.0, range: 50.0, wear: 0.05, noise: 140.0, pellets: 1, ignites: false, silent: false },\\n        Flare => Stats { name: \\\"Flare pistol\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 40.0, damage: 10.0, range: 60.0, wear: 0.5, noise: 60.0, pellets: 1, ignites: true, silent: false },\\n        Sawnoff => Stats { name: \\\"Sawn-off\\\", family: \\\"shotgun\\\", mag: 2, reserve: 24, rpm: 120.0, damage: 12.0, range: 12.0, wear: 0.3, noise: 150.0, pellets: 8, ignites: false, silent: false },\\n        Ar => Stats { name: \\\"Forty-Seven\\\", family: \\\"rifle\\\", mag: 30, reserve: 180, rpm: 600.0, damage: 26.0, range: 120.0, wear: 0.14, noise: 160.0, pellets: 1, ignites: false, silent: false },\\n        Battle => Stats { name: \\\"Battle rifle\\\", family: \\\"rifle\\\", mag: 20, reserve: 100, rpm: 450.0, damage: 38.0, range: 180.0, wear: 0.12, noise: 180.0, pellets: 1, ignites: false, silent: false },\\n        Smg => Stats { name: \\\"Folding SMG\\\", family: \\\"pistol\\\", mag: 30, reserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Pull {\\n    Waiting,\\n    Dry,\\n    Jammed,\\n    Fired,\\n    Broke,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Gun {\\n    pub id: WeaponId,\\n    pub condition: f32,\\n    pub wear: f32,\\n    pub jammed: bool,\\n    pub broken: bool,\\n    pub ammo: u32,\\n    pub reserve: u32,\\n    pub cooldown: f32,\\n    pub clear_left: f32,\\n    pub slapped: bool,\\n    pub shots: u32,\\n    pub jams: u32,\\n    pub force_jam: bool,\\n}\\n\\nimpl Gun {\\n    pub fn new(id: WeaponId) -> Self {\\n        let s = stats(id);\\n        Self {\\n            id,\\n            condition: 100.0,\\n            wear: s.wear,\\n            jammed: false,\\n            broken: false,\\n            ammo: s.mag,\\n            reserve: s.reserve,\\n            cooldown: 0.0,\\n            clear_left: 0.0,\\n            slapped: false,\\n            shots: 0,\\n            jams: 0,\\n            force_jam: false,\\n        }\\n    }\\n\\n    pub fn family(&self) -> &'static str {\\n        stats(self.id).family\\n    }\\n\\n    /// One trigger pull. Jam is rolled before the bullet. A break is rolled on a real shot when\\n    /// condition is under the threshold (default 8) at 3 percent.\\n    pub fn pull(&mut self, rng: &mut Rng, jam_mul: f32, wear_mul: f32, break_at: f32) -> Pull {\\n        if self.cooldown > 0.0 {\\n            return Pull::Waiting;\\n        }\\n        if self.jammed {\\n            return Pull::Jammed;\\n        }\\n        if self.broken || self.ammo == 0 {\\n            return Pull::Dry;\\n        }\\n        let p = jam_probability(self.condition) * jam_mul.max(0.0);\\n        if self.force_jam || (p > 0.0 && rng.f32() < p) {\\n            self.jammed = true;\\n            self.force_jam = false;\\n            self.jams += 1;\\n            self.cooldown = 0.15;\\n            return Pull::Jammed;\\n        }\\n        self.ammo -= 1;\\n        self.shots += 1;\\n        let rpm = stats(self.id).rpm.max(1.0);\\n        self.cooldown = 60.0 / rpm;\\n        self.condition = (self.condition - self.wear * wear_mul.max(0.0)).max(0.0);\\n        if self.condition < break_at && rng.f32() < 0.03 {\\n            self.broken = true;\\n            return Pull::Broke;\\n        }\\n        Pull::Fired\\n    }\\n\\n    /// Start clearing a jam, or slap the bolt. A second tap shortens the remaining time by 40%.\\n    pub fn tap_reload(&mut self) {\\n        if self.jammed && self.clear_left <= 0.0 {\\n            self.clear_left = clear_seconds(self.condition);\\n            self.slapped = false;\\n        } else if self.jammed && self.clear_left > 0.0 && !self.slapped {\\n            self.clear_left *= 0.6;\\n            self.slapped = true;\\n        } else if !self.jammed && !self.broken {\\n            let s = stats(self.id);\\n            let need = s.mag.saturating_sub(self.ammo);\\n            let take = need.min(self.reserve);\\n            self.ammo += take;\\n            self.reserve -= take;\\n        }\\n    }\\n\\n    pub fn tick_clear(&mut self, dt: f32) {\\n        if self.clear_left > 0.0 {\\n            self.clear_left = (self.clear_left - dt).max(0.0);\\n            if self.clear_left == 0.0 {\\n                self.jammed = false;\\n                self.slapped = false;\\n            }\\n        }\\n        if self.cooldown > 0.0 {\\n            self.cooldown = (self.cooldown - dt).max(0.0);\\n        }\\n    }\\n}\\n\",\"total_lines\":191}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"61ad5943-1a66-4458-811c-3ed4c6672af3"}
