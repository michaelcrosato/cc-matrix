atrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/Cargo.lock\",\"matches\":[{\"line_number\":511,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":512,\"content\":\" \\\"wasm-bindgen-futures\\\",\"},{\"line_number\":970,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":1368,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":2281,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":2282,\"content\":\" \\\"wasm-bindgen-futures\\\",\"},{\"line_number\":3325,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":3393,\"content\":\"name = \\\"wasm-bindgen\\\"\"},{\"line_number\":3401,\"content\":\" \\\"wasm-bindgen-macro\\\",\"},{\"line_number\":3402,\"content\":\" \\\"wasm-bindgen-shared\\\",\"},{\"line_number\":3406,\"content\":\"name = \\\"wasm-bindgen-futures\\\"\"},{\"line_number\":3413,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":3417,\"content\":\"name = \\\"wasm-bindgen-macro\\\"\"},{\"line_number\":3423,\"content\":\" \\\"wasm-bindgen-macro-support\\\",\"},{\"line_number\":3427,\"content\":\"name = \\\"wasm-bindgen-macro-support\\\"\"},{\"line_number\":3436,\"content\":\" \\\"wasm-bindgen-shared\\\",\"},{\"line_number\":3440,\"content\":\"name = \\\"wasm-bindgen-shared\\\"\"},{\"line_number\":3590,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":3600,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":3647,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":3648,\"content\":\" \\\"wasm-bindgen-futures\\\",\"},{\"line_number\":4094,\"content\":\" \\\"wasm-bindgen\\\",\"},{\"line_number\":4095,\"content\":\" \\\"wasm-bindgen-futures\\\",\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"acee57d4-5c90-4bfe-b2a1-d446d55e52d4"}
