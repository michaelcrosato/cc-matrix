{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-0ad064f4-41e5-47db-b2d2-af1783f877c9-63","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Jam Cry. The country is [`world::World`]; the pavilion room is a dusk overlook the body stands in.\\n\\npub mod fire;\\npub mod geom;\\npub mod gun;\\npub mod net;\\npub mod shell;\\npub mod world;\\n\\n10→use std::collections::BTreeMap;\\n\\nuse anyhow::{Result, anyhow};\\nuse glam::{Quat, Vec3};\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::{Game, GameBox, level_text};\\nuse crate::color::Color;\\nuse crate::entity::{EntityId, Spawn};\\nuse crate::frame::SimEvent;\\n20→use crate::input::InputFrame;\\nuse crate::room::RoomDef;\\nuse crate::shape::{Shape, Visual};\\nuse crate::sim::Sim;\\n\\npub use fire::FireMap;\\npub use geom::exposure;\\npub use gun::{Gun, WeaponId, clear_seconds, jam_probability, spread_mul};\\npub use net::{Link, client_apply, host_publish};\\npub use shell::{Device, MenuInput, glyph};\\n30→pub use world::{Route, Screen, Tune, World, about_pages, fiction_lines};\\n\\nconst LEVEL: &str = include_str!(\\\"../merc.toml\\\");\\n\\n/// Where the window looks. Menus keep the dusk overlook. Play copies the body.\\n#[derive(Clone, Copy, Debug)]\\npub struct Overlook {\\n    pub eye: [f32; 3],\\n    pub yaw: f32,\\n    pub pitch: f32,\\n40→    pub roll: f32,\\n}\\n\\nstatic OVERLOOK: std::sync::Mutex<Overlook> = std::sync::Mutex::new(Overlook {\\n    eye: [0.15, 1.55, 4.2],\\n    yaw: 0.0,\\n    pitch: -0.42,\\n    roll: 0.0,\\n});\\n\\n50→pub fn overlook() -> Overlook {\\n    *OVERLOOK.lock().unwrap()\\n}\\n\\nfn aim_overlook(eye: [f32; 3], yaw: f32, pitch: f32, roll: f32) {\\n    let mut slot = OVERLOOK.lock().unwrap();\\n    slot.eye = eye;\\n    slot.yaw = yaw;\\n    slot.pitch = pitch;\\n    slot.roll = roll;\\n60→}\\n\\n/// Same basis as `pav_view::camera::fp_basis`. Yaw 0, pitch 0, roll 0 → forward (0, 0, −1), right (1, 0, 0).\\nfn view_basis(yaw: f32, pitch: f32, roll: f32) -> (Vec3, Vec3, Vec3) {\\n    let (sy, cy) = yaw.sin_cos();\\n    let (sp, cp) = pitch.sin_cos();\\n    let mut forward = Vec3::new(sy * cp, sp, -cy * cp);\\n    if forward.length_squared() < 1e-8 {\\n        forward = Vec3::NEG_Z;\\n    }\\n70→    forward = forward.normalize();\\n    let mut right = forward.cross(Vec3::Y);\\n    if right.length_squared() < 1e-6 {\\n        right = Vec3::new(cy, 0.0, sy);\\n    }\\n    right = right.normalize();\\n    let up = right.cross(forward).normalize();\\n    let (sr, cr) = roll.sin_cos();\\n    let rolled_right = (right * cr + up * sr).normalize();\\n    let rolled_up = (up * cr - right * sr).normalize();\\n80→    (forward, rolled_right, rolled_up)\\n}\\n\\n/// Rules state. Visual entity ids are not part of the save: they are rebuilt in `post`.\\n#[derive(Clone, Serialize, Deserialize)]\\npub struct Merc {\\n    pub world: World,\\n    #[serde(skip)]\\n    dressed: bool,\\n    #[serde(skip)]\\n90→    country: Vec<EntityId>,\\n    #[serde(skip)]\\n    country_anchor: (i32, i32),\\n    #[serde(skip)]\\n    props: Vec<EntityId>,\\n}\\n\\n/// Builds the overlook and starts a human-route contract. History stays off: the save is the world.\\npub fn build(sim: &mut Sim, _rest: Option<&str>) -> Result<()> {\\n    let def = RoomDef::parse(&level_text(Merc::KEY, LEVEL)).map_err(|e| anyhow!(\\\"merc.toml: {e}\\\"))?;\\n100→    crate::scenes::build_standalone_room(sim, Merc::KEY, def);\\n    sim.config.history_seconds = 0.0;\\n    let game = Merc {\\n        world: World::campaign(sim.state.seed, Route::Human),\\n        dressed: false,\\n        country: Vec::new(),\\n        country_anchor: (i32::MIN, i32::MIN),\\n        props: Vec::new(),\\n    };\\n    sim.state.play = Some(GameBox::new(game));\\n110→    Ok(())\\n}\\n\\nimpl Merc {\\n    fn dress(&mut self, sim: &mut Sim) {\\n        if self.dressed {\\n            return;\\n        }\\n        self.dressed = true;\\n        let ground = Visual::new(Shape::Box { half: Vec3::new(48.0, 0.2, 48.0) }, Color::hex(\\\"#c9a24b\\\"));\\n120→        sim.spawn(Spawn::new(\\\"ground\\\", Vec3::new(0.0, -0.2, 0.0)).visual(ground));\\n        let road = Visual::new(Shape::Box { half: Vec3::new(3.2, 0.08, 40.0) }, Color::hex(\\\"#8a5a32\\\"));\\n        sim.spawn(Spawn::new(\\\"road\\\", Vec3::new(-1.2, 0.02, -6.0)).visual(road));\\n        let greens = [\\\"#3d5a32\\\", \\\"#2f4a28\\\", \\\"#4a6a38\\\", \\\"#243820\\\", \\\"#6a5030\\\"];\\n        for i in 0..28 {\\n            let col = (i % 7) as f32 - 3.0;\\n            let row = (i / 7) as f32;\\n            let h = 1.4 + (i % 5) as f32 * 0.55;\\n            let at = Vec3::new(col * 1.7, h, 1.2 - row * 2.4);\\n            let trunk = Visual::new(Shape::Box { half: Vec3::new(0.22, h, 0.22) }, Color::hex(greens[i % 5]));\\n130→            sim.spawn(Spawn::new(\\\"tree\\\", at).visual(trunk));\\n            let crown = Visual::new(Shape::Box { half: Vec3::new(0.7, 0.45, 0.7) }, Color::hex(greens[(i + 2) % 5]));\\n            sim.spawn(Spawn::new(\\\"crown\\\", at + Vec3::new(0.0, h * 0.65, 0.0)).visual(crown));\\n        }\\n        let mound = Visual::new(Shape::Box { half: Vec3::new(1.4, 0.7, 1.1) }, Color::hex(\\\"#a86838\\\"));\\n        sim.spawn(Spawn::new(\\\"mound\\\", Vec3::new(2.4, 0.7, -1.5)).visual(mound));\\n        let rifle = Visual::new(Shape::Box { half: Vec3::new(0.05, 0.05, 0.42) }, Color::hex(\\\"#2a2420\\\"));\\n        sim.spawn(Spawn::new(\\\"rifle\\\", Vec3::new(0.42, 1.18, 3.15)).visual(rifle));\\n        let rag = Visual::new(Shape::Box { half: Vec3::new(0.08, 0.16, 0.02) }, Color::hex(\\\"#9a2a22\\\"));\\n        sim.spawn(Spawn::new(\\\"rag\\\", Vec3::new(0.62, 1.42, 2.6)).visual(rag));\\n140→    }\\n\\n    fn sync_country(&mut self, sim: &mut Sim) {\\n        if self.world.screen != Screen::Playing {\\n            return;\\n        }\\n        let anchor = ((self.world.x / 8.0).div_euclid(1.0) as i32, (self.world.z / 8.0).div_euclid(1.0) as i32);\\n        if anchor == self.country_anchor && !self.country.is_empty() {\\n            return;\\n        }\\n150→        for id in self.country.drain(..) {\\n            sim.despawn(id);\\n        }\\n        self.country_anchor = anchor;\\n        for dz in -5..=5 {\\n            for dx in -5..=5 {\\n                let x = (anchor.0 + dx) as f32 * 8.0 + 4.0;\\n                let z = (anchor.1 + dz) as f32 * 8.0 + 4.0;\\n                let h = geom::height(x, z);\\n                let color = if geom::on_water(x, z) {\\n160→                    \\\"#2c6e78\\\"\\n                } else if geom::on_road(x, z) {\\n                    \\\"#8a5a32\\\"\\n                } else if geom::on_rock(x, z) {\\n                    \\\"#7a7368\\\"\\n                } else {\\n                    \\\"#b9924a\\\"\\n                };\\n                let tile = Visual::new(Shape::Box { half: Vec3::new(3.9, 0.12, 3.9) }, Color::hex(color));\\n                let id = sim.spawn(Spawn::new(\\\"country\\\", Vec3::new(x, h - 0.12, z)).visual(tile));\\n170→                self.country.push(id);\\n                if geom::tree_at(x, z) {\\n                    let trunk = Visual::new(Shape::Box { half: Vec3::new(0.22, 1.3, 0.22) }, Color::hex(\\\"#6a5030\\\"));\\n                    let tid = sim.spawn(Spawn::new(\\\"country-tree\\\", Vec3::new(x, h + 1.3, z)).visual(trunk));\\n                    self.country.push(tid);\\n                    let crown = Visual::new(Shape::Box { half: Vec3::new(1.1, 0.7, 1.1) }, Color::hex(\\\"#2f4a28\\\"));\\n                    let cid = sim.spawn(Spawn::new(\\\"country-crown\\\", Vec3::new(x, h + 2.6, z)).visual(crown));\\n                    self.country.push(cid);\\n                }\\n            }\\n180→        }\\n    }\\n\\n    fn sync_props(&mut self, sim: &mut Sim) {\\n        if self.world.screen != Screen::Playing {\\n            return;\\n        }\\n        if self.props.is_empty() {\\n            let hide = Vec3::new(0.0, -40.0, 0.0);\\n            let specs = [\\n190→                (\\\"fp-rifle\\\", Vec3::new(0.04, 0.04, 0.28), \\\"#2a2420\\\"),\\n                (\\\"fp-rag\\\", Vec3::new(0.02, 0.14, 0.08), \\\"#9a2a22\\\"),\\n                (\\\"fp-map\\\", Vec3::new(0.16, 0.01, 0.12), \\\"#d7c4a2\\\"),\\n                (\\\"fp-gps\\\", Vec3::new(0.05, 0.04, 0.02), \\\"#1c3a2a\\\"),\\n                (\\\"fp-glass\\\", Vec3::new(0.04, 0.04, 0.14), \\\"#1a1c1e\\\"),\\n            ];\\n            for (name, half, color) in specs {\\n                let visual = Visual::new(Shape::Box { half }, Color::hex(color));\\n                self.props.push(sim.spawn(Spawn::new(name, hide).visual(visual)));\\n            }\\n200→        }\\n        let (ex, ey, ez) = self.world.eye_pos();\\n        let eye = Vec3::new(ex, ey, ez);\\n        let pitch = self.world.pitch.clamp(-1.15, 1.15);\\n        let (fwd, right, up) = view_basis(self.world.yaw, pitch, self.world.roll);\\n        let flutter = Vec3::new(self.world.wind.x, (self.world.minutes * 3.0).sin() * 1.4, self.world.wind.y) * 0.04;\\n        let rifle = eye + fwd * 0.46 + right * 0.18 + up * -0.20;\\n        let rag = eye + fwd * 0.72 + right * 0.34 + up * -0.02 + flutter;\\n        let show_map = self.world.map_t > 0.05;\\n        let map = if show_map { eye + fwd * 0.40 + right * -0.16 + up * -0.10 } else { Vec3::new(ex, -40.0, ez) };\\n210→        let show_gps = self.world.waypoint.is_some();\\n        let gps = if show_gps { eye + fwd * 0.52 + up * -0.30 } else { Vec3::new(ex, -40.0, ez) };\\n        let show_glass = self.world.mono_t > 0.0;\\n        let glass = if show_glass { eye + fwd * 0.30 + up * -0.04 } else { Vec3::new(ex, -40.0, ez) };\\n        let spots = [rifle, rag, map, gps, glass];\\n        let rot = Quat::from_rotation_arc(Vec3::Z, fwd);\\n        for (id, pos) in self.props.iter().copied().zip(spots) {\\n            sim.set_position(id, pos);\\n            if let Some(e) = sim.state.entities.get_mut(id) {\\n                e.rot = rot;\\n220→            }\\n        }\\n    }\\n}\\n\\nimpl Game for Merc {\\n    const KEY: &'static str = \\\"merc\\\";\\n\\n    fn pre(\\n        &mut self,\\n230→        sim: &mut Sim,\\n        input: &InputFrame,\\n        dt: f32,\\n        _events: &mut Vec<SimEvent>,\\n    ) -> BTreeMap<EntityId, InputFrame> {\\n        self.world.tick(input, dt);\\n        let mut out = BTreeMap::new();\\n        if let Some(id) = sim.state.player {\\n            // The country moves inside `World`. The room body stays put so the controller does not fight it.\\n            out.insert(id, InputFrame::default());\\n240→        }\\n        out\\n    }\\n\\n    fn post(&mut self, sim: &mut Sim, _dt: f32, events: &mut Vec<SimEvent>) {\\n        self.dress(sim);\\n        let playing = self.world.screen == Screen::Playing;\\n        if let Some(id) = sim.state.player {\\n            if playing {\\n                let h = geom::height(self.world.x, self.world.z);\\n250→                sim.set_position(id, Vec3::new(self.world.x, h, self.world.z));\\n            } else {\\n                sim.set_position(id, sim.state.spawn);\\n            }\\n        }\\n        if playing {\\n            self.sync_country(sim);\\n            self.sync_props(sim);\\n            let (x, y, z) = self.world.eye_pos();\\n            let pitch = self.world.pitch.clamp(-1.15, 1.15);\\n260→            aim_overlook([x, y, z], self.world.yaw, pitch, self.world.roll);\\n        } else {\\n            aim_overlook([0.15, 1.55, 4.2], 0.0, -0.42, 0.0);\\n        }\\n        if self.world.guns.first().is_some_and(|g| g.shots > 0) {\\n            events.push(SimEvent::Impact { pos: Vec3::new(0.0, 1.2, -1.0), strength: 0.4 });\\n        }\\n    }\\n\\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\\n270→        vec![format!(\\\"HP {:.0}\\\", self.world.hp), self.world.goal_name()]\\n    }\\n\\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\\n        self.world.status()\\n    }\\n\\n    fn bot(&self, _sim: &Sim) -> InputFrame {\\n        self.world.bot_input()\\n    }\\n280→}\",\"content_concise\":\"1→//! Jam Cry. The country is [`world::World`]; the pavilion room is a dusk overlook the body stands in.\\n\\npub mod fire;\\npub mod geom;\\npub mod gun;\\npub mod net;\\npub mod shell;\\npub mod world;\\n\\n10→use std::collections::BTreeMap;\\n\\nuse anyhow::{Result, anyhow};\\nuse glam::{Quat, Vec3};\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::{Game, GameBox, level_text};\\nuse crate::color::Color;\\nuse crate::entity::{EntityId, Spawn};\\nuse crate::frame::SimEvent;\\n20→use crate::input::InputFrame;\\nuse crate::room::RoomDef;\\nuse crate::shape::{Shape, Visual};\\nuse crate::sim::Sim;\\n\\npub use fire::FireMap;\\npub use geom::exposure;\\npub use gun::{Gun, WeaponId, clear_seconds, jam_probability, spread_mul};\\npub use net::{Link, client_apply, host_publish};\\npub use shell::{Device, MenuInput, glyph};\\n30→pub use world::{Route, Screen, Tune, World, about_pages, fiction_lines};\\n\\nconst LEVEL: &str = include_str!(\\\"../merc.toml\\\");\\n\\n/// Where the window looks. Menus keep the dusk overlook. Play copies the body.\\n#[derive(Clone, Copy, Debug)]\\npub struct Overlook {\\n    pub eye: [f32; 3],\\n    pub yaw: f32,\\n    pub pitch: f32,\\n40→    pub roll: f32,\\n}\\n\\nstatic OVERLOOK: std::sync::Mutex<Overlook> = std::sync::Mutex::new(Overlook {\\n    eye: [0.15, 1.55, 4.2],\\n    yaw: 0.0,\\n    pitch: -0.42,\\n    roll: 0.0,\\n});\\n\\n50→pub fn overlook() -> Overlook {\\n    *OVERLOOK.lock().unwrap()\\n}\\n\\nfn aim_overlook(eye: [f32; 3], yaw: f32, pitch: f32, roll: f32) {\\n    let mut slot = OVERLOOK.lock().unwrap();\\n    slot.eye = eye;\\n    slot.yaw = yaw;\\n    slot.pitch = pitch;\\n    slot.roll = roll;\\n60→}\\n\\n/// Same basis as `pav_view::camera::fp_basis`. Yaw 0, pitch 0, roll 0 → forward (0, 0, −1), right (1, 0, 0).\\nfn view_basis(yaw: f32, pitch: f32, roll: f32) -> (Vec3, Vec3, Vec3) {\\n    let (sy, cy) = yaw.sin_cos();\\n    let (sp, cp) = pitch.sin_cos();\\n    let mut forward = Vec3::new(sy * cp, sp, -cy * cp);\\n    if forward.length_squared() < 1e-8 {\\n        forward = Vec3::NEG_Z;\\n    }\\n70→    forward = forward.normalize();\\n    let mut right = forward.cross(Vec3::Y);\\n    if right.length_squared() < 1e-6 {\\n        right = Vec3::new(cy, 0.0, sy);\\n    }\\n    right = right.normalize();\\n    let up = right.cross(forward).normalize();\\n    let (sr, cr) = roll.sin_cos();\\n    let rolled_right = (right * cr + up * sr).normalize();\\n    let rolled_up = (up * cr - right * sr).normalize();\\n80→    (forward, rolled_right, rolled_up)\\n}\\n\\n/// Rules state. Visual entity ids are not part of the save: they are rebuilt in `post`.\\n#[derive(Clone, Serialize, Deserialize)]\\npub struct Merc {\\n    pub world: World,\\n    #[serde(skip)]\\n    dressed: bool,\\n    #[serde(skip)]\\n90→    country: Vec<EntityId>,\\n    #[serde(skip)]\\n    country_anchor: (i32, i32),\\n    #[serde(skip)]\\n    props: Vec<EntityId>,\\n}\\n\\n/// Builds the overlook and starts a human-route contract. History stays off: the save is the world.\\npub fn build(sim: &mut Sim, _rest: Option<&str>) -> Result<()> {\\n    let def = RoomDef::parse(&level_text(Merc::KEY, LEVEL)).map_err(|e| anyhow!(\\\"merc.toml: {e}\\\"))?;\\n100→    crate::scenes::build_standalone_room(sim, Merc::KEY, def);\\n    sim.config.history_seconds = 0.0;\\n    let game = Merc {\\n        world: World::campaign(sim.state.seed, Route::Human),\\n        dressed: false,\\n        country: Vec::new(),\\n        country_anchor: (i32::MIN, i32::MIN),\\n        props: Vec::new(),\\n    };\\n    sim.state.play = Some(GameBox::new(game));\\n110→    Ok(())\\n}\\n\\nimpl Merc {\\n    fn dress(&mut self, sim: &mut Sim) {\\n        if self.dressed {\\n            return;\\n        }\\n        self.dressed = true;\\n        let ground = Visual::new(Shape::Box { half: Vec3::new(48.0, 0.2, 48.0) }, Color::hex(\\\"#c9a24b\\\"));\\n120→        sim.spawn(Spawn::new(\\\"ground\\\", Vec3::new(0.0, -0.2, 0.0)).visual(ground));\\n        let road = Visual::new(Shape::Box { half: Vec3::new(3.2, 0.08, 40.0) }, Color::hex(\\\"#8a5a32\\\"));\\n        sim.spawn(Spawn::new(\\\"road\\\", Vec3::new(-1.2, 0.02, -6.0)).visual(road));\\n        let greens = [\\\"#3d5a32\\\", \\\"#2f4a28\\\", \\\"#4a6a38\\\", \\\"#243820\\\", \\\"#6a5030\\\"];\\n        for i in 0..28 {\\n            let col = (i % 7) as f32 - 3.0;\\n            let row = (i / 7) as f32;\\n            let h = 1.4 + (i % 5) as f32 * 0.55;\\n            let at = Vec3::new(col * 1.7, h, 1.2 - row * 2.4);\\n            let trunk = Visual::new(Shape::Box { half: Vec3::new(0.22, h, 0.22) }, Color::hex(greens[i % 5]));\\n130→            sim.spawn(Spawn::new(\\\"tree\\\", at).visual(trunk));\\n            let crown = Visual::new(Shape::Box { half: Vec3::new(0.7, 0.45, 0.7) }, Color::hex(greens[(i + 2) % 5]));\\n            sim.spawn(Spawn::new(\\\"crown\\\", at + Vec3::new(0.0, h * 0.65, 0.0)).visual(crown));\\n        }\\n        let mound = Visual::new(Shape::Box { half: Vec3::new(1.4, 0.7, 1.1) }, Color::hex(\\\"#a86838\\\"));\\n        sim.spawn(Spawn::new(\\\"mound\\\", Vec3::new(2.4, 0.7, -1.5)).visual(mound));\\n        let rifle = Visual::new(Shape::Box { half: Vec3::new(0.05, 0.05, 0.42) }, Color::hex(\\\"#2a2420\\\"));\\n        sim.spawn(Spawn::new(\\\"rifle\\\", Vec3::new(0.42, 1.18, 3.15)).visual(rifle));\\n        let rag = Visual::new(Shape::Box { half: Vec3::new(0.08, 0.16, 0.02) }, Color::hex(\\\"#9a2a22\\\"));\\n        sim.spawn(Spawn::new(\\\"rag\\\", Vec3::new(0.62, 1.42, 2.6)).visual(rag));\\n140→    }\\n\\n    fn sync_country(&mut self, sim: &mut Sim) {\\n        if self.world.screen != Screen::Playing {\\n            return;\\n        }\\n        let anchor = ((self.world.x / 8.0).div_euclid(1.0) as i32, (self.world.z / 8.0).div_euclid(1.0) as i32);\\n        if anchor == self.country_anchor && !self.country.is_empty() {\\n            return;\\n        }\\n150→        for id in self.country.drain(..) {\\n            sim.despawn(id);\\n        }\\n        self.country_anchor = anchor;\\n        for dz in -5..=5 {\\n            for dx in -5..=5 {\\n                let x = (anchor.0 + dx) as f32 * 8.0 + 4.0;\\n                let z = (anchor.1 + dz) as f32 * 8.0 + 4.0;\\n                let h = geom::height(x, z);\\n                let color = if geom::on_water(x, z) {\\n160→                    \\\"#2c6e78\\\"\\n                } else if geom::on_road(x, z) {\\n                    \\\"#8a5a32\\\"\\n                } else if geom::on_rock(x, z) {\\n                    \\\"#7a7368\\\"\\n                } else {\\n                    \\\"#b9924a\\\"\\n                };\\n                let tile = Visual::new(Shape::Box { half: Vec3::new(3.9, 0.12, 3.9) }, Color::hex(color));\\n                let id = sim.spawn(Spawn::new(\\\"country\\\", Vec3::new(x, h - 0.12, z)).visual(tile));\\n170→                self.country.push(id);\\n                if geom::tree_at(x, z) {\\n                    let trunk = Visual::new(Shape::Box { half: Vec3::new(0.22, 1.3, 0.22) }, Color::hex(\\\"#6a5030\\\"));\\n                    let tid = sim.spawn(Spawn::new(\\\"country-tree\\\", Vec3::new(x, h + 1.3, z)).visual(trunk));\\n                    self.country.push(tid);\\n                    let crown = Visual::new(Shape::Box { half: Vec3::new(1.1, 0.7, 1.1) }, Color::hex(\\\"#2f4a28\\\"));\\n                    let cid = sim.spawn(Spawn::new(\\\"country-crown\\\", Vec3::new(x, h + 2.6, z)).visual(crown));\\n                    self.country.push(cid);\\n                }\\n            }\\n180→        }\\n    }\\n\\n    fn sync_props(&mut self, sim: &mut Sim) {\\n        if self.world.screen != Screen::Playing {\\n            return;\\n        }\\n        if self.props.is_empty() {\\n            let hide = Vec3::new(0.0, -40.0, 0.0);\\n            let specs = [\\n190→                (\\\"fp-rifle\\\", Vec3::new(0.04, 0.04, 0.28), \\\"#2a2420\\\"),\\n                (\\\"fp-rag\\\", Vec3::new(0.02, 0.14, 0.08), \\\"#9a2a22\\\"),\\n                (\\\"fp-map\\\", Vec3::new(0.16, 0.01, 0.12), \\\"#d7c4a2\\\"),\\n                (\\\"fp-gps\\\", Vec3::new(0.05, 0.04, 0.02), \\\"#1c3a2a\\\"),\\n                (\\\"fp-glass\\\", Vec3::new(0.04, 0.04, 0.14), \\\"#1a1c1e\\\"),\\n            ];\\n            for (name, half, color) in specs {\\n                let visual = Visual::new(Shape::Box { half }, Color::hex(color));\\n                self.props.push(sim.spawn(Spawn::new(name, hide).visual(visual)));\\n            }\\n200→        }\\n        let (ex, ey, ez) = self.world.eye_pos();\\n        let eye = Vec3::new(ex, ey, ez);\\n        let pitch = self.world.pitch.clamp(-1.15, 1.15);\\n        let (fwd, right, up) = view_basis(self.world.yaw, pitch, self.world.roll);\\n        let flutter = Vec3::new(self.world.wind.x, (self.world.minutes * 3.0).sin() * 1.4, self.world.wind.y) * 0.04;\\n        let rifle = eye + fwd * 0.46 + right * 0.18 + up * -0.20;\\n        let rag = eye + fwd * 0.72 + right * 0.34 + up * -0.02 + flutter;\\n        let show_map = self.world.map_t > 0.05;\\n        let map = if show_map { eye + fwd * 0.40 + right * -0.16 + up * -0.10 } else { Vec3::new(ex, -40.0, ez) };\\n210→        let show_gps = self.world.waypoint.is_some();\\n        let gps = if show_gps { eye + fwd * 0.52 + up * -0.30 } else { Vec3::new(ex, -40.0, ez) };\\n        let show_glass = self.world.mono_t > 0.0;\\n        let glass = if show_glass { eye + fwd * 0.30 + up * -0.04 } else { Vec3::new(ex, -40.0, ez) };\\n        let spots = [rifle, rag, map, gps, glass];\\n        let rot = Quat::from_rotation_arc(Vec3::Z, fwd);\\n        for (id, pos) in self.props.iter().copied().zip(spots) {\\n            sim.set_position(id, pos);\\n            if let Some(e) = sim.state.entities.get_mut(id) {\\n                e.rot = rot;\\n220→            }\\n        }\\n    }\\n}\\n\\nimpl Game for Merc {\\n    const KEY: &'static str = \\\"merc\\\";\\n\\n    fn pre(\\n        &mut self,\\n230→        sim: &mut Sim,\\n        input: &InputFrame,\\n        dt: f32,\\n        _events: &mut Vec<SimEvent>,\\n    ) -> BTreeMap<EntityId, InputFrame> {\\n        self.world.tick(input, dt);\\n        let mut out = BTreeMap::new();\\n        if let Some(id) = sim.state.player {\\n            // The country moves inside `World`. The room body stays put so the controller does not fight it.\\n            out.insert(id, InputFrame::default());\\n240→        }\\n        out\\n    }\\n\\n    fn post(&mut self, sim: &mut Sim, _dt: f32, events: &mut Vec<SimEvent>) {\\n        self.dress(sim);\\n        let playing = self.world.screen == Screen::Playing;\\n        if let Some(id) = sim.state.player {\\n            if playing {\\n                let h = geom::height(self.world.x, self.world.z);\\n250→                sim.set_position(id, Vec3::new(self.world.x, h, self.world.z));\\n            } else {\\n                sim.set_position(id, sim.state.spawn);\\n            }\\n        }\\n        if playing {\\n            self.sync_country(sim);\\n            self.sync_props(sim);\\n            let (x, y, z) = self.world.eye_pos();\\n            let pitch = self.world.pitch.clamp(-1.15, 1.15);\\n260→            aim_overlook([x, y, z], self.world.yaw, pitch, self.world.roll);\\n        } else {\\n            aim_overlook([0.15, 1.55, 4.2], 0.0, -0.42, 0.0);\\n        }\\n        if self.world.guns.first().is_some_and(|g| g.shots > 0) {\\n            events.push(SimEvent::Impact { pos: Vec3::new(0.0, 1.2, -1.0), strength: 0.4 });\\n        }\\n    }\\n\\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\\n270→        vec![format!(\\\"HP {:.0}\\\", self.world.hp), self.world.goal_name()]\\n    }\\n\\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\\n        self.world.status()\\n    }\\n\\n    fn bot(&self, _sim: &Sim) -> InputFrame {\\n        self.world.bot_input()\\n    }\\n280→}\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/mod.rs\",\"offset\":null,\"limit\":280,\"raw_output\":\"//! Jam Cry. The country is [`world::World`]; the pavilion room is a dusk overlook the body stands in.\\n\\npub mod fire;\\npub mod geom;\\npub mod gun;\\npub mod net;\\npub mod shell;\\npub mod world;\\n\\nuse std::collections::BTreeMap;\\n\\nuse anyhow::{Result, anyhow};\\nuse glam::{Quat, Vec3};\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::{Game, GameBox, level_text};\\nuse crate::color::Color;\\nuse crate::entity::{EntityId, Spawn};\\nuse crate::frame::SimEvent;\\nuse crate::input::InputFrame;\\nuse crate::room::RoomDef;\\nuse crate::shape::{Shape, Visual};\\nuse crate::sim::Sim;\\n\\npub use fire::FireMap;\\npub use geom::exposure;\\npub use gun::{Gun, WeaponId, clear_seconds, jam_probability, spread_mul};\\npub use net::{Link, client_apply, host_publish};\\npub use shell::{Device, MenuInput, glyph};\\npub use world::{Route, Screen, Tune, World, about_pages, fiction_lines};\\n\\nconst LEVEL: &str = include_str!(\\\"../merc.toml\\\");\\n\\n/// Where the window looks. Menus keep the dusk overlook. Play copies the body.\\n#[derive(Clone, Copy, Debug)]\\npub struct Overlook {\\n    pub eye: [f32; 3],\\n    pub yaw: f32,\\n    pub pitch: f32,\\n    pub roll: f32,\\n}\\n\\nstatic OVERLOOK: std::sync::Mutex<Overlook> = std::sync::Mutex::new(Overlook {\\n    eye: [0.15, 1.55, 4.2],\\n    yaw: 0.0,\\n    pitch: -0.42,\\n    roll: 0.0,\\n});\\n\\npub fn overlook() -> Overlook {\\n    *OVERLOOK.lock().unwrap()\\n}\\n\\nfn aim_overlook(eye: [f32; 3], yaw: f32, pitch: f32, roll: f32) {\\n    let mut slot = OVERLOOK.lock().unwrap();\\n    slot.eye = eye;\\n    slot.yaw = yaw;\\n    slot.pitch = pitch;\\n    slot.roll = roll;\\n}\\n\\n/// Same basis as `pav_view::camera::fp_basis`. Yaw 0, pitch 0, roll 0 → forward (0, 0, −1), right (1, 0, 0).\\nfn view_basis(yaw: f32, pitch: f32, roll: f32) -> (Vec3, Vec3, Vec3) {\\n    let (sy, cy) = yaw.sin_cos();\\n    let (sp, cp) = pitch.sin_cos();\\n    let mut forward = Vec3::new(sy * cp, sp, -cy * cp);\\n    if forward.length_squared() < 1e-8 {\\n        forward = Vec3::NEG_Z;\\n    }\\n    forward = forward.normalize();\\n    let mut right = forward.cross(Vec3::Y);\\n    if right.length_squared() < 1e-6 {\\n        right = Vec3::new(cy, 0.0, sy);\\n    }\\n    right = right.normalize();\\n    let up = right.cross(forward).normalize();\\n    let (sr, cr) = roll.sin_cos();\\n    let rolled_right = (right * cr + up * sr).normalize();\\n    let rolled_up = (up * cr - right * sr).normalize();\\n    (forward, rolled_right, rolled_up)\\n}\\n\\n/// Rules state. Visual entity ids are not part of the save: they are rebuilt in `post`.\\n#[derive(Clone, Serialize, Deserialize)]\\npub struct Merc {\\n    pub world: World,\\n    #[serde(skip)]\\n    dressed: bool,\\n    #[serde(skip)]\\n    country: Vec<EntityId>,\\n    #[serde(skip)]\\n    country_anchor: (i32, i32),\\n    #[serde(skip)]\\n    props: Vec<EntityId>,\\n}\\n\\n/// Builds the overlook and starts a human-route contract. History stays off: the save is the world.\\npub fn build(sim: &mut Sim, _rest: Option<&str>) -> Result<()> {\\n    let def = RoomDef::parse(&level_text(Merc::KEY, LEVEL)).map_err(|e| anyhow!(\\\"merc.toml: {e}\\\"))?;\\n    crate::scenes::build_standalone_room(sim, Merc::KEY, def);\\n    sim.config.history_seconds = 0.0;\\n    let game = Merc {\\n        world: World::campaign(sim.state.seed, Route::Human),\\n        dressed: false,\\n        country: Vec::new(),\\n        country_anchor: (i32::MIN, i32::MIN),\\n        props: Vec::new(),\\n    };\\n    sim.state.play = Some(GameBox::new(game));\\n    Ok(())\\n}\\n\\nimpl Merc {\\n    fn dress(&mut self, sim: &mut Sim) {\\n        if self.dressed {\\n            return;\\n        }\\n        self.dressed = true;\\n        let ground = Visual::new(Shape::Box { half: Vec3::new(48.0, 0.2, 48.0) }, Color::hex(\\\"#c9a24b\\\"));\\n        sim.spawn(Spawn::new(\\\"ground\\\", Vec3::new(0.0, -0.2, 0.0)).visual(ground));\\n        let road = Visual::new(Shape::Box { half: Vec3::new(3.2, 0.08, 40.0) }, Color::hex(\\\"#8a5a32\\\"));\\n        sim.spawn(Spawn::new(\\\"road\\\", Vec3::new(-1.2, 0.02, -6.0)).visual(road));\\n        let greens = [\\\"#3d5a32\\\", \\\"#2f4a28\\\", \\\"#4a6a38\\\", \\\"#243820\\\", \\\"#6a5030\\\"];\\n        for i in 0..28 {\\n            let col = (i % 7) as f32 - 3.0;\\n            let row = (i / 7) as f32;\\n            let h = 1.4 + (i % 5) as f32 * 0.55;\\n            let at = Vec3::new(col * 1.7, h, 1.2 - row * 2.4);\\n            let trunk = Visual::new(Shape::Box { half: Vec3::new(0.22, h, 0.22) }, Color::hex(greens[i % 5]));\\n            sim.spawn(Spawn::new(\\\"tree\\\", at).visual(trunk));\\n            let crown = Visual::new(Shape::Box { half: Vec3::new(0.7, 0.45, 0.7) }, Color::hex(greens[(i + 2) % 5]));\\n            sim.spawn(Spawn::new(\\\"crown\\\", at + Vec3::new(0.0, h * 0.65, 0.0)).visual(crown));\\n        }\\n        let mound = Visual::new(Shape::Box { half: Vec3::new(1.4, 0.7, 1.1) }, Color::hex(\\\"#a86838\\\"));\\n        sim.spawn(Spawn::new(\\\"mound\\\", Vec3::new(2.4, 0.7, -1.5)).visual(mound));\\n        let rifle = Visual::new(Shape::Box { half: Vec3::new(0.05, 0.05, 0.42) }, Color::hex(\\\"#2a2420\\\"));\\n        sim.spawn(Spawn::new(\\\"rifle\\\", Vec3::new(0.42, 1.18, 3.15)).visual(rifle));\\n        let rag = Visual::new(Shape::Box { half: Vec3::new(0.08, 0.16, 0.02) }, Color::hex(\\\"#9a2a22\\\"));\\n        sim.spawn(Spawn::new(\\\"rag\\\", Vec3::new(0.62, 1.42, 2.6)).visual(rag));\\n    }\\n\\n    fn sync_country(&mut self, sim: &mut Sim) {\\n        if self.world.screen != Screen::Playing {\\n            return;\\n        }\\n        let anchor = ((self.world.x / 8.0).div_euclid(1.0) as i32, (self.world.z / 8.0).div_euclid(1.0) as i32);\\n        if anchor == self.country_anchor && !self.country.is_empty() {\\n            return;\\n        }\\n        for id in self.country.drain(..) {\\n            sim.despawn(id);\\n        }\\n        self.country_anchor = anchor;\\n        for dz in -5..=5 {\\n            for dx in -5..=5 {\\n                let x = (anchor.0 + dx) as f32 * 8.0 + 4.0;\\n                let z = (anchor.1 + dz) as f32 * 8.0 + 4.0;\\n                let h = geom::height(x, z);\\n                let color = if geom::on_water(x, z) {\\n                    \\\"#2c6e78\\\"\\n                } else if geom::on_road(x, z) {\\n                    \\\"#8a5a32\\\"\\n                } else if geom::on_rock(x, z) {\\n                    \\\"#7a7368\\\"\\n                } else {\\n                    \\\"#b9924a\\\"\\n                };\\n                let tile = Visual::new(Shape::Box { half: Vec3::new(3.9, 0.12, 3.9) }, Color::hex(color));\\n                let id = sim.spawn(Spawn::new(\\\"country\\\", Vec3::new(x, h - 0.12, z)).visual(tile));\\n                self.country.push(id);\\n                if geom::tree_at(x, z) {\\n                    let trunk = Visual::new(Shape::Box { half: Vec3::new(0.22, 1.3, 0.22) }, Color::hex(\\\"#6a5030\\\"));\\n                    let tid = sim.spawn(Spawn::new(\\\"country-tree\\\", Vec3::new(x, h + 1.3, z)).visual(trunk));\\n                    self.country.push(tid);\\n                    let crown = Visual::new(Shape::Box { half: Vec3::new(1.1, 0.7, 1.1) }, Color::hex(\\\"#2f4a28\\\"));\\n                    let cid = sim.spawn(Spawn::new(\\\"country-crown\\\", Vec3::new(x, h + 2.6, z)).visual(crown));\\n                    self.country.push(cid);\\n                }\\n            }\\n        }\\n    }\\n\\n    fn sync_props(&mut self, sim: &mut Sim) {\\n        if self.world.screen != Screen::Playing {\\n            return;\\n        }\\n        if self.props.is_empty() {\\n            let hide = Vec3::new(0.0, -40.0, 0.0);\\n            let specs = [\\n                (\\\"fp-rifle\\\", Vec3::new(0.04, 0.04, 0.28), \\\"#2a2420\\\"),\\n                (\\\"fp-rag\\\", Vec3::new(0.02, 0.14, 0.08), \\\"#9a2a22\\\"),\\n                (\\\"fp-map\\\", Vec3::new(0.16, 0.01, 0.12), \\\"#d7c4a2\\\"),\\n                (\\\"fp-gps\\\", Vec3::new(0.05, 0.04, 0.02), \\\"#1c3a2a\\\"),\\n                (\\\"fp-glass\\\", Vec3::new(0.04, 0.04, 0.14), \\\"#1a1c1e\\\"),\\n            ];\\n            for (name, half, color) in specs {\\n                let visual = Visual::new(Shape::Box { half }, Color::hex(color));\\n                self.props.push(sim.spawn(Spawn::new(name, hide).visual(visual)));\\n            }\\n        }\\n        let (ex, ey, ez) = self.world.eye_pos();\\n        let eye = Vec3::new(ex, ey, ez);\\n        let pitch = self.world.pitch.clamp(-1.15, 1.15);\\n        let (fwd, right, up) = view_basis(self.world.yaw, pitch, self.world.roll);\\n        let flutter = Vec3::new(self.world.wind.x, (self.world.minutes * 3.0).sin() * 1.4, self.world.wind.y) * 0.04;\\n        let rifle = eye + fwd * 0.46 + right * 0.18 + up * -0.20;\\n        let rag = eye + fwd * 0.72 + right * 0.34 + up * -0.02 + flutter;\\n        let show_map = self.world.map_t > 0.05;\\n        let map = if show_map { eye + fwd * 0.40 + right * -0.16 + up * -0.10 } else { Vec3::new(ex, -40.0, ez) };\\n        let show_gps = self.world.waypoint.is_some();\\n        let gps = if show_gps { eye + fwd * 0.52 + up * -0.30 } else { Vec3::new(ex, -40.0, ez) };\\n        let show_glass = self.world.mono_t > 0.0;\\n        let glass = if show_glass { eye + fwd * 0.30 + up * -0.04 } else { Vec3::new(ex, -40.0, ez) };\\n        let spots = [rifle, rag, map, gps, glass];\\n        let rot = Quat::from_rotation_arc(Vec3::Z, fwd);\\n        for (id, pos) in self.props.iter().copied().zip(spots) {\\n            sim.set_position(id, pos);\\n            if let Some(e) = sim.state.entities.get_mut(id) {\\n                e.rot = rot;\\n            }\\n        }\\n    }\\n}\\n\\nimpl Game for Merc {\\n    const KEY: &'static str = \\\"merc\\\";\\n\\n    fn pre(\\n        &mut self,\\n        sim: &mut Sim,\\n        input: &InputFrame,\\n        dt: f32,\\n        _events: &mut Vec<SimEvent>,\\n    ) -> BTreeMap<EntityId, InputFrame> {\\n        self.world.tick(input, dt);\\n        let mut out = BTreeMap::new();\\n        if let Some(id) = sim.state.player {\\n            // The country moves inside `World`. The room body stays put so the controller does not fight it.\\n            out.insert(id, InputFrame::default());\\n        }\\n        out\\n    }\\n\\n    fn post(&mut self, sim: &mut Sim, _dt: f32, events: &mut Vec<SimEvent>) {\\n        self.dress(sim);\\n        let playing = self.world.screen == Screen::Playing;\\n        if let Some(id) = sim.state.player {\\n            if playing {\\n                let h = geom::height(self.world.x, self.world.z);\\n                sim.set_position(id, Vec3::new(self.world.x, h, self.world.z));\\n            } else {\\n                sim.set_position(id, sim.state.spawn);\\n            }\\n        }\\n        if playing {\\n            self.sync_country(sim);\\n            self.sync_props(sim);\\n            let (x, y, z) = self.world.eye_pos();\\n            let pitch = self.world.pitch.clamp(-1.15, 1.15);\\n            aim_overlook([x, y, z], self.world.yaw, pitch, self.world.roll);\\n        } else {\\n            aim_overlook([0.15, 1.55, 4.2], 0.0, -0.42, 0.0);\\n        }\\n        if self.world.guns.first().is_some_and(|g| g.shots > 0) {\\n            events.push(SimEvent::Impact { pos: Vec3::new(0.0, 1.2, -1.0), strength: 0.4 });\\n        }\\n    }\\n\\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\\n        vec![format!(\\\"HP {:.0}\\\", self.world.hp), self.world.goal_name()]\\n    }\\n\\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\\n        self.world.status()\\n    }\\n\\n    fn bot(&self, _sim: &Sim) -> InputFrame {\\n        self.world.bot_input()\\n    }\\n}\\n\",\"total_lines\":280}}","is_error":false},{"type":"tool_result","tool_use_id":"call-0ad064f4-41e5-47db-b2d2-af1783f877c9-64","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"681→fn act(n: u32) -> InputFrame {\\n    let mut f = InputFrame::default();\\n    f.act = n;\\n    f\\n}\\n\\n#[test]\\nfn first_person_eye_tracks_the_body() {\\n    let _cam = camera_lock();\\n690→    let mut sim = Sim::new(Merc::KEY, 1).unwrap();\\n    for bit in [buttons::CONFIRM, buttons::JUMP, buttons::CONFIRM, buttons::JUMP] {\\n        sim.step(&press(bit));\\n    }\\n    let (eye0, screen) = {\\n        let merc = sim.play().unwrap().get::<Merc>().unwrap();\\n        (merc.world.eye_pos(), merc.world.screen)\\n    };\\n    assert_eq!(screen, Screen::Playing);\\n    let cam = merc::overlook();\\n700→    assert!((cam.eye[0] - eye0.0).abs() < 0.25 && (cam.eye[1] - eye0.1).abs() < 0.25 && (cam.eye[2] - eye0.2).abs() < 0.25, \\\"cam {:?} eye {:?}\\\", cam.eye, eye0);\\n\\n    let mut f = InputFrame::default();\\n    f.move_dir.y = 1.0;\\n    for _ in 0..90 {\\n        sim.step(&f);\\n    }\\n    let eye1 = sim.play().unwrap().get::<Merc>().unwrap().world.eye_pos();\\n    let cam = merc::overlook();\\n    assert!((cam.eye[0] - eye1.0).abs() < 0.3 && (cam.eye[2] - eye1.2).abs() < 0.3, \\\"cam {:?} eye {:?}\\\", cam.eye, eye1);\\n710→    assert!((eye1.0 - eye0.0).abs() + (eye1.2 - eye0.2).abs() > 1.0, \\\"eye did not move {eye0:?} -> {eye1:?}\\\");\\n\\n    let mut c = InputFrame::default();\\n    c.held = buttons::CROUCH;\\n    for _ in 0..40 {\\n        sim.step(&c);\\n    }\\n    let eye_c = sim.play().unwrap().get::<Merc>().unwrap().world.eye_pos();\\n    let cam = merc::overlook();\\n    assert!(eye_c.1 < eye1.1 - 0.3, \\\"crouch {} stand {}\\\", eye_c.1, eye1.1);\\n720→    assert!((cam.eye[1] - eye_c.1).abs() < 0.25, \\\"cam y {} eye {}\\\", cam.eye[1], eye_c.1);\\n\\n    let rifle = sim.state.entities.map.values().find(|e| e.name == \\\"fp-rifle\\\").expect(\\\"rifle prop\\\");\\n    let dx = rifle.pos.x - cam.eye[0];\\n    let dy = rifle.pos.y - cam.eye[1];\\n    let dz = rifle.pos.z - cam.eye[2];\\n    let dist = (dx * dx + dy * dy + dz * dz).sqrt();\\n    assert!(dist > 0.15 && dist < 1.2, \\\"rifle dist {dist}\\\");\\n    let rag = sim.state.entities.map.values().find(|e| e.name == \\\"fp-rag\\\").expect(\\\"rag prop\\\");\\n    let rdx = rag.pos.x - cam.eye[0];\\n730→    let rdy = rag.pos.y - cam.eye[1];\\n    let rdz = rag.pos.z - cam.eye[2];\\n    let rdist = (rdx * rdx + rdy * rdy + rdz * rdz).sqrt();\\n    assert!(rdist > 0.15 && rdist < 1.6, \\\"rag dist {rdist}\\\");\\n    let near_country = sim.state.entities.map.values().any(|e| {\\n        if e.name != \\\"country\\\" {\\n            return false;\\n        }\\n        let dx = e.pos.x - eye_c.0;\\n        let dz = e.pos.z - eye_c.2;\\n740→        dx * dx + dz * dz < 12.0 * 12.0\\n    });\\n    assert!(near_country, \\\"country patch is not under the eye\\\");\\n}\\n\\n#[test]\\nfn ledger_confirm_earns_the_chosen_ending() {\\n    let mut burn = World::campaign(1, Route::Human);\\n    burn.present_ending();\\n    burn.tick(&InputFrame::default(), DT);\\n750→    assert_eq!(burn.screen, Screen::Ledger);\\n    assert!(!burn.flags.contains(\\\"ending_burn\\\"));\\n    burn.tick(&act(1), DT);\\n    assert_eq!(burn.screen, Screen::Playing);\\n    assert_eq!(burn.finale, Some(0));\\n    assert!(!burn.flags.contains(\\\"ending_burn\\\"));\\n    let mut t = 0.0f32;\\n    while !burn.flags.contains(\\\"ending_burn\\\") && t < 8.0 {\\n        let input = burn.bot_input();\\n        burn.tick(&input, DT);\\n760→        t += DT;\\n    }\\n    assert!(burn.flags.contains(\\\"ending_burn\\\"), \\\"burn flag missing after {t:.1}s\\\");\\n\\n    let mut chair = World::campaign(1, Route::Chair);\\n    chair.present_ending();\\n    chair.tick(&InputFrame::default(), DT);\\n    assert_eq!(chair.screen, Screen::Ledger);\\n    chair.tick(&act(4), DT);\\n    chair.tick(&act(4), DT);\\n770→    assert_eq!(chair.focus, 2);\\n    chair.tick(&act(1), DT);\\n    assert_eq!(chair.finale, Some(2));\\n    assert!(!chair.flags.contains(\\\"ending_chair\\\"));\\n    chair.tick(&press(buttons::INTERACT), DT);\\n    assert!(chair.flags.contains(\\\"ending_chair\\\"));\\n\\n    let mut read = World::campaign(1, Route::Read);\\n    read.present_ending();\\n    read.tick(&InputFrame::default(), DT);\\n780→    read.tick(&act(4), DT);\\n    assert_eq!(read.focus, 1);\\n    read.tick(&act(1), DT);\\n    assert_eq!(read.finale, Some(1));\\n    assert!(read.bodies.iter().any(|b| b.alive && b.kind == 1));\\n    assert!(!read.flags.contains(\\\"ending_read\\\"));\\n    run(&mut read, &hold(buttons::CROUCH), 2.0);\\n    assert!(!read.flags.contains(\\\"ending_read\\\"));\\n}\\n\\n790→#[test]\\nfn dev_menu_teleports_spawns_and_noclip_flies() {\\n    let mut w = World::fresh(1);\\n    w.tick(&act(10), DT);\\n    assert_eq!(w.screen, Screen::Pause);\\n    for _ in 0..3 {\\n        w.tick(&act(4), DT);\\n    }\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.screen, Screen::Dev);\\n800→    assert_eq!(w.tab, 0);\\n    w.tick(&act(4), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 2, \\\"rows {:?}\\\", w.rows());\\n    w.tick(&act(1), DT);\\n    assert!((w.x + 120.0).abs() < 0.1 && (w.z - 900.0).abs() < 0.1, \\\"teleport ({}, {})\\\", w.x, w.z);\\n\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.tab, 0);\\n    w.tick(&act(4), DT);\\n810→    w.tick(&act(4), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 3);\\n    let before = w.bodies.len();\\n    w.tick(&act(1), DT);\\n    assert!(w.bodies.len() > before, \\\"spawn did not add a body\\\");\\n    assert!(w.bodies.iter().any(|b| b.kind == 1));\\n\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.tab, 0);\\n820→    for _ in 0..3 {\\n        w.tick(&act(4), DT);\\n    }\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 4);\\n    w.tick(&act(1), DT);\\n    assert!(w.hour() > 20.0, \\\"hour {}\\\", w.hour());\\n\\n    w.tick(&act(2), DT);\\n    w.tick(&act(1), DT);\\n830→    assert_eq!(w.tab, 1);\\n    for _ in 0..4 {\\n        w.tick(&act(4), DT);\\n    }\\n    assert_eq!(w.rows().get(w.focus).map(String::as_str), Some(\\\"Noclip\\\"));\\n    w.tick(&act(1), DT);\\n    assert!(w.dev.noclip);\\n\\n    w.tick(&act(2), DT);\\n    w.tick(&act(2), DT);\\n840→    assert_eq!(w.screen, Screen::Pause, \\\"focus {} rows {:?}\\\", w.focus, w.rows());\\n    assert_eq!(w.rows().get(w.focus).map(String::as_str), Some(\\\"Resume\\\"));\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.screen, Screen::Playing);\\n\\n    w.ride.kind = 1;\\n    w.ride.seat = 1;\\n    w.ride.x = w.x;\\n    w.ride.z = w.z;\\n    let x0 = w.x;\\n850→    let z0 = w.z;\\n    let eye0 = w.eye;\\n    let mut fly = InputFrame::default();\\n    fly.move_dir.y = 1.0;\\n    fly.look.y = 1.0;\\n    run(&mut w, &fly, 0.5);\\n    let moved = ((w.x - x0).powi(2) + (w.z - z0).powi(2)).sqrt();\\n    assert!(moved > 2.0, \\\"noclip moved {moved:.2} from ({x0:.1},{z0:.1}) to ({:.1},{:.1})\\\", w.x, w.z);\\n    assert!(w.eye > eye0 + 2.0, \\\"eye {} from {eye0}\\\", w.eye);\\n}\\n860→\\nconst COVERAGE: &[&str] = &[\\n    \\\"map_raised\\\", \\\"waypoint_set\\\", \\\"gps_followed\\\", \\\"monocular_tag\\\", \\\"wind_rag\\\", \\\"jam_cleared\\\", \\\"enemy_jam\\\", \\\"weapon_broke\\\",\\n    \\\"weapon_bought\\\", \\\"locker_used\\\", \\\"syrette\\\", \\\"wound_gunshot\\\", \\\"wound_shrapnel\\\", \\\"wound_burn\\\", \\\"wound_fall\\\", \\\"wound_tourniquet\\\",\\n    \\\"wound_graze\\\", \\\"fever_warned\\\", \\\"pill_taken\\\", \\\"blackout\\\", \\\"player_rescued\\\", \\\"companion_patched\\\", \\\"companion_overdosed\\\",\\n    \\\"companion_died\\\", \\\"better_way\\\", \\\"ignite_flare\\\", \\\"ignite_rocket\\\", \\\"ignite_flamer\\\", \\\"ignite_mortar\\\", \\\"ignite_molotov\\\",\\n    \\\"ignite_frag\\\", \\\"ignite_barrel\\\", \\\"ignite_vehicle\\\", \\\"ignite_person\\\", \\\"ignite_lightning\\\", \\\"ignite_tracer\\\", \\\"ignite_cigarette\\\",\\n    \\\"cells_500\\\", \\\"enemy_panicked\\\", \\\"animals_fled\\\", \\\"explosion_chain\\\", \\\"rain_extinguished\\\", \\\"stealth_kill\\\", \\\"dart_kill\\\",\\n    \\\"night_contract\\\", \\\"sleep_used\\\", \\\"safe_house_claimed\\\", \\\"post_cleared\\\", \\\"post_remanned\\\", \\\"technical_driven\\\", \\\"mounted_gun\\\",\\n    \\\"repair_done\\\", \\\"boat_driven\\\", \\\"bus_taken\\\", \\\"tape_played\\\", \\\"cache_tracker\\\", \\\"diamonds_spent\\\", \\\"contract_a0\\\", \\\"contract_a1\\\",\\n870→    \\\"contract_b1\\\", \\\"contract_b2\\\", \\\"contract_b3\\\", \\\"contract_b4\\\", \\\"contract_c1\\\", \\\"contract_c2\\\", \\\"contract_c3\\\", \\\"contract_d1\\\",\\n    \\\"contract_d2\\\", \\\"ceasefire_ended\\\", \\\"town_burned\\\", \\\"ending_burn\\\", \\\"ending_read\\\", \\\"ending_chair\\\",\\n];\\n\\nfn play_route(route: Route, seed: u64) -> BTreeSet<String> {\\n    let mut w = World::campaign(seed, route);\\n    let mut goal = String::new();\\n    let mut stuck = 0.0f32;\\n    let cap = 60.0 * 900.0;\\n    let mut t = 0.0f32;\\n880→    while t < cap && !w.finished {\\n        let input = w.bot_input();\\n        let before = w.goal_name();\\n        w.tick(&input, DT);\\n        t += DT;\\n        let now = w.goal_name();\\n        if now != before {\\n            eprintln!(\\\"{route:?} seed {seed}: {before} -> {now} at ({:.0},{:.0}) t={t:.0}\\\", w.x, w.z);\\n            goal = now;\\n            stuck = 0.0;\\n890→        } else {\\n            stuck += DT;\\n            let budget = w.goal_budget();\\n            if stuck > budget && !w.finished {\\n                panic!(\\n                    \\\"{route:?} seed {seed} stuck on {now} for {stuck:.0}s (budget {budget:.0}) at ({:.1},{:.1}) step {} flags {}\\\",\\n                    w.x, w.z, w.step, w.flags.len()\\n                );\\n            }\\n        }\\n900→    }\\n    assert!(w.finished, \\\"{route:?} seed {seed} did not finish by {t:.0}s goal {} at ({:.0},{:.0})\\\", w.goal_name(), w.x, w.z);\\n    let end = match route {\\n        Route::Read => \\\"ending_read\\\",\\n        Route::Chair => \\\"ending_chair\\\",\\n        _ => \\\"ending_burn\\\",\\n    };\\n    assert!(w.flags.contains(end), \\\"{route:?} missing {end}\\\");\\n    w.flags\\n}\\n910→\\n#[test]\\nfn bot_plays_all_three_endings() {\\n    let mut union = BTreeSet::new();\\n    for seed in [1u64, 2] {\\n        let mut prefix_a = World::campaign(seed, Route::Human);\\n        let mut prefix_b = World::campaign(seed, Route::Human);\\n        for _ in 0..40 {\\n            let a = prefix_a.bot_input();\\n            let b = prefix_b.bot_input();\\n920→            prefix_a.tick(&a, DT);\\n            prefix_b.tick(&b, DT);\\n        }\\n        assert_eq!(prefix_a.fingerprint(), prefix_b.fingerprint());\\n        for route in [Route::Human, Route::Read, Route::Chair] {\\n            union.extend(play_route(route, seed));\\n        }\\n    }\\n    let missing: Vec<_> = COVERAGE.iter().copied().filter(|f| !union.contains(*f)).collect();\\n    assert!(missing.is_empty(), \\\"coverage missing {missing:?}\\\");\\n930→}\\n\",\"content_concise\":\"681→fn act(n: u32) -> InputFrame {\\n    let mut f = InputFrame::default();\\n    f.act = n;\\n    f\\n}\\n\\n#[test]\\nfn first_person_eye_tracks_the_body() {\\n    let _cam = camera_lock();\\n690→    let mut sim = Sim::new(Merc::KEY, 1).unwrap();\\n    for bit in [buttons::CONFIRM, buttons::JUMP, buttons::CONFIRM, buttons::JUMP] {\\n        sim.step(&press(bit));\\n    }\\n    let (eye0, screen) = {\\n        let merc = sim.play().unwrap().get::<Merc>().unwrap();\\n        (merc.world.eye_pos(), merc.world.screen)\\n    };\\n    assert_eq!(screen, Screen::Playing);\\n    let cam = merc::overlook();\\n700→    assert!((cam.eye[0] - eye0.0).abs() < 0.25 && (cam.eye[1] - eye0.1).abs() < 0.25 && (cam.eye[2] - eye0.2).abs() < 0.25, \\\"cam {:?} eye {:?}\\\", cam.eye, eye0);\\n\\n    let mut f = InputFrame::default();\\n    f.move_dir.y = 1.0;\\n    for _ in 0..90 {\\n        sim.step(&f);\\n    }\\n    let eye1 = sim.play().unwrap().get::<Merc>().unwrap().world.eye_pos();\\n    let cam = merc::overlook();\\n    assert!((cam.eye[0] - eye1.0).abs() < 0.3 && (cam.eye[2] - eye1.2).abs() < 0.3, \\\"cam {:?} eye {:?}\\\", cam.eye, eye1);\\n710→    assert!((eye1.0 - eye0.0).abs() + (eye1.2 - eye0.2).abs() > 1.0, \\\"eye did not move {eye0:?} -> {eye1:?}\\\");\\n\\n    let mut c = InputFrame::default();\\n    c.held = buttons::CROUCH;\\n    for _ in 0..40 {\\n        sim.step(&c);\\n    }\\n    let eye_c = sim.play().unwrap().get::<Merc>().unwrap().world.eye_pos();\\n    let cam = merc::overlook();\\n    assert!(eye_c.1 < eye1.1 - 0.3, \\\"crouch {} stand {}\\\", eye_c.1, eye1.1);\\n720→    assert!((cam.eye[1] - eye_c.1).abs() < 0.25, \\\"cam y {} eye {}\\\", cam.eye[1], eye_c.1);\\n\\n    let rifle = sim.state.entities.map.values().find(|e| e.name == \\\"fp-rifle\\\").expect(\\\"rifle prop\\\");\\n    let dx = rifle.pos.x - cam.eye[0];\\n    let dy = rifle.pos.y - cam.eye[1];\\n    let dz = rifle.pos.z - cam.eye[2];\\n    let dist = (dx * dx + dy * dy + dz * dz).sqrt();\\n    assert!(dist > 0.15 && dist < 1.2, \\\"rifle dist {dist}\\\");\\n    let rag = sim.state.entities.map.values().find(|e| e.name == \\\"fp-rag\\\").expect(\\\"rag prop\\\");\\n    let rdx = rag.pos.x - cam.eye[0];\\n730→    let rdy = rag.pos.y - cam.eye[1];\\n    let rdz = rag.pos.z - cam.eye[2];\\n    let rdist = (rdx * rdx + rdy * rdy + rdz * rdz).sqrt();\\n    assert!(rdist > 0.15 && rdist < 1.6, \\\"rag dist {rdist}\\\");\\n    let near_country = sim.state.entities.map.values().any(|e| {\\n        if e.name != \\\"country\\\" {\\n            return false;\\n        }\\n        let dx = e.pos.x - eye_c.0;\\n        let dz = e.pos.z - eye_c.2;\\n740→        dx * dx + dz * dz < 12.0 * 12.0\\n    });\\n    assert!(near_country, \\\"country patch is not under the eye\\\");\\n}\\n\\n#[test]\\nfn ledger_confirm_earns_the_chosen_ending() {\\n    let mut burn = World::campaign(1, Route::Human);\\n    burn.present_ending();\\n    burn.tick(&InputFrame::default(), DT);\\n750→    assert_eq!(burn.screen, Screen::Ledger);\\n    assert!(!burn.flags.contains(\\\"ending_burn\\\"));\\n    burn.tick(&act(1), DT);\\n    assert_eq!(burn.screen, Screen::Playing);\\n    assert_eq!(burn.finale, Some(0));\\n    assert!(!burn.flags.contains(\\\"ending_burn\\\"));\\n    let mut t = 0.0f32;\\n    while !burn.flags.contains(\\\"ending_burn\\\") && t < 8.0 {\\n        let input = burn.bot_input();\\n        burn.tick(&input, DT);\\n760→        t += DT;\\n    }\\n    assert!(burn.flags.contains(\\\"ending_burn\\\"), \\\"burn flag missing after {t:.1}s\\\");\\n\\n    let mut chair = World::campaign(1, Route::Chair);\\n    chair.present_ending();\\n    chair.tick(&InputFrame::default(), DT);\\n    assert_eq!(chair.screen, Screen::Ledger);\\n    chair.tick(&act(4), DT);\\n    chair.tick(&act(4), DT);\\n770→    assert_eq!(chair.focus, 2);\\n    chair.tick(&act(1), DT);\\n    assert_eq!(chair.finale, Some(2));\\n    assert!(!chair.flags.contains(\\\"ending_chair\\\"));\\n    chair.tick(&press(buttons::INTERACT), DT);\\n    assert!(chair.flags.contains(\\\"ending_chair\\\"));\\n\\n    let mut read = World::campaign(1, Route::Read);\\n    read.present_ending();\\n    read.tick(&InputFrame::default(), DT);\\n780→    read.tick(&act(4), DT);\\n    assert_eq!(read.focus, 1);\\n    read.tick(&act(1), DT);\\n    assert_eq!(read.finale, Some(1));\\n    assert!(read.bodies.iter().any(|b| b.alive && b.kind == 1));\\n    assert!(!read.flags.contains(\\\"ending_read\\\"));\\n    run(&mut read, &hold(buttons::CROUCH), 2.0);\\n    assert!(!read.flags.contains(\\\"ending_read\\\"));\\n}\\n\\n790→#[test]\\nfn dev_menu_teleports_spawns_and_noclip_flies() {\\n    let mut w = World::fresh(1);\\n    w.tick(&act(10), DT);\\n    assert_eq!(w.screen, Screen::Pause);\\n    for _ in 0..3 {\\n        w.tick(&act(4), DT);\\n    }\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.screen, Screen::Dev);\\n800→    assert_eq!(w.tab, 0);\\n    w.tick(&act(4), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 2, \\\"rows {:?}\\\", w.rows());\\n    w.tick(&act(1), DT);\\n    assert!((w.x + 120.0).abs() < 0.1 && (w.z - 900.0).abs() < 0.1, \\\"teleport ({}, {})\\\", w.x, w.z);\\n\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.tab, 0);\\n    w.tick(&act(4), DT);\\n810→    w.tick(&act(4), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 3);\\n    let before = w.bodies.len();\\n    w.tick(&act(1), DT);\\n    assert!(w.bodies.len() > before, \\\"spawn did not add a body\\\");\\n    assert!(w.bodies.iter().any(|b| b.kind == 1));\\n\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.tab, 0);\\n820→    for _ in 0..3 {\\n        w.tick(&act(4), DT);\\n    }\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 4);\\n    w.tick(&act(1), DT);\\n    assert!(w.hour() > 20.0, \\\"hour {}\\\", w.hour());\\n\\n    w.tick(&act(2), DT);\\n    w.tick(&act(1), DT);\\n830→    assert_eq!(w.tab, 1);\\n    for _ in 0..4 {\\n        w.tick(&act(4), DT);\\n    }\\n    assert_eq!(w.rows().get(w.focus).map(String::as_str), Some(\\\"Noclip\\\"));\\n    w.tick(&act(1), DT);\\n    assert!(w.dev.noclip);\\n\\n    w.tick(&act(2), DT);\\n    w.tick(&act(2), DT);\\n840→    assert_eq!(w.screen, Screen::Pause, \\\"focus {} rows {:?}\\\", w.focus, w.rows());\\n    assert_eq!(w.rows().get(w.focus).map(String::as_str), Some(\\\"Resume\\\"));\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.screen, Screen::Playing);\\n\\n    w.ride.kind = 1;\\n    w.ride.seat = 1;\\n    w.ride.x = w.x;\\n    w.ride.z = w.z;\\n    let x0 = w.x;\\n850→    let z0 = w.z;\\n    let eye0 = w.eye;\\n    let mut fly = InputFrame::default();\\n    fly.move_dir.y = 1.0;\\n    fly.look.y = 1.0;\\n    run(&mut w, &fly, 0.5);\\n    let moved = ((w.x - x0).powi(2) + (w.z - z0).powi(2)).sqrt();\\n    assert!(moved > 2.0, \\\"noclip moved {moved:.