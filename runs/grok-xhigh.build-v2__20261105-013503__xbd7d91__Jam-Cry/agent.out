eserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Pull {\\n    Waiting,\\n    Dry,\\n    Jammed,\\n    Fired,\\n    Broke,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Gun {\\n    pub id: WeaponId,\\n    pub condition: f32,\\n    pub wear: f32,\\n    pub jammed: bool,\\n    pub broken: bool,\\n    pub ammo: u32,\\n    pub reserve: u32,\\n    pub cooldown: f32,\\n    pub clear_left: f32,\\n    pub slapped: bool,\\n\",\"total_lines\":191}}","is_error":false},{"type":"tool_result","tool_use_id":"call-0095ffaa-c7b9-4888-95de-73ed7404df81-21","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Game objects. An entity is one \\\"fat\\\" struct with optional parts, which keeps it cloneable\\n//! (for snapshots), serializable (for agents) and easy to extend: add a field.\\n\\nuse std::collections::{BTreeMap, VecDeque};\\n\\nuse glam::{Quat, Vec3};\\nuse rapier::prelude::*;\\nuse serde::{Deserialize, Serialize};\\n\\n10→use crate::character::Character;\\nuse crate::shape::Visual;\\nuse crate::statics::RegionKey;\\n\\n/// Physical surface properties (kept so sleeping entities can be recreated).\\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\\npub struct Material {\\n    pub density: f32,\\n    pub friction: f32,\\n    pub restitution: f32,\\n20→    /// Linear and angular damping (air drag): calms chains and bridges.\\n    #[serde(default)]\\n    pub damping: f32,\\n}\\n\\nimpl Default for Material {\\n    fn default() -> Self {\\n        Self { density: 1.0, friction: 0.5, restitution: 0.0, damping: 0.0 }\\n    }\\n}\\n30→\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]\\npub struct EntityId(pub u32);\\n\\n/// Simple scripted behaviours usable from scenes and room files.\\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\\n#[serde(tag = \\\"type\\\", rename_all = \\\"snake_case\\\")]\\npub enum Behavior {\\n    #[default]\\n    None,\\n40→    /// Drops random props over an area, keeping at most `max` alive.\\n    Rain {\\n        interval: u32,\\n        max: u32,\\n        area: f32,\\n        height: f32,\\n        #[serde(default)]\\n        timer: u32,\\n        #[serde(default)]\\n        spawned: VecDeque<EntityId>,\\n50→    },\\n    /// Kinematic rotation about Y (radians per second).\\n    Spin { speed: f32 },\\n    /// Moves back and forth along `offset` (kinematic bodies: platforms, doors, crushers).\\n    Move(MoverDef),\\n    /// Turns about an axis, continuously or swinging (sweepers, pendulums, windmills).\\n    Rotate(RotatorDef),\\n    /// Fires projectiles in patterns (dodge gauntlet, bullet hell).\\n    Emitter(EmitterDef),\\n    /// Drops props: on a timer and/or when a pad sends its signal (physics stress tests).\\n60→    Spawner(SpawnerDef),\\n    /// Lays out a page of the store's object rows when a pad sends its signal (the Catalogue\\n    /// room; `crate::catalogue`).\\n    Catalogue(crate::catalogue::CatalogueDef),\\n    /// Steps a cast of performers through the clip library when pads send its signals (the\\n    /// Clip Browser room; `crate::clip_browser`).\\n    ClipBrowser(crate::clip_browser::ClipBrowserDef),\\n}\\n\\n/// Spawns props around itself.\\n70→#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\\n#[serde(default)]\\npub struct SpawnerDef {\\n    pub shape: crate::shape::Shape,\\n    /// Colour, or \\\"\\\" for a random bright colour per prop.\\n    pub color: String,\\n    pub look: crate::shape::Look,\\n    pub density: f32,\\n    pub friction: f32,\\n    pub restitution: f32,\\n80→    /// Seconds between automatic drops (0 = only on signals).\",\"content_concise\":\"1→//! Game objects. An entity is one \\\"fat\\\" struct with optional parts, which keeps it cloneable\\n//! (for snapshots), serializable (for agents) and easy to extend: add a field.\\n\\nuse std::collections::{BTreeMap, VecDeque};\\n\\nuse glam::{Quat, Vec3};\\nuse rapier::prelude::*;\\nuse serde::{Deserialize, Serialize};\\n\\n10→use crate::character::Character;\\nuse crate::shape::Visual;\\nuse crate::statics::RegionKey;\\n\\n/// Physical surface properties (kept so sleeping entities can be recreated).\\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\\npub struct Material {\\n    pub density: f32,\\n    pub friction: f32,\\n    pub restitution: f32,\\n20→    /// Linear and angular damping (air drag): calms chains and bridges.\\n    #[serde(default)]\\n    pub damping: f32,\\n}\\n\\nimpl Default for Material {\\n    fn default() -> Self {\\n        Self { density: 1.0, friction: 0.5, restitution: 0.0, damping: 0.0 }\\n    }\\n}\\n30→\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]\\npub struct EntityId(pub u32);\\n\\n/// Simple scripted behaviours usable from scenes and room files.\\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\\n#[serde(tag = \\\"type\\\", rename_all = \\\"snake_case\\\")]\\npub enum Behavior {\\n    #[default]\\n    None,\\n40→    /// Drops random props over an area, keeping at most `max` alive.\\n    Rain {\\n        interval: u32,\\n        max: u32,\\n        area: f32,\\n        height: f32,\\n        #[serde(default)]\\n        timer: u32,\\n        #[serde(