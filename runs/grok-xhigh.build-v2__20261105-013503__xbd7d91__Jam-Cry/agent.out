  }\\n    }\\n\\n    fn advance_script(&mut self, dt: f32) {\\n760→        if self.finished {\\n            return;\\n        }\\n        self.step_t += dt;\\n        for _ in 0..12 {\\n            let Some(spec) = self.current() else {\\n                self.finished = true;\\n                break;\\n            };\\n            if !self.step_ready {\\n770→                self.begin(spec);\\n                self.step_ready = true;\\n                self.step_t = 0.0;\\n            }\\n            if self.done(spec) {\\n                self.step += 1;\\n                self.step_ready = false;\\n                self.step_t = 0.0;\\n            } else {\\n                break;\\n780→            }\\n        }\\n    }\\n\\n    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n        self.step_z = self.z;\\n        self.step_yaw = self.yaw;\\n        self.hold_t = 0.0;\\n        match spec {\\n790→            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n800→                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n810→                let g = self.gun_mut();\\n                g.force_jam = true;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n            }\\n            Spec::Break => {\\n       