      // Two in-game days. One real second is one in-game minute, so 48 hours = 2880 minutes.\\n                c.burnt_until = minutes + 48.0 * 60.0;\\n                c.life = 0.0;\\n            }\\n        }\\n        self.cells.retain(|_, c| c.burning || minutes < c.burnt_until);\\n        extinguished\\n110→    }\\n\\n    fn spread_once(&mut self, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(0.0, -1.0) };\\n        let burning: Vec<(i32, i32)> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n        if burning.is_empty() {\\n            return;\\n        }\\n        // Age the flames.\\n120→        for k in &burning {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/fire.rs\",\"offset\":1,\"limit\":120,\"raw_output\":\"//! Sparse 2 m fire grid. Spread is a wind-biased front: each tick the downwind tip and the\\n//! upwind tip each get one roll of `spread * fuel * dryness * exp(k * dot * speed) * dt`.\\n\\nuse std::collections::BTreeMap;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::geom::{self, cell_center, cell_of};\\nuse crate::rng::Rng;\\n\\npub const FIRE_K: f32 = 0.10;\\npub const FIRE_DT: f32 = 0.25;\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Cell {\\n    pub burning: bool,\\n    pub life: f32,\\n    pub burnt_until: f32,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct FireMap {\\n    pub cells: BTreeMap<(i32, i32), Cell>,\\n    pub acc: f32,\\n    pub burned: u32,\\n    pub wind_for_test: Vec2,\\n}\\n\\nimpl Default for FireMap {\\n    fn default() -> Self {\\n        Self { cells: BTreeMap::new(), acc: 0.0, burned: 0, wind_for_test: Vec2::ZERO }\\n    }\\n}\\n\\nimpl FireMap {\\n    pub fn burning_count(&self) -> usize {\\n        self.cells.values().filter(|c| c.burning).count()\\n    }\\n\\n    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        self.ignite_cell(cell_of(x, z), life, minutes)\\n    }\\n\\n    pub fn ignite_cell(&mut self, c: (i32, i32), life: f32, minutes: f32) -> bool {\\n        let (x, z) = cell_center(c);\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        if let Some(cell) = self.cells.get(&c) {\\n            if cell.burning {\\n                return false;\\n            }\\n            if minutes < cell.burnt_until {\\n                return false;\\n            }\\n        }\\n        self.cells.insert(c, Cell { burning: true, life, burnt_until: 0.0 });\\n        self.burned += 1;\\n        true\\n    }\\n\\n    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\\n        let r = radius.ceil() as i32 + 1;\\n        let (cx, cz) = cell_of(x, z);\\n        let mut n = 0;\\n        for iz in (cz - r)..=(cz + r) {\\n            for ix in (cx - r)..=(cx + r) {\\n                let (px, pz) = cell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n\\n    /// Step the grid. Returns cells extinguished by rain.\\n    pub fn tick(&mut self, dt: f32, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rain: bool, rng: &mut Rng) -> u32 {\\n        self.wind_for_test = wind;\\n        self.acc += dt;\\n        let mut extinguished = 0;\\n        if rain {\\n            let keys: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n            for k in keys {\\n                self.cells.remove(&k);\\n                extinguished += 1;\\n            }\\n            self.acc = 0.0;\\n            return extinguished;\\n        }\\n        while self.acc >= FIRE_DT {\\n            self.acc -= FIRE_DT;\\n            self.spread_once(wind, spread, burn_time, minutes, rng);\\n        }\\n        let done: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning && c.life <= 0.0).map(|(k, _)| *k).collect();\\n        for k in done {\\n            if let Some(c) = self.cells.get_mut(&k) {\\n                c.burning = false;\\n                // Two in-game days. One real second is one in-game minute, so 48 hours = 2880 minutes.\\n                c.burnt_until = minutes + 48.0 * 60.0;\\n                c.life = 0.0;\\n            }\\n        }\\n        self.cells.retain(|_, c| c.burning || minutes < c.burnt_until);\\n        extinguished\\n    }\\n\\n    fn spread_once(&mut self, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(0.0, -1.0) };\\n        let burning: Vec<(i32, i32)> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n        if burning.is_empty() {\\n            return;\\n        }\\n        // Age the flames.\\n        for k in &burning {\\n\",\"total_lines\":192}}","is_error":false},{"type":"tool_result","tool_use_id":"call-16f5892a-ac1b-423a-903e-cb2a73cb9d1f-17","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"380→    assert!(!w.flags.contains(\\\"post_remanned\\\"), \\\"looking at the post holds it\\\");\\n    w.yaw = std::f32::consts::PI;\\n    w.tick(&InputFrame::default(), DT);\\n    assert!(w.flags.contains(\\\"post_remanned\\\"));\\n}\\n\\n#[test]\\nfn fever_pills_blackout_and_healing() {\\n    let mut w = World::fresh(1);\\n    w.fever_t = w.tune.fever_interval;\\n390→    w.tick(&InputFrame::default(), DT);\\n    assert!(w.flags.contains(\\\"fever_warned\\\") && w.fever_state == 1);\\n    run(&mut w, &hold(buttons::PILLS), 3.0);\\n    assert!(w.flags.contains(\\\"pill_taken\\\") && w.fever_state == 0);\\n    assert_eq!(w.pills, 2);\\n\\n    let mut w = World::fresh(2);\\n    w.pills = 0;\\n    w.fever_state = 2;\\n    w.fever_attack = 59.0;\\n400→    w.diamonds = 40;\\n    w.x = 200.0;\\n    w.z = -200.0;\\n    run(&mut w, &InputFrame::default(), 2.0);\\n    assert!(w.flags.contains(\\\"blackout\\\"));\\n    assert!(w.hp >= 50.0 && w.hp < 70.0, \\\"woke at 50 and started to recover, hp {}\\\", w.hp);\\n    assert_eq!(w.diamonds, 32);\\n    let safe = geom::nearest_safe(200.0, -200.0);\\n    assert!(geom::dist(w.x, w.z, safe.0, safe.1) < 1.0);\\n\\n410→    let mut w = World::fresh(3);\\n    w.hp = 40.0;\\n    w.tick(&press(buttons::HEAL), DT);\\n    run(&mut w, &InputFrame::default(), 2.0);\\n    assert!(w.flags.contains(\\\"syrette\\\"));\\n    assert!(w.hp > 90.0, \\\"hp {}\\\", w.hp);\\n\\n    let mut w = World::fresh(4);\\n    w.hp = 15.0;\\n    w.wound = 1;\\n420→    run(&mut w, &hold(buttons::HEAL), 4.2);\\n    assert!(w.flags.contains(\\\"wound_gunshot\\\"));\\n    assert!(w.hp >= 40.0 && w.hp < 50.0, \\\"treated to 40 then recovered, hp {}\\\", w.hp);\\n\\n    let mut w = World::fresh(5);\\n    w.hp = 0.0;\\n    run(&mut w, &InputFrame::default(), 4.0);\\n    assert!(w.flags.contains(\\\"player_rescued\\\") && w.hp >= 50.0);\\n    assert!(w.companions.iter().any(|c| c.rescue_spent));\\n    let blob = w.save_json();\\n430→    w.hp = 0.0;\\n    run(&mut w, &InputFrame::default(), 4.0);\\n    assert!(w.hp < 5.0, \\\"a second rescue waits until sleep, hp {}\\\", w.hp);\\n    let loaded = World::load_json(&blob).unwrap();\\n    assert!(loaded.flags.contains(\\\"player_rescued\\\"));\\n    assert!(loaded.companions.iter().any(|c| c.rescue_spent));\\n}\\n\\n#[test]\\nfn vehicles_climb_break_and_float() {\\n440→    let mut w = World::fresh(1);\\n    w.ride.kind = 1;\\n    w.ride.seat = 1;\\n    w.ride.x = 200.0;\\n    w.ride.z = -520.0;\\n    w.x = 200.0;\\n    w.z = -520.0;\\n    w.ride.health = 100.0;\\n    let mut drive = InputFrame::default();\\n    drive.axes.y = 1.0;\\n450→    drive.axes.x = 0.0;\\n    w.ride.yaw = std::f32::consts::FRAC_PI_2;\\n    run(&mut w, &drive, 2.0);\\n    assert!(w.ride.pitch > 0.01, \\\"pitch {}\\\", w.ride.pitch);\\n    assert!(w.flags.contains(\\\"technical_driven\\\"));\\n    w.ride.roll = 0.3;\\n    w.tick(&drive, DT);\\n    assert!(w.ride.roll < 0.3);\\n\\n    w.ride.health = 100.0;\\n460→    w.ride.stage = 0;\\n    w.hurt_vehicle(50.0);\\n    assert!(w.ride.stage >= 1, \\\"stage {}\\\", w.ride.stage);\\n    w.hurt_vehicle(40.0);\\n    assert_eq!(w.ride.stage, 3, \\\"health {}\\\", w.ride.health);\\n    run(&mut w, &drive, 9.0);\\n    assert!(w.flags.contains(\\\"ignite_vehicle\\\") || w.ride.stage == 4);\\n\\n    let mut w = World::fresh(2);\\n    w.ride.kind = 1;\\n470→    w.ride.seat = 0;\\n    w.ride.health = 30.0;\\n    w.ride.stage = 2;\\n    w.ride.x = w.x;\\n    w.ride.z = w.z;\\n    run(&mut w, &hold(buttons::INTERACT), 6.5);\\n    assert!(w.flags.contains(\\\"repair_done\\\"));\\n    assert!(w.ride.health >= 70.0);\\n\\n    let mut dry = World::fresh(3);\\n480→    dry.ride.kind = 2;\\n    dry.ride.seat = 1;\\n    dry.ride.x = 200.0;\\n    dry.ride.z = -200.0;\\n    dry.x = 200.0;\\n    dry.z = -200.0;\\n    assert!(!geom::deep_water(200.0, -200.0));\\n    let mut throttle = InputFrame::default();\\n    throttle.axes.y = 1.0;\\n    run(&mut dry, &throttle, 1.0);\\n490→    assert!(dry.ride.speed.abs() < 0.2, \\\"boat on grass {}\\\", dry.ride.speed);\\n\\n    let (wx, wz) = geom::nearest_water(0.0, 0.0);\\n    let mut wet = World::fresh(4);\\n    wet.ride.kind = 2;\\n    wet.ride.seat = 1;\\n    wet.ride.x = wx;\\n    wet.ride.z = wz;\\n    wet.x = wx;\\n    wet.z = wz;\",\"content_concise\":\"380→    assert!(!w.flags.contains(\\\"post_remanned\\\"), \\\"looking at the post holds it\\\");\\n    w.yaw = std::f32::consts::PI;\\n    w.tick(&InputFrame::default(), DT);\\n    assert!(w.flags.contains(\\\"post_remanned\\\"));\\n}\\n\\n#[test]\\nfn fever_pills_blackout_and_healing() {\\n    let mut w = World::fresh(1);\\n    w.fever_t = w.tune.fever_interval;\\n390→    w.tick(&InputFrame::default(), DT);\\n    assert!(w.flags.contains(\\\"fever_warned\\\") && w.fever_state == 1);\\n    run(&mut w, &hold(buttons::PILLS), 3.0);\\n    assert!(w.flags.contains(\\\"pill_taken\\\") && w.fever_state == 0);\\n    assert_eq!(w.pills, 2);\\n\\n    let mut w = World::fresh(2);\\n    w.pills = 0;\\n    w.fever_state = 2;\\n    w.fever_attack = 59.0;\\n400→    w.diamonds = 40;\\n    w.x = 200.0;\\n    w.z = -200.0;\\n    run(&mut w, &InputFrame::default(), 2.0);\\n    assert!(w.flags.contains(\\\"blackout\\\"));\\n    assert!(w.hp >= 50.0 && w.hp < 70.0, \\\"woke at 50 and started to recover, hp {}\\\", w.hp);\\n    assert_eq!(w.diamonds, 32);\\n    let safe = geom::nearest_safe(200.0, -200.0);\\n    assert!(geom::dist(w.x, w.z, safe.0, safe.1) < 1.0);\\n\\n410→    let mut w = World::fresh(3);\\n    w.hp = 40.0;\\n    w.tick(&press(buttons::HEAL), DT);\\n    run(&mut w, &InputFrame::default(), 2.0);\\n    assert!(w.flags.contains(\\\"syrette\\\"));\\n    assert!(w.hp > 90.0, \\\"hp {}\\\", w.hp);\\n\\n    let mut w = World::fresh(4);\\n    w.hp = 15.0;\\n    w.wound = 1;\\n420→    run(&mut w, &hold(buttons::HEAL), 4.2);\\n    assert!(w.flags.contains(\\\"wound_gunshot\\\"));\\n    assert!(w.hp >= 40.0 && w.hp < 50.0, \\\"treated to 40 then recovered, hp {}\\\", w.hp);\\n\\n    let mut w = World::fresh(5);\\n    w.hp = 0.0;\\n    run(&mut w, &InputFrame::default(), 4.0);\\n    assert!(w.flags.contains(\\\"player_rescued\\\") && w.hp >= 50.0);\\n    assert!(w.companions.iter().any(|c| c.rescue_spent));\\n    let blob = w.save_json();\\n430→    w.hp = 0.0;\\n    run(&mut w, &InputFrame::default(), 4.0);\\n    assert!(w.hp < 5.0, \\\"a second rescue waits until sleep, hp {}\\\", w.hp);\\n    let loaded = World::load_json(&blob).unwrap();\\n    assert!(loaded.flags.contains(\\\"player_rescued\\\"));\\n    assert!(loaded.companions.iter().any(|c| c.rescue_spent));\\n}\\n\\n#[test]\\nfn vehicles_climb_break_and_float() {\\n440→    let mut w = World::fresh(1);\\n    w.ride.kind = 1;\\n    w.ride.seat = 1;\\n    w.ride.x = 200.0;\\n    w.ride.z = -520.0;\\n    w.x = 200.0;\\n    w.z = -520.0;\\n    w.ride.health = 100.0;\\n    let mut drive = InputFrame::default();\\n    drive.axes.y = 1.0;\\n450→    drive.axes.x = 0.0;\\n    w.ride.yaw = std::f32::consts::FRAC_PI_2;\\n    run(&mut w, &drive, 2.0);\\n    assert!(w.ride.pitch > 0.01, \\\"pitch {}\\\", w.ride.pitch);\\n    assert!(w.flags.contains(\\\"technical_driven\\\"));\\n    w.ride.roll = 0.3;\\n    w.tick(&drive, DT);\\n    assert!(w.ride.roll < 0.3);\\n\\n    w.ride.health = 100.0;\\n460→    w.ride.stage = 0;\\n    w.hurt_vehicle(50.0);\\n    assert!(w.ride.stage >= 1, \\\"stage {}\\\", w.ride.stage);\\n    w.hurt_vehicle(40.0);\\n    assert_eq!(w.ride.stage, 3, \\\"health {}\\\", w.ride.health);\\n    run(&mut w, &drive, 9.0);\\n    assert!(w.flags.contains(\\\"ignite_vehicle\\\") || w.ride.stage == 4);\\n\\n    let mut w = World::fresh(2);\\n    w.ride.kind = 1;\\n470→    w.ride.seat = 0;\\n    w.ride.health = 30.0;\\n    w.ride.stage = 2;\\n    w.ride.x = w.x;\\n    w.ride.z = w.z;\\n    run(&mut w, &hold(buttons::INTERACT), 6.5);\\n    assert!(w.flags.contains(\\\"repair_done\\\"));\\n    assert!(w.ride.health >= 70.0);\\n\\n    let mut dry = World::fresh(3);\\n480→    dry.ride.kind = 2;\\n    dry.ride.seat = 1;\\n    dry.ride.x = 200.0;\\n    dry.ride.z = -200.0;\\n    dry.x = 200.0;\\n    dry.z = -200.0;\\n    assert!(!geom::deep_water(200.0, -200.0));\\n    let mut throttle = InputFrame::default();\\n    throttle.axes.y = 1.0;\\n    run(&mut dry, &throttle, 1.0);\\n490→    assert!(dry.ride.speed.abs() < 0.2, \\\"boat on grass {}\\\", dry.ride.speed);\\n\\n    let (wx, wz) = geom::nearest_water(0.0, 0.0);\\n    let mut wet = World::fresh(4);\\n    wet.ride.kind = 2;\\n    wet.ride.se