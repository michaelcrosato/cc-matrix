,\\n    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"edits\":{\"details\":[{\"o