een::Attract => vec![\\\"Press any button\\\".into()],\\n            Screen::Playing => vec![],\\n        };\\n        all.into_iter().take(7).collect()\\n    }\\n\\n    fn settings_rows(&self) -> Vec<String> {\\n        match self.tab % 4 {\\n            0 => vec![\\\"Master\\\".into(), \\\"Music\\\".into(), \\\"Effects\\\".into(), \\\"Voices\\\".into(), \\\"Page\\\".into()],\\n            1 => vec![\\\"PlayStation glyphs\\\".into(), \\\"Xbox glyphs\\\".into(), \\\"Invert look\\\".into(), \\\"Sensitivity\\\".into(), \\\"Aim assist\\\".into(), \\\"Page\\\".into()],\\n            2 => vec![\\\"Fullscreen\\\".into(), \\\"Field of view\\\".into(), \\\"Brightness\\\".into(), \\\"Head bob\\\".into(), \\\"Page\\\".into()],\\n            _ => vec![\\\"Subtitle size\\\".into(), \\\"Reduce motion\\\".into(), \\\"Assist markers\\\".into(), \\\"Immersive hud\\\".into(), \\\"Page\\\".into()],\\n        }\\n    }\\n\\n    fn dev_rows(&self) -> Vec<String> {\\n        match self.tab {\\n            0 => vec![\\\"Cheats\\\".into(), \\\"Teleport\\\".into(), \\\"Spawn\\\".into(), \\\"World\\\".into(), \\\"Balance\\\".into()],\\n            1 => {\\n                let names = [\\\"God mode\\\", \\\"Infinite ammo\\\", \\\"No jams\\\", \\\"No fever\\\", \\\"Noclip\\\", \\\"Invisible\\\", \\\"Show AI\\\", \\\"Show fire\\\", \\\"Show nav\\\", \\\"Show stats\\\"];\\n                self.page_of(&names)\\n            }\\n            2 => {\\n                let names: Vec<&str> = super::geom::PLACES.iter().map(|p| p.name).collect();\\n                self.page_of_owned(names)\\n            }\\n            3 => vec![\\\"Soldier\\\".into(), \\\"Animal\\\".into(), \\\"Truck\\\".into(), \\\"Technical\\\".into(), \\\"Boat\\\".into(), \\\"Barrel\\\".into()],\\n            4 => vec![\\n                \\\"Night\\\".into(),\\n                \\\"Noon\\\".into(),\\n                \\\"Rain\\\".into(),\\n                \\\"Clear sky\\\".into(),\\n                \\\"Strong wind\\\".into(),\\n                \\\"Calm\\\".into(),\\n                \\\"Ignite grass\\\".into(),\\n            ],\\n            5 => {\\n                let mut rows = Vec::new();\\n                let start = self.page * 6;\\n                for i in start..(start + 6).min(self.tune.count()) {\\n                    rows.push(format!(\\\"{} {:.2}\\\", self.tune.name(i), self.tune.get(i)));\\n\",\"total_lines\":464}}","is_error":false},{"type":"tool_result","tool_use_id":"call-3c85718d-3c1b-4d59-a062-9cc91e756398-7","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"850→            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\\n860→                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n                    self.ride.fuse = 0.0;\\n                }\\n            }\\n870→            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n            }\\n            Spec::Panic => {\\n                // An earlier scare does not finish this job. The soldier has to run from this fire.\\n880→                self.flags.remove(\\\"enemy_panicked\\\");\\n                self.clear_bodies();\\n                let sx = self.x + 4.0;\\n                let sz = self.z - 4.0;\\n                self.spawn_soldier(sx, sz, 40.0, false);\\n                // Runners sprint +x. One 2 m cell ends before flee passes 3.\\n                for i in 0..6 {\\n                    let _ = self.fire.ignite_disk(sx + i as f32 * 4.0, sz, 3.0, self.tune.burn_time, self.minutes);\\n                }\\n            }\\n890→            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n            }\\n            Spec::Sleep { .. } => {\\n                // The short rest already set this. The long rest has to happen on its own.\\n                self.flags.remove(\\\"sleep_used\\\");\\n900→            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                let (ax, az) = geom::water_ahead(wx, wz, 40.0);\\n                self.ride.kind = 2;\\n                self.ride.seat = 0;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.yaw = geom::yaw_toward(wx, wz, ax, az);\\n                self.ride.speed = 0.0;\\n910→                self.ride.health = 100.0;\\n                self.ride.stage = 0;\\n                self.ride.dist = 0.0;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n920→                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n930→            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n940→            }\\n            Spec::Rain => {\\n                // The boat step leaves you on the channel. Rain has to quench grass, not water.\\n                let mut lit = false;\\n                for r in [16.0, 22.0, 30.0, 40.0] {\\n                    for (dx, dz) in [(r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r)] {\\n                        if self.fire.ignite_at(self.x + dx, self.z + dz, self.tune.burn_time, self.minutes) {\\n                            lit = true;\\n                            break;\\n                        }\\n950→                    }\\n                    if lit {\\n                        break;\\n                    }\\n                }\\n                self.weather = 1;\\n            }\\n            Spec::Better => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n960→                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = self.x + 1.5;\\n                    c.z = self.z;\\n                }\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n970→                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n980→            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n990→            }\\n            Spec::Town => {\\n                self.arm(WeaponId::Molotov);\\n            }\\n            Spec::Ignite(n) => self.prep_ignite(n),\\n            Spec::Ending(_) => {\\n                self.finale = None;\\n                self.screen = Screen::Ledger;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n1000→            }\\n            Spec::Flag(s) => self.mark(s),\\n            _ => {}\\n        }\\n    }\\n\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n1010→            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n1020→            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n1030→            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n1040→            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n1050→            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n            Spec::Night => {\\n                if self.hour() > 20.0 && geom::dist(self.x, self.z, self.step_x, self.step_z) > 1.5 {\\n                    self.mark(\\\"night_contract\\\");\\n                }\\n                self.flags.contains(\\\"night_contract\\\")\\n1060→            }\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n1070→            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => {\\n                if self.town_burning() {\\n                    self.mark(\\\"town_burned\\\");\\n                }\\n                self.flags.contains(\\\"town_burned\\\")\\n            }\\n            Spec::Ending(_) => self.finale.is_some_and(|n| self.flags.contains(ending_flag(n))),\\n1080→            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n1090→            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape => {\\n                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n1100→            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n            Spec::Fight | Spec::Ceasefire | Spec::Convoy => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n1110→            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die => {}\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n1120→            }\\n            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n1130→            Spec::Sleep { .. } => {\\n                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n1140→                }\\n            }\\n            Spec::Drive { x, z } => {\\n                if self.ride.seat == 0 {\\n                    let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                    if self.ride.kind != 0 && d > 5.0 {\\n                        return self.bot_go(self.ride.x, self.ride.z, true);\\n                    }\\n                    f.pressed = buttons::USE;\\n                    return f;\\n1150→                }\\n                return self.bot_drive(x, z);\\n            }\\n            Spec::Bus { .. } => {\\n                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                    if self.ride.kind != 0 && d > 5.0 {\\n                        return self.bot_go(self.ride.x, self.ride.z, true);\\n                    }\\n1160→                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n1170→                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => return self.bot_ignite(k),\\n            Spec::Tanks => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n            }\\n            Spec::Mounted => {\\n                if self.ride.seat != 2 {\\n1180→                    if self.ride.seat == 0 {\\n                        let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                        if self.ride.kind != 0 && d > 5.0 {\\n                            return self.bot_go(self.ride.x, self.ride.z, true);\\n                        }\\n                    }\\n                    f.pressed = buttons::USE;\\n                }\\n                f.held = buttons::PRIMARY;\\n                f.pressed |= buttons::PRIMARY;\\n1190→            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => return self.bot_boat(),\\n            Spec::Night => {\\n                f.move_dir.y = 1.0;\\n                if self.stamina > 1.0 {\\n1200→                    f.held |= buttons::FOCUS;\\n                }\\n            }\\n            Spec::Town => return self.bot_town(),\\n            Spec::Ending(_) => return self.bot_ending(),\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n1210→                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Better | Spec::Flag(_) => {\\n                f.pressed = buttons::INTERACT;\\n1220→            }\\n            _ => {}\\n        }\\n        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n1230→        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n1240→\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        // The outboard stops dead once it leaves the deep channel, so turn before opening up.\\n        if self.ride.kind == 2 && err.abs() > 0.4 {\\n            f.axes.y = 0.05;\\n        } else {\",\"content_concise\":\"850→            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\\n860→                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n                    self.ride.fuse = 0.0;\\n                }\\n            }\\n870→            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n            }\\n            Spec::Panic => {\\n                // An earlier scare does not finish this job. The soldier has to run from this fire.\\n880→                self.flags.remove(\\\"enemy_panicked\\\");\\n                self.clear_bodies();\\n                let sx = self.x + 4.0;\\n                let sz = self.z - 4.0;\\n                self.spawn_soldier(sx, sz, 40.0, false);\\n                // Runners sprint +x. One 2 m cell ends before flee passes 3.\\n                for i in 0..6 {\\n                    let _ = self.fire.ignite_disk(sx + i as f32 * 4.0, sz, 3.0, self.tune.burn_time, self.minutes);\\n                }\\n            }\\n890→            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n            }\\n            Spec::Sleep { .. } => {\\n                // The short rest already set this. The long rest has to happen on its own.\\n                self.flags.remove(\\\"sleep_used\\\");\\n900→            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                let (ax, az) = geom::water_ahead(wx, wz, 40.0);\\n                self.ride.kind = 2;\\n                self.ride.seat = 0;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.yaw = geom::yaw_toward(wx, wz, ax, az);\\n                self.ride.speed = 0.0;\\n910→                self.ride.health = 100.0;\\n                self.ride.stage = 0;\\n                self.ride.dist = 0.0;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n920→                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n930→            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n940→            }\\n            Spec::Rain => {\\n                // The boat step leaves you on the channel. Rain has to quench grass, not water.\\n                let mut lit = false;\\n                for r in [16.0, 22.0, 30.0, 40.0] {\\n                    for (dx, dz) in [(r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r)] {\\n                        if self.fire.ignite_at(self.x + dx, self.z + dz, self.tune.burn_time, self.minutes) {\\n                            lit = true;\\n                            break;\\n                        }\\n950→                    }\\n                    if lit {\\n                        break;\\n                    }\\n                }\\n                self.weather = 1;\\n            }\\n            Spec::Better => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n960→                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = self.x + 1.5;\\n                    c.z = self.z;\\n                }\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n970→                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n980→            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n990→            }\\n            Spec::Town => {\\n                self.arm(WeaponId::Molotov);\\n            }\\n            Spec::Ignite(n) => self.prep_ignite(n),\\n            Spec::Ending(_) => {\\n                self.finale = None;\\n                self.screen = Screen::Ledger;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n1000→            }\\n            Spec::Flag(s) => self.mark(s),\\n            _ => {}\\n        }\\n    }\\n\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n1010→            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n1020→            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n1030→            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n1040→            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n1050→            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n            Spec::Night => {\\n                if self.hour() > 20.0 && geom::dist(self.x, self.z, self.step_x, self.step_z) > 1.5 {\\n                    self.mark(\\\"night_contract\\\");\\n                }\\n                self.flags.contains(\\\"night_contract\\\")\\n1060→            }\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n1070→            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => {\\n                if self.town_burning() {\\n                    self.mark(\\\"town_burned\\\");\\n                }\\n                self.flags.contains(\\\"town_burned\\\")\\n            }\\n            Spec::Ending(_) => self.finale.is_some_and(|n| self.flags.contains(ending_flag(n))),\\n1080→            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n1090→            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape => {\\n                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n1100→            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n            Spec::Fight | Spec::Ceasefire | Spec::Convoy => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n1110→            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die => {}\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n1120→            }\\n            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n1130→            Spec::Sleep { .. } => {\\n                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n1140→                }\\n            }\\n            Spec::Drive { x, z } => {\\n                if self.ride.seat == 0 {\\n                    let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                    if self.ride.kind != 0 && d > 5.0 {\\n                        return self.bot_go(self.ride.x, self.ride.z, true);\\n                    }\\n                    f.pressed = buttons::USE;\\n                    return f;\\n1150→                }\\n                return self.bot_drive(x, z);\\n            }\\n            Spec::Bus { .. } => {\\n                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                    if self.ride.kind != 0 && d > 5.0 {\\n                        return self.bot_go(self.ride.x, self.ride.z, true);\\n                    }\\n1160→                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n1170→                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => return self.bot_ignite(k),\\n            Spec::Tanks => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n            }\\n            Spec::Mounted => {\\n                if self.ride.seat != 2 {\\n1180→                    if self.ride.seat == 0 {\\n                        let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                        if self.ride.kind != 0 && d > 5.0 {\\n                            return self.bot_go(self.ride.x, self.ride.z, true);\\n                        }\\n                    }\\n                    f.pressed = buttons::USE;\\n                }\\n                f.held = buttons::PRIMARY;\\n                f.pressed |= buttons::PRIMARY;\\n1190→            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => return self.bot_boat(),\\n            Spec::Night => {\\n                f.move_dir.y = 1.0;\\n                if self.stamina > 1.0 {\\n1200→                    f.held |= buttons::FOCUS;\\n                }\\n            }\\n            Spec::Town => return self.bot_town(),\\n            Spec::Ending(_) => return self.bot_ending(),\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n1210→                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Better | Spec::Flag(_) => {\\n                f.pressed = buttons::INTERACT;\\n1220→            }\\n            _ => {}\\n        }\\n        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n1230→        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n1240→\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        // The outboard stops dead once it leaves the deep channel, so turn before opening up.\\n        if self.ride.kind == 2 && err.abs() > 0.4 {\\n            f.axes.y = 0.05;\\n        } else {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":850,\"limit\":400,\"raw_output\":\"            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n                    self.ride.fuse = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n            }\\n            Spec::Panic => {\\n                // An earlier scare does not finish this job. The soldier has to run from this fire.\\n                self.flags.remove(\\\"enemy_panicked\\\");\\n                self.clear_bodies();\\n                let sx = self.x + 4.0;\\n                let sz = self.z - 4.0;\\n                self.spawn_soldier(sx, sz, 40.0, false);\\n                // Runners sprint +x. One 2 m cell ends before flee passes 3.\\n                for i in 0..6 {\\n                    let _ = self.fire.ignite_disk(sx + i as f32 * 4.0, sz, 3.0, self.tune.burn_time, self.minutes);\\n                }\\n            }\\n            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n            }\\n            Spec::Sleep { .. } => {\\n                // The short rest already set this. The long rest has to happen on its own.\\n                self.flags.remove(\\\"sleep_used\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                let (ax, az) = geom::water_ahead(wx, wz, 40.0);\\n                self.ride.kind = 2;\\n                self.ride.seat = 0;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.yaw = geom::yaw_toward(wx, wz, ax, az);\\n                self.ride.speed = 0.0;\\n                self.ride.health = 100.0;\\n                self.ride.stage = 0;\\n                self.ride.dist = 0.0;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n            }\\n            Spec::Rain => {\\n                // The boat step leaves you on the channel. Rain has to quench grass, not water.\\n                let mut lit = false;\\n                for r in [16.0, 22.0, 30.0, 40.0] {\\n                    for (dx, dz) in [(r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r)] {\\n                        if self.fire.ignite_at(self.x + dx, self.z + dz, self.tune.burn_time, self.minutes) {\\n                            lit = true;\\n                            break;\\n                        }\\n                    }\\n                    if lit {\\n                        break;\\n                    }\\n                }\\n                self.weather = 1;\\n            }\\n            Spec::Better => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = self.x + 1.5;\\n                    c.z = self.z;\\n                }\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Town => {\\n                self.arm(WeaponId::Molotov);\\n            }\\n            Spec::Ignite(n) => self.prep_ignite(n),\\n         