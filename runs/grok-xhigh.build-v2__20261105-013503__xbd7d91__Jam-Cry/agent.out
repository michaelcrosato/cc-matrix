{\"line_number\":373,\"content\":\"    AIHub.on('message', function () {\"},{\"line_number\":374,\"content\":\"      if (ended || !window.AIHub || AIHub.server) return;\"},{\"line_number\":375,\"content\":\"      AIHub.send({ t: 'ack' }, { reliable: true });\"},{\"line_number\":377,\"content\":\"    AIHub.on('leave', function (ev) { if (ev && typeof ev.id === 'number') delete present[ev.id]; });\"},{\"line_number\":378,\"content\":\"    AIHub.on('time-up', function () { finishRound(); });\"},{\"line_number\":379,\"content\":\"    AIHub.on('end', function () { ended = true; });\"},{\"line_number\":380,\"content\":\"    AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true }).then(function (got) {\"},{\"line_number\":386,\"content\":\"      window.__jamSkipGpu = true;\"},{\"line_number\":387,\"content\":\"      AIHub.ready();\"},{\"line_number\":391,\"content\":\"    if (!window.AIHub || !AIHub.active || !started || ended) return;\"},{\"line_number\":392,\"content\":\"    if (AIHub.isHost) AIHub.send({ t: 'fire', c: [1, 2] }, { reliable: true });\"},{\"line_number\":393,\"content\":\"    else AIHub.send({ t: 'pose', x: 0, z: 0 }, { reliable: true });\"},{\"line_number\":401,\"content\":\"  if (window.__jamSkipGpu) {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"a128a60c-d8ff-4cb2-af9a-1f5f8cfb4e1e"}
{"type":"assistant","message":{"id":"msg_271","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Burst mode is dangerous for attract.\n\nBurst mode ticks 120 times per frame. Attract mode needs 600 ticks at 60Hz. The title idle timer races against this burst. Tests must wait for window.__game to appear before acting.\n\nThe launch test only requires the UI state to change across Enter/Space presses. Attract mode may intercept the first confirm and return to title, but this still counts as a state change. Hook tests that need specific screens must be handled carefully.\n\nBurst mode may trigger attract between test commands. Playwright waits exceed 100ms, so many frames pass and attract activates. Menu navigation tests will fail unless burst pauses when caught up.\n\nBurst mode is meant for test performance, not attract. The current code forces 120 ticks per frame unconditionally, so attract is unavoidable. Limiting burst to a finite catch-up amount would fix this.\n\nDisabling attract in test mode would break the browser verification, since it requires attract to be visible. The better approach is to cap burst at 120 ticks per advance while still catching up to real time, so menus remain responsive without forcing an infinite spin.\n\nHook tests can wait real time for confirms. The phone attract test requires over ten seconds of real time, which is acceptable.\n\nThe burst cap solves a GPU hitch problem. A late title frame adds roughly two seconds of idle. With a 120-tick cap, that becomes two seconds of idle instead of 120.\n\nA single two-second hitch advances exactly 120 ticks, which is not enough to trigger attract mode. Multiple hitches during initialization could still accumulate enough idle time. The simulation clock initializes at the current instant when created.\n\nThe catch-up logic snaps the simulation clock forward after each late frame. A single thirty-second hitch advances only two seconds of idle time, which is too short to trigger attract mode. Attract would require five consecutive late frames before it could start.\n\nBurst mode prevents the clock from snapping back. When burst is active, the simulation clock advances 120 ticks per frame and jumps ahead of wall time. The snap condition `now > self.next` never triggers because the clock is always ahead. This causes an infinite catch-up loop that forces attract mode to start.\n\nBurst mode should be removed entirely for test builds. Hook tests already run at 60fps without drawing, so they do not need extra catch-up. The original purpose of burst was to prevent GPU-bound hook tests and speed up menu ticks.\n\nThe tick cap already handles slow frames. Burst mode was only meant to accelerate long attract segments, but the browser attract check can simply wait real time with nodraw. Combat simulation is not a browser test. I will either disable burst entirely or change it to a single aggressive catch-up pass instead of an infinite spin.\n\nThe safest fix is to remove burst spinning from the clock loop entirely. The loop should only advance when wall time has reached the simulation deadline, and the 120-tick cap should remain for non-playing states and test mode to prevent stalls. Burst mode can be kept but must not force extra ticks when caught up.\n\nThe tick cap already returns 120 ticks in test mode regardless of screen state, so burst mode is redundant there. I will remove the burst spin from the clock loop and keep the function to avoid unused warnings.\n\nThe unused public function is harmless. I will edit simhost now to remove the burst spin from the clock loop, and Cargo should pick up the change before pav_app finishes compiling.","signature":""},{"type":"tool_use","id":"call-820af0b9-3175-4cf6-91e9-049fab23ea58-16","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/web/index.html","offset":68,"limit":360}},{"type":"tool_use","id":"call-820af0b9-3175-4cf6-91e9-049fab23ea58-17","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/app.rs","offset":280,"limit":50}},{"type":"tool_use","id":"call-820af0b9-3175-4cf6-91e9-049fab23ea58-18","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/app.rs","offset":860,"limit":50}},{"type":"tool_use","id":"call-820af0b9-3175-4cf6-91e9-049fab23ea58-19","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/app.rs","offset":1190,"limit":70}},{"type":"tool_use","id":"call-820af0b9-3175-4cf6-91e9-049fab23ea58-20","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/app.rs","offset":1660,"limit":40}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":4680,"output_tokens":2533,"cache_read_input_tokens":59776,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"5e9a6b84-452a-49e7-8f9a-4fe6a50a2b85"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-820af0b9-3175-4cf6-91e9-049fab23ea58-16","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"68→<script>\\n(function () {\\n70→  var pending = { look: [0, 0], move: null, axes: null, pressed: 0, act: 0, hover: null, click: false, device: null, touch: null, xbox: null, lock: false, hub: false };\\n  var held = {};\\n  var screenName = 'Title';\\n  var started = false;\\n  var ended = false;\\n  var finished = false;\\n  var present = {};\\n  var info = null;\\n  window.gameTest = window.gameTest || { queue: [] };\\n  window.__jamSkipGpu = !!(window.AIHub && AIHub.active);\\n80→\\n  function touchOnly() {\\n    try { return matchMedia('(pointer: coarse)').matches && matchMedia('(hover: none)').matches; }\\n    catch (e) { return false; }\\n  }\\n  function sensePad() {\\n    var pads = [];\\n    try { pads = navigator.getGamepads ? navigator.getGamepads() : []; } catch (e) { pads = []; }\\n    var pad = pads && pads[0];\\n    if (pad && pad.connected && String(pad.id).indexOf('054c') >= 0 && String(pad.id).indexOf('0ce6') >= 0) {\\n90→      pending.device = 'gamepad';\\n      pending.lock = true;\\n    }\\n  }\\n  function applyCmd(c) {\\n    if (!c || typeof c !== 'object') return;\\n    if (c.act) pending.act = c.act | 0;\\n    if (c.look && c.look.length === 2) { pending.look[0] += +c.look[0] || 0; pending.look[1] += +c.look[1] || 0; }\\n    if (c.move) pending.move = c.move;\\n    if (c.hover) pending.hover = c.hover;\\n100→    if (c.click) pending.click = true;\\n    if (c.device) pending.device = c.device;\\n    if (c.lock) pending.lock = true;\\n    if (c.touch) pending.touch = true;\\n    if (c.xbox) pending.xbox = true;\\n    if (c.key === 'Enter' || c.key === ' ') pending.act = 1;\\n    if (c.key === 'Escape') pending.act = 10;\\n  }\\n  function drain() {\\n    var q = window.gameTest && window.gameTest.queue;\\n110→    if (!q || !q.length) return;\\n    var batch = q.splice(0, q.length);\\n    for (var i = 0; i < batch.length; i++) applyCmd(batch[i]);\\n  }\\n  function stick() {\\n    var x = (held.d || held.ArrowRight ? 1 : 0) - (held.a || held.ArrowLeft ? 1 : 0);\\n    var y = (held.w || held.ArrowUp ? 1 : 0) - (held.s || held.ArrowDown ? 1 : 0);\\n    if (!x && !y) return null;\\n    var len = Math.hypot(x, y) || 1;\\n    return [x / len, y / len];\\n120→  }\\n  window.gameBridge = {\\n    pull: function () {\\n      drain();\\n      sensePad();\\n      if (touchOnly()) pending.touch = true;\\n      if (window.AIHub && AIHub.active) pending.hub = true;\\n      var out = {\\n        look: [pending.look[0], pending.look[1]],\\n        move: pending.move || stick(),\\n130→        axes: pending.axes,\\n        pressed: pending.pressed,\\n        act: pending.act,\\n        hover: pending.hover,\\n        click: pending.click,\\n        device: pending.device,\\n        touch: pending.touch,\\n        xbox: pending.xbox,\\n        lock: pending.lock,\\n        hub: !!pending.hub\\n140→      };\\n      pending.look = [0, 0];\\n      pending.pressed = 0;\\n      pending.act = 0;\\n      pending.click = false;\\n      pending.hover = null;\\n      pending.move = null;\\n      pending.xbox = null;\\n      return JSON.stringify(out);\\n    },\\n150→    publish: function (status, ui) { window.__game = { status: status, ui: ui }; paint(status, ui); }\\n  };\\n\\n  function paint(status, ui) {\\n    var u;\\n    try { u = JSON.parse(ui); } catch (e) { return; }\\n    screenName = u.screen || screenName;\\n    var shell = document.getElementById('shell');\\n    if (shell) shell.dataset.screen = screenName;\\n    var rows = document.getElementById('rows');\\n160→    var notice = document.getElementById('notice');\\n    var about = document.getElementById('about');\\n    var settings = document.getElementById('settings-btn');\\n    if (notice) {\\n      if (u.notice) { notice.hidden = false; notice.textContent = u.notice; }\\n      else notice.hidden = true;\\n    }\\n    if (settings) settings.hidden = !u.notice;\\n    if (rows && u.rows) {\\n      while (rows.firstChild) rows.removeChild(rows.firstChild);\\n170→      var list = u.rows.slice(0, 7);\\n      for (var i = 0; i < list.length; i++) {\\n        var b = document.createElement('button');\\n        b.type = 'button';\\n        b.className = i === u.focus ? 'on' : '';\\n        b.textContent = list[i];\\n        b.dataset.i = String(i);\\n        b.addEventListener('click', onRow);\\n        rows.appendChild(b);\\n      }\\n180→    }\\n    if (about) {\\n      var show = screenName === 'About';\\n      about.hidden = !show;\\n      if (show && u.about) {\\n        while (about.firstChild) about.removeChild(about.firstChild);\\n        for (var j = 0; j < u.about.length; j++) {\\n          var p = document.createElement('p');\\n          p.textContent = u.about[j];\\n          about.appendChild(p);\\n190→        }\\n      }\\n    }\\n    var invite = document.getElementById('invite');\\n    if (invite) invite.hidden = screenName !== 'Mp';\\n  }\\n  function onRow(ev) {\\n    var i = Number(ev.currentTarget.dataset.i);\\n    var label = ev.currentTarget.textContent || '';\\n    pending.hover = [400, 220 + i * 80 + 10];\\n200→    pending.click = true;\\n    if (label === 'This computer' && window.gameNet) window.gameNet.startBroadcast();\\n  }\\n  document.getElementById('settings-btn').addEventListener('click', function () { pending.act = 18; });\\n\\n  function onCardKey(e) {\\n    if (!(window.AIHub && AIHub.active) || started) return false;\\n    if (e.key === 'Enter') { AIHub.answer('ready'); e.preventDefault(); e.stopPropagation(); return true; }\\n    if (e.key === 'm' || e.key === 'M') { AIHub.answer('more'); e.preventDefault(); e.stopPropagation(); return true; }\\n    return false;\\n210→  }\\n  function actFor(key) {\\n    if (key === 'Enter' || key === ' ') return 1;\\n    if (key === 'Escape') return 10;\\n    if (key === 'ArrowUp') return 3;\\n    if (key === 'ArrowDown') return 4;\\n    if (key === 'ArrowLeft') return 5;\\n    if (key === 'ArrowRight') return 6;\\n    if (key === 'Backspace') return 2;\\n    return 0;\\n220→  }\\n  window.addEventListener('keydown', function (e) {\\n    if (onCardKey(e)) return;\\n    startMusic();\\n    var k = e.key;\\n    if (k === 'w' || k === 'a' || k === 's' || k === 'd' || k.indexOf('Arrow') === 0) held[k] = true;\\n    var act = actFor(k);\\n    if (act && !e.repeat) pending.act = act;\\n    if ((k === 'r' || k === 'R') && !e.repeat) pending.pressed |= 32768;\\n    if ((k === 'Enter' || k === ' ') && !e.repeat) pending.pressed |= 16777216;\\n230→  }, true);\\n  window.addEventListener('keyup', function (e) { held[e.key] = false; }, true);\\n  window.addEventListener('mousemove', function (e) {\\n    if (!document.pointerLockElement) return;\\n    pending.look[0] += (e.movementX || 0) * 0.0025;\\n    pending.look[1] += -(e.movementY || 0) * 0.0025;\\n  }, true);\\n  document.addEventListener('pointerlockchange', function () {\\n    if (!document.pointerLockElement && screenName === 'Playing') pending.act = 10;\\n  });\\n240→  document.addEventListener('click', function (e) {\\n    startMusic();\\n    var canvas = document.querySelector('canvas');\\n    if (!canvas || screenName !== 'Playing') return;\\n    if (e.target === canvas) {\\n      var req = canvas.requestPointerLock && canvas.requestPointerLock();\\n      if (req && req.catch) req.catch(function () {});\\n    }\\n  }, true);\\n\\n250→  var audioOn = false;\\n  function startMusic() {\\n    if (audioOn) return;\\n    audioOn = true;\\n    var AC = window.AudioContext || window.webkitAudioContext;\\n    if (!AC) return;\\n    var ctx = new AC();\\n    var osc = ctx.createOscillator();\\n    var gain = ctx.createGain();\\n    gain.gain.value = 0.10;\\n260→    osc.frequency.value = 98;\\n    osc.type = 'triangle';\\n    osc.connect(gain);\\n    gain.connect(ctx.destination);\\n    if (ctx.state === 'suspended' && ctx.resume) ctx.resume();\\n    osc.start();\\n  }\\n\\n  function showResults(how) {\\n    var el = document.getElementById('results');\\n270→    if (!el) return;\\n    el.hidden = false;\\n    el.textContent = 'Extracted together. The depot is ash. ' + how;\\n  }\\n  function waitIce(pc) {\\n    return new Promise(function (resolve) {\\n      if (pc.iceGatheringState === 'complete') { resolve(); return; }\\n      function done() { if (pc.iceGatheringState === 'complete') { pc.removeEventListener('icegatheringstatechange', done); resolve(); } }\\n      pc.addEventListener('icegatheringstatechange', done);\\n      setTimeout(resolve, 1500);\\n280→    });\\n  }\\n  function sdpText(desc) {\\n    return btoa(JSON.stringify({ type: desc.type, sdp: desc.sdp }));\\n  }\\n  var hostPc = null;\\n  window.gameNet = {\\n    startBroadcast: function () {\\n      if (window.AIHub && AIHub.active) return;\\n      var bc = new BroadcastChannel('jamcry-depot');\\n290→      var seen = false;\\n      bc.onmessage = function (ev) {\\n        var d = ev.data || {};\\n        if (d.t === 'hello') bc.postMessage({ t: 'ack' });\\n        if ((d.t === 'ack' || d.t === 'done') && !seen) { seen = true; bc.postMessage({ t: 'done' }); showResults('BroadcastChannel'); }\\n      };\\n      var n = 0;\\n      var timer = setInterval(function () {\\n        n += 1;\\n        if (seen || n > 25) { clearInterval(timer); return; }\\n300→        bc.postMessage({ t: 'hello' });\\n      }, 120);\\n      bc.postMessage({ t: 'hello' });\\n    },\\n    offerCode: function () {\\n      if (window.AIHub && AIHub.active) return Promise.reject(new Error('hub'));\\n      hostPc = new RTCPeerConnection({ iceServers: [] });\\n      var ch = hostPc.createDataChannel('jam');\\n      ch.onopen = function () { try { ch.send('go'); } catch (e) {} showResults('WebRTC'); };\\n      ch.onmessage = function () { showResults('WebRTC'); };\\n310→      return hostPc.createOffer().then(function (offer) { return hostPc.setLocalDescription(offer); }).then(function () { return waitIce(hostPc); }).then(function () { return sdpText(hostPc.localDescription); });\\n    },\\n    takeOffer: function (code) {\\n      if (window.AIHub && AIHub.active) return Promise.reject(new Error('hub'));\\n      var pc = new RTCPeerConnection({ iceServers: [] });\\n      pc.ondatachannel = function (ev) {\\n        ev.channel.onopen = function () { try { ev.channel.send('go'); } catch (e) {} showResults('WebRTC'); };\\n        ev.channel.onmessage = function () { showResults('WebRTC'); };\\n      };\\n      var desc = JSON.parse(atob(code));\\n320→      return pc.setRemoteDescription(desc).then(function () { return pc.createAnswer(); }).then(function (answer) { return pc.setLocalDescription(answer); }).then(function () { return waitIce(pc); }).then(function () { return sdpText(pc.localDescription); });\\n    },\\n    takeAnswer: function (code) {\\n      if (!hostPc) return Promise.reject(new Error('no offer'));\\n      return hostPc.setRemoteDescription(JSON.parse(atob(code)));\\n    }\\n  };\\n  document.getElementById('make-offer').addEventListener('click', function () {\\n    window.gameNet.offerCode().then(function (code) { document.getElementById('offer').textContent = code; });\\n  });\\n330→  document.getElementById('join-code').addEventListener('click', function () {\\n    var code = document.getElementById('paste').value.trim();\\n    if (!code) return;\\n    var job = hostPc ? window.gameNet.takeAnswer(code) : window.gameNet.takeOffer(code);\\n    Promise.resolve(job).then(function (answer) { if (typeof answer === 'string') document.getElementById('offer').textContent = answer; });\\n  });\\n\\n  function finishRound() {\\n    if (finished || ended || !window.AIHub || !AIHub.isHost) return;\\n    finished = true;\\n340→    var ids = [];\\n    for (var k in present) if (Object.prototype.hasOwnProperty.call(present, k)) ids.push(Number(k));\\n    ids.sort(function (a, b) { return a - b; });\\n    AIHub.finish({ standings: [ids] });\\n  }\\n  function bootHub() {\\n    if (!window.AIHub || !AIHub.connect) return;\\n    AIHub.on('card', function (card) {\\n      var box = document.getElementById('card');\\n      if (!box) return;\\n350→      box.hidden = false;\\n      while (box.firstChild) box.removeChild(box.firstChild);\\n      var h = document.createElement('h2');\\n      h.textContent = 'Jam Cry';\\n      box.appendChild(h);\\n      var goal = document.createElement('p');\\n      goal.textContent = 'Burn the depot, take the ledger, get out together';\\n      box.appendChild(goal);\\n      var how = document.createElement('p');\\n      how.textContent = 'Stick or WASD to move. R2 or LMB fires. L2 or RMB aims. Square or R clears a jam. Enter says ready. M asks for more time.';\\n360→      box.appendChild(how);\\n      var left = document.createElement('p');\\n      left.textContent = card && card.left == null ? 'Starting' : ('Card ' + Math.ceil((card.left || 0) / 1000) + 's');\\n      box.appendChild(left);\\n      var players = (info && info.players) || (window.AIHub && AIHub.players) || [];\\n      for (var i = 0; i < players.length; i++) {\\n        var line = document.createElement('p');\\n        line.style.color = players[i].color || '#f0a060';\\n        line.textContent = String(players[i].name || ('Seat ' + players[i].id));\\n        box.appendChild(line);\\n370→      }\\n    });\\n    AIHub.on('start', function () { started = true; var box = document.getElementById('card'); if (box) box.hidden = true; });\\n    AIHub.on('message', function () {\\n      if (ended || !window.AIHub || AIHub.server) return;\\n      AIHub.send({ t: 'ack' }, { reliable: true });\\n    });\\n    AIHub.on('leave', function (ev) { if (ev && typeof ev.id === 'number') delete present[ev.id]; });\\n    AIHub.on('time-up', function () { finishRound(); });\\n    AIHub.on('end', function () { ended = true; });\\n380→    AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true }).then(function (got) {\\n      if (!got) return;\\n      info = got;\\n      var list = got.players || [];\\n      for (var i = 0; i < list.length; i++) present[list[i].id] = true;\\n      if (got.server) document.documentElement.setAttribute('data-jam-server', '1');\\n      window.__jamSkipGpu = true;\\n      AIHub.ready();\\n    });\\n  }\\n390→  setInterval(function () {\\n    if (!window.AIHub || !AIHub.active || !started || ended) return;\\n    if (AIHub.isHost) AIHub.send({ t: 'fire', c: [1, 2] }, { reliable: true });\\n    else AIHub.send({ t: 'pose', x: 0, z: 0 }, { reliable: true });\\n  }, 250);\\n  bootHub();\\n})();\\n</script>\\n<script type=\\\"module\\\">\\n  const name = document.title;\\n400→  const msg = document.getElementById('msg');\\n  if (window.__jamSkipGpu) {\\n    msg.remove();\\n  } else if (!navigator.gpu) {\\n    msg.replaceChildren(`${name} needs WebGPU.`, document.createElement('br'),\\n      'Use a recent Chrome, Edge or Safari (iOS 26 or later) with hardware acceleration enabled.');\\n  } else {\\n    new MutationObserver((_, obs) => {\\n      const c = document.querySelector('canvas');\\n      if (c) { c.setAttribute('aria-label', `${name} game`); msg.remove(); c.focus(); obs.disconnect(); }\\n410→    }).observe(document.body, { childList: true });\\n    try {\\n      if (window.loadGame) await window.loadGame();\\n      else await (await import('./shardfall.js')).default();\\n    } catch (error) {\\n      console.error(`${name} failed to load:`, error);\\n      msg.textContent = `${name} could not load. Please reload the page. If it still fails, check that WebGPU and hardware acceleration are enabled.`;\\n      document.body.append(msg);\\n    }\\n  }\\n420→</script>\\n</body>\\n</html>\\n\",\"content_concise\":\"68→<script>\\n(function () {\\n70→  var pending = { look: [0, 0], move: null, axes: null, pressed: 0, act: 0, hover: null, click: false, device: null, touch: null, xbox: null, lock: false, hub: false };\\n  var held = {};\\n  var screenName = 'Title';\\n  var started = false;\\n  var ended = false;\\n  var finished = false;\\n  var present = {};\\n  var info = null;\\n  window.gameTest = window.gameTest || { queue: [] };\\n  window.__jamSkipGpu = !!(window.AIHub && AIHub.active);\\n80→\\n  function touchOnly() {\\n    try { return matchMedia('(pointer: coarse)').matches && matchMedia('(hover: none)').matches; }\\n    catch (e) { return false; }\\n  }\\n  function sensePad() {\\n    var pads = [];\\n    try { pads = navigator.getGamepads ? navigator.getGamepads() : []; } catch (e) { pads = []; }\\n    var pad = pads && pads[0];\\n    if (pad && pad.connected && String(pad.id).indexOf('054c') >= 0 && String(pad.id).indexOf('0ce6') >= 0) {\\n90→      pending.device = 'gamepad';\\n      pending.lock = true;\\n    }\\n  }\\n  function applyCmd(c) {\\n    if (!c || typeof c !== 'object') return;\\n    if (c.act) pending.act = c.act | 0;\\n    if (c.look && c.look.length === 2) { pending.look[0] += +c.look[0] || 0; pending.look[1] += +c.look[1] || 0; }\\n    if (c.move) pending.move = c.move;\\n    if (c.hover) pending.hover = c.hover;\\n100→    if (c.click) pending.click = true;\\n    if (c.device) pending.device = c.device;\\n    if (c.lock) pending.lock = true;\\n    if (c.touch) pending.touch = true;\\n    if (c.xbox) pending.xbox = true;\\n    if (c.key === 'Enter' || c.key === ' ') pending.act = 1;\\n    if (c.key === 'Escape') pending.act = 10;\\n  }\\n  function drain() {\\n    var q = window.gameTest && window.gameTest.queue;\\n110→    if (!q || !q.length) return;\\n    var batch = q.splice(0, q.length);\\n    for (var i = 0; i < batch.length; i++) applyCmd(batch[i]);\\n  }\\n  function stick() {\\n    var x = (held.d || held.ArrowRight ? 1 : 0) - (held.a || held.ArrowLeft ? 1 : 0);\\n    var y = (held.w || held.ArrowUp ? 1 : 0) - (held.s || held.ArrowDown ? 1 : 0);\\n    if (!x && !y) return null;\\n    var len = Math.hypot(x, y) || 1;\\n    return [x / len, y / len];\\n120→  }\\n  window.gameBridge = {\\n    pull: function () {\\n      drain();\\n      sensePad();\\n      if (touchOnly()) pending.touch = true;\\n      if (window.AIHub && AIHub.active) pending.hub = true;\\n      var out = {\\n        look: [pending.look[0], pending.look[1]],\\n        move: pending.move || stick(),\\n130→        axes: pending.axes,\\n        pressed: pending.pressed,\\n        act: pending.act,\\n        hover: pending.hover,\\n        click: pending.click,\\n        device: pending.device,\\n        touch: pending.touch,\\n        xbox: pending.xbox,\\n        lock: pending.lock,\\n        hub: !!pending.hub\\n140→      };\\n      pending.look = [0, 0];\\n      pending.pressed = 0;\\n      pending.act = 0;\\n      pending.click = false;\\n      pending.hover = null;\\n      pending.move = null;\\n      pending.xbox = null;\\n      return JSON.stringify(out);\\n    },\\n150→    publish: function (status, ui) { window.__game = { status: status, ui: ui }; paint(status, ui); }\\n  };\\n\\n  function paint(status, ui) {\\n    var u;\\n    try { u = JSON.parse(ui); } catch (e) { return; }\\n    screenName = u.screen || screenName;\\n    var shell = document.getElementById('shell');\\n    if (shell) shell.dataset.screen = screenName;\\n    var rows = document.getElementById('rows');\\n160→    var notice = document.getElementById('notice');\\n    var about = document.getElementById('about');\\n    var settings = document.getElementById('settings-btn');\\n    if (notice) {\\n      if (u.notice) { notice.hidden = false; notice.textContent = u.notice; }\\n      else notice.hidden = true;\\n    }\\n    if (settings) settings.hidden = !u.notice;\\n    if (rows && u.rows) {\\n      while (rows.firstChild) rows.removeChild(rows.firstChild);\\n170→      var list = u.rows.slice(0, 7);\\n      for (var i = 0; i < list.length; i++) {\\n        var b = document.createElement('button');\\n        b.type = 'button';\\n        b.className = i === u.focus ? 'on' : '';\\n        b.textContent = list[i];\\n        b.dataset.i = String(i);\\n        b.addEventListener('click', onRow);\\n        rows.appendChild(b);\\n      }\\n180→    }\\n    if (about) {\\n      var show = screenName === 'About';\\n      about.hidden = !show;\\n      if (show && u.about) {\\n        while (about.firstChild) about.removeChild(about.firstChild);\\n        for (var j = 0; j < u.about.length; j++) {\\n          var p = document.createElement('p');\\n          p.textContent = u.about[j];\\n          about.appendChild(p);\\n190→        }\\n      }\\n    }\\n    var invite = document.getElementById('invite');\\n    if (invite) invite.hidden = screenName !== 'Mp';\\n  }\\n  function onRow(ev) {\\n    var i = Number(ev.currentTarget.dataset.i);\\n    var label = ev.currentTarget.textContent || '';\\n    pending.hover = [400, 220 + i * 80 + 10];\\n200→    pending.click = true;\\n    if (label === 'This computer' && window.gameNet) window.gameNet.startBroadcast();\\n  }\\n  document.getElementById('settings-btn').addEventListener('click', function () { pending.act = 18; });\\n\\n  function onCardKey(e) {\\n    if (!(window.AIHub && AIHub.active) || started) return false;\\n    if (e.key === 'Enter') { AIHub.answer('ready'); e.preventDefault(); e.stopPropagation(); return true; }\\n    if (e.key === 'm' || e.key === 'M') { AIHub.answer('more'); e.preventDefault(); e.stopPropagation(); return true; }\\n    return false;\\n210→  }\\n  function actFor(key) {\\n    if (key === 'Enter' || key === ' ') return 1;\\n    if (key === 'Escape') return 10;\\n    if (key === 'ArrowUp') return 3;\\n    if (key === 'ArrowDown') return 4;\\n    if (key === 'ArrowLeft') return 5;\\n    if (key === 'ArrowRight') return 6;\\n    if (key === 'Backspace') return 2;\\n    return 0;\\n220→  }\\n  window.addEventListener('keydown', function (e) {\\n    if (onCardKey(e)) return;\\n    startMusic();\\n    var k = e.key;\\n    if (k === 'w' || k === 'a' || k === 's' || k === 'd' || k.indexOf('Arrow') === 0) held[k] = true;\\n    var act = actFor(k);\\n    if (act && !e.repeat) pending.act = act;\\n    if ((k === 'r' || k === 'R') && !e.repeat) pending.pressed |= 32768;\\n    if ((k === 'Enter' || k === ' ') && !e.repeat) pending.pressed |= 16777216;\\n230→  }, true);\\n  window.addEventListener('keyup', function (e) { held[e.key] = false; }, true);\\n  window.addEventListener('mousemove', function (e) {\\n    if (!document.pointerLockElement) return;\\n    pending.look[0] += (e.movementX || 0) * 0.0025;\\n    pending.look[1] += -(e.movementY || 0) * 0.0025;\\n  }, true);\\n  document.addEventListener('pointerlockchange', function () {\\n    if (!document.pointerLockElement && screenName === 'Playing') pending.act = 10;\\n  });\\n240→  document.addEventListener('click', function (e) {\\n    startMusic();\\n    var canvas = document.querySelector('canvas');\\n    if (!canvas || screenName !== 'Playing') return;\\n    if (e.target === canvas) {\\n      var req = canvas.requestPointerLock && canvas.requestPointerLock();\\n      if (req && req.catch) req.catch(function () {});\\n    }\\n  }, true);\\n\\n250→  var audioOn = false;\\n  function startMusic() {\\n    if (audioOn) return;\\n    audioOn = true;\\n    var AC = window.AudioContext || window.webkitAudioContext;\\n    if (!AC) return;\\n    var ctx = new AC();\\n    var osc = ctx.createOscillator();\\n    var gain = ctx.createGain();\\n    gain.gain.value = 0.10;\\n260→    osc.frequency.value = 98;\\n    osc.type = 'triangle';\\n    osc.connect(gain);\\n    gain.connect(ctx.destination);\\n    if (ctx.state === 'suspended' && ctx.resume) ctx.resume();\\n    osc.start();\\n  }\\n\\n  function showResults(how) {\\n    var el = document.getElementById('results');\\n270→    if (!el) return;\\n    el.hidden = false;\\n    el.textContent = 'Extracted together. The depot is ash. ' + how;\\n  }\\n  function waitIce(pc) {\\n    return new Promise(function (resolve) {\\n      if (pc.iceGatheringState === 'complete') { resolve(); return; }\\n      function done() { if (pc.iceGatheringState === 'complete') { pc.removeEventListener('icegatheringstatechange', done); resolve(); } }\\n      pc.addEventListener('icegatheringstatechange', done);\\n      setTimeout(resolve, 1500);\\n280→    });\\n  }\\n  function sdpText(desc) {\\n    return btoa(JSON.stringify({ type: desc.type, sdp: desc.sdp }));\\n  }\\n  var hostPc = null;\\n  window.gameNet = {\\n    startBroadcast: function () {\\n      if (window.AIHub && AIHub.active) return;\\n      var bc = new BroadcastChannel('jamcry-depot');\\n290→      var seen = false;\\n      bc.onmessage = function (ev) {\\n        var d = ev.data || {};\\n        if (d.t === 'hello') bc.postMessage({ t: 'ack' });\\n        if ((d.t === 'ack' || d.t === 'done') && !seen) { seen = true; bc.postMessage({ t: 'done' }); showResults('BroadcastChannel'); }\\n      };\\n      var n = 0;\\n      var timer = setInterval(function () {\\n        n += 1;\\n        if (seen || n > 25) { clearInterval(timer); return; }\\n300→        bc.postMessage({ t: 'hello' });\\n      }, 120);\\n      bc.postMessage({ t: 'hello' });\\n    },\\n    offerCode: function () {\\n      if (window.AIHub && AIHub.active) return Promise.reject(new Error('hub'));\\n      hostPc = new RTCPeerConnection({ iceServers: [] });\\n      var ch = hostPc.createDataChannel('jam');\\n      ch.onopen = function () { try { ch.send('go'); } catch (e) {} showResults('WebRTC'); };\\n      ch.onmessage = function () { showResults('WebRTC'); };\\n310→      return hostPc.createOffer().then(function (offer) { return hostPc.setLocalDescription(offer); }).then(function () { return waitIce(hostPc); }).then(function () { return sdpText(hostPc.localDescription); });\\n    },\\n    takeOffer: function (code) {\\n      if (window.AIHub && AIHub.active) return Promise.reject(new Error('hub'));\\n      var pc = new RTCPeerConnection({ iceServers: [] });\\n      pc.ondatachannel 