{"type":"assistant","message":{"id":"msg_160","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"I'll fix the panic by lighting a strip and avoiding shooting.\n\nI'll only modify the Panic bot to avoid shooting. I'll check gun stats for dart range and sniper later. If animal failures occur, I'll fix those next.\n\nI'll also fix the animal bot. Existing shots already satisfy the flee requirement, so firing is optional. I'll either disable animal shooting or give them enough health to survive a few hits before fleeing.\n\nI'll split the animal match arm to prevent killing them. I'm checking stealth melee logic and dart accuracy for the soldier at z-18.","signature":""},{"type":"tool_use","id":"call-e7ef0931-aee4-4ac5-9124-7383e66ed8f2-25","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/gun.rs","offset":1,"limit":120}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":2794,"output_tokens":581,"cache_read_input_tokens":77312,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"03f377a2-82d6-4af8-ac4f-e9d8134a1819"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-e7ef0931-aee4-4ac5-9124-7383e66ed8f2-25","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Weapons, condition, jams and breaks. `Gun::pull` is the only shot roll.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum WeaponId {\\n    Pistol,\\n10→    Revolver,\\n    Flare,\\n    Sawnoff,\\n    Ar,\\n    Battle,\\n    Smg,\\n    Shotgun,\\n    Sniper,\\n    Dart,\\n    Lmg,\\n20→    Rpg,\\n    Flamer,\\n    Mortar,\\n    Frag,\\n    Molotov,\\n    Machete,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct Stats {\\n30→    pub name: &'static str,\\n    pub family: &'static str,\\n    pub mag: u32,\\n    pub reserve: u32,\\n    pub rpm: f32,\\n    pub damage: f32,\\n    pub range: f32,\\n    pub wear: f32,\\n    pub noise: f32,\\n    pub pellets: u32,\\n40→    pub ignites: bool,\\n    pub silent: bool,\\n}\\n\\npub fn stats(id: WeaponId) -> Stats {\\n    use WeaponId::*;\\n    match id {\\n        Pistol => Stats { name: \\\"Service Nine\\\", family: \\\"pistol\\\", mag: 12, reserve: 60, rpm: 300.0, damage: 22.0, range: 40.0, wear: 0.10, noise: 120.0, pellets: 1, ignites: false, silent: false },\\n        Revolver => Stats { name: \\\"Old Six\\\", family: \\\"pistol\\\", mag: 6, reserve: 30, rpm: 120.0, damage: 48.0, range: 50.0, wear: 0.05, noise: 140.0, pellets: 1, ignites: false, silent: false },\\n        Flare => Stats { name: \\\"Flare pistol\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 40.0, damage: 10.0, range: 60.0, wear: 0.5, noise: 60.0, pellets: 1, ignites: true, silent: false },\\n50→        Sawnoff => Stats { name: \\\"Sawn-off\\\", family: \\\"shotgun\\\", mag: 2, reserve: 24, rpm: 120.0, damage: 12.0, range: 12.0, wear: 0.3, noise: 150.0, pellets: 8, ignites: false, silent: false },\\n        Ar => Stats { name: \\\"Forty-Seven\\\", family: \\\"rifle\\\", mag: 30, reserve: 180, rpm: 600.0, damage: 26.0, range: 120.0, wear: 0.14, noise: 160.0, pellets: 1, ignites: false, silent: false },\\n        Battle => Stats { name: \\\"Battle rifle\\\", family: \\\"rifle\\\", mag: 20, reserve: 100, rpm: 450.0, damage: 38.0, range: 180.0, wear: 0.12, noise: 180.0, pellets: 1, ignites: false, silent: false },\\n        Smg => Stats { name: \\\"Folding SMG\\\", family: \\\"pistol\\\", mag: 30, reserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n60→        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n70→}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n80→#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Pull {\\n    Waiting,\\n    Dry,\\n    Jammed,\\n    Fired,\\n    Broke,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\n90→pub struct Gun {\\n    pub id: WeaponId,\\n    pub condition: f32,\\n    pub wear: f32,\\n    pub jammed: bool,\\n    pub broken: bool,\\n    pub ammo: u32,\\n    pub reserve: u32,\\n    pub cooldown: f32,\\n    pub clear_left: f32,\\n100→    pub slapped: bool,\\n    pub shots: u32,\\n    pub jams: u32,\\n    pub force_jam: bool,\\n}\\n\\nimpl Gun {\\n    pub fn new(id: WeaponId) -> Self {\\n        let s = stats(id);\\n        Self {\\n110→            id,\\n            condition: 100.0,\\n            wear: s.wear,\\n            jammed: false,\\n            broken: false,\\n            ammo: s.mag,\\n            reserve: s.reserve,\\n            cooldown: 0.0,\\n            clear_left: 0.0,\\n            slapped: false,\\n120→            shots: 0,\",\"content_concise\":\"1→//! Weapons, condition, jams and breaks. `Gun::pull` is the only shot roll.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum WeaponId {\\n    Pistol,\\n10→    Revolver,\\n    Flare,\\n    Sawnoff,\\n    Ar,\\n    Battle,\\n    Smg,\\n    Shotgun,\\n    Sniper,\\n    Dart,\\n    Lmg,\\n20→    Rpg,\\n    Flamer,\\n    Mortar,\\n    Frag,\\n    Molotov,\\n    Machete,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct Stats {\\n30→    pub name: &'static str,\\n    pub family: &'static str,\\n    pub mag: u32,\\n    pub reserve: u32,\\n    pub rpm: f32,\\n    pub damage: f32,\\n    pub range: f32,\\n    pub wear: f32,\\n    pub noise: f32,\\n    pub pellets: u32,\\n40→    pub ignites: bool,\\n    pub silent: bool,\\n}\\n\\npub fn stats(id: WeaponId) -> Stats {\\n    use WeaponId::*;\\n    match id {\\n        Pistol => Stats { name: \\\"Service Nine\\\", family: \\\"pistol\\\", mag: 12, reserve: 60, rpm: 300.0, damage: 22.0, range: 40.0, wear: 0.10, noise: 120.0, pellets: 1, ignites: false, silent: false },\\n        Revolver => Stats { name: \\\"Old Six\\\", family: \\\"pistol\\\", mag: 6, reserve: 30, rpm: 120.0, damage: 48.0, range: 50.0, wear: 0.05, noise: 140.0, pellets: 1, ignites: false, silent: false },\\n        Flare => Stats { name: \\\"Flare pistol\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 40.0, damage: 10.0, range: 60.0, wear: 0.5, noise: 60.0, pellets: 1, ignites: true, silent: false },\\n50→        Sawnoff => Stats { name: \\\"Sawn-off\\\", family: \\\"shotgun\\\", mag: 2, reserve: 24, rpm: 120.0, damage: 12.0, range: 12.0, wear: 0.3, noise: 150.0, pellets: 8, ignites: false, silent: false },\\n        Ar => Stats { name: \\\"Forty-Seven\\\", family: \\\"rifle\\\", mag: 30, reserve: 180, rpm: 600.0, damage: 26.0, range: 120.0, wear: 0.14, noise: 160.0, pellets: 1, ignites: false, silent: false },\\n        Battle => Stats { name: \\\"Battle rifle\\\", family: \\\"rifle\\\", mag: 20, reserve: 100, rpm: 450.0, damage: 38.0, range: 180.0, wear: 0.12, noise: 180.0, pellets: 1, ignites: false, silent: false },\\n        Smg => Stats { name: \\\"Folding SMG\\\", family: \\\"pistol\\\", mag: 30, reserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n60→        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n70→}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n80→#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Pull {\\n    Waiting,\\n    Dry,\\n    Jammed,\\n    Fired,\\n    Broke,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\n90→pub struct Gun {\\n    pub id: WeaponId,\\n    pub condition: f32,\\n    pub wear: f32,\\n    pub jammed: bool,\\n    pub broken: bool,\\n    pub ammo: u32,\\n    pub reserve: u32,\\n    pub cooldown: f32,\\n    pub clear_left: f32,\\n100→    pub slapped: bool,\\n    pub shots: u32,\\n    pub jams: u32,\\n    pub force_jam: bool,\\n}\\n\\nimpl Gun {\\n    pub fn new(id: WeaponId) -> Self {\\n        let s = stats(id);\\n        Self {\\n110→            id,\\n            condition: 100.0,\\n            wear: s.wear,\\n            jammed: false,\\n            broken: false,\\n            ammo: s.mag,\\n            reserve: s.reserve,\\n            cooldown: 0.0,\\n            clear_left: 0.0,\\n            slapped: false,\\n120→            shots: 0,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/gun.rs\",\"offset\":1,\"limit\":120,\"raw_output\":\"//! Weapons, condition, jams and breaks. `Gun::pull` is the only shot roll.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum WeaponId {\\n    Pistol,\\n    Revolver,\\n    Flare,\\n    Sawnoff,\\n    Ar,\\n    Battle,\\n    Smg,\\n    Shotgun,\\n    Sniper,\\n    Dart,\\n    Lmg,\\n    Rpg,\\n    Flamer,\\n    Mortar,\\n    Frag,\\n    Molotov,\\n    Machete,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct Stats {\\n    pub name: &'static str,\\n    pub family: &'static str,\\n    pub mag: u32,\\n    pub reserve: u32,\\n    pub rpm: f32,\\n    pub damage: f32,\\n    pub range: f32,\\n    pub wear: f32,\\n    pub noise: f32,\\n    pub pellets: u32,\\n    pub ignites: bool,\\n    pub silent: bool,\\n}\\n\\npub fn stats(id: WeaponId) -> Stats {\\n    use WeaponId::*;\\n    match id {\\n        Pistol => Stats { name: \\\"Service Nine\\\", family: \\\"pistol\\\", mag: 12, reserve: 60, rpm: 300.0, damage: 22.0, range: 40.0, wear: 0.10, noise: 120.0, pellets: 1, ignites: false, silent: false },\\n        Revolver => Stats { name: \\\"Old Six\\\", family: \\\"pistol\\\", mag: 6, reserve: 30, rpm: 120.0, damage: 48.0, range: 50.0, wear: 0.05, noise: 140.0, pellets: 1, ignites: false, silent: false },\\n        Flare => Stats { name: \\\"Flare pistol\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 40.0, damage: 10.0, range: 60.0, wear: 0.5, noise: 60.0, pellets: 1, ignites: true, silent: false },\\n        Sawnoff => Stats { name: \\\"Sawn-off\\\", family: \\\"shotgun\\\", mag: 2, reserve: 24, rpm: 120.0, damage: 12.0, range: 12.0, wear: 0.3, noise: 150.0, pellets: 8, ignites: false, silent: false },\\n        Ar => Stats { name: \\\"Forty-Seven\\\", family: \\\"rifle\\\", mag: 30, reserve: 180, rpm: 600.0, damage: 26.0, range: 120.0, wear: 0.14, noise: 160.0, pellets: 1, ignites: false, silent: false },\\n        Battle => Stats { name: \\\"Battle rifle\\\", family: \\\"rifle\\\", mag: 20, reserve: 100, rpm: 450.0, damage: 38.0, range: 180.0, wear: 0.12, noise: 180.0, pellets: 1, ignites: false, silent: false },\\n        Smg => Stats { name: \\\"Folding SMG\\\", family: \\\"pistol\\\", mag: 30, reserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Pull {\\n    Waiting,\\n    Dry,\\n    Jammed,\\n    Fired,\\n    Broke,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Gun {\\n    pub id: WeaponId,\\n    pub condition: f32,\\n    pub wear: f32,\\n    pub jammed: bool,\\n    pub broken: bool,\\n    pub ammo: u32,\\n    pub reserve: u32,\\n    pub cooldown: f32,\\n    pub clear_left: f32,\\n    pub slapped: bool,\\n    pub shots: u32,\\n    pub jams: u32,\\n    pub force_jam: bool,\\n}\\n\\nimpl Gun {\\n    pub fn new(id: WeaponId) -> Self {\\n        let s = stats(id);\\n        Self {\\n            id,\\n            condition: 100.0,\\n            wear: s.wear,\\n            jammed: false,\\n            broken: false,\\n     