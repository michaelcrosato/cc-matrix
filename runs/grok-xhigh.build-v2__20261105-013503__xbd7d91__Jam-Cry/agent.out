    #[serde(default)]\\n    pub prop: Option<crate::prop_instance::PropInstance>,\\n    pub behavior: Behavior,\\n    #[serde(default)]\\n    pub character: Option<Box<Character>>,\\n320→    #[serde(default)]\\n    pub bomb: Option<Bomb>,\\n    /// Ticks until the entity despawns by itself (debris).\\n    #[serde(default)]\\n    pub lifetime: Option<u32>,\\n    /// The region (room / terrain chunk) the entity belongs to, for streaming and resets.\\n    #[serde(default)]\\n    pub region: Option<RegionKey>,\\n    #[serde(default)]\\n    pub material: Material,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/entity.rs\",\"offset\":290,\"limit\":40,\"raw_output\":\"    Fixed,\\n    /// Moved by code (platforms, doors).\\n    Kinematic,\\n    /// Fully simulated.\\n    Dynamic,\\n}\\n\\n/// A lit fuse.\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Bomb {\\n    pub fuse: f32,\\n    pub radius: f32,\\n    pub owner: Option<EntityId>,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Entity {\\n    pub id: EntityId,\\n    pub name: String,\\n    pub pos: Vec3,\\n    pub rot: Quat,\\n    pub body_kind: BodyKind,\\n    pub body: Option<RigidBodyHandle>,\\n    pub visual: Option<Visual>,\\n    /// Reusable procedural asset; its immutable definition is embedded in snapshots.\\n    #[serde(default)]\\n    pub prop: Option<crate::prop_instance::PropInstance>,\\n    pub behavior: Behavior,\\n    #[serde(default)]\\n    pub character: Option<Box<Character>>,\\n    #[serde(default)]\\n    pub bomb: Option<Bomb>,\\n    /// Ticks until the entity despawns by itself (debris).\\n    #[serde(default)]\\n    pub lifetime: Option<u32>,\\n    /// The region (room / terrain chunk) the entity belongs to, for streaming and resets.\\n    #[serde(default)]\\n    pub region: Option<RegionKey>,\\n    #[serde(default)]\\n    pub ma