9,96,32,97,110,100,32,115,116,97,116,101,32,99,104,101,99,107,115,46,32,87,97,105,116,32,111,110,32,115,116,97,116,101,44,32,110,101,118,101,114,32,111,110,32,102,105,120,101,100,32,115,108,101,101,112,115,46,32,83,109,97,108,108,101,115,116,32,118,105,101,119,112,111,114,116,32,116,104,97,116,32,115,116,105,108,108,32,112,114,111,118,101,115,32,116,104,101,32,112,111,105,110,116,32,124,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":16,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/PLAN.md\",\"matches\":[{\"line_number\":71,\"content\":\"### 2.3 Hub harness: confirmed passing on an engine page\"},{\"line_number\":72,\"content\":\"I pasted `lib/hub/session.js` unmodified as the first script in the built page, right after `<meta charset>`, added the `hub:*` metas and a small connect/ready/send/finish shim, and served it with `harness.html`, `bridge.js` and `round.js`. **`window.__hubCheck.pass` was true** for all of these:\"},{\"line_number\":78,\"content\":\"Each software-rendered copy reached `ready()` in under 2.5 s. The harness gives all copies 20 s, so build the session scene small and call `ready()` before the first drawn frame.\"},{\"line_number\":80,\"content\":\"**The game's own card passes too.** With `card:true` and a capture-phase `keydown` listener in the page's JS that calls `AIHub.answer('ready')` on Enter, the harness's extra check passed at 2 and 4 players and in the server case. The harness dispatches a synthetic Enter at the focused element, so answer it in the JS shim rather than waiting for the Rust side.\"},{\"line_number\":234,\"content\":\"| Confirm / back | ✕ / ○ | Enter, Space or click / Esc or RMB |\"},{\"line_number\":499,\"content\":\"**`shared-world`**, seats `1-4`. Your friends are your companions. Read `https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md` whole, and download `session.js`, `harness.html`, `bridge.js` and `round.js` into `hub/`.\"},{\"line_number\":733,\"content\":\"hub/                        session.js, harness.html, bridge.js, round.js as downloaded\"},{\"line_number\":773,\"content\":\"- `window.gameTest`: see §14.3\"},{\"line_number\":794,\"content\":\"| **M0** | Clone, build, register `merc` scene (copy the starter as in `engine/docs/MAKE_A_GAME.md`, which is the first engine page to read), page builds, session client in place, `hub/` downloaded, harness passes with a stub round, title chosen, `tests/run.sh` prints one line | `tests/run.sh` shows 0 failures, harness 4 scenarios pass |\"},{\"line_number\":804,\"content\":\"| **M10** | Session round, own card, netcode, server mode, standalone This computer and Invite code | Loopback test, harness 4 scenarios on the real game, two-page standalone round |\"},{\"line_number\":833,\"content\":\"Rust publishes `window.__game = { status: <JSON string>, ui: <JSON string> }` every 15 ticks and reads commands from `window.gameTest.queue`. `?test=1&nodraw=1` skips scene drawing so the sim runs at speed. These hooks are inert in normal play.\"},{\"line_number\":834,\"content\":\"- Page opens from `file://`, title draws (screenshot past blank), no page errors. Enter, Space, Enter, Space leaves it drawing (this is what the hub's own solo check does).\"},{\"line_number\":843,\"content\":\"### 14.4 Hub\"},{\"line_number\":844,\"content\":\"A script copies the final page beside `hub/*`, serves with `python3 -m http.server 0 --bind 127.0.0.1`, parses the port the OS picked, **fetches the page and confirms its `<title>` is yours before trusting a result**, runs the cases below, and stops only the PID it started (never `pkill`, `killall`, `fuser -k` or whatever holds a port). Other agents share this machine's ports and processes. Assert `window.__hubCheck.pass` for each, with the game opened as `harness.html?game=<page>&…`:\"},{\"line_number\":884,\"content\":\"- [ ] Hub: session client unmodified and first, all four harness cases pass, the on-its-own check passes, standalone multiplayer works over two pages.\"},{\"line_number\":900,\"content\":\"| Software-rendered browser tests are slow | Tests get flaky | Use `?nodraw=1` and state checks. Wait on state, never on fixed sleeps. Smallest viewport that still proves the point |\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-15a5e361-3032-4970-9f47-def3d0756ec0-79","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Device-independent input for one simulation tick. The host (window, agent, replay) fills\\n//! it; the simulation never sees devices. Directions are already in world space.\\n\\nuse glam::{Vec2, Vec3};\\nuse serde::{Deserialize, Serialize};\\n\\npub mod buttons {\\n    pub const JUMP: u32 = 1 << 0;\\n    pub const CROUCH: u32 = 1 << 1;\\n10→    pub const INTERACT: u32 = 1 << 2;\\n    pub const USE: u32 = 1 << 3;\\n    pub const FOCUS: u32 = 1 << 4;\\n    pub const SPRINT: u32 = 1 << 5;\\n    pub const PRIMARY: u32 = 1 << 6;\\n    pub const SECONDARY: u32 = 1 << 7;\\n    pub const CRAWL: u32 = 1 << 8;\\n    /// Shardfall: skill slots 3-6 (slots 1-2 are PRIMARY / SECONDARY), dodge and potion.\\n    pub const SKILL3: u32 = 1 << 9;\\n    pub const SKILL4: u32 = 1 << 10;\\n20→    pub const SKILL5: u32 = 1 << 11;\\n    pub const SKILL6: u32 = 1 << 12;\\n    pub const DODGE: u32 = 1 << 13;\\n    pub const POTION: u32 = 1 << 14;\\n    /// Jam Cry: reload / clear a jam, next weapon, throw, melee, map, monocular, heal, pills, tracker, confirm.\\n    pub const RELOAD: u32 = 1 << 15;\\n    pub const NEXT: u32 = 1 << 16;\\n    pub const THROW: u32 = 1 << 17;\\n    pub const MELEE: u32 = 1 << 18;\\n    pub const MAP: u32 = 1 << 19;\\n30→    pub const MONOCULAR: u32 = 1 << 20;\\n    pub const HEAL: u32 = 1 << 21;\\n    pub const PILLS: u32 = 1 << 22;\\n    pub const TRACKER: u32 = 1 << 23;\\n    pub const CONFIRM: u32 = 1 << 24;\\n\\n    pub const NAMES: &[(&str, u32)] = &[\\n        (\\\"jump\\\", JUMP),\\n        (\\\"crouch\\\", CROUCH),\\n        (\\\"interact\\\", INTERACT),\\n40→        (\\\"use\\\", USE),\\n        (\\\"focus\\\", FOCUS),\\n        (\\\"sprint\\\", SPRINT),\\n        (\\\"primary\\\", PRIMARY),\\n        (\\\"secondary\\\", SECONDARY),\\n        (\\\"crawl\\\", CRAWL),\\n        (\\\"skill3\\\", SKILL3),\\n        (\\\"skill4\\\", SKILL4),\\n        (\\\"skill5\\\", SKILL5),\\n        (\\\"skill6\\\", SKILL6),\\n50→        (\\\"dodge\\\", DODGE),\\n        (\\\"potion\\\", POTION),\\n        (\\\"reload\\\", RELOAD),\\n        (\\\"next\\\", NEXT),\\n        (\\\"throw\\\", THROW),\\n        (\\\"melee\\\", MELEE),\\n        (\\\"map\\\", MAP),\\n        (\\\"monocular\\\", MONOCULAR),\\n        (\\\"heal\\\", HEAL),\\n        (\\\"pills\\\", PILLS),\\n60→        (\\\"tracker\\\", TRACKER),\\n        (\\\"confirm\\\", CONFIRM),\\n    ];\\n\\n    pub fn from_name(n: &str) -> Option<u32> {\\n        NAMES.iter().find(|(k, _)| k.eq_ignore_ascii_case(n)).map(|(_, v)| *v)\\n    }\\n}\\n\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\\n70→pub struct InputFrame {\\n    /// Desired movement on the ground plane: x = world +X, y = world +Z. Length <= 1.\\n    pub move_dir: Vec2,\\n    /// Vertical intent for climbing/flying/swimming (-1..1).\\n    #[serde(default)]\\n    pub vertical: f32,\\n    /// World-space aim point (mouse on the ground plane, or stick projection).\\n    #[serde(default)]\\n    pub aim: Option<Vec3>,\\n    /// Buttons held this tick.\\n80→    #[serde(default)]\",\"content_concise\":\"1→//! Device-independent input for one simulation tick. The host (window, agent, replay) fills\\n//! it; the simulation never sees devices. Directions are already in world space.\\n\\nuse glam::{Vec2, Vec3};\\nuse serde::{Deserialize, Serialize};\\n\\npub mod buttons {\\n    pub const JUMP: u32 = 1 << 0;\\n    pub const CROUCH: u32 = 1 << 1;\\n10→    pub const INTERACT: u32 = 1 << 2;\\n    pub const USE: u32 = 1 << 3;\\n    pub const FOCUS: u32 = 1 << 4;\\n    pub const SPRINT: u32 = 1 << 5;\\n    pub const PRIMARY: u32 = 1 << 6;\\n    pub const SECONDARY: u32 = 1 << 7;\\n    pub const CRAWL: u32 = 1 << 8;\\n    /// Shardfall: skill slots 3-6 (slots 1-2 are PRIMARY / SECONDARY), dodge and potion.\\n    pub const SKILL3: u32 = 1 << 9;\\n    pub const SKILL4: u32 = 1 << 10;\\n20→    pub const SKILL5: u32 = 1 << 11;\\n    pub const SKILL6: u32 = 1 << 12;\\n    pub const DODGE: u32 = 1 << 13;\\n    pub const POTION: u32 = 1 << 14;\\n    /// Jam Cry: reload / clear a jam, next weapon, throw, melee, map, monocular, heal, pills, tracker, confirm.\\n    pub const RELOAD: u32 = 1 << 15;\\n    pub const NEXT: u32 = 1 << 16;\\n    pub const THROW: u32 = 1 << 17;\\n    pub const MELEE: u32 = 1 << 18;\\n    pub const MAP: u32 = 1 << 19;\\n30→    pub const MONOCULAR: u32 = 1 << 20;\\n    pub const HEAL: u32 = 1 << 21;\\n    pub const PILLS: u32 = 1 << 22;\\n    pub const TRACKER: u32 = 1 << 23;\\n    pub const CONFIRM: u32 = 1 << 24;\\n\\n    pub const NAMES: &[(&str, u32)] = &[\\n        (\\\"jump\\\", JUMP),\\n        (\\\"crouch\\\", CROUCH),\\n        (\\\"interact\\\", INTERACT),\\n40→        (\\\"use\\\", USE),\\n        (\\\"focus\\\", FOCUS),\\n        (\\\"sprint\\\", SPRINT),\\n        (\\\"primary\\\", PRIMARY),\\n        (\\\"secondary\\\", SECONDARY),\\n        (\\\"crawl\\\", CRAWL),\\n        (\\\"skill3\\\", SKILL3),\\n        (\\\"skill4\\\", SKILL4),\\n        (\\\"skill5\\\", SKILL5),\\n        (\\\"skill6\\\", SKILL6),\\n50→        (\\\"dodge\\\", DODGE),\\n        (\\\"potion\\\", POTION),\\n        (\\\"reload\\\", RELOAD),\\n        (\\\"next\\\", NEXT),\\n        (\\\"throw\\\", THROW),\\n        (\\\"melee\\\", MELEE),\\n        (\\\"map\\\", MAP),\\n        (\\\"monocular\\\", MONOCULAR),\\n        (\\\"heal\\\", HEAL),\\n        (\\\"pills\\\", PILLS),\\n60→        (\\\"tracker\\\", TRACKER),\\n        (\\\"confirm\\\", CONFIRM),\\n    ];\\n\\n    pub fn from_name(n: &str) -> Option<u32> {\\n        NAMES.iter().find(|(k, _)| k.eq_ignore_ascii_case(n)).map(|(_, v)| *v)\\n    }\\n}\\n\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\\n70→pub struct InputFrame {\\n    /// Desired movement on the ground plane: x = world +X, y = world +Z. Length <= 1.\\n    pub move_dir: Vec2,\\n    /// Vertical intent for climbing/flying/swimming (-1..1).\\n    #[serde(default)]\\n    pub vertical: f32,\\n    /// World-space aim point (mouse on the ground plane, or stick projection).\\n    #[serde(default)]\\n    pub aim: Option<Vec3>,\\n    /// Buttons held this tick.\\n80→    #[serde(default)]\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/input.rs\",\"offset\":null,\"limit\":80,\"raw_output\":\"//! Device-independent input for one simulation tick. The host (window, agent, replay) fills\\n//! it; the simulation never sees devices. Directions are already in world space.\\n\\nuse glam::{Vec2, Vec3};\\nuse serde::{Deserialize, Serialize};\\n\\npub mod buttons {\\n    pub const JUMP: u32 = 1 << 0;\\n    pub const CROUCH: u32 = 1 << 1;\\n    pub const INTERACT: u32 = 1 << 2;\\n    pub const USE: u32 = 1 << 3;\\n    pub const FOCUS: u32 = 1 << 4;\\n    pub const SPRINT: u32 = 1 << 5;\\n    pub const PRIMARY: u32 = 1 << 6;\\n    pub const SECONDARY: u32 = 1 << 7;\\n    pub const CRAWL: u32 = 1 << 8;\\n    /// Shardfall: skill slots 3-6 (slots 1-2 are PRIMARY / SECONDARY), dodge and potion.\\n    pub const SKILL3: u32 = 1 << 9;\\n    pub const SKILL4: u32 = 1 << 10;\\n    pub const SKILL5: u32 = 1 << 11;\\n    pub const SKILL6: u32 = 1 << 12;\\n    pub const DODGE: u32 = 1 << 13;\\n    pub const POTION: u32 = 1 << 14;\\n    /// Jam Cry: reload / clear a jam, next weapon, throw, melee, map, monocular, heal, pills, tracker, confirm.\\n    pub const RELOAD: u32 = 1 << 15;\\n    pub const NEXT: u32 = 1 << 16;\\n    pub const THROW: u32 = 1 << 17;\\n    pub const MELEE: u32 = 1 << 18;\\n    pub const MAP: u32 = 1 << 19;\\n    pub const MONOCULAR: u32 = 1 << 20;\\n    pub const HEAL: u32 = 1 << 21;\\n    pub const PILLS: u32 = 1 << 22;\\n    pub const TRACKER: u32 = 1 << 23;\\n    pub const CONFIRM: u32 = 1 << 24;\\n\\n    pub const NAMES: &[(&str, u32)] = &[\\n        (\\\"jump\\\", JUMP),\\n        (\\\"crouch\\\", CROUCH),\\n        (\\\"interact\\\", INTERACT),\\n        (\\\"use\\\", USE),\\n        (\\\"focus\\\", FOCUS),\\n        (\\\"sprint\\\", SPRINT),\\n        (\\\"primary\\\", PRIMARY),\\n        (\\\"secondary\\\", SECONDARY),\\n        (\\\"crawl\\\", CRAWL),\\n        (\\\"skill3\\\", SKILL3),\\n        (\\\"skill4\\\", SKILL4),\\n        (\\\"skill5\\\", SKILL5),\\n        (\\\"skill6\\\", SKILL6),\\n        (\\\"dodge\\\", DODGE),\\n        (\\\"potion\\\", POTION),\\n        (\\\"reload\\\", RELOAD),\\n        (\\\"next\\\", NEXT),\\n        (\\\"throw\\\", THROW),\\n        (\\\"melee\\\", MELEE),\\n        (\\\"map\\\", MAP),\\n        (\\\"monocular\\\", MONOCULAR),\\n        (\\\"heal\\\", HEAL),\\n        (\\\"pills\\\", PILLS),\\n        (\\\"tracker\\\", TRACKER),\\n        (\\\"confirm\\\", CONFIRM),\\n    ];\\n\\n    pub fn from_name(n: &str) -> Option<u32> {\\n        NAMES.iter().find(|(k, _)| k.eq_ignore_ascii_case(n)).map(|(_, v)| *v)\\n    }\\n}\\n\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\\npub struct InputFrame {\\n    /// Desired movement on the ground plane: x = world +X, y = world +Z. Length <= 1.\\n    pub move_dir: Vec2,\\n    /// Vertical intent for climbing/flying/swimming (-1..1).\\n    #[serde(default)]\\n    pub vertical: f32,\\n    /// World-space aim point (mouse on the ground plane, or stick projection).\\n    #[serde(default)]\\n    pub aim: Option<Vec3>,\\n    /// Buttons held this tick.\\n    #[serde(default)]\\n\",\"total_lines\":106}}","is_error":false},{"type":"tool_result","tool_use_id":"call-15a5e361-3032-4970-9f47-def3d0756ec0-80","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→#!/usr/bin/env python3\\n\\\"\\\"\\\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\\n\\nusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\\n           [--theme-color C] [--scene NAME] [--out PATH]\\n\\nBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\\n--single-file makes it and runs this. The page is web/index.html with the options written into\\nits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\\n10→given), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\\nloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\\ninline module script. The loader shows a progress line, bakes in --scene (used when the address\\nnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\\nURLs are needed. Out: target/web/<title>.html.\\n\\\"\\\"\\\"\\nimport argparse\\nimport base64\\nimport gzip\\nimport html\\n20→import json\\nimport pathlib\\nimport re\\nimport sys\\n\\nROOT = pathlib.Path(__file__).resolve().parent.parent\\nPAGE = ROOT / \\\"web\\\" / \\\"index.html\\\"\\n\\n# Runs while the page parses, before index.html's module script.\\nLOADER = \\\"\\\"\\\"\\n30→(() => {\\n  const msg = document.getElementById('msg');\\n  // The start scene baked in at build time, unless the address names a room or a scene.\\n  const scene = __SCENE__, query = new URLSearchParams(location.search);\\n  if (scene && !query.get('room') && !query.get('scene')) {\\n    query.set('scene', scene);\\n    try { history.replaceState(history.state, '', '?' + query + location.hash); }\\n    catch (error) { console.warn('Could not put the start scene in the address:', error); }\\n  }\\n  const line = document.createElement('div');\\n40→  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\\n  msg.style.flexDirection = 'column';\\n  msg.style.gap = '8px';\\n  msg.replaceChildren(`Loading ${document.title}…`, line);\\n  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\\n  // The JS glue is the module script at the end of the page: it hands over its init function.\\n  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\\n  window.loadGame = async () => {\\n    line.textContent = 'Unpacking…';\\n    await paint();\\n50→    // The gzipped wasm's base64 block leaves the page once read, to free its text.\\n    const block = document.getElementById('game-wasm'), size = +block.dataset.size, text = block.textContent;\\n    block.remove();\\n    let packed;\\n    if (Uint8Array.fromBase64) packed = Uint8Array.fromBase64(text);\\n    else {\\n      const bin = atob(text);\\n      packed = new Uint8Array(bin.length);\\n      for (let i = 0; i < bin.length; i++) packed[i] = bin.charCodeAt(i);\\n    }\\n60→    const wasm = new Uint8Array(size);\\n    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();\\n    let n = 0;\\n    for (let r = await reader.read(); !r.done; r = await reader.read()) {\\n      wasm.set(r.value, n);\\n      n += r.value.length;\\n      line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;\\n    }\\n    if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);\\n    line.textContent = 'Starting…';\\n70→    await paint();\\n    const init = await glue;\\n    await init({ module_or_path: wasm });\\n  };\\n})();\\n\\\"\\\"\\\"\\n\\n\\ndef fail(text):\\n    sys.exit(f\\\"pack_single_html: {text}\\\")\\n80→\",\"content_concise\":\"1→#!/usr/bin/env python3\\n\\\"\\\"\\\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\\n\\nusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\\n           [--theme-color C] [--scene NAME] [--out PATH]\\n\\nBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\\n--single-file makes it and runs this. The page is web/index.html with the options written into\\nits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\\n10→given), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\\nloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\\ninline module script. The loader shows a progress line, bakes in --scene (used when the address\\nnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\\nURLs are needed. Out: target/web/<title>.html.\\n\\\"\\\"\\\"\\nimport argparse\\nimport base64\\nimport gzip\\nimport html\\n20→import json\\nimport pathlib\\nimport re\\nimport sys\\n\\nROOT = pathlib.Path(__file__).resolve().parent.parent\\nPAGE = ROOT / \\\"web\\\" / \\\"index.html\\\"\\n\\n# Runs while the page parses, before index.html's module script.\\nLOADER = \\\"\\\"\\\"\\n30→(() => {\\n  const msg = document.getElementById('msg');\\n  // The start scene baked in at build time, unless the address names a room or a scene.\\n  const scene = __SCENE__, query = new URLSearchParams(location.search);\\n  if (scene && !query.get('room') && !query.get('scene')) {\\n    query.set('scene', scene);\\n    try { history.replaceState(history.state, '', '?' + query + location.hash); }\\n    catch (error) { console.warn('Could not put the start scene in the address:', error); }\\n  }\\n  const line = document.createElement('div');\\n40→  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\\n  msg.style.flexDirection = 'column';\\n  msg.style.gap = '8px';\\n  msg.replaceChildren(`Loading ${document.title}…`, line);\\n  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\\n  // The JS glue is the module script at the end of the page: it hands over its init function.\\n  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\\n  window.loadGame = async () => {\\n    line.textContent = 'Unpacking…';\\n    await paint();\\n50→    // The gzipped wasm's base64 block leaves the page once read, to free its text.\\n    const block = document.getElementById('game-wasm'), size = +block.dataset.size, text = block.textContent;\\n    block.remove();\\n    let packed;\\n    if (Uint8Array.fromBase64) packed = Uint8Array.fromBase64(text);\\n    else {\\n      const bin = atob(text);\\n      packed = new Uint8Array(bin.length);\\n      for (let i = 0; i < bin.length; i++) packed[i] = bin.charCodeAt(i);\\n    }\\n60→    const wasm = new Uint8Array(size);\\n    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();\\n    let n = 0;\\n    for (let r = await reader.read(); !r.done; r = await reader.read()) {\\n      wasm.set(r.value, n);\\n      n += r.value.length;\\n      line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;\\n    }\\n    if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);\\n    line.textContent = 'Starting…';\\n70→    await paint();\\n    const init = await glue;\\n    await init({ module_or_path: wasm });\\n  };\\n})();\\n\\\"\\\"\\\"\\n\\n\\ndef fail(text):\\n    sys.exit(f\\\"pack_single_html: {text}\\\")\\n80→\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/scripts/pack_single_html.py\",\"offset\":null,\"limit\":80,\"raw_output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\\n\\nusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\\n           [--theme-color C] [--scene NAME] [--out PATH]\\n\\nBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\\n--single-file makes it and runs this. The page is web/index.html with the options written into\\nits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\\ngiven), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\\nloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\\ninline module script. The loader shows a progress line, bakes in --scene (used when the address\\nnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\\nURLs are needed. Out: target/web/<title>.html.\\n\\\"\\\"\\\"\\nimport argparse\\nimport base64\\nimport gzip\\nimport html\\nimport json\\nimport pathlib\\nimport re\\nimport sys\\n\\nROOT = pathlib.Path(__file__).resolve().parent.parent\\nPAGE = ROOT / \\\"web\\\" / \\\"index.html\\\"\\n\\n# Runs while the page parses, before index.html's module script.\\nLOADER = \\\"\\\"\\\"\\n(() => {\\n  const msg = document.getElementById('msg');\\n  // The start scene baked in at build time, unless the address names a room or a scene.\\n  const scene = __SCENE__, query = new URLSearchParams(location.search);\\n  if (scene && !query.get('room') && !query.get('scene')) {\\n    query.set('scene', scene);\\n    try { history.replaceState(history.state, '', '?' + query + location.hash); }\\n    catch (error) { console.warn('Could not put the start scene in the address:', error); }\\n  }\\n  const line = document.createElement('div');\\n  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\\n  msg.style.flexDirection = 'column';\\n  msg.style.gap = '8px';\\n  msg.replaceChildren(`Loading ${document.title}…`, line);\\n  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\\n  // The JS glue is the module script at the end of the page: it hands over its init function.\\n  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\\n  window.loadGame = async () => {\\n    line.textContent = 'Unpacking…';\\n    await paint();\\n    // The gzipped wasm's base64 block leaves the page once read, to free its text.\\n    const block = document.getElementById('game-wasm'), size = +block.dataset.size, text = block.textContent;\\n    block.remove();\\n    let packed;\\n    if (Uint8Array.fromBase64) packed = Uint8Array.fromBase64(text);\\n    else {\\n      const bin = atob(text);\\n      packed = new Uint8Array(bin.length);\\n      for (let i = 0; i < bin.length; i++) packed[i] = bin.charCodeAt(i);\\n    }\\n    const wasm = new Uint8Array(size);\\n    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();\\n    let n = 0;\\n    for (let r = await reader.read(); !r.done; r = await reader.read()) {\\n      wasm.set(r.value, n);\\n      n += r.value.length;\\n      line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;\\n    }\\n    if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);\\n    line.textContent = 'Starting…';\\n    await paint();\\n    const init = await glue;\\n    await init({ module_or_path: wasm });\\n  };\\n})();\\n\\\"\\\"\\\"\\n\\n\\ndef fail(text):\\n    sys.exit(f\\\"pack_single_html: {text}\\\")\\n\\n\",\"total_lines\":150}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"3415d057-6bdb-4996-b3ce-9700f950d81b"}
{"type":"assistant","message":{"id":"msg_193","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Checking PLAN.md sections 14 and 14.3 for the gameTest command format.","signature":"e64WmEpOEb6G8at+HttpMsK4knlhrSwfiArCs9Wryg3AcTwXFPzO1431TdjchPR23cqXIREaIImbs6ZRDXQUy4hLxY84IAq/W53K7dS6xOZPrQzXLAaZirE6nWJcMvc4ZhrgV9YzG8gDqbemAO0pwt7ftbwDbLbgLW9p8Gjq31ffyVAmYQVP678oNOHNINbkNYHLwCS17IczlyeuJcwOC0qK678PqkHN7nI"},{"type":"tool_use","id":"call-48259eb8-f847-43a8-9876-524522975b6a-81","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/PLAN.md","offset":760,"limit":140}},{"type":"tool_use","id":"call-48259eb8-f847-43a8-9876-524522975b6a-82","name":"grep","input":{"pattern":"fn shell_tick|fn rows|act ==","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3981,"output_tokens":197,"cache_read_input_tokens":144256,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"5dfb1140-2cd7-4769-a1c6-d72134c3c0f5"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-48259eb8-f847-43a8-9876-524522975b6a-81","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"760→`pav_app/input.rs` gets a third layout for this game (§4), and `poll_gamepad` passes trigger analog values. Mouse look on the web: read `movementX/Y` in the JS shim (§12.5), which is simplest to test (§2.4). Native can use `DeviceEvent::MouseMotion`. `move_dir` stays world-space: rotate the stick by yaw. Only Esc stays a system key outside dev mode.\\n\\n### 12.4 Game to view and UI\\n- Add `Game::frame_extra` or a typed field `RenderFrame.merc: Option<Arc<MercFrame>>`, like the existing `game: Option<Arc<GameFrame>>`. `MercFrame` holds what the view and UI need: FP state, viewmodel state, inventory, prompts, map data version, burn deltas, wind, time.\\n- `pav_view::merc::draw(scene, frame)` runs inside `ViewBuilder::build`.\\n- `pav_ui::tenfoot` draws over it, and also from `headless.rs` so `pav capture` and `ui` see it.\\n- All game state stays in the `Game` struct or entities (`Clone`, serde). View caches are `#[serde(skip)]` or live in the view.\\n- Randomness only from `sim.state.rng`. No clock, no `HashMap` order reaching state. The \\\"Key rules\\\" in `engine/AGENTS.md` apply to your game; its maintainers' workflow (history, PRs, escalations) does not.\\n\\n### 12.5 Web layer\\n770→`engine/web/index.html` gets, in order: `<meta charset>`, session client, hub metas, then a plain script defining:\\n- `window.gameNet`: `init`, `send(json, reliable, to)`, `poll()` (drains a JSON string array), hub events queued, standalone transports\\n- `window.gameInput`: pointer lock request, `movementX/Y` accumulation, lock-change flag, `(any-pointer: fine)`\\n- `window.gameTest`: see §14.3\\n\\nRust calls them through `#[wasm_bindgen] extern \\\"C\\\"` with `js_namespace`, or `js_sys::Reflect`. No snippets (§2.1). Keep the glue free of the literal strings `<script`, `</script` and `<!--`.\\n\\n`tools/build-game.sh` runs `engine/scripts/build-web.sh --single-file --scene merc --title \\\"<title>\\\" --description \\\"<line>\\\" --theme-color \\\"#2a2420\\\" --out <the final path TASK.md names>`, then confirms the size, the first-script position and that `session.js` is byte-identical.\\n\\n### 12.6 Data and tools for later designers\\n780→All balance, weapons, enemies, contracts, text, shop, attract, map features and compounds are data, embedded at build time and re-read from disk in native tools. Add `pav` tools (`engine/AGENTS.md`, \\\"Adding a tool\\\"):\\n- `mapshot` (top-down PNG of terrain, POIs, roads, burn state)\\n- `fire` (start, step, report)\\n- `merc_cmd` (any `act`)\\n\\nThis, with `room_check`, `asset_edit`, `anim_edit`, `animsheet`, `filmstrip` and dev mode, is the designer toolchain TASK.md asks for.\\n\\n---\\n\\n## 13. Build order\\n790→Each milestone ends with its tests in the one command. Commit to your engine clone's git as you go. **Never use subagents or workflows to debate, review, judge or audit.**\\n\\n| M | Build | Done when |\\n|---|---|---|\\n| **M0** | Clone, build, register `merc` scene (copy the starter as in `engine/docs/MAKE_A_GAME.md`, which is the first engine page to read), page builds, session client in place, `hub/` downloaded, harness passes with a stub round, title chosen, `tests/run.sh` prints one line | `tests/run.sh` shows 0 failures, harness 4 scenarios pass |\\n| **M1** | First-person camera, input layer, pointer lock, gamepad layout, `tenfoot` prompts, viewmodel with the rifle (hands on sockets, sway, recoil, reload, the red rag), hitscan, a target dummy, sky dome, NO_FOG | Sim tests for look, move and hits pass. A 1920×1080 screenshot looks like a game you'd play. **Fix the look now: everything depends on it.** |\\n| **M2** | Terrain and `world.toml`, biomes, roads, river, rings, grass and trees, time of day, stamps on pads, town blocked out, `mapshot` | `mapshot` shows the whole map. Bot walks airstrip to town. Screenshots at dawn, noon, dusk and night |\\n| **M3** | Full weapon table, condition and jams, damage and treatments, NPC roles, detection, cover, guard post | Bot clears a post on 10 seeds. Jam, wear and detection tests pass |\\n| **M4** | Fire, wind, smoke, burn visuals, explosions, weather, AI reactions | Fire tests (§14.1). Depot fire screenshot makes you want to play |\\n| **M5** | Vehicles on slopes, relative controls, boat, seats, mounted gun, damage and repair, AI pursuit | Bot drives the road end to end. Boat and repair tests pass |\\n800→| **M6** | Fever, safe houses, sleep, economy and shop, map and GPS and monocular, tracker and caches, tapes, saves | Tests for each. Save and reload round trip |\\n| **M7** | Companions, contracts A0 to D2, endings, barks, Infamy, campaign bot, coverage flags | **Scripted playthrough reaches all three endings with every coverage flag set** |\\n| **M8** | Audio buses, SFX, music, voices | Audio tests pass, default music gain 0.10 |\\n| **M9** | Shell: title, settings, pause, dev mode, attract, touch-only, About | Browser tests pass (§14.3) |\\n| **M10** | Session round, own card, netcode, server mode, standalone This computer and Invite code | Loopback test, harness 4 scenarios on the real game, two-page standalone round |\\n| **M11** | Art pass on every prop, animation pass on every clip, writing pass on every line, balance with sliders, final build, About/Credits, exit interview | §16 checklist complete |\\n\\n---\\n\\n## 14. Testing (TASK.md: one command, only failures and a one-line count)\\n810→`tests/run.sh [sim|ui|audio|browser|hub|all]` prints each failure's name and reason, then one line like `PASS 212 FAIL 0`. Rerun only the part you changed. Use screenshots only for what a script can't check.\\n\\n### 14.1 Sim (`engine/crates/pav_core/tests/merc.rs`, native, fast)\\n- **Foundations:** boots on 3 seeds. Same seed and inputs give the same hash; `record_save` and `replay` hold. Snapshot round trip. Data lint: every TOML parses, every asset and clip named exists, every string key resolves, and no string contains TODO, TBD, placeholder or lorem.\\n- **Player:** look clamps, stick movement follows yaw, stances change eye and capsule height, hard landing wound.\\n- **Weapons:** head, torso and limb multipliers. Wall blocks shots. Wear per table. Jam rate within tolerance at c = 35 over 5,000 rolls. Jam blocks firing until cleared. Weapon breaks. An NPC's gun jams and it stops firing.\\n- **Fire:** wind 8 m/s downwind reach ≥ 3× upwind after 60 s. Calm spread is roughly round. Roads and river stop it unless embers jump. Burnt cells don't re-burn, then regrow. Rain extinguishes. Barrel explodes and ignites. NPCs leave burning cells. A burning NPC spreads fire. Fuel tank cooks off. Snapshot size stays small after a big burn.\\n- **Detection:** the grass, night and posture comparisons of §5.10. Noise brings investigators. Smoke blocks sight.\\n- **AI:** squad takes cover and at least one flanker repositions. Max 4 shooters at once. Morale break. Post re-mans after its timer and never in the player's sight.\\n- **Survival:** warning precedes attack. Pill clears it. No pill means black-out, wake at safe house, fee taken. Syrette and treatments restore the right amounts. Wound type follows damage cause.\\n820→- **Companions:** rescue fires once per rest and player stands up at 50. Downed companion timer. Patch and overdose. Death stays dead across save and load.\\n- **Vehicles:** climbs the ridge road. Recovers from a roll. Damage stages. Repair. Explodes and ignites grass. Boat floats and stops at shallows. NPC driver follows the road. Seat changes.\\n- **Economy and saves:** buying with too few diamonds changes nothing. Tracker rate rises near a cache. Save and load restores all listed fields.\\n- **Contracts:** each contract completes under the bot on 2 seeds, and each failure condition fires.\\n- **Scripted playthrough of the whole game:** the bot plays new game through each of the three endings using only inputs and `act`s (no teleporting except the bus, no cheats, normal difficulty). Assert the outcome is reached, all `coverage` flags are set, and wall time is under a limit you set (this must stay cheap enough to rerun). Expose it through `Game::bot`, so `pav play bot=true seeds=3` works too.\\n- **Attract:** five full loops, every segment reached, never stuck, no save written.\\n- **Netcode loopback:** host and client `Sim`s on the in-memory link at 150 ms, jitter 50, 5% loss. Both see the same fire cells within 1 s, kills and objectives agree, `finish` is issued once, unreliable messages stay under 1,200 bytes and sends stay under 20 per second. A client leaving and the host leaving both behave.\\n\\n### 14.2 UI and audio (native)\\n- **UI** (`MenuInput`): focus moves and wraps, back works, no screen exceeds 7 rows, hover moves focus, glyphs follow device and setting, dev sliders change `Tunable`s and Reset restores defaults, attract starts at 10 s of idle and not before, any input exits.\\n830→- **Audio** (`render_events`, offline): music bus RMS at default ÷ RMS at full is 0.10 ± 0.01. No NaN or clipping. Each gun family differs from the others. Crackle level rises with burning cells. Voice output is non-silent, differs by speaker. `find engine -name '*.wav' -o -name '*.mp3' -o -name '*.ogg'` finds nothing of ours.\\n\\n### 14.3 Browser (Playwright on the real page, flags from §2.2; one or two browsers at a time)\\nRust publishes `window.__game = { status: <JSON string>, ui: <JSON string> }` every 15 ticks and reads commands from `window.gameTest.queue`. `?test=1&nodraw=1` skips scene drawing so the sim runs at speed. These hooks are inert in normal play.\\n- Page opens from `file://`, title draws (screenshot past blank), no page errors. Enter, Space, Enter, Space leaves it drawing (this is what the hub's own solo check does).\\n- **Controls:** keyboard, mouse hover and click, pad stub (§2.4). Prompts follow the device. Xbox setting changes glyphs. Synthetic mouse changes yaw under pointer lock. Lock lost opens pause.\\n- **Idle:** no input for 10 s starts attract. A key, a pad press or a mouse move exits it.\\n- **Touch-only:** Chromium with a phone profile (`has_touch`, `is_mobile`) shows \\\"Controller or keyboard required\\\" and a tappable Settings. No touch controls appear. Attract runs. Also check that WebKit (which has no WebGPU here) shows the page's clear message rather than a blank page.\\n- **Dev mode** from pause: toggle God mode, move a slider and see the value in status, Reset.\\n- **Saves:** save, reload, Continue, from `file://`.\\n840→- **Audio:** `status.audio.music == 0.10`. An init script wraps `AudioNode.connect` to add an analyser before the destination, and levels are non-zero after a gesture.\\n- **About** contains every Source Information field, and all feedback sections are filled.\\n\\n### 14.4 Hub\\nA script copies the final page beside `hub/*`, serves with `python3 -m http.server 0 --bind 127.0.0.1`, parses the port the OS picked, **fetches the page and confirms its `<title>` is yours before trusting a result**, runs the cases below, and stops only the PID it started (never `pkill`, `killall`, `fuser -k` or whatever holds a port). Other agents share this machine's ports and processes. Assert `window.__hubCheck.pass` for each, with the game opened as `harness.html?game=<page>&…`:\\n- `players=2&auto=1`\\n- `players=4&latency=150&jitter=50&loss=5&auto=1`\\n- `players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1`\\n- `players=2&scenario=server&auto=1`\\n\\n850→Also: two pages (or contexts) play the standalone round over `BroadcastChannel` and over a copy-pasted WebRTC code through to the results. Then the on-its-own check: client inactive, `Math.random` untouched.\\n\\n### 14.5 Screenshots worth taking (1920×1080, 10-foot judgment)\\nGolden hour on the plain, the depot fire at night, the viewmodel with each weapon class, wound treatment mid-animation, map in hand, title, shop, settings, pause, dev balance page, the bar. Check that text is readable from the couch. Fix what looks wrong.\\n\\n---\\n\\n## 15. Feature list for the coverage flags, and what ships in About/Credits\\n\\n**Coverage flags (each set by real play; a test passes on the union across the three playthrough runs, since no single run can both save and lose the same companion or reach every ending):** map raised, waypoint set, GPS followed, monocular tag, wind rag visible at speed > 6, jam cleared, enemy jam seen, weapon broke, weapon bought, locker used, syrette, each wound treatment type, fever warned, pill taken, black-out (bot route), player rescued, companion patched, companion overdosed, companion died, better-way taken, fire lit by each igniter class, 500+ cells burned in one fire, enemy panicked, animals fled, explosion chain, rain extinguished, stealth kill, dart kill, night contract, sleep used, safe house claimed, post cleared, post re-manned, technical driven, mounted gun fired, repair done, boat driven, bus taken, tape played, cache found by tracker, diamonds spent, each contract, ceasefire ended, town burned, each ending.\\n860→\\n**About/Credits (paged, large text, also in your chat reply, per TASK.md):**\\n- **Source Information:** every field in TASK.md's list, with the values TASK.md gives (Date, Environment, Model) and `added on import` for Usage. Write `unknown` for what you can't confirm.\\n- **Testing Feedback, Engine Feedback, Prompt Feedback:** your answers to each question. Keep `notes/feedback.md` as you go: count issues caught, note the critical ones, note every time you read engine source and why.\\n- **Credits:** engine, clip libraries with their licences (from `pav clips name=…`), fonts, this plan.\\n\\n**Exit interview:** write it exactly as TASK.md's shape, beside the final HTML, and check it parses. Suggested `aiHub` values: `type` Game, `genre` Shooter, `source` Far Cry 2, `series` Far Cry, `players` 1–4, `controls` \\\"Stick or WASD move · R2 or left mouse fire · L2 or right mouse aim · Square or R reload and clear jams · D-pad or M for the map\\\", `tags` `[\\\"3d\\\",\\\"first-person\\\",\\\"co-op\\\",\\\"story\\\",\\\"vehicles\\\",\\\"exploration\\\"]`. Fill `name`, `tagline`, `description` in the game's voice.\\n\\n---\\n\\n870→## 16. Done\\n\\nEvery line must be true before you stop:\\n\\n- [ ] Original title by TASK.md's process, on the title screen. No names from §1.4.\\n- [ ] One self-contained HTML file with the name and location TASK.md gives. Opens from `file://` in Chrome or Edge with WebGPU.\\n- [ ] First-person game, on the Pavilion engine, native style extended with new assets and animations.\\n- [ ] All systems in §5 present. All contracts in §11 playable. Three endings. No TODOs, placeholders or stubs anywhere, including in text.\\n- [ ] Demo long enough to show everything: playthrough asserts all coverage flags.\\n- [ ] Music defaults to 10%. All sound, music and gibberish voices are generated in code.\\n880→- [ ] Dev mode reachable from pause: tools, live sliders, reset to defaults.\\n- [ ] Attract mode after 10 s of idle on title and menus, loops, any input exits.\\n- [ ] Controller first: every screen works on a DualSense (stubbed) with PlayStation glyphs, Xbox glyph option, keyboard and mouse native with their own prompts, hover moves focus, clicks work, no dense screens.\\n- [ ] Touch-only: no touch controls, the required message, a Settings button, attract running.\\n- [ ] Hub: session client unmodified and first, all four harness cases pass, the on-its-own check passes, standalone multiplayer works over two pages.\\n- [ ] `tests/run.sh all` prints 0 failures and a one-line count.\\n- [ ] Source Information, Testing, Engine and Prompt Feedback are in About/Credits and your chat reply. Exit interview saved and parses.\\n- [ ] Your background processes are stopped, by PID. No stray files outside your folder.\\n\\n---\\n890→\\n## 17. Risks I would watch\\n\\n| Risk | Why it matters | What to do |\\n|---|---|---|\\n| Up-close look of capsule arms and primitive guns | The whole game is viewed through them | Look test at M1. Add part detail (sights, rivets, tape on grips), use materials, keep outlines on objects. If SDF capsules look wrong that close, use rounded-box or mesh parts for hands |\\n| Grass reads as noise in first person | Half the screen | Tune colour variation, clump size, no outlines on environment. Grass must read as a surface, not a scatter. Compare screenshots |\\n| Bot complexity for a full playthrough | It's a required test | Keep contracts as objective graphs that expose a `Goal`. Build the bot as you add each contract, never at the end |\\n| Long rebuilds (about 2 min each for `pav`, the test binary and wasm) | Time | Put numbers in TOML and use `pav_core`'s disk read path for data. Batch code edits. Use `cargo test --test merc <filter>` |\\n| Vehicle physics on slopes | Rapier raycast cars can jitter on trimeshes | Keep `FIX_INTERNAL_EDGES`, smooth road corridors, cap angular velocity, add upright assist |\",\"content_concise\":\"760→`pav_app/input.rs` gets a third layout for this game (§4), and `poll_gamepad` passes trigger analog values. Mouse look on the web: read `movementX/Y` in the JS shim (§12.5), which is simplest to test (§2.4). Native can use `DeviceEvent::MouseMotion`. `move_dir` stays world-space: rotate the stick by yaw. Only Esc stays a system key outside dev mode.\\n\\n### 12.4 Game to view and UI\\n- Add `Game::frame_extra` or a typed field `RenderFrame.merc: Option<Arc<MercFrame>>`, like the existing `game: Option<Arc<GameFrame>>`. `MercFrame` holds what the view and UI need: FP state, viewmodel state, inventory, prompts, map data version, burn deltas, wind, time.\\n- `pav_view::merc::draw(scene, frame)` runs inside `ViewBuilder::build`.\\n- `pav_ui::tenfoot` draws over it, and also from `headless.rs` so `pav capture` and `ui` see it.\\n- All game state stays in the `Game` struct or entities (`Clone`, serde). View caches are `#[serde(skip)]` or live in the view.\\n- Randomness only from `sim.state.rng`. No clock, no `HashMap` order reaching state. The \\\"Key rules\\\" in `engine/AGENTS.md` apply to your game; its maintainers' workflow (history, PRs, escalations) does not.\\n\\n### 12.5 Web layer\\n770→`engine/web/index.html` gets, in order: `<meta charset>`, session client, hub metas, then a plain script defining:\\n- `window.gameNet`: `init`, `send(json, reliable, to)`, `poll()` (drains a JSON string array), hub events queued, standalone transports\\n- `window.gameInput`: pointer lock request, `movementX/Y` accumulation, lock-change flag, `(any-pointer: fine)`\\n- `window.gameTest`: see §14.3\\n\\nRust calls them through `#[wasm_bindgen] extern \\\"C\\\"` with `js_namespace`, or `js_sys::Reflect`. No snippets (§2.1). Keep the glue free of the literal strings `<script`, `</script` and `<!--`.\\n\\n`tools/build-game.sh` runs `engine/scripts/build-web.sh --single-file --scene merc --title \\\"<title>\\\" --description \\\"<line>\\\" --theme-color \\\"#2a2420\\\" --out <the final path TASK.md names>`, then confirms the size, the first-script position and that `session.js` is byte-identical.\\n\\n### 12.6 Data and tools for later designers\\n780→All balance, weapons, enemies, contracts, text, shop, attract, map features and compounds are data, embedded at build time and re-read from disk in native tools. Add `pav` tools (`engine/AGENTS.md`, \\\"Adding a tool\\\"):\\n- `mapshot` (top-down PNG of terrain, POIs, roads, burn state)\\n- `fire` (start, step, report)\\n- `merc_cmd` (any `act`)\\n\\nThis, with `room_check`, `asset_edit`, `anim_edit`, `animsheet`, `filmstrip` and dev mode, is the designer toolchain TASK.md asks for.\\n\\n---\\n\\n## 13. Build order\\n790→Each milestone ends with its tests in the one command. Commit to your engine clone's git as you go. **Never use subagents or workflows to debate, review, judge or audit.**\\n\\n| M | Build | Done when |\\n|---|---|---|\\n| **M0** | Clone, build, register `merc` scene (copy the starter as in `engine/docs/MAKE_A_GAME.md`, which is the first engine page to read), page builds, session client in place, `hub/` downloaded, harness passes with a stub round, title chosen, `tests/run.sh` prints one line | `tests/run.sh` shows 0 failures, harness 4 scenarios pass |\\n| **M1** | First-person camera, input layer, pointer lock, gamepad layout, `tenfoot` prompts, viewmodel with the rifle (hands on sockets, sway, recoil, reload, the red rag), hitscan, a target dummy, sky dome, NO_FOG | Sim tests for look, move and hits pass. A 1920×1080 screenshot looks like a game you'd play. **Fix the look now: everything depends on it.** |\\n| **M2** | Terrain and `world.toml`, biomes, roads, river, rings, grass and trees, time of day, stamps on pads, town blocked out, `mapshot` | `mapshot` shows the whole map. Bot walks airstrip to town. Screenshots at dawn, noon, dusk and night |\\n| **M3** | Full weapon table, condition and jams, damage and treatments, NPC roles, detection, cover, guard post | Bot clears a post on 10 seeds. Jam, wear and detection tests pass |\\n| **M4** | Fire, wind, smoke, burn visuals, explosions, weather, AI reactions | Fire tests (§14.1). Depot fire screenshot makes you want to play |\\n| **M5** | Vehicles on slopes, relative controls, boat, seats, mounted gun, damage and repair, AI pursuit | Bot drives the road end to end. Boat and repair tests pass |\\n800→| **M6** | Fever, safe houses, sleep, economy and shop, map and GPS and monocular, tracker and caches, tapes, saves | Tests for each. Save and reload round trip |\\n| **M7** | Companions, contracts A0 to D2, endings, barks, Infamy, campaign bot, coverage flags | **Scripted playthrough reaches all three endings with every coverage flag set** |\\n| **M8** | Audio buses, SFX, music, voices | Audio tests pass, default music gain 0.10 |\\n| **M9** | Shell: title, settings, pause, dev mode, attract, touch-only, About | Browser tests pass (§14.3) |\\n| **M10** | Session round, own card, netcode, server mode, standalone This computer and Invite code | Loopback test, harness 4 scenarios on the real game, two-page standalone round |\\n| **M11** | Art pass on every prop, animation pass on every clip, writing pass on every line, balance with sliders, final build, About/Credits, exit interview | §16 checklist complete |\\n\\n---\\n\\n## 14. Testing (TASK.md: one command, only failures and a one-line count)\\n810→`tests/run.sh [sim|ui|audio|browser|hub|all]` prints each failure's name and reason, then one line like `PASS 212 FAIL 0`. Rerun only the part you changed. Use screenshots only for what a script can't check.\\n\\n### 14.1 Sim (`engine/crates/pav_core/tests/merc.rs`, native, fast)\\n- **Foundations:** boots on 3 seeds. Same seed and inputs give the same hash; `record_save` and `replay` hold. Snapshot round trip. Data lint: every TOML parses, every asset and clip named exists, every string key resolves, and no string contains TODO, TBD, placeholder or lorem.\\n- **Player:** look clamps, stick movement follows yaw, stances change eye and capsule height, hard landing wound.\\n- **Weapons:** head, torso and limb multipliers. Wall blocks shots. Wear per table. Jam rate within tolerance at c = 35 over 5,000 rolls. Jam blocks firing until cleared. Weapon breaks. An NPC's gun jams and it stops firing.\\n- **Fire:** wind 8 m/s downwind reach ≥ 3× upwind after 60 s. Calm spread is roughly round. Roads and river stop it unless embers jump. Burnt cells don't re-burn, then regrow. Rain extinguishes. Barrel explodes and ignites. NPCs leave burning cells. A burning NPC spreads fire. Fuel tank cooks off. Snapshot size stays small after a big burn.\\n- **Detection:** the grass, night and posture comparisons of §5.10. Noise brings investigators. Smoke blocks sight.\\n- **AI:** squad takes cover and at least one flanker repositions. Max 4 shooters at once. Morale break. Post re-mans after its timer and never in the player's sight.\\n- **Survival:** warning precedes attack. Pill clears it. No pill means black-out, wake at safe house, fee taken. Syrette and treatments restore the right amounts. Wound type follows damage cause.\\n820→- **Companions:** rescue fires once per rest and player stands up at 50. Downed companion timer. Patch and overdose. Death stays dead across save and load.\\n- **Vehicles:** climbs the ridge road. Recovers from a roll. Damage stages. Repair. Explodes and ignites grass. Boat floats and stops at shallows. NPC driver follows the road. Seat changes.\\n- **Economy and saves:** buying with too few diamonds changes nothing. Tracker rate rises near a cache. Save and load restores all listed fields.\\n- **Contracts:** each contract completes under the bot on 2 seeds, and each failure condition fires.\\n- **Scripted playthrough of the whole game:** the bot plays new game through each of the three endings using only inputs and `act`s (no teleporting except the bus, no cheats, normal difficulty). Assert the outcome is reached, all `coverage` flags are set, and wall time is under a limit you set (this must stay cheap enough to rerun). Expose it through `Game::bot`, so `pav play bot=true seeds=3` works too.\\n- **Attract:** five full loops, every segment reached, never stuck, no save written.\\n- **Netcode loopback:** host and client `Sim`s on the in-memory link at 150 ms, jitter 50, 5% loss. Both see the same fire cells within 1 s, kills and objectives agree, `finish` is issued once, unreliable messages stay under 1,200 bytes and sends stay under 20 per second. A client leaving and the host leaving both behave.\\n\\n### 14.2 UI and audio (native)\\n- **UI** (`MenuInput`): focus moves and wraps, back works, no screen exceeds 7 rows, hover moves focus, glyphs follow device and setting, dev sliders change `Tunable`s and Reset restores defaults, attract starts at 10 s of idle and not before, any input exits.\\n830→- **Audio** (`render_events`, offline): music bus RMS at default ÷ RMS at full is 0.10 ± 0.01. No NaN or clipping. Each gun family differs from the others. Crackle level rises with burning cells. Voice output is non-silent, differs by speaker. `find engine -name '*.wav' -o -name '*.mp3' -o -name '*.ogg'` finds nothing of ours.\\n\\n### 14.3 Browser (Playwright on the real page, flags from §2.2; one or two browsers at a time)\\nRust publishes `window.__game = { status: <JSON string>, ui: <JSON string> }` every 15 ticks and reads commands from `window.gameTest.queue`. `?test=1&nodraw=1` skips scene drawing so the sim runs at speed. These hooks are inert in normal play.\\n- Page opens from `file://`, title draws (screenshot past blank), no page errors. Enter, Space, Enter, Space leaves it drawing (this is what the hub's own solo check does).\\n- **Controls:** keyboard, mouse hover and click, pad stub (§2.4). Prompts follow the device. Xbox setting changes glyphs. Synthetic mouse changes yaw under pointer lock. Lock lost opens pause.\\n- **Idle:** no input for 10 s starts attract. A key, a pad press or a mouse move exits it.\\n- **Touch-only:** Chromium with a phone profile (`has_touch`, `is_mobile`) shows \\\"Controller or keyboard required\\\" and a tappable Settings. No touch controls appear. Attract runs. Also check that WebKit (which has no WebGPU here) shows the page's clear message rather than a blank page.\\n- **Dev mode** from pause: toggle God mode, move a slider and see the value in status, Reset.\\n- **Saves:** save, reload, Continue, from `file://`.\\n840→- **Audio:** `status.audio.music == 0.10`. An init script wraps `AudioNode.connect` to add an analyser before the destination, and levels are non-zero after a gesture.\\n- **About** contains every Source Information field, and all feedback sections are filled.\\n\\n### 14.4 Hub\\nA script copies the final page beside `hub/*`, serves with `python3 -m http.server 0 --bind 127.0.0.1`, parses the port the OS picked, **fetches the page and confirms its `<title>` is yours before trusting a result**, runs the cases below, and stops only the PID it started (never `pkill`, `killall`, `fuser -k` or whatever holds a port). Other agents share this machine's ports and processes. Assert `window.__hubCheck.pass` for each, with the game opened as `harness.html?game=<page>&…`:\\n- `players=2&auto=1`\\n- `players=4&latency=150&jitter=50&loss=5&auto=1`\\n- `players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1`\\n- `players=2&scenario=server&auto=1`\\n\\n850→Also: two pages (or contexts) play the standalone round over `BroadcastChannel` and over a copy-pasted WebRTC code through to the results. Then the on-its-own check: client inactive, `Math.random` untouched.\\n\\n### 14.5 Screenshots worth taking (1920×1080, 10-foot judgment)\\nGolden hour on the plain, the depot fire at night, the viewmodel with each weapon class, wound treatment mid-animation, map in hand, title, shop, settings, pause, dev balance page, the bar. Check that text is readable from the couch. Fix what looks wrong.\\n\\n---\\n\\n## 15. Feature list for the coverage flags, and what ships in About/Credits\\n\\n**Coverage flags (each set by real play; a test passes on the union across the three playthrough runs, since no single run can both save and lose the same companion or reach every ending):** map raised, waypoint set, GPS followed, monocular tag, wind rag visible at speed > 6, jam cleared, enemy jam seen, weapon broke, weapon bought, locker used, syrette, each wound treatment type, fever warned, pill taken, black-out (bot route), player rescued, companion patched, companion overdosed, companion died, better-way taken, fire lit by each igniter class, 500+ cells burned in one fire, enemy panicked, animals fled, explosion chain, rain extinguished, stealth kill, dart kill, night contract, sleep used, safe house claimed, post cleared, post re-manned, technical driven, mounted gun fired, repair done, boat driven, bus taken, tape played, cache found by tracker, diamonds spent, each contract, ceasefire ended, town burned, each ending.\\n860→\\n**About/Credits (paged, large text, also in your chat reply, per TASK.md):**\\n- **Source Information:** every field in TASK.md's list, with the values TASK.md gives (Date, Environment, Model) and `added on import` for Usage. Write `unknown` for what you can't confirm.\\n- **Testing Feedback, Engine Feedback, Prompt Feedback:** your answers to each question. Keep `notes/feedback.md` as you go: count issues caught, note the critical ones, note every time you read engine source and why.\\n- **Credits:** engine, clip libraries with their licences (from `pav clips name=…`), fonts, this plan.\\n\\n**Exit interview:** write it exactly as TASK.md's shape, beside the final HTML, and check it parses. Suggested `aiHub` values: `type` Game, `genre` Shooter, `source` Far Cry 2, `series` Far Cry, `players` 1–4, `controls` \\\"Stick or WASD move · R2 or left mouse fire · L2 or right mouse aim · Square or R reload and clear jams · D-pad or M for the map\\\", `tags` `[\\\"3d\\\",\\\"first-person\\\",\\\"co-op\\\",\\\"story\\\",\\\"vehicles\\\",\\\"exploration\\\"]`. Fill `name`, `tagline`, `description` in the game's voice.\\n\\n---\\n\\n870→## 16. Done\\n\\nEvery line must be true before you stop:\\n\\n- [ ] Original title by TASK.md's process, on the title screen. No names from §1.4.\\n- [ ] One self-contained HTML file with the name and location TASK.md gives. Opens from `file://` in Chrome or Edge with WebGPU.\\n- [ ] First-person game, on the Pavilion engine, native style extended with new assets and animations.\\n- [ ] All systems in §5 present. All contracts in §11 playable. Three endings. No TODOs, placeholders or stubs anywhere, including in text.\\n- [ ] Demo long enough to show everything: playthrough asserts all coverage flags.\\n- [ ] Music defaults to 10%. All sound, music and gibberish voices are generated in code.\\n880→- [ ] Dev mode reachable from pause: tools, live sliders, reset to defaults.\\n- [ ] Attract mode after 10 s of idle on title and menus, loops, any input exits.\\n- [ ] Controller first: every screen works on a DualSense (stubbed) with PlayStation glyphs, Xbox glyph option, keyboard and mouse native with their own prompts, hover moves focus, clicks work, no dense screens.\\n- [ ] Touch-only: no touch controls, the required message, a Settings button, attract running.\\n- [ ] Hub: session client unmodified and first, all four harness cases pass, the on-its-own check passes, standalone multiplayer works over two pages.\\n- [ ] `tests/run.sh all` prints 0 failures and a one-line count.\\n- [ ] Source Information, Testing, Engine and Prompt Feedback are in About/Credits and your chat reply. Exit interview saved and parses.\\n- [ ] Your background processes are stopped, by PID. No stray files outside your folder.\\n\\n---\\n890→\\n## 17. Risks I would watch\\n\\n| Risk | Why it matters | What to do |\\n|---|---|---|\\n| Up-close look of capsule arms and primitive guns | The whole game is viewed through them | Look test at M1. Add part detail (sights, rivets, tape on grips), use materials, keep outlines on objects. If SDF capsules look wrong that close, use rounded-box or mesh parts for hands |\\n| Grass reads as noise in first person | Half the screen | Tune colour variation, clump size, no outlines on environment. Grass must read as a surface, not a scatter. Compare screenshots |\\n| Bot complexity for a full playthrough | It's a required test | Keep contracts as objective graphs that expose a `Goal`. Build the bot as you add each contract, never at the end |\\n| Long rebuilds (about 2 min each for `pav`, the test binary and wasm) | Time | Put numbers in TOML and use `pav_core`'s disk read path for data. Batch code edits. Use `cargo test --test merc <filter>` |\\n| Vehicle physics on slopes | Rapier raycast cars can jitter on trimeshes | Keep `FIX_INTERNAL_EDGES`, smooth road corridors, cap angular velocity, add upright assist |\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/PLAN.md\",\"offset\":760,\"limit\":140,\"raw_output\":\"`pav_app/input.rs` gets a third layout for this game (§4), and `poll_gamepad` passes trigger analog values. Mouse look on the web: read `movementX/Y` in the JS shim (§12.5), which is simplest to test (§2.4). Native can use `DeviceEvent::MouseMotion`. `move_dir` stays world-space: rotate the stick by yaw. Only Esc stays a system key outside dev mode.\\n\\n### 12.4 Game to view and UI\\n- Add `Game::frame_extra` or a typed field `RenderFrame.merc: Option<Arc<MercFrame>>`, like the existing `game: Option<Arc<GameFrame>>`. `MercFrame` holds what the view and UI need: FP state, viewmodel state, inventory, prompts, map data version, burn deltas, wind, time.\\n- `pav_view::merc::draw(scene, frame)` runs inside `ViewBuilder::build`.\\n- `pav_ui::tenfoot` draws over it, and also from `headless.rs` so `pav capture` and `ui` see it.\\n- All game state stays in the `Game` struct or entities (`Clone`, serde). View caches are `#[serde(skip)]` or live in the view.\\n- Randomness only from `sim.state.rng`. No clock, no `HashMap` order reaching state. The \\\"Key rules\\\" in `engine/AGENTS.md` apply to your game; its maintainers' workflow (history, PRs, escalations) does not.\\n\\n### 12.5 Web layer\\n`engine/web/index.html` gets, in order: `<meta charset>`, session client, hub metas, then a plain script defining:\\n- `window.gameNet`: `init`, `send(json, reliable, to)`, `poll()` (drains a JSON string array), hub events queued, standalone transports\\n- `window.gameInput`: pointer lock request, `movementX/Y` accumulation, lock-change flag, `(any-pointer: fine)`\\n- `window.gameTest`: see §14.3\\n\\nRust calls them through `#[wasm_bindgen] extern \\\"C\\\"` with `js_namespace`, or `js_sys::Reflect`. No snippets (§2.1). Keep the glue free of the literal strings `<script`, `</script` and `<!--`.\\n\\n`tools/build-game.sh` runs `engine/scripts/build-web.sh --single-file --scene merc --title \\\"<title>\\\" --description \\\"<line>\\\" --theme-color \\\"#2a2420\\\" --out <the final path TASK.md names>`, then confirms the size, the first-script position and that `session.js` is byte-identical.\\n\\n### 12.6 Data and tools for later designers\\nAll balance, weapons, enemies, contracts, text, shop, attract, map features and compounds are data, embedded at build time and re-read from disk in native tools. Add `pav` tools (`engine/AGENTS.md`, \\\"Adding a tool\\\"):\\n- `mapshot` (top-down PNG of terrain, POIs, roads, burn state)\\n- `fire` (start, step, report)\\n- `merc_cmd` (any `act`)\\n\\nThis, with `room_check`, `asset_edit`, `anim_edit`, `animsheet`, `filmstrip` and dev mode, is the designer toolchain TASK.md asks for.\\n\\n---\\n\\n## 13. Build order\\nEach milestone ends with its tests in the one command. Commit to your engine clone's git as you go. **Never use subagents or workflows to debate, review, judge or audit.**\\n\\n| M | Build | Done when |\\n|---|---|---|\\n| **M0** | Clone, build, register `merc` scene (copy the starter as in `engine/docs/MAKE_A_GAME.md`, which is the first engine page to read), page builds, session client in place, `hub/` downloaded, harness passes with a stub round, title chosen, `tests/run.sh` prints one line | `tests/run.sh` shows 0 failures, harness 4 scenarios pass |\\n| **M1** | First-person camera, input layer, pointer lock, gamepad layout, `tenfoot` prompts, viewmodel with the rifle (hands on sockets, sway, recoil, reload, the red rag), hitscan, a target dummy, sky dome, NO_FOG | Sim tests for look, move and hits pass. A 1920×1080 screenshot looks like a game you'd play. **Fix the look now: everything depends on it.** |\\n| **M2** | Terrain and `world.toml`, biomes, roads, river, rings, grass and trees, time of day, stamps on pads, town blocked out, `mapshot` | `mapshot` shows the whole map. Bot walks airstrip to town. Screenshots at dawn, noon, dusk and night |\\n| **M3** | Full weapon table, condition and jams, damage and treatments, NPC roles, detection, cover, guard post | Bot clears a post on 10 seeds. Jam, wear and detection tests pass |\\n| **M4** | Fire, wind, smoke, burn visuals, explosions, weather, AI reactions | Fire tests (§14.1). Depot fire screenshot makes you want to play |\\n| **M5** | Vehicles on slopes, relative controls, boat, seats, mounted gun, damage and repair, AI pursuit | Bot drives the road end to end. Boat and repair tests pass |\\n| **M6** | Fever, safe houses, sleep, economy and shop, map and GPS and monocular, tracker and caches, tapes, saves | Tests for each. Save and reload round trip |\\n| **M7** | Companions, contracts A0 to D2, endings, barks, Infamy, campaign bot, coverage flags | **Scripted playthrough reaches all three endings with every coverage flag set** |\\n| **M8** | Audio buses, SFX, music, voices | Audio tests pass, default music gain 0.10 |\\n| **M9** | Shell: title, settings, pause, dev mode, attract, touch-only, About | Browser tests pass (§14.3) |\\n| **M10** | Session round, own card, netcode, server mode, standalone This computer and Invite code | Loopback test, harness 4 scenarios on the real game, two-page standalone round |\\n| **M11** | Art pass on every prop, animation pass on every clip, writing pass on every line, balance with sliders, final build, About/Credits, exit interview | §16 checklist complete |\\n\\n---\\n\\n## 14. Testing (TASK.md: one command, only failures and a one-line count)\\n`tests/run.sh [sim|ui|audio|browser|hub|all]` prints each failure's name and reason, then one line like `PASS 212 FAIL 0`. Rerun only the part you changed. Use screenshots only for what a script can't check.\\n\\n### 14.1 Sim (`engine/crates/pav_core/tests/merc.rs`, native, fast)\\n- **Foundations:** boots on 3 seeds. Same seed and inputs give the same hash; `record_save` and `replay` hold. Snapshot round trip. Data lint: every TOML parses, every asset and clip named exists, every string key resolves, and no string contains TODO, TBD, placeholder or lorem.\\n- **Player:** look clamps, stick movement follows yaw, stances change eye and capsule height, hard landing wound.\\n- **Weapons:** head, torso and limb multipliers. Wall blocks shots. Wear per table. Jam rate within tolerance at c = 35 over 5,000 rolls. Jam blocks firing until cleared. Weapon breaks. An NPC's gun jams and it stops firing.\\n- **Fire:** wind 8 m/s downwind reach ≥ 3× upwind after 60 s. Calm spread is roughly round. Roads and river stop it unless embers jump. Burnt cells don't re-burn, then regrow. Rain extinguishes. Barrel explodes and ignites. NPCs leave burning cells. A burning NPC spreads fire. Fuel tank cooks off. Snapshot size stays small after a big burn.\\n- **Detection:** the grass, night and posture comparisons of §5.10. Noise brings investigators. Smoke blocks sight.\\n- **AI:** squad takes cover and at least one flanker repositions. Max 4 shooters at once. Morale break. Post re-mans after its timer and never in the player's sight.\\n- **Survival:** warning precedes attack. Pill clears it. No pill means black-out, wake at safe house, fee taken. Syrette and treatments restore the right amounts. Wound type follows damage cause.\\n- **Companions:** rescue fires once per rest and player stands up at 50. Downed companion timer. Patch and overdose. Death stays dead across save and load.\\n- **Vehicles:** climbs the ridge road. Recovers from a roll. Damage stages. Repair. Explodes and ignites grass. Boat floats and stops at shallows. NPC driver follows the road. Seat changes.\\n- **Economy and saves:** buying with too few diamonds changes nothing. Tracker rate rises near a cache. Save and load restores all listed fields.\\n- **Contracts:** each contract completes under the bot on 2 seeds, and each failure condition fires.\\n- **Scripted playthrough of the whole game:** the bot plays new game through each of the three endings using only inputs and `act`s (no teleporting except the bus, no cheats, normal difficulty). Assert the outcome is reached, all `coverage` flags are set, and wall time is under a limit you set (this must stay cheap enough to rerun). Expose it through `Game::bot`, so `pav play bot=true seeds=3` works too.\\n- **Attract:** five full loops, every segment reached, never stuck, no save written.\\n- **Netcode loopback:** host and client `Sim`s on the in-memory link at 150 ms, jitter 50, 5% loss. Both see the same fire cells within 1 s, kills and objectives agree, `finish` is issued once, unreliable messages stay under 1,200 bytes and sends stay under 20 per second. A client leaving and the host leaving both behave.\\n\\n### 14.2 UI and audio (native)\\n- **UI** (`MenuInput`): focus moves and wraps, back works, no screen exceeds 7 rows, hover moves focus, glyphs follow device and setting, dev sliders change `Tunable`s and Reset restores defaults, attract starts at 10 s of idle and not before, any input exits.\\n- **Audio** (`render_events`, offline): music bus RMS at default ÷ RMS at full is 0.10 ± 0.01. No NaN or clipping. Each gun family differs from the others. Crackle level rises with burning cells. Voice output is non-silent, differs by speaker. `find engine -name '*.wav' -o -name '*.mp3' -o -name '*.ogg'` finds nothing of ours.\\n\\n### 14.3 Browser (Playwright on the real page, flags from §2.2; one or two browsers at a time)\\nRust publishes `window.__game = { status: <JSON string>, ui: <JSON string> }` every 15 ticks and reads commands from `window.gameTest.queue`. `?test=1&nodraw=1` skips scene drawing so the sim runs at speed. These hooks are inert in normal play.\\n- Page opens from `file://`, title draws (screenshot past blank), no page errors. Enter, Space, Enter, Space leaves it drawing (this is what the hub's own solo check does).\\n- **Controls:** keyboard, mouse hover and click, pad stub (§2.4). Prompts follow the device. Xbox setting changes glyphs. Synthetic mouse changes yaw under pointer lock. Lock lost opens pause.\\n- **Idle:** no input for 10 s starts attract. A key, a pad press or a mouse move exits it.\\n- **Touch-only:** Chromium with a phone profile (`has_touch`, `is_mobile`) shows \\\"Controller or keyboard required\\\" and a tappable Settings. No touch controls appear. Attract runs. Also check that WebKit (which has no WebGPU here) shows the page's clear message rather than a blank page.\\n- **Dev mode** from pause: toggle God mode, move a slider and see the value in status, Reset.\\n- **Saves:** save, reload, Continue, from `file://`.\\n- **Audio:** `status.audio.music == 0.10`. An init script wraps `AudioNode.connect` to add an analyser before the destination, and levels are non-zero after a gesture.\\n- **About** contains every Source Information field, and all feedback sections are filled.\\n\\n### 14.4 Hub\\nA script copies the final page beside `hub/*`, serves with `python3 -m http.server 0 --bind 127.0.0.1`, parses the port the OS picked, **fetches the page and confirms its `<title>` is yours before trusting a result**, runs the cases below, and stops only the PID it started (never `pkill`, `killall`, `fuser -k` or whatever holds a port). Other agents share this machine's ports and processes. Assert `window.__hubCheck.pass` for each, with the game opened as `harness.html?game=<page>&…`:\\n- `players=2&auto=1`\\n- `players=4&latency=150&jitter=50&loss=5&auto=1`\\n- `players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1`\\n- `players=2&scenario=server&auto=1`\\n\\nAlso: two pages (or contexts) play the standalone round over `BroadcastChannel` and over a copy-pasted WebRTC code through to the results. Then the on-its-own check: client inactive, `Math.random` untouched.\\n\\n### 14.5 Screenshots worth taking (1920×1080, 10-foot judgment)\\nGolden hour on the plain, the depot fire at night, the viewmodel with each weapon class, wound treatment mid-animation, map in hand, title, shop, settings, pause, dev balance page, the bar. Check that text is readable from the couch. Fix what looks wrong.\\n\\n---\\n\\n## 15. Feature list for the coverage flags, and what ships in About/Credits\\n\\n**Coverage flags (each set by real play; a test passes on the union across the three playthrough runs, since no single run can both save and lose the same companion or reach every ending):** map raised, waypoint set, GPS followed, monocular tag, wind rag visible at speed > 6, jam cleared, enemy jam seen, weapon broke, weapon bought, locker used, syrette, each wound treatment type, fever warned, pill taken, black-out (bot route), player rescued, companion patched, companion overdosed, companion died, better-way taken, fire lit by each igniter class, 500+ cells burned in one fire, enemy panicked, animals fled, explosion chain, rain extinguished, stealth kill, dart kill, night contract, sleep used, safe house claimed, post cleared, post re-manned, technical driven, mounted gun fired, repair done, boat driven, bus taken, tape played, cache found by tracker, diamonds spent, each contract, ceasefire ended, town burned, each ending.\\n\\n**About/Credits (paged, large text, also in your chat reply, per TASK.md):**\\n- **Source Information:** every field in TASK.md's list, with the values TASK.md gives (Date, Environment, Model) and `added on import` for Usage. Write `unknown` for what you can't confirm.\\n- **Testing Feedback, Engine Feedback, Prompt Feedback:** your answers to each question. Keep `notes/feedback.md` as you go: count issues caught, note the critical ones, note every time you read engine source and why.\\n- **Credits:** engine, clip libraries with their licences (from `pav clips name=…`), fonts, this plan.\\n\\n**Exit interview:** write it exactly as TASK.md's shape, beside the final HTML, and check it parses. Suggested `aiHub` values: `type` Game, `genre` Shooter, `source` Far Cry 2, `series` Far Cry, `players` 1–4, `controls` \\\"Stick or WASD move · R2 or left mouse fire · L2 or right mouse aim · Square or R reload and clear jams · D-pad or M for the map\\\", `tags` `[\\\"3d\\\",\\\"first-person\\\",\\\"co-op\\\",\\\"story\\\",\\\"vehicles\\\",\\\"exploration\\\"]`. Fill `name`, `tagline`, `description` in the game's voice.\\n\\n---\\n\\n## 16. Done\\n\\nEvery line must be true before you stop:\\n\\n- [ ] Original title by TASK.md's process, on the title screen. No names from §1.4.\\n- [ ] One self-contained HTML file with the name and location TASK.md gives. Opens from `file://` in Chrome or Edge with WebGPU.\\n- [ ] First-person game, on the Pavilion engine, native style extended with new assets and animations.\\n- [ ] All systems in §5 present. All contracts in §11 playable. Three endings. No TODOs, placeholders or stubs anywhere, including in text.\\n- [ ] Demo long enough to show everything: playthrough asserts all coverage flags.\\n- [ ] Music defaults to 10%. All sound, music and gibberish voices are generated in code.\\n- [ ] Dev mode reachable from pause: tools, live sliders, reset to defaults.\\n- [ ] Attract mode after 10 s of idle on title and menus, loops, any input exits.\\n- [ ] Controller first: every screen works on a DualSense (stubbed) with PlayStation glyphs, Xbox glyph option, keyboard and mouse native with their own prompts, hover moves focus, clicks work, no dense screens.\\n- [ ] Touch-only: no touch controls, the required message, a Settings button, attract running.\\n- [ ] Hub: session client unmodified and first, all four harness cases pass, the on-its-own check passes, standalone multiplayer works over two pages.\\n- [ ] `tests/run.sh all` prints 0 failures and a one-line count.\\n- [ ] Source Information, Testing, Engine and Prompt Feedback are in About/Credits and your chat reply. Exit interview saved and parses.\\n- [ ] Your background processes are stopped, by PID. No stray files outside your folder.\\n\\n---\\n\\n## 17. Risks I would watch\\n\\n| Risk | Why it matters | What to do |\\n|---|---|---|\\n| Up-close look of capsule arms and primitive guns | The whole game is viewed through them | Look test at M1. Add part detail (sights, rivets, tape on grips), use materials, keep outlines on objects. If SDF capsules look wrong that close, use rounded-box or mesh parts for hands |\\n| Grass reads as noise in first person | Half the screen | Tune colour variation, clump size, no outlines on environment. Grass must read as a surface, not a scatter. Compare screenshots |\\n| Bot complexity for a full playthrough | It's a required test | Keep contracts as objective graphs that expose a `Goal`. Build the bot as you add each contract, never at the end |\\n| Long rebuilds (about 2 min each for `pav`, the test binary and wasm) | Time | Put numbers in TOML and use `pav_core`'s disk read path for data. Batch code edits. Use `cargo test --test merc <filter>` |\\n| Vehicle physics on slopes | Rapier raycast cars can jitter on trimeshes | Keep `FIX_INTERNAL_EDGES`, smooth road corridors, cap angular velocity, add upright assist |\\n\",\"total_lines\":907}}","is_error":false},{"type":"tool_result","tool_use_id":"call-48259eb8-f847-43a8-9876-524522975b6a-82","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,53,45,48,49,51,53,48,51,95,95,120,98,100,55,100,57,49,47,119,111,114,107,34,62,10,70,111,117,110,100,32,50,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,53,45,48,49,51,53,48,51,95,95,120,98,100,55,100,57,49,47,119,111,114,107,47,74,97,109,32,67,114,121,45,70,97,114,32,67,114,121,32,50,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,53,45,48,49,51,53,48,51,47,101,110,103,105,110,101,47,99,114,97,116,101,115,47,112,97,118,95,99,111,114,101,47,115,114,99,47,103,97,109,101,115,47,109,101,114,99,47,119,111,114,108,100,46,114,115,10,53,57,52,58,32,32,32,32,32,32,32,32,125,32,101,108,115,101,32,105,102,32,105,110,112,117,116,46,97,99,116,32,61,61,32,49,48,32,38,38,32,33,115,101,108,102,46,104,117,98,32,123,10,49,50,50,57,58,32,32,32,32,32,32,32,32,105,102,32,115,101,108,102,46,102,108,97,103,115,46,99,111,110,116,97,105,110,115,40,34,109,97,112,95,114,97,105,115,101,100,34,41,32,38,38,32,40,105,110,112,117,116,46,106,117,115,116,40,98,117,116,116,111,110,115,58,58,73,78,84,69,82,65,67,84,41,32,124,124,32,105,110,112,117,116,46,97,99,116,32,61,61,32,49,41,32,38,38,32,115,101,108,102,46,119,97,121,112,111,105,110,116,46,105,115,95,110,111,110,101,40,41,32,123,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":2,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"matches\":[{\"line_number\":594,\"content\":\"        } else if input.act == 10 && !self.hub {\"},{\"line_number\":1229,\"content\":\"        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"3e9ff939-9395-4af7-8d6f-fe38566c518b"}
