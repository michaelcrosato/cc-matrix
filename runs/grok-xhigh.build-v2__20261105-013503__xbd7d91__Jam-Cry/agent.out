unt() {\\n                    rows.pop();\\n                    rows.push(\\\"Next page\\\".into());\\n                    // Keep reset reachable: the last page holds it. Mid pages use Next.\\n                }\\n                if start + 6 >= self.tune.count() && !rows.iter().any(|r| r == \\\"Reset to defaults\\\") {\\n                    rows.push(\\\"Reset to defaults\\\".into());\\n                }\\n                rows\\n            }\\n            _ => vec![\\\"Next page\\\".into(), \\\"Reset to defaults\\\".into()],\\n        }\\n    }\\n\\n    fn page_of(&self, names: &[&str]) -> Vec<String> {\\n\",\"total_lines\":447}}","is_error":false},{"type":"tool_result","tool_use_id":"call-661f3889-178a-43d4-a1a2-b289491e45cd-8","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"450→        w.z = -200.0;\\n        w.guns = vec![Gun::new(WeaponId::Pistol), Gun::new(WeaponId::Ar)];\\n        w.diamonds = 40;\\n        w.syrettes = 3;\\n        w.pills = 3;\\n        w.slot = 0;\\n        w\\n    }\\n\\n    pub fn campaign(seed: u64, route: Route) -> Self {\\n460→        let mut w = Self::blank(seed, route);\\n        w.screen = Screen::Title;\\n        w.guns = vec![Gun::new(WeaponId::Pistol)];\\n        w.diamonds = 40;\\n        w.syrettes = 3;\\n        w.pills = 3;\\n        w\\n    }\\n\\n    fn blank(seed: u64, route: Route) -> Self {\\n470→        let tune = Tune::default();\\n        Self {\\n            seed,\\n            rng: Rng::new(seed),\\n            route,\\n            screen: Screen::Title,\\n            focus: 0,\\n            tab: 0,\\n            page: 0,\\n            difficulty: 1,\\n480→            merc: 0,\\n            x: 0.0,\\n            z: 0.0,\\n            yaw: 0.0,\\n            pitch: 0.05,\\n            roll: 0.0,\\n            eye: 1.58,\\n            stance: 0,\\n            stamina: 12.0,\\n            hp: 100.0,\\n490→            syrettes: 3,\\n            pills: 3,\\n            diamonds: 40,\\n            infam