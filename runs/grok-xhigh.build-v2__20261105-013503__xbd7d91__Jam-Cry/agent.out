AGENT_ASSET_STORE.md\\n        - ANIMATION_STUDIO.md\\n        - ASSET_IMPORT.md\\n        - asset_plan/\\n          [9 files in subtree: 7 *.py, 1 *.json, 1 *.md]\\n        - ASSET_STUDIO.md\\n        - ASSET_STUDIO_LIVE.md\\n        - ASSET_SYSTEM_PLAN.md\\n        - COOP_PLAN.md\\n        - CREATURE_STUDIO.md\\n        - DESIGN.md\\n        - DOCTRINE.md\\n        - ESCALATIONS.md\\n        - FEEDBACK.md\\n        - GAME.md\\n        - handoffs/\\n          [2 files in subtree: 2 *.md]\\n        - HISTORY.md\\n        - MAKE_A_GAME.md\\n        - MATERIALS.md\\n        - PROGRESS.md\\n        - REFERENCE.md\\n      - game/\\n        - affixes.toml\\n        - bosses.toml\\n        - genome.toml\\n        - heroes.toml\\n        - items.toml\\n        - levels.toml\\n        - monster_affixes.toml\\n        - monsters.toml\\n        - props.toml\\n        - skills.toml\\n        - themes.toml\\n        - tree.toml\\n        - uniques.toml\\n      - pavilion-lite/\\n        - AGENTS.md\\n        - Cargo.lock\\n        - Cargo.toml\\n        - CLAUDE.md\\n        - package.sh\\n        - README.md\\n        - rustfmt.toml\\n        - src/\\n          [21 files in subtree: 21 *.rs]\\n      - README.md\\n      - rooms/\\n        - _template.toml\\n        - action_moves.toml\\n        - bloom.toml\\n        - bullet_hell.toml\\n        - camera_bench.toml\\n        - catalogue.toml\\n        - chains.toml\\n        - clip_browser.toml\\n        - conveyors.toml\\n        - creatures.toml\\n        - destruction.toml\\n        - distortion.toml\\n        - drift.toml\\n        - feel_lab.toml\\n        - filter_bench.toml\\n        - filters.toml\\n        - gauntlet.toml\\n        - gi.toml\\n        - helicopter.toml\\n        - library_hall.toml\\n        - light_shafts.toml\\n        - lights.toml\\n        - limits.toml\\n        - materials.toml\\n        - mix_match.toml\\n        - motion_library.toml\\n        - paint_print.toml\\n        - particles.toml\\n  