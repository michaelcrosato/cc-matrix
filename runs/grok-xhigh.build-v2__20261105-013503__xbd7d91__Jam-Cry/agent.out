,\\n    EnemyJam,\\n    Jam,\\n    Break,\\n    Rescue,\\n    Wound(u8),\\n    Loot,\\n    Claim,\\n    Shop,\\n    Locker,\\n    Syrette,\\n    Tracker,\\n    Sleep { hours: f32 },\\n    Drive { x: f32, z: f32 },\\n    Mono,\\n    Ignite(u8),\\n    Tanks,\\n    Mounted,\\n    Panic,\\n    Animals,\\n    Bus { x: f32, z: f32 },\\n    Night,\\n    Boat,\\n    Stealth,\\n    Dart,\\n    Repair,\\n    Rain,\\n    Better,\\n    Patch,\\n    Overdose,\\n    Die,\\n    Tape,\\n    Ceasefire,\\n    Convoy,\\n    Town,\\n    Ending(u8),\\n    Flag(&'static str),\\n}\\n\\nfn script(route: Route) -> &'static [Spec] {\\n    static S: OnceLock<Vec<Vec<Spec>>> = OnceLock::new();\\n    let all = S.get_or_init(|| vec![build_script(Route::Human), build_script(Route::Burn), build_script(Route::Read), build_script(Route::Chair)]);\\n    let i = match route {\\n        Route::Human => 0,\\n        Route::Burn => 1,\\n        Route::Read => 2,\\n        Route::Chair => 3,\\n        Route::Sandbox => return &[],\\n    };\\n    all[i].as_slice()\\n}\\n\\nfn build_script(route: Route) -> Vec<Spec> {\\n    let mut v = vec![\\n        Spec::Boot,\\n        Spec::Map,\\n        Spec::Way,\\n        Spec::Reach { x: 0.0, z: 460.0, gps: true },\\n        Spec::Fever,\\n    ];\\n    if route == Route::Read {\\n        v.push(Spec::Blackout);\\n    } else {\\n        v.push(Spec::Pill);\\n    }\\n    v.push(Spec::Flag(\\\"contract_a0\\\"));\\n    v.push(Spec::Reach { x: -40.0, z: 640.0, gps: false });\\n    v.push(Spec::Fight);\\n    v.push(Spec::EnemyJam);\\n    v.push(Spec::Jam);\\n    v.push(Spec::Break);\\n    v.push(Spec::Rescue);\\n    for w in 1..=6 {\\n        v.push(Spec::Wound(w));\\n    }\\n    v.push(Spec::Loot);\\n    v.push(Spec::Reach { x: 170.0, z: 470.0, gps: false });\\n    v.push(Spec::Claim);\\n    v.push(Spec::Shop);\\n    v.push(Spec::Locker);\\n    v.push(Spec::Syrette);\\n    v.push(Spec::Tracker);\\n    v.push(Spec::Sleep { hours: 8.0 });\\n    v.push(Spec::Flag(\\\"contract_a1\\\"));\\n    v.push(Spec::Drive { x: -520.0, z: -520.0 });\\n    v.push(Spec::Mono);\\n    for ig in 0..12 {\\n        v.push(Spec::Ignite(ig));\\n    }\\n    v.push(Spec::Tanks);\\n    v.push(Spec::Mounted);\\n    v.push(Spec::Panic);\\n    v.push(Spec::Animals);\\n    v.push(Spec::Flag(\\\"contract_b1\\\"));\\n    v.push(Spec::Bus { x: 0.0, z: 380.0 });\\n    v.push(Spec::Drive { x: -260.0, z: -700.0 });\\n    v.push(Spec::Sleep { hours: 26.0 });\\n    v.push(Spec::Night);\\n    v.push(Spec::Boat);\\n    v.push(Spec::Stealth);\\n    v.push(Spec::Dart);\\n    v.push(Spec::Flag(\\\"contract_b2\\\"));\\n    v.push(Spec::Repair);\\n    v.push(Spec::Rain);\\n    v.push(Spec::Flag(\\\"contract_b3\\\"));\\n    v.push(Spec::Better);\\n    match route {\\n        Route::Read => v.push(Spec::Overdose),\\n        Route::Chair => v.push(Spec::Die),\\n        _ => v.push(Spec::Patch),\\n    }\\n    v.push(Spec::Flag(\\\"contract_b4\\\"));\\n    v.push(Spec::Tape);\\n    v.push(Spec::Ceasefire);\\n    v.push(Spec::Flag(\\\"contract_c1\\\"));\\n    v.push(Spec::Convoy);\\n    v.push(Spec::Flag(\\\"contract_c2\\\"));\\n    v.push(Spec::Town);\\n    v.push(Spec::Flag(\\\"contract_c3\\\"));\\n    v.push(Spec::Drive { x: -760.0, z: 620.0 });\\n    v.push(Spec::Flag(\\\"contract_d1\\\"));\\n    let end = match route {\\n        Route::Read => 1,\\n        Route::Chair => 2,\\n        _ => 0,\\n    };\\n    v.push(Spec::Ending(end));\\n    v.push(Spec::Flag(\\\"contract_d2\\\"));\\n    v\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct World {\\n    pub seed: u64,\\n    pub rng: Rng,\\n    pub route: Route,\\n    pub screen: Screen,\\n    pub focus: usize,\\n    pub tab: usize,\\n    pub page: usize,\\n    pub difficulty: u8,\\n    pub merc: u8,\\n    pub x: f32,\\n    pub z: f32,\\n    pub yaw: f32,\\n    pub pitch: f32,\\n    pub roll: f32,\\n    pub eye: f32,\\n    pub stance: u8,\\n    pub stamina: f32,\\n    pub hp: f32,\\n    pub syrettes: u32,\\n    pub pills: u32,\\n    pub diamonds: u32,\\n    pub infamy: i32,\\n    pub guns: Vec<Gun>,\\n    pub slot: usize,\\n    pub syrette_t: f32,\\n    pub heal_t: f32,\\n    pub wound: u8,\\n    pub pill_t: f32,\\n    pub fever_t: f32,\\n    pub fever_state: u8,\\n    pub fever_warn: f32,\\n    pub fever_attack: f32,\\n    pub bodies: Vec<Body>,\\n    pub walls: Vec<Wall>,\\n    pub fire: FireMap,\\n    pub wind: Vec2,\\n    pub weather: u8,\\n    pub minutes: f32,\\n    pub ceasefire: bool,\\n    pub companions: Vec<Companion>,\\n    pub rescue_t: f32,\\n    pub ride: Ride,\\n    pub flags: BTreeSet<String>,\\n    pub step: u16,\\n    pub step_ready: bool,\\n    pub step_t: f32,\\n    pub step_x: f32,\\n    pub step_z: f32,\\n    pub waypoint: Option<(f32, f32)>,\\n    pub map_t: f32,\\n    pub mono_t: f32,\\n    pub post_clear: bool,\\n    pub post_reman_at: f32,\\n    pub looking_at_post: bool,\\n    pub saves_written: u32,\\n    pub save_blob: String,\\n    pub has_save: bool,\\n    pub idle: f32,\\n    pub attract_t: f32,\\n    pub attract_seen: u16,\\n    pub attract_loops: u32,\\n    pub device: Device,\\n    pub device_lock: u8,\\n    pub xbox: bool,\\n    pub tune: Tune,\\n    pub tune0: Tune,\\n    pub dev: Dev,\\n    pub hub: bool,\\n    pub touch_only: bool,\\n    pub music: f32,\\n    pub finished: bool,\\n    pub hold_t: f32,\\n    pub tracker_cache: (f32, f32),\\n    pub treating: bool,\\n    pub jam_seen: bool,\\n    pub boat_dist: f32,\\n    /// Menu pointer in canvas pixels. The page sets it; the shell consumes it.\\n    #[serde(default)]\\n    pub pointer: Option<(f32, f32)>,\\n    #[serde(default)]\\n    pub pointer_click: bool,\\n}\\n\\nimpl World {\\n    pub fn fresh(seed: u64) -> Self {\\n        let mut w = Self::blank(seed, Route::Sandbox);\\n        w.screen = Screen::Playing;\\n        w.x = 200.0;\\n        w.z = -200.0;\\n        w.guns = vec![Gun::new(WeaponId::Pistol), Gun::new(WeaponId::Ar)];\\n        w.diamonds = 40;\\n        w.syrettes = 3;\\n        w.pills = 3;\\n        w.slot = 0;\\n        w\\n    }\\n\\n    pub fn campaign(seed: u64, route: Route) -> Self {\\n        let mut w = Self::blank(seed, route);\\n        w.screen = Screen::Title;\\n        w.guns = vec![Gun::new(WeaponId::Pistol)];\\n        w.diamonds = 40;\\n        w.syrettes = 3;\\n        w.pills = 3;\\n        w\\n    }\\n\\n    fn blank(seed: u64, route: Route) -> Self {\\n        let tune = Tune::default();\\n        Self {\\n            seed,\\n            rng: Rng::new(seed),\\n            route,\\n            screen: Screen::Title,\\n            focus: 0,\\n            tab: 0,\\n            page: 0,\\n            difficulty: 1,\\n            merc: 0,\\n            x: 0.0,\\n            z: 0.0,\\n            yaw: 0.0,\\n            pitch: 0.05,\\n            roll: 0.0,\\n            eye: 1.58,\\n            stance: 0,\\n            stamina: 12.0,\\n            hp: 100.0,\\n            syrettes: 3,\\n            pills: 3,\\n            diamonds: 40,\\n            infamy: 0,\\n            guns: vec![Gun::new(WeaponId::Pistol)],\\n            slot: 0,\\n            syrette_t: 0.0,\\n            heal_t: 0.0,\\n            wound: 0,\\n            pill_t: 0.0,\\n            fever_t: 0.0,\\n            fever_state: 0,\\n            fever_warn: 0.0,\\n            fever_attack: 0.0,\\n            bodies: Vec::new(),\\n            walls: Vec::new(),\\n            fire: FireMap::default(),\\n            wind: Vec2::new(2.0, 0.5),\\n            weather: 0,\\n            minutes: 12.0 * 60.0,\\n            ceasefire: true,\\n            companions: vec![\\n                Companion { name: \\\"Tomek Wrona\\\".into(), alive: true, down: false, down_t: 0.0, rescue_spent: false, x: 0.0, z: 0.0 },\\n                Companion { name: \\\"Rafael Quintero\\\".into(), alive: true, down: false, down_t: 0.0, rescue_spent: false, x: 0.0, z: 0.0 },\\n                Companion { name: \\\"Mirela Dragan\\\".into(), alive: true, down: false, down_t: 0.0, rescue_spent: false, x: 0.0, z: 0.0 },\\n            ],\\n            rescue_t: 0.0,\\n            ride: Ride::default(),\\n            flags: BTreeSet::new(),\\n            step: 0,\\n            step_ready: false,\\n            step_t: 0.0,\\n            step_x: 0.0,\\n            step_z: 0.0,\\n            waypoint: None,\\n            map_t: 0.0,\\n            mono_t: 0.0,\\n            post_clear: false,\\n            post_reman_at: 1.0e9,\\n            looking_at_post: false,\\n            saves_written: 0,\\n            save_blob: String::new(),\\n            has_save: false,\\n            idle: 0.0,\\n            attract_t: 0.0,\\n            attract_seen: 0,\\n            attract_loops: 0,\\n            device: Device::Gamepad,\\n            device_lock: 0,\\n            xbox: false,\\n            tune0: tune.clone(),\\n            tune,\\n            dev: Dev::default(),\\n            hub: false,\\n            touch_only: false,\\n            music: 0.10,\\n            finished: false,\\n            hold_t: 0.0,\\n            tracker_cache: (90.0, 500.0),\\n            treating: false,\\n            jam_seen: false,\\n            boat_dist: 0.0,\\n            pointer: None,\\n            pointer_click: false,\\n        }\\n    }\\n\\n    pub fn mark(&mut self, flag: &str) {\\n        self.flags.insert(flag.to_string());\\n    }\\n\\n    pub fn gun(&self) -> &Gun {\\n        &self.guns[self.slot.min(self.guns.len().saturating_sub(1))]\\n    }\\n    pub fn gun_mut(&mut self) -> &mut Gun {\\n        let i = self.slot.min(self.guns.len().saturating_sub(1));\\n        &mut self.guns[i]\\n    }\\n\\n    pub fn spawn_dummy(&mut self, x: f32, z: f32, hp: f32) -> usize {\\n        self.bodies.push(Body {\\n            kind: 4,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n        self.bodies.len() - 1\\n    }\\n\\n    pub fn add_wall(&mut self, min: [f32; 3], max: [f32; 3]) {\\n        self.walls.push(Wall { min, max });\\n    }\\n\\n    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n\",\"total_lines\":2449}}","is_error":false},{"type":"tool_result","tool_use_id":"call-28fc6088-6197-4301-aae6-830efe2aab15-9","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! 10-foot shell. Every screen has at most seven focusable rows. Hover moves focus. Click confirms.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::world::{Screen, World};\\nuse crate::input::buttons;\\nuse crate::input::InputFrame;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\n10→pub enum Device {\\n    Gamepad,\\n    Keyboard,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct MenuInput {\\n    pub up: bool,\\n    pub down: bool,\\n    pub left: bool,\\n20→    pub right: bool,\\n    pub confirm: bool,\\n    pub back: bool,\\n    pub pointer: Option<(f32, f32)>,\\n    pub click: bool,\\n    pub device: Option<Device>,\\n}\\n\\nimpl Default for MenuInput {\\n    fn default() -> Self {\\n30→        Self { up: false, down: false, left: false, right: false, confirm: false, back: false, pointer: None, click: false, device: None }\\n    }\\n}\\n\\npub fn glyph(action: &str, device: Device, xbox: bool) -> &'static str {\\n    match (device, xbox, action) {\\n        (Device::Keyboard, _, \\\"confirm\\\") => \\\"Enter\\\",\\n        (Device::Keyboard, _, \\\"back\\\") => \\\"Esc\\\",\\n        (Device::Keyboard, _, \\\"fire\\\") => \\\"LMB\\\",\\n        (Device::Keyboard, _, \\\"aim\\\") => \\\"RMB\\\",\\n40→        (Device::Keyboard, _, \\\"reload\\\") => \\\"R\\\",\\n        (Device::Keyboard, _, \\\"map\\\") => \\\"M\\\",\\n        (Device::Keyboard, _, \\\"jump\\\") => \\\"Space\\\",\\n        (Device::Gamepad, false, \\\"confirm\\\") => \\\"Cross\\\",\\n        (Device::Gamepad, true, \\\"confirm\\\") => \\\"A\\\",\\n        (Device::Gamepad, false, \\\"back\\\") => \\\"Circle\\\",\\n        (Device::Gamepad, true, \\\"back\\\") => \\\"B\\\",\\n        (Device::Gamepad, false, \\\"reload\\\") => \\\"Square\\\",\\n        (Device::Gamepad, true, \\\"reload\\\") => \\\"X\\\",\\n        (Device::Gamepad, false, \\\"fire\\\") => \\\"R2\\\",\\n50→        (Device::Gamepad, true, \\\"fire\\\") => \\\"RT\\\",\\n        (Device::Gamepad, false, \\\"aim\\\") => \\\"L2\\\",\\n        (Device::Gamepad, true, \\\"aim\\\") => \\\"LT\\\",\\n        (Device::Gamepad, _, \\\"map\\\") => \\\"D-pad\\\",\\n        (Device::Gamepad, false, \\\"jump\\\") => \\\"Cross\\\",\\n        (Device::Gamepad, true, \\\"jump\\\") => \\\"A\\\",\\n        _ => \\\"Button\\\",\\n    }\\n}\\n\\n60→fn menu_of(input: &InputFrame) -> MenuInput {\\n    MenuInput {\\n        up: input.act == 3,\\n        down: input.act == 4,\\n        left: input.act == 5,\\n        right: input.act == 6,\\n        confirm: input.act == 1 || input.just(buttons::CONFIRM) || input.just(buttons::JUMP),\\n        back: input.act == 2,\\n        pointer: None,\\n        click: false,\\n70→        device: None,\\n    }\\n}\\n\\nimpl World {\\n    pub fn shell_tick(&mut self, input: &InputFrame, dt: f32) {\\n        let typed = input.pressed != 0\\n            || input.act != 0\\n            || input.look.length_squared() > 1e-8\\n            || input.move_dir.length_squared() > 1e-8;\\n80→        if typed && self.device_lock == 0 {\\n            // A pointer-only hover does not arrive through InputFrame. Keyboard buttons do.\\n            if input.pressed & (buttons::CONFIRM | buttons::JUMP | buttons::MAP | buttons::RELOAD) != 0 || input.act != 0 {\\n                self.device = Device::Keyboard;\\n            }\\n        }\\n        if self.screen == Screen::Attract {\\n            if typed {\\n                self.screen = Screen::Title;\\n                self.focus = 0;\\n90→                self.idle = 0.0;\\n                self.attract_t = 0.0;\\n                return;\\n            }\\n            self.attract_t += dt;\\n            let seg = ((self.attract_t / 16.0) as u32) % 10;\\n            self.attract_seen |= 1u16 << seg;\\n            self.attract_loops = (self.attract_t / 160.0) as u32;\\n            return;\\n        }\\n100→        let shell = self.screen != Screen::Playing;\\n        if shell {\\n            if typed {\\n                self.idle = 0.0;\\n            } else if !self.hub {\\n                self.idle += dt;\\n            }\\n            if self.idle >= 10.0 && !self.hub {\\n                self.screen = Screen::Attract;\\n                return;\\n110→            }\\n            let mut m = menu_of(input);\\n            m.pointer = self.pointer.take();\\n            m.click = std::mem::take(&mut self.pointer_click);\\n            self.apply_menu(m);\\n            let _ = &mut m;\\n        }\\n    }\\n\\n    pub fn apply_menu(&mut self, m: MenuInput) {\\n120→        if let Some(d) = m.device {\\n            self.device = d;\\n        }\\n        if self.screen == Screen::Playing || self.screen == Screen::Attract {\\n            if m.confirm || m.back || m.up || m.down || m.click || m.pointer.is_some() {\\n                if self.screen == Screen::Attract {\\n                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                    self.idle = 0.0;\\n                    self.attract_t = 0.0;\\n130→                }\\n            }\\n            if self.screen != Screen::Title {\\n                return;\\n            }\\n        }\\n        let n = self.rows().len();\\n        if n == 0 {\\n            return;\\n        }\\n140→        if let Some((px, py)) = m.pointer {\\n            for i in 0..n {\\n                let y0 = 220.0 + i as f32 * 80.0;\\n                if px >= 160.0 && px <= 900.0 && py >= y0 && py <= y0 + 64.0 {\\n                    self.focus = i;\\n                }\\n            }\\n        }\\n        if m.up {\\n            self.focus = if self.focus == 0 { n - 1 } else { self.focus - 1 };\\n150→        }\\n        if m.down {\\n            self.focus = (self.focus + 1) % n;\\n        }\\n        self.focus = self.focus.min(n - 1);\\n        let activate = m.confirm || m.click;\\n        if m.left || m.right {\\n            self.nudge_slider(if m.right { 1.0 } else { -1.0 });\\n        }\\n        if m.back {\\n160→            self.go_back();\\n        }\\n        if activate {\\n            let rows = self.rows();\\n            let label = rows.get(self.focus).cloned().unwrap_or_default();\\n            self.activate(&label);\\n        }\\n    }\\n\\n    fn go_back(&mut self) {\\n170→        self.focus = 0;\\n        match self.screen {\\n            Screen::Difficulty | Screen::Settings | Screen::About | Screen::Mp => self.screen = Screen::Title,\\n            Screen::Merc => self.screen = Screen::Difficulty,\\n            Screen::Prologue => self.screen = Screen::Merc,\\n            Screen::Dev if self.tab != 0 => self.tab = 0,\\n            Screen::Dev => self.screen = Screen::Pause,\\n            Screen::Pause => self.screen = Screen::Playing,\\n            _ => {}\\n        }\\n180→    }\\n\\n    fn nudge_slider(&mut self, dir: f32) {\\n        if self.screen != Screen::Dev || self.tab != 5 {\\n            if self.screen == Screen::Settings && self.tab == 0 && self.focus == 1 {\\n                self.music = (self.music + dir * 0.05).clamp(0.0, 1.0);\\n            }\\n            return;\\n        }\\n        let count = self.tune.count();\\n190→        let page_size = 6;\\n        let index = self.page * page_size + self.focus;\\n        if self.focus == 6 || index >= count {\\n            if dir < 0.0 && self.page > 0 {\\n                self.page -= 1;\\n                self.focus = 0;\\n            }\\n            return;\\n        }\\n        let (lo, hi, step) = self.tune.range(index);\\n200→        let v = (self.tune.get(index) + dir * step).clamp(lo, hi);\\n        self.tune.set(index, v);\\n    }\\n\\n    fn activate(&mut self, label: &str) {\\n        match self.screen {\\n            Screen::Title => match label {\\n                \\\"Continue\\\" => self.continue_save(),\\n                \\\"New contract\\\" => {\\n                    self.screen = Screen::Difficulty;\\n210→                    self.focus = 1;\\n                }\\n                \\\"Multiplayer\\\" => {\\n                    self.screen = Screen::Mp;\\n                    self.focus = 0;\\n                }\\n                \\\"Settings\\\" => {\\n                    self.screen = Screen::Settings;\\n                    self.tab = 0;\\n                    self.focus = 0;\\n220→                }\\n                \\\"About\\\" => {\\n                    self.screen = Screen::About;\\n                    self.page = 0;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Screen::Difficulty => {\\n                self.difficulty = match label {\\n230→                    \\\"Easy\\\" => 0,\\n                    \\\"Hard\\\" => 2,\\n                    _ => 1,\\n                };\\n                self.screen = Screen::Merc;\\n                self.focus = 0;\\n            }\\n            Screen::Merc => {\\n                self.merc = match label {\\n                    \\\"Tomek Wrona\\\" => 1,\\n240→                    \\\"Rafael Quintero\\\" => 2,\\n                    \\\"Mirela Dragan\\\" => 3,\\n                    _ => 0,\\n                };\\n                self.screen = Screen::Prologue;\\n                self.focus = 0;\\n            }\\n            Screen::Prologue => {\\n                if label == \\\"Begin\\\" {\\n                    self.start_playing();\\n250→                }\\n            }\\n            Screen::Pause => match label {\\n                \\\"Resume\\\" => self.screen = Screen::Playing,\\n                \\\"Settings\\\" => {\\n                    self.screen = Screen::Settings;\\n                    self.focus = 0;\\n                }\\n                \\\"Controls\\\" => {\\n                    self.screen = Screen::Settings;\\n260→                    self.tab = 1;\\n                    self.focus = 0;\\n                }\\n                \\\"Dev mode\\\" if !self.hub => {\\n                    self.screen = Screen::Dev;\\n                    self.tab = 0;\\n                    self.page = 0;\\n                    self.focus = 0;\\n                }\\n                \\\"Quit to title\\\" => {\\n270→                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Screen::Settings => {\\n                if label == \\\"Xbox glyphs\\\" {\\n                    self.xbox = true;\\n                } else if label == \\\"PlayStation glyphs\\\" {\\n                    self.xbox = false;\\n280→                } else if label.starts_with(\\\"Page\\\") {\\n                    self.tab = (self.tab + 1) % 4;\\n                    self.focus = 0;\\n                }\\n            }\\n            Screen::Dev => {\\n                if self.tab == 0 {\\n                    self.tab = match label {\\n                        \\\"Cheats\\\" => 1,\\n                        \\\"Teleport\\\" => 2,\\n290→                        \\\"Spawn\\\" => 3,\\n                        \\\"World\\\" => 4,\\n                        \\\"Balance\\\" => 5,\\n                        _ => 0,\\n                    };\\n                    self.page = 0;\\n                    self.focus = 0;\\n                    return;\\n                }\\n                if label == \\\"Reset to defaults\\\" {\\n300→                    self.tune = self.tune0.clone();\\n                    return;\\n                }\\n                if label == \\\"Next page\\\" {\\n                    self.page += 1;\\n                    self.focus = 0;\\n                    return;\\n                }\\n                if self.tab == 1 {\\n                    self.toggle_cheat(label);\\n310→                }\\n            }\\n            Screen::About => {\\n                if label == \\\"Next\\\" {\\n                    self.page += 1;\\n                } else if label == \\\"Back\\\" && self.page > 0 {\\n                    self.page -= 1;\\n                } else if label == \\\"Back\\\" {\\n                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n320→                }\\n            }\\n            Screen::Mp => {\\n                if label == \\\"Back\\\" {\\n                    self.screen = Screen::Title;\\n                }\\n            }\\n            _ => {}\\n        }\\n    }\\n330→\\n    fn toggle_cheat(&mut self, label: &str) {\\n        let d = &mut self.dev;\\n        match label {\\n            \\\"God mode\\\" => d.god = !d.god,\\n            \\\"Infinite ammo\\\" => d.infinite = !d.infinite,\\n            \\\"No jams\\\" => d.no_jams = !d.no_jams,\\n            \\\"No fever\\\" => d.no_fever = !d.no_fever,\\n            \\\"Noclip\\\" => d.noclip = !d.noclip,\\n            \\\"Invisible\\\" => d.invisible = !d.invisible,\\n340→            \\\"Show AI\\\" => d.show_ai = !d.show_ai,\\n            \\\"Show fire\\\" => d.show_fire = !d.show_fire,\\n            \\\"Show nav\\\" => d.show_nav = !d.show_nav,\\n            \\\"Show stats\\\" => d.show_stats = !d.show_stats,\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn rows(&self) -> Vec<String> {\\n        let all: Vec<String> = match self.screen {\\n350→            Screen::Title => {\\n                let mut r = Vec::new();\\n                if self.has_save {\\n                    r.push(\\\"Continue\\\".into());\\n                }\\n                r.extend([\\\"New contract\\\".into(), \\\"Multiplayer\\\".into(), \\\"Settings\\\".into(), \\\"About\\\".into()]);\\n                r\\n            }\\n            Screen::Difficulty => vec![\\\"Easy\\\".into(), \\\"Normal\\\".into(), \\\"Hard\\\".into()],\\n            Screen::Merc => vec![\\\"Ada Okoro\\\".into(), \\\"Tomek Wrona\\\".into(), \\\"Rafael Quintero\\\".into(), \\\"Mirela Dragan\\\".into()],\\n360→            Screen::Prologue => vec![\\\"Begin\\\".into()],\\n            Screen::Pause => {\\n                let mut rows = vec![\\\"Resume\\\".into(), \\\"Settings\\\".into(), \\\"Controls\\\".into()];\\n                if !self.hub {\\n                    rows.push(\\\"Dev mode\\\".into());\\n                }\\n                rows.push(\\\"Quit to title\\\".into());\\n                rows\\n            }\\n            Screen::Settings => self.settings_rows(),\\n370→            Screen::About => vec![\\\"Next\\\".into(), \\\"Back\\\".into()],\\n            Screen::Dev => self.dev_rows(),\\n            Screen::Mp => vec![\\\"This computer\\\".into(), \\\"Invite code\\\".into(), \\\"Back\\\".into()],\\n            Screen::Attract => vec![\\\"Press any button\\\".into()],\\n            Screen::Playing => vec![],\\n        };\\n        all.into_iter().take(7).collect()\\n    }\\n\\n    fn settings_rows(&self) -> Vec<String> {\\n380→        match self.tab % 4 {\\n            0 => vec![\\\"Master\\\".into(), \\\"Music\\\".into(), \\\"Effects\\\".into(), \\\"Voices\\\".into(), \\\"Page\\\".into()],\\n            1 => vec![\\\"PlayStation glyphs\\\".into(), \\\"Xbox glyphs\\\".into(), \\\"Invert look\\\".into(), \\\"Sensitivity\\\".into(), \\\"Aim assist\\\".into(), \\\"Page\\\".into()],\\n            2 => vec![\\\"Fullscreen\\\".into(), \\\"Field of view\\\".into(), \\\"Brightness\\\".into(), \\\"Head bob\\\".into(), \\\"Page\\\".into()],\\n            _ => vec![\\\"Subtitle size\\\".into(), \\\"Reduce motion\\\".into(), \\\"Assist markers\\\".into(), \\\"Immersive hud\\\".into(), \\\"Page\\\".into()],\\n        }\\n    }\\n\\n    fn dev_rows(&self) -> Vec<String> {\\n        match self.tab {\\n390→            0 => vec![\\\"Cheats\\\".into(), \\\"Teleport\\\".into(), \\\"Spawn\\\".into(), \\\"World\\\".into(), \\\"Balance\\\".into()],\\n            1 => {\\n                let names = [\\\"God mode\\\", \\\"Infinite ammo\\\", \\\"No jams\\\", \\\"No fever\\\", \\\"Noclip\\\", \\\"Invisible\\\", \\\"Show AI\\\", \\\"Show fire\\\", \\\"Show nav\\\", \\\"Show stats\\\"];\\n                self.page_of(&names)\\n            }\\n            2 => {\\n                let names: Vec<&str> = super::geom::PLACES.iter().map(|p| p.name).collect();\\n                self.page_of_owned(names)\\n            }\\n            5 => {\\n400→                let mut rows = Vec::new();\\n                let start = self.page * 6;\\n                for i in start..(start + 6).min(self.tune.count()) {\\n                    rows.push(format!(\\\"{} {:.2}\\\", self.tune.name(i), self.tune.get(i)));\\n                }\\n                rows.push(\\\"Reset to defaults\\\".into());\\n                if start + 6 < self.tune.count() {\\n                    rows.pop();\\n                    rows.push(\\\"Next page\\\".into());\\n                    // Keep reset reachable: the last page holds it. Mid pages use Next.\\n410→                }\\n                if start + 6 >= self.tune.count() && !rows.iter().any(|r| r == \\\"Reset to defaults\\\") {\\n                    rows.push(\\\"Reset to defaults\\\".into());\\n                }\\n                rows\\n            }\\n            _ => vec![\\\"Next page\\\".into(), \\\"Reset to defaults\\\".into()],\\n        }\\n    }\\n\\n420→    fn page_of(&self, names: &[&str]) -> Vec<String> {\\n        let start = self.page * 6;\\n        let mut rows: Vec<String> = names.iter().skip(start).take(6).map(|s| (*s).to_string()).collect();\\n        if start + 6 < names.len() {\\n            rows.push(\\\"Next page\\\".into());\\n        } else {\\n            rows.push(\\\"Reset to defaults\\\".into());\\n        }\\n        rows\\n    }\\n430→\\n    fn page_of_owned(&self, names: Vec<&str>) -> Vec<String> {\\n        self.page_of(&names)\\n    }\\n\\n    pub fn notice(&self) -> Option<&'static str> {\\n        if self.touch_only { Some(\\\"Controller or keyboard required\\\") } else { None }\\n    }\\n}\\n\",\"content_concise\":\"1→//! 10-foot shell. Every screen has at most seven focusable rows. Hover moves focus. Click confirms.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::world::{Screen, World};\\nuse crate::input::buttons;\\nuse crate::input::InputFrame;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\n10→pub enum Device {\\n    Gamepad,\\n    Keyboard,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct MenuInput {\\n    pub up: bool,\\n    pub down: bool,\\n    pub left: bool,\\n20→    pub right: bool,\\n    pub confirm: bool,\\n    pub back: bool,\\n    pub pointer: Option<(f32, f32)>,\\n    pub click: bool,\\n    pub device: Option<Device>,\\n}\\n\\nimpl Default for MenuInput {\\n    fn default() -> Self {\\n30→        Self { up: false, down: false, left: false, right: false, confirm: false, back: false, pointer: None, click: false, device: None }\\n    }\\n}\\n\\npub fn glyph(action: &str, device: Device, xbox: bool) -> &'static str {\\n    match (device, xbox, action) {\\n        (Device::Keyboard, _, \\\"confirm\\\") => \\\"Enter\\\",\\n        (Device::Keyboard, _, \\\"back\\\") => \\\"Esc\\\",\\n        (Device::Keyboard, _, \\\"fire\\\") => \\\"LMB\\\",\\n        (Device::Keyboard, _, \\\"aim\\\") => \\\"RMB\\\",\\n40→        (Device::Keyboard, _, \\\"reload\\\") => \\\"R\\\",\\n        (Device::Keyboard, _, \\\"map\\\") => \\\"M\\\",\\n        (Device::Keyboard, _, \\\"jump\\\") => \\\"Space\\\",\\n        (Device::Gamepad, false, \\\"confirm\\\") => \\\"Cross\\\",\\n        (Device::Gamepad, true, \\\"confirm\\\") => \\\"A\\\",\\n        (Device::Gamepad, false, \\\"back\\\") => \\\"Circle\\\",\\n        (Device::Gamepad, true, \\\"back\\\") => \\\"B\\\",\\n        (Device::Gamepad, false, \\\"reload\\\") => \\\"Square\\\",\\n        (Device::Gamepad, true, \\\"reload\\\") => \\\"X\\\",\\n        (Device::Gamepad, false, \\\"fire\\\") => \\\"R2\\\",\\n50→        (Device::Gamepad, true, \\\"fire\\\") => \\\"RT\\\",\\n        (Device::Gamepad, false, \\\"aim\\\") => \\\"L2\\\",\\n        (Device::Gamepad, true, \\\"aim\\\") => \\\"LT\\\",\\n        (Device::Gamepad, _, \\\"map\\\") => \\\"D-pad\\\",\\n        (Device::Gamepad, false, \\\"jump\\\") => \\\"Cross\\\",\\n        (Device::Gamepad, true, \\\"jump\\\") => \\\"A\\\",\\n        _ => \\\"Button\\\",\\n    }\\n}\\n\\n60→fn menu_of(input: &InputFrame) -> MenuInput {\\n    MenuInput {\\n        up: input.act == 3,\\n        down: input.act == 4,\\n        left: input.act == 5,\\n        right: input.act == 6,\\n        confirm: input.act == 1 || input.just(buttons::CONFIRM) || input.just(buttons::JUMP),\\n        back: input.act == 2,\\n        pointer: None,\\n        click: false,\\n70→        device: None,\\n    }\\n}\\n\\nimpl World {\\n    pub fn shell_tick(&mut self, input: &InputFrame, dt: f32) {\\n        let typed = input.pressed != 0\\n            || input.act != 0\\n            || input.look.length_squared() > 1e-8\\n            || input.move_dir.length_squared() > 1e-8;\\n80→        if typed && self.device_lock == 0 {\\n            // A pointer-only hover does not arrive through InputFrame. Keyboard buttons do.\\n            if input.pressed & (buttons::CONFIRM | buttons::JUMP | buttons::MAP | buttons::RELOAD) != 0 || input.act != 0 {\\n                self.device = Device::Keyboard;\\n            }\\n        }\\n        if self.screen == Screen::Attract {\\n            if typed {\\n                self.screen = Screen::Title;\\n                self.focus = 0;\\n90→                self.idle = 0.0;\\n                self.attract_t = 0.0;\\n                return;\\n            }\\n            self.attract_t += dt;\\n            let seg = ((self.attract_t / 16.0) as u32) % 10;\\n            self.attract_seen |= 1u16 << seg;\\n            self.attract_loops = (self.attract_t / 160.0) as u32;\\n            return;\\n        }\\n100→        let shell = self.screen != Screen::Playing;\\n        if shell {\\n            if typed {\\n                self.idle = 0.0;\\n            } else if !self.hub {\\n                self.idle += dt;\\n            }\\n            if self.idle >= 10.0 && !self.hub {\\n                self.screen = Screen::Attract;\\n                return;\\n110→            }\\n            let mut m = menu_of(input);\\n            m.pointer = self.pointer.take();\\n            m.click = std::mem::take(&mut self.pointer_click);\\n            self.apply_menu(m);\\n            let _ = &mut m;\\n        }\\n    }\\n\\n    pub fn apply_menu(&mut self, m: MenuInput) {\\n120→        if let Some(d) = m.device {\\n            self.device = d;\\n        }\\n        if self.screen == Screen::Playing || self.screen == Screen::Attract {\\n            if m.confirm || m.back || m.up || m.down || m.click || m.pointer.is_some() {\\n                if self.screen == Screen::Attract {\\n                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                    self.idle = 0.0;\\n                    self.attract_t = 0.0;\\n130→                }\\n            }\\n            if self.screen != Screen::Title {\\n                return;\\n            }\\n        }\\n        let n = self.rows().len();\\n        if n == 0 {\\n            return;\\n        }\\n140→        if let Some((px, py)) = m.pointer {\\n            for i in 0..n {\\n                let y0 = 220.0 + i as f32 * 80.0;\\n                if px >= 160.0 && px <= 900.0 && py >= y0 && py <= y0 + 64.0 {\\n                    self.focus = i;\\n                }\\n            }\\n        }\\n        if m.up {\\n            self.focus = if self.focus == 0 { n - 1 } else { self.focus - 1 };\\n150→        }\\n        if m.down {\\n            self.focus = (self.focus + 1) % n;\\n        }\\n        self.focus = self.focus.min(n - 1);\\n        let activate = m.confirm || m.click;\\n        if m.left || m.right {\\n            self.nudge_slider(if m.right { 1.0 } else { -1.0 });\\n        }\\n        if m.back {\\n160→            self.go_back();\\n        }\\n        if activate {\\n            let rows = self.rows();\\n            let label = rows.get(self.focus).cloned().unwrap_or_default();\\n            self.activate(&label);\\n        }\\n    }\\n\\n    fn go_back(&mut self) {\\n170→        self.focus = 0;\\n        match self.screen {\\n            Screen::Difficulty | Screen::Settings | Screen::About | Screen::Mp => self.screen = Screen::Title,\\n            Screen::Merc => self.screen = Screen::Difficulty,\\n            Screen::Prologue => self.screen = Screen::Merc,\\n            Screen::Dev if self.tab != 0 => self.tab = 0,\\n            Screen::Dev => self.screen = Screen::Pause,\\n            Screen::Pause => self.screen = Screen::Playing,\\n            _ => {}\\n        }\\n180→    }\\n\\n    fn nudge_slider(&mut self, dir: f32) {\\n        if self.screen != Screen::Dev || self.tab != 5 {\\n            if self.screen == Screen::Settings && self.tab == 0 && self.focus == 1 {\\n                self.music = (self.music + dir * 0.05).clamp(0.0, 1.0);\\n            }\\n            return;\\n        }\\n        let count = self.tune.count();\\n190→        let page_size = 6;\\n        let index = self.page * page_size + self.focus;\\n        if self.focus == 6 || index >= count {\\n            if dir < 0.0 && self.page > 0 {\\n                self.page -= 1;\\n                self.focus = 0;\\n            }\\n            return;\\n        }\\n        let (lo, hi, step) = self.tune.range(index);\\n200→        let v = (self.tune.get(index) + dir * step).clamp(lo, hi);\\n        self.tune.set(index, v);\\n    }\\n\\n    fn activate(&mut self, label: &str) {\\n        match self.screen {\\n            Screen::Title => match label {\\n                \\\"Continue\\\" => self.continue_save(),\\n                \\\"New contract\\\" => {\\n                    self.screen = Screen::Difficulty;\\n210→                    self.focus = 1;\\n                }\\n                \\\"Multiplayer\\\" => {\\n                    self.screen = Screen::Mp;\\n                    self.focus = 0;\\n                }\\n                \\\"Settings\\\" => {\\n                    self.screen = Screen::Settings;\\n                    self.tab = 0;\\n                    self.focus = 0;\\n220→                }\\n                \\\"About\\\" => {\\n                    self.screen = Screen::About;\\n                    self.page = 0;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Screen::Difficulty => {\\n                self.difficulty = match label {\\n230→                    \\\"Easy\\\" => 0,\\n                    \\\"Hard\\\" => 2,\\n                    _ => 1,\\n                };\\n                self.screen = Screen::Merc;\\n                self.focus = 0;\\n            }\\n            Screen::Merc => {\\n                self.merc = match label {\\n                    \\\"Tomek Wrona\\\" => 1,\\n240→                    \\\"Rafael Quintero\\\" => 2,\\n                    \\\"Mirela Dragan\\\" => 3,\\n                    _ => 0,\\n                };\\n                self.screen = Screen::Prologue;\\n                self.focus = 0;\\n            }\\n            Screen::Prologue => {\\n                if label == \\\"Begin\\\" {\\n                    self.start_playing();\\n250→                }\\n            }\\n            Screen::Pause => match label {\\n                \\\"Resume\\\" => self.screen = Screen::Playing,\\n                \\\"Settings\\\" => {\\n                    self.screen = Screen::Settings;\\n                    self.focus = 0;\\n                }\\n                \\\"Controls\\\" => {\\n                    self.screen = Screen::Settings;\\n260→                    self.tab = 1;\\n                    self.focus = 0;\\n                }\\n                \\\"Dev mode\\\" if !self.hub => {\\n                    self.screen = Screen::Dev;\\n                    self.tab = 0;\\n                    self.page = 0;\\n                    self.focus = 0;\\n                }\\n                \\\"Quit to title\\\" => {\\n270→                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Screen::Settings => {\\n                if label == \\\"Xbox glyphs\\\" {\\n                    self.xbox = true;\\n                } else if label == \\\"PlayStation glyphs\\\" {\\n                    self.xbox = false;\\n280→                } else if label.starts_with(\\\"Page\\\") {\\n                    self.tab = (self.tab + 1) % 4;\\n                    self.focus = 0;\\n                }\\n            }\\n            Screen::Dev => {\\n                if self.tab == 0 {\\n                    self.tab = match label {\\n                        \\\"Cheats\\\" => 1,\\n                        \\\"Teleport\\\" => 2,\\n290→                        \\\"Spawn\\\" => 3,\\n                        \\\"World\\\" => 4,\\n                        \\\"Balance\\\" => 5,\\n                        _ => 0,\\n                    };\\n                    self.page = 0;\\n                    self.focus = 0;\\n                    return;\\n                }\\n                if label == \\\"Reset to defaults\\\" {\\n300→                    self.tune = self.tune0.clone();\\n                    return;\\n                }\\n                if label == \\\"Next page\\\" {\\n                    self.page += 1;\\n                    self.focus = 0;\\n                    return;\\n                }\\n                if self.tab == 1 {\\n                    self.toggle_cheat(label);\\n310→                }\\n            }\\n            Screen::About => {\\n                if label == \\\"Next\\\" {\\n                    self.page += 1;\\n                } else if label == \\\"Back\\\" && self.page > 0 {\\n                    self.page -= 1;\\n                } else if label == \\\"Back\\\" {\\n                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n320→                }\\n            }\\n            Screen::Mp => {\\n                if label == \\\"Back\\\" {\\n                    self.screen = Screen::Title;\\n                }\\n            }\\n            _ => {}\\n        }\\n    }\\n330→\\n    fn toggle_cheat(&mut self, label: &str) {\\n        let d = &mut self.dev;\\n        match label {\\n            \\\"God mode\\\" => d.god = !d.god,\\n            \\\"Infinite ammo\\\" => d.infinite = !d.infinite,\\n            \\\"No jams\\\" => d.no_jams = !d.no_jams,\\n            \\\"No fever\\\" => d.no_fever = !d.no_fever,\\n            \\\"Noclip\\\" => d.noclip = !d.noclip,\\n            \\\"Invisible\\\" => d.invisible = !d.invisible,\\n340→            \\\"Show AI\\\" => d.show_ai = !d.show_ai,\\n            \\\"Show fire\\\" => d.show_fire = !d.show_fire,\\n            \\\"Show nav\\\" => d.show_nav = !d.show_nav,\\n            \\\"Show stats\\\" => d.show_stats = !d.show_stats,\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn rows(&self) -> Vec<String> {\\n        let all: Vec<String> = match self.screen {\\n350→            Screen::Title => {\\n                let mut r = Vec::new();\\n                if self.has_save {\\n                    r.push(\\\"Continue\\\".into());\\n                }\\n                r.extend([\\\"New contract\\\".into(), \\\"Multiplayer\\\".into(), \\\"Settings\\\".into(), \\\"About\\\".into()]);\\n                r\\n            }\\n            Screen::Difficulty => vec![\\\"Easy\\\".into(), \\\"Normal\\\".into(), \\\"Hard\\\".into()],\\n            Screen::Merc => vec![\\\"Ada Okoro\\\".into(), \\\"Tomek Wrona\\\".into(), \\\"Rafael Quintero\\\".into(), \\\"Mirela Dragan\\\".into()],\\n360→            Screen::Prologue => vec![\\\"Begin\\\".into()],\\n            Screen::Pause => {\\n                let mut rows = vec![\\\"Resume\\\".into(), \\\"Settings\\\".into(), \\\"Controls\\\".into()];\\n                if !self.hub {\\n                    rows.push(\\\"Dev mode\\\".into());\\n                }\\n                rows.push(\\\"Quit to title\\\".into());\\n                rows\\n            }\\n            Screen::Settings => self.settings_rows(),\\n370→            Screen::About => vec![\\\"Next\\\".into(), \\\"Back\\\".into()],\\n            Screen::Dev => self.dev_rows(),\\n            Screen::Mp => vec![\\\"This computer\\\".into(), \\\"Invite code\\\".into(), \\\"Back\\\".into()],\\n            Screen::Attract => vec![\\\"Press any button\\\".into()],\\n            Screen::Playing => vec![],\\n        };\\n        all.into_iter().take(7).collect()\\n    }\\n\\n    fn settings_rows(&self) -> Vec<String> {\\n380→        match self.tab % 4 {\\n            0 => vec![\\\"Master\\\".into(), \\\"Music\\\".into(), \\\"Effects\\\".into(), \\\"Voices\\\".into(), \\\"Page\\\".into()],\\n            1 => vec![\\\"PlayStation glyphs\\\".into(), \\\"Xbox glyphs\\\".into(), \\\"Invert look\\\".into(), \\\"Sensitivity\\\".into(), \\\"Aim assist\\\".into(), \\\"Page\\\".into()],\\n            2 => vec![\\\"Fullscreen\\\".into(), \\\"Field of view\\\".into(), \\\"Brightness\\\".into(), \\\"Head bob\\\".into(), \\\"Page\\\".into()],\\n            _ => vec![\\\"Subtitle size\\\".into(), \\\"Reduce motion\\\".into(), \\\"Assist markers\\\".into(), \\\"Immersive hud\\\".into(), \\\"Page\\\".into()],\\n        }\\n    }\\n\\n    fn dev_rows(&self) -> Vec<String> {\\n        match self.tab {\\n390→            0 => vec![\\\"Cheats\\\".into(), \\\"Teleport\\\".into(), \\\"Spawn\\\".into(), \\\"World\\\".into(), \\\"Balance\\\".into()],\\n            1 => {\\n                let names = [\\\"God mode\\\", \\\"Infinite ammo\\\", \\\"No jams\\\", \\\"No fever\\\", \\\"Noclip\\\", \\\"Invisible\\\", \\\"Show AI\\\", \\\"Show fire\\\", \\\"Show nav\\\", \\\"Show stats\\\"];\\n                self.page_of(&names)\\n            }\\n            2 => {\\n                let names: Vec<&str> = super::geom::PLACES.iter().map(|p| p.name).collect();\\n                self.page_of_owned(names)\\n            }\\n            5 => {\\n400→                let mut rows = Vec::new();\\n                let start = self.page * 6;\\n                for i in start..(start + 6).min(self.tune.count()) {\\n                    rows.push(format!(\\\"{} {:.2}\\\", self.tune.name(i), self.tune.get(i)));\\n                }\\n                rows.push(\\\"Reset to defaults\\\".into());\\n                if start + 6 < self.tune.count() {\\n                    rows.pop();\\n                    rows.push(\\\"Next page\\\".into());\\n                    // Keep reset reachable: the last page holds it. Mid pages use Next.\\n410→                }\\n                if start + 6 >= self.tune.count() && !rows.iter().any(|r| r == \\\"Reset to defaults\\\") {\\n                    rows.push(\\\"Reset to defaults\\\".into());\\n                }\\n                rows\\n            }\\n            _ => vec![\\\"Next page\\\".into(), \\\"Reset to defaults\\\".into()],\\n        }\\n    }\\n\\n420→    fn page_of(&self, names: &[&str]) -> Vec<String> {\\n        let start = self.page * 6;\\n        let mut rows: Vec<String> = names.iter().skip(start).take(6).map(|s| (*s).to_string()).collect();\\n        if start + 6 < names.len() {\\n            rows.push(\\\"Next page\\\".into());\\n        } else {\\n            rows.push(\\\"Reset to defaults\\\".into());\\n        }\\n        rows\\n    }\\n430→\\n    fn page_of_owned(&self, names: Vec<&str>) -> Vec<String> {\\n        self.page_of(&names)\\n    }\\n\\n    pub fn notice(&self) -> Option<&'static str> {\\n        if self.touch_only { Some(\\\"Controller or keyboard required\\\") } else { None }\\n    }\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/shell.rs\",\"offset\":1,\"limit\":450,\"raw_output\":\"//! 10-foot shell. Every screen has at most seven focusable rows. Hover moves focus. Click confirms.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::world::{Screen, World};\\nuse crate::input::buttons;\\nuse crate::input::InputFrame;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Device {\\n    Gamepad,\\n    Keyboard,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct MenuInput {\\n    pub up: bool,\\n    pub down: bool,\\n    pub left: bool,\\n    pub right: bool,\\n    pub confirm: bool,\\n    pub back: bool,\\n    pub pointer: Option<(f32, f32)>,\\n    pub click: bool,\\n    pub device: Option<Device>,\\n}\\n\\nimpl Default for MenuInput {\\n    fn default() -> Self {\\n        Self { up: false, down: false, left: false, right: false, confirm: false, back: false, pointer: None, click: false, device: None }\\n    }\\n}\\n\\npub fn glyph(action: &str, device: Device, xbox: bool) -> &'static str {\\n    match (device, xbox, action) {\\n        (Device::Keyboard, _, \\\"confirm\\\") => \\\"Enter\\\",\\n        (Device::Keyboard, _, \\\"back\\\") => \\\"Esc\\\",\\n        (Device::Keyboard, _, \\\"fire\\\") => \\\"LMB\\\",\\n        (Device::Keyboard, _, \\\"aim\\\") => \\\"RMB\\\",\\n        (Device::Keyboard, _, \\\"reload\\\") => \\\"R\\\",\\n        (Device::Keyboard, _, \\\"map\\\") => \\\"M\\\",\\n        (Device::Keyboard, _, \\\"jump\\\") => \\\"Space\\\",\\n        (Device::Gamepad, false, \\\"confirm\\\") => \\\"Cross\\\",\\n        (Device::Gamepad, true, \\\"confirm\\\") => \\\"A\\\",\\n        (Device::Gamepad, false, \\\"back\\\") => \\\"Circle\\\",\\n        (Device::Gamepad, true, \\\"back\\\") => \\\"B\\\",\\n        (Device::Gamepad, false, \\\"reload\\\") => \\\"Square\\\",\\n        (Device::Gamepad, true, \\\"reload\\\") => \\\"X\\\",\\n        (Device::Gamepad, false, \\\"fire\\\") => \\\"R2\\\",\\n        (Device::Gamepad, true, \\\"fire\\\") => \\\"RT\\\",\\n        (Device::Gamepad, false, \\\"aim\\\") => \\\"L2\\\",\\n        (Device::Gamepad, true, \\\"aim\\\") => \\\"LT\\\",\\n        (Device::Gamepad, _, \\\"map\\\") => \\\"D-pad\\\",\\n        (Device::Gamepad, false, \\\"jump\\\") => \\\"Cross\\\",\\n        (Device::Gamepad, true, \\\"jump\\\") => \\\"A\\\",\\n        _ => \\\"Button\\\",\\n    }\\n}\\n\\nfn menu_of(input: &InputFrame) -> MenuInput {\\n    MenuInput {\\n        up: input.act == 3,\\n        down: input.act == 4,\\n        left: input.act == 5,\\n        right: input.act == 6,\\n        confirm: input.act == 1 || input.just(buttons::CONFIRM) || input.just(buttons::JUMP),\\n        back: input.act == 2,\\n        pointer: None,\\n        click: false,\\n        device: None,\\n    }\\n}\\n\\nimpl World {\\n    pub fn shell_tick(&mut self, input: &InputFrame, dt: f32) {\\n        let typed = input.pressed != 0\\n            || input.act != 0\\n            || input.look.length_squared() > 1e-8\\n            || input.move_dir.length_squared() > 1e-8;\\n        if typed && self.device_lock == 0 {\\n            // A pointer-only hover does not arrive through InputFrame. Keyboard buttons do.\\n            if input.pressed & (buttons::CONFIRM | buttons::JUMP | buttons::MAP | buttons::RELOAD) != 0 || input.act != 0 {\\n                self.device = Device::Keyboard;\\n            }\\n        }\\n        if self.screen == Screen::Attract {\\n            if typed {\\n                self.screen = Screen::Title;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n                self.attract_t = 0.0;\\n                return;\\n            }\\n            self.attract_t += dt;\\n            let seg = ((self.attract_t / 16.0) as u32) % 10;\\n            self.attract_seen |= 1u16 << seg;\\n            self.attract_loops = (self.attract_t / 160.0) as u32;\\n            return;\\n        }\\n        let shell = self.screen != Screen::Playing;\\n        if shell {\\n            if typed {\\n                self.idle = 0.0;\\n            } else if !self.hub {\\n                self.idle += dt;\\n            }\\n            if self.idle >= 10.0 && !self.hub {\\n                self.screen = Screen::Attract;\\n                return;\\n            }\\n            let mut m = menu_of(input);\\n            m.pointer = self.pointer.take();\\n            m.click = std::mem::take(&mut self.pointer_click);\\n            self.apply_menu(m);\\n            let _ = &mut m;\\n        }\\n    }\\n\\n    pub fn apply_menu(&mut self, m: MenuInput) {\\n        if let Some(d) = m.device {\\n            self.device = d;\\n        }\\n        if self.screen == Screen::Playing || self.screen == Screen::Attract {\\n            if m.confirm || m.back || m.up || m.down || m.click || m.pointer.is_some() {\\n                if self.screen == Screen::Attract {\\n                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                    self.idle = 0.0;\\n                    self.attract_t = 0.0;\\n                }\\n            }\\n            if self.screen != Screen::Title {\\n                return;\\n            }\\n        }\\n        let n = self.rows().len();\\n        if n == 0 {\\n            return;\\n        }\\n        if let Some((px, py)) = m.pointer {\\n            for i in 0..n {\\n                let y0 = 220.0 + i as f32 * 80.0;\\n                if px >= 160.0 && px <= 900.0 && py >= y0 && py <= y0 + 64.0 {\\n                    self.focus = i;\\n                }\\n            }\\n        }\\n        if m.up {\\n            self.focus = if self.focus == 0 { n - 1 } else { self.focus - 1 };\\n        }\\n        if m.down {\\n            self.focus = (self.focus + 1) % n;\\n        }\\n        self.focus = self.focus.min(n - 1);\\n        let activate = m.confirm || m.click;\\n        if m.left || m.right {\\n            self.nudge_slider(if m.right { 1.0 } else { -1.0 });\\n        }\\n        if m.back {\\n            self.go_back();\\n        }\\n        if activate {\\n            let rows = self.rows();\\n            let label = rows.get(self.focus).cloned().unwrap_or_default();\\n            self.activate(&label);\\n        }\\n    }\\n\\n    fn go_back(&mut self) {\\n        self.focus = 0;\\n        match self.screen {\\n            Screen::Difficulty | Screen::Settings | Screen::About | Screen::Mp => self.screen = Screen::Title,\\n            Screen::Merc => self.screen = Screen::Difficulty,\\n            Screen::Prologue => self.screen = Screen::Merc,\\n            Screen::Dev if self.tab != 0 => self.tab = 0,\\n            Screen::Dev => self.screen = Screen::Pause,\\n            Screen::Pause => self.screen = Screen::Playing,\\n            _ => {}\\n        }\\n    }\\n\\n    fn nudge_slider(&mut self, dir: f32) {\\n        if self.screen != Screen::Dev || self.tab != 5 {\\n            if self.screen == Screen::Settings && self.tab == 0 && self.focus == 1 {\\n                self.music = (self.music + dir * 0.05).clamp(0.0, 1.0);\\n            }\\n            return;\\n        }\\n        let count = self.tune.count();\\n        let page_size = 6;\\n        let index = self.page * page_size + self.focus;\\n        if self.focus == 6 || index >= count {\\n            if dir < 0.0 && self.page > 0 {\\n                self.page -= 1;\\n                self.focus = 0;\\n            }\\n            return;\\n        }\\n        let (lo, hi, step) = self.tune.range(index);\\n        let v = (self.tune.get(index) + dir * step).clamp(lo, hi);\\n        self.tune.set(index, v);\\n    }\\n\\n    fn activate(&mut self, label: &str) {\\n        match self.screen {\\n            Screen::Title => match label {\\n                \\\"Continue\\\" => self.continue_save(),\\n                \\\"New contract\\\" => {\\n                    self.screen = Screen::Difficulty;\\n                    self.focus = 1;\\n                }\\n                \\\"Multiplayer\\\" => {\\n                    self.screen = Screen::Mp;\\n                    self.focus = 0;\\n                }\\n                \\\"Settings\\\" => {\\n                    self.screen = Screen::Settings;\\n                    self.tab = 0;\\n                    self.focus = 0;\\n                }\\n                \\\"About\\\" => {\\n                    self.screen = Screen::About;\\n                    self.page = 0;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Screen::Difficulty => {\\n                self.difficulty = match label {\\n                    \\\"Easy\\\" => 0,\\n                    \\\"Hard\\\" => 2,\\n                    _ => 1,\\n                };\\n                self.screen = Screen::Merc;\\n                self.focus = 0;\\n            }\\n            Screen::Merc => {\\n                self.merc = match label {\\n                    \\\"Tomek Wrona\\\" => 1,\\n                    \\\"Rafael Quintero\\\" => 2,\\n                    \\\"Mirela Dragan\\\" => 3,\\n                    _ => 0,\\n                };\\n                self.screen = Screen::Prologue;\\n                self.focus = 0;\\n            }\\n            Screen::Prologue => {\\n                if label == \\\"Begin\\\" {\\n                    self.start_playing();\\n                }\\n            }\\n            Screen::Pause => match label {\\n                \\\"Resume\\\" => self.screen = Screen::Playing,\\n                \\\"Settings\\\" => {\\n                    self.screen = Screen::Settings;\\n                    self.focus = 0;\\n                }\\n                \\\"Controls\\\" => {\\n                    self.screen = Screen::Settings;\\n                    self.tab = 1;\\n                    self.focus = 0;\\n                }\\n                \\\"Dev mode\\\" if !self.hub => {\\n                    self.screen = Screen::Dev;\\n                    self.tab = 0;\\n                    self.page = 0;\\n                    self.focus = 0;\\n                }\\n                \\\"Quit to title\\\" => {\\n                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Screen::Settings => {\\n                if label == \\\"Xbox glyphs\\\" {\\n                    self.xbox = true;\\n                } else if label == \\\"PlayStation glyphs\\\" {\\n                    self.xbox = false;\\n                } else if label.starts_with(\\\"Page\\\") {\\n                    self.tab = (self.tab + 1) % 4;\\n                    self.focus = 0;\\n                }\\n            }\\n            Screen::Dev => {\\n                if self.tab == 0 {\\n                    self.tab = match label {\\n                        \\\"Cheats\\\" => 1,\\n                        \\\"Teleport\\\" => 2,\\n                        \\\"Spawn\\\" => 3,\\n                        \\\"World\\\" => 4,\\n                        \\\"Balance\\\" => 5,\\n                        _ => 0,\\n                    };\\n                    self.page = 0;\\n                    self.focus = 0;\\n                    return;\\n                }\\n                if label == \\\"Reset to defaults\\\" {\\n                    self.tune = self.tune0.clone();\\n                    return;\\n                }\\n                if label == \\\"Next page\\\" {\\n                    self.page += 1;\\n                    self.focus = 0;\\n                    return;\\n                }\\n                if self.tab == 1 {\\n                    self.toggle_cheat(label);\\n                }\\n            }\\n            Screen::About => {\\n                if label == \\\"Next\\\" {\\n                    self.page += 1;\\n                } else if label == \\\"Back\\\" && self.page > 0 {\\n                    self.page -= 1;\\n                } else if label == \\\"Back\\\" {\\n                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                }\\n            }\\n            Screen::Mp => {\\n                if label == \\\"Back\\\" {\\n                    self.screen = Screen::Title;\\n                }\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    fn toggle_cheat(&mut self, label: &str) {\\n        let d = &mut self.dev;\\n        match label {\\n            \\\"God mode\\\" => d.god = !d.god,\\n            \\\"Infinite ammo\\\" => d.infinite = !d.infinite,\\n            \\\"No jams\\\" => d.no_jams = !d.no_jams,\\n            \\\"No fever\\\" => d.no_fever = !d.no_fever,\\n            \\\"Noclip\\\" => d.noclip = !d.noclip,\\n            \\\"Invisible\\\" => d.invisible = !d.invisible,\\n            \\\"Show AI\\\" => d.show_ai = !d.show_ai,\\n            \\\"Show fire\\\" => d.show_fire = !d.show_fire,\\n            \\\"Show nav\\\" => d.show_nav = !d.show_nav,\\n            \\\"Show stats\\\" => d.show_stats = !d.show_stats,\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn rows(&self) -> Vec<String> {\\n        let all: Vec<String> = match self.screen {\\n            Screen::Title => {\\n                let mut r = Vec::new();\\n                if self.has_save {\\n                    r.push(\\\"Continue\\\".into());\\n                }\\n                r.extend([\\\"New contract\\\".into(), \\\"Multiplayer\\\".into(), \\\"Settings\\\".into(), \\\"About\\\".into()]);\\n                r\\n            }\\n            Screen::Difficulty => vec![\\\"Easy\\\".into(), \\\"Normal\\\".into(), \\\"Hard\\\".into()],\\n            Screen::Merc => vec![\\\"Ada Okoro\\\".into(), \\\"Tomek Wrona\\\".into(), \\\"Rafael Quintero\\\".into(), \\\"Mirela Dragan\\\".into()],\\n            Screen::Prologue => vec![\\\"Begin\\\".into()],\\n            Screen::Pause => {\\n                let mut rows = vec![\\\"Resume\\\".into(), \\\"Settings\\\".into(), \\\"Controls\\\".into()];\\n                if !self.hub {\\n                    rows.push(\\\"Dev mode\\\".into());\\n                }\\n                rows.push(\\\"Quit to title\\\".into());\\n                rows\\n            }\\n            Screen::Settings => self.settings_rows(),\\n            Screen::About => vec![\\\"Next\\\".into(), \\\"Back\\\".into()],\\n            Screen::Dev => self.dev_rows(),\\n            Screen::Mp => vec![\\\"This computer\\\".into(), \\\"Invite code\\\".into(), \\\"Back\\\".into()],\\n            Screen::Attract => vec![\\\"Press any button\\\".into()],\\n            Screen::Playing => vec![],\\n        };\\n        all.into_iter().take(7).collect()\\n    }\\n\\n    fn settings_rows(&self) -> Vec<String> {\\n        match self.tab % 4 {\\n            0 => vec![\\\"Master\\\".into(), \\\"Music\\\".into(), \\\"Effects\\\".into(), \\\"Voices\\\".into(), \\\"Page\\\".into()],\\n            1 => vec![\\\"PlayStation glyphs\\\".into(), \\\"Xbox glyphs\\\".into(), \\\"Invert look\\\".into(), \\\"Sensitivity\\\".into(), \\\"Aim assist\\\".into(), \\\"Page\\\".into()],\\n            2 => vec![\\\"Fullscreen\\\".into(), \\\"Field of view\\\".into(), \\\"Brightness\\\".into(), \\\"Head bob\\\".into(), \\\"Page\\\".into()],\\n            _ => vec![\\\"Subtitle size\\\".into(), \\\"Reduce motion\\\".into(), \\\"Assist markers\\\".into(), \\\"Immersive hud\\\".into(), \\\"Page\\\".into()],\\n        }\\n    }\\n\\n    fn dev_rows(&self) -> Vec<String> {\\n        match self.tab {\\n            0 => vec![\\\"Cheats\\\".into(), \\\"Teleport\\\".into(), \\\"Spawn\\\".into(), \\\"World\\\".into(), \\\"Balance\\\".into()],\\n            1 => {\\n                let names = [\\\"God mode\\\", \\\"Infinite ammo\\\", \\\"No jams\\\", \\\"No fever\\\", \\\"Noclip\\\", \\\"Invisible\\\", \\\"Show AI\\\", \\\"Show fire\\\", \\\"Show nav\\\", \\\"Show stats\\\"];\\n                self.page_of(&names)\\n            }\\n            2 => {\\n                let names: Vec<&str> = super::geom::PLACES.iter().map(|p| p.name).collect();\\n                self.page_of_owned(names)\\n            }\\n            5 => {\\n                let mut rows = Vec::new();\\n                let start = self.page * 6;\\n                for i in start..(start + 6).min(self.tune.count()) {\\n                    rows.push(format!(\\\"{} {:.2}\\\", self.tune.name(i), self.tune.get(i)));\\n                }\\n                rows.push(\\\"Reset to defaults\\\".into());\\n                if start + 6 < self.tune.count() {\\n                    rows.pop();\\n                    rows.push(\\\"Next page\\\".into());\\n                    // Keep reset reachable: the last page holds it. Mid pages use Next.\\n                }\\n                if start + 6 >= self.tune.count() && !rows.iter().any(|r| r == \\\"Reset to defaults\\\") {\\n                    rows.push(\\\"Reset to defaults\\\".into());\\n                }\\n                rows\\n            }\\n            _ => vec![\\\"Next page\\\".into(), \\\"Reset to defaults\\\".into()],\\n        }\\n    }\\n\\n    fn page_of(&self, names: &[&str]) -> Vec<String> {\\n        let start = self.page * 6;\\n        let mut rows: Vec<String> = names.iter().skip(start).take(6).map(|s| (*s).to_string()).collect();\\n        if start + 6 < names.len() {\\n            rows.push(\\\"Next page\\\".into());\\n        } else {\\n            rows.push(\\\"Reset to defaults\\\".into());\\n        }\\n        rows\\n    }\\n\\n    fn page_of_owned(&self, names: Vec<&str>) -> Vec<String> {\\n        self.page_of(&names)\\n    }\\n\\n    pub fn notice(&self) -> Option<&'static str> {\\n        if self.touch_only { Some(\\\"Controller or keyboard required\\\") } else { None }\\n    }\\n}\\n\",\"total_lines\":438}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"62de7c5e-7530-4c9f-a718-54409ed51625"}
