eed,\\n        };\\n        *p = v;\\n    }\\n    pub fn range(&self, i: usize) -> (f32, f32, f32) {\\n140→        match i {\\n            0 | 3 | 5 | 6 | 10 | 13 | 16 | 17 | 18 | 20 => (0.0, 3.0, 0.05),\\n            7 => (1.0, 40.0, 1.0),\\n            8 => (0.05, 3.0, 0.05),\\n            9 | 15 => (0.5, 30.0, 0.5),\\n            12 => (30.0, 2000.0, 10.0),\\n            19 => (1.0, 72.0, 1.0),\\n            _ => (0.0, 200.0, 1.0),\\n        }\\n    }\\n150→}\\n\\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\\npub struct Dev {\\n    pub god: bool,\\n    pub infinite: bool,\\n    pub no_jams: bool,\\n    pub no_fever: bool,\\n    pub noclip: bool,\\n    pub invisible: bool,\\n160→    pub show_ai: bool,\\n    pub show_fire: bool,\",\"content_concise\":\"42→#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Tune {\\n    pub enemy_accuracy: f32,\\n    pub enemy_damage: f32,\\n    pub player_damage: f32,\\n    pub detection: f32,\\n    pub enemy_count: f32,\\n    pub weapon_wear: f32,\\n50→    pub jam_chance: f32,\\n    pub break_threshold: f32,\\n    pub fire_spread: f32,\\n    pub burn_time: f32,\\n    pub wind_strength: f32,\\n    pub burn_damage: f32,\\n    pub fever_interval: f32,\\n    pub fever_severity: f32,\\n    pub syrette_heal: f32,\\n    pub rescue_window: f32,\\n60→    pub vehicle_speed: f32,\\n    pub vehicle_tough: f32,\\n    pub contract_pay: f32,\\n    pub post_reman_hours: f32,\\n    pub player_speed: f32,\\n}\\n\\nimpl Default for Tune {\\n    fn default() -> Self {\\n        Self {\\n70→            enemy_accuracy: 0.35,\\n            enemy_damage: 8.0,\\n            player_damage: 1.0,\\n            detection: 1.0,\\n            enemy_count: 1.0,\\n            weapon_wear: 1.0,\\n            jam_chance: 1.0,\\n            break_threshold: 8.0,\\n            fire_spread: 0.9,\\n            burn_time: 10.0,\\n80→            wind_strength: 1.0,\\n            burn_damage: 20.0,\\n            fever_interval: 15.0 * 60.0,\\n       