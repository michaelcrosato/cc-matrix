ns/claude-sonnet-5-5-medium.build__20261104-070752__xb697dc/work/AmericanFootballFiasco-AmericanFootball-claude-sonnet-5-5-medium-20261104-070752; python3 - <<'EOF'\np='src/30-sim.js'; s=open(p).read()\ns=s.replace(\"case 'half': this.pt += dt; if (this.pt > 6 && (!this.humans[0] && !this.humans[1] || this.adj[0] !== 0 || this.adj[1] !== 0 || this.pt > 14)) this.nextQuarter(); break;\",\"case 'half': this.pt += dt; if (this.pt > 5 && ([0, 1].every(s => !this.humans[s] || this.adj[s] !== 0) || this.pt > 16)) this.nextQuarter(); break;\")\ns=s.replace(\"if (!T.noClock && !L.over) this.clock\",\"if (!T.noClock && !this.noClock && !L.over) this.clock\")\ns=s.replace(\"this.cheat = !!o.cheat;\",\"this.cheat = !!o.cheat; this.noClock = !!o.noClock;\")\ns=s.replace(\"if (this.clock <= 0 && !T.noClock) { this.endQuarter(); return; }\",\"if (this.clock <= 0 && !T.noClock && !this.noClock) { this.endQuarter(); return; }\")\nopen(p,'w').write(s)\nEOF\ngrep -c noClock src/30-sim.js"}}}
