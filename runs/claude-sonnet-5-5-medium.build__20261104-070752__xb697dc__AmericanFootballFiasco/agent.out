== 'def' && M2.callTime > .4) p2.tap('confirm'); } if (M2.phase === 'set' && M2.humans[M2.poss]) (M2.poss === 0 ? I1 : p2).tap('a'); game.advance(1 / 30); t += 1 / 30; }\n  check('two players share a game: each calls and plays', M2.stats[0].plays + M2.stats[1].plays >= 4, JSON.stringify(M2.stats.map(s => s.plays)));\n  check('no errors in 2 player play', !game.errors.length, errs(game));\n}\n\n/* ---- the full game, as a person\"\"\")\ns=s.replace(\"/* ---- the browser: every screen draws\",\"\"\"/* ---- the AI Hub's own harness over the bundle (when it is built) ---- */\n{\n  const r = spawnSync('node', ['test/hub.mjs', '2'], { cwd: new URL('../', import.meta.url).pathname, encoding: 'utf8', timeout: 170000 });\n  const out = (r.stdout || '') + (r.stderr || '');\n  check('hub harness: 2 players pass', /no bundle/.test(out) || r.status === 0, out.trim().split('\\\\n').slice(-4).join(' / '));\n}\n\n/* ---- the browser: every screen draws\"\"\")\nopen(p,'w').write(s)\nEOF\nnode build.mjs && (time node test/run.mjs > /tmp/run3.out 2>&1; head -20 /tmp/run3.out) 2>&1 | tail -12","uuid":"55042412-19c7-4dab-8a89-d95e2fd8e1fa","session_id":"b4cfa638-847f-4819-b536-9be2b027efa5"}
