ementById('screen').getBoundingClientRect(); const g = My3D2dge.current; return a.scr ? [a.scr[0] / g.W * c.width, a.scr[1] / g.H * c.height] : null; })()\")\n            if not pt: break\n            await pg.mouse.move(pt[0], pt[1]); await pg.mouse.down(button='right'); await pg.wait_for_timeout(900)\n            pt = await pg.evaluate(\"(() => { const F = __wt.FD, a = F.corner.agents.find(x => x.person === 'tee'); a.facing = Math.atan2(F.me.y - a.y, F.me.x - a.x); const c = document.getElementById('screen').getBoundingClientRect(); const g = My3D2dge.current; return [a.scr[0] / g.W * c.width, a.scr[1] / g.H * c.height]; })()\")\n            await pg.mouse.move(pt[0], pt[1]); await pg.wait_for_timeout(700)\n            await pg.mouse.down(button='left'); await pg.wait_for_timeout(60); await pg.mouse.up(button='left')\n            await pg.wait_for_timeout(300); await pg.mouse.up(button='right')\n            got = await pg.evaluate(\"__wt.state().facts.includes('face:tee')\")\n            if got: break\n        await pg.screenshot(path='/tmp/wtshots/photo.png')\n        print('mouse photo of Tee -> face fact:', got, '| photos', await pg.evaluate(\"__wt.state().photos.map(p => p.subject + ':' + p.stars).join(' ')\"), '| errors', errs[:2])\n        await b.close()\n        # gamepad: glyphs, Xbox setting, stick inversion\n        b = await p.chromium.launch(); pg = await b.new_page(viewport={'width': 1280, 'height': 720}); await pg.add_init_script(PAD)\n        await pg.goto(URL + '#ep1.eyes'); await pg.wait_for_timeout(2500)\n        await pg.evaluate(\"__pad.buttons[0].pressed = true; __pad.buttons[0].value = 1\"); await pg.wait_for_timeout(150); await pg.evaluate(\"__pad.buttons[0].pressed = false; __pad.buttons[0].value = 0\")\n        for i in range(4):\n            await pg.evaluate(\"__pad.buttons[0].pressed = true\"); await pg.wait_for_timeout(120); await pg.evaluate(\"__pad.buttons[0].pressed = false\"); await pg.wait_for_timeout(400)\n        lab = await pg.evaluate(\"My3D2dge.current.input.label('interact')\")\n        await pg.evaluate(\"My3D2dge.current.settings.set('padSymbols', 'xbox')\"); await pg.wait_for_timeout(200)\n        lab2 = await pg.evaluate(\"My3D2dge.current.input.label('interact')\")\n        await pg.evaluate(\"My3D2dge.current.settings.set('padSymbols', 'playstation')\")\n        x0 = await pg.evaluate(\"__wt.FD.me.x\")\n        await pg.evaluate(\"__pad.axes[0] = 1\"); await pg.wait_for_timeout(700); await pg.evaluate(\"__pad.axes[0] = 0\"); await pg.wait_for_timeout(200)\n        x1 = await pg.evaluate(\"__wt.FD.me.x\")\n        await pg.evaluate(\"My3D2dge.current.settings.set('stickInvX', true)\")\n        await pg.evaluate(\"__pad.axes[0] = 1\"); await pg.wait_for_timeout(700); await pg.evaluate(\"__pad.axes[0] = 0\"); await pg.wait_for_timeout(200)\n        x2 = await pg.evaluate(\"__wt.FD.me.x\")\n        await pg.screenshot(path='/tmp/wtshots/pad.png')\n        print('pad glyph:', lab, '| xbox:', lab2, '| stick right moved dx', round(x1 - x0), '| inverted dx', round(x2 - x1), '| prompt dev', await pg.evaluate(\"document.querySelector('.esh-pr, .esh-k') ? document.querySelector('.esh-pr, .esh-k').textContent.slice(0,20) : 'no shell prompt'\"))\n        await b.close()\n        # touch-only: WebKit iPhone\n        w = await p.webkit.launch(); ctx = await w.new_context(**p.devices['iPhone 13']); pg = await ctx.new_page()\n        await pg.goto(URL); await pg.wait_for_timeout(3000)\n        t = await pg.evaluate(\"document.querySelector('#ui .touchpanel') ? document.querySelector('#ui .touchpanel').textContent.slice(0, 60) : 'none'\")\n        await pg.screenshot(path='/tmp/wtshots/touch.png')\n        await pg.wait_for_timeout(11000); att = await pg.evaluate(\"__wt.Attract.on\")\n        print('touch-only panel:', t, '| attract after 11 s:', att)\n        await w.close()\nasyncio.run(main())\nEOF\ncd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-125818__x600c07/work &