 1100 bytes', JSON.stringify(s.snap()).length < 1100, JSON.stringify(s.snap()).length + ' bytes');\\n}\\nok('no errors overall', !game.errors.length, errs());\\nprocess.exit(fails ? 1 : 0);\\nEOF\\ntimeout 600 node tests/headless.mjs 2>&1 | tail -50\",\"description\":\"Run the headless smoke test\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":678,\"cache_read_input_tokens\":483443,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":678},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"90c0e12f-02cb-4f48-b07b-9e01e40f5f84\",\"uuid\":\"cee5c3f2-7f51-4612-8ad5-0d76814d03a2\",\"timestamp\":\"2026-11-03T21:00:10.510Z\",\"request_id\":\"req_011Cggfeo1uLv2TkpVdsLZPN\",\"wire_tool_inputs\":{\"toolu_01UzzgSsqp3HCrik8gzk21Xo\":{\"command\":\"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-125818__x600c07/work/Wiretap-TheWire-claude-opus-5-5-medium-20261103-125818 && cat > tests/headless.mjs <<'EOF'\\n// Headless: boot, every beat for a few seconds, the attract reel, a bots-only versus round, rule checks. One line each.\\nimport vm from 'node:vm'; import { readFileSync } from 'node:fs';\\nconst ctx = { console: { log: console.log, info() {}, warn() {}, error: console.error }, addEventListener() {}, location: { hash: '' }, setTimeout: (f) => f(), clearTimeout() {}, performance: { now: () => Date.now() } };\\nctx.window = ctx; vm.createContext(ctx);\\nvm.runInContext(readFileSync('engine/my-3d2dge.js', 'utf8'), ctx);\\nvm.runInContext(readFileSync('dev-bundle.js', 'utf8'), ctx, { filename: 'game.js' });\\nconst D = ctx.__wt, game = ctx.My3D2dge.current; let fails = 0;\\nconst ok = (name, cond, extra = '') => { cons