keyboard)"," class KeyController {","-  constructor(map) { this.map = map; this.held = new Set(); this.tapped = new Set(); this.kb = true;","+  constructor(map, pad) { this.map = map; this.pad = pad == null ? -1 : pad; this.pheld = {}; this.ptap = {}; this.pmove = [0, 0]; this.held = new Set(); this.tapped = new Set(); this.kb = true;","     this.kd = e => { if (e.repeat) return; this.held.add(e.code); this.tapped.add(e.code); }; this.ku = e => { this.held.delete(e.code); };","     window.addEventListener('keydown', this.kd); window.addEventListener('keyup', this.ku); }","   dispose() { window.removeEventListener('keydown', this.kd); window.removeEventListener('keyup', this.ku); }","+  // gamepad poll (standard mapping): left stick/d-pad move, face buttons act; call once per step","+  poll() { if (this.pad < 0) return; let gp = null; try { const l = navigator.getGamepads ? navigator.getGamepads() : []; gp = l[this.pad]; } catch (e) { gp = null; } if (!gp || !gp.connected) { this.pmove = [0, 0]; return; }","+    const b = i => !!(gp.buttons[i] && gp.buttons[i].pressed), ax = dz(gp.axes[0] || 0) + (b(15) ? 1 : 0) - (b(14) ? 1 : 0), ay = dz(gp.axes[1] || 0) + (b(13) ? 1 : 0) - (b(12) ? 1 : 0), m = Math.max(1, Math.hypot(ax, ay)); this.pmove = [ax / m, ay / m];","+    const PM = { interact: 0, crouch: 1, blend: 2, partner: 3, watch: 6, photo: 7, sprint: 10 }; for (const a in PM) { const now = b(PM[a]); if (now && !this.pheld[a]) this.ptap[a] = true; this.pheld[a] = now; } }","   has(a, set) { return (this.map[a] || []).some(c => set.has(c)); }","-  move() { const x = (this.has('right', this.held) ? 1 : 0) - (this.has('left', this.held) ? 1 : 0), y = (this.has('down', this.held) ? 1 : 0) - (this.has('up', this.held) ? 1 : 0), m = Math.hypot(x, y) || 1; return [x / m, y / m]; }","-  down(a) { return this.has(a, this.held); }","-  pressed(a) { const hit = (this.map[a] || []).filter(c => this.tapped.has(c)); hit.forEach(c => this.tapped.delete(c)); return hit.length > 0; }","+  move() { if (this.pmove[0] || this.pmove[1]) return this.pmove; const x = (this.has('right', this.held) ? 1 : 0) - (this.has('left', this.held) ? 1 : 0), y = (this.has('down', this.held) ? 1 : 0) - (this.has('up', this.held) ? 1 : 0), m = Math.hypot(x, y) || 1; return [x / m, y / m]; }","+  down(a) { return this.has(a, this.held) || !!this.pheld[a]; }","+  pressed(a) { if (this.ptap[a]) { this.ptap[a] = false; return true; } const hit = (this.map[a] || []).filter(c => this.tapped.has(c)); hit.forEach(c => this.tapped.delete(c)); return hit.length > 0; }","   released() { return false; }"," }"," const P1_KEYS = { up: ['KeyW'], down: ['KeyS'], left: ['KeyA'], right: ['KeyD'], watch: ['KeyQ'], photo: ['KeyE'], blend: ['KeyF'], sprint: ['ShiftLeft'], crouch: ['KeyC'] };"]},{"oldStart":15780,"oldLines":7,"newStart":15784,"newLines":7,"lines":["   searchSpot(k) { if (this.search[k]) return; this.search[k] = 1; STATE.caseScore += 12; Sound.sfx('cash'); game.particles.glints && game.particles.glints(this.raidSpots[k].x, this.raidSpots[k].y, 10, 8, '#ffe080'); Hud.toast('Found', ['Bundles under a tarp: 14 vials per bag', 'A ledger in a coffee can', 'A shoebox of burner phones'][Object.keys(this.search).length - 1] || 'Stash'); if (Object.keys(this.search).length >= 3) this.finish(true); },","   // ---------- per step ----------","   update(dt) {","-    this.t += dt; const I = game.input, m = this.m, D = this.dana, sim = this.sim;","+    this.t += dt; const I = game.input, m = this.m, D = this.dana, sim = this.sim; if (this.k1) { this.k1.poll(); this.k2.poll(); }","     if (this.data.hub) { Net.stamp && Net.stamp(); Net.tick(dt, this); Net.interp(dt); if (AIHub.server) { D.hidden = true; D.heat = 0; } }","     if (UI.isOpen) { Hud.set(''); sim.update(0, D); return; }","     if (this.over) { return; }"]},{"oldStart":15819,"oldLines":7,"newStart":15823,"newLines":7,"lines":["     }","   },","   setupVs2() {","-    this.k1 = new KeyController(P1_KEYS); this.k2 = new KeyCont