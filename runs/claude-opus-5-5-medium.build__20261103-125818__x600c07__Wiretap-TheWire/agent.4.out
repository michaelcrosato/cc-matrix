na. Corey's not answering. Somebody saw Rook walk him into fourteen-twelve. Sixty seconds, maybe less.\"]] : [['navarre', \"(radio) Friday, nine o'clock. The truck's in. Your call on the door.\"]]; },","+  intro(F) { return FL().coreyExposed ? [['lou', \"(radio) Dana. Corey's not answering. Somebody saw Rook walk him into fourteen-twelve. Sixty seconds, maybe less.\"]] : [['navarre', \"(radio) Friday, nine o'clock. The truck's in. Your call on the door.\"]]; },","   afterIntro(F) { if (F.flags.phase === 'plan') this.plan(F); },","   plan(F) {","     UI.cards({ kicker: 'THE RAID', title: 'Which door?', cards: [{ title: 'Front: the roll-up', body: 'Dana and Lou on the big door. Ren on the side.', k: 'front' }, { title: 'The side door', body: 'Quieter. The roll-up is open on Harlow.', k: 'side' }, { title: 'Both: split the team', body: 'Everybody covered. Slower breach.', k: 'both' }],","       pick: (i, c) => { F.flags.door = c.k === 'side' ? 'side' : 'front'; F.flags.both = c.k === 'both'; F.flags.phase = 'stack'; const p = F.flags.door === 'side' ? C(48.6, 50) : C(56.6, 50.5); F.me.body.x = p.x; F.me.body.y = p.y;","-        F.dl = npc('dale', 52, 50.2, { face: 0 }); F.tee = npc('tee', 53, 51.6, { face: Math.PI, pose: 'kneel' }); F.moeR = npc('moe', 51.5, 52, { face: 0 }); if (F().rookFree) F.rookG = npc('rook', 54, 49.4, { face: Math.PI }); Music.play('chase'); } });","+        F.dl = npc('dale', 52, 50.2, { face: 0 }); F.tee = npc('tee', 53, 51.6, { face: Math.PI, pose: 'kneel' }); F.moeR = npc('moe', 51.5, 52, { face: 0 }); if (FL().rookFree) F.rookG = npc('rook', 54, 49.4, { face: Math.PI }); Music.play('chase'); } });","   },","   breach(F) {","     sfx('doorRam'); game.shake(4); game.particles.dust(F.me.x, F.me.y, 10, 14);"]},{"oldStart":142,"oldLines":13,"newStart":142,"newLines":13,"lines":["   update(F, dt) {","     const fl = F.flags;","     if (fl.phase === 'rescue') { fl.rescueT -= dt; F.pursuit = true;","-      if (dist(F.me, C(28, 36)) < 30) { fl.phase