s.lastActivity > 10000\n\t\t\t)\n\t\t\t\tthis.beginAttract();\n\t\t} else if (this.mode === \"attract\") this.attract(dt);\n\t\telse if (this.mode === \"playing\") {\n\t\t\tconst paused = !!this.ui.current && !this.net.hub && !this.net.channel;\n\t\t\tif (!paused && this.net.host) {\n\t\t\t\tthis.accumulator += dt;\n\t\t\t\twhile (this.accumulator >= 1 / 60) {\n\t\t\t\t\tthis.simulate(1 / 60);\n\t\t\t\t\tthis.accumulator -= 1 / 60;\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (!paused) this.net.tick(dt);\n\t\t\tif (!paused && this.net.connected && !this.net.host) this.updateHazards();\n\t\t\tif (!paused && this.controls.last === \"touch\") this.touchAssist(dt);\n\t\t}\n\t\tthis.audio.zone = this.localPlayer() ? this.zone(this.localPlayer()) : 0;\n\t\tthis.audio.tick();\n\t\tthis.ui.update();\n\t}\n\tinputFor(p) {\n\t\tif (p.id === this.net.me && !this.net.server)\n\t\t} catch {}\n\t\tthis.saved = null;\n\t\tthis.ui.show(\"victory\", \"victory\");\n\t\tthis.net.finish(true);\n\t}\n\tsave() {\n\t\tif (this.net.hub || this.mode !== \"playing\" || this.state.won) return;\n\t\tconst record = { version: 1, snapshot: this.snapshot() };\n\t\ttry {\n\t\t\tlocalStorage.setItem(SAVE, JSON.stringify(record));\n\t\t\tthis.saved = record;\n\t\t} catch {}\n\t}\n\tsnapshot() {\n\t\tconst s = this.state;\n\t\treturn {\n\t\t\ttime: s.time,\n\t\t\tscore: s.score,\n\t\t\tfound: [...s.found],\n\t\t\tcrumbs: [...s.crumbs],\n\t\t\tflags: [...s.flags],\n\t\t\tvisited: [...s.visited],\n\t\t\tballoon: { ...s.balloon },\n\t\t\treturned: s.returned,\n\t\t\ttransit: s.transit,\n\t\t\twon: s.won,\n\t\t\tplayers: this.players.map((p) => ({\n\t\t\t\tid: p.id,\n\t\t\t\tx: p.x,\n\t\t\t\ty: p.y,\n\t\t\t\tvx: p.vx,\n            p = pos(page)\n            move(page, jump=True, frames=15)\n            check('Jump rises above the floor', pos(page)['y'] > p['y'] + 1, pos(page))\n            move(page, frames=100)\n            check('Gravity lands the explorer', pos(page)['grounded'], pos(page))\n            page.keyboard.press('Escape')\n            check('Keyboard pause opens field menu', page.evaluate('__game.menu') == 'pause')\n            before = state(page)['time']\n            move(page, frames=30)\n            check('Pause freezes standalone simulation', state(page)['time'] == before)\n            page.get_by_role('button', name='Developer field kit', exact=True).click()\n            check('Developer kit reachable from pause', page.evaluate('__game.menu') == 'dev')\n            page.locator('[data-setting=\"speed\"]').fill('9')\n            check('Balance slider applies live', page.evaluate('__game.balance.speed') == 9)\n            page.get_by_role('button', name='Reset balance & assists', exact=True).click()\n            check('Balance reset restores defaults', page.evaluate('__game.balance.speed') == 6.2)\n            page.keyboard.press('Escape')\n            page.keyboard.press('Escape')\n            page.evaluate('__game.start();__game.safe(true)')\n            page.evaluate('__game.teleport(62,-5)')\n            a = move(page, y=1, frames=40)['players'][0]\n            check('Buoyant swimming responds vertically', a['water'] and a['y'] > -3, a)\n            page.screenshot(path=str(ART / 'river.png'))\n            page.evaluate('__game.start();__game.teleport(38,0.9);__game.step(30)')\n            check('Checkpoint activates on contact', state(page)['flags'][1] and pos(page)['checkpoint'] == 1)\n            page.evaluate('__game.hurt();__game.step(2)')\n            check('Hazard recovery returns to last checkpoint', abs(pos(page)['x']-38) < 0.5 and pos(page)['invuln'] > 2)\n            route(page)\n            page.screenshot(path=str(ART / 'victory.png'))\n            audio = page.evaluate('__game.verifyAudio()')\n            check('Synthesized audio produces nonzero unclipped PCM', audio['supported'] and 0.001 < audio['rms'] < 0.2 and audio['peak'] < 1, audio)\n            page.evaluate('__game.raw.toTitle();__game.attract()')\n            check('Ten idle seconds starts attract replay', page.evaluate('__game.mode') == 'attract')\n            move(page, frames=3300)\n            check('Attract replay visits river and shrine', page.evaluate('__game.mode') == 'attract' and pos(page)['x'] > 120, pos(page))\n            page.keyboard.press('KeyA')\n            check('Any input exits attract without starting play', page.evaluate('__game.mode') == 'title')\n            extra_checks(page,context,(ROOT.parent / GAME).as_uri() + '?test=1')\n            check('No runtime JavaScript errors', not errors, errors)\n            visual = context.new_page()\n            boot(visual, (ROOT.parent / GAME).as_uri() + '?test=1&renderer=webgl')\n            visual.evaluate('__game.step(2)')\n            visual.wait_for_timeout(1500)\n            visual.screenshot(path=str(ART / 'title-visual.png'))\n            visual.evaluate('__game.start();__game.step(120)')\n            visual.wait_for_timeout(1000)\n            visual.screenshot(path=str(ART / 'camp-visual.png'))\n            visual.evaluate('__game.safe(true);__game.teleport(64,-4);__game.step(60)')\n            visual.wait_for_timeout(500)\n            visual.screenshot(path=str(ART/'river-visual.png'))\n            visual.evaluate('__game.teleport(145,25);__game.step(60)')\n            visual.wait_for_timeout(500)\n            visual.screenshot(path=str(ART/'shrine-visual.png'))\n            check('Fallback draws world geometry', visual.evaluate('__game.raw.renderer.info.render.drawCalls') > 0)\n            visual.close()\n            page.close()\n            touch_checks(pw,browser,base+'/'+GAME+'?test=1')\n            peer_checks(context,base+'/'+GAME+'?test=1')\n            hub_checks(context,base)\n            check('No runtime JavaScript errors across all contexts',not errors,errors)\n            context.close()\n            browser.close()\n    except Exception as exc:\n        check('Test runner completed', False, str(exc))\n    finally:\n        server.shutdown()\n        server.server_close()\n        (ART / 'results.json').write_text(json.dumps({'checks': checks, 'errors': errors}, indent=2))\n    failures = sum(not c['pass'] for c in checks)\n    print(f'{len(checks)} checks, {failures} failures', flush=True)\n    return failures\n\n\nif __name__ == '__main__':\n    raise SystemExit(bool(main()))\n","exit_code":0,"status":"completed"}}
