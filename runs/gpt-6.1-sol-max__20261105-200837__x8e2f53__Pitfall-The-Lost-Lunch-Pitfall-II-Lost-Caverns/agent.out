ef launch(pw):\n506:def hub_checks(pw, base):\n554:def main():\n671:            visual.evaluate(\"__game.step(2)\")\n674:            visual.evaluate(\"__game.start();__game.step(120)\")\n677:            visual.evaluate(\"__game.safe(true);__game.teleport(64,-4);__game.step(60)\")\n680:            visual.evaluate(\"__game.teleport(145,25);__game.step(60)\")\n685:                visual.evaluate(\"__game.raw.renderer.info.render.drawCalls\") > 0,\n712:    return failures\nimport { readFile, writeFile } from \"node:fs/promises\";\nimport { basename, dirname, resolve } from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { build } from \"esbuild\";\n\nconst dir = dirname(fileURLToPath(import.meta.url));\nconst report = JSON.parse(\n\tawait readFile(resolve(dir, \"../exit-interview.json\"), \"utf8\"),\n);\nconst exports = {\n\tSOURCE_INFO: report.sourceInformation,\n\tTESTING_FEEDBACK: report.testingFeedback,\n\tENGINE_FEEDBACK: report.engineFeedback,\n\tPROMPT_FEEDBACK: report.promptFeedback,\n};\nawait writeFile(\n\tresolve(dir, \"src/credits.js\"),\n\tObject.entries(exports)\n\t\t.map(([k, v]) => `export const ${k} = ${JSON.stringify(v)};`)\n\t\t.join(\"\\n\"),\n);\nconst result = await build({\n\tentryPoints: [resolve(dir, \"src/main.js\")],\n\tbundle: true,\n\tformat: \"iife\",\n\ttarget: \"es2022\",\n\tminify: true,\n\twrite: false,\n\tlegalComments: \"inline\",\n\tlogLevel: \"silent\",\n});\nconst code = result.outputFiles[0].text.replace(/<\\/script/gi, \"<\\\\/script\");\nconst session = await readFile(resolve(dir, \"hub/session.js\"), \"utf8\");\nconst template = await readFile(resolve(dir, \"template.html\"), \"utf8\");\nconst html = template\n\t.replace(\"<!--HUB_CLIENT-->\", () => `<script>\\n${session}\\n</script>`)\n\t.replace(\"<!--GAME_SCRIPT-->\", () => `<script>\\n${code}\\n</script>`);\nawait writeFile(resolve(dir, \"app.bundle.js\"), result.outputFiles[0].text);\nawait writeFile(resolve(dir, `../${basename(dir)}.html`), html);\nconsole.log(\n\t`Built ${basename(dir)}.html (${(Buffer.byteLength(html) / 1024 / 1024).toFixed(2)} MB, fully self-contained)`,\n);\n{\n  \"name\": \"pitfall-the-lost-lunch-pitfall-ii-lost-caverns-gpt-6.1-sol-max-20261105-200837\",\n  \"version\": \"1.0.0\",\n  \"description\": \"A complete single-file cavern exploration platform adventure.\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"build\": \"node build.mjs\",\n    \"test\": \"/home/micha/.local/share/pipx/venvs/playwright/bin/python test.py\"\n  },\n  \"keywords\": [],\n  \"type\": \"module\",\n  \"dependencies\": {\n    \"@dimforge/rapier3d-compat\": \"0.19.3\",\n    \"three\": \"0.180.0\"\n  },\n  \"devDependencies\": {\n    \"esbuild\": \"0.25.12\"\n  },\n  \"private\": true\n}\n","exit_code":0,"status":"completed"}}
