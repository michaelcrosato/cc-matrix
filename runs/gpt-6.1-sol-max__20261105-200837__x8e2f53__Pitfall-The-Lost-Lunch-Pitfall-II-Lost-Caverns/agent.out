{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,55p' src/network.js; sed -n '623,646p' src/main.js; sed -n '268,298p' src/network.js; sed -n '120,171p' src/main.js; sed -n '300,332p' test.py; sed -n '270,305p' test.py\"","aggregated_output":"export class ExpeditionNetwork {\n\tconstructor(game) {\n\t\tthis.g = game;\n\t\tthis.hub = false;\n\t\tthis.host = true;\n\t\tthis.me = 0;\n\t\tthis.server = false;\n\t\tthis.connected = false;\n\t\tthis.ended = false;\n\t\tthis.roster = [{ id: 0, name: \"Pip\", color: \"#e9bd78\" }];\n\t\tthis.inputs = new Map();\n\t\tthis.seq = 0;\n\t\tthis.clock = 0;\n\t\tthis.interact = false;\n\t\tthis.sent = 0;\n\t\tthis.received = 0;\n\t\tthis.finished = false;\n\t\tthis.lastHeard = 0;\n\t\taddEventListener(\"pagehide\", () => {\n\t\t\tif (!this.hub && this.channel?.readyState === \"open\")\n\t\t\t\tthis.channel.send(JSON.stringify({ k: \"bye\" }));\n\t\t});\n\t}\n\tasync init() {\n\t\tif (!window.AIHub?.active) return;\n\t\tconst info = await AIHub.connect({ mode: \"shared-world\", seats: [1, 4] });\n\t\tif (!info) return;\n\t\tthis.hub = true;\n\t\tthis.connected = true;\n\t\tthis.host = info.isHost;\n\t\tthis.me = info.me;\n\t\tthis.server = info.server;\n\t\tthis.roster = info.players;\n\t\tthis.hostId = info.host;\n\t\tAIHub.on(\"start\", () => {\n\t\t\tthis.g.hubStarted = true;\n\t\t});\n\t\tAIHub.on(\"message\", (data, from) => this.receive(data, from));\n\t\tAIHub.on(\"leave\", ({ id }) => {\n\t\t\tthis.roster = this.roster.filter((p) => p.id !== id);\n\t\t\tthis.g.removeExplorer(id);\n\t\t});\n\t\tAIHub.on(\"time-up\", () => this.finish(this.g.state?.won || false));\n\t\tAIHub.on(\"end\", () => {\n\t\t\tthis.ended = true;\n\t\t\tthis.g.mode = \"ended\";\n\t\t\tthis.g.audio.mute(true);\n\t\t\tthis.g.ui.show(\"ended\");\n\t\t});\n\t}\n\tready() {\n\t\tif (this.hub) AIHub.ready();\n\t}\n\tlabel() {\n\t\treturn this.hub\n\t}\n\tinputFor(p) {\n\t\tif (p.id === this.net.me && !this.net.server)\n\t\t\treturn this.ui.current\n\t\t\t\t? { x: 0, y: 0, jump: false }\n\t\t\t\t: this.controls.read(0);\n\t\tif (!this.net.hub && !this.net.channel)\n\t\t\treturn this.controls.read(p.id === this.net.me ? 0 : 1);\n\t\tconst input = this.net.inputs.get(p.id);\n\t\treturn input && performance.now() - input.at < 700\n\t\t\t? input\n\t\t\t: { x: 0, y: 0, jump: false };\n\t}\n\tsimulate(dt) {\n\t\tconst s = this.state;\n\t\tif (s.won) return;\n\t\ts.time += dt;\n\t\tthis.world.physics.gravity.y = -this.balance.gravity;\n\t\tthis.updateHazards();\n\t\tif (s.transit !== null) {\n\t\t\ts.transit += dt / 8;\n\t\t\tconst t = clamp(s.transit, 0, 1),\n\t\t\t\te = t * t * (3 - 2 * t);\n\t\t\tconst x = 160 - 153 * e,\n\t\t\t\tawait this.peer.setRemoteDescription(d);\n\t\t\t\tawait this.peer.setLocalDescription(await this.peer.createAnswer());\n\t\t\t\tawait this.gather();\n\t\t\t\tthis.output(this.encode(this.peer.localDescription));\n\t\t\t\tthis.status(\"Send this reply to the host. Keep this page open.\");\n\t\t\t} else {\n\t\t\t\tif (!this.peer || !this.host)\n\t\t\t\t\tthrow new Error(\"Create an invitation on this device first.\");\n\t\t\t\tawait this.peer.setRemoteDescription(d);\n\t\t\t\tthis.status(\"Reply accepted. Connecting…\");\n\t\t\t}\n\t\t} catch (e) {\n\t\t\tthis.status(e.message || \"Connection code is not valid.\");\n\t\t}\n\t}\n\tstatus(text) {\n\t\tconst el = document.querySelector(\"#link-status\");\n\t\tif (el) el.textContent = text;\n\t}\n\toutput(text) {\n\t\tconst el = document.querySelector(\"#signal-out\");\n\t\tif (el) el.value = text;\n\t}\n\tclose() {\n\t\tthis.connected = false;\n\t\tif (this.channel) this.channel.close();\n\t\tif (this.peer) this.peer.close();\n\t\tthis.peer = null;\n\t\tthis.channel = null;\n\t\tthis.host = true;\n\t\tthis.me = 0;\n\t\t\tthis.sun.shadow.bias = -0.0006;\n\t\t\tthis.sun.shadow.normalBias = 0.045;\n\t\t\tthis.scene.add(this.sun, this.sun.target);\n\t\t\tconst rim = new T.DirectionalLight(0x7ed7ca, 1);\n\t\t\trim.position.set(15, 5, -4);\n\t\t\tthis.scene.add(rim);\n\t\t\taddEventListener(\"resize\", () => this.resize());\n\t\t\tthis.resize();\n\t\t\tthis.installWorldPointer();\n\t\t} else this.backend = \"server simulation\";\n\t\tthis.setupExplorers(this.net.roster);\n\t\tthis.updateHazards();\n\t\tif (this.net.hub) {\n\t\t\tthis.mode = \"waiting\";\n\t\t\tthis.ui.show(\"waiting\");\n\t\t} else this.toTitle();\n\t\tthis.installDebug();\n\t\tdocument.querySelector(\"#loading\").classList.add(\"hidden\");\n\t\tthis.ready = true;\n\t\tthis.net.ready();\n\t\tlet previous = performance.now();\n\t\tthis.frame = (now) => {\n\t\t\tconst dt = Math.min((now - previous) / 1000, 0.06);\n\t\t\tprevious = now;\n\t\t\tthis.controls.poll();\n\t\t\tif (this.testAuto || this.net.hub) this.tick(dt);\n\t\t\tthis.draw(Math.min(dt, 1 / 30));\n\t\t\tthis.raf = requestAnimationFrame(this.frame);\n\t\t};\n\t\tthis.raf = requestAnimationFrame(this.frame);\n\t}\n\tsetupExplorers(roster) {\n\t\tfor (const p of this.players) this.world.removePlayer(p);\n\t\tthis.players = [];\n\t\tfor (const seat of roster) {\n\t\t\tconst p = this.world.createPlayer(\n\t\t\t\tseat.id,\n\t\t\t\tnew T.Color(seat.color || \"#e9bd78\").getHex(),\n\t\t\t);\n\t\t\tthis.players.push(p);\n\t\t\tif (roster.length > 1)\n\t\t\t\tthis.world.label(seat.name, 0, 1.65, 0.3, \"#f2dfaa\", p.model.root);\n\t\t}\n\t}\n\tremoveExplorer(id) {\n\t\tconst p = this.players.find((p) => p.id === id);\n\t\tif (p) {\n\t\t\tthis.world.removePlayer(p);\n\t\t\tthis.players = this.players.filter((p) => p.id !== id);\n\t\t}\n\t\tthis.net.inputs.delete(id);\n\t}\n        for result in report['checks']:\n            check('Hub '+name+': '+result['name'],result['pass'],result.get('detail',''))\n        check('Hub '+name+': automatic conformance passes',report['pass'],[c for c in report['checks'] if not c['pass']])\n        for frame in page.frames[1:]:\n            if frame.evaluate('!!window.__game?.ready'):\n                check('Hub '+name+': ended game audio is muted',frame.evaluate('__game.network.ended && !__game.audio.enabled'))\n        page.close()\n\n\ndef main():\n    handler = functools.partial(QuietHandler, directory=str(ROOT.parent))\n    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\n    threading.Thread(target=server.serve_forever, daemon=True).start()\n    base = f'http://127.0.0.1:{server.server_port}'\n    try:\n        with sync_playwright() as pw:\n            browser = pw.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader', '--disable-dev-shm-usage'])\n            context = browser.new_context(viewport={'width': 1920, 'height': 1080}, device_scale_factor=1)\n            page = context.new_page()\n            boot(page, (ROOT.parent / GAME).as_uri() + '?test=1')\n            check('Single file boots through file://', page.evaluate('__game.mode') == 'title')\n            check('Renderer uses WebGPU', page.evaluate('__game.backend') == 'WebGPU', page.evaluate('__game.backend'))\n            check('Music defaults to ten percent', page.evaluate('__game.settings.music') == 0.1)\n            page.screenshot(path=str(ART / 'title.png'))\n            page.evaluate('__game.start()')\n            move(page, frames=100)\n            p = pos(page)\n            check('Rapier capsule rests on terrain', abs(p['y'] - 0.69) < 0.12, p)\n            move(page, x=1, frames=30)\n            check('Movement advances through physical world', pos(page)['x'] > p['x'] + 2, pos(page))\n            p = pos(page)\n            move(page, jump=True, frames=15)\n            check('Jump rises above the floor', pos(page)['y'] > p['y'] + 1, pos(page))\n    host.evaluate('__game.teleport(150,25,0);__game.action(\"interact\");__game.step(12);__game.teleport(159.5,24.9,0);__game.action(\"interact\");__game.step(24)')\n    guest.wait_for_timeout(100)\n    guest.evaluate('__game.step(3)')\n    check('Co-op return ride begins on both devices', state(host)['transit'] is not None and state(guest)['transit'] is not None)\n    cart=guest.evaluate('({x:__game.raw.world.trolley.position.x,p:__game.state.players[0].x})')\n    check('Remote trolley follows the shared return ride', abs(cart['x']-cart['p'])<2,cart)\n    host.evaluate('__game.step(500)')\n    guest.wait_for_timeout(200)\n    guest.evaluate('__game.step(2)')\n    check('Co-op return brings every explorer to camp', state(guest)['returned'] and all(p['x']<10 for p in state(guest)['players']))\n    host.evaluate('__game.action(\"interact\");__game.step(12)')\n    guest.wait_for_timeout(100)\n    check('Co-op victory is shared across devices', state(host)['won'] and state(guest)['won'], [state(host)['found'],state(guest)['found']])\n    host.evaluate('__game.autoplay(true)')\n    guest.close()\n    host.wait_for_function('!__game.network.connected',timeout=12000)\n    check('Peer disconnect clears remote seat and retains authority', not host.evaluate('__game.network.connected') and host.evaluate('__game.network.host') and len(state(host)['players'])==1, host.evaluate('__game.network'))\n    host.close()\n\n\ndef hub_checks(context, base):\n    from urllib.parse import urlencode\n    scenarios=[('standard',2,{}),('stressed',4,{'latency':150,'jitter':50,'loss':5}),('host-leave',4,{'scenario':'host-leave','latency':150,'jitter':50,'loss':5}),('server',2,{'scenario':'server'})]\n    for name,players,extra in scenarios:\n        page=context.new_page()\n        params={'game':'../../'+GAME,'players':players,'auto':1,**extra}\n        page.goto(base+'/'+ROOT.name+'/hub/harness.html?'+urlencode(params),wait_until='load',timeout=120000)\n        page.wait_for_function('window.__hubCheck?.done',timeout=120000)\n        report=page.evaluate('__hubCheck')\n        (ART/f'hub-{name}.json').write_text(json.dumps(report,indent=2))\n        for result in report['checks']:\n            check('Hub '+name+': '+result['name'],result['pass'],result.get('detail',''))\n        check('Hub '+name+': automatic conformance passes',report['pass'],[c for c in report['checks'] if not c['pass']])\n        for frame in page.frames[1:]:\n            if frame.evaluate('!!window.__game?.ready'):\n                check('Hub '+name+': ended game audio is muted',frame.evaluate('__game.network.ended && !__game.audio.enabled'))\n","exit_code":0,"status":"completed"}}
