e\": \"Route: upper shelf crumb collected\",\n      \"pass\": false,\n      \"detail\": \"{'id': 0, 'x': 82.73104858398438, 'y': -2.0113534927368164, 'vx': -1.1294787327642553e-10, 'vy': 0, 'facing': 1, 'grounded': True, 'water': False, 'climbing': False, 'balloon': False, 'invuln': 0, 'checkpoint': 0, 'mode': 'run', 'hits': 33}\"\n    },\n    {\n      \"name\": \"Route: second ladder climbed\",\n      \"pass\": false,\n      \"detail\": \"{'id': 0, 'x': 82.73104858398438, 'y': -2.0113534927368164, 'vx': -1.5688783605583012e-10, 'vy': 0, 'facing': 1, 'grounded': True, 'water': False, 'climbing': False, 'balloon': False, 'invuln': 0, 'checkpoint': 0, 'mode': 'run', 'hits': 33}\"\n    },\n    {\n      \"name\": \"Route: balloon boarded\",\n      \"pass\": false,\n      \"detail\": \"{'id': 0, 'x': 82.73104858398438, 'y': -2.0113534927368164, 'vx': -1.1294787327642553e-10, 'vy': 0, 'facing': 1, 'grounded': True, 'water': False, 'climbing': False, 'balloon': False, 'invuln': 0, 'checkpoint': 0, 'mode': 'run', 'hits': 33}\"\n    },\n    {\n      \"name\": \"Route: updraft reaches shrine height\",\n      \"pass\": false,\n      \"detail\": \"{'id': 0, 'x': 82.73104858398438, 'y': -2.0113534927368164, 'vx': -2.2936319510336034e-10, 'vy': 0, 'facing': 1, 'grounded': True, 'water': False, 'climbing': False, 'balloon': False, 'invuln': 0, 'checkpoint': 0, 'mode': 'run', 'hits': 33}\"\n    },\n    {\n      \"name\": \"Route: balloon dismounted onto shrine\",\n      \"pass\": false,\n      \"detail\": \"{'id': 0, 'x': 82.73104858398438, 'y': -2.0113534927368164, 'vx': -2.2936319510336034e-10, 'vy': 0, 'facing': 1, 'grounded': True, 'water': False, 'climbing': False, 'balloon': False, 'invuln': 0, 'checkpoint': 0, 'mode': 'run', 'hits': 33}\"\n    },\n    {\n      \"name\": \"Route: lunchbox recovered\",\n      \"pass\": false,\n      \"detail\": \"{'id': 0, 'x': 82.73104858398438, 'y': -2.0113534927368164, 'vx': -1.1294787327642553e-10, 'vy': 0, 'facing': 1, 'grounded': True, '