{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/net.js\"","aggregated_output":"// Pier Pressure networking: AI Hub Session Protocol v1, plus standalone peer co-op.\n// The unmodified hub-session.js must be the first script in the delivered HTML.\nconst NET_VERSION = 'pier-pressure-1';\nconst noop = () => {};\nconst emptyInput = () => ({ aim: 0, fire: false, burst: false });\n\nexport class Network {\n  constructor(callbacks = {}) {\n    this.callbacks = callbacks;\n    this.active = !!globalThis.AIHub?.active;\n    this.connected = false;\n    this.ended = false;\n    this.started = false;\n    this.reported = false;\n    this.role = 'host';\n    this.me = 0;\n    this.server = false;\n    this.players = [{ id: 0, name: 'Port gunner', color: '#f4b34e' }];\n    this._seatIds = [0];\n    this._elapsed = 0;\n    this._sendAt = 0;\n    this._sequence = 0;\n    this._lastState = -1;\n    this._lastInput = new Map();\n    this._unsub = [];\n    this._nonce = globalThis.crypto?.randomUUID?.() || String(Math.random());\n    this.stats = { sent: 0, received: 0, rejected: 0, bytes: 0 };\n    this.lastScore = 0;\n  }\n\n  get isHost() { return this.role === 'host'; }\n  get isGuest() { return this.role === 'guest'; }\n  get online() { return this.active || this.connected; }\n  get localSeat() { return this.server ? -1 : Math.max(0, this._seatIds.indexOf(this.me)); }\n  get running() {\n    if (this.ended) return false;\n    return this.active ? this.started && AIHub.time() >= 0 : true;\n  }\n  get countdown() { return this.active ? Math.max(0, -AIHub.time() / 1000) : 0; }\n\n  _call(name, ...args) { (this.callbacks[name] || noop)(...args); }\n  _status(text) { this._call('onStatus', text); }\n\n  async init() {\n    if (!this.active) return null;\n    const info = await AIHub.connect({ mode: 'shared-world', seats: [1, 2] });\n    if (!info) { this.active = false; return null; }\n    this.role = info.isHost ? 'host' : 'guest';\n    this.me = info.me;\n    this.server = !!info.server;\n    this.players = info.players.slice();\n    this._seatIds = info.players.map(p => p.id);\n    this.connected = true;\n    this._unsub.push(\n      AIHub.on('start', info => {\n        this.started = true;\n        this._sendAt = 0;\n        this._call('onStart', info);\n      }),\n      AIHub.on('message', (data, from) => this._receive(data, from)),\n      AIHub.on('leave', ({ id, reason }) => {\n        const seat = this._seatIds.indexOf(id);\n        this.players = this.players.filter(p => p.id !== id);\n        if (seat >= 0 && this.isHost) this._call('onInput', emptyInput(), seat);\n        this._call('onLeave', id, reason);\n        this._status('A gunner left. The coastal watch continues.');\n      }),\n      AIHub.on('time-up', info => {\n        if (this.ended) return;\n        this._call('onTimeUp', info);\n        // The game normally reports immediately. This fallback also honors short rounds.\n        if (this.isHost && !this.reported) this.finish(this.lastScore, false);\n      }),\n      AIHub.on('end', info => {\n        this.ended = true;\n        this.connected = false;\n        this._call('onEnd', info.reason, info);\n      })\n    );\n    this._status(this.server ? 'AI Hub · coastal command' : `AI Hub · gunner ${this.localSeat + 1}`);\n    return info;\n  }\n\n  ready() { if (this.active && !this.ended) AIHub.ready(); }\n\n  // dt is seconds. The host supplies its compact JSON snapshot, guests their current input.\n  // Ten packets/sec in each direction stays within the Hub's 20/sec allowance.\n  tick(dt, input, snapshot) {\n    this._elapsed += Math.max(0, Number(dt) || 0);\n    if (this.ended || !this.online || !this.running || this._elapsed < this._sendAt) return;\n    this._sendAt = this._elapsed + 0.1;\n    if (this.isHost && snapshot != null) {\n      this._send({ protocol: NET_VERSION, kind: 'state', seq: ++this._sequence, state: snapshot });\n    } else if (this.isGuest) {\n      this._send({ protocol: NET_VERSION, kind: 'input', seq: ++this._sequence, input: input || emptyInput() });\n    }\n  }\n\n  _send(data) {\n    if (this.ended) return false;\n    let encoded;\n    try { encoded = JSON.stringify(data); } catch { return false; }\n    if (encoded.length > 16000) { this.stats.rejected++; return false; }\n    let sent = false;\n    if (this.active) sent = AIHub.send(data, this.isHost ? { reliable: true } : { to: AIHub.host, reliable: false });\n    else if (this._data?.readyState === 'open') {\n      if (this._data.bufferedAmount > 65536) return false;\n      this._data.send(encoded); sent = true;\n    } else if (this._broadcast && this.connected && this._remote) {\n      this._broadcast.postMessage({ protocol: NET_VERSION, from: this._nonce, to: this._remote, kind: 'packet', data });\n      sent = true;\n    }\n    if (sent) { this.stats.sent++; this.stats.bytes += encoded.length; }\n    return sent;\n  }\n\n  _receive(data, from) {\n    if (this.ended || !data || data.protocol !== NET_VERSION) return;\n    this.stats.received++;\n    if (data.kind === 'input' && this.isHost) {\n      const seat = this.active ? this._seatIds.indexOf(from) : 1;\n      if (seat < 0 || seat > 1 || !Number.isFinite(data.seq)) return;\n      if (data.seq <= (this._lastInput.get(from) ?? -1)) return;\n      this._lastInput.set(from, data.seq);\n      const source = data.input || {};\n      // Only ordinary input crosses the boundary: no guest world state or score.\n      const clean = { ...source };\n      for (const k of ['aim', 'angle', 'x', 'y', 'power']) {\n        if (k in clean) clean[k] = Math.max(-10000, Math.min(10000, Number(clean[k]) || 0));\n      }\n      this._call('onInput', clean, seat);\n    } else if (data.kind === 'state' && this.isGuest) {\n      if (this.active && from !== AIHub.host) return;\n      if (!Number.isFinite(data.seq) || data.seq <= this._lastState) return;\n      this._lastState = data.seq;\n      this._call('onState', data.state);\n    } else if (data.kind === 'end' && this.isGuest) {\n      this._call('onResult', data.score, !!data.won, data.stats || {});\n    }\n  }\n\n  finish(score = 0, won = false, stats = {}) {\n    if (!this.isHost || this.reported || this.ended) return;\n    this.reported = true;\n    this.lastScore = Number.isFinite(Number(score)) ? Number(score) : 0;\n    if (this.active) {\n      const ids = this.players.map(p => p.id);\n      const scores = Object.fromEntries(ids.map(id => [id, this.lastScore]));\n      const playerStats = Object.fromEntries(ids.map(id => [id, stats]));\n      AIHub.finish({ standings: [ids], scores, won: !!won, stats: playerStats });\n    } else if (this.connected) {\n      this._send({ protocol: NET_VERSION, kind: 'end', score: this.lastScore, won: !!won, stats });\n    }\n  }\n\n  fail(message) {\n    if (this.active && !this.ended) AIHub.fail(String(message));\n    this._status(String(message));\n  }\n\n  _standalone(role) {\n    if (this.active) throw new Error('AI Hub manages this session.');\n    this.leave();\n    this.role = role;\n    this.me = role === 'host' ? 0 : 1;\n    this.ended = false;\n    this.reported = false;\n    this.started = true;\n    this._seatIds = [0, 1];\n    this.players = [\n      { id: 0, name: 'Port gunner', color: '#f4b34e' },\n      { id: 1, name: 'Starboard gunner', color: '#67dac6' }\n    ];\n  }\n\n  _connected() {\n    this.connected = true;\n    this._status('Two gunners connected. All hands on deck!');\n    this._call('onConnect', this.role);\n  }\n\n  // A six-letter same-browser room; handy for two windows on one computer.\n  // For different devices use the offer/answer functions below.\n  hostLocal(code) {\n    this._standalone('host');\n    this._room = String(code || Array.from(crypto.getRandomValues(new Uint8Array(6)), x => 'ABCDEFGHJKLMNPQRSTUVWXYZ'[x % 24]).join('')).toUpperCase();\n    this._openBroadcast();\n    this._status(`Local window room ${this._room} · waiting for a second window`);\n    return this._room;\n  }\n\n  joinLocal(code) {\n    code = String(code || '').trim().toUpperCase();\n    if (!/^[A-Z0-9-]{3,24}$/.test(code)) throw new Error('Enter the room code shown by the host.');\n    this._standalone('guest');\n    this._room = code;\n    this._openBroadcast();\n    const hello = () => this._broadcast?.postMessage({ protocol: NET_VERSION, from: this._nonce, kind: 'hello' });\n    hello();\n    this._helloTimer = setInterval(() => { if (!this.connected) hello(); }, 500);\n    this._status(`Calling local room ${code}…`);\n  }\n\n  _openBroadcast() {\n    if (!globalThis.BroadcastChannel) throw new Error('This browser does not support local window rooms. Use direct connection.');\n    this._broadcast = new BroadcastChannel(`${NET_VERSION}:${this._room}`);\n    this._broadcast.onmessage = ({ data }) => {\n      if (!data || data.protocol !== NET_VERSION || data.from === this._nonce || (data.to && data.to !== this._nonce)) return;\n      if (data.kind === 'hello' && this.isHost && (!this._remote || this._remote === data.from)) {\n        this._remote = data.from;\n        this._broadcast.postMessage({ protocol: NET_VERSION, from: this._nonce, to: data.from, kind: 'welcome' });\n        if (!this.connected) this._connected();\n      } else if (data.kind === 'welcome' && this.isGuest && !this.connected) {\n        this._remote = data.from;\n        clearInterval(this._helloTimer);\n        this._connected();\n      } else if (data.kind === 'packet' && data.from === this._remote) {\n        this._receive(data.data, this.isHost ? 1 : 0);\n      } else if (data.kind === 'bye' && data.from === this._remote) this._disconnected();\n    };\n  }\n\n  // Manual WebRTC signaling avoids accounts and a signaling server. STUN discovers\n  // addresses; some restrictive networks require a relay unavailable to this file.\n  _makePeer() {\n    if (!globalThis.RTCPeerConnection) throw new Error('Direct connections require a browser with WebRTC.');\n    this._peer = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });\n    this._peer.ondatachannel = e => this._wireData(e.channel);\n    this._peer.onconnectionstatechange = () => {\n      if (['failed', 'disconnected', 'closed'].includes(this._peer?.connectionState)) this._disconnected();\n    };\n  }\n\n  _wireData(channel) {\n    this._data = channel;\n    channel.onopen = () => this._connected();\n    channel.onclose = () => this._disconnected();\n    channel.onmessage = ({ data }) => {\n      if (typeof data !== 'string' || data.length > 16000) return;\n      try { this._receive(JSON.parse(data), this.isHost ? 1 : 0); } catch { this.stats.rejected++; }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/main.js <<'EOF'\nimport RAPIER from 'rapier';\nimport {Coast} from './scene.js';\nimport {Sound} from './audio.js';\nimport {Network} from './net.js';\n\nconst \"'$=id=>document.getElementById(id), clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst defaults={speed:29,gravity:13,cooldown:.3,enemySpeed:1,spawn:1.45,damage:1,wind:1,assist:.35};\nlet tuning={...defaults}, prefs={music:.1,sfx:.65,glyph:'\"'ps',shake:true,assist:true};\ntry{Object.assign(prefs,JSON.parse(localStorage.getItem('pier-pressure-prefs')||'{}'));}catch{}\nconst sound=new Sound();sound.setMusic(prefs.music);sound.setSfx(prefs.sfx);\nlet coast,world,events,screen='loading',previous='title',mode='solo',inputMode='keyboard',lastActivity=performance.now(),idle=0,ready=false,autoplay=false;\nlet simTime=0,physicsSteps=0,spawnClock=0,supplyClock=0,nextId=1,shake=0,toastTime=0,bannerTime=0,demoTime=0;\nlet entities=new Map(),handles=new Map(),remoteViews=new Map(),inputs=[{angle:1.1,fire:false,salvo:false},{angle:2.04,fire:false,salvo:false}],remoteInputs=[{},{}];\nlet G={},keys=new Set(),pointerDown=false,mousePoint=null,padPrevious=[],navAt=0,navIndex=0,manualInput=null,touchOrigin=null,touchAim=null,touchActive=false,guestLastShot=0;\nconst stageNames=['SKY PATROL','CONVOY CROSSING','THE ADMIRAL'];\nconst stageOrders=['Lead the aircraft. Shoot down red bombs.','Rough water. Low angles. Watch the wind.','Sink the flagship. Keep the pier standing.'];\nconst net=new Network({\n onInput:(input,seat)=>{remoteInputs[seat]={...input,fire:\"'!!input.fire,salvo:!!input.salvo};},\n onState:s=>applySnapshot(s),onStatus:t=>{$('\"'networkStatus').textContent=t;},\n onConnect:()=>{start('online');toast('SECOND GUNNER ABOARD');},\n onDisconnect:()=>{if(screen==='playing'){mode='solo';inputs[1].fire=false;remoteInputs[1]={};toast('SECOND GUNNER LEFT · KEEP FIRING');}},\n onStart:()=>start('online'),onTimeUp:()=>{if(net.isHost)finish(G.health>0,'WATCH COMPLETE');},\n onEnd:reason=>{if(screen\"'!=='\"'results')finish(false,reason==='host-left'?'COMMAND DISCONNECTED':'WATCH ENDED',true);},\n onResult:(score,won,stats)=>{G.score=score;Object.assign(G,stats);finish(won,won?'HARBOR SECURED':'WATCH ENDED',true);},\n onLeave:()=>{remoteInputs[1]={};toast('A GUNNER LEFT THE WATCH');}\n});\nfunction save(){try{localStorage.setItem('pier-pressure-prefs',JSON.stringify(prefs));}catch{}}\nfunction touchOrPad(){document.body.classList.toggle('touch',inputMode==='touch');}\nfunction setInputMode(v){if(inputMode\"'!==v){inputMode=v;touchOrPad();updatePrompts();}}\nfunction activity(type){lastActivity=performance.now();idle=0;if(type)setInputMode(type);if(mode==='\"'demo'){title();return true;}return false;}\nfunction updatePrompts(){const pad=inputMode==='gamepad',xbox=prefs.glyph==='xbox';for(const e of document.querySelectorAll('[data-prompt]')){const p=e.dataset.prompt;e.textContent=pad?({fire:'R2',salvo:xbox?'X':'□',confirm:xbox?'A':'✕',back:xbox?'B':'○',pause:'☰',aim:'L'}[p]):({fire:'HOLD CLICK / SPACE',salvo:'E',confirm:'ENTER',back:'ESC',pause:'ESC',aim:'MOUSE / A D'}[p]);} \"'$('\"'controlLine').innerHTML=pad?\"'`<b>L</b> aim <b>R2 / ${xbox?'\"'A':'✕'}</b> fire <b>\"'${xbox?'\"'X':'□'}</b> salvo <b>☰</b> pause\"'`:'\"'<b>MOUSE</b> aim <b>HOLD CLICK / SPACE</b> fire <b>E</b> salvo <b>ESC</b> pause';}\nfunction setScreen(s){screen=s;\"'$('\"'screen').dataset.screen=s;document.body.dataset.screen=s;for(const el of document.querySelectorAll('.panel'))el.hidden=el.dataset.panel\"'!==s;$('\"'hud').hidden=\"'!['\"'playing','pause','dev'].includes(s);\"'$('\"'pause').hidden=s\"'!=='\"'playing';\"'$('\"'attract').hidden=mode\"'!=='\"'demo';\"'$('\"'salvoTouch').hidden=inputMode\"'!=='\"'touch'||s\"'!=='\"'playing';navIndex=0;requestAnimationFrame(()=>{const b=focusables()[0];if(b&&inputMode==='gamepad')b.focus({preventScroll:true});});}\nfunction toast(text){\"'$('\"'toast').textContent=text;toastTime=2.8;\"'$('\"'toast').classList.add('show');}\nfunction banner(kicker,title,sub){\"'$('\"'bannerKicker').textContent=kicker;\"'$('\"'bannerTitle').textContent=title;\"'$('\"'bannerSub').textContent=sub;bannerTime=3.2;\"'$('\"'banner').classList.add('show');sound.voice(G.wave||0);}\nfunction title(){clearWorld();mode='solo';autoplay=false;setScreen('title');idle=0;pointerDown=false;touchActive=false;inputs.forEach(i=>i.fire=false);sound.mute(false);createTableau();}\nfunction clearWorld(){for(const e of [...entities.values()])remove(e);for(const r of remoteViews.values())coast?.remove(r);remoteViews.clear();}\nfunction createTableau(){if(\"'!coast)return;const a=spawn('\"'plane',1,24);a.x=9;a.y=16;a.baseY=16;a.root.position.set(9,16,0);a.body.setTranslation({x:9,y:16,z:0},true);const b=spawn('boat',-1);b.x=16;b.y=3.5;b.baseY=3.5;b.root.position.set(16,3.5,0);b.body.setTranslation({x:16,y:3.5,z:0},true);const h=spawn('heli',-1);h.x=23;h.y=10;h.baseY=10;h.root.position.set(23,10,0);h.body.setTranslation({x:23,y:10,z:0},true);}\nfunction resetPhysics(){clearWorld();if(world)world.free();if(events)events.free();world=new RAPIER.World({x:0,y:-tuning.gravity,z:0});world.timestep=1/60;events=new RAPIER.EventQueue(true);handles.clear();}\nfunction start(which='solo'){\n mode=which;autoplay=which==='demo';resetPhysics();simTime=0;spawnClock=.45;supplyClock=8;demoTime=0;remoteInputs=[{},{}];manualInput=null;\n G={wave:0,score:0,health:7,maxHealth:7,energy:[100,100],cooldowns:[0,0],kills:0,waveKills:0,shotsFired:0,hits:0,combo:0,comboTimer:0,bestCombo:0,bossHP:24,bossMax:24,won:false,time:0,salvos:0,rescues:0};\n inputs=[{angle:1.1,fire:false,salvo:false},{angle:2.04,fire:false,salvo:false}];pointerDown=false;touchActive=false;keys.clear();net.reported=false;sound.mute(false);setScreen('playing');banner(which==='demo'?'AUTOMATIC DEMONSTRATION':'OPERATION 01',stageNames[0],stageOrders[0]);updateHUD();\n coast.guns[1].root.visible=which\"'!=='\"'solo'&&which\"'!=='\"'demo';\n}\nfunction nextWave(){G.wave++;G.waveKills=0;G.health=Math.min(G.maxHealth,G.health+2);G.energy=G.energy.map(v=>Math.max(v,65));clearWorld();spawnClock=1;banner('OPERATION 0'+(G.wave+1),stageNames[G.wave],stageOrders[G.wave]);if(G.wave===2)spawn('boss',1);sound.fanfare();}\nfunction finish(won,reason=won?'HARBOR SECURED':'PIER OVERRUN',fromNet=false){\n if(screen==='results')return;G.won=won;inputs.forEach(i=>i.fire=false);pointerDown=false;touchActive=false;\n if(mode==='demo'){start('demo');return;}\n \"'$('\"'resultKicker').textContent=won?'MISSION COMPLETE':'END OF WATCH';\"'$('\"'resultTitle').textContent=reason;\n const acc=G.shotsFired?Math.round(G.hits/G.shotsFired*100):0;\n let medal=won?(G.health>=5?'GOLD ANCHOR':G.health>=3?'SILVER ANCHOR':'BRONZE ANCHOR'):'BACK TO THE BATTERY';\n \"'$('\"'medal').textContent=medal;\"'$('\"'finalScore').textContent=String(G.score||0).padStart(6,'0');\"'$('\"'resultStats').innerHTML=\"'`<span><b>${G.kills||0}</b> TARGETS</span><span><b>${acc}%</b> ACCURACY</span><span><b>${G.bestCombo||0}×</b> BEST CHAIN</span>`;\n try{const old=Number(localStorage.getItem('\"'pier-pressure-best')||0);if(G.score>old)localStorage.setItem('pier-pressure-best',G.score);\"'$('\"'best').textContent=String(Math.max(old,G.score||0)).padStart(6,'0');}catch{}\n setScreen('results');if(won)sound.fanfare();else sound.hurt();\n if(\"'!fromNet&&net.isHost&&mode==='\"'online')net.finish(G.score,won,{kills:G.kills,shotsFired:G.shotsFired,hits:G.hits,bestCombo:G.bestCombo,health:G.health});\n}\nfunction spawn(type,side=Math.random()<.5?1:-1,y){\n const id=nextId++,x=side>0?-29:29,baseY=y??(type==='boat'?2.8:type==='boss'?3.2:type==='supply'?24:11+Math.random()*11);\n const root=coast.makeTarget(type,side);root.position.set(x,baseY,0);\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x,baseY,0));\n const dims=type==='boss'?[5.4,2.4,1.7]:type==='boat'?[2.2,1.4,1.5]:type==='bomb'?[.38,.55,.4]:type==='supply'?[1.05,1.5,1.1]:type==='heli'?[1.8,1.05,1.6]:[1.7,.65,1.8];\n const col=world.createCollider(RAPIER.ColliderDesc.cuboid(...dims).setTranslation(0,type==='boss'?1.5:type==='boat'?.45:0,0).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);\n let speed=(type==='boat'?2.5:type==='heli'?3.4:type==='boss'?0:type==='supply'?0:5.1+Math.random()*2)*side;\n const e={id,type,x,y:baseY,baseY,vx:speed,vy:0,side,root,body,col,alive:true,hp:type==='boss'?24:type==='heli'||type==='boat'?2:1,age:0,drop:2.1+Math.random()*2,flash:0};\n if(type==='boss'){e.x=0;root.position.x=0;body.setTranslation({x:0,y:baseY,z:0},true);}\n if(type==='supply'){e.x=(Math.random()-.5)*32;root.position.x=e.x;body.setTranslation({x:e.x,y:baseY,z:0},true);}\n entities.set(id,e);handles.set(col.handle,e);return e;\n}\nfunction remove(e){if(\"'!e||!entities.has(e.id))return;e.alive=false;handles.delete(e.col.handle);if(world.getRigidBody(e.body.handle))world.removeRigidBody(e.body);coast.remove(e.root);entities.delete(e.id);}\nfunction shoot(seat=0,angle=inputs[seat].angle,special=false){\n if(G.cooldowns[seat]>0&&!special)return false;\n const gun=coast.guns[seat],x=gun.x+Math.cos(angle)*2.65,y=3.2+Math.sin(angle)*2.65;\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,y,0).setLinvel(Math.cos(angle)*tuning.speed,Math.sin(angle)*tuning.speed,0).enabledTranslations(true,true,false).enabledRotations(false,false,false).setCcdEnabled(true));\n const col=world.createCollider(RAPIER.ColliderDesc.ball(.25+tuning.assist*.23).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);\n const e={id:nextId++,type:'\"'shot',seat,body,col,root:coast.projectile(x,y,special),x,y,age:0,alive:true,special};entities.set(e.id,e);handles.set(col.handle,e);\n G.shotsFired++;G.cooldowns[seat]=tuning.cooldown;gun.action.reset().play();coast.burst(x,y,'#ffdb79',.18);sound.shot();return true;\n}\nfunction salvo(seat){if(G.energy[seat]<99.8)return;G.energy[seat]=0;G.salvos++;sound.voice(2);shake=prefs.shake?.25:0;\n const a=inputs[seat].angle;for(let i=-3;i<=3;i++)shoot(seat,clamp(a+i*.115,.13,Math.PI-.13),true);\n for(const e of [...entities.values()]){if(e.type==='bomb')damage(e,2);}\n toast('BROADSIDE\"'!'\"');\n}\nfunction damage(e,amount=1){if(\"'!e?.alive||e.type==='\"'shot')return;\n if(e.type==='supply'){G.energy=G.energy.map(v=>Math.min(100,v+40));G.health=Math.min(G.maxHealth,G.health+1);G.rescues++;G.score+=250;coast.burst(e.x,e.y,'#a4e8c4',1.4);sound.hit('supply');toast('SUPPLY +1 HULL · +40 SALVO');remove(e);return;}\n e.hp-=amount;G.hits++;e.flash=.16;e.root.scale.setScalar(1.08);if(e.type==='boss')G.bossHP=Math.max(0,e.hp);\n coast.burst(e.x,e.y+ (e.type==='boss'?1:0),e.type==='bomb'?'#f5d077':'#ef8b50',e.hp>0?.45:1);sound.hit(e.type);\n if(e.hp>0)return;\n const values={plane:100,scout:100,heli:175,boat:200,bomb:75,boss:2500};\n G.combo=G.comboTimer>0?G.combo+1:1;G.comboTimer=3.5;G.bestCombo=Math.max(G.bestCombo,G.combo);const mult=Math.min(5,1+Math.floor(G.combo/4));G.score+=(values[e.type]||100)*mult;\n G.energy=G.energy.map(v=>Math.min(100,v+7));if(e.type\"'!=='\"'bomb'){G.kills++;G.waveKills++;}\n if(e.type==='boss'){remove(e);finish(true);return;}\n remove(e);if(G.wave===0&&G.waveKills>=8)nextWave();else if(G.wave===1&&G.waveKills>=10)nextWave();\n}\nfunction hurt(){if(autoplay||mode==='demo'||tuning.damage===0)return;G.health-=tuning.damage;G.combo=0;G.comboTimer=0;shake=prefs.shake?.6:0;sound.hurt();coast.burst((Math.random()-.5)*22,2,'#ee7450',1.8);\"'$('\"'damageFlash').classList.remove('flash');void \"'$('\"'damageFlash').offsetWidth;\"'$('\"'damageFlash').classList.add('flash');if(G.health<=0)finish(false);}\nfunction wind(){return (G.wave===0?.35:Math.sin(simTime*.19)*2.3)*tuning.wind;}\nfunction aimAt(seat,x,y){const dx=x-coast.guns[seat].x,dy=y-3.2,v=tuning.speed,g=tuning.gravity,abs=Math.abs(dx),disc=v*v*v*v-g*(g*abs*abs+2*dy*v*v);if(abs<.2)return Math.PI/2;if(disc<0)return Math.atan2(Math.max(1,dy),dx);const a=Math.atan((v*v-Math.sqrt(disc))/(g*abs));return clamp(dx<0?Math.PI-a:a,.12,Math.PI-.12);}\nfunction autoInput(seat){const gun=coast.guns[seat];let target=null,best=1e9;for(const e of entities.values()){if(e.type==='shot')continue;let priority=(e.type==='bomb'?-.7:0)+(e.type==='boss'?-.3:0)+(e.type==='supply'?.5:0);let d=Math.hypot(e.x-gun.x,e.y-3.2)/30+priority;if(d<best){best=d;target=e;}}\n if(\"'!target)return {angle:1.1,fire:false,salvo:false};let a=aimAt(seat,target.x,target.y+(['\"'boat','boss'].includes(target.type)?1:0));\n for(let k=0;k<4;k++){let t=Math.abs(target.x-gun.x)/(Math.max(2,Math.abs(Math.cos(a)*tuning.speed)));t=clamp(t,.08,2.2);let xx=target.type==='boss'?Math.sin((simTime+t)*.43)*13:target.x+target.vx*t*tuning.enemySpeed;let yy=target.y+(target.type==='bomb'?target.vy*t:target.type==='supply'?-.7*t:0)+(target.type==='boss'?1.8:target.type==='boat'?.7:0);a=aimAt(seat,xx-wind()*.5*t*t,yy);}\n return {angle:a,fire:true,salvo:G.energy[seat]>=100&&G.wave>0&&G.time>15};\n}\nfunction updateEntities(dt){\n const dead=[];\n for(const e of entities.values()){\n  e.age+=dt;\n  if(e.type==='shot'){\n   if(Math.abs(wind())>.01){const v=e.body.linvel();e.body.setLinvel({x:v.x+wind()*dt,y:v.y,z:0},true);}\n   const p=e.body.translation();e.x=p.x;e.y=p.y;e.root.position.set(p.x,p.y,0);\n   if(e.y<.8||e.y>34||Math.abs(e.x)>34||e.age>6){if(e.y<.8){coast.burst(e.x,.8,'#a0d9ca',.6);sound.splash();}dead.push(e);}continue;\n  }\n  if(e.flash>0){e.flash-=dt;if(e.flash<=0)e.root.scale.setScalar(1);}\n  if(e.type==='boss'){e.x=Math.sin(simTime*.43)*13;e.drop-=dt;if(e.drop<=0){e.drop=2.1;for(let k=-1;k<=1;k++){const b=spawn('bomb',1,e.y+5);b.x=e.x+k*3;b.vx=(coast.guns[k===1?1:0].x-b.x)*.25;b.vy=6;b.baseY=b.y;}}}\n  else if(e.type==='bomb'){e.x+=e.vx*dt;e.vy-=7*dt;e.y+=e.vy*dt;if(e.y<1.8){dead.push(e);hurt();}}\n  else if(e.type==='supply'){e.y-=.72*dt;if(e.y<1.8)dead.push(e);}\n  else {e.x+=e.vx*dt*tuning.enemySpeed;e.y=e.baseY+Math.sin(e.age*(e.type==='boat'?1.5:2))*.18;e.drop-=dt;\n   if(e.drop<=0&&Math.abs(e.x)<20){e.drop=e.type==='boat'?4.3:4.8;const b=spawn('bomb',1,e.y-.7);b.x=e.x;b.vx=e.type==='boat'?(coast.guns[e.x>0?1:0].x-e.x)*.4:e.vx*.3;b.vy=e.type==='boat'?11:-1;}\n   if(Math.abs(e.x)>34)dead.push(e);\n  }\n  e.body.setNextKinematicTranslation({x:e.x,y:e.y,z:0});e.root.position.set(e.x,e.y,0);e.root.userData.mixer?.update(dt);\n }\n for(const e of dead)remove(e);\n}\nfunction step(dt){\n if(screen\"'!=='\"'playing'||net.ended)return;\n if(\"'!net.running)return;\n if(net.isGuest&&mode==='\"'online'){net.tick(dt,inputs[1],null);return;}\n simTime+=dt;G.time+=dt;physicsSteps++;world.gravity.y=-tuning.gravity;\n const seats=(mode==='coop'||mode==='online')?2:1;\n for(let i=0;i<seats;i++){\n  G.cooldowns[i]=Math.max(0,G.cooldowns[i]-dt);G.energy[i]=Math.min(100,G.energy[i]+dt*2.1);\n  let inp=(autoplay||mode==='demo')?autoInput(i):inputs[i];\n  if(mode==='online'&&(net.server||i\"'!==net.localSeat))inp=remoteInputs[i]||{};\n  if(inp.angle!=null&&Number.isFinite(inp.angle))inputs[i].angle=clamp(inp.angle,.12,Math.PI-.12);\n  coast.guns[i].pivot.rotation.z=inputs[i].angle;\n  if(inp.fire)shoot(i);if(inp.salvo)salvo(i);\n }\n spawnClock-=dt;supplyClock-=dt;\n if(spawnClock<=0){spawnClock=tuning.spawn*(G.wave===2?1.8:1);const type=G.wave===0?(Math.random()<.2?'\"'heli':'plane'):G.wave===1?(Math.random()<.6?'boat':'plane'):(Math.random()<.4?'heli':'plane');spawn(type);}\n if(supplyClock<=0){spawn('supply');supplyClock=16;}\n updateEntities(dt);world.step(events);\n const collisions=[];events.drainCollisionEvents((a,b,started)=>{if(started)collisions.push([handles.get(a),handles.get(b)]);});\n for(const [a,b]of collisions){if(\"'!a?.alive||!b?.alive)continue;const shot=a.type==='\"'shot'?a:b.type==='shot'?b:null;const target=shot===a?b:a;if(shot&&target.type\"'!=='\"'shot'){remove(shot);damage(target,shot.special?2:1);}}\n G.comboTimer=Math.max(0,G.comboTimer-dt);if(\"'!G.comboTimer)G.combo=0;\n net.lastScore=G.score;net.tick(dt,inputs[net.localSeat]||{},snapshot());\n}\nfunction snapshot(){return {g:{...G,cooldowns:undefined},a:inputs.map(i=>i.angle),e:[...entities.values()].map(e=>[e.id,e.type,+e.x.toFixed(2),+e.y.toFixed(2),e.hp||0,e.side||1]),screen,mode:'\"'online',t:+simTime.toFixed(2)};}\nfunction applySnapshot(s){if(\"'!s?.g||!Array.isArray(s.e)||s.e.length>170)return;G={...G,...s.g};simTime=s.t||0;mode='\"'online';if(s.screen==='results'){finish(\"'!!G.won,G.won?'\"'HARBOR SECURED':'PIER OVERRUN',true);return;}if(\"'!['\"'playing','pause','dev'].includes(screen))setScreen('playing');\n coast.guns.forEach((g,i)=>{g.root.visible=true;g.pivot.rotation.z=s.a?.[i]??g.angle;});let seen=new Set();for(const d of s.e){const [id,type,x,y,hp,side]=d;seen.add(id);let r=remoteViews.get(id);if(\"'!r){r=type==='\"'shot'?coast.projectile(x,y):coast.makeTarget(type,side);remoteViews.set(id,r);if(type==='shot')sound.shot();}r.position.set(x,y,0);r.userData.mixer?.update(.1);}\n for(const [id,r]of remoteViews){if(\"'!seen.has(id)){if(r.position.y>1.5)coast.burst(r.position.x,r.position.y,'\"'#edb656',.6);coast.remove(r);remoteViews.delete(id);}}\n updateHUD();\n}\nfunction updateHUD(){if(\"'!G.energy)return;$('\"'score').textContent=String(G.score||0).padStart(6,'0');\"'$('\"'operation').textContent='0'+(G.wave+1)+' / 03';\"'$('\"'mission').textContent=stageNames[G.wave];\"'$('\"'objective').textContent=G.wave===2?'FLAGSHIP '+Math.max(0,G.bossHP)+' / '+G.bossMax:(G.waveKills||0)+' / '+(G.wave===0?'8 AIRCRAFT':'10 TARGETS');\n \"'$('\"'health').textContent='▰'.repeat(Math.max(0,Math.ceil(G.health)))+'▱'.repeat(Math.max(0,G.maxHealth-Math.ceil(G.health)));\"'$('\"'health').setAttribute('aria-label',G.health+' hull points');\n const energy=G.energy[net.isGuest?1:0]??0;\"'$('\"'energyFill').style.width=energy+'%';\"'$('\"'salvoText').textContent=energy>=99.8?'BROADSIDE READY':'BROADSIDE '+Math.floor(energy)+'%';\"'$('\"'salvoTouch').classList.toggle('ready',energy>=99.8);\"'$('\"'salvoTouch').textContent=energy>=99.8?'SALVO':'CHARGING';\"'$('\"'combo').textContent=G.combo>=2?G.combo+' CHAIN · '+Math.min(5,1+Math.floor(G.combo/4))+'×':'';\n \"'$('\"'wind').textContent=(wind()>0?'→':'←')+' '+Math.abs(wind()).toFixed(1);\"'$('\"'bossTrack').hidden=G.wave\"'!==2;$('\"'bossFill').style.width=Math.max(0,G.bossHP/G.bossMax*100)+'%';\"'$('\"'coopTag').textContent=mode==='coop'?'TWO GUNNERS':mode==='online'?'CONNECTED CO-OP':'PORT BATTERY';\n \"'$('\"'sync').hidden=\"'!net.active||net.running;if(!net.running)$('\"'sync').textContent='GUNNERS READY · '+Math.ceil(net.countdown);\n}\nfunction pause(){if(screen==='playing'&&mode\"'!=='\"'demo'){pointerDown=false;touchActive=false;inputs.forEach(i=>i.fire=false);setScreen('pause');sound.mute(true);}else if(['pause','dev'].includes(screen)){setScreen('playing');sound.mute(false);}}\nfunction focusables(){return [...document.querySelectorAll('.panel:not([hidden]) button,.panel:not([hidden]) input,.panel:not([hidden]) select,.panel:not([hidden]) textarea')].filter(e=>\"'!e.disabled&&e.offsetParent!==null);}\nfunction navigate(d){const a=focusables();if(!a.length)return;const current=a.indexOf(document.activeElement);navIndex=(Math.max(0,current)+d+a.length)%a.length;a[navIndex].focus({preventScroll:true});a[navIndex].scrollIntoView({block:'\"'nearest'});}\nfunction adjustFocused(d){const e=document.activeElement;if(e?.type==='range'){e.value=clamp(Number(e.value)+d*Number(e.step||1),Number(e.min),Number(e.max));e.dispatchEvent(new Event('input'));}else if(e?.tagName==='SELECT'){e.selectedIndex=(e.selectedIndex+d+e.options.length)%e.options.length;e.dispatchEvent(new Event('change'));}else navigate(d);}\nfunction menuBack(){if(['pause','dev'].includes(screen)){if(screen==='dev')setScreen('pause');else pause();}else if(screen==='settings'){setScreen(previous==='pause'?'pause':'title');sound.mute(previous==='pause');}else if(screen==='about'||screen==='howto')setScreen(previous==='pause'?'pause':'title');else if(screen==='online'){net.leave();title();}else if(screen==='results')title();}\nfunction pollInputs(dt){\n const pads=[...(navigator.getGamepads?.()||[])].filter(Boolean);\n for(let n=0;n<Math.min(2,pads.length);n++){const p=pads[n],prev=padPrevious[n]||[],pressed=i=>\"'!!p.buttons[i]?.pressed,edge=i=>pressed(i)&&!prev[i];const axis=p.axes||[];\n  const any=p.buttons.some(b=>b.pressed)||axis.some(v=>Math.abs(v)>.22);\n  if(any){const exit=activity('\"'gamepad');if(exit){padPrevious[n]=p.buttons.map(b=>b.pressed);continue;}}\n  if(screen==='playing'){\n   const seat=mode==='online'?net.localSeat:n;if(seat>=0&&seat<2){if(Math.hypot(axis[0]||0,axis[1]||0)>.25)inputs[seat].angle=clamp(Math.atan2(-(axis[1]||0),axis[0]||0),.12,Math.PI-.12);inputs[seat].fire=pressed(7)||pressed(0);inputs[seat].salvo=pressed(2);}\n   if(edge(9))pause();\n  }else if(any&&performance.now()>navAt){if(edge(0)){document.activeElement?.click();navAt=performance.now()+180;}else if(edge(1)||edge(9)){menuBack();navAt=performance.now()+180;}else if(pressed(13)||(axis[1]||0)>.55){navigate(1);navAt=performance.now()+220;}else if(pressed(12)||(axis[1]||0)<-.55){navigate(-1);navAt=performance.now()+220;}else if(pressed(15)||(axis[0]||0)>.55){adjustFocused(1);navAt=performance.now()+180;}else if(pressed(14)||(axis[0]||0)<-.55){adjustFocused(-1);navAt=performance.now()+180;}}\n  padPrevious[n]=p.buttons.map(b=>b.pressed);\n }\n if(screen\"'!=='\"'playing')return;\n const seat=mode==='online'?net.localSeat:0;if(seat<0)return;\n if(manualInput){Object.assign(inputs[seat],manualInput);return;}\n if(inputMode==='keyboard'){\n  if(mousePoint){const point=coast.pointer(mousePoint.x,mousePoint.y);inputs[seat].angle=aimAt(seat,point.x,Math.max(3.5,point.y));}\n  if(keys.has('KeyA')||keys.has('ArrowLeft')){mousePoint=null;inputs[seat].angle=clamp(inputs[seat].angle+dt*1.6,.12,Math.PI-.12);}\n  if(keys.has('KeyD')||keys.has('ArrowRight')){mousePoint=null;inputs[seat].angle=clamp(inputs[seat].angle-dt*1.6,.12,Math.PI-.12);}\n  inputs[seat].fire=pointerDown||keys.has('Space');inputs[seat].salvo=keys.has('KeyE');\n }\n if(inputMode==='touch'){inputs[seat].fire=touchActive;if(touchActive){if(touchAim){const v=coast.pointer(touchAim.x,touchAim.y);inputs[seat].angle=aimAt(seat,v.x,Math.max(4,v.y));}if(prefs.assist){const ai=autoInput(seat);inputs[seat].angle=ai.angle;}}}\n if(mode==='coop'&&\"'!pads[1]){if(keys.has('\"'KeyJ'))inputs[1].angle=clamp(inputs[1].angle+dt*1.6,.12,Math.PI-.12);if(keys.has('KeyL'))inputs[1].angle=clamp(inputs[1].angle-dt*1.6,.12,Math.PI-.12);inputs[1].fire=keys.has('Enter');inputs[1].salvo=keys.has('KeyU');}\n}\nfunction frame(dt){\n if(\"'!ready)return;dt=Math.min(dt,.1);idle+=dt;\n if(screen==='\"'title'&&idle>=10&&\"'!net.active)start('\"'demo');\n pollInputs(dt);\n if(screen==='playing'){let n=Math.max(1,Math.ceil(dt/(1/60)));for(let i=0;i<n;i++)step(dt/n);demoTime+=dt;if(mode==='demo'&&demoTime>110)start('demo');}\n else if(['title','settings','about','howto','online'].includes(screen)){for(const e of entities.values()){e.age+=dt;e.root.userData.mixer?.update(dt);e.root.position.y=e.baseY+Math.sin(e.age)*.16;}}\n if(screen==='playing'||screen==='title')coast.update(dt);else coast.update(0);\n const seat=net.isGuest?1:0;coast.drawAim(coast.guns[seat].x,3.2,inputs[seat]?.angle||1.1,tuning.speed,tuning.gravity,wind(),screen==='playing'&&mode\"'!=='\"'demo'&&inputMode\"'!=='\"'touch');\n shake=Math.max(0,shake-dt*1.8);toastTime-=dt;if(toastTime<=0)\"'$('\"'toast').classList.remove('show');bannerTime-=dt;if(bannerTime<=0)\"'$('\"'banner').classList.remove('show');\n sound.update(dt,screen==='playing'&&mode\"'!=='\"'demo',G.wave/2||0);if(screen==='playing')updateHUD();coast.render(shake);\n}\nfunction bindUI(){\n \"'$('\"'start').onclick=()=>{sound.unlock();start('solo');};\"'$('\"'coop').onclick=()=>{sound.unlock();start('coop');};\"'$('\"'online').onclick=()=>{previous='title';setScreen('online');};\n \"'$('\"'settings').onclick=()=>{previous='title';setScreen('settings');};\"'$('\"'about').onclick=()=>{previous='title';setScreen('about');};\"'$('\"'howto').onclick=()=>{previous='title';setScreen('howto');};\n \"'$('\"'pause').onclick=pause;\"'$('\"'resume').onclick=pause;\"'$('\"'dev').onclick=()=>setScreen('dev');\"'$('\"'pauseSettings').onclick=()=>{previous='pause';setScreen('settings');};\"'$('\"'pauseAbout').onclick=()=>{previous='pause';setScreen('about');};\"'$('\"'quit').onclick=()=>{net.leave();title();};\n \"'$('\"'retry').onclick=()=>start(mode==='online'?'solo':mode);\"'$('\"'resultMenu').onclick=()=>{net.leave();title();};\n for(const e of document.querySelectorAll('[data-back]'))e.onclick=menuBack;\n \"'$('\"'music').value=prefs.music*100;\"'$('\"'musicOut').textContent=Math.round(prefs.music*100)+'%';\"'$('\"'music').oninput=e=>{prefs.music=Number(e.target.value)/100;sound.setMusic(prefs.music);\"'$('\"'musicOut').textContent=e.target.value+'%';save();};\n \"'$('\"'sfx').value=prefs.sfx*100;\"'$('\"'sfxOut').textContent=Math.round(prefs.sfx*100)+'%';\"'$('\"'sfx').oninput=e=>{prefs.sfx=Number(e.target.value)/100;sound.setSfx(prefs.sfx);\"'$('\"'sfxOut').textContent=e.target.value+'%';sound.shot();save();};\n \"'$('\"'glyph').value=prefs.glyph;\"'$('\"'glyph').onchange=e=>{prefs.glyph=e.target.value;save();updatePrompts();};\"'$('\"'shake').checked=prefs.shake;\"'$('\"'shake').onchange=e=>{prefs.shake=e.target.checked;save();};\"'$('\"'assist').checked=prefs.assist;\"'$('\"'assist').onchange=e=>{prefs.assist=e.target.checked;save();};\n const names={speed:'Shell velocity',gravity:'Gravity',cooldown:'Shot interval',enemySpeed:'Target speed',spawn:'Spawn interval',damage:'Incoming damage',wind:'Wind strength',assist:'Hit forgiveness'};\n const ranges={speed:[20,40,.5],gravity:[6,20,.5],cooldown:[.08,.65,.01],enemySpeed:[.3,2.5,.1],spawn:[.5,3,.05],damage:[0,2,1],wind:[0,3,.1],assist:[0,2,.05]};\n for(const k of Object.keys(defaults)){const label=document.createElement('label');label.className='sliderRow';label.innerHTML=\"'`<span>${names[k]}</span><input id=\"tune-${k}\" type=\"range\" min=\"${ranges[k][0]}\" max=\"${ranges[k][1]}\" step=\"${ranges[k][2]}\" value=\"${defaults[k]}\"><output id=\"out-${k}\">${defaults[k]}</output>`;$('\"'sliders').append(label);\"'$('\"'tune-'+k).oninput=e=>{tuning[k]=Number(e.target.value);\"'$('\"'out-'+k).textContent=e.target.value;};}\n \"'$('\"'resetTuning').onclick=()=>{tuning={...defaults};for(const k in defaults){\"'$('\"'tune-'+k).value=defaults[k];\"'$('\"'out-'+k).textContent=defaults[k];}toast('DEFAULT BALANCE RESTORED');};\n \"'$('\"'devHeal').onclick=()=>{G.health=G.maxHealth;G.energy=[100,100];updateHUD();toast('BATTERY REPAIRED');};\"'$('\"'devWave').onclick=()=>{if(G.wave<2)nextWave();else{const b=[...entities.values()].find(e=>e.type==='boss');if(b)damage(b,100);}updateHUD();};\"'$('\"'devAI').onclick=()=>{autoplay=\"'!autoplay;$('\"'devAI').textContent='AUTOPILOT '+(autoplay?'ON':'OFF');};\n \"'$('\"'salvoTouch').onclick=e=>{e.stopPropagation();salvo(net.isGuest?1:0);};\n const busy=async(fn)=>{try{\"'$('\"'networkStatus').textContent='ESTABLISHING RADIO LINK…';await fn();}catch(e){\"'$('\"'networkStatus').textContent=e.message||'CONNECTION FAILED';}};\n \"'$('\"'hostLocal').onclick=()=>busy(async()=>{\"'$('\"'roomCode').value=net.hostLocal();});\"'$('\"'joinLocal').onclick=()=>busy(async()=>net.joinLocal(\"'$('\"'roomCode').value));\n \"'$('\"'createOffer').onclick=()=>busy(async()=>{\"'$('\"'signalOut').value=await net.hostRoom();\"'$('\"'networkStatus').textContent='Send your invitation. Paste the other gunner’s reply below, then Connect.';});\n \"'$('\"'joinOffer').onclick=()=>busy(async()=>{\"'$('\"'signalOut').value=await net.joinRoom(\"'$('\"'signalIn').value);\"'$('\"'networkStatus').textContent='Send this reply to the host. Your gun will join automatically.';});\n \"'$('\"'acceptAnswer').onclick=()=>busy(async()=>{await net.acceptAnswer(\"'$('\"'signalIn').value);});\n \"'$('\"'copySignal').onclick=async()=>{const e=\"'$('\"'signalOut');e.select();try{await navigator.clipboard.writeText(e.value);\"'$('\"'networkStatus').textContent='RADIO CODE COPIED';}catch{\"'$('\"'networkStatus').textContent='Code selected. Press Ctrl+C to copy.';}};\n document.addEventListener('pointerover',e=>{if(e.pointerType\"'!=='\"'touch'&&e.target.closest('button'))e.target.closest('button').focus({preventScroll:true});});\n document.addEventListener('pointermove',e=>{if(e.pointerType==='touch')return;activity('keyboard');if(screen==='playing')mousePoint={x:e.clientX,y:e.clientY};});\n document.addEventListener('pointerdown',e=>{if(activity(e.pointerType==='touch'?'touch':'keyboard')){e.preventDefault();e.stopPropagation();return;}sound.unlock();if(screen\"'!=='\"'playing'||e.target.closest('button,input,select,textarea,label'))return;if(e.pointerType==='touch'){touchActive=true;touchOrigin={x:e.clientX,y:e.clientY};touchAim={...touchOrigin};}else if(e.button===0){pointerDown=true;mousePoint={x:e.clientX,y:e.clientY};}} ,true);\n document.addEventListener('pointermove',e=>{if(e.pointerType==='touch'&&touchActive){touchAim={x:e.clientX,y:e.clientY};}});\n document.addEventListener('pointerup',e=>{if(e.pointerType==='touch')touchActive=false;else pointerDown=false;});document.addEventListener('pointercancel',()=>{touchActive=false;pointerDown=false;});\n document.addEventListener('contextmenu',e=>{e.preventDefault();if(screen==='playing')salvo(net.isGuest?1:0);});\n document.addEventListener('keydown',e=>{if(e.target.matches('input,textarea,select')&&\"'!['\"'Escape'].includes(e.code))return;if(activity('keyboard')){e.preventDefault();return;}sound.unlock();if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Enter'].includes(e.code))e.preventDefault();keys.add(e.code);if(e.repeat)return;if(e.code==='Escape'){if(screen==='playing')pause();else menuBack();}else if(screen\"'!=='\"'playing'){if(e.code==='ArrowDown')navigate(1);if(e.code==='ArrowUp')navigate(-1);if(e.code==='ArrowLeft')adjustFocused(-1);if(e.code==='ArrowRight')adjustFocused(1);if(e.code==='Enter'||e.code==='Space'){const a=focusables();if(\"'!a.includes(document.activeElement))a[0]?.focus();document.activeElement?.click();}}});\n document.addEventListener('\"'keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();pointerDown=false;touchActive=false;if(screen==='playing'&&mode\"'!=='\"'demo'&&\"'!net.online)pause();});window.addEventListener('\"'resize',()=>coast.resize());\n}\nasync function init(){try{\n \"'$('\"'loadText').textContent='PREPARING THE COAST…';await RAPIER.init();coast=new Coast(\"'$('\"'game'));await coast.init();resetPhysics();bindUI();updatePrompts();\n \"'$('\"'backend').textContent=coast.backend+' · THREE.JS r180 · RAPIER 0.19.3';await net.init();ready=true;\"'$('\"'loading').hidden=true;title();if(net.active){clearWorld();\"'$('\"'start').disabled=true;\"'$('\"'networkStatus').textContent='AI HUB · WAITING FOR THE WATCH';setScreen('online');}net.ready();\n window.__Sound=Sound;\n window.__game={state:()=>({ready,screen,mode,wave:G.wave||0,score:G.score||0,health:G.health||0,energy:G.energy,targets:[...entities.values()].filter(e=>e.type\"'!=='\"'shot').length,shots:[...entities.values()].filter(e=>e.type==='shot').length,shotsFired:G.shotsFired||0,hits:G.hits||0,kills:G.kills||0,physicsSteps,time:G.time||0,musicVolume:sound.stats.musicVolume,backend:coast.backend,inputMode,glyph:prefs.glyph,tuning:{...tuning},won:G.won||false,autoplay,net:{host:net.isHost,guest:net.isGuest,online:net.online,stats:net.stats}}),start,setInput:i=>manualInput=i,setAutoplay:v=>{autoplay=v;},advance:seconds=>{for(let t=0;t<seconds;t+=1/60)frame(Math.min(1/60,seconds-t));},dev:values=>{for(const [k,v]of Object.entries(values)){if(k==='health'){G.health=v;if(v<=0)finish(false);}else if(k==='wave'){while(G.wave<v&&G.wave<2)nextWave();}else if(k in tuning)tuning[k]=v;}},goto:setScreen,damage:hurt,sound,net,snapshot,entities:()=>[...entities.values()].map(e=>({type:e.type,x:e.x,y:e.y,hp:e.hp})),pause};\n let last=performance.now();const loop=now=>{const dt=(now-last)/1000;last=now;frame(dt);requestAnimationFrame(loop);};requestAnimationFrame(loop);\n}catch(e){console.error(e);\"'$('\"'loadText').textContent='THE RADIO LOST ITS SIGNAL';\"'$('\"'loadDetail').textContent=e.message+' · Check the connection, then reload. CDN libraries require internet on first load.';net.fail(e.message);}}\ninit();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/main.js <<'EOF'\nimport RAPIER from 'rapier';\nimport {Coast} from './scene.js';\nimport {Sound} from './audio.js';\nimport {Network} from './net.js';\n\nconst \"'$=id=>document.getElementById(id), clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst defaults={speed:29,gravity:13,cooldown:.3,enemySpeed:1,spawn:1.45,damage:1,wind:1,assist:.35};\nlet tuning={...defaults}, prefs={music:.1,sfx:.65,glyph:'\"'ps',shake:true,assist:true};\ntry{Object.assign(prefs,JSON.parse(localStorage.getItem('pier-pressure-prefs')||'{}'));}catch{}\nconst sound=new Sound();sound.setMusic(prefs.music);sound.setSfx(prefs.sfx);\nlet coast,world,events,screen='loading',previous='title',mode='solo',inputMode='keyboard',lastActivity=performance.now(),idle=0,ready=false,autoplay=false;\nlet simTime=0,physicsSteps=0,spawnClock=0,supplyClock=0,nextId=1,shake=0,toastTime=0,bannerTime=0,demoTime=0;\nlet entities=new Map(),handles=new Map(),remoteViews=new Map(),inputs=[{angle:1.1,fire:false,salvo:false},{angle:2.04,fire:false,salvo:false}],remoteInputs=[{},{}];\nlet G={},keys=new Set(),pointerDown=false,mousePoint=null,padPrevious=[],navAt=0,navIndex=0,manualInput=null,touchOrigin=null,touchAim=null,touchActive=false,guestLastShot=0;\nconst stageNames=['SKY PATROL','CONVOY CROSSING','THE ADMIRAL'];\nconst stageOrders=['Lead the aircraft. Shoot down red bombs.','Rough water. Low angles. Watch the wind.','Sink the flagship. Keep the pier standing.'];\nconst net=new Network({\n onInput:(input,seat)=>{remoteInputs[seat]={...input,fire:\"'!!input.fire,salvo:!!input.salvo};},\n onState:s=>applySnapshot(s),onStatus:t=>{$('\"'networkStatus').textContent=t;},\n onConnect:()=>{start('online');toast('SECOND GUNNER ABOARD');},\n onDisconnect:()=>{if(screen==='playing'){mode='solo';inputs[1].fire=false;remoteInputs[1]={};toast('SECOND GUNNER LEFT · KEEP FIRING');}},\n onStart:()=>start('online'),onTimeUp:()=>{if(net.isHost)finish(G.health>0,'WATCH COMPLETE');},\n onEnd:reason=>{if(screen\"'!=='\"'results')finish(false,reason==='host-left'?'COMMAND DISCONNECTED':'WATCH ENDED',true);},\n onResult:(score,won,stats)=>{G.score=score;Object.assign(G,stats);finish(won,won?'HARBOR SECURED':'WATCH ENDED',true);},\n onLeave:()=>{remoteInputs[1]={};toast('A GUNNER LEFT THE WATCH');}\n});\nfunction save(){try{localStorage.setItem('pier-pressure-prefs',JSON.stringify(prefs));}catch{}}\nfunction touchOrPad(){document.body.classList.toggle('touch',inputMode==='touch');}\nfunction setInputMode(v){if(inputMode\"'!==v){inputMode=v;touchOrPad();updatePrompts();}}\nfunction activity(type){lastActivity=performance.now();idle=0;if(type)setInputMode(type);if(mode==='\"'demo'){title();return true;}return false;}\nfunction updatePrompts(){const pad=inputMode==='gamepad',xbox=prefs.glyph==='xbox';for(const e of document.querySelectorAll('[data-prompt]')){const p=e.dataset.prompt;e.textContent=pad?({fire:'R2',salvo:xbox?'X':'□',confirm:xbox?'A':'✕',back:xbox?'B':'○',pause:'☰',aim:'L'}[p]):({fire:'HOLD CLICK / SPACE',salvo:'E',confirm:'ENTER',back:'ESC',pause:'ESC',aim:'MOUSE / A D'}[p]);} \"'$('\"'controlLine').innerHTML=pad?\"'`<b>L</b> aim <b>R2 / ${xbox?'\"'A':'✕'}</b> fire <b>\"'${xbox?'\"'X':'□'}</b> salvo <b>☰</b> pause\"'`:'\"'<b>MOUSE</b> aim <b>HOLD CLICK / SPACE</b> fire <b>E</b> salvo <b>ESC</b> pause';}\nfunction setScreen(s){screen=s;\"'$('\"'screen').dataset.screen=s;document.body.dataset.screen=s;for(const el of document.querySelectorAll('.panel'))el.hidden=el.dataset.panel\"'!==s;$('\"'hud').hidden=\"'!['\"'playing','pause','dev'].includes(s);\"'$('\"'pause').hidden=s\"'!=='\"'playing';\"'$('\"'attract').hidden=mode\"'!=='\"'demo';\"'$('\"'salvoTouch').hidden=inputMode\"'!=='\"'touch'||s\"'!=='\"'playing';navIndex=0;requestAnimationFrame(()=>{const b=focusables()[0];if(b&&inputMode==='gamepad')b.focus({preventScroll:true});});}\nfunction toast(text){\"'$('\"'toast').textContent=text;toastTime=2.8;\"'$('\"'toast').classList.add('show');}\nfunction banner(kicker,title,sub){\"'$('\"'bannerKicker').textContent=kicker;\"'$('\"'bannerTitle').textContent=title;\"'$('\"'bannerSub').textContent=sub;bannerTime=3.2;\"'$('\"'banner').classList.add('show');sound.voice(G.wave||0);}\nfunction title(){clearWorld();mode='solo';autoplay=false;setScreen('title');idle=0;pointerDown=false;touchActive=false;inputs.forEach(i=>i.fire=false);sound.mute(false);createTableau();}\nfunction clearWorld(){for(const e of [...entities.values()])remove(e);for(const r of remoteViews.values())coast?.remove(r);remoteViews.clear();}\nfunction createTableau(){if(\"'!coast)return;const a=spawn('\"'plane',1,24);a.x=9;a.y=16;a.baseY=16;a.root.position.set(9,16,0);a.body.setTranslation({x:9,y:16,z:0},true);const b=spawn('boat',-1);b.x=16;b.y=3.5;b.baseY=3.5;b.root.position.set(16,3.5,0);b.body.setTranslation({x:16,y:3.5,z:0},true);const h=spawn('heli',-1);h.x=23;h.y=10;h.baseY=10;h.root.position.set(23,10,0);h.body.setTranslation({x:23,y:10,z:0},true);}\nfunction resetPhysics(){clearWorld();if(world)world.free();if(events)events.free();world=new RAPIER.World({x:0,y:-tuning.gravity,z:0});world.timestep=1/60;events=new RAPIER.EventQueue(true);handles.clear();}\nfunction start(which='solo'){\n mode=which;autoplay=which==='demo';resetPhysics();simTime=0;spawnClock=.45;supplyClock=8;demoTime=0;remoteInputs=[{},{}];manualInput=null;\n G={wave:0,score:0,health:7,maxHealth:7,energy:[100,100],cooldowns:[0,0],kills:0,waveKills:0,shotsFired:0,hits:0,combo:0,comboTimer:0,bestCombo:0,bossHP:24,bossMax:24,won:false,time:0,salvos:0,rescues:0};\n inputs=[{angle:1.1,fire:false,salvo:false},{angle:2.04,fire:false,salvo:false}];pointerDown=false;touchActive=false;keys.clear();net.reported=false;sound.mute(false);setScreen('playing');banner(which==='demo'?'AUTOMATIC DEMONSTRATION':'OPERATION 01',stageNames[0],stageOrders[0]);updateHUD();\n coast.guns[1].root.visible=which\"'!=='\"'solo'&&which\"'!=='\"'demo';\n}\nfunction nextWave(){G.wave++;G.waveKills=0;G.health=Math.min(G.maxHealth,G.health+2);G.energy=G.energy.map(v=>Math.max(v,65));clearWorld();spawnClock=1;banner('OPERATION 0'+(G.wave+1),stageNames[G.wave],stageOrders[G.wave]);if(G.wave===2)spawn('boss',1);sound.fanfare();}\nfunction finish(won,reason=won?'HARBOR SECURED':'PIER OVERRUN',fromNet=false){\n if(screen==='results')return;G.won=won;inputs.forEach(i=>i.fire=false);pointerDown=false;touchActive=false;\n if(mode==='demo'){start('demo');return;}\n \"'$('\"'resultKicker').textContent=won?'MISSION COMPLETE':'END OF WATCH';\"'$('\"'resultTitle').textContent=reason;\n const acc=G.shotsFired?Math.round(G.hits/G.shotsFired*100):0;\n let medal=won?(G.health>=5?'GOLD ANCHOR':G.health>=3?'SILVER ANCHOR':'BRONZE ANCHOR'):'BACK TO THE BATTERY';\n \"'$('\"'medal').textContent=medal;\"'$('\"'finalScore').textContent=String(G.score||0).padStart(6,'0');\"'$('\"'resultStats').innerHTML=\"'`<span><b>${G.kills||0}</b> TARGETS</span><span><b>${acc}%</b> ACCURACY</span><span><b>${G.bestCombo||0}×</b> BEST CHAIN</span>`;\n try{const old=Number(localStorage.getItem('\"'pier-pressure-best')||0);if(G.score>old)localStorage.setItem('pier-pressure-best',G.score);\"'$('\"'best').textContent=String(Math.max(old,G.score||0)).padStart(6,'0');}catch{}\n setScreen('results');if(won)sound.fanfare();else sound.hurt();\n if(\"'!fromNet&&net.isHost&&mode==='\"'online')net.finish(G.score,won,{kills:G.kills,shotsFired:G.shotsFired,hits:G.hits,bestCombo:G.bestCombo,health:G.health});\n}\nfunction spawn(type,side=Math.random()<.5?1:-1,y){\n const id=nextId++,x=side>0?-29:29,baseY=y??(type==='boat'?2.8:type==='boss'?3.2:type==='supply'?24:11+Math.random()*11);\n const root=coast.makeTarget(type,side);root.position.set(x,baseY,0);\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x,baseY,0));\n const dims=type==='boss'?[5.4,2.4,1.7]:type==='boat'?[2.2,1.4,1.5]:type==='bomb'?[.38,.55,.4]:type==='supply'?[1.05,1.5,1.1]:type==='heli'?[1.8,1.05,1.6]:[1.7,.65,1.8];\n const col=world.createCollider(RAPIER.ColliderDesc.cuboid(...dims).setTranslation(0,type==='boss'?1.5:type==='boat'?.45:0,0).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);\n let speed=(type==='boat'?2.5:type==='heli'?3.4:type==='boss'?0:type==='supply'?0:5.1+Math.random()*2)*side;\n const e={id,type,x,y:baseY,baseY,vx:speed,vy:0,side,root,body,col,alive:true,hp:type==='boss'?24:type==='heli'||type==='boat'?2:1,age:0,drop:2.1+Math.random()*2,flash:0};\n if(type==='boss'){e.x=0;root.position.x=0;body.setTranslation({x:0,y:baseY,z:0},true);}\n if(type==='supply'){e.x=(Math.random()-.5)*32;root.position.x=e.x;body.setTranslation({x:e.x,y:baseY,z:0},true);}\n entities.set(id,e);handles.set(col.handle,e);return e;\n}\nfunction remove(e){if(\"'!e||!entities.has(e.id))return;e.alive=false;handles.delete(e.col.handle);if(world.getRigidBody(e.body.handle))world.removeRigidBody(e.body);coast.remove(e.root);entities.delete(e.id);}\nfunction shoot(seat=0,angle=inputs[seat].angle,special=false){\n if(G.cooldowns[seat]>0&&!special)return false;\n const gun=coast.guns[seat],x=gun.x+Math.cos(angle)*2.65,y=3.2+Math.sin(angle)*2.65;\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,y,0).setLinvel(Math.cos(angle)*tuning.speed,Math.sin(angle)*tuning.speed,0).enabledTranslations(true,true,false).enabledRotations(false,false,false).setCcdEnabled(true));\n const col=world.createCollider(RAPIER.ColliderDesc.ball(.25+tuning.assist*.23).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);\n const e={id:nextId++,type:'\"'shot',seat,body,col,root:coast.projectile(x,y,special),x,y,age:0,alive:true,special};entities.set(e.id,e);handles.set(col.handle,e);\n G.shotsFired++;G.cooldowns[seat]=tuning.cooldown;gun.action.reset().play();coast.burst(x,y,'#ffdb79',.18);sound.shot();return true;\n}\nfunction salvo(seat){if(G.energy[seat]<99.8)return;G.energy[seat]=0;G.salvos++;sound.voice(2);shake=prefs.shake?.25:0;\n const a=inputs[seat].angle;for(let i=-3;i<=3;i++)shoot(seat,clamp(a+i*.115,.13,Math.PI-.13),true);\n for(const e of [...entities.values()]){if(e.type==='bomb')damage(e,2);}\n toast('BROADSIDE\"'!'\"');\n}\nfunction damage(e,amount=1){if(\"'!e?.alive||e.type==='\"'shot')return;\n if(e.type==='supply'){G.energy=G.energy.map(v=>Math.min(100,v+40));G.health=Math.min(G.maxHealth,G.health+1);G.rescues++;G.score+=250;coast.burst(e.x,e.y,'#a4e8c4',1.4);sound.hit('supply');toast('SUPPLY +1 HULL · +40 SALVO');remove(e);return;}\n e.hp-=amount;G.hits++;e.flash=.16;e.root.scale.setScalar(1.08);if(e.type==='boss')G.bossHP=Math.max(0,e.hp);\n coast.burst(e.x,e.y+ (e.type==='boss'?1:0),e.type==='bomb'?'#f5d077':'#ef8b50',e.hp>0?.45:1);sound.hit(e.type);\n if(e.hp>0)return;\n const values={plane:100,scout:100,heli:175,boat:200,bomb:75,boss:2500};\n G.combo=G.comboTimer>0?G.combo+1:1;G.comboTimer=3.5;G.bestCombo=Math.max(G.bestCombo,G.combo);const mult=Math.min(5,1+Math.floor(G.combo/4));G.score+=(values[e.type]||100)*mult;\n G.energy=G.energy.map(v=>Math.min(100,v+7));if(e.type\"'!=='\"'bomb'){G.kills++;G.waveKills++;}\n if(e.type==='boss'){remove(e);finish(true);return;}\n remove(e);if(G.wave===0&&G.waveKills>=8)nextWave();else if(G.wave===1&&G.waveKills>=10)nextWave();\n}\nfunction hurt(){if(autoplay||mode==='demo'||tuning.damage===0)return;G.health-=tuning.damage;G.combo=0;G.comboTimer=0;shake=prefs.shake?.6:0;sound.hurt();coast.burst((Math.random()-.5)*22,2,'#ee7450',1.8);\"'$('\"'damageFlash').classList.remove('flash');void \"'$('\"'damageFlash').offsetWidth;\"'$('\"'damageFlash').classList.add('flash');if(G.health<=0)finish(false);}\nfunction wind(){return (G.wave===0?.35:Math.sin(simTime*.19)*2.3)*tuning.wind;}\nfunction aimAt(seat,x,y){const dx=x-coast.guns[seat].x,dy=y-3.2,v=tuning.speed,g=tuning.gravity,abs=Math.abs(dx),disc=v*v*v*v-g*(g*abs*abs+2*dy*v*v);if(abs<.2)return Math.PI/2;if(disc<0)return Math.atan2(Math.max(1,dy),dx);const a=Math.atan((v*v-Math.sqrt(disc))/(g*abs));return clamp(dx<0?Math.PI-a:a,.12,Math.PI-.12);}\nfunction autoInput(seat){const gun=coast.guns[seat];let target=null,best=1e9;for(const e of entities.values()){if(e.type==='shot')continue;let priority=(e.type==='bomb'?-.7:0)+(e.type==='boss'?-.3:0)+(e.type==='supply'?.5:0);let d=Math.hypot(e.x-gun.x,e.y-3.2)/30+priority;if(d<best){best=d;target=e;}}\n if(\"'!target)return {angle:1.1,fire:false,salvo:false};let a=aimAt(seat,target.x,target.y+(['\"'boat','boss'].includes(target.type)?1:0));\n for(let k=0;k<4;k++){let t=Math.abs(target.x-gun.x)/(Math.max(2,Math.abs(Math.cos(a)*tuning.speed)));t=clamp(t,.08,2.2);let xx=target.type==='boss'?Math.sin((simTime+t)*.43)*13:target.x+target.vx*t*tuning.enemySpeed;let yy=target.y+(target.type==='bomb'?target.vy*t:target.type==='supply'?-.7*t:0)+(target.type==='boss'?1.8:target.type==='boat'?.7:0);a=aimAt(seat,xx-wind()*.5*t*t,yy);}\n return {angle:a,fire:true,salvo:G.energy[seat]>=100&&G.wave>0&&G.time>15};\n}\nfunction updateEntities(dt){\n const dead=[];\n for(const e of entities.values()){\n  e.age+=dt;\n  if(e.type==='shot'){\n   if(Math.abs(wind())>.01){const v=e.body.linvel();e.body.setLinvel({x:v.x+wind()*dt,y:v.y,z:0},true);}\n   const p=e.body.translation();e.x=p.x;e.y=p.y;e.root.position.set(p.x,p.y,0);\n   if(e.y<.8||e.y>34||Math.abs(e.x)>34||e.age>6){if(e.y<.8){coast.burst(e.x,.8,'#a0d9ca',.6);sound.splash();}dead.push(e);}continue;\n  }\n  if(e.flash>0){e.flash-=dt;if(e.flash<=0)e.root.scale.setScalar(1);}\n  if(e.type==='boss'){e.x=Math.sin(simTime*.43)*13;e.drop-=dt;if(e.drop<=0){e.drop=2.1;for(let k=-1;k<=1;k++){const b=spawn('bomb',1,e.y+5);b.x=e.x+k*3;b.vx=(coast.guns[k===1?1:0].x-b.x)*.25;b.vy=6;b.baseY=b.y;}}}\n  else if(e.type==='bomb'){e.x+=e.vx*dt;e.vy-=7*dt;e.y+=e.vy*dt;if(e.y<1.8){dead.push(e);hurt();}}\n  else if(e.type==='supply'){e.y-=.72*dt;if(e.y<1.8)dead.push(e);}\n  else {e.x+=e.vx*dt*tuning.enemySpeed;e.y=e.baseY+Math.sin(e.age*(e.type==='boat'?1.5:2))*.18;e.drop-=dt;\n   if(e.drop<=0&&Math.abs(e.x)<20){e.drop=e.type==='boat'?4.3:4.8;const b=spawn('bomb',1,e.y-.7);b.x=e.x;b.vx=e.type==='boat'?(coast.guns[e.x>0?1:0].x-e.x)*.4:e.vx*.3;b.vy=e.type==='boat'?11:-1;}\n   if(Math.abs(e.x)>34)dead.push(e);\n  }\n  e.body.setNextKinematicTranslation({x:e.x,y:e.y,z:0});e.root.position.set(e.x,e.y,0);e.root.userData.mixer?.update(dt);\n }\n for(const e of dead)remove(e);\n}\nfunction step(dt){\n if(screen\"'!=='\"'playing'||net.ended)return;\n if(\"'!net.running)return;\n if(net.isGuest&&mode==='\"'online'){net.tick(dt,inputs[1],null);return;}\n simTime+=dt;G.time+=dt;physicsSteps++;world.gravity.y=-tuning.gravity;\n const seats=(mode==='coop'||mode==='online')?2:1;\n for(let i=0;i<seats;i++){\n  G.cooldowns[i]=Math.max(0,G.cooldowns[i]-dt);G.energy[i]=Math.min(100,G.energy[i]+dt*2.1);\n  let inp=(autoplay||mode==='demo')?autoInput(i):inputs[i];\n  if(mode==='online'&&(net.server||i\"'!==net.localSeat))inp=remoteInputs[i]||{};\n  if(inp.angle!=null&&Number.isFinite(inp.angle))inputs[i].angle=clamp(inp.angle,.12,Math.PI-.12);\n  coast.guns[i].pivot.rotation.z=inputs[i].angle;\n  if(inp.fire)shoot(i);if(inp.salvo)salvo(i);\n }\n spawnClock-=dt;supplyClock-=dt;\n if(spawnClock<=0){spawnClock=tuning.spawn*(G.wave===2?1.8:1);const type=G.wave===0?(Math.random()<.2?'\"'heli':'plane'):G.wave===1?(Math.random()<.6?'boat':'plane'):(Math.random()<.4?'heli':'plane');spawn(type);}\n if(supplyClock<=0){spawn('supply');supplyClock=16;}\n updateEntities(dt);world.step(events);\n const collisions=[];events.drainCollisionEvents((a,b,started)=>{if(started)collisions.push([handles.get(a),handles.get(b)]);});\n for(const [a,b]of collisions){if(\"'!a?.alive||!b?.alive)continue;const shot=a.type==='\"'shot'?a:b.type==='shot'?b:null;const target=shot===a?b:a;if(shot&&target.type\"'!=='\"'shot'){remove(shot);damage(target,shot.special?2:1);}}\n G.comboTimer=Math.max(0,G.comboTimer-dt);if(\"'!G.comboTimer)G.combo=0;\n net.lastScore=G.score;net.tick(dt,inputs[net.localSeat]||{},snapshot());\n}\nfunction snapshot(){return {g:{...G,cooldowns:undefined},a:inputs.map(i=>i.angle),e:[...entities.values()].map(e=>[e.id,e.type,+e.x.toFixed(2),+e.y.toFixed(2),e.hp||0,e.side||1]),screen,mode:'\"'online',t:+simTime.toFixed(2)};}\nfunction applySnapshot(s){if(\"'!s?.g||!Array.isArray(s.e)||s.e.length>170)return;G={...G,...s.g};simTime=s.t||0;mode='\"'online';if(s.screen==='results'){finish(\"'!!G.won,G.won?'\"'HARBOR SECURED':'PIER OVERRUN',true);return;}if(\"'!['\"'playing','pause','dev'].includes(screen))setScreen('playing');\n coast.guns.forEach((g,i)=>{g.root.visible=true;g.pivot.rotation.z=s.a?.[i]??g.angle;});let seen=new Set();for(const d of s.e){const [id,type,x,y,hp,side]=d;seen.add(id);let r=remoteViews.get(id);if(\"'!r){r=type==='\"'shot'?coast.projectile(x,y):coast.makeTarget(type,side);remoteViews.set(id,r);if(type==='shot')sound.shot();}r.position.set(x,y,0);r.userData.mixer?.update(.1);}\n for(const [id,r]of remoteViews){if(\"'!seen.has(id)){if(r.position.y>1.5)coast.burst(r.position.x,r.position.y,'\"'#edb656',.6);coast.remove(r);remoteViews.delete(id);}}\n updateHUD();\n}\nfunction updateHUD(){if(\"'!G.energy)return;$('\"'score').textContent=String(G.score||0).padStart(6,'0');\"'$('\"'operation').textContent='0'+(G.wave+1)+' / 03';\"'$('\"'mission').textContent=stageNames[G.wave];\"'$('\"'objective').textContent=G.wave===2?'FLAGSHIP '+Math.max(0,G.bossHP)+' / '+G.bossMax:(G.waveKills||0)+' / '+(G.wave===0?'8 AIRCRAFT':'10 TARGETS');\n \"'$('\"'health').textContent='▰'.repeat(Math.max(0,Math.ceil(G.health)))+'▱'.repeat(Math.max(0,G.maxHealth-Math.ceil(G.health)));\"'$('\"'health').setAttribute('aria-label',G.health+' hull points');\n const energy=G.energy[net.isGuest?1:0]??0;\"'$('\"'energyFill').style.width=energy+'%';\"'$('\"'salvoText').textContent=energy>=99.8?'BROADSIDE READY':'BROADSIDE '+Math.floor(energy)+'%';\"'$('\"'salvoTouch').classList.toggle('ready',energy>=99.8);\"'$('\"'salvoTouch').textContent=energy>=99.8?'SALVO':'CHARGING';\"'$('\"'combo').textContent=G.combo>=2?G.combo+' CHAIN · '+Math.min(5,1+Math.floor(G.combo/4))+'×':'';\n \"'$('\"'wind').textContent=(wind()>0?'→':'←')+' '+Math.abs(wind()).toFixed(1);\"'$('\"'bossTrack').hidden=G.wave\"'!==2;$('\"'bossFill').style.width=Math.max(0,G.bossHP/G.bossMax*100)+'%';\"'$('\"'coopTag').textContent=mode==='coop'?'TWO GUNNERS':mode==='online'?'CONNECTED CO-OP':'PORT BATTERY';\n \"'$('\"'sync').hidden=\"'!net.active||net.running;if(!net.running)$('\"'sync').textContent='GUNNERS READY · '+Math.ceil(net.countdown);\n}\nfunction pause(){if(screen==='playing'&&mode\"'!=='\"'demo'){pointerDown=false;touchActive=false;inputs.forEach(i=>i.fire=false);setScreen('pause');sound.mute(true);}else if(['pause','dev'].includes(screen)){setScreen('playing');sound.mute(false);}}\nfunction focusables(){return [...document.querySelectorAll('.panel:not([hidden]) button,.panel:not([hidden]) input,.panel:not([hidden]) select,.panel:not([hidden]) textarea')].filter(e=>\"'!e.disabled&&e.offsetParent!==null);}\nfunction navigate(d){const a=focusables();if(!a.length)return;const current=a.indexOf(document.activeElement);navIndex=(Math.max(0,current)+d+a.length)%a.length;a[navIndex].focus({preventScroll:true});a[navIndex].scrollIntoView({block:'\"'nearest'});}\nfunction adjustFocused(d){const e=document.activeElement;if(e?.type==='range'){e.value=clamp(Number(e.value)+d*Number(e.step||1),Number(e.min),Number(e.max));e.dispatchEvent(new Event('input'));}else if(e?.tagName==='SELECT'){e.selectedIndex=(e.selectedIndex+d+e.options.length)%e.options.length;e.dispatchEvent(new Event('change'));}else navigate(d);}\nfunction menuBack(){if(['pause','dev'].includes(screen)){if(screen==='dev')setScreen('pause');else pause();}else if(screen==='settings'){setScreen(previous==='pause'?'pause':'title');sound.mute(previous==='pause');}else if(screen==='about'||screen==='howto')setScreen(previous==='pause'?'pause':'title');else if(screen==='online'){net.leave();title();}else if(screen==='results')title();}\nfunction pollInputs(dt){\n const pads=[...(navigator.getGamepads?.()||[])].filter(Boolean);\n for(let n=0;n<Math.min(2,pads.length);n++){const p=pads[n],prev=padPrevious[n]||[],pressed=i=>\"'!!p.buttons[i]?.pressed,edge=i=>pressed(i)&&!prev[i];const axis=p.axes||[];\n  const any=p.buttons.some(b=>b.pressed)||axis.some(v=>Math.abs(v)>.22);\n  if(any){const exit=activity('\"'gamepad');if(exit){padPrevious[n]=p.buttons.map(b=>b.pressed);continue;}}\n  if(screen==='playing'){\n   const seat=mode==='online'?net.localSeat:n;if(seat>=0&&seat<2){if(Math.hypot(axis[0]||0,axis[1]||0)>.25)inputs[seat].angle=clamp(Math.atan2(-(axis[1]||0),axis[0]||0),.12,Math.PI-.12);inputs[seat].fire=pressed(7)||pressed(0);inputs[seat].salvo=pressed(2);}\n   if(edge(9))pause();\n  }else if(any&&performance.now()>navAt){if(edge(0)){document.activeElement?.click();navAt=performance.now()+180;}else if(edge(1)||edge(9)){menuBack();navAt=performance.now()+180;}else if(pressed(13)||(axis[1]||0)>.55){navigate(1);navAt=performance.now()+220;}else if(pressed(12)||(axis[1]||0)<-.55){navigate(-1);navAt=performance.now()+220;}else if(pressed(15)||(axis[0]||0)>.55){adjustFocused(1);navAt=performance.now()+180;}else if(pressed(14)||(axis[0]||0)<-.55){adjustFocused(-1);navAt=performance.now()+180;}}\n  padPrevious[n]=p.buttons.map(b=>b.pressed);\n }\n if(screen\"'!=='\"'playing')return;\n const seat=mode==='online'?net.localSeat:0;if(seat<0)return;\n if(manualInput){Object.assign(inputs[seat],manualInput);return;}\n if(inputMode==='keyboard'){\n  if(mousePoint){const point=coast.pointer(mousePoint.x,mousePoint.y);inputs[seat].angle=aimAt(seat,point.x,Math.max(3.5,point.y));}\n  if(keys.has('KeyA')||keys.has('ArrowLeft')){mousePoint=null;inputs[seat].angle=clamp(inputs[seat].angle+dt*1.6,.12,Math.PI-.12);}\n  if(keys.has('KeyD')||keys.has('ArrowRight')){mousePoint=null;inputs[seat].angle=clamp(inputs[seat].angle-dt*1.6,.12,Math.PI-.12);}\n  inputs[seat].fire=pointerDown||keys.has('Space');inputs[seat].salvo=keys.has('KeyE');\n }\n if(inputMode==='touch'){inputs[seat].fire=touchActive;if(touchActive){if(touchAim){const v=coast.pointer(touchAim.x,touchAim.y);inputs[seat].angle=aimAt(seat,v.x,Math.max(4,v.y));}if(prefs.assist){const ai=autoInput(seat);inputs[seat].angle=ai.angle;}}}\n if(mode==='coop'&&\"'!pads[1]){if(keys.has('\"'KeyJ'))inputs[1].angle=clamp(inputs[1].angle+dt*1.6,.12,Math.PI-.12);if(keys.has('KeyL'))inputs[1].angle=clamp(inputs[1].angle-dt*1.6,.12,Math.PI-.12);inputs[1].fire=keys.has('Enter');inputs[1].salvo=keys.has('KeyU');}\n}\nfunction frame(dt){\n if(\"'!ready)return;dt=Math.min(dt,.1);idle+=dt;\n if(screen==='\"'title'&&idle>=10&&\"'!net.active)start('\"'demo');\n pollInputs(dt);\n if(screen==='playing'){let n=Math.max(1,Math.ceil(dt/(1/60)));for(let i=0;i<n;i++)step(dt/n);demoTime+=dt;if(mode==='demo'&&demoTime>110)start('demo');}\n else if(['title','settings','about','howto','online'].includes(screen)){for(const e of entities.values()){e.age+=dt;e.root.userData.mixer?.update(dt);e.root.position.y=e.baseY+Math.sin(e.age)*.16;}}\n if(screen==='playing'||screen==='title')coast.update(dt);else coast.update(0);\n const seat=net.isGuest?1:0;coast.drawAim(coast.guns[seat].x,3.2,inputs[seat]?.angle||1.1,tuning.speed,tuning.gravity,wind(),screen==='playing'&&mode\"'!=='\"'demo'&&inputMode\"'!=='\"'touch');\n shake=Math.max(0,shake-dt*1.8);toastTime-=dt;if(toastTime<=0)\"'$('\"'toast').classList.remove('show');bannerTime-=dt;if(bannerTime<=0)\"'$('\"'banner').classList.remove('show');\n sound.update(dt,screen==='playing'&&mode\"'!=='\"'demo',G.wave/2||0);if(screen==='playing')updateHUD();coast.render(shake);\n}\nfunction bindUI(){\n \"'$('\"'start').onclick=()=>{sound.unlock();start('solo');};\"'$('\"'coop').onclick=()=>{sound.unlock();start('coop');};\"'$('\"'online').onclick=()=>{previous='title';setScreen('online');};\n \"'$('\"'settings').onclick=()=>{previous='title';setScreen('settings');};\"'$('\"'about').onclick=()=>{previous='title';setScreen('about');};\"'$('\"'howto').onclick=()=>{previous='title';setScreen('howto');};\n \"'$('\"'pause').onclick=pause;\"'$('\"'resume').onclick=pause;\"'$('\"'dev').onclick=()=>setScreen('dev');\"'$('\"'pauseSettings').onclick=()=>{previous='pause';setScreen('settings');};\"'$('\"'pauseAbout').onclick=()=>{previous='pause';setScreen('about');};\"'$('\"'quit').onclick=()=>{net.leave();title();};\n \"'$('\"'retry').onclick=()=>start(mode==='online'?'solo':mode);\"'$('\"'resultMenu').onclick=()=>{net.leave();title();};\n for(const e of document.querySelectorAll('[data-back]'))e.onclick=menuBack;\n \"'$('\"'music').value=prefs.music*100;\"'$('\"'musicOut').textContent=Math.round(prefs.music*100)+'%';\"'$('\"'music').oninput=e=>{prefs.music=Number(e.target.value)/100;sound.setMusic(prefs.music);\"'$('\"'musicOut').textContent=e.target.value+'%';save();};\n \"'$('\"'sfx').value=prefs.sfx*100;\"'$('\"'sfxOut').textContent=Math.round(prefs.sfx*100)+'%';\"'$('\"'sfx').oninput=e=>{prefs.sfx=Number(e.target.value)/100;sound.setSfx(prefs.sfx);\"'$('\"'sfxOut').textContent=e.target.value+'%';sound.shot();save();};\n \"'$('\"'glyph').value=prefs.glyph;\"'$('\"'glyph').onchange=e=>{prefs.glyph=e.target.value;save();updatePrompts();};\"'$('\"'shake').checked=prefs.shake;\"'$('\"'shake').onchange=e=>{prefs.shake=e.target.checked;save();};\"'$('\"'assist').checked=prefs.assist;\"'$('\"'assist').onchange=e=>{prefs.assist=e.target.checked;save();};\n const names={speed:'Shell velocity',gravity:'Gravity',cooldown:'Shot interval',enemySpeed:'Target speed',spawn:'Spawn interval',damage:'Incoming damage',wind:'Wind strength',assist:'Hit forgiveness'};\n const ranges={speed:[20,40,.5],gravity:[6,20,.5],cooldown:[.08,.65,.01],enemySpeed:[.3,2.5,.1],spawn:[.5,3,.05],damage:[0,2,1],wind:[0,3,.1],assist:[0,2,.05]};\n for(const k of Object.keys(defaults)){const label=document.createElement('label');label.className='sliderRow';label.innerHTML=\"'`<span>${names[k]}</span><input id=\"tune-${k}\" type=\"range\" min=\"${ranges[k][0]}\" max=\"${ranges[k][1]}\" step=\"${ranges[k][2]}\" value=\"${defaults[k]}\"><output id=\"out-${k}\">${defaults[k]}</output>`;$('\"'sliders').append(label);\"'$('\"'tune-'+k).oninput=e=>{tuning[k]=Number(e.target.value);\"'$('\"'out-'+k).textContent=e.target.value;};}\n \"'$('\"'resetTuning').onclick=()=>{tuning={...defaults};for(const k in defaults){\"'$('\"'tune-'+k).value=defaults[k];\"'$('\"'out-'+k).textContent=defaults[k];}toast('DEFAULT BALANCE RESTORED');};\n \"'$('\"'devHeal').onclick=()=>{G.health=G.maxHealth;G.energy=[100,100];updateHUD();toast('BATTERY REPAIRED');};\"'$('\"'devWave').onclick=()=>{if(G.wave<2)nextWave();else{const b=[...entities.values()].find(e=>e.type==='boss');if(b)damage(b,100);}updateHUD();};\"'$('\"'devAI').onclick=()=>{autoplay=\"'!autoplay;$('\"'devAI').textContent='AUTOPILOT '+(autoplay?'ON':'OFF');};\n \"'$('\"'salvoTouch').onclick=e=>{e.stopPropagation();salvo(net.isGuest?1:0);};\n const busy=async(fn)=>{try{\"'$('\"'networkStatus').textContent='ESTABLISHING RADIO LINK…';await fn();}catch(e){\"'$('\"'networkStatus').textContent=e.message||'CONNECTION FAILED';}};\n \"'$('\"'hostLocal').onclick=()=>busy(async()=>{\"'$('\"'roomCode').value=net.hostLocal();});\"'$('\"'joinLocal').onclick=()=>busy(async()=>net.joinLocal(\"'$('\"'roomCode').value));\n \"'$('\"'createOffer').onclick=()=>busy(async()=>{\"'$('\"'signalOut').value=await net.hostRoom();\"'$('\"'networkStatus').textContent='Send your invitation. Paste the other gunner’s reply below, then Connect.';});\n \"'$('\"'joinOffer').onclick=()=>busy(async()=>{\"'$('\"'signalOut').value=await net.joinRoom(\"'$('\"'signalIn').value);\"'$('\"'networkStatus').textContent='Send this reply to the host. Your gun will join automatically.';});\n \"'$('\"'acceptAnswer').onclick=()=>busy(async()=>{await net.acceptAnswer(\"'$('\"'signalIn').value);});\n \"'$('\"'copySignal').onclick=async()=>{const e=\"'$('\"'signalOut');e.select();try{await navigator.clipboard.writeText(e.value);\"'$('\"'networkStatus').textContent='RADIO CODE COPIED';}catch{\"'$('\"'networkStatus').textContent='Code selected. Press Ctrl+C to copy.';}};\n document.addEventListener('pointerover',e=>{if(e.pointerType\"'!=='\"'touch'&&e.target.closest('button'))e.target.closest('button').focus({preventScroll:true});});\n document.addEventListener('pointermove',e=>{if(e.pointerType==='touch')return;activity('keyboard');if(screen==='playing')mousePoint={x:e.clientX,y:e.clientY};});\n document.addEventListener('pointerdown',e=>{if(activity(e.pointerType==='touch'?'touch':'keyboard')){e.preventDefault();e.stopPropagation();return;}sound.unlock();if(screen\"'!=='\"'playing'||e.target.closest('button,input,select,textarea,label'))return;if(e.pointerType==='touch'){touchActive=true;touchOrigin={x:e.clientX,y:e.clientY};touchAim={...touchOrigin};}else if(e.button===0){pointerDown=true;mousePoint={x:e.clientX,y:e.clientY};}} ,true);\n document.addEventListener('pointermove',e=>{if(e.pointerType==='touch'&&touchActive){touchAim={x:e.clientX,y:e.clientY};}});\n document.addEventListener('pointerup',e=>{if(e.pointerType==='touch')touchActive=false;else pointerDown=false;});document.addEventListener('pointercancel',()=>{touchActive=false;pointerDown=false;});\n document.addEventListener('contextmenu',e=>{e.preventDefault();if(screen==='playing')salvo(net.isGuest?1:0);});\n document.addEventListener('keydown',e=>{if(e.target.matches('input,textarea,select')&&\"'!['\"'Escape'].includes(e.code))return;if(activity('keyboard')){e.preventDefault();return;}sound.unlock();if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Enter'].includes(e.code))e.preventDefault();keys.add(e.code);if(e.repeat)return;if(e.code==='Escape'){if(screen==='playing')pause();else menuBack();}else if(screen\"'!=='\"'playing'){if(e.code==='ArrowDown')navigate(1);if(e.code==='ArrowUp')navigate(-1);if(e.code==='ArrowLeft')adjustFocused(-1);if(e.code==='ArrowRight')adjustFocused(1);if(e.code==='Enter'||e.code==='Space'){const a=focusables();if(\"'!a.includes(document.activeElement))a[0]?.focus();document.activeElement?.click();}}});\n document.addEventListener('\"'keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();pointerDown=false;touchActive=false;if(screen==='playing'&&mode\"'!=='\"'demo'&&\"'!net.online)pause();});window.addEventListener('\"'resize',()=>coast.resize());\n}\nasync function init(){try{\n \"'$('\"'loadText').textContent='PREPARING THE COAST…';await RAPIER.init();coast=new Coast(\"'$('\"'game'));await coast.init();resetPhysics();bindUI();updatePrompts();\n \"'$('\"'backend').textContent=coast.backend+' · THREE.JS r180 · RAPIER 0.19.3';await net.init();ready=true;\"'$('\"'loading').hidden=true;title();if(net.active){clearWorld();\"'$('\"'start').disabled=true;\"'$('\"'networkStatus').textContent='AI HUB · WAITING FOR THE WATCH';setScreen('online');}net.ready();\n window.__Sound=Sound;\n window.__game={state:()=>({ready,screen,mode,wave:G.wave||0,score:G.score||0,health:G.health||0,energy:G.energy,targets:[...entities.values()].filter(e=>e.type\"'!=='\"'shot').length,shots:[...entities.values()].filter(e=>e.type==='shot').length,shotsFired:G.shotsFired||0,hits:G.hits||0,kills:G.kills||0,physicsSteps,time:G.time||0,musicVolume:sound.stats.musicVolume,backend:coast.backend,inputMode,glyph:prefs.glyph,tuning:{...tuning},won:G.won||false,autoplay,net:{host:net.isHost,guest:net.isGuest,online:net.online,stats:net.stats}}),start,setInput:i=>manualInput=i,setAutoplay:v=>{autoplay=v;},advance:seconds=>{for(let t=0;t<seconds;t+=1/60)frame(Math.min(1/60,seconds-t));},dev:values=>{for(const [k,v]of Object.entries(values)){if(k==='health'){G.health=v;if(v<=0)finish(false);}else if(k==='wave'){while(G.wave<v&&G.wave<2)nextWave();}else if(k in tuning)tuning[k]=v;}},goto:setScreen,damage:hurt,sound,net,snapshot,entities:()=>[...entities.values()].map(e=>({type:e.type,x:e.x,y:e.y,hp:e.hp})),pause};\n let last=performance.now();const loop=now=>{const dt=(now-last)/1000;last=now;frame(dt);requestAnimationFrame(loop);};requestAnimationFrame(loop);\n}catch(e){console.error(e);\"'$('\"'loadText').textContent='THE RADIO LOST ITS SIGNAL';\"'$('\"'loadDetail').textContent=e.message+' · Check the connection, then reload. CDN libraries require internet on first load.';net.fail(e.message);}}\ninit();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"agent_message","text":"The coastal scene and combat systems are in place: animated aircraft and boats, Rapier shells, interceptable bombs, supply drops, combos, and a seven-shell broadside. The networking module supports AI Hub co-op, two-window rooms, and direct invitation/reply connections. I’m now wiring the menus and testing the full mission loop.\n"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/template.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<script>__HUB__</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#102f3e\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:players\" content=\"1-2\"><meta name=\"hub:mode\" content=\"shared-world\"><meta name=\"hub:goal\" content=\"Defend the pier and sink the Admiral. Both gunners share a score.\"><meta name=\"hub:howto\" content=\"Left stick aims, R2 fires, Square fires a broadside. Mouse aims, hold click fires, E broadside.\"><meta name=\"hub:minutes\" content=\"3\">\n<title>Pier Pressure · Coastal Artillery Club</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='\"'http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23102c3b'/%3E%3Cpath d='M15 48L29 14H40L27 48Z' fill='%23ffcf5d'/%3E%3Cpath d='M11 48H53V55H11Z' fill='%23ed7750'/%3E%3C/svg%3E\\\">\n<style>\n:root{--ink:#102f3e;--paper:#f4e8c9;--yellow:#ffce5d;--coral:#e96949;--teal:#459e98;--muted:#637371;font-family:Arial,Helvetica,sans-serif;color:var(--ink);font-synthesis:none;color-scheme:light}*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden}body{background:#f0dfbb;user-select:none;-webkit-user-select:none;touch-action:none}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}button,input,select,textarea{outline-offset:5px}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:4px solid var(--coral)}button:disabled{opacity:.5;cursor:wait}button{transition:background .15s,transform .15s,box-shadow .15s}button:hover,button:focus-visible{transform:translateY(-2px)}[hidden]{display:none\"'!important}#game{display:block;width:100%;height:100%;position:absolute;inset:0}body:after{content:'\"'';pointer-events:none;position:fixed;inset:0;opacity:.045;z-index:30;background-image:url(\\\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' opacity='.7' filter='url(%23n)'/%3E%3C/svg%3E\\\")}#screen{position:fixed;inset:0;pointer-events:none;z-index:3}.panel{pointer-events:auto;position:absolute}.eyebrow{font-size:clamp(12px,1.2vw,19px);font-weight:800;letter-spacing:.2em;text-transform:uppercase}.tiny{font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:bold}.muted{color:var(--muted)}.titlePanel{inset:0;padding:5.5vh 5vw;background:linear-gradient(90deg,#f4e8c9 0%,#f4e8c9f7 29%,#f4e8c9b8 45%,#f4e8c900 66%);display:flex;flex-direction:column;align-items:flex-start}.club{display:flex;align-items:center;gap:15px}.club .mark{width:42px;height:42px;background:var(--ink);color:var(--paper);display:grid;place-items:center;font-size:28px;transform:rotate(-7deg)}h1{font-family:Impact,'Arial Black',Arial,sans-serif;font-weight:900;font-size:clamp(75px,10vw,164px);line-height:.84;letter-spacing:-.025em;margin:6vh 0 1.6vh;position:relative}h1 span{display:block}h1 .outline{color:var(--coral);-webkit-text-stroke:1px var(--ink);text-shadow:5px 5px 0 var(--ink)}.titleSub{font-size:clamp(17px,1.6vw,26px);line-height:1.5;max-width:460px;margin:1.5vh 0 3vh}.titleSub strong{font-weight:800}.titleActions{display:flex;flex-wrap:wrap;gap:12px;max-width:600px}.primary,.secondary,.navBtn{padding:17px 24px;font-weight:900;letter-spacing:.05em;font-size:clamp(16px,1.35vw,22px);text-transform:uppercase;border:2px solid var(--ink);background:var(--yellow);color:var(--ink);box-shadow:4px 4px 0 var(--ink);min-height:56px}.primary:hover,.primary:focus-visible{background:#ffe195;box-shadow:5px 7px 0 var(--ink)}.secondary{background:var(--paper);box-shadow:3px 3px 0 var(--ink)}.secondary:hover,.secondary:focus-visible{background:#fff5d9}.titleLinks{display:flex;gap:24px;margin-top:23px}.textBtn{background:transparent;color:var(--ink);font-size:clamp(14px,1.1vw,18px);font-weight:800;padding:10px 0;border-bottom:2px solid transparent}.textBtn:hover,.textBtn:focus-visible{border-bottom-color:var(--ink)}.key{display:inline-flex;align-items:center;justify-content:center;min-width:25px;min-height:25px;padding:2px 6px;border:1.5px solid currentColor;border-radius:4px;font-size:.8em;margin-right:8px;vertical-align:2px}.titleFooter{margin-top:auto;font-size:clamp(11px,.95vw,15px);font-weight:bold;letter-spacing:.14em;line-height:1.9}.seal{position:absolute;right:5vw;top:6vh;width:145px;height:145px;border:2px solid var(--ink);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;transform:rotate(12deg);background:#f4e8c950;letter-spacing:.12em;gap:8px;font-weight:900;font-size:12px}.seal b{font-family:Impact,Arial,sans-serif;font-size:45px;letter-spacing:.04em}.titleCaption{position:absolute;right:4.5vw;bottom:7vh;font-weight:800;letter-spacing:.14em;font-size:12px;display:flex;align-items:center;gap:12px}.titleCaption:before{content:'';width:40px;height:2px;background:var(--ink)}\n.menuPanel{inset:0;background:#f2e6c8f2;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:5vh 6vw}.menuInner{width:min(900px,90vw);max-height:91vh;overflow:auto;padding:8px 10px 18px;scrollbar-color:var(--ink) transparent;touch-action:pan-y}.menuInner.wide{width:min(1180px,93vw)}h2{font-family:Impact,'Arial Black',Arial,sans-serif;font-size:clamp(42px,6vw,83px);line-height:1;letter-spacing:.01em;margin:14px 0 24px}h3{font-size:clamp(19px,1.65vw,27px);font-weight:900;margin:0 0 12px}.menuStack{display:grid;gap:14px;max-width:510px}.menuStack button{text-align:left}.menuButtons{display:flex;gap:16px;flex-wrap:wrap;margin-top:26px}.panel p{line-height:1.6;font-size:clamp(16px,1.45vw,22px)}.back{margin-top:28px}.settingsRows{border-top:2px solid var(--ink)}.sliderRow{display:flex;align-items:center;gap:26px;padding:18px 0;border-bottom:1px solid #102f3e33;font-size:clamp(17px,1.55vw,25px);font-weight:bold}.sliderRow span{flex:1;min-width:150px}.sliderRow input[type=range]{width:40%;accent-color:var(--coral);height:30px}.sliderRow output{width:70px;text-align:right;font-variant-numeric:tabular-nums}.sliderRow select{background:var(--paper);padding:12px;border:2px solid var(--ink);font-weight:bold}.sliderRow input[type=checkbox]{width:29px;height:29px;accent-color:var(--coral)}.devPanel .menuInner{max-height:92vh}.devPanel h2{font-size:54px;margin-bottom:10px}.devPanel .sliderRow{padding:10px 0;font-size:18px}.devPanel p{margin:0 0 14px;font-size:16px}.devPanel .secondary{font-size:15px;padding:13px}.instructions{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.instruction{border-top:5px solid var(--ink);padding-top:20px}.instruction .n{font-size:46px;font-family:Impact,Arial,sans-serif;color:var(--coral);margin-bottom:12px}.instruction p{font-size:18px}.instructions b{background:var(--yellow);padding:2px 5px}.infoNote{border-left:5px solid var(--coral);padding-left:20px;margin-top:25px}.resultPanel{text-align:center}.resultPanel .eyebrow{color:#b34931}.resultPanel h2{font-size:clamp(40px,5.8vw,86px)}.resultPanel .menuButtons{justify-content:center}.finalScore{font-family:Impact,Arial,sans-serif;font-size:clamp(70px,10vw,140px);line-height:1;color:var(--ink)}#medal{display:inline-block;font-weight:900;letter-spacing:.13em;padding:13px 20px;background:var(--yellow);border:2px solid var(--ink);margin:15px 0 22px;transform:rotate(-2deg)}#resultStats{display:flex;justify-content:center;gap:40px;font-size:13px;letter-spacing:.1em;font-weight:bold;margin:15px 0 25px}#resultStats b{display:block;font-size:32px;margin-bottom:8px}.onlineGrid{display:grid;grid-template-columns:1fr 1fr;gap:35px}.onlineGrid section{border-top:3px solid var(--ink);padding-top:18px}.onlineGrid p{font-size:16px;min-height:50px}.onlineGrid .secondary{padding:12px;font-size:15px;min-height:46px}.onlineGrid .menuButtons{gap:10px;margin:12px 0}.onlineGrid input,.onlineGrid textarea{border:2px solid var(--ink);background:#fff4d8;color:var(--ink);padding:14px;font-size:16px;width:100%;user-select:text;touch-action:pan-y}.onlineGrid input{letter-spacing:.15em;text-transform:uppercase;font-weight:800}.onlineGrid textarea{height:80px;resize:vertical}.onlineGrid label{display:block;font-weight:bold;font-size:13px;letter-spacing:.1em;margin:15px 0 7px}#networkStatus{background:var(--ink);color:var(--paper);padding:16px 22px;font-size:16px;line-height:1.5;margin:20px 0}.creditsGrid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.creditsGrid h3{border-top:3px solid var(--ink);padding-top:18px;font-size:23px}.creditsGrid p,.creditsGrid dl{font-size:15px;line-height:1.6}.creditsGrid dt{font-weight:900;float:left;clear:left;margin-right:7px}.creditsGrid dd{margin:0 0 7px}.creditsGrid .qa{margin-bottom:19px}.creditsGrid .qa strong{display:block}.creditsIntro{font-size:18px\"'!important;max-width:850px}.creditsGrid a{color:var(--ink)}\n#hud{position:fixed;inset:0;pointer-events:none;z-index:4;color:var(--ink)}.hudTop{position:absolute;top:3.2vh;left:3.6vw;right:3.6vw;display:grid;grid-template-columns:1fr 1.3fr 1fr;gap:25px;align-items:start}.hudBrand{font-family:Impact,Arial,sans-serif;font-size:clamp(20px,2.7vw,43px);letter-spacing:.02em}.hudHealth{font-size:clamp(22px,2.2vw,35px);letter-spacing:3px;color:var(--coral);line-height:1.3}.hudMission{text-align:center;background:var(--ink);color:var(--paper);padding:12px 25px;border-bottom:5px solid var(--yellow);box-shadow:4px 4px 0 #102f3e38}.hudMission .tiny{font-size:11px;letter-spacing:.18em;color:var(--yellow)}#mission{font-family:Impact,Arial,sans-serif;font-size:clamp(23px,2.6vw,38px);letter-spacing:.04em;margin:5px 0}#objective{font-size:12px;font-weight:bold;letter-spacing:.1em}.hudScore{text-align:right;padding-right:56px}.scoreNum{font-size:clamp(27px,3.6vw,53px);font-weight:900;font-variant-numeric:tabular-nums;letter-spacing:-.03em;line-height:1.1}.hudScore .tiny{font-size:11px}#combo{font-weight:900;font-size:14px;margin-top:7px;color:#c35c3f}.hudBottom{position:absolute;bottom:3.4vh;left:3.6vw;right:3.6vw;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.salvoHUD{background:var(--ink);color:var(--paper);padding:15px 19px;min-width:250px;border-left:5px solid var(--coral)}.salvoTitle{font-weight:900;font-size:14px;letter-spacing:.06em}.energyTrack{height:5px;background:#4d686e;margin-top:10px}.energyTrack span{height:100%;display:block;background:var(--yellow);transition:width .12s}.controls{color:var(--paper);background:#102f3ee6;padding:15px 20px;font-size:13px;display:flex;gap:15px;align-items:center}.controls b{color:var(--yellow);margin-right:5px}.windHUD{background:var(--paper);border:2px solid var(--ink);padding:10px 15px;font-size:11px;letter-spacing:.1em;font-weight:bold}#wind{font-size:21px;margin-left:10px}.pauseBtn{position:fixed;right:3.4vw;top:3.3vh;z-index:7;pointer-events:auto;background:var(--paper);color:var(--ink);border:2px solid var(--ink);font-size:22px;width:45px;height:45px;display:grid;place-items:center}.bossTrack{height:9px;background:#476068;margin:11px -8px 0}.bossTrack span{height:100%;display:block;background:var(--coral);transition:width .2s}#banner{position:fixed;left:50%;top:34%;transform:translate(-50%,-20%);text-align:center;pointer-events:none;z-index:5;opacity:0;transition:opacity .25s,transform .3s;width:min(850px,90vw);color:var(--ink)}#banner.show{opacity:1;transform:translate(-50%,0)}#bannerKicker{font-size:12px;font-weight:900;letter-spacing:.25em;margin-bottom:10px}#bannerTitle{font-family:Impact,Arial,sans-serif;font-size:clamp(36px,5vw,74px);letter-spacing:.03em;text-shadow:2px 2px 0 var(--paper),-2px -2px 0 var(--paper)}#bannerSub{display:inline-block;font-size:17px;font-weight:bold;background:var(--paper);padding:10px 19px;border-bottom:3px solid var(--coral);margin-top:14px}#toast{position:fixed;left:50%;bottom:17vh;transform:translate(-50%,15px);opacity:0;transition:.2s;z-index:8;background:var(--yellow);color:var(--ink);border:2px solid var(--ink);padding:12px 24px;font-weight:900;font-size:16px;pointer-events:none;white-space:nowrap}#toast.show{opacity:1;transform:translate(-50%,0)}#attract{position:fixed;z-index:6;left:50%;bottom:15vh;transform:translateX(-50%);text-align:center;pointer-events:none;background:var(--paper);border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink);padding:16px 28px;min-width:350px}#attract strong{display:block;font-size:20px;font-weight:900;letter-spacing:.12em;margin-bottom:7px}#attract span{font-size:14px}#sync{position:fixed;left:50%;top:25%;transform:translateX(-50%);background:var(--ink);color:var(--yellow);padding:18px;font-size:22px;font-weight:900}#damageFlash{position:fixed;inset:0;pointer-events:none;z-index:2}#damageFlash.flash{animation:damage .4s ease-out}@keyframes damage{0%{box-shadow:inset 0 0 130px #dd533baa}100%{box-shadow:inset 0 0 0 #dd533b00}}#salvoTouch{position:fixed;right:5vw;bottom:7vh;border-radius:50%;width:90px;height:90px;background:#102f3e90;color:var(--paper);border:3px solid var(--paper);z-index:8;font-weight:900;font-size:12px;pointer-events:auto}#salvoTouch.ready{background:var(--yellow);color:var(--ink);border-color:var(--ink);box-shadow:0 0 0 6px #ffce5d33}.touch .controls,.touch .salvoHUD,.touch .windHUD{display:none}.touch .hudTop{grid-template-columns:1fr 1fr}.touch .hudMission{order:3;grid-column:1/3;justify-self:center;min-width:200px;padding:7px 15px}.touch .hudBrand{font-size:20px}.touch .hudHealth{font-size:18px}.touch #mission{font-size:20px}.touch .hudScore{padding-right:50px}.touch .scoreNum{font-size:27px}.touch #objective{font-size:10px}.touch #coopTag{display:none}#loading{position:fixed;inset:0;background:var(--paper);display:flex;align-items:center;justify-content:center;flex-direction:column;z-index:50;padding:30px;text-align:center}.loadingMark{font-size:70px;color:var(--coral);margin-bottom:25px;animation:bob 1s ease-in-out infinite alternate}#loadText{font-weight:900;letter-spacing:.1em;font-size:22px}#loadDetail{font-size:15px;max-width:650px;line-height:1.6;margin-top:18px}@keyframes bob{to{transform:translateY(-8px) rotate(5deg)}}\n@media(min-width:1700px){.titleActions{max-width:700px}.titleLinks{gap:35px}.primary,.secondary{padding:20px 30px}.controls{font-size:17px}.salvoHUD{min-width:320px}.salvoTitle{font-size:18px}.windHUD{font-size:14px}.tiny{font-size:16px}}\n@media(max-height:700px) and (min-width:800px){.titlePanel{padding-top:4vh}h1{font-size:15.6vh;margin-top:4vh}.titleSub{font-size:17px;margin:2vh 0}.primary,.secondary{min-height:47px;padding:12px 18px;font-size:16px}.titleLinks{margin-top:10px}.titleFooter{font-size:10px}.menuPanel{padding:2vh 5vw}.menuInner{max-height:95vh}h2{font-size:48px;margin:12px 0 17px}.sliderRow{padding:10px 0;font-size:18px}.back{margin-top:15px}.menuStack{gap:10px}.seal{width:105px;height:105px;font-size:9px}.seal b{font-size:33px}.hudTop{top:3vh}.controls{font-size:11px;padding:12px}.salvoHUD{padding:10px 14px;min-width:210px}}\n@media(max-width:700px){.titlePanel{padding:5vh 7vw;background:linear-gradient(90deg,#f4e8c9ed,#f4e8c9a6 80%,#f4e8c92b)}h1{font-size:23vw;margin-top:7vh}.eyebrow{font-size:11px}.club .mark{width:32px;height:32px;font-size:22px}.titleSub{font-size:16px;margin:3vh 0 3vh;max-width:300px}.titleActions{gap:12px}.primary,.secondary{font-size:14px;min-height:48px;padding:13px 15px}.titleLinks{gap:22px;margin-top:18px}.textBtn{font-size:13px}.titleFooter{font-size:10px;max-width:260px;margin-top:auto}.seal{right:5vw;top:5vh;width:83px;height:83px;font-size:7px;gap:4px}.seal b{font-size:28px}.titleCaption{display:none}.menuPanel{padding:3vh 4vw}.menuInner{width:93vw;max-height:94vh}h2{font-size:45px;margin:12px 0 23px}.menuInner p{font-size:16px}.sliderRow{font-size:16px;gap:12px;padding:15px 0}.sliderRow span{min-width:100px}.sliderRow input[type=range]{width:36%}.sliderRow output{width:40px}.sliderRow select{padding:8px;font-size:14px}.instructions{grid-template-columns:1fr;gap:14px}.instruction{padding-top:10px;display:grid;grid-template-columns:45px 1fr;gap:5px 15px}.instruction .n{font-size:33px;grid-row:1/3}.instruction h3{font-size:18px;margin-bottom:0}.instruction p{font-size:14px;margin:0}.infoNote{margin-top:20px;padding-left:13px}.onlineGrid,.creditsGrid{grid-template-columns:1fr;gap:20px}.onlineGrid p{min-height:auto}.creditsGrid h3{font-size:21px}.creditsGrid p,.creditsGrid dl{font-size:14px}.devPanel h2{font-size:35px}.devPanel .sliderRow{font-size:15px;gap:10px;padding:10px 0}.devPanel .secondary{font-size:12px;padding:10px}.devPanel .menuButtons{gap:10px;margin-top:15px}.resultPanel h2{font-size:43px}.finalScore{font-size:90px}#resultStats{gap:20px;font-size:10px}#resultStats b{font-size:27px}#medal{font-size:12px}.hudTop{left:4vw;right:4vw;gap:10px}.hudBrand{font-size:20px}.hudHealth{font-size:17px;letter-spacing:1px}.hudMission{padding:8px 10px}#mission{font-size:19px}.hudMission .tiny{font-size:8px}#objective{font-size:9px}.scoreNum{font-size:24px}.hudScore{padding-right:0}.hudScore .tiny{font-size:8px}#combo{font-size:10px}#coopTag{font-size:8px}.pauseBtn{top:auto;bottom:3vh;right:4vw}.hudBottom{bottom:3vh;left:4vw;right:calc(4vw + 60px)}.controls{display:none}.salvoHUD{min-width:150px;padding:10px 12px}.salvoTitle{font-size:10px}.windHUD{font-size:8px;padding:8px}#wind{font-size:16px;margin-left:5px}#banner{top:33%}#bannerTitle{font-size:40px}#bannerSub{font-size:13px;max-width:90vw}#bannerKicker{font-size:10px}#toast{font-size:12px;max-width:90vw;white-space:normal;text-align:center;padding:10px 16px}#attract{bottom:16vh;min-width:0;width:84vw;padding:14px}#attract strong{font-size:15px}#attract span{font-size:12px}.touch .hudScore{padding-right:0}.touch .pauseBtn{top:auto;bottom:3vh}.touch #salvoTouch{bottom:10vh;width:76px;height:76px;font-size:10px}.touch .hudTop{grid-template-columns:1fr 1fr}.touch .hudMission{margin-top:0}.touch .hudMission .tiny{display:none}}\n</style>\n<script type=\"importmap\">__IMPORTMAP__</script>\n</head><body data-screen=\"loading\">\n<canvas id=\"game\" aria-label=\"Pier Pressure coastal artillery game\"></canvas><div id=\"damageFlash\"></div>\n<div id=\"screen\" data-screen=\"loading\">\n <section class=\"panel titlePanel\" data-panel=\"title\" hidden>\n  <div class=\"club\"><span class=\"mark\">⚓</span><div class=\"eyebrow\">The Coastal<br>Artillery Club</div></div>\n  <h1>PIER<span class=\"outline\">PRESSURE</span></h1>\n  <p class=\"titleSub\">A little flak. A lot of splash.<br><strong>Hold the coast. Make every shot count.</strong></p>\n  <div class=\"titleActions\"><button class=\"primary\" id=\"start\"><span class=\"key\" data-prompt=\"confirm\">ENTER</span>Take command</button><button class=\"secondary\" id=\"coop\">Two gunners</button></div>\n  <div class=\"titleLinks\"><button class=\"textBtn\" id=\"online\">Play online ↗</button><button class=\"textBtn\" id=\"howto\">Field manual</button><button class=\"textBtn\" id=\"settings\">Settings</button><button class=\"textBtn\" id=\"about\">About</button></div>\n  <div class=\"titleFooter\">01—03 / A COMPLETE COASTAL CAMPAIGN<br>1–2 GUNNERS · NO QUARTERS REQUIRED</div>\n  <div class=\"seal\"><span>INSPIRED BY</span><b>1977</b><span>AIR · SEA · BATTLE</span></div>\n  <div class=\"titleCaption\">CALM SEAS. QUESTIONABLE COMPANY.</div>\n </section>\n <section class=\"panel menuPanel\" data-panel=\"pause\" hidden><div class=\"menuInner\"><div class=\"eyebrow\">A moment of shore leave</div><h2>HOLD FIRE.</h2><div class=\"menuStack\"><button class=\"primary\" id=\"resume\"><span class=\"key\" data-prompt=\"confirm\">ENTER</span>Back to the battery</button><button class=\"secondary\" id=\"pauseSettings\">Settings</button><button class=\"secondary\" id=\"dev\">Developer tools</button><button class=\"secondary\" id=\"pauseAbout\">About / Credits</button><button class=\"secondary\" id=\"quit\">Return to title</button></div><p class=\"muted\">The local battery is paused. An online crew keeps its watch.</p></div></section>\n <section class=\"panel menuPanel\" data-panel=\"settings\" hidden><div class=\"menuInner\"><div class=\"eyebrow\">Set your bearings</div><h2>SETTINGS</h2><div class=\"settingsRows\"><label class=\"sliderRow\"><span>Music</span><input type=\"range\" id=\"music\" min=\"0\" max=\"100\" step=\"5\" value=\"10\"><output id=\"musicOut\">10%</output></label><label class=\"sliderRow\"><span>Sound effects & voices</span><input type=\"range\" id=\"sfx\" min=\"0\" max=\"100\" step=\"5\" value=\"65\"><output id=\"sfxOut\">65%</output></label><label class=\"sliderRow\"><span>Controller glyphs</span><select id=\"glyph\"><option value=\"ps\">PlayStation · ✕ ○ □ △</option><option value=\"xbox\">Xbox · A B X Y</option></select></label><label class=\"sliderRow\"><span>Camera shake</span><input type=\"checkbox\" id=\"shake\" checked></label><label class=\"sliderRow\"><span>Touch aiming assist</span><input type=\"checkbox\" id=\"assist\" checked></label></div><button class=\"secondary back\" data-back><span class=\"key\" data-prompt=\"back\">ESC</span>Back</button></div></section>\n <section class=\"panel menuPanel\" data-panel=\"howto\" hidden><div class=\"menuInner wide\"><div class=\"eyebrow\">Field manual / edition 01</div><h2>THE SHORE THING.</h2><div class=\"instructions\"><div class=\"instruction\"><div class=\"n\">01</div><h3>LEAD YOUR SHOT</h3><p>Aim with <b>left stick</b> or <b>mouse</b>. Hold <b>R2 / click / Space</b> to fire. Shells arc; moving targets won'\"'t wait.</p></div><div class=\\\"instruction\\\"><div class=\\\"n\\\">02</div><h3>MIND THE PIER</h3><p>Red bombs cost hull. Shoot them out of the sky. Green supply crates restore hull and charge your broadside.</p></div><div class=\\\"instruction\\\"><div class=\\\"n\\\">03</div><h3>MAKE A SPLASH</h3><p><b>□ / E / right click</b> fires seven shells and clears bombs. Charge returns with time and hits. Chain kills for up to 5× score.</p></div></div><p class=\\\"infoNote\\\">Clear 8 aircraft, stop 10 convoy targets, then sink <strong>the Admiral</strong>. The battery gets two repairs between operations. Seven hull points. One coast.</p><p class=\\\"muted\\\">Two gunners: two controllers, or player 1 uses mouse / A D / Space / E while player 2 uses J L / Enter / U. Touch: hold the sea or sky to aim and fire automatically; tap SALVO when ready.</p><button class=\\\"secondary back\\\" data-back><span class=\\\"key\\\" data-prompt=\\\"back\\\">ESC</span>Back</button></div></section>\n <section class=\\\"panel menuPanel devPanel\\\" data-panel=\\\"dev\\\" hidden><div class=\\\"menuInner\\\"><div class=\\\"eyebrow\\\">Coastal proving ground</div><h2>DEVELOPER TOOLS</h2><p>Changes apply live. Autopilot leads shots and protects the pier.</p><div id=\\\"sliders\\\"></div><div class=\\\"menuButtons\\\"><button class=\\\"secondary\\\" id=\\\"resetTuning\\\">Reset defaults</button><button class=\\\"secondary\\\" id=\\\"devHeal\\\">Repair & recharge</button><button class=\\\"secondary\\\" id=\\\"devWave\\\">Next operation</button><button class=\\\"secondary\\\" id=\\\"devAI\\\">Autopilot off</button></div><button class=\\\"secondary back\\\" data-back>Back to pause</button></div></section>\n <section class=\\\"panel menuPanel resultPanel\\\" data-panel=\\\"results\\\" hidden><div class=\\\"menuInner\\\"><div class=\\\"eyebrow\\\" id=\\\"resultKicker\\\">MISSION COMPLETE</div><h2 id=\\\"resultTitle\\\">HARBOR SECURED</h2><div id=\\\"medal\\\">GOLD ANCHOR</div><div class=\\\"tiny\\\">TOTAL SCORE</div><div class=\\\"finalScore\\\" id=\\\"finalScore\\\">000000</div><div id=\\\"resultStats\\\"></div><div class=\\\"tiny\\\">PERSONAL BEST <span id=\\\"best\\\">000000</span></div><div class=\\\"menuButtons\\\"><button class=\\\"primary\\\" id=\\\"retry\\\">Another watch</button><button class=\\\"secondary\\\" id=\\\"resultMenu\\\">Return to title</button></div></div></section>\n <section class=\\\"panel menuPanel\\\" data-panel=\\\"online\\\" hidden><div class=\\\"menuInner wide\\\"><div class=\\\"eyebrow\\\">Two guns. One coast.</div><h2>RADIO ROOM</h2><div id=\\\"networkStatus\\\">Choose a connection. Co-op shares hull, operations and score.</div><div class=\\\"onlineGrid\\\"><section><h3>ON THIS COMPUTER</h3><p>Open the game in two windows on the same site. Create a room, then enter its code in the other window.</p><label for=\\\"roomCode\\\">ROOM CODE</label><input id=\\\"roomCode\\\" placeholder=\\\"6-letter code\\\" maxlength=\\\"24\\\" autocomplete=\\\"off\\\"><div class=\\\"menuButtons\\\"><button class=\\\"secondary\\\" id=\\\"hostLocal\\\">Create room</button><button class=\\\"secondary\\\" id=\\\"joinLocal\\\">Join room</button></div><p class=\\\"muted\\\">For side-by-side play on one screen, use Two Gunners from the title.</p></section><section><h3>DIRECT CONNECTION</h3><p>Host sends an invitation. Guest pastes it and sends a reply. Host pastes the reply and connects.</p><label for=\\\"signalIn\\\">PASTE INVITATION OR REPLY</label><textarea id=\\\"signalIn\\\" placeholder=\\\"Paste the other gunner’s radio code\\\"></textarea><div class=\\\"menuButtons\\\"><button class=\\\"secondary\\\" id=\\\"createOffer\\\">1 · Host</button><button class=\\\"secondary\\\" id=\\\"joinOffer\\\">2 · Join</button><button class=\\\"secondary\\\" id=\\\"acceptAnswer\\\">3 · Connect</button></div><label for=\\\"signalOut\\\">YOUR OUTGOING CODE</label><textarea id=\\\"signalOut\\\" readonly placeholder=\\\"Your outgoing radio code appears here\\\"></textarea><button class=\\\"textBtn\\\" id=\\\"copySignal\\\">Copy outgoing code</button></section></div><p class=\\\"muted\\\">AI Hub connects gunners automatically. Direct play uses WebRTC; networks that require a relay may prevent a connection.</p><button class=\\\"secondary back\\\" data-back><span class=\\\"key\\\" data-prompt=\\\"back\\\">ESC</span>Back</button></div></section>\n <section class=\\\"panel menuPanel\\\" data-panel=\\\"about\\\" hidden><div class=\\\"menuInner wide\\\"><div class=\\\"eyebrow\\\">The Coastal Artillery Club presents</div><h2>PIER PRESSURE</h2><p class=\\\"creditsIntro\\\">A small salute to the angle-and-timing arcade battles of 1977. All geometry, animation, music, sound effects and nonsense radio chatter are generated in code.</p><div class=\\\"creditsGrid\\\" id=\\\"credits\\\">__CREDITS__</div><p class=\\\"tiny\\\" id=\\\"backend\\\">THREE.JS r180 · RAPIER 0.19.3</p><button class=\\\"secondary back\\\" data-back><span class=\\\"key\\\" data-prompt=\\\"back\\\">ESC</span>Back</button></div></section>\n</div>\n<div id=\\\"hud\\\" hidden><div class=\\\"hudTop\\\"><div><div class=\\\"hudBrand\\\">PIER PRESSURE</div><div class=\\\"hudHealth\\\" id=\\\"health\\\" aria-label=\\\"7 hull points\\\">▰▰▰▰▰▰▰</div><div class=\\\"tiny\\\" id=\\\"coopTag\\\">PORT BATTERY</div></div><div class=\\\"hudMission\\\"><div class=\\\"tiny\\\">OPERATION <span id=\\\"operation\\\">01 / 03</span></div><div id=\\\"mission\\\">SKY PATROL</div><div id=\\\"objective\\\">0 / 8 AIRCRAFT</div><div class=\\\"bossTrack\\\" id=\\\"bossTrack\\\" hidden><span id=\\\"bossFill\\\"></span></div></div><div class=\\\"hudScore\\\"><div class=\\\"tiny\\\">COASTAL SCORE</div><div class=\\\"scoreNum\\\" id=\\\"score\\\">000000</div><div id=\\\"combo\\\"></div></div></div><div class=\\\"hudBottom\\\"><div class=\\\"salvoHUD\\\"><div class=\\\"salvoTitle\\\"><span class=\\\"key\\\" data-prompt=\\\"salvo\\\">E</span><span id=\\\"salvoText\\\">BROADSIDE READY</span></div><div class=\\\"energyTrack\\\"><span id=\\\"energyFill\\\" style=\\\"width:100%\\\"></span></div></div><div class=\\\"controls\\\" id=\\\"controlLine\\\"></div><div class=\\\"windHUD\\\">WIND <span id=\\\"wind\\\">→ 0.4</span></div></div><div id=\\\"sync\\\" hidden></div></div>\n<button class=\\\"pauseBtn\\\" id=\\\"pause\\\" aria-label=\\\"Pause\\\" hidden>Ⅱ</button><button id=\\\"salvoTouch\\\" hidden>SALVO</button>\n<div id=\\\"banner\\\"><div id=\\\"bannerKicker\\\"></div><div id=\\\"bannerTitle\\\"></div><div id=\\\"bannerSub\\\"></div></div><div id=\\\"toast\\\" role=\\\"status\\\"></div>\n<div id=\\\"attract\\\" hidden><strong>DEMONSTRATION</strong><span>Press any button to take command.</span></div>\n<div id=\\\"loading\\\"><div class=\\\"loadingMark\\\">⚓</div><div id=\\\"loadText\\\">TUNING THE RADIO…</div><div id=\\\"loadDetail\\\">Procedural coast. Fresh ammunition. No quarters required.</div></div>\n<script type=\\\"module\\\">__MODULE__</script>\n</body></html>\nEOF\ncat > Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/build.py <<'EOF'\nfrom pathlib import Path\nimport json, html\np=Path(__file__).parent\nroot=p.parent\ninfo=json.loads((root/'exit-interview.json').read_text()) if (root/'exit-interview.json').exists() else {'sourceInformation':json.loads((p/'credits.json').read_text()),'testingFeedback':['Testing in progress.'],'engineFeedback':['Testing in progress.'],'promptFeedback':['Testing in progress.']}\nqtests=['Issues caught','Critical issues','Most helpful test','Least helpful test']\nqengine=['What worked well','Where we got stuck','Built for this game','Hardest engine work','Engine changes','One engine improvement']\nqprompt=['What worked well','What was confusing','Hardest requirement','Suggested change']\ncredits='<section><h3>Source Information</h3><dl>'+''.join('<dt>'+html.escape(k[0].upper()+k[1:])+':</dt><dd>'+html.escape(str(v))+'</dd>' for k,v in info['sourceInformation'].items())+'</dl></section>'\ncredits+='<section>'+''.join('<h3>'+title+'</h3>'+''.join('<p class=\\\"qa\\\"><strong>'+html.escape(q)+':</strong>'+html.escape(a)+'</p>' for q,a in zip(qs,info[key])) for title,key,qs in [('Testing Feedback','testingFeedback',qtests),('Engine Feedback','engineFeedback',qengine),('Prompt Feedback','promptFeedback',qprompt)])+'</section>'\nmodule='\\\\n'.join((p/f).read_text().replace('export class ','class ') for f in ['audio.js','net.js','scene.js','main.js'])\nimport re\nmodule=re.sub(r\\\"\"'^import .*?from ['\"'\\\\\\\"]\\\\./.*?['\\\\\\\"];\\\\n\\\",'',module,flags=re.M)\n# Scope each module's helpers to avoid accidental name collisions.\nparts=[]\nfor name,cls in [('audio.js','Sound'),('net.js','Network'),('scene.js','Coast')]:\n s=(p/name).read_text();s=re.sub(r\\\"\"'^import .*?;'\"\\\\n\\\",'',s,flags=re.M);s=s.replace('export class ','class ')\n parts.append('const '+cls+' = (()=>{\\\\n'+s+'\\\\nreturn '+cls+';})();')\nmain=(p/'main.js').read_text();main=re.sub(r\\\"\"'^import .*?;'\"\\\\n\\\",'',main,flags=re.M)\nmodule=\\\"import * as THREE from 'three/webgpu';\\\\nimport {color,normalWorld,vec3} from 'three/tsl';\\\\nimport RAPIER from 'rapier';\\\\n\\\"+'\\\\n'.join(parts)+'\\\\n'+main\nimports={'imports':{'three':'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js','three/webgpu':'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js','three/tsl':'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.tsl.js','rapier':'https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-compat@0.19.3/rapier.mjs'}}\nbase=(p/'template.html').read_text().replace('__HUB__',(p/'hub-session.js').read_text()).replace('__CREDITS__',credits).replace('__MODULE__',module)\noutput=root/(p.name+'.html');output.write_text(base.replace('__IMPORTMAP__',json.dumps(imports)))\nlocal={'imports':{k:'./vendor/'+('rapier.js' if k=='rapier' else 'three.tsl.js' if k=='three/tsl' else 'three.webgpu.js') for k in imports['imports']}}\n(p/'dev.html').write_text(base.replace('__IMPORTMAP__',json.dumps(local)))\nprint(output.name)\nEOF\npython3 Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/build.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
