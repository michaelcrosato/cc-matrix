\n  this.mesh(new THREE.RingGeometry(5.5,5.54,64),'#d9ac69',s,16,23,-37,1,1,1,false);\n  // Cut-paper distant islands and their ink contour.\n  for(let i=0;i<11;i++){let x=(i-5)*7;const h=2+Math.sin(i*3.7)*1.5;this.mesh(new THREE.ConeGeometry(5,h,5),'#719692',s,x,2.8+h/2,-24,1,1,1,true);}\n  this.box('#267f86',s,0,0,-8,150,1,110,false);\n  this.box('#85bbb0',s,0,.65,-24,150,.06,3,false);\n  for(let i=0;i<125;i++){const x=((i*13.713)%78)-39,z=((i*7.231)%61)-30;let m=this.box(i%3?'#70b8b0':'#b8d5bc',s,x,.65,z,1+(i%6)*.7,.025,.07,false);this.waves.push(m);}\n  for(let i=0;i<12;i++){const g=new THREE.Group();s.add(g);g.position.set(-40+i*7,19+(i%4)*2.5,-28-i%3*2);for(let k=0;k<3;k++)this.ball('#f9f0d4',g,k*1.5,Math.sin(k*2)*.25,0,1.8, .65+(k%2)*.3,.3,false);this.clouds.push(g);}\n  // Lighthouse on the outer shoal.\n  const light=new THREE.Group();light.position.set(23,.6,-16);s.add(light);\n  this.mesh(new THREE.CylinderGeometry(1,1.7,1,7),'#486d6b',light,0,0,0);\n  this.mesh(new THREE.CylinderGeometry(.45,.8,4.7,10),'#f3dfb3',light,0,2.5,0);\n  this.mesh(new THREE.CylinderGeometry(.52,.6,.65,10),'#e56b49',light,0,3.1,0);\n  this.mesh(new THREE.CylinderGeometry(.7,.7,.65,10),'#ffce5e',light,0,5.05,0);\n  this.mesh(new THREE.ConeGeometry(.95,.9,10),'#203f48',light,0,5.8,0);\n  this.box('#e8e0ba',s,0,-.9,9,70,.9,8);\n  for(let i=0;i<24;i++){this.box('#c5a578',s,-34+i*3,-.35,9,2.9,.13,7.8);}\n  for(const x of [-12,12]){\n   const g=new THREE.Group();g.position.set(x,0,0);s.add(g);\n   this.mesh(new THREE.CylinderGeometry(3.7,4.2,1.8,8),'#68766c',g,0,.5,1);\n   this.mesh(new THREE.CylinderGeometry(3.5,3.7,.45,8),'#d3ba88',g,0,1.5,1);\n   for(let k=0;k<5;k++)this.box('#e5c991',g,-2.8+k*1.4,1.95,2.9,1.1,.6,.5);\n   this.box('#273f43',g,0,1.65,1.2,3,.1,2.7);\n   this.box('#d3ba88',g,0,1.3,-1.7,5,.3,1.8);\n   this.box('#ffcf59',g,x<0?-2.4:2.4,2.9,2.2,.1,2.6,.1);\n   this.box(x<0?'#e76746':'#5ab7ad',g,x<0?-2:2,3.8,2.2,.9,.6,.08);\n  }\n  for(let x=-30;x<=30;x+=3.2){this.box('#5