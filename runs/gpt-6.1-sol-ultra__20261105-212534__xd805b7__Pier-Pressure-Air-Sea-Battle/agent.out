{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc 'tail -n 70 Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/net.js'","aggregated_output":"\n  _description(token, type) {\n    try {\n      if (!String(token).trim().startsWith('PP1.')) throw new Error();\n      const data = JSON.parse(atob(String(token).trim().slice(4)));\n      if (data.type !== type || typeof data.sdp !== 'string' || data.sdp.length > 30000) throw new Error();\n      return data;\n    } catch { throw new Error(`Paste the complete ${type === 'offer' ? 'invitation' : 'reply'} code from the other gunner.`); }\n  }\n\n  async hostRoom() {\n    this._standalone('host');\n    this._makePeer();\n    this._wireData(this._peer.createDataChannel(NET_VERSION));\n    await this._peer.setLocalDescription(await this._peer.createOffer());\n    const token = await this._gather();\n    this._status('Invitation ready. Send it to your gunner, then paste their reply.');\n    return token;\n  }\n\n  async joinRoom(token) {\n    const description = this._description(token, 'offer');\n    this._standalone('guest');\n    this._makePeer();\n    await this._peer.setRemoteDescription(description);\n    await this._peer.setLocalDescription(await this._peer.createAnswer());\n    const answer = await this._gather();\n    this._status('Reply ready. Send it to the host to connect.');\n    return answer;\n  }\n\n  async acceptAnswer(token) {\n    if (this.active || !this._peer || !this.isHost) throw new Error('Create an invitation first.');\n    await this._peer.setRemoteDescription(this._description(token, 'answer'));\n    this._status('Reply accepted. Connecting the coastal batteries…');\n  }\n\n  _disconnected() {\n    if (!this.connected) return;\n    this.connected = false;\n    this._remote = null;\n    if (this.isHost) this._call('onInput', emptyInput(), 1);\n    this._call('onDisconnect');\n    this._status('The other gunner disconnected. Host may continue solo.');\n  }\n\n  leave() {\n    if (this.active) return false;\n    if (this._broadcast && this._remote) this._broadcast.postMessage({ protocol: NET_VERSION, from: this._nonce, to: this._remote, kind: 'bye' });\n    clearInterval(this._helloTimer);\n    this._broadcast?.close();\n    this._broadcast = null;\n    if (this._data) { this._data.onclose = null; this._data.close(); this._data = null; }\n    if (this._peer) { this._peer.onconnectionstatechange = null; this._peer.close(); this._peer = null; }\n    this.connected = false;\n    this.role = 'host';\n    this.me = 0;\n    this.server = false;\n    this._remote = null;\n    this._seatIds = [0];\n    this.players = [{ id: 0, name: 'Port gunner', color: '#f4b34e' }];\n    this._lastInput.clear();\n    this._lastState = -1;\n    this._sequence = 0;\n    this._sendAt = 0;\n    return true;\n  }\n\n  dispose() { this.leave(); for (const off of this._unsub) off(); this._unsub.length = 0; }\n}\n","exit_code":0,"status":"completed"}}
