(c,g,-.15,0,0,1,.13,3.9);\n   this.box('#183f4a',g,-1.2,.43,0,.65,.9,.13);this.box(c,g,-1.25,.1,0,.6,.13,1.6);\n   this.ball('#a9d8cc',g,.4,.35,0,.55,.33,.35);\n   const prop=new THREE.Group();prop.name='prop';prop.position.x=1.65;g.add(prop);this.box('#153a45',prop,0,0,0,.12,1.8,.12);\n   this.box('#e66846',g,-.2,.13,1.6,.6,.08,.55);\n   this.animate(root,[new THREE.NumberKeyframeTrack('prop.rotation[x]',[0,.32],[0,Math.PI*2]),new THREE.NumberKeyframeTrack('hull.rotation[z]',[0,1,2],[0,.045,0])],2);\n   g.rotation.y=side<0?Math.PI:0;\n  } else if(type==='heli'){\n   this.ball('#db7653',g,0,0,0,1.1,.65,.65);this.ball('#add9cf',g,.6,.15,.3,.65,.45,.45);this.box('#193c47',g,-1.4,0,0,1.9,.22,.22);this.box(c,g,-2.2,.35,0,.3,.8,.15);\n   this.box('#173b46',g,0,.85,0,.15,.6,.15);const rotor=new THREE.Group();rotor.name='rotor';rotor.position.y=1.1;g.add(rotor);this.box('#173b46',rotor,0,0,0,4.1,.06,.14);\n   for(let k of [-1,1])this.box('#193c47',g,0,-.75,k*.55,2.5,.13,.13);\n   this.animate(root,[new THREE.NumberKeyframeTrack('rotor.rotation[y]',[0,.2],[0,Math.PI*2]),new THREE.NumberKeyframeTrack('hull.rotation[z]',[0,1,2],[0,.05,0])],2);g.rotation.y=side<0?Math.PI:0;\n  }else if(type==='supply'){\n   const canopy=this.mesh(new THREE.SphereGeometry(1.2,12,6,0,Math.PI*2,0,Math.PI/2),'#9fc5a1',g,0,1,0,1,.65,1);\n   for(let k of [-1,1])this.box('#eee1b5',g,k*.65,.35,0,.035,1.4,.035,false);\n   this.box('#f3d397',g,0,-.6,0,1,1,.8);this.box('#4d9186',g,0,-.6,.43,.15,.8,.04);this.box('#4d9186',g,0,-.6,.43,.75,.15,.04);\n   this.animate(root,[new THREE.NumberKeyframeTrack('hull.rotation[z]',[0,1,2],[-.15,.15,-.15])],2);\n  }else if(type==='bomb'){\n   this.ball('#d15c43',g,0,0,0,.23,.5,.23);this.box('#193d46',g,0,.4,0,.7,.15,.15);\n  }else{\n   const boss=type==='boss',scale=boss?2.5:1;\n   const shape=new THREE.Shape();shape.moveTo(-2.2,.15);shape.lineTo(2.2,.15);shape.lineTo(1.5,-.65);shape.lineTo(-1.6,-.65);shape.closePath();\n   const hull=this.mesh(new THREE.ExtrudeGeometry(shape,{depth:1.2,bevelEnabled:false}),boss?'#324b52':'#d66a47',g,0,0,-.6,scale,scale,scale);\n   this.box('#f2ce83',g,0,.25,0,4.1*scale,.15,1.3*scale);\n   this.box('#d5ccab',g,-.3,1*scale,0,1.7*scale,1.3*scale,.95*scale);\n   this.box('#264a52',g,.1,1.4*scale,.51*scale,.7*scale,.35*scale,.05);\n   for(let k=0;k<(boss?3:1);k++){this.box('#263e45',g,(-1.3+k*.9)*scale,2*scale,0,.4*scale,1*scale,.5*scale);this.box('#c96348',g,(-1.3+k*.9)*scale,2.45*scale,0,.43*scale,.25*scale,.53*scale);}\n   for(let k of [-1,1]){this.ball('#c75640',g,k*1.5*scale,.55*scale,0,.5*scale,.4*scale,.5*scale);this.box('#1c3841',g,k*1.9*scale,.85*scale,0,1.1*scale,.16*scale,.2*scale);}\n   if(boss){for(let k=0;k<5;k++)this.box('#efbd58',g,-3+k*1.5,0,1.55,.65,.22,.05);}\n   this.animate(root,[new THREE.NumberKeyframeTrack('hull.rotation[z]',[0,1.5,3],[-.025,.025,-.025]),new THREE.NumberKeyframeTrack('hull.position[y]',[0,1.5,3],[0,.13,0])],3);\n  }\n  return root;\n }\n remove(root){if(\"'!root)return;if(root.userData.mixer){root.userData.mixer.stopAllAction();root.userData.mixer.uncacheRoot(root);}this.scene.remove(root);}\n projectile(x,y,special=false){const g=new THREE.Group();this.scene.add(g);g.position.set(x,y,0);this.ball(special?'\"'#9ee7d0':'#ffe68d',g,0,0,0,.17,.17,.17);return g;}\n burst(x,y,c='#ffcb60',size=1){\n  for(let i=0;i<14;i++){const a=Math.random()*Math.PI*2,v=2+Math.random()*6;const m=this.mesh(i%2?this.boxGeo:this.ballGeo,i%4===0?'#f7e9bf':c,this.scene,x,y,.5,.12+Math.random()*.22,.12+Math.random()*.22,.13,false);this.particles.push({m,vx:Math.cos(a)*v*size,vy:Math.sin(a)*v*size,life:.35+Math.random()*.55,max:.9});}\n  const ring=this.mesh(new THREE.TorusGeometry(.3,.07,5,24),c,this.scene,x,y,.6,1,1,1,false);this.particles.push({m:ring,vx:0,vy:0,life:.45,max:.45,ring:true});\n }\n drawAim(x,y,angle,speed,gravity,wind,visible){this.preview.visible=visible;if(\"'!visible)return;for(let i=0;i<this.previewDots.length;i++){const t=(i+1)*.06;let p=this.previewDots[i];p.position.set(x+Math.cos(angle)*speed*t+wind*.5*t*t,y+Math.sin(angle)*speed*t-gravity*.5*t*t,0);p.visible=p.position.y>.8&&p.position.y<26;}}\n update(dt){this.time+=dt;for(const m of this.mixers)m.update(dt);\n  for(let i=this.particles.length-1;i>=0;i--){const p=this.particles[i];p.life-=dt;if(p.life<=0){this.scene.remove(p.m);this.particles.splice(i,1);continue;}p.m.position.x+=p.vx*dt;p.m.position.y+=p.vy*dt;p.vy-=8*dt;p.m.rotation.z+=dt*2;if(p.ring)p.m.scale.setScalar(1+(p.max-p.life)*12);else p.m.scale.multiplyScalar(Math.pow(.25,dt));}\n  for(let i=0;i<this.waves.length;i++){let w=this.waves[i];w.position.x+=dt*(.2+(i%3)*.06);if(w.position.x>42)w.position.x=-42;w.scale.x=1+Math.sin(this.time*1.2+i)*.12;}\n  for(const c of this.clouds){c.position.x+=dt*.12;if(c.position.x>48)c.position.x=-48;}\n }\n resize(){let w=innerWidth,h=innerHeight;this.renderer.setSize(w,h);const aspect=w/h;const width=Math.max(54,33*aspect),height=width/aspect;this.camera.left=-width/2;this.camera.right=width/2;this.camera.top=height/2;this.camera.bottom=-height/2;this.camera.updateProjectionMatrix();this.camera.position.set(0,14,60);this.camera.lookAt(0,12,0);}\n pointer(x,y){const v=new THREE.Vector3(x/innerWidth*2-1,-y/innerHeight*2+1,.5).unproject(this.camera);const dir=new THREE.Vector3(0,0,-1).applyQuaternion(this.camera.quaternion);const t=-v.z/dir.z;return v.addScaledVector(dir,t);}\n render(shake=0){this.camera.position.x=shake?(Math.random()-.5)*shake:0;this.renderer.render(this.scene,this.camera);}\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
