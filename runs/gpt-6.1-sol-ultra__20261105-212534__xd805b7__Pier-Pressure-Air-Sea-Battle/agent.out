{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"sed -n '24,35p' Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/main.js && sed -n '160,188p' Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/main.js && sed -n '342,455p' Pier-Pressure-Air-Sea-Battle-gpt-6.1-sol-ultra-20261105-212534/test.py\"","aggregated_output":" onResult:(score,won,stats)=>{G.score=score;Object.assign(G,stats);finish(won,won?'HARBOR SECURED':'WATCH ENDED',true);},\n onLeave:()=>{remoteInputs[1]={};toast('A GUNNER LEFT THE WATCH');}\n});\nfunction save(){try{localStorage.setItem('pier-pressure-prefs',JSON.stringify(prefs));}catch{}}\nfunction touchOrPad(){document.body.classList.toggle('touch',inputMode==='touch');}\nfunction setInputMode(v){if(inputMode!==v){inputMode=v;touchOrPad();updatePrompts();if(v==='gamepad'&&screen!=='playing'&&!focusables().includes(document.activeElement))focusables()[0]?.focus({preventScroll:true});}}\nfunction activity(type){lastActivity=performance.now();idle=0;if(type)setInputMode(type);if(mode==='demo'){title();return true;}return false;}\nfunction updatePrompts(){const pad=inputMode==='gamepad',xbox=prefs.glyph==='xbox';for(const e of document.querySelectorAll('[data-prompt]')){const p=e.dataset.prompt;e.textContent=pad?({fire:xbox?'RT':'R2',salvo:xbox?'X':'□',confirm:xbox?'A':'✕',back:xbox?'B':'○',pause:'☰',aim:'L'}[p]):({fire:'HOLD CLICK / SPACE',salvo:'E',confirm:'ENTER',back:'ESC',pause:'ESC',aim:'MOUSE / A D'}[p]);} $('controlLine').innerHTML=pad?`<b>L</b> aim <b>${xbox?'RT':'R2'} / ${xbox?'A':'✕'}</b> fire <b>${xbox?'X':'□'}</b> salvo <b>☰</b> pause`:'<b>MOUSE</b> aim <b>HOLD CLICK / SPACE</b> fire <b>E</b> salvo <b>ESC</b> pause';}\nfunction setScreen(s){screen=s;$('screen').dataset.screen=s;document.body.dataset.screen=s;for(const el of document.querySelectorAll('.panel'))el.hidden=el.dataset.panel!==s;$('hud').hidden=!['playing','pause','dev'].includes(s);$('pause').hidden=s!=='playing';$('attract').hidden=mode!=='demo';$('salvoTouch').hidden=inputMode!=='touch'||s!=='playing';navIndex=0;requestAnimationFrame(()=>{const b=focusables()[0];if(b&&inputMode==='gamepad')b.focus({preventScroll:true});});}\nfunction toast(text){$('toast').textContent=text;toastTime=2.8;$('toast').classList.add('show');}\nfunction banner(kicker,title,sub){$('bannerKicker').textContent=kicker;$('bannerTitle').textContent=title;$('bannerSub').textContent=sub;bannerTime=3.2;$('banner').classList.add('show');sound.voice(G.wave||0);}\nfunction title(){clearWorld();mode='solo';autoplay=false;setScreen('title');idle=0;pointerDown=false;touchActive=false;inputs.forEach(i=>i.fire=false);sound.mute(false);coast.guns.forEach(g=>g.root.visible=true);createTableau();}\nfunction focusables(){return [...document.querySelectorAll('.panel:not([hidden]) button,.panel:not([hidden]) input,.panel:not([hidden]) select,.panel:not([hidden]) textarea')].filter(e=>!e.disabled&&e.offsetParent!==null);}\nfunction navigate(d){const a=focusables();if(!a.length)return;const current=a.indexOf(document.activeElement);navIndex=(Math.max(0,current)+d+a.length)%a.length;a[navIndex].focus({preventScroll:true});a[navIndex].scrollIntoView({block:'nearest'});}\nfunction adjustFocused(d){const e=document.activeElement;if(e?.type==='range'){e.value=clamp(Number(e.value)+d*Number(e.step||1),Number(e.min),Number(e.max));e.dispatchEvent(new Event('input'));}else if(e?.tagName==='SELECT'){e.selectedIndex=(e.selectedIndex+d+e.options.length)%e.options.length;e.dispatchEvent(new Event('change'));}else navigate(d);}\nfunction menuBack(){if(['pause','dev'].includes(screen)){if(screen==='dev')setScreen('pause');else pause();}else if(screen==='settings'){setScreen(previous==='pause'?'pause':'title');sound.mute(previous==='pause');}else if(screen==='about'||screen==='howto')setScreen(previous==='pause'?'pause':'title');else if(screen==='online'){net.leave();title();}else if(screen==='results')title();}\nfunction pollInputs(dt){\n const pads=[...(navigator.getGamepads?.()||[])].filter(Boolean);\n for(let n=0;n<Math.min(2,pads.length);n++){const p=pads[n],prev=padPrevious[n]||[],pressed=i=>!!p.buttons[i]?.pressed,edge=i=>pressed(i)&&!prev[i];const axis=p.axes||[];\n  const any=p.buttons.some(b=>b.pressed)||axis.some(v=>Math.abs(v)>.22);\n  if(any){sound.unlock();const exit=activity('gamepad');if(exit){padPrevious[n]=p.buttons.map(b=>b.pressed);continue;}}\n  if(screen!=='playing'&&Math.abs(axis[3]||0)>.2){const scroll=document.querySelector('.panel:not([hidden]) .menuInner');if(scroll)scroll.scrollTop+=(axis[3]||0)*dt*700;}\n  if(screen==='playing'){\n   const seat=mode==='online'?net.localSeat:n;if(seat>=0&&seat<2){if(Math.hypot(axis[0]||0,axis[1]||0)>.25)inputs[seat].angle=clamp(Math.atan2(-(axis[1]||0),axis[0]||0),.12,Math.PI-.12);inputs[seat].fire=pressed(7)||pressed(0);inputs[seat].salvo=pressed(2);}\n   if(edge(9))pause();\n  }else if(any&&performance.now()>navAt){if(edge(0)){document.activeElement?.click();navAt=performance.now()+180;}else if(edge(1)||edge(9)){menuBack();navAt=performance.now()+180;}else if(pressed(13)||(axis[1]||0)>.55){navigate(1);navAt=performance.now()+220;}else if(pressed(12)||(axis[1]||0)<-.55){navigate(-1);navAt=performance.now()+220;}else if(pressed(15)||(axis[0]||0)>.55){adjustFocused(1);navAt=performance.now()+180;}else if(pressed(14)||(axis[0]||0)<-.55){adjustFocused(-1);navAt=performance.now()+180;}}\n  padPrevious[n]=p.buttons.map(b=>b.pressed);\n }\n if(screen!=='playing')return;\n const seat=mode==='online'?net.localSeat:0;if(seat<0)return;\n if(manualInput){Object.assign(inputs[seat],manualInput);return;}\n if(inputMode==='keyboard'){\n  if(mousePoint){const point=coast.pointer(mousePoint.x,mousePoint.y);inputs[seat].angle=aimAt(seat,point.x,Math.max(3.5,point.y));}\n  if(keys.has('KeyA')||keys.has('ArrowLeft')){mousePoint=null;inputs[seat].angle=clamp(inputs[seat].angle+dt*1.6,.12,Math.PI-.12);}\n  if(keys.has('KeyD')||keys.has('ArrowRight')){mousePoint=null;inputs[seat].angle=clamp(inputs[seat].angle-dt*1.6,.12,Math.PI-.12);}\n  inputs[seat].fire=pointerDown||keys.has('Space');inputs[seat].salvo=keys.has('KeyE');\n }\n if(inputMode==='touch'){inputs[seat].fire=touchActive;if(touchActive){if(touchAim){const v=coast.pointer(touchAim.x,touchAim.y);inputs[seat].angle=aimAt(seat,v.x,Math.max(4,v.y));}if(prefs.assist){const ai=autoInput(seat);inputs[seat].angle=ai.angle;}}}\n if(mode==='coop'&&!pads[1]){if(keys.has('KeyJ'))inputs[1].angle=clamp(inputs[1].angle+dt*1.6,.12,Math.PI-.12);if(keys.has('KeyL'))inputs[1].angle=clamp(inputs[1].angle-dt*1.6,.12,Math.PI-.12);inputs[1].fire=keys.has('Enter');inputs[1].salvo=keys.has('KeyU');}\n}\nfunction frame(dt,render=true){\n    page.evaluate(\"__game.advance(.8)\")\n    page.keyboard.up(\"Enter\")\n    check(\n        \"second local keyboard gunner\",\n        page.evaluate(\"__game.state().mode==='coop' && __game.state().shotsFired>=2\"),\n    )\n    page.evaluate(\"__game.start('solo');__game.setAutoplay(true)\")\n    waves = {0}\n    for _ in range(35):\n        page.evaluate(\"__game.advance(8)\")\n        state = page.evaluate(\"__game.state()\")\n        waves.add(state[\"wave\"])\n        if state[\"screen\"] == \"results\":\n            break\n    EVIDENCE[\"playthrough\"] = {\"waves\": sorted(waves), \"final\": state}\n    check(\"scripted circuit covers all operations\", waves == {0, 1, 2}, str(state))\n    check(\n        \"scripted circuit wins through physics hits\",\n        state[\"screen\"] == \"results\"\n        and state[\"won\"]\n        and state[\"hits\"] >= 24\n        and state[\"kills\"] >= 19,\n        str(state),\n    )\n    page.locator(\"#retry\").click()\n    check(\n        \"victory retry\",\n        page.evaluate(\"__game.state().screen==='playing' && __game.state().health===7\"),\n    )\n    page.evaluate(\"__game.setAutoplay(false);__game.dev({health:1});__game.damage()\")\n    check(\n        \"defeat produces results\",\n        page.evaluate(\"__game.state().screen==='results' && !__game.state().won\"),\n    )\n    page.locator(\"#retry\").click()\n    check(\n        \"defeat retry\",\n        page.evaluate(\"__game.state().screen==='playing' && __game.state().health===7\"),\n    )\n    page.evaluate(\"__game.goto('title')\")\n    page.locator(\"#settings\").click()\n    page.locator(\"#glyph\").select_option(\"xbox\")\n    page.locator(\"#music\").evaluate(\n        \"el=>{el.value=25;el.dispatchEvent(new Event('input',{bubbles:true}))}\"\n    )\n    check(\n        \"settings music and glyphs live\",\n        page.evaluate(\n            \"__game.state().glyph==='xbox' && __game.state().musicVolume===.25\"\n        ),\n    )\n    page.locator(\"#music\").evaluate(\n        \"el=>{el.value=10;el.dispatchEvent(new Event('input',{bubbles:true}))}\"\n    )\n    page.keyboard.press(\"Escape\")\n    page.evaluate(\"document.activeElement?.blur()\")\n    pad_button(page, 0)\n    pad_button(page, 0, False)\n    check(\n        \"first controller confirm focuses menu\",\n        page.evaluate(\"__game.state().screen==='playing'\"),\n    )\n    page.evaluate(\"__game.goto('title')\")\n    page.wait_for_timeout(80)\n    before = page.evaluate(\"document.activeElement?.id\")\n    pad_button(page, 13)\n    pad_button(page, 13, False)\n    after = page.evaluate(\"document.activeElement?.id\")\n    check(\n        \"controller focus navigation\",\n        before != after and bool(after),\n        f\"{before} -> {after}\",\n    )\n    check(\n        \"controller last input prompts\",\n        page.evaluate(\n            \"__game.state().inputMode==='gamepad' && [...document.querySelectorAll('[data-prompt=confirm]')].some(x=>x.textContent==='A')\"\n        ),\n    )\n    pad_button(page, 0)\n    pad_button(page, 0, False)\n    check(\n        \"controller confirms menu\", page.evaluate(\"__game.state().screen==='playing'\")\n    )\n    before = page.evaluate(\"__game.state().shotsFired\")\n    pad_button(page, 7)\n    page.evaluate(\"__game.advance(.8)\")\n    pad_button(page, 7, False)\n    check(\n        \"controller trigger fires\", page.evaluate(\"__game.state().shotsFired\") > before\n    )\n    pad_button(page, 9)\n    pad_button(page, 9, False)\n    check(\"controller options pauses\", page.evaluate(\"__game.state().screen==='pause'\"))\n    page.keyboard.press(\"Escape\")\n    check(\n        \"keyboard restores native prompts\",\n        page.evaluate(\"__game.state().inputMode==='keyboard'\"),\n    )\n    page.evaluate(\"__game.goto('title')\")\n    page.locator(\"#about\").click()\n    text = page.locator(\".panel:not([hidden])\").inner_text()\n    check(\n        \"credits source and usage\",\n        \"Air-Sea Battle\" in text and \"added on import\" in text,\n    )\n    check(\n        \"credits feedback sections\",\n        all(\n            x in text.lower()\n            for x in [\n                \"source information\",\n                \"testing feedback\",\n                \"engine feedback\",\n","exit_code":0,"status":"completed"}}
