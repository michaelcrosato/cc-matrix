{"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"sed -n '85,125p' 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tests/sim.mjs' && sed -n '1000,1060p' 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/src/sim.js' && sed -n '1,220p' 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tools/verify.mjs' | tail -15\"","aggregated_output":"    assert.equal(w.ship.previewY, 1);\n    assert.equal(w.ship.aimY, -1);\n    w.step({ p: { mx: -1 }, n: { mx: 1, my: 0, burst: true } });\n    for (let i = 0; i < 30; i++) w.step({ p: { my: -1 }, n: { mx: 0, my: 1, burst: true } });\n    assert.equal(w.ship.driveX, 1);\n    assert.equal(w.ship.driveY, 0);\n    assert.equal(w.ship.drive, \"burst\");\n  });\n  test(\"hyperspace requires release and enough energy; no automatic repeated spend\", () => {\n    const w = empty();\n    step(w, { mx: 1, burst: true }, 4);\n    assert.equal(w.burstCount, 1);\n    step(w, { mx: 1, burst: false }, 0.05);\n    step(w, { mx: 1, burst: true }, 0.2);\n    assert.equal(w.burstCount, 2);\n    const q = empty();\n    q.ship.energy = 10;\n    step(q, { burst: true }, 0.2);\n    assert.equal(q.burstCount, 0);\n    assert.ok(q.events.some((e) => e.type === \"warpDenied\"));\n  });\n  test(\"high-speed swept burst contacts rescue collars and active mines\", () => {\n    const w = empty();\n    w.config.warpSpeed = 1500;\n    w.ship.drive = \"burst\";\n    w.ship.driveTimer = 0.4;\n    w.spawn({ type: \"crystal\", x: 270, y: 338, tutorial: true, offset: 0 });\n    w.spawn({ type: \"mine\", x: 278, y: 338, state: \"active\", age: 2, armDelay: 1 });\n    w.step({ \"local-1\": F.neutral() }, 0.05);\n    assert.equal(w.rescued.length, 1);\n    assert.equal(w.ship.hull, 2);\n  });\n  test(\"rescue wins same-tick laser contact; lingering animation cannot duplicate score\", () => {\n    const w = empty(),\n      c = w.spawn({ type: \"crystal\", x: 235, y: 338, hp: 1, tutorial: true, offset: 0 });\n    w.fireBullet(225, 338, 1, 0);\n    step(w);\n    assert.equal(w.rescued.length, 1);\n    assert.equal(w.lost.length, 0);\n    assert.equal(w.score, 20);\n    w.rescue(c);\n        rescued: [...this.rescued],\n        lost: [...this.lost],\n        nextId: this.nextId,\n        time: this.time,\n        replacements: this.replacements,\n        burstCount: this.burstCount,\n        rngState: this.rngState,\n      };\n      return copy(this.checkpoint);\n    }\n    restoreCheckpoint(c = this.checkpoint) {\n      if (\n        !c ||\n        c.version !== 1 ||\n        c.seed !== this.seed ||\n        !Number.isInteger(c.sector) ||\n        c.sector < 0 ||\n        c.sector > 4\n      )\n        return false;\n      const baseline = copy(c);\n      this.score = Number.isFinite(c.score) ? c.score : 0;\n      this.rescued = Array.isArray(c.rescued) ? [...c.rescued] : [];\n      this.lost = Array.isArray(c.lost) ? [...c.lost] : [];\n      this.nextId = Math.max(1, c.nextId || 1);\n      this.time = c.time || 0;\n      this.replacements = c.replacements || 0;\n      this.burstCount = c.burstCount || 0;\n      this.rngState = c.rngState || hash(this.seed);\n      this.outcome = null;\n      this.chain = 0;\n      this.chainUntil = 0;\n      this.enter(c.sector, true);\n      this.ship.burstReleaseRequired = true;\n      this.checkpoint = baseline;\n      return true;\n    }\n    snapshot() {\n      const keys = [\n        \"seed\",\n        \"rngState\",\n        \"runId\",\n        \"mode\",\n        \"config\",\n        \"tick\",\n        \"time\",\n        \"eventSeq\",\n        \"nextId\",\n        \"events\",\n        \"rescued\",\n        \"lost\",\n        \"score\",\n        \"chain\",\n        \"chainUntil\",\n        \"replacements\",\n        \"replacementCredits\",\n        \"seats\",\n        \"outcome\",\n        \"debugModified\",\n        \"attract\",\n        \"dev\",\n    },\n    null,\n    2,\n  ) + \"\\n\",\n);\nfor (const r of failed) console.error(\"FAIL \" + r.name + \"\\n\" + (r.detail || \"No detail\"));\nconsole.log(\n  all.length -\n    failed.length +\n    \"/\" +\n    all.length +\n    \" checks passed\" +\n    (cached.length ? \" (\" + cached.length + \" unchanged suites cached)\" : \"\"),\n);\nif (failed.length) process.exitCode = 1;\n","exit_code":0,"status":"completed"}}
