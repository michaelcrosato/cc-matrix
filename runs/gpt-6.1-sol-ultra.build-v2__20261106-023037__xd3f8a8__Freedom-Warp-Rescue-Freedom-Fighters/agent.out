{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"head -35 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tests/net.mjs' && tail -15 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tests/net.mjs' && head -20 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tools/presentation-check.mjs' && tail -10 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tools/presentation-check.mjs' && ls 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tools'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"head -35 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tests/net.mjs' && tail -15 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tests/net.mjs' && head -20 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tools/presentation-check.mjs' && tail -10 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tools/presentation-check.mjs' && ls 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tools'\"","aggregated_output":"import assert from 'node:assert/strict';\nimport { readFile } from 'node:fs/promises';\nimport vm from 'node:vm';\nimport { fileURLToPath } from 'node:url';\n\nconst SOURCE = await readFile(new URL('../src/net.js', import.meta.url), 'utf8');\nconst context = vm.createContext({ TextEncoder, TextDecoder, btoa, atob, console });\nvm.runInContext(SOURCE, context);\nconst { Net, NetCodec } = context.FWR;\nconst ordinary = (value) => JSON.parse(JSON.stringify(value));\n\nclass World {\n  constructor(seed, options) {\n    this.seed = seed; this.runId = options.runId; this.tick = 0; this.time = 0;\n    this.score = 0; this.rescued = []; this.lost = []; this.outcome = null;\n    this.ship = { x: 100, y: 200, vx: 0, vy: 0, hull: 3, energy: 100, drive: 'ready' };\n    this.entities = [{ id: 'c1', type: 'crystal', x: 180, y: 200, hp: 3, r: 30 }];\n    this.bullets = []; this.events = []; this.camera = { x: 0, y: 0 };\n    this.seats = []; this.steps = 0; this.bursts = 0;\n  }\n  setSeats(ids) { this.seats = ids.slice(); }\n  step(intents, dt) {\n    this.steps++; this.tick++; this.time += dt;\n    const pilot = intents[this.seats[0]] || {};\n    const navigator = intents[this.seats[1] ?? this.seats[0]] || {};\n    this.ship.x += (pilot.mx || 0) * 120 * dt;\n    this.ship.y += (pilot.my || 0) * 120 * dt;\n    if (navigator.burst) this.bursts++;\n    const crystal = this.entities[0];\n    if (crystal && Math.hypot(this.ship.x - crystal.x, this.ship.y - crystal.y) <= crystal.r) {\n      this.rescued.push(crystal.id); this.entities = []; this.score += 20;\n    }\n  }\n  snapshot() {\n    const { steps, ...state } = this;\n    assert.ok(host.seenTypes.includes('guard') && host.seenTypes.includes('organ') && host.seenTypes.includes('core'));\n    assert.ok(host.seenPhases.includes('3:prisoners') && host.seenPhases.includes('3:core'));\n    assert.ok(host.burstCount > 0); assert.equal(host.debugModified, false); assert.equal(host.dev.invulnerable, false);\n    assert.equal(t.host.hub.finishes.length, 1);\n  });\n\n  return results;\n}\n\nif (process.argv[1] === fileURLToPath(import.meta.url)) {\n  const results = await runNetTests();\n  for (const result of results) if (!result.pass) console.error(`FAIL ${result.name}\\n${result.detail}`);\n  console.log(`${results.filter((r) => r.pass).length}/${results.length} network checks passed`);\n  if (results.some((r) => !r.pass)) process.exitCode = 1;\n}\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nconst dir=path.dirname(path.dirname(fileURLToPath(import.meta.url))),logs=[];\nconst ctx=vm.createContext({console:{log:(...a)=>logs.push(a.join(' ')),warn:(...a)=>logs.push(a.join(' ')),error:(...a)=>logs.push(a.join(' '))}});\nfor(const file of ['vendor/engine-repo/dist/handoff/my-3d2dge.js','src/config.js','src/content.js','src/sim.js','src/presentation.js','src/audio.js'])vm.runInContext(fs.readFileSync(path.join(dir,file),'utf8'),ctx,{filename:file});\nconst E=ctx.My3D2dge,F=ctx.FWR,game=new E.Game({headless:true,draw:true,res:[600,338],view:'overhead',menu:false}),p=new F.Presentation(E,game),a=new F.Audio(E,game),world=new F.World(1982);\nlet count=0;\ngame.start({update(){},draw(r){p.draw(r,world);}});\nfor(let sector=0;sector<=4;sector++){\n world.enter(sector);world.entities=[];\n for(const [type,x,y]of [['crystal',480,250],['layer',790,180],['interceptor',960,500],['guard',850,360],['mine',600,400],['mine',680,320],['beacon',1140,338]])world.spawn({type,x,y,state:type==='mine'?'active':'active'});\n if(sector===3){world.camera.x=5500;world.ship.x=5210;world.spawn({type:'carrier',x:5560,y:337.5,w:260,h:310});world.spawn({type:'organ',x:5388,y:160});world.spawn({type:'core',x:5390,y:337.5});}\n world.emit('rescue',world.ship.x+90,230);world.emit('collapse',world.ship.x+100,400);world.emit('warp',world.ship.x,world.ship.y,{dx:1,dy:0});\n for(const phase of ['rescue','organs','prisoners','core','extract']){world.phase=phase;world.time+=1;game.advance(.025,{draw:true});count++;}\n}\nif(a.native.musicVolume!==.1)throw Error('Music default was not 10 percent');count++;\nif(game.errors.length||logs.some(s=>/unknown|non-number|zero radius/.test(s))){for(const e of game.errors)console.error(e.message,e.stack);for(const l of logs)console.error(l);process.exitCode=1;}\nconsole.log(`${count} presentation checks; ${game.errors.length} failures`);game.dispose();\nfor(let sector=0;sector<=4;sector++){\n world.enter(sector);world.entities=[];\n for(const [type,x,y]of [['crystal',480,250],['layer',790,180],['interceptor',960,500],['guard',850,360],['mine',600,400],['mine',680,320],['beacon',1140,338]])world.spawn({type,x,y,state:type==='mine'?'active':'active'});\n if(sector===3){world.camera.x=5500;world.ship.x=5210;world.spawn({type:'carrier',x:5560,y:337.5,w:260,h:310});world.spawn({type:'organ',x:5388,y:160});world.spawn({type:'core',x:5390,y:337.5});}\n world.emit('rescue',world.ship.x+90,230);world.emit('collapse',world.ship.x+100,400);world.emit('warp',world.ship.x,world.ship.y,{dx:1,dy:0});\n for(const phase of ['rescue','organs','prisoners','core','extract']){world.phase=phase;world.time+=1;game.advance(.025,{draw:true});count++;}\n}\nif(a.native.musicVolume!==.1)throw Error('Music default was not 10 percent');count++;\nif(game.errors.length||logs.some(s=>/unknown|non-number|zero radius/.test(s))){for(const e of game.errors)console.error(e.message,e.stack);for(const l of logs)console.error(l);process.exitCode=1;}\nconsole.log(`${count} presentation checks; ${game.errors.length} failures`);game.dispose();\nbuild.mjs\npresentation-check.mjs\n","exit_code":0,"status":"completed"}}
