{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"rg -n 'advance\\\\(seconds|advance\\\\(s|advance\\\\(' 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/vendor/engine-repo/dist/handoff/my-3d2dge.js' | head -12 && sed -n '2910,2948p' 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/vendor/engine-repo/dist/handoff/my-3d2dge.js' && sed -n '1,90p' 'Freedom-Warp-Rescue-Freedom-Fighters-gpt-6.1-sol-ultra-20261106-023037/tools/hub-browser.py'\"","aggregated_output":"59: * 11. TESTS. new E.Game({ headless: true }) (the default in Node) runs with no screen: game.advance(1) runs 120 fixed\n2319:   *   scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\n2321:   * - loop: false makes a game in a page that runs only by advance()\n2713:   * by advance().\n2838:   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\n2842:  advance(seconds = this.o.step, o = {}) {\n2843:    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n10870:pc.act('pickup', 'key'); game.advance(8);\n11451:for (let s = 0; s < 300 && m.phase !== 'over'; s++) game.advance(1);\n13162:  game.advance(1 / 120); const s = game.audio.pos.step;\n14199:const press = n => { for (let i = 0; i < n; i++) { game.input.tap('confirm'); game.advance(.5); } };\n14417:rts.order([w], 'gather', mine); rts.train(hall, 'worker'); game.advance(20);\n    if (ok('input')) this.input.use(s.input);\n    if (ok('res') || ok('expand')) this.screen.setOptions(Object.assign(ok('res') ? { res: s.res } : {}, ok('expand') ? { expand: s.expand } : {}));\n    if (ok('touch')) this.input.touchButtons(s.touch);\n    ok('camera');\n    if (s.propSize !== undefined) { s._propWas = E.style.propSize; E.style.propSize = s.propSize; }   // scene option: prop scale while this scene runs\n    this._zoomFit(true);   // its camera: its zoom to start at, and whether the player's applies\n    if (s.pausable || name === 'main') this._fsAuto = this._autoFull();   // a game starting from a tap goes full screen again\n    for (const f of HOOKS.enter) f(this, old);\n    this._ownRun('enter', name, data);\n    if (s.enter) s.enter(data);\n  }\n  /** report an error in game code without stopping the game: logged once per place and message, kept in game.errors\n   *  and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err) */\n  fail(where, e) {\n    const msg = (e && e.message) || String(e), key = where + ':' + msg;\n    if (!this._errKeys.has(key)) {\n      this._errKeys.add(key); this.errors.push({ where, scene: this.sceneName, message: msg, stack: e && e.stack });\n      console.error('my-3D2dge: error in ' + where + (this.sceneName ? ' (scene \"' + this.sceneName + '\")' : '') + ': ' + ((e && e.stack) || msg));\n    }\n    E.showError('error in ' + where + '()' + (this.sceneName && this.sceneName !== 'main' ? ' of scene \"' + this.sceneName + '\"' : ''), e);\n    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n\"\"\"Actual AI Hub harness checks. Uses only a private OS-assigned loopback server.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport functools\nimport http.server\nimport json\nimport threading\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import Error as PlaywrightError\nfrom playwright.sync_api import sync_playwright\n\nDEV = Path(__file__).resolve().parents[1]\nROOT = DEV.parent\nBUILD = \"FWR-20261106-023037\"\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, _format, *args):\n        pass\n\n\ndef coop_round(browser, harness_url, game_url, artifact_dir):\n    \"\"\"Two actual Hub frames complete the mission through their own seat inputs.\"\"\"\n    context = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n    page = context.new_page()\n    page.set_default_timeout(240_000)\n    errors = []\n    warnings = []\n    page.on(\"pageerror\", lambda error: errors.append(str(error)))\n    page.on(\n        \"console\",\n        lambda message: (\n            warnings.append(message.text)\n            if message.text.startswith(\"[AIHub]\")\n            else None\n        ),\n    )\n    report = None\n    try:\n        params = {\n            \"game\": game_url,\n            \"players\": 2,\n            \"seed\": 1982,\n            \"latency\": 0,\n            \"jitter\": 0,\n            \"loss\": 0,\n            \"limit\": 1200,\n        }\n        page.goto(harness_url + \"?\" + urlencode(params), wait_until=\"domcontentloaded\")\n        page.wait_for_function(\"\"\"() => {\n          const frames=[...document.querySelectorAll('iframe')];\n          return frames.length===2 && frames.every(f=>f.contentWindow.FWR?.debug?.identity==='FWR-20261106-023037');\n        }\"\"\")\n        page.locator(\"#release\").click()\n        page.wait_for_function(\n            \"\"\"() => [...document.querySelectorAll('iframe')].every(f=>f.contentWindow.FWR?.debug?.net?.started)\"\"\"\n        )\n        report = page.evaluate(\"\"\"async () => {\n          const copies=[...document.querySelectorAll('iframe')].map(f=>f.contentWindow);\n          const host=copies.find(w=>w.FWR.debug.net.isHost), remote=copies.find(w=>!w.FWR.debug.net.isHost);\n          for(const w of copies) w.FWR.debug.externalClock=true;\n          const milestones=[],start=performance.now();\n          let iterations=0,lastSector=-1;\n          while(!host.FWR.debug.net.world.outcome && host.FWR.debug.net.world.time<1200 && performance.now()-start<210000) {\n            const hd=host.FWR.debug,rd=remote.FWR.debug;\n            const p=host.FWR.botIntent(hd.net.world),n=remote.FWR.botIntent(rd.net.world);\n            // Each copy supplies exactly its own local seat. Authority resolves\n            // pilot movement and remote navigator aim/hyperspace in the usual way.\n            hd.inject('local-1',{...p,ax:0,ay:0,burst:false});\n            rd.inject('local-1',n);\n            rd.advance(.1);\n            hd.advance(.1);\n            if(hd.net.world.sector!==lastSector) {\n              lastSector=hd.net.world.sector;\n              milestones.push({sector:lastSector,time:hd.net.world.time,hull:hd.net.world.ship.hull,rescued:hd.net.world.rescued.length});\n            }\n            iterations++;\n            await new Promise(resolve=>setTimeout(resolve,10));\n          }\n          host.FWR.debug.release();remote.FWR.debug.release();\n          // Continue transport ticks after the latched outcome, allowing the\n          // final snapshot and single finish to reach the other actual frame.\n          for(let i=0;i<65;i++) {\n            host.FWR.debug.advance(1/120);remote.FWR.debug.advance(1/120);\n            await new Promise(resolve=>setTimeout(resolve,10));\n          }\n","exit_code":0,"status":"completed"}}
