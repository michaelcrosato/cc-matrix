   return e;\n    }\n    enter(index, initial = false) {\n      const checkpointOrigin = { nextId: this.nextId, rngState: this.rngState };\n      this.sector = index;\n      this.sectorTime = 0;\n      this.entities = [];\n      this._shots.clear();\n      this.spawned = [];\n      this.events = [];\n      this.localRescued = 0;\n      this.localLost = 0;\n      this.keyKills = 0;\n","exit_code":0,"status":"completed"}}
