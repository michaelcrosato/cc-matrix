.rescued, 'RESCUED']],\n        actions: this._isHub() ? [] : [['Retry checkpoint', () => this._emit('retry')], ['Restart operation', () => this._emit('restart')], ['Return to title', () => this._emit('title')]]\n      });\n    }\n    showAbout(page = 0) {\n      const report = this.o.report || F.REPORT || {}, source = report.sourceInformation || {};\n      const pages = [\n        { title: 'Source Information', kicker: 'ABOUT / CREDITS · 1', sections: [['ORIGINAL INSPIRATION', `${source.source || 'unknown'} · ${source.date || 'unknown'}`], ['THE GAME', `${source.genre || 'unknown'} · ${source.perspective || 'unknown'}\\nPlan: ${source.plan || 'unknown'}`], ['TECH & ART', `${source.tech || 'unknown'}\\n${source.artDirection || 'unknown'}\\n${source.animation || 'unknown'}`]] },\n        { title: 'Source Information', kicker: 'ABOUT / CREDITS · 2', sections: [['SOUND & ONLINE', `${source.audio || 'unknown'}\\n${source.online || 'unknown'}`], ['RESEARCH', source.research || 'unknown'], ['TESTING', source.testing || 'unknown'], ['BUILD', `${source.environment || 'unknown'}\\n${source.model || 'unknown'}\\nUsage: ${source.usage || 'added on import'}`]] },\n        ...['testingFeedback', 'engineFeedback', 'promptFeedback'].flatMap((key, group) => {\n          const vals = report[key] || [], questions = FEEDBACK_QUESTIONS[key], name = ['Testing Feedback', 'Engine Feedback', 'Prompt Feedback'][group];\n          const chunks = [];\n          for (let i = 0; i < questions.length; i += 2) chunks.push({ title: name, kicker: `ABOUT / CREDITS · ${chunks.length + 1}`, sections: questions.slice(i, i + 2).map((q, j) => [q.toUpperCase(), String(vals[i + j] || 'unknown')]) });\n          return chunks;\n        })\n      ];\n      page = (page + pages.length) % pages.length;\n      const spec = pages[page];\n      return this._show('about', { ...spec, kicker: `${spec.kicker} · PAGE ${page + 1}/${pages.length}`, actions: [['Next page', () => this.showAbout(page + 1)], ['Previous page', () => this.showAbout(page - 1)], ['Back', () => this.shell.back()]] });\n    }\n    _buildMenuButton() {\n      if (typeof document === 'undefined' || this.game.headless) return;\n      const b = this.menuButton = document.createElement('button'); b.className = 'fwr-menu-button'; b.textContent = 'Ⅱ'; b.setAttribute('aria-label', 'Pause / flight deck'); b.hidden = true;\n      b.onclick = () => { if (this.o.onAction) this._emit('pause'); };\n      document.body.appendChild(b);\n    }\n    _decorate() {\n      const root = this.shell.root; if (!root) return;\n      root.dataset.screen = this.shell.screen || 'game';\n      const online = this._isHub(), screen = this.shell.screen;\n      if (screen === 'dev' && !root.querySelector('[data-fwr-seed]')) {\n        const panel = root.querySelector('.esh-mod');\n        if (panel) {\n          const row = document.createElement('div'); row.className = 'esh-row fwr-seed-row';\n          const label = document.createElement('label'); label.textContent = 'Deterministic seed'; label.htmlFor = 'fwr-seed';\n          const input = document.createElement('input'); input.type = 'number'; input.min = '1'; input.max = '4294967295'; input.step = '1'; input.id = 'fwr-seed'; input.dataset.fwrSeed = 'true'; input.value = this._devSeed;\n          input.setAttribute('aria-label', 'Deterministic seed'); input.oninput = () => { const n = Number(input.value); if (Number.isInteger(n)) this._devSeed = clamp(n, 1, 4294967295); };\n          row.append(label, input); panel.insertBefore(row, panel.querySelector('.esh-row'));\n          const diag = document.createElement('pre'); diag.className = 'fwr-dev-diagnostics'; diag.setAttribute('aria-label', 'Live mission diagnostics'); panel.insertBefore(diag, row); this._updateDiagnostics();\n        }\n      }\n      if (online && screen && screen.startsWith('dev')) {\n        for (const e of root.querySelectorAll('input, button')) {\n          const text = e.textContent || '', label = e.getAttribute('aria-label') || '';\n          const safe = /Back|Close|Flight variables|Combat variables|Threat variables|Collision overlay|Mine ownership/i.test(text + label);\n          if (!safe) e.disabled = true;\n        }\n      }\n      for (const p of root.querySelectorAll('.esh-m')) if (p.textContent.includes('\\n')) p.style.whiteSpace = 'pre-line';\n    }\n    _updateDiagnostics() {\n      const root = this.shell.root, box = root && root.querySelector('.fwr-dev-diagnostics'); if (!box) return;\n      const w = this._world() || {}, d = this.o.getDevState ? this.o.getDevState() : {}, s = w.ship || {};\n      const objective = typeof w.objective === 'string' ? w.objective : w.objective && (w.objective.text || w.objective.title) || 'unknown';\n      const events = (d.events || w.events || []).slice(-4).map(e => typeof e === 'string' ? e : `${e.id === undefined ? '' : '#' + e.id + ' '}${e.type || 'event'}${e.text ? ': ' + e.text : ''}`).join('\\n');\n      box.textContent = `SEED ${w.seed === undefined ? 'unknown' : w.seed} · ${w.mode || 'operation'} · TICK ${w.tick || 0}\\n${w.sector || 'opening'} / ${w.phase || 'flight'} · HULL ${s.hull === undefined ? '?' : s.hull} · ENERGY ${Math.round(s.energy || 0)}\\nOBJECTIVE ${objective}\\nROLES ${d.roles || (this.input && this.input.coOp ? this.input.swapped ? 'P2 pilot / P1 navigator' : 'P1 pilot / P2 navigator' : 'solo')}\\n${events}`;\n    }\n    update(dt = 0) {\n      void dt;\n      if (this.menuButton) this.menuButton.hidden = !!this.screen || this.context === 'title' || this.context === 'results' || this.context === 'failure';\n      const real = this.game.real || 0;\n      if (real - this._lastDiagnostic > .25) { this._lastDiagnostic = real; this._updateDiagnostics(); }\n    }\n    hide() { this.shell.hide(); this.context = 'play'; if (this.input) this.input.clear(); if (this.menuButton) this.menuButton.hidden = false; return this; }\n    toast(title, text, seconds = 4) { this.shell.toast(title, text, seconds); return this; }\n    dispose() { this.shell.dispose(); if (this.menuButton) this.menuButton.remove(); }\n    _installStyle() {\n      if (typeof document === 'undefined' || this.game.headless || document.getElementById('fwr-shell-style')) return;\n      const style = document.createElement('style'); style.id = 'fwr-shell-style'; style.textContent = `\n.fwr-shell{--paper:#0a1727;--accent:#f4bd77;--ink:#e7f2f1;letter-spacing:.025em}.fwr-shell .esh-sh{background:linear-gradient(90deg,rgba(3,9,19,.91),rgba(3,9,19,.66) 50%,rgba(3,9,19,.22));padding:24px 32px}.fwr-shell .esh-ttl{align-items:center;justify-content:flex-start;text-align:left;padding-left:6vw}.fwr-shell .esh-ttl>div{max-width:430px;position:relative}.fwr-shell .esh-ttl>div:before{content:'';position:absolute;left:-16px;top:4px;width:3px;height:62px;background:#f4bd77;box-shadow:0 0 12px #f4bd7755}.fwr-shell h1{white-space:pre-line;font-size:46px;line-height:.98;font-weight:900;letter-spacing:-.045em;color:#fff4d9;max-width:440px;text-shadow:0 3px 0 #0a1323;margin:12px 0 18px}.fwr-shell .esh-k{color:#f4bd77;font-size:9px;letter-spacing:.17em;font-weight:800}.fwr-shell .esh-sub{font-size:13px;color:#aabec9;line-height:1.5;max-width:300px;margin-bottom:18px}.fwr-shell .esh-btns{display:flex;flex-direction:column;gap:6px;max-width:300px;margin-top:15px}.fwr-shell button{font-size:13px;min-height:31px;padding:8px 12px;border-radius:2px;border:1px solid #41576c;background:rgba(10,27,43,.84);color:#dbe9ee;text-align:left;letter-spacing:.025em}.fwr-shell button.pri{background:#f1bd78;color:#122334;border-color:#ffe2b1;font-weight:900;box-shadow:0 3px 0 #aa753e}.fwr-shell button:focus-visible,.fwr-shell button:focus,.fwr-shell input:focus{outline:2px solid #a2fff0;outline-offset:3px;box-shadow:0 0 15px #7affdd33}.fwr-shell button:hover{border-color:#89c8ce}.fwr-shell button:disabled{opacity:.36}.fwr-shell .esh-mod{border:1px solid #456071;border-top:3px solid #f4bd77;border-radius:3px;background:linear-gradient(145deg,#101f31f7,#07121ff7);box-shadow:0 10px 50px #0008;max-height:90vh;padding:20px 25px;max-width:500px;overflow:auto}.fwr-shell h2{font-size:26px;line-height:1.12;letter-spacing:-.025em;margin:8px 0 12px;color:#fff1d9}.fwr-shell .esh-m{font-size:12px;line-height:1.55;color:#b3c7d0;max-width:440px}.fwr-shell .esh-sec{margin-top:15px;margin-bottom:5px}.fwr-shell .esh-row{font-size:12px;min-height:40px;gap:16px;border-color:#263d50}.fwr-shell .esh-row button{font-size:11px;min-height:27px;padding:5px 9px;text-align:center}.fwr-shell .esh-row input[type=range]{accent-color:#f4bd77;width:125px}.fwr-shell .esh-ctl output{font-size:10px;color:#a4e6e6;min-width:35px}.fwr-shell .esh-tags{justify-content:flex-start;gap:6px;margin:16px 0}.fwr-shell .esh-tags span{font-size:8px;letter-spacing:.12em;border-color:#375165;color:#86b7c4;padding:5px 7px}.fwr-shell .esh-stats{display:flex;flex-wrap:wrap;gap:18px;margin:18px 0}.fwr-shell .esh-stats b{color:#fff0ce;font-size:30px}.fwr-shell .esh-stats small{font-size:8px;color:#97c8cf}.fwr-shell .esh-bind{font-size:11px;gap:6px}.fwr-shell .esh-bind button{font-size:10px;padding:6px}.fwr-shell .esh-nav{min-width:30px;min-height:30px;padding:6px;text-align:center}.fwr-shell .esh-toast{border-color:#6da49e;background:#0b2034ed;max-width:320px}.fwr-shell .esh-toast b{color:#f5d397}.fwr-shell .esh-toast p{font-size:11px}.fwr-dev-diagnostics{font:9px/1.6 monospace;white-space:pre-wrap;color:#91c7cb;border:1px solid #2a4458;background:#05101d;padding:10px;max-width:435px}.fwr-seed-row input{width:135px;font:12px monospace;color:#e6f6f5;background:#0c2032;border:1px solid #537288;padding:7px}.fwr-menu-button{position:fixed;z-index:18;right:max(20px,env(safe-area-inset-right));top:max(18px,env(safe-area-inset-top));width:46px;height:42px;color:#d9f6f0;background:#071b2bb8;border:1px solid #7babae66;border-radius:5px;font:800 20px system-ui;touch-action:none}.fwr-menu-button[hidden],.fwr-touch-warp[hidden]{display:none!important}.fwr-shell[data-screen=title] .esh-ttl .esh-m{font-size:10px;max-width:330px}.fwr-shell .esh-emb{font-size:38px;color:#9af5de}\n@media(max-width:740px){.fwr-shell .esh-sh{padding:12px 16px}.fwr-shell .esh-ttl{padding-left:6vw;align-items:center}.fwr-shell h1{font-size:37px}.fwr-shell .esh-ttl>div{max-width:350px}.fwr-shell .esh-mod{padding:16px;max-height:92vh}.fwr-shell .esh-row{gap:10px}.fwr-shell .esh-ctl input[type=range]{width:96px}.fwr-shell .esh-row{font-size:12px}.fwr-shell .esh-tags{margin:10px 0}.fwr-shell .esh-ttl .esh-sub{font-size:12px}.fwr-shell .esh-ttl .esh-btns{gap:5px;margin-top:10px}.fwr-shell .esh-ttl button{min-height:29px;padding:7px 10px;font-size:12px}.fwr-shell .esh-ttl .esh-k{font-size:8px}.fwr-shell .esh-bind{font-size:9px}.fwr-shell .esh-bind button{font-size:9px;padding:5px}}@media(max-height:500px){.fwr-shell h1{font-size:34px}.fwr-shell .esh-ttl{align-items:flex-start;padding-top:16px}.fwr-shell .esh-sub{display:none}.fwr-shell .esh-ttl .esh-btns{gap:3px;margin-top:8px}.fwr-shell .esh-ttl button{min-height:24px;padding:5px 10px}.fwr-shell .esh-ttl .esh-tags{margin:9px 0}.fwr-shell .esh-ttl footer{display:none}}`;\n      document.head.appendChild(style);\n    }\n  }\n  F.DEFAULT_SETTINGS = DEFAULT_SETTINGS; F.Store = Store; F.UI = UI; F.CONFIG_UI = CONFIG;\n})(globalThis.FWR = globalThis.FWR || {});\n/* Freedom Warp Rescue — native shaded part art and continuous state-driven poses.\n * The local part-frame convention extends the supplied horizontal shooter kit.\n * All pixels, lighting, outlines, palettes, shape props and text use my-3D2dge.\n */\n(() => {\n  'use strict';\n  const F = globalThis.FWR ||= {};\n  const TAU = Math.PI * 2;\n  const clamp = (v,a,b) => Math.max(a,Math.min(b,v));\n  const finite = (v,d=0) => Number.isFinite(v) ? v : d;\n  const mix = (a,b,t) => a+(b-a)*t;\n  const wrap = (v,n) => ((v%n)+n)%n;\n  const PALETTES = {\n    ship:{hull:'#f0c277',wing:'#ca7152',trim:'#f7e6bb',glass:'#64e6ec',dark:'#354652'},\n    layer:{hull:'#ae7252',wing:'#de8751',trim:'#f8d995',glass:'#ff735f',dark:'#493d56'},\n    guard:{hull:'#9c5268',wing:'#5a536e',trim:'#ff8c85',glass:'#ffc879',dark:'#35324c'},\n    interceptor:{hull:'#b6b8ce',wing:'#656980',trim:'#f16c70',glass:'#ffcaa2',dark:'#34364d'},\n    carrier:{hull:'#66556f',wing:'#3a3f57',trim:'#c89c82',glass:'#f4a474',dark:'#282b41'},\n  };\n  // Parts are one half of a symmetric silhouette, in a frame u=across, v=forward.\n  const art = str => str.split('|').map(s=>{const [kind,...q]=s.trim().split(/\\s+/); return [kind,q.map(v=>v.split(',').map(Number))];});\n  const SHIP = art('fire 6,-21|wing 3,-5 16,-13 17,-20 5,-15|wingHi 3,-5 16,-13 16,-15 4,-8|trim 13,-13 17,-15 17,-20 13,-18|dark 4,5 9,2 10,-19 4,-21|hull 0,27 3,24 7,11 7,-14 3,-22 0,-22|hullHi 0,25 3,21 5,10 4,-14 0,-19|wing 4,13 20,2 18,-6 6,1|wingHi 5,12 18,2 17,0 6,4|trim 16,3 20,2 18,-6 15,-4|glass 0,16 3,13 4,5 0,1|sheen 0,14 1,13 2,6 0,4|dark 0,-12 3,-13 3,-18 0,-18|line 5,11 6,-9 3,-18|line 8,2 15,-1|mark 12,0,1.7');\n  const INTERCEPTOR = art('fire 0,-17|wing 2,1 15,-6 16,-15 4,-9|wingHi 3,0 14,-6 14,-8 4,-5|trim 13,-6 16,-8 16,-15 13,-13|hull 0,20 3,15 5,4 4,-13 0,-17|hullHi 0,18 2,13 3,3 2,-11 0,-14|glass 0,12 2,9 2,4 0,1|line 4,-3 11,-8|mark 10,-9,1.3');\n  const GUARD = art('fire 5,-15|wing 3,8 20,15 24,9 20,-14 7,-20|wingHi 5,6 20,12 21,8 17,-10 7,-16|dark 7,6 14,8 16,3 12,-11 7,-15|trim 17,12 22,11 24,9 20,-14 18,-12|hull 0,13 5,10 7,-12 3,-19 0,-19|hullHi 0,11 3,8 4,-11 0,-15|glass 0,6 3,5 3,-1 0,-3|mark 0,-9,2');\n  const TONES = ['deep','sh','base','lt','hi'];\n\n  function defineAssets(E){\n    if(E.SHAPES['fwr:fragment'])return;\n    E.MATERIALS['fwr:steel']={color:'#46546a',pattern:'metal',rivet:.4};\n    E.MATERIALS['fwr:prison']={color:'#756582',pattern:'metal',rivet:.7};\n    E.MATERIALS['fwr:signal']={color:'#71dce2',pattern:'none',glow:1};\n    E.SHAPES['fwr:fragment']={about:'broken orbital prison beam with cold signal strip',mats:{s:'fwr:steel',p:'fwr:prison',g:'fwr:signal'},parts:[['box','s',[0,0,0],[42,14,8]],['box','p',[-10,0,8],[10,17,4]],['box','p',[10,0,8],[10,17,4]],['box','g',[0,0,9],[8,2,2]]]};\n    E.SHAPES['fwr:relay']={about:'original evacuation relay with hexagonal collar and beacon',mats:{s:'fwr:steel',g:'fwr:signal'},parts:[['cyl','s',[0,0,0],13,5,{seg:6}],['cyl','s',[0,0,5],7,6,{seg:6}],['box','g',[0,0,11],[3,3,13]],['mirror','x',['box','s',[19,0,1],[20,9,2]]]]};\n    F.assetParts={ship:SHIP,interceptor:INTERCEPTOR,guard:GUARD};\n  }\n\n  class Presentation{\n    constructor(E,game){\n      if(game===undefined){game=E;E=globalThis.My3D2dge;}\n      this.E=E;this.game=game;this.effects=[];this.lastEvent=0;this.run=null;\n      this.projection={scale:.5,cx:600,cy:337.5,W:600,H:338};\n      this.bank=0;this.recoil=0;this.lastHull=3;this.lastTime=0;\n      this.pals={};for(const [id,p]of Object.entries(PALETTES)){this.pals[id]={};for(const [k,col]of Object.entries(p))this.pals[id][k]=E.tones(col);}\n      defineAssets(E);\n      if(game.lights){game.lights.enabled=true;game.lights.ambient=.87;}\n      if(game.r){game.r.outline='#0b1523';game.r.rim='#a5ebec';game.r.rimAlpha=.16;}\n    }\n    screenToWorld(x,y){const p=this.projection;return {x:(x-p.W/2)/p.scale+p.cx,y:(y-p.H/2)/p.scale+p.cy};}\n    worldToScreen(x,y){const p=this.projection;return {x:(x-p.cx)*p.scale+p.W/2,y:(y-p.cy)*p.scale+p.H/2};}\n    render(world,dt,options={}){if(options.r)this.draw(options.r,world,{...options,dt});}\n    _ring(g,x,y,r,col,width=1,start=0,end=TAU){\n      const px=this.E.px,n=Math.max(16,Math.ceil(r*1.5)),span=end-start;let old=null;\n      for(let i=0;i<=n;i++){const a=start+span*i/n,q=[x+Math.cos(a)*r,y+Math.sin(a)*r];if(old)px.line(g,...old,...q,col,width);old=q;}\n    }\n    _glow(g,x,y,r,col,alpha=.5){\n      const px=this.E.px;\n      px.blend(g,alpha*.13,'add',()=>px.disc(g,x,y,r,col));\n      px.blend(g,alpha*.24,'add',()=>px.disc(g,x,y,r*.65,col));\n      px.blend(g,alpha*.42,'add',()=>px.disc(g,x,y,r*.32,col));\n    }\n    _craft(g,x,y,angle,bank,parts,pal,scale,time,drive=0,fade=1){\n      const E=this.E,px=E.px,P=(u,v)=>[x+(v*Math.cos(angle)-u*Math.sin(angle))*scale,y+(v*Math.sin(angle)+u*Math.cos(angle))*scale];\n      const lit=Math.sin(angle)>Math.cos(angle)?1:-1;\n      for(const [kind,pts]of parts){\n        if(kind==='fire'){\n/* Freedom Warp Rescue — original code-defined instruments, score, radio babble and effects.\n * Native my-3D2dge music/sfx clock and volume buses form the audio foundation.\n */\n(() => {\n  'use strict';\n  const F=globalThis.FWR ||= {};\n  const clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,Number.isFinite(v)?v:a));\n  const NOTES='D5 . A4 . F5 . E5 . | D5 . C5 . A4 . G4 . | D5 . A4 . F5 . G5 . | E5 . C5 . A4 . . .';\n  const SONGS={\n    flight:{bpm:104,steps:4,tracks:[\n      {name:'pulse',wave:'fwr-pluck',vol:.18,notes:NOTES},\n      {name:'bass',wave:'triangle',vol:.16,notes:'D2 - . D3 . . A2 . | C2 - . C3 . . G2 . | Bb1 - . Bb2 . . F2 . | C2 - . A2 . . C3 .'},\n      {name:'space',wave:'fwr-pad',vol:.085,notes:'D4 - - - A3 - - - | C4 - - - G3 - - - | Bb3 - - - F4 - - - | C4 - - - E4 - - -'},\n      {name:'threat',wave:'drums',vol:.35,on:false,notes:'k . h . . . h . | k . h . s . h . | k . h . . . h . | k . h h s . h .'},\n      {name:'rescue',wave:'fwr-bell',vol:.075,on:false,notes:'A5 . . . F5 . . . | G5 . . . E5 . . . | F5 . . . D5 . . . | E5 . . . A5 . . .'},\n    ]},\n    carrier:{bpm:112,steps:4,tracks:[\n      {name:'pulse',wave:'fwr-pluck',vol:.16,notes:'D4 . A4 D5 . F5 A4 . | D4 . Bb4 D5 . G5 Bb4 . | C4 . G4 C5 . E5 G4 . | A3 . E4 A4 . C5 E4 .'},\n      {name:'bass',wave:'triangle',vol:.19,notes:'D2 . D2 . A2 . D3 . | Bb1 . Bb1 . F2 . Bb2 . | C2 . C2 . G2 . C3 . | A1 . A1 . E2 . A2 .'},\n      {name:'space',wave:'fwr-pad',vol:.08,notes:'D3 - - - F3 - - - | Bb2 - - - D3 - - - | C3 - - - E3 - - - | A2 - - - C3 - - -'},\n      {name:'threat',wave:'drums',vol:.4,notes:'k . h . s . h . | k k h . s . h h | k . h . s . h . | k . h h s . h h'},\n    ]},\n    victory:{bpm:108,steps:4,loop:false,tracks:[\n      {wave:'fwr-bell',vol:.2,notes:'D5 . F5 . A5 . D6 - | C6 . A5 . G5 . F5 - | E5 . F5 . A5 . G5 . | D6 - - - - - - -'},\n      {wave:'fwr-pad',vol:.13,notes:'D4 - - - F4 - - - | C4 - - - E4 - - - | Bb3 - - - G4 - - - | D4 - - - - - - -'},\n    ]},\n    failure:{bpm:88,steps:4,loop:false,tracks:[\n      {wave:'fwr-pluck',vol:.18,notes:'A4 - . . F4 - . . | E4 - . . C4 - . . | D4 - - - - - - -'},\n      {wave:'fwr-pad',vol:.12,notes:'D3 - - - - - - - | C3 - - - - - - - | D2 - - - - - - -'},\n    ]},\n  };\n  const SOUNDS={\n    cannon:[{wave:'pulse12',freq:780,to:180,dur:.075,vol:.09,attack:.003},{wave:'sine',freq:190,to:80,dur:.06,vol:.07}],\n    arming:{wave:'sine',freq:520,to:720,dur:.07,vol:.08},\n    collapse:[{wave:'noise',freq:2400,to:120,dur:.42,vol:.14,filter:'lowpass'},{wave:'triangle',freq:440,to:90,dur:.38,vol:.11}],\n    crystalWarning:[{wave:'sine',freq:1200,to:700,dur:.18,vol:.11},{wave:'triangle',freq:1760,to:900,dur:.13,vol:.07}],\n    rescue:[{wave:'fwr-bell',freq:587.33,arp:[0,3,7,12],step:.065,dur:.43,vol:.2},{wave:'sine',freq:293.66,to:587.33,dur:.32,vol:.07}],\n    windup:{wave:'saw',freq:95,to:420,dur:.16,vol:.08,attack:.03},\n    warp:[{wave:'noise',freq:800,to:4200,dur:.32,vol:.11},{wave:'sine',freq:140,to:1000,dur:.4,vol:.13,attack:.018}],\n    denied:{wave:'triangle',freq:155,to:95,dur:.13,vol:.13},\n    damage:[{wave:'noise',freq:1700,to:100,dur:.3,vol:.19,filter:'lowpass'},{wave:'triangle',freq:110,to:45,dur:.3,vol:.17}],\n    explosion:[{wave:'noise',freq:1600,to:80,dur:.5,vol:.2,filter:'lowpass'},{wave:'sine',freq:95,to:32,dur:.42,vol:.14}],\n    focus:{wave:'sine',freq:610,to:730,dur:.035,vol:.08},\n    confirm:{wave:'fwr-pluck',freq:587.33,arp:[0,7,12],step:.045,dur:.18,vol:.14},\n    checkpoint:{wave:'fwr-bell',freq:440,arp:[0,5,12,17],step:.07,dur:.48,vol:.17},\n    loss:[{wave:'noise',freq:2500,to:400,dur:.24,vol:.1},{wave:'sine',freq:880,to:220,dur:.35,vol:.13}],\n  };\n  // Instruments use ordinary Web Audio nodes, but run through native engine notes and bus gain.\n  function instrument(kind,ctx,bus,t,freq,dur,vol,track){\n    const o=ctx.createOscillator(),gain=ctx.createGain();\n    o.type=kind==='pad'?'triangle':kind==='bell'?'sine':'triangle';o.frequency.setValueAtTime(freq,t);\n    gain.gain.setValueAtTime(0,t);gain.gain.linearRampToValueAtTime(vol, t+(kind==='pad'?.035:.004));\n    gain.gain.exponentialRampToValueAtTime(.0001,t+Math.max(.05,dur));\n    o.connect(gain);gain.connect(bus);o.start(t);o.stop(t+dur+.04);track?.(o,gain,t+dur+.04);\n    if(kind==='bell'){\n      const a=ctx.createOscillator(),g=ctx.createGain();a.type='sine';a.frequency.setValueAtTime(freq*2.003,t);\n      g.gain.setValueAtTime(vol*.22,t);g.gain.exponentialRampToValueAtTime(.0001,t+dur*.55);a.connect(g);g.connect(bus);a.start(t);a.stop(t+dur+.03);track?.(a,g,t+dur+.03);\n    }\n  }\n  // Deliberately non-lexical radio syllables: pitched glottal pulses with shifting vowel-like formants.\n","exit_code":0,"status":"completed"}}
