ettings\");\n            },\n          ],\n        ],\n      });\n    }\n    showControls() {\n      return this._show(\"controls\", {\n        kicker: \"STEERING & REBINDING\",\n        title: \"Your controls\",\n        text: \"Touch: drag the left half to steer; touch the right half to aim. Double tap the right half or use the contact WARP button to burst. Assisted targeting fires only along clear enemy lanes.\",\n        sections: [\n          [\n            \"SHARED-SHIP ROLES\",\n            \"Pilot owns conventional flight. Navigator owns aim and hyperspace. Either seat fires the same cannon. A neutral hyperspace stick uses your last aim bearing.\",\n          ],\n        ],\n      });\n    }\n    confirm(title, text, label, fn) {\n            m.disarmAt = m.age;\n          }\n        const carrier = this.entities.find((q) => q.type === \"carrier\");\n        if (carrier) {\n          carrier.state = \"dying\";\n          carrier.solid = false;\n          carrier.deathTime = this.time;\n        }\n        this.radio(\"Core disabled. Take the open route past the carrier. Evacuation is ahead.\");\n      }\n      if (e.type === \"mine\") {\n        if (by === \"laser\") this.score++;\n      } else if (e.type !== \"carrier\") this.score += 5;\n      this.emit(e.type === \"mine\" ? \"mineHit\" : \"explosion\", e.x, e.y, {\n        target: e.id,\n        kind: e.type,\n      });\n    }\n    replacement() {\n      const available = this.entities.filter(\n        (e) => e.type === \"crystal\" && !e.dead && !e.optional,\n      ).length;\n      const pending =\n        this.mode === \"evasion\"\n          ? 0\n          : this.definition.spawns.filter(\n              (e, i) => e.type === \"crystal\" && !e.optional && !this.spawned.includes(i),\n            ).length;\n      if (\n        this.localRescued + available + pending >= this.quota ||\n        this.phase === \"organs\" ||\n        this.mode === \"evasion\"\n      )\n        return;\n      if (!this.replacementTimer) this.replacementTimer = 3;\n      this.replacementTimer -= F.STEP;\n      if (this.replacementTimer <= 0) {\n        const needed = this.quota - this.localRescued - available - pending;\n        for (let i = 0; i < needed; i++)\n          this.spawn({\n            type: \"crystal\",\n            x: clamp(this.ship.x + 350 + i * 100, 100, this.length - 350),\n","exit_code":0,"status":"completed"}}
