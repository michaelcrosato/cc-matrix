t None: print('>', json.dumps(r)[:600])\n    print('\\n'.join(logs[:25]))\n    b.close()\nEOF\npython3 test/shot.py /tmp/shots/a_ \"shot:title;;wait:500;;key:Enter;;wait:1500;;shot:play;;JSON.stringify(d.snapshot())\" 1280 720","uuid":"25f18409-3a73-4708-b4a3-feefbfa15325","session_id":"ca45a593-66ad-492b-ba14-15d9cf0373b1"}
