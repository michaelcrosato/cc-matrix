ion and PlayStation glyphs on hardware.\n\nFiles are in `/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium__20261102-181331__x22cc1b/work`:\n- `WireTapDance-TheWire-claude-sonnet-5-5-medium-20261102-181331.html`\n- `exit-interview.json`\n- `WireTapDance-TheWire-claude-sonnet-5-5-medium-20261102-181331/` (sources and tests)","ttft_ms":1239,"type":"result","duration_ms":1417822,"uuid":"385093b5-2f82-4c9b-a0c9-9506085d9248","ttft_stream_ms":596,"time_to_request_ms":34,"first_content_frame_ms":596,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-sonnet-5-5":{"inputTokens":160,"outputTokens":147294,"cacheReadInputTokens":15948785,"cacheCreationInputTokens":293064,"webSearchRequests":0,"costUSD":3.8007985000000017,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":59921,"cacheCreationEphemeral5mInputTokens":293064,"cacheCreationEphemeral1hInputTokens":0,"canonicalModel":"claude-sonnet-5-5","provider":"firstParty","costBasis":"list"},"claude-haiku-5-5":{"inputTokens":4,"outputTokens":1589,"cacheReadInputTokens":872,"cacheCreationInputTokens":236779,"webSearchRequests":0,"costUSD":0.152004975,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1233,"cacheCreationEphemeral5mInputTokens":236779,"cacheCreationEphemeral1hInputTokens":0,"canonicalModel":"claude-haiku-5-5","provider":"firstParty","costBasis":"list"}}}
