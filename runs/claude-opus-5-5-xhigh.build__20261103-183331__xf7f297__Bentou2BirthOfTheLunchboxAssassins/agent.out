ICK RACE | 8 craft (player + 7 AI) | on | laps 1–5 (default 3); place = result | gold 1st, silver 2nd, bronze 3rd |","-| TIME TRIAL | solo | off (pads dark) | 3 laps; ghost of your best run (§3.13) | per track/class times (§4.3), calibrated |","+| TIME TRIAL | solo | off (pads dark) | 3 laps; ghost of your best run (§3.13) | per track/class times, measured (§4.2) |"," | HOT LAP | solo, flying start (spawn 300 m before the line at 80 % top) | off | unlimited laps; the best lap counts; End run in the pause menu (or 10 laps) | per track/class lap times |"," | SNIPEOUT | 8 craft | on, offensive-weighted table, no AUTOPILOT | +1 per hit landed, +3 per elimination, +1 bonus for a RAILSHOT elimination (\"SNIPED\"); respawns; first to target (10 or 12) or most after 5 min | 1st/2nd/3rd |"," | OVERCLOCK | solo, neon skin | off; speed pads off | automatic thrust; zone n every 12 s: `top = SPARK·(0.75 + 0.06·n)`; walls ×1.5 damage; +5 energy per zone cleared; ends at 0 energy | bronze zone 10, silver 20, gold 30, \"OVERCLOCKED\" 40 |"]},{"oldStart":661,"oldLines":9,"newStart":661,"newLines":9,"lines":[" | **BULWARK** (blue) | tap | invulnerable for 4 s (walls too); no pickups meanwhile | blocks everything | +12 |"," | **AUTOPILOT** (teal) | tap | the AI drives for 5 s (skill 1.0); the HUD counts it down; ends early after a rescue | — | +10 |"," | **NITRO** (amber) | tap | boost 2.2 s, `boostMul 1.35`, thrust ×2 | — | +10 |","-| **SIPHON** (lime) | hold to aim, auto | beam to the nearest craft ahead within 1500 u (line of sight along the track) for 3 s; breaks beyond 1900 u | drains 9/s from the target into you | +20 |","+| **SIPHON** (lime) | tap: it latches onto the nearest craft ahead by itself | beam to the nearest craft ahead within 1500 u (along the track) for 3 s; breaks beyond 1900 u | drains 9/s from the target into you | +20 |"," ","-- **Absorb** (○ / Shift / right click): consumes the weapon and adds its absorb value. Hub: `absorbMul`.","+- **Absorb** (○ / Shift / right click): consumes the weapon and adds its absorb value × the `absorbMul` slider."," - **One weapon at a time.** A pad gives nothing while a weapon is held, or while BULWARK or AUTOPILOT runs."," - **Pickup roll:** weighted by position. Pick the table by `pos ∈ {1,2}` front, `{3..5}` mid, `{6..8}` back, then","   apply `pickupLuck` (0 = uniform, 1 = table, 2 = table squared)."]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174740__x7ef5ea/agent.out","hunks":[{"oldStart":2146,"oldLines":3,"newStart":2146,"newLines":4,"lines":[" {\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":1950,\"estimated_tokens_delta\":150,\"session_id\":\"5176bdbd-8f33-407b-b89e-9fc1c745933d\",\"uuid\":\"81609e4f-7aa1-48bb-b392-99979fc63dfa\"}"," {\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":2100,\"estimated_tokens_delta\":150,\"session_id\":\"5176bdbd-8f33-407b-b89e-9fc1c745933d\",\"uuid\":\"2fc4f72c-5e4b-4062-a4fd-c33bf425cbb8\"}"," {\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":2200,\"estimated_tokens_delta\":100,\"session_id\":\"5176bdbd-8f33-407b-b89e-9fc1c745933d\",\"uuid\":\"b0de8b56-fbe3-4d24-bd9a-7efbf3492643\"}","+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":2300,\"estimated_tokens_delta\":100,\"session_id\":\"5176bdbd-8f33-407b-b89e-9fc1c745933d\",\"uuid\":\"898afff0-9197-44ed-b17e-88e6d420e9ba\"}"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/agent.out","hunks":[{"oldStart":491,"oldLines":3,"newStart":491,"newLines":6,"lines":[" {\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":700,\"estimated_tokens_delta\":100,\"session_id\":\"a0704575-f16b-44ea-a24d-907e9c278025\",\"uuid\":\"db08f3b4-478c-4643-b6ae-5dbbb40a2f61\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011Cgh3C4EkKk8MDKaTAe67z\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":13530,\"cache_read_input_tokens\":259696,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":13530},\"output_tokens\":6,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"a0704575-f16b-44ea-a24d-907e9c278025\",\"uuid\":\"d9a298fa-7109-4a01-9165-d7264d2a776a\",\"timestamp\":\"2026-11-04T01:42:33.845Z\",\"request_id\":\"req_011Cgh3C3x91GryeXrkcR52E\",\"thinking_duration_ms\":9186,\"thinking_display\":\"updates\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011Cgh3C4EkKk8MDKaTAe67z\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now projectiles: enemy grenades, knives, rockets, missiles, mortar shells, tank shells and flame waves, all shootable except flame. Player grenades go in the same file.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":13530,\"cache_read_input_tokens\":259696,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":13530},\"output_tokens\":6,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"a0704575-f16b-44ea-a24d-907e9c278025\",\"uuid\":\"8e76272e-ad84-4859-b0ee-dfa7f8ea9294\",\"timestamp\":\"2026-11-04T01:42:33.846Z\",\"request_id\":\"req_011Cgh3C3x91GryeXrkcR52E\"}","+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011Cgh3C4EkKk8MDKaTAe67z\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01F4iaocxLJbXZyDLNcZYEUe\",\"name\":\"Write\",\"input\":{\"file_path\":\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009/src/23-projectiles.js\",\"content\":\"// Projectiles (7.7): enemy grenades, knives, rockets, missiles, mortar and tank shells, flame waves; the player's grenade.\\n// An enemy projectile flies from its world start to a point just in front of the camera (re-aimed each step, so it\\n// follows the moving camera), \\\"hits\\\" when it arrives, and can be shot down on the way.\\n(() => {\\nconst E = My3D2dge, WP = globalThis.WP, BEH = WP.BEH, { clamp, lerp } = WP;\\nWP.TYPES.proj = { id: 'proj', kind: 'proj', hp: 1 };\\nWP.TYPES.pgren = { id: 'pgren', kind: 'proj', hp: 1 };\\n\\nconst Proj = WP.Proj = {\\n  launch(sim, from, kind, pid, at) {\\n    const S = WP.PROJ[kind]; if (!S) return null;\\n    const st = at || [from.x, from.y, (from.z || 0) + 20];\\n    const e = sim.spawn('proj', { x: st[0], y: st[1], z: st[2] });\\n    e.ptype = kind; e.pid = pid; e.hp = e.maxHp = S.hits; e.T = S.T / WP.T.projectileSpeed; e.u = 0; e.start = st.slice(); e.src = from.id;\\n    e.endLx = (sim.R.ai() - .5) * (kind === 'grenade' ? 40 : 24); e.endDz = kind === 'grenade' ? 12 : 8;\\n    e.wob = sim.R.ai() * 6.28; e.offOK = true;\\n    if (kind === 'flame') { e.start[2] = 0; e.endDz = 10; }\\n    if (kind === 'mortar') {   // a landing marker on the HUD's top edge\\n      const p = sim.view.project(st[0], st[1], 0); e.markX = p ? clamp(p[0], 12, WP.W - 12) : WP.W / 2;\\n      if (sim.perks.campLocated && from.id) { const f = sim.byId(from.id); if (f) f.marker = 1.5; }\\n    }\\n    sim.ev('proj', { id: e.id, kind, pid, src: from.id || 0 });\\n    return e;\\n  },\\n  /** the player's grenade, lobbed from the camera's lower front to a world point */\\n  throwPlayer(sim, p, target) {\\n    const P = sim.view.P, side = (p.slot - (sim.players.length - 1) / 2) * 30;\\n    const st = [P.x + P.fx * 8 + P.rx * (8 + side), P.y + P.fy * 8 + P.ry * (8 + side), P.h - 6];\\n    const e = sim.spawn('pgren', { x: st[0], y: st[1], z: st[2] });\\n    const dist = Math.hypot(target[0] - st[0], target[1] - st[1]);\\n    e.ptype = 'pgren'; e.pid = p.pid; e.start = st; e.end = target.slice(); e.T = .55 + .0015 * dist; e.u = 0; e.offOK = true; e.hp = 9999;\\n    e.apex = Math.max(20, dist * .18);\\n    sim.ev('pthrow', { pid: p.pid, id: e.id });\\n    return e;\\n  }\\n};\\n\\nBEH.proj = (sim, e, dt) => {\\n  e.t2 = (e.t2 || 0) + dt; e.u = clamp(e.t2 / e.T, 0, 1);\\n  if (e.type === 'pgren') {\\n    const u = e.u, s = e.start, t = e.end;\\n    e.x = lerp(s[0], t[0], u); e.y = lerp(s[1], t[1], u); e.z = lerp(s[2], t[2], u) + e.apex * 4 * u * (1 - u);\\n    if (u >= 1) {\\n      e.gone = true;\\n      const W = WP.T;\\n      sim.explode(t[0], t[1], t[2], W.grenadeRadius, W.grenadeDmg, { by: e.pid, kind: 'pgren' });\\n    }\\n    return;\\n  }\\n  const S = WP.PROJ[e.ptype], P = sim.view.P, u = e.u;\\n  // the end point: just in front of the camera, re-aimed every step\\n  const ex = P.x + P.fx * e.endDz + P.rx * e.endLx, ey = P.y + P.fy * e.endDz + P.ry * e.endLx, ez = S.ground ? 0 : P.h - 8;\\n  const s = e.start;\\n  let x = lerp(s[0], ex, u), y = lerp(s[1], ey, u), z = lerp(s[2], ez, u) + (S.apex || 0) * 4 * u * (1 - u);\\n  if (S.wobble) { x += Math.sin(e.t * 9 + e.wob) * S.wobble * P.rx; y += Math.sin(e.t * 9 + e.wob) * S.wobble * P.ry; z += Math.cos(e.t * 7 + e.wob) * S.wobble * .6; }\\n  if (S.home) { x += Math.sin(e.t * 3 + e.wob) * 10 * (1 - u) * P.rx; y += Math.sin(e.t * 3 + e.wob) * 10 * (1 - u) * P.ry; }\\n  e.vx = (x - e.x) / Math.max(dt, 1e-6); e.vy = (y - e.y) / Math.max(dt, 1e-6); e.vz = (z - e.z) / Math.max(dt, 1e-6);\\n  e.x = x; e.y = y; e.z = z;\\n  if (u >= 1) {\\n    e.gone = true;\\n    const p = sim.players.find(q => q.pid === e.pid) || sim.livePlayers()[0];\\n    const lx = sim.view.lateral(s[0], s[1]);\\n    const dmg = S.dmg * sim.dmgK;\\n    sim.ev('impact', { kind: e.ptype, pid: p ? p.pid : -1, x, y, z });\\n    if (e.ptype === 'grenade' || e.ptype === 'rocket' || e.ptype === 'missile' || e.ptype === 'mortar' || e.ptype === 'shell') sim.ev('explode', { x, y, z, r: 30, big: 0, kind: 'cam' });\\n    if (p) sim.hurtPlayer(p, dmg, { kind: e.ptype, dir: lx < -80 ? -1 : lx > 80 ? 1 : 0 });\\n  }\\n};\\n\\nBEH['shapes:proj'] = (sim, e, out, V) => {\\n  if (e.type === 'pgren' || e.dead || e.gone) return;\\n  const S = WP.PROJ[e.ptype]; if (!S.hits) return;\\n  const p = V.project(e.x, e.y, e.z); if (!p) return;\\n  const D = V.depth(e.x, e.y);\\n  out.push({ e, part: 'proj', D: D - 2, kind: 'c', cx: p[0], cy: p[1], r: Math.max(5, S.r * p[2]) });\\n};\\n\\n/** a hit on a projectile: shot down when its hits run out */\\nProj.hit = (sim, e, p, dmg) => {\\n  if (e.gone || e.dead) return;\\n  e.hp -= 1;\\n  if (e.hp > 0) { sim.ev('projHit', { id: e.id }); return; }\\n  e.dead = true; e.gone = true;\\n  const S = WP.PROJ[e.ptype];\\n  if (p) { p.intercepts++; sim.score(p, S.score, { x: e.x, y: e.y, z: e.z }, { raw: true }); }\\n  sim.ev('intercept', { id: e.id, kind: e.ptype, by: p ? p.pid : -1, x: e.x, y: e.y, z: e.z });\\n};\\n})();\\n\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":13530,\"cache_read_input_tokens\":259696,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":13530},\"output_tokens\":6,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"a0704575-f16b-44ea-a24d-907e9c278025\",\"uuid\":\"31e82be5-0c6b-462a-97b7-248ea5bcb966\",\"timestamp\":\"2026-11-04T01:42:55.533Z\",