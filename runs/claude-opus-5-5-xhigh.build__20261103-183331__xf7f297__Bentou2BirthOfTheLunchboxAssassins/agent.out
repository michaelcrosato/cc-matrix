{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh8XJdHtACdcmSz35CPJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012YsCRTTgAYY9iPGhaHHcfx","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/tests && cat > silentcut.test.mjs <<'EOF'\n// silentcut: every kind from its geometry and not outside it; never on an alert guard or a boss; counters and score;\n// time restored after the slow motion; both characters' choreographies run to the end\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const SC = B.SilentCut, guard = (o = {}) => Object.assign({ id: 'g', type: 'ashigaru', at: [20, 11], facing: 0, mode: 'post' }, o);\n  const setup = (o, char = 'sojiro') => { const M = loadYard(t, { guards: [guard(o)] }, { char }); const g = M.guards[0]; g.mode = 'stand'; return [M, M.hero, g]; };\n  const place = (h, g, ang, d, z = 0) => { game.debug.teleport(g.x + Math.cos(ang) * d, g.y + Math.sin(ang) * d, z); h.facing = ang + Math.PI; };\n  let [M, h, g] = setup(); place(h, g, Math.PI, 14); let c = SC.find(h, M); check('behind and close: Back', c && c.kind === 'back', c && c.kind);\n  place(h, g, Math.PI, 30); c = SC.find(h, M); check('behind but too far: none', !c, c && c.kind);\n  place(h, g, Math.PI / 2, 14); c = SC.find(h, M); check('at its side, calm: Side', c && c.kind === 'side', c && c.kind);\n  place(h, g, 0, 14); c = SC.find(h, M); check('in front of an awake guard: none', !c, c && c.kind);\n  g.asleep = true; c = SC.find(h, M); check('in front of a sleeping guard: Front', c && c.kind === 'front', c && c.kind); g.asleep = false;\n  g.mind.level = 1.2; g.mind.update(1 / 120, false, h); place(h, g, Math.PI, 14); c = SC.find(h, M); check('never on an alert guard', !c, g.mind.state);\n  // from above: on the townhouse roof (8..10 x 4..6, h 40), a guard just south of it\n  [M, h, g] = setup({ at: [9, 8], facing: 90 }); game.debug.teleport(C(9), C(6) + 4, 40); t.step(.05); c = SC.find(h, M); check('on a roof over a guard: From above', c && c.kind === 'above', c && c.kind + ' z' + h.z);\n  // the undertow: swimming beside a guard on the bank of the pond (4..9 x 14..18)\n  [M, h, g] = setup({ at: [7, 19], facing: 90 }); game.debug.teleport(C(7), C(18) - 2, 0); t.intent({ move: [0, .01] }, .2); c = SC.find(h, M); check('from the water beside the bank: Undertow', h.swim && c && c.kind === 'undertow', (h.swim ? 'swim ' : 'dry ') + (c && c.kind));\n  // a boss is never a victim\n  const boss = B.Bosses.spawn({ id: 'gonroku', at: [24, 11] }, M); M.bosses.push(boss); game.debug.teleport(boss.x - 14, boss.y, 0); h.facing = 0; c = SC.find(h, M); check('never on a boss', !c || c.victim !== boss, c && c.victim.id);\n  // a cut runs: counter, score, time restored, both characters\n  for (const ch of ['sojiro', 'kaede']) {\n    [M, h, g] = setup({}, ch); place(h, g, Math.PI, 14); t.intent({ attackPressed: true }, 1 / 120);\n    check(ch + ': the cut starts its choreography', h.action && /^cut_back_/.test(h.action.name), h.action && h.action.name);\n    check(ch + ': time slows', game.timeScale < 1, game.timeScale);\n    t.intent({}, 3);\n    check(ch + ': the choreography ends, the guard falls', !h.action && !g.alive, (h.action && h.action.name) + ' alive ' + g.alive);\n    check(ch + ': counted', M.stats.silentCuts === 1, M.stats.silentCuts);\n    check(ch + ': time back to normal', game.timeScale === 1, game.timeScale);\n  }\n  M.objectives = []; const sc = B.Score.story(M, 300); check('a Silent Cut scores 150', sc.parts.find(p => p[0] === 'Silent Cuts')[1] === 150, JSON.stringify(sc.parts));\n  // every kind's choreography runs to the end for both\n  for (const k of ['side', 'front', 'above', 'undertow']) for (const ch of ['sojiro', 'kaede']) { const s = B.SilentCut; [M, h, g] = setup({}, ch); place(h, g, Math.PI, 14); s.run(h, k, g, M); t.intent({}, 3); check(k + ' (' + ch + ') runs to the end', !h.action && !g.alive, h.action && h.action.name); }\n}\nEOF\ncat > combat.test.mjs <<'EOF'\n// combat: combo damage; the block per character; the parry inside its window staggers, outside it does not; the riposte;\n// the roll is invulnerable; i-frames; death brings the game-over overlay; retry restores the checkpoint\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  let M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], facing: 180, mode: 'post' }] }), h = M.hero, g = M.guards[0]; g.mode = 'stand';\n  g.mind.level = 1.2; g.mind.update(1 / 120, false, h);\n  game.debug.teleport(g.x - 14, g.y, 0, 0); const hp0 = g.hp; t.intent({ attackPressed: true }, 1 / 120); t.intent({}, .45);\n  check('Sojiro\\'s first slash deals 14 x 1.2', Math.abs((hp0 - g.hp) - 16.8) < .5, hp0 - g.hp);\n  // the block and the parry (strikes called directly)\n  h.facing = 0; g.facing = Math.PI; h.blocking = true; h.parryT = 9; let hp1 = h.hp; B.Combat.enemyStrike(g, 20, { reach: 30 }); check('the block takes 85% (Sojiro)', Math.abs((hp1 - h.hp) - 3) < .6, hp1 - h.hp);\n  h.blocking = false; h.iframes = 0; h.parryT = .05; B.Combat.enemyStrike(g, 20, { reach: 30 }); check('a parry inside the window staggers', g.status.stagger > 1, g.status.stagger);\n  t.intent({ attackPressed: true }, 1 / 120); t.intent({}, .3); check('the riposte kills a staggered ashigaru', !g.alive, g.hp);\n  M = loadYard(t, { guards: [{ id: 'g', type: 'samurai', at: [12, 11], facing: 180, mode: 'post' }] }); h = M.hero; g = M.guards[0]; g.mode = 'stand';\n  game.debug.teleport(g.x - 14, g.y, 0, 0); h.parryT = .5; h.iframes = 0; hp1 = h.hp; B.Combat.enemyStrike(g, 16, { reach: 30 }); check('a parry outside the window does not', !(g.status.stagger > 0) && h.hp < hp1, g.status.stagger);\n  h.iframes = 0; hp1 = h.hp; B.Combat.enemyStrike(g, 10, { reach: 30 }); B.Combat.enemyStrike(g, 10, { reach: 30 }); check('i-frames: one hit of two lands', Math.abs((hp1 - h.hp) - 10) < .6, hp1 - h.hp);\n  h.iframes = 0; t.intent({ blockDown: true, jumpPressed: true, move: [0, 1] }, 1 / 120); t.intent({ blockDown: true, move: [0, 1] }, .12);\n  hp1 = h.hp; B.Combat.enemyStrike(g, 10, { reach: 60, arc: Math.PI }); check('mid-roll, invulnerable', h.action && h.action.name === 'roll' ? h.hp === hp1 : true, (h.action && h.action.name) + ' ' + (hp1 - h.hp));\n  // Kaede blocks 70%\n  M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], facing: 180, mode: 'post' }] }, { char: 'kaede' }); h = M.hero; g = M.guards[0]; game.debug.teleport(g.x - 14, g.y, 0, 0);\n  h.blocking = true; hp1 = h.hp; B.Combat.enemyStrike(g, 20, { reach: 30 }); check('the block takes 70% (Kaede)', Math.abs((hp1 - h.hp) - 6) < .6, hp1 - h.hp);\n  // death and the checkpoint\n  h.blocking = false; game.debug.teleport(C(3), C(20), 0); B.Mission.checkpoint(M, 'quiet'); game.debug.teleport(C(20), C(11), 0);\n  h.iframes = 0; B.damage(null, h, 999, { kind: 'test' }); t.intent({}, 2);\n  check('death: the game-over overlay', M.overMenu && t.snap().over, !!M.overMenu);\n  const N = B.Mission.restore(M, M.snap); game.go('mission', { M: N }, { fade: 0 }); t.step(.1);\n  check('retry restores the checkpoint', Math.abs(N.hero.x - C(3)) < 1 && Math.abs(N.hero.y - C(20)) < 1 && N.hero.hp === N.hero.maxHp && N.stats.retries === 1, JSON.stringify(t.snap().hero));\n}\nEOF\ncat > tools.test.mjs <<'EOF'\n// tools: what each of the ten does; stacks and compartments; unlocks gate the shelf\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const one = (tool, o = {}) => { const M = loadYard(t, { guards: o.guards || [] }); const h = M.hero; h.bento = [{ tool, n: B.get('tool', tool).stack }, null, null, null, null, null, null, null]; h.sel = 0; return [M, h]; };\n  let [M, h] = one('riceball'); h.hp = 20; t.intent({ usePressed: true }, 1 / 120); t.intent({}, 1); check('Rice Ball: +40', h.hp === 60, h.hp);\n  [M, h] = one('plum'); h.stamina = 10; t.intent({ usePressed: true }, 1 / 120); t.step(.1); check('Sour Plum: stamina and soft steps', h.stamina > 90 && h.softT > 19, h.stamina + ' ' + h.softT);\n  [M, h] = one('cloak'); t.intent({ usePressed: true }, 1 / 120); t.step(.1); check('Straw Cloak: 15 s', h.cloakT > 14, h.cloakT);\n  const gs = [{ id: 'g', type: 'ashigaru', at: [14, 11], facing: 180, mode: 'post' }];\n  [M, h] = one('poisonball', { guards: gs }); let g = M.guards[0]; game.debug.teleport(C(11), C(11), 0, Math.PI); M.cheats.invisible = true;\n  t.intent({ usePressed: true }, 1 / 120); game.debug.teleport(C(4), C(21), 0); t.intent({}, 10);\n  check('Poison Rice Ball: a guard eats it and dies', !g.alive && M.stats.cleanKills === 1, g.alive + ' eat ' + g.status.eat + ' kills ' + M.stats.cleanKills);\n  [M, h] = one('dango', { guards: gs }); g = M.guards[0]; game.debug.teleport(C(11), C(11), 0, Math.PI); M.cheats.invisible = true; t.intent({ usePressed: true }, 1 / 120); game.debug.teleport(C(4), C(21), 0); t.intent({}, 8);\n  check('Sleep Dango: the eater sleeps', g.alive && g.status.sleep > 10, g.status.sleep);\n  [M, h] = one('shuriken', { guards: gs }); g = M.guards[0]; game.debug.teleport(C(10), C(11), 0, 0); let hp0 = g.hp; t.intent({ usePressed: true }, 1 / 120); t.intent({}, .6); check('Shuriken: 8 damage', Math.abs(hp0 - g.hp - 9.6) < .6 || Math.abs(hp0 - g.hp - 8) < .6, hp0 - g.hp);\n  check('Shuriken: a calm guard turns to look', g.mind.state !== 'calm' || g.mind.level > .3, g.mind.state);\n  [M, h] = one('smoke', { guards: gs }); g = M.guards[0]; g.mind.level = 1.2; g.mind.update(.01, false, h); game.debug.teleport(C(11), C(11), 0, 0); t.intent({ usePressed: true, blockDown: true }, 1 / 120);\n  check('Smoke Bomb: a cloud at the feet', M.clouds.length === 1 && Math.hypot(M.clouds[0].x - h.x, M.clouds[0].y - h.y) < 4, M.clouds.length);\n  M.clouds[0].x = g.x; M.clouds[0].y = g.y; t.step(.2); check('Smoke Bomb: the guard inside is blinded and loses the hero', g.status.blind > 0 && g.mind.state !== 'alert', g.mind.state);\n  [M, h] = one('caltrops', { guards: gs }); g = M.guards[0]; game.debug.teleport(C(11), C(11), 0, 0); t.intent({ usePressed: true }, 1 / 120); g.x = h.x + 4; g.y = h.y; hp0 = g.hp; t.step(.1);\n  check('Caltrops: damage, a stun and a limp', g.hp < hp0 && g.status.stun > 0 && g.status.limp > 0, JSON.stringify(g.status));\n  [M, h] = one('firecracker', { guards: [{ id: 'g', type: 'ashigaru', at: [20, 4], facing: 90, mode: 'post' }] }); g = M.guards[0]; game.debug.teleport(C(20), C(15), 0, -Math.PI / 2);\n  t.intent({ usePressed: true, aimPoint: { x: C(24), y: C(8), z: 0 }, mouseMode: true }, 1 / 120); t.intent({}, 2.5);\n  check('Firecracker: the guard goes to look where it popped', g.mind.last && Math.hypot(g.mind.last.x - C(24), g.mind.last.y - C(8)) < 24, JSON.stringify(g.mind.last));\n  [M, h] = one('firepot', { guards: gs }); g = M.guards[0]; game.debug.teleport(C(9), C(11), 0, 0); t.intent({ usePressed: true, aimPoint: { x: g.x, y: g.y, z: 0 }, mouseMode: true }, 1 / 120); t.intent({}, 1.5);\n  check('Fire Pot: 45 around it', g.hp <= 40 - 44, g.hp);\n  // stacks, compartments, unlocks\n  [M, h] = one('riceball'); h.bento = Array(8).fill(null); const n = B.Hero.give(h, 'shuriken', 14); check('giving fills compartments up to their stack', n === 14 && h.bento[0].n === 10 && h.bento[1].n === 4, JSON.stringify(h.bento.slice(0, 2)));\n  const fresh = B.Save.fresh(); check('locked tools stay off the shelf', !B.Bento.unlocked('dango', fresh) && B.Bento.unlocked('shuriken', fresh), '');\n  check('the suggested bento skips locked tools', !B.Bento.fromHint([['dango', 2], ['smoke', 2]], fresh).some(c => c && c.tool === 'dango'), '');\n}\nEOF\ncat > ai.test.mjs <<'EOF'\n// ai: patrols follow their routes; posts sweep their gaze; sleepers wake on a loud noise; eaters take bait; hounds smell and\n// bark; archers shoot only with a clear line; ninja climb onto roofs; civilians scream and flee\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  let M = loadYard(t, { guards: [{ id: 'p', type: 'ashigaru', at: [20, 12], mode: 'patrol', route: [[20, 12, 0], [26, 12, 0]], loop: false }] }), g = M.guards[0];\n  game.debug.teleport(C(2), C(21), 0); M.cheats.invisible = true; t.step(6); check('a patrol walks its route', g.x > C(24) || g.ri === 0, g.x / 16);\n  M = loadYard(t, { guards: [{ id: 'p', type: 'ashigaru', at: [20, 12], facing: 90, mode: 'post' }] }); g = M.guards[0]; M.cheats.invisible = true; game.debug.teleport(C(2), C(21), 0);\n  let lo = 9, hi = -9; for (let i = 0; i < 40; i++) { t.step(.2); lo = Math.min(lo, g.facing); hi = Math.max(hi, g.facing); } check('a post sweeps its gaze', hi - lo > 1.2, (hi - lo).toFixed(2));\n  M = loadYard(t, { guards: [{ id: 's', type: 'ashigaru', at: [20, 12], facing: 90, mode: 'sleep' }] }); g = M.guards[0]; game.debug.teleport(C(2), C(21), 0); M.cheats.invisible = true; t.step(1);\n  check('a sleeper sleeps', g.asleep, g.asleep); B.noise(g.x + 20, g.y, 0, 140, 'firecracker'); t.step(.5); check('a loud noise wakes it', !g.asleep, g.asleep);\n  M = loadYard(t, { guards: [{ id: 'h', type: 'hound', at: [20, 12], facing: 180, mode: 'post' }] }); g = M.guards[0]; game.debug.teleport(g.x - 40, g.y + 30, 0); t.step(1.2);\n  check('a hound smells the hero and barks', g.mind.state !== 'calm' && M.noises.some(n => n.kind === 'bark'), g.mind.state);\n  M = loadYard(t, { guards: [{ id: 'a', type: 'archer', at: [15, 5], z: 48, facing: 90, mode: 'post' }] }); g = M.guards[0]; M.world.light.fill(1); game.debug.teleport(C(15), C(12), 0); M.cheats.god = true; t.step(3.5);\n  check('an archer with a clear line looses arrows', M.shots.list.some(s => s.team === 'enemy') || M.stats.damageTaken > 0 || g.drawing, g.mind.state);\n  M = loadYard(t, { guards: [{ id: 'a', type: 'archer', at: [15, 5], z: 48, facing: 270, mode: 'post' }] }); g = M.guards[0]; M.world.light.fill(1); game.debug.teleport(C(15), C(1), 0); M.cheats.god = true; g.mind.level = 1.2; g.mind.update(.01, false, M.hero); g.target = M.hero; t.step(3);\n  check('no clear line (behind the storehouse): no arrows', !M.shots.list.some(s => s.team === 'enemy') && M.stats.damageTaken === 0, M.stats.damageTaken);\n  M = loadYard(t, { guards: [{ id: 'n', type: 'ninja', at: [12, 11], facing: 270, mode: 'post' }] }); g = M.guards[0]; game.debug.teleport(C(9), C(5), 40); M.cheats.god = true; g.mind.level = 1.2; g.mind.update(.01, false, M.hero); g.target = M.hero; t.step(6);\n  check('a Red Lantern ninja climbs onto the roof', g.z >= 39, g.z);\n  M = loadYard(t, { civilians: [{ id: 'c', type: 'maid', at: [12, 11], facing: 180 }], guards: [{ id: 'gg', type: 'ashigaru', at: [26, 20], mode: 'post' }] }); const c = M.civs[0]; M.world.light.fill(1); game.debug.teleport(c.x - 40, c.y, 0, 0); t.step(3);\n  check('a civilian who sees the hero screams and flees', c.status.flee > 0 && M.noises.some(n => n.kind === 'scream'), c.mind.state);\n}\nEOF\ncat > alarm.test.mjs <<'EOF'\n// alarm: the bell rings after the runner reaches it; reinforcements after the delay; killing the runner keeps it silent;\n// the music's layers come in on an alert and go out after it\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const spec = { guards: [{ id: 'r', type: 'samurai', at: [20, 12], facing: 180, mode: 'post' }], bells: [[25, 12]], barracks: [[27, 20]] };\n  let M = loadYard(t, spec), g = M.guards[0]; game.debug.tune('reinforceDelay', 5); M.cheats.god = true;\n  M.world.light.fill(1); game.debug.teleport(g.x - 50, g.y, 0, 0); t.step(2.2);\n  check('an alert samurai runs for the bell', g.bellRun || M.alarm.rung, g.mind.state);\n  M.cheats.invisible = true; game.debug.teleport(C(2), C(21), 0); t.step(4);\n  check('the bell rings', M.alarm.rung === 1 && M.heightened === Infinity, M.alarm.rung);\n  const n0 = M.guards.length; t.step(5.5); check('reinforcements after the delay', M.guards.length === n0 + 2, M.guards.length - n0);\n  M = loadYard(t, spec); g = M.guards[0]; M.cheats.god = true; M.world.light.fill(1); game.debug.teleport(g.x - 50, g.y, 0, 0); t.step(2.2);\n  game.debug.kill('r'); M.cheats.invisible = true; t.step(4); check('killing the runner keeps the bell silent', M.alarm.rung === 0, M.alarm.rung);\n  M = loadYard(t, { guards: [{ id: 'x', type: 'ashigaru', at: [20, 12], facing: 180, mode: 'post' }] }); M.cheats.god = true; game.debug.alert('x'); t.step(.5);\n  check('an alert brings the alert layers', B.Music.level === 2, B.Music.level);\n  game.debug.calm(); M.cheats.invisible = true; game.debug.teleport(C(2), C(21), 0); t.step(9); check('they fade out after it', B.Music.level < 2, B.Music.level);\n  game.debug.resetTune();\n}\nEOF\ncd .. && node tests/run.mjs --fast silentcut combat tools ai alarm 2>&1 | tail -25","description":"Write and run cut, combat, tools, ai, alarm suites","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2540,"cache_read_input_tokens":796663,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2540},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"58a16430-39e5-4d69-a4e7-fa8db44e4654","uuid":"9772b91a-e796-46a8-a8d2-db23236b577b","timestamp":"2026-11-04T02:53:23.535Z","request_id":"req_011Cgh8XJJwzjKUVfAUQcUoN","wire_tool_inputs":{"toolu_012YsCRTTgAYY9iPGhaHHcfx":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/tests && cat > silentcut.test.mjs <<'EOF'\n// silentcut: every kind from its geometry and not outside it; never on an alert guard or a boss; counters and score;\n// time restored after the slow motion; both characters' choreographies run to the end\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const SC = B.SilentCut, guard = (o = {}) => Object.assign({ id: 'g', type: 'ashigaru', at: [20, 11], facing: 0, mode: 'post' }, o);\n  const setup = (o, char = 'sojiro') => { const M = loadYard(t, { guards: [guard(o)] }, { char }); const g = M.guards[0]; g.mode = 'stand'; return [M, M.hero, g]; };\n  const place = (h, g, ang, d, z = 0) => { game.debug.teleport(g.x + Math.cos(ang) * d, g.y + Math.sin(ang) * d, z); h.facing = ang + Math.PI; };\n  let [M, h, g] = setup(); place(h, g, Math.PI, 14); let c = SC.find(h, M); check('behind and close: Back', c && c.kind === 'back', c && c.kind);\n  place(h, g, Math.PI, 30); c = SC.find(h, M); check('behind but too far: none', !c, c && c.kind);\n  place(h, g, Math.PI / 2, 14); c = SC.find(h, M); check('at its side, calm: Side', c && c.kind === 'side', c && c.kind);\n  place(h, g, 0, 14); c = SC.find(h, M); check('in front of an awake guard: none', !c, c && c.kind);\n  g.asleep = true; c = SC.find(h, M); check('in front of a sleeping guard: Front', c && c.kind === 'front', c && c.kind); g.asleep = false;\n  g.mind.level = 1.2; g.mind.update(1 / 120, false, h); place(h, g, Math.PI, 14); c = SC.find(h, M); check('never on an alert guard', !c, g.mind.state);\n  // from above: on the townhouse roof (8..10 x 4..6, h 40), a guard just south of it\n  [M, h, g] = setup({ at: [9, 8], facing: 90 }); game.debug.teleport(C(9), C(6) + 4, 40); t.step(.05); c = SC.find(h, M); check('on a roof over a guard: From above', c && c.kind === 'above', c && c.kind + ' z' + h.z);\n  // the undertow: swimming beside a guard on the bank of the pond (4..9 x 14..18)\n  [M, h, g] = setup({ at: [7, 19], facing: 90 }); game.debug.teleport(C(7), C(18) - 2, 0); t.intent({ move: [0, .01] }, .2); c = SC.find(h, M); check('from the water beside the bank: Undertow', h.swim && c && c.kind === 'undertow', (h.swim ? 'swim ' : 'dry ') + (c && c.kind));\n  // a boss is never a victim\n  const boss = B.Bosses.spawn({ id: 'gonroku', at: [24, 11] }, M); M.bosses.push(boss); game.debug.teleport(boss.x - 14, boss.y, 0); h.facing = 0; c = SC.find(h, M); check('never on a boss', !c || c.victim !== boss, c && c.victim.id);\n  // a cut runs: counter, score, time restored, both characters\n  for (const ch of ['sojiro', 'kaede']) {\n    [M, h, g] = setup({}, ch); place(h, g, Math.PI, 14); t.intent({ attackPressed: true }, 1 / 120);\n    check(ch + ': the cut starts its choreography', h.action && /^cut_back_/.test(h.action.name), h.action && h.action.name);\n    check(ch + ': time slows', game.timeScale < 1, game.timeScale);\n    t.intent({}, 3);\n    check(ch + ': the choreography ends, the guard falls', !h.action && !g.alive, (h.action && h.action.name) + ' alive ' + g.alive);\n    check(ch + ': counted', M.stats.silentCuts === 1, M.stats.silentCuts);\n    check(ch + ': time back to normal', game.timeScale === 1, game.timeScale);\n  }\n  M.objectives = []; const sc = B.Score.story(M, 300); check('a Silent Cut scores 150', sc.parts.find(p => p[0] === 'Silent Cuts')[1] === 150, JSON.stringify(sc.parts));\n  // every kind's choreography runs to the end for both\n  for (const k of ['side', 'front', 'above', 'undertow']) for (const ch of ['sojiro', 'kaede']) { const s = B.SilentCut; [M, h, g] = setup({}, ch); place(h, g, Math.PI, 14); s.run(h, k, g, M); t.intent({}, 3); check(k + ' (' + ch + ') runs to the end', !h.action && !g.alive, h.action && h.action.name); }\n}\nEOF\ncat > combat.test.mjs <<'EOF'\n// combat: combo damage; the block per character; the parry inside its window staggers, outside it does not; the riposte;\n// the roll is invulnerable; i-frames; death brings the game-over overlay; retry restores the checkpoint\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  let M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], facing: 180, mode: 'post' }] }), h = M.hero, g = M.guards[0]; g.mode = 'stand';\n  g.mind.level = 1.2; g.mind.update(1 / 120, false, h);\n  game.debug.teleport(g.x - 14, g.y, 0, 0); const hp0 = g.hp; t.intent({ attackPressed: true }, 1 / 120); t.intent({}, .45);\n  check('Sojiro\\'s first slash deals 14 x 1.2', Math.abs((hp0 - g.hp) - 16.8) < .5, hp0 - g.hp);\n  // the block and the parry (strikes called directly)\n  h.facing = 0; g.facing = Math.PI; h.blocking = true; h.parryT = 9; let hp1 = h.hp; B.Combat.enemyStrike(g, 20, { reach: 30 }); check('the block takes 85% (Sojiro)', Math.abs((hp1 - h.hp) - 3) < .6, hp1 - h.hp);\n  h.blocking = false; h.iframes = 0; h.parryT = .05; B.Combat.enemyStrike(g, 20, { reach: 30 }); check('a parry inside the window staggers', g.status.stagger > 1, g.status.stagger);\n  t.intent({ attackPressed: true }, 1 / 120); t.intent({}, .3); check('the riposte kills a staggered ashigaru', !g.alive, g.hp);\n  M = loadYard(t, { guards: [{ id: 'g', type: 'samurai', at: [12, 11], facing: 180, mode: 'post' }] }); h = M.hero; g = M.guards[0]; g.mode = 'stand';\n  game.debug.teleport(g.x - 14, g.y, 0, 0); h.parryT = .5; h.iframes = 0; hp1 = h.hp; B.Combat.enemyStrike(g, 16, { reach: 30 }); check('a parry outside the window does not', !(g.status.stagger > 0) && h.hp < hp1, g.status.stagger);\n  h.iframes = 0; hp1 = h.hp; B.Combat.enemyStrike(g, 10, { reach: 30 }); B.Combat.enemyStrike(g, 10, { reach: 30 }); check('i-frames: one hit of two lands', Math.abs((hp1 - h.hp) - 10) < .6, hp1 - h.hp);\n  h.iframes = 0; t.intent({ blockDown: true, jumpPressed: true, move: [0, 1] }, 1 / 120); t.intent({ blockDown: true, move: [0, 1] }, .12);\n  hp1 = h.hp; B.Combat.enemyStrike(g, 10, { reach: 60, arc: Math.PI }); check('mid-roll, invulnerable', h.action && h.action.name === 'roll' ? h.hp === hp1 : true, (h.action && h.action.name) + ' ' + (hp1 - h.hp));\n  // Kaede blocks 70%\n  M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], facing: 180, mode: 'post' }] }, { char: 'kaede' }); h = M.hero; g = M.guards[0]; game.debug.teleport(g.x - 14, g.y, 0, 0);\n  h.blocking = true; hp1 = h.hp; B.Combat.enemyStrike(g, 20, { reach: 30 }); check('the block takes 70% (Kaede)', Math.abs((hp1 - h.hp) - 6) < .6, hp1 - h.hp);\n  // death and the checkpoint\n  h.blocking = false; game.debug.teleport(C(3), C(20), 0); B.Mission.checkpoint(M, 'quiet'); game.debug.teleport(C(20), C(11), 0);\n  h.iframes = 0; B.damage(null, h, 999, { kind: 'test' }); t.intent({}, 2);\n  check('death: the game-over overlay', M.overMenu && t.snap().over, !!M.overMenu);\n  const N = B.Mission.restore(M, M.snap); game.go('mission', { M: N }, { fade: 0 }); t.step(.1);\n  check('retry restores the checkpoint', Math.abs(N.hero.x - C(3)) < 1 && Math.abs(N.hero.y - C(20)) < 1 && N.hero.hp === N.hero.maxHp && N.stats.retries === 1, JSON.stringify(t.snap().hero));\n}\nEOF\ncat > tools.test.mjs <<'EOF'\n// tools: what each of the ten does; stacks and compartments; unlocks gate the shelf\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const one = (tool, o = {}) => { const M = loadYard(t, { guards: o.guards || [] }); const h = M.hero; h.bento = [{ tool, n: B.get('tool', tool).stack }, null, null, null, null, null, null, null]; h.sel = 0; return [M, h]; };\n  let [M, h] = one('riceball'); h.hp = 20; t.intent({ usePressed: true }, 1 / 120); t.intent({}, 1); check('Rice Ball: +40', h.hp === 60, h.hp);\n  [M, h] = one('plum'); h.stamina = 10; t.intent({ usePressed: true }, 1 / 120); t.step(.1); check('Sour Plum: stamina and soft steps', h.stamina > 90 && h.softT > 19, h.stamina + ' ' + h.softT);\n  [M, h] = one('cloak'); t.intent({ usePressed: true }, 1 / 120); t.step(.1); check('Straw Cloak: 15 s', h.cloakT > 14, h.cloakT);\n  const gs = [{ id: 'g', type: 'ashigaru', at: [14, 11], facing: 180, mode: 'post' }];\n  [M, h] = one('poisonball', { guards: gs }); let g = M.guards[0]; game.debug.teleport(C(11), C(11), 0, Math.PI); M.cheats.invisible = true;\n  t.intent({ usePressed: true }, 1 / 120); game.debug.teleport(C(4), C(21), 0); t.intent({}, 10);\n  check('Poison Rice Ball: a guard eats it and dies', !g.alive && M.stats.cleanKills === 1, g.alive + ' eat ' + g.status.eat + ' kills ' + M.stats.cleanKills);\n  [M, h] = one('dango', { guards: gs }); g = M.guards[0]; game.debug.teleport(C(11), C(11), 0, Math.PI); M.cheats.invisible = true; t.intent({ usePressed: true }, 1 / 120); game.debug.teleport(C(4), C(21), 0); t.intent({}, 8);\n  check('Sleep Dango: the eater sleeps', g.alive && g.status.sleep > 10, g.status.sleep);\n  [M, h] = one('shuriken', { guards: gs }); g = M.guards[0]; game.debug.teleport(C(10), C(11), 0, 0); let hp0 = g.hp; t.intent({ usePressed: true }, 1 / 120); t.intent({}, .6); check('Shuriken: 8 damage', Math.abs(hp0 - g.hp - 9.6) < .6 || Math.abs(hp0 - g.hp - 8) < .6, hp0 - g.hp);\n  check('Shuriken: a calm guard turns to look', g.mind.state !== 'calm' || g.mind.level > .3, g.mind.state);\n  [M, h] = one('smoke', { guards: gs }); g = M.guards[0]; g.mind.level = 1.2; g.mind.update(.01, false, h); game.debug.teleport(C(11), C(11), 0, 0); t.intent({ usePressed: true, blockDown: true }, 1 / 120);\n  check('Smoke Bomb: a cloud at the feet', M.clouds.length === 1 && Math.hypot(M.clouds[0].x - h.x, M.clouds[0].y - h.y) < 4, M.clouds.length);\n  M.clouds[0].x = g.x; M.clouds[0].y = g.y; t.step(.2); check('Smoke Bomb: the guard inside is blinded and loses the hero', g.status.blind > 0 && g.mind.state !== 'alert', g.mind.state);\n  [M, h] = one('caltrops', { guards: gs }); g = M.guards[0]; game.debug.teleport(C(11), C(11), 0, 0); t.intent({ usePressed: true }, 1 / 120); g.x = h.x + 4; g.y = h.y; hp0 = g.hp; t.step(.1);\n  check('Caltrops: damage, a stun and a limp', g.hp < hp0 && g.status.stun > 0 && g.status.limp > 0, JSON.stringify(g.status));\n  [M, h] = one('firecracker', { guards: [{ id: 'g', type: 'ashigaru', at: [20, 4], facing: 90, mode: 'post' }] }); g = M.guards[0]; game.debug.teleport(C(20), C(15), 0, -Math.PI / 2);\n  t.intent({ usePressed: true, aimPoint: { x: C(24), y: C(8), z: 0 }, mouseMode: true }, 1 / 120); t.intent({}, 2.5);\n  check('Firecracker: the guard goes to look where it popped', g.mind.last && Math.hypot(g.mind.last.x - C(24), g.mind.last.y - C(8)) < 24, JSON.stringify(g.mind.last));\n  [M, h] = one('firepot', { guards: gs }); g = M.guards[0]; game.debug.teleport(C(9), C(11), 0, 0); t.intent({ usePressed: true, aimPoint: { x: g.x, y: g.y, z: 0 }, mouseMode: true }, 1 / 120); t.intent({}, 1.5);\n  check('Fire Pot: 45 around it', g.hp <= 40 - 44, g.hp);\n  // stacks, compartments, unlocks\n  [M, h] = one('riceball'); h.bento = Array(8).fill(null); const n = B.Hero.give(h, 'shuriken', 14); check('giving fills compartments up to their stack', n === 14 && h.bento[0].n === 10 && h.bento[1].n === 4, JSON.stringify(h.bento.slice(0, 2)));\n  const fresh = B.Save.fresh(); check('locked tools stay off the shelf', !B.Bento.unlocked('dango', fresh) && B.Bento.unlocked('shuriken', fresh), '');\n  check('the suggested bento skips locked tools', !B.Bento.fromHint([['dango', 2], ['smoke', 2]], fresh).some(c => c && c.tool === 'dango'), '');\n}\nEOF\ncat > ai.test.mjs <<'EOF'\n// ai: patrols follow their routes; posts sweep their gaze; sleepers wake on a loud noise; eaters take bait; hounds smell and\n// bark; archers shoot only with a clear line; ninja climb onto roofs; civilians scream and flee\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  let M = loadYard(t, { guards: [{ id: 'p', type: 'ashigaru', at: [20, 12], mode: 'patrol', route: [[20, 12, 0], [26, 12, 0]], loop: false }] }), g = M.guards[0];\n  game.debug.teleport(C(2), C(21), 0); M.cheats.invisible = true; t.step(6); check('a patrol walks its route', g.x > C(24) || g.ri === 0, g.x / 16);\n  M = loadYard(t, { guards: [{ id: 'p', type: 'ashigaru', at: [20, 12], facing: 90, mode: 'post' }] }); g = M.guards[0]; M.cheats.invisible = true; game.debug.teleport(C(2), C(21), 0);\n  let lo = 9, hi = -9; for (let i = 0; i < 40; i++) { t.step(.2); lo = Math.min(lo, g.facing); hi = Math.max(hi, g.facing); } check('a post sweeps its gaze', hi - lo > 1.2, (hi - lo).toFixed(2));\n  M = loadYard(t, { guards: [{ id: 's', type: 'ashigaru', at: [20, 12], facing: 90, mode: 'sleep' }] }); g = M.guards[0]; game.debug.teleport(C(2), C(21), 0); M.cheats.invisible = true; t.step(1);\n  check('a sleeper sleeps', g.asleep, g.asleep); B.noise(g.x + 20, g.y, 0, 140, 'firecracker'); t.step(.5); check('a loud noise wakes it', !g.asleep, g.asleep);\n  M = loadYard(t, { guards: [{ id: 'h', type: 'hound', at: [20, 12], facing: 180, mode: 'post' }] }); g = M.guards[0]; game.debug.teleport(g.x - 40, g.y + 30, 0); t.step(1.2);\n  check('a hound smells the hero and barks', g.mind.state !== 'calm' && M.noises.some(n => n.kind === 'bark'), g.mind.state);\n  M = loadYard(t, { guards: [{ id: 'a', type: 'archer', at: [15, 5], z: 48, facing: 90, mode: 'post' }] }); g = M.guards[0]; M.world.light.fill(1); game.debug.teleport(C(15), C(12), 0); M.cheats.god = true; t.step(3.5);\n  check('an archer with a clear line looses arrows', M.shots.list.some(s => s.team === 'enemy') || M.stats.damageTaken > 0 || g.drawing, g.mind.state);\n  M = loadYard(t, { guards: [{ id: 'a', type: 'archer', at: [15, 5], z: 48, facing: 270, mode: 'post' }] }); g = M.guards[0]; M.world.light.fill(1); game.debug.teleport(C(15), C(1), 0); M.cheats.god = true; g.mind.level = 1.2; g.mind.update(.01, false, M.hero); g.target = M.hero; t.step(3);\n  check('no clear line (behind the storehouse): no arrows', !M.shots.list.some(s => s.team === 'enemy') && M.stats.damageTaken === 0, M.stats.damageTaken);\n  M = loadYard(t, { guards: [{ id: 'n', type: 'ninja', at: [12, 11], facing: 270, mode: 'post' }] }); g = M.guards[0]; game.debug.teleport(C(9), C(5), 40); M.cheats.god = true; g.mind.level = 1.2; g.mind.update(.01, false, M.hero); g.target = M.hero; t.step(6);\n  check('a Red Lantern ninja climbs onto the roof', g.z >= 39, g.z);\n  M = loadYard(t, { civilians: [{ id: 'c', type: 'maid', at: [12, 11], facing: 180 }], guards: [{ id: 'gg', type: 'ashigaru', at: [26, 20], mode: 'post' }] }); const c = M.civs[0]; M.world.light.fill(1); game.debug.teleport(c.x - 40, c.y, 0, 0); t.step(3);\n  check('a civilian who sees the hero screams and flees', c.status.flee > 0 && M.noises.some(n => n.kind === 'scream'), c.mind.state);\n}\nEOF\ncat > alarm.test.mjs <<'EOF'\n// alarm: the bell rings after the runner reaches it; reinforcements after the delay; killing the runner keeps it silent;\n// the music's layers come in on an alert and go out after it\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const spec = { guards: [{ id: 'r', type: 'samurai', at: [20, 12], facing: 180, mode: 'post' }], bells: [[25, 12]], barracks: [[27, 20]] };\n  let M = loadYard(t, spec), g = M.guards[0]; game.debug.tune('reinforceDelay', 5); M.cheats.god = true;\n  M.world.light.fill(1); game.debug.teleport(g.x - 50, g.y, 0, 0); t.step(2.2);\n  check('an alert samurai runs for the bell', g.bellRun || M.alarm.rung, g.mind.state);\n  M.cheats.invisible = true; game.debug.teleport(C(2), C(21), 0); t.step(4);\n  check('the bell rings', M.alarm.rung === 1 && M.heightened === Infinity, M.alarm.rung);\n  const n0 = M.guards.length; t.step(5.5); check('reinforcements after the delay', M.guards.length === n0 + 2, M.guards.length - n0);\n  M = loadYard(t, spec); g = M.guards[0]; M.cheats.god = true; M.world.light.fill(1); game.debug.teleport(g.x - 50, g.y, 0, 0); t.step(2.2);\n  game.debug.kill('r'); M.cheats.invisible = true; t.step(4); check('killing the runner keeps the bell silent', M.alarm.rung === 0, M.alarm.rung);\n  M = loadYard(t, { guards: [{ id: 'x', type: 'ashigaru', at: [20, 12], facing: 180, mode: 'post' }] }); M.cheats.god = true; game.debug.alert('x'); t.step(.5);\n  check('an alert brings the alert layers', B.Music.level === 2, B.Music.level);\n  game.debug.calm(); M.cheats.invisible = true; game.debug.teleport(C(2), C(21), 0); t.step(9); check('they fade out after it', B.Music.level < 2, B.Music.level);\n  game.debug.resetTune();\n}\nEOF\ncd .. && node tests/run.mjs --fast silentcut combat tools ai alarm 2>&1 | tail -25","description":"Write and run cut, combat, tools, ai, alarm suites","timeout":300000}}}
