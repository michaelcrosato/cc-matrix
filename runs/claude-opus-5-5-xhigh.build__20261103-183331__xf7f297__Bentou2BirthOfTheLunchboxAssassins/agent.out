{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh8iWWjKBdGm5cdJbdkY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Gyn3nDXVJGiHaJnqbufzAF","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/tests && cat > bosses.test.mjs <<'EOF'\n// bosses: each starts with its intro card and song, uses its moves, reaches its second phase, falls to the bot within\n// 90 s (god mode), says its defeat line, and opens its arena; the monk kneels instead\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  for (const [lv, ch] of [['training', 'sojiro'], ['m1', 'kaede'], ['m2', 'sojiro'], ['m3', 'kaede']]) {\n    t.load(lv, { mode: 'story', char: ch, cheats: { god: true } }); B.Cutscene.clear();\n    const M = B.M, b = M.bosses[0]; for (const o of M.objectives) if (o.type !== 'defeat' && o.type !== 'reach' && o.type !== 'escort') o.state = 'done';\n    game.debug.teleport(b.x + 30, b.y, b.z); t.step(.1); B.Bosses.start(b, M);\n    check(b.id + ': the intro card and the boss song', B.Hud.card && B.Hud.card.name === b.D.name && B.Music.cur === 'boss', JSON.stringify(B.Hud.card));\n    t.step(2.4); game.debug.autopilot([{ fight: 90, until2: N => N.bosses[0].defeated }], 'boss');\n    let s = 0; while (s < 90 && !b.defeated) { t.step(1); s++; }\n    check(b.id + ': the bot wins within 90 s', b.defeated, 'hp ' + Math.round(b.hp) + ' after ' + s + ' s');\n    const log = Object.keys(b.moveLog || {});\n    check(b.id + ': at least three of its moves were used', log.length >= 3, log.join(','));\n    if (b.D.phases.length) check(b.id + ': its second phase came', b.phase >= 1, b.phase);\n    check(b.id + ': its defeat line', !!(b.say && b.say.text) || B.Cutscene.queue.length > 0 || B.Cutscene.talk.open, JSON.stringify(b.say));\n    if (b.D.spar) check('the monk kneels: \"Well struck.\"', b.alive && b.defeated, b.alive);\n    if (lv === 'm1') check('the court\\'s gate opens after Gonroku', M.world.rows[12][11] === ':', M.world.rows[12][11]);\n  }\n}\nEOF\ncat > mission.test.mjs <<'EOF'\n// mission: objectives in order ('after'), optional ones, triggers once, the timer's fail, the escort's fail, the generic\n// fail hook, checkpoints; the score formula by hand; rank thresholds; unlocks; the save round trip\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  t.load('m1', { mode: 'story', cheats: { god: true } }); B.Cutscene.clear(); let M = B.M;\n  const ob = id => M.objectives.find(o => o.id === id);\n  check('escape waits for the kill and the boss', ob('escape').state === 'hidden', ob('escape').state);\n  check('the ledger is optional and active', ob('ledger').optional && ob('ledger').state === 'active', ob('ledger').state);\n  const p = M.pickups.find(p => p.id === 'ledger'); game.debug.teleport(p.x, p.y, p.z); t.step(.3);\n  check('taking the ledger completes the optional task', ob('ledger').state === 'done' && M.stats.optionalDone === 1, ob('ledger').state);\n  const tr = M.triggers.find(x => x.id === 'l'); check('a trigger fires once', tr.fired, tr.fired);\n  game.debug.kill('kanemori'); t.step(.3); check('the kill completes its objective, the boss shows', ob('kill').state === 'done' && ob('boss').state === 'active', ob('boss').state);\n  M.bosses[0].hp = 1; B.Bosses.defeat(M.bosses[0], M); M.bosses[0].alive = false; t.step(.3);\n  check('escape opens after both', ob('escape').state === 'active', ob('escape').state);\n  // the timer (Moon over Kokaku)\n  t.load('m3', { mode: 'story' }); B.Cutscene.clear(); M = B.M; M.timer.t = 1; t.step(1.6);\n  check('the moon timer fails the mission', M.ended && M.result === 'fail' && /cup/.test(M.failed), M.failed);\n  // the escort (Kiri Lake)\n  t.load('m2', { mode: 'story' }); B.Cutscene.clear(); M = B.M; B.Mission.actions(M, [['release']]); t.step(.2); M.escort.hp = 1; B.damage(null, M.escort, 5, { kind: 'test' }); t.step(.2);\n  check('Tobei falls: the mission fails', M.ended && M.failed === 'Tobei has fallen.', M.failed);\n  t.load('m2', { mode: 'story' }); B.Cutscene.clear(); M = B.M; B.Mission.fail(M, 'The target escaped.'); check('the generic fail hook', M.failed === 'The target escaped.' && M.result === 'fail', M.failed);\n  // checkpoints keep objectives and positions\n  t.load('m2', { mode: 'story' }); B.Cutscene.clear(); M = B.M; B.Mission.actions(M, [['release']]); t.step(.2); game.debug.teleport(40 * 16, 20 * 16, 0); B.Mission.checkpoint(M, 'quiet');\n  const N = B.Mission.restore(M, M.snap); check('a checkpoint restores objectives and the hero', N.objectives.find(o => o.id === 'rescue').state === 'done' && Math.abs(N.hero.x - 640) < 1 && !N.escort.caged && N.stats.retries === 1, JSON.stringify(N.objectives.map(o => o.state)));\n  // the score by hand\n  M.stats = { time: 500, silentCuts: 4, kills: 2, cleanKills: 1, detections: 1, civiliansHarmed: 0, optionalDone: 1, toolsUsed: 3, retries: 1, damageTaken: 10, marks: 0, cutKinds: {} };\n  const want = 1000 + 600 + 50 + 100 + 300 - 150 + 0 - 0 - 200 + 0 + Math.min(500, 720 - 500), sc = B.Score.story(M, 720).total;\n  check('the score formula', sc === want, sc + ' vs ' + want);\n  const R = v => B.Score.rank(v)[1]; check('rank thresholds', R(2600) === 'Grand Kaiseki' && R(2599) === 'Makunouchi' && R(1400) === 'Ekiben' && R(800) === 'Hinomaru' && R(799) === 'Leftovers', [R(2600), R(2599), R(1400), R(800), R(799)].join(','));\n  const sv = B.Save.fresh();\n  check('unlocks by rank', B.Score.unlocks('m1', 'Ekiben', sv).includes('dango') && !B.Score.unlocks('m1', 'Hinomaru', sv).includes('dango') && B.Score.unlocks('training', 'Makunouchi', sv).includes('plum') && B.Score.unlocks('m2', 'Makunouchi', sv).includes('firepot') && B.Score.unlocks('training', 'Grand Kaiseki', sv).includes('cloak'), '');\n  B.Save.data = Object.assign(B.Save.fresh('kaede'), { nextMission: 'm2', completed: { training: true, m1: true }, tools: ['dango'] }); B.Save.write(); B.Save.data = null;\n  const s = game.saves.latest(); game.saves.load(s.slot); const d = B.Save.get();\n  check('the save round trip', d.character === 'kaede' && d.nextMission === 'm2' && d.completed.m1 && d.tools.includes('dango'), JSON.stringify(d));\n}\nEOF\ncat > story.test.mjs <<'EOF'\n// story: every briefing, debrief and cutscene exists and runs to its end when skipped; both apprentices have their own\n// lines; every line a level or a boss speaks exists\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const S = B.Story, missing = [];\n  for (const id of B.STORY_ORDER) { const m = B.get('mission', id); for (const k of ['briefing', 'debrief']) if (m[k] && !S.scenes[m[k]]) missing.push(id + '.' + k); }\n  check('every briefing and debrief scene exists', !missing.length, missing.join(' '));\n  for (const id of Object.keys(S.scenes)) {\n    let done = false; B.Cutscene.play(id, 'kaede', () => { done = true; }); t.step(.4); t.hold('start'); t.step(1); t.hold('start', false); t.step(.3);\n    check('scene ' + id + ' runs to its end when skipped', done, game.sceneName);\n  }\n  const both = Object.values(S.lines).filter(l => typeof l === 'object' && l.sojiro && l.kaede).length + Object.values(S.scenes).reduce((n, sc) => n + sc.steps.filter(s => s[0] === 'say' && typeof s[2] === 'object' && s[2].sojiro && s[2].kaede).length, 0);\n  check('lines of their own for Sojiro and Kaede', both >= 6, both);\n  const lv = [], bad = [];\n  for (const L of B.all('level')) for (const tr of L.triggers || []) for (const a of tr.do || []) if (a[0] === 'say') lv.push([L.id, a[2]]);\n  for (const [id, line] of lv) if (S.lines[line] === undefined) bad.push(id + ':' + line);\n  for (const b of B.ids('boss')) for (const k of ['_intro', '_defeat']) if (S.lines[b + k] === undefined) bad.push(b + k);\n  check('every spoken line exists', !bad.length, bad.join(' '));\n  for (const c of ['idle', 'notice', 'search', 'lost', 'alert', 'body', 'bait', 'poisoned', 'sleepy', 'hurt', 'civilian', 'tobei', 'unmask', 'chat']) if (!S.barks[c] || !S.barks[c].length) bad.push('bark ' + c);\n  check('every bark category has lines', !bad.length, bad.join(' '));\n  check('every rank has Granny\\'s word', B.RANKS.every(r => S.results[r[1]]), '');\n}\nEOF\ncat > attract.test.mjs <<'EOF'\n// attract: three loops, every vignette visited, no errors, no beat needed its timeout\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  game.go('attract', { i: 0 }, { fade: 0 });\n  let s = 0; while (B.Attract.loops < 3 && s < 900) { t.step(1); s++; if (game.sceneName !== 'attract') break; }\n  check('attract runs three loops', B.Attract.loops >= 3, B.Attract.loops + ' loops in ' + s + ' s, scene ' + game.sceneName);\n  const v = B.Attract.VIGNETTES.filter(x => (B.Attract.visits[x.id] || 0) < 3).map(x => x.id);\n  check('every vignette was visited each loop', !v.length, v.join(' ') + ' ' + JSON.stringify(B.Attract.visits));\n  check('no beat needed its timeout', !B.Attract.log.length, B.Attract.log.slice(0, 6).join('; '));\n  t.tap('attack'); t.step(.6); check('any input returns to the title', game.sceneName === 'title', game.sceneName);\n}\nEOF\ncat > dev.test.mjs <<'EOF'\n// dev: every page opens; the cheats do what they say; the sliders change B.T live; Reset page and Reset all\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  let M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], facing: 180, mode: 'patrol', route: [[12, 11, 0], [20, 11, 0]] }] }), h = M.hero;\n  let ok = true; for (let p = 0; p < 8; p++) { try { B.Dev.page = p; B.Dev.show(); } catch (e) { ok = false; } } check('every dev page opens', ok && B.ui.screen === 'dev', B.ui.screen); B.ui.hide();\n  game.debug.cheat('god'); const hp = h.hp; B.damage(null, h, 50, {}); check('god mode', h.hp === hp, h.hp); game.debug.cheat('god', false);\n  game.debug.cheat('invisible'); check('invisible to guards', B.Perception.exposure(h, M) === 0, ''); game.debug.cheat('invisible', false);\n  game.debug.cheat('noclip'); game.debug.teleport(C(2), C(6), 0); t.intent({ move: [1, 0] }, 1); check('no-clip walks through walls', h.x > C(5), h.x / 16); game.debug.cheat('noclip', false);\n  game.debug.cheat('infinite'); h.bento = [{ tool: 'shuriken', n: 1 }, null, null, null, null, null, null, null]; h.sel = 0; t.intent({ usePressed: true }, 1 / 120); t.step(.3); check('infinite tools', h.bento[0].n === 1, h.bento[0].n); game.debug.cheat('infinite', false);\n  game.debug.cheat('oneHit'); const g = M.guards[0]; game.debug.teleport(g.x - 14, g.y, 0, 0); g.mind.level = 1.2; g.mind.update(.01, false, h); t.intent({ attackPressed: true }, 1 / 120); t.intent({}, .5); check('one-hit kills', !g.alive, g.hp); game.debug.cheat('oneHit', false);\n  M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], mode: 'patrol', route: [[12, 11, 0], [20, 11, 0]] }] }); const g2 = M.guards[0]; game.debug.cheat('freezeAI'); const x0 = g2.x; t.step(2); check('freeze AI', g2.x === x0, g2.x - x0); game.debug.cheat('freezeAI', false);\n  game.debug.cheat('reveal'); game.debug.teleport(C(27), C(21), 0); t.step(.2); check('reveal all enemies', g2.vis === 'visible', g2.vis); game.debug.cheat('reveal', false);\n  game.debug.tune('heroRun', 120); check('a slider changes B.T live', B.T('heroRun') === 120, B.T('heroRun'));\n  game.debug.teleport(C(2), C(11), 0, 0); t.intent({ move: [1, 0] }, .4); const x1 = M.hero.x; t.intent({ move: [1, 0] }, .5); check('the hero runs faster at once', (M.hero.x - x1) / .5 > 110, (M.hero.x - x1) / .5);\n  game.settings.set('sightRange', 150); for (const k of ['heroRun', 'heroSneak']) game.settings.set(k, B.tuneDefault(k)); check('Reset page (Hero) restores its sliders', B.T('heroRun') === 85, B.T('heroRun'));\n  game.debug.resetTune(); check('Reset all restores every slider', B.T('sightRange') === 112 && B.TUNE.every(r => game.settings[r[0]] === r[1]), B.T('sightRange'));\n  check('dev settings stay off the player\\'s Settings', B.TUNE.every(r => game.settings.spec(r[0]).group === 'Dev'), '');\n}\nEOF\ncat > workshop.test.mjs <<'EOF'\n// workshop: build a level through the editor (walls, the hero, a target, the exit, guards with routes); validation\n// catches a missing exit and an unreachable target; slots and export / import round trips; a test play is won\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  game.go('workshop', {}, { fade: 0 }); t.step(.2);\n  const Ed = B.Ed; Ed.load(Ed.blank(32, 32));\n  for (let x = 10; x < 20; x++) Ed.paint(x, 12, 'W');\n  Ed.place(4, 28, 'hero'); Ed.place(26, 4, 'exit'); Ed.place(15, 6, 'target'); Ed.place(8, 20, 'ashigaru'); Ed.place(22, 20, 'samurai'); Ed.place(14, 14, 'stoneLantern'); Ed.place(6, 6, 'cherry');\n  Ed.sel = Ed.L.guards[0].id; Ed.route('add', 12, 20); Ed.route('add', 12, 24); Ed.route('wait');\n  check('the editor builds a level', Ed.L.rows[12][15] === 'W' && Ed.L.guards.length === 2 && Ed.L.guards[0].route.length === 3 && Ed.L.civilians[0].target, JSON.stringify(Ed.L.guards[0]));\n  check('its objectives come from what is placed', Ed.L.objectives.map(o => o.type).join(',') === 'assassinate,reach', Ed.L.objectives.map(o => o.type).join(','));\n  check('a full level validates', Ed.validate().length === 0, Ed.problems.map(p => p.text).join(' '));\n  const exit = Ed.L.exit; Ed.L.exit = null; Ed.rebuild(); check('a missing exit is caught', Ed.validate().some(p => /exit/.test(p.text)), ''); Ed.L.exit = exit; Ed.rebuild();\n  for (let x = 13; x <= 17; x++) { Ed.paint(x, 4, '#'); Ed.paint(x, 8, '#'); } for (let y = 4; y <= 8; y++) { Ed.paint(13, y, '#'); Ed.paint(17, y, '#'); }\n  check('an unreachable target is caught', Ed.validate().some(p => /target/.test(p.text)), Ed.problems.map(p => p.text).join(' '));\n  for (let x = 13; x <= 17; x++) Ed.paint(x, 8, '.'); Ed.validate();\n  const j = Ed.json(); Ed.save(1); Ed.load(Ed.blank()); Ed.loadSlot(1); check('a slot keeps the level exactly', Ed.json() === j, Ed.json().length + ' vs ' + j.length);\n  const err = Ed.importJson(j); check('export and import round trip', !err && Ed.json() === j, err);\n  check('import rejects what is not a level', !!Ed.importJson('{\"rows\": 3}'), '');\n  Ed.importJson(j);\n  // a test play, won by the autopilot\n  game.go('mission', { level: JSON.parse(Ed.json()), mission: 'workshop', mode: 'workshop', char: 'sojiro' }, { fade: 0 }); t.step(.2); B.Cutscene.clear();\n  const M = B.M; M.cheats.god = true; M.cheats.invisible = true;\n  game.debug.autopilot([{ fn: (M, h) => { const k = M.civs.find(c => c.target); h.x = k.x - Math.cos(k.facing) * 14; h.y = k.y - Math.sin(k.facing) * 14; h.z = 0; } }, { fn: M => { M.cheats.invisible = false; } }, { cut: 'target', max: 6 }, { wait: 1 }, { at: [26, 5] }, { goto: [26, 4], max: 4 }, { wait: 3 }], 'workshop');\n  let s = 0; while (s < 40 && !(M.ended && M.endT > 2)) { t.step(.5); s += .5; }\n  check('a test play is won', M.ended && M.result === 'win' && game.sceneName === 'results', M.objectives.map(o => o.id + ':' + o.state).join(' ') + ' ' + game.sceneName);\n}\nEOF\ncat > input.test.mjs <<'EOF'\n// input: labels per device (PlayStation by default, Xbox by the setting); prompts follow the device used last; the d-pad\n// picks tools and never moves the hero; the wheel cycles tools\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game, I } = t; t.step(.3);\n  check('keys: Space', I.codeLabel('Space') === 'Space', I.codeLabel('Space'));\n  check('the pad shows PlayStation symbols by default', I.codeLabel('Pad0') === '✕' && game.settings.glyphs === 'playstation', I.codeLabel('Pad0'));\n  game.settings.set('glyphs', 'xbox'); check('the Xbox option shows A', I.codeLabel('Pad0') === 'A', I.codeLabel('Pad0')); game.settings.set('glyphs', 'playstation');\n  I.lastDevice = 'gamepad'; check('a pad prompt: the pad code', B.Glyph.code('attack') === 'Pad2', B.Glyph.code('attack'));\n  I.lastDevice = 'mouse'; check('a mouse prompt: the mouse button', B.Glyph.code('attack') === 'Mouse0', B.Glyph.code('attack'));\n  I.lastDevice = 'keyboard'; check('a keyboard prompt: the key', B.Glyph.code('attack') === 'KeyJ', B.Glyph.code('attack'));\n  const M = loadYard(t), h = M.hero; h.bento = [{ tool: 'riceball', n: 3 }, { tool: 'shuriken', n: 10 }, null, null, null, null, null, null]; h.sel = 0;\n  game.debug.teleport(C(12), C(11), 0); B.testIntent = null; const x0 = h.x, y0 = h.y;\n  I.press('Pad15'); t.step(.4); I.release('Pad15'); t.step(.1);\n  check('the d-pad does not move the hero', Math.hypot(h.x - x0, h.y - y0) < 1, Math.hypot(h.x - x0, h.y - y0));\n  check('the d-pad picks the next tool', h.sel === 1, h.sel);\n  B.wheel = -1; t.step(.05); check('the wheel cycles tools', h.sel === 0, h.sel);\n  I.hold('right'); t.step(.4); I.hold('right', false); check('the keys move the hero', Math.hypot(h.x - x0, h.y - y0) > 10, Math.hypot(h.x - x0, h.y - y0));\n}\nEOF\ncat > determinism.test.mjs <<'EOF'\n// determinism: 30 s of scripted play in Rice and Ash, twice in fresh pages: the same hash\nexport default async function (t) {\n  const run = () => {\n    const P = t.makeContext(), g = P.game, B = P.B; g.advance(.3);\n    g.debug.load('m1', { mode: 'story', char: 'kaede' }); g.advance(.1); B.Cutscene.clear();\n    for (let i = 0; i < 300; i++) { const k = i % 40; B.testIntent = { move: k < 20 ? [-1, 0] : [0, -1], sprint: k % 7 === 0, crouchPressed: k === 10, jumpPressed: k === 30, attackPressed: k === 35 }; g.advance(.1); }\n    const h = g.debug.hash(); g.dispose(); return h;\n  };\n  const a = run(), b = run();\n  t.check('the same input gives the same game', a === b && a !== 0, a + ' vs ' + b);\n}\nEOF\ncd .. && node tests/run.mjs --fast bosses mission story attract dev workshop input determinism 2>&1 | tail -25","description":"Write and run the remaining headless suites","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2061,"cache_read_input_tokens":815393,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2061},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"58a16430-39e5-4d69-a4e7-fa8db44e4654","uuid":"3f514485-c95f-4376-891f-8718727dc2d0","timestamp":"2026-11-04T02:56:25.389Z","request_id":"req_011Cgh8iWF6aGrW8yYmxFa6J","wire_tool_inputs":{"toolu_01Gyn3nDXVJGiHaJnqbufzAF":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/tests && cat > bosses.test.mjs <<'EOF'\n// bosses: each starts with its intro card and song, uses its moves, reaches its second phase, falls to the bot within\n// 90 s (god mode), says its defeat line, and opens its arena; the monk kneels instead\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  for (const [lv, ch] of [['training', 'sojiro'], ['m1', 'kaede'], ['m2', 'sojiro'], ['m3', 'kaede']]) {\n    t.load(lv, { mode: 'story', char: ch, cheats: { god: true } }); B.Cutscene.clear();\n    const M = B.M, b = M.bosses[0]; for (const o of M.objectives) if (o.type !== 'defeat' && o.type !== 'reach' && o.type !== 'escort') o.state = 'done';\n    game.debug.teleport(b.x + 30, b.y, b.z); t.step(.1); B.Bosses.start(b, M);\n    check(b.id + ': the intro card and the boss song', B.Hud.card && B.Hud.card.name === b.D.name && B.Music.cur === 'boss', JSON.stringify(B.Hud.card));\n    t.step(2.4); game.debug.autopilot([{ fight: 90, until2: N => N.bosses[0].defeated }], 'boss');\n    let s = 0; while (s < 90 && !b.defeated) { t.step(1); s++; }\n    check(b.id + ': the bot wins within 90 s', b.defeated, 'hp ' + Math.round(b.hp) + ' after ' + s + ' s');\n    const log = Object.keys(b.moveLog || {});\n    check(b.id + ': at least three of its moves were used', log.length >= 3, log.join(','));\n    if (b.D.phases.length) check(b.id + ': its second phase came', b.phase >= 1, b.phase);\n    check(b.id + ': its defeat line', !!(b.say && b.say.text) || B.Cutscene.queue.length > 0 || B.Cutscene.talk.open, JSON.stringify(b.say));\n    if (b.D.spar) check('the monk kneels: \"Well struck.\"', b.alive && b.defeated, b.alive);\n    if (lv === 'm1') check('the court\\'s gate opens after Gonroku', M.world.rows[12][11] === ':', M.world.rows[12][11]);\n  }\n}\nEOF\ncat > mission.test.mjs <<'EOF'\n// mission: objectives in order ('after'), optional ones, triggers once, the timer's fail, the escort's fail, the generic\n// fail hook, checkpoints; the score formula by hand; rank thresholds; unlocks; the save round trip\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  t.load('m1', { mode: 'story', cheats: { god: true } }); B.Cutscene.clear(); let M = B.M;\n  const ob = id => M.objectives.find(o => o.id === id);\n  check('escape waits for the kill and the boss', ob('escape').state === 'hidden', ob('escape').state);\n  check('the ledger is optional and active', ob('ledger').optional && ob('ledger').state === 'active', ob('ledger').state);\n  const p = M.pickups.find(p => p.id === 'ledger'); game.debug.teleport(p.x, p.y, p.z); t.step(.3);\n  check('taking the ledger completes the optional task', ob('ledger').state === 'done' && M.stats.optionalDone === 1, ob('ledger').state);\n  const tr = M.triggers.find(x => x.id === 'l'); check('a trigger fires once', tr.fired, tr.fired);\n  game.debug.kill('kanemori'); t.step(.3); check('the kill completes its objective, the boss shows', ob('kill').state === 'done' && ob('boss').state === 'active', ob('boss').state);\n  M.bosses[0].hp = 1; B.Bosses.defeat(M.bosses[0], M); M.bosses[0].alive = false; t.step(.3);\n  check('escape opens after both', ob('escape').state === 'active', ob('escape').state);\n  // the timer (Moon over Kokaku)\n  t.load('m3', { mode: 'story' }); B.Cutscene.clear(); M = B.M; M.timer.t = 1; t.step(1.6);\n  check('the moon timer fails the mission', M.ended && M.result === 'fail' && /cup/.test(M.failed), M.failed);\n  // the escort (Kiri Lake)\n  t.load('m2', { mode: 'story' }); B.Cutscene.clear(); M = B.M; B.Mission.actions(M, [['release']]); t.step(.2); M.escort.hp = 1; B.damage(null, M.escort, 5, { kind: 'test' }); t.step(.2);\n  check('Tobei falls: the mission fails', M.ended && M.failed === 'Tobei has fallen.', M.failed);\n  t.load('m2', { mode: 'story' }); B.Cutscene.clear(); M = B.M; B.Mission.fail(M, 'The target escaped.'); check('the generic fail hook', M.failed === 'The target escaped.' && M.result === 'fail', M.failed);\n  // checkpoints keep objectives and positions\n  t.load('m2', { mode: 'story' }); B.Cutscene.clear(); M = B.M; B.Mission.actions(M, [['release']]); t.step(.2); game.debug.teleport(40 * 16, 20 * 16, 0); B.Mission.checkpoint(M, 'quiet');\n  const N = B.Mission.restore(M, M.snap); check('a checkpoint restores objectives and the hero', N.objectives.find(o => o.id === 'rescue').state === 'done' && Math.abs(N.hero.x - 640) < 1 && !N.escort.caged && N.stats.retries === 1, JSON.stringify(N.objectives.map(o => o.state)));\n  // the score by hand\n  M.stats = { time: 500, silentCuts: 4, kills: 2, cleanKills: 1, detections: 1, civiliansHarmed: 0, optionalDone: 1, toolsUsed: 3, retries: 1, damageTaken: 10, marks: 0, cutKinds: {} };\n  const want = 1000 + 600 + 50 + 100 + 300 - 150 + 0 - 0 - 200 + 0 + Math.min(500, 720 - 500), sc = B.Score.story(M, 720).total;\n  check('the score formula', sc === want, sc + ' vs ' + want);\n  const R = v => B.Score.rank(v)[1]; check('rank thresholds', R(2600) === 'Grand Kaiseki' && R(2599) === 'Makunouchi' && R(1400) === 'Ekiben' && R(800) === 'Hinomaru' && R(799) === 'Leftovers', [R(2600), R(2599), R(1400), R(800), R(799)].join(','));\n  const sv = B.Save.fresh();\n  check('unlocks by rank', B.Score.unlocks('m1', 'Ekiben', sv).includes('dango') && !B.Score.unlocks('m1', 'Hinomaru', sv).includes('dango') && B.Score.unlocks('training', 'Makunouchi', sv).includes('plum') && B.Score.unlocks('m2', 'Makunouchi', sv).includes('firepot') && B.Score.unlocks('training', 'Grand Kaiseki', sv).includes('cloak'), '');\n  B.Save.data = Object.assign(B.Save.fresh('kaede'), { nextMission: 'm2', completed: { training: true, m1: true }, tools: ['dango'] }); B.Save.write(); B.Save.data = null;\n  const s = game.saves.latest(); game.saves.load(s.slot); const d = B.Save.get();\n  check('the save round trip', d.character === 'kaede' && d.nextMission === 'm2' && d.completed.m1 && d.tools.includes('dango'), JSON.stringify(d));\n}\nEOF\ncat > story.test.mjs <<'EOF'\n// story: every briefing, debrief and cutscene exists and runs to its end when skipped; both apprentices have their own\n// lines; every line a level or a boss speaks exists\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const S = B.Story, missing = [];\n  for (const id of B.STORY_ORDER) { const m = B.get('mission', id); for (const k of ['briefing', 'debrief']) if (m[k] && !S.scenes[m[k]]) missing.push(id + '.' + k); }\n  check('every briefing and debrief scene exists', !missing.length, missing.join(' '));\n  for (const id of Object.keys(S.scenes)) {\n    let done = false; B.Cutscene.play(id, 'kaede', () => { done = true; }); t.step(.4); t.hold('start'); t.step(1); t.hold('start', false); t.step(.3);\n    check('scene ' + id + ' runs to its end when skipped', done, game.sceneName);\n  }\n  const both = Object.values(S.lines).filter(l => typeof l === 'object' && l.sojiro && l.kaede).length + Object.values(S.scenes).reduce((n, sc) => n + sc.steps.filter(s => s[0] === 'say' && typeof s[2] === 'object' && s[2].sojiro && s[2].kaede).length, 0);\n  check('lines of their own for Sojiro and Kaede', both >= 6, both);\n  const lv = [], bad = [];\n  for (const L of B.all('level')) for (const tr of L.triggers || []) for (const a of tr.do || []) if (a[0] === 'say') lv.push([L.id, a[2]]);\n  for (const [id, line] of lv) if (S.lines[line] === undefined) bad.push(id + ':' + line);\n  for (const b of B.ids('boss')) for (const k of ['_intro', '_defeat']) if (S.lines[b + k] === undefined) bad.push(b + k);\n  check('every spoken line exists', !bad.length, bad.join(' '));\n  for (const c of ['idle', 'notice', 'search', 'lost', 'alert', 'body', 'bait', 'poisoned', 'sleepy', 'hurt', 'civilian', 'tobei', 'unmask', 'chat']) if (!S.barks[c] || !S.barks[c].length) bad.push('bark ' + c);\n  check('every bark category has lines', !bad.length, bad.join(' '));\n  check('every rank has Granny\\'s word', B.RANKS.every(r => S.results[r[1]]), '');\n}\nEOF\ncat > attract.test.mjs <<'EOF'\n// attract: three loops, every vignette visited, no errors, no beat needed its timeout\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  game.go('attract', { i: 0 }, { fade: 0 });\n  let s = 0; while (B.Attract.loops < 3 && s < 900) { t.step(1); s++; if (game.sceneName !== 'attract') break; }\n  check('attract runs three loops', B.Attract.loops >= 3, B.Attract.loops + ' loops in ' + s + ' s, scene ' + game.sceneName);\n  const v = B.Attract.VIGNETTES.filter(x => (B.Attract.visits[x.id] || 0) < 3).map(x => x.id);\n  check('every vignette was visited each loop', !v.length, v.join(' ') + ' ' + JSON.stringify(B.Attract.visits));\n  check('no beat needed its timeout', !B.Attract.log.length, B.Attract.log.slice(0, 6).join('; '));\n  t.tap('attack'); t.step(.6); check('any input returns to the title', game.sceneName === 'title', game.sceneName);\n}\nEOF\ncat > dev.test.mjs <<'EOF'\n// dev: every page opens; the cheats do what they say; the sliders change B.T live; Reset page and Reset all\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  let M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], facing: 180, mode: 'patrol', route: [[12, 11, 0], [20, 11, 0]] }] }), h = M.hero;\n  let ok = true; for (let p = 0; p < 8; p++) { try { B.Dev.page = p; B.Dev.show(); } catch (e) { ok = false; } } check('every dev page opens', ok && B.ui.screen === 'dev', B.ui.screen); B.ui.hide();\n  game.debug.cheat('god'); const hp = h.hp; B.damage(null, h, 50, {}); check('god mode', h.hp === hp, h.hp); game.debug.cheat('god', false);\n  game.debug.cheat('invisible'); check('invisible to guards', B.Perception.exposure(h, M) === 0, ''); game.debug.cheat('invisible', false);\n  game.debug.cheat('noclip'); game.debug.teleport(C(2), C(6), 0); t.intent({ move: [1, 0] }, 1); check('no-clip walks through walls', h.x > C(5), h.x / 16); game.debug.cheat('noclip', false);\n  game.debug.cheat('infinite'); h.bento = [{ tool: 'shuriken', n: 1 }, null, null, null, null, null, null, null]; h.sel = 0; t.intent({ usePressed: true }, 1 / 120); t.step(.3); check('infinite tools', h.bento[0].n === 1, h.bento[0].n); game.debug.cheat('infinite', false);\n  game.debug.cheat('oneHit'); const g = M.guards[0]; game.debug.teleport(g.x - 14, g.y, 0, 0); g.mind.level = 1.2; g.mind.update(.01, false, h); t.intent({ attackPressed: true }, 1 / 120); t.intent({}, .5); check('one-hit kills', !g.alive, g.hp); game.debug.cheat('oneHit', false);\n  M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], mode: 'patrol', route: [[12, 11, 0], [20, 11, 0]] }] }); const g2 = M.guards[0]; game.debug.cheat('freezeAI'); const x0 = g2.x; t.step(2); check('freeze AI', g2.x === x0, g2.x - x0); game.debug.cheat('freezeAI', false);\n  game.debug.cheat('reveal'); game.debug.teleport(C(27), C(21), 0); t.step(.2); check('reveal all enemies', g2.vis === 'visible', g2.vis); game.debug.cheat('reveal', false);\n  game.debug.tune('heroRun', 120); check('a slider changes B.T live', B.T('heroRun') === 120, B.T('heroRun'));\n  game.debug.teleport(C(2), C(11), 0, 0); t.intent({ move: [1, 0] }, .4); const x1 = M.hero.x; t.intent({ move: [1, 0] }, .5); check('the hero runs faster at once', (M.hero.x - x1) / .5 > 110, (M.hero.x - x1) / .5);\n  game.settings.set('sightRange', 150); for (const k of ['heroRun', 'heroSneak']) game.settings.set(k, B.tuneDefault(k)); check('Reset page (Hero) restores its sliders', B.T('heroRun') === 85, B.T('heroRun'));\n  game.debug.resetTune(); check('Reset all restores every slider', B.T('sightRange') === 112 && B.TUNE.every(r => game.settings[r[0]] === r[1]), B.T('sightRange'));\n  check('dev settings stay off the player\\'s Settings', B.TUNE.every(r => game.settings.spec(r[0]).group === 'Dev'), '');\n}\nEOF\ncat > workshop.test.mjs <<'EOF'\n// workshop: build a level through the editor (walls, the hero, a target, the exit, guards with routes); validation\n// catches a missing exit and an unreachable target; slots and export / import round trips; a test play is won\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  game.go('workshop', {}, { fade: 0 }); t.step(.2);\n  const Ed = B.Ed; Ed.load(Ed.blank(32, 32));\n  for (let x = 10; x < 20; x++) Ed.paint(x, 12, 'W');\n  Ed.place(4, 28, 'hero'); Ed.place(26, 4, 'exit'); Ed.place(15, 6, 'target'); Ed.place(8, 20, 'ashigaru'); Ed.place(22, 20, 'samurai'); Ed.place(14, 14, 'stoneLantern'); Ed.place(6, 6, 'cherry');\n  Ed.sel = Ed.L.guards[0].id; Ed.route('add', 12, 20); Ed.route('add', 12, 24); Ed.route('wait');\n  check('the editor builds a level', Ed.L.rows[12][15] === 'W' && Ed.L.guards.length === 2 && Ed.L.guards[0].route.length === 3 && Ed.L.civilians[0].target, JSON.stringify(Ed.L.guards[0]));\n  check('its objectives come from what is placed', Ed.L.objectives.map(o => o.type).join(',') === 'assassinate,reach', Ed.L.objectives.map(o => o.type).join(','));\n  check('a full level validates', Ed.validate().length === 0, Ed.problems.map(p => p.text).join(' '));\n  const exit = Ed.L.exit; Ed.L.exit = null; Ed.rebuild(); check('a missing exit is caught', Ed.validate().some(p => /exit/.test(p.text)), ''); Ed.L.exit = exit; Ed.rebuild();\n  for (let x = 13; x <= 17; x++) { Ed.paint(x, 4, '#'); Ed.paint(x, 8, '#'); } for (let y = 4; y <= 8; y++) { Ed.paint(13, y, '#'); Ed.paint(17, y, '#'); }\n  check('an unreachable target is caught', Ed.validate().some(p => /target/.test(p.text)), Ed.problems.map(p => p.text).join(' '));\n  for (let x = 13; x <= 17; x++) Ed.paint(x, 8, '.'); Ed.validate();\n  const j = Ed.json(); Ed.save(1); Ed.load(Ed.blank()); Ed.loadSlot(1); check('a slot keeps the level exactly', Ed.json() === j, Ed.json().length + ' vs ' + j.length);\n  const err = Ed.importJson(j); check('export and import round trip', !err && Ed.json() === j, err);\n  check('import rejects what is not a level', !!Ed.importJson('{\"rows\": 3}'), '');\n  Ed.importJson(j);\n  // a test play, won by the autopilot\n  game.go('mission', { level: JSON.parse(Ed.json()), mission: 'workshop', mode: 'workshop', char: 'sojiro' }, { fade: 0 }); t.step(.2); B.Cutscene.clear();\n  const M = B.M; M.cheats.god = true; M.cheats.invisible = true;\n  game.debug.autopilot([{ fn: (M, h) => { const k = M.civs.find(c => c.target); h.x = k.x - Math.cos(k.facing) * 14; h.y = k.y - Math.sin(k.facing) * 14; h.z = 0; } }, { fn: M => { M.cheats.invisible = false; } }, { cut: 'target', max: 6 }, { wait: 1 }, { at: [26, 5] }, { goto: [26, 4], max: 4 }, { wait: 3 }], 'workshop');\n  let s = 0; while (s < 40 && !(M.ended && M.endT > 2)) { t.step(.5); s += .5; }\n  check('a test play is won', M.ended && M.result === 'win' && game.sceneName === 'results', M.objectives.map(o => o.id + ':' + o.state).join(' ') + ' ' + game.sceneName);\n}\nEOF\ncat > input.test.mjs <<'EOF'\n// input: labels per device (PlayStation by default, Xbox by the setting); prompts follow the device used last; the d-pad\n// picks tools and never moves the hero; the wheel cycles tools\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game, I } = t; t.step(.3);\n  check('keys: Space', I.codeLabel('Space') === 'Space', I.codeLabel('Space'));\n  check('the pad shows PlayStation symbols by default', I.codeLabel('Pad0') === '\\u2715' && game.settings.glyphs === 'playstation', I.codeLabel('Pad0'));\n  game.settings.set('glyphs', 'xbox'); check('the Xbox option shows A', I.codeLabel('Pad0') === 'A', I.codeLabel('Pad0')); game.settings.set('glyphs', 'playstation');\n  I.lastDevice = 'gamepad'; check('a pad prompt: the pad code', B.Glyph.code('attack') === 'Pad2', B.Glyph.code('attack'));\n  I.lastDevice = 'mouse'; check('a mouse prompt: the mouse button', B.Glyph.code('attack') === 'Mouse0', B.Glyph.code('attack'));\n  I.lastDevice = 'keyboard'; check('a keyboard prompt: the key', B.Glyph.code('attack') === 'KeyJ', B.Glyph.code('attack'));\n  const M = loadYard(t), h = M.hero; h.bento = [{ tool: 'riceball', n: 3 }, { tool: 'shuriken', n: 10 }, null, null, null, null, null, null]; h.sel = 0;\n  game.debug.teleport(C(12), C(11), 0); B.testIntent = null; const x0 = h.x, y0 = h.y;\n  I.press('Pad15'); t.step(.4); I.release('Pad15'); t.step(.1);\n  check('the d-pad does not move the hero', Math.hypot(h.x - x0, h.y - y0) < 1, Math.hypot(h.x - x0, h.y - y0));\n  check('the d-pad picks the next tool', h.sel === 1, h.sel);\n  B.wheel = -1; t.step(.05); check('the wheel cycles tools', h.sel === 0, h.sel);\n  I.hold('right'); t.step(.4); I.hold('right', false); check('the keys move the hero', Math.hypot(h.x - x0, h.y - y0) > 10, Math.hypot(h.x - x0, h.y - y0));\n}\nEOF\ncat > determinism.test.mjs <<'EOF'\n// determinism: 30 s of scripted play in Rice and Ash, twice in fresh pages: the same hash\nexport default async function (t) {\n  const run = () => {\n    const P = t.makeContext(), g = P.game, B = P.B; g.advance(.3);\n    g.debug.load('m1', { mode: 'story', char: 'kaede' }); g.advance(.1); B.Cutscene.clear();\n    for (let i = 0; i < 300; i++) { const k = i % 40; B.testIntent = { move: k < 20 ? [-1, 0] : [0, -1], sprint: k % 7 === 0, crouchPressed: k === 10, jumpPressed: k === 30, attackPressed: k === 35 }; g.advance(.1); }\n    const h = g.debug.hash(); g.dispose(); return h;\n  };\n  const a = run(), b = run();\n  t.check('the same input gives the same game', a === b && a !== 0, a + ' vs ' + b);\n}\nEOF\ncd .. && node tests/run.mjs --fast bosses mission story attract dev workshop input determinism 2>&1 | tail -25","description":"Write and run the remaining headless suites","timeout":600000}}}
