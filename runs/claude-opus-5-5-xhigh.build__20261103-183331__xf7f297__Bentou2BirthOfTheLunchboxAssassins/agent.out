{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh6tH2uJboRe1XaRUcSX","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1036,"cache_read_input_tokens":668717,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1036},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"58a16430-39e5-4d69-a4e7-fa8db44e4654","uuid":"3d1c108e-ef9e-45ed-8ad3-04bdda51730c","timestamp":"2026-11-04T02:31:05.123Z","request_id":"req_011Cgh6tGn2xnRcj1c5hA96K","thinking_duration_ms":14081,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh6tH2uJboRe1XaRUcSX","type":"message","role":"assistant","content":[{"type":"text","text":"Now the autopilot (intent-producing beats shared by attract mode and the scripted playthrough test)."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1036,"cache_read_input_tokens":668717,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1036},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"58a16430-39e5-4d69-a4e7-fa8db44e4654","uuid":"d6a369e6-6c31-48f5-b6ac-6fa778c01e14","timestamp":"2026-11-04T02:31:05.127Z","request_id":"req_011Cgh6tGn2xnRcj1c5hA96K"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh6tH2uJboRe1XaRUcSX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VCrnPgfThaJeyQTZvdAGcT","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/src/80-autopilot.js","content":"/* ---- THE AUTOPILOT: it plays the hero by producing intents (never game.input), so attract mode cannot be mistaken\n * for a player. A route is a list of beats: { at, facing } teleport, { goto: [cx, cy], gait } walk a flow field there,\n * { wait }, { until }, { press }, { hold, s }, { grapple: [cx, cy, z] }, { use: tool, at }, { cut: guardId }, { fight: s },\n * { camera }, { say }, { fn }. Each beat gives up after 8 s (or its max) so a loop can never stick ---- */\nconst Autopilot = { beats: [], i: 0, t: 0, held: {}, log: [], timeouts: 0, name: null };\nAutopilot.load = (beats, name) => { Autopilot.beats = beats.slice(); Autopilot.i = 0; Autopilot.t = 0; Autopilot.held = {}; Autopilot.name = name || null; Autopilot.timeouts = 0; Autopilot.started = false; };\nAutopilot.done = () => Autopilot.i >= Autopilot.beats.length;\nconst heroFlowKey = (W, tx, ty) => 'h' + toCell(tx) + ',' + toCell(ty);\n/** a flow field for the hero (its own map: water swims, ledges of 30 climb, gaps of 60 leap) */\nAutopilot.flow = (W, tx, ty) => {\n  const k = heroFlowKey(W, tx, ty); let f = W.flows.get(k);\n  if (!f) { f = new E.FlowField(W.map, { climb: 30, drop: 48, jump: 60 }); W.flows.set(k, f); if (W.flows.size > 32) W.flows.delete(W.flows.keys().next().value); }\n  f.update(cellC(toCell(tx)), cellC(toCell(ty))); return f;\n};\nAutopilot.steer = (h, M, tx, ty, speed = 1) => {\n  const W = M.world, d = Math.hypot(tx - h.x, ty - h.y); if (d < 5) return { move: [0, 0], jump: false, arrived: true };\n  const f = Autopilot.flow(W, tx, ty), nx = f.next(h.x, h.y);\n  let gx = nx ? nx.x : tx, gy = nx ? nx.y : ty; if (!nx || (toCell(nx.x) === toCell(tx) && toCell(nx.y) === toCell(ty))) { gx = tx; gy = ty; }\n  const l = Math.hypot(gx - h.x, gy - h.y) || 1;\n  return { move: [(gx - h.x) / l * speed, (gy - h.y) / l * speed], jump: !!(nx && h.onGround && (nx.kind === 'climb' || nx.kind === 'jump') && nx.edge < h.r + 5), arrived: false };\n};\nAutopilot.intent = M => {\n  const it = B.noIntent(), h = M.hero; if (!h) return it;\n  if (!Autopilot.started) { Autopilot.started = true; Autopilot.t = 0; }\n  if (Autopilot.done()) return it;\n  const b = Autopilot.beats[Autopilot.i], dt = 1 / 120;\n  Autopilot.t += dt;\n  const next = () => { Autopilot.i++; Autopilot.t = 0; Autopilot.sub = null; };\n  if (Autopilot.t > (b.max || 8)) { Autopilot.timeouts++; Autopilot.log.push('timeout ' + (Autopilot.name || '') + ' #' + Autopilot.i + ' ' + Object.keys(b)[0]); next(); return it; }\n  const gait = b.gait || 'run';\n  const setCrouch = want => { if (!!h.crouch !== !!want && !h.swim) it.crouchPressed = true; };\n  if (b.at) { Object.assign(h, { x: cellC(b.at[0]) + (b.dx || 0), y: cellC(b.at[1]) + (b.dy || 0), z: b.at[2] !== undefined ? b.at[2] : M.world.map.groundAt(cellC(b.at[0]), cellC(b.at[1])), vx: 0, vy: 0, vz: 0, onGround: true, action: null }); if (b.facing !== undefined) h.facing = b.facing * Math.PI / 180; h.swim = false; h.dive = false; game.cam.snap = true; if (b.crouch !== undefined) h.crouch = b.crouch; next(); return it; }\n  if (b.wait !== undefined) { if (b.gait) setCrouch(gait === 'crouch'); if (b.focus) it.focusDown = true; if (Autopilot.t >= b.wait) next(); return it; }\n  if (b.until) { if (b.until(M)) next(); return it; }\n  if (b.fn) { b.fn(M, h); next(); return it; }\n  if (b.press) { it[b.press] = true; next(); return it; }\n  if (b.hold) { it[b.hold] = true; if (b.move) it.move = b.move; if (Autopilot.t >= (b.s || .5)) next(); return it; }\n  if (b.face !== undefined) { h.facing = b.face * Math.PI / 180; next(); return it; }\n  if (b.say) { B.Cutscene.radio(b.say[0], b.say[1], b.say[2] || 3); next(); return it; }\n  if (b.camera) { if (b.camera.turn) B.Cam.turn(b.camera.turn); if (b.camera.zoom) B.Cam.cine(b.camera.zoom, b.camera.hold || 2); next(); return it; }\n  if (b.goto) {\n    const tx = cellC(b.goto[0]) + (b.dx || 0), ty = cellC(b.goto[1]) + (b.dy || 0);\n    setCrouch(gait === 'crouch'); if (h.crouch && gait !== 'crouch' && !it.crouchPressed && !h.swim) it.crouchPressed = true;\n    if (b.dive && h.swim && !h.dive) it.crouchPressed = true;\n    const s = Autopilot.steer(h, M, tx, ty, gait === 'walk' ? .5 : 1); it.move = s.move; it.jumpPressed = s.jump; it.sprint = gait === 'sprint';\n    if (s.arrived || Math.hypot(tx - h.x, ty - h.y) < (b.within || 6)) next();\n    return it;\n  }\n  if (b.grapple) {\n    const [cx, cy, z] = b.grapple, tx = cellC(cx), ty = cellC(cy);\n    if (h.action && h.action.name === 'grapple') return it;\n    if (Autopilot.sub === 'fired') { if (!h.action) next(); return it; }\n    const list = Grapple.anchors(h, M); let best = null, bd = 1e9; for (const a of list) { const d = Math.hypot(a.x - tx, a.y - ty) + Math.abs(a.z - (z || a.z)) * 2; if (d < bd) { bd = d; best = a; } }\n    if (best) { h.facing = Math.atan2(best.y - h.y, best.x - h.x); Grapple.fire(h, best, M); Autopilot.sub = 'fired'; }\n    return it;\n  }\n  if (b.use) {\n    const i = h.bento.findIndex(c => c && c.tool === b.use && c.n > 0); if (i < 0) { Hero.give(h, b.use, 1); return it; }\n    h.sel = i; if (b.aim) { const x = cellC(b.aim[0]), y = cellC(b.aim[1]); it.aimPoint = { x, y, z: M.world.map.groundAt(x, y) }; it.mouseMode = true; h.facing = Math.atan2(y - h.y, x - h.x); }\n    if (b.feet) it.blockDown = true;\n    it.usePressed = true; next(); return it;\n  }\n  if (b.cut) {\n    const v = Mission.find(M, b.cut); if (!v || !v.alive) { if (!h.action) next(); return it; }\n    if (h.action) return it;\n    const c = SilentCut.find(h, M);\n    if (c && c.victim === v) { it.attackPressed = true; return it; }\n    // approach from behind on the nav map (crouched), or from the water / a roof as the beat says\n    const f = v.facing, back = b.from === 'above' ? 30 : 12, tx = v.x - Math.cos(f) * back, ty = v.y - Math.sin(f) * back;\n    if (b.from === 'water') { const s = Autopilot.steer(h, M, b.water ? cellC(b.water[0]) : tx, b.water ? cellC(b.water[1]) : ty, .6); it.move = s.move; if (h.swim && !h.dive && b.dive) it.crouchPressed = true; return it; }\n    if (b.from === 'above') { const s = Autopilot.steer(h, M, b.spot ? cellC(b.spot[0]) : tx, b.spot ? cellC(b.spot[1]) : ty, .5); it.move = s.move; return it; }\n    setCrouch(b.gait !== 'run'); const s = Autopilot.steer(h, M, tx, ty, h.crouch ? 1 : .5); it.move = s.move; it.jumpPressed = s.jump;\n    return it;\n  }\n  if (b.fight) {\n    if (Autopilot.t > b.fight || (b.until2 && b.until2(M))) { next(); return it; }\n    const foes = Combat.targets(M).filter(e => e.kind !== 'civ' && (e.kind === 'boss' ? e.active : true)); let tgt = null, bd = 1e9; for (const e of foes) { const d = Math.hypot(e.x - h.x, e.y - h.y) + Math.abs(e.z - h.z) * 4; if (d < bd) { bd = d; tgt = e; } }\n    if (h.crouch) it.crouchPressed = true;\n    if (!tgt) return it;\n    const d = Math.hypot(tgt.x - h.x, tgt.y - h.y), danger = Hud.tele.find(t => t.t < t.max * .6 && Math.hypot(h.x - t.x, h.y - t.y) < t.r + 6);\n    const winding = (tgt.atk && tgt.atk.phase === 'wind' && tgt.atk.u > .5) || (tgt.move && tgt.move.ph === 'wind' && tgt.move.u > .6);\n    if (Combat.riposteTarget(h, M)) { it.attackPressed = true; return it; }\n    if (winding && d < 34 && rand() < .6) { it.blockPressed = true; it.blockDown = true; h.facing = Math.atan2(tgt.y - h.y, tgt.x - h.x); return it; }\n    if (danger && rand() < .7) { const a = Math.atan2(h.y - danger.y, h.x - danger.x) + .6; it.move = [Math.cos(a), Math.sin(a)]; it.blockDown = true; it.jumpPressed = Autopilot.t % .8 < dt * 2; return it; }\n    if (d > 18) { const s = Autopilot.steer(h, M, tgt.x, tgt.y, 1); it.move = s.move; it.jumpPressed = s.jump; return it; }\n    h.facing = Math.atan2(tgt.y - h.y, tgt.x - h.x); if (Math.floor(Autopilot.t * 6) % 2 === 0) it.attackPressed = true;\n    return it;\n  }\n  next(); return it;\n};\nB.Autopilot = Autopilot;\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1036,"cache_read_input_tokens":668717,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1036},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"58a16430-39e5-4d69-a4e7-fa8db44e4654","uuid":"826d92c7-4661-4e76-a4d2-03c4c6fdfe17","timestamp":"2026-11-04T02:31:36.640Z","request_id":"req_011Cgh6tGn2xnRcj1c5hA96K","wire_tool_inputs":{"toolu_01VCrnPgfThaJeyQTZvdAGcT":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/src/80-autopilot.js","content":"/* ---- THE AUTOPILOT: it plays the hero by producing intents (never game.input), so attract mode cannot be mistaken\n * for a player. A route is a list of beats: { at, facing } teleport, { goto: [cx, cy], gait } walk a flow field there,\n * { wait }, { until }, { press }, { hold, s }, { grapple: [cx, cy, z] }, { use: tool, at }, { cut: guardId }, { fight: s },\n * { camera }, { say }, { fn }. Each beat gives up after 8 s (or its max) so a loop can never stick ---- */\nconst Autopilot = { beats: [], i: 0, t: 0, held: {}, log: [], timeouts: 0, name: null };\nAutopilot.load = (beats, name) => { Autopilot.beats = beats.slice(); Autopilot.i = 0; Autopilot.t = 0; Autopilot.held = {}; Autopilot.name = name || null; Autopilot.timeouts = 0; Autopilot.started = false; };\nAutopilot.done = () => Autopilot.i >= Autopilot.beats.length;\nconst heroFlowKey = (W, tx, ty) => 'h' + toCell(tx) + ',' + toCell(ty);\n/** a flow field for the hero (its own map: water swims, ledges of 30 climb, gaps of 60 leap) */\nAutopilot.flow = (W, tx, ty) => {\n  const k = heroFlowKey(W, tx, ty); let f = W.flows.get(k);\n  if (!f) { f = new E.FlowField(W.map, { climb: 30, drop: 48, jump: 60 }); W.flows.set(k, f); if (W.flows.size > 32) W.flows.delete(W.flows.keys().next().value); }\n  f.update(cellC(toCell(tx)), cellC(toCell(ty))); return f;\n};\nAutopilot.steer = (h, M, tx, ty, speed = 1) => {\n  const W = M.world, d = Math.hypot(tx - h.x, ty - h.y); if (d < 5) return { move: [0, 0], jump: false, arrived: true };\n  const f = Autopilot.flow(W, tx, ty), nx = f.next(h.x, h.y);\n  let gx = nx ? nx.x : tx, gy = nx ? nx.y : ty; if (!nx || (toCell(nx.x) === toCell(tx) && toCell(nx.y) === toCell(ty))) { gx = tx; gy = ty; }\n  const l = Math.hypot(gx - h.x, gy - h.y) || 1;\n  return { move: [(gx - h.x) / l * speed, (gy - h.y) / l * speed], jump: !!(nx && h.onGround && (nx.kind === 'climb' || nx.kind === 'jump') && nx.edge < h.r + 5), arrived: false };\n};\nAutopilot.intent = M => {\n  const it = B.noIntent(), h = M.hero; if (!h) return it;\n  if (!Autopilot.started) { Autopilot.started = true; Autopilot.t = 0; }\n  if (Autopilot.done()) return it;\n  const b = Autopilot.beats[Autopilot.i], dt = 1 / 120;\n  Autopilot.t += dt;\n  const next = () => { Autopilot.i++; Autopilot.t = 0; Autopilot.sub = null; };\n  if (Autopilot.t > (b.max || 8)) { Autopilot.timeouts++; Autopilot.log.push('timeout ' + (Autopilot.name || '') + ' #' + Autopilot.i + ' ' + Object.keys(b)[0]); next(); return it; }\n  const gait = b.gait || 'run';\n  const setCrouch = want => { if (!!h.crouch !== !!want && !h.swim) it.crouchPressed = true; };\n  if (b.at) { Object.assign(h, { x: cellC(b.at[0]) + (b.dx || 0), y: cellC(b.at[1]) + (b.dy || 0), z: b.at[2] !== undefined ? b.at[2] : M.world.map.groundAt(cellC(b.at[0]), cellC(b.at[1])), vx: 0, vy: 0, vz: 0, onGround: true, action: null }); if (b.facing !== undefined) h.facing = b.facing * Math.PI / 180; h.swim = false; h.dive = false; game.cam.snap = true; if (b.crouch !== undefined) h.crouch = b.crouch; next(); return it; }\n  if (b.wait !== undefined) { if (b.gait) setCrouch(gait === 'crouch'); if (b.focus) it.focusDown = true; if (Autopilot.t >= b.wait) next(); return it; }\n  if (b.until) { if (b.until(M)) next(); return it; }\n  if (b.fn) { b.fn(M, h); next(); return it; }\n  if (b.press) { it[b.press] = true; next(); return it; }\n  if (b.hold) { it[b.hold] = true; if (b.move) it.move = b.move; if (Autopilot.t >= (b.s || .5)) next(); return it; }\n  if (b.face !== undefined) { h.facing = b.face * Math.PI / 180; next(); return it; }\n  if (b.say) { B.Cutscene.radio(b.say[0], b.say[1], b.say[2] || 3); next(); return it; }\n  if (b.camera) { if (b.camera.turn) B.Cam.turn(b.camera.turn); if (b.camera.zoom) B.Cam.cine(b.camera.zoom, b.camera.hold || 2); next(); return it; }\n  if (b.goto) {\n    const tx = cellC(b.goto[0]) + (b.dx || 0), ty = cellC(b.goto[1]) + (b.dy || 0);\n    setCrouch(gait === 'crouch'); if (h.crouch && gait !== 'crouch' && !it.crouchPressed && !h.swim) it.crouchPressed = true;\n    if (b.dive && h.swim && !h.dive) it.crouchPressed = true;\n    const s = Autopilot.steer(h, M, tx, ty, gait === 'walk' ? .5 : 1); it.move = s.move; it.jumpPressed = s.jump; it.sprint = gait === 'sprint';\n    if (s.arrived || Math.hypot(tx - h.x, ty - h.y) < (b.within || 6)) next();\n    return it;\n  }\n  if (b.grapple) {\n    const [cx, cy, z] = b.grapple, tx = cellC(cx), ty = cellC(cy);\n    if (h.action && h.action.name === 'grapple') return it;\n    if (Autopilot.sub === 'fired') { if (!h.action) next(); return it; }\n    const list = Grapple.anchors(h, M); let best = null, bd = 1e9; for (const a of list) { const d = Math.hypot(a.x - tx, a.y - ty) + Math.abs(a.z - (z || a.z)) * 2; if (d < bd) { bd = d; best = a; } }\n    if (best) { h.facing = Math.atan2(best.y - h.y, best.x - h.x); Grapple.fire(h, best, M); Autopilot.sub = 'fired'; }\n    return it;\n  }\n  if (b.use) {\n    const i = h.bento.findIndex(c => c && c.tool === b.use && c.n > 0); if (i < 0) { Hero.give(h, b.use, 1); return it; }\n    h.sel = i; if (b.aim) { const x = cellC(b.aim[0]), y = cellC(b.aim[1]); it.aimPoint = { x, y, z: M.world.map.groundAt(x, y) }; it.mouseMode = true; h.facing = Math.atan2(y - h.y, x - h.x); }\n    if (b.feet) it.blockDown = true;\n    it.usePressed = true; next(); return it;\n  }\n  if (b.cut) {\n    const v = Mission.find(M, b.cut); if (!v || !v.alive) { if (!h.action) next(); return it; }\n    if (h.action) return it;\n    const c = SilentCut.find(h, M);\n    if (c && c.victim === v) { it.attackPressed = true; return it; }\n    // approach from behind on the nav map (crouched), or from the water / a roof as the beat says\n    const f = v.facing, back = b.from === 'above' ? 30 : 12, tx = v.x - Math.cos(f) * back, ty = v.y - Math.sin(f) * back;\n    if (b.from === 'water') { const s = Autopilot.steer(h, M, b.water ? cellC(b.water[0]) : tx, b.water ? cellC(b.water[1]) : ty, .6); it.move = s.move; if (h.swim && !h.dive && b.dive) it.crouchPressed = true; return it; }\n    if (b.from === 'above') { const s = Autopilot.steer(h, M, b.spot ? cellC(b.spot[0]) : tx, b.spot ? cellC(b.spot[1]) : ty, .5); it.move = s.move; return it; }\n    setCrouch(b.gait !== 'run'); const s = Autopilot.steer(h, M, tx, ty, h.crouch ? 1 : .5); it.move = s.move; it.jumpPressed = s.jump;\n    return it;\n  }\n  if (b.fight) {\n    if (Autopilot.t > b.fight || (b.until2 && b.until2(M))) { next(); return it; }\n    const foes = Combat.targets(M).filter(e => e.kind !== 'civ' && (e.kind === 'boss' ? e.active : true)); let tgt = null, bd = 1e9; for (const e of foes) { const d = Math.hypot(e.x - h.x, e.y - h.y) + Math.abs(e.z - h.z) * 4; if (d < bd) { bd = d; tgt = e; } }\n    if (h.crouch) it.crouchPressed = true;\n    if (!tgt) return it;\n    const d = Math.hypot(tgt.x - h.x, tgt.y - h.y), danger = Hud.tele.find(t => t.t < t.max * .6 && Math.hypot(h.x - t.x, h.y - t.y) < t.r + 6);\n    const winding = (tgt.atk && tgt.atk.phase === 'wind' && tgt.atk.u > .5) || (tgt.move && tgt.move.ph === 'wind' && tgt.move.u > .6);\n    if (Combat.riposteTarget(h, M)) { it.attackPressed = true; return it; }\n    if (winding && d < 34 && rand() < .6) { it.blockPressed = true; it.blockDown = true; h.facing = Math.atan2(tgt.y - h.y, tgt.x - h.x); return it; }\n    if (danger && rand() < .7) { const a = Math.atan2(h.y - danger.y, h.x - danger.x) + .6; it.move = [Math.cos(a), Math.sin(a)]; it.blockDown = true; it.jumpPressed = Autopilot.t % .8 < dt * 2; return it; }\n    if (d > 18) { const s = Autopilot.steer(h, M, tgt.x, tgt.y, 1); it.move = s.move; it.jumpPressed = s.jump; return it; }\n    h.facing = Math.atan2(tgt.y - h.y, tgt.x - h.x); if (Math.floor(Autopilot.t * 6) % 2 === 0) it.attackPressed = true;\n    return it;\n  }\n  next(); return it;\n};\nB.Autopilot = Autopilot;\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VCrnPgfThaJeyQTZvdAGcT","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/src/80-autopilot.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"58a16430-39e5-4d69-a4e7-fa8db44e4654","uuid":"b79ee7f2-0e76-413d-a52f-3b3ab8d13948","timestamp":"2026-11-04T02:31:36.665Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/src/80-autopilot.js","content":"/* ---- THE AUTOPILOT: it plays the hero by producing intents (never game.input), so attract mode cannot be mistaken\n * for a player. A route is a list of beats: { at, facing } teleport, { goto: [cx, cy], gait } walk a flow field there,\n * { wait }, { until }, { press }, { hold, s }, { grapple: [cx, cy, z] }, { use: tool, at }, { cut: guardId }, { fight: s },\n * { camera }, { say }, { fn }. Each beat gives up after 8 s (or its max) so a loop can never stick ---- */\nconst Autopilot = { beats: [], i: 0, t: 0, held: {}, log: [], timeouts: 0, name: null };\nAutopilot.load = (beats, name) => { Autopilot.beats = beats.slice(); Autopilot.i = 0; Autopilot.t = 0; Autopilot.held = {}; Autopilot.name = name || null; Autopilot.timeouts = 0; Autopilot.started = false; };\nAutopilot.done = () => Autopilot.i >= Autopilot.beats.length;\nconst heroFlowKey = (W, tx, ty) => 'h' + toCell(tx) + ',' + toCell(ty);\n/** a flow field for the hero (its own map: water swims, ledges of 30 climb, gaps of 60 leap) */\nAutopilot.flow = (W, tx, ty) => {\n  const k = heroFlowKey(W, tx, ty); let f = W.flows.get(k);\n  if (!f) { f = new E.FlowField(W.map, { climb: 30, drop: 48, jump: 60 }); W.flows.set(k, f); if (W.flows.size > 32) W.flows.delete(W.flows.keys().next().value); }\n  f.update(cellC(toCell(tx)), cellC(toCell(ty))); return f;\n};\nAutopilot.steer = (h, M, tx, ty, speed = 1) => {\n  const W = M.world, d = Math.hypot(tx - h.x, ty - h.y); if (d < 5) return { move: [0, 0], jump: false, arrived: true };\n  const f = Autopilot.flow(W, tx, ty), nx = f.next(h.x, h.y);\n  let gx = nx ? nx.x : tx, gy = nx ? nx.y : ty; if (!nx || (toCell(nx.x) === toCell(tx) && toCell(nx.y) === toCell(ty))) { gx = tx; gy = ty; }\n  const l = Math.hypot(gx - h.x, gy - h.y) || 1;\n  return { move: [(gx - h.x) / l * speed, (gy - h.y) / l * speed], jump: !!(nx && h.onGround && (nx.kind === 'climb' || nx.kind === 'jump') && nx.edge < h.r + 5), arrived: false };\n};\nAutopilot.intent = M => {\n  const it = B.noIntent(), h = M.hero; if (!h) return it;\n  if (!Autopilot.started) { Autopilot.started = true; Autopilot.t = 0; }\n  if (Autopilot.done()) return it;\n  const b = Autopilot.beats[Autopilot.i], dt = 1 / 120;\n  Autopilot.t += dt;\n  const next = () => { Autopilot.i++; Autopilot.t = 0; Autopilot.sub = null; };\n  if (Autopilot.t > (b.max || 8)) { Autopilot.timeouts++; Autopilot.log.push('timeout ' + (Autopilot.name || '') + ' #' + Autopilot.i + ' ' + Object.keys(b)[0]); next(); return it; }\n  const gait = b.gait || 'run';\n  const setCrouch = want => { if (!!h.crouch !== !!want && !h.swim) it.crouchPressed = true; };\n  if (b.at) { Object.assign(h, { x: cellC(b.at[0]) + (b.dx || 0), y: cellC(b.at[1]) + (b.dy || 0), z: b.at[2] !== undefined ? b.at[2] : M.world.map.groundAt(cellC(b.at[0]), cellC(b.at[1])), vx: 0, vy: 0, vz: 0, onGround: true, action: null }); if (b.facing !== undefined) h.facing = b.facing * Math.PI / 180; h.swim = false; h.dive = false; game.cam.snap = true; if (b.crouch !== undefined) h.crouch = b.crouch; next(); return it; }\n  if (b.wait !== undefined) { if (b.gait) setCrouch(gait === 'crouch'); if (b.focus) it.focusDown = true; if (Autopilot.t >= b.wait) next(); return it; }\n  if (b.until) { if (b.until(M)) next(); return it; }\n  if (b.fn) { b.fn(M, h); next(); return it; }\n  if (b.press) { it[b.press] = true; next(); return it; }\n  if (b.hold) { it[b.hold] = true; if (b.move) it.move = b.move; if (Autopilot.t >= (b.s || .5)) next(); return it; }\n  if (b.face !== undefined) { h.facing = b.face * Math.PI / 180; next(); return it; }\n  if (b.say) { B.Cutscene.radio(b.say[0], b.say[1], b.say[2] || 3); next(); return it; }\n  if (b.camera) { if (b.camera.turn) B.Cam.turn(b.camera.turn); if (b.camera.zoom) B.Cam.cine(b.camera.zoom, b.camera.hold || 2); next(); return it; }\n  if (b.goto) {\n    const tx = cellC(b.goto[0]) + (b.dx || 0), ty = cellC(b.goto[1]) + (b.dy || 0);\n    setCrouch(gait === 'crouch'); if (h.crouch && gait !== 'crouch' && !it.crouchPressed && !h.swim) it.crouchPressed = true;\n    if (b.dive && h.swim && !h.dive) it.crouchPressed = true;\n    const s = Autopilot.steer(h, M, tx, ty, gait === 'walk' ? .5 : 1); it.move = s.move; it.jumpPressed = s.jump; it.sprint = gait === 'sprint';\n    if (s.arrived || Math.hypot(tx - h.x, ty - h.y) < (b.within || 6)) next();\n    return it;\n  }\n  if (b.grapple) {\n    const [cx, cy, z] = b.grapple, tx = cellC(cx), ty = cellC(cy);\n    if (h.action && h.action.name === 'grapple') return it;\n    if (Autopilot.sub === 'fired') { if (!h.action) next(); return it; }\n    const list = Grapple.anchors(h, M); let best = null, bd = 1e9; for (const a of list) { const d = Math.hypot(a.x - tx, a.y - ty) + Math.abs(a.z - (z || a.z)) * 2; if (d < bd) { bd = d; best = a; } }\n    if (best) { h.facing = Math.atan2(best.y - h.y, best.x - h.x); Grapple.fire(h, best, M); Autopilot.sub = 'fired'; }\n    return it;\n  }\n  if (b.use) {\n    const i = h.bento.findIndex(c => c && c.tool === b.use && c.n > 0); if (i < 0) { Hero.give(h, b.use, 1); return it; }\n    h.sel = i; if (b.aim) { const x = cellC(b.aim[0]), y = cellC(b.aim[1]); it.aimPoint = { x, y, z: M.world.map.groundAt(x, y) }; it.mouseMode = true; h.facing = Math.atan2(y - h.y, x - h.x); }\n    if (b.feet) it.blockDown = true;\n    it.usePressed = true; next(); return it;\n  }\n  if (b.cut) {\n    const v = Mission.find(M, b.cut); if (!v || !v.alive) { if (!h.action) next(); return it; }\n    if (h.action) return it;\n    const c = SilentCut.find(h, M);\n    if (c && c.victim === v) { it.attackPressed = true; return it; }\n    // approach from behind on the nav map (crouched), or from the water / a roof as the beat says\n    const f = v.facing, back = b.from === 'above' ? 30 : 12, tx = v.x - Math.cos(f) * back, ty = v.y - Math.sin(f) * back;\n    if (b.from === 'water') { const s = Autopilot.steer(h, M, b.water ? cellC(b.water[0]) : tx, b.water ? cellC(b.water[1]) : ty, .6); it.move = s.move; if (h.swim && !h.dive && b.dive) it.crouchPressed = true; return it; }\n    if (b.from === 'above') { const s = Autopilot.steer(h, M, b.spot ? cellC(b.spot[0]) : tx, b.spot ? cellC(b.spot[1]) : ty, .5); it.move = s.move; return it; }\n    setCrouch(b.gait !== 'run'); const s = Autopilot.steer(h, M, tx, ty, h.crouch ? 1 : .5); it.move = s.move; it.jumpPressed = s.jump;\n    return it;\n  }\n  if (b.fight) {\n    if (Autopilot.t > b.fight || (b.until2 && b.until2(M))) { next(); return it; }\n    const foes = Combat.targets(M).filter(e => e.kind !== 'civ' && (e.kind === 'boss' ? e.active : true)); let tgt = null, bd = 1e9; for (const e of foes) { const d = Math.hypot(e.x - h.x, e.y - h.y) + Math.abs(e.z - h.z) * 4; if (d < bd) { bd = d; tgt = e; } }\n    if (h.crouch) it.crouchPressed = true;\n    if (!tgt) return it;\n    const d = Math.hypot(tgt.x - h.x, tgt.y - h.y), danger = Hud.tele.find(t => t.t < t.max * .6 && Math.hypot(h.x - t.x, h.y - t.y) < t.r + 6);\n    const winding = (tgt.atk && tgt.atk.phase === 'wind' && tgt.atk.u > .5) || (tgt.move && tgt.move.ph === 'wind' && tgt.move.u > .6);\n    if (Combat.riposteTarget(h, M)) { it.attackPressed = true; return it; }\n    if (winding && d < 34 && rand() < .6) { it.blockPressed = true; it.blockDown = true; h.facing = Math.atan2(tgt.y - h.y, tgt.x - h.x); return it; }\n    if (danger && rand() < .7) { const a = Math.atan2(h.y - danger.y, h.x - danger.x) + .6; it.move = [Math.cos(a), Math.sin(a)]; it.blockDown = true; it.jumpPressed = Autopilot.t % .8 < dt * 2; return it; }\n    if (d > 18) { const s = Autopilot.steer(h, M, tgt.x, tgt.y, 1); it.move = s.move; it.jumpPressed = s.jump; return it; }\n    h.facing = Math.atan2(tgt.y - h.y, tgt.x - h.x); if (Math.floor(Autopilot.t * 6) % 2 === 0) it.attackPressed = true;\n    return it;\n  }\n  next(); return it;\n};\nB.Autopilot = Autopilot;\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01VCrnPgfThaJeyQTZvdAGcT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
