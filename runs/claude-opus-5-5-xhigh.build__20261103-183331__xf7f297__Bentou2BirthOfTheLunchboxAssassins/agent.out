+ def.once;\\n  b.moveLog = b.moveLog || {}; b.moveLog[def.name] = (b.moveLog[def.name] || 0) + 1;\"\nassert old in s; s=s.replace(old,new); open(p,'w',encoding='utf8').write(s)\nprint('ok')\nEOF","description":"Blind guards in smoke and log boss moves"}},"wire_ingest_context":{"toolu_01CjWSA7hX1Rr3v8eiU39PUa":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331"}}}
