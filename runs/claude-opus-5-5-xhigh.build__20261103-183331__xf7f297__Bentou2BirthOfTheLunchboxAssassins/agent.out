    t.intent({}, 3);\n    check(ch + ': the choreography ends, the guard falls', !h.action && !g.alive, (h.action && h.action.name) + ' alive ' + g.alive);\n    check(ch + ': counted', M.stats.silentCuts === 1, M.stats.silentCuts);\n    check(ch + ': time back to normal', game.timeScale === 1, game.timeScale);\n  }\n  M.objectives = []; const sc = B.Score.story(M, 300); check('a Silent Cut scores 150', sc.parts.find(p => p[0] === 'Silent Cuts')[1] === 150, JSON.stringify(sc.parts));\n  // every kind's choreography runs to the end for both\n  for (const k of ['side', 'front', 'above', 'undertow']) for (const ch of ['sojiro', 'kaede']) { const s = B.SilentCut; [M, h, g] = setup({}, ch); place(h, g, Math.PI, 14); s.run(h, k, g, M); t.intent({}, 3); check(k + ' (' + ch + ') runs to the end', !h.acti\n}\nSilentCut.run = (h, kind, v, M) => {\n  const ch = h.char === 'kaede' ? 'kaede' : 'sojiro', mark = !!v.mark;\n  h.combo.cancel(); Hero.unhug(h); h.crouch = false;\n  if (v.drag) { /* dragged bodies are never victims */ }\n  const act = h.play('cut_' + kind + '_' + ch, { other: v, map: M.world.map, kind, speed: ch === 'kaede' ? 1.12 : 1 });\n  v.cutBy = act; v.vx = v.vy = 0; if (v.atk) v.atk.cancel && v.atk.cancel(); v.fighting = false;\n  act.cut = { kind, victim: v, mark, struck: false };\n  SilentCut.active = act;\n  // presentation: hit-stop, slow motion, a zoom, letterbox and the splash\n  game.freeze(.05); SilentCut.slowT = .55; game.timeScale = T('slowmo'); B.Cam.cine(1.8, .9);\n  B.Hud.letterbox(1.0); B.Hud.splash(kind, mark);\n  Au.sfx('stingCut'); Au.sfx('cutTwang', { vol: .8 });\n  if (CUT_NOISE[kind]) B.noise(v.x, v.y, v.z, CUT_NOISE[kind], 'grunt');\n  if (!mark && v.kind !== 'civ') B.Voice.bark(pickR(B.Story.barks.hurt), v.voice || 'guard', v.x, v.y, { force: true });\n};\n/** each step: strike when the choreography reaches its blow, restore time after the slow motion */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_