 ? M.world.map.groundAt(a.x, a.y, a.r, a.z) : 0;\n  if (!a.noShadow) r.shadow(a.x, a.y, a.kind === 'boss' ? 10 : 6, .35, undefined, ground);\n  const rig = a.rig;\n  r.actor(a.x, a.y, z, (g, ox, oy) => rig.draw(g, ox, oy, r.view), o);\n};\nB.Actor = Actor;\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_012CGZJfhieVUGdjENa6QkEd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
