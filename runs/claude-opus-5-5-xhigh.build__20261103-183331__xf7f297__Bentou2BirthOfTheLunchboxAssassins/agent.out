{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh8Pt8hppQgQJmv6JLu8","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01G34pfunpnnPGFaa9uukZf5","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/tests && cat > move.test.mjs <<'EOF'\n// move: run, walk and crouch speeds; vault 14; climb 30; not 40 (the grapple); swim, dive unseen, breath and drowning; the\n// shallows slow; the wall hug; fall damage\nimport { loadYard, C } from './lib.mjs';\nconst S = 1 / 120;\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  let M = loadYard(t), h = M.hero;\n  const speed = (it, s = 1) => { const x0 = h.x, y0 = h.y; t.intent(it, s); return Math.hypot(h.x - x0, h.y - y0) / s; };\n  game.debug.teleport(C(2), C(11), 0, 0); t.intent({ move: [1, 0] }, .3);\n  const run = speed({ move: [1, 0] }); check('runs at the run speed', Math.abs(run - B.T('heroRun')) < 8, run);\n  game.debug.teleport(C(2), C(11), 0, 0); t.intent({ move: [.4, 0] }, .3); const walk = speed({ move: [.4, 0] }); check('a light tilt walks (50)', Math.abs(walk - 50) < 6, walk);\n  game.debug.teleport(C(2), C(11), 0, 0); t.intent({ crouchPressed: true }, S); t.intent({ move: [1, 0] }, .3); const cr = speed({ move: [1, 0] }); check('crouched it sneaks (32)', h.crouch && Math.abs(cr - B.T('heroSneak')) < 5, cr);\n  t.intent({ crouchPressed: true }, S);\n  // the fence (x 20, h 14): vault it at a run\n  game.debug.teleport(C(18), C(6), 0, 0); t.intent({ move: [1, 0] }, .15); t.intent({ move: [1, 0], jumpPressed: true }, S); t.intent({ move: [1, 0] }, 1);\n  check('vaults the bamboo fence', h.x > C(20) + 6, h.x / 16);\n  // the wall (x 4, h 30): climb it\n  game.debug.teleport(C(2), C(6), 0, 0); t.intent({ move: [1, 0] }, .3); t.intent({ move: [1, 0], jumpPressed: true }, S); t.intent({ move: [0, 0] }, 1.2);\n  check('climbs a 30 wall', Math.abs(h.z - 30) < 1, h.z);\n  // the townhouse (h 40): too tall to climb\n  game.debug.teleport(C(7), C(5), 0, 0); t.intent({ move: [1, 0] }, .3); t.intent({ move: [1, 0], jumpPressed: true }, S); t.intent({ move: [0, 0] }, 1.2);\n  check('cannot climb a 40 roof (it needs the grapple)', h.z < 2, h.z);\n  // the pond: swim, dive (unseen), breath, drowning\n  game.debug.teleport(C(6), C(13), 0, Math.PI / 2); t.intent({ move: [0, 1] }, .8);\n  check('deep water swims', h.swim, JSON.stringify(t.snap().hero));\n  t.intent({ crouchPressed: true }, S); t.intent({}, .2);\n  check('crouch dives', h.dive, h.dive);\n  check('diving is unseen (exposure 0)', B.Perception.exposure(h, M) === 0, B.Perception.exposure(h, M));\n  const b0 = h.breath; t.intent({}, 2); check('breath runs down underwater', h.breath < b0 - 1.5, h.breath);\n  h.breath = .1; const hp0 = h.hp; t.intent({}, 1); check('out of breath, it drowns', h.hp < hp0 - 5, h.hp);\n  t.intent({ crouchPressed: true }, S); t.intent({}, .2); check('crouch again surfaces', !h.dive, h.dive);\n  // the shallows slow\n  game.debug.teleport(C(10), C(14), 0, Math.PI / 2); t.intent({ move: [0, 1] }, .2); const sh = speed({ move: [0, 1] }, .5); check('the shallows slow the run', sh < B.T('heroRun') * .8, sh);\n  // the wall hug: crouched, pushing into the townhouse\n  game.debug.teleport(C(9), C(7) + 2, 0, -Math.PI / 2); h.crouch = true; t.intent({ move: [0, -1] }, .5);\n  check('crouched against a wall it hugs it', !!h.hug, JSON.stringify({ hug: h.hug, crouch: h.crouch }));\n  t.intent({ move: [1, 0] }, 1.2); check('the hug slides along the wall, and peeks at its end', !!h.hug && (!!h.peek || h.x > C(9) + 8), JSON.stringify({ x: h.x / 16, peek: h.peek }));\n  t.intent({ move: [0, 1] }, .3); check('pushing away leaves the wall', !h.hug, !!h.hug);\n  // a fall over 72 hurts\n  h.crouch = false; game.debug.teleport(C(25), C(11), 0); h.z = 110; h.onGround = false; h._peak = 110; const hp1 = h.hp; t.intent({}, 1.5);\n  check('a fall over 72 hurts', h.hp <= hp1 - 14, hp1 - h.hp);\n}\nEOF\ncat > grapple.test.mjs <<'EOF'\n// grapple: the anchor at an edge; a tap pulls the hero up; no anchor through a wall; range and rise follow the sliders;\n// the mouse picks the anchor under it\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const M = loadYard(t), h = M.hero, G = B.Grapple;\n  game.debug.teleport(C(15), C(8), 0, -Math.PI / 2); t.step(.2);\n  let list = G.anchors(h, M); check('an anchor at the storehouse edge', list.some(a => a.z === 48 && a.cx >= 14 && a.cx <= 16), list.map(a => a.cx + ',' + a.cy + '@' + a.z).join(' '));\n  t.intent({ grapplePressed: true }, 1 / 120); t.intent({}, 1.6);\n  check('a tap pulls the hero onto the roof', Math.abs(h.z - 48) < 1, h.z);\n  game.debug.teleport(C(12), C(5), 0, Math.PI); t.step(.1);\n  list = G.anchors(h, M); check('no anchor through a wall (the townhouse\\'s far side)', !list.some(a => a.cx === 8 && a.nx === -1), list.map(a => a.cx + ',' + a.cy + ' n' + a.nx).join(' '));\n  game.debug.teleport(C(15), C(12), 0, -Math.PI / 2); t.step(.1);\n  const far = G.anchors(h, M).filter(a => a.z === 48).length; game.debug.tune('grappleRange', 64); const near = G.anchors(h, M).filter(a => a.z === 48).length; game.debug.resetTune();\n  check('the range slider limits the reach', far > 0 && near === 0, far + ' then ' + near);\n  // the mouse: the anchor drawn nearest the pointer wins\n  game.debug.teleport(C(12), C(8), 0, -Math.PI / 2); t.step(.1); list = G.anchors(h, M);\n  list.forEach((a, i) => { a.sx = i * 40; a.sy = 50; }); const want = list[list.length - 1], was = game.input.pointer;\n  game.input.pointer = () => [want.sx + 2, 51]; const pick = G.pick(h, { mouseMode: true, move: [0, 0] }, list); game.input.pointer = was;\n  check('the mouse picks the anchor under it', pick === want, pick && pick.cx);\n}\nEOF\ncat > perception.test.mjs <<'EOF'\n// perception: a lit hero in the cone is caught; crouched in shadow is not; a roof above is out of view; running is heard,\n// crouching is not; smoke and grass hide; lightning exposes; a body found heightens the level\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const g1 = { id: 'g', type: 'ashigaru', at: [6, 2], facing: 90, mode: 'post' };\n  let M = loadYard(t, { guards: [g1] }), h = M.hero, g = M.guards[0];\n  const reset = () => { g.mind.reset(); g.x = C(6); g.y = C(2); g.facing = Math.PI / 2; g.home.facing = Math.PI / 2; g.target = null; };\n  g.mode = 'stand'; game.debug.teleport(C(6), C(2) + 60, 0, -Math.PI / 2); M.world.dynStep.push(); M.world.light.fill(1);\n  t.intent({}, 2); check('a lit hero 60 ahead is caught within 2 s', g.mind.state === 'alert', g.mind.state + ' ' + g.mind.level.toFixed(2));\n  M.world.bake(); reset(); h.crouch = true; game.debug.teleport(C(6), C(2) + 100, 0, -Math.PI / 2); h.crouch = true;\n  for (const L of M.world.lights) L.i = 0; M.world.bake(); t.intent({}, 5);\n  check('crouched in shadow at 100 stays calm', g.mind.state === 'calm', g.mind.state + ' ' + g.mind.level.toFixed(2) + ' exp ' + B.Perception.exposure(h, M).toFixed(2));\n  // on a roof, right above\n  M = loadYard(t, { guards: [Object.assign({}, g1, { at: [9, 8], facing: 270 })] }); h = M.hero; g = M.guards[0]; g.mode = 'stand'; M.world.light.fill(1);\n  game.debug.teleport(C(9), C(6), 40, 0); t.intent({}, 3); check('a hero on a roof right above is out of view', g.mind.state === 'calm', g.mind.state);\n  // hearing: running at 50 is heard, crouching is not\n  M = loadYard(t, { guards: [Object.assign({}, g1, { at: [24, 11], facing: 0 })] }); h = M.hero; g = M.guards[0]; g.mode = 'stand';\n  game.debug.teleport(C(24) - 70, C(11), 0, Math.PI / 2); h.crouch = true; t.intent({ move: [0, 1] }, 1); check('crouch-walking is not heard', g.mind.level < .1, g.mind.level);\n  h.crouch = false; game.debug.teleport(C(24) - 50, C(11), 0, Math.PI / 2); t.intent({ move: [0, 1] }, .7); check('running at 50 is heard', g.mind.level > .1 || g.mind.state !== 'calm', g.mind.level);\n  // smoke between them blocks sight; grass hides a crouching hero\n  M = loadYard(t, { guards: [g1] }); h = M.hero; g = M.guards[0]; g.mode = 'stand'; M.world.light.fill(1);\n  game.debug.teleport(C(6), C(2) + 70, 0, -Math.PI / 2); M.clouds.push({ x: C(6), y: C(2) + 35, z: 0, r: 30, t: 30, t0: 30 });\n  t.intent({}, 2); check('smoke blocks sight', g.mind.state === 'calm', g.mind.state);\n  M = loadYard(t, { guards: [Object.assign({}, g1, { at: [16, 11], facing: 90 })] }); h = M.hero; g = M.guards[0]; g.mode = 'stand';\n  game.debug.teleport(C(16), C(15), 0, -Math.PI / 2); h.crouch = true; t.intent({}, 3); check('crouched in tall grass, unseen', g.mind.state === 'calm', g.mind.state + ' exp ' + B.Perception.exposure(h, M).toFixed(2));\n  const e0 = B.Perception.exposure(h, M); h.crouch = false; game.debug.teleport(C(20), C(10), 0); const dark = B.Perception.exposure(h, M); M.world.flash = .2; const lit = B.Perception.exposure(h, M); M.world.flash = 0;\n  check('lightning exposes', lit > dark * 1.5, dark + ' -> ' + lit); void e0;\n  // a body in the light: found, the level heightened\n  M = loadYard(t, { guards: [g1, { id: 'b', type: 'ashigaru', at: [6, 6], mode: 'post' }] }); g = M.guards[0]; g.mode = 'stand'; M.world.light.fill(1); M.guards[1].alive = false;\n  game.debug.teleport(C(26), C(20), 0); t.intent({}, 1.5); check('a body is found: heightened', M.heightened > 0 && M.guards[1].found, M.heightened);\n}\nEOF\ncat > ki.test.mjs <<'EOF'\n// ki: the number at a known distance; Shadow Sight: visible, sensed behind a wall, hidden beyond; Ki Focus reaches further\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], facing: 90, mode: 'post' }] }), h = M.hero, g = M.guards[0];\n  g.mode = 'stand';\n  game.debug.teleport(C(12) - 80, C(11), 0); t.step(.2);\n  check('the Ki number at 80 is 50', Math.abs(B.Perception.ki - 50) <= 2, B.Perception.ki);\n  check('in plain view the guard is visible', g.vis === 'visible', g.vis);\n  game.debug.teleport(C(9), C(2), 0); g.x = C(9); g.y = C(9); t.step(.2);\n  check('behind the townhouse it is sensed', g.vis === 'sensed', g.vis);\n  game.debug.teleport(C(2), C(21), 0); g.x = C(27); g.y = C(2); t.step(.2);\n  check('beyond the Ki range, and out of sight, it is hidden', g.vis === 'hidden' || g.vis === 'visible', g.vis);\n  game.debug.teleport(C(9), C(2), 0); g.x = C(9); g.y = C(2) + 190; t.step(.2); const before = g.vis;\n  t.intent({ focusDown: true }, .3); const after = g.vis;\n  check('Ki Focus senses further', (before === 'hidden' && after !== 'hidden') || before === 'visible', before + ' -> ' + after);\n}\nEOF\ncd .. && node tests/run.mjs --fast move grapple perception ki 2>&1 | tail -25","description":"Write and run move, grapple, perception and ki suites","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1160,"cache_read_input_tokens":787141,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1160},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"58a16430-39e5-4d69-a4e7-fa8db44e4654","uuid":"f912851d-862d-40af-a6fa-1a25d8b5dac4","timestamp":"2026-11-04T02:51:22.776Z","request_id":"req_011Cgh8Psrqasv7Xaeu8uUVs","wire_tool_inputs":{"toolu_01G34pfunpnnPGFaa9uukZf5":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/tests && cat > move.test.mjs <<'EOF'\n// move: run, walk and crouch speeds; vault 14; climb 30; not 40 (the grapple); swim, dive unseen, breath and drowning; the\n// shallows slow; the wall hug; fall damage\nimport { loadYard, C } from './lib.mjs';\nconst S = 1 / 120;\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  let M = loadYard(t), h = M.hero;\n  const speed = (it, s = 1) => { const x0 = h.x, y0 = h.y; t.intent(it, s); return Math.hypot(h.x - x0, h.y - y0) / s; };\n  game.debug.teleport(C(2), C(11), 0, 0); t.intent({ move: [1, 0] }, .3);\n  const run = speed({ move: [1, 0] }); check('runs at the run speed', Math.abs(run - B.T('heroRun')) < 8, run);\n  game.debug.teleport(C(2), C(11), 0, 0); t.intent({ move: [.4, 0] }, .3); const walk = speed({ move: [.4, 0] }); check('a light tilt walks (50)', Math.abs(walk - 50) < 6, walk);\n  game.debug.teleport(C(2), C(11), 0, 0); t.intent({ crouchPressed: true }, S); t.intent({ move: [1, 0] }, .3); const cr = speed({ move: [1, 0] }); check('crouched it sneaks (32)', h.crouch && Math.abs(cr - B.T('heroSneak')) < 5, cr);\n  t.intent({ crouchPressed: true }, S);\n  // the fence (x 20, h 14): vault it at a run\n  game.debug.teleport(C(18), C(6), 0, 0); t.intent({ move: [1, 0] }, .15); t.intent({ move: [1, 0], jumpPressed: true }, S); t.intent({ move: [1, 0] }, 1);\n  check('vaults the bamboo fence', h.x > C(20) + 6, h.x / 16);\n  // the wall (x 4, h 30): climb it\n  game.debug.teleport(C(2), C(6), 0, 0); t.intent({ move: [1, 0] }, .3); t.intent({ move: [1, 0], jumpPressed: true }, S); t.intent({ move: [0, 0] }, 1.2);\n  check('climbs a 30 wall', Math.abs(h.z - 30) < 1, h.z);\n  // the townhouse (h 40): too tall to climb\n  game.debug.teleport(C(7), C(5), 0, 0); t.intent({ move: [1, 0] }, .3); t.intent({ move: [1, 0], jumpPressed: true }, S); t.intent({ move: [0, 0] }, 1.2);\n  check('cannot climb a 40 roof (it needs the grapple)', h.z < 2, h.z);\n  // the pond: swim, dive (unseen), breath, drowning\n  game.debug.teleport(C(6), C(13), 0, Math.PI / 2); t.intent({ move: [0, 1] }, .8);\n  check('deep water swims', h.swim, JSON.stringify(t.snap().hero));\n  t.intent({ crouchPressed: true }, S); t.intent({}, .2);\n  check('crouch dives', h.dive, h.dive);\n  check('diving is unseen (exposure 0)', B.Perception.exposure(h, M) === 0, B.Perception.exposure(h, M));\n  const b0 = h.breath; t.intent({}, 2); check('breath runs down underwater', h.breath < b0 - 1.5, h.breath);\n  h.breath = .1; const hp0 = h.hp; t.intent({}, 1); check('out of breath, it drowns', h.hp < hp0 - 5, h.hp);\n  t.intent({ crouchPressed: true }, S); t.intent({}, .2); check('crouch again surfaces', !h.dive, h.dive);\n  // the shallows slow\n  game.debug.teleport(C(10), C(14), 0, Math.PI / 2); t.intent({ move: [0, 1] }, .2); const sh = speed({ move: [0, 1] }, .5); check('the shallows slow the run', sh < B.T('heroRun') * .8, sh);\n  // the wall hug: crouched, pushing into the townhouse\n  game.debug.teleport(C(9), C(7) + 2, 0, -Math.PI / 2); h.crouch = true; t.intent({ move: [0, -1] }, .5);\n  check('crouched against a wall it hugs it', !!h.hug, JSON.stringify({ hug: h.hug, crouch: h.crouch }));\n  t.intent({ move: [1, 0] }, 1.2); check('the hug slides along the wall, and peeks at its end', !!h.hug && (!!h.peek || h.x > C(9) + 8), JSON.stringify({ x: h.x / 16, peek: h.peek }));\n  t.intent({ move: [0, 1] }, .3); check('pushing away leaves the wall', !h.hug, !!h.hug);\n  // a fall over 72 hurts\n  h.crouch = false; game.debug.teleport(C(25), C(11), 0); h.z = 110; h.onGround = false; h._peak = 110; const hp1 = h.hp; t.intent({}, 1.5);\n  check('a fall over 72 hurts', h.hp <= hp1 - 14, hp1 - h.hp);\n}\nEOF\ncat > grapple.test.mjs <<'EOF'\n// grapple: the anchor at an edge; a tap pulls the hero up; no anchor through a wall; range and rise follow the sliders;\n// the mouse picks the anchor under it\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const M = loadYard(t), h = M.hero, G = B.Grapple;\n  game.debug.teleport(C(15), C(8), 0, -Math.PI / 2); t.step(.2);\n  let list = G.anchors(h, M); check('an anchor at the storehouse edge', list.some(a => a.z === 48 && a.cx >= 14 && a.cx <= 16), list.map(a => a.cx + ',' + a.cy + '@' + a.z).join(' '));\n  t.intent({ grapplePressed: true }, 1 / 120); t.intent({}, 1.6);\n  check('a tap pulls the hero onto the roof', Math.abs(h.z - 48) < 1, h.z);\n  game.debug.teleport(C(12), C(5), 0, Math.PI); t.step(.1);\n  list = G.anchors(h, M); check('no anchor through a wall (the townhouse\\'s far side)', !list.some(a => a.cx === 8 && a.nx === -1), list.map(a => a.cx + ',' + a.cy + ' n' + a.nx).join(' '));\n  game.debug.teleport(C(15), C(12), 0, -Math.PI / 2); t.step(.1);\n  const far = G.anchors(h, M).filter(a => a.z === 48).length; game.debug.tune('grappleRange', 64); const near = G.anchors(h, M).filter(a => a.z === 48).length; game.debug.resetTune();\n  check('the range slider limits the reach', far > 0 && near === 0, far + ' then ' + near);\n  // the mouse: the anchor drawn nearest the pointer wins\n  game.debug.teleport(C(12), C(8), 0, -Math.PI / 2); t.step(.1); list = G.anchors(h, M);\n  list.forEach((a, i) => { a.sx = i * 40; a.sy = 50; }); const want = list[list.length - 1], was = game.input.pointer;\n  game.input.pointer = () => [want.sx + 2, 51]; const pick = G.pick(h, { mouseMode: true, move: [0, 0] }, list); game.input.pointer = was;\n  check('the mouse picks the anchor under it', pick === want, pick && pick.cx);\n}\nEOF\ncat > perception.test.mjs <<'EOF'\n// perception: a lit hero in the cone is caught; crouched in shadow is not; a roof above is out of view; running is heard,\n// crouching is not; smoke and grass hide; lightning exposes; a body found heightens the level\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const g1 = { id: 'g', type: 'ashigaru', at: [6, 2], facing: 90, mode: 'post' };\n  let M = loadYard(t, { guards: [g1] }), h = M.hero, g = M.guards[0];\n  const reset = () => { g.mind.reset(); g.x = C(6); g.y = C(2); g.facing = Math.PI / 2; g.home.facing = Math.PI / 2; g.target = null; };\n  g.mode = 'stand'; game.debug.teleport(C(6), C(2) + 60, 0, -Math.PI / 2); M.world.dynStep.push(); M.world.light.fill(1);\n  t.intent({}, 2); check('a lit hero 60 ahead is caught within 2 s', g.mind.state === 'alert', g.mind.state + ' ' + g.mind.level.toFixed(2));\n  M.world.bake(); reset(); h.crouch = true; game.debug.teleport(C(6), C(2) + 100, 0, -Math.PI / 2); h.crouch = true;\n  for (const L of M.world.lights) L.i = 0; M.world.bake(); t.intent({}, 5);\n  check('crouched in shadow at 100 stays calm', g.mind.state === 'calm', g.mind.state + ' ' + g.mind.level.toFixed(2) + ' exp ' + B.Perception.exposure(h, M).toFixed(2));\n  // on a roof, right above\n  M = loadYard(t, { guards: [Object.assign({}, g1, { at: [9, 8], facing: 270 })] }); h = M.hero; g = M.guards[0]; g.mode = 'stand'; M.world.light.fill(1);\n  game.debug.teleport(C(9), C(6), 40, 0); t.intent({}, 3); check('a hero on a roof right above is out of view', g.mind.state === 'calm', g.mind.state);\n  // hearing: running at 50 is heard, crouching is not\n  M = loadYard(t, { guards: [Object.assign({}, g1, { at: [24, 11], facing: 0 })] }); h = M.hero; g = M.guards[0]; g.mode = 'stand';\n  game.debug.teleport(C(24) - 70, C(11), 0, Math.PI / 2); h.crouch = true; t.intent({ move: [0, 1] }, 1); check('crouch-walking is not heard', g.mind.level < .1, g.mind.level);\n  h.crouch = false; game.debug.teleport(C(24) - 50, C(11), 0, Math.PI / 2); t.intent({ move: [0, 1] }, .7); check('running at 50 is heard', g.mind.level > .1 || g.mind.state !== 'calm', g.mind.level);\n  // smoke between them blocks sight; grass hides a crouching hero\n  M = loadYard(t, { guards: [g1] }); h = M.hero; g = M.guards[0]; g.mode = 'stand'; M.world.light.fill(1);\n  game.debug.teleport(C(6), C(2) + 70, 0, -Math.PI / 2); M.clouds.push({ x: C(6), y: C(2) + 35, z: 0, r: 30, t: 30, t0: 30 });\n  t.intent({}, 2); check('smoke blocks sight', g.mind.state === 'calm', g.mind.state);\n  M = loadYard(t, { guards: [Object.assign({}, g1, { at: [16, 11], facing: 90 })] }); h = M.hero; g = M.guards[0]; g.mode = 'stand';\n  game.debug.teleport(C(16), C(15), 0, -Math.PI / 2); h.crouch = true; t.intent({}, 3); check('crouched in tall grass, unseen', g.mind.state === 'calm', g.mind.state + ' exp ' + B.Perception.exposure(h, M).toFixed(2));\n  const e0 = B.Perception.exposure(h, M); h.crouch = false; game.debug.teleport(C(20), C(10), 0); const dark = B.Perception.exposure(h, M); M.world.flash = .2; const lit = B.Perception.exposure(h, M); M.world.flash = 0;\n  check('lightning exposes', lit > dark * 1.5, dark + ' -> ' + lit); void e0;\n  // a body in the light: found, the level heightened\n  M = loadYard(t, { guards: [g1, { id: 'b', type: 'ashigaru', at: [6, 6], mode: 'post' }] }); g = M.guards[0]; g.mode = 'stand'; M.world.light.fill(1); M.guards[1].alive = false;\n  game.debug.teleport(C(26), C(20), 0); t.intent({}, 1.5); check('a body is found: heightened', M.heightened > 0 && M.guards[1].found, M.heightened);\n}\nEOF\ncat > ki.test.mjs <<'EOF'\n// ki: the number at a known distance; Shadow Sight: visible, sensed behind a wall, hidden beyond; Ki Focus reaches further\nimport { loadYard, C } from './lib.mjs';\nexport default async function (t) {\n  const { B, check, game } = t; t.step(.3);\n  const M = loadYard(t, { guards: [{ id: 'g', type: 'ashigaru', at: [12, 11], facing: 90, mode: 'post' }] }), h = M.hero, g = M.guards[0];\n  g.mode = 'stand';\n  game.debug.teleport(C(12) - 80, C(11), 0); t.step(.2);\n  check('the Ki number at 80 is 50', Math.abs(B.Perception.ki - 50) <= 2, B.Perception.ki);\n  check('in plain view the guard is visible', g.vis === 'visible', g.vis);\n  game.debug.teleport(C(9), C(2), 0); g.x = C(9); g.y = C(9); t.step(.2);\n  check('behind the townhouse it is sensed', g.vis === 'sensed', g.vis);\n  game.debug.teleport(C(2), C(21), 0); g.x = C(27); g.y = C(2); t.step(.2);\n  check('beyond the Ki range, and out of sight, it is hidden', g.vis === 'hidden' || g.vis === 'visible', g.vis);\n  game.debug.teleport(C(9), C(2), 0); g.x = C(9); g.y = C(2) + 190; t.step(.2); const before = g.vis;\n  t.intent({ focusDown: true }, .3); const after = g.vis;\n  check('Ki Focus senses further', (before === 'hidden' && after !== 'hidden') || before === 'visible', before + ' -> ' + after);\n}\nEOF\ncd .. && node tests/run.mjs --fast move grapple perception ki 2>&1 | tail -25","description":"Write and run move, grapple, perception and ki suites","timeout":300000}}}
