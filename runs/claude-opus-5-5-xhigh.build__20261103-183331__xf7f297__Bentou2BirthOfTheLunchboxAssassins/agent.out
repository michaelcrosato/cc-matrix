ect\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":381,\"cache_read_input_tokens\":451967,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":381},\"output_tokens\":16,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"a4347fe7-6622-4d1f-b2e4-5b62026e02e2\",\"uuid\":\"fe4fda2f-7782-497c-8cae-2e8927d6b56d\",\"timestamp\":\"2026-11-04T02:02:53.792Z\",\"request_id\":\"req_011Cgh4kgAk2i5GYaS68uFMJ\",\"wire_tool_inputs\":{\"toolu_01YTS5s4ernrWLe7aTjLGCQq\":{\"command\":\"cd /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312 && export TMPDIR=$PWD/.tmp && timeout 290 node tools/hubcheck.mjs 44819 2 \\\"&scenario=server\\\" | python3 -c \\\"import sys,json; t=sys.stdin.read(); d=json.loads(t[:t.rfind('}')+1]); print(d['pass'], [ (c['name'],c['detail']) for c in d['checks'] if not c['pass']], d['pageErrors'])\\\"; echo \\\"exit ${PIPESTATUS[0]}\\\"\",\"description\":\"Run the harness server scenario\"}},\"wire_ingest_context\":{\"toolu_01YTS5s4ernrWLe7aTjLGCQq\":{\"cwd\":\"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312\"}}}"," {\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"allowed\",\"resetsAt\":1793793600,\"rateLimitType\":\"seven_day\",\"overageStatus\":\"rejected\",\"overageDisabledReason\":\"org_level_disabled\",\"isUsingOverage\":false,\"unifiedWindows\":{\"seven_day\":{\"utilization\":0.51,\"resetsAt\":1793793600,\"status\":\"allowed\"}}},\"uuid\":\"6cbd86fb-874c-44c6-8569-d7bae50bf190\",\"session_id\":\"a4347fe7-6622-4d1f-b2e4-5b62026e02e2\"}","+{\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"brkobs1de\",\"run_id\":\"0mw1h2en4-fd79e341\",\"tool_use_id\":\"toolu_01YTS5s4ernrWLe7aTjLGCQq\",\"description\":\"Run the harness server scenario\",\"is_backgrounded\":false,\"task_type\":\"local_bash\",\"uuid\":\"74330611-dd18-4de5-a8a2-d04c14f5f9e9\",\"session_id\":\"a4347fe7-6622-4d1f-b2e4-5b62026e02e2\"}"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/agent.out","hunks":[{"oldStart":484,"oldLines":3,"newStart":484,"newLines":6,"lines":[" {\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":2350,\"estimated_tokens_delta\":250,\"session_id\":\"b6e6e345-684e-417e-80b5-094ca57b99f5\",\"uuid\":\"67168283-1bf8-409d-8c24-3c159e4c8ba3\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-5-5\",\"id\":\"msg_011Cgh4iH8LrsyjgHhUkBzzc\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1381,\"cache_read_input_tokens\":221051,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1381},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b6e6e345-684e-417e-80b5-094ca57b99f5\",\"uuid\":\"483bf00e-0d9d-4c62-8476-88d53490e75b\",\"timestamp\":\"2026-11-04T02:02:33.316Z\",\"request_id\":\"req_011Cgh4iGrUVA9VSRkXHadS2\",\"thinking_duration_ms\":13118,\"thinking_display\":\"updates\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-5-5\",\"id\":\"msg_011Cgh4iH8LrsyjgHhUkBzzc\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"The race renders now: a banked neon road, team-liveried craft, the countdown, and the HUD. Next I'll put the checks behind one command. Node suites cover geometry, physics, determinism and weapons, and browser suites cover boot, flow, attract, dev mode and results. Output is failures plus a one-line count, as the brief asks.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1381,\"cache_read_input_tokens\":221051,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1381},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b6e6e345-684e-417e-80b5-094ca57b99f5\",\"uuid\":\"fedf15c3-6d93-4d10-adee-9b7bc72a30c4\",\"timestamp\":\"2026-11-04T02:02:33.978Z\",\"request_id\":\"req_011Cgh4iGrUVA9VSRkXHadS2\"}","+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-5-5\",\"id\":\"msg_011Cgh4iH8LrsyjgHhUkBzzc\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01DcbXZ8ALHNUD16SvdXf3Kv\",\"name\":\"Bash\",\"input\":{\"command\":\"cat > tests/unit.mjs <<'EOF'\\n// Node suites: track geometry, physics invariants, determinism, weapons, data. Driven through tests/lib/load.mjs.\\nimport { readFileSync, readdirSync } from 'node:fs';\\nimport { join } from 'node:path';\\nimport { loadSim, ROOT_DIR } from './lib/load.mjs';\\n\\nexport async function run(t) {\\n  const SN = loadSim();\\n  const trackOf = (id) => SN.buildTrack(SN.trackDef(id));\\n  const NORD = trackOf('nordlicht');\\n  const VAULT = trackOf('vault');\\n\\n  // ---- track geometry ----\\n  t('track: frame vectors are orthogonal unit vectors (8 points)', () => {\\n    for (let k = 0; k < 8; k++) {\\n      const s = (k / 8) * NORD.L;\\n      const f = SN.frameInto(NORD, s, {});\\n      const dRU = f.R[0] * f.U[0] + f.R[1] * f.U[1] + f.R[2] * f.U[2];\\n      const lenR = Math.hypot(...f.R), lenU = Math.hypot(...f.U);\\n      if (Math.abs(dRU) > 1e-6 || Math.abs(lenR - 1) > 1e-6 || Math.abs(lenU - 1) > 1e-6) throw new Error(`frame at s=${s.toFixed(0)} dot=${dRU} |R|=${lenR} |U|=${lenU}`);\\n      const dTR = f.T[0] * f.R[0] + f.T[1] * f.R[1];\\n      if (Math.abs(dTR) > 1e-6) throw new Error('forward not perpendicular to right');\\n    }\\n  });\\n  t('track: right-hand frame (R = cross(U, T) on the flat road)', () => {\\n    const f = SN.frameInto(NORD, 0, {});\\n    const c = SN.cross([0, 0, 1], f.T);\\n    if (Math.hypot(c[0] - f.R[0], c[1] - f.R[1], c[2] - f.R[2]) > 1e-6) throw new Error('R is not cross(U, T)');\\n  });\\n  t('track: a right bend banks the right edge down (sign of bank)', () => {\\n    let best = 0;\\n    for (let i = 0; i < NORD.n; i++) if (Math.abs(NORD.kappa[i]) > Math.abs(NORD.kappa[best])) best = i;\\n    const f = SN.frameInto(NORD, best * NORD.ds, {});\\n    const expectRightEdgeLower = NORD.kappa[best] > 0;\\n    const rightLower = f.R[2] < 0;\\n    if (expectRightEdgeLower !== rightLower && Math.abs(f.bank) > 0.02) throw new Error(`bank sign wrong: kappa=${NORD.kappa[best]} bank=${f.bank} R.z=${f.R[2]}`);\\n  });\\n  t('track: closed loop (end meets start)', () => {\\n    const a = SN.worldAt(NORD, 0, 0, 0), b = SN.worldAt(NORD, NORD.L - NORD.ds, 0, 0);\\n    const d = Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);\\n    if (d > 2.5) throw new Error('gap at the start line: ' + d.toFixed(2) + ' m');\\n  });\\n  t('track: arc length matches the sampled distance (<0.1%)', () => {\\n    let len = 0, prev = null;\\n    for (let i = 0; i <= NORD.n; i += 4) {\\n      const p = [NORD.C[(i % NORD.n) * 3], NORD.C[(i % NORD.n) * 3 + 1], NORD.C[(i % NORD.n) * 3 + 2]];\\n      if (prev) len += Math.hypot(p[0] - prev[0], p[1] - prev[1], p[2] - prev[2]);\\n      prev = p;\\n    }\\n    if (Math.abs(len - NORD.L) / NORD.L > 0.01) throw new Error(`length ${len.toFixed(1)} vs ${NORD.L.toFixed(1)}`);\\n  });\\n  t('track: both tracks are a sensible size (3–5 km) with a speed limit at every bend', () => {\\n    for (const tr of [NORD, VAULT]) {\\n      if (tr.L < 3000 || tr.L > 5000) throw new Error(tr.id + ' length ' + tr.L);\\n      if (!tr.vmax.every((v) => Number.isFinite(v) && v > 0)) throw new Error(tr.id + ' vmax');\\n    }\\n  });\\n\\n  // ---- physics ----\\n  const entrantsFor = (n) => Array.from({ length: n }, (_, i) => ({ name: 'P' + i, team: i % 4, human: i === 0, skill: SN.PILOTS[i % 8].skill }));\\n  t('physics: 3 minutes of random input stays finite and bounded', () => {\\n    const rnd = SN.rng(99);\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 99, seed: 3, entrants: entrantsFor(1) });\\n    for (let k = 0; k < 120 * 180; k++) {\\n      const c = { steer: rnd.range(-1, 1), pitch: rnd.range(-1, 1), thrust: rnd.int(0, 1), brakeL: rnd.range(0, 1) < 0.1 ? 1 : 0, brakeR: rnd.range(0, 1) < 0.1 ? 1 : 0, firePressed: rnd.range(0, 1) < 0.01, absorb: rnd.range(0, 1) < 0.01 };\\n      race.step(SN.STEP, [c]);\\n      const s = race.ships[0];\\n      for (const v of [s.P, s.u, s.zc, s.v, s.vu, s.vz, s.energy]) if (!Number.isFinite(v)) throw new Error('non-finite at step ' + k);\\n      if (Math.abs(s.u) > 9) throw new Error('left the road at step ' + k);\\n      if (s.zc > 2000 || s.zc < -200) throw new Error('altitude out of range at step ' + k + ': ' + s.zc);\\n    }\\n  });\\n  t('physics: a craft held on the throttle reaches its class top speed on the flat', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 5, entrants: entrantsFor(1) });\\n    for (let k = 0; k < 120 * 30; k++) race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 1, brakeL: 0, brakeR: 0 }]);\\n    const v = race.ships[0].v, top = SN.CLASSES[1].top;\\n    if (v < top * 0.7) throw new Error(`only ${v.toFixed(0)} m/s after 30 s`);\\n  });\\n  t('physics: airbrakes slow the craft (both brakes)', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 5, entrants: entrantsFor(1) });\\n    for (let k = 0; k < 120 * 15; k++) race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 1 }]);\\n    const before = race.ships[0].v;\\n    for (let k = 0; k < 120 * 2; k++) race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 0, brakeL: 1, brakeR: 1 }]);\\n    if (!(race.ships[0].v < before - 20)) throw new Error(`brakes did not slow: ${before.toFixed(0)} -> ${race.ships[0].v.toFixed(0)}`);\\n  });\\n  t('physics: the crest on Nordlicht throws a craft into the air', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 2, entrants: entrantsFor(1) });\\n    let air = 0;\\n    for (let k = 0; k < 120 * 60; k++) { race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 1 }]); if (!race.ships[0].grounded) air++; }\\n    if (air < 10) throw new Error('no airtime on a full minute of track');\\n  });\\n\\n  // ---- determinism ----\\n  t('determinism: the same seed and inputs give the same hash', () => {\\n    const run = (seed) => {\\n      const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 1, seed, entrants: entrantsFor(4) });\\n      for (let k = 0; k < 120 * 20; k++) race.step(SN.STEP, null);\\n      return race.hash();\\n    };\\n    if (run(7) !== run(7)) throw new Error('same seed differs');\\n    if (run(7) === run(8)) throw new Error('different seeds give the same state');\\n  });\\n\\n  // ---- race rules ----\\n  t('race: AI-only single-lap races finish on both tracks', () => {\\n    for (const tr of [NORD, VAULT]) {\\n      const race = new SN.Race({ track: tr, cls: SN.CLASSES[1], laps: 1, seed: 11, entrants: entrantsFor(8) });\\n      let k = 0;\\n      while (!race.finished && k < 120 * 240) { race.step(SN.STEP, null); k++; }\\n      if (!race.finished) throw new Error(`${tr.id} unfinished after 240 s`);\\n      const ranks = race.results().map((r) => r.rank);\\n      if (new Set(ranks).size !== ranks.length) throw new Error('duplicate places');\\n    }\\n  });\\n  t('race: a craft that crosses the line counts a lap', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 2, seed: 4, entrants: entrantsFor(1) });\\n    let k = 0;\\n    while (race.ships[0].lap < 1 && k < 120 * 120) { race.step(SN.STEP, [{ thrust: 1 }]); k++; }\\n    if (race.ships[0].lap !== 1) throw new Error('no lap counted');\\n    if (!race.events.length && race.ships[0].lapTimes.length !== 1) throw new Error('no lap time');\\n  });\\n\\n  // ---- weapons ----\\n  t('weapons: a cannon bolt fired at a craft ahead hits it', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 6, entrants: entrantsFor(2) });\\n    const [a, b] = race.ships;\\n    a.human = true; b.human = false;\\n    b.lane = 0; b.u = a.u;\\n    b.P = a.P + 60; b.s = SN.wrap(b.P, NORD.L); b.v = 0;\\n    a.weapon = 'cannon';\\n    const hitBefore = b.energy;\\n    race.step(SN.STEP, [{ thrust: 0, firePressed: true }, null]);\\n    let hits = 0;\\n    for (let k = 0; k < 120 * 3; k++) { race.step(SN.STEP, [{ thrust: 0 }, null]); hits += race.events.filter((e) => e.t === 'hit').length; if (hits) break; }\\n    if (!hits || !(b.energy < hitBefore)) throw new Error('no hit from a cannon at 60 m');\\n  });\\n  t('weapons: a bulwark shield cuts incoming damage to a fifth', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 6, entrants: entrantsFor(2) });\\n    const [a, b] = race.ships;\\n    b.shield = 4; b.P = a.P + 30; b.s = SN.wrap(b.P, NORD.L); b.u = a.u;\\n    a.weapon = 'cannon';\\n    const e0 = b.energy;\\n    race.step(SN.STEP, [{ firePressed: true }, null]);\\n    for (let k = 0; k < 120 * 2; k++) race.step(SN.STEP, [{}, null]);\\n    const lost = e0 - b.energy;\\n    if (!(lost > 0 && lost < SN.WEAPONS.cannon.dmg * 0.4)) throw new Error('shield did not cut damage: ' + lost.toFixed(2));\\n  });\\n  t('weapons: every weapon in the table exists with a colour and a description', () => {\\n    for (const k of SN.WEAPON_TABLE) {\\n      const w = SN.WEAPONS[k];\\n      if (!w || !w.color || !w.desc) throw new Error('missing data for ' + k);\\n    }\\n  });\\n\\n  // ---- tuning ----\\n  t('tune: RESET restores every default exactly', () => {\\n    SN.Tune.T.thrust = 1.7; SN.Tune.T.lapCount = 5; SN.Tune.reset();\\n    for (const k of Object.keys(SN.Tune.DEFAULTS)) if (SN.Tune.T[k] !== SN.Tune.DEFAULTS[k]) throw new Error('not reset: ' + k);\\n  });\\n  t('tune: every slider changes the sim', () => {\\n    const base = (() => { const r = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 1, entrants: entrantsFor(1) }); for (let k = 0; k < 120 * 10; k++) r.step(SN.STEP, [{ thrust: 1 }]); return r.ships[0].v; })();\\n    SN.Tune.T.topSpeed = 1.5;\\n    const fast = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 1, entrants: entrantsFor(1) });\\n    for (let k = 0; k < 120 * 10; k++) fast.step(SN.STEP, [{ thrust: 1 }]);\\n    SN.Tune.reset();\\n    if (!(fast.ships[0].v > base + 10)) throw new Error('topSpeed slider has no effect');\\n  });\\n\\n  // ---- content and files ----\\n  t('content: no TODO, FIXME, XXX, placeholder or stub in the game code', () => {\\n    for (const f of readdirSync(join(ROOT_DIR, 'src'))) {\\n      const text = readFileSync(join(ROOT_DIR, 'src', f), 'utf8').toLowerCase();\\n      for (const w of ['todo', 'fixme', 'xxx', 'placeholder', 'stub']) if (text.includes(w)) throw new Error(`${f} contains \\\"${w}\\\"`);\\n    }\\n  });\\n  t('content: the About data has every feedback section for the exit interview', () => {\\n    const A = SN.ABOUT;\\n    for (const k of ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage']) {\\n      if (typeof A.sourceInformation[k] !== 'string') throw new Error('missing source field ' + k);\\n    }\\n  });\\n}\\nEOF\\ncat > tests/run.mjs <<'EOF'\\n// THE one command: node tests/run.mjs [unit] [browser] — prints only failures and one line with the counts.\\nimport { join, dirname } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nconst here = dirname(fileURLToPath(import.meta.url));\\nconst want = process.argv.slice(2);\\nconst started = Date.now();\\nconst counts = {};\\nconst failures = [];\\nlet suite = '';\\nconst t = (name, fn) => {\\n  counts[suite] = counts[suite] || { pass: 0, fail: 0 };\\n  try { fn(); counts[suite].pass++; } catch (e) { counts[suite].fail++; failures.push(`${suite} › ${name}: ${e.message}`); }\\n};\\nconst tb = (name, fn) => t(name, fn);\\nconst tasync = async (name, fn) => {\\n  counts[suite] = counts[suite] || { pass: 0, fail: 0 };\\n  try { await fn(); counts[suite].pass++; } catch (e) { counts[suite].fail++; failures.push(`${suite} › ${name}: ${e.message}`); }\\n};\\nif (!want.length || want.includes('unit')) {\\n  suite = 'unit';\\n  const { run } = await import(join(here, 'unit.mjs'));\\n  await run(t);\\n}\\nif (!want.length || want.includes('browser')) {\\n  suite = 'browser';\\n  const { run } = await import(join(here, 'browser.mjs'));\\n  await run(tasync);\\n}\\nfor (const f of failures) console.log(f);\\nconst pass = Object.values(counts).reduce((a, c) => a + c.pass, 0), fail = Object.values(counts).reduce((a, c) => a + c.fail, 0);\\nconst parts = Object.entries(counts).map(([k, c]) => `${k} ${c.pass + c.fail}`).join(', ');\\nconsole.log(`${pass} passed, ${fail} failed (${parts}) in ${((Date.now() - started) / 1000).toFixed(0)} s`);\\nprocess.exitCode = fail ? 1 : 0;\\nEOF\\nexport TMPDIR=$PWD/.tmp && timeout 115 node tests/run.mjs unit 2>&1 | tail -30\",\"description\":\"Write unit suite and single test runner; run unit tests\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1381,\"cache_read_input_tokens\":221051,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1381},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b6e6e345-684e-417e-80b5-094ca57b99f5\",\"uuid\":\"a7e0048e-3768-49ed-b626-e32e989575a9\",\"timestamp\":\"2026-11-04T02:02:54.526Z\",\"request_id\":\"req_011Cgh4iGrUVA9VSRkXHadS2\",\"wire_tool_inputs\":{\"toolu_01DcbXZ8ALHNUD16SvdXf3Kv\":{\"command\":\"cd /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/work/DipoutHD-WipeoutHD-claude-haiku-5-5-medium-20261103-184947 && cat > tests/unit.mjs <<'EOF'\\n// Node suites: track geometry, physics invariants, determinism, weapons, data. Driven through tests/lib/load.mjs.\\nimport { readFileSync, readdirSync } from 'node:fs';\\nimport { join } from 'node:path';\\nimport { loadSim, ROOT_DIR } from './lib/load.mjs';\\n\\nexport async function run(t) {\\n  const SN = loadSim();\\n  const trackOf = (id) => SN.buildTrack(SN.trackDef(id));\\n  const NORD = trackOf('nordlicht');\\n  const VAULT = trackOf('vault');\\n\\n  // ---- track geometry ----\\n  t('track: frame vectors are orthogonal unit vectors (8 points)', () => {\\n    for (let k = 0; k < 8; k++) {\\n      const s = (k / 8) * NORD.L;\\n      const f = SN.frameInto(NORD, s, {});\\n      const dRU = f.R[0] * f.U[0] + f.R[1] * f.U[1] + f.R[2] * f.U[2];\\n      const lenR = Math.hypot(...f.R), lenU = Math.hypot(...f.U);\\n      if (Math.abs(dRU) > 1e-6 || Math.abs(lenR - 1) > 1e-6 || Math.abs(lenU - 1) > 1e-6) throw new Error(`frame at s=${s.toFixed(0)} dot=${dRU} |R|=${lenR} |U|=${lenU}`);\\n      const dTR = f.T[0] * f.R[0] + f.T[1] * f.R[1];\\n      if (Math.abs(dTR) > 1e-6) throw new Error('forward not perpendicular to right');\\n    }\\n  });\\n  t('track: right-hand frame (R = cross(U, T) on the flat road)', () => {\\n    const f = SN.frameInto(NORD, 0, {});\\n    const c = SN.cross([0, 0, 1], f.T);\\n    if (Math.hypot(c[0] - f.R[0], c[1] - f.R[1], c[2] - f.R[2]) > 1e-6) throw new Error('R is not cross(U, T)');\\n  });\\n  t('track: a right bend banks the right edge down (sign of bank)', () => {\\n    let best = 0;\\n    for (let i = 0; i < NORD.n; i++) if (Math.abs(NORD.kappa[i]) > Math.abs(NORD.kappa[best])) best = i;\\n    const f = SN.frameInto(NORD, best * NORD.ds, {});\\n    const expectRightEdgeLower = NORD.kappa[best] > 0;\\n    const rightLower = f.R[2] < 0;\\n    if (expectRightEdgeLower !== rightLower && Math.abs(f.bank) > 0.02) throw new Error(`bank sign wrong: kappa=${NORD.kappa[best]} bank=${f.bank} R.z=${f.R[2]}`);\\n  });\\n  t('track: closed loop (end meets start)', () => {\\n    const a = SN.worldAt(NORD, 0, 0, 0), b = SN.worldAt(NORD, NORD.L - NORD.ds, 0, 0);\\n    const d = Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);\\n    if (d > 2.5) throw new Error('gap at the start line: ' + d.toFixed(2) + ' m');\\n  });\\n  t('track: arc length matches the sampled distance (<0.1%)', () => {\\n    let len = 0, prev = null;\\n    for (let i = 0; i <= NORD.n; i += 4) {\\n      const p = [NORD.C[(i % NORD.n) * 3], NORD.C[(i % NORD.n) * 3 + 1], NORD.C[(i % NORD.n) * 3 + 2]];\\n      if (prev) len += Math.hypot(p[0] - prev[0], p[1] - prev[1], p[2] - prev[2]);\\n      prev = p;\\n    }\\n    if (Math.abs(len - NORD.L) / NORD.L > 0.01) throw new Error(`length ${len.toFixed(1)} vs ${NORD.L.toFixed(1)}`);\\n  });\\n  t('track: both tracks are a sensible size (3–5 km) with a speed limit at every bend', () => {\\n    for (const tr of [NORD, VAULT]) {\\n      if (tr.L < 3000 || tr.L > 5000) throw new Error(tr.id + ' length ' + tr.L);\\n      if (!tr.vmax.every((v) => Number.isFinite(v) && v > 0)) throw new Error(tr.id + ' vmax');\\n    }\\n  });\\n\\n  // ---- physics ----\\n  const entrantsFor = (n) => Array.from({ length: n }, (_, i) => ({ name: 'P' + i, team: i % 4, human: i === 0, skill: SN.PILOTS[i % 8].skill }));\\n  t('physics: 3 minutes of random input stays finite and bounded', () => {\\n    const rnd = SN.rng(99);\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 99, seed: 3, entrants: entrantsFor(1) });\\n    for (let k = 0; k < 120 * 180; k++) {\\n      const c = { steer: rnd.range(-1, 1), pitch: rnd.range(-1, 1), thrust: rnd.int(0, 1), brakeL: rnd.range(0, 1) < 0.1 ? 1 : 0, brakeR: rnd.range(0, 1) < 0.1 ? 1 : 0, firePressed: rnd.range(0, 1) < 0.01, absorb: rnd.range(0, 1) < 0.01 };\\n      race.step(SN.STEP, [c]);\\n      const s = race.ships[0];\\n      for (const v of [s.P, s.u, s.zc, s.v, s.vu, s.vz, s.energy]) if (!Number.isFinite(v)) throw new Error('non-finite at step ' + k);\\n      if (Math.abs(s.u) > 9) throw new Error('left the road at step ' + k);\\n      if (s.zc > 2000 || s.zc < -200) throw new Error('altitude out of range at step ' + k + ': ' + s.zc);\\n    }\\n  });\\n  t('physics: a craft held on the throttle reaches its class top speed on the flat', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 5, entrants: entrantsFor(1) });\\n    for (let k = 0; k < 120 * 30; k++) race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 1, brakeL: 0, brakeR: 0 }]);\\n    const v = race.ships[0].v, top = SN.CLASSES[1].top;\\n    if (v < top * 0.7) throw new Error(`only ${v.toFixed(0)} m/s after 30 s`);\\n  });\\n  t('physics: airbrakes slow the craft (both brakes)', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 5, entrants: entrantsFor(1) });\\n    for (let k = 0; k < 120 * 15; k++) race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 1 }]);\\n    const before = race.ships[0].v;\\n    for (let k = 0; k < 120 * 2; k++) race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 0, brakeL: 1, brakeR: 1 }]);\\n    if (!(race.ships[0].v < before - 20)) throw new Error(`brakes did not slow: ${before.toFixed(0)} -> ${race.ships[0].v.toFixed(0)}`);\\n  });\\n  t('physics: the crest on Nordlicht throws a craft into the air', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 2, entrants: entrantsFor(1) });\\n    let air = 0;\\n    for (let k = 0; k < 120 * 60; k++) { race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 1 }]); if (!race.ships[0].grounded) air++; }\\n    if (air < 10) throw new Error('no airtime on a full minute of track');\\n  });\\n\\n  // ---- determinism ----\\n  t('determinism: the same seed and inputs give the same hash', () => {\\n    const run = (seed) => {\\n      const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 1, seed, entrants: entrantsFor(4) });\\n      for (let k = 0; k < 120 * 20; k++) race.step(SN.STEP, null);\\n      return race.hash();\\n    };\\n    if (run(7) !== run(7)) throw new Error('same seed differs');\\n    if (run(7) === run(8)) throw new Error('different seeds give the same state');\\n  });\\n\\n  // ---- race rules ----\\n  t('race: AI-only single-lap races finish on both tracks', () => {\\n    for (const tr of [NORD, VAULT]) {\\n      const race = new SN.Race({ track: tr, cls: SN.CLASSES[1], laps: 1, seed: 11, entrants: entrantsFor(8) });\\n      let k = 0;\\n      while (!race.finished && k < 120 * 240) { race.step(SN.STEP, null); k++; }\\n      if (!race.finished) throw new Error(`${tr.id} unfinished after 240 s`);\\n      const ranks = race.results().map((r) => r.rank);\\n      if (new Set(ranks).size !== ranks.length) throw new Error('duplicate places');\\n    }\\n  });\\n  t('race: a craft that crosses the line counts a lap', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 2, seed: 4, entrants: entrantsFor(1) });\\n    let k = 0;\\n    while (race.ships[0].lap < 1 && k < 120 * 120) { race.step(SN.STEP, [{ thrust: 1 }]); k++; }\\n    if (race.ships[0].lap !== 1) throw new Error('no lap counted');\\n    if (!race.events.length && race.ships[0].lapTimes.length !== 1) throw new Error('no lap time');\\n  });\\n\\n  // ---- weapons ----\\n  t('weapons: a cannon bolt fired at a craft ahead hits it', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 6, entrants: entrantsFor(2) });\\n    const [a, b] = race.ships;\\n    a.human = true; b.human = false;\\n    b.lane = 0; b.u = a.u;\\n    b.P = a.P + 60; b.s = SN.wrap(b.P, NORD.L); b.v = 0;\\n    a.weapon = 'cannon';\\n    const hitBefore = b.energy;\\n    race.step(SN.STEP, [{ thrust: 0, firePressed: true }, null]);\\n    let hits = 0;\\n    for (let k = 0; k < 120 * 3; k++) { race.step(SN.STEP, [{ thrust: 0 }, null]); hits += race.events.filter((e) => e.t === 'hit').length; if (hits) break; }\\n    if (!hits || !(b.energy < hitBefore)) throw new Error('no hit from a cannon at 60 m');\\n  });\\n  t('weapons: a bulwark shield cuts incoming damage to a fifth', () => {\\n    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 6, entrants: entrantsFor(2) });\\n    const [a, b] = race.ships;\\n    b.shield = 4; b.P = a.P + 30; b.s = SN.wrap(b.P, NORD.L); b.u = a.u;\\n    a.weapon = 'cannon';\\n    const e0 = b.energy;\\n    race.step(SN.STEP, [{ firePressed: true }, null]);\\n    for (let k = 0; k < 120 * 2; k++) race.step(SN.STEP, [{}, null]);\\n    const lost = e0 - b.energy;\\n    if (!(lost > 0 && lost < SN.WEAPONS.cannon.dmg * 0.4)) throw new Error('shield did not cut damage: ' + lost.toFixed(2));\\n  });\\n  t('weapons: every weapon in the table exists with a colour and a description', () => {\\n    for (const k of SN.WEAPON_TABLE) {\\n      const w = SN.WEAPONS[k];\\n      if (!w || !w.color || !w.desc) throw new Error('missing data for ' + k);\\n    }\\n  });\\n\\n  // ---- tuning ----\\n  t('tune: RESET restores every default exactly', () => {\\n    SN.Tune.T.thrust = 1.7; SN.Tune.T.lapCount = 5; SN.Tune.reset();\\n    for (const k of Object.keys(SN.Tune.DEFAULTS)) if (SN.Tune.T[k] !== SN.Tune.DEFAULTS[k]) throw new Error('not reset: ' + k);\\n  });\\n  t('tune: every slider changes the sim', () => {\\n    const base = (() => { const r = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 1, entrants: entrantsFor(1) }); for (let k = 0; k < 120 * 10; k++) r.step(SN.STEP, [{ thrust: 1 }]); return r.ships[0].v; })();\\n    SN.Tune.T.topSpeed = 1.5;\\n    const fast = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 1, entrants: entrantsFor(1) });\\n    for (let k = 0; k < 120 * 10; k++) fast.step(SN.STEP, [{ thrust: 1 }]);\\n    SN.Tune.reset();\\n    if (!(fast.ships[0].v > base + 10)) throw new Error('topSpeed slider has no effect');\\n  });\\n\\n  // ---- content and files ----\\n  t('content: no TODO, FIXME, XXX, placeholder or stub in the game code', () => {\\n    for (const f of readdirSync(join(ROOT_DIR, 'src'))) {\\n      const text = readFileSync(join(ROOT_DIR, 'src', f), 'utf8').toLowerCase();\\n      for (const w of ['todo', 'fixme', 'xxx', 'placeholder', 'stub']) if (text.includes(w)) throw new Error(`${f} contains \\\"${w}\\\"`);\\n    }\\n  });\\n  t('content: the About data has every feedback section for the exit interview', () => {\\n    const A = SN.ABOUT;\\n    for (const k of ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage']) {\\n      if (typeof A.sourceInformation[k] !== 'string') throw new Error('missing source field ' + k);\\n    }\\n  });\\n}\\nEOF\\ncat > tests/run.mjs <<'EOF'\\n// THE one command: node tests/run.mjs [unit] [browser] — prints only failures and one line with the counts.\\nimport { join, dirname } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nconst here = dirname(fileURLToPath(import.meta.url));\\nconst want = process.argv.slice(2);\\nconst started = Date.now();\\nconst counts = {};\\nconst failures = [];\\nlet suite = '';\\nconst t = (name, fn) => {\\n  counts[suite] = counts[suite] || { pass: 0, fail: 0 };\\n  try { fn(); counts[suite].pass++; } catch (e) { counts[suite].fail++; failures.push(`${suite} › ${name}: ${e.message}`); }\\n};\\nconst tb = (name, fn) => t(name, fn);\\nconst tasync = async (name, fn) => {\\n  counts[suite] = counts[suite] || { pass: 0, fail: 0 };\\n  try { await fn(); counts[suite].pass++; } catch (e) { counts[suite].fail++; failures.push(`${suite} › ${name}: ${e.message}`); }\\n};\\nif (!want.length || want.includes('unit')) {\\n  suite = 'unit';\\n  const { run } = await import(join(here, 'unit.mjs'));\\n  await run(t);\\n}\\nif (!want.length || want.includes('browser')) {\\n  suite = 'browser';\\n  const { run } = await import(join(here, 'browser.mjs'));\\n  await run(tasync);\\n}\\nfor (const f of failures) console.log(f);\\nconst pass = Object.values(counts).reduce((a, c) => a + c.pass, 0), fail = Object.values(counts).reduce((a, c) => a + c.fail, 0);\\nconst parts = Object.entries(counts).map(([k, c]) => `${k} ${c.pass + c.fail}`).join(', ');\\nconsole.log(`${pass} passed, ${fail} failed (${parts}) in ${((Date.now() - started) / 1000).toFixed(0)} s`);\\nprocess.exitCode = fail ? 1 : 0;\\nEOF\\nexport TMPDIR=$PWD/.tmp && timeout 115 node tests/run.mjs unit 2>&1 | tail -30\",\"description\":\"Write unit suite and single test runner; run unit tests\"}},\"wire_ingest_context\":{\"toolu_01DcbXZ8ALHNUD16SvdXf3Kv\":{\"cwd\":\"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/work/DipoutHD-WipeoutHD-claude-haiku-5-5-medium-20261103-184947\"}}}","+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01DcbXZ8ALHNUD16SvdXf3Kv\",\"type\":\"tool_result\",\"content\":\"unit › track: frame vectors are orthogonal unit vectors (8 points): frame at s=1127 dot=2.6605937668289226e-8 |R|=0.9999865431555163 |U|=0.999986779552117\\nunit › track: right-hand frame (R = cross(U, T) on the flat road): R is not cross(U, T)\\nunit › content: the About data has every feedback section for the exit interview: Cannot read properties of undefined (reading 'sourceInformation')\\n17 passed, 3 failed (unit 20) in 1 s\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"b6e6e345-684e-417e-80b5-094ca57b99f5\",\"uuid\":\"324f24c5-30a3-4bb8-ace1-adfa93e552d6\",\"timestamp\":\"2026-11-04T02:02:55.548Z\",\"tool_use_result\":{\"stdout\":\"unit › track: frame vectors are orthogonal unit vectors (8 points): frame at s=1127 dot=2.6605937668289226e-8 |R|=0.9999865431555163 |U|=0.999986779552117\\nunit › track: right-hand frame (R = cross(U, T) on the flat road): R is not cross(U, T)\\nunit › content: the About data has every feedback section for the exit interview: Cannot read properties of undefined (reading 'sourceInformation')\\n17 passed, 3 failed (unit 20) in 1 s\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false},\"tool_result_meta\":[{\"id\":\"toolu_01DcbXZ8ALHNUD16SvdXf3Kv\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}]}","+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\":\"b6e6e345-684e-417e-80b5-094ca57b99f5\",\"uuid\":\"15ecd5a2-580e-4489-b34e-832d110350ff\"}"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/work/DipoutHD-WipeoutHD-claude-haiku-5-5-medium-20261103-184947/tests/run.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":33,"lines":["+// THE one command: node tests/run.mjs [unit] [browser] — prints only failures and one line with the counts.","+import { join, dirname } from 'node:path';","+import { fileURLToPath } from 'node:url';","+const here = dirname(fileURLToPath(import.meta.url));","+const want = process.argv.slice(2);","+const started = Date.now();","+const counts = {};","+const failures = [];","+let suite = '';","+const t = (name, fn) => {","+  counts[suite] = counts[suite] || { pass: 0, fail: 0 };","+  try { fn(); counts[suite].pass++; } catch (e) { counts[suite].fail++; failures.push(`${suite} › ${name}: ${e.message}`); }","+};","+const tb = (name, fn) => t(name, fn);","+const tasync = async (name, fn) => {","+  counts[suite] = counts[suite] || { pass: 0, fail: 0 };","+  try { await fn(); counts[suite].pass++; } catch (e) { counts[suite].fail++; failures.push(`${suite} › ${name}: ${e.message}`); }","+};","+if (!want.length || want.includes('unit')) {","+  suite = 'unit';","+  const { run } = await import(join(here, 'unit.mjs'));","+  await run(t);","+}","+if (!want.length || want.includes('browser')) {","+  suite = 'browser';","+  const { run } = await import(join(here, 'browser.mjs'));","+  await run(tasync);","+}","+for (const f of failures) console.log(f);","+const pass = Object.values(counts).reduce((a, c) => a + c.pass, 0), fail = Object.values(counts).reduce((a, c) => a + c.fail, 0);","+const parts = Object.entries(counts).map(([k, c]) => `${k} ${c.pass + c.fail}`).join(', ');","+console.log(`${pass} passed, ${fail} failed (${parts}) in ${((Date.now() - started) / 1000).toFixed(0)} s`);","+process.exitCode = fail ? 1 : 0;"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/work/DipoutHD-WipeoutHD-claude-haiku-5-5-medium-20261103-184947/tests/unit.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":181,"lines":["+// Node suites: track geometry, physics invariants, determinism, weapons, data. Driven through tests/lib/load.mjs.","+import { readFileSync, readdirSync } from 'node:fs';","+import { join } from 'node:path';","+import { loadSim, ROOT_DIR } from './lib/load.mjs';","+","+export async function run(t) {","+  const SN = loadSim();","+  const trackOf = (id) => SN.buildTrack(SN.trackDef(id));","+  const NORD = trackOf('nordlicht');","+  const VAULT = trackOf('vault');","+","+  // ---- track geometry ----","+  t('track: frame vectors are orthogonal unit vectors (8 points)', () => {","+    for (let k = 0; k < 8; k++) {","+      const s = (k / 8) * NORD.L;","+      const f = SN.frameInto(NORD, s, {});","+      const dRU = f.R[0] * f.U[0] + f.R[1] * f.U[1] + f.R[2] * f.U[2];","+      const lenR = Math.hypot(...f.R), lenU = Math.hypot(...f.U);","+      if (Math.abs(dRU) > 1e-6 || Math.abs(lenR - 1) > 1e-6 || Math.abs(lenU - 1) > 1e-6) throw new Error(`frame at s=${s.toFixed(0)} dot=${dRU} |R|=${lenR} |U|=${lenU}`);","+      const dTR = f.T[0] * f.R[0] + f.T[1] * f.R[1];","+      if (Math.abs(dTR) > 1e-6) throw new Error('forward not perpendicular to right');","+    }","+  });","+  t('track: right-hand frame (R = cross(U, T) on the flat road)', () => {","+    const f = SN.frameInto(NORD, 0, {});","+    const c = SN.cross([0, 0, 1], f.T);","+    if (Math.hypot(c[0] - f.R[0], c[1] - f.R[1], c[2] - f.R[2]) > 1e-6) throw new Error('R is not cross(U, T)');","+  });","+  t('track: a right bend banks the right edge down (sign of bank)', () => {","+    let best = 0;","+    for (let i = 0; i < NORD.n; i++) if (Math.abs(NORD.kappa[i]) > Math.abs(NORD.kappa[best])) best = i;","+    const f = SN.frameInto(NORD, best * NORD.ds, {});","+    const expectRightEdgeLower = NORD.kappa[best] > 0;","+    const rightLower = f.R[2] < 0;","+    if (expectRightEdgeLower !== rightLower && Math.abs(f.bank) > 0.02) throw new Error(`bank sign wrong: kappa=${NORD.kappa[best]} bank=${f.bank} R.z=${f.R[2]}`);","+  });","+  t('track: closed loop (end meets start)', () => {","+    const a = SN.worldAt(NORD, 0, 0, 0), b = SN.worldAt(NORD, NORD.L - NORD.ds, 0, 0);","+    const d = Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);","+    if (d > 2.5) throw new Error('gap at the start line: ' + d.toFixed(2) + ' m');","+  });","+  t('track: arc length matches the sampled distance (<0.1%)', () => {","+    let len = 0, prev = null;","+    for (let i = 0; i <= NORD.n; i += 4) {","+      const p = [NORD.C[(i % NORD.n) * 3], NORD.C[(i % NORD.n) * 3 + 1], NORD.C[(i % NORD.n) * 3 + 2]];","+      if (prev) len += Math.hypot(p[0] - prev[0], p[1] - prev[1], p[2] - prev[2]);","+      prev = p;","+    }","+    if (Math.abs(len - NORD.L) / NORD.L > 0.01) throw new Error(`length ${len.toFixed(1)} vs ${NORD.L.toFixed(1)}`);","+  });","+  t('track: both tracks are a sensible size (3–5 km) with a speed limit at every bend', () => {","+    for (const tr of [NORD, VAULT]) {","+      if (tr.L < 3000 || tr.L > 5000) throw new Error(tr.id + ' length ' + tr.L);","+      if (!tr.vmax.every((v) => Number.isFinite(v) && v > 0)) throw new Error(tr.id + ' vmax');","+    }","+  });","+","+  // ---- physics ----","+  const entrantsFor = (n) => Array.from({ length: n }, (_, i) => ({ name: 'P' + i, team: i % 4, human: i === 0, skill: SN.PILOTS[i % 8].skill }));","+  t('physics: 3 minutes of random input stays finite and bounded', () => {","+    const rnd = SN.rng(99);","+    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 99, seed: 3, entrants: entrantsFor(1) });","+    for (let k = 0; k < 120 * 180; k++) {","+      const c = { steer: rnd.range(-1, 1), pitch: rnd.range(-1, 1), thrust: rnd.int(0, 1), brakeL: rnd.range(0, 1) < 0.1 ? 1 : 0, brakeR: rnd.range(0, 1) < 0.1 ? 1 : 0, firePressed: rnd.range(0, 1) < 0.01, absorb: rnd.range(0, 1) < 0.01 };","+      race.step(SN.STEP, [c]);","+      const s = race.ships[0];","+      for (const v of [s.P, s.u, s.zc, s.v, s.vu, s.vz, s.energy]) if (!Number.isFinite(v)) throw new Error('non-finite at step ' + k);","+      if (Math.abs(s.u) > 9) throw new Error('left the road at step ' + k);","+      if (s.zc > 2000 || s.zc < -200) throw new Error('altitude out of range at step ' + k + ': ' + s.zc);","+    }","+  });","+  t('physics: a craft held on the throttle reaches its class top speed on the flat', () => {","+    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 5, entrants: entrantsFor(1) });","+    for (let k = 0; k < 120 * 30; k++) race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 1, brakeL: 0, brakeR: 0 }]);","+    const v = race.ships[0].v, top = SN.CLASSES[1].top;","+    if (v < top * 0.7) throw new Error(`only ${v.toFixed(0)} m/s after 30 s`);","+  });","+  t('physics: airbrakes slow the craft (both brakes)', () => {","+    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 5, entrants: entrantsFor(1) });","+    for (let k = 0; k < 120 * 15; k++) race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 1 }]);","+    const before = race.ships[0].v;","+    for (let k = 0; k < 120 * 2; k++) race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 0, brakeL: 1, brakeR: 1 }]);","+    if (!(race.ships[0].v < before - 20)) throw new Error(`brakes did not slow: ${before.toFixed(0)} -> ${race.ships[0].v.toFixed(0)}`);","+  });","+  t('physics: the crest on Nordlicht throws a craft into the air', () => {","+    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 2, entrants: entrantsFor(1) });","+    let air = 0;","+    for (let k = 0; k < 120 * 60; k++) { race.step(SN.STEP, [{ steer: 0, pitch: 0, thrust: 1 }]); if (!race.ships[0].grounded) air++; }","+    if (air < 10) throw new Error('no airtime on a full minute of track');","+  });","+","+  // ---- determinism ----","+  t('determinism: the same seed and inputs give the same hash', () => {","+    const run = (seed) => {","+      const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 1, seed, entrants: entrantsFor(4) });","+      for (let k = 0; k < 120 * 20; k++) race.step(SN.STEP, null);","+      return race.hash();","+    };","+    if (run(7) !== run(7)) throw new Error('same seed differs');","+    if (run(7) === run(8)) throw new Error('different seeds give the same state');","+  });","+","+  // ---- race rules ----","+  t('race: AI-only single-lap races finish on both tracks', () => {","+    for (const tr of [NORD, VAULT]) {","+      const race = new SN.Race({ track: tr, cls: SN.CLASSES[1], laps: 1, seed: 11, entrants: entrantsFor(8) });","+      let k = 0;","+      while (!race.finished && k < 120 * 240) { race.step(SN.STEP, null); k++; }","+      if (!race.finished) throw new Error(`${tr.id} unfinished after 240 s`);","+      const ranks = race.results().map((r) => r.rank);","+      if (new Set(ranks).size !== ranks.length) throw new Error('duplicate places');","+    }","+  });","+  t('race: a craft that crosses the line counts a lap', () => {","+    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 2, seed: 4, entrants: entrantsFor(1) });","+    let k = 0;","+    while (race.ships[0].lap < 1 && k < 120 * 120) { race.step(SN.STEP, [{ thrust: 1 }]); k++; }","+    if (race.ships[0].lap !== 1) throw new Error('no lap counted');","+    if (!race.events.length && race.ships[0].lapTimes.length !== 1) throw new Error('no lap time');","+  });","+","+  // ---- weapons ----","+  t('weapons: a cannon bolt fired at a craft ahead hits it', () => {","+    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 6, entrants: entrantsFor(2) });","+    const [a, b] = race.ships;","+    a.human = true; b.human = false;","+    b.lane = 0; b.u = a.u;","+    b.P = a.P + 60; b.s = SN.wrap(b.P, NORD.L); b.v = 0;","+    a.weapon = 'cannon';","+    const hitBefore = b.energy;","+    race.step(SN.STEP, [{ thrust: 0, firePressed: true }, null]);","+    let hits = 0;","+    for (let k = 0; k < 120 * 3; k++) { race.step(SN.STEP, [{ thrust: 0 }, null]); hits += race.events.filter((e) => e.t === 'hit').length; if (hits) break; }","+    if (!hits || !(b.energy < hitBefore)) throw new Error('no hit from a cannon at 60 m');","+  });","+  t('weapons: a bulwark shield cuts incoming damage to a fifth', () => {","+    const race = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 6, entrants: entrantsFor(2) });","+    const [a, b] = race.ships;","+    b.shield = 4; b.P = a.P + 30; b.s = SN.wrap(b.P, NORD.L); b.u = a.u;","+    a.weapon = 'cannon';","+    const e0 = b.energy;","+    race.step(SN.STEP, [{ firePressed: true }, null]);","+    for (let k = 0; k < 120 * 2; k++) race.step(SN.STEP, [{}, null]);","+    const lost = e0 - b.energy;","+    if (!(lost > 0 && lost < SN.WEAPONS.cannon.dmg * 0.4)) throw new Error('shield did not cut damage: ' + lost.toFixed(2));","+  });","+  t('weapons: every weapon in the table exists with a colour and a description', () => {","+    for (const k of SN.WEAPON_TABLE) {","+      const w = SN.WEAPONS[k];","+      if (!w || !w.color || !w.desc) throw new Error('missing data for ' + k);","+    }","+  });","+","+  // ---- tuning ----","+  t('tune: RESET restores every default exactly', () => {","+    SN.Tune.T.thrust = 1.7; SN.Tune.T.lapCount = 5; SN.Tune.reset();","+    for (const k of Object.keys(SN.Tune.DEFAULTS)) if (SN.Tune.T[k] !== SN.Tune.DEFAULTS[k]) throw new Error('not reset: ' + k);","+  });","+  t('tune: every slider changes the sim', () => {","+    const base = (() => { const r = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 1, entrants: entrantsFor(1) }); for (let k = 0; k < 120 * 10; k++) r.step(SN.STEP, [{ thrust: 1 }]); return r.ships[0].v; })();","+    SN.Tune.T.topSpeed = 1.5;","+    const fast = new SN.Race({ track: NORD, cls: SN.CLASSES[1], laps: 9, seed: 1, entrants: entrantsFor(1) });","+    for (let k = 0; k < 120 * 10; k++) fast.step(SN.STEP, [{ thrust: 1 }]);","+    SN.Tune.reset();","+    if (!(fast.ships[0].v > base + 10)) throw new Error('topSpeed slider has no effect');","+  });","+","+  // ---- content and files ----","+  t('content: no TODO, FIXME, XXX, placeholder or stub in the game code', () => {","+    for (const f of readdirSync(join(ROOT_DIR, 'src'))) {","+      const text = readFileSync(join(ROOT_DIR, 'src', f), 'utf8').toLowerCase();","+      for (const w of ['todo', 'fixme', 'xxx', 'placeholder', 'stub']) if (text.includes(w)) throw new Error(`${f} contains \"${w}\"`);","+    }","+  });","+  t('content: the About data has every feedback section for the exit interview', () => {","+    const A = SN.ABOUT;","+    for (const k of ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage']) {","+      if (typeof A.sourceInformation[k] !== 'string') throw new Error('missing source field ' + k);","+    }","+  });","+}"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-185013__xe162c9/agent.out","hunks":[{"oldStart":555,"oldLines":3,"newStart":555,"newLines":5,"lines":[" {\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-5-5\",\"id\":\"msg_011Cgh4jLz3dnW9RtidsyCMR\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"The suite still passes with the new start order. I'll regenerate the screenshots and look at the title frame.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2794,\"cache_read_input_tokens\":229687,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2794},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"972ca841-0540-4c71-85fe-204eae6bea61\",\"uuid\":\"6bec5d39-1b9f-49a0-ab59-620babd89f60\",\"timestamp\":\"2026-11-04T02:02:35.582Z\",\"request_id\":\"req_011Cgh4jLivGiGK6ovwBceX4\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-5-5\",\"id\":\"msg_011Cgh4jLz3dnW9RtidsyCMR\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01UhE3GQtsdiLyRSk9SobyH6\",\"name\":\"Bash\",\"input\":{\"command\":\"timeout 300 node tools/shot.mjs shots 2>&1 | head -4; ls shots\",\"description\":\"Regenerate screenshots after the start-order fix\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2794,\"cache_read_input_tokens\":229687,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2794},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"972ca841-0540-4c71-85fe-204eae6bea61\",\"uuid\":\"010216e6-45ef-43b1-b1db-b4424b34a1ad\",\"timestamp\":\"2026-11-04T02:02:36.302Z\",\"request_id\":\"req_011Cgh4jLivGiGK6ovwBceX4\",\"wire_tool_inputs\":{\"toolu_01UhE3GQtsdiLyRSk9SobyH6\":{\"command\":\"cd /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-185013__xe162c9/work/OperationWolfpack-OperationWolf-claude-haiku-5-5-medium-20261103-185013 && timeout 300 node tools/shot.mjs shots 2>&1 | head -4; ls shots\",\"description\":\"Regenerate screenshots after the start-order fix\"}},\"wire_ingest_context\":{\"toolu_01UhE3GQtsdiLyRSk9SobyH6\":{\"cwd\":\"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-185013__xe162c9/work/OperationWolfpack-OperationWolf-claude-haiku-5-5-medium-20261103-185013\"}}}"," {\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"bxce14f4k\",\"run_id\":\"0mw1h215b-faad9263\",\"tool_use_id\":\"toolu_01UhE3GQtsdiLyRSk9SobyH6\",\"description\":\"Regenerate screenshots after the start-order fix\",\"is_backgrounded\":false,\"task_type\":\"local_bash\",\"uuid\":\"5295bb6a-3cef-4f40-bf1f-2df923de9b9b\",\"session_id\":\"972ca841-0540-4c71-85fe-204eae6bea61\"}","+{\"type\":\"system\",\"subtype\":\"task_notification\",\"task_id\":\"bxce14f4k\",\"run_id\":\"0mw1h215b-faad9263\",\"tool_use_id\":\"toolu_01UhE3GQtsdiLyRSk9SobyH6\",\"status\":\"completed\",\"output_file\":\"\",\"summary\":\"Regenerate screenshots after the start-order fix\",\"uuid\":\"60a00012-b8c5-4977-9659-289702a31b35\",\"session_id\":\"972ca841-0540-4c71-85fe-204eae6bea61\"}","+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01UhE3GQtsdiLyRSk9SobyH6\",\"type\":\"tool_result\",\"content\":\"no page errors\\nabout.png\\nattract.png\\ndev.png\\nlost.png\\nop1-play.png\\nop2-play.png\\nscores.png\\ntitle.png\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"972ca841-0540-4c71-85fe-204eae6bea61\",\"uuid\":\"ce191bf0-c558-4e3f-aa8e-b5eee960e7b1\",\"timestamp\":\"2026-11-04T02:02:57.410Z\",\"tool_use_result\":{\"stdout\":\"no page errors\\nabout.png\\nattract.png\\ndev.png\\nlost.png\\nop1-play.png\\nop2-play.png\\nscores.png\\ntitle.png\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false},\"tool_result_meta\":[{\"id\":\"toolu_01UhE3GQtsdiLyRSk9SobyH6\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}]}"]}]}],"moreFiles":8,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/agent.out","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/agent.out","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/work/DipoutHD-WipeoutHD-claude-haiku-5-5-medium-20261103-184947/tests/run.mjs","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/work/DipoutHD-WipeoutHD-claude-haiku-5-5-medium-20261103-184947/tests/unit.mjs","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-185013__xe162c9/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-183213__xf5fb84/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-183213__xf5fb84/work/TideCrisis3-TimeCrisis3-claude-opus-5-5-medium-20261103-183213/src/44-view.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-183420__xf7f297/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-183848__x1295cd/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-184648__xa320fb/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009/engine/CHANGES.md","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/src/42-grapple.js"]}},"tool_result_meta":[{"id":"toolu_01WMfQGEE26Fmt6TxA85E78h","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh4m7A9sFjK224JKJb5R","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1108,"cache_read_input_tokens":473088,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1108},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"58a16430-39e5-4d69-a4e7-fa8db44e4654","uuid":"049b4ca5-3994-4d96-8118-faa14bcde625","timestamp":"2026-11-04T02:03:01.241Z","request_id":"req_011Cgh4m6u35R1M7oDa2AhW8","thinking_duration_ms":1042,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh4m7A9sFjK224JKJb5R","type":"message","role":"assistant","content":[{"type":"text","text":"Now combat: the damage pipeline, hero combos and jump attack, block/parry/riposte, and enemy strikes."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1108,"cache_read_input_tokens":473088,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1108},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"58a16430-39e5-4d69-a4e7-fa8db44e4654","uuid":"c831f71b-722b-4f7f-ad13-720bb69b2cbc","timestamp":"2026-11-04T02:03:01.243Z","request_id":"req_011Cgh4m6u35R1M7oDa2AhW8"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh4m7A9sFjK224JKJb5R","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XE2pMqWk6fJkB7CkR6cw5s","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/src/43-combat.js","content":"/* ---- COMBAT: one damage pipeline for every body (multipliers, a frontal block, i-frames, death events), the hero's\n * combos and jump attack, the block, the timed parry and its riposte, and enemy strikes with visible wind-ups. Hits get\n * hit-stop, shake, sparks and ink, never damage numbers ---- */\nconst Combat = {};\n/** B.damage(src, dst, amount, { kind, angle, silent, unblockable }) -> damage dealt */\nB.damage = (src, dst, amount, o = {}) => {\n  const M = B.M; if (!M || !dst || !dst.alive || dst.dead) return 0;\n  if (dst.kind === 'hero') {\n    if (M.cheats.god || (dst.action && dst.action.invulnerable) || dst.iframes > 0 || dst.action && /^cut_|grapple/.test(dst.action.name)) return 0;\n    amount *= T('enemyDmg') * (o.kind === 'fall' || o.kind === 'drown' ? 1 / T('enemyDmg') : 1);\n    const ang = o.angle !== undefined ? o.angle : src ? Math.atan2(dst.y - src.y, dst.x - src.x) : null;\n    if (dst.blocking && ang !== null && !o.unblockable && Math.abs(E.angDiff(dst.facing, ang + Math.PI)) < Math.PI / 3) {\n      amount *= 1 - dst.C.block; Au.sfx('clash'); Pt.sparks(dst.x, dst.y, dst.z + 18, 8, ang + Math.PI); game.shake(1.5); dst.blockFx = .2;\n      if (amount < .5) return 0;\n    } else if (!o.silent) { dst.hurtT = .4; game.freeze(.05); game.shake(4); Au.sfx('hurt', { vol: .7 }); B.Hud.pulse(); game.input.rumble && game.input.rumble(.5, .15); }\n    if (!o.silent) dst.iframes = .4;\n    dst.hp -= amount; M.stats.damageTaken += amount;\n    if (game.settings.blood !== 'off' && !o.silent && amount > 3) Pt.bits(dst.x, dst.y, dst.z + 16, 5, ['#8a0a10', '#c81a20']);\n    B.emit('damage', { src, dst, amount, kind: o.kind });\n    if (dst.hp <= 0) { dst.hp = 0; dst.dead = true; dst.combo.cancel(); if (dst.drag) Hero.dropBody(dst, M); Au.sfx('die'); B.emit('heroDeath', { by: src, kind: o.kind }); }\n    return amount;\n  }\n  // an enemy, a boss, a civilian or Tobei\n  if (src && src.kind === 'hero') { amount *= src.C.dmg; if (M.cheats.oneHit && dst.kind !== 'escort') amount = 9999; }\n  if (dst.guardFront && src && Math.abs(E.angDiff(dst.facing, Math.atan2(src.y - dst.y, src.x - dst.x))) < dst.guardFront.arc && !o.unblockable) {\n    amount *= 1 - dst.guardFront.k; Au.sfx('clash'); Pt.sparks(dst.x, dst.y, dst.z + 20, 8, Math.atan2(src.y - dst.y, src.x - dst.x)); if (amount < 1) { dst.blockFx = .25; return 0; }\n  }\n  dst.hp -= amount; dst.hurtT = .3; dst.flash = .12;\n  const ang = src ? Math.atan2(dst.y - src.y, dst.x - src.x) : 0;\n  game.freeze(o.kind === 'riposte' ? .12 : .05); game.shake(o.kind === 'fire' ? 5 : 2.5); Au.sfx('hit', { vol: .8 });\n  Pt.impact && Pt.impact(dst.x, dst.y, dst.z + 18, 1, '#ffffff'); Pt.sparks(dst.x, dst.y, dst.z + 18, 6, ang);\n  if (game.settings.blood !== 'off' && dst.kind !== 'spirit') { Pt.bits(dst.x, dst.y, dst.z + 16, 6, ['#8a0a10', '#c81a20', '#3a0406']); if (crand() < .4) M.world.decals.push({ kind: 'ink', x: dst.x + (crand() - .5) * 8, y: dst.y + (crand() - .5) * 8, r: 2 + crand() * 2, seed: crand() * 999 | 0 }); }\n  if (dst.kind !== 'boss' && src && src.kind === 'hero' && E.knockback) E.knockback(src, dst, 60);\n  if (dst.onHit) dst.onHit(src, amount, o);\n  B.emit('damage', { src, dst, amount, kind: o.kind });\n  if (dst.hp <= 0 && dst.alive) {\n    dst.hp = 0;\n    if (dst.onDeath && dst.onDeath(src, o) === false) return amount;\n    dst.alive = false; dst.fighting = false; if (dst.atk && dst.atk.cancel) dst.atk.cancel();\n    Au.sfx('die', { vol: .5 }); B.emit('kill', { victim: dst, how: o.kind || 'strike', by: src });\n  }\n  return amount;\n};\n/** the enemies a strike can hit: guards, civilians, the active boss and its summons */\nCombat.targets = M => M.guards.concat(M.civs, M.bosses, M.summons || []).filter(e => e.alive && !e.cutBy && !e.sunk && e.kind !== 'escort' && !e.untouchable);\n/** face the cursor (mouse mode) or the nearest enemy within 40 in front (auto-aim) */\nCombat.faceTarget = (h, it, M) => {\n  if (it && it.aimPoint && it.mouseMode) { h.facing = Math.atan2(it.aimPoint.y - h.y, it.aimPoint.x - h.x); return; }\n  let f = h.facing; const mv = it && it.move; if (mv && Math.hypot(mv[0], mv[1]) > .3) f = Math.atan2(mv[1], mv[0]);\n  let best = null, bd = 44; for (const e of Combat.targets(M)) { const d = Math.hypot(e.x - h.x, e.y - h.y); if (d < bd && Math.abs(e.z - h.z) < 12 && Math.abs(E.angDiff(f, Math.atan2(e.y - h.y, e.x - h.x))) < 1.3) { bd = d; best = e; } }\n  h.facing = best ? Math.atan2(best.y - h.y, best.x - h.x) : f;\n};\n/** the hero's combo: each swing hits each target once in its arc */\nCombat.heroSwing = (h, dt, M) => {\n  const ph = h.combo.update(dt);\n  if (ph === 'active') { Au.sfx('swing', { vol: .5 }); B.noise(h.x, h.y, h.z, 25, 'swing'); }\n  if (!h.combo.busy) return;\n  const step = Math.max(0, h.combo.step), dmg = h.C.comboDmg[step] || 12, spin = h.combo.current && h.combo.current.spec && h.combo.current.spec.spin;\n  h.combo.hits(Combat.targets(M), e => E.inArc(h, h.facing, e, spin ? 24 : 21, spin ? Math.PI : 1.3, 12), e => {\n    if (e.kind === 'civ') M.stats.civiliansHarmed += e.hp > 0 && !e.harmed ? (e.harmed = 1) : 0;\n    if (e.mind && e.mind.state !== 'alert' && e.kind !== 'boss') { e.mind.level = 1.2; e.mind.last = { x: h.x, y: h.y, z: h.z }; }\n    B.damage(h, e, dmg, { kind: 'strike' });\n  });\n};\n/** a jump attack lands: a plunge onto whatever is under the hero */\nCombat.landAttack = (h, M) => {\n  Pt.dust(h.x, h.y, h.z, 8); game.shake(2); Au.sfx('stomp', { vol: .5 });\n  for (const e of Combat.targets(M)) if (Math.hypot(e.x - h.x, e.y - h.y) < 18 && Math.abs(e.z - h.z) < 10) B.damage(h, e, 20, { kind: 'plunge' });\n};\n/** the riposte: a staggered enemy in reach dies at once (a boss loses 60) */\nCombat.riposteTarget = (h, M) => { for (const e of Combat.targets(M)) if (e.status && e.status.stagger > 0 && Math.hypot(e.x - h.x, e.y - h.y) < 24 && Math.abs(e.z - h.z) < 10) return e; return null; };\nCombat.tryRiposte = (h, M) => {\n  const e = Combat.riposteTarget(h, M); if (!e) return false;\n  h.facing = Math.atan2(e.y - h.y, e.x - h.x); h.combo.cancel(); h.combo.press();\n  game.flash('#ffffff', .1, .6); B.Cam.cine(1.4, .4); Au.sfx('clash'); Au.sfx('cutTwang', { vol: .5 });\n  e.status.stagger = 0;\n  B.damage(h, e, e.kind === 'boss' ? 60 / h.C.dmg : 999, { kind: 'riposte', unblockable: true });\n  B.emit('riposte', { victim: e });\n  return true;\n};\n/** an enemy's swing reaches its strike: a parry (block pressed within the window), a block, or a hit */\nCombat.enemyStrike = (e, dmg, o = {}) => {\n  const M = B.M, h = M.hero; if (!h || h.dead) return false;\n  const reach = o.reach || 22, arc = o.arc || 1.1, d = Math.hypot(h.x - e.x, h.y - e.y);\n  if (d > reach || Math.abs(h.z - e.z) > 12 || Math.abs(E.angDiff(e.facing, Math.atan2(h.y - e.y, h.x - e.x))) > arc) return false;\n  const facing = Math.abs(E.angDiff(h.facing, Math.atan2(e.y - h.y, e.x - h.x))) < 1.2;\n  if (o.parry !== false && h.parryT <= T('parryWindow') && facing && !h.swim) {\n    e.status.stagger = o.stagger || 1.3; if (e.atk && e.atk.cancel) e.atk.cancel();\n    Au.sfx('parry'); game.flash('#ffffff', .08, .5); Pt.sparks(e.x, e.y, e.z + 20, 14, Math.atan2(e.y - h.y, e.x - h.x)); game.freeze(.08);\n    B.Hud.toast('Parried', '{a:attack} Riposte'); B.emit('parry', { by: h, enemy: e }); h.parryT = 9;\n    return true;\n  }\n  B.damage(e, h, dmg, { kind: o.kind || 'melee', angle: Math.atan2(h.y - e.y, h.x - e.x), unblockable: o.unblockable });\n  if (o.knock && !h.action) E.knockback(e, h, o.knock);\n  return true;\n};\nB.Combat = Combat;\n"},"caller":{"type":"direct"}}]