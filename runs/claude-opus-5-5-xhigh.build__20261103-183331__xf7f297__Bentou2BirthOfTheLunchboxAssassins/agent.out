wl = Sp(J.head, -.6, 0, R * .55), cr = tones(h.crest || '#c8a040');\n      const sk = [Sp(J.head, -R * .2, -R * 1.25, -R * .2), Sp(J.head, -R * 1.25, -R * .8, -R * .45), Sp(J.head, -R * 1.45, 0, -R * .5), Sp(J.head, -R * 1.25, R * .8, -R * .45), Sp(J.head, -R * .2, R * 1.25, -R * .2), Sp(J.head, -R * .4, 0, R * .5)];\n      px.poly(g, sk, t.deep); px.disc(g, bowl[0], bowl[1], r * 1.0, t.sh); px.disc(g, bowl[0] - .6, bowl[1] - .6, Math.max(.5, r - 1), t.base);\n      const f = Sp(J.head, R * .8, 0, -.3); px.disc(g, f[0], f[1], r * .52, this.C.skin);\n      const b0 = Sp(J.head, R * .9, 0, R * .45);\n      for (const sd of [-1, 1]) { const tip = Sp(J.head, R * 1.2, sd * R * 1.15, R * 1.9); px.line(g, b0[0], b0[1], tip[0], tip[1], cr.base, Math.max(1, Math.round(r * .22))); px.dot(g, tip[0], tip[1], cr.hi); }\n      px.disc(g, b0[0], b0[1], Math.max(1, r * .2), cr.lt);\n    } else if (st === 'crown') {\n      for (const k of [-1, 0, 1])\"\"\")\nopen(p,'w',encoding='utf8').write(s)\nprint('ok')\nEOF\nnode -e \"const vm=require('vm');const c={console};vm.createContext(c);vm.runInContext(require('fs').readFileSync('my-3d2dge.js','utf8'),c);const E=c.My3D2dge;const r=new E.Humanoid({weapon:'spear',hat:'jingasa',mask:{color:'#222'},offhand:{len:5},sashimono:'#a33'});r.update(.01,{x:0,y:0,z:0});console.log('rig ok',E.version)\"","description":"Apply Humanoid gear patch and smoke test"}},"wire_ingest_context":{"toolu_01RxFJVa2KoXnHtz66RWWigg":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/engine"}}}
