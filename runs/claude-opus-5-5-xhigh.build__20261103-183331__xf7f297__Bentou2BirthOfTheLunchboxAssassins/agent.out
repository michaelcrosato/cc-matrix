dle > attract mode after 10 s without input', 'in the browser too'],","+    ['attract > attract runs three loops', 'it loops'], ['attract > every vignette was visited each loop', 'it shows the demo'], ['task > Attract mode: the autopilot plays with cheats (god mode)', 'the AI cheats']]],","+  [42, 'any input exits it', [","+    ['boot > a press returns to the title', 'a press'], ['browser/bundle > a mouse move returns to the title', 'a mouse move'], ['task > Attract mode: any input exits it', 'confirm']]],","+  [44, 'for multiplayer integration into ai-hub as well as for the game on its own', [","+    ['hub > a ghost appears where the other player is', 'in the hub: the others as ghosts'], ['hub > time-up: the result at once', 'results to the hub'],","+    ['playthrough > the trial shows its board', 'on its own: the Shadow Trial'], ['task > Multiplayer: the game on its own (the Shadow Trial with your best ghost)', 'against your own ghost']]],","+  [46, 'Use a writing style similar to the source', [","+    ['story > scene prologue runs to its end when skipped', 'the story scenes play'], ['story > lines of their own for Sojiro and Kaede', 'two voices'],","+    ['story > every bark category has lines', 'guards talk'], ['task > Narrative tone: a story in the source\\'s register (crawl, briefings, cutscenes, barks)', 'how much of it']], ['shots/story-prologue.png']],","+  [49, 'Design the game around a PS5 DualSense (or any pad the browser reports in its standard mapping)', [","+    ['browser/play > pad: cross opens the title menu', 'cross'], ['browser/play > pad: d-pad down moves the menu cursor', 'the d-pad'],","+    ['browser/play > pad: cross picks the entry (Missions opens character select)', 'picks'], ['browser/play > pad: circle goes back to the title', 'circle backs out'],","+    ['browser/bundle > a controller press switches the prompts to its symbols', 'a DualSense, standard mapping']]],","+  [49, 'The keyboard uses the keys PC players expect for the genre', [","+    ['input > the keys move the hero', 'WASD moves'], ['input > keys: Space', 'Space jumps'], ['task > UI: the keys PC players expect for the genre', 'Shift, C, F, Esc']]],","+  [49, 'The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus)', [","+    ['browser/play > mouse: hovering Workshop moves the focus to it', 'hover moves the focus'], ['browser/play > mouse: a click on About opens it', 'clicks menu items'],","+    ['browser/play > mouse: hovering a menu button focuses it', 'on the HTML screens too'], ['browser/play > mouse: a click in the world strikes', 'clicks in the world'],","+    ['grapple > the mouse picks the anchor under it', 'aims']]],","+  [49, 'On-screen prompts follow the input used last', [","+    ['browser/bundle > a controller press switches the prompts to its symbols', 'to the pad'], ['browser/bundle > a key press switches them back to keys', 'back to keys'],","+    ['input > a mouse prompt: the mouse button', 'mouse buttons']]],","+  [49, 'with a Settings option to show Xbox glyphs, A B X Y, instead', [","+    ['input > the pad shows PlayStation symbols by default', 'PlayStation by default'],","+    ['browser/screens > a tap on SETTINGS opens Settings, with Button symbols on it set to PlayStation', 'the option is on Settings'],","+    ['browser/screens > a tap on it switches to Xbox: the setting, and the controller prompts become A B X Y', 'and switches to A B X Y']], ['shots/touch-settings.png']],","+  [51, 'Do not use overly dense, web-style data screens.', [","+    ['browser/play > a Balance page: live sliders (at most 8)', 'dev pages hold at most 8 rows'],","+    ['task > UI: no dense web-style data screens (at most 8 rows a dev page; one decision a screen)', 'every dev page']], ['shots/pause.png', 'shots/dev-balance.png', 'shots/about-2.png']],","+  [53, 'Touch-only devices: no touch controls; show \"Controller or keyboard required\" and the settings button. Let the attract mode run.', [","+    ['browser/screens > the phone draws \"Controller or keyboard required\" and a SETTINGS button', 'the notice and the button, drawn'],","+    ['browser/screens > the phone shows no touch controls (no PRESS START, no menu)', 'no touch controls'],","+    ['browser/screens > a tap on SETTINGS opens Settings, with Button symbols on it set to PlayStation', 'the button works'],","+    ['browser/bundle > attract still runs on a touch-only device', 'attract runs']], ['shots/touch.png']],","+  [56, 'No TODOs, placeholders, or stubbed features. The demo is complete.', [","+    ['task > Done: no TODO, FIXME, placeholder or stub in the game\\'s source', 'none in the source'], ['playthrough > every story mission is completed in the save', 'the whole demo plays through']]],","+  [59, 'Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen', [","+    ['browser/screens > Enter on About opens the About / Credits screen', 'reached from the title menu'],","+    ['browser/screens > About page 2 (Source Information): shown, and every line of it drawn on the canvas', 'Source Information'],","+    ['browser/screens > About page 3 (Testing Feedback): shown, and every line of it drawn on the canvas', 'Testing Feedback'],","+    ['browser/screens > About page 4 (Engine Feedback): shown, and every line of it drawn on the canvas', 'Engine Feedback'],","+    ['browser/screens > About page 5 (Prompt Feedback): shown, and every line of it drawn on the canvas', 'Prompt Feedback'],","+    ['about > the feedback pages answer 4, 6 and 4 questions', 'every question answered']], ['shots/about-3.png']],","+  [75, 'save these answers as exit-interview.json in this folder\\'s root', [","+    ['about > exit-interview.json parses', 'parses'], ['about > it answers every Source Information field', 'every field'], ['about > its feedback matches the pages', 'the same answers as the screen'],","+    ['about > its AI Hub entry is complete', 'the AI Hub entry'], ['task > Exit interview: in the root, in TASK.md\\'s shape', 'TASK.md\\'s shape']]],"," ];","-const all = RUN.checks.map(c => ({ ...c, id: c.suite + ' > ' + c.name }));","-let ok = 0; const md = ['# TASK.md audit', '', `From the full run of ${RUN.at} (${RUN.passed}/${RUN.passed + RUN.failed} checks passed). Each item quotes TASK.md and lists the checks that show it.`, ''];","-const bad = [];","+const byId = new Map(RUN.checks.map(c => [c.suite + ' > ' + c.name, c]));","+const out = [`TASK.md audit: the full run of ${RUN.at}, ${RUN.passed}/${RUN.passed + RUN.failed} checks passed`, ''];","+let ok = 0; const bad = [];"," if (!RUN.full) bad.push('tests/last-run.json is not a full run');","-for (const [ln, quote, pats, note] of ITEMS) {","-  const quoted = (TASK[ln - 1] || '').includes(quote), hits = pats.map(p => all.filter(c => new RegExp(p).test(c.id)));","-  const empty = pats.filter((p, i) => !hits[i].length), failed = [...new Set(hits.flat().filter(c => !c.pass).map(c => c.id))], n = new Set(hits.flat().map(c => c.id)).size;","-  const pass = quoted && !empty.length && !failed.length; if (pass) ok++;","-  console.log((pass ? 'PASS' : 'FAIL') + ` L${ln} ${quote.slice(0, 70)}${quote.length > 70 ? '…' : ''} — ${n} checks` + (!quoted ? ' [quote not on that line]' : '') + (empty.length ? ' [no check: ' + empty.join(', ') + ']' : '') + (failed.length ? ' [failed: ' + failed.join(', ') + ']' : ''));","-  md.push(`## L${ln}: \"${quote}\" — ${pass ? 'PASS' : 'FAIL'}`, '', ...[...new Set(hits.flat().map(c => (c.pass ? '- [x] ' : '- [ ] ') + c.id))], ...(note ? ['- also ' + note] : []), '');","-}"," if (!existsSync(new URL(NAME + '.html', ROOT))) bad.push('the bundle is missing');","-writeFileSync(new URL('tests/AUDIT.md', DEV), md.join('\\n'));","-console.log(`${ok}/${ITEMS.length} TASK.md items shown by passing checks` + (bad.length ? ' — ' + bad.join('; ') : '') + ` (run ${RUN.at}, ${RUN.passed}/${RUN.passed + RUN.failed} checks)`);","+for (const [ln, quote, ev, shots = []] of ITEMS) {","+  const quoted = (TASK[ln - 1] || '').includes(quote), rows = ev.map(([id, what]) => { const c = byId.get(id); return [c ? (c.pass ? 'pass' : 'FAIL') : 'MISSING', id, what]; });","+  const shotRows = shots.map(f => [existsSync(new URL(f, DEV)) ? 'seen' : 'MISSING', f]);","+  const pass = quoted && rows.every(r => r[0] === 'pass') && shotRows.every(r => r[0] === 'seen'); if (pass) ok++;","+  out.push(`${pass ? 'PASS' : 'FAIL'} L${ln}: \"${quote}\"${quoted ? '' : ' [the quote is not on that line]'}`);","+  for (const [st, id, what] of rows) out.push(`   ${st.padEnd(4)}  ${id}${what ? '  (' + what + ')' : ''}`);","+  for (const [st, f] of shotRows) out.push(`   ${st.padEnd(4)}  screenshot ${f}`);","+}","+out.push('', `${ok}/${ITEMS.length} TASK.md items shown` + (bad.length ? ' — ' + bad.join('; ') : ''));","+writeFileSync(new URL('tests/AUDIT.md', DEV), '```\\n' + out.join('\\n') + '\\n```\\n');","+console.log(out.join('\\n'));"," process.exit(ok === ITEMS.length && !bad.length ? 0 : 1);"]}],"originalFile":"// node tools/audit.mjs: TASK.md, item by item, against the last FULL run of node tests/run.mjs (tests/last-run.json).\n// Each item quotes TASK.md (checked against the line it names) and lists the checks that show it in behaviour; an item\n// passes only when every pattern matches at least one recorded check and every matched check passed. Prints one line an\n// item and a one-line verdict, and writes tests/AUDIT.md with every check under its item.\nimport { readFileSync, writeFileSync, existsSync } from 'node:fs';\nimport { NAME } from './name.mjs';\nconst DEV = new URL('../', import.meta.url), ROOT = new URL('../../', import.meta.url);\nconst TASK = readFileSync(new URL('TASK.md', ROOT), 'utf8').split('\\n'), RUN = JSON.parse(readFileSync(new URL('tests/last-run.json', DEV), 'utf8'));\nconst ITEMS = [\n  [1, 'SOURCE: Tenchu 2: Birth of the Stealth Assassins', ['^about > it answers every Source Information field', '^browser/screens > About page 2 \\\\(Source Information\\\\)']],\n  [3, 'Genre: Pick the game genre', ['^perception > ', '^silentcut > ', '^ai > ', '^alarm > ', '^combat > ', '^bosses > ']],\n  [5, 'Perspective: Pick the camera perspective', ['^task > Perspective: ']],\n  [7, 'pick one with a real random number generator', ['^task > Game Title: ']],\n  [11, 'provide a single html file [GameTitle-SOURCE-claude-opus-5-5-xhigh-20261103-183331.html]', ['^task > Package: ', '^browser/play > the single file: the page loads nothing but itself', '^browser/bundle > a mission plays from the single file']],\n  [13, 'Build on https://github.com/michaelcrosato/my-3d2dge/tree/main/dist/handoff', ['^task > Tech stack: ', '^boot > ']],\n  [15, 'Make new art assets for whatever makes the game feel like the source', ['^task > Art: ', '^browser/play > art: the game\\'s own Japanese props are drawn in the mission'], 'and the screenshot reviews (shots/)'],\n  [17, 'Make new animations for whatever makes the game feel like the source', ['^silentcut > (sojiro|kaede): the cut starts its choreography', '^silentcut > .* runs to the end', '^grapple > a tap pulls the hero onto the roof', '^task > Animation: ', '^story > ']],\n  [19, 'All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish.', ['^browser/play > voice: ', '^browser/play > music: ', '^browser/play > audio: nothing decoded', '^task > Audio: ']],\n  [21, 'Online: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub', ['^hub > ', '^browser/hub > ', '^task > Multiplayer: ']],\n  [24, 'Create a subfolder called [GameTitle-SOURCE-claude-opus-5-5-xhigh-20261103-183331]', ['^task > Working environment: ', '^browser/hub > the served page is this game']],\n  [28, 'including a scripted playthrough of the whole game', ['^playthrough > every story mission is completed in the save', '^playthrough > the ending leads to the credits', '^playthrough > Rice and Ash as Kaede is won', '^playthrough > the Night Delivery is won']],\n  [38, 'Create a feature-complete demo.', ['^playthrough > ', '^task > Scope: ', '^move > ', '^grapple > ', '^ki > ', '^tools > ', '^mission > ', '^bosses > ']],\n  [38, 'all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools', ['^workshop > ', '^task > Scope: infrastructure for designer tools']],\n  [40, 'Include a dev mode, reachable from the pause menu', ['^browser/play > Escape pauses: the pause menu', '^browser/play > the pause menu\\'s Dev Mode opens the dev screens', '^dev > every dev page opens', '^dev > god mode', '^dev > no-clip', '^dev > freeze AI']],\n  [40, 'expose the most important gameplay variables as live sliders, with a reset to defaults', ['^browser/play > a slider moved with the keys changes the game live', '^browser/play > Reset page restores the default', '^dev > a slider changes B.T live', '^dev > the hero runs faster at once', '^dev > Reset all restores every slider', '^task > Dev mode: the important gameplay variables']],\n  [42, 'After 10 seconds without input on the title/menu screen, start a looping AI-played demo', ['^boot > no attract before 10 s', '^boot > attract after 10 s idle', '^browser/bundle > attract mode after 10 s without input', '^attract > attract runs three loops', '^attract > every vignette was visited each loop', '^task > Attract mode: the autopilot plays with cheats']],\n  [42, 'any input exits it', ['^boot > a press returns to the title', '^attract > any input returns to the title', '^browser/bundle > a mouse move returns to the title', '^task > Attract mode: any input exits it']],\n  [44, 'for multiplayer integration into ai-hub as well as for the game on its own', ['^browser/hub > the hub harness passes', '^hub > a ghost appears where the other player is', '^hub > time-up: the result at once', '^playthrough > the trial shows its board', '^task > Multiplayer: the game on its own']],\n  [46, 'Use a writing style similar to the source', ['^story > ', '^task > Narrative tone: '], 'and the lines themselves (src/62-story.js)'],\n  [49, 'Design the game around a PS5 DualSense (or any pad the browser reports in its standard mapping)', ['^browser/play > pad: ', '^browser/bundle > a controller press switches the prompts to its symbols', '^task > UI: a pad in the standard mapping']],\n  [49, 'The keyboard uses the keys PC players expect for the genre', ['^input > the keys move the hero', '^input > keys: Space', '^task > UI: the keys PC players expect']],\n  [49, 'The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus)', ['^browser/play > mouse: hovering Workshop moves the focus', '^browser/play > mouse: a click on About opens it', '^browser/play > mouse: a click in the world strikes', '^browser/play > mouse: hovering a menu button focuses it', '^grapple > the mouse picks the anchor under it', '^input > the wheel cycles tools']],\n  [49, 'On-screen prompts follow the input used last', ['^browser/bundle > a controller press switches the prompts', '^browser/bundle > a key press switches them back to keys', '^input > a (pad|mouse|keyboard) prompt', '^task > UI: on-screen prompts follow the input used last']],\n  [49, 'with a Settings option to show Xbox glyphs, A B X Y, instead', ['^input > the pad shows PlayStation symbols by default', '^input > the Xbox option shows A', '^browser/screens > a tap on SETTINGS opens Settings, with Button symbols', '^browser/screens > a tap on it switches to Xbox']],\n  [51, 'Do not use overly dense, web-style data screens.', ['^browser/play > a Balance page: live sliders \\\\(at most 8\\\\)', '^task > UI: no dense web-style data screens'], 'and the screenshot reviews (shots/)'],\n  [53, 'Touch-only devices: no touch controls; show \"Controller or keyboard required\" and the settings button. Let the attract mode run.', ['^browser/screens > the phone draws', '^browser/screens > the phone shows no touch controls', '^browser/screens > a tap on SETTINGS opens Settings', '^browser/bundle > attract still runs on a touch-only device']],\n  [56, 'No TODOs, placeholders, or stubbed features. The demo is complete.', ['^task > Done: ', '^playthrough > every story mission is completed in the save']],\n  [59, 'Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen', ['^browser/screens > Enter on About opens the About / Credits screen', '^browser/screens > About page [1-6] ', '^about > six About pages', '^about > the feedback pages answer 4, 6 and 4 questions']],\n  [75, 'save these answers as exit-interview.json in this folder\\'s root', ['^about > exit-interview.json parses', '^about > it answers every Source Information field', '^about > its feedback matches the pages', '^about > its AI Hub entry is complete', '^task > Exit interview: ']],\n];\nconst all = RUN.checks.map(c => ({ ...c, id: c.suite + ' > ' + c.name }));\nlet ok = 0; const md = ['# TASK.md audit', '', `From the full run of ${RUN.at} (${RUN.passed}/${RUN.passed + RUN.failed} checks passed). Each item quotes TASK.md and lists the checks that show it.`, ''];\nconst bad = [];\nif (!RUN.full) bad.push('tests/last-run.json is not a full run');\nfor (const [ln, quote, pats, note] of ITEMS) {\n  const quoted = (TASK[ln - 1] || '').includes(quote), hits = pats.map(p => all.filter(c => new RegExp(p).test(c.id)));\n  const empty = pats.filter((p, i) => !hits[i].length), failed = [...new Set(hits.flat().filter(c => !c.pass).map(c => c.id))], n = new Set(hits.flat().map(c => c.id)).size;\n  const pass = quoted && !empty.length && !failed.length; if (pass) ok++;\n  console.log((pass ? 'PASS' : 'FAIL') + ` L${ln} ${quote.slice(0, 70)}${quote.length > 70 ? '…' : ''} — ${n} checks` + (!quoted ? ' [quote not on that line]' : '') + (empty.length ? ' [no check: ' + empty.join(', ') + ']' : '') + (failed.length ? ' [failed: ' + failed.join(', ') + ']' : ''));\n  md.push(`## L${ln}: \"${quote}\" — ${pass ? 'PASS' : 'FAIL'}`, '', ...[...new Set(hits.flat().map(c => (c.pass ? '- [x] ' : '- [ ] ') + c.id))], ...(note ? ['- also ' + note] : []), '');\n}\nif (!existsSync(new URL(NAME + '.html', ROOT))) bad.push('the bundle is missing');\nwriteFileSync(new URL('tests/AUDIT.md', DEV), md.join('\\n'));\nconsole.log(`${ok}/${ITEMS.length} TASK.md items shown by passing checks` + (bad.length ? ' — ' + bad.join('; ') : '') + ` (run ${RUN.at}, ${RUN.passed}/${RUN.passed + RUN.failed} checks)`);\nprocess.exit(ok === ITEMS.length && !bad.length ? 0 : 1);\n","userModified":false},"tool_result_meta":[{"id":"toolu_01MjKSsWAsPgnTtxzgYptTXa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
