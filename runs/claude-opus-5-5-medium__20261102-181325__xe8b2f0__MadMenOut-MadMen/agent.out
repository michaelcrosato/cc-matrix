{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BAy7fMPmciCkR1LHSTjhU9","type":"tool_result","content":"1\t    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n2\t  }\n3\t};\n4\t\n5\t/* ---- GAME OVER: shared by every slice ---- */\n6\tconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\n7\tconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n8\t  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\n9\tscenes.over = {\n10\t  view: 'side', input: 'DEFAULT', res: 'ps1',\n11\t  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n12\t  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n13\t  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n14\t  draw(r) {   // centred on any screen\n15\t    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n16\t    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n17\t  }\n18\t};\n19\t\n20\t/* =====================================================================================\n21\t * SLICE 1  ADVENTURE  (Secret of Mana, Zelda: ALttP). Three rooms: village, ruins, shrine. Talk, clear the ruins for\n22\t * the key, open the great door, claim the crystal. THE LOOK: wall MATERIALS, ONE floorTex with PAINTED LIGHT, pitched\n23\t * roofs, leaf-clump bushes, light shafts, dialog PORTRAITS.\n24\t * KEYS: WASD or arrows move, J or X swings the sword, Enter or Space talks. TOUCH: the stick, ATTACK, CONFIRM.\n25\t * ANY SCREEN: rooms are 4:3 in a world that goes on past them (forest above and below, the next rooms beside), so a\n26\t * screen of any shape is filled. CAMERA (Settings, or C): ROOMS slides screen by screen as Zelda's does, the rooms beside\n27\t * this one under a dim CURTAIN (they wait, as their monsters do); SCROLL follows the hero. The HUD sits in the corners.\n28\t * ===================================================================================== */\n29\tconst ADV = (() => {\n30\t  const T = 16, ROOM = [14 * T, 12 * T], AREAS = ['Mana Village', 'Mossy Ruins', 'Shrine of Mana'];\n31\t  const ROWS = [\n32\t    // village          ruins             shrine\n33\t    ['^^^^^^^^^^^^^^', 'RRRRRRRRRRRRRR', 'XXXXXXXXXXXXXX'],\n34\t    ['^^#^^^^^^^^#^^', 'RHhJKFYDYFKhHR', 'XwjiXnWXnXijwX'],\n35\t    ['#UUUU.ZZZZ.~~#', 'R.u..qv.vq.S.R', 'X.S*.B..B.*S.X'],\n36\t    ['#GQOQbzNzZu~~#', 'H.KK....x....H', 'X.....rA.....X'],\n37\t    ['#ccccV~ccLe~~#', 'K..s.q::::.s.H', 'X..I..++..I..X'],\n38\t    ['#cM@cPccac=~~#', 'H.....::::k..K', 'X....m++m....X'],\n39\t    ['#,,,,,,,,,,__,', ',,....::C:...H', 'X4.I..++..I.4X'],\n40\t    ['#.b...b.g,d__,', ',,..o.::::.s.H', 'X.....++.....X'],\n41\t    ['#...%%%f..s~~#', 'Hb.K..::::q.KH', 'X..I..++..I..X'],\n42\t    ['#T..%%%.u..~~#', 'H.u..s....y.RH', 'X.p...++...p.X'],\n43\t    ['#.3........~~#', 'H...bK...b.xRH', 'X.....E+.....X'],\n44\t    ['##############', 'RRRRRRRRRRRRRR', 'XXXXXX++XXXXXX']\n45\t  ].map(r => r.join(''));\n46\t  // the world AROUND the rooms: PAD rows of forest canopy above and below (a meadow's edge first, the shrine's stone under\n47\t  // the shrine), so a screen of any shape is filled. The rooms' rows start at OY\n48\t  const PAD = 12, OY = PAD * T, wood = (cx, cy) => cx >= 28 ? 'X' : E.hash2(cx * 7, cy * 5) < .18 ? '2' : '1';\n49\t  const AROUND = (cy0, meadow) => Array.from({ length: PAD }, (_, i) => Array.from({ length: 42 }, (_, cx) => meadow && i < 2 && cx < 28 ? '.' : wood(cx, cy0 + i)).join(''));\n50\t  ROWS.unshift(...AROUND(0)); ROWS.push(...AROUND(PAD + 12, true));\n51\t  const LEGEND = {\n52\t    // walls: a wall type (TYPES), or { tile, spawn } = a wall with a prop on its face (THINGS)\n53\t    '#': 1, 'U': 5, 'Z': 8, 'R': 9, 'H': 3, 'K': 4, 'F': 6, 'X': 2, 'A': 7, '1': 10, '2': { tile: 10, spawn: 'tree' },\n54\t    '^': { tile: 1, spawn: 'tree' }, 'G': { tile: 5, spawn: 'ivy' }, 'Q': { tile: 5, spawn: 'pane' }, 'O': { tile: 5, spawn: 'door' },\n55\t    'z': { tile: 8, spawn: 'pane' }, 'N': { tile: 8, spawn: 'shop' }, 'h': { tile: 3, spawn: 'vines' }, 'J': { tile: 3, spawn: 'cobweb' }, 'Y': { tile: 6, spawn: 'moss' }, 'D': { tile: 6, spawn: 'gate' },\n56\t    'w': { tile: 2, spawn: 'window' }, 'W': { tile: 2, spawn: 'rose' }, 'i': { tile: 2, spawn: 'torch' }, 'n': { tile: 2, spawn: 'banner' }, 'j': { tile: 2, spawn: 'cobweb' }, 'r': { tile: 7, spawn: 'relic' },\n57\t    // floors: a tag for floorTex; block = not walkable\n58\t    ',': { floor: 'path' }, 'c': { floor: 'plaza' }, '~': { floor: 'water', block: true }, '_': { floor: 'bridge' }, ':': { floor: 'pave' }, '+': { floor: 'carpet' }, '%': { floor: 'bed' },\n59\t    '@': { floor: 'plaza', spawn: 'hero' }, 'M': { floor: 'plaza', spawn: 'elder' }, 'P': { floor: 'plaza', spawn: 'pot' }, 'L': { floor: 'plaza', spawn: 'lamp' },\n60\t    'V': { floor: 'water', block: true, spawn: 'fountain' }, 'C': { floor: 'pave', spawn: 'chest' }, 'E': { floor: 'carpet', spawn: 'entry' }, 'd': { floor: 'path', spawn: 'villager' },\n61\t    // people, creatures and props\n62\t    'f': 'florist', 'a': { floor: 'plaza', spawn: 'cat' }, 's': 'rabite', 'v': 'bat', 'k': 'goblin', 'm': 'mage', 'b': 'bush', 'p': 'pot', 'T': 'oak', 'g': 'sign', 'u': 'mushroom',\n63\t    'e': 'barrel', '=': 'crate', '3': 'stump', '4': 'obelisk', 'q': 'ruin', 'I': 'pillar', 'S': 'statue', 'o': 'rock', 'x': 'crystal', 'y': 'skull', 'B': 'brazier', '*': 'candelabra'\n64\t  };\n65\t  // wall MATERIALS: face = side, roof = top pattern (beam = timber); cut = lowered to cutH in front of the camera\n66\t  const SLAB = { face: 'stone', roof: 'slab' }, TYPES = {\n67\t    1: { h: 16, cut: true, cutH: 7, face: 'hedge', roof: 'leaves', top: '#3f8c3c', side: '#2e6a34' },   // hedge\n68\t    2: { h: 34, cut: true, cutH: 8, ...SLAB, top: '#4e4670', side: '#6a6294', course: 9 },   // shrine stone\n69\t    3: { h: 26, cut: true, cutH: 8, face: 'ruin', roof: 'slab', top: '#7a8a66', side: '#8e8a98' },   // ruin wall, mossy top: the 'ruin' MATERIAL (stones, cracks, moss, dirt; docs/ASSETS.md)\n70\t    4: { h: 12, cut: true, ...SLAB, top: '#72845e', side: '#8e8a98', course: 6 },   // crumbled ruin\n71\t    5: { h: 36, face: 'timber', roof: 'tiles', top: '#c4583a', side: '#f0e0c0', beam: '#6a4228' },   // cottage\n72\t    6: { h: 36, ...SLAB, top: '#5a5480', side: '#7a7298', course: 9 },   // shrine facade\n73\t    7: { h: 9, ...SLAB, top: '#8a84b4', side: '#5a5484', course: 4 },   // altar\n74\t    8: { h: 36, face: 'plaster', roof: 'tiles', top: '#3a7ab4', side: '#f4e6c8' },   // shop\n75\t    9: { h: 30, cut: true, cutH: 8, face: 'rock', roof: 'grass', top: '#5a9a44', side: '#8a7462' },   // cliff\n76\t    10: { h: 22, face: 'hedge', roof: 'leaves', top: '#2c6a36', side: '#1f4a2a' }   // the forest round the rooms\n77\t  };\n78\t  // set dressing: tag -> prop(s). r = solid, cut = breakable (debris), drop = loot, face = on the wall at z (anchor\n79\t  // 'top' hangs it), light = GPU light, dx = nudge, hidden = appears later; shape = a SHAPE (E.SHAPES, docs/ASSETS.md:\n80\t  // right in every view and turn, no drawing code) in place of a prop, size its scale\n81\t  const THINGS = {\n82\t    // village\n83\t    door: [{ face: true, size: 1.1, color: '#7a4222' }, { prop: 'lantern', face: true, z: 33, dx: 14, anchor: 'top', light: '#ffb060' }],\n84\t    shop: [{ prop: 'door', face: true, size: 1.1, color: '#2a4a7a' }, { prop: 'awning', face: true, z: 23, size: .95, color: '#d8483a' }],\n85\t    pane: { prop: 'window', face: true, z: 12, size: .65, color: '#6a4424', colors: ['#fff0b0', '#ffd070'] }, ivy: { prop: 'vines', face: true, z: 35, anchor: 'top', color: '#3a8a3a', blossom: '#f890b0' },\n86\t    fountain: { prop: 'statue', size: .8, color: '#a8a6c0', dx: 8 }, lamp: { prop: 'streetlamp', r: 3, size: .8, halo: false }, oak: { prop: 'tree', size: 1.45, r: 8 },   // lamp: unlit by day\n87\t    bush: { r: 6, cut: ['#2f7a34', '#5ab04a', '#9ad86a'] }, pot: { size: .95, r: 5, cut: ['#7a3a22', '#c07040', '#e8a878'], drop: 'gem' }, sign: { r: 4 },\n88\t    mushroom: { size: .75, color: '#e0503a' }, barrel: { shape: 'barrel', r: 5, size: .75 }, crate: { shape: 'crate', r: 6, size: .65 },\n89\t    // from the asset store, cut into the page's 'adventure' set (src/assets/sets/adventure.js); without it, props\n90\t    ...(E.addAssets((window.ASSETS || {}).adventure || { set: 'adventure' }).shapes.length ? { stump: { shape: 'adventure:stump-round', r: 5, size: .7 },\n91\t      obelisk: { shape: 'adventure:pillar-obelisk', r: 6, size: .8 } } : { stump: { prop: 'rock', r: 5, color: '#8a5a3a' }, obelisk: { prop: 'pillar', r: 6 } }),\n92\t    // ruins\n93\t    vines: { face: true, z: 25, anchor: 'top', color: '#4a8a3a', blossom: '#f890b0' }, moss: { prop: 'vines', face: true, z: 35, anchor: 'top', size: .8, color: '#5a8a3a', blossom: '#f890b0' },\n94\t    gate: { prop: 'door', face: true, size: 1.1, color: '#5a3a6a' }, ruin: { prop: 'pillar', broken: true, r: 7 }, rock: { r: 5, color: '#8a8698' }, skull: { prop: 'bones' },\n95\t    crystal: { r: 4, light: '#5ad8f0' }, chest: { r: 6, hidden: true },\n96\t    // shrine\n97\t    window: { face: true, z: 7, size: .8, colors: ['#e05a6a', '#5a8ae8', '#f0c85a', '#6ad08a'], light: '#8ab0ff' }, torch: { face: true, z: 14, light: '#ff9a4a' },\n98\t    rose: { prop: 'window', face: true, z: 2, size: 1, dx: 8, colors: ['#e8c85a', '#c04aa0', '#5a8ae8'], light: '#c8a0ff' }, banner: { face: true, z: 8, size: .8, color: '#8a1a3a', emblem: '#e8c04a' },\n99\t    cobweb: { face: true, z: 34, anchor: 'top', size: .9 }, pillar: { r: 7 }, statue: { r: 6, color: '#9a98b0' }, brazier: { r: 5, size: .9, light: '#ff9a4a' }, candelabra: { r: 3, size: .8, light: '#ffc060' }\n100\t  };\n101\t  // palettes: E.ramp(hex, n, strength) = n hue-shifted shades, dark to light\n102\t  const rgb = hexes => hexes.map(E.hex), R5 = (c, s = .6) => rgb(E.ramp(c, 5, s)), FLAG = (s, mortar) => ({ stones: s.slice(1, 4), mortar, hi: s[4], lo: s[0], speck: s[1] });\n103\t  const GRASS = [['#4c9a3e', '#5aa640', '#6cb44c'], ['#42804a', '#4a8a48', '#5a9a4e']].map(room => room.map(c => R5(c))), DIRT = R5('#b08652', .7), WATER = R5('#2a7ac4', .9), STONE = R5('#a49a8a', .7), SOIL = R5('#6e4a34');\n104\t  const PLAZA = FLAG(R5('#b4a894'), E.hex('#6a5e52')), PAVE = FLAG(R5('#8a8a96'), E.hex('#3a3a3e')), TILE = [R5('#5a5688'), R5('#403c68')], PETAL = rgb(['#ffffff', '#ffe070', '#f890b0']);\n105\t  const CARPET = rgb(E.ramp('#9a2438', 4)), GOLD = rgb(E.ramp('#d8a840', 3)), RUNE = [...E.hex('#6ae8e0'), .35], LILY = R5('#4aa050');   // 4th value = GPU glow\n106\t  const SKY = rgb(['#a8dcf4', '#e8f8ff']), REFLECT = E.hex('#1e5a5a');   // sky glints, the hedge's reflection\n107\t  const TUFT = ['.l.l.', '.dld.', '..d..'], BLOOM = ['.w.', 'wyw', '.w.'];   // grass stamps\n108\t  const MOOD = [[.92, .9, .84], [.8, .88, .8], [.34, .3, .46]];   // GPU ambient light per room\n109\t  const mood = m => { if (gpu) gpu.ambient = m; L.ambient = (m[0] + m[1] + m[2]) / 3; };   // (and the canvas lighting's, where WebGPU is missing and it stands in)\n110\t  // light shafts per room: beam x, tint (a dark tint = a faint beam), lean\n111\t  const BEAMS = [[[34, 128, 196], '#7a5a26', 60], [[50, 150], '#566a22', 60], [[24, 120, 200], '#4a3a8a', 12]];\n112\t  const WIN = { bg: ['#3a4a9e', '#12163e'], border: '#f0e0a8' }, FACE_BG = ['#7aa4e8', '#1e2a66'];\n113\t  // pixel sprites ('.' = transparent)\n114\t  const GEM = E.sprite(['..g..', '.gGg.', 'gGWGg', 'gGGGg', 'dgGgd', '.dgd.', '..d..'], { g: '#1e9a3a', G: '#56e070', W: '#e8fff0', d: '#0e5a24' });\n115\t  const HEART = E.sprite(['.R.R.', 'RWRRR', 'RRRRR', '.RRR.', '..R..'], { R: '#e8384a', W: '#ffd0d6' });\n116\t  const KEYS = [1, 2].map(s => E.sprite(['.yy....', 'y..y...', 'Y..Yyyy', '.YY..y.', '.....yY'], { y: '#f8d048', Y: '#b07818' }, s));   // scale 2: held up high\n117\t  const CRYSTALS = [1, 2].map(s => E.sprite(['....w....', '...wWc...', '..wWWcc..', '.wWWWccC.', 'wWWWccccC', '.wWWcccC.', '.cWWccCC.', '..cWcCC..', '..ccCC...', '...cC....'], { w: '#f0ffff', W: '#a8f0ff', c: '#4ac8e8', C: '#2a5ab0' }, s));\n118\t\n119\t  // THE CAST: chibi rigs, anime eyes, own outfits and palettes; the hero's cape is SECONDARY MOTION\n120\t  const RIGS = {\n121\t    hero: () => new E.Humanoid({ size: 1.3, outfit: 'tunic', hair: 'spiky', face: { eyes: 'big', bangs: .8 }, cape: { len: 4, width: 3.2, seg: 2.2 },\n122\t      colors: { skin: '#f8cca4', hair: '#e8902c', cloth: '#3a8a4a', trim: '#f0d070', pants: '#4a3a5a', boot: '#8a4a26', belt: '#6a3a1a', glove: '#7a5238', eye: '#3a2a6a', cape: '#d0483a', capeIn: '#7a1e2e' } }),\n123\t    elder: () => new E.Humanoid({ size: 1.2, weapon: 'staff', outfit: 'robe', hair: 'short', sleeves: 'long', hunch: .45, hat: { style: 'pointed', color: '#3e3278' }, face: { eyes: 'big', bangs: .35 },\n124\t      colors: { skin: '#f0c4a8', hair: '#b8b2c4', cloth: '#5a4a9a', trim: '#f0cc60', belt: '#f0cc60', boot: '#4a3a2a', eye: '#2a2a4a' } }),\n125\t    florist: () => new E.Humanoid({ size: 1.15, weapon: null, outfit: 'robe', sleeves: 'long', hair: 'ponytail', face: { eyes: 'big', bangs: 1 },\n126\t      colors: { skin: '#f8cca4', hair: '#b0482a', cloth: '#d86a8a', trim: '#f4a8c0', belt: '#fff0d0', pants: '#d86a8a', boot: '#6a3a2a', eye: '#2a5a3a' } }),\n127\t    villager: () => new E.Humanoid({ size: 1.1, weapon: null, hair: 'short', hat: { style: 'band', color: '#d8483a' }, face: { eyes: 'big', bangs: .7 }, shoulderHalf: 4.6, armUpper: 5.2, armLower: 5,   // the wave clears his face\n128\t      colors: { skin: '#f0c090', hair: '#6a3a1e', cloth: '#e8a83a', trim: '#fff0d0', pants: '#4a5a8a', boot: '#6a4a2a', belt: '#6a4a2a', eye: '#2a3a5a' } }),\n129\t    goblin: () => new E.Humanoid({ size: 1.1, build: 'bulky', weapon: null, outfit: 'tunic', hair: 'bald', eyeGlow: '#ffd84a',\n130\t      colors: { skin: '#8ab84a', cloth: '#8a5a32', trim: '#c8a040', pants: '#4a3a2a', boot: '#3a2a1a', belt: '#3a2a1a' } }),\n131\t    mage: () => new E.Humanoid({ size: 1.3, build: 'heroic', weapon: 'staff', outfit: 'robe', hood: true, sleeves: 'long', eyeGlow: '#ff6ab0',\n132\t      colors: { skin: '#c8b8e0', hair: '#2e2450', cloth: '#4a3a86', trim: '#d070f0', belt: '#d070f0', boot: '#1a1628', orb: '#ff80e0' } })\n133\t  };\n134\t  // BLOB CREATURES: a round body plus parts\n135\t  const RABITE = { dk: '#b0703a', base: '#f4d49a', lt: '#fff4dc', pupil: '#5a1a2a', inner: '#f09aa8', ext: '#d8a060' };\n136\t  const BAT = { dk: '#2e1a44', base: '#6a4a9a', lt: '#a890d0', eye: '#fff0a0', pupil: '#c02020', wing: '#4a2a6a', inner: '#e08aa0' };\n137\t  const CAT = { dk: '#9a5028', base: '#f0a050', lt: '#ffd8a0', pupil: '#2a4a1a', inner: '#f8b0b0', ext: '#fff0e0' };\n138\t  const FOES = {   // hp (a hit does 8-12), look, moves (E.MOVES with a long, deep wind-up: the TELL)\n139\t    rabite: { hp: 18, look: () => new E.Blob({ R: 5.5, colors: RABITE, ears: 'rabbit', feet: true, tail: true, mouth: true, face: 'front' }) },\n140\t    bat: { hp: 12, fly: 17, look: () => new E.Blob({ R: 4.5, colors: BAT, wings: true, ears: 'cat', mouth: 'fangs', face: 'front' }) },\n141\t    goblin: { hp: 40, look: RIGS.goblin, moves: ['claw', 'twohand'], tune: { wind: .34, crouch: 1, lean: .9 } },   // a raking claw, a two-fist SLAM\n142\t    mage: { hp: 30, look: RIGS.mage, moves: ['cast'], tune: { wind: .6, lean: .6 } }   // leans back to raise, recoils forward to release\n143\t  };\n144\t  // spins at the waist; CHARGE: the spin's wind-up, deeper\n145\t  const WAIST = { z0: -10, z1: -10 }, CHARGE = { ...E.MOVES.spin, ...WAIST, a0: 2.4, crouch: .6, lean: .6 };\n146\t  // idle: poses in turn; near: turn to the hero (wave: say hello); talk: gestures; chore: a move while kneeling\n147\t  const NPCS = {\n148\t    elder: { name: 'ELDER', idle: [null, null, 'hips'], near: 56, talk: ['block', null, 'hips', null], lines: [() => 'Rabites overran the Mossy Ruins across the river. Press ' + game.input.label('attack') + ' to swing your sword and clear them out!',\n149\t      'Clear the ruins and the old chest opens. The Mana crystal sleeps in the shrine behind the great door.'] },\n150\t    florist: { name: 'LISE', face: Math.PI, idle: ['kneel', 'kneel', null], near: 36, talk: ['hips', 'cast'],   // tends the flower bed\n151\t      chore: () => new E.Attack('plunge', { hand: 'both', a0: -.5, a1: -.9, r0: 4, r1: 9, wind: .3, active: .16, recover: .45 }),\n152\t      lines: ['A rabite got into my garden again! Could you shoo it away?', 'Mind the bats in the ruins. They swoop when you get close!'] },\n153\t    villager: { name: 'PIP', idle: [null, 'hips'], near: 50, wave: true, talk: ['hips', null], lines: ['Hi! The bridge leads to the Mossy Ruins.', () => 'Keep ' + game.input.label('attack') + ' held after a swing, then let go: a SPIN ATTACK!'] }   // a function: the player's own key\n154\t  };\n155\t  // BACKDROP (iso view): a sea of clouds\n156\t  const bg = new E.Backdrop({ sky: ['#3a74c8', '#8ac2ea', '#e4f2f4', '#9ccae6', '#5a90c8'], layers: [{ kind: 'clouds', color: '#ffffff', y: .3, height: .16, parallax: .04, drift: 3 },\n157\t    { kind: 'clouds', color: '#ffffff', y: .98, height: .4, parallax: .1, drift: 3, seed: 9 }] });\n158\t  let map, relic, entry, hero, npcs, foes, pets, items, things, roofs, shots, talk, speaker, won, keys, gems, area, held, fx;\n159\t  // CAMERA, the player's choice: 'rooms' slides screen by screen (Zelda), 'scroll' follows the hero (Settings, or C)\n160\t  game.settings.define({ key: 'advCamera', group: 'Adventure', label: 'Camera', options: [['rooms', 'Rooms'], ['scroll', 'Scroll']], value: 'rooms', help: 'Rooms: screen by screen, as Zelda. Scroll: it follows the hero' });\n161\t  // LIGHTING: GPU lights (pools of light and shadows, WebGPU) draw every frame twice and light each pixel: a phone's frame\n162\t  // rate pays for them, so Auto keeps them for a computer (its main pointer a mouse or touchpad) and a phone gets Fast (the\n163\t  // floor is lit already): the main pointer, as a phone with a stylus has a fine one too\n164\t  const gpuWanted = () => game.settings.advLight === 'gpu' || (game.settings.advLight === 'auto' && !!(window.matchMedia && matchMedia('(pointer: fine)').matches));\n165\t  const lighting = () => { if (!map) return; if (gpuWanted() && !gpu) gpu = game.enableGPU({ map }); if (gpu) Object.assign(gpu, { map, enabled: gpuWanted(), bands: 24, wrap: .5 }); };\n166\t  game.settings.define({ key: 'advLight', group: 'Adventure', label: 'Lighting', options: [['auto', 'Auto'], ['gpu', 'GPU'], ['fast', 'Fast']], value: 'auto', help: 'GPU: pools of light and shadows (slow on a phone). Fast: smooth on a phone. Auto: GPU on a computer, Fast on a phone', apply: () => { if (game.sceneName === 'adventure') lighting(); } });\n167\t  addEventListener('keydown', e => { if (e.code !== 'KeyC' || e.repeat || game.sceneName !== 'adventure' || game.paused) return; const v = game.settings.advCamera === 'rooms' ? 'scroll' : 'rooms'; game.settings.set('advCamera', v); game.note('CAMERA: ' + v.toUpperCase()); });\n168\t  const sliding = () => !!game.cam.room && game.cam.moving;   // a room slide holds the world still\n169\t  const roomOf = x => Math.floor(x / ROOM[0]), mod = (a, n) => ((a % n) + n) % n, near = (cx, cy, tag) => map.floorAt((cx + .5) * T, (cy + .5) * T) === tag;\n170\t  const txt = (g, s, x, y, c, o) => E.font.text(g, s, x, y, c, { shadow: '#07040c', outline: false, ...o });\n171\t  const talkable = () => npcs.find(n => E.dist(hero, n) < 34);\n172\t  // CONTACT SHADOWS: a darker core in a soft ellipse, cool purple\n173\t  const shadow = (r, x, y, rad) => { r.shadow(x, y, rad, .28, '#2a2048'); r.shadow(x, y, rad * .6, .22, '#2a2048'); };\n174\t\n175\t  /* ---- FLOORS: floorTex(x, y, tag) = [r, g, b(, glow)], baked once per view ---- */\n176\t  // AUTOTILING: distance to the nearest side bordering another floor, corners rounded by K\n177\t  function edge(cx, cy, lx, ly, tag, K) {\n178\t    const o = (dx, dy) => { const t = map.floorAt((cx + dx + .5) * T, (cy + dy + .5) * T), c = map.cell(cx + dx, cy + dy); return tag === 'water' ? t !== tag && t !== 'bridge' && !c : t !== tag || c !== 0; };\n179\t    const a = Math.min(o(-1, 0) ? lx : 99, o(1, 0) ? T - lx : 99), b = Math.min(o(0, -1) ? ly : 99, o(0, 1) ? T - ly : 99);\n180\t    return a < K && b < K ? K - Math.hypot(K - a, K - b) : Math.min(a, b);\n181\t  }\n182\t  // GRASS: TUFT and BLOOM stamps on a staggered lattice in SCREEN pixels\n183\t  function grass(sx, sy, G) {\n184\t    const row = Math.floor(sy / 7), X = sx + (row & 1) * 6, k = E.hash2(Math.floor(X / 12), row), pat = k < .07 ? BLOOM : k < .62 ? TUFT : null;\n185\t    const ch = pat && (pat[mod(Math.floor(sy), 7) - 2] || '')[mod(Math.floor(X), 12) - (pat === BLOOM ? 5 : 4)];\n186\t    return ch === 'l' ? G[3] : ch === 'd' ? G[1] : ch === 'y' ? PETAL[1] : ch === 'w' ? PETAL[k < .035 ? 0 : 2] : G[2];\n187\t  }\n188\t  function ground(x, y, tag) {\n189\t    const cx = Math.floor(x / T), cy = Math.floor(y / T), lx = x - cx * T, ly = y - cy * T, room = roomOf(x), [sx, sy] = game.view.p(x, y), h = E.hash2(cx, cy);\n190\t    const e = tag && tag !== 'carpet' ? edge(cx, cy, lx, ly, tag, tag === 'water' ? 7 : tag === 'pave' ? 1 : 4) : 99;\n191\t    if (e < 0) tag = null;   // outside a rounded corner\n192\t    // WATER: bank, lip, shadow, reflection, foam, then depth BANDS bent by value noise\n193\t    if (tag === 'water') {\n194\t      if (e < 2.6) return e < 1 ? STONE[0] : E.hash2(Math.floor(y / 3), cx) < .2 ? STONE[1] : STONE[e < 1.8 ? 4 : 3];\n195\t      const w = (E.noise2(x / 6, y / 9) - .5) * 5, foam = near(cx, cy - 1, 'bridge') ? ly : near(cx, cy + 1, 'bridge') ? T - ly : 99;\n196\t      if (e < 3.3 || foam < 3 + w + E.hash2(Math.floor(sx / 2), 1) * 2) return foam < 1.5 + w ? SKY[1] : WATER[4];\n197\t      if (!near(cx - 1, cy, 'water') && lx < 6 + w) return WATER[0];\n198\t      if (map.cell(cx + 1, cy) > 0 && lx > 11 + w) return REFLECT;\n199\t      const px_ = lx - 4 - h * 8, py_ = ly - 4 - h * 7, pad = Math.hypot(px_, py_);\n200\t      if (h < .3 && pad < 3) return LILY[pad < 1 ? 4 : px_ > .5 && Math.abs(py_) < .5 ? 1 : 2];\n201\t      const k = mod(Math.floor(sx) + Math.floor(sy / 6) * 7, 23);   // sky glints on every 6th row\n202\t      return mod(Math.floor(sy), 6) === 0 && k < 4 ? SKY[k ? 0 : 1] : WATER[e + w < 8 ? 3 : e + w < 12 ? 2 : 1];\n203\t    }\n204\t    if (tag === 'bridge') return (ly < 2 && !near(cx, cy - 1, tag)) || (ly > T - 2 && !near(cx, cy + 1, tag)) ? DIRT[0] : E.tex.planks(y, x, { base: '#b07c44', dark: '#8a5c32', line: '#4a2e1a' });\n205\t    // path and paving: grass erodes the edge by a hash; dirt, pebbles\n206\t    const q = E.hash2(Math.floor(sx / 6), Math.floor(sy / 5)), b = E.hash2(Math.floor(x / 4), Math.floor(y / 4)) * 3;\n207\t    if (tag === 'path') return e < b ? grass(sx, sy, GRASS[room][1]) : e < b + .9 ? DIRT[0] : q < .16 && mod(Math.floor(sx), 6) < 2 && mod(Math.floor(sy), 5) === 0 ? DIRT[q < .07 ? 4 : 1] : DIRT[e < b + 1.8 ? 1 : 2];\n208\t    if (tag === 'plaza') return e < .9 ? PLAZA.mortar : E.tex.flagstone(x, y, PLAZA, 8);\n209\t    if (tag === 'bed') return e < 1 ? STONE[0] : e < 2.4 ? STONE[3] : SOIL[mod(ly, 4) < 1 ? 0 : 2];\n210\t    const c = Math.min(near(cx - 1, cy, tag) ? 99 : lx, near(cx + 1, cy, tag) ? 99 : T - lx), m = Math.abs(mod(x, 32) - 16) + Math.abs(ly - 8);   // carpet\n211\t    if (tag === 'carpet') return c < 1 ? CARPET[0] : c >= 2 && c < 3 ? GOLD[1] : m > 5 && m < 6.5 ? GOLD[0] : m < 2.5 ? GOLD[2] : CARPET[1];\n212\t    const f = E.tex.flagstone(x, y, PAVE);   // paving: moss in the seams\n213\t    if (tag === 'pave') return e < b ? grass(sx, sy, GRASS[1][1]) : e < b + .9 ? PAVE.mortar : f === PAVE.mortar && E.hash2(Math.floor(x / 6), Math.floor(y / 6)) < .45 ? GRASS[1][1][1] : f;\n214\t    const n = E.noise2(x / 40 + room * 9, y / 40);   // lawn: three shades in slow patches\n215\t    if (room < 2) return grass(sx, sy, GRASS[room][n < .36 ? 0 : n > .64 ? 2 : 1]);\n216\t    const dr = Math.hypot(x - relic.x, y - relic.y), a = Math.atan2(y - relic.y, x - relic.x), P = TILE[(cx + cy) & 1];\n217\t    if (Math.abs(dr - 15) < .7 || Math.abs(dr - 10.5) < .6 || (dr > 11 && dr < 14.5 && Math.abs(mod(a / Math.PI * 4, 1) - .5) < .06)) return RUNE;   // shrine: a rune circle...\n218\t    if (dr < 26) return dr > 24.8 ? TILE[1][0] : dr > 23.2 ? TILE[0][4] : TILE[dr < 20 ? 1 : 0][2];   // ...on a round dais with a lit rim...\n219\t    if (Math.min(lx, ly) < 1.2) return P[lx < .8 || ly < .8 ? 0 : 4];   // ...on marble tiles\n220\t    return lx > T - 1.2 || ly > T - 1.2 ? P[1] : mod(lx + ly, 13) < 1 ? P[3] : P[2];\n221\t  }\n222\t  // PAINTED LIGHT (Legend of Mana): a wall taller than its distance toward the low sun shades a point cool purple\n223\t  const SHADE = [.64, .68, .86];\n224\t  function floorTex(x, y, tag) {\n225\t    const c = ground(x, y, tag);\n226\t    for (let d = 2; d < 18; d += 2) if (map.heightAt(x - d, y - d * .3) > d * 1.8) return c.map((v, i) => i < 3 ? v * SHADE[i] : v);\n227\t    return c;\n228\t  }\n229\t\n230\t  // trees and pines varied by hashes\n231\t  const tree = (cx, cy, pine) => { const v = E.hash2(cx * 5, cy * 3); return { prop: pine || v > .72 ? 'pine' : 'tree', size: 1 + v * .45, color: ['#2f7a3c', '#3f8a45', '#2a6a44', '#4a8a3a'][Math.floor(v * 4)], x: (cx + .3 + E.hash2(cy, cx) * .4) * T }; };\n232\t  function start() {\n233\t    map = new E.TileMap({ rows: ROWS, legend: LEGEND, types: TYPES, floorTex, ao: 8 });\n234\t    relic = map.find('relic'); entry = map.find('entry'); relic.x += T / 2; entry.x += T / 2;   // on the room's center line\n235\t    // the camera stays inside the map (the forest round the rooms fills a tall screen); update() sets rooms or scroll\n236\t    game.cam.bounds = v => { const b = map.bounds(v); return { x0: b.x0 + 9, y0: b.y0 + 9, x1: b.x1 - 9, y1: b.y1 - 9 }; }; game.cam.room = game.settings.advCamera === 'scroll' ? null : ROOM;\n237\t    const at = map.find('hero');\n238\t    // SWORD (Secret of Mana): J chains slash, backslash, spin, kept low (a raised blade crosses his face); short holds (hold)\n239\t    // let the follow-through settle instead of freezing; hold J to CHARGE\n240\t    hero = Object.assign(new E.Body({ ...at, r: 4.5 }), { hp: 3, max: 3, facing: Math.PI / 2, inv: 0, hurt: 0, charge: 0, rig: RIGS.hero(),\n241\t      combo: new E.Combo([new E.Attack('slash', { z0: -8, z1: -11, a1: -1.2, wind: .12, hold: .1 }), new E.Attack('backslash', { z0: -11, z1: -9, a1: 1.2, hold: .1 }), new E.Attack('spin', { ...WAIST, hold: .15 })], { window: .3 }),\n242\t      spin: new E.Attack('spin', { ...WAIST, active: .36, reach: 10, lean: .3, hold: .12 }) });\n243\t    hero.sw = hero.combo;   // the attack running now\n244\t    npcs = Object.keys(NPCS).map(k => { const n = Object.assign({ said: 0, t: 0, k: 0, hi: 0, nod: 0, face: Math.PI / 2, rig: RIGS[k]() }, map.find(k), NPCS[k]); n.dir = n.look = n.face; n.job = n.chore && n.chore(); return n; });\n245\t    things = [];\n246\t    for (const s of map.spawns) for (const d of [].concat(s.tag === 'tree' ? tree(s.cx, s.cy) : THINGS[s.tag] || []))\n247\t      things.push(Object.assign({ tag: s.tag, prop: s.tag, x: s.x + (d.dx || 0), y: s.y, room: roomOf(s.x) }, d));\n248\t    // one pass over the cells: roofs, pines, weeds, flower beds, bridge rails, tufts\n249\t    const box = {};\n250\t    for (let cy = 0; cy < map.h - 1; cy++) for (let cx = 0; cx < map.w; cx++) {\n251\t      const c = map.cell(cx, cy), v = E.hash2(cx * 3, cy * 7 + 1), X = (cx + .5) * T, Y = (cy + .5) * T, tag = map.floorAt(X, Y), add = o => things.push(Object.assign({ x: X, y: Y }, o));\n252\t      if (c === 5 || c === 8) { const b = box[c] || (box[c] = [cx, cy, cx, cy]); b[2] = cx; b[3] = cy; }\n253\t      if (map.spawns.some(s => s.cx === cx && s.cy === cy)) continue;\n254\t      if (c === 9 && cy === PAD && v < .5) add(tree(cx, cy, true));\n255\t      else if ((c === 3 || c === 4) && v < .45) add({ prop: 'bush', size: .7 + v * .6, color: '#5a8a44' });\n256\t      else if (tag === 'bed') {\n257\t        for (const k of [-3, 3]) add({ prop: 'flowers', size: 1.1, x: X + k, y: Y + k, color: k < 0 ? ['#f06a9a', '#f0a040', '#ffffff'][cx % 3] : '#8ab0ff', color2: '#fff4a0' });\n258\t        if (!near(cx, cy + 1, 'bed')) add({ prop: 'fence', size: 1.2, y: Y + 8, color: '#b08050' });\n259\t      }\n260\t      else if (tag === 'bridge') for (const s of [-1, 1]) { if (!near(cx, cy + s, 'bridge')) add({ prop: 'fence', size: 1.2, y: Y + s * 7, color: '#8a5a32' }); }\n261\t      else if (!c && !tag && X < 2 * ROOM[0] && v < .16) add({ prop: v < .06 ? 'flowers' : 'grass', x: X + (E.hash2(cx, cy) - .5) * 10, y: Y + (E.hash2(cy, cx) - .5) * 8,\n262\t        color: v < .06 ? '#f06a9a' : X > ROOM[0] ? '#5a9a4a' : '#6ab850', color2: '#fff4a0' });\n263\t    }\n264\t    roofs = Object.keys(box).map(id => { const [a, b, c, d] = box[id]; return { x0: a * T, y0: b * T, x1: (c + 1) * T, y1: (d + 1) * T, h: TYPES[id].h, C: E.ramp(TYPES[id].top, 5) }; });\n265\t    items = [{ kind: 'relic', x: relic.x, y: relic.y }];\n266\t    // bats roost (hang; wake = time since); stun = flinch; dying = death; streak = claw marks; hold = an impact frame\n267\t    foes = Object.keys(FOES).flatMap(k => map.findAll(k)).map(s => { const F = FOES[s.tag], moves = (F.moves || []).map(m => new E.Attack(m, { recover: .45, hold: .5, ...F.tune }));\n268\t      return Object.assign(new E.Body({ ...s, r: 5.5, friction: 6, ...(F.fly && { z: F.fly + 8, gravity: 0, onGround: false }) }), { kind: s.tag, hp: F.hp, fly: F.fly, hang: !!F.fly, home: { ...s },\n269\t        t: 1 + Math.random(), flash: 0, stun: 0, swoop: 0, wake: 9, streak: [], face: Math.PI / 2, room: roomOf(s.x), look: F.look(), moves, atk: moves[0] }); });\n270\t    pets = map.findAll('cat').map(s => Object.assign(new E.Body({ ...s, r: 4 }), { t: 1, home: { ...s }, look: new E.Blob({ R: 4, colors: CAT, ears: 'cat', tail: true, feet: true, mouth: true, face: 'front' }) }));\n271\t    shots = new E.Bullets(game, { plane: 'ground' }); talk = new E.Dialog(game, WIN);\n272\t    fx = []; won = false; keys = 0; gems = 0; area = { room: 0, t: 2.6 }; held = null;\n273\t    // the floor is lit already; GPU lighting (if any) adds light pools and shadows\n274\t    L.enabled = false; lighting(); mood(MOOD[0]); A.music('adventure');\n275\t    game.input.touchSet('attack', 'SWORD');\n276\t  }\n277\t  // DIALOG: E.Dialog types and pages; portrait: a live close-up of the speaker\n278\t  const say = (who, name, text) => { speaker = who; talk.say(typeof text === 'function' ? text() : text, { name, portrait: who.rig, portraitSize: 50, portraitOpts: { zoom: 2.6, turn: -.25, cape: false, bg: FACE_BG } }); };   // (at the bottom, clear of the touch buttons)\n279\t  function hurtHero(ang) {   // flinch, knockback, blink; true if it hurt\n280\t    if (hero.inv > 0 || won || hero.hp <= 0) return false; hero.hp -= .5; hero.inv = 1; hero.hurt = .25; hero.charge = 0; hero.combo.cancel(); hero.spin.cancel(); hero.push(Math.cos(ang) * 160, Math.sin(ang) * 160);\n281\t    game.hitFx(hero.x + Math.cos(ang) * 3, hero.y + Math.sin(ang) * 3, 12, { power: .9, angle: ang + Math.PI, color: '#ff8a6a', sound: 'hurt' }); game.flash('#ff4a3a', .06, .4);\n282\t"}]},"parent_tool_use_id":null,"session_id":"4180323d-f450-4e8c-b0bc-56f3660fbb67","uuid":"e111b28f-b077-47a5-b0c9-84dbab5d418b","timestamp":"2026-11-03T01:16:55.476Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium--20261102-181325--xe8b2f0-work/4180323d-f450-4e8c-b0bc-56f3660fbb67/tool-results/bzvdbg4r6.txt","content":"    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 1  ADVENTURE  (Secret of Mana, Zelda: ALttP). Three rooms: village, ruins, shrine. Talk, clear the ruins for\n * the key, open the great door, claim the crystal. THE LOOK: wall MATERIALS, ONE floorTex with PAINTED LIGHT, pitched\n * roofs, leaf-clump bushes, light shafts, dialog PORTRAITS.\n * KEYS: WASD or arrows move, J or X swings the sword, Enter or Space talks. TOUCH: the stick, ATTACK, CONFIRM.\n * ANY SCREEN: rooms are 4:3 in a world that goes on past them (forest above and below, the next rooms beside), so a\n * screen of any shape is filled. CAMERA (Settings, or C): ROOMS slides screen by screen as Zelda's does, the rooms beside\n * this one under a dim CURTAIN (they wait, as their monsters do); SCROLL follows the hero. The HUD sits in the corners.\n * ===================================================================================== */\nconst ADV = (() => {\n  const T = 16, ROOM = [14 * T, 12 * T], AREAS = ['Mana Village', 'Mossy Ruins', 'Shrine of Mana'];\n  const ROWS = [\n    // village          ruins             shrine\n    ['^^^^^^^^^^^^^^', 'RRRRRRRRRRRRRR', 'XXXXXXXXXXXXXX'],\n    ['^^#^^^^^^^^#^^', 'RHhJKFYDYFKhHR', 'XwjiXnWXnXijwX'],\n    ['#UUUU.ZZZZ.~~#', 'R.u..qv.vq.S.R', 'X.S*.B..B.*S.X'],\n    ['#GQOQbzNzZu~~#', 'H.KK....x....H', 'X.....rA.....X'],\n    ['#ccccV~ccLe~~#', 'K..s.q::::.s.H', 'X..I..++..I..X'],\n    ['#cM@cPccac=~~#', 'H.....::::k..K', 'X....m++m....X'],\n    ['#,,,,,,,,,,__,', ',,....::C:...H', 'X4.I..++..I.4X'],\n    ['#.b...b.g,d__,', ',,..o.::::.s.H', 'X.....++.....X'],\n    ['#...%%%f..s~~#', 'Hb.K..::::q.KH', 'X..I..++..I..X'],\n    ['#T..%%%.u..~~#', 'H.u..s....y.RH', 'X.p...++...p.X'],\n    ['#.3........~~#', 'H...bK...b.xRH', 'X.....E+.....X'],\n    ['##############', 'RRRRRRRRRRRRRR', 'XXXXXX++XXXXXX']\n  ].map(r => r.join(''));\n  // the world AROUND the rooms: PAD rows of forest canopy above and below (a meadow's edge first, the shrine's stone under\n  // the shrine), so a screen of any shape is filled. The rooms' rows start at OY\n  const PAD = 12, OY = PAD * T, wood = (cx, cy) => cx >= 28 ? 'X' : E.hash2(cx * 7, cy * 5) < .18 ? '2' : '1';\n  const AROUND = (cy0, meadow) => Array.from({ length: PAD }, (_, i) => Array.from({ length: 42 }, (_, cx) => meadow && i < 2 && cx < 28 ? '.' : wood(cx, cy0 + i)).join(''));\n  ROWS.unshift(...AROUND(0)); ROWS.push(...AROUND(PAD + 12, true));\n  const LEGEND = {\n    // walls: a wall type (TYPES), or { tile, spawn } = a wall with a prop on its face (THINGS)\n    '#': 1, 'U': 5, 'Z': 8, 'R': 9, 'H': 3, 'K': 4, 'F': 6, 'X': 2, 'A': 7, '1': 10, '2': { tile: 10, spawn: 'tree' },\n    '^': { tile: 1, spawn: 'tree' }, 'G': { tile: 5, spawn: 'ivy' }, 'Q': { tile: 5, spawn: 'pane' }, 'O': { tile: 5, spawn: 'door' },\n    'z': { tile: 8, spawn: 'pane' }, 'N': { tile: 8, spawn: 'shop' }, 'h': { tile: 3, spawn: 'vines' }, 'J': { tile: 3, spawn: 'cobweb' }, 'Y': { tile: 6, spawn: 'moss' }, 'D': { tile: 6, spawn: 'gate' },\n    'w': { tile: 2, spawn: 'window' }, 'W': { tile: 2, spawn: 'rose' }, 'i': { tile: 2, spawn: 'torch' }, 'n': { tile: 2, spawn: 'banner' }, 'j': { tile: 2, spawn: 'cobweb' }, 'r': { tile: 7, spawn: 'relic' },\n    // floors: a tag for floorTex; block = not walkable\n    ',': { floor: 'path' }, 'c': { floor: 'plaza' }, '~': { floor: 'water', block: true }, '_': { floor: 'bridge' }, ':': { floor: 'pave' }, '+': { floor: 'carpet' }, '%': { floor: 'bed' },\n    '@': { floor: 'plaza', spawn: 'hero' }, 'M': { floor: 'plaza', spawn: 'elder' }, 'P': { floor: 'plaza', spawn: 'pot' }, 'L': { floor: 'plaza', spawn: 'lamp' },\n    'V': { floor: 'water', block: true, spawn: 'fountain' }, 'C': { floor: 'pave', spawn: 'chest' }, 'E': { floor: 'carpet', spawn: 'entry' }, 'd': { floor: 'path', spawn: 'villager' },\n    // people, creatures and props\n    'f': 'florist', 'a': { floor: 'plaza', spawn: 'cat' }, 's': 'rabite', 'v': 'bat', 'k': 'goblin', 'm': 'mage', 'b': 'bush', 'p': 'pot', 'T': 'oak', 'g': 'sign', 'u': 'mushroom',\n    'e': 'barrel', '=': 'crate', '3': 'stump', '4': 'obelisk', 'q': 'ruin', 'I': 'pillar', 'S': 'statue', 'o': 'rock', 'x': 'crystal', 'y': 'skull', 'B': 'brazier', '*': 'candelabra'\n  };\n  // wall MATERIALS: face = side, roof = top pattern (beam = timber); cut = lowered to cutH in front of the camera\n  const SLAB = { face: 'stone', roof: 'slab' }, TYPES = {\n    1: { h: 16, cut: true, cutH: 7, face: 'hedge', roof: 'leaves', top: '#3f8c3c', side: '#2e6a34' },   // hedge\n    2: { h: 34, cut: true, cutH: 8, ...SLAB, top: '#4e4670', side: '#6a6294', course: 9 },   // shrine stone\n    3: { h: 26, cut: true, cutH: 8, face: 'ruin', roof: 'slab', top: '#7a8a66', side: '#8e8a98' },   // ruin wall, mossy top: the 'ruin' MATERIAL (stones, cracks, moss, dirt; docs/ASSETS.md)\n    4: { h: 12, cut: true, ...SLAB, top: '#72845e', side: '#8e8a98', course: 6 },   // crumbled ruin\n    5: { h: 36, face: 'timber', roof: 'tiles', top: '#c4583a', side: '#f0e0c0', beam: '#6a4228' },   // cottage\n    6: { h: 36, ...SLAB, top: '#5a5480', side: '#7a7298', course: 9 },   // shrine facade\n    7: { h: 9, ...SLAB, top: '#8a84b4', side: '#5a5484', course: 4 },   // altar\n    8: { h: 36, face: 'plaster', roof: 'tiles', top: '#3a7ab4', side: '#f4e6c8' },   // shop\n    9: { h: 30, cut: true, cutH: 8, face: 'rock', roof: 'grass', top: '#5a9a44', side: '#8a7462' },   // cliff\n    10: { h: 22, face: 'hedge', roof: 'leaves', top: '#2c6a36', side: '#1f4a2a' }   // the forest round the rooms\n  };\n  // set dressing: tag -> prop(s). r = solid, cut = breakable (debris), drop = loot, face = on the wall at z (anchor\n  // 'top' hangs it), light = GPU light, dx = nudge, hidden = appears later; shape = a SHAPE (E.SHAPES, docs/ASSETS.md:\n  // right in every view and turn, no drawing code) in place of a prop, size its scale\n  const THINGS = {\n    // village\n    door: [{ face: true, size: 1.1, color: '#7a4222' }, { prop: 'lantern', face: true, z: 33, dx: 14, anchor: 'top', light: '#ffb060' }],\n    shop: [{ prop: 'door', face: true, size: 1.1, color: '#2a4a7a' }, { prop: 'awning', face: true, z: 23, size: .95, color: '#d8483a' }],\n    pane: { prop: 'window', face: true, z: 12, size: .65, color: '#6a4424', colors: ['#fff0b0', '#ffd070'] }, ivy: { prop: 'vines', face: true, z: 35, anchor: 'top', color: '#3a8a3a', blossom: '#f890b0' },\n    fountain: { prop: 'statue', size: .8, color: '#a8a6c0', dx: 8 }, lamp: { prop: 'streetlamp', r: 3, size: .8, halo: false }, oak: { prop: 'tree', size: 1.45, r: 8 },   // lamp: unlit by day\n    bush: { r: 6, cut: ['#2f7a34', '#5ab04a', '#9ad86a'] }, pot: { size: .95, r: 5, cut: ['#7a3a22', '#c07040', '#e8a878'], drop: 'gem' }, sign: { r: 4 },\n    mushroom: { size: .75, color: '#e0503a' }, barrel: { shape: 'barrel', r: 5, size: .75 }, crate: { shape: 'crate', r: 6, size: .65 },\n    // from the asset store, cut into the page's 'adventure' set (src/assets/sets/adventure.js); without it, props\n    ...(E.addAssets((window.ASSETS || {}).adventure || { set: 'adventure' }).shapes.length ? { stump: { shape: 'adventure:stump-round', r: 5, size: .7 },\n      obelisk: { shape: 'adventure:pillar-obelisk', r: 6, size: .8 } } : { stump: { prop: 'rock', r: 5, color: '#8a5a3a' }, obelisk: { prop: 'pillar', r: 6 } }),\n    // ruins\n    vines: { face: true, z: 25, anchor: 'top', color: '#4a8a3a', blossom: '#f890b0' }, moss: { prop: 'vines', face: true, z: 35, anchor: 'top', size: .8, color: '#5a8a3a', blossom: '#f890b0' },\n    gate: { prop: 'door', face: true, size: 1.1, color: '#5a3a6a' }, ruin: { prop: 'pillar', broken: true, r: 7 }, rock: { r: 5, color: '#8a8698' }, skull: { prop: 'bones' },\n    crystal: { r: 4, light: '#5ad8f0' }, chest: { r: 6, hidden: true },\n    // shrine\n    window: { face: true, z: 7, size: .8, colors: ['#e05a6a', '#5a8ae8', '#f0c85a', '#6ad08a'], light: '#8ab0ff' }, torch: { face: true, z: 14, light: '#ff9a4a' },\n    rose: { prop: 'window', face: true, z: 2, size: 1, dx: 8, colors: ['#e8c85a', '#c04aa0', '#5a8ae8'], light: '#c8a0ff' }, banner: { face: true, z: 8, size: .8, color: '#8a1a3a', emblem: '#e8c04a' },\n    cobweb: { face: true, z: 34, anchor: 'top', size: .9 }, pillar: { r: 7 }, statue: { r: 6, color: '#9a98b0' }, brazier: { r: 5, size: .9, light: '#ff9a4a' }, candelabra: { r: 3, size: .8, light: '#ffc060' }\n  };\n  // palettes: E.ramp(hex, n, strength) = n hue-shifted shades, dark to light\n  const rgb = hexes => hexes.map(E.hex), R5 = (c, s = .6) => rgb(E.ramp(c, 5, s)), FLAG = (s, mortar) => ({ stones: s.slice(1, 4), mortar, hi: s[4], lo: s[0], speck: s[1] });\n  const GRASS = [['#4c9a3e', '#5aa640', '#6cb44c'], ['#42804a', '#4a8a48', '#5a9a4e']].map(room => room.map(c => R5(c))), DIRT = R5('#b08652', .7), WATER = R5('#2a7ac4', .9), STONE = R5('#a49a8a', .7), SOIL = R5('#6e4a34');\n  const PLAZA = FLAG(R5('#b4a894'), E.hex('#6a5e52')), PAVE = FLAG(R5('#8a8a96'), E.hex('#3a3a3e')), TILE = [R5('#5a5688'), R5('#403c68')], PETAL = rgb(['#ffffff', '#ffe070', '#f890b0']);\n  const CARPET = rgb(E.ramp('#9a2438', 4)), GOLD = rgb(E.ramp('#d8a840', 3)), RUNE = [...E.hex('#6ae8e0'), .35], LILY = R5('#4aa050');   // 4th value = GPU glow\n  const SKY = rgb(['#a8dcf4', '#e8f8ff']), REFLECT = E.hex('#1e5a5a');   // sky glints, the hedge's reflection\n  const TUFT = ['.l.l.', '.dld.', '..d..'], BLOOM = ['.w.', 'wyw', '.w.'];   // grass stamps\n  const MOOD = [[.92, .9, .84], [.8, .88, .8], [.34, .3, .46]];   // GPU ambient light per room\n  const mood = m => { if (gpu) gpu.ambient = m; L.ambient = (m[0] + m[1] + m[2]) / 3; };   // (and the canvas lighting's, where WebGPU is missing and it stands in)\n  // light shafts per room: beam x, tint (a dark tint = a faint beam), lean\n  const BEAMS = [[[34, 128, 196], '#7a5a26', 60], [[50, 150], '#566a22', 60], [[24, 120, 200], '#4a3a8a', 12]];\n  const WIN = { bg: ['#3a4a9e', '#12163e'], border: '#f0e0a8' }, FACE_BG = ['#7aa4e8', '#1e2a66'];\n  // pixel sprites ('.' = transparent)\n  const GEM = E.sprite(['..g..', '.gGg.', 'gGWGg', 'gGGGg', 'dgGgd', '.dgd.', '..d..'], { g: '#1e9a3a', G: '#56e070', W: '#e8fff0', d: '#0e5a24' });\n  const HEART = E.sprite(['.R.R.', 'RWRRR', 'RRRRR', '.RRR.', '..R..'], { R: '#e8384a', W: '#ffd0d6' });\n  const KEYS = [1, 2].map(s => E.sprite(['.yy....', 'y..y...', 'Y..Yyyy', '.YY..y.', '.....yY'], { y: '#f8d048', Y: '#b07818' }, s));   // scale 2: held up high\n  const CRYSTALS = [1, 2].map(s => E.sprite(['....w....', '...wWc...', '..wWWcc..', '.wWWWccC.', 'wWWWccccC', '.wWWcccC.', '.cWWccCC.', '..cWcCC..', '..ccCC...', '...cC....'], { w: '#f0ffff', W: '#a8f0ff', c: '#4ac8e8', C: '#2a5ab0' }, s));\n\n  // THE CAST: chibi rigs, anime eyes, own outfits and palettes; the hero's cape is SECONDARY MOTION\n  const RIGS = {\n    hero: () => new E.Humanoid({ size: 1.3, outfit: 'tunic', hair: 'spiky', face: { eyes: 'big', bangs: .8 }, cape: { len: 4, width: 3.2, seg: 2.2 },\n      colors: { skin: '#f8cca4', hair: '#e8902c', cloth: '#3a8a4a', trim: '#f0d070', pants: '#4a3a5a', boot: '#8a4a26', belt: '#6a3a1a', glove: '#7a5238', eye: '#3a2a6a', cape: '#d0483a', capeIn: '#7a1e2e' } }),\n    elder: () => new E.Humanoid({ size: 1.2, weapon: 'staff', outfit: 'robe', hair: 'short', sleeves: 'long', hunch: .45, hat: { style: 'pointed', color: '#3e3278' }, face: { eyes: 'big', bangs: .35 },\n      colors: { skin: '#f0c4a8', hair: '#b8b2c4', cloth: '#5a4a9a', trim: '#f0cc60', belt: '#f0cc60', boot: '#4a3a2a', eye: '#2a2a4a' } }),\n    florist: () => new E.Humanoid({ size: 1.15, weapon: null, outfit: 'robe', sleeves: 'long', hair: 'ponytail', face: { eyes: 'big', bangs: 1 },\n      colors: { skin: '#f8cca4', hair: '#b0482a', cloth: '#d86a8a', trim: '#f4a8c0', belt: '#fff0d0', pants: '#d86a8a', boot: '#6a3a2a', eye: '#2a5a3a' } }),\n    villager: () => new E.Humanoid({ size: 1.1, weapon: null, hair: 'short', hat: { style: 'band', color: '#d8483a' }, face: { eyes: 'big', bangs: .7 }, shoulderHalf: 4.6, armUpper: 5.2, armLower: 5,   // the wave clears his face\n      colors: { skin: '#f0c090', hair: '#6a3a1e', cloth: '#e8a83a', trim: '#fff0d0', pants: '#4a5a8a', boot: '#6a4a2a', belt: '#6a4a2a', eye: '#2a3a5a' } }),\n    goblin: () => new E.Humanoid({ size: 1.1, build: 'bulky', weapon: null, outfit: 'tunic', hair: 'bald', eyeGlow: '#ffd84a',\n      colors: { skin: '#8ab84a', cloth: '#8a5a32', trim: '#c8a040', pants: '#4a3a2a', boot: '#3a2a1a', belt: '#3a2a1a' } }),\n    mage: () => new E.Humanoid({ size: 1.3, build: 'heroic', weapon: 'staff', outfit: 'robe', hood: true, sleeves: 'long', eyeGlow: '#ff6ab0',\n      colors: { skin: '#c8b8e0', hair: '#2e2450', cloth: '#4a3a86', trim: '#d070f0', belt: '#d070f0', boot: '#1a1628', orb: '#ff80e0' } })\n  };\n  // BLOB CREATURES: a round body plus parts\n  const RABITE = { dk: '#b0703a', base: '#f4d49a', lt: '#fff4dc', pupil: '#5a1a2a', inner: '#f09aa8', ext: '#d8a060' };\n  const BAT = { dk: '#2e1a44', base: '#6a4a9a', lt: '#a890d0', eye: '#fff0a0', pupil: '#c02020', wing: '#4a2a6a', inner: '#e08aa0' };\n  const CAT = { dk: '#9a5028', base: '#f0a050', lt: '#ffd8a0', pupil: '#2a4a1a', inner: '#f8b0b0', ext: '#fff0e0' };\n  const FOES = {   // hp (a hit does 8-12), look, moves (E.MOVES with a long, deep wind-up: the TELL)\n    rabite: { hp: 18, look: () => new E.Blob({ R: 5.5, colors: RABITE, ears: 'rabbit', feet: true, tail: true, mouth: true, face: 'front' }) },\n    bat: { hp: 12, fly: 17, look: () => new E.Blob({ R: 4.5, colors: BAT, wings: true, ears: 'cat', mouth: 'fangs', face: 'front' }) },\n    goblin: { hp: 40, look: RIGS.goblin, moves: ['claw', 'twohand'], tune: { wind: .34, crouch: 1, lean: .9 } },   // a raking claw, a two-fist SLAM\n    mage: { hp: 30, look: RIGS.mage, moves: ['cast'], tune: { wind: .6, lean: .6 } }   // leans back to raise, recoils forward to release\n  };\n  // spins at the waist; CHARGE: the spin's wind-up, deeper\n  const WAIST = { z0: -10, z1: -10 }, CHARGE = { ...E.MOVES.spin, ...WAIST, a0: 2.4, crouch: .6, lean: .6 };\n  // idle: poses in turn; near: turn to the hero (wave: say hello); talk: gestures; chore: a move while kneeling\n  const NPCS = {\n    elder: { name: 'ELDER', idle: [null, null, 'hips'], near: 56, talk: ['block', null, 'hips', null], lines: [() => 'Rabites overran the Mossy Ruins across the river. Press ' + game.input.label('attack') + ' to swing your sword and clear them out!',\n      'Clear the ruins and the old chest opens. The Mana crystal sleeps in the shrine behind the great door.'] },\n    florist: { name: 'LISE', face: Math.PI, idle: ['kneel', 'kneel', null], near: 36, talk: ['hips', 'cast'],   // tends the flower bed\n      chore: () => new E.Attack('plunge', { hand: 'both', a0: -.5, a1: -.9, r0: 4, r1: 9, wind: .3, active: .16, recover: .45 }),\n      lines: ['A rabite got into my garden again! Could you shoo it away?', 'Mind the bats in the ruins. They swoop when you get close!'] },\n    villager: { name: 'PIP', idle: [null, 'hips'], near: 50, wave: true, talk: ['hips', null], lines: ['Hi! The bridge leads to the Mossy Ruins.', () => 'Keep ' + game.input.label('attack') + ' held after a swing, then let go: a SPIN ATTACK!'] }   // a function: the player's own key\n  };\n  // BACKDROP (iso view): a sea of clouds\n  const bg = new E.Backdrop({ sky: ['#3a74c8', '#8ac2ea', '#e4f2f4', '#9ccae6', '#5a90c8'], layers: [{ kind: 'clouds', color: '#ffffff', y: .3, height: .16, parallax: .04, drift: 3 },\n    { kind: 'clouds', color: '#ffffff', y: .98, height: .4, parallax: .1, drift: 3, seed: 9 }] });\n  let map, relic, entry, hero, npcs, foes, pets, items, things, roofs, shots, talk, speaker, won, keys, gems, area, held, fx;\n  // CAMERA, the player's choice: 'rooms' slides screen by screen (Zelda), 'scroll' follows the hero (Settings, or C)\n  game.settings.define({ key: 'advCamera', group: 'Adventure', label: 'Camera', options: [['rooms', 'Rooms'], ['scroll', 'Scroll']], value: 'rooms', help: 'Rooms: screen by screen, as Zelda. Scroll: it follows the hero' });\n  // LIGHTING: GPU lights (pools of light and shadows, WebGPU) draw every frame twice and light each pixel: a phone's frame\n  // rate pays for them, so Auto keeps them for a computer (its main pointer a mouse or touchpad) and a phone gets Fast (the\n  // floor is lit already): the main pointer, as a phone with a stylus has a fine one too\n  const gpuWanted = () => game.settings.advLight === 'gpu' || (game.settings.advLight === 'auto' && !!(window.matchMedia && matchMedia('(pointer: fine)').matches));\n  const lighting = () => { if (!map) return; if (gpuWanted() && !gpu) gpu = game.enableGPU({ map }); if (gpu) Object.assign(gpu, { map, enabled: gpuWanted(), bands: 24, wrap: .5 }); };\n  game.settings.define({ key: 'advLight', group: 'Adventure', label: 'Lighting', options: [['auto', 'Auto'], ['gpu', 'GPU'], ['fast', 'Fast']], value: 'auto', help: 'GPU: pools of light and shadows (slow on a phone). Fast: smooth on a phone. Auto: GPU on a computer, Fast on a phone', apply: () => { if (game.sceneName === 'adventure') lighting(); } });\n  addEventListener('keydown', e => { if (e.code !== 'KeyC' || e.repeat || game.sceneName !== 'adventure' || game.paused) return; const v = game.settings.advCamera === 'rooms' ? 'scroll' : 'rooms'; game.settings.set('advCamera', v); game.note('CAMERA: ' + v.toUpperCase()); });\n  const sliding = () => !!game.cam.room && game.cam.moving;   // a room slide holds the world still\n  const roomOf = x => Math.floor(x / ROOM[0]), mod = (a, n) => ((a % n) + n) % n, near = (cx, cy, tag) => map.floorAt((cx + .5) * T, (cy + .5) * T) === tag;\n  const txt = (g, s, x, y, c, o) => E.font.text(g, s, x, y, c, { shadow: '#07040c', outline: false, ...o });\n  const talkable = () => npcs.find(n => E.dist(hero, n) < 34);\n  // CONTACT SHADOWS: a darker core in a soft ellipse, cool purple\n  const shadow = (r, x, y, rad) => { r.shadow(x, y, rad, .28, '#2a2048'); r.shadow(x, y, rad * .6, .22, '#2a2048'); };\n\n  /* ---- FLOORS: floorTex(x, y, tag) = [r, g, b(, glow)], baked once per view ---- */\n  // AUTOTILING: distance to the nearest side bordering another floor, corners rounded by K\n  function edge(cx, cy, lx, ly, tag, K) {\n    const o = (dx, dy) => { const t = map.floorAt((cx + dx + .5) * T, (cy + dy + .5) * T), c = map.cell(cx + dx, cy + dy); return tag === 'water' ? t !== tag && t !== 'bridge' && !c : t !== tag || c !== 0; };\n    const a = Math.min(o(-1, 0) ? lx : 99, o(1, 0) ? T - lx : 99), b = Math.min(o(0, -1) ? ly : 99, o(0, 1) ? T - ly : 99);\n    return a < K && b < K ? K - Math.hypot(K - a, K - b) : Math.min(a, b);\n  }\n  // GRASS: TUFT and BLOOM stamps on a staggered lattice in SCREEN pixels\n  function grass(sx, sy, G) {\n    const row = Math.floor(sy / 7), X = sx + (row & 1) * 6, k = E.hash2(Math.floor(X / 12), row), pat = k < .07 ? BLOOM : k < .62 ? TUFT : null;\n    const ch = pat && (pat[mod(Math.floor(sy), 7) - 2] || '')[mod(Math.floor(X), 12) - (pat === BLOOM ? 5 : 4)];\n    return ch === 'l' ? G[3] : ch === 'd' ? G[1] : ch === 'y' ? PETAL[1] : ch === 'w' ? PETAL[k < .035 ? 0 : 2] : G[2];\n  }\n  function ground(x, y, tag) {\n    const cx = Math.floor(x / T), cy = Math.floor(y / T), lx = x - cx * T, ly = y - cy * T, room = roomOf(x), [sx, sy] = game.view.p(x, y), h = E.hash2(cx, cy);\n    const e = tag && tag !== 'carpet' ? edge(cx, cy, lx, ly, tag, tag === 'water' ? 7 : tag === 'pave' ? 1 : 4) : 99;\n    if (e < 0) tag = null;   // outside a rounded corner\n    // WATER: bank, lip, shadow, reflection, foam, then depth BANDS bent by value noise\n    if (tag === 'water') {\n      if (e < 2.6) return e < 1 ? STONE[0] : E.hash2(Math.floor(y / 3), cx) < .2 ? STONE[1] : STONE[e < 1.8 ? 4 : 3];\n      const w = (E.noise2(x / 6, y / 9) - .5) * 5, foam = near(cx, cy - 1, 'bridge') ? ly : near(cx, cy + 1, 'bridge') ? T - ly : 99;\n      if (e < 3.3 || foam < 3 + w + E.hash2(Math.floor(sx / 2), 1) * 2) return foam < 1.5 + w ? SKY[1] : WATER[4];\n      if (!near(cx - 1, cy, 'water') && lx < 6 + w) return WATER[0];\n      if (map.cell(cx + 1, cy) > 0 && lx > 11 + w) return REFLECT;\n      const px_ = lx - 4 - h * 8, py_ = ly - 4 - h * 7, pad = Math.hypot(px_, py_);\n      if (h < .3 && pad < 3) return LILY[pad < 1 ? 4 : px_ > .5 && Math.abs(py_) < .5 ? 1 : 2];\n      const k = mod(Math.floor(sx) + Math.floor(sy / 6) * 7, 23);   // sky glints on every 6th row\n      return mod(Math.floor(sy), 6) === 0 && k < 4 ? SKY[k ? 0 : 1] : WATER[e + w < 8 ? 3 : e + w < 12 ? 2 : 1];\n    }\n    if (tag === 'bridge') return (ly < 2 && !near(cx, cy - 1, tag)) || (ly > T - 2 && !near(cx, cy + 1, tag)) ? DIRT[0] : E.tex.planks(y, x, { base: '#b07c44', dark: '#8a5c32', line: '#4a2e1a' });\n    // path and paving: grass erodes the edge by a hash; dirt, pebbles\n    const q = E.hash2(Math.floor(sx / 6), Math.floor(sy / 5)), b = E.hash2(Math.floor(x / 4), Math.floor(y / 4)) * 3;\n    if (tag === 'path') return e < b ? grass(sx, sy, GRASS[room][1]) : e < b + .9 ? DIRT[0] : q < .16 && mod(Math.floor(sx), 6) < 2 && mod(Math.floor(sy), 5) === 0 ? DIRT[q < .07 ? 4 : 1] : DIRT[e < b + 1.8 ? 1 : 2];\n    if (tag === 'plaza') return e < .9 ? PLAZA.mortar : E.tex.flagstone(x, y, PLAZA, 8);\n    if (tag === 'bed') return e < 1 ? STONE[0] : e < 2.4 ? STONE[3] : SOIL[mod(ly, 4) < 1 ? 0 : 2];\n    const c = Math.min(near(cx - 1, cy, tag) ? 99 : lx, near(cx + 1, cy, tag) ? 99 : T - lx), m = Math.abs(mod(x, 32) - 16) + Math.abs(ly - 8);   // carpet\n    if (tag === 'carpet') return c < 1 ? CARPET[0] : c >= 2 && c < 3 ? GOLD[1] : m > 5 && m < 6.5 ? GOLD[0] : m < 2.5 ? GOLD[2] : CARPET[1];\n    const f = E.tex.flagstone(x, y, PAVE);   // paving: moss in the seams\n    if (tag === 'pave') return e < b ? grass(sx, sy, GRASS[1][1]) : e < b + .9 ? PAVE.mortar : f === PAVE.mortar && E.hash2(Math.floor(x / 6), Math.floor(y / 6)) < .45 ? GRASS[1][1][1] : f;\n    const n = E.noise2(x / 40 + room * 9, y / 40);   // lawn: three shades in slow patches\n    if (room < 2) return grass(sx, sy, GRASS[room][n < .36 ? 0 : n > .64 ? 2 : 1]);\n    const dr = Math.hypot(x - relic.x, y - relic.y), a = Math.atan2(y - relic.y, x - relic.x), P = TILE[(cx + cy) & 1];\n    if (Math.abs(dr - 15) < .7 || Math.abs(dr - 10.5) < .6 || (dr > 11 && dr < 14.5 && Math.abs(mod(a / Math.PI * 4, 1) - .5) < .06)) return RUNE;   // shrine: a rune circle...\n    if (dr < 26) return dr > 24.8 ? TILE[1][0] : dr > 23.2 ? TILE[0][4] : TILE[dr < 20 ? 1 : 0][2];   // ...on a round dais with a lit rim...\n    if (Math.min(lx, ly) < 1.2) return P[lx < .8 || ly < .8 ? 0 : 4];   // ...on marble tiles\n    return lx > T - 1.2 || ly > T - 1.2 ? P[1] : mod(lx + ly, 13) < 1 ? P[3] : P[2];\n  }\n  // PAINTED LIGHT (Legend of Mana): a wall taller than its distance toward the low sun shades a point cool purple\n  const SHADE = [.64, .68, .86];\n  function floorTex(x, y, tag) {\n    const c = ground(x, y, tag);\n    for (let d = 2; d < 18; d += 2) if (map.heightAt(x - d, y - d * .3) > d * 1.8) return c.map((v, i) => i < 3 ? v * SHADE[i] : v);\n    return c;\n  }\n\n  // trees and pines varied by hashes\n  const tree = (cx, cy, pine) => { const v = E.hash2(cx * 5, cy * 3); return { prop: pine || v > .72 ? 'pine' : 'tree', size: 1 + v * .45, color: ['#2f7a3c', '#3f8a45', '#2a6a44', '#4a8a3a'][Math.floor(v * 4)], x: (cx + .3 + E.hash2(cy, cx) * .4) * T }; };\n  function start() {\n    map = new E.TileMap({ rows: ROWS, legend: LEGEND, types: TYPES, floorTex, ao: 8 });\n    relic = map.find('relic'); entry = map.find('entry'); relic.x += T / 2; entry.x += T / 2;   // on the room's center line\n    // the camera stays inside the map (the forest round the rooms fills a tall screen); update() sets rooms or scroll\n    game.cam.bounds = v => { const b = map.bounds(v); return { x0: b.x0 + 9, y0: b.y0 + 9, x1: b.x1 - 9, y1: b.y1 - 9 }; }; game.cam.room = game.settings.advCamera === 'scroll' ? null : ROOM;\n    const at = map.find('hero');\n    // SWORD (Secret of Mana): J chains slash, backslash, spin, kept low (a raised blade crosses his face); short holds (hold)\n    // let the follow-through settle instead of freezing; hold J to CHARGE\n    hero = Object.assign(new E.Body({ ...at, r: 4.5 }), { hp: 3, max: 3, facing: Math.PI / 2, inv: 0, hurt: 0, charge: 0, rig: RIGS.hero(),\n      combo: new E.Combo([new E.Attack('slash', { z0: -8, z1: -11, a1: -1.2, wind: .12, hold: .1 }), new E.Attack('backslash', { z0: -11, z1: -9, a1: 1.2, hold: .1 }), new E.Attack('spin', { ...WAIST, hold: .15 })], { window: .3 }),\n      spin: new E.Attack('spin', { ...WAIST, active: .36, reach: 10, lean: .3, hold: .12 }) });\n    hero.sw = hero.combo;   // the attack running now\n    npcs = Object.keys(NPCS).map(k => { const n = Object.assign({ said: 0, t: 0, k: 0, hi: 0, nod: 0, face: Math.PI / 2, rig: RIGS[k]() }, map.find(k), NPCS[k]); n.dir = n.look = n.face; n.job = n.chore && n.chore(); return n; });\n    things = [];\n    for (const s of map.spawns) for (const d of [].concat(s.tag === 'tree' ? tree(s.cx, s.cy) : THINGS[s.tag] || []))\n      things.push(Object.assign({ tag: s.tag, prop: s.tag, x: s.x + (d.dx || 0), y: s.y, room: roomOf(s.x) }, d));\n    // one pass over the cells: roofs, pines, weeds, flower beds, bridge rails, tufts\n    const box = {};\n    for (let cy = 0; cy < map.h - 1; cy++) for (let cx = 0; cx < map.w; cx++) {\n      const c = map.cell(cx, cy), v = E.hash2(cx * 3, cy * 7 + 1), X = (cx + .5) * T, Y = (cy + .5) * T, tag = map.floorAt(X, Y), add = o => things.push(Object.assign({ x: X, y: Y }, o));\n      if (c === 5 || c === 8) { const b = box[c] || (box[c] = [cx, cy, cx, cy]); b[2] = cx; b[3] = cy; }\n      if (map.spawns.some(s => s.cx === cx && s.cy === cy)) continue;\n      if (c === 9 && cy === PAD && v < .5) add(tree(cx, cy, true));\n      else if ((c === 3 || c === 4) && v < .45) add({ prop: 'bush', size: .7 + v * .6, color: '#5a8a44' });\n      else if (tag === 'bed') {\n        for (const k of [-3, 3]) add({ prop: 'flowers', size: 1.1, x: X + k, y: Y + k, color: k < 0 ? ['#f06a9a', '#f0a040', '#ffffff'][cx % 3] : '#8ab0ff', color2: '#fff4a0' });\n        if (!near(cx, cy + 1, 'bed')) add({ prop: 'fence', size: 1.2, y: Y + 8, color: '#b08050' });\n      }\n      else if (tag === 'bridge') for (const s of [-1, 1]) { if (!near(cx, cy + s, 'bridge')) add({ prop: 'fence', size: 1.2, y: Y + s * 7, color: '#8a5a32' }); }\n      else if (!c && !tag && X < 2 * ROOM[0] && v < .16) add({ prop: v < .06 ? 'flowers' : 'grass', x: X + (E.hash2(cx, cy) - .5) * 10, y: Y + (E.hash2(cy, cx) - .5) * 8,\n        color: v < .06 ? '#f06a9a' : X > ROOM[0] ? '#5a9a4a' : '#6ab850', color2: '#fff4a0' });\n    }\n    roofs = Object.keys(box).map(id => { const [a, b, c, d] = box[id]; return { x0: a * T, y0: b * T, x1: (c + 1) * T, y1: (d + 1) * T, h: TYPES[id].h, C: E.ramp(TYPES[id].top, 5) }; });\n    items = [{ kind: 'relic', x: relic.x, y: relic.y }];\n    // bats roost (hang; wake = time since); stun = flinch; dying = death; streak = claw marks; hold = an impact frame\n    foes = Object.keys(FOES).flatMap(k => map.findAll(k)).map(s => { const F = FOES[s.tag], moves = (F.moves || []).map(m => new E.Attack(m, { recover: .45, hold: .5, ...F.tune }));\n      return Object.assign(new E.Body({ ...s, r: 5.5, friction: 6, ...(F.fly && { z: F.fly + 8, gravity: 0, onGround: false }) }), { kind: s.tag, hp: F.hp, fly: F.fly, hang: !!F.fly, home: { ...s },\n        t: 1 + Math.random(), flash: 0, stun: 0, swoop: 0, wake: 9, streak: [], face: Math.PI / 2, room: roomOf(s.x), look: F.look(), moves, atk: moves[0] }); });\n    pets = map.findAll('cat').map(s => Object.assign(new E.Body({ ...s, r: 4 }), { t: 1, home: { ...s }, look: new E.Blob({ R: 4, colors: CAT, ears: 'cat', tail: true, feet: true, mouth: true, face: 'front' }) }));\n    shots = new E.Bullets(game, { plane: 'ground' }); talk = new E.Dialog(game, WIN);\n    fx = []; won = false; keys = 0; gems = 0; area = { room: 0, t: 2.6 }; held = null;\n    // the floor is lit already; GPU lighting (if any) adds light pools and shadows\n    L.enabled = false; lighting(); mood(MOOD[0]); A.music('adventure');\n    game.input.touchSet('attack', 'SWORD');\n  }\n  // DIALOG: E.Dialog types and pages; portrait: a live close-up of the speaker\n  const say = (who, name, text) => { speaker = who; talk.say(typeof text === 'function' ? text() : text, { name, portrait: who.rig, portraitSize: 50, portraitOpts: { zoom: 2.6, turn: -.25, cape: false, bg: FACE_BG } }); };   // (at the bottom, clear of the touch buttons)\n  function hurtHero(ang) {   // flinch, knockback, blink; true if it hurt\n    if (hero.inv > 0 || won || hero.hp <= 0) return false; hero.hp -= .5; hero.inv = 1; hero.hurt = .25; hero.charge = 0; hero.combo.cancel(); hero.spin.cancel(); hero.push(Math.cos(ang) * 160, Math.sin(ang) * 160);\n    game.hitFx(hero.x + Math.cos(ang) * 3, hero.y + Math.sin(ang) * 3, 12, { power: .9, angle: ang + Math.PI, color: '#ff8a6a', sound: 'hurt' }); game.flash('#ff4a3a', .06, .4);\n","numLines":282,"startLine":1,"totalLines":282}},"tool_result_meta":[{"id":"toolu_01BAy7fMPmciCkR1LHSTjhU9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
