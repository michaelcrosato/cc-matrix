h.min(r.W - 40, 360), sx = Math.round((r.W - sw) / 2), sy = brL.sheetY, sh = Math.max(30, r.H - sy - 22);","       px.rect(g, sx, sy, sw, sh, '#f4eedd'); px.rect(g, sx, sy, sw, 1, '#ffffff'); px.rect(g, sx + sw, sy + 2, 2, sh, '#1a120c');","       const full = (BR.sel.length ? C.company.split(' ')[0].toUpperCase() + '. ' : '') + tagline(BR.sel), shown = full.slice(0, Math.floor(BR.typed));","-      E.font.text(g, shown + (Math.floor(game.real * 2) % 2 ? '_' : ''), sx + 8, sy + 6, '#2a2420', { outline: false, wrap: sw - 16 });","+      const tl = E.font.text(g, shown + (Math.floor(game.real * 2) % 2 ? '_' : ''), sx + 8, sy + 5, '#2a2420', { outline: false, wrap: sw - 16 });","+      const fc = items[BR.focus] && items[BR.focus].kind === 'card' ? CARDS[items[BR.focus].id] : null;","+      if (fc && sh > tl.h + 18) E.font.text(g, '\"' + fc.line + '\"  ' + (fc.from ? fc.from + ': ' : '') + (fc.text || ''), sx + 8, sy + tl.h + 9, '#6a5a48', { outline: false, wrap: sw - 16 });","       const thr = Object.keys(syn).filter(a => syn[a] > 1);","       if (thr.length) E.font.text(g, 'Through-line: ' + thr.map(a => ANGLES[a].icon + ' ' + a).join(', ') + ' (+1 power each)', sx + 8, sy + sh - 10, '#2a6a3a', { outline: false, font: 'tiny' });","       const hint = (I.lastDevice === 'mouse' ? 'Click' : keyOf(I, 'confirm')) + ' choose' + (!BR.forced && !BR.ctx ? '   ' + keyOf(I, 'cancel') + ' not yet' : '');"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181325__xe8b2f0/work/MadMenOut-MadMen-claude-opus-5-5-medium-20261102-181325/src/40-pitch.js","hunks":[{"oldStart":212,"oldLines":9,"newStart":212,"newLines":9,"lines":["   const ph = PT.phase, sw = Math.min(170, W * .42), sh = Math.round(sw * .62), sx = Math.round(W / 2 - sw / 2), sy = 40;","   if (ph === 'choose') {","     if (game.settings.tells && C.tells) { const tl = C.tells[PT.shown % C.tells.length]; panel(g, 16, 40, W - 32, 22, { alpha: .85 }); txt(g, tl, W / 2, 47, '#c8e0ff', { align: 'center', wrap: W - 48 }); }","-    const n = PT.left.length, cw = 96, ch = 68, x0 = Math.round((W - (n * (cw + 8) - 8)) / 2), y0 = H - ch - 30;","+    const n = PT.left.length, cw = 100, ch = 76, x0 = Math.round((W - (n * (cw + 8) - 8)) / 2), y0 = H - ch - 30;","     PT.cardBoxes = PT.left.map((id, i) => [x0 + i * (cw + 8), y0 - (PT.focus === i ? 6 : 0), cw, ch]);","-    PT.left.forEach((id, i) => drawCard(g, ...PT.cardBoxes[i].slice(0, 2), id, { w: cw, h: ch, focus: PT.focus === i }));","+    PT.left.forEach((id, i) => drawCard(g, ...PT.cardBoxes[i].slice(0, 2), id, { w: cw, h: ch, focus: PT.focus === i, full: true }));","     txt(g, 'Present a slide:  ' + (I.lastDevice === 'mouse' ? 'click a card' : keyOf(I, 'left') + ' ' + keyOf(I, 'right') + ' choose  ' + keyOf(I, 'confirm') + ' present'), W / 2, H - 22, COL.ink, { align: 'center' });","   }","   if (PT.cur && (ph === 'deliver' || ph === 'react' || ph === 'pivot' || ph === 'wait')) drawSlide(g, sx, sy, sw, sh, PT.cur);"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181325__xe8b2f0/work/MadMenOut-MadMen-claude-opus-5-5-medium-20261102-181325/src/30-brainstorm.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181325__xe8b2f0/work/MadMenOut-MadMen-claude-opus-5-5-medium-20261102-181325/src/40-pitch.js"]}},"tool_result_meta":[{"id":"toolu_01Jg2ZfRi7G4ikUNyGQWnzmP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
