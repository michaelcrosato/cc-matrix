\n      }\n      hub.players = (m.players || []).slice();\n      hub.seed = m.seed >>> 0;\n      hub.isHost = m.me === m.host;\n      hub.splash = m.splash === true;\n      if (m.limits) {\n        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n        tokens = limits.burst;\n      }\n      if (connecting) connecting.resolve(info());\n      return;\n    }\n    if (m.type === 'fullscreen') {\n      fullscreenOn = m.on === true;\n      try {\n        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n      } catch (e) {}\n      return;\n    }\n    if (!welcomed || ended) return;\n    if (m.type === 'start') {\n      goAt = now() + Number(m.in || 0);\n      emit('start', [{ in: Number(m.in || 0) }]);\n    } else if (m.type === 'message') {\n      emit('message', [m.data, m.from]);\n    } else if (m.type === 'leave') {\n      hub.players = hub.players.filter(function (p) {\n        return p.id !== m.id;\n      });\n      emit('leave', [{ id: m.id, reason: m.reason }]);\n    } else if (m.type === 'time-up') {\n      emit('time-up', [{ graceMs: m.graceMs }]);\n    } else if (m.type === 'end') {\n      ended = true;\n      if (progressTimer) clearTimeout(progressTimer);\n      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n    } else {\n      // An event this client has never heard of: hand it on as it came.\n      var detail = {};\n      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n      emit(m.type, [detail]);\n    }\n  }\n\n  function info() {\n    var out = {};\n    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n    out.players = hub.players.slice();\n    return out;\n  }\n\n  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n  hub.connect = function (opts) {\n    if (connecting) return connecting.promise;\n    var done;\n    var promise = new Promise(function (resolve) {\n      done = resolve;\n    });\n    connecting = { promise: promise, resolve: done };\n    if (!hub.active) {\n      done(null);\n      return promise;\n    }\n    opts = opts || {};\n    root.addEventListener('message', onMessage);\n    var started = now();\n    var hello = function () {\n      if (welcomed) return;\n      if (now() - started > HELLO_TIMEOUT_MS) {\n        standAlone();\n        warn('no hub answered; playing normally');\n        done(null);\n        return;\n      }\n      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n      setTimeout(hello, HELLO_EVERY_MS);\n    };\n    hello();\n    return promise;\n  };\n\n  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n  hub.ready = function () {\n    if (!welcomed || sentReady || ended) return;\n    sentReady = true;\n    post('ready', {});\n  };\n\n  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n  hub.answer = function (what) {\n    if (!welcomed || ended || goAt !== null) return;\n    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n    post('answer', { answer: what });\n  };\n\n  hub.on = function (type, fn) {\n    (handlers[type] = handlers[type] || []).push(fn);\n    if (pending[type] && !pending[type].flushing) {\n      pending[type].flushing = true;\n      setTimeout(function () {\n        var queued = pending[type];\n        delete pending[type];\n        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n      });\n    }\n    return function () {\n      var list = handlers[type] || [];\n      var at = list.indexOf(fn);\n      if (at !== -1) list.splice(at, 1);\n    };\n  };\n\n  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n  hub.send = function (data, opts) {\n    if (!welcomed || ended) return false;\n    opts = opts || {};\n    var text;\n    try {\n      text = JSON.stringify(data);\n    } catch (e) {\n      warn('send: data is not JSON');\n      return false;\n    }\n    if (text === undefined) return false;\n    if (text.length > limits.maxBytes) {\n      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n      return false;\n    }\n    var t = now();\n    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n    refilled = t;\n    if (tokens < 1) {\n      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n      return false;\n    }\n    tokens -= 1;\n    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n    post('send', fields);\n    return true;\n  };\n\n  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n  hub.time = function () {\n    return goAt === null ? -Infinity : now() - goAt;\n  };\n\n  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n  hub.rng = function (label) {\n    var h = 2166136261;\n    var s = String(label === undefined ? '' : label);\n    for (var i = 0; i < s.length; i++) {\n      h ^= s.charCodeAt(i);\n      h = Math.imul(h, 16777619);\n    }\n    return generator((hub.seed ^ h) >>> 0);\n  };\n\n  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n  function finite(v) {\n    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n  }\n\n  /**\n   * The whole outcome as plain JSON, field by field: the hub checks and trims\n   * it, so new optional fields need no new client. A field that is not JSON\n   * (a cycle, a BigInt) is left out, not the whole outcome.\n   */\n  function outcomeOf(outcome) {\n    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n      warn('the outcome is not a plain object');\n      return null;\n    }\n    var copy = {};\n    for (var key in outcome) {\n      if (!own(outcome, key)) continue;\n      var value = json(outcome[key]);\n      if (value !== undefined) copy[key] = value;\n      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n    }\n    return copy;\n  }\n\n  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n  hub.result = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    var given = outcome || {};\n    delete fields.time;\n    delete fields.score;\n    if (finite(given.time)) fields.time = Number(given.time);\n    if (finite(given.score)) fields.score = Number(given.score);\n    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n    reported = true;\n    if (progressTimer) clearTimeout(progressTimer);\n    post('result', fields);\n  };\n\n  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n  hub.finish = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    if (!hub.isHost) return warn('finish is for the host only');\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n    reported = true;\n    post('finish', fields);\n  };\n\n  function sendProgress() {\n    progressTimer = null;\n    if (!nextProgress || ended || reported) return;\n    lastProgress = now();\n    post('progress', nextProgress);\n    nextProgress = null;\n  }\n\n  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n  hub.progress = function (p) {\n    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n    nextProgress = { score: Number(p.score) };\n    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n    if (wait <= 0) sendProgress();\n    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n  };\n\n  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n  hub.probe = function (fn) {\n    probeFn = typeof fn === 'function' ? fn : null;\n  };\n\n  hub.inspect = function () {\n    if (!probeFn) return null;\n    try {\n      return JSON.parse(JSON.stringify(probeFn()));\n    } catch (e) {\n      return { error: String((e && e.message) || e) };\n    }\n  };\n\n  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n  hub.fail = function (message) {\n    if (!hub.active) return;\n    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n  };\n\n  root.AIHub = hub;\n})(typeof window !== 'undefined' ? window : globalThis);\n","numLines":489,"startLine":1,"totalLines":489}},"tool_result_meta":[{"id":"toolu_01FQQ7rvCY78FBGEjiyrgWDf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9DCYJiuyLpQguWZoXH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014bVKkRm2cfLYDZmfaqfxWx","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/harness.html"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9172,"cache_read_input_tokens":42349,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9172},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"dec1bf51-2868-4593-9054-29acd44e4206","timestamp":"2026-11-05T04:22:32.826Z","request_id":"req_011Cgj9DCHvTwpwPUmAdScfo","wire_tool_inputs":{"toolu_014bVKkRm2cfLYDZmfaqfxWx":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/harness.html"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014bVKkRm2cfLYDZmfaqfxWx","type":"tool_result","content":"1\t<!doctype html>\n2\t<html lang=\"en\">\n3\t<head>\n4\t<meta charset=\"utf-8\">\n5\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n6\t<title>AI Hub Session Harness</title>\n7\t<meta name=\"description\" content=\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\">\n8\t<style>\n9\t  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\n10\t  * { box-sizing: border-box; }\n11\t  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\n12\t  body { display: grid; grid-template-rows: auto 1fr; }\n13\t  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\n14\t  header h1 { font-size: 15px; margin: 0 8px 0 0; }\n15\t  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\n16\t  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\n17\t  input[type=number] { width: 70px; }\n18\t  input.game { width: 300px; }\n19\t  button { cursor: pointer; }\n20\t  button:hover { border-color: var(--dim); }\n21\t  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\n22\t  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\n23\t  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n24\t  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n25\t  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n26\t  .cell__state { margin-left: auto; color: var(--dim); }\n27\t  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n28\t  .cell.is-out { opacity: .35; }\n29\t  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n30\t  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n31\t  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\n32\t  #checks li { list-style: none; }\n33\t  #checks ul { margin: 0; padding: 0; }\n34\t  .ok::before { content: '✓ '; color: var(--ok); }\n35\t  .bad::before { content: '✗ '; color: var(--bad); }\n36\t  .wait::before { content: '… '; color: var(--warn); }\n37\t  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n38\t  #round { white-space: pre-wrap; font-size: 13px; }\n39\t  .hint { color: var(--dim); }\n40\t</style>\n41\t</head>\n42\t<body>\n43\t<header>\n44\t  <h1>AI Hub session harness</h1>\n45\t  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n46\t  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n47\t  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n48\t  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n49\t  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n50\t  <button id=\"restart\" type=\"button\">New round</button>\n51\t  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n52\t  <button id=\"timeup\" type=\"button\">Time up</button>\n53\t  <label>Remove <select id=\"who\"></select></label>\n54\t  <button id=\"remove\" type=\"button\">Remove player</button>\n55\t  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n56\t</header>\n57\t<main>\n58\t  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n59\t  <aside>\n60\t    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n61\t    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n62\t    <pre id=\"log\" aria-live=\"off\"></pre>\n63\t  </aside>\n64\t</main>\n65\t<script type=\"module\">\n66\timport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\n67\timport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n68\t\n69\tconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\n70\tconst params = new URLSearchParams(location.search);\n71\tconst $ = (id) => document.getElementById(id);\n72\tconst auto = params.get('auto') === '1';\n73\tconst scenario = params.get('scenario') || 'standard';\n74\t/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75\tconst serverMode = scenario === 'server';\n76\tconst playMs = Number(params.get('play')) || 6000;\n77\tconst SPLASH_MS = 10_000;\n78\t\n79\tfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n80\t  if (params.has(key)) $(id).value = params.get(key);\n81\t}\n82\t\n83\tconst net = createLocalNetwork({});\n84\tlet current = null;\n85\tlet roundNo = 0;\n86\tconst logLines = [];\n87\tfunction log(text) {\n88\t  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n89\t  logLines.push(`${t}  ${text}`);\n90\t  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n91\t  $('log').textContent = logLines.join('\\n');\n92\t  $('log').scrollTop = $('log').scrollHeight;\n93\t}\n94\t\n95\t/** The game's head metas, when the page can be fetched from here. */\n96\tasync function metasOf(url) {\n97\t  try {\n98\t    const html = await (await fetch(url)).text();\n99\t    const doc = new DOMParser().parseFromString(html, 'text/html');\n100\t    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n101\t    return {\n102\t      session: meta('hub:session'),\n103\t      players: meta('hub:session-players'),\n104\t      mode: meta('hub:session-mode'),\n105\t      minutes: meta('hub:session-minutes'),\n106\t    };\n107\t  } catch {\n108\t    return null;\n109\t  }\n110\t}\n111\t\n112\t/**\n113\t * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n114\t * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n115\t * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n116\t */\n117\tconst gameUrl = (game, { tag, seed } = {}) => {\n118\t  let url;\n119\t  try {\n120\t    url = new URL(game, location.href);\n121\t  } catch {\n122\t    return null;\n123\t  }\n124\t  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n125\t  url.searchParams.set('aihub', '1');\n126\t  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n127\t  return url.href;\n128\t};\n129\t\n130\tfunction applyNet() {\n131\t  Object.assign(net.settings, {\n132\t    latency: Math.max(0, Number($('latency').value) || 0),\n133\t    jitter: Math.max(0, Number($('jitter').value) || 0),\n134\t    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n135\t  });\n136\t}\n137\t\n138\t/** Wrap what a game must not call in hub mode, where the page can reach it. */\n139\tfunction instrument(cell) {\n140\t  try {\n141\t    const win = cell.frame.contentWindow;\n142\t    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n143\t      const original = win[name];\n144\t      win[name] = (...args) => {\n145\t        cell.violations.push(`${name}() called`);\n146\t        log(`${cell.name}: ${name}() called — not allowed in a session`);\n147\t        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n148\t      };\n149\t      void original;\n150\t    }\n151\t    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n152\t    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n153\t  } catch {\n154\t    cell.instrumented = false;\n155\t  }\n156\t}\n157\t\n158\tasync function newRound() {\n159\t  endCurrent();\n160\t  applyNet();\n161\t  const game = $('game').value.trim();\n162\t  if (!game) return null;\n163\t  if (!gameUrl(game)) {\n164\t    log(`Not loading ${game}: the harness only plays pages from this site.`);\n165\t    return null;\n166\t  }\n167\t  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n168\t  const metas = await metasOf(game);\n169\t  const mode = modeOf(metas?.mode);\n170\t  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n171\t  const seed = params.has('seed') ? Number(params.get('seed')) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];\n172\t  const round = ++roundNo;\n173\t  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n174\t  const hubEnd = net.endpoint('hub');\n175\t  const grid = $('grid');\n176\t  grid.replaceChildren();\n177\t  const copies = n + (serverMode ? 1 : 0);\n178\t  grid.style.gridTemplateColumns = copies > 1 ? '1fr 1fr' : '1fr';\n179\t  grid.style.gridTemplateRows = `repeat(${Math.ceil(copies / (copies > 1 ? 2 : 1))}, 1fr)`;\n180\t\n181\t  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n182\t  current = state;\n183\t  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n184\t\n185\t  state.coordinator = createRound({\n186\t    round,\n187\t    players,\n188\t    hostKey: 'p0',\n189\t    serverKey: serverMode ? 'server' : null,\n190\t    mode,\n191\t    seed,\n192\t    limitMs,\n193\t    gate: true,\n194\t    deliver: (key, m) => hubEnd.send(key, { k: 'h', r: round, m }),\n195\t    onStatus: (s) => { state.status = s; render(state); },\n196\t    onEnd: (record) => {\n197\t      state.record = record;\n198\t      log(`round ${round} ${record.status}: ${record.reason}${record.standings ? ' — standings ' + JSON.stringify(record.standings) : ''}`);\n199\t      render(state);\n200\t    },\n201\t  });\n202\t  hubEnd.onMessage((from, env) => {\n203\t    if (env.k !== 'c' || env.r !== round) return;\n204\t    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\n205\t    state.coordinator.receive(from, env.m);\n206\t  });\n207\t\n208\t  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n209\t    const color = p.server ? '#8a8a8a' : ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][p.slot];\n210\t    const frame = document.createElement('iframe');\n211\t    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n212\t    frame.title = p.name;\n213\t    const label = document.createElement('div');\n214\t    label.className = 'cell__bar';\n215\t    label.innerHTML = `<span class=\"cell__dot\" style=\"background:${color}\"></span><b></b><span class=\"cell__state\"></span>`;\n216\t    label.querySelector('b').textContent = `${p.name} (${p.key})`;\n217\t    const el = document.createElement('div');\n218\t    el.className = 'cell';\n219\t    el.style.borderColor = color;\n220\t    el.append(label, frame);\n221\t    grid.append(el);\n222\t\n223\t    const endpoint = net.endpoint(p.key);\n224\t    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n225\t    const post = postTo(frame);\n226\t    cell.bridge = createBridge({\n227\t      key: p.key,\n228\t      round,\n229\t      coordinator: 'hub',\n230\t      post: (msg) => {\n231\t        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n232\t        post(msg);\n233\t      },\n234\t      net: endpoint,\n235\t      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n236\t      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n237\t      onAnswer: (what) => answerCard(state, cell, what),\n238\t      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n239\t      onProgress: (id, report) => {\n240\t        if (id !== cell.bridge?.me) return;\n241\t        cell.progress.push({ at: performance.now(), ...report });\n242\t        state.coordinator.progress(id, report.score);\n243\t        render(state);\n244\t      },\n245\t    });\n246\t    endpoint.onMessage((from, env) => cell.bridge.fromNet(from, env));\n247\t    cell.detach = attachFrame(frame, (msg) => cell.bridge.fromGame(msg));\n248\t    frame.addEventListener('load', () => instrument(cell), { once: true });\n249\t    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n250\t    state.cells.push(cell);\n251\t  }\n252\t  renderWho(state);\n253\t  render(state);\n254\t  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n255\t  // the conformance run releases it itself.\n256\t  const ticker = setInterval(() => {\n257\t    if (state !== current || state.coordinator.released) return clearInterval(ticker);\n258\t    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n259\t    tickCard(state);\n260\t  }, 250);\n261\t  return state;\n262\t}\n263\t\n264\tfunction releaseRound(state = current) {\n265\t  if (!state || state !== current || state.coordinator.released) return;\n266\t  state.splashUntil = null;\n267\t  tickCard(state);\n268\t  log('splash over: the round starts once every game has loaded');\n269\t  state.coordinator.release();\n270\t}\n271\t\n272\t/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\n273\tfunction tickCard(state) {\n274\t  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\n275\t  const ready = state.cells.filter((c) => state.answers.ready.has(c.key)).map((c) => c.bridge.me);\n276\t  for (const cell of state.cells) {\n277\t    if (cell.gone || !cell.bridge.showsCard) continue;\n278\t    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\n279\t    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\n280\t    if (cell.cardSent === id) continue;\n281\t    cell.cardSent = id;\n282\t    cell.bridge.card(card);\n283\t  }\n284\t}\n285\t\n286\t/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\n287\tfunction answerCard(state, cell, what) {\n288\t  if (state !== current || state.coordinator.released || cell.server) return;\n289\t  const { ready, more } = state.answers;\n290\t  if (what === 'ready') {\n291\t    ready.add(cell.key);\n292\t    more.delete(cell.key);\n293\t  } else if (more.has(cell.key)) {\n294\t    more.delete(cell.key);\n295\t  } else {\n296\t    more.add(cell.key);\n297\t    ready.delete(cell.key);\n298\t    state.splashUntil += 10_000;\n299\t  }\n300\t  log(`${cell.key} answers ${what} on the game's card`);\n301\t  const players = state.cells.filter((c) => !c.server && !c.gone);\n302\t  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n303\t  tickCard(state);\n304\t}\n305\t\n306\tfunction endCurrent() {\n307\t  if (!current) return;\n308\t  current.coordinator.abort('session-ended');\n309\t  for (const cell of current.cells) removeCell(cell, false);\n310\t  current.hubEnd.close();\n311\t  current = null;\n312\t}\n313\t\n314\tfunction removeCell(cell, tellRound = true) {\n315\t  if (cell.gone) return;\n316\t  cell.gone = true;\n317\t  cell.detach();\n318\t  cell.endpoint.close();\n319\t  cell.frame.remove();\n320\t  cell.el.classList.add('is-out');\n321\t  if (tellRound) {\n322\t    log(`${cell.key} left`);\n323\t    current?.coordinator.leave(cell.key, 'left');\n324\t  }\n325\t}\n326\t\n327\tfunction renderWho(state) {\n328\t  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n329\t}\n330\t\n331\tfunction render(state) {\n332\t  const s = state.status;\n333\t  if (!s) return;\n334\t  for (const cell of state.cells) {\n335\t    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n336\t    if (!p) continue;\n337\t    const bits = [];\n338\t    if (p.out) bits.push(`out: ${p.out}`);\n339\t    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\n340\t    else if (p.ready) bits.push('ready');\n341\t    else if (p.hello) bits.push('welcomed');\n342\t    else bits.push('loading');\n343\t    const last = cell.progress.at(-1);\n344\t    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\n345\t    bits.push(`↑${cell.bridge.stats.sent} ↓${cell.bridge.stats.received}`);\n346\t    cell.label.querySelector('.cell__state').textContent = bits.join(' · ');\n347\t    cell.el.classList.toggle('is-out', !!p.out || cell.gone);\n348\t  }\n349\t  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\n350\t  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\n351\t  if (state.record) {\n352\t    const name = (id) => s.players[id]?.name ?? `#${id}`;\n353\t    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\n354\t    if (state.record.standings) state.record.standings.forEach((ids, i) => lines.push(`  ${i + 1}. ${ids.map(name).join(', ')}`));\n355\t  }\n356\t  if (s.issues.length) lines.push(...s.issues.map((i) => `✗ ${i.key}: ${i.problem}`));\n357\t  $('round').textContent = lines.join('\\n');\n358\t}\n359\t\n360\t$('restart').onclick = () => newRound();\n361\t$('release').onclick = () => releaseRound();\n362\t$('timeup').onclick = () => current?.coordinator.timeUp();\n363\t$('remove').onclick = () => {\n364\t  const cell = current?.cells.find((c) => c.key === $('who').value);\n365\t  if (cell) removeCell(cell);\n366\t};\n367\t$('hide').onclick = () => {\n368\t  if (!current) return;\n369\t  current.hidden = !current.hidden;\n370\t  $('hide').setAttribute('aria-pressed', String(current.hidden));\n371\t  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n372\t  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\n373\t};\n374\tfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\n375\t\n376\t/* ---------------------------------------------------------------------------\n377\t * ?auto=1 — the conformance run. It presses keys inside each frame with\n378\t * synthetic events while the round plays (the frames must be served from this\n379\t * page's origin). Results land in window.__hubCheck, and body[data-complete]\n380\t * turns \"true\".\n381\t * ------------------------------------------------------------------------- */\n382\t\n383\tconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n384\tasync function until(test, ms) {\n385\t  const end = performance.now() + ms;\n386\t  while (performance.now() < end) {\n387\t    if (test()) return true;\n388\t    await sleep(50);\n389\t  }\n390\t  return test();\n391\t}\n392\t\n393\tfunction poke(cell, key) {\n394\t  const doc = cell.frame.contentDocument;\n395\t  const win = cell.frame.contentWindow;\n396\t  if (!doc || !win) return false;\n397\t  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\n398\t  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n399\t  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n400\t  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n401\t  return true;\n402\t}\n403\t\n404\tasync function conformance() {\n405\t  const checks = [];\n406\t  const check = (name, pass, detail = '') => {\n407\t    checks.push({ name, pass: !!pass, detail });\n408\t    renderChecks(checks);\n409\t    return !!pass;\n410\t  };\n411\t  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n412\t  window.__hubCheck = report;\n413\t  try {\n414\t    const state = await newRound();\n415\t    if (!state) {\n416\t      check('game named', false, 'pass ?game=<path> of a page on this site');\n417\t      return;\n418\t    }\n419\t    const n = state.n;\n420\t    const m = state.metas;\n421\t    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n422\t    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n423\t    const [least, most = least] = seats;\n424\t    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n425\t    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n426\t\n427\t    // Every copy: the players, and in a server round the server's copy.\n428\t    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n429\t    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n430\t    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n431\t    if (!helloed) return;\n432\t    const caps = state.coordinator.seats().map((s) => s.caps);\n433\t    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n434\t    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n435\t    if (state.cells.some((c) => !c.frame.contentDocument)) {\n436\t      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n437\t      return;\n438\t    }\n439\t\n440\t    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n441\t    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n442\t    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n443\t    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n444\t    if (caps.some((c) => c?.card)) {\n445\t      const players = state.cells.filter((c) => !c.server);\n446\t      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n447\t      for (const cell of players) poke(cell, 'Enter');\n448\t      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n449\t      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n450\t    }\n451\t    releaseRound(state);\n452\t    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n453\t    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n454\t    if (!started || state.record) return;\n455\t\n456\t    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n457\t    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n458\t    const randomly = async (ms) => {\n459\t      const end = performance.now() + ms;\n460\t      while (performance.now() < end && !state.record) {\n461\t        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n462\t        await sleep(150);\n463\t      }\n464\t    };\n465\t    await randomly(Math.min(1500, playMs / 4));\n466\t\n467\t    const mode = state.coordinator.mode;\n468\t    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n469\t    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n470\t    const own = SELF_REPORTED.includes(mode);\n471\t    const legacyRace = own && !seedsRandom(m?.mode);\n472\t    if (own && !legacyRace) {\n473\t      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n474\t      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n475\t    }\n476\t\n477\t    if (scenario === 'host-leave') removeCell(state.cells[0]);\n478\t    else if (n >= 3) removeCell(state.cells[n - 1]);\n479\t    await randomly(playMs / 2);\n480\t    const remaining = state.cells.filter((c) => !c.gone);\n481\t    if (own) {\n482\t      if (mode === 'parallel') {\n483\t        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n484\t          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n485\t      } else {\n486\t        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n487\t          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n488\t      }\n489\t      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n490\t        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n491\t    } else {\n492\t      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n493\t        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n494\t    }\n495\t\n496\t    if (!state.record) state.coordinator.timeUp();\n497\t    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n498\t    const record = state.record;\n499\t    if (serverMode) {\n500\t      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n501\t      const serverCell = state.cells.find((c) => c.server);\n502\t      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n503\t        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n504\t    }\n505\t    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n506\t      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n507\t    } else {\n508\t      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n509\t    }\n510\t    await sleep(300);\n511\t    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n512\t    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n513\t    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n514\t    const violations = state.cells.flatMap((c) => {\n515\t      let extra = [];\n516\t      try {\n517\t        extra = c.frame.contentWindow?.__hubViolations ?? [];\n518\t      } catch {}\n519\t      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n520\t    });\n521\t    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n522\t  } catch (error) {\n523\t    check('harness ran', false, String(error?.stack || error));\n524\t  } finally {\n525\t    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n526\t    report.done = true;\n527\t    document.body.dataset.complete = 'true';\n528\t    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n529\t  }\n530\t}\n531\t\n532\tfunction renderChecks(checks) {\n533\t  $('checklist').replaceChildren(\n534\t    ...checks.map((c) => {\n535\t      const li = document.createElement('li');\n536\t      li.className = c.pass ? 'ok' : 'bad';\n537\t      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n538\t      li.title = c.detail;\n539\t      return li;\n540\t    }),\n541\t  );\n542\t}\n543\t\n544\tif (auto) conformance();\n545\telse if ($('game').value) newRound();\n546\t</script>\n547\t</body>\n548\t</html>\n549\t"}]},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"8ce9b166-b178-4aae-b936-0878f256792e","timestamp":"2026-11-05T04:22:33.076Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/harness.html","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AI Hub Session Harness</title>\n<meta name=\"description\" content=\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\">\n<style>\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\n  body { display: grid; grid-template-rows: auto 1fr; }\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\n  input[type=number] { width: 70px; }\n  input.game { width: 300px; }\n  button { cursor: pointer; }\n  button:hover { border-color: var(--dim); }\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n  .cell.is-out { opacity: .35; }\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\n  #checks li { list-style: none; }\n  #checks ul { margin: 0; padding: 0; }\n  .ok::before { content: '✓ '; color: var(--ok); }\n  .bad::before { content: '✗ '; color: var(--bad); }\n  .wait::before { content: '… '; color: var(--warn); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n  const game = $('game').value.trim();\n  if (!game) return null;\n  if (!gameUrl(game)) {\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    return null;\n  }\n  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n  const metas = await metasOf(game);\n  const mode = modeOf(metas?.mode);\n  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n  const seed = params.has('seed') ? Number(params.get('seed')) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];\n  const round = ++roundNo;\n  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n  const hubEnd = net.endpoint('hub');\n  const grid = $('grid');\n  grid.replaceChildren();\n  const copies = n + (serverMode ? 1 : 0);\n  grid.style.gridTemplateColumns = copies > 1 ? '1fr 1fr' : '1fr';\n  grid.style.gridTemplateRows = `repeat(${Math.ceil(copies / (copies > 1 ? 2 : 1))}, 1fr)`;\n\n  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n  current = state;\n  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n\n  state.coordinator = createRound({\n    round,\n    players,\n    hostKey: 'p0',\n    serverKey: serverMode ? 'server' : null,\n    mode,\n    seed,\n    limitMs,\n    gate: true,\n    deliver: (key, m) => hubEnd.send(key, { k: 'h', r: round, m }),\n    onStatus: (s) => { state.status = s; render(state); },\n    onEnd: (record) => {\n      state.record = record;\n      log(`round ${round} ${record.status}: ${record.reason}${record.standings ? ' — standings ' + JSON.stringify(record.standings) : ''}`);\n      render(state);\n    },\n  });\n  hubEnd.onMessage((from, env) => {\n    if (env.k !== 'c' || env.r !== round) return;\n    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\n    state.coordinator.receive(from, env.m);\n  });\n\n  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n    const color = p.server ? '#8a8a8a' : ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][p.slot];\n    const frame = document.createElement('iframe');\n    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n    frame.title = p.name;\n    const label = document.createElement('div');\n    label.className = 'cell__bar';\n    label.innerHTML = `<span class=\"cell__dot\" style=\"background:${color}\"></span><b></b><span class=\"cell__state\"></span>`;\n    label.querySelector('b').textContent = `${p.name} (${p.key})`;\n    const el = document.createElement('div');\n    el.className = 'cell';\n    el.style.borderColor = color;\n    el.append(label, frame);\n    grid.append(el);\n\n    const endpoint = net.endpoint(p.key);\n    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n    const post = postTo(frame);\n    cell.bridge = createBridge({\n      key: p.key,\n      round,\n      coordinator: 'hub',\n      post: (msg) => {\n        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n        post(msg);\n      },\n      net: endpoint,\n      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n      onAnswer: (what) => answerCard(state, cell, what),\n      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n      onProgress: (id, report) => {\n        if (id !== cell.bridge?.me) return;\n        cell.progress.push({ at: performance.now(), ...report });\n        state.coordinator.progress(id, report.score);\n        render(state);\n      },\n    });\n    endpoint.onMessage((from, env) => cell.bridge.fromNet(from, env));\n    cell.detach = attachFrame(frame, (msg) => cell.bridge.fromGame(msg));\n    frame.addEventListener('load', () => instrument(cell), { once: true });\n    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n    state.cells.push(cell);\n  }\n  renderWho(state);\n  render(state);\n  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n  // the conformance run releases it itself.\n  const ticker = setInterval(() => {\n    if (state !== current || state.coordinator.released) return clearInterval(ticker);\n    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n    tickCard(state);\n  }, 250);\n  return state;\n}\n\nfunction releaseRound(state = current) {\n  if (!state || state !== current || state.coordinator.released) return;\n  state.splashUntil = null;\n  tickCard(state);\n  log('splash over: the round starts once every game has loaded');\n  state.coordinator.release();\n}\n\n/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\nfunction tickCard(state) {\n  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\n  const ready = state.cells.filter((c) => state.answers.ready.has(c.key)).map((c) => c.bridge.me);\n  for (const cell of state.cells) {\n    if (cell.gone || !cell.bridge.showsCard) continue;\n    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\n    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\n    if (cell.cardSent === id) continue;\n    cell.cardSent = id;\n    cell.bridge.card(card);\n  }\n}\n\n/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\nfunction answerCard(state, cell, what) {\n  if (state !== current || state.coordinator.released || cell.server) return;\n  const { ready, more } = state.answers;\n  if (what === 'ready') {\n    ready.add(cell.key);\n    more.delete(cell.key);\n  } else if (more.has(cell.key)) {\n    more.delete(cell.key);\n  } else {\n    more.add(cell.key);\n    ready.delete(cell.key);\n    state.splashUntil += 10_000;\n  }\n  log(`${cell.key} answers ${what} on the game's card`);\n  const players = state.cells.filter((c) => !c.server && !c.gone);\n  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n  tickCard(state);\n}\n\nfunction endCurrent() {\n  if (!current) return;\n  current.coordinator.abort('session-ended');\n  for (const cell of current.cells) removeCell(cell, false);\n  current.hubEnd.close();\n  current = null;\n}\n\nfunction removeCell(cell, tellRound = true) {\n  if (cell.gone) return;\n  cell.gone = true;\n  cell.detach();\n  cell.endpoint.close();\n  cell.frame.remove();\n  cell.el.classList.add('is-out');\n  if (tellRound) {\n    log(`${cell.key} left`);\n    current?.coordinator.leave(cell.key, 'left');\n  }\n}\n\nfunction renderWho(state) {\n  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n}\n\nfunction render(state) {\n  const s = state.status;\n  if (!s) return;\n  for (const cell of state.cells) {\n    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n    if (!p) continue;\n    const bits = [];\n    if (p.out) bits.push(`out: ${p.out}`);\n    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\n    else if (p.ready) bits.push('ready');\n    else if (p.hello) bits.push('welcomed');\n    else bits.push('loading');\n    const last = cell.progress.at(-1);\n    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\n    bits.push(`↑${cell.bridge.stats.sent} ↓${cell.bridge.stats.received}`);\n    cell.label.querySelector('.cell__state').textContent = bits.join(' · ');\n    cell.el.classList.toggle('is-out', !!p.out || cell.gone);\n  }\n  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\n  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\n  if (state.record) {\n    const name = (id) => s.players[id]?.name ?? `#${id}`;\n    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\n    if (state.record.standings) state.record.standings.forEach((ids, i) => lines.push(`  ${i + 1}. ${ids.map(name).join(', ')}`));\n  }\n  if (s.issues.length) lines.push(...s.issues.map((i) => `✗ ${i.key}: ${i.problem}`));\n  $('round').textContent = lines.join('\\n');\n}\n\n$('restart').onclick = () => newRound();\n$('release').onclick = () => releaseRound();\n$('timeup').onclick = () => current?.coordinator.timeUp();\n$('remove').onclick = () => {\n  const cell = current?.cells.find((c) => c.key === $('who').value);\n  if (cell) removeCell(cell);\n};\n$('hide').onclick = () => {\n  if (!current) return;\n  current.hidden = !current.hidden;\n  $('hide').setAttribute('aria-pressed', String(current.hidden));\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\n};\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\n\n/* ---------------------------------------------------------------------------\n * ?auto=1 — the conformance run. It presses keys inside each frame with\n * synthetic events while the round plays (the frames must be served from this\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\n * turns \"true\".\n * ------------------------------------------------------------------------- */\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nasync function until(test, ms) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    if (test()) return true;\n    await sleep(50);\n  }\n  return test();\n}\n\nfunction poke(cell, key) {\n  const doc = cell.frame.contentDocument;\n  const win = cell.frame.contentWindow;\n  if (!doc || !win) return false;\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n</script>\n</body>\n</html>\n","numLines":549,"startLine":1,"totalLines":549}},"tool_result_meta":[{"id":"toolu_014bVKkRm2cfLYDZmfaqfxWx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9DCYJiuyLpQguWZoXH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014bU3rPP29SZ7qgUMWfx1S6","name":"Bash","input":{"command":"gh api repos/michaelcrosato/ai-hub/contents/lib/hub/examples/parallel.html -H \"Accept: application/vnd.github.raw\" > ex-parallel.html && gh api repos/michaelcrosato/ai-hub/contents/lib/hub/examples/arena.html -H \"Accept: application/vnd.github.raw\" > ex-arena.html && gh api repos/michaelcrosato/ai-hub/contents/lib/hub/examples/ghost.html -H \"Accept: application/vnd.github.raw\" > ex-ghost.html; gh api repos/michaelcrosato/ai-hub/contents/ --jq '.[] | \"\\(.type)\\t\\(.path)\"' | head -40; echo ---; gh api repos/michaelcrosato/ai-hub/contents/README.md -H \"Accept: application/vnd.github.raw\" | head -120","description":"Fetch hub example games and the repository overview"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9172,"cache_read_input_tokens":42349,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9172},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"60eaa7c3-8857-4173-a9d5-9436ebf55122","timestamp":"2026-11-05T04:22:35.545Z","request_id":"req_011Cgj9DCHvTwpwPUmAdScfo","wire_tool_inputs":{"toolu_014bU3rPP29SZ7qgUMWfx1S6":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub && gh api repos/michaelcrosato/ai-hub/contents/lib/hub/examples/parallel.html -H \"Accept: application/vnd.github.raw\" > ex-parallel.html && gh api repos/michaelcrosato/ai-hub/contents/lib/hub/examples/arena.html -H \"Accept: application/vnd.github.raw\" > ex-arena.html && gh api repos/michaelcrosato/ai-hub/contents/lib/hub/examples/ghost.html -H \"Accept: application/vnd.github.raw\" > ex-ghost.html; gh api repos/michaelcrosato/ai-hub/contents/ --jq '.[] | \"\\(.type)\\t\\(.path)\"' | head -40; echo ---; gh api repos/michaelcrosato/ai-hub/contents/README.md -H \"Accept: application/vnd.github.raw\" | head -120","description":"Fetch hub example games and the repository overview"}},"wire_ingest_context":{"toolu_014bU3rPP29SZ7qgUMWfx1S6":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014bU3rPP29SZ7qgUMWfx1S6","type":"tool_result","content":"file\t.gitattributes\nfile\t.gitignore\nfile\t.vercelignore\nfile\tCLAUDE.md\nfile\tREADME.md\ndir\tassets\ndir\tatlas\ndir\tauth\ndir\tcatalogue\ndir\tcloudflare\ndir\tcouch\ndir\tcovers\ndir\tdata\ndir\tdeck\ndir\tdocs\ndir\tfriends\ndir\tgames\nfile\tindex.html\ndir\tlib\nfile\tpackage.json\nfile\tpnpm-workspace.yaml\ndir\tprivacy\ndir\tscripts\ndir\tsession\ndir\tsources\ndir\tsupabase\ndir\ttimeline\nfile\tvercel.json\n---\n# AI Hub\n\nAn arcade wall for games built by AI models. Games can be single HTML pages\nor project folders with their own code and assets; the hub finds them, dresses\nthem, and gets out of the way. Shared engines live in `lib/`.\n\n**Live:** <https://crosato-arcade.vercel.app> — public, no sign-in. This repo\nstays private; only the built site is reachable.\n\n---\n\n## Adding a game\n\nPut the `.html` file in `games/`. That is the whole procedure.\n\n```\ngames/Whatever_You_Called_It.html\n```\n\nReload the wall on `pnpm dev` and it is there; the public site gets it with\nthe next deploy. No code to touch, no list to edit, no naming rules to\nremember — mixed case, spaces, underscores and hyphens are all\nfine.\n\n```bash\ngit add games/ && git commit -m \"Add Whatever You Called It\" && git push\n```\n\n### Where the game's details come from\n\nNothing is typed in by hand. On every build, `scripts/scan.mjs` reads just the\n`<head>` of each file for catalogue metadata (the audio inventory also reads source text and asset paths):\n\n| From the game | Becomes |\n|---|---|\n| `<title>Undertow — Seven Guardians Below</title>` | Name **Undertow**, tagline **Seven Guardians Below** |\n| `<meta name=\"description\">` | The blurb in the drawer |\n| `<meta name=\"theme-color\">` | That cabinet's marquee colour and the light it throws |\n| `<link rel=\"icon\" href=\"data:…\">` | The emblem on its screen (a relative path works in a project folder) |\n| `<meta property=\"og:image\">` | Its cover art, in a project folder that ships the image |\n| file size, the date first added to the hub | The File size rail, the Newest sort |\n\nA game with none of these still works — it gets its filename as a name and a\ncolour derived from its slug.\n\n### Names on the wall\n\nNo two entries show the same name. When names collide (case and accents\nignored), the oldest entry, the first added to the hub, keeps the plain name\nand later ones are numbered in the order they were added: **Ashbound**,\n**Ashbound (2)**, **Ashbound (3)**. The scan does it on every build, so a\nduplicate needs no manual work, and nothing in the game file or the catalogue\nchanges. Search still finds each by its plain name, and attempts at one\noriginal still stack under it. `pnpm test` fails if two entries ever show the\nsame name. See [the 28 Oct curation](docs/curation-2026-10-28.md).\n\n### Several builds of one game\n\nTwo ways, whichever suits the moment:\n\n```\ngames/Void-Explorer-v0.4.html      ← same folder, version in the name\ngames/Void-Explorer-v0.5.html         v0.5 becomes current, v0.4 moves to history\n\ngames/void-explorer/v0.4.html      ← or a folder per game, files named as versions\ngames/void-explorer/v0.5.html\n```\n\nOne tile either way, showing the newest build, with the older ones a click away\nin its drawer.\n\nA version is only recognised when it is unmistakable: `-v2`, `-v0.4`, `-1.2`.\nA bare trailing number is left alone, so `snake-2.html` stays its own game\nrather than quietly becoming build 2 of `snake`. Hiding a game by accident is\nworse than showing one tile too many.\n\n### The library's naming convention\n\nAny name works, but the library names its files by source, so `games/` sorts\ninto families:\n\n```\ngames/Out-Run-SUPER-RUNOUT-The-coast-is-calling-2026-09-11-model-unknown.html\n      source  title                             made       model\n```\n\nThe source is the classic a game riffs on, or `original` when there is none;\n`model-unknown` is used until the model is known (`GPT-6-Astra-Pro`). A\nfilename cannot say where the source ends and the title begins (`Out-Run` or\n`Out-Run-SUPER`?), so the wall's Original and Inspired split reads the catalogue's `source`\nfield instead (see *Extra metadata*), and the filename only sorts the folder.\n\nThe scan reads the pattern. The date and model say when and by what a file was\nmade, not which game it is, so they stay out of the slug\n(`out-run-super-runout-the-coast-is-calling`), and the date becomes the day the\ngame joined the wall. A later file with the same source and title —\n`…-2026-10-02-model-unknown.html` — is a newer build of that game: one tile,\nthe newest in front, the older file in its drawer. To keep only the newest,\ndelete the older file.\n\nThe [2026-10-19 root HTML intake](docs/imports/2026-10-19-root-html-intake.json)\nuses `GameTitle-SOURCE-model-effort-YYYYMMDD-HHMM.html` for new entries. The\ntitle, inspiration, model and effort are also recorded in `data/overrides.json`,\nso the filename is not used as the display title. Explicit source dates and\ntimes take precedence; missing times use a documented file-modification or\nexport-time fallback in the audit. Arrival dates still record the actual\nimport time. Gemini defaults to Gemini 4 Argon and Muse to Muse Wonder 1 unless\nthe package states otherwise; missing details remain unknown. Exact duplicates\nkeep their existing URLs, and differing packages with uncertain revision\nlineage are kept as separate entries, numbered apart on the wall (see *Names\non the wall*). These names do not use\nthe older source-first filename grouping rule above.\n\n### Folders: collections and projects\n\nA folder under `games/` is one of three things, decided by what is in it:\n\n```\ngames/claude/snake.html            a folder of games is a COLLECTION: every file\ngames/claude/tetris.html           is its own tile, and a Collection rail appears","is_error":false}]},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"3044cab1-dc33-44b6-9922-aa80a6f83691","timestamp":"2026-11-05T04:22:38.448Z","tool_use_result":{"stdout":"file\t.gitattributes\nfile\t.gitignore\nfile\t.vercelignore\nfile\tCLAUDE.md\nfile\tREADME.md\ndir\tassets\ndir\tatlas\ndir\tauth\ndir\tcatalogue\ndir\tcloudflare\ndir\tcouch\ndir\tcovers\ndir\tdata\ndir\tdeck\ndir\tdocs\ndir\tfriends\ndir\tgames\nfile\tindex.html\ndir\tlib\nfile\tpackage.json\nfile\tpnpm-workspace.yaml\ndir\tprivacy\ndir\tscripts\ndir\tsession\ndir\tsources\ndir\tsupabase\ndir\ttimeline\nfile\tvercel.json\n---\n# AI Hub\n\nAn arcade wall for games built by AI models. Games can be single HTML pages\nor project folders with their own code and assets; the hub finds them, dresses\nthem, and gets out of the way. Shared engines live in `lib/`.\n\n**Live:** <https://crosato-arcade.vercel.app> — public, no sign-in. This repo\nstays private; only the built site is reachable.\n\n---\n\n## Adding a game\n\nPut the `.html` file in `games/`. That is the whole procedure.\n\n```\ngames/Whatever_You_Called_It.html\n```\n\nReload the wall on `pnpm dev` and it is there; the public site gets it with\nthe next deploy. No code to touch, no list to edit, no naming rules to\nremember — mixed case, spaces, underscores and hyphens are all\nfine.\n\n```bash\ngit add games/ && git commit -m \"Add Whatever You Called It\" && git push\n```\n\n### Where the game's details come from\n\nNothing is typed in by hand. On every build, `scripts/scan.mjs` reads just the\n`<head>` of each file for catalogue metadata (the audio inventory also reads source text and asset paths):\n\n| From the game | Becomes |\n|---|---|\n| `<title>Undertow — Seven Guardians Below</title>` | Name **Undertow**, tagline **Seven Guardians Below** |\n| `<meta name=\"description\">` | The blurb in the drawer |\n| `<meta name=\"theme-color\">` | That cabinet's marquee colour and the light it throws |\n| `<link rel=\"icon\" href=\"data:…\">` | The emblem on its screen (a relative path works in a project folder) |\n| `<meta property=\"og:image\">` | Its cover art, in a project folder that ships the image |\n| file size, the date first added to the hub | The File size rail, the Newest sort |\n\nA game with none of these still works — it gets its filename as a name and a\ncolour derived from its slug.\n\n### Names on the wall\n\nNo two entries show the same name. When names collide (case and accents\nignored), the oldest entry, the first added to the hub, keeps the plain name\nand later ones are numbered in the order they were added: **Ashbound**,\n**Ashbound (2)**, **Ashbound (3)**. The scan does it on every build, so a\nduplicate needs no manual work, and nothing in the game file or the catalogue\nchanges. Search still finds each by its plain name, and attempts at one\noriginal still stack under it. `pnpm test` fails if two entries ever show the\nsame name. See [the 28 Oct curation](docs/curation-2026-10-28.md).\n\n### Several builds of one game\n\nTwo ways, whichever suits the moment:\n\n```\ngames/Void-Explorer-v0.4.html      ← same folder, version in the name\ngames/Void-Explorer-v0.5.html         v0.5 becomes current, v0.4 moves to history\n\ngames/void-explorer/v0.4.html      ← or a folder per game, files named as versions\ngames/void-explorer/v0.5.html\n```\n\nOne tile either way, showing the newest build, with the older ones a click away\nin its drawer.\n\nA version is only recognised when it is unmistakable: `-v2`, `-v0.4`, `-1.2`.\nA bare trailing number is left alone, so `snake-2.html` stays its own game\nrather than quietly becoming build 2 of `snake`. Hiding a game by accident is\nworse than showing one tile too many.\n\n### The library's naming convention\n\nAny name works, but the library names its files by source, so `games/` sorts\ninto families:\n\n```\ngames/Out-Run-SUPER-RUNOUT-The-coast-is-calling-2026-09-11-model-unknown.html\n      source  title                             made       model\n```\n\nThe source is the classic a game riffs on, or `original` when there is none;\n`model-unknown` is used until the model is known (`GPT-6-Astra-Pro`). A\nfilename cannot say where the source ends and the title begins (`Out-Run` or\n`Out-Run-SUPER`?), so the wall's Original and Inspired split reads the catalogue's `source`\nfield instead (see *Extra metadata*), and the filename only sorts the folder.\n\nThe scan reads the pattern. The date and model say when and by what a file was\nmade, not which game it is, so they stay out of the slug\n(`out-run-super-runout-the-coast-is-calling`), and the date becomes the day the\ngame joined the wall. A later file with the same source and title —\n`…-2026-10-02-model-unknown.html` — is a newer build of that game: one tile,\nthe newest in front, the older file in its drawer. To keep only the newest,\ndelete the older file.\n\nThe [2026-10-19 root HTML intake](docs/imports/2026-10-19-root-html-intake.json)\nuses `GameTitle-SOURCE-model-effort-YYYYMMDD-HHMM.html` for new entries. The\ntitle, inspiration, model and effort are also recorded in `data/overrides.json`,\nso the filename is not used as the display title. Explicit source dates and\ntimes take precedence; missing times use a documented file-modification or\nexport-time fallback in the audit. Arrival dates still record the actual\nimport time. Gemini defaults to Gemini 4 Argon and Muse to Muse Wonder 1 unless\nthe package states otherwise; missing details remain unknown. Exact duplicates\nkeep their existing URLs, and differing packages with uncertain revision\nlineage are kept as separate entries, numbered apart on the wall (see *Names\non the wall*). These names do not use\nthe older source-first filename grouping rule above.\n\n### Folders: collections and projects\n\nA folder under `games/` is one of three things, decided by what is in it:\n\n```\ngames/claude/snake.html            a folder of games is a COLLECTION: every file\ngames/claude/tetris.html           is its own tile, and a Collection rail appears","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014bU3rPP29SZ7qgUMWfx1S6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
