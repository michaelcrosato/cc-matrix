const tex = new THREE.CanvasTexture(veins); tex.colorSpace = THREE.SRGBColorSpace; tex.anisotropy = 8;\n  const geo = new THREE.PlaneGeometry(3.6, 2.5, 280, 200); geo.rotateX(-Math.PI / 2);\n  const P = geo.attributes.position;\n  const lobe = (x, z, cx, cz, rx, rz, h) => h * Math.exp(-(((x - cx) / rx) ** 2 + ((z - cz) / rz) ** 2));\n  for (let i = 0; i < P.count; i++) {\n    const a = P.getX(i), b = P.getZ(i);\n    let h = lobe(a, b, -0.45, -0.1, 0.8, 0.55, 0.34) + lobe(a, b, 0.55, 0.05, 0.75, 0.5, 0.28) + lobe(a, b, 0.05, 0.55, 0.9, 0.35, 0.16);\n    h -= 0.06 * Math.exp(-(((a - 0.08 + 0.15 * Math.sin(b * 3)) / 0.07) ** 2));\n    h += 0.008 * Math.sin(a * 13 + 2 * Math.sin(b * 5)) * Math.cos(b * 11);\n    P.setY(i, h);\n  }\n  geo.computeVertexNormals();\n  const uBeat = uniform(0);\n  const mat = toon({ map: tex });\n  mat.positionNode = positionLocal.add(normalLocal.mul(uBeat.mul(0.03)));\n  const H = normalize(vec3(0.22, 0.62, 0.75));\n  const spec = smoothstep(0.962, 0.968, dot(normalView, H));\n  const spec2 = smoothstep(0.988, 0.99, dot(normalView, normalize(vec3(-0.35, 0.5, 0.8))));\n  mat.emissiveNode = vec3(1.0, 0.93, 0.9).mul(max(spec.mul(0.85), spec2.mul(0.6)));\n  const organ = new THREE.Mesh(geo, mat); organ.receiveShadow = true; scene.add(organ);\n\n  // drape with an irregular window\n  const shape = new THREE.Shape(); shape.moveTo(-5, -4); shape.lineTo(5, -4); shape.lineTo(5, 4); shape.lineTo(-5, 4); shape.lineTo(-5, -4);\n  const hole = new THREE.Path(); const N = 96;\n  for (let i = 0; i <= N; i++) { const a = (i / N) * Math.PI * 2; const r = 1 + 0.025 * Math.sin(a * 5) + 0.015 * Math.sin(a * 13 + 1); const px = Math.cos(a) * 1.5 * r, py = Math.sin(a) * 0.95 * r; if (i) hole.lineTo(px, py); else hole.moveTo(px, py); }\n  shape.holes.push(hole);\n  const dg = new THREE.ExtrudeGeometry(shape, { depth: 0.06, bevelEnabled: true, bevelSize: 0.03, bevelThickness: 0.03, bevelSegments: 2, curveSegments: 24, steps: 1 });\n  dg.rotateX(-Math.PI / 2);\n  const drape = new THREE.Mesh(dg, toon({ color: 0x17707a })); drape.position.y = 0.34; drape.receiveShadow = true; drape.castShadow = true; scene.add(drape);\n\n  // tray and glass shards\n  const tray = new THREE.Mesh(new THREE.BoxGeometry(0.62, 0.03, 0.9), toon({ color: 0xc5d2d8 })); tray.position.set(1.72, 0.42, 0.2); tray.castShadow = true; scene.add(tray);\n  for (const [sx, sz, sc, rot] of [[-0.55, 0.15, 0.11, 0.4], [0.5, -0.2, 0.09, 1.2], [0.12, 0.42, 0.08, 2.2]]) {\n    const s = new THREE.Mesh(new THREE.TetrahedronGeometry(sc, 0), toon({ color: 0x9fe8ff })); s.position.set(sx, 0.34, sz); s.rotation.set(rot, rot * 2, rot / 2); s.scale.y = 1.8; s.castShadow = true; scene.add(s);\n  }\n  // musical parasite: bead-chain body with stave stripes\n  const pc = document.createElement('canvas'); pc.width = pc.height = 256; const px = pc.getContext('2d'); px.fillStyle = '#2b1456'; px.fillRect(0, 0, 256, 256); px.fillStyle = '#d7f24a'; for (let i = 0; i < 5; i++) px.fillRect(0, 60 + i * 28, 256, 7);\n  const pt = new THREE.CanvasTexture(pc); pt.colorSpace = THREE.SRGBColorSpace; pt.wrapS = pt.wrapT = THREE.RepeatWrapping;\n  const curve = new THREE.CatmullRomCurve3([[-0.95, 0.42, -0.42], [-0.6, 0.5, -0.5], [-0.25, 0.54, -0.28], [0.05, 0.46, -0.45], [0.32, 0.46, -0.55]].map((v) => new THREE.Vector3(...v)));\n  const body = new THREE.Mesh(new THREE.TubeGeometry(curve, 80, 0.07, 14), toon({ map: pt })); body.castShadow = true; scene.add(body);\n  const head = new THREE.Mesh(new THREE.SphereGeometry(0.13, 24, 16), toon({ color: 0x2b1456 })); head.position.set(0.32, 0.5, -0.55); head.scale.set(1.25, 0.8, 0.95); head.rotation.z = 0.4; head.castShadow = true; scene.add(head);\n  const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.012, 0.42, 8), toon({ color: 0xd7f24a })); stem.position.set(0.44, 0.72, -0.56); stem.castShadow = true; scene.add(stem);\n  // scalpel\n  const scalpel = new THREE.Group();\n  const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.018,