{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QNqDo9bQna4z4dRuHgGwUV","type":"tool_result","content":"1\t/**\n2\t * round.js — one round of an AI Hub session, run by the hub that coordinates\n3\t * it (the harness page, or the session host's tab).\n4\t *\n5\t * It never touches the network or a frame itself: every message for a game\n6\t * goes out through `deliver(key, msg)`, and everything the games report comes\n7\t * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\n8\t * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\n9\t * without waiting for one.\n10\t *\n11\t * Players are known by `key` (whatever the session calls them); games see\n12\t * contiguous ids 0..N-1 in slot order.\n13\t */\n14\t\n15\texport const TIMINGS = Object.freeze({\n16\t  helloMs: 10_000,\n17\t  readyMs: 45_000,\n18\t  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n19\t  loadGraceMs: 20_000,\n20\t  countdownMs: 3_000,\n21\t  graceMs: 5_000,\n22\t  hiddenMs: 20_000,\n23\t  maxRoundMs: 15 * 60_000,\n24\t});\n25\t\n26\t/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\n27\texport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n28\t\n29\texport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n30\t\n31\t/** Each mode's name on screen. */\n32\texport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n33\t\n34\t/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\n35\tconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\n36\t\n37\t/** The mode a tag or a hello names, older tags included; null for anything else. */\n38\texport function modeOf(word) {\n39\t  const w = String(word ?? '').trim().toLowerCase();\n40\t  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\n41\t}\n42\t\n43\t/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\n44\texport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n45\t\n46\t/**\n47\t * Whether a game's round carries the seed in its address, so the client seeds\n48\t * Math.random and every copy starts the same: read from the game's own tag,\n49\t * parallel or ghost. A game still tagged race was built for an unseeded start\n50\t * (ids it makes from Math.random must differ between its copies), so it keeps one.\n51\t */\n52\texport const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n53\t\n54\tconst REAL_CLOCK = {\n55\t  now: () => Date.now(),\n56\t  setTimeout: (fn, ms) => setTimeout(fn, ms),\n57\t  clearTimeout: (handle) => clearTimeout(handle),\n58\t};\n59\t\n60\t/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\n61\texport function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\n62\t  const typical = Number(minutes);\n63\t  if (!(typical > 0)) return maxRoundMs;\n64\t  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\n65\t}\n66\t\n67\t/**\n68\t * Parallel and ghost order: finishers by time, then the rest by score,\n69\t * then anyone who reported nothing, tied last. Equal times or scores share a\n70\t * place.\n71\t */\n72\texport function rankResults(results, ids) {\n73\t  const timed = [];\n74\t  const scored = [];\n75\t  const silent = [];\n76\t  for (const id of ids) {\n77\t    const r = results.get(id);\n78\t    if (r && Number.isFinite(r.time)) timed.push([id, r.time]);\n79\t    else if (r && Number.isFinite(r.score)) scored.push([id, r.score]);\n80\t    else silent.push(id);\n81\t  }\n82\t  const groups = (list, order) => {\n83\t    list.sort((a, b) => order * (a[1] - b[1]) || a[0] - b[0]);\n84\t    const out = [];\n85\t    for (const [id, value] of list) {\n86\t      const last = out[out.length - 1];\n87\t      if (last && last.value === value) last.ids.push(id);\n88\t      else out.push({ value, ids: [id] });\n89\t    }\n90\t    return out.map((g) => g.ids);\n91\t  };\n92\t  return [...groups(timed, 1), ...groups(scored, -1), ...(silent.length ? [silent] : [])];\n93\t}\n94\t\n95\t/** A time or score as a number: finite, given as a number or as text; NaN for null, '' or true, which Number() would make 0. */\n96\tconst asNumber = (v) => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '') ? Number(v) : NaN);\n97\t\n98\t/** The protocol's limits on a round's highlights (README §10). */\n99\texport const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\n100\t\n101\t/** One player's stats, trimmed: up to six names, each a finite number or a short text. Null when none survive. */\n102\texport function cleanStats(stats) {\n103\t  if (!stats || typeof stats !== 'object' || Array.isArray(stats)) return null;\n104\t  const out = {};\n105\t  for (const [name, value] of Object.entries(stats).slice(0, HIGHLIGHTS.stats)) {\n106\t    const label = String(name).trim().slice(0, HIGHLIGHTS.statName);\n107\t    if (!label) continue;\n108\t    if (typeof value === 'number' && Number.isFinite(value)) out[label] = value;\n109\t    else if (typeof value === 'string' && value.trim()) out[label] = value.trim().slice(0, HIGHLIGHTS.statText);\n110\t  }\n111\t  return Object.keys(out).length ? out : null;\n112\t}\n113\t\n114\t/**\n115\t * Awards, trimmed: `{ id, title, detail? }`, at most three a player, for\n116\t * players of this round. A result's awards are about its own player: `self` is its id.\n117\t */\n118\texport function cleanAwards(awards, ids, self = null) {\n119\t  if (!Array.isArray(awards)) return [];\n120\t  const given = new Map();\n121\t  const out = [];\n122\t  for (const a of awards) {\n123\t    const id = self ?? a?.id;\n124\t    const title = String(a?.title ?? '').trim().slice(0, HIGHLIGHTS.title);\n125\t    if (!title || !ids.includes(id) || (given.get(id) || 0) >= HIGHLIGHTS.awards) continue;\n126\t    given.set(id, (given.get(id) || 0) + 1);\n127\t    const detail = String(a.detail ?? '').trim().slice(0, HIGHLIGHTS.detail);\n128\t    out.push(detail ? { id, title, detail } : { id, title });\n129\t  }\n130\t  return out;\n131\t}\n132\t\n133\t/**\n134\t * Check a host's standings: groups of ids, best first, every present player\n135\t * exactly once. Players already gone may be placed or left out; whoever is\n136\t * left out lands in a last group of their own.\n137\t */\n138\texport function checkStandings(standings, presentIds, allIds) {\n139\t  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\n140\t  const all = new Set(allIds);\n141\t  const seen = new Set();\n142\t  const groups = [];\n143\t  for (const group of standings) {\n144\t    const ids = Array.isArray(group) ? group : [group];\n145\t    const kept = [];\n146\t    for (const id of ids) {\n147\t      if (!Number.isInteger(id) || !all.has(id)) return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\n148\t      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\n149\t      seen.add(id);\n150\t      kept.push(id);\n151\t    }\n152\t    if (kept.length) groups.push(kept);\n153\t  }\n154\t  const missing = presentIds.filter((id) => !seen.has(id));\n155\t  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\n156\t  const absent = allIds.filter((id) => !seen.has(id));\n157\t  if (absent.length) groups.push(absent);\n158\t  return { ok: true, standings: groups };\n159\t}\n160\t\n161\t/**\n162\t * @param {object} o\n163\t * @param {number} o.round            round number, carried on every message\n164\t * @param {{key:string, slot:number, name:string}[]} o.players\n165\t * @param {string} o.hostKey          whose game runs a shared world\n166\t * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\n167\t *                                    instead (a server): one more copy after the players, welcomed\n168\t *                                    with server: true, never ranked; the round is void if it goes\n169\t * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\n170\t * @param {number} o.seed\n171\t * @param {number} o.limitMs\n172\t * @param {{now:()=>number, setTimeout:Function, clearTimeout:Function}} [o.clock]\n173\t * @param {(key:string, msg:object) => void} o.deliver\n174\t * @param {(status:object) => void} [o.onStatus]\n175\t * @param {(record:object) => void} [o.onEnd]\n176\t * @param {boolean} [o.gate]          the hub shows a splash and collects the players' ready itself:\n177\t *                                    games ready up once loaded, and the round starts on release()\n178\t */\n179\texport function createRound({\n180\t  round,\n181\t  players,\n182\t  hostKey,\n183\t  mode = null,\n184\t  seed,\n185\t  limitMs,\n186\t  clock = REAL_CLOCK,\n187\t  deliver,\n188\t  onStatus = () => {},\n189\t  onEnd = () => {},\n190\t  timings = TIMINGS,\n191\t  gate = false,\n192\t  serverKey = null,\n193\t}) {\n194\t  mode = modeOf(mode);\n195\t  const t = { ...TIMINGS, ...timings };\n196\t  const seats = [...players]\n197\t    .sort((a, b) => a.slot - b.slot)\n198\t    .map((p, id) => ({\n199\t      id,\n200\t      key: p.key,\n201\t      slot: p.slot,\n202\t      name: p.name,\n203\t      color: SLOT_COLORS[p.slot % SLOT_COLORS.length],\n204\t      hello: false,\n205\t      ready: false,\n206\t      out: null,\n207\t      result: null,\n208\t      /** The last progress score the hub saw: the result of a player who never reports one. */\n209\t      progress: null,\n210\t      stats: null,\n211\t      awards: [],\n212\t      caps: null,\n213\t      hidden: null,\n214\t    }));\n215\t  const server = serverKey\n216\t    ? { id: seats.length, key: serverKey, slot: null, name: 'Server', color: null, hello: false, ready: false, out: null, result: null, progress: null, stats: null, awards: [], caps: null, hidden: null }\n217\t    : null;\n218\t  /** Every copy in the round: the players, then the server when there is one. */\n219\t  const copies = server ? [...seats, server] : seats;\n220\t  const byKey = new Map(copies.map((s) => [s.key, s]));\n221\t  const ids = seats.map((s) => s.id);\n222\t  const host = server ?? byKey.get(hostKey) ?? seats[0];\n223\t  const timers = new Set();\n224\t  const issues = [];\n225\t  let phase = 'loading';\n226\t  let goAt = null;\n227\t  let record = null;\n228\t  let released = !gate;\n229\t\n230\t  const later = (ms, fn) => {\n231\t    const handle = clock.setTimeout(() => {\n232\t      timers.delete(handle);\n233\t      fn();\n234\t    }, Math.max(0, ms));\n235\t    timers.add(handle);\n236\t    return handle;\n237\t  };\n238\t  const cancel = (handle) => {\n239\t    if (handle == null) return;\n240\t    clock.clearTimeout(handle);\n241\t    timers.delete(handle);\n242\t  };\n243\t\n244\t  /** The players still in the round. */\n245\t  const present = () => seats.filter((s) => !s.out);\n246\t  /** The copies still in the round: the players, and the server. */\n247\t  const presentCopies = () => copies.filter((s) => !s.out);\n248\t  const selfReported = () => SELF_REPORTED.includes(mode);\n249\t  const needsHost = () => !selfReported();\n250\t  const send = (seat, msg) => deliver(seat.key, { round, ...msg });\n251\t  const toPresent = (msg, except = null) => {\n252\t    for (const s of presentCopies()) if (s !== except && s.hello) send(s, msg);\n253\t  };\n254\t  const issue = (seat, problem) => {\n255\t    issues.push({ key: seat?.key ?? null, id: seat?.id ?? null, problem });\n256\t    status();\n257\t  };\n258\t\n259\t  function status() {\n260\t    onStatus({\n261\t      round,\n262\t      phase,\n263\t      mode,\n264\t      host: host.id,\n265\t      goAt,\n266\t      gate,\n267\t      released,\n268\t      players: seats.map((s) => ({\n269\t        id: s.id,\n270\t        key: s.key,\n271\t        slot: s.slot,\n272\t        name: s.name,\n273\t        color: s.color,\n274\t        hello: s.hello,\n275\t        ready: s.ready,\n276\t        out: s.out,\n277\t        result: s.result,\n278\t        client: s.caps?.client ?? null,\n279\t      })),\n280\t      server: server && { id: server.id, key: server.key, hello: server.hello, ready: server.ready, out: server.out, client: server.caps?.client ?? null },\n281\t      issues: issues.slice(),\n282\t    });\n283\t  }\n284\t\n285\t  function welcome(seat) {\n286\t    send(seat, {\n287\t      type: 'welcome',\n288\t      me: seat.id,\n289\t      host: host.id,\n290\t      players: seats.map((s) => ({ id: s.id, name: s.name, color: s.color })),\n291\t      keys: copies.map((s) => s.key),\n292\t      mode,\n293\t      seed: seed >>> 0,\n294\t      limitMs,\n295\t      ...(gate ? { splash: true } : {}),\n296\t      ...(seat === server ? { server: true } : {}),\n297\t    });\n298\t    for (const s of seats) if (s.out) send(seat, { type: 'leave', id: s.id, reason: s.out });\n299\t  }\n300\t\n301\t  function markOut(seat, reason) {\n302\t    if (seat.out || phase === 'ended') return;\n303\t    seat.out = reason;\n304\t    cancel(seat.hidden);\n305\t    seat.hidden = null;\n306\t    toPresent({ type: 'leave', id: seat.id, reason });\n307\t    // A player who sat out is still at the hub: tell their game it is over for them.\n308\t    if (reason === 'not-ready' && seat.hello) send(seat, { type: 'end', reason: 'sat-out' });\n309\t  }\n310\t\n311\t  function settle() {\n312\t    if (phase === 'ended') return;\n313\t    const left = present();\n314\t    if (!left.length) return finishVoid('no-players');\n315\t    if (needsHost() && host.out) {\n316\t      return finishVoid(host.out === 'not-ready' ? 'host-not-ready' : 'host-left', phase === 'loading' ? 'void' : 'host-left');\n317\t    }\n318\t    if (phase === 'loading') {\n319\t      if (released && presentCopies().every((s) => s.ready)) begin();\n320\t      return;\n321\t    }\n322\t    if (selfReported() && left.every((s) => s.result)) finishResults();\n323\t  }\n324\t\n325\t  function begin() {\n326\t    phase = 'countdown';\n327\t    goAt = clock.now() + t.countdownMs;\n328\t    toPresent({ type: 'start', at: goAt });\n329\t    later(t.countdownMs, () => {\n330\t      if (phase === 'countdown') {\n331\t        phase = 'playing';\n332\t        status();\n333\t      }\n334\t    });\n335\t    later(t.countdownMs + limitMs, timeUp);\n336\t    status();\n337\t  }\n338\t\n339\t  function timeUp() {\n340\t    if (phase === 'ended' || phase === 'grace') return;\n341\t    phase = 'grace';\n342\t    toPresent({ type: 'time-up', graceMs: t.graceMs });\n343\t    later(t.graceMs, () => {\n344\t      if (phase === 'ended') return;\n345\t      if (selfReported()) finishResults();\n346\t      else finishVoid('no-result');\n347\t    });\n348\t    status();\n349\t  }\n350\t\n351\t  function finishResults() {\n352\t    // A player still here who never reported is ranked by the last progress the hub saw from them.\n353\t    const results = new Map(\n354\t      seats.filter((s) => s.result || (!s.out && Number.isFinite(s.progress))).map((s) => [s.id, s.result ?? { score: s.progress, fallback: true }])\n355\t    );\n356\t    // Whoever reported and then left keeps their place: only those who left with nothing count as beaten.\n357\t    const ranked = rankResults(results, seats.filter((s) => !s.out || s.result).map((s) => s.id));\n358\t    const gone = seats.filter((s) => s.out && !s.result).map((s) => s.id);\n359\t    const scores = {};\n360\t    for (const [id, r] of results) scores[id] = Number.isFinite(r.time) ? r.time : r.score;\n361\t    const stats = Object.fromEntries(seats.filter((s) => s.stats).map((s) => [s.id, s.stats]));\n362\t    const awards = seats.flatMap((s) => s.awards);\n363\t    finishPlayed(gone.length ? [...ranked, gone] : ranked, { scores, results: Object.fromEntries(results), stats, awards });\n364\t  }\n365\t\n366\t  function finishPlayed(standings, extra = {}) {\n367\t    end({ status: 'played', reason: 'finished', endReason: 'finished', standings, ...extra });\n368\t  }\n369\t\n370\t  function finishVoid(reason, endReason = 'void') {\n371\t    end({ status: 'void', reason, endReason, standings: null });\n372\t  }\n373\t\n374\t  function end(outcome) {\n375\t    if (phase === 'ended') return;\n376\t    phase = 'ended';\n377\t    for (const handle of timers) clock.clearTimeout(handle);\n378\t    timers.clear();\n379\t    const msg = { type: 'end', reason: outcome.endReason };\n380\t    if (outcome.standings) msg.standings = outcome.standings;\n381\t    toPresent(msg);\n382\t    record = {\n383\t      round,\n384\t      mode,\n385\t      hostId: host.id,\n386\t      ...outcome,\n387\t      players: seats.map((s) => ({ id: s.id, key: s.key, slot: s.slot, name: s.name, color: s.color, out: s.out })),\n388\t      issues: issues.slice(),\n389\t    };\n390\t    status();\n391\t    onEnd(record);\n392\t  }\n393\t\n394\t  function receive(key, msg) {\n395\t    const seat = byKey.get(key);\n396\t    if (!seat || !msg || typeof msg.type !== 'string' || phase === 'ended' || seat.out) return;\n397\t    switch (msg.type) {\n398\t      case 'hello': {\n399\t        if (seat.hello) return;\n400\t        seat.hello = true;\n401\t        seat.caps = { v: msg.v, client: msg.client, mode: msg.mode ?? null, seats: msg.seats ?? null, card: msg.card === true };\n402\t        if (msg.v !== 1) issue(seat, `hello speaks protocol ${JSON.stringify(msg.v)}, not 1`);\n403\t        const said = modeOf(msg.mode);\n404\t        if (!mode && said) mode = said;\n405\t        else if (msg.mode && said !== mode) issue(seat, `hello says mode ${msg.mode}, the round is ${mode}`);\n406\t        welcome(seat);\n407\t        status();\n408\t        return;\n409\t      }\n410\t      case 'ready':\n411\t        if (!seat.hello || seat.ready || phase !== 'loading') return;\n412\t        seat.ready = true;\n413\t        status();\n414\t        return settle();\n415\t      case 'result': {\n416\t        if (!selfReported()) return issue(seat, `result is for parallel and ghost; this round is ${mode}`);\n417\t        if (phase === 'loading') return issue(seat, 'result before start');\n418\t        if (seat.result) return;\n419\t        const time = asNumber(msg.time);\n420\t        const score = asNumber(msg.score);\n421\t        if (Number.isFinite(time)) seat.result = { time };\n422\t        else if (Number.isFinite(score)) seat.result = { score };\n423\t        else return issue(seat, 'result needs a finite time or score');\n424\t        seat.stats = cleanStats(msg.stats);\n425\t        seat.awards = cleanAwards(msg.awards, ids, seat.id);\n426\t        status();\n427\t        return settle();\n428\t      }\n429\t      case 'finish': {\n430\t        if (selfReported()) return issue(seat, `finish is for a shared world; ${mode} games report result`);\n431\t        if (seat !== host) return issue(seat, 'finish from a player who is not the host');\n432\t        if (phase === 'loading') return issue(seat, 'finish before start');\n433\t        const checked = checkStandings(msg.standings, present().map((s) => s.id), ids);\n434\t        if (!checked.ok) return issue(seat, `finish ignored: ${checked.problem}`);\n435\t        const scores = msg.scores && typeof msg.scores === 'object' ? msg.scores : undefined;\n436\t        const given = msg.stats && typeof msg.stats === 'object' ? msg.stats : {};\n437\t        const stats = Object.fromEntries(ids.map((id) => [id, cleanStats(given[id])]).filter(([, v]) => v));\n438\t        const awards = cleanAwards(msg.awards, ids);\n439\t        // won makes it a team result; a game tagged co-op that leaves it out lost, as co-op always read it.\n440\t        const won = typeof msg.won === 'boolean' ? msg.won : seat.caps?.mode === 'co-op' ? false : undefined;\n441\t        return finishPlayed(checked.standings, { scores, won, stats, awards });\n442\t      }\n443\t      case 'error':\n444\t        issue(seat, `game error: ${String(msg.message || '').slice(0, 200)}`);\n445\t        if (msg.fatal) {\n446\t          if (needsHost() && seat === host) return finishVoid('host-error');\n447\t          markOut(seat, 'disconnected');\n448\t          status();\n449\t          settle();\n450\t        }\n451\t        return;\n452\t      case 'vis':\n453\t        if (seat !== host || !needsHost()) return;\n454\t        if (msg.hidden && seat.hidden == null && phase !== 'loading') {\n455\t          seat.hidden = later(t.hiddenMs, () => finishVoid('host-hidden'));\n456\t        } else if (!msg.hidden) {\n457\t          cancel(seat.hidden);\n458\t          seat.hidden = null;\n459\t        }\n460\t        return;\n461\t      default:\n462\t        return issue(seat, `unknown message type ${JSON.stringify(msg.type)}`);\n463\t    }\n464\t  }\n465\t\n466\t  function leave(key, reason = 'left') {\n467\t    const seat = byKey.get(key);\n468\t    if (!seat || seat.out || phase === 'ended') return;\n469\t    markOut(seat, reason);\n470\t    status();\n471\t    settle();\n472\t  }\n473\t\n474\t  const sitOut = (test) => () => {\n475\t    if (phase !== 'loading') return;\n476\t    for (const s of copies) if (test(s) && !s.out) markOut(s, 'not-ready');\n477\t    status();\n478\t    settle();\n479\t  };\n480\t\n481\t  function startRound() {\n482\t    // A gated round waits on the hub's splash, however long it holds: only\n483\t    // release() starts the clock on the games that are still loading.\n484\t    if (!gate) {\n485\t      later(t.helloMs, sitOut((s) => !s.hello));\n486\t      later(t.readyMs, sitOut((s) => !s.ready));\n487\t    }\n488\t    status();\n489\t  }\n490\t\n491\t  /** The splash is over: start as soon as every game has loaded, and wait loadGraceMs at most for the slow ones. */\n492\t  function release() {\n493\t    if (released || phase !== 'loading') return;\n494\t    released = true;\n495\t    later(t.loadGraceMs, sitOut((s) => !s.ready));\n496\t    status();\n497\t    settle();\n498\t  }\n499\t\n500\t  startRound();\n501\t\n502\t  return {\n503\t    receive,\n504\t    leave,\n505\t    release,\n506\t    /** Call time now, as the cap would: the host pressed \"End round\". */\n507\t    timeUp() {\n508\t      if (phase === 'countdown' || phase === 'playing') timeUp();\n509\t    },\n510\t    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\n511\t    progress(id, score) {\n512\t      const seat = seats[id];\n513\t      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\n514\t    },\n515\t    /** End the round now: the session ended, or the host skipped this game. */\n516\t    abort(reason = 'skipped') {\n517\t      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\n518\t    },\n519\t    get phase() {\n520\t      return phase;\n521\t    },\n522\t    get released() {\n523\t      return released;\n524\t    },\n525\t    get record() {\n526\t      return record;\n527\t    },\n528\t    get mode() {\n529\t      return mode;\n530\t    },\n531\t    seats: () => seats.map((s) => ({ ...s, hidden: undefined })),\n532\t  };\n533\t}\n534\t"}]},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"29690533-aa6e-4d08-bdb3-45a23c8bea28","timestamp":"2026-11-05T04:22:41.737Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/round.js","content":"/**\n * round.js — one round of an AI Hub session, run by the hub that coordinates\n * it (the harness page, or the session host's tab).\n *\n * It never touches the network or a frame itself: every message for a game\n * goes out through `deliver(key, msg)`, and everything the games report comes\n * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\n * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\n * without waiting for one.\n *\n * Players are known by `key` (whatever the session calls them); games see\n * contiguous ids 0..N-1 in slot order.\n */\n\nexport const TIMINGS = Object.freeze({\n  helloMs: 10_000,\n  readyMs: 45_000,\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n  loadGraceMs: 20_000,\n  countdownMs: 3_000,\n  graceMs: 5_000,\n  hiddenMs: 20_000,\n  maxRoundMs: 15 * 60_000,\n});\n\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n\n/** Each mode's name on screen. */\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\n\n/** The mode a tag or a hello names, older tags included; null for anything else. */\nexport function modeOf(word) {\n  const w = String(word ?? '').trim().toLowerCase();\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\n}\n\n/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\nexport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n\n/**\n * Whether a game's round carries the seed in its address, so the client seeds\n * Math.random and every copy starts the same: read from the game's own tag,\n * parallel or ghost. A game still tagged race was built for an unseeded start\n * (ids it makes from Math.random must differ between its copies), so it keeps one.\n */\nexport const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n\nconst REAL_CLOCK = {\n  now: () => Date.now(),\n  setTimeout: (fn, ms) => setTimeout(fn, ms),\n  clearTimeout: (handle) => clearTimeout(handle),\n};\n\n/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\nexport function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\n  const typical = Number(minutes);\n  if (!(typical > 0)) return maxRoundMs;\n  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\n}\n\n/**\n * Parallel and ghost order: finishers by time, then the rest by score,\n * then anyone who reported nothing, tied last. Equal times or scores share a\n * place.\n */\nexport function rankResults(results, ids) {\n  const timed = [];\n  const scored = [];\n  const silent = [];\n  for (const id of ids) {\n    const r = results.get(id);\n    if (r && Number.isFinite(r.time)) timed.push([id, r.time]);\n    else if (r && Number.isFinite(r.score)) scored.push([id, r.score]);\n    else silent.push(id);\n  }\n  const groups = (list, order) => {\n    list.sort((a, b) => order * (a[1] - b[1]) || a[0] - b[0]);\n    const out = [];\n    for (const [id, value] of list) {\n      const last = out[out.length - 1];\n      if (last && last.value === value) last.ids.push(id);\n      else out.push({ value, ids: [id] });\n    }\n    return out.map((g) => g.ids);\n  };\n  return [...groups(timed, 1), ...groups(scored, -1), ...(silent.length ? [silent] : [])];\n}\n\n/** A time or score as a number: finite, given as a number or as text; NaN for null, '' or true, which Number() would make 0. */\nconst asNumber = (v) => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '') ? Number(v) : NaN);\n\n/** The protocol's limits on a round's highlights (README §10). */\nexport const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\n\n/** One player's stats, trimmed: up to six names, each a finite number or a short text. Null when none survive. */\nexport function cleanStats(stats) {\n  if (!stats || typeof stats !== 'object' || Array.isArray(stats)) return null;\n  const out = {};\n  for (const [name, value] of Object.entries(stats).slice(0, HIGHLIGHTS.stats)) {\n    const label = String(name).trim().slice(0, HIGHLIGHTS.statName);\n    if (!label) continue;\n    if (typeof value === 'number' && Number.isFinite(value)) out[label] = value;\n    else if (typeof value === 'string' && value.trim()) out[label] = value.trim().slice(0, HIGHLIGHTS.statText);\n  }\n  return Object.keys(out).length ? out : null;\n}\n\n/**\n * Awards, trimmed: `{ id, title, detail? }`, at most three a player, for\n * players of this round. A result's awards are about its own player: `self` is its id.\n */\nexport function cleanAwards(awards, ids, self = null) {\n  if (!Array.isArray(awards)) return [];\n  const given = new Map();\n  const out = [];\n  for (const a of awards) {\n    const id = self ?? a?.id;\n    const title = String(a?.title ?? '').trim().slice(0, HIGHLIGHTS.title);\n    if (!title || !ids.includes(id) || (given.get(id) || 0) >= HIGHLIGHTS.awards) continue;\n    given.set(id, (given.get(id) || 0) + 1);\n    const detail = String(a.detail ?? '').trim().slice(0, HIGHLIGHTS.detail);\n    out.push(detail ? { id, title, detail } : { id, title });\n  }\n  return out;\n}\n\n/**\n * Check a host's standings: groups of ids, best first, every present player\n * exactly once. Players already gone may be placed or left out; whoever is\n * left out lands in a last group of their own.\n */\nexport function checkStandings(standings, presentIds, allIds) {\n  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\n  const all = new Set(allIds);\n  const seen = new Set();\n  const groups = [];\n  for (const group of standings) {\n    const ids = Array.isArray(group) ? group : [group];\n    const kept = [];\n    for (const id of ids) {\n      if (!Number.isInteger(id) || !all.has(id)) return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\n      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\n      seen.add(id);\n      kept.push(id);\n    }\n    if (kept.length) groups.push(kept);\n  }\n  const missing = presentIds.filter((id) => !seen.has(id));\n  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\n  const absent = allIds.filter((id) => !seen.has(id));\n  if (absent.length) groups.push(absent);\n  return { ok: true, standings: groups };\n}\n\n/**\n * @param {object} o\n * @param {number} o.round            round number, carried on every message\n * @param {{key:string, slot:number, name:string}[]} o.players\n * @param {string} o.hostKey          whose game runs a shared world\n * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\n *                                    instead (a server): one more copy after the players, welcomed\n *                                    with server: true, never ranked; the round is void if it goes\n * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\n * @param {number} o.seed\n * @param {number} o.limitMs\n * @param {{now:()=>number, setTimeout:Function, clearTimeout:Function}} [o.clock]\n * @param {(key:string, msg:object) => void} o.deliver\n * @param {(status:object) => void} [o.onStatus]\n * @param {(record:object) => void} [o.onEnd]\n * @param {boolean} [o.gate]          the hub shows a splash and collects the players' ready itself:\n *                                    games ready up once loaded, and the round starts on release()\n */\nexport function createRound({\n  round,\n  players,\n  hostKey,\n  mode = null,\n  seed,\n  limitMs,\n  clock = REAL_CLOCK,\n  deliver,\n  onStatus = () => {},\n  onEnd = () => {},\n  timings = TIMINGS,\n  gate = false,\n  serverKey = null,\n}) {\n  mode = modeOf(mode);\n  const t = { ...TIMINGS, ...timings };\n  const seats = [...players]\n    .sort((a, b) => a.slot - b.slot)\n    .map((p, id) => ({\n      id,\n      key: p.key,\n      slot: p.slot,\n      name: p.name,\n      color: SLOT_COLORS[p.slot % SLOT_COLORS.length],\n      hello: false,\n      ready: false,\n      out: null,\n      result: null,\n      /** The last progress score the hub saw: the result of a player who never reports one. */\n      progress: null,\n      stats: null,\n      awards: [],\n      caps: null,\n      hidden: null,\n    }));\n  const server = serverKey\n    ? { id: seats.length, key: serverKey, slot: null, name: 'Server', color: null, hello: false, ready: false, out: null, result: null, progress: null, stats: null, awards: [], caps: null, hidden: null }\n    : null;\n  /** Every copy in the round: the players, then the server when there is one. */\n  const copies = server ? [...seats, server] : seats;\n  const byKey = new Map(copies.map((s) => [s.key, s]));\n  const ids = seats.map((s) => s.id);\n  const host = server ?? byKey.get(hostKey) ?? seats[0];\n  const timers = new Set();\n  const issues = [];\n  let phase = 'loading';\n  let goAt = null;\n  let record = null;\n  let released = !gate;\n\n  const later = (ms, fn) => {\n    const handle = clock.setTimeout(() => {\n      timers.delete(handle);\n      fn();\n    }, Math.max(0, ms));\n    timers.add(handle);\n    return handle;\n  };\n  const cancel = (handle) => {\n    if (handle == null) return;\n    clock.clearTimeout(handle);\n    timers.delete(handle);\n  };\n\n  /** The players still in the round. */\n  const present = () => seats.filter((s) => !s.out);\n  /** The copies still in the round: the players, and the server. */\n  const presentCopies = () => copies.filter((s) => !s.out);\n  const selfReported = () => SELF_REPORTED.includes(mode);\n  const needsHost = () => !selfReported();\n  const send = (seat, msg) => deliver(seat.key, { round, ...msg });\n  const toPresent = (msg, except = null) => {\n    for (const s of presentCopies()) if (s !== except && s.hello) send(s, msg);\n  };\n  const issue = (seat, problem) => {\n    issues.push({ key: seat?.key ?? null, id: seat?.id ?? null, problem });\n    status();\n  };\n\n  function status() {\n    onStatus({\n      round,\n      phase,\n      mode,\n      host: host.id,\n      goAt,\n      gate,\n      released,\n      players: seats.map((s) => ({\n        id: s.id,\n        key: s.key,\n        slot: s.slot,\n        name: s.name,\n        color: s.color,\n        hello: s.hello,\n        ready: s.ready,\n        out: s.out,\n        result: s.result,\n        client: s.caps?.client ?? null,\n      })),\n      server: server && { id: server.id, key: server.key, hello: server.hello, ready: server.ready, out: server.out, client: server.caps?.client ?? null },\n      issues: issues.slice(),\n    });\n  }\n\n  function welcome(seat) {\n    send(seat, {\n      type: 'welcome',\n      me: seat.id,\n      host: host.id,\n      players: seats.map((s) => ({ id: s.id, name: s.name, color: s.color })),\n      keys: copies.map((s) => s.key),\n      mode,\n      seed: seed >>> 0,\n      limitMs,\n      ...(gate ? { splash: true } : {}),\n      ...(seat === server ? { server: true } : {}),\n    });\n    for (const s of seats) if (s.out) send(seat, { type: 'leave', id: s.id, reason: s.out });\n  }\n\n  function markOut(seat, reason) {\n    if (seat.out || phase === 'ended') return;\n    seat.out = reason;\n    cancel(seat.hidden);\n    seat.hidden = null;\n    toPresent({ type: 'leave', id: seat.id, reason });\n    // A player who sat out is still at the hub: tell their game it is over for them.\n    if (reason === 'not-ready' && seat.hello) send(seat, { type: 'end', reason: 'sat-out' });\n  }\n\n  function settle() {\n    if (phase === 'ended') return;\n    const left = present();\n    if (!left.length) return finishVoid('no-players');\n    if (needsHost() && host.out) {\n      return finishVoid(host.out === 'not-ready' ? 'host-not-ready' : 'host-left', phase === 'loading' ? 'void' : 'host-left');\n    }\n    if (phase === 'loading') {\n      if (released && presentCopies().every((s) => s.ready)) begin();\n      return;\n    }\n    if (selfReported() && left.every((s) => s.result)) finishResults();\n  }\n\n  function begin() {\n    phase = 'countdown';\n    goAt = clock.now() + t.countdownMs;\n    toPresent({ type: 'start', at: goAt });\n    later(t.countdownMs, () => {\n      if (phase === 'countdown') {\n        phase = 'playing';\n        status();\n      }\n    });\n    later(t.countdownMs + limitMs, timeUp);\n    status();\n  }\n\n  function timeUp() {\n    if (phase === 'ended' || phase === 'grace') return;\n    phase = 'grace';\n    toPresent({ type: 'time-up', graceMs: t.graceMs });\n    later(t.graceMs, () => {\n      if (phase === 'ended') return;\n      if (selfReported()) finishResults();\n      else finishVoid('no-result');\n    });\n    status();\n  }\n\n  function finishResults() {\n    // A player still here who never reported is ranked by the last progress the hub saw from them.\n    const results = new Map(\n      seats.filter((s) => s.result || (!s.out && Number.isFinite(s.progress))).map((s) => [s.id, s.result ?? { score: s.progress, fallback: true }])\n    );\n    // Whoever reported and then left keeps their place: only those who left with nothing count as beaten.\n    const ranked = rankResults(results, seats.filter((s) => !s.out || s.result).map((s) => s.id));\n    const gone = seats.filter((s) => s.out && !s.result).map((s) => s.id);\n    const scores = {};\n    for (const [id, r] of results) scores[id] = Number.isFinite(r.time) ? r.time : r.score;\n    const stats = Object.fromEntries(seats.filter((s) => s.stats).map((s) => [s.id, s.stats]));\n    const awards = seats.flatMap((s) => s.awards);\n    finishPlayed(gone.length ? [...ranked, gone] : ranked, { scores, results: Object.fromEntries(results), stats, awards });\n  }\n\n  function finishPlayed(standings, extra = {}) {\n    end({ status: 'played', reason: 'finished', endReason: 'finished', standings, ...extra });\n  }\n\n  function finishVoid(reason, endReason = 'void') {\n    end({ status: 'void', reason, endReason, standings: null });\n  }\n\n  function end(outcome) {\n    if (phase === 'ended') return;\n    phase = 'ended';\n    for (const handle of timers) clock.clearTimeout(handle);\n    timers.clear();\n    const msg = { type: 'end', reason: outcome.endReason };\n    if (outcome.standings) msg.standings = outcome.standings;\n    toPresent(msg);\n    record = {\n      round,\n      mode,\n      hostId: host.id,\n      ...outcome,\n      players: seats.map((s) => ({ id: s.id, key: s.key, slot: s.slot, name: s.name, color: s.color, out: s.out })),\n      issues: issues.slice(),\n    };\n    status();\n    onEnd(record);\n  }\n\n  function receive(key, msg) {\n    const seat = byKey.get(key);\n    if (!seat || !msg || typeof msg.type !== 'string' || phase === 'ended' || seat.out) return;\n    switch (msg.type) {\n      case 'hello': {\n        if (seat.hello) return;\n        seat.hello = true;\n        seat.caps = { v: msg.v, client: msg.client, mode: msg.mode ?? null, seats: msg.seats ?? null, card: msg.card === true };\n        if (msg.v !== 1) issue(seat, `hello speaks protocol ${JSON.stringify(msg.v)}, not 1`);\n        const said = modeOf(msg.mode);\n        if (!mode && said) mode = said;\n        else if (msg.mode && said !== mode) issue(seat, `hello says mode ${msg.mode}, the round is ${mode}`);\n        welcome(seat);\n        status();\n        return;\n      }\n      case 'ready':\n        if (!seat.hello || seat.ready || phase !== 'loading') return;\n        seat.ready = true;\n        status();\n        return settle();\n      case 'result': {\n        if (!selfReported()) return issue(seat, `result is for parallel and ghost; this round is ${mode}`);\n        if (phase === 'loading') return issue(seat, 'result before start');\n        if (seat.result) return;\n        const time = asNumber(msg.time);\n        const score = asNumber(msg.score);\n        if (Number.isFinite(time)) seat.result = { time };\n        else if (Number.isFinite(score)) seat.result = { score };\n        else return issue(seat, 'result needs a finite time or score');\n        seat.stats = cleanStats(msg.stats);\n        seat.awards = cleanAwards(msg.awards, ids, seat.id);\n        status();\n        return settle();\n      }\n      case 'finish': {\n        if (selfReported()) return issue(seat, `finish is for a shared world; ${mode} games report result`);\n        if (seat !== host) return issue(seat, 'finish from a player who is not the host');\n        if (phase === 'loading') return issue(seat, 'finish before start');\n        const checked = checkStandings(msg.standings, present().map((s) => s.id), ids);\n        if (!checked.ok) return issue(seat, `finish ignored: ${checked.problem}`);\n        const scores = msg.scores && typeof msg.scores === 'object' ? msg.scores : undefined;\n        const given = msg.stats && typeof msg.stats === 'object' ? msg.stats : {};\n        const stats = Object.fromEntries(ids.map((id) => [id, cleanStats(given[id])]).filter(([, v]) => v));\n        const awards = cleanAwards(msg.awards, ids);\n        // won makes it a team result; a game tagged co-op that leaves it out lost, as co-op always read it.\n        const won = typeof msg.won === 'boolean' ? msg.won : seat.caps?.mode === 'co-op' ? false : undefined;\n        return finishPlayed(checked.standings, { scores, won, stats, awards });\n      }\n      case 'error':\n        issue(seat, `game error: ${String(msg.message || '').slice(0, 200)}`);\n        if (msg.fatal) {\n          if (needsHost() && seat === host) return finishVoid('host-error');\n          markOut(seat, 'disconnected');\n          status();\n          settle();\n        }\n        return;\n      case 'vis':\n        if (seat !== host || !needsHost()) return;\n        if (msg.hidden && seat.hidden == null && phase !== 'loading') {\n          seat.hidden = later(t.hiddenMs, () => finishVoid('host-hidden'));\n        } else if (!msg.hidden) {\n          cancel(seat.hidden);\n          seat.hidden = null;\n        }\n        return;\n      default:\n        return issue(seat, `unknown message type ${JSON.stringify(msg.type)}`);\n    }\n  }\n\n  function leave(key, reason = 'left') {\n    const seat = byKey.get(key);\n    if (!seat || seat.out || phase === 'ended') return;\n    markOut(seat, reason);\n    status();\n    settle();\n  }\n\n  const sitOut = (test) => () => {\n    if (phase !== 'loading') return;\n    for (const s of copies) if (test(s) && !s.out) markOut(s, 'not-ready');\n    status();\n    settle();\n  };\n\n  function startRound() {\n    // A gated round waits on the hub's splash, however long it holds: only\n    // release() starts the clock on the games that are still loading.\n    if (!gate) {\n      later(t.helloMs, sitOut((s) => !s.hello));\n      later(t.readyMs, sitOut((s) => !s.ready));\n    }\n    status();\n  }\n\n  /** The splash is over: start as soon as every game has loaded, and wait loadGraceMs at most for the slow ones. */\n  function release() {\n    if (released || phase !== 'loading') return;\n    released = true;\n    later(t.loadGraceMs, sitOut((s) => !s.ready));\n    status();\n    settle();\n  }\n\n  startRound();\n\n  return {\n    receive,\n    leave,\n    release,\n    /** Call time now, as the cap would: the host pressed \"End round\". */\n    timeUp() {\n      if (phase === 'countdown' || phase === 'playing') timeUp();\n    },\n    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\n    progress(id, score) {\n      const seat = seats[id];\n      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\n    },\n    /** End the round now: the session ended, or the host skipped this game. */\n    abort(reason = 'skipped') {\n      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\n    },\n    get phase() {\n      return phase;\n    },\n    get released() {\n      return released;\n    },\n    get record() {\n      return record;\n    },\n    get mode() {\n      return mode;\n    },\n    seats: () => seats.map((s) => ({ ...s, hidden: undefined })),\n  };\n}\n","numLines":534,"startLine":1,"totalLines":534}},"tool_result_meta":[{"id":"toolu_01QNqDo9bQna4z4dRuHgGwUV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9Dp8whbaRhGtiqbhFV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015M2fUhPNfchiqcCKDymdQ6","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/bridge.js"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":23156,"cache_read_input_tokens":51521,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":23156},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"979b926e-69f6-4b96-939f-6df469d2bc5d","timestamp":"2026-11-05T04:22:42.459Z","request_id":"req_011Cgj9DotozD9FU9rbeoEiz","wire_tool_inputs":{"toolu_015M2fUhPNfchiqcCKDymdQ6":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/bridge.js"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015M2fUhPNfchiqcCKDymdQ6","type":"tool_result","content":"1\t/**\n2\t * bridge.js — the hub's end of one game frame in a session.\n3\t *\n4\t * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\n5\t * The bridge checks every message, enforces the limits, and routes it: control\n6\t * messages (hello, ready, result, finish, error) to whoever coordinates the\n7\t * round (lib/hub/round.js), game traffic straight to the other players, and a\n8\t * game's answers on its own card to the page that holds it. What\n9\t * comes back from the network is checked again before it reaches the game,\n10\t * and anything from another round is dropped, so a slow packet can never land\n11\t * in the next game.\n12\t *\n13\t * The network is anything with `send(toKey, envelope, {reliable})`: the\n14\t * simulated one below (harness, tests), a BroadcastChannel between tabs, or a\n15\t * WebRTC mesh. Envelopes:\n16\t *   {k:'c', r, m}       to the coordinator: a message from this game\n17\t *   {k:'h', r, m}       from the coordinator: welcome, start, leave, time-up, end\n18\t *   {k:'g', r, f, d}    game traffic from player id f\n19\t *   {k:'p', r, f, d}    player id f's progress, {score, label}, for the scoreboard\n20\t */\n21\t\n22\texport const LIMITS = Object.freeze({\n23\t  maxBytes: 16_384,\n24\t  ratePerS: 20,\n25\t  burst: 40,\n26\t  queueMessages: 64,\n27\t  queueBytes: 262_144,\n28\t  /**\n29\t   * progress() reaches the hub about once a second. Two closer than this are a\n30\t   * report delivered late (a long task in the game) or a client misbehaving:\n31\t   * the later is dropped, and the next report, a second on, has the newest score.\n32\t   */\n33\t  progressMs: 250,\n34\t  label: 24,\n35\t});\n36\t\n37\tconst FROM_GAME = new Set(['hello', 'ready', 'send', 'result', 'finish', 'error', 'progress', 'fullscreen', 'answer']);\n38\t\n39\t/** A progress report, checked: a finite score and an optional short label. Null when it is not one. */\n40\texport function cleanProgress(p) {\n41\t  if (!p || typeof p !== 'object') return null;\n42\t  // A number, or text that is one: never null, '', true or [], which Number() would make 0 or 1.\n43\t  const score = typeof p.score === 'number' || (typeof p.score === 'string' && p.score.trim() !== '') ? Number(p.score) : NaN;\n44\t  if (!Number.isFinite(score)) return null;\n45\t  const label = typeof p.label === 'string' ? p.label.trim().slice(0, LIMITS.label) : '';\n46\t  return label ? { score, label } : { score };\n47\t}\n48\t\n49\t/**\n50\t * @param {object} o\n51\t * @param {string} o.key              this player's key in the session\n52\t * @param {number} o.round\n53\t * @param {string} o.coordinator      key of whoever runs round.js\n54\t * @param {(msg:object) => void} o.post            to the game frame\n55\t * @param {{send:Function}} o.net\n56\t * @param {{now:()=>number}} [o.clock]             the coordinator's time, as seen here\n57\t * @param {(issue:{key:string, problem:string}) => void} [o.onIssue]\n58\t * @param {(id:number, progress:{score:number, label?:string}) => void} [o.onProgress]   a player's\n59\t *        progress, this one's included, for the hub's scoreboard; it never reaches the games\n60\t * @param {(on:boolean) => void} [o.onFullscreen]   the game asked for fullscreen (or out of it): the\n61\t *        hub's page takes it, so the hub's own cards stay over the game\n62\t * @param {(what:'ready'|'more') => void} [o.onAnswer]   this player answered on the game's own card\n63\t */\n64\texport function createBridge({ key, round, coordinator, post, net, clock = Date, onIssue = () => {}, onProgress = () => {}, onFullscreen = () => {}, onAnswer = () => {} }) {\n65\t  let welcomed = false;\n66\t  let ended = false;\n67\t  let started = false;\n68\t  let helloSent = false;\n69\t  let ownsCard = false;\n70\t  let readySent = false;\n71\t  let me = null;\n72\t  let keys = [];\n73\t  const gone = new Set();\n74\t  const queue = [];\n75\t  let queuedBytes = 0;\n76\t  let tokens = LIMITS.burst;\n77\t  let refilled = clock.now();\n78\t  let progressAt = -Infinity;\n79\t  const issues = [];\n80\t  const stats = { sent: 0, received: 0, bytesSent: 0, dropped: 0 };\n81\t\n82\t  const toGame = (msg) => post({ aihub: 1, ...msg });\n83\t  const toHub = (m) => net.send(coordinator, { k: 'c', r: round, m }, { reliable: true });\n84\t  const issue = (problem) => {\n85\t    const entry = { key, problem };\n86\t    issues.push(entry);\n87\t    onIssue(entry);\n88\t  };\n89\t\n90\t  function fromGame(msg) {\n91\t    if (!msg || msg.aihub !== 1) return;\n92\t    if (!FROM_GAME.has(msg.type)) return issue(`unknown message type ${JSON.stringify(msg.type)}`);\n93\t    if (msg.type === 'fullscreen') return onFullscreen(msg.on === true);\n94\t    if (ended && msg.type !== 'error') return;\n95\t    switch (msg.type) {\n96\t      case 'hello':\n97\t        if (helloSent) return;\n98\t        helloSent = true;\n99\t        ownsCard = msg.card === true;\n100\t        return toHub({ type: 'hello', v: msg.v, client: String(msg.client || ''), mode: msg.mode ?? null, seats: msg.seats ?? null, card: ownsCard });\n101\t      case 'ready':\n102\t        if (!welcomed) return issue('ready before welcome');\n103\t        readySent = true;\n104\t        return toHub({ type: 'ready' });\n105\t      case 'answer':\n106\t        if (!ownsCard) return issue('answer without its own card: connect({ card: true })');\n107\t        if (!welcomed || started) return;\n108\t        if (msg.answer !== 'ready' && msg.answer !== 'more') return issue(`answer ${JSON.stringify(msg.answer)} is not ready or more`);\n109\t        return onAnswer(msg.answer);\n110\t      case 'result':\n111\t        if (!welcomed) return issue('result before welcome');\n112\t        return toHub({ type: 'result', time: msg.time, score: msg.score, stats: msg.stats, awards: msg.awards });\n113\t      case 'finish':\n114\t        if (!welcomed) return issue('finish before welcome');\n115\t        return toHub({ type: 'finish', standings: msg.standings, scores: msg.scores, won: msg.won, stats: msg.stats, awards: msg.awards });\n116\t      case 'error':\n117\t        return toHub({ type: 'error', message: String(msg.message || '').slice(0, 500), fatal: msg.fatal === true });\n118\t      case 'send':\n119\t        return sendGame(msg);\n120\t      case 'progress':\n121\t        return sendProgress(msg);\n122\t    }\n123\t  }\n124\t\n125\t  /** Progress goes to this hub's scoreboard and to every other player's, never to a game. */\n126\t  function sendProgress(msg) {\n127\t    if (!welcomed) return issue('progress before welcome');\n128\t    const p = cleanProgress(msg);\n129\t    if (!p) return issue('progress needs a finite score');\n130\t    const now = clock.now();\n131\t    if (now - progressAt < LIMITS.progressMs) {\n132\t      stats.dropped++;\n133\t      return;\n134\t    }\n135\t    progressAt = now;\n136\t    onProgress(me, p);\n137\t    const envelope = { k: 'p', r: round, f: me, d: p };\n138\t    for (const target of keys.filter((k, id) => id !== me && !gone.has(id))) net.send(target, envelope, { reliable: false });\n139\t  }\n140\t\n141\t  function sendGame(msg) {\n142\t    if (!welcomed) return issue('send before welcome');\n143\t    let text;\n144\t    try {\n145\t      text = JSON.stringify(msg.data);\n146\t    } catch {\n147\t      return issue('send: data is not JSON');\n148\t    }\n149\t    if (text === undefined) return issue('send: no data');\n150\t    if (text.length > LIMITS.maxBytes) {\n151\t      stats.dropped++;\n152\t      return issue(`send: ${text.length} bytes is over the ${LIMITS.maxBytes}-byte limit`);\n153\t    }\n154\t    const now = clock.now();\n155\t    tokens = Math.min(LIMITS.burst, tokens + ((now - refilled) / 1000) * LIMITS.ratePerS);\n156\t    refilled = now;\n157\t    if (tokens < 1) {\n158\t      stats.dropped++;\n159\t      return issue(`send: over ${LIMITS.ratePerS} messages a second`);\n160\t    }\n161\t    tokens -= 1;\n162\t    let targets;\n163\t    if (msg.to === undefined || msg.to === null) {\n164\t      targets = keys.filter((k, id) => id !== me && !gone.has(id));\n165\t    } else {\n166\t      if (!Number.isInteger(msg.to) || msg.to < 0 || msg.to >= keys.length || msg.to === me) {\n167\t        return issue(`send: no player ${JSON.stringify(msg.to)} to send to`);\n168\t      }\n169\t      if (gone.has(msg.to)) return;\n170\t      targets = [keys[msg.to]];\n171\t    }\n172\t    const reliable = msg.reliable !== false;\n173\t    const envelope = { k: 'g', r: round, f: me, d: JSON.parse(text) };\n174\t    for (const target of targets) net.send(target, envelope, { reliable });\n175\t    stats.sent++;\n176\t    stats.bytesSent += text.length;\n177\t  }\n178\t\n179\t  function deliverGame(fromKey, env) {\n180\t    if (ended || gone.has(env.f)) return;\n181\t    if (keys[env.f] !== fromKey) return issue(`traffic from ${fromKey} claims to be player ${env.f}`);\n182\t    stats.received++;\n183\t    toGame({ type: 'message', from: env.f, data: env.d });\n184\t  }\n185\t\n186\t  function fromNet(fromKey, env) {\n187\t    if (!env || env.r !== round) return;\n188\t    if (env.k === 'p') {\n189\t      const p = cleanProgress(env.d);\n190\t      if (welcomed && !ended && p && keys[env.f] === fromKey && !gone.has(env.f)) onProgress(env.f, p);\n191\t      return;\n192\t    }\n193\t    if (env.k === 'g') {\n194\t      if (welcomed) return deliverGame(fromKey, env);\n195\t      const size = JSON.stringify(env.d ?? null).length;\n196\t      if (queue.length >= LIMITS.queueMessages || queuedBytes + size > LIMITS.queueBytes) {\n197\t        stats.dropped++;\n198\t        return;\n199\t      }\n200\t      queue.push([fromKey, env]);\n201\t      queuedBytes += size;\n202\t      return;\n203\t    }\n204\t    if (env.k !== 'h' || fromKey !== coordinator || !env.m) return;\n205\t    const m = env.m;\n206\t    switch (m.type) {\n207\t      case 'welcome': {\n208\t        if (welcomed) return;\n209\t        welcomed = true;\n210\t        me = m.me;\n211\t        keys = Array.isArray(m.keys) ? m.keys : [];\n212\t        const { keys: _keys, round: _round, ...rest } = m;\n213\t        // The limits ride in the welcome, so a client of 1.3.0 or later follows whatever this hub enforces.\n214\t        toGame({ ...rest, round, limits: { maxBytes: LIMITS.maxBytes, ratePerS: LIMITS.ratePerS, burst: LIMITS.burst } });\n215\t        for (const [k, e] of queue.splice(0)) deliverGame(k, e);\n216\t        queuedBytes = 0;\n217\t        return;\n218\t      }\n219\t      case 'start':\n220\t        started = true;\n221\t        return toGame({ type: 'start', in: Math.round(m.at - clock.now()) });\n222\t      case 'leave':\n223\t        gone.add(m.id);\n224\t        return toGame({ type: 'leave', id: m.id, reason: m.reason });\n225\t      case 'time-up':\n226\t        return toGame({ type: 'time-up', graceMs: m.graceMs });\n227\t      case 'end':\n228\t        ended = true;\n229\t        return toGame({ type: 'end', reason: m.reason, ...(m.standings ? { standings: m.standings } : {}) });\n230\t    }\n231\t  }\n232\t\n233\t  return {\n234\t    key,\n235\t    round,\n236\t    fromGame,\n237\t    fromNet,\n238\t    /** The game's own card, while it is on: { left, paused, starting, ready, asking, asked } (lib/hub/README.md, \"The card\"). */\n239\t    card(state) {\n240\t      if (ownsCard && welcomed && !started && !ended) toGame({ type: 'card', ...state });\n241\t    },\n242\t    /** The page holding this frame was hidden or shown: the coordinator watches the host's. */\n243\t    visibility(hidden) {\n244\t      if (helloSent && !ended) toHub({ type: 'vis', hidden: !!hidden });\n245\t    },\n246\t    issues,\n247\t    stats,\n248\t    get me() {\n249\t      return me;\n250\t    },\n251\t    get ended() {\n252\t      return ended;\n253\t    },\n254\t    /** The game shows its own card, and has loaded: the hub's card steps aside for it. */\n255\t    get showsCard() {\n256\t      return ownsCard && readySent && !ended;\n257\t    },\n258\t  };\n259\t}\n260\t\n261\t/**\n262\t * Wire a bridge to an iframe: only messages from that frame's window count.\n263\t * Returns a function that unhooks it.\n264\t */\n265\texport function attachFrame(frame, onMessage) {\n266\t  const listener = (event) => {\n267\t    if (event.source !== frame.contentWindow) return;\n268\t    if (!event.data || event.data.aihub !== 1) return;\n269\t    onMessage(event.data);\n270\t  };\n271\t  addEventListener('message', listener);\n272\t  return () => removeEventListener('message', listener);\n273\t}\n274\t\n275\t/** Post to a frame. The games may be served from anywhere, and nothing here is secret. */\n276\texport const postTo = (frame) => (msg) => frame.contentWindow?.postMessage(msg, '*');\n277\t\n278\t/**\n279\t * A simulated network for the harness and tests: one-way latency with jitter,\n280\t * and loss for unreliable messages. Reliable messages stay in order per pair,\n281\t * as a WebRTC ordered channel would keep them.\n282\t */\n283\texport function createLocalNetwork({ latency = 0, jitter = 0, loss = 0, random = Math.random, clock = globalThis } = {}) {\n284\t  const endpoints = new Map();\n285\t  const pairs = new Map(); // \"from\\0to\" -> reliable messages waiting, in send order\n286\t  const now = () => (clock.performance?.now ? clock.performance.now() : Date.now());\n287\t  const settings = { latency, jitter, loss };\n288\t\n289\t  const deliver = (from, to, target, copy) => {\n290\t    if (endpoints.get(to) === target) for (const fn of target.listeners) fn(from, copy);\n291\t  };\n292\t\n293\t  /** Reliable traffic leaves each pair's queue strictly in order, never before its time. */\n294\t  function drain(pair) {\n295\t    const q = pairs.get(pair);\n296\t    q.timer = null;\n297\t    while (q.items.length && q.items[0].at <= now() + 0.5) {\n298\t      const { from, to, target, copy } = q.items.shift();\n299\t      deliver(from, to, target, copy);\n300\t    }\n301\t    if (q.items.length) q.timer = clock.setTimeout(() => drain(pair), Math.max(1, Math.ceil(q.items[0].at - now())));\n302\t  }\n303\t\n304\t  function endpoint(key) {\n305\t    const listeners = new Set();\n306\t    const self = {\n307\t      key,\n308\t      send(to, env, { reliable = true } = {}) {\n309\t        const target = endpoints.get(to);\n310\t        if (!target || !endpoints.has(key)) return;\n311\t        if (!reliable && random() < settings.loss) return;\n312\t        const copy = JSON.parse(JSON.stringify(env));\n313\t        const delay = to === key ? 0 : Math.max(0, settings.latency + (random() * 2 - 1) * settings.jitter);\n314\t        if (!reliable) {\n315\t          clock.setTimeout(() => deliver(key, to, target, copy), delay);\n316\t          return;\n317\t        }\n318\t        const pair = `${key}\\u0000${to}`;\n319\t        if (!pairs.has(pair)) pairs.set(pair, { items: [], timer: null });\n320\t        const q = pairs.get(pair);\n321\t        const last = q.items.at(-1)?.at ?? 0;\n322\t        q.items.push({ at: Math.max(now() + delay, last), from: key, to, target, copy });\n323\t        if (!q.timer) q.timer = clock.setTimeout(() => drain(pair), Math.ceil(delay));\n324\t      },\n325\t      onMessage(fn) {\n326\t        listeners.add(fn);\n327\t        return () => listeners.delete(fn);\n328\t      },\n329\t      close() {\n330\t        endpoints.delete(key);\n331\t      },\n332\t      listeners,\n333\t    };\n334\t    endpoints.set(key, self);\n335\t    return self;\n336\t  }\n337\t\n338\t  return { endpoint, settings };\n339\t}\n340\t"}]},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"7754abac-8910-45b5-8c94-6c53d1611e38","timestamp":"2026-11-05T04:22:42.491Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/bridge.js","content":"/**\n * bridge.js — the hub's end of one game frame in a session.\n *\n * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\n * The bridge checks every message, enforces the limits, and routes it: control\n * messages (hello, ready, result, finish, error) to whoever coordinates the\n * round (lib/hub/round.js), game traffic straight to the other players, and a\n * game's answers on its own card to the page that holds it. What\n * comes back from the network is checked again before it reaches the game,\n * and anything from another round is dropped, so a slow packet can never land\n * in the next game.\n *\n * The network is anything with `send(toKey, envelope, {reliable})`: the\n * simulated one below (harness, tests), a BroadcastChannel between tabs, or a\n * WebRTC mesh. Envelopes:\n *   {k:'c', r, m}       to the coordinator: a message from this game\n *   {k:'h', r, m}       from the coordinator: welcome, start, leave, time-up, end\n *   {k:'g', r, f, d}    game traffic from player id f\n *   {k:'p', r, f, d}    player id f's progress, {score, label}, for the scoreboard\n */\n\nexport const LIMITS = Object.freeze({\n  maxBytes: 16_384,\n  ratePerS: 20,\n  burst: 40,\n  queueMessages: 64,\n  queueBytes: 262_144,\n  /**\n   * progress() reaches the hub about once a second. Two closer than this are a\n   * report delivered late (a long task in the game) or a client misbehaving:\n   * the later is dropped, and the next report, a second on, has the newest score.\n   */\n  progressMs: 250,\n  label: 24,\n});\n\nconst FROM_GAME = new Set(['hello', 'ready', 'send', 'result', 'finish', 'error', 'progress', 'fullscreen', 'answer']);\n\n/** A progress report, checked: a finite score and an optional short label. Null when it is not one. */\nexport function cleanProgress(p) {\n  if (!p || typeof p !== 'object') return null;\n  // A number, or text that is one: never null, '', true or [], which Number() would make 0 or 1.\n  const score = typeof p.score === 'number' || (typeof p.score === 'string' && p.score.trim() !== '') ? Number(p.score) : NaN;\n  if (!Number.isFinite(score)) return null;\n  const label = typeof p.label === 'string' ? p.label.trim().slice(0, LIMITS.label) : '';\n  return label ? { score, label } : { score };\n}\n\n/**\n * @param {object} o\n * @param {string} o.key              this player's key in the session\n * @param {number} o.round\n * @param {string} o.coordinator      key of whoever runs round.js\n * @param {(msg:object) => void} o.post            to the game frame\n * @param {{send:Function}} o.net\n * @param {{now:()=>number}} [o.clock]             the coordinator's time, as seen here\n * @param {(issue:{key:string, problem:string}) => void} [o.onIssue]\n * @param {(id:number, progress:{score:number, label?:string}) => void} [o.onProgress]   a player's\n *        progress, this one's included, for the hub's scoreboard; it never reaches the games\n * @param {(on:boolean) => void} [o.onFullscreen]   the game asked for fullscreen (or out of it): the\n *        hub's page takes it, so the hub's own cards stay over the game\n * @param {(what:'ready'|'more') => void} [o.onAnswer]   this player answered on the game's own card\n */\nexport function createBridge({ key, round, coordinator, post, net, clock = Date, onIssue = () => {}, onProgress = () => {}, onFullscreen = () => {}, onAnswer = () => {} }) {\n  let welcomed = false;\n  let ended = false;\n  let started = false;\n  let helloSent = false;\n  let ownsCard = false;\n  let readySent = false;\n  let me = null;\n  let keys = [];\n  const gone = new Set();\n  const queue = [];\n  let queuedBytes = 0;\n  let tokens = LIMITS.burst;\n  let refilled = clock.now();\n  let progressAt = -Infinity;\n  const issues = [];\n  const stats = { sent: 0, received: 0, bytesSent: 0, dropped: 0 };\n\n  const toGame = (msg) => post({ aihub: 1, ...msg });\n  const toHub = (m) => net.send(coordinator, { k: 'c', r: round, m }, { reliable: true });\n  const issue = (problem) => {\n    const entry = { key, problem };\n    issues.push(entry);\n    onIssue(entry);\n  };\n\n  function fromGame(msg) {\n    if (!msg || msg.aihub !== 1) return;\n    if (!FROM_GAME.has(msg.type)) return issue(`unknown message type ${JSON.stringify(msg.type)}`);\n    if (msg.type === 'fullscreen') return onFullscreen(msg.on === true);\n    if (ended && msg.type !== 'error') return;\n    switch (msg.type) {\n      case 'hello':\n        if (helloSent) return;\n        helloSent = true;\n        ownsCard = msg.card === true;\n        return toHub({ type: 'hello', v: msg.v, client: String(msg.client || ''), mode: msg.mode ?? null, seats: msg.seats ?? null, card: ownsCard });\n      case 'ready':\n        if (!welcomed) return issue('ready before welcome');\n        readySent = true;\n        return toHub({ type: 'ready' });\n      case 'answer':\n        if (!ownsCard) return issue('answer without its own card: connect({ card: true })');\n        if (!welcomed || started) return;\n        if (msg.answer !== 'ready' && msg.answer !== 'more') return issue(`answer ${JSON.stringify(msg.answer)} is not ready or more`);\n        return onAnswer(msg.answer);\n      case 'result':\n        if (!welcomed) return issue('result before welcome');\n        return toHub({ type: 'result', time: msg.time, score: msg.score, stats: msg.stats, awards: msg.awards });\n      case 'finish':\n        if (!welcomed) return issue('finish before welcome');\n        return toHub({ type: 'finish', standings: msg.standings, scores: msg.scores, won: msg.won, stats: msg.stats, awards: msg.awards });\n      case 'error':\n        return toHub({ type: 'error', message: String(msg.message || '').slice(0, 500), fatal: msg.fatal === true });\n      case 'send':\n        return sendGame(msg);\n      case 'progress':\n        return sendProgress(msg);\n    }\n  }\n\n  /** Progress goes to this hub's scoreboard and to every other player's, never to a game. */\n  function sendProgress(msg) {\n    if (!welcomed) return issue('progress before welcome');\n    const p = cleanProgress(msg);\n    if (!p) return issue('progress needs a finite score');\n    const now = clock.now();\n    if (now - progressAt < LIMITS.progressMs) {\n      stats.dropped++;\n      return;\n    }\n    progressAt = now;\n    onProgress(me, p);\n    const envelope = { k: 'p', r: round, f: me, d: p };\n    for (const target of keys.filter((k, id) => id !== me && !gone.has(id))) net.send(target, envelope, { reliable: false });\n  }\n\n  function sendGame(msg) {\n    if (!welcomed) return issue('send before welcome');\n    let text;\n    try {\n      text = JSON.stringify(msg.data);\n    } catch {\n      return issue('send: data is not JSON');\n    }\n    if (text === undefined) return issue('send: no data');\n    if (text.length > LIMITS.maxBytes) {\n      stats.dropped++;\n      return issue(`send: ${text.length} bytes is over the ${LIMITS.maxBytes}-byte limit`);\n    }\n    const now = clock.now();\n    tokens = Math.min(LIMITS.burst, tokens + ((now - refilled) / 1000) * LIMITS.ratePerS);\n    refilled = now;\n    if (tokens < 1) {\n      stats.dropped++;\n      return issue(`send: over ${LIMITS.ratePerS} messages a second`);\n    }\n    tokens -= 1;\n    let targets;\n    if (msg.to === undefined || msg.to === null) {\n      targets = keys.filter((k, id) => id !== me && !gone.has(id));\n    } else {\n      if (!Number.isInteger(msg.to) || msg.to < 0 || msg.to >= keys.length || msg.to === me) {\n        return issue(`send: no player ${JSON.stringify(msg.to)} to send to`);\n      }\n      if (gone.has(msg.to)) return;\n      targets = [keys[msg.to]];\n    }\n    const reliable = msg.reliable !== false;\n    const envelope = { k: 'g', r: round, f: me, d: JSON.parse(text) };\n    for (const target of targets) net.send(target, envelope, { reliable });\n    stats.sent++;\n    stats.bytesSent += text.length;\n  }\n\n  function deliverGame(fromKey, env) {\n    if (ended || gone.has(env.f)) return;\n    if (keys[env.f] !== fromKey) return issue(`traffic from ${fromKey} claims to be player ${env.f}`);\n    stats.received++;\n    toGame({ type: 'message', from: env.f, data: env.d });\n  }\n\n  function fromNet(fromKey, env) {\n    if (!env || env.r !== round) return;\n    if (env.k === 'p') {\n      const p = cleanProgress(env.d);\n      if (welcomed && !ended && p && keys[env.f] === fromKey && !gone.has(env.f)) onProgress(env.f, p);\n      return;\n    }\n    if (env.k === 'g') {\n      if (welcomed) return deliverGame(fromKey, env);\n      const size = JSON.stringify(env.d ?? null).length;\n      if (queue.length >= LIMITS.queueMessages || queuedBytes + size > LIMITS.queueBytes) {\n        stats.dropped++;\n        return;\n      }\n      queue.push([fromKey, env]);\n      queuedBytes += size;\n      return;\n    }\n    if (env.k !== 'h' || fromKey !== coordinator || !env.m) return;\n    const m = env.m;\n    switch (m.type) {\n      case 'welcome': {\n        if (welcomed) return;\n        welcomed = true;\n        me = m.me;\n        keys = Array.isArray(m.keys) ? m.keys : [];\n        const { keys: _keys, round: _round, ...rest } = m;\n        // The limits ride in the welcome, so a client of 1.3.0 or later follows whatever this hub enforces.\n        toGame({ ...rest, round, limits: { maxBytes: LIMITS.maxBytes, ratePerS: LIMITS.ratePerS, burst: LIMITS.burst } });\n        for (const [k, e] of queue.splice(0)) deliverGame(k, e);\n        queuedBytes = 0;\n        return;\n      }\n      case 'start':\n        started = true;\n        return toGame({ type: 'start', in: Math.round(m.at - clock.now()) });\n      case 'leave':\n        gone.add(m.id);\n        return toGame({ type: 'leave', id: m.id, reason: m.reason });\n      case 'time-up':\n        return toGame({ type: 'time-up', graceMs: m.graceMs });\n      case 'end':\n        ended = true;\n        return toGame({ type: 'end', reason: m.reason, ...(m.standings ? { standings: m.standings } : {}) });\n    }\n  }\n\n  return {\n    key,\n    round,\n    fromGame,\n    fromNet,\n    /** The game's own card, while it is on: { left, paused, starting, ready, asking, asked } (lib/hub/README.md, \"The card\"). */\n    card(state) {\n      if (ownsCard && welcomed && !started && !ended) toGame({ type: 'card', ...state });\n    },\n    /** The page holding this frame was hidden or shown: the coordinator watches the host's. */\n    visibility(hidden) {\n      if (helloSent && !ended) toHub({ type: 'vis', hidden: !!hidden });\n    },\n    issues,\n    stats,\n    get me() {\n      return me;\n    },\n    get ended() {\n      return ended;\n    },\n    /** The game shows its own card, and has loaded: the hub's card steps aside for it. */\n    get showsCard() {\n      return ownsCard && readySent && !ended;\n    },\n  };\n}\n\n/**\n * Wire a bridge to an iframe: only messages from that frame's window count.\n * Returns a function that unhooks it.\n */\nexport function attachFrame(frame, onMessage) {\n  const listener = (event) => {\n    if (event.source !== frame.contentWindow) return;\n    if (!event.data || event.data.aihub !== 1) return;\n    onMessage(event.data);\n  };\n  addEventListener('message', listener);\n  return () => removeEventListener('message', listener);\n}\n\n/** Post to a frame. The games may be served from anywhere, and nothing here is secret. */\nexport const postTo = (frame) => (msg) => frame.contentWindow?.postMessage(msg, '*');\n\n/**\n * A simulated network for the harness and tests: one-way latency with jitter,\n * and loss for unreliable messages. Reliable messages stay in order per pair,\n * as a WebRTC ordered channel would keep them.\n */\nexport function createLocalNetwork({ latency = 0, jitter = 0, loss = 0, random = Math.random, clock = globalThis } = {}) {\n  const endpoints = new Map();\n  const pairs = new Map(); // \"from\\0to\" -> reliable messages waiting, in send order\n  const now = () => (clock.performance?.now ? clock.performance.now() : Date.now());\n  const settings = { latency, jitter, loss };\n\n  const deliver = (from, to, target, copy) => {\n    if (endpoints.get(to) === target) for (const fn of target.listeners) fn(from, copy);\n  };\n\n  /** Reliable traffic leaves each pair's queue strictly in order, never before its time. */\n  function drain(pair) {\n    const q = pairs.get(pair);\n    q.timer = null;\n    while (q.items.length && q.items[0].at <= now() + 0.5) {\n      const { from, to, target, copy } = q.items.shift();\n      deliver(from, to, target, copy);\n    }\n    if (q.items.length) q.timer = clock.setTimeout(() => drain(pair), Math.max(1, Math.ceil(q.items[0].at - now())));\n  }\n\n  function endpoint(key) {\n    const listeners = new Set();\n    const self = {\n      key,\n      send(to, env, { reliable = true } = {}) {\n        const target = endpoints.get(to);\n        if (!target || !endpoints.has(key)) return;\n        if (!reliable && random() < settings.loss) return;\n        const copy = JSON.parse(JSON.stringify(env));\n        const delay = to === key ? 0 : Math.max(0, settings.latency + (random() * 2 - 1) * settings.jitter);\n        if (!reliable) {\n          clock.setTimeout(() => deliver(key, to, target, copy), delay);\n          return;\n        }\n        const pair = `${key}\\u0000${to}`;\n        if (!pairs.has(pair)) pairs.set(pair, { items: [], timer: null });\n        const q = pairs.get(pair);\n        const last = q.items.at(-1)?.at ?? 0;\n        q.items.push({ at: Math.max(now() + delay, last), from: key, to, target, copy });\n        if (!q.timer) q.timer = clock.setTimeout(() => drain(pair), Math.ceil(delay));\n      },\n      onMessage(fn) {\n        listeners.add(fn);\n        return () => listeners.delete(fn);\n      },\n      close() {\n        endpoints.delete(key);\n      },\n      listeners,\n    };\n    endpoints.set(key, self);\n    return self;\n  }\n\n  return { endpoint, settings };\n}\n","numLines":340,"startLine":1,"totalLines":340}},"tool_result_meta":[{"id":"toolu_015M2fUhPNfchiqcCKDymdQ6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
