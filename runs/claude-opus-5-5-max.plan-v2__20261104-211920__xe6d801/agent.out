{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J4nXWs5Tzk9VqEVfT1re6r","type":"tool_result","content":"20\t * (150 ± 50 ms, 5% loss). Ghost is checked like parallel, except that every\n21\t * copy sends its player. A shared world wants traffic both ways, and is\n22\t * played once more at 2 players with its world hosted by one more copy that\n23\t * has no player of its own, as a dedicated server would host it (README,\n24\t * \"Shared world\"). That run is reported like any; --record does not hold it\n25\t * against a game, since no server runs yet.\n26\t *\n27\t * --retrofit is for an existing game upgraded to parallel: it is played once,\n28\t * at 2 players with one of them leaving. With --original <path>, errors the\n29\t * original page already had are forgiven when it is opened on its own.\n30\t * --draws-only does only that last part, for any page: the retrofit runs it on\n31\t * a game before spending a model on it, since a page this browser cannot run\n32\t * cannot be checked here. A WebGPU-only game without WebGPU is caught even\n33\t * when its title screen shows: it asked for an adapter, got none, and drew\n34\t * nothing with WebGL or a 2D canvas instead. --browser-args passes flags to\n35\t * Chromium; on a machine without a GPU, SwiftShader gives such games a\n36\t * software adapter:\n37\t *   --browser-args \"--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-webgpu-adapter=swiftshader --use-angle=swiftshader\"\n38\t *\n39\t * Every game's pasted client is also read from disk and must be exactly a\n40\t * released one (scripts/lib/hub-client.mjs).\n41\t *\n42\t * --record writes the outcome into data/overrides.json, which is how the hub\n43\t * keeps a failing game out of sessions: a game that fails gets \"session\": \"0\"\n44\t * (it overrides the game's own hub:session meta, so Random Mode never deals\n45\t * it) and a sessionNote naming what failed; a game that passes loses both.\n46\t *\n47\t * Usage:  node scripts/hub-check.mjs [game paths…] [--players 2,3,4] [--base URL] [--json] [--no-solo]\n48\t *                                    [--retrofit [--original <path>]] [--draws-only] [--record] [--browser-args \"<flags>\"]\n49\t *         (games default to the three examples in lib/hub/examples/)\n50\t */\n51\t\n52\timport { createServer } from 'node:http';\n53\timport { createRequire } from 'node:module';\n54\timport { mkdir, readdir, readFile, writeFile } from 'node:fs/promises';\n55\timport path from 'node:path';\n56\timport { fileURLToPath } from 'node:url';\n57\t\n58\timport { staticHandler } from './lib/serve.mjs';\n59\timport { modeOf, SELF_REPORTED } from '../lib/hub/round.js';"}]},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"17c07bdf-44a5-4486-86de-a61501154776","timestamp":"2026-11-05T04:27:46.180Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/hub-check.mjs","content":" * (150 ± 50 ms, 5% loss). Ghost is checked like parallel, except that every\n * copy sends its player. A shared world wants traffic both ways, and is\n * played once more at 2 players with its world hosted by one more copy that\n * has no player of its own, as a dedicated server would host it (README,\n * \"Shared world\"). That run is reported like any; --record does not hold it\n * against a game, since no server runs yet.\n *\n * --retrofit is for an existing game upgraded to parallel: it is played once,\n * at 2 players with one of them leaving. With --original <path>, errors the\n * original page already had are forgiven when it is opened on its own.\n * --draws-only does only that last part, for any page: the retrofit runs it on\n * a game before spending a model on it, since a page this browser cannot run\n * cannot be checked here. A WebGPU-only game without WebGPU is caught even\n * when its title screen shows: it asked for an adapter, got none, and drew\n * nothing with WebGL or a 2D canvas instead. --browser-args passes flags to\n * Chromium; on a machine without a GPU, SwiftShader gives such games a\n * software adapter:\n *   --browser-args \"--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-webgpu-adapter=swiftshader --use-angle=swiftshader\"\n *\n * Every game's pasted client is also read from disk and must be exactly a\n * released one (scripts/lib/hub-client.mjs).\n *\n * --record writes the outcome into data/overrides.json, which is how the hub\n * keeps a failing game out of sessions: a game that fails gets \"session\": \"0\"\n * (it overrides the game's own hub:session meta, so Random Mode never deals\n * it) and a sessionNote naming what failed; a game that passes loses both.\n *\n * Usage:  node scripts/hub-check.mjs [game paths…] [--players 2,3,4] [--base URL] [--json] [--no-solo]\n *                                    [--retrofit [--original <path>]] [--draws-only] [--record] [--browser-args \"<flags>\"]\n *         (games default to the three examples in lib/hub/examples/)\n */\n\nimport { createServer } from 'node:http';\nimport { createRequire } from 'node:module';\nimport { mkdir, readdir, readFile, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { staticHandler } from './lib/serve.mjs';\nimport { modeOf, SELF_REPORTED } from '../lib/hub/round.js';","numLines":40,"startLine":20,"totalLines":371}},"tool_result_meta":[{"id":"toolu_01J4nXWs5Tzk9VqEVfT1re6r","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9cByD3JPf3higS42kH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Cxbg2UTtT4sZ8EDVQMNmTv","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/hub-check.mjs","offset":170,"limit":200},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6194,"cache_read_input_tokens":137217,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6194},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"93165875-48c2-4a32-86cb-5832b9b3b662","timestamp":"2026-11-05T04:27:47.582Z","request_id":"req_011Cgj9cBib9Nga9eZkm7i3v","wire_tool_inputs":{"toolu_01Cxbg2UTtT4sZ8EDVQMNmTv":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/hub-check.mjs","offset":170,"limit":200}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cxbg2UTtT4sZ8EDVQMNmTv","type":"tool_result","content":"170\t  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));\n171\t  base = `http://127.0.0.1:${server.address().port}`;\n172\t}\n173\t\n174\tconst browser = await chromium.launch({ headless: true, executablePath: process.env.CHROMIUM_PATH, args: ['--no-sandbox', '--autoplay-policy=no-user-gesture-required', ...browserArgs] });\n175\tconst runs = [];\n176\ttry {\n177\t  for (const game of games) {\n178\t    if (drawsOnly) {\n179\t      const report = await stillWorks(game, null, { bare: true });\n180\t      runs.push({ game, players: 1, scenario: 'draws', pass: report.pass, checks: report.checks });\n181\t      if (!asJson) console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  draws on its own`);\n182\t      continue;\n183\t    }\n184\t    const client = await clientCheck(game);\n185\t    if (client) {\n186\t      runs.push({ game, players: 0, scenario: 'static', pass: client.pass, checks: [client] });\n187\t      if (!asJson && !client.pass) console.log(`FAIL  ${game}  ✗ ${client.name} — ${client.detail}`);\n188\t    }\n189\t    const { mode, seats } = await headOf(game);\n190\t    const counts = countsFor(mode, seats);\n191\t    // A retrofit is played once, at 2 players with one leaving: nothing is shared, so that says it all.\n192\t    const plan = retrofit && !asked ? [] : counts.map((n) => ({ n, scenario: 'standard' }));\n193\t    const leaving = retrofit && !asked ? 2 : Math.max(2, Math.min(3, Math.max(...counts, 0)));\n194\t    if (asked || leaving <= seats[1]) plan.push({ n: leaving, scenario: 'host-leave' });\n195\t    // A shared world must also run on a copy with no player of its own, as a server would run it.\n196\t    if (!retrofit && mode && !SELF_REPORTED.includes(mode) && (asked || (seats[0] <= 2 && seats[1] >= 2))) plan.push({ n: 2, scenario: 'server' });\n197\t    for (const { n, scenario } of plan) {\n198\t      const context = await browser.newContext({ viewport: { width: 1280, height: 860 } });\n199\t      await context.addInitScript(watch);\n200\t      const page = await context.newPage();\n201\t      const pageErrors = [];\n202\t      const warnings = [];\n203\t      page.on('pageerror', (e) => pageErrors.push(e.message));\n204\t      page.on('console', (m) => m.text().startsWith('[AIHub]') && warnings.push(m.text()));\n205\t      const query = { game, players: n, latency: 150, jitter: 50, loss: 5, auto: 1, scenario, play: 8000 };\n206\t      const url = `${base}/lib/hub/harness.html?${new URLSearchParams(query)}`;\n207\t      await page.goto(url);\n208\t      // The harness times every step itself; this only catches a page that stopped answering.\n209\t      // Four copies of a 3D game on software WebGL can take minutes.\n210\t      const finished = await page.waitForSelector('body[data-complete=\"true\"]', { timeout: PAGE_MS }).then(() => true, () => false);\n211\t      const report = (await page.evaluate(() => window.__hubCheck).catch(() => null)) || { pass: false, checks: [] };\n212\t      if (!finished) {\n213\t        report.pass = false;\n214\t        report.checks.push({ name: `the harness finished within ${PAGE_MS / 1000} s`, pass: false, detail: `stopped after: ${report.checks.at(-1)?.name ?? 'nothing'}` });\n215\t      }\n216\t      const extra = [\n217\t        { name: 'no client warnings (oversized or too many sends, misuse)', pass: !warnings.length, detail: [...new Set(warnings)].slice(0, 4).join('; ') },\n218\t        { name: 'harness page has no errors', pass: !pageErrors.length, detail: pageErrors.join('; ') },\n219\t      ];\n220\t      report.checks.push(...extra);\n221\t      report.pass = report.pass && extra.every((c) => c.pass);\n222\t      runs.push({ game, players: n, scenario, pass: report.pass, checks: report.checks });\n223\t      if (!asJson) {\n224\t        console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  ${n} players  ${scenario}`);\n225\t        for (const c of report.checks) if (!c.pass) console.log(`        ✗ ${c.name}${c.detail ? ` — ${c.detail}` : ''}`);\n226\t      }\n227\t      await context.close();\n228\t    }\n229\t    if (solo) {\n230\t      const report = await stillWorks(game, original && asPath(original));\n231\t      runs.push({ game, players: 1, scenario: 'alone', pass: report.pass, checks: report.checks });\n232\t      if (!asJson) {\n233\t        console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  on its own`);\n234\t        for (const c of report.checks) if (!c.pass) console.log(`        ✗ ${c.name}${c.detail ? ` — ${c.detail}` : ''}`);\n235\t      }\n236\t    }\n237\t  }\n238\t} finally {\n239\t  await browser.close();\n240\t  server?.close();\n241\t}\n242\t\n243\t/** The pasted client, read from disk: one copy, exactly a released one. Null for a game served from elsewhere. */\n244\tasync function clientCheck(game) {\n245\t  if (/^https?:/.test(game)) return null;\n246\t  const file = path.join(ROOT, decodeURI(game).replace(/^\\//, ''));\n247\t  let text;\n248\t  try {\n249\t    text = await readFile(file, 'utf8');\n250\t  } catch {\n251\t    return null;\n252\t  }\n253\t  // A project folder may ship the client as its own file next to its page.\n254\t  if (path.basename(file) === 'index.html' && !text.includes('aihub-session')) {\n255\t    for (const name of await readdir(path.dirname(file)).catch(() => [])) {\n256\t      if (/\\.m?js$/.test(name)) text += '\\n' + (await readFile(path.join(path.dirname(file), name), 'utf8').catch(() => ''));\n257\t    }\n258\t  }\n259\t  const copies = findClients(text);\n260\t  const name = 'the session client is pasted unmodified';\n261\t  if (copies.length !== 1) return { name, pass: false, detail: `${copies.length} copies of the client` };\n262\t  return { name, pass: copies[0].pristine, detail: copies[0].pristine ? copies[0].version : `${copies[0].version ?? 'unknown'} edited: paste lib/hub/session.js again` };\n263\t}\n264\t\n265\t/**\n266\t * The game on its own: open it as someone at the wall would, press Enter and\n267\t * Space a few times, and see that it still runs: no errors (none beyond what\n268\t * an original page already had), the client inactive and Math.random left\n269\t * alone, and something drawn on the screen.\n270\t */\n271\tasync function stillWorks(game, before, { bare = false } = {}) {\n272\t  const checks = [];\n273\t  const check = (name, pass, detail = '') => checks.push({ name, pass: !!pass, detail });\n274\t  const visit = async (page) => {\n275\t    const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n276\t    await context.addInitScript(watch);\n277\t    const tab = await context.newPage();\n278\t    const errors = [];\n279\t    tab.on('pageerror', (e) => errors.push(e.message));\n280\t    await tab.goto(/^https?:/.test(page) ? page : `${base}${page}`);\n281\t    await tab.waitForTimeout(2500);\n282\t    for (const key of ['Enter', 'Space', 'Enter', 'Space']) {\n283\t      await tab.keyboard.press(key).catch(() => {});\n284\t      await tab.waitForTimeout(500);\n285\t    }\n286\t    await tab.waitForTimeout(2000);\n287\t    const hub = await tab.evaluate(() => (window.AIHub ? { active: window.AIHub.active, seeded: window.AIHub.seeded } : null)).catch(() => null);\n288\t    const gfx = await tab.evaluate(() => window.__gfx ?? null).catch(() => null);\n289\t    // A WebGL or WebGPU canvas often reads back blank from a script, so look at the screen instead:\n290\t    // a blank one compresses to almost nothing, so a PNG past a blank page's size means something is drawn.\n291\t    const bytes = (await tab.screenshot({ type: 'png' }).catch(() => Buffer.alloc(0))).length;\n292\t    await context.close();\n293\t    return { errors, hub, bytes, gfx };\n294\t  };\n295\t  const blank = await (async () => {\n296\t    const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n297\t    const tab = await context.newPage();\n298\t    await tab.setContent('<body style=\"margin:0;background:#000\"></body>');\n299\t    const bytes = (await tab.screenshot({ type: 'png' })).length;\n300\t    await context.close();\n301\t    return bytes;\n302\t  })();\n303\t  const after = await visit(game);\n304\t  // A line of text on a plain screen already adds about 2 KB; a uniform screen of any colour adds nothing.\n305\t  after.drawn = after.bytes > blank + 1200;\n306\t  const known = before ? new Set((await visit(before)).errors) : new Set();\n307\t  const fresh = after.errors.filter((e) => !known.has(e));\n308\t  if (!bare) {\n309\t    check('on its own: the session client is there and inactive', after.hub && after.hub.active === false, JSON.stringify(after.hub));\n310\t    // A client before 1.3.0 has no seeded flag: it never seeds.\n311\t    check('on its own: Math.random is left alone', after.hub && after.hub.seeded !== true, JSON.stringify(after.hub));\n312\t  }\n313\t  const g = after.gfx;\n314\t  const noWebGPU = g?.askedForWebGPU && !g.gotAdapter && !g.webgl && !g.twoD;\n315\t  const asked = g ? `WebGPU ${g.askedForWebGPU ? (g.gotAdapter ? 'asked, adapter' : 'asked, no adapter') : 'not asked'}; WebGL ${g.webgl ? 'yes' : 'no'}; 2D ${g.twoD ? 'yes' : 'no'}` : 'not seen';\n316\t  check('on its own: this browser can run it', !noWebGPU, noWebGPU ? `it asked for WebGPU, this browser has no adapter, and drew nothing with WebGL or 2D instead (${asked})` : asked);\n317\t  check('on its own: it draws its screen', after.drawn, `${after.bytes} bytes of screenshot, a blank screen is ${blank}`);\n318\t  // Drawing is all a bare page is asked: its own errors are the original's business.\n319\t  if (!bare) check(`on its own: no errors${before ? ' the original did not have' : ''}`, !fresh.length, fresh.slice(0, 3).join('; '));\n320\t  return { pass: checks.every((c) => c.pass), checks };\n321\t}\n322\t\n323\t/**\n324\t * Keep the verdict with the game: a failure takes it out of sessions until it\n325\t * passes again (see the header). Games are found by path in data/games.json.\n326\t */\n327\tasync function recordChecks() {\n328\t  let manifest;\n329\t  try {\n330\t    manifest = JSON.parse(await readFile(path.join(ROOT, 'data/games.json'), 'utf8'));\n331\t  } catch {\n332\t    console.log('--record needs data/games.json: run pnpm scan first');\n333\t    return;\n334\t  }\n335\t  const slugOf = new Map();\n336\t  for (const g of manifest.games) for (const p of [g.path, ...(g.builds || []).map((b) => b.path)]) if (p) slugOf.set(decodeURI(p), g.slug);\n337\t  const file = path.join(ROOT, 'data/overrides.json');\n338\t  const overrides = JSON.parse(await readFile(file, 'utf8'));\n339\t  const today = new Date().toISOString().slice(0, 10);\n340\t  for (const game of games) {\n341\t    const slug = slugOf.get(decodeURI(game));\n342\t    if (!slug) {\n343\t      console.log(`--record: ${game} is not in the catalogue, nothing recorded`);\n344\t      continue;\n345\t    }\n346\t    // A shared world that cannot yet be hosted by a server still plays: that run is reported, not held against it.\n347\t    const mine = runs.filter((r) => r.game === game && r.scenario !== 'server');\n348\t    const failed = [...new Set(mine.flatMap((r) => r.checks.filter((c) => !c.pass).map((c) => c.name)))];\n349\t    const entry = { ...(overrides[slug] || {}) };\n350\t    if (!failed.length) {\n351\t      if (entry.session === '0') delete entry.session;\n352\t      delete entry.sessionNote;\n353\t    } else {\n354\t      entry.session = '0';\n355\t      entry.sessionNote = `hub-check failed on ${today}: ${failed.slice(0, 3).join('; ')}`.slice(0, 240);\n356\t    }\n357\t    if (Object.keys(entry).length) overrides[slug] = entry;\n358\t    else delete overrides[slug];\n359\t    console.log(`--record: ${slug} ${failed.length ? 'kept out of sessions' : 'may be dealt'}`);\n360\t  }\n361\t  await writeFile(file, `${JSON.stringify(overrides, null, 2)}\\n`);\n362\t}\n363\t\n364\tconst pass = runs.every((r) => r.pass);\n365\tif (record) await recordChecks();\n366\tawait mkdir(path.join(ROOT, '.cache'), { recursive: true });\n367\tawait writeFile(path.join(ROOT, '.cache', 'hub-check.json'), JSON.stringify({ schemaVersion: 1, base, pass, runs }, null, 2));\n368\tif (asJson) console.log(JSON.stringify({ pass, runs }, null, 2));\n369\telse console.log(`\\n${pass ? 'All checks passed' : 'Some checks failed'} — report in .cache/hub-check.json`);"}]},"parent_tool_use_id":null,"session_id":"f4f41ba1-e4d3-4847-8e93-cb8d40d15190","uuid":"93e07baf-f863-42bb-935d-8ac44cb6441d","timestamp":"2026-11-05T04:27:47.603Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/hub/hub-check.mjs","content":"  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));\n  base = `http://127.0.0.1:${server.address().port}`;\n}\n\nconst browser = await chromium.launch({ headless: true, executablePath: process.env.CHROMIUM_PATH, args: ['--no-sandbox', '--autoplay-policy=no-user-gesture-required', ...browserArgs] });\nconst runs = [];\ntry {\n  for (const game of games) {\n    if (drawsOnly) {\n      const report = await stillWorks(game, null, { bare: true });\n      runs.push({ game, players: 1, scenario: 'draws', pass: report.pass, checks: report.checks });\n      if (!asJson) console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  draws on its own`);\n      continue;\n    }\n    const client = await clientCheck(game);\n    if (client) {\n      runs.push({ game, players: 0, scenario: 'static', pass: client.pass, checks: [client] });\n      if (!asJson && !client.pass) console.log(`FAIL  ${game}  ✗ ${client.name} — ${client.detail}`);\n    }\n    const { mode, seats } = await headOf(game);\n    const counts = countsFor(mode, seats);\n    // A retrofit is played once, at 2 players with one leaving: nothing is shared, so that says it all.\n    const plan = retrofit && !asked ? [] : counts.map((n) => ({ n, scenario: 'standard' }));\n    const leaving = retrofit && !asked ? 2 : Math.max(2, Math.min(3, Math.max(...counts, 0)));\n    if (asked || leaving <= seats[1]) plan.push({ n: leaving, scenario: 'host-leave' });\n    // A shared world must also run on a copy with no player of its own, as a server would run it.\n    if (!retrofit && mode && !SELF_REPORTED.includes(mode) && (asked || (seats[0] <= 2 && seats[1] >= 2))) plan.push({ n: 2, scenario: 'server' });\n    for (const { n, scenario } of plan) {\n      const context = await browser.newContext({ viewport: { width: 1280, height: 860 } });\n      await context.addInitScript(watch);\n      const page = await context.newPage();\n      const pageErrors = [];\n      const warnings = [];\n      page.on('pageerror', (e) => pageErrors.push(e.message));\n      page.on('console', (m) => m.text().startsWith('[AIHub]') && warnings.push(m.text()));\n      const query = { game, players: n, latency: 150, jitter: 50, loss: 5, auto: 1, scenario, play: 8000 };\n      const url = `${base}/lib/hub/harness.html?${new URLSearchParams(query)}`;\n      await page.goto(url);\n      // The harness times every step itself; this only catches a page that stopped answering.\n      // Four copies of a 3D game on software WebGL can take minutes.\n      const finished = await page.waitForSelector('body[data-complete=\"true\"]', { timeout: PAGE_MS }).then(() => true, () => false);\n      const report = (await page.evaluate(() => window.__hubCheck).catch(() => null)) || { pass: false, checks: [] };\n      if (!finished) {\n        report.pass = false;\n        report.checks.push({ name: `the harness finished within ${PAGE_MS / 1000} s`, pass: false, detail: `stopped after: ${report.checks.at(-1)?.name ?? 'nothing'}` });\n      }\n      const extra = [\n        { name: 'no client warnings (oversized or too many sends, misuse)', pass: !warnings.length, detail: [...new Set(warnings)].slice(0, 4).join('; ') },\n        { name: 'harness page has no errors', pass: !pageErrors.length, detail: pageErrors.join('; ') },\n      ];\n      report.checks.push(...extra);\n      report.pass = report.pass && extra.every((c) => c.pass);\n      runs.push({ game, players: n, scenario, pass: report.pass, checks: report.checks });\n      if (!asJson) {\n        console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  ${n} players  ${scenario}`);\n        for (const c of report.checks) if (!c.pass) console.log(`        ✗ ${c.name}${c.detail ? ` — ${c.detail}` : ''}`);\n      }\n      await context.close();\n    }\n    if (solo) {\n      const report = await stillWorks(game, original && asPath(original));\n      runs.push({ game, players: 1, scenario: 'alone', pass: report.pass, checks: report.checks });\n      if (!asJson) {\n        console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  on its own`);\n        for (const c of report.checks) if (!c.pass) console.log(`        ✗ ${c.name}${c.detail ? ` — ${c.detail}` : ''}`);\n      }\n    }\n  }\n} finally {\n  await browser.close();\n  server?.close();\n}\n\n/** The pasted client, read from disk: one copy, exactly a released one. Null for a game served from elsewhere. */\nasync function clientCheck(game) {\n  if (/^https?:/.test(game)) return null;\n  const file = path.join(ROOT, decodeURI(game).replace(/^\\//, ''));\n  let text;\n  try {\n    text = await readFile(file, 'utf8');\n  } catch {\n    return null;\n  }\n  // A project folder may ship the client as its own file next to its page.\n  if (path.basename(file) === 'index.html' && !text.includes('aihub-session')) {\n    for (const name of await readdir(path.dirname(file)).catch(() => [])) {\n      if (/\\.m?js$/.test(name)) text += '\\n' + (await readFile(path.join(path.dirname(file), name), 'utf8').catch(() => ''));\n    }\n  }\n  const copies = findClients(text);\n  const name = 'the session client is pasted unmodified';\n  if (copies.length !== 1) return { name, pass: false, detail: `${copies.length} copies of the client` };\n  return { name, pass: copies[0].pristine, detail: copies[0].pristine ? copies[0].version : `${copies[0].version ?? 'unknown'} edited: paste lib/hub/session.js again` };\n}\n\n/**\n * The game on its own: open it as someone at the wall would, press Enter and\n * Space a few times, and see that it still runs: no errors (none beyond what\n * an original page already had), the client inactive and Math.random left\n * alone, and something drawn on the screen.\n */\nasync function stillWorks(game, before, { bare = false } = {}) {\n  const checks = [];\n  const check = (name, pass, detail = '') => checks.push({ name, pass: !!pass, detail });\n  const visit = async (page) => {\n    const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n    await context.addInitScript(watch);\n    const tab = await context.newPage();\n    const errors = [];\n    tab.on('pageerror', (e) => errors.push(e.message));\n    await tab.goto(/^https?:/.test(page) ? page : `${base}${page}`);\n    await tab.waitForTimeout(2500);\n    for (const key of ['Enter', 'Space', 'Enter', 'Space']) {\n      await tab.keyboard.press(key).catch(() => {});\n      await tab.waitForTimeout(500);\n    }\n    await tab.waitForTimeout(2000);\n    const hub = await tab.evaluate(() => (window.AIHub ? { active: window.AIHub.active, seeded: window.AIHub.seeded } : null)).catch(() => null);\n    const gfx = await tab.evaluate(() => window.__gfx ?? null).catch(() => null);\n    // A WebGL or WebGPU canvas often reads back blank from a script, so look at the screen instead:\n    // a blank one compresses to almost nothing, so a PNG past a blank page's size means something is drawn.\n    const bytes = (await tab.screenshot({ type: 'png' }).catch(() => Buffer.alloc(0))).length;\n    await context.close();\n    return { errors, hub, bytes, gfx };\n  };\n  const blank = await (async () => {\n    const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n    const tab = await context.newPage();\n    await tab.setContent('<body style=\"margin:0;background:#000\"></body>');\n    const bytes = (await tab.screenshot({ type: 'png' })).length;\n    await context.close();\n    return bytes;\n  })();\n  const after = await visit(game);\n  // A line of text on a plain screen already adds about 2 KB; a uniform screen of any colour adds nothing.\n  after.drawn = after.bytes > blank + 1200;\n  const known = before ? new Set((await visit(before)).errors) : new Set();\n  const fresh = after.errors.filter((e) => !known.has(e));\n  if (!bare) {\n    check('on its own: the session client is there and inactive', after.hub && after.hub.active === false, JSON.stringify(after.hub));\n    // A client before 1.3.0 has no seeded flag: it never seeds.\n    check('on its own: Math.random is left alone', after.hub && after.hub.seeded !== true, JSON.stringify(after.hub));\n  }\n  const g = after.gfx;\n  const noWebGPU = g?.askedForWebGPU && !g.gotAdapter && !g.webgl && !g.twoD;\n  const asked = g ? `WebGPU ${g.askedForWebGPU ? (g.gotAdapter ? 'asked, adapter' : 'asked, no adapter') : 'not asked'}; WebGL ${g.webgl ? 'yes' : 'no'}; 2D ${g.twoD ? 'yes' : 'no'}` : 'not seen';\n  check('on its own: this browser can run it', !noWebGPU, noWebGPU ? `it asked for WebGPU, this browser has no adapter, and drew nothing with WebGL or 2D instead (${asked})` : asked);\n  check('on its own: it draws its screen', after.drawn, `${after.bytes} bytes of screenshot, a blank screen is ${blank}`);\n  // Drawing is all a bare page is asked: its own errors are the original's business.\n  if (!bare) check(`on its own: no errors${before ? ' the original did not have' : ''}`, !fresh.length, fresh.slice(0, 3).join('; '));\n  return { pass: checks.every((c) => c.pass), checks };\n}\n\n/**\n * Keep the verdict with the game: a failure takes it out of sessions until it\n * passes again (see the header). Games are found by path in data/games.json.\n */\nasync function recordChecks() {\n  let manifest;\n  try {\n    manifest = JSON.parse(await readFile(path.join(ROOT, 'data/games.json'), 'utf8'));\n  } catch {\n    console.log('--record needs data/games.json: run pnpm scan first');\n    return;\n  }\n  const slugOf = new Map();\n  for (const g of manifest.games) for (const p of [g.path, ...(g.builds || []).map((b) => b.path)]) if (p) slugOf.set(decodeURI(p), g.slug);\n  const file = path.join(ROOT, 'data/overrides.json');\n  const overrides = JSON.parse(await readFile(file, 'utf8'));\n  const today = new Date().toISOString().slice(0, 10);\n  for (const game of games) {\n    const slug = slugOf.get(decodeURI(game));\n    if (!slug) {\n      console.log(`--record: ${game} is not in the catalogue, nothing recorded`);\n      continue;\n    }\n    // A shared world that cannot yet be hosted by a server still plays: that run is reported, not held against it.\n    const mine = runs.filter((r) => r.game === game && r.scenario !== 'server');\n    const failed = [...new Set(mine.flatMap((r) => r.checks.filter((c) => !c.pass).map((c) => c.name)))];\n    const entry = { ...(overrides[slug] || {}) };\n    if (!failed.length) {\n      if (entry.session === '0') delete entry.session;\n      delete entry.sessionNote;\n    } else {\n      entry.session = '0';\n      entry.sessionNote = `hub-check failed on ${today}: ${failed.slice(0, 3).join('; ')}`.slice(0, 240);\n    }\n    if (Object.keys(entry).length) overrides[slug] = entry;\n    else delete overrides[slug];\n    console.log(`--record: ${slug} ${failed.length ? 'kept out of sessions' : 'may be dealt'}`);\n  }\n  await writeFile(file, `${JSON.stringify(overrides, null, 2)}\\n`);\n}\n\nconst pass = runs.every((r) => r.pass);\nif (record) await recordChecks();\nawait mkdir(path.join(ROOT, '.cache'), { recursive: true });\nawait writeFile(path.join(ROOT, '.cache', 'hub-check.json'), JSON.stringify({ schemaVersion: 1, base, pass, runs }, null, 2));\nif (asJson) console.log(JSON.stringify({ pass, runs }, null, 2));\nelse console.log(`\\n${pass ? 'All checks passed' : 'Some checks failed'} — report in .cache/hub-check.json`);","numLines":200,"startLine":170,"totalLines":371}},"tool_result_meta":[{"id":"toolu_01Cxbg2UTtT4sZ8EDVQMNmTv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
