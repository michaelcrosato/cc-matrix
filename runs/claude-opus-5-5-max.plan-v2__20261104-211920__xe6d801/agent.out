s.argv[1:] or ['webgpu']\n    for w in which:\n        if w == 'webgpu': run(pw, 'webgpu', pw.chromium, GPU, '')\n        if w == 'hush': run(pw, 'webgpu-hush', pw.chromium, GPU, '?hush=1', wait=6)\n        if w == 'danger': run(pw, 'webgpu-danger', pw.chromium, GPU, '?danger=1', wait=6)\n        if w == 'webgl': run(pw, 'webgl-forced', pw.chromium, [], '?webgl=1')\n        if w == 'noflags': run(pw, 'chromium-noflags', pw.chromium, [], '')\n        if w == 'firefox': run(pw, 'firefox', pw.firefox, [], '')\n        if w == 'webkit': run(pw, 'webkit', pw.webkit, [], '')\nEOF\nPLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 timeout 280 python3 run.py webgpu noflags 2>&1 | tail -30","description":"Run the single-file prototype in Chromium with and without WebGPU flags","timeout":300000}}}
