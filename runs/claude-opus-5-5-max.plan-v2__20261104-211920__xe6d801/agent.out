const rep = await page.evaluate(() => window.__hubCheck);\n  const back = await page.evaluate(() => [...document.querySelectorAll('iframe')].map((f) => { try { return f.contentWindow.__backend ?? 'none'; } catch { return '?'; } }));\n  console.log(name, 'finished', ok, 'pass', rep?.pass, 'sec', Math.round((Date.now() - t) / 1000), 'backends', back.join(','), 'warnings', [...new Set(warns)].slice(0, 3), 'errors', errs.slice(0, 3));\n  for (const c of rep?.checks ?? []) if (!c.pass) console.log('   ✗', c.name, '—', c.detail);\n  if (process.env.SHOT) await page.screenshot({ path: `hubtest/${name}.png` });\n  await b.close();\n}\nsrv.kill();\nEOF\nnode hubtest/build.mjs && PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 SHOT=1 timeout 550 node hubtest/run.mjs p2 p4 leave server 2>&1 | tail -30","description":"Run a skeleton shared-world game through the real hub harness","timeout":590000}},"wire_ingest_context":{"toolu_0136ABvjuo1pmXLU5pYVWqjN":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211920__xe6d801/work/.research/proto"}}}
