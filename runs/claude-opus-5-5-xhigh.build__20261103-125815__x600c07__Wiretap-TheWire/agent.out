{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cggb3SBq8SSyzncaML12e","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DwisWnpNLxnTy1WZ4Km8TN","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-125815__x600c07/work/Wiretap-TheWire-claude-opus-5-5-xhigh-20261103-125815/engine\ncat kits/stealth.js","description":"Read the stealth kit source"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11183,"cache_read_input_tokens":152440,"cache_creation":{"ephemeral_5m_input_tokens":11183,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c954ed14-e406-494c-b7ce-2e71ce3da87b","uuid":"1b224769-c820-4def-a288-867a533830f1","timestamp":"2026-11-03T19:59:32.278Z","request_id":"req_011Cggb3Rom3UctghYCjeCKH","wire_tool_inputs":{"toolu_01DwisWnpNLxnTy1WZ4Km8TN":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-125815__x600c07/work/Wiretap-TheWire-claude-opus-5-5-xhigh-20261103-125815/engine\ncat kits/stealth.js","description":"Read the stealth kit source"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DwisWnpNLxnTy1WZ4Km8TN","type":"tool_result","content":"<persisted-output>\nOutput too large (36.3KB). Full output saved to: /home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-xhigh-build--20261103-125815--x600c07-work/c954ed14-e406-494c-b7ce-2e71ce3da87b/tool-results/b4p6xtfzd.txt\n\nPreview (first 2KB):\n// The STEALTH kit's game (third-person stealth and parkour: a rooftop district at dusk, guards with sight and suspicion, climbing, takedowns, an HTML HUD; Assassin's Creed, Metal Gear), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/70-stealth.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. stealth.html plays it; node kits/test.mjs stealth runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n...\n</persisted-output>","is_error":false}]},"parent_tool_use_id":null,"session_id":"c954ed14-e406-494c-b7ce-2e71ce3da87b","uuid":"ba04a949-36df-4844-b6b9-abcdc733fdce","timestamp":"2026-11-03T19:59:32.323Z","tool_use_result":{"stdout":"// The STEALTH kit's game (third-person stealth and parkour: a rooftop district at dusk, guards with sight and suspicion, climbing, takedowns, an HTML HUD; Assassin's Creed, Metal Gear), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/70-stealth.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. stealth.html plays it; node kits/test.mjs stealth runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 7  STEALTH  (Assassin's Creed, Metal Gear, Tenchu). A rooftop district at dusk: steal the ledger from the brick\n * roof and slip out by the east gate. Three guards (one on a roof) patrol with sight cones; what they see makes them\n * notice (?), search the last place they saw you, and at last chase (!) across the roofs. Hide in tall grass while\n * crouched, take a guard down silently from behind (J), or from a roof above (J as you stand over them). In a fight their\n * swings are telegraphed: K just before the blow parries and stuns them.\n * Keys (E.Input.THIRDPERSON): WASD move, Shift sprint, Space jump, climb a wall, vault, leap a gap, C crouch, J attack or\n * take down, K block or parry, L dodge roll, V view. The ledger is a checkpoint. The hero climbs any wall: Space at a\n * face latches on, the stick climbs (up the screen is up the wall), Space leaps up, C lets go. TOUCH: the stick, JUMP,\n * ATTACK, BLOCK, CROUCH.\n * HOW IT WORKS: the hero and the guards are E.Mover bodies (the same climbing, vaulting and gap-leaping for both); a\n * guard's eyes are E.sees through the map's heights, its mind an E.Suspicion, its legs a FlowField that climbs, drops and\n * jumps. Climbs, vaults, rolls and takedowns are E.ACTIONS; the facades are wall-type options; the belfry's canopy sorts by\n * its footprint; r.sightCone and r.marker draw the cones and the objective. Dusk is canvas lighting (game.lights): an\n * ambient and the lights added each draw (street lamps, the ledger's glow, the gate), on a computer: its pass costs a\n * few milliseconds a frame, so a phone keeps its frame rate and an unlit street.\n * The interface is HTML, E.Shell's: the objective with its distance, health, status, the takedown prompt, toasts and\n * the results; the guards' marks stay in the world. The music is one song in layers (game.audio.layer): it sneaks on\n * three tracks, and a guard's alert brings in the chase's drums and its saw over them, taken out again when they lose\n * you: no cut to another song.\n * ===================================================================================== */\nconst STEALTH = (() => {\n  const T = 16, HP = 3;\n  // SHADOWS ON THE ROOFS: the sneaking bass, ticks and lead; 'chase' and 'alarm' start silent (on: false)\n  const SONG = { bpm: 108, steps: 4, tracks: [\n    { name: 'bass', wave: 'triangle', vol: .28, notes: 'A2 . . A2 . . A2 . | A2 . . A2 . C3 . . | F2 . . F2 . . F2 . | G2 . . G2 . E2 . .' },\n    { name: 'tick', wave: 'drums', vol: .06, notes: 'h . . h . . h . h . . h . . h .' },\n    { name: 'lead', wave: 'pulse12', vol: .07, notes: 'E5 - . . . . D5 . | C5 - . . B4 . A4 . | . . . . F5 - E5 . | D5 - . . E5 - . . | E5 - . . . . G5 . | F5 - . . E5 . D5 . | C5 - . . D5 - . . | B4 - - - . . . .' },\n    { name: 'chase', wave: 'drums', vol: .13, on: false, notes: 'k . h k s . h . k k h . s . h s' },\n    { name: 'alarm', wave: 'saw', vol: .06, on: false, notes: 'A3 A3 A4 A3 E4 A3 G4 A3 | A3 A3 A4 A3 C5 A3 B4 A3 | F3 F3 F4 F3 C4 F3 E4 F3 | G3 G3 G4 G3 D4 G3 B3 G3' }] };\n  const PAVE = { stones: ['#7a6a60', '#726258', '#806e64'].map(E.hex), mortar: E.hex('#3e3236'), hi: E.hex('#8e7e72'), lo: E.hex('#56484a'), speck: E.hex('#66564e') };   // warm cobbles against the cool stone walls\n  /* ---- THE DISTRICT: roofs 24-56 high a jump apart (3-4 cells), a belfry, tall grass (,) and a planter (p) ---- */\n  const map = new E.TileMap({ rows: [\n    '############################',\n    '#.......................,,,#',\n    '#.AAAA...BBBBB....CCCC...,,#',\n    '#.AAAA...BBBBB....CCCC.....#',\n    '#.AAAA...BBBBB....CCCC..TT.#',\n    '#.AAAA...BBBBB....CCCC..TT.#',\n    '#.........................,#',\n    '#..,,,.......p.......,,,..,#',\n    '#..,,,...............,,,...#',\n    '#.DDDD..EEE....FFFFF.......#',\n    '#.DDDD..EEE....FFFFF..GGG..#',\n    '#.DDDD..EEE....FFFFF..GGG..#',\n    '#.@.......................X#',\n    '############################'],\n    legend: { '#': 1, A: 2, B: 3, C: 4, D: 5, E: 6, F: 7, G: 8, T: 9, p: 10, ',': { floor: 'grass' }, '@': 'hero', X: 'exit' },\n    types: {\n      1: { h: 64, top: '#3a3448', side: '#5a5068', face: 'stone', roof: 'plain', cut: true, cutH: 6 },   // the city wall drops low on the camera's side\n      2: { h: 40, top: '#8a4a3a', side: '#c8b89a', face: 'plaster', roof: 'tiles', windows: { lit: .3 }, shutters: '#2a5a8a', door: { chance: .4 } },\n      3: { h: 48, top: '#5a4a3a', side: '#9a6a4a', face: 'brick', roof: 'slab', windows: { lit: .2 }, balcony: { z: 30, color: '#3a2a1e' } },\n      4: { h: 40, top: '#4a6a3a', side: '#b8a888', face: 'timber', roof: 'tiles', arch: { chance: .5 }, windows: true },\n      5: { h: 24, top: '#7a4a32', side: '#d0c0a0', face: 'plaster', roof: 'tiles', door: { chance: .5, color: '#5a2a1a' }, windows: { from: 12, lit: .4 } },\n      6: { h: 48, top: '#6a5a6a', side: '#7a7a8a', face: 'stone', roof: 'plain', windows: { w: 4, h: 12, lit: .15 } },\n      7: { h: 40, top: '#8a5a3a', side: '#c8a888', face: 'plaster', roof: 'tiles', windows: true, shutters: '#6a3a2a', balcony: { z: 24 } },\n      8: { h: 24, top: '#4a6a3a', side: '#a89878', face: 'timber', roof: 'tiles', arch: { chance: .6 } },\n      9: { h: 72, top: '#7a6a5a', side: '#a89878', face: 'sandstone', roof: 'plain', windows: { w: 3, h: 10, step: 22, lit: .5 } },   // the belfry: face, a MATERIAL (docs/ASSETS.md)\n      10: { h: 10, top: '#3e7a3a', side: '#5a4a32', face: 'plank', roof: 'leaves' } },\n    floorTex: (x, y, tag) => tag === 'grass' ? E.tex.grass(x, y, { base: '#3e6a32', dark: '#2a5226', light: '#5a8a42' }) : E.tex.flagstone(x, y, PAVE)\n  });\n  const LEDGER = { x: 11.5 * T, y: 3.5 * T, z: 48 }, EXIT = map.find('exit'), GRASS = [];\n  // set dressing: SHAPES (E.SHAPES, docs/ASSETS.md: objects as data, right in every view) along the north street, out of the patrols' way\n  const DRESS = [['barrel', 1.5 * T, 1.4 * T, { facing: .4 }], ['barrel', 2.5 * T, 1.3 * T, { facing: 2 }], ['crate', 7.4 * T, 1.4 * T, { scale: .8, facing: .2 }],\n    ['cart', 15.5 * T, 1.5 * T, { facing: 0 }], ['sack', 16.9 * T, 1.3 * T, { facing: 1 }], ['barrel', 22.6 * T, 1.4 * T, { facing: 3 }],\n    // stacked planks from the asset store, cut into the page's 'stealth' set (src/assets/sets/stealth.js; none without it)\n    ...(E.addAssets((window.ASSETS || {}).stealth || { set: 'stealth' }).shapes.length ? [['stealth:resource-planks', 12.2 * T, 1.4 * T, { scale: .7, facing: Math.PI / 2 + .1 }]] : [])];\n  for (let cy = 0; cy < map.h; cy++) for (let cx = 0; cx < map.w; cx++) if (map.floorAt((cx + .5) * T, (cy + .5) * T) === 'grass') GRASS.push([(cx + .5) * T, (cy + .5) * T]);\n  const BOOK = E.sprite(['.bbbb.', 'bBBBBb', 'bBwwBb', 'bBBBBb', '.bbbb.'], { b: '#3a2010', B: '#8a3a20', w: '#f0e0b0' });\n  const ROUTES = [   // [start, ...patrol points] in cells, and the guard's roof height\n    [[19.5, 3.5, 40], [21.5, 3.5, 40], [21.5, 5.5, 40], [18.5, 5.5, 40]],\n    [[6.5, 6.5, 0], [20.5, 6.5, 0], [20.5, 8.5, 0], [6.5, 8.5, 0]],\n    [[11.5, 12.2, 0], [20.5, 12.2, 0], [20.5, 8.2, 0], [11.5, 8.2, 0]]\n  ];\n  let hero, rig, guards, attack, checkpoint, ledger, won, over, hp, hurtT, alertT, ui = null;\n  const say = (title, text) => ui.toast(title, text, 3);\n  const inGrass = b => b.z < 2 && map.floorAt(b.x, b.y) === 'grass';\n\n  /* ---- GUARDS: a Mover with patrol points, eyes, a mind and a flow field that climbs, drops and jumps ---- */\n  function makeGuard(route, i) {\n    const [x, y, z] = route[0];\n    const g = new E.Mover({ x: x * T, y: y * T, z, r: 5, run: 70, walk: 30, climbMax: 56, hopMax: 56 });\n    Object.assign(g, { i, route: route.map(p => [p[0] * T, p[1] * T]), at: 1, mind: new E.Suspicion({ rise: 1.6, decay: .25, forget: 7 }), hp: 2, stun: 0, dead: false,\n      flow: new E.FlowField(map, { climb: 56, drop: 56, jump: 60 }), wait: 0, hit: null, swing: new E.Attack('overhead', { wind: .38, recover: .3, reach: 9 }), bark: 0,\n      rig: new E.Humanoid({ size: 1.2, build: 'heroic', hat: 'helmet', armor: true, weapon: 'sword', colors: { cloth: ['#8a3a32', '#6a3a5a', '#7a4a2a'][i], metal: '#c8c8d8' } }) });\n    return g;\n  }\n  function guardUpdate(g, dt) {\n    if (g.dead) return;   // (a takedown moves the body it takes: the hero's action plays it)\n    if (g.stun > 0) { g.stun -= dt; g.update(dt, map, { move: [0, 0] }); return; }\n    const seen = hero && !over ? E.sees(g, hero, { map, range: 110, fov: 1.5 }) : { seen: false, exposure: 0 }, st = g.mind.update(dt, seen, hero);\n    if (g.mind.changed && st === 'alert') { A.sfx('select'); g.bark = 1.2; }\n    let goal = null, speed = 'walk';\n    if (st === 'alert') { goal = hero; speed = 'run'; }\n    else if (st === 'search' && g.mind.last) goal = g.mind.last;\n    else if (st === 'notice') { g.facing = E.approachAng(g.facing, Math.atan2(g.mind.last.y - g.y, g.mind.last.x - g.x), dt * 3); g.update(dt, map, { move: [0, 0] }); return; }\n    else { const p = g.route[g.at]; goal = { x: p[0], y: p[1], z: 0 }; if (Math.hypot(p[0] - g.x, p[1] - g.y) < 8) { g.at = (g.at + 1) % g.route.length; g.wait = .8; } }\n    if (g.wait > 0 && st === 'calm') { g.wait -= dt; g.update(dt, map, { move: [0, 0] }); return; }\n    // in reach of the hero: a telegraphed swing (a long wind-up), else walk the field toward the goal\n    const d = Math.hypot(hero.x - g.x, hero.y - g.y), near = st === 'alert' && d < 20 && E.sameLevel(g, hero, 10);\n    if (near && !g.swing.busy && !hero.action) { g.facing = Math.atan2(hero.y - g.y, hero.x - g.x); g.swing.start(); A.sfx('swing', { vol: .5 }); }\n    const began = g.swing.update(dt);\n    if (g.swing.busy) { g.update(dt, map, { move: [0, 0] }); if (g.swing.active && began === 'active') strikeHero(g); return; }\n    let move = [0, 0], jump = false;\n    if (goal) {\n      g.flow.update(goal.x, goal.y);\n      const nx = g.flow.next(g.x, g.y), tx = nx ? nx.x : goal.x, ty = nx ? nx.y : goal.y, l = Math.hypot(tx - g.x, ty - g.y) || 1;\n      if (Math.hypot(goal.x - g.x, goal.y - g.y) > 6) move = [(tx - g.x) / l, (ty - g.y) / l];\n      if (nx && g.onGround && (nx.kind === 'climb' || nx.kind === 'jump') && nx.edge < g.r + 4) { jump = true; g.facing = Math.atan2(ty - g.y, tx - g.x); }\n    }\n    if (speed === 'walk') move = move.map(v => v * .5);\n    g.update(dt, map, { move, sprint: false, jumpPressed: jump });\n  }\n  function strikeHero(g) {\n    if (!E.inArc(g, g.facing, hero, 20, 1.2, 10) || (hero.action && hero.action.invulnerable)) return;\n    if (game.input.down('block') && !hero.action) { A.sfx('hit', { vol: .4 }); P.sparks(hero.x, hero.y, hero.z + 16, 6, g.facing + Math.PI); return; }\n    hp--; hurtT = .4; game.hitFx(hero.x, hero.y, hero.z + 16, { power: 1, angle: g.facing, sound: 'hurt' }); E.knockback(g, hero, 140);\n    if (hp <= 0) lose();\n  }\n\n  /* ---- THE HERO: a Mover, a hidden blade, a parry, two takedowns ---- */\n  function start() {\n    const s = map.find('hero');\n    hero = new E.Mover({ x: s.x, y: s.y, r: 5, climbAny: true, climbMax: 30 }); hero.facing = 0;   // (walls up to 30 are pulled up at once, higher ones climbed)\n    rig = rig || new E.Humanoid({ size: 1.2, build: 'heroic', hood: true, weapon: 'sword', bladeLen: 7, outfit: 'coat', sleeves: 'long', cape: { len: 6, width: 5, seg: 2.4 }, colors: { cloth: '#d8d2c4', coat: '#d8d2c4', cape: '#8a2a2a', capeIn: '#5a1a1a', pants: '#3a3448', metal: '#e8e8f0' } });\n    attack = new E.Attack('slash', { reach: 9 }); guards = ROUTES.map(makeGuard);\n    ui = ui || new E.Shell(game, { theme: { accent: '#e8c070' } });   // (made once: it takes over from the engine's own, keeping the pause menu)\n    checkpoint = null; ledger = false; won = false; over = false; hp = HP; hurtT = 0; alertT = 0; say('Steal the ledger', 'It lies on the brick roof');\n    game.follow(hero, { z: 18 }); game.cam.bounds = v => map.bounds(v); game.cam.offset = [0, -10]; L.enabled = !!(window.matchMedia && matchMedia('(pointer: fine)').matches); L.ambient = .6; A.music(SONG); A.layer('chase', 0, .02); A.layer('alarm', 0, .02);\n  }\n  function respawnAt(cp) {\n    Object.assign(hero, { x: cp.x, y: cp.y, z: cp.z, vx: 0, vy: 0, vz: 0, onGround: true, action: null }); hp = HP;\n    guards.forEach((g, i) => { if (!g.dead) { const [x, y, z] = ROUTES[i][0]; Object.assign(g, { x: x * T, y: y * T, z, vx: 0, vy: 0, vz: 0, at: 1, stun: 0, action: null }); g.mind.reset(); g.swing.cancel(); } });\n    game.cam.snap = true; say('Back at the checkpoint');\n  }\n  function lose() { if (checkpoint) { A.sfx('die'); respawnAt(checkpoint); } else { over = true; game.after(.8, () => game.go('over', { from: 'stealth' })); } }\n  // a takedown within reach: [guard, from above] or null\n  function takedown() {\n    for (const g of guards) {\n      if (g.dead || g.action) continue;\n      const dz = hero.z - g.z, d = Math.hypot(g.x - hero.x, g.y - hero.y);\n      // from above: the hero stands over a guard below, close enough to drop onto them\n      if (dz > 14 && d < 44 && hero.onGround) return [g, true];\n      // from behind: close, on the same level, outside the guard's view and not yet hunting\n      const behind = Math.abs(E.angDiff(g.facing, Math.atan2(g.y - hero.y, g.x - hero.x))) < 1.1;\n      if (E.sameLevel(hero, g) && d < 18 && behind && g.mind.state !== 'alert') return [g, false];\n    }\n    return null;\n  }\n  function tryTakedown() { const t = takedown(); if (!t) return false; hero.play('takedown', { other: t[0], aerial: t[1], map }); return finishGuard(t[0], hero.action); }\n  const parrying = () => guards.some(g => !g.dead && g.swing.phase === 'wind' && g.swing.u > .35 && Math.hypot(g.x - hero.x, g.y - hero.y) < 26);\n  function finishGuard(g, act) { g.dead = true; g.action = act; A.sfx('punch'); game.freeze(.06); return true; }\n  function heroUpdate(dt) {\n    const I = game.input;\n    hero.exposure = inGrass(hero) && hero.crouch ? 0 : 1;   // crouched in tall grass: unseen\n    if (!hero.action) {\n      if (I.pressed('dodge') && hero.dodge(undefined, 34)) A.sfx('whoosh');\n      else if (I.pressed('attack') && !tryTakedown() && attack.start()) { I.consume('attack'); A.sfx('swing'); }\n    }\n    attack.update(dt);\n    attack.hits(guards.filter(g => !g.dead), g => E.inArc(hero, hero.facing, g, 20, 1.3, 10), g => {\n      game.hitFx(g.x, g.y, g.z + 16, { power: g.stun > 0 ? 2 : 1, angle: hero.facing }); E.knockback(hero, g, 90);\n      if (g.stun > 0 || --g.hp <= 0) { g.dead = true; g.action = null; A.sfx('die', { vol: .5 }); } else g.mind.level = 1.2;\n    });\n    // a parry: block in the last moments of a guard's wind-up\n    // CONTEXT touch buttons: ATTACK says TAKE DOWN when one is in reach, BLOCK says PARRY in a guard's wind-up\n    I.touchSet('attack', !hero.action && takedown() ? 'TAKE DOWN' : null); I.touchSet('block', parrying() ? 'PARRY' : null);\n    if (I.pressed('block')) for (const g of guards) if (!g.dead && g.swing.phase === 'wind' && g.swing.u > .35 && Math.hypot(g.x - hero.x, g.y - hero.y) < 26) {\n      g.swing.cancel(); g.stun = 1.3; A.sfx('kick'); game.flash('#ffffff', .08); P.sparks(g.x, g.y, g.z + 18, 10, hero.facing); say('Parried');\n    }\n    hero.update(dt, map, attack.busy ? { move: [0, 0] } : I);\n    if (hero.hurt) { hp--; hurtT = .4; game.shake(3); if (hp <= 0) lose(); }\n    if (hero.inHazard) hero.respawn();\n    if (!ledger && E.dist(hero, LEDGER) < 12) { ledger = true; checkpoint = { x: hero.x, y: hero.y, z: hero.z }; A.sfx('powerup'); say('Checkpoint', 'The ledger is yours: now the east gate'); }\n    if (ledger && !won && Math.hypot(hero.x - EXIT.x, hero.y - EXIT.y) < 14 && hero.z < 2) { won = true; A.music('victory'); results(); }\n  }\n\n  function results() {\n    const alive = guards.filter(g => !g.dead).length, top = best('stealth', alive);\n    ui.show('results', { kicker: 'Mission complete', title: 'The ledger is out', stats: [[S","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-xhigh-build--20261103-125815--x600c07-work/c954ed14-e406-494c-b7ce-2e71ce3da87b/tool-results/b4p6xtfzd.txt","persistedOutputSize":37126},"tool_result_meta":[{"id":"toolu_01DwisWnpNLxnTy1WZ4Km8TN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cggb3k38KkELa4GGz6pV1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0198cW9Ebs7UrwzvjqYS9oLu","name":"Read","input":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-xhigh-build--20261103-125815--x600c07-work/c954ed14-e406-494c-b7ce-2e71ce3da87b/tool-results/b4p6xtfzd.txt"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1080,"cache_read_input_tokens":163623,"cache_creation":{"ephemeral_5m_input_tokens":1080,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c954ed14-e406-494c-b7ce-2e71ce3da87b","uuid":"db764fc7-0c83-45e2-a301-677fa9770150","timestamp":"2026-11-03T19:59:34.731Z","request_id":"req_011Cggb3ji2eg6LbpbukMBu1","wire_tool_inputs":{"toolu_0198cW9Ebs7UrwzvjqYS9oLu":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-xhigh-build--20261103-125815--x600c07-work/c954ed14-e406-494c-b7ce-2e71ce3da87b/tool-results/b4p6xtfzd.txt"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0198cW9Ebs7UrwzvjqYS9oLu","type":"tool_result","content":"1\t// The STEALTH kit's game (third-person stealth and parkour: a rooftop district at dusk, guards with sight and suspicion, climbing, takedowns, an HTML HUD; Assassin's Creed, Metal Gear), readable: the starter's shell (src/starter/00-shell.js), then\n2\t// the slice from line 159 (src/starter/70-stealth.js: its header says what it plays and how), then the start (90-start.js), as the\n3\t// single-file kit holds them between GAME START and GAME END. stealth.html plays it; node kits/test.mjs stealth runs it headless.\n4\t/* ============================== GAME START ==============================\n5\t * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n6\t * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n7\t * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n8\t * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n9\t * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n10\t * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n11\t * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n12\t * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n13\t * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n14\t * ======================================================================== */\n15\t(() => {\n16\t'use strict';\n17\tconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n18\t\n19\t/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n20\t * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\n21\tconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\n22\tconst P = game.particles, L = game.lights, A = game.audio;\n23\tconst scenes = {};\n24\tlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\n25\tconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n26\t// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n27\t// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\n28\tconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n29\t// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\n30\tconst SLICES = [\n31\t  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n32\t  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n33\t  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n34\t  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n35\t  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n36\t  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n37\t  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n38\t  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n39\t  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n40\t  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n41\t  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n42\t  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n43\t  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n44\t  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n45\t  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n46\t  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n47\t  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n48\t  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n49\t  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n50\t  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n51\t  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n52\t  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n53\t];\n54\t/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n55\t   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n56\t   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n57\t   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\n58\tconst camOpt = () => (game.scene && game.scene.camera) || {};\n59\taddEventListener('keydown', e => {\n60\t  if (e.repeat) return;\n61\t  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n62\t  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n63\t  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n64\t  else if (e.code === 'KeyM') A.mute();\n65\t  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n66\t});\n67\t\n68\t/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n69\t * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\n70\tconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n71\t  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\n72\tconst titleBg = new E.Backdrop('castle-night');\n73\tconst HEROES = [   // six heroes, each dressed with the HD rig options\n74\t  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n75\t  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n76\t  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n77\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n78\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n79\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n80\t];\n81\tHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n82\t// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\n83\tconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n84\t// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\n85\tconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n86\t/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n87\t * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n88\t * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n89\t * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n90\t * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\n91\tconst proof = (id, n, script, state, fresh) => {\n92\t  const was = Math.random, I = game.input, held = new Set();\n93\t  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n94\t  Math.random = E.rng(7);\n95\t  try {\n96\t    if (fresh) fresh();\n97\t    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n98\t    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n99\t    const s = JSON.stringify(state()); let h = 2166136261;\n100\t    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n101\t    return h >>> 0;\n102\t  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n103\t};\n104\t// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\n105\tconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n106\t// START picks too (the touch START, a pad's Start), as Enter does: any player's\n107\tconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n108\t/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n109\t *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\n110\tconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\n111\tlet titleMenu = null;   // (made at the start, once the file's slices are known)\n112\tscenes.title = {\n113\t  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n114\t  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n115\t  update(dt) {\n116\t    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n117\t    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n118\t    const t = game.time;\n119\t    HEROES.forEach((h, i) => {\n120\t      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n121\t      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n122\t    });\n123\t  },\n124\t  draw(r) {\n125\t    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n126\t    titleMenu.y = 76 + top;\n127\t    titleBg.draw(r);\n128\t    stage.draw(r);\n129\t    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n130\t    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n131\t    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n132\t    r.overlay(g => {\n133\t      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n134\t      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n135\t      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n136\t    });\n137\t    titleMenu.draw(r);\n138\t    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n139\t      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n140\t    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n141\t  }\n142\t};\n143\t\n144\t/* ---- GAME OVER: shared by every slice ---- */\n145\tconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\n146\tconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n147\t  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\n148\tscenes.over = {\n149\t  view: 'side', input: 'DEFAULT', res: 'ps1',\n150\t  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n151\t  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n152\t  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n153\t  draw(r) {   // centred on any screen\n154\t    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n155\t    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n156\t  }\n157\t};\n158\t\n159\t/* =====================================================================================\n160\t * SLICE 7  STEALTH  (Assassin's Creed, Metal Gear, Tenchu). A rooftop district at dusk: steal the ledger from the brick\n161\t * roof and slip out by the east gate. Three guards (one on a roof) patrol with sight cones; what they see makes them\n162\t * notice (?), search the last place they saw you, and at last chase (!) across the roofs. Hide in tall grass while\n163\t * crouched, take a guard down silently from behind (J), or from a roof above (J as you stand over them). In a fight their\n164\t * swings are telegraphed: K just before the blow parries and stuns them.\n165\t * Keys (E.Input.THIRDPERSON): WASD move, Shift sprint, Space jump, climb a wall, vault, leap a gap, C crouch, J attack or\n166\t * take down, K block or parry, L dodge roll, V view. The ledger is a checkpoint. The hero climbs any wall: Space at a\n167\t * face latches on, the stick climbs (up the screen is up the wall), Space leaps up, C lets go. TOUCH: the stick, JUMP,\n168\t * ATTACK, BLOCK, CROUCH.\n169\t * HOW IT WORKS: the hero and the guards are E.Mover bodies (the same climbing, vaulting and gap-leaping for both); a\n170\t * guard's eyes are E.sees through the map's heights, its mind an E.Suspicion, its legs a FlowField that climbs, drops and\n171\t * jumps. Climbs, vaults, rolls and takedowns are E.ACTIONS; the facades are wall-type options; the belfry's canopy sorts by\n172\t * its footprint; r.sightCone and r.marker draw the cones and the objective. Dusk is canvas lighting (game.lights): an\n173\t * ambient and the lights added each draw (street lamps, the ledger's glow, the gate), on a computer: its pass costs a\n174\t * few milliseconds a frame, so a phone keeps its frame rate and an unlit street.\n175\t * The interface is HTML, E.Shell's: the objective with its distance, health, status, the takedown prompt, toasts and\n176\t * the results; the guards' marks stay in the world. The music is one song in layers (game.audio.layer): it sneaks on\n177\t * three tracks, and a guard's alert brings in the chase's drums and its saw over them, taken out again when they lose\n178\t * you: no cut to another song.\n179\t * ===================================================================================== */\n180\tconst STEALTH = (() => {\n181\t  const T = 16, HP = 3;\n182\t  // SHADOWS ON THE ROOFS: the sneaking bass, ticks and lead; 'chase' and 'alarm' start silent (on: false)\n183\t  const SONG = { bpm: 108, steps: 4, tracks: [\n184\t    { name: 'bass', wave: 'triangle', vol: .28, notes: 'A2 . . A2 . . A2 . | A2 . . A2 . C3 . . | F2 . . F2 . . F2 . | G2 . . G2 . E2 . .' },\n185\t    { name: 'tick', wave: 'drums', vol: .06, notes: 'h . . h . . h . h . . h . . h .' },\n186\t    { name: 'lead', wave: 'pulse12', vol: .07, notes: 'E5 - . . . . D5 . | C5 - . . B4 . A4 . | . . . . F5 - E5 . | D5 - . . E5 - . . | E5 - . . . . G5 . | F5 - . . E5 . D5 . | C5 - . . D5 - . . | B4 - - - . . . .' },\n187\t    { name: 'chase', wave: 'drums', vol: .13, on: false, notes: 'k . h k s . h . k k h . s . h s' },\n188\t    { name: 'alarm', wave: 'saw', vol: .06, on: false, notes: 'A3 A3 A4 A3 E4 A3 G4 A3 | A3 A3 A4 A3 C5 A3 B4 A3 | F3 F3 F4 F3 C4 F3 E4 F3 | G3 G3 G4 G3 D4 G3 B3 G3' }] };\n189\t  const PAVE = { stones: ['#7a6a60', '#726258', '#806e64'].map(E.hex), mortar: E.hex('#3e3236'), hi: E.hex('#8e7e72'), lo: E.hex('#56484a'), speck: E.hex('#66564e') };   // warm cobbles against the cool stone walls\n190\t  /* ---- THE DISTRICT: roofs 24-56 high a jump apart (3-4 cells), a belfry, tall grass (,) and a planter (p) ---- */\n191\t  const map = new E.TileMap({ rows: [\n192\t    '############################',\n193\t    '#.......................,,,#',\n194\t    '#.AAAA...BBBBB....CCCC...,,#',\n195\t    '#.AAAA...BBBBB....CCCC.....#',\n196\t    '#.AAAA...BBBBB....CCCC..TT.#',\n197\t    '#.AAAA...BBBBB....CCCC..TT.#',\n198\t    '#.........................,#',\n199\t    '#..,,,.......p.......,,,..,#',\n200\t    '#..,,,...............,,,...#',\n201\t    '#.DDDD..EEE....FFFFF.......#',\n202\t    '#.DDDD..EEE....FFFFF..GGG..#',\n203\t    '#.DDDD..EEE....FFFFF..GGG..#',\n204\t    '#.@.......................X#',\n205\t    '############################'],\n206\t    legend: { '#': 1, A: 2, B: 3, C: 4, D: 5, E: 6, F: 7, G: 8, T: 9, p: 10, ',': { floor: 'grass' }, '@': 'hero', X: 'exit' },\n207\t    types: {\n208\t      1: { h: 64, top: '#3a3448', side: '#5a5068', face: 'stone', roof: 'plain', cut: true, cutH: 6 },   // the city wall drops low on the camera's side\n209\t      2: { h: 40, top: '#8a4a3a', side: '#c8b89a', face: 'plaster', roof: 'tiles', windows: { lit: .3 }, shutters: '#2a5a8a', door: { chance: .4 } },\n210\t      3: { h: 48, top: '#5a4a3a', side: '#9a6a4a', face: 'brick', roof: 'slab', windows: { lit: .2 }, balcony: { z: 30, color: '#3a2a1e' } },\n211\t      4: { h: 40, top: '#4a6a3a', side: '#b8a888', face: 'timber', roof: 'tiles', arch: { chance: .5 }, windows: true },\n212\t      5: { h: 24, top: '#7a4a32', side: '#d0c0a0', face: 'plaster', roof: 'tiles', door: { chance: .5, color: '#5a2a1a' }, windows: { from: 12, lit: .4 } },\n213\t      6: { h: 48, top: '#6a5a6a', side: '#7a7a8a', face: 'stone', roof: 'plain', windows: { w: 4, h: 12, lit: .15 } },\n214\t      7: { h: 40, top: '#8a5a3a', side: '#c8a888', face: 'plaster', roof: 'tiles', windows: true, shutters: '#6a3a2a', balcony: { z: 24 } },\n215\t      8: { h: 24, top: '#4a6a3a', side: '#a89878', face: 'timber', roof: 'tiles', arch: { chance: .6 } },\n216\t      9: { h: 72, top: '#7a6a5a', side: '#a89878', face: 'sandstone', roof: 'plain', windows: { w: 3, h: 10, step: 22, lit: .5 } },   // the belfry: face, a MATERIAL (docs/ASSETS.md)\n217\t      10: { h: 10, top: '#3e7a3a', side: '#5a4a32', face: 'plank', roof: 'leaves' } },\n218\t    floorTex: (x, y, tag) => tag === 'grass' ? E.tex.grass(x, y, { base: '#3e6a32', dark: '#2a5226', light: '#5a8a42' }) : E.tex.flagstone(x, y, PAVE)\n219\t  });\n220\t  const LEDGER = { x: 11.5 * T, y: 3.5 * T, z: 48 }, EXIT = map.find('exit'), GRASS = [];\n221\t  // set dressing: SHAPES (E.SHAPES, docs/ASSETS.md: objects as data, right in every view) along the north street, out of the patrols' way\n222\t  const DRESS = [['barrel', 1.5 * T, 1.4 * T, { facing: .4 }], ['barrel', 2.5 * T, 1.3 * T, { facing: 2 }], ['crate', 7.4 * T, 1.4 * T, { scale: .8, facing: .2 }],\n223\t    ['cart', 15.5 * T, 1.5 * T, { facing: 0 }], ['sack', 16.9 * T, 1.3 * T, { facing: 1 }], ['barrel', 22.6 * T, 1.4 * T, { facing: 3 }],\n224\t    // stacked planks from the asset store, cut into the page's 'stealth' set (src/assets/sets/stealth.js; none without it)\n225\t    ...(E.addAssets((window.ASSETS || {}).stealth || { set: 'stealth' }).shapes.length ? [['stealth:resource-planks', 12.2 * T, 1.4 * T, { scale: .7, facing: Math.PI / 2 + .1 }]] : [])];\n226\t  for (let cy = 0; cy < map.h; cy++) for (let cx = 0; cx < map.w; cx++) if (map.floorAt((cx + .5) * T, (cy + .5) * T) === 'grass') GRASS.push([(cx + .5) * T, (cy + .5) * T]);\n227\t  const BOOK = E.sprite(['.bbbb.', 'bBBBBb', 'bBwwBb', 'bBBBBb', '.bbbb.'], { b: '#3a2010', B: '#8a3a20', w: '#f0e0b0' });\n228\t  const ROUTES = [   // [start, ...patrol points] in cells, and the guard's roof height\n229\t    [[19.5, 3.5, 40], [21.5, 3.5, 40], [21.5, 5.5, 40], [18.5, 5.5, 40]],\n230\t    [[6.5, 6.5, 0], [20.5, 6.5, 0], [20.5, 8.5, 0], [6.5, 8.5, 0]],\n231\t    [[11.5, 12.2, 0], [20.5, 12.2, 0], [20.5, 8.2, 0], [11.5, 8.2, 0]]\n232\t  ];\n233\t  let hero, rig, guards, attack, checkpoint, ledger, won, over, hp, hurtT, alertT, ui = null;\n234\t  const say = (title, text) => ui.toast(title, text, 3);\n235\t  const inGrass = b => b.z < 2 && map.floorAt(b.x, b.y) === 'grass';\n236\t\n237\t  /* ---- GUARDS: a Mover with patrol points, eyes, a mind and a flow field that climbs, drops and jumps ---- */\n238\t  function makeGuard(route, i) {\n239\t    const [x, y, z] = route[0];\n240\t    const g = new E.Mover({ x: x * T, y: y * T, z, r: 5, run: 70, walk: 30, climbMax: 56, hopMax: 56 });\n241\t    Object.assign(g, { i, route: route.map(p => [p[0] * T, p[1] * T]), at: 1, mind: new E.Suspicion({ rise: 1.6, decay: .25, forget: 7 }), hp: 2, stun: 0, dead: false,\n242\t      flow: new E.FlowField(map, { climb: 56, drop: 56, jump: 60 }), wait: 0, hit: null, swing: new E.Attack('overhead', { wind: .38, recover: .3, reach: 9 }), bark: 0,\n243\t      rig: new E.Humanoid({ size: 1.2, build: 'heroic', hat: 'helmet', armor: true, weapon: 'sword', colors: { cloth: ['#8a3a32', '#6a3a5a', '#7a4a2a'][i], metal: '#c8c8d8' } }) });\n244\t    return g;\n245\t  }\n246\t  function guardUpdate(g, dt) {\n247\t    if (g.dead) return;   // (a takedown moves the body it takes: the hero's action plays it)\n248\t    if (g.stun > 0) { g.stun -= dt; g.update(dt, map, { move: [0, 0] }); return; }\n249\t    const seen = hero && !over ? E.sees(g, hero, { map, range: 110, fov: 1.5 }) : { seen: false, exposure: 0 }, st = g.mind.update(dt, seen, hero);\n250\t    if (g.mind.changed && st === 'alert') { A.sfx('select'); g.bark = 1.2; }\n251\t    let goal = null, speed = 'walk';\n252\t    if (st === 'alert') { goal = hero; speed = 'run'; }\n253\t    else if (st === 'search' && g.mind.last) goal = g.mind.last;\n254\t    else if (st === 'notice') { g.facing = E.approachAng(g.facing, Math.atan2(g.mind.last.y - g.y, g.mind.last.x - g.x), dt * 3); g.update(dt, map, { move: [0, 0] }); return; }\n255\t    else { const p = g.route[g.at]; goal = { x: p[0], y: p[1], z: 0 }; if (Math.hypot(p[0] - g.x, p[1] - g.y) < 8) { g.at = (g.at + 1) % g.route.length; g.wait = .8; } }\n256\t    if (g.wait > 0 && st === 'calm') { g.wait -= dt; g.update(dt, map, { move: [0, 0] }); return; }\n257\t    // in reach of the hero: a telegraphed swing (a long wind-up), else walk the field toward the goal\n258\t    const d = Math.hypot(hero.x - g.x, hero.y - g.y), near = st === 'alert' && d < 20 && E.sameLevel(g, hero, 10);\n259\t    if (near && !g.swing.busy && !hero.action) { g.facing = Math.atan2(hero.y - g.y, hero.x - g.x); g.swing.start(); A.sfx('swing', { vol: .5 }); }\n260\t    const began = g.swing.update(dt);\n261\t    if (g.swing.busy) { g.update(dt, map, { move: [0, 0] }); if (g.swing.active && began === 'active') strikeHero(g); return; }\n262\t    let move = [0, 0], jump = false;\n263\t    if (goal) {\n264\t      g.flow.update(goal.x, goal.y);\n265\t      const nx = g.flow.next(g.x, g.y), tx = nx ? nx.x : goal.x, ty = nx ? nx.y : goal.y, l = Math.hypot(tx - g.x, ty - g.y) || 1;\n266\t      if (Math.hypot(goal.x - g.x, goal.y - g.y) > 6) move = [(tx - g.x) / l, (ty - g.y) / l];\n267\t      if (nx && g.onGround && (nx.kind === 'climb' || nx.kind === 'jump') && nx.edge < g.r + 4) { jump = true; g.facing = Math.atan2(ty - g.y, tx - g.x); }\n268\t    }\n269\t    if (speed === 'walk') move = move.map(v => v * .5);\n270\t    g.update(dt, map, { move, sprint: false, jumpPressed: jump });\n271\t  }\n272\t  function strikeHero(g) {\n273\t    if (!E.inArc(g, g.facing, hero, 20, 1.2, 10) || (hero.action && hero.action.invulnerable)) return;\n274\t    if (game.input.down('block') && !hero.action) { A.sfx('hit', { vol: .4 }); P.sparks(hero.x, hero.y, hero.z + 16, 6, g.facing + Math.PI); return; }\n275\t    hp--; hurtT = .4; game.hitFx(hero.x, hero.y, hero.z + 16, { power: 1, angle: g.facing, sound: 'hurt' }); E.knockback(g, hero, 140);\n276\t    if (hp <= 0) lose();\n277\t  }\n278\t\n279\t  /* ---- THE HERO: a Mover, a hidden blade, a parry, two takedowns ---- */\n280\t  function start() {\n281\t    const s = map.find('hero');\n282\t    hero = new E.Mover({ x: s.x, y: s.y, r: 5, climbAny: true, climbMax: 30 }); hero.facing = 0;   // (walls up to 30 are pulled up at once, higher ones climbed)\n283\t    rig = rig || new E.Humanoid({ size: 1.2, build: 'heroic', hood: true, weapon: 'sword', bladeLen: 7, outfit: 'coat', sleeves: 'long', cape: { len: 6, width: 5, seg: 2.4 }, colors: { cloth: '#d8d2c4', coat: '#d8d2c4', cape: '#8a2a2a', capeIn: '#5a1a1a', pants: '#3a3448', metal: '#e8e8f0' } });\n284\t    attack = new E.Attack('slash', { reach: 9 }); guards = ROUTES.map(makeGuard);\n285\t    ui = ui || new E.Shell(game, { theme: { accent: '#e8c070' } });   // (made once: it takes over from the engine's own, keeping the pause menu)\n286\t    checkpoint = null; ledger = false; won = false; over = false; hp = HP; hurtT = 0; alertT = 0; say('Steal the ledger', 'It lies on the brick roof');\n287\t    game.follow(hero, { z: 18 }); game.cam.bounds = v => map.bounds(v); game.cam.offset = [0, -10]; L.enabled = !!(window.matchMedia && matchMedia('(pointer: fine)').matches); L.ambient = .6; A.music(SONG); A.layer('chase', 0, .02); A.layer('alarm', 0, .02);\n288\t  }\n289\t  function respawnAt(cp) {\n290\t    Object.assign(hero, { x: cp.x, y: cp.y, z: cp.z, vx: 0, vy: 0, vz: 0, onGround: true, action: null }); hp = HP;\n291\t    guards.forEach((g, i) => { if (!g.dead) { const [x, y, z] = ROUTES[i][0]; Object.assign(g, { x: x * T, y: y * T, z, vx: 0, vy: 0, vz: 0, at: 1, stun: 0, action: null }); g.mind.reset(); g.swing.cancel(); } });\n292\t    game.cam.snap = true; say('Back at the checkpoint');\n293\t  }\n294\t  function lose() { if (checkpoint) { A.sfx('die'); respawnAt(checkpoint); } else { over = true; game.after(.8, () => game.go('over', { from: 'stealth' })); } }\n295\t  // a takedown within reach: [guard, from above] or null\n296\t  function takedown() {\n297\t    for (const g of guards) {\n298\t      if (g.dead || g.action) continue;\n299\t      const dz = hero.z - g.z, d = Math.hypot(g.x - hero.x, g.y - hero.y);\n300\t      // from above: the hero stands over a guard below, close enough to drop onto them\n301\t      if (dz > 14 && d < 44 && hero.onGround) return [g, true];\n302\t      // from behind: close, on the same level, outside the guard's view and not yet hunting\n303\t      const behind = Math.abs(E.angDiff(g.facing, Math.atan2(g.y - hero.y, g.x - hero.x))) < 1.1;\n304\t      if (E.sameLevel(hero, g) && d < 18 && behind && g.mind.state !== 'alert') return [g, false];\n305\t    }\n306\t    return null;\n307\t  }\n308\t  function tryTakedown() { const t = takedown(); if (!t) return false; hero.play('takedown', { other: t[0], aerial: t[1], map }); return finishGuard(t[0], hero.action); }\n309\t  const parrying = () => guards.some(g => !g.dead && g.swing.phase === 'wind' && g.swing.u > .35 && Math.hypot(g.x - hero.x, g.y - hero.y) < 26);\n310\t  function finishGuard(g, act) { g.dead = true; g.action = act; A.sfx('punch'); game.freeze(.06); return true; }\n311\t  function heroUpdate(dt) {\n312\t    const I = game.input;\n313\t    hero.exposure = inGrass(hero) && hero.crouch ? 0 : 1;   // crouched in tall grass: unseen\n314\t    if (!hero.action) {\n315\t      if (I.pressed('dodge') && hero.dodge(undefined, 34)) A.sfx('whoosh');\n316\t      else if (I.pressed('attack') && !tryTakedown() && attack.start()) { I.consume('attack'); A.sfx('swing'); }\n317\t    }\n318\t    attack.update(dt);\n319\t    attack.hits(guards.filter(g => !g.dead), g => E.inArc(hero, hero.facing, g, 20, 1.3, 10), g => {\n320\t      game.hitFx(g.x, g.y, g.z + 16, { power: g.stun > 0 ? 2 : 1, angle: hero.facing }); E.knockback(hero, g, 90);\n321\t      if (g.stun > 0 || --g.hp <= 0) { g.dead = true; g.action = null; A.sfx('die', { vol: .5 }); } else g.mind.level = 1.2;\n322\t    });\n323\t    // a parry: block in the last moments of a guard's wind-up\n324\t    // CONTEXT touch buttons: ATTACK says TAKE DOWN when one is in reach, BLOCK says PARRY in a guard's wind-up\n325\t    I.touchSet('attack', !hero.action && takedown() ? 'TAKE DOWN' : null); I.touchSet('block', parrying() ? 'PARRY' : null);\n326\t    if (I.pressed('block')) for (const g of guards) if (!g.dead && g.swing.phase === 'wind' && g.swing.u > .35 && Math.hypot(g.x - hero.x, g.y - hero.y) < 26) {\n327\t      g.swing.cancel(); g.stun = 1.3; A.sfx('kick'); game.flash('#ffffff', .08); P.sparks(g.x, g.y, g.z + 18, 10, hero.facing); say('Parried');\n328\t    }\n329\t    hero.update(dt, map, attack.busy ? { move: [0, 0] } : I);\n330\t    if (hero.hurt) { hp--; hurtT = .4; game.shake(3); if (hp <= 0) lose(); }\n331\t    if (hero.inHazard) hero.respawn();\n332\t    if (!ledger && E.dist(hero, LEDGER) < 12) { ledger = true; checkpoint = { x: hero.x, y: hero.y, z: hero.z }; A.sfx('powerup'); say('Checkpoint', 'The ledger is yours: now the east gate'); }\n333\t    if (ledger && !won && Math.hypot(hero.x - EXIT.x, hero.y - EXIT.y) < 14 && hero.z < 2) { won = true; A.music('victory'); results(); }\n334\t  }\n335\t\n336\t  function results() {\n337\t    const alive = guards.filter(g => !g.dead).length, top = best('stealth', alive);\n338\t    ui.show('results', { kicker: 'Mission complete', title: 'The ledger is out', stats: [[String(alive), 'guards who never fell'], [String(top), 'the best yet'], [String(HP - hp), 'wounds taken']],\n339\t      actions: [{ label: 'Back to the title', primary: true, fn: () => { ui.hide(); game.go('title'); } }] });\n340\t  }\n341\t  // the HUD, from this step's state: E.Shell redraws only what changed (keys hide by themselves on a touch screen)\n342\t  function hud() {\n343\t    const k = a => game.input.label(a).toUpperCase(), pad = game.input.lastDevice === 'gamepad', td = !hero.action && takedown();\n344\t    ui.hud(won || over ? {} : {\n345\t      objective: ledger ? { step: '02 / 02', title: 'Slip out by the east gate', text: 'Down in the street, at the far end', at: { x: EXIT.x, y: EXIT.y, z: 0 }, from: hero }\n346\t        : { step: '01 / 02', title: 'Steal the ledger', text: 'On the brick roof', at: LEDGER, from: hero },\n347\t      status: hero.exposure === 0 ? { text: 'Hidden', color: '#9ae89a' } : alertT > 0 ? { text: 'Hunted', color: '#ff4a3a' } : hero.crouch ? 'Crouched' : null,\n348\t      bars: [{ label: 'Health', value: hp, max: HP, kind: 'pips', color: '#e8505a' }], counts: [['Guards down', guards.filter(g => g.dead).length]],\n349\t      prompt: touch() ? null : td ? { act: 'attack', label: 'Take down', hint: td[1] ? 'From above' : 'From behind' } : parrying() ? { act: 'block', label: 'Parry' } : null,\n350\t      keys: [[pad ? 'STICK' : ['up', 'left', 'down', 'right'].map(k).join(''), 'Move'], [k('sprint'), 'Sprint'], [k('jump'), 'Jump, climb'], [k('crouch'), 'Crouch'], [k('attack'), 'Strike'], [k('block'), 'Block'], [k('dodge'), 'Roll']]\n351\t    });\n352\t  }\n353\t\n354\t  function update(dt) {\n355\t    if (hurtT > 0) hurtT -= dt;\n356\t    if (won || over) { hud(); rig.update(dt, hero.rigState({ pose: won ? 'cheer' : null })); return; }\n357\t    heroUpdate(dt);\n358\t    for (const g of guards) guardUpdate(g, dt);\n359\t    const alert = guards.some(g => !g.dead && g.mind.state === 'alert');\n360\t    if (alert !== alertT > 0) { alertT = alert ? 1 : 0; A.layer('chase', alert ? 1 : 0, alert ? .4 : 2.5); A.layer('alarm', alert ? 1 : 0, alert ? .8 : 2.5); }   // (the chase comes in by layers, and fades out)\n361\t    rig.update(dt, hero.rigState({ attack: attack.state, pose: game.input.down('block') && !hero.action ? 'block' : null, hurt: hurtT > 0 }));\n362\t    for (const g of guards) {\n363\t      if (g.dead) { g.rig.update(dt, g.action && g.action.other === g ? g.action.otherState() : { x: g.x, y: g.y, z: g.z, facing: g.facing, down: 1 }); continue; }\n364\t      g.rig.update(dt, g.rigState({ attack: g.swing.state, stance: g.mind.state === 'alert' ? 'ready' : null, hurt: g.stun > 0 }));\n365\t      if (g.bark > 0) g.bark -= dt;\n366\t    }\n367\t    hud();\n368\t  }\n369\t\n370\t  const MOOD = { calm: '#ffe080', notice: '#ffc040', search: '#ff9a40', alert: '#ff4a3a' };\n371\t  const LAMPS = [[8.5, 6.2], [16, 8.8], [23.5, 6.2], [12.5, 10.5], [19.5, 1.3]].map(([x, y]) => [x * T, y * T]);   // street lamps, clear of the patrols\n372\t  function draw(r) {\n373\t    map.drawFloor(r); map.queueWalls(r);   // (the street runs on past the walls to the screen's edges: map.outside)\n374\t    for (const [x, y] of GRASS) r.prop('grass', x, y, 0, { size: 1.3 });\n375\t    for (const [id, x, y, o] of DRESS) r.shape(id, x, y, 0, o);\n376\t    for (const [x, y] of LAMPS) r.prop('lamp', x, y, 0, { light: true });   // each glows and lights the street (game.lights)\n377\t    if (!ledger) L.add(LEDGER.x, LEDGER.y, LEDGER.z + 6, 40, .8, { color: '#ffd060' }); else L.add(EXIT.x, EXIT.y, 12, 56, .9, { color: '#80e0ff' });\n378\t    // the belfry: a canopy wider than the tower, sorted by its whole footprint (over every tower block)\n379\t    const bx = 25 * T, by = 5 * T, w = 21, H = 20, z = 72;\n380\t    r.queue(bx, by, z, g => { const P2 = (x, y, zz) => r.w(x, y, zz), c = [P2(bx - w, by - w, z), P2(bx + w, by - w, z), P2(bx + w, by + w, z), P2(bx - w, by + w, z)], tip = P2(bx, by, z + H);\n381\t      for (let i = 0; i < 4; i++) px.poly(g, [c[i], c[(i + 1) % 4], tip], ['#7a3a2a', '#9a4a32', '#6a2a22', '#8a4232'][i]);\n382\t      px.line(g, tip[0], tip[1], tip[0], tip[1] - 6, '#e8c860'); }, { footprint: [bx - w, by - w, bx + w, by + w] });\n383\t    for (const g of guards) if (!g.dead) r.sightCone(g, { map, range: 110, fov: 1.5, color: MOOD[g.mind.state], alpha: g.mind.state === 'calm' ? .22 : .38 });\n384\t    if (!ledger) r.sprite(LEDGER.x, LEDGER.y, LEDGER.z + 4 + Math.sin(game.time * 3) * 1.5, BOOK, { glow: .6 });\n385\t    const shadow = b => r.shadow(b.x, b.y, 6, .35, undefined, map.groundAt(b.x, b.y, b.r, b.z));\n386\t    shadow(hero); r.actor(hero.x, hero.y, hero.z, (g, ox, oy) => rig.draw(g, ox, oy, r.view), { xray: { actors: true }, flash: hurtT > 0, alpha: hero.exposure === 0 ? .55 : 1 });\n387\t    for (const g of guards) { shadow(g); r.actor(g.x, g.y, g.z, (gg, ox, oy) => g.rig.draw(gg, ox, oy, r.view), { flash: g.stun > 0 && Math.floor(game.time * 10) % 2 === 0 }); }\n388\t    r.marker(ledger ? EXIT.x : LEDGER.x, ledger ? EXIT.y : LEDGER.y, ledger ? 0 : LEDGER.z, { label: ledger ? 'EAST GATE' : 'LEDGER', color: ledger ? '#80e0ff' : '#ffd040' });\n389\t    r.overlay(g => {\n390\t      for (const gd of guards) if (!gd.dead && gd.mind.state !== 'calm') {   // ? and ! over their heads, with the meter\n391\t        const [sx, sy] = r.w(gd.x, gd.y, gd.z + 46), a = gd.mind.state === 'alert';\n392\t        E.font.text(g, a ? '!' : '?', Math.round(sx), Math.round(sy) - 8, MOOD[gd.mind.state], { align: 'center', shadow: '#000' });\n393\t        E.ui.bar(g, Math.round(sx) - 6, Math.round(sy) + 2, 12, 2, Math.min(1, gd.mind.level), MOOD[gd.mind.state]);\n394\t      }\n395\t    });\n396\t  }\n397\t  return { view: 'iso', views: ['iso', 'threequarter'], input: 'THIRDPERSON', res: 'ps1', pausable: true, touch: ['jump', 'attack', 'block', 'crouch'],\n398\t    camera: { zoom: [.75, 2], rotate: true }, enter: start, update, draw,\n399\t    state: () => ({ hero, guards, map, ledger, won, hp }),   // for tests\n400\t    /** the proof: over the rooftops, jumping, swinging and crouching, the guards on their rounds; a hash of the run */\n401\t    run: (n = 600) => proof('stealth', n, (i, k) => { walk(i, k, ['right', 'down', 'left', 'up'], 100); if (i % 130 === 60) k.tap('jump'); if (i % 90 === 45) k.tap('attack'); if (i === 400) k.tap('crouch'); },\n402\t      () => [hero.x, hero.y, hero.z, hp, ledger, won, guards.map(g => [g.x, g.y, g.z, g.hp, g.dead])]),\n403\t    exit() { game.cam.offset = null; L.enabled = false; if (ui) ui.hud({}); } };\n404\t})();\n405\tscenes.stealth = STEALTH;\n406\t\n407\t/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n408\t// a genre kit file holds one slice: the menu lists only the slices in this file\n409\tfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\n410\ttitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n411\t// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n412\t// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\n413\tconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\n414\tgame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\n415\twindow.__game = { game, scenes, titleMenu };   // for tests\n416\t})();\n417\t/* =============================== GAME END =============================== */\n418\t"}]},"parent_tool_use_id":null,"session_id":"c954ed14-e406-494c-b7ce-2e71ce3da87b","uuid":"208e5188-4cdd-424d-920b-d9ab698b7a40","timestamp":"2026-11-03T19:59:34.882Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-xhigh-build--20261103-125815--x600c07-work/c954ed14-e406-494c-b7ce-2e71ce3da87b/tool-results/b4p6xtfzd.txt","content":"// The STEALTH kit's game (third-person stealth and parkour: a rooftop district at dusk, guards with sight and suspicion, climbing, takedowns, an HTML HUD; Assassin's Creed, Metal Gear), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/70-stealth.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. stealth.html plays it; node kits/test.mjs stealth runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 7  STEALTH  (Assassin's Creed, Metal Gear, Tenchu). A rooftop district at dusk: steal the ledger from the brick\n * roof and slip out by the east gate. Three guards (one on a roof) patrol with sight cones; what they see makes them\n * notice (?), search the last place they saw you, and at last chase (!) across the roofs. Hide in tall grass while\n * crouched, take a guard down silently from behind (J), or from a roof above (J as you stand over them). In a fight their\n * swings are telegraphed: K just before the blow parries and stuns them.\n * Keys (E.Input.THIRDPERSON): WASD move, Shift sprint, Space jump, climb a wall, vault, leap a gap, C crouch, J attack or\n * take down, K block or parry, L dodge roll, V view. The ledger is a checkpoint. The hero climbs any wall: Space at a\n * face latches on, the stick climbs (up the screen is up the wall), Space leaps up, C lets go. TOUCH: the stick, JUMP,\n * ATTACK, BLOCK, CROUCH.\n * HOW IT WORKS: the hero and the guards are E.Mover bodies (the same climbing, vaulting and gap-leaping for both); a\n * guard's eyes are E.sees through the map's heights, its mind an E.Suspicion, its legs a FlowField that climbs, drops and\n * jumps. Climbs, vaults, rolls and takedowns are E.ACTIONS; the facades are wall-type options; the belfry's canopy sorts by\n * its footprint; r.sightCone and r.marker draw the cones and the objective. Dusk is canvas lighting (game.lights): an\n * ambient and the lights added each draw (street lamps, the ledger's glow, the gate), on a computer: its pass costs a\n * few milliseconds a frame, so a phone keeps its frame rate and an unlit street.\n * The interface is HTML, E.Shell's: the objective with its distance, health, status, the takedown prompt, toasts and\n * the results; the guards' marks stay in the world. The music is one song in layers (game.audio.layer): it sneaks on\n * three tracks, and a guard's alert brings in the chase's drums and its saw over them, taken out again when they lose\n * you: no cut to another song.\n * ===================================================================================== */\nconst STEALTH = (() => {\n  const T = 16, HP = 3;\n  // SHADOWS ON THE ROOFS: the sneaking bass, ticks and lead; 'chase' and 'alarm' start silent (on: false)\n  const SONG = { bpm: 108, steps: 4, tracks: [\n    { name: 'bass', wave: 'triangle', vol: .28, notes: 'A2 . . A2 . . A2 . | A2 . . A2 . C3 . . | F2 . . F2 . . F2 . | G2 . . G2 . E2 . .' },\n    { name: 'tick', wave: 'drums', vol: .06, notes: 'h . . h . . h . h . . h . . h .' },\n    { name: 'lead', wave: 'pulse12', vol: .07, notes: 'E5 - . . . . D5 . | C5 - . . B4 . A4 . | . . . . F5 - E5 . | D5 - . . E5 - . . | E5 - . . . . G5 . | F5 - . . E5 . D5 . | C5 - . . D5 - . . | B4 - - - . . . .' },\n    { name: 'chase', wave: 'drums', vol: .13, on: false, notes: 'k . h k s . h . k k h . s . h s' },\n    { name: 'alarm', wave: 'saw', vol: .06, on: false, notes: 'A3 A3 A4 A3 E4 A3 G4 A3 | A3 A3 A4 A3 C5 A3 B4 A3 | F3 F3 F4 F3 C4 F3 E4 F3 | G3 G3 G4 G3 D4 G3 B3 G3' }] };\n  const PAVE = { stones: ['#7a6a60', '#726258', '#806e64'].map(E.hex), mortar: E.hex('#3e3236'), hi: E.hex('#8e7e72'), lo: E.hex('#56484a'), speck: E.hex('#66564e') };   // warm cobbles against the cool stone walls\n  /* ---- THE DISTRICT: roofs 24-56 high a jump apart (3-4 cells), a belfry, tall grass (,) and a planter (p) ---- */\n  const map = new E.TileMap({ rows: [\n    '############################',\n    '#.......................,,,#',\n    '#.AAAA...BBBBB....CCCC...,,#',\n    '#.AAAA...BBBBB....CCCC.....#',\n    '#.AAAA...BBBBB....CCCC..TT.#',\n    '#.AAAA...BBBBB....CCCC..TT.#',\n    '#.........................,#',\n    '#..,,,.......p.......,,,..,#',\n    '#..,,,...............,,,...#',\n    '#.DDDD..EEE....FFFFF.......#',\n    '#.DDDD..EEE....FFFFF..GGG..#',\n    '#.DDDD..EEE....FFFFF..GGG..#',\n    '#.@.......................X#',\n    '############################'],\n    legend: { '#': 1, A: 2, B: 3, C: 4, D: 5, E: 6, F: 7, G: 8, T: 9, p: 10, ',': { floor: 'grass' }, '@': 'hero', X: 'exit' },\n    types: {\n      1: { h: 64, top: '#3a3448', side: '#5a5068', face: 'stone', roof: 'plain', cut: true, cutH: 6 },   // the city wall drops low on the camera's side\n      2: { h: 40, top: '#8a4a3a', side: '#c8b89a', face: 'plaster', roof: 'tiles', windows: { lit: .3 }, shutters: '#2a5a8a', door: { chance: .4 } },\n      3: { h: 48, top: '#5a4a3a', side: '#9a6a4a', face: 'brick', roof: 'slab', windows: { lit: .2 }, balcony: { z: 30, color: '#3a2a1e' } },\n      4: { h: 40, top: '#4a6a3a', side: '#b8a888', face: 'timber', roof: 'tiles', arch: { chance: .5 }, windows: true },\n      5: { h: 24, top: '#7a4a32', side: '#d0c0a0', face: 'plaster', roof: 'tiles', door: { chance: .5, color: '#5a2a1a' }, windows: { from: 12, lit: .4 } },\n      6: { h: 48, top: '#6a5a6a', side: '#7a7a8a', face: 'stone', roof: 'plain', windows: { w: 4, h: 12, lit: .15 } },\n      7: { h: 40, top: '#8a5a3a', side: '#c8a888', face: 'plaster', roof: 'tiles', windows: true, shutters: '#6a3a2a', balcony: { z: 24 } },\n      8: { h: 24, top: '#4a6a3a', side: '#a89878', face: 'timber', roof: 'tiles', arch: { chance: .6 } },\n      9: { h: 72, top: '#7a6a5a', side: '#a89878', face: 'sandstone', roof: 'plain', windows: { w: 3, h: 10, step: 22, lit: .5 } },   // the belfry: face, a MATERIAL (docs/ASSETS.md)\n      10: { h: 10, top: '#3e7a3a', side: '#5a4a32', face: 'plank', roof: 'leaves' } },\n    floorTex: (x, y, tag) => tag === 'grass' ? E.tex.grass(x, y, { base: '#3e6a32', dark: '#2a5226', light: '#5a8a42' }) : E.tex.flagstone(x, y, PAVE)\n  });\n  const LEDGER = { x: 11.5 * T, y: 3.5 * T, z: 48 }, EXIT = map.find('exit'), GRASS = [];\n  // set dressing: SHAPES (E.SHAPES, docs/ASSETS.md: objects as data, right in every view) along the north street, out of the patrols' way\n  const DRESS = [['barrel', 1.5 * T, 1.4 * T, { facing: .4 }], ['barrel', 2.5 * T, 1.3 * T, { facing: 2 }], ['crate', 7.4 * T, 1.4 * T, { scale: .8, facing: .2 }],\n    ['cart', 15.5 * T, 1.5 * T, { facing: 0 }], ['sack', 16.9 * T, 1.3 * T, { facing: 1 }], ['barrel', 22.6 * T, 1.4 * T, { facing: 3 }],\n    // stacked planks from the asset store, cut into the page's 'stealth' set (src/assets/sets/stealth.js; none without it)\n    ...(E.addAssets((window.ASSETS || {}).stealth || { set: 'stealth' }).shapes.length ? [['stealth:resource-planks', 12.2 * T, 1.4 * T, { scale: .7, facing: Math.PI / 2 + .1 }]] : [])];\n  for (let cy = 0; cy < map.h; cy++) for (let cx = 0; cx < map.w; cx++) if (map.floorAt((cx + .5) * T, (cy + .5) * T) === 'grass') GRASS.push([(cx + .5) * T, (cy + .5) * T]);\n  const BOOK = E.sprite(['.bbbb.', 'bBBBBb', 'bBwwBb', 'bBBBBb', '.bbbb.'], { b: '#3a2010', B: '#8a3a20', w: '#f0e0b0' });\n  const ROUTES = [   // [start, ...patrol points] in cells, and the guard's roof height\n    [[19.5, 3.5, 40], [21.5, 3.5, 40], [21.5, 5.5, 40], [18.5, 5.5, 40]],\n    [[6.5, 6.5, 0], [20.5, 6.5, 0], [20.5, 8.5, 0], [6.5, 8.5, 0]],\n    [[11.5, 12.2, 0], [20.5, 12.2, 0], [20.5, 8.2, 0], [11.5, 8.2, 0]]\n  ];\n  let hero, rig, guards, attack, checkpoint, ledger, won, over, hp, hurtT, alertT, ui = null;\n  const say = (title, text) => ui.toast(title, text, 3);\n  const inGrass = b => b.z < 2 && map.floorAt(b.x, b.y) === 'grass';\n\n  /* ---- GUARDS: a Mover with patrol points, eyes, a mind and a flow field that climbs, drops and jumps ---- */\n  function makeGuard(route, i) {\n    const [x, y, z] = route[0];\n    const g = new E.Mover({ x: x * T, y: y * T, z, r: 5, run: 70, walk: 30, climbMax: 56, hopMax: 56 });\n    Object.assign(g, { i, route: route.map(p => [p[0] * T, p[1] * T]), at: 1, mind: new E.Suspicion({ rise: 1.6, decay: .25, forget: 7 }), hp: 2, stun: 0, dead: false,\n      flow: new E.FlowField(map, { climb: 56, drop: 56, jump: 60 }), wait: 0, hit: null, swing: new E.Attack('overhead', { wind: .38, recover: .3, reach: 9 }), bark: 0,\n      rig: new E.Humanoid({ size: 1.2, build: 'heroic', hat: 'helmet', armor: true, weapon: 'sword', colors: { cloth: ['#8a3a32', '#6a3a5a', '#7a4a2a'][i], metal: '#c8c8d8' } }) });\n    return g;\n  }\n  function guardUpdate(g, dt) {\n    if (g.dead) return;   // (a takedown moves the body it takes: the hero's action plays it)\n    if (g.stun > 0) { g.stun -= dt; g.update(dt, map, { move: [0, 0] }); return; }\n    const seen = hero && !over ? E.sees(g, hero, { map, range: 110, fov: 1.5 }) : { seen: false, exposure: 0 }, st = g.mind.update(dt, seen, hero);\n    if (g.mind.changed && st === 'alert') { A.sfx('select'); g.bark = 1.2; }\n    let goal = null, speed = 'walk';\n    if (st === 'alert') { goal = hero; speed = 'run'; }\n    else if (st === 'search' && g.mind.last) goal = g.mind.last;\n    else if (st === 'notice') { g.facing = E.approachAng(g.facing, Math.atan2(g.mind.last.y - g.y, g.mind.last.x - g.x), dt * 3); g.update(dt, map, { move: [0, 0] }); return; }\n    else { const p = g.route[g.at]; goal = { x: p[0], y: p[1], z: 0 }; if (Math.hypot(p[0] - g.x, p[1] - g.y) < 8) { g.at = (g.at + 1) % g.route.length; g.wait = .8; } }\n    if (g.wait > 0 && st === 'calm') { g.wait -= dt; g.update(dt, map, { move: [0, 0] }); return; }\n    // in reach of the hero: a telegraphed swing (a long wind-up), else walk the field toward the goal\n    const d = Math.hypot(hero.x - g.x, hero.y - g.y), near = st === 'alert' && d < 20 && E.sameLevel(g, hero, 10);\n    if (near && !g.swing.busy && !hero.action) { g.facing = Math.atan2(hero.y - g.y, hero.x - g.x); g.swing.start(); A.sfx('swing', { vol: .5 }); }\n    const began = g.swing.update(dt);\n    if (g.swing.busy) { g.update(dt, map, { move: [0, 0] }); if (g.swing.active && began === 'active') strikeHero(g); return; }\n    let move = [0, 0], jump = false;\n    if (goal) {\n      g.flow.update(goal.x, goal.y);\n      const nx = g.flow.next(g.x, g.y), tx = nx ? nx.x : goal.x, ty = nx ? nx.y : goal.y, l = Math.hypot(tx - g.x, ty - g.y) || 1;\n      if (Math.hypot(goal.x - g.x, goal.y - g.y) > 6) move = [(tx - g.x) / l, (ty - g.y) / l];\n      if (nx && g.onGround && (nx.kind === 'climb' || nx.kind === 'jump') && nx.edge < g.r + 4) { jump = true; g.facing = Math.atan2(ty - g.y, tx - g.x); }\n    }\n    if (speed === 'walk') move = move.map(v => v * .5);\n    g.update(dt, map, { move, sprint: false, jumpPressed: jump });\n  }\n  function strikeHero(g) {\n    if (!E.inArc(g, g.facing, hero, 20, 1.2, 10) || (hero.action && hero.action.invulnerable)) return;\n    if (game.input.down('block') && !hero.action) { A.sfx('hit', { vol: .4 }); P.sparks(hero.x, hero.y, hero.z + 16, 6, g.facing + Math.PI); return; }\n    hp--; hurtT = .4; game.hitFx(hero.x, hero.y, hero.z + 16, { power: 1, angle: g.facing, sound: 'hurt' }); E.knockback(g, hero, 140);\n    if (hp <= 0) lose();\n  }\n\n  /* ---- THE HERO: a Mover, a hidden blade, a parry, two takedowns ---- */\n  function start() {\n    const s = map.find('hero');\n    hero = new E.Mover({ x: s.x, y: s.y, r: 5, climbAny: true, climbMax: 30 }); hero.facing = 0;   // (walls up to 30 are pulled up at once, higher ones climbed)\n    rig = rig || new E.Humanoid({ size: 1.2, build: 'heroic', hood: true, weapon: 'sword', bladeLen: 7, outfit: 'coat', sleeves: 'long', cape: { len: 6, width: 5, seg: 2.4 }, colors: { cloth: '#d8d2c4', coat: '#d8d2c4', cape: '#8a2a2a', capeIn: '#5a1a1a', pants: '#3a3448', metal: '#e8e8f0' } });\n    attack = new E.Attack('slash', { reach: 9 }); guards = ROUTES.map(makeGuard);\n    ui = ui || new E.Shell(game, { theme: { accent: '#e8c070' } });   // (made once: it takes over from the engine's own, keeping the pause menu)\n    checkpoint = null; ledger = false; won = false; over = false; hp = HP; hurtT = 0; alertT = 0; say('Steal the ledger', 'It lies on the brick roof');\n    game.follow(hero, { z: 18 }); game.cam.bounds = v => map.bounds(v); game.cam.offset = [0, -10]; L.enabled = !!(window.matchMedia && matchMedia('(pointer: fine)').matches); L.ambient = .6; A.music(SONG); A.layer('chase', 0, .02); A.layer('alarm', 0, .02);\n  }\n  function respawnAt(cp) {\n    Object.assign(hero, { x: cp.x, y: cp.y, z: cp.z, vx: 0, vy: 0, vz: 0, onGround: true, action: null }); hp = HP;\n    guards.forEach((g, i) => { if (!g.dead) { const [x, y, z] = ROUTES[i][0]; Object.assign(g, { x: x * T, y: y * T, z, vx: 0, vy: 0, vz: 0, at: 1, stun: 0, action: null }); g.mind.reset(); g.swing.cancel(); } });\n    game.cam.snap = true; say('Back at the checkpoint');\n  }\n  function lose() { if (checkpoint) { A.sfx('die'); respawnAt(checkpoint); } else { over = true; game.after(.8, () => game.go('over', { from: 'stealth' })); } }\n  // a takedown within reach: [guard, from above] or null\n  function takedown() {\n    for (const g of guards) {\n      if (g.dead || g.action) continue;\n      const dz = hero.z - g.z, d = Math.hypot(g.x - hero.x, g.y - hero.y);\n      // from above: the hero stands over a guard below, close enough to drop onto them\n      if (dz > 14 && d < 44 && hero.onGround) return [g, true];\n      // from behind: close, on the same level, outside the guard's view and not yet hunting\n      const behind = Math.abs(E.angDiff(g.facing, Math.atan2(g.y - hero.y, g.x - hero.x))) < 1.1;\n      if (E.sameLevel(hero, g) && d < 18 && behind && g.mind.state !== 'alert') return [g, false];\n    }\n    return null;\n  }\n  function tryTakedown() { const t = takedown(); if (!t) return false; hero.play('takedown', { other: t[0], aerial: t[1], map }); return finishGuard(t[0], hero.action); }\n  const parrying = () => guards.some(g => !g.dead && g.swing.phase === 'wind' && g.swing.u > .35 && Math.hypot(g.x - hero.x, g.y - hero.y) < 26);\n  function finishGuard(g, act) { g.dead = true; g.action = act; A.sfx('punch'); game.freeze(.06); return true; }\n  function heroUpdate(dt) {\n    const I = game.input;\n    hero.exposure = inGrass(hero) && hero.crouch ? 0 : 1;   // crouched in tall grass: unseen\n    if (!hero.action) {\n      if (I.pressed('dodge') && hero.dodge(undefined, 34)) A.sfx('whoosh');\n      else if (I.pressed('attack') && !tryTakedown() && attack.start()) { I.consume('attack'); A.sfx('swing'); }\n    }\n    attack.update(dt);\n    attack.hits(guards.filter(g => !g.dead), g => E.inArc(hero, hero.facing, g, 20, 1.3, 10), g => {\n      game.hitFx(g.x, g.y, g.z + 16, { power: g.stun > 0 ? 2 : 1, angle: hero.facing }); E.knockback(hero, g, 90);\n      if (g.stun > 0 || --g.hp <= 0) { g.dead = true; g.action = null; A.sfx('die', { vol: .5 }); } else g.mind.level = 1.2;\n    });\n    // a parry: block in the last moments of a guard's wind-up\n    // CONTEXT touch buttons: ATTACK says TAKE DOWN when one is in reach, BLOCK says PARRY in a guard's wind-up\n    I.touchSet('attack', !hero.action && takedown() ? 'TAKE DOWN' : null); I.touchSet('block', parrying() ? 'PARRY' : null);\n    if (I.pressed('block')) for (const g of guards) if (!g.dead && g.swing.phase === 'wind' && g.swing.u > .35 && Math.hypot(g.x - hero.x, g.y - hero.y) < 26) {\n      g.swing.cancel(); g.stun = 1.3; A.sfx('kick'); game.flash('#ffffff', .08); P.sparks(g.x, g.y, g.z + 18, 10, hero.facing); say('Parried');\n    }\n    hero.update(dt, map, attack.busy ? { move: [0, 0] } : I);\n    if (hero.hurt) { hp--; hurtT = .4; game.shake(3); if (hp <= 0) lose(); }\n    if (hero.inHazard) hero.respawn();\n    if (!ledger && E.dist(hero, LEDGER) < 12) { ledger = true; checkpoint = { x: hero.x, y: hero.y, z: hero.z }; A.sfx('powerup'); say('Checkpoint', 'The ledger is yours: now the east gate'); }\n    if (ledger && !won && Math.hypot(hero.x - EXIT.x, hero.y - EXIT.y) < 14 && hero.z < 2) { won = true; A.music('victory'); results(); }\n  }\n\n  function results() {\n    const alive = guards.filter(g => !g.dead).length, top = best('stealth', alive);\n    ui.show('results', { kicker: 'Mission complete', title: 'The ledger is out', stats: [[String(alive), 'guards who never fell'], [String(top), 'the best yet'], [String(HP - hp), 'wounds taken']],\n      actions: [{ label: 'Back to the title', primary: true, fn: () => { ui.hide(); game.go('title'); } }] });\n  }\n  // the HUD, from this step's state: E.Shell redraws only what changed (keys hide by themselves on a touch screen)\n  function hud() {\n    const k = a => game.input.label(a).toUpperCase(), pad = game.input.lastDevice === 'gamepad', td = !hero.action && takedown();\n    ui.hud(won || over ? {} : {\n      objective: ledger ? { step: '02 / 02', title: 'Slip out by the east gate', text: 'Down in the street, at the far end', at: { x: EXIT.x, y: EXIT.y, z: 0 }, from: hero }\n        : { step: '01 / 02', title: 'Steal the ledger', text: 'On the brick roof', at: LEDGER, from: hero },\n      status: hero.exposure === 0 ? { text: 'Hidden', color: '#9ae89a' } : alertT > 0 ? { text: 'Hunted', color: '#ff4a3a' } : hero.crouch ? 'Crouched' : null,\n      bars: [{ label: 'Health', value: hp, max: HP, kind: 'pips', color: '#e8505a' }], counts: [['Guards down', guards.filter(g => g.dead).length]],\n      prompt: touch() ? null : td ? { act: 'attack', label: 'Take down', hint: td[1] ? 'From above' : 'From behind' } : parrying() ? { act: 'block', label: 'Parry' } : null,\n      keys: [[pad ? 'STICK' : ['up', 'left', 'down', 'right'].map(k).join(''), 'Move'], [k('sprint'), 'Sprint'], [k('jump'), 'Jump, climb'], [k('crouch'), 'Crouch'], [k('attack'), 'Strike'], [k('block'), 'Block'], [k('dodge'), 'Roll']]\n    });\n  }\n\n  function update(dt) {\n    if (hurtT > 0) hurtT -= dt;\n    if (won || over) { hud(); rig.update(dt, hero.rigState({ pose: won ? 'cheer' : null })); return; }\n    heroUpdate(dt);\n    for (const g of guards) guardUpdate(g, dt);\n    const alert = guards.some(g => !g.dead && g.mind.state === 'alert');\n    if (alert !== alertT > 0) { alertT = alert ? 1 : 0; A.layer('chase', alert ? 1 : 0, alert ? .4 : 2.5); A.layer('alarm', alert ? 1 : 0, alert ? .8 : 2.5); }   // (the chase comes in by layers, and fades out)\n    rig.update(dt, hero.rigState({ attack: attack.state, pose: game.input.down('block') && !hero.action ? 'block' : null, hurt: hurtT > 0 }));\n    for (const g of guards) {\n      if (g.dead) { g.rig.update(dt, g.action && g.action.other === g ? g.action.otherState() : { x: g.x, y: g.y, z: g.z, facing: g.facing, down: 1 }); continue; }\n      g.rig.update(dt, g.rigState({ attack: g.swing.state, stance: g.mind.state === 'alert' ? 'ready' : null, hurt: g.stun > 0 }));\n      if (g.bark > 0) g.bark -= dt;\n    }\n    hud();\n  }\n\n  const MOOD = { calm: '#ffe080', notice: '#ffc040', search: '#ff9a40', alert: '#ff4a3a' };\n  const LAMPS = [[8.5, 6.2], [16, 8.8], [23.5, 6.2], [12.5, 10.5], [19.5, 1.3]].map(([x, y]) => [x * T, y * T]);   // street lamps, clear of the patrols\n  function draw(r) {\n    map.drawFloor(r); map.queueWalls(r);   // (the street runs on past the walls to the screen's edges: map.outside)\n    for (const [x, y] of GRASS) r.prop('grass', x, y, 0, { size: 1.3 });\n    for (const [id, x, y, o] of DRESS) r.shape(id, x, y, 0, o);\n    for (const [x, y] of LAMPS) r.prop('lamp', x, y, 0, { light: true });   // each glows and lights the street (game.lights)\n    if (!ledger) L.add(LEDGER.x, LEDGER.y, LEDGER.z + 6, 40, .8, { color: '#ffd060' }); else L.add(EXIT.x, EXIT.y, 12, 56, .9, { color: '#80e0ff' });\n    // the belfry: a canopy wider than the tower, sorted by its whole footprint (over every tower block)\n    const bx = 25 * T, by = 5 * T, w = 21, H = 20, z = 72;\n    r.queue(bx, by, z, g => { const P2 = (x, y, zz) => r.w(x, y, zz), c = [P2(bx - w, by - w, z), P2(bx + w, by - w, z), P2(bx + w, by + w, z), P2(bx - w, by + w, z)], tip = P2(bx, by, z + H);\n      for (let i = 0; i < 4; i++) px.poly(g, [c[i], c[(i + 1) % 4], tip], ['#7a3a2a', '#9a4a32', '#6a2a22', '#8a4232'][i]);\n      px.line(g, tip[0], tip[1], tip[0], tip[1] - 6, '#e8c860'); }, { footprint: [bx - w, by - w, bx + w, by + w] });\n    for (const g of guards) if (!g.dead) r.sightCone(g, { map, range: 110, fov: 1.5, color: MOOD[g.mind.state], alpha: g.mind.state === 'calm' ? .22 : .38 });\n    if (!ledger) r.sprite(LEDGER.x, LEDGER.y, LEDGER.z + 4 + Math.sin(game.time * 3) * 1.5, BOOK, { glow: .6 });\n    const shadow = b => r.shadow(b.x, b.y, 6, .35, undefined, map.groundAt(b.x, b.y, b.r, b.z));\n    shadow(hero); r.actor(hero.x, hero.y, hero.z, (g, ox, oy) => rig.draw(g, ox, oy, r.view), { xray: { actors: true }, flash: hurtT > 0, alpha: hero.exposure === 0 ? .55 : 1 });\n    for (const g of guards) { shadow(g); r.actor(g.x, g.y, g.z, (gg, ox, oy) => g.rig.draw(gg, ox, oy, r.view), { flash: g.stun > 0 && Math.floor(game.time * 10) % 2 === 0 }); }\n    r.marker(ledger ? EXIT.x : LEDGER.x, ledger ? EXIT.y : LEDGER.y, ledger ? 0 : LEDGER.z, { label: ledger ? 'EAST GATE' : 'LEDGER', color: ledger ? '#80e0ff' : '#ffd040' });\n    r.overlay(g => {\n      for (const gd of guards) if (!gd.dead && gd.mind.state !== 'calm') {   // ? and ! over their heads, with the meter\n        const [sx, sy] = r.w(gd.x, gd.y, gd.z + 46), a = gd.mind.state === 'alert';\n        E.font.text(g, a ? '!' : '?', Math.round(sx), Math.round(sy) - 8, MOOD[gd.mind.state], { align: 'center', shadow: '#000' });\n        E.ui.bar(g, Math.round(sx) - 6, Math.round(sy) + 2, 12, 2, Math.min(1, gd.mind.level), MOOD[gd.mind.state]);\n      }\n    });\n  }\n  return { view: 'iso', views: ['iso', 'threequarter'], input: 'THIRDPERSON', res: 'ps1', pausable: true, touch: ['jump', 'attack', 'block', 'crouch'],\n    camera: { zoom: [.75, 2], rotate: true }, enter: start, update, draw,\n    state: () => ({ hero, guards, map, ledger, won, hp }),   // for tests\n    /** the proof: over the rooftops, jumping, swinging and crouching, the guards on their rounds; a hash of the run */\n    run: (n = 600) => proof('stealth', n, (i, k) => { walk(i, k, ['right', 'down', 'left', 'up'], 100); if (i % 130 === 60) k.tap('jump'); if (i % 90 === 45) k.tap('attack'); if (i === 400) k.tap('crouch'); },\n      () => [hero.x, hero.y, hero.z, hp, ledger, won, guards.map(g => [g.x, g.y, g.z, g.hp, g.dead])]),\n    exit() { game.cam.offset = null; L.enabled = false; if (ui) ui.hud({}); } };\n})();\nscenes.stealth = STEALTH;\n\n/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n// a genre kit file holds one slice: the menu lists only the slices in this file\nfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\ntitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\nconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\ngame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\nwindow.__game = { game, scenes, titleMenu };   // for tests\n})();\n/* =============================== GAME END =============================== */\n","numLines":418,"startLine":1,"totalLines":418}},"tool_result_meta":[{"id":"toolu_0198cW9Ebs7UrwzvjqYS9oLu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
