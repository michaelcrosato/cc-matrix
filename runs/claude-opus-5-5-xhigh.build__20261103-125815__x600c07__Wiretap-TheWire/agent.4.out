s.o.mustPick) return; UI.close(s); } });","-    if (this.tabs[this.tab] === 'Map') this.drawMap();","     return s;","   },","   items() {"]},{"oldStart":32,"oldLines":6,"newStart":31,"newLines":7,"lines":["       body = `<ul style=\"list-style:none;padding:0\">${obs.slice(0, 7).map(o => `<li style=\"margin:.35em 0\"><span class=\"chk\">${o.ok ? '✓' : ''}</span>${esc(o.text)}${o.optional ? ' <span class=\"muted\">(optional)</span>' : ''}</li>`).join('') || '<li>Nothing pressing. Check the Board.</li>'}</ul>","         <p class=\"muted\">Episode ${STATE.ep}: ${esc(EPISODES[STATE.ep - 1].title)}. ${esc(this.hint())}</p>`;","     } else if (T0 === 'Map') {","+      this.drawMap();","       body = `<div style=\"display:flex;gap:1em;flex-wrap:wrap;align-items:flex-start\"><canvas id=\"nbmap\" width=\"576\" height=\"448\" style=\"width:min(52vw,72vh);image-rendering:pixelated;border:2px solid #3a2a14;background:#222\"></canvas>","         <div style=\"flex:1;min-width:12em\">${this.pickPlace ? '<p><b>Pick the place.</b></p>' : ''}<div class=\"choices\">${MAP_PLACES.filter(p => this.pickPlace || ['gas', 'v1412', 'mamab', 'court', 'market', 'church'].includes(p[0])).slice(0, this.pickPlace ? 8 : 6).map(p => `<button class=\"btn\" data-f=\"place:${p[0]}\">${esc(p[1])}</button>`).join('')}</div>","         <p class=\"muted\">◆ objective · ● payphones · ▲ you</p></div></div>`;"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-125815__x600c07/work/Wiretap-TheWire-claude-opus-5-5-xhigh-20261103-125815/src/98-devtemp.js","hunks":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":[" /* TEMPORARY dev stand-ins: removed one by one as the real modules land. */"," const ANNEX_STORY = {}, ANNEX_SPOTS = {}, ANNEX_RUN = {}, CAR_TOPICS = {};","-const Notebook = { open() {} }, TeeShift = { tick() {} }, Attract = { start() {}, exit() {} }, Board = { pinned: () => 0, eligible: () => 0 }, Cipher = { solvedCount: () => 0 };","+const TeeShift = { 