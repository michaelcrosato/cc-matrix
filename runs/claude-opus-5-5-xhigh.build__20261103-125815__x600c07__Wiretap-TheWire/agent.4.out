ent ${fmtUsd(s.spent)}`,","+    L.timeout ? `${L.timeout} min limit` : null, L.rerunFailed ? 'Retry failed' : null, L.resumeFailed ? 'Resume failed' : null, L.paused ? 'paused' : null].filter(Boolean).join(' · ');","+  return h('div', { class: 'card', key: 'saved' },","+    h('h2', {}, 'Pick up where you left off'),","+    h('p', { class: 'sub' }, `The batch started ${new Date(s.startedAt).toLocaleString()} was cut off ${when}, at ${new Date(s.savedAt).toLocaleTimeString()}.`),","+    h('div', { class: 'stats' },","+      h('div', { class: 'stat' }, h('span', { class: 'label' }, 'Finished'), h('span', { class: 'big' }, finished.toLocaleString())),","+      h('div', { class: 'stat' }, h('span', { class: 'label' }, 'Still to run'), h('span', { class: 'big' }, p ? p.left.toLocaleString() : '…')),","+      h('div', { class: 'stat', title: 'Claude Code sessions that had got going: they carry on where they were cut off, work and all' },","+        h('span', { class: 'label' }, 'Of those, carry on'), h('span', {}, plural(on.length, 'session'))),","+      cut.length > on.length ? h('div', { class: 'stat', title: 'Cut off before their session got going, or on a CLI that can\\'t carry one on' },","+        h('span', { class: 'label' }, 'Start over'), h('span', {}, plural(cut.length - on.length, 'run'))) : null,","+      h('div', { class: 'launch' },","+        h('button', { class: 'btn', onclick: forgetSaved, title: 'Don\\'t pick this batch up. Its cut-off runs still carry on (or start over) whenever a batch has them.' }, 'Forget it'),","+        h('button', { class: 'btn primary', onclick: resumeSaved, disabled: !!status.updating }, '▶ Resume the batch'))),","+    cut.length ? h('div', { class: 'chips', style: 'margin-top:12px' }, cut.map((c) => h('span', { class: 'tag', key: c.dir, style: 'white-space:normal; overflow-wrap:anywhere',","+      title: c.carriesOn ? 'Carries on with its Claude Code session where it was cut off' : `Starts over: ${c.provider === 'claude' ? 'its 