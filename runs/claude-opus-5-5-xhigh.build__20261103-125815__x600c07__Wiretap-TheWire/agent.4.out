 + Math.sin(ang) * d); Object.assign(P, { watching: false, aimAt: null, blending: false, still: 0, cover: null }, opts); P.locked = true; let t = 0; while (t < 30) { game.advance(.25); t += .25; P.place(who.x + Math.cos(ang) * d, who.y + Math.sin(ang) * d); who.facing = ang; Object.assign(P, opts); if (who.minds[P.id] && who.minds[P.id].state === 'alert') return t; } return 99; };","-    const stare = look(pg, 60, { watching: true, aimAt: pg }); check('staring at a crew member from 60 makes you within 6 s (' + stare + ' s)', stare <= 6, stare);","-    const blend = look(pg, 100, { blending: true, still: 0 }); check('blending at 100 for 30 s never makes you', blend === 99, blend);","-    pg.locked = false; P.locked = false;","+    T.jump('e1.photos'); game.advance(2); const W2 = ctx.__wiretap, M = W2.Mission.M, P = M.P, o = M.sim.crew.find(a => a.crewId === 'dink'), C = W2.Cam;","+    const test = (d, opts, cam) => { for (const x of M.observers) x.minds = {}; P.burnedUntil = 0; o.locked = true; C.forceOn = !!cam; C.target = cam ? o : null; let t = 0;","+      while (t < 30) { P.place(o.x, o.y - d); P.locked = true; o.facing = -Math.PI / 2; o.faceGoal = null; Object.assign(P, opts); game.advance(.25); t += .25; if (o.minds[P.id] && o.minds[P.id].state === 'alert') break; }","+      const lv = o.minds[P.id] ? o.minds[P.id].level : 0; C.forceOn = false; return [t, lv]; };","+    const [stare] = test(60, {}, true); check('staring through the camera from 60 makes you in about 4 s (' + stare + ' s)', stare >= 2 && stare <= 6, stare);","+    const [walk, wl] = test(60, { still: 0 }, false); check('in plain view at 60, not loitering, you are never made (level ' + wl.toFixed(2) + ')', walk >= 30, walk);","+    const [blend, bl] = test(100, { blending: true, still: 5 }, false); check('blending at 100 for 30 s never makes you (level ' + bl.toFixed(2) + ')', blend >= 30, blend);","+    const [loiter] = test(100, { still: 5 }, false); check('standing uncovered at 100: made within