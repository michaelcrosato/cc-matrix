held = new Set(); this.tapped = new Set(); this.kb = true;\\n    this.kd = e => { if (e.repeat) return; this.held.add(e.code); this.tapped.add(e.code); }; this.ku = e => { this.held.delete(e.code); };\\n    window.addEventListener('keydown', this.kd); window.addEventListener('keyup', this.ku); }\\n  dispose() { window.removeEventListener('keydown', this.kd); window.removeEventListener('keyup', this.ku); }\\n  has(a, set) { return (this.map[a] || []).some(c => set.has(c)); }\\n  move() { const x = (this.has('right', this.held) ? 1 : 0) - (this.has('left', this.held) ? 1 : 0), y = (this.has('down', this.held) ? 1 : 0) - (this.has('up', this.held) ? 1 : 0), m = Math.hypot(x, y) || 1; return [x / m, y / m]; }\\n  down(a) { return this.has(a, this.held); }\\n  pressed(a) { const hit = (this.map[a] || []).filter(c => this.tapped.has(c)); hit.forEach(c => this.tapped.delete(c)); return hit.length > 0; }\\n  released() { return false; }\\n}\\nconst P1_KEYS = { up: ['KeyW'], down: ['KeyS'], left: ['KeyA'], right: ['KeyD'], watch: ['KeyQ'], photo: ['KeyE'], blend: ['KeyF'], sprint: ['ShiftLeft'], crouch: ['KeyC'] };\\nconst P2_KEYS = { up: ['ArrowUp'], down: ['ArrowDown'], left: ['ArrowLeft'], right: ['ArrowRight'], interact: ['Period', 'Enter'], partner: ['Slash'], sprint: ['ShiftRight'] };\\nclass BotController {\\\"\\\"\\\")])\\nsub('src/06-sim.js',[(\\\"  get vx() { return this.body.vx; }\\\",\\\"  get z() { return this.body.z; }\\\\n  get vx() { return this.body.vx; }\\\")])\\nsub('src/08-data.js',[(\\\"  tee1:\\\",\\\"  vs2: { id: 'vs2', mode: 'vs2', kicker: 'THE GAME · 2 PLAYERS', title: 'Detective vs Corner', music: 'versus', civs: 14, leave: 'Leave', briefing: ['P1 is the detective: WASD move, Q hold to watch (aim with the way you face), E photograph, F blend.', 'P2 is the corner (Tee): arrows move, . or Enter serve a buyer, / call out the detective, but only if the corner already suspects them.', 'Detective scores photos. The corner scores sales. Two minutes. Higher