&& w.aim ? (w.aim.x - a.x) * .4 : 0), a.y + (w.on && w.aim ? (w.aim.y - a.y) * .4 : 0), 16); }","-    if (S.over && !this.ended) { this.ended = true; game.after(Globals.attract ? .5 : 2.2, () => { if (Versus.mode === 'net') Net.finish(); else game.go('versusResults', {}); }); }","+    if (S.over && !this.ended) { this.ended = true; if (Versus.mode === 'net') { if (Net.isHost) Net.finish(); } else game.after(Globals.attract ? .5 : 2.2, () => game.go('versusResults', {})); }","     // music layers","     Snd.layer('pressure', S.ev >= 50 ? 1 : 0); Snd.layer('clock', S.len - S.t < 60 ? 1 : 0); Snd.layer('cash', S.netCount >= S.quota * 2 / 3 ? 1 : 0);","   },"]},{"oldStart":263,"oldLines":6,"newStart":265,"newLines":9,"lines":["       E.ui.bar(g, cx - 88, 27, 80, 2, Math.min(1, S.ev / 100), '#7aa7ff'); E.ui.bar(g, cx + 8, 27, 80, 2, Math.min(1, S.netCount / S.quota), '#ffb347');","       if (S.over) { px.rect(g, 0, r.H / 2 - 20, r.W, 40, '#000000'); E.font.text(g, S.over === 'detail' ? 'THE DETAIL MAKES ITS CASE' : S.over === 'corner' ? 'THE CORNER MAKES ITS COUNT' : 'THE GAME GOES ON', cx, r.H / 2 - 6, '#ffffff', { align: 'center', scale: 1, outline: false }); }","       if (Globals.attract) E.font.text(g, 'BOTS', 6, 6, '#9a9080', { outline: false });","+      if (Versus.mode === 'net') { const t = window.AIHub ? AIHub.time() : 0, me = Net.myPlayer();","+        if (S.netWait) { px.rect(g, 0, r.H / 2 - 34, r.W, 68, '#000000'); E.font.text(g, me ? (me.side === 'detail' ? 'YOU ARE A DETECTIVE: BLEND IN, PHOTOGRAPH DEALS' : me.role === 'lt' ? 'YOU RUN THE CORNER: MAKE THE COUNT, CALL OUT COPS' : 'YOU ARE THE RUNNER: STASH TO CUSTOMER') : 'SPECTATING', cx, r.H / 2 - 24, '#ffb347', { align: 'center', outline: false }); E.font.text(g, isFinite(t) ? String(Math.max(1, Math.ceil(-t / 1000))) : 'GET READY', cx, r.H / 2 - 6, '#ffffff', { align: 'center', scale: 2, outline: false }); }","+        if (Net.ended && Net.endMsg) { px.rect(g, 0, r.H - 40, r.W, 22, '#000000'); E.font.text(g, Net.endMsg, cx, r.H - 34, '#ffffff', { align: 'center', outline: false }); } }","     });","   }"," });"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-125815__x600c07/work/Wiretap-TheWire-claude-opus-5-5-xhigh-20261103-125815/src/50-versus.js"]}},"tool_result_meta":[{"id":"toolu_01GEp4Du3HZ95RAALcRRubQF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
