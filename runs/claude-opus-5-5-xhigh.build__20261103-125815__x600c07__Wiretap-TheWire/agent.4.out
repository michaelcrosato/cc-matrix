t.","+async function restartDashboard() {","+  const going = activeNewest(), lose = going.filter((a) => a.agent && a.agent.provider !== 'claude'), k = going.length;","+  const lines = [`The dashboard starts again with its code as it is now (dashboard.mjs, run-matrix.mjs and this page). It's back in a few seconds and this page reloads itself.`];","+  let options = [{ value: 'now', primary: true, label: 'Restart now' }];","+  if (status.running) lines.push(`The batch picks up where it left off once it's back, with the settings it has now${status.state?.paused ? ' (still paused)' : ''}: runs not started yet wait for it.`);","+  if (k) {","+    lines.push(`${k === 1 ? '1 run is' : `${k} runs are`} going now. Restarting now cuts ${k === 1 ? 'it' : 'them'} off: `","+      + (lose.length < k ? `${k - lose.length === 1 ? 'a Claude Code run carries' : `the ${k - lose.length} Claude Code runs carry`} on with ${k - lose.length === 1 ? 'its session' : 'their sessions'} where ${k - lose.length === 1 ? 'it was' : 'they were'} `","+        + '(one that hadn\\'t had its first answer yet starts over)' : '')","+      + (lose.length ? `${lose.length < k ? '; ' : ''}${lose.map((a) => a.id).join(', ')} can't carry on a session, so ${lose.length === 1 ? 'it starts' : 'they start'} over and what ${lose.length === 1 ? 'it has' : 'they have'} done so far is lost` : '') + '.');","+    const wait = { value: 'idle', label: `Restart once ${k === 1 ? 'it has' : 'they have'} finished`, hint: 'No new runs start meanwhile, so nothing is cut off. The batch carries on after the restart.' };","+    const now = { value: 'now', danger: lose.length > 0, label: 'Restart now', hint: lose.length ? `${plural(lose.length, 'run')} start${lose.length === 1 ? 's' : ''} over.` : 'Nothing is lost but the answers they\\'re waiting on.' };","+    options = lose.length ? [{ ...wait, primary: true }, now] : [{ ...now, primary: true }, wait];","+  }","+  const how = await choose('Restart the dashboard', lines, options)