this.signs) if (vis(s.x, s.y)) game.lights.add(s.x, s.y + (s.y > 450 ? -6 : 6), 10, 46, .55, { color: s.color });","+      for (const s of this.signs) if (vis(s.x, s.y)) game.lights.add(s.x, s.y + (s.y > 450 ? -6 : 6), 10, 34, .45, { color: s.color });","       const tv = Math.sin(t * 13) * .3 + .7;","       for (const [x, y] of [[12 * T, 12 * T], [44 * T, 31 * T], [20 * T, 15.9 * T], [62 * T, 12 * T]]) if (vis(x, y)) game.lights.add(x, y, 20, 24, .4 * tv, { color: '#6a8aff' });","     }"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-125815__x600c07/work/Wiretap-TheWire-claude-opus-5-5-xhigh-20261103-125815/src/40-scenes.js","hunks":[{"oldStart":67,"oldLines":7,"newStart":67,"newLines":7,"lines":["     px.line(g, sx, sy - 5, sx - 3, sy + 6, '#0a0808'); px.line(g, sx, sy - 5, sx + 3, sy + 7, '#0a0808'); px.rect(g, sx - 6, sy + 6, 5, 3, '#e8e6e0'); px.rect(g, sx + 2, sy + 7, 5, 3, '#e8e6e0'); px.rect(g, sx - 6, sy + 8, 5, 1, '#c82a2a');","     E.font.title(g, 'WIRETAP', cx, y, { align: 'center', scale, colors: ['#fff6dc', '#ffcf7a', '#e08a2a'], depth: 3, depthColor: '#3a1a0a' });","     E.font.text(g, \"Somebody's always listening.\", cx, y + scale * 9 + 6, '#e8dcc0', { align: 'center', shadow: '#000', outline: false });","-    E.font.text(g, E.versionLabel ? 'WIRETAP 1.0 · ' + E.versionLabel() : 'WIRETAP 1.0', r.W - 4, r.H - 9, '#6a6458', { align: 'right', font: 'tiny', outline: false });","+    E.font.text(g, 'WIRETAP 1.0 · ' + (E.versionLabel ? E.versionLabel() : ''), 4, 3, '#8a8478', { font: 'tiny', outline: false });","   });"," }"," scenes.title = withGlobals({"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-125815__x600c07/work/Wiretap-TheWire-claude-opus-5-5-xhigh-20261103-125815/src/ui.css","hunks":[{"oldStart":38,"oldLines":7,"newStart":38,"newLines":7,"lines":[" .menu .mi{background:#14110ecc;border:2px solid #3a342c;border-left:6px solid #3a342c;border-radius:4px;text-align:left