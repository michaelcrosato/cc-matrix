team.colors.primary === '#0b0b0e' || team.colors.primary === '#141418' ? '#d8d8e0' : team.colors.primary, team.colors.secondary] });\n      T(g, team.craft + ' · ' + team.city, r.W - 160, 68, '#b8c4dc', { font: 'tiny' });\n      const st = team.stats; [['SPEED', st.speed], ['THRUST', st.thrust], ['HANDLING', st.handling], ['SHIELD', st.shield]].forEach(([n, v2], k) => { T(g, n, r.W - 160, 80 + k * 12, '#e8ecff'); for (let q = 0; q < 10; q++) px.rect(g, r.W - 104 + q * 9, 80 + k * 12, 7, 7, q < v2 ? team.colors.glow : '#1a1a2a'); });\n      E.font.text(g, team.copy, r.W - 160, 132, '#c8d4ec', { wrap: 146, outline: false, shadow: '#000' });\"\"\"\nnew2=\"\"\"      const px0 = r.W - 172, py0 = r.H - 132;\n      UI.panel(g, px0, py0, 164, 104, '#0a0c18', .84, team.colors.secondary);\n      E.font.title(g, team.short, px0 + 8, py0 + 6, { scale: 2, colors: [team.colors.primary === '#0b0b0e' || team.colors.primary === '#141418' ? '#d8d8e0' : team.colors.primary, team.colors.secondary] });\n      T(g, team.craft + ' · ' + team.city, px0 + 8, py0 + 24, '#b8c4dc', { font: 'tiny' });\n      const st = team.stats; [['SPEED', st.speed], ['THRUST', st.thrust], ['HANDLING', st.handling], ['SHIELD', st.shield]].forEach(([n, v2], k) => { T(g, n, px0 + 8, py0 + 34 + k * 11, '#e8ecff'); for (let q = 0; q < 10; q++) px.rect(g, px0 + 64 + q * 9, py0 + 34 + k * 11, 7, 7, q < v2 ? team.colors.glow : '#1a1a2a'); });\n      E.font.text(g, team.copy, px0 + 8, py0 + 80, '#c8d4ec', { wrap: 150, outline: false, shadow: '#000', font: 'tiny' });\n      T(g, 'DRAG OR R-STICK TO TURN', r.W - 90, 44, '#5a6a8a', { font: 'tiny', align: 'center' });\"\"\"\nassert old2 in s; s=s.replace(old2,new2)\nopen(p,'w').write(s)\n# brighter turntable: a light above it, a stronger ambient in the hangar\np='src/60-render.js'; s=open(p).read()\ns=s.replace(\"hg.lights = [world.light({ color: '#29c8e8', reach: 400, power: 18 }), world.light({ color: '#ff3ab4', reach: 400, power: 14 }), world.light({ color: '#ffd8a0',