\",\"\"\"    if (!H.readyCalled) { H.readyCalled = true; AIHub.ready(); }\n  },\n  update(dt) {\n    if (this.off || !race) return;\"\"\")\nopen(p,'w').write(s); print('ok')\nEOF\ngrep -n \"readyCalled\" src/95-main.js | head; node tools/bundle.mjs >/dev/null && cp ../SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630.html tests/out/hub/ && TMPDIR=$PWD/.tmp timeout 900 node .tmp/hub4.mjs 2>&1 | grep -E \"run|ready\" | head -14; timeout 300 node tests/run.mjs hub 2>&1 | tail -2","description":"Join hub sessions in one promise-chained step, recheck harness and mock","timeout":1220000}},"wire_ingest_context":{"toolu_015YL9tXAfgpFHEG9Y7ik8Q7":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630"}}}
