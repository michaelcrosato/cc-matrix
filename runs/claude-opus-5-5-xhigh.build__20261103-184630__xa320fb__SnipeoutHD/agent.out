st T = (s, x, y, c, o = {}) => E.font.text(g, s, x, y, c, Object.assign({ outline: '#05040c' }, o)), R = this.R;\n      UI.panel(g, r.W / 2 - 34, 4, 68, 14, '#ff3ab4', .9, '#ffffff'); T('REPLAY', r.W / 2, 7, '#05040c', { align: 'center', outline: false });\n      T(SN.fmtTime(R.t) + '  ' + (this.follow ? this.follow.name : ''), 8, 8, '#ffffff', { scale: 1 });\n      this._chips = []; const chip = (label, on, fn, x) => { const w = E.font.width(label) + 10; UI.panel(g, x, 22, w, 13, on ? '#163a5a' : '#0c1020', .9, on ? '#ffffff' : '#29c8e8'); T(label, x + 5, 25, '#ffffff', { outline: false }); this._chips.push([x, 22, w, 13, fn].reduce((a, v, k) => (a[k] = v, a), [])); this._chips[this._chips.length - 1].fn = fn; return x + w + 4; };\n      let x = 8; for (const sp of [1, 2, 4]) x = chip('×' + sp, this.speed === sp, () => { this.speed = sp; }, x);\n      x = chip(this.paused ? 'PLAY' : 'PAUSE', this.paused, () => { this.paused = !this.paused; }, x + 6);\n      chip('CAM: ' + this.camMode.toUpperCase(), false, () => { const M = ['tv', 'chase', 'cockpit', 'heli']; this.camMode = M[(M.indexOf(this.camMode) + 1) % 4]; }, x + 6);\n      if (this.done) T(this.desync ? 'REPLAY DESYNC' : 'END OF REPLAY', r.W / 2, r.H / 2, this.desync ? '#ff6b6b' : '#ffd36a', { scale: 2, align: 'center' });\n      T('CLICK A CRAFT TO FOLLOW IT', 8, r.H - 34, '#7a8aa8', { font: 'tiny' });\n      SN.glyph.bar(g, [['confirm', this.paused ? 'PLAY' : 'PAUSE'], ['tabL', ''], ['tabR', 'SPEED'], ['camera', 'CAMERA'], ['cancel', 'EXIT']], r.W - 8, r.H - 18, { right: true });\n    });\n  }\n};\nconst attractScene = {\n  enter() { SN.attract.start(0); SN.hud.reset(); game.input.consumeAll(); this.t = 0; },\n  exit() { SN.audio.silenceHums(); },\n  update(dt) {\n    this.t += dt; const I = game.input;\n    if (this.t > .3 && SN.attract.anyInput(I)) { I.consumeAll(); SN.attract.idleT = 0; game.go('title', {}, { fade: 0 }); return; }\n    SN.attract.step(dt);\n  },\n  draw(r) { SN.attract.draw(r); }\n};\nconst sessionScene = {\n  enter() {\n    const H = SN.hub; SN.hud.reset();\n    tw = R3.trackWorld(H.event.track); race = H.makeRace(tw); R3.attach(tw, race); cfg = { mode: 'hub' };\n    ctls = [new SN.Controls(game.input, 0)]; cams = [new SN.ChaseCam()]; tv = new SN.TVDirector(tw.T, tw.terrain);\n    SN.audio.music(SN.TRACKS[H.event.track].song, { layers: ['pad', 'pad2', 'bass', 'sub'] });\n    if (!H.readyCalled) { H.readyCalled = true; AIHub.ready(); }\n  },\n  update(dt) {\n    const H = SN.hub, I = game.input, W = tw.world;\n    if (H.ended) { if (W) W.step(0); return; }\n    if (!H.started) {\n      H.cardInput(I, game.r);\n      const g0 = race.track.grid[0], fr = race.track.frameAt(g0.s), eye = race.track.point(g0.s + 40 * U, 10 * U * Math.sin(game.real * .2), 9 * U), look = race.track.point(race.track.grid[7].s, 0, 2 * U);\n      if (W) { W.camera.fixed = SN.poseFrom(eye, look, SN.ZUP, 55); W.step(dt); }\n      return;\n    }\n    const c = ctls[0].read(dt); race.setControls(0, c); if (c.camera) cycleCam(0);\n    race.step(dt); H.step(race, dt);\n    if (W) SN.fx.events(race, W); SN.audio.events(race, { radio: false }); SN.hud.events(race); SN.hud.step(dt);\n    const s = race.player; let pose = s.finished ? tv.update(race, dt, { target: s }) : cams[0].update(s, dt, race, { lookBack: ctls[0].out.lookBack });\n    if (W) { W.camera.fixed = pose; W.camera.target = { x: s.P[0], y: s.P[1], z: s.P[2] }; W.step(dt); }\n    SN.audio.humStep(race, s, W, dt, true);\n  },\n  draw(r) {\n    const H = SN.hub;\n    if (tw.world) tw.world.draw(r);\n    if (!H.started) { r.overlay(g => H.drawCard(g, r)); return; }\n    SN.hud.draw(r, race, race.player, null);\n    if (H.ended) r.overlay(g => {\n      UI.panel(g, r.W / 2 - 110, r.H / 2 - 50, 220, 100, '#05040c', .9, '#29c8e8');\n      E.font.title(g, 'ROUND OVER', r.W / 2, r.H / 2 - 42, { scale: 3, colors: ['#ffffff', '#7af0ff'], align: 'center' });\n      const st = (H.endInfo && H.endInfo.standings) || [], names = id => { const p = (H.info.players || []).find(q => q.id === id); return p ? p.name : '?'; };\n      st.slice(0, 4).forEach((grp, k) => E.font.text(g, (k + 1) + '. ' + [].concat(grp).map(names).join(', '), r.W / 2, r.H / 2 - 8 + k * 11, '#ffffff', { align: 'center', outline: '#05040c' }));\n    });\n  }\n};\n\n/* ---- the debug handle (tests, tools/check.mjs) ---- */\ngame.debug = {\n  snapshot() {\n    const R = game.sceneName === 'attract' ? SN.attract.race : game.sceneName === 'title' ? titleRace : game.sceneName === 'replay' ? replayScene.R : race;\n    const sh = s => ({ id: s.id, name: s.name, p: Math.round(s.p), s: Math.round(s.s), u: Math.round(s.u), h: Math.round(s.h), v: Math.round(s.speed), kmh: Math.round(s.kmh), energy: Math.round(s.energy * 10) / 10, lap: s.lap, place: s.place, weapon: s.weapon, airborne: !s.grounded, finished: s.finished, elim: s.elim, points: s.points, control: s.control });\n    return { scene: game.sceneName, screen: UI.top() ? UI.top().id : null, focus: UI.top() ? UI.top().focus : null, state: R && R.state, mode: R && R.mode, track: R && R.track.id, cls: R && R.cls, t: R ? +R.t.toFixed(3) : 0,\n      ships: R ? R.ships.map(sh) : [], player: R && R.player ? sh(R.player) : null, hudCallouts: (SN.hud.views[0] || { callouts: [] }).callouts.map(c => c.text), device: game.input.lastDevice, attract: game.sceneName === 'attract', dev: SN.dev.isOpen,\n      story: SN.story.active, season: { medals: SN.save.data.medals, unlocked: SN.save.data.unlocked, gp: SN.save.data.gp }, hub: { active: SN.hub.active, connected: !!SN.hub.info, sent: SN.hub.sent, progressCount: SN.hub.progressCount, started: SN.hub.started, ended: SN.hub.ended },\n      zone: R && R.zone, backend: E.World3D ? E.World3D.backend : 'none', paused: game.paused, splits: game._split ? game._split.vps.length : 1 };\n  },\n  teleport(s, u = 0, v = 0) { if (race) SN.debugTeleport(race, s, u, v); },\n  give(w) { if (race && race.player) race.weapons.give(race.player, w); },\n  setEnergy(x) { if (race && race.player) race.player.energy = x; },\n  finishNow() { if (race) race.endRun(); },\n  events: () => race ? race.events.slice() : [],\n  race: () => race, track: () => race && race.track, tune: SN.Tune, cfg: () => cfg, cams: () => cams, ctls: () => ctls, tw: () => tw\n};\n\ngame.start({ scenes: { title: titleScene, front: frontScene, loading: loadingScene, race: raceScene, results: resultsScene, replay: replayScene, attract: attractScene, session: sessionScene },\n  scene: HUBON ? 'session' : 'title', boot });\nif (HUBON) { const g0 = game.go.bind(game); game.booted && game.booted.then && game.booted.then(() => { if (!SN.hub.info && game.sceneName === 'session') g0('title'); }); }\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YJToqyJbeLTc417uBSmAyZ","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/src/95-main.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"4110026b-2798-4dbf-ae8a-e81d8e816e30","uuid":"017a47b5-0a7c-4c81-8a6c-a7834dc7ed73","timestamp":"2026-11-04T02:46:54.566Z","tool_use_result":{"type":"update","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/src/95-main.js","content":"// SNIPEOUT HD: the game. new E.Game with the game's settings and pause items, the boot (the 3D engine, the circuits, the\n// hangar, the sound), the scenes (title, the front end, loading, race, results, replay, attract, the AI Hub session),\n// the flow between them, and game.debug for the tests.\n(() => {\nconst E = My3D2dge, SN = globalThis.SN, V = SN.v, U = 16, UI = SN.UI, R3 = SN.render;\nconst HUBON = SN.hub.active;\nconst SETTINGS = [\n  { key: 'difficulty', label: 'Difficulty', group: 'Game', options: [['Easy', 'Easy'], ['Normal', 'Normal'], ['Hard', 'Hard']], value: 'Normal', help: 'How fast and how aggressive the AI pilots are, and how much they catch up' },\n  { key: 'units', label: 'Speed units', group: 'Game', options: [['kmh', 'km/h'], ['mph', 'mph']], value: 'kmh' },\n  { key: 'defaultCam', label: 'Default camera', group: 'Game', options: [['chase', 'Chase'], ['far', 'Far chase'], ['cockpit', 'Cockpit']], value: 'chase' },\n  { key: 'hudSize', label: 'HUD size', group: 'Display', options: [['normal', 'Normal'], ['large', 'Large']], value: 'normal' },\n  { key: 'subtitles', label: 'Subtitles', group: 'Game', value: true, help: 'The announcer and the race radio as text' },\n  { key: 'announcer', label: 'Announcer voice', group: 'Game', value: true },\n  { key: 'speedLines', label: 'Speed lines', group: 'Display', value: true },\n  { key: 'bloom', label: 'Neon glow', group: 'Display', value: true, apply: (g, v) => { for (const w of [R3.tw && R3.tw.world, R3.hangar && R3.hangar.world]) if (w) w.filter.bloom = !!v; } },\n  { key: 'picture3d', label: 'Picture', group: 'Display', options: [['pixels', 'Pixels'], ['balanced', 'Balanced'], ['full', 'HD']], value: 'pixels', help: 'Pixels: the native chunky look. HD: the screen\\'s full resolution' },\n  { key: 'shadows3d', label: 'Shadows', group: 'Display', value: true },\n  { key: 'filter3d', label: 'Filter', group: 'Display', options: [['clean', 'None'], ['cel', 'Comic cel'], ['pixel', 'Pixel']], value: 'clean' }\n];\nlet race = null, cfg = null, tw = null, cams = [], ctls = [], tv = null, ghostRec = null, ghostData = null, ghostShip = null, resultsT = 0, toastT = 0, devFromPause = false, freeCam = null;\nconst pauseItems = () => {\n  if (HUBON || !race || game.sceneName !== 'race') return [];\n  return [\n    ['Restart', () => { game.shell && game.shell.hide(); SN.flow.start(Object.assign({}, cfg)); }],\n    ['Camera: ' + camLabel(cams[0] && cams[0].mode), () => { cycleCam(0); game.shell && game.shell.show('pause'); }],\n    ['How to play', () => game.shell && game.shell.show('help', helpSpec())],\n    ['Dev mode', () => { game.shell && game.shell.hide(); openDev(); }],\n    race.rules.endRun ? ['End run', () => { game.shell && game.shell.hide(); race.endRun(); }] : null\n  ];\n};\nconst game = SN.game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, bg: null, input: SN.INPUT, id: 'snipeout-hd', autoPause: !HUBON,\n  menu: { items: pauseItems, settings: SETTINGS, controls: SN.CONTROL_NAMES, quit: HUBON ? false : 'title' } });\ngame.input.touchEnabled = false;\nconst camLabel = m => ({ chase: 'Chase', far: 'Far chase', cockpit: 'Cockpit' }[m] || 'Chase');\nconst cycleCam = i => { const c = cams[i]; if (!c) return; c.mode = c.mode === 'chase' ? 'far' : c.mode === 'far' ? 'cockpit' : 'chase'; c.reset(); };\nconst helpSpec = () => {\n  const I = game.input, L = a => I.label(a) || '-';\n  return { title: 'How to play', keys: [[L('thrust'), 'Thrust (hold)'], [L('left') + ' ' + L('right'), 'Steer'], [L('brakeL') + ' ' + L('brakeR'), 'Airbrakes: tighter turns, both to brake'], [L('shiftL') + ' ' + L('shiftR'), 'Side-shift; a barrel roll in the air'], [L('fire'), 'Fire (hold for cannon / railshot)'], [L('absorb'), 'Absorb the weapon into shield'], [L('camera'), 'Camera'], [L('lookBack'), 'Look back']],\n    sections: [['Energy', 'Walls, weapons and rolls cost shield. The green pit strip recharges it. At zero you are eliminated.'], ['Pads', 'Blue chevrons boost. Amber pads give a weapon.'], ['Launch', 'Hold thrust as the lights count down: release the revs in the green band for a perfect start.']] };\n};\n\n/* ---- boot ---- */\nconst wait3D = () => new Promise((ok, no) => {\n  if (!SN.browser) return ok();\n  const t0 = performance.now();\n  const tick = () => {\n    if (E.World3D) return E.World3D.init(game).then(() => { SN._w3dInit = true; ok(); }, no);\n    if (window.__sn3dFail || performance.now() - t0 > 30000) return no(new Error('The 3D engine could not load (three.js from cdn.jsdelivr.net). Check the connection and reload.'));\n    setTimeout(tick, 50);\n  };\n  tick();\n});\nconst boot = { title: 'SNIPEOUT HD', version: SN.VERSION, messages: ['Calibrating the anti-gravity field', 'Polishing the neon', 'Briefing ORACLE', 'Negotiating with QWIK-FUEL'], steps: [\n  ['Waking the 3D engine', wait3D],\n  ['Surveying the circuits', () => { for (const id of SN.TRACK_ORDER) SN.getTrack(id); }],\n  ['Tuning the synthesizers', () => SN.audio.define()],\n  ['Opening the saves', () => SN.save.init(game)],\n  ['Building the hangar', () => { if (!HUBON) R3.hangarWorld(); }],\n  ['Building Port Solenne', () => { if (!HUBON) R3.trackWorld('solenne'); }],\n  ['Connecting to the AI Hub', () => HUBON ? SN.hub.begin(game).then(ok => { if (!ok) R3.trackWorld('solenne'); }) : null]\n] };\n\n/* ---- the flow ---- */\nconst F = SN.flow;\nF.toTitle = () => { UI.reset(); game.go('title', {}, { fade: 'wipe', seconds: .25 }); };\nF.toMenu = () => F.toFront(() => UI.reset(SN.screens.main()));\nF.toSeason = () => F.toFront(() => { UI.reset(SN.screens.main()); SN.flow.season(); });\nF.toFront = then => { game.go('front', { then }, { fade: 'wipe', seconds: .25 }); };\n/** start a race from a config: { mode, track, cls, laps, team, pilot, season, gpRound, target, versusMode, players } */\nF.start = c => { cfg = Object.assign({ laps: 3, cls: 'SPARK', track: 'solenne', team: SN.save.data.team || 'kestrel', pilot: SN.save.data.pilot || 'vale' }, c); if (cfg.mode === 'gp' || cfg.mode === 'season') cfg.cls = cfg.cls || 'STORM'; game.go('loading', { cfg }, { fade: 'wipe', seconds: .25 }); };\nF.replay = r => game.go('replay', { race: r }, { fade: 'wipe', seconds: .25 });\n/** a race from a config: the field, the rules */\nF.makeRace = (c, T) => {\n  const mode = c.mode, humans = mode === 'versus' ? (c.players || []).map(p => ({ pilot: p.pilot, team: p.team })) : [{ pilot: c.pilot, team: c.team, champion: c.champion }];\n  let ent, rules = {};\n  if (mode === 'timetrial' || mode === 'hotlap' || mode === 'overclock' || mode === 'academy') {\n    ent = [{ pilot: c.pilot, team: c.team, control: 'human', pi: 0, champion: c.champion }];\n    if (mode === 'academy') ent.unshift({ pilot: 'hex', team: 'nullset', control: 'drone' });\n    if ((mode === 'timetrial' || mode === 'hotlap')) { const gd = SN.save.data.ghosts[T.id + '/' + c.cls + '/' + mode]; if (gd) ent.unshift({ pilot: c.pilot, team: c.team, control: 'ghost', color: '#7af0ff', label: 'GHOST' }); }\n  } else ent = SN.field({ humans, size: 8, seed: (Date.now ? 1 : 0) });\n  if (mode === 'snipeout' && c.target) rules.target = c.target;\n  if (mode === 'gp' || (c.season && mode === 'race')) rules = Object.assign(rules, {});\n  const seed = c.seed || ((typeof performance !== 'undefined' ? Math.floor(performance.now() * 1000) : 1) ^ 0x5eed) >>> 0;\n  const R = new SN.Race({ track: T, mode: mode === 'gp' ? 'gp' : mode, cls: mode === 'overclock' ? 'SPARK' : c.cls, laps: c.laps || 3, seed, entrants: ent, difficulty: game.settings.difficulty || 'Normal', intro: c.intro !== false, rules, versusMode: c.versusMode });\n  R.cfg = c; return R;\n};\n\n/* ---- the hangar: the front end's background ---- */\nconst hangarCam = (dt, o = {}) => {\n  const hg = R3.hangar; if (!hg || !hg.world) return;\n  const t = game.real * .12, tt = hg.turntable, podium = o.podium;\n  let pose;\n  if (podium) { const a = -Math.PI / 2 + Math.sin(game.real * .3) * .5, cx = 14 * U, cy = 10.5 * U, d = 170; pose = SN.poseFrom([cx + Math.cos(a) * d * .2, cy + 150, 60], [cx, cy, 24], SN.ZUP, 48); }\n  else { const d = 150, x = tt.x + Math.cos(t + 1.6) * d, y = tt.y + Math.sin(t + 1.6) * d; pose = SN.poseFrom([x, y, 54], [tt.x, tt.y, 18], SN.ZUP, 52); }\n  hg.world.camera.fixed = pose; hg.world.step(dt);\n};\nR3.podiumPilots = (ids, playerPlace) => {\n  const hg = R3.hangar; if (!hg || !hg.world) return;\n  const w = hg.world; w.reset();\n  const marks = ['p1', 'p2', 'p3'];\n  ids.slice(0, 3).forEach((id, k) => { if (!id) return; const m = w.marks[marks[k]] && w.marks[marks[k]][0]; if (!m) return; const rig = SN.rigFor(id, true); if (!rig) return; const a = w.hero({ x: m.x, y: m.y, rig }); a.facing = Math.PI / 2; a.anim = { pose: k === 0 ? 'cheer' : k === 1 ? 'wave' : 'hips' }; });\n  hg.podiumAt = game.real;\n};\n\n/* ---- scenes ---- */\nlet titleRace = null, titleTV = null, titleTW = null;\nconst titleScene = {\n  enter() {\n    UI.reset(); SN.attract.idleT = 0; SN.hud.reset();\n    titleTW = R3.trackWorld('solenne');\n    titleRace = new SN.Race({ track: titleTW.T, mode: 'race', cls: 'FLARE', laps: 99, seed: 77, entrants: SN.field({ humans: [], seed: 3 }), intro: false, rules: { infiniteEnergy: () => true, rubberBand: false }, record: false });\n    R3.attach(titleTW, titleRace); titleTV = new SN.TVDirector(titleTW.T, titleTW.terrain);\n    for (let k = 0; k < 120 * 5; k++) titleRace.step(1 / 120);\n    SN.audio.music('zero', { layers: 'all' });\n  },\n  update(dt) {\n    const I = game.input;\n    titleRace.step(dt); const pose = titleTV.update(titleRace, dt, { attract: true });\n    if (titleTW.world) { titleTW.world.camera.fixed = pose; titleTW.world.step(dt); }\n    SN.audio.humStep(titleRace, titleTV.target, titleTW.world, dt, false);\n    if (SN.attract.idle(dt, I)) { game.go('attract', {}, { fade: 'wipe', seconds: .3 }); return; }\n    const c = I.clicked(), touch = SN.touchOnly();\n    if (touch) { const b = titleScene._btn; if (c && b && c[0] >= b[0] && c[0] < b[0] + b[2] && c[1] >= b[1] && c[1] < b[1] + b[3]) { I.consumeAll(); game.menu('settings'); } return; }\n    if (I.pressed('start') || I.pressed('confirm') || c) { I.consumeAll(); SN.audio.sfx('ui_ok'); F.toMenu(); }\n  },\n  draw(r) {\n    if (titleTW.world) titleTW.world.draw(r);\n    r.overlay(g => {\n      const T = (s, x, y, c, o = {}) => E.font.text(g, s, x, y, c, Object.assign({ outline: '#05040c' }, o));\n      g.save(); g.globalAlpha = .35; g.fillStyle = '#05040c'; g.fillRect(0, r.H * .2, r.W, 70); g.restore(); g._c = null;\n      SN.drawLogo(g, r.W / 2, r.H * .2 + 10, 1);\n      T('ANTI-GRAVITY. ANTI-EVERYONE.', r.W / 2, r.H * .2 + 52, '#7af0ff', { align: 'center' });\n      if (SN.touchOnly()) {\n        const w = 250, x = r.W / 2 - w / 2, y = r.H * .58; UI.panel(g, x, y, w, 56, '#0a0c18', .92, '#ff3ab4');\n        T('CONTROLLER OR KEYBOARD REQUIRED', r.W / 2, y + 8, '#ffffff', { scale: 1, align: 'center' });\n        const b = titleScene._btn = [r.W / 2 - 50, y + 26, 100, 22]; UI.panel(g, b[0], b[1], b[2], b[3], '#163a5a', .95, '#ffffff'); T('SETTINGS', r.W / 2, b[1] + 4, '#ffffff', { scale: 2, align: 'center' });\n      } else if (Math.floor(game.real * 1.6) % 2) {\n        const I = game.input, dev = SN.glyph.device(I), w = E.font.width('PRESS START', { scale: 2 });\n        T('PRESS START', r.W / 2 + 8, r.H * .66, '#ffffff', { scale: 2, align: 'center' }); SN.glyph.draw(g, dev === 'gamepad' ? 'confirm' : 'start', r.W / 2 - w / 2 - 10, r.H * .66 + 1, { input: I });\n      }\n      T(E.versionLabel ? E.versionLabel() + ' · SNIPEOUT HD ' + SN.VERSION : SN.VERSION, r.W - 6, r.H - 10, '#5a6a8a', { align: 'right', font: 'tiny' });\n      T('© 2161 THE HOVERLINE AUTHORITY. A FICTIONAL LEAGUE.', 6, r.H - 10, '#5a6a8a', { font: 'tiny' });\n    });\n  }\n};\nconst frontScene = {\n  enter(d) {\n    SN.hud.reset(); R3.hangarWorld(); SN.audio.music('zero', { layers: 'all' }); SN.attract.idleT = 0;\n    if (R3.hangar && R3.hangar.world) R3.hangar.world.reset();\n    if (d && d.then) d.then(); else if (!UI.top()) UI.reset(SN.screens.main());\n  },\n  update(dt) {\n    const I = (UI.top() && UI.top().ownerInput) || game.input;\n    const podium = !!(R3.hangar && R3.hangar.world && R3.hangar.world.actors.length);\n    hangarCam(dt, { podium });\n    if (SN.dev.isOpen) { SN.dev.update(dt, game.input); return; }\n    if (SN.story.update(dt, game.input)) return;\n    if (!game.paused && !(game.shell && game.shell.screen) && SN.attract.idle(dt, game.input) && !(UI.top() && (UI.top().id === 'results' || UI.top().id === 'credits'))) { game.go('attract', {}, { fade: 'wipe', seconds: .3 }); return; }\n    if (game.shell && game.shell.screen) return;\n    UI.update(dt, I);\n  },\n  draw(r) {\n    const hg = R3.hangar; if (hg && hg.world) hg.world.draw(r);\n    UI.draw(r); SN.story.draw(r); SN.dev.draw(r);\n  }\n};\nconst loadingScene = {\n  enter(d) { this.cfg = d.cfg; this.t = 0; this.built = false; SN.audio.music(null); },\n  update(dt) {\n    this.t += dt;\n    if (!this.built && this.t > .05) {\n      const c = this.cfg, skin = c.mode === 'overclock' ? 'overclock' : 'normal';\n      tw = R3.trackWorld(c.track, skin);\n      race = F.makeRace(c, tw.T); R3.attach(tw, race);\n      this.built = true;\n    }\n    if (this.built && this.t > .6) game.go('race', { race, cfg: this.cfg }, { fade: 'wipe', seconds: .25 });\n  },\n  draw(r) {\n    const c = this.cfg, D = SN.TRACKS[c.track];\n    r.overlay(g => {\n      g.fillStyle = '#05040c'; g.fillRect(0, 0, r.W, r.H); g._c = null;\n      const T = (s, x, y, col, o = {}) => E.font.text(g, s, x, y, col, Object.assign({ outline: '#05040c' }, o));\n      E.font.title(g, D.name, r.W / 2, r.H / 2 - 40, { scale: 3, colors: ['#ffffff', '#9ff4ff', '#29c8e8'], align: 'center' });\n      T(D.place, r.W / 2, r.H / 2 - 10, '#b8c4dc', { align: 'center' });\n      T(SN.MODES[c.mode].label + ' · ' + (c.mode === 'overclock' ? 'OVERCLOCK SKIN' : c.cls), r.W / 2, r.H / 2 + 2, '#ffd36a', { align: 'center' });\n      E.px.rect(g, r.W / 2 - 80, r.H / 2 + 20, 160, 4, '#1a1a2a'); E.px.rect(g, r.W / 2 - 80, r.H / 2 + 20, Math.round(160 * Math.min(1, this.t / .6)), 4, '#29c8e8');\n      T(SN.STORY.tips[Math.floor((c.track.length + (c.mode || '').length)) % SN.STORY.tips.length], r.W / 2, r.H / 2 + 36, '#e8ecff', { align: 'center', wrap: r.W - 60 });\n    });\n  }\n};\nconst openDev = () => { const sc = game.scene; devFromPause = true; if (sc) sc.pausable = false; SN.dev.open(race, () => { if (game.scene === raceScene) { raceScene.pausable = !HUBON; game.menu(); } }); };\nconst raceScene = {\n  pausable: true,\n  enter(d) {\n    race = d.race; cfg = d.cfg; this.t = 0; resultsT = 0; toastT = 0; SN.hud.reset(); SN.audio.muted = false; freeCam = null;\n    raceScene.pausable = true;\n    const P = game.players;\n    ctls = race.humans.map((s, i) => new SN.Controls(P[i] || game.input, i));\n    cams = race.humans.map(() => { const c = new SN.ChaseCam(); c.mode = game.settings.defaultCam || 'chase'; return c; });\n    tv = new SN.TVDirector(tw.T, tw.terrain);\n    if (race.humans.length > 1) { game.splitScreen(2, { layout: 'rows' }); if (tw.world && tw.world.cameras.length < 2) tw.world.addCamera({ mode: 'fixed', far: 26000, near: 4 }); }\n    // ghosts: time trial and hot lap\n    ghostRec = (race.mode === 'timetrial' || race.mode === 'hotlap') && race.player ? SN.Ghost.recorder(race, race.player) : null; race.ghostRec = ghostRec;\n    ghostShip = race.ships.find(s => s.ghost) || null; ghostData = null;\n    if (ghostShip) { const k = race.track.id + '/' + race.cls + '/' + race.mode, gd = SN.save.data.ghosts[k]; ghostData = gd ? SN.Ghost.decode(gd) : null; ghostShip.hidden = true; }\n    SN.audio.music(race.mode === 'overclock' ? 'overclock' : SN.TRACKS[race.track.id].song, { sync: true, restart: true, layers: ['pad', 'pad2', 'bass', 'sub'] });\n    SN.audio.lastRadio = -99;\n  },\n  exit() { game.splitScreen(0); SN.audio.silenceHums(); game.timeScale = 1; SN.dev.isOpen = false; R3.hideShip = null; },\n  update(dt) {\n    const I = game.input;\n    if (SN.dev.isOpen) { SN.dev.update(dt, I); if (tw.world) tw.world.step(0); return; }\n    this.t += dt; toastT += dt;\n    if (race.state === 'intro' && (I.pressed('confirm') || I.clicked())) { race.skipIntro(); I.consumeAll(); }\n    // controls: each human's own input (a free camera parks the player's on autopilot)\n    race.humans.forEach((s, i) => { const c = ctls[i].read(dt); if (SN.flags.freeCam && i === 0) { race.setControls(i, SN.AI.controls(s, race, { skill: 1, brain: 'free' })); } else race.setControls(i, c); if (c.camera) cycleCam(i); });\n    race.step(dt);\n    if (ghostRec && race.state === 'racing' && !race.player.finished) ghostRec.step(dt);\n    if (ghostShip && ghostData) SN.Ghost.pose(ghostShip, ghostData, race.t, race.track);\n    if (tw.world) SN.fx.events(race, tw.world);\n    SN.audio.events(race); SN.hud.events(race); SN.hud.step(dt);\n    for (const e of race.events) if (e.t === 'go') toastT = 0;\n    // cameras\n    const W = tw.world;\n    race.humans.forEach((s, i) => {\n      let pose;\n      if (race.state === 'intro') pose = SN.introPose(race, race.stateT);\n      else if ((race.state === 'finished' || race.state === 'results') && (s.finished || s.dnf) && race.humans.length === 1) pose = tv.update(race, dt, { target: s.dnf ? null : s });\n      else if (SN.flags.freeCam && i === 0) { freeCam = freeCam || new SN.FreeCam(W ? W.camera.pose || { x: s.P[0], y: s.P[1], z: s.P[2] + 200, yaw: 0, pitch: -.3 } : { x: s.P[0], y: s.P[1], z: s.P[2] + 200, yaw: 0, pitch: -.3 }); pose = freeCam.update(I, dt); }\n      else { const lb = ctls[i].out.lookBack; pose = cams[i].update(s, dt, race, { lookBack: lb, cut: race.state === 'grid' && race.stateT < .02 }); }\n      if (W && W.cameras[i]) W.cameras[i].fixed = pose;\n    });\n    if (!SN.flags.freeCam) freeCam = null;\n    R3.hideShip = cams[0] && cams[0].mode === 'cockpit' && race.state !== 'intro' && !(race.state === 'finished' && race.humans.length === 1) && race.humans.length === 1 ? race.humans[0] : null;\n    if (W) { W.camera.target = race.player ? { x: race.player.P[0], y: race.player.P[1], z: race.player.P[2] } : null; W.step(dt); }\n    SN.audio.humStep(race, race.player, W, dt, true);\n    if (race.state === 'results') { resultsT += dt; if (resultsT > 1.2) { const O = F.outcome(race); game.go('results', { race, O }, { fade: 'wipe', seconds: .3 }); } }\n  },\n  draw(r) {\n    if (tw.world) tw.world.draw(r);\n    const vp = r.viewport, i = vp ? vp.i : 0, s = race.humans[i];\n    if (tw.world) SN.debugDraw(tw.world, race);\n    if (race.state === 'intro' && !vp) r.overlay(g => introCard(g, r));\n    else if (s && race.state !== 'intro') SN.hud.draw(r, race, s, vp);\n    if (!vp) this.hud(r);\n  },\n  hud(r) {\n    if (race.humans.length > 1 && race.state === 'countdown') r.overlay(g => { const n = 3 - Math.floor(race.stateT); if (n >= 1) E.font.title(g, String(n), r.W / 2, r.H / 2 - 20, { scale: 5, colors: ['#ffffff', '#ff6b6b'], align: 'center' }); });\n    if (toastT < 4 && race.state === 'racing' && SN.audio.songId) r.overlay(g => { const s = SN.audio.nowPlaying(SN.audio.songId), w = E.font.width(s) + 12, k = toastT < .3 ? toastT / .3 : toastT > 3.5 ? (4 - toastT) * 2 : 1; UI.panel(g, r.W - w - 6, r.H - 58 - (1 - k) * 10, w, 13, '#05040c', .7 * k, '#ff3ab4'); E.font.text(g, s, r.W - w, r.H - 55 - (1 - k) * 10, '#ffffff', { outline: false }); });\n    if (race.state === 'finished' && race.humans.every(h => h.finished || h.dnf)) r.overlay(g => E.font.text(g, race.player && race.player.dnf ? 'ELIMINATED · SPECTATING' : 'RACE COMPLETE · SPECTATING', r.W / 2, r.H - 66, '#ffd36a', { align: 'center', outline: '#05040c' }));\n    SN.dev.draw(r);\n  }\n};\nfunction introCard(g, r) {\n  const D = SN.TRACKS[race.track.id], T = (s, x, y, c, o = {}) => E.font.text(g, s, x, y, c, Object.assign({ outline: '#05040c' }, o)), k = Math.min(1, race.stateT / .4);\n  UI.panel(g, 0, r.H - 74, r.W * k, 50, '#05040c', .7, '#29c8e8');\n  E.font.title(g, D.name, 12, r.H - 68, { scale: 3, colors: ['#ffffff', '#9ff4ff', '#29c8e8'] });\n  T(D.place + ' · ' + D.lengthKm.toFixed(2) + ' KM · ' + (race.rules.target ? 'FIRST TO ' + race.rules.target : race.rules.endRun ? SN.MODES[race.mode].label : race.laps + ' LAPS') + ' · ' + race.cls, 12, r.H - 42, '#ffd36a');\n  SN.glyph.bar(g, [['confirm', 'SKIP']], r.W - 8, 8, { right: true });\n}\nconst resultsScene = {\n  enter(d) {\n    this.race = d.race; this.O = d.O; this.t = 0; R3.hangarWorld(); SN.audio.silenceHums();\n    const pl = d.race.player, top3 = pl && !d.race.rules.solo && d.O.mine && d.O.mine.place <= 3 && !pl.dnf;\n    this.podium = top3;\n    if (top3) { R3.podiumPilots(d.O.res.slice(0, 3).map(x => x.pilot), d.O.mine.place - 1); SN.audio.sting(d.O.mine.place === 1 ? 'win' : 'podium'); }\n    else if (R3.hangar && R3.hangar.world) R3.hangar.world.reset();\n    if (d.O.medal) SN.audio.sting('medal');\n    if (d.O.unlocks.length) SN.audio.sting('unlock');\n    SN.audio.music('zero', { layers: ['pad', 'pad2', 'arp'] });\n    UI.reset(SN.screens.results(d.race, d.O));\n  },\n  update(dt) {\n    this.t += dt; hangarCam(dt, { podium: this.podium && this.t < 4.5 });\n    if (this.podium && this.t < 4.5) { if (Math.random() < .5 && R3.hangar && R3.hangar.world) game.particles.bits(14 * U + (Math.random() - .5) * 120, 10.5 * U + (Math.random() - .5) * 40, 90, 2, ['#ffd23f', '#ff3ab4', '#7af0ff', '#ffffff']); if (game.input.pressed('confirm') || game.input.clicked()) { this.t = 4.5; game.input.consumeAll(); } return; }\n    if (SN.dev.isOpen) { SN.dev.update(dt, game.input); return; }\n    if (SN.story.update(dt, game.input)) return;\n    UI.update(dt, game.input);\n  },\n  draw(r) {\n    const hg = R3.hangar; if (hg && hg.world) hg.world.draw(r);\n    if (this.podium && this.t < 4.5) { r.overlay(g => { E.font.title(g, 'PODIUM', r.W / 2, 14, { scale: 3, colors: ['#ffffff', '#ffd23f'], align: 'center' }); const names = this.O.res.slice(0, 3); names.forEach((x, k) => E.font.text(g, (k + 1) + '. ' + x.name, r.W / 2, r.H - 52 + k * 11, k === 0 ? '#ffd23f' : '#ffffff', { align: 'center', outline: '#05040c' })); SN.glyph.bar(g, [['confirm', 'SKIP']], r.W - 8, 8, { right: true }); }); return; }\n    UI.draw(r); SN.story.draw(r); SN.dev.draw(r);\n  }\n};\nconst replayScene = {\n  enter(d) {\n    this.src = d.race; this.R = SN.Replay.play(d.race.recording); this.speed = 1; this.paused = false; this.camMode = 'tv'; this.follow = this.R.player || this.R.ships[0]; this.done = false; this.desync = false;\n    tw = R3.trackWorld(d.race.track.id, d.race.mode === 'overclock' ? 'overclock' : 'normal'); R3.attach(tw, this.R);\n    this.tv = new SN.TVDirector(tw.T, tw.terrain); this.cam = new SN.ChaseCam(); SN.hud.reset();\n    SN.audio.music(d.race.mode === 'overclock' ? 'overclock' : SN.TRACKS[d.race.track.id].song, { layers: 'all' });\n  },\n  exit() { SN.audio.silenceHums(); },\n  update(dt) {\n    const I = game.input, R = this.R;\n    if (I.pressed('cancel')) { I.consumeAll(); game.go('results', { race: this.src, O: F.outcome(this.src) }, { fade: 'wipe', seconds: .25 }); return; }\n    if (I.pressed('confirm')) this.paused = !this.paused;\n    if (I.pressed('tabR')) this.speed = this.speed === 1 ? 2 : this.speed === 2 ? 4 : 4;\n    if (I.pressed('tabL')) this.speed = this.speed === 4 ? 2 : 1;\n    if (I.pressed('camera') || I.pressed('more')) { const M = ['tv', 'chase', 'cockpit', 'heli']; this.camMode = M[(M.indexOf(this.camMode) + 1) % 4]; this.cam.reset(); }\n    const c = I.clicked();\n    if (c) {\n      const L = this._chips || []; const ch = L.find(q => c[0] >= q[0] && c[0] < q[0] + q[2] && c[1] >= q[1] && c[1] < q[1] + q[3]);\n      if (ch) ch.fn(); else if (tw.world) { let best = null, bd = 18; for (const s of R.ships) { if (s.hidden || s.drone) continue; const q = tw.world.project(s.P[0], s.P[1], s.P[2] + 8); if (q) { const d2 = Math.hypot(q[0] - c[0], q[1] - c[1]); if (d2 < bd) { bd = d2; best = s; } } } if (best) { this.follow = best; this.camMode = this.camMode === 'tv' ? 'chase' : this.camMode; } }\n      I.consumeAll();\n    }\n    if (!this.paused && !this.done) for (let k = 0; k < this.speed; k++) { R.replay.run(dt); if (R.replay.done) { this.done = true; this.desync = !R.replay.ok; break; } }\n    if (tw.world) SN.fx.events(R, tw.world);\n    const W = tw.world; let pose;\n    if (this.camMode === 'tv') pose = this.tv.update(R, dt, { target: this.follow });\n    else if (this.camMode === 'heli') { const s = this.follow; pose = SN.poseFrom([s.P[0] - s.F[0] * 900, s.P[1] - s.F[1] * 900, s.P[2] + 640], s.P, SN.ZUP, 50); }\n    else { this.cam.mode = this.camMode === 'cockpit' ? 'cockpit' : 'chase'; pose = this.cam.update(this.follow, dt, R); }\n    if (W) { W.camera.fixed = pose; W.step(this.paused ? 0 : dt); }\n    SN.audio.humStep(R, this.follow, W, dt, !this.paused);\n  },\n  draw(r) {\n    if (tw.world) tw.world.draw(r);\n    r.overlay(g => {\n      const T = (s, x, y, c, o = {}) => E.font.text(g, s, x, y, c, Object.assign({ outline: '#05040c' }, o)), R = this.R;\n      UI.panel(g, r.W / 2 - 34, 4, 68, 14, '#ff3ab4', .9, '#ffffff'); T('REPLAY', r.W / 2, 7, '#05040c', { align: 'center', outline: false });\n      T(SN.fmtTime(R.t) + '  ' + (this.follow ? this.follow.name : ''), 8, 8, '#ffffff', { scale: 1 });\n      this._chips = []; const chip = (label, on, fn, x) => { const w = E.font.width(label) + 10; UI.panel(g, x, 22, w, 13, on ? '#163a5a' : '#0c1020', .9, on ? '#ffffff' : '#29c8e8'); T(label, x + 5, 25, '#ffffff', { outline: false }); this._chips.push([x, 22, w, 13, fn].reduce((a, v, k) => (a[k] = v, a), [])); this._chips[this._chips.length - 1].fn = fn; return x + w + 4; };\n      let x = 8; for (const sp of [1, 2, 4]) x = chip('×' + sp, this.speed === sp, () => { this.speed = sp; }, x);\n      x = chip(this.paused ? 'PLAY' : 'PAUSE', this.paused, () => { this.paused = !this.paused; }, x + 6);\n      chip('CAM: ' + this.camMode.toUpperCase(), false, () => { const M = ['tv', 'chase', 'cockpit', 'heli']; this.camMode = M[(M.indexOf(this.camMode) + 1) % 4]; }, x + 6);\n      if (this.done) T(this.desync ? 'REPLAY DESYNC' : 'END OF REPLAY', r.W / 2, r.H / 2, this.desync ? '#ff6b6b' : '#ffd36a', { scale: 2, align: 'center' });\n      T('CLICK A CRAFT TO FOLLOW IT', 8, r.H - 34, '#7a8aa8', { font: 'tiny' });\n      SN.glyph.bar(g, [['confirm', this.paused ? 'PLAY' : 'PAUSE'], ['tabL', ''], ['tabR', 'SPEED'], ['camera', 'CAMERA'], ['cancel', 'EXIT']], r.W - 8, r.H - 18, { right: true });\n    });\n  }\n};\nconst attractScene = {\n  enter() { SN.attract.start(0); SN.hud.reset(); game.input.consumeAll(); this.t = 0; },\n  exit() { SN.audio.silenceHums(); },\n  update(dt) {\n    this.t += dt; const I = game.input;\n    if (this.t > .3 && SN.attract.anyInput(I)) { I.consumeAll(); SN.attract.idleT = 0; game.go('title', {}, { fade: 0 }); return; }\n    SN.attract.step(dt);\n  },\n  draw(r) { SN.attract.draw(r); }\n};\nconst sessionScene = {\n  enter() {\n    const H = SN.hub; SN.hud.reset();\n    tw = R3.trackWorld(H.event.track); race = H.makeRace(tw); R3.attach(tw, race); cfg = { mode: 'hub' };\n    ctls = [new SN.Controls(game.input, 0)]; cams = [new SN.ChaseCam()]; tv = new SN.TVDirector(tw.T, tw.terrain);\n    SN.audio.music(SN.TRACKS[H.event.track].song, { layers: ['pad', 'pad2', 'bass', 'sub'] });\n    if (!H.readyCalled) { H.readyCalled = true; AIHub.ready(); }\n  },\n  update(dt) {\n    const H = SN.hub, I = game.input, W = tw.world;\n    if (H.ended) { if (W) W.step(0); return; }\n    if (!H.started) {\n      H.cardInput(I, game.r);\n      const g0 = race.track.grid[0], fr = race.track.frameAt(g0.s), eye = race.track.point(g0.s + 40 * U, 10 * U * Math.sin(game.real * .2), 9 * U), look = race.track.point(race.track.grid[7].s, 0, 2 * U);\n      if (W) { W.camera.fixed = SN.poseFrom(eye, look, SN.ZUP, 55); W.step(dt); }\n      return;\n    }\n    const c = ctls[0].read(dt); race.setControls(0, c); if (c.camera) cycleCam(0);\n    race.step(dt); H.step(race, dt);\n    if (W) SN.fx.events(race, W); SN.audio.events(race, { radio: false }); SN.hud.events(race); SN.hud.step(dt);\n    const s = race.player; let pose = s.finished ? tv.update(race, dt, { target: s }) : cams[0].update(s, dt, race, { lookBack: ctls[0].out.lookBack });\n    if (W) { W.camera.fixed = pose; W.camera.target = { x: s.P[0], y: s.P[1], z: s.P[2] }; W.step(dt); }\n    SN.audio.humStep(race, s, W, dt, true);\n  },\n  draw(r) {\n    const H = SN.hub;\n    if (tw.world) tw.world.draw(r);\n    if (!H.started) { r.overlay(g => H.drawCard(g, r)); return; }\n    SN.hud.draw(r, race, race.player, null);\n    if (H.ended) r.overlay(g => {\n      UI.panel(g, r.W / 2 - 110, r.H / 2 - 50, 220, 100, '#05040c', .9, '#29c8e8');\n      E.font.title(g, 'ROUND OVER', r.W / 2, r.H / 2 - 42, { scale: 3, colors: ['#ffffff', '#7af0ff'], align: 'center' });\n      const st = (H.endInfo && H.endInfo.standings) || [], names = id => { const p = (H.info.players || []).find(q => q.id === id); return p ? p.name : '?'; };\n      st.slice(0, 4).forEach((grp, k) => E.font.text(g, (k + 1) + '. ' + [].concat(grp).map(names).join(', '), r.W / 2, r.H / 2 - 8 + k * 11, '#ffffff', { align: 'center', outline: '#05040c' }));\n    });\n  }\n};\n\n/* ---- the debug handle (tests, tools/check.mjs) ---- */\ngame.debug = {\n  snapshot() {\n    const R = game.sceneName === 'attract' ? SN.attract.race : game.sceneName === 'title' ? titleRace : game.sceneName === 'replay' ? replayScene.R : race;\n    const sh = s => ({ id: s.id, name: s.name, p: Math.round(s.p), s: Math.round(s.s), u: Math.round(s.u), h: Math.round(s.h), v: Math.round(s.speed), kmh: Math.round(s.kmh), energy: Math.round(s.energy * 10) / 10, lap: s.lap, place: s.place, weapon: s.weapon, airborne: !s.grounded, finished: s.finished, elim: s.elim, points: s.points, control: s.control });\n    return { scene: game.sceneName, screen: UI.top() ? UI.top().id : null, focus: UI.top() ? UI.top().focus : null, state: R && R.state, mode: R && R.mode, track: R && R.track.id, cls: R && R.cls, t: R ? +R.t.toFixed(3) : 0,\n      ships: R ? R.ships.map(sh) : [], player: R && R.player ? sh(R.player) : null, hudCallouts: (SN.hud.views[0] || { callouts: [] }).callouts.map(c => c.text), device: game.input.lastDevice, attract: game.sceneName === 'attract', dev: SN.dev.isOpen,\n      story: SN.story.active, season: { medals: SN.save.data.medals, unlocked: SN.save.data.unlocked, gp: SN.save.data.gp }, hub: { active: SN.hub.active, connected: !!SN.hub.info, sent: SN.hub.sent, progressCount: SN.hub.progressCount, started: SN.hub.started, ended: SN.hub.ended },\n      zone: R && R.zone, backend: E.World3D ? E.World3D.backend : 'none', paused: game.paused, splits: game._split ? game._split.vps.length : 1 };\n  },\n  teleport(s, u = 0, v = 0) { if (race) SN.debugTeleport(race, s, u, v); },\n  give(w) { if (race && race.player) race.weapons.give(race.player, w); },\n  setEnergy(x) { if (race && race.player) race.player.energy = x; },\n  finishNow() { if (race) race.endRun(); },\n  events: () => race ? race.events.slice() : [],\n  race: () => race, track: () => race && race.track, tune: SN.Tune, cfg: () => cfg, cams: () => cams, ctls: () => ctls, tw: () => tw\n};\n\ngame.start({ scenes: { title: titleScene, front: frontScene, loading: loadingScene, race: raceScene, results: resultsScene, replay: replayScene, attract: attractScene, session: sessionScene },\n  scene: HUBON ? 'session' : 'title', boot });\nif (HUBON) { const g0 = game.go.bind(game); game.booted && game.booted.then && game.booted.then(() => { if (!SN.hub.info && game.sceneName === 'session') g0('title'); }); }\n})();\n","structuredPatch":[{"oldStart":1,"oldLines":29,"newStart":1,"newLines":402,"lines":["-// SNIPEOUT HD: the game. new E.Game, the boot, the scenes and game.debug.","+// SNIPEOUT HD: the game. new E.Game with the game's settings and pause items, the boot (the 3D engine, the circuits, the","+// hangar, the sound), the scenes (title, the front end, loading, race, results, replay, attract, the AI Hub session),","+// the flow between them, and game.debug for the tests."," (() => {","-const E = My3D2dge, SN = globalThis.SN;","-const game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, bg: null, input: SN.INPUT, id: 'snipeout-hd' });","-SN.game = game;","+const E = My3D2dge, SN = globalThis.SN, V = SN.v, U = 16, UI = SN.UI, R3 = SN.render;","+const HUBON = SN.hub.active;","+const SETTINGS = [","+  { key: 'difficulty', label: 'Difficulty', group: 'Game', options: [['Easy', 'Easy'], ['Normal', 'Normal'], ['Hard', 'Hard']], value: 'Normal', help: 'How fast and how aggressive the AI pilots are, and how much they catch up' },","+  { key: 'units', label: 'Speed units', group: 'Game', options: [['kmh', 'km/h'], ['mph', 'mph']], value: 'kmh' },","+  { key: 'defaultCam', label: 'Default camera', group: 'Game', options: [['chase', 'Chase'], ['far', 'Far chase'], ['cockpit', 'Cockpit']], value: 'chase' },","+  { key: 'hudSize', label: 'HUD size', group: 'Display', options: [['normal', 'Normal'], ['large', 'Large']], value: 'normal' },","+  { key: 'subtitles', label: 'Subtitles', group: 'Game', value: true, help: 'The announcer and the race radio as text' },","+  { key: 'announcer', label: 'Announcer voice', group: 'Game', value: true },","+  { key: 'speedLines', label: 'Speed lines', group: 'Display', value: true },","+  { key: 'bloom', label: 'Neon glow', group: 'Display', value: true, apply: (g, v) => { for (const w of [R3.tw && R3.tw.world, R3.hangar && R3.hangar.world]) if (w) w.filter.bloom = !!v; } },","+  { key: 'picture3d', label: 'Picture', group: 'Display', options: [['pixels', 'Pixels'], ['balanced', 'Balanced'], ['full', 'HD']], value: 'pixels', help: 'Pixels: the native chunky look. HD: the screen\\'s full resolution' },","+  { key: 'shadows3d', label: 'Shadows', group: 'Display', value: true },","+  { key: 'filter3d', label: 'Filter', group: 'Display', options: [['clean', 'None'], ['cel', 'Comic cel'], ['pixel', 'Pixel']], value: 'clean' }","+];","+let race = null, cfg = null, tw = null, cams = [], ctls = [], tv = null, ghostRec = null, ghostData = null, ghostShip = null, resultsT = 0, toastT = 0, devFromPause = false, freeCam = null;","+const pauseItems = () => {","+  if (HUBON || !race || game.sceneName !== 'race') return [];","+  return [","+    ['Restart', () => { game.shell && game.shell.hide(); SN.flow.start(Object.assign({}, cfg)); }],","+    ['Camera: ' + camLabel(cams[0] && cams[0].mode), () => { cycleCam(0); game.shell && game.shell.show('pause'); }],","+    ['How to play', () => game.shell && game.shell.show('help', helpSpec())],","+    ['Dev mode', () => { game.shell && game.shell.hide(); openDev(); }],","+    race.rules.endRun ? ['End run', () => { game.shell && game.shell.hide(); race.endRun(); }] : null","+  ];","+};","+const game = SN.game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, bg: null, input: SN.INPUT, id: 'snipeout-hd', autoPause: !HUBON,","+  menu: { items: pauseItems, settings: SETTINGS, controls: SN.CONTROL_NAMES, quit: HUBON ? false : 'title' } });","+game.input.touchEnabled = false;","+const camLabel = m => ({ chase: 'Chase', far: 'Far chase', cockpit: 'Cockpit' }[m] || 'Chase');","+const cycleCam = i => { const c = cams[i]; if (!c) return; c.mode = c.mode === 'chase' ? 'far' : c.mode === 'far' ? 'cockpit' : 'chase'; c.reset(); };","+const helpSpec = () => {","+  const I = game.input, L = a => I.label(a) || '-';","+  return { title: 'How to play', keys: [[L('thrust'), 'Thrust (hold)'], [L('left') + ' ' + L('right'), 'Steer'], [L('brakeL') + ' ' + L('brakeR'), 'Airbrakes: tighter turns, both to brake'], [L('shiftL') + ' ' + L('shiftR'), 'Side-shift; a barrel roll in the air'], [L('fire'), 'Fire (hold for cannon / railshot)'], [L('absorb'), 'Absorb the weapon into shield'], [L('camera'), 'Camera'], [L('lookBack'), 'Look back']],","+    sections: [['Energy', 'Walls, weapons and rolls cost shield. The green pit strip recharges it. At zero you are eliminated.'], ['Pads', 'Blue chevrons boost. Amber pads give a weapon.'], ['Launch', 'Hold thrust as the lights count down: release the revs in the green band for a perfect start.']] };","+};","+","+/* ---- boot ---- */"," const wait3D = () => new Promise((ok, no) => {","   if (!SN.browser) return ok();","   const t0 = performance.now();","-  const tick = () => { if (E.World3D) return E.World3D.init(game).then(() => { SN._w3dInit = true; ok(); }, no); if (window.__sn3dFail || performance.now() - t0 > 30000) return no(new Error('The 3D engine could not load (three.js from cdn.jsdelivr.net). Check the connection and reload.')); setTimeout(tick, 50); };","+  const tick = () => {","+    if (E.World3D) return E.World3D.init(game).then(() => { SN._w3dInit = true; ok(); }, no);","+    if (window.__sn3dFail || performance.now() - t0 > 30000) return no(new Error('The 3D engine could not load (three.js from cdn.jsdelivr.net). Check the connection and reload.'));","+    setTimeout(tick, 50);","+  };","   tick();"," });","-let race = null, cam = new SN.ChaseCam(), tw = null;","-const scenes = {","-  race: {","-    enter() {","-      tw = SN.render.trackWorld('solenne');","-      race = new SN.Race({ track: tw.T, mode: 'race', cls: 'SPARK', laps: 3, seed: 3, entrants: SN.field({ humans: [] }), intro: false });","-      SN.render.attach(tw, race);","-    },","-    update(dt) {","-      race.step(dt);","-      if (tw.world) { SN.fx.events(race, tw.world); tw.world.camera.fixed = cam.update(race.ships[7], dt, race); tw.world.step(dt); }","-    },","-    draw(r) { if (tw.world) tw.world.draw(r); r.overlay(g => E.font.text(g, 'SNIPEOUT HD ' + Math.round(race.ships[7].kmh) + ' KM/H', 8, 8, '#ffffff', { scale: 2 })); }","+const boot = { title: 'SNIPEOUT HD', version: SN.VERSION, messages: ['Calibrating the anti-gravity field', 'Polishing the neon', 'Briefing ORACLE', 'Negotiating with QWIK-FUEL'], steps: [","+  ['Waking the 3D engine', wait3D],","+  ['Surveying the circuits', () => { for (const id of SN.TRACK_ORDER) SN.getTrack(id); }],","+  ['Tuning the synthesizers', () => SN.audio.define()],","+  ['Opening the saves', () => SN.save.init(game)],","+  ['Building the hangar', () => { if (!HUBON) R3.hangarWorld(); }],","+  ['Building Port Solenne', () => { if (!HUBON) R3.trackWorld('solenne'); }],","+  ['Connecting to the AI Hub', () => HUBON ? SN.hub.begin(game).then(ok => { if (!ok) R3.trackWorld('solenne'); }) : null]","+] };","+","+/* ---- the flow ---- */","+const F = SN.flow;","+F.toTitle = () => { UI.reset(); game.go('title', {}, { fade: 'wipe', seconds: .25 }); };","+F.toMenu = () => F.toFront(() => UI.reset(SN.screens.main()));","+F.toSeason = () => F.toFront(() => { UI.reset(SN.screens.main()); SN.flow.season(); });","+F.toFront = then => { game.go('front', { then }, { fade: 'wipe', seconds: .25 }); };","+/** start a race from a config: { mode, track, cls, laps, team, pilot, season, gpRound, target, versusMode, players } */","+F.start = c => { cfg = Object.assign({ laps: 3, cls: 'SPARK', track: 'solenne', team: SN.save.data.team || 'kestrel', pilot: SN.save.data.pilot || 'vale' }, c); if (cfg.mode === 'gp' || cfg.mode === 'season') cfg.cls = cfg.cls || 'STORM'; game.go('loading', { cfg }, { fade: 'wipe', seconds: .25 }); };","+F.replay = r => game.go('replay', { race: r }, { fade: 'wipe', seconds: .25 });","+/** a race from a config: the field, the rules */","+F.makeRace = (c, T) => {","+  const mode = c.mode, humans = mode === 'versus' ? (c.players || []).map(p => ({ pilot: p.pilot, team: p.team })) : [{ pilot: c.pilot, team: c.team, champion: c.champion }];","+  let ent, rules = {};","+  if (mode === 'timetrial' || mode === 'hotlap' || mode === 'overclock' || mode === 'academy') {","+    ent = [{ pilot: c.pilot, team: c.team, control: 'human', pi: 0, champion: c.champion }];","+    if (mode === 'academy') ent.unshift({ pilot: 'hex', team: 'nullset', control: 'drone' });","+    if ((mode === 'timetrial' || mode === 'hotlap')) { const gd = SN.save.data.ghosts[T.id + '/' + c.cls + '/' + mode]; if (gd) ent.unshift({ pilot: c.pilot, team: c.team, control: 'ghost', color: '#7af0ff', label: 'GHOST' }); }","+  } else ent = SN.field({ humans, size: 8, seed: (Date.now ? 1 : 0) });","+  if (mode === 'snipeout' && c.target) rules.target = c.target;","+  if (mode === 'gp' || (c.season && mode === 'race')) rules = Object.assign(rules, {});","+  const seed = c.seed || ((typeof performance !== 'undefined' ? Math.floor(performance.now() * 1000) : 1) ^ 0x5eed) >>> 0;","+  const R = new SN.Race({ track: T, mode: mode === 'gp' ? 'gp' : mode, cls: mode === 'overclock' ? 'SPARK' : c.cls, laps: c.laps || 3, seed, entrants: ent, difficulty: game.settings.difficulty || 'Normal', intro: c.intro !== false, rules, versusMode: c.versusMode });","+  R.cfg = c; return R;","+};","+","+/* ---- the hangar: the front end's background ---- */","+const hangarCam = (dt, o = {}) => {","+  const hg = R3.hangar; if (!hg || !hg.world) return;","+  const t = game.real * .12, tt = hg.turntable, podium = o.podium;","+  let pose;","+  if (podium) { const a = -Math.PI / 2 + Math.sin(game.real * .3) * .5, cx = 14 * U, cy = 10.5 * U, d = 170; pose = SN.poseFrom([cx + Math.cos(a) * d * .2, cy + 150, 60], [cx, cy, 24], SN.ZUP, 48); }","+  else { const d = 150, x = tt.x + Math.cos(t + 1.6) * d, y = tt.y + Math.sin(t + 1.6) * d; pose = SN.poseFrom([x, y, 54], [tt.x, tt.y, 18], SN.ZUP, 52); }","+  hg.world.camera.fixed = pose; hg.world.step(dt);","+};","+R3.podiumPilots = (ids, playerPlace) => {","+  const hg = R3.hangar; if (!hg || !hg.world) return;","+  const w = hg.world; w.reset();","+  const marks = ['p1', 'p2', 'p3'];","+  ids.slice(0, 3).forEach((id, k) => { if (!id) return; const m = w.marks[marks[k]] && w.marks[marks[k]][0]; if (!m) return; const rig = SN.rigFor(id, true); if (!rig) return; const a = w.hero({ x: m.x, y: m.y, rig }); a.facing = Math.PI / 2; a.anim = { pose: k === 0 ? 'cheer' : k === 1 ? 'wave' : 'hips' }; });","+  hg.podiumAt = game.real;","+};","+","+/* ---- scenes ---- */","+let titleRace = null, titleTV = null, titleTW = null;","+const titleScene = {","+  enter() {","+    UI.reset(); SN.attract.idleT = 0; SN.hud.reset();","+    titleTW = R3.trackWorld('solenne');","+    titleRace = new SN.Race({ track: titleTW.T, mode: 'race', cls: 'FLARE', laps: 99, seed: 77, entrants: SN.field({ humans: [], seed: 3 }), intro: false, rules: { infiniteEnergy: () => true, rubberBand: false }, record: false });","+    R3.attach(titleTW, titleRace); titleTV = new SN.TVDirector(titleTW.T, titleTW.terrain);","+    for (let k = 0; k < 120 * 5; k++) titleRace.step(1 / 120);","+    SN.audio.music('zero', { layers: 'all' });","+  },","+  update(dt) {","+    const I = game.input;","+    titleRace.step(dt); const pose = titleTV.update(titleRace, dt, { attract: true });","+    if (titleTW.world) { titleTW.world.camera.fixed = pose; titleTW.world.step(dt); }","+    SN.audio.humStep(titleRace, titleTV.target, titleTW.world, dt, false);","+    if (SN.attract.idle(dt, I)) { game.go('attract', {}, { fade: 'wipe', seconds: .3 }); return; }","+    const c = I.clicked(), touch = SN.touchOnly();","+    if (touch) { const b = titleScene._btn; if (c && b && c[0] >= b[0] && c[0] < b[0] + b[2] && c[1] >= b[1] && c[1] < b[1] + b[3]) { I.consumeAll(); game.menu('settings'); } return; }","+    if (I.pressed('start') || I.pressed('confirm') || c) { I.consumeAll(); SN.audio.sfx('ui_ok'); F.toMenu(); }","+  },","+  draw(r) {","+    if (titleTW.world) titleTW.world.draw(r);","+    r.overlay(g => {","+      const T = (s, x, y, c, o = {}) => E.font.text(g, s, x, y, c, Object.assign({ outline: '#05040c' }, o));","+      g.save(); g.globalAlpha = .35; g.fillStyle = '#05040c'; g.fillRect(0, r.H * .2, r.W, 70); g.restore(); g._c = null;","+      SN.drawLogo(g, r.W / 2, r.H * .2 + 10, 1);","+      T('ANTI-GRAVITY. ANTI-EVERYONE.', r.W / 2, r.H * .2 + 52, '#7af0ff', { align: 'center' });","+      if (SN.touchOnly()) {","+        const w = 250, x = r.W / 2 - w / 2, y = r.H * .58; UI.panel(g, x, y, w, 56, '#0a0c18', .92, '#ff3ab4');","+        T('CONTROLLER OR KEYBOARD REQUIRED', r.W / 2, y + 8, '#ffffff', { scale: 1, align: 'center' });","+        const b = titleScene._btn = [r.W / 2 - 50, y + 26, 100, 22]; UI.panel(g, b[0], b[1], b[2], b[3], '#163a5a', .95, '#ffffff'); T('SETTINGS', r.W / 2, b[1] + 4, '#ffffff', { scale: 2, align: 'center' });","+      } else if (Math.floor(game.real * 1.6) % 2) {","+        const I = game.input, dev = SN.glyph.device(I), w = E.font.width('PRESS START', { scale: 2 });","+        T('PRESS START', r.W / 2 + 8, r.H * .66, '#ffffff', { scale: 2, align: 'center' }); SN.glyph.draw(g, dev === 'gamepad' ? 'confirm' : 'start', r.W / 2 - w / 2 - 10, r.H * .66 + 1, { input: I });","+      }","+      T(E.versionLabel ? E.versionLabel() + ' · SNIPEOUT HD ' + SN.VERSION : SN.VERSION, r.W - 6, r.H - 10, '#5a6a8a', { align: 'right', font: 'tiny' });","+      T('© 2161 THE HOVERLINE AUTHORITY. A FICTIONAL LEAGUE.', 6, r.H - 10, '#5a6a8a', { font: 'tiny' });","+    });","   }"," };","-game.debug = { snapshot: () => ({ scene: game.sceneName, t: race && race.t, ships: race ? race.ships.map(s => [Math.round(s.s), Math.round(s.kmh)]) : [], backend: E.World3D ? E.World3D.backend : 'none', stats: tw && tw.world ? tw.world.stats : null }) };","-game.start({ scenes, scene: 'race', boot: { title: 'SNIPEOUT HD', steps: [['Waking the 3D engine', wait3D], ['Surveying the circuits', () => { for (const id of SN.TRACK_ORDER) SN.getTrack(id); }], ['Building Port Solenne', () => { SN.render.trackWorld('solenne'); }]] } });","+const frontScene = {","+  enter(d) {","+    SN.hud.reset(); R3.hangarWorld(); SN.audio.music('zero', { layers: 'all' }); SN.attract.idleT = 0;","+    if (R3.hangar && R3.hangar.world) R3.hangar.world.reset();","+    if (d && d.then) d.then(); else if (!UI.top()) UI.reset(SN.screens.main());","+  },","+  update(dt) {","+    const I = (UI.top() && UI.top().ownerInput) || game.input;","+    const podium = !!(R3.hangar && R3.hangar.world && R3.hangar.world.actors.length);","+    hangarCam(dt, { podium });","+    if (SN.dev.isOpen) { SN.dev.update(dt, game.input); return; }","+    if (SN.story.update(dt, game.input)) return;","+    if (!game.paused && !(game.shell && game.shell.screen) && SN.attract.idle(dt, game.input) && !(UI.top() && (UI.top().id === 'results' || UI.top().id === 'credits'))) { game.go('attract', {}, { fade: 'wipe', seconds: .3 }); return; }","+    if (game.shell && game.shell.screen) return;","+    UI.update(dt, I);","+  },","+  draw(r) {","+    const hg = R3.hangar; if (hg && hg.world) hg.world.draw(r);","+    UI.draw(r); SN.story.draw(r); SN.dev.draw(r);","+  }","+};","+const loadingScene = {","+  enter(d) { this.cfg = d.cfg; this.t = 0; this.built = false; SN.audio.music(null); },","+  update(dt) {","+    this.t += dt;","+    if (!this.built && this.t > .05) {","+      const c = this.cfg, skin = c.mode === 'overclock' ? 'overclock' : 'normal';","+      tw = R3.trackWorld(c.track, skin);","+      race = F.makeRace(c, tw.T); R3.attach(tw, race);","+      this.built = true;","+    }","+    if (this.built && this.t > .6) game.go('race', { race, cfg: this.cfg }, { fade: 'wipe', seconds: .25 });","+  },","+  draw(r) {","+    const c = this.cfg, D = SN.TRACKS[c.track];","+    r.overlay(g => {","+      g.fillStyle = '#05040c'; g.fillRect(0, 0, r.W, r.H); g._c = null;","+      const T = (s, x, y, col, o = {}) => E.font.text(g, s, x, y, col, Object.assign({ outline: '#05040c' }, o));","+      E.font.title(g, D.name, r.W / 2, r.H / 2 - 40, { scale: 3, colors: ['#ffffff', '#9ff4ff', '#29c8e8'], align: 'center' });","+      T(D.place, r.W / 2, r.H / 2 - 10, '#b8c4dc', { align: 'center' });","+      T(SN.MODES[c.mode].label + ' · ' + (c.mode === 'overclock' ? 'OVERCLOCK SKIN' : c.cls), r.W / 2, r.H / 2 + 2, '#ffd36a', { align: 'center' });","+      E.px.rect(g, r.W / 2 - 80, r.H / 2 + 20, 160, 4, '#1a1a2a'); E.px.rect(g, r.W / 2 - 80, r.H / 2 + 20, Math.round(160 * Math.min(1, this.t / .6)), 4, '#29c8e8');","+      T(SN.STORY.tips[Math.floor((c.track.length + (c.mode || '').length)) % SN.STORY.tips.length], r.W / 2, r.H / 2 + 36, '#e8ecff', { align: 'center', wrap: r.W - 60 });","+    });","+  }","+};","+const openDev = () => { const sc = game.scene; devFromPause = true; if (sc) sc.pausable = false; SN.dev.open(race, () => { if (game.scene === raceScene) { raceScene.pausable = !HUBON; game.menu(); } }); };","+const raceScene = {","+  pausable: true,","+  enter(d) {","+    race = d.race; cfg = d.cfg; this.t = 0; resultsT = 0; toastT = 0; SN.hud.reset(); SN.audio.muted = false; freeCam = null;","+    raceScene.pausable = true;","+    const P = game.players;","+    ctls = race.humans.map((s, i) => new SN.Controls(P[i] || game.input, i));","+    cams = race.humans.map(() => { const c = new SN.ChaseCam(); c.mode = game.settings.defaultCam || 'chase'; return c; });","+    tv = new SN.TVDirector(tw.T, tw.terrain);","+    if (race.humans.length > 1) { game.splitScreen(2, { layout: 'rows' }); if (tw.world && tw.world.cameras.length < 2) tw.world.addCamera({ mode: 'fixed', far: 26000, near: 4 }); }","+    // ghosts: time trial and hot lap","+    ghostRec = (race.mode === 'timetrial' || race.mode === 'hotlap') && race.player ? SN.Ghost.recorder(race, race.player) : null; race.ghostRec = ghostRec;","+    ghostShip = race.ships.find(s => s.ghost) || null; ghostData = null;","+    if (ghostShip) { const k = race.track.id + '/' + race.cls + '/' + race.mode, gd = SN.save.data.ghosts[k]; ghostData = gd ? SN.Ghost.decode(gd) : null; ghostShip.hidden = true; }","+    SN.audio.music(race.mode === 'overclock' ? 'overclock' : SN.TRACKS[race.track.id].song, { sync: true, restart: true, layers: ['pad', 'pad2', 'bass', 'sub'] });","+    SN.audio.lastRadio = -99;","+  },","+  exit() { game.splitScreen(0); SN.audio.silenceHums(); game.timeScale = 1; SN.dev.isOpen = false; R3.hideShip = null; },","+  update(dt) {","+    const I = game.input;","+    if (SN.dev.isOpen) { SN.dev.update(dt, I); if (tw.world) tw.world.step(0); return; }","+    this.t += dt; toastT += dt;","+    if (race.state === 'intro' && (I.pressed('confirm') || I.clicked())) { race.skipIntro(); I.consumeAll(); }","+    // controls: each human's own input (a free camera parks the player's on autopilot)","+    race.humans.forEach((s, i) => { const c = ctls[i].read(dt); if (SN.flags.freeCam && i === 0) { race.setControls(i, SN.AI.controls(s, race, { skill: 1, brain: 'free' })); } else race.setControls(i, c); if (c.camera) cycleCam(i); });","+    race.step(dt);","+    if (ghostRec && race.state === 'racing' && !race.player.finished) ghostRec.step(dt);","+    if (ghostShip && ghostData) SN.Ghost.pose(ghostShip, ghostData, race.t, race.track);","+    if (tw.world) SN.fx.events(race, tw.world);","+    SN.audio.events(race); SN.hud.events(race); SN.hud.step(dt);","+    for (const e of race.events) if (e.t === 'go') toastT = 0;","+    // cameras","+    const W = tw.world;","+    race.humans.forEach((s, i) => {","+      let pose;","+      if (race.state === 'intro') pose = SN.introPose(race, race.stateT);","+      else if ((race.state === 'finished' || race.state === 'results') && (s.finished || s.dnf) && race.humans.length === 1) pose = tv.update(race, dt, { target: s.dnf ? null : s });","+      else if (SN.flags.freeCam && i === 0) { freeCam = freeCam || new SN.FreeCam(W ? W.camera.pose || { x: s.P[0], y: s.P[1], z: s.P[2] + 200, yaw: 0, pitch: -.3 } : { x: s.P[0], y: s.P[1], z: s.P[2] + 200, yaw: 0, pitch: -.3 }); pose = freeCam.update(I, dt); }","+      else { const lb = ctls[i].out.lookBack; pose = cams[i].update(s, dt, race, { lookBack: lb, cut: race.state === 'grid' && race.stateT < .02 }); }","+      if (W && W.cameras[i]) W.cameras[i].fixed = pose;","+    });","+    if (!SN.flags.freeCam) freeCam = null;","+    R3.hideShip = cams[0] && cams[0].mode === 'cockpit' && race.state !== 'intro' && !(race.state === 'finished' && race.humans.length === 1) && race.humans.length === 1 ? race.humans[0] : null;","+    if (W) { W.camera.target = race.player ? { x: race.player.P[0], y: race.player.P[1], z: race.player.P[2] } : null; W.step(dt); }","+    SN.audio.humStep(race, race.player, W, dt, true);","+    if (race.state === 'results') { resultsT += dt; if (resultsT > 1.2) { const O = F.outcome(race); game.go('results', { race, O }, { fade: 'wipe', seconds: .3 }); } }","+  },","+  draw(r) {","+    if (tw.world) tw.world.draw(r);","+    const vp = r.viewport, i = vp ? vp.i : 0, s = race.humans[i];","+    if (tw.world) SN.debugDraw(tw.world, race);","+    if (race.state === 'intro' && !vp) r.overlay(g => introCard(g, r));","+    else if (s && race.state !== 'intro') SN.hud.draw(r, race, s, vp);","+    if (!vp) this.hud(r);","+  },","+  hud(r) {","+    if (race.humans.length > 1 && race.state === 'countdown') r.overlay(g => { const n = 3 - Math.floor(race.stateT); if (n >= 1) E.font.title(g, String(n), r.W / 2, r.H / 2 - 20, { scale: 5, colors: ['#ffffff', '#ff6b6b'], align: 'center' }); });","+    if (toastT < 4 && race.state === 'racing' && SN.audio.songId) r.overlay(g => { const s = SN.audio.nowPlaying(SN.audio.songId), w = E.font.width(s) + 12, k = toastT < .3 ? toastT / .3 : toastT > 3.5 ? (4 - toastT) * 2 : 1; UI.panel(g, r.W - w - 6, r.H - 58 - (1 - k) * 10, w, 13, '#05040c', .7 * k, '#ff3ab4'); E.font.text(g, s, r.W - w, r.H - 55 - (1 - k) * 10, '#ffffff', { outline: false }); });","+    if (race.state === 'finished' && race.humans.every(h => h.finished || h.dnf)) r.overlay(g => E.font.text(g, race.player && race.player.dnf ? 'ELIMINATED · SPECTATING' : 'RACE COMPLETE · SPECTATING', r.W / 2, r.H - 66, '#ffd36a', { align: 'center', outline: '#05040c' }));","+    SN.dev.draw(r);","+  }","+};","+function introCard(g, r) {","+  const D = SN.TRACKS[race.track.id], T = (s, x, y, c, o = {}) => E.font.text(g, s, x, y, c, Object.assign({ outline: '#05040c' }, o)), k = Math.min(1, race.stateT / .4);","+  UI.panel(g, 0, r.H - 74, r.W * k, 50, '#05040c', .7, '#29c8e8');","+  E.font.title(g, D.name, 12, r.H - 68, { scale: 3, colors: ['#ffffff', '#9ff4ff', '#29c8e8'] });","+  T(D.place + ' · ' + D.lengthKm.toFixed(2) + ' KM · ' + (race.rules.target ? 'FIRST TO ' + race.rules.target : race.rules.endRun ? SN.MODES[race.mode].label : race.laps + ' LAPS') + ' · ' + race.cls, 12, r.H - 42, '#ffd36a');","+  SN.glyph.bar(g, [['confirm', 'SKIP']], r.W - 8, 8, { right: true });","+}","+const resultsScene = {","+  enter(d) {","+    this.race = d.race; this.O = d.O; this.t = 0; R3.hangarWorld(); SN.audio.silenceHums();","+    const pl = d.race.player, top3 = pl && !d.race.rules.solo && d.O.mine && d.O.mine.place <= 3 && !pl.dnf;","+    this.podium = top3;","+    if (top3) { R3.podiumPilots(d.O.res.slice(0, 3).map(x => x.pilot), d.O.mine.place - 1); SN.audio.sting(d.O.mine.place === 1 ? 'win' : 'podium'); }","+    else if (R3.hangar && R3.hangar.world) R3.hangar.world.reset();","+    if (d.O.medal) SN.audio.sting('medal');","+    if (d.O.unlocks.length) SN.audio.sting('unlock');","+    SN.audio.music('zero', { layers: ['pad', 'pad2', 'arp'] });","+    UI.reset(SN.screens.results(d.race, d.O));","+  },","+  update(dt) {","+    this.t += dt; hangarCam(dt, { podium: this.podium && this.t < 4.5 });","+    if (this.podium && this.t < 4.5) { if (Math.random() < .5 && R3.hangar && R3.hangar.world) game.particles.bits(14 * U + (Math.random() - .5) * 120, 10.5 * U + (Math.random() - .5) * 40, 90, 2, ['#ffd23f', '#ff3ab4', '#7af0ff', '#ffffff']); if (game.input.pressed('confirm') || game.input.clicked()) { this.t = 4.5; game.input.consumeAll(); } return; }","+    if (SN.dev.isOpen) { SN.dev.update(dt, game.input); return; }","+    if (SN.story.update(dt, game.input)) return;","+    UI.update(dt, game.input);","+  },","+  draw(r) {","+    const hg = R3.hangar; if (hg && hg.world) hg.world.draw(r);","+    if (this.podium && this.t < 4.5) { r.overlay(g => { E.font.title(g, 'PODIUM', r.W / 2, 14, { scale: 3, colors: ['#ffffff', '#ffd23f'], align: 'center' }); const names = this.O.res.slice(0, 3); names.forEach((x, k) => E.font.text(g, (k + 1) + '. ' + x.name, r.W / 2, r.H - 52 + k * 11, k === 0 ? '#ffd23f' : '#ffffff', { align: 'center', outline: '#05040c' })); SN.glyph.bar(g, [['confirm', 'SKIP']], r.W - 8, 8, { right: true }); }); return; }","+    UI.draw(r); SN.story.draw(r); SN.dev.draw(r);","+  }","+};","+const replayScene = {","+  enter(d) {","+    this.src = d.race; this.R = SN.Replay.play(d.race.recording); this.speed = 1; this.paused = false; this.camMode = 'tv'; this.follow = this.R.player || this.R.ships[0]; this.done = false; this.desync = false;","+    tw = R3.trackWorld(d.race.track.id, d.race.mode === 'overclock' ? 'overclock' : 'normal'); R3.attach(tw, this.R);","+    this.tv = new SN.TVDirector(tw.T, tw.terrain); this.cam = new SN.ChaseCam(); SN.hud.reset();","+    SN.audio.music(d.race.mode === 'overclock' ? 'overclock' : SN.TRACKS[d.race.track.id].song, { layers: 'all' });","+  },","+  exit() { SN.audio.silenceHums(); },","+  update(dt) {","+    const I = game.input, R = this.R;","+    if (I.pressed('cancel')) { I.consumeAll(); game.go('results', { race: this.src, O: F.outcome(this.src) }, { fade: 'wipe', seconds: .25 }); return; }","+    if (I.pressed('confirm')) this.paused = !this.paused;","+    if (I.pressed('tabR')) this.speed = this.speed === 1 ? 2 : this.speed === 2 ? 4 : 4;","+    if (I.pressed('tabL')) this.speed = this.speed === 4 ? 2 : 1;","+    if (I.pressed('camera') || I.pressed('more')) { const M = ['tv', 'chase', 'cockpit', 'heli']; this.camMode = M[(M.indexOf(this.camMode) + 1) % 4]; this.cam.reset(); }","+    const c = I.clicked();","+    if (c) {","+      const L = this._chips || []; const ch = L.find(q => c[0] >= q[0] && c[0] < q[0] + q[2] && c[1] >= q[1] && c[1] < q[1] + q[3]);","+      if (ch) ch.fn(); else if (tw.world) { let best = null, bd = 18; for (const s of R.ships) { if (s.hidden || s.drone) continue; const q = tw.world.project(s.P[0], s.P[1], s.P[2] + 8); if (q) { const d2 = Math.hypot(q[0] - c[0], q[1] - c[1]); if (d2 < bd) { bd = d2; best = s; } } } if (best) { this.follow = best; this.camMode = this.camMode === 'tv' ? 'chase' : this.camMode; } }","+      I.consumeAll();","+    }","+    if (!this.paused && !this.done) for (let k = 0; k < this.speed; k++) { R.replay.run(dt); if (R.replay.done) { this.done = true; this.desync = !R.replay.ok; break; } }","+    if (tw.world) SN.fx.events(R, tw.world);","+    const W = tw.world; let pose;","+    if (this.camMode === 'tv') pose = this.tv.update(R, dt, { target: this.follow });","+    else if (this.camMode === 'heli') { const s = this.follow; pose = SN.poseFrom([s.P[0] - s.F[0] * 900, s.P[1] - s.F[1] * 900, s.P[2] + 640], s.P, SN.ZUP, 50); }","+    else { this.cam.mode = this.camMode === 'cockpit' ? 'cockpit' : 'chase'; pose = this.cam.update(this.follow, dt, R); }","+    if (W) { W.camera.fixed = pose; W.step(this.paused ? 0 : dt); }","+    SN.audio.humStep(R, this.follow, W, dt, !this.paused);","+  },","+  draw(r) {","+    if (tw.world) tw.world.draw(r);","+    r.overlay(g => {","+      const T = (s, x, y, c, o = {}) => E.font.text(g, s, x, y, c, Object.assign({ outline: '#05040c' }, o)), R = this.R;","+      UI.panel(g, r.W / 2 - 34, 4, 68, 14, '#ff3ab4', .9, '#ffffff'); T('REPLAY', r.W / 2, 7, '#05040c', { align: 'center', outline: false });","+      T(SN.fmtTime(R.t) + '  ' + (this.follow ? this.follow.name : ''), 8, 8, '#ffffff', { scale: 1 });","+      this._chips = []; const chip = (label, on, fn, x) => { const w = E.font.width(label) + 10; UI.panel(g, x, 22, w, 13, on ? '#163a5a' : '#0c1020', .9, on ? '#ffffff' : '#29c8e8'); T(label, x + 5, 25, '#ffffff', { outline: false }); this._chips.push([x, 22, w, 13, fn].reduce((a, v, k) => (a[k] = v, a), [])); this._chips[this._chips.length - 1].fn = fn; return x + w + 4; };","+      let x = 8; for (const sp of [1, 2, 4]) x = chip('×' + sp, this.speed === sp, () => { this.speed = sp; }, x);","+      x = chip(this.paused ? 'PLAY' : 'PAUSE', this.paused, () => { this.paused = !this.paused; }, x + 6);","+      chip('CAM: ' + this.camMode.toUpperCase(), false, () => { const M = ['tv', 'chase', 'cockpit', 'heli']; this.camMode = M[(M.indexOf(this.camMode) + 1) % 4]; }, x + 6);","+      if (this.done) T(this.desync ? 'REPLAY DESYNC' : 'END OF REPLAY', r.W / 2, r.H / 2, this.desync ? '#ff6b6b' : '#ffd36a', { scale: 2, align: 'center' });","+      T('CLICK A CRAFT TO FOLLOW IT', 8, r.H - 34, '#7a8aa8', { font: 'tiny' });","+      SN.glyph.bar(g, [['confirm', this.paused ? 'PLAY' : 'PAUSE'], ['tabL', ''], ['tabR', 'SPEED'], ['camera', 'CAMERA'], ['cancel', 'EXIT']], r.W - 8, r.H - 18, { right: true });","+    });","+  }","+};","+const attractScene = {","+  enter() { SN.attract.start(0); SN.hud.reset(); game.input.consumeAll(); this.t = 0; },","+  exit() { SN.audio.silenceHums(); },","+  update(dt) {","+    this.t += dt; const I = game.input;","+    if (this.t > .3 && SN.attract.anyInput(I)) { I.consumeAll(); SN.attract.idleT = 0; game.go('title', {}, { fade: 0 }); return; }","+    SN.attract.step(dt);","+  },","+  draw(r) { SN.attract.draw(r); }","+};","+const sessionScene = {","+  enter() {","+    const H = SN.hub; SN.hud.reset();","+    tw = R3.trackWorld(H.event.track); race = H.makeRace(tw); R3.attach(tw, race); cfg = { mode: 'hub' };","+    ctls = [new SN.Controls(game.input, 0)]; cams = [new SN.ChaseCam()]; tv = new SN.TVDirector(tw.T, tw.terrain);","+    SN.audio.music(SN.TRACKS[H.event.track].song, { layers: ['pad', 'pad2', 'bass', 'sub'] });","+    if (!H.readyCalled) { H.readyCalled = true; AIHub.ready(); }","+  },","+  update(dt) {","+    const H = SN.hub, I = game.input, W = tw.world;","+    if (H.ended) { if (W) W.step(0); return; }","+    if (!H.started) {","+      H.cardInput(I, game.r);","+      const g0 = race.track.grid[0], fr = race.track.frameAt(g0.s), eye = race.track.point(g0.s + 40 * U, 10 * U * Math.sin(game.real * .2), 9 * U), look = race.track.point(race.track.grid[7].s, 0, 2 * U);","+      if (W) { W.camera.fixed = SN.poseFrom(eye, look, SN.ZUP, 55); W.step(dt); }","+      return;","+    }","+    const c = ctls[0].read(dt); race.setControls(0, c); if (c.camera) cycleCam(0);","+    race.step(dt); H.step(race, dt);","+    if (W) SN.fx.events(race, W); SN.audio.events(race, { radio: false }); SN.hud.events(race); SN.hud.step(dt);","+    const s = race.player; let pose = s.finished ? tv.update(race, dt, { target: s }) : cams[0].update(s, dt, race, { lookBack: ctls[0].out.lookBack });","+    if (W) { W.camera.fixed = pose; W.camera.target = { x: s.P[0], y: s.P[1], z: s.P[2] }; W.step(dt); }","+    SN.audio.humStep(race, s, W, dt, true);","+  },","+  draw(r) {","+    const H = SN.hub;","+    if (tw.world) tw.world.draw(r);","+    if (!H.started) { r.overlay(g => H.drawCard(g, r)); return; }","+    SN.hud.draw(r, race, race.player, null);","+    if (H.ended) r.overlay(g => {","+      UI.panel(g, r.W / 2 - 110, r.H / 2 - 50, 220, 100, '#05040c', .9, '#29c8e8');","+      E.font.title(g, 'ROUND OVER', r.W / 2, r.H / 2 - 42, { scale: 3, colors: ['#ffffff', '#7af0ff'], align: 'center' });","+      const st = (H.endInfo && H.endInfo.standings) || [], names = id => { const p = (H.info.players || []).find(q => q.id === id); return p ? p.name : '?'; };","+      st.slice(0, 4).forEach((grp, k) => E.font.text(g, (k + 1) + '. ' + [].concat(grp).map(names).join(', '), r.W / 2, r.H / 2 - 8 + k * 11, '#ffffff', { align: 'center', outline: '#05040c' }));","+    });","+  }","+};","+","+/* ---- the debug handle (tests, tools/check.mjs) ---- */","+game.debug = {","+  snapshot() {","+    const R = game.sceneName === 'attract' ? SN.attract.race : game.sceneName === 'title' ? titleRace : game.sceneName === 'replay' ? replayScene.R : race;","+    const sh = s => ({ id: s.id, name: s.name, p: Math.round(s.p), s: Math.round(s.s), u: Math.round(s.u), h: Math.round(s.h), v: Math.round(s.speed), kmh: Math.round(s.kmh), energy: Math.round(s.energy * 10) / 10, lap: s.lap, place: s.place, weapon: s.weapon, airborne: !s.grounded, finished: s.finished, elim: s.elim, points: s.points, control: s.control });","+    return { scene: game.sceneName, screen: UI.top() ? UI.top().id : null, focus: UI.top() ? UI.top().focus : null, state: R && R.state, mode: R && R.mode, track: R && R.track.id, cls: R && R.cls, t: R ? +R.t.toFixed(3) : 0,","+      ships: R ? R.ships.map(sh) : [], player: R && R.player ? sh(R.player) : null, hudCallouts: (SN.hud.views[0] || { callouts: [] }).callouts.map(c => c.text), device: game.input.lastDevice, attract: game.sceneName === 'attract', dev: SN.dev.isOpen,","+      story: SN.story.active, season: { medals: SN.save.data.medals, unlocked: SN.save.data.unlocked, gp: SN.save.data.gp }, hub: { active: SN.hub.active, connected: !!SN.hub.info, sent: SN.hub.sent, progressCount: SN.hub.progressCount, started: SN.hub.started, ended: SN.hub.ended },","+      zone: R && R.zone, backend: E.World3D ? E.World3D.backend : 'none', paused: game.paused, splits: game._split ? game._split.vps.length : 1 };","+  },","+  teleport(s, u = 0, v = 0) { if (race) SN.debugTeleport(race, s, u, v); },","+  give(w) { if (race && race.player) race.weapons.give(race.player, w); },","+  setEnergy(x) { if (race && race.player) race.player.energy = x; },","+  finishNow() { if (race) race.endRun(); },","+  events: () => race ? race.events.slice() : [],","+  race: () => race, track: () => race && race.track, tune: SN.Tune, cfg: () => cfg, cams: () => cams, ctls: () => ctls, tw: () => tw","+};","+","+game.start({ scenes: { title: titleScene, front: frontScene, loading: loadingScene, race: raceScene, results: resultsScene, replay: replayScene, attract: attractScene, session: sessionScene },","+  scene: HUBON ? 'session' : 'title', boot });","+if (HUBON) { const g0 = game.go.bind(game); game.booted && game.booted.then && game.booted.then(() => { if (!SN.hub.info && game.sceneName === 'session') g0('title'); }); }"," })();"]}],"originalFile":"// SNIPEOUT HD: the game. new E.Game, the boot, the scenes and game.debug.\n(() => {\nconst E = My3D2dge, SN = globalThis.SN;\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, bg: null, input: SN.INPUT, id: 'snipeout-hd' });\nSN.game = game;\nconst wait3D = () => new Promise((ok, no) => {\n  if (!SN.browser) return ok();\n  const t0 = performance.now();\n  const tick = () => { if (E.World3D) return E.World3D.init(game).then(() => { SN._w3dInit = true; ok(); }, no); if (window.__sn3dFail || performance.now() - t0 > 30000) return no(new Error('The 3D engine could not load (three.js from cdn.jsdelivr.net). Check the connection and reload.')); setTimeout(tick, 50); };\n  tick();\n});\nlet race = null, cam = new SN.ChaseCam(), tw = null;\nconst scenes = {\n  race: {\n    enter() {\n      tw = SN.render.trackWorld('solenne');\n      race = new SN.Race({ track: tw.T, mode: 'race', cls: 'SPARK', laps: 3, seed: 3, entrants: SN.field({ humans: [] }), intro: false });\n      SN.render.attach(tw, race);\n    },\n    update(dt) {\n      race.step(dt);\n      if (tw.world) { SN.fx.events(race, tw.world); tw.world.camera.fixed = cam.update(race.ships[7], dt, race); tw.world.step(dt); }\n    },\n    draw(r) { if (tw.world) tw.world.draw(r); r.overlay(g => E.font.text(g, 'SNIPEOUT HD ' + Math.round(race.ships[7].kmh) + ' KM/H', 8, 8, '#ffffff', { scale: 2 })); }\n  }\n};\ngame.debug = { snapshot: () => ({ scene: game.sceneName, t: race && race.t, ships: race ? race.ships.map(s => [Math.round(s.s), Math.round(s.kmh)]) : [], backend: E.World3D ? E.World3D.backend : 'none', stats: tw && tw.world ? tw.world.stats : null }) };\ngame.start({ scenes, scene: 'race', boot: { title: 'SNIPEOUT HD', steps: [['Waking the 3D engine', wait3D], ['Surveying the circuits', () => { for (const id of SN.TRACK_ORDER) SN.getTrack(id); }], ['Building Port Solenne', () => { SN.render.trackWorld('solenne'); }]] } });\n})();\n","userModified":false},"tool_result_meta":[{"id":"toolu_01YJToqyJbeLTc417uBSmAyZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
