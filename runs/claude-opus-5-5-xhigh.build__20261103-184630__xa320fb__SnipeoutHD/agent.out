le.log('eval:', JSON.stringify(await page.evaluate(v)).slice(0, 2000));\n  else if (k === 'shot') { await page.screenshot({ path: 'tests/out/' + v + '.png' }); console.log('shot', v, ((Date.now() - t0) / 1000).toFixed(1) + 's'); }\n}\nconsole.log(errs.slice(0, 20).join('\\n'));\nawait browser.close();\nEOF\nTMPDIR=$PWD/.tmp timeout 300 node tools/shot.mjs wait:12000 shot:m0a \"eval:({ backend: My3D2dge.World3D && My3D2dge.World3D.backend, snap: My3D2dge.current.debug.snapshot(), err: My3D2dge.current.errors.map(e=>e.message) })\" wait:4000 shot:m0b","description":"Screenshot the bundle in headless Chromium","timeout":320000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":446,"cache_read_input_tokens":552185,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":446},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4110026b-2798-4dbf-ae8a-e81d8e816e30","uuid":"14532547-77fd-44ab-ac42-48f32a201248","timestamp":"2026-11-04T02:27:18.156Z","request_id":"req_011Cgh6bewZcPkKgxEk5Dvbv","wire_tool_inputs":{"toolu_01BpvQ72VYmtcvThd9UP7rgo":{"command":"mkdir -p /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/tests/browser /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/tests/out && cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630 && cat > tools/shot.mjs <<'EOF'\n// Screenshots of the bundle in headless Chromium: node tools/shot.mjs <name> [steps...]\n// steps: wait:ms  key:Code  down:Code  up:C