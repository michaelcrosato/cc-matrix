ol === 'ai' && this.rules.rubberBand && this.humans.length) {\n        const ref = this.humans.reduce((a, b) => a.p > b.p ? a : b), rb = (SN.DIFFICULTY[this.difficulty] || SN.DIFFICULTY.Normal).rb * SN.Tune.T.aiRubberBand;\n        s.topK = 1 + rb * E.clamp((ref.p - s.p) / 32000, -1, 1) * .04;\n      }\n      SN.Ship.step(s, c, dt, this);\n      if (this.rules.weapons) this.weapons.use(s, c, dt);\n    }\n    SN.collide(this.ships, this);\n    this.weapons.step(dt);\n    for (const s of this.ships) this._lapStep(s, dt);\n    this.positions();\n    if (this.rules.step) this.rules.step(this, dt);\n    this._modeStep(dt);\n    this._finishCheck(dt);\n  }\n  _aiControls(s) {\n    const c = SN.AI.controls(s, this, this.rules.aiOpts ? this.rules.aiOpts(s) : {});\n    const f = c.fire; c.firePressed = f && !s._aiFire; c.fireReleased = !f && s._aiFire; s._aiFire = f;\n    return c;\n  }\n  _recordFrame(i, c) {\n    const R = this.recording; if (!R) return;\n    const f = R.frames[i], q = (Math.round(c.steer * 127) & 255) | ((Math.round(c.pitch * 127) & 255) << 8) | ((Math.round(c.brakeL * 255) & 255) << 16) | ((Math.round(c.brakeR * 255) & 255) * 16777216);\n    const bits = (c.thrust ? 1 : 0) | (c.fire ? 2 : 0) | (c.firePressed ? 4 : 0) | (c.fireReleased ? 8 : 0) | (c.absorb ? 16 : 0) | (c.shiftL ? 32 : 0) | (c.shiftR ? 64 : 0) | (c.flick < 0 ? 128 : c.flick > 0 ? 256 : 0);\n    const last = f.length ? f[f.length - 1] : null;\n    if (last && last[0] === q && last[1] === bits) last[2]++; else f.push([q, bits, 1]);\n  }","numLines":60,"startLine":68,"totalLines":384}},"tool_result_meta":[{"id":"toolu_0148jHyajtdbKKrgJnKcm4sV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
