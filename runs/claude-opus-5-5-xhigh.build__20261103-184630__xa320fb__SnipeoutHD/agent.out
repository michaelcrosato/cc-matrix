en / 2, 1.5, h).setTranslation(x, y, z).setRotation({ x: 0, y: 0, z: Math.sin(yaw / 2), w: Math.cos(yaw / 2) }).setFriction(0).setRestitution(.3).setCollisionGroups(GROUPS.level), body); }\n2347:  /** an invisible fixed collider (a tree's trunk, a building's wall drawn your own way): { x, y, z (its base), w, d, h,\n2351:    const body = this.pw.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(o.x, o.y, z).setRotation(o.r ? Z_UP : { x: 0, y: 0, z: Math.sin(yaw / 2), w: Math.cos(yaw / 2) }));\n2429:  /** a box: { x, y, z (its base), w, d, h, color, side (a SIDE look), fixed (it never moves), mass } */\n2432:    const p = this._prop('box', o.x, o.y, z, o.yaw || 0, RAPIER.ColliderDesc.cuboid(w / 2, d / 2, hh / 2), false, o.fixed, o.mass);\n2437:  _prop(kind, x, y, z, yaw, shape, upright = false, fixed = false, mass = .5) {\n2439:    const body = this.pw.createRigidBody((fixed ? RAPIER.RigidBodyDesc.fixed() : RAPIER.RigidBodyDesc.dynamic()).setTranslation(x, y, z).setRotation(rot).setLinearDamping(.3).setAngularDamping(.8));\n2440:    const col = this.pw.createCollider(shape.setDensity(mass).setFriction(.7).setRestitution(.05).setCollisionGroups(fixed ? GROUPS.level : GROUPS.prop), body);\n2486:   *  solid (true or [w, d, h]: a fixed block where it stands, as a door or chest has), data } */\n2493:  /** a thing's block on (a door shut, a chest) or off (open): a fixed collider of its solid size where it stands */\n2498:      t.body = this.pw.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(t.x, t.y, t.z + s[2] / 2).setRotation({ x: 0, y: 0, z: Math.sin(t.yaw / 2), w: Math.cos(t.yaw / 2) }));\n2555:   *  mats, flip, params, solid (default true: a fixed collider from the box map.solid uses; false: bodies pass) } -> its\n2563:      p.body = this.pw.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(b.x, b.y, p.z + hz).setRotation({ x: 0, y: 0, z: Math.sin(a / 2), w: Math.cos(a / 2) }));\n2570:  /** advance the world by dt (the game's fixed step)