0.5 to press), or the D-pad\\n  let lq = KC.quantize(ax[0] || 0, ax[1] || 0);\\n  if (down(12)) lq = 'u'; else if (down(13)) lq = 'd'; else if (down(14)) lq = 'l'; else if (down(15)) lq = 'r';\\n  const px = lq || 'n';\\n  // technique: a press edge of a face button, or of the right stick's 4-way direction\\n  const rq = KC.quantize(ax[2] || 0, ax[3] || 0);\\n  const faces = [[3, 'u'], [0, 'd'], [2, 'l'], [1, 'r']];\\n  let edge = null;\\n  for (const [k, d] of faces) if (down(k) && !prev['f' + k]) edge = edge || d;\\n  for (const [k] of faces) prev['f' + k] = down(k);\\n  if (rq && rq !== prev.rq && !edge) edge = rq;\\n  prev.rq = rq;\\n  const pr = (s) => (s === 'u' || s === 'd') ? s : KC.relDir(s, foeDir);\\n  return { posture: pr(px), tech: edge ? pr(edge) : null };\\n};\\nEOF\\npython3 - <<'EOF'\\np='src/66-kach.js'; s=open(p).read()\\nold=\\\"\\\"\\\"      const iA = K.aiA ? K.aiA.intent(K.b, d) : KC.readControl(game.input, dirA, K.prev);\\n      const iB = K.aiB ? K.aiB.intent(K.a, d) : { posture: 'n', tech: null };\\\"\\\"\\\"\\nassert s.count(old)==1\\ns=s.replace(old,\\\"\\\"\\\"      const iA = K.aiA ? K.aiA.intent(K.b, d) : K.seatIntent(K.aSeat, dirA, K.prevA);\\n      const iB = K.aiB ? K.aiB.intent(K.a, d) : K.seatIntent(K.bSeat, -dirA, K.prevB);\\\"\\\"\\\")\\nold2=\\\"\\\"\\\"    K.aiA = aSeat === 0 ? null : new KC.KarateAI(K.a, seed + 3, { level: KC.DATA.roster[K.ids[aSeat]].ai.level });\\n    K.aiB = bSeat === 0 ? null : new KC.KarateAI(K.b, seed + 5, { level: KC.DATA.roster[K.ids[bSeat]].ai.level });\\\"\\\"\\\"\\nassert s.count(old2)==1\\ns=s.replace(old2,\\\"\\\"\\\"    K.aiA = K.isHuman(aSeat) ? null : new KC.KarateAI(K.a, seed + 3, { level: KC.DATA.roster[K.ids[aSeat]].ai.level });\\n    K.aiB = K.isHuman(bSeat) ? null : new KC.KarateAI(K.b, seed + 5, { level: KC.DATA.roster[K.ids[bSeat]].ai.level });\\\"\\\"\\\")\\nold3=\\\"  const K = { seats: 2,\\\"\\ns=s.replace(old3,\\\"\\\"\\\"  // seat 0: the keyboard (WASD, IJKL); seat 1: the keyboard'