(R) { R.x = rx; R.y = ry; R.z = rz; R.facing = rf; }\n3026\t        for (let i = 0; i < pts.length; i += 4) { pts[i].x = pts[i + 1]; pts[i].y = pts[i + 2]; pts[i].z = pts[i + 3]; }\n3027\t        for (let i = 0; i < arr.length; i += 4) { arr[i][0] = arr[i + 1]; arr[i][1] = arr[i + 2]; arr[i][2] = arr[i + 3]; }\n3028\t      }\n3029\t    }\n3030\t    this._ribbons.hideFrom(nr);\n3031\t    this.stats.culled = this.actors.length - drawn;\n3032\t    return drawn;\n3033\t  },\n3034\t  _drawThings() {\n3035\t    const pen = this.pen, cam = this.camera;\n3036\t    for (const t of this.things) {\n3037\t      if (!t.visible || !cam.sees(t.x, t.y, t.z)) continue;\n3038\t      const draw = THINGS[t.kind]; if (!draw) continue;\n3039\t      pen.at(t.x, t.y, t.z + (t.bob ? (Math.sin(t.t * 2.4) * .5 + .5) * t.bob : 0), t.yaw + t.spin * t.t * TAU, t.size); pen.flash = t.flash > 0;\n3040\t      draw(pen, t, this.time);\n3041\t      if (t.shadow !== false && t.kind !== 'door') shadowAt(this, t.x, t.y, t.z + (t.bob || 0), t.r * .8, 1);\n3042\t    }\n3043\t    pen.at(); pen.flash = false;\n3044\t  },\n3045\t  /** the lock-on's mark (camera.lock): three arrows turning over the target's head and three arcs round its feet */\n3046\t  _reticle() {\n3047\t    const L = this.camera.lockOn, c = this.camera.reticle; if (!L || !c) return;\n3048\t    const k = 1 - (this._al ?? 1), w = L._ip, m = w && k && Math.abs(w[0] - L.x) + Math.abs(w[1] - L.y) < 40 ? k : 0, x = L.x + (m ? (w[0] - L.x) * m : 0), y = L.y + (m ? (w[1] - L.y) * m : 0), z = (L.z || 0) + (m ? (w[2] - (L.z || 0)) * m : 0);\n3049\t    const t = this.game.real || 0, top = z + (L.foot || 10) * 2 + 9 + Math.sin(t * 5) * 1.5, r = (L.r || 5) + 5;\n3050\t    this.pen.at(x, y, top, t * 2.5);\n3051\t    for (let i = 0; i < 3; i++) { const a = i * TAU / 3; this.pen.cone(Math.cos(a) * 5, Math.sin(a) * 5, 5, Math.cos(a) * 2, Math.sin(a) * 2, 0, 1.7, c); }\n3052\t    this.pen.at();\n3053\t    for (let i = 0; i < 3; i++) { const a = -t * 2 + i *