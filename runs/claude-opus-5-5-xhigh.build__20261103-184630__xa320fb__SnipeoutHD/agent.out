e)) {   // it arrived: the threat resolves on its own clock; the blast is spectacle","       pr.alive = false;","       const P = PROJ[pr.kind] || {};","-      if (P.blast) sim.ev({ type: 'explode', at: (pr.land || pr.pos).slice(), r: P.blast, small: true, kind: pr.kind });","+      if (P.blast) sim.ev({ type: 'explode', at: (pr.land || pr.pos).slice(), r: Math.min(18, P.blast), small: true, kind: pr.kind, arrival: true });","     }","   }","   sim.projectiles = sim.projectiles.filter(p => p.alive);"]},{"oldStart":17577,"oldLines":7,"newStart":17577,"newLines":7,"lines":[" meshDef('lift', G => {","   G.box('steel', -20, -20, 0, 20, 20, 3, { top: 'grate' }); G.box('steel-dk', -20, -20, 52, 20, 20, 55);","   for (const [x, y] of [[-20, -20], [20, -20], [-20, 20], [20, 20]]) G.box('steel', x - 1.5, y - 1.5, 3, x + 1.5, y + 1.5, 52);","-  G.box('glass', 19, -20, 14, 20, 20, 52, { solid: false }); G.box('glass', -20, -20, 14, 20, -19, 52, { solid: false }); G.box('glass', -20, 19, 14, 20, 20, 52, { solid: false });","+  G.box('glass', -20, -20, 14, 20, -19, 52, { solid: false }); G.box('glass', -20, 19, 14, 20, 20, 52, { solid: false }); G.box('steel', 19, -20, 14, 20, 20, 16, { solid: false });","   G.box('panel-dark', -2, -16, 3, 10, 16, 16, { top: 'glow-teal' });   // the console (cover)","   G.box('grate', 20, -20, 0, 42, 20, 3, { side: 'steel' }); G.box('steel', 41, -20, 3, 42, 20, 14); G.box('steel', 20, -20, 3, 42, -19, 14); G.box('steel', 20, 19, 3, 42, 20, 14);   // the outer platform"," });"]},{"oldStart":17685,"oldLines":7,"newStart":17685,"newLines":7,"lines":["   draw(R, B, sim) {","     if (B.dead && B.fallT > 3) return;","     R.rig(B.rig, B.rig.x, B.rig.y, B.rig.z, { flash: B.body.flash });","-    if (B.shieldUp && !B.broke) { const off = B.shieldOff > 0 ? 1.4 : 0, a = B.face + off, M = mat34(B.x + Math.cos(a) * 13, B.y + Math.sin(a) * 13, B.z + 2, a, 0, 0, 1.4); R.mesh('hatchshield', M, { flash: B.shield.flash }); }","+    if (B.shieldUp && !B.broke) { c