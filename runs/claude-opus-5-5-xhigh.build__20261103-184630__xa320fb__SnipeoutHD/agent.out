ormance readout (presentation only).\\\\n    const now = (typeof performance !== 'undefined') ? performance.now() : 0;\\\\n    if (this.lastNow) this.frameMs = now - this.lastNow;\\\\n    this.lastNow = now;\\\\\\\"\\\\\\\"\\\\\\\"),\\\\n(\\\\\\\"\\\\\\\"\\\\\\\"        if (TC.Hub.lastSnap) TC.Hub.applySnap(this, TC.Hub.lastSnap.snap);\\\\\\\"\\\\\\\"\\\\\\\",\\\\\\\"\\\\\\\"\\\\\\\"        if (TC.Hub.lastSnap) TC.Hub.applySnap(this, TC.Hub.lastSnap.snap);\\\\n        // Our own cover is predicted here at the same speeds as the sim, so it answers at once.\\\\n        const mine = this.sim.players[TC.Hub.me];\\\\n        const myInput = this.seats[TC.Hub.me] && this.seats[TC.Hub.me].input;\\\\n        if (mine && myInput) {\\\\n          const want = myInput.down('cover') ? 1 : 0;\\\\n          const full = want ? TC.tune.player.coverIn : TC.tune.player.coverOut;\\\\n          const dir = want - mine.c, step = dt / full;\\\\n          mine.c = Math.abs(dir) <= step ? want : mine.c + Math.sign(dir) * step;\\\\n        }\\\\\\\"\\\\\\\"\\\\\\\"),\\\\n])\\\\nprint('ok')\\\\nEOF\\\\nnode tools/build.mjs --html >/dev/null && export TMPDIR=$PWD/.tmp && timeout 290 node tests/run.mjs 2>&1 | tail -3\\\",\\\"description\\\":\\\"Patch engine wheel codes, add perf readout, predict local cover\\\"}},\\\"wire_ingest_context\\\":{\\\"toolu_018Pd3oT6iVybjX583j8EPEr\\\":{\\\"cwd\\\":\\\"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312\\\"}}}\",\"+{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_018Pd3oT6iVybjX583j8EPEr\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"896:  codeLabel(code) {\\\\nengine ok\\\\n---\\\\nok\\\\n126 checks: 126 passed, 0 failed\\\",\\\"is_error\\\":false}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"a4347fe7-6622-4d1f-b2e4-5b62026e02e2\\\",\\\"uuid\\\":\\\"3a5