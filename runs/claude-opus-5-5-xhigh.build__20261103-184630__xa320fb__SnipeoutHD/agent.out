s.navigator; if (!mm || !nav) return false;\\n  const coarse = mm('(any-pointer: coarse)').matches, fine = mm('(any-pointer: fine)').matches, pts = (nav.maxTouchPoints || 0) > 0;\\\"\\\"\\\"\\nassert s.count(old)==1; s=s.replace(old,new)\\ns=s.replace(\\\"\\\"\\\"  let pad = false; try { pad = [...(navigator.getGamepads ? navigator.getGamepads() : [])].some(Boolean); } catch (e) { /* blocked */ }\\\"\\\"\\\",\\\"\\\"\\\"  let pad = false; try { pad = [...(nav.getGamepads ? nav.getGamepads() : [])].some(Boolean); } catch (e) { /* blocked */ }\\\"\\\"\\\")\\nold=\\\"\\\"\\\"T.init = game => {\\n  if (typeof window === 'undefined') return;\\n  T.detect(game);\\n  addEventListener('keydown', () => { if (T.on) { T.keyed = true; T.on = false; } });\\n  addEventListener('gamepadconnected', () => { if (T.on) { T.on = false; T.keyed = true; } });\\n};\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"T.init = game => {\\n  if (typeof globalThis.addEventListener !== 'function') return;\\n  T.detect(game);\\n  globalThis.addEventListener('keydown', () => { if (T.on) { T.keyed = true; T.on = false; } });\\n  globalThis.addEventListener('gamepadconnected', () => { if (T.on) { T.on = false; T.keyed = true; } });\\n};\\\"\\\"\\\"\\nassert s.count(old)==1; s=s.replace(old,new)\\n# T.update: only the settings button (A.title counts the idle time; taps don't count)\\nold=\\\"\\\"\\\"  if (c && c[0] > WP.W / 2 - 70 && c[0] < WP.W / 2 + 70 && c[1] > 170 && c[1] < 200) { game.menu('settings'); return true; }\\n  const sc = game.scene; if (sc) { sc._tIdle = (sc._tIdle || 0) + 1 / 120; if (sc._tIdle > 10) { sc._tIdle = 0; A.start(game); return true; } }\\n  return false;\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"  if (c && c[0] > WP.W / 2 - 70 && c[0] < WP.W / 2 + 70 && c[1] > 170 && c[1] < 200) { game.menu('settings'); return true; }\\n  return false;\\\"\\\"\\\"\\nassert s.count(old)==1; s=s.replace(old,new)\\nopen(p,'w').write(s)\\np='tests/run.mjs'; s=open(p).read()\\ns=s.replace(\\\"\\\"\\\"  walk(WP.TEXT, 'TEXT'); ok('core'\\\"\\\"\\\",\\\"\\\"\\\"  walk(Object.assign({}, WP.TEXT, { about: WP.TEXT.about.map(pg => ({ title: pg.title, lines: pg.lines.map(l => l[1]) })) }), 'TEXT'); ok('core'\\\"\\\"\\\")\\nold=\\\"\\\"\\\"  run(sim, 1.2, { x: 240, y: 20, fire: true }); run(sim, .05, { x: 240, y: 20 });\\n  ok('weapon', 'auto-reload when dry, 1.0 s', p.reloadT > 0 || p.mag === 30); run(sim, 1.3, { x: 240, y: 20 });\\n  ok('weapon', 'the reload loads a full magazine', p.mag === 30 && p.spares.length === 4, p.mag + ' / ' + p.spares.length);\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"  run(sim, 19 / 11 + .02, { x: 240, y: 20, fire: true }); ok('weapon', 'the magazine runs dry', p.mag === 0, p.mag);\\n  run(sim, .2, { x: 240, y: 20 }); ok('weapon', 'auto-reload .12 s after running dry', p.reloadT > 0, p.reloadT);\\n  run(sim, .75, { x: 240, y: 20 }); ok('weapon', 'the reload takes 1.0 s', p.reloadT > 0 && p.mag === 0, p.reloadT);\\n  run(sim, .2, { x: 240, y: 20 }); ok('weapon', 'the reload loads a full magazine', p.mag === 30 && p.spares.length === 4, p.mag + ' / ' + p.spares.length);\\\"\\\"\\\"\\nassert s.count(old)==1; s=s.replace(old,new)\\ns=s.replace(\\\"\\\"\\\"  const ev4 = run(sim, dt * 2, { x: 240, y: 230, fire: true });\\\"\\\"\\\",\\\"\\\"\\\"  const ev4 = run(sim, dt * 2, { x: 40, y: 226, fire: true });\\\"\\\"\\\")\\ns=s.replace(\\\"\\\"\\\"const spawnsAt = k => { game.settings.set('t_spawnDensity', k); WP.Flow.newRun({}); const s = new WP.Sim({ stage: 'op1', seed: 1, run: WP.Flow.run }); s.d = 39; for (let i = 0; i < 120 * 4; i++) s.step(dt, {}); return s.drain().filter(e => e.k === 'spawn' && e.type === 'rifleman').length; };\\\"\\\"\\\",\\\"\\\"\\\"const spawnsAt = k => { game.settings.set('t_spawnDensity', k); WP.Flow.newRun({}); const s = new WP.Sim({ stage: 'op1', seed: 1, run: WP.Flow.run, d: 299 }); for (let i = 0; i < 120 * 4; i++) s.step(dt, {}); return s.drain().filter(e => e.k === 'spawn' && e.type === 'rifleman').length; };\\\"\\\"\\\")\\ns=s.replace(\\\"\\\"\\\"  WP.Dev.jump(game, 'op3', 'b10'); game.advance(.4);\\\"\\\"\\\",\\\"\\\"\\\"  WP.Dev.jump(game, 'op3', 'b10'); game.advance(1.5);\\\"\\\"\\\")\\ns=s.replace(\\\"\\\"\\\"for (let i = 0; i < 40; i++) s.step(dt, { 0: { x: 240, y: 20, fire: true } }); ok('dev', 'Infinite ammo holds', s.players[0].mag > 20, s.players[0].mag);\\\"\\\"\\\",\\\"\\\"\\\"const sh0 = s.players[0].shots; for (let i = 0; i < 40; i++) s.step(dt, { 0: { x: 240, y: 20, fire: true } }); ok('dev', 'Infinite ammo holds', s.players[0].mag === 1 && s.players[0].shots > sh0 + 3, s.players[0].mag);\\\"\\\"\\\")\\ns=s.replace(\\\"\\\"\\\"  WP.Store.cleared('op1'); game.go('title'); game.advance(.3);\\\"\\\"\\\",\\\"\\\"\\\"  WP.Store.cleared('op1'); game.go('about'); game.advance(.3); game.go('title'); game.advance(.3);\\\"\\\"\\\")\\ns=s.replace(\\\"\\\"\\\"  const L = load({ window: { matchMedia: mm, navigator: { maxTouchPoints: 5, getGamepads: () => [] }, window: {}, addEventListener: (k, f) => { (listeners[k] = listeners[k] || []).push(f); } } });\\\"\\\"\\\",\\\"\\\"\\\"  const L = load({ window: { matchMedia: mm, navigator: { maxTouchPoints: 5, getGamepads: () => [] }, addEventListener: (k, f) => { (listeners[k] = listeners[k] || []).push(f); } } });\\\"\\\"\\\")\\nold=\\\"\\\"\\\"  const c = sim.spawn('rifleman', { lx: 90, dz: 150, beh: 'chase', target: h.id }); run(sim, 2.5);\\n  ok('friendlies', 'a chaser grabs a hostage', !!h.grabbedBy || h.lost);\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"  const c = sim.spawn('rifleman', { lx: 90, dz: 150, beh: 'chase', target: h.id }); for (let i = 0; i < 120 * 8 && !h.grabbedBy && !h.lost; i++) run(sim, dt);\\n  ok('friendlies', 'a chaser grabs a hostage', !!h.grabbedBy || h.lost);\\\"\\\"\\\"\\nassert s.count(old)==1; s=s.replace(old,new)\\nopen(p,'w').write(s)\\nEOF\\ncat > .tmp/probe.mjs <<'EOF'\\nimport { load } from '../tests/lib.mjs';\\nconst { WP, game } = load(); const dt = 1 / 120;\\nWP.Flow.newRun({}); const sim = new WP.Sim({ stage: 'range', seed: 3, players: [{ p