[k - 1].p + 1) posBad++; }\n      if (R.state === 'racing' && R.ships.every(s => s.finished || s.dnf)) R.seal();\n    }\n    return { R, rescues, posBad, n };\n  };\n  for (const id of SN.TRACK_ORDER) for (const cls of SN.CLASS_ORDER) for (const seed of [1, 2]) {\n    const { R, rescues, posBad } = runRace(id, cls, seed, { rules: { weapons: false } });\n    const tag = id + ' ' + cls + ' seed ' + seed, ideal = R.track.idealLap(cls), laps = R.ships.map(s => s.laps[0]).filter(x => x > 0);\n    T.check(tag + ': every craft finishes', R.state === 'results' && R.ships.every(s => s.finished && !s.estimated), R.ships.filter(s => !s.finished || s.estimated).map(s => s.name));\n    T.check(tag + ': at most 1 rescue a craft', Object.values(rescues).every(v => v <= 1), rescues);\n    // lap 1 is a standing start: the ideal line's flying lap plus the launch\n    T.check(tag + ': lap times within 25% of the ideal line', laps.length >= 7 && laps.every(l => l > ideal * .9 && l < ideal * 1.25 + 3), { ideal: ideal.toFixed(1), laps: laps.map(l => l.toFixed(1)) });\n    T.check(tag + ': positions follow progress', posBad === 0, posBad);\n  }\n  // weapons on: an 8-AI race of 3 laps with every rule\n  { const { R } = runRace('meridian', 'FLARE', 5, { laps: 2 }); T.check('a weapons race finishes and seals', R.state === 'results' && R.results().length === 8, R.state); }\n  // determinism, and the replay\n  { const a = runRace('karakum', 'FLARE', 9, { laps: 1, humans: [{ pilot: 'vale', team: 'kestrel' }] }), b = runRace('karakum', 'FLARE', 9, { laps: 1, humans: [{ pilot: 'vale', team: 'kestrel' }] });\n    T.check('the same seed gives the same race', a.R.hash() === b.R.hash(), [a.R.hash(), b.R.hash()]);\n    const v = SN.Replay.verify(a.R.recording); T.check('a replay re-sim gives the recorded hash', v.ok, [v.hash, v.want]); }\n  // wrong way, the final lap\n  { const Tr = SN.getTrack('solenne'), R = new SN.Race({ track: Tr, mode: 'race', cls: 'SPARK', laps: 2, seed: 1, entrants: [{ pilot: 'vale', team: 'kestrel', control: 'human', pi: 0 }], intro: false, flyingStart: true, rules: { weapons: false }, record: false });\n    const s = R.player; s.putOn(Tr, 1000 * U, 0, 0); s.F = s.F.map(v => -v); s.R = s.R.map(v => -v); let wrong = false;\n    for (let k = 0; k < 120 * 4; k++) { R.setControls(0, Object.assign(SN.Controls.blank(), { thrust: 1 })); R.step(dt); if (R.events.some(e => e.t === 'wrongway')) wrong = true; }\n    T.check('driving the wrong way is called', wrong);\n    const R2 = new SN.Race({ track: Tr, mode: 'race', cls: 'STORM', laps: 2, seed: 2, entrants: [{ pilot: 'vale', team: 'kestrel', control: 'human', pi: 0 }], intro: false, rules: { weapons: false }, record: false });\n    let fin = false, last = false; for (let k = 0; k < 120 * 120 && !fin; k++) { R2.setControls(0, SN.AI.controls(R2.player, R2, { skill: 1, brain: 'bot' })); R2.step(dt); for (const e of R2.events) { if (e.t === 'finallap') last = true; if (e.t === 'finish') fin = true; } }\n    T.check('the final lap is called, then the finish', last && fin, { last, fin }); }\n  // the field: every team, the rival, the teammate, the player last\n  { const f = SN.field({ humans: [{ pilot: 'vale', team: 'kestrel' }] }); const teams = new Set(f.map(e => e.team));\n    T.check('the field has every team', teams.size === 6, [...teams]); T.check('the rival races', f.some(e => e.pilot === 'kaizero')); T.check('the teammate races', f.some(e => e.pilot === 'brekke')); T.check('the player starts last', f[f.length - 1].control === 'human'); }\n  { const f = SN.field({ humans: [{ pilot: 'kaizero', team: 'nullset' }] }); T.check('NULL//SET\\'s rival is Luca Ferrante', f.some(e => e.pilot === 'ferrante')); }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01SzrGKuSDphRCfRBWrMHcVb","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh8w3DGKKTCTDXbsBEtV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LpWdDenjU3vyfoorPRTzdq","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/tests/node/weapons.mjs","content":"// weapons: each of the ten in a fixed two-craft setup (a shooter behind a target on a straight), the warnings, bulwark,\n// absorb, the pickup roll by position, elimination (DNF in a race, respawn in Snipeout), and AI use across races.\nimport { load } from '../lib/vm.mjs';\nexport async function run(T) {\n  const { SN, game } = load({ quiet: true }); await game.booted;\n  const U = 16, dt = 1 / 120, Tr = SN.getTrack('solenne'), C = o => Object.assign(SN.Controls.blank(), o);\n  const setup = (gap = 500, du = 0, mode = 'race') => {\n    const R = new SN.Race({ track: Tr, mode, cls: 'SPARK', laps: 9, seed: 4, entrants: [{ pilot: 'vale', team: 'kestrel', control: 'human', pi: 0 }, { pilot: 'okafor', team: 'hammerhead', control: 'ai' }], intro: false, flyingStart: true, record: false, rules: { rubberBand: false } });\n    const a = R.ships[0], b = R.ships[1]; a.putOn(Tr, 60 * U, 0, 1000); b.putOn(Tr, 60 * U + gap, du, 1000); a.p = b.p - gap;\n    R.ships[1].control = 'dummy';   // the target holds its line at a steady speed\n    return { R, a, b };\n  };\n  const steps = (R, n, c, bc) => { for (let k = 0; k < n; k++) { R.setControls(0, typeof c === 'function' ? c(k) : c); const b = R.ships[1]; b.V = b.F.map(v => v * 1000); R.step(dt); } };\n  // a 'dummy' control: the race asks the AI for anything not human; make the target fly straight and steady\n  const ai = SN.AI.controls; SN.AI.controls = (s, R, o) => s.control === 'dummy' ? C({ thrust: 1 }) : ai(s, R, o);\n  const fireTest = (id, o = {}) => {\n    const { R, a, b } = setup(o.gap || 500, o.du || 0); R.weapons.give(a, id); const e0 = b.energy;\n    const hits = []; let lockSeen = false, warn = false;\n    for (let k = 0; k < (o.n || 240); k++) {\n      const c = o.ctl ? o.ctl(k, a) : C({ thrust: 1, firePressed: k === 2, fire: k >= 2 && k < 4 });\n      R.setControls(0, c); b.V = b.F.map(v => v * 1000); R.step(dt);\n      for (const e of R.events) { if (e.t === 'hit' && e.ship === b) hits.push(e); if (e.t === 'lock' && e.target === b) lockSeen = true; }\n      if (b.lockedBy && R.clock - b.lockedBy.t < .1) warn = true;\n    }\n    return { R, a, b, dmg: e0 - b.energy, hits, lockSeen, warn };\n  };\n  { const r = fireTest('swarm'); T.check('SWARM hits for about 10 a rocket', r.hits.length >= 1 && r.dmg >= 8, r.dmg); }\n  { const r = fireTest('seeker', { gap: 900, n: 420, ctl: (k, a) => C({ thrust: 1, firePressed: k === 120, fire: k === 120 }) }); T.check('SEEKER locks on (the target is warned)', r.lockSeen && r.warn, r); T.check('SEEKER hits for about 24', r.dmg > 20, r.dmg); }\n  { const { R, a, b } = setup(-400); R.weapons.give(a, 'mine'); const e0 = b.energy; steps(R, 3, C({ thrust: 1, firePressed: true, fire: true })); steps(R, 360, C({ thrust: 0, brakeL: 1, brakeR: 1 })); T.check('MINEFIELD drops five mines', R.weapons.mines.length + R.events.filter(e => e.t === 'boom').length >= 1, R.weapons.mines.length); }\n  { const r = fireTest('cannon', { gap: 400, n: 300, ctl: k => C({ thrust: 1, fire: k >= 2 && k < 260, firePressed: k === 2 }) }); T.check('CANNON streams bolts that hit', r.hits.length >= 5, r.hits.length); }\n  { const r = fireTest('rail', { gap: 1200, n: 200, ctl: k => C({ thrust: 1, fire: k < 110, fireReleased: k === 110 }) }); T.check('RAILSHOT charged and released hits within its aim', r.hits.some(e => e.weapon === 'rail'), r.dmg); }\n  { const r = fireTest('rail', { gap: 1200, du: 180, n: 200, ctl: k => C({ thrust: 1, fire: k < 110, fireReleased: k === 110 }) }); T.check('RAILSHOT misses outside its aim', !r.hits.some(e => e.weapon === 'rail'), r.dmg); }\n  { const r = fireTest('tremor', { gap: 600 }); T.check('TREMOR hits a grounded craft', r.hits.some(e => e.weapon === 'tremor'), r.dmg); }\n  { const { R, a, b } = setup(600); R.weapons.give(a, 'tremor'); b.grounded = false; b.P[2] += 800; b.V[2] = 0; let dodge = false, hit = false; for (let k = 0; k < 160; k++) { R.setControls(0, C({ thrust: 1, firePressed: k === 1, fire: k === 1 })); R.step(dt); for (const e of R.events) { if (e.t === 'dodge' && e.ship === b) dodge = true; if (e.t === 'hit' && e.ship === b && e.weapon === 'tremor') hit = true; } } T.check('TREMOR misses an airborne craft', dodge && !hit, { dodge, hit }); }\n  { const { R, a, b } = setup(500); R.weapons.give(b, 'bulwark'); R.weapons.fire(b, 'bulwark'); R.weapons.give(a, 'swarm'); const e0 = b.energy; steps(R, 200, k => C({ thrust: 1, firePressed: k === 2, fire: k === 2 })); T.check('BULWARK blocks everything', b.energy >= e0 - .001, e0 - b.energy); }\n  { const { R, a } = setup(500); R.weapons.give(a, 'autopilot'); steps(R, 3, C({ firePressed: true, fire: true })); T.check('AUTOPILOT flies the craft for 5 s', a.autoT > 4, a.autoT); const s0 = a.speed; steps(R, 240, C({})); T.check('…keeping it at speed', a.speed > s0 * .8, a.speed); }\n  { const { R, a } = setup(500); R.weapons.give(a, 'nitro'); steps(R, 3, C({ thrust: 1, firePressed: true, fire: true })); T.check('NITRO boosts', a.boostT > 2 && a.boostMul >= 1.35, [a.boostT, a.boostMul]); }\n  { const { R, a, b } = setup(600); a.energy = 50; R.weapons.give(a, 'siphon'); const eb = b.energy; steps(R, 300, k => C({ thrust: 1, firePressed: k === 2, fire: k === 2 })); T.check('SIPHON drains the target into the user', b.energy < eb - 10 && a.energy > 60, [a.energy, b.energy]); }\n  { const { R, a } = setup(); a.energy = 50; R.weapons.give(a, 'rail'); steps(R, 3, C({ absorb: true })); T.check('absorb turns the weapon into shield', a.energy >= 50 + 27 && !a.weapon, a.energy); }\n  // pickups by position: the leader gets more mines and shields, the back more tremors and autopilots\n  { const { R, a } = setup(); const cnt = place => { a.place = place; const c = {}; for (let k = 0; k < 600; k++) { const w = R.weapons.roll(a); c[w] = (c[w] || 0) + 1; } return c; }; const f = cnt(1), b = cnt(8);\n    T.check('pickups favour defence at the front', (f.mine || 0) > (b.mine || 0) && (f.tremor || 0) === 0, f); T.check('pickups favour attack at the back', (b.tremor || 0) > 0 && (b.autopilot || 0) > 0, b); }\n  // elimination: DNF in a race, a respawn in Snipeout\n  { const { R, b } = setup(); b.energy = 1; SN.Ship.damage(b, 50, 'test', null, R); T.check('at zero energy: eliminated (DNF in a race)', b.elim && b.dnf, b); }\n  { const { R, a, b } = setup(500, 0, 'snipeout'); b.energy = 1; R.weapons.give(a, 'swarm'); steps(R, 300, k => C({ thrust: 1, firePressed: k === 2, fire: k === 2 })); T.check('Snipeout: an elimination scores 3 + the hit', a.points >= 4, a.points); steps(R, 480, C({ thrust: 1 })); T.check('Snipeout: the eliminated craft respawns', !b.elim && b.energy === 100 || b.invT >= 0 && !b.elim, b); }\n  SN.AI.controls = ai;\n  // the AI uses every weapon across four seeded races\n  { const used = new Set();\n    for (const id of SN.TRACK_ORDER) { const R = new SN.Race({ track: SN.getTrack(id), mode: 'race', cls: 'FLARE', laps: 2, seed: 11, entrants: SN.field({ humans: [] }), intro: false, record: false }); let n = 0; while (R.state !== 'results' && n < 120 * 200) { R.step(dt); n++; for (const e of R.events) if (e.t === 'fire') used.add(e.weapon); if (R.state === 'racing' && R.ships.every(s => s.finished || s.dnf)) R.seal(); } }\n    T.check('the AI fires all ten weapons across four races', used.size === 10, [...used]); }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1625,"cache_read_input_tokens":751439,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1625},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4110026b-2798-4dbf-ae8a-e81d8e816e30","uuid":"ce3b325a-ef9c-4d6d-881a-af25eac6fdc1","timestamp":"2026-11-04T02:58:30.977Z","request_id":"req_011Cgh8w2qTLKU5PtyJWtpav","wire_tool_inputs":{"toolu_01LpWdDenjU3vyfoorPRTzdq":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/tests/node/weapons.mjs","content":"// weapons: each of the ten in a fixed two-craft setup (a shooter behind a target on a straight), the warnings, bulwark,\n// absorb, the pickup roll by position, elimination (DNF in a race, respawn in Snipeout), and AI use across races.\nimport { load } from '../lib/vm.mjs';\nexport async function run(T) {\n  const { SN, game } = load({ quiet: true }); await game.booted;\n  const U = 16, dt = 1 / 120, Tr = SN.getTrack('solenne'), C = o => Object.assign(SN.Controls.blank(), o);\n  const setup = (gap = 500, du = 0, mode = 'race') => {\n    const R = new SN.Race({ track: Tr, mode, cls: 'SPARK', laps: 9, seed: 4, entrants: [{ pilot: 'vale', team: 'kestrel', control: 'human', pi: 0 }, { pilot: 'okafor', team: 'hammerhead', control: 'ai' }], intro: false, flyingStart: true, record: false, rules: { rubberBand: false } });\n    const a = R.ships[0], b = R.ships[1]; a.putOn(Tr, 60 * U, 0, 1000); b.putOn(Tr, 60 * U + gap, du, 1000); a.p = b.p - gap;\n    R.ships[1].control = 'dummy';   // the target holds its line at a steady speed\n    return { R, a, b };\n  };\n  const steps = (R, n, c, bc) => { for (let k = 0; k < n; k++) { R.setControls(0, typeof c === 'function' ? c(k) : c); const b = R.ships[1]; b.V = b.F.map(v => v * 1000); R.step(dt); } };\n  // a 'dummy' control: the race asks the AI for anything not human; make the target fly straight and steady\n  const ai = SN.AI.controls; SN.AI.controls = (s, R, o) => s.control === 'dummy' ? C({ thrust: 1 }) : ai(s, R, o);\n  const fireTest = (id, o = {}) => {\n    const { R, a, b } = setup(o.gap || 500, o.du || 0); R.weapons.give(a, id); const e0 = b.energy;\n    const hits = []; let lockSeen = false, warn = false;\n    for (let k = 0; k < (o.n || 240); k++) {\n      const c = o.ctl ? o.ctl(k, a) : C({ thrust: 1, firePressed: k === 2, fire: k >= 2 && k < 4 });\n      R.setControls(0, c); b.V = b.F.map(v => v * 1000); R.step(dt);\n      for (const e of R.events) { if (e.t === 'hit' && e.ship === b) hits.push(e); if (e.t === 'lock' && e.target === b) lockSeen = true; }\n      if (b.lockedBy && R.clock - b.lockedBy.t < .1) warn = true;\n    }\n    return { R, a, b, dmg: e0 - b.energy, hits, lockSeen, warn };\n  };\n  { const r = fireTest('swarm'); T.check('SWARM hits for about 10 a rocket', r.hits.length >= 1 && r.dmg >= 8, r.dmg); }\n  { const r = fireTest('seeker', { gap: 900, n: 420, ctl: (k, a) => C({ thrust: 1, firePressed: k === 120, fire: k === 120 }) }); T.check('SEEKER locks on (the target is warned)', r.lockSeen && r.warn, r); T.check('SEEKER hits for about 24', r.dmg > 20, r.dmg); }\n  { const { R, a, b } = setup(-400); R.weapons.give(a, 'mine'); const e0 = b.energy; steps(R, 3, C({ thrust: 1, firePressed: true, fire: true })); steps(R, 360, C({ thrust: 0, brakeL: 1, brakeR: 1 })); T.check('MINEFIELD drops five mines', R.weapons.mines.length + R.events.filter(e => e.t === 'boom').length >= 1, R.weapons.mines.length); }\n  { const r = fireTest('cannon', { gap: 400, n: 300, ctl: k => C({ thrust: 1, fire: k >= 2 && k < 260, firePressed: k === 2 }) }); T.check('CANNON streams bolts that hit', r.hits.length >= 5, r.hits.length); }\n  { const r = fireTest('rail', { gap: 1200, n: 200, ctl: k => C({ thrust: 1, fire: k < 110, fireReleased: k === 110 }) }); T.check('RAILSHOT charged and released hits within its aim', r.hits.some(e => e.weapon === 'rail'), r.dmg); }\n  { const r = fireTest('rail', { gap: 1200, du: 180, n: 200, ctl: k => C({ thrust: 1, fire: k < 110, fireReleased: k === 110 }) }); T.check('RAILSHOT misses outside its aim', !r.hits.some(e => e.weapon === 'rail'), r.dmg); }\n  { const r = fireTest('tremor', { gap: 600 }); T.check('TREMOR hits a grounded craft', r.hits.some(e => e.weapon === 'tremor'), r.dmg); }\n  { const { R, a, b } = setup(600); R.weapons.give(a, 'tremor'); b.grounded = false; b.P[2] += 800; b.V[2] = 0; let dodge = false, hit = false; for (let k = 0; k < 160; k++) { R.setControls(0, C({ thrust: 1, firePressed: k === 1, fire: k === 1 })); R.step(dt); for (const e of R.events) { if (e.t === 'dodge' && e.ship === b) dodge = true; if (e.t === 'hit' && e.ship === b && e.weapon === 'tremor') hit = true; } } T.check('TREMOR misses an airborne craft', dodge && !hit, { dodge, hit }); }\n  { const { R, a, b } = setup(500); R.weapons.give(b, 'bulwark'); R.weapons.fire(b, 'bulwark'); R.weapons.give(a, 'swarm'); const e0 = b.energy; steps(R, 200, k => C({ thrust: 1, firePressed: k === 2, fire: k === 2 })); T.check('BULWARK blocks everything', b.energy >= e0 - .001, e0 - b.energy); }\n  { const { R, a } = setup(500); R.weapons.give(a, 'autopilot'); steps(R, 3, C({ firePressed: true, fire: true })); T.check('AUTOPILOT flies the craft for 5 s', a.autoT > 4, a.autoT); const s0 = a.speed; steps(R, 240, C({})); T.check('…keeping it at speed', a.speed > s0 * .8, a.speed); }\n  { const { R, a } = setup(500); R.weapons.give(a, 'nitro'); steps(R, 3, C({ thrust: 1, firePressed: true, fire: true })); T.check('NITRO boosts', a.boostT > 2 && a.boostMul >= 1.35, [a.boostT, a.boostMul]); }\n  { const { R, a, b } = setup(600); a.energy = 50; R.weapons.give(a, 'siphon'); const eb = b.energy; steps(R, 300, k => C({ thrust: 1, firePressed: k === 2, fire: k === 2 })); T.check('SIPHON drains the target into the user', b.energy < eb - 10 && a.energy > 60, [a.energy, b.energy]); }\n  { const { R, a } = setup(); a.energy = 50; R.weapons.give(a, 'rail'); steps(R, 3, C({ absorb: true })); T.check('absorb turns the weapon into shield', a.energy >= 50 + 27 && !a.weapon, a.energy); }\n  // pickups by position: the leader gets more mines and shields, the back more tremors and autopilots\n  { const { R, a } = setup(); const cnt = place => { a.place = place; const c = {}; for (let k = 0; k < 600; k++) { const w = R.weapons.roll(a); c[w] = (c[w] || 0) + 1; } return c; }; const f = cnt(1), b = cnt(8);\n    T.check('pickups favour defence at the front', (f.mine || 0) > (b.mine || 0) && (f.tremor || 0) === 0, f); T.check('pickups favour attack at the back', (b.tremor || 0) > 0 && (b.autopilot || 0) > 0, b); }\n  // elimination: DNF in a race, a respawn in Snipeout\n  { const { R, b } = setup(); b.energy = 1; SN.Ship.damage(b, 50, 'test', null, R); T.check('at zero energy: eliminated (DNF in a race)', b.elim && b.dnf, b); }\n  { const { R, a, b } = setup(500, 0, 'snipeout'); b.energy = 1; R.weapons.give(a, 'swarm'); steps(R, 300, k => C({ thrust: 1, firePressed: k === 2, fire: k === 2 })); T.check('Snipeout: an elimination scores 3 + the hit', a.points >= 4, a.points); steps(R, 480, C({ thrust: 1 })); T.check('Snipeout: the eliminated craft respawns', !b.elim && b.energy === 100 || b.invT >= 0 && !b.elim, b); }\n  SN.AI.controls = ai;\n  // the AI uses every weapon across four seeded races\n  { const used = new Set();\n    for (const id of SN.TRACK_ORDER) { const R = new SN.Race({ track: SN.getTrack(id), mode: 'race', cls: 'FLARE', laps: 2, seed: 11, entrants: SN.field({ humans: [] }), intro: false, record: false }); let n = 0; while (R.state !== 'results' && n < 120 * 200) { R.step(dt); n++; for (const e of R.events) if (e.t === 'fire') used.add(e.weapon); if (R.state === 'racing' && R.ships.every(s => s.finished || s.dnf)) R.seal(); } }\n    T.check('the AI fires all ten weapons across four races', used.size === 10, [...used]); }\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LpWdDenjU3vyfoorPRTzdq","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/tests/node/weapons.mjs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"4110026b-2798-4dbf-ae8a-e81d8e816e30","uuid":"c5b237a2-9b29-4bc4-b0ca-1599e8dc6046","timestamp":"2026-11-04T02:58:30.994Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/tests/node/weapons.mjs","content":"// weapons: each of the ten in a fixed two-craft setup (a shooter behind a target on a straight), the warnings, bulwark,\n// absorb, the pickup roll by position, elimination (DNF in a race, respawn in Snipeout), and AI use across races.\nimport { load } from '../lib/vm.mjs';\nexport async function run(T) {\n  const { SN, game } = load({ quiet: true }); await game.booted;\n  const U = 16, dt = 1 / 120, Tr = SN.getTrack('solenne'), C = o => Object.assign(SN.Controls.blank(), o);\n  const setup = (gap = 500, du = 0, mode = 'race') => {\n    const R = new SN.Race({ track: Tr, mode, cls: 'SPARK', laps: 9, seed: 4, entrants: [{ pilot: 'vale', team: 'kestrel', control: 'human', pi: 0 }, { pilot: 'okafor', team: 'hammerhead', control: 'ai' }], intro: false, flyingStart: true, record: false, rules: { rubberBand: false } });\n    const a = R.ships[0], b = R.ships[1]; a.putOn(Tr, 60 * U, 0, 1000); b.putOn(Tr, 60 * U + gap, du, 1000); a.p = b.p - gap;\n    R.ships[1].control = 'dummy';   // the target holds its line at a steady speed\n    return { R, a, b };\n  };\n  const steps = (R, n, c, bc) => { for (let k = 0; k < n; k++) { R.setControls(0, typeof c === 'function' ? c(k) : c); const b = R.ships[1]; b.V = b.F.map(v => v * 1000); R.step(dt); } };\n  // a 'dummy' control: the race asks the AI for anything not human; make the target fly straight and steady\n  const ai = SN.AI.controls; SN.AI.controls = (s, R, o) => s.control === 'dummy' ? C({ thrust: 1 }) : ai(s, R, o);\n  const fireTest = (id, o = {}) => {\n    const { R, a, b } = setup(o.gap || 500, o.du || 0); R.weapons.give(a, id); const e0 = b.energy;\n    const hits = []; let lockSeen = false, warn = false;\n    for (let k = 0; k < (o.n || 240); k++) {\n      const c = o.ctl ? o.ctl(k, a) : C({ thrust: 1, firePressed: k === 2, fire: k >= 2 && k < 4 });\n      R.setControls(0, c); b.V = b.F.map(v => v * 1000); R.step(dt);\n      for (const e of R.events) { if (e.t === 'hit' && e.ship === b) hits.push(e); if (e.t === 'lock' && e.target === b) lockSeen = true; }\n      if (b.lockedBy && R.clock - b.lockedBy.t < .1) warn = true;\n    }\n    return { R, a, b, dmg: e0 - b.energy, hits, lockSeen, warn };\n  };\n  { const r = fireTest('swarm'); T.check('SWARM hits for about 10 a rocket', r.hits.length >= 1 && r.dmg >= 8, r.dmg); }\n  { const r = fireTest('seeker', { gap: 900, n: 420, ctl: (k, a) => C({ thrust: 1, firePressed: k === 120, fire: k === 120 }) }); T.check('SEEKER locks on (the target is warned)', r.lockSeen && r.warn, r); T.check('SEEKER hits for about 24', r.dmg > 20, r.dmg); }\n  { const { R, a, b } = setup(-400); R.weapons.give(a, 'mine'); const e0 = b.energy; steps(R, 3, C({ thrust: 1, firePressed: true, fire: true })); steps(R, 360, C({ thrust: 0, brakeL: 1, brakeR: 1 })); T.check('MINEFIELD drops five mines', R.weapons.mines.length + R.events.filter(e => e.t === 'boom').length >= 1, R.weapons.mines.length); }\n  { const r = fireTest('cannon', { gap: 400, n: 300, ctl: k => C({ thrust: 1, fire: k >= 2 && k < 260, firePressed: k === 2 }) }); T.check('CANNON streams bolts that hit', r.hits.length >= 5, r.hits.length); }\n  { const r = fireTest('rail', { gap: 1200, n: 200, ctl: k => C({ thrust: 1, fire: k < 110, fireReleased: k === 110 }) }); T.check('RAILSHOT charged and released hits within its aim', r.hits.some(e => e.weapon === 'rail'), r.dmg); }\n  { const r = fireTest('rail', { gap: 1200, du: 180, n: 200, ctl: k => C({ thrust: 1, fire: k < 110, fireReleased: k === 110 }) }); T.check('RAILSHOT misses outside its aim', !r.hits.some(e => e.weapon === 'rail'), r.dmg); }\n  { const r = fireTest('tremor', { gap: 600 }); T.check('TREMOR hits a grounded craft', r.hits.some(e => e.weapon === 'tremor'), r.dmg); }\n  { const { R, a, b } = setup(600); R.weapons.give(a, 'tremor'); b.grounded = false; b.P[2] += 800; b.V[2] = 0; let dodge = false, hit = false; for (let k = 0; k < 160; k++) { R.setControls(0, C({ thrust: 1, firePressed: k === 1, fire: k === 1 })); R.step(dt); for (const e of R.events) { if (e.t === 'dodge' && e.ship === b) dodge = true; if (e.t === 'hit' && e.ship === b && e.weapon === 'tremor') hit = true; } } T.check('TREMOR misses an airborne craft', dodge && !hit, { dodge, hit }); }\n  { const { R, a, b } = setup(500); R.weapons.give(b, 'bulwark'); R.weapons.fire(b, 'bulwark'); R.weapons.give(a, 'swarm'); const e0 = b.energy; steps(R, 200, k => C({ thrust: 1, firePressed: k === 2, fire: k === 2 })); T.check('BULWARK blocks everything', b.energy >= e0 - .001, e0 - b.energy); }\n  { const { R, a } = setup(500); R.weapons.give(a, 'autopilot'); steps(R, 3, C({ firePressed: true, fire: true })); T.check('AUTOPILOT flies the craft for 5 s', a.autoT > 4, a.autoT); const s0 = a.speed; steps(R, 240, C({})); T.check('…keeping it at speed', a.speed > s0 * .8, a.speed); }\n  { const { R, a } = setup(500); R.weapons.give(a, 'nitro'); steps(R, 3, C({ thrust: 1, firePressed: true, fire: true })); T.check('NITRO boosts', a.boostT > 2 && a.boostMul >= 1.35, [a.boostT, a.boostMul]); }\n  { const { R, a, b } = setup(600); a.energy = 50; R.weapons.give(a, 'siphon'); const eb = b.energy; steps(R, 300, k => C({ thrust: 1, firePressed: k === 2, fire: k === 2 })); T.check('SIPHON drains the target into the user', b.energy < eb - 10 && a.energy > 60, [a.energy, b.energy]); }\n  { const { R, a } = setup(); a.energy = 50; R.weapons.give(a, 'rail'); steps(R, 3, C({ absorb: true })); T.check('absorb turns the weapon into shield', a.energy >= 50 + 27 && !a.weapon, a.energy); }\n  // pickups by position: the leader gets more mines and shields, the back more tremors and autopilots\n  { const { R, a } = setup(); const cnt = place => { a.place = place; const c = {}; for (let k = 0; k < 600; k++) { const w = R.weapons.roll(a); c[w] = (c[w] || 0) + 1; } return c; }; const f = cnt(1), b = cnt(8);\n    T.check('pickups favour defence at the front', (f.mine || 0) > (b.mine || 0) && (f.tremor || 0) === 0, f); T.check('pickups favour attack at the back', (b.tremor || 0) > 0 && (b.autopilot || 0) > 0, b); }\n  // elimination: DNF in a race, a respawn in Snipeout\n  { const { R, b } = setup(); b.energy = 1; SN.Ship.damage(b, 50, 'test', null, R); T.check('at zero energy: eliminated (DNF in a race)', b.elim && b.dnf, b); }\n  { const { R, a, b } = setup(500, 0, 'snipeout'); b.energy = 1; R.weapons.give(a, 'swarm'); steps(R, 300, k => C({ thrust: 1, firePressed: k === 2, fire: k === 2 })); T.check('Snipeout: an elimination scores 3 + the hit', a.points >= 4, a.points); steps(R, 480, C({ thrust: 1 })); T.check('Snipeout: the eliminated craft respawns', !b.elim && b.energy === 100 || b.invT >= 0 && !b.elim, b); }\n  SN.AI.controls = ai;\n  // the AI uses every weapon across four seeded races\n  { const used = new Set();\n    for (const id of SN.TRACK_ORDER) { const R = new SN.Race({ track: SN.getTrack(id), mode: 'race', cls: 'FLARE', laps: 2, seed: 11, entrants: SN.field({ humans: [] }), intro: false, record: false }); let n = 0; while (R.state !== 'results' && n < 120 * 200) { R.step(dt); n++; for (const e of R.events) if (e.t === 'fire') used.add(e.weapon); if (R.state === 'racing' && R.ships.every(s => s.finished || s.dnf)) R.seal(); } }\n    T.check('the AI fires all ten weapons across four races', used.size === 10, [...used]); }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01LpWdDenjU3vyfoorPRTzdq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
