d ? .3 : v.vol) * o.vol }), this._sfxBus, at, mul); }\\\",\\n\\\"    let bus = this._sfxBus;   // (WOLFPACK edit 5: o.pan -1..1 places the sound left or right through a StereoPannerNode)\\\\n    if (o.pan && this.ctx.createStereoPanner) { const sp = this.ctx.createStereoPanner(); sp.pan.value = Math.max(-1, Math.min(1, o.pan)); sp.connect(this._sfxBus); bus = sp; setTimeout(() => { try { sp.disconnect(); } catch (e) { /* already gone */ } }, 4000); }\\\\n    try { for (const v of Array.isArray(p) ? p : [p]) this._voice(o.vol === undefined ? v : Object.assign({}, v, { vol: (v.vol === undefined ? .3 : v.vol) * o.vol }), bus, at, mul); }\\\")\\nopen('engine/CHANGES.md','a').write(\\\"5. **Stereo pan** (`audio.sfx(voice, { pan })`): a StereoPannerNode per sound, so gunfire, rotors and explosions sit left or right of the screen.\\\\n\\\")\\n# game: pan positional sounds by screen x\\ned('src/60-audio.js',\\\"const sfx = (v, o) => { const a = au(); if (a) a.sfx(v, o); };\\\",\\n\\\"let PAN = 0;   // the pan of the event being voiced: its screen side (-1 left .. 1 right)\\\\nconst sfx = (v, o) => { const a = au(); if (a) a.sfx(v, PAN ? Object.assign({ pan: PAN }, o) : o); };\\\\nA.panOf = (ev, world) => { const v = world.view; let x = ev.x, y = ev.y, z = ev.z; if (ev.id && world.get) { const e = world.get(ev.id); if (e) { x = e.x; y = e.y; z = e.z; } } if (x === undefined || !v || ev.k === 'shot' || ev.k === 'pickup') return 0; const p = v.project(x, y, z || 0); return p ? Math.max(-1, Math.min(1, (p[0] - WP.W / 2) / (WP.W / 2))) * .8 : 0; };\\\")\\ned('src/60-audio.js',\\\"  const k = ev.k, S = A.S, mine = local === undefined || ev.pid === local;\\\",\\n\\\"  const k = ev.k, S = A.S, mine = local === undefined || ev.pid === local;\\\\n  PAN = A.panOf(ev, world); try { A.onEvent2(ev, world, local, k, S, mine); } finally { PAN = 0; }\\\\n};\\\\nA.onEvent2 = (ev, world, local, k, S, mine) => {\\\")\\n# rotor loop panned toward the nearest aircraft\\ned('src/60-audio.js',\\\"  if (air > 0 && A.rot <= 0) { A.rot = .08; A.S.chop(.03 + air * .09); }\\\",\\n\\\"  if (air > 0 && A.rot <= 0) { A.rot = .08; const h = world.ents.find(e => !e.dead && e.T && (e.T.air || e.T.shape === 'hyenaOne')); PAN = h ? A.panOf({ x: h.x, y: h.y, z: h.z }, world) : 0; A.S.chop(.03 + air * .09); PAN = 0; }\\\")\\n# wind: storm ops (op 6, op 5) push rain sideways, smoke and embers drift, and gusts are heard\\ned('src/40-stages.js',\\\"const op6 = { id: 'op6', n: 6, name: 'LAST FLIGHT OUT', music: 'op6', time: 'storm',\\\",\\\"const op6 = { id: 'op6', n: 6, name: 'LAST FLIGHT OUT', music: 'op6', time: 'storm', wind: 1,\\\")\\ned('src/40-stages.js',\\\"const op5 = { id: 'op5', n: 5, name: 'THE KENNEL', music: 'op5', time: 'night',\\\",\\\"const op5 = { id: 'op5', n: 5, name: 'THE KENNEL', music: 'op5', time: 'night', wind: .4,\\\")\\ned('src/53-render.js',\\\"  for (const p of R.fx) { p.life -= dt;\\\",\\\"  const wind = (world.stage.wind || 0) * (.7 + .3 * Math.sin(R.t * .8)), wb = WP.basis(world.cam);\\\\n  for (const p of R.fx) { if (wind && (p.kind === 'smoke' || p.kind === 'ember' || p.kind === 'dust')) { p.x += wb.rx * wind * 30 * dt; p.y += wb.ry * wind * 30 * dt; } p.life -= dt;\\\")\\ned('src/53-render.js',\\\"px.line(g, x, y, x - 3, y + 8, i % 4 ? '#8a9ab8' : '#c8d8f0'); }\\\",\\\"px.line(g, x, y, x - 3 - (st.wind || 0) * 7, y + 8, i % 4 ? '#8a9ab8' : '#c8d8f0'); }\\\")\\ned('src/53-render.js',\\\"D.windsock = (g, sx, sy, k) => { px.rect(g, sx, sy - 40 * k, Math.max(1, k), 40 * k, '#c0c0c0'); const wv = Math.sin(R.t * 5) * 2 * k;\\\",\\\"D.windsock = (g, sx, sy, k, o, world) => { px.rect(g, sx, sy - 40 * k, Math.max(1, k), 40 * k, '#c0c0c0'); const wv = Math.sin(R.t * 5 * (1 + ((world && world.stage.wind) || 0))) * 2 * k;\\\")\\ned('src/60-audio.js',\\\"  if (world.stage.rain && A.rain <= 0) { A.rain = .45; A.S.rain(); }\\\",\\\"  if (world.stage.rain && A.rain <= 0) { A.rain = .45; A.S.rain(); }\\\\n  if (world.stage.wind && (A.gust = (A.gust || 0) - dt