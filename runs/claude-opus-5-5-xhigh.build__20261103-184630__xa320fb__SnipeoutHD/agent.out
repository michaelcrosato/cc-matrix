 try { this.feed(); R.step(dt); } finally { SN.Tune.load(keep); } },\"\"\",\"\"\"      run(dt) {\n        const keep = SN.Tune.snapshot(), kc = Object.assign({}, SN.cheats); SN.Tune.load(rec.tune); if (rec.cheats) Object.assign(SN.cheats, rec.cheats);\n        try { if (rec.skip === R.n) R.skipIntro(); this.feed(); R.step(dt); } finally { SN.Tune.load(keep); Object.assign(SN.cheats, kc); }\n      },\"\"\")\ns=s.replace(\"\"\"    if (rec.startState) { R.state = rec.startState; R.stateT = 0; }\\n\"\"\",\"\")\nopen(p,'w').write(s); print('ok')\nEOF\ncat > src/manifest.json <<'EOF'\n[\"00-core.js\", \"01-input.js\", \"05-data-teams.js\", \"06-data-weapons.js\", \"07-data-tracks.js\", \"20-track.js\", \"25-ship.js\", \"27-collide.js\", \"30-weapons.js\", \"35-ai.js\", \"40-race.js\", \"45-replay.js\"]\nEOF\ncat > .tmp/t6.mjs <<'EOF'\nimport { load } from '../tests/lib/vm.mjs';\nconst { SN } = load();\n// a human driven by a bot with some random noise, then replay\nconst T = SN.getTrack('karakum');\nconst ent = SN.field({ humans: [{ pilot: 'vale', team: 'kestrel' }] });\nconst R = new SN.Race({ track: T, mode: 'race', cls: 'FLARE', laps: 1, seed: 42, entrants: ent, intro: true });\nlet n = 0; const rnd = SN.rng(5);\nwhile (R.state !== 'results' && n < 120 * 300) {\n  if (n === 200) R.skipIntro();\n  const c = Object.assign({}, SN.AI.controls(R.player, R, { skill: 1 }));\n  c.steer += (rnd() - .5) * .3; c.thrust = c.thrust || (R.state === 'countdown' && R.stateT > 1.6) ? 1 : 0; c.firePressed = rnd() < .01; c.absorb = rnd() < .002;\n  R.setControls(0, c); R.step(1/120); n++;\n}\nconsole.log('race', R.state, 'steps', n, 'hash', R.hash(), 'player place', R.player.place, 'frames', R.recording.frames[0].length, 'json KB', (JSON.stringify(R.recording).length/1024).toFixed(1));\nconst v = SN.Replay.verify(R.recording);\nconsole.log('replay ok', v.ok, v.hash, v.want);\nEOF\nnode .tmp/t6.mjs","description":"Patch replay for intro/skip and verify a replay reproduces the hash"},"call