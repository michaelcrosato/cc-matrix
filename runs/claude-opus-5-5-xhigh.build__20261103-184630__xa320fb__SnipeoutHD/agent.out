gravity: 300, life: Tt, hp: 1, target: tgt, land }); pr.th = requestThreat(sim, tgt, { always: true, tele: Tt, kind: 'grenade', src: pr.id, pos: () => pr.pos }); if (pr.th) pr.th.srcAlive = () => pr.alive; f.r4g = sim.t; }","     if (f.r4b && !f.r4c && sim.t - f.r4g > 2) { f.r4c = true; raise(civ); raise(norm); sim.say('juno', \"Blue cut-out is a civilian. DON'T SHOOT!\"); }","-    if (f.r4c && !norm.alive && !f.r4d) { f.r4d = true; raise(civ, false); sim.timer = 20; f.r4t = 0; sim.say('juno', 'Final drill: eight targets, twenty seconds. GO!'); }","+    if (f.r4c && !norm.alive && !f.r4d) { f.r4d = true; f.timed = true; raise(civ, false); sim.timer = 20; f.r4t = 0; sim.say('juno', 'Final drill: eight targets, twenty seconds. GO!'); }","     if (f.r4d) {","       const left = timed.filter(o => o.alive);","       if (!left.some(o => o.raised)) { const n = left.slice().sort((a, b) => (a.lastUp || 0) - (b.lastUp || 0))[0]; if (n) { raise(n); n.upT = sim.t; } }","       for (const o of left) if (o.raised && sim.t - o.upT > 2.2) { raise(o, false); o.lastUp = sim.t; }","       if (sim.timer < .1 && left.length) { for (const o of timed) { o.alive = true; o.col.alive = true; o.hp = 1; raise(o, false); } sim.timer = 20; sim.say('juno', 'Too slow. Again!'); }","-    } else if (sim.timer < 1) sim.timer = 60;","+    }","   },","   objective: sim => rangeObjs(sim, 'R-4').slice(3).every(o => !o.alive)"," });"]},{"oldStart":19546,"oldLines":7,"newStart":19546,"newLines":7,"lines":[" /* 53-attract: the Autopilot (it produces the same commands a player does: the tests' 'fair' bot, the attract mode's","  * 'showoff', the dev P2 bot) and the attract mode: after 10 s idle on the title or the menu, a looping demo of","  * highlights (cheats on: god mode, infinite ammo), the high scores, the title; any input goes back to the title. */","-const SKILL = { fair: { react: .30, speed: 2.2, head: .3, jitter: .02 }, expert: { react: .18, speed: 3.5, head: .6, jitter: .01 }, showoff: { react: .16, speed: 3.6, head: .55, jitter: .01, show: true } };","+const SKILL = { fair: { react: .25, speed: 3, head: .3, jitter: .02 }, expert: { react: .18, speed: 3.5, head: .6, jitter: .01 }, showoff: { react: .16, speed: 3.6, head: .55, jitter: .01, show: true } };"," class Autopilot {","   constructor(style = 'fair') { this.style = style; this.S = SKILL[style] || SKILL.fair; this.ax = 0; this.ay = 0; this.vx = 0; this.vy = 0; this.lock = null; this.lockT = 0; this.holdCover = 0; this.t = 0; this.fireGap = 0; this.wsel = 0; this.cycle = 0; this.R = E.rng(style.length * 7919 + 1); }","   /** candidate targets: [{ p: world point, r (world radius), pri, kind, ref }] */"]},{"oldStart":19571,"oldLines":6,"newStart":19571,"newLines":7,"lines":["       const c = [(ob.box[0] + ob.box[3]) / 2, (ob.box[1] + ob.box[4]) / 2, (ob.box[2] + ob.box[5]) / 2 + (ob.K.popup ? 6 : 0)], cam = sim.cameraFor(i);","       if (Math.hypot(c[0] - cam.x, c[1] - cam.y) > 700) continue;","       if (ob.K.objective || ob.K.popup || ob.K.fly) out.push({ p: c, r: 4, pri: ob.K.objective ? 52 : 38, kind: 'obj', ref: ob });","+      else if (ob.K.needs && ob.K.needs.some(w => sim.players[i].ammo[w] > 0)) out.push({ p: c, r: 6, pri: 36, kind: 'obj', ref: ob });","       else if (ob.K.bonus && (this.S.show || this.style === 'fair')) out.push({ p: c, r: 3, pri: 8, kind: 'bonus', ref: ob });","       else if (ob.K.explode && sim.enemies.some(e => e.alive && !e.civ && Math.hypot(e.x - c[0], e.y - c[1]) < ob.K.explode * .8)) out.push({ p: c, r: 5, pri: 33, kind: 'barrel', ref: ob });","     }"]},{"oldStart":19894,"oldLines":7,"newStart":19895,"newLines":7,"lines":["     if (this.scene.tick) this.scene.tick(this, dt);","     // TIME","     if (this.phase === 'action') {","-      if (!tune.time.freeze && !this.cheats.freeze && this.mode !== 'attract') this.timer -= dt;","+      if (!tune.time.freeze && !this.cheats.freeze && this.mode !== 'attract' && (this.mode !== 'range' || this.scene.timed && this.flags.timed)