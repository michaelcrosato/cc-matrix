rt { NAME } from '../../tools/build.mjs';\\nimport { ARGS } from './20-browser.mjs';\\nconst here = new URL('../..', import.meta.url).pathname, root = new URL('../../..', import.meta.url).pathname, out = here + 'tests/out/hub/';\\nexport default async check => {\\n  mkdirSync(out, { recursive: true });\\n  for (const f of ['harness.html', 'bridge.js', 'round.js']) copyFileSync(here + 'hub/' + f, out + f);\\n  copyFileSync(root + NAME + '.html', out + 'game.html');\\n  const types = { html: 'text/html', js: 'text/javascript' };\\n  const server = createServer((req, res) => { const p = decodeURIComponent(new URL(req.url, 'http://x').pathname).replace(/^\\\\/+/, '') || 'harness.html'; try { const b = readFileSync(out + p.replace(/\\\\.\\\\./g, '')); res.writeHead(200, { 'content-type': types[p.split('.').pop()] || 'application/octet-stream' }); res.end(b); } catch (e) { res.writeHead(404); res.end(); } });\\n  await new Promise(r => server.listen(0, '127.0.0.1', r));\\n  const port = server.address().port, base = 'http://127.0.0.1:' + port + '/';\\n  const browser = await chromium.launch({ args: ARGS });\\n  try {\\n    const head = await (await fetch(base + 'game.html')).text();\\n    check('the server serves our game', head.includes('<title>Eye of the Bolt-Holder</title>'));\\n    for (const q of ['players=2&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1', 'scenario=host-leave&auto=1']) {\\n      const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });\\n      await page.goto(base + 'harness.html?game=game.html&' + q);\\n      let done = false;\\n      try { await page.waitForFunction(() => document.body && document.body.dataset.complete === 'true', null, { timeout: 240000 }); done = true; } catch (e) { /* timed out */ }\\n      const r = await page.evaluate(() => ({ pass: window.__hubCheck && window.__hubCheck.pass, rows: [...document.querySelectorAll('li, tr')].map(e => e.textContent.trim().replace(/\\\\s+/g, ' ')).filter(t => /fail|✗|✘|×/i.test(t)).slice(0, 12) }));\\n      check('harness ' + q + ' completes', done);\\n      check('harness ' + q + ' passes', r.pass === true, r.rows.join(' | '));\\n      await page.close();\\n    }\\n  } finally { await browser.close(); server.close(); }\\n};\\n\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":831,\"cache_read_input_tokens\":674358,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":831},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"5572b217-8052-4a87-b3f3-49ea658fe605\",\"uuid\":\"fce2e9f3-5781-44bd-8200-f66144e66ae1\",\"timestamp\":\"2026-11-04T03:03:38.637Z\",\"request_id\":\"req_011Cgh9M2ZF1EZcscMHKaXxk\",\"wire_tool_inputs\":{\"toolu_01LZh1FJadDAAaSBXUuNrXEd\":{\"file_path\":\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-185330__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-medium-20261103-185330/tests/suites/21-harness.mjs\",\"content\":\"// harness (Playwright): the AI Hub's own harness, served beside the bundled file on 127.0.0.1 (a port the OS picks):\\n// two players; four with latency, jitter and loss; and the host leaving. Each must end with window.__hubCheck.pass.\\nimport { chromium } from 'playwright';\\nimport { createServer } from 'node:http';\\nimport { readFileSync, mkdirSync, copyFileSync } from 'node:fs';\\nimport { NAME } from '../../tools/build.mjs';\\nimport { ARGS } from './20-browser.mjs';\\nconst here = new URL('../..', import.meta.url).pathname, root = new URL('../../..', import.meta.url).pathname, out = here + 'tests/out/hub/';\\nexport default async check => {\\n  mkdirSync(out, { recursive: true });\\n  for (const f of ['harne