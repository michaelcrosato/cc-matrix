{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KtTBopEevVXiTcKk8AFr99","type":"tool_result","content":"270\tconst { clamp, lerp, approach, TAU } = E;\n271\t/** U: engine units per metre (one floor tile is 16 units: one metre). three.js works in metres with y up */\n272\tconst U = 16, T = 16, DEG = Math.PI / 180, OUTLINE = '#0c0818';\n273\tconst Z_UP = { x: Math.SQRT1_2, y: 0, z: 0, w: Math.SQRT1_2 };   // Rapier's capsules and cylinders stand along y: this stands them up along z\n274\t/** engine units (x east, y south, z up) -> three.js metres (x east, y up, z south) */\n275\tconst toThree = (x, y, z, out = new THREE.Vector3()) => out.set(x / U, z / U, y / U);\n276\tconst _lin = new Map(), _col = new THREE.Color();\n277\t/** '#rrggbb' -> linear RGB floats (cached): instance colors */\n278\tfunction lin(hex) { let v = _lin.get(hex); if (!v) { _col.set(hex); v = [_col.r, _col.g, _col.b]; _lin.set(hex, v); } return v; }\n279\tconst _F32 = new Float32Array(1), _I32 = new Uint32Array(_F32.buffer);\n280\t/** a hash of a list of numbers by their exact float32 bits (FNV-1a), as 8 hex digits: equal state, equal hash */\n281\tfunction hashNumbers(list) {\n282\t  let h = 0x811c9dc5;\n283\t  for (const n of list) { _F32[0] = n; h ^= _I32[0]; h = Math.imul(h, 0x01000193) >>> 0; }\n284\t  return h.toString(16).padStart(8, '0');\n285\t}\n286\t// collision groups (Rapier: membership << 16 | filter; a pair touches when each one's filter has the other's membership):\n287\t// the level and platforms touch everything; props everything but flyers; heroes the level, props, platforms and mobs\n288\t// (their capsules shove mobs aside); mobs each other too; flyers the level and each other; the downed (setSolid(false))\n289\t// the level, props and platforms only\n290\tconst ig = (member, filter) => (member << 16) | filter;\n291\tconst GROUPS = { level: ig(1, 0xffff), platform: ig(64, 0xffff), prop: ig(2, 1 | 2 | 4 | 8 | 32 | 64), hero: ig(4, 1 | 2 | 8 | 64),\n292\t  mob: ig(8, 1 | 2 | 4 | 8 | 64), flyer: ig(16, 1 | 16 | 64), down: ig(32, 1 | 2 | 64) };\n293\tconst HERO_QUERY = ig(4, 1 | 2 | 64);   // a hero's controller steers round the level, props and platforms; its capsule shoves monsters\n294\tconst LEVEL_ONLY = ig(0xffff, 1 | 64);  // sight lines and camera checks: the level and platforms\n295\t\n296\t/** the page's one renderer and 3D canvas, shared by every world (World3D.init makes them) */\n297\tconst PAGE = { ready: null, renderer: null, canvas: null, backend: 'none', game: null, worlds: new Set(), active: null };\n298\tasync function init(game, o = {}) {\n299\t  if (PAGE.ready) return PAGE.ready;\n300\t  return (PAGE.ready = (async () => {\n301\t    await RAPIER.init({});\n302\t    PAGE.game = game;\n303\t    if (o.render === false || !game || game.headless || typeof document === 'undefined') return PAGE;\n304\t    // the 3D canvas: the page's #view, or one made right under the game's canvas, which stays on top (clear: bg null)\n305\t    const gc = game.screen.canvas;\n306\t    let cv = typeof o.canvas === 'string' ? document.getElementById(o.canvas) : o.canvas || document.getElementById('view');\n307\t    if (!cv) { cv = document.createElement('canvas'); cv.id = 'view'; gc.parentNode.insertBefore(cv, gc); }\n308\t    Object.assign(cv.style, { position: 'absolute', left: '0', top: '0', pointerEvents: 'none', zIndex: '0' });\n309\t    if (!gc.style.zIndex) gc.style.zIndex = '1';\n310\t    gc.style.background = 'transparent';\n311\t    if (!game.screen.clear) E.warn('3d:bg', 'a 3D world draws under the game\\'s canvas: make the game with bg: null, or its background hides the world');\n312\t    const qs = new URLSearchParams(location.search), webgl = o.backend === 'webgl' || qs.get('backend') === 'webgl';\n313\t    const r = new THREE.WebGPURenderer({ canvas: cv, antialias: false, forceWebGL: webgl });\n314\t    await r.init();\n315\t    r.shadowMap.enabled = true; r.shadowMap.type = THREE.PCFShadowMap;\n316\t    r.toneMapping = THREE.NoToneMapping; r.outputColorSpace = THREE.SRGBColorSpace;\n317\t    r.info.autoReset = false; r.setPixelRatio(1);\n318\t    Object.assign(PAGE, { renderer: r, canvas: cv, backend: r.backend.isWebGPUBackend ? 'WebGPU' : 'WebGL 2' });\n319\t    mouseLook(gc);\n320\t    return PAGE;\n321\t  })());\n322\t}\n323\t\n324\t/** the mouse turns the chase, first-person and fly cameras of the world drawn last: a click on the game's canvas in\n325\t *  play captures it (pointer lock; Esc or a pause frees it), then each move turns the camera (camera.mouseLook false:\n326\t *  never). Off while a session is recorded or replayed: the lock is not in its record, so the replay would turn apart */\n327\tfunction mouseLook(gc) {\n328\t  const cam = () => { const w = PAGE.active; return w && w.camera; }, S = E.session;\n329\t  gc.addEventListener('pointerdown', e => {\n330\t    const c = cam(); if (!c || e.pointerType !== 'mouse' || !c.mouseLook || !(c.capture || ['chase', 'first', 'fly'].includes(c.mode)) || document.pointerLockElement) return;\n331\t    if (PAGE.game.paused || (S && (S.recording || S.replaying))) return;\n332\t    try { const r = gc.requestPointerLock(); if (r && r.catch) r.catch(() => {}); } catch (err) { /* refused: [ and ] still turn it */ }\n333\t  });\n334\t  document.addEventListener('pointerlockchange', () => { for (const w of PAGE.worlds) w.camera.locked = document.pointerLockElement === gc; });\n335\t  document.addEventListener('mousemove', e => {\n336\t    const c = cam(); if (!c || !c.locked || PAGE.game.paused) return;\n337\t    const k = .0024, dx = e.movementX || 0, dy = e.movementY || 0;\n338\t    if (c.capture) { c.mouse[0] += dx; c.mouse[1] += dy; return; }   // (the game turns its own camera with them)\n339\t    c.yaw += dx * k; c._held = 1.5;\n340\t    if (c.mode === 'chase') c.chase.pitch = clamp(c.chase.pitch - dy * k, -1.3, .15);\n341\t    else if (c.mode === 'first') c.first.pitch = clamp(c.first.pitch - dy * k, -1.2, 1.1);\n342\t    else if (c.mode === 'fly') c.fly.pitch = clamp(c.fly.pitch - dy * k, -1.5, 1.5);\n343\t  });\n344\t}\n345\t\n346\t/* =============================================================================\n347\t * 2. TEXTURES AND MATERIALS  everything drawn by code, pixel by pixel, baked into crisp (nearest) textures\n348\t * ============================================================================= */\n349\t/** a texture function (x, y) -> [r, g, b] baked into a w x h texture (repeating unless repeat is false) */\n350\tfunction bake(fn, w, h, repeat = true) {\n351\t  const cv = document.createElement('canvas'); cv.width = w; cv.height = h;\n352\t  const g = cv.getContext('2d'), img = g.createImageData(w, h), d = img.data;\n353\t  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) { const c = fn(x, y), i = (y * w + x) * 4; d[i] = c[0]; d[i + 1] = c[1]; d[i + 2] = c[2]; d[i + 3] = 255; }\n354\t  g.putImageData(img, 0, 0);\n355\t  return canvasTex(cv, repeat);\n356\t}\n357\tfunction canvasTex(cv, repeat = true) {\n358\t  const t = new THREE.CanvasTexture(cv);\n359\t  t.magFilter = t.minFilter = THREE.NearestFilter; t.generateMipmaps = false; t.colorSpace = THREE.SRGBColorSpace;\n360\t  t.wrapS = t.wrapT = repeat ? THREE.RepeatWrapping : THREE.ClampToEdgeWrapping;\n361\t  return t;\n362\t}\n363\tconst H = E.hex;\n364\t/** the stone palette of the stress test's hall: flagstones, mortar, lit and dark edges, specks */\n365\tconst STONE = { stones: ['#4b4559', '#554f64', '#433e51', '#5d566c'].map(H), mortar: H('#221e2b'), hi: H('#6f6782'), lo: H('#322d3e'), speck: H('#2a2634') };\n366\t/** the ground's looks (a level's ground, a tile's ground): (x, y, o) -> [r, g, b] or [r, g, b, glow 0..1] in engine\n367\t *  units; o: the legend entry (its colors: base, dark, light, ...). Add your own: World3D.GROUND.lava = (x, y, o) => ... */\n368\tconst GROUND = {\n369\t  flagstone: (x, y, o) => E.tex.flagstone(x, y, o.pal || STONE),\n370\t  grass: (x, y, o) => E.tex.grass(x, y, o),\n371\t  dirt: (x, y, o) => E.tex.dirt(x, y, o),\n372\t  sand: (x, y, o) => E.tex.dirt(x, y, Object.assign({ base: '#d6bc84', dark: '#b4955e', light: '#ecd8a4' }, o)),\n373\t  snow: (x, y, o) => E.tex.dirt(x, y, Object.assign({ base: '#e6ecf6', dark: '#c4cee0', light: '#ffffff' }, o)),\n374\t  planks: (x, y, o) => E.tex.planks(x, y, o),\n375\t  tiles: (x, y, o) => E.tex.checker(x, y, o),\n376\t  plain: (x, y, o) => E.tex.plain(x, y, o),\n377\t  water: (x, y, o) => E.tex.water(x, y, o),\n378\t  lava: (x, y) => { const n = E.noise2(x * .08, y * .08) * .7 + E.noise2(x * .3, y * .3) * .3; return n > .62 ? [255, 214, 106, 1] : n > .45 ? [255, 122, 42, 1] : [170, 40, 26, .7]; }\n379\t};\n380\t/** the sides' looks (walls, raised floors, platforms, stairs): { w, h, fn(x, y, c) } where c holds the entry's colors as\n381\t *  [r, g, b] (side, line, top, hi, lo) and (x, y) is a pixel of a w x h texture that repeats every metre (16 pixels)\n382\t *  across; h is the pixels it spans up (64: earth's grass lip sits at the top of four metres) */\n383\tconst SIDE = {\n384\t  brick: { w: 16, h: 16, fn(x, y, c) {   // courses of bricks, joints staggered by course, lit brick tops and specks\n385\t    const z = 15 - y, ci = Math.floor(z / 8), fz = z - ci * 8;\n386\t    if (fz === 0) return c.line;\n387\t    const jx = (ci & 1) ? 4 : 12; if (x === jx) return c.line;\n388\t    const v = E.hash2(ci * 7 + (x < jx ? 0 : 1), ci + 99);\n389\t    if (fz === 7) return v > .5 ? c.hi : c.side;\n390\t    if (E.hash2(x * 3 + 1, z * 5 + 2) < .07) return c.lo;\n391\t    return v < .22 ? c.lo : v > .86 ? c.hi : c.side;\n392\t  } },\n393\t  block: { w: 16, h: 16, fn(x, y, c) {   // dressed stone: big blocks, bevelled (lit top and left, dark bottom and right)\n394\t    const row = Math.floor(y / 8), off = (row & 1) * 8, lx = (x + off) % 16, ly = y - row * 8;\n395\t    if (ly === 7 || lx === 15) return c.line;\n396\t    if (ly === 0 || lx === 0) return c.hi;\n397\t    if (ly === 6 || lx === 14) return c.lo;\n398\t    return E.noise2(x * .3, y * .3) > .8 ? c.lo : c.side;\n399\t  } },\n400\t  earth: { w: 16, h: 64, fn(x, y, c) {   // packed earth with stones, a grass lip at the top that hangs in tufts\n401\t    const lip = 3 + (E.hash2(x, 7) > .5 ? 1 : 0) + (E.hash2(x >> 1, 3) > .7 ? 1 : 0);\n402\t    if (y < lip) return y === lip - 1 ? c.lo2 : c.top;\n403\t    const n = E.noise2(x * .25, y * .25);\n404\t    if (n > .78) return c.hi;\n405\t    if (E.hash2(x * 5 + 1, y * 3 + 2) < .06) return c.lo;\n406\t    return n < .3 ? c.lo : c.side;\n407\t  } },\n408\t  planks: { w: 16, h: 16, fn(x, y, c) {   // boards standing up, a dark seam between each, nails at the ends\n409\t    const b = Math.floor(x / 4), lx = x % 4;\n410\t    if (lx === 3) return c.line;\n411\t    if ((y === 2 || y === 13) && lx === 1) return c.lo;\n412\t    return E.hash2(b, Math.floor(y / 5)) > .75 ? c.lo : lx === 0 ? c.hi : c.side;\n413\t  } },\n414\t  metal: { w: 16, h: 16, fn(x, y, c) {   // plates with rivets\n415\t    if (x === 0 || y === 0) return c.hi; if (x === 15 || y === 15) return c.line;\n416\t    if ((x === 2 || x === 13) && (y === 2 || y === 13)) return c.lo;\n417\t    return E.noise2(x * .2, y * .2) > .7 ? c.hi : c.side;\n418\t  } }\n419\t};\n420\t/** an entry's colors as RGB arrays (side, top, line, hi, lo, lo2), from its color (and the style's defaults) */\n421\tconst STYLE_COLORS = { brick: '#3d3750', block: '#4a4360', earth: '#7d5838', planks: '#8f5f37', metal: '#5c6070' };\n422\tfunction sideColors(style, o) {\n423\t  const side = o.color || STYLE_COLORS[style] || '#4a4360', t = E.tones(side);\n424\t  return { side: H(side), line: H(o.line || E.shade(side, -.35)), hi: H(t.lt), lo: H(t.sh), top: H(o.top || (style === 'earth' ? '#55a94a' : E.shade(side, .25))), lo2: H(E.shade(o.top || '#55a94a', -.25)) };\n425\t}\n426\t/** a box (w, d, h in units; three's axes) whose faces keep 16 pixels per metre (BoxGeometry stretches 0..1 over a face) */\n427\tfunction boxGeo(w, d, h) {\n428\t  const g = new THREE.BoxGeometry(w / U, h / U, d / U), uv = g.attributes.uv, size = [[d, h], [d, h], [w, d], [w, d], [w, h], [w, h]];   // faces: +x -x +y -y +z -z\n429\t  for (let f = 0; f < 6; f++) for (let k = 0; k < 4; k++) { const i = f * 4 + k; uv.setXY(i, uv.getX(i) * size[f][0] / T, uv.getY(i) * size[f][1] / T); }\n430\t  return g;\n431\t}\n432\t/** a box with two draw groups (its four sides, then top and bottom) instead of six: fewer draw calls */\n433\tfunction sidesThenTops(g) {\n434\t  const idx = g.index.array, face = f => Array.from(idx.slice(f * 6, f * 6 + 6));\n435\t  g.setIndex([0, 1, 4, 5, 2, 3].flatMap(face)); g.clearGroups(); g.addGroup(0, 24, 0); g.addGroup(24, 12, 1);\n436\t  return g;\n437\t}\n438\t/* the puppets' toon look: three bands of light (shadow, base, lit), like the engine's tones */\n439\tconst TOON_BANDS = (() => {\n440\t  const t = new THREE.DataTexture(new Uint8Array([90, 90, 90, 255, 170, 170, 170, 255, 255, 255, 255, 255]), 3, 1);\n441\t  t.magFilter = t.minFilter = THREE.NearestFilter; t.generateMipmaps = false; t.needsUpdate = true;\n442\t  return t;\n443\t})();\n444\t/* outlines: an inverted hull. The same (instanced) mesh again, back faces only, each vertex pushed OUTLINE_PX pixels\n445\t * outward on the screen (along its normal for round parts, away from the part's centre for boxes) */\n446\tconst OUTLINE_PX = TSL.uniform(new THREE.Vector2(.01, .01));   // clip-space size of the push, set per frame (one game pixel)\n447\tfunction outlineMat(mode = 'normal') {\n448\t  const { Fn, vec4, positionLocal, normalLocal, modelViewMatrix, cameraProjectionMatrix } = TSL;\n449\t  const m = new THREE.MeshBasicNodeMaterial({ color: OUTLINE, side: THREE.BackSide, fog: false });\n450\t  m.vertexNode = Fn(() => {\n451\t    const mvp = cameraProjectionMatrix.mul(modelViewMatrix), pos = mvp.mul(vec4(positionLocal, 1));\n452\t    const out = mode === 'center' ? positionLocal : normalLocal;\n453\t    const pos2 = mvp.mul(vec4(positionLocal.add(out.normalize().mul(.01)), 1));\n454\t    const dir = pos2.xy.div(pos2.w).sub(pos.xy.div(pos.w)).normalize();\n455\t    return vec4(pos.xy.add(dir.mul(OUTLINE_PX).mul(pos.w)), pos.z, pos.w);\n456\t  })();\n457\t  return m;\n458\t}\n459\tconst lambert = (map, o) => new THREE.MeshLambertNodeMaterial(Object.assign({ map }, o));\n460\t/** static meshes merged by material (one draw call each): add(geometry, [x, y, z] metres, a material or one per group,\n461\t *  casts a shadow), then build(scene) */\n462\tclass Merger {\n463\t  constructor() { this.by = new Map(); }\n464\t  add(geo, at, mats, shadow = true) {\n465\t    const P = geo.attributes.position, N = geo.attributes.normal, UV = geo.attributes.uv, idx = geo.index ? geo.index.array : null;\n466\t    const groups = geo.groups.length ? geo.groups : [{ start: 0, count: idx ? idx.length : P.count, materialIndex: 0 }];\n467\t    for (const gr of groups) {\n468\t      const m = Array.isArray(mats) ? mats[gr.materialIndex] : mats;\n469\t      let b = this.by.get(m); if (!b) this.by.set(m, b = { pos: [], nor: [], uv: [], shadow: false });\n470\t      for (let k = gr.start; k < gr.start + gr.count; k++) {\n471\t        const i = idx ? idx[k] : k;\n472\t        b.pos.push(P.getX(i) + at[0], P.getY(i) + at[1], P.getZ(i) + at[2]); b.nor.push(N.getX(i), N.getY(i), N.getZ(i)); b.uv.push(UV ? UV.getX(i) : 0, UV ? UV.getY(i) : 0);\n473\t      }\n474\t      b.shadow = b.shadow || shadow;\n475\t    }\n476\t    geo.dispose();\n477\t  }\n478\t  build(scene, own) {\n479\t    for (const [m, b] of this.by) {\n480\t      const g = own(new THREE.BufferGeometry());\n481\t      g.setAttribute('position', new THREE.Float32BufferAttribute(b.pos, 3)); g.setAttribute('normal', new THREE.Float32BufferAttribute(b.nor, 3)); g.setAttribute('uv', new THREE.Float32BufferAttribute(b.uv, 2));\n482\t      const mesh = new THREE.Mesh(g, m); mesh.receiveShadow = true; mesh.castShadow = b.shadow; scene.add(mesh);\n483\t    }\n484\t    this.by.clear();\n485\t  }\n486\t}\n487\t\n488\t/* =============================================================================\n489\t * 3. LEVEL  written as text, one character per floor tile (1 metre, 16 units); row 0 is the far (north) edge, y grows"}]},"parent_tool_use_id":null,"session_id":"4110026b-2798-4dbf-ae8a-e81d8e816e30","uuid":"59684d0b-9e4d-4f0b-81de-8e7e3e90a242","timestamp":"2026-11-04T01:48:44.257Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/engine/my-3d2dge-3d.js","content":"const { clamp, lerp, approach, TAU } = E;\n/** U: engine units per metre (one floor tile is 16 units: one metre). three.js works in metres with y up */\nconst U = 16, T = 16, DEG = Math.PI / 180, OUTLINE = '#0c0818';\nconst Z_UP = { x: Math.SQRT1_2, y: 0, z: 0, w: Math.SQRT1_2 };   // Rapier's capsules and cylinders stand along y: this stands them up along z\n/** engine units (x east, y south, z up) -> three.js metres (x east, y up, z south) */\nconst toThree = (x, y, z, out = new THREE.Vector3()) => out.set(x / U, z / U, y / U);\nconst _lin = new Map(), _col = new THREE.Color();\n/** '#rrggbb' -> linear RGB floats (cached): instance colors */\nfunction lin(hex) { let v = _lin.get(hex); if (!v) { _col.set(hex); v = [_col.r, _col.g, _col.b]; _lin.set(hex, v); } return v; }\nconst _F32 = new Float32Array(1), _I32 = new Uint32Array(_F32.buffer);\n/** a hash of a list of numbers by their exact float32 bits (FNV-1a), as 8 hex digits: equal state, equal hash */\nfunction hashNumbers(list) {\n  let h = 0x811c9dc5;\n  for (const n of list) { _F32[0] = n; h ^= _I32[0]; h = Math.imul(h, 0x01000193) >>> 0; }\n  return h.toString(16).padStart(8, '0');\n}\n// collision groups (Rapier: membership << 16 | filter; a pair touches when each one's filter has the other's membership):\n// the level and platforms touch everything; props everything but flyers; heroes the level, props, platforms and mobs\n// (their capsules shove mobs aside); mobs each other too; flyers the level and each other; the downed (setSolid(false))\n// the level, props and platforms only\nconst ig = (member, filter) => (member << 16) | filter;\nconst GROUPS = { level: ig(1, 0xffff), platform: ig(64, 0xffff), prop: ig(2, 1 | 2 | 4 | 8 | 32 | 64), hero: ig(4, 1 | 2 | 8 | 64),\n  mob: ig(8, 1 | 2 | 4 | 8 | 64), flyer: ig(16, 1 | 16 | 64), down: ig(32, 1 | 2 | 64) };\nconst HERO_QUERY = ig(4, 1 | 2 | 64);   // a hero's controller steers round the level, props and platforms; its capsule shoves monsters\nconst LEVEL_ONLY = ig(0xffff, 1 | 64);  // sight lines and camera checks: the level and platforms\n\n/** the page's one renderer and 3D canvas, shared by every world (World3D.init makes them) */\nconst PAGE = { ready: null, renderer: null, canvas: null, backend: 'none', game: null, worlds: new Set(), active: null };\nasync function init(game, o = {}) {\n  if (PAGE.ready) return PAGE.ready;\n  return (PAGE.ready = (async () => {\n    await RAPIER.init({});\n    PAGE.game = game;\n    if (o.render === false || !game || game.headless || typeof document === 'undefined') return PAGE;\n    // the 3D canvas: the page's #view, or one made right under the game's canvas, which stays on top (clear: bg null)\n    const gc = game.screen.canvas;\n    let cv = typeof o.canvas === 'string' ? document.getElementById(o.canvas) : o.canvas || document.getElementById('view');\n    if (!cv) { cv = document.createElement('canvas'); cv.id = 'view'; gc.parentNode.insertBefore(cv, gc); }\n    Object.assign(cv.style, { position: 'absolute', left: '0', top: '0', pointerEvents: 'none', zIndex: '0' });\n    if (!gc.style.zIndex) gc.style.zIndex = '1';\n    gc.style.background = 'transparent';\n    if (!game.screen.clear) E.warn('3d:bg', 'a 3D world draws under the game\\'s canvas: make the game with bg: null, or its background hides the world');\n    const qs = new URLSearchParams(location.search), webgl = o.backend === 'webgl' || qs.get('backend') === 'webgl';\n    const r = new THREE.WebGPURenderer({ canvas: cv, antialias: false, forceWebGL: webgl });\n    await r.init();\n    r.shadowMap.enabled = true; r.shadowMap.type = THREE.PCFShadowMap;\n    r.toneMapping = THREE.NoToneMapping; r.outputColorSpace = THREE.SRGBColorSpace;\n    r.info.autoReset = false; r.setPixelRatio(1);\n    Object.assign(PAGE, { renderer: r, canvas: cv, backend: r.backend.isWebGPUBackend ? 'WebGPU' : 'WebGL 2' });\n    mouseLook(gc);\n    return PAGE;\n  })());\n}\n\n/** the mouse turns the chase, first-person and fly cameras of the world drawn last: a click on the game's canvas in\n *  play captures it (pointer lock; Esc or a pause frees it), then each move turns the camera (camera.mouseLook false:\n *  never). Off while a session is recorded or replayed: the lock is not in its record, so the replay would turn apart */\nfunction mouseLook(gc) {\n  const cam = () => { const w = PAGE.active; return w && w.camera; }, S = E.session;\n  gc.addEventListener('pointerdown', e => {\n    const c = cam(); if (!c || e.pointerType !== 'mouse' || !c.mouseLook || !(c.capture || ['chase', 'first', 'fly'].includes(c.mode)) || document.pointerLockElement) return;\n    if (PAGE.game.paused || (S && (S.recording || S.replaying))) return;\n    try { const r = gc.requestPointerLock(); if (r && r.catch) r.catch(() => {}); } catch (err) { /* refused: [ and ] still turn it */ }\n  });\n  document.addEventListener('pointerlockchange', () => { for (const w of PAGE.worlds) w.camera.locked = document.pointerLockElement === gc; });\n  document.addEventListener('mousemove', e => {\n    const c = cam(); if (!c || !c.locked || PAGE.game.paused) return;\n    const k = .0024, dx = e.movementX || 0, dy = e.movementY || 0;\n    if (c.capture) { c.mouse[0] += dx; c.mouse[1] += dy; return; }   // (the game turns its own camera with them)\n    c.yaw += dx * k; c._held = 1.5;\n    if (c.mode === 'chase') c.chase.pitch = clamp(c.chase.pitch - dy * k, -1.3, .15);\n    else if (c.mode === 'first') c.first.pitch = clamp(c.first.pitch - dy * k, -1.2, 1.1);\n    else if (c.mode === 'fly') c.fly.pitch = clamp(c.fly.pitch - dy * k, -1.5, 1.5);\n  });\n}\n\n/* =============================================================================\n * 2. TEXTURES AND MATERIALS  everything drawn by code, pixel by pixel, baked into crisp (nearest) textures\n * ============================================================================= */\n/** a texture function (x, y) -> [r, g, b] baked into a w x h texture (repeating unless repeat is false) */\nfunction bake(fn, w, h, repeat = true) {\n  const cv = document.createElement('canvas'); cv.width = w; cv.height = h;\n  const g = cv.getContext('2d'), img = g.createImageData(w, h), d = img.data;\n  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) { const c = fn(x, y), i = (y * w + x) * 4; d[i] = c[0]; d[i + 1] = c[1]; d[i + 2] = c[2]; d[i + 3] = 255; }\n  g.putImageData(img, 0, 0);\n  return canvasTex(cv, repeat);\n}\nfunction canvasTex(cv, repeat = true) {\n  const t = new THREE.CanvasTexture(cv);\n  t.magFilter = t.minFilter = THREE.NearestFilter; t.generateMipmaps = false; t.colorSpace = THREE.SRGBColorSpace;\n  t.wrapS = t.wrapT = repeat ? THREE.RepeatWrapping : THREE.ClampToEdgeWrapping;\n  return t;\n}\nconst H = E.hex;\n/** the stone palette of the stress test's hall: flagstones, mortar, lit and dark edges, specks */\nconst STONE = { stones: ['#4b4559', '#554f64', '#433e51', '#5d566c'].map(H), mortar: H('#221e2b'), hi: H('#6f6782'), lo: H('#322d3e'), speck: H('#2a2634') };\n/** the ground's looks (a level's ground, a tile's ground): (x, y, o) -> [r, g, b] or [r, g, b, glow 0..1] in engine\n *  units; o: the legend entry (its colors: base, dark, light, ...). Add your own: World3D.GROUND.lava = (x, y, o) => ... */\nconst GROUND = {\n  flagstone: (x, y, o) => E.tex.flagstone(x, y, o.pal || STONE),\n  grass: (x, y, o) => E.tex.grass(x, y, o),\n  dirt: (x, y, o) => E.tex.dirt(x, y, o),\n  sand: (x, y, o) => E.tex.dirt(x, y, Object.assign({ base: '#d6bc84', dark: '#b4955e', light: '#ecd8a4' }, o)),\n  snow: (x, y, o) => E.tex.dirt(x, y, Object.assign({ base: '#e6ecf6', dark: '#c4cee0', light: '#ffffff' }, o)),\n  planks: (x, y, o) => E.tex.planks(x, y, o),\n  tiles: (x, y, o) => E.tex.checker(x, y, o),\n  plain: (x, y, o) => E.tex.plain(x, y, o),\n  water: (x, y, o) => E.tex.water(x, y, o),\n  lava: (x, y) => { const n = E.noise2(x * .08, y * .08) * .7 + E.noise2(x * .3, y * .3) * .3; return n > .62 ? [255, 214, 106, 1] : n > .45 ? [255, 122, 42, 1] : [170, 40, 26, .7]; }\n};\n/** the sides' looks (walls, raised floors, platforms, stairs): { w, h, fn(x, y, c) } where c holds the entry's colors as\n *  [r, g, b] (side, line, top, hi, lo) and (x, y) is a pixel of a w x h texture that repeats every metre (16 pixels)\n *  across; h is the pixels it spans up (64: earth's grass lip sits at the top of four metres) */\nconst SIDE = {\n  brick: { w: 16, h: 16, fn(x, y, c) {   // courses of bricks, joints staggered by course, lit brick tops and specks\n    const z = 15 - y, ci = Math.floor(z / 8), fz = z - ci * 8;\n    if (fz === 0) return c.line;\n    const jx = (ci & 1) ? 4 : 12; if (x === jx) return c.line;\n    const v = E.hash2(ci * 7 + (x < jx ? 0 : 1), ci + 99);\n    if (fz === 7) return v > .5 ? c.hi : c.side;\n    if (E.hash2(x * 3 + 1, z * 5 + 2) < .07) return c.lo;\n    return v < .22 ? c.lo : v > .86 ? c.hi : c.side;\n  } },\n  block: { w: 16, h: 16, fn(x, y, c) {   // dressed stone: big blocks, bevelled (lit top and left, dark bottom and right)\n    const row = Math.floor(y / 8), off = (row & 1) * 8, lx = (x + off) % 16, ly = y - row * 8;\n    if (ly === 7 || lx === 15) return c.line;\n    if (ly === 0 || lx === 0) return c.hi;\n    if (ly === 6 || lx === 14) return c.lo;\n    return E.noise2(x * .3, y * .3) > .8 ? c.lo : c.side;\n  } },\n  earth: { w: 16, h: 64, fn(x, y, c) {   // packed earth with stones, a grass lip at the top that hangs in tufts\n    const lip = 3 + (E.hash2(x, 7) > .5 ? 1 : 0) + (E.hash2(x >> 1, 3) > .7 ? 1 : 0);\n    if (y < lip) return y === lip - 1 ? c.lo2 : c.top;\n    const n = E.noise2(x * .25, y * .25);\n    if (n > .78) return c.hi;\n    if (E.hash2(x * 5 + 1, y * 3 + 2) < .06) return c.lo;\n    return n < .3 ? c.lo : c.side;\n  } },\n  planks: { w: 16, h: 16, fn(x, y, c) {   // boards standing up, a dark seam between each, nails at the ends\n    const b = Math.floor(x / 4), lx = x % 4;\n    if (lx === 3) return c.line;\n    if ((y === 2 || y === 13) && lx === 1) return c.lo;\n    return E.hash2(b, Math.floor(y / 5)) > .75 ? c.lo : lx === 0 ? c.hi : c.side;\n  } },\n  metal: { w: 16, h: 16, fn(x, y, c) {   // plates with rivets\n    if (x === 0 || y === 0) return c.hi; if (x === 15 || y === 15) return c.line;\n    if ((x === 2 || x === 13) && (y === 2 || y === 13)) return c.lo;\n    return E.noise2(x * .2, y * .2) > .7 ? c.hi : c.side;\n  } }\n};\n/** an entry's colors as RGB arrays (side, top, line, hi, lo, lo2), from its color (and the style's defaults) */\nconst STYLE_COLORS = { brick: '#3d3750', block: '#4a4360', earth: '#7d5838', planks: '#8f5f37', metal: '#5c6070' };\nfunction sideColors(style, o) {\n  const side = o.color || STYLE_COLORS[style] || '#4a4360', t = E.tones(side);\n  return { side: H(side), line: H(o.line || E.shade(side, -.35)), hi: H(t.lt), lo: H(t.sh), top: H(o.top || (style === 'earth' ? '#55a94a' : E.shade(side, .25))), lo2: H(E.shade(o.top || '#55a94a', -.25)) };\n}\n/** a box (w, d, h in units; three's axes) whose faces keep 16 pixels per metre (BoxGeometry stretches 0..1 over a face) */\nfunction boxGeo(w, d, h) {\n  const g = new THREE.BoxGeometry(w / U, h / U, d / U), uv = g.attributes.uv, size = [[d, h], [d, h], [w, d], [w, d], [w, h], [w, h]];   // faces: +x -x +y -y +z -z\n  for (let f = 0; f < 6; f++) for (let k = 0; k < 4; k++) { const i = f * 4 + k; uv.setXY(i, uv.getX(i) * size[f][0] / T, uv.getY(i) * size[f][1] / T); }\n  return g;\n}\n/** a box with two draw groups (its four sides, then top and bottom) instead of six: fewer draw calls */\nfunction sidesThenTops(g) {\n  const idx = g.index.array, face = f => Array.from(idx.slice(f * 6, f * 6 + 6));\n  g.setIndex([0, 1, 4, 5, 2, 3].flatMap(face)); g.clearGroups(); g.addGroup(0, 24, 0); g.addGroup(24, 12, 1);\n  return g;\n}\n/* the puppets' toon look: three bands of light (shadow, base, lit), like the engine's tones */\nconst TOON_BANDS = (() => {\n  const t = new THREE.DataTexture(new Uint8Array([90, 90, 90, 255, 170, 170, 170, 255, 255, 255, 255, 255]), 3, 1);\n  t.magFilter = t.minFilter = THREE.NearestFilter; t.generateMipmaps = false; t.needsUpdate = true;\n  return t;\n})();\n/* outlines: an inverted hull. The same (instanced) mesh again, back faces only, each vertex pushed OUTLINE_PX pixels\n * outward on the screen (along its normal for round parts, away from the part's centre for boxes) */\nconst OUTLINE_PX = TSL.uniform(new THREE.Vector2(.01, .01));   // clip-space size of the push, set per frame (one game pixel)\nfunction outlineMat(mode = 'normal') {\n  const { Fn, vec4, positionLocal, normalLocal, modelViewMatrix, cameraProjectionMatrix } = TSL;\n  const m = new THREE.MeshBasicNodeMaterial({ color: OUTLINE, side: THREE.BackSide, fog: false });\n  m.vertexNode = Fn(() => {\n    const mvp = cameraProjectionMatrix.mul(modelViewMatrix), pos = mvp.mul(vec4(positionLocal, 1));\n    const out = mode === 'center' ? positionLocal : normalLocal;\n    const pos2 = mvp.mul(vec4(positionLocal.add(out.normalize().mul(.01)), 1));\n    const dir = pos2.xy.div(pos2.w).sub(pos.xy.div(pos.w)).normalize();\n    return vec4(pos.xy.add(dir.mul(OUTLINE_PX).mul(pos.w)), pos.z, pos.w);\n  })();\n  return m;\n}\nconst lambert = (map, o) => new THREE.MeshLambertNodeMaterial(Object.assign({ map }, o));\n/** static meshes merged by material (one draw call each): add(geometry, [x, y, z] metres, a material or one per group,\n *  casts a shadow), then build(scene) */\nclass Merger {\n  constructor() { this.by = new Map(); }\n  add(geo, at, mats, shadow = true) {\n    const P = geo.attributes.position, N = geo.attributes.normal, UV = geo.attributes.uv, idx = geo.index ? geo.index.array : null;\n    const groups = geo.groups.length ? geo.groups : [{ start: 0, count: idx ? idx.length : P.count, materialIndex: 0 }];\n    for (const gr of groups) {\n      const m = Array.isArray(mats) ? mats[gr.materialIndex] : mats;\n      let b = this.by.get(m); if (!b) this.by.set(m, b = { pos: [], nor: [], uv: [], shadow: false });\n      for (let k = gr.start; k < gr.start + gr.count; k++) {\n        const i = idx ? idx[k] : k;\n        b.pos.push(P.getX(i) + at[0], P.getY(i) + at[1], P.getZ(i) + at[2]); b.nor.push(N.getX(i), N.getY(i), N.getZ(i)); b.uv.push(UV ? UV.getX(i) : 0, UV ? UV.getY(i) : 0);\n      }\n      b.shadow = b.shadow || shadow;\n    }\n    geo.dispose();\n  }\n  build(scene, own) {\n    for (const [m, b] of this.by) {\n      const g = own(new THREE.BufferGeometry());\n      g.setAttribute('position', new THREE.Float32BufferAttribute(b.pos, 3)); g.setAttribute('normal', new THREE.Float32BufferAttribute(b.nor, 3)); g.setAttribute('uv', new THREE.Float32BufferAttribute(b.uv, 2));\n      const mesh = new THREE.Mesh(g, m); mesh.receiveShadow = true; mesh.castShadow = b.shadow; scene.add(mesh);\n    }\n    this.by.clear();\n  }\n}\n\n/* =============================================================================\n * 3. LEVEL  written as text, one character per floor tile (1 metre, 16 units); row 0 is the far (north) edge, y grows","numLines":220,"startLine":270,"totalLines":3302}},"tool_result_meta":[{"id":"toolu_01KtTBopEevVXiTcKk8AFr99","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
