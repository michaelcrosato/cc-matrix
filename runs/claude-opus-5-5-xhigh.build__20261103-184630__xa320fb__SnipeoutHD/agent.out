nst rat = B.spawnMon('f1', 'rat', 3, 7, {}); check('Monster HP x2 doubles a spawned rat', rat.max === Math.round(4 * 2), rat.max);","+  check('the change persists in storage', JSON.parse(store.get('boltholder.dev')).T.monHp === 2);","+  rows[0].run(); check('Reset to defaults restores the page', B.T.monHp === 1 && B.T.monDmg === 1);","+  B.T.partyDmg = 3; B.resetTune(); check('reset restores every default', Object.entries(B.TDEF).every(([k, v]) => B.T[k] === v));","+  const cheats = B.DevMode.rows(4);","+  cheats.find(r => r.label === 'God mode').set(true); const m = B.S.party.members[0], h = m.hp; B.hurtMember(m, 5); check('god mode takes no damage', m.hp === h); B.CHEATS.god = false;","+  cheats.find(r => r.label === 'One-hit kills').set(true); const r2 = B.spawnMon('f1', 'ooze', 3, 7, {}); B.attackMon(m, r2, { dmg: '1d1' }, 'main', { dmg: '1d1' }); check('one-hit kills', r2.hp <= 0 || r2.hp === r2.max); B.CHEATS.oneHit = false;","+  B.CHEATS.noclip = true; B.S.party.cx = 2; B.S.party.cy = 14; B.S.party.dir = 3; B.cmdMove('f'); check('noclip walks through walls', B.S.party.cx === 1); B.CHEATS.noclip = false; B.S.party.tween = null;","+  cheats.find(r => r.label === 'Give all keys and wards').run(); check('every key and ward given', B.countItem('ironWard') === 1 && B.countItem('boneKey') === 1);","+  for (const fid of ['f1', 'f2', 'f3', 'f4', 'race']) for (const [n, x, y, d] of B.FLOORS[fid].waypoints || []) { B.devWarp(fid, x, y, d); check('warp to ' + n, B.S.floor === fid && B.S.party.cx === x && B.S.party.cy === y); }","+  B.devWarp('f1', 2, 14, 0);","+  const party = B.DevMode.rows(6); party.find(r => r.label === '+1 level for everyone').run(); check('+1 level', B.S.party.members.every(x => x.lvl === 2));","+  party.find(r => r.label === 'Add Durgan').run(); check('add an NPC', B.S.party.members.some(x => x.npc === 'durgan'));","+  const sp = B.DevMode.rows(7); const before = B.FS().mons.length; sp.find(r => r.label === 'Spawn in front').run(); check('spawn in front', B.FS().mons.length > before);","+  sp.find(r => r.label === 'Kill all on this floor').run(); check('kill all', B.FS().mons.every(x => x.hp <= 0));","+  check('the debug tab has auto-play, attract, cutscenes and the sound test', ['Auto-play to floor end', 'Start the attract mode now', 'Play the intro', 'Sound test', 'Fake hub ghosts'].every(l => B.DevMode.rows(8).some(r => r.label === l)));","+  check('the sound test lists sfx, songs and voices', B.DevMode.soundList().length > 100);","+  check('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));","+};"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/agent.out","hunks":[{"oldStart":2632,"oldLines":3,"newStart":2632,"newLines":4,"lines":[" {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011Cgh96uCLjbq1nfviZrgo7\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1498,\"cache_read_input_tokens\":732038,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1498},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"a0704575-f16b-44ea-a24d-907e9c278025\",\"uuid\":\"a7a4c9c2-99be-47c1-b08e-cdc627362b30\",\"timestamp\":\"2026-11-04T02:59:59.061Z\",\"request_id\":\"req_011Cgh96trWBEqGFYBSMLThY\",\"thinking_duration_ms\":3305,\"thinking_display\":\"updates\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011Cgh96uCLjbq1nfviZrgo7\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"The bot shoots the grenadier fi