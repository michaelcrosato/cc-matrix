{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LRhLmzPFftw4vmLcw9fjqu","type":"tool_result","content":"2214\t/* =============================================================================\n2215\t * 9. THE WORLD  new E.World3D(game, o) (after await E.World3D.init(game)): a level, its physics, its actors, props,\n2216\t *    platforms and things, its lights, sky and camera. world.step(dt) in the game's update, world.draw(r) in its draw\n2217\t * ============================================================================= */\n2218\tconst RES = ['pixels', 'balanced', 'full'];\n2219\tclass World3D {\n2220\t  constructor(game, o = {}) {\n2221\t    if (!PAGE.ready) throw new Error('my-3D2dge 3D: await E.World3D.init(game) (a boot step) before new E.World3D(game, ...)');\n2222\t    if (!o.terrain && (!o.level || !o.level.rows)) throw new Error('my-3D2dge 3D: new E.World3D(game, { level: { rows: [...], legend: {...} } }) needs a level written as text (or { terrain: { height: (x, y) => z, ... } }: an open world)');\n2223\t    /** game: the 2D engine's game that runs it; scene: its three.js scene (add your own meshes: E.THREE); o: its options */\n2224\t    this.game = game; this.o = o; this.scene = new THREE.Scene(); this._owned = []; this._mats = new Map(); this._objMats = new Set();\n2225\t    const st = game.settings || {};\n2226\t    /** look: 'card' (each rig drawn by the 2D engine on a card, exactly as in 2D) | 'puppet' (3D parts on its joints);\n2227\t     *  res: the picture's resolution: 'pixels' (the game's own pixels: PS1 chunky), 'balanced' (half the screen's) or\n2228\t     *  'full'; outlines: an outline round characters and things; gravity: units a second squared (480: the 2D slimes'\n2229\t     *  cartoon gravity) */\n2230\t    this.look = o.look || st.look3d || 'card'; this.res = RES.includes(o.res) ? o.res : RES.includes(st.picture3d) ? st.picture3d : 'pixels';\n2231\t    this.outlines = o.outlines !== false; this.gravity = o.gravity ?? 480; this.shadows = o.shadows ?? (st.shadows3d !== false);\n2232\t    /** filter: a look over the whole picture (section 10b): { look: 'clean' | 'cel' | 'pixel', apply, bloom, fxaa, ... } */\n2233\t    this.filter = Object.assign({}, FX_DEFAULT, st.filter3d && st.filter3d !== 'clean' ? { look: st.filter3d } : null, o.filter);\n2234\t    /** the level: its size (width, depth in units; mw, mh in tiles), bottom (where a fall is lost), marks; terrain: the\n2235\t     *  open world's ground (section 3b) when the world was made with one, else null */\n2236\t    this._owners = new Map(); this.blocks = [];\n2237\t    const L = this.level = o.terrain ? new Terrain(this, o.terrain) : new Level(this, o.level);\n2238\t    this.terrain = o.terrain ? L : null;\n2239\t    Object.assign(this, { width: L.width, depth: L.depth, mw: L.mw, mh: L.mh, bottom: L.bottom, marks: L.marks, torches: L.torches });\n2240\t    /** actors, props, platforms, things: what is in the world now (read them; add and remove with the methods below) */\n2241\t    this.actors = []; this.props = []; this.platforms = []; this.things = []; this.shapes = [];\n2242\t    /** tracks (world.track), flyers (world.flyer): yours to read */\n2243\t    this.tracks = []; this.flyers = [];\n2244\t    this.B = makeBatches(this); this.capes = makeCapes(this); this.atlas = makeAtlas(this);\n2245\t    /** pen: draw your own 3D shapes for this frame (in draw, before world.draw(r)): world.pen.at(x, y, z, yaw).box(...) */\n2246\t    this.pen = new Pen(this); this.pen.B = this.B;\n2247\t    this.part = {\n2248\t      add: new Batch(this.scene, new THREE.CircleGeometry(1, 6), new THREE.MeshBasicNodeMaterial({ color: '#ffffff', transparent: true, depthWrite: false, blending: THREE.AdditiveBlending }), { order: 4, cap: 2048 }),\n2249\t      solid: new Batch(this.scene, new THREE.CircleGeometry(1, 6), this._obj(new THREE.MeshBasicNodeMaterial({ color: '#ffffff' })), { cap: 2048 }),\n2250\t      bit: new Batch(this.scene, new THREE.PlaneGeometry(2, 2), this._obj(new THREE.MeshBasicNodeMaterial({ color: '#ffffff' })), { cap: 1024 })\n2251\t    };\n2252\t    this._arcs = floorPool(this, 12); this._rings = floorPool(this, 24); this._ribbons = ribbons(this);\n2253\t    this._propMesh = propMeshes(this); this._shapeKit = shapeKit(this);\n2254\t    L.meshes(this);\n2255\t    this._lights(o);\n2256\t    this._sky(o);\n2257\t    /** camera: see section 7 */\n2258\t    this.camera = new Camera3D(this, Object.assign({ far: this.terrain ? this.terrain.far * 1.1 : 9600 }, o.camera));\n2259\t    /** cameras: the world's cameras, [0] its camera; world.addCamera(o) adds one (a split screen's viewport i draws\n2260\t     *  through cameras[i]) */\n2261\t    this.cameras = [this.camera];\n2262\t    /** overlay: a scene of your own drawn over the world after it (its depth cleared first), from its own camera at the\n2263\t     *  origin: a first-person view model (the arms and the gun) that never sinks into a wall. { scene, camera (fov: set\n2264\t     *  it), pen (the world's pen, in this scene: engine units round the eye, x ahead, y right, z up), on }; lit by the\n2265\t     *  world's sun and sky as the world's camera sees them */\n2266\t    if (o.overlay) this._makeOverlay(o.overlay);\n2267\t    /** onDraw(world, r): called as each frame starts drawing, before the camera is placed: the game's own 3D drawing\n2268\t     *  (world.pen, overlay.pen, glows; a last touch to camera.pose) for every frame, whichever scene draws the world */\n2269\t    this.onDraw = o.onDraw || null;\n2270\t    /** time: seconds stepped; n: steps; stats: the last frame's numbers (draw calls, triangles, actors drawn, physics\n2271\t     *  and draw milliseconds) */\n2272\t    this.time = 0; this.n = 0; this.stats = { calls: 0, tris: 0, drawn: 0, culled: 0, physicsMs: 0, drawMs: 0, bodies: 0, frames: 0 };\n2273\t    this._queue = { arcs: [], glows: [] }; this._warm = false; this._seen = new Set();\n2274\t    PAGE.worlds.add(this);\n2275\t    this.reset();\n2276\t  }\n2277\t  _own(x) { this._owned.push(x); return x; }\n2278\t  _mat(key, make) { let m = this._mats.get(key); if (!m) { m = this._own(make()); this._mats.set(key, m); } return m; }\n2279\t  _obj(m) { this._objMats.add(m); return m; }\n2280\t  /** a fresh physics world: the level's colliders and shapes, nothing else (actors, props, platforms, things and the\n2281\t   *  shapes you placed are gone: add them again). The same seed and the same inputs from here give the same state (world.hash) */\n2282\t  reset() {\n2283\t    if (this.pw) this.pw.free();\n2284\t    const pw = this.pw = new RAPIER.World({ x: 0, y: 0, z: -this.gravity });\n2285\t    pw.lengthUnit = U; pw.numSolverIterations = this.o.iterations || 4;\n2286\t    for (const p of this.platforms) if (p.mesh) this.scene.remove(p.mesh);\n2287\t    for (const p of this.props) if (p.mesh) this.scene.remove(p.mesh);\n2288\t    this.actors.length = 0; this.props.length = 0; this.platforms.length = 0; this.things.length = 0; this.blocks.length = 0; this._owners.clear();\n2289\t    this.level.colliders(pw); for (const t of this.tracks) t._cols(); this.flyers.length = 0;\n2290\t    // the level's own shapes (a legend's { shape }) stand again; a game's are gone with the rest\n2291\t    this.shapes.length = 0; this._shapeKit.clear(); for (const [id, x, y, z, sp] of this.level.shapes) this.shape(id, x, y, z, sp);\n2292\t    this.time = 0; this.n = 0; this.passing = null; if (this.camera) Object.assign(this.camera.unlock(), { focus: null, smooth: null, pose: null, zone: null, cuts: 0, _hold: null, _mv: [0, 0] });   // (the camera starts afresh where the hero is)\n2293\t    return this;\n2294\t  }\n2295\t\n2296\t  /* ---- the level, as the game asks about it ---- */\n2297\t  /** the ground's height at (x, y) (a floor, a stair, a wall's top; `bottom` over a pit) */\n2298\t  ground(x, y) { return this.level.ground(x, y); }\n2299\t  /** the surface under a body at height z at (x, y): the highest ground or platform top no more than 4 units above it */\n2300\t  floorAt(x, y, z) { return this.level.floorAt(x, y, z); }\n2301\t  /** the top of whatever stands at (x, y) (shots stop below it) */\n2302\t  topH(x, y) { return this.level.topH(x, y); }\n2303\t  /** the character at tile (cx, cy), its legend entry, whether nobody walks there */\n2304\t  tile(cx, cy) { return (this.level.rows[cy] || '')[cx] ?? ''; }\n2305\t  spec(cx, cy) { return this.level.spec(cx, cy); }\n2306\t  solidTile(cx, cy) { return this.level.solidTile(cx, cy); }\n2307\t  /** a new flow field over the walkable grid: flow.to(x, y) aims it, flow.dir(x, y, out) is the way there from (x, y) */\n2308\t  flow() { return this.terrain ? new TerrainFlow() : new Flow(this.level); }\n2309\t  /** a random walkable spot ([x, y]): rnd (E.rng) picks it, at least minDist from (fx, fy) if given */\n2310\t  randomFloor(rnd, minDist = 0, fx = 0, fy = 0) {\n2311\t    const L = this.level;\n2312\t    if (this.terrain) { for (let k = 0; k < 60; k++) { const x = rnd() * L.width, y = rnd() * L.depth; if (!minDist || Math.hypot(x - fx, y - fy) >= minDist) return [x, y]; } return [L.width / 2, L.depth / 2]; }\n2313\t    for (let k = 0; k < 60; k++) {\n2314\t      const cx = (rnd() * L.mw) | 0, cy = (rnd() * L.mh) | 0, i = cy * L.mw + cx;\n2315\t      if (!L.pass[i] || L.kind[i] === STAIRS) continue;\n2316\t      const x = (cx + .2 + rnd() * .6) * T, y = (cy + .2 + rnd() * .6) * T;\n2317\t      if (minDist && Math.hypot(x - fx, y - fy) < minDist) continue;\n2318\t      return [x, y];\n2319\t    }\n2320\t    return [L.width / 2, L.depth / 2];\n2321\t  }\n2322\t  /** a clear straight line from one point to another through the level and platforms (engine units)? */\n2323\t  clear(x0, y0, z0, x1, y1, z1) {\n2324\t    const dx = x1 - x0, dy = y1 - y0, dz = z1 - z0, L = Math.hypot(dx, dy, dz); if (L < 1e-6) return true;\n2325\t    const hit = this.pw.castRay(new RAPIER.Ray({ x: x0, y: y0, z: z0 }, { x: dx / L, y: dy / L, z: dz / L }), L, true, undefined, LEVEL_ONLY);\n2326\t    return !hit && !(this.terrain && this.terrain.rayDist(x0, y0, z0, dx / L, dy / L, dz / L, L) !== null);\n2327\t  }\n2328\t  /** the first thing a ray from (x, y, z) along (dx, dy, dz) meets within len units: { x, y, z (the point), nx, ny, nz\n2329\t   *  (the surface's normal), dist, actor (a hero or mob hit, or null), prop (a crate, barrel, box or block, or null),\n2330\t   *  ground (true: the level or the terrain) } or null. o: { skip: an actor (or several) it passes through (the shooter),\n2331\t   *  level: true (only the level and platforms: a sight line), down: true (bodies laid down count) } */\n2332\t  ray(x, y, z, dx, dy, dz, len, o = {}) {\n2333\t    const l = Math.hypot(dx, dy, dz); if (l < 1e-9 || !(len > 0)) return null; dx /= l; dy /= l; dz /= l;\n2334\t    const skip = o.skip ? (Array.isArray(o.skip) ? o.skip : [o.skip]) : [], skipCol = skip.map(a => a && a.col).filter(Boolean);\n2335\t    const groups = o.level ? LEVEL_ONLY : ig(0xffff, 1 | 2 | 4 | 8 | 16 | 64 | (o.down ? 32 : 0));\n2336\t    const pred = skipCol.length > 1 ? c => !skipCol.includes(c) : undefined;\n2337\t    const h = this.pw.castRayAndGetNormal(new RAPIER.Ray({ x, y, z }, { x: dx, y: dy, z: dz }), len, true, RAPIER.QueryFilterFlags.EXCLUDE_SENSORS, groups, skipCol.length === 1 ? skipCol[0] : undefined, undefined, pred);\n2338\t    let t = h ? h.timeOfImpact : null, owner = h ? this._owners.get(h.collider.handle) : null, n = h ? [h.normal.x, h.normal.y, h.normal.z] : null;\n2339\t    if (this.terrain) {   // the ground beyond the colliders made so far (and under them: the same triangles)\n2340\t      const tt = this.terrain.rayDist(x, y, z, dx, dy, dz, t === null ? len : t);\n2341\t      if (tt !== null && (t === null || tt < t - .01)) { t = tt; owner = this.terrain; n = this.terrain.normal(x + dx * tt, y + dy * tt, [0, 0, 1]); }\n2342\t    }\n2343\t    if (t === null) return null;\n2344\t    const isActor = owner instanceof Actor;\n2345\t    return { x: x + dx * t, y: y + dy * t, z: z + dz * t, nx: n[0], ny: n[1], nz: n[2], dist: t, actor: isActor ? owner : null, prop: owner && !isActor && owner !== this.terrain ? owner : null, ground: !owner || owner === this.terrain };\n2346\t  }\n2347\t  /** an invisible fixed collider (a tree's trunk, a building's wall drawn your own way): { x, y, z (its base), w, d, h,\n2348\t   *  yaw } a box, or { x, y, z, r, h } a standing cylinder; it is in world.blocks until world.remove(it) or a reset */\n2349\t  block(o) {\n2350\t    const h = o.h || 16, z = (o.z ?? this.floorAt(o.x, o.y)) + h / 2, yaw = o.yaw || 0;\n2351\t    const body = this.pw.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(o.x, o.y, z).setRotation(o.r ? Z_UP : { x: 0, y: 0, z: Math.sin(yaw / 2), w: Math.cos(yaw / 2) }));\n2352\t    const desc = o.r ? RAPIER.ColliderDesc.cylinder(h / 2, o.r) : RAPIER.ColliderDesc.cuboid((o.w || 16) / 2, (o.d || 16) / 2, h / 2);\n2353\t    const col = this.pw.createCollider(desc.setFriction(o.friction ?? .6).setCollisionGroups(GROUPS.level), body);\n2354\t    const b = { isBlock: true, kind: 'block', x: o.x, y: o.y, z: z - h / 2, w: o.w || o.r * 2, d: o.d || o.r * 2, h, yaw, body, col, data: o.data || {} };\n2355\t    this._owners.set(col.handle, b); this.blocks.push(b); return b;\n2356\t  }\n2357\t\n2358\t  /* ---- actors ---- */\n2359\t  /** a hero: { x, y (where it starts; on the floor there), rig, r (4.5), half (9), facing, trail, look, fly } */\n2360\t  hero(o = {}) {\n2361\t    const a = new Actor(this, 'hero', o), pw = this.pw, z = o.z ?? this.floorAt(a.x, a.y);\n2362\t    a.body = pw.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(a.x, a.y, z + a.foot + .4));\n2363\t    a.col = pw.createCollider((a.half ? RAPIER.ColliderDesc.capsule(a.half, a.r).setRotation(Z_UP) : RAPIER.ColliderDesc.ball(a.r)).setCollisionGroups(GROUPS.hero), a.body);\n2364\t    const cc = a.cc = pw.createCharacterController(.3);\n2365\t    cc.setUp({ x: 0, y: 0, z: 1 }); cc.enableSnapToGround(o.snap ?? 4); cc.enableAutostep(o.step ?? 4, 2, false); cc.setMaxSlopeClimbAngle((o.slope ?? 50) * DEG); cc.setSlideEnabled(true);\n2366\t    cc.setApplyImpulsesToDynamicBodies(true); cc.setCharacterMass(o.mass ?? 2500);\n2367\t    a.z = z; a.grounded = true; this.actors.push(a); this._owners.set(a.col.handle, a);\n2368\t    return a;\n2369\t  }\n2370\t  /** a mob: { x, y, rig | blob | orb, r, half, mass, fly (no gravity: it holds its own height), facing, look } */\n2371\t  mob(o = {}) {\n2372\t    const a = new Actor(this, 'mob', o), pw = this.pw, z = o.z ?? this.floorAt(a.x, a.y) + (a.fly ? 20 : 0);\n2373\t    const desc = RAPIER.RigidBodyDesc.dynamic().setTranslation(a.x, a.y, z + a.foot).lockRotations().setCanSleep(true).setLinearDamping(o.damping ?? 0);\n2374\t    if (a.fly) desc.setGravityScale(0);\n2375\t    a.body = pw.createRigidBody(desc);\n2376\t    const shape = a.half ? RAPIER.ColliderDesc.capsule(a.half, a.r).setRotation(Z_UP) : RAPIER.ColliderDesc.ball(a.r);\n2377\t    a.col = pw.createCollider(shape.setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setRestitution(0).setDensity(a.mass).setCollisionGroups(a.fly ? GROUPS.flyer : GROUPS.mob), a.body);\n2378\t    a.z = z; this.actors.push(a); this._owners.set(a.col.handle, a);\n2379\t    return a;\n2380\t  }\n2381\t  /** a vehicle (section 8b): { kind: 'kart' | 'car' | 'hover', x, y, z, angle, rig (its driver, seated), color, the\n2382\t   *  kind's handling with yours over it (top, accel, brake, reverse, turn, grip, drift, drag, hop, seat, float),\n2383\t   *  surfaces, ground: (x, y) => tag (else a track's, the level's ground under it) } -> a vehicle (an actor: world.actors) */\n2384\t  vehicle(o = {}) {\n2385\t    const K = VEHICLES[o.kind] ? o.kind : 'kart', v = new Vehicle(this, Object.assign({}, VEHICLES[K], o, { kind: K })), pw = this.pw;\n2386\t    let z = o.z ?? this.floorAt(v.x, v.y); if (o.z === undefined) for (const t of this.tracks) { const q = t.where(v.x, v.y); if (Math.abs(q.across) <= t.o.width / 2 + t.o.kerb) z = Math.max(z, q.z); }   // (on a track: on its road)\n2387\t    const desc = RAPIER.RigidBodyDesc.dynamic().setTranslation(v.x, v.y, z + v.r + .2).lockRotations().setCcdEnabled(true).setCanSleep(false);\n2388\t    if (v.o.float) desc.setGravityScale(0);\n2389\t    v.z = z; v.body = pw.createRigidBody(desc);\n2390\t    v.col = pw.createCollider(RAPIER.ColliderDesc.ball(v.r).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setRestitution(.2).setDensity(v.o.mass).setCollisionGroups(GROUPS.mob), v.body);\n2391\t    v.sink = -v.o.seat; this.actors.push(v); this._owners.set(v.col.handle, v);\n2392\t    return v;\n2393\t  }\n2394\t  /** a flyer (section 8b): { x, y, z, yaw, speed, min, max, turn, climb, bank, invert, low, bounds | rail: { path, speed,\n2395\t   *  w, h, slide } } -> a flyer (world.flyers; gone with a reset) */\n2396\t  flyer(o = {}) { const f = new Flyer(this, o); this.flyers.push(f); return f; }\n2397\t  /** a track: a road along a path, with its walls (section 8c) */\n2398\t  track(o) { const t = new Track(this, o); this.tracks.push(t); return t; }\n2399\t  /** another camera (a split screen's: viewport i draws through world.cameras[i]); o as the world's camera option */\n2400\t  addCamera(o = {}) { const c = new Camera3D(this, Object.assign({ far: this.camera.far }, o)); this.cameras.push(c); return c; }\n2401\t  /** the ground's surface tag at (x, y): a track's, else the level's ground under it (a terrain: null) */\n2402\t  _surfaceAt(x, y, z) {\n2403\t    for (const t of this.tracks) { const s = t.surface(x, y, z); if (s) return s; }\n2404\t    if (this.terrain) return null;\n2405\t    const sp = this.level.spec(Math.floor(x / T), Math.floor(y / T)); return sp ? sp.ground || this.level.def.ground || null : null;\n2406\t  }\n2407\t  /** take an actor, prop, platform or thing out of the world */\n2408\t  remove(x) {\n2409\t    if (!x) return;\n2410\t    const from = x instanceof Actor ? this.actors : x.isThing ? this.things : x.isPlatform ? this.platforms : x.isShape ? this.shapes : x.isBlock ? this.blocks : this.props, i = from.indexOf(x);\n2411\t    if (x.col) this._owners.delete(x.col.handle);\n2412\t    if (i >= 0) from.splice(i, 1); else if (x.isShape) return;\n2413\t    if (x.body && this.pw) { try { this.pw.removeRigidBody(x.body); } catch (e) { /* gone with a reset */ } x.body = null; }\n2414\t    if (x.isShape) this._shapeKit.take(x.kind, x);\n2415\t    if (x.mesh) { this.scene.remove(x.mesh); x.mesh = null; }\n2416\t  }\n2417\t  /** actors of a kind ('hero' | 'mob' | null for all) within r of (x, y) (and of z when given: 24 up or down) */\n2418\t  near(x, y, r, kind = null, z = null) {\n2419\t    const out = [];\n2420\t    for (const a of this.actors) if ((!kind || a.kind === kind) && Math.hypot(a.x - x, a.y - y) < r && (z === null || Math.abs(a.z - z) < 24)) out.push(a);\n2421\t    return out;\n2422\t  }\n2423\t\n2424\t  /* ---- props: crates and barrels are dynamic bodies (swings, bolts and the crowd knock them about); boxes are yours ---- */\n2425\t  /** a crate (12 units) at (x, y), on the floor there or at height z */\n2426\t  crate(x, y, z, yaw = 0) { return this._prop('crate', x, y, z ?? this.floorAt(x, y) + 6.1, yaw, RAPIER.ColliderDesc.cuboid(6, 6, 6)); }\n2427\t  /** a barrel (12 across, 14 tall) */\n2428\t  barrel(x, y, z, yaw = 0) { return this._prop('barrel', x, y, z ?? this.floorAt(x, y) + 7.1, yaw, RAPIER.ColliderDesc.cylinder(7, 6), true); }\n2429\t  /** a box: { x, y, z (its base), w, d, h, color, side (a SIDE look), fixed (it never moves), mass } */\n2430\t  box(o) {\n2431\t    const w = o.w || 16, d = o.d || 16, hh = o.h || 16, z = (o.z ?? this.floorAt(o.x, o.y)) + hh / 2;\n2432\t    const p = this._prop('box', o.x, o.y, z, o.yaw || 0, RAPIER.ColliderDesc.cuboid(w / 2, d / 2, hh / 2), false, o.fixed, o.mass);\n2433\t    const style = o.side || 'block', S = SIDE[style] || SIDE.block, c = sideColors(style, o), m = this._mat('box:' + style + JSON.stringify(c), () => lambert(this._own(bake((x, y) => S.fn(x, y, c), S.w, S.h))));\n2434\t    p.mesh = new THREE.Mesh(this._own(boxGeo(w, d, hh)), m); p.mesh.castShadow = p.mesh.receiveShadow = true; this.scene.add(p.mesh);\n2435\t    return p;\n2436\t  }\n2437\t  _prop(kind, x, y, z, yaw, shape, upright = false, fixed = false, mass = .5) {\n2438\t    const half = yaw / 2, rot = upright ? Z_UP : { x: 0, y: 0, z: Math.sin(half), w: Math.cos(half) };\n2439\t    const body = this.pw.createRigidBody((fixed ? RAPIER.RigidBodyDesc.fixed() : RAPIER.RigidBodyDesc.dynamic()).setTranslation(x, y, z).setRotation(rot).setLinearDamping(.3).setAngularDamping(.8));\n2440\t    const col = this.pw.createCollider(shape.setDensity(mass).setFriction(.7).setRestitution(.05).setCollisionGroups(fixed ? GROUPS.level : GROUPS.prop), body);\n2441\t    const p = { kind, x, y, z, q: [rot.x, rot.y, rot.z, rot.w], body, col, hit: 0, mesh: null, data: {} };\n2442\t    this._owners.set(col.handle, p);\n2443\t    this.props.push(p); return p;\n2444\t  }\n2445\t  /** knock a prop: a push of dv units a second away from (fx, fy), and up by up */\n2446\t  knock(p, fx, fy, dv, up = 0) {\n2447\t    if (!p.body || p.body.isFixed()) return;\n2448\t    const dx = p.x - fx, dy = p.y - fy, d = Math.hypot(dx, dy) || 1, m = p.body.mass();\n2449\t    p.body.applyImpulse({ x: dx / d * dv * m, y: dy / d * dv * m, z: up * m }, true);\n2450\t    p.body.applyTorqueImpulse({ x: -dy / d * m * 40, y: dx / d * m * 40, z: m * 20 }, true);\n2451\t    p.hit = 10;\n2452\t  }\n2453\t\n2454\t  /* ---- platforms that move: { x, y, z (its top), w, d, h (6), path: [[x, y, z], ...] (its top's points; it goes there\n2455\t   *      and back, or round with loop: true), speed (units a second), wait (seconds at each end), side, color } ---- */\n2456\t  platform(o) {\n2457\t    const w = o.w || 32, d = o.d || 32, hh = o.h || 6, path = (o.path || [[o.x, o.y, o.z]]).map(p => [p[0], p[1], p[2]]);\n2458\t    const [x, y, z] = path[0], body = this.pw.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x, y, z - hh / 2));\n2459\t    this.pw.createCollider(RAPIER.ColliderDesc.cuboid(w / 2, d / 2, hh / 2).setFriction(1).setCollisionGroups(GROUPS.platform), body);\n2460\t    let len = 0; const seg = [0]; for (let i = 1; i < path.length; i++) seg.push(len += Math.hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1], path[i][2] - path[i - 1][2]));\n2461\t    if (o.loop) { const a = path[path.length - 1], b = path[0]; seg.push(len += Math.hypot(b[0] - a[0], b[1] - a[1], b[2] - a[2])); path.push(b); }\n2462\t    const style = o.side || 'planks', S = SIDE[style] || SIDE.block, c = sideColors(style, o);\n2463\t    const top = this._mat('ptop:' + style + JSON.stringify(c), () => { const tc = Object.assign({}, c, { side: c.hi, hi: H(E.shade(o.color || STYLE_COLORS[style] || '#8f5f37', .3)) }); return lambert(this._own(bake((x2, y2) => S.fn(x2, y2, tc), S.w, S.h))); });\n2464\t    const mesh = new THREE.Mesh(this._own(sidesThenTops(boxGeo(w, d, hh))), [this._mat('box:' + style + JSON.stringify(c), () => lambert(this._own(bake((x2, y2) => S.fn(x2, y2, c), S.w, S.h)))), top]);\n2465\t    mesh.castShadow = mesh.receiveShadow = true; this.scene.add(mesh);\n2466\t    const p = { isPlatform: true, x, y, z, w, d, h: hh, path, seg, len, loop: !!o.loop, speed: o.speed || 30, wait: o.wait ?? .6, s: 0, dir: 1, hold: 0, dx: 0, dy: 0, dz: 0, body, mesh, data: o.data || {} };\n2467\t    this.platforms.push(p); return p;\n2468\t  }\n2469\t  _movePlatform(p, dt) {\n2470\t    if (p.len > 0) {\n2471\t      if (p.hold > 0) p.hold -= dt;\n2472\t      else {\n2473\t        p.s += p.speed * dt * p.dir;\n2474\t        if (p.loop) { if (p.s >= p.len) p.s -= p.len; }\n2475\t        else if (p.s >= p.len) { p.s = p.len; p.dir = -1; p.hold = p.wait; } else if (p.s <= 0) { p.s = 0; p.dir = 1; p.hold = p.wait; }\n2476\t      }\n2477\t    }\n2478\t    let i = 1; while (i < p.seg.length - 1 && p.seg[i] < p.s) i++;\n2479\t    const a = p.path[i - 1], b = p.path[i] || a, k = p.seg[i] > p.seg[i - 1] ? (p.s - p.seg[i - 1]) / (p.seg[i] - p.seg[i - 1]) : 0;\n2480\t    const x = lerp(a[0], b[0], k), y = lerp(a[1], b[1], k), z = lerp(a[2], b[2], k);\n2481\t    p.dx = x - p.x; p.dy = y - p.y; p.dz = z - p.z; p.x = x; p.y = y; p.z = z;\n2482\t  }\n2483\t\n2484\t  /* ---- things (section 5) ---- */\n2485\t  /** a thing of a kind (World3D.THINGS) at (x, y) on the floor there or at z: { yaw, spin, bob, size, color, open, on,\n2486\t   *  solid (true or [w, d, h]: a fixed block where it stands, as a door or chest has), data } */\n2487\t  thing(kind, x, y, z, o = {}) {\n2488\t    if (!THINGS[kind]) E.warn('3d:thing:' + kind, 'unknown thing \"' + kind + '\". Things: ' + Object.keys(THINGS).join(', ') + ' (add one: E.World3D.THINGS.' + kind + ' = (pen, t) => ...)');\n2489\t    const t = Object.assign({ isThing: true, kind, x, y, z: z ?? this.floorAt(x, y), yaw: 0, spin: 0, bob: 0, size: 1, open: 0, on: false, visible: true, t: 0, r: (THING_R[kind] || 6) * (o.size || 1), data: {}, body: null }, o);\n2490\t    if (t.solid) this.setSolid(t, true);\n2491\t    this.things.push(t); return t;\n2492\t  }\n2493\t  /** a thing's block on (a door shut, a chest) or off (open): a fixed collider of its solid size where it stands */\n2494\t  setSolid(t, on) {\n2495\t    if (t.body) { this.pw.removeRigidBody(t.body); t.body = null; }\n2496\t    if (on) {\n2497\t      const s = Array.isArray(t.solid) ? t.solid : t.kind === 'door' ? [(t.w || 32) + 8, 8, (t.h || 40) + 4] : t.kind === 'chest' ? [14, 10, 10] : [t.r * 2, t.r * 2, 12];\n2498\t      t.body = this.pw.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(t.x, t.y, t.z + s[2] / 2).setRotation({ x: 0, y: 0, z: Math.sin(t.yaw / 2), w: Math.cos(t.yaw / 2) }));\n2499\t      this.pw.createCollider(RAPIER.ColliderDesc.cuboid(s[0] / 2, s[1] / 2, s[2] / 2).setCollisionGroups(GROUPS.level), t.body);\n2500\t    }\n2501\t    t.solid = on ? (t.solid || true) : false;\n2502\t    return t;\n2503\t  }\n2504\t  /** the things (of a kind, or any) an actor touches: within its radius plus theirs, and 20 units up or down */\n2505\t  touching(a, kind = null) {\n2506\t    const out = [];\n2507\t    for (const t of this.things) if (t.visible && (!kind || t.kind === kind) && Math.hypot(t.x - a.x, t.y - a.y) < a.r + t.r && t.z + t.bob + 2 > a.z - 6 && t.z < a.z + 2 * a.foot + 4) out.push(t);\n2508\t    return out;\n2509\t  }\n2510\t  /** the nearest thing an actor can reach in front of it (a door, a chest, a trunk, a lever, a key: what a check or use\n2511\t   *  button acts on): within range of its edge (a door's whole width counts), in front (60 degrees either way) and 20\n2512\t   *  units up or down; kinds: a list of kinds, or any. Returns the thing or null */\n2513\t  reach(a, range = 14, kinds = null) {\n2514\t    let best = null, bd = 1e9; const fx = Math.cos(a.facing), fy = Math.sin(a.facing);\n2515\t    for (const t of this.things) {\n2516\t      if (!t.visible || (kinds && !kinds.includes(t.kind)) || Math.abs(t.z - a.z) > 20) continue;\n2517\t      // the nearest point of it: along a door's width, else its centre less its radius\n2518\t      const c = Math.cos(t.yaw), s = Math.sin(t.yaw), dx = t.x - a.x, dy = t.y - a.y, hw = t.kind === 'door' ? (t.w || 32) / 2 : 0, lx = clamp(-(dx * c + dy * s), -hw, hw);\n2519\t      const px = dx + lx * c, py = dy + lx * s, d = Math.hypot(px, py) - (hw ? 4 : t.r * .6) - a.r;\n2520\t      if (d > range || (Math.hypot(px, py) > 3 && (px * fx + py * fy) < .5 * Math.hypot(px, py))) continue;\n2521\t      if (d < bd) { bd = d; best = t; }\n2522\t    }\n2523\t    return best;\n2524\t  }\n2525\t  /** a locked door (door.locked: the id of the key it takes) and an inventory (E.RPG's, or anything with has and remove):\n2526\t   *  'open' (not locked), 'unlocked' (the key used up, or kept with o.keep: door.locked is null now) or 'locked' (no key) */\n2527\t  unlock(door, inv, o = {}) {\n2528\t    const k = door.locked; if (!k) return 'open'; if (!inv || !inv.has(k)) return 'locked';\n2529\t    if (!o.keep) inv.remove(k, 1); door.locked = null; return 'unlocked';\n2530\t  }\n2531\t  /** the door opening between rooms (Resident Evil's): the camera cuts to the door from the actor's side, the door swings\n2532\t   *  open away from it as the camera goes through, then the actor stands on the far side (o.to: [x, y], else o.dist: 22\n2533\t   *  units past the door), facing in, the door shut behind it, and the camera cuts back to its mode. Takes o.time (1.6)\n2534\t   *  seconds of world.step, in which nothing else moves: world.passing is set (skip your rules), o.then(door) runs at the\n2535\t   *  end. False while another passing plays */\n2536\t  through(door, a, o = {}) {\n2537\t    if (this.passing) return false;\n2538\t    const nx = -Math.sin(door.yaw), ny = Math.cos(door.yaw), side = (a.x - door.x) * nx + (a.y - door.y) * ny >= 0 ? 1 : -1, d = o.dist ?? 22;\n2539\t    this.passing = { door, a, t: 0, time: o.time ?? 1.6, side, nx, ny, to: o.to || [door.x - nx * side * d, door.y - ny * side * d], then: o.then || null, vis: a.visible };\n2540\t    door.swingTo = -side; a.vx = a.vy = 0; a.visible = false; a.facing = Math.atan2(-ny * side, -nx * side); this.camera._cutNow(); this.camera._hold = null;\n2541\t    return true;\n2542\t  }\n2543\t  _pass(dt) {\n2544\t    const P = this.passing, u = (P.t += dt) / P.time, D = P.door;\n2545\t    D.open = clamp(u < .5 ? u * 2 : (1 - u) / .15, 0, 1);\n2546\t    if (u < 1) return;\n2547\t    this.passing = null; D.open = 0; P.a.visible = P.vis; P.a.place(P.to[0], P.to[1]);\n2548\t    this.camera._cutNow(); this.camera.zone = null;   // (the camera picks its zone afresh where the actor stands)\n2549\t    if (P.then) P.then(D);\n2550\t  }\n2551\t\n2552\t  /* ---- shapes (section 5b) ---- */\n2553\t  /** a shape (an E.SHAPES id, a store set's 'SET:id' after E.addAssets, or an entry) standing at (x, y), on the floor\n2554\t   *  there or at z, with the 2D placement's options and units: { facing (where its front points; PI/2 south), scale,\n2555\t   *  mats, flip, params, solid (default true: a fixed collider from the box map.solid uses; false: bodies pass) } -> its\n2556\t   *  placement { id, x, y, z, facing, scale, body }; null for an unknown shape. world.remove(it) takes it away */\n2557\t  shape(id, x, y, z, o = {}) {\n2558\t    const K = this._shapeKit.kind(id, o); if (!K) return null;\n2559\t    const p = { isShape: true, id, x, y, z: z ?? this.floorAt(x, y), facing: o.facing ?? Math.PI / 2, scale: o.scale || 1, kind: K, i: K.list.length, body: null, data: o.data || {} };\n2560\t    K.list.push(p); this._shapeKit.put(K, p); this.shapes.push(p);\n2561\t    if (o.solid !== false) {   // the 2D engine's box: its footprint turned with it, from its base to its top\n2562\t      const b = E.shapeBox(id, x, y, p.z, o), hz = Math.max(.5, (b.top - p.z) / 2), a = Math.atan2(b.s, b.c);\n2563\t      p.body = this.pw.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(b.x, b.y, p.z + hz).setRotation({ x: 0, y: 0, z: Math.sin(a / 2), w: Math.cos(a / 2) }));\n2564\t      this.pw.createCollider(RAPIER.ColliderDesc.cuboid(Math.max(.5, b.hx), Math.max(.5, b.hy), hz).setCollisionGroups(GROUPS.level), p.body);\n2565\t    }\n2566\t    return p;\n2567\t  }\n2568\t\n2569\t  /* ---- a step of the game: platforms, the heroes' controllers, the mobs' wishes, Rapier, then where all is ---- */\n2570\t  /** advance the world by dt (the game's fixed step): call it once in your scene's update, after your rules */\n2571\t  step(dt) {\n2572\t    if (!(dt > 0)) { this._stepAt = -1; for (const c of this.cameras) c.update(0); return; }   // (time stopped: frames show the last step as it is)\n2573\t    const t0 = performance.now(), pw = this.pw;\n2574\t    this.time += dt; this.n++;\n2575\t    for (const a of this.actors) (a._ip || (a._ip = [0, 0, 0, 0])).splice(0, 4, a.x, a.y, a.z || 0, a.rig ? a.rig.facing : a.facing || 0);   // (where each was, and its facing, before the step: a frame between steps draws them part way)\n2576\t    for (const q of this.platforms) (q._ip || (q._ip = [0, 0, 0])).splice(0, 3, q.x, q.y, q.z);\n2577\t    for (const c of this.cameras) c._was = c.pose; this._stepAt = this.game.real;\n2578\t    if (this.passing) { this._pass(dt); for (const c of this.cameras) { c.update(dt); c._stepPose = c.pose; } return; }   // (a door between rooms: the rest holds still)\n2579\t    if (this.level.stream) this.level.stream(this);   // (a terrain: the heightfields near the actors)\n2580\t    // where the platforms go this step (worked out first, given to Rapier after the heroes' controllers have looked:\n2581\t    // a controller that saw a platform's next place would carry its rider some steps and not others)\n2582\t    for (const p of this.platforms) this._movePlatform(p, dt);\n2583\t    for (const a of this.actors) {\n2584\t      if (!a.body) continue;\n2585\t      if (a.kind === 'hero') this._moveHero(a, dt);\n2586\t      else if (a.vx !== a._rv[0] || a.vy !== a._rv[1] || a.vz !== a._rv[2]) a.body.setLinvel({ x: a.vx, y: a.vy, z: a.vz }, true);\n2587\t    }\n2588\t    for (const p of this.platforms) p.body.setNextKinematicTranslation({ x: p.x, y: p.y, z: p.z - p.h / 2 });\n2589\t    pw.timestep = dt; pw.step();\n2590\t    this._readBack(dt);\n2591\t    for (const c of this.cameras) { c.update(dt); c._stepPose = c.pose; }\n2592\t    this.stats.physicsMs = performance.now() - t0;\n2593\t  }\n2594\t  _moveHero(a, dt) {\n2595\t    if (!a.fly) a.vz = Math.max(-600, a.vz - this.gravity * dt);\n2596\t    a.cc.computeColliderMovement(a.col, { x: a.vx * dt, y: a.vy * dt, z: a.vz * dt }, RAPIER.QueryFilterFlags.EXCLUDE_SENSORS, HERO_QUERY);\n2597\t    let m = a.cc.computedMovement(); const p = a.body.translation(), on = a.on, ground = a.cc.computedGrounded() || (on && a.vz <= 0);\n2598\t    // Rapier's controller, pressed by a step's gravity into a floor it already touches (a hit at time 0), now and then\n2599\t    // slides nowhere: a walking hero stopped dead for a step every few seconds. Then the move is tried along the floor\n2600\t    const want = Math.hypot(a.vx, a.vy) * dt;\n2601\t    if (ground && a.vz <= 0 && want > .02 && Math.hypot(m.x, m.y) < want * .01) { a.cc.computeColliderMovement(a.col, { x: a.vx * dt, y: a.vy * dt, z: 0 }, RAPIER.QueryFilterFlags.EXCLUDE_SENSORS, HERO_QUERY); m = a.cc.computedMovement(); }\n2602\t    if (ground && a.vz <= 0) a.vz = 0;\n2603\t    if (!ground && a.vz > 0 && m.z < a.vz * dt * .5) a.vz = 0;   // a head bump\n2604\t    a.landed = ground && !a.grounded; a.grounded = !!ground;\n2605\t    // carried by the moving platform under it: the platform's step added to the hero's own, unless the controller has\n2606\t    // added it already (Rapier's controller follows a moving floor on some steps and not others)\n2607\t    let cx = 0, cy = 0, cz = 0;\n2608\t    if (on && Math.hypot(m.x - a.vx * dt - on.dx, m.y - a.vy * dt - on.dy) > .02) { cx = on.dx; cy = on.dy; cz = on.dz; }\n2609\t    a.body.setNextKinematicTranslation({ x: p.x + m.x + cx, y: p.y + m.y + cy, z: p.z + m.z + cz });\n2610\t  }\n2611\t  _readBack(dt) {\n2612\t    const L = this.level;\n2613\t    for (const a of this.actors) {\n2614\t      if (!a.body) continue;\n2615\t      const p = a.body.translation();\n2616\t      a.x = p.x; a.y = p.y;\n2617\t      if (a.kind === 'hero') {\n2618\t        a.z = p.z - a.foot - .3;\n2619\t        if (a.grounded) { const f = this.floorAt(a.x, a.y, a.z + 2); if (Math.abs(a.z - f) < 1.5) a.z = f; }   // (feet on the floor, not the controller's skin above it)\n2620\t      } else {\n2621\t        const v = a.body.linvel(); a.z = p.z - a.foot;\n2622\t        const pvz = a.vz; a.vx = v.x; a.vy = v.y; a.vz = v.z;\n2623\t        const was = a.grounded; a.grounded = a.fly || (Math.abs(a.vz) < 6 && (a.z - this.floorAt(a.x, a.y, a.z + 1) < 2 || Math.abs(a.vz - pvz) < 1)); a.landed = a.grounded && !was;\n2624\t        a._rv[0] = a.vx; a._rv[1] = a.vy; a._rv[2] = a.vz;\n2625\t        if (a.isVehicle) vehicleGround(this, a, dt);\n2626\t      }\n2627\t      a.fell = a.z < L.bottom + 8;\n2628\t      // standing on a moving platform (it carries a hero: world.step adds its motion)\n2629\t      a.on = null;\n2630\t      for (const q of this.platforms) if (Math.abs(a.x - q.x) < q.w / 2 + a.r * .5 && Math.abs(a.y - q.y) < q.d / 2 + a.r * .5 && Math.abs(a.z - q.z) < 2.5 && a.vz <= 1) { a.on = q; break; }\n2631\t      if (a.pose) this._pose(a, dt);\n2632\t    }\n2633\t    for (const p of this.props) {\n2634\t      if (!p.body) continue;\n2635\t      const q = p.body.translation(), r = p.body.rotation(); p.x = q.x; p.y = q.y; p.z = q.z; p.q[0] = r.x; p.q[1] = r.y; p.q[2] = r.z; p.q[3] = r.w; if (p.hit) p.hit--;\n2636\t      p.fell = q.z < L.bottom;\n2637\t    }\n2638\t    for (const t of this.things) t.t += dt;\n2639\t  }\n2640\t  /** pose an actor's rig (or blob) from its motion and its anim (world.step does it for every actor with pose on) */\n2641\t  _pose(a, dt) {\n2642\t    if (a.rig) {\n2643\t      const s = Object.assign({ x: a.x, y: a.y, z: a.z, vx: a.vx, vy: a.vy, facing: a.facing, air: !a.grounded && !a.fly }, a.anim);\n2644\t      a.rig.update(dt, s);\n2645\t      const A = s.attack; if (a.rig.capeL && !s.dash && !(A && A.phase === 'active')) settleCape(a.rig, dt, clamp(1 - Math.hypot(a.vx, a.vy) / 60, 0, 1));\n2646\t    } else if (a.blob) a.blob.update(dt, Object.assign({ look: [Math.cos(a.facing), Math.sin(a.facing)] }, a.anim));\n2647\t  }\n2648\t  /** the state's hash: the step count, every actor, prop and platform (positions by their float bits) and your own\n2649\t   *  numbers. The same seed and the same inputs give the same hash on WebGPU, WebGL 2 and run again */\n2650\t  hash(extra = []) {\n2651\t    const list = [this.n, ...extra];\n2652\t    for (const a of this.actors) list.push(a.x, a.y, a.z, a.vx, a.vy);\n2653\t    for (const p of this.props) list.push(p.x, p.y, p.z);\n2654\t    for (const p of this.platforms) list.push(p.x, p.y, p.z);\n2655\t    for (const f of this.flyers) list.push(f.x, f.y, f.z, f.yaw, f.pitch);\n2656\t    return hashNumbers(list);\n2657\t  }\n2658\t}\n2659\t/** a cape at rest in 3D: its chains settle behind and below the shoulders (w: how much, 0 moving fast .. 1 still) */\n2660\tfunction settleCape(rig, dt, w) {\n2661\t  const k = Math.min(1, dt * 16 * w), fx = Math.cos(rig.facing), fy = Math.sin(rig.facing), seg = (rig.o.cape && rig.o.cape.seg) || 2.5;\n2662\t  for (const ch of [rig.capeL, rig.capeR]) ch.forEach((n, i) => {\n2663\t    n.x = lerp(n.x, ch[0].x - fx * i * .5, k); n.y = lerp(n.y, ch[0].y - fy * i * .5, k); n.z = lerp(n.z, ch[0].z - i * seg, k);\n2664\t    if (n.px !== undefined) { n.px = lerp(n.px, n.x, k); n.py = lerp(n.py, n.y, k); n.pz = lerp(n.pz, n.z, k); }\n2665\t  });\n2666\t}\n2667\t\n2668\t/* =============================================================================\n2669\t * 10. DRAWING  effects (arcs and rings on the ground, weapon trails, glows, the game's particles), lights (the torches\n2670\t *     nearest the action, two of them casting shadows; your own; a sun), the sky and fog, then the frame: world.draw(r)\n2671\t * ============================================================================= */\n2672\t/** a pool of flat ground shapes (arcs and rings), each its own mesh so each fades on its own; one material for the pool\n2673\t *  (the color and fade are in the vertices), so a new shape never builds a shader mid-fight */"}]},"parent_tool_use_id":null,"session_id":"4110026b-2798-4dbf-ae8a-e81d8e816e30","uuid":"7ef33c4f-73e2-4dbb-a13a-a1eeded561d0","timestamp":"2026-11-04T01:48:54.901Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/engine/my-3d2dge-3d.js","content":"/* =============================================================================\n * 9. THE WORLD  new E.World3D(game, o) (after await E.World3D.init(game)): a level, its physics, its actors, props,\n *    platforms and things, its lights, sky and camera. world.step(dt) in the game's update, world.draw(r) in its draw\n * ============================================================================= */\nconst RES = ['pixels', 'balanced', 'full'];\nclass World3D {\n  constructor(game, o = {}) {\n    if (!PAGE.ready) throw new Error('my-3D2dge 3D: await E.World3D.init(game) (a boot step) before new E.World3D(game, ...)');\n    if (!o.terrain && (!o.level || !o.level.rows)) throw new Error('my-3D2dge 3D: new E.World3D(game, { level: { rows: [...], legend: {...} } }) needs a level written as text (or { terrain: { height: (x, y) => z, ... } }: an open world)');\n    /** game: the 2D engine's game that runs it; scene: its three.js scene (add your own meshes: E.THREE); o: its options */\n    this.game = game; this.o = o; this.scene = new THREE.Scene(); this._owned = []; this._mats = new Map(); this._objMats = new Set();\n    const st = game.settings || {};\n    /** look: 'card' (each rig drawn by the 2D engine on a card, exactly as in 2D) | 'puppet' (3D parts on its joints);\n     *  res: the picture's resolution: 'pixels' (the game's own pixels: PS1 chunky), 'balanced' (half the screen's) or\n     *  'full'; outlines: an outline round characters and things; gravity: units a second squared (480: the 2D slimes'\n     *  cartoon gravity) */\n    this.look = o.look || st.look3d || 'card'; this.res = RES.includes(o.res) ? o.res : RES.includes(st.picture3d) ? st.picture3d : 'pixels';\n    this.outlines = o.outlines !== false; this.gravity = o.gravity ?? 480; this.shadows = o.shadows ?? (st.shadows3d !== false);\n    /** filter: a look over the whole picture (section 10b): { look: 'clean' | 'cel' | 'pixel', apply, bloom, fxaa, ... } */\n    this.filter = Object.assign({}, FX_DEFAULT, st.filter3d && st.filter3d !== 'clean' ? { look: st.filter3d } : null, o.filter);\n    /** the level: its size (width, depth in units; mw, mh in tiles), bottom (where a fall is lost), marks; terrain: the\n     *  open world's ground (section 3b) when the world was made with one, else null */\n    this._owners = new Map(); this.blocks = [];\n    const L = this.level = o.terrain ? new Terrain(this, o.terrain) : new Level(this, o.level);\n    this.terrain = o.terrain ? L : null;\n    Object.assign(this, { width: L.width, depth: L.depth, mw: L.mw, mh: L.mh, bottom: L.bottom, marks: L.marks, torches: L.torches });\n    /** actors, props, platforms, things: what is in the world now (read them; add and remove with the methods below) */\n    this.actors = []; this.props = []; this.platforms = []; this.things = []; this.shapes = [];\n    /** tracks (world.track), flyers (world.flyer): yours to read */\n    this.tracks = []; this.flyers = [];\n    this.B = makeBatches(this); this.capes = makeCapes(this); this.atlas = makeAtlas(this);\n    /** pen: draw your own 3D shapes for this frame (in draw, before world.draw(r)): world.pen.at(x, y, z, yaw).box(...) */\n    this.pen = new Pen(this); this.pen.B = this.B;\n    this.part = {\n      add: new Batch(this.scene, new THREE.CircleGeometry(1, 6), new THREE.MeshBasicNodeMaterial({ color: '#ffffff', transparent: true, depthWrite: false, blending: THREE.AdditiveBlending }), { order: 4, cap: 2048 }),\n      solid: new Batch(this.scene, new THREE.CircleGeometry(1, 6), this._obj(new THREE.MeshBasicNodeMaterial({ color: '#ffffff' })), { cap: 2048 }),\n      bit: new Batch(this.scene, new THREE.PlaneGeometry(2, 2), this._obj(new THREE.MeshBasicNodeMaterial({ color: '#ffffff' })), { cap: 1024 })\n    };\n    this._arcs = floorPool(this, 12); this._rings = floorPool(this, 24); this._ribbons = ribbons(this);\n    this._propMesh = propMeshes(this); this._shapeKit = shapeKit(this);\n    L.meshes(this);\n    this._lights(o);\n    this._sky(o);\n    /** camera: see section 7 */\n    this.camera = new Camera3D(this, Object.assign({ far: this.terrain ? this.terrain.far * 1.1 : 9600 }, o.camera));\n    /** cameras: the world's cameras, [0] its camera; world.addCamera(o) adds one (a split screen's viewport i draws\n     *  through cameras[i]) */\n    this.cameras = [this.camera];\n    /** overlay: a scene of your own drawn over the world after it (its depth cleared first), from its own camera at the\n     *  origin: a first-person view model (the arms and the gun) that never sinks into a wall. { scene, camera (fov: set\n     *  it), pen (the world's pen, in this scene: engine units round the eye, x ahead, y right, z up), on }; lit by the\n     *  world's sun and sky as the world's camera sees them */\n    if (o.overlay) this._makeOverlay(o.overlay);\n    /** onDraw(world, r): called as each frame starts drawing, before the camera is placed: the game's own 3D drawing\n     *  (world.pen, overlay.pen, glows; a last touch to camera.pose) for every frame, whichever scene draws the world */\n    this.onDraw = o.onDraw || null;\n    /** time: seconds stepped; n: steps; stats: the last frame's numbers (draw calls, triangles, actors drawn, physics\n     *  and draw milliseconds) */\n    this.time = 0; this.n = 0; this.stats = { calls: 0, tris: 0, drawn: 0, culled: 0, physicsMs: 0, drawMs: 0, bodies: 0, frames: 0 };\n    this._queue = { arcs: [], glows: [] }; this._warm = false; this._seen = new Set();\n    PAGE.worlds.add(this);\n    this.reset();\n  }\n  _own(x) { this._owned.push(x); return x; }\n  _mat(key, make) { let m = this._mats.get(key); if (!m) { m = this._own(make()); this._mats.set(key, m); } return m; }\n  _obj(m) { this._objMats.add(m); return m; }\n  /** a fresh physics world: the level's colliders and shapes, nothing else (actors, props, platforms, things and the\n   *  shapes you placed are gone: add them again). The same seed and the same inputs from here give the same state (world.hash) */\n  reset() {\n    if (this.pw) this.pw.free();\n    const pw = this.pw = new RAPIER.World({ x: 0, y: 0, z: -this.gravity });\n    pw.lengthUnit = U; pw.numSolverIterations = this.o.iterations || 4;\n    for (const p of this.platforms) if (p.mesh) this.scene.remove(p.mesh);\n    for (const p of this.props) if (p.mesh) this.scene.remove(p.mesh);\n    this.actors.length = 0; this.props.length = 0; this.platforms.length = 0; this.things.length = 0; this.blocks.length = 0; this._owners.clear();\n    this.level.colliders(pw); for (const t of this.tracks) t._cols(); this.flyers.length = 0;\n    // the level's own shapes (a legend's { shape }) stand again; a game's are gone with the rest\n    this.shapes.length = 0; this._shapeKit.clear(); for (const [id, x, y, z, sp] of this.level.shapes) this.shape(id, x, y, z, sp);\n    this.time = 0; this.n = 0; this.passing = null; if (this.camera) Object.assign(this.camera.unlock(), { focus: null, smooth: null, pose: null, zone: null, cuts: 0, _hold: null, _mv: [0, 0] });   // (the camera starts afresh where the hero is)\n    return this;\n  }\n\n  /* ---- the level, as the game asks about it ---- */\n  /** the ground's height at (x, y) (a floor, a stair, a wall's top; `bottom` over a pit) */\n  ground(x, y) { return this.level.ground(x, y); }\n  /** the surface under a body at height z at (x, y): the highest ground or platform top no more than 4 units above it */\n  floorAt(x, y, z) { return this.level.floorAt(x, y, z); }\n  /** the top of whatever stands at (x, y) (shots stop below it) */\n  topH(x, y) { return this.level.topH(x, y); }\n  /** the character at tile (cx, cy), its legend entry, whether nobody walks there */\n  tile(cx, cy) { return (this.level.rows[cy] || '')[cx] ?? ''; }\n  spec(cx, cy) { return this.level.spec(cx, cy); }\n  solidTile(cx, cy) { return this.level.solidTile(cx, cy); }\n  /** a new flow field over the walkable grid: flow.to(x, y) aims it, flow.dir(x, y, out)