advance(1 / 120); } }\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_012GvSPndBUKu5s4BJj8CCUn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
