i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UvSYdKuR6fUiZGfuCJJ6TA","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"52d403e5-10f6-4db3-8f29-858e2f7759dd","timestamp":"2026-11-04T01:40:17.176Z","tool_use_result":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","oldString":"    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, o.players ? o.players[i] : {}, o.carry ? o.carry[i] : null));\n    this.lastTimeUp = 0;\n    this.enterScene(this.sceneIdx, true);\n  }","newString":"    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }","originalFile":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, o.players ? o.players[i] : {}, o.carry ? o.carry[i] : null));\n    this.lastTimeUp = 0;\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, meta, carry) {\n    const y = (i - (this.players_n_guess(meta) - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[{"oldStart":54,"oldLines":8,"newStart":54,"newLines":7,"lines":["     this.base = this.scene.base;","     this.players = [];","     const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));","-    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, o.players ? o.players[i] : {}, o.carry ? o.carry[i] : null));","-    this.lastTimeUp = 0;","+    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));","     this.enterScene(this.sceneIdx, true);","   }"," "]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01UvSYdKuR6fUiZGfuCJJ6TA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh31rKd4WKZ8e7NR5ZUk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0179mtgsimH3ofBCvCtr7PR3","name":"Edit","input":{"replace_all":false,"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"  makePlayer(i, meta, carry) {\n    const y = (i - (this.players_n_guess(meta) - 1) / 2) * TC.SLOT_GAP;\n    const p = {","new_string":"  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22179,"cache_read_input_tokens":156102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22179},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"4645b1c9-07ed-4484-9856-96e78040e4b8","timestamp":"2026-11-04T01:40:18.405Z","request_id":"req_011Cgh31r2keLssWe2VCPnbR","wire_tool_inputs":{"toolu_0179mtgsimH3ofBCvCtr7PR3":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"  makePlayer(i, meta, carry) {\n    const y = (i - (this.players_n_guess(meta) - 1) / 2) * TC.SLOT_GAP;\n    const p = {","new_string":"  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0179mtgsimH3ofBCvCtr7PR3","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"6fe80182-a99c-4ba7-8560-c783e02d80d7","timestamp":"2026-11-04T01:40:18.426Z","tool_use_result":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","oldString":"  makePlayer(i, meta, carry) {\n    const y = (i - (this.players_n_guess(meta) - 1) / 2) * TC.SLOT_GAP;\n    const p = {","newString":"  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {","originalFile":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, meta, carry) {\n    const y = (i - (this.players_n_guess(meta) - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[{"oldStart":67,"oldLines":8,"newStart":67,"newLines":8,"lines":["   emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }","   drain() { const e = this.events; this.events = []; return e; }"," ","-  makePlayer(i, meta, carry) {","-    const y = (i - (this.players_n_guess(meta) - 1) / 2) * TC.SLOT_GAP;","+  makePlayer(i, n, meta, carry) {","+    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;","     const p = {","       id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',","       slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_0179mtgsimH3ofBCvCtr7PR3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh31rKd4WKZ8e7NR5ZUk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012Gs75Cy7knUULTUUqSmPh2","name":"Edit","input":{"replace_all":false,"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    return p;\n  }\n  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }","new_string":"    return p;\n  }"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22179,"cache_read_input_tokens":156102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22179},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"4945ad92-22ff-47e1-8d06-771b9ee8b3de","timestamp":"2026-11-04T01:40:19.502Z","request_id":"req_011Cgh31r2keLssWe2VCPnbR","wire_tool_inputs":{"toolu_012Gs75Cy7knUULTUUqSmPh2":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    return p;\n  }\n  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }","new_string":"    return p;\n  }"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Gs75Cy7knUULTUUqSmPh2","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"9ef56b41-c942-45fb-8714-a9dd50ef8c44","timestamp":"2026-11-04T01:40:19.521Z","tool_use_result":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","oldString":"    return p;\n  }\n  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }","newString":"    return p;\n  }","originalFile":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[{"oldStart":87,"oldLines":7,"newStart":87,"newLines":6,"lines":["     }","     return p;","   }","-  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }"," ","   // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.","   standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_012Gs75Cy7knUULTUUqSmPh2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh31rKd4WKZ8e7NR5ZUk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015YY4KMuYdCupLEXEy8CP9N","name":"Edit","input":{"replace_all":false,"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }","new_string":"    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.bonus = [];\n    this.waveQueue = this.scene.waves.map(w => Object.assign({}, w, { spawned: false }));\n    this.waveIdx = 0;\n    this.clearing = false;\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    this.placeBonus();\n  }\n\n  // Restart the current area after a wiped-out team's continue: its waves start again, the score kept as it is.\n  restartScene() {\n    for (const p of this.players) { p.out = false; p.dead = false; p.outT = 0; p.lives = this.diff.lives; }\n    this.enterScene(this.sceneIdx, false);\n    this.emit('restart', { scene: this.scene.id });\n  }"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22179,"cache_read_input_tokens":156102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22179},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"460b07fd-2f40-4b52-b36c-26d2514445d7","timestamp":"2026-11-04T01:40:22.830Z","request_id":"req_011Cgh31r2keLssWe2VCPnbR","wire_tool_inputs":{"toolu_015YY4KMuYdCupLEXEy8CP9N":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }","new_string":"    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.bonus = [];\n    this.waveQueue = this.scene.waves.map(w => Object.assign({}, w, { spawned: false }));\n    this.waveIdx = 0;\n    this.clearing = false;\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    this.placeBonus();\n  }\n\n  // Restart the current area after a wiped-out team's continue: its waves start again, the score kept as it is.\n  restartScene() {\n    for (const p of this.players) { p.out = false; p.dead = false; p.outT = 0; p.lives = this.diff.lives; }\n    this.enterScene(this.sceneIdx, false);\n    this.emit('restart', { scene: this.scene.id });\n  }"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015YY4KMuYdCupLEXEy8CP9N","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"95af2748-ab12-4e46-9d14-d365c50bfd84","timestamp":"2026-11-04T01:40:22.850Z","tool_use_result":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","oldString":"    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }","newString":"    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.bonus = [];\n    this.waveQueue = this.scene.waves.map(w => Object.assign({}, w, { spawned: false }));\n    this.waveIdx = 0;\n    this.clearing = false;\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    this.placeBonus();\n  }\n\n  // Restart the current area after a wiped-out team's continue: its waves start again, the score kept as it is.\n  restartScene() {\n    for (const p of this.players) { p.out = false; p.dead = false; p.outT = 0; p.lives = this.diff.lives; }\n    this.enterScene(this.sceneIdx, false);\n    this.emit('restart', { scene: this.scene.id });\n  }","originalFile":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[{"oldStart":109,"oldLines":26,"newStart":109,"newLines":31,"lines":["     this.scene = this.world.scenes[idx];","     this.prevBase = first ? this.scene.base : this.base;","     this.base = this.scene.base;","-    this.waveIdx = 0;","     this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;","     this.timer = this.timeMax;","     this.phase = 'arrive';","     this.phaseT = 0;","-    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);","+    this.enemies = [];","     this.threats = [];","     this.projectiles = [];","-    this.pickups = this.pickups.filter(q => q.keep);","+    this.bonus = [];","+    this.waveQueue = this.scene.waves.map(w => Object.assign({}, w, { spawned: false }));","+    this.waveIdx = 0;","     this.clearing = false;","-    this.spawnedScene = false;","-    this.sceneStart = this.t;","-    this.waveQueue = this.scene.waves.slice();","     this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });","     for (const p of this.players) {","       p.x = this.base; p.c = 0; p.want = false;","     }","-    if (!first) this.prevBase = this.prevBase;","+    this.placeBonus();","   }"," ","+  // Restart the current area after a wiped-out team's continue: its waves start again, the score kept as it is.","+  restartScene() {","+    for (const p of this.players) { p.out = false; p.dead = false; p.outT = 0; p.lives = this.diff.lives; }","+    this.enterScene(this.sceneIdx, false);","+    this.emit('restart', { scene: this.scene.id });","+  }","+","   // The per-step driver. cmds[i] is player i's command (missing = nothing held).","   step(dt, cmds = []) {","     if (this.over || this.frozen) return;"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_015YY4KMuYdCupLEXEy8CP9N","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh31rKd4WKZ8e7NR5ZUk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VeFAE1RNzpzLqtWEE4eyJh","name":"Edit","input":{"replace_all":false,"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);","new_string":"    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: the blend moves toward the held state, in coverIn / coverOut seconds for the full move.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: a threat that would land within 0.15 s of leaving cover lands 0.15 s later.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const full = p.want ? TC.tune.player.coverIn : TC.tune.player.coverOut;\n    const dir = target - p.c, step = dt / full;\n    p.c = Math.abs(dir) <= step ? target : p.c + Math.sign(dir) * step;"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22179,"cache_read_input_tokens":156102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22179},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"781109da-b7c9-4ff2-8178-eb637e07f212","timestamp":"2026-11-04T01:40:26.647Z","request_id":"req_011Cgh31r2keLssWe2VCPnbR","wire_tool_inputs":{"toolu_01VeFAE1RNzpzLqtWEE4eyJh":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);","new_string":"    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: the blend moves toward the held state, in coverIn / coverOut seconds for the full move.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: a threat that would land within 0.15 s of leaving cover lands 0.15 s later.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const full = p.want ? TC.tune.player.coverIn : TC.tune.player.coverOut;\n    const dir = target - p.c, step = dt / full;\n    p.c = Math.abs(dir) <= step ? target : p.c + Math.sign(dir) * step;"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VeFAE1RNzpzLqtWEE4eyJh","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"61f8c0fb-b29f-48c8-b373-170c7ffe0429","timestamp":"2026-11-04T01:40:26.667Z","tool_use_result":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","oldString":"    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);","newString":"    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: the blend moves toward the held state, in coverIn / coverOut seconds for the full move.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: a threat that would land within 0.15 s of leaving cover lands 0.15 s later.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const full = p.want ? TC.tune.player.coverIn : TC.tune.player.coverOut;\n    const dir = target - p.c, step = dt / full;\n    p.c = Math.abs(dir) <= step ? target : p.c + Math.sign(dir) * step;","originalFile":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.bonus = [];\n    this.waveQueue = this.scene.waves.map(w => Object.assign({}, w, { spawned: false }));\n    this.waveIdx = 0;\n    this.clearing = false;\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    this.placeBonus();\n  }\n\n  // Restart the current area after a wiped-out team's continue: its waves start again, the score kept as it is.\n  restartScene() {\n    for (const p of this.players) { p.out = false; p.dead = false; p.outT = 0; p.lives = this.diff.lives; }\n    this.enterScene(this.sceneIdx, false);\n    this.emit('restart', { scene: this.scene.id });\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[{"oldStart":165,"oldLines":22,"newStart":165,"newLines":23,"lines":["     }","     p.invul = Math.max(0, p.invul - dt);","     p.flash = Math.max(0, p.flash - dt);","-    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);","+    p.bloom = Math.max(0, p.bloom - 6 * dt);","     p.recoil = Math.max(0, p.recoil - 6 * dt);","     p.shotT = Math.max(0, p.shotT - dt);","     p.switchT = Math.max(0, p.switchT - dt);","     // Aim: the reticle position in view units, kept on screen.","     if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];","-    // Cover: move the blend toward the held state, at the cover speeds.","+    // Cover: the blend moves toward the held state, in coverIn / coverOut seconds for the full move.","     const wantIn = !!cmd.cover;","     if (wantIn !== p.want) {","       p.want = wantIn;","-      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.","+      // Pop-out protection: a threat that would land within 0.15 s of leaving cover lands 0.15 s later.","       if (!wantIn) this.protectPopOut(p);","     }","     const target = p.want ? 1 : 0;","-    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;","-    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);","+    const full = p.want ? TC.tune.player.coverIn : TC.tune.player.coverOut;","+    const dir = target - p.c, step = dt / full;","+    p.c = Math.abs(dir) <= step ? target : p.c + Math.sign(dir) * step;","     const inCover = p.c >= 0.5;","     if (inCover !== p.wasIn) {","       p.wasIn = inCover;"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01VeFAE1RNzpzLqtWEE4eyJh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh31rKd4WKZ8e7NR5ZUk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RSUPN6L53Fm3WVdPspyxxT","name":"Edit","input":{"replace_all":false,"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }","new_string":"    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    if (canFire && cmd.firePressed) this.tryFire(p, cur, true);\n    else if (canFire && cmd.fire) {\n      // Held: the machine gun fires on its own rate; the handgun auto-repeats when Hold-to-fire is on.\n      if (cur.auto || (cur.id === 'handgun' && this.autoFire)) this.tryFire(p, cur, false);\n    }\n  }"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22179,"cache_read_input_tokens":156102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22179},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"93c96660-48bc-40af-96ed-45a11a150089","timestamp":"2026-11-04T01:40:29.178Z","request_id":"req_011Cgh31r2keLssWe2VCPnbR","wire_tool_inputs":{"toolu_01RSUPN6L53Fm3WVdPspyxxT":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }","new_string":"    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    if (canFire && cmd.firePressed) this.tryFire(p, cur, true);\n    else if (canFire && cmd.fire) {\n      // Held: the machine gun fires on its own rate; the handgun auto-repeats when Hold-to-fire is on.\n      if (cur.auto || (cur.id === 'handgun' && this.autoFire)) this.tryFire(p, cur, false);\n    }\n  }"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RSUPN6L53Fm3WVdPspyxxT","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"f77c6402-938d-45ec-bdaa-a7eb0116fe3e","timestamp":"2026-11-04T01:40:29.189Z","tool_use_result":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","oldString":"    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }","newString":"    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    if (canFire && cmd.firePressed) this.tryFire(p, cur, true);\n    else if (canFire && cmd.fire) {\n      // Held: the machine gun fires on its own rate; the handgun auto-repeats when Hold-to-fire is on.\n      if (cur.auto || (cur.id === 'handgun' && this.autoFire)) this.tryFire(p, cur, false);\n    }\n  }","originalFile":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.bonus = [];\n    this.waveQueue = this.scene.waves.map(w => Object.assign({}, w, { spawned: false }));\n    this.waveIdx = 0;\n    this.clearing = false;\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    this.placeBonus();\n  }\n\n  // Restart the current area after a wiped-out team's continue: its waves start again, the score kept as it is.\n  restartScene() {\n    for (const p of this.players) { p.out = false; p.dead = false; p.outT = 0; p.lives = this.diff.lives; }\n    this.enterScene(this.sceneIdx, false);\n    this.emit('restart', { scene: this.scene.id });\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: the blend moves toward the held state, in coverIn / coverOut seconds for the full move.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: a threat that would land within 0.15 s of leaving cover lands 0.15 s later.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const full = p.want ? TC.tune.player.coverIn : TC.tune.player.coverOut;\n    const dir = target - p.c, step = dt / full;\n    p.c = Math.abs(dir) <= step ? target : p.c + Math.sign(dir) * step;\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[{"oldStart":233,"oldLines":12,"newStart":233,"newLines":11,"lines":["     // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.","     const cur = TC.get('weapon', this.weaponId(p));","     const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';","-    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;","-    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);","-    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);","-    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);","-    p.lastFire = !!cmd.fire;","-    void fireDown;","+    if (canFire && cmd.firePressed) this.tryFire(p, cur, true);","+    else if (canFire && cmd.fire) {","+      // Held: the machine gun fires on its own rate; the handgun auto-repeats when Hold-to-fire is on.","+      if (cur.auto || (cur.id === 'handgun' && this.autoFire)) this.tryFire(p, cur, false);","+    }","   }"," ","   switchTo(p, idx) {"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01RSUPN6L53Fm3WVdPspyxxT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh31rKd4WKZ8e7NR5ZUk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018mnoUdv8Yz5hJbAa7tgTyE","name":"Edit","input":{"replace_all":false,"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;","new_string":"  tryFire(p, w, pressed) {\n    const id = w.id;"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22179,"cache_read_input_tokens":156102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22179},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"42f77f80-a360-41af-911f-2503f8c39610","timestamp":"2026-11-04T01:40:30.390Z","request_id":"req_011Cgh31r2keLssWe2VCPnbR","wire_tool_inputs":{"toolu_018mnoUdv8Yz5hJbAa7tgTyE":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;","new_string":"  tryFire(p, w, pressed) {\n    const id = w.id;"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018mnoUdv8Yz5hJbAa7tgTyE","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"cf393b19-0df4-4146-98e3-5ded234a098a","timestamp":"2026-11-04T01:40:30.401Z","tool_use_result":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","oldString":"  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;","newString":"  tryFire(p, w, pressed) {\n    const id = w.id;","originalFile":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.bonus = [];\n    this.waveQueue = this.scene.waves.map(w => Object.assign({}, w, { spawned: false }));\n    this.waveIdx = 0;\n    this.clearing = false;\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    this.placeBonus();\n  }\n\n  // Restart the current area after a wiped-out team's continue: its waves start again, the score kept as it is.\n  restartScene() {\n    for (const p of this.players) { p.out = false; p.dead = false; p.outT = 0; p.lives = this.diff.lives; }\n    this.enterScene(this.sceneIdx, false);\n    this.emit('restart', { scene: this.scene.id });\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: the blend moves toward the held state, in coverIn / coverOut seconds for the full move.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: a threat that would land within 0.15 s of leaving cover lands 0.15 s later.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const full = p.want ? TC.tune.player.coverIn : TC.tune.player.coverOut;\n    const dir = target - p.c, step = dt / full;\n    p.c = Math.abs(dir) <= step ? target : p.c + Math.sign(dir) * step;\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    if (canFire && cmd.firePressed) this.tryFire(p, cur, true);\n    else if (canFire && cmd.fire) {\n      // Held: the machine gun fires on its own rate; the handgun auto-repeats when Hold-to-fire is on.\n      if (cur.auto || (cur.id === 'handgun' && this.autoFire)) this.tryFire(p, cur, false);\n    }\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[{"oldStart":257,"oldLines":8,"newStart":257,"newLines":7,"lines":[" ","   // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile","   // for the grenade launcher.","-  tryFire(p, w, pressed, canFire) {","-    if (!canFire) return;","+  tryFire(p, w, pressed) {","     const id = w.id;","     if (p.shotT > 0) return;","     if (id === 'handgun') {"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_018mnoUdv8Yz5hJbAa7tgTyE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh31rKd4WKZ8e7NR5ZUk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016zTEGE6Lycc4xYw6FCq55y","name":"Edit","input":{"replace_all":false,"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }","new_string":"  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15;\n    }\n  }"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22179,"cache_read_input_tokens":156102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22179},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"3108b044-13e1-49c3-b25c-fdd99730e394","timestamp":"2026-11-04T01:40:31.912Z","request_id":"req_011Cgh31r2keLssWe2VCPnbR","wire_tool_inputs":{"toolu_016zTEGE6Lycc4xYw6FCq55y":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }","new_string":"  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15;\n    }\n  }"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016zTEGE6Lycc4xYw6FCq55y","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"3530c686-a20b-4afb-8b25-bb8ffec7d57e","timestamp":"2026-11-04T01:40:31.932Z","tool_use_result":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","oldString":"  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }","newString":"  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15;\n    }\n  }","originalFile":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.bonus = [];\n    this.waveQueue = this.scene.waves.map(w => Object.assign({}, w, { spawned: false }));\n    this.waveIdx = 0;\n    this.clearing = false;\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    this.placeBonus();\n  }\n\n  // Restart the current area after a wiped-out team's continue: its waves start again, the score kept as it is.\n  restartScene() {\n    for (const p of this.players) { p.out = false; p.dead = false; p.outT = 0; p.lives = this.diff.lives; }\n    this.enterScene(this.sceneIdx, false);\n    this.emit('restart', { scene: this.scene.id });\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: the blend moves toward the held state, in coverIn / coverOut seconds for the full move.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: a threat that would land within 0.15 s of leaving cover lands 0.15 s later.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const full = p.want ? TC.tune.player.coverIn : TC.tune.player.coverOut;\n    const dir = target - p.c, step = dt / full;\n    p.c = Math.abs(dir) <= step ? target : p.c + Math.sign(dir) * step;\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    if (canFire && cmd.firePressed) this.tryFire(p, cur, true);\n    else if (canFire && cmd.fire) {\n      // Held: the machine gun fires on its own rate; the handgun auto-repeats when Hold-to-fire is on.\n      if (cur.auto || (cur.id === 'handgun' && this.autoFire)) this.tryFire(p, cur, false);\n    }\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed) {\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[{"oldStart":689,"oldLines":7,"newStart":689,"newLines":7,"lines":["   protectPopOut(p) {","     for (const th of this.threats) {","       if (th.resolved || th.target !== p.id) continue;","-      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;","+      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15;","     }","   }"," "]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_016zTEGE6Lycc4xYw6FCq55y","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh31rKd4WKZ8e7NR5ZUk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0114RNdw39u1Ycm1Trz1h83S","name":"Edit","input":{"replace_all":false,"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }","new_string":"    if (p.out) {\n      // Out of lives: the CONTINUE? count runs down; a press of fire or cover rejoins (plan 4.5).\n      if (!p.dead) p.outT -= dt;\n      if ((cmd.firePressed || cmd.coverPressed) && p.outT > 0) {\n        if (this.players.every(q => q.out) && !this.restartPending) { this.restartPending = true; this.rejoin(p); this.restartScene(); this.restartPending = false; }\n        else this.rejoin(p);\n      }\n      if (p.outT <= 0 && !p.dead) { p.dead = true; this.emit('dead', { player: p.id }); }\n      return;\n    }"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22179,"cache_read_input_tokens":156102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22179},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"107f1269-7ea1-4f0a-9105-b052a7e84668","timestamp":"2026-11-04T01:40:34.218Z","request_id":"req_011Cgh31r2keLssWe2VCPnbR","wire_tool_inputs":{"toolu_0114RNdw39u1Ycm1Trz1h83S":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","old_string":"    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }","new_string":"    if (p.out) {\n      // Out of lives: the CONTINUE? count runs down; a press of fire or cover rejoins (plan 4.5).\n      if (!p.dead) p.outT -= dt;\n      if ((cmd.firePressed || cmd.coverPressed) && p.outT > 0) {\n        if (this.players.every(q => q.out) && !this.restartPending) { this.restartPending = true; this.rejoin(p); this.restartScene(); this.restartPending = false; }\n        else this.rejoin(p);\n      }\n      if (p.outT <= 0 && !p.dead) { p.dead = true; this.emit('dead', { player: p.id }); }\n      return;\n    }"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0114RNdw39u1Ycm1Trz1h83S","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"c0420959-f0f4-410a-b862-be6bf5c2135b","timestamp":"2026-11-04T01:40:34.231Z","tool_use_result":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","oldString":"    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }","newString":"    if (p.out) {\n      // Out of lives: the CONTINUE? count runs down; a press of fire or cover rejoins (plan 4.5).\n      if (!p.dead) p.outT -= dt;\n      if ((cmd.firePressed || cmd.coverPressed) && p.outT > 0) {\n        if (this.players.every(q => q.out) && !this.restartPending) { this.restartPending = true; this.rejoin(p); this.restartScene(); this.restartPending = false; }\n        else this.rejoin(p);\n      }\n      if (p.outT <= 0 && !p.dead) { p.dead = true; this.emit('dead', { player: p.id }); }\n      return;\n    }","originalFile":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, n, o.players ? o.players[i] || {} : {}, o.carry ? o.carry[i] : null));\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, n, meta, carry) {\n    const y = (i - (n - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.bonus = [];\n    this.waveQueue = this.scene.waves.map(w => Object.assign({}, w, { spawned: false }));\n    this.waveIdx = 0;\n    this.clearing = false;\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    this.placeBonus();\n  }\n\n  // Restart the current area after a wiped-out team's continue: its waves start again, the score kept as it is.\n  restartScene() {\n    for (const p of this.players) { p.out = false; p.dead = false; p.outT = 0; p.lives = this.diff.lives; }\n    this.enterScene(this.sceneIdx, false);\n    this.emit('restart', { scene: this.scene.id });\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: the blend moves toward the held state, in coverIn / coverOut seconds for the full move.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: a threat that would land within 0.15 s of leaving cover lands 0.15 s later.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const full = p.want ? TC.tune.player.coverIn : TC.tune.player.coverOut;\n    const dir = target - p.c, step = dt / full;\n    p.c = Math.abs(dir) <= step ? target : p.c + Math.sign(dir) * step;\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    if (canFire && cmd.firePressed) this.tryFire(p, cur, true);\n    else if (canFire && cmd.fire) {\n      // Held: the machine gun fires on its own rate; the handgun auto-repeats when Hold-to-fire is on.\n      if (cur.auto || (cur.id === 'handgun' && this.autoFire)) this.tryFire(p, cur, false);\n    }\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed) {\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[{"oldStart":155,"oldLines":12,"newStart":155,"newLines":13,"lines":[" ","   playerStep(p, dt, cmd) {","     if (p.out) {","-      p.outT -= dt;","-      if (cmd.firePressed || cmd.coverPressed) {","-        // A continue: the player can rejoin the fight from its own half.","-        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);","+      // Out of lives: the CONTINUE? count runs down; a press of fire or cover rejoins (plan 4.5).","+      if (!p.dead) p.outT -= dt;","+      if ((cmd.firePressed || cmd.coverPressed) && p.outT > 0) {","+        if (this.players.every(q => q.out) && !this.restartPending) { this.restartPending = true; this.rejoin(p); this.restartScene(); this.restartPending = false; }","+        else this.rejoin(p);","       }","-      if (p.outT <= 0) p.dead = true;","+      if (p.outT <= 0 && !p.dead) { p.dead = true; this.emit('dead', { player: p.id }); }","       return;","     }","     p.invul = Math.max(0, p.invul - dt);"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_0114RNdw39u1Ycm1Trz1h83S","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
