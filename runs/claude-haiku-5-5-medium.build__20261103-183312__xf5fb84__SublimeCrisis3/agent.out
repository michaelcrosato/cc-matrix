(const vp of vps) {\"\"\"),\n])\ns=open('src/41-play.js').read()\ns=s.replace(\"\"\"      TC.drawGlobal(this, g, W, H);\n    });\n  }\"\"\",\"\"\"      TC.drawGlobal(this, g, W, H);\n    });\n    if (this.dialog && this.dialog.open) this.dialog.draw(r);\n  }\"\"\")\nopen('src/41-play.js','w').write(s)\n\npatch('src/00-core.js', [(\"    fov: 55, hitVolumes: false, colliders: false, aiLabels: false, threatDebug: false, perf: false, hideHud: false,\",\n\"    fov: 55, hitVolumes: false, colliders: false, aiLabels: false, threatDebug: false, perf: false, hideHud: false, threatBig: false,\")])\n\npatch('src/50-main.js', [\n(\"\"\"      if (result.won) {\n        if (this.play.sim.stageId === 3 || this.play.sim.stageId === 'range') game.go('results', { result, last: true });\"\"\",\n\"\"\"      TC.current.carry = this.play.sim.carryOut();\n      if (result.won) {\n        if (this.play.sim.stageId === 3 || this.play.sim.stageId === 'range') game.go('results', { result, last: true });\"\"\"),\n(\"\"\"        if (this.next) {\n          const cur = this.result.stage;\n          TC.current.carry = TC.current.game_carry || null;\n          TC.current.stage = Number(cur) + 1;\n          TC.current.carry = TC.current.carry;\n          game.go('briefing', { stage: TC.current.stage });\"\"\",\n\"\"\"        if (this.next) {\n          TC.current.stage = Number(this.result.stage) + 1;\n          game.go('briefing', { stage: TC.current.stage });\"\"\"),\n(\"\"\"        const cfg = { mode: TC.current.mode, stage: this.stage, difficulty: TC.current.difficulty, carry: TC.current.carry, intro: this.stage !== 'range' };\"\"\",\n\"\"\"        const cfg = { mode: TC.current.mode, stage: this.stage, difficulty: TC.current.difficulty, carry: TC.current.carry,\n          intro: this.stage !== 'range', coop: !!TC.current.coop };\"\"\"),\n])\npatch('src/44-dev.js', [(\"\"\"    if (I.repeat && (I.down('right') || I.down('left')) && this.held++ > 12) this.adjust(I.down('right') ? 1 : -1, items);\