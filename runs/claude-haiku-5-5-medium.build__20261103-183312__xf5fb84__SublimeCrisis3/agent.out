s));\\nconsole.log('player', JSON.stringify({ lives: sim.players[0].lives, score: sim.players[0].score, shots: sim.players[0].stats.shots }));\\nEOF\\nnode tools/build.mjs && node tests/smoke.tmp.mjs)\",\"task_id\":\"bsdhu3djg\",\"task_type\":\"local_bash\",\"command\":\"python3 -I - <<'EOF'\\np='tools/build.mjs'\\ns=open(p).read()\\ns=s.replace(\\\"${body}\\\\\\\\n})();\\\\\\\\n`;\\\",\\\"${body}\\\\\\\\nglobalThis.TC = TC;\\\\\\\\n})();\\\\\\\\n`;\\\")\\nopen(p,'w').write(s)\\nEOF\\nmkdir -p tests && cat > tests/lib.mjs <<'EOF'\\n// Loads the engine and the built game into a Node VM context, the same way the browser does (no DOM: the engine's\\n// headless mode). Every test file imports `load()`.\\nimport vm from 'node:vm';\\nimport { readFileSync } from 'node:fs';\\nimport { dirname, join } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\n\\nconst root = join(dirname(fileURLToPath(import.meta.url)), '..');\\n\\nexport function load() {\\n  const ctx = { console, setTimeout, clearTimeout };\\n  vm.createContext(ctx);\\n  vm.runInContext(readFileSync(join(root, 'engine', 'my-3d2dge.js'), 'utf8'), ctx, { filename: 'engine' });\\n  vm.runInContext(readFileSync(join(root, 'build', 'game.js'), 'utf8'), ctx, { filename: 'game' });\\n  return { E: ctx.My3D2dge, TC: ctx.TC, ctx };\\n}\\nEOF\\ncat > /tmp/x 2>/dev/null; cat > tests/smoke.tmp.mjs <<'EOF'\\nimport { load } from './lib.mjs';\\nconst { TC } = load();\\nconst sim = new TC.Sim({ stage: 1, seed: 7, difficulty: 'Normal', players: [{ name: 'P1' }] });\\nconsole.log('scene', sim.scene.id, 'base', sim.base, 'nests', sim.scene.nests.length, 'boxes', sim.world.boxes.length);\\nlet ev = [];\\nfor (let i = 0; i < 120 * 12; i++) {\\n  const cmd = { aim: [0.1 * Math.sin(i / 60), 0], fire: i % 60 < 30, firePressed: i % 60 === 0 };\\n  sim.step(TC.DT, [cmd]);\\n  ev.push(...sim.drain());\\n}\\nconst types = {};\\nfor (const e of ev) types[e.type] = (types[e.type] || 0) + 1;\\nconsole.log('phase', sim.phase, 'en