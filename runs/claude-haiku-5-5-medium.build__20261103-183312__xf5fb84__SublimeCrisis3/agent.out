{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh2u7wHBxA9iDwXVrCWF","type":"message","role":"assistant","content":[{"type":"text","text":"The next file is the core of the game, the deterministic `Sim`. It holds all state, applies commands (cover blend, reload, weapon cycling, hitscan fire), runs the scene director, scores and tracks stats. Enemy AI, threats and bosses go in separate fragments."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3001,"cache_read_input_tokens":153101,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3001},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"882e8690-ca9e-41af-99db-a3a94979c15d","timestamp":"2026-11-04T01:39:17.316Z","request_id":"req_011Cgh2u7cSEDLnc7Dw2EhXv"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh2u7wHBxA9iDwXVrCWF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01945cjMgQzoqAJYSZagNQe8","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","content":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, o.players ? o.players[i] : {}, o.carry ? o.carry[i] : null));\n    this.lastTimeUp = 0;\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, meta, carry) {\n    const y = (i - (this.players_n_guess(meta) - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3001,"cache_read_input_tokens":153101,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3001},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"80ad16f6-77d9-4c0d-ba45-d1ad63bf8206","timestamp":"2026-11-04T01:40:04.019Z","request_id":"req_011Cgh2u7cSEDLnc7Dw2EhXv","wire_tool_inputs":{"toolu_01945cjMgQzoqAJYSZagNQe8":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","content":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, o.players ? o.players[i] : {}, o.carry ? o.carry[i] : null));\n    this.lastTimeUp = 0;\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, meta, carry) {\n    const y = (i - (this.players_n_guess(meta) - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01945cjMgQzoqAJYSZagNQe8","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"3b6aebaa-eb7f-407c-992a-39ae52038948","timestamp":"2026-11-04T01:40:04.033Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","content":"// 04-sim.js: Sim, the authoritative game state (plan 3.4, 4.2, 4.5). It holds the stage, the players, the enemies,\n// threats, projectiles and pickups, and steps them from per-player commands. It never touches the DOM or Math.random.\n// The presentation reads sim.state and drains sim.events every frame; a replica (AI Hub client) fills the same fields\n// from the host's snapshots and never steps.\n//\n// A command: { aim: [ax, ay], fire, firePressed, cover, coverPressed, reload, next, prev, select, cont }.\n//   fire / cover are held; the *Pressed flags are true on the step they went down.\n//\n// Phases of a stage: 'arrive' (the camera rides to the next area: WAIT) -> 'action' (ACTION!, waves, TIME) -> 'clear'\n// (the time bonus) -> the next area, or 'boss' -> 'stageclear'. A wiped-out team is 'continue' (10 s) and then 'over'.\nTC.ARRIVE = 2.2;      // seconds to ride to a new area\nTC.CLEAR_T = 1.2;     // seconds of the clear bonus\nTC.CONT_T = 10;       // the CONTINUE? countdown\nTC.EYE_STAND = 24;    // eye height, standing (u)\nTC.EYE_COVER = 12;    // eye height, in cover (u)\nTC.SLOT_GAP = 30;     // lateral spacing of the player slots (u)\n\nTC.Sim = class Sim {\n  constructor(o = {}) {\n    this.o = o;\n    this.seed = (o.seed || 1) >>> 0;\n    this.diff = TC.DIFF[o.difficulty || 'Normal'];\n    this.difficulty = o.difficulty || 'Normal';\n    this.mode = o.mode || 'stage';\n    this.stageId = o.stage || 1;\n    this.stage = TC.get('stage', this.stageId);\n    this.rngs = {};\n    this.t = 0;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.sceneIdx = o.sceneIndex || 0;\n    this.events = [];\n    this.frozen = false;\n    this.over = false;\n    this.cheats = Object.assign({ god: false, ammo: false, freeze: false, oneHit: false }, o.cheats || {});\n    this.autoFire = o.autoFire !== false;\n    this.enemies = [];\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = [];\n    this.bonus = [];          // bottles and rings: shootable, floating\n    this.boss = null;\n    this.nextId = 1;\n    this.sceneStats = { kills: 0, pops: 0 };\n    this.intel = [];\n    this.result = null;\n    this.prevBase = null;\n    this.waveIdx = 0;\n    this.waveQueue = [];\n    this.clearing = false;\n    // The world: the stage's boxes (solid or not) and the scene list.\n    this.world = this.stage.build(this);\n    this.scene = this.world.scenes[this.sceneIdx];\n    this.base = this.scene.base;\n    this.players = [];\n    const n = Math.max(1, Math.min(4, o.players ? o.players.length : 1));\n    for (let i = 0; i < n; i++) this.players.push(this.makePlayer(i, o.players ? o.players[i] : {}, o.carry ? o.carry[i] : null));\n    this.lastTimeUp = 0;\n    this.enterScene(this.sceneIdx, true);\n  }\n\n  // A stream of random numbers for one purpose; never Math.random.\n  rng(name) {\n    if (!this.rngs[name]) this.rngs[name] = TC.stream(this.seed, name);\n    return this.rngs[name];\n  }\n  id() { return this.nextId++; }\n  emit(type, data) { this.events.push(Object.assign({ type, t: +this.t.toFixed(4) }, data || {})); }\n  drain() { const e = this.events; this.events = []; return e; }\n\n  makePlayer(i, meta, carry) {\n    const y = (i - (this.players_n_guess(meta) - 1) / 2) * TC.SLOT_GAP;\n    const p = {\n      id: i, name: meta.name || ('P' + (i + 1)), color: meta.color || '#e8443a', agent: meta.agent || 'kai',\n      slotY: 0, x: 0, y: 0, z: TC.EYE_STAND, c: 0, want: false, aim: [0, 0],\n      wpn: 0, mag: 9, pool: { mg: 0, shotgun: 0, gl: 0 }, owned: { handgun: true, mg: false, shotgun: false, gl: false },\n      reloadT: -1, switchT: 0, shotT: 0, bloom: 0, recoil: 0, invul: 0, lives: this.diff.lives, score: 0, chain: 0,\n      bestChain: 0, mult: 1, continues: 0, out: false, outT: 0, dead: false, lastFire: false, hit: 0, flash: 0,\n      exposedWasIn: true, stats: { shots: 0, hits: 0, headshots: 0, kills: 0, quick: 0, saves: 0, lost: 0, civ: 0 },\n      wasIn: false, lastWhy: '', bonusTimer: 0,\n    };\n    p.slotY = y;\n    p.x = this.base || 0;\n    if (carry) {\n      p.lives = carry.lives; p.score = carry.score; p.continues = carry.continues || 0;\n      p.pool = Object.assign(p.pool, carry.pool || {}); p.owned = Object.assign(p.owned, carry.owned || {});\n      p.stats = Object.assign(p.stats, carry.stats || {}); p.bestChain = carry.bestChain || 0; p.intel = carry.intel || [];\n    }\n    return p;\n  }\n  players_n_guess(meta) { return this.o.players ? this.o.players.length : 1; }\n\n  // The poses. A stand pose is at the slot, looking east (yaw 0); the cover pose is lower and a step back.\n  standPose(p) { return [this.base, p.slotY, TC.EYE_STAND]; }\n  coverPose(p) { return [this.base - 6, p.slotY, TC.EYE_COVER]; }\n  // The logical camera for a player: pose blended by cover c.\n  camFor(p) {\n    const s = this.standPose(p), c = this.coverPose(p), k = TC.smooth(p.c);\n    return { x: TC.lerp(s[0], c[0], k), y: TC.lerp(s[1], c[1], k), z: TC.lerp(s[2], c[2], k), yaw: 0, pitch: 0,\n      fov: TC.tune.view.fov, roll: Math.sin(Math.PI * p.c) * 2 * Math.PI / 180 };\n  }\n  exposed(p) { return p.c < 0.5; }\n  // What a player can fire: 'handgun' always, the specials when they have ammo.\n  available(p) { return TC.WEAPON_ORDER.filter(w => w === 'handgun' || p.owned[w]); }\n  weaponId(p) { return TC.WEAPON_ORDER[p.wpn]; }\n  ammoOf(p, w) { return w === 'handgun' ? p.mag : p.pool[w] || 0; }\n\n  // Enter a scene: its base moves the rail, the nests and walls are already in the world.\n  enterScene(idx, first) {\n    this.sceneIdx = idx;\n    this.scene = this.world.scenes[idx];\n    this.prevBase = first ? this.scene.base : this.base;\n    this.base = this.scene.base;\n    this.waveIdx = 0;\n    this.timeMax = this.scene.time * this.diff.time * TC.tune.time.sceneMul;\n    this.timer = this.timeMax;\n    this.phase = 'arrive';\n    this.phaseT = 0;\n    this.enemies = this.enemies.filter(e => e.role === 'boss' ? true : false);\n    this.threats = [];\n    this.projectiles = [];\n    this.pickups = this.pickups.filter(q => q.keep);\n    this.clearing = false;\n    this.spawnedScene = false;\n    this.sceneStart = this.t;\n    this.waveQueue = this.scene.waves.slice();\n    this.emit('scene', { index: idx, id: this.scene.id, title: this.scene.title, base: this.base, prev: this.prevBase });\n    for (const p of this.players) {\n      p.x = this.base; p.c = 0; p.want = false;\n    }\n    if (!first) this.prevBase = this.prevBase;\n  }\n\n  // The per-step driver. cmds[i] is player i's command (missing = nothing held).\n  step(dt, cmds = []) {\n    if (this.over || this.frozen) return;\n    this.t += dt;\n    this.phaseT += dt;\n    for (const p of this.players) {\n      if (p.dead) continue;\n      this.playerStep(p, dt, cmds[p.id] || {});\n    }\n    this.phaseStep(dt);\n    this.enemiesStep(dt);\n    this.threatsStep(dt);\n    this.projectilesStep(dt);\n    this.pickupsStep(dt);\n    if (this.boss) this.bossStep(dt);\n    this.timeStep(dt);\n    this.checkClear();\n  }\n\n  playerStep(p, dt, cmd) {\n    if (p.out) {\n      p.outT -= dt;\n      if (cmd.firePressed || cmd.coverPressed) {\n        // A continue: the player can rejoin the fight from its own half.\n        if (p.outT > 0 && this.phase !== 'continue') this.rejoin(p);\n      }\n      if (p.outT <= 0) p.dead = true;\n      return;\n    }\n    p.invul = Math.max(0, p.invul - dt);\n    p.flash = Math.max(0, p.flash - dt);\n    p.bloom = Math.max(0, p.bloom - TC.tune.weapon.mgRate * 0 - 6 * dt);\n    p.recoil = Math.max(0, p.recoil - 6 * dt);\n    p.shotT = Math.max(0, p.shotT - dt);\n    p.switchT = Math.max(0, p.switchT - dt);\n    // Aim: the reticle position in view units, kept on screen.\n    if (cmd.aim) p.aim = [TC.clamp(cmd.aim[0], -1.6, 1.6), TC.clamp(cmd.aim[1], -1, 1)];\n    // Cover: move the blend toward the held state, at the cover speeds.\n    const wantIn = !!cmd.cover;\n    if (wantIn !== p.want) {\n      p.want = wantIn;\n      // Pop-out protection: threats aimed at this player now land later, by up to 0.15 s.\n      if (!wantIn) this.protectPopOut(p);\n    }\n    const target = p.want ? 1 : 0;\n    const rate = p.want ? 1 / TC.tune.player.coverIn : 1 / TC.tune.player.coverOut;\n    p.c = TC.clamp(p.c + TC.clamp(target - p.c, -1, 1) * Math.min(1, rate * dt) * (p.c === target ? 0 : 1), 0, 1);\n    const inCover = p.c >= 0.5;\n    if (inCover !== p.wasIn) {\n      p.wasIn = inCover;\n      this.emit(inCover ? 'cover-in' : 'cover-out', { player: p.id });\n    }\n    // Weapon cycle and number keys.\n    if (cmd.next || cmd.prev || cmd.select) {\n      const avail = this.available(p);\n      let idx = p.wpn;\n      if (cmd.select) {\n        const want = TC.WEAPON_ORDER[cmd.select - 1];\n        if (want && avail.includes(want)) idx = TC.WEAPON_ORDER.indexOf(want);\n      } else {\n        const cur = avail.indexOf(this.weaponId(p));\n        const step = cmd.next ? 1 : -1;\n        const nxt = avail[(cur + step + avail.length) % avail.length];\n        idx = TC.WEAPON_ORDER.indexOf(nxt);\n      }\n      if (idx !== p.wpn) this.switchTo(p, idx);\n    }\n    // Weapon cycle while hidden: a fire press in cover cycles the weapons with ammo, for a trigger-only player.\n    if (inCover && cmd.firePressed && !cmd.reload) {\n      const avail = this.available(p);\n      if (avail.length > 1) {\n        const cur = avail.indexOf(this.weaponId(p));\n        const nxt = avail[(cur + 1) % avail.length];\n        this.switchTo(p, TC.WEAPON_ORDER.indexOf(nxt));\n      }\n    }\n    // Reload: only in cover, the handgun's magazine.\n    const w = TC.get('weapon', this.weaponId(p));\n    if (inCover && (cmd.reload || (p.mag <= 0 && w.id === 'handgun' && cmd.fire)) && p.mag < w.mag && p.reloadT < 0) {\n      p.reloadT = 0;\n      this.emit('reload', { player: p.id });\n    }\n    if (p.reloadT >= 0) {\n      if (!inCover) { p.reloadT = -1; }\n      else {\n        p.reloadT += dt;\n        if (p.reloadT >= w.reloadCover * (TC.tune.player.reload / 0.30)) {\n          p.mag = w.mag;\n          p.reloadT = -1;\n          this.emit('reloaded', { player: p.id });\n        }\n      }\n    }\n    // Empty specials: fall back to the handgun.\n    if (w.id !== 'handgun' && this.ammoOf(p, w.id) <= 0) this.switchTo(p, 0);\n    // Shooting. Not while the cover blend is high (c > 0.2), not while switching or reloading.\n    const cur = TC.get('weapon', this.weaponId(p));\n    const canFire = p.c <= 0.2 && p.reloadT < 0 && p.switchT <= 0 && this.phase !== 'continue';\n    const fireDown = cmd.fire && this.autoFire !== false ? cmd.fire : cmd.firePressed;\n    if (cmd.firePressed && !inCover) this.tryFire(p, cur, true, canFire);\n    else if (cmd.fire && !inCover && cur.auto && canFire) this.tryFire(p, cur, false, canFire);\n    else if (cmd.fire && !inCover && cur.id === 'handgun' && this.autoFire && canFire) this.tryFire(p, cur, false, canFire);\n    p.lastFire = !!cmd.fire;\n    void fireDown;\n  }\n\n  switchTo(p, idx) {\n    if (idx === p.wpn) return;\n    p.wpn = idx;\n    const w = TC.get('weapon', TC.WEAPON_ORDER[idx]);\n    p.switchT = w.switchT;\n    p.reloadT = -1;\n    this.emit('switch', { player: p.id, weapon: w.id });\n  }\n\n  rejoin(p) {\n    p.out = false; p.dead = false; p.lives = this.diff.lives; p.score = 0; p.continues++; p.outT = 0;\n    p.stats.continues = (p.stats.continues || 0) + 1;\n    this.emit('rejoin', { player: p.id });\n  }\n\n  // The fire model, per weapon (plan 4.4). Hitscan rays from the logical camera; pellets for the shotgun; a projectile\n  // for the grenade launcher.\n  tryFire(p, w, pressed, canFire) {\n    if (!canFire) return;\n    const id = w.id;\n    if (p.shotT > 0) return;\n    if (id === 'handgun') {\n      if (p.mag <= 0) { if (pressed) this.emit('empty', { player: p.id }); return; }\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.mag--;\n      p.shotT = 1 / (pressed ? w.rate : w.autoRate);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, 0, w.damage(), 'handgun');\n    } else if (id === 'mg') {\n      if (this.ammoOf(p, 'mg') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.mg--;\n      p.shotT = 1 / w.rate();\n      p.bloom = Math.min(3, p.bloom + 0.25);\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, 1, p.bloom, w.damage(), 'mg');\n    } else if (id === 'shotgun') {\n      if (this.ammoOf(p, 'shotgun') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.shotgun--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.fireRays(p, w, w.pellets(), w.spread(), w.damage, 'shotgun');\n    } else if (id === 'gl') {\n      if (this.ammoOf(p, 'gl') <= 0) return;\n      if (!this.cheats.ammo && !TC.tune.player.infiniteAmmo) p.pool.gl--;\n      p.shotT = 1 / w.rate;\n      p.recoil = Math.min(4, p.recoil + w.recoil);\n      this.launchGrenade(p, w);\n    }\n    p.stats.shots++;\n    this.emit('shot', { player: p.id, weapon: id });\n  }\n\n  // Ray directions for a shot: the aim (view units), with spread in degrees, from a stream of this player's own.\n  aimDirs(p, n, spreadDeg) {\n    const cam = this.camFor(p);\n    const out = [];\n    const rs = this.rng('p' + p.id + '.spread');\n    for (let i = 0; i < n; i++) {\n      let ax = p.aim[0], ay = p.aim[1];\n      if (spreadDeg > 0) {\n        const r = (spreadDeg * Math.PI / 180) * Math.sqrt(rs());\n        const a = rs() * Math.PI * 2;\n        const t = Math.tan((cam.fov * Math.PI / 180) / 2);\n        ax += Math.cos(a) * r / t * (16 / 9) * 0.5;\n        ay += Math.sin(a) * r / t * 0.5;\n      }\n      out.push(TC.aimRay(cam, ax, ay));\n    }\n    return out;\n  }\n\n  fireRays(p, w, n, spreadDeg, dmg, kind) {\n    const cam = this.camFor(p);\n    const o = [cam.x, cam.y, cam.z];\n    const dirs = this.aimDirs(p, n, kind === 'mg' ? spreadDeg : spreadDeg);\n    let anyHit = false;\n    const muzzle = [o[0] + 4, o[1] + 0, o[2] - 4];\n    for (const d of dirs) {\n      const hit = this.traceShot(p, o, d, dmg, kind);\n      if (hit) anyHit = true;\n    }\n    this.emit('flare', { player: p.id, from: muzzle, weapon: kind });\n    if (!anyHit) {\n      // A miss resets the chain (plan 4.5).\n      if (p.chain > 0) p.chain = 0; p.mult = 1;\n      this.emit('miss', { player: p.id, from: muzzle, dir: dirs[0] });\n    }\n  }\n\n  // The nearest of everything along a ray: enemies (head and body), solid boxes, breakables, bonus pickups, shootable\n  // projectiles, boss parts. Applies the result. Returns true when something a shot can score on was hit.\n  traceShot(p, o, d, dmg, kind) {\n    let best = { t: Infinity };\n    const consider = (t, what) => { if (t >= 0 && t < best.t) best = Object.assign({ t }, what); };\n    for (const b of this.world.boxes) {\n      if (!b.solid) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'box', box: b });\n    }\n    for (const e of this.enemies) {\n      if (!e.alive || !e.exposed) continue;\n      for (const v of this.hitVolumes(e)) {\n        const t = TC.rayBox(o, d, v.b);\n        if (t >= 0) consider(t, { kind: 'enemy', enemy: e, part: v.part });\n      }\n    }\n    for (const q of this.bonus) {\n      if (q.gone) continue;\n      const t = TC.raySphere(o, d, [q.x, q.y, q.z], q.r);\n      if (t >= 0) consider(t, { kind: 'bonus', item: q });\n    }\n    for (const pr of this.projectiles) {\n      if (pr.gone || pr.noShoot) continue;\n      const t = TC.raySphere(o, d, [pr.x, pr.y, pr.z], pr.r);\n      if (t >= 0) consider(t, { kind: 'projectile', item: pr });\n    }\n    if (this.boss) this.bossVolumes(best, consider, o, d);\n    for (const b of this.world.barrels || []) {\n      if (b.gone) continue;\n      const t = TC.rayBox(o, d, b.b);\n      if (t >= 0) consider(t, { kind: 'barrel', item: b });\n    }\n    if (best.kind === undefined) {\n      // Only the ground (or nothing) in the way: a miss.\n      return false;\n    }\n    if (best.t > 1e6) return false;\n    const at = [o[0] + d[0] * best.t, o[1] + d[1] * best.t, o[2] + d[2] * best.t];\n    switch (best.kind) {\n      case 'box': {\n        this.emit('impact', { at, surface: best.box.mat, player: p.id });\n        return false;\n      }\n      case 'enemy': {\n        const e = best.enemy;\n        const head = best.part === 'head';\n        this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);\n        return true;\n      }\n      case 'bonus': {\n        this.collectBonus(best.item, p, at);\n        return true;\n      }\n      case 'projectile': {\n        this.shootDown(best.item, p, at);\n        return true;\n      }\n      case 'boss': {\n        this.damageBoss(best.part, p, dmg, at);\n        return true;\n      }\n      case 'barrel': {\n        this.detonateBarrel(best.item, p);\n        return true;\n      }\n      default: return false;\n    }\n  }\n\n  // Hit volumes of a live enemy, from its position (a head and a body box). Crouched enemies in cover are not in\n  // this list (they are not exposed).\n  hitVolumes(e) {\n    const s = e.size || 1;\n    const x = e.x, y = e.y;\n    return [\n      { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, 22 * s, x + 3.2 * s, y + 3.2 * s, 29 * s] },\n      { part: 'body', b: [x - 5 * s, y - 5 * s, 0, x + 5 * s, y + 5 * s, 22 * s] },\n    ];\n  }\n\n  // Score and chain (plan 4.5).\n  addScore(p, pts, at) {\n    if (!pts) return;\n    p.score += Math.round(pts * p.mult);\n    this.emit('score', { player: p.id, pts: Math.round(pts * p.mult), at });\n  }\n  bumpChain(p) {\n    p.chain++;\n    p.bestChain = Math.max(p.bestChain, p.chain);\n    p.mult = Math.min(2, 1 + Math.floor(p.chain / 5) * 0.1);\n  }\n\n  damageEnemy(e, p, dmg, head, at, kind, o, d) {\n    const def = TC.get('enemy', e.type);\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (def.role === 'civilian') {\n      this.hitCivilian(e, p, at);\n      return;\n    }\n    e.hp -= dmg;\n    e.lastHitBy = p.id;\n    e.hurtT = 0.25;\n    e.hitHead = head || e.hitHead;\n    this.emit('hit', { player: p.id, enemy: e.id, head, at, dmg });\n    this.addScore(p, 100, at);\n    if (e.hp <= 0) {\n      this.killEnemy(e, p, head, at, o, d);\n    }\n  }\n\n  killEnemy(e, p, head, at, o, d) {\n    const def = TC.get('enemy', e.type);\n    e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = head ? 'head' : (e.hitKind || 'body');\n    p.stats.kills++;\n    let pts = def.score;\n    if (head) { pts += 500; p.stats.headshots++; }\n    const quick = e.exposedAt !== undefined && (this.t - e.exposedAt) <= 0.7;\n    if (quick) { pts += 500; p.stats.quick++; }\n    this.addScore(p, pts, at);\n    if (def.elite) {\n      const add = TC.tune.time.eliteBonus;\n      if (this.phase === 'action' || this.phase === 'boss') this.timer += add;\n      this.emit('timeExtend', { player: p.id, s: add });\n    }\n    if (def.drop) this.dropAmmo(e, p, at);\n    this.emit('kill', { player: p.id, enemy: e.id, type: e.type, head, at, quick });\n  }\n\n  hitCivilian(e, p, at) {\n    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.deathWhy = 'civ';\n    p.stats.civ++;\n    this.addScore(p, -5000, at);\n    this.loseLife(p, 'civilian', true);\n    this.emit('civilian', { player: p.id, at });\n  }\n\n  // Quartermasters drop ammo for the killer: a random special, at once (plan 4.8).\n  dropAmmo(e, p, at) {\n    const pick = this.rng('drop').pick(['mg', 'shotgun', 'gl']);\n    const w = TC.get('weapon', pick);\n    const n = Math.round(w.pickup * TC.tune.weapon.ammoMul);\n    p.owned[pick] = true;\n    p.pool[pick] = Math.min(w.pool, (p.pool[pick] || 0) + n);\n    this.emit('pickup', { player: p.id, kind: 'ammo', weapon: pick, n, at });\n  }\n\n  shootDown(pr, p, at) {\n    pr.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    this.addScore(p, 1000, at);\n    if (pr.kind === 'grenade') {\n      this.explode(pr.x, pr.y, pr.z, 48, 6, 'enemy', p);\n      const th = this.threats.find(t => t.pr === pr);\n      if (th) { th.resolved = true; th.blown = true; this.emit('threatDown', { id: th.id, player: p.id }); }\n    }\n    this.emit('shootdown', { kind: pr.kind, at, player: p.id });\n  }\n\n  collectBonus(q, p, at) {\n    q.gone = true;\n    p.stats.hits++;\n    this.bumpChain(p);\n    if (q.kind === 'ring') {\n      if (p.lives < 9) p.lives++;\n      this.emit('pickup', { player: p.id, kind: 'ring', at });\n      this.addScore(p, 2000, at);\n    } else if (q.kind === 'bottle') {\n      this.addScore(p, 2000, at);\n      this.intel.push(q.intel);\n      this.emit('pickup', { player: p.id, kind: 'intel', intel: q.intel, at });\n    }\n  }\n\n  // Lose a life. An invulnerable player only loses it to a civilian or to TIME (ignoreInvul).\n  loseLife(p, why, ignoreInvul) {\n    if (!ignoreInvul && (p.invul > 0 || this.cheats.god || TC.tune.player.godMode)) return false;\n    if (this.cheats.god || (TC.tune.player.godMode && !ignoreInvul)) return false;\n    p.lives--;\n    p.stats.lost++;\n    p.chain = 0; p.mult = 1;\n    p.invul = TC.tune.player.iframes;\n    p.hit = 0.6;\n    this.emit('lifeLost', { player: p.id, why, lives: p.lives });\n    if (p.lives <= 0) this.playerOut(p);\n    return true;\n  }\n\n  playerOut(p) {\n    p.out = true;\n    p.outT = TC.CONT_T;\n    p.c = 0; p.want = false; p.reloadT = -1;\n    this.emit('out', { player: p.id });\n    if (this.players.every(q => q.out)) this.enterContinue();\n  }\n\n  enterContinue() {\n    this.phase = 'continue';\n    this.phaseT = 0;\n    this.emit('phase', { phase: 'continue' });\n  }\n\n  // TIME (plan 4.5): counts only in action and boss fights. At zero, TIDE'S IN!, a life each, refill.\n  timeStep(dt) {\n    if (TC.tune.time.freeze || this.cheats.freeze) return;\n    if (this.phase !== 'action' && this.phase !== 'boss') return;\n    this.timer -= dt;\n    if (this.timer <= 0) {\n      this.timer = this.timeMax * TC.tune.time.refill;\n      this.emit('timeup', { t: this.t });\n      for (const p of this.players) if (!p.out) this.loseLife(p, 'tide', true);\n    }\n  }\n\n  // The scene director: arrival, ACTION, waves, clear, boss, stage clear.\n  phaseStep(dt) {\n    if (this.phase === 'continue') {\n      // The CONTINUE? countdown: the sim is still, every out player can rejoin with a press.\n      const allOut = this.players.every(p => p.out);\n      if (allOut) {\n        const left = TC.CONT_T - this.phaseT;\n        if (left <= 0) this.gameOver();\n      } else {\n        this.phase = 'action';\n        this.phaseT = 0;\n      }\n      return;\n    }\n    if (this.phase === 'arrive') {\n      if (this.phaseT >= TC.ARRIVE) {\n        this.phase = 'action';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'action' });\n        this.startWaves();\n      }\n      return;\n    }\n    if (this.phase === 'action') {\n      this.updateWaves();\n      return;\n    }\n    if (this.phase === 'clear') {\n      if (this.phaseT >= TC.CLEAR_T && !this.clearing) {\n        this.clearing = true;\n        this.advanceAfterClear();\n      }\n      return;\n    }\n    if (this.phase === 'boss') {\n      if (this.boss && this.boss.defeated) {\n        this.phase = 'outro';\n        this.phaseT = 0;\n        this.emit('phase', { phase: 'outro' });\n      }\n      return;\n    }\n    if (this.phase === 'outro') {\n      if (this.phaseT >= 2) this.stageClear();\n    }\n  }\n\n  startWaves() {\n    this.waveIdx = 0;\n    this.spawnedScene = true;\n    this.emit('actionStart', { scene: this.scene.id });\n    this.spawnPending();\n  }\n\n  // Waves: 'start' spawn at ACTION, 'clear' spawn when the field is clear, { t } at a time into the action.\n  updateWaves() {\n    const actionT = this.phaseT;\n    const aliveEnemies = this.enemies.filter(e => e.alive && e.role !== 'boss').length;\n    for (let i = this.waveIdx; i < this.waveQueue.length; i++) {\n      const wv = this.waveQueue[i];\n      let go = false;\n      if (wv.when === 'start') go = i === 0 || this.waveDone(i - 1);\n      else if (wv.when === 'clear') go = aliveEnemies === 0;\n      else if (wv.when && wv.when.t !== undefined) go = actionT >= wv.when.t;\n      if (go && wv.spawned !== true) {\n        wv.spawned = true;\n        this.waveIdx = Math.max(this.waveIdx, i);\n        for (const [type, nest, extra] of wv.spawn) this.spawn(type, nest, extra || {});\n        this.emit('wave', { index: i, n: wv.spawn.length });\n      }\n    }\n    if (this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.scene.boss) {\n      this.toClear();\n    }\n    if (this.scene.boss && this.waveQueue.every(w => w.spawned) && aliveEnemies === 0 && this.threats.every(t => t.resolved) && !this.boss) {\n      this.startBoss(this.scene.boss);\n    }\n  }\n  waveDone(i) { const w = this.waveQueue[i]; return !!w && w.spawned === true && this.enemies.filter(e => e.wave === i && e.alive).length === 0; }\n  spawnPending() {\n    // A 'start' wave spawns at ACTION; the rest wait for their trigger.\n    this.updateWaves();\n  }\n\n  toClear() {\n    this.phase = 'clear';\n    this.phaseT = 0;\n    this.clearing = false;\n    // The time bonus: remaining seconds x 100, per player who is still in.\n    const secs = Math.max(0, Math.floor(this.timer));\n    const bonus = secs * 100;\n    for (const p of this.players) if (!p.out) this.addScore(p, bonus, null);\n    this.emit('clear', { seconds: secs, bonus });\n  }\n\n  advanceAfterClear() {\n    if (this.sceneIdx + 1 < this.world.scenes.length && !this.scene.final) {\n      this.enterScene(this.sceneIdx + 1, false);\n      this.emit('phase', { phase: 'arrive' });\n    } else {\n      this.stageClear();\n    }\n  }\n  checkClear() { /* the clear is decided in updateWaves */ }\n\n  gameOver() {\n    this.over = true;\n    this.result = this.makeResult(false);\n    this.emit('gameover', { result: this.result });\n  }\n  stageClear() {\n    this.over = true;\n    this.result = this.makeResult(true);\n    this.emit('stageclear', { result: this.result });\n  }\n\n  // The results of a stage (plan 4.5): stats, accuracy, the ranks, and the no-damage bonus.\n  makeResult(won) {\n    const rows = this.players.map(p => {\n      const s = p.stats;\n      const acc = s.shots ? Math.round(100 * s.hits / s.shots) : 0;\n      let rank = 'C';\n      if (p.continues > 0) rank = 'D';\n      else if (acc >= 75 && s.lost === 0) rank = 'S';\n      else if (acc >= 60 && s.lost <= 1) rank = 'A';\n      else if (acc >= 45) rank = 'B';\n      const accBonus = acc * 300;\n      const noDamage = s.lost === 0 && won ? 20000 : 0;\n      return { id: p.id, name: p.name, score: p.score, rank, acc, shots: s.shots, hits: s.hits, kills: s.kills,\n        headshots: s.headshots, quick: s.quick, saves: s.saves, lost: s.lost, civ: s.civ, bestChain: p.bestChain,\n        continues: p.continues, accBonus, noDamage, total: p.score + accBonus + noDamage, time: Math.round(this.t) };\n    });\n    return { won, stage: this.stageId, difficulty: this.difficulty, rows, intel: this.intel.slice(), time: this.t,\n      boss: !!(this.boss && this.boss.defeated) };\n  }\n\n  // Carry state for the next stage of an ARCADE run.\n  carryOut() {\n    return this.players.map(p => ({ lives: p.lives, score: p.score, continues: p.continues, pool: Object.assign({}, p.pool),\n      owned: Object.assign({}, p.owned), stats: Object.assign({}, p.stats), bestChain: p.bestChain, intel: this.intel.slice() }));\n  }\n\n  // The protection for leaving cover: a threat that would land within 0.15 s is moved later.\n  protectPopOut(p) {\n    for (const th of this.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      if (th.impactAt - this.t < 0.15) th.impactAt += 0.15 - Math.max(0, th.impactAt - this.t) * 0 + 0.15;\n    }\n  }\n\n  // A snapshot of the state a presentation or a replica reads (plain data, no engine objects).\n  snapshot() {\n    return {\n      t: this.t, phase: this.phase, phaseT: this.phaseT, scene: this.scene.id, sceneIdx: this.sceneIdx,\n      base: this.base, timer: this.timer, timeMax: this.timeMax, stage: this.stageId, over: this.over,\n      players: this.players.map(p => ({ id: p.id, name: p.name, color: p.color, x: p.x, y: p.slotY, c: p.c,\n        aim: p.aim, wpn: this.weaponId(p), mag: p.mag, pool: Object.assign({}, p.pool), owned: Object.assign({}, p.owned),\n        lives: p.lives, score: p.score, chain: p.chain, mult: p.mult, out: p.out, outT: p.outT, invul: p.invul,\n        reloadT: p.reloadT, stats: Object.assign({}, p.stats), continues: p.continues })),\n      enemies: this.enemies.filter(e => !e.gone).map(e => ({ id: e.id, type: e.type, x: e.x, y: e.y, z: e.z,\n        facing: e.facing, state: e.state, hp: e.hp, alive: e.alive, exposed: e.exposed, size: e.size })),\n      threats: this.threats.filter(t => !t.resolved).map(t => ({ id: t.id, src: t.src, target: t.target,\n        muzzle: t.muzzle, impactAt: t.impactAt, t0: t.t0, kind: t.kind })),\n      projectiles: this.projectiles.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      bonus: this.bonus.filter(q => !q.gone).map(q => ({ id: q.id, kind: q.kind, x: q.x, y: q.y, z: q.z })),\n      boss: this.boss ? this.boss.snapshot() : null,\n      intel: this.intel.slice(),\n    };\n  }\n};\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01945cjMgQzoqAJYSZagNQe8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
