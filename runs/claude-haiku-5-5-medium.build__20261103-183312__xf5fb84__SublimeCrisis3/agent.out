{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh3xMxpxi3crdsYmTHRf","type":"message","role":"assistant","content":[{"type":"text","text":"The dev panel's actions call methods on the play scene, so I'll add those to the play file alongside the intro, which the play scene now calls. Next I'll write the attract module: the Autopilot (the scripted player for attract and the dev bot), the demo playlist and cycle, and the arcade helper that routes a finished run to initials and the records."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6416,"cache_read_input_tokens":339446,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6416},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"03070ba6-c333-4755-826d-e7575ef844ec","timestamp":"2026-11-04T01:52:35.724Z","request_id":"req_011Cgh3xMdjoAbVYt7TEZBYA"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh3xMxpxi3crdsYmTHRf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KaRSfrBzgn8t6JaXdbGEMp","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/45-attract.js","content":"// 45-attract.js: the Autopilot (plan 4.17), the attract mode, the demo playlist, and the arcade table helpers.\n// The Autopilot produces the same commands a player does, from the sim's state. It cheats through the demo (god mode\n// and infinite ammo are set on the demo's Sim), so the attract mode shows the most of the game, not the balance.\n\nTC.Autopilot = {\n  // A bot for one seat. skill: 'fair' (reacts late, aims slower) or 'showoff' (uses every weapon, quick).\n  make(skill) {\n    const bot = { skill, fire: false, lastShot: 0, cover: false, aim: [0, 0], wpnT: 0 };\n    bot.command = (sim, i, dt) => TC.Autopilot.command(sim, i, dt, bot);\n    return bot;\n  },\n\n  command(sim, i, dt, bot) {\n    const p = sim.players[i];\n    const cmd = {};\n    if (!p || p.dead) return cmd;\n    if (p.out) {\n      // A bot rejoins at once.\n      if (sim.phase === 'continue' || p.outT > 0) cmd.firePressed = true;\n      return cmd;\n    }\n    const fast = bot.skill === 'showoff';\n    const reactT = fast ? 0.12 : 0.3;\n    // Threats on this player: the soonest impact decides cover.\n    let soon = Infinity;\n    for (const th of sim.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      soon = Math.min(soon, th.impactAt - sim.t);\n    }\n    const needReload = p.mag <= 0 || (p.mag < 9 && p.reloadT >= 0);\n    const hideFor = soon < 0.3 || (needReload && soon > 0.3 && TC.Autopilot.noEnemyExposed(sim));\n    cmd.cover = hideFor || p.c > 0.5 && soon < 0.6;\n    if (cmd.cover && (p.reloadT < 0 && p.mag < 9)) cmd.reload = true;\n    // Target: the nearest exposed enemy to the aim, its head first.\n    const cam = sim.camFor(p);\n    const aspect = 16 / 9;\n    let best = null, bd = Infinity;\n    for (const e of sim.enemies) {\n      if (!e.alive || !e.exposed || e.role === 'civilian') continue;\n      const v = TC.toView(cam, [e.x, e.y, 24 * (e.size || 1)], aspect);\n      if (!v) continue;\n      const d = Math.hypot(v[0] - p.aim[0], v[1] - p.aim[1]);\n      if (d < bd) { bd = d; best = { e, v }; }\n    }\n    if (sim.boss && !sim.boss.defeated && sim.phase === 'boss') {\n      const core = sim.boss.def.parts.find(q => q.core);\n      const bx = sim.bossPartBox(core);\n      const v = TC.toView(cam, [(bx[0] + bx[3]) / 2, (bx[1] + bx[4]) / 2, (bx[2] + bx[5]) / 2], aspect);\n      if (v && !best) best = { e: null, v };\n    }\n    const tgt = best ? best.v : [0, 0];\n    // Aim eases to the target (a critically damped pull), a little slower on 'fair'.\n    const k = 1 - Math.exp(-dt * (fast ? 9 : 4.5));\n    const aim = [p.aim[0] + (tgt[0] - p.aim[0]) * k, p.aim[1] + (tgt[1] - p.aim[1]) * k];\n    cmd.aim = aim;\n    // Weapons: the machine gun against a crowd, the shotgun close, the grenade launcher at shields.\n    bot.wpnT -= dt;\n    if (bot.wpnT <= 0 && fast) {\n      bot.wpnT = 2.5;\n      const crowd = sim.enemies.filter(e => e.alive && e.exposed).length >= 3;\n      let want = 'handgun';\n      if (crowd && p.owned.mg && p.pool.mg > 0) want = 'mg';\n      else if (p.owned.gl && p.pool.gl > 0 && best && best.e && best.e.type === 'shield') want = 'gl';\n      else if (p.owned.shotgun && p.pool.shotgun > 0 && best && best.e && best.v && Math.abs(best.v[0]) < 0.4) want = 'shotgun';\n      const idx = TC.WEAPON_ORDER.indexOf(want) + 1;\n      if (idx !== p.wpn + 1) cmd.select = idx;\n    }\n    // Fire when the reticle is on the target, and not in cover. Bursts, with a reaction delay.\n    const onTarget = best && bd < 0.09;\n    if (!cmd.cover && onTarget && p.c < 0.2) {\n      if (sim.t - bot.lastShot > reactT * 0.5 || fast) {\n        cmd.fire = true;\n        cmd.firePressed = true;\n        bot.lastShot = sim.t;\n      }\n    } else if (!cmd.cover && !best && p.c < 0.2) {\n      cmd.fire = false;\n    }\n    if (p.mag <= 0 && !cmd.cover) cmd.cover = true;\n    return cmd;\n  },\n\n  noEnemyExposed(sim) {\n    return !sim.enemies.some(e => e.alive && e.exposed && e.role !== 'civilian');\n  },\n};\n\n// The highlights, in the attract's order: [stage, area index] (plan 4.17, reduced to the areas in this build).\nTC.HIGHLIGHTS = [[1, 0], [1, 2], [1, 3], [2, 0], [2, 3], [3, 1], [3, 3]];\n\nTC.Attract = {\n  playIndex: 0,\n\n  // The demo Play for the highlight at index h.\n  makeDemo(game, h) {\n    const hl = TC.HIGHLIGHTS[h % TC.HIGHLIGHTS.length];\n    const play = new TC.Play(game, {\n      mode: 'attract', attract: true, stage: hl[0], sceneIndex: hl[1], difficulty: 'Normal', viewer: 0,\n      seats: [{ bot: TC.Autopilot.make('showoff'), name: 'DEMO', color: '#e8443a', local: true }],\n      cheats: { god: true, ammo: true },\n    });\n    play.lastVp = { 0: { i: 0, x: 0, y: 0, w: 0, h: 0 } };\n    return play;\n  },\n\n  // Start the demo behind a title or menu scene.\n  startDemo(game, scene, where) {\n    scene.demoIndex = TC.Attract.playIndex;\n    scene.demo = TC.Attract.makeDemo(game, scene.demoIndex);\n    scene.demoT = 0;\n    void where;\n  },\n\n  // Draw the demo behind the title: the same drawing as play, full screen.\n  drawDemo(game, scene, r) {\n    if (!scene.demo) return;\n    scene.demo.draw(r);\n  },\n\n  // The title's idle clock: any input resets it; 10 s without and it becomes the attract mode.\n  updateTitle(game, scene, dt) {\n    if (scene.demo) {\n      scene.demo.update(dt);\n      if (scene.demo.sim.over) {\n        TC.Attract.playIndex = (TC.Attract.playIndex + 1) % TC.HIGHLIGHTS.length;\n        scene.demo = TC.Attract.makeDemo(game, TC.Attract.playIndex);\n      }\n    }\n    if (TC.Attract.activity(game)) scene.idle = 0;\n    else scene.idle = (scene.idle || 0) + dt;\n    if (scene.idle > 10) game.go('attract', null, { fade: 0.3 });\n  },\n\n  // Input of any kind: a press, a pointer move of 4 px or more, a stick past its dead zone.\n  activity(game) {\n    const I = game.input;\n    if (I.anyPressed && I.anyPressed()) return true;\n    const pt = I.pointer && I.pointer();\n    if (pt) {\n      const last = TC.Attract._pt;\n      TC.Attract._pt = pt.slice();\n      if (last && Math.hypot(pt[0] - last[0], pt[1] - last[1]) > 4) return true;\n    }\n    if (I.padMove && (Math.abs(I.padMove[0]) + Math.abs(I.padMove[1])) > 0.2) return true;\n    return false;\n  },\n\n  // The attract scene: DEMO, then the high scores, and on through the playlist; any input goes back to the title.\n  enter(game, scene) {\n    scene.phase = 'demo'; scene.phaseT = 0; scene.t = 0;\n    TC.Attract.attractDemo(game, scene);\n  },\n  attractDemo(game, scene) {\n    scene.demo = TC.Attract.makeDemo(game, TC.Attract.playIndex);\n    scene.phase = 'demo'; scene.phaseT = 0;\n    TC.Attract.playIndex = (TC.Attract.playIndex + 1) % TC.HIGHLIGHTS.length;\n    game.audio.music(TC.get('song', 'harbor'));\n  },\n  updateAttract(game, scene, dt) {\n    scene.phaseT += dt;\n    scene.t += dt;\n    if (TC.Attract.activity(game)) {\n      TC.Attract.playIndex = 0;\n      game.go('title', null, { fade: 0.2 });\n      return;\n    }\n    if (scene.phase === 'demo') {\n      scene.demo.update(dt);\n      if (scene.demo.sim.over || scene.phaseT > 28) {\n        scene.phase = 'scores'; scene.phaseT = 0;\n      }\n    } else if (scene.phase === 'scores') {\n      if (scene.phaseT > 6) TC.Attract.attractDemo(game, scene);\n    }\n  },\n  drawAttract(game, scene, r) {\n    if (scene.phase === 'demo' && scene.demo) scene.demo.draw(r);\n    r.overlay(g => {\n      if (scene.phase === 'scores') {\n        g.fillStyle = '#05070fe0'; g.fillRect(0, 0, r.W, r.H);\n        if (TC.arcade && TC.arcade.drawTable) TC.arcade.drawTable(r, 'arcade', 30, 'HIGH SCORES');\n      }\n      TC.text(g, 'DEMO PLAY', 6, 6, TC.PALETTE.gold, { scale: 1 });\n      const lab = TC.labelFor({ input: game.input }, 'fire') || 'ANY KEY';\n      if (Math.floor(scene.t * 2) % 2 === 0) TC.text(g, 'PRESS ' + lab + ' TO START', r.W / 2, r.H - 14, '#ffffff', { align: 'center', scale: 1 });\n    });\n  },\n};\n\n// The arcade: a finished run's score goes to the table if it qualifies (initials first), and then to the records.\nTC.Arcade = {\n  modeFor(result) {\n    if (TC.current.mode === 'coop') return 'coop';\n    if (TC.current.mode === 'arcade') return 'arcade';\n    if (result.stage === 'range') return 'training';\n    return 'stage' + result.stage;\n  },\n  enterOrRecords(game, result, scene) {\n    const mode = TC.Arcade.modeFor(result);\n    const score = result.rows.reduce((s, r) => s + r.total, 0) / Math.max(1, result.rows.length);\n    const top = Math.round(score);\n    if (mode !== 'training' && TC.arcade.qualifies(top, mode)) {\n      scene.entering = true;\n      TC.arcade.enter(top, mode, () => { scene.entering = false; game.go('records'); });\n      return;\n    }\n    game.go('records');\n  },\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6416,"cache_read_input_tokens":339446,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6416},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"92e65b2d-0dd3-41f5-a95f-962eb746c970","timestamp":"2026-11-04T01:52:50.505Z","request_id":"req_011Cgh3xMdjoAbVYt7TEZBYA","wire_tool_inputs":{"toolu_01KaRSfrBzgn8t6JaXdbGEMp":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/45-attract.js","content":"// 45-attract.js: the Autopilot (plan 4.17), the attract mode, the demo playlist, and the arcade table helpers.\n// The Autopilot produces the same commands a player does, from the sim's state. It cheats through the demo (god mode\n// and infinite ammo are set on the demo's Sim), so the attract mode shows the most of the game, not the balance.\n\nTC.Autopilot = {\n  // A bot for one seat. skill: 'fair' (reacts late, aims slower) or 'showoff' (uses every weapon, quick).\n  make(skill) {\n    const bot = { skill, fire: false, lastShot: 0, cover: false, aim: [0, 0], wpnT: 0 };\n    bot.command = (sim, i, dt) => TC.Autopilot.command(sim, i, dt, bot);\n    return bot;\n  },\n\n  command(sim, i, dt, bot) {\n    const p = sim.players[i];\n    const cmd = {};\n    if (!p || p.dead) return cmd;\n    if (p.out) {\n      // A bot rejoins at once.\n      if (sim.phase === 'continue' || p.outT > 0) cmd.firePressed = true;\n      return cmd;\n    }\n    const fast = bot.skill === 'showoff';\n    const reactT = fast ? 0.12 : 0.3;\n    // Threats on this player: the soonest impact decides cover.\n    let soon = Infinity;\n    for (const th of sim.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      soon = Math.min(soon, th.impactAt - sim.t);\n    }\n    const needReload = p.mag <= 0 || (p.mag < 9 && p.reloadT >= 0);\n    const hideFor = soon < 0.3 || (needReload && soon > 0.3 && TC.Autopilot.noEnemyExposed(sim));\n    cmd.cover = hideFor || p.c > 0.5 && soon < 0.6;\n    if (cmd.cover && (p.reloadT < 0 && p.mag < 9)) cmd.reload = true;\n    // Target: the nearest exposed enemy to the aim, its head first.\n    const cam = sim.camFor(p);\n    const aspect = 16 / 9;\n    let best = null, bd = Infinity;\n    for (const e of sim.enemies) {\n      if (!e.alive || !e.exposed || e.role === 'civilian') continue;\n      const v = TC.toView(cam, [e.x, e.y, 24 * (e.size || 1)], aspect);\n      if (!v) continue;\n      const d = Math.hypot(v[0] - p.aim[0], v[1] - p.aim[1]);\n      if (d < bd) { bd = d; best = { e, v }; }\n    }\n    if (sim.boss && !sim.boss.defeated && sim.phase === 'boss') {\n      const core = sim.boss.def.parts.find(q => q.core);\n      const bx = sim.bossPartBox(core);\n      const v = TC.toView(cam, [(bx[0] + bx[3]) / 2, (bx[1] + bx[4]) / 2, (bx[2] + bx[5]) / 2], aspect);\n      if (v && !best) best = { e: null, v };\n    }\n    const tgt = best ? best.v : [0, 0];\n    // Aim eases to the target (a critically damped pull), a little slower on 'fair'.\n    const k = 1 - Math.exp(-dt * (fast ? 9 : 4.5));\n    const aim = [p.aim[0] + (tgt[0] - p.aim[0]) * k, p.aim[1] + (tgt[1] - p.aim[1]) * k];\n    cmd.aim = aim;\n    // Weapons: the machine gun against a crowd, the shotgun close, the grenade launcher at shields.\n    bot.wpnT -= dt;\n    if (bot.wpnT <= 0 && fast) {\n      bot.wpnT = 2.5;\n      const crowd = sim.enemies.filter(e => e.alive && e.exposed).length >= 3;\n      let want = 'handgun';\n      if (crowd && p.owned.mg && p.pool.mg > 0) want = 'mg';\n      else if (p.owned.gl && p.pool.gl > 0 && best && best.e && best.e.type === 'shield') want = 'gl';\n      else if (p.owned.shotgun && p.pool.shotgun > 0 && best && best.e && best.v && Math.abs(best.v[0]) < 0.4) want = 'shotgun';\n      const idx = TC.WEAPON_ORDER.indexOf(want) + 1;\n      if (idx !== p.wpn + 1) cmd.select = idx;\n    }\n    // Fire when the reticle is on the target, and not in cover. Bursts, with a reaction delay.\n    const onTarget = best && bd < 0.09;\n    if (!cmd.cover && onTarget && p.c < 0.2) {\n      if (sim.t - bot.lastShot > reactT * 0.5 || fast) {\n        cmd.fire = true;\n        cmd.firePressed = true;\n        bot.lastShot = sim.t;\n      }\n    } else if (!cmd.cover && !best && p.c < 0.2) {\n      cmd.fire = false;\n    }\n    if (p.mag <= 0 && !cmd.cover) cmd.cover = true;\n    return cmd;\n  },\n\n  noEnemyExposed(sim) {\n    return !sim.enemies.some(e => e.alive && e.exposed && e.role !== 'civilian');\n  },\n};\n\n// The highlights, in the attract's order: [stage, area index] (plan 4.17, reduced to the areas in this build).\nTC.HIGHLIGHTS = [[1, 0], [1, 2], [1, 3], [2, 0], [2, 3], [3, 1], [3, 3]];\n\nTC.Attract = {\n  playIndex: 0,\n\n  // The demo Play for the highlight at index h.\n  makeDemo(game, h) {\n    const hl = TC.HIGHLIGHTS[h % TC.HIGHLIGHTS.length];\n    const play = new TC.Play(game, {\n      mode: 'attract', attract: true, stage: hl[0], sceneIndex: hl[1], difficulty: 'Normal', viewer: 0,\n      seats: [{ bot: TC.Autopilot.make('showoff'), name: 'DEMO', color: '#e8443a', local: true }],\n      cheats: { god: true, ammo: true },\n    });\n    play.lastVp = { 0: { i: 0, x: 0, y: 0, w: 0, h: 0 } };\n    return play;\n  },\n\n  // Start the demo behind a title or menu scene.\n  startDemo(game, scene, where) {\n    scene.demoIndex = TC.Attract.playIndex;\n    scene.demo = TC.Attract.makeDemo(game, scene.demoIndex);\n    scene.demoT = 0;\n    void where;\n  },\n\n  // Draw the demo behind the title: the same drawing as play, full screen.\n  drawDemo(game, scene, r) {\n    if (!scene.demo) return;\n    scene.demo.draw(r);\n  },\n\n  // The title's idle clock: any input resets it; 10 s without and it becomes the attract mode.\n  updateTitle(game, scene, dt) {\n    if (scene.demo) {\n      scene.demo.update(dt);\n      if (scene.demo.sim.over) {\n        TC.Attract.playIndex = (TC.Attract.playIndex + 1) % TC.HIGHLIGHTS.length;\n        scene.demo = TC.Attract.makeDemo(game, TC.Attract.playIndex);\n      }\n    }\n    if (TC.Attract.activity(game)) scene.idle = 0;\n    else scene.idle = (scene.idle || 0) + dt;\n    if (scene.idle > 10) game.go('attract', null, { fade: 0.3 });\n  },\n\n  // Input of any kind: a press, a pointer move of 4 px or more, a stick past its dead zone.\n  activity(game) {\n    const I = game.input;\n    if (I.anyPressed && I.anyPressed()) return true;\n    const pt = I.pointer && I.pointer();\n    if (pt) {\n      const last = TC.Attract._pt;\n      TC.Attract._pt = pt.slice();\n      if (last && Math.hypot(pt[0] - last[0], pt[1] - last[1]) > 4) return true;\n    }\n    if (I.padMove && (Math.abs(I.padMove[0]) + Math.abs(I.padMove[1])) > 0.2) return true;\n    return false;\n  },\n\n  // The attract scene: DEMO, then the high scores, and on through the playlist; any input goes back to the title.\n  enter(game, scene) {\n    scene.phase = 'demo'; scene.phaseT = 0; scene.t = 0;\n    TC.Attract.attractDemo(game, scene);\n  },\n  attractDemo(game, scene) {\n    scene.demo = TC.Attract.makeDemo(game, TC.Attract.playIndex);\n    scene.phase = 'demo'; scene.phaseT = 0;\n    TC.Attract.playIndex = (TC.Attract.playIndex + 1) % TC.HIGHLIGHTS.length;\n    game.audio.music(TC.get('song', 'harbor'));\n  },\n  updateAttract(game, scene, dt) {\n    scene.phaseT += dt;\n    scene.t += dt;\n    if (TC.Attract.activity(game)) {\n      TC.Attract.playIndex = 0;\n      game.go('title', null, { fade: 0.2 });\n      return;\n    }\n    if (scene.phase === 'demo') {\n      scene.demo.update(dt);\n      if (scene.demo.sim.over || scene.phaseT > 28) {\n        scene.phase = 'scores'; scene.phaseT = 0;\n      }\n    } else if (scene.phase === 'scores') {\n      if (scene.phaseT > 6) TC.Attract.attractDemo(game, scene);\n    }\n  },\n  drawAttract(game, scene, r) {\n    if (scene.phase === 'demo' && scene.demo) scene.demo.draw(r);\n    r.overlay(g => {\n      if (scene.phase === 'scores') {\n        g.fillStyle = '#05070fe0'; g.fillRect(0, 0, r.W, r.H);\n        if (TC.arcade && TC.arcade.drawTable) TC.arcade.drawTable(r, 'arcade', 30, 'HIGH SCORES');\n      }\n      TC.text(g, 'DEMO PLAY', 6, 6, TC.PALETTE.gold, { scale: 1 });\n      const lab = TC.labelFor({ input: game.input }, 'fire') || 'ANY KEY';\n      if (Math.floor(scene.t * 2) % 2 === 0) TC.text(g, 'PRESS ' + lab + ' TO START', r.W / 2, r.H - 14, '#ffffff', { align: 'center', scale: 1 });\n    });\n  },\n};\n\n// The arcade: a finished run's score goes to the table if it qualifies (initials first), and then to the records.\nTC.Arcade = {\n  modeFor(result) {\n    if (TC.current.mode === 'coop') return 'coop';\n    if (TC.current.mode === 'arcade') return 'arcade';\n    if (result.stage === 'range') return 'training';\n    return 'stage' + result.stage;\n  },\n  enterOrRecords(game, result, scene) {\n    const mode = TC.Arcade.modeFor(result);\n    const score = result.rows.reduce((s, r) => s + r.total, 0) / Math.max(1, result.rows.length);\n    const top = Math.round(score);\n    if (mode !== 'training' && TC.arcade.qualifies(top, mode)) {\n      scene.entering = true;\n      TC.arcade.enter(top, mode, () => { scene.entering = false; game.go('records'); });\n      return;\n    }\n    game.go('records');\n  },\n};\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KaRSfrBzgn8t6JaXdbGEMp","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/45-attract.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a4347fe7-6622-4d1f-b2e4-5b62026e02e2","uuid":"576dd846-0ce7-4936-a40b-37ce80bb829e","timestamp":"2026-11-04T01:52:50.516Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/45-attract.js","content":"// 45-attract.js: the Autopilot (plan 4.17), the attract mode, the demo playlist, and the arcade table helpers.\n// The Autopilot produces the same commands a player does, from the sim's state. It cheats through the demo (god mode\n// and infinite ammo are set on the demo's Sim), so the attract mode shows the most of the game, not the balance.\n\nTC.Autopilot = {\n  // A bot for one seat. skill: 'fair' (reacts late, aims slower) or 'showoff' (uses every weapon, quick).\n  make(skill) {\n    const bot = { skill, fire: false, lastShot: 0, cover: false, aim: [0, 0], wpnT: 0 };\n    bot.command = (sim, i, dt) => TC.Autopilot.command(sim, i, dt, bot);\n    return bot;\n  },\n\n  command(sim, i, dt, bot) {\n    const p = sim.players[i];\n    const cmd = {};\n    if (!p || p.dead) return cmd;\n    if (p.out) {\n      // A bot rejoins at once.\n      if (sim.phase === 'continue' || p.outT > 0) cmd.firePressed = true;\n      return cmd;\n    }\n    const fast = bot.skill === 'showoff';\n    const reactT = fast ? 0.12 : 0.3;\n    // Threats on this player: the soonest impact decides cover.\n    let soon = Infinity;\n    for (const th of sim.threats) {\n      if (th.resolved || th.target !== p.id) continue;\n      soon = Math.min(soon, th.impactAt - sim.t);\n    }\n    const needReload = p.mag <= 0 || (p.mag < 9 && p.reloadT >= 0);\n    const hideFor = soon < 0.3 || (needReload && soon > 0.3 && TC.Autopilot.noEnemyExposed(sim));\n    cmd.cover = hideFor || p.c > 0.5 && soon < 0.6;\n    if (cmd.cover && (p.reloadT < 0 && p.mag < 9)) cmd.reload = true;\n    // Target: the nearest exposed enemy to the aim, its head first.\n    const cam = sim.camFor(p);\n    const aspect = 16 / 9;\n    let best = null, bd = Infinity;\n    for (const e of sim.enemies) {\n      if (!e.alive || !e.exposed || e.role === 'civilian') continue;\n      const v = TC.toView(cam, [e.x, e.y, 24 * (e.size || 1)], aspect);\n      if (!v) continue;\n      const d = Math.hypot(v[0] - p.aim[0], v[1] - p.aim[1]);\n      if (d < bd) { bd = d; best = { e, v }; }\n    }\n    if (sim.boss && !sim.boss.defeated && sim.phase === 'boss') {\n      const core = sim.boss.def.parts.find(q => q.core);\n      const bx = sim.bossPartBox(core);\n      const v = TC.toView(cam, [(bx[0] + bx[3]) / 2, (bx[1] + bx[4]) / 2, (bx[2] + bx[5]) / 2], aspect);\n      if (v && !best) best = { e: null, v };\n    }\n    const tgt = best ? best.v : [0, 0];\n    // Aim eases to the target (a critically damped pull), a little slower on 'fair'.\n    const k = 1 - Math.exp(-dt * (fast ? 9 : 4.5));\n    const aim = [p.aim[0] + (tgt[0] - p.aim[0]) * k, p.aim[1] + (tgt[1] - p.aim[1]) * k];\n    cmd.aim = aim;\n    // Weapons: the machine gun against a crowd, the shotgun close, the grenade launcher at shields.\n    bot.wpnT -= dt;\n    if (bot.wpnT <= 0 && fast) {\n      bot.wpnT = 2.5;\n      const crowd = sim.enemies.filter(e => e.alive && e.exposed).length >= 3;\n      let want = 'handgun';\n      if (crowd && p.owned.mg && p.pool.mg > 0) want = 'mg';\n      else if (p.owned.gl && p.pool.gl > 0 && best && best.e && best.e.type === 'shield') want = 'gl';\n      else if (p.owned.shotgun && p.pool.shotgun > 0 && best && best.e && best.v && Math.abs(best.v[0]) < 0.4) want = 'shotgun';\n      const idx = TC.WEAPON_ORDER.indexOf(want) + 1;\n      if (idx !== p.wpn + 1) cmd.select = idx;\n    }\n    // Fire when the reticle is on the target, and not in cover. Bursts, with a reaction delay.\n    const onTarget = best && bd < 0.09;\n    if (!cmd.cover && onTarget && p.c < 0.2) {\n      if (sim.t - bot.lastShot > reactT * 0.5 || fast) {\n        cmd.fire = true;\n        cmd.firePressed = true;\n        bot.lastShot = sim.t;\n      }\n    } else if (!cmd.cover && !best && p.c < 0.2) {\n      cmd.fire = false;\n    }\n    if (p.mag <= 0 && !cmd.cover) cmd.cover = true;\n    return cmd;\n  },\n\n  noEnemyExposed(sim) {\n    return !sim.enemies.some(e => e.alive && e.exposed && e.role !== 'civilian');\n  },\n};\n\n// The highlights, in the attract's order: [stage, area index] (plan 4.17, reduced to the areas in this build).\nTC.HIGHLIGHTS = [[1, 0], [1, 2], [1, 3], [2, 0], [2, 3], [3, 1], [3, 3]];\n\nTC.Attract = {\n  playIndex: 0,\n\n  // The demo Play for the highlight at index h.\n  makeDemo(game, h) {\n    const hl = TC.HIGHLIGHTS[h % TC.HIGHLIGHTS.length];\n    const play = new TC.Play(game, {\n      mode: 'attract', attract: true, stage: hl[0], sceneIndex: hl[1], difficulty: 'Normal', viewer: 0,\n      seats: [{ bot: TC.Autopilot.make('showoff'), name: 'DEMO', color: '#e8443a', local: true }],\n      cheats: { god: true, ammo: true },\n    });\n    play.lastVp = { 0: { i: 0, x: 0, y: 0, w: 0, h: 0 } };\n    return play;\n  },\n\n  // Start the demo behind a title or menu scene.\n  startDemo(game, scene, where) {\n    scene.demoIndex = TC.Attract.playIndex;\n    scene.demo = TC.Attract.makeDemo(game, scene.demoIndex);\n    scene.demoT = 0;\n    void where;\n  },\n\n  // Draw the demo behind the title: the same drawing as play, full screen.\n  drawDemo(game, scene, r) {\n    if (!scene.demo) return;\n    scene.demo.draw(r);\n  },\n\n  // The title's idle clock: any input resets it; 10 s without and it becomes the attract mode.\n  updateTitle(game, scene, dt) {\n    if (scene.demo) {\n      scene.demo.update(dt);\n      if (scene.demo.sim.over) {\n        TC.Attract.playIndex = (TC.Attract.playIndex + 1) % TC.HIGHLIGHTS.length;\n        scene.demo = TC.Attract.makeDemo(game, TC.Attract.playIndex);\n      }\n    }\n    if (TC.Attract.activity(game)) scene.idle = 0;\n    else scene.idle = (scene.idle || 0) + dt;\n    if (scene.idle > 10) game.go('attract', null, { fade: 0.3 });\n  },\n\n  // Input of any kind: a press, a pointer move of 4 px or more, a stick past its dead zone.\n  activity(game) {\n    const I = game.input;\n    if (I.anyPressed && I.anyPressed()) return true;\n    const pt = I.pointer && I.pointer();\n    if (pt) {\n      const last = TC.Attract._pt;\n      TC.Attract._pt = pt.slice();\n      if (last && Math.hypot(pt[0] - last[0], pt[1] - last[1]) > 4) return true;\n    }\n    if (I.padMove && (Math.abs(I.padMove[0]) + Math.abs(I.padMove[1])) > 0.2) return true;\n    return false;\n  },\n\n  // The attract scene: DEMO, then the high scores, and on through the playlist; any input goes back to the title.\n  enter(game, scene) {\n    scene.phase = 'demo'; scene.phaseT = 0; scene.t = 0;\n    TC.Attract.attractDemo(game, scene);\n  },\n  attractDemo(game, scene) {\n    scene.demo = TC.Attract.makeDemo(game, TC.Attract.playIndex);\n    scene.phase = 'demo'; scene.phaseT = 0;\n    TC.Attract.playIndex = (TC.Attract.playIndex + 1) % TC.HIGHLIGHTS.length;\n    game.audio.music(TC.get('song', 'harbor'));\n  },\n  updateAttract(game, scene, dt) {\n    scene.phaseT += dt;\n    scene.t += dt;\n    if (TC.Attract.activity(game)) {\n      TC.Attract.playIndex = 0;\n      game.go('title', null, { fade: 0.2 });\n      return;\n    }\n    if (scene.phase === 'demo') {\n      scene.demo.update(dt);\n      if (scene.demo.sim.over || scene.phaseT > 28) {\n        scene.phase = 'scores'; scene.phaseT = 0;\n      }\n    } else if (scene.phase === 'scores') {\n      if (scene.phaseT > 6) TC.Attract.attractDemo(game, scene);\n    }\n  },\n  drawAttract(game, scene, r) {\n    if (scene.phase === 'demo' && scene.demo) scene.demo.draw(r);\n    r.overlay(g => {\n      if (scene.phase === 'scores') {\n        g.fillStyle = '#05070fe0'; g.fillRect(0, 0, r.W, r.H);\n        if (TC.arcade && TC.arcade.drawTable) TC.arcade.drawTable(r, 'arcade', 30, 'HIGH SCORES');\n      }\n      TC.text(g, 'DEMO PLAY', 6, 6, TC.PALETTE.gold, { scale: 1 });\n      const lab = TC.labelFor({ input: game.input }, 'fire') || 'ANY KEY';\n      if (Math.floor(scene.t * 2) % 2 === 0) TC.text(g, 'PRESS ' + lab + ' TO START', r.W / 2, r.H - 14, '#ffffff', { align: 'center', scale: 1 });\n    });\n  },\n};\n\n// The arcade: a finished run's score goes to the table if it qualifies (initials first), and then to the records.\nTC.Arcade = {\n  modeFor(result) {\n    if (TC.current.mode === 'coop') return 'coop';\n    if (TC.current.mode === 'arcade') return 'arcade';\n    if (result.stage === 'range') return 'training';\n    return 'stage' + result.stage;\n  },\n  enterOrRecords(game, result, scene) {\n    const mode = TC.Arcade.modeFor(result);\n    const score = result.rows.reduce((s, r) => s + r.total, 0) / Math.max(1, result.rows.length);\n    const top = Math.round(score);\n    if (mode !== 'training' && TC.arcade.qualifies(top, mode)) {\n      scene.entering = true;\n      TC.arcade.enter(top, mode, () => { scene.entering = false; game.go('records'); });\n      return;\n    }\n    game.go('records');\n  },\n};\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01KaRSfrBzgn8t6JaXdbGEMp","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
