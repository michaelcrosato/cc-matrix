nd({ status: 'void', reason, endReason, standings: null });\"},{\"line_number\":380,\"content\":\"    if (outcome.standings) msg.standings = outcome.standings;\"},{\"line_number\":433,\"content\":\"        const checked = checkStandings(msg.standings, present().map((s) => s.id), ids);\"},{\"line_number\":441,\"content\":\"        return finishPlayed(checked.standings, { scores, won, stats, awards });\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa39-3d19-7772-a082-6fbf4c1e0ec4","uuid":"db6ea32c-926d-45fd-ba41-07005d7bd772"}
