{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-a9d1dcda-18ed-4317-8033-fbdfa51770b0-0","content":"{\"type\":\"Todo\",\"TodosUpdated\":{\"summary_for_prompt\":\"- [completed] 1: RNG title, download kit + hub, boot empty scene from file://\\n- [completed] 2: Pure sim + Op 1 tools and tests\\n- [completed] 3: Scalpel, laser, scanner, ops 2-3, Code Blue, Quiet, bot balance\\n- [completed] 4: Story, voices, music, results, saves for episodes 1-3\\n- [in_progress] 5: Fix pad vs last-device aim in fixedUpdate\\n- [completed] 6: Remaining ops, Second Look, strains, campaign playthrough\\n- [pending] 7: Fix session client/host hand movement\\n- [pending] 8: Add Dev Mode stage, scene, frame step, FPS, spawn tools\\n- [pending] 9: Rebuild, retest browser/launch/hub, refresh evidence\\n\",\"todos\":[{\"content\":\"RNG title, download kit + hub, boot empty scene from file://\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Pure sim + Op 1 tools and tests\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Scalpel, laser, scanner, ops 2-3, Code Blue, Quiet, bot balance\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Story, voices, music, results, saves for episodes 1-3\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Fix pad vs last-device aim in fixedUpdate\",\"priority\":\"medium\",\"status\":\"in_progress\"},{\"content\":\"Remaining ops, Second Look, strains, campaign playthrough\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Fix session client/host hand movement\",\"priority\":\"medium\",\"status\":\"pending\"},{\"content\":\"Add Dev Mode stage, scene, frame step, FPS, spawn tools\",\"priority\":\"medium\",\"status\":\"pending\"},{\"content\":\"Rebuild, retest browser/launch/hub, refresh evidence\",\"priority\":\"medium\",\"status\":\"pending\"}],\"state\":{\"todos\":{\"1\":{\"content\":\"RNG title, download kit + hub, boot empty scene from file://\",\"priority\":\"medium\",\"status\":\"completed\"},\"2\":{\"content\":\"Pure sim + Op 1 tools and tests\",\"priority\":\"medium\",\"status\":\"completed\"},\"3\":{\"content\":\"Scalpel, laser, scanner, ops 2-3, Code Blue, Quiet, bot balance\",\"priority\":\"medium\",\"status\":\"completed\"},\"4\":{\"content\":\"Story, voices, music, results, saves for episodes 1-3\",\"priority\":\"medium\",\"status\":\"completed\"},\"5\":{\"content\":\"Fix pad vs last-device aim in fixedUpdate\",\"priority\":\"medium\",\"status\":\"in_progress\"},\"6\":{\"content\":\"Remaining ops, Second Look, strains, campaign playthrough\",\"priority\":\"medium\",\"status\":\"completed\"},\"7\":{\"content\":\"Fix session client/host hand movement\",\"priority\":\"medium\",\"status\":\"pending\"},\"8\":{\"content\":\"Add Dev Mode stage, scene, frame step, FPS, spawn tools\",\"priority\":\"medium\",\"status\":\"pending\"},\"9\":{\"content\":\"Rebuild, retest browser/launch/hub, refresh evidence\",\"priority\":\"medium\",\"status\":\"pending\"}}}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-a9d1dcda-18ed-4317-8033-fbdfa51770b0-1","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/** One clinic: title, story, surgery, couch consult, and a hub session. */\\n\\nimport { THREE } from '../../pixel-engine.js';\\nimport { TAGLINE } from '../core/meta.js';\\nimport { applySlider, DEFAULTS, getConfig, resetConfig } from '../core/config.js';\\nimport { clearSave, emptySave, readSave, writeSave } from '../core/save.js';\\nimport { opById, STORY_OPS } from '../content/ops.js';\\nimport { CAST, SCENES } from '../content/story.js';\\nimport { botInput } from '../sim/bot.js';\\n10→import { aimOnSurface } from '../sim/aim.js';\\nimport { createOp, devCheat, hashSim, retryStage, step } from '../sim/op.js';\\nimport { SONGS, trackFor } from '../audio/songs.js';\\nimport { promptConfirm, sampleAll, TOOLS, toolIndex } from '../input/devices.js';\\nimport { createView, syncView } from '../view/stage.js';\\nimport { aboutPageLines, clean, drawHud, rowTop } from '../ui/hud.js';\\n\\nconst MENU = ['ON CALL', 'OPERATING LOG', 'CONSULT', 'SETTINGS', 'ABOUT'];\\nconst PAUSE = ['Resume', 'Retry stage', 'Restart', 'Settings', 'Dev mode', 'Quit'];\\nconst CHEATS = [\\n20→  ['god', 'God vitals'],\\n  ['composure', 'Infinite composure'],\\n  ['freeze', 'Freeze clock'],\\n  ['mistakes', 'Unlimited mistakes'],\\n  ['unlock', 'Unlock all'],\\n];\\nconst ACTIONS = [\\n  ['complete', 'Complete stage'],\\n  ['win', 'Win op'],\\n  ['fail', 'Fail op'],\\n30→  ['blue', 'Code blue'],\\n  ['spawn', 'Spawn pool'],\\n  ['copy', 'Copy op JSON'],\\n];\\nconst DIFFS = ['intern', 'resident', 'attending'];\\nconst REELS = ['op1', 'op2', 'op5', 'pile'];\\nconst SLIDER_STEP = {\\n  vitalsDrainMul: 0.1, bleedDrain: 0.05, mistakePenalty: 1, maxMistakes: 1, timeLimitMul: 0.1,\\n  cursorSpeed: 1, steadyFactor: 0.05, aimAssist: 0.1, toolTol: 0.1, drainRate: 0.1, laserTime: 0.05,\\n  syringeDose: 1, syringeDraw: 0.05, composureGain: 1, quietScale: 0.05, quietDrain: 1, lookCost: 5,\\n40→  lookSeconds: 0.5, strainSpeed: 0.1, strainHp: 0.1, diesBpm: 2, blueZone: 0.02, coopScale: 0.05,\\n};\\nconst SETTINGS_KEY = 'soc:settings';\\n\\nfunction now() {\\n  return globalThis.performance?.now?.() || 0;\\n}\\n\\nfunction pageQuery() {\\n  try {\\n50→    if (typeof location === 'undefined') return new URLSearchParams();\\n    return new URLSearchParams(location.search);\\n  } catch {\\n    return new URLSearchParams();\\n  }\\n}\\n\\nfunction loadSettings() {\\n  const base = { glyphs: 'ps', music: 0.1, sound: 1, voices: 1, rumble: true, difficulty: 'resident', aim: 1, cursor: 10 };\\n  try {\\n60→    const raw = globalThis.localStorage?.getItem(SETTINGS_KEY);\\n    if (raw) return { ...base, ...JSON.parse(raw) };\\n  } catch {\\n    /* keep defaults */\\n  }\\n  return base;\\n}\\n\\nexport class Clinic {\\n  name = 'The Second Opinion Clinic';\\n70→\\n  constructor(args = {}) {\\n    this.session = args.session || null;\\n    this.touchOnly = !!args.touchOnly;\\n    this.mode = this.session ? 'card' : 'title';\\n    this.focus = 0;\\n    this.line = 0;\\n    this.sceneIndex = 0;\\n    this.device = 'pad';\\n    this.settings = loadSettings();\\n80→    this.devTab = 0;\\n    this.aboutPage = 0;\\n    this.drive = 0;\\n    this.simSpeed = 1;\\n    this.botSkill = 1;\\n    this.idleAt = now();\\n    this.pulse = 0;\\n    this.reel = 0;\\n    this.reelT = 0;\\n    this.joined = [false, false, false, false];\\n90→    this.look = new THREE.Vector3();\\n    this.rayO = new THREE.Vector3();\\n    this.rayD = new THREE.Vector3();\\n    this.padMemory = { pads: [] };\\n    this.humanInput = {};\\n    this.padInputs = {};\\n    this.tagline = TAGLINE;\\n    this.cardPlayers = [];\\n    this.allowStore = true;\\n  }\\n100→\\n  async setup(ctx) {\\n    this.ctx = ctx;\\n    ctx.input.gamepadButtons = {};\\n    ctx.input.preventKeys.add('Tab');\\n    this.view = createView(ctx);\\n    ctx.audio.register('bark', { wave: 'square', freq: 220, decay: 0.12, volume: 0.35, duty: 0.25 });\\n    ctx.audio.register('ui', { wave: 'square', freq: 740, freqEnd: 180, decay: 0.07, volume: 0.3, duty: 0.25 });\\n    let fresh = true;\\n    try {\\n110→      fresh = globalThis.localStorage?.getItem('pixel-engine:audio') == null;\\n    } catch {\\n      fresh = true;\\n    }\\n    if (fresh) ctx.audio.setVolume('music', 0.1);\\n    if (typeof window !== 'undefined') {\\n      window.addEventListener('keydown', (ev) => this.onKey(ev));\\n      window.addEventListener('gamepadconnected', () => this.dropGate());\\n    }\\n    if (this.session) {\\n120→      this.session.onSim = (sim) => { this.sim = sim; };\\n      this.session.silence = () => {\\n        ctx.audio.playMusic(null);\\n        ctx.audio.stopLoops();\\n      };\\n      this.mode = 'card';\\n      return;\\n    }\\n    this.applyUrl();\\n  }\\n130→\\n  ready(ctx) {\\n    this.ctx = ctx;\\n    ctx.input.gamepadButtons = {};\\n    const game = this;\\n    const api = {\\n      app: game,\\n      get sim() { return game.sim; },\\n      goto: (mode) => game.goto(mode),\\n      config: getConfig(),\\n140→      act: (input) => game.act(input),\\n      get prompts() { return game.promptState(); },\\n      get music() { return ctx.audio.volume.music; },\\n      get art() { return { w: ctx.hud.width, h: ctx.hud.height }; },\\n      engine: ctx.engine,\\n    };\\n    if (typeof window !== 'undefined') window.__GAME__ = api;\\n    if (this.session) {\\n      const poke = () => globalThis.AIHub?.ready?.();\\n      poke();\\n150→      this.readyTimer = setInterval(poke, 250);\\n      setTimeout(() => clearInterval(this.readyTimer), 18000);\\n    }\\n  }\\n\\n  fixedUpdate(ctx, dt) {\\n    if (this.session) return;\\n    if (this.simHold) return;\\n    if (this.mode !== 'op' && this.mode !== 'attract') return;\\n    if (!this.sim || this.sim.phase === 'won' || this.sim.phase === 'lost') return;\\n160→    const inputs = {};\\n    const speed = this.mode === 'attract' ? 1 : this.simSpeed;\\n    for (let i = 0; i < this.sim.seats.length; i++) {\\n      const seat = this.sim.seats[i];\\n      const human = seat.human && this.mode !== 'attract' && !this.forceBot;\\n      if (human && this.padInputs[i]) inputs[i] = this.padInputs[i];\\n      else if (human && i === this.drive) inputs[i] = this.humanInput || {};\\n      else inputs[i] = botInput(this.sim, i, this.mode === 'attract' ? 1 : (seat.botSkill || this.botSkill), dt);\\n    }\\n    step(this.sim, inputs, dt * speed);\\n170→    if (this.mode === 'attract') {\\n      this.reelT += dt;\\n      if (this.reelT > 12 || this.sim.phase === 'won' || this.sim.phase === 'lost') this.nextReel();\\n    }\\n  }\\n\\n  update(ctx, dt) {\\n    this.ctx = ctx;\\n    this.pulse += dt;\\n    this.swallowed = false;\\n180→    if (this.session) this.pullSession();\\n    this.readInput(ctx);\\n    if ((this.mode === 'op' || this.mode === 'dev' || this.mode === 'pause') && this.sim && (this.sim.phase === 'won' || this.sim.phase === 'lost')) this.mode = 'results';\\n    this.maybeAttract();\\n    this.playScore(ctx);\\n    this.speak(ctx);\\n    this.speaker = this.speakerId();\\n    if (this.view) syncView(this.view, this, this.pulse);\\n    this.placeCamera(ctx);\\n    drawHud(ctx, this);\\n190→    ctx.input.gamepadButtons = {};\\n  }\\n\\n  cameraTarget() {\\n    return this.look;\\n  }\\n\\n  status() {\\n    if (!this.sim) return `${this.mode} focus=${this.focus}`;\\n    const vitals = Math.round(this.sim.tables?.[0]?.vitals ?? this.sim.vitals ?? 0);\\n200→    return `${this.sim.id} stage=${this.sim.stageIndex} vitals=${vitals} t=${Math.floor(this.sim.timeLeft)} score=${Math.floor(this.sim.score)}`;\\n  }\\n\\n  fingerprint() {\\n    return `${this.mode}|${this.focus}|${this.line}|${this.sim ? hashSim(this.sim) : '0'}`;\\n  }\\n\\n  dispose() {\\n    if (this.readyTimer) clearInterval(this.readyTimer);\\n    this.session?.silence?.();\\n210→  }\\n\\n  act(input = {}) {\\n    if (!this.sim) return null;\\n    const seat = input.seat ?? 0;\\n    const body = { ...input };\\n    delete body.seat;\\n    step(this.sim, { [seat]: body }, 1 / 60);\\n    return this.sim;\\n  }\\n220→\\n  goto(mode) {\\n    if ((mode === 'pause' || mode === 'dev') && !this.sim) return;\\n    this.mode = mode;\\n    this.focus = 0;\\n    if (mode === 'dev') this.devTab = 0;\\n  }\\n\\n  promptState() {\\n    const confirm = promptConfirm(this.device, this.settings.glyphs);\\n230→    return { confirm, device: this.device, glyphs: this.settings.glyphs };\\n  }\\n\\n  promptName() {\\n    return this.promptState().confirm;\\n  }\\n\\n  scene() {\\n    return SCENES[this.sceneIndex] || null;\\n  }\\n240→\\n  listTitle() {\\n    if (this.mode === 'call') return 'ON CALL';\\n    if (this.mode === 'log') return 'OPERATING LOG';\\n    if (this.mode === 'consult') return 'CONSULT';\\n    if (this.mode === 'picks') return 'PICK A CASE';\\n    return 'MAIN';\\n  }\\n\\n  listItems() {\\n250→    if (this.mode === 'menu') return MENU;\\n    if (this.mode === 'call') return [`DIFFICULTY ${this.settings.difficulty}`, 'NEW SHIFT', 'CONTINUE'];\\n    if (this.mode === 'log') return this.logItems();\\n    if (this.mode === 'consult') return this.consultItems();\\n    if (this.mode === 'picks') return this.pickItems();\\n    if (this.mode === 'settings') return this.settingsRows();\\n    if (this.mode === 'pause') return PAUSE;\\n    if (this.mode === 'dev') return this.devRows();\\n    return [];\\n  }\\n260→\\n  settingsRows() {\\n    const music = Math.round((this.ctx?.audio?.volume?.music ?? this.settings.music) * 100);\\n    return [\\n      `GLYPHS ${this.settings.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION'}`,\\n      `MUSIC ${music}%`,\\n      `SOUND ${Math.round(this.settings.sound * 100)}%`,\\n      `VOICES ${Math.round(this.settings.voices * 100)}%`,\\n      `RUMBLE ${this.settings.rumble ? 'ON' : 'OFF'}`,\\n      `DIFFICULTY ${this.settings.difficulty}`,\\n270→      'RESET',\\n    ];\\n  }\\n\\n  devRows() {\\n    if (this.devTab === 1) return CHEATS.map((row) => row[1]);\\n    if (this.devTab === 2) return STORY_OPS.map((op) => op.title);\\n    if (this.devTab === 3) return ACTIONS.map((row) => row[1]);\\n    if (this.devTab === 4) return [`HITBOXES ${this.hitbox ? 'ON' : 'OFF'}`, `BOT ${this.botSkill.toFixed(1)}`, `SPEED ${this.simSpeed.toFixed(1)}`];\\n    const rows = Object.keys(DEFAULTS).map((key) => `${key} ${trimNum(getConfig()[key])}`);\\n280→    rows.push('RESET');\\n    return rows;\\n  }\\n\\n  pauseItems() {\\n    return PAUSE;\\n  }\\n\\n  logItems() {\\n    const save = readSave();\\n290→    const rows = STORY_OPS.map((op) => {\\n      const rec = save?.ops?.[op.id];\\n      return rec ? `${op.title}  ${rec.rank || '-'}` : `${op.title}  LOCKED`;\\n    });\\n    return rows.length ? rows : ['NO CHARTS YET'];\\n  }\\n\\n  consultItems() {\\n    return [0, 1, 2, 3].map((i) => `SEAT ${i + 1}  ${this.joined[i] ? 'IN' : 'OUT'}`).concat(['START']);\\n  }\\n300→\\n  pickItems() {\\n    return this.choices().map((id) => opById(id)?.title || id);\\n  }\\n\\n  aboutLines() {\\n    return aboutPageLines(this.aboutPage);\\n  }\\n\\n  followLine() {\\n310→    const rank = this.sim?.rank || 'C';\\n    const pack = this.opDef?.reyes || this.opDef?.follow || {};\\n    if (typeof pack === 'string') return pack;\\n    return pack[rank] || pack.S || 'Chart closed.';\\n  }\\n\\n  applyUrl() {\\n    const q = pageQuery();\\n    if (q.get('hold') === '1') this.simHold = true;\\n    if (q.get('attract') === '1') {\\n320→      this.startAttract();\\n      return;\\n    }\\n    if (q.get('op')) {\\n      this.beginOp(q.get('op'), { fromUrl: true, q, consult: Number(q.get('seats') || 1) > 1 });\\n      if (q.get('dev') === '1') { this.mode = 'dev'; this.devTab = 0; }\\n      return;\\n    }\\n    if (q.get('scene')) {\\n      const index = SCENES.findIndex((scene) => scene.id === q.get('scene'));\\n330→      this.enterScene(index < 0 ? 0 : index, false);\\n      return;\\n    }\\n    this.mode = 'title';\\n  }\\n\\n  beginOp(defOrId, opts = {}) {\\n    const def = typeof defOrId === 'string' ? opById(defOrId) : defOrId;\\n    if (!def) return null;\\n    this.opDef = def;\\n340→    const q = opts.q;\\n    const seed = Number(q?.get?.('seed') ?? opts.seed ?? 1);\\n    const seats = Number(q?.get?.('seats') ?? opts.seats ?? 1);\\n    const difficulty = q?.get?.('diff') || opts.difficulty || this.settings.difficulty || 'resident';\\n    if (q?.get?.('bot') === '0') this.forceBot = false;\\n    else this.forceBot = q?.get?.('bot') === '1' || !!opts.bot;\\n    if (opts.fromUrl && q?.get?.('hold') === '1') this.simHold = true;\\n    applySlider('aimAssist', this.settings.aim);\\n    applySlider('cursorSpeed', this.settings.cursor);\\n    this.sim = createOp(def, {\\n350→      seed: Number.isFinite(seed) ? seed : 1,\\n      seats: Math.max(1, seats || 1),\\n      difficulty,\\n      god: q?.get?.('god') === '1' || !!opts.god,\\n      consult: !!opts.consult,\\n    });\\n    const stage = Number(q?.get?.('stage'));\\n    if (Number.isFinite(stage) && q?.get?.('stage') != null) devCheat(this.sim, 'stage', stage);\\n    this.opOpts = { seed, seats, difficulty, god: !!opts.god, consult: !!opts.consult };\\n    if (this.mode !== 'attract' && this.mode !== 'results' && this.mode !== 'dev') this.mode = 'op';\\n360→    return this.sim;\\n  }\\n\\n  onKey(ev) {\\n    if (!this.session || (this.mode !== 'card' && this.mode !== 'session')) return;\\n    if (ev.key === 'Enter') globalThis.AIHub?.answer?.('ready');\\n    if (ev.key === 'm' || ev.key === 'M') globalThis.AIHub?.answer?.('more');\\n    if (ev.key === 'Escape') ev.preventDefault?.();\\n  }\\n\\n370→  pullSession() {\\n    const hub = globalThis.AIHub;\\n    if (!hub) return;\\n    this.cardPlayers = hub.players || [];\\n    const t = hub.time?.() ?? -Infinity;\\n    if (this.session.sim) this.sim = this.session.sim;\\n    if (!this.session.ended && t >= 0 && this.sim) this.mode = 'session';\\n    else if (!this.session.ended) this.mode = 'card';\\n    const me = hub.me;\\n    const seat = this.sim?.seats?.[me];\\n380→    this.session.local = {\\n      ...(this.humanInput || {}),\\n      x: seat?.x || 0,\\n      z: seat?.z || 0,\\n      tool: this.humanInput?.tool || seat?.tool || 'forceps',\\n    };\\n    this.session.me = me;\\n  }\\n\\n  readInput(ctx) {\\n390→    const input = ctx.input;\\n    const pads = sampleAll(this.padMemory);\\n    const key = this.anyKey(input);\\n    const click = input.wasPressed('MouseLeft');\\n    const right = input.wasPressed('MouseRight');\\n    const moved = Math.hypot(input.mouseDelta?.x || 0, input.mouseDelta?.y || 0) > 0.4;\\n    const px = input.pointer?.x;\\n    const py = input.pointer?.y;\\n    const pointerMoved = this.lastPx != null && px != null && (Math.abs(px - this.lastPx) > 0.002 || Math.abs(py - this.lastPy) > 0.002);\\n    if (px != null) {\\n400→      this.lastPx = px;\\n      this.lastPy = py;\\n    }\\n    const pointed = moved || pointerMoved;\\n    if (key) this.device = 'key';\\n    else if (click || right || pointed) this.device = 'mouse';\\n    else if (pads.any) this.device = 'pad';\\n    const button = key || click || right || pads.any;\\n    if (this.holdOff) {\\n      if (button || moved) return;\\n410→      this.holdOff = false;\\n    }\\n    if (this.mode === 'attract' && (button || pointed)) {\\n      this.exitAttract();\\n      this.holdOff = true;\\n      return;\\n    }\\n    if (button || pointed) this.idleAt = now();\\n    this.buildSeatInputs(input, pads);\\n    if (this.session) {\\n420→      this.readCard(input, pads);\\n      return;\\n    }\\n    if (this.mode === 'title') {\\n      if (button) this.goto('menu');\\n      return;\\n    }\\n    const count = this.listItems().length;\\n    if (input.wasPressed('ArrowDown') || input.wasPressed('KeyS') || pads.pads.some((p) => p.down)) this.bump(1, count);\\n    if (input.wasPressed('ArrowUp') || input.wasPressed('KeyW') || pads.pads.some((p) => p.up)) this.bump(-1, count);\\n430→    if (input.wasPressed('End')) this.focus = Math.max(0, count - 1);\\n    if (input.wasPressed('Home')) this.focus = 0;\\n    if (pointed && !key) this.hover(input, count);\\n    const confirm = input.wasPressed('Enter') || input.wasPressed('Space') || click || pads.pads.some((p) => p.useEdge);\\n    const back = input.wasPressed('Escape') || right || pads.pads.some((p) => p.back);\\n    const left = input.wasPressed('ArrowLeft') || pads.pads.some((p) => p.left);\\n    const rightEdge = input.wasPressed('ArrowRight') || pads.pads.some((p) => p.right);\\n    const tabL = input.wasPressed('KeyQ') || pads.pads.some((p) => p.l1);\\n    const tabR = input.wasPressed('KeyE') || pads.pads.some((p) => p.r1);\\n    if (pads.pads.some((p) => p.options) || (input.wasPressed('Escape') && (this.mode === 'op' || this.mode === 'pause'))) {\\n440→      this.togglePause();\\n      return;\\n    }\\n    if (left) this.nudge(-1);\\n    if (rightEdge) this.nudge(1);\\n    if (tabL) this.tab(-1);\\n    if (tabR) this.tab(1);\\n    if (back && this.mode !== 'op') this.back();\\n    else if (confirm) this.confirm();\\n    pads.pads.forEach((pad) => {\\n450→      if (pad.useEdge && this.mode === 'consult') this.joined[pad.index] = true;\",\"content_concise\":\"1→/** One clinic: title, story, surgery, couch consult, and a hub session. */\\n\\nimport { THREE } from '../../pixel-engine.js';\\nimport { TAGLINE } from '../core/meta.js';\\nimport { applySlider, DEFAULTS, getConfig, resetConfig } from '../core/config.js';\\nimport { clearSave, emptySave, readSave, writeSave } from '../core/save.js';\\nimport { opById, STORY_OPS } from '../content/ops.js';\\nimport { CAST, SCENES } from '../content/story.js';\\nimport { botInput } from '../sim/bot.js';\\n10→import { aimOnSurface } from '../sim/aim.js';\\nimport { createOp, devCheat, hashSim, retryStage, step } from '../sim/op.js';\\nimport { SONGS, trackFor } from '../audio/songs.js';\\nimport { promptConfirm, sampleAll, TOOLS, toolIndex } from '../input/devices.js';\\nimport { createView, syncView } from '../view/stage.js';\\nimport { aboutPageLines, clean, drawHud, rowTop } from '../ui/hud.js';\\n\\nconst MENU = ['ON CALL', 'OPERATING LOG', 'CONSULT', 'SETTINGS', 'ABOUT'];\\nconst PAUSE = ['Resume', 'Retry stage', 'Restart', 'Settings', 'Dev mode', 'Quit'];\\nconst CHEATS = [\\n20→  ['god', 'God vitals'],\\n  ['composure', 'Infinite composure'],\\n  ['freeze', 'Freeze clock'],\\n  ['mistakes', 'Unlimited mistakes'],\\n  ['unlock', 'Unlock all'],\\n];\\nconst ACTIONS = [\\n  ['complete', 'Complete stage'],\\n  ['win', 'Win op'],\\n  ['fail', 'Fail op'],\\n30→  ['blue', 'Code blue'],\\n  ['spawn', 'Spawn pool'],\\n  ['copy', 'Copy op JSON'],\\n];\\nconst DIFFS = ['intern', 'resident', 'attending'];\\nconst REELS = ['op1', 'op2', 'op5', 'pile'];\\nconst SLIDER_STEP = {\\n  vitalsDrainMul: 0.1, bleedDrain: 0.05, mistakePenalty: 1, maxMistakes: 1, timeLimitMul: 0.1,\\n  cursorSpeed: 1, steadyFactor: 0.05, aimAssist: 0.1, toolTol: 0.1, drainRate: 0.1, laserTime: 0.05,\\n  syringeDose: 1, syringeDraw: 0.05, composureGain: 1, quietScale: 0.05, quietDrain: 1, lookCost: 5,\\n40→  lookSeconds: 0.5, strainSpeed: 0.1, strainHp: 0.1, diesBpm: 2, blueZone: 0.02, coopScale: 0.05,\\n};\\nconst SETTINGS_KEY = 'soc:settings';\\n\\nfunction now() {\\n  return globalThis.performance?.now?.() || 0;\\n}\\n\\nfunction pageQuery() {\\n  try {\\n50→    if (typeof location === 'undefined') return new URLSearchParams();\\n    return new URLSearchParams(location.search);\\n  } catch {\\n    return new URLSearchParams();\\n  }\\n}\\n\\nfunction loadSettings() {\\n  const base = { glyphs: 'ps', music: 0.1, sound: 1, voices: 1, rumble: true, difficulty: 'resident', aim: 1, cursor: 10 };\\n  try {\\n60→    const raw = globalThis.localStorage?.getItem(SETTINGS_KEY);\\n    if (raw) return { ...base, ...JSON.parse(raw) };\\n  } catch {\\n    /* keep defaults */\\n  }\\n  return base;\\n}\\n\\nexport class Clinic {\\n  name = 'The Second Opinion Clinic';\\n70→\\n  constructor(args = {}) {\\n    this.session = args.session || null;\\n    this.touchOnly = !!args.touchOnly;\\n    this.mode = this.session ? 'card' : 'title';\\n    this.focus = 0;\\n    this.line = 0;\\n    this.sceneIndex = 0;\\n    this.device = 'pad';\\n    this.settings = loadSettings();\\n80→    this.devTab = 0;\\n    this.aboutPage = 0;\\n    this.drive = 0;\\n    this.simSpeed = 1;\\n    this.botSkill = 1;\\n    this.idleAt = now();\\n    this.pulse = 0;\\n    this.reel = 0;\\n    this.reelT = 0;\\n    this.joined = [false, false, false, false];\\n90→    this.look = new THREE.Vector3();\\n    this.rayO = new THREE.Vector3();\\n    this.rayD = new THREE.Vector3();\\n    this.padMemory = { pads: [] };\\n    this.humanInput = {};\\n    this.padInputs = {};\\n    this.tagline = TAGLINE;\\n    this.cardPlayers = [];\\n    this.allowStore = true;\\n  }\\n100→\\n  async setup(ctx) {\\n    this.ctx = ctx;\\n    ctx.input.gamepadButtons = {};\\n    ctx.input.preventKeys.add('Tab');\\n    this.view = createView(ctx);\\n    ctx.audio.register('bark', { wave: 'square', freq: 220, decay: 0.12, volume: 0.35, duty: 0.25 });\\n    ctx.audio.register('ui', { wave: 'square', freq: 740, freqEnd: 180, decay: 0.07, volume: 0.3, duty: 0.25 });\\n    let fresh = true;\\n    try {\\n110→      fresh = globalThis.localStorage?.getItem('pixel-engine:audio') == null;\\n    } catch {\\n      fresh = true;\\n    }\\n    if (fresh) ctx.audio.setVolume('music', 0.1);\\n    if (typeof window !== 'undefined') {\\n      window.addEventListener('keydown', (ev) => this.onKey(ev));\\n      window.addEventListener('gamepadconnected', () => this.dropGate());\\n    }\\n    if (this.session) {\\n120→      this.session.onSim = (sim) => { this.sim = sim; };\\n      this.session.silence = () => {\\n        ctx.audio.playMusic(null);\\n        ctx.audio.stopLoops();\\n      };\\n      this.mode = 'card';\\n      return;\\n    }\\n    this.applyUrl();\\n  }\\n130→\\n  ready(ctx) {\\n    this.ctx = ctx;\\n    ctx.input.gamepadButtons = {};\\n    const game = this;\\n    const api = {\\n      app: game,\\n      get sim() { return game.sim; },\\n      goto: (mode) => game.goto(mode),\\n      config: getConfig(),\\n140→      act: (input) => game.act(input),\\n      get prompts() { return game.promptState(); },\\n      get music() { return ctx.audio.volume.music; },\\n      get art() { return { w: ctx.hud.width, h: ctx.hud.height }; },\\n      engine: ctx.engine,\\n    };\\n    if (typeof window !== 'undefined') window.__GAME__ = api;\\n    if (this.session) {\\n      const poke = () => globalThis.AIHub?.ready?.();\\n      poke();\\n150→      this.readyTimer = setInterval(poke, 250);\\n      setTimeout(() => clearInterval(this.readyTimer), 18000);\\n    }\\n  }\\n\\n  fixedUpdate(ctx, dt) {\\n    if (this.session) return;\\n    if (this.simHold) return;\\n    if (this.mode !== 'op' && this.mode !== 'attract') return;\\n    if (!this.sim || this.sim.phase === 'won' || this.sim.phase === 'lost') return;\\n160→    const inputs = {};\\n    const speed = this.mode === 'attract' ? 1 : this.simSpeed;\\n    for (let i = 0; i < this.sim.seats.length; i++) {\\n      const seat = this.sim.seats[i];\\n      const human = seat.human && this.mode !== 'attract' && !this.forceBot;\\n      if (human && this.padInputs[i]) inputs[i] = this.padInputs[i];\\n      else if (human && i === this.drive) inputs[i] = this.humanInput || {};\\n      else inputs[i] = botInput(this.sim, i, this.mode === 'attract' ? 1 : (seat.botSkill || this.botSkill), dt);\\n    }\\n    step(this.sim, inputs, dt * speed);\\n170→    if (this.mode === 'attract') {\\n      this.reelT += dt;\\n      if (this.reelT > 12 || this.sim.phase === 'won' || this.sim.phase === 'lost') this.nextReel();\\n    }\\n  }\\n\\n  update(ctx, dt) {\\n    this.ctx = ctx;\\n    this.pulse += dt;\\n    this.swallowed = false;\\n180→    if (this.session) this.pullSession();\\n    this.readInput(ctx);\\n    if ((this.mode === 'op' || this.mode === 'dev' || this.mode === 'pause') && this.sim && (this.sim.phase === 'won' || this.sim.phase === 'lost')) this.mode = 'results';\\n    this.maybeAttract();\\n    this.playScore(ctx);\\n    this.speak(ctx);\\n    this.speaker = this.speakerId();\\n    if (this.view) syncView(this.view, this, this.pulse);\\n    this.placeCamera(ctx);\\n    drawHud(ctx, this);\\n190→    ctx.input.gamepadButtons = {};\\n  }\\n\\n  cameraTarget() {\\n    return this.look;\\n  }\\n\\n  status() {\\n    if (!this.sim) return `${this.mode} focus=${this.focus}`;\\n    const vitals = Math.round(this.sim.tables?.[0]?.vitals ?? this.sim.vitals ?? 0);\\n200→    return `${this.sim.id} stage=${this.sim.stageIndex} vitals=${vitals} t=${Math.floor(this.sim.timeLeft)} score=${Math.floor(this.sim.score)}`;\\n  }\\n\\n  fingerprint() {\\n    return `${this.mode}|${this.focus}|${this.line}|${this.sim ? hashSim(this.sim) : '0'}`;\\n  }\\n\\n  dispose() {\\n    if (this.readyTimer) clearInterval(this.readyTimer);\\n    this.session?.silence?.();\\n210→  }\\n\\n  act(input = {}) {\\n    if (!this.sim) return null;\\n    const seat = input.seat ?? 0;\\n    const body = { ...input };\\n    delete body.seat;\\n    step(this.sim, { [seat]: body }, 1 / 60);\\n    return this.sim;\\n  }\\n220→\\n  goto(mode) {\\n    if ((mode === 'pause' || mode === 'dev') && !this.sim) return;\\n    this.mode = mode;\\n    this.focus = 0;\\n    if (mode === 'dev') this.devTab = 0;\\n  }\\n\\n  promptState() {\\n    const confirm = promptConfirm(this.device, this.settings.glyphs);\\n230→    return { confirm, device: this.device, glyphs: this.settings.glyphs };\\n  }\\n\\n  promptName() {\\n    return this.promptState().confirm;\\n  }\\n\\n  scene() {\\n    return SCENES[this.sceneIndex] || null;\\n  }\\n240→\\n  listTitle() {\\n    if (this.mode === 'call') return 'ON CALL';\\n    if (this.mode === 'log') return 'OPERATING LOG';\\n    if (this.mode === 'consult') return 'CONSULT';\\n    if (this.mode === 'picks') return 'PICK A CASE';\\n    return 'MAIN';\\n  }\\n\\n  listItems() {\\n250→    if (this.mode === 'menu') return MENU;\\n    if (this.mode === 'call') return [`DIFFICULTY ${this.settings.difficulty}`, 'NEW SHIFT', 'CONTINUE'];\\n    if (this.mode === 'log') return this.logItems();\\n    if (this.mode === 'consult') return this.consultItems();\\n    if (this.mode === 'picks') return this.pickItems();\\n    if (this.mode === 'settings') return this.settingsRows();\\n    if (this.mode === 'pause') return PAUSE;\\n    if (this.mode === 'dev') return this.devRows();\\n    return [];\\n  }\\n260→\\n  settingsRows() {\\n    const music = Math.round((this.ctx?.audio?.volume?.music ?? this.settings.music) * 100);\\n    return [\\n      `GLYPHS ${this.settings.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION'}`,\\n      `MUSIC ${music}%`,\\n      `SOUND ${Math.round(this.settings.sound * 100)}%`,\\n      `VOICES ${Math.round(this.settings.voices * 100)}%`,\\n      `RUMBLE ${this.settings.rumble ? 'ON' : 'OFF'}`,\\n      `DIFFICULTY ${this.settings.difficulty}`,\\n270→      'RESET',\\n    ];\\n  }\\n\\n  devRows() {\\n    if (this.devTab === 1) return CHEATS.map((row) => row[1]);\\n    if (this.devTab === 2) return STORY_OPS.map((op) => op.title);\\n    if (this.devTab === 3) return ACTIONS.map((row) => row[1]);\\n    if (this.devTab === 4) return [`HITBOXES ${this.hitbox ? 'ON' : 'OFF'}`, `BOT ${this.botSkill.toFixed(1)}`, `SPEED ${this.simSpeed.toFixed(1)}`];\\n    const rows = Object.keys(DEFAULTS).map((key) => `${key} ${trimNum(getConfig()[key])}`);\\n280→    rows.push('RESET');\\n    return rows;\\n  }\\n\\n  pauseItems() {\\n    return PAUSE;\\n  }\\n\\n  logItems() {\\n    const save = readSave();\\n290→    const rows = STORY_OPS.map((op) => {\\n      const rec = save?.ops?.[op.id];\\n      return rec ? `${op.title}  ${rec.rank || '-'}` : `${op.title}  LOCKED`;\\n    });\\n    return rows.length ? rows : ['NO CHARTS YET'];\\n  }\\n\\n  consultItems() {\\n    return [0, 1, 2, 3].map((i) => `SEAT ${i + 1}  ${this.joined[i] ? 'IN' : 'OUT'}`).concat(['START']);\\n  }\\n300→\\n  pickItems() {\\n    return this.choices().map((id) => opById(id)?.title || id);\\n  }\\n\\n  aboutLines() {\\n    return aboutPageLines(this.aboutPage);\\n  }\\n\\n  followLine() {\\n310→    const rank = this.sim?.rank || 'C';\\n    const pack = this.opDef?.reyes || this.opDef?.follow || {};\\n    if (typeof pack === 'string') return pack;\\n    return pack[rank] || pack.S || 'Chart closed.';\\n  }\\n\\n  applyUrl() {\\n    const q = pageQuery();\\n    if (q.get('hold') === '1') this.simHold = true;\\n    if (q.get('attract') === '1') {\\n320→      this.startAttract();\\n      return;\\n    }\\n    if (q.get('op')) {\\n      this.beginOp(q.get('op'), { fromUrl: true, q, consult: Number(q.get('seats') || 1) > 1 });\\n      if (q.get('dev') === '1') { this.mode = 'dev'; this.devTab = 0; }\\n      return;\\n    }\\n    if (q.get('scene')) {\\n      const index = SCENES.findIndex((scene) => scene.id === q.get('scene'));\\n330→      this.enterScene(index < 0 ? 0 : index, false);\\n      return;\\n    }\\n    this.mode = 'title';\\n  }\\n\\n  beginOp(defOrId, opts = {}) {\\n    const def = typeof defOrId === 'string' ? opById(defOrId) : defOrId;\\n    if (!def) return null;\\n    this.opDef = def;\\n340→    const q = opts.q;\\n    const seed = Number(q?.get?.('seed') ?? opts.seed ?? 1);\\n    const seats = Number(q?.get?.('seats') ?? opts.seats ?? 1);\\n    const difficulty = q?.get?.('diff') || opts.difficulty || this.settings.difficulty || 'resident';\\n    if (q?.get?.('bot') === '0') this.forceBot = false;\\n    else this.forceBot = q?.get?.('bot') === '1' || !!opts.bot;\\n    if (opts.fromUrl && q?.get?.('hold') === '1') this.simHold = true;\\n    applySlider('aimAssist', this.settings.aim);\\n    applySlider('cursorSpeed', this.settings.cursor);\\n    this.sim = createOp(def, {\\n350→      seed: Number.isFinite(seed) ? seed : 1,\\n      seats: Math.max(1, seats || 1),\\n      difficulty,\\n      god: q?.get?.('god') === '1' || !!opts.god,\\n      consult: !!opts.consult,\\n    });\\n    const stage = Number(q?.get?.('stage'));\\n    if (Number.isFinite(stage) && q?.get?.('stage') != null) devCheat(this.sim, 'stage', stage);\\n    this.opOpts = { seed, seats, difficulty, god: !!opts.god, consult: !!opts.consult };\\n    if (this.mode !== 'attract' && this.mode !== 'results' && this.mode !== 'dev') this.mode = 'op';\\n360→    return this.sim;\\n  }\\n\\n  onKey(ev) {\\n    if (!this.session || (this.mode !== 'card' && this.mode !== 'session')) return;\\n    if (ev.key === 'Enter') globalThis.AIHub?.answer?.('ready');\\n    if (ev.key === 'm' || ev.key === 'M') globalThis.AIHub?.answer?.('more');\\n    if (ev.key === 'Escape') ev.preventDefault?.();\\n  }\\n\\n370→  pullSession() {\\n    const hub = globalThis.AIHub;\\n    if (!hub) return;\\n    this.cardPlayers = hub.players || [];\\n    const t = hub.time?.() ?? -Infinity;\\n    if (this.session.sim) this.sim = this.session.sim;\\n    if (!this.session.ended && t >= 0 && this.sim) this.mode = 'session';\\n    else if (!this.session.ended) this.mode = 'card';\\n    const me = hub.me;\\n    const seat = this.sim?.seats?.[me];\\n380→    this.session.local = {\\n      ...(this.humanInput || {}),\\n      x: seat?.x || 0,\\n      z: seat?.z || 0,\\n      tool: this.humanInput?.tool || seat?.tool || 'forceps',\\n    };\\n    this.session.me = me;\\n  }\\n\\n  readInput(ctx) {\\n390→    const input = ctx.input;\\n    const pads = sampleAll(this.padMemory);\\n    const key = this.anyKey(input);\\n    const click = input.wasPressed('MouseLeft');\\n    const right = input.wasPressed('MouseRight');\\n    const moved = Math.hypot(input.mouseDelta?.x || 0, input.mouseDelta?.y || 0) > 0.4;\\n    const px = input.pointer?.x;\\n    const py = input.pointer?.y;\\n    const pointerMoved = this.lastPx != null && px != null && (Math.abs(px - this.lastPx) > 0.002 || Math.abs(py - this.lastPy) > 0.002);\\n    if (px != null) {\\n400→      this.lastPx = px;\\n      this.lastPy = py;\\n    }\\n    const pointed = moved || pointerMoved;\\n    if (key) this.device = 'key';\\n    else if (click || right || pointed) this.device = 'mouse';\\n    else if (pads.any) this.device = 'pad';\\n    const button = key || click || right || pads.any;\\n    if (this.holdOff) {\\n      if (button || moved) return;\\n410→      this.holdOff = false;\\n    }\\n    if (this.mode === 'attract' && (button || pointed)) {\\n      this.exitAttract();\\n      this.holdOff = true;\\n      return;\\n    }\\n    if (button || pointed) this.idleAt = now();\\n    this.buildSeatInputs(input, pads);\\n    if (this.session) {\\n420→      this.readCard(input, pads);\\n      return;\\n    }\\n    if (this.mode === 'title') {\\n      if (button) this.goto('menu');\\n      return;\\n    }\\n    const count = this.listItems().length;\\n    if (input.wasPressed('ArrowDown') || input.wasPressed('KeyS') || pads.pads.some((p) => p.down)) this.bump(1, count);\\n    if (input.wasPressed('ArrowUp') || input.wasPressed('KeyW') || pads.pads.some((p) => p.up)) this.bump(-1, count);\\n430→    if (input.wasPressed('End')) this.focus = Math.max(0, count - 1);\\n    if (input.wasPressed('Home')) this.focus = 0;\\n    if (pointed && !key) this.hover(input, count);\\n    const confirm = input.wasPressed('Enter') || input.wasPressed('Space') || click || pads.pads.some((p) => p.useEdge);\\n    const back = input.wasPressed('Escape') || right || pads.pads.some((p) => p.back);\\n    const left = input.wasPressed('ArrowLeft') || pads.pads.some((p) => p.left);\\n    const rightEdge = input.wasPressed('ArrowRight') || pads.pads.some((p) => p.right);\\n    const tabL = input.wasPressed('KeyQ') || pads.pads.some((p) => p.l1);\\n    const tabR = input.wasPressed('KeyE') || pads.pads.some((p) => p.r1);\\n    if (pads.pads.some((p) => p.options) || (input.wasPressed('Escape') && (this.mode === 'op' || this.mode === 'pause'))) {\\n440→      this.togglePause();\\n      return;\\n    }\\n    if (left) this.nudge(-1);\\n    if (rightEdge) this.nudge(1);\\n    if (tabL) this.tab(-1);\\n    if (tabR) this.tab(1);\\n    if (back && this.mode !== 'op') this.back();\\n    else if (confirm) this.confirm();\\n    pads.pads.forEach((pad) => {\\n450→      if (pad.useEdge && this.mode === 'consult') this.joined[pad.index] = true;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/src/game/clinic.js\",\"offset\":1,\"limit\":450,\"raw_output\":\"/** One clinic: title, story, surgery, couch consult, and a hub session. */\\n\\nimport { THREE } from '../../pixel-engine.js';\\nimport { TAGLINE } from '../core/meta.js';\\nimport { applySlider, DEFAULTS, getConfig, resetConfig } from '../core/config.js';\\nimport { clearSave, emptySave, readSave, writeSave } from '../core/save.js';\\nimport { opById, STORY_OPS } from '../content/ops.js';\\nimport { CAST, SCENES } from '../content/story.js';\\nimport { botInput } from '../sim/bot.js';\\nimport { aimOnSurface } from '../sim/aim.js';\\nimport { createOp, devCheat, hashSim, retryStage, step } from '../sim/op.js';\\nimport { SONGS, trackFor } from '../audio/songs.js';\\nimport { promptConfirm, sampleAll, TOOLS, toolIndex } from '../input/devices.js';\\nimport { createView, syncView } from '../view/stage.js';\\nimport { aboutPageLines, clean, drawHud, rowTop } from '../ui/hud.js';\\n\\nconst MENU = ['ON CALL', 'OPERATING LOG', 'CONSULT', 'SETTINGS', 'ABOUT'];\\nconst PAUSE = ['Resume', 'Retry stage', 'Restart', 'Settings', 'Dev mode', 'Quit'];\\nconst CHEATS = [\\n  ['god', 'God vitals'],\\n  ['composure', 'Infinite composure'],\\n  ['freeze', 'Freeze clock'],\\n  ['mistakes', 'Unlimited mistakes'],\\n  ['unlock', 'Unlock all'],\\n];\\nconst ACTIONS = [\\n  ['complete', 'Complete stage'],\\n  ['win', 'Win op'],\\n  ['fail', 'Fail op'],\\n  ['blue', 'Code blue'],\\n  ['spawn', 'Spawn pool'],\\n  ['copy', 'Copy op JSON'],\\n];\\nconst DIFFS = ['intern', 'resident', 'attending'];\\nconst REELS = ['op1', 'op2', 'op5', 'pile'];\\nconst SLIDER_STEP = {\\n  vitalsDrainMul: 0.1, bleedDrain: 0.05, mistakePenalty: 1, maxMistakes: 1, timeLimitMul: 0.1,\\n  cursorSpeed: 1, steadyFactor: 0.05, aimAssist: 0.1, toolTol: 0.1, drainRate: 0.1, laserTime: 0.05,\\n  syringeDose: 1, syringeDraw: 0.05, composureGain: 1, quietScale: 0.05, quietDrain: 1, lookCost: 5,\\n  lookSeconds: 0.5, strainSpeed: 0.1, strainHp: 0.1, diesBpm: 2, blueZone: 0.02, coopScale: 0.05,\\n};\\nconst SETTINGS_KEY = 'soc:settings';\\n\\nfunction now() {\\n  return globalThis.performance?.now?.() || 0;\\n}\\n\\nfunction pageQuery() {\\n  try {\\n    if (typeof location === 'undefined') return new URLSearchParams();\\n    return new URLSearchParams(location.search);\\n  } catch {\\n    return new URLSearchParams();\\n  }\\n}\\n\\nfunction loadSettings() {\\n  const base = { glyphs: 'ps', music: 0.1, sound: 1, voices: 1, rumble: true, difficulty: 'resident', aim: 1, cursor: 10 };\\n  try {\\n    const raw = globalThis.localStorage?.getItem(SETTINGS_KEY);\\n    if (raw) return { ...base, ...JSON.parse(raw) };\\n  } catch {\\n    /* keep defaults */\\n  }\\n  return base;\\n}\\n\\nexport class Clinic {\\n  name = 'The Second Opinion Clinic';\\n\\n  constructor(args = {}) {\\n    this.session = args.session || null;\\n    this.touchOnly = !!args.touchOnly;\\n    this.mode = this.session ? 'card' : 'title';\\n    this.focus = 0;\\n    this.line = 0;\\n    this.sceneIndex = 0;\\n    this.device = 'pad';\\n    this.settings = loadSettings();\\n    this.devTab = 0;\\n    this.aboutPage = 0;\\n    this.drive = 0;\\n    this.simSpeed = 1;\\n    this.botSkill = 1;\\n    this.idleAt = now();\\n    this.pulse = 0;\\n    this.reel = 0;\\n    this.reelT = 0;\\n    this.joined = [false, false, false, false];\\n    this.look = new THREE.Vector3();\\n    this.rayO = new THREE.Vector3();\\n    this.rayD = new THREE.Vector3();\\n    this.padMemory = { pads: [] };\\n    this.humanInput = {};\\n    this.padInputs = {};\\n    this.tagline = TAGLINE;\\n    this.cardPlayers = [];\\n    this.allowStore = true;\\n  }\\n\\n  async setup(ctx) {\\n    this.ctx = ctx;\\n    ctx.input.gamepadButtons = {};\\n    ctx.input.preventKeys.add('Tab');\\n    this.view = createView(ctx);\\n    ctx.audio.register('bark', { wave: 'square', freq: 220, decay: 0.12, volume: 0.35, duty: 0.25 });\\n    ctx.audio.register('ui', { wave: 'square', freq: 740, freqEnd: 180, decay: 0.07, volume: 0.3, duty: 0.25 });\\n    let fresh = true;\\n    try {\\n      fresh = globalThis.localStorage?.getItem('pixel-engine:audio') == null;\\n    } catch {\\n      fresh = true;\\n    }\\n    if (fresh) ctx.audio.setVolume('music', 0.1);\\n    if (typeof window !== 'undefined') {\\n      window.addEventListener('keydown', (ev) => this.onKey(ev));\\n      window.addEventListener('gamepadconnected', () => this.dropGate());\\n    }\\n    if (this.session) {\\n      this.session.onSim = (sim) => { this.sim = sim; };\\n      this.session.silence = () => {\\n        ctx.audio.playMusic(null);\\n        ctx.audio.stopLoops();\\n      };\\n      this.mode = 'card';\\n      return;\\n    }\\n    this.applyUrl();\\n  }\\n\\n  ready(ctx) {\\n    this.ctx = ctx;\\n    ctx.input.gamepadButtons = {};\\n    const game = this;\\n    const api = {\\n      app: game,\\n      get sim() { return game.sim; },\\n      goto: (mode) => game.goto(mode),\\n      config: getConfig(),\\n      act: (input) => game.act(input),\\n      get prompts() { return game.promptState(); },\\n      get music() { return ctx.audio.volume.music; },\\n      get art() { return { w: ctx.hud.width, h: ctx.hud.height }; },\\n      engine: ctx.engine,\\n    };\\n    if (typeof window !== 'undefined') window.__GAME__ = api;\\n    if (this.session) {\\n      const poke = () => globalThis.AIHub?.ready?.();\\n      poke();\\n      this.readyTimer = setInterval(poke, 250);\\n      setTimeout(() => clearInterval(this.readyTimer), 18000);\\n    }\\n  }\\n\\n  fixedUpdate(ctx, dt) {\\n    if (this.session) return;\\n    if (this.simHold) return;\\n    if (this.mode !== 'op' && this.mode !== 'attract') return;\\n    if (!this.sim || this.sim.phase === 'won' || this.sim.phase === 'lost') return;\\n    const inputs = {};\\n    const speed = this.mode === 'attract' ? 1 : this.simSpeed;\\n    for (let i = 0; i < this.sim.seats.length; i++) {\\n      const seat = this.sim.seats[i];\\n      const human = seat.human && this.mode !== 'attract' && !this.forceBot;\\n      if (human && this.padInputs[i]) inputs[i] = this.padInputs[i];\\n      else if (human && i === this.drive) inputs[i] = this.humanInput || {};\\n      else inputs[i] = botInput(this.sim, i, this.mode === 'attract' ? 1 : (seat.botSkill || this.botSkill), dt);\\n    }\\n    step(this.sim, inputs, dt * speed);\\n    if (this.mode === 'attract') {\\n      this.reelT += dt;\\n      if (this.reelT > 12 || this.sim.phase === 'won' || this.sim.phase === 'lost') this.nextReel();\\n    }\\n  }\\n\\n  update(ctx, dt) {\\n    this.ctx = ctx;\\n    this.pulse += dt;\\n    this.swallowed = false;\\n    if (this.session) this.pullSession();\\n    this.readInput(ctx);\\n    if ((this.mode === 'op' || this.mode === 'dev' || this.mode === 'pause') && this.sim && (this.sim.phase === 'won' || this.sim.phase === 'lost')) this.mode = 'results';\\n    this.maybeAttract();\\n    this.playScore(ctx);\\n    this.speak(ctx);\\n    this.speaker = this.speakerId();\\n    if (this.view) syncView(this.view, this, this.pulse);\\n    this.placeCamera(ctx);\\n    drawHud(ctx, this);\\n    ctx.input.gamepadButtons = {};\\n  }\\n\\n  cameraTarget() {\\n    return this.look;\\n  }\\n\\n  status() {\\n    if (!this.sim) return `${this.mode} focus=${this.focus}`;\\n    const vitals = Math.round(this.sim.tables?.[0]?.vitals ?? this.sim.vitals ?? 0);\\n    return `${this.sim.id} stage=${this.sim.stageIndex} vitals=${vitals} t=${Math.floor(this.sim.timeLeft)} score=${Math.floor(this.sim.score)}`;\\n  }\\n\\n  fingerprint() {\\n    return `${this.mode}|${this.focus}|${this.line}|${this.sim ? hashSim(this.sim) : '0'}`;\\n  }\\n\\n  dispose() {\\n    if (this.readyTimer) clearInterval(this.readyTimer);\\n    this.session?.silence?.();\\n  }\\n\\n  act(input = {}) {\\n    if (!this.sim) return null;\\n    const seat = input.seat ?? 0;\\n    const body = { ...input };\\n    delete body.seat;\\n    step(this.sim, { [seat]: body }, 1 / 60);\\n    return this.sim;\\n  }\\n\\n  goto(mode) {\\n    if ((mode === 'pause' || mode === 'dev') && !this.sim) return;\\n    this.mode = mode;\\n    this.focus = 0;\\n    if (mode === 'dev') this.devTab = 0;\\n  }\\n\\n  promptState() {\\n    const confirm = promptConfirm(this.device, this.settings.glyphs);\\n    return { confirm, device: this.device, glyphs: this.settings.glyphs };\\n  }\\n\\n  promptName() {\\n    return this.promptState().confirm;\\n  }\\n\\n  scene() {\\n    return SCENES[this.sceneIndex] || null;\\n  }\\n\\n  listTitle() {\\n    if (this.mode === 'call') return 'ON CALL';\\n    if (this.mode === 'log') return 'OPERATING LOG';\\n    if (this.mode === 'consult') return 'CONSULT';\\n    if (this.mode === 'picks') return 'PICK A CASE';\\n    return 'MAIN';\\n  }\\n\\n  listItems() {\\n    if (this.mode === 'menu') return MENU;\\n    if (this.mode === 'call') return [`DIFFICULTY ${this.settings.difficulty}`, 'NEW SHIFT', 'CONTINUE'];\\n    if (this.mode === 'log') return this.logItems();\\n    if (this.mode === 'consult') return this.consultItems();\\n    if (this.mode === 'picks') return this.pickItems();\\n    if (this.mode === 'settings') return this.settingsRows();\\n    if (this.mode === 'pause') return PAUSE;\\n    if (this.mode === 'dev') return this.devRows();\\n    return [];\\n  }\\n\\n  settingsRows() {\\n    const music = Math.round((this.ctx?.audio?.volume?.music ?? this.settings.music) * 100);\\n    return [\\n      `GLYPHS ${this.settings.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION'}`,\\n      `MUSIC ${music}%`,\\n      `SOUND ${Math.round(this.settings.sound * 100)}%`,\\n      `VOICES ${Math.round(this.settings.voices * 100)}%`,\\n      `RUMBLE ${this.settings.rumble ? 'ON' : 'OFF'}`,\\n      `DIFFICULTY ${this.settings.difficulty}`,\\n      'RESET',\\n    ];\\n  }\\n\\n  devRows() {\\n    if (this.devTab === 1) return CHEATS.map((row) => row[1]);\\n    if (this.devTab === 2) return STORY_OPS.map((op) => op.title);\\n    if (this.devTab === 3) return ACTIONS.map((row) => row[1]);\\n    if (this.devTab === 4) return [`HITBOXES ${this.hitbox ? 'ON' : 'OFF'}`, `BOT ${this.botSkill.toFixed(1)}`, `SPEED ${this.simSpeed.toFixed(1)}`];\\n    const rows = Object.keys(DEFAULTS).map((key) => `${key} ${trimNum(getConfig()[key])}`);\\n    rows.push('RESET');\\n    return rows;\\n  }\\n\\n  pauseItems() {\\n    return PAUSE;\\n  }\\n\\n  logItems() {\\n    const save = readSave();\\n    const rows = STORY_OPS.map((op) => {\\n      const rec = save?.ops?.[op.id];\\n      return rec ? `${op.title}  ${rec.rank || '-'}` : `${op.title}  LOCKED`;\\n    });\\n    return rows.length ? rows : ['NO CHARTS YET'];\\n  }\\n\\n  consultItems() {\\n    return [0, 1, 2, 3].map((i) => `SEAT ${i + 1}  ${this.joined[i] ? 'IN' : 'OUT'}`).concat(['START']);\\n  }\\n\\n  pickItems() {\\n    return this.choices().map((id) => opById(id)?.title || id);\\n  }\\n\\n  aboutLines() {\\n    return aboutPageLines(this.aboutPage);\\n  }\\n\\n  followLine() {\\n    const rank = this.sim?.rank || 'C';\\n    const pack = this.opDef?.reyes || this.opDef?.follow || {};\\n    if (typeof pack === 'string') return pack;\\n    return pack[rank] || pack.S || 'Chart closed.';\\n  }\\n\\n  applyUrl() {\\n    const q = pageQuery();\\n    if (q.get('hold') === '1') this.simHold = true;\\n    if (q.get('attract') === '1') {\\n      this.startAttract();\\n      return;\\n    }\\n    if (q.get('op')) {\\n      this.beginOp(q.get('op'), { fromUrl: true, q, consult: Number(q.get('seats') || 1) > 1 });\\n      if (q.get('dev') === '1') { this.mode = 'dev'; this.devTab = 0; }\\n      return;\\n    }\\n    if (q.get('scene')) {\\n      const index = SCENES.findIndex((scene) => scene.id === q.get('scene'));\\n      this.enterScene(index < 0 ? 0 : index, false);\\n      return;\\n    }\\n    this.mode = 'title';\\n  }\\n\\n  beginOp(defOrId, opts = {}) {\\n    const def = typeof defOrId === 'string' ? opById(defOrId) : defOrId;\\n    if (!def) return null;\\n    this.opDef = def;\\n    const q = opts.q;\\n    const seed = Number(q?.get?.('seed') ?? opts.seed ?? 1);\\n    const seats = Number(q?.get?.('seats') ?? opts.seats ?? 1);\\n    const difficulty = q?.get?.('diff') || opts.difficulty || this.settings.difficulty || 'resident';\\n    if (q?.get?.('bot') === '0') this.forceBot = false;\\n    else this.forceBot = q?.get?.('bot') === '1' || !!opts.bot;\\n    if (opts.fromUrl && q?.get?.('hold') === '1') this.simHold = true;\\n    applySlider('aimAssist', this.settings.aim);\\n    applySlider('cursorSpeed', this.settings.cursor);\\n    this.sim = createOp(def, {\\n      seed: Number.isFinite(seed) ? seed : 1,\\n      seats: Math.max(1, seats || 1),\\n      difficulty,\\n      god: q?.get?.('god') === '1' || !!opts.god,\\n      consult: !!opts.consult,\\n    });\\n    const stage = Number(q?.get?.('stage'));\\n    if (Number.isFinite(stage) && q?.get?.('stage') != null) devCheat(this.sim, 'stage', stage);\\n    this.opOpts = { seed, seats, difficulty, god: !!opts.god, consult: !!opts.consult };\\n    if (this.mode !== 'attract' && this.mode !== 'results' && this.mode !== 'dev') this.mode = 'op';\\n    return this.sim;\\n  }\\n\\n  onKey(ev) {\\n    if (!this.session || (this.mode !== 'card' && this.mode !== 'session')) return;\\n    if (ev.key === 'Enter') globalThis.AIHub?.answer?.('ready');\\n    if (ev.key === 'm' || ev.key === 'M') globalThis.AIHub?.answer?.('more');\\n    if (ev.key === 'Escape') ev.preventDefault?.();\\n  }\\n\\n  pullSession() {\\n    const hub = globalThis.AIHub;\\n    if (!hub) return;\\n    this.cardPlayers = hub.players || [];\\n    const t = hub.time?.() ?? -Infinity;\\n    if (this.session.sim) this.sim = this.session.sim;\\n    if (!this.session.ended && t >= 0 && this.sim) this.mode = 'session';\\n    else if (!this.session.ended) this.mode = 'card';\\n    const me = hub.me;\\n    const seat = this.sim?.seats?.[me];\\n    this.session.local = {\\n      ...(this.humanInput || {}),\\n      x: seat?.x || 0,\\n      z: seat?.z || 0,\\n      tool: this.humanInput?.tool || seat?.tool || 'forceps',\\n    };\\n    this.session.me = me;\\n  }\\n\\n  readInput(ctx) {\\n    const input = ctx.input;\\n    const pads = sampleAll(this.padMemory);\\n    const key = this.anyKey(input);\\n    const click = input.wasPressed('MouseLeft');\\n    const right = input.wasPressed('MouseRight');\\n    const moved = Math.hypot(input.mouseDelta?.x || 0, input.mouseDelta?.y || 0) > 0.4;\\n    const px = input.pointer?.x;\\n    const py = input.pointer?.y;\\n    const pointerMoved = this.lastPx != null && px != null && (Math.abs(px - this.lastPx) > 0.002 || Math.abs(py - this.lastPy) > 0.002);\\n    if (px != null) {\\n      this.lastPx = px;\\n      this.lastPy = py;\\n    }\\n    const pointed = moved || pointerMoved;\\n    if (key) this.device = 'key';\\n    else if (click || right || pointed) this.device = 'mouse';\\n    else if (pads.any) this.device = 'pad';\\n    const button = key || click || right || pads.any;\\n    if (this.holdOff) {\\n      if (button || moved) return;\\n      this.holdOff = false;\\n    }\\n    if (this.mode === 'attract' && (button || pointed)) {\\n      this.exitAttract();\\n      this.holdOff = true;\\n      return;\\n    }\\n    if (button || pointed) this.idleAt = now();\\n    this.buildSeatInputs(input, pads);\\n    if (this.session) {\\n      this.readCard(input, pads);\\n      return;\\n    }\\n    if (this.mode === 'title') {\\n      if (button) this.goto('menu');\\n      return;\\n    }\\n    const count = this.listItems().length;\\n    if (input.wasPressed('ArrowDown') || input.wasPressed('KeyS') || pads.pads.some((p) => p.down)) this.bump(1, count);\\n    if (input.wasPressed('ArrowUp') || input.wasPressed('KeyW') || pads.pads.some((p) => p.up)) this.bump(-1, count);\\n    if (input.wasPressed('End')) this.focus = Math.max(0, count - 1);\\n    if (input.wasPressed('Home')) this.focus = 0;\\n    if (pointed && !key) this.hover(input, count);\\n    const confirm = input.wasPressed('Enter') || input.wasPressed('Space') || click || pads.pads.some((p) => p.useEdge);\\n    const back = input.wasPressed('Escape') || right || pads.pads.some((p) => p.back);\\n    const left = input.wasPressed('ArrowLeft') || pads.pads.some((p) => p.left);\\n    const rightEdge = input.wasPressed('ArrowRight') || pads.pads.some((p) => p.right);\\n    const tabL = input.wasPressed('KeyQ') || pads.pads.some((p) => p.l1);\\n    const tabR = input.wasPressed('KeyE') || pads.pads.some((p) => p.r1);\\n    if (pads.pads.some((p) => p.options) || (input.wasPressed('Escape') && (this.mode === 'op' || this.mode === 'pause'))) {\\n      this.togglePause();\\n      return;\\n    }\\n    if (left) this.nudge(-1);\\n    if (rightEdge) this.nudge(1);\\n    if (tabL) this.tab(-1);\\n    if (tabR) this.tab(1);\\n    if (back && this.mode !== 'op') this.back();\\n    else if (confirm) this.confirm();\\n    pads.pads.forEach((pad) => {\\n      if (pad.useEdge && this.mode === 'consult') this.joined[pad.index] = true;\\n\",\"total_lines\":872}}","is_error":false},{"type":"tool_result","tool_use_id":"call-a9d1dcda-18ed-4317-8033-fbdfa51770b0-2","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/** Shared-world host loop. The server copy runs this and never starts the renderer. */\\n\\nimport { applyDecoded, encodeFast, encodeKey } from '../sim/codec.js';\\nimport { createOp, step } from '../sim/op.js';\\nimport { SESSION_OPS } from '../content/ops.js';\\n\\nconst DT = 1 / 60;\\n\\nexport function buildStandings(players, scoreOf) {\\n10→  const scores = {};\\n  const ids = [];\\n  for (const p of players || []) {\\n    if (!Number.isInteger(p.id) || ids.includes(p.id)) continue;\\n    ids.push(p.id);\\n    const n = Number(scoreOf(p));\\n    scores[p.id] = Number.isFinite(n) ? Math.round(n) : 0;\\n  }\\n  ids.sort((a, b) => scores[b] - scores[a] || a - b);\\n  const standings = [];\\n20→  for (const id of ids) {\\n    const group = standings[standings.length - 1];\\n    if (group && scores[group[0]] === scores[id]) group.push(id);\\n    else standings.push([id]);\\n  }\\n  return { standings, scores };\\n}\\n\\nfunction allow(state, cost = 1) {\\n  const t = nowMs();\\n30→  state.tokens = Math.min(30, state.tokens + ((t - state.refill) / 1000) * 16);\\n  state.refill = t;\\n  if (state.tokens < cost) return false;\\n  state.tokens -= cost;\\n  return true;\\n}\\n\\nfunction nowMs() {\\n  return globalThis.performance?.now?.() || Date.now();\\n}\\n40→\\nfunction finishRound(hub, state, won) {\\n  if (state.finished || state.ended || !hub.isHost) return;\\n  const players = (hub.players || []).filter((p) => Number.isInteger(p.id));\\n  if (!players.length) return;\\n  state.finished = true;\\n  const { standings, scores } = buildStandings(players, (p) => state.sim?.seats?.[p.id]?.score || 0);\\n  const stats = {};\\n  for (const p of players) {\\n    stats[p.id] = {\\n50→      SCORE: String(scores[p.id]).slice(0, 16),\\n      MISTAKES: String(state.sim?.mistakes || 0).slice(0, 16),\\n    };\\n  }\\n  const best = standings[0]?.[0];\\n  const awards = best == null ? [] : [{ id: best, title: 'STEADIEST HAND', detail: 'Held the line' }];\\n  const patientSaved = !!won && state.sim?.phase === 'won';\\n  hub.finish({ standings, scores, won: patientSaved, stats, awards });\\n}\\n\\n60→function beginOp(hub, state) {\\n  const list = SESSION_OPS.filter(Boolean);\\n  const def = list[(hub.round || 0) % list.length];\\n  const seed = Math.floor(hub.rng('deal')() * 1e9);\\n  const seats = Math.max(1, (hub.players || []).length);\\n  state.sim = createOp(def, { seed, seats, consult: true, difficulty: 'resident' });\\n  state.onSim?.(state.sim);\\n}\\n\\nfunction applySnap(state, snap) {\\n70→  if (!state.sim || !snap) return;\\n  const view = applyDecoded(state.sim, snap);\\n  const me = state.me;\\n  (view.seats || []).forEach((s, i) => {\\n    const seat = state.sim.seats[i];\\n    if (!seat || i === me) return;\\n    seat.x = s.x;\\n    seat.z = s.z;\\n    seat.tool = s.tool;\\n  });\\n80→  if (view.phase) state.sim.phase = view.phase;\\n  if (view.strainDead) state.sim.flags.strainDead = true;\\n}\\n\\nfunction hostInputs(state) {\\n  const inputs = {};\\n  const n = state.sim?.seats?.length || 0;\\n  for (let i = 0; i < n; i++) {\\n    const net = state.inputs[i] || {};\\n    if (i === state.me && state.local) inputs[i] = { ...net, ...state.local };\\n90→    else inputs[i] = net;\\n  }\\n  return inputs;\\n}\\n\\n/**\\n * Attach the hub listeners and the host timer.\\n * `hub` is the session client. Returns the shared state.\\n */\\nexport function openSession(hub) {\\n100→  const state = {\\n    sim: null,\\n    inputs: {},\\n    local: { x: 0, z: 1.2, tool: 'forceps', use: false, gift: false, steady: false, sx: 0, sz: 0 },\\n    card: null,\\n    started: false,\\n    ended: false,\\n    finished: false,\\n    lastT: null,\\n    tokens: 16,\\n110→    refill: nowMs(),\\n    acc: { input: 0, snap: 0, key: 0, ping: 0 },\\n    me: hub.me,\\n    timer: 0,\\n    silence: null,\\n    onSim: null,\\n  };\\n\\n  const send = (data, reliable) => {\\n    if (state.ended || state.finished) return;\\n120→    if (!allow(state)) return;\\n    hub.send(data, { reliable: !!reliable });\\n  };\\n\\n  hub.on('card', (card) => {\\n    state.card = card;\\n  });\\n  hub.on('start', () => {\\n    state.started = true;\\n    state.me = hub.me;\\n130→    if (state.sim) return;\\n    try {\\n      beginOp(hub, state);\\n    } catch (err) {\\n      hub.fail(String(err?.message || err));\\n    }\\n  });\\n  hub.on('message', (data) => {\\n    if (!data || data.t === 'p') return;\\n    if (data.t === 'i' && Number.isInteger(data.n)) {\\n140→      state.inputs[data.n] = {\\n        x: data.x, z: data.z, sx: data.sx, sz: data.sz, tool: data.tool,\\n        use: !!data.use, gift: !!data.gift, steady: !!data.steady,\\n      };\\n      return;\\n    }\\n    if ((data.t === 's' || data.t === 'k') && !hub.isHost) applySnap(state, data.snap);\\n  });\\n  hub.on('leave', (info) => {\\n    if (info && info.id === hub.host) state.hostGone = true;\\n150→  });\\n  hub.on('time-up', () => {\\n    if (state.hostGone) return;\\n    finishRound(hub, state, false);\\n  });\\n  hub.on('end', () => {\\n    state.ended = true;\\n    clearInterval(state.timer);\\n    state.silence?.();\\n  });\\n160→\\n  hub.probe?.(() => ({\\n    scene: state.sim ? 'op' : 'card',\\n    menu: '',\\n    world: state.sim?.id || 'card',\\n    input: 'pad',\\n  }));\\n\\n  state.timer = setInterval(() => {\\n    try {\\n170→    if (state.ended) return;\\n    const t = hub.time();\\n    const wall = nowMs();\\n    if (!hub.isHost && state.me != null) {\\n      state.acc.input += wall - (state.acc.inputAt || wall);\\n      state.acc.inputAt = wall;\\n      if (state.acc.input >= 66) {\\n        state.acc.input = 0;\\n        const loc = state.local || {};\\n        const body = {\\n180→          t: 'i', n: state.me, x: loc.x || 0, z: loc.z || 0, sx: loc.sx || 0, sz: loc.sz || 0,\\n          tool: loc.tool || 'forceps', use: !!loc.use, gift: !!loc.gift, steady: !!loc.steady,\\n        };\\n        if (!allow(state)) return;\\n        hub.send(body, { to: hub.host, reliable: false });\\n      }\\n    } else if (hub.isHost) {\\n      state.acc.ping += wall - (state.acc.pingAt || wall);\\n      state.acc.pingAt = wall;\\n      if (!state.started || t < 0) {\\n190→        if (state.acc.ping >= 250) {\\n          state.acc.ping = 0;\\n          send({ t: 'p' }, false);\\n        }\\n        return;\\n      }\\n      if (state.sim && !state.finished) {\\n        if (state.lastT == null) state.lastT = t;\\n        let steps = Math.round((t - state.lastT) / (DT * 1000));\\n        if (steps > 4) steps = 4;\\n200→        if (steps < 0) steps = 0;\\n        state.lastT += steps * DT * 1000;\\n        for (let i = 0; i < steps; i++) step(state.sim, hostInputs(state), DT);\\n        if (state.sim.phase === 'won' || state.sim.phase === 'lost') finishRound(hub, state, state.sim.phase === 'won');\\n      }\\n      state.acc.snap += wall - (state.acc.snapAt || wall);\\n      state.acc.snapAt = wall;\\n      if (state.sim && state.acc.snap >= 84) {\\n        state.acc.snap = 0;\\n        send({ t: 's', snap: encodeFast(state.sim) }, false);\\n210→      }\\n      state.acc.key += wall - (state.acc.keyAt || wall);\\n      state.acc.keyAt = wall;\\n      if (state.sim && state.acc.key >= 1000) {\\n        state.acc.key = 0;\\n        send({ t: 'k', snap: encodeKey(state.sim) }, true);\\n      }\\n    }\\n    } catch {\\n      /* A bad tick must not take the round down. */\\n220→    }\\n  }, 34);\\n\\n  return state;\\n}\\n\\nexport function stopSession(state) {\\n  if (!state) return;\\n  state.ended = true;\\n  clearInterval(state.timer);\\n230→}\\n\",\"content_concise\":\"1→/** Shared-world host loop. The server copy runs this and never starts the renderer. */\\n\\nimport { applyDecoded, encodeFast, encodeKey } from '../sim/codec.js';\\nimport { createOp, step } from '../sim/op.js';\\nimport { SESSION_OPS } from '../content/ops.js';\\n\\nconst DT = 1 / 60;\\n\\nexport function buildStandings(players, scoreOf) {\\n10→  const scores = {};\\n  const ids = [];\\n  for (const p of players || []) {\\n    if (!Number.isInteger(p.id) || ids.includes(p.id)) continue;\\n    ids.push(p.id);\\n    const n = Number(scoreOf(p));\\n    scores[p.id] = Number.isFinite(n) ? Math.round(n) : 0;\\n  }\\n  ids.sort((a, b) => scores[b] - scores[a] || a - b);\\n  const standings = [];\\n20→  for (const id of ids) {\\n    const group = standings[standings.length - 1];\\n    if (group && scores[group[0]] === scores[id]) group.push(id);\\n    else standings.push([id]);\\n  }\\n  return { standings, scores };\\n}\\n\\nfunction allow(state, cost = 1) {\\n  const t = nowMs();\\n30→  state.tokens = Math.min(30, state.tokens + ((t - state.refill) / 1000) * 16);\\n  state.refill = t;\\n  if (state.tokens < cost) return false;\\n  state.tokens -= cost;\\n  return true;\\n}\\n\\nfunction nowMs() {\\n  return globalThis.performance?.now?.() || Date.now();\\n}\\n40→\\nfunction finishRound(hub, state, won) {\\n  if (state.finished || state.ended || !hub.isHost) return;\\n  const players = (hub.players || []).filter((p) => Number.isInteger(p.id));\\n  if (!players.length) return;\\n  state.finished = true;\\n  const { standings, scores } = buildStandings(players, (p) => state.sim?.seats?.[p.id]?.score || 0);\\n  const stats = {};\\n  for (const p of players) {\\n    stats[p.id] = {\\n50→      SCORE: String(scores[p.id]).slice(0, 16),\\n      MISTAKES: String(state.sim?.mistakes || 0).slice(0, 16),\\n    };\\n  }\\n  const best = standings[0]?.[0];\\n  const awards = best == null ? [] : [{ id: best, title: 'STEADIEST HAND', detail: 'Held the line' }];\\n  const patientSaved = !!won && state.sim?.phase === 'won';\\n  hub.finish({ standings, scores, won: patientSaved, stats, awards });\\n}\\n\\n60→function beginOp(hub, state) {\\n  const list = SESSION_OPS.filter(Boolean);\\n  const def = list[(hub.round || 0) % list.length];\\n  const seed = Math.floor(hub.rng('deal')() * 1e9);\\n  const seats = Math.max(1, (hub.players || []).length);\\n  state.sim = createOp(def, { seed, seats, consult: true, difficulty: 'resident' });\\n  state.onSim?.(state.sim);\\n}\\n\\nfunction applySnap(state, snap) {\\n70→  if (!state.sim || !snap) return;\\n  const view = applyDecoded(state.sim, snap);\\n  const me = state.me;\\n  (view.seats || []).forEach((s, i) => {\\n    const seat = state.sim.seats[i];\\n    if (!seat || i === me) return;\\n    seat.x = s.x;\\n    seat.z = s.z;\\n    seat.tool = s.tool;\\n  });\\n80→  if (view.phase) state.sim.phase = view.phase;\\n  if (view.strainDead) state.sim.flags.strainDead = true;\\n}\\n\\nfunction hostInputs(state) {\\n  const inputs = {};\\n  const n = state.sim?.seats?.length || 0;\\n  for (let i = 0; i < n; i++) {\\n    const net = state.inputs[i] || {};\\n    if (i === state.me && state.local) inputs[i] = { ...net, ...state.local };\\n90→    else inputs[i] = net;\\n  }\\n  return inputs;\\n}\\n\\n/**\\n * Attach the hub listeners and the host timer.\\n * `hub` is the session client. Returns the shared state.\\n */\\nexport function openSession(hub) {\\n100→  const state = {\\n    sim: null,\\n    inputs: {},\\n    local: { x: 0, z: 1.2, tool: 'forceps', use: false, gift: false, steady: false, sx: 0, sz: 0 },\\n    card: null,\\n    started: false,\\n    ended: false,\\n    finished: false,\\n    lastT: null,\\n    tokens: 16,\\n110→    refill: nowMs(),\\n    acc: { input: 0, snap: 0, key: 0, ping: 0 },\\n    me: hub.me,\\n    timer: 0,\\n    silence: null,\\n    onSim: null,\\n  };\\n\\n  const send = (data, reliable) => {\\n    if (state.ended || state.finished) return;\\n120→    if (!allow(state)) return;\\n    hub.send(data, { reliable: !!reliable });\\n  };\\n\\n  hub.on('card', (card) => {\\n    state.card = card;\\n  });\\n  hub.on('start', () => {\\n    state.started = true;\\n    state.me = hub.me;\\n130→    if (state.sim) return;\\n    try {\\n      beginOp(hub, state);\\n    } catch (err) {\\n      hub.fail(String(err?.message || err));\\n    }\\n  });\\n  hub.on('message', (data) => {\\n    if (!data || data.t === 'p') return;\\n    if (data.t === 'i' && Number.isInteger(data.n)) {\\n140→      state.inputs[data.n] = {\\n        x: data.x, z: data.z, sx: data.sx, sz: data.sz, tool: data.tool,\\n        use: !!data.use, gift: !!data.gift, steady: !!data.steady,\\n      };\\n      return;\\n    }\\n    if ((data.t === 's' || data.t === 'k') && !hub.isHost) applySnap(state, data.snap);\\n  });\\n  hub.on('leave', (info) => {\\n    if (info && info.id === hub.host) state.hostGone = true;\\n150→  });\\n  hub.on('time-up', () => {\\n    if (state.hostGone) return;\\n    finishRound(hub, state, false);\\n  });\\n  hub.on('end', () => {\\n    state.ended = true;\\n    clearInterval(state.timer);\\n    state.silence?.();\\n  });\\n160→\\n  hub.probe?.(() => ({\\n    scene: state.sim ? 'op' : 'card',\\n    menu: '',\\n    world: state.sim?.id || 'card',\\n    input: 'pad',\\n  }));\\n\\n  state.timer = setInterval(() => {\\n    try {\\n170→    if (state.ended) return;\\n    const t = hub.time();\\n    const wall = nowMs();\\n    if (!hub.isHost && state.me != null) {\\n      state.acc.input += wall - (state.acc.inputAt || wall);\\n      state.acc.inputAt = wall;\\n      if (state.acc.input >= 66) {\\n        state.acc.input = 0;\\n        const loc = state.local || {};\\n        const body = {\\n180→          t: 'i', n: state.me, x: loc.x || 0, z: loc.z || 0, sx: loc.sx || 0, sz: loc.sz || 0,\\n          tool: loc.tool || 'forceps', use: !!loc.use, gift: !!loc.gift, steady: !!loc.steady,\\n        };\\n        if (!allow(state)) return;\\n        hub.send(body, { to: hub.host, reliable: false });\\n      }\\n    } else if (hub.isHost) {\\n      state.acc.ping += wall - (state.acc.pingAt || wall);\\n      state.acc.pingAt = wall;\\n      if (!state.started || t < 0) {\\n190→        if (state.acc.ping >= 250) {\\n          state.acc.ping = 0;\\n          send({ t: 'p' }, false);\\n        }\\n        return;\\n      }\\n      if (state.sim && !state.finished) {\\n        if (state.lastT == null) state.lastT = t;\\n        let steps = Math.round((t - state.lastT) / (DT * 1000));\\n        if (steps > 4) steps = 4;\\n200→        if (steps < 0) steps = 0;\\n        state.lastT += steps * DT * 1000;\\n        for (let i = 0; i < steps; i++) step(state.sim, hostInputs(state), DT);\\n        if (state.sim.phase === 'won' || state.sim.phase === 'lost') finishRound(hub, state, state.sim.phase === 'won');\\n      }\\n      state.acc.snap += wall - (state.acc.snapAt || wall);\\n      state.acc.snapAt = wall;\\n      if (state.sim && state.acc.snap >= 84) {\\n        state.acc.snap = 0;\\n        send({ t: 's', snap: encodeFast(state.sim) }, false);\\n210→      }\\n      state.acc.key += wall - (state.acc.keyAt || wall);\\n      state.acc.keyAt = wall;\\n      if (state.sim && state.acc.key >= 1000) {\\n        state.acc.key = 0;\\n        send({ t: 'k', snap: encodeKey(state.sim) }, true);\\n      }\\n    }\\n    } catch {\\n      /* A bad tick must not take the round down. */\\n220→    }\\n  }, 34);\\n\\n  return state;\\n}\\n\\nexport function stopSession(state) {\\n  if (!state) return;\\n  state.ended = true;\\n  clearInterval(state.timer);\\n230→}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/src/net/session.js\",\"offset\":null,\"raw_output\":\"/** Shared-world host loop. The server copy runs this and never starts the renderer. */\\n\\nimport { applyDecoded, encodeFast, encodeKey } from '../sim/codec.js';\\nimport { createOp, step } from '../sim/op.js';\\nimport { SESSION_OPS } from '../content/ops.js';\\n\\nconst DT = 1 / 60;\\n\\nexport function buildStandings(players, scoreOf) {\\n  const scores = {};\\n  const ids = [];\\n  for (const p of players || []) {\\n    if (!Number.isInteger(p.id) || ids.includes(p.id)) continue;\\n    ids.push(p.id);\\n    const n = Number(scoreOf(p));\\n    scores[p.id] = Number.isFinite(n) ? Math.round(n) : 0;\\n  }\\n  ids.sort((a, b) => scores[b] - scores[a] || a - b);\\n  const standings = [];\\n  for (const id of ids) {\\n    const group = standings[standings.length - 1];\\n    if (group && scores[group[0]] === scores[id]) group.push(id);\\n    else standings.push([id]);\\n  }\\n  return { standings, scores };\\n}\\n\\nfunction allow(state, cost = 1) {\\n  const t = nowMs();\\n  state.tokens = Math.min(30, state.tokens + ((t - state.refill) / 1000) * 16);\\n  state.refill = t;\\n  if (state.tokens < cost) return false;\\n  state.tokens -= cost;\\n  return true;\\n}\\n\\nfunction nowMs() {\\n  return globalThis.performance?.now?.() || Date.now();\\n}\\n\\nfunction finishRound(hub, state, won) {\\n  if (state.finished || state.ended || !hub.isHost) return;\\n  const players = (hub.players || []).filter((p) => Number.isInteger(p.id));\\n  if (!players.length) return;\\n  state.finished = true;\\n  const { standings, scores } = buildStandings(players, (p) => state.sim?.seats?.[p.id]?.score || 0);\\n  const stats = {};\\n  for (const p of players) {\\n    stats[p.id] = {\\n      SCORE: String(scores[p.id]).slice(0, 16),\\n      MISTAKES: String(state.sim?.mistakes || 0).slice(0, 16),\\n    };\\n  }\\n  const best = standings[0]?.[0];\\n  const awards = best == null ? [] : [{ id: best, title: 'STEADIEST HAND', detail: 'Held the line' }];\\n  const patientSaved = !!won && state.sim?.phase === 'won';\\n  hub.finish({ standings, scores, won: patientSaved, stats, awards });\\n}\\n\\nfunction beginOp(hub, state) {\\n  const list = SESSION_OPS.filter(Boolean);\\n  const def = list[(hub.round || 0) % list.length];\\n  const seed = Math.floor(hub.rng('deal')() * 1e9);\\n  const seats = Math.max(1, (hub.players || []).length);\\n  state.sim = createOp(def, { seed, seats, consult: true, difficulty: 'resident' });\\n  state.onSim?.(state.sim);\\n}\\n\\nfunction applySnap(state, snap) {\\n  if (!state.sim || !snap) return;\\n  const view = applyDecoded(state.sim, snap);\\n  const me = state.me;\\n  (view.seats || []).forEach((s, i) => {\\n    const seat = state.sim.seats[i];\\n    if (!seat || i === me) return;\\n    seat.x = s.x;\\n    seat.z = s.z;\\n    seat.tool = s.tool;\\n  });\\n  if (view.phase) state.sim.phase = view.phase;\\n  if (view.strainDead) state.sim.flags.strainDead = true;\\n}\\n\\nfunction hostInputs(state) {\\n  const inputs = {};\\n  const n = state.sim?.seats?.length || 0;\\n  for (let i = 0; i < n; i++) {\\n    const net = state.inputs[i] || {};\\n    if (i === state.me && state.local) inputs[i] = { ...net, ...state.local };\\n    else inputs[i] = net;\\n  }\\n  return inputs;\\n}\\n\\n/**\\n * Attach the hub listeners and the host timer.\\n * `hub` is the session client. Returns the shared state.\\n */\\nexport function openSession(hub) {\\n  const state = {\\n    sim: null,\\n    inputs: {},\\n    local: { x: 0, z: 1.2, tool: 'forceps', use: false, gift: false, steady: false, sx: 0, sz: 0 },\\n    card: null,\\n    started: false,\\n    ended: false,\\n    finished: false,\\n    lastT: null,\\n    tokens: 16,\\n    refill: nowMs(),\\n    acc: { input: 0, snap: 0, key: 0, ping: 0 },\\n    me: hub.me,\\n    timer: 0,\\n    silence: null,\\n    onSim: null,\\n  };\\n\\n  const send = (data, reliable) => {\\n    if (state.ended || state.finished) return;\\n    if (!allow(state)) return;\\n    hub.send(data, { reliable: !!reliable });\\n  };\\n\\n  hub.on('card', (card) => {\\n    state.card = card;\\n  });\\n  hub.on('start', () => {\\n    state.started = true;\\n    state.me = hub.me;\\n    if (state.sim) return;\\n    try {\\n      beginOp(hub, state);\\n    } catch (err) {\\n      hub.fail(String(err?.message || err));\\n    }\\n  });\\n  hub.on('message', (data) => {\\n    if (!data || data.t === 'p') return;\\n    if (data.t === 'i' && Number.isInteger(data.n)) {\\n      state.inputs[data.n] = {\\n        x: data.x, z: data.z, sx: data.sx, sz: data.sz, tool: data.tool,\\n        use: !!data.use, gift: !!data.gift, steady: !!data.steady,\\n      };\\n      return;\\n    }\\n    if ((data.t === 's' || data.t === 'k') && !hub.isHost) applySnap(state, data.snap);\\n  });\\n  hub.on('leave', (info) => {\\n    if (info && info.id === hub.host) state.hostGone = true;\\n  });\\n  hub.on('time-up', () => {\\n    if (state.hostGone) return;\\n    finishRound(hub, state, false);\\n  });\\n  hub.on('end', () => {\\n    state.ended = true;\\n    clearInterval(state.timer);\\n    state.silence?.();\\n  });\\n\\n  hub.probe?.(() => ({\\n    scene: state.sim ? 'op' : 'card',\\n    menu: '',\\n    world: state.sim?.id || 'card',\\n    input: 'pad',\\n  }));\\n\\n  state.timer = setInterval(() => {\\n    try {\\n    if (state.ended) return;\\n    const t = hub.time();\\n    const wall = nowMs();\\n    if (!hub.isHost && state.me != null) {\\n      state.acc.input += wall - (state.acc.inputAt || wall);\\n      state.acc.inputAt = wall;\\n      if (state.acc.input >= 66) {\\n        state.acc.input = 0;\\n        const loc = state.local || {};\\n        const body = {\\n          t: 'i', n: state.me, x: loc.x || 0, z: loc.z || 0, sx: loc.sx || 0, sz: loc.sz || 0,\\n          tool: loc.tool || 'forceps', use: !!loc.use, gift: !!loc.gift, steady: !!loc.steady,\\n        };\\n        if (!allow(state)) return;\\n        hub.send(body, { to: hub.host, reliable: false });\\n      }\\n    } else if (hub.isHost) {\\n      state.acc.ping += wall - (state.acc.pingAt || wall);\\n      state.acc.pingAt = wall;\\n      if (!state.started || t < 0) {\\n        if (state.acc.ping >= 250) {\\n          state.acc.ping = 0;\\n          send({ t: 'p' }, false);\\n        }\\n        return;\\n      }\\n      if (state.sim && !state.finished) {\\n        if (state.lastT == null) state.lastT = t;\\n        let steps = Math.round((t - state.lastT) / (DT * 1000));\\n        if (steps > 4) steps = 4;\\n        if (steps < 0) steps = 0;\\n        state.lastT += steps * DT * 1000;\\n        for (let i = 0; i < steps; i++) step(state.sim, hostInputs(state), DT);\\n        if (state.sim.phase === 'won' || state.sim.phase === 'lost') finishRound(hub, state, state.sim.phase === 'won');\\n      }\\n      state.acc.snap += wall - (state.acc.snapAt || wall);\\n      state.acc.snapAt = wall;\\n      if (state.sim && state.acc.snap >= 84) {\\n        state.acc.snap = 0;\\n        send({ t: 's', snap: encodeFast(state.sim) }, false);\\n      }\\n      state.acc.key += wall - (state.acc.keyAt || wall);\\n      state.acc.keyAt = wall;\\n      if (state.sim && state.acc.key >= 1000) {\\n        state.acc.key = 0;\\n        send({ t: 'k', snap: encodeKey(state.sim) }, true);\\n      }\\n    }\\n    } catch {\\n      /* A bad tick must not take the round down. */\\n    }\\n  }, 34);\\n\\n  return state;\\n}\\n\\nexport function stopSession(state) {\\n  if (!state) return;\\n  state.ended = true;\\n  clearInterval(state.timer);\\n}\\n\",\"total_lines\":230}}","is_error":false},{