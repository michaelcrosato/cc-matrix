udes('hook') && dev.sim.strain?.name === 'introit');\"},{\"line_number\":689,\"content\":\"  check('input path frame step', dev.devTab === 4 && dev.sim.t > t0 && dev.devRows().some((row) => row.startsWith('FPS')) && dev.devRows().some((row) => row.startsWith('SIM ')));\"},{\"line_number\":700,\"content\":\"  check('input path scene list', scenes.jumpKind === 'scene' && scenes.devRows()[0] === 'LIST SCENES');\"},{\"line_number\":719,\"content\":\"    check('host keeps mouse aim', hostState.local.place === true && Math.abs(aim - 2.2) < 0.25);\"},{\"line_number\":723,\"content\":\"    check('host place reaches sim', Math.abs(hostState.sim.seats[0].x - aim) < 0.05 && Math.abs(hostState.sim.seats[0].x - before) > 0.5);\"},{\"line_number\":736,\"content\":\"    const spawnX = clientState.sim.seats[1].x;\"},{\"line_number\":738,\"content\":\"    check('client mouse tip', Math.abs(client.sim.seats[1].x - 2.2) < 0.25 && Math.abs(client.sim.seats[1].x - spawnX) > 0.5);\"},{\"line_number\":741,\"content\":\"    const packet = clientHub.sent.find((row) => row.data && row.data.t === 'i' && row.data.place);\"},{\"line_number\":742,\"content\":\"    check('client sends place', !!packet && Math.abs(packet.data.x - client.sim.seats[1].x) < 0.05);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/tests/live.mjs\",\"matches\":[{\"line_number\":2,\"content\":\"import { execFileSync, spawn } from 'node:child_process';\"},{\"line_number\":174,\"content\":\"    // Button 8 only marks the pad as the last device. Button 0 confirms the glyphs row and would toggle it.\"},{\"line_number\":318,\"content\":\"    for (let i = 1; i <= 3; i++) await poke(shotPage.page, 'e', (n) => window.__GAME__.app.devTab === n, i);\"},{\"line_number\":357,\"content\":\"        for (let i = 0; i < 45; i++) g.act({ tool: 'drain', place: true, x: -3.1, z: -1.1, use: true, seat: 0 })