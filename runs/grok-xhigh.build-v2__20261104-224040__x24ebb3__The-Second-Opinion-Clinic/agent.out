\\n    sim.phase = 'play';\\n    enterStage(sim);\\n  }\\n}\\n\\nexport function retryStage(sim) {\\n  if (!sim.stageSnap) return sim;\\n  const cursors = sim.seats.map((s) => ({ x: s.x, z: s.z }));\\n  restore(sim, sim.stageSnap);\\n  sim.seats.forEach((s, i) => {\\n    s.x = cursors[i].x;\\n    s.z = cursors[i].z;\\n  });\\n  sim.persist.rankCap = 'B';\\n  sim.phase = 'play';\\n  return sim;\\n}\\n\",\"total_lines\":1151}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa39-3d19-7772-a082-6fbf4c1e0ec4","uuid":"717fcbc1-36da-4781-97d9-f435061a3ec6"}
