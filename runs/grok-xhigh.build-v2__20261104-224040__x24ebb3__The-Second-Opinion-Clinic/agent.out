rs).\"},{\"line_number\":2796,\"content\":\"Where an element is attached on screen; it is also aligned that way (right-anchored text grows left).\"},{\"line_number\":2809,\"content\":\"- `anchor?: HudAnchor`: Default 'top-left': x/y are offsets from that screen corner/edge, in art pixels.\"},{\"line_number\":2814,\"content\":\"function hudPlace(x: number, y: number, w: number, h: number, anchor: HudAnchor, size: Resolution): [number, number]\"},{\"line_number\":2818,\"content\":\"`anchor` on a screen of `size` art pixels. Pure (unit-tested).\"},{\"line_number\":2949,\"content\":\"- `readonly anchors?: Readonly<Record<string, Anchor>>`\"},{\"line_number\":3099,\"content\":\"- `readonly anchors: Readonly<Record<string, { readonly at: Vec3; readonly rot: Vec3 }>>`\"},{\"line_number\":3134,\"content\":\"- `readonly anchors?: Readonly<Record<string, Anchor>>`: Oriented ones (`{ at, rot }`) for grips and mounts.\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-86c03c64-4b78-4649-bd37-cce528c31a50-64","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,52,48,95,95,120,50,52,101,98,98,51,47,119,111,114,107,34,62,10,70,111,117,110,100,32,57,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,52,48,95,95,120,50,52,101,98,98,51,47,119,111,114,107,47,84,104,101,45,83,101,99,111,110,100,45,79,112,105,110,105,111,110,45,67,108,105,110,105,99,45,84,114,97,117,109,97,45,67,101,110,116,101,1