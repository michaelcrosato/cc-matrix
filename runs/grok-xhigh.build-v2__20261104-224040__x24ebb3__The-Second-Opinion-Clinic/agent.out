(t);\"},{\"line_number\":163,\"content\":\"  if (st.massage) {\"},{\"line_number\":164,\"content\":\"    sim.phase = 'massage';\"},{\"line_number\":165,\"content\":\"    sim.massageT = 0;\"},{\"line_number\":166,\"content\":\"    sim.massageCount = 0;\"},{\"line_number\":167,\"content\":\"    sim.massageBeat = -1;\"},{\"line_number\":169,\"content\":\"  if (st.codeblue) beginCode(sim, true, sim.active);\"},{\"line_number\":182,\"content\":\"  if (!st.spawned.length) return sim.stageT > 0.2;\"},{\"line_number\":183,\"content\":\"  return st.spawned.every((id) => {\"},{\"line_number\":194,\"content\":\"  if (sim.stageIndex >= sim.stages.length) win(sim);\"},{\"line_number\":198,\"content\":\"function win(sim) {\"},{\"line_number\":240,\"content\":\"  if (sim.god) return;\"},{\"line_number\":271,\"content\":\"  if (sim.phase === 'codeblue') {\"},{\"line_number\":275,\"content\":\"  if (sim.phase === 'massage') {\"},{\"line_number\":302,\"content\":\"  if (sim.vitals < 50 && sim.def?.tools?.includes('syringe')) sim.unlocked.add('syringe');\"},{\"line_number\":314,\"content\":\"  if (want && sim.phase === 'codeblue') want = false;\"},{\"line_number\":316,\"content\":\"  if (sim.quietOn && !sim.god) {\"},{\"line_number\":327,\"content\":\"    if (input.tool && sim.unlocked.has(input.tool)) seat.tool = input.tool;\"},{\"line_number\":364,\"content\":\"  if (sim.phase === 'codeblue') return false;\"},{\"line_number\":380,\"content\":\"    sim.persist.needRewind = false;\"},{\"line_number\":405,\"content\":\"    stageSpawned: sim.stages.map((st) => [...(st.spawned || [])]),\"},{\"line_number\":412,\"content\":\"    phase: sim.phase === 'codeblue' ? 'play' : sim.phase,\"},{\"line_number\":420,\"content\":\"    unlocked: [...sim.unlocked],\"},{\"line_number\":435,\"content\":\"    st.spawned = data.stageSpawned[i] ? [...data.stageSpawned[i]] : [];\"},{\"line_number\":451,\"content\":\"  sim.unlocked = new Set(data.unlocked);\"},{\"line_number\":467,\"content\":\"  sim.phase = 'codeblue';\"},{\"line_number\":469,\"content\":\"  if (!scripted) sim.persist.bluesLeft -= 1;\"},{\"line_number\":470,\"content\":\"  pushEvent(sim, { type: 'codeblue', scripted: !!scripted });\"},{\"line_number\":492,\"content\":\"    const half = sim.config.blueZone / 2;\"},{\"line_number\":503,\"content\":\"    if (c.scripted) sim.flags.blueDone = true;\"},{\"line_number\":508,\"content\":\"  if (c.left <= 0) lose(sim, 'codeblue');\"},{\"line_number\":512,\"content\":\"  sim.massageT += dt;\"},{\"line_number\":514,\"content\":\"  const beatIndex = Math.floor(sim.massageT / period);\"},{\"line_number\":515,\"content\":\"  if (beatIndex !== sim.massageBeat) {\"},{\"line_number\":516,\"content\":\"    sim.massageBeat = beatIndex;\"},{\"line_number\":517,\"content\":\"    sim.massageOpen = true;\"},{\"line_number\":518,\"content\":\"    sim.massageWindow = 0.2;\"},{\"line_number\":520,\"content\":\"  if (!sim.massageOpen) return;\"},{\"line_number\":521,\"content\":\"  sim.massageWindow -= dt;\"},{\"line_number\":522,\"content\":\"  const wantL = sim.massageCount % 2 === 0;\"},{\"line_number\":529,\"content\":\"    sim.massageCount += 1;\"},{\"line_number\":530,\"content\":\"    sim.massageOpen = false;\"},{\"line_number\":532,\"content\":\"    if (sim.massageCount >= 8) {\"},{\"line_number\":533,\"content\":\"      sim.flags.massaged = true;\"},{\"line_number\":536,\"content\":\"  } else if (sim.massageWindow <= 0) sim.massageOpen = false;\"},{\"line_number\":542,\"content\":\"    const using = !!input.use && (sim.unlocked.has(seat.tool) || seat.tool === 'dressing');\"},{\"line_number\":604,\"content\":\"      spawn(sim, { kind: 'nick', x: seat.x, z: seat.z, optional: true, table: sim.active });\"},{\"line_number\":633,\"content\":\"    spawn(sim, { kind: 'wound', x: e.x, z: e.z, len: 0.9, dx: 1, dz: 0, table: e.table });\"},{\"line_number\":648,\"content\":\"      if (e.window === 'diastole' && !sim.diastole) {\"},{\"line_number\":678,\"content\":\"  if (held.window === 'diastole' && !sim.diastole) {\"},{\"line_number\":689,\"content\":\"    spawn(sim, { kind: 'nick', x: seat.x, z: seat.z, optional: true, table: held.table });\"},{\"line_number\":711,\"content\":\"      held.windowHit = false;\"},{\"line_number\":728,\"content\":\"    sim.persist.needRewind = true;\"},{\"line_number\":733,\"content\":\"    spawn(sim, { kind: 'pool', x: e.x, z: e.z, r: 0.8, bleed: true, table: e.table });\"},{\"line_number\":743,\"content\":\"  if (e.windowHit) return;\"},{\"line_number\":744,\"content\":\"  e.windowHit = true;\"},{\"line_number\":745,\"content\":\"  spawn(sim, { kind: 'nick', x: e.x, z: e.z, optional: true, table: e.table });\"},{\"line_number\":770,\"content\":\"  if (e.window === 'diastole' && !sim.diastole) {\"},{\"line_number\":781,\"content\":\"      spawn(sim, { kind: 'pool', x: seat.x, z: seat.z, r: 0.55, bleed: true, table: e.table });\"},{\"line_number\":799,\"content\":\"      e.windowHit = false;\"},{\"line_number\":858,\"content\":\"    if (e.window === 'diastole' && !sim.diastole) {\"},{\"line_number\":890,\"content\":\"      spawn(sim, { kind: 'nick', x: seat.x, z: seat.z, optional: true, table: sim.active });\"},{\"line_number\":940,\"content\":\"  const using = !!input.use && seat.tool === 'syringe' && sim.unlocked.has('syringe');\"},{\"line_number\":1009,\"content\":\"        spawn(sim, { kind: 'nick', x: e.x, z: Math.max(-3.2, e.z), optional: true });\"},{\"line_number\":1026,\"content\":\"    if (e.window === 'diastole') e.windowHit = sim.diastole ? false : e.windowHit;\"},{\"line_number\":1031,\"content\":\"  if (quiet || sim.god || sim.phase !== 'play') return;\"},{\"line_number\":1045,\"content\":\"  if (sim.god || sim.freezeClock || sim.phase !== 'play') return;\"},{\"line_number\":1054,\"content\":\"  if (sim.god || sim.phase !== 'play') return;\"},{\"line_number\":1058,\"content\":\"    if (sim.persist.bluesLeft <= 0) {\"},{\"line_number\":1091,\"content\":\"export function devCheat(sim, action, arg) {\"},{\"line_number\":1093,\"content\":\"  if (action === 'god') sim.god = !sim.god;\"},{\"line_number\":1094,\"content\":\"  else if (action === 'freeze') sim.freezeClock = !sim.freezeClock;\"},{\"line_number\":1097,\"content\":\"  else if (action === 'unlock') {\"},{\"line_number\":1098,\"content\":\"    for (const t of ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner', 'dressing']) sim.unlocked.add(t);\"},{\"line_number\":1099,\"content\":\"  } else if (action === 'complete') {\"},{\"line_number\":1101,\"content\":\"    for (const id of st?.spawned || []) {\"},{\"line_number\":1106,\"content\":\"    sim.flags.blueDone = true;\"},{\"line_number\":1107,\"content\":\"    sim.flags.massaged = true;\"},{\"line_number\":1109,\"content\":\"  } else if (action === 'win') win(sim);\"},{\"line_number\":1110,\"content\":\"  else if (action === 'fail') lose(sim, 'dev');\"},{\"line_number\":1111,\"content\":\"  else if (action === 'blue') beginCode(sim, true, sim.active);\"},{\"line_number\":1112,\"content\":\"  else if (action === 'spawn') spawn(sim, arg || { kind: 'pool', x: 0, z: 0, r: 0.8 });\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa39-3d19-7772-a082-6fbf4c1e0ec4","uuid":"630d19d4-fb01-40aa-8453-ba48475e3690"}
