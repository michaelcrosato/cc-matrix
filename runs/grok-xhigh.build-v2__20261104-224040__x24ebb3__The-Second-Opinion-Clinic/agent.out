s\":[{\"line_number\":100,\"content\":\"/** A fresh game: the page starts one, and `node check.mjs --headless` plays one in Node (section 8). */\"},{\"line_number\":103,\"content\":\"if (typeof document !== 'undefined') await Engine.start(createGame(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'iso' } }));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/check.mjs\",\"matches\":[{\"line_number\":10,\"content\":\"//   node check.mjs --headless game.js    play the game in Node, no browser: steps, errors, a replay\"},{\"line_number\":23,\"content\":\"//   --headless [game.js]             play a game module in Node with Engine.headless instead of a\"},{\"line_number\":31,\"content\":\"// It needs Node 20.15+ (or 22.2+) and, except for --headless, Playwright (`npm i -D playwright` then\"},{\"line_number\":33,\"content\":\"// `playwright-core` with CHROMIUM_PATH set to a Chromium (its headless shell,\"},{\"line_number\":34,\"content\":\"// `chrome-linux/headless_shell`, is the lightest): it plays WebGPU on SwiftShader with no\"},{\"line_number\":56,\"content\":\"const FLAG = new Set(['cameras', 'help', 'headless']);\"},{\"line_number\":78,\"content\":\"const headless = opts.headless === true;\"},{\"line_number\":79,\"content\":\"if (headless && (sheets || opts.cameras || opts.looks)) fail('--headless plays the game in Node, with no pictures: --sheets, --cameras and --looks need the browser');\"},{\"line_number\":80,\"content\":\"const target = positional[0] ?? (headless ? 'game.js' : 'index.html');\"},{\"line_number\":207,\"content\":\"// which the headless shell needs to present\"},{\"line_number\":221,\"content\":\" * --headless: the game in Node (Engine.headless), no browser. The engine is the pixel-engine.js the\"},{\"line_number\":227,\"content\":\"  if (!/\\\\.m?js$/.test(path)) fail(`--headless plays a game module (game.js), not ${file}: pages need the browser (no --headless)`);\"},{\"line_number\":231,\"content\":\"  const report = { ok: false, mode: 'headless', module: relative(process.cwd(), path) || file, keys: opts.keys ?? '*90', frames: 0, fingerprint: null, replayed: null, status: null, state: null, errors: [] };\"},{\"line_number\":236,\"content\":\"    console.log(`check.mjs --headless ${report.module}: ${report.frames} frames in Node${report.status ? `, ${report.status}` : ''}`);\"},{\"line_number\":259,\"content\":\"  if (!make) fail(`${file} exports no createGame(): --headless makes the game with it, a fresh one for the replay (GUIDE.md section 8)`);\"},{\"line_number\":266,\"content\":\"    engine = await within(Engine.headless(make(), { assets: read, viewport: { width: vw, height: vh, dpr: 1 } }), 'the game\\\\'s start');\"},{\"line_number\":292,\"content\":\"if (headless) await runHeadless(target);\"},{\"line_number\":298,\"content\":\"    // headless (Playwright's headless launch is Chromium's headless shell): no display needed\"},{\"line_number\":299,\"content\":\"    return await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ARGS, headless: true });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/src/content/about.js\",\"matches\":[{\"line_number\":16,\"content\":\"  environment: 'Grok CLI (headless); Linux',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/examples/looks.js\",\"matches\":[{\"line_number\":104,\"content\":\"await Engine.start(new LookLab(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'iso', zoom: 1.3 }, look: STORYBOOK_HEROES }));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/examples/top-down.js\",\"matches\":[{\"line_number\":162,\"content\":\"await Engine.start(new LanternNight(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'topdown', zoom: 1.1 }, look: LOOK_PRESETS.dream }));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/examples/market.js\",\"matches\":[{\"line_number\":72,\"content\":\"await Engine.start(new MarketCorner(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'iso', zoom: 1.6 } }));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/types/engine/index.d.ts\",\"matches\":[{\"line_number\":55,\"content\":\"export { HEADLESS_VIEWPORT, HeadlessView, type HeadlessViewOptions } from './render/headlessView';\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/examples/side-scroller.js\",\"matches\":[{\"line_number\":167,\"content\":\"await Engine.start(new CliffRun(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'side', zoom: 1.2 }, background: PALETTE.sky }));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/types/engine/texture/types.d.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * its palette's slots; `bakeTexture` turns it into palette indices and RGBA, headless and pure.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/