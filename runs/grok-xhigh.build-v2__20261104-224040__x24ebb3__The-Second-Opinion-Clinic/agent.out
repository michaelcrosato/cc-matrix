ixel-art icon as data: one string per row, one character per pixel, mapped\\n     * through `colors` ('.' or ' ' = transparent).\\n     *\\n     *   hud.sprite(4, 4, ['.yy.', 'ywyy', 'yyyy', '.yy.'], { y: 'sand', w: 'white' });\\n     */\\n    sprite(x: number, y: number, rows: readonly string[], colors: Record<string, HudColor>, options?: HudOptions): void;\\n    /** Remove everything. */\\n    clear(): void;\\n    /** Size of `text` in art pixels at `scale`. */\\n    measure(text: string, scale?: number): {\\n        width: number;\\n        height: number;\\n    };\\n    /** Engine: follow the renderer's resolution and framing, and repaint if needed. */\\n    sync(resolution: Resolution, framing: Framing): void;\\n    dispose(): void;\\n    private createCanvas;\\n    private paint;\\n    private glyphs;\\n    private place;\\n}\\n/**\\n * Top-left corner, in whole art pixels, of a w×h element placed at offset (x, y) from\\n * `anchor` on a screen of `size` art pixels. Pure (unit-tested).\\n */\\nexport declare function hudPlace(x: number, y: number, w: number, h: number, anchor: HudAnchor, size: Resolution): [number, number];\\n\",\"total_lines\":73}}","is_error":false},{"type":"tool_result","tool_use_id":"call-8e9bc24d-bfbd-467f-be0c-803591b93bb6-59","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,52,48,95,95,120,50,52,101,98,98,51,47,119,111,114,107,34,62,10,70,111,117,110,100,32,56,48,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,