h\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/src/game/clinic.js\",\"matches\":[{\"line_number\":95,\"content\":\"    this.padInputs = {};\"},{\"line_number\":155,\"content\":\"  fixedUpdate(ctx, dt) {\"},{\"line_number\":165,\"content\":\"      if (human && this.padInputs[i]) inputs[i] = this.padInputs[i];\"},{\"line_number\":180,\"content\":\"    if (this.session) this.pullSession();\"},{\"line_number\":257,\"content\":\"    if (this.mode === 'dev') return this.devRows();\"},{\"line_number\":274,\"content\":\"  devRows() {\"},{\"line_number\":278,\"content\":\"    if (this.devTab === 4) return [`HITBOXES ${this.hitbox ? 'ON' : 'OFF'}`, `BOT ${this.botSkill.toFixed(1)}`, `SPEED ${this.simSpeed.toFixed(1)}`];\"},{\"line_number\":370,\"content\":\"  pullSession() {\"},{\"line_number\":456,\"content\":\"    this.padInputs = {};\"},{\"line_number\":462,\"content\":\"      this.padInputs[pad.index] = row;\"},{\"line_number\":492,\"content\":\"    if (this.device === 'pad' && this.padInputs[0]) this.humanInput = { ...this.padInputs[0], ...row.tool ? { tool: row.tool } : {} };\"},{\"line_number\":533,\"content\":\"    else if (this.mode === 'dev') this.pickDev();\"},{\"line_number\":660,\"content\":\"  pickDev() {\"},{\"line_number\":754,\"content\":\"    this.joined.forEach((on, i) => { if (on) this.padInputs[i] = this.padInputs[i] || { sx: 0, sz: 0, use: false }; });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224040__x24ebb3/work/The-Second-Opinion-Clinic-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224040/pixel-engine.js\",\"matches\":[{\"line_number\":579,\"content\":\"      </div>`;for(let e of this.root.querySelectorAll(`[data-s]`))this.controls.set(e.dataset.s,e);for(let e of this.root.querySelectorAll(`[data-o]`))this.outputs.set(e.dataset.o,e);let o=e.settings,s=(e,t)=>{let n=this.controls.get(e