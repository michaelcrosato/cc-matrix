d', couch.sim.seats[0].x > left0 + 0.2 && couch.sim.seats[1].x < right0 - 0.2);\"},{\"line_number\":524,\"content\":\"  stick.humanInput = { place: true, x: 3, z: 0, use: false };\"},{\"line_number\":525,\"content\":\"  stick.padInputs = { 0: { sx: -1, sz: 0, use: false } };\"},{\"line_number\":533,\"content\":\"  dev.devTab = 2;\"},{\"line_number\":536,\"content\":\"  check('jump list cycles to stages', dev.jumpKind === 'stage' && dev.devRows().includes('STAGE 1'));\"},{\"line_number\":541,\"content\":\"  dev.devTab = 2;\"},{\"line_number\":542,\"content\":\"  dev.jumpKind = 'scene';\"},{\"line_number\":547,\"content\":\"  const spawned = new Clinic();\"},{\"line_number\":548,\"content\":\"  spawned.beginOp('op1', { seed: 1 });\"},{\"line_number\":549,\"content\":\"  spawned.goto('dev');\"},{\"line_number\":550,\"content\":\"  spawned.devTab = 3;\"},{\"line_number\":551,\"content\":\"  const before = spawned.sim.entities.length;\"},{\"line_number\":553,\"content\":\"    spawned.focus = spawned.devRows().indexOf(label);\"},{\"line_number\":554,\"content\":\"    spawned.pickDev();\"},{\"line_number\":556,\"content\":\"  const kinds = spawned.sim.entities.slice(before).map((e) => e.kind);\"},{\"line_number\":557,\"content\":\"  check('spawn kinds', kinds.includes('pool') && kinds.includes('bleeder') && kinds.includes('wound') && kinds.includes('hook') && spawned.sim.strain?.name === 'introit');\"},{\"line_number\":558,\"content\":\"  spawned.devTab = 4;\"},{\"line_number\":559,\"content\":\"  const view = spawned.devRows();\"},{\"line_number\":561,\"content\":\"  const t0 = spawned.sim.t;\"},{\"line_number\":562,\"content\":\"  spawned.focus = view.indexOf('FRAME STEP');\"},{\"line_number\":563,\"content\":\"  spawned.pickDev();\"},{\"line_number\":564,\"content\":\"  check('frame step', spawned.sim.t > t0);\"},{\"line_number\":565,\"content\":\"  spawned.focus = 1;\"},{\"line_number\":566,\"content\":\"  spawned.pickDev();\"},{\"line_number\":567,\"content\":\"  chec