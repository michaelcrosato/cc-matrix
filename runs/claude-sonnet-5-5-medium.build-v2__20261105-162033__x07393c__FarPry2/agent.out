utSine'], [30, { ArmR: [-70, 0, -5], ForearmR: [-130, 0, 0], Head: [-6, 0, 0] }, 'inOutSine'], [60, { ArmR: [-70, 0, -5], ForearmR: [-130, 0, 0], Head: [-6, 0, 0] }, 'inOutSine'], [90, { ArmR: [-20, 0, -5], ForearmR: [-30, 0, 0] }]]);\nexport const CleanRifleIdle = loop('CleanRifleIdle', 80, [[0, { ArmR: [-50, 0, -5], ForearmR: [-60, 0, 0], ArmL: [-50, 0, 12], ForearmL: [-70, 0, 0], Head: [18, 0, 0] }, 'inOutSine'], [40, { ArmR: [-54, 0, -5], ForearmR: [-70, 0, 0], ArmL: [-46, 0, 12], ForearmL: [-60, 0, 0], Head: [20, 0, 0] }, 'inOutSine'], [80, { ArmR: [-50, 0, -5], ForearmR: [-60, 0, 0], ArmL: [-50, 0, 12], ForearmL: [-70, 0, 0], Head: [18, 0, 0] }]]);\nexport const WriteAtDesk = loop('WriteAtDesk', 60, [[0, { LegR: [-85, 0, 0], ShinR: [85, 0, 0], LegL: [-85, 0, 0], ShinL: [85, 0, 0], Torso: [22, 0, 0], ArmR: [-50, 0, -5], ForearmR: [-70, 0, 0], ArmL: [-40, 0, 12], ForearmL: [-60, 0, 0], Head: [30, 0, 0] }, 'inOutSine'], [20, { LegR: [-85, 0, 0], ShinR: [85, 0, 0], LegL: [-85, 0, 0], ShinL: [85, 0, 0], Torso: [24, 0, 0], ArmR: [-48, 0, -2], ForearmR: [-72, 0, 0], ArmL: [-40, 0, 12], ForearmL: [-60, 0, 0], Head: [32, 0, 0] }, 'inOutSine'], [60, { LegR: [-85, 0, 0], ShinR: [85, 0, 0], LegL: [-85, 0, 0], ShinL: [85, 0, 0], Torso: [22, 0, 0], ArmR: [-50, 0, -5], ForearmR: [-70, 0, 0], ArmL: [-40, 0, 12], ForearmL: [-60, 0, 0], Head: [30, 0, 0] }]]);\nexport const TeachPoint = loop('TeachPoint', 80, [[0, { ArmR: [-90, 0, -10], ForearmR: [-10, 0, 0], ArmL: [-10, 0, 10], Head: [-4, 0, 0] }, 'inOutSine'], [40, { ArmR: [-100, 0, -18], ForearmR: [-14, 0, 0], ArmL: [-10, 0, 10], Head: [-2, 10, 0] }, 'inOutSine'], [80, { ArmR: [-90, 0, -10], ForearmR: [-10, 0, 0], ArmL: [-10, 0, 10], Head: [-4, 0, 0] }]]);\nexport const PERSON_CLIPS = [AimIdle, FireRecoil, UnjamSwear, Reload, ThrowBottle, BurnPanic, Beg, Surrender, WoundedSit, DragBackward, CarryOver, DriveSit, WalkHandsTied, Shrug, SmokeIdle, CleanRifleIdle, WriteAtDesk, TeachPoint];\nEOF\ncat > src/art/catalog.js <<'EOF'\n// One catalog for the library plus every model the game defines.\nimport { MODEL_LIBRARY, ModelCatalog } from '../../pixel-engine.js';\nimport { ALL_PEOPLE } from './people.js';\nimport { WORLD_MODELS } from './world-models.js';\nimport { VEHICLE_MODELS } from './vehicles.js';\nimport { VM_LIST } from './guns.js';\nexport const GAME_MODELS = [...ALL_PEOPLE, ...WORLD_MODELS, ...VEHICLE_MODELS, ...VM_LIST];\nexport const CATALOG = new ModelCatalog([...MODEL_LIBRARY.all(), ...GAME_MODELS]);\nEOF\ncat > scratch/t5.mjs <<'EOF'\nimport { compileClips, validateClip, analyzeClip, HERO_RIG, buildModel, HERO_CLIPS } from '../pixel-engine.js';\nimport { PERSON_CLIPS } from '../src/art/clips.js';\nimport { CATALOG } from '../src/art/catalog.js';\nconst b = buildModel('soldier-concord-0-beret', { catalog: CATALOG });\nconst rig = { ...HERO_RIG, spine: undefined };\nconst clips = compileClips([...HERO_CLIPS.filter(c=>['Idle','Walk','Run','HitReact','Death','Crouch','Sit','Sleep'].includes(c.name)), ...PERSON_CLIPS], rig, b.object);\nconsole.log(clips.length, clips.map(c=>c.name+':'+c.tracks.length).join(' ').slice(0,300));\nfor (const c of PERSON_CLIPS.slice(0,3)) { const v = validateClip(c, rig); console.log(c.name, JSON.stringify(v).slice(0,200)); }\nEOF\ntimeout 60 node scratch/t5.mjs 2>&1 | head -20"}}}
