res) { const g = this.g;\",\"  showResults(res) { const g = this.g; if (this.session.kind !== 'solo') return;\")\nopen(p,'w').write(s)\n# flow: startRound / endRound\np='src/flow.js'\ns=open(p).read()\ns=s.replace(\"import { ALL_KB, ALL_PAD } from './core/actions.js';\",\"import { ALL_KB, ALL_PAD } from './core/actions.js';\\nimport { soloSession } from './net/solo.js';\\nimport { Lifecycle } from './net/lifecycle.js';\\nimport { RoundSystem } from './net/round.js';\")\ns=s.replace(\"  // ---- sleeping, rail, collapse, death ----\",\"\"\"  startRound() {\n    const g = this.g; g.ui.closeAll(); g.camState.override = null; this.resetWorld(); g.missions.abort(); g.fireSys.reset(); g.weapons.views.hidden = false;\n    g.session = soloSession(g); g.life = new Lifecycle(g.session); g.round = new RoundSystem(g.session);\n    for (const s of [g.life, g.round]) { g.systems.splice(g.systems.length - 1, 0, s); s.setup(g); }\n    g.hudHidden = false; g.body.hp = 100; g.session.ready(); g.audioSys.music('stalk', true);\n  }\n  endRound() {\n    const g = this.g; if (!g.round) return;\n    for (const s of [g.life, g.round]) { s.dispose?.(g); g.systems = g.systems.filter((x) => x !== s); }\n    for (const p of g.round.players) if (p.view) p.view.dispose?.(); g.soldierSys.clear(); g.vehSys.reset();\n    for (const c of g.round.cases) c.obj?.object?.removeFromParent(); g.round.truck?.object?.removeFromParent();\n    g.round = null; g.life = null; g.session = null; g.ended = false; g.noFever = false; g.carryPenalty = undefined; g.hudExtra = null; g.cutscene = false; g.ctx.engine.timeScale = 1; this.toTitle();\n  }\n  // ---- sleeping, rail, collapse, death ----\"\"\")\nopen(p,'w').write(s)\n# roundend screen\np='src/ui/screens.js'\ns=open(p).read()\ns=s.replace(\"  S.touch = () => ({ id: 'touch', noItems: true });\",\"\"\"  S.roundend = (g, res) => ({\n    id: 'roundend', dim: true, top: 212, rowH: 18, noBack: true, hints: [['confirm', 'SELECT']],\n    draw: (g, hud, ui, { W, H }) => {\n      hud.rect(0, 0, W, H, 'ink'); centered(hud, 'CASH RUN: THE COUNT', 20, { scale: 2, color: 'orange' });\n      const flat = res.standings.flatMap((a, place) => a.map((id) => [place + 1, id])); flat.forEach(([place, id], i) => { const p = g.round.players.find((q) => q.id === id); const y = 54 + i * 24; hud.rect(60, y, 10, 14, parseInt(p.color.slice(1), 16)); hud.text(80, y + 2, `${place}. ${p.name}`, { scale: 2, color: place === 1 ? 'sand' : 'white' }); hud.text(210, y + 2, `${p.stones} STONES`, { scale: 2, color: 'orange' }); hud.text(330, y + 5, `DOWNS ${p.downs} REVIVES ${p.revives} KILLS ${p.kills}`, { color: 'mist' }); });\n      res.awards.forEach((a, i) => hud.text(60, 156 + i * 11, `${a.title.toUpperCase()}: ${g.round.players.find((q) => q.id === a.id).name} (${a.detail})`, { color: 'lime' }));\n    },\n    items: () => [{ label: 'Again', run: (g) => { g.flow.endRound(); g.ui.closeAll(); g.flow.startRound(); } }, { label: 'Title', run: (g) => g.flow.endRound() }],\n  });\n  S.touch = () => ({ id: 'touch', noItems: true });\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > scratch/t19.mjs <<'EOF'\nimport { boot } from '../tests/lib/boot.mjs';\nconst { e, game } = await boot(); e.step(5);\ngame.flow.startRound(); e.step(30); console.log('round', game.mode, JSON.stringify(game.state().round), e.errors.slice(0, 3));\ngame.session.tick; e.step(60 * 5); console.log('t', JSON.stringify(game.state().round), game.round.clockMs(), e.errors.slice(0, 3));\ne.step(60 * 100); console.log('after 100s', JSON.stringify(game.state().round), e.errors.slice(0, 3));\ne.step(60 * 270); console.log('after 6 min', JSON.stringify(game.state().round), game.state().screen, game.life.finished, e.errors.slice(0, 3));\nEOF\ntimeout 280 node scratch/t19.mjs 2>&1 | grep -v \"^    at\" | tail -8"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10967,"cache_read_input_tokens":5220