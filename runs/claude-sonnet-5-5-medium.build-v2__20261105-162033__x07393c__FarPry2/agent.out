0.2), T('sine', 200, 120, 0.06, 0.15)), step_water: N(2200, 0.2, 0.2, { attack: 0.02 }),\n  engine_idle: mix(T('saw', 60, 62, 0.4, 0.3), T('square', 120, 124, 0.4, 0.1, { duty: 0.125 })), gravel: N(900, 0.3, 0.12), brakes: N(4500, 0.5, 0.2, { vibrato: { depth: 6, rate: 40 } }), door: mix(N(1500, 0.08, 0.3), T('sine', 140, 90, 0.1, 0.3)), horn: mix(T('square', 330, 330, 0.5, 0.3), T('square', 415, 415, 0.5, 0.25)),\n  starter: mix(T('saw', 70, 130, 0.6, 0.3, { vibrato: { depth: 3, rate: 18 } }), N(1800, 0.5, 0.15)), cough: mix(T('saw', 70, 40, 0.3, 0.3), N(900, 0.25, 0.2)), wrench: mix(T('square', 900, 700, 0.03, 0.25, { duty: 0.125 }), T('square', 900, 700, 0.03, 0.25, { delay: 0.12, duty: 0.125 })), spark: N(7000, 0.1, 0.2),\n  train_clack: mix(T('square', 300, 200, 0.04, 0.3), T('square', 300, 200, 0.04, 0.25, { delay: 0.18 }), T('square', 300, 200, 0.04, 0.3, { delay: 0.5 }), T('square', 300, 200, 0.04, 0.25, { delay: 0.68 })), train_whistle: mix(T('sine', 520, 520, 1.4, 0.35, { attack: 0.1 }), T('sine', 660, 640, 1.4, 0.3, { attack: 0.1 })),\n  thunder: mix(N(300, 2.2, 0.6, { attack: 0.1 }), T('sine', 45, 28, 2.4, 0.6)), rain: N(5000, 1, 0.12), stinger_gunfire: mix(gun(6000, true, 1500, 0.4, true), gun(6000, true, 1500, 0.3, true)),\n  death_0: mix(T('saw', 200, 70, 0.5, 0.3, { vibrato: { depth: 2, rate: 10 } }), N(800, 0.3, 0.15)), death_1: mix(T('saw', 260, 90, 0.5, 0.3), N(1100, 0.3, 0.15)), death_2: mix(T('saw', 160, 60, 0.6, 0.3), N(700, 0.3, 0.15)), death_player: mix(T('sine', 90, 30, 2, 0.6), N(300, 1.5, 0.2)),\n  win_chime: T('triangle', 520, 780, 0.8, 0.3, { arp: [0, 4, 7, 12], arpRate: 0.1 }), lose_chime: T('triangle', 300, 150, 0.9, 0.3, { arp: [0, -3, -7], arpRate: 0.15 }), bank: T('triangle', 700, 1000, 0.5, 0.3, { arp: [0, 7, 12], arpRate: 0.07 }), countdown: T('square', 880, 880, 0.12, 0.25, { duty: 0.25 }),\n  charge_beep: T('square', 2000, 2000, 0.03, 0.2), chirp_a: T('triangle', 3000, 3600, 0.08, 0.08, { arp: [0, 5, 3], arpRate: 0.025, vibrato: { depth: 1, rate: 40 } }), chirp_b: T('sine', 4200, 3800, 0.1, 0.06, { vibrato: { depth: 2, rate: 30 } }), cricket: T('square', 4400, 4400, 0.18, 0.04, { duty: 0.125, vibrato: { depth: 0.3, rate: 60 } }), gust: N(900, 1.4, 0.12, { attack: 0.6 }), thud: mix(T('sine', 100, 40, 0.2, 0.5), N(500, 0.1, 0.2)),\n};\nexport const LOOPS = { wind: N(500, 1.2, 0.5, { attack: 0.6, sustain: 1, vibrato: { depth: 2, rate: 0.3 } }), fire: N(700, 1.0, 0.6, { attack: 0.3, sustain: 1 }), engine: T('saw', 55, 57, 1, 0.5, { sustain: 1, vibrato: { depth: 0.3, rate: 12 } }), rain: N(5200, 1.4, 0.5, { attack: 0.3, sustain: 1 }), flame: N(800, 0.5, 0.5, { sustain: 1 }) };\nEOF\ncat > src/audio/music.js <<'EOF'\n// Songs as data: plucked pentatonic lines, thumb-piano timbres, noise hand drums, low drones. Original melodies.\nconst piano = { wave: 'triangle', decay: 0.35, volume: 0.16 };\nconst pluck = { wave: 'triangle', decay: 0.25, volume: 0.14 };\nconst drone = { wave: 'sine', decay: 1.4, volume: 0.12 };\nconst saw = { wave: 'saw', decay: 0.22, volume: 0.07 };\nconst drum = { wave: 'noise', decay: 0.07, volume: 0.1 };\nconst bell = { wave: 'sine', decay: 0.7, volume: 0.1 };\nconst rep = (s, n) => Array(n).fill(s).join(' ');\nexport const SONGS = {\n  title: { bpm: 66, tracks: { lead: piano, bass: drone, bell }, patterns: {\n    a: { lead: 'A4 . C5 . E5 . . G4 . . A4 . D5 . . .', bass: 'A2 . . . . . . . . . . . . . . .', bell: '. . . . . . E5 . . . . . . . . .' },\n    b: { lead: 'G4 . A4 . C5 . . E5 . . D5 . A4 . . .', bass: 'D2 . . . . . . . . . . . . . . .', bell: '. . . . . . . . A5 . . . . . . .' },\n  }, order: ['a', 'b', 'a', 'b'] },\n  day: { bpm: 72, tracks: { lead: pluck, bass: drone }, patterns: {\n    a: { lead: 'E4 . . A4 . . C5 . . . G4 . . . . .', bass: 'A2 . . . . . . . . . . . . . . .' },\n    b: { lead: 'D4 . . G4 . . A4 . . . E4 . . . . .', bass: 'G2 . . . . . . . . . . . . . . .' },\n    c: { lead: '. . . . C5 . . . A4 . . . . . . .', bass: 'E2 . . . . . . . . . . . . . . .' },\n  }, order: ['a', 'b', 'a', 'c'] },\n  night: { bpm: 50, tracks: { lead: { wave: 'sine', decay: 0.9, volume: 0.08 }, bass: drone }, patterns: {\n    a: { lead: '. . . . . . . . A4 . . . . . . . . . . . . . . . . . . . E4 . . .', bass: 'A1 . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .' },\n  }, order: ['a'] },\n  stalk: { bpm: 96, tracks: { lead: pluck, bass: { wave: 'square', duty: 0.125, decay: 0.15, volume: 0.07 }, drum }, patterns: {\n    a: { lead: '. . . . A4 . . . . . C5 . . . . .', bass: 'A2 . . A2 . . A2 . A2 . . A2 . . . .', drum: '. . . . . . . . . . . . . . . .' },\n    b: { lead: '. . G4 . . . . . D5 . . . . . E5 .', bass: 'D2 . . D2 . . D2 . D2 . . D2 . . . .', drum: '. . . . . . . . . . . . . . C8 C8' },\n  }, order: ['a', 'a', 'b'] },\n  fight: { bpm: 132, tracks: { lead: pluck, bass: saw, drum }, patterns: {\n    a: { lead: 'A4 . C5 A4 . E5 . D5 A4 . C5 . G4 . A4 .', bass: 'A1 A1 . A1 A1 . A1 . A1 A1 . A1 A1 . A1 .', drum: 'C6 . C8 C8 C6 . C8 . C6 . C8 C8 C6 C6 C8 .' },\n    b: { lead: 'G4 . A4 C5 . D5 . E5 D5 . C5 . A4 . G4 .', bass: 'D2 D2 . D2 D2 . D2 . D2 D2 . D2 D2 . D2 .', drum: 'C6 . C8 C8 C6 . C8 C6 C6 . C8 C8 C6 C6 C6 C6' },\n  }, order: ['a', 'a', 'b', 'a'] },\n  fever: { bpm: 62, tracks: { lead: { wave: 'triangle', decay: 0.4, volume: 0.15, vibrato: { depth: 0.8, rate: 5 } }, bass: { wave: 'sine', decay: 1.4, volume: 0.12 }, bell }, patterns: {\n    a: { lead: 'E4 . . A4 . . C5 . . . G4 . . . . .', bass: 'A2 . . . . . . . . . . . . . . .', bell: '. . . . . . . . . . . . Gb5 . . .' },\n  }, order: ['a'] },\n  end: { bpm: 60, tracks: { lead: { wave: 'triangle', decay: 0.9, volume: 0.15 } }, patterns: { a: { lead: 'A4 . . . C5 . . . E5 . . . D5 . . . C5 . . . A4 . . . . . . . . . . .' } }, order: ['a'] },\n};\nexport const SONG_FOR = { title: 'title', day: 'day', night: 'night', stalk: 'stalk', fight: 'fight', fever: 'fever', end: 'end' };\nEOF\ncat > scratch/t12.mjs <<'EOF'\nimport { renderSound, parseSong } from '../pixel-engine.js';\nimport { SFX, LOOPS } from '../src/audio/sfx.js';\nimport { SONGS } from '../src/audio/music.js';\nlet bad = 0, n = 0;\nfor (const [k, d] of Object.entries({ ...SFX, ...LOOPS })) { try { const s = renderSound(d); n++; let peak = 0; for (const v of s) peak = Math.max(peak, Math.abs(v)); if (peak < 0.01) { console.log('SILENT', k); bad++; } } catch (e) { console.log('ERR', k, e.message); bad++; } }\nfor (const [k, s] of Object.entries(SONGS)) { try { parseSong(s); } catch (e) { console.log('SONG ERR', k, String(e.message).slice(0, 150)); bad++; } }\nconsole.log(n, 'sounds', bad, 'bad');\nEOF\ntimeout 100 node scratch/t12.mjs 2>&1 | tail"}}}
