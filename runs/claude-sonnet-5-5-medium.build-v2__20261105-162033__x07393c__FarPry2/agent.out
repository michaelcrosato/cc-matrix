'#.#', '#.#', '#.#', '.#.'); def('P', '##.', '#.#', '##.', '#..', '#..');\ndef('Q', '.#.', '#.#', '#.#', '###', '.##'); def('R', '##.', '#.#', '##.', '#.#', '#.#'); def('S', '.##', '#..', '.#.', '..#', '##.'); def('T', '###', '.#.', '.#.', '.#.', '.#.');\ndef('U', '#.#', '#.#', '#.#', '#.#', '###'); def('V', '#.#', '#.#', '#.#', '#.#', '.#.'); def('W', '#.#', '#.#', '###', '###', '#.#'); def('X', '#.#', '#.#', '.#.', '#.#', '#.#');\ndef('Y', '#.#', '#.#', '.#.', '.#.', '.#.'); def('Z', '###', '..#', '.#.', '#..', '###');\ndef('0', '###', '#.#', '#.#', '#.#', '###'); def('1', '.#.', '##.', '.#.', '.#.', '###'); def('2', '##.', '..#', '.#.', '#..', '###'); def('3', '##.', '..#', '.#.', '..#', '##.');\ndef('4', '#.#', '#.#', '###', '..#', '..#'); def('5', '###', '#..', '##.', '..#', '##.'); def('6', '.##', '#..', '###', '#.#', '###'); def('7', '###', '..#', '.#.', '.#.', '.#.');\ndef('8', '###', '#.#', '###', '#.#', '###'); def('9', '###', '#.#', '###', '..#', '##.');\ndef('.', '...', '...', '...', '...', '.#.'); def(',', '...', '...', '...', '.#.', '#..'); def(':', '...', '.#.', '...', '.#.', '...'); def('-', '...', '...', '###', '...', '...');\ndef('!', '.#.', '.#.', '.#.', '...', '.#.'); def('?', '##.', '..#', '.#.', '...', '.#.'); def(\"'\", '.#.', '.#.', '...', '...', '...'); def('/', '..#', '..#', '.#.', '#..', '#..'); def(' ', '...', '...', '...', '...', '...');\nexport const textWidth = (s) => s.length * 4 - 1;\nexport function drawText(put, x, y, text, color) {\n  let cx = x;\n  for (const ch of String(text).toUpperCase()) { const g = GLYPHS[ch] || GLYPHS[' ']; for (let r = 0; r < 5; r++) for (let c = 0; c < 3; c++) if (g[r][c] === '#') put(cx + c, y + r, color); cx += 4; }\n  return cx - x;\n}\nexport function wrap(text, cols) { const out = []; let cur = ''; for (const w of String(text).toUpperCase().split(' ')) { if ((cur + ' ' + w).trim().length > cols && cur) { out.push(cur); cur = w; } else cur = (cur + ' ' + w).trim(); } if (cur) out.push(cur); return out; }\nEOF\nsed -i '/^const G = {$/,/^};$/d' src/ui/pixfont.js\nhead -5 src/ui/pixfont.js; node -e \"import('./src/ui/pixfont.js').then(m=>console.log(m.textWidth('HI'), m.wrap('A map is a promise made by someone',12)))\""},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9563,"cache_read_input_tokens":420266,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9563},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"feff64bd-df6d-45b2-b337-83604d3a2d73","uuid":"db3c4d96-4817-4896-aed3-714b61ef832a","timestamp":"2026-11-05T23:55:26.614Z","request_id":"req_011CgkgcEcpPFnx9XrSPPyDK","wire_tool_inputs":{"toolu_01PaFUHovz3FvtcMrkP8C23P":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162033__x07393c/work/FarPry2*/ && python3 - <<'EOF'\np='src/art/guns.js'\ns=open(p).read()\ns=s.replace(\"  tracker: G('vm-tracker', 'Tracker with a beeping LED', [\",\"  tracker: G('vm-tracker', 'Tracker with a beeping LED', [piv('Mag', [{ box: [0.06, 0.06, 0.03], at: [0, 0, 0], c: 'led', glow: true }], [0, 0.24, 0.2]), \")\ns=s.replace(\"{ box: [0.02, 0.2, 0.02], at: [0.06, 0.38, 0.12], c: 'metal' }, ...hands([0, -0.04, 0.1], [0.0, -0.14, 0.1]).slice(0, 1)]),\",\"{ box: [0.04, 0.2, 0.04], at: [0.06, 0.38, 0.12], c: 'metal' }, ...hands([0, -0.04, 0.1], [0.0, -0.14, 0.1]).slice(0, 1)], { led: 'lime' }),\")\nopen(p,'w').write(s)\nEOF\ncat > src/ui/pixfont.js <<'EOF'\n// A 3x5 pixel font for the paper map (drawn into a DataTexture, no DOM). Unknown characters draw as a blank.\nconst G = {\n  A: '.#.#.####.##.#', B: '###.#####.#####.#.#.#'.slice(0, 15), C: '.####..#..#...##', D: '##.#.##.##.#.##.',\n};\nconst rows = (s) => s.split('/');\nconst GLYPHS = {};\nconst def = (c