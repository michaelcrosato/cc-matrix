{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cgkh1SdXp6uExgpEKSCVK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Mg2gcaULWJahMv9mCLoTmE","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162033__x07393c/work/FarPry2*/ && cat > src/content/missions.js <<'EOF'\n// Missions are data: ordered steps, plus small `run` closures for scripted beats. g is the Game.\n// Step types: scene goto leave use report destroy kill clear steal deliver hold timer choice wait script ignite\nconst site = (g, id) => g.sitesSys.find(id);\nconst spawnSquad = (g, siteId, faction, n, r = 14, role = 'rifle') => { const s = site(g, siteId); for (let i = 0; i < n; i++) { const a = g.ctx.random.range(0, 6.283), d = g.ctx.random.range(6, r); g.spawnSoldier({ faction, role: i === 1 ? 'mg' : role, at: [s.x + Math.cos(a) * d, s.z + Math.sin(a) * d], yaw: a + Math.PI, site: s }); } };\nconst reward = (g, n) => { const v = Math.round(n * g.TUN.stonesReward); g.story.stones += v; g.story.earned += v; return v; };\n\nexport const MISSIONS = {\n  m0: { id: 'm0', title: 'The Goods Line', auto: true, pay: 0, hour: 17.2, skippable: true,\n    steps: [\n      { do: 'script', run: (g) => { g.train.startRide(-420); g.mission.ride = true; g.cutscene = true; g.mode = 'scene'; g.player.seated = true; g.player.ctrl.body.setEnabled(false); g.hudHidden = false; g.camState.enabled = true; } },\n      { do: 'scene', seq: 'm0.bakr', text: 'RIDE THE FLATCAR', until: 'RAISE THE MAP' },\n      { do: 'wait', text: 'RAISE THE MAP', until: (g) => g.mapSys.target || g.story.flags.mapSeen, onStart: (g) => { g.mission.mapPrompt = true; }, onDone: (g) => { g.story.flags.mapSeen = true; g.mission.mapPrompt = false; } },\n      { do: 'timer', secs: 3 },\n      { do: 'scene', seq: 'm0.map', text: 'READ THE MARGIN' },\n      { do: 'script', run: (g) => { g.mapSys.raise(false); g.noFever = false; g.body.startFever('THE FEVER.'); g.ctx.engine.screen.cover('fade'); } },\n      { do: 'scene', seq: 'm0.fever' },\n      { do: 'script', run: (g) => { g.train.stop(); g.train.park(g.train.sOf(0, 70)); g.player.seated = false; g.player.ctrl.body.setEnabled(true); g.cutscene = false; g.mode = 'play'; g.mission.ride = false; const c = site(g, 'mile-forty'); g.player.teleport(c.x - 24, c.z + 2, 1.57); g.world.hour = 7.5; g.ctx.engine.screen.reveal('fade'); g.body.fever.active = false; g.noFever = true; g.body.hp = 70; } },\n    ],\n    onDone: (g) => { g.story.met.mags = false; g.begin?.('m1'); } },\n  m1: { id: 'm1', title: 'Mercy Run', giver: 'odile', pay: 5, hour: 8, auto: true, contract: null,\n    onStart: (g) => { const w = g.weapons; w.tablets = 1; w.syrettes = 3; w.give('tractor', 45); w.slotGun.main = 'tractor'; g.noFever = true; g.mission.veh = g.spawnVehicle('pickup', [site(g, 'mile-forty').x - 10, site(g, 'mile-forty').z + 18], 1.5, { tag: 'mercy' }); g.mission.crate = true; g.waypointTo(-260, 240); },\n    steps: [\n      { do: 'scene', seq: 'm1.wake', focus: 'odile', text: 'LISTEN TO SISTER ODILE' },\n      { do: 'script', run: (g) => { g.noFever = false; g.body.fever.t = g.body.fever.next - 3; g.say('THE SHAKING IS COMING. TABLET.', 'player', 3); } },\n      { do: 'wait', text: 'TAKE A TABLET', until: (g) => g.story.flags.tabletTaken, onStart: (g) => { g.mission.off = g.events.on('healed', (k) => { if (k === 'tablet') g.story.flags.tabletTaken = true; }); } },\n      { do: 'script', run: (g) => { g.mission.off?.(); g.noFever = true; g.body.fever.t = 0; g.body.fever.next = g.body.nextInterval(); } },\n      { do: 'goto', site: 'three-wells', r: 36, text: 'DRIVE THE MEDICINE TO THREE WELLS', onNear: (g) => { g.say('DRIVE WEST. DO NOT STOP.', 'odile', 2); } },\n      { do: 'scene', seq: 'm1.deliver', text: 'DELIVER THE CRATE', focus: null },\n      { do: 'script', run: (g) => { g.mission.crate = false; g.waypointTo(site(g, 'mile-forty').x, site(g, 'mile-forty').z); const p2 = g.sitesSys.sites.find((s) => s.id === 'p2'); if (p2) g.sitesSys.spawnSite(p2); g.weapons.scriptJam = g.weapons.shots + 5; } },\n      { do: 'goto', at: [-200, 30], r: 90, text: 'GET BACK PAST THE CHECKPOINT', onNear: (g) => { const v = g.mission.veh; if (v && !v.dead()) { v.damage(v.hp + 1, 'bullet'); g.say('THE TRUCK IS HIT.', 'player', 2); g.dialogue.play('m1.stall'); } } },\n      { do: 'wait', text: 'REPAIR THE ENGINE', until: (g) => !g.mission.veh || !g.mission.veh.dead(), onStart: (g) => { g.body.hp = 50; } },\n      { do: 'wait', text: 'USE A SYRETTE', until: (g) => g.body.hp >= 90 || g.story.flags.syretteUsed, onStart: (g) => { g.body.hp = 35; g.mission.off = g.events.on('healed', (k) => { if (k === 'syrette') g.story.flags.syretteUsed = true; }); } },\n      { do: 'goto', site: 'mile-forty', r: 50, text: 'DRIVE BACK TO MILE FORTY' },\n      { do: 'report', to: 'odile', seq: 'm1.report', text: 'REPORT TO SISTER ODILE' },\n    ],\n    onDone: (g) => { g.mission.off?.(); g.weapons.tablets += 3; g.story.met.mags = true; g.story.flags.m1 = true; g.story.mercyRuns++; g.story.contract = null; g.noFever = false; g.body.fever.t = 0; } },\n  m2: { id: 'm2', title: 'A Cage at the Post', giver: 'tibor', requires: ['m1'], pay: 8, brief: 'm2.tibor',\n    onStart: (g) => { g.mission.post = site(g, 'ranger-post'); g.waypointTo(40, -170); },\n    steps: [\n      { do: 'goto', site: 'ranger-post', r: 130, text: 'REACH THE RANGER POST' },\n      { do: 'use', kind: 'cage', text: 'OPEN THE CAGE (HOLD)' },\n      { do: 'script', run: (g) => { g.story.met.ines = true; g.buddies.join('ines'); g.dialogue.play('m2.cage', { focus: 'ines' }); } },\n      { do: 'leave', site: 'ranger-post', r: 90, text: 'GET OUT WITH INES' },\n      { do: 'script', run: (g) => { g.buddies.dismissAll(); } },\n      { do: 'report', to: 'tibor', seq: 'm2.report', text: 'REPORT TO TIBOR' },\n    ],\n    onDone: (g) => { const s = site(g, 'ranger-post'); s.safe = true; g.story.safeSites.push('ranger-post'); g.story.met.ines = true; g.story.met.dov = true; g.story.flags.m2 = true; } },\n  m3: { id: 'm3', title: 'Fuel for the Peace', giver: 'vance', requires: ['m2'], pay: 15, brief: 'm3.vance', faction: 'concord', wind: { dir: [0.97, -0.2], speed: 5 },\n    onStart: (g) => { g.weapons.give('flare', 100); g.weapons.addAmmo('flare', 8); g.waypointTo(430, -60); g.mission.altOffered = false; },\n    steps: [\n      { do: 'goto', site: 'east-siding', r: 150, text: 'REACH EAST SIDING', onNear: (g) => { g.say('LIGHT THE GRASS UPWIND. LET IT CARRY.', 'vance', 3); } },\n      { do: 'destroy', tag: 'fuel-tank', n: 3, text: 'BURN THE THREE TANKS' },\n      { do: 'leave', site: 'east-siding', r: 220, text: 'GET OUT' },\n      { do: 'report', to: 'vance', seq: 'm3.done', text: 'REPORT TO VANCE' },\n    ],\n    alt: { buddy: 'ines', call: 'm3.alt', bonus: 5, steps: [{ do: 'steal', tag: 'tanker', text: 'TAKE THE TANKER AT P3' }], setup: (g) => { const p3 = g.sitesSys.sites.find((s) => s.id === 'p3'); g.spawnVehicle('tanker', [p3.x + 8, p3.z + 6], 0.5, { tag: 'tanker' }); g.waypointTo(p3.x, p3.z); } },\n    onDone: (g) => { g.fire.burnStrip('A'); g.story.ledger.moved += 12; g.story.ledger.killed += 6; g.story.flags.m3 = true; g.story.contract = null; } },\n  m6: { id: 'm6', title: 'The Long Field', giver: 'ansa', requires: ['m3'], pay: 25, brief: 'm3.ansa', faction: 'harvest', hour: 21.8, wind: { dir: [-0.9, 0.2], speed: 5 },\n    onStart: (g) => { g.waypointTo(-260, -300); g.mission.buddy = g.buddies.best() || 'pell'; if (g.mission.buddy === 'pell') g.mission.pell = true; else g.buddies.join(g.mission.buddy); g.weapons.throwables.molotov = Math.max(g.weapons.throwables.molotov, 2); g.weapons.addAmmo('flare', 8); },\n    steps: [\n      { do: 'goto', site: 'long-field', r: 120, text: 'REACH THE LONG FIELD' },\n      { do: 'burn', site: 'long-field', pct: 0.3, text: 'BURN THE CROP' },\n      { do: 'script', run: (g) => { g.say('THE WIND IS TURNING.', 'player', 3); g.world.wind.dir = [0.9, -0.2]; g.world.wind.speed = 7; g.mission.turned = true; const b = g.buddies.list[0]; if (b) { b.hp = 0; b.burning = true; b.burnT = 40; b.alive = false; g.combat.actors = g.combat.actors.filter((a) => a !== b); b.onDeath(); g.dialogue.play('m6.turn'); } else g.mission.pellDown = true; g.mission.forced = true; } },\n      { do: 'wait', text: 'SYRETTE OR FINISH IT', until: (g) => !g.buddies.list.some((b) => b.state === 'down') && g.mission.forced, onDone: (g) => {} },\n      { do: 'destroy', tag: 'ammo', n: 1, text: 'BLOW THE AMMO BUNKER' },\n      { do: 'leave', site: 'long-field', r: 160, text: 'GET OUT OF THE FIELD' },\n      { do: 'report', to: 'ansa', seq: 'm6.done', text: 'REPORT TO MOTHER ANSA' },\n    ],\n    onDone: (g) => { g.fire.burnStrip('B'); g.story.ledger.moved += 38; g.story.ledger.killed += 8; g.story.flags.m6 = true; g.buddies.dismissAll(); g.story.contract = null; } },\n  m7: { id: 'm7', title: 'The Cut', giver: 'harrow', requires: ['m6'], pay: 20, auto: true, hour: 14, wind: { dir: [0.5, -0.8], speed: 4 },\n    onStart: (g) => { g.waypointTo(150, -300); const c = site(g, 'the-cut'); spawnSquad(g, 'the-cut', 'concord', 6, 30); spawnSquad(g, 'the-cut', 'harvest', 6, 30); for (let i = 0; i < 4; i++) g.fire.ignite(c.x + g.ctx.random.range(-40, 40), c.z + g.ctx.random.range(-40, 40), 5); g.mission.shell = 0; },\n    steps: [\n      { do: 'scene', seq: 'm7.note', text: 'A NOTE AT YOUR SAFEHOUSE' },\n      { do: 'goto', site: 'the-cut', r: 70, text: 'REACH THE CUT THROUGH THE CROSSFIRE' },\n      { do: 'use', kind: 'sluice', text: 'TAKE HARROW\\'S LEDGER AT THE SLUICE HOUSE' },\n      { do: 'scene', seq: 'm7.ledger' },\n      { do: 'leave', site: 'the-cut', r: 190, text: 'GET OUT OF THE CUT' },\n      { do: 'scene', seq: 'm7.done', focus: 'odile' },\n    ],\n    alt: { buddy: 'any', call: 'm7.alt', bonus: 0, steps: [], setup: (g) => { g.mission.fewer = true; } },\n    onDone: (g) => { g.fire.burnStrip('C'); g.story.flags.truceOver = true; g.story.ledger.moved += 140; g.story.ledger.killed += 12; g.story.unlocked = [...new Set([...g.story.unlocked, 'mule', 'tractor', 'weed', 'tube', 'empire'])]; g.story.flags.m7 = true; g.story.act = 3; } },\n  m9: { id: 'm9', title: 'The Surveyor', giver: 'harrow', requires: ['m7'], pay: 0, auto: true, hour: 23, storm: true,\n    onStart: (g) => { g.waypointTo(-130, -520); const o = site(g, 'observatory'); for (let i = 0; i < 5; i++) { const a = i * 1.3; g.spawnSoldier({ faction: i % 2 ? 'concord' : 'harvest', role: 'rifle', at: [o.x + Math.cos(a) * 22, o.z + Math.sin(a) * 22], yaw: a + 3, site: o }); } },\n    steps: [\n      { do: 'goto', site: 'observatory', r: 36, text: 'CLIMB TO THE OBSERVATORY' },\n      { do: 'use', kind: 'harrow', text: 'SIT WITH THE SURVEYOR' },\n      { do: 'scene', seq: 'm9.scene', focus: 'harrow' },\n      { do: 'choice', title: 'HARROW WAITS', options: [{ label: 'Finish the contract', flag: 'shot' }, { label: 'Put the gun away', flag: 'spared' }], text: 'CHOOSE' },\n      { do: 'script', run: (g) => { if (g.story.choices.m9 === 'shot') { g.sfx('shot_m38'); g.story.ledger.killed++; g.dialogue.play('m9.shot', { focus: 'harrow' }); } else g.dialogue.play('m9.spared', { focus: 'harrow' }); g.story.stones += 5; g.story.earned += 5; } },\n      { do: 'timer', secs: 7 },\n      { do: 'choice', title: 'WHO GETS THE SHEET', options: [{ label: 'Walk out alone', flag: 'walk' }, { label: 'Give it to the column', flag: 'give' }], text: 'CHOOSE', key: 'sheet' },\n    ],\n    onDone: (g) => { g.story.flags.m9 = true; g.setWeather?.('clear'); } },\n  end: { id: 'end', title: 'The Pass', auto: true, pay: 0, hour: 5.4,\n    onStart: (g) => { g.waypointTo(-590, -430); const p = site(g, 'the-pass'); spawnSquad(g, 'the-pass', 'concord', 5, 40); spawnSquad(g, 'the-pass', 'harvest', 5, 40); g.mission.give = g.story.choices.sheet === 'give'; },\n    steps: [\n      { do: 'goto', site: 'the-pass', r: 60, text: 'WALK TO THE PASS' },\n      { do: 'hold', site: 'the-pass', r: 70, secs: 40, text: 'HOLD THE PASS BEHIND THE COLUMN', when: (g) => g.mission.give },\n      { do: 'script', run: (g) => { g.endBuddies(); } },\n      { do: 'ignite', site: 'the-pass', r: 60, text: 'LIGHT THE LAST GRASS' },\n      { do: 'script', run: (g) => { g.finishGame(); } },\n    ],\n    onDone: () => {} },\n};\n// Mercy Runs: three variants of one idea (carry a crate within five minutes, paid in tablets)\nexport const MERCY = [\n  { id: 'mr2', title: 'Mercy Run: Salt Road', requires: ['m1'], to: [300, 390], toName: 'Checkpoint P6', secs: 300 },\n  { id: 'mr3', title: 'Mercy Run: The Cut Spur', requires: ['m2'], to: [150, -260], toName: 'Cut Spur', secs: 300 },\n].map((d) => ({ id: d.id, title: d.title, giver: 'odile', requires: d.requires, pay: 4, repeatable: false, mercy: true, brief: 'mercy.brief',\n  onStart: (g) => { g.waypointTo(d.to[0], d.to[1]); g.mission.veh = g.spawnVehicle('pickup', [site(g, 'mile-forty').x - 10, site(g, 'mile-forty').z + 18], 1.5); g.mission.crate = true; },\n  steps: [{ do: 'deliver', at: d.to, r: 30, secs: d.secs, text: `CARRY THE CRATE TO ${d.toName.toUpperCase()} IN FIVE MINUTES` }, { do: 'goto', site: 'mile-forty', r: 60, text: 'GET BACK TO MILE FORTY' }],\n  onDone: (g) => { g.weapons.tablets += 4; g.story.mercyRuns++; g.mission.crate = false; } }));\nfor (const m of MERCY) MISSIONS[m.id] = m;\nEOF\npython3 - <<'EOF'\n# add the mercy brief sequence to dialogue\np='src/content/dialogue.js'\ns=open(p).read()\ns=s.replace(\"export const SEQ = {\",\"export const SEQ = {\\n  'mercy.brief': [['odile', 'Another crate. Another five minutes. I count them. You may count them too.'], ['odile', 'Four tablets, if you arrive. Nothing, if you do not. I will say nothing, which is worse.']],\")\nopen(p,'w').write(s)\nEOF\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4436,"cache_read_input_tokens":469705,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4436},"output_tokens":40,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"feff64bd-df6d-45b2-b337-83604d3a2d73","uuid":"f9675f54-a32c-4bf2-8a5a-83b24d51c86c","timestamp":"2026-11-06T00:00:44.126Z","request_id":"req_011Cgkh1SNQ2ywTS72yukr5m","wire_tool_inputs":{"toolu_01Mg2gcaULWJahMv9mCLoTmE":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162033__x07393c/work/FarPry2*/ && cat > src/content/missions.js <<'EOF'\n// Missions are data: ordered steps, plus small `run` closures for scripted beats. g is the Game.\n// Step types: scene goto leave use report destroy kill clear steal deliver hold timer choice wait script ignite\nconst site = (g, id) => g.sitesSys.find(id);\nconst spawnSquad = (g, siteId, faction, n, r = 14, role = 'rifle') => { const s = site(g, siteId); for (let i = 0; i < n; i++) { const a = g.ctx.random.range(0, 6.283), d = g.ctx.random.range(6, r); g.spawnSoldier({ faction, role: i === 1 ? 'mg' : role, at: [s.x + Math.cos(a) * d, s.z + Math.sin(a) * d], yaw: a + Math.PI, site: s }); } };\nconst reward = (g, n) => { const v = Math.round(n * g.TUN.stonesReward); g.story.stones += v; g.story.earned += v; return v; };\n\nexport const MISSIONS = {\n  m0: { id: 'm0', title: 'The Goods Line', auto: true, pay: 0, hour: 17.2, skippable: true,\n    steps: [\n      { do: 'script', run: (g) => { g.train.startRide(-420); g.mission.ride = true; g.cutscene = true; g.mode = 'scene'; g.player.seated = true; g.player.ctrl.body.setEnabled(false); g.hudHidden = false; g.camState.enabled = true; } },\n      { do: 'scene', seq: 'm0.bakr', text: 'RIDE THE FLATCAR', until: 'RAISE THE MAP' },\n      { do: 'wait', text: 'RAISE THE MAP', until: (g) => g.mapSys.target || g.story.flags.mapSeen, onStart: (g) => { g.mission.mapPrompt = true; }, onDone: (g) => { g.story.flags.mapSeen = true; g.mission.mapPrompt = false; } },\n      { do: 'timer', secs: 3 },\n      { do: 'scene', seq: 'm0.map', text: 'READ THE MARGIN' },\n      { do: 'script', run: (g) => { g.mapSys.raise(false); g.noFever = false; g.body.startFever('THE FEVER.'); g.ctx.engine.screen.cover('fade'); } },\n      { do: 'scene', seq: 'm0.fever' },\n      { do: 'script', run: (g) => { g.train.stop(); g.train.park(g.train.sOf(0, 70)); g.player.seated = false; g.player.ctrl.body.setEnabled(true); g.cutscene = false; g.mode = 'play'; g.mission.ride = false; const c = site(g, 'mile-forty'); g.player.teleport(c.x - 24, c.z + 2, 1.57); g.world.hour = 7.5; g.ctx.engine.screen.reveal('fade'); g.body.fever.active = false; g.noFever = true; g.body.hp = 70; } },\n    ],\n    onDone: (g) => { g.story.met.mags = false; g.begin?.('m1'); } },\n  m1: { id: 'm1', title: 'Mercy Run', giver: 'odile', pay: 5, hour: 8, auto: true, contract: null,\n    onStart: (g) => { const w = g.weapons; w.tablets = 1; w.syrettes = 3; w.give('tractor', 45); w.slotGun.main = 'tractor'; g.noFever = true; g.mission.veh = g.spawnVehicle('pickup', [site(g, 'mile-forty').x - 10, site(g, 'mile-forty').z + 18], 1.5, { tag: 'mercy' }); g.mission.crate = true; g.waypointTo(-260, 240); },\n    steps: [\n      { do: 'scene', seq: 'm1.wake', focus: 'odile', text: 'LISTEN TO SISTER ODILE' },\n      { do: 'script', run: (g) => { g.noFever = false; g.body.fever.t = g.body.fever.next - 3; g.say('THE SHAKING IS COMING. TABLET.', 'player', 3); } },\n      { do: 'wait', text: 'TAKE A TABLET', until: (g) => g.story.flags.tabletTaken, onStart: (g) => { g.mission.off = g.events.on('healed', (k) => { if (k === 'tablet') g.story.flags.tabletTaken = true; }); } },\n      { do: 'script', run: (g) => { g.mission.off?.(); g.noFever = true; g.body.fever.t = 0; g.body.fever.next = g.body.nextInterval(); } },\n      { do: 'goto', site: 'three-wells', r: 36, text: 'DRIVE THE MEDICINE TO THREE WELLS', onNear: (g) => { g.say('DRIVE WEST. DO NOT STOP.', 'odile', 2); } },\n      { do: 'scene', seq: 'm1.deliver', text: 'DELIVER THE CRATE', focus: null },\n      { do: 'script', run: (g) => { g.mission.crate = false; g.waypointTo(site(g, 'mile-forty').x, site(g, 'mile-forty').z); const p2 = g.sitesSys.sites.find((s) => s.id === 'p2'); if (p2) g.sitesSys.spawnSite(p2); g.weapons.scriptJam = g.weapons.shots + 5; } },\n      { do: 'goto', at: [-200, 30], r: 90, text: 'GET BACK PAST THE CHECKPOINT', onNear: (g) => { const v = g.mission.veh; if (v && !v.dead()) { v.damage(v.hp + 1, 'bullet'); g.say('THE TRUCK IS HIT.', 'player', 2); g.dialogue.play('m1.stall'); } } },\n      { do: 'wait', text: 'REPAIR THE ENGINE', until: (g) => !g.mission.veh || !g.mission.veh.dead(), onStart: (g) => { g.body.hp = 50; } },\n      { do: 'wait', text: 'USE A SYRETTE', until: (g) => g.body.hp >= 90 || g.story.flags.syretteUsed, onStart: (g) => { g.body.hp = 35; g.mission.off = g.events.on('healed', (k) => { if (k === 'syrette') g.story.flags.syretteUsed = true; }); } },\n      { do: 'goto', site: 'mile-forty', r: 50, text: 'DRIVE BACK TO MILE FORTY' },\n      { do: 'report', to: 'odile', seq: 'm1.report', text: 'REPORT TO SISTER ODILE' },\n    ],\n    onDone: (g) => { g.mission.off?.(); g.weapons.tablets += 3; g.story.met.mags = true; g.story.flags.m1 = true; g.story.mercyRuns++; g.story.contract = null; g.noFever = false; g.body.fever.t = 0; } },\n  m2: { id: 'm2', title: 'A Cage at the Post', giver: 'tibor', requires: ['m1'], pay: 8, brief: 'm2.tibor',\n    onStart: (g) => { g.mission.post = site(g, 'ranger-post'); g.waypointTo(40, -170); },\n    steps: [\n      { do: 'goto', site: 'ranger-post', r: 130, text: 'REACH THE RANGER POST' },\n      { do: 'use', kind: 'cage', text: 'OPEN THE CAGE (HOLD)' },\n      { do: 'script', run: (g) => { g.story.met.ines = true; g.buddies.join('ines'); g.dialogue.play('m2.cage', { focus: 'ines' }); } },\n      { do: 'leave', site: 'ranger-post', r: 90, text: 'GET OUT WITH INES' },\n      { do: 'script', run: (g) => { g.buddies.dismissAll(); } },\n      { do: 'report', to: 'tibor', seq: 'm2.report', text: 'REPORT TO TIBOR' },\n    ],\n    onDone: (g) => { const s = site(g, 'ranger-post'); s.safe = true; g.story.safeSites.push('ranger-post'); g.story.met.ines = true; g.story.met.dov = true; g.story.flags.m2 = true; } },\n  m3: { id: 'm3', title: 'Fuel for the Peace', giver: 'vance', requires: ['m2'], pay: 15, brief: 'm3.vance', faction: 'concord', wind: { dir: [0.97, -0.2], speed: 5 },\n    onStart: (g) => { g.weapons.give('flare', 100); g.weapons.addAmmo('flare', 8); g.waypointTo(430, -60); g.mission.altOffered = false; },\n    steps: [\n      { do: 'goto', site: 'east-siding', r: 150, text: 'REACH EAST SIDING', onNear: (g) => { g.say('LIGHT THE GRASS UPWIND. LET IT CARRY.', 'vance', 3); } },\n      { do: 'destroy', tag: 'fuel-tank', n: 3, text: 'BURN THE THREE TANKS' },\n      { do: 'leave', site: 'east-siding', r: 220, text: 'GET OUT' },\n      { do: 'report', to: 'vance', seq: 'm3.done', text: 'REPORT TO VANCE' },\n    ],\n    alt: { buddy: 'ines', call: 'm3.alt', bonus: 5, steps: [{ do: 'steal', tag: 'tanker', text: 'TAKE THE TANKER AT P3' }], setup: (g) => { const p3 = g.sitesSys.sites.find((s) => s.id === 'p3'); g.spawnVehicle('tanker', [p3.x + 8, p3.z + 6], 0.5, { tag: 'tanker' }); g.waypointTo(p3.x, p3.z); } },\n    onDone: (g) => { g.fire.burnStrip('A'); g.story.ledger.moved += 12; g.story.ledger.killed += 6; g.story.flags.m3 = true; g.story.contract = null; } },\n  m6: { id: 'm6', title: 'The Long Field', giver: 'ansa', requires: ['m3'], pay: 25, brief: 'm3.ansa', faction: 'harvest', hour: 21.8, wind: { dir: [-0.9, 0.2], speed: 5 },\n    onStart: (g) => { g.waypointTo(-260, -300); g.mission.buddy = g.buddies.best() || 'pell'; if (g.mission.buddy === 'pell') g.mission.pell = true; else g.buddies.join(g.mission.buddy); g.weapons.throwables.molotov = Math.max(g.weapons.throwables.molotov, 2); g.weapons.addAmmo('flare', 8); },\n    steps: [\n      { do: 'goto', site: 'long-field', r: 120, text: 'REACH THE LONG FIELD' },\n      { do: 'burn', site: 'long-field', pct: 0.3, text: 'BURN THE CROP' },\n      { do: 'script', run: (g) => { g.say('THE WIND IS TURNING.', 'player', 3); g.world.wind.dir = [0.9, -0.2]; g.world.wind.speed = 7; g.mission.turned = true; const b = g.buddies.list[0]; if (b) { b.hp = 0; b.burning = true; b.burnT = 40; b.alive = false; g.combat.actors = g.combat.actors.filter((a) => a !== b); b.onDeath(); g.dialogue.play('m6.turn'); } else g.mission.pellDown = true; g.mission.forced = true; } },\n      { do: 'wait', text: 'SYRETTE OR FINISH IT', until: (g) => !g.buddies.list.some((b) => b.state === 'down') && g.mission.forced, onDone: (g) => {} },\n      { do: 'destroy', tag: 'ammo', n: 1, text: 'BLOW THE AMMO BUNKER' },\n      { do: 'leave', site: 'long-field', r: 160, text: 'GET OUT OF THE FIELD' },\n      { do: 'report', to: 'ansa', seq: 'm6.done', text: 'REPORT TO MOTHER ANSA' },\n    ],\n    onDone: (g) => { g.fire.burnStrip('B'); g.story.ledger.moved += 38; g.story.ledger.killed += 8; g.story.flags.m6 = true; g.buddies.dismissAll(); g.story.contract = null; } },\n  m7: { id: 'm7', title: 'The Cut', giver: 'harrow', requires: ['m6'], pay: 20, auto: true, hour: 14, wind: { dir: [0.5, -0.8], speed: 4 },\n    onStart: (g) => { g.waypointTo(150, -300); const c = site(g, 'the-cut'); spawnSquad(g, 'the-cut', 'concord', 6, 30); spawnSquad(g, 'the-cut', 'harvest', 6, 30); for (let i = 0; i < 4; i++) g.fire.ignite(c.x + g.ctx.random.range(-40, 40), c.z + g.ctx.random.range(-40, 40), 5); g.mission.shell = 0; },\n    steps: [\n      { do: 'scene', seq: 'm7.note', text: 'A NOTE AT YOUR SAFEHOUSE' },\n      { do: 'goto', site: 'the-cut', r: 70, text: 'REACH THE CUT THROUGH THE CROSSFIRE' },\n      { do: 'use', kind: 'sluice', text: 'TAKE HARROW\\'S LEDGER AT THE SLUICE HOUSE' },\n      { do: 'scene', seq: 'm7.ledger' },\n      { do: 'leave', site: 'the-cut', r: 190, text: 'GET OUT OF THE CUT' },\n      { do: 'scene', seq: 'm7.done', focus: 'odile' },\n    ],\n    alt: { buddy: 'any', call: 'm7.alt', bonus: 0, steps: [], setup: (g) => { g.mission.fewer = true; } },\n    onDone: (g) => { g.fire.burnStrip('C'); g.story.flags.truceOver = true; g.story.ledger.moved += 140; g.story.ledger.killed += 12; g.story.unlocked = [...new Set([...g.story.unlocked, 'mule', 'tractor', 'weed', 'tube', 'empire'])]; g.story.flags.m7 = true; g.story.act = 3; } },\n  m9: { id: 'm9', title: 'The Surveyor', giver: 'harrow', requires: ['m7'], pay: 0, auto: true, hour: 23, storm: true,\n    onStart: (g) => { g.waypointTo(-130, -520); const o = site(g, 'observatory'); for (let i = 0; i < 5; i++) { const a = i * 1.3; g.spawnSoldier({ faction: i % 2 ? 'concord' : 'harvest', role: 'rifle', at: [o.x + Math.cos(a) * 22, o.z + Math.sin(a) * 22], yaw: a + 3, site: o }); } },\n    steps: [\n      { do: 'goto', site: 'observatory', r: 36, text: 'CLIMB TO THE OBSERVATORY' },\n      { do: 'use', kind: 'harrow', text: 'SIT WITH THE SURVEYOR' },\n      { do: 'scene', seq: 'm9.scene', focus: 'harrow' },\n      { do: 'choice', title: 'HARROW WAITS', options: [{ label: 'Finish the contract', flag: 'shot' }, { label: 'Put the gun away', flag: 'spared' }], text: 'CHOOSE' },\n      { do: 'script', run: (g) => { if (g.story.choices.m9 === 'shot') { g.sfx('shot_m38'); g.story.ledger.killed++; g.dialogue.play('m9.shot', { focus: 'harrow' }); } else g.dialogue.play('m9.spared', { focus: 'harrow' }); g.story.stones += 5; g.story.earned += 5; } },\n      { do: 'timer', secs: 7 },\n      { do: 'choice', title: 'WHO GETS THE SHEET', options: [{ label: 'Walk out alone', flag: 'walk' }, { label: 'Give it to the column', flag: 'give' }], text: 'CHOOSE', key: 'sheet' },\n    ],\n    onDone: (g) => { g.story.flags.m9 = true; g.setWeather?.('clear'); } },\n  end: { id: 'end', title: 'The Pass', auto: true, pay: 0, hour: 5.4,\n    onStart: (g) => { g.waypointTo(-590, -430); const p = site(g, 'the-pass'); spawnSquad(g, 'the-pass', 'concord', 5, 40); spawnSquad(g, 'the-pass', 'harvest', 5, 40); g.mission.give = g.story.choices.sheet === 'give'; },\n    steps: [\n      { do: 'goto', site: 'the-pass', r: 60, text: 'WALK TO THE PASS' },\n      { do: 'hold', site: 'the-pass', r: 70, secs: 40, text: 'HOLD THE PASS BEHIND THE COLUMN', when: (g) => g.mission.give },\n      { do: 'script', run: (g) => { g.endBuddies(); } },\n      { do: 'ignite', site: 'the-pass', r: 60, text: 'LIGHT THE LAST GRASS' },\n      { do: 'script', run: (g) => { g.finishGame(); } },\n    ],\n    onDone: () => {} },\n};\n// Mercy Runs: three variants of one idea (carry a crate within five minutes, paid in tablets)\nexport const MERCY = [\n  { id: 'mr2', title: 'Mercy Run: Salt Road', requires: ['m1'], to: [300, 390], toName: 'Checkpoint P6', secs: 300 },\n  { id: 'mr3', title: 'Mercy Run: The Cut Spur', requires: ['m2'], to: [150, -260], toName: 'Cut Spur', secs: 300 },\n].map((d) => ({ id: d.id, title: d.title, giver: 'odile', requires: d.requires, pay: 4, repeatable: false, mercy: true, brief: 'mercy.brief',\n  onStart: (g) => { g.waypointTo(d.to[0], d.to[1]); g.mission.veh = g.spawnVehicle('pickup', [site(g, 'mile-forty').x - 10, site(g, 'mile-forty').z + 18], 1.5); g.mission.crate = true; },\n  steps: [{ do: 'deliver', at: d.to, r: 30, secs: d.secs, text: `CARRY THE CRATE TO ${d.toName.toUpperCase()} IN FIVE MINUTES` }, { do: 'goto', site: 'mile-forty', r: 60, text: 'GET BACK TO MILE FORTY' }],\n  onDone: (g) => { g.weapons.tablets += 4; g.story.mercyRuns++; g.mission.crate = false; } }));\nfor (const m of MERCY) MISSIONS[m.id] = m;\nEOF\npython3 - <<'EOF'\n# add the mercy brief sequence to dialogue\np='src/content/dialogue.js'\ns=open(p).read()\ns=s.replace(\"export const SEQ = {\",\"export const SEQ = {\\n  'mercy.brief': [['odile', 'Another crate. Another five minutes. I count them. You may count them too.'], ['odile', 'Four tablets, if you arrive. Nothing, if you do not. I will say nothing, which is worse.']],\")\nopen(p,'w').write(s)\nEOF\necho ok"}}}
