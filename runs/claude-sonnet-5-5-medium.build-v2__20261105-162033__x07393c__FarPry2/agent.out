{"type":"system","subtype":"task_started","task_id":"bclxiq5pk","run_id":"0mw4azaxo-7be3dc49","tool_use_id":"toolu_011tiVdqQzYGwMmY4Lq5jomG","description":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162033__x07393c/work/FarPry2*/ && cat > src/net/link.js <<'EOF'\n// linkSession: two windows of one browser play Cash Run through a BroadcastChannel. Same interface as the hub's session.\nconst COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nexport function openLobby(role) {\n  const ch = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel('game-link-v1') : null;\n  const L = { role, ch, state: 'open', joined: false, peer: null, start: null, id: Math.random !== undefined ? 0 : 0, token: String((typeof performance !== 'undefined' ? performance.now() : 0) + role) + Math.floor(Date.now() % 100000) };\n  if (ch) ch.onmessage = (ev) => {\n    const m = ev.data; if (!m || m.k === 'g') return;\n    if (role === 'host' && m.k === 'join' && !L.joined) { L.joined = true; L.peer = m.token; ch.postMessage({ k: 'welcome', to: m.token }); }\n    else if (role === 'join' && m.k === 'welcome' && m.to === L.token) { L.joined = true; }\n    else if (role === 'join' && m.k === 'start') { L.start = m; }\n    else if (role === 'host' && m.k === 'join') ch.postMessage({ k: 'welcome', to: m.token });\n  };\n  L.poll = () => { if (role === 'join' && !L.joined) ch?.postMessage({ k: 'join', token: L.token }); };\n  L.go = () => { if (role !== 'host' || !L.joined) return null; const m = { k: 'start', base: Date.now() + 500, seed: 4242 }; ch.postMessage(m); L.start = m; return m; };\n  L.close = () => { try { ch?.close(); } catch { /* closed */ } };\n  return L;\n}\nexport function linkSession(g, L) {\n  const host = L.role === 'host', ch = L.ch; const ls = new Map(); const emit = (ev, ...a) => (ls.get(ev) || []).forEach((f) => f(...a));\n  const players = [{ id: 0, name: 'HOST', color: COLORS[0] }, { id: 1, name: 'GUEST', color: COLORS[1] }]; const me = host ? 0 : 1;\n  const base = L.start.base; let timeUp = false, over = false, started = false;\n  ch.onmessage = (ev) => {\n    const m = ev.data; if (!m) return;\n    if (m.k === 'g' && (m.to === undefined || m.to === me) && m.from !== me) emit('message', m.d, m.from);\n    else if (m.k === 'end') { if (!over) { over = true; S.results = m.res; emit('end', { reason: 'finished' }); g.round?.showResults?.(m.res); } }\n  };\n  const S = {\n    kind: 'link', me, players, host: 0, isHost: host, server: false, limitMs: 360000, seed: L.start.seed,\n    time: () => (started ? Date.now() - base - 3000 : -Infinity), rng: (label) => { let h = L.start.seed; for (const c of label) h = (h * 31 + c.charCodeAt(0)) >>> 0; return () => { h = (h * 1664525 + 1013904223) >>> 0; return h / 4294967296; }; },\n    send(d, o = {}) { ch.postMessage({ k: 'g', from: me, to: o.to, d }); return true; }, on(ev, f) { if (!ls.has(ev)) ls.set(ev, []); ls.get(ev).push(f); }, ready() { started = true; emit('start', { in: 3000 }); },\n    answer() {}, fail() {}, progress() {},\n    finish(res) { if (over) return; over = true; S.results = res; ch.postMessage({ k: 'end', res }); g.round?.showResults?.(res); },\n    tick() { if (host && started && !timeUp && S.time() >= S.limitMs) { timeUp = true; emit('time-up', { graceMs: 5000 }); } },\n    emit,\n  };\n  return S;\n}\nEOF\npython3 - <<'EOF'\np='src/flow.js'\ns=open(p).read()\ns=s.replace(\"import { soloSession } from './net/solo.js';\",\"import { soloSession } from './net/solo.js';\\nimport { openLobby, linkSession } from './net/link.js';\")\ns=s.replace(\"  startRound() {\\n    const g = this.g;\",\"\"\"  startRound(kind = 'solo') {\n    const g = this.g;\n    if (kind === 'host' || kind === 'join') { this.lobby?.close(); this.lobby = openLobby(kind); g.ui.closeAll(); g.ui.open('lobby', kind); return; }\n    this.beginRound(soloSession(g));\n  }\n  beginRound(session) {\n    const g = this.g;\"\"\")\ns=s.replace(\"    g.session = soloSession(g); g.life = new Lifecycle(g.session);\",\"    g.session = session; g.life = new Lifecycle(g.session);\")\ns=s.replace(\"  endRound() {\\n    const g = this.g; if (!g.round) return;\",\"  endRound() {\\n    const g = this.g; this.lobby?.close(); this.lobby = null; if (!g.round) return;\")\ns=s.replace(\"g.endRound(); g.ui.closeAll(); g.flow.startRound();\",\"g.flow.endRound(); g.ui.closeAll(); g.flow.startRound();\")\ns=s.replace(\"  frame(g, dt) {\\n    this.frameN++;\",\"  frame(g, dt) {\\n    this.frameN++;\\n    const L = this.lobby; if (L && !g.round) { if (this.frameN % 30 === 0) L.poll(); if (L.role === 'join' && L.start) { const s = linkSession(g, L); this.lobby = null; g.ui.closeAll(); this.beginRound(s); } }\")\nopen(p,'w').write(s)\np='src/net/round.js'\ns=open(p).read(); s=s.replace(\"if (this.session.kind !== 'solo') return;\",\"if (this.session.kind === 'hub') return;\"); open(p,'w').write(s)\np='src/ui/screens.js'\ns=open(p).read()\ns=s.replace(\"      { label: 'Solo with Hired Guns', run: (g) => g.flow.startRound('solo') },\\n\",\"      { label: 'Solo with Hired Guns', run: (g) => g.flow.startRound('solo') },\\n      { label: 'Host on This Computer', run: (g) => g.flow.startRound('host') },\\n      { label: 'Join on This Computer', run: (g) => g.flow.startRound('join') },\\n\")\ns=s.replace(\"  S.touch = () =>\",\"\"\"  S.lobby = (g, kind) => ({\n    id: 'lobby', dim: true, top: 170, rowH: 20, hints: [['confirm', 'SELECT'], ['back', 'BACK']], onBack: () => { g.flow.lobby?.close(); g.flow.lobby = null; return true; },\n    draw: (g, hud) => { centered(hud, kind === 'host' ? 'HOSTING CASH RUN' : 'JOINING CASH RUN', 40, { scale: 3, color: 'orange' }); const L = g.flow.lobby; centered(hud, kind === 'host' ? (L?.joined ? 'A FRIEND HAS JOINED.' : 'OPEN THE GAME IN ANOTHER WINDOW AND CHOOSE JOIN.') : (L?.joined ? 'FOUND A HOST. WAITING FOR THE START.' : 'LOOKING FOR A HOST IN ANOTHER WINDOW...'), 90, { color: 'sand' }); },\n    items: () => (kind === 'host' ? [{ label: 'Start the round', disabled: !g.flow.lobby?.joined, run: (g) => { const L = g.flow.lobby; const m = L.go(); if (m) { g.flow.lobby = null; g.ui.closeAll(); g.flow.beginRound(linkSession(g, L)); } } }] : []),\n  });\n  S.touch = () =>\"\"\")\ns=s.replace(\"import { drawPrompt, drawGlyph, codeFor } from './glyphs.js';\",\"import { drawPrompt, drawGlyph, codeFor } from './glyphs.js';\\nimport { linkSession } from '../net/link.js';\")\nopen(p,'w').write(s)\nEOF\ncat > tests/suites/link.mjs <<'EOF'\n// link: two games in one process play Cash Run over the BroadcastChannel to the end with the same standings.\nimport { boot } from '../lib/boot.mjs';\nexport const covers = ['src'];\nconst tick = () => new Promise((r) => setTimeout(r, 5));\nexport async function run(t) {\n  const A = await boot(), B = await boot(); A.game.flow.startRound('host'); B.game.flow.startRound('join');\n  for (let i = 0; i < 80 && !(A.game.flow.lobby?.joined); i++) { A.e.step(2); B.e.step(30); await tick(); }\n  t.ok(A.game.flow.lobby?.joined, 'the host sees the friend join');\n  A.game.ui.screen.items(A.game)[0].run(A.game, A.game.ui); for (let i = 0; i < 20; i++) { B.e.step(2); await tick(); }\n  t.ok(A.game.round && B.game.round, 'both windows begin the round'); t.eq(A.game.round.players.length, 2, 'two players');\n  A.game.godMode = B.game.godMode = true;\n  // a shared case: B takes case 0 and banks it; A must see the standings\n  const base = A.game.session.time(); await new Promise((r) => setTimeout(r, 3600));\n  const c0 = B.game.round.cases[0]; B.game.player.teleport(c0.x, c0.z + 1); for (let i = 0; i < 90; i++) { B.e.input.setKey('KeyE', true); B.e.step(2); A.e.step(2); await tick(); } B.e.input.setKey('KeyE', false);\n  for (let i = 0; i < 40; i++) { B.e.step(2); A.e.step(2); await tick(); }\n  t.ok(B.game.round.local.carry === 0, 'the guest takes a case'); t.ok(A.game.round.cases[0].taken, 'the host sees it taken');\n  B.game.player.teleport(150, -205); for (let i = 0; i < 40; i++) { B.e.step(3); A.e.step(3); await tick(); }\n  t.ok(A.game.round.players[1].stones > 0, 'the host counts the guest\\'s bank');\n  A.game.session.emit('time-up', { graceMs: 5000 }); for (let i = 0; i < 20; i++) { A.e.step(2); B.e.step(2); await tick(); }\n  t.ok(A.game.session.results && B.game.session.results, 'both windows get results'); t.eq(A.game.session.results.standings, B.game.session.results.standings, 'the same standings');\n  t.eq(A.game.session.results.standings[0], [1], 'the guest wins with the bank');\n  A.game.flow.lobby?.close(); B.game.flow.lobby?.close();\n}\nEOF\nnode tools/build.mjs | tail -1; (timeout 110 node tests/run.mjs --only link > scratch/link.txt 2>&1; tail -8 scratch/link.txt | cut -c1-300)","is_backgrounded":false,"task_type":"local_bash","uuid":"fd402e81-128a-476f-840d-18deb388d686","session_id":"feff64bd-df6d-45b2-b337-83604d3a2d73"}
