{"type":"system","subtype":"task_started","task_id":"bliccxja5","run_id":"0mw46eq2y-4830a89e","tool_use_id":"toolu_01Hv2fjzyFAjkMmJRWLKucDu","description":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162033__x07393c/work/FarPry2*/ && echo \"PW=$PLAYWRIGHT_HOST_PLATFORM_OVERRIDE\" && cat > tests/run.mjs <<'EOF'\n// One command: node tests/run.mjs [--all] [--only suite]. Prints only failures and a one-line count.\nimport { createHash } from 'node:crypto';\nimport { existsSync, readFileSync, readdirSync, statSync, writeFileSync } from 'node:fs';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nconst args = process.argv.slice(2);\nconst ALL = args.includes('--all');\nconst only = args.includes('--only') ? args[args.indexOf('--only') + 1] : null;\nconst STAMPS = join(ROOT, 'tests/.stamps.json');\nconst stamps = existsSync(STAMPS) ? JSON.parse(readFileSync(STAMPS, 'utf8')) : {};\nconst walk = (p) => { if (!existsSync(p)) return []; const st = statSync(p); if (st.isFile()) return [p]; return readdirSync(p).flatMap((n) => (n.startsWith('.') ? [] : walk(join(p, n)))); };\nconst hashOf = (covers) => { const h = createHash('sha1'); for (const c of covers) for (const f of walk(join(ROOT, c)).sort()) { h.update(f); h.update(readFileSync(f)); } return h.digest('hex'); };\nconst order = ['static', 'systems', 'playthrough', 'replay', 'browser', 'hub', 'link'];\nconst names = readdirSync(join(ROOT, 'tests/suites')).filter((n) => n.endsWith('.mjs')).map((n) => n.slice(0, -4)).sort((a, b) => order.indexOf(a) - order.indexOf(b));\nlet passed = 0, failed = 0, unchanged = 0;\nconst fails = [];\nfor (const name of names) {\n  if (only && only !== name) continue;\n  const mod = await import(join(ROOT, 'tests/suites', name + '.mjs'));\n  const covers = [...(mod.covers || ['src']), 'tests/suites/' + name + '.mjs', 'tests/lib'];\n  const h = hashOf(covers);\n  if (!ALL && !only && stamps[name] && stamps[name].hash === h && stamps[name].failed === 0) { unchanged++; continue; }\n  const t = { name, ok(c, m) { if (c) passed++; else { failed++; fails.push(`[${name}] ${m}`); } }, eq(a, b, m) { const ok = JSON.stringify(a) === JSON.stringify(b); if (ok) passed++; else { failed++; fails.push(`[${name}] ${m}: got ${JSON.stringify(a)} want ${JSON.stringify(b)}`); } }, fail(m) { failed++; fails.push(`[${name}] ${m}`); } };\n  const before = failed;\n  try { await mod.run(t); } catch (err) { failed++; fails.push(`[${name}] threw: ${err && err.stack ? err.stack.split('\\n').slice(0, 4).join(' | ') : err}`); }\n  stamps[name] = { hash: h, failed: failed - before };\n}\nwriteFileSync(STAMPS, JSON.stringify(stamps, null, 1));\nfor (const f of fails) console.log('FAIL', f);\nconsole.log(`${passed} passed, ${failed} failed, ${unchanged} suites unchanged`);\nprocess.exit(failed ? 1 : 0);\nEOF\ncat > tests/lib/serve.mjs <<'EOF'\n// Serve tests/.site on 127.0.0.1 with an OS-picked port; returns { port, pid, stop }.\nimport { spawn } from 'node:child_process';\nimport { copyFileSync, mkdirSync, readdirSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { ROOT } from './boot.mjs';\nexport const GAME_HTML = join(ROOT, '..', 'FarPry2-FarCry2-claude-sonnet-5-5-medium-20261105-162033.html');\nexport async function serveSite() {\n  const dir = join(ROOT, 'tests/.site');\n  mkdirSync(dir, { recursive: true });\n  copyFileSync(GAME_HTML, join(dir, 'game.html'));\n  for (const f of ['harness.html', 'bridge.js', 'round.js']) copyFileSync(join(ROOT, 'vendor/hub', f), join(dir, f));\n  const p = spawn('python3', ['-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'ignore'] });\n  const port = await new Promise((res, rej) => { let buf = ''; p.stdout.on('data', (d) => { buf += d; const m = /port (\\d+)/.exec(buf); if (m) res(+m[1]); }); setTimeout(() => rej(new Error('server did not start')), 10000); });\n  return { port, pid: p.pid, stop: () => p.kill() };\n}\nexport const CHROME_FLAGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'];\nEOF\ncat > tests/suites/hub.mjs <<'EOF'\n// The AI Hub harness, four scenarios, run one at a time against the built single file.\nimport { chromium } from 'playwright';\nimport { serveSite, CHROME_FLAGS } from '../lib/serve.mjs';\nexport const covers = ['src', 'vendor/hub', 'tools'];\nconst SCENARIOS = ['players=2&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave', 'players=2&auto=1&scenario=server'];\nexport async function run(t) {\n  process.env.PLAYWRIGHT_HOST_PLATFORM_OVERRIDE ||= 'ubuntu24.04-x64';\n  const srv = await serveSite();\n  const browser = await chromium.launch({ args: CHROME_FLAGS });\n  try {\n    for (const sc of SCENARIOS) {\n      const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n      const errs = [];\n      page.on('pageerror', (e) => errs.push(String(e)));\n      const title = await (async () => { const p2 = await browser.newPage(); await p2.goto(`http://127.0.0.1:${srv.port}/game.html`); const tt = await p2.title(); await p2.close(); return tt; })();\n      t.eq(title, 'Far Pry 2', 'served page title');\n      await page.goto(`http://127.0.0.1:${srv.port}/harness.html?game=game.html&${sc}`);\n      try { await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 120000 }); } catch { t.fail(`${sc}: harness never completed`); await page.close(); continue; }\n      const res = await page.evaluate(() => ({ pass: window.__hubCheck.pass, checks: window.__hubCheck.checks }));\n      t.ok(res.pass, `hub ${sc}`);\n      if (!res.pass) for (const c of res.checks || []) if (c && (c.ok === false || c.pass === false)) t.fail(`  check failed: ${JSON.stringify(c).slice(0, 300)}`);\n      await page.close();\n    }\n  } finally { await browser.close(); srv.stop(); }\n}\nEOF\ntimeout 400 node tests/run.mjs --only hub 2>&1 | tail -20","is_backgrounded":false,"task_type":"local_bash","uuid":"6602fb14-bec9-4aeb-9ff1-4d4c26f28e55","session_id":"feff64bd-df6d-45b2-b337-83604d3a2d73"}
