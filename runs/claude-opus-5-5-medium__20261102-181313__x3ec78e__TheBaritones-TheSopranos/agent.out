{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013B7ghTiNz6d64Ck7Wqni2z","type":"tool_result","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Rooftop · my-3D2dge template</title>\n<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#f4f0ff;font-size:16px;letter-spacing:.08em\">ROOFTOP</b><span>Starting · my-3D2dge v0.85.1</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9b77c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n<script src=\"../my-3d2dge.js\"></script>\n<script src=\"game.js\"></script>\n</body>\n</html>\n// The handoff package's template game: a rooftop thief in the isometric view. Climb onto the roof, take the gem, and\n// don't let the guard in the street watch you for long. It shows what a game is made of (scenes, a TileMap with roofs, a\n// Mover and a Humanoid, input, the camera, a HUD) and the height-aware API: E.Mover climbs any wall (climbAny: jump at\n// it, the stick climbs, jump leaps up, it pulls up at the top) and glides (glide: jump again in the air; a sail drawn\n// over it), both on its stamina, the guard is a plain Body, map.sight and E.inArc for\n// the guard's eyes (they see over the planter, not through the roof), shapes and materials (docs/ASSETS.md: barrels and\n// crates as data, solid with map.solid; the street's cobbles a material), and game.debug for tests and tools. The pause menu,\n// settings, rebinding and full screen come with every game: menu: { controls } names the actions on its Controls screen,\n// and input.label() puts the player's own key or button in a prompt. The night is canvas lighting (game.lights): an\n// ambient, and lights added every draw (a street lamp, the gem's glow), the same in every browser and every check. The\n// HUD is HTML (E.Shell: the objective with its distance, the guard's alert, your keys), over the pixels; the title and\n// end screens are pixel art.\n// Copy it and make it your game. Test it headless: node game/test.mjs. Check it in a browser: node tools/check.mjs game/index.html\n(() => {\nconst E = My3D2dge;\nconst game = new E.Game({ canvas: 'screen', res: 'snes', expand: true, view: 'iso', views: ['iso', 'threequarter'],   // expand: full screen at any shape (the HUD anchors to r.W, r.H)\n  menu: { controls: { jump: 'Jump and climb', attack: false, dash: false, skill: false } } });   // (this game uses moves and jump only)\nconst ui = new E.Shell(game);   // the HTML HUD (it keeps the standard pause menu); headless, it draws nothing\nconst ROOF = 32;\nconst map = new E.TileMap({\n  rows: ['############',\n         '#..........#',\n         '#.@........#',\n         '#....p.....#',\n         '#......RRR.#',\n         '#......RGR.#',\n         '#..s...RRR.#',\n         '#..........#',\n         '############'],\n  legend: { '#': 1, R: 2, G: { tile: 2, spawn: 'gem' }, p: 3, '@': 'hero', s: 'guard' },\n  types: { 1: { h: 48, top: '#5a5068', side: '#3e3650', cut: true },\n           2: { h: ROOF, top: '#9a4a3a', side: '#c8b89a', face: 'plaster', roof: 'tiles' },\n           3: { h: 10, top: '#3e7a3a', side: '#5a4a32', face: 'plank', roof: 'leaves' } },\n  floorMat: 'cobble'   // a material (E.MATERIALS, or '#hex pattern'): the floor, wall faces and tops, shapes' parts all take them\n});\n// set dressing: shapes (E.SHAPES: objects as data, right in every view), solid where they stand (map.solid: walk into one, land on it)\nconst DRESS = [['barrel', 152, 30, { facing: .5 }], ['barrel', 166, 26, { facing: 2 }], ['crate', 22, 120, { facing: .3 }], ['cart', 72, 26, { facing: 0 }]];\nfor (const [id, x, y, o] of DRESS) map.solid(id, x, y, 0, o);\nconst GEM = E.sprite(['.c.', 'cCc', '.c.'], { c: '#48c8f0', C: '#e8faff' }, 2);\nlet hero, heroRig, guard, guardRig, alert, got, won;\n\nfunction reset() {\n  const h = map.find('hero'), g = map.find('guard');\n  hero = new E.Mover({ x: h.x, y: h.y, r: 5, climbAny: true, climbMax: 24, glide: true, staminaMax: 100 }); hero.facing = 0;   // (the roof, 32 high, is climbed)\n  heroRig = heroRig || new E.Humanoid({ size: 1.2, build: 'heroic', weapon: null, hood: true, outfit: 'coat', colors: { cloth: '#3a4a6a', cape: '#2a3a52' } });\n  guard = new E.Body({ x: g.x, y: g.y, r: 5 }); guard.facing = 0; guard.dir = 1;\n  guardRig = guardRig || new E.Humanoid({ size: 1.2, build: 'heroic', weapon: 'sword', hat: 'helmet', colors: { cloth: '#8a3a32' } });\n  alert = 0; got = false; won = false;\n}\n\nconst title = {\n  update() { if (game.input.pressed('start')) { reset(); game.go('play'); } },\n  draw(r) {\n    r.sky(['#141030', '#3a2a60']);\n    const m = Math.round(r.H / 2);   // centred on any screen\n    r.overlay(g => E.font.title(g, 'ROOFTOP', r.W / 2, m - 52, { scale: 3, align: 'center' }));\n    r.text(('CLIMB WITH ' + game.input.label('jump') + '  TAKE THE GEM  STAY UNSEEN').toUpperCase(), r.W / 2, m + 8, '#e8e0ff', { align: 'center' });\n    r.text(('PRESS ' + game.input.label('start')).toUpperCase(), r.W / 2, m + 38, '#ffffff', { align: 'center', shadow: '#000' });\n  }\n};\n\nconst play = {\n  pausable: true,\n  enter() { game.follow(hero, { z: 16 }); game.cam.bounds = v => map.bounds(v); game.lights.enabled = true; game.lights.ambient = .5; },\n  exit() { game.lights.enabled = false; ui.hud({}); },\n  update(dt) {\n    const I = game.input, was = !!(hero.wall || hero.action);\n    hero.update(dt, map, I);   // walks, jumps, climbs: the stick and the jump button, through the view\n    if (!was && (hero.wall || hero.action)) game.audio.sfx('jump');\n    // the guard walks the street and watches ahead: its eyes see over the planter, not through the roof\n    guard.vx = guard.dir * 30; guard.update(dt, map);\n    if (guard.x > 112 || guard.hitWall) guard.dir = -1; else if (guard.x < 40) guard.dir = 1;\n    guard.facing = guard.dir > 0 ? 0 : Math.PI;\n    const sees = map.sight(guard, hero) && E.inArc(guard, guard.facing, hero, 110, .6);\n    alert = sees ? alert + dt : Math.max(0, alert - dt * .5);\n    const gem = map.find('gem');\n    if (!got && E.dist(hero, { x: gem.x, y: gem.y, z: ROOF }) < 12) { got = true; game.audio.sfx('coin'); game.flash('#c8f4ff', .15); }\n    if (got && hero.z < 2) { won = true; game.go('end'); }   // back down in the street with it\n    else if (alert > 1.2) { won = false; game.audio.sfx('hurt'); game.go('end'); }\n    // the rigs are posed every step from the bodies' motion; draw only draws them\n    heroRig.update(dt, hero.rigState());\n    guardRig.update(dt, { x: guard.x, y: guard.y, z: guard.z, vx: guard.vx, vy: 0, facing: guard.facing, stance: 'ready' });\n    // the HUD, from this step's state (E.Shell redraws only what changed; the keys hide on a touch screen)\n    ui.hud({ objective: got ? { title: 'Bring it down', text: 'Back to the street with it' } : { title: 'Take the gem', text: hero.wall ? 'Climb: up, and jump to leap' : 'It lies on the roof', at: { x: gem.x, y: gem.y, z: ROOF }, from: hero },\n      bars: [{ label: 'Seen', value: Math.min(alert, 1.2), max: 1.2, color: '#ff6040' }, { label: 'Stamina', value: hero.stamina, max: hero.staminaMax, color: hero.exhausted ? '#ff6040' : '#7ad06a' }],\n      keys: [[['up', 'left', 'down', 'right'].map(a => I.label(a)).join(''), 'Move'], [I.label('jump'), 'Jump, climb, glide']] });\n  },\n  draw(r) {\n    map.drawFloor(r); map.queueWalls(r);   // (the floor runs on past the map to the screen's edges: map.outside)\n    for (const [id, x, y, o] of DRESS) r.shape(id, x, y, 0, o);\n    r.prop('lamp', 88, 88, 0, { light: true });   // a street lamp: its glow and a pool of light\n    r.decal(() => r.groundArc(guard.x, guard.y, 6, 110, guard.facing - .6, guard.facing + .6, alert > 0 ? '#ff6040' : '#ffe080', .4));   // its sight cone\n    const gem = map.find('gem');\n    if (!got) { r.sprite(gem.x, gem.y, ROOF + 6 + Math.sin(game.time * 3) * 2, GEM, { glow: .8 }); game.lights.add(gem.x, gem.y, ROOF + 6, 44, .9, { color: '#80d8ff' }); }\n    if (hero.gliding) r.queue(hero.x, hero.y, hero.z + 40, g => {   // the sail, over the hands the rig holds up\n      const c = Math.cos(hero.facing), s = Math.sin(hero.facing), P = (f, w, z) => r.w(hero.x + c * f - s * w, hero.y + s * f + c * w, hero.z + z);\n      const q = [P(9, -17, 43), P(9, 17, 43), P(-7, 15, 37), P(-7, -15, 37)], h = P(0, 0, 30);\n      for (const t of [q[0], q[1]]) E.px.line(g, t[0], t[1], h[0], h[1], '#3a2a20');\n      E.px.poly(g, q, '#d8603a'); E.px.line(g, q[0][0], q[0][1], q[1][0], q[1][1], '#f4a070');\n    });\n    for (const [b, rig] of [[hero, heroRig], [guard, guardRig]]) {\n      r.shadow(b.x, b.y, 7, .35, undefined, b.groundZ || 0);\n      r.actor(b.x, b.y, b.z, (g, ox, oy) => rig.draw(g, ox, oy, r.view));\n    }\n  }\n};\n\nconst end = {\n  update() { if (game.input.pressed('start')) { reset(); game.go('play'); } },\n  draw(r) {\n    r.sky(won ? ['#103020', '#2a6a48'] : ['#301010', '#6a2a2a']);\n    const m = Math.round(r.H / 2);\n    r.overlay(g => E.font.title(g, won ? 'STOLEN' : 'CAUGHT', r.W / 2, m - 42, { scale: 3, align: 'center' }));\n    r.text(('PRESS ' + game.input.label('start') + ' TO TRY AGAIN').toUpperCase(), r.W / 2, m + 28, '#ffffff', { align: 'center', shadow: '#000' });\n  }\n};\n\nreset();\n// a handle for tests and tools (node game/test.mjs, tools/check.mjs prints snapshot(), tools/replay.mjs logs it)\ngame.debug = {\n  snapshot: () => ({ scene: game.sceneName, hero: [hero.x, hero.y, hero.z].map(v => Math.round(v * 10) / 10), climbing: !!(hero.wall || hero.action),\n    guard: [Math.round(guard.x), Math.round(guard.y), guard.facing], alert: Math.round(alert * 100) / 100, got, won }),\n  teleport(x, y, z = 0, facing = hero.facing) { Object.assign(hero, { x, y, z, vx: 0, vy: 0, vz: 0, onGround: true, facing, wall: null, action: null }); }\n};\ngame.start({ scenes: { title, play, end }, scene: 'title' });\n})();\n// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181313__x3ec78e/work","is_error":false}]},"parent_tool_use_id":null,"session_id":"70b9b3fb-a482-4430-a756-95fe6fe59945","uuid":"e0e3dc30-32c2-49dc-8f9f-27c943733587","timestamp":"2026-11-03T01:16:27.958Z","tool_use_result":{"stdout":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Rooftop · my-3D2dge template</title>\n<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#f4f0ff;font-size:16px;letter-spacing:.08em\">ROOFTOP</b><span>Starting · my-3D2dge v0.85.1</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9b77c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n<script src=\"../my-3d2dge.js\"></script>\n<script src=\"game.js\"></script>\n</body>\n</html>\n// The handoff package's template game: a rooftop thief in the isometric view. Climb onto the roof, take the gem, and\n// don't let the guard in the street watch you for long. It shows what a game is made of (scenes, a TileMap with roofs, a\n// Mover and a Humanoid, input, the camera, a HUD) and the height-aware API: E.Mover climbs any wall (climbAny: jump at\n// it, the stick climbs, jump leaps up, it pulls up at the top) and glides (glide: jump again in the air; a sail drawn\n// over it), both on its stamina, the guard is a plain Body, map.sight and E.inArc for\n// the guard's eyes (they see over the planter, not through the roof), shapes and materials (docs/ASSETS.md: barrels and\n// crates as data, solid with map.solid; the street's cobbles a material), and game.debug for tests and tools. The pause menu,\n// settings, rebinding and full screen come with every game: menu: { controls } names the actions on its Controls screen,\n// and input.label() puts the player's own key or button in a prompt. The night is canvas lighting (game.lights): an\n// ambient, and lights added every draw (a street lamp, the gem's glow), the same in every browser and every check. The\n// HUD is HTML (E.Shell: the objective with its distance, the guard's alert, your keys), over the pixels; the title and\n// end screens are pixel art.\n// Copy it and make it your game. Test it headless: node game/test.mjs. Check it in a browser: node tools/check.mjs game/index.html\n(() => {\nconst E = My3D2dge;\nconst game = new E.Game({ canvas: 'screen', res: 'snes', expand: true, view: 'iso', views: ['iso', 'threequarter'],   // expand: full screen at any shape (the HUD anchors to r.W, r.H)\n  menu: { controls: { jump: 'Jump and climb', attack: false, dash: false, skill: false } } });   // (this game uses moves and jump only)\nconst ui = new E.Shell(game);   // the HTML HUD (it keeps the standard pause menu); headless, it draws nothing\nconst ROOF = 32;\nconst map = new E.TileMap({\n  rows: ['############',\n         '#..........#',\n         '#.@........#',\n         '#....p.....#',\n         '#......RRR.#',\n         '#......RGR.#',\n         '#..s...RRR.#',\n         '#..........#',\n         '############'],\n  legend: { '#': 1, R: 2, G: { tile: 2, spawn: 'gem' }, p: 3, '@': 'hero', s: 'guard' },\n  types: { 1: { h: 48, top: '#5a5068', side: '#3e3650', cut: true },\n           2: { h: ROOF, top: '#9a4a3a', side: '#c8b89a', face: 'plaster', roof: 'tiles' },\n           3: { h: 10, top: '#3e7a3a', side: '#5a4a32', face: 'plank', roof: 'leaves' } },\n  floorMat: 'cobble'   // a material (E.MATERIALS, or '#hex pattern'): the floor, wall faces and tops, shapes' parts all take them\n});\n// set dressing: shapes (E.SHAPES: objects as data, right in every view), solid where they stand (map.solid: walk into one, land on it)\nconst DRESS = [['barrel', 152, 30, { facing: .5 }], ['barrel', 166, 26, { facing: 2 }], ['crate', 22, 120, { facing: .3 }], ['cart', 72, 26, { facing: 0 }]];\nfor (const [id, x, y, o] of DRESS) map.solid(id, x, y, 0, o);\nconst GEM = E.sprite(['.c.', 'cCc', '.c.'], { c: '#48c8f0', C: '#e8faff' }, 2);\nlet hero, heroRig, guard, guardRig, alert, got, won;\n\nfunction reset() {\n  const h = map.find('hero'), g = map.find('guard');\n  hero = new E.Mover({ x: h.x, y: h.y, r: 5, climbAny: true, climbMax: 24, glide: true, staminaMax: 100 }); hero.facing = 0;   // (the roof, 32 high, is climbed)\n  heroRig = heroRig || new E.Humanoid({ size: 1.2, build: 'heroic', weapon: null, hood: true, outfit: 'coat', colors: { cloth: '#3a4a6a', cape: '#2a3a52' } });\n  guard = new E.Body({ x: g.x, y: g.y, r: 5 }); guard.facing = 0; guard.dir = 1;\n  guardRig = guardRig || new E.Humanoid({ size: 1.2, build: 'heroic', weapon: 'sword', hat: 'helmet', colors: { cloth: '#8a3a32' } });\n  alert = 0; got = false; won = false;\n}\n\nconst title = {\n  update() { if (game.input.pressed('start')) { reset(); game.go('play'); } },\n  draw(r) {\n    r.sky(['#141030', '#3a2a60']);\n    const m = Math.round(r.H / 2);   // centred on any screen\n    r.overlay(g => E.font.title(g, 'ROOFTOP', r.W / 2, m - 52, { scale: 3, align: 'center' }));\n    r.text(('CLIMB WITH ' + game.input.label('jump') + '  TAKE THE GEM  STAY UNSEEN').toUpperCase(), r.W / 2, m + 8, '#e8e0ff', { align: 'center' });\n    r.text(('PRESS ' + game.input.label('start')).toUpperCase(), r.W / 2, m + 38, '#ffffff', { align: 'center', shadow: '#000' });\n  }\n};\n\nconst play = {\n  pausable: true,\n  enter() { game.follow(hero, { z: 16 }); game.cam.bounds = v => map.bounds(v); game.lights.enabled = true; game.lights.ambient = .5; },\n  exit() { game.lights.enabled = false; ui.hud({}); },\n  update(dt) {\n    const I = game.input, was = !!(hero.wall || hero.action);\n    hero.update(dt, map, I);   // walks, jumps, climbs: the stick and the jump button, through the view\n    if (!was && (hero.wall || hero.action)) game.audio.sfx('jump');\n    // the guard walks the street and watches ahead: its eyes see over the planter, not through the roof\n    guard.vx = guard.dir * 30; guard.update(dt, map);\n    if (guard.x > 112 || guard.hitWall) guard.dir = -1; else if (guard.x < 40) guard.dir = 1;\n    guard.facing = guard.dir > 0 ? 0 : Math.PI;\n    const sees = map.sight(guard, hero) && E.inArc(guard, guard.facing, hero, 110, .6);\n    alert = sees ? alert + dt : Math.max(0, alert - dt * .5);\n    const gem = map.find('gem');\n    if (!got && E.dist(hero, { x: gem.x, y: gem.y, z: ROOF }) < 12) { got = true; game.audio.sfx('coin'); game.flash('#c8f4ff', .15); }\n    if (got && hero.z < 2) { won = true; game.go('end'); }   // back down in the street with it\n    else if (alert > 1.2) { won = false; game.audio.sfx('hurt'); game.go('end'); }\n    // the rigs are posed every step from the bodies' motion; draw only draws them\n    heroRig.update(dt, hero.rigState());\n    guardRig.update(dt, { x: guard.x, y: guard.y, z: guard.z, vx: guard.vx, vy: 0, facing: guard.facing, stance: 'ready' });\n    // the HUD, from this step's state (E.Shell redraws only what changed; the keys hide on a touch screen)\n    ui.hud({ objective: got ? { title: 'Bring it down', text: 'Back to the street with it' } : { title: 'Take the gem', text: hero.wall ? 'Climb: up, and jump to leap' : 'It lies on the roof', at: { x: gem.x, y: gem.y, z: ROOF }, from: hero },\n      bars: [{ label: 'Seen', value: Math.min(alert, 1.2), max: 1.2, color: '#ff6040' }, { label: 'Stamina', value: hero.stamina, max: hero.staminaMax, color: hero.exhausted ? '#ff6040' : '#7ad06a' }],\n      keys: [[['up', 'left', 'down', 'right'].map(a => I.label(a)).join(''), 'Move'], [I.label('jump'), 'Jump, climb, glide']] });\n  },\n  draw(r) {\n    map.drawFloor(r); map.queueWalls(r);   // (the floor runs on past the map to the screen's edges: map.outside)\n    for (const [id, x, y, o] of DRESS) r.shape(id, x, y, 0, o);\n    r.prop('lamp', 88, 88, 0, { light: true });   // a street lamp: its glow and a pool of light\n    r.decal(() => r.groundArc(guard.x, guard.y, 6, 110, guard.facing - .6, guard.facing + .6, alert > 0 ? '#ff6040' : '#ffe080', .4));   // its sight cone\n    const gem = map.find('gem');\n    if (!got) { r.sprite(gem.x, gem.y, ROOF + 6 + Math.sin(game.time * 3) * 2, GEM, { glow: .8 }); game.lights.add(gem.x, gem.y, ROOF + 6, 44, .9, { color: '#80d8ff' }); }\n    if (hero.gliding) r.queue(hero.x, hero.y, hero.z + 40, g => {   // the sail, over the hands the rig holds up\n      const c = Math.cos(hero.facing), s = Math.sin(hero.facing), P = (f, w, z) => r.w(hero.x + c * f - s * w, hero.y + s * f + c * w, hero.z + z);\n      const q = [P(9, -17, 43), P(9, 17, 43), P(-7, 15, 37), P(-7, -15, 37)], h = P(0, 0, 30);\n      for (const t of [q[0], q[1]]) E.px.line(g, t[0], t[1], h[0], h[1], '#3a2a20');\n      E.px.poly(g, q, '#d8603a'); E.px.line(g, q[0][0], q[0][1], q[1][0], q[1][1], '#f4a070');\n    });\n    for (const [b, rig] of [[hero, heroRig], [guard, guardRig]]) {\n      r.shadow(b.x, b.y, 7, .35, undefined, b.groundZ || 0);\n      r.actor(b.x, b.y, b.z, (g, ox, oy) => rig.draw(g, ox, oy, r.view));\n    }\n  }\n};\n\nconst end = {\n  update() { if (game.input.pressed('start')) { reset(); game.go('play'); } },\n  draw(r) {\n    r.sky(won ? ['#103020', '#2a6a48'] : ['#301010', '#6a2a2a']);\n    const m = Math.round(r.H / 2);\n    r.overlay(g => E.font.title(g, won ? 'STOLEN' : 'CAUGHT', r.W / 2, m - 42, { scale: 3, align: 'center' }));\n    r.text(('PRESS ' + game.input.label('start') + ' TO TRY AGAIN').toUpperCase(), r.W / 2, m + 28, '#ffffff', { align: 'center', shadow: '#000' });\n  }\n};\n\nreset();\n// a handle for tests and tools (node game/test.mjs, tools/check.mjs prints snapshot(), tools/replay.mjs logs it)\ngame.debug = {\n  snapshot: () => ({ scene: game.sceneName, hero: [hero.x, hero.y, hero.z].map(v => Math.round(v * 10) / 10), climbing: !!(hero.wall || hero.action),\n    guard: [Math.round(guard.x), Math.round(guard.y), guard.facing], alert: Math.round(alert * 100) / 100, got, won }),\n  teleport(x, y, z = 0, facing = hero.facing) { Object.assign(hero, { x, y, z, vx: 0, vy: 0, vz: 0, onGround: true, facing, wall: null, action: null }); }\n};\ngame.start({ scenes: { title, play, end }, scene: 'title' });\n})();\n// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);","stderr":"\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181313__x3ec78e/work","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013B7ghTiNz6d64Ck7Wqni2z","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgf7QJubLGE9vPFE4QrLv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WPRH66raZsuhECWvrfCpTv","name":"Read","input":{"file_path":"/tmp/x3ec78e/my-3d2dge/dist/handoff/kits/adventure.js"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5661,"cache_read_input_tokens":73512,"cache_creation":{"ephemeral_5m_input_tokens":5661,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"70b9b3fb-a482-4430-a756-95fe6fe59945","uuid":"f61ea06c-6cfd-4989-8287-67c10af9e832","timestamp":"2026-11-03T01:16:28.365Z","request_id":"req_011Cgf7QJYGekn544fkBN1hW","wire_tool_inputs":{"toolu_01WPRH66raZsuhECWvrfCpTv":{"file_path":"/tmp/x3ec78e/my-3d2dge/dist/handoff/kits/adventure.js"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WPRH66raZsuhECWvrfCpTv","type":"tool_result","content":"1\t// The ADVENTURE kit's game (a top-down action adventure: a village, ruins and a shrine, a sword, a key and a great door, talk with portraits; Zelda and Secret of Mana), readable: the starter's shell (src/starter/00-shell.js), then\n2\t// the slice from line 159 (src/starter/10-adventure.js: its header says what it plays and how), then the start (90-start.js), as the\n3\t// single-file kit holds them between GAME START and GAME END. adventure.html plays it; node kits/test.mjs adventure runs it headless.\n4\t/* ============================== GAME START ==============================\n5\t * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n6\t * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n7\t * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n8\t * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n9\t * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n10\t * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n11\t * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n12\t * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n13\t * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n14\t * ======================================================================== */\n15\t(() => {\n16\t'use strict';\n17\tconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n18\t\n19\t/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n20\t * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\n21\tconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\n22\tconst P = game.particles, L = game.lights, A = game.audio;\n23\tconst scenes = {};\n24\tlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\n25\tconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n26\t// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n27\t// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\n28\tconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n29\t// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\n30\tconst SLICES = [\n31\t  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n32\t  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n33\t  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n34\t  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n35\t  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n36\t  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n37\t  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n38\t  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n39\t  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n40\t  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n41\t  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n42\t  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n43\t  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n44\t  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n45\t  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n46\t  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n47\t  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n48\t  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n49\t  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n50\t  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n51\t  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n52\t  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n53\t];\n54\t/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n55\t   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n56\t   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n57\t   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\n58\tconst camOpt = () => (game.scene && game.scene.camera) || {};\n59\taddEventListener('keydown', e => {\n60\t  if (e.repeat) return;\n61\t  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n62\t  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n63\t  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n64\t  else if (e.code === 'KeyM') A.mute();\n65\t  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n66\t});\n67\t\n68\t/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n69\t * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\n70\tconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n71\t  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\n72\tconst titleBg = new E.Backdrop('castle-night');\n73\tconst HEROES = [   // six heroes, each dressed with the HD rig options\n74\t  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n75\t  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n76\t  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n77\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n78\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n79\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n80\t];\n81\tHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n82\t// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\n83\tconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n84\t// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\n85\tconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n86\t/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n87\t * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n88\t * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n89\t * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n90\t * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\n91\tconst proof = (id, n, script, state, fresh) => {\n92\t  const was = Math.random, I = game.input, held = new Set();\n93\t  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n94\t  Math.random = E.rng(7);\n95\t  try {\n96\t    if (fresh) fresh();\n97\t    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n98\t    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n99\t    const s = JSON.stringify(state()); let h = 2166136261;\n100\t    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n101\t    return h >>> 0;\n102\t  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n103\t};\n104\t// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\n105\tconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n106\t// START picks too (the touch START, a pad's Start), as Enter does: any player's\n107\tconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n108\t/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n109\t *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\n110\tconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\n111\tlet titleMenu = null;   // (made at the start, once the file's slices are known)\n112\tscenes.title = {\n113\t  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n114\t  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n115\t  update(dt) {\n116\t    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n117\t    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n118\t    const t = game.time;\n119\t    HEROES.forEach((h, i) => {\n120\t      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n121\t      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n122\t    });\n123\t  },\n124\t  draw(r) {\n125\t    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n126\t    titleMenu.y = 76 + top;\n127\t    titleBg.draw(r);\n128\t    stage.draw(r);\n129\t    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n130\t    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n131\t    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n132\t    r.overlay(g => {\n133\t      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n134\t      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n135\t      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n136\t    });\n137\t    titleMenu.draw(r);\n138\t    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n139\t      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n140\t    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n141\t  }\n142\t};\n143\t\n144\t/* ---- GAME OVER: shared by every slice ---- */\n145\tconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\n146\tconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n147\t  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\n148\tscenes.over = {\n149\t  view: 'side', input: 'DEFAULT', res: 'ps1',\n150\t  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n151\t  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n152\t  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n153\t  draw(r) {   // centred on any screen\n154\t    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n155\t    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n156\t  }\n157\t};\n158\t\n159\t/* =====================================================================================\n160\t * SLICE 1  ADVENTURE  (Secret of Mana, Zelda: ALttP). Three rooms: village, ruins, shrine. Talk, clear the ruins for\n161\t * the key, open the great door, claim the crystal. THE LOOK: wall MATERIALS, ONE floorTex with PAINTED LIGHT, pitched\n162\t * roofs, leaf-clump bushes, light shafts, dialog PORTRAITS.\n163\t * KEYS: WASD or arrows move, J or X swings the sword, Enter or Space talks. TOUCH: the stick, ATTACK, CONFIRM.\n164\t * ANY SCREEN: rooms are 4:3 in a world that goes on past them (forest above and below, the next rooms beside), so a\n165\t * screen of any shape is filled. CAMERA (Settings, or C): ROOMS slides screen by screen as Zelda's does, the rooms beside\n166\t * this one under a dim CURTAIN (they wait, as their monsters do); SCROLL follows the hero. The HUD sits in the corners.\n167\t * ===================================================================================== */\n168\tconst ADV = (() => {\n169\t  const T = 16, ROOM = [14 * T, 12 * T], AREAS = ['Mana Village', 'Mossy Ruins', 'Shrine of Mana'];\n170\t  const ROWS = [\n171\t    // village          ruins             shrine\n172\t    ['^^^^^^^^^^^^^^', 'RRRRRRRRRRRRRR', 'XXXXXXXXXXXXXX'],\n173\t    ['^^#^^^^^^^^#^^', 'RHhJKFYDYFKhHR', 'XwjiXnWXnXijwX'],\n174\t    ['#UUUU.ZZZZ.~~#', 'R.u..qv.vq.S.R', 'X.S*.B..B.*S.X'],\n175\t    ['#GQOQbzNzZu~~#', 'H.KK....x....H', 'X.....rA.....X'],\n176\t    ['#ccccV~ccLe~~#', 'K..s.q::::.s.H', 'X..I..++..I..X'],\n177\t    ['#cM@cPccac=~~#', 'H.....::::k..K', 'X....m++m....X'],\n178\t    ['#,,,,,,,,,,__,', ',,....::C:...H', 'X4.I..++..I.4X'],\n179\t    ['#.b...b.g,d__,', ',,..o.::::.s.H', 'X.....++.....X'],\n180\t    ['#...%%%f..s~~#', 'Hb.K..::::q.KH', 'X..I..++..I..X'],\n181\t    ['#T..%%%.u..~~#', 'H.u..s....y.RH', 'X.p...++...p.X'],\n182\t    ['#.3........~~#', 'H...bK...b.xRH', 'X.....E+.....X'],\n183\t    ['##############', 'RRRRRRRRRRRRRR', 'XXXXXX++XXXXXX']\n184\t  ].map(r => r.join(''));\n185\t  // the world AROUND the rooms: PAD rows of forest canopy above and below (a meadow's edge first, the shrine's stone under\n186\t  // the shrine), so a screen of any shape is filled. The rooms' rows start at OY\n187\t  const PAD = 12, OY = PAD * T, wood = (cx, cy) => cx >= 28 ? 'X' : E.hash2(cx * 7, cy * 5) < .18 ? '2' : '1';\n188\t  const AROUND = (cy0, meadow) => Array.from({ length: PAD }, (_, i) => Array.from({ length: 42 }, (_, cx) => meadow && i < 2 && cx < 28 ? '.' : wood(cx, cy0 + i)).join(''));\n189\t  ROWS.unshift(...AROUND(0)); ROWS.push(...AROUND(PAD + 12, true));\n190\t  const LEGEND = {\n191\t    // walls: a wall type (TYPES), or { tile, spawn } = a wall with a prop on its face (THINGS)\n192\t    '#': 1, 'U': 5, 'Z': 8, 'R': 9, 'H': 3, 'K': 4, 'F': 6, 'X': 2, 'A': 7, '1': 10, '2': { tile: 10, spawn: 'tree' },\n193\t    '^': { tile: 1, spawn: 'tree' }, 'G': { tile: 5, spawn: 'ivy' }, 'Q': { tile: 5, spawn: 'pane' }, 'O': { tile: 5, spawn: 'door' },\n194\t    'z': { tile: 8, spawn: 'pane' }, 'N': { tile: 8, spawn: 'shop' }, 'h': { tile: 3, spawn: 'vines' }, 'J': { tile: 3, spawn: 'cobweb' }, 'Y': { tile: 6, spawn: 'moss' }, 'D': { tile: 6, spawn: 'gate' },\n195\t    'w': { tile: 2, spawn: 'window' }, 'W': { tile: 2, spawn: 'rose' }, 'i': { tile: 2, spawn: 'torch' }, 'n': { tile: 2, spawn: 'banner' }, 'j': { tile: 2, spawn: 'cobweb' }, 'r': { tile: 7, spawn: 'relic' },\n196\t    // floors: a tag for floorTex; block = not walkable\n197\t    ',': { floor: 'path' }, 'c': { floor: 'plaza' }, '~': { floor: 'water', block: true }, '_': { floor: 'bridge' }, ':': { floor: 'pave' }, '+': { floor: 'carpet' }, '%': { floor: 'bed' },\n198\t    '@': { floor: 'plaza', spawn: 'hero' }, 'M': { floor: 'plaza', spawn: 'elder' }, 'P': { floor: 'plaza', spawn: 'pot' }, 'L': { floor: 'plaza', spawn: 'lamp' },\n199\t    'V': { floor: 'water', block: true, spawn: 'fountain' }, 'C': { floor: 'pave', spawn: 'chest' }, 'E': { floor: 'carpet', spawn: 'entry' }, 'd': { floor: 'path', spawn: 'villager' },\n200\t    // people, creatures and props\n201\t    'f': 'florist', 'a': { floor: 'plaza', spawn: 'cat' }, 's': 'rabite', 'v': 'bat', 'k': 'goblin', 'm': 'mage', 'b': 'bush', 'p': 'pot', 'T': 'oak', 'g': 'sign', 'u': 'mushroom',\n202\t    'e': 'barrel', '=': 'crate', '3': 'stump', '4': 'obelisk', 'q': 'ruin', 'I': 'pillar', 'S': 'statue', 'o': 'rock', 'x': 'crystal', 'y': 'skull', 'B': 'brazier', '*': 'candelabra'\n203\t  };\n204\t  // wall MATERIALS: face = side, roof = top pattern (beam = timber); cut = lowered to cutH in front of the camera\n205\t  const SLAB = { face: 'stone', roof: 'slab' }, TYPES = {\n206\t    1: { h: 16, cut: true, cutH: 7, face: 'hedge', roof: 'leaves', top: '#3f8c3c', side: '#2e6a34' },   // hedge\n207\t    2: { h: 34, cut: true, cutH: 8, ...SLAB, top: '#4e4670', side: '#6a6294', course: 9 },   // shrine stone\n208\t    3: { h: 26, cut: true, cutH: 8, face: 'ruin', roof: 'slab', top: '#7a8a66', side: '#8e8a98' },   // ruin wall, mossy top: the 'ruin' MATERIAL (stones, cracks, moss, dirt; docs/ASSETS.md)\n209\t    4: { h: 12, cut: true, ...SLAB, top: '#72845e', side: '#8e8a98', course: 6 },   // crumbled ruin\n210\t    5: { h: 36, face: 'timber', roof: 'tiles', top: '#c4583a', side: '#f0e0c0', beam: '#6a4228' },   // cottage\n211\t    6: { h: 36, ...SLAB, top: '#5a5480', side: '#7a7298', course: 9 },   // shrine facade\n212\t    7: { h: 9, ...SLAB, top: '#8a84b4', side: '#5a5484', course: 4 },   // altar\n213\t    8: { h: 36, face: 'plaster', roof: 'tiles', top: '#3a7ab4', side: '#f4e6c8' },   // shop\n214\t    9: { h: 30, cut: true, cutH: 8, face: 'rock', roof: 'grass', top: '#5a9a44', side: '#8a7462' },   // cliff\n215\t    10: { h: 22, face: 'hedge', roof: 'leaves', top: '#2c6a36', side: '#1f4a2a' }   // the forest round the rooms\n216\t  };\n217\t  // set dressing: tag -> prop(s). r = solid, cut = breakable (debris), drop = loot, face = on the wall at z (anchor\n218\t  // 'top' hangs it), light = GPU light, dx = nudge, hidden = appears later; shape = a SHAPE (E.SHAPES, docs/ASSETS.md:\n219\t  // right in every view and turn, no drawing code) in place of a prop, size its scale\n220\t  const THINGS = {\n221\t    // village\n222\t    door: [{ face: true, size: 1.1, color: '#7a4222' }, { prop: 'lantern', face: true, z: 33, dx: 14, anchor: 'top', light: '#ffb060' }],\n223\t    shop: [{ prop: 'door', face: true, size: 1.1, color: '#2a4a7a' }, { prop: 'awning', face: true, z: 23, size: .95, color: '#d8483a' }],\n224\t    pane: { prop: 'window', face: true, z: 12, size: .65, color: '#6a4424', colors: ['#fff0b0', '#ffd070'] }, ivy: { prop: 'vines', face: true, z: 35, anchor: 'top', color: '#3a8a3a', blossom: '#f890b0' },\n225\t    fountain: { prop: 'statue', size: .8, color: '#a8a6c0', dx: 8 }, lamp: { prop: 'streetlamp', r: 3, size: .8, halo: false }, oak: { prop: 'tree', size: 1.45, r: 8 },   // lamp: unlit by day\n226\t    bush: { r: 6, cut: ['#2f7a34', '#5ab04a', '#9ad86a'] }, pot: { size: .95, r: 5, cut: ['#7a3a22', '#c07040', '#e8a878'], drop: 'gem' }, sign: { r: 4 },\n227\t    mushroom: { size: .75, color: '#e0503a' }, barrel: { shape: 'barrel', r: 5, size: .75 }, crate: { shape: 'crate', r: 6, size: .65 },\n228\t    // from the asset store, cut into the page's 'adventure' set (src/assets/sets/adventure.js); without it, props\n229\t    ...(E.addAssets((window.ASSETS || {}).adventure || { set: 'adventure' }).shapes.length ? { stump: { shape: 'adventure:stump-round', r: 5, size: .7 },\n230\t      obelisk: { shape: 'adventure:pillar-obelisk', r: 6, size: .8 } } : { stump: { prop: 'rock', r: 5, color: '#8a5a3a' }, obelisk: { prop: 'pillar', r: 6 } }),\n231\t    // ruins\n232\t    vines: { face: true, z: 25, anchor: 'top', color: '#4a8a3a', blossom: '#f890b0' }, moss: { prop: 'vines', face: true, z: 35, anchor: 'top', size: .8, color: '#5a8a3a', blossom: '#f890b0' },\n233\t    gate: { prop: 'door', face: true, size: 1.1, color: '#5a3a6a' }, ruin: { prop: 'pillar', broken: true, r: 7 }, rock: { r: 5, color: '#8a8698' }, skull: { prop: 'bones' },\n234\t    crystal: { r: 4, light: '#5ad8f0' }, chest: { r: 6, hidden: true },\n235\t    // shrine\n236\t    window: { face: true, z: 7, size: .8, colors: ['#e05a6a', '#5a8ae8', '#f0c85a', '#6ad08a'], light: '#8ab0ff' }, torch: { face: true, z: 14, light: '#ff9a4a' },\n237\t    rose: { prop: 'window', face: true, z: 2, size: 1, dx: 8, colors: ['#e8c85a', '#c04aa0', '#5a8ae8'], light: '#c8a0ff' }, banner: { face: true, z: 8, size: .8, color: '#8a1a3a', emblem: '#e8c04a' },\n238\t    cobweb: { face: true, z: 34, anchor: 'top', size: .9 }, pillar: { r: 7 }, statue: { r: 6, color: '#9a98b0' }, brazier: { r: 5, size: .9, light: '#ff9a4a' }, candelabra: { r: 3, size: .8, light: '#ffc060' }\n239\t  };\n240\t  // palettes: E.ramp(hex, n, strength) = n hue-shifted shades, dark to light\n241\t  const rgb = hexes => hexes.map(E.hex), R5 = (c, s = .6) => rgb(E.ramp(c, 5, s)), FLAG = (s, mortar) => ({ stones: s.slice(1, 4), mortar, hi: s[4], lo: s[0], speck: s[1] });\n242\t  const GRASS = [['#4c9a3e', '#5aa640', '#6cb44c'], ['#42804a', '#4a8a48', '#5a9a4e']].map(room => room.map(c => R5(c))), DIRT = R5('#b08652', .7), WATER = R5('#2a7ac4', .9), STONE = R5('#a49a8a', .7), SOIL = R5('#6e4a34');\n243\t  const PLAZA = FLAG(R5('#b4a894'), E.hex('#6a5e52')), PAVE = FLAG(R5('#8a8a96'), E.hex('#3a3a3e')), TILE = [R5('#5a5688'), R5('#403c68')], PETAL = rgb(['#ffffff', '#ffe070', '#f890b0']);\n244\t  const CARPET = rgb(E.ramp('#9a2438', 4)), GOLD = rgb(E.ramp('#d8a840', 3)), RUNE = [...E.hex('#6ae8e0'), .35], LILY = R5('#4aa050');   // 4th value = GPU glow\n245\t  const SKY = rgb(['#a8dcf4', '#e8f8ff']), REFLECT = E.hex('#1e5a5a');   // sky glints, the hedge's reflection\n246\t  const TUFT = ['.l.l.', '.dld.', '..d..'], BLOOM = ['.w.', 'wyw', '.w.'];   // grass stamps\n247\t  const MOOD = [[.92, .9, .84], [.8, .88, .8], [.34, .3, .46]];   // GPU ambient light per room\n248\t  const mood = m => { if (gpu) gpu.ambient = m; L.ambient = (m[0] + m[1] + m[2]) / 3; };   // (and the canvas lighting's, where WebGPU is missing and it stands in)\n249\t  // light shafts per room: beam x, tint (a dark tint = a faint beam), lean\n250\t  const BEAMS = [[[34, 128, 196], '#7a5a26', 60], [[50, 150], '#566a22', 60], [[24, 120, 200], '#4a3a8a', 12]];\n251\t  const WIN = { bg: ['#3a4a9e', '#12163e'], border: '#f0e0a8' }, FACE_BG = ['#7aa4e8', '#1e2a66'];\n252\t  // pixel sprites ('.' = transparent)\n253\t  const GEM = E.sprite(['..g..', '.gGg.', 'gGWGg', 'gGGGg', 'dgGgd', '.dgd.', '..d..'], { g: '#1e9a3a', G: '#56e070', W: '#e8fff0', d: '#0e5a24' });\n254\t  const HEART = E.sprite(['.R.R.', 'RWRRR', 'RRRRR', '.RRR.', '..R..'], { R: '#e8384a', W: '#ffd0d6' });\n255\t  const KEYS = [1, 2].map(s => E.sprite(['.yy....', 'y..y...', 'Y..Yyyy', '.YY..y.', '.....yY'], { y: '#f8d048', Y: '#b07818' }, s));   // scale 2: held up high\n256\t  const CRYSTALS = [1, 2].map(s => E.sprite(['....w....', '...wWc...', '..wWWcc..', '.wWWWccC.', 'wWWWccccC', '.wWWcccC.', '.cWWccCC.', '..cWcCC..', '..ccCC...', '...cC....'], { w: '#f0ffff', W: '#a8f0ff', c: '#4ac8e8', C: '#2a5ab0' }, s));\n257\t\n258\t  // THE CAST: chibi rigs, anime eyes, own outfits and palettes; the hero's cape is SECONDARY MOTION\n259\t  const RIGS = {\n260\t    hero: () => new E.Humanoid({ size: 1.3, outfit: 'tunic', hair: 'spiky', face: { eyes: 'big', bangs: .8 }, cape: { len: 4, width: 3.2, seg: 2.2 },\n261\t      colors: { skin: '#f8cca4', hair: '#e8902c', cloth: '#3a8a4a', trim: '#f0d070', pants: '#4a3a5a', boot: '#8a4a26', belt: '#6a3a1a', glove: '#7a5238', eye: '#3a2a6a', cape: '#d0483a', capeIn: '#7a1e2e' } }),\n262\t    elder: () => new E.Humanoid({ size: 1.2, weapon: 'staff', outfit: 'robe', hair: 'short', sleeves: 'long', hunch: .45, hat: { style: 'pointed', color: '#3e3278' }, face: { eyes: 'big', bangs: .35 },\n263\t      colors: { skin: '#f0c4a8', hair: '#b8b2c4', cloth: '#5a4a9a', trim: '#f0cc60', belt: '#f0cc60', boot: '#4a3a2a', eye: '#2a2a4a' } }),\n264\t    florist: () => new E.Humanoid({ size: 1.15, weapon: null, outfit: 'robe', sleeves: 'long', hair: 'ponytail', face: { eyes: 'big', bangs: 1 },\n265\t      colors: { skin: '#f8cca4', hair: '#b0482a', cloth: '#d86a8a', trim: '#f4a8c0', belt: '#fff0d0', pants: '#d86a8a', boot: '#6a3a2a', eye: '#2a5a3a' } }),\n266\t    villager: () => new E.Humanoid({ size: 1.1, weapon: null, hair: 'short', hat: { style: 'band', color: '#d8483a' }, face: { eyes: 'big', bangs: .7 }, shoulderHalf: 4.6, armUpper: 5.2, armLower: 5,   // the wave clears his face\n267\t      colors: { skin: '#f0c090', hair: '#6a3a1e', cloth: '#e8a83a', trim: '#fff0d0', pants: '#4a5a8a', boot: '#6a4a2a', belt: '#6a4a2a', eye: '#2a3a5a' } }),\n268\t    goblin: () => new E.Humanoid({ size: 1.1, build: 'bulky', weapon: null, outfit: 'tunic', hair: 'bald', eyeGlow: '#ffd84a',\n269\t      colors: { skin: '#8ab84a', cloth: '#8a5a32', trim: '#c8a040', pants: '#4a3a2a', boot: '#3a2a1a', belt: '#3a2a1a' } }),\n270\t    mage: () => new E.Humanoid({ size: 1.3, build: 'heroic', weapon: 'staff', outfit: 'robe', hood: true, sleeves: 'long', eyeGlow: '#ff6ab0',\n271\t      colors: { skin: '#c8b8e0', hair: '#2e2450', cloth: '#4a3a86', trim: '#d070f0', belt: '#d070f0', boot: '#1a1628', orb: '#ff80e0' } })\n272\t  };\n273\t  // BLOB CREATURES: a round body plus parts\n274\t  const RABITE = { dk: '#b0703a', base: '#f4d49a', lt: '#fff4dc', pupil: '#5a1a2a', inner: '#f09aa8', ext: '#d8a060' };\n275\t  const BAT = { dk: '#2e1a44', base: '#6a4a9a', lt: '#a890d0', eye: '#fff0a0', pupil: '#c02020', wing: '#4a2a6a', inner: '#e08aa0' };\n276\t  const CAT = { dk: '#9a5028', base: '#f0a050', lt: '#ffd8a0', pupil: '#2a4a1a', inner: '#f8b0b0', ext: '#fff0e0' };\n277\t  const FOES = {   // hp (a hit does 8-12), look, moves (E.MOVES with a long, deep wind-up: the TELL)\n278\t    rabite: { hp: 18, look: () => new E.Blob({ R: 5.5, colors: RABITE, ears: 'rabbit', feet: true, tail: true, mouth: true, face: 'front' }) },\n279\t    bat: { hp: 12, fly: 17, look: () => new E.Blob({ R: 4.5, colors: BAT, wings: true, ears: 'cat', mouth: 'fangs', face: 'front' }) },\n280\t    goblin: { hp: 40, look: RIGS.goblin, moves: ['claw', 'twohand'], tune: { wind: .34, crouch: 1, lean: .9 } },   // a raking claw, a two-fist SLAM\n281\t    mage: { hp: 30, look: RIGS.mage, moves: ['cast'], tune: { wind: .6, lean: .6 } }   // leans back to raise, recoils forward to release\n282\t  };\n283\t  // spins at the waist; CHARGE: the spin's wind-up, deeper\n284\t  const WAIST = { z0: -10, z1: -10 }, CHARGE = { ...E.MOVES.spin, ...WAIST, a0: 2.4, crouch: .6, lean: .6 };\n285\t  // idle: poses in turn; near: turn to the hero (wave: say hello); talk: gestures; chore: a move while kneeling\n286\t  const NPCS = {\n287\t    elder: { name: 'ELDER', idle: [null, null, 'hips'], near: 56, talk: ['block', null, 'hips', null], lines: [() => 'Rabites overran the Mossy Ruins across the river. Press ' + game.input.label('attack') + ' to swing your sword and clear them out!',\n288\t      'Clear the ruins and the old chest opens. The Mana crystal sleeps in the shrine behind the great door.'] },\n289\t    florist: { name: 'LISE', face: Math.PI, idle: ['kneel', 'kneel', null], near: 36, talk: ['hips', 'cast'],   // tends the flower bed\n290\t      chore: () => new E.Attack('plunge', { hand: 'both', a0: -.5, a1: -.9, r0: 4, r1: 9, wind: .3, active: .16, recover: .45 }),\n291\t      lines: ['A rabite got into my garden again! Could you shoo it away?', 'Mind the bats in the ruins. They swoop when you get close!'] },\n292\t    villager: { name: 'PIP', idle: [null, 'hips'], near: 50, wave: true, talk: ['hips', null], lines: ['Hi! The bridge leads to the Mossy Ruins.', () => 'Keep ' + game.input.label('attack') + ' held after a swing, then let go: a SPIN ATTACK!'] }   // a function: the player's own key\n293\t  };\n294\t  // BACKDROP (iso view): a sea of clouds\n295\t  const bg = new E.Backdrop({ sky: ['#3a74c8', '#8ac2ea', '#e4f2f4', '#9ccae6', '#5a90c8'], layers: [{ kind: 'clouds', color: '#ffffff', y: .3, height: .16, parallax: .04, drift: 3 },\n296\t    { kind: 'clouds', color: '#ffffff', y: .98, height: .4, parallax: .1, drift: 3, seed: 9 }] });\n297\t  let map, relic, entry, hero, npcs, foes, pets, items, things, roofs, shots, talk, speaker, won, keys, gems, area, held, fx;\n298\t  // CAMERA, the player's choice: 'rooms' slides screen by screen (Zelda), 'scroll' follows the hero (Settings, or C)\n299\t  game.settings.define({ key: 'advCamera', group: 'Adventure', label: 'Camera', options: [['rooms', 'Rooms'], ['scroll', 'Scroll']], value: 'rooms', help: 'Rooms: screen by screen, as Zelda. Scroll: it follows the hero' });\n300\t  // LIGHTING: GPU lights (pools of light and shadows, WebGPU) draw every frame twice and light each pixel: a phone's frame\n301\t  // rate pays for them, so Auto keeps them for a computer (its main pointer a mouse or touchpad) and a phone gets Fast (the\n302\t  // floor is lit already): the main pointer, as a phone with a stylus has a fine one too\n303\t  const gpuWanted = () => game.settings.advLight === 'gpu' || (game.settings.advLight === 'auto' && !!(window.matchMedia && matchMedia('(pointer: fine)').matches));\n304\t  const lighting = () => { if (!map) return; if (gpuWanted() && !gpu) gpu = game.enableGPU({ map }); if (gpu) Object.assign(gpu, { map, enabled: gpuWanted(), bands: 24, wrap: .5 }); };\n305\t  game.settings.define({ key: 'advLight', group: 'Adventure', label: 'Lighting', options: [['auto', 'Auto'], ['gpu', 'GPU'], ['fast', 'Fast']], value: 'auto', help: 'GPU: pools of light and shadows (slow on a phone). Fast: smooth on a phone. Auto: GPU on a computer, Fast on a phone', apply: () => { if (game.sceneName === 'adventure') lighting(); } });\n306\t  addEventListener('keydown', e => { if (e.code !== 'KeyC' || e.repeat || game.sceneName !== 'adventure' || game.paused) return; const v = game.settings.advCamera === 'rooms' ? 'scroll' : 'rooms'; game.settings.set('advCamera', v); game.note('CAMERA: ' + v.toUpperCase()); });\n307\t  const sliding = () => !!game.cam.room && game.cam.moving;   // a room slide holds the world still\n308\t  const roomOf = x => Math.floor(x / ROOM[0]), mod = (a, n) => ((a % n) + n) % n, near = (cx, cy, tag) => map.floorAt((cx + .5) * T, (cy + .5) * T) === tag;\n309\t  const txt = (g, s, x, y, c, o) => E.font.text(g, s, x, y, c, { shadow: '#07040c', outline: false, ...o });\n310\t  const talkable = () => npcs.find(n => E.dist(hero, n) < 34);\n311\t  // CONTACT SHADOWS: a darker core in a soft ellipse, cool purple\n312\t  const shadow = (r, x, y, rad) => { r.shadow(x, y, rad, .28, '#2a2048'); r.shadow(x, y, rad * .6, .22, '#2a2048'); };\n313\t\n314\t  /* ---- FLOORS: floorTex(x, y, tag) = [r, g, b(, glow)], baked once per view ---- */\n315\t  // AUTOTILING: distance to the nearest side bordering another floor, corners rounded by K\n316\t  function edge(cx, cy, lx, ly, tag, K) {\n317\t    const o = (dx, dy) => { const t = map.floorAt((cx + dx + .5) * T, (cy + dy + .5) * T), c = map.cell(cx + dx, cy + dy); return tag === 'water' ? t !== tag && t !== 'bridge' && !c : t !== tag || c !== 0; };\n318\t    const a = Math.min(o(-1, 0) ? lx : 99, o(1, 0) ? T - lx : 99), b = Math.min(o(0, -1) ? ly : 99, o(0, 1) ? T - ly : 99);\n319\t    return a < K && b < K ? K - Math.hypot(K - a, K - b) : Math.min(a, b);\n320\t  }\n321\t  // GRASS: TUFT and BLOOM stamps on a staggered lattice in SCREEN pixels\n322\t  function grass(sx, sy, G) {\n323\t    const row = Math.floor(sy / 7), X = sx + (row & 1) * 6, k = E.hash2(Math.floor(X / 12), row), pat = k < .07 ? BLOOM : k < .62 ? TUFT : null;\n324\t    const ch = pat && (pat[mod(Math.floor(sy), 7) - 2] || '')[mod(Math.floor(X), 12) - (pat === BLOOM ? 5 : 4)];\n325\t    return ch === 'l' ? G[3] : ch === 'd' ? G[1] : ch === 'y' ? PETAL[1] : ch === 'w' ? PETAL[k < .035 ? 0 : 2] : G[2];\n326\t  }\n327\t  function ground(x, y, tag) {\n328\t    const cx = Math.floor(x / T), cy = Math.floor(y / T), lx = x - cx * T, ly = y - cy * T, room = roomOf(x), [sx, sy] = game.view.p(x, y), h = E.hash2(cx, cy);\n329\t    const e = tag && tag !== 'carpet' ? edge(cx, cy, lx, ly, tag, tag === 'water' ? 7 : tag === 'pave' ? 1 : 4) : 99;\n330\t    if (e < 0) tag = null;   // outside a rounded corner\n331\t    // WATER: bank, lip, shadow, reflection, foam, then depth BANDS bent by value noise\n332\t    if (tag === 'water') {\n333\t      if (e < 2.6) return e < 1 ? STONE[0] : E.hash2(Math.floor(y / 3), cx) < .2 ? STONE[1] : STONE[e < 1.8 ? 4 : 3];\n334\t      const w = (E.noise2(x / 6, y / 9) - .5) * 5, foam = near(cx, cy - 1, 'bridge') ? ly : near(cx, cy + 1, 'bridge') ? T - ly : 99;\n335\t      if (e < 3.3 || foam < 3 + w + E.hash2(Math.floor(sx / 2), 1) * 2) return foam < 1.5 + w ? SKY[1] : WATER[4];\n336\t      if (!near(cx - 1, cy, 'water') && lx < 6 + w) return WATER[0];\n337\t      if (map.cell(cx + 1, cy) > 0 && lx > 11 + w) return REFLECT;\n338\t      const px_ = lx - 4 - h * 8, py_ = ly - 4 - h * 7, pad = Math.hypot(px_, py_);\n339\t      if (h < .3 && pad < 3) return LILY[pad < 1 ? 4 : px_ > .5 && Math.abs(py_) < .5 ? 1 : 2];\n340\t      const k = mod(Math.floor(sx) + Math.floor(sy / 6) * 7, 23);   // sky glints on every 6th row\n341\t      return mod(Math.floor(sy), 6) === 0 && k < 4 ? SKY[k ? 0 : 1] : WATER[e + w < 8 ? 3 : e + w < 12 ? 2 : 1];\n342\t    }\n343\t    if (tag === 'bridge') return (ly < 2 && !near(cx, cy - 1, tag)) || (ly > T - 2 && !near(cx, cy + 1, tag)) ? DIRT[0] : E.tex.planks(y, x, { base: '#b07c44', dark: '#8a5c32', line: '#4a2e1a' });\n344\t    // path and paving: grass erodes the edge by a hash; dirt, pebbles\n345\t    const q = E.hash2(Math.floor(sx / 6), Math.floor(sy / 5)), b = E.hash2(Math.floor(x / 4), Math.floor(y / 4)) * 3;\n346\t    if (tag === 'path') return e < b ? grass(sx, sy, GRASS[room][1]) : e < b + .9 ? DIRT[0] : q < .16 && mod(Math.floor(sx), 6) < 2 && mod(Math.floor(sy), 5) === 0 ? DIRT[q < .07 ? 4 : 1] : DIRT[e < b + 1.8 ? 1 : 2];\n347\t    if (tag === 'plaza') return e < .9 ? PLAZA.mortar : E.tex.flagstone(x, y, PLAZA, 8);\n348\t    if (tag === 'bed') return e < 1 ? STONE[0] : e < 2.4 ? STONE[3] : SOIL[mod(ly, 4) < 1 ? 0 : 2];\n349\t    const c = Math.min(near(cx - 1, cy, tag) ? 99 : lx, near(cx + 1, cy, tag) ? 99 : T - lx), m = Math.abs(mod(x, 32) - 16) + Math.abs(ly - 8);   // carpet\n350\t    if (tag === 'carpet') return c < 1 ? CARPET[0] : c >= 2 && c < 3 ? GOLD[1] : m > 5 && m < 6.5 ? GOLD[0] : m < 2.5 ? GOLD[2] : CARPET[1];\n351\t    const f = E.tex.flagstone(x, y, PAVE);   // paving: moss in the seams\n352\t    if (tag === 'pave') return e < b ? grass(sx, sy, GRASS[1][1]) : e < b + .9 ? PAVE.mortar : f === PAVE.mortar && E.hash2(Math.floor(x / 6), Math.floor(y / 6)) < .45 ? GRASS[1][1][1] : f;\n353\t    const n = E.noise2(x / 40 + room * 9, y / 40);   // lawn: three shades in slow patches\n354\t    if (room < 2) return grass(sx, sy, GRASS[room][n < .36 ? 0 : n > .64 ? 2 : 1]);\n355\t    const dr = Math.hypot(x - relic.x, y - relic.y), a = Math.atan2(y - relic.y, x - relic.x), P = TILE[(cx + cy) & 1];\n356\t    if (Math.abs(dr - 15) < .7 || Math.abs(dr - 10.5) < .6 || (dr > 11 && dr < 14.5 && Math.abs(mod(a / Math.PI * 4, 1) - .5) < .06)) return RUNE;   // shrine: a rune circle...\n357\t    if (dr < 26) return dr > 24.8 ? TILE[1][0] : dr > 23.2 ? TILE[0][4] : TILE[dr < 20 ? 1 : 0][2];   // ...on a round dais with a lit rim...\n358\t    if (Math.min(lx, ly) < 1.2) return P[lx < .8 || ly < .8 ? 0 : 4];   // ...on marble tiles\n359\t    return lx > T - 1.2 || ly > T - 1.2 ? P[1] : mod(lx + ly, 13) < 1 ? P[3] : P[2];\n360\t  }\n361\t  // PAINTED LIGHT (Legend of Mana): a wall taller than its distance toward the low sun shades a point cool purple\n362\t  const SHADE = [.64, .68, .86];\n363\t  function floorTex(x, y, tag) {\n364\t    const c = ground(x, y, tag);\n365\t    for (let d = 2; d < 18; d += 2) if (map.heightAt(x - d, y - d * .3) > d * 1.8) return c.map((v, i) => i < 3 ? v * SHADE[i] : v);\n366\t    return c;\n367\t  }\n368\t\n369\t  // trees and pines varied by hashes\n370\t  const tree = (cx, cy, pine) => { const v = E.hash2(cx * 5, cy * 3); return { prop: pine || v > .72 ? 'pine' : 'tree', size: 1 + v * .45, color: ['#2f7a3c', '#3f8a45', '#2a6a44', '#4a8a3a'][Math.floor(v * 4)], x: (cx + .3 + E.hash2(cy, cx) * .4) * T }; };\n371\t  function start() {\n372\t    map = new E.TileMap({ rows: ROWS, legend: LEGEND, types: TYPES, floorTex, ao: 8 });\n373\t    relic = map.find('relic'); entry = map.find('entry'); relic.x += T / 2; entry.x += T / 2;   // on the room's center line\n374\t    // the camera stays inside the map (the forest round the rooms fills a tall screen); update() sets rooms or scroll\n375\t    game.cam.bounds = v => { const b = map.bounds(v); return { x0: b.x0 + 9, y0: b.y0 + 9, x1: b.x1 - 9, y1: b.y1 - 9 }; }; game.cam.room = game.settings.advCamera === 'scroll' ? null : ROOM;\n376\t    const at = map.find('hero');\n377\t    // SWORD (Secret of Mana): J chains slash, backslash, spin, kept low (a raised blade crosses his face); short holds (hold)\n378\t    // let the follow-through settle instead of freezing; hold J to CHARGE\n379\t    hero = Object.assign(new E.Body({ ...at, r: 4.5 }), { hp: 3, max: 3, facing: Math.PI / 2, inv: 0, hurt: 0, charge: 0, rig: RIGS.hero(),\n380\t      combo: new E.Combo([new E.Attack('slash', { z0: -8, z1: -11, a1: -1.2, wind: .12, hold: .1 }), new E.Attack('backslash', { z0: -11, z1: -9, a1: 1.2, hold: .1 }), new E.Attack('spin', { ...WAIST, hold: .15 })], { window: .3 }),\n381\t      spin: new E.Attack('spin', { ...WAIST, active: .36, reach: 10, lean: .3, hold: .12 }) });\n382\t    hero.sw = hero.combo;   // the attack running now\n383\t    npcs = Object.keys(NPCS).map(k => { const n = Object.assign({ said: 0, t: 0, k: 0, hi: 0, nod: 0, face: Math.PI / 2, rig: RIGS[k]() }, map.find(k), NPCS[k]); n.dir = n.look = n.face; n.job = n.chore && n.chore(); return n; });\n384\t    things = [];\n385\t    for (const s of map.spawns) for (const d of [].concat(s.tag === 'tree' ? tree(s.cx, s.cy) : THINGS[s.tag] || []))\n386\t      things.push(Object.assign({ tag: s.tag, prop: s.tag, x: s.x + (d.dx || 0), y: s.y, room: roomOf(s.x) }, d));\n387\t    // one pass over the cells: roofs, pines, weeds, flower beds, bridge rails, tufts\n388\t    const box = {};\n389\t    for (let cy = 0; cy < map.h - 1; cy++) for (let cx = 0; cx < map.w; cx++) {\n390\t      const c = map.cell(cx, cy), v = E.hash2(cx * 3, cy * 7 + 1), X = (cx + .5) * T, Y = (cy + .5) * T, tag = map.floorAt(X, Y), add = o => things.push(Object.assign({ x: X, y: Y }, o));\n391\t      if (c === 5 || c === 8) { const b = box[c] || (box[c] = [cx, cy, cx, cy]); b[2] = cx; b[3] = cy; }\n392\t      if (map.spawns.some(s => s.cx === cx && s.cy === cy)) continue;\n393\t      if (c === 9 && cy === PAD && v < .5) add(tree(cx, cy, true));\n394\t      else if ((c === 3 || c === 4) && v < .45) add({ prop: 'bush', size: .7 + v * .6, color: '#5a8a44' });\n395\t      else if (tag === 'bed') {\n396\t        for (const k of [-3, 3]) add({ prop: 'flowers', size: 1.1, x: X + k, y: Y + k, color: k < 0 ? ['#f06a9a', '#f0a040', '#ffffff'][cx % 3] : '#8ab0ff', color2: '#fff4a0' });\n397\t        if (!near(cx, cy + 1, 'bed')) add({ prop: 'fence', size: 1.2, y: Y + 8, color: '#b08050' });\n398\t      }\n399\t      else if (tag === 'bridge') for (const s of [-1, 1]) { if (!near(cx, cy + s, 'bridge')) add({ prop: 'fence', size: 1.2, y: Y + s * 7, color: '#8a5a32' }); }\n400\t      else if (!c && !tag && X < 2 * ROOM[0] && v < .16) add({ prop: v < .06 ? 'flowers' : 'grass', x: X + (E.hash2(cx, cy) - .5) * 10, y: Y + (E.hash2(cy, cx) - .5) * 8,\n401\t        color: v < .06 ? '#f06a9a' : X > ROOM[0] ? '#5a9a4a' : '#6ab850', color2: '#fff4a0' });\n402\t    }\n403\t    roofs = Object.keys(box).map(id => { const [a, b, c, d] = box[id]; return { x0: a * T, y0: b * T, x1: (c + 1) * T, y1: (d + 1) * T, h: TYPES[id].h, C: E.ramp(TYPES[id].top, 5) }; });\n404\t    items = [{ kind: 'relic', x: relic.x, y: relic.y }];\n405\t    // bats roost (hang; wake = time since); stun = flinch; dying = death; streak = claw marks; hold = an impact frame\n406\t    foes = Object.keys(FOES).flatMap(k => map.findAll(k)).map(s => { const F = FOES[s.tag], moves = (F.moves || []).map(m => new E.Attack(m, { recover: .45, hold: .5, ...F.tune }));\n407\t      return Object.assign(new E.Body({ ...s, r: 5.5, friction: 6, ...(F.fly && { z: F.fly + 8, gravity: 0, onGround: false }) }), { kind: s.tag, hp: F.hp, fly: F.fly, hang: !!F.fly, home: { ...s },\n408\t        t: 1 + Math.random(), flash: 0, stun: 0, swoop: 0, wake: 9, streak: [], face: Math.PI / 2, room: roomOf(s.x), look: F.look(), moves, atk: moves[0] }); });\n409\t    pets = map.findAll('cat').map(s => Object.assign(new E.Body({ ...s, r: 4 }), { t: 1, home: { ...s }, look: new E.Blob({ R: 4, colors: CAT, ears: 'cat', tail: true, feet: true, mouth: true, face: 'front' }) }));"}]},"parent_tool_use_id":null,"session_id":"70b9b3fb-a482-4430-a756-95fe6fe59945","uuid":"67cf2c95-ac65-424e-837e-0de7d729c9a9","timestamp":"2026-11-03T01:16:28.506Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/x3ec78e/my-3d2dge/dist/handoff/kits/adventure.js","content":"// The ADVENTURE kit's game (a top-down action adventure: a village, ruins and a shrine, a sword, a key and a great door, talk with portraits; Zelda and Secret of Mana), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/10-adventure.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. adventure.html plays it; node kits/test.mjs adventure runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 1  ADVENTURE  (Secret of Mana, Zelda: ALttP). Three rooms: village, ruins, shrine. Talk, clear the ruins for\n * the key, open the great door, claim the crystal. THE LOOK: wall MATERIALS, ONE floorTex with PAINTED LIGHT, pitched\n * roofs, leaf-clump bushes, light shafts, dialog PORTRAITS.\n * KEYS: WASD or arrows move, J or X swings the sword, Enter or Space talks. TOUCH: the stick, ATTACK, CONFIRM.\n * ANY SCREEN: rooms are 4:3 in a world that goes on past them (forest above and below, the next rooms beside), so a\n * screen of any shape is filled. CAMERA (Settings, or C): ROOMS slides screen by screen as Zelda's does, the rooms beside\n * this one under a dim CURTAIN (they wait, as their monsters do); SCROLL follows the hero. The HUD sits in the corners.\n * ===================================================================================== */\nconst ADV = (() => {\n  const T = 16, ROOM = [14 * T, 12 * T], AREAS = ['Mana Village', 'Mossy Ruins', 'Shrine of Mana'];\n  const ROWS = [\n    // village          ruins             shrine\n    ['^^^^^^^^^^^^^^', 'RRRRRRRRRRRRRR', 'XXXXXXXXXXXXXX'],\n    ['^^#^^^^^^^^#^^', 'RHhJKFYDYFKhHR', 'XwjiXnWXnXijwX'],\n    ['#UUUU.ZZZZ.~~#', 'R.u..qv.vq.S.R', 'X.S*.B..B.*S.X'],\n    ['#GQOQbzNzZu~~#', 'H.KK....x....H', 'X.....rA.....X'],\n    ['#ccccV~ccLe~~#', 'K..s.q::::.s.H', 'X..I..++..I..X'],\n    ['#cM@cPccac=~~#', 'H.....::::k..K', 'X....m++m....X'],\n    ['#,,,,,,,,,,__,', ',,....::C:...H', 'X4.I..++..I.4X'],\n    ['#.b...b.g,d__,', ',,..o.::::.s.H', 'X.....++.....X'],\n    ['#...%%%f..s~~#', 'Hb.K..::::q.KH', 'X..I..++..I..X'],\n    ['#T..%%%.u..~~#', 'H.u..s....y.RH', 'X.p...++...p.X'],\n    ['#.3........~~#', 'H...bK...b.xRH', 'X.....E+.....X'],\n    ['##############', 'RRRRRRRRRRRRRR', 'XXXXXX++XXXXXX']\n  ].map(r => r.join(''));\n  // the world AROUND the rooms: PAD rows of forest canopy above and below (a meadow's edge first, the shrine's stone under\n  // the shrine), so a screen of any shape is filled. The rooms' rows start at OY\n  const PAD = 12, OY = PAD * T, wood = (cx, cy) => cx >= 28 ? 'X' : E.hash2(cx * 7, cy * 5) < .18 ? '2' : '1';\n  const AROUND = (cy0, meadow) => Array.from({ length: PAD }, (_, i) => Array.from({ length: 42 }, (_, cx) => meadow && i < 2 && cx < 28 ? '.' : wood(cx, cy0 + i)).join(''));\n  ROWS.unshift(...AROUND(0)); ROWS.push(...AROUND(PAD + 12, true));\n  const LEGEND = {\n    // walls: a wall type (TYPES), or { tile, spawn } = a wall with a prop on its face (THINGS)\n    '#': 1, 'U': 5, 'Z': 8, 'R': 9, 'H': 3, 'K': 4, 'F': 6, 'X': 2, 'A': 7, '1': 10, '2': { tile: 10, spawn: 'tree' },\n    '^': { tile: 1, spawn: 'tree' }, 'G': { tile: 5, spawn: 'ivy' }, 'Q': { tile: 5, spawn: 'pane' }, 'O': { tile: 5, spawn: 'door' },\n    'z': { tile: 8, spawn: 'pane' }, 'N': { tile: 8, spawn: 'shop' }, 'h': { tile: 3, spawn: 'vines' }, 'J': { tile: 3, spawn: 'cobweb' }, 'Y': { tile: 6, spawn: 'moss' }, 'D': { tile: 6, spawn: 'gate' },\n    'w': { tile: 2, spawn: 'window' }, 'W': { tile: 2, spawn: 'rose' }, 'i': { tile: 2, spawn: 'torch' }, 'n': { tile: 2, spawn: 'banner' }, 'j': { tile: 2, spawn: 'cobweb' }, 'r': { tile: 7, spawn: 'relic' },\n    // floors: a tag for floorTex; block = not walkable\n    ',': { floor: 'path' }, 'c': { floor: 'plaza' }, '~': { floor: 'water', block: true }, '_': { floor: 'bridge' }, ':': { floor: 'pave' }, '+': { floor: 'carpet' }, '%': { floor: 'bed' },\n    '@': { floor: 'plaza', spawn: 'hero' }, 'M': { floor: 'plaza', spawn: 'elder' }, 'P': { floor: 'plaza', spawn: 'pot' }, 'L': { floor: 'plaza', spawn: 'lamp' },\n    'V': { floor: 'water', block: true, spawn: 'fountain' }, 'C': { floor: 'pave', spawn: 'chest' }, 'E': { floor: 'carpet', spawn: 'entry' }, 'd': { floor: 'path', spawn: 'villager' },\n    // people, creatures and props\n    'f': 'florist', 'a': { floor: 'plaza', spawn: 'cat' }, 's': 'rabite', 'v': 'bat', 'k': 'goblin', 'm': 'mage', 'b': 'bush', 'p': 'pot', 'T': 'oak', 'g': 'sign', 'u': 'mushroom',\n    'e': 'barrel', '=': 'crate', '3': 'stump', '4': 'obelisk', 'q': 'ruin', 'I': 'pillar', 'S': 'statue', 'o': 'rock', 'x': 'crystal', 'y': 'skull', 'B': 'brazier', '*': 'candelabra'\n  };\n  // wall MATERIALS: face = side, roof = top pattern (beam = timber); cut = lowered to cutH in front of the camera\n  const SLAB = { face: 'stone', roof: 'slab' }, TYPES = {\n    1: { h: 16, cut: true, cutH: 7, face: 'hedge', roof: 'leaves', top: '#3f8c3c', side: '#2e6a34' },   // hedge\n    2: { h: 34, cut: true, cutH: 8, ...SLAB, top: '#4e4670', side: '#6a6294', course: 9 },   // shrine stone\n    3: { h: 26, cut: true, cutH: 8, face: 'ruin', roof: 'slab', top: '#7a8a66', side: '#8e8a98' },   // ruin wall, mossy top: the 'ruin' MATERIAL (stones, cracks, moss, dirt; docs/ASSETS.md)\n    4: { h: 12, cut: true, ...SLAB, top: '#72845e', side: '#8e8a98', course: 6 },   // crumbled ruin\n    5: { h: 36, face: 'timber', roof: 'tiles', top: '#c4583a', side: '#f0e0c0', beam: '#6a4228' },   // cottage\n    6: { h: 36, ...SLAB, top: '#5a5480', side: '#7a7298', course: 9 },   // shrine facade\n    7: { h: 9, ...SLAB, top: '#8a84b4', side: '#5a5484', course: 4 },   // altar\n    8: { h: 36, face: 'plaster', roof: 'tiles', top: '#3a7ab4', side: '#f4e6c8' },   // shop\n    9: { h: 30, cut: true, cutH: 8, face: 'rock', roof: 'grass', top: '#5a9a44', side: '#8a7462' },   // cliff\n    10: { h: 22, face: 'hedge', roof: 'leaves', top: '#2c6a36', side: '#1f4a2a' }   // the forest round the rooms\n  };\n  // set dressing: tag -> prop(s). r = solid, cut = breakable (debris), drop = loot, face = on the wall at z (anchor\n  // 'top' hangs it), light = GPU light, dx = nudge, hidden = appears later; shape = a SHAPE (E.SHAPES, docs/ASSETS.md:\n  // right in every view and turn, no drawing code) in place of a prop, size its scale\n  const THINGS = {\n    // village\n    door: [{ face: true, size: 1.1, color: '#7a4222' }, { prop: 'lantern', face: true, z: 33, dx: 14, anchor: 'top', light: '#ffb060' }],\n    shop: [{ prop: 'door', face: true, size: 1.1, color: '#2a4a7a' }, { prop: 'awning', face: true, z: 23, size: .95, color: '#d8483a' }],\n    pane: { prop: 'window', face: true, z: 12, size: .65, color: '#6a4424', colors: ['#fff0b0', '#ffd070'] }, ivy: { prop: 'vines', face: true, z: 35, anchor: 'top', color: '#3a8a3a', blossom: '#f890b0' },\n    fountain: { prop: 'statue', size: .8, color: '#a8a6c0', dx: 8 }, lamp: { prop: 'streetlamp', r: 3, size: .8, halo: false }, oak: { prop: 'tree', size: 1.45, r: 8 },   // lamp: unlit by day\n    bush: { r: 6, cut: ['#2f7a34', '#5ab04a', '#9ad86a'] }, pot: { size: .95, r: 5, cut: ['#7a3a22', '#c07040', '#e8a878'], drop: 'gem' }, sign: { r: 4 },\n    mushroom: { size: .75, color: '#e0503a' }, barrel: { shape: 'barrel', r: 5, size: .75 }, crate: { shape: 'crate', r: 6, size: .65 },\n    // from the asset store, cut into the page's 'adventure' set (src/assets/sets/adventure.js); without it, props\n    ...(E.addAssets((window.ASSETS || {}).adventure || { set: 'adventure' }).shapes.length ? { stump: { shape: 'adventure:stump-round', r: 5, size: .7 },\n      obelisk: { shape: 'adventure:pillar-obelisk', r: 6, size: .8 } } : { stump: { prop: 'rock', r: 5, color: '#8a5a3a' }, obelisk: { prop: 'pillar', r: 6 } }),\n    // ruins\n    vines: { face: true, z: 25, anchor: 'top', color: '#4a8a3a', blossom: '#f890b0' }, moss: { prop: 'vines', face: true, z: 35, anchor: 'top', size: .8, color: '#5a8a3a', blossom: '#f890b0' },\n    gate: { prop: 'door', face: true, size: 1.1, color: '#5a3a6a' }, ruin: { prop: 'pillar', broken: true, r: 7 }, rock: { r: 5, color: '#8a8698' }, skull: { prop: 'bones' },\n    crystal: { r: 4, light: '#5ad8f0' }, chest: { r: 6, hidden: true },\n    // shrine\n    window: { face: true, z: 7, size: .8, colors: ['#e05a6a', '#5a8ae8', '#f0c85a', '#6ad08a'], light: '#8ab0ff' }, torch: { face: true, z: 14, light: '#ff9a4a' },\n    rose: { prop: 'window', face: true, z: 2, size: 1, dx: 8, colors: ['#e8c85a', '#c04aa0', '#5a8ae8'], light: '#c8a0ff' }, banner: { face: true, z: 8, size: .8, color: '#8a1a3a', emblem: '#e8c04a' },\n    cobweb: { face: true, z: 34, anchor: 'top', size: .9 }, pillar: { r: 7 }, statue: { r: 6, color: '#9a98b0' }, brazier: { r: 5, size: .9, light: '#ff9a4a' }, candelabra: { r: 3, size: .8, light: '#ffc060' }\n  };\n  // palettes: E.ramp(hex, n, strength) = n hue-shifted shades, dark to light\n  const rgb = hexes => hexes.map(E.hex), R5 = (c, s = .6) => rgb(E.ramp(c, 5, s)), FLAG = (s, mortar) => ({ stones: s.slice(1, 4), mortar, hi: s[4], lo: s[0], speck: s[1] });\n  const GRASS = [['#4c9a3e', '#5aa640', '#6cb44c'], ['#42804a', '#4a8a48', '#5a9a4e']].map(room => room.map(c => R5(c))), DIRT = R5('#b08652', .7), WATER = R5('#2a7ac4', .9), STONE = R5('#a49a8a', .7), SOIL = R5('#6e4a34');\n  const PLAZA = FLAG(R5('#b4a894'), E.hex('#6a5e52')), PAVE = FLAG(R5('#8a8a96'), E.hex('#3a3a3e')), TILE = [R5('#5a5688'), R5('#403c68')], PETAL = rgb(['#ffffff', '#ffe070', '#f890b0']);\n  const CARPET = rgb(E.ramp('#9a2438', 4)), GOLD = rgb(E.ramp('#d8a840', 3)), RUNE = [...E.hex('#6ae8e0'), .35], LILY = R5('#4aa050');   // 4th value = GPU glow\n  const SKY = rgb(['#a8dcf4', '#e8f8ff']), REFLECT = E.hex('#1e5a5a');   // sky glints, the hedge's reflection\n  const TUFT = ['.l.l.', '.dld.', '..d..'], BLOOM = ['.w.', 'wyw', '.w.'];   // grass stamps\n  const MOOD = [[.92, .9, .84], [.8, .88, .8], [.34, .3, .46]];   // GPU ambient light per room\n  const mood = m => { if (gpu) gpu.ambient = m; L.ambient = (m[0] + m[1] + m[2]) / 3; };   // (and the canvas lighting's, where WebGPU is missing and it stands in)\n  // light shafts per room: beam x, tint (a dark tint = a faint beam), lean\n  const BEAMS = [[[34, 128, 196], '#7a5a26', 60], [[50, 150], '#566a22', 60], [[24, 120, 200], '#4a3a8a', 12]];\n  const WIN = { bg: ['#3a4a9e', '#12163e'], border: '#f0e0a8' }, FACE_BG = ['#7aa4e8', '#1e2a66'];\n  // pixel sprites ('.' = transparent)\n  const GEM = E.sprite(['..g..', '.gGg.', 'gGWGg', 'gGGGg', 'dgGgd', '.dgd.', '..d..'], { g: '#1e9a3a', G: '#56e070', W: '#e8fff0', d: '#0e5a24' });\n  const HEART = E.sprite(['.R.R.', 'RWRRR', 'RRRRR', '.RRR.', '..R..'], { R: '#e8384a', W: '#ffd0d6' });\n  const KEYS = [1, 2].map(s => E.sprite(['.yy....', 'y..y...', 'Y..Yyyy', '.YY..y.', '.....yY'], { y: '#f8d048', Y: '#b07818' }, s));   // scale 2: held up high\n  const CRYSTALS = [1, 2].map(s => E.sprite(['....w....', '...wWc...', '..wWWcc..', '.wWWWccC.', 'wWWWccccC', '.wWWcccC.', '.cWWccCC.', '..cWcCC..', '..ccCC...', '...cC....'], { w: '#f0ffff', W: '#a8f0ff', c: '#4ac8e8', C: '#2a5ab0' }, s));\n\n  // THE CAST: chibi rigs, anime eyes, own outfits and palettes; the hero's cape is SECONDARY MOTION\n  const RIGS = {\n    hero: () => new E.Humanoid({ size: 1.3, outfit: 'tunic', hair: 'spiky', face: { eyes: 'big', bangs: .8 }, cape: { len: 4, width: 3.2, seg: 2.2 },\n      colors: { skin: '#f8cca4', hair: '#e8902c', cloth: '#3a8a4a', trim: '#f0d070', pants: '#4a3a5a', boot: '#8a4a26', belt: '#6a3a1a', glove: '#7a5238', eye: '#3a2a6a', cape: '#d0483a', capeIn: '#7a1e2e' } }),\n    elder: () => new E.Humanoid({ size: 1.2, weapon: 'staff', outfit: 'robe', hair: 'short', sleeves: 'long', hunch: .45, hat: { style: 'pointed', color: '#3e3278' }, face: { eyes: 'big', bangs: .35 },\n      colors: { skin: '#f0c4a8', hair: '#b8b2c4', cloth: '#5a4a9a', trim: '#f0cc60', belt: '#f0cc60', boot: '#4a3a2a', eye: '#2a2a4a' } }),\n    florist: () => new E.Humanoid({ size: 1.15, weapon: null, outfit: 'robe', sleeves: 'long', hair: 'ponytail', face: { eyes: 'big', bangs: 1 },\n      colors: { skin: '#f8cca4', hair: '#b0482a', cloth: '#d86a8a', trim: '#f4a8c0', belt: '#fff0d0', pants: '#d86a8a', boot: '#6a3a2a', eye: '#2a5a3a' } }),\n    villager: () => new E.Humanoid({ size: 1.1, weapon: null, hair: 'short', hat: { style: 'band', color: '#d8483a' }, face: { eyes: 'big', bangs: .7 }, shoulderHalf: 4.6, armUpper: 5.2, armLower: 5,   // the wave clears his face\n      colors: { skin: '#f0c090', hair: '#6a3a1e', cloth: '#e8a83a', trim: '#fff0d0', pants: '#4a5a8a', boot: '#6a4a2a', belt: '#6a4a2a', eye: '#2a3a5a' } }),\n    goblin: () => new E.Humanoid({ size: 1.1, build: 'bulky', weapon: null, outfit: 'tunic', hair: 'bald', eyeGlow: '#ffd84a',\n      colors: { skin: '#8ab84a', cloth: '#8a5a32', trim: '#c8a040', pants: '#4a3a2a', boot: '#3a2a1a', belt: '#3a2a1a' } }),\n    mage: () => new E.Humanoid({ size: 1.3, build: 'heroic', weapon: 'staff', outfit: 'robe', hood: true, sleeves: 'long', eyeGlow: '#ff6ab0',\n      colors: { skin: '#c8b8e0', hair: '#2e2450', cloth: '#4a3a86', trim: '#d070f0', belt: '#d070f0', boot: '#1a1628', orb: '#ff80e0' } })\n  };\n  // BLOB CREATURES: a round body plus parts\n  const RABITE = { dk: '#b0703a', base: '#f4d49a', lt: '#fff4dc', pupil: '#5a1a2a', inner: '#f09aa8', ext: '#d8a060' };\n  const BAT = { dk: '#2e1a44', base: '#6a4a9a', lt: '#a890d0', eye: '#fff0a0', pupil: '#c02020', wing: '#4a2a6a', inner: '#e08aa0' };\n  const CAT = { dk: '#9a5028', base: '#f0a050', lt: '#ffd8a0', pupil: '#2a4a1a', inner: '#f8b0b0', ext: '#fff0e0' };\n  const FOES = {   // hp (a hit does 8-12), look, moves (E.MOVES with a long, deep wind-up: the TELL)\n    rabite: { hp: 18, look: () => new E.Blob({ R: 5.5, colors: RABITE, ears: 'rabbit', feet: true, tail: true, mouth: true, face: 'front' }) },\n    bat: { hp: 12, fly: 17, look: () => new E.Blob({ R: 4.5, colors: BAT, wings: true, ears: 'cat', mouth: 'fangs', face: 'front' }) },\n    goblin: { hp: 40, look: RIGS.goblin, moves: ['claw', 'twohand'], tune: { wind: .34, crouch: 1, lean: .9 } },   // a raking claw, a two-fist SLAM\n    mage: { hp: 30, look: RIGS.mage, moves: ['cast'], tune: { wind: .6, lean: .6 } }   // leans back to raise, recoils forward to release\n  };\n  // spins at the waist; CHARGE: the spin's wind-up, deeper\n  const WAIST = { z0: -10, z1: -10 }, CHARGE = { ...E.MOVES.spin, ...WAIST, a0: 2.4, crouch: .6, lean: .6 };\n  // idle: poses in turn; near: turn to the hero (wave: say hello); talk: gestures; chore: a move while kneeling\n  const NPCS = {\n    elder: { name: 'ELDER', idle: [null, null, 'hips'], near: 56, talk: ['block', null, 'hips', null], lines: [() => 'Rabites overran the Mossy Ruins across the river. Press ' + game.input.label('attack') + ' to swing your sword and clear them out!',\n      'Clear the ruins and the old chest opens. The Mana crystal sleeps in the shrine behind the great door.'] },\n    florist: { name: 'LISE', face: Math.PI, idle: ['kneel', 'kneel', null], near: 36, talk: ['hips', 'cast'],   // tends the flower bed\n      chore: () => new E.Attack('plunge', { hand: 'both', a0: -.5, a1: -.9, r0: 4, r1: 9, wind: .3, active: .16, recover: .45 }),\n      lines: ['A rabite got into my garden again! Could you shoo it away?', 'Mind the bats in the ruins. They swoop when you get close!'] },\n    villager: { name: 'PIP', idle: [null, 'hips'], near: 50, wave: true, talk: ['hips', null], lines: ['Hi! The bridge leads to the Mossy Ruins.', () => 'Keep ' + game.input.label('attack') + ' held after a swing, then let go: a SPIN ATTACK!'] }   // a function: the player's own key\n  };\n  // BACKDROP (iso view): a sea of clouds\n  const bg = new E.Backdrop({ sky: ['#3a74c8', '#8ac2ea', '#e4f2f4', '#9ccae6', '#5a90c8'], layers: [{ kind: 'clouds', color: '#ffffff', y: .3, height: .16, parallax: .04, drift: 3 },\n    { kind: 'clouds', color: '#ffffff', y: .98, height: .4, parallax: .1, drift: 3, seed: 9 }] });\n  let map, relic, entry, hero, npcs, foes, pets, items, things, roofs, shots, talk, speaker, won, keys, gems, area, held, fx;\n  // CAMERA, the player's choice: 'rooms' slides screen by screen (Zelda), 'scroll' follows the hero (Settings, or C)\n  game.settings.define({ key: 'advCamera', group: 'Adventure', label: 'Camera', options: [['rooms', 'Rooms'], ['scroll', 'Scroll']], value: 'rooms', help: 'Rooms: screen by screen, as Zelda. Scroll: it follows the hero' });\n  // LIGHTING: GPU lights (pools of light and shadows, WebGPU) draw every frame twice and light each pixel: a phone's frame\n  // rate pays for them, so Auto keeps them for a computer (its main pointer a mouse or touchpad) and a phone gets Fast (the\n  // floor is lit already): the main pointer, as a phone with a stylus has a fine one too\n  const gpuWanted = () => game.settings.advLight === 'gpu' || (game.settings.advLight === 'auto' && !!(window.matchMedia && matchMedia('(pointer: fine)').matches));\n  const lighting = () => { if (!map) return; if (gpuWanted() && !gpu) gpu = game.enableGPU({ map }); if (gpu) Object.assign(gpu, { map, enabled: gpuWanted(), bands: 24, wrap: .5 }); };\n  game.settings.define({ key: 'advLight', group: 'Adventure', label: 'Lighting', options: [['auto', 'Auto'], ['gpu', 'GPU'], ['fast', 'Fast']], value: 'auto', help: 'GPU: pools of light and shadows (slow on a phone). Fast: smooth on a phone. Auto: GPU on a computer, Fast on a phone', apply: () => { if (game.sceneName === 'adventure') lighting(); } });\n  addEventListener('keydown', e => { if (e.code !== 'KeyC' || e.repeat || game.sceneName !== 'adventure' || game.paused) return; const v = game.settings.advCamera === 'rooms' ? 'scroll' : 'rooms'; game.settings.set('advCamera', v); game.note('CAMERA: ' + v.toUpperCase()); });\n  const sliding = () => !!game.cam.room && game.cam.moving;   // a room slide holds the world still\n  const roomOf = x => Math.floor(x / ROOM[0]), mod = (a, n) => ((a % n) + n) % n, near = (cx, cy, tag) => map.floorAt((cx + .5) * T, (cy + .5) * T) === tag;\n  const txt = (g, s, x, y, c, o) => E.font.text(g, s, x, y, c, { shadow: '#07040c', outline: false, ...o });\n  const talkable = () => npcs.find(n => E.dist(hero, n) < 34);\n  // CONTACT SHADOWS: a darker core in a soft ellipse, cool purple\n  const shadow = (r, x, y, rad) => { r.shadow(x, y, rad, .28, '#2a2048'); r.shadow(x, y, rad * .6, .22, '#2a2048'); };\n\n  /* ---- FLOORS: floorTex(x, y, tag) = [r, g, b(, glow)], baked once per view ---- */\n  // AUTOTILING: distance to the nearest side bordering another floor, corners rounded by K\n  function edge(cx, cy, lx, ly, tag, K) {\n    const o = (dx, dy) => { const t = map.floorAt((cx + dx + .5) * T, (cy + dy + .5) * T), c = map.cell(cx + dx, cy + dy); return tag === 'water' ? t !== tag && t !== 'bridge' && !c : t !== tag || c !== 0; };\n    const a = Math.min(o(-1, 0) ? lx : 99, o(1, 0) ? T - lx : 99), b = Math.min(o(0, -1) ? ly : 99, o(0, 1) ? T - ly : 99);\n    return a < K && b < K ? K - Math.hypot(K - a, K - b) : Math.min(a, b);\n  }\n  // GRASS: TUFT and BLOOM stamps on a staggered lattice in SCREEN pixels\n  function grass(sx, sy, G) {\n    const row = Math.floor(sy / 7), X = sx + (row & 1) * 6, k = E.hash2(Math.floor(X / 12), row), pat = k < .07 ? BLOOM : k < .62 ? TUFT : null;\n    const ch = pat && (pat[mod(Math.floor(sy), 7) - 2] || '')[mod(Math.floor(X), 12) - (pat === BLOOM ? 5 : 4)];\n    return ch === 'l' ? G[3] : ch === 'd' ? G[1] : ch === 'y' ? PETAL[1] : ch === 'w' ? PETAL[k < .035 ? 0 : 2] : G[2];\n  }\n  function ground(x, y, tag) {\n    const cx = Math.floor(x / T), cy = Math.floor(y / T), lx = x - cx * T, ly = y - cy * T, room = roomOf(x), [sx, sy] = game.view.p(x, y), h = E.hash2(cx, cy);\n    const e = tag && tag !== 'carpet' ? edge(cx, cy, lx, ly, tag, tag === 'water' ? 7 : tag === 'pave' ? 1 : 4) : 99;\n    if (e < 0) tag = null;   // outside a rounded corner\n    // WATER: bank, lip, shadow, reflection, foam, then depth BANDS bent by value noise\n    if (tag === 'water') {\n      if (e < 2.6) return e < 1 ? STONE[0] : E.hash2(Math.floor(y / 3), cx) < .2 ? STONE[1] : STONE[e < 1.8 ? 4 : 3];\n      const w = (E.noise2(x / 6, y / 9) - .5) * 5, foam = near(cx, cy - 1, 'bridge') ? ly : near(cx, cy + 1, 'bridge') ? T - ly : 99;\n      if (e < 3.3 || foam < 3 + w + E.hash2(Math.floor(sx / 2), 1) * 2) return foam < 1.5 + w ? SKY[1] : WATER[4];\n      if (!near(cx - 1, cy, 'water') && lx < 6 + w) return WATER[0];\n      if (map.cell(cx + 1, cy) > 0 && lx > 11 + w) return REFLECT;\n      const px_ = lx - 4 - h * 8, py_ = ly - 4 - h * 7, pad = Math.hypot(px_, py_);\n      if (h < .3 && pad < 3) return LILY[pad < 1 ? 4 : px_ > .5 && Math.abs(py_) < .5 ? 1 : 2];\n      const k = mod(Math.floor(sx) + Math.floor(sy / 6) * 7, 23);   // sky glints on every 6th row\n      return mod(Math.floor(sy), 6) === 0 && k < 4 ? SKY[k ? 0 : 1] : WATER[e + w < 8 ? 3 : e + w < 12 ? 2 : 1];\n    }\n    if (tag === 'bridge') return (ly < 2 && !near(cx, cy - 1, tag)) || (ly > T - 2 && !near(cx, cy + 1, tag)) ? DIRT[0] : E.tex.planks(y, x, { base: '#b07c44', dark: '#8a5c32', line: '#4a2e1a' });\n    // path and paving: grass erodes the edge by a hash; dirt, pebbles\n    const q = E.hash2(Math.floor(sx / 6), Math.floor(sy / 5)), b = E.hash2(Math.floor(x / 4), Math.floor(y / 4)) * 3;\n    if (tag === 'path') return e < b ? grass(sx, sy, GRASS[room][1]) : e < b + .9 ? DIRT[0] : q < .16 && mod(Math.floor(sx), 6) < 2 && mod(Math.floor(sy), 5) === 0 ? DIRT[q < .07 ? 4 : 1] : DIRT[e < b + 1.8 ? 1 : 2];\n    if (tag === 'plaza') return e < .9 ? PLAZA.mortar : E.tex.flagstone(x, y, PLAZA, 8);\n    if (tag === 'bed') return e < 1 ? STONE[0] : e < 2.4 ? STONE[3] : SOIL[mod(ly, 4) < 1 ? 0 : 2];\n    const c = Math.min(near(cx - 1, cy, tag) ? 99 : lx, near(cx + 1, cy, tag) ? 99 : T - lx), m = Math.abs(mod(x, 32) - 16) + Math.abs(ly - 8);   // carpet\n    if (tag === 'carpet') return c < 1 ? CARPET[0] : c >= 2 && c < 3 ? GOLD[1] : m > 5 && m < 6.5 ? GOLD[0] : m < 2.5 ? GOLD[2] : CARPET[1];\n    const f = E.tex.flagstone(x, y, PAVE);   // paving: moss in the seams\n    if (tag === 'pave') return e < b ? grass(sx, sy, GRASS[1][1]) : e < b + .9 ? PAVE.mortar : f === PAVE.mortar && E.hash2(Math.floor(x / 6), Math.floor(y / 6)) < .45 ? GRASS[1][1][1] : f;\n    const n = E.noise2(x / 40 + room * 9, y / 40);   // lawn: three shades in slow patches\n    if (room < 2) return grass(sx, sy, GRASS[room][n < .36 ? 0 : n > .64 ? 2 : 1]);\n    const dr = Math.hypot(x - relic.x, y - relic.y), a = Math.atan2(y - relic.y, x - relic.x), P = TILE[(cx + cy) & 1];\n    if (Math.abs(dr - 15) < .7 || Math.abs(dr - 10.5) < .6 || (dr > 11 && dr < 14.5 && Math.abs(mod(a / Math.PI * 4, 1) - .5) < .06)) return RUNE;   // shrine: a rune circle...\n    if (dr < 26) return dr > 24.8 ? TILE[1][0] : dr > 23.2 ? TILE[0][4] : TILE[dr < 20 ? 1 : 0][2];   // ...on a round dais with a lit rim...\n    if (Math.min(lx, ly) < 1.2) return P[lx < .8 || ly < .8 ? 0 : 4];   // ...on marble tiles\n    return lx > T - 1.2 || ly > T - 1.2 ? P[1] : mod(lx + ly, 13) < 1 ? P[3] : P[2];\n  }\n  // PAINTED LIGHT (Legend of Mana): a wall taller than its distance toward the low sun shades a point cool purple\n  const SHADE = [.64, .68, .86];\n  function floorTex(x, y, tag) {\n    const c = ground(x, y, tag);\n    for (let d = 2; d < 18; d += 2) if (map.heightAt(x - d, y - d * .3) > d * 1.8) return c.map((v, i) => i < 3 ? v * SHADE[i] : v);\n    return c;\n  }\n\n  // trees and pines varied by hashes\n  const tree = (cx, cy, pine) => { const v = E.hash2(cx * 5, cy * 3); return { prop: pine || v > .72 ? 'pine' : 'tree', size: 1 + v * .45, color: ['#2f7a3c', '#3f8a45', '#2a6a44', '#4a8a3a'][Math.floor(v * 4)], x: (cx + .3 + E.hash2(cy, cx) * .4) * T }; };\n  function start() {\n    map = new E.TileMap({ rows: ROWS, legend: LEGEND, types: TYPES, floorTex, ao: 8 });\n    relic = map.find('relic'); entry = map.find('entry'); relic.x += T / 2; entry.x += T / 2;   // on the room's center line\n    // the camera stays inside the map (the forest round the rooms fills a tall screen); update() sets rooms or scroll\n    game.cam.bounds = v => { const b = map.bounds(v); return { x0: b.x0 + 9, y0: b.y0 + 9, x1: b.x1 - 9, y1: b.y1 - 9 }; }; game.cam.room = game.settings.advCamera === 'scroll' ? null : ROOM;\n    const at = map.find('hero');\n    // SWORD (Secret of Mana): J chains slash, backslash, spin, kept low (a raised blade crosses his face); short holds (hold)\n    // let the follow-through settle instead of freezing; hold J to CHARGE\n    hero = Object.assign(new E.Body({ ...at, r: 4.5 }), { hp: 3, max: 3, facing: Math.PI / 2, inv: 0, hurt: 0, charge: 0, rig: RIGS.hero(),\n      combo: new E.Combo([new E.Attack('slash', { z0: -8, z1: -11, a1: -1.2, wind: .12, hold: .1 }), new E.Attack('backslash', { z0: -11, z1: -9, a1: 1.2, hold: .1 }), new E.Attack('spin', { ...WAIST, hold: .15 })], { window: .3 }),\n      spin: new E.Attack('spin', { ...WAIST, active: .36, reach: 10, lean: .3, hold: .12 }) });\n    hero.sw = hero.combo;   // the attack running now\n    npcs = Object.keys(NPCS).map(k => { const n = Object.assign({ said: 0, t: 0, k: 0, hi: 0, nod: 0, face: Math.PI / 2, rig: RIGS[k]() }, map.find(k), NPCS[k]); n.dir = n.look = n.face; n.job = n.chore && n.chore(); return n; });\n    things = [];\n    for (const s of map.spawns) for (const d of [].concat(s.tag === 'tree' ? tree(s.cx, s.cy) : THINGS[s.tag] || []))\n      things.push(Object.assign({ tag: s.tag, prop: s.tag, x: s.x + (d.dx || 0), y: s.y, room: roomOf(s.x) }, d));\n    // one pass over the cells: roofs, pines, weeds, flower beds, bridge rails, tufts\n    const box = {};\n    for (let cy = 0; cy < map.h - 1; cy++) for (let cx = 0; cx < map.w; cx++) {\n      const c = map.cell(cx, cy), v = E.hash2(cx * 3, cy * 7 + 1), X = (cx + .5) * T, Y = (cy + .5) * T, tag = map.floorAt(X, Y), add = o => things.push(Object.assign({ x: X, y: Y }, o));\n      if (c === 5 || c === 8) { const b = box[c] || (box[c] = [cx, cy, cx, cy]); b[2] = cx; b[3] = cy; }\n      if (map.spawns.some(s => s.cx === cx && s.cy === cy)) continue;\n      if (c === 9 && cy === PAD && v < .5) add(tree(cx, cy, true));\n      else if ((c === 3 || c === 4) && v < .45) add({ prop: 'bush', size: .7 + v * .6, color: '#5a8a44' });\n      else if (tag === 'bed') {\n        for (const k of [-3, 3]) add({ prop: 'flowers', size: 1.1, x: X + k, y: Y + k, color: k < 0 ? ['#f06a9a', '#f0a040', '#ffffff'][cx % 3] : '#8ab0ff', color2: '#fff4a0' });\n        if (!near(cx, cy + 1, 'bed')) add({ prop: 'fence', size: 1.2, y: Y + 8, color: '#b08050' });\n      }\n      else if (tag === 'bridge') for (const s of [-1, 1]) { if (!near(cx, cy + s, 'bridge')) add({ prop: 'fence', size: 1.2, y: Y + s * 7, color: '#8a5a32' }); }\n      else if (!c && !tag && X < 2 * ROOM[0] && v < .16) add({ prop: v < .06 ? 'flowers' : 'grass', x: X + (E.hash2(cx, cy) - .5) * 10, y: Y + (E.hash2(cy, cx) - .5) * 8,\n        color: v < .06 ? '#f06a9a' : X > ROOM[0] ? '#5a9a4a' : '#6ab850', color2: '#fff4a0' });\n    }\n    roofs = Object.keys(box).map(id => { const [a, b, c, d] = box[id]; return { x0: a * T, y0: b * T, x1: (c + 1) * T, y1: (d + 1) * T, h: TYPES[id].h, C: E.ramp(TYPES[id].top, 5) }; });\n    items = [{ kind: 'relic', x: relic.x, y: relic.y }];\n    // bats roost (hang; wake = time since); stun = flinch; dying = death; streak = claw marks; hold = an impact frame\n    foes = Object.keys(FOES).flatMap(k => map.findAll(k)).map(s => { const F = FOES[s.tag], moves = (F.moves || []).map(m => new E.Attack(m, { recover: .45, hold: .5, ...F.tune }));\n      return Object.assign(new E.Body({ ...s, r: 5.5, friction: 6, ...(F.fly && { z: F.fly + 8, gravity: 0, onGround: false }) }), { kind: s.tag, hp: F.hp, fly: F.fly, hang: !!F.fly, home: { ...s },\n        t: 1 + Math.random(), flash: 0, stun: 0, swoop: 0, wake: 9, streak: [], face: Math.PI / 2, room: roomOf(s.x), look: F.look(), moves, atk: moves[0] }); });\n    pets = map.findAll('cat').map(s => Object.assign(new E.Body({ ...s, r: 4 }), { t: 1, home: { ...s }, look: new E.Blob({ R: 4, colors: CAT, ears: 'cat', tail: true, feet: true, mouth: true, face: 'front' }) }));","numLines":409,"startLine":1,"totalLines":732,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01WPRH66raZsuhECWvrfCpTv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
