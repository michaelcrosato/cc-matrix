"+  if (f.noDie && f.hp <= f.max * (f.kind === 'boss' ? .08 : .3)) { f.hp = Math.max(1, f.hp); f.surrender = 1; f.atk && f.atk.cancel && f.atk.cancel(); W.lobs = []; return; }","   if (f.hp <= 0) killFoe(f, by);"," }"," function killFoe(f, by) {"]},{"oldStart":159,"oldLines":7,"newStart":164,"newLines":7,"lines":[" }"," function driveCar(h, it, dt) {","   const c = h.car;","-  const steer = clamp(it.mx || 0, -1, 1);","+  const steer = it.steer != null ? it.steer : clamp(it.mx || 0, -1, 1);","   c.update(dt, W.map, { steer, gas: it.gas ? 1 : 0, brake: it.brake ? 1 : 0, drift: !!it.hand });","   for (const p of W.parked) bumpStatic(c, p);","   if (c.bumped && Math.abs(c.speed) > 60) { A.sfx('crash', { vol: .6 }); game.shake(3); P.sparks(c.x + Math.cos(c.angle) * 14, c.y + Math.sin(c.angle) * 14, 6, 6, c.angle + Math.PI); }"]},{"oldStart":190,"oldLines":7,"newStart":195,"newLines":7,"lines":[" function spawnFoe(kind, x, y, o = {}) {","   const K = FOE_KINDS[kind], f = new E.Body({ x, y, r: kind === 'boss' ? 7 : 5.5, friction: 7 });","   Object.assign(f, { kind, hp: Math.round(K.hp * (o.hpK || 1)), max: Math.round(K.hp * (o.hpK || 1)), rig: o.rig || K.look(), facing: Math.PI / 2, stun: 0, flash: 0, inv: 0, cd: rnd(.6, 1.6), aimT: 0, strafe: Math.random() < .5 ? 1 : -1,","-    atks: K.moves.map(m => new E.Attack(m, { wind: kind === 'boss' ? .28 : .42, recover: .45, hold: .2 })), atk: null, name: o.name || null, wake: o.wake || 0, loot: o.loot, phase: 1, dead: 0, ammo: 0 });","+    atks: K.moves.map(m => new E.Attack(m, { wind: kind === 'boss' ? .28 : .42, recover: .45, hold: .2 })), atk: null, name: o.name || null, wake: o.wake || 0, loot: o.loot, phase: 1, dead: 0, ammo: 0, noDie: kind === 'boss' || kind === 'bagman' });","   f.atk = f.atks[0] || null;","   W.foes.push(f); P.dust(x, y, 0, 6);","   return f;"]},{"oldStart":208,"oldLines":6,"newStart":213,"newLines":7,"lines":["     if (f.atk) f.atk.update(dt);","     if (!t) { f.vx *= .9; f.vy *= .9; }","     else if (f.