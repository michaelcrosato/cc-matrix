ostT: a boost's seconds left; spinT: a\n     *  spin-out's; surface: the floor tag under it; offroad: on a surface that slows it; bumped: it hit a wall or a car\n     *  this step; airT: a hop's seconds in the air */\n    this.angle = o.angle || 0; this.speed = 0; this.slide = 0; this.drifting = 0; this.charge = 0; this.boostT = 0; this.spinT = 0; this.surface = null; this.offroad = false; this.bumped = false; this.airT = 0;\n    this._boostK = 0; this._hopDir = 0; this._stall = 0;\n  }\n  /** a boost: seconds of it, power (.4: top speed up by that share) */\n  boost(sec = .8, power = .4) { this.boostT = Math.max(this.boostT, sec); this._boostK = Math.max(this.boostT > sec ? this._boostK : 0, power); return this; }","stderr":"\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181313__x3ec78e/work","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Kad5oCXXd3Xi8kLVz1GudQ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
