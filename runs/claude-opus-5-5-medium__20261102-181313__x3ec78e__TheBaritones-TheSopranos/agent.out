: they are how a player\\\\n   *  gets back to the menu), and those the game hides with new E.Game({ menu: { controls: { a: false } } }) */\\\\n  rebindable(a, map = this.preset) { return !!map && a in map && !(a in MENU_KEYS) && !(this.names && this.names[a] === false); }\\\\n  /** the player's bindings over the preset: { action: { keys: [codes], pad: [codes] } } (game.settings.bindings keeps them) */\\\\n  get bindings() { return this._bindings || {}; }\\\\n  set bindings(b) { this._bindings = b && typeof b === 'object' ? b : {}; if (this.preset) this.use(this.preset); }\\\\n  /**\\\\n   * bind action a to one code for a device ('keys' = keyboard and mouse, 'pad' = gamepad), in place of that device's\\\\n   * codes: input.rebind('attack', 'keys', 'KeyF'). Returns null when done, the action that already uses the code (nothing\\\\n   * changes: free it first), or 'reserved' for the codes the menus keep (Escape, Enter, F keys, Start, the d-pad). The\\\\n   * arrow keys and the d-pad always move as well\\\\n   */\\\\n  rebind(a, device, code) {\\\\n    if (!this.rebindable(a) || (device !== 'keys' && device !== 'pad') || !BINDABLE.test(code) || padCode(code) !== (device === 'pad')) return 'reserved';\\\\n    const other = Object.keys(this.map).find(b => b !== a && !(b in MENU_KEYS) && this.map[b].includes(code));\\\\n    if (other) return other;\\\\n    this._setBindings(Object.assign({}, this.bindings, { [a]: Object.assign({}, this.bindings[a], { [device]: [code] }) }));\\\\n    return null;\\\\n  }\\\\n  /** take away action a's codes for one device ('keys' or 'pad'); the arrow keys and d-pad stay on the moves */\\\\n  unbind(a, device) { if (this.rebindable(a)) this._setBindings(Object.assign({}, this.bindings, { [a]: Object.assign({}, this.bindings[a], { [device]: [] }) })); }\\\\n  /** forget the player's bindings: every action back to its preset's codes */\\\\n  resetBindings() { this._setBindings({}); }\\\\n  _setBindings(b) { if (this._onBindings) this._onBindings(b); else this.bindings = b; }   // (the game saves them in its settings)\\\\nInput.DEFAULT = {\\\\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\\\n  attack: ['KeyJ', 'KeyX', 'Mouse0', 'Pad0', 'Pad7'], dash: ['Space', 'ShiftLeft', 'ShiftRight', 'KeyK', 'Pad1', 'Pad6'],\\\\n  skill: ['KeyL', 'KeyE', 'Mouse2', 'Pad2', 'Pad5'], jump: ['KeyZ', 'Pad3'], ...MENU_KEYS\\\\n};\\\\n/** side-scrollers (Mario, Mega Man): Space / Z / K jump, X / J attack or shoot, Shift / C dash */\\\\nInput.PLATFORMER = {\\\\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\\\n  jump: ['Space', 'KeyZ', 'KeyK', 'Pad0'], attack: ['KeyX', 'KeyJ', 'Mouse0', 'Pad2'], dash: ['ShiftLeft', 'ShiftRight', 'KeyC', 'KeyL', 'Pad1', 'Pad5'],\\\\n  skill: ['KeyE', 'KeyV', 'Mouse2', 'Pad3'], ...MENU_KEYS\\\\n};\\\\n/** third-person action and stealth (Assassin's Creed, Metal Gear): WASD / stick move, Shift sprint, Space jump and parkour,\\\\n *  C crouch (a toggle), E interact, J attack, K block, L dodge, Q use, M map. Pad: A jump, B crouch, X attack, Y interact,\\\\n *  LB block, RB dodge, LT use, RT or L3 sprint, Back map */\\\\nInput.THIRDPERSON = {\\\\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\\\n  sprint: ['ShiftLeft', 'ShiftRight', 'Pad7', 'Pad10'], jump: ['Space', 'Pad0'], crouch: ['KeyC', 'ControlLeft', 'Pad1'], interact: ['KeyE', 'KeyF', 'Pad3'],\\\\n  attack: ['KeyJ', 'Mouse0', 'Pad2'], block: ['KeyK', 'Mouse2', 'Pad4'], dodge: ['KeyL', 'Pad5'], use: ['KeyQ', 'Pad6'], map: ['KeyM', 'Tab', 'Pad8'], ...MENU_KEYS\\\\n};\\\\n/** shoot-'em-ups (1942, Gradius): Space / Z / J fire (hold for autofire), X / K bomb */\\\\nInput.SHMUP = {\\\\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\\\n  fire: ['Space', 'KeyZ', 'KeyJ', 'Mouse0', 'Pad0', 'Pad7'], bomb: ['KeyX', 'KeyK', 'Mouse2', 'Pad1', 'Pad6'], ...MENU_KEYS\\\\n};\\\\nE.Input = Input;\\\",\\\"stderr\\\":\\\"\\\",\\\"interrupted\\\":false,\\\"isImage\\\":false,\\\"noOutputExpected\\\":false},\\\"tool_result_meta\\\":[{\\\"id\\\":\\\"toolu_013GXaqrQJwDNqFQyRGtfcSP\\\",\\\"permission_decision\\\":{\\\"decision\\\":\\\"accept\\\",\\\"source\\\":\\\"config\\\",\\\"reason_type\\\":\\\"mode\\\"}}]}\",\" {\\\"type\\\":\\\"system\\\",\\\"subtype\\\":\\\"thinking_tokens\\\",\\\"estimated_tokens\\\":50,\\\"estimated_tokens_delta\\\":50,\\\"session_id\\\":\\\"8704baa7-6f68-414d-afec-f55fd2d8121c\\\",\\\"uuid\\\":\\\"1cbb59b2-450b-48ab-9b45-1e48ba2ee680\\\"}\",\" {\\\"type\\\":\\\"system\\\",\\\"subtype\\\":\\\"thinking_tokens\\\",\\\"estimated_tokens\\\":200,\\\"estimated_tokens_delta\\\":150,\\\"session_id\\\":\\\"8704baa7-6f68-414d-afec-f55fd2d8121c\\\",\\\"uuid\\\":\\\"f395f753-1a11-455c-b3ce-fb767ec2c913\\\"}\",\"+{\\\"type\\\":\\\"system\\\",\\\"subtype\\\":\\\"thinking_tokens\\\",\\\"estimated_tokens\\\":450,\\\"estimated_tokens_delta\\\":250,\\\"session_id\\\":\\\"8704baa7-6f68-414d-afec-f55fd2d8121c\\\",\\\"uuid\\\":\\\"62070365-d220-499f-b90a-bec21bdb0bce\\\"}\"]}]}],\"moreFiles\":2,\"changedFiles\":[\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181319__xb81546/agent.out\",\"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium__20261102-181334__xac1bf5/agent.out\",\"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium__20261102-181340__x96eb17/agent.out\",\"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium__20261102-183711__xb81546/agent.out\"]}},\"tool_result_meta\":[{\"id\":\"toolu_013hxH8ARefrrcAPzg7tEcU7\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}]}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011Cgf9A4iAnoepTXToW9ZEy\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01XKh23WWBhyrZEKyGvoPgzA\",\"name\":\"Bash\",\"input\":{\"command\":\"mkdir -p /tmp/x22cc1b-shots && cat > /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181307__x22cc1b/work/Rewired-TheWire-claude-opus-5-5-medium-20261102-181307/test/browser.py <<'EOF'\\n# Opens the bundled game in a real browser at deep links, collects console errors, takes screenshots.\\nimport sys, json, asyncio\\nfrom playwright.async_api import async_playwright\\nURL = 'http://127.0.0.1:18931/Rewired-TheWire-claude-opus-5-5-medium-20261102-181307.html'\\nOUT = sys.argv[1] if len(sys.argv) > 1 else '/tmp/x22cc1b-shots'\\nENGINE = sys.argv[2] if len(sys.argv) > 2 else 'chromium'\\nLINKS = sys.argv[3].split(',') if len(sys.argv) > 3 else ['', 'coldopen', 'corner', 'shift', 'reup', 'office', 'wire', 'stash', 'ending', 'montage', 'about', 'demo', 'chase']\\nasync def main():\\n    async with async_playwright() as p:\\n        b = await getattr(p, ENGINE).launch()\\n        errors = {}\\n        for link in LINKS:\\n            pg = await b.new_page(viewport={'width': 1280, 'height': 720})\\n            errs = []\\n            pg.on('console', lambda m, errs=errs: errs.append(m.text) if m.type == 'error' else None)\\n            pg.on('pageerror', lambda e, errs=errs: errs.append('PAGEERROR ' + str(e)))\\n            await pg.goto(URL + ('#' + link if link else ''))\\n            await pg.wait_for_timeout(3500)\\n            await pg.keyboard.press('KeyW')\\n            await pg.wait_for_timeout(600)\\n            snap = await pg.evaluate('JSON.stringify(My3D2dge.current.debug.snapshot()) + \\\" ERR \\\" + JSON.stringify((My3D2dge.current.errors||[]).map(e => String(e.message||e)).slice(0,3))')\\n            await pg.screenshot(path=f'{OUT}/{ENGINE}-{link or \\\"title\\\"}.png')\\n            errors[link or 'title'] = errs[:4]\\n            print(link or 'title', '|', snap[:300], '|', errs[:3])\\n            await pg.close()\\n        await b.close()\\nasyncio.run(main())\\nEOF\\ncd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181307__x22cc1b/work/Rewired-TheWire-claude-opus-5-5-medium-20261102-181307 && timeout 300 python3 test/browser.py 2>&1 | tail -20\",\"description\":\"Run browser deep-link check with screenshots\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":333,\"cache_read_input_tokens\":271224,\"cache_creation\":{\"ephemeral_5m_input_tokens\":333,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":20,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"df8c1585-be07-48c4-a448-ca4232e59bdf\",\"uuid\":\"c8a0de55-bc44-4248-9f90-b90219a58b02\",\"timestamp\":\"2026-11-03T01:39:41.684Z\",\"request_id\":\"req_011Cgf9A4ML4D5BmrSvXCHdQ\",\"wire_tool_inputs\":{\"toolu_01XKh23WWBhyrZEKyGvoPgzA\":{\"command\":\"mkdir -p /tmp/x22cc1b-shots && cat > /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181307__x22cc1b/work/Rewired-TheWire-claude-opus-5-5-medium-20261102-181307/test/browser.py <<'EOF'\\n# Opens the bundled game in a real browser at deep links, collects console errors, takes screenshots.\\nimport sys, json, asyncio\\nfrom playwright.async_api import async_playwright\\nURL = 'http://127.0.0.1:18931/Rewired-TheWire-claude-opus-5-5-medium-20261102-181307.html'\\nOUT = sys.argv[1] if len(sys.argv) > 1 else '/tmp/x22cc1b-shots'\\nENGINE = sys.argv[2] if len(sys.argv) > 2 else 'chromium'\\nLINKS = sys.argv[3].split(',') if len(sys.argv) > 3 else ['', 'coldopen', 'corner', 'shift', 'reup', 'office', 'wire', 'stash', 'ending', 'montage', 'about', 'demo', 'chase']\\nasync def main():\\n    async with async_playwright() as p:\\n        b = await getattr(p, ENGINE).launch()\\n        errors = {}\\n        for link in LINKS:\\n            pg = await b.new_page(viewport={'width': 1280, 'height': 720})\\n            errs = []\\n            pg.on('console', lambda m, errs=errs: errs.append(m.text) if m.type == 'error' else None)\\n            pg.on('pageerror', lambda e, errs=errs: errs.append('PAGEERROR ' + str(e)))\\n            await pg.goto(URL + ('#' + link if link else ''))\\n            await pg.wait_for_timeout(3500)\\n            await pg.keyboard.press('KeyW')\\n            await pg.wait_for_timeout(600)\\n            snap = await pg.evaluate('JSON.stringify(My3D2dge.current.debug.snapshot()) + \\\" ERR \\\" + JSON.stringify((My3D2dge.current.errors||[]).map(e => String(e.message||e)).slice(0,3))')\\n            await pg.screenshot(path=f'{OUT}/{ENGINE}-{link or \\\"title\\\"}.png')\\n            errors[link or 'title'] = errs[:4]\\n            print(link or 'title', '|', snap[:300], '|', errs[:3])\\n            await pg.close()\\n        await b.close()\\nasyncio.run(main())\\nEOF\\ncd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181307__x22cc1b/work/Rewired-TheWire-claude-opus-5-5-medium-20261102-181307 && timeout 300 python3 test/browser.py 2>&1 | tail -20\",\"description\":\"Run browser deep-link check with screenshots\"}}}"," {\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"byl28ermm\",\"run_id\":\"0mw00spza-038b2143\",\"tool_use_id\":\"toolu_01XKh23WWBhyrZEKyGvoPgzA\",\"description\":\"Run browser deep-link check with screenshots\",\"is_backgrounded\":false,\"task_type\":\"local_bash\",\"uuid\":\"f1a6c027-cf0b-49d1-91e5-d20365691430\",\"session_id\":\"df8c1585-be07-48c4-a448-ca4232e59bdf\"}","+{\"type\":\"tool_progress\",\"tool_use_id\":\"toolu_01XKh23WWBhyrZEKyGvoPgzA-heartbeat-0\",\"tool_name\":\"Bash\",\"parent_tool_use_id\":\"toolu_01XKh23WWBhyrZEKyGvoPgzA\",\"elapsed_time_seconds\":30,\"heartb