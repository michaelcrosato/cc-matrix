s[k].at < 3).length, panic: panic > 0, fight|\\\" src/99-start.js && sed -i \\\"s|  enterCar, exitCar,|  glyphCode: (a, d) => codeFor(a, d), padStyle: () => input.padStyle(), touchOnly: () => touchOnly(), enterCar, exitCar,|\\\" src/99-start.js && node build.mjs && node test.mjs | tail -1 && cp ../TheSopraniacs-TheSopranos-claude-opus-5-5-medium-20261102-181316.html hubtest/game.html\\ncat > /tmp/x96eb17/feat.mjs <<'EOF'\\nimport { chromium, webkit, devices } from 'playwright';\\nconst file = process.argv[2]; const out = [];\\nconst ok = (n, c, d = '') => out.push((c ? 'ok   ' : 'FAIL ') + n + (c ? '' : ' ' + d));\\n// 1. a fake standard-mapping gamepad: left stick right, buttons settable\\nconst b = await chromium.launch(); const p = await b.newPage({ viewport: { width: 1280, height: 720 } });\\nawait p.addInitScript(() => {\\n  window.__pad = { axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })) };\\n  navigator.getGamepads = () => [{ id: 'DualSense Wireless Controller (STANDARD GAMEPAD Vendor: 054c Product: 0ce6)', index: 0, connected: true, mapping: 'standard', timestamp: performance.now(), axes: window.__pad.axes, buttons: window.__pad.buttons }];\\n});\\nawait p.goto('file://' + file); await p.waitForTimeout(2500);\\nconst ev = s => p.evaluate(s);\\nawait ev(`(() => { const D = My3D2dge.current.debug; D.newGame(3); })()`); await p.waitForTimeout(2500);\\nconst x0 = await ev(`My3D2dge.current.debug.snapshot().hero[0]`);\\nawait ev(`window.__pad.axes[0] = 0.95`); await p.waitForTimeout(700); await ev(`window.__pad.axes[0] = 0`); await p.waitForTimeout(200);\\nconst x1 = await ev(`My3D2dge.current.debug.snapshot().hero[0]`);\\nok('gamepad stick right moves Tony right', x1 > x0 + 20, [x0, x1]);\\nok('last device is the gamepad', await ev(`My3D2dge.current.input.lastDevice`) === 'gamepad');\\nok('PlayStation symbols by default', await ev(`My3D2dge.current.debug.padStyle()`) === 'playstation');\\nok('punch is Square (Pad2) on the pad', await ev(`My3D2dge.current.debug.glyphCode('attack','gamepad')`) === 'Pad2');\\nawait ev(`My3D2dge.current.settings.set('invertPadX', true)`);\\nawait ev(`window.__pad.axes[0] = 0.95`); await p.waitForTimeout(700); await ev(`window.__pad.axes[0] = 0`); await p.waitForTimeout(200);\\nconst x2 = await ev(`My3D2dge.current.debug.snapshot().hero[0]`);\\nok('invert horizontal: stick right moves left', x2 < x1 - 20, [x1, x2]);\\nawait ev(`My3D2dge.current.settings.set('invertPadX', false); My3D2dge.current.settings.set('invertPadY', true)`);\\nconst y0 = await ev(`My3D2dge.current.debug.snapshot().hero[1]`);\\nawait ev(`window.__pad.axes[1] = 0.95`); await p.waitForTimeout(600); await ev(`window.__pad.axes[1] = 0`); await p.waitForTimeout(200);\\nconst y1 = await ev(`My3D2dge.current.debug.snapshot().hero[1]`);\\nok('invert vertical: stick down moves up', y1 < y0 - 15, [y0, y1]);\\nawait ev(`My3D2dge.current.settings.set('invertPadY', false); My3D2dge.current.settings.set('glyphs', 'xbox')`);\\nok('Xbox symbols option', await ev(`My3D2dge.current.debug.padStyle()`) === 'xbox');\\nawait p.screenshot({ path: '/tmp/x96eb17/pad-xbox.png' });\\nawait ev(`My3D2dge.current.settings.set('glyphs', 'playstation')`);\\nawait p.keyboard.press('KeyW'); await p.waitForTimeout(200);\\nok('keyboard use switches prompts to keys', await ev(`My3D2dge.current.input.lastDevice`) === 'keyboard' && await ev(`My3D2dge.current.debug.glyphCode('attack','keyboard')`) === 'KeyJ');\\nawait p.mouse.move(600, 300); await p.mouse.move(640, 330); await p.waitForTimeout(200);\\nok('mouse use switches prompts to mouse buttons', await ev(`My3D2dge.current.input.lastDevice`) === 'mouse' && await ev(`My3D2dge.current.debug.glyphCode('fire','mouse')`) === 'Mouse2');\\nawait p.screenshot({ path: '/tmp/x96eb17/pad-mouse.png' });\\n// the stomp: a downed foe takes the plunge\\nawait ev(`(() => { const D = My3D2dge.current.debug; D.skip(4); })()`); await p.waitForTimeout(2000);\\nconst st = await ev(`(() => { const D = My3D2dge.current.debug; D.teleport(24*16, 36.6*16); D.talk.close(); return 1; })()`); await p.waitForTimeout(1500);\\nfor (let i = 0; i < 8; i++) { await p.keyboard.press('Enter'); await p.waitForTimeout(250); }\\nawait p.waitForTimeout(500);\\nconst hp = await ev(`(() => { const D = My3D2dge.current.debug, f = D.foes()[0]; Object.assign(f, { knocked: true, down: 1, floor: 5, t: 99 }); D.teleport(f.x - 14, f.y); window.__f = f; return f.hp; })()`);\\nawait p.keyboard.press('KeyK'); await p.waitForTimeout(900);\\nconst hp2 = await ev(`window.__f.hp`);\\nok('Triangle/K on a downed foe stomps (damage)', hp2 < hp, [hp, hp2]);\\n// a panic attack from stress\\nawait ev(`(() => { const D = My3D2dge.current.debug; D.foes().forEach(f => f.t = 99); D.state().stress = 99; })()`);\\nawait p.keyboard.press('KeyK'); await p.waitForTimeout(100);\\nawait ev(`(() => { const s = My3D2dge.current.debug.state(); })()`);\\nawait b.close();\\n// 2. touch-only phone: notice, then attract runs, then a tap exits\\nconst w = await webkit.launch(); const c = await w.newContext({ ...devices['iPhone 15'] }); const q = await c.newPage();\\nawait q.goto('file://' + file); await q.waitForTimeout(2500);\\nok('touch-only detected on iPhone', await q.evaluate(`My3D2dge.current.debug.touchOnly()`) === true);\\nawait q.waitForTimeout(11000);\\nconst s1 = await q.evaluate(`My3D2dge.current.debug.snapshot()`);\\nok('touch-only: attract mode runs', s1.attract && s1.scene === 'play', JSON.stringify(s1));\\nawait q.waitForTimeout(8000);\\nok('attract keeps playing (no errors)', (await q.evaluate(`My3D2dge.current.debug.snapshot()`)).errors === 0);\\nawait q.touchscreen.tap(150, 400); await q.waitForTimeout(1500);\\nok('a tap leaves attract', (await q.evaluate(`My3D2dge.current.debug.snapshot()`)).scene === 'title');\\nawait w.close();\\nconsole.log(out.join('\\\\n'));\\nEOF\\ncd /tmp/x96eb17 && node feat.mjs /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-1