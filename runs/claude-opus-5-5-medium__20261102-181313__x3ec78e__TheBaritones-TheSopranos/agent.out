Glyphs();","-if (game.settings.onChange !== undefined || true) {","-  const prev = game.settings.onChange;","-  game.settings.onChange = function (k, v) { if (k === 'glyphs') applyGlyphs(); if (typeof prev === 'function') return prev.apply(this, arguments); };","-}"," // Some pads report their axes flipped. Settings → Controller → Invert horizontal / vertical: the engine reads the pad"," // through navigator.getGamepads, so the flip happens there, for play, menus and the right stick alike."," if (typeof navigator !== 'undefined' && navigator.getGamepads) {"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181313__x3ec78e/work/TheBaritones-TheSopranos-claude-opus-5-5-medium-20261102-181313/src/00-core.js"]}},"tool_result_meta":[{"id":"toolu_0179ZF4MbyBikjmi4RMyFmi5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
