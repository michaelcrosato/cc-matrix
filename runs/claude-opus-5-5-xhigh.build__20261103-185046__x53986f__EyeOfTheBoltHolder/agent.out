t page.evaluate(() => window.__game.debug.snapshot());\n    t.check('the walk pulled the lever and went through the gate', s2.cell[1] <= 10 && s2.flags !== undefined, JSON.stringify(s2.cell));\n    t.check('a fight happened (something took harm or died)', await page.evaluate(() => window.__game.debug.S.stats.kills > 0 || window.__game.debug.S.party.members.some(m => m.hp < m.max) || window.__game.debug.S.floors.f1.mons.some(m => m.hp < m.max)));\n    t.check('no errors in play', !errors.length && !(await page.evaluate(() => window.__game.errors.length)), errors.concat(await page.evaluate(() => window.__game.errors.map(e => e.message))).join(' | '));\n    // the attract mode from the title\n    await page.evaluate(() => window.__game.go('title')); await page.mouse.move(5, 5); await page.waitForTimeout(10900);\n    t.check('10.5 s idle on the title starts the attract mode', await page.evaluate(() => window.__game.sceneName) === 'attract');\n    await page.waitForTimeout(2500); await page.keyboard.press('KeyZ'); await page.waitForTimeout(700);\n    t.check('a key returns to the title', await page.evaluate(() => window.__game.sceneName) === 'title');\n  } finally { await browser.close(); }\n  // a phone held upright: the notice, no touch controls\n  const ph = await open({ ctx: { viewport: { width: 390, height: 844 }, deviceScaleFactor: 3, isMobile: true, hasTouch: true } });\n  try {\n    await bootWait(ph.page); await ph.page.waitForTimeout(800);\n    t.check('touch-only: the notice', await ph.page.evaluate(() => window.__game.debug.B.touchOnly()));\n    t.check('touch-only: no touch stick or buttons', await ph.page.evaluate(() => window.__game.input.touchEnabled === false && !document.querySelector('[data-act]')));\n    t.check('touch-only: no errors', !ph.errors.length, ph.errors.join(' | '));\n  } finally { await ph.browser.close(); }\n  // the engine's checker\n  let out = ''; try { out = execFileSync('node', [new URL('../../tools/engine-tools/check.mjs', import.m