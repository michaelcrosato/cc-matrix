{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh9yxt2SmwWrcRGzMfaX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VhoiqB9jDJ5uTpqaLWVp5w","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-185046__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-xhigh-20261103-185046/tests/suites && cat > dev.mjs <<'EOF'\n// dev: each slider changes its system; reset restores the defaults; every cheat works; warps; spawning; storage persists\nimport { fresh, sim, at } from '../util.mjs';\nexport async function run(t) {\n  const { B, game, store, D } = await fresh(), S = () => B.S, Dev = B.Dev;\n  at(B, 'f1', 10, 6, 1); S().floors.f1.mons.length = 0;\n  const r1 = B.spawnMon(S().floors.f1, 'rat', 11, 6, {}); B.T.monHP = 2; const r2 = B.spawnMon(S().floors.f1, 'rat', 11, 6, {});\n  t.check('Monster HP x2 doubles a new rat\\'s HP', r2.max === r1.max * 2);\n  Dev.tab = 0; const rows = Dev.rows(); rows[0].act(); t.check('Reset to defaults restores every number', B.TUNE.every(([, k, , d]) => B.T[k] === d));\n  B.T.partyDmg = 4; at(B, 'f1', 10, 6, 1); S().floors.f1.mons.length = 0; const dm = B.spawnMon(S().floors.f1, 'skeleton', 11, 6, { asleep: true }); dm.hp = dm.max = 9999; let total = 0;\n  for (let i = 0; i < 200; i++) { S().party.members[0].cool.main = 0; const h = dm.hp; B.handAct(0, 'main'); total += h - dm.hp; dm.st = 'asleep'; } B.tuneDefaults();\n  t.check('Party damage x4 hits about four times as hard', total / 200 > 8, (total / 200).toFixed(1));\n  Dev.save(); t.check('the tuning persists in storage', !!store.get('boltholder.dev') && JSON.parse(store.get('boltholder.dev')).T.partyDmg === 1);\n  // cheats\n  const cheat = (k, v) => { B.CHEATS[k] = v; };\n  at(B, 'f1', 2, 8, 0); cheat('god', true); for (const m of S().party.members) B.hurtMember(m, 99); t.check('God mode: no harm', S().party.members.every(m => m.hp === m.max)); cheat('god', false);\n  at(B, 'f1', 2, 13, 0); cheat('noclip', true); B.update(1 / 120, [{ c: 'move', d: 'r' }]); sim(B, .4); t.check('Noclip walks through walls', S().party.cx === 3); cheat('noclip', false);\n  at(B, 'f1', 2, 8, 0); cheat('oneHit', true); S().floors.f1.mons.length = 0; const big = B.spawnMon(S().floors.f1, 'snick', 2, 7, {}); B.hurtMon(big, 1); t.check('One-hit kills', big.hp <= 0); cheat('oneHit', false);\n  cheat('reveal', true); t.check('Reveal map shows every cell', B.seen(20, 13, 'f1')); cheat('reveal', false);\n  at(B, 'f1', 2, 9, 0); S().floors.f1.doors.G1.open = 1; cheat('freeze', true); const pos = S().floors.f1.mons.map(m => m.cx + ',' + m.cy).join('|'); sim(B, 3); t.check('Freeze monsters stops them', S().floors.f1.mons.map(m => m.cx + ',' + m.cy).join('|') === pos); cheat('freeze', false);\n  cheat('noCooldowns', true); at(B, 'f1', 2, 8, 0); B.handAct(0, 'main'); t.check('No cooldowns', S().party.members[0].cool.main <= .06); cheat('noCooldowns', false);\n  cheat('infiniteSpells', true); at(B, 'f1', 2, 8, 0); const od = S().party.members[3]; for (let i = 0; i < 4; i++) { od.cool.main = od.cool.off = 0; B.castCmd(3, 'sparkDart', {}); } t.check('Infinite spells', B.readySpells(od).sparkDart >= 1); cheat('infiniteSpells', false);\n  cheat('noHunger', true); at(B, 'f1', 2, 8, 0); sim(B, 70); t.check('No hunger', S().party.members.every(m => m.food === 100)); cheat('noHunger', false);\n  // warps: every waypoint of every floor\n  Dev.tab = Dev.tabs.indexOf('Warp');\n  for (let f = 0; f < 4; f++) { Dev.warpF = f; const ws = Dev.rows().filter(r => r.act && !/Next floor|Boss|Ending/.test(r.label) && !/Floor:/.test(r.label)); for (const w of ws) { w.act(); const wp = B.FLOORS[B.FLOOR_ORDER[f]].waypoints.find(q => q[0] === w.label); t.check('warp: ' + w.label, wp && S().floor === B.FLOOR_ORDER[f] && S().party.cx === wp[1] && S().party.cy === wp[2]); } }\n  Dev.rows().find(r => r.label === 'Boss').act(); t.check('warp: the boss', S().floor === 'f4' && S().party.cy === 6);\n  // spawning and the party tools\n  Dev.tab = Dev.tabs.indexOf('Spawn'); at(B, 'f1', 10, 6, 1); S().floors.f1.mons.length = 0; Dev.spawnT = 0; Dev.spawnN = 2; Dev.rows().find(r => r.label === 'Spawn in front').act();\n  t.check('spawn in front: a group of two', S().floors.f1.mons.filter(m => m.cx === 11 && m.cy === 6).length === 2);\n  Dev.rows().find(r => r.label === 'Kill all on this floor').act(); t.check('kill all', S().floors.f1.mons.every(m => m.hp <= 0));\n  Dev.tab = Dev.tabs.indexOf('Party'); S().party.members[0].hp = 1; Dev.rows().find(r => r.label === 'Heal all').act(); t.check('heal all', S().party.members[0].hp === S().party.members[0].max);\n  const l0 = S().party.members[0].lvl; Dev.rows().find(r => r.label === '+1 level for everyone').act(); t.check('+1 level', S().party.members[0].lvl === l0 + 1);\n  Dev.npcI = 1; Dev.rows().find(r => /Add NPC/.test(r.label)).act(); t.check('add an NPC', S().party.members.some(m => m.npc === 'durgan'));\n  t.check('in a session there is no Dev Mode', (() => { B.Hub.active = true; const r = B.pauseItems(); B.Hub.active = false; return !r.some(i => i[0] === 'Dev Mode'); })());\n  t.check('no game errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n}\nEOF\ncat > attract.mjs <<'EOF'\n// attract: 10 s idle on the title starts it (9.9 s does not); every vignette runs with no errors; any input exits to the\n// title within a step; it writes no saves, settings or Dev storage; touch-only devices still get it, and the notice\nimport { fresh } from '../util.mjs';\nexport async function run(t) {\n  const { B, game, I, store } = await fresh();\n  game.advance(.5); t.check('at the title', game.sceneName === 'title');\n  const keys0 = [...store.keys()].sort().join(',');\n  game.advance(9.3); t.check('9.9 s idle: still the title', game.sceneName === 'title');\n  game.advance(.6); t.check('10 s idle: the attract mode', game.sceneName === 'attract');\n  const A = B.Attract; let seen = new Set();\n  for (let i = 0; i < 160 && seen.size < A.V.length; i++) { seen.add(A.vi); game.advance(1); }\n  t.check('every vignette plays', seen.size === A.V.length, [...seen].join(','));\n  t.check('the vignettes ran without errors', !game.errors.length, game.errors.map(e => e.where + ': ' + e.message).join(' | '));\n  I.press('KeyK'); game.advance(1 / 60); I.release('KeyK'); game.advance(.5); t.check('a key exits to the title', game.sceneName === 'title');\n  t.check('the player\\'s state is back (none)', !B.S);\n  game.advance(10.2); t.check('it starts again', game.sceneName === 'attract');\n  I.press('Pad3'); game.advance(1 / 60); I.release('Pad3'); game.advance(.5); t.check('a pad button exits', game.sceneName === 'title');\n  game.advance(10.2); I.feed('move', 50, 50); game.advance(.02); I.feed('move', 90, 90); game.advance(.4); t.check('the mouse moving exits', game.sceneName === 'title');\n  game.advance(10.2); I.feed('down', 60, 60, { touch: true }); game.advance(.02); I.feed('up', 60, 60, { touch: true }); game.advance(.4); t.check('a tap exits', game.sceneName === 'title');\n  const keys1 = [...store.keys()].filter(k => !/settings|bindings/.test(k)).sort().join(','); t.check('no saves or dev storage written', keys1 === keys0.split(',').filter(k => k && !/settings|bindings/.test(k)).join(','), keys1);\n  // a touch-only device: the notice, and the attract mode still runs\n  const T = await fresh({ coarse: true }); T.game.advance(.5);\n  t.check('touch-only: the title knows', T.B.touchOnly());\n  T.game.advance(10.2); t.check('touch-only: the attract mode runs', T.game.sceneName === 'attract');\n  t.check('touch-only: no touch controls', T.game.input.touchEnabled === false);\n}\nEOF\ncat > hub.mjs <<'EOF'\n// hub (Node, a stub AIHub): connect first; the title skipped; our card; ready() once with no key; Ready and More time;\n// play from time() 0; sends <= 10 Hz unreliable; progress about once a second; one result; time-up; ghosts; leave; end;\n// no saves or Dev Mode; Options ignored while Create is held\nimport { fresh } from '../util.mjs';\nfunction stub() {\n  const h = { calls: [], handlers: {}, t: -Infinity, active: true, sends: [], progress: [], results: [], answers: [], ready: 0 };\n  let s = 12345; const rng = label => { let a = 0; for (const c of label) a = (a * 31 + c.charCodeAt(0)) >>> 0; a ^= s; return () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; };\n  const info = { me: 0, players: [{ id: 0, name: 'Ann', color: '#e8443a' }, { id: 1, name: '<b>Bo</b>', color: '#3b82f6' }], mode: 'ghost', round: 1, limitMs: 240000, seed: 77 };\n  const A = { active: true, connect(o) { h.calls.push(['connect', o]); return Promise.resolve(info); }, ready() { h.ready++; }, answer(a) { h.answers.push(a); }, time() { return h.t; },\n    on(ev, fn) { (h.handlers[ev] || (h.handlers[ev] = [])).push(fn); return () => {}; }, progress(p) { h.progress.push([h.t, p]); }, result(r) { h.results.push(r); }, send(d, o) { h.sends.push([h.t, d, o]); return true; }, rng, seeded: true };\n  h.A = A; h.emit = (ev, ...a) => (h.handlers[ev] || []).forEach(f => f(...a)); return h;\n}\nexport async function run(t) {\n  const h = stub();\n  const { B, game, I } = await fresh({ hub: h.A, before: ctx => { ctx.__hubInfo = ctx.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }); } });\n  game.advance(.6);\n  t.check('connect: ghost, seats 1 to 4, our own card', h.calls[0] && h.calls[0][1].mode === 'ghost' && JSON.stringify(h.calls[0][1].seats) === '[1,4]' && h.calls[0][1].card === true);\n  t.check('in a session the title is skipped for our card', game.sceneName === 'hubcard');\n  t.check('ready() once, with no key press', h.ready === 1);\n  h.emit('card', { left: 9000, ready: [], asking: 0 }); I.tap('confirm'); game.advance(.1); t.check('Enter answers Ready', h.answers.includes('ready'));\n  I.tap('mTri'); game.advance(.1); t.check('Triangle asks for more time', h.answers.includes('more'));\n  h.emit('start', { in: 3000 }); h.t = -3000; game.advance(.5); t.check('start: the race plays', game.sceneName === 'play' && B.S.race);\n  const c0 = B.S.party.cy; I.hold('fwd'); game.advance(.5); I.hold('fwd', false); t.check('the countdown locks input', B.S.party.cy === c0);\n  h.t = 10; game.advance(.1); I.hold('fwd'); game.advance(.6); I.hold('fwd', false); game.advance(.3); t.check('at time 0 play begins', B.S.party.cy !== c0 || B.S.party.cx !== 1);\n  const ns = h.sends.length; for (let i = 0; i < 240; i++) { h.t += 1000 / 120; game.advance(1 / 120); }\n  const sent = h.sends.slice(ns); t.check('it sends about 10 times a second, unreliably', sent.length >= 15 && sent.length <= 21 && sent.every(s => s[2] && s[2].reliable === false), sent.length);\n  t.check('each send says where it is', sent.every(s => s[1].t === 'g' && s[1].area === 'race' && typeof s[1].x === 'number'));\n  t.check('progress about once a second', h.progress.length >= 1 && h.progress.length <= 4, h.progress.length);\n  h.emit('message', { t: 'g', area: 'race', cx: 1, cy: 9, dir: 0, x: 48, y: 304, yaw: -1.57, cp: 0, hp: 4 }, 1); game.advance(.1);\n  t.check('another player\\'s message makes a ghost', B.view.ghosts.has('p1'));\n  h.emit('leave', { id: 1, reason: 'left' }); game.advance(.1); t.check('leave removes the ghost', !B.view.ghosts.has('p1'));\n  t.check('no saves in a session', game.saves.canSave === false && game.saves.canLoad === false);\n  t.check('no Dev Mode, Load or Quit in a session\\'s pause menu', B.pauseItems().length === 0 && game.o.menu.quit === false);\n  I.hold('Pad8'); game.advance(.05); I.press('Pad9'); game.advance(1 / 60); I.release('Pad9'); game.advance(.05); I.hold('Pad8', false); game.advance(.1);\n  t.check('Options is ignored while Create is held', !game.paused && !game.debug.UI.top());\n  // finish: the exit\n  B.S.party.cx = 12; B.S.party.cy = 2; B.S.party.dir = 0; B.S.floors.race.doors.RG2.open = 1; B.update(1 / 120, [{ c: 'move', d: 'f' }]); for (let i = 0; i < 120; i++) { h.t += 8; game.advance(1 / 120); }\n  t.check('reaching the exit sends one result with a time', h.results.length === 1 && typeof h.results[0].time === 'number' && h.results[0].stats);\n  t.check('and tells the others', h.sends.some(s => s[1].t === 'done'));\n  h.emit('time-up', { graceMs: 5000 }); game.advance(.1); t.check('time-up after a result sends no second one', h.results.length === 1);\n  h.emit('end', { reason: 'finished', standings: [[0], [1]] }); game.advance(.2); t.check('end: input stops and sound mutes', game.audio.muted === true);\n  t.check('no game errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n  // a wipe and a time-up without a finish: a score\n  const h2 = stub(); const E2 = await fresh({ hub: h2.A, before: ctx => { ctx.__hubInfo = ctx.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }); } });\n  E2.game.advance(.5); h2.emit('start', {}); h2.t = 100; E2.game.advance(.5); h2.emit('time-up', { graceMs: 5000 }); E2.game.advance(.1);\n  t.check('time-up sends a score', h2.results.length === 1 && typeof h2.results[0].score === 'number');\n}\nEOF\ncd ../.. && timeout 600 node tests/run.mjs dev attract hub 2>&1 | tail -20","description":"Write and run the dev, attract and hub suites","timeout":620000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":549,"cache_read_input_tokens":788224,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":549},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d562a4a4-1880-473a-a05f-38e08e0d0050","uuid":"c8009d21-6c6f-40fd-9b91-74e337cbd6d0","timestamp":"2026-11-04T03:12:23.048Z","request_id":"req_011Cgh9yxYgbXjz9GUxk5BVt","wire_tool_inputs":{"toolu_01VhoiqB9jDJ5uTpqaLWVp5w":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-185046__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-xhigh-20261103-185046/tests/suites && cat > dev.mjs <<'EOF'\n// dev: each slider changes its system; reset restores the defaults; every cheat works; warps; spawning; storage persists\nimport { fresh, sim, at } from '../util.mjs';\nexport async function run(t) {\n  const { B, game, store, D } = await fresh(), S = () => B.S, Dev = B.Dev;\n  at(B, 'f1', 10, 6, 1); S().floors.f1.mons.length = 0;\n  const r1 = B.spawnMon(S().floors.f1, 'rat', 11, 6, {}); B.T.monHP = 2; const r2 = B.spawnMon(S().floors.f1, 'rat', 11, 6, {});\n  t.check('Monster HP x2 doubles a new rat\\'s HP', r2.max === r1.max * 2);\n  Dev.tab = 0; const rows = Dev.rows(); rows[0].act(); t.check('Reset to defaults restores every number', B.TUNE.every(([, k, , d]) => B.T[k] === d));\n  B.T.partyDmg = 4; at(B, 'f1', 10, 6, 1); S().floors.f1.mons.length = 0; const dm = B.spawnMon(S().floors.f1, 'skeleton', 11, 6, { asleep: true }); dm.hp = dm.max = 9999; let total = 0;\n  for (let i = 0; i < 200; i++) { S().party.members[0].cool.main = 0; const h = dm.hp; B.handAct(0, 'main'); total += h - dm.hp; dm.st = 'asleep'; } B.tuneDefaults();\n  t.check('Party damage x4 hits about four times as hard', total / 200 > 8, (total / 200).toFixed(1));\n  Dev.save(); t.check('the tuning persists in storage', !!store.get('boltholder.dev') && JSON.parse(store.get('boltholder.dev')).T.partyDmg === 1);\n  // cheats\n  const cheat = (k, v) => { B.CHEATS[k] = v; };\n  at(B, 'f1', 2, 8, 0); cheat('god', true); for (const m of S().party.members) B.hurtMember(m, 99); t.check('God mode: no harm', S().party.members.every(m => m.hp === m.max)); cheat('god', false);\n  at(B, 'f1', 2, 13, 0); cheat('noclip', true); B.update(1 / 120, [{ c: 'move', d: 'r' }]); sim(B, .4); t.check('Noclip walks through walls', S().party.cx === 3); cheat('noclip', false);\n  at(B, 'f1', 2, 8, 0); cheat('oneHit', true); S().floors.f1.mons.length = 0; const big = B.spawnMon(S().floors.f1, 'snick', 2, 7, {}); B.hurtMon(big, 1); t.check('One-hit kills', big.hp <= 0); cheat('oneHit', false);\n  cheat('reveal', true); t.check('Reveal map shows every cell', B.seen(20, 13, 'f1')); cheat('reveal', false);\n  at(B, 'f1', 2, 9, 0); S().floors.f1.doors.G1.open = 1; cheat('freeze', true); const pos = S().floors.f1.mons.map(m => m.cx + ',' + m.cy).join('|'); sim(B, 3); t.check('Freeze monsters stops them', S().floors.f1.mons.map(m => m.cx + ',' + m.cy).join('|') === pos); cheat('freeze', false);\n  cheat('noCooldowns', true); at(B, 'f1', 2, 8, 0); B.handAct(0, 'main'); t.check('No cooldowns', S().party.members[0].cool.main <= .06); cheat('noCooldowns', false);\n  cheat('infiniteSpells', true); at(B, 'f1', 2, 8, 0); const od = S().party.members[3]; for (let i = 0; i < 4; i++) { od.cool.main = od.cool.off = 0; B.castCmd(3, 'sparkDart', {}); } t.check('Infinite spells', B.readySpells(od).sparkDart >= 1); cheat('infiniteSpells', false);\n  cheat('noHunger', true); at(B, 'f1', 2, 8, 0); sim(B, 70); t.check('No hunger', S().party.members.every(m => m.food === 100)); cheat('noHunger', false);\n  // warps: every waypoint of every floor\n  Dev.tab = Dev.tabs.indexOf('Warp');\n  for (let f = 0; f < 4; f++) { Dev.warpF = f; const ws = Dev.rows().filter(r => r.act && !/Next floor|Boss|Ending/.test(r.label) && !/Floor:/.test(r.label)); for (const w of ws) { w.act(); const wp = B.FLOORS[B.FLOOR_ORDER[f]].waypoints.find(q => q[0] === w.label); t.check('warp: ' + w.label, wp && S().floor === B.FLOOR_ORDER[f] && S().party.cx === wp[1] && S().party.cy === wp[2]); } }\n  Dev.rows().find(r => r.label === 'Boss').act(); t.check('warp: the boss', S().floor === 'f4' && S().party.cy === 6);\n  // spawning and the party tools\n  Dev.tab = Dev.tabs.indexOf('Spawn'); at(B, 'f1', 10, 6, 1); S().floors.f1.mons.length = 0; Dev.spawnT = 0; Dev.spawnN = 2; Dev.rows().find(r => r.label === 'Spawn in front').act();\n  t.check('spawn in front: a group of two', S().floors.f1.mons.filter(m => m.cx === 11 && m.cy === 6).length === 2);\n  Dev.rows().find(r => r.label === 'Kill all on this floor').act(); t.check('kill all', S().floors.f1.mons.every(m => m.hp <= 0));\n  Dev.tab = Dev.tabs.indexOf('Party'); S().party.members[0].hp = 1; Dev.rows().find(r => r.label === 'Heal all').act(); t.check('heal all', S().party.members[0].hp === S().party.members[0].max);\n  const l0 = S().party.members[0].lvl; Dev.rows().find(r => r.label === '+1 level for everyone').act(); t.check('+1 level', S().party.members[0].lvl === l0 + 1);\n  Dev.npcI = 1; Dev.rows().find(r => /Add NPC/.test(r.label)).act(); t.check('add an NPC', S().party.members.some(m => m.npc === 'durgan'));\n  t.check('in a session there is no Dev Mode', (() => { B.Hub.active = true; const r = B.pauseItems(); B.Hub.active = false; return !r.some(i => i[0] === 'Dev Mode'); })());\n  t.check('no game errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n}\nEOF\ncat > attract.mjs <<'EOF'\n// attract: 10 s idle on the title starts it (9.9 s does not); every vignette runs with no errors; any input exits to the\n// title within a step; it writes no saves, settings or Dev storage; touch-only devices still get it, and the notice\nimport { fresh } from '../util.mjs';\nexport async function run(t) {\n  const { B, game, I, store } = await fresh();\n  game.advance(.5); t.check('at the title', game.sceneName === 'title');\n  const keys0 = [...store.keys()].sort().join(',');\n  game.advance(9.3); t.check('9.9 s idle: still the title', game.sceneName === 'title');\n  game.advance(.6); t.check('10 s idle: the attract mode', game.sceneName === 'attract');\n  const A = B.Attract; let seen = new Set();\n  for (let i = 0; i < 160 && seen.size < A.V.length; i++) { seen.add(A.vi); game.advance(1); }\n  t.check('every vignette plays', seen.size === A.V.length, [...seen].join(','));\n  t.check('the vignettes ran without errors', !game.errors.length, game.errors.map(e => e.where + ': ' + e.message).join(' | '));\n  I.press('KeyK'); game.advance(1 / 60); I.release('KeyK'); game.advance(.5); t.check('a key exits to the title', game.sceneName === 'title');\n  t.check('the player\\'s state is back (none)', !B.S);\n  game.advance(10.2); t.check('it starts again', game.sceneName === 'attract');\n  I.press('Pad3'); game.advance(1 / 60); I.release('Pad3'); game.advance(.5); t.check('a pad button exits', game.sceneName === 'title');\n  game.advance(10.2); I.feed('move', 50, 50); game.advance(.02); I.feed('move', 90, 90); game.advance(.4); t.check('the mouse moving exits', game.sceneName === 'title');\n  game.advance(10.2); I.feed('down', 60, 60, { touch: true }); game.advance(.02); I.feed('up', 60, 60, { touch: true }); game.advance(.4); t.check('a tap exits', game.sceneName === 'title');\n  const keys1 = [...store.keys()].filter(k => !/settings|bindings/.test(k)).sort().join(','); t.check('no saves or dev storage written', keys1 === keys0.split(',').filter(k => k && !/settings|bindings/.test(k)).join(','), keys1);\n  // a touch-only device: the notice, and the attract mode still runs\n  const T = await fresh({ coarse: true }); T.game.advance(.5);\n  t.check('touch-only: the title knows', T.B.touchOnly());\n  T.game.advance(10.2); t.check('touch-only: the attract mode runs', T.game.sceneName === 'attract');\n  t.check('touch-only: no touch controls', T.game.input.touchEnabled === false);\n}\nEOF\ncat > hub.mjs <<'EOF'\n// hub (Node, a stub AIHub): connect first; the title skipped; our card; ready() once with no key; Ready and More time;\n// play from time() 0; sends <= 10 Hz unreliable; progress about once a second; one result; time-up; ghosts; leave; end;\n// no saves or Dev Mode; Options ignored while Create is held\nimport { fresh } from '../util.mjs';\nfunction stub() {\n  const h = { calls: [], handlers: {}, t: -Infinity, active: true, sends: [], progress: [], results: [], answers: [], ready: 0 };\n  let s = 12345; const rng = label => { let a = 0; for (const c of label) a = (a * 31 + c.charCodeAt(0)) >>> 0; a ^= s; return () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; };\n  const info = { me: 0, players: [{ id: 0, name: 'Ann', color: '#e8443a' }, { id: 1, name: '<b>Bo</b>', color: '#3b82f6' }], mode: 'ghost', round: 1, limitMs: 240000, seed: 77 };\n  const A = { active: true, connect(o) { h.calls.push(['connect', o]); return Promise.resolve(info); }, ready() { h.ready++; }, answer(a) { h.answers.push(a); }, time() { return h.t; },\n    on(ev, fn) { (h.handlers[ev] || (h.handlers[ev] = [])).push(fn); return () => {}; }, progress(p) { h.progress.push([h.t, p]); }, result(r) { h.results.push(r); }, send(d, o) { h.sends.push([h.t, d, o]); return true; }, rng, seeded: true };\n  h.A = A; h.emit = (ev, ...a) => (h.handlers[ev] || []).forEach(f => f(...a)); return h;\n}\nexport async function run(t) {\n  const h = stub();\n  const { B, game, I } = await fresh({ hub: h.A, before: ctx => { ctx.__hubInfo = ctx.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }); } });\n  game.advance(.6);\n  t.check('connect: ghost, seats 1 to 4, our own card', h.calls[0] && h.calls[0][1].mode === 'ghost' && JSON.stringify(h.calls[0][1].seats) === '[1,4]' && h.calls[0][1].card === true);\n  t.check('in a session the title is skipped for our card', game.sceneName === 'hubcard');\n  t.check('ready() once, with no key press', h.ready === 1);\n  h.emit('card', { left: 9000, ready: [], asking: 0 }); I.tap('confirm'); game.advance(.1); t.check('Enter answers Ready', h.answers.includes('ready'));\n  I.tap('mTri'); game.advance(.1); t.check('Triangle asks for more time', h.answers.includes('more'));\n  h.emit('start', { in: 3000 }); h.t = -3000; game.advance(.5); t.check('start: the race plays', game.sceneName === 'play' && B.S.race);\n  const c0 = B.S.party.cy; I.hold('fwd'); game.advance(.5); I.hold('fwd', false); t.check('the countdown locks input', B.S.party.cy === c0);\n  h.t = 10; game.advance(.1); I.hold('fwd'); game.advance(.6); I.hold('fwd', false); game.advance(.3); t.check('at time 0 play begins', B.S.party.cy !== c0 || B.S.party.cx !== 1);\n  const ns = h.sends.length; for (let i = 0; i < 240; i++) { h.t += 1000 / 120; game.advance(1 / 120); }\n  const sent = h.sends.slice(ns); t.check('it sends about 10 times a second, unreliably', sent.length >= 15 && sent.length <= 21 && sent.every(s => s[2] && s[2].reliable === false), sent.length);\n  t.check('each send says where it is', sent.every(s => s[1].t === 'g' && s[1].area === 'race' && typeof s[1].x === 'number'));\n  t.check('progress about once a second', h.progress.length >= 1 && h.progress.length <= 4, h.progress.length);\n  h.emit('message', { t: 'g', area: 'race', cx: 1, cy: 9, dir: 0, x: 48, y: 304, yaw: -1.57, cp: 0, hp: 4 }, 1); game.advance(.1);\n  t.check('another player\\'s message makes a ghost', B.view.ghosts.has('p1'));\n  h.emit('leave', { id: 1, reason: 'left' }); game.advance(.1); t.check('leave removes the ghost', !B.view.ghosts.has('p1'));\n  t.check('no saves in a session', game.saves.canSave === false && game.saves.canLoad === false);\n  t.check('no Dev Mode, Load or Quit in a session\\'s pause menu', B.pauseItems().length === 0 && game.o.menu.quit === false);\n  I.hold('Pad8'); game.advance(.05); I.press('Pad9'); game.advance(1 / 60); I.release('Pad9'); game.advance(.05); I.hold('Pad8', false); game.advance(.1);\n  t.check('Options is ignored while Create is held', !game.paused && !game.debug.UI.top());\n  // finish: the exit\n  B.S.party.cx = 12; B.S.party.cy = 2; B.S.party.dir = 0; B.S.floors.race.doors.RG2.open = 1; B.update(1 / 120, [{ c: 'move', d: 'f' }]); for (let i = 0; i < 120; i++) { h.t += 8; game.advance(1 / 120); }\n  t.check('reaching the exit sends one result with a time', h.results.length === 1 && typeof h.results[0].time === 'number' && h.results[0].stats);\n  t.check('and tells the others', h.sends.some(s => s[1].t === 'done'));\n  h.emit('time-up', { graceMs: 5000 }); game.advance(.1); t.check('time-up after a result sends no second one', h.results.length === 1);\n  h.emit('end', { reason: 'finished', standings: [[0], [1]] }); game.advance(.2); t.check('end: input stops and sound mutes', game.audio.muted === true);\n  t.check('no game errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n  // a wipe and a time-up without a finish: a score\n  const h2 = stub(); const E2 = await fresh({ hub: h2.A, before: ctx => { ctx.__hubInfo = ctx.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }); } });\n  E2.game.advance(.5); h2.emit('start', {}); h2.t = 100; E2.game.advance(.5); h2.emit('time-up', { graceMs: 5000 }); E2.game.advance(.1);\n  t.check('time-up sends a score', h2.results.length === 1 && typeof h2.results[0].score === 'number');\n}\nEOF\ncd ../.. && timeout 600 node tests/run.mjs dev attract hub 2>&1 | tail -20","description":"Write and run the dev, attract and hub suites","timeout":620000}}}
