d()\na=\"      const ck = I.clicked(); if (ck) { const c = UI.cards().find(c => ck[0] >= c.x && ck[0] < c.x + c.w && ck[1] >= c.y && ck[1] < c.y + c.h); if (c) { this.pi = c.mi; I.tap('confirm'); } }\"\nb=\"      const ck = I.clicked(), hitC = ck && UI.cards().find(c => ck[0] >= c.x && ck[0] < c.x + c.w && ck[1] >= c.y && ck[1] < c.y + c.h);\\n      if (hitC) { B.cmd({ c: 'cast', m: this.m, spell: this.pick.id, target: hitC.mi }); UI.close(); return; }\"\nassert s.count(a)==1; s=s.replace(a,b)\na=\"      if (I.pressed('confirm') || (ck && UI.cards().some(c => c.mi === this.pi))) {\"\nassert s.count(a)==1; s=s.replace(a,\"      if (I.pressed('confirm')) {\")\nopen(p,'w').write(s)\nEOF\necho ok","description":"Simplify card-click targeting in the Cast menu"}},"wire_ingest_context":{"toolu_01HaZfAkwc2KZdu2gmJPVD76":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-185046__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-xhigh-20261103-185046"}}}
