"}},"wire_ingest_context":{"toolu_01VRmcTkXGhVWuGsdPmzY8bZ":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-185046__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-xhigh-20261103-185046"}}}
