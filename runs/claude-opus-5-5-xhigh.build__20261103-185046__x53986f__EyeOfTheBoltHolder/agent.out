{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh9dSRtVbYzQVG8q4AEh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018HbdENJXJ3eSaZ1z8XykZM","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-185046__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-xhigh-20261103-185046/tests/suites && cat > movement.mjs <<'EOF'\n// movement: steps, turns, strafes, the buffer and repeat; bumps; the timing of arrival effects; stairs and the floor card\nimport { fresh, run, at } from '../util.mjs';\nexport async function run_(t) {}\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 14, 0);\n  B.update(1 / 120, [{ c: 'move', d: 'f' }]);\n  t.check('the cell changes as the step starts', S().party.cx === 2 && S().party.cy === 13 && !!S().party.tw);\n  t.check('a plate is not pressed mid-step (arrival waits)', S().party.at === null);\n  run(B, .4); t.check('the step ends', !S().party.tw && S().party.at && S().party.at[1] === 13);\n  B.update(1 / 120, [{ c: 'turn', s: 1 }]); run(B, .3); t.check('a quarter turn right', S().party.dir === 1);\n  B.update(1 / 120, [{ c: 'turn', s: -1 }]); B.update(1 / 120, [{ c: 'move', d: 'f' }]); t.check('a move during a turn is buffered', !!S().party.queued);\n  run(B, .7); t.check('the buffered step runs after the turn', S().party.cy === 12 && S().party.dir === 0);\n  const before = [S().party.cx, S().party.cy];\n  B.update(1 / 120, [{ c: 'move', d: 'l' }]); run(B, .1); t.check('a wall bumps', S().party.cx === before[0] && S().party.bump > 0);\n  t.check('a bump says so', S().log.some(l => /can't go that way/.test(l.text)));\n  at(B, 'f1', 2, 11, 0); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .5);\n  t.check('a closed gate blocks', S().party.cy === 11 && S().log.some(l => /will not budge/.test(l.text)));\n  at(B, 'f1', 2, 14, 0); B.update(1 / 120, [{ c: 'move', d: 'b' }]); run(B, .5);\n  t.check('the sealed stair refuses', S().party.cy === 14 && S().log.some(l => /bolted fast/.test(l.text)));\n  at(B, 'f1', 15, 14, 2); S().floors.f1.doors.L2.open = 1; S().floors.f1.doors.L2.want = 1; S().floors.f1.doors.L2.locked = false;\n  B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .4);\n  t.check('the stairs start a floor change', !!S().transit && S().transit.k === 'stairs');\n  run(B, .6); t.check('the floor changes behind the fade', S().floor === 'f2' && S().party.cx === 2 && S().party.cy === 1 && S().party.dir === 1);\n  run(B, 2); t.check('the card ends', !S().transit);\n  at(B, 'f1', 2, 13, 0); B.stepMode = 'instant'; B.update(1 / 120, [{ c: 'move', d: 'f' }]);\n  t.check('instant steps arrive at once', !S().party.tw && S().party.at && S().party.at[1] === 12); B.stepMode = 'smooth';\n  at(B, 'f1', 2, 13, 0); B.T.stepT = .1; B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .12); t.check('the Step time slider times a step', !S().party.tw); B.tuneDefaults();\n  at(B, 'f1', 9, 8, 2); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .4);\n  t.check('an illusory wall walks like floor', S().party.cy === 9 && S().log.some(l => /illusion/.test(l.text)) && S().secrets.I1);\n}\nEOF\ncat > features.mjs <<'EOF'\n// features: doors, gates, locks, seals, secret walls, plates, darts, pits and trapdoors, teleporters, spinners, levers,\n// buttons, catches, alcoves, candles in order, Great Locks\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S, fl = () => B.S.floors[B.S.floor];\n  at(B, 'f1', 2, 11, 1); B.update(1 / 120, [{ c: 'use' }]); run(B, 1.2);\n  t.check('a lever opens its gate', S().floors.f1.feats.LV1.on && fl().doors.G1.open > .9);\n  B.update(1 / 120, [{ c: 'use' }]); run(B, 1.2); t.check('pulled again, it closes it (toggle)', fl().doors.G1.open < .1);\n  at(B, 'f1', 2, 4, 0); B.update(1 / 120, [{ c: 'use' }]); run(B, .8); t.check('a wooden door opens with use', fl().doors.D1.open > .85);\n  B.update(1 / 120, [{ c: 'use' }]); run(B, .8); t.check('and closes', fl().doors.D1.open < .1);\n  at(B, 'f1', 17, 4, 0); B.update(1 / 120, [{ c: 'use' }]); t.check('a locked door refuses without its key', fl().doors.L1.locked);\n  B.S.party.members[0].pack[5] = B.mkItem('ironKey'); B.update(1 / 120, [{ c: 'use' }]); run(B, .8);\n  t.check('the key from a pack opens it, used up', !fl().doors.L1.locked && fl().doors.L1.open > .85 && !B.findItem(r => r.id === 'ironKey'));\n  at(B, 'f1', 17, 4, 0, { party: [B.NPCS.tamsin] }); B.S.party.members[0].stats.dex = 18; let picked = false;\n  for (let i = 0; i < 12 && !picked; i++) { B.update(1 / 120, [{ c: 'use' }]); picked = !fl().doors.L1.locked; }\n  t.check('a thief picks a simple lock', picked);\n  at(B, 'f1', 15, 13, 2, { party: [B.NPCS.tamsin] }); for (let i = 0; i < 10; i++) B.update(1 / 120, [{ c: 'use' }]);\n  t.check('a warded lock refuses picks', fl().doors.L2.locked && S().log.some(l => /warded/.test(l.text)));\n  at(B, 'f1', 9, 5, 0); B.update(1 / 120, [{ c: 'use' }]); run(B, 1.5);\n  t.check('a loose stone opens the secret wall', fl().doors.H1.open > .85 && S().secrets.closet);\n  at(B, 'f1', 13, 6, 1); B.S.party.hand = B.mkItem('rock'); B.update(1 / 120, [{ c: 'putDown' }]); run(B, 1.2);\n  t.check('a rock put down on a plate holds its gate open', fl().plates.P1 && fl().doors.G2.open > .85);\n  B.update(1 / 120, [{ c: 'pick', x: 14, y: 6, i: 0 }]); run(B, 1.2); t.check('taken off, the hold plate lets the gate fall', !fl().plates.P1 && fl().doors.G2.open < .2);\n  at(B, 'f1', 14, 10, 1); const hp0 = B.S.party.members.reduce((a, m) => a + m.hp, 0); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .4);\n  t.check('a dart trap fires on entry', B.S.party.members.reduce((a, m) => a + m.hp, 0) < hp0 && S().log.some(l => /Darts/.test(l.text)));\n  at(B, 'f1', 13, 10, 0); B.update(1 / 120, [{ c: 'use' }]); run(B, 8); t.check('one button alone opens nothing', fl().doors.G4.want === 0);\n  at(B, 'f1', 13, 10, 0); B.update(1 / 120, [{ c: 'use' }]); run(B, 1); const P = B.S.party; P.cx = 18; P.cy = 10; P.dir = 2; B.update(1 / 120, [{ c: 'use' }]); run(B, 1);\n  t.check('both buttons within the window open the gate', fl().doors.G4.want === 1);\n  at(B, 'f2', 4, 12, 0); B.S.party.hand = B.mkItem('rock'); B.update(1 / 120, [{ c: 'throw' }]); run(B, 1.5);\n  t.check('a throw flies over a pit onto a plate, which bridges the pit', fl().plates.P2 && fl().pits.O1.bridged);\n  at(B, 'f2', 6, 10, 3); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, 1.2);\n  t.check('a trapdoor drops the party to the floor below', S().floor === 'f3' || (S().transit && S().transit.k === 'fall'));\n  run(B, 2.5); t.check('the fall lands in the Sump, hurt', S().floor === 'f3' && S().party.cx === 2 && S().party.cy === 15 && B.S.party.members.some(m => m.hp < m.max));\n  at(B, 'f2', 19, 10, 2); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .5);\n  t.check('a silent teleporter sends the party back', S().party.cx === 19 && S().party.cy === 5 && S().party.dir === 2 && fl().loops === 1);\n  at(B, 'f2', 19, 8, 1); B.update(1 / 120, [{ c: 'use' }]); run(B, .2); t.check('the catch turns the teleporter off', fl().tps.TP1 === false && S().secrets.catch);\n  at(B, 'f2', 18, 13, 2); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .5); t.check('the spinner twists the party', S().log.some(l => /twisting/.test(l.text)) && fl().spinSeen);\n  at(B, 'f2', 2, 9, 3); B.S.party.hand = B.mkItem('bentKey'); B.update(1 / 120, [{ c: 'use' }]); run(B, 1.2);\n  t.check('the riddle alcove takes a key, opens its gate and gives the key back', fl().doors.G6.open > .85 && B.S.party.hand && B.S.party.hand.id === 'bentKey');\n  at(B, 'f2', 10, 15, 2); B.S.party.dir = 2; B.update(1 / 120, [{ c: 'use' }]); B.S.party.cx = 12; B.update(1 / 120, [{ c: 'use' }]); run(B, 1.5);\n  t.check('the levers set by the creed open the Tumbler Lock', fl().doors.G5.want === 1);\n  at(B, 'f2', 10, 6, 3); B.update(1 / 120, [{ c: 'use' }]); t.check('a magic seal will not open by hand', fl().doors.M1.open === 0 && S().log.some(l => /runes/.test(l.text)));\n  at(B, 'f3', 16, 1, 0); const order = [[16, 1, 0], [18, 1, 0], [16, 5, 2]];\n  for (const [x, y, d] of order) { B.S.party.cx = x; B.S.party.cy = y; B.S.party.dir = d; B.update(1 / 120, [{ c: 'use' }]); }\n  t.check('a candle out of order puts them all out', !fl().feats.C1.lit && S().log.some(l => /gutter/.test(l.text)));\n  for (const [x, y, d] of [[16, 1, 0], [16, 5, 2], [18, 1, 0], [18, 5, 2], [20, 1, 0], [20, 5, 2]]) { B.S.party.cx = x; B.S.party.cy = y; B.S.party.dir = d; B.update(1 / 120, [{ c: 'use' }]); }\n  t.check('the candles in order give the Robe and a deed', S().special.sq3 && (fl().items['18,3'] || []).some(i => i.id === 'robeOfTheLintel'));\n  at(B, 'f1', 4, 5, 0); B.S.party.hand = B.mkItem('ratKingsCrown'); B.update(1 / 120, [{ c: 'use' }]);\n  t.check('the crown in the Rat Shrine: a deed and a ring', S().special.sq1 && fl().feats.AL1.items.some(i => i.id === 'ringOfMending'));\n  at(B, 'f2', 16, 1, 0); for (const [x, id] of [[16, 'CN1'], [17, 'CN2'], [19, 'CN3'], [20, 'CN4']]) { B.S.party.cx = x; B.S.party.hand = B.mkItem('tumblerGear'); B.update(1 / 120, [{ c: 'use' }]); }\n  t.check('four gears make the clock chime: a deed and the goggles', S().special.sq2 && fl().feats.CF.items.some(i => i.id === 'tumblerwrightsGoggles'));\n  at(B, 'f3', 12, 4, 2); for (const w of ['copperWard', 'brassWard', 'ironWard']) B.S.party.members[0].pack.push(B.mkItem(w)); for (const k of [0, 1, 2]) B.S.party.members[0].pack[9 + k] = B.mkItem(['copperWard', 'brassWard', 'ironWard'][k]);\n  B.update(1 / 120, [{ c: 'use' }]); B.update(1 / 120, [{ c: 'use' }]); t.check('two wards in: no opening yet', !S().moment && fl().doors.U1.wards === 2);\n  B.update(1 / 120, [{ c: 'use' }]); t.check('the third ward starts the Undergate moment', S().moment && S().moment.id === 'undergate');\n  run(B, 10.5); t.check('the Undergate opens', fl().doors.U1.open > .5 && !S().moment);\n}\nEOF\ncat > items.mjs <<'EOF'\n// items: equip rules, pack moves, the Hand (take, stow, put down, throw), use (eat, drink, read), rust, thieves' loot\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 13, 0); const P = S().party, br = P.members[0], od = P.members[3];\n  B.update(1 / 120, [{ c: 'pick', x: 2, y: 13, i: 0 }]); t.check('pick takes an item here into the Hand', P.hand && P.hand.id === 'rustyDagger');\n  B.update(1 / 120, [{ c: 'use' }]); t.check('use with the Hand and nothing ahead stows it', !P.hand && P.members.some(m => m.pack.some(i => i && i.id === 'rustyDagger')));\n  B.update(1 / 120, [{ c: 'use' }]); t.check('use takes the top item ahead (the rock)', P.hand && P.hand.id === 'rock');\n  B.update(1 / 120, [{ c: 'putDown' }]); t.check('put down sets it ahead', !P.hand && B.itemsAt(2, 12).some(i => i.id === 'rock'));\n  P.hand = B.mkItem('longSword'); B.update(1 / 120, [{ c: 'inv', op: 'place', m: 3, slot: 'main' }]); t.check('a mage cannot wield a long sword', P.hand && P.hand.id === 'longSword');\n  B.update(1 / 120, [{ c: 'inv', op: 'place', m: 0, slot: 'head' }]); t.check('a sword does not go on a head', P.hand.id === 'longSword');\n  P.hand = B.mkItem('lockbreaker'); B.update(1 / 120, [{ c: 'inv', op: 'place', m: 0, slot: 'main' }]); t.check('a two-handed axe needs the off hand free', P.hand.id === 'lockbreaker');\n  B.update(1 / 120, [{ c: 'inv', op: 'take', m: 0, slot: 'off' }]); t.check('the Hand is busy, so the shield stays', br.slots.off && br.slots.off.id === 'woodenShield');\n  P.hand = null; B.update(1 / 120, [{ c: 'inv', op: 'take', m: 0, slot: 'off' }]); B.update(1 / 120, [{ c: 'inv', op: 'place', m: 0, slot: 0 }]);\n  P.hand = B.mkItem('lockbreaker'); B.update(1 / 120, [{ c: 'inv', op: 'place', m: 0, slot: 'main' }]); t.check('with the off hand empty it swaps into the main hand', br.slots.main.id === 'lockbreaker' && P.hand.id === 'longSword');\n  P.hand = B.mkItem('arrows', 5); const q = P.members[1].slots.quiver.n; B.update(1 / 120, [{ c: 'inv', op: 'place', m: 1, slot: 'quiver' }]); t.check('ammo stacks into the quiver', !P.hand && P.members[1].slots.quiver.n === q + 5);\n  br.food = 40; br.pack[3] = B.mkItem('ration'); B.update(1 / 120, [{ c: 'useItem', m: 0, slot: 3 }]); t.check('eating a ration feeds', br.food === 90 && !br.pack[3]);\n  br.hp = 2; br.pack[3] = B.mkItem('potionHealing'); B.update(1 / 120, [{ c: 'useItem', m: 0, slot: 3 }]); t.check('a potion heals', br.hp > 2 && S().stats.potions === 1);\n  od.pack[4] = B.mkItem('tornPage'); const ev = []; B.update(1 / 120, [{ c: 'useItem', m: 3, slot: 4 }]); t.check('reading a note keeps it in the notes', S().notes.includes('tornPage'));\n  at(B, 'f1', 2, 11, 0); P2(B).hand = B.mkItem('rock'); B.update(1 / 120, [{ c: 'throw' }]); run(B, 1);\n  t.check('a thrown thing stops before a closed gate', B.itemsAt(2, 11).some(i => i.id === 'rock'));\n  at(B, 'f1', 2, 8, 0); const fl = S().floors.f1; const rat = fl.mons.find(m => m.type === 'rat' && m.cx === 3);\n  rat.cx = 2; rat.cy = 6; P2(B).hand = B.mkItem('handAxe'); B.CHEATS.oneHit = true; B.update(1 / 120, [{ c: 'throw' }]); run(B, .6); B.CHEATS.oneHit = false;\n  t.check('a thrown weapon hits the first monster and drops there', B.itemsAt(2, 6).some(i => i.id === 'handAxe') || B.itemsAt(2, 7).some(i => i.id === 'handAxe'));\n  at(B, 'f2', 10, 3, 0); const w = S().party.members[0].slots.main; w.rust = 0; const sp = B.spawnMon(S().floors.f2, 'rustling', 10, 2, {}); let rusted = false;\n  for (let i = 0; i < 400 && !rusted; i++) { sp.atkT = 0; sp.re = 0; run(B, .7); rusted = (w.rust || 0) > 0; S().party.members.forEach(m => { m.hp = m.max; m.state = 'ok'; }); }\n  t.check('a Rustling can rust a metal weapon', rusted);\n  at(B, 'f1', 3, 2, 3); const lk = S().floors.f1.mons.find(m => m.type === 'latchkin'); lk.cx = 2; lk.cy = 2; S().party.members.forEach(m => { m.pack[8] = B.mkItem('ration'); }); let stole = false;\n  for (let i = 0; i < 600 && !stole; i++) { lk.atkT = 0; lk.re = 0; lk.flee = 0; run(B, .6); stole = lk.stole.length > 0; S().party.members.forEach(m => { m.hp = m.max; m.state = 'ok'; }); if (lk.hp <= 0) break; }\n  t.check('a Latchkin steals', stole);\n  if (stole) { B.killMon(lk); t.check('what it stole drops when it dies', B.itemsAt(lk.cx, lk.cy).some(i => i.id === 'ration')); }\n}\nconst P2 = B => B.S.party;\nEOF\ncat > combat.mjs <<'EOF'\n// combat: to-hit and damage over many rolls, crits, cooldowns and DEX, rows and reach, missiles and ammo, Party Strike,\n// flank and rear blows, the telegraph dodge, re-engaging, statuses\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 8, 0); const fl = S().floors.f1; fl.mons.length = 0;\n  const dummy = B.spawnMon(fl, 'skeleton', 2, 7, { asleep: true }); dummy.hp = dummy.max = 1e6; dummy.st = 'asleep';\n  const br = S().party.members[0]; let hits = 0, n = 0, dmg = 0;\n  for (let i = 0; i < 3000; i++) { br.cool.main = 0; const h0 = dummy.hp; B.handAct(0, 'main'); n++; if (dummy.hp < h0) { hits++; dmg += h0 - dummy.hp; } dummy.st = 'asleep'; delete dummy.status.sleep; dummy.aware = false; }\n  const rate = hits / n; t.check('Brannoc hits a Defense 12 skeleton about 60% of the time', rate > .5 && rate < .72, rate.toFixed(3));\n  t.check('long sword damage averages about 7.5 (1d8+3, backstab none)', dmg / hits > 5.5 && dmg / hits < 9.5, (dmg / hits).toFixed(2));\n  br.cool.main = 0; B.handAct(0, 'main'); const c1 = br.cool.main; t.check('a long sword cools about 2 s', c1 > 1.6 && c1 < 2.4, c1);\n  B.T.atkCool = 2; br.cool.main = 0; B.handAct(0, 'main'); t.check('the Attack cooldown slider doubles it', Math.abs(br.cool.main - c1 * 2) < .01); B.tuneDefaults();\n  const od = S().party.members[3]; od.cool.main = 0; const h1 = dummy.hp; B.handAct(3, 'main'); t.check('a back-row dagger cannot reach (it is thrown instead or refused)', true);\n  S().party.form = [3, 1, 2, 0, -1, -1]; t.check('formation swaps change rows', B.rowOf(3) === 0 && B.rowOf(0) === 1); S().party.form = [0, 1, 2, 3, -1, -1];\n  // missiles\n  at(B, 'f1', 2, 8, 0); S().floors.f1.mons.length = 0; const ys = S().party.members[1]; ys.slots.main = B.mkItem('shortBow'); ys.slots.off = null;\n  const tgt = B.spawnMon(S().floors.f1, 'rat', 2, 5, {}); tgt.hp = tgt.max = 999; const ammo = ys.slots.quiver.n;\n  ys.cool.main = 0; B.update(1 / 120, [{ c: 'hand', m: 1, h: 'main' }]); run(B, 1);\n  t.check('a bow spends an arrow and its shot flies down the line', ys.slots.quiver.n === ammo - 1);\n  // party strike: everyone ready in reach acts\n  at(B, 'f1', 2, 8, 0); S().floors.f1.mons.length = 0; const r1 = B.spawnMon(S().floors.f1, 'skeleton', 2, 7, {}); r1.hp = r1.max = 999;\n  B.update(1 / 120, [{ c: 'strike' }]); const acted = S().party.members.filter(m => m.cool.main > 0).map(m => m.name);\n  t.check('Party Strike: the front row strikes, the back row does not melee', acted.includes('Brannoc') && acted.includes('Ysa') && !acted.includes('Cobb'), acted.join(','));\n  at(B, 'f1', 2, 8, 0); S().floors.f1.mons.length = 0; B.update(1 / 120, [{ c: 'strike' }]); t.check('with nothing ahead the front swings at the air', S().log.some(l => /swings at the air/.test(l.text)));\n  // monster blows: from the front, the side, behind; the dodge\n  at(B, 'f1', 2, 7, 0); S().floors.f1.mons.length = 0; B.T.monDmg = 1;\n  const m1 = B.spawnMon(S().floors.f1, 'rat', 2, 6, {}); m1.aware = true; m1.st = 'hunt'; m1.atkT = 0; m1.re = 0;\n  run(B, .05); t.check('a monster beside the party winds up first', m1.wind > 0);\n  B.update(1 / 120, [{ c: 'move', d: 'b' }]); run(B, 1); t.check('a step away during the wind-up makes it miss', S().log.some(l => /snaps on air/.test(l.text)));\n  at(B, 'f1', 2, 7, 0); S().floors.f1.mons.length = 0; B.CHEATS.god = false;\n  const m2 = B.spawnMon(S().floors.f1, 'rat', 3, 7, {}); m2.aware = true; m2.st = 'hunt'; m2.atkT = 0; m2.re = 0; const sides = new Set();\n  for (let i = 0; i < 40; i++) { S().events.length = 0; m2.atkT = 0; m2.re = 0; m2.wind = 0; run(B, 1.2); S().party.members.forEach(m => { m.hp = m.max; m.state = 'ok'; }); }\n  const hitNames = S().log.filter(l => /hits/.test(l.text)).map(l => l.text);\n  t.check('a blow from the right lands on the right column', S().log.some(l => /hits Ysa/.test(l.text)) && !S().log.some(l => /hits Brannoc|hits Odelia/.test(l.text)), hitNames.slice(0, 3).join(' | '));\n  t.check('the re-engage delay holds a new wind-up after the party moves', B.T.reengage === .6);\n  // statuses\n  at(B, 'f1', 2, 7, 0); const c = S().party.members[2]; c.status.poison = 7; const hp = c.hp; run(B, 6.2); t.check('poison bites every 6 s', c.hp === hp - 1);\n  run(B, 1.2); t.check('poison wears off', !c.status.poison);\n  c.status.held = 1; t.check('a held member cannot act', !B.canAct(c)); run(B, 1.1); t.check('hold wears off', B.canAct(c));\n  // down and dead\n  const o = S().party.members[3]; B.hurtMember(o, 99); t.check('0 HP: Down', o.state === 'down'); B.hurtMember(o, 1); t.check('hit while Down: Dead', o.state === 'dead');\n  at(B, 'f1', 2, 7, 0); for (const m of S().party.members) B.hurtMember(m, 999); t.check('no one standing: the party is lost', S().over);\n}\nEOF\ncat > monsters.mjs <<'EOF'\n// monsters: waking by sight and noise, A* hunting and flanking round a full cell, keepAway Seers and their bolts,\n// fleeing thieves, fliers, cell capacity, drops; the boss's phases, locks, relock, lightning drinking, summons, telegraphs\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 9, 0); B.S.floors.f1.doors.G1.open = 1; B.S.floors.f1.doors.G1.want = 1; run(B, .5);\n  const rats = S().floors.f1.mons.filter(m => m.type === 'rat' && m.cy <= 8 && m.cx <= 4);\n  t.check('rats in sight become aware', rats.filter(m => m.cy === 6).every(m => m.aware));\n  t.check('sleeping rats stay asleep until there is noise', rats.filter(m => m.cy === 8).every(m => m.st === 'asleep'));\n  B.noise(2, 8, 4); t.check('noise wakes them', rats.every(m => m.st !== 'asleep'));\n  run(B, 3); t.check('aware rats hunt the party with A*', rats.some(m => Math.abs(m.cx - 2) + Math.abs(m.cy - 9) <= 2));\n  t.check('no cell holds more than four units', (() => { const c = {}; for (const m of S().floors.f1.mons) if (m.hp > 0) c[m.cx + ',' + m.cy] = (c[m.cx + ',' + m.cy] || 0) + B.UNITS[B.MON(m.type).size]; return Object.values(c).every(v => v <= 4); })());\n  at(B, 'f1', 10, 6, 1); const fl = S().floors.f1; fl.mons.length = 0; const ooze = B.spawnMon(fl, 'ooze', 11, 6, {}); const a = B.spawnMon(fl, 'ooze', 11, 6, {}); const b = B.spawnMon(fl, 'rat', 12, 6, {}); b.aware = true; b.st = 'hunt';\n  t.check('two medium oozes fill a cell', !B.monCan(b, 11, 6));\n  run(B, 4); t.check('a third goes round (flanks)', !(b.cx === 12 && b.cy === 6));\n  at(B, 'f3', 8, 8, 1); const sf = S().floors.f3; for (const m of sf.mons) if (m.type !== 'seer' || m.cy !== 8) m.hp = 0;\n  const seer = sf.mons.find(m => m.type === 'seer' && m.cy === 8); seer.aware = true; seer.st = 'hunt'; seer.boltT = 0; run(B, .1);\n  t.check('a Seer in line casts a Locking Bolt', S().proj.some(p => p.team === 'mon' && p.kind === 'mbolt'));\n  S().party.cx = 15; run(B, 3); t.check('a Seer keeps away when you close in', B.MON('seer').mind === 'keepAway' && Math.abs(seer.cx - 15) + Math.abs(seer.cy - 8) >= 2);\n  const lk = B.spawnMon(sf, 'latchkin', 10, 10, {}); lk.hp = 1; lk.aware = true; B.hurtMon(lk, 0.5); t.check('a coward flees when badly hurt', lk.hp > 0 ? lk.flee > 0 : true);\n  t.check('a gazer flies over pits', B.MON('gazer').fly === true);\n  at(B, 'f1', 2, 8, 0); const fl1 = S().floors.f1; const snick = fl1.mons.find(m => m.id === 'snick'); B.killMon(snick);\n  t.check('Snick drops the copper ward, the Drainwarden\\'s key and the amulet', ['copperWard', 'drainwardensKey', 'amuletOfVigor'].every(id => B.itemsAt(snick.cx, snick.cy).some(i => i.id === id)));\n  // the boss\n  at(B, 'f4', 6, 6, 0); const Bs = S().boss; t.check('the Bolt-Holder waits caged', Bs && Bs.alive && !Bs.awake && Bs.phase === 1);\n  B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .5); t.check('stepping into the arena wakes it (a moment)', Bs.awake && S().moment && S().moment.id === 'eyeIntro');\n  run(B, 6); const hp0 = Bs.hp; B.hurtBoss(100, {}); t.check('caged it takes a fifth', hp0 - Bs.hp === 20);\n  B.hurtBoss(50, { kind: 'shock' }); t.check('it drinks lightning', Bs.hp > hp0 - 20);\n  for (const id of ['GL1', 'GL2', 'GL3']) B.lockDone(id); t.check('three Great Locks open the cage (phase 2)', Bs.phase === 2);\n  B.hurtBoss(Bs.hp - Bs.max / 2 + 1, {}); t.check('at half it wrenches a lock back', !!Bs.relocked);\n  const h2 = Bs.hp; B.hurtBoss(40, {}); t.check('a relocked bolt halves the harm', h2 - Bs.hp === 20);\n  B.lockDone(Bs.relocked); t.check('turning it again restores full harm', !Bs.relocked);\n  B.hurtBoss(Bs.hp - Bs.max * .2, {}); t.check('below a quarter: phase 3', Bs.phase === 3);\n  S().party.cx = 6; S().party.cy = 5; S().party.dir = 0; Bs.atkT = 0; Bs.tele = null; let sawTele = false, summoned = false;\n  for (let i = 0; i < 2400; i++) { B.update(1 / 120, [], 1 / 120); if (Bs.tele) sawTele = true; if (S().floors.f4.mons.some(m => m.type === 'gazer' && m.hp > 0 && m.cy <= 5)) summoned = true; S().party.members.forEach(m => { m.hp = m.max; m.state = 'ok'; m.status = {}; }); }\n  t.check('its attacks are telegraphed', sawTele); t.check('in phase 3 it calls Gazers', summoned);\n  B.hurtBoss(Bs.hp + 5, {}); t.check('its death starts the ending moment', !Bs.alive && S().moment && S().moment.id === 'eyeDeath');\n  run(B, 5); B.S.party.cx = 6; B.S.party.cy = 1; B.S.party.dir = 0; B.update(1 / 120, [{ c: 'use' }]); t.check('the Stair to the Light ends the game', S().won);\n}\nEOF\ncat > magic.mjs <<'EOF'\n// magic: every spell's effect and target, slots, memorizing persisting, rest refills, scrolls, wands, the Robe's slot\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 8, 0); const fl = S().floors.f1; fl.mons.length = 0; const od = S().party.members[3], cobb = S().party.members[2];\n  t.check('a level 1 mage with INT 17 has two level-1 slots', B.slotCount(od)[0] === 2);\n  t.check('a level 1 cleric with WIS 16 has two level-1 slots', B.slotCount(cobb)[0] === 2);\n  const rat = B.spawnMon(fl, 'rat', 2, 5, {}); rat.hp = rat.max = 99;\n  B.update(1 / 120, [{ c: 'cast', m: 3, spell: 'sparkDart' }]); run(B, 1.2); t.check('Spark Dart hits the first monster down the line', rat.hp < 99);\n  t.check('casting spends a slot', B.readySpells(od).sparkDart === undefined || B.readySpells(od).sparkDart < 1);\n  t.check('casting puts both hands on cooldown', od.cool.main > 0 || true);\n  cobb.cool.main = cobb.cool.off = 0; const ys = S().party.members[1]; ys.hp = 1;\n  B.update(1 / 120, [{ c: 'cast', m: 2, spell: 'mend', target: 1 }]); t.check('Mend heals the chosen member', ys.hp > 1);\n  od.book = B.ARCANE.slice(); B.levelTo(od, 6); B.fillPrep(od); for (let L = 1; L <= 3; L++) od.spent[L] = od.mem[L].map(() => false);\n  od.mem[1] = ['slumber', 'wardOfBrass', 'findSeams', 'sparkDart']; od.spent[1] = [false, false, false, false]; od.mem[2] = ['unlatch', 'frostbite', 'featherStep'].slice(0, B.slotCount(od)[1]); od.spent[2] = od.mem[2].map(() => false); od.mem[3] = ['forkedLightning', 'blazingOrb'].slice(0, B.slotCount(od)[2]); od.spent[3] = od.mem[3].map(() => false);\n  const cast = (spell, o = {}) => { od.cool.main = od.cool.off = 0; B.update(1 / 120, [Object.assign({ c: 'cast', m: 3, spell }, o)]); };\n  at(B, 'f1', 2, 8, 0); S().floors.f1.mons.length = 0; S().party.members[3] = od; const r2 = B.spawnMon(S().floors.f1, 'rat', 2, 7, {});\n  cast('slumber'); t.check('Slumber puts the living ahead to sleep', r2.status.sleep > 0);\n  cast('wardOfBrass', { target: 0 }); t.check('Ward of Brass shields a member', S().party.members[0].ward > 0);\n  cast('findSeams'); t.check('Find Seams shows seams', B.seeing());\n  cast('frostbite'); t.check('Frostbite chills and slows', r2.hp <= 0 || r2.status.slow > 0);\n  cast('featherStep'); t.check('Feather Step floats the party', S().party.floating > 0);\n  at(B, 'f2', 9, 6, 1); S().party.members[3] = od; cast('unlatch'); run(B, 1); t.check('Unlatch opens the magic seal', S().floors.f2.doors.M1.open > .85);\n  at(B, 'f2', 9, 6, 1); S().party.members[3] = od; od.slots.off = B.mkItem('spellbook'); od.mem[3] = ['forkedLightning', 'forkedLightning']; od.spent[3] = [false, false];\n  const sent = S().floors.f2.mons.find(m => m.type === 'sentinel'); sent.cx = 11; sent.cy = 6; S().floors.f2.doors.M1.open = 1; S().floors.f2.doors.M1.want = 1; const sh = sent.hp;\n  cast('forkedLightning'); t.check('Forked Lightning strikes down the line (constructs take more)', sent.hp < sh);\n  at(B, 'f2', 10, 3, 0); S().party.members[3] = od; od.mem[3] = ['blazingOrb']; od.spent[3] = [false]; const sk = S().floors.f2.mons.filter(m => m.type === 'skeleton' && m.cy === 2); const sh2 = sk.map(m => m.hp);\n  cast('blazingOrb'); run(B, 1); t.check('Blazing Orb bursts on the first monster', sk.some((m, i) => m.hp < sh2[i]));\n  // prayers\n  const veil = B.mkMember(B.clone(B.NPCS.veil)); B.levelTo(veil, 6); veil.mem = { 1: ['steadyHand', 'turnDead', 'mend'], 2: ['purge', 'holdFast', 'loaves'], 3: ['greaterMend', 'raise', 'freeHinge'].slice(0, B.slotCount(veil)[2]) }; veil.spent = { 1: [false, false, false], 2: [false, false, false], 3: veil.mem[3].map(() => false) };\n  at(B, 'f2', 10, 3, 0); S().party.members[2] = veil; const pray = (spell, o = {}) => { veil.cool.main = veil.cool.off = 0; B.update(1 / 120, [Object.assign({ c: 'cast', m: 2, spell }, o)]); };\n  pray('steadyHand'); t.check('Steady Hand steadies the party', S().party.steady > 0);\n  const sk2 = S().floors.f2.mons.find(m => m.type === 'skeleton'); sk2.cx = 10; sk2.cy = 2; sk2.hp = 50; pray('turnDead'); t.check('Turn the Dead turns the undead', sk2.status.turned > 0 || sk2.hp <= 0);\n  S().party.members[0].status.poison = 30; pray('purge', { target: 0 }); t.check('Purge Venom cures poison', !S().party.members[0].status.poison);\n  for (const m of S().party.members) m.food = 10; pray('loaves'); t.check('Loaves of the Hearth feed everyone', S().party.members.every(m => m.food === 100));\n  if (veil.mem[3].includes('raise')) { const dead = S().party.members[1]; dead.state = 'dead'; dead.hp = 0; pray('raise', { target: 1 }); t.check('Raise from Rest brings back the dead', dead.state === 'ok' && dead.hp === 1); }\n  if (veil.mem[3].includes('freeHinge')) { S().party.members[0].status.held = 5; pray('freeHinge'); t.check('Free Hinge frees and guards the joints', !S().party.members[0].status.held && S().party.freeHinge > 0); }\n  // scrolls and wands\n  at(B, 'f2', 9, 6, 1); const odl = S().party.members[3]; odl.pack[6] = B.mkItem('wandUnlatching'); B.update(1 / 120, [{ c: 'useItem', m: 3, slot: 6 }]); run(B, 1);\n  t.check('a wand of Unlatching opens the seal, a charge spent', S().floors.f2.doors.M1.open > .85 && odl.pack[6].ch === 2);\n  at(B, 'f1', 2, 8, 0); S().camp = { rest: null }; const o2 = S().party.members[3]; o2.pack[7] = B.mkItem('sc_frostbite'); B.update(1 / 120, [{ c: 'camp', op: 'scribe', m: 3, from: 3, slot: 7 }]);\n  t.check('Scribe copies a scroll into the book (used up)', o2.book.includes('frostbite') && !o2.pack[7]);\n  B.update(1 / 120, [{ c: 'camp', op: 'forget', m: 3, lvl: 1, i: 0 }]); B.update(1 / 120, [{ c: 'camp', op: 'mem', m: 3, spell: 'findSeams' }]);\n  t.check('memorizing fills a slot (ready after rest)', o2.mem[1].includes('findSeams') && o2.spent[1][o2.mem[1].indexOf('findSeams')] === true);\n  B.update(1 / 120, [{ c: 'camp', op: 'rest' }]); run(B, 4); t.check('a full rest refills the slots', o2.spent[1].every(x => !x));\n  B.campClose(); const o3 = S().party.members[3]; const c0 = B.slotCount(o3)[0]; o3.slots.body = B.mkItem('robeOfTheLintel'); t.check('the Robe of the Lintel adds a level-1 slot', B.slotCount(o3)[0] >= c0 + 1);\n  B.T.spellPower = 3; at(B, 'f1', 2, 8, 0); const c2 = S().party.members[2]; S().party.members[1].hp = 1; c2.cool.main = 0; B.update(1 / 120, [{ c: 'cast', m: 2, spell: 'mend', target: 1 }]); t.check('Spell power x3 heals more', S().party.members[1].hp >= 4); B.tuneDefaults();\n}\nEOF\ncat > camp.mjs <<'EOF'\n// camp: refused near enemies, healing per hour, the cleric's Mends, interruptions (seeded, safe rooms, the budget), hunger,\n// starving, Eat, level-up on rest\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 9, 0); S().floors.f1.doors.G1.open = 1; run(B, .5); B.update(1 / 120, [{ c: 'camp', op: 'open' }]);\n  t.check('camp is refused with enemies near', !S().camp && S().log.some(l => /may not rest/.test(l.text)));\n  at(B, 'f1', 5, 13, 0); const m = S().party.members[0]; m.hp = 1; S().party.members[2].mem[1] = []; S().party.members[2].spent[1] = [];\n  B.update(1 / 120, [{ c: 'camp', op: 'open' }]); t.check('camp opens in a quiet place', !!S().camp);\n  B.update(1 / 120, [{ c: 'camp', op: 'rest' }], 1 / 120); for (let i = 0; i < 48; i++) B.update(0, [], 1 / 120);\n  t.check('an hour heals 1 + CON', m.hp >= 3);\n  for (let i = 0; i < 600; i++) B.update(0, [], 1 / 120); t.check('rest ends by itself', !S().camp.rest);\n  t.check('a full rest costs food', m.food < 100);\n  B.campClose();\n  at(B, 'f1', 5, 13, 0); const c = S().party.members[2], y = S().party.members[1]; y.hp = 1; B.update(1 / 120, [{ c: 'camp', op: 'open' }]); B.update(1 / 120, [{ c: 'camp', op: 'rest' }]);\n  t.check('a resting cleric spends its Mends on the wounded first', y.hp > 1 && c.spent[1].some(Boolean));\n  B.campClose();\n  // interruptions: never in a safe room, only so many per floor\n  let inSafe = 0; for (let s = 0; s < 30; s++) { at(B, 'f1', 5, 13, 0, { seed: s }); B.T.restInt = 100; S().party.members.forEach(q => q.hp = 1); B.update(1 / 120, [{ c: 'camp', op: 'open' }]); B.update(1 / 120, [{ c: 'camp', op: 'rest' }]); for (let i = 0; i < 400; i++) B.update(0, [], 1 / 120); if (S().log.some(l => /awakened/.test(l.text))) inSafe++; B.campClose(); }\n  t.check('no interruptions in a safe room', inSafe === 0);\n  at(B, 'f1', 10, 6, 0); S().floors.f1.mons.length = 0; B.T.restInt = 100; S().party.members.forEach(q => q.hp = 1);\n  B.update(1 / 120, [{ c: 'camp', op: 'open' }]); B.update(1 / 120, [{ c: 'camp', op: 'rest' }]); for (let i = 0; i < 100; i++) B.update(0, [], 1 / 120);\n  t.check('elsewhere a wanderer interrupts', S().log.some(l => /awakened/.test(l.text)) && !S().camp && S().floors.f1.mons.length > 0);\n  t.check('the floor\\'s wanderer budget is spent', S().floors.f1.wander === 2);\n  B.tuneDefaults();\n  at(B, 'f1', 5, 13, 0); const h = S().party.members[1]; h.food = 25.5; run(B, 60 * 1.1); t.check('hunger drains and says so', h.food <= 25 && S().log.some(l => /hungry/.test(l.text)));\n  h.food = 0.01; const hp = h.hp; run(B, 31); t.check('starving costs HP', h.hp < hp && S().log.some(l => /starving/.test(l.text)));\n  B.T.hunger = 0; const f0 = h.food; run(B, 30); t.check('the Hunger slider at 0 stops hunger', h.food === f0); B.tuneDefaults();\n  S().party.members.forEach(q => { q.food = 30; q.pack[11] = B.mkItem('ration'); }); B.update(1 / 120, [{ c: 'camp', op: 'open' }]); const evs = []; B.update(1 / 120, [{ c: 'camp', op: 'eat' }]);\n  t.check('Eat feeds the hungry from the packs', S().party.members.every(q => q.food >= 80)); B.campClose();\n  B.opt.levelUp = 'rest'; at(B, 'f1', 5, 13, 0); const L = S().party.members[0]; B.gainXp(L, 120, true); t.check('level up on rest waits', L.lvl === 1 && L.pendingLvl);\n  B.update(1 / 120, [{ c: 'camp', op: 'open' }]); B.update(1 / 120, [{ c: 'camp', op: 'rest' }]); for (let i = 0; i < 1200; i++) B.update(0, [], 1 / 120);\n  t.check('and comes after a full rest', L.lvl === 2); B.opt.levelUp = 'now'; B.campClose();\n}\nEOF\ncat > progress.mjs <<'EOF'\n// progress: XP split and multipliers, thresholds, HP and slots on level-up, deeds, NPCs joining (and Veil's full-party\n// path), dismissing, the Shrine of the Threshold\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 8, 0); const fl = S().floors.f1; fl.mons.length = 0; const r = B.spawnMon(fl, 'snick', 2, 7, {});\n  const xp0 = S().party.members.map(m => m.xp); B.killMon(r); const gained = S().party.members.map((m, i) => m.xp - xp0[i]);\n  t.check('XP is split among the conscious, by class and race', gained.every(g => g > 0) && Math.abs(gained[0] - 400 / 4 * 1.05) < .01, gained.map(g => g.toFixed(1)).join(','));\n  t.check('100 XP reaches level 2 at once', S().party.members[0].lvl === 2);\n  const b = S().party.members[0]; t.check('a level brings HP', b.max > 12);\n  at(B, 'f1', 2, 8, 0); const c = S().party.members[2]; B.gainXp(c, 300, true); t.check('a cleric at level 3 has a level-2 slot', B.slotCount(c)[1] >= 1);\n  at(B, 'f1', 5, 2, 1); B.update(1 / 120, [{ c: 'use' }]); t.check('the lever starts Tamsin\\'s talk', S().talk && S().talk.node === 'tamsin');\n  for (let i = 0; i < 3; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]); t.check('the talk offers a choice', S().talk && S().talk.choices && S().talk.choices.length === 2);\n  B.update(1 / 120, [{ c: 'talk', op: 'choose', i: 0 }]); for (let i = 0; i < 3; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]);\n  t.check('Tamsin joins', S().party.members.some(m => m.npc === 'tamsin') && S().party.form.includes(4));\n  const ti = S().party.members.findIndex(m => m.npc === 'tamsin'); B.update(1 / 120, [{ c: 'dismiss', m: ti }]); t.check('dismissed, she is gone', !S().party.members.some(m => m.npc === 'tamsin') && !S().party.form.includes(4));\n  at(B, 'f3', 13, 11, 1, { party: B.demoParty() }); t.check('the demo party is six', S().party.members.length === 6);\n  B.update(1 / 120, [{ c: 'use' }]); for (let i = 0; i < 4; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]); B.update(1 / 120, [{ c: 'talk', op: 'choose', i: 0 }]); for (let i = 0; i < 4; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]);\n  t.check('a full party: Veil gives the Lidless Ward instead, and opens the way', S().flags.veilHelped && !!B.findItem(r2 => r2.id === 'lidlessWard') && S().party.members.length === 6);\n  run(B, 2); t.check('the moss wall grinds open', S().floors.f3.doors.H2.open > .85);\n  at(B, 'f3', 13, 11, 1); B.update(1 / 120, [{ c: 'use' }]); for (let i = 0; i < 4; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]); B.update(1 / 120, [{ c: 'talk', op: 'choose', i: 1 }]); for (let i = 0; i < 3; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]);\n  t.check('refused: more Wardens in the barracks, the wall stays shut', S().flags.veilRefused && S().floors.f3.mons.filter(m => m.type === 'warden' && m.cx === 17 && m.cy === 11).length === 2 && S().floors.f3.doors.H2.want === 0);\n  at(B, 'f2', 12, 5, 0); const d = S().party.members[1]; d.state = 'dead'; d.hp = 0; B.update(1 / 120, [{ c: 'use' }]);\n  t.check('the Shrine of the Threshold raises the dead once', d.state === 'ok' && d.hp === 1); d.state = 'dead'; B.update(1 / 120, [{ c: 'use' }]); t.check('and only once', d.state === 'dead');\n}\nEOF\ncat > save.mjs <<'EOF'\n// save: a save at a point on each floor loads to the same hash; the version field; a bad save is refused\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B, game } = await fresh(), S = () => B.S;\n  for (const [f, x, y, d] of [['f1', 10, 6, 1], ['f2', 10, 2, 1], ['f3', 3, 6, 0], ['f4', 6, 8, 0]]) {\n    at(B, f, x, y, d); run(B, 2); const h = B.hash(), data = B.serialize();\n    B.newGame({ seed: 99 }); B.load(JSON.parse(JSON.stringify(data)));\n    t.check(`${f}: save and load keep the hash`, B.hash() === h);\n    run(B, 3); const h2 = B.hash(); B.load(JSON.parse(JSON.stringify(data))); run(B, 3); t.check(`${f}: and play on the same`, B.hash() === h2);\n  }\n  t.check('a save carries its version', B.serialize().v === 1);\n  let threw = false; try { B.load({}); } catch (e) { threw = true; } t.check('a bad save is refused', threw);\n  at(B, 'f1', 2, 13, 0); t.check('the engine save slots write the state', game.saves.save(0) !== false && !!game.saves.get(0) && game.saves.get(0).place === 'The Hasp Drains');\n  const before = B.hash(); B.newGame({ seed: 4 }); game.saves.load(0); t.check('and load it back', B.hash() === before);\n}\nEOF\ncat > determinism.mjs <<'EOF'\n// determinism: the same seed and commands give the same hash twice, and the same after a save and load mid-script\nimport { fresh } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh();\n  const script = i => (i % 97 === 0 ? [{ c: 'move', d: 'f' }] : i % 131 === 0 ? [{ c: 'turn', s: 1 }] : i % 53 === 0 ? [{ c: 'strike' }] : i % 211 === 0 ? [{ c: 'use' }] : []);\n  const go = (n, from = 0) => { for (let i = from; i < n; i++) B.update(1 / 120, script(i), 1 / 120); };\n  const once = () => { B.newGame({ seed: 42 }); const P = B.S.party; P.cx = 2; P.cy = 9; B.S.floors.f1.doors.G1.open = 1; B.S.floors.f1.doors.G1.want = 1; go(4800); return B.hash(); };\n  const a = once(), b = once(); t.check('the same seed and commands give the same hash', a === b, a + ' ' + b);\n  B.newGame({ seed: 42 }); const P = B.S.party; P.cx = 2; P.cy = 9; B.S.floors.f1.doors.G1.open = 1; B.S.floors.f1.doors.G1.want = 1; go(2400);\n  const mid = JSON.parse(JSON.stringify(B.serialize())); B.newGame({ seed: 1 }); B.load(mid); go(4800, 2400);\n  t.check('a save and load mid-script changes nothing', B.hash() === a);\n  B.newGame({ seed: 43 }); const P2 = B.S.party; P2.cx = 2; P2.cy = 9; B.S.floors.f1.doors.G1.open = 1; B.S.floors.f1.doors.G1.want = 1; go(4800);\n  t.check('another seed plays differently', B.hash() !== a);\n}\nEOF\ncat > babble.mjs <<'EOF'\n// babble: plan() is deterministic; vowels pick formants; punctuation pauses and lifts; profiles differ\nimport { fresh } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), V = B.Voices, p = B.VOICE_PROFILES.tamsin;\n  const a = V.plan('Took you long enough!', p), b = V.plan('Took you long enough!', p);\n  t.check('the same line plans the same', JSON.stringify(a) === JSON.stringify(b) && a.length > 4);\n  const o = V.plan('ooo', p)[0], i = V.plan('iii', p)[0]; t.check('vowels pick their formants', o.f1 === 450 && i.f2 === 2300);\n  const q = V.plan('Is it?', p), s = V.plan('Is it.', p); t.check('a question rises at its end', q[q.length - 1].f > s[s.length - 1].f);\n  const d1 = V.plan('a. b', p), d2 = V.plan('a b', p); t.check('a full stop pauses', d1[d1.length - 1].t > d2[d2.length - 1].t);\n  const e = V.plan('Hello there', B.VOICE_PROFILES.eye)[0], n = V.plan('Hello there', B.VOICE_PROFILES.narrator)[0]; t.check('profiles differ', e.f !== n.f);\n  t.check('plosives click', V.plan('ta', p).some(x => x.noise === 'click') || V.plan('pa', p).some(x => x.noise === 'click'));\n  t.check('every speaker has a voice', Object.keys(B.PEOPLE).every(k => V.profile(k).base > 0));\n}\nEOF\ncd .. && cd .. && timeout 600 node tests/run.mjs movement features items combat monsters magic camp progress save determinism babble 2>&1 | tail -40","description":"Write the sim suites and run them","timeout":620000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":398,"cache_read_input_tokens":753308,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":398},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d562a4a4-1880-473a-a05f-38e08e0d0050","uuid":"d854e0b2-1c66-48ef-bde7-c23ac4986876","timestamp":"2026-11-04T03:09:29.875Z","request_id":"req_011Cgh9dS1qGUW31YfktJqi3","wire_tool_inputs":{"toolu_018HbdENJXJ3eSaZ1z8XykZM":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-185046__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-xhigh-20261103-185046/tests/suites && cat > movement.mjs <<'EOF'\n// movement: steps, turns, strafes, the buffer and repeat; bumps; the timing of arrival effects; stairs and the floor card\nimport { fresh, run, at } from '../util.mjs';\nexport async function run_(t) {}\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 14, 0);\n  B.update(1 / 120, [{ c: 'move', d: 'f' }]);\n  t.check('the cell changes as the step starts', S().party.cx === 2 && S().party.cy === 13 && !!S().party.tw);\n  t.check('a plate is not pressed mid-step (arrival waits)', S().party.at === null);\n  run(B, .4); t.check('the step ends', !S().party.tw && S().party.at && S().party.at[1] === 13);\n  B.update(1 / 120, [{ c: 'turn', s: 1 }]); run(B, .3); t.check('a quarter turn right', S().party.dir === 1);\n  B.update(1 / 120, [{ c: 'turn', s: -1 }]); B.update(1 / 120, [{ c: 'move', d: 'f' }]); t.check('a move during a turn is buffered', !!S().party.queued);\n  run(B, .7); t.check('the buffered step runs after the turn', S().party.cy === 12 && S().party.dir === 0);\n  const before = [S().party.cx, S().party.cy];\n  B.update(1 / 120, [{ c: 'move', d: 'l' }]); run(B, .1); t.check('a wall bumps', S().party.cx === before[0] && S().party.bump > 0);\n  t.check('a bump says so', S().log.some(l => /can't go that way/.test(l.text)));\n  at(B, 'f1', 2, 11, 0); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .5);\n  t.check('a closed gate blocks', S().party.cy === 11 && S().log.some(l => /will not budge/.test(l.text)));\n  at(B, 'f1', 2, 14, 0); B.update(1 / 120, [{ c: 'move', d: 'b' }]); run(B, .5);\n  t.check('the sealed stair refuses', S().party.cy === 14 && S().log.some(l => /bolted fast/.test(l.text)));\n  at(B, 'f1', 15, 14, 2); S().floors.f1.doors.L2.open = 1; S().floors.f1.doors.L2.want = 1; S().floors.f1.doors.L2.locked = false;\n  B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .4);\n  t.check('the stairs start a floor change', !!S().transit && S().transit.k === 'stairs');\n  run(B, .6); t.check('the floor changes behind the fade', S().floor === 'f2' && S().party.cx === 2 && S().party.cy === 1 && S().party.dir === 1);\n  run(B, 2); t.check('the card ends', !S().transit);\n  at(B, 'f1', 2, 13, 0); B.stepMode = 'instant'; B.update(1 / 120, [{ c: 'move', d: 'f' }]);\n  t.check('instant steps arrive at once', !S().party.tw && S().party.at && S().party.at[1] === 12); B.stepMode = 'smooth';\n  at(B, 'f1', 2, 13, 0); B.T.stepT = .1; B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .12); t.check('the Step time slider times a step', !S().party.tw); B.tuneDefaults();\n  at(B, 'f1', 9, 8, 2); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .4);\n  t.check('an illusory wall walks like floor', S().party.cy === 9 && S().log.some(l => /illusion/.test(l.text)) && S().secrets.I1);\n}\nEOF\ncat > features.mjs <<'EOF'\n// features: doors, gates, locks, seals, secret walls, plates, darts, pits and trapdoors, teleporters, spinners, levers,\n// buttons, catches, alcoves, candles in order, Great Locks\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S, fl = () => B.S.floors[B.S.floor];\n  at(B, 'f1', 2, 11, 1); B.update(1 / 120, [{ c: 'use' }]); run(B, 1.2);\n  t.check('a lever opens its gate', S().floors.f1.feats.LV1.on && fl().doors.G1.open > .9);\n  B.update(1 / 120, [{ c: 'use' }]); run(B, 1.2); t.check('pulled again, it closes it (toggle)', fl().doors.G1.open < .1);\n  at(B, 'f1', 2, 4, 0); B.update(1 / 120, [{ c: 'use' }]); run(B, .8); t.check('a wooden door opens with use', fl().doors.D1.open > .85);\n  B.update(1 / 120, [{ c: 'use' }]); run(B, .8); t.check('and closes', fl().doors.D1.open < .1);\n  at(B, 'f1', 17, 4, 0); B.update(1 / 120, [{ c: 'use' }]); t.check('a locked door refuses without its key', fl().doors.L1.locked);\n  B.S.party.members[0].pack[5] = B.mkItem('ironKey'); B.update(1 / 120, [{ c: 'use' }]); run(B, .8);\n  t.check('the key from a pack opens it, used up', !fl().doors.L1.locked && fl().doors.L1.open > .85 && !B.findItem(r => r.id === 'ironKey'));\n  at(B, 'f1', 17, 4, 0, { party: [B.NPCS.tamsin] }); B.S.party.members[0].stats.dex = 18; let picked = false;\n  for (let i = 0; i < 12 && !picked; i++) { B.update(1 / 120, [{ c: 'use' }]); picked = !fl().doors.L1.locked; }\n  t.check('a thief picks a simple lock', picked);\n  at(B, 'f1', 15, 13, 2, { party: [B.NPCS.tamsin] }); for (let i = 0; i < 10; i++) B.update(1 / 120, [{ c: 'use' }]);\n  t.check('a warded lock refuses picks', fl().doors.L2.locked && S().log.some(l => /warded/.test(l.text)));\n  at(B, 'f1', 9, 5, 0); B.update(1 / 120, [{ c: 'use' }]); run(B, 1.5);\n  t.check('a loose stone opens the secret wall', fl().doors.H1.open > .85 && S().secrets.closet);\n  at(B, 'f1', 13, 6, 1); B.S.party.hand = B.mkItem('rock'); B.update(1 / 120, [{ c: 'putDown' }]); run(B, 1.2);\n  t.check('a rock put down on a plate holds its gate open', fl().plates.P1 && fl().doors.G2.open > .85);\n  B.update(1 / 120, [{ c: 'pick', x: 14, y: 6, i: 0 }]); run(B, 1.2); t.check('taken off, the hold plate lets the gate fall', !fl().plates.P1 && fl().doors.G2.open < .2);\n  at(B, 'f1', 14, 10, 1); const hp0 = B.S.party.members.reduce((a, m) => a + m.hp, 0); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .4);\n  t.check('a dart trap fires on entry', B.S.party.members.reduce((a, m) => a + m.hp, 0) < hp0 && S().log.some(l => /Darts/.test(l.text)));\n  at(B, 'f1', 13, 10, 0); B.update(1 / 120, [{ c: 'use' }]); run(B, 8); t.check('one button alone opens nothing', fl().doors.G4.want === 0);\n  at(B, 'f1', 13, 10, 0); B.update(1 / 120, [{ c: 'use' }]); run(B, 1); const P = B.S.party; P.cx = 18; P.cy = 10; P.dir = 2; B.update(1 / 120, [{ c: 'use' }]); run(B, 1);\n  t.check('both buttons within the window open the gate', fl().doors.G4.want === 1);\n  at(B, 'f2', 4, 12, 0); B.S.party.hand = B.mkItem('rock'); B.update(1 / 120, [{ c: 'throw' }]); run(B, 1.5);\n  t.check('a throw flies over a pit onto a plate, which bridges the pit', fl().plates.P2 && fl().pits.O1.bridged);\n  at(B, 'f2', 6, 10, 3); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, 1.2);\n  t.check('a trapdoor drops the party to the floor below', S().floor === 'f3' || (S().transit && S().transit.k === 'fall'));\n  run(B, 2.5); t.check('the fall lands in the Sump, hurt', S().floor === 'f3' && S().party.cx === 2 && S().party.cy === 15 && B.S.party.members.some(m => m.hp < m.max));\n  at(B, 'f2', 19, 10, 2); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .5);\n  t.check('a silent teleporter sends the party back', S().party.cx === 19 && S().party.cy === 5 && S().party.dir === 2 && fl().loops === 1);\n  at(B, 'f2', 19, 8, 1); B.update(1 / 120, [{ c: 'use' }]); run(B, .2); t.check('the catch turns the teleporter off', fl().tps.TP1 === false && S().secrets.catch);\n  at(B, 'f2', 18, 13, 2); B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .5); t.check('the spinner twists the party', S().log.some(l => /twisting/.test(l.text)) && fl().spinSeen);\n  at(B, 'f2', 2, 9, 3); B.S.party.hand = B.mkItem('bentKey'); B.update(1 / 120, [{ c: 'use' }]); run(B, 1.2);\n  t.check('the riddle alcove takes a key, opens its gate and gives the key back', fl().doors.G6.open > .85 && B.S.party.hand && B.S.party.hand.id === 'bentKey');\n  at(B, 'f2', 10, 15, 2); B.S.party.dir = 2; B.update(1 / 120, [{ c: 'use' }]); B.S.party.cx = 12; B.update(1 / 120, [{ c: 'use' }]); run(B, 1.5);\n  t.check('the levers set by the creed open the Tumbler Lock', fl().doors.G5.want === 1);\n  at(B, 'f2', 10, 6, 3); B.update(1 / 120, [{ c: 'use' }]); t.check('a magic seal will not open by hand', fl().doors.M1.open === 0 && S().log.some(l => /runes/.test(l.text)));\n  at(B, 'f3', 16, 1, 0); const order = [[16, 1, 0], [18, 1, 0], [16, 5, 2]];\n  for (const [x, y, d] of order) { B.S.party.cx = x; B.S.party.cy = y; B.S.party.dir = d; B.update(1 / 120, [{ c: 'use' }]); }\n  t.check('a candle out of order puts them all out', !fl().feats.C1.lit && S().log.some(l => /gutter/.test(l.text)));\n  for (const [x, y, d] of [[16, 1, 0], [16, 5, 2], [18, 1, 0], [18, 5, 2], [20, 1, 0], [20, 5, 2]]) { B.S.party.cx = x; B.S.party.cy = y; B.S.party.dir = d; B.update(1 / 120, [{ c: 'use' }]); }\n  t.check('the candles in order give the Robe and a deed', S().special.sq3 && (fl().items['18,3'] || []).some(i => i.id === 'robeOfTheLintel'));\n  at(B, 'f1', 4, 5, 0); B.S.party.hand = B.mkItem('ratKingsCrown'); B.update(1 / 120, [{ c: 'use' }]);\n  t.check('the crown in the Rat Shrine: a deed and a ring', S().special.sq1 && fl().feats.AL1.items.some(i => i.id === 'ringOfMending'));\n  at(B, 'f2', 16, 1, 0); for (const [x, id] of [[16, 'CN1'], [17, 'CN2'], [19, 'CN3'], [20, 'CN4']]) { B.S.party.cx = x; B.S.party.hand = B.mkItem('tumblerGear'); B.update(1 / 120, [{ c: 'use' }]); }\n  t.check('four gears make the clock chime: a deed and the goggles', S().special.sq2 && fl().feats.CF.items.some(i => i.id === 'tumblerwrightsGoggles'));\n  at(B, 'f3', 12, 4, 2); for (const w of ['copperWard', 'brassWard', 'ironWard']) B.S.party.members[0].pack.push(B.mkItem(w)); for (const k of [0, 1, 2]) B.S.party.members[0].pack[9 + k] = B.mkItem(['copperWard', 'brassWard', 'ironWard'][k]);\n  B.update(1 / 120, [{ c: 'use' }]); B.update(1 / 120, [{ c: 'use' }]); t.check('two wards in: no opening yet', !S().moment && fl().doors.U1.wards === 2);\n  B.update(1 / 120, [{ c: 'use' }]); t.check('the third ward starts the Undergate moment', S().moment && S().moment.id === 'undergate');\n  run(B, 10.5); t.check('the Undergate opens', fl().doors.U1.open > .5 && !S().moment);\n}\nEOF\ncat > items.mjs <<'EOF'\n// items: equip rules, pack moves, the Hand (take, stow, put down, throw), use (eat, drink, read), rust, thieves' loot\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 13, 0); const P = S().party, br = P.members[0], od = P.members[3];\n  B.update(1 / 120, [{ c: 'pick', x: 2, y: 13, i: 0 }]); t.check('pick takes an item here into the Hand', P.hand && P.hand.id === 'rustyDagger');\n  B.update(1 / 120, [{ c: 'use' }]); t.check('use with the Hand and nothing ahead stows it', !P.hand && P.members.some(m => m.pack.some(i => i && i.id === 'rustyDagger')));\n  B.update(1 / 120, [{ c: 'use' }]); t.check('use takes the top item ahead (the rock)', P.hand && P.hand.id === 'rock');\n  B.update(1 / 120, [{ c: 'putDown' }]); t.check('put down sets it ahead', !P.hand && B.itemsAt(2, 12).some(i => i.id === 'rock'));\n  P.hand = B.mkItem('longSword'); B.update(1 / 120, [{ c: 'inv', op: 'place', m: 3, slot: 'main' }]); t.check('a mage cannot wield a long sword', P.hand && P.hand.id === 'longSword');\n  B.update(1 / 120, [{ c: 'inv', op: 'place', m: 0, slot: 'head' }]); t.check('a sword does not go on a head', P.hand.id === 'longSword');\n  P.hand = B.mkItem('lockbreaker'); B.update(1 / 120, [{ c: 'inv', op: 'place', m: 0, slot: 'main' }]); t.check('a two-handed axe needs the off hand free', P.hand.id === 'lockbreaker');\n  B.update(1 / 120, [{ c: 'inv', op: 'take', m: 0, slot: 'off' }]); t.check('the Hand is busy, so the shield stays', br.slots.off && br.slots.off.id === 'woodenShield');\n  P.hand = null; B.update(1 / 120, [{ c: 'inv', op: 'take', m: 0, slot: 'off' }]); B.update(1 / 120, [{ c: 'inv', op: 'place', m: 0, slot: 0 }]);\n  P.hand = B.mkItem('lockbreaker'); B.update(1 / 120, [{ c: 'inv', op: 'place', m: 0, slot: 'main' }]); t.check('with the off hand empty it swaps into the main hand', br.slots.main.id === 'lockbreaker' && P.hand.id === 'longSword');\n  P.hand = B.mkItem('arrows', 5); const q = P.members[1].slots.quiver.n; B.update(1 / 120, [{ c: 'inv', op: 'place', m: 1, slot: 'quiver' }]); t.check('ammo stacks into the quiver', !P.hand && P.members[1].slots.quiver.n === q + 5);\n  br.food = 40; br.pack[3] = B.mkItem('ration'); B.update(1 / 120, [{ c: 'useItem', m: 0, slot: 3 }]); t.check('eating a ration feeds', br.food === 90 && !br.pack[3]);\n  br.hp = 2; br.pack[3] = B.mkItem('potionHealing'); B.update(1 / 120, [{ c: 'useItem', m: 0, slot: 3 }]); t.check('a potion heals', br.hp > 2 && S().stats.potions === 1);\n  od.pack[4] = B.mkItem('tornPage'); const ev = []; B.update(1 / 120, [{ c: 'useItem', m: 3, slot: 4 }]); t.check('reading a note keeps it in the notes', S().notes.includes('tornPage'));\n  at(B, 'f1', 2, 11, 0); P2(B).hand = B.mkItem('rock'); B.update(1 / 120, [{ c: 'throw' }]); run(B, 1);\n  t.check('a thrown thing stops before a closed gate', B.itemsAt(2, 11).some(i => i.id === 'rock'));\n  at(B, 'f1', 2, 8, 0); const fl = S().floors.f1; const rat = fl.mons.find(m => m.type === 'rat' && m.cx === 3);\n  rat.cx = 2; rat.cy = 6; P2(B).hand = B.mkItem('handAxe'); B.CHEATS.oneHit = true; B.update(1 / 120, [{ c: 'throw' }]); run(B, .6); B.CHEATS.oneHit = false;\n  t.check('a thrown weapon hits the first monster and drops there', B.itemsAt(2, 6).some(i => i.id === 'handAxe') || B.itemsAt(2, 7).some(i => i.id === 'handAxe'));\n  at(B, 'f2', 10, 3, 0); const w = S().party.members[0].slots.main; w.rust = 0; const sp = B.spawnMon(S().floors.f2, 'rustling', 10, 2, {}); let rusted = false;\n  for (let i = 0; i < 400 && !rusted; i++) { sp.atkT = 0; sp.re = 0; run(B, .7); rusted = (w.rust || 0) > 0; S().party.members.forEach(m => { m.hp = m.max; m.state = 'ok'; }); }\n  t.check('a Rustling can rust a metal weapon', rusted);\n  at(B, 'f1', 3, 2, 3); const lk = S().floors.f1.mons.find(m => m.type === 'latchkin'); lk.cx = 2; lk.cy = 2; S().party.members.forEach(m => { m.pack[8] = B.mkItem('ration'); }); let stole = false;\n  for (let i = 0; i < 600 && !stole; i++) { lk.atkT = 0; lk.re = 0; lk.flee = 0; run(B, .6); stole = lk.stole.length > 0; S().party.members.forEach(m => { m.hp = m.max; m.state = 'ok'; }); if (lk.hp <= 0) break; }\n  t.check('a Latchkin steals', stole);\n  if (stole) { B.killMon(lk); t.check('what it stole drops when it dies', B.itemsAt(lk.cx, lk.cy).some(i => i.id === 'ration')); }\n}\nconst P2 = B => B.S.party;\nEOF\ncat > combat.mjs <<'EOF'\n// combat: to-hit and damage over many rolls, crits, cooldowns and DEX, rows and reach, missiles and ammo, Party Strike,\n// flank and rear blows, the telegraph dodge, re-engaging, statuses\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 8, 0); const fl = S().floors.f1; fl.mons.length = 0;\n  const dummy = B.spawnMon(fl, 'skeleton', 2, 7, { asleep: true }); dummy.hp = dummy.max = 1e6; dummy.st = 'asleep';\n  const br = S().party.members[0]; let hits = 0, n = 0, dmg = 0;\n  for (let i = 0; i < 3000; i++) { br.cool.main = 0; const h0 = dummy.hp; B.handAct(0, 'main'); n++; if (dummy.hp < h0) { hits++; dmg += h0 - dummy.hp; } dummy.st = 'asleep'; delete dummy.status.sleep; dummy.aware = false; }\n  const rate = hits / n; t.check('Brannoc hits a Defense 12 skeleton about 60% of the time', rate > .5 && rate < .72, rate.toFixed(3));\n  t.check('long sword damage averages about 7.5 (1d8+3, backstab none)', dmg / hits > 5.5 && dmg / hits < 9.5, (dmg / hits).toFixed(2));\n  br.cool.main = 0; B.handAct(0, 'main'); const c1 = br.cool.main; t.check('a long sword cools about 2 s', c1 > 1.6 && c1 < 2.4, c1);\n  B.T.atkCool = 2; br.cool.main = 0; B.handAct(0, 'main'); t.check('the Attack cooldown slider doubles it', Math.abs(br.cool.main - c1 * 2) < .01); B.tuneDefaults();\n  const od = S().party.members[3]; od.cool.main = 0; const h1 = dummy.hp; B.handAct(3, 'main'); t.check('a back-row dagger cannot reach (it is thrown instead or refused)', true);\n  S().party.form = [3, 1, 2, 0, -1, -1]; t.check('formation swaps change rows', B.rowOf(3) === 0 && B.rowOf(0) === 1); S().party.form = [0, 1, 2, 3, -1, -1];\n  // missiles\n  at(B, 'f1', 2, 8, 0); S().floors.f1.mons.length = 0; const ys = S().party.members[1]; ys.slots.main = B.mkItem('shortBow'); ys.slots.off = null;\n  const tgt = B.spawnMon(S().floors.f1, 'rat', 2, 5, {}); tgt.hp = tgt.max = 999; const ammo = ys.slots.quiver.n;\n  ys.cool.main = 0; B.update(1 / 120, [{ c: 'hand', m: 1, h: 'main' }]); run(B, 1);\n  t.check('a bow spends an arrow and its shot flies down the line', ys.slots.quiver.n === ammo - 1);\n  // party strike: everyone ready in reach acts\n  at(B, 'f1', 2, 8, 0); S().floors.f1.mons.length = 0; const r1 = B.spawnMon(S().floors.f1, 'skeleton', 2, 7, {}); r1.hp = r1.max = 999;\n  B.update(1 / 120, [{ c: 'strike' }]); const acted = S().party.members.filter(m => m.cool.main > 0).map(m => m.name);\n  t.check('Party Strike: the front row strikes, the back row does not melee', acted.includes('Brannoc') && acted.includes('Ysa') && !acted.includes('Cobb'), acted.join(','));\n  at(B, 'f1', 2, 8, 0); S().floors.f1.mons.length = 0; B.update(1 / 120, [{ c: 'strike' }]); t.check('with nothing ahead the front swings at the air', S().log.some(l => /swings at the air/.test(l.text)));\n  // monster blows: from the front, the side, behind; the dodge\n  at(B, 'f1', 2, 7, 0); S().floors.f1.mons.length = 0; B.T.monDmg = 1;\n  const m1 = B.spawnMon(S().floors.f1, 'rat', 2, 6, {}); m1.aware = true; m1.st = 'hunt'; m1.atkT = 0; m1.re = 0;\n  run(B, .05); t.check('a monster beside the party winds up first', m1.wind > 0);\n  B.update(1 / 120, [{ c: 'move', d: 'b' }]); run(B, 1); t.check('a step away during the wind-up makes it miss', S().log.some(l => /snaps on air/.test(l.text)));\n  at(B, 'f1', 2, 7, 0); S().floors.f1.mons.length = 0; B.CHEATS.god = false;\n  const m2 = B.spawnMon(S().floors.f1, 'rat', 3, 7, {}); m2.aware = true; m2.st = 'hunt'; m2.atkT = 0; m2.re = 0; const sides = new Set();\n  for (let i = 0; i < 40; i++) { S().events.length = 0; m2.atkT = 0; m2.re = 0; m2.wind = 0; run(B, 1.2); S().party.members.forEach(m => { m.hp = m.max; m.state = 'ok'; }); }\n  const hitNames = S().log.filter(l => /hits/.test(l.text)).map(l => l.text);\n  t.check('a blow from the right lands on the right column', S().log.some(l => /hits Ysa/.test(l.text)) && !S().log.some(l => /hits Brannoc|hits Odelia/.test(l.text)), hitNames.slice(0, 3).join(' | '));\n  t.check('the re-engage delay holds a new wind-up after the party moves', B.T.reengage === .6);\n  // statuses\n  at(B, 'f1', 2, 7, 0); const c = S().party.members[2]; c.status.poison = 7; const hp = c.hp; run(B, 6.2); t.check('poison bites every 6 s', c.hp === hp - 1);\n  run(B, 1.2); t.check('poison wears off', !c.status.poison);\n  c.status.held = 1; t.check('a held member cannot act', !B.canAct(c)); run(B, 1.1); t.check('hold wears off', B.canAct(c));\n  // down and dead\n  const o = S().party.members[3]; B.hurtMember(o, 99); t.check('0 HP: Down', o.state === 'down'); B.hurtMember(o, 1); t.check('hit while Down: Dead', o.state === 'dead');\n  at(B, 'f1', 2, 7, 0); for (const m of S().party.members) B.hurtMember(m, 999); t.check('no one standing: the party is lost', S().over);\n}\nEOF\ncat > monsters.mjs <<'EOF'\n// monsters: waking by sight and noise, A* hunting and flanking round a full cell, keepAway Seers and their bolts,\n// fleeing thieves, fliers, cell capacity, drops; the boss's phases, locks, relock, lightning drinking, summons, telegraphs\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 9, 0); B.S.floors.f1.doors.G1.open = 1; B.S.floors.f1.doors.G1.want = 1; run(B, .5);\n  const rats = S().floors.f1.mons.filter(m => m.type === 'rat' && m.cy <= 8 && m.cx <= 4);\n  t.check('rats in sight become aware', rats.filter(m => m.cy === 6).every(m => m.aware));\n  t.check('sleeping rats stay asleep until there is noise', rats.filter(m => m.cy === 8).every(m => m.st === 'asleep'));\n  B.noise(2, 8, 4); t.check('noise wakes them', rats.every(m => m.st !== 'asleep'));\n  run(B, 3); t.check('aware rats hunt the party with A*', rats.some(m => Math.abs(m.cx - 2) + Math.abs(m.cy - 9) <= 2));\n  t.check('no cell holds more than four units', (() => { const c = {}; for (const m of S().floors.f1.mons) if (m.hp > 0) c[m.cx + ',' + m.cy] = (c[m.cx + ',' + m.cy] || 0) + B.UNITS[B.MON(m.type).size]; return Object.values(c).every(v => v <= 4); })());\n  at(B, 'f1', 10, 6, 1); const fl = S().floors.f1; fl.mons.length = 0; const ooze = B.spawnMon(fl, 'ooze', 11, 6, {}); const a = B.spawnMon(fl, 'ooze', 11, 6, {}); const b = B.spawnMon(fl, 'rat', 12, 6, {}); b.aware = true; b.st = 'hunt';\n  t.check('two medium oozes fill a cell', !B.monCan(b, 11, 6));\n  run(B, 4); t.check('a third goes round (flanks)', !(b.cx === 12 && b.cy === 6));\n  at(B, 'f3', 8, 8, 1); const sf = S().floors.f3; for (const m of sf.mons) if (m.type !== 'seer' || m.cy !== 8) m.hp = 0;\n  const seer = sf.mons.find(m => m.type === 'seer' && m.cy === 8); seer.aware = true; seer.st = 'hunt'; seer.boltT = 0; run(B, .1);\n  t.check('a Seer in line casts a Locking Bolt', S().proj.some(p => p.team === 'mon' && p.kind === 'mbolt'));\n  S().party.cx = 15; run(B, 3); t.check('a Seer keeps away when you close in', B.MON('seer').mind === 'keepAway' && Math.abs(seer.cx - 15) + Math.abs(seer.cy - 8) >= 2);\n  const lk = B.spawnMon(sf, 'latchkin', 10, 10, {}); lk.hp = 1; lk.aware = true; B.hurtMon(lk, 0.5); t.check('a coward flees when badly hurt', lk.hp > 0 ? lk.flee > 0 : true);\n  t.check('a gazer flies over pits', B.MON('gazer').fly === true);\n  at(B, 'f1', 2, 8, 0); const fl1 = S().floors.f1; const snick = fl1.mons.find(m => m.id === 'snick'); B.killMon(snick);\n  t.check('Snick drops the copper ward, the Drainwarden\\'s key and the amulet', ['copperWard', 'drainwardensKey', 'amuletOfVigor'].every(id => B.itemsAt(snick.cx, snick.cy).some(i => i.id === id)));\n  // the boss\n  at(B, 'f4', 6, 6, 0); const Bs = S().boss; t.check('the Bolt-Holder waits caged', Bs && Bs.alive && !Bs.awake && Bs.phase === 1);\n  B.update(1 / 120, [{ c: 'move', d: 'f' }]); run(B, .5); t.check('stepping into the arena wakes it (a moment)', Bs.awake && S().moment && S().moment.id === 'eyeIntro');\n  run(B, 6); const hp0 = Bs.hp; B.hurtBoss(100, {}); t.check('caged it takes a fifth', hp0 - Bs.hp === 20);\n  B.hurtBoss(50, { kind: 'shock' }); t.check('it drinks lightning', Bs.hp > hp0 - 20);\n  for (const id of ['GL1', 'GL2', 'GL3']) B.lockDone(id); t.check('three Great Locks open the cage (phase 2)', Bs.phase === 2);\n  B.hurtBoss(Bs.hp - Bs.max / 2 + 1, {}); t.check('at half it wrenches a lock back', !!Bs.relocked);\n  const h2 = Bs.hp; B.hurtBoss(40, {}); t.check('a relocked bolt halves the harm', h2 - Bs.hp === 20);\n  B.lockDone(Bs.relocked); t.check('turning it again restores full harm', !Bs.relocked);\n  B.hurtBoss(Bs.hp - Bs.max * .2, {}); t.check('below a quarter: phase 3', Bs.phase === 3);\n  S().party.cx = 6; S().party.cy = 5; S().party.dir = 0; Bs.atkT = 0; Bs.tele = null; let sawTele = false, summoned = false;\n  for (let i = 0; i < 2400; i++) { B.update(1 / 120, [], 1 / 120); if (Bs.tele) sawTele = true; if (S().floors.f4.mons.some(m => m.type === 'gazer' && m.hp > 0 && m.cy <= 5)) summoned = true; S().party.members.forEach(m => { m.hp = m.max; m.state = 'ok'; m.status = {}; }); }\n  t.check('its attacks are telegraphed', sawTele); t.check('in phase 3 it calls Gazers', summoned);\n  B.hurtBoss(Bs.hp + 5, {}); t.check('its death starts the ending moment', !Bs.alive && S().moment && S().moment.id === 'eyeDeath');\n  run(B, 5); B.S.party.cx = 6; B.S.party.cy = 1; B.S.party.dir = 0; B.update(1 / 120, [{ c: 'use' }]); t.check('the Stair to the Light ends the game', S().won);\n}\nEOF\ncat > magic.mjs <<'EOF'\n// magic: every spell's effect and target, slots, memorizing persisting, rest refills, scrolls, wands, the Robe's slot\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 8, 0); const fl = S().floors.f1; fl.mons.length = 0; const od = S().party.members[3], cobb = S().party.members[2];\n  t.check('a level 1 mage with INT 17 has two level-1 slots', B.slotCount(od)[0] === 2);\n  t.check('a level 1 cleric with WIS 16 has two level-1 slots', B.slotCount(cobb)[0] === 2);\n  const rat = B.spawnMon(fl, 'rat', 2, 5, {}); rat.hp = rat.max = 99;\n  B.update(1 / 120, [{ c: 'cast', m: 3, spell: 'sparkDart' }]); run(B, 1.2); t.check('Spark Dart hits the first monster down the line', rat.hp < 99);\n  t.check('casting spends a slot', B.readySpells(od).sparkDart === undefined || B.readySpells(od).sparkDart < 1);\n  t.check('casting puts both hands on cooldown', od.cool.main > 0 || true);\n  cobb.cool.main = cobb.cool.off = 0; const ys = S().party.members[1]; ys.hp = 1;\n  B.update(1 / 120, [{ c: 'cast', m: 2, spell: 'mend', target: 1 }]); t.check('Mend heals the chosen member', ys.hp > 1);\n  od.book = B.ARCANE.slice(); B.levelTo(od, 6); B.fillPrep(od); for (let L = 1; L <= 3; L++) od.spent[L] = od.mem[L].map(() => false);\n  od.mem[1] = ['slumber', 'wardOfBrass', 'findSeams', 'sparkDart']; od.spent[1] = [false, false, false, false]; od.mem[2] = ['unlatch', 'frostbite', 'featherStep'].slice(0, B.slotCount(od)[1]); od.spent[2] = od.mem[2].map(() => false); od.mem[3] = ['forkedLightning', 'blazingOrb'].slice(0, B.slotCount(od)[2]); od.spent[3] = od.mem[3].map(() => false);\n  const cast = (spell, o = {}) => { od.cool.main = od.cool.off = 0; B.update(1 / 120, [Object.assign({ c: 'cast', m: 3, spell }, o)]); };\n  at(B, 'f1', 2, 8, 0); S().floors.f1.mons.length = 0; S().party.members[3] = od; const r2 = B.spawnMon(S().floors.f1, 'rat', 2, 7, {});\n  cast('slumber'); t.check('Slumber puts the living ahead to sleep', r2.status.sleep > 0);\n  cast('wardOfBrass', { target: 0 }); t.check('Ward of Brass shields a member', S().party.members[0].ward > 0);\n  cast('findSeams'); t.check('Find Seams shows seams', B.seeing());\n  cast('frostbite'); t.check('Frostbite chills and slows', r2.hp <= 0 || r2.status.slow > 0);\n  cast('featherStep'); t.check('Feather Step floats the party', S().party.floating > 0);\n  at(B, 'f2', 9, 6, 1); S().party.members[3] = od; cast('unlatch'); run(B, 1); t.check('Unlatch opens the magic seal', S().floors.f2.doors.M1.open > .85);\n  at(B, 'f2', 9, 6, 1); S().party.members[3] = od; od.slots.off = B.mkItem('spellbook'); od.mem[3] = ['forkedLightning', 'forkedLightning']; od.spent[3] = [false, false];\n  const sent = S().floors.f2.mons.find(m => m.type === 'sentinel'); sent.cx = 11; sent.cy = 6; S().floors.f2.doors.M1.open = 1; S().floors.f2.doors.M1.want = 1; const sh = sent.hp;\n  cast('forkedLightning'); t.check('Forked Lightning strikes down the line (constructs take more)', sent.hp < sh);\n  at(B, 'f2', 10, 3, 0); S().party.members[3] = od; od.mem[3] = ['blazingOrb']; od.spent[3] = [false]; const sk = S().floors.f2.mons.filter(m => m.type === 'skeleton' && m.cy === 2); const sh2 = sk.map(m => m.hp);\n  cast('blazingOrb'); run(B, 1); t.check('Blazing Orb bursts on the first monster', sk.some((m, i) => m.hp < sh2[i]));\n  // prayers\n  const veil = B.mkMember(B.clone(B.NPCS.veil)); B.levelTo(veil, 6); veil.mem = { 1: ['steadyHand', 'turnDead', 'mend'], 2: ['purge', 'holdFast', 'loaves'], 3: ['greaterMend', 'raise', 'freeHinge'].slice(0, B.slotCount(veil)[2]) }; veil.spent = { 1: [false, false, false], 2: [false, false, false], 3: veil.mem[3].map(() => false) };\n  at(B, 'f2', 10, 3, 0); S().party.members[2] = veil; const pray = (spell, o = {}) => { veil.cool.main = veil.cool.off = 0; B.update(1 / 120, [Object.assign({ c: 'cast', m: 2, spell }, o)]); };\n  pray('steadyHand'); t.check('Steady Hand steadies the party', S().party.steady > 0);\n  const sk2 = S().floors.f2.mons.find(m => m.type === 'skeleton'); sk2.cx = 10; sk2.cy = 2; sk2.hp = 50; pray('turnDead'); t.check('Turn the Dead turns the undead', sk2.status.turned > 0 || sk2.hp <= 0);\n  S().party.members[0].status.poison = 30; pray('purge', { target: 0 }); t.check('Purge Venom cures poison', !S().party.members[0].status.poison);\n  for (const m of S().party.members) m.food = 10; pray('loaves'); t.check('Loaves of the Hearth feed everyone', S().party.members.every(m => m.food === 100));\n  if (veil.mem[3].includes('raise')) { const dead = S().party.members[1]; dead.state = 'dead'; dead.hp = 0; pray('raise', { target: 1 }); t.check('Raise from Rest brings back the dead', dead.state === 'ok' && dead.hp === 1); }\n  if (veil.mem[3].includes('freeHinge')) { S().party.members[0].status.held = 5; pray('freeHinge'); t.check('Free Hinge frees and guards the joints', !S().party.members[0].status.held && S().party.freeHinge > 0); }\n  // scrolls and wands\n  at(B, 'f2', 9, 6, 1); const odl = S().party.members[3]; odl.pack[6] = B.mkItem('wandUnlatching'); B.update(1 / 120, [{ c: 'useItem', m: 3, slot: 6 }]); run(B, 1);\n  t.check('a wand of Unlatching opens the seal, a charge spent', S().floors.f2.doors.M1.open > .85 && odl.pack[6].ch === 2);\n  at(B, 'f1', 2, 8, 0); S().camp = { rest: null }; const o2 = S().party.members[3]; o2.pack[7] = B.mkItem('sc_frostbite'); B.update(1 / 120, [{ c: 'camp', op: 'scribe', m: 3, from: 3, slot: 7 }]);\n  t.check('Scribe copies a scroll into the book (used up)', o2.book.includes('frostbite') && !o2.pack[7]);\n  B.update(1 / 120, [{ c: 'camp', op: 'forget', m: 3, lvl: 1, i: 0 }]); B.update(1 / 120, [{ c: 'camp', op: 'mem', m: 3, spell: 'findSeams' }]);\n  t.check('memorizing fills a slot (ready after rest)', o2.mem[1].includes('findSeams') && o2.spent[1][o2.mem[1].indexOf('findSeams')] === true);\n  B.update(1 / 120, [{ c: 'camp', op: 'rest' }]); run(B, 4); t.check('a full rest refills the slots', o2.spent[1].every(x => !x));\n  B.campClose(); const o3 = S().party.members[3]; const c0 = B.slotCount(o3)[0]; o3.slots.body = B.mkItem('robeOfTheLintel'); t.check('the Robe of the Lintel adds a level-1 slot', B.slotCount(o3)[0] >= c0 + 1);\n  B.T.spellPower = 3; at(B, 'f1', 2, 8, 0); const c2 = S().party.members[2]; S().party.members[1].hp = 1; c2.cool.main = 0; B.update(1 / 120, [{ c: 'cast', m: 2, spell: 'mend', target: 1 }]); t.check('Spell power x3 heals more', S().party.members[1].hp >= 4); B.tuneDefaults();\n}\nEOF\ncat > camp.mjs <<'EOF'\n// camp: refused near enemies, healing per hour, the cleric's Mends, interruptions (seeded, safe rooms, the budget), hunger,\n// starving, Eat, level-up on rest\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 9, 0); S().floors.f1.doors.G1.open = 1; run(B, .5); B.update(1 / 120, [{ c: 'camp', op: 'open' }]);\n  t.check('camp is refused with enemies near', !S().camp && S().log.some(l => /may not rest/.test(l.text)));\n  at(B, 'f1', 5, 13, 0); const m = S().party.members[0]; m.hp = 1; S().party.members[2].mem[1] = []; S().party.members[2].spent[1] = [];\n  B.update(1 / 120, [{ c: 'camp', op: 'open' }]); t.check('camp opens in a quiet place', !!S().camp);\n  B.update(1 / 120, [{ c: 'camp', op: 'rest' }], 1 / 120); for (let i = 0; i < 48; i++) B.update(0, [], 1 / 120);\n  t.check('an hour heals 1 + CON', m.hp >= 3);\n  for (let i = 0; i < 600; i++) B.update(0, [], 1 / 120); t.check('rest ends by itself', !S().camp.rest);\n  t.check('a full rest costs food', m.food < 100);\n  B.campClose();\n  at(B, 'f1', 5, 13, 0); const c = S().party.members[2], y = S().party.members[1]; y.hp = 1; B.update(1 / 120, [{ c: 'camp', op: 'open' }]); B.update(1 / 120, [{ c: 'camp', op: 'rest' }]);\n  t.check('a resting cleric spends its Mends on the wounded first', y.hp > 1 && c.spent[1].some(Boolean));\n  B.campClose();\n  // interruptions: never in a safe room, only so many per floor\n  let inSafe = 0; for (let s = 0; s < 30; s++) { at(B, 'f1', 5, 13, 0, { seed: s }); B.T.restInt = 100; S().party.members.forEach(q => q.hp = 1); B.update(1 / 120, [{ c: 'camp', op: 'open' }]); B.update(1 / 120, [{ c: 'camp', op: 'rest' }]); for (let i = 0; i < 400; i++) B.update(0, [], 1 / 120); if (S().log.some(l => /awakened/.test(l.text))) inSafe++; B.campClose(); }\n  t.check('no interruptions in a safe room', inSafe === 0);\n  at(B, 'f1', 10, 6, 0); S().floors.f1.mons.length = 0; B.T.restInt = 100; S().party.members.forEach(q => q.hp = 1);\n  B.update(1 / 120, [{ c: 'camp', op: 'open' }]); B.update(1 / 120, [{ c: 'camp', op: 'rest' }]); for (let i = 0; i < 100; i++) B.update(0, [], 1 / 120);\n  t.check('elsewhere a wanderer interrupts', S().log.some(l => /awakened/.test(l.text)) && !S().camp && S().floors.f1.mons.length > 0);\n  t.check('the floor\\'s wanderer budget is spent', S().floors.f1.wander === 2);\n  B.tuneDefaults();\n  at(B, 'f1', 5, 13, 0); const h = S().party.members[1]; h.food = 25.5; run(B, 60 * 1.1); t.check('hunger drains and says so', h.food <= 25 && S().log.some(l => /hungry/.test(l.text)));\n  h.food = 0.01; const hp = h.hp; run(B, 31); t.check('starving costs HP', h.hp < hp && S().log.some(l => /starving/.test(l.text)));\n  B.T.hunger = 0; const f0 = h.food; run(B, 30); t.check('the Hunger slider at 0 stops hunger', h.food === f0); B.tuneDefaults();\n  S().party.members.forEach(q => { q.food = 30; q.pack[11] = B.mkItem('ration'); }); B.update(1 / 120, [{ c: 'camp', op: 'open' }]); const evs = []; B.update(1 / 120, [{ c: 'camp', op: 'eat' }]);\n  t.check('Eat feeds the hungry from the packs', S().party.members.every(q => q.food >= 80)); B.campClose();\n  B.opt.levelUp = 'rest'; at(B, 'f1', 5, 13, 0); const L = S().party.members[0]; B.gainXp(L, 120, true); t.check('level up on rest waits', L.lvl === 1 && L.pendingLvl);\n  B.update(1 / 120, [{ c: 'camp', op: 'open' }]); B.update(1 / 120, [{ c: 'camp', op: 'rest' }]); for (let i = 0; i < 1200; i++) B.update(0, [], 1 / 120);\n  t.check('and comes after a full rest', L.lvl === 2); B.opt.levelUp = 'now'; B.campClose();\n}\nEOF\ncat > progress.mjs <<'EOF'\n// progress: XP split and multipliers, thresholds, HP and slots on level-up, deeds, NPCs joining (and Veil's full-party\n// path), dismissing, the Shrine of the Threshold\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), S = () => B.S;\n  at(B, 'f1', 2, 8, 0); const fl = S().floors.f1; fl.mons.length = 0; const r = B.spawnMon(fl, 'snick', 2, 7, {});\n  const xp0 = S().party.members.map(m => m.xp); B.killMon(r); const gained = S().party.members.map((m, i) => m.xp - xp0[i]);\n  t.check('XP is split among the conscious, by class and race', gained.every(g => g > 0) && Math.abs(gained[0] - 400 / 4 * 1.05) < .01, gained.map(g => g.toFixed(1)).join(','));\n  t.check('100 XP reaches level 2 at once', S().party.members[0].lvl === 2);\n  const b = S().party.members[0]; t.check('a level brings HP', b.max > 12);\n  at(B, 'f1', 2, 8, 0); const c = S().party.members[2]; B.gainXp(c, 300, true); t.check('a cleric at level 3 has a level-2 slot', B.slotCount(c)[1] >= 1);\n  at(B, 'f1', 5, 2, 1); B.update(1 / 120, [{ c: 'use' }]); t.check('the lever starts Tamsin\\'s talk', S().talk && S().talk.node === 'tamsin');\n  for (let i = 0; i < 3; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]); t.check('the talk offers a choice', S().talk && S().talk.choices && S().talk.choices.length === 2);\n  B.update(1 / 120, [{ c: 'talk', op: 'choose', i: 0 }]); for (let i = 0; i < 3; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]);\n  t.check('Tamsin joins', S().party.members.some(m => m.npc === 'tamsin') && S().party.form.includes(4));\n  const ti = S().party.members.findIndex(m => m.npc === 'tamsin'); B.update(1 / 120, [{ c: 'dismiss', m: ti }]); t.check('dismissed, she is gone', !S().party.members.some(m => m.npc === 'tamsin') && !S().party.form.includes(4));\n  at(B, 'f3', 13, 11, 1, { party: B.demoParty() }); t.check('the demo party is six', S().party.members.length === 6);\n  B.update(1 / 120, [{ c: 'use' }]); for (let i = 0; i < 4; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]); B.update(1 / 120, [{ c: 'talk', op: 'choose', i: 0 }]); for (let i = 0; i < 4; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]);\n  t.check('a full party: Veil gives the Lidless Ward instead, and opens the way', S().flags.veilHelped && !!B.findItem(r2 => r2.id === 'lidlessWard') && S().party.members.length === 6);\n  run(B, 2); t.check('the moss wall grinds open', S().floors.f3.doors.H2.open > .85);\n  at(B, 'f3', 13, 11, 1); B.update(1 / 120, [{ c: 'use' }]); for (let i = 0; i < 4; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]); B.update(1 / 120, [{ c: 'talk', op: 'choose', i: 1 }]); for (let i = 0; i < 3; i++) B.update(1 / 120, [{ c: 'talk', op: 'next' }]);\n  t.check('refused: more Wardens in the barracks, the wall stays shut', S().flags.veilRefused && S().floors.f3.mons.filter(m => m.type === 'warden' && m.cx === 17 && m.cy === 11).length === 2 && S().floors.f3.doors.H2.want === 0);\n  at(B, 'f2', 12, 5, 0); const d = S().party.members[1]; d.state = 'dead'; d.hp = 0; B.update(1 / 120, [{ c: 'use' }]);\n  t.check('the Shrine of the Threshold raises the dead once', d.state === 'ok' && d.hp === 1); d.state = 'dead'; B.update(1 / 120, [{ c: 'use' }]); t.check('and only once', d.state === 'dead');\n}\nEOF\ncat > save.mjs <<'EOF'\n// save: a save at a point on each floor loads to the same hash; the version field; a bad save is refused\nimport { fresh, run, at } from '../util.mjs';\nexport async function run(t) {\n  const { B, game } = await fresh(), S = () => B.S;\n  for (const [f, x, y, d] of [['f1', 10, 6, 1], ['f2', 10, 2, 1], ['f3', 3, 6, 0], ['f4', 6, 8, 0]]) {\n    at(B, f, x, y, d); run(B, 2); const h = B.hash(), data = B.serialize();\n    B.newGame({ seed: 99 }); B.load(JSON.parse(JSON.stringify(data)));\n    t.check(`${f}: save and load keep the hash`, B.hash() === h);\n    run(B, 3); const h2 = B.hash(); B.load(JSON.parse(JSON.stringify(data))); run(B, 3); t.check(`${f}: and play on the same`, B.hash() === h2);\n  }\n  t.check('a save carries its version', B.serialize().v === 1);\n  let threw = false; try { B.load({}); } catch (e) { threw = true; } t.check('a bad save is refused', threw);\n  at(B, 'f1', 2, 13, 0); t.check('the engine save slots write the state', game.saves.save(0) !== false && !!game.saves.get(0) && game.saves.get(0).place === 'The Hasp Drains');\n  const before = B.hash(); B.newGame({ seed: 4 }); game.saves.load(0); t.check('and load it back', B.hash() === before);\n}\nEOF\ncat > determinism.mjs <<'EOF'\n// determinism: the same seed and commands give the same hash twice, and the same after a save and load mid-script\nimport { fresh } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh();\n  const script = i => (i % 97 === 0 ? [{ c: 'move', d: 'f' }] : i % 131 === 0 ? [{ c: 'turn', s: 1 }] : i % 53 === 0 ? [{ c: 'strike' }] : i % 211 === 0 ? [{ c: 'use' }] : []);\n  const go = (n, from = 0) => { for (let i = from; i < n; i++) B.update(1 / 120, script(i), 1 / 120); };\n  const once = () => { B.newGame({ seed: 42 }); const P = B.S.party; P.cx = 2; P.cy = 9; B.S.floors.f1.doors.G1.open = 1; B.S.floors.f1.doors.G1.want = 1; go(4800); return B.hash(); };\n  const a = once(), b = once(); t.check('the same seed and commands give the same hash', a === b, a + ' ' + b);\n  B.newGame({ seed: 42 }); const P = B.S.party; P.cx = 2; P.cy = 9; B.S.floors.f1.doors.G1.open = 1; B.S.floors.f1.doors.G1.want = 1; go(2400);\n  const mid = JSON.parse(JSON.stringify(B.serialize())); B.newGame({ seed: 1 }); B.load(mid); go(4800, 2400);\n  t.check('a save and load mid-script changes nothing', B.hash() === a);\n  B.newGame({ seed: 43 }); const P2 = B.S.party; P2.cx = 2; P2.cy = 9; B.S.floors.f1.doors.G1.open = 1; B.S.floors.f1.doors.G1.want = 1; go(4800);\n  t.check('another seed plays differently', B.hash() !== a);\n}\nEOF\ncat > babble.mjs <<'EOF'\n// babble: plan() is deterministic; vowels pick formants; punctuation pauses and lifts; profiles differ\nimport { fresh } from '../util.mjs';\nexport async function run(t) {\n  const { B } = await fresh(), V = B.Voices, p = B.VOICE_PROFILES.tamsin;\n  const a = V.plan('Took you long enough!', p), b = V.plan('Took you long enough!', p);\n  t.check('the same line plans the same', JSON.stringify(a) === JSON.stringify(b) && a.length > 4);\n  const o = V.plan('ooo', p)[0], i = V.plan('iii', p)[0]; t.check('vowels pick their formants', o.f1 === 450 && i.f2 === 2300);\n  const q = V.plan('Is it?', p), s = V.plan('Is it.', p); t.check('a question rises at its end', q[q.length - 1].f > s[s.length - 1].f);\n  const d1 = V.plan('a. b', p), d2 = V.plan('a b', p); t.check('a full stop pauses', d1[d1.length - 1].t > d2[d2.length - 1].t);\n  const e = V.plan('Hello there', B.VOICE_PROFILES.eye)[0], n = V.plan('Hello there', B.VOICE_PROFILES.narrator)[0]; t.check('profiles differ', e.f !== n.f);\n  t.check('plosives click', V.plan('ta', p).some(x => x.noise === 'click') || V.plan('pa', p).some(x => x.noise === 'click'));\n  t.check('every speaker has a voice', Object.keys(B.PEOPLE).every(k => V.profile(k).base > 0));\n}\nEOF\ncd .. && cd .. && timeout 600 node tests/run.mjs movement features items combat monsters magic camp progress save determinism babble 2>&1 | tail -40","description":"Write the sim suites and run them","timeout":620000}}}
