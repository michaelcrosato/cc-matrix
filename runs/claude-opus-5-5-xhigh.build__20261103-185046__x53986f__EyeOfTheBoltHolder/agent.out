 def.kind === 'warded' ? 'm_wardedLock' : 'm_locked'); ev('sfx', { id: 'lockFail' });\",\"  say(d.lk === 'warded' ? 'm_wardedLock' : 'm_locked'); ev('sfx', { id: 'lockFail' });\")\ns=s.replace(\"  const def = (B.FLOORS[S.floor].doors[d.id] || [])[2];\\n\",\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"lk ===\\|def &&\" src/24-sim-items.js; grep -n \"lk:\" src/15-data-floors.js | head","description":"Fix lock-kind option name clash and simplify lockpicking"}},"wire_ingest_context":{"toolu_014wqnf1s2YFCRRBDGshtD5z":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-185046__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-xhigh-20261103-185046"}}}
