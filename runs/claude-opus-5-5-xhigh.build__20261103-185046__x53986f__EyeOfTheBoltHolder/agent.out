party', B.S.party.members.map(m => m.name + ':' + m.lvl + ' ' + m.state + ' ' + m.hp + '/' + m.max).join(' '));\nconsole.log('special', JSON.stringify(B.S.special), 'secrets', JSON.stringify(B.S.secrets), 'stats', JSON.stringify(B.S.stats));\nEOF\ntimeout 300 node tests/tmp/botrun.mjs 1 12 2>&1 | tail -30","description":"Run the bot through the campaign headless","timeout":320000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15564,"cache_read_input_tokens":637634,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15564},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d562a4a4-1880-473a-a05f-38e08e0d0050","uuid":"7e904fe3-9ea7-4c7a-89cf-0ae276c5315a","timestamp":"2026-11-04T02:50:50.500Z","request_id":"req_011Cgh8PYK6PXpi233hLHCGw","wire_tool_inputs":{"toolu_014Q6KFv9gL4WTwRLR2UpDR2":{"command":"mkdir -p /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-185046__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-xhigh-20261103-185046/tests/tmp && cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-185046__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-xhigh-20261103-185046 && cat > tests/tmp/botrun.mjs <<'EOF'\nimport { load } from '../load.mjs';\nconst { B } = load({ quiet: true });\nconst seed = +(process.argv[2] || 1), maxMin = +(process.argv[3] || 30);\nB.newGame({ seed });\nB.beginCampaign();\nconst bot = B.Bot.campaign({ choices: { veil: process.argv[4] === 'refuse' ? 1 : 0 } });\nlet t = 0, lastFloor = null, lastStep = -1, lastLog = 0;\nconst dt = 1 / 120;\ntry {\n  for (; t < maxMin * 60 && !B.S.won && !B.S.over; t += dt) {\n    const cmds = bot.tickAll(dt);\n    B.update(dt, cmds, dt);\n    if (B.S.floor !== lastFloor) { lastFloor = B.S.floor; console.log(`[${t.toFixed(0)}s] floor ${lastFloor}`, B.S.party.members.map(m => m.name + ':' + m.lvl + ' ' + m.hp + '/' + m.max).join(' ')); }\n    if (bot.i !== lastStep) { lastStep = bot.i; const st = bot.steps[bot.i]; if (process.env.V) console.log(`  [${t.toFixed(1)}] step ${bot.i} ${st ? JSON.stringify(st) : 'END'} at ${B.S.party.cx},${B.S.party.cy}`); }\n    if (process.env.V && B.S.log.length !== lastLog) { for (const l of B.S.log.slice(lastLog)) console.log('      log:', l.text); lastLog = B.S.log.length; }\n  }\n} catch (e) { console.log('ERROR at', t.toFixed(1), e.stack); }\nconsole.log('end t', t.toFixed(0), 'won', B.S.won, 'over', B.S.over, 'floor', B.S.floor, 'step', bot.i, JSON.stringify(bot.steps[bot.i]), 'at', B.S.party.cx, B.S.party.cy);\nconsole.log('skipped', bot.skipped);\nconsole.log('party', B.S.party.members.map(m => m.name + ':' + m.lvl + ' ' + m.state + ' ' + m.hp + '/' + m.max).join(' '));\nconsole.log('special', JSON.stringify(B.S.special), 'secrets', JSON.stringify(B.S.secrets), 'stats', JSON.stringify(B.S.stats));\nEOF\ntimeout 300 node tests/tmp/botrun.mjs 1 12 2>&1 | tail -30","description":"Run the bot through the campaign headless","timeout":320000}}}
