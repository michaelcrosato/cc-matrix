const f of readdirSync(join(DEV, 'src')).filter(f => f.endsWith('.js')).sort()) src(join(DEV, 'src', f)).runInContext(ctx);\n  const DQ = ctx.DQ, E = ctx.My3D2dge;\n  return { E, DQ, game: DQ.game, ctx };\n}\n\n/** helpers bound to one loaded game */\nexport function helpers(L) {\n  const { game, DQ } = L, I = game.input;\n  return {\n    run: s => game.advance(s),\n    tap: (a, s = .05) => { I.tap(a); game.advance(s); },\n    hold: (a, s) => { I.hold(a, true); game.advance(s); I.hold(a, false); game.advance(1 / 120); },\n    snap: () => game.debug.snapshot(),\n    errs: () => game.errors.map(e => e.where + ': ' + e.message).join(' | ')\n  };\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2334,"cache_read_input_tokens":249463,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2334},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9acc64b9-af41-4198-9bbd-536ec13fbed1","uuid":"8e61b554-263f-4dbf-85de-79cccb53eaef","timestamp":"2026-11-04T05:04:42.066Z","request_id":"req_011CghJbRXoQ4okCWsj9LsBk","wire_tool_inputs":{"toolu_01P4N3ksf9MaiJbAijc9DQAi":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-215521__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-xhigh-20261103-215521/tests/lib/load.mjs","content":"// Loads the engine and every game module into a fresh vm context (headless: no DOM), the way the bundle runs them.\nimport vm from 'node:vm';\nimport { readFileSync, readdirSync, existsSync } from 'node:fs';\nimport { join, dirname } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nexport const DEV = join(dirname(fileURLToPath(import.meta.url)), '../..');\nconst cache = new Map();\nconst src = p => { if (!