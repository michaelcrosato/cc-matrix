mera for a spec (in update): returns the map to draw */","+  prepare(spec, dt) {","+    const loc = G.LOCS[spec.loc] ? spec.loc : 'beach', map = G.locMaps()[loc], list = this.rigsFor(spec), g = G.game;","+    const viewId = spec.cam && spec.cam.view && E.VIEWS[spec.cam.view] ? spec.cam.view : 'threequarter';","+    if (!g.view || g.view.id !== viewId) g.setView(viewId);","+    const at = (spec.cam && spec.cam.at) || (list.length ? [list.reduce((a, c) => a + c.x, 0) / list.length, list.reduce((a, c) => a + c.y, 0) / list.length] : G.LOCS[loc].spawn);","+    g.cam.bounds = null; g.follow(null); g.focus(at[0], at[1], 16); g.setZoom((spec.cam && spec.cam.zoom) || 1);","+    const yaw = Math.round(((spec.cam && spec.cam.yaw) || 0) / 15) * 15; if (Math.round(g.yaw || 0) !== yaw && !g.view.isSide) g.rotateView(yaw - (g.yaw || 0));","+    for (const c of list) { const pose = c.p.pose || 'none', mv = this.MOVE[pose]; c.rig.vb = mv ? { kind: mv, u: .5, w: 1 } : null;","+      c.rig.update(dt, { x: c.x, y: c.y, z: c.z, facing: c.f, pose: this.POSE[pose] || null, expr: c.p.expr && c.p.expr !== 'neutral' ? c.p.expr : null }); }","+    return { loc, map, list };","+  },","+  draw(r, spec) {","+    const loc = G.LOCS[spec.loc] ? spec.loc : 'beach', map = G.locMaps()[loc], tod = spec.tod || 'afternoon', night = tod === 'night';","+    G.applyLight(tod, 'sunny', night || loc === 'casino' || loc === 'villa');","+    if (loc !== 'villa' && loc !== 'casino') G.backdrop(tod).draw(r);","+    map.drawFloor(r); if (map.queueWalls) map.queueWalls(r); G.drawLocProps(r, loc, night);","+    for (const c of this.rigsFor(spec)) { r.shadow(c.x, c.y, 6, .3); r.actor(c.x, c.y, c.z, (g, ox, oy) => c.rig.draw(g, ox, oy, r.view), { key: c.rig }); }","+    if (night) G.game.lights.add((spec.cam && spec.cam.at || [352, 240])[0], (spec.cam && spec.cam.at || [352, 240])[1], 30, 160, .7, { color: '#ffd8a0' });","+    r.overlay(g => {","+      const W = r.W, H = r.H, f = spec.filter;","+      if (f === 'Sunny') px.blend(g, .15, 'screen', () => px.rect(g, 0, 0, W, H, '#ffb060')); else if (f === 'Sepia') px.blend(g, .35, 'multiply', () => px.rect(g, 0, 0, W, H, '#c8a070'));","+      else if (f === 'Night Glow') px.blend(g, .3, 'multiply', () => px.rect(g, 0, 0, W, H, '#6a80ff')); else if (f === 'Retro') px.blend(g, .15, 'normal', () => { for (let y = 0; y < H; y += 2) px.rect(g, 0, y, W, 1, '#000000'); });","+      if (spec.frame === 'Postcard') { px.rect(g, 0, 0, W, 6, '#fff8e8'); px.rect(g, 0, H - 18, W, 18, '#fff8e8'); px.rect(g, 0, 0, 6, H, '#fff8e8'); px.rect(g, W - 6, 0, 6, H, '#fff8e8'); E.font.text(g, 'Greetings from Isla Fortuna', 10, H - 14, '#c8502a', { outline: false }); E.font.text(g, 'Day ' + (spec.day || 1), W - 10, H - 14, '#2a6ad8', { align: 'right', outline: false }); }","+    });","+  }","+};"," G.photo = {","   open() {","     if (G.hub || G.attract.active && !this.demo || G.overlay.has('photo')) return;"]},{"oldStart":19257,"oldLines":7,"newStart":19298,"newLines":8,"lines":["     if (album.length >= 24) album.shift();","     G.sfx('shutter'); G.sting('photo'); S.flash = .25; G.game.flash('#ffffff', .15);","     const spec = { loc: G.game.sceneName === 'location' ? (G.LOC && G.LOC.id) : G.game.sceneName, day: St ? St.day : 0, slot: St ? St.slot : 0, tod: G.curTod || 'afternoon',","-      cam: { yaw: G.game.yaw || 0, zoom: S.zoom }, people: S.subs.map((p, k) => ({ id: p.id, pose: k === S.sub ? G.PHOTO_POSES[S.pose] : 'none', expr: k === S.sub ? G.PHOTO_EXPR[S.expr] : 'smile' })),","+      cam: { yaw: G.game.yaw || 0, zoom: S.zoom, view: G.game.baseView ? G.game.baseView.id : (G.game.view && G.game.view.id), at: G.photoFocus() },","+      people: S.subs.map((p, k) => ({ id: p.id, x: Math.round(p.rig.x), y: Math.round(p.rig.y), z: Math.round(p.rig.z || 0), facing: +(p.rig.facing || 0).toFixed(2), suit: p.rig.suit || null, acc: (p.rig.acc || []).slice(), pose: k === S.sub ? G.PHOTO_POSES[S.pose] : 'none', expr: k === S.sub ? G.PHOTO_EXPR[S.expr] : 'smil