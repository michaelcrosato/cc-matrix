own'));","+step('howto', () => G.go('howto', { from: 'menu' }));","+step('about', () => G.go('about'));","+step('about page', () => I.tap('tabR'));","+step('exhibition', () => G.go('exhibition'));","+step('exh next', () => { for (let i = 0; i < 5; i++) { I.tap('down'); game.advance(.1); } I.tap('confirm'); });","+step('exh ready', () => I.tap('confirm'), 2);","+step('new vacation', () => G.newVacationFlow());","+step('invitation confirm', () => { I.tap('confirm'); game.advance(.1); I.tap('confirm'); });","+step('charselect pick', () => I.tap('confirm'), 1);","+for (let k = 0; k < 30 && game.sceneName === 'cutscene'; k++) { I.tap('confirm'); game.advance(.6); }","+console.log('after arrival', game.sceneName, err());","+step('tutorial match', () => {}, 2);","+G.devPerfect = true; T().cpuControl(true);","+for (let k = 0; k < 400 && game.sceneName === 'match'; k++) game.advance(1);","+console.log('tutorial over', game.sceneName, err(), JSON.stringify(G.M && G.M.score));","+step('results continue', () => I.tap('confirm'), 1);","+for (let k = 0; k < 30 && game.sceneName === 'cutscene'; k++) { I.tap('confirm'); game.advance(.6); }","+console.log('after welcome', game.sceneName, G.state.day, G.state.slot, err());","+step('map', () => G.go('map'));","+step('map card', () => I.tap('confirm'));","+step('loc beach', () => G.go('location', { loc: 'beach' }));","+step('loc pool', () => G.go('location', { loc: 'pool' }));","+step('loc promenade', () => G.go('location', { loc: 'promenade' }));","+step('loc villa', () => G.go('location', { loc: 'villa' }));","+step('loc casino', () => G.go('location', { loc: 'casino' }));","+step('shop', () => G.go('shop', { shop: 'riptide' }));","+step('shop buy', () => I.tap('confirm'));","+step('wardrobe', () => G.go('wardrobe'));","+step('journal', () => G.go('journal'));","+step('journal friends', () => I.tap('tabR'));","+step('album', () => G.go('album', { all: true }));","+step('poolhop', () => { G.poolBot = true; G.go('poolhop'); }, 25);","+