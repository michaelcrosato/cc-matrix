outPanel().forEach((it, k) => G.UI.button(g, it, k === this.focus.i));","+      } else if (P && P.kind === 'bag') {","+        const tabs = ['Gifts', 'Swimsuits', 'Accessories'], L = this.layoutPanel(); G.UI.panel(g, Math.round(W / 2) - 140, Math.round(H * .1), 280, Math.round(H * .74));","+        G.UI.heading(g, P.n ? 'GIVE ' + G.CAST[P.n.id].short.toUpperCase() + ' A GIFT' : 'GIFT BAG', Math.round(W / 2) - 128, Math.round(H * .12));","+        tabs.forEach((t, k) => { const x = Math.round(W / 2) - 128 + k * 86; E.ui.box(g, x, Math.round(H * .12) + 18, 82, 12, { bg: k === P.tab ? ['#ff9e5e', '#c86a3a'] : G.UI.T.bg, border: G.UI.T.border, gradient: false }); E.font.text(g, t, x + 41, Math.round(H * .12) + 21, '#fff', { align: 'center', outline: false }); });","+        L.forEach((it, k) => { const foc = k === this.focus.i, im = it.it; E.ui.box(g, it.x, it.y, it.w, it.h, { bg: foc ? ['#1f7a8c', '#12475a'] : G.UI.T.bg, border: foc ? '#ffd36a' : G.UI.T.border }); if (foc) G.UI.focus(g, it.x, it.y, it.w, it.h); G.UI.itemIcon(g, it.x + 4, it.y + 6, im, 2); E.font.text(g, im.name, it.x + 40, it.y + 6, '#fff8e8', { outline: false, wrap: it.w - 42 });","+          if (im.kind === 'gift') E.font.text(g, '×' + S.bag[im.id], it.x + it.w - 6, it.y + it.h - 11, '#ffd36a', { align: 'right', outline: false });","+          const known = P.n && S.known[P.n.id] && S.known[P.n.id][im.id]; if (known) E.font.text(g, { love: '♥♥', like: '♥', neutral: '·', dislike: '×' }[known] || '', it.x + 40, it.y + it.h - 11, known === 'dislike' ? '#ff7a7a' : '#ff8ac8', { outline: false }); });","+        if (!L.length) E.font.text(g, 'Nothing here. Shops on the Promenade sell gifts.', W / 2, H / 2, '#fff8e8', { align: 'center', outline: false });","+      }","+      if (this.demo) return;","+    });","+    G.talkBox().draw(r);","+    if (G.talkBox().open) return;","+    if (P) G.promptBar(r, P.kind === 'bag' ? [['confirm', P.n ? 'Give' : 'Look'], ['tabL', 'Tab'], ['tabR', 'Tab'], ['cancel', 'Back']