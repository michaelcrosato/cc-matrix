(let i = 0; i < 60; i++) { body.vx = 78; body.update(1 / 120, w); }","   check('a 1-high block stops a walker (collide)', body.x < 6 * T && body.x > 5 * T + 8, body.x);","-  body.vx = 0; body.jump(215); let maxZ = 0; for (let i = 0; i < 120; i++) { body.vx = 60; body.update(1 / 120, w); maxZ = Math.max(maxZ, body.z); }","+  body.vx = 0; body.onGround = true; body.jump(215); let maxZ = 0; for (let i = 0; i < 120; i++) { body.vx = body.x < 6 * T + 8 ? 60 : 0; body.update(1 / 120, w); maxZ = Math.max(maxZ, body.z); }","   check('a jump clears 1 block and lands on it', body.z === 80 && maxZ > 80, [body.z, maxZ]);","   w.fill(8, 8, 4, 8, 8, 5, B('cobble')); const b2 = new DQ.VoxelBody({ x: 7 * T + 8, y: 8 * T + 8, z: 64 }); b2.jump(215); let top2 = 0; for (let i = 0; i < 120; i++) { b2.vx = 60; b2.update(1 / 120, w); top2 = Math.max(top2, b2.z); }","   check('a 2-high wall cannot be jumped', b2.x < 8 * T && b2.z === 64, [b2.x, b2.z]);"]},{"oldStart":28,"oldLines":10,"newStart":28,"newLines":10,"lines":["   check('ceilingAt finds the roof', w.ceilingAt(13 * T + 8, 13 * T + 8, 5, 64) === 96);","   // stairs: a ramp","   w.set(3, 3, 4, B('stairsPlank'), { rot: 0 });","-  const gs = w.groundAt(3 * T + 12, 3 * T + 8, 2, 70, 2);","+  w.set(4, 3, 4, B('planks')); const gs = w.groundAt(3 * T + 12, 3 * T + 8, 2, 76, 2);","   check('stairs are a ramp', gs > 64 && gs < 80, gs);","-  const b4 = new DQ.VoxelBody({ x: 2 * T + 8, y: 3 * T + 8, z: 64 }); for (let i = 0; i < 80; i++) { b4.vx = 78; b4.update(1 / 120, w); }","-  check('walking up stairs needs no jump', b4.z >= 79 && b4.x > 4 * T, [b4.x, b4.z]);","+  const b4 = new DQ.VoxelBody({ x: 2 * T + 8, y: 3 * T + 8, z: 64 }); for (let i = 0; i < 80; i++) { b4.vx = b4.x < 4 * T + 8 ? 78 : 0; b4.update(1 / 120, w); }","+  check('walking up stairs needs no jump', b4.z === 80 && b4.x > 4 * T, [b4.x, b4.z]);","   // water: shallow wades, deep blocks","   w.set(16, 16, 3, DQ.WATER); w.set(17, 16, 3, DQ.WATER); w.set(17, 16, 2, DQ.WATER);","   check('deep water blocks a walker', w.blocksBody(17, 16, { z: 64, step: 2, h: 28 }, 17 * T + 8, 16 * T + 8));"]},{"oldStart":41,"oldLines":10,"newStart":41,"newLines":10,"lines":["   check('raycast down hits the surface block', hit && hit.z === 3 && hit.nz === 1, JSON.stringify(hit));","   for (const yaw of [0, 90, 180, 270]) {","     const v = new E.View('iso', 'Isometric', 45 + yaw, 30, Math.SQRT2, E.VIEWS.iso.zBoost);","-    const cx = 9, cy = 14, cz = 3, P = v.p(cx * T + 8, cy * T + 8, cz * T + 16), pk = w.pickScreen(v, P[0], P[1]);","+    const cx = 20, cy = 6, cz = 3, P = v.p(cx * T + 8, cy * T + 8, cz * T + 16), pk = w.pickScreen(v, P[0], P[1]);","     check('pickScreen finds a top face in iso turn ' + yaw, pk && pk.x === cx && pk.y === cy && pk.z === cz && pk.n[2] === 1, JSON.stringify(pk));","   }","-  { const v = E.VIEWS.threequarter, P = v.p(9 * T + 8, 14 * T + 8, 3 * T + 16), pk = w.pickScreen(v, P[0], P[1]); check('pickScreen in three-quarter', pk && pk.x === 9 && pk.y === 14 && pk.z === 3, JSON.stringify(pk)); }","+  { const v = E.VIEWS.threequarter, P = v.p(20 * T + 8, 6 * T + 8, 3 * T + 16), pk = w.pickScreen(v, P[0], P[1]); check('pickScreen in three-quarter', pk && pk.x === 20 && pk.y === 6 && pk.z === 3, JSON.stringify(pk)); }","   w.snapshotBase(); w.set(2, 2, 4, B('feltRed')); w.set(2, 2, 3, 0);","   const diff = w.diff(), w2 = new DQ.VoxelWorld(24, 24, 12); for (let y = 0; y < 24; y++) for (let x = 0; x < 24; x++) DQ.WG.column(w2, x, y, 4, 'grass'); DQ.WG.recalc(w2);","   w2.vox.set(w.base); w2.rotm.set(w.baseRot); DQ.WG.recalc(w2); w2.applyDiff(diff);"]},{"oldStart":52,"oldLines":14,"newStart":52,"newLines":14,"lines":["   // determinism of the story world","   const A1 = new DQ.VoxelWorld(144, 144, 24), A2 = new DQ.VoxelWorld(144, 144, 24), g1 = DQ.generateWorld(A1), g2 = DQ.generateWorld(A2);","   check('world generation is deterministic', A1.hash() === A2.hash() && g1.objects.length === g2.objects.length, [A1.hash(), A2.hash()]);","-  check('every POI has a standing level', Object.values(g1.poi).every(p => p.L > 0), JSON.stringify(Object.entries(g1.poi).filter(([k, p]) => !(p.L > 0))));","+  check('every POI has a standing level', Object.entries(g1.poi).every(([k, p]) => k === 'riftCenter' || p.L > 0), JSON.stringify(Object.entries(g1.poi).filter(([k, p]) => k !== 'riftCenter' && !(p.L > 0))));","   check('three Ancient Buttons exist', g1.objects.filter(o => o.id === 'ancientButton').length === 3);","   check('six portals exist', g1.objects.filter(o => o.id === 'portal').length === 6);","   // ---------------- rooms","   const ctx = DQ.Play.make(game, { mode: 'story' }); DQ.ctx = ctx;","   const t = ctx.town, p = ctx.poi.bannerSpot; t.plant(p.x, p.y, p.L, { instant: true });","   const room = (x0, y0, wd, dp, o = {}) => {","-    const W = ctx.world, Lz = W.topZ(x0, y0);","+    const W = ctx.world, Lz = o.L || p.L;","     for (let y = y0 - 1; y <= y0 + dp; y++) for (let x = x0 - 1; x <= x0 + wd; x++) for (let z = Lz; z < Lz + 4; z++) { W.set(x, y, z, 0, { silent: true }); const ob = ctx.objects.at(x, y, z); if (ob) ctx.objects.remove(ob, { silent: true }); }","     for (let y = y0 - 1; y <= y0 + dp; y++) for (let x = x0 - 1; x <= x0 + wd; x++) W.set(x, y, Lz - 1, B('planks'), { silent: true });","     for (let y = y0; y < y0 + dp; y++) for (let x = x0; x < x0 + wd; x++) { const edge = x === x0 || y === y0 || x === x0 + wd - 1 || y === y0 + dp - 1; if (!edge) continue; const door = o.door !== false && x === (o.doorX !== undefined ? o.doorX : x0 + (wd >> 1)) && y === y0 + dp - 1; if (door) continue; for (let z = Lz; z < Lz + (o.h || 2); z++) W.set(x, y, z, B(o.wall || 'cobble'), { silent: true }); }"]},{"oldStart":85,"oldLines":7,"newStart":85,"newLines":7,"lines":["   const rr = room(X, Y, 5, 5, { objs: [[2, 2, 'strawBed']] }), Lz = ctx.world.topZ(X - 1, Y - 1);","   ctx.objects.remove(ctx.objects.at(X + 2, Y + 2, rr.L)); ctx.rooms.timer = 0; ctx.rooms.detect();","   check('removing the bed turns a bedroom into a snug', (ctx.rooms.roomAt(X + 1, Y + 1, rr.L) || {}).type === 'snug');","-  const far = room(10, 120, 5, 5, { objs: [[2, 2, 'strawBed']] });","+  const far = room(10, 120, 5, 5, { objs: [[2, 2, 'strawBed']], L: ctx.world.topZ(10, 120) });","   check('a room outside the border is detected but not in town', far && !far.inTown);","   check('awards are capped by maxAwards', (ctx.rooms.awards.bedroom || 0) <= DQ.ROOM.bedroom.maxAwards);","   check('diagnose names a missing door', (() => { room(X, Y, 5, 5, { door: false }); return /door/i.test(ctx.rooms.diagnose(X + 2, Y + 2, rr.L) || ''); })());"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-215521__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-xhigh-20261103-215521/tests/lib/dbg.mjs","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-215521__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-xhigh-20261103-215521/tests/unit/core.test.mjs"]}},"tool_result_meta":[{"id":"toolu_01ALq83TxYg2RrnbKu35gXPc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
