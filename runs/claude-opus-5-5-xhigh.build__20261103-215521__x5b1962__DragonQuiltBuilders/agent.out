cat(errs).join('; ') : ''));","+console.log((r.frames > 0 ? 'PASS' : 'FAIL') + ' the frame with overlays drew its queue (' + r.frames + ' items)');","+await page.screenshot({ path: path.join(root, 'check-output', 'overlays.png') });","+await browser.close();"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-215911__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-medium-20261103-215911/tests/suites/02-builder.test.mjs","hunks":[{"oldStart":50,"oldLines":5,"newStart":50,"newLines":13,"lines":["   // eating","   b.belly = 40; b.bag.add('bun', 1); b.hotbar[1] = 'bun'; b.sel = 1; run(.1); press('place', .3);","   check('eating a bun fills the belly', b.belly >= 74, b.belly);","+  // gear: craft the Quilted Vest and Copper Buckler, equip them, take less damage","+  ctx.crafting.know('quiltedVest', true); ctx.crafting.know('copperBuckler', true); b.bag.add('cotton', 4); b.bag.add('thread', 2); b.bag.add('copperIngot', 2); b.bag.add('planks', 2);","+  check('the Quilted Vest and Copper Buckler craft', ctx.crafting.craft('quiltedVest', 1, b.bag) === 1 && ctx.crafting.craft('copperBuckler', 1, b.bag) === 1);","+  const raw = [0, 1, 2, 3, 4, 5, 6, 7].map(() => ctx.combat.formula(12, b.def)).reduce((a, c) => a + c, 0);","+  b.bag.add('bun', 0); b.hotbar[2] = 'quiltedVest'; b.sel = 2; run(.05); press('place', .2); b.hotbar[3] = 'copperBuckler'; b.sel = 3; run(.05); press('place', .2);","+  check('using them from the hotbar equips them (Def +7)', b.equip.body === 'quiltedVest' && b.equip.shield === 'copperBuckler' && b.def === 7, JSON.stringify(b.equip));","+  const armoured = [0, 1, 2, 3, 4, 5, 6, 7].map(() => ctx.combat.formula(12, b.def)).reduce((a, c) => a + c, 0);","+  check('armour lowers the damage taken', armoured < raw, [raw, armoured]);","   check('no errors', !game.errors.length, errs());"," };"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-215911__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-medium-20261103-215911/tests/suites/13-dev.test.mjs","hunks":[{"oldStart":30,"oldLines":5,"newStart":30,"newLines":20,"lines":["   // fly and one-hit cheats change play","   DQ.dev.fly = true; const z0 = b.body.z; game.input.hold('jump'); run(.5); game.input.hold('jump', false); check('fly rises with jump', b.body.z > z0 + 30); DQ.dev.fly = false; run(1);","   DQ.dev.oneHit = true; const m = ctx.monsters.spawn('knotbrute', b.body.x + 10, b.body.y, b.body.z); ctx.combat.builderHits(b, m, 1); check('one-hit kills', m.dead); DQ.dev.oneHit = false;","+  // Debug tab: every overlay toggles from the screen; time scale and cutaway adjust","+  ctx.ui.open('dev', {}); run(.05); const dv = ctx.ui.top; dv.tab = 5; const dbg = dv.items(); const before = JSON.stringify(['showCollide','showRooms'].map(k => DQ.dev[k])) + ' ui ' + (ctx.ui.top && ctx.ui.top.name);","+  const keys = ['showCollide', 'showRooms', 'showNav', 'showAggro', 'showLights', 'showPattern', 'perf'];","+  for (let i = 0; i < keys.length; i++) { dv.focus = i; game.input.tap('confirm'); run(.03); }","+  check('the Debug tab toggles all 7 overlays on', keys.every(k => DQ.dev[k] === true), JSON.stringify(keys.map(k => DQ.dev[k])) + ' before ' + before);","+  dbg.find(i => i.label === 'Time scale').adjust(1); check('the Debug tab sets the time scale', game.timeScale === 2, game.timeScale); dbg.find(i => i.label === 'Time scale').adjust(-1);","+  dbg.find(i => i.label === 'Cutaway').adjust(1); check('the Debug tab switches the cutaway mode', DQ.dev.cutaway === 'always'); dbg.find(i => i.label === 'Cutaway').adjust(-1);","+  for (let i = 0; i < keys.length; i++) { dv.focus = i; game.input.tap('confirm'); run(.03); }","+  // World tab: a dev snapshot saves, and loading it restores the world","+  dv.tab = 6; const wi = dv.items(); ctx.world.set(70, 90, 11, DQ.blockId('gildedFelt')); wi.find(i => /Save a dev snapshot/.test(i.label)).act(dv);","+  check('the World tab saves a dev snapshot', !!G.store.get('dqb-devsnap') || !!DQ.E.store.get('dqb-devsnap', null));","+  wi.find(i => /Load the dev snapshot/.test(i.label)).act(dv); run(.8); const c2 = game.debug.ctx;","+  check('loading the dev snapshot restores the world', c2 !== ctx && c2.world.get(70, 90, 11) === DQ.blockId('gildedFelt'));","+  game.debug.ctx.ui.open('dev', {}); run(.05); const dv2 = game.debug.ctx.ui.top; dv2.tab = 6; dv2.items().find(i => /Regenerate/.test(i.label)).act(dv2); run(.8);","+  check('Regenerate the world starts a fresh world', game.debug.ctx !== c2 && game.debug.ctx.world.get(70, 90, 11) !== DQ.blockId('gildedFelt'));","   check('no errors', !game.errors.length, errs());"," };"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145.html","hunks":[{"oldStart":18650,"oldLines":7,"newStart":18650,"newLines":7,"lines":["     if (night) G.game.lights.add(this.cam[0], this.cam[1], 30, 140, .6, { color: '#ffd8a0' });","     G.talkBox().draw(r);","     r.overlay(g => {","-      if (this.d.caption) { E.font.title(g, this.d.caption, r.W / 2, Math.round(r.H * .08), { scale: 2, colors: ['#fff7d6', '#ffd36a', '#ff9e5e'], align: 'center', depth: 2 }); }","+      if (this.d.caption && this.t < 6) { E.font.title(g, this.d.caption, r.W / 2, Math.round(r.H * .12), { scale: 2, colors: ['#fff7d6', '#ffd36a', '#ff9e5e'], align: 'center', depth: 2 }); }","       if (this.skipAsk) { G.UI.panel(g, r.W / 2 - 90, r.H * .4, 180, 40); E.font.text(g, 'Skip scene?', r.W / 2, r.H * .4 + 8, '#ffd36a', { align: 'center', outline: false }); E.font.text(g, G.btn('confirm') + ' Yes   ' + G.btn('cancel') + ' No', r.W / 2, r.H * .4 + 24, '#fff8e8', { align: 'center', outline: false }); }","     });","     if (!this.skipAsk) G.promptBar(r, [['confirm', 'Next'], ['pause', 'Skip']], G.game.input, 6);"]},{"oldStart":18717,"oldLin