y); return v === null ? fallback : JSON.parse(v); } catch (e) { return fallback; } },   // the value saved under key (any JSON), or fallback\n  set(key, value) { try { localStorage.setItem('my3d2dge:' + key, JSON.stringify(value)); return true; } catch (e) { return false; } },   // save value (any JSON) under key; false when storage is blocked\n  remove(key) { try { localStorage.removeItem('my3d2dge:' + key); } catch (e) { /* storage blocked */ } }   // forget key\n};\nObject.assign(E, { clamp, lerp, approach, ease, wrap, wrapDiff, angDiff, lerpAng, approachAng, rng, hash2, noise2, bayer, smoothDamp, hex, toHex, shade, mix, mkCanvas, ctx2d, V3, ik3,\n  rand, randInt, pick, chance, dist, angleTo, arc, overlap, overlapBox, inArc, sameLevel, targets, HEIGHTS, prune, store });\n\n/* the ways in for the core's sections a kit may leave out (the kit diet: sprite turns, tweens, scripts, transitions,\n   weather, input sequences, the camera's window): each puts its functions here as it loads, so a kit without it has\n   nothing to call. input(game, dt) after the input's step, step(game, dt) after the timers (game time: paused, frozen\n   and slowed with the game), enter(game, old) as a scene starts (before its enter), draw(game, r, g) over the lit\n   world, under the overlays; rot(spr, a, steps): a sprite turned (section 2b); frame(game, shx, shy): a split screen's\n   viewports drawn (section 10j); pose(dt, s): the traversal moves' poses, on the rig (this; section 16c); pause(shell, acts):\n   the pause menu's Save and Load (section 10k); FADES: the transitions by name (game.go's fade) */\nconst HOOKS = { input: [], step: [], enter: [], draw: [], rot: null, frame: null, pose: null, pause: null }, FADES = {};\n\n/* =============================================================================\n * 1b. MORE EASINGS  the rest of Penner's set, beside the core's (E.ease): in a section of its own, so a kit whose game eases\n *    with none of them leaves it out\n * ===============