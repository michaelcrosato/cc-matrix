.slot = 1; S.money = 12345; game.saves.save(0); G.state = null; game.saves.load(0); t('save and load mid-slot', G.state && G.state.money === 12345 && G.state.slot === 1 && G.state.day === 2);\",\"+  // the vacation match flow pays and moves on\",\"+  const S2 = G.state; S2.partner = 'mei'; const cfg = G.vacationMatchCfg(['lola', 'tess']); t('a vacation match config', cfg.teams[0][1].id === 'mei' && cfg.partnerAff === G.aff('mei'));\",\"+  t('no errors', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\",\"+};\"]}],\"created\":true},{\"filePath\":\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/07-casino.test.mjs\",\"hunks\":[{\"oldStart\":0,\"oldLines\":0,\"newStart\":1,\"newLines\":15,\"lines\":[\"+import { load } from '../lib/load.mjs';\",\"+export default async t => {\",\"+  const { G } = load();\",\"+  let paid = 0, n = 0; for (let a = 0; a < 21; a++) for (let b = 0; b < 21; b++) for (let c = 0; c < 21; c++) { paid += G.slotWin([a, b, c], 1).win; n++; }\",\"+  const rtp = paid / n; t('slots return 89-95% (exact over every stop)', rtp >= .89 && rtp <= .95, rtp);\",\"+  t('7-7-7 pays 100', G.slotLine('7', '7', '7') === 100); t('Sonny is wild', G.slotLine('BAR', 'SONNY', 'BAR') === 30); t('one cherry pays 2', G.slotLine('CHERRY', 'COCO', 'PALM') === 2);\",\"+  t('roulette straight pays 35:1', G.roulettePay({ kind: 'num', v: 17 }, 17) === 36); t('red pays 1:1', G.roulettePay({ kind: 'red' }, 1) === 2 && G.roulettePay({ kind: 'red' }, 2) === 0);\",\"+  t('dozens pay 2:1', G.roulettePay({ kind: 'dozen', v: 2 }, 20) === 3); t('columns', G.roulettePay({ kind: 'col', v: 1 }, 34) === 3); t('zero loses outside bets', G.roulettePay({ kind: 'even' }, 0) === 0);\",\"+  t('wheel order', G.WHEEL.length === 37 && G.WHEEL[1] === 32 && new Set(G.WHEEL).size === 37);\",\"+  G.seed('casino', 1); const counts = new Array(37).fill(0); for (let i = 0; i < 37000; i++) counts[G.WHEEL[Math.floor(G.rng('casino') * 37)]]++; const chi = counts.reduce((a, c) => a + (c - 1000) ** 2 / 1000, 0); t('wheel results uniform (chi-square)', chi < 80, chi);\",\"+  const BJ = G.BJ, h = (...r) => r.map(x => ({ r: x, s: '♠' }));\",\"+  t('blackjack values', BJ.value(h('A', 'K')).v === 21 && BJ.bj(h('A', 'K')) && BJ.value(h('A', 'A', '9')).v === 21 && BJ.value(h('K', 'Q', '5')).v === 25);\",\"+  t('soft 17 is soft', BJ.value(h('A', '6')).soft && BJ.value(h('A', '6')).v === 17);\",\"+  BJ.newShoe(); t('six-deck shoe', BJ.shoe.length === 312);\",\"+};\"]}],\"created\":true}],\"moreFiles\":0,\"changedFiles\":[\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/lib/bots.mjs\",\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/05-match.test.mjs\",\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/06-vacation.test.mjs\",\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/07-casino.test.mjs\"]}},\"tool_result_meta\":[{\"id\":\"toolu_01RUKYB1mH16T8cmDzNh9a4t\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}]}"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/lib/bots.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":16,"lines":["+// a human bot: presses play at each planned contact (and serves on time) through the real input","+export function humanBot(game, G, skill = 1) {","+  return () => {","+    const M = G.M; if (!M) return; const I = game.input, me = M.players.find(p => p.input === I && p.isHuman); if (!me) return;","+    const t = M.clock;","+    if (M.phase === 'serveSetup' && M.server === me && M.phT > .5) I.tap('play');","+    if (M.phase === 'toss' && M.server === me && t >= M.tossApex - 1 / 240) I.tap('play');","+    if (M.phase === 'rally' && me.plan && !me.pressed && t >= me.plan.t - (skill < 1 ? .2 : 1 / 240)) I.tap('play');","+  };","+}","+export function runMatch(game, G, cfg, o = {}) {","+  let res = null; cfg.after = r => { res = r; }; G.startMatch(cfg, { fade: 0 }); game.advance(.05);","+  const bot = o.bot ? humanBot(game, G, o.skill) : null, maxPhase = { t: 0, ph: null, worst: 0 };","+  for (let s = 0; s < (o.max || 900) * 120 && !res; s++) { if (bot) bot(); game.advance(1 / 120); const M = G.M; if (M.phase !== maxPhase.ph) { maxPhase.ph = M.phase; maxPhase.t = 0; } else { maxPhase.t += 1 / 120; maxPhase.worst = Math.max(maxPhase.worst, maxPhase.ph === 'end' ? 0 : maxPhase.t); } const b = M.ballPos; if (b && (b.some(v => !isFinite(v)))) { o.nan = true; } }","+  return { res, stuck: maxPhase.worst, M: G.M };","+}"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/05-match.test.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":26,"lines":["+import { load } from '../lib/load.mjs';","+import { runMatch } from '../lib/bots.mjs';","+const teams = () => [[{ id: 'rin', suit: 'seigaiha', acc: [] }, { id: 'lola', suit: 'estrella', acc: [] }], [{ id: 'tess', suit: 'reefbreak', acc: [] }, { id: 'mei', suit: 'peony', acc: [] }]];","+export default async t => {","+  const { G, game } = load(); game.advance(.5);","+  let totalR = 0, totalT = 0, fin = 0, scores = [];","+  for (let seed = 1; seed <= 6; seed++) {","+    G.seed('match', seed); const o = {}; const { res, stuck } = runMatch(game, G, { mode: 'exhibition', cpuAll: true, pointsToWin: 7, replays: seed % 2 === 0, teams: teams() }, o);","+    if (res) { fin++; totalR += res.rallies; scores.push(res.finalScore.join('-')); }","+    t('AI vs AI seed ' + seed + ' finishes', !!res); t('seed ' + seed + ' no phase stuck over 15 s', stuck < 15, stuck); t('seed ' + seed + ' ball never NaN', !o.nan);","+    if (res) { const pts = res.players.filter(p => p.side === res.winner).reduce((a, p) => a + p.stats.points, 0); t('seed ' + seed + ' earned points add up within the score', pts <= Math.max(...res.finalScore)); }","+  }","+  G.seed('match', 3); const a = runMatch(game, G, { mode: 'exhibition', cpuAll: true, pointsToWin: 5, replays: false, teams: teams() }).res;","+  G.seed('match', 3); const b = runMatch(game, G, { mode: 'exhibition', cpuAll: true, pointsToWin: 5, replays: false, teams: teams() }).res;","+  t('same seed, same score', a && b && a.finalScore.join() === b.finalScore.join() && a.rallies === b.rallies, a && b && a.finalScore + ' vs ' + b.finalScore);","+  // an idle human loses; a perfect bot beats Easy CPUs","+  G.game.settings.set('difficulty', 'Easy');","+  const idle = runMatch(game, G, { mode: 'exhibition', pointsToWin: 7, difficulty: 'Easy', teams: [[{ id: 'rin', suit: 'seigaiha', acc: [], input: game.input }, { id: 'lola', suit: 'estrella', acc: [], base: .3 }], [{ id: 'tess', suit: 'reefbreak', acc: [], base: .5 }, { id: 'mei', suit: 'peony', acc: [], base: .5 }]] }).res;","+  t('an idle human loses', idle && idle.winner === 1, idle && idle.finalScore);","+  let wins = 0; for (let s = 0; s < 3; s++) { G.seed('match', 40 + s); const r = runMatch(game, G, { mode: 'exhibition', pointsToWin: 7, difficulty: 'Easy', teams: [[{ id: 'rin', suit: 'seigaiha', acc: [], input: game.input }, { id: 'lola', suit: 'estrella', acc: [], base: .5 }], [{ id: 'tess', suit: 'reefbreak', acc: [], base: .4 }, { id: 'mei', suit: 'peony', acc: [], base: .4 }]] }, { bot: true }).res; if (r && r.winner === 0) wins++; }","+  t('a perfect bot beats Easy (2 of 3 or better)', wins >= 2, wins);","+  // the final's Golden Glare hides the ring for a receiver without sunglasses","+  const M = new G.Match({ mode: 'final', specials: { glare: true }, teams: [[{ id: 'rin', suit: 'seigaiha', acc: [], input: game.input }, { id: 'lola', suit: 'estrella', acc: [] }], [{ id: 'sonny', suit: 'house_sonny', acc: ['aviators'] }, { id: 'pepper', suit: 'pinstripe', acc: [] }]] });","+  t('glare flags shades', !M.players[0].rig.acc.some(a => G.ITEMS[a].shades) && M.players[2].rig.acc.some(a => G.ITEMS[a].shades));","+  t('no errors in matches', game.errors.length === 0, game.errors.map(e => e.message + ' ' + (e.stack || '').split('\\n')[1]).join(' | '));","+};"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/06-vacation.test.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":29,"lines":["+import { load } from '../lib/load.mjs';","+export default async t => {","+  const { G, game } = load(); game.advance(.5); const T = game.debug.tools;","+  const S = T.newVacation('rin', 11);","+  t('day 1 morning', S.day === 1 && S.slot === 0); t('five NPCs with affinity', Object.keys(S.affinity).length === 5);","+  t('weather table day 3 rain afternoon', G.WEATHER_TABLE[3][1] === 'rain');","+  t('a pair at the beach by day', S.teams.some(tm => S.where[tm[0]] === 'beach' && S.where[tm[1]] === 'beach'));","+  const same = JSON.stringify(S.where); G.scheduleSlot(); t('same seed, same places', JSON.stringify(S.where) 