 true && (I.down('back') || I.down('interact') || (I.held && I.held.has('Mouse2')))) { run.skip += dt; if (run.skip >= 1) { run.script && run.script.cancel(); ctx.talk.closeAll(); if (ctx.npcs) for (const n of ctx.npcs.list) n.scripted = false; end(ctx, run.name, run.data); run.done = true; } } else run.skip = Math.max(0, run.skip - dt * 2);","     if (run.done || (run.script && run.script.done)) { ctx.cutscene = null; ctx.modal = null; ctx.camFocus = null; ctx.events.emit('cutsceneDone', { name: run.name }); if (ctx.csQueue && ctx.csQueue.length) { const [n, d] = ctx.csQueue.shift(); DQ.Cutscenes.play(ctx, n, d); } }","   }"," };"," const cs = run => C[run.name] || {};","+/** a cutscene's end state, for a skip or a quiet apply */","+const end = (ctx, name, d) => { const c = C[name]; if (c && c.apply) c.apply(ctx, d); };"," /** wait for the dialog to close */"," const talkDone = ctx => E.until(() => !ctx.talk.open);"," const say = (ctx, who, lines, o) => { ctx.say(who, lines, o); return talkDone(ctx); };"]},{"oldStart":325,"oldLines":7,"newStart":327,"newLines":6,"lines":[" };"," C.reveal = {","   *run(ctx) { const t = ctx.poi.bannerSpot; yield pan(ctx, 60 * T, 60 * T, 12 * T, 1.6); yield .4; yield pan(ctx, t.x * T, t.y * T, 9 * T, 1.6); yield say(ctx, 'granny', DQ.LINES.reveal); yield pan(ctx, ctx.builder.x, ctx.builder.y, ctx.builder.z + 14, 1); },","-  apply(ctx) {}"," };"," C.plant = {","   *run(ctx, d) {"]},{"oldStart":348,"oldLines":24,"newStart":349,"newLines":25,"lines":["     yield pan(ctx, n.x, n.y, n.z + 14, .4);","     DQ.AudioX && DQ.AudioX.jingle('arrive');","     yield say(ctx, d.id, DQ.NPCS[d.id].intro);","-    ctx.hud.popup('arrive', DQ.NPCS[d.id].arrive, 'Their favourite room: ' + (d.id === 'lintwick' ? 'a Bedroom with Felt' : DQ.ROOM[DQ.NPCS[d.id].fav].name) + '.');","-    yield pan(ctx, ctx.builder.x, ctx.builder.y, ctx.builder.z + 14, .8);","+    arrived(ctx, d); yield pan(ctx, ctx.builder.x, ctx.builder.y, ctx.builder.z + 14, .8);","   },","-  