ame.time - t0 < s) { this._cheat(); yield; } }","   *until(fn, timeout = 30) { const t0 = this.ctx.game.time; while (!fn()) { if (this.ctx.game.time - t0 > timeout) return this.fail('until', 'timeout'); this._cheat(); yield; } return true; }","   *walkTo(x, y, z, o = {}) {","+    this.dismount();","     const w = this.ctx.world, r = o.radius === undefined ? 1 : o.radius, b = this.b.body, t0 = this.ctx.game.time;","     const goalL = z === undefined || z === null ? w.topZ(x, y) : z;","     const dist = () => Math.hypot(b.x / T - (x + .5), b.y / T - (y + .5));"]},{"oldStart":60,"oldLines":6,"newStart":62,"newLines":7,"lines":["     return this.fail('approach', 'no spot in reach of ' + x + ',' + y + ',' + z);","   }","   *breakAt(x, y, z) {","+    this.dismount();","     const w = this.ctx.world, breakable = o => o && (!o.def.fixed || o.id === 'cage'); if (!w.get(x, y, z) && !breakable(w.objAt(x, y, z))) return true;","     yield* this.approach(x, y, z);","     const t0 = this.ctx.game.time;"]},{"oldStart":74,"oldLines":6,"newStart":77,"newLines":7,"lines":["   }","   select(item) { const b = this.b; let k = b.hotbar.indexOf(item); if (k < 0) { k = b.hotbar.indexOf(null); if (k < 0) k = 7; b.hotbar[k] = item; } this.it.hot = { slot: k }; }","   *placeAt(x, y, z, item, o = {}) {","+    this.dismount();","     const w = this.ctx.world, b = this.b, it = DQ.ITEMS[item];","     const done = () => it.kind === 'block' ? w.get(x, y, z) === DQ.blockId(it.block) : !!w.objAt(x, y, z);","     if (done()) return true;"]},{"oldStart":83,"oldLines":7,"newStart":87,"newLines":7,"lines":["     yield* this.approach(x, y, z);","     const t0 = this.ctx.game.time;","     while (!done()) {","-      if (this.ctx.game.time - t0 > 6) return this.fail('placeAt', 'timeout ' + item + ' at ' + x + ',' + y + ',' + z + ' (have ' + b.bag.count(item) + ', hint ' + (this.ctx.hud ? this.ctx.hud.hintS : '') + ', plc ' + JSON.stringify(b.target.plc) + ' in ' + b.target.inPlc + ')');","+      if (this.ctx