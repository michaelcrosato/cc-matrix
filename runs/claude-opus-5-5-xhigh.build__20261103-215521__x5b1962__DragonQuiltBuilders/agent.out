by: b }); this.event(['unobj', x, y, z]); } }\", \"if (o && o.def.removable) ctx.objects.remove(o, { by: b }); }\")\nsub(p, \"if (o && o.def.plant) ctx.objects.harvest(o, b); this.event(['unobj', x, y, z]); }\", \"if (o && o.def.plant) { ctx.objects.harvest(o, b); this.event(['unobj', x, y, z]); } }\")\nEOF\ntimeout 590 node tests/run.mjs --only net > /tmp/dq_net.txt 2>&1; grep -v \"^    at \" /tmp/dq_net.txt | head -30 | cut -c1-700","description":"Broadcast host edits; remember leavers; rerun net","timeout":600000}},"wire_ingest_context":{"toolu_01W6XQchpNCSzJzmmVvcNKyP":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-215521__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-xhigh-20261103-215521"}}}
