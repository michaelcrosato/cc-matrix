["     this.select(item);","     if (it.kind === 'obj' && o.facing !== undefined) { const f = DQ.OBJECTS[it.obj].door ? o.facing : (o.facing + 2) % 4; b.facing = f * Math.PI / 2; b.targetFacing = null; }","     let t = 0;","-    while (!ok() && t < (o.timeout || 3)) { this.want.cursor = { x, y, z, place: { x, y, z } }; if (b.placeCd <= 0) this.want.place = true; yield; t += DQ.game.o.step; if (it.kind === 'obj' && o.facing !== undefined) { b.facing = (DQ.OBJECTS[it.obj].door ? o.facing : (o.facing + 2) % 4) * Math.PI / 2; b.targetFacing = null; } }","+    while (!ok() && t < (o.timeout || 6)) { this.want.cursor = { x, y, z, place: { x, y, z } }; if (b.placeCd <= 0) this.want.place = true; yield; t += DQ.game.o.step; if (it.kind === 'obj' && o.facing !== undefined) { b.facing = (DQ.OBJECTS[it.obj].door ? o.facing : (o.facing + 2) % 4) * Math.PI / 2; b.targetFacing = null; } }","     this.want.cursor = null;","-    if (!ok()) this.fail('placeAt', 'not placed ' + item + ' at ' + x + ',' + y + ',' + z); return ok();","+    if (!ok()) { const why = it.kind === 'block' ? b.canPlaceBlock(x, y, z) : this.ctx.objects.canPlace(it.obj, x, y, z, o.facing || 0, b), who = b.bodiesIn(x, y, z); this.fail('placeAt', 'not placed ' + item + ' at ' + x + ',' + y + ',' + z + ' (' + why + (who ? ' ' + (who.id || who.kind) : '') + ', from ' + [b.cx, b.cy, b.L] + (b.cursor.plcFar ? ' far' : '') + ' held ' + b.held + ' modal ' + this.ctx.modal + ' anim ' + (b.anim && b.anim.kind) + ' plc ' + b.cursor.plc + ' cd ' + b.placeCd.toFixed(2) + ' placing ' + !!(this.ctx.town.placing) + ')'); } return ok();","   }","   /** build a list of cells [{ x, y, z, block | obj, facing }] bottom-up, near to far */","   *buildStamp(cells, o = {}) {"]},{"oldStart":21050,"oldLines":6,"newStart":21069,"newLines":14,"lines":["     ctx.quests.talkTo(n); yield* this.readDialog(choices);","     return true;","   }","+  /** read an open dialog page by page (autoTalk: seconds a page shows, true for at once) */","+  readTalk() {","+    const tk = this.ctx.talk; if (!tk.open || !tk.modal) { this._talkT = 0; return; }","+    this._talkT += DQ.game.o.step; const wait = this.autoTalk === true ? 0 : this.autoTalk; const it = tk.cur, len = tk.pageText.replace(/\\n/g, '').length;","+    if (tk.shown < len) { if (wait === 0) tk.shown = len; return; }","+    if (this._talkT < wait) return; this._talkT = 0;","+    if (tk.page < it.pages.length - 1) { tk.page++; tk.shown = 0; } else { if (it.choices) tk.choice = 0; tk.close(); }","+  }","   *readDialog(choices = []) {","     const tk = this.ctx.talk; let k = 0, guard = 0;","     while (tk.open && guard++ < 400) {"]},{"oldStart":21107,"oldLines":7,"newStart":21134,"newLines":16,"lines":["     this.ctx = ctx; this.hub = hub; this.host = !!hub.isHost; this.client = !this.host; this.server = !!hub.server; this.me = hub.me;","     this.outA = []; this.outE = []; this.tP = 0; this.tS = 0; this.tA = 0; this.tE = 0; this.t = 0; this.stats = { sent: 0, recv: 0, bytes: 0, maxBytes: 0, perSec: [] };","     this.remote = new Map(); this.lastS = -1; this.half = 0; this.ended = false; this.round = o.round || null; this.offs = [];","-    ctx.net = this;","+    ctx.net = this; this.left = new Set();","+    // the host's word is law: every edit of its world goes out (its own builder's, helpers', monsters', Tangles)","+    if (this.host) {","+      const w = ctx.world, ev = ctx.events;","+      ev.on('blockPlaced', e => { if (e.by !== 'net') this.event(['vox', e.x, e.y, e.z, e.id, w.rot(e.x, e.y, e.z)]); });","+      ev.on('blockBroken', e => { if (e.by !== 'net') this.event(['vox', e.x, e.y, e.z, 0, 0]); });","+      ev.on('objectPlaced', e => { if (e.by !== 'net') this.event(['obj', e.id, e.x, e.y, e.z, e.obj.facing]); });","+      ev.on('objectRemoved', e => { if (e.by !== 'net') this.event(['unobj', e.x, e.y, e.z]); });","+      ev.on('objectBroken', e => { this.event(['unobj', e.x, e.y, e.z]); });","+    }","     this.offs.push(hub.on('message', (d, from) => { try { this.recv(d, from); } catch (e) { DQ.fail('net recv', e); } }));","   }","   send(data, o = {}) {"]},{"oldStart":21118,"oldLines":13,"newStart":21154,"newLines":13,"lines":["   event(ev) { if (this.host) this.outE.push(ev); }","   /** a remote player's builder (on the host and on other clients) */","   builderFor(id) {","-    let b = this.remote.get(id); if (b) return b; const p = (this.hub.players || []).find(q => q.id === id); if (!p) return null;","+    let b = this.remote.get(id); if (b) return b; if (this.left.has(id)) return null; const p = (this.hub.players || []).find(q => q.id === id); if (!p) return null;","     const ctx = this.ctx, sp = this.round ? this.round.spawnFor(id) : ctx.spawnPoint;","     b = new DQ.Builder(ctx, { id, name: p.name, color: p.color, x: sp[0], y: sp[1], z: sp[2], local: false }); b.remote = true; b.target = [sp[0], sp[1], sp[2], 0]; b.bag.infinite = false;","     b.netUpdate = dt => { const t = b.target; if (!t) return; const k = Math.min(1, dt * 10); const vx = (t[0] - b.x) * 10, vy = (t[1] - b.y) * 10; b.body.x += (t[0] - b.body.x) * k; b.body.y += (t[1] - b.body.y) * k; b.body.z += (t[2] - b.body.z) * k; b.facing = E.lerpAng ? E.lerpAng(b.facing, t[3], k) : t[3]; b.body.vx = vx; b.body.vy = vy; b.body.onGround = true; b.netHeld = t[5]; b.rigUpdate(dt); };","     this.remote.set(id, b); ctx.builders.push(b); return b;","   }","-  removePlayer(id) { const b = this.remote.get(id); if (!b) return; this.remote.delete(id); this.ctx.builders = this.ctx.builders.filter(x => x !== b); }","+  removePlayer(id) { this.left.add(id); const b = this.remote.get(id); if (!b) return; this.remote.delete(id); this.ctx.builders = this.ctx.builders.filter(x => x !== b); }","   update(dt) {","     this.t += dt; const ctx = this.ctx, b = ctx.builder; this.stats.perSec = this.stats.perSec.filter(t => this.t - t < 1);","     if (this.ended) return;"]},{"oldStart":21161,"oldLines":12,"newStart":21197,"newLines":12,"lines":["   /** host: a client's action */","   applyOp(op, from, b) {","     const ctx = this.ctx, w = ctx.world, [k] = op;","-    if (k === 'place') { const [, x, y, z, id, rot] = op; if (!w.inside(x, y, z) || DQ.SOLID[w.get(x, y, z)] || !DQ.BLOCKS[id] || !DQ.BLOCKS[id].placeable) { this.event(['vox', x, y, z, w.get(x, y, z), w.rot(x, y, z)]); return; } w.set(x, y, z, id, { by: b, rot }); this.event(['vox', x, y, z, id, rot || 0]); }","-    else if (k === 'break') { const [, x, y, z] = op, id = w.get(x, y, z); if (!id || DQ.BLOCKS[id].tier >= 99) { this.event(['vox', x, y, z, id, w.rot(x, y, z)]); return; } w.set(x, y, z, 0, { by: b }); this.event(['vox', x, y, z, 0, 0]); DQ.dropsFor(ctx, DQ.BLOCKS[id].drop, x * T + 8, y * T + 8, z * T + 8, b); }","-    else if (k === 'obj') { const [, id, x, y, z, f] = op; if (!ctx.objects.canPlace(id, x, y, z, f)) { ctx.objects.add(id, x, y, z, f, { by: b }); this.event(['obj', id, x, y, z, f]); } }","-    else if (k === 'unobj') { const [, x, y, z] = op, o = ctx.objects.at(x, y, z); if (o && o.def.removable) { ctx.objects.remove(o, { by: b }); this.event(['unobj', x, y, z]); } }","+    if (k === 'place') { const [, x, y, z, id, rot] = op; if (!w.inside(x, y, z) || DQ.SOLID[w.get(x, y, z)] || !DQ.BLOCKS[id] || !DQ.BLOCKS[id].placeable) { this.event(['vox', x, y, z, w.get(x, y, z), w.rot(x, y, z)]); return; } w.set(x, y, z, id, { by: b, rot }); }","+    else if (k === 'break') { const [, x, y, z] = op, id = w.get(x, y, z); if (!id || DQ.BLOCKS[id].tier >= 99) { this.event(['vox', x, y, z, id, w.rot(x, y, z)]); return; } w.set(x, y, z, 0, { by: b }); DQ.dropsFor(ctx, DQ.BLOCKS[id].drop, x * T + 8, y * T + 8, z * T + 8, b); }","+    else if (k === 'obj') { const [, id, x, y, z, f] = op; if (!ctx.objects.canPlace(id, x, y, z, f)) ctx.objects.add(id, x, y, z, f, { by: b }); }","+    else if (k === 'unobj') { const [, x, y, z] = op, o = ctx.objects.at(x, y, z); if (o && o.def.removable) ctx.objects.remove(o, { by: b }); }","     else if (k === 'hit') { const [, uid, dmg] = op, m = ctx.monsters.list.find(q => q.uid === uid && !q.dead); if (m && b && Math.hypot(m.x - b.x, m.y - b.y) < 60) ctx.combat.damageMonster(m, Math.min(60, Math.max(1, dmg | 0)), b, {}); }","-    else if (k === 'harvest') { const [, x, y, z] = op, o = ctx.objects.at(x, y, z); if (o && o.def.plant) ctx.objects.harvest(o, b); this.event(['unobj', x, y, z]); }","+    else if (k === 'harvest') { const [, x, y, z] = op, o = ctx.objects.at(x, y, z); if (o && o.def.plant) { ctx.objects.harvest(o, b); this.event(['unobj', x, y, z]); } }","     else if (k === 'craft') { if (this.round) this.round.crafted(from, op[1]); }","     else if (k === 'take') { if (this.round) this.round.crate(b, null, true); }","   }"]},{"oldStart":21250,"oldLines":7,"newStart":21286,"newLines":7,"lines":["     const G = DQ.game, ctx = DQ.Bee.makeCtx(G), round = new Round(ctx, { solo: true, bots: 3, players: [{ id: 0, name: 'Patch', color: SEAT[0] }], demo: true });","     round.begin(); round.fast = true; const ap = new DQ.Autopilot(ctx, ctx.builder, { cheats: { infinite: true, fastPlace: true, teleport: true } }); ctx.builder.local = false;","     ap.run(round.botTask(ap, 0, true));","-    return { ctx, round, update: dt => { DQ.Play.update(ctx, dt, { intent: () => ap.intent() }); round.update(dt); }, draw: r => { DQ.Play.draw(ctx, r, { noHud: true }); round.drawHud(r); }, stop: () => { ap.stop(); for (const b of round.bots) b.ap.stop(); } };","+    return { ctx, round, update: dt => { DQ.Play.update(ctx, dt, { intent: () => ap.intent(), ai: ap }); round.update(dt); }, draw: r => { DQ.Play.draw(ctx, r, { noHud: true }); round.drawHud(r); }, stop: () => { ap.stop(); for (const b of round.bots) b.ap.stop(); } };","   }"," };"," class Round {"]},{"oldStart":21442,"oldLines":7,"newStart":21478,"newLines":7,"lines":["     // play","     const solo = !DQ.HUB;","     if (this.round && this.round.finished && solo) { if (I.pressed('ok')) { G.go('title'); return; } }","-    DQ.Play.update(ctx,