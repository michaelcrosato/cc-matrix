;","   },","   exit() { const G = DQ.game; if (this.ap) this.ap.stop(); G.audio.setVolume(this.vol); this.endBee(); DQ._demo = null; DQ.ctx = DQ._prevCtx || DQ.ctx; },","-  loop() { DQ._demo = null; this.ctx = DQ.demoCtx(); DQ._prevCtx = DQ._prevCtx || DQ.ctx; this.ctx.dev.god = true; this.ap = new DQ.Autopilot(this.ctx, this.ctx.builder, { cheats: { god: true, infinite: true, fastPlace: true, teleport: true }, ui: true }); this.ctx.builder.local = false; this.card = 4; this.vi = -1; },","+  loop() { DQ._demo = null; this.ctx = DQ.demoCtx(); DQ._prevCtx = DQ._prevCtx || DQ.ctx; this.ctx.dev.god = true; this.ap = new DQ.Autopilot(this.ctx, this.ctx.builder, { cheats: { god: true, infinite: true, fastPlace: true, teleport: true }, ui: true, autoTalk: 1.1 }); this.ctx.builder.local = false; this.card = 4; this.vi = -1; },","   next() {","     this.vi++; if (this.vi >= A.VIGNETTES.length) { this.loop(); return; }","     const v = A.VIGNETTES[this.vi]; this.vt = 0; this.endBee();"]},{"oldStart":20915,"oldLines":7,"newStart":20921,"newLines":7,"lines":["     if (this.card > 0) { this.card -= dt; const t = this.ctx.town; G.focus(t.x * T, t.y * T, t.L * T + 10); if (this.card <= 0) this.next(); return; }","     const v = A.VIGNETTES[this.vi]; this.vt += dt;","     if (this.bee) { this.bee.update(dt); if (this.vt > v.len) { this.endBee(); this.next(); } return; }","-    DQ.ctx = this.ctx; DQ.Play.update(this.ctx, dt, { intent: () => this.ap.intent() });","+    DQ.ctx = this.ctx; DQ.Play.update(this.ctx, dt, { intent: () => this.ap.intent(), ai: this.ap });","     if (this.ap.done || this.vt > v.len + 4) { this.ap.stop(); this.next(); }","   },","   draw(r) {"]},{"oldStart":20942,"oldLines":7,"newStart":20948,"newLines":7,"lines":[" const SOLID = DQ.SOLID;"," class Autopilot {","   constructor(ctx, builder, o = {}) {","-    this.ctx = ctx; this.b = builder; this.cheats = o.cheats || {}; this.ui = !!o.ui; this.want = DQ.Controls.blank(); this.fails = []; this.script = null; th