ats.apply(DQ.ctx, id); },\n  get world() { return DQ.ctx && DQ.ctx.world; },\n  get ctx() { return DQ.ctx; }\n};\nconst scenes = DQ.SCENES;\nconst start = HUB ? 'bee' : (DQ.TEST.scene || 'title');\ngame.start({ scene: start, scenes, boot: { title: 'DRAGON QUILT BUILDERS', steps: [\n  ['Unrolling the quilt', () => { if (!HUB && start === 'title') DQ.demoCtx(); }],\n  ['Threading the needles', () => { if (!game.headless) { DQ.atlasFor(E.VIEWS.iso); for (const id in DQ.ITEMS) DQ.Icons.get(id); } }],\n  ['Waking the residents', () => { DQ.tuning.load(); }],\n  ['Tuning the voices', () => { DQ.AudioX.init(game); }]\n], messages: ['Counting the buttons', 'Untangling yarn', 'Ironing the seams'] } });\n})();\n","structuredPatch":[{"oldStart":1,"oldLines":26,"newStart":1,"newLines":60,"lines":["-// TEMP sandbox","+// Main: the game, its settings additions, the pause menu's items, saves, boot steps, game.debug, and the start."," (() => {","-const DQ = globalThis.DQ, E = DQ.E, T = 16;","-const game = DQ.game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'iso', id: 'dqb' });","-const w = new DQ.VoxelWorld(32, 32, 16);","-const id = k => DQ.blockId(k);","-for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) { w.set(x, y, 0, 1, { silent: true }); for (let z = 1; z < 4; z++) w.set(x, y, z, z < 3 ? id('stone') : id('earth'), { silent: true }); w.set(x, y, 4, id('grass'), { silent: true }); }","-// walls","-for (let x = 8; x < 14; x++) for (const y of [8, 13]) for (let z = 5; z < 7; z++) w.set(x, y, z, id('cobble'), { silent: true });","-for (let y = 8; y < 14; y++) for (const x of [8, 13]) for (let z = 5; z < 7; z++) w.set(x, y, z, id('planks'), { silent: true });","-for (let y = 8; y < 14; y++) for (let x = 8; x < 14; x++) w.set(x, y, 7, id('thatch'), { silent: true });","-for (let x = 16; x < 20; x++) for (let y = 16; y < 19; y++) w.set(x, y, 4, 13, { silent: true });","-for (let z = 5; z < 9; z++) w.set(22, 6, z, id('log'), { silent: true });","-for (let 