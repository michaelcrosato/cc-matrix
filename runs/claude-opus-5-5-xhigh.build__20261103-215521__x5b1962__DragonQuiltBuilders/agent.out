{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014t9osdeVHaWg5YzomEXhYs","type":"tool_result","content":"1247:const ZOOM_KEYS = { Minus: 1 / 1.1, NumpadSubtract: 1 / 1.1, Equal: 1.1, NumpadAdd: 1.1 };\n1250:const MENU_KEYS = {\n1256:const BINDABLE = /^(Key[A-Z]|Digit\\d|Numpad\\d|Arrow(Up|Down|Left|Right)|Space|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Tab|Backspace|Backquote|Minus|Equal|Bracket(Left|Right)|Backslash|Semicolon|Quote|Comma|Period|Slash|CapsLock|Mouse[0-4]|Pad([0-8]|1[0-5]))$/;\n1257:const FIXED_CODES = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Pad12', 'Pad13', 'Pad14', 'Pad15', 'PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight']);\n1259:const STICK_CODES = { up: 'PadAxisUp', down: 'PadAxisDown', left: 'PadAxisLeft', right: 'PadAxisRight' };\n1263:const PAD_GLYPHS = {\n1269:const CODE_LABELS = { Space: 'Space', ShiftLeft: 'Shift', ShiftRight: 'R Shift', ControlLeft: 'Ctrl', ControlRight: 'R Ctrl', AltLeft: 'Alt', AltRight: 'R Alt',\n1275:Input.DEFAULT = {\n1289:Input.THIRDPERSON = {\nconst MENU_KEYS = {\n  start: ['Enter', 'NumpadEnter', 'Pad9'], pause: ['Escape', 'KeyP', 'Pad9'],\n  confirm: ['Enter', 'NumpadEnter', 'Space', 'KeyJ', 'KeyZ', 'Pad0'], cancel: ['Escape', 'Backspace', 'KeyX', 'KeyK', 'Pad1']\n};\n/* rebinding: the codes a player may bind (not Escape, Enter, the F keys, Start or Home: the menus and the browser keep\n   them), the arrow keys and d-pad that stay on the moves whatever is bound, and which codes are a gamepad's */\nconst BINDABLE = /^(Key[A-Z]|Digit\\d|Numpad\\d|Arrow(Up|Down|Left|Right)|Space|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Tab|Backspace|Backquote|Minus|Equal|Bracket(Left|Right)|Backslash|Semicolon|Quote|Comma|Period|Slash|CapsLock|Mouse[0-4]|Pad([0-8]|1[0-5]))$/;","is_error":false}]},"parent_tool_use_id":null,"session_id":"9acc64b9-af41-4198-9bbd-536ec13fbed1","uuid":"4c98c05b-374f-445f-a3d8-e6c9e567c9bb","timestamp":"2026-11-04T04:59:57.11