 .78 });\n    F(g, title, x + (w - FW(title)) / 2, 9, '#ffd36a');\n    lines.forEach((l, i) => F(g, l, x + 7, 21 + i * 11, '#f4f0ff'));\n  }\n  drawClock(g, W) {\n    const ctx = this.ctx, c = ctx.clock, ca = DQ.game.cornerArea && DQ.game.cornerArea(), top = ca ? Math.max(6, Math.round(ca.y1) + 4) : 6, x = W - 78;","numLines":32,"startLine":100,"totalLines":285}},"tool_result_meta":[{"id":"toolu_01EhAdLe9qwHfPW6GukE68yz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
