, 6).join(' | ') : e)); }\n}\nfor (const l of out) console.log(l);\nconsole.log(`${pass} passed, ${fail} failed (${((Date.now() - t0) / 1000).toFixed(1)} s)`);\nprocess.exit(fail ? 1 : 0);\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2334,"cache_read_input_tokens":249463,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2334},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9acc64b9-af41-4198-9bbd-536ec13fbed1","uuid":"808105a6-8026-48e0-a0e3-79aeedb54fc6","timestamp":"2026-11-04T05:04:49.124Z","request_id":"req_011CghJbRXoQ4okCWsj9LsBk","wire_tool_inputs":{"toolu_01CCz6Q1uFrArJcVHxYRDRLj":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-215521__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-xhigh-20261103-215521/tests/run.mjs","content":"// THE test command: node tests/run.mjs [--only a,b] [--browser]\n// Prints only failures, then one line: \"N passed, M failed (12.3 s)\". Exit code 1 on any failure.\nimport { readdirSync, existsSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { pathToFileURL } from 'node:url';\nimport { DEV, load, helpers, memStorage } from './lib/load.mjs';\n\nconst args = process.argv.slice(2);\nconst only = (args.find(a => a.startsWith('--only=')) || '').slice(7) || (args.includes('--only') ? args[args.indexOf('--only') + 1] : '');\nconst filt = only ? only.split(',').map(s => s.trim()).filter(Boolean) : null;\nconst browser = args.includes('--browser');\nconst dirs = ['unit', 'play', 'net'].concat(browser ? ['browser'] : []);\nconst files = [];\nfor (const d of dirs) { const p = join(DEV, 'tests', d); if (existsSync(p)) for (const f of readdirSync(p).sort()) if (f.endsWith('.test.mjs') && (!filt || filt.some(x => f.startsWith(x)))) files.push(join(p, f)); }\nlet pass = 0, fail = 0; const t0 = Date.now();\nconst out = [];\nfor (const f of files) {\n  const name = f.slice(f.lastIndexOf('/') + 1).replace('.test.mjs', '');\n  const check = (what, ok, detail = '') => { if (ok) pass++; else { fail++; out.push('FAIL ' + name + ': ' + what + (detail ? ' :: ' + String(detail).slice(0, 600) : '')); } return !!ok; };\n  try {\n    const mod = await import(pathToFileURL(f).href);\n    await mod.default({ load, helpers, memStorage, check, DEV });\n  } catch (e) { fail++; out.push('FAIL ' + name + ': threw ' + (e && e.stack ? e.stack.split('\\n').slice(0, 6).join(' | ') : e)); }\n}\nfor (const l of out) console.log(l);\nconsole.log(`${pass} passed, ${fail} failed (${((Date.now() - t0) / 1000).toFixed(1)} s)`);\nprocess.exit(fail ? 1 : 0);\n"}}}
