r (let z = 8; z < 13; z++) { const o = ctx.objects.at(x, y, z); if (o && !o.def.banner && !o.def.portal) ctx.objects.remove(o, { silent: true }); }","+      const objs = DQ.stampTownRooms(w, [], stage); for (const o of objs) if (!ctx.objects.at(o.x, o.y, o.z)) ctx.objects.add(o.id, o.x, o.y, o.z, o.facing, { silent: true }); ctx.flags['stamp_' + stage] = true; }","     if (LEVEL[beat] > t.level) t.setLevel(LEVEL[beat]);","     // residents","     const who = ['wren']; if (idx >= 2) who.push('mortimer'); if (idx >= 3) who.push('marigold'); if (idx >= 4) who.push('professor', 'lintwick');"]},{"oldStart":44,"oldLines":7,"newStart":45,"newLines":7,"lines":["     if (idx >= 5) { b.bag.add('copperBodkin', 1); b.equipItem('copperBodkin'); b.bag.add('copperIngot', 4); b.bag.add('steelThread', 4); b.bag.add('log', 6); b.bag.add('pins', 6); b.bag.add('planks', 20); }","     if (idx >= 6) { b.bag.remove('goldenNeedle', 1); b.bag.add('seamRipper', 1); b.equipItem('seamRipper'); ctx.flags.boss_buttonGolem = true; }","     while (b.bag.count('heartpatch') > 0) { b.bag.remove('heartpatch', 1); b.heartpatches++; } b.hp = b.maxHp; b.belly = 100;","-    b.bag.add('bun', 3);","+    b.bag.add('bun', 3); if (idx >= 1) b.bag.remove('banner', b.bag.count('banner')); if (idx >= 5) b.bag.remove('hallPattern', b.bag.count('hallPattern'));","     if (idx >= 2) for (const r of DQ.RECIPES) { const n = r.notion; if ((n.on === 'level' && n.key <= t.level) || n.on === 'pickup' || n.on === 'placed' || (n.on === 'flag') || (n.on === 'quest' && (done.includes(n.key) || done.includes(String(n.key).replace('start', ''))))) ctx.crafting.learn(r.id, { silent: true }); }","     if (idx >= 1) { ctx.crafting.learn('bench', { silent: true }); ctx.crafting.learn('latticeDoor', { silent: true }); ctx.crafting.learn('torch', { silent: true }); }","     for (const p of DQ.WORLD.portals) if (idx >= 2 || p.id === 'town' || p.id === 'hollow') ctx.flags['portal_' + p.id] = true;"]}]},{"filePath":"/home/micha/dev/cc-