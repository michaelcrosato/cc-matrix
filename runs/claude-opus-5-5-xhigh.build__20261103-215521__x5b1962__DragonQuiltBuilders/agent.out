 = 16, HUB = DQ.HUB;","+DQ.ABOUT = (typeof DQ_ABOUT !== 'undefined' && DQ_ABOUT) || null;","+DQ.SETTINGS = [","+  { key: 'glyphs', group: 'Controller', label: 'Button glyphs', type: 'select', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']], apply: (g, v) => { g.input.glyphs = v; } },","+  { key: 'camView', group: 'Game', label: 'Camera view', type: 'select', value: 'Isometric', options: ['Isometric', 'Three-quarter'], apply: (g, v) => { if (g.scene && g.sceneName !== undefined && DQ.ctx) { g.setView(v === 'Three-quarter' ? 'threequarter' : 'iso'); const zs = DQ.ZOOMS[g.baseView.id]; g.setZoom(zs[E.clamp(DQ.ctx.zoomI === undefined ? 1 : DQ.ctx.zoomI, 0, zs.length - 1)]); } } },","+  { key: 'difficulty', group: 'Game', label: 'Difficulty', type: 'select', value: 'Normal', options: ['Relaxed', 'Normal', 'Hard'], help: 'Relaxed: half damage taken, nothing lost when you come undone. Hard: 1.4x damage' },","+  { key: 'autoHop', group: 'Game', label: 'Auto-hop', type: 'toggle', value: true, help: 'Hop up one-block ledges by walking into them' },","+  { key: 'sprintMode', group: 'Game', label: 'Sprint', type: 'select', value: 'hold', options: [['hold', 'Hold'], ['toggle', 'Toggle']] },","+  { key: 'textSpeed', group: 'Game', label: 'Text speed', type: 'select', value: 'Normal', options: ['Slow', 'Normal', 'Fast'] },","+  { key: 'tracker', group: 'Game', label: 'HUD tracker', type: 'toggle', value: true, help: 'The objective and its marker' },","+  { key: 'tutorials', group: 'Game', label: 'Tutorial tips', type: 'toggle', value: true },","+  { key: 'cutaway', group: 'Game', label: 'Cutaway', type: 'select', value: 'Auto', options: ['Auto', 'Always', 'Off'], help: 'See inside roofs, tunnels and treetops around you' },","+  { key: 'voices', group: 'Sound', label: 'Voices', type: 'slider', value: .8 }","+];","+const game = DQ.game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'iso', views: ['iso', 'threequarter'], input: DQ.Controls.PLAY, id: 'dragon-quilt-builders',","+  autoPause: !HUB, corner: !HUB, fullscreen: HUB ? false : 'tap', backGesture: !HUB,","+  menu: HUB ? false : { saves: { slots: 3, version: 1, migrate: (d, f) => DQ.Save.migrate(d, f) },","+    items: [['Satchel', () => { game.resume(); if (DQ.ctx && game.sceneName === 'play') DQ.Menus.openSatchel(DQ.ctx); }], ['Dev Tools', () => { game.resume(); if (DQ.Dev) DQ.Dev.open(); }], ['About & Credits', () => { game.resume(); game.go('about', { back: game.sceneName === 'play' ? 'pause' : 'title' }); }]],","+    settings: DQ.SETTINGS, controls: DQ.Controls.NAMES, quit: 'title' } });","+game.input.glyphs = game.settings.glyphs || 'playstation';","+if (game.saves) {","+  game.saves.write = () => DQ.Save.write(DQ.ctx);","+  game.saves.read = s => { game.go('play', { saveData: s.data }); };","+}","+// keys seen (touch-only detection), letters typed (name entry)","+if (typeof window !== 'undefined' && window.addEventListener && !game.headless) {","+  window.addEventListener('keydown', e => { DQ._keySeen = true; if (DQ.Controls.typing && !e.repeat) DQ.typedKeys.push(e.key.length === 1 || e.key === 'Backspace' || e.key === 'Enter' ? e.key : ''); });","+  window.addEventListener('gamepadconnected', () => { DQ._keySeen = true; });","+}","+game.debug = {","+  snapshot() {","+    const c = DQ.ctx, sc = game.sceneName; if (!c || !c.builder) return { scene: sc, errors: game.errors.length };","+    const b = c.builder, bag = b.bag.ids(); Object.assign(bag, b.bag.keys);","+    const boss = c.bosses && c.bosses.active();","+    return { scene: sc, mode: c.mode, day: c.clock.day, hour: Math.round(c.clock.hour * 100) / 100,","+      builder: { x: Math.round(b.x), y: Math.round(b.y), z: Math.round(b.z), cx: b.cx, cy: b.cy, L: b.L, hp: b.hp, maxHp: b.maxHp, belly: Math.round(b.belly), equip: b.equip.weapon, ko: !!b.ko },","+      bag, town: { planted: c.town.planted, level: c.town.level, cheer: c.town.cheer, border: c.town.rShown, rooms: c.rooms.list.filter(r => r.inTown).map(r => r.type) },","+      quests: Object.fromEntries(Object.entries(c.quests.s).map(([k, s]) => [k, s.status === 'done' ? 'done' : s.status === 'active' ? s.step : s.status])),","+      residents: c.npcs.list.map(n => ({ id: n.id, x: n.cx, y: n.cy, state: n.sleeping ? 'sleep' : n.state })), monsters: c.monsters.list.filter(m => !m.dead).length,","+      siege: { active: c.siege.active, phase: c.siege.phase, wave: c.siege.wave }, boss: boss ? { id: boss.kind, hp: boss.hp, tangled: boss.tangled || 0 } : null,","+      modal: c.modal, cutscene: c.cutscene ? c.cutscene.name : null, flags: Object.keys(c.flags).filter(k => c.flags[k]), errors: game.errors.length };","+  },","+  teleport(x, y, z) { const b = DQ.ctx && DQ.ctx.builder; if (b) { if (z === undefined) z = DQ.ctx.world.topZ(Math.floor(x / T), Math.floor(y / T)) * T; b.place3(x, y, z); game.cam.snap = true; } },","+  give(id, n = 1) { const b = DQ.ctx && DQ.ctx.builder; if (b) b.bag.add(id, n); },","+  flag(k, v = true) { if (DQ.ctx) DQ.ctx.quests.setFlag(k, v); },","+  beat(id) { return DQ.ctx && DQ.Beats.apply(DQ.ctx, id); },","+  get world() { return DQ.ctx && DQ.ctx.world; },","+  get ctx() { return DQ.ctx; }","+};","+const scenes = DQ.SCENES;","+const start = HUB ? 'bee' : (DQ.TEST.scene || 'title');","+game.start({ scene: start, scenes, boot: { title: 'DRAGON QUILT BUILDERS', steps: [","+  ['Unrolling the quilt', () => { if (!HUB && start === 'title') DQ.demoCtx(); }],","+  ['Threading the needles', () => { if (!game.headless) { DQ.atlasFor(E.VIEWS.iso); for (const id in DQ.ITEMS) DQ.Icons.get(id); } }],","+  ['Waking the residents', () => { DQ.tuning.load(); }],","+  ['Tuning the voices', () => { DQ.AudioX.init(game); }]","+], messages: ['Counting the buttons', 'Untangling yarn', 'Ironing the seams'] } });"," })();"]}],"originalFile":"// TEMP sandbox\n(() => {\nconst DQ = globalThis.DQ, E = DQ.E, T = 16;\nconst game = DQ.game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'iso', id: 'dqb' });\nconst w = new DQ.VoxelWorld(32, 32, 16);\nconst id = k => DQ.blockId(k);\nfor (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) { w.set(x, y, 0, 1, { silent: true }); for (let z = 1; z < 4; z++) w.set(x, y, z, z < 3 ? id('stone') : id('earth'), { silent: true }); w.set(x, y, 4, id('grass'), { silent: true }); }\n// walls\nfor (let x = 8; x < 14; x++) for (const y of [8, 13]) for (let z = 5; z < 7; z++) w.set(x, y, z, id('cobble'), { silent: true });\nfor (let y = 8; y < 14; y++) for (const x of [8, 13]) for (let z = 5; z < 7; z++) w.set(x, y, z, id('planks'), { silent: true });\nfor (let y = 8; y < 14; y++) for (let x = 8; x < 14; x++) w.set(x, y, 7, id('thatch'), { silent: true });\nfor (let x = 16; x < 20; x++) for (let y = 16; y < 19; y++) w.set(x, y, 4, 13, { silent: true });\nfor (let z = 5; z < 9; z++) w.set(22, 6, z, id('log'), { silent: true });\nfor (let x = 20; x < 25; x++) for (let y = 4; y < 9; y++) for (let z = 9; z < 11; z++) if (Math.hypot(x - 22, y - 6, (z - 9.5) * 1.5) < 2.6) w.set(x, y, z, id('leaves'), { silent: true });\nconst ks = ['sand','gravel','stone','copperOre','coal','frayed','knot','feltRed','feltBlue','feltYellow','glow','gildedFelt','ruin','frayedTurf','darkStone'];\nks.forEach((k, i) => w.set(2 + i, 24, 5, id(k), { silent: true }));\nw.set(20, 12, 5, id('stairsPlank'), { silent: true, rot: 0 }); w.set(21, 12, 5, id('planks'), { silent: true }); w.set(21, 12, 6, id('stairsPlank'), { silent: true, rot: 0 });\nconst R = new DQ.VoxelRenderer(w);\nconst hero = new DQ.VoxelBody({ x: 5 * T + 8, y: 5 * T + 8, z: 5 * T });\nconst rig = new E.Humanoid({ size: 1, build: 'chibi', hair: 'spiky', hat: { style: 'band', color: '#c8443a' }, outfit: 'tunic', colors: { cloth: '#3a5f9a', trim: '#e8c870' } });\ngame.start({ scene: 'play', scenes: { play: {\n  enter() { game.follow(hero, { z: 14 }); game.cam.bounds = v => w.bounds(v); game.lights.enabled = true; game.lights.ambient = 1; const h = location.hash; if (h.includes('rot')) game.rotateView(90 * (+h.split('rot')[1][0] || 1)); if (h.includes('z2')) game.setZoom(2); if (h.includes('tq')) game.setView('threequarter'); },\n  update(dt) { const m = game.input.move(), d = game.view.screenDirToGround(m[0], m[1]); hero.vx = d[0] * 78; hero.vy = d[1] * 78; if (game.input.pressed('confirm')) hero.jump(215); hero.update(dt, w); if (Math.hypot(d[0], d[1]) > .1) hero.facing = Math.atan2(d[1], d[0]); rig.update(dt, { x: hero.x, y: hero.y, z: hero.z, vx: hero.vx, vy: hero.vy, facing: hero.facing || 0, air: !hero.onGround }); },\n  draw(r) { r.sky(['#06051a', '#0d0b2a', '#141238']); R.queue(r); r.shadow(hero.x, hero.y, 5, .5, '#000', hero.groundZ); r.actor(hero.x, hero.y, hero.z, (g, ox, oy) => rig.draw(g, ox, oy, r.view), { xray: { color: '#8fe3ff' } }); r.text('runs ' + R.runsDrawn, 4, 4, '#fff'); }\n} } });\n})();\n","userModified":false},"tool_result_meta":[{"id":"toolu_01YT9KiBT2c9KLcujPQVexPw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
