end\":34,\"height\":55,\"pos\":[0,-18,0],\"color\":\"#7f6c2f\",\"pitch\":180},\n }))\nP.append(prop(\"jacket\",\"A short brown field jacket with the collar up.\",{\n \"body\":{\"type\":\"rounded_box\",\"size\":[50,56,32],\"radius\":12,\"pos\":[0,-22,0],\"color\":\"#5b4632\"},\n \"collar\":{\"type\":\"torus\",\"radius\":12,\"minor_radius\":4.5,\"pos\":[0,9,0],\"color\":\"#4c3a29\"},\n \"strap\":{\"type\":\"box\",\"size\":[6,60,2],\"pos\":[-14,-20,17],\"color\":\"#2c2420\"},\n }))\nP.append(prop(\"sleeve\",\"A jacket sleeve.\",{\n \"sleeve\":{\"type\":\"capsule\",\"radius\":9,\"height\":30,\"pos\":[0,-14,0],\"color\":\"#5b4632\"},\n }))\nP.append(prop(\"boot\",\"A knee boot.\",{\n \"boot\":{\"type\":\"cylinder\",\"radius\":7.5,\"height\":26,\"pos\":[0,-24,0],\"color\":\"#27231f\"},\n }))\nP.append(prop(\"service_pistol\",\"A heavy service pistol.\",{\n \"slide\":{\"type\":\"box\",\"size\":[4,22,5],\"pos\":[0,14,6],\"color\":\"#2a2c30\"},\n \"barrel\":{\"type\":\"cylinder\",\"radius\":1.4,\"height\":6,\"pos\":[0,26,6.5],\"color\":\"#17181a\"},\n \"grip\":{\"type\":\"box\",\"size\":[3.6,5,10],\"pos\":[0,4,0],\"color\":\"#3a2c20\"},\n \"laser\":{\"type\":\"box\",\"size\":[2,4,2],\"pos\":[0,18,2.6],\"color\":\"#ff3020\",\"emissive\":6},\n },None,{\"grip\":{\"pos\":[0,0,0]},\"tip\":{\"pos\":[0,29,6.5]}}))\nlines=[json.dumps(x) for x in P]\nopen('out/props.repl','w').write(\"\\n\".join(lines)+\"\\n\")\nEOF\n./target/debug/pav repl < out/props.repl 2>&1 | python3 -c \"\nimport sys,json\nfor l in sys.stdin:\n    try:\n        d=json.loads(l); print(d.get('name') or d.get('error'), d.get('size_cm'), [f.get('code') for f in d.get('check',{}).get('findings',[])] if isinstance(d.get('check'),dict) else d.get('check'))\n    except Exception as e: print(l[:300])\n\" | head -20; ls assets/props/workshop 2>/dev/null | head -20; python3 - <<'EOF'\ns=open('rooms/zz_test.toml').read()\ns=s.split('[[object]]')[0]\ns=s.replace('[layout.legend.\\'.\\']\\nblocks = [{ y0 = -0.5, y1 = 0, colo