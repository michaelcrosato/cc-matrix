 n = pg.evaluate(\"document.querySelector('canvas')? 1:0\")\n            if n: ok=True; break\n            time.sleep(0.5)\n        t1=time.time()\n        gpu = pg.evaluate(\"!!navigator.gpu\")\n        adapter = pg.evaluate(\"navigator.gpu ? navigator.gpu.requestAdapter().then(a=>a? (a.info? a.info.vendor+' '+a.info.architecture+' '+a.info.device+' '+a.info.description : 'adapter') : 'none') : 'nogpu'\")\n        print(name,\"canvas\" if ok else \"NO CANVAS\",round(t1-t0,1),\"s gpu\",gpu,adapter)\n        # count frames via rAF for 5 s, then press pad stick right + A and see logs\n        fps = pg.evaluate(\"new Promise(r=>{let n=0;const t=performance.now();function f(){n++; if(performance.now()-t>5000) r(n/5); else requestAnimationFrame(f)};requestAnimationFrame(f)})\")\n        print(\" rAF fps\",round(fps,1))\n        pg.evaluate(\"window.__pad.axes[0]=1; window.__pad.buttons[0].pressed=true; window.__pad.buttons[0].value=1;\")\n        time.sleep(3)\n        pg.evaluate(\"window.__pad.axes[0]=0; window.__pad.buttons[0].pressed=false; window.__pad.buttons[0].value=0;\")\n        pg.screenshot(path=f\"boot_{name}.png\")\n        print(\" logs:\"); print(\"\\n\".join(\"   \"+l for l in logs[:30]))\n        b.close()\nEOF\nPLAYWRIGHT_HOST_PLATFORM_OVERRIDE=${PLAYWRIGHT_HOST_PLATFORM_OVERRIDE:-ubuntu24.04-x64} timeout 200 python3 -I boot.py ../shardfall/out/probe.html 2>&1 | tail -40","description":"Boot the single-file game headless with two flag sets and a stub pad","timeout":240000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":927,"cache_read_input_tokens":322834,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":927},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"501e71