ll; sed -n 80,175p crates/pav_core/build.rs; sed -n 105,135p crates/pav_core/src/props/store.rs; cat assets/props/lib/kaykit_adventurers/PACK.json | head -20; head -3 assets/props/lib/core/index.tsv | cut -c1-200; du -sh target 2>/dev/null; du -sh target/wasm32-unknown-unknown target/debug 2>/dev/null; grep -n \"fn visit_groups\" -A 16 crates/pav_core/src/sim.rs | head -30; sed -i 's/zone = { kind = \"water\", y0 = -2.0, y1 = -0.4 }/zone = { kind = \"water\", y0 = -2.0, y1 = -0.4, color = \"#16303a\" }/' rooms/zz_test.toml; printf 'load scene=zz_test seed=1\\nstep ticks=20\\nset path=camera.yaw value=180\\ncapture width=640 height=360 out=out/t5.png\\n' | timeout 60 ./target/debug/pav repl 2>&1 | tail -1 | cut -c1-200","description":"Read shipped-pack embedding, sizes, tunable groups, try water colour","timeout":90000}}}
