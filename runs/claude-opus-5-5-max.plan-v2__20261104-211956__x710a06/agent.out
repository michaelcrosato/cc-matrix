os` and `yaw` are ignored). Give it a sitting clip, and the seat `body = \"none\"`.\n    #[serde(default, skip_serializing_if = \"String::is_empty\")]\n    pub seat: String,\n}\n\nfn half_speed() -> f32 {\n    0.5\n}\n\nimpl NpcDef {\n    /// The performance (`clips`, `moves`), resolved; None when there is none.\ncrates/pav_core/src/puppet.rs:731:    pub fn play_clip(&mut self, id: u32, flags: u8, speed: f32) {\ncrates/pav_core/src/puppet.rs:756:    pub fn replay_clip(&mut self, id: u32, flags: u8, speed: f32) {\ncrates/pav_core/src/puppet.rs:765:        self.play_clip(id, flags, speed);\ncrates/pav_core/src/character.rs:1163:        ch.anim.replay_clip(dodge_clip, crate::clips::ONCE | crate::clips::QUICK, (dur / (left + 0.3)).clamp(1.0, 4.0));\ncrates/pav_core/src/character.rs:1232:                ch.anim.play_clip(want, 0, rate);\ncrates/pav_core/src/arpg/scene.rs:692:                        ch.anim.play_clip(bow, crate::clips::UPPER | crate::clips::ONCE, 1.0);\ncrates/pav_core/src/arpg/hall.rs:240:                ch.anim.replay_clip(id, crate::clips::ONCE | crate::clips::QUICK, 1.0);\ncrates/pav_core/src/ai.rs:119:                anim.play_clip(id, flags, speed);\ncrates/pav_core/src/ai.rs:131:                anim.play_clip(id, flags, speed);\ncrates/pav_core/src/arpg/mod.rs:946:                            ch.anim.replay_clip(clip, crate::clips::ONCE | crate::clips::QUICK, rate);\ncrates/pav_core/src/arpg/mod.rs:970:                    ch.anim.play_clip(clip, crate::clips::QUICK, rate);\ncrates/pav_core/src/arpg/mod.rs:985:                    ch.anim.play_clip(death, 0, 1.0);\n117:    pub face_aim: bool,\n158:            face_aim: false,\n197:        v.bool(\"face_aim\", &mut self.face_aim, \"Face the aim point instead of the movement direction\");\n218:    /// Fixed shooting direction (degrees, 180 = north/-Z), or < 0 to shoot where you aim/face.\n281:        v.float(\"shoot_angle\", &mut self.shoot_angle, -1.0, 360.0, \"Blaster: fixed direction (deg, 180 = north), -1 = aim\");\n1096:        if mp.face_aim {\n1097:            if let Some(a) = input.aim {\n1117:                match input.aim {\n1136:        let (dir, dist) = match input.aim {\n1144:        let target_y = input.aim.map(|a| a.y).unwrap_or(feet.y);\n//! Readable procedural props. Named parts use the engine's shapes, colors and surface looks.\n//! A published definition is immutable; placed instances can keep it in their snapshots.\n\npub mod compile;\npub mod doc;\npub mod family;\npub mod geom;\npub mod index;\npub mod lint;\npub mod mesh;\nmod patch;\nmod read;\npub mod store;\npub mod table;\nmod write;\n\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::sync::{Arc, Mutex, OnceLock, RwLock};\n\nuse glam::{Quat, Vec3};\nuse serde::{Deserialize, Deserializer, Serialize};\nuse serde_json::Value;\n\nuse crate::color::Color;\nuse crate::issue::{self, Issue};\nuse crate::shape::{Look, Shape, Visual};\n\npub use compile::{CompiledProp, DEFAULT_ROLES, ResolvedPart};\npub use doc::Doc;\npub use family::{Params, apply_params, canonical_placed, patched, resolve_parts, resolve_placed, split_preset};\npub use patch::MAX_OPS;\npub use patch::v2::{OPS as OPS2, Patched, patch as patch_document};\n/// Format 2's field tables, legend and field guide.\npub use read::v2 as format2;\npub use read::{DOCUMENT_FIELDS, LOOKS, OPS, PART_FIELDS, SHAPES, check, migrate, schema, strict_value};\n/// Reader helpers the material reader shares, so both word their errors alike.\npub(crate) use read::{amount, color_fix, is_color, look_hint, number, wrong_type};\npub use store::{Tier, canonical, disk_root, editable, leaf};\npub use table::PropDefTable;\n/// The material writer shares the canonical layout of inline materials.\n104-/// for this frame at `at`: its parts, their glow and its lights, as a placed copy draws them.\n105-/// `seed` picks the variant (`chance`, `jitter`, `pick`; 0 as authored; each asset keeps 64\n106-/// seeds compiled, so use a few, e.g. `id % 8`). `palette` col