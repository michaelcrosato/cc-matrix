{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PxsP7HGMHuX9yBpiwFxvFn","type":"tool_result","content":"1\t//! Synthesized sound: every sound is built from oscillators, noise, envelopes, pitch sweeps\n2\t//! and a filter. The mixer runs in the audio callback (cpal) or offline (to .wav). The game\n3\t//! runs fine without a sound device.\n4\t\n5\tuse std::sync::mpsc::{Receiver, Sender, channel};\n6\t\n7\tuse glam::Vec3;\n8\tuse pav_core::SimEvent;\n9\t\n10\t#[derive(Clone, Copy, Debug, PartialEq)]\n11\tpub enum Wave {\n12\t    Sine,\n13\t    Square,\n14\t    Saw,\n15\t    Triangle,\n16\t    Noise,\n17\t}\n18\t\n19\t/// One synthesized sound.\n20\t#[derive(Clone, Copy, Debug)]\n21\tpub struct Patch {\n22\t    pub wave: Wave,\n23\t    /// Start / end frequency (Hz) and the glide time between them (s, exponential).\n24\t    pub freq: f32,\n25\t    pub freq_end: f32,\n26\t    pub glide: f32,\n27\t    pub attack: f32,\n28\t    pub decay: f32,\n29\t    pub sustain: f32,\n30\t    pub hold: f32,\n31\t    pub release: f32,\n32\t    pub volume: f32,\n33\t    /// One-pole low-pass cutoff (Hz) at start and end of the sound.\n34\t    pub cutoff: f32,\n35\t    pub cutoff_end: f32,\n36\t    /// Square-wave duty cycle.\n37\t    pub duty: f32,\n38\t}\n39\t\n40\timpl Patch {\n41\t    pub const fn new(wave: Wave, freq: f32) -> Self {\n42\t        Self {\n43\t            wave,\n44\t            freq,\n45\t            freq_end: freq,\n46\t            glide: 0.1,\n47\t            attack: 0.002,\n48\t            decay: 0.1,\n49\t            sustain: 0.0,\n50\t            hold: 0.0,\n51\t            release: 0.05,\n52\t            volume: 0.3,\n53\t            cutoff: 12000.0,\n54\t            cutoff_end: 12000.0,\n55\t            duty: 0.5,\n56\t        }\n57\t    }\n58\t    pub fn length(&self) -> f32 {\n59\t        self.attack + self.decay + self.hold + self.release\n60\t    }\n61\t}\n62\t\n63\tstruct Voice {\n64\t    p: Patch,\n65\t    t: f32,\n66\t    delay: f32,\n67\t    phase: f32,\n68\t    lp: f32,\n69\t    noise: u32,\n70\t    gain_l: f32,\n71\t    gain_r: f32,\n72\t}\n73\t\n74\timpl Voice {\n75\t    fn env(&self) -> f32 {\n76\t        let p = &self.p;\n77\t        let t = self.t;\n78\t        if t < p.attack {\n79\t            return t / p.attack.max(1e-5);\n80\t        }\n81\t        let t = t - p.attack;\n82\t        if t < p.decay {\n83\t            return 1.0 + (p.sustain - 1.0) * (t / p.decay.max(1e-5));\n84\t        }\n85\t        let t = t - p.decay;\n86\t        if t < p.hold {\n87\t            return p.sustain;\n88\t        }\n89\t        let t = t - p.hold;\n90\t        let start = if p.decay > 0.0 || p.hold > 0.0 { p.sustain } else { 1.0 };\n91\t        (start * (1.0 - t / p.release.max(1e-5))).max(0.0)\n92\t    }\n93\t\n94\t    fn done(&self) -> bool {\n95\t        self.t > self.p.length() + 0.01\n96\t    }\n97\t\n98\t    fn next(&mut self, dt: f32) -> f32 {\n99\t        if self.delay > 0.0 {\n100\t            self.delay -= dt;\n101\t            return 0.0;\n102\t        }\n103\t        let p = self.p;\n104\t        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n105\t        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n106\t        self.phase = (self.phase + freq * dt).fract();\n107\t        let ph = self.phase;\n108\t        let raw = match p.wave {\n109\t            Wave::Sine => (ph * std::f32::consts::TAU).sin(),\n110\t            Wave::Square => {\n111\t                if ph < p.duty {\n112\t                    1.0\n113\t                } else {\n114\t                    -1.0\n115\t                }\n116\t            }\n117\t            Wave::Saw => ph * 2.0 - 1.0,\n118\t            Wave::Triangle => 1.0 - 4.0 * (ph - 0.5).abs(),\n119\t            Wave::Noise => {\n120\t                self.noise ^= self.noise << 13;\n121\t                self.noise ^= self.noise >> 17;\n122\t                self.noise ^= self.noise << 5;\n123\t                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n124\t            }\n125\t        };\n126\t        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n127\t        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n128\t        self.lp += (raw - self.lp) * a;\n129\t        let s = self.lp * self.env() * p.volume;\n130\t        self.t += dt;\n131\t        s\n132\t    }\n133\t}\n134\t\n135\t/// Mixes voices into interleaved stereo.\n136\tpub struct Mixer {\n137\t    voices: Vec<Voice>,\n138\t    pub sample_rate: f32,\n139\t    pub master: f32,\n140\t    seed: u32,\n141\t}\n142\t\n143\tconst MAX_VOICES: usize = 64;\n144\t\n145\timpl Mixer {\n146\t    pub fn new(sample_rate: f32) -> Self {\n147\t        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n148\t    }\n149\t\n150\t    /// pan -1 (left) .. 1 (right); delay in seconds.\n151\t    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n152\t        if self.voices.len() >= MAX_VOICES {\n153\t            // Drop the oldest.\n154\t            self.voices.remove(0);\n155\t        }\n156\t        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n157\t        let pan = pan.clamp(-1.0, 1.0);\n158\t        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n159\t        self.voices.push(Voice {\n160\t            p,\n161\t            t: 0.0,\n162\t            delay,\n163\t            phase: 0.0,\n164\t            lp: 0.0,\n165\t            noise: self.seed | 1,\n166\t            gain_l: a.cos() * gain,\n167\t            gain_r: a.sin() * gain,\n168\t        });\n169\t    }\n170\t\n171\t    /// Renders into an interleaved stereo buffer (overwrites).\n172\t    pub fn render(&mut self, out: &mut [f32]) {\n173\t        let dt = 1.0 / self.sample_rate;\n174\t        for frame in out.chunks_mut(2) {\n175\t            let (mut l, mut r) = (0.0, 0.0);\n176\t            for v in &mut self.voices {\n177\t                let s = v.next(dt);\n178\t                l += s * v.gain_l;\n179\t                r += s * v.gain_r;\n180\t            }\n181\t            // Soft clip.\n182\t            let m = self.master;\n183\t            frame[0] = (l * m).tanh();\n184\t            if frame.len() > 1 {\n185\t                frame[1] = (r * m).tanh();\n186\t            }\n187\t        }\n188\t        self.voices.retain(|v| !v.done());\n189\t    }\n190\t\n191\t    pub fn active(&self) -> usize {\n192\t        self.voices.len()\n193\t    }\n194\t}\n195\t\n196\t/// Where the ears are: position and the camera's right vector (for panning).\n197\t#[derive(Clone, Copy, Debug)]\n198\tpub struct Listener {\n199\t    pub pos: Vec3,\n200\t    pub right: Vec3,\n201\t}\n202\t\n203\timpl Default for Listener {\n204\t    fn default() -> Self {\n205\t        Self { pos: Vec3::ZERO, right: Vec3::X }\n206\t    }\n207\t}\n208\t\n209\t/// The sound bank: which patches play for a simulation event.\n210\tpub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n211\t    use Wave::*;\n212\t    match ev {\n213\t        SimEvent::Jump { .. } => vec![(\n214\t            Patch {\n215\t                freq_end: 640.0,\n216\t                glide: 0.11,\n217\t                decay: 0.12,\n218\t                volume: 0.18,\n219\t                cutoff: 3500.0,\n220\t                cutoff_end: 2500.0,\n221\t                duty: 0.3,\n222\t                ..Patch::new(Square, 280.0)\n223\t            },\n224\t            0.0,\n225\t        )],\n226\t        SimEvent::Land { speed, .. } => {\n227\t            let v = (speed / 14.0).clamp(0.15, 1.0);\n228\t            vec![\n229\t                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n230\t                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n231\t            ]\n232\t        }\n233\t        SimEvent::Step { .. } => {\n234\t            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n235\t        }\n236\t        SimEvent::Throw { .. } => vec![(\n237\t            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n238\t            0.0,\n239\t        )],\n240\t        SimEvent::Explosion { radius, .. } => {\n241\t            let v = (radius / 1.35).clamp(0.5, 2.0);\n242\t            vec![\n243\t                (\n244\t                    Patch {\n245\t                        attack: 0.004,\n246\t                        decay: 0.25,\n247\t                        sustain: 0.35,\n248\t                        hold: 0.1,\n249\t                        release: 0.6,\n250\t                        volume: 0.6 * v,\n251\t                        cutoff: 4000.0,\n252\t                        cutoff_end: 120.0,\n253\t                        ..Patch::new(Noise, 1.0)\n254\t                    },\n255\t                    0.0,\n256\t                ),\n257\t                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n258\t            ]\n259\t        }\n260\t        SimEvent::EnterRoom { .. } => vec![\n261\t            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n262\t            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n263\t        ],\n264\t        SimEvent::Hit { strength, .. } => {\n265\t            let v = (strength / 8.0).clamp(0.4, 1.2);\n266\t            vec![\n267\t                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n268\t                (\n269\t                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n270\t                    0.0,\n271\t                ),\n272\t            ]\n273\t        }\n274\t        // Shardfall.\n275\t        SimEvent::Swing { heavy, .. } => {\n276\t            let h = if *heavy { 1.4 } else { 1.0 };\n277\t            vec![(\n278\t                Patch {\n279\t                    attack: 0.02,\n280\t                    decay: 0.12 * h,\n281\t                    volume: 0.16 * h,\n282\t                    cutoff: 1800.0,\n283\t                    cutoff_end: 5200.0,\n284\t                    ..Patch::new(Noise, 1.0)\n285\t                },\n286\t                0.0,\n287\t            )]\n288\t        }\n289\t        SimEvent::Strike { power, element, crit, .. } => {\n290\t            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n291\t            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n292\t            let mut out = vec![\n293\t                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n294\t                (\n295\t                    Patch {\n296\t                        freq_end: tone * 0.5,\n297\t                        glide: 0.08,\n298\t                        decay: 0.1,\n299\t                        volume: 0.2 * v,\n300\t                        duty: 0.35,\n301\t                        ..Patch::new(Square, tone)\n302\t                    },\n303\t                    0.0,\n304\t                ),\n305\t            ];\n306\t            if *crit {\n307\t                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n308\t            }\n309\t            out\n310\t        }\n311\t        SimEvent::Slain { size, .. } => {\n312\t            let k = size.clamp(0.3, 1.5);\n313\t            vec![\n314\t                (\n315\t                    Patch {\n316\t                        freq_end: 60.0,\n317\t                        glide: 0.3,\n318\t                        decay: 0.3,\n319\t                        volume: 0.22 * k,\n320\t                        duty: 0.5,\n321\t                        ..Patch::new(Square, 180.0 / k)\n322\t                    },\n323\t                    0.0,\n324\t                ),\n325\t                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n326\t            ]\n327\t        }\n328\t        SimEvent::Slam { radius, .. } => {\n329\t            let k = (radius / 2.5).clamp(0.6, 1.5);\n330\t            vec![\n331\t                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.45 * k, ..Patch::new(Sine, 110.0) }, 0.0),\n332\t                (Patch { decay: 0.3, volume: 0.3 * k, cutoff: 2200.0, cutoff_end: 150.0, ..Patch::new(Noise, 1.0) }, 0.0),\n333\t            ]\n334\t        }\n335\t        SimEvent::Blast { element, .. } => {\n336\t            let cut = [2500.0, 3500.0, 6000.0, 8000.0, 2000.0][(*element as usize).min(4)];\n337\t            vec![\n338\t                (\n339\t                    Patch { attack: 0.003, decay: 0.3, volume: 0.35, cutoff: cut, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) },\n340\t                    0.0,\n341\t                ),\n342\t                (Patch { freq_end: 50.0, glide: 0.25, decay: 0.3, volume: 0.25, ..Patch::new(Sine, 140.0) }, 0.0),\n343\t            ]\n344\t        }\n345\t        SimEvent::Spell { element, .. } => {\n346\t            let f = [300.0, 260.0, 900.0, 1400.0, 420.0][(*element as usize).min(4)];\n347\t            vec![(\n348\t                Patch {\n349\t                    freq_end: f * 1.8,\n350\t                    glide: 0.15,\n351\t                    attack: 0.02,\n352\t                    decay: 0.18,\n353\t                    volume: 0.12,\n354\t                    duty: 0.25,\n355\t                    ..Patch::new(Saw, f)\n356\t                },\n357\t                0.0,\n358\t            )]\n359\t        }\n360\t        SimEvent::Coin { .. } => vec![\n361\t            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 1980.0) }, 0.0),\n362\t            (Patch { decay: 0.12, volume: 0.09, ..Patch::new(Triangle, 2640.0) }, 0.05),\n363\t        ],\n364\t        // Drops chime by rarity: rares ring, uniques ring a chord.\n365\t        SimEvent::Loot { rarity, .. } => match rarity {\n366\t            0 => vec![(Patch { decay: 0.05, volume: 0.05, cutoff: 2500.0, ..Patch::new(Triangle, 880.0) }, 0.0)],\n367\t            1 => vec![(Patch { decay: 0.12, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.0)],\n368\t            2 => vec![\n369\t                (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 1568.0) }, 0.0),\n370\t                (Patch { decay: 0.35, volume: 0.1, ..Patch::new(Sine, 2093.0) }, 0.08),\n371\t            ],\n372\t            _ => vec![\n373\t                (Patch { decay: 0.5, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.0),\n374\t                (Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 988.0) }, 0.06),\n375\t                (Patch { decay: 0.6, volume: 0.13, ..Patch::new(Triangle, 1175.0) }, 0.12),\n376\t                (Patch { decay: 0.9, volume: 0.12, ..Patch::new(Sine, 1568.0) }, 0.2),\n377\t            ],\n378\t        },\n379\t        SimEvent::Pickup { .. } => {\n380\t            vec![(Patch { freq_end: 1400.0, glide: 0.06, decay: 0.07, volume: 0.08, ..Patch::new(Triangle, 700.0) }, 0.0)]\n381\t        }\n382\t        SimEvent::Travel { .. } => vec![\n383\t            (Patch { freq_end: 1200.0, glide: 0.5, decay: 0.6, volume: 0.12, ..Patch::new(Sine, 200.0) }, 0.0),\n384\t            (Patch { freq_end: 2400.0, glide: 0.4, decay: 0.5, volume: 0.06, ..Patch::new(Triangle, 600.0) }, 0.1),\n385\t        ],\n386\t        SimEvent::Potion { .. } => {\n387\t            vec![(Patch { freq_end: 700.0, glide: 0.3, decay: 0.3, volume: 0.14, ..Patch::new(Sine, 300.0) }, 0.0)]\n388\t        }\n389\t        SimEvent::Block { .. } => {\n390\t            vec![(Patch { decay: 0.2, volume: 0.2, cutoff: 6000.0, cutoff_end: 3000.0, ..Patch::new(Square, 1200.0) }, 0.0)]\n391\t        }\n392\t        SimEvent::LevelUp { .. } => vec![\n393\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 523.0) }, 0.0),\n394\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 659.0) }, 0.1),\n395\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 784.0) }, 0.2),\n396\t            (Patch { decay: 0.5, volume: 0.18, ..Patch::new(Triangle, 1047.0) }, 0.3),\n397\t        ],\n398\t        SimEvent::Respawn { .. } => vec![\n399\t            (Patch { freq_end: 880.0, glide: 0.18, decay: 0.2, volume: 0.12, ..Patch::new(Sine, 220.0) }, 0.0),\n400\t            (Patch { decay: 0.15, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.16),\n401\t        ],\n402\t        SimEvent::CourseStart { .. } => vec![(Patch { decay: 0.12, volume: 0.14, ..Patch::new(Square, 880.0) }, 0.0)],\n403\t        SimEvent::Gate { ok, .. } => {\n404\t            if *ok {\n405\t                vec![(Patch { decay: 0.1, volume: 0.12, ..Patch::new(Triangle, 1046.5) }, 0.0)]\n406\t            } else {\n407\t                vec![(\n408\t                    Patch { freq_end: 160.0, glide: 0.2, decay: 0.25, volume: 0.14, duty: 0.3, ..Patch::new(Square, 330.0) },\n409\t                    0.0,\n410\t                )]\n411\t            }\n412\t        }\n413\t        SimEvent::CourseFinish { new_best, .. } => {\n414\t            let mut v = vec![\n415\t                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 523.3) }, 0.0),\n416\t                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 659.3) }, 0.1),\n417\t                (Patch { decay: 0.4, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.2),\n418\t            ];\n419\t            if *new_best {\n420\t                v.push((Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 1046.5) }, 0.34));\n421\t            }\n422\t            v\n423\t        }\n424\t        SimEvent::Checkpoint { .. } => vec![\n425\t            (Patch { decay: 0.12, volume: 0.1, ..Patch::new(Sine, 1174.7) }, 0.0),\n426\t            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1568.0) }, 0.07),\n427\t        ],\n428\t        SimEvent::Splash { .. } => vec![(\n429\t            Patch { attack: 0.01, decay: 0.35, volume: 0.25, cutoff: 3000.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) },\n430\t            0.0,\n431\t        )],\n432\t        SimEvent::Pad { .. } => {\n433\t            vec![(Patch { freq_end: 1200.0, glide: 0.08, decay: 0.12, volume: 0.1, ..Patch::new(Sine, 600.0) }, 0.0)]\n434\t        }\n435\t        SimEvent::Grab { .. } => {\n436\t            vec![(Patch { decay: 0.05, volume: 0.12, cutoff: 1500.0, cutoff_end: 600.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n437\t        }\n438\t        SimEvent::Break { .. } => vec![\n439\t            (Patch { decay: 0.18, volume: 0.3, cutoff: 6000.0, cutoff_end: 900.0, ..Patch::new(Noise, 1.0) }, 0.0),\n440\t            (Patch { freq_end: 70.0, glide: 0.15, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 160.0) }, 0.0),\n441\t        ],\n442\t        SimEvent::Crack { .. } => {\n443\t            vec![(Patch { decay: 0.04, volume: 0.12, cutoff: 5000.0, cutoff_end: 2000.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n444\t        }\n445\t        SimEvent::Bounce { .. } => {\n446\t            vec![(Patch { freq_end: 900.0, glide: 0.18, decay: 0.22, volume: 0.16, ..Patch::new(Sine, 180.0) }, 0.0)]\n447\t        }\n448\t        SimEvent::Roll { .. } => vec![(\n449\t            Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 600.0, cutoff_end: 2400.0, ..Patch::new(Noise, 1.0) },\n450\t            0.0,\n451\t        )],\n452\t        SimEvent::Spotted { .. } => vec![\n453\t            (Patch { decay: 0.18, volume: 0.16, ..Patch::new(Square, 990.0) }, 0.0),\n454\t            (Patch { decay: 0.25, volume: 0.16, ..Patch::new(Square, 660.0) }, 0.16),\n455\t        ],\n456\t        SimEvent::Shot { .. } => {\n457\t            vec![(Patch { freq_end: 420.0, glide: 0.06, decay: 0.06, volume: 0.05, ..Patch::new(Square, 1500.0) }, 0.0)]\n458\t        }\n459\t        SimEvent::Damage { .. } => {\n460\t            vec![(Patch { decay: 0.03, volume: 0.08, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n461\t        }\n462\t        SimEvent::Destroyed { size, .. } => {\n463\t            let v = size.clamp(0.4, 2.0);\n464\t            vec![\n465\t                (\n466\t                    Patch {\n467\t                        attack: 0.003,\n468\t                        decay: 0.3,\n469\t                        volume: 0.35 * v,\n470\t                        cutoff: 5000.0,\n471\t                        cutoff_end: 200.0,\n472\t                        ..Patch::new(Noise, 1.0)\n473\t                    },\n474\t                    0.0,\n475\t                ),\n476\t                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.4 * v, ..Patch::new(Sine, 140.0) }, 0.0),\n477\t            ]\n478\t        }\n479\t        _ => Vec::new(),\n480\t    }\n481\t}\n482\t\n483\t/// Position of an event (None = not spatial).\n484\tpub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n485\t    match ev {\n486\t        SimEvent::Jump { pos }\n487\t        | SimEvent::Land { pos, .. }\n488\t        | SimEvent::Step { pos }\n489\t        | SimEvent::Throw { pos }\n490\t        | SimEvent::Explosion { pos, .. }\n491\t        | SimEvent::Impact { pos, .. }\n492\t        | SimEvent::Hit { pos, .. }\n493\t        | SimEvent::Splash { pos }\n494\t        | SimEvent::Grab { pos }\n495\t        | SimEvent::Roll { pos }\n496\t        | SimEvent::Break { pos }\n497\t        | SimEvent::Crack { pos }\n498\t        | SimEvent::Bounce { pos }\n499\t        | SimEvent::Shot { pos }\n500\t        | SimEvent::Damage { pos }\n501\t        | SimEvent::Destroyed { pos, .. }\n502\t        | SimEvent::Swing { pos, .. }\n503\t        | SimEvent::Strike { pos, .. }\n504\t        | SimEvent::Slain { pos, .. }\n505\t        | SimEvent::Slam { pos, .. }\n506\t        | SimEvent::Blast { pos, .. }\n507\t        | SimEvent::Spell { pos, .. }\n508\t        | SimEvent::Coin { pos }\n509\t        | SimEvent::Loot { pos, .. }\n510\t        | SimEvent::Pickup { pos, .. }\n511\t        | SimEvent::Block { pos } => Some(*pos),\n512\t        _ => None,\n513\t    }\n514\t}\n515\t\n516\t/// Plays an event's sounds with distance attenuation and panning.\n517\tpub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n518\t    let (pan, gain) = match event_pos(ev) {\n519\t        Some(p) => {\n520\t            let d = p - l.pos;\n521\t            let dist = d.length();\n522\t            ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + dist / 14.0))\n523\t        }\n524\t        None => (0.0, 1.0),\n525\t    };\n526\t    for (patch, delay) in sounds_for(ev) {\n527\t        mixer.play(patch, pan, gain * sfx, delay);\n528\t    }\n529\t}\n530\t\n531\t/// Renders timed events offline: (time in seconds, event). Returns interleaved stereo.\n532\tpub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n533\t    let mut mixer = Mixer::new(sample_rate);\n534\t    let total = (duration * sample_rate) as usize;\n535\t    let mut out = vec![0.0f32; total * 2];\n536\t    let block = 256;\n537\t    let mut i = 0;\n538\t    let mut ev = events.iter().peekable();\n539\t    while i < total {\n540\t        let t = i as f32 / sample_rate;\n541\t        while let Some((et, e)) = ev.peek() {\n542\t            if *et > t {\n543\t                break;\n544\t            }\n545\t            play_event(&mut mixer, e, l, 1.0);\n546\t            ev.next();\n547\t        }\n548\t        let n = block.min(total - i);\n549\t        mixer.render(&mut out[i * 2..(i + n) * 2]);\n550\t        i += n;\n551\t    }\n552\t    out\n553\t}\n554\t\n555\t/// Writes interleaved stereo f32 samples as a 16-bit PCM WAV file.\n556\tpub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n557\t    let data_len = (samples.len() * 2) as u32;\n558\t    let mut b = Vec::with_capacity(44 + data_len as usize);\n559\t    b.extend_from_slice(b\"RIFF\");\n560\t    b.extend_from_slice(&(36 + data_len).to_le_bytes());\n561\t    b.extend_from_slice(b\"WAVEfmt \");\n562\t    b.extend_from_slice(&16u32.to_le_bytes());\n563\t    b.extend_from_slice(&1u16.to_le_bytes()); // PCM\n564\t    b.extend_from_slice(&2u16.to_le_bytes()); // stereo\n565\t    b.extend_from_slice(&sample_rate.to_le_bytes());\n566\t    b.extend_from_slice(&(sample_rate * 4).to_le_bytes());\n567\t    b.extend_from_slice(&4u16.to_le_bytes());\n568\t    b.extend_from_slice(&16u16.to_le_bytes());\n569\t    b.extend_from_slice(b\"data\");\n570\t    b.extend_from_slice(&data_len.to_le_bytes());\n571\t    for s in samples {\n572\t        b.extend_from_slice(&((s.clamp(-1.0, 1.0) * 32767.0) as i16).to_le_bytes());\n573\t    }\n574\t    if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n575\t        std::fs::create_dir_all(d)?;\n576\t    }\n577\t    std::fs::write(path, b)\n578\t}\n579\t\n580\tenum Cmd {\n581\t    Play(Patch, f32, f32, f32),\n582\t    Master(f32),\n583\t}\n584\t\n585\t/// Live output through the default sound device.\n586\tpub struct AudioOut {\n587\t    _stream: cpal::Stream,\n588\t    tx: Sender<Cmd>,\n589\t    pub sample_rate: u32,\n590\t    pub device: String,\n591\t}\n592\t\n593\timpl AudioOut {\n594\t    pub fn start() -> anyhow::Result<Self> {\n595\t        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n596\t        let host = cpal::default_host();\n597\t        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n598\t        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n599\t        let supported = device.default_output_config()?;\n600\t        let format = supported.sample_format();\n601\t        let config: cpal::StreamConfig = supported.config();\n602\t        let rate = config.sample_rate as u32;\n603\t        let channels = config.channels as usize;\n604\t        let (tx, rx) = channel::<Cmd>();\n605\t        let stream = match format {\n606\t            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n607\t            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n608\t            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n609\t            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n610\t        };\n611\t        stream.play()?;\n612\t        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n613\t    }\n614\t\n615\t    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n616\t        let (pan, gain) = match event_pos(ev) {\n617\t            Some(p) => {\n618\t                let d = p - l.pos;\n619\t                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n620\t            }\n621\t            None => (0.0, 1.0),\n622\t        };\n623\t        for (patch, delay) in sounds_for(ev) {\n624\t            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n625\t        }\n626\t    }\n627\t\n628\t    pub fn set_master(&self, v: f32) {\n629\t        let _ = self.tx.send(Cmd::Master(v));\n630\t    }\n631\t\n632\t    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n633\t    /// so the browser build calls this on the first input.\n634\t    pub fn resume(&self) {\n635\t        use cpal::traits::StreamTrait;\n636\t        let _ = self._stream.play();\n637\t    }\n638\t}\n639\t\n640\tfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\n641\twhere\n642\t    T: cpal::SizedSample + cpal::FromSample<f32>,\n643\t{\n644\t    use cpal::traits::DeviceTrait;\n645\t    let mut mixer = Mixer::new(config.sample_rate as f32);\n646\t    let mut buf: Vec<f32> = Vec::new();\n647\t    let stream = device.build_output_stream::<T, _, _>(\n648\t        config,\n649\t        move |data: &mut [T], _| {\n650\t            while let Ok(c) = rx.try_recv() {\n651\t                match c {\n652\t                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n653\t                    Cmd::Master(v) => mixer.master = v,\n654\t                }\n655\t            }\n656\t            let frames = data.len() / channels.max(1);\n657\t            buf.resize(frames * 2, 0.0);\n658\t            mixer.render(&mut buf);\n659\t            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n660\t                for (c, s) in frame.iter_mut().enumerate() {\n661\t                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n662\t                }\n663\t            }\n664\t        },\n665\t        |e| log::warn!(\"audio stream error: {e}\"),\n666\t        None,\n667\t    )?;\n668\t    Ok(stream)\n669\t}\n670\t\n671\t#[cfg(test)]\n672\tmod tests {\n673\t    use super::*;\n674\t\n675\t    #[test]\n676\t    fn explosion_is_loud_then_silent() {\n677\t        let ev = SimEvent::Explosion { pos: Vec3::ZERO, radius: 1.35 };\n678\t        let out = render_events(&[(0.0, ev)], 2.0, 22050.0, &Listener::default());\n679\t        let peak_early = out[..22050].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n680\t        let peak_late = out[out.len() - 2000..].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n681\t        assert!(peak_early > 0.1, \"audible: {peak_early}\");\n682\t        assert!(peak_late < 1e-3, \"decays: {peak_late}\");\n683\t    }\n684\t}\n685\t"}]},"parent_tool_use_id":null,"session_id":"501e7141-3737-4a8e-9cac-eb3584714d8d","uuid":"7964d2b6-19f6-4583-9705-77df92b5c0da","timestamp":"2026-11-05T04:21:17.425Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211956__x710a06/work/_research/shardfall/crates/pav_audio/src/lib.rs","content":"//! Synthesized sound: every sound is built from oscillators, noise, envelopes, pitch sweeps\n//! and a filter. The mixer runs in the audio callback (cpal) or offline (to .wav). The game\n//! runs fine without a sound device.\n\nuse std::sync::mpsc::{Receiver, Sender, channel};\n\nuse glam::Vec3;\nuse pav_core::SimEvent;\n\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum Wave {\n    Sine,\n    Square,\n    Saw,\n    Triangle,\n    Noise,\n}\n\n/// One synthesized sound.\n#[derive(Clone, Copy, Debug)]\npub struct Patch {\n    pub wave: Wave,\n    /// Start / end frequency (Hz) and the glide time between them (s, exponential).\n    pub freq: f32,\n    pub freq_end: f32,\n    pub glide: f32,\n    pub attack: f32,\n    pub decay: f32,\n    pub sustain: f32,\n    pub hold: f32,\n    pub release: f32,\n    pub volume: f32,\n    /// One-pole low-pass cutoff (Hz) at start and end of the sound.\n    pub cutoff: f32,\n    pub cutoff_end: f32,\n    /// Square-wave duty cycle.\n    pub duty: f32,\n}\n\nimpl Patch {\n    pub const fn new(wave: Wave, freq: f32) -> Self {\n        Self {\n            wave,\n            freq,\n            freq_end: freq,\n            glide: 0.1,\n            attack: 0.002,\n            decay: 0.1,\n            sustain: 0.0,\n            hold: 0.0,\n            release: 0.05,\n            volume: 0.3,\n            cutoff: 12000.0,\n            cutoff_end: 12000.0,\n            duty: 0.5,\n        }\n    }\n    pub fn length(&self) -> f32 {\n        self.attack + self.decay + self.hold + self.release\n    }\n}\n\nstruct Voice {\n    p: Patch,\n    t: f32,\n    delay: f32,\n    phase: f32,\n    lp: f32,\n    noise: u32,\n    gain_l: f32,\n    gain_r: f32,\n}\n\nimpl Voice {\n    fn env(&self) -> f32 {\n        let p = &self.p;\n        let t = self.t;\n        if t < p.attack {\n            return t / p.attack.max(1e-5);\n        }\n        let t = t - p.attack;\n        if t < p.decay {\n            return 1.0 + (p.sustain - 1.0) * (t / p.decay.max(1e-5));\n        }\n        let t = t - p.decay;\n        if t < p.hold {\n            return p.sustain;\n        }\n        let t = t - p.hold;\n        let start = if p.decay > 0.0 || p.hold > 0.0 { p.sustain } else { 1.0 };\n        (start * (1.0 - t / p.release.max(1e-5))).max(0.0)\n    }\n\n    fn done(&self) -> bool {\n        self.t > self.p.length() + 0.01\n    }\n\n    fn next(&mut self, dt: f32) -> f32 {\n        if self.delay > 0.0 {\n            self.delay -= dt;\n            return 0.0;\n        }\n        let p = self.p;\n        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n        self.phase = (self.phase + freq * dt).fract();\n        let ph = self.phase;\n        let raw = match p.wave {\n            Wave::Sine => (ph * std::f32::consts::TAU).sin(),\n            Wave::Square => {\n                if ph < p.duty {\n                    1.0\n                } else {\n                    -1.0\n                }\n            }\n            Wave::Saw => ph * 2.0 - 1.0,\n            Wave::Triangle => 1.0 - 4.0 * (ph - 0.5).abs(),\n            Wave::Noise => {\n                self.noise ^= self.noise << 13;\n                self.noise ^= self.noise >> 17;\n                self.noise ^= self.noise << 5;\n                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n            }\n        };\n        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;\n        self.t += dt;\n        s\n    }\n}\n\n/// Mixes voices into interleaved stereo.\npub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n\nimpl Mixer {\n    pub fn new(sample_rate: f32) -> Self {\n        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n\n    /// pan -1 (left) .. 1 (right); delay in seconds.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\n            // Drop the oldest.\n            self.voices.remove(0);\n        }\n        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n        let pan = pan.clamp(-1.0, 1.0);\n        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n        self.voices.push(Voice {\n            p,\n            t: 0.0,\n            delay,\n            phase: 0.0,\n            lp: 0.0,\n            noise: self.seed | 1,\n            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });\n    }\n\n    /// Renders into an interleaved stereo buffer (overwrites).\n    pub fn render(&mut self, out: &mut [f32]) {\n        let dt = 1.0 / self.sample_rate;\n        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }\n            // Soft clip.\n            let m = self.master;\n            frame[0] = (l * m).tanh();\n            if frame.len() > 1 {\n                frame[1] = (r * m).tanh();\n            }\n        }\n        self.voices.retain(|v| !v.done());\n    }\n\n    pub fn active(&self) -> usize {\n        self.voices.len()\n    }\n}\n\n/// Where the ears are: position and the camera's right vector (for panning).\n#[derive(Clone, Copy, Debug)]\npub struct Listener {\n    pub pos: Vec3,\n    pub right: Vec3,\n}\n\nimpl Default for Listener {\n    fn default() -> Self {\n        Self { pos: Vec3::ZERO, right: Vec3::X }\n    }\n}\n\n/// The sound bank: which patches play for a simulation event.\npub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n    use Wave::*;\n    match ev {\n        SimEvent::Jump { .. } => vec![(\n            Patch {\n                freq_end: 640.0,\n                glide: 0.11,\n                decay: 0.12,\n                volume: 0.18,\n                cutoff: 3500.0,\n                cutoff_end: 2500.0,\n                duty: 0.3,\n                ..Patch::new(Square, 280.0)\n            },\n            0.0,\n        )],\n        SimEvent::Land { speed, .. } => {\n            let v = (speed / 14.0).clamp(0.15, 1.0);\n            vec![\n                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n            ]\n        }\n        SimEvent::Step { .. } => {\n            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Throw { .. } => vec![(\n            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Explosion { radius, .. } => {\n            let v = (radius / 1.35).clamp(0.5, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.004,\n                        decay: 0.25,\n                        sustain: 0.35,\n                        hold: 0.1,\n                        release: 0.6,\n                        volume: 0.6 * v,\n                        cutoff: 4000.0,\n                        cutoff_end: 120.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n            ]\n        }\n        SimEvent::EnterRoom { .. } => vec![\n            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n        ],\n        SimEvent::Hit { strength, .. } => {\n            let v = (strength / 8.0).clamp(0.4, 1.2);\n            vec![\n                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n                    0.0,\n                ),\n            ]\n        }\n        // Shardfall.\n        SimEvent::Swing { heavy, .. } => {\n            let h = if *heavy { 1.4 } else { 1.0 };\n            vec![(\n                Patch {\n                    attack: 0.02,\n                    decay: 0.12 * h,\n                    volume: 0.16 * h,\n                    cutoff: 1800.0,\n                    cutoff_end: 5200.0,\n                    ..Patch::new(Noise, 1.0)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Strike { power, element, crit, .. } => {\n            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n            let mut out = vec![\n                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch {\n                        freq_end: tone * 0.5,\n                        glide: 0.08,\n                        decay: 0.1,\n                        volume: 0.2 * v,\n                        duty: 0.35,\n                        ..Patch::new(Square, tone)\n                    },\n                    0.0,\n                ),\n            ];\n            if *crit {\n                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n            }\n            out\n        }\n        SimEvent::Slain { size, .. } => {\n            let k = size.clamp(0.3, 1.5);\n            vec![\n                (\n                    Patch {\n                        freq_end: 60.0,\n                        glide: 0.3,\n                        decay: 0.3,\n                        volume: 0.22 * k,\n                        duty: 0.5,\n                        ..Patch::new(Square, 180.0 / k)\n                    },\n                    0.0,\n                ),\n                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n            ]\n        }\n        SimEvent::Slam { radius, .. } => {\n            let k = (radius / 2.5).clamp(0.6, 1.5);\n            vec![\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.45 * k, ..Patch::new(Sine, 110.0) }, 0.0),\n                (Patch { decay: 0.3, volume: 0.3 * k, cutoff: 2200.0, cutoff_end: 150.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            ]\n        }\n        SimEvent::Blast { element, .. } => {\n            let cut = [2500.0, 3500.0, 6000.0, 8000.0, 2000.0][(*element as usize).min(4)];\n            vec![\n                (\n                    Patch { attack: 0.003, decay: 0.3, volume: 0.35, cutoff: cut, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) },\n                    0.0,\n                ),\n                (Patch { freq_end: 50.0, glide: 0.25, decay: 0.3, volume: 0.25, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        SimEvent::Spell { element, .. } => {\n            let f = [300.0, 260.0, 900.0, 1400.0, 420.0][(*element as usize).min(4)];\n            vec![(\n                Patch {\n                    freq_end: f * 1.8,\n                    glide: 0.15,\n                    attack: 0.02,\n                    decay: 0.18,\n                    volume: 0.12,\n                    duty: 0.25,\n                    ..Patch::new(Saw, f)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Coin { .. } => vec![\n            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 1980.0) }, 0.0),\n            (Patch { decay: 0.12, volume: 0.09, ..Patch::new(Triangle, 2640.0) }, 0.05),\n        ],\n        // Drops chime by rarity: rares ring, uniques ring a chord.\n        SimEvent::Loot { rarity, .. } => match rarity {\n            0 => vec![(Patch { decay: 0.05, volume: 0.05, cutoff: 2500.0, ..Patch::new(Triangle, 880.0) }, 0.0)],\n            1 => vec![(Patch { decay: 0.12, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.0)],\n            2 => vec![\n                (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 1568.0) }, 0.0),\n                (Patch { decay: 0.35, volume: 0.1, ..Patch::new(Sine, 2093.0) }, 0.08),\n            ],\n            _ => vec![\n                (Patch { decay: 0.5, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.0),\n                (Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 988.0) }, 0.06),\n                (Patch { decay: 0.6, volume: 0.13, ..Patch::new(Triangle, 1175.0) }, 0.12),\n                (Patch { decay: 0.9, volume: 0.12, ..Patch::new(Sine, 1568.0) }, 0.2),\n            ],\n        },\n        SimEvent::Pickup { .. } => {\n            vec![(Patch { freq_end: 1400.0, glide: 0.06, decay: 0.07, volume: 0.08, ..Patch::new(Triangle, 700.0) }, 0.0)]\n        }\n        SimEvent::Travel { .. } => vec![\n            (Patch { freq_end: 1200.0, glide: 0.5, decay: 0.6, volume: 0.12, ..Patch::new(Sine, 200.0) }, 0.0),\n            (Patch { freq_end: 2400.0, glide: 0.4, decay: 0.5, volume: 0.06, ..Patch::new(Triangle, 600.0) }, 0.1),\n        ],\n        SimEvent::Potion { .. } => {\n            vec![(Patch { freq_end: 700.0, glide: 0.3, decay: 0.3, volume: 0.14, ..Patch::new(Sine, 300.0) }, 0.0)]\n        }\n        SimEvent::Block { .. } => {\n            vec![(Patch { decay: 0.2, volume: 0.2, cutoff: 6000.0, cutoff_end: 3000.0, ..Patch::new(Square, 1200.0) }, 0.0)]\n        }\n        SimEvent::LevelUp { .. } => vec![\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 523.0) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 659.0) }, 0.1),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 784.0) }, 0.2),\n            (Patch { decay: 0.5, volume: 0.18, ..Patch::new(Triangle, 1047.0) }, 0.3),\n        ],\n        SimEvent::Respawn { .. } => vec![\n            (Patch { freq_end: 880.0, glide: 0.18, decay: 0.2, volume: 0.12, ..Patch::new(Sine, 220.0) }, 0.0),\n            (Patch { decay: 0.15, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.16),\n        ],\n        SimEvent::CourseStart { .. } => vec![(Patch { decay: 0.12, volume: 0.14, ..Patch::new(Square, 880.0) }, 0.0)],\n        SimEvent::Gate { ok, .. } => {\n            if *ok {\n                vec![(Patch { decay: 0.1, volume: 0.12, ..Patch::new(Triangle, 1046.5) }, 0.0)]\n            } else {\n                vec![(\n                    Patch { freq_end: 160.0, glide: 0.2, decay: 0.25, volume: 0.14, duty: 0.3, ..Patch::new(Square, 330.0) },\n                    0.0,\n                )]\n            }\n        }\n        SimEvent::CourseFinish { new_best, .. } => {\n            let mut v = vec![\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 523.3) }, 0.0),\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 659.3) }, 0.1),\n                (Patch { decay: 0.4, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.2),\n            ];\n            if *new_best {\n                v.push((Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 1046.5) }, 0.34));\n            }\n            v\n        }\n        SimEvent::Checkpoint { .. } => vec![\n            (Patch { decay: 0.12, volume: 0.1, ..Patch::new(Sine, 1174.7) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1568.0) }, 0.07),\n        ],\n        SimEvent::Splash { .. } => vec![(\n            Patch { attack: 0.01, decay: 0.35, volume: 0.25, cutoff: 3000.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Pad { .. } => {\n            vec![(Patch { freq_end: 1200.0, glide: 0.08, decay: 0.12, volume: 0.1, ..Patch::new(Sine, 600.0) }, 0.0)]\n        }\n        SimEvent::Grab { .. } => {\n            vec![(Patch { decay: 0.05, volume: 0.12, cutoff: 1500.0, cutoff_end: 600.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Break { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.3, cutoff: 6000.0, cutoff_end: 900.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            (Patch { freq_end: 70.0, glide: 0.15, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 160.0) }, 0.0),\n        ],\n        SimEvent::Crack { .. } => {\n            vec![(Patch { decay: 0.04, volume: 0.12, cutoff: 5000.0, cutoff_end: 2000.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Bounce { .. } => {\n            vec![(Patch { freq_end: 900.0, glide: 0.18, decay: 0.22, volume: 0.16, ..Patch::new(Sine, 180.0) }, 0.0)]\n        }\n        SimEvent::Roll { .. } => vec![(\n            Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 600.0, cutoff_end: 2400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Spotted { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.16, ..Patch::new(Square, 990.0) }, 0.0),\n            (Patch { decay: 0.25, volume: 0.16, ..Patch::new(Square, 660.0) }, 0.16),\n        ],\n        SimEvent::Shot { .. } => {\n            vec![(Patch { freq_end: 420.0, glide: 0.06, decay: 0.06, volume: 0.05, ..Patch::new(Square, 1500.0) }, 0.0)]\n        }\n        SimEvent::Damage { .. } => {\n            vec![(Patch { decay: 0.03, volume: 0.08, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Destroyed { size, .. } => {\n            let v = size.clamp(0.4, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.003,\n                        decay: 0.3,\n                        volume: 0.35 * v,\n                        cutoff: 5000.0,\n                        cutoff_end: 200.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.4 * v, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        _ => Vec::new(),\n    }\n}\n\n/// Position of an event (None = not spatial).\npub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n    match ev {\n        SimEvent::Jump { pos }\n        | SimEvent::Land { pos, .. }\n        | SimEvent::Step { pos }\n        | SimEvent::Throw { pos }\n        | SimEvent::Explosion { pos, .. }\n        | SimEvent::Impact { pos, .. }\n        | SimEvent::Hit { pos, .. }\n        | SimEvent::Splash { pos }\n        | SimEvent::Grab { pos }\n        | SimEvent::Roll { pos }\n        | SimEvent::Break { pos }\n        | SimEvent::Crack { pos }\n        | SimEvent::Bounce { pos }\n        | SimEvent::Shot { pos }\n        | SimEvent::Damage { pos }\n        | SimEvent::Destroyed { pos, .. }\n        | SimEvent::Swing { pos, .. }\n        | SimEvent::Strike { pos, .. }\n        | SimEvent::Slain { pos, .. }\n        | SimEvent::Slam { pos, .. }\n        | SimEvent::Blast { pos, .. }\n        | SimEvent::Spell { pos, .. }\n        | SimEvent::Coin { pos }\n        | SimEvent::Loot { pos, .. }\n        | SimEvent::Pickup { pos, .. }\n        | SimEvent::Block { pos } => Some(*pos),\n        _ => None,\n    }\n}\n\n/// Plays an event's sounds with distance attenuation and panning.\npub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n    let (pan, gain) = match event_pos(ev) {\n        Some(p) => {\n            let d = p - l.pos;\n            let dist = d.length();\n            ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + dist / 14.0))\n        }\n        None => (0.0, 1.0),\n    };\n    for (patch, delay) in sounds_for(ev) {\n        mixer.play(patch, pan, gain * sfx, delay);\n    }\n}\n\n/// Renders timed events offline: (time in seconds, event). Returns interleaved stereo.\npub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n    let mut mixer = Mixer::new(sample_rate);\n    let total = (duration * sample_rate) as usize;\n    let mut out = vec![0.0f32; total * 2];\n    let block = 256;\n    let mut i = 0;\n    let mut ev = events.iter().peekable();\n    while i < total {\n        let t = i as f32 / sample_rate;\n        while let Some((et, e)) = ev.peek() {\n            if *et > t {\n                break;\n            }\n            play_event(&mut mixer, e, l, 1.0);\n            ev.next();\n        }\n        let n = block.min(total - i);\n        mixer.render(&mut out[i * 2..(i + n) * 2]);\n        i += n;\n    }\n    out\n}\n\n/// Writes interleaved stereo f32 samples as a 16-bit PCM WAV file.\npub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n    let data_len = (samples.len() * 2) as u32;\n    let mut b = Vec::with_capacity(44 + data_len as usize);\n    b.extend_from_slice(b\"RIFF\");\n    b.extend_from_slice(&(36 + data_len).to_le_bytes());\n    b.extend_from_slice(b\"WAVEfmt \");\n    b.extend_from_slice(&16u32.to_le_bytes());\n    b.extend_from_slice(&1u16.to_le_bytes()); // PCM\n    b.extend_from_slice(&2u16.to_le_bytes()); // stereo\n    b.extend_from_slice(&sample_rate.to_le_bytes());\n    b.extend_from_slice(&(sample_rate * 4).to_le_bytes());\n    b.extend_from_slice(&4u16.to_le_bytes());\n    b.extend_from_slice(&16u16.to_le_bytes());\n    b.extend_from_slice(b\"data\");\n    b.extend_from_slice(&data_len.to_le_bytes());\n    for s in samples {\n        b.extend_from_slice(&((s.clamp(-1.0, 1.0) * 32767.0) as i16).to_le_bytes());\n    }\n    if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n        std::fs::create_dir_all(d)?;\n    }\n    std::fs::write(path, b)\n}\n\nenum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}\n\n/// Live output through the default sound device.\npub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}\n\nimpl AudioOut {\n    pub fn start() -> anyhow::Result<Self> {\n        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n        let host = cpal::default_host();\n        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n        let supported = device.default_output_config()?;\n        let format = supported.sample_format();\n        let config: cpal::StreamConfig = supported.config();\n        let rate = config.sample_rate as u32;\n        let channels = config.channels as usize;\n        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        let (pan, gain) = match event_pos(ev) {\n            Some(p) => {\n                let d = p - l.pos;\n                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n            }\n            None => (0.0, 1.0),\n        };\n        for (patch, delay) in sounds_for(ev) {\n            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n        }\n    }\n\n    pub fn set_master(&self, v: f32) {\n        let _ = self.tx.send(Cmd::Master(v));\n    }\n\n    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n    /// so the browser build calls this on the first input.\n    pub fn resume(&self) {\n        use cpal::traits::StreamTrait;\n        let _ = self._stream.play();\n    }\n}\n\nfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\nwhere\n    T: cpal::SizedSample + cpal::FromSample<f32>,\n{\n    use cpal::traits::DeviceTrait;\n    let mut mixer = Mixer::new(config.sample_rate as f32);\n    let mut buf: Vec<f32> = Vec::new();\n    let stream = device.build_output_stream::<T, _, _>(\n        config,\n        move |data: &mut [T], _| {\n            while let Ok(c) = rx.try_recv() {\n                match c {\n                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                }\n            }\n            let frames = data.len() / channels.max(1);\n            buf.resize(frames * 2, 0.0);\n            mixer.render(&mut buf);\n            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n                for (c, s) in frame.iter_mut().enumerate() {\n                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n                }\n            }\n        },\n        |e| log::warn!(\"audio stream error: {e}\"),\n        None,\n    )?;\n    Ok(stream)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn explosion_is_loud_then_silent() {\n        let ev = SimEvent::Explosion { pos: Vec3::ZERO, radius: 1.35 };\n        let out = render_events(&[(0.0, ev)], 2.0, 22050.0, &Listener::default());\n        let peak_early = out[..22050].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        let peak_late = out[out.len() - 2000..].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        assert!(peak_early > 0.1, \"audible: {peak_early}\");\n        assert!(peak_late < 1e-3, \"decays: {peak_late}\");\n    }\n}\n","numLines":685,"startLine":1,"totalLines":685}},"tool_result_meta":[{"id":"toolu_01PxsP7HGMHuX9yBpiwFxvFn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj97CRCDXN9qk1VU47WF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RghMPgj8hqku1oqtnUyzWo","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211956__x710a06/work/_research/shardfall/crates/pav_app/src/hud.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":49359,"cache_read_input_tokens":65519,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":49359},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"501e7141-3737-4a8e-9cac-eb3584714d8d","uuid":"503fdcba-8fa4-44da-9173-041378fd553b","timestamp":"2026-11-05T04:21:18.704Z","request_id":"req_011Cgj97CAZsUiXC5hncEWfZ","wire_tool_inputs":{"toolu_01RghMPgj8hqku1oqtnUyzWo":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211956__x710a06/work/_research/shardfall/crates/pav_app/src/hud.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RghMPgj8hqku1oqtnUyzWo","type":"tool_result","content":"1\t//! Game HUD: course timer and results, short messages, the feel-metrics overlay (with live\n2\t//! input-latency measurement), camera cues from the level, and the hit flash.\n3\t\n4\tuse std::collections::VecDeque;\n5\tuse std::sync::Arc;\n6\tuse std::time::Duration;\n7\t\n8\tuse web_time::Instant;\n9\t\n10\tuse egui::{Color32, RichText};\n11\tuse pav_core::character::MovementModel;\n12\tuse pav_core::frame::HudFrame;\n13\tuse pav_core::params::{self, ChoiceParam, ParamValue};\n14\tuse pav_core::sim::TickRate;\n15\tuse pav_core::zones::CameraCue;\n16\tuse pav_view::{CameraParams, CameraRig};\n17\t\n18\t/// One measured press: OS event -> simulation tick -> frame on screen.\n19\t#[derive(Clone, Copy, Debug)]\n20\tpub struct LatencySample {\n21\t    pub to_tick: f32,\n22\t    pub to_screen: f32,\n23\t}\n24\t\n25\t/// Input latency measurement (the app owns the clock of input events).\n26\t#[derive(Default)]\n27\tpub struct Latency {\n28\t    /// Press waiting to be handed to the simulation.\n29\t    pub pending: Option<Instant>,\n30\t    pub samples: VecDeque<LatencySample>,\n31\t}\n32\t\n33\timpl Latency {\n34\t    pub fn press(&mut self) {\n35\t        self.pending.get_or_insert_with(Instant::now);\n36\t    }\n37\t    pub fn record(&mut self, s: LatencySample) {\n38\t        self.samples.push_back(s);\n39\t        while self.samples.len() > 30 {\n40\t            self.samples.pop_front();\n41\t        }\n42\t    }\n43\t    fn stats(&self) -> Option<(f32, f32, f32, f32)> {\n44\t        let n = self.samples.len();\n45\t        if n == 0 {\n46\t            return None;\n47\t        }\n48\t        let tick = self.samples.iter().map(|s| s.to_tick).sum::<f32>() / n as f32;\n49\t        let total: Vec<f32> = self.samples.iter().map(|s| s.to_tick + s.to_screen).collect();\n50\t        let avg = total.iter().sum::<f32>() / n as f32;\n51\t        let min = total.iter().copied().fold(f32::MAX, f32::min);\n52\t        let max = total.iter().copied().fold(0.0, f32::max);\n53\t        Some((avg, tick, min, max))\n54\t    }\n55\t}\n56\t\n57\t/// Applies camera cues (pads, camera zones) on top of the room's camera, with sweeps.\n58\t#[derive(Default)]\n59\tpub struct CameraDirector {\n60\t    serial: u64,\n61\t    base: Option<CameraParams>,\n62\t    cue: Option<Arc<CameraCue>>,\n63\t    start: Option<Instant>,\n64\t    quarters: u8,\n65\t}\n66\t\n67\tfn set_camera_value(p: &mut CameraParams, key: &str, v: f32, quarters: u8) {\n68\t    let v = if key == \"yaw\" { ((v + quarters as f32 * 90.0 + 540.0).rem_euclid(360.0)) - 180.0 } else { v };\n69\t    let _ = params::set(p, key, ParamValue::Float(v as f64));\n70\t}\n71\t\n72\timpl CameraDirector {\n73\t    pub fn update(&mut self, hud: &HudFrame, quarters: u8, rig: &mut CameraRig) {\n74\t        if hud.cue_serial != self.serial {\n75\t            self.serial = hud.cue_serial;\n76\t            match &hud.cue {\n77\t                Some(c) => {\n78\t                    let base = self.base.get_or_insert_with(|| rig.params.clone()).clone();\n79\t                    rig.blend_from_current(0.7);\n80\t                    let mut p = base;\n81\t                    for (k, v) in &c.set {\n82\t                        match v.as_f64() {\n83\t                            Some(f) if k != \"ortho\" => set_camera_value(&mut p, k, f as f32, quarters),\n84\t                            _ => {\n85\t                                let _ = params::set(&mut p, k, v.clone());\n86\t                            }\n87\t                        }\n88\t                    }\n89\t                    rig.params = p;\n90\t                    self.cue = Some(c.clone());\n91\t                    self.start = Some(Instant::now());\n92\t                    self.quarters = quarters;\n93\t                }\n94\t                None => {\n95\t                    if let Some(b) = self.base.take() {\n96\t                        rig.blend_from_current(0.7);\n97\t                        rig.params = b;\n98\t                    }\n99\t                    self.cue = None;\n100\t                }\n101\t            }\n102\t        }\n103\t        let Some(c) = &self.cue else { return };\n104\t        let t = self.start.map(|s| s.elapsed().as_secs_f32()).unwrap_or(0.0);\n105\t        for sw in &c.sweep {\n106\t            let u = (t / sw.period.max(0.1) + sw.phase) * std::f32::consts::TAU;\n107\t            let v = sw.from + (sw.to - sw.from) * (0.5 - 0.5 * u.cos());\n108\t            set_camera_value(&mut rig.params, &sw.param, v, self.quarters);\n109\t        }\n110\t        if c.flip_ortho > 0.0 {\n111\t            let base = c.set.get(\"ortho\").and_then(|v| v.as_bool()).unwrap_or(false);\n112\t            rig.params.ortho = base ^ (((t / c.flip_ortho) as i64) % 2 == 1);\n113\t        }\n114\t    }\n115\t}\n116\t\n117\t/// Speed history for the feel overlay graph.\n118\t#[derive(Default)]\n119\tpub struct FeelOverlay {\n120\t    pub open: bool,\n121\t    /// Opened automatically by the current room.\n122\t    pub auto: bool,\n123\t    speed: VecDeque<f32>,\n124\t    last_tick: u64,\n125\t}\n126\t\n127\tpub struct HudCtx<'a> {\n128\t    pub hud: &'a HudFrame,\n129\t    pub tick: u64,\n130\t    pub dt: f32,\n131\t}\n132\t\n133\t/// Course timer, results and level messages (top centre).\n134\tpub fn course_hud(ctx: &egui::Context, h: &HudCtx) {\n135\t    let ago = |tick: u64| h.tick.saturating_sub(tick) as f32 * h.dt;\n136\t    let result = h.hud.last_result.as_ref().filter(|r| ago(r.tick) < 6.0);\n137\t    let msg = h.hud.message.as_ref().filter(|(_, t)| ago(*t) < 2.5);\n138\t    if h.hud.course.is_none() && result.is_none() && msg.is_none() && h.hud.boss.is_none() {\n139\t        return;\n140\t    }\n141\t    egui::Area::new(egui::Id::new(\"course_hud\")).anchor(egui::Align2::CENTER_TOP, [0.0, 10.0]).show(ctx, |ui| {\n142\t        egui::Frame::popup(ui.style()).show(ui, |ui| {\n143\t            ui.vertical_centered(|ui| {\n144\t                if let Some(c) = &h.hud.course {\n145\t                    ui.horizontal(|ui| {\n146\t                        ui.label(RichText::new(c.course.to_uppercase()).strong());\n147\t                        let t = if c.running { format!(\"{:6.2} s\", c.time) } else { \"ready\".into() };\n148\t                        ui.label(RichText::new(t).monospace().size(22.0).strong());\n149\t                        if c.gates_total > 0 {\n150\t                            ui.label(format!(\"gates {}/{}\", c.gates_passed, c.gates_total));\n151\t                        }\n152\t                        if c.missed > 0 {\n153\t                            ui.label(RichText::new(format!(\"missed {}\", c.missed)).color(Color32::from_rgb(255, 170, 90)));\n154\t                        }\n155\t                        if c.hits > 0 {\n156\t                            ui.label(RichText::new(format!(\"hits {}\", c.hits)).color(Color32::from_rgb(255, 120, 110)));\n157\t                        }\n158\t                        if c.falls > 0 {\n159\t                            ui.label(format!(\"falls {}\", c.falls));\n160\t                        }\n161\t                        if c.score > 0 {\n162\t                            ui.label(\n163\t                                RichText::new(format!(\"score {}\", c.score)).color(Color32::from_rgb(140, 220, 255)).strong(),\n164\t                            );\n165\t                        }\n166\t                        if let Some(b) = c.best {\n167\t                            ui.label(RichText::new(format!(\"best {b:.2} s\")).weak());\n168\t                        }\n169\t                    });\n170\t                }\n171\t                if let Some(r) = result {\n172\t                    let mut line = format!(\"{}  {:.2} s\", r.course.to_uppercase(), r.time);\n173\t                    if r.missed > 0 {\n174\t                        line += &format!(\"  (+{:.0} s: {} missed)\", r.missed as f32 * pav_core::course::GATE_PENALTY, r.missed);\n175\t                    }\n176\t                    ui.label(RichText::new(line).size(20.0).strong());\n177\t                    let mut sub = Vec::new();\n178\t                    if r.hits > 0 {\n179\t                        sub.push(format!(\"{} hits\", r.hits));\n180\t                    }\n181\t                    if r.falls > 0 {\n182\t                        sub.push(format!(\"{} falls\", r.falls));\n183\t                    }\n184\t                    if r.score > 0 {\n185\t                        sub.push(format!(\"score {}\", r.score));\n186\t                    }\n187\t                    if r.new_best {\n188\t                        ui.label(RichText::new(\"NEW BEST\").color(Color32::from_rgb(255, 215, 90)).strong());\n189\t                    } else {\n190\t                        sub.push(format!(\"best {:.2} s\", r.best));\n191\t                    }\n192\t                    if !sub.is_empty() {\n193\t                        ui.label(sub.join(\" · \"));\n194\t                    }\n195\t                }\n196\t                if let Some((m, _)) = msg {\n197\t                    ui.label(RichText::new(m).color(Color32::from_rgb(255, 220, 140)).strong());\n198\t                }\n199\t                if let Some((name, f)) = &h.hud.boss {\n200\t                    // Boss health bar.\n201\t                    ui.label(RichText::new(name.to_uppercase()).strong().color(Color32::from_rgb(255, 140, 120)));\n202\t                    let (rect, _) = ui.allocate_exact_size(egui::vec2(320.0, 12.0), egui::Sense::hover());\n203\t                    ui.painter().rect_filled(rect, 3.0, Color32::from_gray(40));\n204\t                    let mut fill = rect;\n205\t                    fill.set_width(rect.width() * f.clamp(0.0, 1.0));\n206\t                    ui.painter().rect_filled(fill, 3.0, Color32::from_rgb(230, 70, 60));\n207\t                }\n208\t            });\n209\t        });\n210\t    });\n211\t}\n212\t\n213\t/// Red screen-edge flash while the player is invulnerable after a hit.\n214\tpub fn hit_flash(ctx: &egui::Context, invuln: f32) {\n215\t    if invuln <= 0.0 {\n216\t        return;\n217\t    }\n218\t    let a = (invuln / 0.6).clamp(0.0, 1.0);\n219\t    let rect = ctx.content_rect();\n220\t    let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Background, egui::Id::new(\"hit_flash\")));\n221\t    let w = 18.0 + 30.0 * a;\n222\t    let c = Color32::from_rgba_unmultiplied(230, 40, 30, (110.0 * a) as u8);\n223\t    painter.rect_stroke(rect.shrink(w * 0.5), 0.0, egui::Stroke::new(w, c), egui::StrokeKind::Middle);\n224\t}\n225\t\n226\tpub struct FeelSettings<'a> {\n227\t    pub model: &'a mut MovementModel,\n228\t    pub tick_rate: &'a mut TickRate,\n229\t    pub vsync: &'a mut bool,\n230\t    pub smoothing: &'a mut bool,\n231\t}\n232\t\n233\timpl FeelOverlay {\n234\t    pub fn record(&mut self, tick: u64, speed: f32) {\n235\t        if tick != self.last_tick {\n236\t            self.last_tick = tick;\n237\t            self.speed.push_back(speed);\n238\t            while self.speed.len() > 240 {\n239\t                self.speed.pop_front();\n240\t            }\n241\t        }\n242\t    }\n243\t\n244\t    /// The overlay window (right side). Returns true if it is open.\n245\t    pub fn ui(&mut self, ctx: &egui::Context, h: &HudCtx, lat: &Latency, s: FeelSettings) {\n246\t        if !self.open {\n247\t            return;\n248\t        }\n249\t        let f = &h.hud.feel;\n250\t        let mut open = self.open;\n251\t        egui::Window::new(\"Feel metrics\")\n252\t            .id(egui::Id::new(\"feel_overlay\"))\n253\t            .open(&mut open)\n254\t            .anchor(egui::Align2::RIGHT_BOTTOM, [-12.0, -40.0])\n255\t            .resizable(false)\n256\t            .collapsible(true)\n257\t            .default_width(300.0)\n258\t            .show(ctx, |ui| {\n259\t                egui::Grid::new(\"feel_grid\").num_columns(2).show(ui, |ui| {\n260\t                    ui.label(\"Movement model\");\n261\t                    let mut i = s.model.to_index();\n262\t                    egui::ComboBox::from_id_salt(\"feel_model\").selected_text(MovementModel::NAMES[i]).show_ui(ui, |ui| {\n263\t                        for (k, n) in MovementModel::NAMES.iter().enumerate() {\n264\t                            ui.selectable_value(&mut i, k, *n);\n265\t                        }\n266\t                    });\n267\t                    *s.model = MovementModel::from_index(i);\n268\t                    ui.end_row();\n269\t                    ui.label(\"Tick rate\");\n270\t                    let mut t = s.tick_rate.to_index();\n271\t                    ui.horizontal(|ui| {\n272\t                        for (k, n) in TickRate::NAMES.iter().enumerate() {\n273\t                            ui.selectable_value(&mut t, k, format!(\"{n} Hz\"));\n274\t                        }\n275\t                    });\n276\t                    *s.tick_rate = TickRate::from_index(t);\n277\t                    ui.end_row();\n278\t                    ui.label(\"Display\");\n279\t                    ui.horizontal(|ui| {\n280\t                        ui.checkbox(s.vsync, \"vsync\");\n281\t                        ui.checkbox(s.smoothing, \"smoothing\");\n282\t                    });\n283\t                    ui.end_row();\n284\t                    ui.label(\"Input delay\");\n285\t                    match lat.stats() {\n286\t                        Some((avg, tick, min, max)) => {\n287\t                            ui.label(\n288\t                                RichText::new(format!(\"{avg:.0} ms  ({min:.0}–{max:.0})\"))\n289\t                                    .monospace()\n290\t                                    .strong(),\n291\t                            )\n292\t                            .on_hover_text(format!(\n293\t                                \"Key press to simulation tick: {tick:.1} ms, then to frame submitted: {:.1} ms.\\nThe display adds its own scan-out time on top.\",\n294\t                                avg - tick\n295\t                            ));\n296\t                        }\n297\t                        None => {\n298\t                            ui.label(RichText::new(\"press a key\").weak());\n299\t                        }\n300\t                    }\n301\t                    ui.end_row();\n302\t                    let ms = h.dt * 1000.0;\n303\t                    ui.label(\"Response\");\n304\t                    ui.label(format!(\"{} tick{} ({:.0} ms)\", f.response_ticks, if f.response_ticks == 1 { \"\" } else { \"s\" }, f.response_ticks as f32 * ms));\n305\t                    ui.end_row();\n306\t                    ui.label(\"Speed\");\n307\t                    ui.label(RichText::new(format!(\"{:.2} m/s  (top {:.2})\", f.speed, f.top_speed)).monospace());\n308\t                    ui.end_row();\n309\t                    ui.label(\"To top speed\");\n310\t                    ui.label(RichText::new(format!(\"{:.0} ms\", f.accel_ms)).monospace());\n311\t                    ui.end_row();\n312\t                    ui.label(\"Stop\");\n313\t                    ui.label(RichText::new(format!(\"{:.0} ms · {:.2} m\", f.stop_ms, f.stop_dist)).monospace());\n314\t                    ui.end_row();\n315\t                    ui.label(\"Turnaround\");\n316\t                    ui.label(RichText::new(format!(\"{:.0} ms\", f.turn_ms)).monospace());\n317\t                    ui.end_row();\n318\t                    ui.label(\"Last jump\");\n319\t                    ui.label(\n320\t                        RichText::new(format!(\"{:.2} m high · {:.0} ms · {:.1} m\", f.jump_height, f.air_ms, f.jump_dist)).monospace(),\n321\t                    );\n322\t                    ui.end_row();\n323\t                });\n324\t                // Speed over the last few seconds.\n325\t                let (rect, _) = ui.allocate_exact_size(egui::vec2(ui.available_width().max(260.0), 54.0), egui::Sense::hover());\n326\t                let painter = ui.painter_at(rect);\n327\t                painter.rect_filled(rect, 3.0, Color32::from_black_alpha(60));\n328\t                let max = self.speed.iter().copied().fold(1.0, f32::max) * 1.1;\n329\t                let n = self.speed.len().max(2);\n330\t                let pts: Vec<egui::Pos2> = self\n331\t                    .speed\n332\t                    .iter()\n333\t                    .enumerate()\n334\t                    .map(|(i, v)| egui::pos2(rect.left() + rect.width() * i as f32 / (n - 1) as f32, rect.bottom() - rect.height() * v / max))\n335\t                    .collect();\n336\t                painter.add(egui::Shape::line(pts, egui::Stroke::new(1.5, Color32::from_rgb(120, 200, 255))));\n337\t                painter.text(rect.left_top() + egui::vec2(4.0, 2.0), egui::Align2::LEFT_TOP, format!(\"speed (max {max:.1} m/s)\"), egui::FontId::proportional(10.0), Color32::from_white_alpha(150));\n338\t            });\n339\t        if !open {\n340\t            self.open = false;\n341\t        }\n342\t        let _ = Duration::ZERO;\n343\t    }\n344\t}\n345\t\n346\t/// Physics counters and simulation cost (stress tests).\n347\t#[derive(Default)]\n348\tpub struct PhysicsOverlay {\n349\t    pub open: bool,\n350\t    pub auto: bool,\n351\t    tick_ms: VecDeque<f32>,\n352\t}\n353\t\n354\timpl PhysicsOverlay {\n355\t    pub fn ui(&mut self, ctx: &egui::Context, h: &HudCtx, tps: f32, tick_ms: f32) {\n356\t        if !self.open {\n357\t            return;\n358\t        }\n359\t        self.tick_ms.push_back(tick_ms);\n360\t        while self.tick_ms.len() > 240 {\n361\t            self.tick_ms.pop_front();\n362\t        }\n363\t        let p = &h.hud.physics;\n364\t        let budget = h.dt * 1000.0;\n365\t        let mut open = self.open;\n366\t        egui::Window::new(\"Physics\")\n367\t            .id(egui::Id::new(\"physics_overlay\"))\n368\t            .open(&mut open)\n369\t            .anchor(egui::Align2::RIGHT_TOP, [-12.0, 110.0])\n370\t            .resizable(false)\n371\t            .default_width(280.0)\n372\t            .show(ctx, |ui| {\n373\t                let load = tick_ms / budget.max(1e-3);\n374\t                let color = if load < 0.5 {\n375\t                    Color32::from_rgb(120, 220, 140)\n376\t                } else if load < 0.9 {\n377\t                    Color32::from_rgb(255, 210, 90)\n378\t                } else {\n379\t                    Color32::from_rgb(255, 110, 100)\n380\t                };\n381\t                ui.label(RichText::new(format!(\"{tps:.0} ticks/s\")).size(26.0).strong().color(color));\n382\t                ui.label(format!(\"{tick_ms:.2} ms per tick ({:.0}% of the {budget:.1} ms budget)\", load * 100.0));\n383\t                egui::Grid::new(\"physics_grid\").num_columns(2).show(ui, |ui| {\n384\t                    let mut row = |k: &str, v: String| {\n385\t                        ui.label(k);\n386\t                        ui.label(RichText::new(v).monospace());\n387\t                        ui.end_row();\n388\t                    };\n389\t                    row(\"Moving bodies\", format!(\"{} ({} asleep)\", p.dynamic, p.sleeping));\n390\t                    row(\"Colliders\", p.colliders.to_string());\n391\t                    row(\"Contacts\", p.contacts.to_string());\n392\t                    row(\"Joints\", p.joints.to_string());\n393\t                    row(\"Soft bodies\", format!(\"{} ({} particles)\", p.soft_bodies, p.particles));\n394\t                    row(\"Projectiles\", p.projectiles.to_string());\n395\t                });\n396\t                let (rect, _) = ui.allocate_exact_size(egui::vec2(ui.available_width().max(240.0), 50.0), egui::Sense::hover());\n397\t                let painter = ui.painter_at(rect);\n398\t                painter.rect_filled(rect, 3.0, Color32::from_black_alpha(60));\n399\t                let max = self.tick_ms.iter().copied().fold(budget, f32::max) * 1.1;\n400\t                let y = |v: f32| rect.bottom() - rect.height() * v / max;\n401\t                painter.hline(\n402\t                    rect.x_range(),\n403\t                    y(budget),\n404\t                    egui::Stroke::new(1.0, Color32::from_rgba_unmultiplied(255, 120, 100, 120)),\n405\t                );\n406\t                let n = self.tick_ms.len().max(2);\n407\t                let pts: Vec<egui::Pos2> = self\n408\t                    .tick_ms\n409\t                    .iter()\n410\t                    .enumerate()\n411\t                    .map(|(i, v)| egui::pos2(rect.left() + rect.width() * i as f32 / (n - 1) as f32, y(*v)))\n412\t                    .collect();\n413\t                painter.add(egui::Shape::line(pts, egui::Stroke::new(1.5, Color32::from_rgb(120, 200, 255))));\n414\t                painter.text(\n415\t                    rect.left_top() + egui::vec2(4.0, 2.0),\n416\t                    egui::Align2::LEFT_TOP,\n417\t                    \"ms per tick (red line = budget)\",\n418\t                    egui::FontId::proportional(10.0),\n419\t                    Color32::from_white_alpha(150),\n420\t                );\n421\t            });\n422\t        if !open {\n423\t            self.open = false;\n424\t        }\n425\t    }\n426\t}\n427\t"}]},"parent_tool_use_id":null,"session_id":"501e7141-3737-4a8e-9cac-eb3584714d8d","uuid":"aacf913c-0f66-4b70-a27f-4efeb5e2c3c6","timestamp":"2026-11-05T04:21:18.715Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211956__x710a06/work/_research/shardfall/crates/pav_app/src/hud.rs","content":"//! Game HUD: course timer and results, short messages, the feel-metrics overlay (with live\n//! input-latency measurement), camera cues from the level, and the hit flash.\n\nuse std::collections::VecDeque;\nuse std::sync::Arc;\nuse std::time::Duration;\n\nuse web_time::Instant;\n\nuse egui::{Color32, RichText};\nuse pav_core::character::MovementModel;\nuse pav_core::frame::HudFrame;\nuse pav_core::params::{self, ChoiceParam, ParamValue};\nuse pav_core::sim::TickRate;\nuse pav_core::zones::CameraCue;\nuse pav_view::{CameraParams, CameraRig};\n\n/// One measured press: OS event -> simulation tick -> frame on screen.\n#[derive(Clone, Copy, Debug)]\npub struct LatencySample {\n    pub to_tick: f32,\n    pub to_screen: f32,\n}\n\n/// Input latency measurement (the app owns the clock of input events).\n#[derive(Default)]\npub struct Latency {\n    /// Press waiting to be handed to the simulation.\n    pub pending: Option<Instant>,\n    pub samples: VecDeque<LatencySample>,\n}\n\nimpl Latency {\n    pub fn press(&mut self) {\n        self.pending.get_or_insert_with(Instant::now);\n    }\n    pub fn record(&mut self, s: LatencySample) {\n        self.samples.push_back(s);\n        while self.samples.len() > 30 {\n            self.samples.pop_front();\n        }\n    }\n    fn stats(&self) -> Option<(f32, f32, f32, f32)> {\n        let n = self.samples.len();\n        if n == 0 {\n            return None;\n        }\n        let tick = self.samples.iter().map(|s| s.to_tick).sum::<f32>() / n as f32;\n        let total: Vec<f32> = self.samples.iter().map(|s| s.to_tick + s.to_screen).collect();\n        let avg = total.iter().sum::<f32>() / n as f32;\n        let min = total.iter().copied().fold(f32::MAX, f32::min);\n        let max = total.iter().copied().fold(0.0, f32::max);\n        Some((avg, tick, min, max))\n    }\n}\n\n/// Applies camera cues (pads, camera zones) on top of the room's camera, with sweeps.\n#[derive(Default)]\npub struct CameraDirector {\n    serial: u64,\n    base: Option<CameraParams>,\n    cue: Option<Arc<CameraCue>>,\n    start: Option<Instant>,\n    quarters: u8,\n}\n\nfn set_camera_value(p: &mut CameraParams, key: &str, v: f32, quarters: u8) {\n    let v = if key == \"yaw\" { ((v + quarters as f32 * 90.0 + 540.0).rem_euclid(360.0)) - 180.0 } else { v };\n    let _ = params::set(p, key, ParamValue::Float(v as f64));\n}\n\nimpl CameraDirector {\n    pub fn update(&mut self, hud: &HudFrame, quarters: u8, rig: &mut CameraRig) {\n        if hud.cue_serial != self.serial {\n            self.serial = hud.cue_serial;\n            match &hud.cue {\n                Some(c) => {\n                    let base = self.base.get_or_insert_with(|| rig.params.clone()).clone();\n                    rig.blend_from_current(0.7);\n                    let mut p = base;\n                    for (k, v) in &c.set {\n                        match v.as_f64() {\n                            Some(f) if k != \"ortho\" => set_camera_value(&mut p, k, f as f32, quarters),\n                            _ => {\n                                let _ = params::set(&mut p, k, v.clone());\n                            }\n                        }\n                    }\n                    rig.params = p;\n                    self.cue = Some(c.clone());\n                    self.start = Some(Instant::now());\n                    self.quarters = quarters;\n                }\n                None => {\n                    if let Some(b) = self.base.take() {\n                        rig.blend_from_current(0.7);\n                        rig.params = b;\n                    }\n                    self.cue = None;\n                }\n            }\n        }\n        let Some(c) = &self.cue else { return };\n        let t = self.start.map(|s| s.elapsed().as_secs_f32()).unwrap_or(0.0);\n        for sw in &c.sweep {\n            let u = (t / sw.period.max(0.1) + sw.phase) * std::f32::consts::TAU;\n            let v = sw.from + (sw.to - sw.from) * (0.5 - 0.5 * u.cos());\n            set_camera_value(&mut rig.params, &sw.param, v, self.quarters);\n        }\n        if c.flip_ortho > 0.0 {\n            let base = c.set.get(\"ortho\").and_then(|v| v.as_bool()).unwrap_or(false);\n            rig.params.ortho = base ^ (((t / c.flip_ortho) as i64) % 2 == 1);\n        }\n    }\n}\n\n/// Speed history for the feel overlay graph.\n#[derive(Default)]\npub struct FeelOverlay {\n    pub open: bool,\n    /// Opened automatically by the current room.\n    pub auto: bool,\n    speed: VecDeque<f32>,\n    last_tick: u64,\n}\n\npub struct HudCtx<'a> {\n    pub hud: &'a HudFrame,\n    pub tick: u64,\n    pub dt: f32,\n}\n\n/// Course timer, results and level messages (top centre).\npub fn course_hud(ctx: &egui::Context, h: &HudCtx) {\n    let ago = |tick: u64| h.tick.saturating_sub(tick) as f32 * h.dt;\n    let result = h.hud.last_result.as_ref().filter(|r| ago(r.tick) < 6.0);\n    let msg = h.hud.message.as_ref().filter(|(_, t)| ago(*t) < 2.5);\n    if h.hud.course.is_none() && result.is_none() && msg.is_none() && h.hud.boss.is_none() {\n        return;\n    }\n    egui::Area::new(egui::Id::new(\"course_hud\")).anchor(egui::Align2::CENTER_TOP, [0.0, 10.0]).show(ctx, |ui| {\n        egui::Frame::popup(ui.style()).show(ui, |ui| {\n            ui.vertical_centered(|ui| {\n                if let Some(c) = &h.hud.course {\n                    ui.horizontal(|ui| {\n                        ui.label(RichText::new(c.course.to_uppercase()).strong());\n                        let t = if c.running { format!(\"{:6.2} s\", c.time) } else { \"ready\".into() };\n                        ui.label(RichText::new(t).monospace().size(22.0).strong());\n                        if c.gates_total > 0 {\n                            ui.label(format!(\"gates {}/{}\", c.gates_passed, c.gates_total));\n                        }\n                        if c.missed > 0 {\n                            ui.label(RichText::new(format!(\"missed {}\", c.missed)).color(Color32::from_rgb(255, 170, 90)));\n                        }\n                        if c.hits > 0 {\n                            ui.label(RichText::new(format!(\"hits {}\", c.hits)).color(Color32::from_rgb(255, 120, 110)));\n                        }\n                        if c.falls > 0 {\n                            ui.label(format!(\"falls {}\", c.falls));\n                        }\n                        if c.score > 0 {\n                            ui.label(\n                                RichText::new(format!(\"score {}\", c.score)).color(Color32::from_rgb(140, 220, 255)).strong(),\n                            );\n                        }\n                        if let Some(b) = c.best {\n                            ui.label(RichText::new(format!(\"best {b:.2} s\")).weak());\n                        }\n                    });\n                }\n                if let Some(r) = result {\n                    let mut line = format!(\"{}  {:.2} s\", r.course.to_uppercase(), r.time);\n                    if r.missed > 0 {\n                        line += &format!(\"  (+{:.0} s: {} missed)\", r.missed as f32 * pav_core::course::GATE_PENALTY, r.missed);\n                    }\n                    ui.label(RichText::new(line).size(20.0).strong());\n                    let mut sub = Vec::new();\n                    if r.hits > 0 {\n                        sub.push(format!(\"{} hits\", r.hits));\n                    }\n                    if r.falls > 0 {\n                        sub.push(format!(\"{} falls\", r.falls));\n                    }\n                    if r.score > 0 {\n                        sub.push(format!(\"score {}\", r.score));\n                    }\n                    if r.new_best {\n                        ui.label(RichText::new(\"NEW BEST\").color(Color32::from_rgb(255, 215, 90)).strong());\n                    } else {\n                        sub.push(format!(\"best {:.2} s\", r.best));\n                    }\n                    if !sub.is_empty() {\n                        ui.label(sub.join(\" · \"));\n                    }\n                }\n                if let Some((m, _)) = msg {\n                    ui.label(RichText::new(m).color(Color32::from_rgb(255, 220, 140)).strong());\n                }\n                if let Some((name, f)) = &h.hud.boss {\n                    // Boss health bar.\n                    ui.label(RichText::new(name.to_uppercase()).strong().color(Color32::from_rgb(255, 140, 120)));\n                    let (rect, _) = ui.allocate_exact_size(egui::vec2(320.0, 12.0), egui::Sense::hover());\n                    ui.painter().rect_filled(rect, 3.0, Color32::from_gray(40));\n                    let mut fill = rect;\n                    fill.set_width(rect.width() * f.clamp(0.0, 1.0));\n                    ui.painter().rect_filled(fill, 3.0, Color32::from_rgb(230, 70, 60));\n                }\n            });\n        });\n    });\n}\n\n/// Red screen-edge flash while the player is invulnerable after a hit.\npub fn hit_flash(ctx: &egui::Context, invuln: f32) {\n    if invuln <= 0.0 {\n        return;\n    }\n    let a = (invuln / 0.6).clamp(0.0, 1.0);\n    let rect = ctx.content_rect();\n    let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Background, egui::Id::new(\"hit_flash\")));\n    let w = 18.0 + 30.0 * a;\n    let c = Color32::from_rgba_unmultiplied(230, 40, 30, (110.0 * a) as u8);\n    painter.rect_stroke(rect.shrink(w * 0.5), 0.0, egui::Stroke::new(w, c), egui::StrokeKind::Middle);\n}\n\npub struct FeelSettings<'a> {\n    pub model: &'a mut MovementModel,\n    pub tick_rate: &'a mut TickRate,\n    pub vsync: &'a mut bool,\n    pub smoothing: &'a mut bool,\n}\n\nimpl FeelOverlay {\n    pub fn record(&mut self, tick: u64, speed: f32) {\n        if tick != self.last_tick {\n            self.last_tick = tick;\n            self.speed.push_back(speed);\n            while self.speed.len() > 240 {\n                self.speed.pop_front();\n            }\n        }\n    }\n\n    /// The overlay window (right side). Returns true if it is open.\n    pub fn ui(&mut self, ctx: &egui::Context, h: &HudCtx, lat: &Latency, s: FeelSettings) {\n        if !self.open {\n            return;\n        }\n        let f = &h.hud.feel;\n        let mut open = self.open;\n        egui::Window::new(\"Feel metrics\")\n            .id(egui::Id::new(\"feel_overlay\"))\n            .open(&mut open)\n            .anchor(egui::Align2::RIGHT_BOTTOM, [-12.0, -40.0])\n            .resizable(false)\n            .collapsible(true)\n            .default_width(300.0)\n            .show(ctx, |ui| {\n                egui::Grid::new(\"feel_grid\").num_columns(2).show(ui, |ui| {\n                    ui.label(\"Movement model\");\n                    let mut i = s.model.to_index();\n                    egui::ComboBox::from_id_salt(\"feel_model\").selected_text(MovementModel::NAMES[i]).show_ui(ui, |ui| {\n                        for (k, n) in MovementModel::NAMES.iter().enumerate() {\n                            ui.selectable_value(&mut i, k, *n);\n                        }\n                    });\n                    *s.model = MovementModel::from_index(i);\n                    ui.end_row();\n                    ui.label(\"Tick rate\");\n                    let mut t = s.tick_rate.to_index();\n                    ui.horizontal(|ui| {\n                        for (k, n) in TickRate::NAMES.iter().enumerate() {\n                            ui.selectable_value(&mut t, k, format!(\"{n} Hz\"));\n                        }\n                    });\n                    *s.tick_rate = TickRate::from_index(t);\n                    ui.end_row();\n                    ui.label(\"Display\");\n                    ui.horizontal(|ui| {\n                        ui.checkbox(s.vsync, \"vsync\");\n                        ui.checkbox(s.smoothing, \"smoothing\");\n                    });\n                    ui.end_row();\n                    ui.label(\"Input delay\");\n                    match lat.stats() {\n                        Some((avg, tick, min, max)) => {\n                            ui.label(\n                                RichText::new(format!(\"{avg:.0} ms  ({min:.0}–{max:.0})\"))\n                                    .monospace()\n                                    .strong(),\n                            )\n                            .on_hover_text(format!(\n                                \"Key press to simulation tick: {tick:.1} ms, then to frame submitted: {:.1} ms.\\nThe display adds its own scan-out time on top.\",\n                                avg - tick\n                            ));\n                        }\n                        None => {\n                            ui.label(RichText::new(\"press a key\").weak());\n                        }\n                    }\n                    ui.end_row();\n                    let ms = h.dt * 1000.0;\n                    ui.label(\"Response\");\n                    ui.label(format!(\"{} tick{} ({:.0} ms)\", f.response_ticks, if f.response_ticks == 1 { \"\" } else { \"s\" }, f.response_ticks as f32 * ms));\n                    ui.end_row();\n                    ui.label(\"Speed\");\n                    ui.label(RichText::new(format!(\"{:.2} m/s  (top {:.2})\", f.speed, f.top_speed)).monospace());\n                    ui.end_row();\n                    ui.label(\"To top speed\");\n                    ui.label(RichText::new(format!(\"{:.0} ms\", f.accel_ms)).monospace());\n                    ui.end_row();\n                    ui.label(\"Stop\");\n                    ui.label(RichText::new(format!(\"{:.0} ms · {:.2} m\", f.stop_ms, f.stop_dist)).monospace());\n                    ui.end_row();\n                    ui.label(\"Turnaround\");\n                    ui.label(RichText::new(format!(\"{:.0} ms\", f.turn_ms)).monospace());\n                    ui.end_row();\n                    ui.label(\"Last jump\");\n                    ui.label(\n                        RichText::new(format!(\"{:.2} m high · {:.0} ms · {:.1} m\", f.jump_height, f.air_ms, f.jump_dist)).monospace(),\n                    );\n                    ui.end_row();\n                });\n                // Speed over the last few seconds.\n                let (rect, _) = ui.allocate_exact_size(egui::vec2(ui.available_width().max(260.0), 54.0), egui::Sense::hover());\n                let painter = ui.painter_at(rect);\n                painter.rect_filled(rect, 3.0, Color32::from_black_alpha(60));\n                let max = self.speed.iter().copied().fold(1.0, f32::max) * 1.1;\n                let n = self.speed.len().max(2);\n                let pts: Vec<egui::Pos2> = self\n                    .speed\n                    .iter()\n                    .enumerate()\n                    .map(|(i, v)| egui::pos2(rect.left() + rect.width() * i as f32 / (n - 1) as f32, rect.bottom() - rect.height() * v / max))\n                    .collect();\n                painter.add(egui::Shape::line(pts, egui::Stroke::new(1.5, Color32::from_rgb(120, 200, 255))));\n                painter.text(rect.left_top() + egui::vec2(4.0, 2.0), egui::Align2::LEFT_TOP, format!(\"speed (max {max:.1} m/s)\"), egui::FontId::proportional(10.0), Color32::from_white_alpha(150));\n            });\n        if !open {\n            self.open = false;\n        }\n        let _ = Duration::ZERO;\n    }\n}\n\n/// Physics counters and simulation cost (stress tests).\n#[derive(Default)]\npub struct PhysicsOverlay {\n    pub open: bool,\n    pub auto: bool,\n    tick_ms: VecDeque<f32>,\n}\n\nimpl PhysicsOverlay {\n    pub fn ui(&mut self, ctx: &egui::Context, h: &HudCtx, tps: f32, tick_ms: f32) {\n        if !self.open {\n            return;\n        }\n        self.tick_ms.push_back(tick_ms);\n        while self.tick_ms.len() > 240 {\n            self.tick_ms.pop_front();\n        }\n        let p = &h.hud.physics;\n        let budget = h.dt * 1000.0;\n        let mut open = self.open;\n        egui::Window::new(\"Physics\")\n            .id(egui::Id::new(\"physics_overlay\"))\n            .open(&mut open)\n            .anchor(egui::Align2::RIGHT_TOP, [-12.0, 110.0])\n            .resizable(false)\n            .default_width(280.0)\n            .show(ctx, |ui| {\n                let load = tick_ms / budget.max(1e-3);\n                let color = if load < 0.5 {\n                    Color32::from_rgb(120, 220, 140)\n                } else if load < 0.9 {\n                    Color32::from_rgb(255, 210, 90)\n                } else {\n                    Color32::from_rgb(255, 110, 100)\n                };\n                ui.label(RichText::new(format!(\"{tps:.0} ticks/s\")).size(26.0).strong().color(color));\n                ui.label(format!(\"{tick_ms:.2} ms per tick ({:.0}% of the {budget:.1} ms budget)\", load * 100.0));\n                egui::Grid::new(\"physics_grid\").num_columns(2).show(ui, |ui| {\n                    let mut row = |k: &str, v: String| {\n                        ui.label(k);\n                        ui.label(RichText::new(v).monospace());\n                        ui.end_row();\n                    };\n                    row(\"Moving bodies\", format!(\"{} ({} asleep)\", p.dynamic, p.sleeping));\n                    row(\"Colliders\", p.colliders.to_string());\n                    row(\"Contacts\", p.contacts.to_string());\n                    row(\"Joints\", p.joints.to_string());\n                    row(\"Soft bodies\", format!(\"{} ({} particles)\", p.soft_bodies, p.particles));\n                    row(\"Projectiles\", p.projectiles.to_string());\n                });\n                let (rect, _) = ui.allocate_exact_size(egui::vec2(ui.available_width().max(240.0), 50.0), egui::Sense::hover());\n                let painter = ui.painter_at(rect);\n                painter.rect_filled(rect, 3.0, Color32::from_black_alpha(60));\n                let max = self.tick_ms.iter().copied().fold(budget, f32::max) * 1.1;\n                let y = |v: f32| rect.bottom() - rect.height() * v / max;\n                painter.hline(\n                    rect.x_range(),\n                    y(budget),\n                    egui::Stroke::new(1.0, Color32::from_rgba_unmultiplied(255, 120, 100, 120)),\n                );\n                let n = self.tick_ms.len().max(2);\n                let pts: Vec<egui::Pos2> = self\n                    .tick_ms\n                    .iter()\n                    .enumerate()\n                    .map(|(i, v)| egui::pos2(rect.left() + rect.width() * i as f32 / (n - 1) as f32, y(*v)))\n                    .collect();\n                painter.add(egui::Shape::line(pts, egui::Stroke::new(1.5, Color32::from_rgb(120, 200, 255))));\n                painter.text(\n                    rect.left_top() + egui::vec2(4.0, 2.0),\n                    egui::Align2::LEFT_TOP,\n                    \"ms per tick (red line = budget)\",\n                    egui::FontId::proportional(10.0),\n                    Color32::from_white_alpha(150),\n                );\n            });\n        if !open {\n            self.open = false;\n        }\n    }\n}\n","numLines":427,"startLine":1,"totalLines":427}},"tool_result_meta":[{"id":"toolu_01RghMPgj8hqku1oqtnUyzWo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj97CRCDXN9qk1VU47WF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017JWwxFm1QQVAtDLhMJZuVq","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211956__x710a06/work/_research/shardfall/crates/pav_app/src/ui.rs","limit":260},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":49359,"cache_read_input_tokens":65519,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":49359},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"501e7141-3737-4a8e-9cac-eb3584714d8d","uuid":"1df32bbf-678e-46f2-ac6d-3d7510d23e38","timestamp":"2026-11-05T04:21:20.162Z","request_id":"req_011Cgj97CAZsUiXC5hncEWfZ","wire_tool_inputs":{"toolu_017JWwxFm1QQVAtDLhMJZuVq":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211956__x710a06/work/_research/shardfall/crates/pav_app/src/ui.rs","limit":260}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017JWwxFm1QQVAtDLhMJZuVq","type":"tool_result","content":"1\t//! egui overlays: boot diagnostics, stats, crash banner.\n2\t\n3\tuse egui::{Color32, RichText};\n4\t\n5\tuse crate::boot::{StageStatus, diag};\n6\tuse crate::input::{Device, guide};\n7\t\n8\tpub struct OverlayInfo<'a> {\n9\t    pub fps: f32,\n10\t    pub frame_ms: f32,\n11\t    pub tps: f32,\n12\t    pub tick_ms: f32,\n13\t    pub tick: u64,\n14\t    pub entities: usize,\n15\t    pub gpu_errors: u32,\n16\t    pub adapter: &'a str,\n17\t    pub crash: Option<String>,\n18\t    pub paused: bool,\n19\t    pub speed: f32,\n20\t    pub rewinding: bool,\n21\t    /// The scene's resolution as a fraction of the screen's.\n22\t    pub render_scale: f32,\n23\t}\n24\t\n25\tpub enum MenuAction {\n26\t    Resume,\n27\t    Reset,\n28\t    Rooms,\n29\t    RoomCard,\n30\t    LoadScene(String),\n31\t    /// Shardfall: erase the save, start over in town.\n32\t    NewHero,\n33\t    Tuning,\n34\t    /// The Look & Filters window.\n35\t    Look,\n36\t    /// The live animation workspace.\n37\t    AnimationStudio,\n38\t    AssetStudio,\n39\t    CreatureStudio,\n40\t    /// How the room you are in works (the station guide; outside rooms the field guide).\n41\t    Guide,\n42\t    /// Every word and every room's ask-for-it phrases.\n43\t    FieldGuide,\n44\t    Feel,\n45\t    Physics,\n46\t    Screenshot,\n47\t    Quit,\n48\t    /// Shardfall: home to town (touch screens have no T key).\n49\t    TownPortal,\n50\t    /// The browser's full screen.\n51\t    Fullscreen,\n52\t}\n53\t\n54\tpub fn boot_panel(ctx: &egui::Context, open: &mut bool) {\n55\t    let d = diag();\n56\t    egui::Window::new(\"Boot diagnostics\").open(open).default_pos([12.0, 12.0]).resizable(false).collapsible(true).show(\n57\t        ctx,\n58\t        |ui| {\n59\t            let stages = d.stages.lock().map(|s| s.clone()).unwrap_or_default();\n60\t            let total: f64 = stages.iter().map(|s| s.ms).sum();\n61\t            egui::Grid::new(\"stages\").striped(true).show(ui, |ui| {\n62\t                for s in &stages {\n63\t                    ui.label(RichText::new(format!(\"{:02}\", s.num)).monospace());\n64\t                    ui.label(&s.name);\n65\t                    ui.label(RichText::new(format!(\"{:>7.1} ms\", s.ms)).monospace());\n66\t                    match &s.status {\n67\t                        StageStatus::Ok => ui.label(RichText::new(\"ok\").color(Color32::from_rgb(90, 200, 110))),\n68\t                        StageStatus::Failed(m) => ui.label(RichText::new(format!(\"FAILED: {m}\")).color(Color32::RED)),\n69\t                    };\n70\t                    ui.label(RichText::new(&s.detail).small());\n71\t                    ui.end_row();\n72\t                }\n73\t            });\n74\t            ui.separator();\n75\t            ui.label(format!(\"Total {:.0} ms · log: {}\", total, d.log_path.display()));\n76\t            ui.label(RichText::new(\"F3 toggles this panel\").small().weak());\n77\t        },\n78\t    );\n79\t}\n80\t\n81\t/// `free` = screen area not covered by side panels. `compact`: one line at the bottom (touch\n82\t/// screens, whose top corners hold the controls).\n83\tpub fn stats_panel(ctx: &egui::Context, i: &OverlayInfo, free: egui::Rect, compact: bool) {\n84\t    if compact {\n85\t        egui::Area::new(egui::Id::new(\"stats\")).anchor(egui::Align2::CENTER_BOTTOM, [0.0, -4.0]).interactable(false).show(\n86\t            ctx,\n87\t            |ui| {\n88\t                ui.label(\n89\t                    RichText::new(format!(\n90\t                        \"{:.0} fps  {:.1} ms  ·  sim {:.2} ms  ·  {:.0}% res\",\n91\t                        i.fps,\n92\t                        i.frame_ms,\n93\t                        i.tick_ms,\n94\t                        i.render_scale * 100.0\n95\t                    ))\n96\t                    .monospace()\n97\t                    .size(11.0)\n98\t                    .color(Color32::from_white_alpha(200))\n99\t                    .background_color(Color32::from_black_alpha(120)),\n100\t                );\n101\t            },\n102\t        );\n103\t        return;\n104\t    }\n105\t    let pos = free.right_top() + egui::vec2(-10.0, 10.0);\n106\t    egui::Area::new(egui::Id::new(\"stats\")).pivot(egui::Align2::RIGHT_TOP).fixed_pos(pos).show(ctx, |ui| {\n107\t        egui::Frame::popup(ui.style()).show(ui, |ui| {\n108\t            ui.label(RichText::new(format!(\"{:.0} fps  {:.2} ms\", i.fps, i.frame_ms)).monospace());\n109\t            ui.label(RichText::new(format!(\"sim {:.0} tps  {:.3} ms/tick\", i.tps, i.tick_ms)).monospace());\n110\t            ui.label(RichText::new(format!(\"tick {}  entities {}\", i.tick, i.entities)).monospace());\n111\t            if i.rewinding {\n112\t                ui.label(RichText::new(\"◀◀ REWINDING\").color(Color32::from_rgb(120, 200, 255)).strong());\n113\t            } else if i.paused {\n114\t                ui.label(RichText::new(\"PAUSED\").color(Color32::YELLOW).strong());\n115\t            } else if (i.speed - 1.0).abs() > 0.01 {\n116\t                ui.label(RichText::new(format!(\"speed ×{:.2}\", i.speed)).color(Color32::YELLOW));\n117\t            }\n118\t            if i.gpu_errors > 0 {\n119\t                ui.label(RichText::new(format!(\"{} GPU errors (see log)\", i.gpu_errors)).color(Color32::RED));\n120\t            }\n121\t            if i.render_scale < 0.999 {\n122\t                ui.label(RichText::new(format!(\"scene at {:.0}% resolution\", i.render_scale * 100.0)).small());\n123\t            }\n124\t            ui.label(RichText::new(i.adapter).small().weak());\n125\t        });\n126\t    });\n127\t}\n128\t\n129\tpub fn crash_banner(root: &mut egui::Ui, msg: &str) {\n130\t    egui::Panel::top(\"crash\").show(root, |ui| {\n131\t        ui.label(RichText::new(\"The simulation crashed\").color(Color32::RED).strong());\n132\t        ui.label(msg);\n133\t        ui.label(format!(\"Full report in {}\", diag().log_path.display()));\n134\t    });\n135\t}\n136\t\n137\tpub fn hint_bar(ctx: &egui::Context, text: &str) {\n138\t    egui::Area::new(egui::Id::new(\"hints\")).anchor(egui::Align2::CENTER_BOTTOM, [0.0, -8.0]).show(ctx, |ui| {\n139\t        ui.label(\n140\t            RichText::new(text).small().color(Color32::from_white_alpha(200)).background_color(Color32::from_black_alpha(110)),\n141\t        );\n142\t    });\n143\t}\n144\t\n145\tpub fn guide_panel(ctx: &egui::Context, device: Device, game: bool) {\n146\t    egui::Area::new(egui::Id::new(\"guide\")).anchor(egui::Align2::LEFT_BOTTOM, [10.0, -30.0]).show(ctx, |ui| {\n147\t        egui::Frame::popup(ui.style()).show(ui, |ui| {\n148\t            ui.label(\n149\t                RichText::new(match device {\n150\t                    Device::KeyboardMouse => \"Controls (keyboard + mouse)\",\n151\t                    Device::Gamepad => \"Controls (gamepad)\",\n152\t                    Device::Touch => \"Controls (touch)\",\n153\t                })\n154\t                .strong(),\n155\t            );\n156\t            egui::Grid::new(\"guide_grid\").show(ui, |ui| {\n157\t                for (a, k) in if game { crate::input::game_guide(device) } else { guide(device) } {\n158\t                    ui.label(*a);\n159\t                    ui.label(RichText::new(*k).monospace());\n160\t                    ui.end_row();\n161\t                }\n162\t            });\n163\t        });\n164\t    });\n165\t}\n166\t\n167\tpub fn pause_menu(\n168\t    ctx: &egui::Context,\n169\t    device: Device,\n170\t    scene: &str,\n171\t    difficulty: Option<&mut pav_core::arpg::Difficulty>,\n172\t) -> Option<MenuAction> {\n173\t    let mut action = None;\n174\t    let game = difficulty.is_some();\n175\t    egui::Window::new(\"Paused\")\n176\t        .anchor(egui::Align2::CENTER_CENTER, [0.0, 0.0])\n177\t        .collapsible(false)\n178\t        .resizable(false)\n179\t        .show(ctx, |ui| {\n180\t            ui.label(format!(\"Room: {scene}\"));\n181\t            ui.horizontal(|ui| {\n182\t                if ui.button(\"Resume (Esc)\").clicked() {\n183\t                    action = Some(MenuAction::Resume);\n184\t                }\n185\t                if ui.button(\"Rooms (F2)\").clicked() {\n186\t                    action = Some(MenuAction::Rooms);\n187\t                }\n188\t                if ui.button(\"Room info\").clicked() {\n189\t                    action = Some(MenuAction::RoomCard);\n190\t                }\n191\t                if ui.button(\"Reset scene\").clicked() {\n192\t                    action = Some(MenuAction::Reset);\n193\t                }\n194\t                if ui.button(\"Tuning (F1)\").clicked() {\n195\t                    action = Some(MenuAction::Tuning);\n196\t                }\n197\t                if ui\n198\t                    .button(\"Look & filters\")\n199\t                    .on_hover_text(\"Pixel art, cel shading, outlines, palettes, grading and more, on the whole scene, the characters & objects or the environment\")\n200\t                    .clicked()\n201\t                {\n202\t                    action = Some(MenuAction::Look);\n203\t                }\n204\t                if ui.button(\"Animation Studio\").clicked() {\n205\t                    action = Some(MenuAction::AnimationStudio);\n206\t                }\n207\t                if ui.button(\"Object Studio\").clicked() {\n208\t                    action = Some(MenuAction::AssetStudio);\n209\t                }\n210\t                if ui.button(\"Creature Studio\").clicked() {\n211\t                    action = Some(MenuAction::CreatureStudio);\n212\t                }\n213\t                if !game\n214\t                    && ui\n215\t                        .button(\"How it works (H)\")\n216\t                        .on_hover_text(\"The station guide of the room you are in: how it works, where games use it, how to ask for it\")\n217\t                        .clicked()\n218\t                {\n219\t                    action = Some(MenuAction::Guide);\n220\t                }\n221\t                if !game && ui.button(\"Field guide\").on_hover_text(\"Every word, and what to ask for in every room\").clicked() {\n222\t                    action = Some(MenuAction::FieldGuide);\n223\t                }\n224\t                if ui.button(\"Feel metrics\").clicked() {\n225\t                    action = Some(MenuAction::Feel);\n226\t                }\n227\t                if ui.button(\"Physics stats\").clicked() {\n228\t                    action = Some(MenuAction::Physics);\n229\t                }\n230\t                if ui.button(\"Screenshot (F12)\").clicked() {\n231\t                    action = Some(MenuAction::Screenshot);\n232\t                }\n233\t                if ui.button(\"Quit\").clicked() {\n234\t                    action = Some(MenuAction::Quit);\n235\t                }\n236\t            });\n237\t            let difficulty_shown = difficulty.is_some();\n238\t            if let Some(d) = difficulty {\n239\t                ui.separator();\n240\t                crate::arpg_ui::difficulty_ui(ui, d);\n241\t                ui.horizontal(|ui| {\n242\t                    if ui.button(\"New hero\").on_hover_text(\"Erase the saved hero and start again in Emberwatch\").clicked() {\n243\t                        action = Some(MenuAction::NewHero);\n244\t                    }\n245\t                    ui.label(RichText::new(\"The hero is saved on every trip and on quit.\").small().weak());\n246\t                });\n247\t            }\n248\t            ui.separator();\n249\t            ui.label(RichText::new(\"Load scene\").strong());\n250\t            for (name, about) in pav_core::scenes::menu() {\n251\t                ui.horizontal(|ui| {\n252\t                    if ui.button(name).clicked() {\n253\t                        action = Some(MenuAction::LoadScene(name.to_string()));\n254\t                    }\n255\t                    ui.label(RichText::new(about).small());\n256\t                });\n257\t            }\n258\t            ui.separator();\n259\t            ui.label(RichText::new(\"Controls\").strong());\n260\t            egui::Grid::new(\"menu_guide\").show(ui, |ui| {"}]},"parent_tool_use_id":null,"session_id":"501e7141-3737-4a8e-9cac-eb3584714d8d","uuid":"f14c6392-1641-463e-a8fe-072ed0a5cda8","timestamp":"2026-11-05T04:21:20.173Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211956__x710a06/work/_research/shardfall/crates/pav_app/src/ui.rs","content":"//! egui overlays: boot diagnostics, stats, crash banner.\n\nuse egui::{Color32, RichText};\n\nuse crate::boot::{StageStatus, diag};\nuse crate::input::{Device, guide};\n\npub struct OverlayInfo<'a> {\n    pub fps: f32,\n    pub frame_ms: f32,\n    pub tps: f32,\n    pub tick_ms: f32,\n    pub tick: u64,\n    pub entities: usize,\n    pub gpu_errors: u32,\n    pub adapter: &'a str,\n    pub crash: Option<String>,\n    pub paused: bool,\n    pub speed: f32,\n    pub rewinding: bool,\n    /// The scene's resolution as a fraction of the screen's.\n    pub render_scale: f32,\n}\n\npub enum MenuAction {\n    Resume,\n    Reset,\n    Rooms,\n    RoomCard,\n    LoadScene(String),\n    /// Shardfall: erase the save, start over in town.\n    NewHero,\n    Tuning,\n    /// The Look & Filters window.\n    Look,\n    /// The live animation workspace.\n    AnimationStudio,\n    AssetStudio,\n    CreatureStudio,\n    /// How the room you are in works (the station guide; outside rooms the field guide).\n    Guide,\n    /// Every word and every room's ask-for-it phrases.\n    FieldGuide,\n    Feel,\n    Physics,\n    Screenshot,\n    Quit,\n    /// Shardfall: home to town (touch screens have no T key).\n    TownPortal,\n    /// The browser's full screen.\n    Fullscreen,\n}\n\npub fn boot_panel(ctx: &egui::Context, open: &mut bool) {\n    let d = diag();\n    egui::Window::new(\"Boot diagnostics\").open(open).default_pos([12.0, 12.0]).resizable(false).collapsible(true).show(\n        ctx,\n        |ui| {\n            let stages = d.stages.lock().map(|s| s.clone()).unwrap_or_default();\n            let total: f64 = stages.iter().map(|s| s.ms).sum();\n            egui::Grid::new(\"stages\").striped(true).show(ui, |ui| {\n                for s in &stages {\n                    ui.label(RichText::new(format!(\"{:02}\", s.num)).monospace());\n                    ui.label(&s.name);\n                    ui.label(RichText::new(format!(\"{:>7.1} ms\", s.ms)).monospace());\n                    match &s.status {\n                        StageStatus::Ok => ui.label(RichText::new(\"ok\").color(Color32::from_rgb(90, 200, 110))),\n                        StageStatus::Failed(m) => ui.label(RichText::new(format!(\"FAILED: {m}\")).color(Color32::RED)),\n                    };\n                    ui.label(RichText::new(&s.detail).small());\n                    ui.end_row();\n                }\n            });\n            ui.separator();\n            ui.label(format!(\"Total {:.0} ms · log: {}\", total, d.log_path.display()));\n            ui.label(RichText::new(\"F3 toggles this panel\").small().weak());\n        },\n    );\n}\n\n/// `free` = screen area not covered by side panels. `compact`: one line at the bottom (touch\n/// screens, whose top corners hold the controls).\npub fn stats_panel(ctx: &egui::Context, i: &OverlayInfo, free: egui::Rect, compact: bool) {\n    if compact {\n        egui::Area::new(egui::Id::new(\"stats\")).anchor(egui::Align2::CENTER_BOTTOM, [0.0, -4.0]).interactable(false).show(\n            ctx,\n            |ui| {\n                ui.label(\n                    RichText::new(format!(\n                        \"{:.0} fps  {:.1} ms  ·  sim {:.2} ms  ·  {:.0}% res\",\n                        i.fps,\n                        i.frame_ms,\n                        i.tick_ms,\n                        i.render_scale * 100.0\n                    ))\n                    .monospace()\n                    .size(11.0)\n                    .color(Color32::from_white_alpha(200))\n                    .background_color(Color32::from_black_alpha(120)),\n                );\n            },\n        );\n        return;\n    }\n    let pos = free.right_top() + egui::vec2(-10.0, 10.0);\n    egui::Area::new(egui::Id::new(\"stats\")).pivot(egui::Align2::RIGHT_TOP).fixed_pos(pos).show(ctx, |ui| {\n        egui::Frame::popup(ui.style()).show(ui, |ui| {\n            ui.label(RichText::new(format!(\"{:.0} fps  {:.2} ms\", i.fps, i.frame_ms)).monospace());\n            ui.label(RichText::new(format!(\"sim {:.0} tps  {:.3} ms/tick\", i.tps, i.tick_ms)).monospace());\n            ui.label(RichText::new(format!(\"tick {}  entities {}\", i.tick, i.entities)).monospace());\n            if i.rewinding {\n                ui.label(RichText::new(\"◀◀ REWINDING\").color(Color32::from_rgb(120, 200, 255)).strong());\n            } else if i.paused {\n                ui.label(RichText::new(\"PAUSED\").color(Color32::YELLOW).strong());\n            } else if (i.speed - 1.0).abs() > 0.01 {\n                ui.label(RichText::new(format!(\"speed ×{:.2}\", i.speed)).color(Color32::YELLOW));\n            }\n            if i.gpu_errors > 0 {\n                ui.label(RichText::new(format!(\"{} GPU errors (see log)\", i.gpu_errors)).color(Color32::RED));\n            }\n            if i.render_scale < 0.999 {\n                ui.label(RichText::new(format!(\"scene at {:.0}% resolution\", i.render_scale * 100.0)).small());\n            }\n            ui.label(RichText::new(i.adapter).small().weak());\n        });\n    });\n}\n\npub fn crash_banner(root: &mut egui::Ui, msg: &str) {\n    egui::Panel::top(\"crash\").show(root, |ui| {\n        ui.label(RichText::new(\"The simulation crashed\").color(Color32::RED).strong());\n        ui.label(msg);\n        ui.label(format!(\"Full report in {}\", diag().log_path.display()));\n    });\n}\n\npub fn hint_bar(ctx: &egui::Context, text: &str) {\n    egui::Area::new(egui::Id::new(\"hints\")).anchor(egui::Align2::CENTER_BOTTOM, [0.0, -8.0]).show(ctx, |ui| {\n        ui.label(\n            RichText::new(text).small().color(Color32::from_white_alpha(200)).background_color(Color32::from_black_alpha(110)),\n        );\n    });\n}\n\npub fn guide_panel(ctx: &egui::Context, device: Device, game: bool) {\n    egui::Area::new(egui::Id::new(\"guide\")).anchor(egui::Align2::LEFT_BOTTOM, [10.0, -30.0]).show(ctx, |ui| {\n        egui::Frame::popup(ui.style()).show(ui, |ui| {\n            ui.label(\n                RichText::new(match device {\n                    Device::KeyboardMouse => \"Controls (keyboard + mouse)\",\n                    Device::Gamepad => \"Controls (gamepad)\",\n                    Device::Touch => \"Controls (touch)\",\n                })\n                .strong(),\n            );\n            egui::Grid::new(\"guide_grid\").show(ui, |ui| {\n                for (a, k) in if game { crate::input::game_guide(device) } else { guide(device) } {\n                    ui.label(*a);\n                    ui.label(RichText::new(*k).monospace());\n                    ui.end_row();\n                }\n            });\n        });\n    });\n}\n\npub fn pause_menu(\n    ctx: &egui::Context,\n    device: Device,\n    scene: &str,\n    difficulty: Option<&mut pav_core::arpg::Difficulty>,\n) -> Option<MenuAction> {\n    let mut action = None;\n    let game = difficulty.is_some();\n    egui::Window::new(\"Paused\")\n        .anchor(egui::Align2::CENTER_CENTER, [0.0, 0.0])\n        .collapsible(false)\n        .resizable(false)\n        .show(ctx, |ui| {\n            ui.label(format!(\"Room: {scene}\"));\n            ui.horizontal(|ui| {\n                if ui.button(\"Resume (Esc)\").clicked() {\n                    action = Some(MenuAction::Resume);\n                }\n                if ui.button(\"Rooms (F2)\").clicked() {\n                    action = Some(MenuAction::Rooms);\n                }\n                if ui.button(\"Room info\").clicked() {\n                    action = Some(MenuAction::RoomCard);\n                }\n                if ui.button(\"Reset scene\").clicked() {\n                    action = Some(MenuAction::Reset);\n                }\n                if ui.button(\"Tuning (F1)\").clicked() {\n                    action = Some(MenuAction::Tuning);\n                }\n                if ui\n                    .button(\"Look & filters\")\n                    .on_hover_text(\"Pixel art, cel shading, outlines, palettes, grading and more, on the whole scene, the characters & objects or the environment\")\n                    .clicked()\n                {\n                    action = Some(MenuAction::Look);\n                }\n                if ui.button(\"Animation Studio\").clicked() {\n                    action = Some(MenuAction::AnimationStudio);\n                }\n                if ui.button(\"Object Studio\").clicked() {\n                    action = Some(MenuAction::AssetStudio);\n                }\n                if ui.button(\"Creature Studio\").clicked() {\n                    action = Some(MenuAction::CreatureStudio);\n                }\n                if !game\n                    && ui\n                        .button(\"How it works (H)\")\n                        .on_hover_text(\"The station guide of the room you are in: how it works, where games use it, how to ask for it\")\n                        .clicked()\n                {\n                    action = Some(MenuAction::Guide);\n                }\n                if !game && ui.button(\"Field guide\").on_hover_text(\"Every word, and what to ask for in every room\").clicked() {\n                    action = Some(MenuAction::FieldGuide);\n                }\n                if ui.button(\"Feel metrics\").clicked() {\n                    action = Some(MenuAction::Feel);\n                }\n                if ui.button(\"Physics stats\").clicked() {\n                    action = Some(MenuAction::Physics);\n                }\n                if ui.button(\"Screenshot (F12)\").clicked() {\n                    action = Some(MenuAction::Screenshot);\n                }\n                if ui.button(\"Quit\").clicked() {\n                    action = Some(MenuAction::Quit);\n                }\n            });\n            let difficulty_shown = difficulty.is_some();\n            if let Some(d) = difficulty {\n                ui.separator();\n                crate::arpg_ui::difficulty_ui(ui, d);\n                ui.horizontal(|ui| {\n                    if ui.button(\"New hero\").on_hover_text(\"Erase the saved hero and start again in Emberwatch\").clicked() {\n                        action = Some(MenuAction::NewHero);\n                    }\n                    ui.label(RichText::new(\"The hero is saved on every trip and on quit.\").small().weak());\n                });\n            }\n            ui.separator();\n            ui.label(RichText::new(\"Load scene\").strong());\n            for (name, about) in pav_core::scenes::menu() {\n                ui.horizontal(|ui| {\n                    if ui.button(name).clicked() {\n                        action = Some(MenuAction::LoadScene(name.to_string()));\n                    }\n                    ui.label(RichText::new(about).small());\n                });\n            }\n            ui.separator();\n            ui.label(RichText::new(\"Controls\").strong());\n            egui::Grid::new(\"menu_guide\").show(ui, |ui| {","numLines":260,"startLine":1,"totalLines":449}},"tool_result_meta":[{"id":"toolu_017JWwxFm1QQVAtDLhMJZuVq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
