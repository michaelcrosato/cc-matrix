 100,172p hub-check.mjs; sed -n 228,300p hub-check.mjs; run(){ echo \"=== $1 :: ${@:2}\"; timeout 90 python3 hub_run3.py \"$1\" 60 1280 720 \"${@:2}\" 2>&1 | grep -E \"FINISHED|TIMEOUT|FAIL|CRASH|Unable to create\" | cut -c1-200 | head -6; }; F=\"--no-sandbox --autoplay-policy=no-user-gesture-required --use-vulkan=swiftshader --use-webgpu-adapter=swiftshader --use-angle=swiftshader\"; run \"players=3&latency=150&jitter=50&loss=5&play=8000\" $F; run \"players=4&latency=150&jitter=50&loss=5&play=8000\" $F;  run \"players=4&latency=150&jitter=50&loss=5&play=8000&scenario=host-leave\" $F; run \"players=2&latency=150&jitter=50&loss=5&play=8000&scenario=server\" $F","description":"Read hub-check's solo draw test and run its exact flags","timeout":500000}}}
