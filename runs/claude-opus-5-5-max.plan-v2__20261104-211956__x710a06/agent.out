.replace('#WWWWWWWW......................WWWWWWWW#','#......................................#')\ns+='''\n[[object]]\nname = \"c1\"\nasset = \"cottage\"\npos = [7, 0, 4]\nbody = \"fixed\"\n[[object]]\nname = \"c2\"\nasset = \"cottage\"\npos = [33, 0, 4]\nbody = \"fixed\"\n[[object]]\nname = \"c3\"\nasset = \"cottage\"\npos = [6, 0, 16]\nyaw = 90\nbody = \"fixed\"\n[[object]]\nname = \"c4\"\nasset = \"cottage\"\npos = [34, 0, 16]\nyaw = -90\nbody = \"fixed\"\n[[object]]\nname = \"lamp1\"\nasset = \"LIB/core/lamp_post\"\npos = [13.5, 0, 9.5]\nbody = \"fixed\"\nlight = { color = \"#ffb060\", radius = 12, intensity = 4.0, flicker = 0.4, shadows = true, offset = [0, 2.2, 0] }\n[[object]]\nname = \"lamp2\"\nasset = \"LIB/core/lamp_post\"\npos = [27.5, 0, 12.5]\nbody = \"fixed\"\nlight = { color = \"#ffb060\", radius = 12, intensity = 4.0, flicker = 0.4, shadows = true, offset = [0, 2.2, 0] }\n[[object]]\nname = \"brazier\"\nasset = \"LIB/core/brazier\"\npos = [20.5, 0, 11.0]\nbody = \"fixed\"\nlight = { color = \"#ff8040\", radius = 9, intensity = 4.0, flicker = 0.8, shadows = true, offset = [0, 1.2, 0] }\nparticles = { preset = \"fire\", offset = [0, 1.05, 0] }\n[[object]]\nname = \"boat\"\nasset = \"LIB/core/rowboat:beached\"\npos = [11.5, 0, 16.5]\nyaw = 30\nbody = \"fixed\"\n[[object]]\nname = \"stall\"\nasset = \"LIB/core/market_stall\"\npos = [28.0, 0, 7.0]\nyaw = -30\nbody = \"fixed\"\n[[object]]\nname = \"bar1\"\nasset = \"LIB/core/barrel\"\npos = [26.5, 0, 15.5]\nbody = \"fixed\"\n[[object]]\nname = \"bar2\"\nasset = \"LIB/core/crate_stack\"\npos = [24.5, 0, 17.0]\nbody = \"fixed\"\n[[object]]\nname = \"bell\"\nasset = \"LIB/quaternius_medieval_village/bell\"\npos = [20.0, 0, 7.5]\nbody = \"fixed\"\n\n[[npc]]\nname = \"hero\"\npos = [19.5, 0, 14.8]\nyaw = 180\nai = { type = \"idle\" }\nlook = { shirt = \"#5b4632\", pants = \"#2d2f36\", shoes = \"#27231f\", skin = \"#d8b090\", idle_clip = \"MESH2MOTION/Pistol_Aim_Neutral\", weapon = { kind = \"wand\", asset = \"ser