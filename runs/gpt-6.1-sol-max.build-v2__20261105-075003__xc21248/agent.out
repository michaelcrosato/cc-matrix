{"type":"item.started","item":{"id":"item_140","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport re,json\np=Path('src/ui/style.css');s=p.read_text()\ndef scale_block(m):\n sel,body=m.group(1),m.group(2)\n if any(x in sel for x in ['.body-copy','.subtitle','.objective','.prompts','.about-field p','.medical','.weapon-name','.setting-note','.footer-hint']):\n  body=re.sub(r'font-size:([\"'^;}]+)'\"',lambda f:'font-size:'+f.group(1).replace('var(--u))','var(--u) * var(--text-size,1))'),body)\n return sel+'{'+body+'}'\ns=re.sub(r'([\"'^{}]+)'\"\\\\{([\"'^{}]*)'\"\\\\}',scale_block,s);p.write_text(s)\np=Path('src/main.js');s=p.read_text();old=\\\"this.sim.t.incoming=this.settings.difficulty==='Veteran'?1.35:this.settings.difficulty==='Written Off'?1.8:1;\\\";new=\\\"if(this.sim.difficultyPreset\"'!==this.settings.difficulty){const level=this.settings.difficulty==='\"'Veteran'?1:this.settings.difficulty==='Written Off'?2:0;this.sim.t.incoming=[1,1.35,1.8][level];this.sim.t.pay=[1,1.1,1.3][level];this.sim.p.syringes=Math.min(this.sim.p.syringes,[3,2,1][level]);this.sim.difficultyPreset=this.settings.difficulty;}\\\";assert old in s;s=s.replace(old,new);p.write_text(s)\np=Path('src/ui/index.js');s=p.read_text();old=\\\"const parts=e.line.match(/[\"'^.!?]+[.!?]?/g)||[e.line];this.subtitleQueue=parts.map(v=>({who:e.who,text:v.trim()}));\";new=\"const parts=e.line.match(/[''^.!?]+[.!?]?/g)||[e.line],limit=Math.max(28,Math.min(100,Math.floor(innerWidth*.7*1.8/(Math.max(17,innerHeight/1080*40*this.app.settings.textSize)*.47))));const chunks=[];for(const part of parts){let line='\"'';for(const word of part.trim().split(/\\\\\\\\s+/)){if(line.length+word.length>limit){chunks.push(line);line='';}line+=(line?' ':'')+word;}if(line)chunks.push(line);}this.subtitleQueue=chunks.map(text=>({who:e.who,text}));\\\";assert old in s;s=s.replace(old,new);p.write_text(s)\np=Path('src/data/about.json');a=json.loads(p.read_text());a['testingFeedback'][0]=a['testingFeedback'][0].replace('17 gameplay','18 gameplay');a['testingFeedback'][1]='5 game-breaking issues: movement after skipping the opening, unrelated cargo failing a contract, graphics starving session results, an uninitialized held-map texture on WebGPU, and joining-player input actions missing the host simulation.';p.write_text(json.dumps(a,indent=2)+'\\\\n')\np=Path('docs/issues-log.md');s=p.read_text().replace('Testing tally: 17 confirmed product issues, including 4 game-breaking issues.', '18. **Critical:** normal joining-player input actions were consumed locally without being forwarded to the host. The controller/keyboard action path now forwards actions, remote timed actions advance on the host, and player stance/seat flags travel in poses. The real co-op test now focuses the joining iframe and uses its keyboard to collect and deliver the case.\\\\n\\\\nTesting tally: 18 confirmed product issues, including 5 game-breaking issues.');s+='\\\\nAdditional final verification covers mounted-gun ammunition, non-host keyboard case delivery, remote player damage/stance, visible reinforcement trucks and active field buddies.\\\\n';p.write_text(s)\np=Path('../PROGRESS.md');s=p.read_text();s+='''\\\\n## Additional co-op verification\\\\nA full isolated run passed 38/38. A stronger non-host keyboard case test then found a missing forwarding path for normal client input actions. Fixed action replication, remote timed actions, remote stance/seat and AI targets. The strengthened two-window real Hub case now passes with the client collecting/delivering through its keyboard.\\\\nFinal completion pass added/connected field buddies during twists/rescues/C7, guards at Bad Bridge, proper mounted-gun ammo/camera/coasting, wind cloth/GPS direction, rendered reinforcement trucks and functional dialogue text scaling. Rebuild and full regression are next. Issue tally is 18 product issues, 5 critical; feedback files updated accordingly.\\\\n''';p.write_text(s)\nPY\nnode tools/build.mjs --quiet && node tools/test.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
