{"type":"item.started","item":{"id":"item_115","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/view/index.js');s=p.read_text().replace(\\\"const backend=renderer.backend.isWebGPUBackend?'webgpu':'webgl2';\\\", \\\"const backend=renderer.backend.isWebGPUBackend?'webgpu':'webgl2';if(session&&backend==='webgl2')renderer.shadowMap.enabled=false;\\\")\ns=s.replace(\\\"const pointLights=Array.from({length:5}\\\", \\\"const pointLights=Array.from({length:session&&backend==='webgl2'?0:5}\\\")\np.write_text(s)\np=Path('tools/tests/hub.mjs');s=p.read_text();s=s.replace(\\\"const cases=c.args.has('--smoke')?\\\", \\\"const cases=c.args.has('--fallback')?[]:c.args.has('--smoke')?\\\")\ns=s.replace(\\\"await c.test('Two real Hub players\\\", \\\"if(\"'!c.args.has('\"'--fallback')){await c.test('Two real Hub players\\\")\ns=s.replace(\\\"await browser.close();browser=await chromium.launch\\\", \\\"}await browser.close();browser=await chromium.launch\\\")\np.write_text(s)\nPY\nnode --check tools/tests/hub.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
