{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat > tools/tests/sim.mjs <<'EOF'\nimport {createSim} from '../../src/sim/index.js';\nimport {Bot} from '../../src/sim/bot.js';\nimport {Fire} from '../../src/sim/fire.js';\nimport {defaults} from '../../src/data/tunables.js';\nimport {CONTRACTS,STEP_TYPES} from '../../src/data/contracts.js';\nimport {PLACES,POI} from '../../src/data/world.js';\nimport {WEAPONS} from '../../src/data/weapons.js';\nimport {FEATURES} from '../../src/data/features.js';\nimport {heightAt,riverDistance} from '../../src/sim/terrain.js';\nimport {createPhysics} from '../../src/sim/physics.js';\nimport {Attract} from '../../src/attract.js';\nimport {createHash} from 'node:crypto';\nimport {writeFile} from 'node:fs/promises';\nconst advance=(s,seconds,frame={})=>{for(let i=0;i<Math.ceil(seconds*60);i++)s.tick(i?{...frame,actions:[]}:frame);};\nconst coverage=new Set;\nfunction seen(s){for(const f of s.seen)coverage.add(f);}\nexport async function run(c){\nawait c.test('World and contract data resolve',()=>{c.assert(PLACES.length>=20);for(const contract of CONTRACTS){for(const id of contract.requires)c.assert(CONTRACTS.some(v=>v.id===id),'Missing prerequisite '+id);for(const step of contract.steps){c.assert(STEP_TYPES.includes(step.do),'Unknown step '+step.do);c.assert(POI[step.poi],'Missing place '+step.poi);}}const s=createSim();c.assert(s.npcs.length>40);});\nawait c.test('Wind creates a faster downwind front and slow upwind spread',()=>{const speeds=[];for(const speed of [0,10]){const t=defaults(),f=new Fire(t,14,true);f.ignite(0,0,2);for(let i=0;i<600;i++)f.tick(.1,{angle:0,speed});const all=[...f.active,...f.burnt].map(i=>f.pos(i));const down=Math.max(...all.map(p=>p.x))/60,up=-Math.min(...all.map(p=>p.x))/60;speeds.push({speed,down,up});if(speed===0)c.assert(down<=1,'Calm '+down);else{c.assert(down>=4,'Downwind '+down);c.assert(up<=.3,'Upwind '+up);}}});\nawait c.test('Fire barrier, persistence, regrowth and embers',()=>{const t=defaults(),f=new Fire(t,21,true);f.init();for(let z=0;z<512;z++)f.fuel[z*512+258]=0;f.ignite(0,0,1);for(let i=0;i<150;i++)f.tick(.1,{angle:0,speed:10},1);c.assert(\"'![...f.active,...f.burnt].some(i=>i%512>258),'\"'Crossed fuel-free barrier');const save=f.save(),g=new Fire(t,21,true);g.load(save);c.equal([...g.burnt],[...f.burnt]);c.assert(g.regrow(5)>0);const e=new Fire({...t,embers:1},31,true);e.init();const i=e.index(0,0);e.fuel[i]=3;e.ignite(0,0,1);let embers=0;for(let j=0;j<85;j++)embers+=e.tick(.1,{angle:0,speed:10},1).embers;c.assert(embers>0,'Tree did not cast an ember');});\nawait c.test('Every gun fires, reloads, wears, jams and breaks',()=>{for(const id of Object.keys(WEAPONS)){const s=createSim({scenario:'test'});s.dev('teleport',{x:850,z:700});s.dev('allWeapons');s.action({type:'weapon',id});const g=s.currentGun();const ammo=g.ammo;s.shoot();c.assert(g.ammo<ammo,id+' did not fire');c.assert(g.condition<100,id+' did not wear');s.dev('jam');s.reload();advance(s,2);c.assert(\"'!g.jam,id+'\"' did not clear');g.ammo=0;s.reload();advance(s,4);c.assert(g.ammo>0,id+' did not reload');g.condition=.001;s.p.cooldown=0;s.shoot();c.assert(g.broken,id+' did not break');seen(s);}});\nawait c.test('Health bars, four surgeries, syringe and fever recovery',()=>{const s=createSim({scenario:'test'});s.dev('teleport','s1');for(const type of ['bullet','finger','shrapnel','burn']){s.p.hp=100;s.damage(85,type);s.heal();advance(s,3.2);c.assert(s.p.hp>=40&&s.p.hp<=41,'Surgery '+type);c.assert(s.seen.has('surgery_'+type));}s.p.hp=41;advance(s,10);c.equal(s.p.hp,60,'Regen crossed a bar');s.heal();advance(s,2);c.equal(s.p.hp,100);s.startFever();s.pill();advance(s,2);c.equal(s.p.fever,0);c.equal(s.p.doses,1);s.p.doses=0;s.startFever();advance(s,36);c.assert(s.seen.has('collapse'));s.talk('doctor');c.equal(s.p.doses,2,'No free recovery dose');seen(s);});\nawait c.test('Rescue limit and permanent buddy mercy',()=>{const s=createSim({scenario:'test'});s.dev('teleport','s1');for(let i=0;i<2;i++){s.goDown();advance(s,13);c.equal(s.p.hp,40);c.equal(s.p.down,0);}s.goDown();c.assert(\"'!s.p.rescue,'\"'Third rescue was allowed');s.p.down=0;s.p.hp=100;s.downBuddy();const id=s.mercy.buddy.id;s.resolveMercy('morphine');c.equal(s.world.buddies.find(b=>b.id===id).state,'dead');s.sleep(6);c.equal(s.world.buddies.find(b=>b.id===id).state,'dead');seen(s);});\nawait c.test('Vehicle movement, break, repair, boat and papers',()=>{const s=createSim({scenario:'test'}),b=new Bot(s);s.dev('teleport',s.vehicles[0]);b.use();c.assert(s.p.vehicle,'Cannot enter pickup');const start=s.p.z;b.wait(7,{moveZ:-1});c.assert(Math.abs(s.p.z-start)>100,'Truck did not drive 100m');s.dev('stall');b.action('use');b.go(s.vehicles[0],1);b.use(s.t.repairTime);c.assert(s.vehicles[0].health>=210,'Repair failed');const boat=s.vehicles.find(v=>v.kind==='skiff');s.dev('teleport',boat);b.use();c.assert(s.p.vehicle,'Cannot enter skiff');const x=s.p.x,z=s.p.z;b.wait(4,{moveZ:-.5});c.assert(Math.hypot(s.p.x-x,s.p.z-z)>10,'Skiff did not move');s.p.vehicle=null;s.world.papers.stewards=true;s.world.standing.stewards=0;c.assert(s.papers('gp8'));s.world.standing.stewards=-50;c.assert(\"'!s.papers('\"'gp8'));seen(s);});\nawait c.test('Posts stay clear until a supplied dawn and reinforcement truck',()=>{const s=createSim({scenario:'test'});s.dev('clearPost','gp2');advance(s,1);c.assert(s.world.post.gp2.cleared);advance(s,20);c.assert(s.world.post.gp2.cleared);s.sleep(6);c.assert(s.world.post.gp2.reinforce,'No real reinforcement truck');advance(s,60);c.assert(\"'!s.world.post.gp2.cleared);s.dev('\"'clearPost','gp8');advance(s,1);s.world.railbridge=false;s.sleep(6);c.assert(\"'!s.world.post.gp8.reinforce,'\"'Destroyed supply did not stop refill');seen(s);});\nawait c.test('Same seed and input replay identically for five sim minutes',()=>{const results=[];for(let n=0;n<2;n++){const s=createSim({seed:4321,scenario:'test'});s.dev('god',true);for(let i=0;i<18000;i++)s.tick({moveZ:i%600<300?-.4:.4,lookX:.0001});c.assert(Number.isFinite(s.p.x)&&Number.isFinite(s.p.z));results.push(createHash('sha256').update(JSON.stringify(s.save())).digest('hex'));}c.equal(results[0],results[1]);});\nawait c.test('Rapier terrain, character controller and dynamic fragments',async()=>{const physics=await createPhysics(),s=createSim({scenario:'test'});s.physics=physics;s.dev('teleport','s1');const start=s.p.z;advance(s,3,{moveZ:-1});c.assert(s.p.z<start-8,'Physics player did not move');c.assert(Number.isFinite(s.p.y));physics.debris(s.p.x,s.p.z,8);for(let i=0;i<120;i++)physics.step();physics.dispose();});\nif(c.args.has('--smoke'))return;\nawait c.test('Complete campaign through all contracts and three ending branches',async()=>{const s=createSim({seed:14014}),b=new Bot(s);s.dev('god',true);b.wait(2,{use:true});b.go({x:38,z:67},3);b.use();b.action({type:'accept',id:'c1'});b.runContract('c1');c.assert(s.world.complete.includes('c1'));c.assert(s.world.safehouses.includes('s1'));s.buy('carbine');\n for(const id of ['c2','e1','c3','c4','c5','c6','c7']){b.accept(id);if(['c2','c3','c5'].includes(id))b.action('twist');if(id==='c2'){b.go(s.entities.find(e=>e.id==='courier'),2);b.use();}b.runContract(id);c.assert(s.world.complete.includes(id),'Did not complete '+id+' '+JSON.stringify(s.contract));if(id==='c2'){c.equal(s.world.camp,200);c.assert(\"'!s.world.dump);c.equal(s.world.post.gp2.owner,'\"'stewards');}if(id==='e1')c.assert(s.p.doses>0);if(id==='c3'){c.assert(\"'!s.world.railbridge);c.equal(s.world.camp,215);}if(id==='\"'c4')c.assert(s.world.safehouses.includes('s2'));}\n c.assert(s.world.buddies.some(v=>v.state==='dead'),'C7 mercy did not resolve');b.accept('c8');while(s.contract.step<2){const st=s.objective();b.go(POI[st.poi],6);if(st.do==='talk')b.use();else b.wait(.5);}b.wait(.5);const branch=structuredClone(s.save());for(const ending of ['read','sell','burn']){s.load(structuredClone(branch));b.action({type:'choice',value:ending});if(ending==='read')b.wait(241);if(ending==='sell')b.go('landing',15);if(ending==='burn'){b.go('mission',6);for(let i=0;i<3;i++)b.use();}c.assert(s.seen.has('ending_'+ending),'Ending failed '+ending+' '+JSON.stringify(s.ending));seen(s);}await writeFile('test-output/campaign-trace.json',JSON.stringify({frames:b.frames,trace:b.trace,world:s.world},null,2));});\nawait c.test('Failed dynamite contract can be reissued after sleep',()=>{const s=createSim({scenario:'test'});s.dev('contract','c6');const v=s.vehicles.find(v=>v.kind==='cargo');s.damageVehicle(v,400);c.assert(s.contract.failed);s.sleep(6);c.assert(\"'!s.contract);s.accept('\"'c6');c.assert(\"'!s.contract.failed);c.equal(v.health,300);c.equal(v.cargo,100);});\nawait c.test('\"'The Job opens, carries, revives and banks the case',()=>{const s=createSim({scenario:'job',players:[{id:0},{id:1},{id:2},{id:3}]}),b=new Bot(s);s.dev('god',true);b.go(s.job.case,3);b.wait(12.2,{use:true});b.use();c.equal(s.job.carrier,0);const stamina=s.p.stamina;b.wait(1,{moveZ:-1,sprint:true});c.assert(s.p.stamina>=stamina-.1,'Carrier sprinted');s.remotePlayers[1]={id:1,x:s.p.x+1,z:s.p.z,hp:0,down:2};s.revive(1);b.wait(3.2);c.equal(s.remotePlayers[1].hp,40);b.go({x:150,z:110},10);b.use();c.assert(s.job.finished&&s.job.onBarge,'Case did not bank');c.assert(s.events.some(e=>e.type==='jobEnd'&&e.won));seen(s);});\nawait c.test('Attract runs a whole loop with broad feature coverage',async()=>{const reel=new Attract(()=>{});for(let i=0;i<14*27*60+1;i++)reel.tick();c.assert(reel.index===0);seen(reel.sim);const percent=reel.sim.seen.size/FEATURES.length;await writeFile('test-output/attract-coverage.json',JSON.stringify({percent,seen:[...reel.sim.seen],missing:FEATURES.filter(f=>\"'!reel.sim.seen.has(f))},null,2));c.assert(percent>=.8,'\"'Attract coverage '+Math.round(percent*100)+'%');});\nawait writeFile('test-output/feature-coverage.json',JSON.stringify({coverage:coverage.size/FEATURES.length,seen:[...coverage],missing:FEATURES.filter(f=>\"'!coverage.has(f))},null,2));\n}\nEOF\nnode tools/test.mjs --sim'","aggregated_output":"FAIL Fire barrier, persistence, regrowth and embers: Error: Values differ [130817,131328,131329,131841] != [131328,131329,131841,130817]\n    at Object.equal (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-075003__xc21248/work/Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003/tools/test.mjs:6:354)\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-075003__xc21248/work/Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003/tools/tests/sim.mjs:20:370\n    at Object.test (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-075003__xc21248/work/Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003/tools/test.mjs:6:44)\n    at run (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-075003__xc21248/work/Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003/tools/tests/sim.mjs:20:9)\n    at async file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-075003__xc21248/work/Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003/tools/test.mjs:7:157\nFAIL Vehicle movement, break, repair, boat and papers: Error: Skiff did not move\n    at Object.assert (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-075003__xc21248/work/Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003/tools/test.mjs:6:255)\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-075003__xc21248/work/Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003/tools/tests/sim.mjs:24:601\n    at Object.test (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-075003__xc21248/work/Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003/tools/test.mjs:6:44)\n    at run (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-075003__xc21248/work/Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003/tools/tests/sim.mjs:24:9)\n    at async file:///home/micha/dev/cc-matrix/r