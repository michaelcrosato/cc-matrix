{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/sim/index.js');s=p.read_text()\ns=s.replace(\\\"context(){const p=this.p;\\\", \\\"endingMark(){const marks=[[18,14],[-18,25],[5,40]],v=marks[Math.min(2,this.ending?.marks||0)];return {x:POI.mission.x+v[0],z:POI.mission.z+v[1]};}\\\\n context(){const p=this.p;if(this.ending?.kind==='burn'&&this.ending.marks<3&&dist(p,this.endingMark())<8)return {kind:'endingmark',label:'Light ridge mark '+(this.ending.marks+1)+' / 3'};\\\")\ns=s.replace(\\\"case 'revive':this.revive(ctx.id);\\\", \\\"case 'endingmark':this.advanceEnding();break;case 'revive':this.revive(ctx.id);\\\")\na=s.index(\\\"advanceEnding(){\\\");b=s.index(\\\" updateEnding(dt)\\\",a)\ns=s[:a]+\\\"\\\"\\\"advanceEnding(){if(\"'!this.ending)return;if(this.ending.kind==='\"'burn'&&this.ending.marks<3){const mark=this.endingMark();this.fire.init();for(let dz=-2;dz<=2;dz++)for(let dx=-2;dx<=2;dx++){const i=this.fire.index(mark.x+dx*4,mark.z+dz*4);if(i>=0&&i<this.fire.fuel.length)this.fire.fuel[i]=2;}this.ignite(mark.x,mark.z,10);this.ending.marks++;if(this.ending.marks>=3){this.weather='rain';this.ending.progress=0;this.p.objective='Run through your fire. The rain is coming.';this.say('notary','No records exist. Some people do.');}else{this.p.waypoint=this.endingMark();this.say('notary',this.ending.marks+' marks. The wind has your handwriting.');}}if(this.ending.kind==='sell'&&dist(this.p,POI.landing)<30)this.finishEnding('sell');}\n+\\\"\\\"\\\".replace('\\\\n+','\\\\n')+s[b:]\ns=s.replace(\\\"this.nextStep();if(this.ending)this.p.objective=\\\", \\\"this.nextStep();if(value==='burn')this.p.waypoint=this.endingMark();if(value==='sell')this.p.waypoint={...POI.landing};if(this.ending)this.p.objective=\\\")\ns=s.replace(\\\"this.p.objective==='\\\", \\\"this.p.objective==='\\\")\np.write_text(s)\np=Path('tools/tests/sim.mjs');s=p.read_text();s=s.replace(\\\"b.go