{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/data/features.js');s=p.read_text();a=s.index('export const TIPS=');s=s[:a]+'''const notes={\nfire_spread:'A road can stop grass fire. Strong wind can carry embers across it.',wind_shift:'The cloth on your gun follows the wind. Believe it.',flare_ignite:'A flare lights dry fuel where it lands.',molotov:'Throw a Molotov into grass or through the truck window.',torch_flame:'The Drip Torch makes a path you may not want to follow.',rocket:'The Tube turns vehicles and cover into shrapnel.',explosion_physics:'Get behind solid cover before the tank cooks off.',tree_burn:'Trees burn longer than grass and throw embers.',ember_spot:'A tree can start another fire thirty metres downwind.',regrow:'Black ground persists. Grass returns after several days.',\njam:'A rusty gun makes its own decisions. Reload to clear it.',jam_clear:'Clearing a jam costs time. Move into cover first.',gun_break:'A gun at zero condition is scrap. Take another.',rust_visual:'More rust means more jams. The Widow sells certainty.',loot_gun:'Scavenged guns are worn, but their magazines still count.',shop_buy:'The Widow takes diamonds. Factory guns start at full condition.',armoury_redraw:'An armoury gives your owned guns a clean start after sleep.',\nheal_syringe:'Syringes heal fully. Safehouses refill the pouch.',surgery_bullet:'At one health bar, healing becomes free field surgery.',surgery_finger:'A bad landing can leave a finger out of line.',surgery_shrapnel:'Shrapnel comes out slowly. Find cover first.',surgery_burn:'Wrap the burn. Surgery buys two bars, not a clean bill.',fever:'Bark buys time. The Doctor buys favours.',pill:'Take bark during the warning. Do not wait for the blackouts.',collapse:'Without bark you lose six hours, a diamond and gun condition.',\nrescue:'A friend can carry you once before they need sleep.',buddy_down:'Reach a wounded friend before their minute runs out.',mercy:'A syringe is a chance. Morphine is a promise.',twist_offer:'A buddy offers extra risk for diamonds and trust.',twist_done:'Friends remember when you took the longer way for them.',papers_ok:'Slow down. Lower the gun. Show the right papers.',papers_fail:'Bad standing or cargo can make good papers worthless.',post_clear:'A cleared post stays empty until a supplied dawn.',post_regarrison:'Cut the fuel or rail and the reinforcement truck cannot come.',\nmonocular_tag:'Hold the monocular on a guard to mark their position.',machete_takedown:'The machete is silent and decisive from behind.',crouch_grass:'Crouch in long grass. Moving slowly keeps suspicion down.',night_stealth:'At night, lamps and flames betray what darkness hides.',map_raise:'Raise the map on foot or at the wheel.',map_focus:'Focus the map to see the whole country.',map_drive:'You can read the map while driving. Focus makes you coast.',gps_waypoint:'Mark the paper and the GPS points the way.',locator_found:'A faster beep means a closer diamond case.',diamond:'Small change. Large consequences. Spend it at the Yard.',dictation:'The Notary kept a second book. Listen to what he recorded.',\ndrive:'The truck is faster than fire. Until its engine is not.',breakdown:'Smoke is a warning. A stalled engine needs a wrench.',repair:'Get out. Hold Use at the engine to restore seventy percent.',mounted_gun:'Switch seats in a Technical. The wheel is left free.',skiff:'Stay in the channel. A skiff stops in the shallows.',ferry:'The Ferryman connects the Landing, Bridge Pier and Second Water.',truck_cargo:'Sharp turns damage dynamite cargo. Fire settles the account.',train:'The payroll car only pays if it reaches the wreck.',sleep_time:'Sleep chooses the light, restores friends and saves your account.',save_load:'The latest account has a backup if the paper tears.',day_night:'A day takes thirty-six minutes. Sleep can choose the hour.',ceasefire_town:'Kiln and Second Water require a lowered gun.',ragdoll:'Bodies stay where the fighting put them.',wounded_crawl:'A fallen guard may still be alive.',comrade_drag:'Men will leave cover to carry a wounded comrade.',animals_flee:'Gunfire and flames scatter the herds.',\nending_read:'The transmitter needs four uninterrupted minutes in the church grounds.',ending_sell:'The book has a buyer waiting at the Landing.',ending_burn:'Light three ridge marks. Keep Second Water behind your fire.',coop_revive:'A teammate needs three seconds and one syringe.',coop_case:'The case carrier has a sidearm and cannot sprint.'};\nexport const TIPS=Object.fromEntries(FEATURES.map(id=>[id,notes[id]]));\n''';p.write_text(s)\np=Path('src/main.js');s=p.read_text().replace(\\\"state:()=>app.state(),step\\\", \\\"state:()=>structuredClone(app.state()),step\\\");p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
