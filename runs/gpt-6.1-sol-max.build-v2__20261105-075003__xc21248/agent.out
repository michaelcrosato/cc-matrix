{"type":"item.started","item":{"id":"item_193","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json,re,hashlib,os\nroot=Path.cwd();dev=root/'Fare-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-075003';project=json.loads((dev/'project.json').read_text());game=root/(project['basename']+'.html');raw=game.read_text();interview=json.loads((root/'exit-interview.json').read_text());about=json.loads((dev/'src/data/about.json').read_text());client=(dev/'vendor/session.js').read_text();results=json.loads((dev/'test-output/last-results.json').read_text());coverage=json.loads((dev/'test-output/feature-coverage.json').read_text());attract=json.loads((dev/'test-output/attract-coverage.json').read_text());viewports=json.loads((dev/'test-output/viewport-report-summary.json').read_text())\nassert interview==about\nassert set(interview)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'}\nassert [len(interview[k]) for k in ['testingFeedback','engineFeedback','promptFeedback']]==[4,6,4]\nassert interview['sourceInformation']['usage']=='added on import'\nassert all(v.strip() for v in interview['sourceInformation'].values())\nassert raw.startswith('<\"'!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">'\"\\\\n<script>'+client+'</script>')\nassert 'THIRD-PARTY NOTICES' in raw and 'The MIT License' in raw and 'Apache License' in raw\nassert results['failed']==0 and results['passed']==42\nassert not coverage['missing'] and coverage['coverage']==1\nassert attract['percent']>=.8\nassert len(viewports['results'])==24\nassert not [r for r in viewports['results'] if r.get('error') or r.get('overflow') or r.get('console_errors') or r.get('page_errors') or r.get('failed_requests')]\nassert not any(re.search(r'TODO|FIXME|placeholder|stub',p.read_text()) for p in (dev/'src').rglob('*') if p.is_file())\nactive=[]\nfor p in Path('/proc').iterdir():\n if not p.name.isdecimal():continue\n try:\n  if (p/'cwd').resolve()\"'!=dev:continue\n  args=(p/'\"'cmdline').read_bytes().split(b'\\\\0')\n  if args and b'node' in args[0] and any(b'tools/test.mjs' in a or b'tools/shots.mjs' in a or b'tools/driving-shot.mjs' in a for a in args):active.append(int(p.name))\n except (OSError,PermissionError):pass\nassert not active,active\nmanifest={'title':project['title'],'html':game.name,'bytes':game.stat().st_size,'sha256':hashlib.sha256(game.read_bytes()).hexdigest(),'tests':{'passed':42,'failed':0},'features':len(coverage['seen']),'attractCoverage':attract['percent'],'viewportCombinations':len(viewports['results']),'originalHubClientBytes':len(client.encode()),'interviewMatchesAbout':True}\n(dev/'test-output/final-verification.json').write_text(json.dumps(manifest,indent=2)+'\\\\n')\nprint(json.dumps(manifest,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
