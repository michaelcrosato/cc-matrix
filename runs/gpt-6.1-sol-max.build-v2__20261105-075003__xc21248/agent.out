{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"sed -n '25,80p' tools/hub/harness.html && rg -n 'releaseRound|startRound|newround|auto\\\\)' tools/hub/harness.html\"","aggregated_output":"  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n  .cell.is-out { opacity: .35; }\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\n  #checks li { list-style: none; }\n  #checks ul { margin: 0; padding: 0; }\n  .ok::before { content: '✓ '; color: var(--ok); }\n  .bad::before { content: '✗ '; color: var(--bad); }\n  .wait::before { content: '… '; color: var(--warn); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n264:function releaseRound(state = current) {\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n361:$('release').onclick = () => releaseRound();\n451:    releaseRound(state);\n544:if (auto) conformance();\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"cat > tools/tests/hub.mjs <<'EOF'\nimport {createServer} from 'node:http';\nimport {readFile,writeFile,mkdir,copyFile} from 'node:fs/promises';\nimport {resolve,extname} from 'node:path';\nimport {chromium} from 'playwright';\nimport {GPU_ARGS} from './ui.mjs';\nexport async function run(c){await mkdir('test-output/site',{recursive:true});for(const f of ['harness.html','bridge.js','round.js'])await copyFile('tools/hub/'+f,'test-output/site/'+f);const project=JSON.parse(await readFile('project.json','utf8'));await copyFile(resolve('..',project.basename+'.html'),'test-output/site/GAME.html');const root=resolve('test-output/site');const server=createServer(async(req,res)=>{try{const name=decodeURIComponent(new URL(req.url,'http://localhost').pathname);const p=resolve(root,'.'+name);if(\"'!p.startsWith(root))throw Error('\"'Path');const data=await readFile(p);res.writeHead(200,{'Content-Type':extname(p)==='.js'?'text/javascript':'text/html'});res.end(data);}catch{res.writeHead(404);res.end('Not found');}});await new Promise(r=>server.listen(0,'127.0.0.1',r));const base='http://127.0.0.1:'+server.address().port;let browser;try{browser=await chromium.launch({headless:true,args:GPU_ARGS});let page=await browser.newPage({viewport:{width:800,height:600}});const cases=c.args.has('--smoke')?[[2,'standard']]:[[2,'standard'],[3,'standard'],[4,'standard'],[3,'host-leave'],[4,'host-leave'],[2,'server']];for(const [players,scenario] of cases)await c.test(\"'`AI Hub ${players} seats ${scenario}`,async()=>{await page.goto(`${base}/harness.html?game=GAME.html&players=${players}&latency=150&jitter=50&loss=5&auto=1&play=8000&scenario=${scenario}`);await page.waitForFunction(()=>window.__hubCheck?.pass||document.body.dataset.complete==='\"'true',null,{timeout:300000});const state=await page.evaluate(()=>({check:window.__hubCheck,text:document.body.innerText}));await writeFile(\"'`test-output/hub-${players}-${scenario}.json`,JSON.stringify(state,null,2));c.assert(state.check?.pass,state.text);});\nif(c.args.has('\"'--smoke'))return;\nawait c.test('Two real Hub players share fire, revive and deliver the case',async()=>{await page.goto(\"'`${base}/harness.html?game=GAME.html%3Ftest%3D1&players=2&latency=150&jitter=50&loss=5&limit=180`);await page.locator('\"'#restart').click();await page.waitForFunction(()=>[...document.querySelectorAll('iframe')].length===2&&[...document.querySelectorAll('iframe')].every(f=>f.contentWindow?.__game?.state().screen==='card'),null,{timeout:30000});const frames=page.frames().filter(f=>f.url().includes('GAME.html'));for(const f of frames)await f.evaluate(()=>AIHub.answer('ready'));await page.locator('#release').click();await frames[0].waitForFunction(()=>AIHub.time()>0&&__game.state().screen==='play',null,{timeout:30000});for(const f of frames){await f.evaluate(()=>{__game.setRendering(false);__game.dev('god',true);});}const host=frames[0],client=frames[1];await host.evaluate(()=>{const original=AIHub.finish;AIHub.finish=data=>{window.__finishRecord=data;return original(data);};__game.dev('teleport',{x:530,z:490});__game.dev('ignite');});await client.waitForFunction(()=>__game.state().fire.burning>0,null,{timeout:15000});await client.evaluate(()=>{__game.dev('teleport',{x:535,z:490});__game.dev('down');});await host.waitForFunction(()=>__game.state().job.players.length===2,null,{timeout:10000});await page.waitForTimeout(800);await host.evaluate(()=>{__game.action({type:'revive',id:1});__game.step(200);});await client.waitForFunction(()=>__game.state().player.hp>=40&&\"'!__game.state().player.down,null,{timeout:15000});await host.evaluate(()=>{__game.dev('\"'teleport',{x:560,z:520});__game.input({use:true});__game.step(740);__game.input(null);__game.action('use');});c.equal((await host.evaluate(()=>__game.state())).job.carrier,0);await host.evaluate(()=>{__game.dev('teleport',{x:150,z:110});__game.action('use');});await host.waitForFunction(()=>window.__finishRecord?.won===true,null,{timeout:10000});const result=await host.evaluate(()=>({finish:__finishRecord,state:__game.state()}));c.equal(result.finish.won,true);c.equal(Object.keys(result.finish.scores).sort(),['0','1']);c.equal(result.finish.scores['0'],65);c.equal(result.finish.scores['1'],50);c.equal(result.state.net.rejected,0);c.assert(result.state.net.maxSnapshot<=1200,'Snapshot '+result.state.net.maxSnapshot);await writeFile('test-output/real-coop.json',JSON.stringify(result,null,2));});\nawait page.close();\nawait c.test('Same-computer lobby joins, exchanges traffic and shows results',async()=>{const context=await browser.newContext({viewport:{width:640,height:360}}),host=await context.newPage();let client;try{await host.goto(base+'/GAME.html?test=1');await host.waitForFunction(()=>__game.state().screen==='title',null,{timeout:120000});await host.evaluate(()=>__game.setRendering(false));await host.getByRole('button',{name:/\"'^The Job/}).click();await host.getByRole('\"'button',{name:'Same computer',exact:true}).click();await host.getByRole('button',{name:'Start the job',exact:true}).waitFor();client=await context.newPage();await client.goto(base+'/GAME.html?test=1');await client.waitForFunction(()=>__game.state().screen==='title',null,{timeout:120000});await client.evaluate(()=>__game.setRendering(false));await client.getByRole('button',{name:/\"'^The Job/}).click();await client.getByRole('\"'button',{name:'Same computer',exact:true}).click();await client.getByRole('button',{name:'Join the waiting account',exact:true}).click();await host.waitForFunction(()=>document.querySelectorAll('.player-seat').length===2,null,{timeout:10000});await host.getByRole('button',{name:'Start the job',exact:true}).click();await client.waitForFunction(()=>__game.state().screen==='play',null,{timeout:10000});await host.waitForTimeout(10000);const a=await host.evaluate(()=>__game.state()),b=await client.evaluate(()=>__game.state());c.assert(a.net.sent>5&&a.net.received>5&&b.net.sent>5&&b.net.received>5,'No bidirectional link traffic '+JSON.stringify([a.net,b.net]));c.equal(a.mode,'link');await host.evaluate(()=>{__game.dev('god',true);__game.dev('teleport',{x:560,z:520});__game.input({use:true});__game.step(740);__game.input(null);__game.action('use');__game.dev('teleport',{x:150,z:110});__game.action('use');});await client.waitForFunction(()=>__game.state().screen==='jobResults',null,{timeout:10000});c.assert((await client.evaluate(()=>__game.state())).job.onBarge);c.equal(a.net.rejected,0);}finally{await context.close();}});\nawait browser.close();browser=await chromium.launch({headless:true});page=await browser.newPage({viewport:{width:800,height:600}});await c.test('AI Hub four-player default WebGL2 browser',async()=>{await page.goto(base+'/harness.html?game=GAME.html&players=4&latency=150&jitter=50&loss=5&auto=1&play=8000');await page.waitForFunction(()=>window.__hubCheck?.pass||document.body.dataset.complete==='true',null,{timeout:300000});const data=await page.evaluate(()=>({check:window.__hubCheck,text:document.body.innerText}));await writeFile('test-output/hub-webgl2-four.json',JSON.stringify(data,null,2));c.assert(data.check?.pass,data.text);});\n}finally{await browser?.close();await new Promise(r=>server.close(r));}}\nEOF\nnode tools/build.mjs --quiet && node tools/test.mjs --hub\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
