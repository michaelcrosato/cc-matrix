{"type":"item.started","item":{"id":"item_170","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\np=Path('src/view/index.js');s=p.read_text().replace(\\\"update(s,mode='play',dt=1/60){if(\"'!disposed)updateWorld(s,mode,Math.min(dt,.15));}\", \"update(s,mode='\"'play',dt=clock.getDelta()){if(\"'!disposed)updateWorld(s,mode,s.paused?0:Math.min(dt*s.t.timeScale,.15));}\");p.write_text(s)\np=Path('\"'src/main.js');s=p.read_text().replace(\\\"?'title':'play',1/30);\\\", \\\"?'title':'play');\\\");p.write_text(s)\np=Path('tools/test.mjs');s=p.read_text().replace(\\\"for(const flag of ['--sim','--ui','--hub','--viewports']){let result;\\\", \\\"for(const flag of ['--sim','--ui','--hub','--viewports']){await writeFile('test-output/last-results.json',JSON.stringify({passed:0,failed:1,failures:[flag+' terminated before reporting']}));let result;\\\");p.write_text(s)\np=Path('src/data/about.json');a=json.loads(p.read_text());a['testingFeedback'][0]=a['testingFeedback'][0].replace('19 gameplay','21 gameplay');a['testingFeedback'][1]=a['testingFeedback'][1].replace('6 game-breaking','7 game-breaking').replace('and an opaque windshield blocking the driving view.', 'an opaque windshield blocking the driving view, and an escaped convoy leaving a required contract active.');p.write_text(json.dumps(a,indent=2)+'\\\\n')\np=Path('docs/issues-log.md');s=p.read_text().replace('Testing tally: 19 confirmed product issues, including 6 game-breaking issues.', '''20. Accepting a contract could replace the newly opened buddy-twist sheet with the play screen. UI actions now leave queued events to the next simulation tick. A browser test accepts the real offer and chooses the twist.\n21. **Critical:** an escaped radio convoy could leave its required contract permanently active. Escapes now fail the job for a sleep/reissue; the moving truck and its surviving driver supply the GPS target, and a destroyed truck skips the dead-driver conversation.\n\nTesting tally: 21 confirmed product issues, including 7 game-breaking issues.''');s+='\\\\nFinal test infrastructure uses fresh browser processes for Hub cases and waits for available RAM before loading multiple copies. Missing child-process reports cannot be mistaken for a previous tier result. Animation mixers use elapsed render time rather than a hardcoded frame duration.\\\\n';p.write_text(s)\np=Path('../PROGRESS.md');s=p.read_text();s+='''\\\\n## Final regression target\\\\n- Added meaningful UI acceptance/twist and convoy-escape recovery assertions. Suite now contains 40 checks: sim 15, UI 15, Hub 9 and one 24-combination viewport matrix.\\\\n- Corrected the offer/twist event ordering and added convoy escape failure/reissue, moving GPS and visible driver. Product issue tally is 21 corrected issues, 7 critical; metadata/interview updated.\\\\n- Headless Hub cases now use fresh browsers with a RAM gate. Earlier memory crashes remain environmental reports and are not product issue counts.\\\\n- Source now uses normal elapsed render time for animation. Next action is the final build/test command, then the warmed driving screenshot and cleanup. No more feature work.\\\\n''';p.write_text(s)\nPY\nnode --check src/main.js && node --check src/view/index.js && node --check tools/tests/ui.mjs && node --check tools/tests/hub.mjs && node --check tools/test.mjs && node tools/build.mjs --quiet && node tools/test.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_171","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/main.js');s=p.read_text();s=s.replace(\\\"else if(e.type==='sfx')this.sound.play(e.name);\\\", \\\"else if(e.type==='npcShot'){const p=this.sim.p,dx=e.x-p.x,dz=e.z-p.z,d=Math.hypot(dx,dz);this.sound.play('gun',{weapon:'carbine',volume:.25/Math.max(1,d/20),pan:(dx*Math.cos(p.yaw)+dz*Math.sin(p.yaw))/Math.max(1,d)});}else if(e.type==='sfx')this.sound.play(e.name);\\\")\np.write_text(s)\np=Path('src/audio/index.js');s=p.read_text();old=\\\"recipe(this.ctx,this.nodes[bus],name,{seed:14+this.counter++,...options});\\\";new=\\\"let out=this.nodes[bus],gain=null,panner=null;if(options.volume\"'!==undefined){gain=this.ctx.createGain();gain.gain.value=options.volume;if(options.pan!==undefined){panner=this.ctx.createStereoPanner();panner.pan.value=clamp(options.pan,-1,1);gain.connect(panner).connect(out);}else gain.connect(out);out=gain;}const duration=recipe(this.ctx,out,name,{seed:14+this.counter++,...options});if(gain)setTimeout(()=>{gain.disconnect();panner?.disconnect();},((duration||1)+.2)*1000);\";assert old in s;s=s.replace(old,new);p.write_text(s)\np=Path('\"'src/view/index.js');s=p.read_text();s=s.replace(\\\"rig.bones[12].add(rifle);scene.add(rig.root);\\\", \\\"const flash=new THREE.Mesh(new THREE.IcosahedronGeometry(.14,0),new THREE.MeshBasicNodeMaterial({color:0xffdf8a}));flash.position.set(0,.06,-1);flash.visible=false;rifle.add(flash);rig.muzzle=flash;rig.bones[12].add(rifle);scene.add(rig.root);\\\")\ns=s.replace(\\\"rig.root.visible=true;rig.root.position.set(n.x\\\", \\\"rig.root.visible=true;if(rig.muzzle)rig.muzzle.visible=(rig.shot||0)>0;rig.shot=Math.max(0,(rig.shot||0)-dt);rig.mesh.material.color.set(n.state==='charred'?0x1b1512:0xffffff);rig.root.position.set(n.x\\\")\ns=s.replace(\\\"event(e){if(e.type==='shot')\\\", \\\"event(e){if(e.type==='npcShot'){const rig=npcViews.get(e.id);if(rig)rig.shot=.08;}if(e.type==='shot')\\\")\np.write_text(s)\np=Path('src/sim/index.js');s=p.read_text().replace(\\\"this.hitNPC(n,dt*25,'burn');n.state='flee-fire';\\\", \\\"this.hitNPC(n,dt*25,'burn');if(n.hp>0)n.state='flee-fire';\\\");p.write_text(s)\np=Path('tools/tests/sim.mjs');s=p.read_text();needle=\\\"await c.test('Health bars, four surgeries, syringe and fever recovery'\\\";addition=\\\"await c.test('A guard killed by fire stays a charred corpse',()=>{const s=createSim({scenario:'test'}),n=s.npcs.find(n=>n.poi==='gp2');n.hp=1;s.ignite(n.x,n.z,5);advance(s,1);c.equal(n.hp,0);c.equal(n.state,'charred');});\\\\n\\\";assert needle in s;s=s.replace(needle,addition+needle);p.write_text(s)\nPY\nnode --check src/main.js && node --check src/audio/index.js && node --check src/view/index.js && node --check tools/tests/sim.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
