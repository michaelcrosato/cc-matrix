yers.length\"'!==1)return;if(!this.companion)this.companion={id:'\"'job_buddy',merc:(this.p.merc+1)%4,x:this.p.x-3,z:this.p.z-3,yaw:0,state:'walk',shot:0};const c=this.companion,d=dist(c,this.p),theta=Math.atan2(this.p.x-c.x,-(this.p.z-c.z));c.yaw=theta;if(d>5){c.x+=Math.sin(theta)*dt*Math.min(8,d);c.z-=Math.cos(theta)*dt*Math.min(8,d);}c.shot-=dt;const enemy=this.npcs.filter(n=>n.hp>0&&dist(n,c)<45).sort((a,b)=>dist(a,c)-dist(b,c))[0];if(enemy&&\"'!this.p.down){c.state='\"'aim';c.yaw=Math.atan2(enemy.x-c.x,-(enemy.z-c.z));if(c.shot<0){c.shot=1.6;this.hitNPC(enemy,24,'bullet');this.emit('npcShot',{id:c.id,x:c.x,z:c.z});}}else c.state=this.p.down?'kneel':d>5?'walk':'idle';}\n\\\"\\\"\\\"\ns=s.replace(' revive(id){',insert+' revive(id){')\ns=s.replace(\\\"this.mark('rescue');this.emit('animation'\\\", \\\"this.mark('rescue');if(this.scenario==='job')this.mark('coop_revive');this.emit('animation'\\\")\np.write_text(s)\np=Path('src/main.js');s=p.read_text();s=s.replace(\\\"const queue=this.queue.splice(0);for(const e of queue){\\\", \\\"const queue=this.queue.splice(0);for(const e of queue){if(this.ui.screen==='title'&&['voice','notice','objective'].includes(e.type))continue;\\\")\ns=s.replace(\\\"this.sim.ignite(536,518,12);\\\", \\\"this.sim.ignite(480,425,16);this.sim.ignite(498,432,12);\\\")\ns=s.replace(\\\"app.sim.ignite(536,518,14);\\\", \\\"app.sim.ignite(480,425,16);app.sim.ignite(498,432,12);\\\")\np.write_text(s)\np=Path('src/view/index.js');s=p.read_text();s=s.replace(\\\"new THREE.ConeGeometry(.38,1.3,3,1)\\\",\\\"new THREE.ConeGeometry(.09,1.3,3,1)\\\")\ns=s.replace('new Float32Array(30000*3)', 'new Float32Array(65000*3)').replace('i<30000;i++','i<65000;i++').replace('Math.sqrt(r())*185','Math.sqrt(r())*145')\ns=s.replace('2.2+Math.sin(i+age*3)*.6','3.6+Math.sin(i+age*3)*.8')\ns=s.replace('hatchAmt=uniform(.42)','hatchAmt=uniform(.24)')\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
