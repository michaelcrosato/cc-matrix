55: updateJob(dt,frame){if(this.job.finished)return;if(!this.p.dead&&!this.p.down&&this.job.progress<12&&dist(this.p,this.job.case)<8&&frame.use){this.job.progress+=dt;if(this.job.progress>=12){this.job.phase='case';this.say('guard','Strongbox is open. The whole field heard that.');}}if(this.elapsed>this.job.depart||this.job.onBarge&&this.allAboard())this.finishJob();if(this.p.down&&this.job.players.length===1&&this.p.rescue?.left<.1)this.mark('coop_revive');}\n","exit_code":0,"status":"completed"}}
