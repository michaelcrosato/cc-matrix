{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/sim/index.js');s=p.read_text().replace(\\\"import {heightAt,riverDistance}\\\",\\\"import {heightAt,surfaceHeight,riverDistance}\\\")\ns=s.replace(\\\"import {Fire} from './fire.js';\\\",\\\"import {Fire} from './fire.js';\\\\nimport {findPath} from './navigation.js';\\\")\ns=s.replace(\\\"v.kind==='skiff'?-1.5:heightAt(v.x,v.z)+1\\\", \\\"v.kind==='skiff'?-1.5:surfaceHeight(v.x,v.z)+1\\\")\ns=s.replace(\\\"p.holstered=dist(p,POI.kiln)<66||dist(p,POI.camp)<38;\\\", \\\"p.holstered=(dist(p,POI.kiln)<66||dist(p,POI.camp)<38)&&\"'!this.world.flags.drawn;\")\ns=s.replace(\"lineClear(a,b){for(let i=1;\", \"lineClear(a,b){if(this.physics?.obstructed({x:a.x,y:heightAt(a.x,a.z)+1.6,z:a.z},{x:b.x,y:heightAt(b.x,b.z)+1.6,z:b.z}))return false;for(let i=1;\")\ns=s.replace(\"if(!this.fire.near(nx,nz,5)){n.x=nx;n.z=nz;}\",\"if(!this.fire.near(nx,nz,5)){n.x=nx;n.z=nz;}else{if(!n.path?.length||this.elapsed-(n.pathAt||0)>5){n.path=findPath(n,p,this.fire,{limit:80});n.pathAt=this.elapsed;}const q=n.path?.[0];if(q){const theta=Math.atan2(q.x-n.x,q.z-n.z);n.x+=Math.sin(theta)*dt*2;n.z+=Math.cos(theta)*dt*2;if(dist(n,q)<2)n.path.shift();}}\")\np.write_text(s)\np=Path('\"'src/view/index.js');s=p.read_text().replace(\\\"import {heightAt,roadDistance\\\", \\\"import {heightAt,surfaceHeight,roadDistance\\\").replace(\\\"heightAt(x,z)+y,z);\\\", \\\"(y===.16?surfaceHeight(x,z):heightAt(x,z))+y,z);\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
