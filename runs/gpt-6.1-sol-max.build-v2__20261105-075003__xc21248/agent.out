{"type":"item.started","item":{"id":"item_184","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,json\nout=Path('vendor/licenses');out.mkdir(exist_ok=True)\nfor name,source in [('three-MIT.txt','node_modules/three/LICENSE'),('Bebas-Neue-OFL.txt','node_modules/@fontsource/bebas-neue/LICENSE'),('Oswald-OFL.txt','node_modules/@fontsource/oswald/LICENSE'),('Special-Elite-package-OFL.txt','node_modules/@fontsource/special-elite/LICENSE'),('Reenie-Beanie-package-OFL.txt','node_modules/@fontsource/reenie-beanie/LICENSE'),('Apache-2.0.txt','node_modules/playwright/LICENSE')]: shutil.copyfile(source,out/name)\n(out/'NOTICE.txt').write_text('Fare Cry third-party notices\\\\n\\\\nThree.js r180: MIT (copyright notice retained in three-MIT.txt).\\\\nRapier 0.19.3: Apache-2.0, as declared by its published npm package.\\\\nBebas Neue and Oswald: SIL Open Font License 1.1.\\\\nSpecial Elite and Reenie Beanie font packages provide OFL-1.1 notices; the Google Fonts upstream Special Elite directory also supplies Apache-2.0. Both notice/license forms are retained.\\\\nAI Hub Session Client 1.4.0: unmodified user-requested upstream client; its distribution license is unknown.\\\\n')\np=Path('src/data/about.json');a=json.loads(p.read_text());a['sourceInformation']['research']+=' Published font and Apache license notices.';p.write_text(json.dumps(a,indent=2)+'\\\\n')\np=Path('src/ui/index.js');s=p.read_text().replace('Special Elite — Apache-2.0.', 'Special Elite — upstream Apache-2.0; package OFL notice retained.');p.write_text(s)\np=Path('tools/build.mjs');s=p.read_text().replace(\\\"readFile,writeFile,mkdir}\\\",\\\"readFile,writeFile,mkdir,readdir}\\\");s=s.replace(\\\"const html='<\"'!doctype\", \"let notices='\"'';for(const f of await readdir('vendor/licenses'))notices+='\\\\\\\\n'+f+'\\\\\\\\n'+await readFile('vendor/licenses/'+f,'utf8');\\\\nconst html='<\"'!doctype\");s=s.replace(\"</style></head><body><script type='\"\\\\\\\"module\\\\\\\">'+bundle\\\", \\\"</style></head><body><\"'!-- THIRD-PARTY NOTICES'\"\\\\\\\\n'+notices.replaceAll('-->','-- >')+'\\\\\\\\n--><script type=\\\\\\\"module\\\\\\\">'+bundle\\\");p.write_text(s)\nPY\nnode --check tools/build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
