{"type":"item.completed","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -lc \"sed -n '188,240p' /home/micha/.local/bin/viewport-matrix && sed -n '32,48p' /home/micha/.local/bin/viewport-matrix && sed -n '54,90p' /home/micha/.local/bin/viewport-matrix\"","aggregated_output":"async def main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"url\")\n    ap.add_argument(\"-o\", \"--out\", default=None, help=\"output dir (default: $TMPDIR/viewport-matrix/<timestamp>)\")\n    ap.add_argument(\"--engines\", default=\",\".join(ENGINES), help=\"comma list from chromium,webkit,firefox\")\n    ap.add_argument(\"--all-engines\", action=\"store_true\", help=\"run every device on every selected engine\")\n    ap.add_argument(\"--only\", default=None, help=\"comma list of categories: phone,foldable,tablet,desktop\")\n    ap.add_argument(\"--devices\", default=None, help=\"comma list of Playwright device names to use instead of the built-in matrix\")\n    ap.add_argument(\"--full-page\", action=\"store_true\", help=\"capture the whole scrollable page, not just the viewport\")\n    ap.add_argument(\"--dpr1\", action=\"store_true\", help=\"force device pixel ratio 1 (smaller PNGs)\")\n    ap.add_argument(\"--wait\", type=int, default=800, help=\"extra ms to wait after load for animations (default 800)\")\n    ap.add_argument(\"--timeout\", type=int, default=45, help=\"navigation timeout in seconds (default 45)\")\n    ap.add_argument(\"--headed\", action=\"store_true\", help=\"show the browser windows\")\n    args = ap.parse_args()\n\n    allowed = [e.strip() for e in args.engines.split(\",\") if e.strip()]\n    bad = set(allowed) - set(ENGINES)\n    if bad:\n        sys.exit(f\"unknown engine(s): {', '.join(bad)}\")\n    out = Path(args.out or Path(os.environ.get(\"TMPDIR\", \"/tmp\")) / \"viewport-matrix\" / time.strftime(\"%Y%m%d-%H%M%S\")).resolve()\n    out.mkdir(parents=True, exist_ok=True)\n\n    slot = wait_for_slot()  # noqa: F841 -- the lock is held while this file object stays open\n    async with async_playwright() as pw:\n        if args.devices:\n            names = [d.strip() for d in args.devices.split(\",\") if d.strip()]\n            unknown = [n for n in names if n not in pw.devices]\n            if unknown:\n                sys.exit(f\"unknown device(s): {unknown}\\nsee: python3 -c \\\"from playwright.sync_api import sync_playwright as s; print('\\\\n'.join(s().start().devices))\\\"\")\n            matrix = [(n, n, \"custom\", [pw.devices[n][\"default_browser_type\"]]) for n in names]\n        else:\n            cats = set(args.only.split(\",\")) if args.only else None\n            matrix = [m for m in MATRIX if not cats or m[2] in cats]\n\n        jobs = []\n        for label, spec, category, native in matrix:\n            engines = allowed if args.all_engines else ([e for e in native if e in allowed] or allowed)\n            jobs += [(label, spec, category, e) for e in engines]\n        needed = sorted({j[3] for j in jobs})\n        browsers = {e: await getattr(pw, e).launch(headless=not args.headed) for e in needed}\n        sem = asyncio.Semaphore(6)\n        print(f\"{len(jobs)} screenshots of {args.url} -> {out}\")\n        records = await asyncio.gather(*(shoot(browsers, pw, args.url, *j, args, out, sem) for j in jobs))\n        for b in browsers.values():\n            await b.close()\n\n    order = {c: i for i, c in enumerate([\"phone\", \"foldable\", \"tablet\", \"desktop\", \"custom\"])}\n    records.sort(key=lambda r: (order.get(r[\"category\"], 9), r[\"width\"], r[\"label\"], r[\"engine\"]))\n    (out / \"report.json\").write_text(json.dumps({\"url\": args.url, \"results\": records}, indent=2))\n    write_index(out, args.url, records)\n    failed = sum(1 for r in records if r.get(\"error\"))\n    flagged = sum(1 for r in records if issue_list(r) and not r.get(\"error\"))\n    print(f\"\\n{len(records) - failed - flagged} clean, {flagged} with issues, {failed} failed\")\nMATRIX = [\n    (\"iPhone SE\", \"iPhone SE (3rd gen)\", \"phone\", [\"webkit\"]),\n    (\"iPhone 17 Pro\", \"iPhone 17 Pro\", \"phone\", [\"webkit\"]),\n    (\"iPhone 17 Pro Max\", \"iPhone 17 Pro Max\", \"phone\", [\"webkit\"]),\n    (\"iPhone 17 Pro landscape\", \"iPhone 17 Pro landscape\", \"phone\", [\"webkit\"]),\n    (\"Pixel 10\", \"Pixel 10\", \"phone\", [\"chromium\"]),\n    (\"Galaxy Z Fold 7 (open)\", \"Galaxy Z Fold 7\", \"foldable\", [\"chromium\"]),\n    (\"iPad Mini\", \"iPad Mini\", \"tablet\", [\"webkit\"]),\n    (\"iPad Pro 11 landscape\", \"iPad Pro 11 landscape\", \"tablet\", [\"webkit\"]),\n    (\"Galaxy Tab S9\", \"Galaxy Tab S9\", \"tablet\", [\"chromium\"]),\n    (\"4:3 1024x768\", (1024, 768), \"desktop\", ENGINES),\n    (\"Laptop 1366x768\", (1366, 768), \"desktop\", ENGINES),\n    (\"16:10 1440x900\", (1440, 900), \"desktop\", ENGINES),\n    (\"16:9 1920x1080\", (1920, 1080), \"desktop\", ENGINES),\n    (\"21:9 2560x1080\", (2560, 1080), \"desktop\", ENGINES),\n]\n\n  const culprits = [];\n  for (const el of document.body ? document.body.querySelectorAll('*') : []) {\n    const r = el.getBoundingClientRect();\n    if (r.right > vw + 1 && r.width > 0 && !el.closest('[aria-hidden=\"true\"]')) {\n      const parent = el.parentElement && el.parentElement.getBoundingClientRect();\n      if (parent && parent.right > vw + 1) continue;  // report the outermost offender only\n      let d = el.tagName.toLowerCase();\n      if (el.id) d += '#' + el.id;\n      else if (typeof el.className === 'string' && el.className.trim()) d += '.' + el.className.trim().split(/\\\\s+/).slice(0, 2).join('.');\n      culprits.push(d + ` (right=${Math.round(r.right)}px)`);\n      if (culprits.length >= 3) break;\n    }\n  }\n  return { viewport: vw, scrollWidth: sw, culprits };\n}\"\"\"\n\n\ndef slug(s):\n    return re.sub(r\"[^a-z0-9]+\", \"-\", s.lower()).strip(\"-\")\n\n\ndef aspect(w, h):\n    r = max(w, h) / min(w, h)\n    return f\"{r:.2f}:1 {'portrait' if h > w else 'landscape'}\"\n\n\nasync def shoot(browsers, pw, url, label, spec, category, engine, args, out, sem):\n    async with sem:\n        if isinstance(spec, tuple):\n            opts = {\"viewport\": {\"width\": spec[0], \"height\": spec[1]}, \"device_scale_factor\": 1}\n        else:\n            opts = {k: v for k, v in pw.devices[spec].items() if k != \"default_browser_type\"}\n            if engine == \"firefox\":\n                opts.pop(\"is_mobile\", None)  # Firefox has no mobile mode in Playwright\n        if args.dpr1:\n            opts[\"device_scale_factor\"] = 1\n        vp = opts[\"viewport\"]\n","exit_code":0,"status":"completed"}}
