{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/net/index.js');s=p.read_text();s=s.replace(\\\"this.app=app;this.t=transport;\\\", \\\"this.app=app;this.t=transport;app.sim.remoteAuthority=\"'!transport.isHost;\")\ns=s.replace(\"p.equipped||'\"'carbine'];\\\", \\\"p.equipped||'carbine',p.vehicle?this.sim.vehicles.findIndex(v=>v.id===p.vehicle):-1];\\\")\ns=s.replace(\\\"const [id,x,z,y,yaw,hp,down,weapon]=data;\\\", \\\"const [id,x,z,y,yaw,hp,down,weapon,vehicleIndex]=data;\\\")\ns=s.replace(\\\"p.equipped=weapon;p.hp=hp;\\\", \\\"p.equipped=weapon;p.vehicle=vehicleIndex>=0?this.sim.vehicles[vehicleIndex]?.id:null;p.hp=hp;\\\")\ns=s.replace(\\\"p:this.pose(p),u:\"'!!this.app.lastFrame?.use\", \"p:this.pose(p),v:p.vehicle?this.vehiclePose(this.sim.vehicles.find(v=>v.id===p.vehicle)):null,u:!!this.app.lastFrame?.use\")\ns=s.replace(\"h:Math.round(s.hour*100)};\", \"h:Math.round(s.hour*100),v:s.vehicles.filter(v=>v.occupant!==null||dist(v,p)<160).slice(0,5).map(v=>this.vehiclePose(v))};\")\ns=s.replace(\"const p=this.applyPose(d.p);if(d.u\", \"const p=this.applyPose(d.p);if(d.v)this.applyVehicle(d.v);if(d.u\")\ns=s.replace(\"s.wind.angle=d.w[0]/100;\", \"for(const v of d.v||[])this.applyVehicle(v);s.wind.angle=d.w[0]/100;\")\ns=s.replace(\" receive(d,from){\", \" vehiclePose(v){return [this.sim.vehicles.indexOf(v),Math.round(v.x*10),Math.round(v.z*10),Math.round(v.yaw*100),Math.round(v.health),Math.round(v.speed*10)];}'\"\\\\n applyVehicle([index,x,z,yaw,health,speed]){const v=this.sim.vehicles[index];if(v){v.x=x/10;v.z=z/10;v.yaw=yaw/100;v.health=health;v.speed=speed/10;}}\\\\n receive(d,from){\\\")\np.write_text(s)\np=Path('src/sim/index.js');s=p.read_text();s=s.replace(\\\"if(this.fire.active.size){const f=this.fire.tick\\\", \\\"if(this.fire.active.size&&\"'!this.remoteAuthority){const f=this.fire.tick\")\ns=s.replace(\"if(this.aiAccum>=.1){this.updateAI(this.aiAccum);\", \"if(this.aiAccum>=.1){if(!this.remoteAuthority)this.updateAI(this.aiAccum);\")\ns=s.replace(\"this.updateContract();this.updatePosts();\", \"if(!this.remoteAuthority){this.updateContract();this.updatePosts();}\")\ns=s.replace(\"this.world.stats.jams++;this.mark('\"'jam');\\\", \\\"this.world.stats.jams++;const jp=this.job.players.find(v=>v.id===p.id);if(jp)jp.jams++;this.mark('jam');\\\")\ns=s.replace(\\\"this.world.stats.downs++;if(this.scenario\\\", \\\"this.world.stats.downs++;const jp=this.job.players.find(v=>v.id===this.p.id);if(jp)jp.downs++;if(this.scenario\\\")\np.write_text(s)\np=Path('src/main.js');s=p.read_text().replace(\\\"if(e.type==='shot'&&this.net&&\"'!this.net.t.isHost)\",\"if(e.type==='\"'revive'&&this.net&&\"'!this.net.t.isHost)this.net.action({type:'\"'revive',id:e.id});if(e.type==='shot'&&this.net&&\"'!this.net.t.isHost)\")\np.write_text(s)\nPY\nnode --check src/sim/index.js && node --check src/net/index.js'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
