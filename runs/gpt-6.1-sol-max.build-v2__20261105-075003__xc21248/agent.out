s\": 200,\n      \"file\": \"pixel-10__chromium.png\"\n    },\n    {\n      \"label\": \"iPhone SE\",\n      \"category\": \"phone\",\n      \"engine\": \"webkit\",\n      \"width\": 375,\n      \"height\": 667,\n      \"dpr\": 1,\n      \"console_errors\": [],\n      \"page_errors\": [],\n      \"failed_requests\": [],\n      \"overflow\": null,\n      \"status\": 0,\n      \"file\": \"iphone-se__webkit.png\"\n    },\n    {\n      \"label\": \"iPhone 17 Pro\",\n      \"category\": \"phone\",\n      \"engine\": \"webkit\",\n      \"width\": 402,\n      \"height\": 681,\n      \"dpr\": 1,\n      \"console_errors\": [],\n      \"page_errors\": [],\n      \"failed_requests\": [],\n      \"overflow\": null,\n      \"status\": 0,\n      \"file\": \"iphone-17-pro__webkit.png\"\n    },\n","exit_code":0,"status":"completed"}}
