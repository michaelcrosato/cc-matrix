{"type":"item.started","item":{"id":"item_185","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/sim/index.js');s=p.read_text()\ns=s.replace(\\\"this.p.aim=\"'!!frame.aim;\", \"this.p.aim=!!frame.aim&&(!this.p.vehicle||this.p.seat===1);\")\ns=s.replace(\"case '\"'seat':if(p.vehicle&&this.job.carrier\"'!==p.id)\", \"case '\"'seat':if(p.vehicle&&this.vehicles.find(v=>v.id===p.vehicle)?.kind==='technical'&&this.job.carrier\"'!==p.id)\")\ns=s.replace(\"case '\"'radio':this.emit('radio');break;\\\", \\\"case 'radio':{const v=this.vehicles.find(v=>v.id===p.vehicle);if(v){v.radio=((v.radio||0)+1)%3;const tape=this.world.tapes.at(-1);this.emit('radio',{playerId:p.id,station:['off','music','tape'][v.radio],line:tape===undefined?'No dictations on this frequency.':DICTATIONS[tape]});}}break;\\\")\ns=s.replace(\\\"if(p.dead||p.cooldown||\\\", \\\"if(p.dead||p.vehicle&&p.seat===0||p.cooldown||\\\")\np.write_text(s)\np=Path('src/input/index.js');s=p.read_text().replace(\\\"r:p.vehicle?'radio':'reload'\\\", \\\"r:p.vehicle&&p.seat===0?'radio':'reload'\\\")\ns=s.replace(\\\"if(pressed(2))this.push(sim.context()?'use':'reload');\\\", \\\"if(pressed(2))this.push(p.seat===1&&(sim.currentGun().jam||sim.currentGun().ammo===0)?'reload':sim.context()?'use':'reload');\\\")\np.write_text(s)\np=Path('src/audio/index.js');s=p.read_text().replace(\\\" stop(){this.muted=true;\\\", \\\" radio(station,line){this.radioGain?.disconnect();this.radioGain=null;if(\"'!this.ctx||this.ctx.state!=='\"'running'||station==='off')return;const g=this.ctx.createGain();g.gain.value=.65;g.connect(station==='music'?this.nodes.music:this.nodes.voice);this.radioGain=g;recipe(this.ctx,g,station==='music'?'music':'voice',{line,who:'notary'});}\\\\n stop(){this.muted=true;\\\")\np.write_text(s)\np=Path('src/main.js');s=p.read_text().replace(\\\"else if(e.type==='ignite')this.sound.play('fire');\\\", \\\"else if(e.type==='ignite')this.sound.play('fire');else if(e.type==='radio'&&e.playerId===this.sim.p.id){this.sound.radio(e.station,e.line);this.ui.toast('Radio: '+e.station);if(e.station==='tape')this.ui.event({type:'voice',who:'RADIO',line:e.line});}\\\")\np.write_text(s)\np=Path('src/ui/index.js');s=p.read_text().replace(\\\"else if(ctx){label=ctx.label;}\\\", \\\"else if(gun?.ammo===0&&(\"'!p.vehicle||p.seat===1)){label='\"'Reload';action='reload';}else if(ctx){label=ctx.label;}\\\")\np.write_text(s)\np=Path('src/view/index.js');s=p.read_text()\ns=s.replace(\\\"if(dist(n,camera.position)>250)\\\", \\\"if(dist(n,camera.position)>(n.tagged||p.monocular||p.aim&&p.equipped==='rifle'?550:250))\\\")\ns=s.replace(\\\"const rifle=kit.gun(n.role\\\", \\\"const tagGeometry=new THREE.BufferGeometry;tagGeometry.setAttribute('position',new THREE.Float32BufferAttribute([-.15,.15,0,0,-.15,0,.15,.15,0],3));tagGeometry.computeVertexNormals();const marker=new THREE.Mesh(tagGeometry,new THREE.MeshBasicNodeMaterial({color:0xffedb6,side:THREE.DoubleSide,depthTest:false}));marker.name='tagMarker';marker.visible=false;marker.renderOrder=8;rig.root.add(marker);rig.marker=marker;const rifle=kit.gun(n.role\\\")\ns=s.replace(\\\"rig.root.rotation.y=-n.yaw;\\\", \\\"rig.root.rotation.y=-n.yaw;if(rig.marker){rig.marker.visible=\"'!!n.tagged&&n.hp>0&&s.lineClear(p,n);const scale=Math.max(.6,dist(n,camera.position)*.07*camera.fov/75);rig.marker.scale.setScalar(scale);rig.marker.position.y=2+.15*scale;rig.marker.lookAt(camera.position);}\")\ns=s.replace(\"triangles:renderer.info.render.triangles}\", \"triangles:renderer.info.render.triangles,tagMarkers:[...npcViews.values()].filter(r=>r.root.visible&&r.marker?.visible).length}\")\np.write_text(s)\nPY\nnode --check src/main.js && node --check src/sim/index.js && node --check src/view/index.js && node --check src/ui/index.js'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
