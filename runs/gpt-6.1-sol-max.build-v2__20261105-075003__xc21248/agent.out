{"type":"item.completed","item":{"id":"item_143","type":"command_execution","command":"/bin/bash -lc \"sed -n '78,105p' src/sim/index.js && sed -n '1,31p' src/sim/bot.js\"","aggregated_output":"  const range=p.seat===1?220:w.range;const dx=Math.sin(p.yaw)*Math.cos(p.pitch),dy=Math.sin(p.pitch),dz=-Math.cos(p.yaw)*Math.cos(p.pitch);let target=null,best=range;for(const e of [...this.npcs,...this.entities.filter(e=>['tank','barrel','bridge'].includes(e.kind)),...this.vehicles.filter(v=>v.tag)]){if(e.dead||e.hp<=0||e.health<=0)continue;const ex=e.x-p.x,ez=e.z-p.z,ey=heightAt(e.x,e.z)+1-(p.y+1.5);const projection=ex*dx+ey*dy+ez*dz;const side=Math.sqrt(Math.max(0,ex*ex+ey*ey+ez*ez-projection*projection));const radius=e.kind==='tank'?5:e.kind==='bridge'?8:e.tag?3:.8;if(projection>0&&projection<best&&side<radius+(p.aim?.05:.15)){best=projection;target=e;}}\n  if(target&&!this.lineClear(p,target))target=null;const point=target?{x:target.x,z:target.z}:this.aimPoint(w.range);if(w.ignite){this.ignite(point.x,point.z,p.equipped==='torch'?3:2);this.mark(p.equipped==='torch'?'torch_flame':'flare_ignite');}if(w.explosive){this.explode(point.x,point.z,6,180);this.mark('rocket');}else if(target){if(target.tag)this.damageVehicle(target,w.damage*this.t.damage);else if(target.kind){target.hp-=w.damage*this.t.damage;if(target.hp<=0)this.destroy(target);}else this.hitNPC(target,this.cheats.oneHit?1000:w.damage*this.t.damage,'bullet');this.emit('hit');}\n  if(p.holstered||dist(p,POI.kiln)<65){this.world.flags.townHostile=true;this.world.papersBurn.stewards=this.day;this.world.papersBurn.commons=this.day;this.say('guard','Ceasefire means you too.');}for(const n of this.npcs)if(dist(n,p)<(p.equipped==='quiet'?12:180)&&n.hp>0){n.state='alert';n.detect=1;}\n  for(const a of this.animals)if(dist(a,p)<180){a.flee=12;this.mark('animals_flee');}this.lastGunfire=this.elapsed;this.emit('shot',{weapon:gun.id,point});\n }\n reload(){const g=this.currentGun();if(!g||g.broken||this.p.busy)return;if(g.jam){this.busy('clear_jam',1.3,()=>{g.jam=false;this.mark('jam_clear');});}else if(g.ammo<WEAPONS[g.id].mag&&g.reserve>0)this.busy('reload',g.id==='belt'?3:1.5,()=>{const n=Math.min(WEAPONS[g.id].mag-g.ammo,g.reserve);g.ammo+=n;if(!this.cheats.ammo)g.reserve-=n;});}\n busy(type,duration,done=()=>{},extra={}){if(this.p.busy)return false;this.p.busy={type,left:duration,total:duration,done,...extra};this.emit('animation',{name:type,duration});this.emit('sfx',{name:type});return true;}\n updateBusy(dt,f){const b=this.p.busy;if(!b)return;if(b.type.startsWith('surgery_')&&(f.fire||f.sprint&&Math.hypot(f.moveX||0,f.moveZ||0)>.2)){this.p.busy=null;return;}if((b.type==='repair'||b.type==='plant')&&!f.use&&b.requireHold){this.p.busy=null;return;}b.left-=dt;if(b.left<=0){this.p.busy=null;b.done?.();}}\n heal(){if(this.p.busy||this.p.hp>=100||this.p.down)return;const critical=this.p.hp<=20;const type=critical?'surgery_'+this.p.damageType:'heal_syringe';if(!critical&&this.p.syringes<=0){this.emit('notice',{line:'Pouch empty. Find a med box or a safehouse.'});return;}this.busy(type,critical?3:1.6*(this.p.merc===0?.75:1),()=>{if(critical)this.p.hp=40;else{this.p.syringes--;this.p.hp=100;}this.p.lastDamage=this.elapsed;this.p.healCount++;this.mark(type);});}\n pill(){if(this.p.busy||this.p.doses<=0)return;this.busy('pill',1.8,()=>{this.p.doses--;this.p.fever=0;this.p.nextFever=this.elapsed+this.t.feverInterval*60*(.82+this.rng()*.36);this.world.stats.doses++;this.mark('pill');});}\n damage(amount,type='bullet'){if(this.p.dead||this.cheats.god||this.p.down||this.p.rescue)return;this.p.hp=Math.max(0,this.p.hp-amount*this.t.incoming);this.p.lastDamage=this.elapsed;this.p.damageType=['bullet','finger','shrapnel','burn'].includes(type)?type:'bullet';this.emit('damage',{amount,type});if(this.p.hp<=0)this.goDown();}\n updateHealth(dt){const p=this.p;if(p.hp>0&&p.hp<100&&this.elapsed-p.lastDamage>4){const ceiling=Math.ceil(p.hp/20)*20;p.hp=Math.min(ceiling,p.hp+this.t.regen*dt);}if(this.fire.near(p.x,p.z,4)&&!p.vehicle)this.damage(this.t.fireDamage*dt,'burn');if(p.down)p.down+=dt;}\n startFever(){if(this.p.fever)return;this.p.fever=this.t.feverWarning;this.mark('fever');this.say('doctor','Take your dose. Before the road starts moving.');}\n updateFever(dt){const p=this.p;if(p.fever>0){p.fever-=dt;if(p.fever<=0)this.collapse();}else if(this.elapsed>=p.nextFever){if(!this.seen.has('fever')&&this.npcs.some(n=>n.hp>0&&['combat','alert'].includes(n.state)&&dist(n,p)<40))p.nextFever+=5;else this.startFever();}}\n collapse(){this.mark('collapse');const house=this.world.safehouses.map(id=>POI[id]).sort((a,b)=>dist(a,this.p)-dist(b,this.p))[0];this.p.x=house.x;this.p.z=house.z+7;this.p.y=heightAt(this.p.x,this.p.z);this.p.vehicle=null;this.p.hp=60;this.p.fever=0;this.p.nextFever=this.elapsed+this.t.feverInterval*60;this.p.diamonds=Math.max(0,this.p.diamonds-1);this.currentGun().condition=Math.max(1,this.currentGun().condition-20);this.hour=(this.hour+6)%24;this.physics?.teleport(this.p);this.emit('wipe',{line:'Six hours entered under losses.'});}\n goDown(){this.p.hp=0;this.p.equipped='pistol';this.p.map=false;this.p.mapFocus=false;this.p.busy=null;this.p.down=.01;this.world.stats.downs++;const jp=this.job.players.find(v=>v.id===this.p.id);if(jp)jp.downs++;if(this.scenario==='job'){if(this.job.carrier===this.p.id){this.job.case={x:this.p.x,z:this.p.z};this.job.carrier=null;}if(this.job.players.length===1)this.p.rescue={buddy:{id:MERCS[(this.p.merc+1)%4].id,state:'ok',trust:50},left:this.t.rescueTime};return;}const buddy=this.bestBuddy();if(buddy&&this.rescuesToday<this.t.rescues){this.p.rescue={buddy,left:this.t.rescueTime};this.say(buddy.id,RESCUES[buddy.id][this.rescuesToday%4]);}else this.emit('notice',{line:'Contract void. No rescue is available.'});}\n updateBuddies(dt){const p=this.p;if(p.rescue){p.rescue.left-=dt;if(p.rescue.left<=0){const b=p.rescue.buddy;b.state='wounded';b.trust+=10;this.rescuesToday++;this.world.flags.allyUntil=this.elapsed+60;this.world.flags.allyId=b.id;this.companion=null;this.world.stats.rescues++;p.hp=40;p.down=0;p.x-=6;p.y=heightAt(p.x,p.z);p.rescue=null;this.physics?.teleport(p);this.mark('rescue');if(this.scenario==='job')this.mark('coop_revive');this.emit('animation',{name:'rescue',duration:3});this.emit('wipe',{line:'Carried forward.'});}}else if(p.down>(this.scenario==='job'?45:15)){if(this.scenario==='job'){this.job.players.find(v=>v.id===p.id).left=true;p.dead=true;p.down=0;p.objective='Left behind. The barge will close the account.';if(this.job.players.every(v=>v.left))this.finishJob();}else{this.emit('death');this.paused=true;}}if(this.mercy){this.mercy.left-=dt;if(this.mercy.left<=0)this.resolveMercy('leave');}}\n downBuddy(id=null,at=null){let b=(id?this.world.buddies.filter(b=>b.id===id):this.world.buddies).filter(b=>b.state!=='dead').sort((a,b)=>b.trust-a.trust)[0];if(!b)return false;b.state='down';this.mercy={buddy:b,left:60,x:at?.x??this.p.x+4,z:at?.z??this.p.z+3};this.mark('buddy_down');this.say(b.id,'I can count. I have the minutes and they do not come out. You have a syringe. Do not be polite.');if(dist(this.p,this.mercy)<8)this.emit('mercy');return true;}\n resolveMercy(choice){if(!this.mercy)return;const b=this.mercy.buddy;if(choice==='syringe'&&this.p.syringes>0){this.p.syringes--;b.state=this.rng()<this.t.buddyChance?'wounded':'dead';if(b.state==='wounded')b.trust+=20;this.say(b.id,b.state==='dead'?'Leave the tab open.':'That will cost you. Thank you.');}else b.state='dead';this.mark('mercy');this.world.ledger.push(b.id.toUpperCase()+': '+(b.state==='dead'?'written off. Tab left open.':'carried forward.'));this.mercy=null;this.emit('mercyEnd');}\n ignite(x,z,r=2){const count=this.fire.ignite(x,z,r);if(count){this.mark('fire_spread');this.emit('ignite',{x,z,r});}return count;}\n explode(x,z,r=8,damage=180){this.mark('explosion_physics');this.ignite(x,z,r);for(const n of this.npcs)if(n.hp>0&&dist(n,{x,z})<r*2)this.hitNPC(n,damage*(1-dist(n,{x,z})/(r*2)),'shrapnel');if(dist(this.p,{x,z})<r*1.5)this.damage(damage*(1-dist(this.p,{x,z})/(r*1.5)),'shrapnel');for(const v of this.vehicles)if(dist(v,{x,z})<r*1.6)this.damageVehicle(v,damage);this.physics?.debris(x,z,8);this.emit('explosion',{x,z,r});}\n destroy(e){if(e.dead)return;e.dead=true;e.hp=0;this.explode(e.x,e.z,e.kind==='tank'?13:6,180);this.emit('destroy',{id:e.id});if(e.kind==='tank'&&this.entities.filter(e=>e.kind==='tank').every(e=>e.dead)&&!this.world.flags.windShift){this.world.flags.windShift=true;this.wind.angle+=Math.PI*.65;this.mark('wind_shift');this.say('guard','Wind is coming round! Leave it!');}if(e.id==='railbridge'){this.world.railbridge=false;this.physics?.debris(e.x,e.z,18);}}\n updateHeat(dt){for(const i of this.fire.active)if(this.fire.fuel[i]===3){this.mark('tree_burn');break;}for(const e of this.entities.filter(e=>!e.dead&&['tank','barrel'].includes(e.kind))){if(this.fire.near(e.x,e.z,8)){e.heat+=dt;if(e.heat>3)this.destroy(e);}}for(const v of this.vehicles)if(v.health>0&&this.fire.near(v.x,v.z,5))this.damageVehicle(v,dt*14);for(const n of this.npcs)if(n.hp>0&&this.fire.near(n.x,n.z,5)){this.hitNPC(n,dt*25,'burn');n.state='flee-fire';}for(const a of this.animals)if(this.fire.near(a.x,a.z,20)){a.flee=10;this.mark('animals_flee');}if(this.weather==='rain')this.fire.extinguish();}\n damageVehicle(v,n){v.health=Math.max(0,v.health-n*this.t.vehicleDamage);if(v.health<45){v.broken=true;this.mark('breakdown');}if(v.health<15&&!v.timer)v.timer=6;if(v.cargo&&v.health<10&&this.contract?.id==='c6'&&!this.world.flags.cargoDelivered)this.failContract('The dynamite truck was lost.');}\n updateVehicles(dt){for(const v of this.vehicles){if(v.timer>0){v.timer-=dt;if(v.timer<=0&&v.health>0){v.health=0;v.broken=true;this.explode(v.x,v.z,11,220);}}if(v.id===this.world.flags.escortTruck&&this.contract?.id==='e2'&&this.objective()?.do==='escort'){if(v.health<=0){this.failContract('The refugee truck was lost.');continue;}const d=dist(v,this.p);if(d>10){const a=Math.atan2(this.p.x-v.x,-(this.p.z-v.z));v.x+=Math.sin(a)*dt*Math.min(6,d*.5);v.z-=Math.cos(a)*dt*Math.min(6,d*.5);v.yaw=a;v.y=surfaceHeight(v.x,v.z)+1;}}if(v.kind==='radio_truck'&&this.contract?.id==='c5'&&v.health>80){v.z-=dt*4;v.x=310+Math.sin(this.elapsed*.03)*30;v.yaw=0;v.y=heightAt(v.x,v.z)+1;}}}\n hitNPC(n,damage,type){if(n.hp<=0)return;n.hp-=damage;n.detect=1;n.state='combat';n.lastType=type;if(n.hp<=0){if(n.buddyId){this.downBuddy(n.buddyId,{x:n.x,z:n.z});n.hp=0;n.state='wounded';n.bleed=60;return;}n.hp=0;n.state=type==='burn'?'charred':this.aiRng()<.28?'wounded':'dead';n.bleed=25;this.mark('ragdoll');if(n.state==='wounded')this.mark('wounded_crawl');this.physics?.ragdoll(n.x,n.z);this.emit('npcDown',{id:n.id});}else this.emit('flinch',{id:n.id});}\n updateAI(dt){const own=this.p,candidates=[...(this.serverCopy?[]:[own]),...Object.values(this.remotePlayers)].filter(p=>p.hp>0&&!p.dead);for(const n of this.npcs){let p=candidates[0]||own;for(const c of candidates)if(dist(n,c)<dist(n,p))p=c;const d=dist(n,p);if(n.hp<=0){if(n.state==='wounded'){n.bleed-=dt;n.x+=Math.sin(n.yaw)*dt*.2;n.z+=Math.cos(n.yaw)*dt*.2;if(n.bleed<=0)n.state='dead';}continue;}if(d>180){if(n.state==='patrol'){n.x=n.homeX+Math.sin(this.elapsed*.02+hash(n.id))*12;n.z=n.homeZ+Math.cos(this.elapsed*.02+hash(n.id))*8;}continue;}n.cooldown-=dt;n.jam=Math.max(0,n.jam-dt);\n   const burning=this.fire.near(n.x,n.z,10);if(burning){n.state='flee-fire';n.x-=Math.cos(this.wind.angle)*dt*5;n.z-=Math.sin(this.wind.angle)*dt*5;continue;}\nimport {heightAt} from './terrain.js';\nimport {POI} from '../data/world.js';\nimport {WEAPONS} from '../data/weapons.js';\nimport {dist,angleDiff,clamp} from '../core/rng.js';\nexport class Bot {\n constructor(sim){this.s=sim;this.frames=0;this.trace=[];}\n frame(frame={},n=1){for(let i=0;i<n;i++){if(this.s.p.fever&&this.s.p.doses>0&&!this.s.p.busy)frame={...frame,actions:[...(i===0?frame.actions||[]:[]),'pill']};this.s.tick(i===0?frame:{...frame,actions:[]});this.frames++;}if(this.frames>900000)throw Error('Playthrough exceeded frame budget');}\n action(a,n=1){this.frame({actions:[a]},n);}\n wait(seconds,frame={}){this.frame(frame,Math.ceil(seconds*60));}\n go(target,r=5){target=typeof target==='string'?POI[target]:target;let max=60000;while(dist(this.s.p,target)>r&&!this.s.ended&&--max){const p=this.s.p,v=this.s.vehicles.find(v=>v.id===p.vehicle);let yaw=Math.atan2(target.x-p.x,-(target.z-p.z));if(v&&v.health<45){this.action('use');this.go(v,1);this.use(this.s.t.repairTime);this.use();continue;}if(v){const err=angleDiff(yaw,v.yaw);this.frame({moveZ:-.4,moveX:clamp(err*2,-1,1),lookSet:[yaw,0]});}else this.frame({moveZ:-1,sprint:true,lookSet:[yaw,0]});}if(!max)throw Error('Could not reach '+JSON.stringify(target)+' from '+JSON.stringify(this.s.p));this.wait(.3);}\n use(hold=0){this.action('use');if(hold)this.wait(hold+.1,{use:true});this.wait(.25);}\n aimAt(target){const p=this.s.p;this.frame({lookSet:[Math.atan2(target.x-p.x,-(target.z-p.z)),Math.atan2(heightAt(target.x,target.z)+1-(p.y+1.5),dist(p,target))]});}\n fireAt(target,shots=1){for(let i=0;i<shots;i++){const g=this.s.currentGun();if(g.jam){this.action('reload');this.wait(1.6);}if(g.ammo<=0){this.action('reload');this.wait(2);}this.aimAt(target);this.wait(60/WEAPONS[this.s.p.equipped].rpm+.02,{fire:true});}}\n clear(poi){let tries=0;for(const n of this.s.npcs.filter(n=>n.poi===poi&&n.hp>0)){this.go({x:n.x,z:n.z+12},4);while(n.hp>0&&tries++<500)this.fireAt(n);if(n.hp>0)throw Error('Could not hit '+n.id);const g=this.s.currentGun();if(g.reserve<30){this.go(n,2);this.use();}}this.wait(.5);}\n accept(id,giver){if(giver){this.go(giver,3);this.use();}this.action({type:'accept',id});this.wait(.3);this.trace.push('accepted '+id);}\n runContract(id){const s=this.s;let iterations=0;while(s.contract?.id===id&&!s.contract.failed&&iterations++<120){const step=s.objective(),poi=POI[step.poi];this.trace.push(id+':'+s.contract.step+':'+step.do);\n  switch(step.do){case 'goto':case 'escort':case 'deliver':this.go(poi,step.do==='escort'?15:(step.r||30)-2);if(step.do==='escort')this.wait(20);break;case 'kill':this.clear(step.poi);break;case 'return':case 'talk':this.go(poi,6);this.use();break;case 'collect':{const e=s.entities.find(e=>e.id===step.tag)||poi;this.go(e,3);this.use();break;}case 'sleep_until':this.go({x:poi.x,z:poi.z+4},3);this.use();this.action({type:'sleep',hour:step.hour??6});break;case 'plant':case 'interact':this.go(poi,8);this.use(step.hold||2);break;\n   case 'destroy':if(id==='c3'){this.action('detonate');this.wait(1);}else if(id==='c5'){const v=s.vehicles.find(v=>v.tag==='radio_truck');this.go(v,18);while(v.health>=80)this.fireAt(v);}else{if(s.p.weapons.flare)this.action({type:'weapon',id:'flare'});for(const tag of step.tags){const e=s.entities.find(e=>e.id===tag);if(!e.dead){this.go({x:e.x-15,z:e.z-12},5);this.fireAt(e);this.wait(5);}}this.wait(15);if(s.p.weapons.carbine)this.action({type:'weapon',id:'carbine'});}break;\n   case 'wait_event':this.wait(step.duration+1);break;case 'drive_cargo':{if(!s.p.vehicle){const v=s.vehicles.find(v=>v.kind==='cargo');this.go(v,1);this.use();if(!s.p.vehicle)throw Error('Cargo entry failed: '+JSON.stringify({context:s.context(),player:s.p,truck:v,prologue:s.prologue,paused:s.paused,choice:s.pendingChoice,step:s.objective(),lastInput:s.lastInput,trace:this.trace.slice(-8)}));}this.go(poi,(step.r||30)-3);break;}case 'choice':this.wait(.3);this.action({type:'choice',value:id==='c7'?'commons':'read'});break;\n   case 'survive':this.wait(step.duration+1);if(s.mercy)this.action({type:'mercy',value:'morphine'});break;case 'hold_zone':this.go(poi,25);this.wait(step.duration+1);break;case 'ending':return;default:throw Error('Unknown bot step '+step.do);}\n   if(s.p.vehicle&&s.objective()?.do!=='drive_cargo'&&s.objective()?.tag!=='papers'){this.action('use');this.wait(.2);}if(s.contract?.id===id&&s.objective()?.do==='plant'&&s.p.vehicle)this.action('use');\n  }\n  if(iterations>=120)throw Error('Contract loop '+id+' '+JSON.stringify(s.objective())+' '+this.trace.slice(-12));if(s.contract?.failed)throw Error('Contract failed '+id);return s;\n }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_144","type":"command_execution","command":"/bin/bash -lc \"sed -n '40,79p' src/sim/index.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_144","type":"command_execution","command":"/bin/bash -lc \"sed -n '40,79p' src/sim/index.js\"","aggregated_output":"  if(id==='c7'){this.hour=18;const ally=this.bestBuddy();if(ally)ally.trust+=10;}if(id==='c8')this.hour=23;if(id==='c1'){this.p.equipped='pistol';this.p.weapons.pistol=this.makeGun('pistol',27);this.say('widow','Take the truck. It has fewer regrets than you. Not by much.');}\n  if(id==='c2'){this.giveGun('flare');this.world.papers.stewards=true;this.p.equipped='flare';}\n  if(id==='c3'){this.world.papers.commons=true;this.train.active=false;}\n  if(id==='e2'){const v=this.addVehicle('cargo',-498,399);v.tag='refugee';v.cargo=null;v.passengers=60;this.world.flags.escortTruck=v.id;for(let i=0;i<3;i++)this.spawnNPC(POI.gp7,'stewards',i);}if(id==='c5'){const v=this.vehicles.find(v=>v.tag==='radio_truck');v.x=310;v.z=220;v.health=300;v.broken=false;v.timer=0;}if(id==='c6'){const v=this.vehicles.find(v=>v.kind==='cargo');v.x=-105;v.z=119;v.health=300;v.broken=false;v.timer=0;v.cargo=100;this.world.papers.stewards=true;this.world.flags.forged=true;this.world.flags.cargoDelivered=false;}\n  if(data.twist&&this.world.buddies.some(b=>b.state!=='dead')){this.mark('twist_offer');this.emit('twist',{contract:id,line:data.twist.line});}\n  this.world.failed[id]=false;this.updateObjective();this.emit('save');return true;\n }\n updateObjective(){const s=this.objective();this.p.objective=s?.note||'The country is open. Find work in Kiln.';if(s?.poi)this.p.waypoint={x:POI[s.poi].x,z:POI[s.poi].z};this.emit('objective',{line:this.p.objective});}\n nextStep(){if(!this.contract)return;this.contract.step++;this.contract.progress=0;this.contract.stepAt=this.elapsed;if(this.contract.step>=CONTRACT[this.contract.id].steps.length)this.completeContract();else this.updateObjective();}\n completeContract(){const c=this.contract,d=CONTRACT[c.id];const amount=Math.max(0,Math.round((d.pay+(c.twistDone?d.twist?.pay||0:0))*this.t.pay*(this.world.failed[d.id]? .75:1)));this.p.diamonds+=amount;this.world.complete.push(c.id);for(const effect of d.effects)this.effect(effect);if(c.twistDone){this.mark('twist_done');const b=this.world.buddies.find(b=>b.id===c.allyId)||this.bestBuddy();if(b)b.trust+=10;}this.say(d.giver==='either'?'comptroller':d.giver,amount?`${d.title}. ${amount} diamonds. Your account is current.`:'You kept your part of it. Here is mine.');this.emit('contractComplete',{id:c.id,pay:amount});if(c.id==='c1'){this.p.nextFever=this.elapsed+300;this.world.flags.breakdownPending=true;this.mark('locator_found');this.say('widow','Locator is fitted. There is a case near the Pump House. Listen for your money.');}this.contract=null;this.p.contract=null;this.p.objective='Find the next contract in Kiln. Check your notebook.';this.emit('save');}\n effect(e){const [kind,a,b]=e,w=this.world;if(kind==='safehouse'&&!w.safehouses.includes(a))w.safehouses.push(a);if(kind==='papers')w.papers[a]=true;if(kind==='ledger')w.ledger.push(a);if(kind==='dump')w.dump=a;if(kind==='railbridge')w.railbridge=a;if(kind==='camp')w.camp+=a;if(kind==='standing')w.standing[a]=clamp(w.standing[a]+b,-100,100);if(kind==='owner'&&w.post[a])w.post[a].owner=b;if(kind==='doses')this.p.doses=Math.min(8,this.p.doses+(a===4?this.t.bottle:a));if(kind==='flag')w.flags[a]=true;if(kind==='trust')for(const buddy of w.buddies)if(buddy.state!=='dead')buddy.trust+=a;if(kind==='bridgeCamp')w.camp+=w.flags.evacuated?15:-20;if(kind==='burnPapers')w.papersBurn[a]=this.day;if(kind==='allPosts')for(const p of Object.values(w.post))p.owner=w.chosenSide;}\n failContract(reason){if(!this.contract)return;const id=this.contract.id;this.world.failed[id]=true;this.contract.failed=true;this.p.objective=reason+' Sleep. The job will be reissued.';this.say('foreman',this.p.objective);this.emit('objective',{line:this.p.objective});}\n giveGun(id,condition=100){if(!this.p.weapons[id])this.p.inventory.push(id);this.p.weapons[id]=this.makeGun(id,condition);}\n buy(id){const item=SHOP.find(v=>v.id===id);if(!item)return false;const price=Math.ceil(item.price*this.t.prices)+(!this.world.railbridge&&WEAPONS[id]?.slot===2?1:0)+(this.world.flags.townHostile?1:0);if(this.p.diamonds<price){this.say('widow','Diamonds. Not promises.');return false;}this.p.diamonds-=price;if(WEAPONS[id]){this.giveGun(id);this.p.equipped=id;}else{if(!this.world.upgrades.includes(id))this.world.upgrades.push(id);if(id==='syringes')this.p.syringes=5;if(id==='molotovs')this.p.molotovs=5;}this.mark('shop_buy');this.say('widow',FIXER.widow[this.rng()*FIXER.widow.length|0]);this.emit('save');return true;}\n currentGun(){if(this.p.vehicle&&this.p.seat===1){const v=this.vehicles.find(v=>v.id===this.p.vehicle);if(v){v.mountedGun??=this.makeGun('belt',85);return v.mountedGun;}}return this.p.weapons[this.p.equipped];}\n bestBuddy(){return this.world.buddies.filter(b=>b.state==='ok').sort((a,b)=>b.trust-a.trust)[0];}\n tick(frame={},dt=1/60){if(this.paused||this.ended)return;dt*=this.t.timeScale;this.elapsed+=dt;this.p.cooldown=Math.max(0,this.p.cooldown-dt);const old=this.hour;this.hour+=24*dt/(this.t.dayMinutes*60);if(this.hour>=24){this.hour-=24;this.day++;}if(old<6&&this.hour>=6)this.dawn();this.wind.speed=this.t.windSpeed;this.wind.angle+=Math.sin(this.elapsed*.003)*dt*.0009;\n  if(this.prologue>0){const barge=this.vehicles.find(v=>v.kind==='barge');const t=1-this.prologue/135,nx=-114+59*t,nz=286-60*t;this.p.x+=nx-barge.x;this.p.z+=nz-barge.z;barge.x=nx;barge.z=nz;barge.y=-1.5;this.p.y=-1.15;this.p.holstered=true;const mx=(frame.moveX||0)*this.t.walk*dt,mz=(frame.moveZ||0)*this.t.walk*dt;this.p.x=clamp(this.p.x+Math.cos(this.p.yaw)*mx-Math.sin(this.p.yaw)*mz,barge.x-2.6,barge.x+2.6);this.p.z=clamp(this.p.z+Math.sin(this.p.yaw)*mx+Math.cos(this.p.yaw)*mz,barge.z-5,barge.z+5);this.physics?.teleport(this.p);this.prologue-=dt;if(frame.use)this.prologue-=dt*90;if(this.prologue<=0){this.prologue=0;this.waitForUseRelease=true;barge.x=-55;barge.z=226;this.p.x=-55;this.p.z=212;this.p.y=-1.1;this.physics?.teleport(this.p);this.say('ferryman','The map is wrong. It is wrong in useful ways. The Widow has work.');this.p.objective='Find the Widow beyond Kiln’s east gate.';this.p.waypoint={x:40,z:70};this.mark('map_raise');}else if(Math.floor((this.elapsed-dt)/18)<Math.floor(this.elapsed/18))this.say('ferryman',FERRY[Math.floor(this.elapsed/18)%FERRY.length]);}\n  for(const action of frame.actions||[])this.action(typeof action==='string'?{type:action}:action);\n  if(frame.lookSet){this.p.yaw=frame.lookSet[0];this.p.pitch=frame.lookSet[1]||0;}this.p.yaw+=frame.lookX||0;this.p.pitch=clamp(this.p.pitch+(frame.lookY||0),-1.45,1.45);this.p.aim=!!frame.aim;\n  if(!this.prologue&&!this.pendingChoice){this.move(frame,dt);if(frame.fire&&!this.p.busy)this.shoot();if(!frame.use)this.waitForUseRelease=false;if(frame.use&&!this.lastInput.use&&!(frame.actions||[]).some(a=>(typeof a==='string'?a:a.type)==='use')&&!this.waitForUseRelease&&!this.p.busy){this.interact();this.lastUse=this.elapsed;}}\n  this.updateBusy(dt,frame);this.updateHealth(dt);this.updateFever(dt);this.updateBuddies(dt);this.updateVehicles(dt);this.updateMonocular(dt);this.updateLocator(dt);\n  this.fireAccum+=dt;while(this.fireAccum>=.1){this.fireAccum-=.1;if(this.fire.active.size&&!this.remoteAuthority){const f=this.fire.tick(.1,this.wind,this.day+this.hour/24);if(f.spread)this.mark('fire_spread');if(f.embers)this.mark('ember_spot');this.updateHeat(.1);}}\n  this.aiAccum+=dt;if(this.aiAccum>=.1){if(!this.remoteAuthority)this.updateAI(this.aiAccum);this.aiAccum=0;}this.checkAccum+=dt;while(this.checkAccum>=.25){this.checkAccum-=.25;if(!this.remoteAuthority){this.updateContract();this.updatePosts();}this.updateAnimals(.25);}\n  if(this.train.active){this.train.x+=dt*22;if(this.train.x>650){this.train.active=false;this.train.passed=true;}this.mark('train');}\n  if(this.scenario==='job')this.updateJob(dt,frame);this.updateCompanion(dt);if(this.weather==='thunder'&&Math.floor(this.elapsed/25)>Math.floor((this.elapsed-dt)/25)){this.ignite(this.p.x+180,this.p.z+60,6);this.emit('lightning');}if(Math.floor(old/3)!==Math.floor(this.hour/3))this.mark('day_night');\n  this.physics?.step();this.lastInput=frame;\n }\n move(f,dt){const p=this.p;if(p.dead)return;const v=this.vehicles.find(v=>v.id===p.vehicle);if(v){this.mark(v.kind==='skiff'?'skiff':'drive');if(v.kind==='cargo')this.mark('truck_cargo');if(p.map)this.mark('map_drive');if(p.seat===1){v.speed*=Math.exp(-.45*dt);v.x+=Math.sin(v.yaw)*v.speed*dt;v.z-=Math.cos(v.yaw)*v.speed*dt;v.y=surfaceHeight(v.x,v.z)+1;p.x=v.x;p.z=v.z;p.y=v.y+.6;this.mark('mounted_gun');return;}const throttle=-(f.moveZ||0);const steer=f.moveX||0;let max=v.kind==='skiff'?16:this.t.topSpeed;if(v.health<105)max*=.6;if(v.health<45)max=0;if(p.mapFocus)max=Math.min(max,2);v.speed+=(throttle*max-v.speed)*dt*(throttle?1.2*this.t.engine/2500:2);v.handbrake=!!f.jump;if(v.handbrake)v.speed*=Math.exp(-5*dt);v.yaw+=steer*dt*v.speed*.035;let nx=v.x+Math.sin(v.yaw)*v.speed*dt,nz=v.z-Math.cos(v.yaw)*v.speed*dt;if(v.kind!=='skiff'&&this.physics&&Math.abs(v.speed)>1&&this.physics.obstructed({x:v.x,y:v.y+.2,z:v.z},{x:nx+Math.sin(v.yaw)*1.7,y:surfaceHeight(nx,nz)+1.2,z:nz-Math.cos(v.yaw)*1.7})){this.damageVehicle(v,Math.abs(v.speed)*dt*15);v.speed*=-.12;nx=v.x;nz=v.z;}if(v.kind==='skiff'&&riverDistance(nx,nz)>28)v.speed*=.9;else {v.x=clamp(nx,-1005,1005);v.z=clamp(nz,-1005,1005);}v.y=v.kind==='skiff'?-1.5:surfaceHeight(v.x,v.z)+1;this.physics?.drive(v,throttle,-steer,this.t);if(v.cargo&&Math.abs(steer)>.7&&Math.abs(v.speed)>14)v.cargo-=dt*.8;p.x=v.x;p.z=v.z;p.y=v.y+.6;p.vehicleLookYaw=clamp((p.vehicleLookYaw||0)+(f.lookX||0),-1.4,1.4);p.yaw=v.yaw+p.vehicleLookYaw;if(this.world.flags.breakdownPending&&Math.abs(v.speed)>7){this.world.flags.breakdownPending=false;this.damageVehicle(v,265);this.mark('breakdown');this.say('widow','Smoke is not a warranty. Get out. Hold use at the hood.');}return;}\n  let x=f.moveX||0,z=f.moveZ||0;const len=Math.hypot(x,z);if(len>1){x/=len;z/=len;}const sprint=f.sprint&&p.stamina>0&&!p.crouch&&!p.down&&!p.fever&&this.job.carrier!==p.id;let speed=p.down?.65:p.crouch?2.2:sprint?this.t.sprint:this.t.walk;if(p.hp<=20)speed*=.65;if(p.monocular)speed*=.65;if(p.busy)speed*=.25;p.stamina=clamp(p.stamina+(sprint?-dt:dt*this.t.stamina/4),0,this.t.stamina);const dx=(Math.cos(p.yaw)*x-Math.sin(p.yaw)*z)*speed*dt,dz=(Math.sin(p.yaw)*x+Math.cos(p.yaw)*z)*speed*dt;\n  if(this.cheats.noclip){p.x+=dx;p.z+=dz;p.y+=(f.jump?speed*dt:0)-(f.crouch?speed*dt:0);}else if(this.physics){if(f.jump&&Math.abs(p.velocityY)<.1)p.velocityY=4.65;p.velocityY-=9.81*dt;const grounded=this.physics.move(p,{x:dx,y:p.velocityY*dt,z:dz});if(grounded)p.velocityY=0;if(p.y<heightAt(p.x,p.z)-1){p.y=heightAt(p.x,p.z);this.physics.teleport(p);}}else {p.x+=dx;p.z+=dz;p.y=heightAt(p.x,p.z);}\n  p.x=clamp(p.x,-1010,1010);p.z=clamp(p.z,-1010,1010);if(p.crouch&&p.x>130&&p.z>80)this.mark('crouch_grass');if(p.crouch&&(this.hour<6||this.hour>19))this.mark('night_stealth');p.holstered=(dist(p,POI.kiln)<66||dist(p,POI.camp)<38)&&!this.world.flags.drawn;if(p.holstered)this.mark('ceasefire_town');if(len>.1)this.emitFootstep(dt,sprint);\n }\n emitFootstep(dt,sprint){this.foot=(this.foot||0)+dt;if(this.foot>(sprint?.28:.5)){this.foot=0;this.emit('sfx',{name:'footstep'});}}\n action(a){if(this.p.dead)return;if(this.prologue>0&&a.type==='use')return;const p=this.p;switch(a.type){case 'use':this.lastUse=this.elapsed;this.interact();break;case 'reload':this.reload();break;case 'heal':this.heal();break;case 'pill':this.pill();break;case 'crouch':p.crouch=!p.crouch;break;case 'map':p.map=!p.map;p.mapFocus=false;if(p.map)this.mark('map_raise');break;case 'mapFocus':p.map=true;p.mapFocus=true;this.mark('map_focus');break;case 'waypoint':p.waypoint=a.point;this.mark('gps_waypoint');break;case 'monocular':p.monocular=!p.monocular;break;case 'weapon':{const id=a.id||p.inventory[(p.inventory.indexOf(p.equipped)+1)%p.inventory.length];if(p.weapons[id]&&!p.weapons[id].broken&&(this.job.carrier!==p.id||WEAPONS[id].slot===0))p.equipped=id;break;}case 'molotov':if(p.molotovs>0){p.molotovs--;const target=this.aimPoint(24);this.ignite(target.x,target.z,5);this.mark('molotov');this.busy('throw',.7);this.emit('sfx',{name:'throw'});}break;case 'machete':this.machete();break;case 'seat':if(p.vehicle&&this.job.carrier!==p.id){p.seat=1-p.seat;this.mark('mounted_gun');}break;case 'lights':{const v=this.vehicles.find(v=>v.id===p.vehicle);if(v)v.lights=!v.lights;}break;case 'horn':this.emit('sfx',{name:'horn'});break;case 'radio':this.emit('radio');break;case 'accept':this.accept(a.id);break;case 'twist':if(this.contract){this.contract.twist=true;this.contract.allyId=this.world.buddies.find(b=>b.id===CONTRACT[this.contract.id].twist?.buddy&&b.state==='ok')?.id||this.bestBuddy()?.id;this.emit('save');this.say(this.contract.allyId||'buddy',CONTRACT[this.contract.id].twist?.line||'I will meet you there.');}break;case 'buy':this.buy(a.id);break;case 'sleep':this.sleep(a.hour);break;case 'choice':this.choose(a.value);break;case 'mercy':this.resolveMercy(a.value);break;case 'ferry':this.ferry(a.poi);break;case 'detonate':this.detonate();break;case 'draw':p.holstered=false;this.world.flags.drawn=true;break;case 'revive':this.revive(a.id);break;}}\n aimPoint(range=100){const p=this.p;const dx=Math.sin(p.yaw)*Math.cos(p.pitch),dy=Math.sin(p.pitch),dz=-Math.cos(p.yaw)*Math.cos(p.pitch);let best={x:p.x+dx*range,y:heightAt(p.x+dx*range,p.z+dz*range),z:p.z+dz*range,distance:range};for(let t=2;t<range;t+=2){const x=p.x+dx*t,z=p.z+dz*t,y=p.y+1.5+dy*t;if(y<=heightAt(x,z)+.1){best={x,y:heightAt(x,z),z,distance:t};break;}}return best;}\n shoot(){const p=this.p;if(p.dead||p.cooldown||p.busy||p.map||p.monocular||p.down>20)return;if(p.holstered&&!this.world.flags.drawn){this.emit('notice',{line:'Ceasefire. Hold Use to draw deliberately.'});return;}const gun=this.currentGun(),w=WEAPONS[gun.id];if(!gun||gun.broken)return;if(gun.jam||gun.ammo<=0){p.cooldown=.3;this.emit('sfx',{name:'jam'});return;}p.cooldown=60/w.rpm;if(!this.cheats.ammo)gun.ammo--;p.shots++;const jamProb=gun.condition<50?this.t.jamK*((50-gun.condition)/50)**2:0;const force=this.contract?.id==='c1'&&p.shots===15;if(!this.cheats.neverJam&&(force||this.rng()<jamProb)){gun.jam=true;this.world.stats.jams++;const jp=this.job.players.find(v=>v.id===p.id);if(jp)jp.jams++;this.mark('jam');this.emit('sfx',{name:'jam'});return;}\n  gun.condition=Math.max(0,gun.condition-w.wear*this.t.wear*(p.merc===3?.75:1));if(gun.condition<50)this.mark('rust_visual');if(gun.condition<=0){gun.broken=true;this.world.stats.broken++;this.mark('gun_break');this.busy('break',1.1);return;}\n  const range=p.seat===1?220:w.range;const dx=Math.sin(p.yaw)*Math.cos(p.pitch),dy=Math.sin(p.pitch),dz=-Math.cos(p.yaw)*Math.cos(p.pitch);let target=null,best=range;for(const e of [...this.npcs,...this.entities.filter(e=>['tank','barrel','bridge'].includes(e.kind)),...this.vehicles.filter(v=>v.tag)]){if(e.dead||e.hp<=0||e.health<=0)continue;const ex=e.x-p.x,ez=e.z-p.z,ey=heightAt(e.x,e.z)+1-(p.y+1.5);const projection=ex*dx+ey*dy+ez*dz;const side=Math.sqrt(Math.max(0,ex*ex+ey*ey+ez*ez-projection*projection));const radius=e.kind==='tank'?5:e.kind==='bridge'?8:e.tag?3:.8;if(projection>0&&projection<best&&side<radius+(p.aim?.05:.15)){best=projection;target=e;}}\n  if(target&&!this.lineClear(p,target))target=null;const point=target?{x:target.x,z:target.z}:this.aimPoint(w.range);if(w.ignite){this.ignite(point.x,point.z,p.equipped==='torch'?3:2);this.mark(p.equipped==='torch'?'torch_flame':'flare_ignite');}if(w.explosive){this.explode(point.x,point.z,6,180);this.mark('rocket');}else if(target){if(target.tag)this.damageVehicle(target,w.damage*this.t.damage);else if(target.kind){target.hp-=w.damage*this.t.damage;if(target.hp<=0)this.destroy(target);}else this.hitNPC(target,this.cheats.oneHit?1000:w.damage*this.t.damage,'bullet');this.emit('hit');}\n","exit_code":0,"status":"completed"}}
