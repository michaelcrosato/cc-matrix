nes":["   const { game, G } = load({});","   game.advance(.3); const T = G.debugTools;","   G.state = null; G.ensureState('amara'); T.setDay(3, 1); const st = G.state; st.money = 54321; st.bag.mochi_box = 3; st.affinity.lola = 77; G.autosave();","-  const snap = JSON.stringify(st); G.state = null; game.go('title', null, { fade: 0 }); game.advance(.2);","+  const keyOf = x => JSON.stringify([x.me, x.day, x.slot, x.money, x.bag, x.affinity, x.partner, x.wardrobe, x.wearing, x.teams, x.npcWear, x.stats]);","+  const snap = keyOf(st); G.state = null; game.go('title', null, { fade: 0 }); game.advance(.2);","   game.go('menu', null, { fade: 0 }); game.advance(.1);","   const cont = game.scene.items().find(i => i.id === 'cont'); t.ok('the menu offers Continue when a save exists', !!cont);","   cont.onPress(); playUntil(G, game, () => game.sceneName === 'map', 3);","   t.ok('Continue: back on the island map', game.sceneName === 'map');","-  t.ok('Continue: the same day, slot, money, bag and friends', G.state && JSON.stringify(G.state) === snap, G.state && [G.state.day, G.state.slot, G.state.money].join());","+  t.ok('Continue: the same day, slot, money, bag and friends', G.state && keyOf(G.state) === snap, G.state && [G.state.day, G.state.slot, G.state.money].join());","   // three slots: save to slot 1, change things, load slot 1","   G.installSaves(); game.saves.save(1); G.state.money = 1; game.saves.load(1); G.resumeVacation(); game.advance(.6);","   t.ok('a slot saves and loads', G.state.money === 54321 && game.sceneName === 'map');"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/test/suites/revisit.test.mjs","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-202