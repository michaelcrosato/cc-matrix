{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W3VSveChe84cFmcPE2WWhF","type":"tool_result","content":"  /* ---------------- the camera ---------------- */\n  camera(game) {\n    const b = this.ball, view = this.camMode === 'Serve Cam' ? E.VIEWS.servecam : E.VIEWS.court;\n    if (game.view !== view) { game.setView(view); this.view = view; }\n    this.view = game.view;\n    const cam = game.cam;\n    if (this.camMode === 'Serve Cam') { cam.frame(null); cam.smooth = .25; const lead = this.L && !this.L.frozen ? G.Ball.vel(this.L, this.now)[0] * .15 : 0; game.focus(clamp(b.x + lead, MC.X0 - 10, MC.X1 + 10), MC.CY, 20); game.setZoom(.92 * G.T.cameraZoomMul); }\n    else {\n      cam.smooth = .22;\n      const targets = this.phase === 'serveSetup' || this.phase === 'intro' || this.phase === 'coin' ? this.players.map(p => ({ x: p.x, y: p.y, z: p.z + 20 })) : [{ x: b.x, y: b.y, z: b.z }, ...this.players.map(p => ({ x: p.x, y: p.y, z: p.z + 20 }))];\n      targets.push({ x: MC.NET_X, y: MC.CY, z: MC.NET_H });\n      cam.frame(targets, { margin: 30, zoom: [.78 * G.T.cameraZoomMul, 1 * G.T.cameraZoomMul] });\n    }\nsrc/15-anim.js:11:    const MC = typeof Mocap !== 'undefined' ? Mocap : null, set = typeof MOCAP !== 'undefined' ? MOCAP.AOA : window.MOCAP && window.MOCAP.AOA;   // (the mocap scripts' top-level names)\nsrc/24-match.js:6:const MC = G.C, VBm = G.VB;\nsrc/24-match.js:8:E.VIEWS.servecam = E.VIEWS.servecam || new E.View('servecam', 'Serve Cam', -90, 46, 1.5, 1);\nsrc/24-match.js:650:    const b = this.ball, view = this.camMode === 'Serve Cam' ? E.VIEWS.servecam : E.VIEWS.court;","is_error":false}]},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"0fded113-186f-4c1b-b85a-46ac1d048255","timestamp":"2026-11-04T08:04:34.132Z","tool_use_result":{"stdout":"  /* ---------------- the camera ---------------- */\n  camera(game) {\n    const b = this.ball, view = this.camMode === 'Serve Cam' ? E.VIEWS.servecam : E.