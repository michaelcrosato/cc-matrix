· 2/4', title: 'Read their roles (' + g.reads + '/2)', text: 'Hold the camera on someone doing their job for 3 seconds' };","+    if (g.reads < 2) return { step: 'EP1 · 2/4', title: 'Read their roles (' + g.reads + '/2)', text: 'Hold the camera on someone doing their job for 3 seconds', at: C(30.5, 32.5) };","     if (!FL().pocketsMet) return { step: 'EP1 · 3/4', title: 'Find Pockets', text: 'The alley behind Gaither Market', at: C(27, 21) };","-    return { step: 'EP1 · 4/4', title: 'Back to the Chevy', text: 'Wait in the car to wrap up', at: C(22.5, 29.5) };","+    return { step: 'EP1 · 4/4', title: 'Back to the Chevy', text: 'Wait in the car to wrap up', at: C(34.5, 29.3) };","   },","   bot(F, dt) {   // attract: Dana on the bench photographs the next sale","     const p = F.me; if (!F.flags.sat) { F.flags.sat = 1; p.body.x = 42.5 * T; p.body.y = 30.4 * T; p.cover = 'sit'; }"]},{"oldStart":16954,"oldLines":7,"newStart":16972,"newLines":7,"lines":["       const near = dist(me, r) < 16;","       if (ch.stumble > 0) { ch.stumble -= dt; me.locked = ch.stumble > 0; }","       F.chasePrompt = near && me.sprinting ? 'Tackle' : null;","-      if (me.ctl.pressed('interact') && dist(me, r) < 26 && me.moving && ch.stumble <= 0) {","+      if (me.ctl.pressed('interact') && dist(me, r) < 26 && ch.stumble <= 0) {","         if (dist(me, r) < 18) { ch.down = true; r.pose = 'down'; r.body.vx = r.body.vy = 0; sfx('punch'); game.shake(4); game.particles.dust(r.x, r.y, 0, 10); me.ctl.human && game.input.rumble(.6, .25); }","         else { ch.stumble = .8; me.locked = true; sfx('swing'); toast('Missed', ''); }","       }"]},{"oldStart":17088,"oldLines":7,"newStart":17106,"newLines":7,"lines":[" // search, the raid (plan, breach, reactions, search; the 60-second rescue), the money tail and the long lens, and Tee's"," // nights on the corner (the order wheel, the code card and pager, the payphone keypad, the count)."," const TEE_DRY = [[30, 32], [30, 26], [28, 26, 'window', 3], [20, 26, 'lookBack'], [9, 26], [9, 21], [15, 20.5, 'doubleBack'], [29, 20.5], [30, 15, 'wait', 4], [44, 15, 'lookBack'], [56, 15], [56, 30],","-  [56, 47], [49, 47, 'cut'], [46.5, 41], [46.5, 36, 'lookBack'], [55, 36], [56, 30], [42, 30, 'phone', 4], [34, 30], [33, 31, 'window', 3], [30, 32], [30, 44, 'wait', 3], [18, 45], [18, 49]];","+  [41, 30, 'phone', 4], [34, 30], [33, 31, 'window', 3], [30, 32], [30, 44, 'wait', 3], [18, 45], [18, 49]];"," const COUNT_RUN = [[27, 36], [26, 36], [25, 41], [25, 42.5, 'cut'], [30, 43], [33, 31, 'window', 3], [33, 26], [33, 21, 'lookBack'], [46, 21]];"," /** a route walker with counter-surveillance acts: the target of a tail */"," function routeBrain(route, o = {}) {"]},{"oldStart":17114,"oldLines":8,"newStart":17132,"newLines":8,"lines":[" function tailCheck(F, dt, tgt, o = {}) {","   const me = F.me, d = dist(me, tgt), sight = World.map.sight({ x: me.x, y: me.y, z: 0 }, { x: tgt.x, y: tgt.y, z: 0 });","   me.tooClose = d < 64; F.band = d;","-  const lose = DIFF().lose * (o.ease || 1);","-  if (d > 220 || !sight) F.losing = (F.losing || 0) + dt; else F.losing = Math.max(0, (F.losing || 0) - dt * 2);","+  const lose = DIFF().lose * 1.5 * (o.ease || 1);","+  if (d > 240 || !sight) F.losing = (F.losing || 0) + dt; else F.losing = Math.max(0, (F.losing || 0) - dt * 2);","   // mirroring: stopping when he stops","   const ra = tgt.rt && tgt.rt.act; if (ra && ra !== 'phone' && me.still > .5 && me.still < 3 && !me.cover && sight && d < 170) me.still = 2.1;","   if (F.losing > lose) return 'lost';"]},{"oldStart":17124,"oldLines":8,"newStart":17142,"newLines":8,"lines":[" MISSIONS.tail = {","   place: 'Penn Row, the long way', mood: 'night', rain: .6, clock: ['20:00', '21:20'], clockRate: .8, start: [30, 27], civilians: 8, stamina: true, music: 'field',","   setup(F) {","-    const extra = STATE.meters.heat >= 70 ? [6, 12, 21] : [];","-    const tee = F.tee = npc('tee', 30, 32, { id: 'teeT', watcher: true, range: 170, fov: 1.5 }); tee.brain = routeBrain(TEE_DRY, { extraLook: extra, onWaypoint: i => { if ([4, 9, 14, 19].includes(i)) F.cp = i; } });","+    const extra = STATE.meters.heat >= 70 ? [6, 11, 15] : [];","+    const tee = F.tee = npc('tee', 30, 32, { id: 'teeT', watcher: true, range: 170, fov: 1.5 }); tee.brain = routeBrain(TEE_DRY, { extraLook: extra, onWaypoint: i => { if ([4, 9, 13].includes(i)) F.cp = i; } });","     F.cp = 0; F.extraCops = [];","     const lou = F.partner = makePlayer('lou', C(26, 27), { id: 'lou', ctl: new BotCtl() }); lou.brain = (a, dt) => this.shadow(F, a, dt);","     F.handT = 0;"]},{"oldStart":17157,"oldLines":7,"newStart":17175,"newLines":7,"lines":["   retry(F, why) {","     STATE.stats.retries++; meter('brass', -5, 'Retry: ' + why);","     const i = F.cp, t = F.tee, w = TEE_DRY[i], p = C(w[0], w[1]); t.body.x = p.x; t.body.y = p.y; t.rt = { i: i + 1, act: null, t: 0 }; t.stop(); Perception.reset([t], F.me.id); Perception.reset([t], F.partner.id);","-    const back = nearWalk(p.x - 100, p.y); F.me.body.x = back.x; F.me.body.y = back.y; F.losing = 0; toast(why, 'Back to the last checkpoint.');","+    const pw = TEE_DRY[Math.max(0, i - 1)], back = C(pw[0], pw[1]); F.me.body.x = back.x; F.me.body.y = back.y; F.losing = 0; toast(why, 'Back to the last checkpoint.');","   },","   bars(F) { const d = F.band || 0, c = d < 64 ? '#ff6040' : d < 160 ? '#7ad06a' : d < 220 ? '#ffc040' : '#ff6040'; return [{ label: d < 64 ? 'Too close' : d > 160 ? 'Losing him' : 'Distance: good', value: clamp(1 - Math.abs(d - 112) / 160, 0, 1), max: 1, color: c }, ...(F.losing > 0 ? [{ label: 'Losing him', value: F.losing, max: DIFF().lose, color: '#ff6040' }] : [])]; },","   objective(F) { return F.flags.end ? { step: 'EP4 · TAIL', title: 'Read the handout', text: 'Hold the camera on Tee', at: { x: F.tee.x, y: F.tee.y } } : { step: 'EP4 · TAIL', title: 'Tail Tee', text: 'Don\\'t stop when he stops', at: { x: F.tee.x, y: F.tee.y } }; },"]},{"oldStart":17203,"oldLines":7,"newStart":17221,"newLines":7,"lines":["     F.interact({ id: 'teeP', at: () => F.tee || { x: -999, y: -999 }, verb: 'Show the paper', when: () => F.flags.phase === 'react' && F.tee && !F.flags.paper, act: () => { F.flags.paper = 1; Talk.run([['tee', 'Let me see the paper.'], ['dana', 'Signed by Halloway this afternoon. Sit down, Terrence.'], ['tee', \"You ain't gonna find nothing with my name on it.\"]]); } });","     F.interact({ id: 'hands', at: () => F.rookG || { x: -999, y: -999 }, verb: 'Hands!', when: () => F.flags.phase === 'react' && F.rookG && !F.flags.rookDone, act: () => { F.flags.rookDone = 1; sfx('confirm'); F.rookG.pose = 'handsup'; F.rookG.say('Aight! Aight.'); } });","     F.interact({ id: 'moeC', at: () => F.moeR || { x: -999, y: -999 }, verb: 'Grab him', when: () => F.flags.phase === 'react' && F.moeR && !F.flags.flushDone, act: () => { F.flags.flushDone = 1; F.flags.flushSaved = 1; F.moeR.pose = 'cuffed'; toast('Stopped the flush', 'The package stays out of the pipes.'); } });","-    F.flags.spots.forEach((s, i) => F.interact({ id: 'sp' + i, at: C(s[1], s[2]), verb: 'Search: ' + s[0], hold: 2, r: 14, when: () => F.flags.phase === 'search' && !F.flags.searched.includes(i), act: () => {","+    F.flags.spots.forEach((s, i) => F.interact({ id: 'sp' + i, at: C(s[1], s[2]), verb: 'Search: ' + s[0], hold: 2, r: 22, when: () => F.flags.phase === 'search' && !F.flags.searched.includes(i), act: () => {","       F.flags.searched.push(i); sfx('rustle');","       if (F.flags.stash.includes(i)) { const first = !F.flags.got; F.flags.got = (F.flags.got || 0) + 1; toast(first ? 'The package' : 'The cash and the gun', first ? 'Two kilos, Harstad boxes.' : '$41,000 and a 9mm.'); addEvidence({ id: 'seize:' + i, kind: 'seizure', text: first ? 'Two kilos in Harstad Auto Parts boxes' : '$41,000 and a pistol', direct: true }); addFact('seized:raid' + i, 5, true); if (F.flags.got >= 2) this.results(F); }","       else toast('Nothing', 'Plaster dust and an old calendar.');"]},{"oldStart":17242,"oldLines":13,"newStart":17260,"newLines":24,"lines":["     F.flags.phase = 'done'; meter('brass', 40, 'Dope on the table'); meter('heat', 15, 'The raid');","     Talk.run([['lou', 'Major blow, they\\'ll say. Watch.']], () => finish());","   },","-  drawUnder(F, r) { r.shape('boxtruck', 57.5 * T, 49 * T, 0, { facing: -Math.PI / 2 }); if (F.flags.phase !== 'rescue') lightBar(58 * T, 45 * T); },","+  drawUnder(F, r) {","+    r.shape('boxtruck', 57.5 * T, 49 * T, 0, { facing: -Math.PI / 2 }); if (F.flags.phase !== 'rescue') lightBar(58 * T, 45 * T);","+    // the four places to search, with their clues: a car's trunk, a ladder under a loose ceiling tile, a toolbox, plaster dust at a false wall","+    if (F.flags.phase === 'search' || F.flags.phase === 'react' || F.flags.phase === 'done') {","+      const S = F.flags.spots;","+      r.shape('sedan', (S[0][1] - .3) * T, (S[0][2] - .6) * T, 0, { facing: Math.PI / 2 });","+      r.queue(S[1][1] * T, S[1][2] * T, 0, g => { const a = r.w(S[1][1] * T - 3, S[1][2] * T, 0), b = r.w(S[1][1] * T - 3, S[1][2] * T, 22), c = r.w(S[1][1] * T + 3, S[1][2] * T, 0), d = r.w(S[1][1] * T + 3, S[1][2] * T, 22); px.line(g, a[0], a[1], b[0], b[1], '#a8884a'); px.line(g, c[0], c[1], d[0], d[1], '#a8884a'); for (let k = 1; k < 6; k++) { const p0 = r.w(S[1][1] * T - 3, S[1][2] * T, k * 4), p1 = r.w(S[1][1] * T + 3, S[1][2] * T, k * 4); px.line(g, p0[0], p0[1], p1[0], p1[1], '#a8884a'); } });","+      r.shape('chest', S[2][1] * T, S[2][2] * T, 0, { facing: 0, scale: .7, mats: { w: '#a82a22 metal', b: '#3a3a3a', l: '#c8c8c8' } });","+      r.decal(() => r.groundDisc(S[3][1] * T, S[3][2] * T, 6, '#d8d0c0', .5));","+      for (const [i, sp] of S.entries()) if (F.flags.searched.includes(i)) r.decal(() => r.groundRing(sp[1] * T, sp[2] * T, 7, '#5a5a5a', .5));","+    }","+  },","   objective(F) {","     const fl = F.flags;","     if (fl.phase === 'rescue') return { step: 'EP5 · RESCUE', title: 'Get to 1412 Gaither (' + Math.ceil(fl.rescueT) + 's)', text: 'Run.', at: C(28, 36) };","     if (fl.phase === 'stack') return { step: 'EP5 · RAID', title: 'Breach the door', text: 'On your go', at: fl.door === 'side' ? C(49.4, 50) : C(55.6, 50.5) };","     if (fl.phase === 'react') return { step: 'EP5 · RAID', title: !fl.flushDone ? 'Stop Moe before he flushes it' : !fl.rookDone && F.rookG ? 'Rook: make him show his hands' : 'Talk to Tee', text: Math.ceil(fl.reactT) + 's', at: !fl.flushDone && F.moeR ? { x: F.moeR.x, y: F.moeR.y } : F.rookG && !fl.rookDone ? { x: F.rookG.x, y: F.rookG.y } : F.tee ? { x: F.tee.x, y: F.tee.y } : null };","-    if (fl.phase === 'search') return { step: 'EP5 · RAID', title: 'Search the garage (' + (fl.got || 0) + '/2 found)', text: 'Look for plaster dust and ladders', at: C(52.5, 50.5) };","+    if (fl.phase === 'search') { const left = fl.spots.map((s, i) => [s, i]).filter(([, i]) => !fl.searched.includes(i)).sort((a, b) => dist(F.me, C(a[0][1], a[0][2])) - dist(F.me, C(b[0][1], b[0][2]))); const nx = left[0] && left[0][0]; return { step: 'EP5 · RAID', title: 'Search the garage (' + (fl.got || 0) + '/2 found)', text: nx ? 'Next: ' + nx[0] + ' · plaster dust, a ladder, a trunk, a toolbox' : '', at: nx ? C(nx[1], nx[2]) : C(52.5, 50.5) }; }","     return null;","   },","   counts: () => []"]},{"oldStart":17399,"oldLines":13,"newStart":17428,"newLines":13,"lines":[" // Partner), studying people to call out a cop, the pager and the code card, the payphone keypad, the patrol, the knockers,"," // the count at the end against Easy's number."," const INTERLUDES = {","-  i1: { title: 'Interlude 1 · Night shift', target: 520, secs: 210, events: [[20, 'dutch'], [45, 'patrol'], [10, 'pigeonSleep'], [70, 'ud'], [130, 'reupNeed']],","+  i1: { title: 'Interlude 1 · Night shift', target: 450, secs: 210, events: [[20, 'dutch'], [45, 'patrol'], [10, 'pigeonSleep'], [70, 'ud'], [130, 'reupNeed']],","     intro: [['rook', 'Who told you the old man\\'s name, Tee? The bus driver.'], ['tee', 'Nobody told me nothing. Somebody called 911 and somebody downtown read it out loud. That\\'s how it works.'], ['rook', 'Then it works for us.'], ['tee', 'It works till it don\\'t. Count\\'s at two. Get on your spot.']] },","-  i2: { title: 'Interlude 2 · New stash', target: 480, secs: 180, events: [[5, 'stashPick'], [40, 'reupNeed'], [90, 'knockers'], [60, 'ud']],","+  i2: { title: 'Interlude 2 · New stash', target: 420, secs: 180, events: [[5, 'stashPick'], [40, 'reupNeed'], [90, 'knockers'], [60, 'ud']],","     intro: [['tee', 'Corey\\'s in Central. That means the stash moves tonight. And the phones... we pick a phone they ain\\'t sitting on.']] },","-  i3: { title: 'Interlude 3 · Making it back', target: 640, secs: 210, events: [[50, 'hearse'], [100, 'ud'], [120, 'shots']],","+  i3: { title: 'Interlude 3 · Making it back', target: 560, secs: 210, events: [[50, 'hearse'], [100, 'ud'], [120, 'shots']],","     intro: [['tee', 'Double shift. Pigeon running. We make back what Sunday took or Easy takes it out of somebody.']] },","-  i4: { title: 'Interlude 4 · Throwaways', target: 420, secs: 150, events: [[25, 'danaCar'], [60, 'ud']],","+  i4: { title: 'Interlude 4 · Throwaways', target: 380, secs: 150, events: [[25, 'danaCar'], [60, 'ud']],","     intro: [['tee', 'Everybody got the new phones? Old ones in the harbor. Not the trash. The harbor.']] }"," };"," const WHEEL = [['Shut it down', 'shut'], ['Open up', 'open'], ['Move the stash', 'stash'], ['Post up here', 'post']];"]},{"oldStart":17921,"oldLines":7,"newStart":17950,"newLines":7,"lines":["   enter(data = {}) {","     if (!annexMap) annexMap = new E.TileMap({ rows: ANNEX_ROWS, legend: { '#': 1, '.': { floor: 'lino' }, ',': { floor: 'door' } }, types: { 1: { h: 40, top: '#3a3834', side: '#a8a090', face: 'plaster', roof: 'plain', cut: true, windows: { lit: .6 } } },","       floorTex: (x, y, tag) => { const ix = Math.floor(x / 8), iy = Math.floor(y / 8); return tag === 'door' ? [90, 70, 50] : (ix + iy) % 2 ? [138, 132, 120] : [122, 116, 106]; }, outside: '#141210' });","-    const b = Director.beat(); this.b = b; this.st = data.stations || b.stations || {}; this.used = {}; this.t = 0;","+    this.map = annexMap; const b = Director.beat(); this.b = b; this.st = data.stations || b.stations || {}; this.used = {}; this.t = 0;","     const p = C(10.5, 7.5); this.me = makePlayer('dana', p); this.me.facing = -Math.PI / 2;","     this.cast = [['lou', 10.3, 3.9], ['hal', 13.3, 7.9], ['ren', 7.3, 7.9], ['navarre', 18.3, 3.2]].map(([id, cx, cy]) => { const a = new Agent({ id, person: id, x: (cx + .5) * T, y: (cy + .5) * T }); a.facing = Math.PI / 2; return a; });","     if (b.extra) for (const id of b.extra) { const a = new Agent({ id, person: id, x: 16.5 * T, y: 3 * T }); a.facing = Math.PI; this.cast.push(a); }"]},{"oldStart":17933,"oldLines":9,"newStart":17962,"newLines":10,"lines":["   },","   exit() { game.saves.canSave = false; STATE.inAnnex = false; if (ui) ui.hud({}); game.lights.enabled = false; },","   live(k) { const s = this.st[k]; return s && (!s.need || s.need()) && !(s.once && this.used[k]); },","-  required() { return Object.entries(this.st).filter(([k, s]) => s.required && !this.used[k]); },","+  required() { const r = Object.entries(this.st).filter(([k, s]) => s.required && !this.used[k]); return r.filter(([k, s]) => !s.need || s.need()).concat(r.filter(([k, s]) => s.need && !s.need())); },","   update(dt) {","     if (Globals.tick(dt)) return;","+    if (Talk.open) { Talk.update(dt); game.focus(this.me.x, this.me.y, 16); return; }","     if (UI.update(dt)) return; if (Talk.update(dt)) { game.focus(this.me.x, this.me.y, 16); return; }","     this.t += dt;","     if (game.input.pressed('notebook') || game.input.pressed('map') || padCreate()) { Notebook.open(game.input.pressed('map') ? 'map' : 'objectives'); return; }"]},{"oldStart":17958,"oldLines":7,"newStart":17988,"newLines":7,"lines":["   },","   use(k) {","     if (k === 'stairs') { if (this.b.car && !Attract.on) return Director.car(this.b.car, () => Director.complete()); return Director.complete(); }","-    const s = this.st[k]; this.used[k] = true; s.act(() => {});","+    const s = this.st[k]; this.used[k] = true; s.act(() => { if (s.complete && !s.complete()) { this.used[k] = false; toast('Not finished', s.unfinished || 'Come back to it.'); } });","   },","   draw(r) {","     annexMap.drawFloor(r); annexMap.queueWalls(r);"]},{"oldStart":18011,"oldLines":6,"newStart":18041,"newLines":7,"lines":["   update(dt) {","     if (Globals.tick(dt)) return; this.t += dt;","     for (const a of this.cast) a.rig.update(dt, { x: a.x, y: a.y, z: 0, vx: 0, vy: 0, facing: a.facing, pose: a.pose ? POSE[a.pose] || a.pose : null });","+    if (Talk.open) { Talk.update(dt); this.cam(); return; }   // a line spoken over a screen (a call from the wire room) goes first","     if (UI.update(dt)) { this.cam(); return; }","     Talk.update(dt); this.cam();","   },"]},{"oldStart":18071,"oldLines":9,"newStart":18102,"newLines":9,"lines":["     stations: { navarre: st('Ops: the informant', done => opsChoice(2, done), { required: true }) } },","   { id: 'e2.phones', ep: 2, kind: 'field', m: 'phones', name: 'Payphones' },","   { id: 'e2.box', ep: 2, ...room('box', [['corey', 3.5, 1.9, Math.PI / 2, 'sit'], ['lou', 5.2, 3, Math.PI * .8], ['dana', 3.5, 3.4, -Math.PI / 2]], R => Box.open('corey', () => Director.complete())), name: 'The box' },","-  { id: 'e2.paper', ep: 2, kind: 'annex', name: 'The paper', extra: ['vance'],","+  { id: 'e2.paper', ep: 2, kind: 'annex', name: 'The paper', extra: ['vance'], leave: 'To the courthouse',","     brief: () => [['hal', \"Corey's pager has five pages on it. Bring it to the cage. Somebody wrote those numbers in a code a twelve-year-old could break. Lucky for us, so can I. Mostly.\"]],","-    stations: { evidence: st('Decode the pager', done => Cipher.open(PAGES_COREY, { done }), { required: true, label: 'Evidence cage: the pager' }),","+    stations: { evidence: st('Decode the pager', done => Cipher.open(PAGES_COREY, { done }), { required: true, label: 'Evidence cage: the pager', complete: () => STATE.cipher.decoded.length > 0, unfinished: 'Turn the keypad until a page matches a number you know.' }),","       desk: st('Write the affidavit', done => Paper.open((res, nec) => { Director.paperRes = [res, nec]; done(); }), { required: true, need: () => STATE.cipher.decoded.length > 0 }) } },","   { id: 'e2.chambers', ep: 2, ...room('chambers', [['halloway', 4, 1.3, Math.PI / 2], ['vance', 3, 3.2, -Math.PI / 2], ['dana', 5, 3.2, -Math.PI / 2]], R => { const [res, nec] = Director.paperRes || [Paper.lines().map(l => ({ id: l.id, p: 0, ok: false, picks: [] })), {}]; Paper.judge(res, nec, up => Director.complete(up ? 'up' : 'denied')); }), name: 'Chambers',","     next: r => r === 'denied' ? 'e2.more' : 'e2.i2' },"]},{"oldStart":18179,"oldLines":7,"newStart":18210,"newLines":7,"lines":["   /** episode select: canonical states */","   preset(ep) {","     STATE = freshState(); const f = STATE.flags, m = STATE.meters;","-    const faces = () => { for (const id of CREW4) { addFact('face:' + id, 0, true); addFact('name:' + id, 0, true); } addFact('obs:tee:lieutenant', 0, true); addFact('obs:pigeon:lookout', 0, true); f.pocketsMet = true; f.dreLine = true; STATE.stats.photos = 8; };","+    const faces = () => { for (const id of CREW4) { addFact('face:' + id, 0, true); addFact('name:' + id, 0, true); } addFact('obs:tee:lieutenant', 0, true); addFact('obs:pigeon:lookout', 0, true); f.pocketsMet = true; f.dreLine = true; STATE.stats.photos = 8; addEvidence({ id: 'stmt:pockets', kind: 'stmt', text: 'Pockets: names to the shoes (4/4)' }); addFact('stmt:pockets:crew', 0, true); };","     if (ep >= 2) { faces(); m.heat = 20; m.brass = 50; }","     if (ep >= 3) { for (const k of ['P1', 'P2', 'P3', 'PG']) STATE.numbers[k].known = true; STATE.wire.lines = { P1: 'up', P2: 'up', PG: 'up' }; f.wireUp = true; addEvidence({ id: 'pager', kind: 'seizure', text: \"Corey's pager, label 555-0110\", direct: true }); addFact('stmt:corey:code', 0, true); addFact('seized:pager', 0, true); m.heat = 25; m.brass = 60; m.case = 40; }","     if (ep >= 4) { f.dilemma = 'stay'; f.sweep = false; f.wallOff = true; f.rookFree = false; addFact('plate:harstad', 0, true); addFact('int:mamab', 0, true); addFact('int:boss', 0, true); STATE.cipher.dir = 'ccw'; m.heat = 45; m.brass = 55; m.case = 70; }"]},{"oldStart":18251,"oldLines":7,"newStart":18282,"newLines":7,"lines":["   enter() { Music.play('montage'); this.t = 0; if (ui) ui.hud({}); game.lights.enabled = false; Director.shutFlag = true;","     Talk.run([['navarre', 'Detail 9 is disbanded, effective Monday.'], ['navarre', 'Pack your desk, Dana. The Major got his number. It just wasn\\'t ours.']], () => UI.cards({ kicker: 'SHUT DOWN', title: 'The detail is done.', cards: [{ title: 'Retry from the last autosave', body: 'Back to the start of the last part.' }, { title: 'See how it ends', body: 'The Shut Down montage.' }],","       pick: i => { Director.shut = false; if (i === 0) { Director.shutFlag = false; Director.restartBeat(); } else game.go('montage', {}); } })); },","-  update(dt) { if (Globals.tick(dt)) return; if (UI.update(dt)) return; Talk.update(dt); },","+  update(dt) { if (Globals.tick(dt)) return; if (Talk.open) { Talk.update(dt); return; } if (UI.update(dt)) return; Talk.update(dt); },","   draw(r) { r.sky(['#0a0806', '#141010', '#1a1614']); r.overlay(g => { px.rect(g, Math.round(r.W / 2) - 40, Math.round(r.H / 2) - 10, 30, 20, '#8a6a4a'); px.rect(g, Math.round(r.W / 2) + 5, Math.round(r.H / 2) - 4, 30, 14, '#7a5a3a'); rigOf('navarre').drawPortrait(g, Math.round(r.W / 2) - 16, Math.round(r.H / 2) - 60, 40, {}); }); Talk.draw(r); }"," };"," "]},{"oldStart":18831,"oldLines":7,"newStart":18862,"newLines":7,"lines":["   snapshot: () => ({ scene: game.sceneName, ep: STATE.ep, beat: STATE.beat, meters: STATE.meters, flags: Object.fromEntries(Object.entries(STATE.flags).filter(([, v]) => v)), facts: STATE.facts.length, evidence: STATE.evidence.length,","     dana: FD.me ? [Math.round(FD.me.x), Math.round(FD.me.y)] : null, objective: game.sceneName === 'field' && FD.m && FD.m.objective ? (FD.m.objective(FD) || {}).title : null, attract: Attract.on, ui: UI.top() && UI.top().id,","     versus: Versus.sim ? { ev: Versus.sim.ev, cn: Versus.sim.corner.led.banked + Versus.sim.corner.led.cash, t: Math.round(Versus.sim.t), over: Versus.sim.over } : null, errors: game.errors.length }),","-  jump: id => Director.start(id), preset: ep => Director.preset(ep), state: () => STATE, Globals, Director, Attract, UI, Versus, FD, World, Cipher, Wire, Board, Box, Paper, CornerSim, MISSIONS, BEATS","+  jump: id => Director.start(id), preset: ep => Director.preset(ep), state: () => STATE, Globals, Talk, Camera, Director, Attract, UI, Versus, FD, World, Cipher, Wire, Board, Box, Paper, CornerSim, MISSIONS, BEATS"," };"," if (typeof window !== 'undefined') window.__wt = game.debug;"," /** deep links: #title #attract #about #ep<N> #ep<N>.<beat> (#ep3.wire2) #versus.bots #versus.local */"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-215911__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-medium-20261103-215911.html","hunks":[{"oldStart":1335,"oldLines":7,"newStart":1335,"newLines":7,"lines":["     on(window, 'blur', () => all(q => q.clear()));","     on(document, 'visibilitychange', () => { if (document.hidden) all(q => q.clear()); });","     on(el, 'contextmenu', e => e.preventDefault());","-    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });","+    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { /* DQB: mouseMove */ if (Math.hypot(e.clientX - this.mouse.cx, e.clientY - this.mouse.cy) > 2) this.lastDevice = 'mouse'; this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });","     on(el, 'pointerdown', e => {","       if (e.pointerType !== 'mouse') this.lastDevice = 'touch';   // any touch, on the stick's half or not: prompts follow it","       if (e.pointerType !== 'mouse' || e.button === 0) this._down = { id: e.pointerId, x: e.clientX, y: e.clientY };   // a click or tap once it lifts near here (pointerup)"]},{"oldStart":15236,"oldLines":7,"newStart":15236,"newLines":7,"lines":[" "," </script>"," <script>","-globalThis.DQ = globalThis.DQ || {}; DQ.ABOUT = {\"sourceInformation\":{\"date\":\"2026-11-03 21:59:11\",\"source\":\"Dragon Quest Builders\",\"plan\":\"PLAN.md\",\"genre\":\"Sandbox action RPG: block building, crafting and town building, with real-time combat, a siege and bosses\",\"perspective\":\"Third-person isometric 2.5D over a true voxel world, turning in 90-degree steps with zoom steps; three-quarter view as a setting\",\"tech\":\"my-3D2dge v0.85.2 (full engine, lightly modified) with a custom voxel world, renderer, physics and navigation in plain JavaScript (ES2020); Canvas 2D; Web Audio; AI Hub Session Protocol v1 client 1.4.0; Node 18+ vm for headless tests; Playwright 1.63.0 for browser checks\",\"artDirection\":\"The engine's native pixel style (ps1 resolution, shaded HD puppet rigs, canvas lighting) with an original patchwork-quilt look: every block a 16x16 fabric patch with stitched seams, felt UI panels with running-stitch borders, a patchwork logo\",\"animation\":\"The engine's procedural Humanoid and Blob rigs and E.MOVES, plus new moves (place, eat, stir, chop), poses for notions, sleep, KO and cheering, tools drawn on the rig (darning stick, cobble club, Seam Ripper), boss telegraphs, swinging doors, a fluttering banner, portal swirls, an unravel effect\",\"audio\":\"All in code: 14 original songs in the engine's step sequencer built on a leitmotif (a town waltz with layers by town level, boss fury layer, Bee raid layer), 12 jingles, about 50 synthesized sound effects, and an Animalese formant voice synth with a profile per character on its own Voices volume bus\",\"online\":\"AI Hub shared-world sessions (1-4 players): the Quilting Bee co-op round with the game's own card, host-run world, client prediction, snapshots and reliable edit events, standings, awards, time-up, leave, end and server mode; solo Bee with bots offline\",\"testing\":\"Headless scripted tests in Node (game.advance and game.debug): 19 suites including a full scripted playthrough, a fake multi-copy AI Hub with latency and loss, attract-mode loops; Playwright screenshots and the AI Hub harness's four scenarios in Chromium\",\"research\":\"No web research on the source game. Read the engine handoff docs (API card, guide sections, renderer, input, dialog and audio source) and the AI Hub protocol README; the plan stage did the same\",\"environment\":\"Claude Code CLI (headless); Linux; browser unknown\",\"model\":\"Anthropic, claude-opus-5-5, reasoning effort medium\",\"usage\":\"Estimated: about 122.7M tokens in total over 208 model calls (121.3M cache reads, 0.86M cache writes, 0.56M output, under 1K uncached input), from the session log; about $80 at Opus-class list prices ($0.50/M cache read, $6.25/M cache write, $25/M output), the exact rate for this model unconfirmed; session time about 2 h 20 min (21:59 to about 00:20)\"},\"testingFeedback\":[\"41 issues, tallied from this session: 31 bugs in the game and its AI, and 10 mistakes in the tests themselves. Game bugs: x-ray silhouettes missing (wall items had no screen box); the deep Lint Hollow hid the player; the Quilters' Hall room failed on uneven ground; the attract mode silenced all audio, collided with a prop, left the finale cutscene running and left its builder seated on a ballista; stair lips blocked walking; the deep-water rule was wrong; Spin Stitch could not charge; room hints picked a wall-top area; Gnarlgrim could walk into the Rift's void; Rift spawns stuck behind the void; saves stored every plant; Bee clients never saw monsters (a duplicate method name); the version label showed '?'; the Knot Wall towered at full height; damaged blocks healed between hits (a seconds-vs-hours mix-up); M12 needed a far turn-in; 'survive 3 waves' only counted after the boss; the ballista aim arc was too narrow, its bolts hit walls and fell short, and any hit (even zero damage) knocked the player off it; skipping the finale never showed the results; and seven Autopilot faults (out-of-reach spots, chasing monsters across the map, a talk loop that never yielded, not equipping crafted weapons, ignoring the Knot Cage, not clearing plants, residents in the way).\",\"8 were game breaking for a player: the Hall room not forming (softlocks quest M10), damaged blocks healing between hits (mining could become impossible), Gnarlgrim falling into the void (the siege ends without its boss), the ballista dismount on any hit (the boss nearly impossible to Tangle), the results never showing after a skipped finale, invisible monsters for co-op clients, the player hidden in the opening area, and silenced audio after the attract mode.\",\"The scripted playthrough with the Autopilot: it plays the real systems from New Game to Chapter Clear and found the block-healing, ballista, siege-flow and finale bugs that no single-system check caught.\",\"The world-generation determinism check: it never failed and only confirmed what the design already guaranteed.\"],\"engineFeedback\":[\"Its views are plain linear projections with exact whole-pixel control, so a voxel renderer could plug straight into its depth-sorted queue, x-ray, lighting and particles; the Humanoid rigs, dialog, menus, saves and settings came for free.\",\"Yes: queued occluders need a screen box for the x-ray pass, which I only found by reading the flush code; and the default iso view's height step is not a whole number of pixels, so I made my own views.\",\"The voxel world: storage, a face-sprite atlas renderer with column runs, cutaway and water, circle-body physics with stairs, and A* navigation, because the engine's TileMap is a heightmap.\",\"Depth sorting real 3D blocks with a 2D painter's queue built for heightmap walls: lifting actors over the blocks they stand on and keeping roofs in front.\",\"Small, marked // DQB: an input wheelSteps() accessor that works while the camera wheel is off and a right-stick flick(), a Dialog onLetter hook for per-letter voices, a Voices audio bus, and tool kinds (stick, club, Seam Ripper) drawn on the Humanoid's sword joints.\",\"A first-class block or voxel map type with its own lift hook and occluder boxes, so 3D building games do not have to rebuild the renderer.\"],\"promptFeedback\":[\"A clear definition of done and a detailed plan: every system had a place, and the controller-first, 10-foot rules made the UI decisions easy.\",\"The plan's file names used a different model and timestamp than TASK.md; TASK.md wins, but it took a moment to be sure.\",\"Making a whole chapter completable through real triggers and proving it with an automated playthrough, alongside netcode and an attract mode, in one pass.\",\"Ask for a smaller vertical slice or allow staged delivery; the plan's scope (17 quests, two bosses, a siege, online co-op, an attract mode) is very large for one session.\"],\"aiHub\":{\"name\":\"Dragon Quilt Builders\",\"tagline\":\"Stitch a frayed world back together\",\"description\":\"Gather, craft and build block by block to mend a patchwork kingdom unravelled by a dragon. Raise rooms for quirky residents, defend your town and unpick a knotted boss, or raise a barn together in co-op Quilting Bee rounds.\",\"type\":\"Game\",\"genre\":\"RPG\",\"source\":\"Dragon Quest Builders\",\"series\":\"Dragon Quest\",\"players\":\"1–4\",\"controls\":\"Stick/WASD move · ✕/Space jump · □/Click break · △/Right-click place · L1 R1/wheel items · ○/F talk\",\"tags\":[\"building\",\"crafting\",\"co-op\",\"fantasy\",\"comedy\",\"pixel art\"]}};","+globalThis.DQ = globalThis.DQ || {}; DQ.ABOUT = {\"sourceInformation\":{\"date\":\"2026-11-03 21:59:11\",\"source\":\"Dragon Quest Builders\",\"plan\":\"PLAN.md\",\"genre\":\"Sandbox action RPG: block building, crafting and town building, with real-time combat, a siege and bosses\",\"perspective\":\"Third-person isometric 2.5D over a true voxel world, turning in 90-degree steps with zoom steps; three-quarter view as a setting\",\"tech\":\"my-3D2dge v0.85.2 (full engine, lightly modified) with a custom voxel world, renderer, physics and navigation in plain JavaScript (ES2020); Canvas 2D; Web Audio; AI Hub Session Protocol v1 client 1.4.0; Node 18+ vm for headless tests; Playwright 1.63.0 for browser checks\",\"artDirection\":\"The engine's native pixel style (ps1 resolution, shaded HD puppet rigs, canvas lighting) with an original patchwork-quilt look: every block a 16x16 fabric patch with stitched seams, felt UI panels with running-stitch borders, a patchwork logo\",\"animation\":\"The engine's procedural Humanoid and Blob rigs and E.MOVES, plus new moves (place, eat, stir, chop), poses for notions, sleep, KO and cheering, tools drawn on the rig (darning stick, cobble club, Seam Ripper), boss telegraphs, swinging doors, a fluttering banner, portal swirls, an unravel effect\",\"audio\":\"All in code: 14 original songs in the engine's step sequencer built on a leitmotif (a town waltz with layers by town level, boss fury layer, Bee raid layer), 12 jingles, 45 synthesized sound effects, and an Animalese formant voice synth with a profile per character on its own Voices volume bus\",\"online\":\"AI Hub shared-world sessions (1-4 players): the Quilting Bee co-op round with the game's own card, host-run world, client prediction, snapshots and reliable edit events, standings, awards, time-up, leave, end and server mode; solo Bee with bots offline\",\"testing\":\"Headless scripted tests in Node (game.advance and game.debug): 19 suites including a full scripted playthrough, a fake multi-copy AI Hub with latency and loss, attract-mode loops; Playwright screenshots and the AI Hub harness's four scenarios in Chromium\",\"research\":\"No web research on the source game. Read the engine handoff docs (API card, guide sections, renderer, input, dialog and audio source) and the AI Hub protocol README; the plan stage did the same\",\"environment\":\"Claude Code CLI (headless); Linux; browser unknown\",\"model\":\"Anthropic, claude-opus-5-5, reasoning effort medium\",\"usage\":\"Estimated: about 122.7M tokens in total over 208 model calls (121.3M cache reads, 0.86M cache writes, 0.56M output, under 1K uncached input), from the session log; about $80 at Opus-class list prices ($0.50/M cache read, $6.25/M cache write, $25/M output), the exact rate for this model unconfirmed; session time about 2 h 20 min (21:59 to about 00:20)\"},\"testingFeedback\":[\"42 issues, tallied from this session: 32 bugs in the game and its AI, and 10 mistakes in the tests themselves. Game bugs: x-ray silhouettes missing (wall items had no screen box); the deep Lint Hollow hid the player; the Quilters' Hall room failed on uneven ground; the attract mode silenced all audio, collided with a prop, left the finale cutscene running and left its builder seated on a ballista; stair lips blocked walking; the deep-water rule was wrong; Spin Stitch could not charge; room hints picked a wall-top area; Gnarlgrim could walk into the Rift's void; Rift spawns stuck behind the void; saves stored every plant; Bee clients never saw monsters (a duplicate method name); the version label showed '?'; the Knot Wall towered at full height; damaged blocks healed between hits (a seconds-vs-hours mix-up); M12 needed a far turn-in; 'survive 3 waves' only counted after the boss; the ballista aim arc was too narrow, its bolts hit walls and fell short, and any hit (even zero damage) knocked the player off it; skipping the finale never showed the results; and seven Autopilot faults (out-of-reach spots, chasing monsters across the map, a talk loop that never yielded, not equipping crafted weapons, ignoring the Knot Cage, not clearing plants, residents in the way); and menu hover only worked after a mouse click.\",\"8 were game breaking for a player: the Hall room not forming (softlocks quest M10), damaged blocks healing between hits (mining could become impossible), Gnarlgrim falling into the void (the siege ends without its boss), the ballista dismount on any hit (the boss nearly impossible to Tangle), the results never showing after a skipped finale, invisible monsters for co-op clients, the player hidden in the opening area, and silenced audio after the attract mode.\",\"The scripted playthrough with the Autopilot: it plays the real systems from New Game to Chapter Clear and found the block-healing, ballista, siege-flow and finale bugs that no single-system check caught.\",\"The world-generation determinism check: it never failed and only confirmed what the design already guaranteed.\"],\"engineFeedback\":[\"Its views are plain linear projections with exact whole-pixel control, so a voxel renderer could plug straight into its depth-sorted queue, x-ray, lighting and particles; the Humanoid rigs, dialog, menus, saves and settings came for free.\",\"Yes: queued occluders need a screen box for the x-ray pass, which I only found by reading the flush code; and the default iso view's height step is not a whole number of pixels, so I made my own views.\",\"The voxel world: storage, a face-sprite atlas renderer with column runs, cutaway and water, circle-body physics with stairs, and A* navigation, because the engine's TileMap is a heightmap.\",\"Depth sorting real 3D blocks with a 2D painter's queue built for heightmap walls: lifting actors over the blocks they stand on and keeping roofs in front.\",\"Small, marked // DQB: an input wheelSteps() accessor that works while the camera wheel is off and a right-stick flick(), a Dialog onLetter hook for per-letter voices, a Voices audio bus, and tool kinds (stick, club, Seam Ripper) drawn on the Humanoid's sword joints; and moving the mouse now counts as using it, so menus answer to hover and prompts switch to mouse icons without a click.\",\"A first-class block or voxel map type with its own lift hook and occluder boxes, so 3D building games do not have to rebuild the renderer.\"],\"promptFeedback\":[\"A clear definition of done and a detailed plan: every system had a place, and the controller-first, 10-foot rules made the UI decisions easy.\",\"The plan's file names used a different model and timestamp than TASK.md; TASK.md wins, but it took a moment to be sure.\",\"Making a whole chapter completable through real triggers and proving it with an automated playthrough, alongside netcode and an attract mode, in one pass.\",\"Ask for a smaller vertical slice or allow staged delivery; the plan's scope (17 quests, two bosses, a siege, online co-op, an attract mode) is very large for one session.\"],\"aiHub\":{\"name\":\"Dragon Quilt Builders\",\"tagline\":\"Stitch a frayed world back together\",\"description\":\"Gather, craft and build block by block to mend a patchwork kingdom unravelled by a dragon. Raise rooms for quirky residents, defend your town and unpick a knotted boss, or raise a barn together in co-op Quilting Bee rounds.\",\"type\":\"Game\",\"genre\":\"RPG\",\"source\":\"Dragon Quest Builders\",\"series\":\"Dragon Quest\",\"players\":\"1–4\",\"controls\":\"Stick/WASD move · ✕/Space jump · □/Click break · △/Right-click place · L1 R1/wheel items · ○/F talk\",\"tags\":[\"building\",\"crafting\",\"co-op\",\"fantasy\",\"comedy\",\"pixel art\"]}};"," // ---- src/00-core.js ----"," // Dragon Quilt Builders: core namespace, seeded streams, event bus, tuning, small helpers."," (() => {"]},{"oldStart":19861,"oldLines":7,"newStart":19861,"newLines":7,"lines":["     const EQ = ['What I liked most about the engine', 'Did I get stuck or guess wrong?', 'The most important thing I built myself', 'The hardest part of using the engine', 'What I changed in the engine, and why', 'One thing I would change'];","     const PQ = ['What I liked most about the prompt', 'What was confusing', 'The hardest thing to do', 'What I would change'];","     return [","-      ['Credits', [['', 'Dragon Quilt Builders: an original game inspired by Dragon Quest Builders (Square Enix). Not affiliated with or endorsed by Square Enix. No assets from the original.'], ['Design, code, art, music and writing', 'The AI model (Anthropic, claude-opus-5-5) under direction, from the plan PLAN.md.'], ['Engine', 'my-3D2dge v0.85.2 (MIT) by michaelcrosato, with these changes: an input wheel-steps accessor and right-stick flick; a Dialog onLetter hook; a Voices audio bus; darning stick, cobble club and Seam Ripper tools on the Humanoid rig.'], ['Online', 'AI Hub Session Protocol v1, client session.js 1.4.0.'], ['Thanks', 'To everyone who ever darned a sock.']]],","+      ['Credits', [['', 'Dragon Quilt Builders: an original game inspired by Dragon Quest Builders (Square Enix). Not affiliated with or endorsed by Square Enix. No assets from the original.'], ['Design, code, art, music and writing', 'The AI model (Anthropic, claude-opus-5-5) under direction, from the plan PLAN.md.'], ['Engine', 'my-3D2dge v0.85.2 (MIT) by michaelcrosato, with these changes: an input wheel-steps accessor and right-stick flick; a Dialog onLetter hook; a Voices audio bus; darning stick, cobble club and Seam Ripper tools on the Humanoid rig; the mouse moving counts as using it (menu hover, mouse prompts).'], ['Online', 'AI Hub Session Protocol v1, client session.js 1.4.0.'], ['Thanks', 'To everyone who ever darned a sock.']]],","       ['Source Information', SI.map(([k, v]) => [k, v || 'unknown'])],","       ['Testing Feedback', fb('testingFeedback', TQ)],","       ['Engine Feedback', fb('engineFeedback', EQ)],"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-215911__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-medium-20261103-215911/dev/index.html","hunks":[{"oldStart":20,"oldLines":7,"newStart":20,"newLines":7,"lines":[" <div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#f4f0ff;font-size:16px;letter-spacing:.08em\">DRAGON QUILT BUILDERS</b><span>Starting · my-3D2dge v0.85.2</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9b77c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>"," <canvas id=\"screen\"></canvas>"," <script src=\"../engine/my-3d2dge.js\"></script>","-<script>globalThis.DQ = globalThis.DQ || {}; DQ.ABOUT = {\"sourceInformation\":{\"date\":\"2026-11-03 21:59:11\",\"source\":\"Dragon Quest Builders\",\"plan\":\"PLAN.md\",\"genre\":\"Sandbox action RPG: block building, crafting and town building, with real-time combat, a siege and bosses\",\"perspective\":\"Third-person isometric 2.5D over a true voxel world, turning in 90-degree steps with zoom steps; three-quarter view as a setting\",\"tech\":\"my-3D2dge v0.85.2 (full engine, lightly modified) with a custom voxel world, renderer, physics and navigation in plain JavaScript (ES2020); Canvas 2D; Web Audio; AI Hub Session Protocol v1 client 1.4.0; Node 18+ vm for headless tests; Playwright 1.63.0 for browser checks\",\"artDirection\":\"The engine's native pixel style (ps1 resolution, shaded HD puppet rigs, canvas lighting) with an original patchwork-quilt look: every block a 16x16 fabric patch with stitched seams, felt UI panels with running-stitch borders, a patchwork logo\",\"animation\":\"The engine's procedural Humanoid and Blob rigs and E.MOVES, plus new moves (place, eat, stir, chop), poses for notions, sleep, KO and cheering, tools drawn on the rig (darning stick, cobble club, Seam Ripper), boss telegraphs, swinging doors, a fluttering banner, portal swirls, an unravel effect\",\"audio\":\"All in code: 14 original songs in the engine's step sequencer built on a leitmotif (a town waltz with layers by town level, boss fury layer, Bee raid layer), 12 jingles, about 50 synthesized sound effects, and an Animalese formant voice synth with a profile per character on its own Voices volume bus\",\"online\":\"AI Hub shared-world sessions (1-4 players): the Quilting Bee co-op round with the game's own card, host-run world, client prediction, snapshots and reliable edit events, standings, awards, time-up, leave, end and server mode; solo Bee with bots offline\",\"testing\":\"Headless scripted tests in Node (game.advance and game.debug): 19 suites including a full scripted playthrough, a fake multi-copy AI Hub with latency and loss, attract-mode loops; Playwright screenshots and the AI Hub harness's four scenarios in Chromium\",\"research\":\"No web research on the source game. Read the engine handoff docs (API card, guide sections, renderer, input, dialog and audio source) and the AI Hub protocol README; the plan stage did the same\",\"environment\":\"Claude Code CLI (headless); Linux; browser unknown\",\"model\":\"Anthropic, claude-opus-5-5, reasoning effort medium\",\"usage\":\"Estimated: about 122.7M tokens in total over 208 model calls (121.3M cache reads, 0.86M cache writes, 0.56M output, under 1K uncached input), from the session log; about $80 at Opus-class list prices ($0.50/M cache read, $6.25/M cache write, $25/M output), the exact rate for this model unconfirmed; session time about 2 h 20 min (21:59 to about 00:20)\"},\"testingFeedback\":[\"41 issues, tallied from this session: 31 bugs in the game and its AI, and 10 mistakes in the tests themselves. Game bugs: x-ray silhouettes missing (wall items had no screen box); the deep Lint Hollow hid the player; the Quilters' Hall room failed on uneven ground; the attract mode silenced all audio, collided with a prop, left the finale cutscene running and left its builder seated on a ballista; stair lips blocked walking; the deep-water rule was wrong; Spin Stitch could not charge; room hints picked a wall-top area; Gnarlgrim could walk into the Rift's void; Rift spawns stuck behind the void; saves stored every plant; Bee clients never saw monsters (a duplicate method name); the version label showed '?'; the Knot Wall towered at full height; damaged blocks healed between hits (a seconds-vs-hours mix-up); M12 needed a far turn-in; 'survive 3 waves' only counted after the boss; the ballista aim arc was too narrow, its bolts hit walls and fell short, and any hit (even zero damage) knocked the player off it; skipping the finale never showed the results; and seven Autopilot faults (out-of-reach spots, chasing monsters across the map, a talk loop that never yielded, not equipping crafted weapons, ignoring the Knot Cage, not clearing plants, residents in the way).\",\"8 were game breaking for a player: the Hall room not forming (softlocks quest M10), damaged blocks healing between hits (mining could become impossible), Gnarlgrim falling into the void (the siege ends without its boss), the ballista dismount on any hit (the boss nearly impossible to Tangle), the results never showing after a skipped finale, invisible monsters for co-op clients, the player hidden in the opening area, and silenced audio after the attract mode.\",\"The scripted playthrough with the Autopilot: it plays the real systems from New Game to Chapter Clear and found the block-healing, ballista, siege-flow and finale bugs that no single-system check caught.\",\"The world-generation determinism check: it never failed and only confirmed what the design already guaranteed.\"],\"engineFeedback\":[\"Its views are plain linear projections with exact whole-pixel control, so a voxel renderer could plug straight into its depth-sorted queue, x-ray, lighting and particles; the Humanoid rigs, dialog, menus, saves and settings came for free.\",\"Yes: queued occluders need a screen box for the x-ray pass, which I only found by reading the flush code; and the default iso view's height step is not a whole number of pixels, so I made my own views.\",\"The voxel world: storage, a face-sprite atlas renderer with column runs, cutaway and water, circle-body physics with stairs, and A* navigation, because the engine's TileMap is a heightmap.\",\"Depth sorting real 3D blocks with a 2D painter's queue built for heightmap walls: lifting actors over the blocks they stand on and keeping roofs in front.\",\"Small, marked // DQB: an input wheelSteps() accessor that works while the camera wheel is off and a right-stick flick(), a Dialog onLetter hook for per-letter voices, a Voices audio bus, and tool kinds (stick, club, Seam Ripper) drawn on the Humanoid's sword joints.\",\"A first-class block or voxel map type with its own lift hook and occluder boxes, so 3D building games do not have to rebuild the renderer.\"],\"promptFeedback\":[\"A clear definition of done and a detailed plan: every system had a place, and the controller-first, 10-foot rules made the UI decisions easy.\",\"The plan's file names used a different model and timestamp than TASK.md; TASK.md wins, but it took a moment to be sure.\",\"Making a whole chapter completable through real triggers and proving it with an automated playthrough, alongside netcode and an attract mode, in one pass.\",\"Ask for a smaller vertical slice or allow staged delivery; the plan's scope (17 quests, two bosses, a siege, online co-op, an attract mode) is very large for one session.\"],\"aiHub\":{\"name\":\"Dragon Quilt Builders\",\"tagline\":\"Stitch a frayed world back together\",\"description\":\"Gather, craft and build block by block to mend a patchwork kingdom unravelled by a dragon. Raise rooms for quirky residents, defend your town and unpick a knotted boss, or raise a barn together in co-op Quilting Bee rounds.\",\"type\":\"Game\",\"genre\":\"RPG\",\"source\":\"Dragon Quest Builders\",\"series\":\"Dragon Quest\",\"players\":\"1–4\",\"controls\":\"Stick/WASD move · ✕/Space jump · □/Click break · △/Right-click place · L1 R1/wheel items · ○/F talk\",\"tags\":[\"building\",\"crafting\",\"co-op\",\"fantasy\",\"comedy\",\"pixel art\"]}};</script>","+<script>globalThis.DQ = globalThis.DQ || {}; DQ.ABOUT = {\"sourceInformation\":{\"date\":\"2026-11-03 21:59:11\",\"source\":\"Dragon Quest Builders\",\"plan\":\"PLAN.md\",\"genre\":\"Sandbox action RPG: block building, crafting and town building, with real-time combat, a siege and bosses\",\"perspective\":\"Third-person isometric 2.5D over a true voxel world, turning in 90-degree steps with zoom steps; three-quarter view as a setting\",\"tech\":\"my-3D2dge v0.85.2 (full engine, lightly modified) with a custom voxel world, renderer, physics and navigation in plain JavaScript (ES2020); Canvas 2D; Web Audio; AI Hub Session Protocol v1 client 1.4.0; Node 18+ vm for headless tests; Playwright 1.63.0 for browser checks\",\"artDirection\":\"The engine's native pixel style (ps1 resolution, shaded HD puppet rigs, canvas lighting) with an original patchwork-quilt look: every block a 16x16 fabric patch with stitched seams, felt UI panels with running-stitch borders, a patchwork logo\",\"animation\":\"The engine's procedural Humanoid and Blob rigs and E.MOVES, plus new moves (place, eat, stir, chop), poses for notions, sleep, KO and cheering, tools drawn on the rig (darning stick, cobble club, Seam Ripper), boss telegraphs, swinging doors, a fluttering banner, portal swirls, an unravel effect\",\"audio\":\"All in code: 14 original songs in the engine's step sequencer built on a leitmotif (a town waltz with layers by town level, boss fury layer, Bee raid layer), 12 jingles, 45 synthesized sound effects, and an Animalese formant voice synth with a profile per character on its own Voices volume bus\",\"online\":\"AI Hub shared-world sessions (1-4 players): the Quilting Bee co-op round with the game's own card, host-run world, client prediction, snapshots and reliable edit events, standings, awards, time-up, leave, end and server mode; solo Bee with bots offline\",\"testing\":\"Headless scripted tests in Node (game.advance and game.debug): 19 suites including a full scripted playthrough, a fake multi-copy AI Hub with latency and loss, attract-mode loops; Playwright screenshots and the AI Hub harness's four scenarios in Chromium\",\"research\":\"No web research on the source game. Read the engine handoff docs (API card, guide sections, renderer, input, dialog and audio source) and the AI Hub protocol README; the plan stage did the same\",\"environment\":\"Claude Code CLI (headless); Linux; browser unknown\",\"model\":\"Anthropic, claude-opus-5-5, reasoning effort medium\",\"usage\":\"Estimated: about 122.7M tokens in total over 208 model calls (121.3M cache reads, 0.86M cache writes, 0.56M output, under 1K uncached input), from the session log; about $80 at Opus-class list prices ($0.50/M cache read, $6.25/M cache write, $25/M output), the exact rate for this model unconfirmed; session time about 2 h 20 min (21:59 to about 00:20)\"},\"testingFeedback\":[\"42 issues, tallied from this session: 32 bugs in the game and its AI, and 10 mistakes in the tests themselves. Game bugs: x-ray silhouettes missing (wall items had no screen box); the deep Lint Hollow hid the player; the Quilters' Hall room failed on uneven ground; the attract mode silenced all audio, collided with a prop, left the finale cutscene running and left its builder seated on a ballista; stair lips blocked walking; the deep-water rule was wrong; Spin Stitch could not charge; room hints picked a wall-top area; Gnarlgrim could walk into the Rift's void; Rift spawns stuck behind the void; saves stored every plant; Bee clients never saw monsters (a duplicate method name); the version label showed '?'; the Knot Wall towered at full height; damaged blocks healed between hits (a seconds-vs-hours mix-up); M12 needed a far turn-in; 'survive 3 waves' only counted after the boss; the ballista aim arc was too narrow, its bolts hit walls and fell short, and any hit (even zero damage) knocked the player off it; skipping the finale never showed the results; and seven Autopilot faults (out-of-reach spots, chasing monsters across the map, a talk loop that never yielded, not equipping crafted weapons, ignoring the Knot Cage, not clearing plants, residents in the way); and menu hover only worked after a mouse click.\",\"8 were game breaking for a player: the Hall room not forming (softlocks quest M10), damaged blocks healing between hits (mining could become impossible), Gnarlgrim falling into the void (the siege ends without its boss), the ballista dismount on any hit (the boss nearly impossible to Tangle), the results never showing after a skipped finale, invisible monsters for co-op clients, the player hidden in the opening area, and silenced audio after the attract mode.\",\"The scripted playthrough with the Autopilot: it plays the real systems from New Game to Chapter Clear and found the block-healing, ballista, siege-flow and finale bugs that no single-system check caught.\",\"The world-generation determinism check: it never failed and only confirmed what the design already guaranteed.\"],\"engineFeedback\":[\"Its views are plain linear projections with exact whole-pixel control, so a voxel renderer could plug straight into its depth-sorted queue, x-ray, lighting and particles; the Humanoid rigs, dialog, menus, saves and settings came for free.\",\"Yes: queued occluders need a screen box for the x-ray pass, which I only found by reading the flush code; and the default iso view's height step is not a whole number of pixels, so I made my own views.\",\"The voxel world: storage, a face-sprite atlas renderer with column runs, cutaway and water, circle-body physics with stairs, and A* navigation, because the engine's TileMap is a heightmap.\",\"Depth sorting real 3D blocks with a 2D painter's queue built for heightmap walls: lifting actors over the blocks they stand on and keeping roofs in front.\",\"Small, marked // DQB: an input wheelSteps() accessor that works while the camera wheel is off and a right-stick flick(), a Dialog onLetter hook for per-letter voices, a Voices audio bus, and tool kinds (stick, club, Seam Ripper) drawn on the Humanoid's sword joints; and moving the mouse now counts as using it, so menus answer to hover and prompts switch to mouse icons without a click.\",\"A first-class block or voxel map type with its own lift hook and occluder boxes, so 3D building games do not have to rebuild the renderer.\"],\"promptFeedback\":[\"A clear definition of done and a detailed plan: every system had a place, and the controller-first, 10-foot rules made the UI decisions easy.\",\"The plan's file names used a different model and timestamp than TASK.md; TASK.md wins, but it took a moment to be sure.\",\"Making a whole chapter completable through real triggers and proving it with an automated playthrough, alongside netcode and an attract mode, in one pass.\",\"Ask for a smaller vertical slice or allow staged delivery; the plan's scope (17 quests, two bosses, a siege, online co-op, an attract mode) is very large for one session.\"],\"aiHub\":{\"name\":\"Dragon Quilt Builders\",\"tagline\":\"Stitch a frayed world back together\",\"description\":\"Gather, craft and build block by block to mend a patchwork kingdom unravelled by a dragon. Raise rooms for quirky residents, defend your town and unpick a knotted boss, or raise a barn together in co-op Quilting Bee rounds.\",\"type\":\"Game\",\"genre\":\"RPG\",\"source\":\"Dragon Quest Builders\",\"series\":\"Dragon Quest\",\"players\":\"1–4\",\"controls\":\"Stick/WASD move · ✕/Space jump · □/Click break · △/Right-click place · L1 R1/wheel items · ○/F talk\",\"tags\":[\"building\",\"crafting\",\"co-op\",\"fantasy\",\"comedy\",\"pixel art\"]}};</script>"," <script src=\"../src/00-core.js\"></script>"," <script src=\"../src/01-data.js\"></script>"," <script src=\"../src/05-data-story.js\"></script>"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-215911__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-medium-20261103-215911/engine/my-3d2dge.js","hunks":[{"oldStart":823,"oldLines":7,"newStart":823,"newLines":7,"lines":["     on(window, 'blur', () => all(q => q.clear()));","     on(document, 'visibilitychange', () => { if (document.hidden) all(q => q.clear()); });","     on(el, 'contextmenu', e => e.preventDefault());","-    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });","+    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { /* DQB: mouseMove */ if (Math.hypot(e.clientX - this.mouse.cx, e.clientY - this.mouse.cy) > 2) this.lastDevice = 'mouse'; this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mo