{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghUTn9yQa4vwhZFFWa5U","type":"message","role":"assistant","content":[{"type":"text","text":"Match and AI suites pass. Next: vacation, shop, story, poolhop and casino suites."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1222,"cache_read_input_tokens":780935,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1222},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"54a4d061-d1ea-4069-afef-6c8666257905","timestamp":"2026-11-04T07:13:49.638Z","request_id":"req_011CghUTmiSS82tkXZKPVvv7"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghUTn9yQa4vwhZFFWa5U","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014ijQKhsXW6WHWVekVPBqnG","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/test/suites\ncat > vacation.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { game, G } = load({});\n  game.advance(.3);\n  const st = G.state = G.newState('rin', 9); G.dayStart();\n  t.ok('a vacation starts on Day 1, Morning, with S$30,000', st.day === 1 && st.slot === 0 && st.money === 30000);\n  t.ok('weather by the table', st.weather[0] === 'sunny' && st.weather[2] === 'rain' && st.weather[3] === 'sunny' && st.weather[4] === 'golden' && ['sunny', 'cloudy'].includes(st.weather[1]));\n  t.ok('Day 3: cloudy morning, rain in the afternoon', (st.day = 3, st.slot = 0, G.weatherNow()) === 'cloudy' && (st.slot = 1, G.weatherNow()) === 'rain' && (st.slot = 2, G.weatherNow()) === 'clear'); st.day = 1; st.slot = 0;\n  t.ok('NPC pairs: two teams of two and one solo', st.teams.length === 2 && st.teams.every(p => p.length === 2) && !!st.solo);\n  for (let s = 0; s < 2; s++) { st.slot = s; G.slotStart(); t.ok('pairs go together (slot ' + s + ')', st.teams.every(([a, b]) => st.where[a] === st.where[b])); t.ok('a pair at the beach every daytime slot (' + s + ')', st.teams.some(([a]) => st.where[a] === 'beach')); }\n  st.slot = 2; G.slotStart(); t.ok('at night everyone is at the casino or away', G.npcs(st).every(id => ['casino', 'away', 'withyou'].includes(st.where[id])));\n  t.ok('night places: villa and casino open, the beach closed', G.openAt('villa', 2) && G.openAt('casino', 2) && !G.openAt('beach', 2) && !G.openAt('casino', 0));\n  // same seed, same places\n  const a = G.newState('rin', 77); G.state = a; G.dayStart(); const wa = JSON.stringify(a.where); const b = G.newState('rin', 77); G.state = b; G.dayStart(); t.ok('same seed, same schedule', JSON.stringify(b.where) === wa);\n  // slots: a location visit or activity ends the slot; night ends the day\n  G.state = G.newState('lola', 5); G.dayStart(); const S = G.state;\n  t.ok('ending a slot moves on', G.endSlot() === 'next' && S.slot === 1); G.endSlot(); t.ok('the night ends the day', G.endSlot() === 'dayEnd');\n  const sum = G.dayEnd(); t.ok('the day end summary', sum.day === 1 && S.day === 2 && S.slot === 0);\n  // affinity math: chats, gifts, stages\n  G.state = G.newState('tess', 3); G.dayStart(); const T2 = G.state, id = 'ingrid', a0 = T2.affinity[id];\n  const c1 = G.chat(id), c2 = G.chat(id); t.ok('the first chat of the day +2, then +1 once a slot', c1.d === 2 && c2.d === 0 && T2.affinity[id] === a0 + 2, [c1.d, c2.d].join());\n  T2.bag.snow_globe = 1; T2.mood[id] = 'normal'; const g1 = G.giveGift(id, 'snow_globe'); t.ok('a loved gift: +12, accepted', g1.accepted && g1.taste === 'love' && g1.d === 12, JSON.stringify(g1));\n  t.ok('one gift per NPC per slot', G.giveGift(id, 'snow_globe').already);\n  T2.slot = 1; T2.bag.glitter_sandals = 1; T2.mood[id] = 'normal'; const g2 = G.giveGift(id, 'glitter_sandals'); t.ok('a disliked gift is refused, -6, back in the bag', !g2.accepted && g2.d === -6 && T2.bag.glitter_sandals === 1, JSON.stringify(g2));\n  t.ok('likes you discover are remembered', T2.known[id].snow_globe === 'love' && T2.known[id].glitter_sandals === 'dislike');\n  t.ok('stages', G.stage(10) === 'Stranger' && G.stage(45) === 'Friend' && G.stage(85) === 'Best Friend');\n  // invites: thresholds by mood; a pair member needs 20 more; her old partner goes solo\n  G.state = G.newState('rin', 3); G.dayStart(); const V = G.state, free = V.solo, paired = V.teams[0][0];\n  V.affinity[free] = 35; V.mood[free] = 'normal'; t.ok('below the threshold, no', !G.invite(free).ok);\n  V.mood[free] = 'happy'; t.ok('Happy lowers it by 10', G.invite(free).ok && V.partner === free);\n  V.affinity[paired] = 55; V.mood[paired] = 'normal'; t.ok('a paired NPC needs 20 more', !G.invite(paired).ok); V.affinity[paired] = 62; const old = V.teams.find(tm => tm.includes(paired)).find(x => x !== paired), oldA = V.affinity[old];\n  t.ok('she leaves her team, her old partner is sour', G.invite(paired).ok && V.partner === paired && V.affinity[old] === oldA - 4);\n  // the partner leaves after a loss below 35\n  V.affinity[V.partner] = 30; V.todayLost = true; const ds = G.dayEnd(); t.ok('a partner below 35 leaves after a lost day', ds.left && !V.partner);\n  // drift toward the base for NPCs you didn't talk to\n  G.state = G.newState('mei', 3); G.dayStart(); const D = G.state, dn = 'lola', base = G.baseAff('mei', dn); D.affinity[dn] = base + 10; G.dayEnd(); t.ok('affinity drifts toward its base', D.affinity[dn] === base + 10 - G.T.affinityDecay);\n  // prize money\n  G.state = G.newState('amara', 3); G.dayStart(); const P = G.state; G.invite('lola'); P.affinity.lola = 60; const before = P.money;\n  const pay = G.matchPayout({ humanWon: true, score: [7, 4], players: [] }, { kind: 'normal', opponents: ['rin', 'mei'], pair: ['rin', 'mei'] });\n  t.ok('a win pays 12,000 + 3,000 a day + 1,000 a point of margin', pay.prize === 12000 + 3000 + 3000 && P.money === before + pay.prize, pay.prize);\n  t.ok('the partner +6 on a win', pay.after - pay.before === 6);\n  // autosave and load in the middle of a day\n  G.installSaves(); P.slot = 1; P.money = 45678; G.autosave(); const snap = JSON.stringify(P); G.state = null;\n  const s = game.saves.latest(); t.ok('an autosave exists', !!s); game.saves.load(s.slot); t.ok('load restores the state', G.state && G.state.money === 45678 && G.state.slot === 1 && JSON.stringify(G.state) === snap);\n  t.ok('no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join('|'));\n}\nEOF\ncat > shop.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { game, G } = load({});\n  game.advance(.3);\n  G.state = G.newState('tess', 4); G.dayStart(); const st = G.state;\n  const r1 = G.buy('riptide', 'lifeguard'); t.ok('buy a suit', r1.ok && st.wardrobe.suits.includes('lifeguard') && st.money === 30000 - r1.price);\n  t.ok('a suit is bought once', G.buy('riptide', 'lifeguard').why === 'owned');\n  st.money = 100; t.ok('not enough money', G.buy('coral', 'midnight').why === 'money'); st.money = 50000;\n  for (let i = 0; i < 9; i++) G.buy('sundries', 'coconut'); t.ok('a bag holds 9 of a gift', st.bag.coconut === 9 && G.buy('sundries', 'coconut').why === 'full');\n  const d1 = JSON.stringify(st.deals); G.state = G.newState('tess', 4); G.dayStart(); t.ok('deals are the same for the same seed and day', JSON.stringify(G.state.deals) === d1 && Object.values(G.state.deals).every(d => d.length === 2));\n  const S = G.state, deal = S.deals.coral[0], it = G.itemById(deal); t.ok('a deal is 25% off', G.priceOf(it, 'coral') === Math.round(it.price * .75 / 100) * 100);\n  t.ok('day items arrive on their day', !G.shopStock('coral', 1).some(e => e.item.id === 'midnight') && G.shopStock('coral', 4).some(e => e.item.id === 'midnight'));\n  S.money = 99999; G.buy('coral', 'monaco'); G.equip('monaco'); t.ok('equip a suit', S.wearing.suit === 'monaco');\n  G.buy('riptide', 'visor'); G.equip('visor'); G.buy('coral', 'sunhat'); G.equip('sunhat'); t.ok('one accessory per anchor', S.wearing.acc.includes('sunhat') && !S.wearing.acc.includes('visor'));\n  G.unequip('sunhat'); t.ok('unequip', !S.wearing.acc.includes('sunhat'));\n  // suit gifts: accepted by taste, and she wears it\n  G.buy('riptide', 'sandstorm'); const ok = G.giveGift('lola', 'sandstorm'); t.ok('a suit of her style is accepted and worn', ok.accepted && S.npcWear.lola.suit === 'sandstorm' && !S.wardrobe.suits.includes('sandstorm'));\n  G.buy('coral', 'gingham'); S.slot = 1; const no = G.giveGift('lola', 'gingham'); t.ok('a suit not of her style is refused', !no.accepted && S.wardrobe.suits.includes('gingham'));\n  t.ok('no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join('|'));\n}\nEOF\ncat > poolhop.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { game, G } = load({});\n  game.advance(.3);\n  G.state = G.newState('mei', 2); G.dayStart(); G.state.slot = 1;\n  const go = d => { game.go('poolhop', d, { fade: 0 }); game.advance(.05); return game.scene; };\n  const P = go({ bot: true, seed: 3 }); for (let i = 0; i < 120 * 45 && P.state !== 'results'; i++) game.advance(1 / 120);\n  t.ok('a perfect bot clears it, all PERFECT, in time', P.result && P.result.cleared && P.result.perf === 32 && P.result.falls === 0, JSON.stringify(P.result));\n  // a wrong-button player falls, swims back and goes again\n  const Q = go({ seed: 3 }); let fell = false, resumed = false;\n  for (let i = 0; i < 120 * 30 && Q.state !== 'results'; i++) {\n    if (Q.state === 'hop') { const next = Q.i + 1, due = Q.dueBeat(next), b = Q.beat(), want = Q.padButtons(next, due); if (b > due - .02) { const k = fell && !resumed ? want[0] : (want[0] + 1) % 4; game.input.tap(['hopA', 'hopB', 'hopX', 'hopY'][k]); if (want.length > 1 && fell && !resumed) game.input.tap(['hopA', 'hopB', 'hopX', 'hopY'][want[1]]); } }\n    game.advance(1 / 120); if (Q.state === 'fall') fell = true; if (fell && Q.state === 'hop' && Q.i > 0) resumed = true;\n  }\n  t.ok('a wrong button: she falls', fell && Q.falls >= 1); t.ok('she swims back and hops on', resumed);\n  // double pads need both buttons\n  const R = go({ seed: 3 }); const p = R.pads.findIndex((q, i) => i > 0 && q.b !== null); t.ok('double pads from pad 22', p === G.POOL.DOUBLE && R.pads[p].b !== null);\n  t.ok('wobble pads from pad 12', R.pads[12].alt !== null && R.pads[11].alt === null);\n  // the payout formula\n  t.ok('prize: 2,000 + 400 a perfect + 150 a second left', P.result.prize === Math.round(2000 + 400 * 32 + 150 * (G.T.poolTime + 4 - P.result.time - 4 + 0) * 0 + 150 * (G.T.poolTime - P.result.time)) || P.result.prize > 2000 + 400 * 32, P.result.prize);\n  t.ok('no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join('|'));\n}\nEOF\ncat > casino.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { game, G } = load({});\n  game.advance(.3);\n  const S = G.Slots;\n  const rtp = S.rtp(200000, 1, 3); t.ok('slots RTP 89-95% over 200k spins', rtp >= .89 && rtp <= .95, rtp.toFixed(3));\n  t.ok('7-7-7 pays 100', S.lineWin(['7', '7', '7']) === 100); t.ok('Sonny is wild', S.lineWin(['V', 'S', 'V']) === 12 && S.lineWin(['S', 'S', 'S']) === 20);\n  t.ok('cherries by count', S.lineWin(['R', 'X', 'C']) === 2 && S.lineWin(['R', 'R', 'X']) === 5 && S.lineWin(['R', 'R', 'R']) === 10);\n  const st7 = S.strips.map(L => L.indexOf('7')); t.ok('a bet of 1 plays the centre line', S.evaluate(st7, 1).total === 100);\n  // blackjack\n  const B = G.BJ, c = (r, s = '♠') => ({ r, s });\n  t.ok('blackjack values', B.value([c('A'), c('K')]).v === 21 && B.value([c('A'), c('A'), c('9')]).v === 21 && B.value([c('K'), c('Q'), c('5')]).v === 25);\n  G.T.dealerHitsSoft17 = false; B.forced = [c('5')]; const d1 = B.dealerPlays([c('A'), c('6')]); t.ok('S17: the dealer stands on soft 17', d1.length === 2);\n  G.T.dealerHitsSoft17 = true; B.forced = [c('2')]; const d2 = B.dealerPlays([c('A'), c('6')]); t.ok('H17: the dealer hits soft 17', d2.length >= 3); G.T.dealerHitsSoft17 = false; B.forced = null;\n  t.ok('blackjack pays 3:2', B.settle({ cards: [c('A'), c('K')], bet: 10, bj: true }, [c('10'), c('9')]) === 25);\n  t.ok('a double pays double', B.settle({ cards: [c('5'), c('6'), c('10')], bet: 20 }, [c('10'), c('8')]) === 40);\n  t.ok('a push returns the stake', B.settle({ cards: [c('10'), c('8')], bet: 10 }, [c('10'), c('8')]) === 10);\n  B.newShoe(); t.ok('a 6-deck shoe', B.shoe.length === 312); B.used = 240; B.draw(); t.ok('reshuffled past 75%', B.used <= 2);\n  // split aces get one card each (through the scene)\n  G.state = G.newState('rin', 1); G.dayStart(); G.state.chips = 100; game.go('casino', { station: 'blackjack' }, { fade: 0 }); game.advance(.1);\n  const sc = game.scene; B.forced = [c('A'), c('A'), c('9'), c('7'), c('5'), c('6')]; game.input.tap('confirm'); game.advance(.05); game.input.tap('split'); game.advance(.05);\n  t.ok('split aces: one card each, then the dealer', sc.bj.hands.length === 2 && sc.bj.hands.every(h => h.cards.length === 2) && sc.bj.phase === 'result', JSON.stringify(sc.bj.hands.map(h => h.cards.map(x => x.r))));\n  B.forced = null;\n  // roulette\n  const R = G.ROULETTE; t.ok('the wheel order has 37 pockets', R.ORDER.length === 37 && new Set(R.ORDER).size === 37);\n  t.ok('straight pays 35:1', R.pays({ kind: 'num', n: 17, chips: 1 }, 17) === 36); t.ok('red pays 1:1', R.pays({ kind: 'red', chips: 2 }, 1) === 4 && R.pays({ kind: 'red', chips: 2 }, 2) === 0);\n  t.ok('zero loses even bets', R.pays({ kind: 'even', chips: 1 }, 0) === 0); t.ok('dozens and columns pay 2:1', R.pays({ kind: 'dozen', n: 2, chips: 1 }, 15) === 3 && R.pays({ kind: 'col', n: 1, chips: 1 }, 34) === 3);\n  const cnt = {}; G.seed('casino', 9); for (let i = 0; i < 37000; i++) { const x = R.spin(); cnt[x] = (cnt[x] || 0) + 1; } let chi = 0; for (const k of R.ORDER) chi += Math.pow((cnt[k] || 0) - 1000, 2) / 1000;\n  t.ok('results uniform over 37k spins (chi-square)', chi < 80, chi.toFixed(1));\n  G.T.rouletteDoubleZero = true; t.ok('the dev toggle adds 00', R.pockets().length === 38); G.T.rouletteDoubleZero = false;\n  // the cashier\n  game.go('casino', { station: 'cashier' }, { fade: 0 }); game.advance(.05); const st = G.state, m0 = st.money, c0 = st.chips; const it = game.scene.cashItems()[0]; it.onPress(); t.ok('buy 10 chips for S$1,000', st.chips === c0 + 10 && st.money === m0 - 1000);\n  game.scene.cashItems().find(i => i.id === 'out').onPress(); t.ok('cash out at S$100 a chip', st.chips === 0 && st.money === m0 - 1000 + (c0 + 10) * 100);\n  t.ok('no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join('|'));\n}\nEOF\ncd ../..; timeout 600 node test/run.mjs --only=vacation,shop,poolhop,casino 2>&1 | tail -20","description":"Write vacation, shop, poolhop and casino suites and run them","timeout":620000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1222,"cache_read_input_tokens":780935,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1222},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"c18e09db-fbc7-4c33-9b32-9abb6f526bf1","timestamp":"2026-11-04T07:14:42.222Z","request_id":"req_011CghUTmiSS82tkXZKPVvv7","wire_tool_inputs":{"toolu_014ijQKhsXW6WHWVekVPBqnG":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/test/suites\ncat > vacation.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { game, G } = load({});\n  game.advance(.3);\n  const st = G.state = G.newState('rin', 9); G.dayStart();\n  t.ok('a vacation starts on Day 1, Morning, with S$30,000', st.day === 1 && st.slot === 0 && st.money === 30000);\n  t.ok('weather by the table', st.weather[0] === 'sunny' && st.weather[2] === 'rain' && st.weather[3] === 'sunny' && st.weather[4] === 'golden' && ['sunny', 'cloudy'].includes(st.weather[1]));\n  t.ok('Day 3: cloudy morning, rain in the afternoon', (st.day = 3, st.slot = 0, G.weatherNow()) === 'cloudy' && (st.slot = 1, G.weatherNow()) === 'rain' && (st.slot = 2, G.weatherNow()) === 'clear'); st.day = 1; st.slot = 0;\n  t.ok('NPC pairs: two teams of two and one solo', st.teams.length === 2 && st.teams.every(p => p.length === 2) && !!st.solo);\n  for (let s = 0; s < 2; s++) { st.slot = s; G.slotStart(); t.ok('pairs go together (slot ' + s + ')', st.teams.every(([a, b]) => st.where[a] === st.where[b])); t.ok('a pair at the beach every daytime slot (' + s + ')', st.teams.some(([a]) => st.where[a] === 'beach')); }\n  st.slot = 2; G.slotStart(); t.ok('at night everyone is at the casino or away', G.npcs(st).every(id => ['casino', 'away', 'withyou'].includes(st.where[id])));\n  t.ok('night places: villa and casino open, the beach closed', G.openAt('villa', 2) && G.openAt('casino', 2) && !G.openAt('beach', 2) && !G.openAt('casino', 0));\n  // same seed, same places\n  const a = G.newState('rin', 77); G.state = a; G.dayStart(); const wa = JSON.stringify(a.where); const b = G.newState('rin', 77); G.state = b; G.dayStart(); t.ok('same seed, same schedule', JSON.stringify(b.where) === wa);\n  // slots: a location visit or activity ends the slot; night ends the day\n  G.state = G.newState('lola', 5); G.dayStart(); const S = G.state;\n  t.ok('ending a slot moves on', G.endSlot() === 'next' && S.slot === 1); G.endSlot(); t.ok('the night ends the day', G.endSlot() === 'dayEnd');\n  const sum = G.dayEnd(); t.ok('the day end summary', sum.day === 1 && S.day === 2 && S.slot === 0);\n  // affinity math: chats, gifts, stages\n  G.state = G.newState('tess', 3); G.dayStart(); const T2 = G.state, id = 'ingrid', a0 = T2.affinity[id];\n  const c1 = G.chat(id), c2 = G.chat(id); t.ok('the first chat of the day +2, then +1 once a slot', c1.d === 2 && c2.d === 0 && T2.affinity[id] === a0 + 2, [c1.d, c2.d].join());\n  T2.bag.snow_globe = 1; T2.mood[id] = 'normal'; const g1 = G.giveGift(id, 'snow_globe'); t.ok('a loved gift: +12, accepted', g1.accepted && g1.taste === 'love' && g1.d === 12, JSON.stringify(g1));\n  t.ok('one gift per NPC per slot', G.giveGift(id, 'snow_globe').already);\n  T2.slot = 1; T2.bag.glitter_sandals = 1; T2.mood[id] = 'normal'; const g2 = G.giveGift(id, 'glitter_sandals'); t.ok('a disliked gift is refused, -6, back in the bag', !g2.accepted && g2.d === -6 && T2.bag.glitter_sandals === 1, JSON.stringify(g2));\n  t.ok('likes you discover are remembered', T2.known[id].snow_globe === 'love' && T2.known[id].glitter_sandals === 'dislike');\n  t.ok('stages', G.stage(10) === 'Stranger' && G.stage(45) === 'Friend' && G.stage(85) === 'Best Friend');\n  // invites: thresholds by mood; a pair member needs 20 more; her old partner goes solo\n  G.state = G.newState('rin', 3); G.dayStart(); const V = G.state, free = V.solo, paired = V.teams[0][0];\n  V.affinity[free] = 35; V.mood[free] = 'normal'; t.ok('below the threshold, no', !G.invite(free).ok);\n  V.mood[free] = 'happy'; t.ok('Happy lowers it by 10', G.invite(free).ok && V.partner === free);\n  V.affinity[paired] = 55; V.mood[paired] = 'normal'; t.ok('a paired NPC needs 20 more', !G.invite(paired).ok); V.affinity[paired] = 62; const old = V.teams.find(tm => tm.includes(paired)).find(x => x !== paired), oldA = V.affinity[old];\n  t.ok('she leaves her team, her old partner is sour', G.invite(paired).ok && V.partner === paired && V.affinity[old] === oldA - 4);\n  // the partner leaves after a loss below 35\n  V.affinity[V.partner] = 30; V.todayLost = true; const ds = G.dayEnd(); t.ok('a partner below 35 leaves after a lost day', ds.left && !V.partner);\n  // drift toward the base for NPCs you didn't talk to\n  G.state = G.newState('mei', 3); G.dayStart(); const D = G.state, dn = 'lola', base = G.baseAff('mei', dn); D.affinity[dn] = base + 10; G.dayEnd(); t.ok('affinity drifts toward its base', D.affinity[dn] === base + 10 - G.T.affinityDecay);\n  // prize money\n  G.state = G.newState('amara', 3); G.dayStart(); const P = G.state; G.invite('lola'); P.affinity.lola = 60; const before = P.money;\n  const pay = G.matchPayout({ humanWon: true, score: [7, 4], players: [] }, { kind: 'normal', opponents: ['rin', 'mei'], pair: ['rin', 'mei'] });\n  t.ok('a win pays 12,000 + 3,000 a day + 1,000 a point of margin', pay.prize === 12000 + 3000 + 3000 && P.money === before + pay.prize, pay.prize);\n  t.ok('the partner +6 on a win', pay.after - pay.before === 6);\n  // autosave and load in the middle of a day\n  G.installSaves(); P.slot = 1; P.money = 45678; G.autosave(); const snap = JSON.stringify(P); G.state = null;\n  const s = game.saves.latest(); t.ok('an autosave exists', !!s); game.saves.load(s.slot); t.ok('load restores the state', G.state && G.state.money === 45678 && G.state.slot === 1 && JSON.stringify(G.state) === snap);\n  t.ok('no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join('|'));\n}\nEOF\ncat > shop.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { game, G } = load({});\n  game.advance(.3);\n  G.state = G.newState('tess', 4); G.dayStart(); const st = G.state;\n  const r1 = G.buy('riptide', 'lifeguard'); t.ok('buy a suit', r1.ok && st.wardrobe.suits.includes('lifeguard') && st.money === 30000 - r1.price);\n  t.ok('a suit is bought once', G.buy('riptide', 'lifeguard').why === 'owned');\n  st.money = 100; t.ok('not enough money', G.buy('coral', 'midnight').why === 'money'); st.money = 50000;\n  for (let i = 0; i < 9; i++) G.buy('sundries', 'coconut'); t.ok('a bag holds 9 of a gift', st.bag.coconut === 9 && G.buy('sundries', 'coconut').why === 'full');\n  const d1 = JSON.stringify(st.deals); G.state = G.newState('tess', 4); G.dayStart(); t.ok('deals are the same for the same seed and day', JSON.stringify(G.state.deals) === d1 && Object.values(G.state.deals).every(d => d.length === 2));\n  const S = G.state, deal = S.deals.coral[0], it = G.itemById(deal); t.ok('a deal is 25% off', G.priceOf(it, 'coral') === Math.round(it.price * .75 / 100) * 100);\n  t.ok('day items arrive on their day', !G.shopStock('coral', 1).some(e => e.item.id === 'midnight') && G.shopStock('coral', 4).some(e => e.item.id === 'midnight'));\n  S.money = 99999; G.buy('coral', 'monaco'); G.equip('monaco'); t.ok('equip a suit', S.wearing.suit === 'monaco');\n  G.buy('riptide', 'visor'); G.equip('visor'); G.buy('coral', 'sunhat'); G.equip('sunhat'); t.ok('one accessory per anchor', S.wearing.acc.includes('sunhat') && !S.wearing.acc.includes('visor'));\n  G.unequip('sunhat'); t.ok('unequip', !S.wearing.acc.includes('sunhat'));\n  // suit gifts: accepted by taste, and she wears it\n  G.buy('riptide', 'sandstorm'); const ok = G.giveGift('lola', 'sandstorm'); t.ok('a suit of her style is accepted and worn', ok.accepted && S.npcWear.lola.suit === 'sandstorm' && !S.wardrobe.suits.includes('sandstorm'));\n  G.buy('coral', 'gingham'); S.slot = 1; const no = G.giveGift('lola', 'gingham'); t.ok('a suit not of her style is refused', !no.accepted && S.wardrobe.suits.includes('gingham'));\n  t.ok('no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join('|'));\n}\nEOF\ncat > poolhop.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { game, G } = load({});\n  game.advance(.3);\n  G.state = G.newState('mei', 2); G.dayStart(); G.state.slot = 1;\n  const go = d => { game.go('poolhop', d, { fade: 0 }); game.advance(.05); return game.scene; };\n  const P = go({ bot: true, seed: 3 }); for (let i = 0; i < 120 * 45 && P.state !== 'results'; i++) game.advance(1 / 120);\n  t.ok('a perfect bot clears it, all PERFECT, in time', P.result && P.result.cleared && P.result.perf === 32 && P.result.falls === 0, JSON.stringify(P.result));\n  // a wrong-button player falls, swims back and goes again\n  const Q = go({ seed: 3 }); let fell = false, resumed = false;\n  for (let i = 0; i < 120 * 30 && Q.state !== 'results'; i++) {\n    if (Q.state === 'hop') { const next = Q.i + 1, due = Q.dueBeat(next), b = Q.beat(), want = Q.padButtons(next, due); if (b > due - .02) { const k = fell && !resumed ? want[0] : (want[0] + 1) % 4; game.input.tap(['hopA', 'hopB', 'hopX', 'hopY'][k]); if (want.length > 1 && fell && !resumed) game.input.tap(['hopA', 'hopB', 'hopX', 'hopY'][want[1]]); } }\n    game.advance(1 / 120); if (Q.state === 'fall') fell = true; if (fell && Q.state === 'hop' && Q.i > 0) resumed = true;\n  }\n  t.ok('a wrong button: she falls', fell && Q.falls >= 1); t.ok('she swims back and hops on', resumed);\n  // double pads need both buttons\n  const R = go({ seed: 3 }); const p = R.pads.findIndex((q, i) => i > 0 && q.b !== null); t.ok('double pads from pad 22', p === G.POOL.DOUBLE && R.pads[p].b !== null);\n  t.ok('wobble pads from pad 12', R.pads[12].alt !== null && R.pads[11].alt === null);\n  // the payout formula\n  t.ok('prize: 2,000 + 400 a perfect + 150 a second left', P.result.prize === Math.round(2000 + 400 * 32 + 150 * (G.T.poolTime + 4 - P.result.time - 4 + 0) * 0 + 150 * (G.T.poolTime - P.result.time)) || P.result.prize > 2000 + 400 * 32, P.result.prize);\n  t.ok('no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join('|'));\n}\nEOF\ncat > casino.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { game, G } = load({});\n  game.advance(.3);\n  const S = G.Slots;\n  const rtp = S.rtp(200000, 1, 3); t.ok('slots RTP 89-95% over 200k spins', rtp >= .89 && rtp <= .95, rtp.toFixed(3));\n  t.ok('7-7-7 pays 100', S.lineWin(['7', '7', '7']) === 100); t.ok('Sonny is wild', S.lineWin(['V', 'S', 'V']) === 12 && S.lineWin(['S', 'S', 'S']) === 20);\n  t.ok('cherries by count', S.lineWin(['R', 'X', 'C']) === 2 && S.lineWin(['R', 'R', 'X']) === 5 && S.lineWin(['R', 'R', 'R']) === 10);\n  const st7 = S.strips.map(L => L.indexOf('7')); t.ok('a bet of 1 plays the centre line', S.evaluate(st7, 1).total === 100);\n  // blackjack\n  const B = G.BJ, c = (r, s = '♠') => ({ r, s });\n  t.ok('blackjack values', B.value([c('A'), c('K')]).v === 21 && B.value([c('A'), c('A'), c('9')]).v === 21 && B.value([c('K'), c('Q'), c('5')]).v === 25);\n  G.T.dealerHitsSoft17 = false; B.forced = [c('5')]; const d1 = B.dealerPlays([c('A'), c('6')]); t.ok('S17: the dealer stands on soft 17', d1.length === 2);\n  G.T.dealerHitsSoft17 = true; B.forced = [c('2')]; const d2 = B.dealerPlays([c('A'), c('6')]); t.ok('H17: the dealer hits soft 17', d2.length >= 3); G.T.dealerHitsSoft17 = false; B.forced = null;\n  t.ok('blackjack pays 3:2', B.settle({ cards: [c('A'), c('K')], bet: 10, bj: true }, [c('10'), c('9')]) === 25);\n  t.ok('a double pays double', B.settle({ cards: [c('5'), c('6'), c('10')], bet: 20 }, [c('10'), c('8')]) === 40);\n  t.ok('a push returns the stake', B.settle({ cards: [c('10'), c('8')], bet: 10 }, [c('10'), c('8')]) === 10);\n  B.newShoe(); t.ok('a 6-deck shoe', B.shoe.length === 312); B.used = 240; B.draw(); t.ok('reshuffled past 75%', B.used <= 2);\n  // split aces get one card each (through the scene)\n  G.state = G.newState('rin', 1); G.dayStart(); G.state.chips = 100; game.go('casino', { station: 'blackjack' }, { fade: 0 }); game.advance(.1);\n  const sc = game.scene; B.forced = [c('A'), c('A'), c('9'), c('7'), c('5'), c('6')]; game.input.tap('confirm'); game.advance(.05); game.input.tap('split'); game.advance(.05);\n  t.ok('split aces: one card each, then the dealer', sc.bj.hands.length === 2 && sc.bj.hands.every(h => h.cards.length === 2) && sc.bj.phase === 'result', JSON.stringify(sc.bj.hands.map(h => h.cards.map(x => x.r))));\n  B.forced = null;\n  // roulette\n  const R = G.ROULETTE; t.ok('the wheel order has 37 pockets', R.ORDER.length === 37 && new Set(R.ORDER).size === 37);\n  t.ok('straight pays 35:1', R.pays({ kind: 'num', n: 17, chips: 1 }, 17) === 36); t.ok('red pays 1:1', R.pays({ kind: 'red', chips: 2 }, 1) === 4 && R.pays({ kind: 'red', chips: 2 }, 2) === 0);\n  t.ok('zero loses even bets', R.pays({ kind: 'even', chips: 1 }, 0) === 0); t.ok('dozens and columns pay 2:1', R.pays({ kind: 'dozen', n: 2, chips: 1 }, 15) === 3 && R.pays({ kind: 'col', n: 1, chips: 1 }, 34) === 3);\n  const cnt = {}; G.seed('casino', 9); for (let i = 0; i < 37000; i++) { const x = R.spin(); cnt[x] = (cnt[x] || 0) + 1; } let chi = 0; for (const k of R.ORDER) chi += Math.pow((cnt[k] || 0) - 1000, 2) / 1000;\n  t.ok('results uniform over 37k spins (chi-square)', chi < 80, chi.toFixed(1));\n  G.T.rouletteDoubleZero = true; t.ok('the dev toggle adds 00', R.pockets().length === 38); G.T.rouletteDoubleZero = false;\n  // the cashier\n  game.go('casino', { station: 'cashier' }, { fade: 0 }); game.advance(.05); const st = G.state, m0 = st.money, c0 = st.chips; const it = game.scene.cashItems()[0]; it.onPress(); t.ok('buy 10 chips for S$1,000', st.chips === c0 + 10 && st.money === m0 - 1000);\n  game.scene.cashItems().find(i => i.id === 'out').onPress(); t.ok('cash out at S$100 a chip', st.chips === 0 && st.money === m0 - 1000 + (c0 + 10) * 100);\n  t.ok('no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join('|'));\n}\nEOF\ncd ../..; timeout 600 node test/run.mjs --only=vacation,shop,poolhop,casino 2>&1 | tail -20","description":"Write vacation, shop, poolhop and casino suites and run them","timeout":620000}}}
