& av < .16 - u * .3) return 1; if (front && wide && av < .07) return 2; return 0;","+  }","+  return 0;","+}","+function aoaFillTorso(g, rig, plate, c0, c1, ra, rb, A0, A1, lat, front, cut, pattern, cols, ox, oy) {","+  let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;","+  for (const q of plate) { x0 = Math.min(x0, q[0]); y0 = Math.min(y0, q[1]); x1 = Math.max(x1, q[0]); y1 = Math.max(y1, q[1]); }","+  const rr = Math.max(ra, rb);","+  x0 = Math.floor(Math.min(x0, c0[0] - rr, c1[0] - rr)); y0 = Math.floor(Math.min(y0, c0[1] - rr, c1[1] - rr)); x1 = Math.ceil(Math.max(x1, c0[0] + rr, c1[0] + rr)); y1 = Math.ceil(Math.max(y1, c0[1] + rr, c1[1] + rr));","+  const W = x1 - x0 + 3, H = y1 - y0 + 3; if (W <= 0 || H <= 0 || W * H > 40000) return;","+  const M = new Uint8Array(W * H), n = plate.length, cx = c1[0] - c0[0], cy = c1[1] - c0[1], cl = cx * cx + cy * cy || 1;","+  for (let j = 0; j < H; j++) for (let i = 0; i < W; i++) {","+    const X = x0 - 1 + i + .5, Y = y0 - 1 + j + .5;","+    let ins = false;","+    for (let a = 0, b = n - 1; a < n; b = a++) { const A = plate[a], B = plate[b]; if ((A[1] > Y) !== (B[1] > Y) && X < (B[0] - A[0]) * (Y - A[1]) / (B[1] - A[1]) + A[0]) ins = !ins; }","+    if (!ins) { const k = clamp(((X - c0[0]) * cx + (Y - c0[1]) * cy) / cl, 0, 1), r = ra + (rb - ra) * k, dx = X - (c0[0] + cx * k), dy = Y - (c0[1] + cy * k); ins = dx * dx + dy * dy <= r * r; }","+    M[j * W + i] = ins ? 1 : 0;","+  }","+  const ax = A1[0] - A0[0], ay = A1[1] - A0[1], al = ax * ax + ay * ay || 1, lw = Math.hypot(lat[0], lat[1]), wide = lw > 2.2, lx = wide ? lat[0] / lw : 0, ly = wide ? lat[1] / lw : 0, half = Math.max(1, lw / 2);","+  const T = cols.T, t = rig.t;","+  for (let j = 1; j < H - 1; j++) {","+    let run = 0, runC = null, runX = 0;","+    const flush = () => { if (runC) { px.col(g, runC); g.fillRect(runX, y0 - 1 + j, run, 1); } run = 0; runC = null; };","+    for (let i = 1; i < W - 1; i++) {","+      const at = j * W + i;","+      if (!M[at]) { flush(