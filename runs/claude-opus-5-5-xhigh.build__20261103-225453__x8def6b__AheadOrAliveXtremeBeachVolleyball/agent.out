Tuning(); t.ok('tuning resets to defaults', G.T.ballGravity === 330);\n  const st = G.newState('rin', 3); delete st.v; t.ok('save migration fills the version', G.migrate(st, 0).v === 1);\n  t.ok('money format', G.fmtMoney(12500) === 'S$12,500');\n  t.ok('no errors', !game.errors.length, game.errors.map(e => e.message).join('|'));\n}\nEOF\ncat > data.test.mjs <<'EOF'\nimport { load, DEV } from '../lib/load.mjs';\nimport { readdirSync, readFileSync } from 'node:fs';\nimport { join } from 'node:path';\nexport default function (t) {\n  const { E, G } = load({});\n  const ids = [...G.SUIT_IDS, ...G.ACC_IDS, ...G.GIFT_IDS];\n  t.ok('unique item ids', new Set(ids).size === ids.length);\n  t.ok('21 swimsuits, 10 accessories, 25 gifts', G.SUIT_IDS.length === 21 && G.ACC_IDS.length === 10 && G.GIFT_IDS.length === 25, [G.SUIT_IDS.length, G.ACC_IDS.length, G.GIFT_IDS.length].join());\n  for (const g of G.GIFT_IDS) t.ok('a taste row for ' + g, (G.GIFT_TASTE_TABLE[g] || '').length === 6);\n  for (const f of G.FIGHTERS) {\n    const L = G.GIFT_IDS.map(g => G.giftTaste(f, g));\n    t.ok(f + ': 2 loves, 3+ likes, 3+ dislikes', L.filter(x => x === 'love').length >= 2 && L.filter(x => x === 'like').length >= 3 && L.filter(x => x === 'dislike').length >= 3, ['love', 'like', 'dislike'].map(k => L.filter(x => x === k).length).join('/'));\n  }\n  for (const sh of Object.keys(G.SHOPS)) for (const e of G.shopStock(sh, 5)) t.ok('priced: ' + e.item.id, e.item.price > 0);\n  const cuts = ['onepiece', 'racer', 'halter', 'sport2', 'tankini', 'rash', 'sarong'];\n  for (const s of G.SUIT_IDS) t.ok('known cut and pattern: ' + s, cuts.includes(G.SUITS[s].cut) && !!E.Humanoid && G.SUITS[s].pattern);\n  for (const loc of Object.keys(G.LOCS)) {\n    const L = G.LOCS[loc]; if (!L.spots) continue; const map = loc === 'beach' ? G.courtMap || (G.courtMap = G.makeCourtMap()) : G.getLocMap(loc);\n    for (const s of L.spots) { const c = map.toCell(s.x, s.y); t.ok(`${loc} spot ${s.kind} at ${s.x},${s.y} on the map`, c && c[0] >= 0 && c[1] >= 0 && (s.kind === 'swim' || map.walkable(c[0], c[1]))); }\n  }\n  for (const id of G.FIGHTERS) { const S = G.CAST[id].sched; t.ok('schedule weights: ' + id, S.length === 3 && S[0].length === 4 && S[2].length === 2 && S.flat().every(v => v >= 0)); }\n  for (const id of Object.keys(G.CAST)) t.ok('voice and portrait: ' + id, !!G.voiceOf(id) && !!G.portraitRig(id));\n  const need = { greet: 3, love: 2, like: 2, neutral: 1, refuse: 2, suitYes: 1, suitNo: 1, inviteYes: 2, inviteNo: 2, leaveTeam: 1, taunt: 2, win: 2, lose: 2, partnerBark: 2, visit: 4, farewellLow: 1, farewellHigh: 1, ending: 1 };\n  for (const f of G.FIGHTERS) { const chats = ['chatLow', 'chatMid', 'chatHigh'].reduce((s, k) => s + G.LINES[f][k].length, 0); t.ok(f + ': 6 chats', chats >= 6); for (const k in need) t.ok(`${f}: ${need[k]} ${k}`, (G.LINES[f][k] || []).length >= need[k]); }\n  const sonny = Object.values(G.LINES.sonny).flat().length, pepper = Object.values(G.LINES.pepper).flat().length;\n  t.ok('Sonny has about 40 lines', sonny >= 40, sonny); t.ok('Pepper has about 25', pepper >= 25, pepper);\n  for (const s of ['kai', 'odette', 'bo']) t.ok(s + ' has 8 shop lines', G.LINES[s].shop.length >= 8);\n  // every line fits two lines of the dialog box (about 265 px of text)\n  const all = []; for (const who in G.LINES) for (const k in G.LINES[who]) for (const l of G.LINES[who][k]) all.push([who + '.' + k, l]);\n  const wide = all.filter(([, l]) => E.font.wrap(l, 262).length > 3);\n  t.ok('lines fit the dialog box', !wide.length, wide.slice(0, 3).map(w => w[0]).join(', '));\n  // sources: no placeholders, no Math.random\n  const src = readdirSync(join(DEV, 'src')).map(f => [f, readFileSync(join(DEV, 'src', f), 'utf8')]);\n  const bad = src.filter(([, s]) => /\\b(TODO|TBD|FIXME|lorem|placeholder)\\b/i.test(s)).map(([f]) => f);\n  t.ok('no TODO, TBD, lorem or placeholder in src', !bad.length, bad.join(', '));\n  const rnd = src.filter(([, s]) => /Math\\.random\\(/.test(s)).map(([f]) => f);\n  t.ok('no Math.random( in src', !rnd.length, rnd.join(', '));\n}\nEOF\ncat > ball.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { G } = load({ noBoot: false });\n  const B = G.Ball, C = G.C;\n  // closed form against a stepped integration\n  const L = B.make(0, [260, 230, 20], [120, 10, 90], { k: .12, g: 330 });\n  let p = [260, 230, 20], v = [120, 10, 90], worst = 0;\n  for (let i = 1; i <= 360; i++) { const dt = 1 / 120; for (let s = 0; s < 10; s++) { const h = dt / 10; v = [v[0] - .12 * v[0] * h, v[1] - .12 * v[1] * h, v[2] - (.12 * v[2] + 330) * h]; p = [p[0] + v[0] * h, p[1] + v[1] * h, p[2] + v[2] * h]; } const q = B.at(L, i * dt); worst = Math.max(worst, Math.hypot(q[0] - p[0], q[1] - p[1], q[2] - p[2])); }\n  t.ok('closed form matches integration within .01 over 3 s', worst < .01, worst.toFixed(4));\n  for (const T of [.6, 1, 1.4]) { const from = [250, 200, 30], to = [420, 270, 0], vv = B.aim(from, to, T), L2 = B.make(0, from, vv), q = B.at(L2, T); t.ok('aim lands within .5 at T=' + T, Math.hypot(q[0] - to[0], q[1] - to[1], q[2] - to[2]) < .5); }\n  const L3 = B.make(0, [300, 240, 18], B.aim([300, 240, 18], [330, 240, 40], 1.05)), th = B.timeAtHeight(L3, 40);\n  t.ok('timeAtHeight finds the descent', Math.abs(th - 1.05) < .01, th);\n  const mk = (z, y = C.CY) => { const from = [300, y, z], to = [400, y, 0]; return B.make(0, from, [200, 0, 0], { k: .0001, g: 0.0001 }); };\n  const at = (z, y) => { const L4 = B.make(0, [300, y === undefined ? C.CY : y, z], [200, 0, 0], { k: .0001, g: .001 }); return B.netClass(L4); };\n  t.ok('clear over the net', at(60) === 'clear'); t.ok('the tape', at(C.NET_H) === 'tape'); t.ok('into the net', at(20) === 'net'); t.ok('outside the antenna', at(60, C.Y0 - 10) === 'antenna');\n  void mk;\n  const landAt = x => { const L5 = B.make(0, [x, C.CY, 40], [0, 0, 0]); return L5.landIn; };\n  t.ok('on the line is in', landAt(C.X1 + C.BALL_R - .01)); t.ok('just past the line is out', !landAt(C.X1 + C.BALL_R + .5));\n}\nEOF\ncat > rules.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { G } = load({});\n  const R = new G.Rules({ pointsToWin: 7 });\n  for (let i = 0; i < 6; i++) R.point(0); for (let i = 0; i < 6; i++) R.point(1);\n  t.ok('no win at 7-6 path start', !R.over); R.point(0); t.ok('7-6 is not over (win by 2)', !R.over); R.point(1); R.point(0); R.point(0); t.ok('9-7 wins', R.over && R.winner === 0, R.score.join('-'));\n  const R2 = new G.Rules({ pointsToWin: 7 }); for (let i = 0; i < 10; i++) { R2.point(0); R2.point(1); } R2.point(0); t.ok('the cap: first to 11 wins at 11-10', R2.over && R2.score[0] === 11, R2.score.join('-'));\n  const R3 = new G.Rules({ pointsToWin: 5, sets: 3 }); for (let i = 0; i < 5; i++) R3.point(1); t.ok('a set, not the match, in best of 3', !R3.over && R3.setsWon[1] === 1); R3.nextSet(); for (let i = 0; i < 5; i++) R3.point(1); t.ok('two sets win best of 3', R3.over && R3.winner === 1);\n  const ps = [{ side: 0, id: 0 }, { side: 0, id: 1 }, { side: 1, id: 2 }, { side: 1, id: 3 }], R4 = new G.Rules({});\n  const s1 = R4.nextServer(0, ps), s2 = R4.nextServer(0, ps); t.ok('serve rotation alternates within a team', s1 !== s2 && s1.side === 0 && s2.side === 0);\n  const R5 = new G.Rules({ pointsToWin: 7 }); for (let i = 0; i < 6; i++) R5.point(1); t.ok('the match point flag', R5.matchPoint() === 1);\n  const r = R5.point(0); t.ok('a side-out', r.sideOut && R5.serveSide === 0);\n}\nEOF\ncat > judge.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default function (t) {\n  const { G } = load({});\n  const J = G.VB.judge, T = G.T;\n  t.ok('PERFECT at the window edge', J(T.perfectWin, 1) === 'PERFECT' && J(-T.perfectWin, 1) === 'PERFECT');\n  t.ok('GREAT just past perfect', J(T.perfectWin + .001, 1) === 'GREAT' && J(T.greatWin, 1) === 'GREAT');\n  t.ok('OK to the ok window', J(T.okWin, 1) === 'OK'); t.ok('MISS past it', J(T.okWin + .001, 1) === 'MISS');\n  t.ok('Generous widens', J(T.okWin * 1.5, 1.6) === 'OK'); t.ok('Tight narrows', J(T.perfectWin * .95, .8) === 'GREAT');\n  t.ok('lowering steps PERFECT>GREAT>OK>STRETCH>MISS', G.VB.lower('PERFECT') === 'GREAT' && G.VB.lower('OK') === 'STRETCH' && G.VB.lower('STRETCH') === 'MISS');\n}\nEOF\ncd ../..; timeout 300 node test/run.mjs --only=core,data,ball,rules,judge 2>&1 | tail -20","description":"Write the unit suites and run them","timeout":320000}}}
