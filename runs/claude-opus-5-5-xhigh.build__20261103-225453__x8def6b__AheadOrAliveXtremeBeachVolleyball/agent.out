":135,"newLines":7,"lines":["       \"view\": \"side\",","       \"scene\": \"invitation\",","       \"fps\": 60,","-      \"updateMs\": 0,","+      \"updateMs\": 0.1,","       \"renderMs\": 3.3,","       \"items\": 0,","       \"actors\": 0,"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-011720__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-sonnet-5-5-medium-20261104-011720/src/00-core.js","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":106,"lines":["+/* AHEAD OR ALIVE: Xtreme Beach Volleyball.","+ * Core loop: pick where to spend each morning, afternoon and night of a five-day island vacation; win 2-on-2 beach","+ * volleyball with a partner you befriend through chats and gifts; spend the prize money on swimsuits, gifts and casino","+ * nights; then beat the island's owner in the Fortuna Cup final.","+ * 00-core: namespace, rng streams, event bus, tuning, overlays, helpers. */","+const { px, clamp, lerp, approach, TAU } = E;","+const HUB = typeof window !== 'undefined' && window.AIHub && window.AIHub.active ? window.AIHub : null;","+G.hub = HUB;","+G.TITLE = 'AHEAD OR ALIVE';","+G.STRAP = 'XTREME BEACH VOLLEYBALL';","+G.TAGLINE = 'Stay ahead. Stay alive. Stay tanned.';","+G.DATE = '2026-11-04 01:17:20';","+","+/* ---- random streams: gameplay never calls Math.random ---- */","+G.seedOf = s => { let h = 2166136261; s = String(s); for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619); return h >>> 0; };","+G._streams = {};","+G.reseed = (name, seed) => { G._streams[name] = E.rng(seed >>> 0); };","+G.rng = name => {","+  if (HUB && HUB.seeded === false && name === 'match' && HUB.rng) { return G._streams[name] || (G._streams[name] = HUB.rng('match')); }","+  return G._streams[name] || (G._streams[name] = E.rng(G.seedOf('aoa:' + name)));","+};","+G.rand = (name = 'cosmetic') => G.rng(name)();","+G.rrange = (a, b, name = 'cosmetic') => a + (b - a) * G.rng(name)();","+G.rpick = (list, name = 'cosmetic') => list[Math.floor(G.rng(name)() * list.length) % list.length];","+G.rchance = (p, name = 'cosmetic') => G.rng(name)() < p;","+","+/* ---- event bus ---- */","+G.bus = (() => {","+  const h = {};","+  return {","+    on(ev, fn) { (h[ev] || (h[ev] = [])).push(fn); return () => this.off(ev, fn); },","+    off(ev, fn) { if (h[ev]) h[ev] = h[ev].filter(f => f !== fn); },","+    emit(ev, a, b) { for (const f of (h[ev] || []).slice()) { try { f(a, b); } catch (e) { if (G.game) G.game.fail('bus:' + ev, e); } } }","+  };","+})();","+","+/* ---- tuning: every slider (live; read every step) ---- */","+G.TUNING = [","+  { key: 'moveSpeed', label: 'Run speed', group: 'Players', def: 92, min: 40, max: 180, step: 2, unit: '' },","+  { key: 'diveSpeed', label: 'Dive speed', group: 'Players', def: 150, min: 60, max: 280, step: 5, unit: '' },","+  { key: 'reach', label: 'Reach radius', group: 'Players', def: 15, min: 8, max: 30, step: .5, unit: '' },","+  { key: 'jumpVel', label: 'Jump power', group: 'Players', def: 150, min: 80, max: 260, step: 5, unit: '' },","+  { key: 'timingWindow', label: 'Timing window (s)', group: 'Timing', def: .16, min: .05, max: .4, step: .01, unit: 's' },","+  { key: 'perfectWindow', label: 'Perfect window (s)', group: 'Timing', def: .045, min: .015, max: .15, step: .005, unit: 's' },","+  { key: 'gravity', label: 'Ball gravity', group: 'Ball', def: 260, min: 120, max: 520, step: 10, unit: '' },","+  { key: 'ballDrag', label: 'Ball air drag', group: 'Ball', def: .05, min: 0, max: .4, step: .01, unit: '' },","+  { key: 'serveSpeed', label: 'Serve power', group: 'Ball', def: 1, min: .6, max: 1.6, step: .05, unit: 'x' },","+  { key: 'spikePower', label: 'Spike power', group: 'Ball', def: 1, min: .6, max: 1.8, step: .05, unit: 'x' },","+  { key: 'netHeight', label: 'Net height', group: 'Court', def: 27, min: 16, max: 44, step: 1, unit: '' },","+  { key: 'pointsToWin', label: 'Points to win', group: 'Rules', def: 7, min: 3, max: 21, step: 1, unit: '' },","+  { key: 'aiSkill', label: 'CPU skill', group: 'AI', def: .55, min: 0, max: 1, step: .05, unit: '' },","+  { key: 'aiSpeed', label: 'CPU run speed', group: 'AI', def: 1, min: .5, max: 1.5, step: .05, unit: 'x' },","+  { key: 'aiReaction', label: 'CPU reaction (s)', group: 'AI', def: .18, min: 0, max: .6, step: .02, unit: 's' },","+  { key: 'chemistry', label: 'Partner chemistry bonus', group: 'AI', def: 1, min: 0, max: 2, step: .1, unit: 'x' },","+  { key: 'timeScale', label: 'Game speed', group: 'World', def: 1, min: .3, max: 2, step: .05, unit: 'x' },","+  { key: 'moneyMul', label: 'Prize money', group: 'World', def: 1, min: .2, max: 5, step: .1, unit: 'x' },","+  { key: 'affinityMul', label: 'Friendship gain', group: 'World', def: 1, min: .2, max: 4, step: .1, unit: 'x' },","+  { key: 'crowd', label: 'Crowd size', group: 'World', def: 1, min: 0, max: 2, step: .1, unit: 'x' }","+];","+G.DEFAULTS = {}; G.TUNING.forEach(t => { G.DEFAULTS[t.key] = t.def; });","+G.T = Object.assign({}, G.DEFAULTS);","+G.resetTuning = () => { Object.assign(G.T, G.DEFAULTS); try { E.store.set('aoa-dev-tuning', {}); } catch (e) { /* storage blocked */ } };","+G.saveTuning = () => { try { E.store.set('aoa-dev-tuning', G.T); } catch (e) { /* storage blocked */ } };","+try { const o = E.store.get('aoa-dev-tuning', {}); for (const k in o) if (k in G.DEFAULTS && typeof o[k] === 'number') G.T[k] = o[k]; } catch (e) { /* storage blocked */ }","+","+/* ---- helpers ---- */","+G.fmtMoney = n => 'S$' + Math.round(n).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');","+G.pad2 = n => (n < 10 ? '0' : '') + n;","+G.fmtTime = s => Math.floor(s / 60) + ':' + G.pad2(Math.floor(s % 60));","+G.dist2 = (ax, ay, bx, by) => Math.hypot(ax - bx, ay - by);","+","+/* ---- overlay stack (dev panel, photo mode, toasts, notices) ---- */","+G.overlays = [];","+G.overlay = {","+  push(o) { G.overlays.push(o); if (o.enter) o.enter(); return o; },","+  pop(o) { const i = G.overlays.indexOf(o); if (i >= 0) { G.overlays.splice(i, 1); if (o.exit) o.exit(); } },","+  update(dt) { let took = false; for (const o of G.overlays.slice()) { if (o.update && o.update(dt)) took = true; } return took; },","+  draw(r) { for (const o of G.overlays) if (o.draw) o.draw(r); },","+  has(name) { return G.overlays.some(o => o.name === name); }","+};","+// toasts","+G.toasts = [];","+G.toast = (text, color = '#ffe08a', time = 2.4) => { G.toasts.push({ text, color, t: time, max: time }); if (G.toasts.length > 4) G.toasts.shift(); };","+G.updateToasts = dt => { for (const t of G.toasts) t.t -= dt; G.toasts = G.toasts.filter(t => t.t > 0); };","+G.drawToasts = r => {","+  let y = 14; if (G.hubCardActive) return;","+  for (const t of G.toasts) {","+    const a = Math.min(1, t.t * 3, (t.max - t.t) * 6);","+    r.overlay(g => {","+      const w = E.font.width(t.text) + 14; const x = Math.round(r.W / 2 - w / 2);","+      E.ui.box(g, x, y, w, 14, { bg: ['#1b4a5a', '#0d2a36'], border: '#ffd36a', alpha: Math.max(.2, a) });","+      E.font.text(g, t.text, Math.round(r.W / 2), y + 4, t.color, { align: 'center', shadow: '#000', outline: false });","+    });","+    y += 16;","+  }","+};","+G.wrapScene = scene => {","+  const u = scene.update, d = scene.draw;","+  scene.update = function (dt) { G.updateToasts(dt); if (G.overlay.update(dt)) return; if (u) u.call(this, dt); };","+  scene.draw = function (r) { if (d) d.call(this, r); G.drawToasts(r); G.overlay.draw(r); };","+  return scene;","+};","+","+G.clone = o => JSON.parse(JSON.stringify(o));","+G.shade = (hex, k) => E.shade ? E.shade(hex, k) : hex;","+G.scenes = {};"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-011720__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-sonnet-5-5-medium-20261104-011720/src/02-data.js","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":151,"lines":["+/* 02-data: cast, items, places, calendar, text. Adding a fighter, a shop or a day is a data edit plus art. */","+","+/* ---- the cast ---- */","+G.CAST = {","+  you: { id: 'you', name: 'JO', full: 'Jo Ryder', style: 'Street brawler', tag: 'You', skin: '#e0a878', hair: '#3a2a1e', hairStyle: 'spiky', cloth: '#ff8a3a', pants: '#2a8fc8',","+    stats: { power: 3, speed: 3, receive: 3, set: 3 }, voice: { base: 190, spread: .3, speed: 1, wave: 'triangle' } },","+  mika: { id: 'mika', name: 'MIKA', full: 'Mika \"Typhoon\" Shiranui', style: 'Karate prodigy', tag: 'Partner', skin: '#f0c49a', hair: '#e8742a', hairStyle: 'ponytail', cloth: '#ff5e7a', pants: '#fff2d6',","+    stats: { power: 4, speed: 4, receive: 3, set: 3 }, voice: { base: 330, spread: .35, speed: 1.1, wave: 'square' },","+    bio: 'Won her first trophy at nine and has been a little bit loud about it ever since. Believes every problem is a kata you have not finished.',","+    loves: ['sweet', 'sport'], likes: ['charm'], dislikes: ['fashion'], start: 25 },","+  hana: { id: 'hana', name: 'HANA', full: 'Hana Fujimori', style: 'Runaway ninja', tag: 'Partner', skin: '#f2d2b0', hair: '#1c1c34', hairStyle: 'long', cloth: '#6a4adb', pants: '#2c2c4a',","+    stats: { power: 2, speed: 5, receive: 4, set: 4 }, voice: { base: 400, spread: .2, speed: .9, wave: 'sine' },","+    bio: 'Left the clan after a disagreement about sunscreen. Appears behind you at no point, which is somehow worse.',","+    loves: ['charm', 'luck'], likes: ['sweet'], dislikes: ['sport'], start: 10 },","+  gwen: { id: 'gwen', name: 'GWEN', full: 'Gwen Ashby', style: 'Southpaw boxer', tag: 'Partner', skin: '#e8b890', hair: '#c2b068', hairStyle: 'short', cloth: '#2fb0a0', pants: '#f4f4ee',","+    stats: { power: 5, speed: 2, receive: 3, set: 2 }, voice: { base: 250, spread: .25, speed: .85, wave: 'triangle' },","+    bio: 'Undefeated, unbothered, and deeply suspicious of anything described as \"fun\". Hides a plush pineapple in her kit bag.',","+    loves: ['fashion', 'luck'], likes: ['sport'], dislikes: ['sweet'], start: 15 },","+  ruby: { id: 'ruby', name: 'RUBY', full: 'Ruby Delacroix', style: 'Pro wrestler', tag: 'Rival', skin: '#b87a52', hair: '#d41e5a', hairStyle: 'spiky', cloth: '#ffcf33', pants: '#d41e5a',","+    stats: { power: 5, speed: 2, receive: 2, set: 2 }, voice: { base: 160, spread: .4, speed: 1.2, wave: 'saw' }, bio: 'Announces her own entrances. Hits the ball like it owes her rent.', start: 0 },","+  tomo: { id: 'tomo', name: 'TOMO', full: 'Tomo \"Tiger\" Okabe', style: 'Muay Thai', tag: 'Rival', skin: '#d8a070', hair: '#101010', hairStyle: 'spiky', cloth: '#30c070', pants: '#f0f0f0',","+    stats: { power: 3, speed: 5, receive: 4, set: 2 }, voice: { base: 210, spread: .45, speed: 1.4, wave: 'square' }, bio: 'Cannot stand still. Has never once finished a sentence that did not end in a stretch.', start: 0 },","+  ines: { id: 'ines', name: 'INES', full: 'Ines Vanterpool', style: 'Capoeira dancer', tag: 'Rival', skin: '#9a6a48', hair: '#2a1a14', hairStyle: 'long', cloth: '#ff9a2a', pants: '#8a2ad0',","+    stats: { power: 3, speed: 4, receive: 4, set: 5 }, voice: { base: 300, spread: .5, speed: 1, wave: 'triangle' }, bio: 'Treats every rally as a duet. Will absolutely tell you your footwork is \"interesting\".', start: 0 },","+  sonny: { id: 'sonny', name: 'SONNY', full: 'Sonny Fortuna, Esq.', style: 'Jackpot billionaire', tag: 'Host', skin: '#e2b088', hair: '#f4f0e8', hairStyle: 'short', cloth: '#18c0b8', pants: '#fff2d6',","+    stats: { power: 3, speed: 2, receive: 3, set: 4 }, voice: { base: 140, spread: .35, speed: 1.15, wave: 'sine' }, bio: 'Owns the island, the casino, and a surprisingly large collection of shirts.', start: 0 },","+  pepper: { id: 'pepper', name: 'PEPPER', full: 'Pepper Quill', style: 'Deadpan concierge', tag: 'Host', skin: '#d6a07c', hair: '#4a2a1a', hairStyle: 'ponytail', cloth: '#f4f4ee', pants: '#1a1a2a',","+    stats: { power: 2, speed: 5, receive: 5, set: 3 }, voice: { base: 280, spread: .1, speed: .8, wave: 'sine' }, bio: 'Hands out villa keys and sunscreen with the same expression she uses for catastrophes.', start: 0 }","+};","+G.PARTNERS = ['mika', 'hana', 'gwen'];","+G.LABELS = { sweet: 'Sweets', sport: 'Sports', charm: 'Charms', fashion: 'Fashion', luck: 'Luck' };","+","+/* ---- items ---- */","+G.SUITS = [","+  { id: 'coral', name: 'Coral Reef', top: '#ff6f61', bottom: '#ffd3b0', price: 0 },","+  { id: 'sunset', name: 'Sunset Stripe', top: '#ff9a3c', bottom: '#d6336c', price: 600 },","+  { id: 'lagoon', name: 'Midnight Lagoon', top: '#1d3b8a', bottom: '#2fb0c8', price: 800 },","+  { id: 'lemon', name: 'Lemon Fizz', top: '#ffe14a', bottom: '#ffffff', price: 700 },","+  { id: 'hibiscus', name: 'Hibiscus Hello', top: '#e8317a', bottom: '#3fbf6a', price: 900 },","+  { id: 'pearl', name: 'Pearl Diver', top: '#f4f1ea', bottom: '#9fd7e8', price: 1100 },","+  { id: 'neon', name: 'Neon Tide', top: '#2aff9a', bottom: '#b22aff', price: 1400 },","+  { id: 'mango', name: 'Mango Madness', top: '#ffa514', bottom: '#4cb050', price: 1200 },","+  { id: 'star', name: 'Starfish', top: '#f2705e', bottom: '#f6d86b', price: 1500 },","+  { id: 'sea', name: 'Sea Glass', top: '#8fe3c8', bottom: '#4a8fd0', price: 1800 },","+  { id: 'black', name: 'Black Sand', top: '#26262e', bottom: '#8a8aa0', price: 2200 },","+  { id: 'jackpot', name: 'Jackpot Gold', top: '#ffd24a', bottom: '#c0392b', price: 4000 }","+];","+G.HATS = [","+  { id: 'none', name: 'No hat', price: 0, style: null },","+  { id: 'band', name: 'Sweat band', price: 150, style: 'band', color: '#ffffff' },","+  { id: 'cap', name: 'Sunny cap', price: 300, style: 'cap', color: '#ffcf33' },","+  { id: 'crown', name: 'Beach crown', price: 1500, style: 'crown', color: '#ffd24a' }","+];","+G.GIFTS = [","+  { id: 'smoothie', name: 'Coconut Smoothie', cat: 'sweet', price: 80, pts: 6 },","+  { id: 'taffy', name: 'Saltwater Taffy', cat: 'sweet', price: 60, pts: 5 },","+  { id: 'foam', name: 'Foam Finger', cat: 'sport', price: 120, pts: 6 },","+  { id: 'gloves', name: 'Mini Boxing Gloves', cat: 'sport', price: 220, pts: 8 },","+  { id: 'shell', name: 'Seashell Charm', cat: 'charm', price: 140, pts: 7 },","+  { id: 'moon', name: 'Moonlight Bracelet', cat: 'charm', price: 300, pts: 9 },","+  { id: 'aloha', name: 'Pocket Aloha Shirt', cat: 'fashion', price: 200, pts: 7 },","+  { id: 'shades', name: 'Gold Sunglasses', cat: 'fashion', price: 420, pts: 10 },","+  { id: 'dice', name: 'Lucky Dice', cat: 'luck', price: 160, pts: 7 },","+  { id: 'chip', name: 'Golden Chip', cat: 'luck', price: 400, pts: 10 }","+];","+","+/* ---- places and calendar ---- */","+G.SLOTS = ['Morning', 'Afternoon', 'Night'];","+G.PLACES = {","+  courts: { id: 'courts', name: 'Sunset Courts', blurb: 'Sand, nets and a lot of confidence.', mx: 0.18, my: 0.32 },","+  pool: { id: 'pool', name: 'Lagoon Pool', blurb: 'Warm water, cold drinks, lily pads.', mx: 0.62, my: 0.18 },","+  promenade: { id: 'promenade', name: 'Fortuna Promenade', blurb: 'Shops, smoothies and a statue of Sonny.', mx: 0.44, my: 0.62 },","+  villa: { id: 'villa', name: 'Your Villa', blurb: 'A bed, a closet and a very honest mirror.', mx: 0.82, my: 0.52 },","+  casino: { id: 'casino', name: 'Casino Fortuna', blurb: 'Open at night. The house loves you.', mx: 0.3, my: 0.86, night: true }","+};","+G.DAYS = [","+  { n: 1, title: 'Arrival', weather: 'sunny' },","+  { n: 2, title: 'Qualifier Day', weather: 'sunny' },","+  { n: 3, title: 'Semifinal Day', weather: 'cloudy' },","+  { n: 4, title: 'The Reveal', weather: 'sunny' },","+  { n: 5, title: 'Fortuna Cup', weather: 'sunny' }","+];","+// the story lock: which slot a match is forced into","+G.STORY_SLOTS = {","+  '1:0': 'arrival', '1:1': 'welcome', '2:1': 'qualifier', '3:1': 'semifinal', '4:2': 'reveal', '5:1': 'final', '5:2': 'party'","+};","+","+/* ---- text: lines are in the source's tone: breezy, overconfident, wink-wink ---- */","+G.TEXT = {","+  invitation: [","+    'You are cordially invited to the AHEAD OR ALIVE Invitational, on the private island of Isla Fortuna.',","+    'Prize: everything. Dress code: toughness. -- S. Fortuna, Esq.'","+  ],","+  arrival: [","+    ['PEPPER', 'Welcome to Isla Fortuna. Your villa key, your sunscreen, and a form waiving your right to be surprised.'],","+    ['SONNY', 'Fighters! Friends! Tanned people! Change of plans: the tournament is a vacation, and the vacation is a volleyball cup!'],","+    ['JO', 'Volleyball. We came here to brawl.'],","+    ['SONNY', 'And you shall! Politely! Over a net! Five days, one Fortuna Cup, and a casino that never closes. After dark. Which is not never. Details.'],","+    ['PEPPER', 'The nets are at Sunset Courts. The sunscreen is at your elbow. Please use both.']","+  ],","+  welcome: [","+    ['SONNY', 'A welcome match! You and Mika, against myself and Pepper. Do not worry, I only cheat in the casino.'],","+    ['MIKA', 'Two against two! One button, good timing, big spikes! You and me, Jo!'],","+    ['PEPPER', 'Mr. Fortuna has never won a point he did not buy.']","+  ],","+  welcomeWin: [['SONNY', 'Magnificent! I demand a rematch, but also I am delighted. Both. At the same time.'], ['MIKA', 'Best partners ever! ...Probably. We should chat more.']],","+  welcomeLose: [['SONNY', 'The score does not matter! The vacation is the real winner! ...The score matters a little.'], ['MIKA', 'We will get them next time.']],","+  pickPartner: [['PEPPER', 'The Cup is two-on-two. Choose a partner. I recommend someone who likes you. Or sunscreen.']],","+  qualifier: [['RUBY', 'RUBY DELACROIX! AND HER LITTLE FRIEND TOMO! WE ARE YOUR QUALIFIER!'], ['TOMO', 'Hi! Sorry! Stretching!']],","+  qualWin: [['RUBY', 'I demand a recount!'], ['PEPPER', 'There is no recount. There is a smoothie.']],","+  qualLose: [['RUBY', 'THAT IS HOW IT IS DONE!'], ['PEPPER', 'The loss is not final. Only the sunburn is.']],","+  semifinal: [['INES', 'Dance with me, then. Try to keep up with the rhythm.'], ['SONNY', 'Semifinal! The crowd is here! Both of them!']],","+  semiWin: [['INES', 'Interesting footwork after all.'], ['SONNY', 'To the final! The Fortuna Cup awaits!']],","+  semiLose: [['INES', 'You were close. In a fun way.'], ['PEPPER', 'The Cup is gone. The buffet is not.']],","+  reveal: [","+    ['PEPPER', 'There is something I should mention. Mr. Fortuna has bet the island itself on the final.'],","+    ['SONNY', 'Pepper! That was a SURPRISE. ...Yes. I did. The House always wins, so I thought: why not be the House.'],","+    ['JO', 'You bet the island on volleyball.'],","+    ['SONNY', 'On you! Probably against you. We shall see.']","+  ],","+  final: [","+    ['SONNY', 'THE FORTUNA CUP! Against THE HOUSE: myself, Pepper, and a ball that does exactly what the casino wants!'],","+    ['PEPPER', 'Special rules: the ball is occasionally lucky. Please do not take it personally.']","+  ],","+  finalWin: [['SONNY', 'You... won. The island is yours. I am, for the first time, free. Is this what sand feels like?'], ['PEPPER', 'It is customary to say thank you.']],","+  finalLose: [['SONNY', 'The House wins! ...and I keep the island! Which, thanks to you, I will now throw a party on.'], ['PEPPER', 'You played well. Please do not tell him I said that.']],","+  party: [","+    ['SONNY', 'Farewell party! Fireworks, tropical punch, and a toast to every one of you!'],","+    ['PEPPER', 'Please remember your sunscreen. And your dignity. In that order.']","+  ],","+  idle: ['Sunshine, sand and a mild threat of volleyball.', 'The sea is blue. The scoreboard is blue. Everything is blue.', 'Remember to reapply sunscreen between spikes.'],","+  commentary: {","+    point: ['What a rally!', 'Pepper, did you see that?', 'The crowd goes mildly wild!', 'Sunshine and spikes!'],","+    ace: ['ACE! Right through the sunscreen!', 'A serve like a tropical storm!'],","+    spike: ['Boom! Right off the sand!', 'That spike has a mortgage on it!'],","+    block: ['BLOCKED! Not today!', 'A wall of tan lines!'],","+    dive: ['Digging deep! Literally!', 'A gorgeous dive!'],","+    fault: ['A fault! The ball was somewhere else!', 'Out! The sea takes it!']","+  },","+  vacationEnd: 'Five days on Isla Fortuna. The tans fade; the story does not.'","+};","+","+/* ---- how to play pages and about texts ---- */","+G.HOWTO = [","+  ['THE GOAL', ['Win 2-on-2 beach volleyball. First side to the points limit (7 by default, win by 2) takes the match.', 'The ball may touch your side up to three times: bump, set, then spike or send it over.']],","+  ['ONE BUTTON', ['PLAY does it all: serve, bump, set, spike. A ring closes on the sand under the ball; press PLAY when it shrinks to the player. PERFECT timing means sharper balls.', 'Hold the stick toward where you want the ball to go. With a mouse, point.']],","+  ['DIVE, CALL, BLOCK', ['DIVE reaches wide balls, but you lie on the sand for a moment.', 'CALL shouts \"Mine!\" so your partner backs off. Near the net, PLAY when the ball is being attacked jumps to block.']],","+  ['THE VACATION', ['Five days. Each has a morning, an afternoon and a night. Visiting a place spends the slot.', 'Friendship with your partner improves their volleyball. Chat, give gifts, and avoid things they dislike.']],","+  ['MONEY AND STYLE', ['Win matches and Pool Hop, or try your luck at Casino Fortuna after dark.', 'Spend S$ on swimsuits, hats and gifts. The wardrobe at your villa dresses you for the court.']],","+  ['EVERYWHERE ELSE', ['Beach Match is quick play for 1 to 4 local players, each on a pad or on the keyboard halves.', 'Dev mode lives in the pause menu: tools and balance sliders. Photo mode takes postcards.']]","+];"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-011720__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-sonnet-5-5-medium-20261104-011720/tools/build.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":36,"lines":["+// node tools/build.mjs : concatenates src/*.js into build/game.js and writes the single-file deliverable one level up.","+import { readFileSync, writeFileSync, readdirSync, mkdirSync } from 'node:fs';","+import { resolve, dirname, basename } from 'node:path';","+import { fileURLToPath } from 'node:url';","+const DEV = resolve(dirname(fileURLToPath(import.meta.url)), '..');","+const name = basename(DEV);                       // AheadOrAlive...-claude-sonnet-5-5-medium-20261104-011720","+const OUT = resolve(DEV, '..', name + '.html');","+const rd = p => readFileSync(resolve(DEV, p), 'utf8');","+const esc = s => s.replace(/<\\/script/gi, '<\\\\/script');","+const files = readdirSync(resolve(DEV, 'src')).filter(f => f.endsWith('.js')).sort();","+const body = files.map(f => `/* ===== ${f} ===== */\\n` + rd('src/' + f)).join('\\n');","+const game = `(() => { 'use strict'; const E = My3D2dge, G = {}; window.AOA = G;\\n${body}\\n})();\\n`;","+mkdirSync(resolve(DEV, 'build'), { recursive: true });","+writeFileSync(resolve(DEV, 'build/game.js'), game);","+const tags = `<meta name=\"hub:session\" content=\"1\">","+<meta name=\"hub:session-players\" content=\"1-4\">","+<meta name=\"hub:session-mode\" content=\"shared-world\">","+<meta name=\"hub:session-goal\" content=\"Win the 2-on-2 beach volleyball match for your team: first to 7 points, win by 2.\">","+<meta name=\"hub:session-howto\" content=\"Move: left stick / WASD. Play (bump, set, spike, serve): Cross / Space. Dive: Circle / K. Call: Square / L. Camera: Triangle / V.\">","+<meta name=\"hub:session-minutes\" content=\"5\">`;","+const boot = `<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#0a2d3d;color:#bfe9ee;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#fff3c4;font-size:16p