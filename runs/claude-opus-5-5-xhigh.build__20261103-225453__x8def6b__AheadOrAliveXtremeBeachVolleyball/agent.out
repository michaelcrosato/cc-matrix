 === 0, game.errors.map(e => e.message).join(';'));\",\"+};\"]}],\"created\":true},{\"filePath\":\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/02-data.test.mjs\",\"hunks\":[{\"oldStart\":0,\"oldLines\":0,\"newStart\":1,\"newLines\":19,\"lines\":[\"+import { load } from '../lib/load.mjs';\",\"+export default async t => {\",\"+  const { G, E } = load();\",\"+  t('21 swimsuits', G.SUITS.length === 21, G.SUITS.length); t('10 accessories', G.ACCS.length === 10); t('25 gifts', G.GIFTS.length === 25);\",\"+  const ids = [...G.SUITS, ...G.ACCS, ...G.GIFTS].map(i => i.id); t('item ids unique', new Set(ids).size === ids.length);\",\"+  for (const id of G.FIGHTERS) {\",\"+    const row = G.GIFTS.map(gf => G.taste(id, gf.id)); const n = k => row.filter(x => x === k).length;\",\"+    t(id + ' tastes: 2 loves, 3+ likes, 3+ dislikes', n('love') >= 2 && n('like') >= 3 && n('dislike') >= 3, JSON.stringify({ love: n('love'), like: n('like'), dislike: n('dislike') }));\",\"+    const L = G.LINES[id]; t(id + ' has every line kind', L.greet.length === 3 && L.chat.length === 6 && L.love.length === 2 && L.like.length === 2 && L.refuse.length === 2 && L.inviteYes.length === 2 && L.inviteNo.length === 2 && L.win.length === 2 && L.loss.length === 2 && L.farewell.length === 2 && !!L.ending && !!L.visit);\",\"+  }\",\"+  for (const id in G.CAST) t(id + ' has a voice', !!G.CAST[id].voice);\",\"+  for (const s of G.SUITS) t('suit ' + s.id + ' cut and pattern known', ['onepiece', 'racer', 'halter', 'sport2', 'tankini', 'rash', 'sarong'].includes(s.cut) && ['solid', 'stripes', 'pin', 'dots', 'waves', 'stars', 'floral', 'palms', 'check', 'gradient', 'geo', 'scales', 'sevens', 'lame'].includes(s.pattern));\",\"+  for (const sh in G.SHOPS) t('shop ' + sh + ' has stock', G.shopStock(sh, 5).length >= 6);\",\"+  // every line fits two lines of the dialog box (about 36 characters a line)\",\"+  const long = []; for (const id of G.FIGHTERS) for (const k in G.LINES[id]) { const v = G.LINES[id][k]; for (const l of [].concat(typeof v === 'object' && !Array.isArray(v) ? v.lines : v)) if (typeof l === 'string' && E.font.width(l) > 2 * 300) long.push(id + '.' + k); }\",\"+  t('lines fit the dialog box', !long.length, long.join(','));\",\"+  t('every rig builds', G.FIGHTERS.concat(['sonny', 'pepper', 'kai', 'odette', 'bo']).every(id => !!G.makeRig(id)));\",\"+  for (const s of G.SUITS) { const r = G.makeRig('rin', { suit: s.id, acc: ['sunhat', 'heartshades', 'shellnecklace'] }); r.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0 }); t('suit ' + s.id + ' dresses a rig', r.C.cloth === s.colors[0]); }\",\"+};\"]}],\"created\":true},{\"filePath\":\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/03-ball.test.mjs\",\"hunks\":[{\"oldStart\":0,\"oldLines\":0,\"newStart\":1,\"newLines\":17,\"lines\":[\"+import { load } from '../lib/load.mjs';\",\"+export default async t => {\",\"+  const { G } = load(); const B = G.Ball;\",\"+  const L = B.make(0, [200, 190, 20], [120, 10, 160]);\",\"+  // closed form against a stepped integration\",\"+  let p = [200, 190, 20], v = [120, 10, 160], worst = 0; const k = L.k, g = L.g, dt = 1 / 2000;\",\"+  for (let i = 1; i <= 3 * 2000; i++) { v = [v[0] - k * v[0] * dt, v[1] - k * v[1] * dt, v[2] - (k * v[2] + g) * dt]; p = [p[0] + v[0] * dt, p[1] + v[1] * dt, p[2] + v[2] * dt]; if (i % 200 === 0) { const q = B.at(L, i * dt); worst = Math.max(worst, Math.hypot(q[0] - p[0], q[1] - p[1], q[2] - p[2])); } }\",\"+  t('closed form matches integration', worst < .2, worst);\",\"+  const from = [250, 180, 18], to = [330, 210, 40], vv = B.aim(from, to, 1.05), L2 = B.make(0, from, vv), q = B.at(L2, 1.05);\",\"+  t('aim reaches its target', Math