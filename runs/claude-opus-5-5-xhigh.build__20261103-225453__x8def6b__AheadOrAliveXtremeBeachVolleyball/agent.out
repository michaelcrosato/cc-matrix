#fff8e8', { shadow: '#000', outline: false });\\n      }\\n      if (this.d.prize !== undefined) { const y = Math.round(H * .3) + 108; G.UI.money(g, Math.round(W / 2) - 60, y, this.count); }\\n      if (this.d.aff) { const a = this.d.aff, y = Math.round(H * .3) + 108; G.portrait(g, a.id, Math.round(W / 2) + 30, y - 2, 18, { frame: false }); G.UI.hearts(g, Math.round(W / 2) + 52, y + 4, a.to); E.font.text(g, (a.d >= 0 ? '+' : '') + a.d, Math.round(W / 2) + 112, y + 4, a.d >= 0 ? '#7cff5a' : '#ff7a7a', { shadow: '#000', outline: false }); }\\n      const L = this.layout(); L.forEach((it, k) => G.UI.button(g, it, k === this.focus.i));\\n    });\\n    const bar = [['confirm', 'Select']]; if (G.canPhoto()) bar.push(['snap', 'Postcard']);\\n    G.promptBar(r, bar, G.game.input, Math.round(r.H * .86) + 24);\\n  }\\n};\\n\",\"structuredPatch\":[],\"originalFile\":null,\"userModified\":false},\"tool_result_meta\":[{\"id\":\"toolu_01Wr2eZDHDaecqmurfSqEx5n\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}]}","+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\":\"7b48fecc-086c-4274-afae-e17752649adf\",\"uuid\":\"40c6fec5-ec51-40bd-a594-60afb74997ff\"}","+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":150,\"estimated_tokens_delta\":100,\"session_id\":\"7b48fecc-086c-4274-afae-e17752649adf\",\"uuid\":\"48a267b8-371a-41ad-98bd-83cf7e7ba0c2\"}"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/src/54-results.js","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":67,"lines":["+/* 54-results: the match scene, match results, the day-end card, the vacation results and the credits roll. */","+G.SCENES = G.SCENES || {};","+/** start a match: cfg as G.Match takes it, plus a