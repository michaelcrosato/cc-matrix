{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BgzwzUTkSCQQZsCg1Wu1DY","type":"tool_result","content":"3925\t * ============================================================================= */\n3926\tconst HUMAN_COLORS = {\n3927\t  skin: '#f1c7a0', hair: '#3b2a2f', cloth: '#2f8f86', pants: '#3b3552', boot: '#6a4128', belt: '#e0a84a',\n3928\t  cape: '#c8452f', capeIn: '#7a2622', metal: '#dce8f1', metalDk: '#7f93ab', hilt: '#e8b04e', eye: '#1a1320'\n3929\t};\n3930\tconst JOINT_KEYS = ['hipL', 'hipR', 'kneeL', 'kneeR', 'footL', 'footR', 'hipC', 'shC', 'shL', 'shR', 'head', 'elbowL', 'elbowR', 'handL', 'handR'];\n3931\t/** body proportions: 'chibi' (default, big head, Secret of Mana), 'heroic' (tall, Symphony of the Night), 'bulky' (brawlers, bosses) */\n3932\tconst BUILDS = {\n3933\t  chibi: {},\n3934\t  heroic: { legUpper: 7.4, legLower: 7.4, hipZ: 14.3, torso: 9.6, shoulderHalf: 3.5, headR: 3.05, neck: 1.5, armUpper: 5.5, armLower: 5.4, hipHalf: 1.8, stride: 7.8, speedRef: 80 },\n3935\t  bulky: { legUpper: 6.4, legLower: 6.2, hipZ: 12.2, torso: 9.4, shoulderHalf: 4.6, headR: 3.2, neck: .9, armUpper: 5.2, armLower: 5.2, hipHalf: 2.4, limbW: 2.6, torsoW: 4.2, footSpread: 2.4, stride: 6.6, speedRef: 60 },\n3936\t  // bones: rib cage, skull with glowing sockets and a jaw (colors.bone to tint; outfit, cape, hat and weapons still work)\n3937\t  skeleton: { legUpper: 7, legLower: 7, hipZ: 13.4, torso: 9, shoulderHalf: 3.2, headR: 3.1, neck: 1.6, armUpper: 5.3, armLower: 5.2, hipHalf: 1.5, limbW: .6, torsoW: 2.6, stride: 7, hunch: .2, skeleton: true, hair: 'bald', sleeves: 'none', eyeGlow: '#ff5a40' }\n3938\t};\n3939\tclass Humanoid {\n3940\t  /** new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a\n3941\t   *  character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each\n3942\t   *  step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style,\n3943\t   *  color }); hood: true (drawn in colors.hair) */\n3944\t  constructor(o = {}) {\n3945\t    if (o.build && !BUILDS[o.build]) warn('build:' + o.build, 'Humanoid build \"' + o.build + '\" is unknown (chibi, heroic, bulky, skeleton)');\n3946\t    o = Object.assign({}, BUILDS[o.build] || {}, o);\n3947\t    /** o: its options, with the build's proportions and the defaults filled in (size, build, weapon, outfit, ...;\n3948\t     *  legUpper, torso, headR and the other lengths are at size 1) */\n3949\t    this.o = Object.assign({\n3950\t      legUpper: 6, legLower: 6, hipZ: 11.6, hipHalf: 1.9, footSpread: 1.9, torso: 8, shoulderHalf: 3.3, neck: 1.2, headR: 3.4,\n3951\t      armUpper: 4.6, armLower: 4.6, limbW: 2, torsoW: 3, lean: 0, hunch: 0, stride: 6.5, lift: 3.4, swing: 4, speedRef: 70,\n3952\t      weapon: 'sword', bladeLen: 11, cape: null, hood: false, eyeGlow: null, hat: null,\n3953\t      style: 'hd', size: 1, hair: 'short', outfit: 'shirt', sleeves: 'short', armor: false, cheat: .5\n3954\t    }, o);\n3955\t    /** trail: recent points of the blade (or fist) tip, for the swing's smear */\n3956\t    this._cheat = 0; this.trail = [];\n3957\t    if (typeof this.o.hair === 'string' || !this.o.hair) this.o.hair = { style: this.o.hair || 'short' };\n3958\t    /** hairPts: the long hair's simulated points (null until it has some) */\n3959\t    this._hairPts = null;\n3960\t    if (this.o.weapon && !['sword', 'gun', 'staff'].includes(this.o.weapon)) { warn('weapon:' + this.o.weapon, 'Humanoid weapon \"' + this.o.weapon + '\" is not built in (sword, gun, staff or null); drawing a sword'); this.o.weapon = 'sword'; }\n3961\t    if (typeof this.o.hat === 'string') this.o.hat = { style: this.o.hat };\n3962\t    /** C: its colors (skin, hair, cloth, pants, boot, belt, cape, capeIn, metal, hilt, eye, ...), the defaults with\n3963\t     *  o.colors over them; change one and it shows at the next draw */\n3964\t    this.C = Object.assign({}, HUMAN_COLORS, o.colors || {});\n3965\t    const C = this.C;\n3966\t    if (this.o.skeleton) C.skin = C.pants = C.boot = C.glove = C.bone || '#e6dfc8';\n3967\t    C.clothDk = C.clothDk || shade(C.cloth, -.3); C.clothLt = C.clothLt || shade(C.cloth, .25);\n3968\t    C.pantsDk = C.pantsDk || shade(C.pants, -.3); C.bootDk = C.bootDk || shade(C.boot, -.3); C.skinDk = C.skinDk || shade(C.skin, -.2);\n3969\t    /** t: seconds of its own clock (idle breathing, blinks); phase: the walk cycle's phase, radians; mv: the last\n3970\t     *  ground direction it moved, a unit vector; hurtW: 0..1, how far into the hurt flinch */\n3971\t    this.t = Math.random() * 10; this.phase = 0; this._spW = 0; this._mv = [1, 0]; this._dashW = 0; this.hurtW = 0; this._atkW = 0;\n3972\t    /** atkZ: the height of the weapon hand during an attack; reach: how far it reaches forward; spin: the body's\n3973\t     *  extra turn during a spinning move, radians */\n3974\t    this._theta = 1.2; this.atkZ = 10; this.reach = 7; this._twist = 0; this.spin = 0; this._atkLean = 0;\n3975\t    /** sq: squash and stretch, -0.45..0.45 (kick adds to it); sqV: its speed; blink: seconds to the next blink;\n3976\t     *  facing: the angle it faces, radians; x, y, z: where its feet are (from the last update); J: its joints this\n3977\t     *  step in its own frame ({ hipL, kneeL, footL, shC, head, handR, ... }; rig.worldOffset(J.handR) gives one in\n3978\t     *  the world); smear: the swing's smear arc, or null */\n3979\t    this.sq = 0; this.sqV = 0; this.blink = 2; this.facing = 0; this.x = 0; this.y = 0; this.z = 0; this.J = {}; this._smear = null;\n3980\t    /** capeL: the cape's left edge points (null until it has a cape and has moved) */\n3981\t    this.capeL = null; this._airW = 0; this._pointW = 0; this._kicking = false;\n3982\t    this.solvePose();\n3983\t  }\n3984\t  /** a squash-and-stretch kick: + stretches (a jump), - squashes (a landing, a hit) */\n3985\t  kick(v) { this.sqV += v; }\n3986\t  /** a heavy landing: knees bend deep and spring back over a moment; strength 1 or more drops a hand to the ground\n3987\t   *  (a three-point landing), .3-.6 is a soft one. Call it on the step the body lands */\n3988\t  land(strength = 1) { this._landT = 0; this._landK = clamp(strength, 0, 1.5); this.kick(-1.5 * Math.min(1, strength)); }\n3989\t  /** how much a stride stretches: shorter while sneaking, longer while sprinting */\n3990\t  _strideK() { return 1 - .35 * (this._sneakW || 0) + .25 * (this._sprintW || 0); }\n3991\t  /** the roll (state flip: u 0..1, a forward somersault about the hips, tucked in the middle): turns every joint, and the\n3992\t   *  cape and hair for this step's drawing only (the next update puts them back before they simulate, so they never\n3993\t   *  jump or gain speed). Emberdeep's dodge roll, moved into the rig */\n3994\t  _roll(u) {\n3995\t    const J = this.J, o = this.o, a = -ease.inOut(clamp(u, 0, 1)) * TAU, c = Math.cos(a), s = Math.sin(a), cz = o.hipZ * .55, tuck = Math.sin(clamp(u, 0, 1) * Math.PI);\n3996\t    const T0 = p => { const f = p[0] * (1 - .35 * tuck), z = (p[2] - cz) * (1 - .45 * tuck); return [f * c - z * s, p[1] * (1 - .25 * tuck), f * s + z * c + cz * (1 - .55 * tuck)]; };\n3997\t    let lift = 0; for (const k in J) { const p = J[k]; if (p && k !== 'bladeDir') lift = Math.max(lift, -T0(p)[2] + (k === 'head' ? o.headR : .5)); }   // rolls over on the shoulders: nothing goes through the floor\n3998\t    const T = p => { const q = T0(p); q[2] += lift; return q; };\n3999\t    for (const k in J) { const p = J[k]; if (p && k !== 'bladeDir') J[k] = T(p); }\n4000\t    const b = J.bladeDir; if (b) J.bladeDir = [b[0] * c - b[2] * s, b[1], b[0] * s + b[2] * c];\n4001\t    const an = this.facing + this.spin + this._cheat, ca = Math.cos(an), sa = Math.sin(an), k = (1 - this.sq * .4) * o.size, kz = (1 + this.sq) * o.size, keep = this._unroll = [];\n4002\t    for (const ch of [this.capeL, this.capeR, this._hairPts]) if (ch) for (const n of ch) {\n4003\t      keep.push(n, n.x, n.y, n.z);\n4004\t      const dx = n.x - this.x, dy = n.y - this.y, q = T([(dx * ca + dy * sa) / k, (-dx * sa + dy * ca) / k, (n.z - this.z) / kz]);\n4005\t      n.x = this.x + (q[0] * ca - q[1] * sa) * k; n.y = this.y + (q[0] * sa + q[1] * ca) * k; n.z = this.z + q[2] * kz;\n4006\t    }\n4007\t  }\n4008\t  /** world position of a hand ('R' holds the weapon): spawn bullets, sparks or thrown things here */\n4009\t  hand(which = 'R') { const w = this._w(this.J['hand' + which] || this.J.handR); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\n4010\t  /** world position of the weapon tip (sword tip, gun muzzle, staff orb) */\n4011\t  tip() { const J = this.J, L = this.o.weapon === 'gun' ? 5 : this.o.weapon === 'staff' ? 10 : this.o.bladeLen, w = this._w(V3.add(J.handR, V3.mul(J.bladeDir, L))); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\n4012\t  /** where a point in the rig's own frame ([forward, right, up]; a joint such as rig.J.head, or one offset from it)\n4013\t   *  sits, in world units from the rig's feet: add rig.x, y, z for the world point, or project it to draw at a joint */\n4014\t  worldOffset(p) { return this._w(p); }\n4015\t  /** local (f, r, z) -> world offset */\n4016\t  _w(p) {\n4017\t    const a = this.facing + this.spin + this._cheat, c = Math.cos(a), s = Math.sin(a), sz = this.o.size, k = (1 - this.sq * .4) * sz;\n4018\t    return [(p[0] * c - p[1] * s) * k, (p[0] * s + p[1] * c) * k, p[2] * (1 + this.sq) * sz];\n4019\t  }\n4020\t  /**\n4021\t   * s: { x, y, z, vx, vy, facing, dash, hurt, attack, air, point }\n4022\t   *   air: true while jumping or falling (legs tuck), point: true to hold the weapon hand forward (aiming a gun)\n4023\t   *   attack: { spec, phase: 'wind' | 'active' | 'recover', u: 0..1 }. spec.kick = true swings the right foot instead of the hand\n4024\t   *   also aim (radians up), crouch, sprint, climb, hang (hangZ: the top it hangs from, above the feet), flip: 0..1 (a roll),\n4025\t   *   pose: 'cheer' | 'cast' | 'guard' | 'kneel' | 'crouch' | 'wave' | 'hips' | 'down' | 'die' | 'block',\n4026\t   *   stance: 'guard' | 'ready', down: 0..1, vz (with climb: the climbing speed), land: k (a heavy landing),\n4027\t   *   expr: 'smile' | 'shout' | 'angry' | 'wince', run: 0..1 (run in place)\n4028\t   */\n4029\t  update(dt, s = {}) {\n4030\t    const o = this.o;\n4031\t    const un = this._unroll; if (un) { this._unroll = null; for (let i = 0; i < un.length; i += 4) { un[i].x = un[i + 1]; un[i].y = un[i + 2]; un[i].z = un[i + 3]; } }   // last step's roll turned the cloth for drawing only\n4032\t    if (this.t > 0 && Math.hypot((s.x || 0) - this.x, (s.y || 0) - this.y, (s.z || 0) - this.z) > 24 * o.size) { this.capeL = null; this._hairPts = null; this.trail.length = 0; }   // teleported: cloth and hair start fresh\n4033\t    /** expr: the face shown ('smile', 'shout', 'angry', 'wince'), or null */\n4034\t    this.t += dt; this.x = s.x; this.y = s.y; this.z = s.z || 0; this.facing = s.facing || 0; this.expr = s.expr || null;\n4035\t    const speed = s.run ? s.run * o.speedRef : Math.hypot(s.vx || 0, s.vy || 0);   // run: 0..1 runs in place (an RPG 'run away', a treadmill)\n4036\t    // traversal: hang from a ledge (hangZ: its top above the feet), a sneaking crouch while moving, a sprint's lean, and a\n4037\t    // heavy landing from land(); a roll (flip) turns the whole body after posing\n4038\t    this._hangW = approach(this._hangW || 0, s.hang ? 1 : 0, dt * 14); if (s.hang) this._hangZ = s.hangZ;\n4039\t    this._sneakW = approach(this._sneakW || 0, s.crouch ? 1 : 0, dt * 8); this._sprintW = approach(this._sprintW || 0, s.sprint ? 1 : 0, dt * 6);\n4040\t    if (s.land > 0 && this._landT === undefined) this.land(s.land);   // (an action's landing step)\n4041\t    if (this._landT !== undefined) {\n4042\t      const k = this._landK, lt = this._landT += dt, dur = .22 + .3 * Math.min(1, k);\n4043\t      this._landW = lt < .05 ? lt / .05 * k : lt < dur ? k * (1 - ease.inOut((lt - .05) / (dur - .05))) : 0;\n4044\t      if (lt >= dur) this._landT = undefined;\n4045\t    }\n4046\t    this._spW = approach(this._spW, clamp(speed / o.speedRef, 0, 1.25), dt * 7);\n4047\t    if (speed > 3 && !s.run) {\n4048\t      const c = Math.cos(this.facing), sn = Math.sin(this.facing), k = Math.min(1, dt * 10);\n4049\t      this._mv[0] = lerp(this._mv[0], (s.vx * c + s.vy * sn) / speed, k); this._mv[1] = lerp(this._mv[1], (-s.vx * sn + s.vy * c) / speed, k);\n4050\t    }\n4051\t    this.phase += dt * speed / (o.stride * o.size * this._strideK() * Math.max(.4, Math.min(1, this._spW)));\n4052\t    this._dashW = approach(this._dashW, s.dash ? 1 : 0, dt * (s.dash ? 24 : 8));\n4053\t    this.hurtW = approach(this.hurtW, s.hurt ? 1 : 0, dt * 14);\n4054\t    this._atkW = approach(this._atkW, s.attack ? 1 : 0, dt * (s.attack ? 30 : 7));\n4055\t    this._airW = approach(this._airW, s.air ? 1 : 0, dt * (s.air ? 10 : 18));\n4056\t    // held poses: 'cheer' (item get, victory), 'cast' (both hands forward), 'guard' (fists up), 'kneel', 'crouch', 'wave', 'hips'\n4057\t    // (hands on hips), and down: 0..1 (knocked flat). stance: 'guard' (fists up while moving) | 'ready' (weapon held forward)\n4058\t    const pk = this.poseW || (this.poseW = { cheer: 0, cast: 0, guard: 0, kneel: 0, crouch: 0, wave: 0, hips: 0, block: 0 });\n4059\t    for (const k in pk) pk[k] = approach(pk[k], s.pose === k ? 1 : 0, dt * 9);\n4060\t    this._stW = approach(this._stW || 0, s.stance === 'guard' ? 1 : 0, dt * 10); this._rdW = approach(this._rdW || 0, s.stance === 'ready' ? 1 : 0, dt * 10);\n4061\t    this._climbW = approach(this._climbW || 0, s.climb ? 1 : 0, dt * 12); if (s.climb) this._climbP = (this._climbP || 0) + dt * Math.hypot(s.vz || 0, s.vx || 0, s.vy || 0) / (.4 * (o.armUpper + o.armLower) * o.size) * Math.PI;   // hands keep pace with the climb   // climb: hand over hand on a ladder\n4062\t    this.dieT = s.pose === 'die' ? (this.dieT || 0) + dt : 0;   // pose 'die': a stagger, the knees give, then the body topples\n4063\t    const dT = s.down !== undefined ? clamp(+s.down, 0, 1) : s.pose === 'down' || this.dieT > .45 ? 1 : 0;\n4064\t    /** downW: how far down it is, 0..1 (state down, pose 'down' or 'die'): it falls faster and faster and gets up steadily */\n4065\t    this.downW = approach(this.downW || 0, dT, dt * (dT > (this.downW || 0) ? 2.5 + 10 * (this.downW || 0) : 3.2));\n4066\t    if (this.dieT > 0) { this.hurtW = approach(this.hurtW, this.dieT < .25 ? 1 : 0, dt * 14); pk.kneel = approach(pk.kneel, this.dieT > .2 && this.dieT < .6 ? 1 : 0, dt * 10); }\n4067\t    this._pointW = approach(this._pointW, s.point ? 1 : 0, dt * (s.point ? 30 : 8));\n4068\t    this._aimA = approach(this._aimA || 0, s.aim || 0, dt * 14);   // aim: radians above (+) or below (-) level while pointing\n4069\t    if (s.attack) this._kicking = !!s.attack.spec.kick;\n4070\t    this.blink -= dt; if (this.blink < -.12) this.blink = 2 + Math.random() * 3;\n4071\t    this.sqV += (-260 * this.sq - 15 * this.sqV) * dt; this.sq = clamp(this.sq + this.sqV * dt, -.3, .3);\n4072\t\n4073\t    const A = s.attack; let tLean = 0, tTwist = 0, tLunge = 0, tHop = 0, tCrouch = 0, armT = A ? 1 : 0;\n4074\t    this.spin = 0;\n4075\t    // side views swing weapons in the screen plane (an overhead chop), ground views in the ground plane.\n4076\t    // spec.plane or the rig option swingPlane ('side' | 'ground') choose it yourself.\n4077\t    this._sidePlane = !!A && !A.spec.kick && (A.spec.plane ? A.spec.plane === 'side' : o.swingPlane ? o.swingPlane === 'side' : this._pitch !== undefined && this._pitch < 15 && !!o.weapon && A.spec.blade !== 0 && A.spec.hand !== 'L');\n4078\t    if (A) {\n4079\t      // wind: anticipation (pull back, crouch). active: the strike, with a lunge, lead-foot step, lean, twist and hop.\n4080\t      // recover: follow through, hold the end pose, then blend back to the stance by position (never swing backwards)\n4081\t      const sp = A.spec, side = this._sidePlane, rest = side ? -.9 : 1.1, RS = sp.rel ? (o.armUpper + o.armLower) / 9.2 : 1, R = (sp.reach || 7.5) * RS, r0 = sp.r0 === undefined ? R : sp.r0 * RS, r1 = sp.r1 === undefined ? R : sp.r1 * RS;\n4082\t      /** atkRel: the attack's heights are relative to the shoulders (its spec's rel) */\n4083\t      this._atkRel = !!sp.rel; const zRest = sp.rel ? (sp.kick ? .1 : -7) : 9, z0 = sp.z0 === undefined ? zRest : sp.z0, z1 = sp.z1 === undefined ? z0 : sp.z1;   // side-plane moves have no heights\n4084\t      // lunge / hop / crouch are body motion in local units, clamped so a game's own 'lunge' speed field can't stretch the rig\n4085\t      const hold = sp.hold === undefined ? .3 : sp.hold, lean = sp.lean === undefined ? (sp.kick ? -.22 : .3) : clamp(sp.lean, -.8, .8), lunge = sp.lunge === undefined ? (sp.kick ? .4 : 1.2) : clamp(sp.lunge, -4, 5);\n4086\t      if (A.phase === 'wind' && (this._aPh !== 'wind' || this._aSp !== sp)) {   // a chained hit starts where the arm is\n4087\t        const chain = (this._armW || 0) > .3 && this._theta !== undefined, fists = !o.weapon || sp.hand === 'L' || sp.blade === 0;\n4088\t        this._th0 = chain ? this._theta : rest; this._z0 = chain && this._atkRel === !!sp.rel && isFinite(this.atkZ) ? this.atkZ : fists ? z0 : zRest; this._r0 = chain ? this.reach : R * .75;\n4089\t        const J = this.J; if (J.handR) this._from = { R: J.handR.slice(), L: J.handL.slice(), bd: J.bladeDir.slice() };   // the wind blends from the real pose: no snaps\n4090\t      }\n4091\t      this._aPh = A.phase; this._aSp = sp; this._atkHand = sp.hand || 'R'; if (A.phase !== 'wind') this._windK = 1;\n4092\t      if (A.phase === 'wind') {\n4093\t        const k = ease.outQuad(A.u);\n4094\t        this._theta = lerp(this._th0, sp.a0, k); this.atkZ = lerp(this._z0, z0, A.u); this.reach = lerp(this._r0, r0, k); this._windK = k;\n4095\t        tLean = -Math.abs(lean) * .45; tLunge = -lunge * .3 * k; tCrouch = clamp(sp.crouch === undefined ? (sp.kick ? 0 : .15) : sp.crouch, 0, 1) * k;   // coil: lean back, draw back, dip\n4096\t      } else if (A.phase === 'active') {\n4097\t        const k = ease.outCubic(A.u);\n4098\t        this._theta = sp.spin ? sp.a0 : lerp(sp.a0, sp.a1, k); this.atkZ = lerp(z0, z1, k); this.reach = lerp(r0, r1, k);\n4099\t        tLean = lean; tLunge = lunge * k; tHop = clamp(sp.hop || 0, 0, 12) * Math.sin(k * Math.PI); tCrouch = clamp(sp.crouch === undefined ? (sp.kick ? 0 : .15) : sp.crouch, 0, 1) * (1 - k);\n4100\t        if (sp.spin) { if (side) this._theta = sp.a0 - TAU * k; else this.spin = -TAU * k; }   // side views: the blade loops a full circle in front (a windmill) instead of a turn the camera sees edge-on\n4101\t      } else {\n4102\t        const k = ease.outQuad(clamp(A.u / hold, 0, 1)), span = sp.spin ? 0 : sp.a1 - sp.a0;\n4103\t        this._theta = (sp.spin ? sp.a0 : sp.a1) + span * .08 * k; this.atkZ = z1; this.reach = r1;\n4104\t        armT = A.u < hold ? 1 : 1 - ease.inOut((A.u - hold) / (1 - hold));\n4105\t        tLean = lean * armT; tLunge = lunge * armT;\n4106\t      }\n4107\t      tTwist = sp.spin ? 0 : clamp(this._theta * (side ? .08 : .32) * (sp.twist === undefined ? 1 : sp.twist) * (this._atkHand === 'L' ? -1 : 1), -.7, .7);\n4108\t      // smear arc in absolute ground angles\n4109\t      if (this._sidePlane) this._smear = null;\n4110\t      else if (sp.blade !== 0) {\n4111\t        const base = this.facing, len = ((sp.reach || 7.5) + (sp.blade || o.bladeLen)) * o.size;\n4112\t        if (A.phase === 'active') this._smear = { a0: base + sp.a0, a1: base + this.spin + this._theta, r0: len * .45, r1: len, z: (this.atkZ + 1) * o.size, fade: 1 };\n4113\t        else if (A.phase === 'recover' && this._smear) { const u = clamp(A.u / .5, 0, 1); const end = base + (sp.spin ? sp.a0 - TAU : sp.a1); this._smear.a0 = lerp(base + sp.a0, end, ease.inQuad(u)); this._smear.a1 = end; this._smear.fade = 1 - u; if (u >= 1) this._smear = null; }\n411