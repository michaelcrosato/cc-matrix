from = [250, 180, 18], to = [330, 210, 40], vv = B.aim(from, to, 1.05), L2 = B.make(0, from, vv), q = B.at(L2, 1.05);","+  t('aim reaches its target', Math.hypot(q[0] - to[0], q[1] - to[1], q[2] - to[2]) < .5);","+  const th = B.timeAtHeight(L2, 40); t('timeAtHeight on the way down', th !== null && Math.abs(B.at(L2, th)[2] - 40) < .05 && th > B.apexTau(L2));","+  const C = G.COURT;","+  const clear = B.make(0, [300, C.CY, 60], B.aim([300, C.CY, 60], [420, C.CY, 3.5], 1)); t('a high ball clears the net', B.netCheck(clear).kind === 'clear');","+  const low = B.make(0, [300, C.CY, 20], [200, 0, 10]); t('a low ball hits the net', B.netCheck(low).kind === 'net');","+  const wide = B.make(0, [300, C.CY + 80, 60], [150, 0, 60]); t('outside the antennae', B.netCheck(wide).kind === 'outside');","+  t('on the line is in', B.inCourt([C.X0 - 3, C.CY, 0]) && !B.inCourt([C.X0 - 5, C.CY, 0]));","+};"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/04-rules.test.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":10,"lines":["+import { load } from '../lib/load.mjs';","+export default async t => {","+  const { G } = load(); const R = G.Rules;","+  t('7-5 wins', R.setWon([7, 5], 7) === 0); t('7-6 plays on', R.setWon([7, 6], 7) === -1); t('9-7 wins', R.setWon([9, 7], 7) === 0); t('cap at 11', R.setWon([10, 11], 7) === 1);","+  t('set point at 6-4', R.setPoint([6, 4], 7, 0)); t('no set point at 6-6', !R.setPoint([6, 6], 7, 0));","+  t('serve rotation alternates', R.nextServer([0, 1], 0) === 1 && R.nextServer([1, 1], 0) === 0);","+  const w = { perfect: .05, great: .1, ok: .16 };","+  t('judge PERFECT at the edge', G.judge(.05, w) === 'PERFECT'); t('judge GREAT', G.judge(-.08, w) === 'GREAT'); t('judge OK', G.judge(.16, w) === 'OK'); t('judge MISS', G.judge(.17, w) === 'MISS');","+  t