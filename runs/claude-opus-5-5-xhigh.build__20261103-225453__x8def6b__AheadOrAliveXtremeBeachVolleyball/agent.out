= (x, y) => !(x >= hb[0] - 3 && x <= hb[2] + 3 && y >= hb[1] - 3 && y <= hb[3] + 3) && pois.every(q => Math.hypot(q.x - x, q.y - y) > 5);","+  const put = (id, x, y) => { const lv = free(x, y); if (!lv) return; taken.add(y * W + x); objs.push({ id, x, y, z: lv, facing: Math.floor((id === 'rock' ? Rk : Rp)() * 4) }); };","   for (let y = 3; y < D - 3; y++) for (let x = 3; x < W - 3; x++) {","     const k = kind[y * W + x], dt = Math.hypot(x - def.town.x, y - def.town.y), r = Rp(), top = w.vox[w.idx(x, y, Math.max(0, w.topZ(x, y) - 1))];","     if (dt < 8) continue;"]},{"oldStart":16912,"oldLines":9,"newStart":16916,"newLines":9,"lines":["       if (top !== B('grass')) continue;","       if (r < .075) put('tuft', x, y); else if (r < .09) put('cottonPuff', x, y); else if (r < .105) put('buttercup', x, y);","       else if (r < .14 && dt < 26 && dt > 11) put('berryBush', x, y); else if (r < .143) put('deadBush', x, y);","-    } else if (k === 1) { if (top === B('grass') && r < .03) put('tuft', x, y); else if (r < .02) put('deadBush', x, y); else if (r < .028 && dt > 14) put('rock', x, y); }","+    } else if (k === 1) { if (top === B('grass') && r < .03) put('tuft', x, y); else if (r < .02) put('deadBush', x, y); else if (r < .028 && dt > 14 && rockOk(x, y)) put('rock', x, y); }","     else if (k === 2) { if (r < .045 && treeAt.size) put('puffball', x, y); else if (r < .075 && (x < 100 || y > 50 || x > 136 || y < 9)) put('bluebell', x, y); else if (r < .065) put('tuft', x, y); }","-    else if (k === 3) { if (r < .02 && top === B('sand')) put('cottonPuff', x, y); else if (r < .03 && top === B('grass')) put('tuft', x, y); else if (r < .036 && top === B('sand')) put('rock', x, y); }","+    else if (k === 3) { if (r < .02 && top === B('sand')) put('cottonPuff', x, y); else if (r < .03 && top === B('grass')) put('tuft', x, y); else if (r < .036 && top === B('sand') && rockOk(x, y)) put('rock', x, y); }","     else if (k === 4) { if (r < .015) put('deadBush', x, y); }","   }"