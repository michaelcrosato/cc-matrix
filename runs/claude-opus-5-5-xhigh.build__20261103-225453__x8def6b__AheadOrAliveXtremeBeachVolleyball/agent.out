.bladeLen)) : left ? J.handL : J.handR;\n4136\t      const wb = this._w(b), wt = this._w(t), last = T[T.length - 1];\n4137\t      if (last && Math.hypot(this.x + wt[0] - last.t[0], this.y + wt[1] - last.t[1], this.z + wt[2] - last.t[2]) > 14 * o.size) T.length = 0;   // a jump (teleport, respawn): start a new ribbon\n4138\t      T.push({ b: [this.x + wb[0], this.y + wb[1], this.z + wb[2]], t: [this.x + wt[0], this.y + wt[1], this.z + wt[2]], o: [this.x, this.y, this.z], age: 0, w: sword ? 1 : .6 });\n4139\t      if (T.length > 12) T.shift();\n4140\t    }\n4141\t  }\n4142\t  /** long hair and ponytails: a verlet strand that trails behind the head */\n4143\t  _hair(dt) {\n4144\t    const o = this.o, long = o.hair.style === 'long', N = o.hair.len || (long ? 6 : 4), seg = (long ? 1.9 : 1.6) * o.size;\n4145\t    const J = this.J, anchor = () => { const w = this._w([J.head[0] - o.headR * .8, 0, J.head[2] + (long ? o.headR * .1 : o.headR * .55)]); return [this.x + w[0], this.y + w[1], this.z + w[2]]; };\n4146\t    if (!this._hairPts) { const a = anchor(), hx = -Math.cos(this.facing) * .8 * o.size, hy = -Math.sin(this.facing) * .8 * o.size; this._hairPts = Array.from({ length: N }, (_, i) => ({ x: a[0] + hx * i * .3, y: a[1] + hy * i * .3, z: a[2] - i * seg, px: a[0] + hx * i * .3, py: a[1] + hy * i * .3, pz: a[2] - i * seg })); }\n4147\t    const P = this._hairPts, a = anchor(), damp = Math.pow(.97, dt * 120), fx = Math.cos(this.facing + this.spin), fy = Math.sin(this.facing + this.spin), dt2 = dt * dt;   // trails behind the body's turn\n4148\t    Object.assign(P[0], { x: a[0], y: a[1], z: a[2], px: a[0], py: a[1], pz: a[2] });\n4149\t    for (let i = 1; i < P.length; i++) { const n = P[i], vx = (n.x - n.px) * damp, vy = (n.y - n.py) * damp, vz = (n.z - n.pz) * damp; n.px = n.x; n.py = n.y; n.pz = n.z; n.x += vx - fx * 20 * dt2; n.y += vy - fy * 20 * dt2; n.z += vz - 200 * dt2; }\n4150\t    const shZ = this.z + J.shC[2] * o.size, bodyR = (o.torsoW * .75 + .6) * o.size, headTop = this.z + (J.head[2] + o.headR * .6) * o.size;\n4151\t    for (let it = 0; it < 3; it++) for (let i = 1; i < P.length; i++) {\n4152\t      const A = P[i - 1], B = P[i], dx = B.x - A.x, dy = B.y - A.y, dz = B.z - A.z, d = Math.hypot(dx, dy, dz) || 1e-6, kk = (d - seg) / d;\n4153\t      if (i === 1) { B.x -= dx * kk; B.y -= dy * kk; B.z -= dz * kk; } else { A.x += dx * kk * .5; A.y += dy * kk * .5; A.z += dz * kk * .5; B.x -= dx * kk * .5; B.y -= dy * kk * .5; B.z -= dz * kk * .5; }\n4154\t      const rx = B.x - this.x, ry = B.y - this.y, rd = Math.hypot(rx, ry);\n4155\t      if (B.z < shZ + 2 * o.size && rd < bodyR) { const ux = rd > .01 ? rx / rd : -fx, uy = rd > .01 ? ry / rd : -fy; B.x = this.x + ux * bodyR; B.y = this.y + uy * bodyR; }\n4156\t      if (B.z < this.z + .5) B.z = this.z + .5;\n4157\t      if (B.z > headTop) B.z = headTop;   // no plume over the head on attacks and knockbacks\n4158\t    }\n4159\t  }\n4160\t  /** set the joints J from the rig's state this step (update and setPose call it); a clip player may wrap it on one rig:\n4161\t   *  const base = rig.solvePose; rig.solvePose = function () { base.call(this); ...move J... } */\n4162\t  solvePose() {\n4163\t    const o = this.o, J = this.J, sp = Math.min(1, this._spW), mf = this._mv[0], mr = this._mv[1], ph = this.phase, dash = this._dashW, hurt = this.hurtW, rz = V3.rz, add = V3.add;\n4164\t    const breathe = Math.sin(this.t * 2.3) * (1 - sp);\n4165\t    const bob = (.5 - Math.abs(Math.cos(ph)) * 1.3) * sp;\n4166\t    const PW = this.poseW || { cheer: 0, cast: 0, guard: 0, kneel: 0 }, kn = PW.kneel, lg = this.lunge || 0, cw = this._climbW || 0;\n4167\t    const hw = this._hangW || 0, snk = this._sneakW || 0, spr = (this._sprintW || 0) * sp, ld = this._landW || 0, sk = this._strideK();\n4168\t    const cr = Math.max(PW.crouch || 0, this._crouchA || 0, Math.sin(clamp(this.downW || 0, 0, 1) * Math.PI) * .85);   // falling (and getting up) buckles the knees\n4169\t    const sway = Math.sin(this.t * 1.15) * .3 * (1 - sp) * (1 - this._atkW);   // idle weight shift from foot to foot\n4170\t    const hipC = [mf * .4 * sp - .4 * hurt + lg * .55, mr * .3 * sp + sway, o.hipZ + bob + breathe * .3 - dash * 2.2 - hurt * .6 - kn * o.hipZ * .42 - PW.guard * .9 - cr * o.hipZ * .32 - snk * o.hipZ * .3 - ld * o.hipZ * .42 + (this.hop || 0)];\n4171\t    J.hipL = add(hipC, rz([0, -o.hipHalf, 0], this._twist * .4)); J.hipR = add(hipC, rz([0, o.hipHalf, 0], this._twist * .4));\n4172\t    for (const s of [-1, 1]) {\n4173\t      const p = ph + (s > 0 ? Math.PI : 0), along = Math.sin(p) * o.stride * sp * sk;\n4174\t      let foot = [mf * along + (s > 0 ? .8 : -.6) * (1 - sp), s * o.footSpread + mr * along, Math.max(0, Math.cos(p)) * o.lift * sp];\n4175\t      foot = V3.lerp(foot, [s > 0 ? 4 : -5, s * 2.2, s > 0 ? 1.5 : .3], dash);\n4176\t      if (this._airW > 0) foot = V3.lerp(foot, [s > 0 ? 3.2 : -2.6, s * 1.9, s > 0 ? 6 : 3.6], this._airW);\n4177\t      if (kn > 0) foot = V3.lerp(foot, [s > 0 ? 3.4 : -4.2, s * 2, s > 0 ? 0 : 0], kn);\n4178\t      if (PW.guard > 0) foot = V3.lerp(foot, [s > 0 ? 2.6 : -2.8, s * 2.6, 0], PW.guard * (1 - sp));\n4179\t      if (cr > 0) foot = V3.lerp(foot, [s > 0 ? 1.6 : -1.4, s * (o.footSpread + .7), foot[2] * (1 - cr)], cr * (1 - sp * .5));\n4180\t      if (lg > 0) foot[0] += (s === (this._atkHand === 'L' ? 1 : -1) ? lg * 1.3 : -lg * .15) * (1 - sp);   // the lead foot steps into the strike\n4181\t      if (this.hop) foot[2] += this.hop;\n4182\t      if (cw > 0) foot = V3.lerp(foot, [.6, s * 1.5, Math.max(0, Math.sin(this._climbP + (s > 0 ? Math.PI : 0))) * 3.4], cw);\n4183\t      if (snk > 0) foot[1] += s * .6 * snk;                                                                     // a wider, lower stance\n4184\t      if (ld > 0) foot = V3.lerp(foot, [s > 0 ? 2.6 : -2.4, s * (o.footSpread + 1), 0], Math.min(1, ld));      // planted wide\n4185\t      if (hw > 0) foot = V3.lerp(foot, [1.3, s * 1.3, o.hipZ * .08 + (s > 0 ? .8 : 0)], hw);                   // dangling against the wall\n4186\t      if (s > 0 && this._kicking && this._atkW > 0) foot = V3.lerp(foot, [Math.cos(this._theta) * (this.reach + 3), Math.sin(this._theta) * (this.reach + 3), (this._atkRel ? this.atkZ * o.hipZ : this.atkZ) + (this.hop || 0)], this._armW || 0);\n4187\t      const hip = s > 0 ? J.hipR : J.hipL;\n4188\t      const [knee, f2] = ik3(hip, foot, o.legUpper, o.legLower, [1, s * .15, .1]);\n4189\t      J[s > 0 ? 'kneeR' : 'kneeL'] = knee; J[s > 0 ? 'footR' : 'footL'] = f2;\n4190\t    }\n4191\t    const leanF = (o.lean + .16 * sp * mf + .45 * dash + this._atkLean - .35 * hurt + cr * .22 + snk * .34 + spr * .3 + ld * .42) * (1 - hw) + hw * .06, leanR = .1 * sp * mr;\n4192\t    const dir = V3.norm([Math.sin(leanF), Math.sin(leanR), Math.cos(leanF)]);\n4193\t    const shC = add(hipC, V3.mul(dir, o.torso));\n4194\t    J.hipC = hipC; J.shC = shC;\n4195\t    J.shL = add(shC, rz([0, -o.shoulderHalf, 0], this._twist)); J.shR = add(shC, rz([0, o.shoulderHalf, 0], this._twist));\n4196\t    J.head = add(shC, V3.mul(V3.norm([dir[0] + o.hunch * .9, dir[1], dir[2]]), o.neck + o.headR));\n4197\t    const armLen = o.armUpper + o.armLower, aw = this._armW || 0, sA = this._atkHand === 'L' ? -1 : 1, two = this._atkHand === 'both', fists = !o.weapon || this._stW > .5;\n4198\t    // where the striking hand goes, and the weapon's direction, for the current attack angle\n4199\t    const aT = this._sidePlane ? add(shC, [Math.cos(this._theta) * this.reach, sA * .8, Math.sin(this._theta) * this.reach]) : add(shC, [Math.cos(this._theta) * this.reach, Math.sin(this._theta) * this.reach, this._atkRel ? this.atkZ : this.atkZ - shC[2]]);\n4200\t    const aDir = this._sidePlane ? V3.norm([Math.cos(this._theta), .05, Math.sin(this._theta)]) : V3.norm([Math.cos(this._theta), Math.sin(this._theta), -.12]);\n4201\t    for (const s of [-1, 1]) {\n4202\t      const sh = s > 0 ? J.shR : J.shL, q = ph + (s > 0 ? 0 : Math.PI), along = -Math.sin(q) * o.swing * sp * (1 + .6 * spr) * (1 - .4 * snk);\n4203\t      let hand = add(sh, [mf * along + .5 * (1 - sp) + o.hunch * 3, s * .9 + mr * along, -armLen * .86 + Math.abs(Math.sin(q)) * 1.2 * sp]);\n4204\t      hand = V3.lerp(hand, add(sh, [-4.5, s * 1.6, -5]), dash);\n4205\t      hand = V3.lerp(hand, add(sh, s > 0 ? [1.4, -.6, .6] : [-1.6, s * 2.2, -3.2]), hurt);   // a flinch: one arm up to shield the face, the other flung back\n4206\t      if (this._airW > 0) hand = V3.lerp(hand, add(sh, [1.2, s * 2.6, -1.2]), this._airW * .7);\n4207\t      if (s > 0 && this._pointW > 0) { const aa = this._aimA || 0; hand = V3.lerp(hand, add(sh, [armLen * .92 * Math.cos(aa), -.6, armLen * .92 * Math.sin(aa) - .4]), this._pointW); }\n4208\t      if (PW.cheer > 0) hand = V3.lerp(hand, add(sh, [.6, s * 1.4, armLen * (.74 + .12 * Math.sin(this.t * 9 + (s > 0 ? 0 : .7)))]), PW.cheer);   // fists pump\n4209\t      if (PW.cast > 0) hand = V3.lerp(hand, add(shC, [armLen * .82, s * 1.3, -1.2]), PW.cast);\n4210\t      const guardAt = add(shC, s < 0 ? [3.8, -1, .4] : [2.3, 1.5, -.6]);   // boxer's guard: lead fist out at chin height, face stays visible\n4211\t      if (PW.guard > 0) hand = V3.lerp(hand, guardAt, PW.guard);\n4212\t      if (this._stW > 0) hand = V3.lerp(hand, guardAt, this._stW * (1 - dash));\n4213\t      if (this._rdW > 0 && o.weapon) hand = V3.lerp(hand, s > 0 ? add(shC, [2.8, .9, -3]) : add(shC, [2.2, .2, -3.6]), this._rdW * (1 - dash));   // ready: weapon held forward in both hands\n4214\t      if (PW.wave > 0 && s === (o.weapon ? -1 : (this._camSide || 1))) { const w = Math.sin(this.t * 11); hand = V3.lerp(hand, add(sh, [.8 + w * 1.7, s * (2 + Math.max(0, w) * 1.4), armLen * .8]), PW.wave); }   // the free hand waves (the camera-side one when both are free)\n4215\t      if (PW.hips > 0) hand = V3.lerp(hand, add(s > 0 ? J.hipR : J.hipL, [-.2, s * 1.5, 1.5]), PW.hips);\n4216\t      if (PW.block > 0) hand = V3.lerp(hand, add(shC, s > 0 ? [2.6, .6, -2.4] : [2.4, -.2, -3.4]), PW.block);   // block: weapon upright across the body, both hands on it\n4217\t      if (cw > 0) hand = V3.lerp(hand, add(sh, [1.7, s * .5, armLen * (.08 + .8 * (.5 + .5 * Math.sin(this._climbP + (s > 0 ? 0 : Math.PI))))]), cw);   // hands on the rails, one reaching high above the head while the other pulls down\n4218\t      if (snk > 0) hand = V3.lerp(hand, add(sh, [2.2 + along * .3, s * 1.3, -armLen * .6]), snk * .55);       // sneaking: hands low and forward\n4219\t      if (ld > 0) hand = V3.lerp(hand, s > 0 && this._landK >= 1 ? [3.2, 1.6, .3] : add(sh, [-1.4, s * 3.2, -armLen * .3]), Math.min(1, ld));   // a three-point landing: one hand on the ground, the other back\n4220\t      if (hw > 0) hand = V3.lerp(hand, add(sh, [2.4, s * .4, clamp((this._hangZ === undefined ? sh[2] + armLen : this._hangZ) - sh[2], 1, armLen * .96)]), hw);   // gripping the edge above\n4221\t      const wk = this._from && this._windK < 1 ? this._windK : 1, from = wk < 1 ? this._from[s > 0 ? 'R' : 'L'] : null;\n4222\t      if (aw > 0 && !this._kicking) {\n4223\t        if (s === sA) hand = V3.lerp(hand, from ? V3.lerp(from, aT, wk) : aT, aw);                // the striking hand\n4224\t        else if (two) hand = V3.lerp(hand, add(aT, V3.mul(aDir, -1.7)), aw);                      // two-handed grip below it\n4225\t        else { const offT = fists ? guardAt : add(shC, [1.6, s * 1.6, -1.6]); hand = V3.lerp(hand, from ? V3.lerp(from, offT, wk) : offT, from ? aw : aw * .85); }   // the other hand guards the chin (fists) or pulls back\n4226\t      }\n4227\t      if (this._kicking && aw > 0) hand = V3.lerp(hand, add(shC, [1.8, s * 2.2, .6 - (s > 0 ? 1.5 : 0)]), aw * .85);   // arms up for balance during a kick\n4228\t      const [elbow, h2] = ik3(sh, hand, o.armUpper, o.armLower, [-1, s * .7, -.2]);\n4229\t      J[s > 0 ? 'elbowR' : 'elbowL'] = elbow; J[s > 0 ? 'handR' : 'handL'] = h2;\n4230\t    }\n4231\t    const wp = o.weapon, rest = V3.norm(wp === 'staff' ? [.3, .15, 1] : wp === 'gun' ? [.8, 0, -.6] : [.55, .35, -.75]), atk = aDir;\n4232\t    let bd = V3.lerp(rest, atk, this._kicking || sA < 0 ? 0 : aw);\n4233\t    if (this._from && this._windK < 1 && !this._kicking && sA > 0) bd = V3.lerp(this._from.bd, bd, this._windK);   // the weapon turns from where it was\n4234\t    if (PW.cheer > 0) bd = V3.lerp(bd, [.15, .05, 1], PW.cheer);   // raised in triumph, point up\n4235\t    if (PW.block > 0) bd = V3.lerp(bd, [.35, -.3, .9], PW.block);   // held upright across the body\n4236\t    if (this._rdW > 0) bd = V3.lerp(bd, [.62, .08, .78], this._rdW * (1 - aw));\n4237\t    if (this._pointW > 0) bd = V3.lerp(bd, [Math.cos(this._aimA || 0), 0, Math.sin(this._aimA || 0)], this._pointW);\n4238\t    J.bladeDir = V3.norm(bd);\n4239\t    const dw = this.downW || 0;\n4240\t    if (dw > 0) J.bladeDir = V3.norm(V3.lerp(J.bladeDir, [0, .9, -.4], dw));   // a dropped weapon lies flat once the body is down\n4241\t    if (dw > 0) {   // knocked down: rotate the whole skeleton backward so it lies flat, face up, centred on the rig's position\n4242\t      const a = dw * Math.PI / 2 * .96, ca = Math.cos(a), sa = Math.sin(a), lift = dw * 1.4, shift = dw * (o.hipZ + o.torso) * .5;\n4243\t      for (const k in J) { if (k === 'bladeDir') continue; const p = J[k]; J[k] = [p[0] * ca - p[2] * sa + shift, p[1], p[0] * sa + p[2] * ca + lift]; }\n4244\t      const b = J.bladeDir; J.bladeDir = [b[0] * ca - b[2] * sa, b[1], b[0] * sa + b[2] * ca];\n4245\t    }\n4246\t  }\n4247\t  /** world position of the head (for speech bubbles, portraits, halos) */\n4248\t  head() { const w = this._w(this.J.head); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\n4249\t  /**\n4250\t   * a close-up bust for dialog boxes and menus, drawn live from the rig (blinks, hair and hats included):\n4251\t   *   rig.drawPortrait(g, x, y, 40, { zoom: 3, turn: .6, bg: '#1a2050', frame: true })   // inside r.overlay(g => ...)\n4252\t   * zoom: pixels per world unit (3 = face fills the frame), turn: 0 = facing you, .6 = three-quarter.\n4253\t   * The bust stays upright while the rig kneels or lies down (upright: false shows the real pose); cape: false hides the cape;\n4254\t   * tint: '#808080' greys it out (a KO'd party member).\n4255\t   */\n4256\t  drawPortrait(g, x, y, size = 40, o = {}) {\n4257\t    const S = Math.round(size), zoom = o.zoom || 3, turn = o.turn === undefined ? .6 : o.turn, pitch = o.pitch || 12;\n4258\t    const v = this._pv || (this._pv = new View('portrait', 'Portrait', 0, pitch, zoom, 1));\n4259\t    v.set((Math.PI / 2 - this.facing - this.spin + turn) / DEG, pitch, zoom, 1);\n4260\t    const cache = this._pcs || (this._pcs = new Map());\n4261\t    let cvs = cache.get(S); if (!cvs) { cvs = [mkCanvas(S, S), mkCanvas(S, S)]; cache.set(S, cvs); }\n4262\t    const [cv, c2] = cvs, cg = cv.getContext('2d'), g2 = c2.getContext('2d');\n4263\t    cg.clearRect(0, 0, S, S); g2.clearRect(0, 0, S, S);\n4264\t    const PW = this.poseW || {}, keep = { trail: this.trail, cheat: this._cheat, pitch: this._pitch, cape: this.o.cape, weapon: this.o.weapon, down: this.downW, kneel: PW.kneel, cheer: PW.cheer, cast: PW.cast, hurt: this.hurtW };\n4265\t    const pose = o.upright !== false && (keep.down > 0 || keep.kneel > 0 || keep.cheer > 0 || keep.cast > 0 || keep.hurt > 0);\n4266\t    if (pose) { this.downW = 0; this.hurtW = 0; if (this.poseW) PW.kneel = PW.cheer = PW.cast = 0; this.solvePose(); }\n4267\t    if (o.cape === false) this.o.cape = null;\n4268\t    if (o.weapon === false) this.o.weapon = null;\n4269\t    { const st = clamp(1 - v.pitchDeg / 45, 0, 1), camA = Math.atan2(v.fy, v.fx); this._cheat = st > 0 && this.o.cheat ? clamp(angDiff(this.facing, camA), -this.o.cheat, this.o.cheat) * st : 0; }   // frame the head where draw() will put it\n4270\t    this.trail = [];\n4271\t    try {\n4272\t      const hw = this._w(this.J.head), hp = v.p(hw[0], hw[1], hw[2]);\n4273\t      this.draw(cg, Math.round(S / 2 - hp[0]), Math.round(S * (o.headY || .46) - hp[1]), v);\n4274\t    } finally {\n4275\t      this.trail = keep.trail; this._cheat = keep.cheat; this._pitch = keep.pitch; this.o.cape = keep.cape; this.o.weapon = keep.weapon;\n4276\t      if (pose) { this.downW = keep.down; this.hurtW = keep.hurt; if (this.poseW) { PW.kneel = keep.kneel; PW.cheer = keep.cheer; PW.cast = keep.cast; } this.solvePose(); }\n4277\t    }\n4278\t    if (o.tint) { cg.globalCompositeOperation = 'source-atop'; cg.globalAlpha = .6; cg.fillStyle = o.tint; cg.fillRect(0, 0, S, S); cg.globalAlpha = 1; cg.globalCompositeOperation = 'source-over'; }\n4279\t    for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) g2.drawImage(cv, dx, dy);   // outline like the in-game sprite\n4280\t    g2.globalCompositeOperation = 'source-in'; g2.fillStyle = o.outline || '#0c0818'; g2.fillRect(0, 0, S, S); g2.globalCompositeOperation = 'source-over';\n4281\t    g2.drawImage(cv, 0, 0);\n4282\t    if (o.frame !== false) E.ui.box(g, x - 2, y - 2, S + 4, S + 4, { bg: o.bg || '#1a2050', border: o.border, shadow: o.shadow });\n4283\t    g.drawImage(c2, 1, 1, S - 2, S - 2, Math.round(x) + 1, Math.round(y) + 1, S - 2, S - 2);\n4284\t  }\n4285\t  _cape(dt) {\n4286\t    const c = this.o.cape, sz = this.o.size, N = c.len || 6, seg = (c.seg || 2.4) * sz, W0 = (c.width || 5) * sz;\n4287\t    const anchor = s => { const J = this.J, sh = s > 0 ? J.shR : J.shL, w = this._w(V3.add(sh, [-1.3, -s * .6, -.6])); return [this.x + w[0], this.y + w[1], this.z + w[2]]; };\n4288\t    if (!this.capeL) {\n4289\t      /** capeR: the cape's right edge points */\n4290\t      this.capeL = []; this.capeR = [];\n4291\t      const bx = -Math.cos(this.facing) * (c.body || 3.4) * sz, by = -Math.sin(this.facing) * (c.body || 3.4) * sz;   // start hanging behind the back, not inside the body\n4292\t      for (const s of [-1, 1]) { const a = anchor(s), ch = s < 0 ? this.capeL : this.capeR; for (let i = 0; i < N; i++) { const k = Math.min(1, i / 2); ch.push({ x: a[0] + bx * k, y: a[1] + by * k, z: a[2] - i * seg, px: a[0] + bx * k, py: a[1] + by * k, pz: a[2] - i * seg }); } }\n4293\t    }\n4294\t    const damp = Math.pow(.982, dt * 120), dt2 = dt * dt, fx = Math.cos(this.facing + this.spin), fy = Math.sin(this.facing + this.spin);   // trails behind the body's turn\n4295\t    for (const [ch, s] of [[this.capeL, -1], [this.capeR, 1]]) {\n4296\t      const a = anchor(s); Object.assign(ch[0], { x: a[0], y: a[1], z: a[2], px: a[0], py: a[1], pz: a[2] });\n4297\t      for (let i = 1; i < N; i++) {\n4298\t        const n = ch[i], vx = (n.x - n.px) * damp, vy = (n.y - n.py) * damp, vz = (n.z - n.pz) * damp;\n4299\t        n.px = n.x; n.py = n.y; n.pz = n.z;\n4300\t        const fl = Math.sin(this.t * 11 - i * .8 + s) * 40 * (i / N);\n4301\t        n.x += vx - fx * 30 * dt2; n.y += vy - fy * 30 * dt2; n.z += vz + (-230 + fl) * dt2;\n4302\t      }\n4303\t    }\n4304\t    const L = this.capeL, R = this.capeR, bodyR = (c.body || 3.4) * sz, shZ = this.z + this.J.shC[2] * sz;\n4305\t    for (let it = 0; it < 4; it++) {\n4306\t      for (const ch of [L, R]) for (let i = 1; i < N; i++) {\n4307\t        const a = ch[i - 1], b = ch[i], dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, d = Math.hypot(dx, dy, dz) || 1e-6, k = (d - seg) / d;\n4308\t        if (i === 1) { b.x -= dx * k; b.y -= dy * k; b.z -= dz * k; } else { a.x += dx * k * .5; a.y += dy * k * .5; a.z += dz * k * .5; b.x -= dx * k * .5; b.y -= dy * k * .5; b.z -= dz * k * .5; }\n4309\t      }\n4310\t      for (let i = 1; i < N; i++) {\n4311\t        const a = L[i], b = R[i], w = W0 * (1 + .25 * i / N), dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, d = Math.hypot(dx, dy, dz) || 1e-6, k = (d - w) / d * .5;\n4312\t        a.x += dx * k; a.y += dy * k; a.z += dz * k; b.x -= dx * k; b.y -= dy * k; b.z -= dz * k;\n4313\t      }\n4314\t      for (const ch of [L, R]) for (let i = 1; i < N; i++) {\n4315\t        const n = ch[i]; if (n.z < this.z + .4) n.z = this.z + .4; if (n.z > shZ + seg * .6) n.z = shZ + seg * .6;   // never whips up over the head\n4316\t        const rx = n.x - this.x, ry = n.y - this.y, d = Math.hypot(rx, ry), fwd = rx * fx + ry * fy;\n4317\t        if (n.z < shZ + 1 && fwd > -bodyR * .35) { n.x -= fx * (fwd + bodyR * .35); n.y -= fy * (fwd + bodyR * .35); }   // cloth stays behind the back plane, never across the chest\n4318\t        else if (n.z < shZ + 1 && d < bodyR) { const ux = d > .01 ? rx / d : -fx, uy = d > .01 ? ry / d : -fy; n.x = this.x + ux * bodyR; n.y = this.y + uy * bodyR; }\n4319\t      }\n4320\t    }\n4321\t  }\n4322\t  /**\n4323\t   * Sp(joint, f, r, z): a detail drawn around a joint (the face, hair, belt, toes) at offsets in the body's own frame,\n4324\t   * projected by S. A knocked-down body turns them backward with it. While a motion clip plays (Mocap.drive sets"}]},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"aa1c90ca-49cb-4515-a118-29e053fd8e6d","timestamp":"2026-11-04T05:57:44.740Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/engine/my-3d2dge.js","content":" * ============================================================================= */\nconst HUMAN_COLORS = {\n  skin: '#f1c7a0', hair: '#3b2a2f', cloth: '#2f8f86', pants: '#3b3552', boot: '#6a4128', belt: '#e0a84a',\n  cape: '#c8452f', capeIn: '#7a2622', metal: '#dce8f1', metalDk: '#7f93ab', hilt: '#e8b04e', eye: '#1a1320'\n};\nconst JOINT_KEYS = ['hipL', 'hipR', 'kneeL', 'kneeR', 'footL', 'footR', 'hipC', 'shC', 'shL', 'shR', 'head', 'elbowL', 'elbowR', 'handL', 'handR'];\n/** body proportions: 'chibi' (default, big head, Secret of Mana), 'heroic' (tall, Symphony of the Night), 'bulky' (brawlers, bosses) */\nconst BUILDS = {\n  chibi: {},\n  heroic: { legUpper: 7.4, legLower: 7.4, hipZ: 14.3, torso: 9.6, shoulderHalf: 3.5, headR: 3.05, neck: 1.5, armUpper: 5.5, armLower: 5.4, hipHalf: 1.8, stride: 7.8, speedRef: 80 },\n  bulky: { legUpper: 6.4, legLower: 6.2, hipZ: 12.2, torso: 9.4, shoulderHalf: 4.6, headR: 3.2, neck: .9, armUpper: 5.2, armLower: 5.2, hipHalf: 2.4, limbW: 2.6, torsoW: 4.2, footSpread: 2.4, stride: 6.6, speedRef: 60 },\n  // bones: rib cage, skull with glowing sockets and a jaw (colors.bone to tint; outfit, cape, hat and weapons still work)\n  skeleton: { legUpper: 7, legLower: 7, hipZ: 13.4, torso: 9, shoulderHalf: 3.2, headR: 3.1, neck: 1.6, armUpper: 5.3, armLower: 5.2, hipHalf: 1.5, limbW: .6, torsoW: 2.6, stride: 7, hunch: .2, skeleton: true, hair: 'bald', sleeves: 'none', eyeGlow: '#ff5a40' }\n};\nclass Humanoid {\n  /** new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a\n   *  character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each\n   *  step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style,\n   *  color }); hood: true (drawn in colors.hair) */\n  constructor(o = {}) {\n    if (o.build && !BUILDS[o.build]) warn('build:' + o.build, 'Humanoid build \"' + o.build + '\" is unknown (chibi, heroic, bulky, skeleton)');\n    o = Object.assign({}, BUILDS[o.build] || {}, o);\n    /** o: its options, with the build's proportions and the defaults filled in (size, build, weapon, outfit, ...;\n     *  legUpper, torso, headR and the other lengths are at size 1) */\n    this.o = Object.assign({\n      legUpper: 6, legLower: 6, hipZ: 11.6, hipHalf: 1.9, footSpread: 1.9, torso: 8, shoulderHalf: 3.3, neck: 1.2, headR: 3.4,\n      armUpper: 4.6, armLower: 4.6, limbW: 2, torsoW: 3, lean: 0, hunch: 0, stride: 6.5, lift: 3.4, swing: 4, speedRef: 70,\n      weapon: 'sword', bladeLen: 11, cape: null, hood: false, eyeGlow: null, hat: null,\n      style: 'hd', size: 1, hair: 'short', outfit: 'shirt', sleeves: 'short', armor: false, cheat: .5\n    }, o);\n    /** tra