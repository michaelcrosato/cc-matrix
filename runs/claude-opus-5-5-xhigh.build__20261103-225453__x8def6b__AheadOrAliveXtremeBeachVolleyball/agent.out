<'EOF'\\np='src/15-anim.js'; s=open(p).read()\\ns=s.replace(\\\"G.clipLib = () => {\\\",\\\"G.Mocap = () => (typeof Mocap !== 'undefined' ? Mocap : null);   // (mocap.js declares it at the top level: shared by name, not on window)\\\\nG.clipLib = () => {\\\")\\ns=s.replace(\\\"G._clips = window.Mocap && window.MOCAP && window.MOCAP.AOA ? window.Mocap.load(window.MOCAP.AOA) : null;\\\",\\\"G._clips = G.Mocap() && window.MOCAP && window.MOCAP.AOA ? G.Mocap().load(window.MOCAP.AOA) : null;\\\")\\ns=s.replace(\\\"if (!this._mocapOn) { window.Mocap.drive(this, lib); this._mocapOn = true; }\\\",\\\"if (!this._mocapOn) { G.Mocap().drive(this, lib); this._mocapOn = true; }\\\")\\ns=s.replace(\\\"this.mocap = lib.sample(clip, tt, this._mocapBuf || (this._mocapBuf = undefined));\\\",\\\"this.mocap = lib.sample(clip, tt);\\\")\\nopen(p,'w').write(s)\\nEOF\\ncat > test/suites/16-anim.test.mjs <<'EOF'\\n// motion-capture clips: the set loads, every clip the game names exists, celebrations and reactions play them, and the\\n// IK moves still blend in underneath\\nimport { load } from '../lib/load.mjs';\\nexport default async t => {\\n  const { G, game } = load(); game.advance(.5);\\n  const lib = G.clipLib(); t('the clip set loads', !!lib && lib.names.length === 20, lib && lib.names.length);\\n  const missing = Object.values(G.CLIP_OF).filter(n => !lib.clip(n)); t('every clip the game names is in the set', !missing.length, missing.join(','));\\n  for (const [kind, name] of Object.entries(G.CLIP_OF)) {\\n    const rig = G.anim.rig(G.makeRig('amara')); rig.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0 }); const before = JSON.stringify(rig.J.handR);\\n    rig.vb = { kind, u: .5, w: 1 }; rig.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0 });\\n    t(kind + ' plays ' + name, rig._clipName === name && rig.mocapW === 1 && JSON.stringify(rig.J.handR) !== before && rig.J.handR.every(isFinite));\\n  }\\n  const rig = G.anim.rig(G.makeRig('rin')); rig.vb = { kind: 'bow', u: .5, w: 1 }; rig.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0 }); rig.vb = { kind: 'set', u: .5, w: 1 }; rig.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0 });\\n  t('an IK move turns the clip off again', rig.mocapW === 0 && rig.J.handR[2] > 24, rig.mocapW + ' ' + rig.J.handR);\\n  // in play: a celebration after a point uses the scorer's signature clip\\n  let res = null; G.seed('match', 2); G.startMatch({ mode: 'exhibition', cpuAll: true, pointsToWin: 3, replays: false, teams: [[{ id: 'rin', suit: 'seigaiha', acc: [] }, { id: 'lola', suit: 'estrella', acc: [] }], [{ id: 'tess', suit: 'reefbreak', acc: [] }, { id: 'mei', suit: 'peony', acc: [] }]], after: r => { res = r; } }, { fade: 0 });\\n  const seen = new Set(); for (let s = 0; s < 120 * 300 && !res; s++) { game.advance(1 / 120); for (const p of G.M.players) if (G.clipPlaying(p.rig)) seen.add(p.rig._clipName); }\\n  t('matches play clips in celebrations and reactions', seen.size >= 3, [...seen].join(','));\\n  t('no errors', game.errors.length === 0, game.errors.map(e => e.message + ' ' + (e.stack || '').split('\\\\n')[1]).join(' | '));\\n};\\nEOF\\nnode tools/build.mjs | tail -1; node test/run.mjs --only=anim\",\"description\":\"Fix Mocap reference, add animation suite, build and run\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":569,\"cache_read_input_tokens\":752880,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":569},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"7b48fecc-086c-4274-afae-e17752649adf\",\"uuid\":\"409df0ba-f8a5-4fe4-8db1-f8374bae0f22\",\"timestamp\":\"2026-11-04T07:33:16.096Z\",\"request_id\":\"req_011CghVvee9c72M8Bdgwdpj6\",\"wire_tool_inputs\":{\"toolu_019biigUyRNeL