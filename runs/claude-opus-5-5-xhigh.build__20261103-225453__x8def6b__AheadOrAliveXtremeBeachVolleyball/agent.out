r\",\"content\":[{\"tool_use_id\":\"toolu_01NaZAAc6mtTXapMh8xNVjnE\",\"type\":\"tool_result\",\"content\":\"errors: []\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"b7d7e0cb-a26c-4fe8-90f7-7d5024813af2\",\"uuid\":\"0d21dd09-42da-4b53-aa3a-46e9f21f98ee\",\"timestamp\":\"2026-11-04T05:57:58.576Z\",\"tool_use_result\":{\"stdout\":\"errors: []\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false},\"tool_result_meta\":[{\"id\":\"toolu_01NaZAAc6mtTXapMh8xNVjnE\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}]}"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-215911__x5b1962/agent.out"]}},"tool_result_meta":[{"id":"toolu_01KCFTpemgDKsigKBQ2VyVS2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghNgZf4jNgnzZ52nKbtG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SQeF7JUJ8D5u3NQZyHRUAg","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/engine/my-3d2dge.js","offset":4322,"limit":370},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1580,"cache_read_input_tokens":223124,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1580},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"02c65d3b-0805-46c7-ab26-4829241268b4","timestamp":"2026-11-04T05:58:05.957Z","request_id":"req_011CghNgZPSGyMR1mSyFDfXH","wire_tool_inputs":{"toolu_01SQeF7JUJ8D5u3NQZyHRUAg":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/engine/my-3d2dge.js","offset":4322,"limit":370}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SQeF7JUJ8D5u3NQZyHRUAg","type":"tool_result","content":"4322\t  /**\n4323\t   * Sp(joint, f, r, z): a detail drawn around a joint (the face, hair, belt, toes) at offsets in the body's own frame,\n4324\t   * projected by S. A knocked-down body turns them backward with it. While a motion clip plays (Mocap.drive sets\n4325\t   * mocapTilt: the clip's body and head frames, 3x3, columns forward, right, up) they lean, roll and turn upside down with\n4326\t   * the body, and the face with the head; the weapon hand's offsets (the blade) are already in the rig's frame.\n4327\t   */\n4328\t  _offsets(S) {\n4329\t    const J = this.J, T = this.mocapTilt;\n4330\t    if (T) return (p, df = 0, dr = 0, dz = 0) => {\n4331\t      if (p === J.handR) return S(p[0] + df, p[1] + dr, p[2] + dz);\n4332\t      const m = p === J.head ? T.head : T.body;\n4333\t      return S(p[0] + m[0] * df + m[1] * dr + m[2] * dz, p[1] + m[3] * df + m[4] * dr + m[5] * dz, p[2] + m[6] * df + m[7] * dr + m[8] * dz);\n4334\t    };\n4335\t    const dA = (this.downW || 0) * Math.PI / 2 * .96, dca = Math.cos(dA), dsa = Math.sin(dA);\n4336\t    return dA ? (p, df = 0, dr = 0, dz = 0) => S(p[0] + df * dca - dz * dsa, p[1] + dr, p[2] + df * dsa + dz * dca) : (p, df = 0, dr = 0, dz = 0) => S(p[0] + df, p[1] + dr, p[2] + dz);\n4337\t  }\n4338\t  /** draw into g with (ox, oy) = projected position of the rig's root */\n4339\t  draw(g, ox, oy, view) {\n4340\t    this._pitch = view.pitchDeg;\n4341\t    if (this.o.charView !== false) view = charView(view);\n4342\t    if (view.id !== 'portrait') this.lastView = view;   // drawSmear projects the trail with the same view\n4343\t    // cheated 3/4 pose: in side-ish views turn the body partly toward the camera, like hand-drawn sprites\n4344\t    const st = clamp(1 - view.pitchDeg / 45, 0, 1), camA = Math.atan2(view.fy, view.fx);\n4345\t    this._camSide = Math.cos(camA - this.facing - Math.PI / 2) >= 0 ? 1 : -1;   // which hand the camera sees\n4346\t    this._cheat = st > 0 && this.o.cheat ? clamp(angDiff(this.facing, camA), -this.o.cheat, this.o.cheat) * st : 0;\n4347\t    if (this.o.style === 'classic') this._drawClassic(g, ox, oy, view); else this._drawHD(g, ox, oy, view);\n4348\t  }\n4349\t  /**\n4350\t   * HD style: volumetric limbs, shaped torso, outfits, hair styles, hands and boots, each shaded with\n4351\t   * hue-shifted tones and a light from the upper left (the look of hand-drawn PS1 / N64 era sprites).\n4352\t   */\n4353\t  _drawHD(g, ox, oy, view) {\n4354\t    const o = this.o, C = this.C, J = this.J, sz = o.size, sc = view.scale * sz, ops = this._ops || (this._ops = []);\n4355\t    ops.length = 0;\n4356\t    const an = this.facing + this.spin + this._cheat, ca = Math.cos(an), sa = Math.sin(an), k = (1 - this.sq * .4) * sz, kz = (1 + this.sq) * sz;\n4357\t    const vax = view.ax, vay = view.ay, vbx = view.bx, vby = view.by, vbz = view.bz, vdx = view.dx, vdy = view.dy, vdz = view.dz;\n4358\t    const S = (f, r, z) => { const wx = (f * ca - r * sa) * k, wy = (f * sa + r * ca) * k, wz = z * kz; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n4359\t    const Sp = this._offsets(S);   // details around a joint (face, hair, belt, toes) turn with the body\n4360\t    const Q = {};\n4361\t    for (const key of JOINT_KEYS) Q[key] = Sp(J[key]);\n4362\t    const lq = (A, B, t) => [A[0] + (B[0] - A[0]) * t, A[1] + (B[1] - A[1]) * t, A[2] + (B[2] - A[2]) * t];\n4363\t    const dC = (Q.hipC[2] + Q.shC[2]) * .5, u = sc, lw = o.limbW / 2;   // u: screen pixels per world unit, lw: limb thickness from the build\n4364\t    // a capsule between projected points A and B with screen radii ra, rb (dx, dy shift it)\n4365\t    const cap = (A, B, ra, rb, col, dx = 0, dy = 0) => {\n4366\t      const ax = A[0] + dx, ay = A[1] + dy, bx = B[0] + dx, by = B[1] + dy, vx = bx - ax, vy = by - ay, L = Math.hypot(vx, vy);\n4367\t      if (ra < .75 && rb < .75) { px.line(g, ax, ay, bx, by, col, 1); return; }\n4368\t      if (L > .01) { const nx = -vy / L, ny = vx / L; px.poly(g, [[ax + nx * ra, ay + ny * ra], [bx + nx * rb, by + ny * rb], [bx - nx * rb, by - ny * rb], [ax - nx * ra, ay - ny * ra]], col); }\n4369\t      px.disc(g, ax, ay, Math.max(0, ra - .35), col); px.disc(g, bx, by, Math.max(0, rb - .35), col);\n4370\t    };\n4371\t    // shaded capsule: dark silhouette, base shifted toward the light, highlight along the lit edge\n4372\t    const limb = (A, B, ra, rb, c, far, bias = 0) => {\n4373\t      const t = tones(c), dk = far ? t.deep : t.sh, base = far ? t.sh : t.base, lt = far ? t.base : t.lt;\n4374\t      ops.push({ d: (A[2] + B[2]) * .5 + bias, f: () => {\n4375\t        cap(A, B, ra, rb, dk);\n4376\t        cap(A, B, Math.max(.45, ra - .7), Math.max(.45, rb - .7), base, -.6, -.6);\n4377\t        if (ra > 1.5 && !far) { const vx = B[0] - A[0], vy = B[1] - A[1], L = Math.hypot(vx, vy) || 1; let nx = -vy / L, ny = vx / L; if (nx * -.6 + ny * -.8 < 0) { nx = -nx; ny = -ny; } const off = ra - 1.1; px.line(g, A[0] + vx * .2 + nx * off, A[1] + vy * .2 + ny * off, A[0] + vx * .75 + nx * off, A[1] + vy * .75 + ny * off, lt); }\n4378\t      } });\n4379\t    };\n4380\t    // shaded polygon: dark shape, then a slightly inset copy shifted toward the light\n4381\t    const inset = (pts, d) => { let cx = 0, cy = 0; for (const p of pts) { cx += p[0]; cy += p[1]; } cx /= pts.length; cy /= pts.length; return pts.map(p => { const vx = p[0] - cx, vy = p[1] - cy, l = Math.hypot(vx, vy) || 1, m = Math.max(0, l - d) / l; return [cx + vx * m - .6, cy + vy * m - .6]; }); };\n4382\t    const slab = (pts, c, far) => { const t = tones(c); px.poly(g, pts, far ? t.deep : t.sh); px.poly(g, inset(pts, 1.1), far ? t.sh : t.base); };\n4383\t    const W = s => (s > 0 ? 1 : -1);\n4384\t    // ---- legs and boots ----\n4385\t    for (const s of [-1, 1]) {\n4386\t      const hip = s > 0 ? Q.hipR : Q.hipL, knee = s > 0 ? Q.kneeR : Q.kneeL, foot = s > 0 ? Q.footR : Q.footL, far = knee[2] < dC;\n4387\t      const ank = lq(knee, foot, .62), toe = Sp(s > 0 ? J.footR : J.footL, 1.9, 0, .3);\n4388\t      limb(hip, knee, 1.45 * u * lw, 1.2 * u * lw, C.pants, far);\n4389\t      limb(knee, ank, 1.2 * u * lw, 1.05 * u * lw, C.pants, far, .001);\n4390\t      limb(ank, foot, 1.15 * u * lw, 1.05 * u * lw, C.boot, far, .002);\n4391\t      limb(foot, toe, 1.0 * u * lw, .85 * u * lw, C.boot, far, .003);\n4392\t    }\n4393\t    // ---- outfit below the belt: tunic / robe / coat ----\n4394\t    const out = o.outfit, hz = Math.max(J.hipL[2], J.hipR[2]) + .9;\n4395\t    if (out === 'tunic' || out === 'robe' || out === 'coat') {\n4396\t      const len = out === 'robe' ? hz - .6 : out === 'coat' ? hz * .62 : hz * .42, fl = out === 'robe' ? 1.55 : 1.3, dep = o.torsoW * .7;\n4397\t      const tail = out === 'coat' ? -1.2 - 2.2 * Math.min(1, this._spW) : 0, fwd = this._atkW * .3;\n4398\t      const lat = [Sp([J.hipC[0], -o.hipHalf * 1.25, hz]), Sp([J.hipC[0], o.hipHalf * 1.25, hz]), Sp([J.hipC[0] + tail * .5 + fwd, o.hipHalf * 1.25 * fl, hz - len]), Sp([J.hipC[0] + tail * .5 + fwd, -o.hipHalf * 1.25 * fl, hz - len])];\n4399\t      const sag = [Sp([J.hipC[0] + dep, 0, hz]), Sp([J.hipC[0] + (out === 'coat' ? dep * .3 : dep * fl) + fwd, 0, hz - len * (out === 'coat' ? .45 : 1)]), Sp([J.hipC[0] - dep * fl + tail, 0, hz - len]), Sp([J.hipC[0] - dep, 0, hz])];\n4400\t      const cc = out === 'coat' ? (C.coat || C.cloth) : C.cloth, trim = C.trim || (out === 'coat' ? shade(cc, -.35) : C.belt);\n4401\t      ops.push({ d: Q.hipC[2] + .05, f: () => {\n4402\t        slab(lat, cc, false); slab(sag, cc, false);\n4403\t        const t = tones(trim); px.line(g, lat[2][0], lat[2][1], lat[3][0], lat[3][1], t.base, Math.max(1, Math.round(u * .6)));\n4404\t      } });\n4405\t    }\n4406\t    // ---- torso: a shaped front plate plus a core for depth, belt, seam, armor ----\n4407\t    const shL = Sp(J.shL, 0, -.4, 0), shR = Sp(J.shR, 0, .4, 0), hL = Sp(J.hipL, 0, -.25, .5), hR = Sp(J.hipR, 0, .25, .5);\n4408\t    const wL = lq(Sp(J.hipL, 0, -.2, 0), shL, .5), wR = lq(Sp(J.hipR, 0, .2, 0), shR, .5), core0 = Sp(J.hipC, 0, 0, .8), core1 = Sp(J.shC, 0, 0, -.4);\n4409\t    const facingCam = S(2, 0, 6)[2] > S(0, 0, 6)[2];\n4410\t    if (o.skeleton) ops.push({ d: dC, f: () => {   // rib cage cut by dark gaps (reads in every view), a bare spine, pelvis and collarbones\n4411\t      const b = tones(C.skin), rib0 = Sp(J.shC, .2, 0, -.7), rib1 = lq(Sp(J.shC, .3, 0, -.7), Sp(J.hipC, .2, 0, 1), .55), gap = '#1a1018';\n4412\t      cap(core0, rib1, .32 * u, .32 * u, b.sh); px.line(g, core0[0] - .5, core0[1], rib1[0] - .5, rib1[1], b.base);   // spine below the ribs\n4413\t      const pl = Sp(J.hipL, 0, -.2, .9), pr = Sp(J.hipR, 0, .2, .9); cap(pl, pr, .75 * u, .75 * u, b.sh); cap(pl, pr, Math.max(.4, .75 * u - .8), Math.max(.4, .75 * u - .8), b.base, -.5, -.5);\n4414\t      const rw = o.torsoW * .8 * u, rb = o.torsoW * .55 * u;\n4415\t      cap(rib0, rib1, rw, rb, b.sh); cap(rib0, rib1, Math.max(.5, rw - .9), Math.max(.5, rb - .9), b.base, -.5, -.5);\n4416\t      const len = rib1[1] - rib0[1];\n4417\t      for (let i = 1; i <= 3; i++) {   // horizontal gaps between the ribs\n4418\t        const y = Math.round(rib0[1] + len * (i / 4) + rw * .25), half = Math.max(1, (rw - (rw - rb) * i / 4) - 1.2), cx0 = lerp(rib0[0], rib1[0], i / 4);\n4419\t        px.rect(g, cx0 - half, y, half * 2, 1, gap); px.rect(g, cx0 - half, y - 1, half * 2, 1, b.lt);\n4420\t      }\n4421\t      if (facingCam) { const s0 = Sp(J.shC, 1, 0, -.9), s1 = lq(Sp(J.shC, 1, 0, -.9), rib1, .8); px.line(g, s0[0], s0[1], s1[0], s1[1], b.hi); }   // sternum\n4422\t      px.line(g, shL[0], shL[1], shR[0], shR[1], b.base, Math.max(1, Math.round(u * .5)));\n4423\t    } });\n4424\t    else ops.push({ d: dC, f: () => {\n4425\t      const t = tones(C.cloth), plate = [shL, shR, [wR[0] - .3, wR[1]], hR, hL, [wL[0] + .3, wL[1]]];\n4426\t      px.poly(g, plate, t.sh); cap(core0, core1, o.torsoW * .62 * u, o.torsoW * .72 * u, t.sh);\n4427\t      px.poly(g, inset(plate, 1.1), t.base); cap(core0, core1, Math.max(.5, o.torsoW * .62 * u - .9), Math.max(.5, o.torsoW * .72 * u - .9), t.base, -.6, -.6);\n4428\t      if (facingCam) { const n0 = Sp(J.shC, .9, 0, -.8), n1 = Sp(J.hipC, 1.1, 0, 1.4); px.line(g, n0[0], n0[1], n1[0], n1[1], t.sh); const c0 = Sp(J.shC, .7, -.9, -.2), c1 = Sp(J.shC, 1.1, 0, -1.3), c2 = Sp(J.shC, .7, .9, -.2); px.line(g, c0[0], c0[1], c1[0], c1[1], tones(C.trim || C.clothLt).base); px.line(g, c1[0], c1[1], c2[0], c2[1], tones(C.trim || C.clothLt).base); }\n4429\t      else { const n0 = Sp(J.shC, .3, 0, -.6), n1 = Sp(J.hipC, .3, 0, 1.6); px.line(g, n0[0], n0[1], n1[0], n1[1], t.lt); }\n4430\t      const bl = Sp(J.hipL, 0, -.3, .7), br = Sp(J.hipR, 0, .3, .7), bt = tones(C.belt);\n4431\t      px.line(g, bl[0], bl[1], br[0], br[1], bt.sh, Math.max(1, Math.round(u * .7))); px.line(g, bl[0], bl[1] - 1, br[0], br[1] - 1, bt.base);\n4432\t      if (facingCam) { const bk = Sp(J.hipC, 1.1, 0, .7); px.rect(g, bk[0] - 1, bk[1] - 1, 2, 2, bt.hi); }\n4433\t      if (o.armor) { const m = tones(C.plate || C.metal); const p0 = Sp(J.shC, .5, 0, -1), p1 = Sp(J.hipC, .5, 0, 3.2); cap(p0, p1, o.torsoW * .5 * u, o.torsoW * .4 * u, m.sh); cap(p0, p1, o.torsoW * .5 * u - 1, o.torsoW * .4 * u - 1, m.base, -.6, -.6); px.dot(g, p0[0] - 1, p0[1] + 1, m.hi); }\n4434\t    } });\n4435\t    // ---- cape: cloth strip with folds ----\n4436\t    if (this.capeL) {\n4437\t      const L = this.capeL, R = this.capeR, x0 = this.x, y0 = this.y, z0 = this.z, ct = tones(C.cape), it = tones(C.capeIn), capeAway = Math.cos(an - Math.atan2(view.fy, view.fx)) < -.3;\n4438\t      const PW = n => { const wx = n.x - x0, wy = n.y - y0, wz = n.z - z0; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n4439\t      for (let i = 0; i < L.length - 1; i++) {\n4440\t        const q = [PW(L[i]), PW(R[i]), PW(R[i + 1]), PW(L[i + 1])], last = i === L.length - 2;\n4441\t        ops.push({ d: capeAway ? (q[0][2] + q[2][2]) / 2 - .6 : Math.min((q[0][2] + q[2][2]) / 2 - .6, dC - .05), f: () => {\n4442\t          let ar = 0; for (let m = 0; m < 4; m++) { const A = q[m], B = q[(m + 1) % 4]; ar += A[0] * B[1] - B[0] * A[1]; }\n4443\t          const front = ar > 0, t = front ? ct : it;\n4444\t          px.poly(g, q, front ? (i % 2 ? t.base : t.lt) : (i % 2 ? t.sh : t.deep));\n4445\t          px.line(g, q[0][0], q[0][1], q[3][0], q[3][1], front ? t.sh : t.deep);\n4446\t          if (last) px.line(g, q[2][0], q[2][1], q[3][0], q[3][1], tones(C.trim || C.belt).base);\n4447\t        } });\n4448\t      }\n4449\t    }\n4450\t    // ---- flowing hair (long / ponytail) ----\n4451\t    if (this._hairPts) {\n4452\t      const P = this._hairPts, x0 = this.x, y0 = this.y, z0 = this.z, ht = tones(C.hair), w0 = (this.o.hair.style === 'ponytail' ? .9 : 1.5) * u;\n4453\t      const PW = n => { const wx = n.x - x0, wy = n.y - y0, wz = n.z - z0; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n4454\t      const pts = P.map(PW);\n4455\t      for (let i = 0; i < pts.length - 1; i++) { const r0 = w0 * (1 - i / pts.length * .75), r1 = w0 * (1 - (i + 1) / pts.length * .75); ops.push({ d: (pts[i][2] + pts[i + 1][2]) / 2 - .4, f: () => { cap(pts[i], pts[i + 1], r0, r1, ht.sh); cap(pts[i], pts[i + 1], Math.max(.4, r0 - .8), Math.max(.4, r1 - .8), i % 2 ? ht.base : ht.lt, -.5, -.5); } }); }\n4456\t    }\n4457\t    // ---- head: face, hair, eyes, hats ----\n4458\t    const neck0 = Sp(J.shC, 0, 0, -.2), neck1 = Sp(J.head, 0, 0, -o.headR * .6);\n4459\t    limb(neck0, neck1, .75 * u, .75 * u, C.skin, false, -.01);\n4460\t    ops.push({ d: Q.head[2], f: () => {\n4461\t      // head in layers: hair mass behind, a face set slightly forward, a hair cap with bangs, then eyes, brows and mouth\n4462\t      const R = o.headR, r = R * u * .93, st = tones(C.skin), ht = tones(C.hair), hs = o.hair.style;\n4463\t      const H = Sp(J.head, R * .1, 0, -R * .05), back = Sp(J.head, -R * .42, 0, R * .18), cap = Sp(J.head, -R * .2, 0, R * .74);\n4464\t      const disc2 = (P0, rad, t, far) => { px.disc(g, P0[0], P0[1], rad, far ? t.deep : t.sh); px.disc(g, P0[0] - .6, P0[1] - .6, Math.max(.5, rad - 1), far ? t.sh : t.base); };\n4465\t      if (o.skeleton) {   // skull: cranium, jaw, dark sockets with glowing eyes, nose hole and teeth\n4466\t        const bt = tones(C.skin), jaw = Sp(J.head, R * .45, 0, -R * .78), gap = '#1a1018';\n4467\t        disc2(jaw, r * .5, bt, false); disc2(H, r * .86, bt, false);\n4468\t        if (r > 2.5) px.dot(g, H[0] - r * .4, H[1] - r * .45, bt.lt);\n4469\t        const t0 = Sp(J.head, R * .72, -R * .34, -R * .5), t1 = Sp(J.head, R * .72, R * .34, -R * .5);   // tooth row: a dark gap with white teeth\n4470\t        if ((t0[2] + t1[2]) / 2 > H[2] - .2) { px.line(g, t0[0], t0[1], t1[0], t1[1], gap, Math.max(1, Math.round(u * .6))); if (u > 1.3) for (let k = 0; k <= 4; k += 2) { const q = lq(t0, t1, k / 4); px.dot(g, q[0], q[1], bt.hi); } }\n4471\t        for (const sd of [-1, 1]) {\n4472\t          const E2 = Sp(J.head, R * .78, sd * R * .4, -R * .02); if (E2[2] <= H[2] + .1) continue;\n4473\t          const br = Sp(J.head, R * .82, sd * R * .4, R * .3); px.line(g, br[0] - r * .3, br[1], br[0] + r * .3, br[1], bt.sh);   // brow ridge\n4474\t          px.disc(g, E2[0], E2[1], Math.max(1, r * .38), gap); if (o.eyeGlow) { px.glow(g, 1); px.dot(g, E2[0], E2[1], o.eyeGlow); }\n4475\t          const ck = Sp(J.head, R * .7, sd * R * .5, -R * .4); if (u > 1.5) px.dot(g, ck[0], ck[1], bt.sh);   // cheek hollow\n4476\t        }\n4477\t        const ns = Sp(J.head, R * .92, 0, -R * .28);\n4478\t        if (ns[2] > H[2]) px.rect(g, ns[0], ns[1], 1, Math.max(1, Math.round(u * .6)), gap);\n4479\t        if (o.hat) this._hat(g, Sp, J, r, H);\n4480\t        return;\n4481\t      }\n4482\t      const bald = hs === 'bald', hairBehind = back[2] < H[2];\n4483\t      if (!bald && hairBehind) disc2(back, r * .98, ht, false);\n4484\t      disc2(H, r * .9, st, false);\n4485\t      if (r > 2.5) px.dot(g, H[0] - r * .45, H[1] - r * .4, st.lt);\n4486\t      // ears on the side that faces the camera\n4487\t      if (hs !== 'long' && !o.hood && r > 2) for (const sd of [-1, 1]) { const ear = Sp(J.head, -R * .05, sd * R * .92, -R * .1); if (ear[2] > H[2] - R * .2) { px.disc(g, ear[0], ear[1], Math.max(.6, r * .2), st.sh); } }\n4488\t      if (!bald) {\n4489\t        if (!hairBehind) disc2(back, r * .98, ht, false);\n4490\t        disc2(cap, r * .7, ht, false);   // the cap stops above the eyes; the fringe (bangs) covers the forehead\n4491\t        const bangs = o.face && o.face.bangs !== undefined ? o.face.bangs : .7, fringe = Sp(J.head, R * .6, 0, R * .56);   // bangs over the forehead (face.bangs 0..1), clear of the eyes\n4492\t        if (bangs > 0 && fringe[2] > H[2]) { const fr = r * .42 * bangs; px.disc(g, fringe[0], fringe[1], fr, ht.sh); px.disc(g, fringe[0] - .5, fringe[1] - .5, Math.max(.4, fr - .8), ht.base); }\n4493\t        if (hs === 'spiky') for (const [df, dr, dz] of [[-1, 0, .7], [-.6, .7, .75], [-.6, -.7, .75], [-.25, .42, 1.02], [-.25, -.42, 1.02], [-1.1, 0, .05]]) {   // spikes sweep up and back\n4494\t          const root = Sp(J.head, df * R * .6, dr * R * .6, dz * R * .6), tip = Sp(J.head, df * R * 1.55, dr * R * 1.55, dz * R * 1.55);\n4495\t          const vx = tip[0] - root[0], vy = tip[1] - root[1], l = Math.hypot(vx, vy) || 1, nx = -vy / l * r * .42, ny = vx / l * r * .42;\n4496\t          px.poly(g, [[root[0] + nx, root[1] + ny], [tip[0], tip[1]], [root[0] - nx, root[1] - ny]], ht.sh); px.poly(g, [[root[0] + nx * .5 - .5, root[1] + ny * .5 - .5], [tip[0] - .5, tip[1] - .5], [root[0] - nx * .2, root[1] - ny * .2]], ht.base);\n4497\t        }\n4498\t        px.dot(g, cap[0] - r * .35, cap[1] - r * .45, ht.hi); px.dot(g, cap[0] - r * .1, cap[1] - r * .55, ht.lt);\n4499\t      }\n4500\t      if (o.hood) { const tp = Sp(J.head, -R * 1.1, 0, R * .9); px.disc(g, tp[0], tp[1], r * .45, ht.base); }\n4501\t      if (o.hat) this._hat(g, Sp, J, r, H);\n4502\t      // face: eyes (with a catch-light when big enough), brows and a mouth, on the side facing the camera\n4503\t      const big = o.face && o.face.eyes === 'big', eh = Math.max(1, Math.round(u * (big ? 1.4 : 1.05))), ew = u > 2.6 || (big && u > 1.8) ? 2 : 1;\n4504\t      for (const sd of [-1, 1]) {\n4505\t        const E2 = Sp(J.head, R * .9, sd * R * .36, -R * .02);\n4506\t        if (E2[2] <= H[2] + .15) continue;\n4507\t        if (o.eyeGlow) { px.glow(g, 1); px.rect(g, E2[0], E2[1], Math.max(1, ew + (u > 1.6 ? 1 : 0)), Math.max(1, eh - 1), o.eyeGlow); continue; }\n4508\t        if (this.blink > 0 && this.hurtW < .5 && this.expr !== 'wince') {\n4509\t          const top = E2[1] - eh + 1;\n4510\t          if (eh >= 2 && u > 1.7) { px.rect(g, E2[0], top, ew, 1, C.eye); px.rect(g, E2[0], top + 1, ew, eh - 1, C.iris || '#3a4a8a'); px.dot(g, E2[0], top + 1, C.eyeWhite || '#ffffff'); }   // lash line, iris, catch-light\n4511\t          else { px.rect(g, E2[0], top, ew, eh, C.eye); if (u > 1.7) px.dot(g, E2[0] + (ew > 1 ? 1 : 0), top, C.eyeWhite || '#ffffff'); }\n4512\t        } else px.rect(g, E2[0] - (ew > 1 ? 1 : 0), E2[1], ew + 1, 1, C.eye);\n4513\t        if (u > 2.2 && !bald) { const b0 = Sp(J.head, R * .9, sd * R * .22, R * .42), b1 = Sp(J.head, R * .86, sd * R * .52, R * .38); px.line(g, b0[0], b0[1] - 2, b1[0], b1[1] - 2, ht.sh); }   // brows on bigger heads, clear of the eyes\n4514\t      }\n4515\t      if (u > 1.9) {   // mouth: expr 'smile' | 'shout' | 'angry' | 'wince', and it moves while the rig talks (Dialog portraits)\n4516\t        const m = Sp(J.head, R * .95, 0, -R * .5), ex = this.expr, open = ex === 'shout' || (this._talk && Math.floor(this.t * 9) % 2 === 0), w = u > 2.6 ? 2 : 1;\n4517\t        if (m[2] > H[2]) {\n4518\t          if (open) px.rect(g, m[0] - (w > 1 ? 1 : 0), m[1] - (ex === 'shout' ? 1 : 0), w + (ex === 'shout' ? 1 : 0), ex === 'shout' ? 3 : 2, '#4a1418');\n4519\t          else if (ex === 'smile') { px.rect(g, m[0] - w, m[1], w * 2 + 1, 1, st.deep); px.dot(g, m[0] - w, m[1] - 1, st.deep); px.dot(g, m[0] + w, m[1] - 1, st.deep); }\n4520\t          else px.rect(g, m[0] - (w > 1 ? 1 : 0), m[1], w, 1, this.hurtW > .3 || ex === 'wince' ? '#6a1a1a' : st.deep);\n4521\t        }\n4522\t        if (ex === 'angry' && u > 1.7) for (const sd of [-1, 1]) { const b0 = Sp(J.head, R * .9, sd * R * .15, R * .3), b1 = Sp(J.head, R * .86, sd * R * .55, R * .45); if (b0[2] > H[2]) px.line(g, b0[0], b0[1] - 1, b1[0], b1[1] - 1, ht.deep); }\n4523\t      }\n4524\t    } });\n4525\t    // ---- arms, hands, shoulder pads ----\n4526\t    for (const s of [-1, 1]) {\n4527\t      const sh = s > 0 ? Q.shR : Q.shL, el = s > 0 ? Q.elbowR : Q.elbowL, hd = s > 0 ? Q.handR : Q.handL, far = el[2] < dC;\n4528\t      const upper = o.sleeves === 'none' ? C.skin : C.cloth, lower = o.sleeves === 'long' ? C.cloth : C.skin;\n4529\t      limb(sh, el, 1.15 * u * lw, 1.0 * u * lw, upper, far);\n4530\t      limb(el, hd, 1.0 * u * lw, .9 * u * lw, lower, far, .001);\n4531\t      const hc = C.glove || C.skin, ht = tones(hc);\n4532\t      ops.push({ d: hd[2] + .02, f: () => { px.disc(g, hd[0], hd[1], Math.max(.6, .82 * u * lw - .35), far ? ht.deep : ht.sh); px.disc(g, hd[0] - .5, hd[1] - .5, Math.max(.4, .58 * u * lw - .35), far ? ht.sh : ht.base); } });\n4533\t      if (o.armor) { const pad = Sp(s > 0 ? J.shR : J.shL, -.1, s * .3, .5), m = tones(C.plate || C.metal); ops.push({ d: sh[2] + .03, f: () => { px.disc(g, pad[0], pad[1], 1.55 * u, far ? m.deep : m.sh); px.disc(g, pad[0] - .6, pad[1] - .6, Math.max(.5, 1.55 * u - 1), far ? m.sh : m.base); px.dot(g, pad[0] - u * .8, pad[1] - u * .8, m.hi); } }); }\n4534\t    }\n4535\t    // ---- weapons ----\n4536\t    if (o.weapon === 'gun') {\n4537\t      const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, mz = Sp(hd, bd[0] * 5.5, bd[1] * 5.5, bd[2] * 5.5), gp = Sp(hd, -bd[0] * .6, -bd[1] * .6, -bd[2] * .6 - 1.4), m = tones(C.metal);\n4538\t      ops.push({ d: Hn[2] + .03, f: () => { cap(Hn, gp, .8 * u, .7 * u, m.deep); cap(Hn, mz, .95 * u, .75 * u, m.sh); cap(Hn, mz, Math.max(.4, .95 * u - .8), Math.max(.4, .75 * u - .8), m.base, -.5, -.5); px.dot(g, mz[0], mz[1], '#ffffff'); } });\n4539\t    } else if (o.weapon === 'staff') {\n4540\t      const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, top = Sp(hd, bd[0] * 10, bd[1] * 10, bd[2] * 10), bot = Sp(hd, -bd[0] * 7, -bd[1] * 7, -bd[2] * 7), wt = tones(C.staff || '#8a5a32'), ot = tones(C.orb || '#7fe3ff');\n4541\t      ops.push({ d: (Hn[2] + top[2]) / 2, f: () => { cap(bot, top, .6 * u, .6 * u, wt.sh); px.line(g, bot[0] - .5, bot[1] - .5, top[0] - .5, top[1] - .5, wt.lt); px.glow(g, 1); px.disc(g, top[0], top[1], Math.max(1, u * 1.5), ot.sh); px.disc(g, top[0] - .6, top[1] - .6, Math.max(.6, u * 1.5 - 1), ot.base); px.dot(g, top[0] - 1, top[1] - 1, '#ffffff'); } });\n4542\t    }\n4543\t    if (o.weapon === 'sword') {\n4544\t      const hd = J.handR, bd = J.bladeDir, Lb = o.bladeLen, Hn = Q.handR, sl = Math.hypot(bd[0], bd[1]) || 1, gx = -bd[1] / sl * 1.8, gy = bd[0] / sl * 1.8;\n4545\t      const tip = Sp(hd, bd[0] * Lb, bd[1] * Lb, bd[2] * Lb), b0 = Sp(hd, bd[0] * 1.5, bd[1] * 1.5, bd[2] * 1.5), pom = Sp(hd, -bd[0] * 1.5, -bd[1] * 1.5, -bd[2] * 1.5);\n4546\t      const g0 = Sp(hd, bd[0] * 1.5 + gx, bd[1] * 1.5 + gy, bd[2] * 1.5), g1 = Sp(hd, bd[0] * 1.5 - gx, bd[1] * 1.5 - gy, bd[2] * 1.5), m = tones(C.metal), h = tones(C.hilt);\n4547\t      ops.push({ d: (Hn[2] + tip[2]) / 2, f: () => {\n4548\t        const vx = tip[0] - b0[0], vy = tip[1] - b0[1], l = Math.hypot(vx, vy) || 1, nx = -vy / l * Math.max(.7, .65 * u), ny = vx / l * Math.max(.7, .65 * u);\n4549\t        px.poly(g, [[b0[0] + nx, b0[1] + ny], [tip[0], tip[1]], [b0[0] - nx, b0[1] - ny]], m.sh);\n4550\t        px.line(g, b0[0] - nx * .4, b0[1] - ny * .4, tip[0], tip[1], m.hi); px.line(g, b0[0] + nx * .5, b0[1] + ny * .5, tip[0], tip[1], m.base);\n4551\t        px.line(g, pom[0], pom[1], Hn[0], Hn[1], '#5a3620', Math.max(1, Math.round(u * .7)));\n4552\t        cap(g0, g1, .55 * u, .55 * u, h.sh); px.line(g, g0[0] - .5, g0[1] - .5, g1[0] - .5, g1[1] - .5, h.lt);\n4553\t        px.disc(g, pom[0], pom[1], Math.max(.5, .6 * u - .35), h.base); px.dot(g, tip[0], tip[1], '#ffffff');\n4554\t      } });\n4555\t    }\n4556\t    ops.sort((a, b) => a.d - b.d);\n4557\t    for (const op of ops) op.f();\n4558\t  }\n4559\t  /** classic style: thin stick limbs (cheapest; good for huge crowds) */\n4560\t  _drawClassic(g, ox, oy, view) {\n4561\t    const o = this.o, C = this.C, J = this.J, sc = view.scale * o.size, ops = this._ops || (this._ops = []);\n4562\t    ops.length = 0;\n4563\t    // local (f, r, z) -> [screen x, screen y, depth], with facing, spin and squash applied\n4564\t    const an = this.facing + this.spin + this._cheat, ca = Math.cos(an), sa = Math.sin(an), k = (1 - this.sq * .4) * o.size, kz = (1 + this.sq) * o.size;\n4565\t    const vax = view.ax, vay = view.ay, vbx = view.bx, vby = view.by, vbz = view.bz, vdx = view.dx, vdy = view.dy, vdz = view.dz;\n4566\t    const S = (f, r, z) => { const wx = (f * ca - r * sa) * k, wy = (f * sa + r * ca) * k, wz = z * kz; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n4567\t    const Sp = this._offsets(S);   // details around a joint (face, hair, belt, toes) turn with the body\n4568\t    const Q = {};\n4569\t    for (const key of JOINT_KEYS) Q[key] = Sp(J[key]);\n4570\t    const lq = (A, B, t) => [A[0] + (B[0] - A[0]) * t, A[1] + (B[1] - A[1]) * t, A[2] + (B[2] - A[2]) * t];\n4571\t    const lw = Math.max(1, Math.round(o.limbW * sc * .75)), tw = Math.max(2, Math.round(o.torsoW * sc * .9));\n4572\t    const dC = (Q.hipC[2] + Q.shC[2]) * .5;\n4573\t    const seg = (A, B, c, w) => ops.push({ d: (A[2] + B[2]) * .5, f: () => px.line(g, A[0], A[1], B[0], B[1], c, w) });\n4574\t    for (const s of [-1, 1]) {\n4575\t      const hip = s > 0 ? Q.hipR : Q.hipL, knee = s > 0 ? Q.kneeR : Q.kneeL, foot = s > 0 ? Q.footR : Q.footL;\n4576\t      const far = knee[2] < dC, pc = far ? C.pantsDk : C.pants, bc = far ? C.bootDk : C.boot, ank = lq(knee, foot, .55), toe = Sp(s > 0 ? J.footR : J.footL, .8, 0, 0);\n4577\t      seg(hip, knee, pc, lw); seg(knee, ank, pc, lw); seg(ank, foot, bc, lw);\n4578\t      ops.push({ d: foot[2] + .01, f: () => px.rect(g, toe[0] - 1, toe[1] - 1, 2, 2, bc) });\n4579\t    }\n4580\t    ops.push({\n4581\t      d: dC, f: () => {\n4582\t        const a = Q.shL, b = Q.shR, h = Q.hipC, sh = Q.shC;\n4583\t        px.poly(g, [a, b, Q.hipR, Q.hipL], C.cloth);\n4584\t        px.line(g, h[0], h[1], sh[0], sh[1], C.cloth, tw);\n4585\t        px.line(g, a[0], a[1], b[0], b[1], C.cloth, 2);\n4586\t        const bl = Sp(J.hipL, 0, 0, .6), br = Sp(J.hipR, 0, 0, .6); px.line(g, bl[0], bl[1], br[0], br[1], C.belt);\n4587\t        if (S(2, 0, 6)[2] > S(0, 0, 6)[2]) { const n0 = Sp(J.shC, .6, 0, -.3), n1 = Sp(J.hipC, .9, 0, 2); px.line(g, n0[0], n0[1], n1[0], n1[1], C.clothLt); }\n4588\t      }\n4589\t    });\n4590\t    if (this.capeL) {\n4591\t      const L = this.capeL, R = this.capeR, x0 = this.x, y0 = this.y, z0 = this.z;\n4592\t      const PW = n => { const wx = n.x - x0, wy = n.y - y0, wz = n.z - z0; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n4593\t      for (let i = 0; i < L.length - 1; i++) {\n4594\t        const q = [PW(L[i]), PW(R[i]), PW(R[i + 1]), PW(L[i + 1])];\n4595\t        ops.push({ d: (q[0][2] + q[2][2]) / 2 - .6, f: () => { let ar = 0; for (let m = 0; m < 4; m++) { const A = q[m], B = q[(m + 1) % 4]; ar += A[0] * B[1] - B[0] * A[1]; } px.poly(g, q, ar > 0 ? C.cape : C.capeIn); } });\n4596\t      }\n4597\t    }\n4598\t    ops.push({\n4599\t      d: Q.head[2], f: () => {\n4600\t        const H = Q.head, r = o.headR * sc * .9;\n4601\t        px.disc(g, H[0], H[1], r, C.skin);\n4602\t        const hc = Sp(J.head, -.95, 0, .95); px.disc(g, hc[0], hc[1], r * (o.hood ? 1.05 : .95), C.hair);\n4603\t        if (o.hood) { const tp = Sp(J.head, -o.headR * 1.1, 0, o.headR * .9); px.disc(g, tp[0], tp[1], r * .45, C.hair); }\n4604\t        if (o.hat) this._hat(g, Sp, J, r, H);\n4605\t        for (const s of [-1, 1]) {\n4606\t          const E2 = Sp(J.head, o.headR * .82, s * 1.25, .2);\n4607\t          if (E2[2] > H[2] + .3) { if (o.eyeGlow) px.rect(g, E2[0], E2[1], 1, 1, o.eyeGlow); else if (this.blink > 0 && this.hurtW < .5) px.rect(g, E2[0], E2[1] - (sc > 1.45 ? 1 : 0), 1, sc > 1.45 ? 2 : 1, C.eye); else px.dot(g, E2[0], E2[1], C.eye); }\n4608\t        }\n4609\t      }\n4610\t    });\n4611\t    for (const s of [-1, 1]) {\n4612\t      const sh = s > 0 ? Q.shR : Q.shL, el = s > 0 ? Q.elbowR : Q.elbowL, hd = s > 0 ? Q.handR : Q.handL, far = el[2] < dC;\n4613\t      seg(sh, el, far ? C.clothDk : C.cloth, lw); seg(el, hd, far ? C.skinDk : C.skin, lw);\n4614\t      ops.push({ d: hd[2] + .02, f: () => px.rect(g, hd[0] - 1, hd[1] - 1, 2, 2, far ? C.skinDk : C.skin) });\n4615\t    }\n4616\t    if (o.weapon === 'gun') {\n4617\t      const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, mz = Sp(hd, bd[0] * 5, bd[1] * 5, bd[2] * 5), gp = Sp(hd, -bd[0] * .6, -bd[1] * .6, -bd[2] * .6 - 1.2);\n4618\t      ops.push({ d: Hn[2] + .03, f: () => { px.line(g, Hn[0], Hn[1], gp[0], gp[1], C.metalDk, 2); px.line(g, gp[0], gp[1], mz[0], mz[1], C.metalDk, 2); px.line(g, Hn[0], Hn[1] - 1, mz[0], mz[1] - 1, C.metal); px.dot(g, mz[0], mz[1], '#ffffff'); } });\n4619\t    } else if (o.weapon === 'staff') {\n4620\t      const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, top = Sp(hd, bd[0] * 10, bd[1] * 10, bd[2] * 10), bot = Sp(hd, -bd[0] * 7, -bd[1] * 7, -bd[2] * 7);\n4621\t      ops.push({ d: (Hn[2] + top[2]) / 2, f: () => { px.line(g, bot[0], bot[1], top[0], top[1], C.staff || '#8a5a32', Math.max(1, Math.round(sc * .9))); px.glow(g, 1); px.disc(g, top[0], top[1], Math.max(1, sc * 1.4), C.orb || '#7fe3ff'); px.dot(g, top[0] - 1, top[1] - 1, '#ffffff'); } });\n4622\t    }\n4623\t    if (o.weapon === 'sword') {\n4624\t      const hd = J.handR, bd = J.bladeDir, L = o.bladeLen, Hn = Q.handR, sl = Math.hypot(bd[0], bd[1]) || 1, sx = -bd[1] / sl * 1.6, sy = bd[0] / sl * 1.6;\n4625\t      const tip = Sp(hd, bd[0] * L, bd[1] * L, bd[2] * L), b0 = Sp(hd, bd[0] * 1.4, bd[1] * 1.4, bd[2] * 1.4), pom = Sp(hd, -bd[0] * 1.2, -bd[1] * 1.2, -bd[2] * 1.2);\n4626\t      const g0 = Sp(hd, bd[0] * 1.4 + sx, bd[1] * 1.4 + sy, bd[2] * 1.4), g1 = Sp(hd, bd[0] * 1.4 - sx, bd[1] * 1.4 - sy, bd[2] * 1.4);\n4627\t      ops.push({\n4628\t        d: (Hn[2] + tip[2]) / 2, f: () => {\n4629\t          px.line(g, pom[0], pom[1], Hn[0], Hn[1], '#5a3620'); px.line(g, g0[0], g0[1], g1[0], g1[1], C.hilt);\n4630\t          px.line(g, b0[0] + 1, b0[1], tip[0], tip[1], C.metalDk); px.line(g, b0[0], b0[1], tip[0], tip[1], C.metal); px.dot(g, tip[0], tip[1], '#ffffff');\n4631\t        }\n4632\t      });\n4633\t    }\n4634\t    ops.sort((a, b) => a.d - b.d);\n4635\t    for (const op of ops) op.f();\n4636\t  }\n4637\t  _hat(g, Sp, J, r, H) {\n4638\t    const h = this.o.hat, st = h.style || 'cap', c = h.color || '#d83a2a', R = this.o.headR, dk = shade(c, -.3);\n4639\t    if (st === 'cap') {            // plumber / baseball cap with a brim facing forward\n4640\t      const t = Sp(J.head, -.4, 0, R * .55), b = Sp(J.head, R * 1.05, 0, R * .25), b2 = Sp(J.head, R * 1.7, 0, R * .1);\n4641\t      px.disc(g, t[0], t[1], r * .92, c); px.line(g, b[0], b[1], b2[0], b2[1], dk, 2);\n4642\t    } else if (st === 'pointed') { // elf / wizard cap flopping backward (two triangles so it reads from the side and the front)\n4643\t      const a = Sp(J.head, R * .2, -R * .95, R * .45), b = Sp(J.head, R * .2, R * .95, R * .45), f = Sp(J.head, R * .75, 0, R * .5), k = Sp(J.head, -R * .9, 0, R * .25), tip = Sp(J.head, -R * 2.3, 0, R * 1.6);\n4644\t      px.poly(g, [f, k, tip], c); px.poly(g, [a, b, tip], c); px.line(g, a[0], a[1], b[0], b[1], dk); px.line(g, f[0], f[1], k[0], k[1], dk);\n4645\t    } else if (st === 'helmet') {  // robot / knight helmet that leaves the face open\n4646\t      const t = Sp(J.head, -.8, 0, .6), cr = Sp(J.head, 0, 0, R * 1.05);\n4647\t      px.disc(g, t[0], t[1], r * 1.02, c); px.disc(g, cr[0], cr[1], Math.max(1, r * .28), shade(c, .35));\n4648\t      const f = Sp(J.head, R * .75, 0, -.2); px.disc(g, f[0], f[1], r * .55, this.C.skin);\n4649\t    } else if (st === 'band') {    // headband around the forehead with two tails\n4650\t      const a = Sp(J.head, R * .6, -R * .9, R * .55), b = Sp(J.head, R * .6, R * .9, R * .55), f = Sp(J.head, R * .95, 0, R * .5), k = Sp(J.head, -R * .95, 0, R * .5), t2 = Sp(J.head, -R * 2.2, -.6, -.4), t3 = Sp(J.head, -R * 2, .6, -1.2);\n4651\t      px.line(g, a[0], a[1], b[0], b[1], c, 2); px.line(g, f[0], f[1], k[0], k[1], c, 2); px.line(g, k[0], k[1], t2[0], t2[1], c); px.line(g, k[0], k[1], t3[0], t3[1], c);\n4652\t    } else if (st === 'crown') {\n4653\t      for (const k of [-1, 0, 1]) { const p = Sp(J.head, 0, k * R * .6, R * .9), q = Sp(J.head, 0, k * R * .6, R * 1.6); px.line(g, p[0], p[1], q[0], q[1], c, 2); }\n4654\t      const a = Sp(J.head, 0, -R * .8, R * .85), b = Sp(J.head, 0, R * .8, R * .85); px.line(g, a[0], a[1], b[0], b[1], c, 2);\n4655\t    }\n4656\t    void H;\n4657\t  }\n4658\t  /** motion smear for the current swing, queued in front of the rig */\n4659\t  drawSmear(r, colors = ['#ffffff', '#dff8ff', '#8fe0f2', '#4bb1d4']) {\n4660\t    const T = this.trail;\n4661\t    if (T.length >= 2) {   // ribbon along the real blade path: correct in side, top-down and every other view\n4662\t      r.queue(this.x, this.y, this.z + 1, g => {\n4663\t        const lv = this.lastView, cv = lv && lv.id === r.view.id ? lv : this.o.charView !== false ? charView(r.view) : r.view;   // the angle the rig was drawn from\n4664\t        const W = cv === r.view ? (p, w) => r.w(w[0], w[1], w[2]) : (p, w) => { const s = r.w(p.o[0], p.o[1], p.o[2]), q = cv.p(w[0] - p.o[0], w[1] - p.o[1], w[2] - p.o[2]); return [s[0] + q[0], s[1] + q[1]]; };\n4665\t        px.glow(g, .85);\n4666\t        const n = T.length - 1, taper = (p, u) => V3.lerp(p.t, p.b, .25 + .75 * u);   // older samples are narrower\n4667\t        for (let i = 0; i < n; i++) {\n4668\t          const p0 = T[i], p1 = T[i + 1], f = 1 - p1.age / .14, u0 = i / n, u1 = (i + 1) / n;\n4669\t          const pts = [W(p0, taper(p0, u0)), W(p0, p0.t), W(p1, p1.t), W(p1, taper(p1, u1))];\n4670\t          px.polyDither(g, pts, colors[u1 > .85 ? 1 : u1 > .55 ? 2 : 3], (.35 + .65 * u1) * f, r.ix, r.iy);\n4671\t        }\n4672\t        // hot core: a bright line along the tip path, strongest at the newest end\n4673\t        const last = T[n];\n4674\t        if (last.w >= 1) {   // blades get a hot core line and a glint at the tip while the swing is fresh; fists and feet just the ribbon\n4675\t          for (let i = Math.max(0, n - 5); i < n; i++) { const [ax, ay] = W(T[i], T[i].t), [bx, by] = W(T[i + 1], T[i + 1].t); px.line(g, ax, ay, bx, by, i >= n - 2 ? colors[0] : colors[1], i >= n - 1 ? 2 : 1); }\n4676\t          if (last.age < .06) { const [tx, ty] = W(last, last.t); px.dot(g, tx, ty, '#ffffff'); }\n4677\t        }\n4678\t      }, { bias: .6, emissive: true });\n4679\t      return;\n4680\t    }\n4681\t    const s = this._smear; if (!s || s.fade <= 0 || r.view.pitchDeg < 30) return;\n4682\t    const x = this.x, y = this.y, z = this.z + s.z, span = s.a1 - s.a0;\n4683\t    if (Math.abs(span) < .05) return;\n4684\t    r.queue(x, y, this.z + 1, g => {\n4685\t      px.glow(g, .85);\n4686\t      const n = Math.max(4, Math.ceil(Math.abs(span) / .16));\n4687\t      for (let i = 0; i < n; i++) {\n4688\t        const u0 = i / n, u1 = (i + 1) / n, a0 = s.a0 + span * u0, a1 = s.a0 + span * u1;\n4689\t        const rin0 = s.r1 - (s.r1 - s.r0) * (.2 + .8 * u0), rin1 = s.r1 - (s.r1 - s.r0) * (.2 + .8 * u1);\n4690\t        const pts = [r.w(x + Math.cos(a0) * s.r1, y + Math.sin(a0) * s.r1, z), r.w(x + Math.cos(a1) * s.r1, y + Math.sin(a1) * s.r1, z), r.w(x + Math.cos(a1) * rin1, y + Math.sin(a1) * rin1, z), r.w(x + Math.cos(a0) * rin0, y + Math.sin(a0) * rin0, z)];\n4691\t        const c = colors[u1 > .85 ? 0 : u1 > .6 ? 1 : u1 > .3 ? 2 : 3];"}]},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"559cfa2e-14dd-4734-b78d-5f30a2e5196c","timestamp":"2026-11-04T05:58:06.117Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/engine/my-3d2dge.js","content":"  /**\n   * Sp(joint, f, r, z): a detail drawn around a joint (the face, hair, belt, toes) at offsets in the body's own frame,\n   * projected by S. A knocked-down body turns them backward with it. While a motion clip plays (Mocap.drive sets\n   * mocapTilt: the clip's body and head frames, 3x3, columns forward, right, up) they lean, roll and turn upside down with\n   * the body, and the face with the head; the weapon hand's offsets (the blade) are already in the rig's frame.\n   */\n  _offsets(S) {\n    const J = this.J, T = this.mocapTilt;\n    if (T) return (p, df = 0, dr = 0, dz = 0) => {\n      if (p === J.handR) return S(p[0] + df, p[1] + dr, p[2] + dz);\n      const m = p === J.head ? T.head : T.body;\n      return S(p[0] + m[0] * df + m[1] * dr + m[2] * dz, p[1] + m[3] * df + m[4] * dr + m[5] * dz, p[2] + m[6] * df + m[7] * dr + m[8] * dz);\n    };\n    const dA = (this.downW || 0) * Math.PI / 2 * .96, dca = Math.cos(dA), dsa = Math.sin(dA);\n    return dA ? (p, df = 0, dr = 0, dz = 0) => S(p[0] + df * dca - dz * dsa, p[1] + dr, p[2] + df * dsa + dz * dca) : (p, df = 0, dr = 0, dz = 0) => S(p[0] + df, p[1] + dr, p[2] + dz);\n  }\n  /** draw into g with (ox, oy) = projected position of the rig's root */\n  draw(g, ox, oy, view) {\n    this._pitch = view.pitchDeg;\n    if (this.o.charView !== false) view = charView(view);\n    if (view.id !== 'portrait') this.lastView = view;   // drawSmear projects the trail with the same view\n    // cheated 3/4 pose: in side-ish views turn the body partly toward the camera, like hand-drawn sprites\n    const st = clamp(1 - view.pitchDeg / 45, 0, 1), camA = Math.atan2(view.fy, view.fx);\n    this._camSide = Math.cos(camA - this.facing - Math.PI / 2) >= 0 ? 1 : -1;   // which hand the camera sees\n    this._cheat = st > 0 && this.o.cheat ? clamp(angDiff(this.facing, camA), -this.o.cheat, this.o.cheat) * st : 0;\n    if (this.o.style === 'classic') this._drawClassic(g, ox, oy, view); else this._drawHD(g, ox, oy, view);\n  }\n  /**\n   * HD style: volumetric limbs, shaped torso, outfits, hair styles, hands and boots, each shaded with\n   * hue-shifted tones and a light from the upper left (the look of hand-drawn PS1 / N64 era sprites).\n   */\n  _drawHD(g, ox, oy, view) {\n    const o = this.o, C = this.C, J = this.J, sz = o.size, sc = view.scale * sz, ops = this._ops || (this._ops = []);\n    ops.length = 0;\n    const an = this.facing + this.spin + this._cheat, ca = Math.cos(an), sa = Math.sin(an), k = (1 - this.sq * .4) * sz, kz = (1 + this.sq) * sz;\n    const vax = view.ax, vay = view.ay, vbx = view.bx, vby = view.by, vbz = view.bz, vdx = view.dx, vdy = view.dy, vdz = view.dz;\n    const S = (f, r, z) => { const wx = (f * ca - r * sa) * k, wy = (f * sa + r * ca) * k, wz = z * kz; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n    const Sp = this._offsets(S);   // details around a joint (face, hair, belt, toes) turn with the body\n    const Q = {};\n    for (const key of JOINT_KEYS) Q[key] = Sp(J[key]);\n    const lq = (A, B, t) => [A[0] + (B[0] - A[0]) * t, A[1] + (B[1] - A[1]) * t, A[2] + (B[2] - A[2]) * t];\n    const dC = (Q.hipC[2] + Q.shC[2]) * .5, u = sc, lw = o.limbW / 2;   // u: screen pixels per world unit, lw: limb thickness from the build\n    // a capsule between projected points A and B with screen radii ra, rb (dx, dy shift it)\n    const cap = (A, B, ra, rb, col, dx = 0, dy = 0) => {\n      const ax = A[0] + dx, ay = A[1] + dy, bx = B[0] + dx, by = B[1] + dy, vx = bx - ax, vy = by - ay, L = Math.hypot(vx, vy);\n      if (ra < .75 && rb < .75) { px.line(g, ax, ay, bx, by, col, 1); return; }\n      if (L > .01) { const nx = -vy / L, ny = vx / L; px.poly(g, [[ax + nx * ra, ay + ny * ra], [bx + nx * rb, by + ny * rb], [bx - nx * rb, by - ny * rb], [ax - nx * ra, ay - ny * ra]], col); }\n      px.disc(g, ax, ay, Math.max(0, ra - .35), col); px.disc(g, bx, by, Math.max(0, rb - .35), col);\n    };\n    // shaded capsule: dark silhouette, base shifted toward the light, highlight along the lit edge\n    const limb = (A, B, ra, rb, c, far, bias = 0) => {\n      const t = tones(c), dk = far ? t.deep : t.sh, base = far ? t.sh : t.base, lt = far ? t.base : t.lt;\n      ops.push({ d: (A[2] + B[2]) * .5 + bias, f: () => {\n        cap(A, B, ra, rb, dk);\n        cap(A, B, Math.max(.45, ra - .7), Math.max(.45, rb - .7), base, -.6, -.6);\n        if (ra > 1.5 && !far) { const vx = B[0] - A[0], vy = B[1] - A[1], L = Math.hypot(vx, vy) || 1; let nx = -vy / L, ny = vx / L; if (nx * -.6 + ny * -.8 < 0) { nx = -nx; ny = -ny; } const off = ra - 1.1; px.line(g, A[0] + vx * .2 + nx * off, A[1] + vy * .2 + ny * off, A[0] + vx * .75 + nx * off, A[1] + vy * .75 + ny * off, lt); }\n      } });\n    };\n    // shaded polygon: dark shape, then a slightly inset copy shifted toward the light\n    const inset = (pts, d) => { let cx = 0, cy = 0; for (const p of pts) { cx += p[0]; cy += p[1]; } cx /= pts.length; cy /= pts.length; return pts.map(p => { const vx = p[0] - cx, vy = p[1] - cy, l = Math.hypot(vx, vy) || 1, m = Math.max(0, l - d) / l; return [cx + vx * m - .6, cy + vy * m - .6]; }); };\n    const slab = (pts, c, far) => { const t = tones(c); px.poly(g, pts, far ? t.deep : t.sh); px.poly(g, inset(pts, 1.1), far ? t.sh : t.base); };\n    const W = s => (s > 0 ? 1 : -1);\n    // ---- legs and boots ----\n    for (const s of [-1, 1]) {\n      const hip = s > 0 ? Q.hipR : Q.hipL, knee = s > 0 ? Q.kneeR : Q.kneeL, foot = s > 0 ? Q.footR : Q.footL, far = knee[2] < dC;\n      const ank = lq(knee, foot, .62), toe = Sp(s > 0 ? J.footR : J.footL, 1.9, 0, .3);\n      limb(hip, knee, 1.45 * u * lw, 1.2 * u * lw, C.pants, far);\n      limb(knee, ank, 1.2 * u * lw, 1.05 * u * lw, C.pants, far, .001);\n      limb(ank, foot, 1.15 * u * lw, 1.05 * u * lw, C.boot, far, .002);\n      limb(foot, toe, 1.0 * u * lw, .85 * u * lw, C.boot, far, .003);\n    }\n    // ---- outfit below the belt: tunic / robe / coat ----\n    const out = o.outfit, hz = Math.max(J.hipL[2], J.hipR[2]) + .9;\n    if (out === 'tunic' || out === 'robe' || out === 'coat') {\n      const len = out === 'robe' ? hz - .6 : out === 'coat' ? hz * .62 : hz * .42, fl = out === 'robe' ? 1.55 : 1.3, dep = o.torsoW * .7;\n      const tail = out === 'coat' ? -1.2 - 2.2 * Math.min(1, this._spW) : 0, fwd = this._atkW * .3;\n      const lat = [Sp([J.hipC[0], -o.hipHalf * 1.25, hz]), Sp([J.hipC[0], o.hipHalf * 1.25, hz]), Sp([J.hipC[0] + tail * .5 + fwd, o.hipHalf * 1.25 * fl, hz - len]), Sp([J.hipC[0] + tail * .5 + fwd, -o.hipHalf * 1.25 * fl, hz - len])];\n      const sag = [Sp([J.hipC[0] + dep, 0, hz]), Sp([J.hipC[0] + (out === 'coat' ? dep * .3 : dep * fl) + fwd, 0, hz - len * (out === 'coat' ? .45 : 1)]), Sp([J.hipC[0] - dep * fl + tail, 0, hz - len]), Sp([J.hipC[0] - dep, 0, hz])];\n      const cc = out === 'coat' ? (C.coat || C.cloth) : C.cloth, trim = C.trim || (out === 'coat' ? shade(cc, -.35) : C.belt);\n      ops.push({ d: Q.hipC[2] + .05, f: () => {\n        slab(lat, cc, false); slab(sag, cc, false);\n        const t = tones(trim); px.line(g, lat[2][0], lat[2][1], lat[3][0], lat[3][1], t.base, Math.max(1, Math.round(u * .6)));\n      } });\n    }\n    // ---- torso: a shaped front plate plus a core for depth, belt, seam, armor ----\n    const shL = Sp(J.shL, 0, -.4, 0), shR = Sp(J.shR, 0, .4, 0), hL = Sp(J.hipL, 0, -.25, .5), hR = Sp(J.hipR, 0, .25, .5);\n    const wL = lq(Sp(J.hipL, 0, -.2, 0), shL, .5), wR = lq(Sp(J.hipR, 0, .2, 0), shR, .5), core0 = Sp(J.hipC, 0, 0, .8), core1 = Sp(J.shC, 0, 0, -.4);\n    const facingCam = S(2, 0, 6)[2] > S(0, 0, 6)[2];\n    if (o.skeleton) ops.push({ d: dC, f: () => {   // rib cage cut by dark gaps (reads in every view), a bare spine, pelvis and collarbones\n      const b = tones(C.skin), rib0 = Sp(J.shC, .2, 0, -.7), rib1 = lq(Sp(J.shC, .3, 0, -.7), Sp(J.hipC, .2, 0, 1), .55), gap = '#1a1018';\n      cap(core0, rib1, .32 * u, .32 * u, b.sh); px.line(g, core0[0] - .5, core0[1], rib1[0] - .5, rib1[1], b.base);   // spine below the ribs\n      const pl = Sp(J.hipL, 0, -.2, .9), pr = Sp(J.hipR, 0, .2, .9); cap(pl, pr, .75 * u, .75 * u, b.sh); cap(pl, pr, Math.max(.4, .75 * u - .8), Math.max(.4, .75 * u - .8), b.base, -.5, -.5);\n      const rw = o.torsoW * .8 * u, rb = o.torsoW * .55 * u;\n      cap(rib0, rib1, rw, rb, b.sh); cap(rib0, rib1, Math.max(.5, rw - .9), Math.max(.5, rb - .9), b.base, -.5, -.5);\n      const len = rib1[1] - rib0[1];\n      for (let i = 1; i <= 3; i++) {   // horizontal gaps between the ribs\n        const y = Math.round(rib0[1] + len * (i / 4) + rw * .25), half = Math.max(1, (rw - (rw - rb) * i / 4) - 1.2), cx0 = lerp(rib0[0], rib1[0], i / 4);\n        px.rect(g, cx0 - half, y, half * 2, 1, gap); px.rect(g, cx0 - half, y - 1, half * 2, 1, b.lt);\n      }\n      if (facingCam) { const s0 = Sp(J.shC, 1, 0, -.9), s1 = lq(Sp(J.shC, 1, 0, -.9), rib1, .8); px.line(g, s0[0], s0[1], s1[0], s1[1], b.hi); }   // sternum\n      px.line(g, shL[0], shL[1], shR[0], shR[1], b.base, Math.max(1, Math.round(u * .5)));\n    } });\n    else ops.push({ d: dC, f: () => {\n      const t = tones(C.cloth), plate = [shL, shR, [wR[0] - .3, wR[1]], hR, hL, [wL[0] + .3, wL[1]]];\n      px.poly(g, plate, t.sh); cap(core0, core1, o.torsoW * .62 * u, o.torsoW * .72 * u, t.sh);\n      px.poly(g, inset(plate, 1.1), t.base); cap(core0, core1, Math.max(.5, o.torsoW * .62 * u - .9), Math.max(.5, o.torsoW * .72 * u - .9), t.base, -.6, -.6);\n      if (facingCam) { const n0 = Sp(J.shC, .9, 0, -.8), n1 = Sp(J.hipC, 1.1, 0, 1.4); px.line(g, n0[0], n0[1], n1[0], n1[1], t.sh); const c0 = Sp(J.shC, .7, -.9, -.2), c1 = Sp(J.shC, 1.1, 0, -1.3), c2 = Sp(J.shC, .7, .9, -.2); px.line(g, c0[0], c0[1], c1[0], c1[1], tones(C.trim || C.clothLt).base); px.line(g, c1[0], c1[1], c2[0], c2[1], tones(C.trim || C.clothLt).base); }\n      else { const n0 = Sp(J.shC, .3, 0, -.6), n1 = Sp(J.hipC, .3, 0, 1.6); px.line(g, n0[0], n0[1], n1[0], n1[1], t.lt); }\n      const bl = Sp(J.hipL, 0, -.3, .7), br = Sp(J.hipR, 0, .3, .7), bt = tones(C.belt);\n      px.line(g, bl[0], bl[1], br[0], br[1], bt.sh, Math.max(1, Math.round(u * .7))); px.line(g, bl[0], bl[1] - 1, br[0], br[1] - 1, bt.base);\n      if (facingCam) { const bk = Sp(J.hipC, 1.1, 0, .7); px.rect(g, bk[0] - 1, bk[1] - 1, 2, 2, bt.hi); }\n      if (o.armor) { const m = tones(C.plate || C.metal); const p0 = Sp(J.shC, .5, 0, -1), p1 = Sp(J.hipC, .5, 0, 3.2); cap(p0, p1, o.torsoW * .5 * u, o.torsoW * .4 * u, m.sh); cap(p0, p1, o.torsoW * .5 * u - 1, o.torsoW * .4 * u - 1, m.base, -.6, -.6); px.dot(g, p0[0] - 1, p0[1] + 1, m.hi); }\n    } });\n    // ---- cape: cloth strip with folds ----\n    if (this.capeL) {\n      const L = this.capeL, R = this.capeR, x0 = this.x, y0 = this.y, z0 = this.z, ct = tones(C.cape), it = tones(C.capeIn), capeAway = Math.cos(an - Math.atan2(view.fy, view.fx)) < -.3;\n      const PW = n => { const wx = n.x - x0, wy = n.y - y0, wz = n.z - z0; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n      for (let i = 0; i < L.length - 1; i++) {\n        const q = [PW(L[i]), PW(R[i]), PW(R[i + 1]), PW(L[i + 1])], last = i === L.length - 2;\n        ops.push({ d: capeAway ? (q[0][2] + q[2][2]) / 2 - .6 : Math.min((q[0][2] + q[2][2]) / 2 - .6, dC - .05), f: () => {\n          let ar = 0; for (let m = 0; m < 4; m++) { const A = q[m], B = q[(m + 1) % 4]; ar += A[0] * B[1] - B[0] * A[1]; }\n          const front = ar > 0, t = front ? ct : it;\n          px.poly(g, q, front ? (i % 2 ? t.base : t.lt) : (i % 2 ? t.sh : t.deep));\n          px.line(g, q[0][0], q[0][1], q[3][0], q[3][1], front ? t.sh : t.deep);\n          if (last) px.line(g, q[2][0], q[2][1], q[3][0], q[3][1], tones(C.trim || C.belt).base);\n        } });\n      }\n    }\n    // ---- flowing hair (long / ponytail) ----\n    if (this._hairPts) {\n      const P = this._hairPts, x0 = this.x, y0 = this.y, z0 = this.z, ht = tones(C.hair), w0 = (this.o.hair.style === 'ponytail' ? .9 : 1.5) * u;\n      const PW = n => { const wx = n.x - x0, wy = n.y - y0, wz = n.z - z0; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n      const pts = P.map(PW);\n      for (let i = 0; i < pts.length - 1; i++) { const r0 = w0 * (1 - i / pts.length * .75), r1 = w0 * (1 - (i + 1) / pts.length * .75); ops.push({ d: (pts[i][2] + pts[i + 1][2]) / 2 - .4, f: () => { cap(pts[i], pts[i + 1], r0, r1, ht.sh); cap(pts[i], pts[i + 1], Math.max(.4, r0 - .8), Math.max(.4, r1 - .8), i % 2 ? ht.base : ht.lt, -.5, -.5); } }); }\n    }\n    // ---- head: face, hair, eyes, hats ----\n    const neck0 = Sp(J.shC, 0, 0, -.2), neck1 = Sp(J.head, 0, 0, -o.headR * .6);\n    limb(neck0, neck1, .75 * u, .75 * u, C.skin, false, -.01);\n    ops.push({ d: Q.head[2], f: () => {\n      // head in layers: hair mass behind, a face set slightly forward, a hair cap with bangs, then eyes, brows and mouth\n      const R = o.headR, r = R * u * .93, st = tones(C.skin), ht = tones(C.hair), hs = o.hair.style;\n      const H = Sp(J.head, R * .1, 0, -R * .05), back = Sp(J.head, -R * .42, 0, R * .18), cap = Sp(J.head, -R * .2, 0, R * .74);\n      const disc2 = (P0, rad, t, far) => { px.disc(g, P0[0], P0[1], rad, far ? t.deep : t.sh); px.disc(g, P0[0] - .6, P0[1] - .6, Math.max(.5, rad - 1), far ? t.sh : t.base); };\n      if (o.skeleton) {   // skull: cranium, jaw, dark sockets with glowing eyes, nose hole and teeth\n        const bt = tones(C.skin), jaw = Sp(J.head, R * .45, 0, -R * .78), gap = '#1a1018';\n        disc2(jaw, r * .5, bt, false); disc2(H, r * .86, bt, false);\n        if (r > 2.5) px.dot(g, H[0] - r * .4, H[1] - r * .45, bt.lt);\n        const t0 = Sp(J.head, R * .72, -R * .34, -R * .5), t1 = Sp(J.head, R * .72, R * .34, -R * .5);   // tooth row: a dark gap with white teeth\n        if ((t0[2] + t1[2]) / 2 > H[2] - .2) { px.line(g, t0[0], t0[1], t1[0], t1[1], gap, Math.max(1, Math.round(u * .6))); if (u > 1.3) for (let k = 0; k <= 4; k += 2) { const q = lq(t0, t1, k / 4); px.dot(g, q[0], q[1], bt.hi); } }\n        for (const sd of [-1, 1]) {\n          const E2 = Sp(J.head, R * .78, sd * R * .4, -R * .02); if (E2[2] <= H[2] + .1) continue;\n          const br = Sp(J.head, R * .82, sd * R * .4, R * .3); px.line(g, br[0] - r * .3, br[1], br[0] + r * .3, br[1], bt.sh);   // brow ridge\n          px.disc(g, E2[0], E2[1], Math.max(1, r * .38), gap); if (o.eyeGlow) { px.glow(g, 1); px.dot(g, E2[0], E2[1], o.eyeGlow); }\n          const ck = Sp(J.head, R * .7, sd * R * .5, -R * .4); if (u > 1.5) px.dot(g, ck[0], ck[1], bt.sh);   // cheek hollow\n        }\n        const ns = Sp(J.head, R * .92, 0, -R * .28);\n        if (ns[2] > H[2]) px.rect(g, ns[0], ns[1], 1, Math.max(1, Math.round(u * .6)), gap);\n        if (o.hat) this._hat(g, Sp, J, r, H);\n        return;\n      }\n      const bald = hs === 'bald', hairBehind = back[2] < H[2];\n      if (!bald && hairBehind) disc2(back, r * .98, ht, false);\n      disc2(H, r * .9, st, false);\n      if (r > 2.5) px.dot(g, H[0] - r * .45, H[1] - r * .4, st.lt);\n      // ears on the side that faces the camera\n      if (hs !== 'long' && !o.hood && r > 2) for (const sd of [-1, 1]) { const ear = Sp(J.head, -R * .05, sd * R * .92, -R * .1); if (ear[2] > H[2] - R * .2) { px.disc(g, ear[0], ear[1], Math.max(.6, r * .2), st.sh); } }\n      if (!bald) {\n        if (!hairBehind) disc2(back, r * .98, ht, false);\n        disc2(cap, r * .7, ht, false);   // the cap stops above the eyes; the fringe (bangs) covers the forehead\n        const bangs = o.face && o.face.bangs !== undefined ? o.face.bangs : .7, fringe = Sp(J.head, R * .6, 0, R * .56);   // bangs over the forehead (face.bangs 0..1), clear of the eyes\n        if (bangs > 0 && fringe[2] > H[2]) { const fr = r * .42 * bangs; px.disc(g, fringe[0], fringe[1], fr, ht.sh); px.disc(g, fringe[0] - .5, fringe[1] - .5, Math.max(.4, fr - .8), ht.base); }\n        if (hs === 'spiky') for (const [df, dr, dz] of [[-1, 0, .7], [-.6, .7, .75], [-.6, -.7, .75], [-.25, .42, 1.02], [-.25, -.42, 1.02], [-1.1, 0, .05]]) {   // spikes sweep up and back\n          const root = Sp(J.head, df * R * .6, dr * R * .6, dz * R * .6), tip = Sp(J.head, df * R * 1.55, dr * R * 1.55, dz * R * 1.55);\n          const vx = tip[0] - root[0], vy = tip[1] - root[1], l = Math.hypot(vx, vy) || 1, nx = -vy / l * r * .42, ny = vx / l * r * .42;\n          px.poly(g, [[root[0] + nx, root[1] + ny], [tip[0], tip[1]], [root[0] - nx, root[1] - ny]], ht.sh); px.poly(g, [[root[0] + nx * .5 - .5, root[1] + ny * .5 - .5], [tip[0] - .5, tip[1] - .5], [root[0] - nx * .2, root[1] - ny * .2]], ht.base);\n        }\n        px.dot(g, cap[0] - r * .35, cap[1] - r * .45, ht.hi); px.dot(g, cap[0] - r * .1, cap[1] - r * .55, ht.lt);\n      }\n      if (o.hood) { const tp = Sp(J.head, -R * 1.1, 0, R * .9); px.disc(g, tp[0], tp[1], r * .45, ht.base); }\n      if (o.hat) this._hat(g, Sp, J, r, H);\n      // face: eyes (with a catch-light when big enough), brows and a mouth, on the side facing the camera\n      const big = o.face && o.face.eyes === 'big', eh = Math.max(1, Math.round(u * (big ? 1.4 : 1.05))), ew = u > 2.6 || (big && u > 1.8) ? 2 : 1;\n      for (const sd of [-1, 1]) {\n        const E2 = Sp(J.head, R * .9, sd * R * .36, -R * .02);\n        if (E2[2] <= H[2] + .15) continue;\n        if (o.eyeGlow) { px.glow(g, 1); px.rect(g, E2[0], E2[1], Math.max(1, ew + (u > 1.6 ? 1 : 0)), Math.max(1, eh - 1), o.eyeGlow); continue; }\n        if (this.blink > 0 && this.hurtW < .5 && this.expr !== 'wince') {\n          const top = E2[1] - eh + 1;\n          if (eh >= 2 && u > 1.7) { px.rect(g, E2[0], top, ew, 1, C.eye); px.rect(g, E2[0], top + 1, ew, eh - 1, C.iris || '#3a4a8a'); px.dot(g, E2[0], top + 1, C.eyeWhite || '#ffffff'); }   // lash line, iris, catch-light\n          else { px.rect(g, E2[0], top, ew, eh, C.eye); if (u > 1.7) px.dot(g, E2[0] + (ew > 1 ? 1 : 0), top, C.eyeWhite || '#ffffff'); }\n        } else px.rect(g, E2[0] - (ew > 1 ? 1 : 0), E2[1], ew + 1, 1, C.eye);\n        if (u > 2.2 && !bald) { const b0 = Sp(J.head, R * .9, sd * R * .22, R * .42), b1 = Sp(J.head, R * .86, sd * R * .52, R * .38); px.line(g, b0[0], b0[1] - 2, b1[0], b1[1] - 2, ht.sh); }   // brows on bigger heads, clear of the eyes\n      }\n      if (u > 1.9) {   // mouth: expr 'smile' | 'shout' | 'angry' | 'wince', and it moves while the rig talks (Dialog portraits)\n        const m = Sp(J.head, R * .95, 0, -R * .5), ex = this.expr, open = ex === 'shout' || (this._talk && Math.floor(this.t * 9) % 2 === 0), w = u > 2.6 ? 2 : 1;\n        if (m[2] > H[2]) {\n          if (open) px.rect(g, m[0] - (w > 1 ? 1 : 0), m[1] - (ex === 'shout' ? 1 : 0), w + (ex === 'shout' ? 1 : 0), ex === 'shout' ? 3 : 2, '#4a1418');\n          else if (ex === 'smile') { px.rect(g, m[0] - w, m[1], w * 2 + 1, 1, st.deep); px.dot(g, m[0] - w, m[1] - 1, st.deep); px.dot(g, m[0] + w, m[1] - 1, st.deep); }\n          else px.rect(g, m[0] - (w > 1 ? 1 : 0), m[1], w, 1, this.hurtW > .3 || ex === 'wince' ? '#6a1a1a' : st.deep);\n        }\n        if (ex === 'angry' && u > 1.7) for (const sd of [-1, 1]) { const b0 = Sp(J.head, R * .9, sd * R * .15, R * .3), b1 = Sp(J.head, R * .86, sd * R * .55, R * .45); if (b0[2] > H[2]) px.line(g, b0[0], b0[1] - 1, b1[0], b1[1] - 1, ht.deep); }\n      }\n    } });\n    // ---- arms, hands, shoulder pads ----\n    for (const s of [-1, 1]) {\n      const sh = s > 0 ? Q.shR : Q.shL, el = s > 0 ? Q.elbowR : Q.elbowL, hd = s > 0 ? Q.handR : Q.handL, far = el[2] < dC;\n      const upper = o.sleeves === 'none' ? C.skin : C.cloth, lower = o.sleeves === 'long' ? C.cloth : C.skin;\n      limb(sh, el, 1.15 * u * lw, 1.0 * u * lw, upper, far);\n      limb(el, hd, 1.0 * u * lw, .9 * u * lw, lower, far, .001);\n      const hc = C.glove || C.skin, ht = tones(hc);\n      ops.push({ d: hd[2] + .02, f: () => { px.disc(g, hd[0], hd[1], Math.max(.6, .82 * u * lw - .35), far ? ht.deep : ht.sh); px.disc(g, hd[0] - .5, hd[1] - .5, Math.max(.4, .58 * u * lw - .35), far ? ht.sh : ht.base); } });\n      if (o.armor) { const pad = Sp(s > 0 ? J.shR : J.shL, -.1, s * .3, .5), m = tones(C.plate || C.metal); ops.push({ d: sh[2] + .03, f: () => { px.disc(g, pad[0], pad[1], 1.55 * u, far ? m.deep : m.sh); px.disc(g, pad[0] - .6, pad[1] - .6, Math.max(.5, 1.55 * u - 1), far ? m.sh : m.base); px.dot(g, pad[0] - u * .8, pad[1] - u * .8, m.hi); } }); }\n    }\n    // ---- weapons ----\n    if (o.weapon === 'gun') {\n      const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, mz = Sp(hd, bd[0] * 5.5, bd[1] * 5.5, bd[2] * 5.5), gp = Sp(hd, -bd[0] * .6, -bd[1] * .6, -bd[2] * .6 - 1.4), m = tones(C.metal);\n      ops.push({ d: Hn[2] + .03, f: () => { cap(Hn, gp, .8 * u, .7 * u, m.deep); cap(Hn, mz, .95 * u, .75 * u, m.sh); cap(Hn, mz, Math.max(.4, .95 * u - .8), Math.max(.4, .75 * u - .8), m.base, -.5, -.5); px.dot(g, mz[0], mz[1], '#ffffff'); } });\n    } else if (o.weapon === 'staff') {\n      const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, top = Sp(hd, bd[0] * 10, bd[1] * 10, bd[2] * 10), bot = Sp(hd, -bd[0] * 7, -bd[1] * 7, -bd[2] * 7), wt = tones(C.staff || '#8a5a32'), ot = tones(C.orb || '#7fe3ff');\n      ops.push({ d: (Hn[2] + top[2]) / 2, f: () => { cap(bot, top, .6 * u, .6 * u, wt.sh); px.line(g, bot[0] - .5, bot[1] - .5, top[0] - .5, top[1] - .5, wt.lt); px.glow(g, 1); px.disc(g, top[0], top[1], Math.max(1, u * 1.5), ot.sh); px.disc(g, top[0] - .6, top[1] - .6, Math.max(.6, u * 1.5 - 1), ot.base); px.dot(g, top[0] - 1, top[1] - 1, '#ffffff'); } });\n    }\n    if (o.weapon === 'sword') {\n      const hd = J.handR, bd = J.bladeDir, Lb = o.bladeLen, Hn = Q.handR, sl = Math.hypot(bd[0], bd[1]) || 1, gx = -bd[1] / sl * 1.8, gy = bd[0] / sl * 1.8;\n      const tip = Sp(hd, bd[0] * Lb, bd[1] * Lb, bd[2] * Lb), b0 = Sp(hd, bd[0] * 1.5, bd[1] * 1.5, bd[2] * 1.5), pom = Sp(hd, -bd[0] * 1.5, -bd[1] * 1.5, -bd[2] * 1.5);\n      const g0 = Sp(hd, bd[0] * 1.5 + gx, bd[1] * 1.5 + gy, bd[2] * 1.5), g1 = Sp(hd, bd[0] * 1.5 - gx, bd[1] * 1.5 - gy, bd[2] * 1.5), m = tones(C.metal), h = tones(C.hilt);\n      ops.push({ d: (Hn[2] + tip[2]) / 2, f: () => {\n        const vx = tip[0] - b0[0], vy = tip[1] - b0[1], l = Math.hypot(vx, vy) || 1, nx = -vy / l * Math.max(.7, .65 * u), ny = vx / l * Math.max(.7, .65 * u);\n        px.poly(g, [[b0[0] + nx, b0[1] + ny], [tip[0], tip[1]], [b0[0] - nx, b0[1] - ny]], m.sh);\n        px.line(g, b0[0] - nx * .4, b0[1] - ny * .4, tip[0], tip[1], m.hi); px.line(g, b0[0] + nx * .5, b0[1] + ny * .5, tip[0], tip[1], m.base);\n        px.line(g, pom[0], pom[1], Hn[0], Hn[1], '#5a3620', Math.max(1, Math.round(u * .7)));\n        cap(g0, g1, .55 * u, .55 * u, h.sh); px.line(g, g0[0] - .5, g0[1] - .5, g1[0] - .5, g1[1] - .5, h.lt);\n        px.disc(g, pom[0], pom[1], Math.max(.5, .6 * u - .35), h.base); px.dot(g, tip[0], tip[1], '#ffffff');\n      } });\n    }\n    ops.sort((a, b) => a.d - b.d);\n    for (const op of ops) op.f();\n  }\n  /** classic style: thin stick limbs (cheapest; good for huge crowds) */\n  _drawClassic(g, ox, oy, view) {\n    const o = this.o, C = this.C, J = this.J, sc = view.scale * o.size, ops = this._ops || (this._ops = []);\n    ops.length = 0;\n    // local (f, r, z) -> [screen x, screen y, depth], with facing, spin and squash applied\n    const an = this.facing + this.spin + this._cheat, ca = Math.cos(an), sa = Math.sin(an), k = (1 - this.sq * .4) * o.size, kz = (1 + this.sq) * o.size;\n    const vax = view.ax, vay = view.ay, vbx = view.bx, vby = view.by, vbz = view.bz, vdx = view.dx, vdy = view.dy, vdz = view.dz;\n    const S = (f, r, z) => { const wx = (f * ca - r * sa) * k, wy = (f * sa + r * ca) * k, wz = z * kz; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n    const Sp = this._offsets(S);   // details around a joint (face, hair, belt, toes) turn with the body\n    const Q = {};\n    for (const key of JOINT_KEYS) Q[key] = Sp(J[key]);\n    const lq = (A, B, t) => [A[0] + (B[0] - A[0]) * t, A[1] + (B[1] - A[1]) * t, A[2] + (B[2] - A[2]) * t];\n    const lw = Math.max(1, Math.round(o.limbW * sc * .75)), tw = Math.max(2, Math.round(o.torsoW * sc * .9));\n    const dC = (Q.hipC[2] + Q.shC[2]) * .5;\n    const seg = (A, B, c, w) => ops.push({ d: (A[2] + B[2]) * .5, f: () => px.line(g, A[0], A[1], B[0], B[1], c, w) });\n    for (const s of [-1, 1]) {\n      const hip = s > 0 ? Q.hipR : Q.hipL, knee = s > 0 ? Q.kneeR : Q.kneeL, foot = s > 0 ? Q.footR : Q.footL;\n      const far = knee[2] < dC, pc = far ? C.pantsDk : C.pants, bc = far ? C.bootDk : C.boot, ank = lq(knee, foot, .55), toe = Sp(s > 0 ? J.footR : J.footL, .8, 0, 0);\n      seg(hip, knee, pc, lw); seg(knee, ank, pc, lw); seg(ank, foot, bc, lw);\n      ops.push({ d: foot[2] + .01, f: () => px.rect(g, toe[0] - 1, toe[1] - 1, 2, 2, bc) });\n    }\n    ops.push({\n      d: dC, f: () => {\n        const a = Q.shL, b = Q.shR, h = Q.hipC, sh = Q.shC;\n        px.poly(g, [a, b, Q.hipR, Q.hipL], C.cloth);\n        px.line(g, h[0], h[1], sh[0], sh[1], C.cloth, tw);\n        px.line(g, a[0], a[1], b[0], b[1], C.cloth, 2);\n        const bl = Sp(J.hipL, 0, 0, .6), br = Sp(J.hipR, 0, 0, .6); px.line(g, bl[0], bl[1], br[0], br[1], C.belt);\n        if (S(2, 0, 6)[2] > S(0, 0, 6)[2]) { const n0 = Sp(J.shC, .6, 0, -.3), n1 = Sp(J.hipC, .9, 0, 2); px.line(g, n0[0], n0[1], n1[0], n1[1], C.clothLt); }\n      }\n    });\n    if (this.capeL) {\n      const L = this.capeL, R = this.capeR, x0 = this.x, y0 = this.y, z0 = this.z;\n      const PW = n => { const wx = n.x - x0, wy = n.y - y0, wz = n.z - z0; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };\n      for (let i = 0; i < L.length - 1; i++) {\n        const q = [PW(L[i]), PW(R[i]), PW(R[i + 1]), PW(L[i + 1])];\n        ops.push({ d: (q[0][2] + q[2][2]) / 2 - .6, f: () => { let ar = 0; for (let m = 0; m < 4; m++) { const A = q[m], B = q[(m + 1) % 4]; ar += A[0] * B[1] - B[0] * A[1]; } px.poly(g, q, ar > 0 ? C.cape : C.capeIn); } });\n      }\n    }\n    ops.push({\n      d: Q.head[2], f: () => {\n        const H = Q.head, r = o.headR * sc * .9;\n        px.disc(g, H[0], H[1], r, C.skin);\n        const hc = Sp(J.head, -.95, 0, .95); px.disc(g, hc[0], hc[1], r * (o.hood ? 1.05 : .95), C.hair);\n        if (o.hood) { const tp = Sp(J.head, -o.headR * 1.1, 0, o.headR * .9); px.disc(g, tp[0], tp[1], r * .45, C.hair); }\n        if (o.hat) this._hat(g, Sp, J, r, H);\n        for (const s of [-1, 1]) {\n          const E2 = Sp(J.head, o.headR * .82, s * 1.25, .2);\n          if (E2[2] > H[2] + .3) { if (o.eyeGlow) px.rect(g, E2[0], E2[1], 1, 1, o.eyeGlow); else if (this.blink > 0 && this.hurtW < .5) px.rect(g, E2[0], E2[1] - (sc > 1.45 ? 1 : 0), 1, sc > 1.45 ? 2 : 1, C.eye); else px.dot(g, E2[0], E2[1], C.eye); }\n        }\n      }\n    });\n    for (const s of [-1, 1]) {\n      const sh = s > 0 ? Q.shR : Q.shL, el = s > 0 ? Q.elbowR : Q.elbowL, hd = s > 0 ? Q.handR : Q.handL, far = el[2] < dC;\n      seg(sh, el, far ? C.clothDk : C.cloth, lw); seg(el, hd, far ? C.skinDk : C.skin, lw);\n      ops.push({ d: hd[2] + .02, f: () => px.rect(g, hd[0] - 1, hd[1] - 1, 2, 2, far ? C.skinDk : C.skin) });\n    }\n    if (o.weapon === 'gun') {\n      const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, mz = Sp(hd, bd[0] * 5, bd[1] * 5, bd[2] * 5), gp = Sp(hd, -bd[0] * .6, -bd[1] * .6, -bd[2] * .6 - 1.2);\n      ops.push({ d: Hn[2] + .03, f: () => { px.line(g, Hn[0], Hn[1], gp[0], gp[1], C.metalDk, 2); px.line(g, gp[0], gp[1], mz[0], mz[1], C.metalDk, 2); px.line(g, Hn[0], Hn[1] - 1, mz[0], mz[1] - 1, C.metal); px.dot(g, mz[0], mz[1], '#ffffff'); } });\n    } else if (o.weapon === 'staff') {\n      const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, top = Sp(hd, bd[0] * 10, bd[1] * 10, bd[2] * 10), bot = Sp(hd, -bd[0] * 7, -bd[1] * 7, -bd[2] * 7);\n      ops.push({ d: (Hn[2] + top[2]) / 2, f: () => { px.line(g, bot[0], bot[1], top[0], top[1], C.staff || '#8a5a32', Math.max(1, Math.round(sc * .9))); px.glow(g, 1); px.disc(g, top[0], top[1], Math.max(1, sc * 1.4), C.orb || '#7fe3ff'); px.dot(g, top[0] - 1, top[1] - 1, '#ffffff'); } });\n    }\n    if (o.weapon === 'sword') {\n      const hd = J.handR, bd = J.bladeDir, L = o.bladeLen, Hn = Q.handR, sl = Math.hypot(bd[0], bd[1]) || 1, sx = -bd[1] / sl * 1.6, sy = bd[0] / sl * 1.6;\n      const tip = Sp(hd, bd[0] * L, bd[1] * L, bd[2] * L), b0 = Sp(hd, bd[0] * 1.4, bd[1] * 1.4, bd[2] * 1.4), pom = Sp(hd, -bd[0] * 1.2, -bd[1] * 1.2, -bd[2] * 1.2);\n      const g0 = Sp(hd, bd[0] * 1.4 + sx, bd[1] * 1.4 + sy, bd[2] * 1.4), g1 = Sp(hd, bd[0] * 1.4 - sx, bd[1] * 1.4 - sy, bd[2] * 1.4);\n      ops.push({\n        d: (Hn[2] + tip[2]) / 2, f: () => {\n          px.line(g, pom[0], pom[1], Hn[0], Hn[1], '#5a3620'); px.line(g, g0[0], g0[1], g1[0], g1[1], C.hilt);\n          px.line(g, b0[0] + 1, b0[1], tip[0], tip[1], C.metalDk); px.line(g, b0[0], b0[1], tip[0], tip[1], C.metal); px.dot(g, tip[0], tip[1], '#ffffff');\n        }\n      });\n    }\n    ops.sort((a, b) => a.d - b.d);\n    for (const op of ops) op.f();\n  }\n  _hat(g, Sp, J, r, H) {\n    const h = this.o.hat, st = h.style || 'cap', c = h.color || '#d83a2a', R = this.o.headR, dk = shade(c, -.3);\n    if (st === 'cap') {            // plumber / baseball cap with a brim facing forward\n      const t = Sp(J.head, -.4, 0, R * .55), b = Sp(J.head, R * 1.05, 0, R * .25), b2 = Sp(J.head, R * 1.7, 0, R * .1);\n      px.disc(g, t[0], t[1], r * .92, c); px.line(g, b[0], b[1], b2[0], b2[1], dk, 2);\n    } else if (st === 'pointed') { // elf / wizard cap flopping backward (two triangles so it reads from the side and the front)\n      const a = Sp(J.head, R * .2, -R * .95, R * .45), b = Sp(J.head, R * .2, R * .95, R * .45), f = Sp(J.head, R * .75, 0, R * .5), k = Sp(J.head, -R * .9, 0, R * .25), tip = Sp(J.head, -R * 2.3, 0, R * 1.6);\n      px.poly(g, [f, k, tip], c); px.poly(g, [a, b, tip], c); px.line(g, a[0], a[1], b[0], b[1], dk); px.line(g, f[0], f[1], k[0], k[1], dk);\n    } else if (st === 'helmet') {  // robot / knight helmet that leaves the face open\n      const t = Sp(J.head, -.8, 0, .6), cr = Sp(J.head, 0, 0, R * 1.05);\n      px.disc(g, t[0], t[1], r * 1.02, c); px.disc(g, cr[0], cr[1], Math.max(1, r * .28), shade(c, .35));\n      const f = Sp(J.head, R * .75, 0, -.2); px.disc(g, f[0], f[1], r * .55, this.C.skin);\n    } else if (st === 'band') {    // headband around the forehead with two tails\n      const a = Sp(J.head, R * .6, -R * .9, R * .55), b = Sp(J.head, R * .6, R * .9, R * .55), f = Sp(J.head, R * .95, 0, R * .5), k = Sp(J.head, -R * .95, 0, R * .5), t2 = Sp(J.head, -R * 2.2, -.6, -.4), t3 = Sp(J.head, -R * 2, .6, -1.2);\n      px.line(g, a[0], a[1], b[0], b[1], c, 2); px.line(g, f[0], f[1], k[0], k[1], c, 2); px.line(g, k[0], k[1], t2[0], t2[1], c); px.line(g, k[0], k[1], t3[0], t3[1], c);\n    } else if (st === 'crown') {\n      for (const k of [-1, 0, 1]) { const p = Sp(J.head, 0, k * R * .6, R * .9), q = Sp(J.head, 0, k * R * .6, R * 1.6); px.line(g, p[0], p[1], q[0], q[1], c, 2); }\n      const a = Sp(J.head, 0, -R * .8, R * .85), b = Sp(J.head, 0, R * .8, R * .85); px.line(g, a[0], a[1], b[0], b[1], c, 2);\n    }\n    void H;\n  }\n  /** motion smear for the current swing, queued in front of the rig */\n  drawSmear(r, colors = ['#ffffff', '#dff8ff', '#8fe0f2', '#4bb1d4']) {\n    const T = this.trail;\n    if (T.length >= 2) {   // ribbon along the real blade path: correct in side, top-down and every other view\n      r.queue(this.x, this.y, this.z + 1, g => {\n        const lv = this.lastView, cv = lv && lv.id === r.view.id ? lv : this.o.charView !== false ? charView(r.view) : r.view;   // the angle the rig was drawn from\n        const W = cv === r.view ? (p, w) => r.w(w[0], w[1], w[2]) : (p, w) => { const s = r.w(p.o[0], p.o[1], p.o[2]), q = cv.p(w[0] - p.o[0], w[1] - p.o[1], w[2] - p.o[2]); return [s[0] + q[0], s[1] + q[1]]; };\n        px.glow(g, .85);\n        const n = T.length - 1, taper = (p, u) => V3.lerp(p.t, p.b, .25 + .75 * u);   // older samples are narrower\n        for (let i = 0; i < n; i++) {\n          const p0 = T[i], p1 = T[i + 1], f = 1 - p1.age / .14, u0 = i / n, u1 = (i + 1) / n;\n          const pts = [W(p0, taper(p0, u0)), W(p0, p0.t), W(p1, p1.t), W(p1, taper(p1, u1))];\n          px.polyDither(g, pts, colors[u1 > .85 ? 1 : u1 > .55 ? 2 : 3], (.35 + .65 * u1) * f, r.ix, r.iy);\n        }\n        // hot core: a bright line along the tip path, strongest at the newest end\n        const last = T[n];\n        if (last.w >= 1) {   // blades get a hot core line and a glint at the tip while the swing is fresh; fists and feet just the ribbon\n          for (let i = Math.max(0, n - 5); i < n; i++) { const [ax, ay] = W(T[i], T[i].t), [bx, by] = W(T[i + 1], T[i + 1].t); px.line(g, ax, ay, bx, by, i >= n - 2 ? colors[0] : colors[1], i >= n - 1 ? 2 : 1); }\n          if (last.age < .06) { const [tx, ty] = W(last, last.t); px.dot(g, tx, ty, '#ffffff'); }\n        }\n      }, { bias: .6, emissive: true });\n      return;\n    }\n    const s = this._smear; if (!s || s.fade <= 0 || r.view.pitchDeg < 30) return;\n    const x = this.x, y = this.y, z = this.z + s.z, span = s.a1 - s.a0;\n    if (Math.abs(span) < .05) return;\n    r.queue(x, y, this.z + 1, g => {\n      px.glow(g, .85);\n      const n = Math.max(4, Math.ceil(Math.abs(span) / .16));\n      for (let i = 0; i < n; i++) {\n        const u0 = i / n, u1 = (i + 1) / n, a0 = s.a0 + span * u0, a1 = s.a0 + span * u1;\n        const rin0 = s.r1 - (s.r1 - s.r0) * (.2 + .8 * u0), rin1 = s.r1 - (s.r1 - s.r0) * (.2 + .8 * u1);\n        const pts = [r.w(x + Math.cos(a0) * s.r1, y + Math.sin(a0) * s.r1, z), r.w(x + Math.cos(a1) * s.r1, y + Math.sin(a1) * s.r1, z), r.w(x + Math.cos(a1) * rin1, y + Math.sin(a1) * rin1, z), r.w(x + Math.cos(a0) * rin0, y + Math.sin(a0) * rin0, z)];\n        const c = colors[u1 > .85 ? 0 : u1 > .6 ? 1 : u1 > .3 ? 2 : 3];","numLines":370,"startLine":4322,"totalLines":14707}},"tool_result_meta":[{"id":"toolu_01SQeF7JUJ8D5u3NQZyHRUAg","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
