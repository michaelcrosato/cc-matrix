 === 1 && (b === 2 || b === 3)) ? 1 : 0; },","+  lame: (x, y, u, t) => (((x + y - Math.floor(t * 18)) % 19) + 19) % 19 === 0 ? 4 : ((x + y) & 1) ? 3 : 0","+};"," class Humanoid {","   /** new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a","    *  character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each"]},{"oldStart":4063,"oldLines":7,"newStart":4103,"newLines":8,"lines":["     // held poses: 'cheer' (item get, victory), 'cast' (both hands forward), 'guard' (fists up), 'kneel', 'crouch', 'wave', 'hips'","     // (hands on hips), and down: 0..1 (knocked flat). stance: 'guard' (fists up while moving) | 'ready' (weapon held forward)","     const pk = this.poseW || (this.poseW = { cheer: 0, cast: 0, guard: 0, kneel: 0, crouch: 0, wave: 0, hips: 0, block: 0 });","-    for (const k in pk) pk[k] = approach(pk[k], s.pose === k ? 1 : 0, dt * 9);","+    for (const k of AOA_POSES) if (pk[k] === undefined) pk[k] = 0;   // AOA: the new held poses","+    for (const k in pk) pk[k] = s.poseW && s.poseW[k] !== undefined ? clamp(s.poseW[k], 0, 1) : approach(pk[k], s.pose === k ? 1 : 0, dt * 9);","     this._stW = approach(this._stW || 0, s.stance === 'guard' ? 1 : 0, dt * 10); this._rdW = approach(this._rdW || 0, s.stance === 'ready' ? 1 : 0, dt * 10);","     this._climbW = approach(this._climbW || 0, s.climb ? 1 : 0, dt * 12); if (s.climb) this._climbP = (this._climbP || 0) + dt * Math.hypot(s.vz || 0, s.vx || 0, s.vy || 0) / (.4 * (o.armUpper + o.armLower) * o.size) * Math.PI;   // hands keep pace with the climb   // climb: hand over hand on a ladder","     this.dieT = s.pose === 'die' ? (this.dieT || 0) + dt : 0;   // pose 'die': a stagger, the knees give, then the body topples"]},{"oldStart":4128,"oldLines":7,"newStart":4169,"newLines":7,"lines":["     this._twist = lerp(this._twist, tTwist, Math.min(1, dt * 25));","     this.solvePose();","     if (o.cape) this._cape(dt);","-    if (o.hair.style === 'long' || o.hair.style === 'ponytail') this._hair(dt);","+    if (o.hair.style === 'long' || o.hair.style === 'ponytail' || o.hair.style === 'braid') this._hair(dt);   // AOA: braid","     if (HOOKS.pose) HOOKS.pose.call(this, dt, s);   // (crawling, swimming, swinging: section 16c)","     if (s.flip > 0 && s.flip < 1) this._roll(s.flip);","     // weapon trail: remember where the blade (or fist, or foot) really went, so the smear works in every view"]},{"oldStart":4148,"oldLines":7,"newStart":4189,"newLines":7,"lines":["   }","   /** long hair and ponytails: a verlet strand that trails behind the head */","   _hair(dt) {","-    const o = this.o, long = o.hair.style === 'long', N = o.hair.len || (long ? 6 : 4), seg = (long ? 1.9 : 1.6) * o.size;","+    const o = this.o, long = o.hair.style === 'long' || o.hair.style === 'braid', N = o.hair.len || (o.hair.style === 'braid' ? 5 : long ? 6 : 4), seg = (long ? 1.9 : 1.6) * o.size;","     const J = this.J, anchor = () => { const w = this._w([J.head[0] - o.headR * .8, 0, J.head[2] + (long ? o.headR * .1 : o.headR * .55)]); return [this.x + w[0], this.y + w[1], this.z + w[2]]; };","     if (!this._hairPts) { const a = anchor(), hx = -Math.cos(this.facing) * .8 * o.size, hy = -Math.sin(this.facing) * .8 * o.size; this._hairPts = Array.from({ length: N }, (_, i) => ({ x: a[0] + hx * i * .3, y: a[1] + hy * i * .3, z: a[2] - i * seg, px: a[0] + hx * i * .3, py: a[1] + hy * i * .3, pz: a[2] - i * seg })); }","     const P = this._hairPts, a = anchor(), damp = Math.pow(.97, dt * 120), fx = Math.cos(this.facing + this.spin), fy = Math.sin(this.facing + this.spin), dt2 = dt * dt;   // trails behind the body's turn"]},{"oldStart":4172,"oldLines":9,"newStart":4213,"newLines":10,"lines":["     const bob = (.5 - Math.abs(Math.cos(ph)) * 1.3) * sp;","     const PW = this.poseW || { cheer: 0, cast: 0, guard: 0, kneel: 0 }, kn = PW.kneel, lg = this.lunge || 0, cw = this._climbW || 0;","     const hw = this._hangW || 0, snk = this._sneakW || 0, spr = (this._sprintW || 0) * sp, ld = this._landW || 0, sk = this._strideK();","-    const cr = Math.max(PW.crouch || 0, this._crouchA || 0, Math.sin(clamp(this.downW || 0, 0, 1) * Math.PI) * .85);   // falling (and getting up) buckles the knees","+    const AR = this.arms && this.arms.w > 0 ? this.arms : null, sit = PW.sit || 0;   // AOA: a timed move's overlay; sitting","+    const cr = Math.max(PW.crouch || 0, this._crouchA || 0, Math.sin(clamp(this.downW || 0, 0, 1) * Math.PI) * .85, (PW.vready || 0) * .35, (PW.bump || 0) * .55, (PW.set || 0) * .2, AR && AR.crouch ? AR.crouch * AR.w : 0);   // falling (and getting up) buckles the knees","     const sway = Math.sin(this.t * 1.15) * .3 * (1 - sp) * (1 - this._atkW);   // idle weight shift from foot to foot","-    const hipC = [mf * .4 * sp - .4 * hurt + lg * .55, mr * .3 * sp + sway, o.hipZ + bob + breathe * .3 - dash * 2.2 - hurt * .6 - kn * o.hipZ * .42 - PW.guard * .9 - cr * o.hipZ * .32 - snk * o.hipZ * .3 - ld * o.hipZ * .42 + (this.hop || 0)];","+    const hipC = [mf * .4 * sp - .4 * hurt + lg * .55 - sit * 1.6, mr * .3 * sp + sway, o.hipZ + bob + breathe * .3 - dash * 2.2 - hurt * .6 - kn * o.hipZ * .42 - PW.guard * .9 - cr * o.hipZ * .32 - snk * o.hipZ * .3 - ld * o.hipZ * .42 - sit * o.hipZ * .44 + (this.hop || 0)];","     J.hipL = add(hipC, rz([0, -o.hipHalf, 0], this._twist * .4)); J.hipR = add(hipC, rz([0, o.hipHalf, 0], this._twist * .4));","     for (const s of [-1, 1]) {","       const p = ph + (s > 0 ? Math.PI : 0), along = Math.sin(p) * o.stride * sp * sk;"]},{"oldStart":4190,"oldLines":16,"newStart":4232,"newLines":18,"lines":["       if (snk > 0) foot[1] += s * .6 * snk;                                                                     // a wider, lower stance","       if (ld > 0) foot = V3.lerp(foot, [s > 0 ? 2.6 : -2.4, s * (o.footSpread + 1), 0], Math.min(1, ld));      // planted wide","       if (hw > 0) foot = V3.lerp(foot, [1.3, s * 1.3, o.hipZ * .08 + (s > 0 ? .8 : 0)], hw);                   // dangling against the wall","+      if (sit > 0) foot = V3.lerp(foot, [o.legUpper * .78, s * 1.9, 0], sit);   // AOA: sitting, knees forward","       if (s > 0 && this._kicking && this._atkW > 0) foot = V3.lerp(foot, [Math.cos(this._theta) * (this.reach + 3), Math.sin(this._theta) * (this.reach + 3), (this._atkRel ? this.atkZ * o.hipZ : this.atkZ) + (this.hop || 0)], this._armW || 0);","       const hip = s > 0 ? J.hipR : J.hipL;","       const [knee, f2] = ik3(hip, foot, o.legUpper, o.legLower, [1, s * .15, .1]);","       J[s > 0 ? 'kneeR' : 'kneeL'] = knee; J[s > 0 ? 'footR' : 'footL'] = f2;","     }","-    const leanF = (o.lean + .16 * sp * mf + .45 * dash + this._atkLean - .35 * hurt + cr * .22 + snk * .34 + spr * .3 + ld * .42) * (1 - hw) + hw * .06, leanR = .1 * sp * mr;","+    const leanF = (o.lean + .16 * sp * mf + .45 * dash + this._atkLean - .35 * hurt + cr * .22 + snk * .34 + spr * .3 + ld * .42 - (PW.stretch || 0) * .18 - (PW.set || 0) * .1 - sit * .08 + (AR && AR.lean ? AR.lean * AR.w : 0)) * (1 - hw) + hw * .06, leanR = .1 * sp * mr;","     const dir = V3.norm([Math.sin(leanF), Math.sin(leanR), Math.cos(leanF)]);","     const shC = add(hipC, V3.mul(dir, o.torso));","     J.hipC = hipC; J.shC = shC;","-    J.shL = add(shC, rz([0, -o.shoulderHalf, 0], this._twist)); J.shR = add(shC, rz([0, o.shoulderHalf, 0], this._twist));","+    const tw = this._twist + (PW.lookback || 0) * .75 + (AR && AR.twist ? AR.twist * AR.w : 0);   // AOA: look back over the shoulder","+    J.shL = add(shC, rz([0, -o.shoulderHalf, 0], tw)); J.shR = add(shC, rz([0, o.shoulderHalf, 0], tw));","     J.head = add(shC, V3.mul(V3.norm([dir[0] + o.hunch * .9, dir[1], dir[2]]), o.neck + o.headR));","     const armLen = o.armUpper + o.armLower, aw = this._armW || 0, sA = this._atkHand === 'L' ? -1 : 1, two = this._atkHand === 'both', fists = !o.weapon || this._stW > .5;","     // where the striking hand goes, and the weapon's direction, for the current attack angle"]},{"oldStart":4225,"oldLines":6,"newStart":4269,"newLines":7,"lines":["       if (snk > 0) hand = V3.lerp(hand, add(sh, [2.2 + along * .3, s * 1.3, -armLen * .6]), snk * .55);       // sneaking: hands low and forward","       if (ld > 0) hand = V3.lerp(hand, s > 0 && this._landK >= 1 ? [3.2, 1.6, .3] : add(sh, [-1.4, s * 3.2, -armLen * .3]), Math.min(1, ld));   // a three-point landing: one hand on the ground, the other back","       if (hw > 0) hand = V3.lerp(hand, add(sh, [2.4, s * .4, clamp((this._hangZ === undefined ? sh[2] + armLen : this._hangZ) - sh[2], 1, armLen * .96)]), hw);   // gripping the edge above","+      hand = aoaHands(this, PW, s, sh, shC, J, armLen, hand);   // AOA: the new held poses","       const wk = this._from && this._windK < 1 ? this._windK : 1, from = wk < 1 ? this._from[s > 0 ? 'R' : 'L'] : null;","       if (aw > 0 && !this._kicking) {","         if (s === sA) hand = V3.lerp(hand, from ? V3.lerp(from, aT, wk) : aT, aw);                // the striking hand"]},{"oldStart":4232,"oldLines":6,"newStart":4277,"newLines":7,"lines":["         else { const offT = fists ? guardAt : add(shC, [1.6, s * 1.6, -1.6]); hand = V3.lerp(hand, from ? V3.lerp(from, offT, wk) : offT, from ? aw : aw * .85); }   // the other hand guards the chin (fists) or pulls back","       }","       if (this._kicking && aw > 0) hand = V3.lerp(hand, add(shC, [1.8, s * 2.2, .6 - (s > 0 ? 1.5 : 0)]), aw * .85);   // arms up for balance during a kick","+      if (AR) { const tg = s > 0 ? AR.R : AR.L; if (tg) hand = V3.lerp(hand, AR.rel ? add(sh, tg) : tg, AR.w * (AR[s > 0 ? 'wR' : 'wL'] === undefined ? 1 : AR[s > 0 ? 'wR' : 'wL'])); }   // AOA: a timed move's hand targets (rig frame, from the feet; rel: from the shoulder)","       const [elbow, h2] = ik3(sh, hand, o.armUpper, o.armLower, [-1, s * .7, -.2]);","       J[s > 0 ? 'elbowR' : 'elbowL'] = elbow; J[s > 0 ? 'handR' : 'handL'] = h2;","     }"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claud