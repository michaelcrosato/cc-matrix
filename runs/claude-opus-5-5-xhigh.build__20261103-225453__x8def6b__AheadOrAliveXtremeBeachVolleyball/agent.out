n) { G.Mocap().drive(this, lib); this._mocapOn = true; }","+        const u = clamp(vb.u || 0, 0, 1), tt = clip.loop ? (this.t || 0) : u * clip.dur;","+        this.mocap = lib.sample(clip, tt); this.mocapW = clamp(vb.w === undefined ? 1 : vb.w, 0, 1); this._clipName = name;","+        this.mocapMask = st && Math.hypot(st.vx || 0, st.vy || 0) > 5 ? 'upper' : null;","+      } else if (this._mocapOn) { this.mocapW = 0; this._clipName = null; }","+      return baseUpdate.call(this, dt, st);","+    };","     const base = rig.solvePose;","     rig.solvePose = function () {","       base.call(this);"]},{"oldStart":1469,"oldLines":8,"newStart":1492,"newLines":8,"lines":[" };"," /** each fighter's signature celebration (1.2 s) */"," G.CELEB = {","-  bow: { move: 'bow', dur: 1.4 }, fistpump: { move: 'fistpump', dur: 1.2, hop: 4 }, nod: { move: 'nod', dur: 1.2, pose: 'hips' }, dance: { move: 'clap', dur: 1.4, hop: 3, sway: 1 },","-  shaka: { move: 'shaka', dur: 1.2 }, backflip: { move: null, dur: 1, flip: true }, cheer2: { move: null, dur: 1.4, pose: 'cheer', hop: 3 }, salute: { move: 'salute', dur: 1.2 }","+  bow: { move: 'bow', dur: 1.4 }, fistpump: { move: 'fistpump', dur: 1.2, hop: 4 }, nod: { move: 'nod', dur: 1.2, pose: 'hips' }, dance: { move: 'dance', dur: 1.6 },","+  shaka: { move: 'shaka', dur: 1.2 }, backflip: { move: 'backflip', dur: 1.4 }, cheer2: { move: 'cheer2', dur: 1.6 }, salute: { move: 'salute', dur: 1.2 }"," };"," /** a small speech bubble over someone's head (\"MINE!\") */"," G.bubble = (r, x, y, z, text, col = '#ffffff') => {"]},{"oldStart":2213,"oldLines":7,"newStart":2236,"newLines":7,"lines":["         if (by === p && (why === 'ace' || why === 'kill' || why === 'block') || (this.over && p === this.mvp())) { const c = G.CELEB[p.cast.celebrate] || G.CELEB.fistpump; p.setAct(c.move || 'cheer', c.dur, { pose: c.pose, hop: c.hop, flip: c.flip, expr: 'smile' }); }","         else if (mate) { p.home = [(p.x + mate.x) / 2 + (p.slot ? 4 : -4), (p.y + mate.y) 