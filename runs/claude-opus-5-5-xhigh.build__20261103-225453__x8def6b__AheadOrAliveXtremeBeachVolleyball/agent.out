{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0179QJTaNBYS1pw4PBJgTjpU","type":"tool_result","content":"Input.DEFAULT = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  attack: ['KeyJ', 'KeyX', 'Mouse0', 'Pad0', 'Pad7'], dash: ['Space', 'ShiftLeft', 'ShiftRight', 'KeyK', 'Pad1', 'Pad6'],\n  skill: ['KeyL', 'KeyE', 'Mouse2', 'Pad2', 'Pad5'], jump: ['KeyZ', 'Pad3'], ...MENU_KEYS\n};\n/** side-scrollers (Mario, Mega Man): Space / Z / K jump, X / J attack or shoot, Shift / C dash */\nInput.PLATFORMER = {\n896:  codeLabel(code) {\n917:    return c ? this.codeLabel(c) : '';\n  codeLabel(code) {\n    if (!code) return '';\n    const L = this._layout && this._layout.get && this._layout.get(code);\n    if (/^Key[A-Z]$/.test(code)) return (L || code.slice(3)).toUpperCase();\n    if (/^Digit\\d$/.test(code)) return L || code.slice(5);\n    if (/^Pad\\d+$/.test(code)) return (PAD_GLYPHS[this.padStyle()] || PAD_GLYPHS.xbox)[+code.slice(3)] || code;\n    return CODE_LABELS[code] || (code.startsWith('Numpad') ? 'Num ' + code.slice(6) : code.startsWith('Act:') ? code.slice(4).toUpperCase() : code);\n  }\n  /** the controller family whose symbols label() shows: glyphs, or with glyphs 'auto' the one its name says */\n  padStyle() {\n    if (this.glyphs && this.glyphs !== 'auto') return this.glyphs;\n    const id = this.padId || '';\n    return /054c|playstation|dualsense|dualshock|wireless controller/i.test(id) ? 'playstation' : /057e|nintendo|pro controller|joy-con/i.test(id) ? 'nintendo' : 'xbox';","is_error":false}]},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"e4736f15-c59d-4874-938b-ec6cc28f326e","timestamp":"2026-11-04T06:06:42.232Z","tool_use_result":{"stdout":"Input.DEFAULT = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  attack: ['KeyJ', 'KeyX', 'Mouse0', 'Pad0', 'Pad7'], dash: ['Space', 'ShiftLeft', 'ShiftRight', 'KeyK', 'Pad1', 'Pad6'],\n  skill: ['KeyL', 'KeyE', 'Mouse2', 'Pad2', 'Pad5'], jump: ['KeyZ', 'Pad3'], ...MENU_KEYS\n};\n/** side-scrollers (Mario, Mega Man): Space / Z / K jump, X / J attack or shoot, Shift / C dash */\nInput.PLATFORMER = {\n896:  codeLabel(code) {\n917:    return c ? this.codeLabel(c) : '';\n  codeLabel(code) {\n    if (!code) return '';\n    const L = this._layout && this._layout.get && this._layout.get(code);\n    if (/^Key[A-Z]$/.test(code)) return (L || code.slice(3)).toUpperCase();\n    if (/^Digit\\d$/.test(code)) return L || code.slice(5);\n    if (/^Pad\\d+$/.test(code)) return (PAD_GLYPHS[this.padStyle()] || PAD_GLYPHS.xbox)[+code.slice(3)] || code;\n    return CODE_LABELS[code] || (code.startsWith('Numpad') ? 'Num ' + code.slice(6) : code.startsWith('Act:') ? code.slice(4).toUpperCase() : code);\n  }\n  /** the controller family whose symbols label() shows: glyphs, or with glyphs 'auto' the one its name says */\n  padStyle() {\n    if (this.glyphs && this.glyphs !== 'auto') return this.glyphs;\n    const id = this.padId || '';\n    return /054c|playstation|dualsense|dualshock|wireless controller/i.test(id) ? 'playstation' : /057e|nintendo|pro controller|joy-con/i.test(id) ? 'nintendo' : 'xbox';","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0179QJTaNBYS1pw4PBJgTjpU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
