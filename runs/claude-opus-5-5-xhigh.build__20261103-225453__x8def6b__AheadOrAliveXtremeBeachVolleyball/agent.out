= 0; if (G.game.rotateView) G.game.rotateView(15); if (A.t > 4 && !A.shot) { A.shot = true; G.sfx('shutter'); A.photo.flash = 1; } }","     if (A.t >= B.len) {","-      if (B.id === 'photo' && A.photo) { G.overlay.remove(A.photo); G.game.timeScale = 1; A.photo = null; A.shot = false; }","+      if (B.id === 'photo' && A.photo) { G.overlay.remove(A.photo); G.popInput(); G.game.timeScale = 1; A.photo = null; A.shot = false; }","       G.nextBeat();","     }","     return false;"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/test/suites/attract.test.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":17,"lines":["+import { load } from '../lib/load.mjs';","+export default function (t) {","+  const { game, G } = load({});","+  game.advance(.5); game.go('title', null, { fade: 0 }); game.advance(.1);","+  game.advance(9.8); t.ok('9.9 s idle stays on the title', !G.attract && game.sceneName === 'title');","+  game.advance(.3); t.ok('10 s idle starts the attract', !!G.attract, String(G.attractT));","+  game.advance(1); t.ok('it plays a match first', game.sceneName === 'match' && G.M && G.M.spectacle);","+  const order = []; let last = null; for (let i = 0; i < 120 * 140; i++) { game.advance(1 / 120); if (G.attract && G.attract.beat !== last) { last = G.attract.beat; order.push(last); } if (order.length >= 9) break; }","+  t.ok('then the montage beats in order', order.join(',').startsWith('match,map,friends,suits,pool,casino,photo,final,card'), order.join(','));","+  t.ok('a demo state, never the save', !G.unlocks.album.length);","+  game.input.tap('confirm'); game.advance(.5); t.ok('any input returns to the title', !G.attract && game.sceneName === 'title');","+  game.advance(.2); t.ok('with the input consumed (no menu opened)', game.sceneName === 'title');","+  // from the menu too, and a mouse move ends it","+  game.go('menu', null, { fade: 0 }); game.advance(10.3); t.ok('the menu idles into it too', !!G.attract);","+  game.input.lastDevice = 'mouse'; game.input.feed('move', 10, 10); game.advance(.05); game.input.feed('move', 40, 40); game.advance(.4); t.ok('a mouse move ends it', !G.attract);","+  t.ok('no errors', !game.errors.length, game.errors.slice(0, 3).map(e => (e.where || '') + ' ' + e.message).join('|'));","+}"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/test/suites/dev.test.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":25,"lines":["+import { load } from '../lib/load.mjs';","+export default function (t) {","+  const { game, G } = load({});","+  game.advance(.3); const T = game.debug.tools;","+  T.match({ seed: 4 }); for (let i = 0; i < 240; i++) game.advance(1 / 120);","+  const items = game.o.menu.items().filter(Boolean).map(x => x[0]);","+  t.ok('the pause menu lists Dev Mode', items.includes('Dev Mode') && items.includes('How to Play'), items.join(','));","+  const now0 = G.M.now; G.devPanel.open(); game.advance(.5); t.ok('opening it freezes time', Math.abs(G.M.now - now0) < .02 && !!G.overlay.get('dev'));","+  const D = G.devPanel.ov; D.tab = 5; const sl = G.devPanel.items(D).find(i => i.tkey === 'ballGravity'); t.ok('the gravity slider is on the Tuning tab', !!sl && sl.x >= 0 && sl.x + sl.w <= game.W);","+  sl.onRight(); sl.onRight(); t.ok('moving a slider changes G.T', G.T.ballGravity === 340);","+  const L1 = G.Ball.make(0, [300, 240, 40], [0, 0, 100]); G.setTuning('ballGravity', 480); const L2 = G.Ball.make(0, [300, 240, 40], [0, 0, 100]);","+  t.ok('and the behavior: more gravity, a shorter flight', L2.tLand < L1.tLand, L1.tLand.toFixed(2) + ' > ' + L2.tLand.toFixed(2));","+  G.resetTuning(); t.ok('Reset all restores the defaults', G.T.ballGravity === 330 && Object.keys(G.tuningChanged()).length === 0);","+  G.devPanel.close(); game.advance(.2); t.ok('closing restores time', G.M.now > now0);","+  T.goto('location', { loc: 'promenade' }); game.advance(.3); t.ok('jump to a location', game.sceneName === 'location' && game.scene.loc === 'promenade');","+  T.goto('poolhop', {}); game.advance(.2); t.ok('jump to a minigame', game.sceneName === 'poolhop');","+  T.setDay(4, 1); t.ok('set the day and slot', G.state.day === 4 && G.state.slot === 1);","+  T.addMoney(10000); T.chips(100); t.ok('money and chips', G.state.money >= 10000 && G.state.chips >= 100);","+  T.fillBag(); t.ok('fill the gift bag', Object.keys(G.state.bag).length === 25);","+  T.slotsForce('7'); T.goto('casino', { station: 'slots' }); game.advance(.1); game.input.tap('confirm'); game.advance(.2); for (const r of ['reel1', 'reel2', 'reel3']) { game.input.tap(r); game.advance(.1); }","+  t.ok('slots: force 7-7-7', game.scene.slot.win && game.scene.slot.win.total >= 100, JSON.stringify(game.scene.slot.win));","+  T.rouletteForce(17); t.ok('roulette: force a number', G.ROULETTE.spin() === 17);","+  t.ok('the snapshot reports the scene', game.debug.snapshot().scene === 'casino');","+  t.ok('no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join('|'));","+}"]}],"created":true}],"moreFiles":1,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-215521__x5b1962/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/build/game.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/src/51-attract.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXt