k])) codes = codes.filter(c => padCode(c) !== (k === 'pad') || FIXED_CODES.has(c)).concat(b[k]);\n      if (a === 'start' || a === 'pause') codes.push('Act:menu');   // (the touch START)\n      if (STICK_CODES[a]) codes.push(STICK_CODES[a]);   // (the gamepad's left stick; the touch stick presses 'Act:' + a)\n      this.map[a] = [...new Set(codes), 'Act:' + a];\n    }\n    this._codes = {}; for (const a in this.map) for (const c of this.map[a]) (this._codes[c] = this._codes[c] || []).push(a);\n    /** preset: the layout last given to use() (E.Input.DEFAULT, PLATFORMER, SHMUP or your own) */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BoUTjKf4hkqypjGgziud1c","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
