f4a3a' }[s], alpha: s === 'calm' ? .14 : .3 }); }","     for (const a of this.all()) a.draw(r);","     if (FD.partner) FD.partner.draw(r, { xray: { color: '#7aa7ff' } });","-    if (!p.hidden) { r.shadow(p.x, p.y, 6, .35); r.actor(p.x, p.y, p.body.z, (g, ox, oy) => p.rig.draw(g, ox, oy, r.view), { xray: { color: '#ffb347', actors: true }, pick: p }); p.scr = r.w(p.x, p.y, 22); p.head = r.w(p.x, p.y, 46); }","+    if (!p.hidden && !p.inCar) { r.shadow(p.x, p.y, 6, .35); r.actor(p.x, p.y, p.body.z, (g, ox, oy) => p.rig.draw(g, ox, oy, r.view), { xray: { color: '#ffb347', actors: true }, pick: p }); p.scr = r.w(p.x, p.y, 22); p.head = r.w(p.x, p.y, 46); }","     if (m.draw) m.draw(FD, r);","     // interactables: a marker on the nearest; hover with the mouse highlights one","     FD.hover = null; const ptr = game.input.pointer && Prompt.dev === 'kbm' ? game.input.pointer() : null;"]},{"oldStart":16817,"oldLines":7,"newStart":16835,"newLines":7,"lines":["   place: '1407 Gaither St', mood: 'dawn', rain: .7, clock: ['05:40', '06:30'], clockRate: .3, music: 'field', start: [31.5, 29], startFacing: Math.PI / 2, civilians: 3, memorial: false,","   setup(F) {","     F.flags.step = 0;","-    const dukes = npc('dukes', 31.4, 38.2, { face: Math.PI }), lou = npc('lou', 30.9, 40.3, { face: Math.PI, pose: 'kneel' }), od = npc('odessa', 33.7, 36.6, { face: Math.PI });","+    const dukes = npc('dukes', 31.4, 38.2, { face: Math.PI }), lou = npc('lou', 31.3, 39.6, { face: Math.PI, pose: 'kneel' }), od = npc('odessa', 33.7, 36.6, { face: Math.PI });","     const pg = npc('pigeon', 35.5, 36.5, { z: 40, face: Math.PI * .8 });","     const cop = npc('cop', 32.6, 42, { id: 'kow', face: -Math.PI / 2 });","     F.interact({ id: 'dukes', at: () => dukes, verb: 'Talk', hint: 'Officer Dukes', when: () => F.flags.step === 0, act: () => Talk.run(["]},{"oldStart":16852,"oldLines":7,"newStart":16870,"newLines":7,"lines":[" function coverInteracts(F) {","   F.interact({ id: 'bench', at: C(42.5, 30.4)