{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghQASuuXaDVTXFdsiuVD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NhNdFwvTRv3ATKxZ3fcvDU","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453; cat > tools/patches/p5c-shorts.py <<'PYEOF'\n# AOA engine patch 5 (h): shorts (o.shorts: 0..1 of the thigh in colors.pants, bare legs below) for any outfit\nimport sys\np = sys.argv[1]; s = open(p).read()\nold = \"      if (SW && !SW.shirt) { const mid = lq(hip, knee, SW.leg); limb(hip, mid, 1.55 * u * lw, 1.45 * u * lw, SW.legC, far);\"\nnew = \"      if ((SW && !SW.shirt) || o.shorts) { const mid = lq(hip, knee, o.shorts || SW.leg); limb(hip, mid, 1.55 * u * lw, 1.45 * u * lw, o.shorts ? C.pants : SW.legC, far);\"\nassert s.count(old) == 1; s = s.replace(old, new)\nopen(p, 'w').write(s)\nPYEOF\npython3 tools/patches/p5c-shorts.py engine/my-3d2dge.js && echo ok","description":"Add shorts option to the Humanoid patch"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8379,"cache_read_input_tokens":386162,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8379},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"17581a11-0b14-472f-ad0c-c1160d954e67","timestamp":"2026-11-04T06:17:59.637Z","request_id":"req_011CghQAScYRGhXJXo68AVG4","wire_tool_inputs":{"toolu_01NhNdFwvTRv3ATKxZ3fcvDU":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453; cat > tools/patches/p5c-shorts.py <<'PYEOF'\n# AOA engine patch 5 (h): shorts (o.shorts: 0..1 of the thigh in colors.pants, bare legs below) for any outfit\nimport sys\np = sys.argv[1]; s = open(p).read()\nold = \"      if (SW && !SW.shirt) { const mid = lq(hip, knee, SW.leg); limb(hip, mid, 1.55 * u * lw, 1.45 * u * lw, SW.legC, far);\"\nnew = \"      if ((SW && !SW.shirt) || o.shorts) { const mid = lq(hip, knee, o.shorts || SW.leg); limb(hip, mid, 1.55 * u * lw, 1.45 * u * lw, o.shorts ? C.pants : SW.legC, far);\"\nassert s.count(old) == 1; s = s.replace(old, new)\nopen(p, 'w').write(s)\nPYEOF\npython3 tools/patches/p5c-shorts.py engine/my-3d2dge.js && echo ok","description":"Add shorts option to the Humanoid patch"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NhNdFwvTRv3ATKxZ3fcvDU","type":"tool_result","content":"ok","is_error":false}]},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"af0277cf-841b-4519-9e18-8924c0628769","timestamp":"2026-11-04T06:18:00.122Z","tool_use_result":{"stdout":"ok","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/engine/my-3d2dge.js","hunks":[{"oldStart":4507,"oldLines":7,"newStart":4507,"newLines":7,"lines":["     for (const s of [-1, 1]) {","       const hip = s > 0 ? Q.hipR : Q.hipL, knee = s > 0 ? Q.kneeR : Q.kneeL, foot = s > 0 ? Q.footR : Q.footL, far = knee[2] < dC;","       const ank = lq(knee, foot, .62), toe = Sp(s > 0 ? J.footR : J.footL, 1.9, 0, .3);","-      if (SW && !SW.shirt) { const mid = lq(hip, knee, SW.leg); limb(hip, mid, 1.55 * u * lw, 1.45 * u * lw, SW.legC, far); limb(mid, knee, 1.4 * u * lw, 1.2 * u * lw, C.skin, far, .0005); limb(knee, ank, 1.2 * u * lw, 1.05 * u * lw, C.skin, far, .001); }   // AOA: bare legs below the suit","+      if ((SW && !SW.shirt) || o.shorts) { const mid = lq(hip, knee, o.shorts || SW.leg); limb(hip, mid, 1.55 * u * lw, 1.45 * u * lw, o.shorts ? C.pants : SW.legC, far); limb(mid, knee, 1.4 * u * lw, 1.2 * u * lw, C.skin, far, .0005); limb(knee, ank, 1.2 * u * lw, 1.05 * u * lw, C.skin, far, .001); }   // AOA: bare legs below the suit","       else { limb(hip, knee, 1.45 * u * lw, 1.2 * u * lw, C.pants, far); limb(knee, ank, 1.2 * u * lw, 1.05 * u * lw, C.pants, far, .001); }","       limb(ank, foot, 1.15 * u * lw, 1.05 * u * lw, C.boot, far, .002);","       limb(foot, toe, 1.0 * u * lw, .85 * u * lw, C.boot, far, .003);"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/tools/patches/p5c-shorts.py","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":7,"lines":["+# AOA engine patch 5 (h): shorts (o.shorts: 0..1 of the thigh in colors.pants, bare legs below) for any outfit","+import sys","+p = sys.argv[1]; s = open(p).read()","+old = \"      if (SW && !SW.shirt) { const mid = lq(hip, knee, SW.leg); limb(hip, mid, 1.55 * u * lw, 1.45 * u * lw, SW.legC, far);\"","+new = \"      if ((SW && !SW.shirt) || o.shorts) { const mid = lq(hip, knee, o.shorts || SW.leg); limb(hip, mid, 1.55 * u * lw, 1.45 * u * lw, o.shorts ? C.pants : SW.legC, far);\"","+assert s.count(old) == 1; s = s.replace(old, new)","+open(p, 'w').write(s)"]}],"created":true}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/engine/my-3d2dge.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/tools/patches/p5c-shorts.py"]}},"tool_result_meta":[{"id":"toolu_01NhNdFwvTRv3ATKxZ3fcvDU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghQD7qmZpaS7Zuz2DxDh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VG6wGNPaZTQinuEj8MaDMR","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/src/13-rigs.js","content":"/* 13-rigs: the rig factory (a cast member in a swimsuit with accessories), the accessory drawers (the engine's extras\n * hook: sunglasses, ribbons, flowers, necklaces, wristbands, chains, whistles, glasses) and portraits. Each match player,\n * NPC and preview owns its own rig: a rig keeps its animation state. */\nconst accDraw = {\n  shades(g, P, c, kind) {\n    if (!c.front) return;\n    const { Sp, J, R, u } = c, L = Sp(J.head, R * .95, -R * .38, R * .02), Rr = Sp(J.head, R * .95, R * .38, R * .02);\n    if (kind === 'heartshades') {\n      for (const e of [L, Rr]) { px.disc(g, e[0], e[1], Math.max(1, u * .9), '#ff5fa2'); px.dot(g, e[0] - .6, e[1] - .6, '#ffd0e8'); }\n      px.line(g, L[0], L[1], Rr[0], Rr[1], '#ff5fa2');\n    } else if (kind === 'aviators') {\n      px.line(g, L[0] - 1, L[1] - 1, Rr[0] + 1, Rr[1] - 1, '#ffd36a');\n      for (const e of [L, Rr]) { px.disc(g, e[0], e[1], Math.max(1, u * .85), '#2a1e10'); px.dot(g, e[0] - .5, e[1] - .6, '#ffd36a'); }\n    } else if (kind === 'glasses') {\n      for (const e of [L, Rr]) { px.rect(g, e[0] - 1, e[1] - 1, 3, 1, '#2a2434'); px.rect(g, e[0] - 1, e[1] + 1, 3, 1, '#2a2434'); }\n    } else {   // wraparound sport shades\n      px.line(g, L[0] - 1.5, L[1], Rr[0] + 1.5, Rr[1], '#20262e', Math.max(2, Math.round(u * 1.1)));\n      px.line(g, L[0] - 1.5, L[1] - 1, Rr[0] + 1.5, Rr[1] - 1, '#e8eef2');\n      px.dot(g, L[0], L[1], '#5a8ac8');\n    }\n  },\n  ribbon(g, P, c, col) { const t = E.tones(col); px.poly(g, [[P[0], P[1]], [P[0] - 3, P[1] - 2], [P[0] - 3, P[1] + 2]], t.base); px.poly(g, [[P[0], P[1]], [P[0] + 3, P[1] - 2], [P[0] + 3, P[1] + 2]], t.sh); px.rect(g, P[0] - 1, P[1] - 1, 2, 2, t.lt); },\n  hibiscus(g, P) { for (let k = 0; k < 5; k++) { const a = k / 5 * TAU; px.disc(g, P[0] + Math.cos(a) * 1.8, P[1] + Math.sin(a) * 1.8, 1.3, k % 2 ? '#e8283a' : '#ff5a5a'); } px.dot(g, P[0], P[1], '#ffd04a'); },\n  necklace(g, P, c) { if (!c.front) return; for (let k = -2; k <= 2; k++) px.dot(g, P[0] + k * 1.5, P[1] + 1 - Math.abs(k) * .5, k % 2 ? '#f8f4e8' : '#e8d8c0'); },\n  chain(g, P, c) { if (!c.front) return; for (let k = -3; k <= 3; k++) px.dot(g, P[0] + k * 1.2, P[1] + 2 - Math.abs(k) * .6, '#ffd36a'); px.rect(g, P[0] - 1, P[1] + 2, 2, 2, '#ffe9a0'); },\n  whistle(g, P, c) { if (!c.front) return; px.line(g, P[0] - 2, P[1] - 1, P[0], P[1] + 3, '#e83a3a'); px.rect(g, P[0] - 1, P[1] + 3, 3, 2, '#c8ccd8'); },\n  band(g, P, c, col) { px.disc(g, P[0], P[1], Math.max(1.2, c.u * .95), E.tones(col).base); px.dot(g, P[0] - .5, P[1] - .5, E.tones(col).lt); }\n};\n/** extras for a list of accessory ids (plus a character's own: Sonny's chain, Bo's whistle, Pepper's glasses) */\nG.accExtras = (accs, accent, own = []) => {\n  const X = [];\n  for (const id of accs) {\n    if (id === 'sportshades' || id === 'heartshades' || id === 'aviators') X.push({ at: 'face', draw: (g, P, c) => accDraw.shades(g, P, c, id) });\n    else if (id === 'ribbon') X.push({ at: 'hair', draw: (g, P, c) => accDraw.ribbon(g, P, c, accent || '#d8303a') });\n    else if (id === 'hibiscus') X.push({ at: 'hair', draw: (g, P) => accDraw.hibiscus(g, P) });\n    else if (id === 'shellnecklace') X.push({ at: 'neck', draw: (g, P, c) => accDraw.necklace(g, P, c) });\n    else if (id === 'wristbands') { X.push({ at: 'wristL', draw: (g, P, c) => accDraw.band(g, P, c, accent || '#ffffff') }); X.push({ at: 'wristR', draw: (g, P, c) => accDraw.band(g, P, c, accent || '#ffffff') }); }\n  }\n  for (const k of own) X.push(k === 'aviators' ? { at: 'face', draw: (g, P, c) => accDraw.shades(g, P, c, 'aviators') } : k === 'glasses' ? { at: 'face', draw: (g, P, c) => accDraw.shades(g, P, c, 'glasses') } : { at: 'neck', draw: (g, P, c) => accDraw[k](g, P, c) });\n  return X;\n};\n/** the hat an accessory list asks for (sweatband, visor, sun hat), or the character's own */\nconst accHat = (accs, cast) => {\n  if (accs.includes('sunhat')) return { style: 'sunhat', color: '#f0d890', band: '#ff5f7a' };\n  if (accs.includes('visor')) return { style: 'visor', color: '#ffffff', brim: cast.color || '#3a6ad8' };\n  if (accs.includes('sweatband')) return { style: 'band', color: '#ffffff' };\n  if (cast.band) return { style: 'band', color: cast.band };\n  return cast.hat || null;\n};\n/**\n * G.makeRig(id, { suit, acc, kit: 'final' | null, size }) -> an E.Humanoid dressed as that character.\n * Fighters wear a swimsuit (their signature one by default); Sonny wears his loud shirt (or his final kit), Pepper her\n * vest (or the Pinstripe racer), the staff their work clothes.\n */\nG.makeRig = (id, o = {}) => {\n  const c = G.CAST[id] || G.CAST.rin, accs = (o.acc || c.acc || []).slice();\n  const base = { size: (o.size || c.size || 1.25), build: c.build || 'athletic', weapon: null, hair: c.hair || 'short', face: { eyes: 'big', bangs: c.bangs === undefined ? .5 : c.bangs },\n    colors: { skin: c.skin, hair: c.hairColor, eye: c.eyes || '#1a1320', iris: c.iris || '#3a4a8a', boot: c.skin, glove: c.skin } };\n  if (c.shoulders) base.shoulderHalf = ((G.E.Humanoid && null) || 2.95) + c.shoulders;\n  let own = [];\n  const kit = o.kit === 'final' && c.finalKit ? c.finalKit : null;\n  const suitId = o.suit || (c.host || c.staff ? null : c.suit);\n  if (kit || suitId) {\n    const S = kit ? { cut: kit.cut, pattern: kit.pattern, colors: kit.colors } : G.SUITS[suitId] || G.SUITS[c.suit];\n    base.outfit = 'swim'; base.swim = { cut: S.cut, pattern: S.pattern, colors: S.colors, brief: !!S.brief };\n    base.sleeves = S.cut === 'rash' ? (S.sleeves || 'short') : 'none';\n    base.colors.cloth = S.colors.main; base.colors.trim = S.colors.trim; base.colors.pants = S.colors.main;\n    if (S.cut === 'rash' && id === 'sonny') { base.shorts = .5; base.colors.pants = '#16141c'; }\n  } else if (c.outfit) {\n    const f = c.outfit;\n    base.outfit = c.robe ? 'robe' : 'shirt'; base.sleeves = id === 'bo' ? 'none' : 'short';\n    if (id === 'sonny' || id === 'kai') { base.pattern = id === 'sonny' ? 'palms' : (c.pat || 'floral'); base.shorts = .55; }\n    if (id === 'bo') base.shorts = .5;\n    Object.assign(base.colors, { cloth: f.cloth, trim: f.trim, pants: f.pants, boot: f.boot, pattern: f.pattern, belt: f.trim, strap: f.strap });\n  }\n  if (id === 'sonny') own = ['aviators', 'chain']; else if (id === 'pepper') own = ['glasses']; else if (id === 'bo') own = ['whistle'];\n  if (accs.some(a => G.ACCS[a] && G.ACCS[a].shades)) own = own.filter(k => k !== 'aviators' && k !== 'glasses');\n  base.hat = accHat(accs, c);\n  if (c.staff || c.host) base.colors.strap = base.colors.strap || '#8a5a32'; else base.colors.strap = o.sandals ? '#e8c060' : null;\n  const rig = new E.Humanoid(base);\n  rig.extras = G.accExtras(accs, c.accColor || (base.swim && base.swim.colors.accent), own);\n  rig.castId = id; rig.suitId = suitId; rig.accs = accs; rig.kit = kit ? 'final' : null;\n  return rig;\n};\n/** dress an existing rig again (try-on, a gift accepted): a new rig in the same place, keeping its position */\nG.redress = (rig, id, o) => { const n = G.makeRig(id, o); n.x = rig.x; n.y = rig.y; n.z = rig.z; n.facing = rig.facing; return n; };\n/** a portrait with a soft background in the character's color */\nG.portrait = (g, rig, x, y, size = 40, o = {}) => {\n  const c = G.CAST[rig.castId] || {};\n  rig.drawPortrait(g, x, y, size, Object.assign({ zoom: size / 13, turn: .45, bg: o.bg || E.shade(c.color || '#2a6a7a', -.45), border: o.border || '#f6d38a' }, o));\n};\n/** shared portrait rigs for dialogs and menus (one per character, in their current outfit) */\nG.portraitRigs = {};\nG.portraitRig = (id) => {\n  const want = G.wearOf ? G.wearOf(id) : null, key = id + JSON.stringify(want || {});\n  let r = G.portraitRigs[id];\n  if (!r || r._key !== key) { r = G.portraitRigs[id] = G.makeRig(id, want || {}); r._key = key; r.update(1 / 60, { x: 0, y: 0, z: 0, facing: Math.PI / 2 }); }\n  return r;\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1954,"cache_read_input_tokens":394541,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1954},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e8aedb0d-fc32-4598-b2c3-8a34e0c85184","uuid":"10b14768-8a86-4b3b-92a1-faaa07e896e9","timestamp":"2026-11-04T06:18:36.467Z","request_id":"req_011CghQD7VSN1TTvfumUm8qL","wire_tool_inputs":{"toolu_01VG6wGNPaZTQinuEj8MaDMR":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-225453__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-xhigh-20261103-225453/src/13-rigs.js","content":"/* 13-rigs: the rig factory (a cast member in a swimsuit with accessories), the accessory drawers (the engine's extras\n * hook: sunglasses, ribbons, flowers, necklaces, wristbands, chains, whistles, glasses) and portraits. Each match player,\n * NPC and preview owns its own rig: a rig keeps its animation state. */\nconst accDraw = {\n  shades(g, P, c, kind) {\n    if (!c.front) return;\n    const { Sp, J, R, u } = c, L = Sp(J.head, R * .95, -R * .38, R * .02), Rr = Sp(J.head, R * .95, R * .38, R * .02);\n    if (kind === 'heartshades') {\n      for (const e of [L, Rr]) { px.disc(g, e[0], e[1], Math.max(1, u * .9), '#ff5fa2'); px.dot(g, e[0] - .6, e[1] - .6, '#ffd0e8'); }\n      px.line(g, L[0], L[1], Rr[0], Rr[1], '#ff5fa2');\n    } else if (kind === 'aviators') {\n      px.line(g, L[0] - 1, L[1] - 1, Rr[0] + 1, Rr[1] - 1, '#ffd36a');\n      for (const e of [L, Rr]) { px.disc(g, e[0], e[1], Math.max(1, u * .85), '#2a1e10'); px.dot(g, e[0] - .5, e[1] - .6, '#ffd36a'); }\n    } else if (kind === 'glasses') {\n      for (const e of [L, Rr]) { px.rect(g, e[0] - 1, e[1] - 1, 3, 1, '#2a2434'); px.rect(g, e[0] - 1, e[1] + 1, 3, 1, '#2a2434'); }\n    } else {   // wraparound sport shades\n      px.line(g, L[0] - 1.5, L[1], Rr[0] + 1.5, Rr[1], '#20262e', Math.max(2, Math.round(u * 1.1)));\n      px.line(g, L[0] - 1.5, L[1] - 1, Rr[0] + 1.5, Rr[1] - 1, '#e8eef2');\n      px.dot(g, L[0], L[1], '#5a8ac8');\n    }\n  },\n  ribbon(g, P, c, col) { const t = E.tones(col); px.poly(g, [[P[0], P[1]], [P[0] - 3, P[1] - 2], [P[0] - 3, P[1] + 2]], t.base); px.poly(g, [[P[0], P[1]], [P[0] + 3, P[1] - 2], [P[0] + 3, P[1] + 2]], t.sh); px.rect(g, P[0] - 1, P[1] - 1, 2, 2, t.lt); },\n  hibiscus(g, P) { for (let k = 0; k < 5; k++) { const a = k / 5 * TAU; px.disc(g, P[0] + Math.cos(a) * 1.8, P[1] + Math.sin(a) * 1.8, 1.3, k % 2 ? '#e8283a' : '#ff5a5a'); } px.dot(g, P[0], P[1], '#ffd04a'); },\n  necklace(g, P, c) { if (!c.front) return; for (let k = -2; k <= 2; k++) px.dot(g, P[0] + k * 1.5, P[1] + 1 - Math.abs(k) * .5, k % 2 ? '#f8f4e8' : '#e8d8c0'); },\n  chain(g, P, c) { if (!c.front) return; for (let k = -3; k <= 3; k++) px.dot(g, P[0] + k * 1.2, P[1] + 2 - Math.abs(k) * .6, '#ffd36a'); px.rect(g, P[0] - 1, P[1] + 2, 2, 2, '#ffe9a0'); },\n  whistle(g, P, c) { if (!c.front) return; px.line(g, P[0] - 2, P[1] - 1, P[0], P[1] + 3, '#e83a3a'); px.rect(g, P[0] - 1, P[1] + 3, 3, 2, '#c8ccd8'); },\n  band(g, P, c, col) { px.disc(g, P[0], P[1], Math.max(1.2, c.u * .95), E.tones(col).base); px.dot(g, P[0] - .5, P[1] - .5, E.tones(col).lt); }\n};\n/** extras for a list of accessory ids (plus a character's own: Sonny's chain, Bo's whistle, Pepper's glasses) */\nG.accExtras = (accs, accent, own = []) => {\n  const X = [];\n  for (const id of accs) {\n    if (id === 'sportshades' || id === 'heartshades' || id === 'aviators') X.push({ at: 'face', draw: (g, P, c) => accDraw.shades(g, P, c, id) });\n    else if (id === 'ribbon') X.push({ at: 'hair', draw: (g, P, c) => accDraw.ribbon(g, P, c, accent || '#d8303a') });\n    else if (id === 'hibiscus') X.push({ at: 'hair', draw: (g, P) => accDraw.hibiscus(g, P) });\n    else if (id === 'shellnecklace') X.push({ at: 'neck', draw: (g, P, c) => accDraw.necklace(g, P, c) });\n    else if (id === 'wristbands') { X.push({ at: 'wristL', draw: (g, P, c) => accDraw.band(g, P, c, accent || '#ffffff') }); X.push({ at: 'wristR', draw: (g, P, c) => accDraw.band(g, P, c, accent || '#ffffff') }); }\n  }\n  for (const k of own) X.push(k === 'aviators' ? { at: 'face', draw: (g, P, c) => accDraw.shades(g, P, c, 'aviators') } : k === 'glasses' ? { at: 'face', draw: (g, P, c) => accDraw.shades(g, P, c, 'glasses') } : { at: 'neck', draw: (g, P, c) => accDraw[k](g, P, c) });\n  return X;\n};\n/** the hat an accessory list asks for (sweatband, visor, sun hat), or the character's own */\nconst accHat = (accs, cast) => {\n  if (accs.includes('sunhat')) return { style: 'sunhat', color: '#f0d890', band: '#ff5f7a' };\n  if (accs.includes('visor')) return { style: 'visor', color: '#ffffff', brim: cast.color || '#3a6ad8' };\n  if (accs.includes('sweatband')) return { style: 'band', color: '#ffffff' };\n  if (cast.band) return { style: 'band', color: cast.band };\n  return cast.hat || null;\n};\n/**\n * G.makeRig(id, { suit, acc, kit: 'final' | null, size }) -> an E.Humanoid dressed as that character.\n * Fighters wear a swimsuit (their signature one by default); Sonny wears his loud shirt (or his final kit), Pepper her\n * vest (or the Pinstripe racer), the staff their work clothes.\n */\nG.makeRig = (id, o = {}) => {\n  const c = G.CAST[id] || G.CAST.rin, accs = (o.acc || c.acc || []).slice();\n  const base = { size: (o.size || c.size || 1.25), build: c.build || 'athletic', weapon: null, hair: c.hair || 'short', face: { eyes: 'big', bangs: c.bangs === undefined ? .5 : c.bangs },\n    colors: { skin: c.skin, hair: c.hairColor, eye: c.eyes || '#1a1320', iris: c.iris || '#3a4a8a', boot: c.skin, glove: c.skin } };\n  if (c.shoulders) base.shoulderHalf = ((G.E.Humanoid && null) || 2.95) + c.shoulders;\n  let own = [];\n  const kit = o.kit === 'final' && c.finalKit ? c.finalKit : null;\n  const suitId = o.suit || (c.host || c.staff ? null : c.suit);\n  if (kit || suitId) {\n    const S = kit ? { cut: kit.cut, pattern: kit.pattern, colors: kit.colors } : G.SUITS[suitId] || G.SUITS[c.suit];\n    base.outfit = 'swim'; base.swim = { cut: S.cut, pattern: S.pattern, colors: S.colors, brief: !!S.brief };\n    base.sleeves = S.cut === 'rash' ? (S.sleeves || 'short') : 'none';\n    base.colors.cloth = S.colors.main; base.colors.trim = S.colors.trim; base.colors.pants = S.colors.main;\n    if (S.cut === 'rash' && id === 'sonny') { base.shorts = .5; base.colors.pants = '#16141c'; }\n  } else if (c.outfit) {\n    const f = c.outfit;\n    base.outfit = c.robe ? 'robe' : 'shirt'; base.sleeves = id === 'bo' ? 'none' : 'short';\n    if (id === 'sonny' || id === 'kai') { base.pattern = id === 'sonny' ? 'palms' : (c.pat || 'floral'); base.shorts = .55; }\n    if (id === 'bo') base.shorts = .5;\n    Object.assign(base.colors, { cloth: f.cloth, trim: f.trim, pants: f.pants, boot: f.boot, pattern: f.pattern, belt: f.trim, strap: f.strap });\n  }\n  if (id === 'sonny') own = ['aviators', 'chain']; else if (id === 'pepper') own = ['glasses']; else if (id === 'bo') own = ['whistle'];\n  if (accs.some(a => G.ACCS[a] && G.ACCS[a].shades)) own = own.filter(k => k !== 'aviators' && k !== 'glasses');\n  base.hat = accHat(accs, c);\n  if (c.staff || c.host) base.colors.strap = base.colors.strap || '#8a5a32'; else base.colors.strap = o.sandals ? '#e8c060' : null;\n  const rig = new E.Humanoid(base);\n  rig.extras = G.accExtras(accs, c.accColor || (base.swim && base.swim.colors.accent), own);\n  rig.castId = id; rig.suitId = suitId; rig.accs = accs; rig.kit = kit ? 'final' : null;\n  return rig;\n};\n/** dress an existing rig again (try-on, a gift accepted): a new rig in the same place, keeping its position */\nG.redress = (rig, id, o) => { const n = G.makeRig(id, o); n.x = rig.x; n.y = rig.y; n.z = rig.z; n.facing = rig.facing; return n; };\n/** a portrait with a soft background in the character's color */\nG.portrait = (g, rig, x, y, size = 40, o = {}) => {\n  const c = G.CAST[rig.castId] || {};\n  rig.drawPortrait(g, x, y, size, Object.assign({ zoom: size / 13, turn: .45, bg: o.bg || E.shade(c.color || '#2a6a7a', -.45), border: o.border || '#f6d38a' }, o));\n};\n/** shared portrait rigs for dialogs and menus (one per character, in their current outfit) */\nG.portraitRigs = {};\nG.portraitRig = (id) => {\n  const want = G.wearOf ? G.wearOf(id) : null, key = id + JSON.stringify(want || {});\n  let r = G.portraitRigs[id];\n  if (!r || r._key !== key) { r = G.portraitRigs[id] = G.makeRig(id, want || {}); r._key = key; r.update(1 / 60, { x: 0, y: 0, z: 0, facing: Math.PI / 2 }); }\n  return r;\n};\n"}}}
