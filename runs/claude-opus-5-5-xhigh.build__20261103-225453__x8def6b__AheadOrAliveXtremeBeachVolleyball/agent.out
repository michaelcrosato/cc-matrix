 for (const k of AOA_POSES) if (pk[k] === undefined) pk[k] = 0;   // AOA: the new held poses\\n    for (const k in pk) pk[k] = s.poseW && s.poseW[k] !== undefined ? clamp(s.poseW[k], 0, 1) : approach(pk[k], s.pose === k ? 1 : 0, dt * 9);\")","+rep(\"    if (o.hair.style === 'long' || o.hair.style === 'ponytail') this._hair(dt);\",","+    \"    if (o.hair.style === 'long' || o.hair.style === 'ponytail' || o.hair.style === 'braid') this._hair(dt);   // AOA: braid\")","+rep(\"    const o = this.o, long = o.hair.style === 'long', N = o.hair.len || (long ? 6 : 4), seg = (long ? 1.9 : 1.6) * o.size;\",","+    \"    const o = this.o, long = o.hair.style === 'long' || o.hair.style === 'braid', N = o.hair.len || (o.hair.style === 'braid' ? 5 : long ? 6 : 4), seg = (long ? 1.9 : 1.6) * o.size;\")","+","+# solvePose: crouch, sit, lean and the arm targets of the new poses, then the timed arm overlay (rig.arms)","+rep(\"    const cr = Math.max(PW.crouch || 0, this._crouchA || 0, Math.sin(clamp(this.downW || 0, 0, 1) * Math.PI) * .85);\",","+    \"    const AR = this.arms && this.arms.w > 0 ? this.arms : null, sit = PW.sit || 0;   // AOA: a timed move's overlay; sitting\\n    const cr = Math.max(PW.crouch || 0, this._crouchA || 0, Math.sin(clamp(this.downW || 0, 0, 1) * Math.PI) * .85, (PW.vready || 0) * .35, (PW.bump || 0) * .55, (PW.set || 0) * .2, AR && AR.crouch ? AR.crouch * AR.w : 0);\")","+rep(\"    const hipC = [mf * .4 * sp - .4 * hurt + lg * .55, mr * .3 * sp + sway, o.hipZ + bob + breathe * .3 - dash * 2.2 - hurt * .6 - kn * o.hipZ * .42 - PW.guard * .9 - cr * o.hipZ * .32 - snk * o.hipZ * .3 - ld * o.hipZ * .42 + (this.hop || 0)];\",","+    \"    const hipC = [mf * .4 * sp - .4 * hurt + lg * .55 - sit * 1.6, mr * .3 * sp + sway, o.hipZ + bob + breathe * .3 - dash * 2.2 - hurt * .6 - kn * o.hipZ * .42 - PW.guard * .9 - cr * o.hipZ * .32 - snk * o.hipZ * .3 - ld * o.hipZ * .42 - sit * o.hipZ * .44 + (this.hop || 0)];\")","+rep(\"      if (hw > 0) foot = V3.lerp(foot, [1.3, s * 1.3, o.hipZ * .08 + (s > 0 ? .8 : 0)], hw);                   // dangling against the wall\",","+    \"      if (hw > 0) foot = V3.lerp(foot, [1.3, s * 1.3, o.hipZ * .08 + (s > 0 ? .8 : 0)], hw);                   // dangling against the wall\\n      if (sit > 0) foot = V3.lerp(foot, [o.legUpper * .78, s * 1.9, 0], sit);   // AOA: sitting, knees forward\")","+rep(\"    const leanF = (o.lean + .16 * sp * mf + .45 * dash + this._atkLean - .35 * hurt + cr * .22 + snk * .34 + spr * .3 + ld * .42) * (1 - hw) + hw * .06, leanR = .1 * sp * mr;\",","+    \"    const leanF = (o.lean + .16 * sp * mf + .45 * dash + this._atkLean - .35 * hurt + cr * .22 + snk * .34 + spr * .3 + ld * .42 - (PW.stretch || 0) * .18 - (PW.set || 0) * .1 - sit * .08 + (AR && AR.lean ? AR.lean * AR.w : 0)) * (1 - hw) + hw * .06, leanR = .1 * sp * mr;\")","+rep(\"    J.shL = add(shC, rz([0, -o.shoulderHalf, 0], this._twist)); J.shR = add(shC, rz([0, o.shoulderHalf, 0], this._twist));\",","+    \"    const tw = this._twist + (PW.lookback || 0) * .75 + (AR && AR.twist ? AR.twist * AR.w : 0);   // AOA: look back over the shoulder\\n    J.shL = add(shC, rz([0, -o.shoulderHalf, 0], tw)); J.shR = add(shC, rz([0, o.shoulderHalf, 0], tw));\")","+rep(\"      if (hw > 0) hand = V3.lerp(hand, add(sh, [2.4, s * .4, clamp((this._hangZ === undefined ? sh[2] + armLen : this._hangZ) - sh[2], 1, armLen * .96)]), hw);   // gripping the edge above\",","+    \"      if (hw > 0) hand = V3.lerp(hand, add(sh, [2.4, s * .4, clamp((this._hangZ === undefined ? sh[2] + armLen : this._hangZ) - sh[2], 1, armLen * .96)]), hw);   // gripping the edge above\\n      hand = aoaHands(this, PW, s, sh, shC, J, armLen, hand);   // AOA: the new held poses\")","+rep(\"      if (this._kicking && aw > 0) hand = V3.lerp(hand, add(shC, [1.8, s * 2.2, .6 - (s > 0 ? 1.5 : 0)]), aw * .85);   // arms up for balance during a kick\",","+    \"      if (this._kicking && aw > 0) hand = V3.lerp(hand, add(shC, [1.8, s * 2.2, .6 - (s > 0 ? 1.5 : 0