return;\n    }\n    const w = 240, x = (W - w) / 2, y = 30; box(g, x, y, w, 168, true);\n    TC(g, S.mode === 'test'\"\"\",1)\n# telemetry\nm=m.replace(\"    if (S.mode === 'survival') survivalHud(g, r);\\n    if (!S.attract\",\"    if (S.mode === 'survival') survivalHud(g, r);\\n    if (S.tele) { const lines = ['x ' + Math.round(v.x) + ' y ' + Math.round(v.y) + ' z ' + Math.round(v.z), (v.onGround ? 'ground ' : 'air ') + (v.surface || '-') + ' slide ' + Math.round(v.slide), 'steps ' + run.steps + ' phase ' + run.phase, 'speed ' + Math.round(v.speed) + ' u/s boost ' + v.boostT.toFixed(2)]; lines.forEach((l, k) => T(g, l, 12, 60 + k * 9, '#9ad8ff')); }\\n    if (!S.attract\",1)\nopen('src/main.js','w').write(m)\nt=open('tools/test.mjs').read().replace(\"S.start(); for (let i = 0; i < 300 && !game.sceneName; i++) await new Promise(r => setTimeout(r, 20));\",\"S.noStory = true; S.start(); for (let i = 0; i < 300 && !game.sceneName; i++) await new Promise(r => setTimeout(r, 20));\",1)\nopen('tools/test.mjs','w').write(t)\nEOF\nnode tools/test.mjs ui editor 2>&1 | tail -5 | cut -c1-300","uuid":"2334346f-f6c6-4870-a299-e56dc6c2e0ec","session_id":"133e450b-8b13-41c9-9125-2ea73f490cb8"}
