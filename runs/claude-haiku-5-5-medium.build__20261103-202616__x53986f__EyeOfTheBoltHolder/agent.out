oots'], '22,11': ['wardensBlade'], '16,10': ['potionHealing', 'potionHealing'], '20,10': ['ration', 'ration'],\n    '20,14': ['scrollRaising'], '22,13': ['bracersOfDefense'], '21,14': ['ironRation'], '3,16': ['ration'] },\n  alcoves: { AL5: ['ironWard'] },\n  monsters: [{ type: 'hound', at: [4, 6], n: 2 }, { type: 'seer', at: [19, 8], n: 2 }, { type: 'gazer', at: [18, 2], n: 2 }, { type: 'seer', at: [20, 4] },\n    { type: 'hound', at: [11, 2], asleep: true }, { type: 'warden', at: [11, 10], n: 2 }, { type: 'warden', at: [18, 10], n: 2 }, { type: 'warden', at: [21, 11], n: 2 },\n    { type: 'gazer', at: [17, 13] }],\n  wanderers: { budget: 4, spawn: [[3, 6], [11, 10], [19, 10]], kinds: [['hound', 1], ['gazer', 2]] },\n  areas: { gauntlet: [6, 8, 19, 8], chapel: [15, 1, 21, 5], undergate: [10, 1, 13, 4], penance: [9, 10, 13, 11], barracks: [16, 10, 22, 11], reliquary: [20, 13, 22, 14], sump: [1, 14, 3, 16], ossuary: [1, 4, 5, 8] },\n  safe: [],\n  wires: [\n    { on: { sequence: ['C1', 'C2', 'C3', 'C4', 'C5', 'C6'] }, once: true, do: [['special', 'SQ3'], ['give', 'robeOfTheLintel', 'ALT'], ['msg', 'The candles burn steady. Something is laid out on the altar.']], fail: [['gutter']] },\n    { on: { lever: 'LV3' }, once: true, do: [['open', 'G8'], ['story', 'veil']] },\n    { on: { flag: 'veilHelped', value: true }, once: true, do: [['open', 'H2'], ['msg', 'A hidden door grinds open!']] },\n    { on: { lever: 'LV4' }, once: true, do: [['open', 'G9']] },\n    { on: { enterArea: 'chapel' }, once: true, do: [['msg', 'The eyes in the walls turn to follow you.']] },\n    { on: { undergate: 'U1' }, do: [['undergate']] }\n  ],\n  waypoints: [['F3 Ossuary', 2, 5, 0], ['F3 Gauntlet', 12, 8, 1], ['F3 Chapel', 18, 3, 1], ['F3 Penance', 11, 10, 0], ['F3 Barracks', 19, 10, 0], ['F3 Undergate', 12, 4, 2]],\n  walk: [['clear', 'hound'], ['take', 1, 8], ['take', 5, 4], ['note', 'N8'], ['gauntlet'], ['clear', 'seer'], ['candles'], ['ward', 'copperWard'], ['ward', 'brassWard'], ['clear', 'warden'], ['lever', 'LV3'], ['join', 'veil'], ['take', 20, 14], ['ward', 'ironWard'], ['undergate']],\n  deed: 'SQ3'\n};\nB.FLOORS.f4 = {\n  name: 'The Eye\\'s Vault', card: 'The air hums like a struck bell.', song: 'vault',\n  rows: [\n    '#############', '###.......###', '###.#...#.###', '###...B...###', '###.#...#.###', '###.......###', '######=######', '####.....####',\n    '####.....####', '######.######', '######.######', '######@######', '######<######', '#############'],\n  start: [6, 11, 0],\n  ids: { G10: [6, 6], GL1: [3, 3], GL2: [9, 3], GL3: [6, 1], B: [6, 3], UP: [6, 12], GOLEM_A: [5, 7], GOLEM_B: [7, 7] },\n  doors: {}, plates: {},\n  walls: [\n    { id: 'N10', k: 'plaque', at: [4, 8], dir: 3, text: 'BEYOND WAKES THE WATCHER. TURN ITS LOCKS, AND IT IS BLIND.' },\n    { id: 'GL1', k: 'greatLock', at: [3, 3], dir: 3 }, { id: 'GL2', k: 'greatLock', at: [9, 3], dir: 1 }, { id: 'GL3', k: 'greatLock', at: [6, 1], dir: 0 },\n    { id: 'TW1', k: 'torch', at: [8, 7], dir: 1 }, { id: 'TW2', k: 'torch', at: [4, 7], dir: 3 }],\n  stairs: { '6,12': { to: 'f3', at: [12, 4, 0] } },\n  items: {}, alcoves: {},\n  monsters: [{ type: 'gazer', at: [6, 9], n: 2 }, { type: 'golem', at: [5, 7], id: 'golemA' }, { type: 'golem', at: [7, 7], id: 'golemB' }, { type: 'boltholder', at: [6, 3], id: 'boss' }],\n  wanderers: { budget: 0, spawn: [], kinds: [] },\n  areas: { arena: [3, 1, 9, 5], antechamber: [4, 7, 8, 8], approach: [6, 9, 6, 10] },\n  safe: [],\n  wires: [\n    { on: { enter: [6, 5] }, once: true, do: [['bossIntro']] },\n    { on: { killed: ['golemA', 'golemB'] }, once: true, do: [['open', 'G10'], ['msg', 'The Vault Door grinds open.']] }\n  ],\n  waypoints: [['F4 Antechamber', 6, 8, 0], ['F4 Arena', 6, 5, 0]],\n  walk: [['clear', 'gazer'], ['note', 'N10'], ['clear', 'golem'], ['door', 'G10'], ['bossLocks'], ['stairlight']],\n  deed: null\n};\n/* the Rat Run: a race floor (solo time trial and the AI Hub's ghost race) */\nB.FLOORS.race = {\n  name: 'The Rat Run', card: 'A race through the drains, against the clock and the other party.', song: 'drains',\n  rows: [\n    '##############', '#....L...###>#', '#....###.###.#', '#....###.###.#', '#....###.###=#', '#....###.P...#', '#=######.....#', '#.#.##.#######', '#.#.##.#######', '#......#######', '#@############', '##############'],\n  start: [1, 10, 0],\n  ids: { RLV: [1, 8], RG1: [1, 6], RL: [5, 1], RG2: [12, 4], RP: [9, 5], EXIT: [12, 1], RAL: [1, 2] },\n  doors: { RL: { lock: 'ironKey', kind: 'simple' } }, plates: { RP: { mode: 'hold' } },\n  walls: [{ id: 'RLV', k: 'lever', at: [1, 8], dir: 1 }, { id: 'RAL', k: 'alcove', at: [1, 2], dir: 3, text: 'A niche in the wall, holding a key.' }],\n  stairs: { '12,1': { to: 'exit' } },\n  items: { '6,6': [] }, alcoves: { RAL: ['ironKey'] },\n  monsters: [{ type: 'rat', at: [3, 3], n: 3 }, { type: 'rat', at: [2, 5], n: 2 }, { type: 'latchkin', at: [8, 3], n: 2 }, { type: 'rat', at: [5, 9], n: 2 }],\n  crowns: [[3, 7], [6, 7], [4, 9], [1, 1], [4, 5], [10, 6]],\n  rock: [11, 6],\n  wanderers: { budget: 0, spawn: [], kinds: [] },\n  areas: {}, safe: [],\n  wires: [{ on: { lever: 'RLV' }, once: true, do: [['open', 'RG1'], ['checkpoint', 'Lever pulled']] }],\n  waypoints: [['Rat Run start', 1, 10, 0]],\n  walk: [],\n  deed: null\n};\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YTSSNCwDxwzz2ZL81YHKZq","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-202616__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-haiku-5-5-medium-20261103-202616/src/15-floors.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c642ce04-34f8-46f2-be98-ceed51703e52","uuid":"d2266913-307e-4d04-adcf-156de3e4ad8a","timestamp":"2026-11-04T03:31:55.485Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-202616__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-haiku-5-5-medium-20261103-202616/src/15-floors.js","content":"/* ===== 15 floors: the four floors and the Rat Run (PLAN §7.4, §7.5) =====\n * rows: the map (x = column, y = row, 0 at the top). ids: every id that names a map cell or a wall feature.\n * walls: wall features on the face of a cell: { id, k, at: [x, y], dir: 0 N, 1 E, 2 S, 3 W }.\n * doors: the locks, by id: { lock, kind: 'simple' | 'warded' }. items/alcoves: floor items and alcove holdings.\n * stairs: keyed 'x,y' of the stair cell: { to, at: [x, y, dir] }. wires: the wiring language (see tools/CONTENT.md).\n * monsters: groups at a cell. patrol: a list of cells. areas: named rectangles [x0, y0, x1, y1]. */\nB.FLOORS = {};\nB.FLOORS.f1 = {\n  name: 'The Hasp Drains', card: 'Cold water talks to itself in the channels. The walls sweat.', song: 'drains',\n  rows: [\n    '######################', '#.....=.#####........#', '#.....#######........#', '##+#####.########L####', '##.#####H########.####',\n    '#....###.....####.####', '#....###......P.=.####', '#............#########', '#....###.....#########', '##.######I##.#########',\n    '##=#####...#...T....##', '##.#####...########=##', '##.##..#...###.......#', '##..+..#######.......#', '##@##..########L######', '##<############>######', '######################'],\n  start: [2, 14, 0],\n  ids: { G1: [2, 10], G2: [16, 6], G3: [6, 1], G4: [19, 11], D1: [2, 3], D2: [4, 13], L1: [17, 3], L2: [15, 14], H1: [8, 4], I1: [9, 9],\n    P1: [14, 6], T1: [15, 10], UP: [2, 15], DN: [15, 15], SW1: [9, 5] },\n  doors: { L1: { lock: 'ironKey', kind: 'simple' }, L2: { lock: 'drainwardensKey', kind: 'warded' } },\n  plates: { P1: { mode: 'hold' } },\n  walls: [\n    { id: 'LV1', k: 'lever', at: [2, 11], dir: 1 }, { id: 'N1', k: 'plaque', at: [1, 6], dir: 3, text: 'THE WARDENS KEEP TO THE LEFT CHANNEL. THE BITERS KEEP TO THE RIGHT.' },\n    { id: 'LV2', k: 'lever', at: [5, 2], dir: 1 }, { id: 'AL1', k: 'alcove', at: [4, 5], dir: 0, accepts: 'ratKingsCrown', text: 'A ring of tiny stone rats surrounds an empty seat.' },\n    { id: 'SW1', k: 'catch', at: [9, 5], dir: 0, text: 'A loose stone, odd among the others.' }, { id: 'N2', k: 'plaque', at: [10, 8], dir: 2, text: 'NOT EVERY STONE IS STONE.' },\n    { id: 'N3', k: 'plaque', at: [6, 12], dir: 0, text: 'WARDENS\\' POST. BAR THE DOOR AND REST. SLEEP LIGHTLY.' },\n    { id: 'N4', k: 'plaque', at: [14, 13], dir: 2, text: 'BY ORDER OF THE DRAINWARDEN, THIS DOOR OPENS FOR HIS KEY ALONE.' },\n    { id: 'B1', k: 'button', at: [13, 10], dir: 0 }, { id: 'B2', k: 'button', at: [18, 10], dir: 2 },\n    { id: 'TW1', k: 'torch', at: [12, 5], dir: 0 }, { id: 'TW2', k: 'torch', at: [20, 1], dir: 1 }, { id: 'TW3', k: 'torch', at: [2, 12], dir: 3 }, { id: 'TW4', k: 'torch', at: [20, 13], dir: 1 }],\n  stairs: { '2,15': { to: 'sealed' }, '15,15': { to: 'f2', at: [2, 1, 1] } },\n  items: { '2,13': ['rustyDagger'], '2,12': ['rock'], '5,13': ['ration', 'ration'], '6,14': ['tornPage'], '3,8': ['leatherCap'], '1,5': ['sling', 'slingStones', 'slingStones'],\n    '1,1': ['ironKey'], '3,2': ['shortSword'], '5,1': ['darts', 'darts'], '8,3': ['scroll_wardOfBrass', 'potionHealing'], '10,7': ['rock'], '9,11': ['ratKingsCrown'], '10,12': ['ration'],\n    '20,1': ['lightCrossbow'], '20,2': ['bolts'], '13,1': ['leatherArmor'], '13,2': ['ration'], '19,10': ['potionHealing'], '20,12': ['ironRation'], '14,12': ['scroll_sparkDart'] },\n  alcoves: { AL1: [] },\n  monsters: [{ type: 'rat', at: [3, 6], n: 3 }, { type: 'rat', at: [1, 8], n: 2, asleep: true }, { type: 'latchkin', at: [3, 1], n: 2 }, { type: 'latchkin', at: [5, 2], n: 1 },\n    { type: 'leech', at: [11, 7] }, { type: 'ratknot', at: [9, 11] }, { type: 'rat', at: [8, 10], n: 2 }, { type: 'snick', at: [18, 1], id: 'snick' }, { type: 'latchkin', at: [15, 2], n: 2 },\n    { type: 'rat', at: [17, 10], n: 3, patrol: [[13, 10], [19, 10]] }, { type: 'ooze', at: [16, 12] }, { type: 'ooze', at: [19, 13] }],\n  wanderers: { budget: 3, spawn: [[3, 7], [11, 5], [17, 12]], kinds: [['rat', 2], ['latchkin', 2]] },\n  areas: { lair: [8, 10, 10, 12], snickHall: [13, 1, 20, 2], post: [5, 12, 6, 14] },\n  safe: [[5, 12], [6, 12], [5, 13], [6, 13], [5, 14], [6, 14]],\n  wires: [\n    { on: { lever: 'LV1' }, mode: 'toggle', do: [['toggle', 'G1']] },\n    { on: { lever: 'LV2' }, once: true, do: [['open', 'G3'], ['story', 'tamsin']] },\n    { on: { catch: 'SW1' }, once: true, do: [['open', 'H1'], ['xp', 25, 'secret'], ['msg', 'A hidden door grinds open!']] },\n    { on: { enter: [9, 9] }, once: true, do: [['msg', 'The wall is an illusion!'], ['xp', 25, 'secret']] },\n    { on: { plate: 'P1' }, mode: 'hold', do: [['open', 'G2']], hint: ['P1', 20, 'Something heavy might hold it down.'] },\n    { on: { buttons: ['B1', 'B2'], within: 'buttonWin' }, mode: 'latch', do: [['open', 'G4'], ['msg', 'Both buttons click. A gate rises.']], fail: [['hint', 'Two buttons, one gate. Perhaps they must be pressed together.']], failAfter: 2 },\n    { on: { alcove: 'AL1', accepts: 'ratKingsCrown' }, once: true, do: [['special', 'SQ1'], ['give', 'ringOfMending', 'AL1']] },\n    { on: { seen: 'snick' }, once: true, do: [['bark', 'snick1']] },\n    { on: { hp: 'snick', below: .5 }, once: true, do: [['spawn', 'latchkin', [13, 2], 2], ['bark', 'snick2']] },\n    { on: { killed: ['snick'] }, once: true, do: [['bark', 'snick3'], ['special', 'SNICK']] },\n    { on: { enter: [9, 11] }, once: true, do: [['msg', 'The stench of rats is overwhelming.']] },\n    { on: { enter: [2, 9] }, once: true, do: [['hint', 'Rats! Press {square} to strike with everyone who\\'s ready.']] },\n    { on: { enter: [5, 13] }, once: true, do: [['hint', 'This old wardens\\' post has a sturdy door. A good place to rest.']] },\n    { on: { enter: [2, 15] }, do: [['msg', 'The grate above is bolted fast. There is no way back.']] },\n    { on: { enter: [15, 15] }, do: [['msg', 'The stair leads down.']] }\n  ],\n  waypoints: [['F1 Start', 2, 14, 0], ['F1 Latchkin Den', 2, 2, 0], ['F1 Snick\\'s Hall', 15, 1, 1], ['F1 Cistern', 16, 12, 1]],\n  walk: [['take', 2, 13], ['lever', 'LV1'], ['clear', 'rat'], ['note', 'N1'], ['door', 'D1'], ['clear', 'latchkin'], ['take', 1, 1], ['lever', 'LV2'], ['join', 'tamsin'],\n    ['note', 'N2'], ['clear', 'leech'], ['catch', 'SW1'], ['plate', 'P1', 13, 6, 1], ['lockdoor', 'L1'], ['clear', 'snick'], ['note', 'N2'], ['clear', 'ratknot'], ['alcove', 'AL1'], ['take', 9, 11], ['button', 'B1', 'B2'], ['clear', 'ooze'], ['lockdoor', 'L2']],\n  deed: 'SQ1'\n};\nB.FLOORS.f2 = {\n  name: 'The Tumbler Halls', card: 'The air smells of oil and old smoke. Somewhere, gears are turning.', song: 'tumbler',\n  rows: [\n    '######################', '#<@..........###.....#', '#...####.....K.......#', '########.....###.....#', '#.....##########.....#', '#.P.P.=...#....####.##',\n    '#.....#...M....####.##', '#.....#...#....####.##', '##=########...>####.##', '##..P##############.##', '####.o.############.##', '####O#.####.#######^##',\n    '####.#.####=#######.##', '####.#.##.....###....#', '####............+.S..#', '#########.....###....#', '######################'],\n  start: [2, 1, 1],\n  ids: { K1: [13, 2], CN1: [16, 1], CN2: [17, 1], CN3: [19, 1], CN4: [20, 1], CF: [18, 1], AL2: [19, 6], SW2: [19, 8], TP1: [19, 11], SP1: [18, 14], D3: [16, 14],\n    LA: [10, 15], LB: [11, 15], LC: [12, 15], O1: [4, 11], P2: [4, 9], O2: [5, 10], N6: [3, 9], AL3: [2, 9], G6: [2, 8], P3: [2, 5], P4: [4, 5], G7: [6, 5],\n    N7: [8, 5], M1: [10, 6], AL4: [14, 6], SH1: [12, 5], G5: [11, 12], UP: [1, 1], DN: [14, 8], TW1: [10, 1] },\n  doors: { K1: { lock: 'gearKey', kind: 'warded' }, D3: { lock: null } },\n  plates: { P2: { mode: 'latch' }, P3: { mode: 'latch' }, P4: { mode: 'latch' } },\n  walls: [\n    { id: 'N5', k: 'plaque', at: [8, 3], dir: 2, text: 'THE TUMBLERWRIGHT\\'S CREED: THE FIRST FALLS. THE SECOND RISES. THE THIRD FALLS.' },\n    { id: 'CN1', k: 'alcove', at: [16, 1], dir: 0, accepts: 'gear', text: 'A niche with a gear socket.' }, { id: 'CN2', k: 'alcove', at: [17, 1], dir: 0, accepts: 'gear', text: 'A niche with a gear socket.' },\n    { id: 'CN3', k: 'alcove', at: [19, 1], dir: 0, accepts: 'gear', text: 'A niche with a gear socket.' }, { id: 'CN4', k: 'alcove', at: [20, 1], dir: 0, accepts: 'gear', text: 'A niche with a gear socket.' },\n    { id: 'CF', k: 'clock', at: [18, 1], dir: 0, text: 'The Great Clock. Four sockets lie empty.' },\n    { id: 'AL2', k: 'alcove', at: [19, 6], dir: 3, text: 'A small brass niche.' }, { id: 'SW2', k: 'catch', at: [19, 8], dir: 1, text: 'A brass rivet, a little proud of the wall.' },\n    { id: 'AL3', k: 'alcove', at: [2, 9], dir: 3, accepts: 'key', text: 'A riddle alcove. It wants a key, and it turns it.' },\n    { id: 'N6', k: 'plaque', at: [3, 9], dir: 0, text: 'I HAVE TEETH, YET NEVER BITE. I TURN, YET HAVE NO FEET. GIVE ME WHAT OPENS, AND I OPEN.' },\n    { id: 'LA', k: 'lever', at: [10, 15], dir: 2 }, { id: 'LB', k: 'lever', at: [11, 15], dir: 2 }, { id: 'LC', k: 'lever', at: [12, 15], dir: 2 },\n    { id: 'N7', k: 'plaque', at: [8, 5], dir: 0, text: 'THE GUILD VAULT. WHAT IS SEALED BY ART, ART UNSEALS.' },\n    { id: 'AL4', k: 'alcove', at: [14, 6], dir: 1, text: 'An altar niche with a ward-shaped dent.' },\n    { id: 'SH1', k: 'shrine', at: [12, 5], dir: 0, text: 'The Shrine of the Threshold. A ring of tiny rat statues.' },\n    { id: 'TW1', k: 'torch', at: [10, 1], dir: 0 }, { id: 'TW2', k: 'torch', at: [20, 4], dir: 1 }, { id: 'TW3', k: 'torch', at: [9, 13], dir: 3 }, { id: 'TW4', k: 'torch', at: [11, 8], dir: 2 }],\n  stairs: { '1,1': { to: 'f1', at: [15, 13, 0] }, '14,8': { to: 'f3', at: [1, 2, 2] } },\n  items: { '9,1': ['tumblerGear1'], '12,3': ['gearKey'], '11,3': ['warhammer'], '8,1': ['scroll_featherStep'], '10,3': ['guildLedger'], '8,2': ['ration', 'ration'],\n    '16,4': ['scroll_unlatch'], '20,3': ['potionHealing'], '20,15': ['tumblerGear3'], '17,15': ['chainShirt'], '13,15': ['ironShield'], '9,15': ['tumblersPick'], '13,13': ['ration'],\n    '11,11': ['tumblerGear4'], '6,10': ['potionGreaterHealing'], '4,13': ['rock'], '5,14': ['rock'], '3,9': ['bentKey'], '5,7': ['ironIngot'], '1,7': ['wandUnlatching'], '1,4': ['ration', 'ration'],\n    '12,8': ['scroll_frostbite'], '11,5': ['scrollRaising'], '13,5': ['lockbreaker'], '14,5': ['ironRation'] },\n  alcoves: { AL2: ['tumblerGear2'], AL3: [], AL4: ['brassWard'], CN1: [], CN2: [], CN3: [], CN4: [], CF: [] },\n  monsters: [{ type: 'skeleton', at: [10, 2], n: 2 }, { type: 'rustling', at: [11, 1], n: 3 }, { type: 'spider', at: [18, 3] }, { type: 'rustling', at: [19, 9], n: 2, patrol: [[19, 5], [19, 12]] },\n    { type: 'spider', at: [20, 13] }, { type: 'skeleton', at: [12, 14], n: 2 }, { type: 'spider', at: [4, 13] }, { type: 'skeleton', at: [3, 6], n: 2 }, { type: 'sentinel', at: [12, 6], id: 'sentinel' }],\n  wanderers: { budget: 3, spawn: [[10, 2], [18, 2], [11, 14]], kinds: [['rustling', 2], ['skeleton', 1]] },\n  areas: { clock: [16, 1, 20, 4], endless: [19, 5, 19, 12], vault: [11, 5, 14, 8], lockroom: [9, 13, 13, 15], spinner: [17, 13, 20, 15] },\n  safe: [],\n  wires: [\n    { on: { full: ['CN1', 'CN2', 'CN3', 'CN4'] }, once: true, do: [['special', 'SQ2'], ['give', 'tumblerwrightsGoggles', 'CF'], ['sfx', 'chime'], ['msg', 'The Great Clock chimes, and its hands move.']] },\n    { on: { enterArea: 'clock' }, once: true, do: [['story', 'ysolde1']] },\n    { on: { catch: 'SW2' }, once: true, do: [['teleporter', 'TP1', false], ['xp', 25, 'secret'], ['msg', 'Something clicks deep in the wall. The air in the corridor stills.']] },\n    { on: { enter: [19, 11] }, do: [['loop', 'TP1']] },\n    { on: { loops: 2, at: [19, 11] }, once: true, do: [['msg', 'The corridor seems longer than it should.']] },\n    { on: { loops: 4, at: [19, 11] }, once: true, do: [['story', 'ysoldeHint']] },\n    { on: { enter: [11, 13] }, once: true, do: [['story', 'durgan1']] },\n    { on: { levers: { LA: true, LB: false, LC: true } }, once: true, do: [['open', 'G5'], ['story', 'durgan2'], ['msg', 'With a deep clank the lock gives way.']], clatter: true },\n    { on: { plate: 'P2' }, once: true, do: [['bridge', 'O1'], ['msg', 'A stone bridge grinds up out of the pit.']] },\n    { on: { alcove: 'AL3', accepts: 'key' }, do: [['open', 'G6'], ['return'], ['msg', 'The alcove takes the key, turns it, and gives it back. Far off, a gate rises.']], once: true },\n    { on: { plates: ['P3', 'P4'], all: true }, mode: 'latch', do: [['open', 'G7'], ['msg', 'With a loud CLACK, the gate locks open.']] },\n    { on: { fall: 'O1' }, do: [['msg', 'The floor gives way!']] },\n    { on: { killed: ['sentinel'] }, once: true, do: [['story', 'ysolde2']] },\n    { on: { enter: [18, 14] }, do: [['msg', 'The spinner\\'s teeth grind underfoot.']] }\n  ],\n  waypoints: [['F2 Landing', 2, 1, 1], ['F2 Clock Hall', 18, 3, 1], ['F2 Endless Hall', 19, 9, 1], ['F2 Lock Room', 11, 14, 1], ['F2 Weight Hall', 3, 6, 1], ['F2 Vault', 12, 6, 1]],\n  walk: [['clear', 'skeleton'], ['take', 9, 1], ['take', 12, 3], ['note', 'N5'], ['door', 'K1'], ['clear', 'spider'], ['take', 10, 1], ['alcove', 'AL2'], ['tp', 'SW2']],\n  deed: 'SQ2'\n};\nB.FLOORS.f3 = {\n  name: 'The Gloam Deeps', card: 'The stone here is black and warm, and it watches you.', song: 'gloam',\n  rows: [\n    '########################', '#<########....#.......##', '#@########....#.......##', '#.########............##', '#.....####....#.......##',\n    '#.....######U##.......##', '#.....######>######L####', '#.....###.###.###.#.####', '#...................####', '###########.#######.####',\n    '#########.....##.......#', '#########.....##.......#', '#############=#######=##', '#############.H........#', '#...################...#',\n    '#.*.####################', '#<..####################', '########################'],\n  start: [12, 4, 3],\n  ids: { UP: [1, 1], DN: [12, 6], LADDER: [1, 16], L3: [19, 6], C1: [16, 1], C2: [16, 5], C3: [18, 1], C4: [18, 5], C5: [20, 1], C6: [20, 5], N8: [3, 4], N9: [11, 4],\n    U1: [12, 5], LV3: [13, 11], G8: [13, 12], H2: [14, 13], LV4: [22, 10], G9: [21, 12], AL5: [22, 14], SUMP: [2, 15], STAIRL: [1, 16] },\n  doors: { L3: { lock: 'boneKey', kind: 'warded' } },\n  plates: {},\n  walls: [\n    { id: 'N8', k: 'plaque', at: [3, 4], dir: 0, text: 'HERE LIE THE EYELESS, WHO SAW TRUE.' },\n    { id: 'C1', k: 'candle', at: [16, 1], dir: 0, seq: 1 }, { id: 'C2', k: 'candle', at: [16, 5], dir: 2, seq: 2 }, { id: 'C3', k: 'candle', at: [18, 1], dir: 0, seq: 3 },\n    { id: 'C4', k: 'candle', at: [18, 5], dir: 2, seq: 4 }, { id: 'C5', k: 'candle', at: [20, 1], dir: 0, seq: 5 }, { id: 'C6', k: 'candle', at: [20, 5], dir: 2, seq: 6 },\n    { id: 'N9', k: 'plaque', at: [11, 4], dir: 2, text: 'HERE THE GUILD SET ITS WATCHER. COPPER, BRASS AND IRON: THREE WARDS FOR ONE GATE.' },\n    { id: 'LV3', k: 'lever', at: [13, 11], dir: 1 }, { id: 'LV4', k: 'lever', at: [22, 10], dir: 0 },\n    { id: 'AL5', k: 'alcove', at: [22, 14], dir: 1, text: 'A reliquary niche. An iron dent waits in it.' },\n    { id: 'ALT', k: 'altar', at: [18, 3], dir: 0, text: 'An altar of black stone.' },\n    { id: 'TW1', k: 'torch', at: [1, 6], dir: 3 }, { id: 'TW2', k: 'torch', at: [9, 10], dir: 3 }, { id: 'TW3', k: 'torch', at: [16, 11], dir: 3 }, { id: 'TW4', k: 't