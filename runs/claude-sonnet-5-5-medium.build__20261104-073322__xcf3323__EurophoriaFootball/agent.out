e,\n871:   *  gets back to the menu), and those the game hides with new E.Game({ menu: { controls: { a: false } } }) */\n2962: *      new E.Game({ menu: { settings: [{ key: 'hints', label: 'Hints', value: true }] } }) and reads game.settings.hints.\n3802: *    new E.Game({ menu: { saves: true } }) puts Save (while saves.canSave: a JRPG sets it at a save point) and Load in\n3805: *    menu: { saves: { slots: 3, version: 2, migrate(data, from) { ...; return data; } } } sets them.\n3911:HOOKS.pause = (sh, acts) => {   // the pause menu's Save and Load, with menu: { saves }\n9108: *    defaults). new E.Game({ menu: { items: [['Restart', fn]], settings: [...], controls: { attack: 'Sword', skill:\n9470:    const acts = (name === 'pause' ? [['Resume', () => this.hide()]] : []).concat(v(s.actions) || [], name === 'pause' && this._std && v(this._game.o.menu && this._game.o.menu.items) || []).filter(Boolean);\n1063:  mouseScreen() { return this.mouse.active ? this.screen.clientToScreen(this.mouse.cx, this.mouse.cy) : null; }\n1075:  pointer() { return this._fedAt || (this.mouse.active ? this.screenPoint(this.mouse.cx, this.mouse.cy) : null); }\n2629:  mouseGround() { const m = this.input.mouseScreen(); return m ? this.view.toGround(m[0], m[1]) : null; }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01SdoZAxd1sdGHZvQ1hnWApH","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
