,\"if (((f.human === null && S.t > 1.8 + this.rng() * .3) || S.t > 12) && !S.aiGo) { S.aiGo = true; }\")\nopen(p,'w').write(s)\nEOF\nnode tools/build.mjs | tail -1 >/dev/null; (timeout 900 node tools/test.mjs > .tmp/test-out2.txt 2>&1; echo \"exit $?\" >> .tmp/test-out2.txt) & \nsleep 2; echo bg"}}}
