gameplay can wait: if (talk.update(dt)) return; */\n  update(dt) {\n    if (!this.open) return false;\n    const inp = this.game.input, len = this.pageLen, prev = Math.floor(this.shown), mk = this._fx && this._fx[this.i];\n    if (!mk) this.shown = Math.min(len, this.shown + this.speed * dt);\n    else for (let t = dt; t > 1e-9 && this.shown < len;) {   // markup: each letter at its speed, its pause before it\n      const n = Math.floor(this.shown);\n      if (this._hold > 0) { const u = Math.min(t, this._hold); this._hold -= u; t -= u; continue; }\n      if (mk.wait[n] && this._held < n) { this._held = n; this._hold = mk.wait[n]; continue; }\n      const sp = (mk.fx[n] && mk.fx[n].s) || this.speed, u = Math.min(t, (n + 1 - this.shown) / sp);\n      this.shown = Math.min(len, this.shown + u * sp); t -= u; if (n + 1 - this.shown < 1e-6) this.shown = n + 1;\n    }\n    if (this.voice && Math.floor(this.shown) > prev && (this._blip++ % 2 === 0)) this.game.audio.sfx(this.voice);\n    const last = this.i >= this.pages.length - 1, asking = last && this.choices && !this.typing;\n    if (this.auto && !this.choices && !this.typing && (this._wait += dt) >= this.auto) {   // pages turn and the box closes by itself\n      this._wait = 0;\n      if (last) { this.open = false; if (this.onDone) this.onDone(); } else { this.i++; this.shown = 0; this._held = -1; }\n2269:E.PLAYER_COLORS = ['#4a8aff', '#ff4a4a', '#4ad860', '#ffd040'];\n7861:class Backdrop {\n58: *    plays it back headless, exactly, and stops where it differs (game.stateHash = () => [...] sharpens that).\n59: * 11. TESTS. new E.Game({ headless: true }) (the default in Node) runs with no screen: game.advance(1) runs 120 fixed\n66: *    template game with a headless test.\n162:/** a new canvas of w x h pixels (scratch images and sprite sheets). With no document (Node: a headless game) a stand-in\n633:   *  headless game's, sized as a 1280 x 720 window would size it, with nothing to draw on */\n635:    /** canvas: the page's canvas (null in a headless game); o: the sizing options (the game's o) */\n637:    /** buf: the low-resolution buffer the game draws into (W + 2 by H + 2 pixels; null when headless); ctx: its 2D\n745:  /** signal: an AbortSignal that removes every listener this adds (game.dispose()). A screen without a canvas (headless)\n1474:    if (!game.headless) { this._cv = mkCanvas(8, 8); this._g = this._cv.getContext('2d'); this.refresh(); }   // (a headless game never draws)\n2272:   * new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu,\n2280:   * - headless: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default):\n2296:    /** true for a game with no display (o.headless, or no DOM: Node) */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01J79DSDSVMNyGSLyySRiELj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
