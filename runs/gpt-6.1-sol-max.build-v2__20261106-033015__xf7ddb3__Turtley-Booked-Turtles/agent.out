{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace(\\\"game.input.touchButtons([])\\\",\\\"game.input.touchButtons(['bomb']);game.input.touchSet('bomb','POP',false)\\\")\ns=s.replace(\\\"if(app.driver){for(const p of r.players)inputs[p.seat]=app.driver(r,p.seat)||{};}\\\\n        \\\",\\\"\\\")\n# Online touch uses the same contextual assistance, with acceptance owned by host.\ns=s.replace(\\\"if(app.net){const intent=app.net.info.server?{}:ui.screen?{}:intention(game.input,app.net.info.me);app.net.update\\\", \\\"if(app.net){let intent=app.net.info.server?{}:ui.screen?{}:intention(game.input,app.net.info.me);\\\\n      const st=app.net.state,p=st?.players.find(p=>p.seat===app.net.info.me);if(p&&game.input.lastDevice==='touch'){const near=st.enemies.some(b=>b.stun<=0&&b.emerge<=0&&Math.hypot(p.x-b.x,p.y-b.y)<2.5);game.input.touchSet('bomb','POP',near&&st.stock>0&&\"'!st.bomb);if(!ui.screen&&S.assist&&near&&!st.bomb&&st.stock>0&&st.enemies.some(b=>b.stun<=0&&b.emerge<=0&&Math.hypot(p.x-b.x,p.y-b.y)<1.15))intent={...intent,bomb:true,bombSeq:++app.bombSeq};}else game.input.touchSet('\"'bomb','POP',false);\\\\n      app.net.update\\\")\nopen(p,'w').write(s)\np='src/sim.js';s=open(p).read().replace(\\\"constructor(){this.goals={};this.seq=0;}\\\",\\\"constructor(o={}){this.goals={};this.seq=0;this.defence=o.defence||2.1;}\\\")\ns=s.replace(\\\"const bomb=near<2.1\\\", \\\"const bomb=near<this.defence\\\")\ns=s.replace(\\\"if(\"'!bomb&&near<3.1)\",\"if(!bomb&&near<Math.max(3.1,this.defence+.5))\")\nopen(p,'\"'w').write(s)\np='src/net.js';s=open(p).read().replace(\\\"this.state=null;this.predict=null;\\\", \\\"this.state=null;this.intentHistory=[];this.predict=null;\\\")\ns=s.replace(\\\"this.state=this.run.snapshot();this.api.send\\\", \\\"this.state=this.run.snapshot();this.state.at=this.api.time();this.state.ack=Object.fromEntries(Object.entries(this.accepted).map(([k,v])=>[k,v.seq]));this.api.send\\\")\ns=s.replace(\\\"this.predict={...p,m:mvr,prev:[p.x,p.y],bufferTime:0};}\\\", \\\"this.predict={...p,m:mvr,prev:[p.x,p.y],bufferTime:0};\\\\n          if(s.phase==='playing'&&p.hurt<=0&&Number.isFinite(s.at)){const map=T.makeMap(T.FLOORS[s.floor]),grid=My3D2dge.Grid.from(map),now=this.api.time();let last={dir:null};for(const h of this.intentHistory)if(h.at<=s.at)last=h;\\\\n            for(let at=Math.max(s.at,now-200);at<now;at+=1000/120){for(const h of this.intentHistory)if(h.at<=at)last=h;T.move(this.predict,1/120,grid,last.dir,s.balance.playerSpeed*(p.carried?s.balance.carrySpeed:1));}}\\\\n        }\\\")\ns=s.replace(\\\"if(this.ended)return;this.time+=dt;\\\", \\\"if(this.ended)return;this.time+=dt;this.intentHistory.push({at:this.api.time(),dir:intent.dir||null});if(this.intentHistory.length>80)this.intentHistory.shift();\\\")\ns=s.replace(\\\"r.players=s.players.map(actor);r.enemies=s.enemies.map(actor);return r;\\\", \\\"r.players=s.players.map(actor);r.enemies=s.enemies.map(actor);if(this.predict){const p=r.players.find(p=>p.seat===this.info.me);if(p){p.m=this.predict.m;p.facing=this.predict.facing;}}return r;\\\")\nopen(p,'w').write(s)\np='tests/network.mjs';s=open(p).read().replace(\\\"bot=new T.Bot;\\\", \\\"bot=new T.Bot({defence:3.8});\\\")\nopen(p,'w').write(s)\nPY\nnpm run build && npm run verify -- network\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
