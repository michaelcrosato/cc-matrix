{"type":"item.completed","item":{"id":"item_148","type":"command_execution","command":"/bin/bash -lc \"rg -n 'seed:|coop.*\\\\[0|ENEMY_SPEEDS|Nine unique|critical' tests/network.mjs tests/rules.mjs src/content.js tools/interview.mjs docs/validation.md && sed -n '65,90p' tests/audio.py && sed -n '1,65p' tests/audio.py && cat tests/hub_campaign.py\"","aggregated_output":"tests/network.mjs:210:\t\t\tseed: i + 1,\ntests/network.mjs:215:\t\t\t{ server: true, seed: 3, loss: 0, latency: 0 },\ntests/network.mjs:216:\t\t\t{ server: true, seed: 9, loss: 0.05, latency: 0.15 },\ntools/interview.mjs:30:\t\t\"Nine unique product issues, all fixed; legitimate bot losses and automation-driver mistakes are recorded separately.\",\ntools/interview.mjs:31:\t\t\"Three critical issues: initial boot syntax, a namespace initialization regression during cleanup, and a Hub-only presentation update error.\",\ntests/rules.mjs:80:\t\tconst a = new T.Run({ seed: 11 }),\ntests/rules.mjs:81:\t\t\tb = new T.Run({ seed: 11 });\ntests/rules.mjs:497:\t[\"coop\", [0, 1], 2],\nsrc/content.js:19:\tT.ENEMY_SPEEDS = Object.freeze({ blue: 1.8, yellow: 2.1, red: 2.4 });\ndocs/validation.md:22:Nine unique product issues; three critical. Failed pilot games are legitimate losses rather than product defects. Two automation errors (synthetic pointers without real capture, and ending the wrong C [... omitted end of long line]\nimport json\nimport pathlib\nimport sys\nfrom playwright.sync_api import sync_playwright\nroot=pathlib.Path(__file__).resolve().parents[1]\ncount=0\nfailures=[]\ntry:\n with sync_playwright() as p:\n  browser=p.chromium.launch(headless=True)\n  page=browser.new_page()\n  page.goto((root/'build/game.html').as_uri())\n  page.get_by_role('button',name='Check in • Solo',exact=True).click()\n  report=page.evaluate('''async()=>{\n    const results=[];const test=(name,pass)=>results.push({name,pass});\n    async function render(bus,volume=1,mute=false){\n      const ctx=new OfflineAudioContext(1,22050,22050),A=Object.create(Object.getPrototypeOf(TB.app.game.audio));\n      Object.assign(A,{ctx,_waves:{},_rnd:()=>.4,volume:1,musicVolume:bus==='music'?volume:1,sfxVolume:bus==='sfx'?volume:1,voiceVolume:bus==='voice'?volume:1,muted:mute,_ins:{'turtle-voice':TB.formant}});\n      A._master=ctx.createGain();A._master.connect(ctx.destination);for(const [n,key] of [['sfx','_sfxBus'],['music','_musBus'],['voice','_voiceBus']]){A[key]=ctx.createGain();A[key].connect(A._master);}A.applyVolume();\n      const target=bus==='music'?A._musBus:bus==='voice'?A._voiceBus:A._sfxBus;\n      if(bus==='voice')TB.formant(ctx,target,.01,330,.25,.15);\n      else if(bus==='music'){for(let i=0;i<4;i++)A._voice({wave:'triangle',freq:[293.66,369.99,440,369.99][i],dur:.12,vol:.2},target,.01+i*.15);}\n      else {A._voice(TB.app.game.audio.presets['tb-delivery'],target,.01);A._voice(TB.app.game.audio.presets['tb-hit'],target,.45);}\n      const data=(await ctx.startRendering()).getChannelData(0);let peak=0,sum=0,finite=true;for(const x of data){finite=finite&&Number.isFinite(x);peak=Math.max(peak,Math.abs(x));sum+=x*x;}return {peak,rms:Math.sqrt(sum/data.length),finite};\n    }\n    for(const bus of ['music','sfx','voice']){const full=await render(bus),zero=await render(bus,0),muted=await render(bus,1,true);test(bus+' finite audible signal',full.finite&&full.rms>.001&&full.peak<1);test(bus+' volume zero silent',zero.peak===0);test(bus+' master mute silent',muted.peak===0);}\n    const loud=await render('music',1),quiet=await render('music',.1);test('10 percent music gain measured',Math.abs(quiet.rms/loud.rms-.1)<.0001);\n    const a=TB.app;test('persistent music default matches actual bus',a.game.settings.music===.1&&a.game.audio.musicVolume===.1&&Math.abs(a.game.audio.bus('music').gain.value-.1)<.001);\n    const song=a.game.audio.song;for(let i=0;i<8;i++)a.sound.music(true);test('no duplicate music graph on repeated starts',a.game.audio.song===song);\n    a.sound.stop();test('music and gibberish nodes stop',a.game.audio.song===null&&a.sound.nodes.size===0);\n    return results;\n  }''')\n  count=len(report)\n  failures=[x['name'] for x in report if not x['pass']]\n  (root/'build/audio-evidence.json').write_text(json.dumps(report,indent=2))\n  browser.close()\nexcept Exception as e:\n failures.append(str(e))\nprint(json.dumps({'count':count,'failures':failures}))\nsys.exit(1 if failures else 0)\nimport functools\nimport http.server\nimport json\nimport pathlib\nimport sys\nimport threading\nfrom playwright.sync_api import sync_playwright\nroot=pathlib.Path(__file__).resolve().parents[1]\nclass Handler(http.server.SimpleHTTPRequestHandler):\n def log_message(self,*a):pass\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(Handler,directory=str(root)))\nthreading.Thread(target=server.serve_forever,daemon=True).start()\ncount=0\nfailures=[]\nreport={}\ntry:\n with sync_playwright() as p:\n  browser=p.chromium.launch(headless=True)\n  page=browser.new_page(viewport={'width':1400,'height':900})\n  page.clock.install()\n  page.goto(f'http://127.0.0.1:{server.server_port}/vendor/hub/harness.html?game=/build/game.html&players=2&scenario=server&seed=8&limit=900')\n  page.wait_for_function('document.querySelectorAll(\"iframe\").length===3')\n  for frame in page.frames[1:]:\n   frame.wait_for_function('!!window.TB?.app.net')\n   frame.evaluate('''()=>{const a=TB.app,bot=new TB.Bot;a.game._frame=()=>{};a.sound.stop();\n    a.driver=(_rendered,seat)=>{const host=[...parent.document.querySelectorAll('iframe')].map(f=>f.contentWindow).find(w=>w.TB?.app.net?.info.isHost);const r=host?.TB.app.net.run;if(!r)return {};return bot.intent(r,r.players.find(p=>p.seat===seat));};}''')\n  page.clock.pause_at(page.evaluate('Date.now()+100'))\n  page.locator('#release').dispatch_event('click')\n  floors=set()\n  for i in range(18000):\n   page.clock.run_for(32)\n   if i%15:continue\n   frames=[f for f in page.frames[1:] if 'game.html' in f.url]\n   states=[f.evaluate('({server:TB.app.net.info.server,host:TB.app.net.info.isHost,state:TB.app.net.state,finished:TB.app.net.finished,ended:TB.app.net.ended,errors:TB.app.game.errors})') for f in frames]\n   host=next(s for s in states if s['host'])\n   floors.add(host['state']['floor'])\n   if i%150==0:(root/'build/hub-campaign-progress.json').write_text(json.dumps({'virtualSecond':i*.032,'floor':host['state']['floor'],'phase':host['state']['phase'],'rescued':host['state']['rescued'],'lives':host['state']['lives'],'elapsed':host['state']['elapsed'],'errors':host['errors']}))\n   if host['finished'] or host['ended']:\n    page.clock.run_for(500)\n    states=[f.evaluate('({server:TB.app.net.info.server,host:TB.app.net.info.isHost,state:TB.app.net.state,finished:TB.app.net.finished,ended:TB.app.net.ended,errors:TB.app.game.errors})') for f in frames]\n    report={'copies':states,'round':page.locator('#round').inner_text(),'log':page.locator('#log').inner_text(),'floors':list(floors)}\n    break\n  count=5\n  if not report:failures.append('Full harness campaign exceeded time limit')\n  else:\n   h=next(s for s in report['copies'] if s['host'])\n   if h['state']['rescued']!=26 or h['state']['lives']<=0:failures.append('Full shared-world harness campaign did not win: '+json.dumps({k:h['state'][k] for k in ['phase','rescued','lives','floor','elapsed']}))\n   if len(floors)!=5:failures.append('Not every floor reached through harness')\n   if not all(s['state']['rescued']==26 and s['state']['score']==h['state']['score'] for s in report['copies']):failures.append('Final objective state differs across copies')\n   if 'Ended played' not in report['round']:failures.append('Harness did not record played result')\n   if any(s['errors'] for s in report['copies']):failures.append('Draw/runtime errors in full harness campaign')\n  browser.close()\nexcept Exception as e:failures.append(str(e))\nfinally:\n server.shutdown();server.server_close()\n(root/'build/full-hub-campaign.json').write_text(json.dumps(report,indent=2))\nprint(json.dumps({'count':count,'failures':failures}))\nsys.exit(1 if failures else 0)\n","exit_code":0,"status":"completed"}}
