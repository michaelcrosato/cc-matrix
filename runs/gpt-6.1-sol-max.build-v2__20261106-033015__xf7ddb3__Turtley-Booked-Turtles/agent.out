      }).sort((a,b)=>a.score-b.score);\n        if(ranked[0])dir=ranked[0].d;\n      }\n      return {dir,bomb,bombSeq:bomb?++this.seq:undefined};\n    }\n    inputs(run){const out={};for(const p of run.players)out[p.seat]=this.intent(run,p);return out;}\n  }\n  T.Bot=Bot;\n})(globalThis.TB);\nJS\nnode --input-type=module <<'\"'JS'\nimport vm from 'node:vm';import fs from 'node:fs';const c=vm.createContext({console});for(const f of ['vendor/engine/my-3d2dge.js','src/content.js','src/sim.js'])vm.runInContext(fs.readFileSync(f,'utf8'),c);for(const seats of [[0],[0,1]]){const r=new c.TB.Run({seats,seed:2701}),bot=new c.TB.Bot;let last=-1;for(let i=0;i<120*1200&&\"'!['\"'won','lost'].includes(r.phase);i++){r.step(1/120,bot.inputs(r));if(last\"'!==r.floor){last=r.floor;console.log('\"'floor',seats.length,last,'lives',r.lives,'t',r.elapsed);}}console.log(r.phase,r.rescued,r.elapsed,r.stats,r.players.map(p=>[p.m.x,p.m.y,p.carried]),r.enemies.map(b=>[b.m.x,b.m.y,b.state]));}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > src/sim.js <<'JS'\n(function(T){\n  'use strict';\n  const E=My3D2dge;\n  function hash(s){let h=2166136261;for(const c of String(s))h=Math.imul(h\"'^c.charCodeAt(0),16777619);return h>>>0;}\n  class Stream {\n    constructor(seed,label){this.state=hash(seed+'\"':'+label)||1;}\n    next(){let a=this.state=(this.state+0x6d2b79f5)>>>0;let t=Math.imul(a\"'^(a>>>15),a|1);t''^=t+Math.imul(t''^(t>>>7),t|61);return ((t''^(t>>>14))>>>0)/4294967296;}\n  }\n  T.Stream=Stream;\n  T.swept=function(a,b){\n    const x=a.prev[0]-b.prev[0],y=a.prev[1]-b.prev[1];\n    const dx=(a.m.x-b.m.x)-x,dy=(a.m.y-b.m.y)-y;\n    const u=Math.max(0,Math.min(1,-(x*dx+y*dy)/(dx*dx+dy*dy||1)));\n    return Math.hypot(x+dx*u,y+dy*u);\n  };\n  T.move=function(a,dt,grid,want,speed){\n    const m=a.m;a.prev=[m.x,m.y];m.speed=speed;\n    // Extend the native mover with an immediate mid-edge reversal; the graph stays authoritative.\n    if(want&&m.moving&&want[0]===-m.dir[0]&&want[1]===-m.dir[1]){\n      const old=[m.cx,m.cy];[m.cx,m.cy]=m._to;m._to=old;m._u=1-m._u;m.dir=want.slice();m._want=want.slice();\n    }\n    if(want){a.buffer=want.slice();a.bufferTime=.24;}else a.bufferTime=Math.max(0,(a.bufferTime||0)-dt);\n    if(!want&&a.bufferTime<=0)m._want=null;\n    const request=want||a.bufferTime>0&&a.buffer||null;\n    m.update(dt,grid,request,{keep:!!want});\n    a.walk=Math.hypot(m.x-a.prev[0],m.y-a.prev[1])/Math.max(dt,.0001);\n    if(a.walk>.01)a.facing=Math.atan2(m.dir[1],m.dir[0]);\n  };\n  const body=(id,cell,speed)=>({id,m:new E.GridMover({cx:cell[0],cy:cell[1],speed}),prev:cell.slice(),facing:-Math.PI/2,walk:0,bufferTime:0});\n  class Run {\n    constructor(o={}){\n      this.seed=o.seed??2701;this.runId=o.runId||String(this.seed);this.mode=o.mode||'\"'solo';this.seats=(o.seats||[0]).slice().sort((a,b)=>a-b);\n      this.balance={...T.DEFAULTS};this.demo=\"'!!o.demo;this.practice=false;this.assisted=!!o.assisted;this.god=false;\n      this.score=0;this.lives=3;this.rescued=0;this.elapsed=0;this.tick=0;this.eventId=0;this.events=[];this.history=[];this.stock=3;this.damageGrace=0;\n      this.stats={discoveries:0,deliveries:0,plants:0,triggers:0,stuns:0,refills:0,hits:0,decoys:0,escalations:0};\n      this.floor=0;this.startFloor(o.floor||0);\n    }\n    emit(type,data={}){\n      const ev={id:++this.eventId,tick:this.tick,floor:this.floor,type,...data};this.events.push(ev);this.history.push(ev);if(this.history.length>80)this.history.shift();return ev;\n    }\n    startFloor(n){\n      this.floor=n;this.content=T.FLOORS[n];this.map=T.makeMap(this.content);this.grid=E.Grid.from(this.map);\n      this.phase='\"'intro';this.phaseTime=2;this.floorTime=0;this.delivered=0;this.bomb=null;this.supply={ready:true,timer:0};this.damageGrace=1;\n      this.players=this.seats.map((seat,i)=>({...body('p'+seat,this.content.spawns[i%2],3.5),seat,carried:null,home:null,invuln:2,hurt:0,emote:0,supplyInside:false,bombSeq:-1,route:null,active:true}));\n      const rng=new Stream(this.seed,'rooms-'+n), deck=Array.from({length:this.content.rooms.length},(_,i)=>i<this.content.quota?'baby':'beetle');\n      // The teaching room is fixed; other outcomes are seeded once and never rerolled.\n      for(let i=deck.length-1;i>1;i--){const j=1+Math.floor(rng.next()*i);[deck[i],deck[j]]=[deck[j],deck[i]];}\n      this.rooms=this.content.rooms.map((cell,i)=>({id:'f'+n+'r'+i,cell:cell.slice(),kind:deck[i],status:'hidden',discovered:false,symbol:i%4}));\n      this.homes=this.content.homes.map((cell,i)=>({id:i,cell:cell.slice(),reserved:null,seat:null,glow:0}));\n      this.enemies=this.content.enemies.map((e,i)=>this.makeEnemy(e.cell,e.age,'f'+n+'b'+i));\n      this.emit('floor',{name:this.content.name});\n    }\n    makeEnemy(cell,age=0,id='f'+this.floor+'b'+this.enemies.length){\n      return {...body(id,cell,2.2),age,state:age>=this.balance.redAt?'red':age>=this.balance.yellowAt?'yellow':'blue',stun:0,emerge:1.1,target:null,lastSeen:null,sighted:false,warned:0,scored:false,rng:new Stream(this.seed,id)};\n    }\n    setBalance(key,value){\n      const sp=T.SLIDERS.find(s=>s[0]===key);if(\"'!sp||!Number.isFinite(value))return;\n      this.balance[key]=Math.min(sp[3],Math.max(sp[2],value));\n      if(this.balance.redAt<this.balance.yellowAt+3){if(key==='\"'redAt')this.balance.yellowAt=this.balance.redAt-3;else this.balance.redAt=this.balance.yellowAt+3;}\n      this.practice=true;this.emit('practice');\n    }\n    resetBalance(){this.balance={...T.DEFAULTS};}\n    leave(seat){\n      const p=this.players.find(p=>p.seat===seat);if(\"'!p||!p.active)return;this.drop(p);p.active=false;p.route=null;\n      this.seats=this.seats.filter(s=>s!==seat);this.emit('\"'leave',{seat});\n    }\n    drop(p){\n      if(p.carried){const room=this.rooms.find(r=>r.id===p.carried);if(room)room.status='revealed';}\n      for(const h of this.homes)if(h.seat===p.seat){h.reserved=null;h.seat=null;}\n      p.carried=null;p.home=null;\n    }\n    reveal(p){\n      if(p.carried||p.hurt>0)return;\n      const room=this.rooms.find(r=>(r.status==='hidden'||r.status==='revealed')&&Math.hypot(p.m.x-r.cell[0],p.m.y-r.cell[1])<.18);if(\"'!room)return;\n      if(room.kind==='\"'beetle'){\n        room.status='empty';const b=this.makeEnemy(room.cell,0,'f'+this.floor+'d'+room.id);b.emerge=1.4;this.enemies.push(b);this.stats.decoys++;this.emit('decoy',{room:room.id,x:room.cell[0],y:room.cell[1]});return;\n      }\n      const open=this.homes.filter(h=>h.reserved===null&&this.grid.path(room.cell,h.cell).length);\n      open.sort((a,b)=>this.grid.path(room.cell,b.cell).length-this.grid.path(room.cell,a.cell).length||a.id-b.id);\n      const home=open[0];if(\"'!home){this.emit('\"'reservation-error',{seat:p.seat});return;}\n      home.reserved=room.id;home.seat=p.seat;p.carried=room.id;p.home=home.id;p.emote=.7;room.status='carried';\n      if(\"'!room.discovered){room.discovered=true;this.score+=100;this.stats.discoveries++;}\n      this.emit('\"'pickup',{seat:p.seat,room:room.id,home:home.id,symbol:room.symbol,x:p.m.x,y:p.m.y});\n    }\n    deliver(p){\n      if(\"'!p.carried||p.hurt>0)return;\n      const home=this.homes.find(h=>h.id===p.home);if(!home||home.reserved!==p.carried)return;\n      if(Math.hypot(p.m.x-home.cell[0],p.m.y-home.cell[1])>.24)return;\n      const room=this.rooms.find(r=>r.id===p.carried);room.status='\"'delivered';home.reserved=null;home.seat=null;home.glow=1.5;\n      const rid=p.carried;p.carried=null;p.home=null;p.emote=.6;this.score+=400;this.delivered++;this.rescued++;this.stats.deliveries++;\n      this.emit('delivery',{seat:p.seat,room:rid,home:home.id,x:p.m.x,y:p.m.y,points:400});\n    }\n    plant(p,intent){\n      if(\"'!intent?.bomb||p.hurt>0||!p.active)return false;\n      const seq=intent.bombSeq??this.tick;\n      if(seq<=p.bombSeq)return false;p.bombSeq=seq;\n      if(this.bomb){this.emit('\"'busy',{seat:p.seat});return false;}\n      if(this.stock<=0){this.emit('empty',{seat:p.seat,x:this.content.supply[0],y:this.content.supply[1]});return false;}\n      this.stock--;this.bomb={id:'bomb'+this.tick,x:p.m.x,y:p.m.y,timer:this.balance.bombLife,seat:p.seat};p.emote=.24;\n      this.stats.plants++;this.emit('plant',{seat:p.seat,x:p.m.x,y:p.m.y});return true;\n    }\n    los(a,b){\n      const ac=[Math.round(a.m.x),Math.round(a.m.y)],bc=[Math.round(b.m.x),Math.round(b.m.y)];\n      if(ac[0]\"'!==bc[0]&&ac[1]!==bc[1])return false;\n      const dx=Math.sign(bc[0]-ac[0]),dy=Math.sign(bc[1]-ac[1]);let [x,y]=ac;\n      for(let i=0;i<30;i++){if(!this.map.walkable(x,y))return false;if(x===bc[0]&&y===bc[1])return true;x+=dx;y+=dy;}return false;\n    }\n    target(b){\n      const valid=this.players.filter(p=>p.active&&p.hurt<=0);\n      const costs=valid.map(p=>({p,d:this.grid.path(T.cell(b),T.cell(p)).length||999})).sort((a,b)=>a.d-b.d||a.p.seat-b.p.seat);\n      if(!costs.length)return null;\n      const current=costs.find(c=>c.p.seat===b.target), best=current&&current.d<=costs[0].d+2?current:costs[0];b.target=best.p.seat;return best.p;\n    }\n    choose(b){\n      const m=b.m,cell=[m.cx,m.cy];let goal=null;\n      if(b.state==='\"'red'){const p=this.target(b);if(p)goal=T.cell(p);}\n      if(b.state==='yellow'){\n        const seen=this.players.filter(p=>p.active&&p.hurt<=0&&this.los(b,p)).sort((a,c)=>T.dist(cell,T.cell(a))-T.dist(cell,T.cell(c))||a.seat-c.seat)[0];\n        if(seen){b.lastSeen=T.cell(seen);if(\"'!b.sighted)this.emit('\"'sight',{enemy:b.id,seat:seen.seat,x:m.x,y:m.y});b.sighted=true;}else b.sighted=false;\n        goal=b.lastSeen;if(goal&&T.same(goal,cell)){b.lastSeen=null;goal=null;}\n      }\n      if(goal){const path=this.grid.path(cell,goal);if(path.length>1)return [path[1][0]-m.cx,path[1][1]-m.cy];}\n      let ways=T.DIRS.filter(d=>this.grid.walk([m.cx+d[0],m.cy+d[1]]));\n      const forward=ways.filter(d=>d[0]\"'!==-m.dir[0]||d[1]!==-m.dir[1]);if(forward.length)ways=forward;\n      return ways[Math.floor(b.rng.next()*ways.length)]||null;\n    }\n    updateEnemy(b,dt){\n      b.prev=[b.m.x,b.m.y];\n      if(b.emerge>0){b.emerge-=dt;return;}\n      if(b.stun>0){b.stun-=dt;b.walk=0;if(b.stun<=0){b.age=0;b.state='\"'blue';b.warned=0;b.lastSeen=null;b.target=null;this.emit('recovery',{enemy:b.id,x:b.m.x,y:b.m.y});}return;}\n      b.age+=dt;const state=b.age>=this.balance.redAt?'red':b.age>=this.balance.yellowAt?'yellow':'blue';\n      if(state\"'!==b.state){b.state=state;this.stats.escalations++;this.emit('\"'escalate',{enemy:b.id,state,x:b.m.x,y:b.m.y});}\n      const warning=b.age>=this.balance.redAt-1?2:b.age>=this.balance.yellowAt-1?1:0;\n      if(warning>b.warned){b.warned=warning;this.emit('warning',{enemy:b.id});}\n      const want=b.m.moving?null:this.choose(b);\n      b.m.speed=({blue:2.2,yellow:2.6,red:2.9}[b.state])*this.balance.enemySpeed;\n      b.m.update(dt,this.grid,want,{keep:false});b.walk=Math.hypot(b.m.x-b.prev[0],b.m.y-b.prev[1])/dt;\n      if(b.walk>.01)b.facing=Math.atan2(b.m.dir[1],b.m.dir[0]);\n    }\n    hit(p){\n      if(this.god||this.demo||p.invuln>0||p.hurt>0||this.damageGrace>0)return;\n      this.lives--;this.stats.hits++;this.damageGrace=1.1;p.hurt=.85;p.invuln=3.5;p.route=null;this.drop(p);\n      this.bomb=null;this.emit('hit',{seat:p.seat,x:p.m.x,y:p.m.y,lives:this.lives});\n      if(this.lives<=0){this.phase='lost';this.phaseTime=0;this.emit('loss');}\n    }\n    safeRespawn(p){\n      const danger=c=>Math.min(...this.enemies.filter(b=>b.stun<=0&&b.emerge<=0).map(b=>Math.hypot(b.m.x-c[0],b.m.y-c[1])),99);\n      const places=this.content.spawns.concat(this.content.homes).filter(c=>this.map.walkable(...c));\n      places.sort((a,b)=>danger(b)-danger(a));const c=places[0];p.m.place(...c);p.prev=c.slice();p.bufferTime=0;p.route=null;p.invuln=2.5;\n      this.emit('respawn',{seat:p.seat,x:c[0],y:c[1]});\n    }\n    routeDir(p,target){\n      const dest=Array.isArray(target)?target:p.route;if(\"'!dest)return null;\n      if(!this.grid.walk(dest))return null;\n      const from=p.m.moving?p.m._to:[p.m.cx,p.m.cy];\n      const path=this.grid.path(from,dest);\n      if(path.length>1)return [path[1][0]-from[0],path[1][1]-from[1]];\n      if(p.m.moving)return p.m.dir.slice();p.route=null;return null;\n    }\n    step(dt,intents={}){\n      this.events=[];this.tick++;\n      if(['\"'lost','won','ended'].includes(this.phase))return;\n      if(this.phase\"'!=='\"'playing'){\n        this.phaseTime-=dt;\n        if(Object.values(intents).some(i=>i?.confirm))this.phaseTime=Math.min(this.phaseTime,0);\n        if(this.phaseTime<=0){\n          if(this.phase==='intro'){this.phase='playing';this.emit('begin');}\n          else if(this.phase==='clear'){if(this.floor<4)this.startFloor(this.floor+1);else {this.phase='celebration';this.phaseTime=5;this.emit('celebration');}}\n          else if(this.phase==='celebration'){this.phase='won';this.emit('victory');}\n        }return;\n      }\n      this.elapsed+=dt;this.floorTime+=dt;this.damageGrace=Math.max(0,this.damageGrace-dt);\n      for(const h of this.homes)h.glow=Math.max(0,h.glow-dt);\n      // Stable order: recharge/timers, seat movement, bomb accepts, enemy movement, bomb triggers,\n      // damaging contacts, seat reveals/deliveries, then commit one clear/terminal phase.\n      if(\"'!this.supply.ready){this.supply.timer-=dt;if(this.supply.timer<=0){this.supply.ready=true;this.emit('\"'supply-ready');}}\n      if(this.bomb&&(this.bomb.timer-=dt)<=0){this.emit('expire',{x:this.bomb.x,y:this.bomb.y});this.bomb=null;}\n      for(const p of this.players){\n        if(\"'!p.active)continue;\n        p.invuln=Math.max(0,p.invuln-dt);p.emote=Math.max(0,p.emote-dt);\n        if(p.hurt>0){p.hurt-=dt;p.prev=[p.m.x,p.m.y];if(p.hurt<=0)this.safeRespawn(p);continue;}\n        const intent=intents[p.seat]||{};\n        if(intent.route&&Array.isArray(intent.route)&&intent.route.every(Number.isInteger)&&this.grid.walk(intent.route))p.route=intent.route.slice();\n        let dir=intent.dir;\n        if(!Array.isArray(dir)||dir.length!==2||!dir.every(Number.isFinite)||Math.abs(dir[0])+Math.abs(dir[1])!==1)dir=null;\n        if(dir)p.route=null;else if(p.route)dir=this.routeDir(p);\n        T.move(p,dt,this.grid,dir,this.balance.playerSpeed*(p.carried?this.balance.carrySpeed:1));\n        this.plant(p,intent);\n        const inside=Math.hypot(p.m.x-this.content.supply[0],p.m.y-this.content.supply[1])<.4;\n        if(inside&&!p.supplyInside&&this.supply.ready&&this.stock<5){this.stock=Math.min(5,this.stock+2);this.supply.ready=false;this.supply.timer=this.balance.recharge;this.stats.refills++;this.emit('\"'refill',{seat:p.seat,x:p.m.x,y:p.m.y});}\n        p.supplyInside=inside;\n      }\n      for(const b of this.enemies)this.updateEnemy(b,dt);\n      if(this.bomb){\n        const bomb=this.bomb,stationary={prev:[bomb.x,bomb.y],m:{x:bomb.x,y:bomb.y}};\n        const trigger=this.enemies.some(b=>b.emerge<=0&&b.stun<=0&&T.swept(b,stationary)<.48);\n        if(trigger){\n          for(const b of this.enemies)if(b.emerge<=0&&Math.hypot(b.m.x-bomb.x,b.m.y-bomb.y)<=1.65){\n            b.stun=this.balance.stun;b.state='stunned';b.walk=0;\n            if(\"'!b.scored){b.scored=true;this.score+=50;}this.stats.stuns++;\n          }\n          this.stats.triggers++;this.emit('\"'trigger',{x:bomb.x,y:bomb.y,radius:1.65});this.bomb=null;\n        }\n      }\n      for(const p of this.players){if(\"'!p.active||p.hurt>0)continue;\n        for(const b of this.enemies)if(b.emerge<=0&&b.stun<=0&&T.swept(p,b)<.53){this.hit(p);break;}\n        if(this.phase==='\"'lost')return;\n      }\n      for(const p of this.players)if(p.active){this.reveal(p);this.deliver(p);}\n      if(this.delivered===this.content.quota&&\"'!this.players.some(p=>p.carried)){\n        this.score+=250;this.phase='\"'clear';this.phaseTime=2.6;this.bomb=null;this.emit('clear',{points:250});\n      }\n    }\n    snapshot(){\n      const actor=a=>({id:a.id,x:+a.m.x.toFixed(4),y:+a.m.y.toFixed(4),cx:a.m.cx,cy:a.m.cy,to:a.m._to,u:a.m._u,moving:a.m.moving,dir:a.m.dir,facing:a.facing,walk:a.walk});\n      return {v:1,run:this.runId,seed:this.seed,tick:this.tick,eventId:this.eventId,floor:this.floor,phase:this.phase,phaseTime:this.phaseTime,score:this.score,lives:this.lives,stock:this.stock,rescued:this.rescued,delivered:this.delivered,elapsed:this.elapsed,floorTime:this.floorTime,\n        demo:this.demo,practice:this.practice,assisted:this.assisted,balance:{...this.balance},stats:{...this.stats},bomb:this.bomb&&{...this.bomb},supply:{...this.supply},\n        players:this.players.map(p=>({...actor(p),seat:p.seat,carried:p.carried,home:p.home,invuln:p.invuln,hurt:p.hurt,emote:p.emote,active:p.active,route:p.route})),\n        enemies:this.enemies.map(b=>({...actor(b),state:b.state,age:b.age,stun:b.stun,emerge:b.emerge,target:b.target,lastSeen:b.lastSeen,sighted:b.sighted,scored:b.scored})),\n        rooms:this.rooms.map(r=>({...r,cell:r.cell.slice()})),homes:this.homes.map(h=>({...h,cell:h.cell.slice()})),events:this.history.slice(-12)};\n    }\n  }\n  T.Run=Run;\n  // Bots use the same cardinal intentions and edge-triggered bomb action as a real player.\n  class Bot {\n    constructor(){this.goals={};this.seq=0;}\n    intent(run,p){\n      if(run.phase\"'!=='\"'playing')return {confirm:true};if(\"'!p.active||p.hurt>0)return {};\n      const cell=T.cell(p),live=run.enemies.filter(b=>b.stun<=.25&&b.emerge<=.3);\n      const near=live.reduce((d,b)=>Math.min(d,Math.hypot(p.m.x-b.m.x,p.m.y-b.m.y)),99);\n      let goal=p.carried?run.homes[p.home].cell:null;\n      if(!goal){\n        const rooms=run.rooms.filter(r=>r.kind==='\"'baby'&&(r.status==='hidden'||r.status==='revealed'));\n        const other=run.players.find(q=>q\"'!==p&&q.active);\n        const scored=rooms.map(r=>({r,d:run.grid.path(cell,r.cell).length+((other&&!other.carried&&T.dist(T.cell(other),r.cell)<T.dist(cell,r.cell))?15:0)})).sort((a,b)=>a.d-b.d||a.r.id.localeCompare(b.r.id));\n        goal=scored[0]?.r.cell;\n      }\n      // Restock before attempting another long route, or on an attractive detour.\n      if(run.stock<2&&run.supply.ready&&!p.supplyInside)goal=run.content.supply;\n      if(!goal)return {};\n      let path=run.grid.path(p.m.moving?p.m._to:[p.m.cx,p.m.cy],goal),dir=null;\n      if(path.length>1)dir=[path[1][0]-path[0][0],path[1][1]-path[0][1]];\n      else if(p.m.moving)dir=p.m.dir.slice();\n      const bomb=near<2.1&&!run.bomb&&run.stock>0;\n      // With no defensive slot, route around approaching threats using weighted A* over the same graph.\n      if(!bomb&&near<3.1){\n        const from=p.m.moving?p.m._to:[p.m.cx,p.m.cy];\n        const ranked=T.DIRS.filter(d=>run.grid.walk([from[0]+d[0],from[1]+d[1]])).map(d=>{\n          const c=[from[0]+d[0],from[1]+d[1]], danger=Math.min(...live.map(b=>Math.hypot(c[0]-b.m.x,c[1]-b.m.y)),99);\n          return {d,score:(run.grid.path(c,goal).length||100)+Math.max(0,3-danger)*8};\n        }).sort((a,b)=>a.score-b.score);\n        if(ranked[0])dir=ranked[0].d;\n      }\n      return {dir,bomb,bombSeq:bomb?++this.seq:undefined};\n    }\n    inputs(run){const out={};for(const p of run.players)out[p.seat]=this.intent(run,p);return out;}\n  }\n  T.Bot=Bot;\n})(globalThis.TB);\nJS\nnode --input-type=module <<'\"'JS'\nimport vm from 'node:vm';import fs from 'node:fs';const c=vm.createContext({console});for(const f of ['vendor/engine/my-3d2dge.js','src/content.js','src/sim.js'])vm.runInContext(fs.readFileSync(f,'utf8'),c);for(const seats of [[0],[0,1]]){const r=new c.TB.Run({seats,seed:2701}),bot=new c.TB.Bot;let last=-1;for(let i=0;i<120*1200&&\"'!['\"'won','lost'].includes(r.phase);i++){r.step(1/120,bot.inputs(r));if(last\"'!==r.floor){last=r.floor;console.log('\"'floor',seats.length,last,'lives',r.lives,'t',r.elapsed);}}console.log(r.phase,r.rescued,r.elapsed,r.stats,r.players.map(p=>[p.m.x,p.m.y,p.carried]),r.enemies.map(b=>[b.m.x,b.m.y,b.state]));}\nJS\"","aggregated_output":"floor 1 0 lives 3 t 0\nfloor 1 1 lives 3 t 49.71666666666449\nfloor 1 2 lives 2 t 119.51666666670785\nfloor 1 3 lives 1 t 185.73333333332874\nfloor 1 4 lives 1 t 289.3833333332345\nwon 26 415.18333333312006 {\n  discoveries: 26,\n  deliveries: 26,\n  plants: 24,\n  triggers: 18,\n  stuns: 27,\n  refills: 13,\n  hits: 2,\n  decoys: 0,\n  escalations: 35\n} [ [ 19, 1.2141666666666717, null ] ] [\n  [ 4.238333333333333, 6, 'blue' ],\n  [ 9.945, 11, 'blue' ],\n  [ 15.201666666666666, 11, 'blue' ],\n  [ 5, 9.411666666666667, 'yellow' ]\n]\nfloor 2 0 lives 3 t 0\nfloor 2 1 lives 3 t 29.733333333332286\nfloor 2 2 lives 2 t 62.46666666666376\nfloor 2 3 lives 2 t 90.04166666668439\nfloor 2 4 lives 1 t 136.26666666670707\nlost 23 160.4166666666851 {\n  discoveries: 24,\n  deliveries: 23,\n  plants: 9,\n  triggers: 6,\n  stuns: 8,\n  refills: 6,\n  hits: 3,\n  decoys: 0,\n  escalations: 12\n} [ [ 12.67, 11, null ], [ 13, 8.966666666666667, null ] ] [\n  [ 16.151666666666667, 6, 'yello