.esh button:focus{outline:2px solid #ffe4ad!important;outline-offset:3px!important;background:#385861!important}.esh button.pri{background:#e9c58d!important;color:#15333a!important}.esh button.pri:focus,.esh button.pri:hover{background:#ffe0aa!important}.esh-btns{gap:8px!important;margin-top:16px!important}.esh-tags{font-size:10px!important;gap:14px!important;letter-spacing:.08em!important}.esh-ttl .esh-m{font-size:11px!important;line-height:1.5!important;max-width:360px!important}.esh-mod{max-width:560px!important;width:min(560px,100%)!important;border-radius:8px!important;box-shadow:0 15px 80px #0006!important}.esh h2{font-size:27px!important;line-height:1.15!important;letter-spacing:-.025em!important}.esh-mod .esh-m{font-size:15px!important;line-height:1.6!important}.esh-row{font-size:15px!important;min-height:50px!important}.esh-row small{font-size:12px!important}.esh input[type=range]{min-height:38px!important}.esh output{font-size:14px!important}.esh-stats b{font-size:26px!important}.esh-grid{font-size:14px!important}.esh button,.esh input{scroll-margin:25px}.esh-keys{font-size:14px!important}.esh-emb{color:#d7e0a1!important}.esh .esh-nav{z-index:10!important}\n@media(max-width:700px){.esh-ttl{place-items:start center!important;background:linear-gradient(180deg,#0e2734f5,#0e2734ee 70%,#0e273480)!important;overflow-y:auto!important}.esh-ttl>div{padding:18px 8px!important;max-width:100%!important;width:100%!important}.esh-ttl h1{font-size:47px!important}.esh-ttl .esh-btns{max-width:340px!important}.esh-sh{padding:54px 18px 22px!important}.esh-ttl{padding-top:18px!important}.esh-tags{flex-wrap:wrap!important}.esh-mod{padding:20px!important}.esh-mod .esh-m{font-size:16px!important}.esh button{min-height:47px!important}.esh-ttl p{font-size:15px!important}.esh .esh-nav{top:5px!important}.esh-row{gap:8px!important}.esh input[type=range]{width:125px!important}}\nCSS\nnpm run build'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'JS'\n(function(T){\n  'use strict';const E=My3D2dge;\n  const PRESET={up:['KeyW','ArrowUp','Pad12','PadAxisUp'],down:['KeyS','ArrowDown','Pad13','PadAxisDown'],left:['KeyA','ArrowLeft','Pad14','PadAxisLeft'],right:['KeyD','ArrowRight','Pad15','PadAxisRight'],bomb:['Space','Mouse2','Pad0'],confirm:['Enter','Space','Pad0'],cancel:['Escape','Backspace','Pad1'],pause:['Escape','KeyP','Pad9'],start:['Enter','Pad9'],\n    halves:{left:{bomb:['Space'],confirm:['Enter','Space'],cancel:['Escape'],pause:['Escape','KeyP']},right:{bomb:['ShiftRight'],confirm:['Enter'],cancel:['Backspace'],pause:['Backspace']}};\n  const online=typeof AIHub\"'!=='\"'undefined'&&AIHub.active;\n  const game=new E.Game({id:'turtley-booked-v1',canvas:'screen',res:[400,280],expand:true,view:'overhead',views:['overhead'],input:PRESET,live:online,autoPause:\"'!online,fullscreen:'\"'button',camera:{zoom:false,start:1,tall:1},\n    menu:{quit:false,controls:{bomb:'Bug bomb'},settings:[{key:'glyphs',value:'playstation'},{key:'music',value:.10},{key:'voice',group:'Sound',label:'Turtle voices',type:'slider',value:.7,min:0,max:1,step:.05,apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},{key:'assist',label:'Touch auto-defence',group:'Game',value:true,help:'An imminent beetle triggers a bomb if the team has one. Separate assisted records.'}]}});\n  const app={game,run:null,net:null,art:new T.Art(game),sound:new T.Sound(game),bot:new T.Bot,mode:'solo',layout:'shared',latest:[],bombSeq:0,dev:{graph:false,los:false,collision:false,reveal:false},stepOnce:false,timeScale:1,lastDevice:'',resultShown:false,ending:false,attract:false,activity:0};T.app=app;\n  const cab=new E.Arcade(game,{id:'turtley-booked',idle:10,demo:1e9,scores:6,hud:false});app.cab=cab;\n  const S=game.settings;\n  function resetInputs(){for(const i of game.players)i.clear();app.latest=[];app.bombSeq=0;}\n  function seats(layout='shared'){\n    while(game.players.length>1)game.removePlayer(game.players[1]);const I=game.input;I.half=null;I._full=null;I.pad='any';I.use(PRESET);\n    if(layout==='solo')return;\n    const pads=typeof navigator\"'!=='\"'undefined'?Array.from(navigator.getGamepads?.()||[]).filter(p=>p&&p.connected\"'!==false):[];\n    if(layout==='\"'shared'){game.addPlayer({keys:'right'});I.pad=null;game.players[1].pad=null;}\n    else if(layout==='mixed'){I.pad=null;game.addPlayer({pad:pads[0]?.index??0});}\n    else {I.pad=pads[0]?.index??0;game.addPlayer({pad:pads[1]?.index??1});}\n  }\n  app.start=function(mode='solo',layout='shared',opts={}){\n    app.mode=mode;app.layout=layout;app.attract=\"'!!opts.demo;app.resultShown=false;app.ending=false;app.timeScale=1;app.stepOnce=false;\n    seats(mode==='\"'solo'?'solo':layout);ui.hide();game.resume();resetInputs();\n    app.run=new T.Run({mode:opts.demo?'demo':mode,seats:mode==='solo'?[0]:[0,1],seed:opts.seed??2701,demo:opts.demo,assisted:game.input.lastDevice==='touch'&&S.assist});\n    app.art.lastEvent=0;app.sound.last=0;app.bot=new T.Bot;\n    for(const sp of T.SLIDERS)S[sp[0]]=T.DEFAULTS[sp[0]];S.invulnerable=false;S.devFloor=0;S.devScale=1;app.dev={graph:false,los:false,collision:false,reveal:false};\n    game.go('play',null,{fade:0});app.sound.music(true);\n  };\n  app.title=function(){app.sound.stop();app.attract=false;app.run=null;app.net=null;ui.hide();game.resume();seats('solo');resetInputs();cab.wake();app.activity=game.real;game.go('title',null,{fade:0});};\n  function about(){\n    ui.show('about',{kicker:'THE SHELLTON • CREDITS',title:'Made with little shells',text:'An original hotel-rescue arcade game inspired by Turtles (1983 US Odyssey²). Game design, code, pixel bodies, animation and synthesized score created for this build. Engine by Michael Crosato (MIT).',actions:[['Source information',()=>infoPage('source')],['Testing feedback',()=>infoPage('testing')],['Engine feedback',()=>infoPage('engine')],['Prompt feedback',()=>infoPage('prompt')],['Licenses & research',()=>ui.show('provenance',{title:'Standing on friendly shells',sections:[['Engine','my-3D2dge v0.89.1 • MIT • Michael Crosato. Source commit 8ecc2f62353761187bdfe226f327b7ea5d2eb691. Full license is embedded in this HTML.'],['Hub','AI Hub Session Protocol 1, client 1.4.0, unmodified. Commit 35a1047f2067b2af3de3943f0fe452f39105d869.'],['Historical evidence','US manual: odyssey2.info/library/manuals/us_turtles/Turtles%20(USA).pdf. Release and screenshot: odyssey2.info/db/game/turtles-47. Review: odyssey2.info/reviews/turtles-117. Manual pictures and a documented screenshot were inspected. No original footage or audio was watched/heard.'],['Original work','All game art, layouts, animation, music and gibberish are procedural code; no source screenshots or audio recordings are used.']],actions:[['Back',()=>ui.back()]]})],['Back',()=>ui.back()]]});\n  }\n  app.about=about;\n  function infoPage(which){\n    const meta=T.INTERVIEW||{},questions={testing:['Issues found','Critical / game breaking','Most helpful check','Least helpful check'],engine:['Favorite engine feature','Where I guessed wrong','Most important custom system','Hardest engine integration','Engine changes','One improvement'],prompt:['Best part','Confusing part','Hardest part','Suggested change']};\n    const data=which==='source'?Object.entries(meta.sourceInformation||{date:'2026-11-06 03:30:15',source:'Turtles (1983 US Odyssey²)',plan:'PLAN.md',usage:'added on import'}):((meta[which+'Feedback']||['unknown']).map((v,i)=>[questions[which][i],v]));\n    // Paginate dense metadata into controller-sized, readable screens.\n    let page=0;const show=()=>ui.show('info-'+which,{kicker:which.toUpperCase()+' • '+(page+1)+' / '+Math.ceil(data.length/3),title:which==='source'?'Source information':which[0].toUpperCase()+which.slice(1)+' feedback',sections:data.slice(page*3,page*3+3),actions:[page>0&&['Previous',()=>{page--;show();}],(page+1)*3<data.length&&['Next',()=>{page++;show();}],['Back',()=>ui.back()]]});show();\n  }\n  function help(){ui.show('help',{kicker:'A CARETAKER’S FIELD GUIDE',title:'Every guest deserves a lift.',sections:[['01 • Knock, carry, reunite','Enter a ? room to find a hatchling or a beetle. Carry one hatchling at a time. Its symbol matches a lit home on the outer edge. Walk into that home to deliver.'],['02 • Make a little space','Plant a bug bomb in a beetle’s path. One active bomb for the entire team; three in stock to start, five maximum. A triggered bomb stuns nearby beetles and makes them blue again.'],['03 • Stay one step ahead','Blue wanders. Yellow follows a clear corridor. Red routes around corners. The central + station gives two bombs, then takes six seconds to recharge. Leave and re-enter to collect.'],['04 • A team of tiny heroes','Three shared lives; the third hit ends the run. A dropped passenger waits in its revealed room. Rescues stay safe. Five floors and 26 hatchlings lead to the roof.']],keys:[['WASD / Arrows','Move (solo)'],['Space / ✕','Plant bug bomb'],['Mouse click','Route to a tile'],['Right click','Plant bug bomb'],['Escape / Options','Pause'],['Touch drag','Move; contextual POP and optional auto-defence']],actions:[['Back',()=>ui.back()]]});}\n  function coop(){\n    const touch=game.input.lastDevice==='touch';ui.show('coop',{kicker:'TWO SHELLS, ONE BIG HEART',title:'Local co-op',text:touch?'Single-device touch play supports one rescuer. Use a keyboard and/or two controllers for local co-op. Remote co-op is available when launched through AI Hub.':'Both rescuers act together, carry independently, and share bombs, lives and score. Remote co-op is available when launched through AI Hub.',actions:[\"'!touch&&['\"'Shared keyboard',()=>app.start('coop','shared')],\"'!touch&&['\"'Keyboard + controller',()=>app.start('coop','mixed')],\"'!touch&&['\"'Two controllers',()=>app.start('coop','pads')],['Controls & seat mapping',()=>ui.show('mapping',{title:'A place for every pair of feet',sections:[['Shared keyboard','Player 1: WASD + Space. Player 2: arrows + Right Shift.'],['Keyboard + controller','Player 1: WASD or arrows + Space. Player 2: first standard controller + Cross.'],['Two controllers','First controller: Player 1. Second controller: Player 2. Both use left stick / D-pad and Cross.'],['Device recovery','Pause and choose Change local controls to replace devices or switch to shared keyboard without losing the floor.']],actions:[['Back',()=>ui.back()]]})],['Back',()=>ui.back()]]});\n  }\n  function changeControls(){ui.show('seat-map',{title:'Change local controls',text:'Your current team and passengers stay on this floor.',actions:['shared','mixed','pads'].map(l=>[{'shared':'Shared keyboard','mixed':'Keyboard + controller','pads':'Two controllers'}[l],()=>{seats(l);app.layout=l;resetInputs();ui.hide();game.resume();}]).concat([['Back',()=>ui.back()]])});}\n  const ui=new E.Shell(game,{theme:{tv:true,ink:'#fff0cf',paper:'rgba(14,32,42,.96)',accent:'#e6c38c',muted:'#b3c8c5',danger:'#efaaa1',line:'rgba(211,202,160,.28)',font:'Trebuchet MS, system-ui, sans-serif',titleFont:'Georgia, serif'},screens:{pause:{kicker:()=>app.net?'ONLINE • WORLD CONTINUES':'TAKE A LITTLE SHELL BREAK',title:()=>app.net?'Your turtle is resting':'Room service, on pause',actions:()=>[\n    \"'!app.net&&['\"'Restart campaign',()=>app.start(app.mode,app.layout)],\"'!app.net&&app.mode==='\"'coop'&&['Change local controls',changeControls],['Developer tools',()=>devMenu()],['About / Credits',about],\"'!app.net&&['\"'Return to title',()=>app.title()]\n  ]},help:{title:'How to play',text:'Carry little guests home. Make room with bug bombs.',actions:[['Full guide',help],['Back',()=>ui.back()]]}}});app.ui=ui;\n  for(const [key,label,min,max,step] of T.SLIDERS)S.define({key,label,group:'Controls',type:'slider',value:T.DEFAULTS[key],min,max,step,apply:(g,v)=>{if(app.run)app.run.setBalance(key,v);}});\n  S.define({key:'devFloor',label:'Practice floor',group:'Controls',options:T.FLOORS.map((f,i)=>[i,f.name]),value:0});\n  S.define({key:'invulnerable',label:'Invulnerability',group:'Controls',value:false,apply:(g,v)=>{if(app.run){app.run.god=v;if(v)app.run.practice=true;}}});\n  S.define({key:'devScale',label:'Time scale',group:'Controls',value:1,min:0,max:2,step:.25,apply:(g,v)=>{app.timeScale=v;if(app.run&&v\"'!==1)app.run.practice=true;}});\n  for(const key of ['\"'graph','los','collision','reveal'])S.define({key:'dev-'+key,label:{graph:'Navigation graph',los:'Sight lines',collision:'Contact boxes',reveal:'Room contents'}[key],group:'Controls',value:false,apply:(g,v)=>{app.dev[key]=v;if(key==='reveal'&&v&&app.run)app.run.practice=true;}});\n  function devMenu(){\n    if(app.net){ui.show('dev-inspector',{title:'Live world inspector',text:'Online production session: read-only. The host owns all game rules.',sections:[['World',()=>JSON.stringify(app.net.state)]],actions:[['Refresh snapshot',()=>{ui.back();devMenu();}],['Back',()=>ui.back()]]});return;}\n    const r=app.run;ui.show('dev',{kicker:'PRACTICE TOOLS',title:'The caretaker’s cupboard',text:'Cheats and balance changes mark this run unranked.',rows:['devFloor','invulnerable','devScale'],actions:[\n      ['Load practice floor',()=>{r.practice=true;r.startFloor(S.devFloor);ui.hide();game.resume();}],\n      ['Refill bomb stock',()=>{r.stock=5;r.practice=true;ui.toast('Bombs refilled','Practice run');}],\n      ['Spawn beetle at supply',()=>{r.enemies.push(r.makeEnemy(r.content.supply));r.practice=true;ui.toast('Beetle checked in');}],\n      ['Clear beetles',()=>{r.enemies=[];r.practice=true;ui.toast('A beetle-free practice floor');}],\n      ['Balance sliders',()=>ui.show('balance',{title:'Live balance',text:'Changes affect the running simulation immediately.',rows:T.SLIDERS.map(s=>s[0]),actions:[['Reset balance defaults',()=>{r.resetBalance();for(const sp of T.SLIDERS)S[sp[0]]=T.DEFAULTS[sp[0]];ui.show('balance');}],['Back',()=>ui.back()]]})],\n      ['Overlays & room data',(