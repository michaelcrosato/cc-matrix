{"type":"item.completed","item":{"id":"item_40","type":"agent_message","text":"The first production-balance bot run rescued all 26 hatchlings with one life left. It exercised bombs, resupply, beetle escalation, and recovery after hits. The co-op bot lost on the roof, so I’m checking its shared-bomb decisions while integrating the presentation and Hub lifecycle.\n"}}
{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'JS'\n(function(T){\n  'use strict';const E=My3D2dge;\n  const PRESET={up:['KeyW','ArrowUp','Pad12','PadAxisUp'],down:['KeyS','ArrowDown','Pad13','PadAxisDown'],left:['KeyA','ArrowLeft','Pad14','PadAxisLeft'],right:['KeyD','ArrowRight','Pad15','PadAxisRight'],bomb:['Space','Mouse2','Pad0'],confirm:['Enter','Space','Pad0'],cancel:['Escape','Backspace','Pad1'],pause:['Escape','KeyP','Pad9'],start:['Enter','Pad9'],\n    halves:{left:{bomb:['Space'],confirm:['Enter','Space'],cancel:['Escape'],pause:['Escape','KeyP']},right:{bomb:['ShiftRight'],confirm:['Enter'],cancel:['Backspace'],pause:['Backspace']}};\n  const online=typeof AIHub\"'!=='\"'undefined'&&AIHub.active;\n  const game=new E.Game({id:'turtley-booked-v1',canvas:'screen',res:[400,280],expand:true,view:'overhead',views:['overhead'],input:PRESET,live:online,autoPause:\"'!online,fullscreen:'\"'button',camera:{zoom:false,start:1,tall:1},\n    menu:{quit:false,controls:{bomb:'Bug bomb'},settings:[{key:'glyphs',value:'playstation'},{key:'music',value:.10},{key:'voice',group:'Sound',label:'Turtle voices',type:'slider',value:.7,min:0,max:1,step:.05,apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},{key:'assist',label:'Touch auto-defence',group:'Game',value:true,help:'An imminent beetle triggers a bomb if the team has one. Separate assisted records.'}]}});\n  const app={game,run:null,net:null,art:new T.Art(game),sound:new T.Sound(game),bot:new T.Bot,mode:'solo',layout:'shared',latest:[],bombSeq:0,dev:{graph:false,los:false,collision:false,reveal:false},stepOnce:false,timeScale:1,lastDevice:'',resultShown:false,ending:false,attract:false,activity:0};T.app=app;\n  const cab=new E.Arcade(game,{id:'turtley-booked',idle:10,demo:1e9,scores:6,hud:false});app.cab=cab;\n  const S=game.settings;\n  function resetInputs(){for(const i of game.players)i.clear();app.latest=[];app.bombSeq=0;}\n  function 