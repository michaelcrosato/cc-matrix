{"type":"item.started","item":{"id":"item_158","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/sim.js';s=open(p).read().replace('\"'!dir.every(Number.isFinite)'\"', '\"'!dir.every(Number.isInteger)'\"');open(p,'w').write(s)\np='tests/rules.mjs';s=open(p).read().replace('check(\\\"continuous travel\\\",', 'check(\\\"fractional diagonal intention rejected\\\",()=>{const r=run(),p=r.players[0];r.step(1/120,{0:{dir:[.5,.5]}});return p.m.x===9&&p.m.y===11;});\\\\ncheck(\\\"continuous travel\\\",');open(p,'w').write(s)\np='tools/interview.mjs';s=open(p).read().replace('Nine unique product issues, all fixed', 'Eleven unique product issues, all fixed');open(p,'w').write(s)\np='docs/validation.md';s=open(p).read().replace('Nine unique product issues; three critical.', 'Eleven unique product issues; three critical.').replace('\\\\nEleven unique product issues;', '\\\\n| G10 | Moderate lifecycle | Presentation caches and stale demo-loop events could outlive a run. | Reset rigs, effects, state and sound at run start; return immediately after a demo restart; test event id isolation. |\\\\n| G11 | Moderate controls | Intentional controller reassignment retained pad-loss tracking and reset accepted bomb edge numbering. | Clear assignment tracking and preserve per-run action sequence during control replacement; mixed/two-pad and mid-run replacement tests. |\\\\n\\\\nEleven unique product issues;')\ns=s.replace('Solo seed 2 and local co-op seed 9', 'Solo seed 5 and local co-op seed 2').replace('complete dedicated-host campaign seed 1','complete dedicated-host campaign seed 3').replace('local co-op seed 8','local co-op seed 2')\ns=s.replace('Full synchronized campaign testing uses the real browser harness separately, with native browser-clock stepping;', 'A full 26-rescue campaign with a dedicated host and two player copies passed through the real browser harness (seed 8, 202.64 playing seconds, three lives remaining, identical score 14650). Native brow