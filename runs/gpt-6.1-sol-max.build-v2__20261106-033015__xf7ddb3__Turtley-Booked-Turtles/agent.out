{"type":"item.started","item":{"id":"item_146","type":"command_execution","command":"/bin/bash -lc \"node - <<'JS'\nconst fs=require('fs');for(const file of ['tuning-evidence.json','network-search.json']){const data=JSON.parse(fs.readFileSync('build/'+file));console.log(file,JSON.stringify(data.filter(r=>r.phase==='won')));}const r=JSON.parse(fs.readFileSync('build/full-hub-campaign.json'));const h=r.copies.find(c=>c.host);console.log('Actual harness',JSON.stringify({round:r.round,floors:r.floors,host:{server:h.server,phase:h.state.phase,rescued:h.state.rescued,lives:h.state.lives,time:h.state.elapsed,stats:h.state.stats},copies:r.copies.map(c=>({rescued:c.state.rescued,score:c.state.score,ended:c.ended,errors:c.errors}))}));\nJS\nrg -n 'scripted ordinary|actual route|A scripted|whole exact|Whole exact|attract|pad_script' tests/devices.py && sed -n '90,123p' tests/devices.py && cat build/biome.log | tail -7\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
