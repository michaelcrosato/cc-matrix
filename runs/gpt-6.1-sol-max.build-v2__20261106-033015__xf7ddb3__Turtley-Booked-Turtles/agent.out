ath.min(1,u*1.6-i*.018));const bx=20+i*8+(x-18-(20+i*8))*progress,by=y+10+(ay-y+1)*progress-Math.sin(progress*Math.PI)*9;\n          px.ell(g,bx,by,3,3,i%2?'#a9cd88':'#c3d793');px.ell(g,bx+2.5,by+.5,1.5,1.5,'#e1e8b1');px.dot(g,bx+3,by,INK);}\n        const a=new TurtleRig(0),b=new TurtleRig(1);a.update(time,{walk:1,facing:0});b.update(time+.5,{walk:1,facing:0});a.draw(g,60+u*30,y+10,{zoom:1},1.5);b.draw(g,83+u*30,y+10,{zoom:1},1.5);\n        E.font.title(g,'EVERY GUEST, HOME.',r.W/2,22,{scale:2,align:'center',colors:['#fff0c0','#dfae7f']});\n        E.font.text(g,'26 little lodgers. One enormous reunion.',r.W/2,44,'#fff1cc',{align:'center',outline:false});\n      });\n    }\n\\\"\\\"\\\"\ns=s.replace(pos,end+pos);open(p,'w').write(s)\np='src/main.js';s=open(p).read().replace(\\\"app.art.title(r,game.time,true)\\\", \\\"app.art.ending(r,game.time,app.state.phase==='won'?0:app.state.phaseTime)\\\")\ns=s.replace(\\\"const S=game.settings;\\\", \\\"const S=game.settings;game.lights.enabled=true;game.lights.ambient=.86;\\\")\n# Meaningful unmapped controller edges and axis changes can wake a demo, with noise ignored.\ns=s.replace(\\\"if(game.input.anyPressed()){\\\", \\\"const pads=game.players.map(i=>i.padPrev.map((v,k)=>v?k:-1).filter(k=>k>=0).join(',')+':'+i.padMove.map(v=>Math.abs(v)>.35?Math.round(v*3):0).join(','));\\\\n    const padChange=pads.some((v,i)=>v\"'!==app.lastPads?.[i]&&!v.endsWith('\"':0,0')||v\"'!==app.lastPads?.[i]&&v.split('\"':')[0]);app.lastPads=pads;\\\\n    if(game.input.anyPressed()||padChange){\\\")\nopen(p,'w').write(s)\nPY\nnpm run build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
