{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > src/net.js <<'JS'\n(function(T){\n  'use strict';\n  class Network{\n    constructor(info,api){\n      this.info=info;this.api=api;this.id='r'+info.round+'s'+info.seed;this.started=false;this.ended=false;this.finished=false;this.time=0;this.snapSeq=0;this.lastSeq=-1;this.inputSeq=0;this.lastSend=-10;this.lastSnap=-10;this.lastPhase='';this.inputs={};this.accepted={};this.lastBomb={};this.state=null;this.predict=null;this.rendered=null;this.lastKey='';this.lastEvent=0;\n      this.run=info.isHost?new T.Run({seed:info.seed,runId:this.id,mode:'hub',seats:info.players.map(p=>p.id)}):null;\n      if(this.run)this.state=this.run.snapshot();else this.state=new T.Run({seed:info.seed,runId:this.id,mode:'hub',seats:info.players.map(p=>p.id)}).snapshot();\n      api.on('start',()=>{this.started=true;});\n      api.on('message',(m,from)=>this.receive(m,from));\n      api.on('leave',({id})=>{if(this.ended)return;if(this.run){this.run.leave(id);this.broadcast(true);}});\n      api.on('time-up',()=>{if(this.run&&\"'!this.ended)this.finish(this.run.phase==='\"'won');});\n      api.on('end',({reason})=>{this.ended=true;this.reason=reason;this.inputs={};if(this.run)this.run.phase='ended';if(this.onEnd)this.onEnd(reason);});\n      api.ready();\n    }\n    valid(m){return m&&m.v===1&&m.run===this.id&&Number.isSafeInteger(m.seq)&&m.seq>=0;}\n    receive(m,from){\n      if(this.ended||\"'!this.valid(m))return;\n      if(this.run){\n        if(m.type!=='\"'input'||\"'!this.started||m.floor!==this.run.floor||this.run.phase==='\"'ended')return;\n        const p=this.run.players.find(p=>p.seat===from&&p.active);if(\"'!p)return;\n        const prev=this.accepted[from];if(prev&&m.seq<=prev.seq)return;\n        if(prev&&this.time-prev.window<1&&prev.count>=20)return;\n        const dir=m.dir;\n        if(dir!==null&&(!Array.isArray(dir)||dir.length!==2||!dir.every(Number.isInteger)||Math.abs(dir[0])+Math.abs(dir[1])!==1))return;\n        if(!Number.isSafeInteger(m.bombSeq)||m.bombSeq<0||m.bombSeq>(this.lastBomb[from]||0)+100)return;\n        let route=null;if(m.route!==null&&m.route!==undefined){if(!Array.isArray(m.route)||m.route.length!==2||!m.route.every(Number.isInteger)||!this.run.grid.walk(m.route))return;route=m.route;}\n        const window=prev&&this.time-prev.window<1?prev.window:this.time,count=prev&&this.time-prev.window<1?prev.count+1:1;\n        const bomb=m.bombSeq>(this.lastBomb[from]||0);this.lastBomb[from]=m.bombSeq;this.accepted[from]={seq:m.seq,at:this.time,window,count};\n        this.inputs[from]={dir,bomb,bombSeq:m.bombSeq,route,confirm:m.confirm===true};\n      }else{\n        if(from!==this.info.host||m.type!=='\"'state'||m.seq<=this.lastSeq)return;\n        const s=m.state;if(\"'!s||s.run!==this.id||s.v!==1||s.tick<this.state.tick||s.floor<this.state.floor||!Array.isArray(s.players))return;\n        const changed=s.floor!==this.state.floor;this.lastSeq=m.seq;this.state=s;this.lastReceived=this.time;\n        if(changed){this.predict=null;this.rendered=null;}\n        const p=s.players.find(p=>p.seat===this.info.me);\n        if(p){const mvr=new My3D2dge.GridMover({cx:p.cx,cy:p.cy});Object.assign(mvr,{x:p.x,y:p.y,_to:p.to,_u:p.u,moving:p.moving,dir:p.dir.slice()});this.predict={...p,m:mvr,prev:[p.x,p.y],bufferTime:0};}\n      }\n    }\n    broadcast(reliable=false){\n      if(!this.run||this.ended)return;\n      this.state=this.run.snapshot();this.api.send({v:1,run:this.id,type:'\"'state',seq:++this.snapSeq,state:this.state},{reliable});this.lastSnap=this.time;\n    }\n    finish(won){\n      if(this.finished||this.ended||\"'!this.run)return;this.finished=true;this.broadcast(true);\n      const ids=this.run.players.filter(p=>p.active).map(p=>p.seat),scores=Object.fromEntries(ids.map(id=>[id,this.run.score]));\n      this.api.finish({standings:[ids],scores,won:!!won,stats:Object.fromEntries(ids.map(id=>[id,{Rescues:this.run.rescued,Score:this.run.score,Seconds:Math.round(this.run.elapsed)}]))});\n    }\n    update(dt,intent={}){\n      if(this.ended)return;this.time+=dt;\n      const clock=this.api.time(),playing=this.started&&Number.isFinite(clock)&&clock>=0;\n      const local=this.info.server?null:this.info.me;\n      if(this.run){\n        if(local!==null)this.inputs[local]=intent;\n        for(const p of this.run.players)if(p.seat!==local&&this.accepted[p.seat]&&this.time-this.accepted[p.seat].at>.4)this.inputs[p.seat]={};\n        if(playing&&!this.finished){this.run.step(dt,this.inputs);for(const v of Object.values(this.inputs)){v.bomb=false;v.route=null;v.confirm=false;}}\n        const phase=this.run.floor+'\"':'+this.run.phase;\n        if(this.time-this.lastSnap>=.1||phase\"'!==this.lastPhase){this.lastPhase=phase;this.broadcast(phase.includes('\"'won')||phase.includes('lost')||phase.includes('clear'));}\n        if(['won','lost'].includes(this.run.phase))this.finish(this.run.phase==='won');\n      }else{\n        if(intent.bomb)this.pendingBomb=intent.bombSeq; if(intent.route)this.pendingRoute=intent.route;if(intent.confirm)this.pendingConfirm=true;\n        const key=JSON.stringify([intent.dir||null,this.pendingBomb||0,this.pendingRoute||null,\"'!!this.pendingConfirm]);\n        if((playing||this.started)&&this.time-this.lastSend>=.075&&(key!==this.lastKey||this.time-this.lastSend>=.16)){\n          this.api.send({v:1,run:this.id,type:'\"'input',seq:++this.inputSeq,floor:this.state.floor,dir:intent.dir||null,bombSeq:this.pendingBomb||0,route:this.pendingRoute||null,confirm:\"'!!this.pendingConfirm},{to:this.info.host,reliable:false});\n          this.lastSend=this.time;this.lastKey=key;this.pendingRoute=null;this.pendingConfirm=false;\n        }\n        if(playing&&this.predict&&this.time-(this.lastReceived||0)<.25&&this.state.phase==='\"'playing'&&this.predict.hurt<=0){\n          const map=this.predMap&&this.predFloor===this.state.floor?this.predMap:T.makeMap(T.FLOORS[this.state.floor]);this.predMap=map;this.predFloor=this.state.floor;\n          T.move(this.predict,dt,My3D2dge.Grid.from(map),intent.dir||null,this.state.balance.playerSpeed*(this.predict.carried?this.state.balance.carrySpeed:1));\n          const authority=this.state.players.find(p=>p.seat===local),d=Math.hypot(this.predict.m.x-authority.x,this.predict.m.y-authority.y);\n          if(d>.85){this.predict.m.x=authority.x;this.predict.m.y=authority.y;}\n        }\n      }\n    }\n    presentation(dt){\n      const s=this.state;if(\"'!s)return null;if(this.run)return s;\n      const out={...s,players:s.players.map(p=>({...p}))};\n      for(const p of out.players){if(p.seat===this.info.me&&this.predict){p.x=this.predict.m.x;p.y=this.predict.m.y;p.walk=this.predict.walk;p.facing=this.predict.facing;}}\n      if(this.rendered&&this.rendered.floor===s.floor){for(const p of out.players){if(p.seat===this.info.me)continue;const before=this.rendered.players.find(q=>q.id===p.id);if(before){p.x=before.x+(p.x-before.x)*Math.min(1,dt*13);p.y=before.y+(p.y-before.y)*Math.min(1,dt*13);}}}\n      this.rendered=out;return out;\n    }\n  }\n  T.Network=Network;\n})(globalThis.TB);\nJS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
