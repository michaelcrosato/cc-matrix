{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"sed -n '2932,2975p' vendor/engine/my-3d2dge.js && rg -n 'scale.*_scale|theme.scale|theme.tv|--zoom|zoom:' vendor/engine/my-3d2dge.js | tail -18 && sed -n '1,34p' vendor/engine/docs/ASSETS.md && sed -n '52,67p' vendor/engine/docs/ASSETS.md\"","aggregated_output":"  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n      this.focus(t.x + dir[0] * f.lead, (t.y || 0) + dir[1] * f.lead, (t.z || 0) + f.z);\n    }\n    this.particles.update(dt);\n    if (this.cam.free) this._freeCam(dt);\n    this._camStep(dt);\n  }\n  // a screen-pixel move [dx, dy] as the ground's (world x, y) at the zoom the player sees (during a zoom's preview, the goal)\n  _screenToGround(dx, dy) {\n    const v = this.view, k = this.zoom / (this._zoomTo || this.zoom);\n    return v.inv ? [(v.inv[0] * dx + v.inv[1] * dy) * k, (v.inv[2] * dx + v.inv[3] * dy) * k] : [dx / (v.ax || 1) * k, 0];\n2358:    /** zoom: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's\n2359:     *  (settings.zoom: the wheel, a pinch), within the scene's camera.zoom range; yaw: its turn in degrees on top of the\n2376:     *  or nears the screen's edge (side-scrollers); frame(targets, { margin: 24, zoom: [min, max] or false }) keeps\n2384:      frame: (list, o = {}) => { this._framed = list && list.length ? { list, margin: o.margin === undefined ? 24 : o.margin, zoom: o.zoom === undefined ? [.5, 1] : o.zoom } : null; this.cam.snap = tr [... omitted end of long line]\n2501:  // the camera's zoom: the game's (_zoomBase), times the player's where the scene allows it, snapped to twentieths (each\n2718:   * - camera: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the\n2719:   *   wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, on top of the game's; false or none: they can't; a\n2946:    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n3047:  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: t [... omitted end of long line]\n4372:   *   rig.drawPortrait(g, x, y, 40, { zoom: 3, turn: .6, bg: '#1a2050', frame: true })   // inside r.overlay(g => ...)\n4373:   * zoom: pixels per world unit (3 = face fills the frame), turn: 0 = facing you, .6 = three-quarter.\n9449:    if (th.font && /\\d|\\b(bold|italic|normal|oblique)\\b/.test(th.font)) warn('shell:font', 'E.Shell theme.font is a family (\"Georgia, serif\"), not a CSS shorthand (\"' + th.font + '\"): the size comes f [... omitted end of long line]\n11943:        this.rigs[this.at[i]].drawPortrait(g, bx, 36, big, { zoom: 2.4, turn: i ? -.6 : .6, bg: i ? ['#ff8a6a', '#5a1a2a'] : ['#6ab0ff', '#1a2a5a'], border: E.PLAYER_COLORS[i] });\n11951:        const x = x0 + k * (s + 6); this.rigs[k].drawPortrait(g, x, y, s, { zoom: 2, turn: .5 });\n13994:    if (P) P.drawPortrait(g, x + 4, y + 4, 26, { zoom: 2.1, turn: .7, bg: ['#3a4aa8', '#10143a'], tint: m.dead ? '#808080' : undefined });\n# Objects and materials as data\n\nThe full engine draws still objects (barrels, tables, trees, wells) from a few lines of data, in every view and facing,\nwith the house shading and outline, and gives every surface (floors, wall faces, wall tops, platform tiles, the objects'\nown faces) a material from one open registry. An object costs one to a few hundred tokens of data (the core's median is\n125); you check it headless with one command. Read this card whole before you write one. (The agent edition keeps the\nregistries and ignores the calls: `E.addAssets` returns empty lists, the others null.)\n\n## Use one\n\n```js\n// in draw(r): feet on the point, depth sorted like an actor; its front toward facing\nr.shape('barrel', x, y, 0, { facing: Math.PI / 2 });\n// once, before the updates: bodies stop at it, a body coming down lands on it, one wholly below passes under\nmap.solid('table', 120, 80, 0, { facing: 0 });\n// a sprite of it, for an inventory or a HUD (r.sprite, px.sprite)\nconst icon = E.shapeSprite('chest', { view: 'iso' });\n```\n\n- **r.shape options:** facing (radians, where the front points: 0 east, π/2 south, as written), scale, mats ({ slot:\n  material }), flip (mirrors it x to -x, collision too), params (a generator's: { h: 30 }), bias, hides (default true),\n  light (adds its lights to game.lights), shadow (default true).\n- **map.solid** takes the same id and placement, so one object can feed both calls. Bodies span z to z + h (E.Body's h, 32).\n- **In 3D** the 3D engine draws the same entries, materials and boxes: `world.shape(id, x, y, z, o)` (its header).\n- **Steep views** (top-down) draw shapes from the characters' lower angle, as rigs are drawn. The light comes from the\n  viewer's upper left in every view.\n- **Glow and fire:** a material with glow: 1 ignores the light and stays bright in the dark; an entry's flames ([[x, y, z,\n  w, h]]) draw the engine's animated flame (r.shape only: a sprite has none). Anything else that moves stays a prop\n  (r.prop) or your own code.\n- **Dressing a generated level:** a scene is a few entries as [id, across, forward] from an anchor (a wall spot, forward\n  into the room); place it whole or not at all, each part on free floor, after the level's own random picks and from a\n  seeded stream of its own, so the level stays as its seed builds it (Emberdeep's `src/emberdeep/53-scenes.js`).\n\n## The core library\nconst level = new E.PlatformMap({ rows, legend, types: { 1: { kind: 'solid', style: 'block', mat: 'mossy' } } });\n```\n\nfloorMats is keyed by the floor tags of the legend ('~': { floor: 'water' }); either stands in for floorTex.\n\nA material is `{ color, pattern, ...the pattern's numbers, ramp, glow, over }`. Its five tones come from `E.tones(color)`\n(or its own `ramp` of five, dark to light); the light picks a band, the pattern moves it a step, so a material works on\nevery surface and in every palette and recolors with one hex. An unknown name warns with the list of names.\nOverlays, the last on top, each in its own color's tones: `over: [['moss', '#5f7a3a', { up: .6 }], ['cracks']]`; moss on\nwhat looks up, cracks (the material a step darker), dirt near the ground (h 6), rust; each takes amount and size.\n\n| Pattern | Numbers | What |\n| --- | --- | --- |\n| none | | the light alone |\n| planks | bw 3, len 14, dir | boards with joints; staves on round parts; dir: 'v' turns them |\n| crate | frame 2, bw 3 | a framed, braced side; planks on its lid |\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser.py <<'PY'\nimport json\nimport pathlib\nimport sys\nfrom playwright.sync_api import sync_playwright\n\nroot = pathlib.Path(__file__).resolve().parents[1]\nurl = (root / 'build/game.html').as_uri()\nfailures = []\ncount = 0\n\ndef check(name, okay, detail=''):\n    global count\n    count += 1\n    if not okay:\n        failures.append(name + ': ' + str(detail))\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    page = browser.new_page(viewport={'width': 1920, 'height': 1080})\n    errors = []\n    page.on('pageerror', lambda e: errors.append(str(e)))\n    page.goto(url)\n    page.wait_for_function('\"'!!window.TB?.app'\"')\n    page.wait_for_timeout(300)\n    check('export title identity', page.title() == 'Turtley Booked')\n    check('engine is foundation', page.evaluate('\"'!!TB.app.game.input && !!TB.app.game.audio && TB.app.game.view.id === \"overhead\"'\"'))\n    page.screenshot(path=str(root / 'build/title-tv.png'))\n    page.get_by_role('button', name='Check in • Solo', exact=True).click()\n    page.wait_for_timeout(2300)\n    check('solo starts production world', page.evaluate('TB.app.run.phase === \\\"playing\\\"'))\n    check('music gain default', page.evaluate('TB.app.game.settings.music === .1 && TB.app.game.audio.musicVolume === .1'))\n    page.screenshot(path=str(root / 'build/play-tv.png'))\n    page.keyboard.press('Escape')\n    page.wait_for_timeout(150)\n    check('native pause', page.evaluate('TB.app.game.paused && TB.app.ui.screen === \\\"pause\\\"'))\n    page.get_by_role('button', name='Developer tools', exact=True).click()\n    check('dev screen', page.get_by_role('heading', name='The caretaker’s cupboard').count() == 1)\n    page.get_by_role('button', name='Balance sliders', exact=True).click()\n    check('live sliders', page.locator('.esh input[type=range]').count() == 8)\n    page.screenshot(path=str(root / 'build/dev-tv.png'))\n    check('no runtime or draw errors', not errors and page.evaluate('TB.app.game.errors.length') == 0, errors or page.evaluate('TB.app.game.errors'))\n    browser.close()\nprint(json.dumps({'count': count, 'failures': failures}))\nsys.exit(1 if failures else 0)\nPY\ncat > tools/verify.mjs <<'JS'\nimport {spawnSync} from 'node:child_process';\nimport path from 'node:path';\nprocess.chdir(path.resolve(import.meta.dirname,'..'));\nconst suites=process.argv.slice(2);let count=0,failed=0;\nconst jobs=[];\nif(\"'!suites.length||suites.includes('\"'browser'))jobs.push(['/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/browser.py']]);\nif(\"'!suites.length||suites.includes('\"'rules'))jobs.push(['node',['tests/rules.mjs']]);\nif(suites.includes('hub'))jobs.push(['/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/hub.py']]);\nfor(const [cmd,args] of jobs){const r=spawnSync(cmd,args,{encoding:'utf8',maxBuffer:2e6});const lines=r.stdout.trim().split('\\\\n');let report;try{report=JSON.parse(lines.at(-1));}catch{report={count:0,failures:[r.stdout+r.stderr]};}count+=report.count;failed+=report.failures.length;for(const f of report.failures)console.error('FAIL '+f);if(r.status&&\"'!report.failures.length){failed++;console.error(r.stderr||'\"'Suite failed');}}\nconsole.log(\"'`${count} checks, ${failed} failures.`);process.exitCode=failed?1:0;\nJS\nnpm run verify -- browser'","aggregated_output":"npm notice run turtley-booked@1.0.0 verify\nnpm notice run node tools/verify.mjs browser\nFAIL Traceback (most recent call last):\n  File \"/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-033015__xf7ddb3/work/Turtley-Booked-Turtles-gpt-6.1-sol-max-20261106-033015/tests/browser.py\", line 23, in <module>\n    page.wait_for_function('!!window.TB?.app')\n    ~~~~~~~~~~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^\n  File \"/home/micha/.local/share/pipx/venvs/playwright/lib/python3.14/site-packages/playwright/sync_api/_generated.py\", line 12809, in wait_for_function\n    self._sync(\n    ~~~~~~~~~~^\n        self._impl_obj.wait_for_function(\n        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n    ...<4 lines>...\n        )\n        ^\n    )\n    ^\n  File \"/home/micha/.local/share/pipx/venvs/playwright/lib/python3.14/site-packages/playwright/_impl/_sync_base.py\", line 115, in _sync\n    return task.result()\n           ~~~~~~~~~~~^^\n  File \"/home/micha/.local/share/pipx/venvs/playwright/lib/python3.14/site-packages/playwright/_impl/_page.py\", line 1153, in wait_for_function\n    return await self._main_frame.wait_for_function(**locals_to_params(locals()))\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/micha/.local/share/pipx/venvs/playwright/lib/python3.14/site-packages/playwright/_impl/_frame.py\", line 941, in wait_for_function\n    await self._channel.send(\"waitForFunction\", self._timeout, params)\n  File \"/home/micha/.local/share/pipx/venvs/playwright/lib/python3.14/site-packages/playwright/_impl/_connection.py\", line 76, in send\n    return await self._connection.wrap_api_call(\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n    ...<3 lines>...\n    )\n    ^\n  File \"/home/micha/.local/share/pipx/venvs/playwright/lib/python3.14/site-packages/playwright/_impl/_connection.py\", line 632, in wrap_api_call\n    raise rewrite_error(error, f\"{parsed_st['apiName']}: {error}\") from None\nplaywright._impl._errors.TimeoutError: Page.wait_for_function: Timeout 30000ms exceeded.\n\n0 checks, 1 failures.\n","exit_code":1,"status":"failed"}}
