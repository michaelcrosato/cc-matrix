{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"sed -n '9442,9456p' vendor/engine/my-3d2dge.js && sed -n '9362,9381p' vendor/engine/my-3d2dge.js && sed -n '2588,2609p' vendor/engine/my-3d2dge.js && sed -n '7748,7763p' vendor/engine/my-3d2dge.js\"","aggregated_output":"    const signal = game._abort ? game._abort.signal : undefined;\n    addEventListener('keydown', e => { const c = this._cap; if (!c) return; e.preventDefault(); e.stopImmediatePropagation(); if (e.code === 'Escape') this._capEnd('Not changed.'); else if (c.device === 'keys' && !e.repeat) this._capBind(e.code); }, { capture: true, signal });\n    addEventListener('pointerdown', e => { const c = this._cap; if (!c || c.device !== 'keys' || e.pointerType !== 'mouse') return; e.preventDefault(); e.stopImmediatePropagation(); this._capBind('Mouse' + e.button); }, { capture: true, signal });\n    addEventListener('wheel', e => { const c = this._cap; if (!c || c.device !== 'keys' || !e.deltaY) return; e.preventDefault(); e.stopImmediatePropagation(); this._capBind(e.deltaY < 0 ? 'WheelUp' : 'WheelDown'); }, { capture: true, signal, passive: false });\n    if (!document.getElementById('esh-css')) { const st = document.createElement('style'); st.id = 'esh-css'; st.textContent = SHELL_CSS; document.head.appendChild(st); }\n    const r = this.root = this._el('div', 'esh' + (game._corner ? ' esh-cornered' : '')), th = Object.assign({}, SHELL_THEME, o.theme);   // (the top-right column starts below the corner's buttons)\n    for (const k in th) r.style.setProperty('--' + (k === 'titleFont' ? 'title' : k), th[k]);\n    if (th.font && /\\d|\\b(bold|italic|normal|oblique)\\b/.test(th.font)) warn('shell:font', 'E.Shell theme.font is a family (\"Georgia, serif\"), not a CSS shorthand (\"' + th.font + '\"): the size comes from theme.scale');\n    const K = th.scale !== undefined ? th.scale : o.tv ? () => clamp(innerWidth * .016, 18, 30) / 14 : 1;   // (for ten feet: the whole interface that many times, still filling the window)\n    if (K !== 1) { const fit = () => { const k = Math.max(.25, +(typeof K === 'function' ? K(window) : K) || 1); Object.assign(r.style, { transform: 'scale(' + k + ')', transformOrigin: '0 0', inset: 'auto', left: '0', top: '0', width: 100 / k + 'vw', height: 100 / k + 'vh' }); }; fit(); addEventListener('resize', fit, { signal }); }\n    const host = document.body; host.appendChild(r);\n    const E2 = (cls, parent = r, tag = 'div') => { const e = this._el(tag, cls); e.hidden = true; parent.appendChild(e); return e; };\n    const col = this._el('div', 'esh-col'); r.appendChild(col);\n    /** the HUD's elements, by piece (hb, obj, vit, toast, tut, pr, tip, place, mini, keys) and the screen layer (scr) */\n    this._els = { hb: E2('esh-hb', col), obj: E2('esh-obj esh-pan'), vit: E2('esh-vit esh-pan', col), place: E2('esh-place', col), tip: E2('esh-tip esh-pan'), pr: E2('esh-pr esh-pan'), keys: E2('esh-keys'),\n * ============================================================================= */\nconst SHELL_CSS = `.esh{position:fixed;inset:0;pointer-events:none;z-index:20;font:14px/1.45 var(--font);color:var(--ink);--sat:env(safe-area-inset-top,0px);\n--pt:calc(14px + env(safe-area-inset-top,0px));--pr:calc(14px + env(safe-area-inset-right,0px));--pb:calc(14px + env(safe-area-inset-bottom,0px));--pl:calc(14px + env(safe-area-inset-left,0px))}\n.esh *{box-sizing:border-box}.esh [hidden]{display:none!important}.esh p{margin:4px 0 0;white-space:pre-line}\n.esh h1,.esh h2{font-family:var(--title);font-weight:600;margin:2px 0 0;line-height:1.05}.esh h2{font-size:26px}\n.esh-pan{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:10px 13px;box-shadow:0 8px 28px #0009}\n.esh-k{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}.esh-m{color:var(--muted);font-size:12px}\n.esh-obj{position:absolute;left:var(--pl);top:var(--pt);max-width:min(330px,58vw)}.esh-obj b{font:600 17px var(--title);display:block}\n.esh-dist{color:var(--accent);font-size:12px;margin-top:4px;letter-spacing:.06em}\n.esh-vit{text-align:right;min-width:120px}.esh-hb{display:flex;gap:6px;pointer-events:auto}.esh-hb button{padding:6px 10px;font-size:11px;background:var(--paper)}\n.esh-st{font-size:11px;letter-spacing:.16em}.esh-st i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:var(--c)}\n.esh-pips{margin-top:5px}.esh-pips i{display:inline-block;width:9px;height:9px;margin-left:4px;transform:rotate(45deg);background:var(--c,var(--danger))}.esh-pips i.off{opacity:.22}\n.esh-bar{height:4px;background:#ffffff1c;border-radius:2px;overflow:hidden;margin-top:6px}.esh-bar i{display:block;height:100%;background:var(--c,var(--accent));transition:width .2s}\n.esh-cnt{margin-top:6px;font-size:12px;color:var(--muted)}.esh-cnt b{color:var(--ink);margin-left:5px}\n.esh-toast{position:absolute;left:50%;top:var(--pt);transform:translate(-50%,calc(-100% - 30px));transition:transform .35s;max-width:min(420px,80vw);text-align:center}.esh-toast.on{transform:translate(-50%,0)}\n.esh-tut{position:absolute;left:var(--pl);bottom:var(--pb);max-width:min(330px,62vw);pointer-events:auto;padding-right:30px}\n.esh-x{position:absolute;right:6px;top:4px;background:none!important;border:0!important;color:var(--muted)!important;padding:2px 6px!important;font-size:16px!important}\n.esh-pr{position:absolute;left:50%;bottom:calc(var(--pb) + 44px);transform:translateX(-50%);display:flex;gap:10px;align-items:center;min-width:200px}\n.esh kbd{font:700 12px var(--font);border:1px solid var(--accent);border-bottom-width:2px;border-radius:4px;padding:2px 7px;color:var(--accent)}\n.esh-tip{position:absolute;left:50%;bottom:calc(var(--pb) + 100px);transform:translateX(-50%);text-align:center;border-color:var(--danger)}\n    if (ua && !ua.isActive) return false;   // (no tap behind this: the next one asks)\n    fs.enter(true); return true;\n  }\n  /** is there somewhere for game.back() to go (an open menu screen, a scene in play, a scene with its own back())? */\n  _canBack() { const s = this.scene; return !!(this.shell && this.shell.screen) || !!s && (!!s.pausable || this.sceneName === 'main' || !!s.back); }\n  /**\n   * a step back, as a phone's back gesture asks for (the engine calls it for one; a back button of the game's own can):\n   * the open menu screen goes back one; else the scene's own back() takes it (it returns true when it did); else a scene\n   * in play pauses into the menu, and a paused one goes on. Returns false where there is nowhere to go (a title)\n   */\n  back() {\n    const sh = this.shell, s = this.scene; if (sh && sh.screen) { sh.back(); return true; }\n    if (s && s.back && s.back()) return true;\n    if (!s || !(s.pausable || this.sceneName === 'main')) return false;\n    if (this.paused) this.resume(); else this.menu();\n    return true;\n  }\n  /** where the corner's buttons (menu and full screen, top right; the touch START) cover the screen, in screen pixels\n   *  { x0, y0, x1, y1 } (r.W and r.H's space), or null while none show: keep a HUD clear of it */\n  cornerArea() {\n    const c = this._corner && this._corner.style.display !== 'none' ? this._corner : this.input._startEl; if (!c || !c.isConnected || !this.screen.canvas) return null;\n    const q = c.getBoundingClientRect(); if (!q.width) return null;\n    this.presets = Object.assign({}, SFX); this._last = {}; this.song = null; this.failed = null; this._ducked = false; this.ducked = false; this._waves = {};\n    /** offset: seconds the music sounds early, for speakers and headphones that lag (settings.audioOffset); drift: what\n     *  is heard against the game's clock at the last frame (seconds: the sound follows the clock, so it stays near 0);\n     *  anchors: how many times the sound was moved to meet the clock */\n    this.offset = 0; this.drift = 0; this.anchors = 0; this._ats = []; this._beats = []; this._fading = []; this._stings = []; this._fr = null; this._timer = null;\n    // sound draws its own random numbers (noise, pitch variation): whether sound is on, muted or not yet unlocked by a tap\n    // never shifts the game's Math.random, so the same seed and inputs play the same game with or without it\n    this._rnd = rng(0x51A7E);\n  }\n  _init() {\n    if (this.ctx || this.failed) return this.ctx;\n    try {\n      const AC = window.AudioContext || window.webkitAudioContext; if (!AC) throw new Error('Web Audio is not available');\n      const c = this.ctx = new AC();\n      this._master = c.createGain(); this._master.connect(c.destination);\n      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read();s=s.replace(\\\"new E.Shell(game,{theme:{tv:true,\\\",\\\"new E.Shell(game,{theme:{scale:w=>w.innerWidth<800?1:Math.min(2.3,w.innerWidth/850),\\\")\ns=s.replace(\\\"function intention(I,seat){\\\\n\\\", \\\"function intention(I,seat){\\\\n    if(app.testInputs?.[seat])return app.testInputs[seat];\\\\n    if(app.driver){const r=app.run||app.net?.run;if(r)return app.driver(r,seat)||{};}\\\\n\\\")\ns=s.replace(\\\"const p=r.players[0],touch=\\\", \\\"if(app.driver){for(const p of r.players)inputs[p.seat]=app.driver(r,p.seat)||{};}\\\\n        const p=r.players[0],touch=\\\")\ns=s.replace(\\\"sections:[['World',()=>JSON.stringify(app.net.state)]]\\\", \\\"sections:[['World','Floor '+(app.net.state.floor+1)+' • '+app.net.state.phase+' • tick '+app.net.state.tick],['Team',app.net.state.lives+' lives • '+app.net.state.stock+' bombs • '+app.net.state.rescued+' rescued'],['Entities',app.net.state.players.length+' rescuers • '+app.net.state.enemies.length+' beetles']]\\\")\n# Enable stable test drivers on remote clients through normal intentions from an authoritative snapshot.\ns=s.replace(\\\"if(app.driver){const r=app.run||app.net?.run;if(r)return app.driver(r,seat)||{};}\\\", \\\"if(app.driver){const r=app.net?app.net.planner():app.run;if(r)return app.driver(r,seat)||{};}\\\")\n# A meaningful axis must change to reset idle, otherwise a held stick could never leave attract.\ns=s.replace(\\\"if(game.input.anyPressed()||game.players.some(i=>Math.hypot(...i.padMove)>.35))\\\", \\\"if(game.input.anyPressed())\\\")\nopen(p,'w').write(s)\np='src/net.js';s=open(p).read().replace(\\\"    presentation(dt){\\\", \\\"    planner(){\\\\n      if(this.run)return this.run;const s=this.state;\\\\n      if(\"'!this.plan||this.plan.floor!==s.floor)this.plan=new T.Run({seed:s.seed,floor:s.floor,seats:s.players.map(p=>p.seat)});'\"\\\\n      const r=this.plan;for(const k of ['phase','stock','bomb','supply','rooms','homes','balance'])r[k]=s[k];\\\\n      const actor=a=>{const m=new My3D2dge.GridMover({cx:a.cx,cy:a.cy});Object.assign(m,{x:a.x,y:a.y,_to:a.to,_u:a.u,moving:a.moving,dir:a.dir});return {...a,m};};\\\\n      r.players=s.players.map(actor);r.enemies=s.enemies.map(actor);return r;\\\\n    }\\\\n    presentation(dt){\\\")\ns=s.replace(\\\"{to:this.info.host,reliable:false});\\\", \\\"{to:this.info.host,reliable:\"'!!this.pendingRoute});\")\nopen(p,'\"'w').write(s)\np='src/sim.js';s=open(p).read().replace(\\\"places.sort((a,b)=>danger(b)-danger(a));const c=places[0];p.m.place\\\", \\\"places.sort((a,b)=>danger(b)-danger(a));const c=places[0];if(danger(c)<1.5){p.hurt=.2;return;}p.m.place\\\")\nopen(p,'w').write(s)\nPY\ncat >> src/style.css <<'CSS'\n@media(min-width:800px){.esh-ttl .esh-btns{display:grid\"'!important;grid-template-columns:1fr 1fr!important;max-width:390px!important}.esh-ttl .esh-btns button:first-child{grid-column:1 / -1}.esh-ttl h1{font-size:48px!important}.esh-ttl>div{max-width:440px!important}.esh-ttl p{font-size:15px!important}.esh-ttl .esh-m{font-size:10px!important}}\nCSS\ncat > tests/rules.mjs <<'\"'JS'\nimport vm from 'node:vm';\nimport fs from 'node:fs';\nconst log=[];const c=vm.createContext({console:{log(){},warn(...a){log.push(a.join(' '));},error(...a){log.push(a.join(' '));}}});\nfor(const f of ['vendor/engine/my-3d2dge.js','src/content.js','src/sim.js','src/art.js','src/audio.js','src/net.js','src/main.js'])vm.runInContext(fs.readFileSync(f,'utf8'),c,{filename:f});\nconst T=c.TB,E=c.My3D2dge;let count=0;const failures=[];\nfunction check(name,test){count++;try{if(typeof test==='function'?test():test) return;failures.push(name);}catch(e){failures.push(name+': '+e.message);}}\nconst run=o=>{const r=new T.Run(o);r.phase='playing';r.damageGrace=0;return r;};\nconst place=(a,cell)=>{a.m.place(...cell);a.prev=cell.slice();a.bufferTime=0;a.route=null;};\nconst step=(r,t,inputs={})=>{for(let i=0;i<Math.round(t*120);i++)r.step(1/120,inputs);};\ncheck('all content validates',()=>T.FLOORS.every(f=>T.validate(f).length===0));\ncheck('four distinct required layouts',()=>new Set(T.FLOORS.map(f=>f.rows.join(''))).size>=4);\ncheck('26 required rescues',()=>T.FLOORS.reduce((n,f)=>n+f.quota,0)===26);\ncheck('disconnected content rejected',()=>{const f={...T.FLOORS[0],rows:T.FLOORS[0].rows.slice()};f.rows[6]='#.'+'#'.repeat(18)+'#';return T.validate(f).length>0;});\ncheck('quota validation',()=>T.validate({...T.FLOORS[0],quota:99}).length>0);\ncheck('conflict validation',()=>T.validate({...T.FLOORS[0],supply:[9,11]}).length>0);\ncheck('room deck deterministic',()=>JSON.stringify(new T.Run({seed:11}).rooms)===JSON.stringify(new T.Run({seed:11}).rooms));\ncheck('first teaching room is baby',()=>Array.from({length:20},(_,seed)=>new T.Run({seed}).rooms[0].kind==='baby').every(Boolean));\ncheck('different seeds change room deck',()=>new Set(Array.from({length:20},(_,seed)=>new T.Run({seed,floor:4}).rooms.map(r=>r.kind).join(','))).size>1);\ncheck('movement uses native grid mover',()=>run().players[0].m instanceof E.GridMover);\ncheck('wall blocks movement',()=>{const r=run(),p=r.players[0];place(p,[1,1]);step(r,.5,{0:{dir:[-1,0]}});return p.m.x===1;});\ncheck('continuous travel',()=>{const r=run(),p=r.players[0];step(r,.1,{0:{dir:[1,0]}});return p.m.x>9&&p.m.x<10;});\ncheck('immediate reversal',()=>{const r=run(),p=r.players[0];step(r,.12,{0:{dir:[1,0]}});const x=p.m.x;r.step(1/120,{0:{dir:[-1,0]}});return p.m.x<x;});\ncheck('diagonal rejected',()=>{const r=run(),p=r.players[0];r.step(1/120,{0:{dir:[1,1]}});return p.m.x===9&&p.m.y===11;});\ncheck('buffered early turn',()=>{const r=run(),p=r.players[0];place(p,[1,11]);step(r,.22,{0:{dir:[1,0]}});step(r,.1,{0:{dir:[0,-1]}});return p.m.y===11&&p.m.x>2;});\ncheck('carrying slows movement by 10%',()=>{const a=run(),b=run();b.players[0].carried='test';step(a,.1,{0:{dir:[1,0]}});step(b,.1,{0:{dir:[1,0]}});return Math.abs((b.players[0].m.x-9)/(a.players[0].m.x-9)-.9)<.01;});\ncheck('mouse route follows graph',()=>{const r=run();r.enemies=[];r.step(1/120,{0:{route:[7,9]}});step(r,3);return \"'!!r.players[0].carried;});\ncheck('\"'manual direction cancels route',()=>{const r=run();r.players[0].route=[1,1];r.step(1/120,{0:{dir:[1,0]}});return r.players[0].route===null;});\ncheck('swept crossing catches contact',()=>T.swept({prev:[0,0],m:{x:1,y:0}},{prev:[1,0],m:{x:0,y:0}})===0);\ncheck('pickup reserves reachable home',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);return p.carried&&r.homes[p.home].reserved===p.carried&&r.grid.path(r.rooms[0].cell,r.homes[p.home].cell).length;});\ncheck('one passenger limit',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);const id=p.carried;place(p,r.rooms[1].cell);r.reveal(p);return p.carried===id&&r.rooms[1].status==='hidden';});\ncheck('co-op reservations distinct',()=>{const r=run({seats:[0,1]});r.players.forEach((p,i)=>{place(p,r.rooms[i].cell);r.reveal(p);});return r.players.every(p=>p.carried)&&r.players[0].home\"'!==r.players[1].home;});\ncheck('\"'unavailable home leaves baby intact',()=>{const r=run(),p=r.players[0];r.homes.forEach(h=>h.reserved='busy');place(p,r.rooms[0].cell);r.reveal(p);return \"'!p.carried&&r.rooms[0].status==='\"'hidden'&&r.score===0;});\ncheck('delivery exactly once',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);place(p,r.homes[p.home].cell);r.deliver(p);r.deliver(p);return r.score===500&&r.delivered===1&&r.rescued===1&&\"'!p.carried;});\ncheck('\"'drop returns revealed passenger',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);p.invuln=0;r.hit(p);return r.rooms[0].status==='revealed'&&\"'!p.carried&&r.homes.every(h=>h.reserved===null);});\ncheck('\"'recovery never repeats discovery points',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);r.drop(p);r.reveal(p);return r.score===100;});\ncheck('leaving releases passenger and reservation',()=>{const r=run({seats:[0,1]}),p=r.players[1];place(p,r.rooms[0].cell);r.reveal(p);r.leave(1);return \"'!p.active&&!p.carried&&r.rooms[0].status==='\"'revealed'&&r.homes.every(h=>h.seat\"'!==1);});\ncheck('\"'bomb costs exactly one, duplicate edge rejected',()=>{const r=run(),p=r.players[0];r.plant(p,{bomb:true,bombSeq:1});r.plant(p,{bomb:true,bombSeq:1});return r.stock===2;});\ncheck('one bomb for team',()=>{const r=run({seats:[0,1]});r.plant(r.players[0],{bomb:true,bombSeq:1});r.plant(r.players[1],{bomb:true,bombSeq:1});return r.stock===2&&r.bomb.seat===0;});\ncheck('empty feedback no negative stock',()=>{const r=run();r.stock=0;r.plant(r.players[0],{bomb:true,bombSeq:1});return r.stock===0&&\"'!r.bomb&&r.events.at(-1).type==='\"'empty';});\ncheck('expiration frees slot',()=>{const r=run();r.enemies=[];r.plant(r.players[0],{bomb:true,bombSeq:1});step(r,6.1);return \"'!r.bomb;});\ncheck('\"'localized stun precedes damage',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(p,[5,6]);place(b,[5,6]);b.emerge=0;p.invuln=0;r.plant(p,{bomb:true,bombSeq:1});r.step(1/120);return r.lives===3&&b.stun>0&&r.stock===2;});\ncheck('stun score only once',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(p,[5,6]);place(b,[5,6]);b.emerge=0;r.plant(p,{bomb:true,bombSeq:1});r.step(1/120);const s=r.score;b.stun=0;r.plant(p,{bomb:true,bombSeq:2});r.step(1/120);return r.score===s;});\ncheck('stun recovers to blue age zero',()=>{const r=run(),b=r.enemies[0];b.stun=.01;b.state='stunned';b.age=50;b.emerge=0;r.updateEnemy(b,.02);return b.state==='blue'&&b.age===0;});\ncheck('room beetle has emergence grace',()=>{const r=run({floor:1}),p=r.players[0],room=r.rooms.find(r=>r.kind==='beetle');place(p,room.cell);p.invuln=0;r.reveal(p);r.step(1/120);return r.lives===3&&r.enemies.at(-1).emerge>1;});\ncheck('LOS blocked by walls',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(b,[1,2]);place(p,[5,2]);return \"'!r.los(b,p);});\ncheck('\"'yellow sees straight corridors',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(b,[1,1]);place(p,[5,1]);b.state='yellow';r.choose(b);return b.sighted&&b.lastSeen[0]===5;});\ncheck('blue ignores target',()=>{const r=run(),p=r.players[0],b=r.enemies[0];b.state='blue';place(p,[19,11]);r.choose(b);return b.target===null&&b.lastSeen===null;});\ncheck('red routes around corner',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(b,[1,1]);place(p,[5,3]);b.state='red';return r.choose(b)&&b.target===0;});\ncheck('enemy target hysteresis',()=>{const r=run({seats:[0,1]}),b=r.enemies[0];place(b,[10,11]);place(r.players[0],[8,11]);place(r.players[1],[11,11]);b.target=0;return r.target(b).seat===0;});\ncheck('escalation warnings precede state',()=>{const r=run(),b=r.enemies[0];b.emerge=0;b.age=17;r.updateEnemy(b,.1);const warn=r.events.some(e=>e.type==='warning');b.age=18;r.updateEnemy(b,.1);return warn&&b.state==='yellow';});\ncheck('supply fresh entry plus recharge',()=>{const r=run(),p=r.players[0];r.enemies=[];r.stock=0;place(p,r.content.supply);r.step(1/120);const stock=r.stock;step(r,6.1);return stock===2&&r.stock===2&&r.supply.ready;});\ncheck('re-entering supply collects again',()=>{const r=run(),p=r.players[0];r.enemies=[];r.stock=0;place(p,r.content.supply);r.step(1/120);step(r,6.1);place(p,[9,6]);r.step(1/120);place(p,r.content.supply);r.step(1/120);return r.stock===4;});\ncheck('stock capped five',()=>{const r=run();r.stock=4;place(r.players[0],r.content.supply);r.step(1/120);return r.stock===5;});\ncheck('three team losses end run',()=>{const r=run(),p=r.players[0];for(let i=0;i<3;i++){p.invuln=0;p.hurt=0;r.damageGrace=0;r.hit(p);}return r.lives===0&&r.phase==='lost';});\ncheck('team damage grace',()=>{const r=run({seats:[0,1]});for(const p of r.players){p.invuln=0;r.hit(p);}return r.lives===2;});\ncheck('safe respawn avoids threat',()=>{const r=run(),p=r.players[0];for(const b of r.enemies){place(b,r.content.spawns[0]);b.emerge=0;}r.safeRespawn(p);return Math.hypot(p.m.x-r.enemies[0].m.x,p.m.y-r.enemies[0].m.y)>1.5&&p.invuln>0;});\ncheck('terminal world freezes',()=>{const r=run();r.phase='lost';const score=r.score,x=r.players[0].m.x;step(r,2,{0:{dir:[1,0],bomb:true,bombSeq:1}});return r.score===score&&r.players[0].m.x===x&&\"'!r.bomb;});\ncheck('\"'floor transition clears references',()=>{const r=run();r.plant(r.players[0],{bomb:true,bombSeq:1});r.startFloor(1);return \"'!r.bomb&&r.homes.every(h=>h.reserved===null)&&r.players.every(p=>!p.carried)&&r.rooms.every(q=>q.id.startsWith('\"'f1'));});\ncheck('live sliders constrain escalation',()=>{const r=run();r.setBalance('yellowAt',36);r.setBalance('redAt',15);return r.practice&&r.balance.redAt>=r.balance.yellowAt+3;});\ncheck('reset defaults immutable',()=>{const r=run();r.setBalance('playerSpeed',5);r.resetBalance();return r.balance.playerSpeed===3.5&&Object.isFrozen(T.DEFAULTS);});\n// Production input-driven campaigns. No invulnerability, teleports, objective edits, forced clears or balance changes.\nconst reports=[];\nfor(const [mode,seats,seed] of [['solo',[0],2701],['coop',[0,1],2701]]){\n const r=new T.Run({seats,seed,mode}),b=new T.Bot;const floors=new Set();\n for(let tick=0;tick<120*1200&&\"'!['\"'won','lost'].includes(r.phase);tick++){floors.add(r.floor);r.step(1/120,b.inputs(r));}\n reports.push({mode,phase:r.phase,floors:floors.size,rescued:r.rescued,lives:r.lives,seconds:r.elapsed,stats:r.stats});\n check(mode+' full production campaign',r.phase==='won'&&r.rescued===26&&floors.size===5&&\"'!r.practice&&!r.god);\n if(mode==='\"'solo')check('ordinary run exercises defence supply escalation and hits',r.stats.triggers>0&&r.stats.refills>0&&r.stats.escalations>0&&r.stats.hits>0);\n}\nfs.writeFileSync('build/campaign-evidence.json',JSON.stringify(reports,null,2));\nconst game=T.app.game;game.advance(.1);T.app.start();game.advance(2.5);check('native game stepping transitions to play',T.app.run.phase==='playing');\ngame.advance(.1,{draw:true});check('native draw no errors',()=>\"'!game.errors.length);\ncheck('\"'music default 10%',()=>game.settings.music===.1&&game.audio.musicVolume===.1);\ncheck('PS glyph default',()=>game.settings.glyphs==='playstation');\ncheck('native fixed camera cannot cycle',()=>game.o.views.length===1&&game.view.id==='overhead');\nconsole.log(JSON.stringify({count,failures}));process.exitCode=failures.length?1:0;\nJS\nnpm run build && npm run verify -- rules browser\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read();s=s.replace(\\\"new E.Shell(game,{theme:{tv:true,\\\",\\\"new E.Shell(game,{theme:{scale:w=>w.innerWidth<800?1:Math.min(2.3,w.innerWidth/850),\\\")\ns=s.replace(\\\"function intention(I,seat){\\\\n\\\", \\\"function intention(I,seat){\\\\n    if(app.testInputs?.[seat])return app.testInputs[seat];\\\\n    if(app.driver){const r=app.run||app.net?.run;if(r)return app.driver(r,seat)||{};}\\\\n\\\")\ns=s.replace(\\\"const p=r.players[0],touch=\\\", \\\"if(app.driver){for(const p of r.players)inputs[p.seat]=app.driver(r,p.seat)||{};}\\\\n        const p=r.players[0],touch=\\\")\ns=s.replace(\\\"sections:[['World',()=>JSON.stringify(app.net.state)]]\\\", \\\"sections:[['World','Floor '+(app.net.state.floor+1)+' • '+app.net.state.phase+' • tick '+app.net.state.tick],['Team',app.net.state.lives+' lives • '+app.net.state.stock+' bombs • '+app.net.state.rescued+' rescued'],['Entities',app.net.state.players.length+' rescuers • '+app.net.state.enemies.length+' beetles']]\\\")\n# Enable stable test drivers on remote clients through normal intentions from an authoritative snapshot.\ns=s.replace(\\\"if(app.driver){const r=app.run||app.net?.run;if(r)return app.driver(r,seat)||{};}\\\", \\\"if(app.driver){const r=app.net?app.net.planner():app.run;if(r)return app.driver(r,seat)||{};}\\\")\n# A meaningful axis must change to reset idle, otherwise a held stick could never leave attract.\ns=s.replace(\\\"if(game.input.anyPressed()||game.players.some(i=>Math.hypot(...i.padMove)>.35))\\\", \\\"if(game.input.anyPressed())\\\")\nopen(p,'w').write(s)\np='src/net.js';s=open(p).read().replace(\\\"    presentation(dt){\\\", \\\"    planner(){\\\\n      if(this.run)return this.run;const s=this.state;\\\\n      if(\"'!this.plan||this.plan.floor!==s.floor)this.plan=new T.Run({seed:s.seed,floor:s.floor,seats:s.players.map(p=>p.seat)});'\"\\\\n      const r=this.plan;for(const k of ['phase','stock','bomb','supply','rooms','homes','balance'])r[k]=s[k];\\\\n      const actor=a=>{const m=new My3D2dge.GridMover({cx:a.cx,cy:a.cy});Object.assign(m,{x:a.x,y:a.y,_to:a.to,_u:a.u,moving:a.moving,dir:a.dir});return {...a,m};};\\\\n      r.players=s.players.map(actor);r.enemies=s.enemies.map(actor);return r;\\\\n    }\\\\n    presentation(dt){\\\")\ns=s.replace(\\\"{to:this.info.host,reliable:false});\\\", \\\"{to:this.info.host,reliable:\"'!!this.pendingRoute});\")\nopen(p,'\"'w').write(s)\np='src/sim.js';s=open(p).read().replace(\\\"places.sort((a,b)=>danger(b)-danger(a));const c=places[0];p.m.place\\\", \\\"places.sort((a,b)=>danger(b)-danger(a));const c=places[0];if(danger(c)<1.5){p.hurt=.2;return;}p.m.place\\\")\nopen(p,'w').write(s)\nPY\ncat >> src/style.css <<'CSS'\n@media(min-width:800px){.esh-ttl .esh-btns{display:grid\"'!important;grid-template-columns:1fr 1fr!important;max-width:390px!important}.esh-ttl .esh-btns button:first-child{grid-column:1 / -1}.esh-ttl h1{font-size:48px!important}.esh-ttl>div{max-width:440px!important}.esh-ttl p{font-size:15px!important}.esh-ttl .esh-m{font-size:10px!important}}\nCSS\ncat > tests/rules.mjs <<'\"'JS'\nimport vm from 'node:vm';\nimport fs from 'node:fs';\nconst log=[];const c=vm.createContext({console:{log(){},warn(...a){log.push(a.join(' '));},error(...a){log.push(a.join(' '));}}});\nfor(const f of ['vendor/engine/my-3d2dge.js','src/content.js','src/sim.js','src/art.js','src/audio.js','src/net.js','src/main.js'])vm.runInContext(fs.readFileSync(f,'utf8'),c,{filename:f});\nconst T=c.TB,E=c.My3D2dge;let count=0;const failures=[];\nfunction check(name,test){count++;try{if(typeof test==='function'?test():test) return;failures.push(name);}catch(e){failures.push(name+': '+e.message);}}\nconst run=o=>{const r=new T.Run(o);r.phase='playing';r.damageGrace=0;return r;};\nconst place=(a,cell)=>{a.m.place(...cell);a.prev=cell.slice();a.bufferTime=0;a.route=null;};\nconst step=(r,t,inputs={})=>{for(let i=0;i<Math.round(t*120);i++)r.step(1/120,inputs);};\ncheck('all content validates',()=>T.FLOORS.every(f=>T.validate(f).length===0));\ncheck('four distinct required layouts',()=>new Set(T.FLOORS.map(f=>f.rows.join(''))).size>=4);\ncheck('26 required rescues',()=>T.FLOORS.reduce((n,f)=>n+f.quota,0)===26);\ncheck('disconnected content rejected',()=>{const f={...T.FLOORS[0],rows:T.FLOORS[0].rows.slice()};f.rows[6]='#.'+'#'.repeat(18)+'#';return T.validate(f).length>0;});\ncheck('quota validation',()=>T.validate({...T.FLOORS[0],quota:99}).length>0);\ncheck('conflict validation',()=>T.validate({...T.FLOORS[0],supply:[9,11]}).length>0);\ncheck('room deck deterministic',()=>JSON.stringify(new T.Run({seed:11}).rooms)===JSON.stringify(new T.Run({seed:11}).rooms));\ncheck('first teaching room is baby',()=>Array.from({length:20},(_,seed)=>new T.Run({seed}).rooms[0].kind==='baby').every(Boolean));\ncheck('different seeds change room deck',()=>new Set(Array.from({length:20},(_,seed)=>new T.Run({seed,floor:4}).rooms.map(r=>r.kind).join(','))).size>1);\ncheck('movement uses native grid mover',()=>run().players[0].m instanceof E.GridMover);\ncheck('wall blocks movement',()=>{const r=run(),p=r.players[0];place(p,[1,1]);step(r,.5,{0:{dir:[-1,0]}});return p.m.x===1;});\ncheck('continuous travel',()=>{const r=run(),p=r.players[0];step(r,.1,{0:{dir:[1,0]}});return p.m.x>9&&p.m.x<10;});\ncheck('immediate reversal',()=>{const r=run(),p=r.players[0];step(r,.12,{0:{dir:[1,0]}});const x=p.m.x;r.step(1/120,{0:{dir:[-1,0]}});return p.m.x<x;});\ncheck('diagonal rejected',()=>{const r=run(),p=r.players[0];r.step(1/120,{0:{dir:[1,1]}});return p.m.x===9&&p.m.y===11;});\ncheck('buffered early turn',()=>{const r=run(),p=r.players[0];place(p,[1,11]);step(r,.22,{0:{dir:[1,0]}});step(r,.1,{0:{dir:[0,-1]}});return p.m.y===11&&p.m.x>2;});\ncheck('carrying slows movement by 10%',()=>{const a=run(),b=run();b.players[0].carried='test';step(a,.1,{0:{dir:[1,0]}});step(b,.1,{0:{dir:[1,0]}});return Math.abs((b.players[0].m.x-9)/(a.players[0].m.x-9)-.9)<.01;});\ncheck('mouse route follows graph',()=>{const r=run();r.enemies=[];r.step(1/120,{0:{route:[7,9]}});step(r,3);return \"'!!r.players[0].carried;});\ncheck('\"'manual direction cancels route',()=>{const r=run();r.players[0].route=[1,1];r.step(1/120,{0:{dir:[1,0]}});return r.players[0].route===null;});\ncheck('swept crossing catches contact',()=>T.swept({prev:[0,0],m:{x:1,y:0}},{prev:[1,0],m:{x:0,y:0}})===0);\ncheck('pickup reserves reachable home',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);return p.carried&&r.homes[p.home].reserved===p.carried&&r.grid.path(r.rooms[0].cell,r.homes[p.home].cell).length;});\ncheck('one passenger limit',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);const id=p.carried;place(p,r.rooms[1].cell);r.reveal(p);return p.carried===id&&r.rooms[1].status==='hidden';});\ncheck('co-op reservations distinct',()=>{const r=run({seats:[0,1]});r.players.forEach((p,i)=>{place(p,r.rooms[i].cell);r.reveal(p);});return r.players.every(p=>p.carried)&&r.players[0].home\"'!==r.players[1].home;});\ncheck('\"'unavailable home leaves baby intact',()=>{const r=run(),p=r.players[0];r.homes.forEach(h=>h.reserved='busy');place(p,r.rooms[0].cell);r.reveal(p);return \"'!p.carried&&r.rooms[0].status==='\"'hidden'&&r.score===0;});\ncheck('delivery exactly once',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);place(p,r.homes[p.home].cell);r.deliver(p);r.deliver(p);return r.score===500&&r.delivered===1&&r.rescued===1&&\"'!p.carried;});\ncheck('\"'drop returns revealed passenger',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);p.invuln=0;r.hit(p);return r.rooms[0].status==='revealed'&&\"'!p.carried&&r.homes.every(h=>h.reserved===null);});\ncheck('\"'recovery never repeats discovery points',()=>{const r=run(),p=r.players[0];place(p,r.rooms[0].cell);r.reveal(p);r.drop(p);r.reveal(p);return r.score===100;});\ncheck('leaving releases passenger and reservation',()=>{const r=run({seats:[0,1]}),p=r.players[1];place(p,r.rooms[0].cell);r.reveal(p);r.leave(1);return \"'!p.active&&!p.carried&&r.rooms[0].status==='\"'revealed'&&r.homes.every(h=>h.seat\"'!==1);});\ncheck('\"'bomb costs exactly one, duplicate edge rejected',()=>{const r=run(),p=r.players[0];r.plant(p,{bomb:true,bombSeq:1});r.plant(p,{bomb:true,bombSeq:1});return r.stock===2;});\ncheck('one bomb for team',()=>{const r=run({seats:[0,1]});r.plant(r.players[0],{bomb:true,bombSeq:1});r.plant(r.players[1],{bomb:true,bombSeq:1});return r.stock===2&&r.bomb.seat===0;});\ncheck('empty feedback no negative stock',()=>{const r=run();r.stock=0;r.plant(r.players[0],{bomb:true,bombSeq:1});return r.stock===0&&\"'!r.bomb&&r.events.at(-1).type==='\"'empty';});\ncheck('expiration frees slot',()=>{const r=run();r.enemies=[];r.plant(r.players[0],{bomb:true,bombSeq:1});step(r,6.1);return \"'!r.bomb;});\ncheck('\"'localized stun precedes damage',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(p,[5,6]);place(b,[5,6]);b.emerge=0;p.invuln=0;r.plant(p,{bomb:true,bombSeq:1});r.step(1/120);return r.lives===3&&b.stun>0&&r.stock===2;});\ncheck('stun score only once',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(p,[5,6]);place(b,[5,6]);b.emerge=0;r.plant(p,{bomb:true,bombSeq:1});r.step(1/120);const s=r.score;b.stun=0;r.plant(p,{bomb:true,bombSeq:2});r.step(1/120);return r.score===s;});\ncheck('stun recovers to blue age zero',()=>{const r=run(),b=r.enemies[0];b.stun=.01;b.state='stunned';b.age=50;b.emerge=0;r.updateEnemy(b,.02);return b.state==='blue'&&b.age===0;});\ncheck('room beetle has emergence grace',()=>{const r=run({floor:1}),p=r.players[0],room=r.rooms.find(r=>r.kind==='beetle');place(p,room.cell);p.invuln=0;r.reveal(p);r.step(1/120);return r.lives===3&&r.enemies.at(-1).emerge>1;});\ncheck('LOS blocked by walls',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(b,[1,2]);place(p,[5,2]);return \"'!r.los(b,p);});\ncheck('\"'yellow sees straight corridors',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(b,[1,1]);place(p,[5,1]);b.state='yellow';r.choose(b);return b.sighted&&b.lastSeen[0]===5;});\ncheck('blue ignores target',()=>{const r=run(),p=r.players[0],b=r.enemies[0];b.state='blue';place(p,[19,11]);r.choose(b);return b.target===null&&b.lastSeen===null;});\ncheck('red routes around corner',()=>{const r=run(),p=r.players[0],b=r.enemies[0];place(b,[1,1]);place(p,[5,3]);b.state='red';return r.choose(b)&&b.target===0;});\ncheck('enemy target hysteresis',()=>{const r=run({seats:[0,1]}),b=r.enemies[0];place(b,[10,11]);place(r.players[0],[8,11]);place(r.players[1],[11,11]);b.target=0;return r.target(b).seat===0;});\ncheck('escalation warnings precede state',()=>{const r=run(),b=r.enemies[0];b.emerge=0;b.age=17;r.updateEnemy(b,.1);const warn=r.events.some(e=>e.type==='warning');b.age=18;r.updateEnemy(b,.1);return warn&&b.state==='yellow';});\ncheck('supply fresh entry plus recharge',()=>{const r=run(),p=r.players[0];r.enemies=[];r.stock=0;place(p,r.content.supply);r.step(1/120);const stock=r.stock;step(r,6.1);return stock===2&&r.stock===2&&r.supply.ready;});\ncheck('re-entering supply collects again',()=>{const r=run(),p=r.players[0];r.enemies=[];r.stock=0;place(p,r.content.supply);r.step(1/120);step(r,6.1);place(p,[9,6]);r.step(1/120);place(p,r.content.supply);r.step(1/120);return r.stock===4;});\ncheck('stock capped five',()=>{const r=run();r.stock=4;place(r.players[0],r.content.supply);r.step(1/120);return r.stock===5;});\ncheck('three team losses end run',()=>{const r=run(),p=r.players[0];for(let i=0;i<3;i++){p.invuln=0;p.hurt=0;r.damageGrace=0;r.hit(p);}return r.lives===0&&r.phase==='lost';});\ncheck('team damage grace',()=>{const r=run({seats:[0,1]});for(const p of r.players){p.invuln=0;r.hit(p);}return r.lives===2;});\ncheck('safe respawn avoids threat',()=>{const r=run(),p=r.players[0];for(const b of r.enemies){place(b,r.content.spawns[0]);b.emerge=0;}r.safeRespawn(p);return Math.hypot(p.m.x-r.enemies[0].m.x,p.m.y-r.enemies[0].m.y)>1.5&&p.invuln>0;});\ncheck('terminal world freezes',()=>{const r=run();r.phase='lost';const score=r.score,x=r.players[0].m.x;step(r,2,{0:{dir:[1,0],bomb:true,bombSeq:1}});return r.score===score&&r.players[0].m.x===x&&\"'!r.bomb;});\ncheck('\"'floor transition clears references',()=>{const r=run();r.plant(r.players[0],{bomb:true,bombSeq:1});r.startFloor(1);return \"'!r.bomb&&r.homes.every(h=>h.reserved===null)&&r.players.every(p=>!p.carried)&&r.rooms.every(q=>q.id.startsWith('\"'f1'));});\ncheck('live sliders constrain escalation',()=>{const r=run();r.setBalance('yellowAt',36);r.setBalance('redAt',15);return r.practice&&r.balance.redAt>=r.balance.yellowAt+3;});\ncheck('reset defaults immutable',()=>{const r=run();r.setBalance('playerSpeed',5);r.resetBalance();return r.balance.playerSpeed===3.5&&Object.isFrozen(T.DEFAULTS);});\n// Production input-driven campaigns. No invulnerability, teleports, objective edits, forced clears or balance changes.\nconst reports=[];\nfor(const [mode,seats,seed] of [['solo',[0],2701],['coop',[0,1],2701]]){\n const r=new T.Run({seats,seed,mode}),b=new T.Bot;const floors=new Set();\n for(let tick=0;tick<120*1200&&\"'!['\"'won','lost'].includes(r.phase);tick++){floors.add(r.floor);r.step(1/120,b.inputs(r));}\n reports.push({mode,phase:r.phase,floors:floors.size,rescued:r.rescued,lives:r.lives,seconds:r.elapsed,stats:r.stats});\n check(mode+' full production campaign',r.phase==='won'&&r.rescued===26&&floors.size===5&&\"'!r.practice&&!r.god);\n if(mode==='\"'solo')check('ordinary run exercises defence supply escalation and hits',r.stats.triggers>0&&r.stats.refills>0&&r.stats.escalations>0&&r.stats.hits>0);\n}\nfs.writeFileSync('build/campaign-evidence.json',JSON.stringify(reports,null,2));\nconst game=T.app.game;game.advance(.1);T.app.start();game.advance(2.5);check('native game stepping transitions to play',T.app.run.phase==='playing');\ngame.advance(.1,{draw:true});check('native draw no errors',()=>\"'!game.errors.length);\ncheck('\"'music default 10%',()=>game.settings.music===.1&&game.audio.musicVolume===.1);\ncheck('PS glyph default',()=>game.settings.glyphs==='playstation');\ncheck('native fixed camera cannot cycle',()=>game.o.views.length===1&&game.view.id==='overhead');\nconsole.log(JSON.stringify({count,failures}));process.exitCode=failures.length?1:0;\nJS\nnpm run build && npm run verify -- rules browser\"","aggregated_output":"npm notice run turtley-booked@1.0.0 build\nnpm notice run node tools/build.mjs\nBuilt Turtley-Booked-Turtles-gpt-6.1-sol-max-20261106-033015.html (1358513 bytes)\nnpm notice run turtley-booked@1.0.0 verify\nnpm notice run node tools/verify.mjs rules browser\nFAIL coop full production campaign\n67 checks, 1 failures.\n","exit_code":1,"status":"failed"}}
{"type":"item.completed","item":{"id":"item_50","type":"agent_message","text":"The bundled HTML now opens and plays from `file://`, and the initial browser checks pass. The TV screenshot exposed menu text that was too small; I’ve adjusted the native UI scaling and menu layout. I’m now testing the full rule set and Hub’s multi-copy harness.\n"}}
{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"sed -n '398,545p' vendor/hub/harness.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"sed -n '398,545p' vendor/hub/harness.html\"","aggregated_output":"  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/sim.js';s=open(p).read();s=s.replace(\\\"goal=scored[0]?.r.cell;\\\", \\\"goal=scored[0]?.r.cell;\\\\n        if(run.floor===1&&run.stats.decoys===0&&run.stock>=2){const decoy=run.rooms.find(r=>r.kind==='beetle'&&r.status==='hidden');if(decoy)goal=decoy.cell;}\\\")\ns=s.replace(\\\"const bomb=near<2.1&&\"'!run.bomb&&run.stock>0;\", \"const bomb=near<2.1&&!run.bomb&&run.stock>0;'\"\\\\n      if(bomb&&p.m.moving){const threat=live.slice().sort((a,b)=>Math.hypot(a.m.x-p.m.x,a.m.y-p.m.y)-Math.hypot(b.m.x-p.m.x,b.m.y-p.m.y))[0];\\\\n        if(threat&&(threat.m.x-p.m.x)*p.m.dir[0]+(threat.m.y-p.m.y)*p.m.dir[1]>.25)dir=[-p.m.dir[0],-p.m.dir[1]];}\\\")\nopen(p,'w').write(s)\nPY\ncat > tests/hub.py <<'PY'\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport pathlib\nimport sys\nimport threading\nimport urllib.parse\nfrom playwright.sync_api import sync_playwright\n\nroot = pathlib.Path(__file__).resolve().parents[1]\ncount = 0\nfailures = []\nevidence = []\nclass Handler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), functools.partial(Handler, directory=str(root)))\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\nbase = f'http://127.0.0.1:{server.server_port}'\ntry:\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page(viewport={'width': 1400, 'height': 900})\n        for scenario, network in [('standard', ''), ('standard', '&latency=150&jitter=50&loss=5'), ('server', ''), ('host-leave', '')]:\n            query = f'?game=/build/game.html&players=2&auto=1&scenario={scenario}&play=1500{network}'\n            page.goto(base + '/vendor/hub/harness.html' + query)\n            page.wait_for_function('document.body.dataset.complete === \\\"true\\\"', timeout=60000)\n            report = page.evaluate('window.__hubCheck')\n            evidence.append(report)\n            for check in report['checks']:\n                count += 1\n                if not check['pass']:\n                    failures.append(scenario + network + ': ' + check['name'] + ' — ' + check.get('detail', ''))\n            for frame in page.frames[1:]:\n                if 'game.html' in frame.url:\n                    count += 1\n                    if frame.title() \"'!= '\"'Turtley Booked':\n                        failures.append('Harness loaded the wrong game')\n            page.goto('about:blank')\n        browser.close()\nexcept Exception as e:\n    failures.append(str(e))\nfinally:\n    server.shutdown()\n    server.server_close()\n(root / 'build/hub-evidence.json').write_text(json.dumps(evidence, indent=2))\nprint(json.dumps({'count': count, 'failures': failures}))\nsys.exit(1 if failures else 0)\nPY\nnpm run build && npm run verify -- rules hub\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
