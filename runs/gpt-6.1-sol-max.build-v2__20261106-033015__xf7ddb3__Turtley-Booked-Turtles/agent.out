ued\":26,\"lives\":3,\"time\":202.6416666666467,\"stats\":{\"discoveries\":26,\"deliveries\":26,\"plants\":12,\"triggers\":9,\"stuns\":11,\"refills\":6,\"hits\":0,\"decoys\":2,\"escalations\":19}},\"copies\":[{\"rescued\":26,\"score\":14650,\"ended\":true,\"errors\":[]},{\"rescued\":26,\"score\":14650,\"ended\":true,\"errors\":[]},{\"rescued\":26,\"score\":14650,\"ended\":true,\"errors\":[]}]}\n19:pad_script = \"\"\"window.pad={id:'Emulated DualSense',index:0,mapping:'standard',connected:true,timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),vib [... omitted end of long line]\n24:    page.add_init_script(pad_script)\n87:    # A scripted ordinary route uses the mouse projection and native click handling.\n94:    # Whole exact HTML gameplay/ending through fixed-step native Game and ordinary intentions.\n98:    # No autoplay dependency, exact ten-second attract and consumed exits.\n100:    check('no early attract',page.evaluate('!TB.app.attract'))\n102:    check('attract starts at 10 seconds',page.evaluate('TB.app.attract'))\n105:    check('attract exit input consumed',page.evaluate('!TB.app.attract&&TB.app.game.sceneName===\"title\"&&TB.app.run===null'))\n    page.mouse.click(*point)\n    settle(page,1.4)\n    check('mouse click reaches mystery room',page.evaluate('!!TB.app.run.players[0].carried'))\n    page.screenshot(path=str(root/'build/carry-tv.png'))\n    # Whole exact HTML gameplay/ending through fixed-step native Game and ordinary intentions.\n    page.evaluate('''()=>{const a=TB.app;a.start('solo','shared',{seed:5});a.game.stop();const bot=new TB.Bot;a.driver=(r,seat)=>bot.intent(r,r.players.find(p=>p.seat===seat));for(let i=0;i<1200&&!a.resultShown;i++)a.game.advance(.5);a.driver=null;}''')\n    check('final HTML complete ordinary campaign',page.evaluate('TB.app.run.phase===\"won\"&&TB.app.run.rescued===26&&TB.app.ui.screen===\"results\"&&!TB.app.run.practice'))\n    page.screenshot(path=str(root/'build/results-tv.png'))\n    # No autoplay dependency, exact ten-second attract and consumed exits.\n    page.evaluate('TB.app.title();TB.app.game.advance(.1);TB.app.game.advance(9.6)')\n    check('no early attract',page.evaluate('!TB.app.attract'))\n    page.evaluate('TB.app.game.advance(.5)')\n    check('attract starts at 10 seconds',page.evaluate('TB.app.attract'))\n    page.keyboard.press('Enter')\n    page.evaluate('TB.app.game.advance(.2)')\n    check('attract exit input consumed',page.evaluate('!TB.app.attract&&TB.app.game.sceneName===\"title\"&&TB.app.run===null'))\n    check('no runtime or draw errors',not errors and page.evaluate('TB.app.game.errors.length===0'),errors)\n    page.close()\n    # Touch: portrait entire map, drag movement, two independent pointers and contextual action.\n    context=browser.new_context(**p.devices['iPhone 13'])\n    phone=context.new_page();phone.goto(url);settle(phone,.3)\n    phone.get_by_role('button',name='Check in • Solo',exact=True).tap();settle(phone,2.2)\n    phone.evaluate('TB.app.game.settings.set(\"assist\",false)')\n    x=phone.evaluate('TB.app.run.players[0].m.x')\n    touch=context.new_cdp_session(phone)\n    touch.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':100,'y':650,'id':101}]})\n    touch.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':160,'y':650,'id':101}]})\n    settle(phone,.25)\n    check('touch invisible drag moves turtle',phone.evaluate('TB.app.run.players[0].m.x')>x)\n    # Controlled encounter fixture only for UI exclusion/multitouch and screenshot, not campaign evidence.\n    phone.evaluate('''()=>{let r=TB.app.run,p=r.players[0],b=r.enemies[0];b.m.place(p.m.cx+1,p.m.cy);b.emerge=0;b.stun=0;r.damageGrace=5;r.balance.enemySpeed=0;r.practice=true;}''')\n    touch.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':100,'y':710,'id':101}]})\n    settle(phone,.1)\n    check('contextual touch bomb exists',phone.locator('[data-act=bomb]').is_visible())\nSkipped 140 suggested fixes.\nIf you wish to apply the suggested (unsafe) fixes, use the command biome check --write --unsafe\n\nChecked 14 files in 64ms. Fixed 3 files.\n","exit_code":0,"status":"completed"}}
