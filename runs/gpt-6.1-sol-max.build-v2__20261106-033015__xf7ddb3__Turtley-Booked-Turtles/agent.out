{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"sed -n '7830,7862p' vendor/engine/my-3d2dge.js && rg -n '_synth\\\\(|_note\\\\(|_voice\\\\(|_schedule\\\\(|_timer' vendor/engine/my-3d2dge.js | tail -25 && rg -n 'touchSet|bindButtons' vendor/engine/my-3d2dge.js | head -12\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"sed -n '7830,7862p' vendor/engine/my-3d2dge.js && rg -n '_synth\\\\(|_note\\\\(|_voice\\\\(|_schedule\\\\(|_timer' vendor/engine/my-3d2dge.js | tail -25 && rg -n 'touchSet|bindButtons' vendor/engine/my-3d2dge.js | head -12\"","aggregated_output":"  /**\n   * Play a sound effect: a preset name ('jump', 'coin', 'hit', 'explode', ...), a voice object, or a list of voices.\n   * opts: { vol: 0..1, pitch: multiplier, vary: random pitch spread (default 0.03), step: a step of the music playing (it\n   * sounds on that step of the music clock, scheduled with the music: a rhythm game's calls and claps), pan: -1 (left)\n   * .. 1 (right), loop: true (it sounds on until stopped: an engine, rain; through the effects' bus, so it follows the\n   * volume and the mute) }. Returns its handle: { stop(fade .03), set({ pan, vol }), playing, pan }: a handle that does\n   * nothing when nothing plays (headless, before the first key, an unknown name)\n   */\n  sfx(what, o = {}) {\n    const H = { playing: false, pan: clamp(o.pan || 0, -1, 1), stop() {}, set() { return H; } };\n    if (!this._init() || (this.muted && !o.loop)) return H;\n    const p = typeof what === 'string' ? this.presets[what] : what;\n    if (!p) { warn('sfx:' + what, 'unknown sound \"' + what + '\". Presets: ' + Object.keys(this.presets).join(', ') + ' (or audio.define(name, voice))'); return H; }\n    if (this.ctx.state !== 'running') return H;\n    const c = this.ctx, now = c.currentTime;\n    if (typeof what === 'string' && !o.loop) { if (now - (this._last[what] === undefined ? -1 : this._last[what]) < .035) return H; this._last[what] = now; }\n    const mul = (o.pitch || 1) * (1 + (o.vary === undefined ? .03 : o.vary) * (this._rnd() * 2 - 1));\n    const C = this.song, at = o.step !== undefined && C && C.anchor ? Math.max(now + .005, C.anchor.ctx + (this._timeOf(C, o.step) - C.anchor.clk) - this.offset) : now + .005;\n    const live = o.loop || o.pan !== undefined, out = live ? c.createGain() : null, pan = out && c.createStereoPanner ? c.createStereoPanner() : null, srcs = [];   // (a looped or panned one: its own gain and pan before the bus)\n    if (out) { if (pan) { pan.pan.value = H.pan; out.connect(pan); pan.connect(this._sfxBus); } else out.connect(this._sfxBus); }\n    try { for (const v of Array.isArray(p) ? p : [p]) srcs.push(...this._voice(o.vol === undefined ? v : Object.assign({}, v, { vol: (v.vol === undefined ? .3 : v.vol) * o.vol }), out || this._sfxBus, at, mul, !!o.loop)); }\n    catch (e) { warn('sfx-fail:' + what, 'could not play sound \"' + what + '\": ' + e.message); return H; }\n    H.playing = true;\n    H.stop = (fade = .03) => { if (!H.playing) return; H.playing = false; const t = c.currentTime; if (out) out.gain.setTargetAtTime(0, t, Math.max(.001, fade / 3)); for (const s of srcs) try { s.stop(t + (out ? fade + .05 : 0)); } catch (e) { /* stopped already */ } };\n    H.set = q => { const t = c.currentTime; if (q.pan !== undefined && pan) { H.pan = clamp(q.pan, -1, 1); pan.pan.setTargetAtTime(H.pan, t, .02); } if (q.vol !== undefined && out) out.gain.setTargetAtTime(Math.max(0, q.vol), t, .02); return H; };\n    return H;\n  }\n  /** an instrument of the game's own: fn(ctx, bus, time, freq, dur, vol) makes a note's sound (Web Audio, into bus, from\n   *  time); its name is a wave a music track (wave: 'pluck') or a voice takes */\n  instrument(name, fn) { (this._ins || (this._ins = {}))[name] = fn; return fn; }\n  /** add or replace a named sound: audio.define('zap', { wave: 'saw', freq: 1200, to: 200, dur: .2 }) */\n  define(name, voice) { this.presets[name] = voice; }\n  /**\n2399:    this.paused = false; this.pauseOverlay = true; this._timers = []; this.errors = []; this._errKeys = new Set(); this.live = !!o.live; this._goOn = false;\n2682:  after(seconds, fn, o = {}) { const t = { at: this.time + seconds, fn, every: 0, dead: false, keep: !!o.kee