 col=0;col<4;col++){const xx=x-w*.5+15+col*(w-28)/4;px.rect(g,xx,yy,17,17,'#263d46');px.rect(g,xx+2,yy+2,13,13,row<=Math.floor(time/4)%5?'#e7c98c':'#6d9991');px.rect(g,xx+8,yy+2,1,13,'#40616a');px.rect(g,xx+2,yy+8,13,1,'#40616a');}}\n        px.poly(g,[[x-w*.5-7,y-h*.5],[x,y-h*.5-24],[x+w*.5+8,y-h*.5]],'#d5b781');\n        px.rect(g,x-w*.5+22,y-h*.5-8,w-44,16,'#163a42');E.font.text(g,'THE SHELLTON',x,y-h*.5-4,'#f5dea8',{align:'center',outline:false});\n        px.rect(g,x-12,y+h*.5-20,24,21,'#132d38');px.rect(g,x-10,y+h*.5-17,20,17,'#dfb46e');\n        const rig=new TurtleRig(0);rig.update(time,{walk:.3,facing:-.4,carried:true,emote:0});rig.draw(g,x-31,y+h*.5+8,{zoom:1},3.2);\n        const second=new TurtleRig(1);second.update(time+.8,{walk:.4,facing:-2.7});second.draw(g,x+31,y+h*.5+6,{zoom:1},2.6);\n        if(celebrate){for(let i=0;i<26;i++){const a=i*2.4,xx=x+Math.sin(a+time)*Math.min(100,w*.6),yy=y+h*.5+25+Math.cos(a+time*.4)*12;px.ell(g,xx,yy,3,3,'#bbd482');px.ell(g,xx+2.7,yy+1,1.5,1.5,'#e1e5a4');}E.font.title(g,'EVERY GUEST, HOME.',r.W/2,Math.max(14,r.H*.12),{scale:2,align:'center',colors:['#fff2c6','#e9b778']});}\n      });\n    }\n  }\n  T.Art=Art;\n})(globalThis.TB);\nJS\ncat > src/audio.js <<'JS'\n(function(T){\n  'use strict';\n  T.formant=function(ctx,bus,time,freq=310,dur=.18,vol=.12){\n    const osc=ctx.createOscillator(),filter=ctx.createBiquadFilter(),gain=ctx.createGain();\n    osc.type='sawtooth';osc.frequency.setValueAtTime(freq,time);osc.frequency.exponentialRampToValueAtTime(freq*1.4,time+dur*.45);osc.frequency.exponentialRampToValueAtTime(freq*.78,time+dur);\n    filter.type='bandpass';filter.frequency.setValueAtTime(880,time);filter.frequency.exponentialRampToValueAtTime(1700,time+dur*.55);filter.Q.value=3.5;\n    gain.gain.setValueAtTime(0,time);gain.gain.linearRampToValueAtTime(vol,time+.012);gain.gain.setValueAtTime(vol*.6,time+dur*.55);gain.gain.linearRampToValueAtTime(0,time+dur);\n    osc.connect(filter);filter.connect(gain);gain.connect(bus);osc.start(time);osc.stop(time+dur+.01);\n    osc.onended=()=>{osc.disconnect();filter.disconnect();gain.disconnect();};return osc;\n  };\n  T.SONG={bpm:116,steps:2,tracks:[\n    {name:'bells',wave:'triangle',vol:.24,notes:'D5 . F#5 A5 . F#5 E5 . | D5 . B4 D5 A4 . . . | G4 B4 D5 . E5 D5 B4 . | A4 C#5 E5 . D5 . . .'},\n    {name:'patter',wave:'triangle',vol:.14,notes:'D3 . A3 . D3 . A3 . | B2 . F#3 . B2 . F#3 . | G2 . D3 . G2 . D3 . | A2 . E3 . A2 . E3 .'},\n    {name:'scat',wave:'turtle-voice',vol:.08,notes:'. . D4 . . A4 . . | . . F#4 . . D4 . . | . . G4 . . B4 . . | A4 . . C#4 . D4 . .'},\n    {name:'pursuit',wave:'drums',vol:.16,on:false,notes:'k . h . s . h . k . h . s . h .'}\n  ]};\n  const cues={pickup:[560,930,.16],delivery:[620,1240,.24],plant:[240,140,.12],trigger:[120,620,.28],expire:[380,150,.13],empty:[150,95,.23],busy:[300,240,.08],refill:[420,880,.2],'supply-ready':[780,1040,.12],decoy:[360,170,.25],sight:[920,1280,.1],warning:[520,620,.12],escalate:[650,340,.16],recovery:[390,660,.12],hit:[260,90,.3],clear:[440,880,.4],victory:[660,1320,.55],floor:[360,720,.2]};\n  class Sound{\n    constructor(game){this.game=game;this.audio=game.audio;this.last=0;this.nodes=new Set();this.playing=false;\n      this.audio.instrument('turtle-voice',(ctx,bus,time,freq,dur,vol)=>T.formant(ctx,bus,time,freq,Math.min(dur,.2),vol));\n      for(const [name,[freq,to,dur]] of Object.entries(cues))this.audio.define('tb-'+name,{wave:name==='trigger'?'noise':'triangle',freq,to,dur,vol:name==='hit'?.3:.18,arp:name==='delivery'?[0,4,7]:undefined,step:.07});\n    }\n    music(on=true){if(on===this.playing)return;this.playing=on;this.audio.music(on?T.SONG:null,{sync:true});}\n    voice(seat=0){const bus=this.audio.bus('voice'),ctx=this.audio.ctx;if(\"'!bus||!ctx||!this.audio.ready)return;\n      const n=T.formant(ctx,bus,ctx.currentTime,seat===0?320:400,.21,.15);this.nodes.add(n);n.addEventListener('\"'ended',()=>this.nodes.delete(n));}\n    update(st){if(\"'!st)return;for(const e of st.events||[])if(e.id>this.last){this.last=e.id;if(cues[e.type])this.audio.sfx('\"'tb-'+e.type);if(['pickup','delivery','hit'].includes(e.type))this.voice(e.seat);}\n      this.audio.layer('pursuit',st.enemies.some(b=>b.state==='red'&&b.stun<=0)?.55:0,.4);}\n    stop(){this.music(false);for(const n of this.nodes)try{n.stop();}catch{}this.nodes.clear();}\n  }\n  T.Sound=Sound;\n})(globalThis.TB);\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > src/art.js <<'JS'\n(function(T){\n  'use strict';const E=My3D2dge,{px}=E,INK='#101e2a',CREAM='#fff0c4';\n  T.seatColor=i=>i===0?'#9ed878':'#f3b579';\n  T.symbol=function(g,x,y,n,c,s=1){\n    if(n===0){px.poly(g,[[x,y-3*s],[x+3*s,y],[x,y+3*s],[x-3*s,y]],c);px.dot(g,x,y,CREAM);}\n    if(n===1){px.rect(g,x-2*s,y-2*s,4*s,4*s,c);px.rect(g,x-s,y-s,2*s,2*s,CREAM);}\n    if(n===2){px.line(g,x-3*s,y,x+3*s,y,c,s);px.line(g,x,y-3*s,x,y+3*s,c,s);px.dot(g,x,y,CREAM);}\n    if(n===3){px.ell(g,x,y,3*s,3*s,c);px.ell(g,x,y,1*s,1*s,CREAM);}\n  };\n  class TurtleRig extends E.Blob{\n    constructor(seat=0,baby=false){super({R:baby?3:6,feet:true});this.seat=seat;this.baby=baby;this.actor={};this.angle=-Math.PI/2;}\n    update(dt,a={}){\n      this.actor=a;super.update(dt,{walk:(a.walk||0)/3.5,look:[Math.cos(a.facing??0),Math.sin(a.facing??0)],squash:a.emote>0?Math.sin(a.emote*14)*.08:0});\n      const f=a.facing??this.angle;let d=((f-this.angle+Math.PI*3)%(Math.PI*2))-Math.PI;this.angle+=d*Math.min(1,dt*16);\n    }\n    draw(g,x,y,view,scale=1){\n      const s=scale*(view.zoom||1)*(this.baby?.56:1),a=this.actor,t=this.t,skin=E.tones(this.seat===0?'#94be77':'#b1cc89'),shell=E.tones(this.seat===0?'#477e58':'#467b89'),col=T.seatColor(this.seat);\n      const hurt=a.hurt>0,breath=Math.sin(t*3)*.25,bob=(a.walk>.1?Math.sin(t*17)*.3:breath)*s;\n      y-=bob;const dir=[Math.cos(this.angle),Math.sin(this.angle)];\n      const point=(ac,fw)=>[x+(ac*dir[1]+fw*dir[0])*s,y+(-ac*dir[0]+fw*dir[1])*s];\n      const ell=(ac,fw,rx,ry,c)=>{const p=point(ac,fw);px.ell(g,p[0],p[1],rx*s,ry*s,c);};\n      if(\"'!hurt){\n        for(const side of [-1,1])for(const fw of [-1,1]){const gait=Math.sin(t*16+side*fw*1.5)*(a.walk>.1?1:0);ell(side*5,fw*3+gait,2,1.8,skin.deep);ell(side*5-.3,fw*3+gait-.4,1.5,1.1,skin.base);}\n        ell(0,6.5,3.2,3,skin.deep);ell(0,6.5,2.7,2.6,skin.base);ell(-.7,5.8,1.6,1.4,skin.lt);\n      }\n      px.ell(g,x,y,6.3*s,(6+breath)*s,shell.deep);px.ell(g,x-.3*s,y-.7*s,5.5*s,(5.1+breath)*s,shell.base);\n      px.ell(g,x-1.5*s,y-2.3*s,3.6*s,2.6*s,shell.lt);px.ell(g,x+1.5*s,y+2*s,3.3*s,2*s,shell.sh);\n      // Different scutes and a bellhop cap / neckerchief identify the two rescuers beyond hue.\n      if(this.seat===0){px.poly(g,[[x,y-3*s],[x+3*s,y],[x,y+3*s],[x-3*s,y]],shell.deep);px.poly(g,[[x,y-2*s],[x+2*s,y],[x,y+2*s],[x-2*s,y]],col);}\n      else{px.line(g,x-4*s,y,x+4*s,y,shell.deep,s);px.line(g,x,y-4*s,x,y+4*s,shell.deep,s);px.rect(g,x-1*s,y-1*s,2*s,2*s,col);}\n      px.rect(g,x-3*s,y-4*s,2*s,s,shell.hi);\n      if(!hurt){\n        const head=point(0,7);const blink=(t%4.1)>3.95;\n        for(const side of [-1,1]){const eye=point(side*1.5,7.8);px.ell(g,eye[0],eye[1],1.3*s,blink?.4*s:1.5*s,CREAM);if(!blink)px.ell(g,eye[0]+dir[0]*.5*s,eye[1]+dir[1]*.5*s,.65*s,.85*s,INK);}\n        const cap=point(0,4.9);if(this.seat===0){px.rect(g,cap[0]-2.4*s,cap[1]-1.2*s,4.8*s,1.8*s,'\"'#e4b36c');px.rect(g,cap[0]-.7*s,cap[1]-1.8*s,1.4*s,s,CREAM);}else{px.poly(g,[[cap[0]-2*s,cap[1]],[cap[0]+2*s,cap[1]],[cap[0]+3*s,cap[1]+3*s]],'#efac8e');}\n      }else{px.line(g,x-2*s,y,x-s,y+s,CREAM,s);px.line(g,x+s,y+s,x+2*s,y,CREAM,s);}\n      if(a.carried){\n        const hop=a.emote>.15?Math.sin(Math.min(1,(.7-a.emote)/.55)*Math.PI)*3:0;\n        const by=y-4*s-hop*s;px.ell(g,x,by,3.4*s,3.1*s,'#173b37');px.ell(g,x-.4*s,by-.5*s,2.7*s,2.5*s,'#b8d97c');\n        px.ell(g,x+2.6*s,by+1.1*s,1.7*s,1.7*s,'#dbe9a0');px.dot(g,x+3*s,by+1*s,INK);\n        T.symbol(g,x-s,by-s,a.symbol??0,'#fff1b0',.48*s);\n      }\n    }\n  }\n  class BeetleRig extends E.Blob{\n    constructor(){super({R:5,feet:true});this.actor={};}\n    update(dt,a){this.actor=a;super.update(dt,{walk:(a.walk||0)/2.5,look:[Math.cos(a.facing),Math.sin(a.facing)],squash:a.stun>0?Math.sin(this.t*12)*.09:0});}\n    draw(g,x,y,view){\n      const a=this.actor,s=view.zoom||1,t=this.t,stun=a.stun>0,col=E.tones(stun?'#798b9c':a.state==='red'?'#e66b70':a.state==='yellow'?'#e6c85b':'#6ca9d1');\n      const wiggle=stun?Math.sin(t*8)*s:0;y-=a.emerge>0?Math.max(0,Math.sin(a.emerge*10))*2*s:0;\n      for(const side of [-1,1])for(let i=-1;i<=1;i++){const w=stun?0:Math.sin(t*23+i+side)*1.3;px.line(g,x+side*3*s,y+i*2*s,x+side*(6+w)*s,y+(i*2+1)*s,INK,s);px.dot(g,x+side*(6+w)*s,y+(i*2+1)*s,col.sh);}\n      px.ell(g,x+wiggle,y,5.2*s,5.8*s,col.deep);px.ell(g,x-.3*s+wiggle,y-.7*s,4.5*s,4.7*s,col.base);px.ell(g,x-1.4*s+wiggle,y-2*s,2.5*s,2.4*s,col.lt);\n      px.line(g,x+wiggle,y-4*s,x+wiggle,y+4*s,col.deep,s);\n      if(a.state==='red'){px.line(g,x-3*s,y-1*s,x,y+2*s,CREAM,s);px.line(g,x,y+2*s,x+3*s,y-1*s,CREAM,s);}\n      if(a.state==='yellow'){px.poly(g,[[x,y-3*s],[x+2*s,y],[x-2*s,y]],CREAM);}\n      const alert=a.state\"'!=='\"'blue';for(const side of [-1,1]){px.line(g,x+side*2*s,y-4*s,x+side*(alert?5:4)*s,y-(alert?9:6)*s,col.deep,s);px.disc(g,x+side*(alert?5:4)*s,y-(alert?9:6)*s,s,col.lt);}\n      if(\"'!stun){for(const side of [-1,1]){px.ell(g,x+side*1.7*s,y-3*s,1.2*s,1.2*s,CREAM);px.dot(g,x+side*1.7*s,y-3*s,INK);}}\n      else for(let i=0;i<3;i++){const ang=t*2+i*2.1;T.symbol(g,x+Math.cos(ang)*7*s,y-6*s+Math.sin(ang)*2*s,2,'\"'#ffe9a0',.45*s);}\n      if(a.emerge>0)px.ell(g,x,y+4*s,6*s,1.5*s,'#eac585');\n      if(a.stun>0&&a.stun<.7)px.line(g,x-2*s,y+1*s,x+2*s,y+1*s,CREAM,s);\n    }\n  }\n  T.TurtleRig=TurtleRig;T.BeetleRig=BeetleRig;\n  class Art{\n    constructor(game){this.game=game;this.rigs=new Map();this.effects=[];this.lastEvent=0;this.map=null;this.floor=-1;this.state=null;}\n    update(dt,state){\n      this.state=state;if(\"'!state)return;\n      if(this.floor!==state.floor){this.floor=state.floor;this.map=T.makeMap(T.FLOORS[state.floor]);this.rigs.clear();this.effects=[];}\n      for(const a of [...state.players,...state.enemies]){let rig=this.rigs.get(a.id);if(!rig){rig=a.seat!==undefined?new TurtleRig(a.seat):new BeetleRig;this.rigs.set(a.id,rig);}\n        const room=state.rooms.find(r=>r.id===a.carried);rig.update(this.game.reduceMotion?dt*.3:dt,{...a,symbol:room?.symbol});}\n      for(const e of state.events||[])if(e.id>this.lastEvent){this.lastEvent=e.id;if(e.x!==undefined){this.effects.push({...e,t:0});if(!this.game.reduceMotion&&['\"'pickup','delivery','trigger','refill'].includes(e.type))this.game.particles.glints((e.x+.5)*16,(e.y+.5)*16,2,5,e.type==='trigger'?'#a8d6f5':'#ffe0a0');}}\n      this.effects=this.effects.filter(e=>(e.t+=dt)<1.3);\n      this.game.cam.smooth=0;this.game.focus(168,104,0);\n      this.game.cam.offset=[0,this.game.H>400?-25:8];\n    }\n    draw(r,debug={}){\n      const st=this.state;if(\"'!st)return;const f=T.FLOORS[st.floor],game=this.game;\n      r.sky(['\"'#101e2c','#152634','#192e38']);\n      r.decal(g=>{\n        const [x,y]=r.w(0,0);px.rect(g,x-9,y-9,354,226,'#091823');px.rect(g,x-6,y-6,348,220,'#b09a6a');px.rect(g,x-4,y-4,344,216,'#2d454c');\n      });\n      this.map.drawFloor(r);this.map.queueWalls(r);\n      // Shaded native props sit on wall blocks, outside navigable corridors.\n      for(const [x,y,id] of f.props)r.shape(id,(x+.5)*16,(y+.5)*16,0,{scale:.26,mats:{c:'porcelain'},hides:false});\n      for(const room of st.rooms){\n        const x=(room.cell[0]+.5)*16,y=(room.cell[1]+.5)*16;\n        r.actor(x,y,0,(g,ox,oy)=>{\n          px.rect(g,ox-6,oy-7,12,14,'#101c29');px.rect(g,ox-5,oy-7,10,12,'#99744e');px.rect(g,ox-4,oy-6,8,10,room.status==='hidden'?'#3a5863':'#293f46');px.rect(g,ox-4,oy-6,1,10,'#b9a078');\n          if(room.status==='hidden')E.font.text(g,'?',ox,oy-4,CREAM,{align:'center',outline:false});\n          else if(room.status==='revealed'){px.ell(g,ox,oy,3.2,3,'#b3d77d');px.ell(g,ox+2.5,oy+1,1.6,1.6,'#e2e7a1');px.dot(g,ox+3,oy,INK);}\n          else{px.rect(g,ox-2,oy-3,4,6,'#102d34');if(room.status==='delivered')T.symbol(g,ox,oy,2,'#b1cf9b',.5);}\n          if(debug.reveal)E.font.text(g,room.kind==='baby'?'B':'\"'!'\"',ox,oy+7,'#ffd58a',{align:'center',font:'tiny',outline:false});\n        });\n      }\n      for(const h of st.homes){\n        const x=(h.cell[0]+.5)*16,y=(h.cell[1]+.5)*16,room=st.rooms.find(q=>q.id===h.reserved),active=\"'!!room||h.glow>0,col=room?T.seatColor(h.seat):f.accent;\n        r.actor(x,y,0,(g,ox,oy)=>{\n          if(active)px.ell(g,ox,oy+3,8,7,E.shade(col,-.5));\n          px.poly(g,[[ox-8,oy-3],[ox,oy-10],[ox+8,oy-3]],active?col:'\"'#697674');px.rect(g,ox-6,oy-3,12,11,active?'#dfcf9f':'#6f7c78');px.rect(g,ox-4,oy,8,8,active?'#fce9a5':'#243b41');\n          if(room)T.symbol(g,ox,oy+3,room.symbol,T.seatColor(h.seat),.85);\n          else if(h.glow>0)E.font.text(g,'♥',ox,oy, '#ed9d91',{align:'center',outline:false});\n          else px.rect(g,ox-2,oy+3,4,5,'#183139');\n        });\n        if(active)game.lights.add(x,y,0,27,.5,{color:col});\n      }\n      const s=st.supply,[sx,sy]=f.supply.map(c=>(c+.5)*16);\n      r.actor(sx,sy,0,(g,x,y)=>{\n        px.ell(g,x,y+2,8,7,'#0b1f2b');px.ell(g,x,y,7,6,'#a2a998');px.ell(g,x,y-1,6,5,s.ready?'#7cc9bf':'#405e65');\n        px.rect(g,x-3,y-4,6,6,s.ready?'#c8f0ce':'#6c9090');px.rect(g,x-1,y-6,2,10,s.ready?'#fff3c5':'#273e47');px.rect(g,x-5,y-2,10,2,s.ready?'#fff3c5':'#273e47');\n        if(\"'!s.ready)E.font.text(g,String(Math.ceil(s.timer)),x,y-3,CREAM,{align:'\"'center',outline:false});\n      });if(s.ready)game.lights.add(sx,sy,0,25,.5,{color:'#aee8c4'});\n      if(st.bomb){const b=st.bomb,x=(b.x+.5)*16,y=(b.y+.5)*16;\n        r.actor(x,y,0,(g,ox,oy)=>{px.ell(g,ox,oy+1,5,4,'#192637');px.ell(g,ox,oy,4,4,'#d2a77a');px.ell(g,ox-1,oy-1,2,2,'#fce4b4');px.line(g,ox+1,oy-4,ox+3,oy-6,'#d6e0ab');px.disc(g,ox+3,oy-6,1+(Math.sin(game.time*12)>0?1:0),'#ffe7ab');});\n      }\n      for(const a of [...st.enemies,...st.players]){\n        if(a.active===false)continue;const x=(a.x+.5)*16,y=(a.y+.5)*16;\n        r.shadow(x,y,5,.28);const rig=this.rigs.get(a.id);\n        r.actor(x,y,0,(g,ox,oy)=>{if(a.invuln>0&&Math.floor(game.time*8)%2===0)px.ell(g,ox,oy,8,8,'#e1e6ba');rig?.draw(g,ox,oy,r.view);if(a.seat\"'!==undefined&&st.players.filter(p=>p.active).length>1){E.font.text(g,String(a.seat+1),ox,oy+10,T.seatColor(a.seat),{align:'\"'center',font:'tiny',outline:false});}});\n      }\n      r.overlay(g=>{\n        for(const e of this.effects){const [x,y]=r.w((e.x+.5)*16,(e.y+.5)*16,0),t=e.t;\n          if(e.type==='delivery'){px.ell(g,x+Math.sin(t*3)*5,y-8-Math.sin(Math.min(t,1)*Math.PI)*8,2.5,2,'#cfdea0');E.font.text(g,'+400',x,y-17-t*8,'#ffdd9e',{align:'center',outline:false});}\n          if(e.type==='pickup')E.font.text(g,'hello\"'!'\"',x,y-16-t*6,'#e3efb0',{align:'center',outline:false});\n          if(e.type==='trigger'){const rr=Math.min(26,t*65);for(let i=0;i<12;i++){const a=i*Math.PI/6;px.disc(g,x+Math.cos(a)*rr,y+Math.sin(a)*rr,1,'#afdfef');}}\n        }\n        if(debug.graph){for(let y=1;y<12;y++)for(let x=1;x<20;x++)if(f.rows[y][x]\"'!== '\"'#'){const p=r.w((x+.5)*16,(y+.5)*16);px.dot(g,...p,'#70e5e0');}}\n        if(debug.collision){for(const a of [...st.players,...st.enemies]){const [x,y]=r.w((a.x+.5)*16,(a.y+.5)*16);px.rect(g,x-4,y-4,8,1,'#ff83d5');px.rect(g,x-4,y+4,8,1,'#ff83d5');}}\n        if(debug.los){for(const b of st.enemies.filter(b=>b.state==='yellow'&&b.sighted)){const p=st.players.find(p=>p.seat===b.target)||st.players[0];px.line(g,...r.w((b.x+.5)*16,(b.y+.5)*16),...r.w((p.x+.5)*16,(p.y+.5)*16),'#ffe083');}}\n        this.hud(r,g,st);\n      });\n    }\n    hud(r,g,st){\n      const f=T.FLOORS[st.floor],left=(r.W-336)/2,top=(r.H-208)/2+(this.game.H>400?-25:8),portrait=r.H>400;\n      const tx=(s,x,y,c=CREAM,o={})=>E.font.text(g,s,x,y,c,{outline:false,shadow:INK,...o});\n      tx(String(st.floor+1).padStart(2,'0')+' / 05',left,top-27,f.accent);tx(f.name,left+57,top-27,CREAM);\n      tx('HOME '+st.delivered+'/'+f.quota,left,top-16,'#cfe3ac');tx('♥'.repeat(Math.max(0,st.lives))+'♡'.repeat(3-st.lives),left+99,top-16,'#edaba0');\n      tx(st.bomb?'BOMB ACTIVE':'BOMBS '+st.stock,left+163,top-16,st.stock?'#e2c895':'#f0a3a0');tx(String(st.score).padStart(6,'0'),left+336,top-16,CREAM,{align:'right'});\n      const p=st.players.find(p=>p.active&&(p.seat===this.game.localSeat||this.game.localSeat==null))||st.players[0];\n      const message=p?.carried?'Take your passenger to the matching lit home.':st.floorTime<16?'Visit a ? room. A tiny guest may need a lift.':'Blue wanders. Yellow sees. Red follows.';\n      const yy=top+220;tx(st.demo?'DEMO  •  Any input to check in':message,r.W/2,yy,f.accent,{align:'center'});\n      if(p?.carried){const room=st.rooms.find(q=>q.id===p.carried);T.symbol(g,r.W/2-145,yy+3,room?.symbol||0,T.seatColor(p.seat),.8);}\n      if(st.practice||st.assisted)tx(st.practice?'PRACTICE • UNRANKED':'TOUCH ASSIST • SEPARATE RECORD',r.W/2,yy+12,'#acccca',{align:'center'});\n      if(portrait){tx('SMALL SHELLS. BIG ROOM SERVICE.',r.W/2,Math.min(r.H-135,yy+66),'#96adb0',{align:'center'});}\n      if(st.phase==='intro'||st.phase==='clear'){\n        E.ui.box(g,r.W/2-151,r.H/2-28,302,56,{bg:'#102632',border:f.accent});tx(st.phase==='clear'?'FLOOR SAFE\"'! +250'\"':f.name,r.W/2,r.H/2-18,CREAM,{align:'center',scale:2});\n        tx(st.phase==='clear'?'Next stop: a little higher.':f.subtitle,r.W/2,r.H/2+1,f.accent,{align:'center',wrap:285});\n        tx('Confirm to skip',r.W/2,r.H/2+17,'#a7bbb5',{align:'center',font:'tiny'});\n      }\n    }\n    title(r,time=0,celebrate=false){\n      r.sky(['#102132','#1a3543','#345258']);r.overlay(g=>{\n        for(let i=0;i<58;i++){const x=(i*97+13)%r.W,y=(i*31+7)%Math.max(1,r.H-50);px.dot(g,x,y,i%4?'#607b7b':'#cbbf8d');}\n        const x=r.W*.73,y=r.H*.51,w=Math.min(172,r.W*.41),h=174;\n        px.ell(g,x,y+h*.55,w*.9,17,'#142b36');\n        px.poly(g,[[x-w*.5,y-h*.5],[x+w*.5,y-h*.5],[x+w*.5+20,y-h*.5+18],[x+w*.5+20,y+h*.5],[x-w*.5,y+h*.5]],'#1d3440');\n        px.rect(g,x-w*.5,y-h*.5,w,h,'#a99070');px.rect(g,x-w*.5+4,y-h*.5+5,w-8,h-9,'#5b7670');\n        for(let row=0;row<5;row++){const yy=y+h*.5-26-row*28;px.rect(g,x-w*.5,yy+20,w,3,'#d6bf90');for(let col=0;col<4;col++){const xx=x-w*.5+15+col*(w-28)/4;px.rect(g,xx,yy,17,17,'#263d46');px.rect(g,xx+2,yy+2,13,13,row<=Math.floor(time/4)%5?'#e7c98c':'#6d9991');px.rect(g,xx+8,yy+2,1,13,'#40616a');px.rect(g,xx+2,yy+8,13,1,'#40616a');}}\n        px.poly(g,[[x-w*.5-7,y-h*.5],[x,y-h*.5-24],[x+w*.5+8,y-h*.5]],'#d5b781');\n        px.rect(g,x-w*.5+22,y-h*.5-8,w-44,16,'#163a42');E.font.text(g,'THE SHELLTON',x,y-h*.5-4,'#f5dea8',{align:'center',outline:false});\n        px.rect(g,x-12,y+h*.5-20,24,21,'#132d38');px.rect(g,x-10,y+h*.5-17,20,17,'#dfb46e');\n        const rig=new TurtleRig(0);rig.update(time,{walk:.3,facing:-.4,carried:true,emote:0});rig.draw(g,x-31,y+h*.5+8,{zoom:1},3.2);\n        const second=new TurtleRig(1);second.update(time+.8,{walk:.4,facing:-2.7});second.draw(g,x+31,y+h*.5+6,{zoom:1},2.6);\n        if(celebrate){for(let i=0;i<26;i++){const a=i*2.4,xx=x+Math.sin(a+time)*Math.min(100,w*.6),yy=y+h*.5+25+Math.cos(a+time*.4)*12;px.ell(g,xx,yy,3,3,'#bbd482');px.ell(g,xx+2.7,yy+1,1.5,1.5,'#e1e5a4');}E.font.title(g,'EVERY GUEST, HOME.',r.W/2,Math.max(14,r.H*.12),{scale:2,align:'center',colors:['#fff2c6','#e9b778']});}\n      });\n    }\n  }\n  T.Art=Art;\n})(globalThis.TB);\nJS\ncat > src/audio.js <<'JS'\n(function(T){\n  'use strict';\n  T.formant=function(ctx,bus,time,freq=310,dur=.18,vol=.12){\n    const osc=ctx.createOscillator(),filter=ctx.createBiquadFilter(),gain=ctx.createGain();\n    osc.type='sawtooth';osc.frequency.setValueAtTime(freq,time);osc.frequency.exponentialRampToValueAtTime(freq*1.4,time+dur*.45);osc.frequency.exponentialRampToValueAtTime(freq*.78,time+dur);\n    filter.type='bandpass';filter.frequency.setValueAtTime(880,time);filter.frequency.exponentialRampToValueAtTime(1700,time+dur*.55);filter.Q.value=3.5;\n    gain.gain.setValueAtTime(0,time);gain.gain.linearRampToValueAtTime(vol,time+.012);gain.gain.setValueAtTime(vol*.6,time+dur*.55);gain.gain.linearRampToValueAtTime(0,time+dur);\n    osc.connect(filter);filter.connect(gain);gain.connect(bus);osc.start(time);osc.stop(time+dur+.01);\n    osc.onended=()=>{osc.disconnect();filter.disconnect();gain.disconnect();};return osc;\n  };\n  T.SONG={bpm:116,steps:2,tracks:[\n    {name:'bells',wave:'triangle',vol:.24,notes:'D5 . F#5 A5 . F#5 E5 . | D5 . B4 D5 A4 . . . | G4 B4 D5 . E5 D5 B4 . | A4 C#5 E5 . D5 . . .'},\n    {name:'patter',wave:'triangle',vol:.14,notes:'D3 . A3 . D3 . A3 . | B2 . F#3 . B2 . F#3 . | G2 . D3 . G2 . D3 . | A2 . E3 . A2 . E3 .'},\n    {name:'scat',wave:'turtle-voice',vol:.08,notes:'. . D4 . . A4 . . | . . F#4 . . D4 . . | . . G4 . . B4 . . | A4 . . C#4 . D4 . .'},\n    {name:'pursuit',wave:'drums',vol:.16,on:false,notes:'k . h . s . h . k . h . s . h .'}\n  ]};\n  const cues={pickup:[560,930,.16],delivery:[620,1240,.24],plant:[240,140,.12],trigger:[120,620,.28],expire:[380,150,.13],empty:[150,95,.23],busy:[300,240,.08],refill:[420,880,.2],'supply-ready':[780,1040,.12],decoy:[360,170,.25],sight:[920,1280,.1],warning:[520,620,.12],escalate:[650,340,.16],recovery:[390,660,.12],hit:[260,90,.3],clear:[440,880,.4],victory:[660,1320,.55],floor:[360,720,.2]};\n  class Sound{\n    constructor(game){this.game=game;this.audio=game.audio;this.last=0;this.nodes=new Set();this.playing=false;\n      this.audio.instrument('turtle-voice',(ctx,bus,time,freq,dur,vol)=>T.formant(ctx,bus,time,freq,Math.min(dur,.2),vol));\n      for(const [name,[freq,to,dur]] of Object.entries(cues))this.audio.define('tb-'+name,{wave:name==='trigger'?'noise':'triangle',freq,to,dur,vol:name==='hit'?.3:.18,arp:name==='delivery'?[0,4,7]:undefined,step:.07});\n    }\n    music(on=true){if(on===this.playing)return;this.playing=on;this.audio.music(on?T.SONG:null,{sync:true});}\n    voice(seat=0){const bus=this.audio.bus('voice'),ctx=this.audio.ctx;if(\"'!bus||!ctx||!this.audio.ready)return;\n      const n=T.formant(ctx,bus,ctx.currentTime,seat===0?320:400,.21,.15);this.nodes.add(n);n.addEventListener('\"'ended',()=>this.nodes.delete(n));}\n    update(st){if(\"'!st)return;for(const e of st.events||[])if(e.id>this.last){this.last=e.id;if(cues[e.type])this.audio.sfx('\"'tb-'+e.type);if(['pickup','delivery','hit'].includes(e.type))this.voice(e.seat);}\n      this.audio.layer('pursuit',st.enemies.some(b=>b.state==='red'&&b.stun<=0)?.55:0,.4);}\n    stop(){this.music(false);for(const n of this.nodes)try{n.stop();}catch{}this.nodes.clear();}\n  }\n  T.Sound=Sound;\n})(globalThis.TB);\nJS\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"sed -n '3650,3788p' vendor/engine/my-3d2dge.js && sed -n '9467,9492p' vendor/engine/my-3d2dge.js && sed -n '9632,9651p' vendor/engine/my-3d2dge.js && sed -n '10720,10743p' vendor/engine/my-3d2dge.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"sed -n '3650,3788p' vendor/engine/my-3d2dge.js && sed -n '9467,9492p' vendor/engine/my-3d2dge.js && sed -n '9632,9651p' vendor/engine/my-3d2dge.js && sed -n '10720,10743p' vendor/engine/my-3d2dge.js\"","aggregated_output":" *    Numpad notation names directions as the keys of a number pad, for a fighter facing right: 1 down-back, 2 down, 3\n *    down-forward, 4 back, 5 neutral, 6 forward, 7 up-back, 8 up, 9 up-forward; facing left mirrors them.\n * ============================================================================= */\nconst _DIRS = ['up', 'down', 'left', 'right'], _PAD = { 0: 5, 1: 8, 2: 2, 4: 4, 8: 6, 5: 7, 9: 9, 6: 1, 10: 3 };   // direction bits (up 1, down 2, left 4, right 8) -> numpad, facing right\nHOOKS.input.push(g => { for (const I of g._players || [g.input]) {   // (each player's own history: game.players)\n  const H = I._hist || (I._hist = []); let b = 0;\n  for (let i = 0; i < 4; i++) if (I.map[_DIRS[i]] && I.down(_DIRS[i])) b |= 1 << i;\n  if (b & 3) b = (b & 3) === 3 ? b & ~3 : b; if ((b & 12) === 12) b &= ~12;   // (both ways at once: neither)\n  const last = H[H.length - 1], pressed = [...I._now].filter(a => !_DIRS.includes(a));\n  if (!last || last._b !== b || pressed.length) H.push({ t: I.clock, dir: _PAD[b] || 5, pressed, _b: b });\n  while (H.length > 2 && H[1].t < I.clock - 1) H.shift();\n} });\n// one step of a sequence, 'down+right' or 'attack' or 'down+attack': the directions it holds (bits) and the buttons pressed\nconst _seqStep = s => { let b = 0, dirs = false; const btn = []; for (const p of String(s).split('+')) { const i = _DIRS.indexOf(p); if (i >= 0) { b |= 1 << i; dirs = true; } else if (p === 'neutral') dirs = true; else if (p) btn.push(p); } return { b, dirs, btn }; };\n/**\n * true on the step a sequence of inputs ends, each one after the last within window seconds (.5) of the first:\n * input.sequence(['down', 'down+right', 'right', 'attack']). A step names actions joined by +: its directions are held\n * exactly as it says (up, down, left, right; 'neutral' for none) as they change to that, its buttons pressed. A cheat\n * code: input.sequence(['up', 'up', 'down', 'down', 'left', 'right', 'left', 'right', 'kick', 'attack'], { window: 3 })\n */\nInput.prototype.sequence = function (steps, o = {}) {\n  const H = this._hist, n = steps.length; if (!H || !H.length || !n) return false;\n  const win = o.window === undefined ? .5 : o.window, last = H[H.length - 1], now = this.clock;\n  if (last.t !== now) return false;\n  const ok = (st, k) => { const h = H[k]; if (st.dirs && h._b !== st.b) return false; if (st.btn.length) return st.btn.every(a => h.pressed.includes(a)); return k === 0 || H[k - 1]._b !== h._b; };\n  const S = steps.map(_seqStep); let i = n - 1, k = H.length - 1; if (!ok(S[i], k)) return false;\n  if (S[i].dirs || !S[i - 1] || S[i - 1].btn.length) k--;   // (a button may land on the step its motion ends)\n  for (i--; i >= 0 && k >= 0; k--) { if (now - H[k].t > win) return false; if (ok(S[i], k)) i--; }\n  return i < 0;\n};\n/**\n * a fighter's move in numpad notation, mirrored by facing: input.motion('236', 'attack', { facing: hero.facing, window })\n * is a quarter circle forward and punch (down, down-forward, forward, attack: a fireball); '623' a dragon punch, '41236'\n * a half circle. facing: 1 (right, the default) or -1. button: an action, 'attack+kick', or none (the motion alone)\n */\nInput.prototype.motion = function (digits, button, o = {}) {\n  const fw = (o.facing || 1) < 0 ? 'left' : 'right', bk = fw === 'left' ? 'right' : 'left';\n  const D = { 1: 'down+' + bk, 2: 'down', 3: 'down+' + fw, 4: bk, 5: 'neutral', 6: fw, 7: 'up+' + bk, 8: 'up', 9: 'up+' + fw };\n  const steps = String(digits).split('').map(c => D[c]).filter(Boolean);\n  if (button) steps.push(button);\n  return this.sequence(steps, Object.assign({ window: .45 }, o));\n};\n\n/* =============================================================================\n * 10i. CAMERA WINDOW AND FRAMING  game.cam.window (a dead zone), cam.snapY (height on landing), cam.frame(targets)\n *    (several things kept in view): where the camera aims, from where it would aim (tx, ty: its top-left corner, in\n *    projected pixels). Game's _camStep asks it while one of them is set\n * ============================================================================= */\n// where the camera aims: framed between its targets (zooming to fit), its height held until a landing, kept still while\n// the focus stays in the window\nGame.prototype._camAim = function (tx, ty) {\n  const c = this.cam, W = this.screen.W, H = this.screen.H, fr = this._framed;\n  if (fr) {\n    let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;\n    for (const t of fr.list) { if (!t) continue; const [px2, py2] = this.view.p(t.x || 0, t.y || 0, t.z || 0); x0 = Math.min(x0, px2); x1 = Math.max(x1, px2); y0 = Math.min(y0, py2 - 16); y1 = Math.max(y1, py2); }\n    if (x1 >= x0) {\n      tx = (x0 + x1 - W) / 2; ty = (y0 + y1 - H) / 2;\n      const Z = fr.zoom; if (Z) {   // out at once when they don't fit, back in once they would fit well\n        const k = Math.min((W - 2 * fr.margin) / Math.max(1, x1 - x0), (H - 2 * fr.margin) / Math.max(1, y1 - y0)), z = this._zoomBase;\n        const want = clamp(Math.floor(z * Math.min(k, 1.25) * 20) / 20, Z[0], Z[1]);\n        if (want < z - 1e-9 || (k > 1.2 && want > z + 1e-9)) this.setZoom(want);\n      }\n    }\n  }\n  const f = this._follow;\n  if (c.snapY) { const t = f && f.target, lim = H * .3; if (c.snap || c._ly === undefined || !t || t.onGround !== false) c._ly = ty; else c._ly = clamp(c._ly, ty - lim, ty + lim); ty = c._ly; }\n  if (c.window) { const [ww, wh] = c.window; if (c.snap || c._wx === undefined) { c._wx = tx; c._wy = ty; } c._wx = clamp(c._wx, tx - ww / 2, tx + ww / 2); c._wy = clamp(c._wy, ty - (wh || 0) / 2, ty + (wh || 0) / 2); tx = c._wx; ty = c._wy; }\n  return [tx, ty];\n};\n\n/* =============================================================================\n * 10j. PLAYERS AND SPLIT SCREEN  two to four on one machine. game.players: game.input is player 1 (a game of one is\n *    unchanged), each other an input of its own, with game.input's API, its device and its bindings: a gamepad each, or\n *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; ' and the\n *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\n *    right half's start) on the keyboard, player 1 then playing on its left half; game.removePlayer(p). Each has player (its\n *    number), name ('P2') and color. A pause says who paused, a lost controller names its player, the Controls screen\n *    has a page each. game.splitScreen(n, { layout, follow }): two to four viewports, each its own camera (viewport.follow,\n *    viewport.focus), the scene drawn once in each (r.viewport says which: { i, x, y, w, h }) and scene.hud(r) once over\n *    the whole screen; GPU lighting off while split. A scene's start ends a split.\n * ============================================================================= */\nconst KEY_HALVES = {   // each half's moves, its buttons in order (the preset's other actions take them in turn) and its menu keys\n  left: { up: ['KeyW'], down: ['KeyS'], left: ['KeyA'], right: ['KeyD'], buttons: [['KeyF'], ['KeyG'], ['KeyH'], ['KeyR'], ['KeyT'], ['KeyY'], ['KeyV'], ['KeyB']], start: ['Digit1'], pause: ['Escape', 'Digit1'], confirm: ['KeyF'], cancel: ['KeyG'] },\n  right: { up: ['ArrowUp'], down: ['ArrowDown'], left: ['ArrowLeft'], right: ['ArrowRight'], buttons: [['Period', 'Numpad1'], ['Slash', 'Numpad2'], ['Comma', 'Numpad3'], ['KeyL', 'Numpad4'], ['Semicolon', 'Numpad5'], ['Quote', 'Numpad6'], ['KeyK', 'Numpad7'], ['KeyM', 'Numpad8']],\n    start: ['Digit2', 'Enter', 'NumpadEnter'], pause: ['Digit2', 'Backspace'], confirm: ['Period', 'Enter', 'NumpadEnter'], cancel: ['Slash', 'Backspace'] }\n};\n/** a preset for half a keyboard ('left' or 'right'): its moves and menu keys, the preset's other actions on its buttons\n *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /).\n *  A preset's own halves come first: preset.halves = { left: { pass: ['KeyR'] }, right: { pass: ['KeyL'] } } (an action\n *  a menu reads beside confirm would take confirm's F otherwise) */\nInput.halfKeys = (preset, side) => {\n  const P = typeof preset === 'string' ? Input[preset.toUpperCase()] || Input.DEFAULT : preset || Input.DEFAULT, H = KEY_HALVES[side] || KEY_HALVES.left, own = (P.halves && P.halves[side]) || {}, out = {};\n  let k = 0;\n  for (const a in P) if (Array.isArray(P[a])) out[a] = (own[a] || H[a] || H.buttons[k++] || []).concat(P[a].filter(c => padCode(c)));\n  return out;\n};\nconst _pStub = game => Object.create(game.screen, { canvas: { value: null } });   // (another player's input: the screen's sizes, no listeners of its own)\nconst _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\nfunction _pClaim(game) {   // player 1 reads no pad another player holds; the keyboard's codes go to the players sharing it\n  const P = game.players, I = P[0];\n  I._claimed = new Set(P.slice(1).filter(q => typeof q.pad === 'number').map(q => q.pad));\n  I.keysTo = P.slice(1).filter(q => q.half).concat(game._lobby ? [game._lobby] : []);\n  if (!I.keysTo.length) I.keysTo = null;\n}\n/** let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin\n *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\nGame.prototype.allowJoin = function (o = {}) {\n  if (o === false) { this._join = null; this._lobby = null; _pClaim(this); return this; }\n