{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '70,155p' vendor/hub/examples/arena.html && rg -n 'AIHub|snapshot|message|seq|time-up|leave' vendor/hub/examples/arena.html | tail -50 && rg -n 'scenario|limit|auto|time.?up|__hubCheck' vendor/hub/harness.html\"","aggregated_output":"      },\n      setItem: function (k, v) {\n        data[String(k)] = String(v);\n      },\n      removeItem: function (k) {\n        delete data[String(k)];\n      },\n      clear: function () {\n        for (var k in data) delete data[k];\n      },\n      key: function (i) {\n        var keys = Object.keys(data);\n        return i >= 0 && i < keys.length ? keys[i] : null;\n      },\n    };\n    if (typeof Proxy !== 'function') return api;\n    return new Proxy(api, {\n      get: function (t, k) {\n        if (k === 'length') return Object.keys(data).length;\n        if (typeof k === 'symbol' || k in t) return t[k];\n        return k in data ? data[k] : undefined;\n      },\n      set: function (t, k, v) {\n        if (typeof k !== 'symbol') data[k] = String(v);\n        return true;\n      },\n      has: function (t, k) {\n        return k in data || k in t;\n      },\n      deleteProperty: function (t, k) {\n        delete data[k];\n        return true;\n      },\n      ownKeys: function () {\n        return Object.keys(data);\n      },\n      getOwnPropertyDescriptor: function (t, k) {\n        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n      },\n    });\n  }\n\n  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n  function generator(a) {\n    return function () {\n      a = (a + 0x6d2b79f5) >>> 0;\n      var t = a;\n      t = Math.imul(t ^ (t >>> 15), t | 1);\n      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n\n  // A fair start: in a session the game gets an empty storage of its own, so\n  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n  // and nothing the round saves touches the player's own saves.\n  if (hub.active) {\n    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n      try {\n        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n      } catch (e) {\n        warn('could not give the game a fresh ' + stores[s]);\n      }\n    }\n  }\n\n  // Side by side: before any of the game's own scripts run, Math.random becomes\n  // a generator seeded by the hub, so every copy builds the same start.\n  var realRandom = Math.random;\n  var seededRandom = null;\n  if (hub.active && seedArg) {\n    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n    hub.seeded = true;\n  }\n\n  // In a session the hub owns fullscreen: a game that asks for it gets the\n  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n  // hub says when its page goes in and out, so the game's own toggle and its\n  // fullscreenchange listeners work as they always did.\n  var fullscreenOn = false;\n  if (hub.active && root.Element && root.document) {\n    var asks = function (on) {\n      return function () {\n        post('fullscreen', { on: on });\n        return Promise.resolve();\n      };\n112:  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n201:    if (root.console) root.console.warn('[AIHub] ' + text);\n227:      warn('could not reach the hub: ' + e.message);\n283:    } else if (m.type === 'message') {\n284:      emit('message', [m.data, m.from]);\n285:    } else if (m.type === 'leave') {\n289:      emit('leave', [{ id: m.id, reason: m.reason }]);\n290:    } else if (m.type === 'time-up') {\n291:      emit('time-up', [{ graceMs: m.graceMs }]);\n324:    root.addEventListener('message', onMessage);\n385:      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n392:      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n407:  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n498:      return { error: String((e && e.message) || e) };\n503:  hub.fail = function (message) {\n505:    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n508:  root.AIHub = hub;\n525:// someone else got there first. A last snapshot, reliable, ends the round.\n526:// The host may be a server, a copy with no player of its own (AIHub.server):\n630:  message: '',\n657:  game.message = 'Star Arena — press any key or tap to play';\n666:let lastSnap = -Infinity;    // the newest snapshot taken, by its AIHub.time()\n670:  const info = await AIHub.connect({ mode: 'shared-world', seats: [2, 4] });\n673:  game.rng = AIHub.rng('stars');\n679:  game.message = 'Get ready…';\n680:  AIHub.ready();\n681:  AIHub.on('start', () => { game.phase = 'playing'; unlockAudio(); });\n682:  AIHub.on('message', (data, from) => {\n688:  AIHub.on('leave', ({ id }) => {\n693:  AIHub.on('time-up', () => { if (hub.isHost) finish(); });\n694:  AIHub.on('end', ({ reason, standings }) => {\n697:    game.message = reason === 'finished' ? 'Round over' : reason === 'sat-out' ? 'You sat this one out' : 'Round cancelled';\n716:  AIHub.send({ t: 'pick', id, n });\n720:/** Host: one snapshot for everyone: every player still here with its score, and the star. */\n721:function snapshot() {\n725:    at: Math.round(AIHub.time()),\n731:/** Not the host: take the scores, the star and the other players from the snapshot, never your own player. */\n742:  if (s.over) { game.phase = 'over'; game.message = 'Round over'; }\n745:/** Host: standings by score, ties together, best first. A last snapshot, reliable, ends every copy on the same scores. */\n748:  AIHub.send({ ...snapshot(), over: 1 });\n757:  AIHub.finish({ standings: standings.map((g) => g.ids), scores });\n759:  game.message = 'Round over';\n786:  if (game.phase === 'playing' && (!hub || AIHub.time() >= 0)) {\n791:      if (now > soloEnds) { game.phase = 'over'; game.message = `Time! ${me.score} stars — press to play again`; }\n805:      AIHub.send({ t: 'claim', n: claimed }, { to: hub.host });\n811:    if (hub.isHost) AIHub.send(snapshot(), { reliable: false });\n812:    else AIHub.send({ t: 'me', at: Math.round(AIHub.time()), x: Math.round(me.x), y: Math.round(me.y) }, { to: hub.host, reliable: false });\n846:  if (hub && game.phase === 'playing' && AIHub.time() < 0) {\n848:    ctx.fillText(String(Math.ceil(-AIHub.time() / 1000)), W / 2, H / 2 + 32);\n852:    ctx.fillText(game.message, W / 2, H / 2 - 70);\n12:  body { display: grid; grid-template-rows: auto 1fr; }\n23:  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n26:  .cell__state { margin-left: auto; color: var(--dim); }\n29:  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n37:  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n52:  <button id=\"timeup\" type=\"button\">Time up</button>\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n67:import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n72:const auto = params.get('auto') === '1';\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n170:  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n183:  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n192:    limitMs,\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n362:$('timeup').onclick = () => current?.coordinator.timeUp();\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n412:  window.__hubCheck = report;\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n544:if (auto) conformance();\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '94,105p' vendor/engine/API.md && sed -n '9520,9557p' vendor/engine/my-3d2dge.js && sed -n '9730,9815p' vendor/engine/my-3d2dge.js && sed -n '1,85p' vendor/engine/game/test.mjs && sed -n '5050,5078p' vendor/engine/my-3d2dge.js && sed -n '3020,3060p' vendor/engine/my-3d2dge.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '94,105p' vendor/engine/API.md && sed -n '9520,9557p' vendor/engine/my-3d2dge.js && sed -n '9730,9815p' vendor/engine/my-3d2dge.js && sed -n '1,85p' vendor/engine/game/test.mjs && sed -n '5050,5078p' vendor/engine/my-3d2dge.js && sed -n '3020,3060p' vendor/engine/my-3d2dge.js\"","aggregated_output":"- Adaptive size: `minW` / `minH` set the scale (the screen shows at least that many pixels), `maxW` / `maxH` cap the view (the rest is letterboxed). `portrait: { maxH: 1000 }` overrides them while the screen is taller than wide, so a phone held upright (9:16) is filled instead of showing a band across its middle. `game.screen.portrait` says which way it is.\n- `input`: `'DEFAULT'` (top-down action), `'PLATFORMER'`, `'SHMUP'`, `'THIRDPERSON'`, or your own `{ action: ['KeyQ', 'Pad0'] }`.\n- `views`: the views your game supports; `game.nextView()` cycles them (bind it to a key).\n- Start: `game.start({ update(dt), draw(r) })`, or with scenes (below).\n- Methods: `follow(obj, { z: 16, lead: 20 })` (camera tracks it automatically), `focus(x, y, z)` (or aim it yourself every update), `setView(id)`, `nextView()`, `freeze(s)` (hit-stop: `update` waits; `game.hitstop` is the time left), `shake(n)`, `after(s, fn)`, `every(s, fn)` (timers in game time, return `{ cancel() }`), `hook('input' | 'step' | 'enter', fn)` (your own each step, paused too for input; returns its removal), `mouseGround()`, `go(scene, data)`, `enableGPU({ map })`.\n- Fields: `W`, `H` (screen pixels), `time`, `real`, `timeScale` (0.25 = slow motion), `paused`, `input`, `audio`, `particles`, `lights`, `view`, `errors`, `cam`. `game.fail('my power', err)` reports an error in your code (logged, in `errors`, on the error panel) and plays on.\n- Camera zoom and turn: `game.setZoom(1.5)` (.5 .. 3; everything drawn by the engine re-rasterizes crisply, the HUD stays), `game.rotateView(45)` (ground views only), `game.resetCamera()` (to the scene's zoom), `game.zoom`, `game.yaw`, `game.note('ZOOM 2x')` (a short notice at the top of the screen; `game.shownNote` is the one showing). Custom painters can read `r.view.zoom` (undefined at 1x) to scale their own art.\n- The player's zoom: a scene's `camera: { zoom: [.75, 2], start: 1, tall: 1.5 }` lets the player zoom within `zoom` from `start` (wheel, `-` `=`, pinch, Settings; `false`: none; `AI_GUIDE.md`, Camera).\n- Tests and tools: `new E.Game({ headless: true })` (the default in Node: no screen, sound or DOM; `draw` is skipped, or with `draw: true` run on a stand-in, its errors in `game.errors`) or `{ loop: false }` runs only by `game.advance(seconds, { draw })` (exact fixed steps at once); `input.tap(action)` presses for one step, `input.hold(action, on)`; `game.debug = { snapshot() {...} }` is your game's handle (`tools/check.mjs` prints it); `game.stop()`, `start()`, `dispose()`.\n- Sessions: `?record=1`, then the pause menu's Save session; `node tools/replay.mjs session.json` replays it exactly, headless (`AI_GUIDE.md`, Sessions).\n- Camera: `cam.offset = [dx, dy]` sits the focus that many screen pixels from the centre (above a phone's touch buttons: `[0, -60]`); `cam.bounds = v => map.bounds(v)` keeps it inside the level (in side views a level shorter than the screen sits on the bottom edge; `cam.align = 'center'` to change); `cam.room = [160, 128]` moves screen by screen (Zelda, Metroid) and `cam.moving` is true while it slides; `cam.smooth` = lag in seconds (0: locked to the target); `cam.window = [48, 24]` a dead zone the focus moves in before the camera follows; `cam.snapY = true` follows a followed body's height only when it lands (side-scrollers); `cam.frame([p1, p2], { margin, zoom: [.5, 1] })` keeps them all in view, zooming out as they part (`frame(null)` stops); `cam.free = { keys, edge: 10, drag, speed: 300, bounds: [x0, y0, x1, y1] }` a free camera (strategy, sims): keys, a stick, the screen's edge or a drag pan it, a zoom goes toward the pointer or the pinch.\n\n  }\n  /** a message that slides in at the top for a few seconds */\n  toast(title, text = '', seconds = 4) {\n    if (!this.root) return this;\n    const e = this._els.toast; e.replaceChildren(this._el('b', '', title)); if (text) e.appendChild(this._el('p', 'esh-m', text));\n    e.classList.add('on'); this._toastEnd = this._game.real + seconds; return this;\n  }\n  /** a tutorial card (bottom left, dismissable) for some seconds; tutorial(null) takes it away */\n  tutorial(title, text = '', seconds = 15) {\n    if (!this.root) return this;\n    const e = this._els.tut; e.hidden = !title; this._tutEnd = title ? this._game.real + seconds : 0; if (!title) return this;\n    const x = this._el('button', 'esh-x', '×'); x.setAttribute('aria-label', 'Dismiss'); x.onclick = () => this.tutorial(null);\n    e.replaceChildren(this._el('div', 'esh-k', 'Tutorial'), this._el('b', '', title), this._el('p', 'esh-m', text), x); return this;\n  }\n  /**\n   * the HUD, from this step's state (call it every step; a piece left out is hidden, and only what changed is redrawn)\n   * - objective: { step: '01 / 04', title, text, at: { x, y, z }, from: hero } (the distance in meters, and above or below)\n   * - status, place, tip: status: 'UNSEEN' or { text, color }; place: 'The Old Harbour'; tip: 'text' or { title, text }\n   * - bars, counts: bars: [{ label, value, max, kind: 'bar' | 'pips', color }] (health, stamina, a meter); counts: [[label,\n   *   value]]\n   * - prompt: { key: 'E' (or act: 'interact': its key on the player's device), label, hint, progress: 0..1 }\n   * - keys, buttons: keys: [['WASD', 'Move'], ...] (hidden on touch screens); buttons: [[label, fn or action]] (top right:\n   *   pause and map where there is no Escape key)\n   * - minimap: { map, at (with facing), markers: [{ x, y, kind: 'dot' | 'diamond' | 'ring' | 'cross', color }], onClick(x, y)\n   *   (the world point clicked), fog (an E.Fog: unseen cells black, seen ones dim), camera: true (the ground the screen shows) }\n   */\n  hud(st = {}) {\n    if (!this.root) return this;\n    const s = st || {}, E3 = this._els, play = !this.screen;\n    this._piece('obj', play && s.objective, o => {\n      const d = o.at && o.from ? Math.round(Math.hypot(o.at.x - o.from.x, o.at.y - o.from.y) * (this._o.meters || .125)) : null, dz = o.at && o.from ? (o.at.z || 0) - (o.from.z || 0) : 0;\n      return [o.step && this._el('div', 'esh-k', o.step), this._el('b', '', o.title), o.text && this._el('p', 'esh-m', o.text),\n        d !== null && this._el('div', 'esh-dist', d + ' m' + (dz > 12 ? '  ·  ABOVE YOU' : dz < -12 ? '  ·  BELOW YOU' : ''))];\n    });\n    this._piece('vit', play && (s.status || s.bars || s.counts) && [s.status, s.bars, s.counts], ([sta, bars, cnt]) => {\n      const out = [];\n      if (sta) { const t = typeof sta === 'string' ? { text: sta } : sta, e = this._el('div', 'esh-st'); e.style.setProperty('--c', t.color || 'var(--accent)'); e.append(this._el('i'), t.text); out.push(e); }\n      for (const b of bars || []) {\n    const acts = (name === 'pause' ? [['Resume', () => this.hide()]] : []).concat(v(s.actions) || [], name === 'pause' && this._std && v(this._game.o.menu && this._game.o.menu.items) || []).filter(Boolean);\n    if (name === 'pause') this._pauseActs(acts);\n    if (name === 'settings' && this._std) acts.push(['Controls', () => this.show('controls')], ['Restore defaults', () => { for (const g of SHELL_GROUPS.concat('Game')) this._game.settings.reset(g); this.show('settings'); }]);\n    if (name === 'controls') acts.push(['Restore defaults', () => { this._ctlI().resetBindings(); this._game.settings.reset('Controller'); this._game.settings.reset('Touch'); this._status = 'Every control is back to its default.'; this.show('controls'); }]);\n    if (!acts.length && !title || name === 'settings' || name === 'controls') acts.push(['Back', () => this.back()]);\n    const btns = this._el('div', 'esh-btns'), lists = name === 'settings' || name === 'controls'; acts.forEach((a, i) => btns.appendChild(this._btn(a, i, !lists))); add(btns);\n    if (s.meta) { const g = this._el('div', 'esh-tags'); for (const t of v(s.meta)) g.appendChild(this._el('span', '', t)); add(g); }\n    add(s.footer && this._el('div', 'esh-m', v(s.footer)));\n    const keep = top.focus !== undefined ? top.focus : this._shown === top ? this._focusAt() : -1; this._shown = top;   // (redrawn in place: the focus stays where it was)\n    // the way out, always in sight: close at the top right (where the menu button was), back at the top left over another\n    // screen, and a sideways swipe goes back (a phone's edge swipe would leave the page)\n    const nav = [];\n    if (!title) nav.push(this._navBtn('x', 'Close', 'M6 6l12 12M18 6L6 18', () => this._close()));\n    if (this._stack.length > 1) nav.push(this._navBtn('bk', 'Back', 'M15 5l-7 7 7 7', () => this.back()));\n    this._swipe(sh, box, title);\n    this._els.scr.replaceChildren(sh, ...nav);\n    const all = this._focusables(), f = all[keep] || (name === 'settings' || name === 'controls' ? null : sh.querySelector('button.pri:not(:disabled)')) || all[0];\n    top.focus = undefined; if (f) { f.focus({ preventScroll: true }); if (f.scrollIntoView) f.scrollIntoView({ block: 'nearest' }); }\n  }\n  /** the standard pause screen's buttons after Resume and the game's own: Settings, Controls, Full screen, Help, Save\n   *  session (while the page is recorded: E.session), Quit */\n  _pauseActs(acts) {\n    const g = this._game, fs = g.fullscreen, M = g.o.menu || {}, quit = M.quit === false ? null : M.quit || 'title', help = this._o.screens && this._o.screens.help;\n    if (this._std && HOOKS.pause) HOOKS.pause(this, acts);\n    if (this._std || this._items().length) acts.push(['Settings', () => this.show('settings')]);\n    if (!this._std) { if (help) acts.push(['Help', () => this.show('help')]); return; }\n    acts.push(['Controls', () => this.show('controls')]);\n    if (g.o.fullscreen !== false && fs.supported && !fs.standalone) acts.push([fs.on ? 'Leave full screen' : 'Full screen', () => { fs.toggle(); }]);\n    if (help) acts.push(['Help', () => this.show('help')]);\n    // a recorded page (?record=1) saves its session from the menu: a phone has no console (the share sheet, or a download).\n    // Its replay has the button too (doing nothing): the recorded tap on it lands on it, not on the next one (Quit)\n    if (E.session && (E.session.recording || E.session.replaying)) acts.push(['Save session', () => { if (E.session.recording) E.session.share(); }]);\n    if (quit && g.scenes && g.scenes[quit] && g.sceneName !== quit) acts.push(['Quit to ' + (quit === 'title' ? 'title' : actionName(quit).toLowerCase()), () => this.show('confirm', { kicker: 'Quit', title: 'Leave this game?', text: 'Progress since the last save is lost.',\n      actions: [{ label: 'Keep playing', fn: () => this.back() }, { label: 'Quit', fn: () => { this.hide(); g.go(quit); } }] })]);\n  }\n  /** draw a TileMap from above: floor, roofs by height, water and grass, then markers and the body at (an arrow) */\n  _map(cv, s, large) {\n    const m = s.map, g = cv.getContext('2d'), W = cv.width, H = cv.height, T = m.T, ww = m.w * T, hh = m.h * T, pad = large ? 22 : 8;\n    const k = Math.min((W - pad * 2) / ww, (H - pad * 2) / hh), ox = (W - ww * k) / 2, oy = (H - hh * k) / 2, P = (x, y) => [ox + x * k, oy + y * k];\n    cv._xf = { k, ox, oy };\n    if (!m._shellBase || m._shellBase.v !== m.version || m._shellBase.w !== W) {   // the cells, cached until the map changes\n      const b = mkCanvas(W, H), bg = ctx2d(b); bg.fillStyle = '#121b1d'; bg.fillRect(0, 0, W, H);\n      let top = 1; for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) top = Math.max(top, m.height(cx, cy));\n      for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) {\n        const c = m.cell(cx, cy), tag = m.floorAt((cx + .5) * T, (cy + .5) * T);\n        bg.fillStyle = c > 0 ? mix('#4a5650', '#d2c296', m.height(cx, cy) / top) : tag === 'water' || tag === 'lava' ? (tag === 'water' ? '#1d3e56' : '#6a2a1a') : tag === 'grass' ? '#29452f' : '#1f2b2c';\n        bg.fillRect(Math.floor(ox + cx * T * k), Math.floor(oy + cy * T * k), Math.ceil(T * k), Math.ceil(T * k));\n      }\n      m._shellBase = { v: m.version, w: W, cv: b };\n    }\n    g.drawImage(m._shellBase.cv, 0, 0);\n    g.textAlign = 'center'; g.font = (large ? 12 : 7) + 'px ' + (this._o.theme && this._o.theme.font || 'sans-serif');\n    if (large) for (const [t, x, y] of s.labels || []) { g.fillStyle = '#cbbf9e'; g.fillText(t, ...P(x, y)); }\n    for (const q of (typeof s.markers === 'function' ? s.markers() : s.markers) || []) {\n      const [x, y] = P(q.x, q.y), r = (q.size || (large ? 6 : 3)); g.strokeStyle = g.fillStyle = q.color || '#ffe0a0'; g.lineWidth = large ? 2 : 1; g.beginPath();\n      if (q.kind === 'diamond') { g.moveTo(x, y - r); g.lineTo(x + r, y); g.lineTo(x, y + r); g.lineTo(x - r, y); g.closePath(); g.stroke(); }\n      else if (q.kind === 'cross') { g.moveTo(x - r, y); g.lineTo(x + r, y); g.moveTo(x, y - r); g.lineTo(x, y + r); g.stroke(); }\n      else if (q.kind === 'ring') { g.arc(x, y, r, 0, TAU); g.stroke(); }\n      else { g.arc(x, y, r * .7, 0, TAU); g.fill(); }\n      if (large && q.label) { g.fillStyle = '#ebd3a0'; g.fillText(q.label, x, y + r + 13); }\n    }\n    const F = s.fog;   // fog of war: what was never seen is black, what isn't in sight now dimmed\n    if (F) for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) { const c = [cx, cy]; if (F.visible(c)) continue; g.fillStyle = F.seen(c) ? 'rgba(6,8,10,.5)' : '#06080a'; g.fillRect(Math.floor(ox + cx * T * k), Math.floor(oy + cy * T * k), Math.ceil(T * k), Math.ceil(T * k)); }\n    if (s.camera) {   // the screen's corners on the ground: what the camera shows\n      const G = this._game, v = G.view, c = G.cam, S = G.screen, q = [[0, 0], [S.W, 0], [S.W, S.H], [0, S.H]].map(([a, b]) => v.toGround(c.x + a, c.y + b));\n      if (q.every(Boolean)) { g.strokeStyle = '#f8efd0'; g.lineWidth = 1; g.beginPath(); q.forEach(([a, b], i) => i ? g.lineTo(...P(a, b)) : g.moveTo(...P(a, b))); g.closePath(); g.stroke(); }\n    }\n    if (s.at) {\n      const [x, y] = P(s.at.x, s.at.y), a = s.at.facing || 0, r = large ? 9 : 5; g.fillStyle = '#f8efd0'; g.strokeStyle = '#10181a'; g.lineWidth = 1.5; g.beginPath();\n      g.moveTo(x + Math.cos(a) * r, y + Math.sin(a) * r); g.lineTo(x + Math.cos(a + 2.45) * r * .8, y + Math.sin(a + 2.45) * r * .8); g.lineTo(x + Math.cos(a - 2.45) * r * .8, y + Math.sin(a - 2.45) * r * .8); g.closePath(); g.fill(); g.stroke();\n    }\n    g.fillStyle = '#b6c5b5'; g.textAlign = 'right'; g.fillText('N', W - (large ? 12 : 5), large ? 18 : 10);\n  }\n  /** each step (the game calls it after reading input): follow game.paused, time out the toast and the card, and while a\n   *  screen is open, move the focus with the game's input and hold the rest of it back from the game */\n  _step() {\n    const g = this._game, I = g.input, now = g.real, sc = g.scene, play = !!sc && (!!sc.pausable || g.sceneName === 'main');\n    const pause = this._pauseSpec() && (!this._sys || (g.pauseOverlay !== false && play));   // (the engine's own menu stays out of a game that draws its own pause)\n    if (pause && g.paused && !this._stack.length) this.show('pause');\n    if (!g.paused && this._stack.length && (this._ownPause || (pause && this._stack.some(t => t.name === 'pause')))) { this._stack.length = 0; this._ownPause = false; this._capEnd(); this._render(); }   // resumed from code\n    if (this.root) {\n      if (this._toastEnd && now > this._toastEnd) { this._els.toast.classList.remove('on'); this._toastEnd = 0; }\n      if (this._tutEnd && now > this._tutEnd) this.tutorial(null);\n      this.root.classList.toggle('esh-still', !!g.reduceMotion);\n    }\n    if (!this._stack.length) return;\n// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n  /** a squash kick: + stretches (a hop), - squashes (a landing, a hit) */\n  kick(v) { this.sqV += v; }\n  /** s: {squash target -0.4..0.4, look:[dx,dy] ground dir, squint} */\n  update(dt, s = {}) {\n    this.t += dt;\n    const target = s.squash || 0;\n    this.sqV += (-(this.sq - target) * 320 - 14 * this.sqV) * dt; this.sq = clamp(this.sq + this.sqV * dt, -.45, .45);\n    if (s.look) { const l = Math.hypot(s.look[0], s.look[1]); if (l > .01) { this.look[0] = lerp(this.look[0], s.look[0] / l, Math.min(1, dt * 8)); this.look[1] = lerp(this.look[1], s.look[1] / l, Math.min(1, dt * 8)); } }\n    /** walk: 0..1, how fast it is walking (its feet patter) */\n    this.squint = !!s.squint; this.walk = s.walk || 0;\n    /** flap: the wings' speed now, 0 (folded) .. 1; flapP: the wing beat's phase; hang: roosting upside down */\n    this.flap = approach(this.flap === undefined ? 1 : this.flap, s.flap === undefined ? 1 : s.flap, dt * 6); this.flapP = (this.flapP || 0) + dt * 14 * this.flap; this.hang = !!s.hang;   // wings: flap speed 0..1 (0 folds them); hang: roost upside down\n  }\n  /**\n   * draw(g, ox, oy, view). Creature features from the constructor options:\n   *   ears: 'rabbit' | 'cat', horns: true, wings: true (flapping bat wings), feet: true, tail: true,\n   *   mouth: true | 'fangs', face: 'front' (eyes always on the camera side, for Mana-style monsters)\n   * update(dt, { flap: 0..1, hang: true }) slows or folds the wings and hangs a bat upside down from its anchor.\n   */\n  draw(g, ox, oy, view) {\n    if (!this.hang) return this._drawBody(g, ox, oy, view);\n    const pv = Math.round(oy - this.o.R * this.scale * view.scale);   // flip around the body's middle\n    g.save(); g.translate(0, pv * 2); g.scale(1, -1);\n    try { this._drawBody(g, ox, oy, view); } finally { g.restore(); }\n  }\n  _drawBody(g, ox, oy, view) {\n    if (this.o.charView !== false) view = charView(view);\n    const o = this.o, R = o.R * this.scale, a = 1 - this.sq * .55, b = 1 + this.sq, C = this.C, sc = view.scale, t = this.t;\n    const sp = Math.sin(view.pitch), cp = Math.cos(view.pitch) * view.zBoost;\n * 10b. STANDARD FEATURES  what every game gets without writing it, so a game's code goes to the game:\n *    - game.settings: the player's choices (display, sound, comfort, controls), saved per game (a version, every value\n *      checked when it loads, a bad one falls back to its default), applied at once. A game adds its own with\n *      new E.Game({ menu: { settings: [{ key: 'hints', label: 'Hints', value: true }] } }) and reads game.settings.hints;\n *      one with a standard key and no label changes that setting, its other fields kept: { key: 'glyphs', value:\n *      'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] } shows PlayStation symbols unless the\n *      player picks Xbox (game.settings.set('glyphs', 'xbox') switches); one with a label of its own is the game's, in the\n *      standard one's place (a map's 'zoom'). The controller's settings reach every player, and one who joins later.\n *    - game.fullscreen: the page full screen from a tap, click or key. A phone's first tap takes it there, and a game\n *      started by a tap does again; turning it off (the corner's button, the menu) is the player's choice, kept.\n *    - the back gesture: a phone's back steps back in the game (game.back(): a menu screen closes, play pauses) before it\n *      leaves the page.\n *    - pausing: a pausable scene pauses when the page is hidden or loses focus, or the controller in use is unplugged,\n *      and waits for the player (game.pause(reason), game.resume(), game.pauseReason).\n *    - the corner: a menu button and a full-screen button at the top right, inside the safe area; on a touch screen the\n *      menu stays there in play (it is the touch START), and over a menu screen a close button takes its place.\n *    - the page set up for phones: a viewport that reaches the safe areas, and no scrolling, zooming, text selection or\n *      callouts on the game's canvas (menus keep theirs).\n *    E.Shell draws the menu's screens (pause, settings, controls): section 21d.\n * ============================================================================= */\nconst ZOOM_PLAYER = [.5, 2];   // the player's zoom (settings.zoom): half to twice the game's, within each scene's range\nconst SETTINGS_VERSION = 2;   // 2: fullscreen false means turned off (version 1's also meant left by a gesture: forgotten)\n/** the standard settings by key: { group, label, type: 'toggle' | 'slider' | 'select', value (the default, or a\n *  function of the game), min, max, step, options: [[value, label]], help, apply(game, value) }. Groups: Display,\n *  Sound, Comfort (the settings screen), Controller, Touch (the controls screen) */\nconst STANDARD_SETTINGS = {\n  fullscreen: { group: 'Display', label: 'Full screen', type: 'fullscreen', value: null },   // the player's choice: true, false (turned it off), null (never chose)\n  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: the mouse wheel, - and =, or a pinch', apply: g => g._zoomApply(false, true) },\n  frameRate: { group: 'Display', label: 'Frame rate', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['60', '60'], ['full', 'Full']], help: 'Auto: every refresh while the game keeps up, every other one, evenly, when it can\\'t. 60: every other refresh on a 120 Hz screen. Full: every refresh' },\n  showFps: { group: 'Display', label: 'Show frame rate', type: 'toggle', value: false, help: 'At the top of the screen: frames drawn a second, the screen\\'s refresh and a frame\\'s cost' },\n  scale: { group: 'Display', label: 'Pixel scaling', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['sharp', 'Sharp'], ['fill', 'Fill']], help: 'Sharp: every pixel the same size. Fill: the whole screen', apply: (g, v) => g.screen.setScale(v) },\n  filter: { group: 'Display', label: 'Screen filter', type: 'select', value: 'clean', options: [['clean', 'Clean'], ['scanlines', 'Scanlines'], ['crt', 'CRT']], help: 'Scanlines: the dark lines between a TV\\'s rows. CRT: those, its colored stripes and its darker corners', apply: (g, v) => { g.screen.filter = v; } },\n  sound: { group: 'Sound', label: 'Sound', type: 'toggle', value: true, apply: (g, v) => g.audio.mute(!v) },\n  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\n  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n  background: { group: 'Sound', label: 'Sound in the background', type: 'toggle', value: false, help: 'Keep playing sound while the page is hidden' },\n  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\n  motion: { group: 'Comfort', label: 'Reduce motion', type: 'toggle', value: g => !!g.reduceMotion, help: 'No screen shake, shorter flashes, still menus', apply: (g, v) => { g.reduceMotion = !!v; } },\n  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > src/content.js <<'JS'\n/* Original content for Turtley Booked. Tile scale and graph derive from my-3D2dge. */\n(function (T) {\n  'use strict';\n  T.IDENTITY = { title: 'Turtley Booked', tagline: 'Small shells. Big room service.', id: 'Turtley-Booked-Turtles-gpt-6.1-sol-max-20261106-033015' };\n  T.DEFAULTS = Object.freeze({ playerSpeed: 3.5, carrySpeed: .9, enemySpeed: 1, yellowAt: 18, redAt: 42, stun: 3, bombLife: 6, recharge: 6 });\n  T.SLIDERS = [\n    ['playerSpeed','Turtle speed',2,5,.1], ['carrySpeed','Carrying speed',.7,1,.05],\n    ['enemySpeed','Beetle speed',.5,1.3,.05], ['yellowAt','Yellow age',6,36,1],\n    ['redAt','Red age',15,65,1], ['stun','Stun seconds',1,7,.25],\n    ['bombLife','Bomb seconds',2,10,.5], ['recharge','Supply seconds',2,12,.5]\n  ];\n  const layouts = [\n    [\n      '#####################',\n      '#...................#',\n      '#.###.###.#.###.###.#',\n      '#...................#',\n      '#.###.#.#####.#.###.#',\n      '#.....#.......#.....#',\n      '#...................#',\n      '#.....#.......#.....#',\n      '#.###.#.#####.#.###.#',\n      '#...................#',\n      '#.###.###.#.###.###.#',\n      '#...................#',\n      '#####################'\n    ],\n    [\n      '#####################',\n      '#...................#',\n      '#.###.###.#.###.###.#',\n      '#.....#.......#.....#',\n      '#.###.#.###.#.#.###.#',\n      '#...#.....#.....#...#',\n      '#.#...............#.#',\n      '#...#.....#.....#...#',\n      '#.###.#.#.###.#.###.#',\n      '#.....#.......#.....#',\n      '#.###.###.#.###.###.#',\n      '#...................#',\n      '#####################'\n    ],\n    [\n      '#####################',\n      '#...................#',\n      '#.###.#.#####.#.###.#',\n      '#.....#.......#.....#',\n      '#.#.#.#.###.#.#.###.#',\n      '#.#.......#...#.....#',\n      '#...................#',\n      '#.....#...#.......#.#',\n      '#.###.#.#.###.#.#.#.#',\n      '#.....#.......#.....#',\n      '#.###.#.#####.#.###.#',\n      '#...................#',\n      '#####################'\n    ],\n    [\n      '#####################',\n      '#...................#',\n      '#.###.###.#.###.###.#',\n      '#...#...........#...#',\n      '#.#.#.###.#.###.#.#.#',\n      '#.#.....#...#.....#.#',\n      '#...................#',\n      '#.#.....#...#.....#.#',\n      '#.#.#.###.#.###.#.#.#',\n      '#...#...........#...#',\n      '#.###.###.#.###.###.#',\n      '#...................#',\n      '#####################'\n    ],\n    [\n      '#####################',\n      '#...................#',\n      '#.###.#.#####.#.###.#',\n      '#.....#.......#.....#',\n      '#.###.#.#.#.#.#.###.#',\n      '#...#...#...#...#...#',\n      '#...................#',\n      '#...#...#...#...#...#',\n      '#.###.#.#.#.#.#.###.#',\n      '#.....#.......#.....#',\n      '#.###.#.#####.#.###.#',\n      '#...................#',\n      '#####################'\n    ]\n  ];\n  const names = ['The Welcome Lobby','Laundry Lanes','The Glasshouse','The Velvet Suites','Rooftop Rendezvous'];\n  const subtitles = [\n    'A tiny guest is waiting. Follow the question marks.',\n    'Yellow beetles see along halls. Break their sight.',\n    'Red beetles turn corners. Leave a little surprise.',\n    'One bomb for the team. Two shells, twice the heart.',\n    'Last call for little lodgers. Everyone leaves together\"'!'\"'\n  ];\n  const palettes = [\n    ['#263f44','#435c60','#91a69b','#162c34','#23404a','#edbd73'],\n    ['#263e56','#42637d','#7dabae','#182c45','#213f56','#a6dfde'],\n    ['#25443d','#416249','#a3b375','#172e2a','#294b3b','#e1c879'],\n    ['#433347','#6e5064','#c29e94','#2c2139','#44304b','#e8b6b6'],\n    ['#324b54','#577278','#d0b882','#172c3e','#2a4555','#ffe3a2']\n  ];\n  const roomCells = [\n    [[7,9],[3,3],[17,3],[17,9]],\n    [[3,9],[7,5],[17,3],[13,9],[3,3],[17,9]],\n    [[3,9],[7,3],[17,3],[13,9],[3,3],[17,9],[11,1]],\n    [[7,9],[3,3],[17,3],[13,9],[7,3],[17,9],[3,9],[11,1]],\n    [[3,9],[7,3],[17,3],[13,9],[3,3],[17,9],[11,1],[9,5]]\n  ];\n  const starts = [[[10,1]],[[5,1],[15,1]],[[5,1],[15,1],[1,6]],[[5,1],[15,1],[19,6]],[[5,1],[15,1],[1,6],[19,6]]];\n  T.FLOORS = layouts.map((rows,i) => ({\n    id:i, name:names[i], subtitle:subtitles[i], rows, quota:[4,5,5,6,6][i],\n    rooms:roomCells[i], homes:[[1,1],[19,1],[1,11],[19,11]], spawns:[[9,11],[11,11]], supply:[10,6],\n    enemies:starts[i].map((cell,j)=>({cell,age:i===2&&j===1?38:i>=3&&j===1?20:0})),\n    wall:palettes[i][0], side:palettes[i][1], trim:palettes[i][2], floor:palettes[i][3], carpet:palettes[i][4], accent:palettes[i][5],\n    staging:['Brass bell & luggage','Spinning laundry','Moonlit palms','Velvet & gold','Lanterns & a rescue airship'][i],\n    wallFace:i===2||i===4?'hedge':i===3?'plank':'plaster',\n    props:[[3,2,'pot'],[17,2,'pot'],[3,10,'jar'],[17,10,'jar']]\n  }));\n  T.DIRS = [[0,-1],[-1,0],[0,1],[1,0]];\n  T.cell = a => [Math.round(a.m.x),Math.round(a.m.y)];\n  T.same = (a,b) => a[0]===b[0]&&a[1]===b[1];\n  T.dist = (a,b) => Math.abs(a[0]-b[0])+Math.abs(a[1]-b[1]);\n  T.world = m => ({x:(m.x+.5)*16,y:(m.y+.5)*16,z:0});\n  T.makeMap = f => new My3D2dge.TileMap({rows:f.rows,legend:{'#':1},types:{1:{h:5,top:f.wall,side:f.side,line:f.trim,face:f.wallFace,roof:'slab'}},outside:false,ao:2,\n    floorTex:(x,y)=> {\n      const c = ((Math.floor(x/16)+Math.floor(y/16))&1)?f.floor:f.carpet;\n      const v=My3D2dge.hex(c), n=((x*13+y*7)%17===0)?4:0;\n      return v.map(a=>a+n);\n    }});\n  T.validate = function(f) {\n    const errors=[], E=My3D2dge;\n    if(f.rows.length\"'!==13||f.rows.some(r=>r.length!==21)) errors.push('\"'Grid must be 21 by 13');\n    const map=T.makeMap(f),grid=E.Grid.from(map), cells=[];\n    for(let y=0;y<13;y++)for(let x=0;x<21;x++)if(map.walkable(x,y))cells.push([x,y]);\n    for(const p of cells)if(\"'!grid.path(cells[0],p).length) {errors.push('\"'Disconnected corridor '+p);break;}\n    if(f.quota>f.rooms.length||f.quota<1)errors.push('Impossible rescue quota');\n    const tagged=[...f.rooms,...f.homes,...f.spawns,f.supply,...f.enemies.map(e=>e.cell)];\n    if(new Set(tagged.map(c=>c.join(','))).size\"'!==tagged.length)errors.push('\"'Spawn/objective conflict');\n    for(const p of tagged)if(\"'!map.walkable(...p))errors.push('\"'Invalid cell '+p);\n    for(const p of f.rooms)if(f.homes.filter(h=>grid.path(p,h).length).length<2)errors.push('Fewer than two reachable homes');\n    if(f.homes.some(([x,y])=>x\"'!==1&&x!==19&&y!==1&&y!==11))errors.push('\"'Home is not at edge');\n    return errors;\n  };\n})(globalThis.TB = globalThis.TB || {});\nJS\ncat > package.json <<'JSON'\n{\\\"name\\\":\\\"turtley-booked\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"private\\\":true,\\\"scripts\\\":{\\\"build\\\":\\\"node tools/build.mjs\\\",\\\"verify\\\":\\\"node tools/verify.mjs\\\"}}\nJSON\ncat > docs/research.md <<'MD'\n# Source research, 2026-11-06\n\nPrimary interpretation: **Turtles, 1983 US Odyssey² hotel-rescue release**, not uniquely identified by the year (other 1983 ports exist). The arcade ancestor is Konami's 1981 Turtles. No connection to Teenage Mutant Ninja Turtles.\n\n- [US manual](https://odyssey2.info/library/manuals/us_turtles/Turtles%20(USA).pdf): read all gameplay text and inspected rendered illustrations on pages 4, 5 and 7. Archived PDF and page images are in this directory. Question marks hide babies or beetles; a passenger rides the shell to an edge house. Blue beetles wander, yellow sees straight halls, red tracks around corners. One active bomb; flashing central refill. The manual contradicts itself about lives. This game's clear original rule is three team lives, with the third damaging hit ending the run.\n- [Release entry](https://odyssey2.info/db/game/turtles-47): US platform/year, hotel intermissions, genuine attract sequence and Voice music. Inspected its documented gameplay screenshot directly: \"'`https://odyssey2.info/i/screens/turt-scr2.gif` (archived as source-gameplay.gif/png). Broad green corridors, thin bright walls, oversized cyan punctuation and a compact bottom HUD. Source screenshots are research only and are not embedded in the game.\n- [Historical review](https://odyssey2.info/reviews/turtles-117): secondary evidence for ascending hotel floors, four recurring maze layouts, and short staccato vocal tunes. Ten historical floors are reference rather than our quota.\n\nMechanics, progression, enemy states, visual language and sound were considered separately. No gameplay recording was watched; no original audio was heard. Sound descriptions above are written evidence, not listening claims. The game uses an original synthesized tune, original gibberish and five authored floors with 26 rescues; score, timings, stock caps, cooperative rules, art and layouts are original.\n\nEngine v0.89.1 at `8ecc2f62353761187bdfe226f327b7ea5d2eb691`; Hub protocol 1/client 1.4.0 at `35a1047f2067b2af3de3943f0fe452f39105d869`. Downloaded pinned handoff and Hub files. Read engine README/API, assets card, maze slice, input/settings, Blob continuous rig, audio synthesis, headless example, Hub README/shared-world arena example and harness. No engine version change from planning.\nMD\nnode --input-type=module <<'\"'JS'\nimport vm from 'node:vm';import fs from 'node:fs';const c=vm.createContext({console});for(const f of ['vendor/engine/my-3d2dge.js','src/content.js'])vm.runInContext(fs.readFileSync(f,'utf8'),c);for(const f of c.TB.FLOORS) console.log(f.id,c.TB.validate(f));\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > src/content.js <<'JS'\n/* Original content for Turtley Booked. Tile scale and graph derive from my-3D2dge. */\n(function (T) {\n  'use strict';\n  T.IDENTITY = { title: 'Turtley Booked', tagline: 'Small shells. Big room service.', id: 'Turtley-Booked-Turtles-gpt-6.1-sol-max-20261106-033015' };\n  T.DEFAULTS = Object.freeze({ playerSpeed: 3.5, carrySpeed: .9, enemySpeed: 1, yellowAt: 18, redAt: 42, stun: 3, bombLife: 6, recharge: 6 });\n  T.SLIDERS = [\n    ['playerSpeed','Turtle speed',2,5,.1], ['carrySpeed','Carrying speed',.7,1,.05],\n    ['enemySpeed','Beetle speed',.5,1.3,.05], ['yellowAt','Yellow age',6,36,1],\n    ['redAt','Red age',15,65,1], ['stun','Stun seconds',1,7,.25],\n    ['bombLife','Bomb seconds',2,10,.5], ['recharge','Supply seconds',2,12,.5]\n  ];\n  const layouts = [\n    [\n      '#####################',\n      '#...................#',\n      '#.###.###.#.###.###.#',\n      '#...................#',\n      '#.###.#.#####.#.###.#',\n      '#.....#.......#.....#',\n      '#...................#',\n      '#.....#.......#.....#',\n      '#.###.#.#####.#.###.#',\n      '#...................#',\n      '#.###.###.#.###.###.#',\n      '#...................#',\n      '#####################'\n    ],\n    [\n      '#####################',\n      '#...................#',\n      '#.###.###.#.###.###.#',\n      '#.....#.......#.....#',\n      '#.###.#.###.#.#.###.#',\n      '#...#.....#.....#...#',\n      '#.#...............#.#',\n      '#...#.....#.....#...#',\n      '#.###.#.#.###.#.###.#',\n      '#.....#.......#.....#',\n      '#.###.###.#.###.###.#',\n      '#...................#',\n      '#####################'\n    ],\n    [\n      '#####################',\n      '#...................#',\n      '#.###.#.#####.#.###.#',\n      '#.....#.......#.....#',\n      '#.#.#.#.###.#.#.###.#',\n      '#.#.......#...#.....#',\n      '#...................#',\n      '#.....#...#.......#.#',\n      '#.###.#.#.###.#.#.#.#',\n      '#.....#.......#.....#',\n      '#.###.#.#####.#.###.#',\n      '#...................#',\n      '#####################'\n    ],\n    [\n      '#####################',\n      '#...................#',\n      '#.###.###.#.###.###.#',\n      '#...#...........#...#',\n      '#.#.#.###.#.###.#.#.#',\n      '#.#.....#...#.....#.#',\n      '#...................#',\n      '#.#.....#...#.....#.#',\n      '#.#.#.###.#.###.#.#.#',\n      '#...#...........#...#',\n      '#.###.###.#.###.###.#',\n      '#...................#',\n      '#####################'\n    ],\n    [\n      '#####################',\n      '#...................#',\n      '#.###.#.#####.#.###.#',\n      '#.....#.......#.....#',\n      '#.###.#.#.#.#.#.###.#',\n      '#...#...#...#...#...#',\n      '#...................#',\n      '#...#...#...#...#...#',\n      '#.###.#.#.#.#.#.###.#',\n      '#.....#.......#.....#',\n      '#.###.#.#####.#.###.#',\n      '#...................#',\n      '#####################'\n    ]\n  ];\n  const names = ['The Welcome Lobby','Laundry Lanes','The Glasshouse','The Velvet Suites','Rooftop Rendezvous'];\n  const subtitles = [\n    'A tiny guest is waiting. Follow the question marks.',\n    'Yellow beetles see along halls. Break their sight.',\n    'Red beetles turn corners. Leave a little surprise.',\n    'One bomb for the team. Two shells, twice the heart.',\n    'Last call for little lodgers. Everyone leaves together\"'!'\"'\n  ];\n  const palettes = [\n    ['#263f44','#435c60','#91a69b','#162c34','#23404a','#edbd73'],\n    ['#263e56','#42637d','#7dabae','#182c45','#213f56','#a6dfde'],\n    ['#25443d','#416249','#a3b375','#172e2a','#294b3b','#e1c879'],\n    ['#433347','#6e5064','#c29e94','#2c2139','#44304b','#e8b6b6'],\n    ['#324b54','#577278','#d0b882','#172c3e','#2a4555','#ffe3a2']\n  ];\n  const roomCells = [\n    [[7,9],[3,3],[17,3],[17,9]],\n    [[3,9],[7,5],[17,3],[13,9],[3,3],[17,9]],\n    [[3,9],[7,3],[17,3],[13,9],[3,3],[17,9],[11,1]],\n    [[7,9],[3,3],[17,3],[13,9],[7,3],[17,9],[3,9],[11,1]],\n    [[3,9],[7,3],[17,3],[13,9],[3,3],[17,9],[11,1],[9,5]]\n  ];\n  const starts = [[[10,1]],[[5,1],[15,1]],[[5,1],[15,1],[1,6]],[[5,1],[15,1],[19,6]],[[5,1],[15,1],[1,6],[19,6]]];\n  T.FLOORS = layouts.map((rows,i) => ({\n    id:i, name:names[i], subtitle:subtitles[i], rows, quota:[4,5,5,6,6][i],\n    rooms:roomCells[i], homes:[[1,1],[19,1],[1,11],[19,11]], spawns:[[9,11],[11,11]], supply:[10,6],\n    enemies:starts[i].map((cell,j)=>({cell,age:i===2&&j===1?38:i>=3&&j===1?20:0})),\n    wall:palettes[i][0], side:palettes[i][1], trim:palettes[i][2], floor:palettes[i][3], carpet:palettes[i][4], accent:palettes[i][5],\n    staging:['Brass bell & luggage','Spinning laundry','Moonlit palms','Velvet & gold','Lanterns & a rescue airship'][i],\n    wallFace:i===2||i===4?'hedge':i===3?'plank':'plaster',\n    props:[[3,2,'pot'],[17,2,'pot'],[3,10,'jar'],[17,10,'jar']]\n  }));\n  T.DIRS = [[0,-1],[-1,0],[0,1],[1,0]];\n  T.cell = a => [Math.round(a.m.x),Math.round(a.m.y)];\n  T.same = (a,b) => a[0]===b[0]&&a[1]===b[1];\n  T.dist = (a,b) => Math.abs(a[0]-b[0])+Math.abs(a[1]-b[1]);\n  T.world = m => ({x:(m.x+.5)*16,y:(m.y+.5)*16,z:0});\n  T.makeMap = f => new My3D2dge.TileMap({rows:f.rows,legend:{'#':1},types:{1:{h:5,top:f.wall,side:f.side,line:f.trim,face:f.wallFace,roof:'slab'}},outside:false,ao:2,\n    floorTex:(x,y)=> {\n      const c = ((Math.floor(x/16)+Math.floor(y/16))&1)?f.floor:f.carpet;\n      const v=My3D2dge.hex(c), n=((x*13+y*7)%17===0)?4:0;\n      return v.map(a=>a+n);\n    }});\n  T.validate = function(f) {\n    const errors=[], E=My3D2dge;\n    if(f.rows.length\"'!==13||f.rows.some(r=>r.length!==21)) errors.push('\"'Grid must be 21 by 13');\n    const map=T.makeMap(f),grid=E.Grid.from(map), cells=[];\n    for(let y=0;y<13;y++)for(let x=0;x<21;x++)if(map.walkable(x,y))cells.push([x,y]);\n    for(const p of cells)if(\"'!grid.path(cells[0],p).length) {errors.push('\"'Disconnected corridor '+p);break;}\n    if(f.quota>f.rooms.length||f.quota<1)errors.push('Impossible rescue quota');\n    const tagged=[...f.rooms,...f.homes,...f.spawns,f.supply,...f.enemies.map(e=>e.cell)];\n    if(new Set(tagged.map(c=>c.join(','))).size\"'!==tagged.length)errors.push('\"'Spawn/objective conflict');\n    for(const p of tagged)if(\"'!map.walkable(...p))errors.push('\"'Invalid cell '+p);\n    for(const p of f.rooms)if(f.homes.filter(h=>grid.path(p,h).length).length<2)errors.push('Fewer than two reachable homes');\n    if(f.homes.some(([x,y])=>x\"'!==1&&x!==19&&y!==1&&y!==11))errors.push('\"'Home is not at edge');\n    return errors;\n  };\n})(globalThis.TB = globalThis.TB || {});\nJS\ncat > package.json <<'JSON'\n{\\\"name\\\":\\\"turtley-booked\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"private\\\":true,\\\"scripts\\\":{\\\"build\\\":\\\"node tools/build.mjs\\\",\\\"verify\\\":\\\"node tools/verify.mjs\\\"}}\nJSON\ncat > docs/research.md <<'MD'\n# Source research, 2026-11-06\n\nPrimary interpretation: **Turtles, 1983 US Odyssey² hotel-rescue release**, not uniquely identified by the year (other 1983 ports exist). The arcade ancestor is Konami's 1981 Turtles. No connection to Teenage Mutant Ninja Turtles.\n\n- [US manual](https://odyssey2.info/library/manuals/us_turtles/Turtles%20(USA).pdf): read all gameplay text and inspected rendered illustrations on pages 4, 5 and 7. Archived PDF and page images are in this directory. Question marks hide babies or beetles; a passenger rides the shell to an edge house. Blue beetles wander, yellow sees straight halls, red tracks around corners. One active bomb; flashing central refill. The manual contradicts itself about lives. This game's clear original rule is three team lives, with the third damaging hit ending the run.\n- [Release entry](https://odyssey2.info/db/game/turtles-47): US platform/year, hotel intermissions, genuine attract sequence and Voice music. Inspected its documented gameplay screenshot directly: \"'`https://odyssey2.info/i/screens/turt-scr2.gif` (archived as source-gameplay.gif/png). Broad green corridors, thin bright walls, oversized cyan punctuation and a compact bottom HUD. Source screenshots are research only and are not embedded in the game.\n- [Historical review](https://odyssey2.info/reviews/turtles-117): secondary evidence for ascending hotel floors, four recurring maze layouts, and short staccato vocal tunes. Ten historical floors are reference rather than our quota.\n\nMechanics, progression, enemy states, visual language and sound were considered separately. No gameplay recording was watched; no original audio was heard. Sound descriptions above are written evidence, not listening claims. The game uses an original synthesized tune, original gibberish and five authored floors with 26 rescues; score, timings, stock caps, cooperative rules, art and layouts are original.\n\nEngine v0.89.1 at `8ecc2f62353761187bdfe226f327b7ea5d2eb691`; Hub protocol 1/client 1.4.0 at `35a1047f2067b2af3de3943f0fe452f39105d869`. Downloaded pinned handoff and Hub files. Read engine README/API, assets card, maze slice, input/settings, Blob continuous rig, audio synthesis, headless example, Hub README/shared-world arena example and harness. No engine version change from planning.\nMD\nnode --input-type=module <<'\"'JS'\nimport vm from 'node:vm';import fs from 'node:fs';const c=vm.createContext({console});for(const f of ['vendor/engine/my-3d2dge.js','src/content.js'])vm.runInContext(fs.readFileSync(f,'utf8'),c);for(const f of c.TB.FLOORS) console.log(f.id,c.TB.validate(f));\nJS\"","aggregated_output":"0 []\n1 []\n2 []\n3 []\n4 []\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"agent_message","text":"The five floor layouts pass the connectivity and objective checks. I’m now building the rescue rules around the engine’s grid movement so solo, local co-op, bots, and Hub play can all use the same simulation.\n"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > src/sim.js <<'JS'\n(function(T){\n  'use strict';\n  const E=My3D2dge;\n  function hash(s){let h=2166136261;for(const c of String(s))h=Math.imul(h\"'^c.charCodeAt(0),16777619);return h>>>0;}\n  class Stream {\n    constructor(seed,label){this.state=hash(seed+'\"':'+label)||1;}\n    next(){let a=this.state=(this.state+0x6d2b79f5)>>>0;let t=Math.imul(a\"'^(a>>>15),a|1);t''^=t+Math.imul(t''^(t>>>7),t|61);return ((t''^(t>>>14))>>>0)/4294967296;}\n  }\n  T.Stream=Stream;\n  T.swept=function(a,b){\n    const x=a.prev[0]-b.prev[0],y=a.prev[1]-b.prev[1];\n    const dx=(a.m.x-b.m.x)-x,dy=(a.m.y-b.m.y)-y;\n    const u=Math.max(0,Math.min(1,-(x*dx+y*dy)/(dx*dx+dy*dy||1)));\n    return Math.hypot(x+dx*u,y+dy*u);\n  };\n  T.move=function(a,dt,grid,want,speed){\n    const m=a.m;a.prev=[m.x,m.y];m.speed=speed;\n    // Extend the native mover with an immediate mid-edge reversal; the graph stays authoritative.\n    if(want&&m.moving&&want[0]===-m.dir[0]&&want[1]===-m.dir[1]){\n      const old=[m.cx,m.cy];[m.cx,m.cy]=m._to;m._to=old;m._u=1-m._u;m.dir=want.slice();m._want=want.slice();\n    }\n    if(want){a.buffer=want.slice();a.bufferTime=.24;}else a.bufferTime=Math.max(0,(a.bufferTime||0)-dt);\n    if(!want&&a.bufferTime<=0)m._want=null;\n    const request=want||a.bufferTime>0&&a.buffer||null;\n    m.update(dt,grid,request,{keep:!!want});\n    a.walk=Math.hypot(m.x-a.prev[0],m.y-a.prev[1])/Math.max(dt,.0001);\n    if(a.walk>.01)a.facing=Math.atan2(m.dir[1],m.dir[0]);\n  };\n  const body=(id,cell,speed)=>({id,m:new E.GridMover({cx:cell[0],cy:cell[1],speed}),prev:cell.slice(),facing:-Math.PI/2,walk:0,bufferTime:0});\n  class Run {\n    constructor(o={}){\n      this.seed=o.seed??2701;this.runId=o.runId||String(this.seed);this.mode=o.mode||'\"'solo';this.seats=(o.seats||[0]).slice().sort((a,b)=>a-b);\n      this.balance={...T.DEFAULTS};this.demo=\"'!!o.demo;this.practice=false;this.assisted=!!o.assisted;this.god=false;\n      this.score=0;this.lives=3;this.rescued=0;this.elapsed=0;this.tick=0;this.eventId=0;this.events=[];this.history=[];this.stock=3;this.damageGrace=0;\n      this.stats={discoveries:0,deliveries:0,plants:0,triggers:0,stuns:0,refills:0,hits:0,decoys:0,escalations:0};\n      this.floor=0;this.startFloor(o.floor||0);\n    }\n    emit(type,data={}){\n      const ev={id:++this.eventId,tick:this.tick,floor:this.floor,type,...data};this.events.push(ev);this.history.push(ev);if(this.history.length>80)this.history.shift();return ev;\n    }\n    startFloor(n){\n      this.floor=n;this.content=T.FLOORS[n];this.map=T.makeMap(this.content);this.grid=E.Grid.from(this.map);\n      this.phase='\"'intro';this.phaseTime=2;this.floorTime=0;this.delivered=0;this.bomb=null;this.supply={ready:true,timer:0};this.damageGrace=1;\n      this.players=this.seats.map((seat,i)=>({...body('p'+seat,this.content.spawns[i%2],3.5),seat,carried:null,home:null,invuln:2,hurt:0,emote:0,supplyInside:false,bombSeq:-1,route:null,active:true}));\n      const rng=new Stream(this.seed,'rooms-'+n), deck=Array.from({length:this.content.rooms.length},(_,i)=>i<this.content.quota?'baby':'beetle');\n      // The teaching room is fixed; other outcomes are seeded once and never rerolled.\n      for(let i=deck.length-1;i>1;i--){const j=1+Math.floor(rng.next()*i);[deck[i],deck[j]]=[deck[j],deck[i]];}\n      this.rooms=this.content.rooms.map((cell,i)=>({id:'f'+n+'r'+i,cell:cell.slice(),kind:deck[i],status:'hidden',discovered:false,symbol:i%4}));\n      this.homes=this.content.homes.map((cell,i)=>({id:i,cell:cell.slice(),reserved:null,seat:null,glow:0}));\n      this.enemies=this.content.enemies.map((e,i)=>this.makeEnemy(e.cell,e.age,'f'+n+'b'+i));\n      this.emit('floor',{name:this.content.name});\n    }\n    makeEnemy(cell,age=0,id='f'+this.floor+'b'+this.enemies.length){\n      return {...body(id,cell,2.2),age,state:age>=this.balance.redAt?'red':age>=this.balance.yellowAt?'yellow':'blue',stun:0,emerge:1.1,target:null,lastSeen:null,sighted:false,warned:0,scored:false,rng:new Stream(this.seed,id)};\n    }\n    setBalance(key,value){\n      const sp=T.SLIDERS.find(s=>s[0]===key);if(\"'!sp||!Number.isFinite(value))return;\n      this.balance[key]=Math.min(sp[3],Math.max(sp[2],value));\n      if(this.balance.redAt<this.balance.yellowAt+3){if(key==='\"'redAt')this.balance.yellowAt=this.balance.redAt-3;else this.balance.redAt=this.balance.yellowAt+3;}\n      this.practice=true;this.emit('practice');\n    }\n    resetBalance(){this.balance={...T.DEFAULTS};}\n    leave(seat){\n      const p=this.players.find(p=>p.seat===seat);if(\"'!p||!p.active)return;this.drop(p);p.active=false;p.route=null;\n      this.seats=this.seats.filter(s=>s!==seat);this.emit('\"'leave',{seat});\n    }\n    drop(p){\n      if(p.carried){const room=this.rooms.find(r=>r.id===p.carried);if(room)room.status='revealed';}\n      for(const h of this.homes)if(h.seat===p.seat){h.reserved=null;h.seat=null;}\n      p.carried=null;p.home=null;\n    }\n    reveal(p){\n      if(p.carried||p.hurt>0)return;\n      const room=this.rooms.find(r=>(r.status==='hidden'||r.status==='revealed')&&Math.hypot(p.m.x-r.cell[0],p.m.y-r.cell[1])<.18);if(\"'!room)return;\n      if(room.kind==='\"'beetle'){\n        room.status='empty';const b=this.makeEnemy(room.cell,0,'f'+this.floor+'d'+room.id);b.emerge=1.4;this.enemies.push(b);this.stats.decoys++;this.emit('decoy',{room:room.id,x:room.cell[0],y:room.cell[1]});return;\n      }\n      const open=this.homes.filter(h=>h.reserved===null&&this.grid.path(room.cell,h.cell).length);\n      open.sort((a,b)=>this.grid.path(room.cell,b.cell).length-this.grid.path(room.cell,a.cell).length||a.id-b.id);\n      const home=open[0];if(\"'!home){this.emit('\"'reservation-error',{seat:p.seat});return;}\n      home.reserved=room.id;home.seat=p.seat;p.carried=room.id;p.home=home.id;p.emote=.7;room.status='carried';\n      if(\"'!room.discovered){room.discovered=true;this.score+=100;this.stats.discoveries++;}\n      this.emit('\"'pickup',{seat:p.seat,room:room.id,home:home.id,symbol:room.symbol,x:p.m.x,y:p.m.y});\n    }\n    deliver(p){\n      if(\"'!p.carried||p.hurt>0)return;\n      const home=this.homes.find(h=>h.id===p.home);if(!home||home.reserved!==p.carried)return;\n      if(Math.hypot(p.m.x-home.cell[0],p.m.y-home.cell[1])>.24)return;\n      const room=this.rooms.find(r=>r.id===p.carried);room.status='\"'delivered';home.reserved=null;home.seat=null;home.glow=1.5;\n      const rid=p.carried;p.carried=null;p.home=null;p.emote=.6;this.score+=400;this.delivered++;this.rescued++;this.stats.deliveries++;\n      this.emit('delivery',{seat:p.seat,room:rid,home:home.id,x:p.m.x,y:p.m.y,points:400});\n    }\n    plant(p,intent){\n      if(\"'!intent?.bomb||p.hurt>0||!p.active)return false;\n      const seq=intent.bombSeq??this.tick;\n      if(seq<=p.bombSeq)return false;p.bombSeq=seq;\n      if(this.bomb){this.emit('\"'busy',{seat:p.seat});return false;}\n      if(this.stock<=0){this.emit('empty',{seat:p.seat,x:this.content.supply[0],y:this.content.supply[1]});return false;}\n      this.stock--;this.bomb={id:'bomb'+this.tick,x:p.m.x,y:p.m.y,timer:this.balance.bombLife,seat:p.seat};p.emote=.24;\n      this.stats.plants++;this.emit('plant',{seat:p.seat,x:p.m.x,y:p.m.y});return true;\n    }\n    los(a,b){\n      const ac=[Math.round(a.m.x),Math.round(a.m.y)],bc=[Math.round(b.m.x),Math.round(b.m.y)];\n      if(ac[0]\"'!==bc[0]&&ac[1]!==bc[1])return false;\n      const dx=Math.sign(bc[0]-ac[0]),dy=Math.sign(bc[1]-ac[1]);let [x,y]=ac;\n      for(let i=0;i<30;i++){if(!this.map.walkable(x,y))return false;if(x===bc[0]&&y===bc[1])return true;x+=dx;y+=dy;}return false;\n    }\n    target(b){\n      const valid=this.players.filter(p=>p.active&&p.hurt<=0);\n      const costs=valid.map(p=>({p,d:this.grid.path(T.cell(b),T.cell(p)).length||999})).sort((a,b)=>a.d-b.d||a.p.seat-b.p.seat);\n      if(!costs.length)return null;\n      const current=costs.find(c=>c.p.seat===b.target), best=current&&current.d<=costs[0].d+2?current:costs[0];b.target=best.p.seat;return best.p;\n    }\n    choose(b){\n      const m=b.m,cell=[m.cx,m.cy];let goal=null;\n      if(b.state==='\"'red'){const p=this.target(b);if(p)goal=T.cell(p);}\n      if(b.state==='yellow'){\n        const seen=this.players.filter(p=>p.active&&p.hurt<=0&&this.los(b,p)).sort((a,c)=>T.dist(cell,T.cell(a))-T.dist(cell,T.cell(c))||a.seat-c.seat)[0];\n        if(seen){b.lastSeen=T.cell(seen);if(\"'!b.sighted)this.emit('\"'sight',{enemy:b.id,seat:seen.seat,x:m.x,y:m.y});b.sighted=true;}else b.sighted=false;\n        goal=b.lastSeen;if(goal&&T.same(goal,cell)){b.lastSeen=null;goal=null;}\n      }\n      if(goal){const path=this.grid.path(cell,goal);if(path.length>1)return [path[1][0]-m.cx,path[1][1]-m.cy];}\n      let ways=T.DIRS.filter(d=>this.grid.walk([m.cx+d[0],m.cy+d[1]]));\n      const forward=ways.filter(d=>d[0]\"'!==-m.dir[0]||d[1]!==-m.dir[1]);if(forward.length)ways=forward;\n      return ways[Math.floor(b.rng.next()*ways.length)]||null;\n    }\n    updateEnemy(b,dt){\n      b.prev=[b.m.x,b.m.y];\n      if(b.emerge>0){b.emerge-=dt;return;}\n      if(b.stun>0){b.stun-=dt;b.walk=0;if(b.stun<=0){b.age=0;b.state='\"'blue';b.warned=0;b.lastSeen=null;b.target=null;this.emit('recovery',{enemy:b.id,x:b.m.x,y:b.m.y});}return;}\n      b.age+=dt;const state=b.age>=this.balance.redAt?'red':b.age>=this.balance.yellowAt?'yellow':'blue';\n      if(state\"'!==b.state){b.state=state;this.stats.escalations++;this.emit('\"'escalate',{enemy:b.id,state,x:b.m.x,y:b.m.y});}\n      const warning=b.age>=this.balance.redAt-1?2:b.age>=this.balance.yellowAt-1?1:0;\n      if(warning>b.warned){b.warned=warning;this.emit('warning',{enemy:b.id});}\n      const want=b.m.moving?null:this.choose(b);\n      b.m.speed=({blue:2.2,yellow:2.6,red:2.9}[b.state])*this.balance.enemySpeed;\n      b.m.update(dt,this.grid,want,{keep:false});b.walk=Math.hypot(b.m.x-b.prev[0],b.m.y-b.prev[1])/dt;\n      if(b.walk>.01)b.facing=Math.atan2(b.m.dir[1],b.m.dir[0]);\n    }\n    hit(p){\n      if(this.god||this.demo||p.invuln>0||p.hurt>0||this.damageGrace>0)return;\n      this.lives--;this.stats.hits++;this.damageGrace=1.1;p.hurt=.85;p.invuln=3.5;p.route=null;this.drop(p);\n      this.bomb=null;this.emit('hit',{seat:p.seat,x:p.m.x,y:p.m.y,lives:this.lives});\n      if(this.lives<=0){this.phase='lost';this.phaseTime=0;this.emit('loss');}\n    }\n    safeRespawn(p){\n      const danger=c=>Math.min(...this.enemies.filter(b=>b.stun<=0&&b.emerge<=0).map(b=>Math.hypot(b.m.x-c[0],b.m.y-c[1])),99);\n      const places=this.content.spawns.concat(this.content.homes).filter(c=>this.map.walkable(...c));\n      places.sort((a,b)=>danger(b)-danger(a));const c=places[0];p.m.place(...c);p.prev=c.slice();p.bufferTime=0;p.route=null;p.invuln=2.5;\n      this.emit('respawn',{seat:p.seat,x:c[0],y:c[1]});\n    }\n    routeDir(p,target){\n      const dest=Array.isArray(target)?target:p.route;if(\"'!dest)return null;\n      if(!this.grid.walk(dest))return null;\n      const from=p.m.moving?p.m._to:[p.m.cx,p.m.cy];\n      const path=this.grid.path(from,dest);\n      if(path.length>1)return [path[1][0]-from[0],path[1][1]-from[1]];\n      if(p.m.moving)return p.m.dir.slice();p.route=null;return null;\n    }\n    step(dt,intents={}){\n      this.events=[];this.tick++;\n      if(['\"'lost','won','ended'].includes(this.phase))return;\n      if(this.phase\"'!=='\"'playing'){\n        this.phaseTime-=dt;\n        if(Object.values(intents).some(i=>i?.confirm))this.phaseTime=Math.min(this.phaseTime,0);\n        if(this.phaseTime<=0){\n          if(this.phase==='intro'){this.phase='playing';this.emit('begin');}\n          else if(this.phase==='clear'){if(this.floor<4)this.startFloor(this.floor+1);else {this.phase='celebration';this.phaseTime=5;this.emit('celebration');}}\n          else if(this.phase==='celebration'){this.phase='won';this.emit('victory');}\n        }return;\n      }\n      this.elapsed+=dt;this.floorTime+=dt;this.damageGrace=Math.max(0,this.damageGrace-dt);\n      for(const h of this.homes)h.glow=Math.max(0,h.glow-dt);\n      // Stable order: recharge/timers, seat movement, bomb accepts, enemy movement, bomb triggers,\n      // damaging contacts, seat reveals/deliveries, then commit one clear/terminal phase.\n      if(\"'!this.supply.ready){this.supply.timer-=dt;if(this.supply.timer<=0){this.supply.ready=true;this.emit('\"'supply-ready');}}\n      if(this.bomb&&(this.bomb.timer-=dt)<=0){this.emit('expire',{x:this.bomb.x,y:this.bomb.y});this.bomb=null;}\n      for(const p of this.players){\n        if(\"'!p.active)continue;\n        p.invuln=Math.max(0,p.invuln-dt);p.emote=Math.max(0,p.emote-dt);\n        if(p.hurt>0){p.hurt-=dt;p.prev=[p.m.x,p.m.y];if(p.hurt<=0)this.safeRespawn(p);continue;}\n        const intent=intents[p.seat]||{};\n        if(intent.route&&Array.isArray(intent.route)&&intent.route.every(Number.isInteger)&&this.grid.walk(intent.route))p.route=intent.route.slice();\n        let dir=intent.dir;\n        if(!Array.isArray(dir)||dir.length!==2||!dir.every(Number.isFinite)||Math.abs(dir[0])+Math.abs(dir[1])!==1)dir=null;\n        if(dir)p.route=null;else if(p.route)dir=this.routeDir(p);\n        T.move(p,dt,this.grid,dir,this.balance.playerSpeed*(p.carried?this.balance.carrySpeed:1));\n        this.plant(p,intent);\n        const inside=Math.hypot(p.m.x-this.content.supply[0],p.m.y-this.content.supply[1])<.4;\n        if(inside&&!p.supplyInside&&this.supply.ready&&this.stock<5){this.stock=Math.min(5,this.stock+2);this.supply.ready=false;this.supply.timer=this.balance.recharge;this.stats.refills++;this.emit('\"'refill',{seat:p.seat,x:p.m.x,y:p.m.y});}\n        p.supplyInside=inside;\n      }\n      for(const b of this.enemies)this.updateEnemy(b,dt);\n      if(this.bomb){\n        const bomb=this.bomb,stationary={prev:[bomb.x,bomb.y],m:{x:bomb.x,y:bomb.y}};\n        const trigger=this.enemies.some(b=>b.emerge<=0&&b.stun<=0&&T.swept(b,stationary)<.48);\n        if(trigger){\n          for(const b of this.enemies)if(b.emerge<=0&&Math.hypot(b.m.x-bomb.x,b.m.y-bomb.y)<=1.65){\n            b.stun=this.balance.stun;b.state='stunned';b.walk=0;\n            if(\"'!b.scored){b.scored=true;this.score+=50;}this.stats.stuns++;\n          }\n          this.stats.triggers++;this.emit('\"'trigger',{x:bomb.x,y:bomb.y,radius:1.65});this.bomb=null;\n        }\n      }\n      for(const p of this.players){if(\"'!p.active||p.hurt>0)continue;\n        for(const b of this.enemies)if(b.emerge<=0&&b.stun<=0&&T.swept(p,b)<.53){this.hit(p);break;}\n        if(this.phase==='\"'lost')return;\n      }\n      for(const p of this.players)if(p.active){this.reveal(p);this.deliver(p);}\n      if(this.delivered===this.content.quota&&\"'!this.players.some(p=>p.carried)){\n        this.score+=250;this.phase='\"'clear';this.phaseTime=2.6;this.bomb=null;this.emit('clear',{points:250});\n      }\n    }\n    snapshot(){\n      const actor=a=>({id:a.id,x:+a.m.x.toFixed(4),y:+a.m.y.toFixed(4),cx:a.m.cx,cy:a.m.cy,to:a.m._to,u:a.m._u,moving:a.m.moving,dir:a.m.dir,facing:a.facing,walk:a.walk});\n      return {v:1,run:this.runId,seed:this.seed,tick:this.tick,eventId:this.eventId,floor:this.floor,phase:this.phase,phaseTime:this.phaseTime,score:this.score,lives:this.lives,stock:this.stock,rescued:this.rescued,delivered:this.delivered,elapsed:this.elapsed,floorTime:this.floorTime,\n        demo:this.demo,practice:this.practice,assisted:this.assisted,balance:{...this.balance},stats:{...this.stats},bomb:this.bomb&&{...this.bomb},supply:{...this.supply},\n        players:this.players.map(p=>({...actor(p),seat:p.seat,carried:p.carried,home:p.home,invuln:p.invuln,hurt:p.hurt,emote:p.emote,active:p.active,route:p.route})),\n        enemies:this.enemies.map(b=>({...actor(b),state:b.state,age:b.age,stun:b.stun,emerge:b.emerge,target:b.target,lastSeen:b.lastSeen,sighted:b.sighted,scored:b.scored})),\n        rooms:this.rooms.map(r=>({...r,cell:r.cell.slic