ay && s.keys, ks => ks.map(([k, w]) => { const e = this._el('span'); e.append(this._el('kbd', '', k), w); return e; }));\n    const m = play && s.minimap; E3.mini.hidden = !m; if (m) this._miniLast = m;\n    if (m && (this._game.real - (this._miniT || -1) > .1)) { this._miniT = this._game.real; this._map(E3.mini, m, false); }\n2358:    /** zoom: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's\n2361:    this.zoom = 1; this.yaw = 0; this._zoomBase = 1; this._zoomTo = null; this._zoomAt = 0; this._wall = 0;   // camera zoom and turn on top of the chosen view (setZoom, rotateView)\n2460:   * camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom\n2464:  setZoom(z) { this._zoomBase = clamp(+z || 1, .5, 3); this._zoomApply(true); }\n2467:  /** undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1\n3710:        if (want < z - 1e-9 || (k > 1.2 && want > z + 1e-9)) this.setZoom(want);\n9439:    if (!this._sys && this._pauseSpec()) game.pauseOverlay = false;\n9467:  _pauseSpec() { const sc = this._o.screens; return sc && 'pause' in sc ? sc.pause || null : this._std ? {} : null; }\n9632:  _settingsRows(add) {\n9720:    if (name === 'settings') this._settingsRows(add);\n9731:    if (name === 'pause') this._pauseActs(acts);\n9751:  _pauseActs(acts) {\n9807:    const pause = this._pauseSpec() && (!this._sys || (g.pauseOverlay !== false && play));   // (the engine's own menu stays out of a game that draws its own pause)\n10624:- The attract mode, on the title: cab.attract(dt) -> 'title', then 'demo' once o.idle seconds (20) pass without any player's input\n10723:  attract(dt) {\n.esh kbd{font:700 12px var(--font);border:1px solid var(--accent);border-bottom-width:2px;border-radius:4px;padding:2px 7px;color:var(--accent)}\n.esh-tip{position:absolute;left:50%;bottom:calc(var(--pb) + 100px);transform:transla