{"type":"item.completed","item":{"id":"item_56","type":"agent_message","text":"Hub’s conformance checks passed for two-player play, simulated latency and packet loss, a dedicated host, and host departure. Testing also caught and fixed a boot syntax error. I’m continuing with full-campaign co-op, device emulation, and audio checks; the harness alone doesn’t establish those.\n"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/art.js';s=open(p).read();s=s.replace(\\\"const INK='#101e2a'\\\", \\\"const INK='#101e2a'\\\")\ns=s.replace(\\\"for(const [x,y,id] of f.props)r.shape(id,(x+.5)*16,(y+.5)*16,0,{scale:.26\\\", \\\"for(const [x,y,id] of f.props)r.shape(id,(x+.5)*16,(y+.5)*16,0,{scale:.55\\\")\ns=s.replace(\\\"if(a.invuln>0&&Math.floor(game.time*8)%2===0)\\\", \\\"if(a.invuln>0&&\"'!game.reduceMotion&&game.settings.flashes>0&&Math.floor(game.time*8)%2===0)\")\ns=s.replace(\"tx('\"'♥'.repeat(Math.max(0,st.lives))+'♡'.repeat(3-st.lives),left+99,top-16,'#edaba0');\\\", \\\"E.ui.hearts(g,left+99,top-16,st.lives,3);\\\")\n# Add contextual cues and native controller labels under the map.\ns=s.replace(\\\"if(st.practice||st.assisted)tx(\\\", \\\"const input=this.game.input,device=input.lastDevice;\\\\n      if(\"'!st.demo&&device!=='\"'touch')tx((device==='gamepad'?'Stick / D-pad':'WASD / Arrows')+'  Move     '+input.label('bomb')+'  Bug bomb     '+input.label('pause')+'  Pause',r.W/2,yy+13,'#a8bfbd',{align:'center',font:'tiny'});\\\\n      if(st.practice||st.assisted)tx(\\\")\ns=s.replace(\\\"r.W/2,yy+12,'#acccca'\\\", \\\"r.W/2,yy+25,'#acccca'\\\")\ns=s.replace(\\\"if(e.type==='pickup')E.font.text\\\", \\\"if(e.type==='sight'&&t<.55)E.font.text(g,'\"'!'\"',x,y-17,'#ffe2a0',{align:'center',outline:false,scale:2});\\\\n          if(e.type==='empty')E.font.text(g,'SUPPLY +',x,y-14,'#f2b291',{align:'center',outline:false});\\\\n          if(e.type==='pickup')E.font.text\\\")\n# A decorated hotel needs a distinct landmark on each floor, staged on solid wall blocks.\ns=s.replace(\\\"for(const room of st.rooms){\\\", \\\"r.actor(56,40,0,(g,x,y)=>{\\\\n        if(st.floor===0){px.rect(g,x-8,y-3,16,6,'#805e48');px.rect(g,x-7,y-4,14,2,'#d8bd87');px.ell(g,x,y-6,3,3,'#e7c77e');px.rect(g,x-1,y-10,2,2,'#fff0bb');}\\\\n        else if(st.floor===1){px.rect(g,x-7,y-7,14,14,'#869fa1');