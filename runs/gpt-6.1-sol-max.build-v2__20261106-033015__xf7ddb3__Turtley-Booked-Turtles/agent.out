f(app.net?.ended||app.consumeUntil>game.real)\\\")\nopen(p,'w').write(s)\nPY\nnpm run build && npm run verify -- network\"","aggregated_output":"npm notice run turtley-booked@1.0.0 build\nnpm notice run node tools/build.mjs\nBuilt Turtley-Booked-Turtles-gpt-6.1-sol-max-20261106-033015.html (1364069 bytes)\nnpm notice run turtley-booked@1.0.0 verify\nnpm notice run node tools/verify.mjs network\nFAIL dedicated synchronized campaign 0 seed 9\nFAIL dedicated synchronized campaign 0.05 seed 9\n23 checks, 2 failures.\n","exit_code":1,"status":"failed"}}
{"type":"item.completed","item":{"id":"item_66","type":"agent_message","text":"Solo and local co-op both have recorded full-campaign wins with normal lives and balance. Network testing is checking campaign recovery after dropped snapshots, separately from the harness checks. I also found a touch integration bug: the contextual bomb label was updating, but its button had never been created. That’s fixed.\n"}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"cat > tests/devices.py <<'PY'\nimport json\nimport pathlib\nimport sys\nfrom playwright.sync_api import sync_playwright\nroot = pathlib.Path(__file__).resolve().parents[1]\nurl = (root / 'build/game.html').as_uri()\ncount = 0\nfailures = []\ndef check(name, okay, detail=''):\n    global count\n    count += 1\n    if not okay:\n        failures.append(name + ': ' + str(detail))\n\ndef settle(page, seconds=.15):\n    page.wait_for_timeout(seconds * 1000)\n\npad_script = \\\"\\\"\\\"window.pad={id:'Emulated DualSense',index:0,mapping:'standard',connected:true,timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),vibrationActuator:{playEffect:()=>Promise.resolve()}};Object.defineProperty(navigator,'getGamepads',{value:()=>window.pad.connected?[window.pad]:[]});\\\"\\\"\\\"\ntry:\n  with sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    page = browser.new_page(viewport={'width':1920,'height':1080})\n    page.add_init_script(pad_script)\n    errors=[]\n    page.on('pageerror',lambda e:errors.append(str(e)))\n    page.goto(url)\n    settle(page,.3)\n    def pad(button):\n        page.evaluate('(b)=>{pad.buttons[b].pressed=true;pad.buttons[b].value=1;pad.timestamp++;}',button)\n        settle(page,.06)\n        page.evaluate('(b)=>{pad.buttons[b].pressed=false;pad.buttons[b].value=0;pad.timestamp++;}',button)\n        settle(page,.1)\n    check('PS glyphs selected by default',page.evaluate('TB.app.game.settings.glyphs===\\\"playstation\\\"'))\n    pad(13)\n    check('pad moves native menu focus','CO-OP' in page.evaluate('document.activeElement.textContent').upper())\n    pad(0)\n    check('pad confirms co-op screen',page.evaluate('TB.app.ui.screen===\\\"coop\\\"'))\n    pad(1)\n    check('pad backs to title',page.evaluate('TB.app.ui.screen===\\\"title\\\"'))\n    # All menu surfaces are native Shell focusables; use pad navigation across settings and dev rows.\n    page.get_by_role('button',name='Settings',exact=True).click()\n    page.evaluate('TB.app.game.settings.set(\\\"glyphs\\\",\\\"xbox\\\")')\n    pad(0)\n    check('Xbox glyph selection',page.evaluate('TB.app.game.input.glyphs===\\\"xbox\\\"'))\n    page.evaluate('TB.app.ui.hide();TB.app.title()')\n    settle(page,.1)\n    page.get_by_role('button',name='Check in • Solo',exact=True).click()\n    settle(page,2.2)\n    check('audio gesture unlock',page.evaluate('TB.app.game.audio.ready'))\n    start=page.evaluate('TB.app.run.players[0].m.x')\n    page.evaluate('pad.axes[0]=1')\n    settle(page,.25)\n    page.evaluate('pad.axes[0]=0')\n    check('pad stick moves turtle',page.evaluate('TB.app.run.players[0].m.x')>start)\n    pad(9)\n    check('Options pauses',page.evaluate('TB.app.game.paused'))\n    page.get_by_role('button',name='Developer tools',exact=True).click()\n    page.get_by_role('button',name='Balance sliders',exact=True).click()\n    slider=page.locator('.esh input[type=range]').first\n    slider.focus()\n    before=page.evaluate('TB.app.run.balance.playerSpeed')\n    pad(15)\n    check('pad adjusts live balance slider',page.evaluate('TB.app.run.balance.playerSpeed')>before)\n    check('balance adjustment unranked',page.evaluate('TB.app.run.practice'))\n    page.get_by_role('button',name='Reset balance defaults',exact=True).click()\n    check('balance reset preserves music and glyphs',page.evaluate('TB.app.run.balance.playerSpeed===3.5&&TB.app.game.settings.music===.1&&TB.app.game.settings.glyphs===\\\"xbox\\\"'))\n    page.evaluate('TB.app.ui.hide();TB.app.game.resume()')\n    # A disconnected pad reaches a recoverable native pause; switching controls preserves the run.\n    page.evaluate('pad.connected=false')\n    settle(page,.2)\n    check('pad disconnect recovery pause',page.evaluate('TB.app.game.paused'))\n    page.evaluate('pad.connected=true')\n    page.keyboard.press('Escape')\n    settle(page,.1)\n    page.evaluate('TB.app.title()')\n    settle(page,.1)\n    page.get_by_role('button',name='Local co-op',exact=True).click()\n    page.get_by_role('button',name='Shared keyboard',exact=True).click()\n    settle(page,2.2)\n    before=page.evaluate('TB.app.run.players.map(p=>p.m.x)')\n    page.keyboard.down('a');page.keyboard.down('ArrowRight');settle(page,.25);page.keyboard.up('a');page.keyboard.up('ArrowRight')\n    after=page.evaluate('TB.app.run.players.map(p=>p.m.x)')\n    check('independent simultaneous keyboard seats',after[0]<before[0] and after[1]>before[1],after)\n    page.keyboard.press('ShiftRight');settle(page,.1)\n    check('right shift belongs to second rescuer',page.evaluate('TB.app.run.bomb?.seat===1&&TB.app.run.stock===2'))\n    # A scripted ordinary route uses the mouse projection and native click handling.\n    page.evaluate('TB.app.start(\\\"solo\\\")');settle(page,2.2)\n    point=page.evaluate('()=>{const g=TB.app.game,rc=g.screen.canvas.getBoundingClientRect(),p=g.r.w(120,152);return [rc.left+p[0]/g.W*rc.width,rc.top+p[1]/g.H*rc.height]}')\n    page.mouse.click(*point)\n    settle(page,1.4)\n    check('mouse click reaches mystery room',page.evaluate('\"'!!TB.app.run.players[0].carried'\"'))\n    page.screenshot(path=str(root/'build/carry-tv.png'))\n    # Whole exact HTML gameplay/ending through fixed-step native Game and ordinary intentions.\n    page.evaluate('''()=>{const a=TB.app;a.start('solo','shared',{seed:2});a.game.stop();const bot=new TB.Bot;a.driver=(r,seat)=>bot.intent(r,r.players.find(p=>p.seat===seat));for(let i=0;i<1200&&\"'!a.resultShown;i++)a.game.advance(.5);a.driver=null;}'\"''')\n    check('final HTML complete ordinary campaign',page.evaluate('TB.app.run.phase===\\\"won\\\"&&TB.app.run.rescued===26&&TB.app.ui.screen===\\\"results\\\"&&\"'!TB.app.run.practice'\"'))\n    page.screenshot(path=str(root/'build/results-tv.png'))\n    # No autoplay dependency, exact ten-second attract and consumed exits.\n    page.evaluate('TB.app.title();TB.app.game.advance(.1);TB.app.game.advance(9.6)')\n    check('no early attract',page.evaluate('\"'!TB.app.attract'\"'))\n    page.evaluate('TB.app.game.advance(.5)')\n    check('attract starts at 10 seconds',page.evaluate('TB.app.attract'))\n    page.keyboard.press('Enter')\n    page.evaluate('TB.app.game.advance(.2)')\n    check('attract exit input consumed',page.evaluate('\"'!TB.app.attract&&TB.app.game.sceneName===\"title\"&&TB.app.run===null'\"'))\n    check('no runtime or draw errors',not errors and page.evaluate('TB.app.game.errors.length===0'),errors)\n    page.close()\n    # Touch: portrait entire map, drag movement, two independent pointers and contextual action.\n    context=browser.new_context(**p.devices['iPhone 13'])\n    phone=context.new_page();phone.goto(url);settle(phone,.3)\n    phone.get_by_role('button',name='Check in • Solo',exact=True).tap();settle(phone,2.2)\n    phone.evaluate('TB.app.game.settings.set(\\\"assist\\\",false)')\n    x=phone.evaluate('TB.app.run.players[0].m.x')\n    phone.dispatch_event('#screen','pointerdown',{'pointerId':101,'pointerType':'touch','clientX':100,'clientY':650,'isPrimary':True,'buttons':1})\n    phone.dispatch_event('#screen','pointermove',{'pointerId':101,'pointerType':'touch','clientX':160,'clientY':650,'isPrimary':True,'buttons':1})\n    settle(phone,.25)\n    check('touch invisible drag moves turtle',phone.evaluate('TB.app.run.players[0].m.x')>x)\n    # Controlled encounter fixture only for UI exclusion/multitouch and screenshot, not campaign evidence.\n    phone.evaluate('''()=>{let r=TB.app.run,p=r.players[0],b=r.enemies[0];b.m.place(p.m.cx+1,p.m.cy);b.emerge=0;b.stun=0;r.damageGrace=5;}''')\n    settle(phone,.1)\n    check('contextual touch bomb exists',phone.locator('[data-act=bomb]').is_visible())\n    phone.screenshot(path=str(root/'build/phone-touch.png'))\n    phone.locator('[data-act=bomb]').dispatch_event('pointerdown',{'pointerId':102,'pointerType':'touch','buttons':1})\n    se