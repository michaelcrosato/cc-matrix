{"type":"item.started","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='tests/hub_campaign.py';s=open(p).read();old=\\\"const a=TB.app,bot=new TB.Bot;a.game._frame=()=>{};a.sound.stop();a.driver=(r,seat)=>bot.intent(r,r.players.find(p=>p.seat===seat));\\\"\nnew=\\\"\\\"\\\"const a=TB.app,bot=new TB.Bot;a.game._frame=()=>{};a.sound.stop();let waypoint=0,lastFloor=-1,bombSeq=0;\n    a.driver=(r,seat)=>{const p=r.players.find(p=>p.seat===seat);if(\"'!p)return {};if(seat!==1||p.carried)return bot.intent(r,p);\n      if(r.phase!=='\"'playing')return {confirm:true};if(p.hurt>0)return {};if(r.floor\"'!==lastFloor){lastFloor=r.floor;waypoint=0;}\n      const corners=[[19,11],[19,1],[1,1],[1,11]];let goal=corners[waypoint];if(Math.hypot(p.m.x-goal[0],p.m.y-goal[1])<.3){waypoint=(waypoint+1)%4;goal=corners[waypoint];}\n      if(r.stock<2&&r.supply.ready&&!p.supplyInside)goal=r.content.supply;\n      const near=r.enemies.filter(b=>b.stun<=0&&b.emerge<=0).some(b=>Math.hypot(b.m.x-p.m.x,b.m.y-p.m.y)<2.8);\n      if(near){const dodge=bot.intent(r,p);if(dodge.bomb)dodge.bombSeq=++bombSeq;return dodge;}\n      return {route:goal,dir:null,bomb:false,bombSeq};};\"\"\"\nassert old in s;s=s.replace(old,new)\nopen(p,'\"'w').write(s)\nPY\nnpm run --silent verify -- hub-campaign\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
