valuate('pad.buttons[8].pressed=true;pad.buttons[9].pressed=true')\n    settle(page,.1)\n    check('Create plus Options chord is not stolen',page.evaluate('\"'!TB.app.game.paused'\"'))\n    page.evaluate('pad.buttons[8].pressed=false;pad.buttons[9].pressed=false')\n'''+s[i:]\ni=s.index(\\\"    check('no runtime or draw errors'\\\")\ns=s[:i]+'''    page.evaluate('TB.app.game.start();TB.app.title();TB.app.game.advance(10.2)')\n    page.mouse.move(600,500)\n    settle(page,.1)\n    check('mouse movement exits attract',page.evaluate('\"'!TB.app.attract&&TB.app.run===null'\"'))\n    page.evaluate('TB.app.game.stop();TB.app.game.advance(10.2);TB.app.game.start()')\n    pad(3)\n    check('unmapped pad button exits attract and is consumed',page.evaluate('\"'!TB.app.attract&&TB.app.run===null&&TB.app.game.sceneName===\"title\"'\"'))\n    page.get_by_role('button',name='About / Credits',exact=True).click()\n    pad(0)\n    check('pad enters Source Information credits',page.evaluate('TB.app.ui.screen===\\\"info-source\\\"'))\n    pad(1)\n    pad(13)\n    pad(0)\n    check('pad enters Testing Feedback credits',page.evaluate('TB.app.ui.screen===\\\"info-testing\\\"'))\n'''+s[i:]\n# Cover an actual touch exit from a running demo as well.\ni=s.index(\\\"    context.close();browser.close()\\\")\ns=s[:i]+'''    phone.evaluate('TB.app.title();TB.app.game.stop();TB.app.game.advance(.1);TB.app.game.advance(10.2)')\n    phone.touchscreen.tap(100,200)\n    check('touch exits attract without starting a run',phone.evaluate('\"'!TB.app.attract&&TB.app.run===null'\"'))\n'''+s[i:]\nopen(p,'w').write(s)\nPY\nbiome format --write src/art.js tests/rules.mjs tests/network.mjs > build/acceptance-format.log\nnpm run --silent build && npm run --silent verify -- rules network devices\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
