tring(r.score),'TEAM SCORE'],[r.rescued+' / 26','RESCUED'],[Math.floor(r.elapsed/60)+':'+String(Math.floor(r.elapsed%60)).padStart(2,'0'),'TIME'],[String(Math.max(best,r.score)),'BEST • '+recordType]],actions:[['Play again',()=>app.start(app.mode,app.layout)],['Return to title',()=>app.title()],['About / Credits',about]]});\n  }\n  function intention(I,seat){\n    const actions=['up','left','down','right'],dirs=[[0,-1],[-1,0],[0,1],[1,0]],fresh=actions.map((a,i)=>I.pressed(a)?i:-1).filter(i=>i>=0);\n    if(fresh.length)app.latest[seat]=fresh.at(-1);\n    let idx=app.latest[seat];if(idx==null||\"'!I.down(actions[idx]))idx=actions.findIndex(a=>I.down(a));\n    let dir=idx>=0?dirs[idx]:null;\n    if(!dir){const mv=I.move();if(Math.hypot(...mv)>.3)dir=Math.abs(mv[0])>Math.abs(mv[1])?[Math.sign(mv[0]),0]:[0,Math.sign(mv[1])];}\n    const bomb=I.pressed('\"'bomb'),out={dir,bomb,bombSeq:bomb?++app.bombSeq:app.bombSeq,confirm:I.pressed('confirm')};\n    if(I.lastDevice==='mouse'&&I.clicked()){const ground=game.mouseGround();const cell=ground&&[Math.floor(ground[0]/16),Math.floor(ground[1]/16)];if(cell)out.route=cell;}\n    return out;\n  }\n  function playUpdate(dt){\n    let st;\n    if(app.net){const intent=app.net.info.server?{}:ui.screen?{}:intention(game.input,app.net.info.me);app.net.update(dt,intent);st=app.net.presentation(dt);}\n    else if(app.run){\n      const r=app.run;\n      if(app.attract){const inputs=app.bot.inputs(r);r.step(dt*1.3,inputs);if(['won','lost'].includes(r.phase)){if((app.demoWait=(app.demoWait||0)+dt)>4){app.demoWait=0;app.start('coop','shared',{demo:true});}}}\n      else {\n        const inputs={};for(let i=0;i<r.players.length;i++)inputs[r.players[i].seat]=intention(game.players[i]||game.input,i);\n        const p=r.players[0],touch=game.input.lastDevice==='touch';\n        if(touch){r.assisted=\"'!!S.assist;const near=r.enemies.some(b=>b.stun<=0&&b.emerge<=0&&Math.hypot(p.m.x-b.m.x,p.m.y-b.m.y)<2.5);game.input.touchSet('\"'bomb','POP',near&&r.stock>0&&\"'!r.bomb);\n          if(S.assist&&near&&!r.bomb&&r.stock>0&&r.enemies.some(b=>b.stun<=0&&b.emerge<=0&&Math.hypot(p.m.x-b.m.x,p.m.y-b.m.y)<1.15))inputs[0]={...inputs[0],bomb:true,bombSeq:++app.bombSeq};\n        }else game.input.touchSet('\"'bomb','POP',false);\n        if(app.timeScale>0)r.step(dt*app.timeScale,inputs);\n      }\n      st=r.snapshot();\n      if(['won','lost'].includes(r.phase)&&\"'!app.attract)result();\n    }\n    if(st){app.state=st;app.art.update(dt,st);app.sound.update(st);}\n  }\n  game.input.steer='\"'drag';game.input.touchButtons([]);game.input.touchFilter=e=>\"'!(e.target?.closest?.('\"'.esh, .e-corner, [data-act]'));\n  app.lastMeaningful=()=>{app.activity=game.real;cab.wake();};\n  const exitDemo=()=>{if(\"'!app.attract)return false;app.title();resetInputs();app.consumeUntil=game.real+.16;return true;};\n  if(typeof addEventListener!=='\"'undefined'){\n    for(const ev of ['keydown','pointerdown','touchstart'])addEventListener(ev,e=>{if(e.repeat)return;app.lastMeaningful();if(exitDemo()){e.preventDefault();e.stopImmediatePropagation();}},{capture:true,passive:false});\n    let last=[0,0];addEventListener('pointermove',e=>{if(e.pointerType==='mouse'&&Math.hypot(e.clientX-last[0],e.clientY-last[1])>4){last=[e.clientX,e.clientY];app.lastMeaningful();if(app.attract)exitDemo();}},{passive:true});\n  }\n  game.hook('input',()=>{\n    if(game.input.anyPressed()||game.players.some(i=>Math.hypot(...i.padMove)>.35)){app.lastMeaningful();if(app.attract){exitDemo();game.input.consumeAll();}}\n    if(app.consumeUntil>game.real)for(const i of game.players)i.consumeAll();\n    if(ui.root){const dev=game.input.lastDevice;if(dev\"'!==app.lastDevice){app.lastDevice=dev;ui.root.dataset.device=dev;}}\n    // A neutral online overlay must send neutral intentions while the native live world keeps stepping.\n  });\n  const scenes={title:{camera:{zoom:false},enter(){app.attract=false;app.activity=game.real;titleMenu();app.sound.music(true);},update(dt){\n    if(online)return;const eligible=ui.screen==='\"'title';if(eligible){cab._idle=game.real-app.activity;const phase=cab.attract(dt);if(phase==='demo')app.start('solo','shared',{demo:true});}\n    else {app.activity=game.real;cab.wake();}\n  },draw(r){app.art.title(r,game.time);}},play:{pausable:true,camera:{zoom:false,start:1,tall:1},update:playUpdate,draw(r){if(app.state?.phase==='celebration'||app.state?.phase==='won')app.art.title(r,game.time,true);else app.art.draw(r,app.dev);\n    if(app.net&&\"'!app.net.ended){const t=app.net.api.time();if(!app.net.started||!Number.isFinite(t)||t<0)r.overlay(g=>{E.ui.box(g,r.W/2-90,r.H/2-24,180,48,{bg:'\"'#142d3b',border:'#ecd3a2'});E.font.text(g,\"'!Number.isFinite(t)?'\"'Checking in…':String(Math.max(1,Math.ceil(-t/1000))),r.W/2,r.H/2-10,'#fff1c8',{align:'center',scale:2,outline:false});});}\n  }}};\n  game.debug={snapshot:()=>({identity:T.IDENTITY.title,scene:game.sceneName,screen:ui.screen,paused:game.paused,net:app.net?{host:app.net.info.isHost,server:app.net.info.server,ended:app.net.ended,finished:app.net.finished,started:app.net.started}:null,...app.state}),intent:(seat,i)=>{app.testInputs=app.testInputs||{};app.testInputs[seat]=i;},get run(){return app.run||app.net?.run;}};\n  // Test traces still enter through device-independent intentions, never objective writes.\n  const originalIntention=intention;\n  game.start({scenes,scene:online?'play':'title'});\n  if(online){ui.hide();Promise.resolve(AIHub.connect({mode:'shared-world',seats:[1,2]})).then(info=>{\n    if(\"'!info){game.o.live=false;game.o.autoPause=true;app.title();return;}\n    app.net=new T.Network(info,AIHub);app.run=app.net.run;game.o.live=true;game.o.autoPause=false;game.localSeat=info.server?null:info.me;\n    app.net.onEnd=reason=>{app.sound.stop();resetInputs();ui.hide();game.input.touchSet('\"'bomb','POP',false);ui.show('hub-end',{title:reason==='finished'?'The team has checked out.':'The round has ended.',text:reason==='host-left'?'The host left; AI Hub voided this round.':'AI Hub will show your team’s result and next round.',actions:[]});};app.sound.music(true);\n  }).catch(e=>{AIHub.fail('Unable to initialize hotel: '+e.message);game.fail('Hub initialization',e);});}\n  T.intention=originalIntention;\n  if(typeof window\"'!=='\"'undefined')window.__game={game,app,snapshot:()=>game.debug.snapshot()};\n})(globalThis.TB);\nJS\ncat > tools/build.mjs <<'JS'\nimport fs from 'node:fs';\nimport path from 'node:path';\nconst root=path.resolve(import.meta.dirname,'..'),id=JSON.parse(fs.readFileSync(path.join(root,'identity.json'))).id;\nconst read=p=>fs.readFileSync(path.join(root,p),'utf8'),escape=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst interviewPath=path.join(root,'..','exit-interview.json');\nconst interview=fs.existsSync(interviewPath)?JSON.parse(fs.readFileSync(interviewPath,'utf8')):{sourceInformation:{usage:'added on import'},testingFeedback:['Verification is in progress.'],engineFeedback:['Native pixel rendering, grid navigation and continuous rigs.'],promptFeedback:['A coherent rescue-game brief.']};\nconst scripts=['vendor/engine/my-3d2dge.js','src/content.js','src/sim.js','src/art.js','src/audio.js','src/net.js','src/main.js'];\nconst html=\"'`<!doctype html>'\"\\\\n<html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\">\\\\n<script>\"'${escape(read('\"'vendor/hub/session.js'))}</script>\\\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no\\\">\\\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-2\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\"><meta name=\\\"hub:session-goal\\\" content=\\\"Rescue all 26 hatchlings across five hotel floors.\\\"><meta name=\\\"hub:session-howto\\\" content=\\\"Move: stick / D-pad / WASD. Bomb: Cross / Space. Carry guests to lit homes.\\\"><meta name=\\\"hub:session-minutes\\\" content=\\\"12\\\">\\\\n<meta name=\\\"description\\\" content=\\\"Turtley Booked — Small shells. Big room service. An original rescue-maze arcade game.\\\">\\\\n<title>Turtley Booked</title><style>\"'${read('\"'src/style.css')}</style></head><body><canvas id=\\\"screen\\\" aria-label=\\\"Turtley Booked hotel rescue maze\\\"></canvas>\\\\n\"'${scripts.map((p,i)=>`<script>'\"\\\\n\"'${i===6?'\"'TB.INTERVIEW='+JSON.stringify(interview)+';\\\\n':''}\"'${escape(read(p))}'\"\\\\n</script>\"'`).join('\"'\\\\n')}\\\\n</body></html>\\\\n\"'`;\nfs.writeFileSync(path.join(root,'\"'build','game.html'),html);fs.writeFileSync(path.join(root,'..',id+'.html'),html);\nconsole.log(\"'`Built ${id}.html (${Buffer.byteLength(html)} bytes)`);\nJS\ncat > src/style.css <<'\"'CSS'\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#112431}body{font-family:'Trebuchet MS',sans-serif}canvas#screen{display:block;width:100%;height:100%;image-rendering:pixelated;touch-action:none}\n.esh{--font:'Trebuchet MS',system-ui,sans-serif\"'!important}.esh-sh{background:rgba(6,20,29,.84)!important}.esh-ttl{background:linear-gradient(90deg,rgba(9,25,36,.98),rgba(9,25,36,.85) 40%,rgba(9,25,36,0) 70%)!important}.esh-ttl>div{max-width:470px!important;padding-left:1vw!important}.esh-ttl h1{font-family:Georgia,serif!important;font-size:54px!important;font-weight:900!important;line-height:1.05!important;letter-spacing:-.045em!important;color:#fff0c4!important;text-shadow:0 3px #263c40!important;margin:12px 0!important}.esh-sub{font-size:18px!important;color:#c9dda6!important}.esh .esh-k{font-size:12px!important;letter-spacing:.15em!important;color:#dcbd85!important}.esh-ttl p{max-width:350px;font-size:15px!important;line-height:1.6!important;color:#b6cbc7!important}.esh button{font-size:14px!important;min-height:43px!important;letter-spacing:.06em!important;border-radius:5px!important;border-color:#7c969055!important;transition:background .15s!important}.esh button:hover{background:#44666a77!important}.esh button:focus{outline:2px solid #ffe4ad!important;outline-offset:3px!important;background:#385861!important}.esh button.pri{background:#e9c58d!important;color:#15333a!important}.esh button.pri:focus,.esh button.pri:hover{background:#ffe0aa!important}.esh-btns{gap:8px!important;margin-top:16px!important}.esh-tags{font-size:10px!important;gap:14px!important;letter-spacing:.08em!important}.esh-ttl .esh-m{font-size:11px!important;line-height:1.5!important;max-width:360px!important}.esh-mod{max-width:560px!important;width:min(560px,100%)!important;border-radius:8px!important;box-shadow:0 15px 80px #0006!important}.esh h2{font-size:27px!important;line-height:1.15!important;letter-spacing:-.025em!important}.esh-mod .esh-m{font-size:15px!important;line-height:1.6!important}.esh-row{font-size:15px!important;min-height:50px!important}.esh-row small{font-size:12px!important}.esh input[type=range]{min-height:38px!important}.esh output{font-size:14px!important}.esh-stats b{font-size:26px!important}.esh-grid{font-size:14px!important}.esh button,.esh input{scroll-margin:25px}.esh-keys{font-size:14px!important}.esh-emb{color:#d7e0a1!important}.esh .esh-nav{z-index:10!important}\n@media(max-width:700px){.esh-ttl{place-items:start center!important;background:linear-gradient(180deg,#0e2734f5,#0e2734ee 70%,#0e273480)!important;overflow-y:auto!important}.esh-ttl>div{padding:18px 8px!important;max-width:100%!important;width:100%!important}.esh-ttl h1{font-size:47px!important}.esh-ttl .esh-btns{max-width:340px!important}.esh-sh{padding:54px 18px 22px!important}.esh-ttl{padding-top:18px!important}.esh-tags{flex-wrap:wrap!important}.esh-mod{padding:20px!important}.esh-mod .esh-m{font-size:16px!important}.esh button{min-height:47px!important}.esh-ttl p{font-size:15px!important}.esh .esh-nav{top:5px!important}.esh-row{gap:8px!important}.esh input[type=range]{width:125px!important}}\nCSS\nnpm run build'","aggregated_output":"npm notice run turtley-booked@1.0.0 build\nnpm notice run node 