{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='tests/rules.mjs';s=open(p).read().replace(\\\"['solo',[0],2701],['coop',[0,1],2701]\\\", \\\"['solo',[0],2],['coop',[0,1],9]\\\")\ns=s.replace(\\\"r.stats.hits>0);\\\", \\\"r.stats.hits>0&&r.stats.decoys>0);\\\")\nopen(p,'w').write(s)\nPY\ncat > tests/network.mjs <<'JS'\nimport vm from 'node:vm';import fs from 'node:fs';\nconst c=vm.createContext({console});for(const f of ['vendor/engine/my-3d2dge.js','src/content.js','src/sim.js','src/net.js'])vm.runInContext(fs.readFileSync(f,'utf8'),c);const T=c.TB;\nlet count=0,failures=[];const check=(n,ok)=>{count++;if(\"'!ok)failures.push(n);};\nfunction network({server=false,seed=9,loss=0,latency=0}={}){\n  const copies=[],queue=[],rng=new T.Stream(77,'\"'network');let clock=-3000,wall=0;const sent=[];\n  function api(id,isHost){const events={};return {id,isHost,events,on(k,fn){events[k]=fn;},ready(){this.readies=(this.readies||0)+1;},time:()=>clock,send(data,o={}){sent.push({id,at:wall,size:JSON.stringify(data).length,type:data.type});for(const other of copies)if(other.info.me\"'!==id&&(o.to===undefined||other.info.me===o.to)){if(!o.reliable&&rng.next()<loss)continue;queue.push({at:wall+latency+(o.reliable?0:rng.next()*.05),data:JSON.parse(JSON.stringify(data)),from:id,to:other});}return true;},finish(result){this.finishes=(this.finishes||0)+1;this.result=result;},emit(k,v){events[k]?.(v);}};}\n  const hostId=server?'\"'server':0,ids=server?['server',0,1]:[0,1];\n  for(const id of ids){const info={me:id,isHost:id===hostId,server:id==='server',host:hostId,round:1,seed,players:[{id:0},{id:1}]};const a=api(id,info.isHost);copies.push(new T.Network(info,a));}\n  const host=copies.find(n=>n.run),bot=new T.Bot;\n  const tick=(dt=1/120)=>{wall+=dt;clock+=dt*1000;queue.sort((a,b)=>a.at-b.at);while(queue.length&&queue[0].at<=wall){const m=queue.shift();m.to.receive(m.data,m.from);}\n    for(const n of copies){let input={};if(\"'!n.info.server){const planner=n.planner(),p=planner.players.find(p=>p.seat===n.info.me);input=bot.intent(planner,p);}n.update(dt,input);}\n  };\n  return {copies,host,bot,tick,sent,queue,start(){copies.forEach(n=>n.api.emit('\"'start'));},clock:()=>clock};\n}\nlet n=network();for(let i=0;i<120;i++)n.tick();check('ready exactly once on all copies',n.copies.every(n=>n.api.readies===1));check('world held before start',n.host.run.tick===0);\nn.start();for(let i=0;i<120;i++)n.tick();check('negative Hub clock holds world',n.host.run.tick===0);\nfor(let i=0;i<120*5;i++)n.tick();check('nonnegative Hub clock starts world',n.host.run.tick>0);\nconst host=n.host,r=host.run,p=r.players[1],valid={v:1,run:host.id,type:'input',seq:100,floor:r.floor,dir:[1,0],bombSeq:1,route:null};\nhost.receive(valid,91);check('unauthenticated seat rejected',\"'!host.accepted[91]);\nhost.receive({...valid,dir:[1,1]},1);check('\"'diagonal intention rejected',\"'!host.accepted[1]||host.accepted[1].seq<100);\nhost.receive({...valid,run:'\"'wrong'},1);check('wrong run rejected',\"'!host.accepted[1]||host.accepted[1].seq<100);\nhost.receive({...valid,seq:10000},1);const accepted=host.accepted[1]?.seq;host.receive({...valid,seq:9999},1);check('\"'reordered input cannot rewind',host.accepted[1]?.seq===accepted);\nhost.receive({...valid,seq:10001,floor:4},1);check('wrong floor rejected',host.accepted[1]?.seq===accepted);\nconst client=n.copies[1],before=client.lastSeq;client.receive({v:1,run:host.id,type:'state',seq:99999,state:r.snapshot()},92);check('only host state accepted',client.lastSeq===before);\nconst b=host.run.players[1];b.m.place(...r.rooms.find(q=>q.kind==='baby').cell);r.reveal(b);host.api.emit('leave',{id:1});check('leave releases home and baby',\"'!b.active&&!b.carried&&r.homes.every(h=>h.seat!==1));\nhost.api.emit('\"'time-up',{graceMs:1000});host.api.emit('time-up',{graceMs:1000});check('only host finishes once on time-up',host.api.finishes===1&&host.api.result.won===false);\nconst sentBefore=n.sent.length;for(const x of n.copies)x.api.emit('end',{reason:'finished'});for(let i=0;i<120;i++)n.tick();check('end stops outgoing traffic',n.sent.length===sentBefore);\n// Dedicated host and packet recovery exercise real serialized messages through the same adapter.\nlet reports=[];\nfor(const opts of [{server:true,seed:9,loss:0,latency:0},{server:true,seed:9,loss:.05,latency:.15}]){\n const w=network(opts);w.start();const seenFloors=new Set();for(let i=0;i<120*1400&&\"'!w.host.finished;i++){w.tick();seenFloors.add(w.host.run.floor);}for(let i=0;i<60;i++)w.tick();\n const r=w.host.run;reports.push({opts,phase:r.phase,rescued:r.rescued,lives:r.lives,seconds:r.elapsed,stats:r.stats,snapshots:w.host.snapSeq});\n check('\"'dedicated synchronized campaign '+opts.loss,r.phase==='won'&&r.rescued===26&&seenFloors.size===5);\n check('all clients recover complete objective state '+opts.loss,w.copies.every(n=>n.state.rescued===r.rescued&&n.state.score===r.score&&n.state.floor===r.floor));\n check('only dedicated host reports result '+opts.loss,w.copies.filter(n=>n.api.finishes).length===1&&w.host.api.finishes===1);\n check('network payload within 16 KB '+opts.loss,w.sent.every(s=>s.size<=16384));\n check('bounded message cadence '+opts.loss,w.sent.every((s,i)=>w.sent.filter(t=>t.id===s.id&&t.at>=s.at&&t.at<s.at+1).length<=20));\n}\nfs.writeFileSync('build/network-campaign-evidence.json',JSON.stringify(reports,null,2));console.log(JSON.stringify({count,failures}));process.exitCode=failures.length?1:0;\nJS\npython3 - <<'PY'\np='tools/verify.mjs';s=open(p).read().replace(\\\"if(suites.includes('tuning'))\\\", \\\"if(\"'!suites.length||suites.includes('\"'network'))jobs.push(['node',['tests/network.mjs']]);\\\\nif(suites.includes('tuning'))\\\");open(p,'w').write(s)\nPY\nnpm run verify -- rules network browser\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
