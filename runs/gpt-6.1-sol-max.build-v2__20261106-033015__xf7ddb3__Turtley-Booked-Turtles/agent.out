{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"cat > tests/tuning.mjs <<'JS'\nimport vm from 'node:vm';import fs from 'node:fs';const c=vm.createContext({console});for(const f of ['vendor/engine/my-3d2dge.js','src/content.js','src/sim.js'])vm.runInContext(fs.readFileSync(f,'utf8'),c);const evidence=[];let count=0,failures=[];\nfor(const seats of [[0],[0,1]]){let success=false;for(let seed=1;seed<=25;seed++){const r=new c.TB.Run({seats,seed}),bot=new c.TB.Bot;for(let i=0;i<120*1000&&\"'!['\"'won','lost'].includes(r.phase);i++)r.step(1/120,bot.inputs(r));evidence.push({seats:seats.length,seed,phase:r.phase,rescued:r.rescued,t:r.elapsed,stats:r.stats});if(r.phase==='won'){success=true;break;}}count++;if(\"'!success)failures.push('\"'No complete campaign for '+seats.length+' seats');}\nfs.writeFileSync('build/tuning-evidence.json',JSON.stringify(evidence,null,2));console.log(JSON.stringify({count,failures}));process.exitCode=failures.length?1:0;\nJS\npython3 - <<'PY'\np='tools/verify.mjs';s=open(p).read().replace(\\\"if(suites.includes('hub'))\\\", \\\"if(suites.includes('tuning'))jobs.push(['node',['tests/tuning.mjs']]);\\\\nif(suites.includes('hub'))\\\");open(p,'w').write(s)\nPY\nnpm run verify -- tuning\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
