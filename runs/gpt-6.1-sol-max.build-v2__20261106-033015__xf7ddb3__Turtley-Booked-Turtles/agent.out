{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '225,365p' vendor/engine/kits/arcade.js && sed -n '311,319p' vendor/engine/AI_GUIDE.md && sed -n '12462,12574p' vendor/engine/my-3d2dge.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '225,365p' vendor/engine/kits/arcade.js && sed -n '311,319p' vendor/engine/AI_GUIDE.md && sed -n '12462,12574p' vendor/engine/my-3d2dge.js\"","aggregated_output":"  const MAZE = (() => {\n    const C8 = 8, MW = 29, MH = 31, TUN = 17, HX = 10, HY = 11, DOOR = [14, 10], WCOL = ['#ff4a4a', '#ff9ad8', '#4ae8ff', '#ffb84a'];\n    const CORNER = [[MW - 2, -3], [1, -3], [MW - 1, MH], [0, MH]], PHASES = [7, 20, 7, 20, 5, 20, 5, 1e9], WAYS = [[0, -1], [-1, 0], [0, 1], [1, 0]];   // (up, left, down, right: the original's order for ties)\n    let cells, grid, wgrid, start, seeds, power, hero = null, wisps = null, mode, modeT, phase, fright, eaten, level, cab, demo, over, deathT, readyT, inter, berry, ate, X0 = 0, Y0 = 12;\n    const key = (x, y) => x + ',' + y, cellOf = k => k.split(',').map(Number);\n    const nearest = (x, y, ok) => { let best = [x, y], bd = 1e9; for (let b = 0; b < MH; b++) for (let a = 0; a < MW; a++) if (ok(a, b)) { const d = Math.abs(a - x) + Math.abs(b - y); if (d < bd) { bd = d; best = [a, b]; } } return best; };\n    const ring = (x, y) => y >= HY - 1 && y <= HY + 5 && x >= HX - 1 && x <= HX + 9;\n    // a new maze: the left half from E.gen's braided maze, mirrored; doors in the middle wall; the wisps' house in a ring\n    // of hall; the tunnel's ends opened. The same level gives the same maze\n    function build() {\n      const half = E.gen.maze(15, MH, { seed: 7 + level * 13, braid: 1 }).rows;\n      cells = half.map(r => (r + r.slice(0, 14).split('').reverse().join('')).split(''));\n      for (let y = 1; y < MH - 1; y += 4) if (cells[y][13] === '.') cells[y][14] = '.';\n      for (let y = HY - 1; y <= HY + 5; y++) for (let x = HX - 1; x <= HX + 9; x++) cells[y][x] = '.';\n      for (let y = HY; y <= HY + 4; y++) for (let x = HX; x <= HX + 8; x++) cells[y][x] = y === HY || y === HY + 4 || x === HX || x === HX + 8 ? '#' : 'H';\n      cells[HY][14] = '-'; cells[TUN][0] = cells[TUN][MW - 1] = '.';\n      grid = new E.Grid(MW, MH, { walkable: (x, y) => cells[y][x] === '.' });       // yours\n      wgrid = new E.Grid(MW, MH, { walkable: (x, y) => cells[y][x] !== '#' });      // the wisps' (the house too: openFor says when)\n      start = nearest(14, 23, (x, y) => cells[y][x] === '.' && !ring(x, y));\n      seeds = new Set(); power = new Set(); ate = 0; berry = null;\n      for (let y = 0; y < MH; y++) for (let x = 1; x < MW - 1; x++) if (cells[y][x] === '.' && !ring(x, y) && !(x === start[0] && y === start[1])) seeds.add(key(x, y));\n      for (const [x, y] of [[1, 3], [MW - 2, 3], [1, MH - 4], [MW - 2, MH - 4]]) { const k = key(...nearest(x, y, (a, b) => seeds.has(key(a, b)))); seeds.delete(k); power.add(k); }\n    }\n    // everyone to their places: you below the house, the first wisp at its door, the others inside waiting their turn\n    function reset() {\n      hero = { m: new E.GridMover({ cx: start[0], cy: start[1], speed: 7.5 }), dir: [-1, 0], chomp: 0, dying: 0 };\n      hero.m.dir = [-1, 0];\n      const was = wisps;\n      wisps = WCOL.map((c, i) => ({ i, c, m: new E.GridMover({ cx: i ? 10 + i * 2 : DOOR[0], cy: i ? HY + 2 : DOOR[1], speed: 6.8 }), home: i > 0, wait: i * 2.5, eyes: false, leaving: false, blue: false,\n        rig: was ? was[i].rig : new E.Blob({ R: 3.6, face: 'front', colors: { dk: E.shade(c, -.35), base: c, lt: E.shade(c, .35) } }) }));\n      for (const w of wisps) w.m.dir = [w.i % 2 ? 1 : -1, 0];\n      mode = 'scatter'; modeT = 0; phase = 0; fright = 0; eaten = 0; readyT = 1.8; deathT = 0;\n    }\n    // where each aims while chasing: at you; four cells ahead of you; past a point two ahead, as far again as the first wisp\n    // is behind it (they pincer); at you from afar, its corner up close. Scattering: its corner. Eyes and leavers: the door\n    function target(w) {\n      if (w.eyes || w.leaving) return DOOR;\n      if (mode === 'scatter') return CORNER[w.i];\n      const h = hero.m, [dx, dy] = hero.dir;\n      if (w.i === 0) return [h.cx, h.cy];\n      if (w.i === 1) return [h.cx + dx * 4, h.cy + dy * 4];\n      if (w.i === 2) { const a = wisps[0].m; return [(h.cx + dx * 2) * 2 - a.cx, (h.cy + dy * 2) * 2 - a.cy]; }\n      return Math.hypot(w.m.cx - h.cx, w.m.cy - h.cy) > 8 ? [h.cx, h.cy] : CORNER[3];\n    }\n    const openFor = (w, x, y) => { if (x < 0 || x >= MW) return y === TUN; const c = cells[y] && cells[y][x]; return c === '.' || ((c === 'H' || c === '-') && (w.eyes || w.leaving)); };\n    // at each cell a wisp takes the open way (never straight back) nearest its target; blue, a random one; eyes, the\n    // grid's path home\n    function choose(w) {\n      const m = w.m;\n      if (w.eyes) { const p = grid.path([m.cx, m.cy], DOOR); if (p.length > 1) return [p[1][0] - m.cx, p[1][1] - m.cy]; }\n      const ways = WAYS.filter(([a, b]) => !(a === -m.dir[0] && b === -m.dir[1]) && openFor(w, m.cx + a, m.cy + b));\n      if (!ways.length) return [-m.dir[0], -m.dir[1]];\n      if (w.blue) return ways[Math.floor(Math.random() * ways.length)];\n      const t = target(w), d = c => (m.cx + c[0] - t[0]) ** 2 + (m.cy + c[1] - t[1]) ** 2;\n      return ways.reduce((p, q) => d(q) < d(p) ? q : p);\n    }\n    // the tunnel: off one end, on at the other, going the same way\n    function wrapTunnel(m) { if (m.cy !== TUN || m.moving) return; if (m.cx === 0 && m.dir[0] < 0) { m.place(MW - 1, TUN); m.dir = [-1, 0]; } else if (m.cx === MW - 1 && m.dir[0] > 0) { m.place(0, TUN); m.dir = [1, 0]; } }\n    const dirOf = v => Math.hypot(v[0], v[1]) < .4 ? null : Math.abs(v[0]) > Math.abs(v[1]) ? [Math.sign(v[0]), 0] : [0, Math.sign(v[1])];\n    const pos = m => ({ x: X0 + (m.x + .5) * C8, y: Y0 + (m.y + .5) * C8 });\n    function step(dt, I) {\n      if (inter) return;   // (the intermission is a script: it moves its own actors)\n      if (readyT > 0) { readyT -= dt; return; }\n      const h = hero.m;\n      if (deathT > 0) { hero.dying = deathT; if ((deathT -= dt) <= 0) lost(); return; }\n      if (fright > 0) { if ((fright -= dt) <= 0) for (const w of wisps) w.blue = false; }\n      else if ((modeT += dt) > PHASES[phase]) { modeT = 0; phase = Math.min(PHASES.length - 1, phase + 1); mode = phase % 2 ? 'chase' : 'scatter'; }\n      // you: the stick's way, kept until it can be taken (a turn asked early), going on until a wall\n      h.update(dt, grid, demo ? botDir() : dirOf(I.move()), { keep: true });\n      if (h.moving) hero.dir = h.dir;\n      wrapTunnel(h); hero.chomp = Math.max(0, hero.chomp - dt);\n      const k = key(h.cx, h.cy);\n      if (seeds.delete(k)) { cab.add(10); ate++; hero.chomp = .25; A.sfx('blip', { vol: .25, pitch: ate % 2 ? 1 : 1.2 }); if (ate === 70 || ate === 170) berry = { t: 9 }; }\n      if (power.delete(k)) { cab.add(50); fright = Math.max(1.5, 7 - level); eaten = 0; for (const w of wisps) w.blue = !w.eyes; A.sfx('powerup'); P.ring(pos(h).x, pos(h).y, 2, 30, '#ffd060', .4); }\n      if (berry && (berry.t -= dt) <= 0) berry = null;\n      if (berry && h.cx === 14 && h.cy === TUN) { cab.add(100 * level, pos(h)); berry = null; A.sfx('pickup'); P.glints(pos(h).x, pos(h).y, 4, 6, '#ff8a8a'); }\n      for (const w of wisps) {\n        const m = w.m;\n        if (w.home) { if ((w.wait -= dt) > 0) { m.y = HY + 2 + Math.sin(game.time * 6 + w.i) * .3; continue; } w.home = false; w.leaving = true; m.y = m.cy; }\n        m.speed = w.eyes ? 15 : w.blue ? 4.2 : m.cy === TUN && (m.cx < 5 || m.cx > MW - 6) ? 4 : 6.6 + level * .25;\n        m.update(dt, wgrid, m.moving ? null : choose(w), { blocked: (x, y) => !openFor(w, x, y) });\n        wrapTunnel(m);\n        if (!m.moving && m.cx === DOOR[0] && m.cy === DOOR[1]) { w.leaving = false; if (w.eyes) { w.eyes = false; w.blue = false; } }\n        if (!w.eyes && Math.abs(m.x - h.x) + Math.abs(m.y - h.y) < .8) {\n          if (w.blue) { w.eyes = true; w.blue = false; eaten++; cab.add(200 * 2 ** (eaten - 1), pos(m)); A.sfx('kick'); game.freeze(.3); P.sparks(pos(m).x, pos(m).y, 2, 8); }\n          else { deathT = 1.5; A.sfx('die'); return; }\n        }\n      }\n      if (!seeds.size && !power.size) { level++; cab.card('MAZE ' + level, 2); A.sfx('oneup'); if (level === 2 && !demo) intermission(); build(); reset(); readyT = 2.2; }\n    }\n    // after the death's turn: a life gone; the other player's maze (two players, each keeps theirs), or the end\n    function lost() {\n      const was = cab.p, r = cab.die();\n      if (r === 'over') { over = true; return; }\n      if (r === 'next') { was.save = { level, seeds, power, ate }; const s = cab.p.save; level = s ? s.level : 1; build(); if (s) ({ seeds, power, ate } = s); }\n      reset();\n    }\n    // the intermission (a script): a wisp chases you across, then you come back big and chase it\n    function intermission() {\n      const a = { x: -30, big: false }; inter = a;\n      game.script(function* () { yield game.tween(a, { x: MW * C8 + 40 }, 2.6, { ease: 'linear' }); a.big = true; yield .4; yield game.tween(a, { x: -60 }, 2.2, { ease: 'linear' }); yield .3; inter = null; });\n    }\n    // the demo's player (the attract mode, and tools/kits-test.mjs): it counts the steps to every cell, its own and the\n    // wisps' (breadth first, through the tunnel); a cell is safe when it gets there two steps before any of them. It goes\n    // the safe way to the nearest seed (a lantern when they close in, a blue wisp while there is time), else to the\n    // neighbour they reach last\n    function steps(from, ok) {\n      const D = new Map(), up = new Map(); let q = [];\n      for (const [c, d] of from) { const k = key(...c); if (!D.has(k) || D.get(k) > d) { D.set(k, d); q.push(c); } }\n      while (q.length) {\n        const n = [];\n        for (const c of q) { const d = D.get(key(...c)); for (const [a, b] of WAYS) { let x = c[0] + a; const y = c[1] + b; if (y === TUN) x = (x + MW) % MW; const k = key(x, y); if (!grid.walk([x, y]) || D.has(k) || (ok && !ok(x, y, d + 1))) continue; D.set(k, d + 1); up.set(k, c); n.push([x, y]); } }\n        q = n;\n      }\n      return { D, up };\n    }\n    function botDir() {\n      const h = hero.m; if (h.moving) return null;\n      const src = [];\n      for (const w of wisps) {\n        if (w.eyes || w.blue) continue;\n        if (w.home || w.leaving) { if (!w.home || w.wait < 2) src.push([DOOR, w.home ? 3 : 1]); continue; }\n        src.push([[w.m.cx, w.m.cy], 0]); const n = [w.m.cx + w.m.dir[0], w.m.cy + w.m.dir[1]]; if (grid.walk(n)) src.push([n, 0]);\n      }\n      const W = steps(src).D, wd = (x, y) => W.has(key(x, y)) ? W.get(key(x, y)) : 99, safe = (x, y, d) => d + 2 < wd(x, y);\n      const S = steps([[[h.cx, h.cy], 0]], safe), near = wd(h.cx, h.cy) < 7;\n      const goals = fright > 2.5 && wisps.some(w => w.blue) ? wisps.filter(w => w.blue).map(w => key(w.m.cx, w.m.cy)) : near && [...power].some(k => S.D.has(k)) ? [...power] : [...seeds, ...power];\n      let best = null, bd = 1e9; for (const k of goals) { const d = S.D.get(k); if (d > 0 && d < bd) { bd = d; best = k; } }\n      if (best) { let c = cellOf(best), p; while ((p = S.up.get(key(...c))) && !(p[0] === h.cx && p[1] === h.cy)) c = p; return [Math.sign(E.wrapDiff(h.cx, c[0], MW)), c[1] - h.cy]; }\n      let far = null, fd = -1;\n      for (const [a, b] of WAYS) { let x = h.cx + a; if (h.cy === TUN) x = (x + MW) % MW; if (grid.walk([x, h.cy + b]) && wd(x, h.cy + b) > fd) { fd = wd(x, h.cy + b); far = [a, b]; } }\n      return far;\n    }\n    function layout() { X0 = Math.round((game.W - MW * C8) / 2); Y0 = Math.max(12, Math.round((game.H - MH * C8) / 2)); }\n    function draw(r) {\n      layout(); const cl = classic(), t = game.time, [ox, oy] = r.w(0, 0), bx = ox + X0, by = oy + Y0;\n      r.sky(cl ? ['#000000', '#000000'] : ['#04030c', '#0a0820', '#120a28']);\n      // the maze on the floor (lit in the remaster: hedges with a sunlit top edge and a shadow at the foot; the classic's\n      // thin blue lines facing the halls)\n      r.decal(g => {\n        const wall = (x, y) => !!cells[y] && cells[y][x] === '#';\n### Shell (an HTML interface: screens and HUD)\nA modern adaptation (Assassin's Creed, Breath of the Wild) wants readable HTML screens over the pixel world, not pixel windows. `E.Shell` builds them from data, so you write none of the HTML, CSS or focus handling. It shows the game's state and holds none of it: you pass values in each step and callbacks for the buttons. The STEALTH slice (`src/starter/70-stealth.js`: the objective, health, status, the takedown prompt, toasts, the results) and the template game use it; copy from them.\n- `const ui = new E.Shell(game, { theme: { ink, paper, accent, muted, danger, line, font, titleFont }, settings: { items: [{ key: 'cones', label: 'Sight cones', value: true }], onChange(s, key) {} }, screens: { pause: {...}, help: {...} } })`. It takes over from the engine's own and keeps the standard menu (see Standard features). Your items join `game.settings` (`ui.settings` is the same object), saved and checked with the rest; `onChange` hears every change.\n- Screens: `ui.show(name, spec)`, `ui.back()`, `ui.hide()`, `ui.screen` (the open one's name, or null). Every spec takes `kicker`, `title`, `text` (strings or functions), `actions: [[label, fn], { label, act, primary, disabled }]` (falsy entries are skipped, so `cond && [...]` works; `act` taps an input action) and `back`. Then: `'title'` (`name`, `subtitle`, `meta`, `footer`), `'pause'` (Resume first, then your actions, then Settings, Controls, Full screen, Help and Quit to title; it opens while `game.paused` and Resume unpauses; `screens: { pause: false }` leaves it out), `'settings'`, `'controls'`, `'help'` (`keys: [[key, what]]`, `sections: [[heading, text]]`), `'results'` (`emblem`, `stats: [[value, label]]`, `medals: [[label, earned]]`) and `'map'` (`map`, `at`, `markers`, `labels`, `onPick(x, y)` for a waypoint). A screen opened from another stacks; cancel goes back.\n- The HUD, each step: `ui.hud({ objective: { step, title, text, at, from }, status, bars: [{ label, value, max, kind: 'pips' | 'bar', color }], counts: [[label, value]], prompt: { key, label, hint, progress }, tip, place, keys, buttons: [[label, fn]], minimap: { map, at, markers, onClick } })`. A piece left out is hidden, only what changed is redrawn, and the HUD hides while a screen is open. `objective` shows the distance in meters (`meters: .125` a world unit) and whether the target is above or below. `ui.toast(title, text, seconds)` and `ui.tutorial(title, text, seconds)` come and go on their own.\n- Input: the game's own input moves the focus (keys, d-pad, stick: up / down / left / right, a slider or a choice turns left and right), confirm presses, cancel goes back, pause closes the menu; touch taps. While a screen is open the game's actions are held back, so a menu press doesn't also attack. Touch players reach the menu with the touch START or the corner's button; `buttons: [['Map', openMap]]` adds your own.\n- It honors reduced motion and the safe-area insets, is headless-safe (it keeps its screens' names and draws nothing), and `game.dispose()` takes it away.\n\n### Lighting\nclass GridMover {\n  /** new E.GridMover({ cx, cy, speed: 6 (cells a second) }) */\n  constructor(o = {}) {\n    /** cx, cy: the cell it is in (or leaving); x, y: its smooth position in cells (draw it there); speed: cells a second;\n     *  dir: [dx, dy] it is moving (or last moved); moving: between cells; arrived: true the step it reaches a cell */\n    this.cx = o.cx || 0; this.cy = o.cy || 0; this.x = this.cx; this.y = this.cy; this.speed = o.speed || 6; this.dir = [0, 0]; this.moving = false; this.arrived = false;\n    this._want = null; this._to = null; this._u = 0;\n  }\n  /** a step of dt: want ([dx, dy] or null) is kept until it can be taken. o: { blocked(cx, cy): true where it can't go,\n   *  push(cx, cy, dx, dy): true when what is in the way moved (a crate), keep: true goes on in the same direction (a\n   *  maze) }. Returns true when it reached a cell this step */\n  update(dt, grid, want, o = {}) {\n    if (want && (want[0] || want[1])) this._want = want;\n    this.arrived = false; let t = dt * this.speed;\n    for (let guard = 0; guard < 8 && t > 0; guard++) {\n      if (!this.moving) {\n        const tryDir = d => { if (!d) return false; const n = [this.cx + d[0], this.cy + d[1]]; if (!grid.walk(n)) return false; if (o.blocked && o.blocked(n[0], n[1]) && !(o.push && o.push(n[0], n[1], d[0], d[1]))) return false; this._to = n; this.dir = d; this.moving = true; this._u = 0; return true; };\n        if (tryDir(this._want)) this._want = o.keep ? this._want : null; else if (!(o.keep && tryDir(this.dir))) break;\n      }\n      const left = 1 - this._u, step = Math.min(left, t); this._u += step; t -= step;\n      this.x = this.cx + (this._to[0] - this.cx) * this._u; this.y = this.cy + (this._to[1] - this.cy) * this._u;\n      if (this._u >= 1 - 1e-9) { [this.cx, this.cy] = this._to; this.x = this.cx; this.y = this.cy; this.moving = false; this.arrived = true; if (!o.keep && !this._want) break; }\n    }\n    return this.arrived;\n  }\n  /** put it on a cell at once, still */\n  place(cx, cy) { this.cx = this.x = cx; this.cy = this.y = cy; this.moving = false; this._want = null; }\n}\nE.GridMover = GridMover;\n\n/* =============================================================================\n * TURNS  who acts next: by speed (energy), by charge time, by phase, or by ATB gauges on game time\n * ========================================================================== */\nclass Turns {\n  /** new E.Turns(actors, { mode: 'speed' | 'ct' | 'phase' | 'atb', sides: ['hero', 'foe'] (phase), fill: 1 (atb: gauge\n   *  per second at speed 100) }). An actor is any object with speed (100: normal) and, in phase mode, side */\n  constructor(actors = [], o = {}) {\n    /** actors: in the order they were added (ties go to the earlier); mode: 'speed', 'ct', 'phase' or 'atb'; sides: the\n     *  sides in their order (phase; null: as the actors have them); fill: an atb gauge's fill a second at speed 100;\n     *  phase: the side acting now (phase mode) */\n    this.actors = actors.slice(); this.mode = o.mode || 'speed'; this.sides = o.sides || null; this.fill = o.fill || 1; this.phase = null; this._left = [];\n    for (const a of this.actors) this._init(a);\n  }\n  _init(a) { if (a._turn === undefined) a._turn = 0; }\n  /** add an actor (it starts with an empty gauge) */\n  add(a) { this._init(a); this.actors.push(a); }\n  /** take an actor out (it died, it left) */\n  remove(a) { const i = this.actors.indexOf(a); if (i >= 0) this.actors.splice(i, 1); this._left = this._left.filter(x => x !== a); }\n  // the speed and ct modes: fill every gauge until one is full; returns it\n  _tick(A, take) {\n    if (!A.length) return null;\n    for (let guard = 0; guard < 1e5; guard++) {\n      let best = null; for (const a of A) if (a._turn >= 100 && (!best || a._turn > best._turn)) best = a;\n      if (best) { if (take) best._turn -= 100; return best; }\n      for (const a of A) a._turn += Math.max(1, a.speed === undefined ? 100 : a.speed) / 10;\n    }\n    return null;\n  }\n  /** the actor whose turn it is (speed: its energy spent; ct: call done(actor, cost) after it acts; phase: each of the\n   *  side once, then the next side's) */\n  next() {\n    if (this.mode === 'phase') {\n      if (!this._left.length) {\n        const sides = this.sides || [...new Set(this.actors.map(a => a.side))]; if (!sides.length) return null;\n        let i = this.phase === null ? 0 : (sides.indexOf(this.phase) + 1) % sides.length;\n        for (let k = 0; k < sides.length && !this._left.length; k++, i = (i + 1) % sides.length) { this.phase = sides[i]; this._left = this.actors.filter(a => a.side === this.phase); }\n      }\n      return this._left.shift() || null;\n    }\n    return this._tick(this.actors, this.mode === 'speed');\n  }\n  /** who acts next, n of them, without changing anything (speed and ct: the order ahead; phase: the rest of this side) */\n  order(n = 5) {\n    if (this.mode === 'phase') return this._left.slice(0, n);\n    const copy = this.actors.map(a => ({ a, speed: a.speed, _turn: a._turn })), out = [];\n    for (let i = 0; i < n; i++) { const b = this._tick(copy, true); if (!b) break; out.push(b.a); }\n    return out;\n  }\n  /** after an actor acted (ct: cost 100 for a move and an action, 80 or 60 for less; atb: its gauge empties) */\n  done(a, cost = 100) { if (this.mode === 'ct') a._turn -= cost; else if (this.mode === 'atb') a._turn = 0; }\n  /** atb: fill the gauges on game time (dt seconds) */\n  update(dt) { if (this.mode === 'atb') for (const a of this.actors) a._turn = Math.min(100, a._turn + (a.speed === undefined ? 100 : a.speed) * this.fill * dt); }\n  /** atb: the actors whose gauges are full, in the order they were added */\n  ready() { return this.actors.filter(a => a._turn >= 100); }\n  /** an actor's gauge 0..1 (atb and ct: how full; speed: its energy) */\n  gauge(a) { return Math.max(0, Math.min(1, (a._turn || 0) / 100)); }\n}\nE.Turns = Turns;\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);\n\n/*!\nmy-3D2dge module MODE7 v0.89.1: a perspective floor drawn a row at a time, a sky that turns with it, everything on it scaled by its distance\nhttps://github.com/michaelcrosato/my-3d2dge (MIT License)\nLoads after: the full engine or the agent edition. Needs: no other module.\n\nSuper Mario Kart's, F-Zero's and Pilotwings' view (the SNES's Mode 7): a camera at a height over a flat floor, looking\nalong a heading, pitched down; the floor drawn a screen row at a time, the sky above the horizon, and on the floor\nbillboards (rigs drawn at the size their distance gives, sprites, your own drawing) far to near.\n- const m7 = new E.Mode7({ floor: a TileMap (its floorTex) | (x, y) => [r, g, b] | a canvas (a texel a unit), size:\n  [w, h] (the floor in world units, for a function), outside: '#24402a' (beyond the floor) | wrap: true (it repeats),\n  sky: a Backdrop (full engine) | ['#top', '#bottom'], fog: { color, near, far } (far: nothing past it), far: 2400 }).\n- m7.cam = { x, y, h: 40 (height), angle: 0 (the heading, as E.angleTo gives it: 0 east, PI / 2 south; keep it\n  unwrapped, the sky turns with it), pitch: 12 (degrees down), fov: 70 (degrees across the height) };\n  m7.chase(body, { back: 56, h: 34, angle }) puts it behind a body (body.angle, or angle) each step.\n- In draw: m7.rig(rig, x, y, z), m7.sprite(spr or E.anim, x, y, z, { scale, flip, t }), m7.shape(id, x, y, z, { facing,\n  size, params, mats }) (full engine), m7.add(x, y, z, (g, sx, sy, k) => ...) gather billboards (k: screen pixels per world\n  unit there); m7.draw(r, cam) draws sky, floor, fog and them, far to near, as an overlay (in a split screen, in\n  r.viewport: give each player's cam). A billboard is flat, at its foot's scale: hit-test the box it was drawn in (from\n  m7.project and its size), not the world's view of it.\n- m7.project(x, y, z) -> [sx, sy, k] on the screen, or null behind the camera; m7.toFloor(sx, sy) -> [x, y], or null\n  above the horizon (both for the camera last drawn: HUD markers, a tap on the track). m7.horizon: its screen row.\n- Your own pass: m7.begin({ W, H, x, y, cx, cy, focal }, cam), then project, rowDepth(sy), drawFloor(g, rect),\n  view(k) (the engine view a rig is drawn with at k).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '297,319p' vendor/engine/AI_GUIDE.md && sed -n '3070,3165p' vendor/engine/my-3d2dge.js && sed -n '9400,9505p' vendor/engine/my-3d2dge.js && sed -n '9550,9675p' vendor/engine/my-3d2dge.js && sed -n '1,110p' vendor/engine/modules/arcade.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '297,319p' vendor/engine/AI_GUIDE.md && sed -n '3070,3165p' vendor/engine/my-3d2dge.js && sed -n '9400,9505p' vendor/engine/my-3d2dge.js && sed -n '9550,9675p' vendor/engine/my-3d2dge.js && sed -n '1,110p' vendor/engine/modules/arcade.js\"","aggregated_output":"### Audio\n- Browsers start sound only after the first key press or click; the engine waits for it.\n- `sfx(name)` ignores the same sound fired twice in 35 ms, and varies the pitch slightly so repeats don't sound robotic.\n- `music(song)` loops tracks of its own step notation. Every track loops on its own length, so short drum or bass loops can run under long melodies.\n- Built-in songs: `title`, `adventure`, `dungeon`, `boss`, `victory` (plays once). The songs module's songbook has more by mood (`E.Songbook.find('town')`) and jingles.\n- The music clock (the full engine): a song's place is game time (`audio.pos`), not the sound's, so beats land on the same update step headless and on any device, and the sound is held to that clock (it moves its notes to meet it). Time gameplay to `audio.pos`, `audio.at(step, fn)` and `audio.onBeat(fn)`, never to the sound. A song with `sync: true` pauses with the game.\n- Dynamic music: one song in layers rather than cuts. Name the tracks, start the extra ones with `on: false`, and bring them in with `audio.layer('drums', 1, .5)` (the stealth slice's chase); `audio.tempo(bpm)` for a hurry-up; `audio.sting(song, { at: 'bar' })` for a jingle on the next bar; `music(song, { fade: 1 })` to crossfade.\n\n### Text and UI\n- `E.font` is a 5x7 proportional pixel font with lower case (the old 3x5 font is `font: 'tiny'`), with `scale`, `align`, `wrap`, outline, drop `shadow` and `gradient`; `E.font.title` draws extruded gradient logos.\n- `E.ui.box/bar/hearts` draw classic windows and meters inside `r.overlay`.\n- `Dialog` does typewriter text with blips, pages, speaker names and choices; `update` returns true while it is open, so the world waits. Its markup gives a word its color (`{c=#ffd36a}gold{/c}`), a beat before the next line (`{w=.5}`), a slow dread (`{s=12}...{/s}`), a scream that shakes (`{shake}`) or a song that bobs (`{wave}`), and the hero's name (`{$name}` from `vars`).\n- `Menu` handles up and down with key repeat, confirm, cancel and disabled items.\n\n### Shell (an HTML interface: screens and HUD)\nA modern adaptation (Assassin's Creed, Breath of the Wild) wants readable HTML screens over the pixel world, not pixel windows. `E.Shell` builds them from data, so you write none of the HTML, CSS or focus handling. It shows the game's state and holds none of it: you pass values in each step and callbacks for the buttons. The STEALTH slice (`src/starter/70-stealth.js`: the objective, health, status, the takedown prompt, toasts, the results) and the template game use it; copy from them.\n- `const ui = new E.Shell(game, { theme: { ink, paper, accent, muted, danger, line, font, titleFont }, settings: { items: [{ key: 'cones', label: 'Sight cones', value: true }], onChange(s, key) {} }, screens: { pause: {...}, help: {...} } })`. It takes over from the engine's own and keeps the standard menu (see Standard features). Your items join `game.settings` (`ui.settings` is the same object), saved and checked with the rest; `onChange` hears every change.\n- Screens: `ui.show(name, spec)`, `ui.back()`, `ui.hide()`, `ui.screen` (the open one's name, or null). Every spec takes `kicker`, `title`, `text` (strings or functions), `actions: [[label, fn], { label, act, primary, disabled }]` (falsy entries are skipped, so `cond && [...]` works; `act` taps an input action) and `back`. Then: `'title'` (`name`, `subtitle`, `meta`, `footer`), `'pause'` (Resume first, then your actions, then Settings, Controls, Full screen, Help and Quit to title; it opens while `game.paused` and Resume unpauses; `screens: { pause: false }` leaves it out), `'settings'`, `'controls'`, `'help'` (`keys: [[key, what]]`, `sections: [[heading, text]]`), `'results'` (`emblem`, `stats: [[value, label]]`, `medals: [[label, earned]]`) and `'map'` (`map`, `at`, `markers`, `labels`, `onPick(x, y)` for a waypoint). A screen opened from another stacks; cancel goes back.\n- The HUD, each step: `ui.hud({ objective: { step, title, text, at, from }, status, bars: [{ label, value, max, kind: 'pips' | 'bar', color }], counts: [[label, value]], prompt: { key, label, hint, progress }, tip, place, keys, buttons: [[label, fn]], minimap: { map, at, markers, onClick } })`. A piece left out is hidden, only what changed is redrawn, and the HUD hides while a screen is open. `objective` shows the distance in meters (`meters: .125` a world unit) and whether the target is above or below. `ui.toast(title, text, seconds)` and `ui.tutorial(title, text, seconds)` come and go on their own.\n- Input: the game's own input moves the focus (keys, d-pad, stick: up / down / left / right, a slider or a choice turns left and right), confirm presses, cancel goes back, pause closes the menu; touch taps. While a screen is open the game's actions are held back, so a menu press doesn't also attack. Touch players reach the menu with the touch START or the corner's button; `buttons: [['Map', openMap]]` adds your own.\n- It honors reduced motion and the safe-area insets, is headless-safe (it keeps its screens' names and draws nothing), and `game.dispose()` takes it away.\n\n### Lighting\n  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\n  touchOpacity: { group: 'Touch', label: 'Button opacity', type: 'slider', value: .8, min: .3, max: 1, step: .05, apply: g => g.input._touchSync() }\n};\n/** a value for a setting, checked: the value kept, or undefined when it can't be one */\nfunction settingValue(sp, v) {\n  if (sp.type === 'toggle') return typeof v === 'boolean' ? v : undefined;\n  if (sp.type === 'fullscreen') return v === true || v === false || v === null ? v : undefined;\n  if (sp.type === 'slider') return typeof v === 'number' && isFinite(v) ? clamp(v, sp.min === undefined ? 0 : sp.min, sp.max === undefined ? 1 : sp.max) : undefined;\n  if (sp.type === 'select') return (sp.options || []).some(o => (Array.isArray(o) ? o[0] : o) === v) ? v : undefined;\n  if (sp.type === 'bindings') {\n    if (!v || typeof v !== 'object' || Array.isArray(v)) return undefined;\n    const out = {};\n    for (const a in v) { const b = v[a]; if (!b || typeof b !== 'object') continue; const o = {}; for (const k of ['keys', 'pad']) if (Array.isArray(b[k])) o[k] = b[k].filter(c => typeof c === 'string' && BINDABLE.test(c) && padCode(c) === (k === 'pad')).slice(0, 4); out[a] = o; }\n    return out;\n  }\n  return v === undefined || typeof v === 'function' ? undefined : v;   // a type of the game's own: any JSON value\n}\nclass Settings {\n  /**\n   * game.settings: the player's choices, one property each (game.settings.volume), with the game's own (o.menu.settings)\n   * beside the standard ones (STANDARD_SETTINGS). Saved with E.store under 'settings:' + the game's id, with a version;\n   * on load every value is checked and a bad one falls back to its default. Where storage is blocked the game plays on\n   * with the defaults (saved: false)\n   */\n  constructor(game, own = []) {\n    const hide = (k, v) => Object.defineProperty(this, k, { value: v, writable: true });\n    hide('_g', game); hide('_specs', {}); hide('_saved', {}); hide('_key', 'settings:' + (game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game'));\n    hide('saved', true);\n    /** onChange(key, value): called after every change (E.Shell's settings.onChange goes through it) */\n    hide('onChange', null);\n    const raw = store.get(this._key, null);\n    hide('_raw', raw && typeof raw === 'object' && raw.values && typeof raw.values === 'object' ? raw.values : {});   // (a newer version's values are checked like the rest)\n    if (!(raw && raw.v >= 2) && this._raw.fullscreen === false) delete this._raw.fullscreen;\n    game.input._settings = this; game.input._onBindings = b => this.set('bindings', b);\n    for (const k in STANDARD_SETTINGS) if (!(game.o.touch === 'never' && STANDARD_SETTINGS[k].group === 'Touch')) this.define(Object.assign({ key: k }, STANDARD_SETTINGS[k]));   // (touch: 'never': no Touch group)\n    for (const sp of own) this.define(sp && !sp.label && Object.prototype.hasOwnProperty.call(STANDARD_SETTINGS, sp.key) ? Object.assign({ key: sp.key }, STANDARD_SETTINGS[sp.key], sp) : sp);   // (a standard key with no label: the game's fields over the standard ones; with a label it is the game's own)\n  }\n  /** add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value,\n   *  label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and\n   *  applied; it shows on the settings screen. Returns its value */\n  define(sp) {\n    if (!sp || !sp.key || typeof sp.key !== 'string') { warn('setting', 'a setting needs a key: { key: \"hints\", label: \"Hints\", value: true }'); return undefined; }\n    if (sp.key in Settings.prototype || sp.key === 'saved' || sp.key === 'onChange' || sp.key[0] === '_') { warn('setting:' + sp.key, 'a setting cannot be called \"' + sp.key + '\" (a name the settings object uses)'); return undefined; }\n    const s = Object.assign({ group: 'Game', type: sp.options ? 'select' : typeof sp.value === 'number' ? 'slider' : typeof sp.value === 'boolean' || sp.value === undefined ? 'toggle' : 'value' }, sp);\n    this._specs[s.key] = s;\n    const saved = settingValue(s, this._raw[s.key]);\n    if (saved !== undefined) this._saved[s.key] = saved;\n    this[s.key] = saved !== undefined ? saved : this.default(s.key);\n    this._apply(s.key);\n    return this[s.key];\n  }\n  /** a setting's default value */\n  default(key) { const s = this._specs[key]; if (!s) return undefined; const v = typeof s.value === 'function' ? s.value(this._g) : s.value; return v === undefined && s.type === 'toggle' ? false : v; }\n  /** the spec a setting was defined with (its label, type, range, options), or undefined */\n  spec(key) { return this._specs[key]; }\n  /** the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key */\n  keys(group) { return Object.keys(this._specs).filter(k => !group || this._specs[k].group === group); }\n  /** change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told.\n   *  Returns the value kept (the old one when v is not a valid value) */\n  set(key, v) {\n    const s = this._specs[key]; if (!s) { warn('setting:' + key, 'unknown setting \"' + key + '\". Settings: ' + this.keys().join(', ')); return undefined; }\n    const ok = settingValue(s, v); if (ok === undefined) return this[key];\n    this[key] = ok; this._saved[key] = ok; this._save(); this._apply(key);\n    if (this.onChange) try { this.onChange(key, ok); } catch (e) { this._g.fail('settings.onChange', e); }\n    return ok;\n  }\n  /** put a group's settings (or all of them) back to their defaults; a game's saves are not touched */\n  reset(group) {\n    for (const k of this.keys(group)) { if (k === 'fullscreen') continue; delete this._saved[k]; this[k] = this.default(k); this._apply(k); if (this.onChange) this.onChange(k, this[k]); }\n    this._save();\n  }\n  _apply(key) { const s = this._specs[key]; if (s && s.apply) try { s.apply(this._g, this[key]); } catch (e) { this._g.fail('setting \"' + key + '\"', e); } }\n  _save() {\n    if (this._g.headless) return;\n    this.saved = store.set(this._key, { v: SETTINGS_VERSION, values: this._saved });   // false when the last save failed (storage blocked or full: the choices last for this visit)\n    if (!this.saved) warn('settings:save', 'the settings could not be saved (storage is blocked or full): they last for this visit');\n  }\n}\nclass FullScreen {\n  /** game.fullscreen: the whole page full screen (the game, its menus and buttons), where the browser can */\n  constructor(game) {\n    /** game: the game it serves; failed: why the last request was refused (a message), or null */\n    this._game = game; this.failed = null;\n  }\n  /** true where this page can go full screen (not an iPhone, which has Add to Home Screen instead; not a frame\n   *  without permission; not headless) */\n  get supported() { if (this._game.headless) return false; const d = document, el = d.documentElement; return !!((d.fullscreenEnabled || d.webkitFullscreenEnabled) && (el.requestFullscreen || el.webkitRequestFullscreen)); }\n  /** true while the page is full screen */\n  get on() { return !this._game.headless && !!(document.fullscreenElement || document.webkitFullscreenElement); }\n  /** true when the page was opened from a home screen as an app (no browser bars: nothing to go full screen from) */\n  get standalone() { const Q = this._mq || (this._mq = {}), m = q => !!(window.matchMedia && (Q[q] || (Q[q] = matchMedia(q))).matches); return !this._game.headless && (m('(display-mode: standalone)') || (m('(display-mode: fullscreen)') && !this.on) || navigator.standalone === true); }   // (full screen from here matches display-mode: fullscreen too)\n  /** go full screen. Browsers allow it only from a tap, click or key press: call it from one (a button, the menu, a\n   *  key's update step). Returns a promise of whether it worked (a refusal is kept in failed and noted on screen, unless\n   *  quiet) */\n  enter(quiet) {\n    if (this.on || !this.supported) return Promise.resolve(this.on);\n.esh-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:10px;margin:16px 0 8px}.esh-stats b{display:block;font:600 24px var(--title)}\n.esh-stats small{color:var(--muted);font-size:10px;letter-spacing:.14em}.esh-med{display:inline-block;margin:6px 6px 0 0;padding:3px 9px;border-radius:12px;border:1px solid var(--accent);font-size:12px}.esh-med.off{opacity:.35;border-color:var(--muted)}\n.esh-sec{margin-top:14px}.esh-emb{font-size:34px;color:var(--accent);text-align:center}.esh-map{width:100%;margin-top:12px;border-radius:4px;cursor:crosshair;display:block}\n.esh-still,.esh-still *{transition:none!important;animation:none!important}@media (prefers-reduced-motion:reduce){.esh *{transition:none!important;animation:none!important}}\n.esh-cornered .esh-col{top:calc(var(--pt) + 50px)}.esh-sh button{min-height:44px}.esh-row{flex-wrap:wrap}.esh-row>span{flex:1 1 150px}.esh-row small{display:block;color:var(--muted);font-size:11px;line-height:1.3}\n.esh-ctl{display:flex;align-items:center;gap:8px}.esh output{min-width:46px;text-align:right;color:var(--muted);font-size:12px;font-variant-numeric:tabular-nums}\n.esh-sel{min-width:136px;text-align:center!important}.esh input[type=range]{height:30px}.esh-status{min-height:20px;margin-top:8px;color:var(--accent);font-size:12px}\n.esh-bind{display:grid;grid-template-columns:1fr minmax(92px,auto) minmax(92px,auto);gap:6px 10px;align-items:center;margin-top:8px}.esh-bind small{color:var(--muted);font-size:10px;letter-spacing:.14em;text-transform:uppercase;text-align:center}\n.esh-bind button{text-align:center;text-transform:none;letter-spacing:.02em;font-size:12px;padding:8px 10px}.esh-bind button.cap{outline:2px dashed var(--accent);outline-offset:2px}\n@keyframes esh-in{from{opacity:0}}`;\nconst SHELL_THEME = { ink: '#f1e8d6', paper: 'rgba(14,18,22,.86)', accent: '#d9b77c', muted: '#a49d8c', danger: '#e8836a', line: 'rgba(217,183,124,.3)', font: 'system-ui, sans-serif', titleFont: 'Georgia, serif' };\n/** the settings screen's groups, in order (the standard ones; a game's own are 'Game' unless they name another) */\nconst SHELL_GROUPS = ['Display', 'Sound', 'Comfort'];\n/** 'menuUp' -> 'Menu up': an action's name on the controls screen when the game gives none */\nconst actionName = a => { const t = String(a).replace(/([a-z])([A-Z0-9])/g, '$1 $2').replace(/[_-]+/g, ' ').toLowerCase(); return t.charAt(0).toUpperCase() + t.slice(1); };\nclass Shell {\n  /**\n   * new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings',\n   * meters: .125, standard: true }): an HTML interface over the game (see the section's header)\n   * - theme: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole\n   *   interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by\n   *   the window's width (14 px text at 875 px, up to 30 at 1,875)\n   * - screens: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n   * - settings: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max,\n   *   step, options, value } (kept in game.settings, beside the standard ones)\n   * - store, meters: store: where an older version saved them; meters: meters per world unit for distances\n   * - standard: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the\n   *   settings' groups)\n   */\n  constructor(game, o = {}) {\n    if (game.shell && game.shell._sys && !o.system) game.shell.dispose();   // the game's own shell takes over from the engine's\n    /** game: the game it is over; o: its options; root: its DOM element (null in a headless game) */\n    this._game = game; this._o = o; this.root = null; this._stack = []; this._keep = new Set(); this._held = new Set(); this._last = {};\n    this._sys = !!o.system; this._std = o.standard !== false && game.o.menu !== false;\n    const old = store.get(o.store || 'shell-settings', null) || {}, S = game.settings;   // (settings saved by an older version are kept)\n    for (const it of this._items()) if (!S.spec(it.key)) { if (S._raw[it.key] === undefined && old[it.key] !== undefined) S._raw[it.key] = old[it.key]; S.define(Object.assign({ group: 'Game' }, it)); }\n    for (const k of ['sound', 'volume', 'motion']) if (S._raw[k] === undefined && old[k] !== undefined && this._items().some(it => it.key === k)) S.set(k, old[k]);\n    if (o.settings && o.settings.onChange) S.onChange = k => o.settings.onChange(S, k);\n    game.shell = this;\n    if (!this._sys && this._pauseSpec()) game.pauseOverlay = false;\n    if (game.headless || typeof document === 'undefined') return;\n    // rebinding: the next key or mouse button goes to the action being bound (before the game's own listeners see it)\n    const signal = game._abort ? game._abort.signal : undefined;\n    addEventListener('keydown', e => { const c = this._cap; if (!c) return; e.preventDefault(); e.stopImmediatePropagation(); if (e.code === 'Escape') this._capEnd('Not changed.'); else if (c.device === 'keys' && !e.repeat) this._capBind(e.code); }, { capture: true, signal });\n    addEventListener('pointerdown', e => { const c = this._cap; if (!c || c.device !== 'keys' || e.pointerType !== 'mouse') return; e.preventDefault(); e.stopImmediatePropagation(); this._capBind('Mouse' + e.button); }, { capture: true, signal });\n    addEventListener('wheel', e => { const c = this._cap; if (!c || c.device !== 'keys' || !e.deltaY) return; e.preventDefault(); e.stopImmediatePropagation(); this._capBind(e.deltaY < 0 ? 'WheelUp' : 'WheelDown'); }, { capture: true, signal, passive: false });\n    if (!document.getElementById('esh-css')) { const st = document.createElement('style'); st.id = 'esh-css'; st.textContent = SHELL_CSS; document.head.appendChild(st); }\n    const r = this.root = this._el('div', 'esh' + (game._corner ? ' esh-cornered' : '')), th = Object.assign({}, SHELL_THEME, o.theme);   // (the top-right column starts below the corner's buttons)\n    for (const k in th) r.style.setProperty('--' + (k === 'titleFont' ? 'title' : k), th[k]);\n    if (th.font && /\\d|\\b(bold|italic|normal|oblique)\\b/.test(th.font)) warn('shell:font', 'E.Shell theme.font is a family (\"Georgia, serif\"), not a CSS shorthand (\"' + th.font + '\"): the size comes from theme.scale');\n    const K = th.scale !== undefined ? th.scale : o.tv ? () => clamp(innerWidth * .016, 18, 30) / 14 : 1;   // (for ten feet: the whole interface that many times, still filling the window)\n    if (K !== 1) { const fit = () => { const k = Math.max(.25, +(typeof K === 'function' ? K(window) : K) || 1); Object.assign(r.style, { transform: 'scale(' + k + ')', transformOrigin: '0 0', inset: 'auto', left: '0', top: '0', width: 100 / k + 'vw', height: 100 / k + 'vh' }); }; fit(); addEventListener('resize', fit, { signal }); }\n    const host = document.body; host.appendChild(r);\n    const E2 = (cls, parent = r, tag = 'div') => { const e = this._el(tag, cls); e.hidden = true; parent.appendChild(e); return e; };\n    const col = this._el('div', 'esh-col'); r.appendChild(col);\n    /** the HUD's elements, by piece (hb, obj, vit, toast, tut, pr, tip, place, mini, keys) and the screen layer (scr) */\n    this._els = { hb: E2('esh-hb', col), obj: E2('esh-obj esh-pan'), vit: E2('esh-vit esh-pan', col), place: E2('esh-place', col), tip: E2('esh-tip esh-pan'), pr: E2('esh-pr esh-pan'), keys: E2('esh-keys'),\n      tut: E2('esh-tut esh-pan'), mini: E2('esh-mini', r, 'canvas'), toast: E2('esh-toast esh-pan'), scr: this._el('div', '') };\n    r.appendChild(this._els.scr); this._els.toast.hidden = false;\n    const mini = this._els.mini; mini.width = 176; mini.height = 158;\n    mini.onclick = e => { const m = this._miniLast, X = mini._xf; if (!m || !m.onClick) return; const rc = mini.getBoundingClientRect(), u = (e.clientX - rc.left) * mini.width / (rc.width || 1), v = (e.clientY - rc.top) * mini.height / (rc.height || 1); m.onClick(X ? (u - X.ox) / X.k : 0, X ? (v - X.oy) / X.k : 0); };   // (the world point clicked: a 