{"type":"item.completed","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='tests/network.mjs';s=open(p).read().replace(\\\"[{server:true,seed:9,loss:0,latency:0},{server:true,seed:9,loss:.05,latency:.15}]\\\", \\\"[{server:true,seed:1,loss:0,latency:0},{server:true,seed:9,loss:.05,latency:.15}]\\\");open(p,'w').write(s)\np='tests/devices.py';s=open(p).read().replace(\\\"{'type':'touchEnd','touchPoints':[{'x':160,'y':650,'id':101}]}\\\", \\\"{'type':'touchEnd','touchPoints':[action]}\\\");open(p,'w').write(s)\np='src/main.js';s=open(p).read().replace(\\\"(r.practice?'practice':r.assisted?'assisted':r.mode==='coop'?'coop':'solo')\\\", \\\"((r.mode==='coop'?'coop':'solo')+(r.practice?'-practice':r.assisted?'-assisted':''))\\\")\n# Expose live simulation time scaling only to an authorized host test session; snapshots remain authoritative.\ns=s.replace(\\\"app.timeScale=v;if(app.run&&v\"'!==1)\", \"app.timeScale=v;if(app.net?.run)app.net.timeScale=v;if(app.run&&v!==1)\")\nopen(p,'\"'w').write(s)\np='src/net.js';s=open(p).read().replace(\\\"this.run.step(dt,this.inputs)\\\", \\\"this.run.step(dt*(this.timeScale??1),this.inputs)\\\");open(p,'w').write(s)\nPY\ncat > tests/hub_campaign.py <<'PY'\nimport functools\nimport http.server\nimport json\nimport pathlib\nimport sys\nimport threading\nfrom playwright.sync_api import sync_playwright\nroot=pathlib.Path(__file__).resolve().parents[1]\nclass Handler(http.server.SimpleHTTPRequestHandler):\n def log_message(self,*a):pass\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(Handler,directory=str(root)))\nthreading.Thread(target=server.serve_forever,daemon=True).start()\ncount=0\nfailures=[]\nreport={}\ntry:\n with sync_playwright() as p:\n  browser=p.chromium.launch(headless=True)\n  page=browser.new_page(viewport={'width':1400,'height':900})\n  page.clock.install()\n  page.goto(f'http://127.0.0.1:{server.server_port}/vendor/hub/harness.html?game=/build/game.html&players=2&scenario=server&seed=1&limit=900')\n  page.wait_for_function('document.querySelectorAll(\\\"iframe\\\").length===3')\n  for frame in page.frames[1:]:\n   frame.wait_for_function('\"'!!window.TB?.app.net'\"')\n   frame.evaluate('''()=>{const a=TB.app,bot=new TB.Bot;a.driver=(r,seat)=>bot.intent(r,r.players.find(p=>p.seat===seat));}''')\n  page.locator('#release').click()\n  floors=set()\n  for i in range(850):\n   page.clock.run_for(1000)\n   frames=[f for f in page.frames[1:] if 'game.html' in f.url]\n   states=[f.evaluate('({server:TB.app.net.info.server,state:TB.app.net.state,finished:TB.app.net.finished,ended:TB.app.net.ended,errors:TB.app.game.errors})') for f in frames]\n   host=next(s for s in states if s['server'])\n   floors.add(host['state']['floor'])\n   if host['finished'] or host['ended']:\n    page.clock.run_for(500)\n    states=[f.evaluate('({server:TB.app.net.info.server,state:TB.app.net.state,finished:TB.app.net.finished,ended:TB.app.net.ended,errors:TB.app.game.errors})') for f in frames]\n    report={'copies':states,'round':page.locator('#round').inner_text(),'log':page.locator('#log').inner_text(),'floors':list(floors)}\n    break\n  count=5\n  if not report:failures.append('Full harness campaign exceeded time limit')\n  else:\n   h=next(s for s in report['copies'] if s['server'])\n   if h['state']['rescued']\"'!=26 or h['\"'state']['lives']<=0:failures.append('Full dedicated harness campaign did not win: '+json.dumps({k:h['state'][k] for k in ['phase','rescued','lives','floor','elapsed']}))\n   if len(floors)\"'!=5:failures.append('\"'Not every floor reached through harness')\n   if not all(s['state']['rescued']==26 and s['state']['score']==h['state']['score'] for s in report['copies']):failures.append('Final objective state differs across copies')\n   if 'Ended played' not in report['round']:failures.append('Harness did not record played result')\n   if any(s['errors'] for s in report['copies']):failures.append('Draw/runtime errors in full harness campaign')\n  browser.close()\nexcept Exception as e:failures.append(str(e))\nfinally:\n server.shutdown();server.server_close()\n(root/'build/full-hub-campaign.json').write_text(json.dumps(report,indent=2))\nprint(json.dumps({'count':count,'failures':failures}))\nsys.exit(1 if failures else 0)\nPY\npython3 - <<'PY'\np='tools/verify.mjs';s=open(p).read().replace(\\\"if(suites.includes('hub'))\\\", \\\"if(suites.includes('hub-campaign'))jobs.push(['/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/hub_campaign.py']]);\\\\nif(suites.includes('hub'))\\\");open(p,'w').write(s)\nPY\nnpm run build && npm run verify -- hub-campaign\"","aggregated_output":"npm notice run turtley-booked@1.0.0 build\nnpm notice run node tools/build.mjs\nBuilt Turtley-Booked-Turtles-gpt-6.1-sol-max-20261106-033015.html (1364422 bytes)\nnpm notice run turtley-booked@1.0.0 verify\nnpm notice run node tools/verify.mjs hub-campaign\nFAIL Full dedicated harness campaign did not win: {\"phase\": \"lost\", \"rescued\": 11, \"lives\": 0, \"floor\": 2, \"elapsed\": 120.93333333337564}\nFAIL Not every floor reached through harness\nFAIL Final objective state differs across copies\nFAIL Draw/runtime errors in full harness campaign\n5 checks, 4 failures.\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/art.js';s=open(p).read().replace(\\\"rig.update(this.game.reduceMotion?dt*.3:dt,{...a,symbol:room?.symbol});\\\", \\\"const near=\"'!!a.carried&&state.enemies.some(b=>Math.hypot(a.x-b.x,a.y-b.y)<1.4);rig.update(this.game.reduceMotion?dt*.3:dt,{...a,emote:this.game.reduceMotion?0:near?Math.max(a.emote||0,.22):a.emote,symbol:room?.symbol});\")\nopen(p,'\"'w').write(s)\np='src/main.js';s=open(p).read().replace(\\\"else app.art.draw(r,app.dev);\\\", \\\"else app.art.draw(r,app.dev);if(app.attract)r.text('DEMO • Any input to check in',r.W/2,r.H-12,'#f2d7a0',{align:'center'});\\\")\nopen(p,'w').write(s)\nPY\ncat > tests/export.mjs <<'JS'\nimport fs from 'node:fs';import path from 'node:path';import {createHash} from 'node:crypto';\nconst {id,title}=JSON.parse(fs.readFileSync('identity.json'));const html=fs.readFileSync(path.join('..',id+'.html'),'utf8');let count=0;const failures=[];const check=(s,okay)=>{count++;if(\"'!okay)failures.push(s);};\nconst metadata=JSON.parse(fs.readFileSync('\"'../exit-interview.json','utf8'));\ncheck('exact standalone artifact and staged build agree',html===fs.readFileSync('build/game.html','utf8'));\ncheck('unmodified Hub client is first script after charset',html.match(/<meta charset=\\\"utf-8\\\">\\\\s*<script>([\\\\s\\\\S]*?)<\\\\/script>/)?.[1]===fs.readFileSync('vendor/hub/session.js','utf8'));\nfor(const [key,value] of [['session','1'],['session-players','1-2'],['session-mode','shared-world']])check('Hub metadata '+key,html.includes(\"'`name=\"hub:${key}\" content=\"${value}\"`));\ncheck('\"'full engine included',html.includes('my-3D2dge')&&html.includes('v0.89.1')&&html.length>1e6);\ncheck('no relative runtime imports or external scripts',\"'!/<script[''^>]+src=|'\"\\\\bimport\\\\s+[\"'^;]*from'\"\\\\s*[\\\"']|<link[\"'^>]+(?:href|src)=/i.test(html));\ncheck('\"'complete MIT license included',html.includes('Permission is hereby granted, free of charge'));\ncheck('catalogue title agrees',metadata.aiHub.name===title&&html.includes('<title>'+title+'</title>'));\nconst fields=['date','source','plan','genre','perspective','tech','artDirection','animation','audio','online','testing','research','environment','model','usage'];\ncheck('source fields exact and filled',JSON.stringify(Object.keys(metadata.sourceInformation).sort())===JSON.stringify(fields.sort())&&Object.values(metadata.sourceInformation).every(v=>typeof v==='string'&&v.length>0));\ncheck('usage literal',metadata.sourceInformation.usage==='added on import');\ncheck('feedback arrays exact and filled',[['testingFeedback',4],['engineFeedback',6],['promptFeedback',4]].every(([k,n])=>metadata[k].length===n&&metadata[k].every(v=>typeof v==='string'&&v.length>0)));\ncheck('valid catalogue schema',metadata.aiHub.type==='Game'&&metadata.aiHub.genre==='Action'&&metadata.aiHub.players==='1–2'&&metadata.aiHub.tags.length>=3&&metadata.aiHub.tags.length<=6);\ncheck('interview is embedded verbatim as data',html.includes('TB.INTERVIEW='+JSON.stringify(metadata)+';'));\nfs.writeFileSync('build/export-evidence.json',JSON.stringify({bytes:Buffer.byteLength(html),sha256:createHash('sha256').update(html).digest('hex'),checks:count},null,2));\nconsole.log(JSON.stringify({count,failures}));process.exitCode=failures.length?1:0;\nJS\ncat > docs/validation.md <<'MD'\n# Validation record\n\nUse \"'`npm run --silent verify` for the complete set, or append suite names: `rules`, `browser`, `devices`, `audio`, `network`, `hub`, `hub-campaign`, `export`. The orchestrator emits only failure details and a final check count. `tuning` and `network-search` are optional exploratory legal-input pilot traces, not acceptance tests. Run covered checks again only after relevant changes.\n\n## Unique product issues found\n\n| ID | Severity | Observation | Fix and covering evidence |\n| --- | --- | --- | --- |\n| G01 | Critical / game breaking | A missing object brace prevented the initial bundled application from booting. | Corrected preset declaration; exact-HTML startup, native draw and syntax checks. |\n| G02 | Major UX | TV screen inspection exposed undersized menu text because `theme.tv` is not the Shell'\"'s scaling option. | Explicit responsive native theme scale and a three-row title menu; TV screenshots and pad focus/slider tests. |\n| G03 | Major touch | Contextual POP changed its label but the configured touch action list was empty. | Create the native bomb button, hide it until relevant; actual Chromium touch pointer tests and contextual screenshot. |\n| G04 | Moderate network | Initial guest prediction omitted snapshot age, leaving motion behind under delay. | Timestamped host snapshots and bounded replay of recent local intentions against the same graph; latency/reorder/reconciliation checks and campaigns. |\n| G05 | Moderate lifecycle | A Hub-hinted page resolving connect to null retained live-world behavior and disabled standalone attract. | Clear actual \"'`game.live`, restore auto-pause and use active network state for title eligibility; null-connect fallback fixture. |\n\nFive unique product issues; one critical. Failed pilot games are legitimate losses rather than product defects. Two automation errors (synthetic pointers without real capture, and ending the wrong CDP touch id) and WebKit frame-timing assumptions were corrected in the test driver; they are excluded from product issue counts.\n\n## Evidence and scope\n\n- Native fixed-step rules cover map validation, seeded deck/first pickup, continuous cardinal movement, reversal/buffering/walls/diagonal rejection, carry speed, legal route cancellation, swept contact, exclusive passengers and home reservations, exactly-once score, dropped-baby recovery, one shared bomb, invalid/duplicate/empty actions, expiry, localized stun/recovery/no farming, beetle LOS and corner tracking, hysteresis, emergence, warnings, recharge/fresh entry/cap, damage grace, safe respawn, loss, terminal freeze and floor reset.\n- Production finite-life pilots enter only through intentions. Solo seed 2 and local co-op seed 9 rescue all 26 across five floors; detailed counts and elapsed simulation time are in `build/campaign-evidence.json`. The exact bundled HTML is separately played through the native Game loop to victory/results. Fixtures for rare states and screenshots are separate from these runs.\n- Application-network tests serialize real snapshots and authenticated intentions through the same Network adapter, including a dedicated host, stale/invalid/duplicate input, sender authority, leave, time-up, message cadence/payload, end silence and snapshot recovery with loss/latency. A complete dedicated-host campaign seed 1 is recorded in `build/network-campaign-evidence.json`; impaired-network legitimate team failure also converges across copies.\n- The supplied, unchanged Hub harness runs on a temporary loopback OS-selected port, verifies the actual game title and polls both the completion marker and `__hubCheck.pass`. Two-player normal, 150 ms latency/50 ms jitter/5% loss, dedicated-server and host-leave scenarios are covered in `build/hub-evidence.json`. Full synchronized campaign testing uses the real browser harness separately, with native browser-clock stepping; evidence is in `build/full-hub-campaign.json`.\n- Standard controller input is emulated through navigator.getGamepads. Touch uses Chromium'\"'s real CDP touch dispatch with two contacts; WebKit uses a mobile/touch profile. These are stand-ins, not physical DualSense/iPhone/iPad tests. UI checks include pad navigation/back/options/sliders, independent shared keyboard seats, click-to-route, native pause/recovery, whole-floor portrait/landscape and exact 10-second attract/consumed exits.\n- OfflineAudioContext runs the actual engine voice function and original formant synthesis, checking finite/non-silent/limited samples, each separate bus at zero, master mute, the 0.10 music ratio, actual live gain, duplicate-start identity and stop cleanup. This establishes generated signal behavior, not human listening quality.\n- Screenshots serve visual inspection only: title/menu hierarchy at 1920×1080, carry/home matching, whole-maze composition, developer UI and representative portrait/landscape touch framing. No FPS targets or performance claims are made.\n- Export checks validate the root filename, exact unmodified first Hub script, shared-world metadata, inline full engine, license, no external runtime imports/assets, matching staged/final bytes and exact interview schema/content. The self-contained file works from file://; Hub tests alone use HTTP.\n\n## Boundaries\n\nNo physical controller, touch hardware, TV, real iOS Safari, remote human session or listening test was available. CPU stand-ins and generated audio are explicitly identified above. Source video/audio was not watched/heard. No frame-rate/profiling acceptance target was requested or claimed.\nMD\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
