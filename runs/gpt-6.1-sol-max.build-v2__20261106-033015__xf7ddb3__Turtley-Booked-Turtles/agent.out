{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/sim.js';s=open(p).read();s=s.replace(\\\"goal=scored[0]?.r.cell;\\\", \\\"goal=scored[0]?.r.cell;\\\\n        if(run.floor===1&&run.stats.decoys===0&&run.stock>=2){const decoy=run.rooms.find(r=>r.kind==='beetle'&&r.status==='hidden');if(decoy)goal=decoy.cell;}\\\")\ns=s.replace(\\\"const bomb=near<2.1&&\"'!run.bomb&&run.stock>0;\", \"const bomb=near<2.1&&!run.bomb&&run.stock>0;'\"\\\\n      if(bomb&&p.m.moving){const threat=live.slice().sort((a,b)=>Math.hypot(a.m.x-p.m.x,a.m.y-p.m.y)-Math.hypot(b.m.x-p.m.x,b.m.y-p.m.y))[0];\\\\n        if(threat&&(threat.m.x-p.m.x)*p.m.dir[0]+(threat.m.y-p.m.y)*p.m.dir[1]>.25)dir=[-p.m.dir[0],-p.m.dir[1]];}\\\")\nopen(p,'w').write(s)\nPY\ncat > tests/hub.py <<'PY'\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport pathlib\nimport sys\nimport threading\nimport urllib.parse\nfrom playwright.sync_api import sync_playwright\n\nroot = pathlib.Path(__file__).resolve().parents[1]\ncount = 0\nfailures = []\nevidence = []\nclass Handler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), functools.partial(Handler, directory=str(root)))\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\nbase = f'http://127.0.0.1:{server.server_port}'\ntry:\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page(viewport={'width': 1400, 'height': 900})\n        for scenario, network in [('standard', ''), ('standard', '&latency=150&jitter=50&loss=5'), ('server', ''), ('host-leave', '')]:\n            query = f'?game=/build/game.html&players=2&auto=1&scenario={scenario}&play=1500{network}'\n            page.goto(base + '/vendor/hub/harness.html' + query)\n            page.wait_for_function('document.body.dataset.complete === \\\"true\\\"', timeout=60000)\n            report = page.evaluate('window.__hubCheck')\n            evidence.append(report)\n            for check in report['checks']:\n                count += 1\n                if not check['pass']:\n                    failures.append(scenario + network + ': ' + check['name'] + ' — ' + check.get('detail', ''))\n            for frame in page.frames[1:]:\n                if 'game.html' in frame.url:\n                    count += 1\n                    if frame.title() \"'!= '\"'Turtley Booked':\n                        failures.append('Harness loaded the wrong game')\n            page.goto('about:blank')\n        browser.close()\nexcept Exception as e:\n    failures.append(str(e))\nfinally:\n    server.shutdown()\n    server.server_close()\n(root / 'build/hub-evidence.json').write_text(json.dumps(evidence, indent=2))\nprint(json.dumps({'count': count, 'failures': failures}))\nsys.exit(1 if failures else 0)\nPY\nnpm run build && npm run verify -- rules hub\"","aggregated_output":"npm notice run turtley-booked@1.0.0 build\nnpm notice run node tools/build.mjs\nBuilt Turtley-Booked-Turtles-gpt-6.1-sol-max-20261106-033015.html (1358929 bytes)\nnpm notice run turtley-booked@1.0.0 verify\nnpm notice run node tools/verify.mjs rules hub\nFAIL solo full production campaign\nFAIL coop full production campaign\n120 checks, 2 failures.\n","exit_code":1,"status":"failed"}}
