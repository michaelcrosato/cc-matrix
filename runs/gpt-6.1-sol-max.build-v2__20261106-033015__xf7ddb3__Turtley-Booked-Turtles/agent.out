{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc \"cat > tests/lifecycle.mjs <<'JS'\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nconst files=['vendor/engine/my-3d2dge.js','src/content.js','src/sim.js','src/art.js','src/audio.js','src/net.js','src/main.js'];\nconst load=extra=>{const c=vm.createContext({console:{log(){},warn(){},error(){}},...extra});for(const f of files)vm.runInContext(fs.readFileSync(f,'utf8'),c,{filename:f});return c;};\nlet count=0;const failures=[];const check=(name,okay)=>{count++;if(\"'!okay)failures.push(name);};\nconst c=load(),T=c.TB,a=T.app,g=a.game;\ng.advance(.1);g.advance(9.7);check('\"'no attract before ten seconds',\"'!a.attract);g.advance(.4);check('\"'native Arcade starts attract after ten seconds',a.attract);\nconst seen=new Set(),mechanics=new Set;let ending=false,looped=false,wasEnding=false;\nfor(let i=0;i<4800&&\"'!looped;i++){g.advance(.25);const r=a.run;if(!r)break;seen.add(r.floor);for(const e of r.history)mechanics.add(e.type);if(r.phase==='\"'won')ending=true;if(ending&&r.floor===0&&r.players.length===2)looped=true;wasEnding=r.phase==='won';}\ncheck('attract demonstrates all floors and ending',seen.size===5&&ending);\ncheck('attract loops into simultaneous co-op',looped);\ncheck('attract shows rescue defence refill escalation', ['pickup','delivery','plant','trigger','refill','escalate','decoy'].every(k=>mechanics.has(k)));\ncheck('attract never saves a score',T.app.game.settings.music===.1&&['solo','coop','solo-assisted','solo-practice'].every(k=>c.My3D2dge.store.get('tb-best-'+k,null)===null));\na.title();g.advance(.2);a.start();g.advance(.1);check('real run starts clean after attract',a.run.score===0&&a.run.lives===3&&a.run.stock===3&&\"'!a.run.demo&&!a.run.practice&&!a.run.god);\na.run.setBalance('\"'playerSpeed',5);a.run.god=true;a.start();g.advance(.1);check('retry restores production defaults',a.run.balance.playerSpeed===3.5&&\"'!a.run.god&&!a.run.practice);\