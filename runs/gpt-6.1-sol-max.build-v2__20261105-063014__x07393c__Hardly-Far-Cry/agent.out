alse)));await ctx.close();}finally{await browser.close();}}}finally{await writeFile('tests/hub-results.json',JSON.stringify(results,null,2));await new Promise(r=>server.close(r));}}\nEOF\nnode --check tests/suites/hub.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
