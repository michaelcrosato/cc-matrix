CK,promptFeedback:PROMPT_FEEDBACK,aiHub:{name:GAME_TITLE,tagline:'Every road has a price.',description:'An original first-person survival shooter in the Sorrel. Read the wind, clear a rusted gun, survive the fever, and decide who deserves the only honest map.',type:'Game',genre:'Shooter',source:'Far Cry 2',series:'Far Cry',players:'1–4',controls:'WASD/mouse or standard pad; R2/LMB fire, L2/RMB aim, Square/E use, R reload, L1/Q heal, H tablet, M map, G bottle, Esc pause.',tags:['first-person','pixel art','story','vehicles','co-op','versus']}};\nwriteFileSync('../exit-interview.json',JSON.stringify(interview,null,2)+'\\\\n');\nEOF\nnode tools/interview.mjs\npython3 - <<'PY'\nimport json\nv=json.load(open('../exit-interview.json'))\nassert set(v)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'}\nassert len(v['testingFeedback'])==4 and len(v['engineFeedback'])==6 and len(v['promptFeedback'])==4\nassert all(v['sourceInformation'].values())\nprint('Exit interview parses; all required fields and 14 feedback answers present.')\nPY\"","aggregated_output":"Exit interview parses; all required fields and 14 feedback answers present.\n","exit_code":0,"status":"completed"}}
