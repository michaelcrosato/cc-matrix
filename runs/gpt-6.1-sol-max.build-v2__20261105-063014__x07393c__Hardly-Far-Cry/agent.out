{"type":"item.completed","item":{"id":"item_76","type":"agent_message","text":"Both endings now pass the scripted campaign test, and the recorded mission segment replays with matching simulation and physics fingerprints. I’m checking the rendered screens and native mouse, pad, and touch-notice flows next. The remaining integration concern is reliable hub startup under shared-memory pressure."}}
{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/game.js';s=open(p).read().replace('NavGrid} from', 'NavGrid,renderSound} from');s=s.replace(' status(){return', \\\" renderAudio(id){return renderSound(this.ctx.audio.sounds.get(id),22050,12);}\\\\n status(){return\\\");open(p,'w').write(s)\np='src/main.js';s=open(p).read();s=s.replace(\\\"import {Engine,withUrlOptions}\\\",\\\"import {GAME_TITLE} from './content/title.js';\\\\nimport {Engine,withUrlOptions}\\\");old=\\\"const OPTIONS=withUrlOptions\\\"\nnew=\\\"const compatibility=message=>{game.notice='Controller or keyboard required';game.screen='compatibility';const root=document.getElementById('app');root.className='fallback';root.replaceChildren();const title=document.createElement('h1');title.textContent=GAME_TITLE;const notice=document.createElement('div');notice.textContent='Controller or keyboard required';const text=document.createElement('div');text.textContent='This game needs WebGPU. Open this file in Chrome or Edge with WebGPU enabled.';const button=document.createElement('button');button.type='button';button.textContent='SETTINGS / COMPATIBILITY';button.onclick=()=>{text.textContent='Graphics: WebGPU required. Input: keyboard and mouse or a standard gamepad. Music defaults to 10%. '+message;};root.append(title,notice,text,button);window.__GAME__=game;};\\\\nconst OPTIONS=withUrlOptions\\\"\ns=s.replace(old,new);start=s.index(\\\"else if(\"'!navigator.gpu){\");end=s.index(\"'\"\\\\n else await Engine.start\\\",start);s=s[:start]+\\\"else if(\"'!navigator.gpu){compatibility('\"'WebGPU is unavailable in this browser.');if(info)hub.fail('This game needs WebGPU');}\\\"+s[end:];s=s.replace(\\\"}catch(e){if(info)hub.fail(String(e.message||e));throw e;}\\\",\\\"}catch(e){if(info){hub.fail(String(e.message||e));throw e;}if(/webgpu|adapter|gpu device/i.test(String(e.message||e)))compatibility(String(e.message||e));else throw e;}\\\")\nopen(p,'w').write(s)\nPY\ncat > tests/suites/browser.mjs <<'EOF'\nimport {chromium,webkit,devices} from 'playwright';\nimport {resolve} from 'node:path';\nimport {mkdir,writeFile} from 'node:fs/promises';\nexport const covers=['src/main.js','src/game.js','src/ui/menu.js','src/ui/hud.js','src/ui/glyphs.js','src/world/map-texture.js','src/combat/viewmodel.js'];\nconst flags=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader','--use-webgpu-adapter=swiftshader'];\nexport async function run(check){const url='file://'+resolve('../Hardly-Far-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-063014.html');await mkdir('tests/.captures',{recursive:true});const browser=await chromium.launch({headless:true,args:flags});try{let ctx=await browser.newContext({viewport:{width:1920,height:1080}});await ctx.addInitScript(()=>{window.__PAD__={connected:false,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:16},()=>({pressed:false,value:0}))};navigator.getGamepads=()=>window.__PAD__.connected?[window.__PAD__]:[];});let p=await ctx.newPage(),errors=[];p.on('pageerror',e=>errors.push(e.message));p.on('console',m=>{if(m.type()==='error')errors.push(m.text());});await p.goto(url);await p.waitForFunction(()=>window.__GAME__&&window.__PIXEL_ENGINE__,{},{timeout:90000});await p.evaluate(()=>{__PIXEL_ENGINE__.manual=true;__GAME__.idle=-1000;});check(await p.title()==='Hardly Far Cry','single file title');check(await p.evaluate(()=>\"'!AIHub.active),'\"'outside a session');check(await p.evaluate(()=>__PIXEL_ENGINE__.state().backend==='WebGPU'),'real WebGPU backend');\n const step=()=>p.evaluate(()=>__PIXEL_ENGINE__.step(2));const key=async k=>{await p.keyboard.down(k);await step();await p.keyboard.up(k);await step();};const clickRow=async index=>{const r=await p.evaluate(i=>{const r=__GAME__.ui.rects[i],h=__PIXEL_ENGINE__.hud;return {x:(r.x+r.w/2)/h.width*innerWidth,y:(r.y+r.h/2)/h.height*innerHeight};},index);await p.mouse.move(r.x,r.y);awai