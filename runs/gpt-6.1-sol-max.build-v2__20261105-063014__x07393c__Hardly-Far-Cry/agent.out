ue,keys:[[0,{ArmR:{r:[-85,0,-15]},ForearmR:{r:[-15,0,0]},ArmL:{r:[-65,0,28]},ForearmL:{r:[-55,0,0]}}],[30,{ArmR:{r:[-85,0,-15]},ForearmR:{r:[-15,0,0]},ArmL:{r:[-65,0,28]},ForearmL:{r:[-55,0,0]}}]]},\n {name:'BurnPanic',frames:18,loop:true,fast:true,keys:[[0,{Torso:{r:[15,0,-9]},ArmR:{r:[-110,0,-40]},ArmL:{r:[-95,0,60]},LegR:{r:[45,0,0]},LegL:{r:[-35,0,0]}}],[9,{Torso:{r:[15,0,9]},ArmR:{r:[-80,0,-70]},ArmL:{r:[-130,0,30]},LegR:{r:[-35,0,0]},LegL:{r:[45,0,0]}}],[18,{Torso:{r:[15,0,-9]},ArmR:{r:[-110,0,-40]},ArmL:{r:[-95,0,60]},LegR:{r:[45,0,0]},LegL:{r:[-35,0,0]}}]]},\n {name:'WoundedSit',frames:40,loop:true,keys:[[0,{Pelvis:{p:[0,-.42,0]},Torso:{r:[25,0,10]},LegR:{r:[-65,0,0]},LegL:{r:[-45,0,0]},ArmR:{r:[-30,0,-40]}}],[40,{Pelvis:{p:[0,-.42,0]},Torso:{r:[25,0,10]},LegR:{r:[-65,0,0]},LegL:{r:[-45,0,0]},ArmR:{r:[-30,0,-40]}}]]},\n {name:'DriveSit',frames:30,loop:true,keys:[[0,{Pelvis:{p:[0,-.4,0]},LegR:{r:[-90,0,0]},LegL:{r:[-90,0,0]},ArmR:{r:[-80,0,-10]},ArmL:{r:[-80,0,10]}}],[30,{Pelvis:{p:[0,-.4,0]},LegR:{r:[-90,0,0]},LegL:{r:[-90,0,0]},ArmR:{r:[-80,0,-10]},ArmL:{r:[-80,0,10]}}]]},\n {name:'UnjamSwear',frames:40,keys:[[0,{ArmR:{r:[-80,0,0]}}],[20,{ArmL:{r:[-110,0,20]},Head:{r:[20,0,0]}}],[40,{ArmR:{r:[0,0,0]},ArmL:{r:[0,0,0]},Head:{r:[0,0,0]}}]]}\n];\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"rg -n '\"'^### (class Light|interface Light|class NavGrid|class BehaviorTree|class bt|bt'\"\\\\()' API.md && sed -n '1200,1275p' API.md && sed -n '4140,4206p' API.md && sed -n '4415,4480p' API.md && sed -n '3764,3795p' API.md && rg -n 'readiness|ready' vendor/hub/harness.html | tail -8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"rg -n '\"'^### (class Light|interface Light|class NavGrid|class BehaviorTree|class bt|bt'\"\\\\()' API.md && sed -n '1200,1275p' API.md && sed -n '4140,4206p' API.md && sed -n '4415,4480p' API.md && sed -n '3764,3795p' API.md && rg -n 'readiness|ready' vendor/hub/harness.html | tail -8\"","aggregated_output":"1211:### class LightAssigner\n1227:### interface LightHandle\n1249:### class LightPool\n1267:### interface LightPoolOptions\n1272:### interface LightPoolStats\n1281:### interface LightRequestOptions\n3927:### class BehaviorTree\n4486:### class NavGrid\ncache). Its vertices snap with the toon materials' under the `ps1` filter, so a glowing part\nstays on its model.\n\n### LIGHT_POOL_SIZES\n\n```ts\nconst LIGHT_POOL_SIZES: { readonly low: 4; readonly medium: 8; readonly high: 16; }\n```\n\nPool sizes by quality level (`QUALITY[level].lights`).\n\n### class LightAssigner\n\nPure light assignment: `capacity` slots, many items. Each step picks the `capacity`\nhighest-scoring live items (items already holding a slot score × `hysteresis`, so two\nsimilar requests don't trade a light back and forth), fades winners in and losers out,\nand moves a slot to a new owner only once the old one has faded to 0. A fade changes a\nlevel by at most `dt / fade` per step: nothing ever pops.\n\n- `new LightAssigner(capacity: number)`\n- `readonly slots: (T | null)[]`: Slot → item holding it.\n- `hysteresis: number`\n- `get capacity: number`\n- `resize(capacity: number, items: Iterable<T>): void`: Change the slot count (the pool's lights are rebuilt: a one-off shader recompile).\n- `rank(it: T): number`: Effective rank of an item (score with the hysteresis bonus for holders).\n- `step(dt: number, items: readonly T[]): AssignStats`\n\n### interface LightHandle\n\nA light request. Change it freely; the pool decides whether it currently owns a real light.\n\n- `readonly id: number`\n- `readonly position: Vector3`: World position (mutable; ignored while following).\n- `readonly color: Color`: Colour (mutable).\n- `intensity: number`\n- `radius: number`\n- `decay: number`\n- `flicker: FlickerPreset`\n- `priority: number`\n- `follow: Object3D | null`\n- `readonly offset: Vector3`\n- `name: string`\n- `lifetime: number`: Seconds left before auto-release (Infinity = until `release()`).\n- `update(options: LightRequestOptions): this`: Set several fields at once.\n- `release(): void`: Fade out and give the light back. Safe to call twice.\n- `readonly alive: boolean`\n- `readonly lit: boolean`: Whether it holds one of the pool's real lights right now.\n- `readonly level: number`: 0..1: how much of it is shown (fades).\n\n### class LightPool\n\nA fixed pool of point lights shared by many requests (see the file comment). Available\nto games as `ctx.lights` (sized by quality: low 4, medium 8, high 16), or create your\nown with `new LightPool({ size, parent: scene })` and call `update` every frame.\n\n- `new LightPool(options: LightPoolOptions = {})`\n- `readonly group: Group<Object3DEventMap>`\n- `readonly lights: PointLight[]`\n- `get size: number`: Number of real lights (constant unless `resize`d).\n- `request(options: LightRequestOptions = {}): LightHandle`: Ask for a light. Returns a handle to move, recolour or release.\n- `update(dt: number, focus: Vector3, range = 18): void`: Assign lights for this frame. `focus` is what the camera looks at; requests further than `range` + their radius from it are not lit. Call once per rendered frame.\n- `clear(): void`: Release every request at once and darken the lights (level unload).\n- `resize(size: number): void`: Change the number of real lights. Every material using lights recompiles once, so do it rarely (a quality change), never per frame.\n- `stats(): LightPoolStats`\n- `describe(): { id: number; name: string; score: number; slot: number; level: number; alive: boolean }[]`: Every live request with its score and slot (debugging, inspectors).\n- `dispose(): void`\n\n### interface LightPoolOptions\n\n- `size?: number`: Real lights in the pool (constant: changing it recompiles materials). Default 8.\n- `parent?: Object3D`: Parent for the pool's lights (added to it). Usually the scene.\n\n### interface LightPoolStats\n\n- `size: number`\n- `requests: number`\n```ts\ntype DecalShape = (typeof DECAL_SHAPES)[number]\n```\n\n### decodeState()\n\n```ts\nfunction decodeState(v: unknown): unknown\n```\n\n`encodeState` undone: a deep copy with the marked numbers (and the game's own `@` strings) back.\n\n### drawSheet()\n\n```ts\nfunction drawSheet(o: { frame: readonly [number, number]; frames: number; cols?: number }, draw: (g: CanvasRenderingContext2D, frame: number) => void): SpriteSheet\n```\n\nDraw a sheet in code: `draw(g, frame)` paints one frame into a `frame`-sized box (the\ncontext is translated there and clipped). Pixel coordinates; draw with `fillRect`.\n\n### ease()\n\n```ts\nfunction ease(e: Ease, u: number): number\n```\n\n### type Ease\n\n```ts\ntype Ease = EaseName | ((u: number) => number)\n```\n\n### EASE_NAMES\n\n```ts\nconst EASE_NAMES: EaseName[]\n```\n\n### type EaseName\n\n```ts\ntype EaseName = | 'linear' | 'inQuad' | 'outQuad' | 'inOutQuad' | 'inCubic' | 'outCubic' | 'inOutCubic' | 'inSine' | 'outSine' | 'inOutSine' | 'inExpo' | 'outExpo' | 'inOutExpo' | 'inBack' | 'outBack' | 'inOutBack' | 'outElastic' | 'outBounce' | 'smooth' | 'steps2' | 'steps4' | 'steps8'\n```\n\nTweens: numbers that glide to a value over time, for doors, lifts, pickups, menus and\npads. Game time (they pause, slow down and freeze with `engine.timeScale` and hitstops)\nand cleared when a level unloads. `ctx.tweens`:\n\n  ctx.tweens.to(door.position, { y: 3 }, { duration: 0.8, ease: 'outBack' });\n  const t = ctx.tweens.to(lamp, { intensity: 0 }, { duration: 0.3, yoyo: true, repeat: Infinity });\n  t.cancel();\n  if (await ctx.tweens.to(door.position, { y: 0 }, { duration: 0.5 }).done) slam(); // false: cancelled / level gone\n  ctx.tweens.call(0.5, () => spawn());                            /…\n\n### EASES\n\n```ts\nconst EASES: Readonly<Record<EaseName, (u: number) => number>>\n```\n\nEvery named ease: u in 0..1 → progress (back and elastic overshoot past 1).\n\n### emitter()\n\n```ts\nfunction emitter(def: PatternDef): Emitter\n```ts\nfunction lavaMaterial(o: ShaderOptions = {}): MeshBasicNodeMaterial\n```\n\nLava: slow churning fractal noise, banded dark crust to white-hot, unlit (it glows).\n\n### interface Leaf\n\n- `at: V3`\n- `dir: V3`: The way the twig it grows on points.\n- `depth: number`\n\n### interface LRule\n\nOne right-hand side, chosen with probability `p` among a symbol's rules.\n\n- `to: string`\n- `p?: number`\n\n### interface LSystemDef\n\n- `axiom: string`\n- `rules: Readonly<Record<string, string | readonly LRule[]>>`: symbol → what replaces it (one string, or several to choose from by probability)\n\n### marbleMaterial()\n\n```ts\nfunction marbleMaterial(o: ShaderOptions = {}): MeshToonNodeMaterial\n```\n\nMarble: veins (a sine bent by fractal noise) in three bands of white and grey, toon-lit.\n\n### MAX_FRAMES\n\n```ts\nconst MAX_FRAMES: 216000\n```\n\nFrames a recording keeps: an hour at 60 fps.\n\n### MAX_PUSHERS\n\n```ts\nconst MAX_PUSHERS: 4\n```\n\n### MAX_WAVES\n\n```ts\nconst MAX_WAVES: 4\n```\n\nWaves the shader sums (more are ignored).\n\n### class Mirror\n\n- `new Mirror(o: MirrorOptions = {})`\n- `readonly mesh: Mesh`\n- `readonly target: RenderTarget`\n- `enabled: boolean`: False: the glass shows plain glass and nothing is rendered for it.\n- `renders: number`: Times it has rendered.\n- `render(renderer: WebGPURenderer, scene: Scene, camera: Camera, width: number, height: number): boolean`: Reflect `camera` in the glass and draw `scene` from there into the texture (sized `width` x `height`, the art resolution). Skipped when the camera is behind the glass.\n- `attach(view: View, scene: Scene): () => void`: Render before every frame of `view` (`engine.renderer`), from its camera, at its art size. Returns a stop. Headless the hook is kept and never runs (nothing is drawn).\n- `dispose(): void`\n\n### interface MirrorOptions\n### interface RigSpec\n\nEverything the tools need to know about a rig beyond its hierarchy.\n\n- `joints: readonly string[]`: Joint names in hierarchy order (root first).\n- `root: string`\n- `mirror: Readonly<Record<string, string>>`: Left/right counterparts for mirroring.\n- `soles: readonly string[]`: Mesh names that touch the ground (soles).\n- `trace: readonly string[]`: Points to trace in contact sheets (joint or mesh names).\n- `limits: Readonly<Record<string, JointLimit>>`: Human-plausible rotation ranges, degrees.\n- `fps: number`: Frame rate of the authoring format.\n- `legs?: LegRig`: Leg geometry, enabling foot IK and the gait generator.\n- `spine?: { torso?: string; head?: string; cap?: string }`: Joints the runtime procedural layers turn (PoseLayers): the torso and head look where the character is going; `cap` is an optional springy joint (not animated by clips).\n\n### sampleClip()\n\n```ts\nfunction sampleClip(clip: ClipDef, frame: number, rig: RigSpec | readonly string[]): Record<string, ResolvedJoint>\n```\n\nEvaluate a clip's pose at `frame` (keys + layers + feet track), fully resolved for every\njoint of `rig` (or the listed joints — then the feet track needs a rig and is skipped).\n\n### interface SheetImage\n\nTiny RGBA software canvas shared by contact sheets, curve plots and filmstrips (no GPU, no DOM).\n\n- `width: number`\n- `height: number`\n- `data: Uint8ClampedArray`\n\n### class SpringChain\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n340:    else if (p.ready) bits.push('ready');\n440:    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n441:    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n442:    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n448:      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n449:      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n453:    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > src/combat/viewmodel.js <<'EOF'\nimport {THREE,buildModel,compileClips,setLookLayer,toonMaterial,PALETTE,model} from '../../pixel-engine.js';\nimport {VIEW_DEFS,HAND_RIG,HAND_CLIPS} from '../art/viewmodels.js';\nexport function toolDef(kind){const p={metal:'slate',dark:'night',skin:'orange',glass:'mist',red:'red',paper:'sand',green:'green'};const box=(s,at,c)=>({box:s,at,c});let parts=[];\n if(kind==='Tablet')parts=[{cyl:[.06,.1,.06],at:[0,0,0],c:'paper'},box([.065,.025,.065],[0,.065,0],'red')];\n else if(kind==='Syrette')parts=[{cyl:[.025,.13,.025],at:[0,0,0],c:'glass'},box([.04,.02,.04],[0,.08,0],'red'),box([.008,.06,.008],[0,-.09,0],'metal')];\n else if(kind==='Cauterise')parts=[box([.05,.08,.025],[0,0,0],'metal'),{cone:[.015,.05,.015],at:[0,.07,0],c:'paper',glow:true}];\n else if(kind==='Finger')parts=[box([.03,.1,.035],[0,0,0],'skin')];\n else if(kind==='Shrapnel')parts=[box([.03,.04,.18],[0,0,-.08],'metal'),box([.04,.06,.1],[0,0,.06],'dark')];\n else if(kind==='Wrench')parts=[box([.035,.035,.28],[0,0,0],'metal'),box([.08,.04,.035],[0,0,-.16],'metal'),box([.02,.04,.065],[-.03,0,-.19],'metal'),box([.02,.04,.065],[.03,0,-.19],'metal')];\n else parts=[box([.025,.025,.18],[-.025,0,0],'red'),box([.025,.025,.18],[.025,0,0],'red'),box([.02,.035,.08],[-.02,0,-.12],'metal'),box([.02,.035,.08],[.02,0,-.12],'metal')];\n return model({id:'tool-'+kind.toLowerCase(),about:'Held field tool '+kind,tags:['tool','viewmodel'],floats:true,collider:'none',palette:p,parts});}\nexport class Hands {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.group=new THREE.Group();this.group.name='FirstPersonHands';this.group.position.set(.19,-.24,-.43);this.root=new THREE.Group();this.group.add(this.root);setLookLayer(this.group,'actors');ctx.scene.add(ctx.camera.camera);ctx.camera.camera.add(this.group);this.current='';this.action='';this.actionTime=0;this.ads=0;this.kick=0;this.tool=null;this.muzzle=new THREE.Mesh(new THREE.ConeGeometry(.035,.16,4),new THREE.MeshBasicNodeMaterial({color:PALETTE.sand}));this.muzzle.rotation.x=-Math.PI/2;this.muzzle.visible=false;this.group.add(this.muzzle);}\n equip(id){if(this.current===id)return;this.current=id;this.root.clear();const def=VIEW_DEFS.find(d=>d.id==='view-'+id)||VIEW_DEFS[0];const b=buildModel(def);this.view=b.object;this.root.add(this.view);this.view.traverse(o=>{if(o.isMesh){o.castShadow=false;o.receiveShadow=false;}});this.mixer=new THREE.AnimationMixer(this.view);const clips=compileClips(HAND_CLIPS,HAND_RIG,this.view);this.clips=Object.fromEntries(clips.map(c=>[c.name,c]));this.mixer.addEventListener('finished',()=>{this.action='';this.mixer.stopAllAction();});this.action='';}\n animate(name){if(\"'!this.clips?.[name])return;this.mixer.stopAllAction();const a=this.mixer.clipAction(this.clips[name]);a.setLoop(name==='\"'Wrench'?THREE.LoopRepeat:THREE.LoopOnce,name==='Wrench'?Infinity:1);a.clampWhenFinished=false;a.reset().play();this.action=name;this.actionTime=0;if(this.tool){this.tool.removeFromParent();this.tool=null;}if(['Tablet','Syrette','Pliers','Shrapnel','Finger','Cauterise','Wrench'].includes(name)){this.tool=buildModel(toolDef(name)).object;this.tool.position.set(0,.06,-.08);this.view.getObjectByName('HandR').add(this.tool);}}\n shoot(){this.kick=1;this.animate('Fire');this.muzzle.visible=true;this.muzzle.position.set(0,.065,this.current==='m38'||this.current==='flare'?-.4:-.82);}\n update(dt){const g=this.g;this.equip(g.weapon?.id||'cane');this.mixer?.update(dt);this.actionTime+=dt;if(\"'!this.action&&this.tool){this.tool.removeFromParent();this.tool=null;}this.kick=Math.max(0,this.kick-dt*18);this.muzzle.visible=this.kick>.65;this.ads+=(Number(g.aim)-this.ads)*Math.min(1,dt*12);const moving=g.moving&&!g.vehicle?1:0;this.group.position.set(.19*(1-this.ads),-.24+.08*this.ads+Math.sin(g.clock*9)*.008*moving,-.43+this.ads*.13+this.kick*.025);this.group.rotation.z=Math.sin(g.clock*4.5)*.01*moving;this.view.getObjectByName('\"'Rust').visible=(g.weapon?.cond??100)<60;this.view.getObjectByName('Tape').visible=(g.weapon?.cond??100)<30;this.group.visible=['campaign','round','attract'].includes(g.mode)&&\"'!g.mapUp&&!g.trackerUp&&!g.monocular&&!g.vehicle&&g.screen!=='\"'ending'&&g.body?.rescueTime<=0;const cam=this.ctx.camera.camera,desired=g.monocular?16:g.aim?(g.weapon?.id==='empire'?12:45):g.settings.fov;cam.fov+=(desired-cam.fov)*Math.min(1,dt*12);cam.updateProjectionMatrix();}\n}\nEOF\ncat > src/body/health.js <<'EOF'\nexport class Body {\n constructor(g){this.g=g;this.lastDamage=0;this.lastType='bullet';this.burning=0;this.busy=null;this.rescueTime=0;this.surgeries=0;this.fever={active:false,age:0,next:720,clearing:0,attacks:0};}\n damage(n,type='bullet'){const g=this.g;if(g.cheats.god||this.rescueTime>0||g.mode==='attract')return;if(g.round){g.round.damage(g.round.session.me,n*g.tuning.playerDamageTaken);g.hp=g.round.players[g.round.session.me]?.hp??100;return;}g.hp=Math.max(0,g.hp-n*g.tuning.playerDamageTaken);this.lastDamage=g.clock;this.lastType=type;g.combatAge=0;g.ctx.engine.shake.add(.15);g.sound.play('flesh',.3);if(this.busy?.kind==='surgery'){this.busy=null;g.hands.action='';}if(g.hp<=0)this.down();}\n down(){const g=this.g,b=g.buddies.find(b=>b.met&&\"'!b.dead&&!b.down&&b.readyAt<=g.absoluteHours);if(b){this.rescueTime=4;g.hp=b.id==='\"'mags'?60:40;b.readyAt=g.absoluteHours+24;if(g.rng.body.chance(g.tuning.buddyWoundChance))b.readyAt+=24;g.ledger.rescues++;g.say(b.id,b.id==='mags'?'Not today. Today you owe me money.':'You owe me a truck. You owe me several trucks.');g.cam.override={position:[g.pos.x,g.pos.y+.5,g.pos.z],target:[g.pos.x,g.pos.y+7,g.pos.z-4]};g.hands.animate('Syrette');}else{g.hp=0;g.screen='dead';g.ui.open('dead');}}\n heal(){const g=this.g;if(this.busy)return false;if(g.hp<20){const kinds=['Pliers','Shrapnel','Finger','Cauterise'],kind=this.lastType==='fire'?'Cauterise':kinds[(this.surgeries++)%3];this.busy={kind:'surgery',animation:kind,left:4};g.hands.animate(kind);g.sound.play(kind==='Cauterise'?'lighter':kind==='Finger'?'finger':kind==='Shrapnel'?'knife':'pliers');g.sound.play('grunt',.7);return true;}if(g.syrettes>0&&g.hp<100){g.syrettes--;this.busy={kind:'heal',left:.8};g.hands.animate('Syrette');g.sound.play('syrette');return true;}return false;}\n attackFever(){if(this.g.cheats.noFever)return;this.fever.active=true;this.fever.age=0;this.fever.clearing=0;this.fever.attacks++;this.g.say('aster','The fever. The country keeps its own time.');this.g.sound.play('heartbeat');}\n tablet(){const g=this.g;if(this.busy||\"'!this.fever.active||g.tablets<=0)return false;g.tablets--;this.busy={kind:'\"'tablet',left:1};g.hands.animate('Tablet');g.sound.play('tablet');return true;}\n collapse(){const g=this.g;g.stones=Math.floor(g.stones*.8);g.absoluteHours+=4;g.hour=(g.hour+4)%24;const p=g.nearestSafehouse();g.teleport(p.at[0],p.at[1]+5);g.hp=Math.max(g.hp,40);this.fever.active=false;this.fever.age=0;this.fever.next=g.clock+(g.tuning.feverMinutes-Math.min(2,g.act-1))*60;g.say('odile','You missed four hours. The debt kept working.');}\n tick(dt){const g=this.g;if(this.rescueTime>0){this.rescueTime-=dt;if(this.rescueTime<=0)g.cam.override=null;else if(g.cam.override)g.cam.override.position[2]+=dt*1.4;}if(this.busy){this.busy.left-=dt;if(this.busy.left<=0){if(this.busy.kind==='heal')g.hp=Math.min(100,g.hp+40);if(this.busy.kind==='surgery')g.hp=40;if(this.busy.kind==='tablet'){this.fever.clearing=5;this.fever.next=g.clock+g.tuning.feverMinutes*60+g.rng.body.range(-120,120);}this.busy=null;}}\n const i=g.world.fire.index(g.pos.x,g.pos.z);if(i>=0&&g.world.fire.state[i]===1)this.burning=2;else this.burning=Math.max(0,this.burning-dt);if(g.world.terrain.classify(g.pos.x,g.pos.z)==='water')this.burning=0;if(this.burning>0)this.damage(g.tuning.fireDamage*dt,'fire');if(g.hp>0&&g.hp<100&&g.clock-this.lastDamage>5&&\"'!this.burning)g.hp=Math.min(Math.ceil(g.hp/20)*20,g.hp+dt*3);\n if(this.fever.clearing>0){this.fever.clearing-=dt;if(this.fever.clearing<=0){this.fever.active=false;this.fever.age=0;}}else if(this.fever.active){this.fever.age+=dt;if(this.fever.age>25)this.collapse();}else if(g.clock>this.fever.next&&!g.cheats.noFever)this.attackFever();}\n}\nEOF\ncat > src/actors/actors.js <<'\"'EOF'\nimport {THREE,CharacterController,buildModel,compileClips,HERO_CLIPS,HERO_RIG,Ragdoll,HERO_RAGDOLL,BehaviorTree,bt,NavGrid,setLookLayer} from '../../pixel-engine.js';\nimport {MODELS} from '../art/models.js';\nimport {ACTOR_CLIPS} from '../art/clips.js';\nimport {angle,clamp} from '../core/math.js';\nconst BARKS={concord:['There\"'! In the grass!'\"','Who lit that?','It is stuck\"'! It is stuck again!'\"','Leave him, he is already gone.','Report your position.','That is our road.','Check the trees.','One more invoice.','Keep the flank.','Movement at the ridge.','They are burning the field.','Watch the fire.','Out of the smoke.','Reloading.','I saw someone.'],harvest:['There\"'! In the grass!'\"','Who lit that?','It is stuck\"'! It is stuck again!'\"','Leave him, he is already gone.','Behind the truck.','For the harvest.','Find the contractor.','Cut the road.','Keep your head down.','I cannot see him.','The grass is moving.','Watch the wind.','There goes the field.','Do not follow the flames.','Where is our pay?']};\nexport class Actors {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.list=[];this.handles=new Map();this.nav=new NavGrid(640,640,{cell:2,origin:[-640,0,-640]});this.pathBudget=2;this.aiClock=0;this.serial=0;this.rng=ctx.random.fork('ai');for(const site of g.world.sites)if(site.guards)this.remann(site);for(const o of g.world.objects.filter(o=>o.person))this.spawn({id:o.person,kind:'speaker',model:o.person,x:o.x,z:o.z,hp:1000,site:'mile-forty'});for(let i=0;i<12;i++)this.spawn({kind:'civilian',model:'civilian',x:(i%2?-260:0)+this.rng.range(-15,15),z:(i%2?240:40)+this.rng.range(-15,15),hp:100,site:i%2?'three-wells':'mile-forty'});}\n remann(s){for(let i=0;i<s.guards;i++){const a=i/s.guards*Math.PI*2,x=s.at[0]+Math.cos(a)*(12+i%3*3),z=s.at[1]+Math.sin(a)*(12+i%3*3);this.spawn({kind:'soldier',model:s.faction==='harvest'?'harvest':'soldier',faction:s.faction,x,z,hp:100*this.g.tuning.enemyHealth,site:s.id,role:i===0?'mg':'rifle',yaw:a});}}\n spawn(data){const a={id:data.id||'actor-'+this.serial++,kind:'soldier',faction:'concord',hp:100,state:'idle',suspicion:0,burn:0,shotCD:1,think:0,yaw:0,home:[data.x,data.z],dead:false,...data};a.y=this.g.world.heightAt(a.x,a.z);a.view=buildModel(data.model||'soldier',{catalog:MODELS,palette:{skin:this.rng.pick(['plum','orange','sand','red'])}}).object;a.view.position.set(a.x,a.y,a.z);a.view.rotation.y=a.yaw;setLookLayer(a.view,'actors');this.ctx.scene.add(a.view);a.mixer=new THREE.AnimationMixer(a.view);const clips=compileClips([...HERO_CLIPS.filter(c=>['Idle','Walk','Run','HitReact','Death','Wave','Sit'].includes(c.name)),...ACTOR_CLIPS],{...HERO_RIG,spine:undefined},a.view);a.actions=Object.fromEntries(clips.map(c=>[c.name,a.mixer.clipAction(c)]));a.anim='';if(a.kind==='soldier'){const gun=buildModel('stone-case',{catalog:MODELS}).object;gun.scale.set(.16,.2,1.6);gun.rotation.x=Math.PI/2;gun.position.set(0,-.02,.11);a.view.getObjectByName('HandR')?.add(gun);a.brain=new BehaviorTree(bt.selector('soldier',bt.sequence('burn',bt.condition('alight',()=>a.burn>0),bt.action('panic',()=>{this.panic(a);return 'success';})),bt.action('duty',()=>{this.think(a);return 'success';})),{});}this.list.push(a);return a;}\n ensureBody(a){if(a.controller||a.dead||a.kind\"'!=='\"'soldier')return;a.controller=new CharacterController(this.ctx.physics,{position:[a.x,a.y+.05,a.z],speed:3.1,jumpSpeed:0,gravity:-24,radius:.3,halfHeight:.5});this.ctx.physics.tag(a.controller.collider,'npc');this.handles.set(a.controller.collider.handle,a);}\n play(a,clip){if(a.anim===clip)return;a.actions[a.anim]?.fadeOut(.15);const action=a.actions[clip]||a.actions.Idle;if(action){action.reset().fadeIn(.15).play();a.anim=clip;}}\n hostile(a){const g=this.g;if(a.kind\"'!=='\"'soldier')return false;if(g.noFireZone())return false;if(g.pass===a.faction&&\"'!a.betrayed)return false;return true;}\n perception(a){const g=this.g,dx=g.pos.x-a.x,dz=g.pos.z-a.z,d=Math.hypot(dx,dz),night=g.hour<6||g.hour>19;let vision=g.tuning.enemyVision*(g.crouch?.55:1)*(night?.45:1);if(g.crouch&&g.world.fuelAt(g.pos.x,g.pos.z))vision*=.6;if(g.body.burning>0||g.shotAge<.2)vision*=2;const facing=Math.abs(angle(Math.atan2(dx,dz)-a.yaw))<Math.PI/3;return {d,visible:d<vision&&(facing||d<8),heard:(g.shotAge<.4&&d<120)||(g.moving&&d<(g.sprinting?40:25))};}\n los(a){const g=this.g,from=new THREE.Vector3(a.x,a.y+1.4,a.z),to=new THREE.Vector3(g.pos.x,g.pos.y+1.1,g.pos.z).sub(from),d=to.length();to.normalize();const hit=this.ctx.physics.castRay(from,to,d-.7,a.controller?.body);return !hit||this.handles.has(hit.collider?.handle)||hit.collider===g.player.collider;}\n think(a){const g=this.g;if(!this.hostile(a)||g.cheats.invisible){a.state='\"'idle';a.suspicion=0;return;}const sense=this.perception(a),can=sense.visible&&this.los(a);if(can||sense.heard){a.suspicion=clamp(a.suspicion+.1*(can?1:.55),0,1);a.last=[g.pos.x,g.pos.z];a.searchAge=0;if(a.suspicion>.7){if(a.state\"'!=='\"'alert'&&this.rng.chance(.12))g.say(a.faction,this.rng.pick(BARKS[a.faction]));a.state='alert';g.combatAge=0;}else a.state='suspicious';}else{a.searchAge=(a.searchAge||0)+.1;if(a.searchAge>20){a.state='idle';a.suspicion=Math.max(0,a.suspicion-.05);}else if(a.state==='alert')a.state='searching';}if(a.state==='alert'){a.yaw=Math.atan2(g.pos.x-a.x,g.pos.z-a.z);if(a.shotCD<=0&&can){a.shotCD=.3+this.rng.range(.1,.5);if(this.rng.chance(.0015*g.tuning.jamRate)){a.state='jammed';a.shotCD=2.8;this.play(a,'UnjamSwear');g.say(a.faction,'It is stuck\"'! It is stuck again!'\"');return;}g.sound.play('tractor',Math.max(.015,.25*(1-sense.d/140)),-4);const chance=clamp((1-sense.d/140)*.32*g.tuning.enemyAccuracy*(g.sprinting?.6:1),.01,.65);if(this.rng.chance(chance))g.body.damage(9);if(g.buddyActive&&this.rng.chance(.1)){const b=g.buddies.find(b=>b.id===g.buddyActive);if(b&&\"'!b.down&&!b.dead){b.hp-=9;if(b.hp<=0)g.downBuddy(b.id);}}}if(sense.d>26&&this.pathBudget>0&&this.rng.chance(.09)){this.pathBudget--;const target=[g.pos.x+(a.id.length%2?10:-10),0,g.pos.z+8];a.path=this.nav.path([a.x,0,a.z],target);a.pathI=0;}}}\n panic(a){a.state='\"'burning';a.yaw+=this.rng.range(-.8,.8);this.g.world.fire.ignite(a.x,a.z,2);}\n damage(a,n,hitY=1){if(\"'!a||a.dead)return false;if(a.kind==='\"'civilian'){this.flee(a);return false;}if(a.kind==='speaker')return false;a.betrayed=true;a.hp-=n*(hitY>1.45?2.5:hitY<.55?.7:1);a.state='alert';a.suspicion=1;if(a.hp<=0)this.kill(a);else this.play(a,'HitReact');return true;}\n kill(a){if(a.dead)return;a.hp=0;a.dead=true;a.state='dead';this.g.ledger.kills++;if(this.g.round){const p=this.g.round.players[this.g.round.session.me];if(p)p.kills++;}if(a.controller){this.handles.delete(a.controller.collider.handle);a.controller.body.setEnabled(false);}try{a.ragdoll=new Ragdoll(this.ctx.physics,a.view,HERO_RAGDOLL);a.ragdoll.enable({velocity:[0,0,-2]});}catch{a.view.rotation.z=1.5;this.play(a,'Death');}const s=this.g.world.siteById(a.site);if(s&&\"'!this.list.some(other=>other.site===s.id&&other.kind==='\"'soldier'&&\"'!other.dead)){s.cleared=true;s.clearedAt=this.g.absoluteHours;this.g.toast('\"'POST CLEARED / THE ROAD WILL REMEMBER',4);}this.g.sound.play('flesh',.4);}\n flee(a){if(\"'!a.displaced){a.displaced=true;this.g.ledger.displaced++;}a.state='\"'fleeing';}\n tick(dt){this.pathBudget=2;this.aiClock+=dt;const g=this.g;for(const a of this.list){const distance=Math.hypot(a.x-g.pos.x,a.z-g.pos.z);if(a.dead||distance>270)continue;a.shotCD-=dt;if(a.kind==='soldier'){if(g.round&&\"'!g.round.session.isHost)continue;this.ensureBody(a);const fi=g.world.fire.index(a.x,a.z);if(fi>=0&&g.world.fire.state[fi]===1&&a.burn<=0){a.burn=5;g.say(a.faction,'\"'Who lit that?');}if(a.burn>0){a.burn-=dt;a.hp-=dt*23;if(a.hp<=0){this.kill(a);continue;}}a.think-=dt;if(a.think<=0){a.think=.1;a.brain.tick(.1);}let move=new THREE.Vector3();if(a.burn>0){move.set(Math.sin(a.yaw),0,Math.cos(a.yaw));a.controller.speed=5;}else if(a.state==='alert'&&distance>26||a.state==='searching'){const waypoint=a.path?.[a.pathI||0];if(waypoint){const tx=Array.isArray(waypoint)?waypoint[0]:waypoint.x,tz=Array.isArray(waypoint)?waypoint[2]:waypoint.z;move.set(tx-a.x,0,tz-a.z);if(move.length()<2)a.pathI++;}else move.set((a.last?.[0]??a.home[0])-a.x,0,(a.last?.[1]??a.home[1])-a.z);if(move.length()>1)move.normalize();a.controller.speed=3.1;}else if(a.state==='idle'){const t=g.clock*.13+a.home[0];move.set(Math.cos(t)*.25,0,Math.sin(t)*.25);a.yaw=Math.atan2(move.x,move.z);}a.controller.setInput(move,false,false);a.controller.fixedUpdate(dt);const p=a.controller.feet;a.x=p.x;a.y=p.y;a.z=p.z;this.play(a,a.burn>0?'BurnPanic':move.length()>.1?'Walk':a.state==='alert'?'AimIdle':'Idle');}else if(a.kind==='civilian'){if(g.shotAge<.5||g.world.fire.state[g.world.fire.index(a.x,a.z)]===1)this.flee(a);if(a.state==='fleeing'){const dx=a.x-g.pos.x,dz=a.z-g.pos.z,d=Math.hypot(dx,dz)||1;a.x+=dx/d*dt*3.8;a.z+=dz/d*dt*3.8;a.y=this.g.world.heightAt(a.x,a.z);a.yaw=Math.atan2(dx,dz);this.play(a,'Run');}else{a.x=a.home[0]+Math.sin(g.clock*.12+a.home[0])*3;a.z=a.home[1]+Math.cos(g.clock*.12+a.home[1])*3;a.y=this.g.world.heightAt(a.x,a.z);this.play(a,'Walk');}}}}\n update(dt){for(const a of this.list){const d=Math.hypot(a.x-this.g.pos.x,a.z-this.g.pos.z);a.view.visible=d<320;if(\"'!a.view.visible)continue;if(a.ragdoll){a.ragdoll.sync();continue;}a.view.position.set(a.x,a.y,a.z);a.view.rotation.y=a.yaw;a.mixer.update(dt);}}\n reset(){for(const a of this.list){if(a.kind==='\"'soldier'){a.ragdoll?.dispose?.();a.ragdoll=null;a.dead=false;a.hp=100*this.g.tuning.enemyHealth;a.x=a.home[0];a.z=a.home[1];a.y=this.g.world.heightAt(a.x,a.z);a.controller?.teleport([a.x,a.y+.1,a.z]);a.controller?.body.setEnabled(true);a.state='idle';a.suspicion=0;a.burn=0;}}}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > src/combat/viewmodel.js <<'EOF'\nimport {THREE,buildModel,compileClips,setLookLayer,toonMaterial,PALETTE,model} from '../../pixel-engine.js';\nimport {VIEW_DEFS,HAND_RIG,HAND_CLIPS} from '../art/viewmodels.js';\nexport function toolDef(kind){const p={metal:'slate',dark:'night',skin:'orange',glass:'mist',red:'red',paper:'sand',green:'green'};const box=(s,at,c)=>({box:s,at,c});let parts=[];\n if(kind==='Tablet')parts=[{cyl:[.06,.1,.06],at:[0,0,0],c:'paper'},box([.065,.025,.065],[0,.065,0],'red')];\n else if(kind==='Syrette')parts=[{cyl:[.025,.13,.025],at:[0,0,0],c:'glass'},box([.04,.02,.04],[0,.08,0],'red'),box([.008,.06,.008],[0,-.09,0],'metal')];\n else if(kind==='Cauterise')parts=[box([.05,.08,.025],[0,0,0],'metal'),{cone:[.015,.05,.015],at:[0,.07,0],c:'paper',glow:true}];\n else if(kind==='Finger')parts=[box([.03,.1,.035],[0,0,0],'skin')];\n else if(kind==='Shrapnel')parts=[box([.03,.04,.18],[0,0,-.08],'metal'),box([.04,.06,.1],[0,0,.06],'dark')];\n else if(kind==='Wrench')parts=[box([.035,.035,.28],[0,0,0],'metal'),box([.08,.04,.035],[0,0,-.16],'metal'),box([.02,.04,.065],[-.03,0,-.19],'metal'),box([.02,.04,.065],[.03,0,-.19],'metal')];\n else parts=[box([.025,.025,.18],[-.025,0,0],'red'),box([.025,.025,.18],[.025,0,0],'red'),box([.02,.035,.08],[-.02,0,-.12],'metal'),box([.02,.035,.08],[.02,0,-.12],'metal')];\n return model({id:'tool-'+kind.toLowerCase(),about:'Held field tool '+kind,tags:['tool','viewmodel'],floats:true,collider:'none',palette:p,parts});}\nexport class Hands {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.group=new THREE.Group();this.group.name='FirstPersonHands';this.group.position.set(.19,-.24,-.43);this.root=new THREE.Group();this.group.add(this.root);setLookLayer(this.group,'actors');ctx.scene.add(ctx.camera.camera);ctx.camera.camera.add(this.group);this.current='';this.action='';this.actionTime=0;this.ads=0;this.kick=0;this.tool=null;this.muzzle=new THREE.Mesh(new THREE.ConeGeometry(.035,.16,4),new THREE.MeshBasicNodeMaterial({color:PALETTE.sand}));this.muzzle.rotation.x=-Math.PI/2;this.muzzle.visible=false;this.group.add(this.muzzle);}\n equip(id){if(this.current===id)return;this.current=id;this.root.clear();const def=VIEW_DEFS.find(d=>d.id==='view-'+id)||VIEW_DEFS[0];const b=buildModel(def);this.view=b.object;this.root.add(this.view);this.view.traverse(o=>{if(o.isMesh){o.castShadow=false;o.receiveShadow=false;}});this.mixer=new THREE.AnimationMixer(this.view);const clips=compileClips(HAND_CLIPS,HAND_RIG,this.view);this.clips=Object.fromEntries(clips.map(c=>[c.name,c]));this.mixer.addEventListener('finished',()=>{this.action='';this.mixer.stopAllAction();});this.action='';}\n animate(name){if(\"'!this.clips?.[name])return;this.mixer.stopAllAction();const a=this.mixer.clipAction(this.clips[name]);a.setLoop(name==='\"'Wrench'?THREE.LoopRepeat:THREE.LoopOnce,name==='Wrench'?Infinity:1);a.clampWhenFinished=false;a.reset().play();this.action=name;this.actionTime=0;if(this.tool){this.tool.removeFromParent();this.tool=null;}if(['Tablet','Syrette','Pliers','Shrapnel','Finger','Cauterise','Wrench'].includes(name)){this.tool=buildModel(toolDef(name)).object;this.tool.position.set(0,.06,-.08);this.view.getObjectByName('HandR').add(this.tool);}}\n shoot(){this.kick=1;this.animate('Fire');this.muzzle.visible=true;this.muzzle.position.set(0,.065,this.current==='m38'||this.current==='flare'?-.4:-.82);}\n update(dt){const g=this.g;this.equip(g.weapon?.id||'cane');this.mixer?.update(dt);this.actionTime+=dt;if(\"'!this.action&&this.tool){this.tool.removeFromParent();this.tool=null;}this.kick=Math.max(0,this.kick-dt*18);this.muzzle.visible=this.kick>.65;this.ads+=(Number(g.aim)-this.ads)*Math.min(1,dt*12);const moving=g.moving&&!g.vehicle?1:0;this.group.position.set(.19*(1-this.ads),-.24+.08*this.ads+Math.sin(g.clock*9)*.008*moving,-.43+this.ads*.13+this.kick*.025);this.group.rotation.z=Math.sin(g.clock*4.5)*.01*moving;this.view.getObjectByName('\"'Rust').visible=(g.weapon?.cond??100)<60;this.view.getObjectByName('Tape').visible=(g.weapon?.cond??100)<30;this.group.visible=['campaign','round','attract'].includes(g.mode)&&\"'!g.mapUp&&!g.trackerUp&&!g.monocular&&!g.vehicle&&g.screen!=='\"'ending'&&g.body?.rescueTime<=0;const cam=this.ctx.camera.camera,desired=g.monocular?16:g.aim?(g.weapon?.id==='empire'?12:45):g.settings.fov;cam.fov+=(desired-cam.fov)*Math.min(1,dt*12);cam.updateProjectionMatrix();}\n}\nEOF\ncat > src/body/health.js <<'EOF'\nexport class Body {\n constructor(g){this.g=g;this.lastDamage=0;this.lastType='bullet';this.burning=0;this.busy=null;this.rescueTime=0;this.surgeries=0;this.fever={active:false,age:0,next:720,clearing:0,attacks:0};}\n damage(n,type='bullet'){const g=this.g;if(g.cheats.god||this.rescueTime>0||g.mode==='attract')return;if(g.round){g.round.damage(g.round.session.me,n*g.tuning.playerDamageTaken);g.hp=g.round.players[g.round.session.me]?.hp??100;return;}g.hp=Math.max(0,g.hp-n*g.tuning.playerDamageTaken);this.lastDamage=g.clock;this.lastType=type;g.combatAge=0;g.ctx.engine.shake.add(.15);g.sound.play('flesh',.3);if(this.busy?.kind==='surgery'){this.busy=null;g.hands.action='';}if(g.hp<=0)this.down();}\n down(){const g=this.g,b=g.buddies.find(b=>b.met&&\"'!b.dead&&!b.down&&b.readyAt<=g.absoluteHours);if(b){this.rescueTime=4;g.hp=b.id==='\"'mags'?60:40;b.readyAt=g.absoluteHours+24;if(g.rng.body.chance(g.tuning.buddyWoundChance))b.readyAt+=24;g.ledger.rescues++;g.say(b.id,b.id==='mags'?'Not today. Today you owe me money.':'You owe me a truck. You owe me several trucks.');g.cam.override={position:[g.pos.x,g.pos.y+.5,g.pos.z],target:[g.pos.x,g.pos.y+7,g.pos.z-4]};g.hands.animate('Syrette');}else{g.hp=0;g.screen='dead';g.ui.open('dead');}}\n heal(){const g=this.g;if(this.busy)return false;if(g.hp<20){const kinds=['Pliers','Shrapnel','Finger','Cauterise'],kind=this.lastType==='fire'?'Cauterise':kinds[(this.surgeries++)%3];this.busy={kind:'surgery',animation:kind,left:4};g.hands.animate(kind);g.sound.play(kind==='Cauterise'?'lighter':kind==='Finger'?'finger':kind==='Shrapnel'?'knife':'pliers');g.sound.play('grunt',.7);return true;}if(g.syrettes>0&&g.hp<100){g.syrettes--;this.busy={kind:'heal',left:.8};g.hands.animate('Syrette');g.sound.play('syrette');return true;}return false;}\n attackFever(){if(this.g.cheats.noFever)return;this.fever.active=true;this.fever.age=0;this.fever.clearing=0;this.fever.attacks++;this.g.say('aster','The fever. The country keeps its own time.');this.g.sound.play('heartbeat');}\n tablet(){const g=this.g;if(this.busy||\"'!this.fever.active||g.tablets<=0)return false;g.tablets--;this.busy={kind:'\"'tablet',left:1};g.hands.animate('Tablet');g.sound.play('tablet');return true;}\n collapse(){const g=this.g;g.stones=Math.floor(g.stones*.8);g.absoluteHours+=4;g.hour=(g.hour+4)%24;const p=g.nearestSafehouse();g.teleport(p.at[0],p.at[1]+5);g.hp=Math.max(g.hp,40);this.fever.active=false;this.fever.age=0;this.fever.next=g.clock+(g.tuning.feverMinutes-Math.min(2,g.act-1))*60;g.say('odile','You missed four hours. The debt kept working.');}\n tick(dt){const g=this.g;if(this.rescueTime>0){this.rescueTime-=dt;if(this.rescueTime<=0)g.cam.override=null;else if(g.cam.override)g.cam.override.position[2]+=dt*1.4;}if(this.busy){this.busy.left-=dt;if(this.busy.left<=0){if(this.busy.kind==='heal')g.hp=Math.min(100,g.hp+40);if(this.busy.kind==='surgery')g.hp=40;if(this.busy.kind==='tablet'){this.fever.clearing=5;this.fever.next=g.clock+g.tuning.feverMinutes*60+g.rng.body.range(-120,120);}this.busy=null;}}\n const i=g.world.fire.index(g.pos.x,g.pos.z);if(i>=0&&g.world.fire.state[i]===1)this.burning=2;else this.burning=Math.max(0,this.burning-dt);if(g.world.terrain.classify(g.pos.x,g.pos.z)==='water')this.burning=0;if(this.burning>0)this.damage(g.tuning.fireDamage*dt,'fire');if(g.hp>0&&g.hp<100&&g.clock-this.lastDamage>5&&\"'!this.burning)g.hp=Math.min(Math.ceil(g.hp/20)*20,g.hp+dt*3);\n if(this.fever.clearing>0){this.fever.clearing-=dt;if(this.fever.clearing<=0){this.fever.active=false;this.fever.age=0;}}else if(this.fever.active){this.fever.age+=dt;if(this.fever.age>25)this.collapse();}else if(g.clock>this.fever.next&&!g.cheats.noFever)this.attackFever();}\n}\nEOF\ncat > src/actors/actors.js <<'\"'EOF'\nimport {THREE,CharacterController,buildModel,compileClips,HERO_CLIPS,HERO_RIG,Ragdoll,HERO_RAGDOLL,BehaviorTree,bt,NavGrid,setLookLayer} from '../../pixel-engine.js';\nimport {MODELS} from '../art/models.js';\nimport {ACTOR_CLIPS} from '../art/clips.js';\nimport {angle,clamp} from '../core/math.js';\nconst BARKS={concord:['There\"'! In the grass!'\"','Who lit that?','It is stuck\"'! It is stuck again!'\"','Leave him, he is already gone.','Report your position.','That is our road.','Check the trees.','One more invoice.','Keep the flank.','Movement at the ridge.','They are burning the field.','Watch the fire.','Out of the smoke.','Reloading.','I saw someone.'],harvest:['There\"'! In the grass!'\"','Who lit that?','It is stuck\"'! It is stuck again!'\"','Leave him, he is already gone.','Behind the truck.','For the harvest.','Find the contractor.','Cut the road.','Keep your head down.','I cannot see him.','The grass is moving.','Watch the wind.','There goes the field.','Do not follow the flames.','Where is our pay?']};\nexport class Actors {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.list=[];this.handles=new Map();this.nav=new NavGrid(640,640,{cell:2,origin:[-640,0,-640]});this.pathBudget=2;this.aiClock=0;this.serial=0;this.rng=ctx.random.fork('ai');for(const site of g.world.sites)if(site.guards)this.remann(site);for(const o of g.world.objects.filter(o=>o.person))this.spawn({id:o.person,kind:'speaker',model:o.person,x:o.x,z:o.z,hp:1000,site:'mile-forty'});for(let i=0;i<12;i++)this.spawn({kind:'civilian',model:'civilian',x:(i%2?-260:0)+this.rng.range(-15,15),z:(i%2?240:40)+this.rng.range(-15,15),hp:100,site:i%2?'three-wells':'mile-forty'});}\n remann(s){for(let i=0;i<s.guards;i++){const a=i/s.guards*Math.PI*2,x=s.at[0]+Math.cos(a)*(12+i%3*3),z=s.at[1]+Math.sin(a)*(12+i%3*3);this.spawn({kind:'soldier',model:s.faction==='harvest'?'harvest':'soldier',faction:s.faction,x,z,hp:100*this.g.tuning.enemyHealth,site:s.id,role:i===0?'mg':'rifle',yaw:a});}}\n spawn(data){const a={id:data.id||'actor-'+this.serial++,kind:'soldier',faction:'concord',hp:100,state:'idle',suspicion:0,burn:0,shotCD:1,think:0,yaw:0,home:[data.x,data.z],dead:false,...data};a.y=this.g.world.heightAt(a.x,a.z);a.view=buildModel(data.model||'soldier',{catalog:MODELS,palette:{skin:this.rng.pick(['plum','orange','sand','red'])}}).object;a.view.position.set(a.x,a.y,a.z);a.view.rotation.y=a.yaw;setLookLayer(a.view,'actors');this.ctx.scene.add(a.view);a.mixer=new THREE.AnimationMixer(a.view);const clips=compileClips([...HERO_CLIPS.filter(c=>['Idle','Walk','Run','HitReact','Death','Wave','Sit'].includes(c.name)),...ACTOR_CLIPS],{...HERO_RIG,spine:undefined},a.view);a.actions=Object.fromEntries(clips.map(c=>[c.name,a.mixer.clipAction(c)]));a.anim='';if(a.kind==='soldier'){const gun=buildModel('stone-case',{catalog:MODELS}).object;gun.scale.set(.16,.2,1.6);gun.rotation.x=Math.PI/2;gun.position.set(0,-.02,.11);a.view.getObjectByName('HandR')?.add(gun);a.brain=new BehaviorTree(bt.selector('soldier',bt.sequence('burn',bt.condition('alight',()=>a.burn>0),bt.action('panic',()=>{this.panic(a);return 'success';})),bt.action('duty',()=>{this.think(a);return 'success';})),{});}this.list.push(a);return a;}\n ensureBody(a){if(a.controller||a.dead||a.kind\"'!=='\"'soldier')return;a.controller=new CharacterController(this.ctx.physics,{position:[a.x,a.y+.05,a.z],speed:3.1,jumpSpeed:0,gravity:-24,radius:.3,halfHeight:.5});this.ctx.physics.tag(a.controller.collider,'npc');this.handles.set(a.controller.collider.handle,a);}\n play(a,clip){if(a.anim===clip)return;a.actions[a.anim]?.fadeOut(.15);const action=a.actions[clip]||a.actions.Idle;if(action){action.reset().fadeIn(.15).play();a.anim=clip;}}\n hostile(a){const g=this.g;if(a.kind\"'!=='\"'soldier')return false;if(g.noFireZone())return false;if(g.pass===a.faction&&\"'!a.betrayed)return false;return true;}\n perception(a){const g=this.g,dx=g.pos.x-a.x,dz=g.pos.z-a.z,d=Math.hypot(dx,dz),night=g.hour<6||g.hour>19;let vision=g.tuning.enemyVision*(g.crouch?.55:1)*(night?.45:1);if(g.crouch&&g.world.fuelAt(g.pos.x,g.pos.z))vision*=.6;if(g.body.burning>0||g.shotAge<.2)vision*=2;const facing=Math.abs(angle(Math.atan2(dx,dz)-a.yaw))<Math.PI/3;return {d,visible:d<vision&&(facing||d<8),heard:(g.shotAge<.4&&d<120)||(g.moving&&d<(g.sprinting?40:25))};}\n los(a){const g=this.g,from=new THREE.Vector3(a.x,a.y+1.4,a.z),to=new THREE.Vector3(g.pos.x,g.pos.y+1.1,g.pos.z).sub(from),d=to.length();to.normalize();const hit=this.ctx.physics.castRay(from,to,d-.7,a.controller?.body);return !hit||this.handles.has(hit.collider?.handle)||hit.collider===g.player.collider;}\n think(a){const g=this.g;if(!this.hostile(a)||g.cheats.invisible){a.state='\"'idle';a.suspicion=0;return;}const sense=this.perception(a),can=sense.visible&&this.los(a);if(can||sense.heard){a.suspicion=clamp(a.suspicion+.1*(can?1:.55),0,1);a.last=[g.pos.x,g.pos.z];a.searchAge=0;if(a.suspicion>.7){if(a.state\"'!=='\"'alert'&&this.rng.chance(.12))g.say(a.faction,this.rng.pick(BARKS[a.faction]));a.state='alert';g.combatAge=0;}else a.state='suspicious';}else{a.searchAge=(a.searchAge||0)+.1;if(a.searchAge>20){a.state='idle';a.suspicion=Math.max(0,a.suspicion-.05);}else if(a.state==='alert')a.state='searching';}if(a.state==='alert'){a.yaw=Math.atan2(g.pos.x-a.x,g.pos.z-a.z);if(a.shotCD<=0&&can){a.shotCD=.3+this.rng.range(.1,.5);if(this.rng.chance(.0015*g.tuning.jamRate)){a.state='jammed';a.shotCD=2.8;this.play(a,'UnjamSwear');g.say(a.faction,'It is stuck\"'! It is stuck again!'\"');return;}g.sound.play('tractor',Math.max(.015,.25*(1-sense.d/140)),-4);const chance=clamp((1-sense.d/140)*.32*g.tuning.enemyAccuracy*(g.sprinting?.6:1),.01,.65);if(this.rng.chance(chance))g.body.damage(9);if(g.buddyActive&&this.rng.chance(.1)){const b=g.buddies.find(b=>b.id===g.buddyActive);if(b&&\"'!b.down&&!b.dead){b.hp-=9;if(b.hp<=0)g.downBuddy(b.id);}}}if(sense.d>26&&this.pathBudget>0&&this.rng.chance(.09)){this.pathBudget--;const target=[g.pos.x+(a.id.length%2?10:-10),0,g.pos.z+8];a.path=this.nav.path([a.x,0,a.z],target);a.pathI=0;}}}\n panic(a){a.state='\"'burning';a.yaw+=this.rng.range(-.8,.8);this.g.world.fire.ignite(a.x,a.z,2);}\n damage(a,n,hitY=1){if(\"'!a||a.dead)return false;if(a.kind==='\"'civilian'){this.flee(a);return false;}if(a.kind==='speaker')return false;a.betrayed=true;a.hp-=n*(hitY>1.45?2.5:hitY<.55?.7:1);a.state='alert';a.suspicion=1;if(a.hp<=0)this.kill(a);else this.play(a,'HitReact');return true;}\n kill(a){if(a.dead)return;a.hp=0;a.dead=true;a.state='dead';this.g.ledger.kills++;if(this.g.round){const p=this.g.round.players[this.g.round.session.me];if(p)p.kills++;}if(a.controller){this.handles.delete(a.controller.collider.handle);a.controller.body.setEnabled(false);}try{a.ragdoll=new Ragdoll(this.ctx.physics,a.view,HERO_RAGDOLL);a.ragdoll.enable({velocity:[0,0,-2]});}catch{a.view.rotation.z=1.5;this.play(a,'Death');}const s=this.g.world.siteById(a.site);if(s&&\"'!this.list.some(other=>other.site===s.id&&other.kind==='\"'soldier'&&\"'!other.dead)){s.cleared=true;s.clearedAt=this.g.absoluteHours;this.g.toast('\"'POST CLEARED / THE ROAD WILL REMEMBER',4);}this.g.sound.play('flesh',.4);}\n flee(a){if(\"'!a.displaced){a.displaced=true;this.g.ledger.displaced++;}a.state='\"'fleeing';}\n tick(dt){this.pathBudget=2;this.aiClock+=dt;const g=this.g;for(const a of this.list){const distance=Math.hypot(a.x-g.pos.x,a.z-g.pos.z);if(a.dead||distance>270)continue;a.shotCD-=dt;if(a.kind==='soldier'){if(g.round&&\"'!g.round.session.isHost)continue;this.ensureBody(a);const fi=g.world.fire.index(a.x,a.z);if(fi>=0&&g.world.fire.state[fi]===1&&a.burn<=0){a.burn=5;g.say(a.faction,'\"'Who lit that?');}if(a.burn>0){a.burn-=dt;a.hp-=dt*23;if(a.hp<=0){this.kill(a);continue;}}a.think-=dt;if(a.think<=0){a.think=.1;a.brain.tick(.1);}let move=new THREE.Vector3();if(a.burn>0){move.set(Math.sin(a.yaw),0,Math.cos(a.yaw));a.controller.speed=5;}else if(a.state==='alert'&&distance>26||a.state==='searching'){const waypoint=a.path?.[a.pathI||0];if(waypoint){const tx=Array.isArray(waypoint)?waypoint[0]:waypoint.x,tz=Array.isArray(waypoint)?waypoint[2]:waypoint.z;move.set(tx-a.x,0,tz-a.z);if(move.length()<2)a.pathI++;}else move.set((a.last?.[0]??a.home[0])-a.x,0,(a.last?.[1]??a.home[1])-a.z);if(move.length()>1)move.normalize();a.controller.speed=3.1;}else if(a.state==='idle'){const t=g.clock*.13+a.home[0];move.set(Math.cos(t)*.25,0,Math.sin(t)*.25);a.yaw=Math.atan2(move.x,move.z);}a.controller.setInput(move,false,false);a.controller.fixedUpdate(dt);const p=a.controller.feet;a.x=p.x;a.y=p.y;a.z=p.z;this.play(a,a.burn>0?'BurnPanic':move.length()>.1?'Walk':a.state==='alert'?'AimIdle':'Idle');}else if(a.kind==='civilian'){if(g.shotAge<.5||g.world.fire.state[g.world.fire.index(a.x,a.z)]===1)this.flee(a);if(a.state==='fleeing'){const dx=a.x-g.pos.x,dz=a.z-g.pos.z,d=Math.hypot(dx,dz)||1;a.x+=dx/d*dt*3.8;a.z+=dz/d*dt*3.8;a.y=this.g.world.heightAt(a.x,a.z);a.yaw=Math.atan2(dx,dz);this.play(a,'Run');}else{a.x=a.home[0]+Math.sin(g.clock*.12+a.home[0])*3;a.z=a.home[1]+Math.cos(g.clock*.12+a.home[1])*3;a.y=this.g.world.heightAt(a.x,a.z);this.play(a,'Walk');}}}}\n update(dt){for(const a of this.list){const d=Math.hypot(a.x-this.g.pos.x,a.z-this.g.pos.z);a.view.visible=d<320;if(\"'!a.view.visible)continue;if(a.ragdoll){a.ragdoll.sync();continue;}a.view.position.set(a.x,a.y,a.z);a.view.rotation.y=a.yaw;a.mixer.update(dt);}}\n reset(){for(const a of this.list){if(a.kind==='\"'soldier'){a.ragdoll?.dispose?.();a.ragdoll=null;a.dead=false;a.hp=100*this.g.tuning.enemyHealth;a.x=a.home[0];a.z=a.home[1];a.y=this.g.world.heightAt(a.x,a.z);a.controller?.teleport([a.x,a.y+.1,a.z]);a.controller?.body.setEnabled(true);a.state='idle';a.suspicion=0;a.burn=0;}}}\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_35","type":"agent_message","text":"The combat, health, and AI code is in place, including weapon wear and jams, fever, surgery, faction passes, and fire panic. I’m wiring up vehicles and missions next, then I’ll test the systems together through both endings."}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > src/vehicles/vehicles.js <<'EOF'\nimport {THREE,Vehicle,buildModel,setLookLayer,toonMaterial,PALETTE} from '../../pixel-engine.js';\nimport {MODELS} from '../art/models.js';\nimport {angle,clamp} from '../core/math.js';\nimport {RAIL} from '../content/roads.js';\nexport class Vehicles {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.list=[];this.serial=0;this.wheelPos=new THREE.Vector3();this.wheelRot=new THREE.Quaternion();this.create('pickup',-8,55,Math.PI*.5,'medicine-truck');this.create('pickup',-125,159,0);this.create('technical',180,110,1,'tanker');this.create('technical',-215,36,0);this.create('cargo-truck',200,467,Math.PI,'pay-truck');this.create('technical',211,450,Math.PI);this.create('technical',189,490,Math.PI);this.create('pickup',40,-152,Math.PI);this.create('pickup',465,-165,0);this.train={t:680,speed:0,view:buildModel('locomotive',{catalog:MODELS}).object,cars:[buildModel('flatcar',{catalog:MODELS}).object,buildModel('flatcar',{catalog:MODELS}).object]};ctx.scene.add(this.train.view,...this.train.cars);this.dash=new THREE.Group();this.dash.position.set(0,-.55,-.6);const dash=new THREE.Mesh(new THREE.BoxGeometry(1.5,.3,.45),toonMaterial(PALETTE.night));this.dash.add(dash);this.steering=new THREE.Mesh(new THREE.TorusGeometry(.2,.022,6,12),toonMaterial(PALETTE.plum));this.steering.position.set(-.27,.2,.2);this.dash.add(this.steering);setLookLayer(this.dash,'actors');ctx.camera.camera.add(this.dash);this.dash.visible=false;}\n create(kind,x,z,yaw=0,id){const g=this.g,rig=new Vehicle(this.ctx.physics,{size:kind==='cargo-truck'?[1.1,.5,2.6]:[.95,.45,2.2],mass:kind==='cargo-truck'?20:12,power:kind==='cargo-truck'?210:160,topSpeed:g.tuning.vehicleTopSpeed,wheelRadius:.42,suspension:.45,stiffness:30,grip:2.6,at:[x,g.world.heightAt(x,z)+1.4,z],yaw});const view=buildModel(kind,{catalog:MODELS}).object;view.position.y=-1.05;const group=new THREE.Group();group.add(view);this.ctx.scene.add(group);this.ctx.physics.bind(rig.body,group);const wheels=[];for(let i=0;i<4;i++){const m=new THREE.Mesh(new THREE.CylinderGeometry(.42,.42,.24,10),toonMaterial(PALETTE.night));m.rotation.z=Math.PI/2;const axle=new THREE.Group();axle.add(m);group.add(axle);wheels.push(axle);}const v={id:id||'vehicle-'+this.serial++,kind,rig,view,group,wheels,hp:100,fire:0,dead:false,lastSpeed:0,initial:{x,z,yaw},patrol:kind==='technical'&&id\"'!=='\"'tanker'};this.list.push(v);return v;}\n position(v){return v.rig.body.translation();}\n enter(v){const g=this.g;if(v.dead)return;g.vehicle=v;g.player.body.setEnabled(false);g.ctx.camera.yaw=v.rig.yaw+Math.PI;g.ctx.camera.pitch=0;g.sound.play('door');g.sound.play('starter');g.emit('steal',v.id);g.toast('E / EXIT     F / MOUNT GUN     C / CAMERA',4);}\n exit(){const g=this.g,v=g.vehicle;if(\"'!v)return;const p=this.position(v),yaw=v.rig.yaw;g.vehicle=null;g.mounted=false;g.chase=false;g.player.body.setEnabled(true);g.teleport(p.x-Math.cos(yaw)*2.1,p.z+Math.sin(yaw)*2.1);g.cam.override=null;g.sound.play('\"'door');}\n damage(v,n){if(\"'!v||v.dead)return;v.hp=Math.max(0,v.hp-n/this.g.tuning.vehicleToughness);if(v.hp<10&&!v.fire)v.fire=8;if(v.hp<=0){v.dead=true;this.g.explode(this.position(v).x,this.position(v).z,7);if(this.g.vehicle===v)this.exit();v.view.traverse(m=>{if(m.isMesh)m.material=toonMaterial(PALETTE.ink);});}}\n repair(v){if(v.dead)return false;v.hp=50;v.fire=0;this.g.hands.animate('\"'Wrench');this.g.sound.play('wrench');this.g.sound.play('starter');this.g.emit('repair',v.id);return true;}\n tick(dt){const g=this.g;for(const v of this.list){const p=this.position(v);v.rig.o.topSpeed=g.tuning.vehicleTopSpeed;v.rig.o.power=(v.kind==='cargo-truck'?210:160)*(v.hp<35?.6:1);let throttle=0,steer=0,brake=false,handbrake=false;if(v===g.vehicle&&\"'!g.screen&&!g.body.busy&&!g.mounted){const axis=g.ctx.input.moveAxis();steer=-axis.x;throttle=axis.y;handbrake=g.ctx.input.isDown('\"'Space','PadCross');if(g.device==='pad'){const tr=g.triggers||[0,0];throttle=tr[1]-tr[0];brake=tr[0]>.2&&v.rig.speed>1;}}\n else if(v.patrol&&Math.hypot(p.x-g.pos.x,p.z-g.pos.z)<180&&g.clock>30){const tx=v.initial.x+Math.sin(g.clock*.02)*32,tz=v.initial.z+Math.cos(g.clock*.02)*25;const target=Math.atan2(tx-p.x,tz-p.z);steer=clamp(angle(target-v.rig.yaw)*1.7,-1,1);throttle=Math.abs(v.rig.speed)<8?.4:0;}\n if(v.hp<=0||v.dead)throttle=0;v.rig.drive({throttle,steer,brake,handbrake},dt);const speed=Math.abs(v.rig.speed);if(v.lastSpeed-speed>5&&v.lastSpeed>8)this.damage(v,(v.lastSpeed-speed)*2);v.lastSpeed=speed;const cell=g.world.fire.index(p.x,p.z);if(cell>=0&&g.world.fire.state[cell]===1)this.damage(v,6*dt);if(v.fire>0){v.fire-=dt;g.world.fire.ignite(p.x,p.z,2);if(v.fire<=0)this.damage(v,200);}if(v===g.vehicle){g.pos.set(p.x,p.y-.4,p.z);if(v.id==='medicine-truck'&&g.mission?.current?.id==='m1'&&g.mission.flags.returning&&\"'!g.mission.flags.stalled){v.hp=0;v.fire=0;v.dead=false;g.mission.flags.stalled=true;g.say('\"'ines','The truck has concluded its contract. Bonnet first.');g.emit('stall',v.id);}}}\n this.train.t+=this.train.speed*dt;if(this.train.t>1350)this.train.t=0;for(const [i,o] of [this.train.view,...this.train.cars].entries()){const p=this.railPoint(this.train.t-i*11);o.position.set(p.x,g.world.heightAt(p.x,p.z)+.15,p.z);o.rotation.y=p.yaw;}if(g.ridingTrain){const p=this.railPoint(this.train.t-11);g.pos.set(p.x,g.world.heightAt(p.x,p.z)+1.5,p.z);}}\n railPoint(t){let d=((t%1350)+1350)%1350;for(let i=1;i<RAIL.length;i++){const a=RAIL[i-1],b=RAIL[i],len=Math.hypot(b[0]-a[0],b[1]-a[1]);if(d<len||i===RAIL.length-1)return {x:a[0]+(b[0]-a[0])*d/len,z:a[1]+(b[1]-a[1])*d/len,yaw:Math.atan2(b[0]-a[0],b[1]-a[1])};d-=len;}return {x:0,z:70,yaw:0};}\n update(dt){for(const v of this.list){for(let i=0;i<4;i++){v.rig.wheelPose(i,this.wheelPos,this.wheelRot,true);v.wheels[i].position.copy(this.wheelPos);v.wheels[i].quaternion.copy(this.wheelRot);}if(v.hp<35&&\"'!v.dead&&this.g.clock%1<dt){const p=this.position(v);this.ctx.particles.burst('\"'smoke',[p.x,p.y+1,p.z],{count:2});}}this.dash.visible=\"'!!this.g.vehicle&&!this.g.chase;this.steering.rotation.z=-this.g.vehicle?.rig.steering||0;}\n reset(){for(const v of this.list){v.hp=100;v.fire=0;v.dead=false;v.rig.reset([v.initial.x,this.g.world.heightAt(v.initial.x,v.initial.z)+1.5,v.initial.z],v.initial.yaw);}this.train.speed=0;}\n}\nEOF\ncat > src/world/map-texture.js <<'\"'EOF'\nimport {THREE,toonMaterial,PALETTE} from '../../pixel-engine.js';\nimport {ROADS,RIVER,RAIL} from '../content/roads.js';\nimport {SITES} from '../content/sites.js';\nimport {clamp} from '../core/math.js';\nconst FONT={A:['010','101','111','101','101'],B:['110','101','110','101','110'],C:['011','100','100','100','011'],D:['110','101','101','101','110'],E:['111','100','110','100','111'],F:['111','100','110','100','100'],G:['011','100','101','101','011'],H:['101','101','111','101','101'],I:['111','010','010','010','111'],J:['001','001','001','101','010'],K:['101','101','110','101','101'],L:['100','100','100','100','111'],M:['101','111','111','101','101'],N:['101','111','111','111','101'],O:['010','101','101','101','010'],P:['110','101','110','100','100'],Q:['010','101','101','111','011'],R:['110','101','110','101','101'],S:['011','100','010','001','110'],T:['111','010','010','010','010'],U:['101','101','101','101','111'],V:['101','101','101','101','010'],W:['101','101','111','111','101'],X:['101','101','010','101','101'],Y:['101','101','010','010','010'],Z:['111','001','010','100','111'],0:['111','101','101','101','111'],1:['010','110','010','010','111'],2:['110','001','010','100','111'],3:['110','001','010','001','110'],4:['101','101','111','001','001'],5:['111','100','110','001','110'],6:['011','100','111','101','111'],7:['111','001','010','010','010'],8:['111','101','111','101','111'],9:['111','101','111','001','110'],'-':['000','000','111','000','000'],'.':['000','000','000','000','010'],':':['000','010','000','010','000']};\nexport class PaperMap {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.w=320;this.h=240;this.data=new Uint8Array(320*240*4);this.base=new Uint8Array(this.data.length);this.texture=new THREE.DataTexture(this.data,320,240);this.texture.colorSpace=THREE.SRGBColorSpace;this.texture.magFilter=this.texture.minFilter=THREE.NearestFilter;this.group=new THREE.Group();this.plane=new THREE.Mesh(new THREE.PlaneGeometry(.51,.3825),toonMaterial(0xffffff,{map:this.texture}));this.plane.rotation.x=-.17;this.group.add(this.plane);this.group.position.set(-.025,-.10,-.43);this.group.visible=false;ctx.camera.camera.add(this.group);this.cursor={x:160,y:120};this.timer=1;this.baseMap();this.data.set(this.base);this.texture.needsUpdate=true;this.light=ctx.lights.request({position:[0,-1000,0],color:PALETTE.sand,intensity:1,radius:3,priority:9});this.tracker=new THREE.Group();const body=new THREE.Mesh(new THREE.BoxGeometry(.1,.16,.04),toonMaterial(PALETTE.plum));const screen=new THREE.Mesh(new THREE.PlaneGeometry(.075,.075),new THREE.MeshBasicNodeMaterial({color:PALETTE.green}));screen.position.set(0,.025,.022);this.tracker.add(body,screen);this.tracker.position.set(-.26,-.13,-.45);ctx.camera.camera.add(this.tracker);this.tracker.visible=false;this.beep=0;}\n pixel(x,y,c,target=this.data){x=Math.round(x);y=Math.round(y);if(x<0||y<0||x>=320||y>=240)return;const i=(x+y*320)*4;target[i]=c[0];target[i+1]=c[1];target[i+2]=c[2];target[i+3]=255;}\n text(x,y,text,c,target=this.data){for(const ch of text.toUpperCase()){const rows=FONT[ch]||[];for(let r=0;r<5;r++)for(let k=0;k<3;k++)if(rows[r]?.[k]==='1')this.pixel(x+k,y+r,c,target);x+=4;}}\n mapPoint(x,z){return [18+(x+640)/1280*221,15+(z+640)/1280*207];}\n line(a,b,c,target=this.data){const dx=b[0]-a[0],dy=b[1]-a[1],n=Math.max(Math.abs(dx),Math.abs(dy));for(let t=0;t<=n;t++)this.pixel(a[0]+dx*t/n,a[1]+dy*t/n,c,target);}\n poly(p,c,target=this.data){for(let i=1;i<p.length;i++)this.line(this.mapPoint(...p[i-1]),this.mapPoint(...p[i]),c,target);}\n baseMap(){for(let y=0;y<240;y++)for(let x=0;x<320;x++){const noise=(x*19+y*37)%13;this.pixel(x,y,x>246?[205+noise,183+noise,143+noise]:[225+noise,207+noise,169+noise],this.base);}for(let z=-630;z<630;z+=8)for(let x=-630;x<630;x+=8){const y=this.g.world.heightAt(x,z),b=this.g.world.heightAt(x+8,z+8);if(Math.floor(y/8)\"'!==Math.floor(b/8)){const [mx,my]=this.mapPoint(x,z);this.pixel(mx,my,[178,158,118],this.base);}}\n for(const p of ROADS)this.poly(p,[157,93,65],this.base);this.poly(RIVER,[70,127,125],this.base);this.poly(RAIL,[78,77,74],this.base);for(let x=18;x<240;x+=28)this.line([x,15],[x,223],[196,182,148],this.base);for(let y=15;y<223;y+=26)this.line([18,y],[239,y],[196,182,148],this.base);for(const s of SITES){const [x,y]=this.mapPoint(...s.at);this.text(x+3,y,s.name.slice(0,16),[75,72,64],this.base);}this.text(252,12,'\"'THE KETTLE',[67,65,57],this.base);this.text(252,21,'COMPANY',[108,85,58],this.base);this.text(252,29,'SURVEY 08',[108,85,58],this.base);this.text(25,228,'1:6400     NO BORDER IS NATURAL',[105,85,63],this.base);}\n draw(){this.data.set(this.base);for(const i of this.g.world.fire.scorched){const [x,z]=this.g.world.fire.coords(i);this.pixel(...this.mapPoint(x,z),[49,50,44]);}for(const s of this.g.world.sites.filter(s=>s.seen)){const [x,y]=this.mapPoint(...s.at);for(let i=-1;i<=1;i++)for(let k=-1;k<=1;k++)this.pixel(x+i,y+k,s.cleared?[68,99,73]:[120,55,48]);}const [x,y]=this.mapPoint(this.g.pos.x,this.g.pos.z);for(let a=-2;a<=2;a++)for(let b=-2;b<=2;b++)this.pixel(x+a,y+b,[180,50,43]);const yaw=this.ctx.camera.yaw;this.line([x,y],[x-Math.sin(yaw)*7,y-Math.cos(yaw)*7],[125,39,32]);if(this.g.waypoint){const [wx,wy]=this.mapPoint(this.g.waypoint.x,this.g.waypoint.z);this.line([wx-3,wy],[wx+3,wy],[190,65,42]);this.line([wx,wy-3],[wx,wy+3],[190,65,42]);}this.text(252,50,this.g.mission?.current?.title?.slice(0,15)||'FIELD NOTES',[92,51,38]);const words=(this.g.mission?.objective()||'A MAP IS A PROMISE MADE BY SOMEONE WHO HAS ALREADY LEFT.').split(' ');let ln='',yy=62;for(const word of words){if((ln+word).length>15){this.text(252,yy,ln,[75,65,52]);yy+=8;ln='';}ln+=word+' ';}if(ln)this.text(252,yy,ln,[75,65,52]);this.text(252,172,'WIND '+Math.round(this.g.wind.speed)+'M/S',[85,70,50]);this.text(252,187,Math.floor(this.g.hour)+':'+String(Math.floor(this.g.hour%1*60)).padStart(2,'0'),[85,70,50]);this.text(252,210,'E.H.',[121,57,42]);this.line([this.cursor.x-3,this.cursor.y],[this.cursor.x+3,this.cursor.y],[100,60,40]);this.line([this.cursor.x,this.cursor.y-3],[this.cursor.x,this.cursor.y+3],[100,60,40]);this.texture.needsUpdate=true;}\n select(x=this.cursor.x,y=this.cursor.y){const wx=(x-18)/221*1280-640,wz=(y-15)/207*1280-640;const site=this.g.world.sites.slice().sort((a,b)=>Math.hypot(a.at[0]-wx,a.at[1]-wz)-Math.hypot(b.at[0]-wx,b.at[1]-wz))[0];this.g.waypoint=site&&Math.hypot(site.at[0]-wx,site.at[1]-wz)<95?{x:site.at[0],z:site.at[1],name:site.name}:{x:clamp(wx,-630,630),z:clamp(wz,-630,630),name:'MARKED GROUND'};this.g.sound.play('paper');this.draw();}\n trackerDistance(){const cases=this.g.world.objects.filter(o=>o.tag==='case'&&o.active);return Math.min(9999,...cases.map(o=>Math.hypot(this.g.pos.x-o.x,this.g.pos.z-o.z)));}\n update(dt){this.group.visible=this.g.mapUp;this.tracker.visible=this.g.trackerUp&&\"'!this.g.mapUp;if(this.g.mapUp){const i=this.ctx.input,axis=i.padAxis;this.cursor.x=clamp(this.cursor.x+axis.x*dt*100+i.mouseDelta.x*.3,18,240);this.cursor.y=clamp(this.cursor.y-axis.y*dt*100+i.mouseDelta.y*.3,15,222);this.timer+=dt;if(this.timer>.5){this.timer=0;this.draw();}this.light.position.copy(this.ctx.camera.camera.position);this.light.intensity=2;}else this.light.intensity=0;if(this.g.trackerUp){this.beep-=dt;const d=this.trackerDistance();if(this.beep<=0&&d<130){this.beep=.13+Math.min(1.5,d/70);this.g.sound.play('\"'tracker',.5,d<20?4:0);}}}\n}\nEOF\ncat >> ../PROGRESS.md <<'EOF'\n\n## Pipeline checkpoint\n- Title is **Hardly Far Cry**, real RNG selection 11/50. Source kit 0.46.0 downloaded and byte-unmodified at dev root; zip in vendor.\n- Read entire PLAN.md, TASK.md, engine GUIDE.md and ASSETS.md; hub protocol and arena reference downloaded in vendor/hub.\n- Single-file esbuild pipeline works. \"'`node tests/run.mjs --only hub`: **4 passed, 0 failed** (all required scenarios).\n- Implemented data-driven sites/roads/weapons/tuning, 256x256 persistent fire, custom world/vehicle/person models, hands clips, audio synthesis/music/voices, terrain/world, AI, body and vehicle systems, held map. Most are awaiting integration into src/game.js.\n- Structural model check: 35 models, zero invalid; flame texture valid. Fire trial: 2.92 m/s at 5 m/s wind.\n- tests/ISSUES.md currently records 1 critical issue, fixed (custom cage/library id collision).\n\n## Next work\n1. Integrate complete game controller, menus, combat, body/world/vehicles/map and mission runner. Current src/game.js is still pipeline game and must be replaced.\n2. Data mission script, all endings, buddies, save/load, attract, dev tools and settings.\n3. Full tests via tests/run.mjs, real playthroughs both endings, browser/hub rechecks after integrated world, responsive screenshots including WebKit fallback. Toolkit cheatsheet file was absent at supplied path; viewport-matrix exists on PATH.\n4. Final polished single HTML in root, exact exit-interview.json with honest feedback and in-game About, DESIGNERS.md, progress completion.\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > src/vehicles/vehicles.js <<'EOF'\nimport {THREE,Vehicle,buildModel,setLookLayer,toonMaterial,PALETTE} from '../../pixel-engine.js';\nimport {MODELS} from '../art/models.js';\nimport {angle,clamp} from '../core/math.js';\nimport {RAIL} from '../content/roads.js';\nexport class Vehicles {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.list=[];this.serial=0;this.wheelPos=new THREE.Vector3();this.wheelRot=new THREE.Quaternion();this.create('pickup',-8,55,Math.PI*.5,'medicine-truck');this.create('pickup',-125,159,0);this.create('technical',180,110,1,'tanker');this.create('technical',-215,36,0);this.create('cargo-truck',200,467,Math.PI,'pay-truck');this.create('technical',211,450,Math.PI);this.create('technical',189,490,Math.PI);this.create('pickup',40,-152,Math.PI);this.create('pickup',465,-165,0);this.train={t:680,speed:0,view:buildModel('locomotive',{catalog:MODELS}).object,cars:[buildModel('flatcar',{catalog:MODELS}).object,buildModel('flatcar',{catalog:MODELS}).object]};ctx.scene.add(this.train.view,...this.train.cars);this.dash=new THREE.Group();this.dash.position.set(0,-.55,-.6);const dash=new THREE.Mesh(new THREE.BoxGeometry(1.5,.3,.45),toonMaterial(PALETTE.night));this.dash.add(dash);this.steering=new THREE.Mesh(new THREE.TorusGeometry(.2,.022,6,12),toonMaterial(PALETTE.plum));this.steering.position.set(-.27,.2,.2);this.dash.add(this.steering);setLookLayer(this.dash,'actors');ctx.camera.camera.add(this.dash);this.dash.visible=false;}\n create(kind,x,z,yaw=0,id){const g=this.g,rig=new Vehicle(this.ctx.physics,{size:kind==='cargo-truck'?[1.1,.5,2.6]:[.95,.45,2.2],mass:kind==='cargo-truck'?20:12,power:kind==='cargo-truck'?210:160,topSpeed:g.tuning.vehicleTopSpeed,wheelRadius:.42,suspension:.45,stiffness:30,grip:2.6,at:[x,g.world.heightAt(x,z)+1.4,z],yaw});const view=buildModel(kind,{catalog:MODELS}).object;view.position.y=-1.05;const group=new THREE.Group();group.add(view);this.ctx.scene.add(group);this.ctx.physics.bind(rig.body,group);const wheels=[];for(let i=0;i<4;i++){const m=new THREE.Mesh(new THREE.CylinderGeometry(.42,.42,.24,10),toonMaterial(PALETTE.night));m.rotation.z=Math.PI/2;const axle=new THREE.Group();axle.add(m);group.add(axle);wheels.push(axle);}const v={id:id||'vehicle-'+this.serial++,kind,rig,view,group,wheels,hp:100,fire:0,dead:false,lastSpeed:0,initial:{x,z,yaw},patrol:kind==='technical'&&id\"'!=='\"'tanker'};this.list.push(v);return v;}\n position(v){return v.rig.body.translation();}\n enter(v){const g=this.g;if(v.dead)return;g.vehicle=v;g.player.body.setEnabled(false);g.ctx.camera.yaw=v.rig.yaw+Math.PI;g.ctx.camera.pitch=0;g.sound.play('door');g.sound.play('starter');g.emit('steal',v.id);g.toast('E / EXIT     F / MOUNT GUN     C / CAMERA',4);}\n exit(){const g=this.g,v=g.vehicle;if(\"'!v)return;const p=this.position(v),yaw=v.rig.yaw;g.vehicle=null;g.mounted=false;g.chase=false;g.player.body.setEnabled(true);g.teleport(p.x-Math.cos(yaw)*2.1,p.z+Math.sin(yaw)*2.1);g.cam.override=null;g.sound.play('\"'door');}\n damage(v,n){if(\"'!v||v.dead)return;v.hp=Math.max(0,v.hp-n/this.g.tuning.vehicleToughness);if(v.hp<10&&!v.fire)v.fire=8;if(v.hp<=0){v.dead=true;this.g.explode(this.position(v).x,this.position(v).z,7);if(this.g.vehicle===v)this.exit();v.view.traverse(m=>{if(m.isMesh)m.material=toonMaterial(PALETTE.ink);});}}\n repair(v){if(v.dead)return false;v.hp=50;v.fire=0;this.g.hands.animate('\"'Wrench');this.g.sound.play('wrench');this.g.sound.play('starter');this.g.emit('repair',v.id);return true;}\n tick(dt){const g=this.g;for(const v of this.list){const p=this.position(v);v.rig.o.topSpeed=g.tuning.vehicleTopSpeed;v.rig.o.power=(v.kind==='cargo-truck'?210:160)*(v.hp<35?.6:1);let throttle=0,steer=0,brake=false,handbrake=false;if(v===g.vehicle&&\"'!g.screen&&!g.body.busy&&!g.mounted){const axis=g.ctx.input.moveAxis();steer=-axis.x;throttle=axis.y;handbrake=g.ctx.input.isDown('\"'Space','PadCross');if(g.device==='pad'){const tr=g.triggers||[0,0];throttle=tr[1]-tr[0];brake=tr[0]>.2&&v.rig.speed>1;}}\n else if(v.patrol&&Math.hypot(p.x-g.pos.x,p.z-g.pos.z)<180&&g.clock>30){const tx=v.initial.x+Math.sin(g.clock*.02)*32,tz=v.initial.z+Math.cos(g.clock*.02)*25;const target=Math.atan2(tx-p.x,tz-p.z);steer=clamp(angle(target-v.rig.yaw)*1.7,-1,1);throttle=Math.abs(v.rig.speed)<8?.4:0;}\n if(v.hp<=0||v.dead)throttle=0;v.rig.drive({throttle,steer,brake,handbrake},dt);const speed=Math.abs(v.rig.speed);if(v.lastSpeed-speed>5&&v.lastSpeed>8)this.damage(v,(v.lastSpeed-speed)*2);v.lastSpeed=speed;const cell=g.world.fire.index(p.x,p.z);if(cell>=0&&g.world.fire.state[cell]===1)this.damage(v,6*dt);if(v.fire>0){v.fire-=dt;g.world.fire.ignite(p.x,p.z,2);if(v.fire<=0)this.damage(v,200);}if(v===g.vehicle){g.pos.set(p.x,p.y-.4,p.z);if(v.id==='medicine-truck'&&g.mission?.current?.id==='m1'&&g.mission.flags.returning&&\"'!g.mission.flags.stalled){v.hp=0;v.fire=0;v.dead=false;g.mission.flags.stalled=true;g.say('\"'ines','The truck has concluded its contract. Bonnet first.');g.emit('stall',v.id);}}}\n this.train.t+=this.train.speed*dt;if(this.train.t>1350)this.train.t=0;for(const [i,o] of [this.train.view,...this.train.cars].entries()){const p=this.railPoint(this.train.t-i*11);o.position.set(p.x,g.world.heightAt(p.x,p.z)+.15,p.z);o.rotation.y=p.yaw;}if(g.ridingTrain){const p=this.railPoint(this.train.t-11);g.pos.set(p.x,g.world.heightAt(p.x,p.z)+1.5,p.z);}}\n railPoint(t){let d=((t%1350)+1350)%1350;for(let i=1;i<RAIL.length;i++){const a=RAIL[i-1],b=RAIL[i],len=Math.hypot(b[0]-a[0],b[1]-a[1]);if(d<len||i===RAIL.length-1)return {x:a[0]+(b[0]-a[0])*d/len,z:a[1]+(b[1]-a[1])*d/len,yaw:Math.atan2(b[0]-a[0],b[1]-a[1])};d-=len;}return {x:0,z:70,yaw:0};}\n update(dt){for(const v of this.list){for(let i=0;i<4;i++){v.rig.wheelPose(i,this.wheelPos,this.wheelRot,true);v.wheels[i].position.copy(this.wheelPos);v.wheels[i].quaternion.copy(this.wheelRot);}if(v.hp<35&&\"'!v.dead&&this.g.clock%1<dt){const p=this.position(v);this.ctx.particles.burst('\"'smoke',[p.x,p.y+1,p.z],{count:2});}}this.dash.visible=\"'!!this.g.vehicle&&!this.g.chase;this.steering.rotation.z=-this.g.vehicle?.rig.steering||0;}\n reset(){for(const v of this.list){v.hp=100;v.fire=0;v.dead=false;v.rig.reset([v.initial.x,this.g.world.heightAt(v.initial.x,v.initial.z)+1.5,v.initial.z],v.initial.yaw);}this.train.speed=0;}\n}\nEOF\ncat > src/world/map-texture.js <<'\"'EOF'\nimport {THREE,toonMaterial,PALETTE} from '../../pixel-engine.js';\nimport {ROADS,RIVER,RAIL} from '../content/roads.js';\nimport {SITES} from '../content/sites.js';\nimport {clamp} from '../core/math.js';\nconst FONT={A:['010','101','111','101','101'],B:['110','101','110','101','110'],C:['011','100','100','100','011'],D:['110','101','101','101','110'],E:['111','100','110','100','111'],F:['111','100','110','100','100'],G:['011','100','101','101','011'],H:['101','101','111','101','101'],I:['111','010','010','010','111'],J:['001','001','001','101','010'],K:['101','101','110','101','101'],L:['100','100','100','100','111'],M:['101','111','111','101','101'],N:['101','111','111','111','101'],O:['010','101','101','101','010'],P:['110','101','110','100','100'],Q:['010','101','101','111','011'],R:['110','101','110','101','101'],S:['011','100','010','001','110'],T:['111','010','010','010','010'],U:['101','101','101','101','111'],V:['101','101','101','101','010'],W:['101','101','111','111','101'],X:['101','101','010','101','101'],Y:['101','101','010','010','010'],Z:['111','001','010','100','111'],0:['111','101','101','101','111'],1:['010','110','010','010','111'],2:['110','001','010','100','111'],3:['110','001','010','001','110'],4:['101','101','111','001','001'],5:['111','100','110','001','110'],6:['011','100','111','101','111'],7:['111','001','010','010','010'],8:['111','101','111','101','111'],9:['111','101','111','001','110'],'-':['000','000','111','000','000'],'.':['000','000','000','000','010'],':':['000','010','000','010','000']};\nexport class PaperMap {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.w=320;this.h=240;this.data=new Uint8Array(320*240*4);this.base=new Uint8Array(this.data.length);this.texture=new THREE.DataTexture(this.data,320,240);this.texture.colorSpace=THREE.SRGBColorSpace;this.texture.magFilter=this.texture.minFilter=THREE.NearestFilter;this.group=new THREE.Group();this.plane=new THREE.Mesh(new THREE.PlaneGeometry(.51,.3825),toonMaterial(0xffffff,{map:this.texture}));this.plane.rotation.x=-.17;this.group.add(this.plane);this.group.position.set(-.025,-.10,-.43);this.group.visible=false;ctx.camera.camera.add(this.group);this.cursor={x:160,y:120};this.timer=1;this.baseMap();this.data.set(this.base);this.texture.needsUpdate=true;this.light=ctx.lights.request({position:[0,-1000,0],color:PALETTE.sand,intensity:1,radius:3,priority:9});this.tracker=new THREE.Group();const body=new THREE.Mesh(new THREE.BoxGeometry(.1,.16,.04),toonMaterial(PALETTE.plum));const screen=new THREE.Mesh(new THREE.PlaneGeometry(.075,.075),new THREE.MeshBasicNodeMaterial({color:PALETTE.green}));screen.position.set(0,.025,.022);this.tracker.add(body,screen);this.tracker.position.set(-.26,-.13,-.45);ctx.camera.camera.add(this.tracker);this.tracker.visible=false;this.beep=0;}\n pixel(x,y,c,target=this.data){x=Math.round(x);y=Math.round(y);if(x<0||y<0||x>=320||y>=240)return;const i=(x+y*320)*4;target[i]=c[0];target[i+1]=c[1];target[i+2]=c[2];target[i+3]=255;}\n text(x,y,text,c,target=this.data){for(const ch of text.toUpperCase()){const rows=FONT[ch]||[];for(let r=0;r<5;r++)for(let k=0;k<3;k++)if(rows[r]?.[k]==='1')this.pixel(x+k,y+r,c,target);x+=4;}}\n mapPoint(x,z){return [18+(x+640)/1280*221,15+(z+640)/1280*207];}\n line(a,b,c,target=this.data){const dx=b[0]-a[0],dy=b[1]-a[1],n=Math.max(Math.abs(dx),Math.abs(dy));for(let t=0;t<=n;t++)this.pixel(a[0]+dx*t/n,a[1]+dy*t/n,c,target);}\n poly(p,c,target=this.data){for(let i=1;i<p.length;i++)this.line(this.mapPoint(...p[i-1]),this.mapPoint(...p[i]),c,target);}\n baseMap(){for(let y=0;y<240;y++)for(let x=0;x<320;x++){const noise=(x*19+y*37)%13;this.pixel(x,y,x>246?[205+noise,183+noise,143+noise]:[225+noise,207+noise,169+noise],this.base);}for(let z=-630;z<630;z+=8)for(let x=-630;x<630;x+=8){const y=this.g.world.heightAt(x,z),b=this.g.world.heightAt(x+8,z+8);if(Math.floor(y/8)\"'!==Math.floor(b/8)){const [mx,my]=this.mapPoint(x,z);this.pixel(mx,my,[178,158,118],this.base);}}\n for(const p of ROADS)this.poly(p,[157,93,65],this.base);this.poly(RIVER,[70,127,125],this.base);this.poly(RAIL,[78,77,74],this.base);for(let x=18;x<240;x+=28)this.line([x,15],[x,223],[196,182,148],this.base);for(let y=15;y<223;y+=26)this.line([18,y],[239,y],[196,182,148],this.base);for(const s of SITES){const [x,y]=this.mapPoint(...s.at);this.text(x+3,y,s.name.slice(0,16),[75,72,64],this.base);}this.text(252,12,'\"'THE KETTLE',[67,65,57],this.base);this.text(252,21,'COMPANY',[108,85,58],this.base);this.text(252,29,'SURVEY 08',[108,85,58],this.base);this.text(25,228,'1:6400     NO BORDER IS NATURAL',[105,85,63],this.base);}\n draw(){this.data.set(this.base);for(const i of this.g.world.fire.scorched){const [x,z]=this.g.world.fire.coords(i);this.pixel(...this.mapPoint(x,z),[49,50,44]);}for(const s of this.g.world.sites.filter(s=>s.seen)){const [x,y]=this.mapPoint(...s.at);for(let i=-1;i<=1;i++)for(let k=-1;k<=1;k++)this.pixel(x+i,y+k,s.cleared?[68,99,73]:[120,55,48]);}const [x,y]=this.mapPoint(this.g.pos.x,this.g.pos.z);for(let a=-2;a<=2;a++)for(let b=-2;b<=2;b++)this.pixel(x+a,y+b,[180,50,43]);const yaw=this.ctx.camera.yaw;this.line([x,y],[x-Math.sin(yaw)*7,y-Math.cos(yaw)*7],[125,39,32]);if(this.g.waypoint){const [wx,wy]=this.mapPoint(this.g.waypoint.x,this.g.waypoint.z);this.line([wx-3,wy],[wx+3,wy],[190,65,42]);this.line([wx,wy-3],[wx,wy+3],[190,65,42]);}this.text(252,50,this.g.mission?.current?.title?.slice(0,15)||'FIELD NOTES',[92,51,38]);const words=(this.g.mission?.objective()||'A MAP IS A PROMISE MADE BY SOMEONE WHO HAS ALREADY LEFT.').split(' ');let ln='',yy=62;for(const word of words){if((ln+word).length>15){this.text(252,yy,ln,[75,65,52]);yy+=8;ln='';}ln+=word+' ';}if(ln)this.text(252,yy,ln,[75,65,52]);this.text(252,172,'WIND '+Math.round(this.g.wind.speed)+'M/S',[85,70,50]);this.text(252,187,Math.floor(this.g.hour)+':'+String(Math.floor(this.g.hour%1*60)).padStart(2,'0'),[85,70,50]);this.text(252,210,'E.H.',[121,57,42]);this.line([this.cursor.x-3,this.cursor.y],[this.cursor.x+3,this.cursor.y],[100,60,40]);this.line([this.cursor.x,this.cursor.y-3],[this.cursor.x,this.cursor.y+3],[100,60,40]);this.texture.needsUpdate=true;}\n select(x=this.cursor.x,y=this.cursor.y){const wx=(x-18)/221*1280-640,wz=(y-15)/207*1280-640;const site=this.g.world.sites.slice().sort((a,b)=>Math.hypot(a.at[0]-wx,a.at[1]-wz)-Math.hypot(b.at[0]-wx,b.at[1]-wz))[0];this.g.waypoint=site&&Math.hypot(site.at[0]-wx,site.at[1]-wz)<95?{x:site.at[0],z:site.at[1],name:site.name}:{x:clamp(wx,-630,630),z:clamp(wz,-630,630),name:'MARKED GROUND'};this.g.sound.play('paper');this.draw();}\n trackerDistance(){const cases=this.g.world.objects.filter(o=>o.tag==='case'&&o.active);return Math.min(9999,...cases.map(o=>Math.hypot(this.g.pos.x-o.x,this.g.pos.z-o.z)));}\n update(dt){this.group.visible=this.g.mapUp;this.tracker.visible=this.g.trackerUp&&\"'!this.g.mapUp;if(this.g.mapUp){const i=this.ctx.input,axis=i.padAxis;this.cursor.x=clamp(this.cursor.x+axis.x*dt*100+i.mouseDelta.x*.3,18,240);this.cursor.y=clamp(this.cursor.y-axis.y*dt*100+i.mouseDelta.y*.3,15,222);this.timer+=dt;if(this.timer>.5){this.timer=0;this.draw();}this.light.position.copy(this.ctx.camera.camera.position);this.light.intensity=2;}else this.light.intensity=0;if(this.g.trackerUp){this.beep-=dt;const d=this.trackerDistance();if(this.beep<=0&&d<130){this.beep=.13+Math.min(1.5,d/70);this.g.sound.play('\"'tracker',.5,d<20?4:0);}}}\n}\nEOF\ncat >> ../PROGRESS.md <<'EOF'\n\n## Pipeline checkpoint\n- Title is **Hardly Far Cry**, real RNG selection 11/50. Source kit 0.46.0 downloaded and byte-unmodified at dev root; zip in vendor.\n- Read entire PLAN.md, TASK.md, engine GUIDE.md and ASSETS.md; hub protocol and arena reference downloaded in vendor/hub.\n- Single-file esbuild pipeline works. \"'`node tests/run.mjs --only hub`: **4 passed, 0 failed** (all required scenarios).\n- Implemented data-driven sites/roads/weapons/tuning, 256x256 persistent fire, custom world/vehicle/person models, hands clips, audio synthesis/music/voices, terrain/world, AI, body and vehicle systems, held map. Most are awaiting integration into src/game.js.\n- Structural model check: 35 models, zero invalid; flame texture valid. Fire trial: 2.92 m/s at 5 m/s wind.\n- tests/ISSUES.md currently records 1 critical issue, fixed (custom cage/library id collision).\n\n## Next work\n1. Integrate complete game controller, menus, combat, body/world/vehicles/map and mission runner. Current src/game.js is still pipeline game and must be replaced.\n2. Data mission script, all endings, buddies, save/load, attract, dev tools and settings.\n3. Full tests via tests/run.mjs, real playthroughs both endings, browser/hub rechecks after integrated world, responsive screenshots including WebKit fallback. Toolkit cheatsheet file was absent at supplied path; viewport-matrix exists on PATH.\n4. Final polished single HTML in root, exact exit-interview.json with honest feedback and in-game About, DESIGNERS.md, progress completion.\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > src/content/dialogue.js <<'EOF'\nexport const NOTES=[\n 'A map is a promise made by someone who has already left.',\n 'I drew the river where the Company wanted it. The river was slow to comply, but it came round.',\n 'Both armies buy from me. The Concord pays on time. The Harvest pays in grain and tears. I have eaten better on the tears.',\n 'You will have noticed that you follow roads. I drew those too.',\n 'Grass is the only honest border. It goes where the wind tells it, and it keeps a record.',\n 'By now you have burned what I marked. Look at it from the ridge. Tell me that is not a line.'\n];\nexport const EPIGRAPHS=['A border is where the ink ran out.','Distance is an opinion held by the comfortable.','The river has refused every name we gave it.','A good road makes a bad war longer.','Never survey a graveyard from memory.','The Company counted the stones. It never counted the hands.','There is no scale for what a village costs.','I marked the well. Someone marked the people.','Rain is a temporary revision.','The road is straight because nobody was consulted.','Every empty house still has an address.','The last line should be drawn in pencil.'];\nexport const DIALOGUE={\n m0:[['bakr','Forty miles of track and not one station that remembers its name.'],['bakr','They paint the signs over. Whoever won last.'],['bakr','You have the look of a man who read about this place. Reading is a good way to visit.'],['bakr','Up there they will ask you which side. Say yes.'],['bakr','That map of yours. Open it. You will need both hands.'],['bakr','The Company built this line for stones. People were extra freight.'],['bakr','Mile Forty. They kept the number. Numbers do not take sides.'],['harrow','MIND THE FEVER. YOU ARE LATE ALREADY. E.H.']],\n m1:[['odile','Three tablets. The fourth you pay for. I do not mean in stones.'],['odile','I do not need you to be good. I need you to be on time.'],['odile','Sixty-one beds. Forty blankets. You are the math.'],['odile','Medicine for Three Wells. The truck is outside.'],['tibor','Everything on this rack has been returned at least once.'],['tibor','It fires. If you want it to fire twice, that is a different price.'],['odile','When the bolt sticks, pull it again. It will want an argument.'],['odile','Bring the truck back. I did not say intact.'],['mags','Hold still. No, you cannot feel that. No, that is normal. Hold still.']],\n m2:[['tibor','Ines owes me a plane. The Concord has put her in a cage.'],['tibor','Get her out. I will settle for the pilot.'],['ines','I flew for both of them. Neither paid. Get in.'],['ines','The cage was not in either contract.'],['ines','You can wait for dark. They sleep like paid men.'],['ines','Those tablets of yours. Count them before you count the bullets.'],['ines','If you fall, I can get you out. Once. Then I need a day.'],['ines','You owe me a truck. You owe me several trucks.']],\n m3:[['vance','We do not burn villages. We conclude them.'],['vance','The East Siding stores fuel stolen from this government.'],['vance','The wind will assist. We have budgeted for that.'],['ines','Take their tanker at the east post. Nobody shoots their own fuel.'],['vance','Three reservoirs. An uncomplicated invoice.'],['ines','Start upwind. Leave crosswind. That lesson cost me a plane.'],['vance','A flare pistol. Kindly return it unloaded.'],['vance','Your invoice will be honoured, regrettably.']],\n m4:[['ansa','You said less people. Fewer. Fewer people. It will matter by the end of the month.'],['ansa','The payroll crosses the salt. It does not pay the men who mine it.'],['dov','Two fingers I left in this country. I came back to see what they are doing.'],['dov','A man asked me to mine his own road, so he would know where it was safe. He was right for a week.'],['ansa','Take the case. Leave the bookkeeping.'],['dov','Charges on the road. A patient kind of punctuation.'],['ansa','The tracker finds stones. It has no opinion of their owners.'],['dov','There is no such thing as an empty truck. Only one waiting for someone.']],\n m5:[['vance','The water question has been a great sorrow to this office.'],['vance','Three Wells has been feeding the Harvest. The pump must stop.'],['mags','Open the bypass first. Give the cistern a minute.'],['mags','They will have water. You will have a smaller invoice.'],['odile','Count the beds again. Then tell me it was a military target.'],['vance','Infrastructure is a regrettably broad word.'],['mags','I can carry one patient. A village takes longer.'],['vance','We consider the question concluded.']],\n m6:[['ansa','Burn the field. A hungry man learns to read the wind.'],['ansa','The ammunition is under the grain. An instructive arrangement.'],['ines','I will take the far side. You owe me the near one.'],['dov','A field has one exit until the wind changes.'],['mags','I have counted the dressings. Do not make me count again.'],['pell','I know this land. That used to count for something.'],['ines','The wind. It has turned.'],['ines','Do not let it be the fire. Please. Not the fire.'],['ansa','The work is finished. I did not ask how.']],\n m7:[['harrow','You have drawn well. Come and see.'],['ines','Both flags at the mine. Neither one is ours.'],['dov','Two men argued over a hole. They made it larger.'],['mags','I will hold the east road. Come in from the pit.'],['harrow','One contractor, paid in advance, to walk the Kettle.'],['harrow','Signed: Emil Harrow. Surveyor. Employer.'],['odile','The truce has ended. Tibor has moved his stock.'],['harrow','A road may be an instrument of mercy. Even this one.']],\n m8:[['odile','Hold the platform. They need two minutes.'],['bakr','This station used to be a school. Nobody arrived late twice.'],['odile','Sixty-one beds. Today there are wheels.'],['bakr','The grass will not burn twice. He says that is the road.'],['ines','Keep the gun on the ridge. I will keep the train on the rails.'],['bakr','I have carried everything they could dig out of this country.'],['bakr','For once I am carrying something they should have left in it.'],['odile','They are walking now. Find him.']],\n m9:[['harrow','You are late. I said you would be. Sit down, it will not take long, neither of us has long.'],['harrow','I drew the lines that started this. I would like to draw one more.'],['harrow','You have been drawing for me. Look at it.'],['harrow','Burned grass cannot burn twice. It is the only safe road in the country, and you built it for wages.'],['harrow','I paid for the contract. The map was a set of instructions.'],['harrow','The armies have copies of every lie I told.'],['harrow','This sheet is the truth. One path through the mines.'],['harrow','You can finish your contract. Or you can finish the road.']],\n end:[['ines','That case is heavier than the map. Let us divide the difference.'],['dov','Three men found a stone. You know how the rest goes.'],['mags','I kept you alive. The account is open.'],['harrow','A map is a promise made by someone who has already left.'],['odile','They have reached the scar. Do not let it end here.'],['bakr','First light. The only timetable this country keeps.'],['aster','The rain stops. The grass waits.'],['harrow','Last survey: the road is open.']]\n};\nexport const ENDINGS={walk:'You reached the border with a case of stones and a map nobody else will ever use. The guard asks your trade. You tell him: surveyor.',column:'They crossed at first light, walking on ash. Nobody has asked who lit it. The fever is not finished with you, and you are out of tablets. It is a good view.'};\nEOF\ncat > src/content/missions.js <<'EOF'\nconst go=(site,text,r=35)=>({do:'goto',site,text,r});\nconst ev=(tag,text,n=1)=>({do:'use',tag,text,n});\nconst report=(to)=>({do:'report',to,text:'REPORT TO '+to.toUpperCase()});\nexport const MISSIONS=[\n {id:'m0',title:'THE GOODS LINE',giver:'bakr',requires:[],pay:0,hour:16.5,steps:[ev('map','RAISE THE MAP / M'),{do:'ride',time:55,text:'RIDE THE GOODS LINE / ENTER TO SKIP'},{do:'script',script:'arrival',text:'MIND THE FEVER.'}]},\n {id:'m1',title:'MERCY RUN',giver:'odile',requires:['m0'],pay:5,steps:[ev('tablet','TAKE A TABLET / H'),ev('medicine','TAKE THE CLINIC MEDICINE'),{do:'steal',tag:'medicine-truck',text:'GET INTO THE MEDICINE TRUCK'},go('three-wells','DRIVE TO THREE WELLS',40),{do:'deliver',tag:'medicine-delivery',text:'DELIVER THE MEDICINE'},go('p2','RETURN BY THE WEST CHECKPOINT',45),{do:'kill',site:'p2',n:3,text:'CLEAR A WAY THROUGH THE POST'},ev('repair','REPAIR THE TRUCK / HOLD E'),ev('heal','USE A SYRETTE / Q'),report('odile')]},\n {id:'m2',title:'A CAGE AT THE POST',giver:'tibor',requires:['m1'],pay:8,steps:[go('ranger-post','REACH THE RANGER POST',65),{do:'kill',site:'ranger-post',n:5,text:'CLEAR THE CAGE YARD'},ev('ines-cage','OPEN INES\\\\'S CAGE / HOLD E'),go('pump-shed','BRING INES TO THE PUMP SHED',30)]},\n {id:'m3',title:'FUEL FOR THE PEACE',giver:'vance',requires:['m2'],pay:15,wind:{x:-.8,z:-.6,speed:5},alt:{buddy:'ines',text:'STEAL THE TANKER FIRST',bonus:5,tag:'tanker'},steps:[go('east-siding','REACH THE EAST SIDING',95),{do:'destroy',tag:'fuel-tank',n:3,text:'BURN ALL THREE RESERVOIRS'}, {do:'leave',site:'east-siding',r:140,text:'GET OUT OF THE SIDING'},report('vance')],scar:'A'},\n {id:'m4',title:'SEED MONEY',giver:'ansa',requires:['m2'],pay:20,alt:{buddy:'dov',text:'PLANT A CHARGE ON THE PAYROLL ROAD',bonus:5,tag:'charge'},steps:[go('salt-pan','INTERCEPT THE PAYROLL ON THE SALT',80),{do:'destroy',tag:'pay-truck',n:1,text:'STOP THE PAYROLL TRUCK'}, {do:'collect',tag:'payroll',text:'FIND THE CASE WITH YOUR TRACKER'},report('ansa')]},\n {id:'m5',title:'THE WATER QUESTION',giver:'vance',requires:['m3'],pay:20,alt:{buddy:'mags',text:'FILL THE CISTERN BEFORE THE BLAST',bonus:-10,tag:'bypass'},steps:[go('pump-station','REACH THE PUMP STATION',40),{do:'destroy',tag:'pump',n:1,text:'DESTROY THE WATER PUMP'},report('vance')]},\n {id:'m6',title:'THE LONG FIELD',giver:'ansa',requires:['m4'],pay:25,hour:22,steps:[go('long-field','REACH THE LONG FIELD',60),{do:'burn',site:'long-field',n:65,text:'BURN THE CROP / FIRE THE AMMO BUNKER'}, {do:'script',script:'buddy-down',text:'THE WIND HAS TURNED'},ev('buddy-choice','REACH YOUR FRIEND / E: SYRETTE / F: FINISH IT'),{do:'leave',site:'long-field',r:120,text:'GET CLEAR OF THE FIELD'},report('ansa')],scar:'B'},\n {id:'m7',title:'THE CUT',giver:'board',requires:['m5','m6'],pay:15,steps:[go('cut','REACH THE SLUICE HOUSE',80),{do:'kill',site:'cut',n:5,text:'CROSS THE PIT UNDER FIRE'}, {do:'collect',tag:'harrow-ledger',text:'TAKE THE SURVEYOR\\\\'S LEDGER'}, {do:'leave',site:'cut',r:110,text:'LEAVE THE MINE WITH HIS LEDGER'}],scar:'C'},\n {id:'m8',title:'LAST TRAIN',giver:'odile',requires:['m7'],pay:0,steps:[go('mile-forty','REACH THE STATION',45),{do:'hold',site:'mile-forty',time:120,r:65,text:'HOLD THE PLATFORM / 120 SECONDS'},ev('board-train','BOARD THE FLATCAR'),{do:'ride',time:60,text:'KEEP THE RIDGE CLEAR / RIDE THE LAST TRAIN'}]},\n {id:'m9',title:'THE SURVEYOR',giver:'board',requires:['m8'],pay:0,hour:22,weather:'storm',steps:[go('observatory','CLIMB TO THE OBSERVATORY',55),report('harrow'),{do:'choice',choices:[{id:'spare',text:'LEAVE HIM HIS LAST MINUTES'},{id:'kill-harrow',text:'FINISH YOUR CONTRACT'}],text:'THE MAN WHO PAID YOU TO FIND HIM'}, {do:'choice',choices:[{id:'column',text:'GIVE THE SHEET TO THE COLUMN'},{id:'walk',text:'KEEP THE SHEET / WALK OUT'}],text:'WHO GETS THE ONLY HONEST MAP?'}]},\n {id:'end',title:'THE PASS',giver:'board',requires:['m9'],pay:0,steps:[go('pass','REACH THE BORDER PASS',55),{do:'hold',site:'pass',r:85,time:85,text:'HOLD THE PASS BEHIND YOU'},{do:'burn',site:'pass',n:12,text:'LIGHT THE LAST GRASS / G'}]}\n];\nexport const MISSION_BY_ID=Object.fromEntries(MISSIONS.map(m=>[m.id,m]));\nEOF\ncat > src/missions/runner.js <<'EOF'\nimport {MISSIONS,MISSION_BY_ID} from '../content/missions.js';\nimport {DIALOGUE} from '../content/dialogue.js';\nimport {SITE_BY_ID} from '../content/sites.js';\nexport class MissionRunner {\n constructor(g){this.g=g;this.current=null;this.index=0;this.done=[];this.flags={};this.elapsed=0;this.progress=0;this.alt=false;this.altDone=false;this.dialogClock=0;this.lineIndex=0;this.choicesShown=false;this.killStart=0;this.events=[];}\n available(giver){return MISSIONS.filter(m=>m.id\"'!=='\"'m0'&&m.id\"'!=='\"'m1'&&\"'!this.done.includes(m.id)&&m.requires.every(r=>this.done.includes(r))&&(!giver||m.giver===giver||giver==='\"'board'));}\n objective(){return this.current?.steps[this.index]?.text||'FIND WORK AT MILE FORTY / E AT THE NOTICE BOARD';}\n step(){return this.current?.steps[this.index];}\n start(id){const m=MISSION_BY_ID[id];if(\"'!m)return false;const g=this.g;this.current=m;this.index=0;this.elapsed=0;this.progress=0;this.flags={};this.alt=false;this.altDone=false;this.choicesShown=false;this.dialogClock=0;this.lineIndex=0;g.pass=['\"'concord','harvest'][m.giver==='ansa'?1:0];if(\"'!['\"'vance','ansa'].includes(m.giver))g.pass=null;if(m.hour\"'!==undefined)g.hour=m.hour;if(m.weather)g.weather=m.weather;if(m.wind)Object.assign(g.wind,m.wind);this.killStart=g.ledger.kills;\n if(id==='\"'m0'){g.teleport(-120,77);g.ridingTrain=true;g.vehicles.train.t=520;g.vehicles.train.speed=4;g.tablets=0;}\n if(id==='m1'){g.ridingTrain=false;g.vehicles.train.speed=0;g.teleport(-13,49);g.tablets=3;g.hp=65;g.body.attackFever();g.weapon.cond=45;}\n if(id==='m3'){g.unlock('flare');g.equip('flare');}\n if(id==='m4'){g.metBuddy('dov');g.trackerUnlocked=true;}\n if(id==='m5')g.metBuddy('mags');\n if(id==='m6'){const b=g.buddies.filter(b=>b.met&&\"'!b.dead).sort((a,b)=>b.trust-a.trust)[0]||g.buddies.find(b=>b.id==='\"'pell');b.met=true;g.buddyActive=b.id;g.spawnBuddy(b.id);}\n if(id==='m7'){g.truce=false;g.act=3;g.world.fire.ignite(180,-280,12);}\n if(id==='m9'){g.world.fire.extinguish();g.mapUp=true;}\n g.toast(m.title,7);g.say(...DIALOGUE[id][0]);this.lineIndex=1;this.waypoint();g.emit('mission-start',id);return true;}\n waypoint(){const s=this.step();if(\"'!s)return;const site=SITE_BY_ID[s.site];const o=this.g.world.object(s.tag||s.to);const v=this.g.vehicles.list.find(v=>v.id===s.tag);if(site)this.g.waypoint={x:site.at[0],z:site.at[1],name:site.name};else if(o)this.g.waypoint={x:o.x,z:o.z,name:o.name};else if(v){const p=this.g.vehicles.position(v);this.g.waypoint={x:p.x,z:p.z,name:v.id.toUpperCase()};}}\n emit(type,tag,value=1){this.events.push({type,tag,value});if(this.current?.alt&&tag===this.current.alt.tag)this.altDone=true;}\n advance(){if(!this.current)return;this.index++;this.elapsed=0;this.progress=0;this.choicesShown=false;this.events=[];if(this.index>=this.current.steps.length)this.complete();else{this.g.toast(this.objective(),6);this.waypoint();}}\n choose(id){const s=this.step();if(s?.do!=='\"'choice'||\"'!s.choices.some(c=>c.id===id))return false;this.flags[id]=true;if(id==='\"'column'||id==='walk')this.g.endingChoice=id;if(id==='kill-harrow'){this.g.ledger.harrowKilled=true;this.g.hands.shoot();this.g.sound.play('m38');}this.g.ui.close();this.advance();return true;}\n complete(){const g=this.g,m=this.current;const pay=Math.round((m.pay+(this.alt&&this.altDone?(m.alt?.bonus||0):0))*g.tuning.stonesReward);g.stones+=pay;g.ledger.earned+=pay;if(\"'!this.done.includes(m.id))this.done.push(m.id);if(m.scar)g.world.fire.burnStrip(m.scar,24);if(this.alt&&this.altDone){const b=g.buddies.find(b=>b.id===m.alt.buddy);if(b)b.trust++;}g.toast('\"'CONTRACT CONCLUDED / '+pay+' STONES',7);g.sound.play('ui-confirm');g.pass=null;\n if(m.id==='m0'){this.current=null;this.start('m1');return;}\n if(m.id==='m1'){g.tablets+=3;g.metBuddy('mags');g.world.siteById('pump-shed').cleared=true;}\n if(m.id==='m2'){g.metBuddy('ines');g.world.siteById('ranger-post').cleared=true;g.act=2;}\n if(m.id==='m5'&&\"'!this.flags.bypass){for(const a of g.actors.list.filter(a=>a.kind==='\"'civilian'&&a.site==='three-wells'))g.actors.flee(a);g.clinicDebt=true;}\n if(m.id==='m7')g.truce=false;\n if(m.id==='m8'){g.ridingTrain=false;g.vehicles.train.speed=0;g.column=true;}\n if(m.id==='m9'){this.current=null;g.mapUp=false;this.start('end');g.save();return;}\n if(m.id==='end'){this.current=null;g.endCampaign();return;}\n this.current=null;g.buddyActive=null;g.save();}\n acceptAlt(){const a=this.current?.alt;if(\"'!a)return;this.alt=true;this.g.buddyActive=a.buddy;this.g.spawnBuddy(a.buddy);this.g.say(a.buddy,a.text);}\n tick(dt){if(!this.current)return;const g=this.g,s=this.step();this.dialogClock+=dt;if(this.dialogClock>13&&this.lineIndex<DIALOGUE[this.current.id].length){this.dialogClock=0;let [who,line]=DIALOGUE[this.current.id][this.lineIndex++];if(g.buddies.some(b=>b.id===who&&b.dead))return;if(this.current.id==='\"'m6'&&who==='ines')who=g.buddyActive||'pell';g.say(who,line);}this.elapsed+=dt;const site=SITE_BY_ID[s.site],d=site?Math.hypot(g.pos.x-site.at[0],g.pos.z-site.at[1]):Infinity;const event=this.events.find(e=>e.tag===s.tag||e.type===s.tag||(s.do==='report'&&e.tag===s.to));let done=false;\n if(s.do==='goto')done=d<(s.r||35);if(s.do==='leave')done=d>s.r;if(['use','deliver','collect','steal','report','talk'].includes(s.do))done=\"'!!event;\n if(s.do==='\"'kill'){const dead=g.actors.list.filter(a=>a.site===s.site&&a.kind==='soldier'&&a.dead).length;done=dead>=(s.n||1);this.progress=dead/(s.n||1);}\n if(s.do==='destroy'){const objs=g.world.objects.filter(o=>o.tag===s.tag);const veh=g.vehicles.list.filter(v=>v.id===s.tag);const n=objs.filter(o=>\"'!o.active).length+veh.filter(v=>v.dead).length;done=n>=s.n;this.progress=n/s.n;}\n if(s.do==='\"'burn'){let n=0;for(const i of [...g.world.fire.scorched,...g.world.fire.active]){const [x,z]=g.world.fire.coords(i);if(Math.hypot(x-site.at[0],z-site.at[1])<(s.site==='pass'?75:105))n++;}this.progress=n/s.n;done=n>=s.n;}\n if(s.do==='hold'){if(d<(s.r||60))this.progress+=dt/s.time;done=this.progress>=1;}\n if(s.do==='ride')done=this.elapsed>s.time||event?.type==='skip';\n if(s.do==='script'){if(s.script==='arrival'){g.ridingTrain=false;g.body.attackFever();g.teleport(-13,49);done=true;}if(s.script==='buddy-down'){g.wind.x=-g.wind.x;g.wind.z=-g.wind.z;g.downBuddy(g.buddyActive);done=true;}}\n if(s.do==='choice'&&\"'!this.choicesShown){this.choicesShown=true;g.mapUp=false;g.ui.open('\"'choice');}\n this.events=[];if(done)this.advance();}\n save(){return {id:this.current?.id,index:this.index,done:this.done,flags:this.flags,elapsed:this.elapsed,progress:this.progress,alt:this.alt,altDone:this.altDone,lineIndex:this.lineIndex};}\n load(s){this.current=MISSION_BY_ID[s.id]||null;Object.assign(this,{index:s.index,done:s.done,flags:s.flags,elapsed:s.elapsed,progress:s.progress,alt:s.alt,altDone:s.altDone,lineIndex:s.lineIndex,choicesShown:false});this.waypoint();}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > src/content/dialogue.js <<'EOF'\nexport const NOTES=[\n 'A map is a promise made by someone who has already left.',\n 'I drew the river where the Company wanted it. The river was slow to comply, but it came round.',\n 'Both armies buy from me. The Concord pays on time. The Harvest pays in grain and tears. I have eaten better on the tears.',\n 'You will have noticed that you follow roads. I drew those too.',\n 'Grass is the only honest border. It goes where the wind tells it, and it keeps a record.',\n 'By now you have burned what I marked. Look at it from the ridge. Tell me that is not a line.'\n];\nexport const EPIGRAPHS=['A border is where the ink ran out.','Distance is an opinion held by the comfortable.','The river has refused every name we gave it.','A good road makes a bad war longer.','Never survey a graveyard from memory.','The Company counted the stones. It never counted the hands.','There is no scale for what a village costs.','I marked the well. Someone marked the people.','Rain is a temporary revision.','The road is straight because nobody was consulted.','Every empty house still has an address.','The last line should be drawn in pencil.'];\nexport const DIALOGUE={\n m0:[['bakr','Forty miles of track and not one station that remembers its name.'],['bakr','They paint the signs over. Whoever won last.'],['bakr','You have the look of a man who read about this place. Reading is a good way to visit.'],['bakr','Up there they will ask you which side. Say yes.'],['bakr','That map of yours. Open it. You will need both hands.'],['bakr','The Company built this line for stones. People were extra freight.'],['bakr','Mile Forty. They kept the number. Numbers do not take sides.'],['harrow','MIND THE FEVER. YOU ARE LATE ALREADY. E.H.']],\n m1:[['odile','Three tablets. The fourth you pay for. I do not mean in stones.'],['odile','I do not need you to be good. I need you to be on time.'],['odile','Sixty-one beds. Forty blankets. You are the math.'],['odile','Medicine for Three Wells. The truck is outside.'],['tibor','Everything on this rack has been returned at least once.'],['tibor','It fires. If you want it to fire twice, that is a different price.'],['odile','When the bolt sticks, pull it again. It will want an argument.'],['odile','Bring the truck back. I did not say intact.'],['mags','Hold still. No, you cannot feel that. No, that is normal. Hold still.']],\n m2:[['tibor','Ines owes me a plane. The Concord has put her in a cage.'],['tibor','Get her out. I will settle for the pilot.'],['ines','I flew for both of them. Neither paid. Get in.'],['ines','The cage was not in either contract.'],['ines','You can wait for dark. They sleep like paid men.'],['ines','Those tablets of yours. Count them before you count the bullets.'],['ines','If you fall, I can get you out. Once. Then I need a day.'],['ines','You owe me a truck. You owe me several trucks.']],\n m3:[['vance','We do not burn villages. We conclude them.'],['vance','The East Siding stores fuel stolen from this government.'],['vance','The wind will assist. We have budgeted for that.'],['ines','Take their tanker at the east post. Nobody shoots their own fuel.'],['vance','Three reservoirs. An uncomplicated invoice.'],['ines','Start upwind. Leave crosswind. That lesson cost me a plane.'],['vance','A flare pistol. Kindly return it unloaded.'],['vance','Your invoice will be honoured, regrettably.']],\n m4:[['ansa','You said less people. Fewer. Fewer people. It will matter by the end of the month.'],['ansa','The payroll crosses the salt. It does not pay the men who mine it.'],['dov','Two fingers I left in this country. I came back to see what they are doing.'],['dov','A man asked me to mine his own road, so he would know where it was safe. He was right for a week.'],['ansa','Take the case. Leave the bookkeeping.'],['dov','Charges on the road. A patient kind of punctuation.'],['ansa','The tracker finds stones. It has no opinion of their owners.'],['dov','There is no such thing as an empty truck. Only one waiting for someone.']],\n m5:[['vance','The water question has been a great sorrow to this office.'],['vance','Three Wells has been feeding the Harvest. The pump must stop.'],['mags','Open the bypass first. Give the cistern a minute.'],['mags','They will have water. You will have a smaller invoice.'],['odile','Count the beds again. Then tell me it was a military target.'],['vance','Infrastructure is a regrettably broad word.'],['mags','I can carry one patient. A village takes longer.'],['vance','We consider the question concluded.']],\n m6:[['ansa','Burn the field. A hungry man learns to read the wind.'],['ansa','The ammunition is under the grain. An instructive arrangement.'],['ines','I will take the far side. You owe me the near one.'],['dov','A field has one exit until the wind changes.'],['mags','I have counted the dressings. Do not make me count again.'],['pell','I know this land. That used to count for something.'],['ines','The wind. It has turned.'],['ines','Do not let it be the fire. Please. Not the fire.'],['ansa','The work is finished. I did not ask how.']],\n m7:[['harrow','You have drawn well. Come and see.'],['ines','Both flags at the mine. Neither one is ours.'],['dov','Two men argued over a hole. They made it larger.'],['mags','I will hold the east road. Come in from the pit.'],['harrow','One contractor, paid in advance, to walk the Kettle.'],['harrow','Signed: Emil Harrow. Surveyor. Employer.'],['odile','The truce has ended. Tibor has moved his stock.'],['harrow','A road may be an instrument of mercy. Even this one.']],\n m8:[['odile','Hold the platform. They need two minutes.'],['bakr','This station used to be a school. Nobody arrived late twice.'],['odile','Sixty-one beds. Today there are wheels.'],['bakr','The grass will not burn twice. He says that is the road.'],['ines','Keep the gun on the ridge. I will keep the train on the rails.'],['bakr','I have carried everything they could dig out of this country.'],['bakr','For once I am carrying something they should have left in it.'],['odile','They are walking now. Find him.']],\n m9:[['harrow','You are late. I said you would be. Sit down, it will not take long, neither of us has long.'],['harrow','I drew the lines that started this. I would like to draw one more.'],['harrow','You have been drawing for me. Look at it.'],['harrow','Burned grass cannot burn twice. It is the only safe road in the country, and you built it for wages.'],['harrow','I paid for the contract. The map was a set of instructions.'],['harrow','The armies have copies of every lie I told.'],['harrow','This sheet is the truth. One path through the mines.'],['harrow','You can finish your contract. Or you can finish the road.']],\n end:[['ines','That case is heavier than the map. Let us divide the difference.'],['dov','Three men found a stone. You know how the rest goes.'],['mags','I kept you alive. The account is open.'],['harrow','A map is a promise made by someone who has already left.'],['odile','They have reached the scar. Do not let it end here.'],['bakr','First light. The only timetable this country keeps.'],['aster','The rain stops. The grass waits.'],['harrow','Last survey: the road is open.']]\n};\nexport const ENDINGS={walk:'You reached the border with a case of stones and a map nobody else will ever use. The guard asks your trade. You tell him: surveyor.',column:'They crossed at first light, walking on ash. Nobody has asked who lit it. The fever is not finished with you, and you are out of tablets. It is a good view.'};\nEOF\ncat > src/content/missions.js <<'EOF'\nconst go=(site,text,r=35)=>({do:'goto',site,text,r});\nconst ev=(tag,text,n=1)=>({do:'use',tag,text,n});\nconst report=(to)=>({do:'report',to,text:'REPORT TO '+to.toUpperCase()});\nexport const MISSIONS=[\n {id:'m0',title:'THE GOODS LINE',giver:'bakr',requires:[],pay:0,hour:16.5,steps:[ev('map','RAISE THE MAP / M'),{do:'ride',time:55,text:'RIDE THE GOODS LINE / ENTER TO SKIP'},{do:'script',script:'arrival',text:'MIND THE FEVER.'}]},\n {id:'m1',title:'MERCY RUN',giver:'odile',requires:['m0'],pay:5,steps:[ev('tablet','TAKE A TABLET / H'),ev('medicine','TAKE THE CLINIC MEDICINE'),{do:'steal',tag:'medicine-truck',text:'GET INTO THE MEDICINE TRUCK'},go('three-wells','DRIVE TO THREE WELLS',40),{do:'deliver',tag:'medicine-delivery',text:'DELIVER THE MEDICINE'},go('p2','RETURN BY THE WEST CHECKPOINT',45),{do:'kill',site:'p2',n:3,text:'CLEAR A WAY THROUGH THE POST'},ev('repair','REPAIR THE TRUCK / HOLD E'),ev('heal','USE A SYRETTE / Q'),report('odile')]},\n {id:'m2',title:'A CAGE AT THE POST',giver:'tibor',requires:['m1'],pay:8,steps:[go('ranger-post','REACH THE RANGER POST',65),{do:'kill',site:'ranger-post',n:5,text:'CLEAR THE CAGE YARD'},ev('ines-cage','OPEN INES\\\\'S CAGE / HOLD E'),go('pump-shed','BRING INES TO THE PUMP SHED',30)]},\n {id:'m3',title:'FUEL FOR THE PEACE',giver:'vance',requires:['m2'],pay:15,wind:{x:-.8,z:-.6,speed:5},alt:{buddy:'ines',text:'STEAL THE TANKER FIRST',bonus:5,tag:'tanker'},steps:[go('east-siding','REACH THE EAST SIDING',95),{do:'destroy',tag:'fuel-tank',n:3,text:'BURN ALL THREE RESERVOIRS'}, {do:'leave',site:'east-siding',r:140,text:'GET OUT OF THE SIDING'},report('vance')],scar:'A'},\n {id:'m4',title:'SEED MONEY',giver:'ansa',requires:['m2'],pay:20,alt:{buddy:'dov',text:'PLANT A CHARGE ON THE PAYROLL ROAD',bonus:5,tag:'charge'},steps:[go('salt-pan','INTERCEPT THE PAYROLL ON THE SALT',80),{do:'destroy',tag:'pay-truck',n:1,text:'STOP THE PAYROLL TRUCK'}, {do:'collect',tag:'payroll',text:'FIND THE CASE WITH YOUR TRACKER'},report('ansa')]},\n {id:'m5',title:'THE WATER QUESTION',giver:'vance',requires:['m3'],pay:20,alt:{buddy:'mags',text:'FILL THE CISTERN BEFORE THE BLAST',bonus:-10,tag:'bypass'},steps:[go('pump-station','REACH THE PUMP STATION',40),{do:'destroy',tag:'pump',n:1,text:'DESTROY THE WATER PUMP'},report('vance')]},\n {id:'m6',title:'THE LONG FIELD',giver:'ansa',requires:['m4'],pay:25,hour:22,steps:[go('long-field','REACH THE LONG FIELD',60),{do:'burn',site:'long-field',n:65,text:'BURN THE CROP / FIRE THE AMMO BUNKER'}, {do:'script',script:'buddy-down',text:'THE WIND HAS TURNED'},ev('buddy-choice','REACH YOUR FRIEND / E: SYRETTE / F: FINISH IT'),{do:'leave',site:'long-field',r:120,text:'GET CLEAR OF THE FIELD'},report('ansa')],scar:'B'},\n {id:'m7',title:'THE CUT',giver:'board',requires:['m5','m6'],pay:15,steps:[go('cut','REACH THE SLUICE HOUSE',80),{do:'kill',site:'cut',n:5,text:'CROSS THE PIT UNDER FIRE'}, {do:'collect',tag:'harrow-ledger',text:'TAKE THE SURVEYOR\\\\'S LEDGER'}, {do:'leave',site:'cut',r:110,text:'LEAVE THE MINE WITH HIS LEDGER'}],scar:'C'},\n {id:'m8',title:'LAST TRAIN',giver:'odile',requires:['m7'],pay:0,steps:[go('mile-forty','REACH THE STATION',45),{do:'hold',site:'mile-forty',time:120,r:65,text:'HOLD THE PLATFORM / 120 SECONDS'},ev('board-train','BOARD THE FLATCAR'),{do:'ride',time:60,text:'KEEP THE RIDGE CLEAR / RIDE THE LAST TRAIN'}]},\n {id:'m9',title:'THE SURVEYOR',giver:'board',requires:['m8'],pay:0,hour:22,weather:'storm',steps:[go('observatory','CLIMB TO THE OBSERVATORY',55),report('harrow'),{do:'choice',choices:[{id:'spare',text:'LEAVE HIM HIS LAST MINUTES'},{id:'kill-harrow',text:'FINISH YOUR CONTRACT'}],text:'THE MAN WHO PAID YOU TO FIND HIM'}, {do:'choice',choices:[{id:'column',text:'GIVE THE SHEET TO THE COLUMN'},{id:'walk',text:'KEEP THE SHEET / WALK OUT'}],text:'WHO GETS THE ONLY HONEST MAP?'}]},\n {id:'end',title:'THE PASS',giver:'board',requires:['m9'],pay:0,steps:[go('pass','REACH THE BORDER PASS',55),{do:'hold',site:'pass',r:85,time:85,text:'HOLD THE PASS BEHIND YOU'},{do:'burn',site:'pass',n:12,text:'LIGHT THE LAST GRASS / G'}]}\n];\nexport const MISSION_BY_ID=Object.fromEntries(MISSIONS.map(m=>[m.id,m]));\nEOF\ncat > src/missions/runner.js <<'EOF'\nimport {MISSIONS,MISSION_BY_ID} from '../content/missions.js';\nimport {DIALOGUE} from '../content/dialogue.js';\nimport {SITE_BY_ID} from '../content/sites.js';\nexport class MissionRunner {\n constructor(g){this.g=g;this.current=null;this.index=0;this.done=[];this.flags={};this.elapsed=0;this.progress=0;this.alt=false;this.altDone=false;this.dialogClock=0;this.lineIndex=0;this.choicesShown=false;this.killStart=0;this.events=[];}\n available(giver){return MISSIONS.filter(m=>m.id\"'!=='\"'m0'&&m.id\"'!=='\"'m1'&&\"'!this.done.includes(m.id)&&m.requires.every(r=>this.done.includes(r))&&(!giver||m.giver===giver||giver==='\"'board'));}\n objective(){return this.current?.steps[this.index]?.text||'FIND WORK AT MILE FORTY / E AT THE NOTICE BOARD';}\n step(){return this.current?.steps[this.index];}\n start(id){const m=MISSION_BY_ID[id];if(\"'!m)return false;const g=this.g;this.current=m;this.index=0;this.elapsed=0;this.progress=0;this.flags={};this.alt=false;this.altDone=false;this.choicesShown=false;this.dialogClock=0;this.lineIndex=0;g.pass=['\"'concord','harvest'][m.giver==='ansa'?1:0];if(\"'!['\"'vance','ansa'].includes(m.giver))g.pass=null;if(m.hour\"'!==undefined)g.hour=m.hour;if(m.weather)g.weather=m.weather;if(m.wind)Object.assign(g.wind,m.wind);this.killStart=g.ledger.kills;\n if(id==='\"'m0'){g.teleport(-120,77);g.ridingTrain=true;g.vehicles.train.t=520;g.vehicles.train.speed=4;g.tablets=0;}\n if(id==='m1'){g.ridingTrain=false;g.vehicles.train.speed=0;g.teleport(-13,49);g.tablets=3;g.hp=65;g.body.attackFever();g.weapon.cond=45;}\n if(id==='m3'){g.unlock('flare');g.equip('flare');}\n if(id==='m4'){g.metBuddy('dov');g.trackerUnlocked=true;}\n if(id==='m5')g.metBuddy('mags');\n if(id==='m6'){const b=g.buddies.filter(b=>b.met&&\"'!b.dead).sort((a,b)=>b.trust-a.trust)[0]||g.buddies.find(b=>b.id==='\"'pell');b.met=true;g.buddyActive=b.id;g.spawnBuddy(b.id);}\n if(id==='m7'){g.truce=false;g.act=3;g.world.fire.ignite(180,-280,12);}\n if(id==='m9'){g.world.fire.extinguish();g.mapUp=true;}\n g.toast(m.title,7);g.say(...DIALOGUE[id][0]);this.lineIndex=1;this.waypoint();g.emit('mission-start',id);return true;}\n waypoint(){const s=this.step();if(\"'!s)return;const site=SITE_BY_ID[s.site];const o=this.g.world.object(s.tag||s.to);const v=this.g.vehicles.list.find(v=>v.id===s.tag);if(site)this.g.waypoint={x:site.at[0],z:site.at[1],name:site.name};else if(o)this.g.waypoint={x:o.x,z:o.z,name:o.name};else if(v){const p=this.g.vehicles.position(v);this.g.waypoint={x:p.x,z:p.z,name:v.id.toUpperCase()};}}\n emit(type,tag,value=1){this.events.push({type,tag,value});if(this.current?.alt&&tag===this.current.alt.tag)this.altDone=true;}\n advance(){if(!this.current)return;this.index++;this.elapsed=0;this.progress=0;this.choicesShown=false;this.events=[];if(this.index>=this.current.steps.length)this.complete();else{this.g.toast(this.objective(),6);this.waypoint();}}\n choose(id){const s=this.step();if(s?.do!=='\"'choice'||\"'!s.choices.some(c=>c.id===id))return false;this.flags[id]=true;if(id==='\"'column'||id==='walk')this.g.endingChoice=id;if(id==='kill-harrow'){this.g.ledger.harrowKilled=true;this.g.hands.shoot();this.g.sound.play('m38');}this.g.ui.close();this.advance();return true;}\n complete(){const g=this.g,m=this.current;const pay=Math.round((m.pay+(this.alt&&this.altDone?(m.alt?.bonus||0):0))*g.tuning.stonesReward);g.stones+=pay;g.ledger.earned+=pay;if(\"'!this.done.includes(m.id))this.done.push(m.id);if(m.scar)g.world.fire.burnStrip(m.scar,24);if(this.alt&&this.altDone){const b=g.buddies.find(b=>b.id===m.alt.buddy);if(b)b.trust++;}g.toast('\"'CONTRACT CONCLUDED / '+pay+' STONES',7);g.sound.play('ui-confirm');g.pass=null;\n if(m.id==='m0'){this.current=null;this.start('m1');return;}\n if(m.id==='m1'){g.tablets+=3;g.metBuddy('mags');g.world.siteById('pump-shed').cleared=true;}\n if(m.id==='m2'){g.metBuddy('ines');g.world.siteById('ranger-post').cleared=true;g.act=2;}\n if(m.id==='m5'&&\"'!this.flags.bypass){for(const a of g.actors.list.filter(a=>a.kind==='\"'civilian'&&a.site==='three-wells'))g.actors.flee(a);g.clinicDebt=true;}\n if(m.id==='m7')g.truce=false;\n if(m.id==='m8'){g.ridingTrain=false;g.vehicles.train.speed=0;g.column=true;}\n if(m.id==='m9'){this.current=null;g.mapUp=false;this.start('end');g.save();return;}\n if(m.id==='end'){this.current=null;g.endCampaign();return;}\n this.current=null;g.buddyActive=null;g.save();}\n acceptAlt(){const a=this.current?.alt;if(\"'!a)return;this.alt=true;this.g.buddyActive=a.buddy;this.g.spawnBuddy(a.buddy);this.g.say(a.buddy,a.text);}\n tick(dt){if(!this.current)return;const g=this.g,s=this.step();this.dialogClock+=dt;if(this.dialogClock>13&&this.lineIndex<DIALOGUE[this.current.id].length){this.dialogClock=0;let [who,line]=DIALOGUE[this.current.id][this.lineIndex++];if(g.buddies.some(b=>b.id===who&&b.dead))return;if(this.current.id==='\"'m6'&&who==='ines')who=g.buddyActive||'pell';g.say(who,line);}this.elapsed+=dt;const site=SITE_BY_ID[s.site],d=site?Math.hypot(g.pos.x-site.at[0],g.pos.z-site.at[1]):Infinity;const event=this.events.find(e=>e.tag===s.tag||e.type===s.tag||(s.do==='report'&&e.tag===s.to));let done=false;\n if(s.do==='goto')done=d<(s.r||35);if(s.do==='leave')done=d>s.r;if(['use','deliver','collect','steal','report','talk'].includes(s.do))done=\"'!!event;\n if(s.do==='\"'kill'){const dead=g.actors.list.filter(a=>a.site===s.site&&a.kind==='soldier'&&a.dead).length;done=dead>=(s.n||1);this.progress=dead/(s.n||1);}\n if(s.do==='destroy'){const objs=g.world.objects.filter(o=>o.tag===s.tag);const veh=g.vehicles.list.filter(v=>v.id===s.tag);const n=objs.filter(o=>\"'!o.active).length+veh.filter(v=>v.dead).length;done=n>=s.n;this.progress=n/s.n;}\n if(s.do==='\"'burn'){let n=0;for(const i of [...g.world.fire.scorched,...g.world.fire.active]){const [x,z]=g.world.fire.coords(i);if(Math.hypot(x-site.at[0],z-site.at[1])<(s.site==='pass'?75:105))n++;}this.progress=n/s.n;done=n>=s.n;}\n if(s.do==='hold'){if(d<(s.r||60))this.progress+=dt/s.time;done=this.progress>=1;}\n if(s.do==='ride')done=this.elapsed>s.time||event?.type==='skip';\n if(s.do==='script'){if(s.script==='arrival'){g.ridingTrain=false;g.body.attackFever();g.teleport(-13,49);done=true;}if(s.script==='buddy-down'){g.wind.x=-g.wind.x;g.wind.z=-g.wind.z;g.downBuddy(g.buddyActive);done=true;}}\n if(s.do==='choice'&&\"'!this.choicesShown){this.choicesShown=true;g.mapUp=false;g.ui.open('\"'choice');}\n this.events=[];if(done)this.advance();}\n save(){return {id:this.current?.id,index:this.index,done:this.done,flags:this.flags,elapsed:this.elapsed,progress:this.progress,alt:this.alt,altDone:this.altDone,lineIndex:this.lineIndex};}\n load(s){this.current=MISSION_BY_ID[s.id]||null;Object.assign(this,{index:s.index,done:s.done,flags:s.flags,elapsed:s.elapsed,progress:s.progress,alt:s.alt,altDone:s.altDone,lineIndex:s.lineIndex,choicesShown:false});this.waypoint();}\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui/glyphs.js <<'EOF'\nimport {keyLabel} from '../core/actions.js';\nconst SHAPES={CROSS:['...........','..x.....x..','...x...x...','....x.x....','.....x.....','....x.x....','...x...x...','..x.....x..','...........'],CIRCLE:['...xxxx....','..x....x...','.x......x..','.x......x..','.x......x..','.x......x..','..x....x...','...xxxx....','...........'],SQUARE:['.xxxxxxxx..','.x......x..','.x......x..','.x......x..','.x......x..','.x......x..','.x......x..','.xxxxxxxx..','...........'],TRIANGLE:['.....x.....','....x.x....','....x.x....','...x...x...','...x...x...','..x.....x..','..xxxxxxx..','...........','...........'],UP:['....x....','...xxx...','..xxxxx..','....x....','....x....'],DOWN:['....x....','....x....','..xxxxx..','...xxx...','....x....'],LEFT:['...x.....','..xx.....','.xxxxxxx.','..xx.....','...x.....'],RIGHT:['.....x...','.....xx..','.xxxxxxx.','.....xx..','.....x...']};\nexport function glyph(h,g,action,x,y,color='sand'){const label=keyLabel(g,action)||action;if(g.device==='pad'&&SHAPES[label]){h.sprite(x,y+1,SHAPES[label],{x:color});return 14;}const w=Math.max(13,label.length*6+6);h.rect(x,y,w,12,color);h.rect(x+1,y+1,w-2,10,'ink');h.text(x+3,y+3,label,{color,shadow:false});return w+4;}\nexport function prompt(h,g,action,text,x,y,color='white'){const w=glyph(h,g,action,x,y);h.text(x+w,y+3,text,{color});return w+text.length*6;}\nEOF\ncat > src/ui/menu.js <<'EOF'\nimport {GAME_TITLE} from '../content/title.js';\nimport {SLIDERS,DEFAULTS,SETTINGS} from '../content/tuning-defaults.js';\nimport {WEAPONS,UPGRADES} from '../content/weapons.js';\nimport {MISSIONS} from '../content/missions.js';\nimport {SITES,HALTS} from '../content/sites.js';\nimport {ENDINGS,NOTES} from '../content/dialogue.js';\nimport {ABOUT_PAGES} from '../content/about.js';\nimport {clamp} from '../core/math.js';\nimport {glyph,prompt} from './glyphs.js';\nconst devTabs=['CHEATS','TELEPORT','SPAWN','WORLD','MISSION','BALANCE','DEBUG'];\nexport class Menu {\n constructor(g){this.g=g;this.page=0;this.tab=0;this.row=0;this.returnScreen='';this.hover=-1;this.lastPointer={x:99,y:99};this.stickAge=0;this.stickDir=0;this.shopIndex=0;this.speaker='';this.tabPage=0;this.focus=0;this.history=[];this.uiAge=0;this.rects=[];}\n open(screen){const g=this.g;g.screen=screen;this.focus=0;g.focus=0;this.page=0;this.tabPage=0;this.uiAge=0;g.cam.enabled=false;if(['pause','dead'].includes(screen))g.ctx.engine.timeScale=0;else if(\"'!['\"'settings','sound','controls','picture','comfort','about','ledger','dev'].includes(screen))g.ctx.engine.timeScale=1;if(typeof document\"'!=='\"'undefined'&&document.pointerLockElement)document.exitPointerLock();}\n close(){this.g.screen='';this.g.ctx.engine.timeScale=1;this.g.cam.enabled=true;this.g.cam.override=null;this.g.ctx.input.clearQueued('MouseLeft','KeyE','Enter','PadCross','Escape','PadCircle');}\n back(){const g=this.g;g.sound.play('ui-back');if(g.screen==='main'){this.open('title');return;}if(g.screen==='title')return;if(g.screen==='pause'){this.close();return;}if(['sound','controls','picture','comfort'].includes(g.screen)){this.open('settings');return;}if(g.screen==='settings'||g.screen==='about'){this.open(this.returnScreen||((g.mode==='title'||g.notice)?'main':'pause'));return;}if(g.screen==='dev'){g.ctx.engine.timeScale=0;this.open('pause');return;}if(g.screen==='choice')return;if(g.screen==='ending'){this.open('ledger');return;}if(g.mode==='title')this.open('main');else this.close();}\n button(text,fn,extra={}){return {text,fn,...extra};}\n slider(key,label,obj,lo,hi,step){return {text:label,value:obj[key],slider:{key,obj,lo,hi,step},fn:()=>{}};}\n items(){const g=this.g,b=(...a)=>this.button(...a);switch(g.screen){\n case 'title':return g.notice?[b('SETTINGS',()=>{this.returnScreen='title';this.open('settings');})]:[b('ENTER THE KETTLE',()=>this.open('main'))];\n case 'main':return [...(g.hasSave()?[b('CONTINUE',()=>g.load())]:[]),b('NEW GAME',()=>g.newCampaign()),b('CASH RUN',()=>this.open('cash')),b('SETTINGS',()=>{this.returnScreen='main';this.open('settings');}),b('ABOUT & CREDITS',()=>{this.returnScreen='main';this.open('about');})];\n case 'pause':return g.options.session?[b('RESUME',()=>this.close()),b('SETTINGS',()=>{this.returnScreen='pause';this.open('settings');})]:[b('RESUME',()=>this.close()),b('THE LEDGER',()=>this.open('ledger')),b('SETTINGS',()=>{this.returnScreen='pause';this.open('settings');}),b('DEV MODE',()=>{this.tab=0;this.open('dev');}),b('ABOUT & CREDITS',()=>{this.returnScreen='pause';this.open('about');}),b('QUIT TO TITLE',()=>g.toTitle())];\n case 'settings':return [b('SOUND',()=>this.open('sound')),b('CONTROLS',()=>this.open('controls')),b('PICTURE',()=>this.open('picture')),b('COMFORT',()=>this.open('comfort')),b('RESET TO DEFAULTS',()=>g.resetSettings()),b('BACK',()=>this.back())];\n case 'sound':return [this.slider('music','MUSIC',g.settings,0,1,.05),this.slider('effects','EFFECTS',g.settings,0,1,.05),this.slider('voices','VOICES',g.settings,0,1,.05),b('BACK',()=>this.back())];\n case 'controls':{const pages=[[this.slider('pad','PAD SENSITIVITY',g.settings,.25,3,.1),this.slider('mouse','MOUSE SENSITIVITY',g.settings,.25,3,.1),b('INVERT Y: '+(g.settings.invert?'ON':'OFF'),()=>{g.settings.invert=\"'!g.settings.invert;g.applySettings();}),b('\"'GLYPHS: '+g.settings.glyphs.toUpperCase(),()=>{g.settings.glyphs=g.settings.glyphs==='Xbox'?'PlayStation':'Xbox';g.applySettings();})],[b('AIM ASSIST: '+(g.settings.assist?'ON':'OFF'),()=>{g.settings.assist=\"'!g.settings.assist;g.applySettings();}),b('\"'RUMBLE: '+(g.settings.rumble?'ON':'OFF'),()=>{g.settings.rumble=\"'!g.settings.rumble;g.applySettings();}),b('\"'BACK',()=>this.back())]];return pages[this.page%2];}\n case 'picture':return [b('FULLSCREEN',()=>{if(typeof document\"'!=='\"'undefined')document.documentElement.requestFullscreen?.().catch(()=>{});}),this.slider('fov','FIELD OF VIEW',g.settings,55,95,1),b('PIXELS: '+(g.settings.pixels===1?'FINE':'CHUNKY'),()=>{g.settings.pixels=g.settings.pixels===1?2:1;g.applySettings();}),b('QUALITY: '+g.settings.quality.toUpperCase(),()=>{g.settings.quality=g.settings.quality==='high'?'medium':'high';g.applySettings();}),b('BACK',()=>this.back())];\n case 'comfort':return [b('SUBTITLES: '+(g.settings.subtitles===1?'STANDARD':'LARGE'),()=>{g.settings.subtitles=g.settings.subtitles===1?2:1;g.applySettings();}),b('REDUCE FLASHES: '+(g.settings.reducedFlashes?'ON':'OFF'),()=>{g.settings.reducedFlashes=\"'!g.settings.reducedFlashes;g.applySettings();}),b('\"'FEVER EFFECTS: '+(g.settings.reducedFever?'REDUCED':'FULL'),()=>{g.settings.reducedFever=\"'!g.settings.reducedFever;g.applySettings();}),b('\"'BACK',()=>this.back())];\n case 'cash':return [b('SOLO WITH HIRED GUNS',()=>g.startRound('solo')),b('HOST ON THIS COMPUTER',()=>g.startLink(true)),b('JOIN ON THIS COMPUTER',()=>g.startLink(false)),b('BACK',()=>this.open('main'))];\n case 'lobby':return [b(g.link?.isHost?'START CASH RUN':'WAITING FOR THE HOST',()=>{if(g.link?.isHost)g.link.begin();}),b('LEAVE',()=>{g.link?.dispose();g.link=null;this.open('main');})];\n case 'board':{const available=g.mission.available('board');return [...available.slice(this.page*4,this.page*4+4).map(m=>b(m.title,()=>{this.open('brief');this.contract=m.id;})),b('LEAVE',()=>this.close())];}\n case 'dialogue':{const avail=g.mission.available(this.speaker);if(g.mission.current&&g.mission.step()?.do==='report'&&g.mission.step().to===this.speaker)return [b('CONCLUDE THE CONTRACT',()=>{g.emit('report',this.speaker);this.close();})];return [...avail.slice(0,3).map(m=>b(m.title,()=>{this.contract=m.id;this.open('brief');})),...(this.speaker==='odile'?[b('A MERCY RUN / 4 TABLETS',()=>{g.startMercy();this.close();})]:[]),b('LEAVE',()=>this.close())];}\n case 'brief':return [b('ACCEPT THE CONTRACT',()=>{g.mission.start(this.contract);this.close();}),b('NOT YET',()=>this.close())];\n case 'alt':return [b('TAKE THEIR PLAN',()=>{g.mission.acceptAlt();this.close();}),b('MY OWN WAY',()=>this.close())];\n case 'choice':return (g.mission.step()?.choices||[]).map(c=>b(c.text,()=>g.mission.choose(c.id)));\n case 'shop':{const stock=this.stock(),v=stock[this.shopIndex%stock.length],owned=g.unlocked.includes(v.id)||g.upgrades[v.id];return [b((owned?'TAKE':'BUY')+' / '+(owned?'CLEAN COPY':v.cost+' STONES'),()=>g.buy(v.id)),b('LEAVE',()=>this.close())];}\n case 'locker':return ['sidearm','main','special'].map(slot=>{const list=g.unlocked.filter(id=>WEAPONS[id].slot===slot);return b(slot.toUpperCase()+': '+(g.loadout[slot]?WEAPONS[g.loadout[slot]].name:'EMPTY'),()=>{if(list.length){const i=list.indexOf(g.loadout[slot]);g.loadout[slot]=list[(i+1)%list.length];g.equip(g.loadout[slot],100);}});}).concat([b('RESUPPLY & LEAVE',()=>{g.resupply();this.close();})]);\n case 'bed':return [['DAWN',5.5],['NOON',12],['DUSK',16.5],['MIDNIGHT',0]].map(([name,hour])=>b(name,()=>{g.sleep(hour);this.close();})).concat([b('LEAVE',()=>this.close())]);\n case 'rail':return HALTS.filter(h=>g.visitedHalts.includes(h.id)).map(h=>b(h.name+' / 1 STONE',()=>{g.travel(h.id);this.close();})).concat([b('LEAVE',()=>this.close())]);\n case 'ledger':return [b(g.completed?'CREDITS':'BACK',()=>g.completed?this.open('about'):this.back())];\n case 'ending':return [b('OPEN THE LEDGER',()=>this.open('ledger'))];\n case 'about':return [b(this.page<ABOUT_PAGES.length-1?'NEXT PAGE':'BACK',()=>this.page<ABOUT_PAGES.length-1?this.page++:this.back())];\n case 'dead':return [b('CONTINUE',()=>g.hasSave()?g.load():g.newCampaign()),b('TITLE',()=>g.toTitle())];\n case 'results':return g.options.session?[]:[b('PLAY AGAIN',()=>g.startRound('solo')),b('TITLE',()=>g.toTitle())];\n case 'dev':return this.devItems();default:return [];}}\n stock(){return [...Object.entries(WEAPONS).filter(([id,w])=>w.cost>0).map(([id,w])=>({id,...w})),...UPGRADES];}\n pages(){const s=this.g.screen;if(s==='about')return ABOUT_PAGES.length;if(s==='controls')return 2;if(s==='shop')return this.stock().length;if(s==='board')return Math.max(1,Math.ceil(this.g.mission.available('board').length/4));if(s==='dev'){if(this.tab===1)return Math.ceil(SITES.length/5);if(this.tab===4)return Math.ceil(MISSIONS.length/4);if(this.tab===5)return Math.ceil(SLIDERS.length/5);if(this.tab===3)return 2;if(this.tab===0)return 2;if(this.tab===6)return 2;}return 1;}\n turnPage(dir){if(this.g.screen==='shop'){this.shopIndex=(this.shopIndex+dir+this.stock().length)%this.stock().length;this.g.previewWeapon=this.stock()[this.shopIndex].id;return;}this.page=(this.page+dir+this.pages())%this.pages();this.focus=0;this.g.sound.play('ui-move');}\n devItems(){const g=this.g,b=(...a)=>this.button(...a),toggle=(id,label)=>b(label+': '+(g.cheats[id]?'ON':'OFF'),()=>g.cheats[id]=\"'!g.cheats[id]);switch(this.tab){case 0:return (this.page===0?[toggle('\"'god','GOD MODE'),toggle('ammo','INFINITE AMMO'),toggle('noJams','NO JAMS'),toggle('noFever','NO FEVER'),toggle('invisible','INVISIBLE TO AI')]:[toggle('noclip','NOCLIP FLY'),b('GIVE ALL EQUIPMENT',()=>g.dev.giveAll()),b('REFILL HEALTH & SUPPLIES',()=>{g.hp=100;g.resupply();g.tablets=9;})]);\n case 1:return SITES.slice(this.page*5,this.page*5+5).map(s=>b(s.name,()=>{g.dev.teleport(s.id);g.toast('TELEPORTED / '+s.name,3);}));\n case 2:return [b('CONCORD SQUAD',()=>g.dev.spawn('concord')),b('HARVEST SQUAD',()=>g.dev.spawn('harvest')),b('PICKUP',()=>g.dev.spawn('pickup')),b('TECHNICAL',()=>g.dev.spawn('technical')),b('STONE CASE',()=>g.dev.spawn('case'))];\n case 3:return this.page===0?[this.slider('hour','HOUR',g,0,23.9,.25),this.slider('speed','WIND SPEED',g.wind,0,8,.25),b('TURN WIND 45 DEGREES',()=>{const a=Math.atan2(g.wind.z,g.wind.x)+Math.PI/4;g.wind.x=Math.cos(a);g.wind.z=Math.sin(a);}),b('WEATHER: '+g.weather.toUpperCase(),()=>g.weather=g.weather==='clear'?'storm':g.weather==='storm'?'dust':'clear'),b('IGNITE CROSSHAIR',()=>g.dev.ignite())]:[b('EXTINGUISH ALL',()=>g.world.fire.extinguish()),b('REGROW ALL',()=>g.world.fire.regrow()),b('SLEEP SIX HOURS',()=>g.sleep((g.hour+6)%24)),b('TOGGLE SIMULATION',()=>{g.dev.running=\"'!g.dev.running;g.ctx.engine.timeScale=g.dev.running?1:0;})];\n case 4:return MISSIONS.slice(this.page*4,this.page*4+4).map(m=>b('\"'START: '+m.title,()=>g.mission.start(m.id))).concat([b('COMPLETE CURRENT STEP',()=>g.mission.advance()),b('FORCE JAM / FEVER',()=>{g.weapon.jammed=true;g.weapon.racks=3;g.body.attackFever();})]);\n case 5:return SLIDERS.slice(this.page*5,this.page*5+5).map(([id,label,,lo,hi,step])=>this.slider(id,label,g.tuning,lo,hi,step)).concat([b('RESET ALL BALANCE',()=>g.dev.reset())]);\n case 6:return this.page===0?[b('FIRE GRID: '+(g.debug.fire?'ON':'OFF'),()=>g.debug.fire=\"'!g.debug.fire),b('\"'AI STATES: '+(g.debug.ai?'ON':'OFF'),()=>g.debug.ai=\"'!g.debug.ai),b('\"'ENGINE DEBUG',()=>g.ctx.engine.showDebug=\"'!g.ctx.engine.showDebug),b('\"'FREE CAMERA',()=>{g.freeCam=\"'!g.freeCam;g.ctx.engine.setCamera({preset:g.freeCam?'\"'free':'first'},{syncUrl:false});}),b('QUICK SAVE',()=>g.save())]:[b('QUICK LOAD',()=>g.load()),b('FORCE FEVER',()=>g.body.attackFever()),b('BREAK GUN',()=>{g.weapon.cond=0;g.hands.animate('Break');}),b('DOWN A BUDDY',()=>g.downBuddy(g.buddies.find(b=>b.met&&\"'!b.dead)?.id)),b('\"'COORDINATES: '+Math.round(g.pos.x)+', '+Math.round(g.pos.z),()=>g.toast(g.status(),6))];default:return [];}}\n adjust(item,dir){if(\"'!item?.slider)return;const {obj,key,lo,hi,step}=item.slider;obj[key]=Math.round(clamp(obj[key]+dir*step,lo,hi)*10000)/10000;this.g.applySettings();this.g.sound.play('\"'ui-move');}\n input(dt){const g=this.g,i=g.ctx.input;this.uiAge+=dt;const items=this.items();this.focus=clamp(this.focus,0,Math.max(0,items.length-1));let dy=0;if(i.wasPressed('ArrowDown','KeyS','PadDown'))dy=1;if(i.wasPressed('ArrowUp','KeyW','PadUp'))dy=-1;const stick=Math.abs(i.padAxis.y)>.55?-Math.sign(i.padAxis.y):0;if(stick){this.stickAge+=dt;if(stick\"'!==this.stickDir||this.stickAge>.22){dy=stick;this.stickAge=0;}}else this.stickAge=0;this.stickDir=stick;if(dy){this.focus=(this.focus+dy+items.length)%Math.max(1,items.length);g.sound.play('\"'ui-move');}\n if(i.wasPressed('ArrowLeft','KeyA','PadLeft'))this.adjust(items[this.focus],-1);if(i.wasPressed('ArrowRight','KeyD','PadRight'))this.adjust(items[this.focus],1);\n if(g.screen==='dev'){if(i.wasPressed('KeyE','PadR1')){this.tab=(this.tab+1)%devTabs.length;this.page=0;this.focus=0;}if(i.wasPressed('KeyQ','PadL1')){this.tab=(this.tab+devTabs.length-1)%devTabs.length;this.page=0;this.focus=0;}if(i.wasPressed('KeyR','PadSquare')&&items[this.focus]?.slider){const {obj,key}=items[this.focus].slider;obj[key]=DEFAULTS[key];}}\n else{if(i.wasPressed('PadR1','BracketRight')||i.wheel>0)this.turnPage(1);if(i.wasPressed('PadL1','BracketLeft')||i.wheel<0)this.turnPage(-1);}\n if(g.screen==='dev'&&i.wasPressed('PageDown','BracketRight'))this.turnPage(1);if(g.screen==='dev'&&i.wasPressed('PageUp','BracketLeft'))this.turnPage(-1);\n if(i.wasPressed('Escape','PadCircle')){this.back();return;}if(i.wasPressed('Enter','Space','PadCross')&&items[this.focus]){g.sound.play('ui-confirm');items[this.focus].fn();}\n const p=i.pointer,x=(p.x+1)/2*g.ctx.hud.width,y=(1-p.y)/2*g.ctx.hud.height;const moved=Math.abs(p.x-this.lastPointer.x)+Math.abs(p.y-this.lastPointer.y)>.001;this.lastPointer={x:p.x,y:p.y};if(moved&&p.over){const r=this.rects.find(r=>x>=r.x&&x<=r.x+r.w&&y>=r.y&&y<r.y+r.h);if(r)this.focus=r.i;}\n for(const e of i.buttonEvents){if(\"'!e.down||!['\"'MouseLeft','Touch'].includes(e.code))continue;const xx=(e.x+1)/2*g.ctx.hud.width,yy=(1-e.y)/2*g.ctx.hud.height;const r=this.rects.find(r=>xx>=r.x&&xx<=r.x+r.w&&yy>=r.y&&yy<r.y+r.h);if(r){this.focus=r.i;const item=this.items()[r.i];if(item?.slider){const t=clamp((xx-(r.x+r.w*.56))/(r.w*.36),0,1);const {obj,key,lo,hi}=item.slider;obj[key]=lo+t*(hi-lo);g.applySettings();}else{g.sound.play('ui-confirm');item?.fn();}}}\n if(i.isDown('MouseLeft')&&items[this.focus]?.slider){const r=this.rects[this.focus];if(r&&x>r.x+r.w*.5){const {obj,key,lo,hi}=items[this.focus].slider;obj[key]=clamp((x-r.x-r.w*.56)/(r.w*.36),0,1)*(hi-lo)+lo;g.applySettings();}}\n g.focus=this.focus;}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui/glyphs.js <<'EOF'\nimport {keyLabel} from '../core/actions.js';\nconst SHAPES={CROSS:['...........','..x.....x..','...x...x...','....x.x....','.....x.....','....x.x....','...x...x...','..x.....x..','...........'],CIRCLE:['...xxxx....','..x....x...','.x......x..','.x......x..','.x......x..','.x......x..','..x....x...','...xxxx....','...........'],SQUARE:['.xxxxxxxx..','.x......x..','.x......x..','.x......x..','.x......x..','.x......x..','.x......x..','.xxxxxxxx..','...........'],TRIANGLE:['.....x.....','....x.x....','....x.x....','...x...x...','...x...x...','..x.....x..','..xxxxxxx..','...........','...........'],UP:['....x....','...xxx...','..xxxxx..','....x....','....x....'],DOWN:['....x....','....x....','..xxxxx..','...xxx...','....x....'],LEFT:['...x.....','..xx.....','.xxxxxxx.','..xx.....','...x.....'],RIGHT:['.....x...','.....xx..','.xxxxxxx.','.....xx..','.....x...']};\nexport function glyph(h,g,action,x,y,color='sand'){const label=keyLabel(g,action)||action;if(g.device==='pad'&&SHAPES[label]){h.sprite(x,y+1,SHAPES[label],{x:color});return 14;}const w=Math.max(13,label.length*6+6);h.rect(x,y,w,12,color);h.rect(x+1,y+1,w-2,10,'ink');h.text(x+3,y+3,label,{color,shadow:false});return w+4;}\nexport function prompt(h,g,action,text,x,y,color='white'){const w=glyph(h,g,action,x,y);h.text(x+w,y+3,text,{color});return w+text.length*6;}\nEOF\ncat > src/ui/menu.js <<'EOF'\nimport {GAME_TITLE} from '../content/title.js';\nimport {SLIDERS,DEFAULTS,SETTINGS} from '../content/tuning-defaults.js';\nimport {WEAPONS,UPGRADES} from '../content/weapons.js';\nimport {MISSIONS} from '../content/missions.js';\nimport {SITES,HALTS} from '../content/sites.js';\nimport {ENDINGS,NOTES} from '../content/dialogue.js';\nimport {ABOUT_PAGES} from '../content/about.js';\nimport {clamp} from '../core/math.js';\nimport {glyph,prompt} from './glyphs.js';\nconst devTabs=['CHEATS','TELEPORT','SPAWN','WORLD','MISSION','BALANCE','DEBUG'];\nexport class Menu {\n constructor(g){this.g=g;this.page=0;this.tab=0;this.row=0;this.returnScreen='';this.hover=-1;this.lastPointer={x:99,y:99};this.stickAge=0;this.stickDir=0;this.shopIndex=0;this.speaker='';this.tabPage=0;this.focus=0;this.history=[];this.uiAge=0;this.rects=[];}\n open(screen){const g=this.g;g.screen=screen;this.focus=0;g.focus=0;this.page=0;this.tabPage=0;this.uiAge=0;g.cam.enabled=false;if(['pause','dead'].includes(screen))g.ctx.engine.timeScale=0;else if(\"'!['\"'settings','sound','controls','picture','comfort','about','ledger','dev'].includes(screen))g.ctx.engine.timeScale=1;if(typeof document\"'!=='\"'undefined'&&document.pointerLockElement)document.exitPointerLock();}\n close(){this.g.screen='';this.g.ctx.engine.timeScale=1;this.g.cam.enabled=true;this.g.cam.override=null;this.g.ctx.input.clearQueued('MouseLeft','KeyE','Enter','PadCross','Escape','PadCircle');}\n back(){const g=this.g;g.sound.play('ui-back');if(g.screen==='main'){this.open('title');return;}if(g.screen==='title')return;if(g.screen==='pause'){this.close();return;}if(['sound','controls','picture','comfort'].includes(g.screen)){this.open('settings');return;}if(g.screen==='settings'||g.screen==='about'){this.open(this.returnScreen||((g.mode==='title'||g.notice)?'main':'pause'));return;}if(g.screen==='dev'){g.ctx.engine.timeScale=0;this.open('pause');return;}if(g.screen==='choice')return;if(g.screen==='ending'){this.open('ledger');return;}if(g.mode==='title')this.open('main');else this.close();}\n button(text,fn,extra={}){return {text,fn,...extra};}\n slider(key,label,obj,lo,hi,step){return {text:label,value:obj[key],slider:{key,obj,lo,hi,step},fn:()=>{}};}\n items(){const g=this.g,b=(...a)=>this.button(...a);switch(g.screen){\n case 'title':return g.notice?[b('SETTINGS',()=>{this.returnScreen='title';this.open('settings');})]:[b('ENTER THE KETTLE',()=>this.open('main'))];\n case 'main':return [...(g.hasSave()?[b('CONTINUE',()=>g.load())]:[]),b('NEW GAME',()=>g.newCampaign()),b('CASH RUN',()=>this.open('cash')),b('SETTINGS',()=>{this.returnScreen='main';this.open('settings');}),b('ABOUT & CREDITS',()=>{this.returnScreen='main';this.open('about');})];\n case 'pause':return g.options.session?[b('RESUME',()=>this.close()),b('SETTINGS',()=>{this.returnScreen='pause';this.open('settings');})]:[b('RESUME',()=>this.close()),b('THE LEDGER',()=>this.open('ledger')),b('SETTINGS',()=>{this.returnScreen='pause';this.open('settings');}),b('DEV MODE',()=>{this.tab=0;this.open('dev');}),b('ABOUT & CREDITS',()=>{this.returnScreen='pause';this.open('about');}),b('QUIT TO TITLE',()=>g.toTitle())];\n case 'settings':return [b('SOUND',()=>this.open('sound')),b('CONTROLS',()=>this.open('controls')),b('PICTURE',()=>this.open('picture')),b('COMFORT',()=>this.open('comfort')),b('RESET TO DEFAULTS',()=>g.resetSettings()),b('BACK',()=>this.back())];\n case 'sound':return [this.slider('music','MUSIC',g.settings,0,1,.05),this.slider('effects','EFFECTS',g.settings,0,1,.05),this.slider('voices','VOICES',g.settings,0,1,.05),b('BACK',()=>this.back())];\n case 'controls':{const pages=[[this.slider('pad','PAD SENSITIVITY',g.settings,.25,3,.1),this.slider('mouse','MOUSE SENSITIVITY',g.settings,.25,3,.1),b('INVERT Y: '+(g.settings.invert?'ON':'OFF'),()=>{g.settings.invert=\"'!g.settings.invert;g.applySettings();}),b('\"'GLYPHS: '+g.settings.glyphs.toUpperCase(),()=>{g.settings.glyphs=g.settings.glyphs==='Xbox'?'PlayStation':'Xbox';g.applySettings();})],[b('AIM ASSIST: '+(g.settings.assist?'ON':'OFF'),()=>{g.settings.assist=\"'!g.settings.assist;g.applySettings();}),b('\"'RUMBLE: '+(g.settings.rumble?'ON':'OFF'),()=>{g.settings.rumble=\"'!g.settings.rumble;g.applySettings();}),b('\"'BACK',()=>this.back())]];return pages[this.page%2];}\n case 'picture':return [b('FULLSCREEN',()=>{if(typeof document\"'!=='\"'undefined')document.documentElement.requestFullscreen?.().catch(()=>{});}),this.slider('fov','FIELD OF VIEW',g.settings,55,95,1),b('PIXELS: '+(g.settings.pixels===1?'FINE':'CHUNKY'),()=>{g.settings.pixels=g.settings.pixels===1?2:1;g.applySettings();}),b('QUALITY: '+g.settings.quality.toUpperCase(),()=>{g.settings.quality=g.settings.quality==='high'?'medium':'high';g.applySettings();}),b('BACK',()=>this.back())];\n case 'comfort':return [b('SUBTITLES: '+(g.settings.subtitles===1?'STANDARD':'LARGE'),()=>{g.settings.subtitles=g.settings.subtitles===1?2:1;g.applySettings();}),b('REDUCE FLASHES: '+(g.settings.reducedFlashes?'ON':'OFF'),()=>{g.settings.reducedFlashes=\"'!g.settings.reducedFlashes;g.applySettings();}),b('\"'FEVER EFFECTS: '+(g.settings.reducedFever?'REDUCED':'FULL'),()=>{g.settings.reducedFever=\"'!g.settings.reducedFever;g.applySettings();}),b('\"'BACK',()=>this.back())];\n case 'cash':return [b('SOLO WITH HIRED GUNS',()=>g.startRound('solo')),b('HOST ON THIS COMPUTER',()=>g.startLink(true)),b('JOIN ON THIS COMPUTER',()=>g.startLink(false)),b('BACK',()=>this.open('main'))];\n case 'lobby':return [b(g.link?.isHost?'START CASH RUN':'WAITING FOR THE HOST',()=>{if(g.link?.isHost)g.link.begin();}),b('LEAVE',()=>{g.link?.dispose();g.link=null;this.open('main');})];\n case 'board':{const available=g.mission.available('board');return [...available.slice(this.page*4,this.page*4+4).map(m=>b(m.title,()=>{this.open('brief');this.contract=m.id;})),b('LEAVE',()=>this.close())];}\n case 'dialogue':{const avail=g.mission.available(this.speaker);if(g.mission.current&&g.mission.step()?.do==='report'&&g.mission.step().to===this.speaker)return [b('CONCLUDE THE CONTRACT',()=>{g.emit('report',this.speaker);this.close();})];return [...avail.slice(0,3).map(m=>b(m.title,()=>{this.contract=m.id;this.open('brief');})),...(this.speaker==='odile'?[b('A MERCY RUN / 4 TABLETS',()=>{g.startMercy();this.close();})]:[]),b('LEAVE',()=>this.close())];}\n case 'brief':return [b('ACCEPT THE CONTRACT',()=>{g.mission.start(this.contract);this.close();}),b('NOT YET',()=>this.close())];\n case 'alt':return [b('TAKE THEIR PLAN',()=>{g.mission.acceptAlt();this.close();}),b('MY OWN WAY',()=>this.close())];\n case 'choice':return (g.mission.step()?.choices||[]).map(c=>b(c.text,()=>g.mission.choose(c.id)));\n case 'shop':{const stock=this.stock(),v=stock[this.shopIndex%stock.length],owned=g.unlocked.includes(v.id)||g.upgrades[v.id];return [b((owned?'TAKE':'BUY')+' / '+(owned?'CLEAN COPY':v.cost+' STONES'),()=>g.buy(v.id)),b('LEAVE',()=>this.close())];}\n case 'locker':return ['sidearm','main','special'].map(slot=>{const list=g.unlocked.filter(id=>WEAPONS[id].slot===slot);return b(slot.toUpperCase()+': '+(g.loadout[slot]?WEAPONS[g.loadout[slot]].name:'EMPTY'),()=>{if(list.length){const i=list.indexOf(g.loadout[slot]);g.loadout[slot]=list[(i+1)%list.length];g.equip(g.loadout[slot],100);}});}).concat([b('RESUPPLY & LEAVE',()=>{g.resupply();this.close();})]);\n case 'bed':return [['DAWN',5.5],['NOON',12],['DUSK',16.5],['MIDNIGHT',0]].map(([name,hour])=>b(name,()=>{g.sleep(hour);this.close();})).concat([b('LEAVE',()=>this.close())]);\n case 'rail':return HALTS.filter(h=>g.visitedHalts.includes(h.id)).map(h=>b(h.name+' / 1 STONE',()=>{g.travel(h.id);this.close();})).concat([b('LEAVE',()=>this.close())]);\n case 'ledger':return [b(g.completed?'CREDITS':'BACK',()=>g.completed?this.open('about'):this.back())];\n case 'ending':return [b('OPEN THE LEDGER',()=>this.open('ledger'))];\n case 'about':return [b(this.page<ABOUT_PAGES.length-1?'NEXT PAGE':'BACK',()=>this.page<ABOUT_PAGES.length-1?this.page++:this.back())];\n case 'dead':return [b('CONTINUE',()=>g.hasSave()?g.load():g.newCampaign()),b('TITLE',()=>g.toTitle())];\n case 'results':return g.options.session?[]:[b('PLAY AGAIN',()=>g.startRound('solo')),b('TITLE',()=>g.toTitle())];\n case 'dev':return this.devItems();default:return [];}}\n stock(){return [...Object.entries(WEAPONS).filter(([id,w])=>w.cost>0).map(([id,w])=>({id,...w})),...UPGRADES];}\n pages(){const s=this.g.screen;if(s==='about')return ABOUT_PAGES.length;if(s==='controls')return 2;if(s==='shop')return this.stock().length;if(s==='board')return Math.max(1,Math.ceil(this.g.mission.available('board').length/4));if(s==='dev'){if(this.tab===1)return Math.ceil(SITES.length/5);if(this.tab===4)return Math.ceil(MISSIONS.length/4);if(this.tab===5)return Math.ceil(SLIDERS.length/5);if(this.tab===3)return 2;if(this.tab===0)return 2;if(this.tab===6)return 2;}return 1;}\n turnPage(dir){if(this.g.screen==='shop'){this.shopIndex=(this.shopIndex+dir+this.stock().length)%this.stock().length;this.g.previewWeapon=this.stock()[this.shopIndex].id;return;}this.page=(this.page+dir+this.pages())%this.pages();this.focus=0;this.g.sound.play('ui-move');}\n devItems(){const g=this.g,b=(...a)=>this.button(...a),toggle=(id,label)=>b(label+': '+(g.cheats[id]?'ON':'OFF'),()=>g.cheats[id]=\"'!g.cheats[id]);switch(this.tab){case 0:return (this.page===0?[toggle('\"'god','GOD MODE'),toggle('ammo','INFINITE AMMO'),toggle('noJams','NO JAMS'),toggle('noFever','NO FEVER'),toggle('invisible','INVISIBLE TO AI')]:[toggle('noclip','NOCLIP FLY'),b('GIVE ALL EQUIPMENT',()=>g.dev.giveAll()),b('REFILL HEALTH & SUPPLIES',()=>{g.hp=100;g.resupply();g.tablets=9;})]);\n case 1:return SITES.slice(this.page*5,this.page*5+5).map(s=>b(s.name,()=>{g.dev.teleport(s.id);g.toast('TELEPORTED / '+s.name,3);}));\n case 2:return [b('CONCORD SQUAD',()=>g.dev.spawn('concord')),b('HARVEST SQUAD',()=>g.dev.spawn('harvest')),b('PICKUP',()=>g.dev.spawn('pickup')),b('TECHNICAL',()=>g.dev.spawn('technical')),b('STONE CASE',()=>g.dev.spawn('case'))];\n case 3:return this.page===0?[this.slider('hour','HOUR',g,0,23.9,.25),this.slider('speed','WIND SPEED',g.wind,0,8,.25),b('TURN WIND 45 DEGREES',()=>{const a=Math.atan2(g.wind.z,g.wind.x)+Math.PI/4;g.wind.x=Math.cos(a);g.wind.z=Math.sin(a);}),b('WEATHER: '+g.weather.toUpperCase(),()=>g.weather=g.weather==='clear'?'storm':g.weather==='storm'?'dust':'clear'),b('IGNITE CROSSHAIR',()=>g.dev.ignite())]:[b('EXTINGUISH ALL',()=>g.world.fire.extinguish()),b('REGROW ALL',()=>g.world.fire.regrow()),b('SLEEP SIX HOURS',()=>g.sleep((g.hour+6)%24)),b('TOGGLE SIMULATION',()=>{g.dev.running=\"'!g.dev.running;g.ctx.engine.timeScale=g.dev.running?1:0;})];\n case 4:return MISSIONS.slice(this.page*4,this.page*4+4).map(m=>b('\"'START: '+m.title,()=>g.mission.start(m.id))).concat([b('COMPLETE CURRENT STEP',()=>g.mission.advance()),b('FORCE JAM / FEVER',()=>{g.weapon.jammed=true;g.weapon.racks=3;g.body.attackFever();})]);\n case 5:return SLIDERS.slice(this.page*5,this.page*5+5).map(([id,label,,lo,hi,step])=>this.slider(id,label,g.tuning,lo,hi,step)).concat([b('RESET ALL BALANCE',()=>g.dev.reset())]);\n case 6:return this.page===0?[b('FIRE GRID: '+(g.debug.fire?'ON':'OFF'),()=>g.debug.fire=\"'!g.debug.fire),b('\"'AI STATES: '+(g.debug.ai?'ON':'OFF'),()=>g.debug.ai=\"'!g.debug.ai),b('\"'ENGINE DEBUG',()=>g.ctx.engine.showDebug=\"'!g.ctx.engine.showDebug),b('\"'FREE CAMERA',()=>{g.freeCam=\"'!g.freeCam;g.ctx.engine.setCamera({preset:g.freeCam?'\"'free':'first'},{syncUrl:false});}),b('QUICK SAVE',()=>g.save())]:[b('QUICK LOAD',()=>g.load()),b('FORCE FEVER',()=>g.body.attackFever()),b('BREAK GUN',()=>{g.weapon.cond=0;g.hands.animate('Break');}),b('DOWN A BUDDY',()=>g.downBuddy(g.buddies.find(b=>b.met&&\"'!b.dead)?.id)),b('\"'COORDINATES: '+Math.round(g.pos.x)+', '+Math.round(g.pos.z),()=>g.toast(g.status(),6))];default:return [];}}\n adjust(item,dir){if(\"'!item?.slider)return;const {obj,key,lo,hi,step}=item.slider;obj[key]=Math.round(clamp(obj[key]+dir*step,lo,hi)*10000)/10000;this.g.applySettings();this.g.sound.play('\"'ui-move');}\n input(dt){const g=this.g,i=g.ctx.input;this.uiAge+=dt;const items=this.items();this.focus=clamp(this.focus,0,Math.max(0,items.length-1));let dy=0;if(i.wasPressed('ArrowDown','KeyS','PadDown'))dy=1;if(i.wasPressed('ArrowUp','KeyW','PadUp'))dy=-1;const stick=Math.abs(i.padAxis.y)>.55?-Math.sign(i.padAxis.y):0;if(stick){this.stickAge+=dt;if(stick\"'!==this.stickDir||this.stickAge>.22){dy=stick;this.stickAge=0;}}else this.stickAge=0;this.stickDir=stick;if(dy){this.focus=(this.focus+dy+items.length)%Math.max(1,items.length);g.sound.play('\"'ui-move');}\n if(i.wasPressed('ArrowLeft','KeyA','PadLeft'))this.adjust(items[this.focus],-1);if(i.wasPressed('ArrowRight','KeyD','PadRight'))this.adjust(items[this.focus],1);\n if(g.screen==='dev'){if(i.wasPressed('KeyE','PadR1')){this.tab=(this.tab+1)%devTabs.length;this.page=0;this.focus=0;}if(i.wasPressed('KeyQ','PadL1')){this.tab=(this.tab+devTabs.length-1)%devTabs.length;this.page=0;this.focus=0;}if(i.wasPressed('KeyR','PadSquare')&&items[this.focus]?.slider){const {obj,key}=items[this.focus].slider;obj[key]=DEFAULTS[key];}}\n else{if(i.wasPressed('PadR1','BracketRight')||i.wheel>0)this.turnPage(1);if(i.wasPressed('PadL1','BracketLeft')||i.wheel<0)this.turnPage(-1);}\n if(g.screen==='dev'&&i.wasPressed('PageDown','BracketRight'))this.turnPage(1);if(g.screen==='dev'&&i.wasPressed('PageUp','BracketLeft'))this.turnPage(-1);\n if(i.wasPressed('Escape','PadCircle')){this.back();return;}if(i.wasPressed('Enter','Space','PadCross')&&items[this.focus]){g.sound.play('ui-confirm');items[this.focus].fn();}\n const p=i.pointer,x=(p.x+1)/2*g.ctx.hud.width,y=(1-p.y)/2*g.ctx.hud.height;const moved=Math.abs(p.x-this.lastPointer.x)+Math.abs(p.y-this.lastPointer.y)>.001;this.lastPointer={x:p.x,y:p.y};if(moved&&p.over){const r=this.rects.find(r=>x>=r.x&&x<=r.x+r.w&&y>=r.y&&y<r.y+r.h);if(r)this.focus=r.i;}\n for(const e of i.buttonEvents){if(\"'!e.down||!['\"'MouseLeft','Touch'].includes(e.code))continue;const xx=(e.x+1)/2*g.ctx.hud.width,yy=(1-e.y)/2*g.ctx.hud.height;const r=this.rects.find(r=>xx>=r.x&&xx<=r.x+r.w&&yy>=r.y&&yy<r.y+r.h);if(r){this.focus=r.i;const item=this.items()[r.i];if(item?.slider){const t=clamp((xx-(r.x+r.w*.56))/(r.w*.36),0,1);const {obj,key,lo,hi}=item.slider;obj[key]=lo+t*(hi-lo);g.applySettings();}else{g.sound.play('ui-confirm');item?.fn();}}}\n if(i.isDown('MouseLeft')&&items[this.focus]?.slider){const r=this.rects[this.focus];if(r&&x>r.x+r.w*.5){const {obj,key,lo,hi}=items[this.focus].slider;obj[key]=clamp((x-r.x-r.w*.56)/(r.w*.36),0,1)*(hi-lo)+lo;g.applySettings();}}\n g.focus=this.focus;}\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > src/content/about.js <<'EOF'\nimport {GAME_TITLE} from './title.js';\nexport const SOURCE_INFORMATION={date:'2026-11-05 06:30:14',source:'Far Cry 2',plan:'PLAN.md',genre:'Open world survival shooter',perspective:'First person; optional vehicle chase camera',tech:'Pixel Engine 0.46.0; three.js r186; Rapier 0.20; esbuild 0.28.2; AI Hub client 1.4.0; original game systems',artDirection:'Native 480x270 pixel pipeline; original low poly Sorrel models; red grass, plum shadows, ash and warm paper',animation:'Engine ClipDef and compileClips; THREE.AnimationMixer; native hero locomotion and ragdolls; original hands and soldier clips',audio:'Original code synthesized music, effects and Animalese style voices; music defaults to 10 percent',online:'AI Hub Protocol v1 shared world, 1-4 players; solo Cash Run with hired guns; same computer BroadcastChannel link',testing:'Node headless systems and scripted campaign; replay; Chromium WebGPU file build; hub harness; responsive phone, tablet and desktop; WebKit compatibility notice',research:'PLAN.md; shipped engine guides and API; AI Hub protocol and shared world reference',environment:'Codex CLI (headless); Linux / Ubuntu 26.04 on WSL2',model:'OpenAI, gpt-6.1-sol, reasoning effort max',usage:'added on import'};\nexport const TESTING_FEEDBACK=['unknown','unknown','unknown','unknown'];\nexport const ENGINE_FEEDBACK=['The data based model and clip systems made the original art practical. Headless stepping made long missions testable.','The custom cage collided with a built in id. The catalog now explicitly replaces that entry.','The first person survival simulation, fire persistence, mission runner, physical map and shared world round.','Coordinating first person input, camera attached objects and the independent multiplayer clock.','None. pixel-engine.js is kept byte identical to the release zip.','Offer a grounded first person game preset with neutral key bindings and explicit menu pointer lock control.'];\nexport const PROMPT_FEEDBACK=['The detailed original setting, fixed delivery format and concrete verification requirements.','The broad game length and the vertical slice goal require scope judgment; the plan resolves most details.','Keeping every survival mechanic reachable while integrating a complete story and shared world multiplayer.','Separate a required vertical slice checklist from expansion content, while retaining the explicit hub and packaging tests.'];\nconst tq=['HOW MANY ISSUES DID TESTING CATCH?','HOW MANY WERE CRITICAL?','MOST HELPFUL TEST?','LEAST HELPFUL TEST?'];\nconst eq=['WHAT DID YOU LIKE MOST?','DID YOU GET STUCK OR GUESS WRONG?','WHAT DID YOU BUILD YOURSELF?','HARDEST PART OF THE ENGINE?','WHAT DID YOU CHANGE IN THE ENGINE?','ONE ENGINE CHANGE YOU WOULD ASK FOR?'];\nconst pq=['WHAT DID YOU LIKE ABOUT THE PROMPT?','WHAT WAS CONFUSING?','WHAT WAS THE HARDEST THING?','WHAT WOULD YOU CHANGE?'];\nexport const ABOUT_PAGES=[\n {title:'SOURCE INFORMATION / 1',lines:['DATE: '+SOURCE_INFORMATION.date,'SOURCE: '+SOURCE_INFORMATION.source,'PLAN: '+SOURCE_INFORMATION.plan]},\n {title:'SOURCE INFORMATION / 2',lines:['GENRE: '+SOURCE_INFORMATION.genre,'PERSPECTIVE: '+SOURCE_INFORMATION.perspective,'TECH: '+SOURCE_INFORMATION.tech]},\n {title:'SOURCE INFORMATION / 3',lines:['ART: '+SOURCE_INFORMATION.artDirection,'ANIMATION: '+SOURCE_INFORMATION.animation]},\n {title:'SOURCE INFORMATION / 4',lines:['AUDIO: '+SOURCE_INFORMATION.audio,'ONLINE: '+SOURCE_INFORMATION.online]},\n {title:'SOURCE INFORMATION / 5',lines:['TESTING: '+SOURCE_INFORMATION.testing,'RESEARCH: '+SOURCE_INFORMATION.research]},\n {title:'SOURCE INFORMATION / 6',lines:['ENVIRONMENT: '+SOURCE_INFORMATION.environment,'MODEL: '+SOURCE_INFORMATION.model,'USAGE: '+SOURCE_INFORMATION.usage]},\n ...tq.map((q,i)=>({title:'TESTING FEEDBACK / '+(i+1),lines:[q,TESTING_FEEDBACK[i]]})),...eq.map((q,i)=>({title:'ENGINE FEEDBACK / '+(i+1),lines:[q,ENGINE_FEEDBACK[i]]})),...pq.map((q,i)=>({title:'PROMPT FEEDBACK / '+(i+1),lines:[q,PROMPT_FEEDBACK[i]]})),\n {title:'CREDITS',lines:[GAME_TITLE+' / an original game.','Pixel Engine (MIT), three.js (MIT), Rapier (Apache-2.0). AI Hub session client 1.4.0.','Original models, music, voices, effects and game code by OpenAI. Generic props from the engine native library.','Inspired by Far Cry 2; not affiliated. No external media assets.']}\n];\nEOF\ncat > src/ui/hud.js <<'EOF'\nimport {GAME_TITLE} from '../content/title.js';\nimport {WEAPONS} from '../content/weapons.js';\nimport {DIALOGUE,ENDINGS,NOTES} from '../content/dialogue.js';\nimport {MISSION_BY_ID} from '../content/missions.js';\nimport {ABOUT_PAGES} from '../content/about.js';\nimport {glyph,prompt} from './glyphs.js';\nimport {keyLabel} from '../core/actions.js';\nimport {clamp} from '../core/math.js';\nexport function wrap(text,max=60){const lines=[];for(const paragraph of String(text).split('\\\\n')){let line='';for(const word of paragraph.split(' ')){if((line+word).length>max&&line){lines.push(line.trimEnd());line='';}line+=word+' ';}lines.push(line.trimEnd());}return lines;}\nconst label=(h,x,y,s,c='sand',scale=1)=>h.text(x,y,String(s),{color:c,scale});\nexport function paragraph(h,x,y,s,width,scale=1,color='white',gap=11){const lines=wrap(s,Math.floor(width/(6*scale)));for(const l of lines){label(h,x,y,l,color,scale);y+=gap*scale;}return y;}\nfunction corners(h,x,y,w,hh,c='orange'){for(const [a,b,dx,dy] of [[x,y,1,1],[x+w-1,y,-1,1],[x,y+hh-1,1,-1],[x+w-1,y+hh-1,-1,-1]]){h.rect(a-(dx<0?7:0),b,8,1,c);h.rect(a,b-(dy<0?7:0),1,8,c);}}\nfunction footer(h,g){const ui=g.ui,w=h.width;prompt(h,g,'confirm','SELECT',20,h.height-22);prompt(h,g,'back','BACK',Math.max(w*.5,100),h.height-22);if(ui.pages()>1)label(h,w-86,h.height-37,'[ ] PAGE '+(ui.page+1)+'/'+ui.pages(),'sand');}\nexport function drawHUD(g){const ctx=g.ctx,h=ctx.hud,w=h.width,hh=h.height;h.clear();g.prompts=[];const playing=['campaign','round','attract'].includes(g.mode);const ui=g.ui;\n if(playing){if(\"'!g.screen){const yaw=((ctx.camera.yaw*180/Math.PI)%360+360)%360;const dirs=['\"'N','W','S','E'];const compass=dirs[Math.round(yaw/90)%4];label(h,w/2-3,14,compass,'sand');h.rect(w/2-18,25,36,1,'sand');label(h,w/2-13,29,String(Math.round(yaw)).padStart(3,'0'),'mist');if(g.waypoint){const d=Math.round(Math.hypot(g.pos.x-g.waypoint.x,g.pos.z-g.waypoint.z));label(h,w-20,16,d+' M',{color:'white'});h.text(20,16,g.waypoint.name,{anchor:'top-right',color:'sand'});h.text(20,28,d+' M',{anchor:'top-right',color:'white'});}\n if(g.toastAge>0)paragraph(h,22,49,g.toastText,w-44,1,'sand');if(g.mission.current&&g.toastAge<=0&&g.mission.progress>0&&g.mission.progress<1){h.rect(22,51,110,3,'plum');h.rect(22,51,110*Math.min(1,g.mission.progress),3,'orange');}\n if(\"'!g.mapUp&&!g.monocular&&!g.vehicle){h.rect(w/2,hh/2,1,1,'\"'white');if(g.hitAge>0){for(const [dx,dy] of [[-4,-4],[3,-4],[-4,3],[3,3]])h.rect(w/2+dx,hh/2+dy,2,2,'sand');}}\n if(g.monocular||g.aim&&g.weapon.id==='empire'){const rw=Math.min(w,hh)*.8;h.rect(0,0,(w-rw)/2,hh,'ink');h.rect((w+rw)/2,0,w,hh,'ink');h.rect(0,0,w,hh*.15,'ink');h.rect(0,hh*.85,w,hh*.15,'ink');h.rect(w/2,hh*.25,1,hh*.5,'night');h.rect(w/2-rw*.3,hh/2,rw*.6,1,'night');label(h,w/2-25,hh*.75,g.monocular?'MONOCULAR':'6X / EMPIRE','sand');}\n if(g.body.burning>0){for(let y=0;y<hh;y+=5){h.rect(0,y,3+(Math.sin(g.clock*17+y)*3|0),4,'orange');h.rect(w-4,y,4,4,'red');}}\n for(let i=0;i<5;i++){h.rect(22+i*15,hh-34,12,4,'plum');if(g.hp>i*20)h.rect(22+i*15,hh-34,12*clamp((g.hp-i*20)/20,0,1),4,g.hp<20?'red':'sand');}label(h,22,hh-23,'Q '+g.syrettes+'  H '+g.tablets,'sand');const weapon=WEAPONS[g.weapon.id];const ammo=g.weapon.id==='cane'?'KNIFE':g.weapon.jammed?'JAMMED':g.weapon.mag+' / '+g.weapon.reserve;h.text(22,hh-36,ammo,{anchor:'top-right',scale:2,color:g.weapon.jammed?'red':'sand'});h.text(22,hh-23,weapon.name,{anchor:'top-right',color:'mist'});h.rect(w-29,hh-48,7,4,g.weapon.cond<30?'red':g.weapon.cond<60?'orange':'white');\n if(g.body.fever.active){const text='TABLET / THE FEVER';const x=(w-(text.length*6+18))/2;prompt(h,g,'tablet',text,x,hh-59,'orange');g.prompts.push(keyLabel(g,'tablet')+' TABLET');}\n const context=g.contextPrompt();if(context){const a=context.action||'use';const width=(keyLabel(g,a)?.length||1)*6+context.text.length*6+20;prompt(h,g,a,context.text,Math.max(20,(w-width)/2),hh-43);g.prompts.push(keyLabel(g,a)+' '+context.text);if(g.useHold>0){h.rect(w/2-36,hh-47,72,2,'plum');h.rect(w/2-36,hh-47,72*Math.min(1,g.useHold/(context.hold||1)),2,'orange');}}\n if(g.mapUp){prompt(h,g,'map','LOWER MAP',22,hh-66);prompt(h,g,'use','MARK WAYPOINT',w-170,hh-66);g.prompts.push(keyLabel(g,'map')+' LOWER MAP',keyLabel(g,'use')+' MARK WAYPOINT');if(g.noteOpen)paragraph(h,24,76,NOTES[g.noteOpen-1],w-48,1,'sand');}\n if(g.trackerUp)label(h,22,hh-62,g.map.trackerDistance()<60?'SIGNAL / CLOSE':'SIGNAL / '+Math.round(g.map.trackerDistance())+' M','lime');\n if(g.vehicle){const speed=Math.round(Math.abs(g.vehicle.rig.speed)*3.6);label(h,w/2-30,hh-23,speed+' KM/H','sand');label(h,w/2-38,hh-33,g.vehicle.hp<=0?'ENGINE STALLED':g.mounted?'MOUNTED GUN':'DRIVER','orange');}}\n if(g.subtitleAge>0&&g.subtitle){const sc=g.settings.subtitles===2&&w>400?2:1;const lines=wrap(g.subtitle,Math.min(58,Math.floor((w-48)/(6*sc))));const y=hh-92-(lines.length-1)*11*sc;h.rect(18,y-5,w-36,lines.length*11*sc+18,'ink');label(h,24,y-12,g.speaker.toUpperCase(),'orange');paragraph(h,24,y,g.subtitle,w-48,sc,'white');}\n if(g.mode==='attract'){h.rect(18,14,47,13,'ink');label(h,22,17,'DEMO','orange');prompt(h,g,'confirm','RETURN',w-113,hh-20);}}\n if(g.screen==='card'&&g.round){h.rect(18,28,w-36,hh-55,'ink');corners(h,18,28,w-36,hh-55);label(h,30,43,GAME_TITLE,'orange',Math.min(3,Math.floor((w-60)/(GAME_TITLE.length*6))||1));label(h,30,76,'CASH RUN / 6 MINUTES','sand',2);paragraph(h,30,103,'Carry one case at a time to the extraction truck. Friendly fire is on. Most stones wins.',w-60,1);for(const [j,p] of Object.values(g.round.players).entries())label(h,30,143+j*12,p.name+(g.round.card.ready?.includes(p.id)?' / READY':''),'white');prompt(h,g,'confirm','READY',30,hh-52);label(h,w-145,hh-49,'M / MORE TIME','sand');label(h,w-65,37,g.round.card.left==null?'WAIT':Math.ceil(g.round.card.left/1000)+'S','orange');g.prompts=['ENTER READY','M MORE TIME'];return;}\n if(\"'!g.screen)return;\n if(g.screen==='\"'title'){const x=w<300?14:28;const scale=Math.max(1,Math.min(5,Math.floor((w-50)/(7*6))));label(h,x,22,'SORREL / FIELD NOTES 08','sand');h.rect(x,37,30,2,'orange');const words=GAME_TITLE.toUpperCase().split(' ');label(h,x,60,words.shift(),'sand',scale);label(h,x,65+scale*9,words.join(' '),'sand',scale);label(h,x,91+scale*16,'EVERY ROAD HAS A PRICE.','orange',1);if(w>370){for(let y=50;y<205;y+=22)h.rect(w-36,y,7,1,'sand');h.rect(w-31,50,1,155,'sand');label(h,w-111,209,'16.5 / DUSK','sand');label(h,w-111,221,'THE KETTLE','mist');}const rowY=hh-61;if(g.notice)paragraph(h,x,rowY-30,g.notice,w-2*x,1,'sand');drawItems(g,[...ui.items()],x,rowY,Math.min(260,w-2*x),24,1);label(h,x,hh-18,'A MAP IS A PROMISE.','mist');return;}\n const full=['main','pause','dead'].includes(g.screen);const panelW=Math.min(w-32,full?320:420),x=full?0:Math.round((w-panelW)/2),pad=full?25:x+14;if(full)h.rect(x,0,panelW+24,hh,'ink');else h.rect(x,40,panelW,hh-73,'ink');\n let title={main:'THE KETTLE',pause:'THE WORLD CAN WAIT',settings:'SETTINGS',sound:'SOUND',controls:'CONTROLS',picture:'PICTURE',comfort:'COMFORT',about:'ABOUT & CREDITS',dev:'FIELD TOOLS',board:'CONTRACTS',dialogue:ui.speaker.toUpperCase(),brief:'THE TERMS',alt:'A FRIEND\\\\'S PLAN',shop:'GUNS & RETURNS',locker:'CLEAN COPIES',bed:'CHOOSE THE HOUR',rail:'THE GOODS LINE',ledger:'THE LEDGER',dead:'YOU DIED IN THE SORREL.',ending:'THE LAST SURVEY',cash:'CASH RUN',lobby:'WAITING AT THE MINE',results:'THE STONES ARE COUNTED',choice:'THE ONLY HONEST MAP'}[g.screen]||g.screen.toUpperCase();const top=full?32:49;label(h,pad,top,title,'orange',w>=400?2:1);h.rect(pad,top+20,28,2,'sand');let rowY=top+36,rowH=26,font=w>=360?2:1;\n if(g.screen==='dev'){label(h,pad,top+26,devTabs(ui.tab),'sand');rowY=top+46;rowH=23;font=1;label(h,pad,hh-42,'Q/E TAB  [ ] PAGE  R RESET','mist');}\n if(g.screen==='brief'){const m=MISSION_BY_ID[ui.contract];if(m){label(h,pad,rowY,m.title,'sand');rowY+=18;const text=DIALOGUE[m.id][0][1];rowY=paragraph(h,pad,rowY,text,panelW-30,1)+14;label(h,pad,rowY,m.pay+' STONES / '+m.giver.toUpperCase(),'orange');rowY+=27;}font=1;}\n if(g.screen==='alt'){rowY=paragraph(h,pad,rowY,g.mission.current?.alt?.text||'',panelW-30,1,'sand')+24;font=1;}\n if(g.screen==='choice'){rowY=paragraph(h,pad,rowY,g.mission.objective(),panelW-30,1,'sand')+25;font=1;}\n if(g.screen==='shop'){const stock=ui.stock(),v=stock[ui.shopIndex%stock.length];label(h,pad,rowY,v.name,'sand',font);rowY+=23;if(v.damage){for(const [i,[name,val]] of [['DAMAGE',v.damage/100],['RANGE',v.range/360],['RELIABILITY',1-v.wear/3]].entries()){label(h,pad,rowY+i*14,name,'mist');h.rect(pad+100,rowY+i*14,100,4,'plum');h.rect(pad+100,rowY+i*14,100*Math.min(1,val),4,'sand');}rowY+=51;}else rowY=paragraph(h,pad,rowY,v.description,panelW-30,1)+12;label(h,pad,rowY,'STONES IN HAND / '+g.stones,'orange');rowY+=26;font=1;label(h,pad,hh-43,'[ ] BROWSE THE RACK','mist');}\n if(g.screen==='about'){const page=ABOUT_PAGES[ui.page];label(h,pad,rowY,page.title,'sand');rowY+=20;for(const line of page.lines)rowY=paragraph(h,pad,rowY,line,panelW-30,1,'white',10)+8;rowY=hh-65;font=1;}\n if(g.screen==='ledger'){const lines=[(g.world.fire.totalBurnt*.0025).toFixed(1)+' HECTARES TURNED TO ASH.',g.ledger.displaced+' PEOPLE LEARNED A NEW ROAD.',g.ledger.kills+' MEN STOPPED ASKING.',g.ledger.friendsLost+' FRIENDS LEFT ON THE MAP.',g.ledger.earned+' STONES. ALL ACCOUNTED FOR.'];for(const line of lines){rowY=paragraph(h,pad,rowY,line,panelW-30,1,'sand')+12;}rowY=hh-64;font=1;}\n if(g.screen==='ending'){rowY=paragraph(h,pad,rowY,ENDINGS[g.endingChoice],panelW-30,1,'sand',13)+25;rowY=Math.min(rowY,hh-65);font=1;}\n if(g.screen==='dead'){rowY=paragraph(h,pad,rowY,'THE PAPERWORK WILL TAKE LONGER.',panelW-25,1,'sand')+40;font=1;}\n if(g.screen==='results'){let n=0;for(const p of Object.values(g.round?.players||{}).sort((a,b)=>b.stones-a.stones)){label(h,pad,rowY+n*18,p.name+' / '+p.stones+' STONES','sand');n++;}rowY+=n*18+14;font=1;}\n if(g.screen==='cash')label(h,pad,hh-46,'FRIENDS ONLINE PLAY THROUGH AI HUB.','mist');\n if(g.screen==='lobby'){for(const p of g.link?.players||[]){label(h,pad,rowY,p.name,'sand');rowY+=17;}rowY+=15;font=1;}\n drawItems(g,ui.items(),pad,rowY,Math.min(panelW-30,w-pad-18),rowH,font);footer(h,g);\n}\nfunction devTabs(i){return ['CHEATS','TELEPORT','SPAWN','WORLD','MISSION','BALANCE','DEBUG'][i]+' / LIVE';}\nfunction drawItems(g,items,x,y,w,rh,font){const h=g.ctx.hud,ui=g.ui;ui.rects=[];for(let i=0;i<items.length;i++){const item=items[i],yy=y+i*rh,focused=i===ui.focus;ui.rects.push({x,y:yy-5,w,h:rh,i});if(focused){h.rect(x-5,yy-5,w+5,rh-2,'orange');label(h,x-1,yy+1,'>','ink');}const color=focused?'ink':'white';if(item.slider){label(h,x+10,yy+1,item.text,color,1);const {lo,hi}=item.slider,t=(item.value-lo)/(hi-lo);const xx=x+w*.56,ww=w*.36;h.rect(xx,yy+1,ww,6,focused?'red':'plum');h.rect(xx,yy+1,ww*t,6,focused?'ink':'sand');const val=item.slider.hi<=1?Math.round(item.value*100)+'%':item.value.toFixed(item.slider.step<1?1:0);label(h,xx+ww-6*val.length,yy+10,val,color,1);}else{const sc=item.text.length*6*font>w-18?1:font;label(h,x+10,yy,item.text,color,sc);}}}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > src/content/about.js <<'EOF'\nimport {GAME_TITLE} from './title.js';\nexport const SOURCE_INFORMATION={date:'2026-11-05 06:30:14',source:'Far Cry 2',plan:'PLAN.md',genre:'Open world survival shooter',perspective:'First person; optional vehicle chase camera',tech:'Pixel Engine 0.46.0; three.js r186; Rapier 0.20; esbuild 0.28.2; AI Hub client 1.4.0; original game systems',artDirection:'Native 480x270 pixel pipeline; original low poly Sorrel models; red grass, plum shadows, ash and warm paper',animation:'Engine ClipDef and compileClips; THREE.AnimationMixer; native hero locomotion and ragdolls; original hands and soldier clips',audio:'Original code synthesized music, effects and Animalese style voices; music defaults to 10 percent',online:'AI Hub Protocol v1 shared world, 1-4 players; solo Cash Run with hired guns; same computer BroadcastChannel link',testing:'Node headless systems and scripted campaign; replay; Chromium WebGPU file build; hub harness; responsive phone, tablet and desktop; WebKit compatibility notice',research:'PLAN.md; shipped engine guides and API; AI Hub protocol and shared world reference',environment:'Codex CLI (headless); Linux / Ubuntu 26.04 on WSL2',model:'OpenAI, gpt-6.1-sol, reasoning effort max',usage:'added on import'};\nexport const TESTING_FEEDBACK=['unknown','unknown','unknown','unknown'];\nexport const ENGINE_FEEDBACK=['The data based model and clip systems made the original art practical. Headless stepping made long missions testable.','The custom cage collided with a built in id. The catalog now explicitly replaces that entry.','The first person survival simulation, fire persistence, mission runner, physical map and shared world round.','Coordinating first person input, camera attached objects and the independent multiplayer clock.','None. pixel-engine.js is kept byte identical to the release zip.','Offer a grounded first person game preset with neutral key bindings and explicit menu pointer lock control.'];\nexport const PROMPT_FEEDBACK=['The detailed original setting, fixed delivery format and concrete verification requirements.','The broad game length and the vertical slice goal require scope judgment; the plan resolves most details.','Keeping every survival mechanic reachable while integrating a complete story and shared world multiplayer.','Separate a required vertical slice checklist from expansion content, while retaining the explicit hub and packaging tests.'];\nconst tq=['HOW MANY ISSUES DID TESTING CATCH?','HOW MANY WERE CRITICAL?','MOST HELPFUL TEST?','LEAST HELPFUL TEST?'];\nconst eq=['WHAT DID YOU LIKE MOST?','DID YOU GET STUCK OR GUESS WRONG?','WHAT DID YOU BUILD YOURSELF?','HARDEST PART OF THE ENGINE?','WHAT DID YOU CHANGE IN THE ENGINE?','ONE ENGINE CHANGE YOU WOULD ASK FOR?'];\nconst pq=['WHAT DID YOU LIKE ABOUT THE PROMPT?','WHAT WAS CONFUSING?','WHAT WAS THE HARDEST THING?','WHAT WOULD YOU CHANGE?'];\nexport const ABOUT_PAGES=[\n {title:'SOURCE INFORMATION / 1',lines:['DATE: '+SOURCE_INFORMATION.date,'SOURCE: '+SOURCE_INFORMATION.source,'PLAN: '+SOURCE_INFORMATION.plan]},\n {title:'SOURCE INFORMATION / 2',lines:['GENRE: '+SOURCE_INFORMATION.genre,'PERSPECTIVE: '+SOURCE_INFORMATION.perspective,'TECH: '+SOURCE_INFORMATION.tech]},\n {title:'SOURCE INFORMATION / 3',lines:['ART: '+SOURCE_INFORMATION.artDirection,'ANIMATION: '+SOURCE_INFORMATION.animation]},\n {title:'SOURCE INFORMATION / 4',lines:['AUDIO: '+SOURCE_INFORMATION.audio,'ONLINE: '+SOURCE_INFORMATION.online]},\n {title:'SOURCE INFORMATION / 5',lines:['TESTING: '+SOURCE_INFORMATION.testing,'RESEARCH: '+SOURCE_INFORMATION.research]},\n {title:'SOURCE INFORMATION / 6',lines:['ENVIRONMENT: '+SOURCE_INFORMATION.environment,'MODEL: '+SOURCE_INFORMATION.model,'USAGE: '+SOURCE_INFORMATION.usage]},\n ...tq.map((q,i)=>({title:'TESTING FEEDBACK / '+(i+1),lines:[q,TESTING_FEEDBACK[i]]})),...eq.map((q,i)=>({title:'ENGINE FEEDBACK / '+(i+1),lines:[q,ENGINE_FEEDBACK[i]]})),...pq.map((q,i)=>({title:'PROMPT FEEDBACK / '+(i+1),lines:[q,PROMPT_FEEDBACK[i]]})),\n {title:'CREDITS',lines:[GAME_TITLE+' / an original game.','Pixel Engine (MIT), three.js (MIT), Rapier (Apache-2.0). AI Hub session client 1.4.0.','Original models, music, voices, effects and game code by OpenAI. Generic props from the engine native library.','Inspired by Far Cry 2; not affiliated. No external media assets.']}\n];\nEOF\ncat > src/ui/hud.js <<'EOF'\nimport {GAME_TITLE} from '../content/title.js';\nimport {WEAPONS} from '../content/weapons.js';\nimport {DIALOGUE,ENDINGS,NOTES} from '../content/dialogue.js';\nimport {MISSION_BY_ID} from '../content/missions.js';\nimport {ABOUT_PAGES} from '../content/about.js';\nimport {glyph,prompt} from './glyphs.js';\nimport {keyLabel} from '../core/actions.js';\nimport {clamp} from '../core/math.js';\nexport function wrap(text,max=60){const lines=[];for(const paragraph of String(text).split('\\\\n')){let line='';for(const word of paragraph.split(' ')){if((line+word).length>max&&line){lines.push(line.trimEnd());line='';}line+=word+' ';}lines.push(line.trimEnd());}return lines;}\nconst label=(h,x,y,s,c='sand',scale=1)=>h.text(x,y,String(s),{color:c,scale});\nexport function paragraph(h,x,y,s,width,scale=1,color='white',gap=11){const lines=wrap(s,Math.floor(width/(6*scale)));for(const l of lines){label(h,x,y,l,color,scale);y+=gap*scale;}return y;}\nfunction corners(h,x,y,w,hh,c='orange'){for(const [a,b,dx,dy] of [[x,y,1,1],[x+w-1,y,-1,1],[x,y+hh-1,1,-1],[x+w-1,y+hh-1,-1,-1]]){h.rect(a-(dx<0?7:0),b,8,1,c);h.rect(a,b-(dy<0?7:0),1,8,c);}}\nfunction footer(h,g){const ui=g.ui,w=h.width;prompt(h,g,'confirm','SELECT',20,h.height-22);prompt(h,g,'back','BACK',Math.max(w*.5,100),h.height-22);if(ui.pages()>1)label(h,w-86,h.height-37,'[ ] PAGE '+(ui.page+1)+'/'+ui.pages(),'sand');}\nexport function drawHUD(g){const ctx=g.ctx,h=ctx.hud,w=h.width,hh=h.height;h.clear();g.prompts=[];const playing=['campaign','round','attract'].includes(g.mode);const ui=g.ui;\n if(playing){if(\"'!g.screen){const yaw=((ctx.camera.yaw*180/Math.PI)%360+360)%360;const dirs=['\"'N','W','S','E'];const compass=dirs[Math.round(yaw/90)%4];label(h,w/2-3,14,compass,'sand');h.rect(w/2-18,25,36,1,'sand');label(h,w/2-13,29,String(Math.round(yaw)).padStart(3,'0'),'mist');if(g.waypoint){const d=Math.round(Math.hypot(g.pos.x-g.waypoint.x,g.pos.z-g.waypoint.z));label(h,w-20,16,d+' M',{color:'white'});h.text(20,16,g.waypoint.name,{anchor:'top-right',color:'sand'});h.text(20,28,d+' M',{anchor:'top-right',color:'white'});}\n if(g.toastAge>0)paragraph(h,22,49,g.toastText,w-44,1,'sand');if(g.mission.current&&g.toastAge<=0&&g.mission.progress>0&&g.mission.progress<1){h.rect(22,51,110,3,'plum');h.rect(22,51,110*Math.min(1,g.mission.progress),3,'orange');}\n if(\"'!g.mapUp&&!g.monocular&&!g.vehicle){h.rect(w/2,hh/2,1,1,'\"'white');if(g.hitAge>0){for(const [dx,dy] of [[-4,-4],[3,-4],[-4,3],[3,3]])h.rect(w/2+dx,hh/2+dy,2,2,'sand');}}\n if(g.monocular||g.aim&&g.weapon.id==='empire'){const rw=Math.min(w,hh)*.8;h.rect(0,0,(w-rw)/2,hh,'ink');h.rect((w+rw)/2,0,w,hh,'ink');h.rect(0,0,w,hh*.15,'ink');h.rect(0,hh*.85,w,hh*.15,'ink');h.rect(w/2,hh*.25,1,hh*.5,'night');h.rect(w/2-rw*.3,hh/2,rw*.6,1,'night');label(h,w/2-25,hh*.75,g.monocular?'MONOCULAR':'6X / EMPIRE','sand');}\n if(g.body.burning>0){for(let y=0;y<hh;y+=5){h.rect(0,y,3+(Math.sin(g.clock*17+y)*3|0),4,'orange');h.rect(w-4,y,4,4,'red');}}\n for(let i=0;i<5;i++){h.rect(22+i*15,hh-34,12,4,'plum');if(g.hp>i*20)h.rect(22+i*15,hh-34,12*clamp((g.hp-i*20)/20,0,1),4,g.hp<20?'red':'sand');}label(h,22,hh-23,'Q '+g.syrettes+'  H '+g.tablets,'sand');const weapon=WEAPONS[g.weapon.id];const ammo=g.weapon.id==='cane'?'KNIFE':g.weapon.jammed?'JAMMED':g.weapon.mag+' / '+g.weapon.reserve;h.text(22,hh-36,ammo,{anchor:'top-right',scale:2,color:g.weapon.jammed?'red':'sand'});h.text(22,hh-23,weapon.name,{anchor:'top-right',color:'mist'});h.rect(w-29,hh-48,7,4,g.weapon.cond<30?'red':g.weapon.cond<60?'orange':'white');\n if(g.body.fever.active){const text='TABLET / THE FEVER';const x=(w-(text.length*6+18))/2;prompt(h,g,'tablet',text,x,hh-59,'orange');g.prompts.push(keyLabel(g,'tablet')+' TABLET');}\n const context=g.contextPrompt();if(context){const a=context.action||'use';const width=(keyLabel(g,a)?.length||1)*6+context.text.length*6+20;prompt(h,g,a,context.text,Math.max(20,(w-width)/2),hh-43);g.prompts.push(keyLabel(g,a)+' '+context.text);if(g.useHold>0){h.rect(w/2-36,hh-47,72,2,'plum');h.rect(w/2-36,hh-47,72*Math.min(1,g.useHold/(context.hold||1)),2,'orange');}}\n if(g.mapUp){prompt(h,g,'map','LOWER MAP',22,hh-66);prompt(h,g,'use','MARK WAYPOINT',w-170,hh-66);g.prompts.push(keyLabel(g,'map')+' LOWER MAP',keyLabel(g,'use')+' MARK WAYPOINT');if(g.noteOpen)paragraph(h,24,76,NOTES[g.noteOpen-1],w-48,1,'sand');}\n if(g.trackerUp)label(h,22,hh-62,g.map.trackerDistance()<60?'SIGNAL / CLOSE':'SIGNAL / '+Math.round(g.map.trackerDistance())+' M','lime');\n if(g.vehicle){const speed=Math.round(Math.abs(g.vehicle.rig.speed)*3.6);label(h,w/2-30,hh-23,speed+' KM/H','sand');label(h,w/2-38,hh-33,g.vehicle.hp<=0?'ENGINE STALLED':g.mounted?'MOUNTED GUN':'DRIVER','orange');}}\n if(g.subtitleAge>0&&g.subtitle){const sc=g.settings.subtitles===2&&w>400?2:1;const lines=wrap(g.subtitle,Math.min(58,Math.floor((w-48)/(6*sc))));const y=hh-92-(lines.length-1)*11*sc;h.rect(18,y-5,w-36,lines.length*11*sc+18,'ink');label(h,24,y-12,g.speaker.toUpperCase(),'orange');paragraph(h,24,y,g.subtitle,w-48,sc,'white');}\n if(g.mode==='attract'){h.rect(18,14,47,13,'ink');label(h,22,17,'DEMO','orange');prompt(h,g,'confirm','RETURN',w-113,hh-20);}}\n if(g.screen==='card'&&g.round){h.rect(18,28,w-36,hh-55,'ink');corners(h,18,28,w-36,hh-55);label(h,30,43,GAME_TITLE,'orange',Math.min(3,Math.floor((w-60)/(GAME_TITLE.length*6))||1));label(h,30,76,'CASH RUN / 6 MINUTES','sand',2);paragraph(h,30,103,'Carry one case at a time to the extraction truck. Friendly fire is on. Most stones wins.',w-60,1);for(const [j,p] of Object.values(g.round.players).entries())label(h,30,143+j*12,p.name+(g.round.card.ready?.includes(p.id)?' / READY':''),'white');prompt(h,g,'confirm','READY',30,hh-52);label(h,w-145,hh-49,'M / MORE TIME','sand');label(h,w-65,37,g.round.card.left==null?'WAIT':Math.ceil(g.round.card.left/1000)+'S','orange');g.prompts=['ENTER READY','M MORE TIME'];return;}\n if(\"'!g.screen)return;\n if(g.screen==='\"'title'){const x=w<300?14:28;const scale=Math.max(1,Math.min(5,Math.floor((w-50)/(7*6))));label(h,x,22,'SORREL / FIELD NOTES 08','sand');h.rect(x,37,30,2,'orange');const words=GAME_TITLE.toUpperCase().split(' ');label(h,x,60,words.shift(),'sand',scale);label(h,x,65+scale*9,words.join(' '),'sand',scale);label(h,x,91+scale*16,'EVERY ROAD HAS A PRICE.','orange',1);if(w>370){for(let y=50;y<205;y+=22)h.rect(w-36,y,7,1,'sand');h.rect(w-31,50,1,155,'sand');label(h,w-111,209,'16.5 / DUSK','sand');label(h,w-111,221,'THE KETTLE','mist');}const rowY=hh-61;if(g.notice)paragraph(h,x,rowY-30,g.notice,w-2*x,1,'sand');drawItems(g,[...ui.items()],x,rowY,Math.min(260,w-2*x),24,1);label(h,x,hh-18,'A MAP IS A PROMISE.','mist');return;}\n const full=['main','pause','dead'].includes(g.screen);const panelW=Math.min(w-32,full?320:420),x=full?0:Math.round((w-panelW)/2),pad=full?25:x+14;if(full)h.rect(x,0,panelW+24,hh,'ink');else h.rect(x,40,panelW,hh-73,'ink');\n let title={main:'THE KETTLE',pause:'THE WORLD CAN WAIT',settings:'SETTINGS',sound:'SOUND',controls:'CONTROLS',picture:'PICTURE',comfort:'COMFORT',about:'ABOUT & CREDITS',dev:'FIELD TOOLS',board:'CONTRACTS',dialogue:ui.speaker.toUpperCase(),brief:'THE TERMS',alt:'A FRIEND\\\\'S PLAN',shop:'GUNS & RETURNS',locker:'CLEAN COPIES',bed:'CHOOSE THE HOUR',rail:'THE GOODS LINE',ledger:'THE LEDGER',dead:'YOU DIED IN THE SORREL.',ending:'THE LAST SURVEY',cash:'CASH RUN',lobby:'WAITING AT THE MINE',results:'THE STONES ARE COUNTED',choice:'THE ONLY HONEST MAP'}[g.screen]||g.screen.toUpperCase();const top=full?32:49;label(h,pad,top,title,'orange',w>=400?2:1);h.rect(pad,top+20,28,2,'sand');let rowY=top+36,rowH=26,font=w>=360?2:1;\n if(g.screen==='dev'){label(h,pad,top+26,devTabs(ui.tab),'sand');rowY=top+46;rowH=23;font=1;label(h,pad,hh-42,'Q/E TAB  [ ] PAGE  R RESET','mist');}\n if(g.screen==='brief'){const m=MISSION_BY_ID[ui.contract];if(m){label(h,pad,rowY,m.title,'sand');rowY+=18;const text=DIALOGUE[m.id][0][1];rowY=paragraph(h,pad,rowY,text,panelW-30,1)+14;label(h,pad,rowY,m.pay+' STONES / '+m.giver.toUpperCase(),'orange');rowY+=27;}font=1;}\n if(g.screen==='alt'){rowY=paragraph(h,pad,rowY,g.mission.current?.alt?.text||'',panelW-30,1,'sand')+24;font=1;}\n if(g.screen==='choice'){rowY=paragraph(h,pad,rowY,g.mission.objective(),panelW-30,1,'sand')+25;font=1;}\n if(g.screen==='shop'){const stock=ui.stock(),v=stock[ui.shopIndex%stock.length];label(h,pad,rowY,v.name,'sand',font);rowY+=23;if(v.damage){for(const [i,[name,val]] of [['DAMAGE',v.damage/100],['RANGE',v.range/360],['RELIABILITY',1-v.wear/3]].entries()){label(h,pad,rowY+i*14,name,'mist');h.rect(pad+100,rowY+i*14,100,4,'plum');h.rect(pad+100,rowY+i*14,100*Math.min(1,val),4,'sand');}rowY+=51;}else rowY=paragraph(h,pad,rowY,v.description,panelW-30,1)+12;label(h,pad,rowY,'STONES IN HAND / '+g.stones,'orange');rowY+=26;font=1;label(h,pad,hh-43,'[ ] BROWSE THE RACK','mist');}\n if(g.screen==='about'){const page=ABOUT_PAGES[ui.page];label(h,pad,rowY,page.title,'sand');rowY+=20;for(const line of page.lines)rowY=paragraph(h,pad,rowY,line,panelW-30,1,'white',10)+8;rowY=hh-65;font=1;}\n if(g.screen==='ledger'){const lines=[(g.world.fire.totalBurnt*.0025).toFixed(1)+' HECTARES TURNED TO ASH.',g.ledger.displaced+' PEOPLE LEARNED A NEW ROAD.',g.ledger.kills+' MEN STOPPED ASKING.',g.ledger.friendsLost+' FRIENDS LEFT ON THE MAP.',g.ledger.earned+' STONES. ALL ACCOUNTED FOR.'];for(const line of lines){rowY=paragraph(h,pad,rowY,line,panelW-30,1,'sand')+12;}rowY=hh-64;font=1;}\n if(g.screen==='ending'){rowY=paragraph(h,pad,rowY,ENDINGS[g.endingChoice],panelW-30,1,'sand',13)+25;rowY=Math.min(rowY,hh-65);font=1;}\n if(g.screen==='dead'){rowY=paragraph(h,pad,rowY,'THE PAPERWORK WILL TAKE LONGER.',panelW-25,1,'sand')+40;font=1;}\n if(g.screen==='results'){let n=0;for(const p of Object.values(g.round?.players||{}).sort((a,b)=>b.stones-a.stones)){label(h,pad,rowY+n*18,p.name+' / '+p.stones+' STONES','sand');n++;}rowY+=n*18+14;font=1;}\n if(g.screen==='cash')label(h,pad,hh-46,'FRIENDS ONLINE PLAY THROUGH AI HUB.','mist');\n if(g.screen==='lobby'){for(const p of g.link?.players||[]){label(h,pad,rowY,p.name,'sand');rowY+=17;}rowY+=15;font=1;}\n drawItems(g,ui.items(),pad,rowY,Math.min(panelW-30,w-pad-18),rowH,font);footer(h,g);\n}\nfunction devTabs(i){return ['CHEATS','TELEPORT','SPAWN','WORLD','MISSION','BALANCE','DEBUG'][i]+' / LIVE';}\nfunction drawItems(g,items,x,y,w,rh,font){const h=g.ctx.hud,ui=g.ui;ui.rects=[];for(let i=0;i<items.length;i++){const item=items[i],yy=y+i*rh,focused=i===ui.focus;ui.rects.push({x,y:yy-5,w,h:rh,i});if(focused){h.rect(x-5,yy-5,w+5,rh-2,'orange');label(h,x-1,yy+1,'>','ink');}const color=focused?'ink':'white';if(item.slider){label(h,x+10,yy+1,item.text,color,1);const {lo,hi}=item.slider,t=(item.value-lo)/(hi-lo);const xx=x+w*.56,ww=w*.36;h.rect(xx,yy+1,ww,6,focused?'red':'plum');h.rect(xx,yy+1,ww*t,6,focused?'ink':'sand');const val=item.slider.hi<=1?Math.round(item.value*100)+'%':item.value.toFixed(item.slider.step<1?1:0);label(h,xx+ww-6*val.length,yy+10,val,color,1);}else{const sc=item.text.length*6*font>w-18?1:font;label(h,x+10,yy,item.text,color,sc);}}}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_40","type":"agent_message","text":"The campaign now has objectives for every contract, both final choices, buddy rescue and the heal-or-finish decision, and the map’s story reveal. I’m integrating the title, pause menu, settings, dev tools, and attract mode so the full game can be exercised from one build."}}
{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > src/core/save.js <<'EOF'\nexport class SaveStore {\n constructor(){this.disabled=false;this.memory=null;this.key='hardly-far-cry-campaign-v1';}\n read(){try{if(typeof localStorage\"'!=='\"'undefined'){const raw=localStorage.getItem(this.key);if(raw){const s=JSON.parse(raw);return s.version===1?s:null;}}}catch{}return this.memory;}\n write(data){if(this.disabled)return false;const s=JSON.parse(JSON.stringify(data));this.memory=s;try{if(typeof localStorage\"'!=='\"'undefined')localStorage.setItem(this.key,JSON.stringify(s));}catch{}return true;}\n}\nEOF\ncat > src/dev/devmode.js <<'EOF'\nimport {DEFAULTS,SLIDERS} from '../content/tuning-defaults.js';\nimport {WEAPONS,makeWeapon} from '../content/weapons.js';\nimport {SITE_BY_ID} from '../content/sites.js';\nimport {clamp} from '../core/math.js';\nexport class DevTools {\n constructor(g){this.g=g;this.running=false;}\n teleport(id,z){const g=this.g;if(typeof id==='number'){g.teleport(id,z);return;}const s=SITE_BY_ID[id],o=g.world.object(id);if(s)g.teleport(s.at[0],s.at[1]+6);else if(o)g.teleport(o.x,o.z+2);}\n setBalance(id,value){const s=SLIDERS.find(s=>s[0]===id);if(\"'!s)return false;this.g.tuning[id]=clamp(value,s[3],s[4]);return true;}\n reset(){Object.assign(this.g.tuning,DEFAULTS);}\n giveAll(){const g=this.g;for(const id of Object.keys(WEAPONS).filter(i=>i!=='\"'mg'))g.unlock(id);g.stones+=100;g.tablets=12;g.syrettes=5;g.bottles=9;g.charges=9;}\n spawn(kind){const g=this.g,x=g.pos.x+Math.sin(g.ctx.camera.yaw)*-10,z=g.pos.z+Math.cos(g.ctx.camera.yaw)*-10;if(['concord','harvest'].includes(kind)){for(let i=0;i<4;i++)g.actors.spawn({kind:'soldier',model:kind==='harvest'?'harvest':'soldier',faction:kind,x:x+i*2,z,hp:100*g.tuning.enemyHealth,site:'dev'});}else if(kind==='case')g.world.item('dev-case-'+g.clock,'case','TAKE THE STONES',x,z,'stone-case',3,{value:4});else g.vehicles.create(kind,x,z);}\n ignite(){const p=this.g.aimPoint(65);this.g.world.fire.ignite(p.x,p.z,9);}\n forceFever(){this.g.body.attackFever();}\n forceJam(){this.g.weapon.jammed=true;this.g.weapon.racks=3;}\n downBuddy(id){this.g.downBuddy(id);}\n}\nEOF\ncat > src/attract/director.js <<'EOF'\nexport const BEATS=['THE ROAD / THE MAP','A GUN WITH AN OPINION','READ THE WIND','THE LONG FIELD','THE FEVER','FIELD REPAIRS','A LONG VIEW','A FRIEND FOR HIRE','ROUGH STONES','THE GOODS LINE','EVERYTHING HAS BEEN RETURNED','YOU HAVE BEEN DRAWING FOR ME'];\nexport class Attract {\n constructor(g){this.g=g;this.age=0;this.beat=-1;}\n start(){const g=this.g;this.returnScreen=g.screen;g.saveStore.disabled=true;g.world.reset();g.actors.reset();g.mode='attract';g.screen='';g.cheats.god=true;g.cheats.ammo=true;g.cheats.noFever=true;this.age=0;this.beat=-1;this.tick(0);}\n exit(){const g=this.g;g.world.reset();g.actors.reset();g.vehicles.reset();g.mapUp=false;g.trackerUp=false;g.monocular=false;g.vehicle=null;g.body.fever.active=false;g.body.busy=null;g.body.rescueTime=0;g.player.body.setEnabled(true);g.cheats.god=false;g.cheats.ammo=false;g.cheats.noFever=false;g.saveStore.disabled=false;g.mode='title';g.ui.open(this.returnScreen||'title');g.cam.override=g.titleView();g.idle=0;g.subtitleAge=0;}\n tick(dt){const g=this.g;this.age+=dt;const beat=Math.floor(this.age/12)%BEATS.length,t=this.age%12;if(beat\"'!==this.beat){this.beat=beat;g.mapUp=false;g.trackerUp=false;g.monocular=false;g.body.busy=null;g.body.fever.active=false;g.vehicle=null;g.cam.override=null;g.equip('\"'tractor',45);g.toast(BEATS[beat],12);g.ctx.engine.screen.flash('ink',{duration:.6});\n if(beat===0){const v=g.vehicles.list[0];g.vehicles.enter(v);g.mapUp=true;}\n if(beat===1){g.teleport(-205,51);g.weapon.jammed=true;g.weapon.racks=3;g.hands.animate('Unjam');}\n if(beat===2){g.teleport(408,-30);g.equip('flare');g.world.fire.ignite(414,-50,15);}\n if(beat===3){g.hour=22;g.teleport(-270,-240);g.world.fire.ignite(-270,-285,28);}\n if(beat===4){g.teleport(-125,156);g.body.fever.active=true;g.body.fever.age=10;g.hands.animate('Tablet');}\n if(beat===5){g.teleport(-170,10);g.hp=12;g.hands.animate('Pliers');}\n if(beat===6){g.hour=12;g.teleport(-101,-490);g.equip('empire');g.aim=true;}\n if(beat===7){g.hp=40;g.teleport(-270,-260);g.spawnBuddy('ines');g.hands.animate('Syrette');g.say('ines','You owe me a truck. You owe me several trucks.');}\n if(beat===8){g.teleport(-163,122);g.trackerUp=true;g.world.fire.ignite(-172,117,5);}\n if(beat===9){g.teleport(0,70);g.equip('mg');g.vehicles.train.speed=7;}\n if(beat===10){g.teleport(13,40);g.say('tibor','Everything on this rack has been returned at least once.');}\n if(beat===11){g.teleport(-130,-506);for(const id of ['A','B','C'])g.world.fire.burnStrip(id,24);g.mapUp=true;g.say('harrow','You have been drawing for me. Look at it.');}}\n if(beat===0){const x=-90+t*3,z=91;g.cam.override={position:[x,g.world.heightAt(x,z)+2,z],target:[x+20,g.world.heightAt(x+20,z)+1,z-6]};}else if(beat===3){g.cam.override={position:[-270+t*3,g.world.heightAt(-270,-240)+4,-240],target:[-260,g.world.heightAt(-260,-300)+1,-300]};}else if(beat===9){const p=g.vehicles.railPoint(g.vehicles.train.t-11);g.cam.override={position:[p.x,g.world.heightAt(p.x,p.z)+3,p.z],target:[p.x+30,g.world.heightAt(p.x+30,p.z)+2,p.z-10]};}else{g.cam.override={position:[g.pos.x,g.pos.y+1.55,g.pos.z],target:[g.pos.x+Math.sin(t*.08)*9,g.pos.y+1,g.pos.z-25]};}if(beat===1&&t>3&&t<3.1)g.hands.animate('Unjam');if(beat===6&&t>5&&t<5.1)g.fire();}\n}\nEOF\ncat > src/game.js <<'EOF'\n// WASD/mouse, LMB fire, RMB aim, E use, R reload, Q heal, H tablet,\n// G bottle (aim+G plants a charge), M map, T tracker, V monocular, J ledger.\nimport {THREE,CharacterController,toonMaterial,PALETTE,buildModel,setLookLayer,NavGrid} from '../pixel-engine.js';\nimport {GAME_TITLE} from './content/title.js';\nimport {PAD,down,press,tapped,keyLabel} from './core/actions.js';\nimport {SETTINGS,makeTuning} from './content/tuning-defaults.js';\nimport {WEAPONS,UPGRADES,makeWeapon} from './content/weapons.js';\nimport {SITES,SITE_BY_ID,HALTS} from './content/sites.js';\nimport {NOTES,DIALOGUE} from './content/dialogue.js';\nimport {clamp,hash,dist} from './core/math.js';\nimport {installLook,LOOK} from './core/look.js';\nimport {SaveStore} from './core/save.js';\nimport {World} from './world/world.js';\nimport {Sky} from './world/sky.js';\nimport {PaperMap} from './world/map-texture.js';\nimport {Actors} from './actors/actors.js';\nimport {Hands} from './combat/viewmodel.js';\nimport {Body} from './body/health.js';\nimport {Vehicles} from './vehicles/vehicles.js';\nimport {Soundscape} from './audio/director.js';\nimport {MissionRunner} from './missions/runner.js';\nimport {Menu} from './ui/menu.js';\nimport {drawHUD} from './ui/hud.js';\nimport {DevTools} from './dev/devmode.js';\nimport {Attract} from './attract/director.js';\nimport {CashRound} from './net/round.js';\nimport {soloSession,linkSession} from './net/session.js';\nimport {MODELS} from './art/models.js';\nexport class SorrelGame {\n name=GAME_TITLE; assets=[];\n constructor(options={}){this.options=options;this.mode=options.session?'round':'title';this.screen=options.session?'card':'title';this.settings={...SETTINGS};this.tuning=makeTuning();this.look=structuredClone(LOOK);this.device='kbm';this.focus=0;this.cam={override:null,enabled:false};this.pos=new THREE.Vector3(0,40,20);this.eye=new THREE.Vector3();this.move=new THREE.Vector3();this.clock=0;this.hp=100;this.stones=0;this.tablets=3;this.syrettes=3;this.bottles=3;this.charges=2;this.hour=16.5;this.absoluteHours=16.5;this.act=1;this.truce=true;this.wind={x:-.8,z:-.6,speed:5};this.weather='clear';this.prompts=[];this.idle=0;this.notice=options.touch?'Controller or keyboard required':'';this.mapUp=false;this.trackerUp=false;this.trackerUnlocked=false;this.monocular=false;this.aim=false;this.moving=false;this.sprinting=false;this.stamina=6;this.crouch=false;this.walking=false;this.useHold=0;this.throwable='bottle';this.projectiles=[];this.remoteCharge=null;this.weapon=makeWeapon('tractor',45);this.inventory={tractor:this.weapon,m38:makeWeapon('m38'),cane:makeWeapon('cane')};this.unlocked=['cane','m38','tractor'];this.loadout={melee:'cane',sidearm:'m38',main:'tractor',special:null};this.upgrades={};this.ledger={kills:0,displaced:0,friendsLost:0,earned:0,rescues:0,harrowKilled:false};this.buddies=['ines','dov','mags','pell'].map((id,i)=>({id,met:false,dead:false,down:false,hp:200,trust:i===0?1:0,readyAt:0,bleed:0}));this.cheats={god:false,ammo:false,noJams:false,noFever:false,invisible:false,noclip:false};this.debug={fire:false,ai:false,nav:false};this.visitedHalts=['mile-forty'];this.notes=[];this.shotAge=99;this.combatAge=99;this.shotCD=0;this.reloadTime=0;this.toastAge=0;this.subtitleAge=0;this.subtitle='';this.speaker='';this.hitAge=0;this.completed=false;this.endingChoice='column';this.triggers=[0,0];this.saveStore=new SaveStore();this.lastInputKeys='';this.lastPointer=[99,99];this.mission=new MissionRunner(this);this.ui=new Menu(this);this.dev=new DevTools(this);this.attract=new Attract(this);if(options.session)this.round=new CashRound(this,options.session);}\n setup(ctx){this.ctx=ctx;this.rng={body:ctx.random.fork('body'),combat:ctx.random.fork('combat'),wind:ctx.random.fork('wind')};ctx.input.gamepadButtons={...PAD};Object.defineProperty(ctx.input,'wantsPointerLock',{get:()=>false,set(){},configurable:true});for(const key of ['Tab','KeyM','KeyJ','KeyC','KeyF','KeyG','KeyH','KeyT','KeyV','F1'])ctx.input.preventKeys.add(key);installLook(this,ctx);this.readSettings();this.sound=new Soundscape(this,ctx);this.world=new World(this,ctx);this.sky=new Sky(this,ctx);this.player=new CharacterController(ctx.physics,{position:[0,this.world.heightAt(0,52)+.2,52],speed:5.4,jumpSpeed:8,gravity:-24,radius:.3,halfHeight:.5});this.pos.copy(this.player.feet);this.body=new Body(this);this.fever=this.body.fever;this.actors=new Actors(this,ctx);this.vehicles=new Vehicles(this,ctx);this.hands=new Hands(this,ctx);this.map=new PaperMap(this,ctx);this.applySettings(false);this.cam.override=this.titleView();this.world.fire.ignite(-215,-279,19);this.world.fire.ignite(-243,-318,12);if(this.round){this.prepareRound();}this.installPage();}\n titleView(){const x=-223,z=-246,y=this.world?.heightAt(x,z)||50;return {position:[x,y+2.8,z],target:[-257,(this.world?.heightAt(-257,-290)||45)+1.8,-290]};}\n installPage(){if(typeof window==='undefined')return;this.domAbort=new AbortController();const options={signal:this.domAbort.signal};window.addEventListener('keydown',e=>{if(\"'!e.code.startsWith('\"'Pad')){this.device='kbm';if(this.notice){this.notice='';this.options.touch=false;}}this.idle=0;},options);window.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'&&(Math.abs(e.movementX)+Math.abs(e.movementY)>0)){this.device='kbm';this.idle=0;}},options);window.addEventListener('pointerup',()=>{if(this.cam.enabled&&\"'!this.screen&&['\"'campaign','round'].includes(this.mode)&&\"'!this.mapUp){this.ctx.engine.renderer.canvas?.requestPointerLock?.()?.catch?.(()=>{});}},options);document.addEventListener('\"'pointerlockchange',()=>{if(\"'!document.pointerLockElement&&this.hadPointerLock&&this.mode==='\"'campaign'&&\"'!this.screen)this.ui.open('\"'pause');this.hadPointerLock=\"'!!document.pointerLockElement;},options);}\n ready(ctx){if(typeof window!=='\"'undefined')window.__GAME__=this;this.round?.startNetwork();this.options.session?.ready();}\n noFireZone(){return this.truce&&Math.hypot(this.pos.x,this.pos.z-40)<70&&this.mode==='campaign';}\n teleport(x,z,y){if(this.vehicle)this.vehicles.exit();const height=y??this.world.heightAt(x,z)+.1;this.player?.teleport([x,height,z]);this.pos.set(x,height,z);}\n equip(id,cond){if(\"'!WEAPONS[id])return false;if(!this.inventory[id]||cond!==undefined)this.inventory[id]=makeWeapon(id,cond??100);this.weapon=this.inventory[id];this.shotCD=0;this.reloadTime=0;return true;}\n unlock(id){if(!this.unlocked.includes(id))this.unlocked.push(id);if(!this.inventory[id])this.inventory[id]=makeWeapon(id);const slot=WEAPONS[id]?.slot;if(slot)this.loadout[slot]=id;}\n cycleWeapon(dir=1){const ids=[this.loadout.sidearm,this.loadout.main,this.loadout.special,'\"'cane'].filter(Boolean);const index=ids.indexOf(this.weapon.id);this.equip(ids[(index+dir+ids.length)%ids.length]);}\n toast(text,seconds=5){this.toastText=String(text).toUpperCase();this.toastAge=seconds;}\n say(speaker,text){if(\"'!text)return;this.speaker=speaker;this.subtitle=text;this.subtitleAge=Math.max(4,Math.min(13,text.length*.065));this.sound?.say(speaker,text);}\n emit(type,tag=type,value=1){this.mission.emit(type,tag,value);}\n direction(){return new THREE.Vector3(0,0,-1).applyEuler(new THREE.Euler(this.ctx.camera.pitch,this.ctx.camera.yaw,0,'\"'YXZ'));}\n aimPoint(range=65){const from=this.eyePosition().clone(),dir=this.direction();const hit=this.ctx.physics.castRay(from,dir,range,this.player.body);if(hit)return hit.point;for(let d=2;d<range;d+=1){const p=from.clone().addScaledVector(dir,d);if(p.y<=this.world.heightAt(p.x,p.z))return p;}return from.addScaledVector(dir,Math.min(range,35));}\n fire(){if(this.noFireZone()||this.sprinting||this.body.busy||this.reloadTime>0||this.shotCD>0||this.mapUp||this.screen)return false;const w=this.weapon,def=WEAPONS[w.id];if(w.jammed){this.sound.play('jam');this.toast('JAMMED / '+keyLabel(this,'reload')+' SLAP AND RACK',2);this.shotCD=.25;return false;}if(w.cond<=0&&w.id\"'!=='\"'cane'){this.breakGun();return false;}if(w.mag<=0){this.reload();return false;}w.shots++;if(this.mission.current?.id==='m1'&&w.id==='tractor'&&w.shots===5&&\"'!this.mission.flags.jammed){w.jammed=true;w.racks=3;this.mission.flags.jammed=true;this.sound.play('\"'jam');return false;}\n if(\"'!this.cheats.noJams&&w.id!=='\"'cane'&&this.rng.combat.chance(this.tuning.jamRate*.12*(1-w.cond/100)**2)){w.jammed=true;w.racks=this.rng.combat.int(2,4);this.sound.play('jam');return false;}\n this.shotCD=1/def.rate;if(\"'!this.cheats.ammo&&w.id!=='\"'cane')w.mag--;w.cond=Math.max(0,w.cond-def.wear*this.tuning.wearRate*(this.upgrades.cleaning?.6:1));this.shotAge=0;this.combatAge=0;this.hands.shoot();this.sound.play(w.id,1,this.rng.combat.range(-.5,.5));this.ctx.engine.shake.add(w.id==='empire'?.2:.08);if(\"'!this.settings.reducedFlashes)this.ctx.lights.request({position:this.eyePosition().toArray(),color:PALETTE.sand,intensity:9,radius:8,lifetime:.06});const origin=this.eyePosition().clone(),dir=this.direction();if(!this.aim&&w.id!=='\"'cane'){dir.x+=this.rng.combat.range(-.013,.013);dir.y+=this.rng.combat.range(-.013,.013);dir.normalize();}\n if(this.round){this.round.local({type:'shot',origin:origin.toArray(),dir:dir.toArray(),weapon:w.id});}else if(def.projectile){this.projectile(w.id,origin,dir,w.id==='tube'?42:29);}else if(w.id==='weed'){const p=origin.clone().addScaledVector(dir,11);this.world.fire.ignite(p.x,p.z,4);for(const a of this.actors.list)if(\"'!a.dead&&Math.hypot(a.x-p.x,a.z-p.z)<5)this.actors.damage(a,def.damage*this.tuning.weaponDamage);}else this.resolveShot(origin,dir,w.id);if(w.cond<=0)this.breakGun();return true;}\n resolveShot(origin,dir,id,shooter=null){const def=WEAPONS[id]||WEAPONS.tractor;const hit=this.ctx.physics.castRay(origin,dir,def.range,this.player.body);let max=hit?.distance??def.range,target=hit?this.actors.handles.get(hit.collider?.handle):null,damageY=hit?.point?.y-(target?.y||0);for(const a of this.actors.list){if(a.dead||a.kind==='\"'speaker')continue;const centre=new THREE.Vector3(a.x,a.y+1,a.z),v=centre.clone().sub(origin),t=v.dot(dir);if(t<0||t>max+.6)continue;const miss=v.addScaledVector(dir,-t).length();if(miss<(id==='mule'?1.7:.48)){target=a;max=t;damageY=origin.y+dir.y*t-a.y;}}\n let object=null;for(const o of this.world.objects){if(\"'!o.active||!o.explosive)continue;const v=new THREE.Vector3(o.x,o.y+1.4,o.z).sub(origin),t=v.dot(dir),miss=v.addScaledVector(dir,-t).length();if(t>0&&t<max+2&&miss<(o.tag==='\"'fuel-tank'?3.7:1.7)){object=o;target=null;max=t;}}for(const v of this.vehicles.list){if(v.dead)continue;const p=this.vehicles.position(v),d=new THREE.Vector3(p.x,p.y,p.z).sub(origin),t=d.dot(dir);if(t>0&&t<max+1&&d.addScaledVector(dir,-t).length()<1.7){this.vehicles.damage(v,def.damage*this.tuning.weaponDamage);target=null;object=null;max=t;this.hitAge=.15;}}\n if(target){if(this.actors.damage(target,def.damage*this.tuning.weaponDamage,damageY)){this.hitAge=.17;this.ctx.particles.burst('impact',[target.x,target.y+1,target.z],{colors:['red','plum'],count:5});}}else if(object){object.hp-=def.damage*this.tuning.weaponDamage;this.hitAge=.15;if(object.hp<=0)this.explode(object.x,object.z,9,object);}else if(hit)this.ctx.particles.burst('impact',hit.point,{count:4});return target||object;}\n resolveRoundShot(p,ev){const id=WEAPONS[ev.weapon]?ev.weapon:'tractor',def=WEAPONS[id];if(\"'!Array.isArray(ev.dir)||ev.dir.length!==3)return;const from=new THREE.Vector3(p.x,this.world.heightAt(p.x,p.z)+1.55,p.z),dir=new THREE.Vector3(...ev.dir).normalize();if(id==='\"'flare'||id==='weed'||id==='tube'){const point=from.clone().addScaledVector(dir,id==='weed'?12:35);this.world.fire.ignite(point.x,point.z,id==='tube'?8:4);}for(const q of Object.values(this.round.players)){if(q.id===p.id||q.left||q.hp<=0)continue;const v=new THREE.Vector3(q.x,this.world.heightAt(q.x,q.z)+1,q.z).sub(from),t=v.dot(dir);if(t>0&&t<def.range&&v.addScaledVector(dir,-t).length()<.65)this.round.damage(q.id,def.damage*this.tuning.weaponDamage);}this.resolveShot(from,dir,id,p);}\n breakGun(){this.hands.animate('Break');this.sound.play('break');const id=this.weapon.id;this.toast('THE GUN HAS FINISHED ITS CONTRACT.',4);delete this.inventory[id];for(const slot of Object.keys(this.loadout))if(this.loadout[slot]===id)this.loadout[slot]=null;this.equip('cane');}\n reload(){const w=this.weapon;if(w.jammed){w.racks--;this.hands.animate('Unjam');this.sound.play(w.racks%2?'rack':'slap');if(w.racks<=0){w.jammed=false;this.toast('THE ARGUMENT IS SETTLED.',2);}return true;}if(w.mag<WEAPONS[w.id].mag&&w.reserve>0&&\"'!this.reloadTime){this.reloadTime=w.id==='\"'mule'?2.8:w.id==='empire'?2.5:1.8;this.hands.animate('Reload');this.sound.play(w.id==='m38'?'cylinder':'magazine');return true;}return false;}\n projectile(kind,origin,dir,speed){const mesh=new THREE.Mesh(new THREE.BoxGeometry(.12,.12,.23),new THREE.MeshBasicNodeMaterial({color:kind==='tube'?PALETTE.slate:PALETTE.orange}));mesh.position.copy(origin);this.ctx.scene.add(mesh);const v=dir.clone().multiplyScalar(speed);if(kind==='bottle')v.y+=5;this.projectiles.push({kind,pos:origin.clone(),v,age:0,mesh});}\n throw(){if(this.remoteCharge){this.explode(this.remoteCharge.x,this.remoteCharge.z,8);this.remoteCharge=null;return true;}if(this.aim||this.throwable==='charge'){if(this.charges<=0)return false;this.charges--;const p=this.aimPoint(4);this.remoteCharge={x:p.x,z:p.z};this.hands.animate('Throw');this.sound.play('magazine');this.emit('plant','charge');this.toast('CHARGE PLANTED / '+keyLabel(this,'throw')+' DETONATE',4);return true;}if(this.bottles<=0)return false;this.bottles--;this.hands.animate('Throw');this.projectile('bottle',this.eyePosition().clone(),this.direction(),16);return true;}\n explode(x,z,r=8,source){if(source&&\"'!source.active)return;const y=this.world.heightAt(x,z);if(source){source.active=false;source.hp=0;if(source.view){source.view.visible=false;}this.emit('\"'destroy',source.tag);}this.world.fire.ignite(x,z,r);this.ctx.physics.explode([x,y+1,z],{radius:r,impulse:10});this.ctx.particles.burst('smoke',[x,y+2,z],{count:30});this.ctx.particles.burst('impact',[x,y+1,z],{count:25,colors:['sand','orange','red']});this.sound.play('explosion',.7);if(Math.hypot(x-this.pos.x,z-this.pos.z)<80)this.ctx.engine.shake.add(.55);for(const a of this.actors.list)if(\"'!a.dead&&a.kind==='\"'soldier'){const d=Math.hypot(a.x-x,a.z-z);if(d<r)this.actors.damage(a,220*(1-d/r),1);}const d=Math.hypot(this.pos.x-x,this.pos.z-z);if(d<r)this.body.damage(90*(1-d/r),'fire');for(const o of this.world.objects)if(o\"'!==source&&o.active&&o.explosive&&Math.hypot(o.x-x,o.z-z)<r*.7)o.hp-=120;}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > src/core/save.js <<'EOF'\nexport class SaveStore {\n constructor(){this.disabled=false;this.memory=null;this.key='hardly-far-cry-campaign-v1';}\n read(){try{if(typeof localStorage\"'!=='\"'undefined'){const raw=localStorage.getItem(this.key);if(raw){const s=JSON.parse(raw);return s.version===1?s:null;}}}catch{}return this.memory;}\n write(data){if(this.disabled)return false;const s=JSON.parse(JSON.stringify(data));this.memory=s;try{if(typeof localStorage\"'!=='\"'undefined')localStorage.setItem(this.key,JSON.stringify(s));}catch{}return true;}\n}\nEOF\ncat > src/dev/devmode.js <<'EOF'\nimport {DEFAULTS,SLIDERS} from '../content/tuning-defaults.js';\nimport {WEAPONS,makeWeapon} from '../content/weapons.js';\nimport {SITE_BY_ID} from '../content/sites.js';\nimport {clamp} from '../core/math.js';\nexport class DevTools {\n constructor(g){this.g=g;this.running=false;}\n teleport(id,z){const g=this.g;if(typeof id==='number'){g.teleport(id,z);return;}const s=SITE_BY_ID[id],o=g.world.object(id);if(s)g.teleport(s.at[0],s.at[1]+6);else if(o)g.teleport(o.x,o.z+2);}\n setBalance(id,value){const s=SLIDERS.find(s=>s[0]===id);if(\"'!s)return false;this.g.tuning[id]=clamp(value,s[3],s[4]);return true;}\n reset(){Object.assign(this.g.tuning,DEFAULTS);}\n giveAll(){const g=this.g;for(const id of Object.keys(WEAPONS).filter(i=>i!=='\"'mg'))g.unlock(id);g.stones+=100;g.tablets=12;g.syrettes=5;g.bottles=9;g.charges=9;}\n spawn(kind){const g=this.g,x=g.pos.x+Math.sin(g.ctx.camera.yaw)*-10,z=g.pos.z+Math.cos(g.ctx.camera.yaw)*-10;if(['concord','harvest'].includes(kind)){for(let i=0;i<4;i++)g.actors.spawn({kind:'soldier',model:kind==='harvest'?'harvest':'soldier',faction:kind,x:x+i*2,z,hp:100*g.tuning.enemyHealth,site:'dev'});}else if(kind==='case')g.world.item('dev-case-'+g.clock,'case','TAKE THE STONES',x,z,'stone-case',3,{value:4});else g.vehicles.create(kind,x,z);}\n ignite(){const p=this.g.aimPoint(65);this.g.world.fire.ignite(p.x,p.z,9);}\n forceFever(){this.g.body.attackFever();}\n forceJam(){this.g.weapon.jammed=true;this.g.weapon.racks=3;}\n downBuddy(id){this.g.downBuddy(id);}\n}\nEOF\ncat > src/attract/director.js <<'EOF'\nexport const BEATS=['THE ROAD / THE MAP','A GUN WITH AN OPINION','READ THE WIND','THE LONG FIELD','THE FEVER','FIELD REPAIRS','A LONG VIEW','A FRIEND FOR HIRE','ROUGH STONES','THE GOODS LINE','EVERYTHING HAS BEEN RETURNED','YOU HAVE BEEN DRAWING FOR ME'];\nexport class Attract {\n constructor(g){this.g=g;this.age=0;this.beat=-1;}\n start(){const g=this.g;this.returnScreen=g.screen;g.saveStore.disabled=true;g.world.reset();g.actors.reset();g.mode='attract';g.screen='';g.cheats.god=true;g.cheats.ammo=true;g.cheats.noFever=true;this.age=0;this.beat=-1;this.tick(0);}\n exit(){const g=this.g;g.world.reset();g.actors.reset();g.vehicles.reset();g.mapUp=false;g.trackerUp=false;g.monocular=false;g.vehicle=null;g.body.fever.active=false;g.body.busy=null;g.body.rescueTime=0;g.player.body.setEnabled(true);g.cheats.god=false;g.cheats.ammo=false;g.cheats.noFever=false;g.saveStore.disabled=false;g.mode='title';g.ui.open(this.returnScreen||'title');g.cam.override=g.titleView();g.idle=0;g.subtitleAge=0;}\n tick(dt){const g=this.g;this.age+=dt;const beat=Math.floor(this.age/12)%BEATS.length,t=this.age%12;if(beat\"'!==this.beat){this.beat=beat;g.mapUp=false;g.trackerUp=false;g.monocular=false;g.body.busy=null;g.body.fever.active=false;g.vehicle=null;g.cam.override=null;g.equip('\"'tractor',45);g.toast(BEATS[beat],12);g.ctx.engine.screen.flash('ink',{duration:.6});\n if(beat===0){const v=g.vehicles.list[0];g.vehicles.enter(v);g.mapUp=true;}\n if(beat===1){g.teleport(-205,51);g.weapon.jammed=true;g.weapon.racks=3;g.hands.animate('Unjam');}\n if(beat===2){g.teleport(408,-30);g.equip('flare');g.world.fire.ignite(414,-50,15);}\n if(beat===3){g.hour=22;g.teleport(-270,-240);g.world.fire.ignite(-270,-285,28);}\n if(beat===4){g.teleport(-125,156);g.body.fever.active=true;g.body.fever.age=10;g.hands.animate('Tablet');}\n if(beat===5){g.teleport(-170,10);g.hp=12;g.hands.animate('Pliers');}\n if(beat===6){g.hour=12;g.teleport(-101,-490);g.equip('empire');g.aim=true;}\n if(beat===7){g.hp=40;g.teleport(-270,-260);g.spawnBuddy('ines');g.hands.animate('Syrette');g.say('ines','You owe me a truck. You owe me several trucks.');}\n if(beat===8){g.teleport(-163,122);g.trackerUp=true;g.world.fire.ignite(-172,117,5);}\n if(beat===9){g.teleport(0,70);g.equip('mg');g.vehicles.train.speed=7;}\n if(beat===10){g.teleport(13,40);g.say('tibor','Everything on this rack has been returned at least once.');}\n if(beat===11){g.teleport(-130,-506);for(const id of ['A','B','C'])g.world.fire.burnStrip(id,24);g.mapUp=true;g.say('harrow','You have been drawing for me. Look at it.');}}\n if(beat===0){const x=-90+t*3,z=91;g.cam.override={position:[x,g.world.heightAt(x,z)+2,z],target:[x+20,g.world.heightAt(x+20,z)+1,z-6]};}else if(beat===3){g.cam.override={position:[-270+t*3,g.world.heightAt(-270,-240)+4,-240],target:[-260,g.world.heightAt(-260,-300)+1,-300]};}else if(beat===9){const p=g.vehicles.railPoint(g.vehicles.train.t-11);g.cam.override={position:[p.x,g.world.heightAt(p.x,p.z)+3,p.z],target:[p.x+30,g.world.heightAt(p.x+30,p.z)+2,p.z-10]};}else{g.cam.override={position:[g.pos.x,g.pos.y+1.55,g.pos.z],target:[g.pos.x+Math.sin(t*.08)*9,g.pos.y+1,g.pos.z-25]};}if(beat===1&&t>3&&t<3.1)g.hands.animate('Unjam');if(beat===6&&t>5&&t<5.1)g.fire();}\n}\nEOF\ncat > src/game.js <<'EOF'\n// WASD/mouse, LMB fire, RMB aim, E use, R reload, Q heal, H tablet,\n// G bottle (aim+G plants a charge), M map, T tracker, V monocular, J ledger.\nimport {THREE,CharacterController,toonMaterial,PALETTE,buildModel,setLookLayer,NavGrid} from '../pixel-engine.js';\nimport {GAME_TITLE} from './content/title.js';\nimport {PAD,down,press,tapped,keyLabel} from './core/actions.js';\nimport {SETTINGS,makeTuning} from './content/tuning-defaults.js';\nimport {WEAPONS,UPGRADES,makeWeapon} from './content/weapons.js';\nimport {SITES,SITE_BY_ID,HALTS} from './content/sites.js';\nimport {NOTES,DIALOGUE} from './content/dialogue.js';\nimport {clamp,hash,dist} from './core/math.js';\nimport {installLook,LOOK} from './core/look.js';\nimport {SaveStore} from './core/save.js';\nimport {World} from './world/world.js';\nimport {Sky} from './world/sky.js';\nimport {PaperMap} from './world/map-texture.js';\nimport {Actors} from './actors/actors.js';\nimport {Hands} from './combat/viewmodel.js';\nimport {Body} from './body/health.js';\nimport {Vehicles} from './vehicles/vehicles.js';\nimport {Soundscape} from './audio/director.js';\nimport {MissionRunner} from './missions/runner.js';\nimport {Menu} from './ui/menu.js';\nimport {drawHUD} from './ui/hud.js';\nimport {DevTools} from './dev/devmode.js';\nimport {Attract} from './attract/director.js';\nimport {CashRound} from './net/round.js';\nimport {soloSession,linkSession} from './net/session.js';\nimport {MODELS} from './art/models.js';\nexport class SorrelGame {\n name=GAME_TITLE; assets=[];\n constructor(options={}){this.options=options;this.mode=options.session?'round':'title';this.screen=options.session?'card':'title';this.settings={...SETTINGS};this.tuning=makeTuning();this.look=structuredClone(LOOK);this.device='kbm';this.focus=0;this.cam={override:null,enabled:false};this.pos=new THREE.Vector3(0,40,20);this.eye=new THREE.Vector3();this.move=new THREE.Vector3();this.clock=0;this.hp=100;this.stones=0;this.tablets=3;this.syrettes=3;this.bottles=3;this.charges=2;this.hour=16.5;this.absoluteHours=16.5;this.act=1;this.truce=true;this.wind={x:-.8,z:-.6,speed:5};this.weather='clear';this.prompts=[];this.idle=0;this.notice=options.touch?'Controller or keyboard required':'';this.mapUp=false;this.trackerUp=false;this.trackerUnlocked=false;this.monocular=false;this.aim=false;this.moving=false;this.sprinting=false;this.stamina=6;this.crouch=false;this.walking=false;this.useHold=0;this.throwable='bottle';this.projectiles=[];this.remoteCharge=null;this.weapon=makeWeapon('tractor',45);this.inventory={tractor:this.weapon,m38:makeWeapon('m38'),cane:makeWeapon('cane')};this.unlocked=['cane','m38','tractor'];this.loadout={melee:'cane',sidearm:'m38',main:'tractor',special:null};this.upgrades={};this.ledger={kills:0,displaced:0,friendsLost:0,earned:0,rescues:0,harrowKilled:false};this.buddies=['ines','dov','mags','pell'].map((id,i)=>({id,met:false,dead:false,down:false,hp:200,trust:i===0?1:0,readyAt:0,bleed:0}));this.cheats={god:false,ammo:false,noJams:false,noFever:false,invisible:false,noclip:false};this.debug={fire:false,ai:false,nav:false};this.visitedHalts=['mile-forty'];this.notes=[];this.shotAge=99;this.combatAge=99;this.shotCD=0;this.reloadTime=0;this.toastAge=0;this.subtitleAge=0;this.subtitle='';this.speaker='';this.hitAge=0;this.completed=false;this.endingChoice='column';this.triggers=[0,0];this.saveStore=new SaveStore();this.lastInputKeys='';this.lastPointer=[99,99];this.mission=new MissionRunner(this);this.ui=new Menu(this);this.dev=new DevTools(this);this.attract=new Attract(this);if(options.session)this.round=new CashRound(this,options.session);}\n setup(ctx){this.ctx=ctx;this.rng={body:ctx.random.fork('body'),combat:ctx.random.fork('combat'),wind:ctx.random.fork('wind')};ctx.input.gamepadButtons={...PAD};Object.defineProperty(ctx.input,'wantsPointerLock',{get:()=>false,set(){},configurable:true});for(const key of ['Tab','KeyM','KeyJ','KeyC','KeyF','KeyG','KeyH','KeyT','KeyV','F1'])ctx.input.preventKeys.add(key);installLook(this,ctx);this.readSettings();this.sound=new Soundscape(this,ctx);this.world=new World(this,ctx);this.sky=new Sky(this,ctx);this.player=new CharacterController(ctx.physics,{position:[0,this.world.heightAt(0,52)+.2,52],speed:5.4,jumpSpeed:8,gravity:-24,radius:.3,halfHeight:.5});this.pos.copy(this.player.feet);this.body=new Body(this);this.fever=this.body.fever;this.actors=new Actors(this,ctx);this.vehicles=new Vehicles(this,ctx);this.hands=new Hands(this,ctx);this.map=new PaperMap(this,ctx);this.applySettings(false);this.cam.override=this.titleView();this.world.fire.ignite(-215,-279,19);this.world.fire.ignite(-243,-318,12);if(this.round){this.prepareRound();}this.installPage();}\n titleView(){const x=-223,z=-246,y=this.world?.heightAt(x,z)||50;return {position:[x,y+2.8,z],target:[-257,(this.world?.heightAt(-257,-290)||45)+1.8,-290]};}\n installPage(){if(typeof window==='undefined')return;this.domAbort=new AbortController();const options={signal:this.domAbort.signal};window.addEventListener('keydown',e=>{if(\"'!e.code.startsWith('\"'Pad')){this.device='kbm';if(this.notice){this.notice='';this.options.touch=false;}}this.idle=0;},options);window.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'&&(Math.abs(e.movementX)+Math.abs(e.movementY)>0)){this.device='kbm';this.idle=0;}},options);window.addEventListener('pointerup',()=>{if(this.cam.enabled&&\"'!this.screen&&['\"'campaign','round'].includes(this.mode)&&\"'!this.mapUp){this.ctx.engine.renderer.canvas?.requestPointerLock?.()?.catch?.(()=>{});}},options);document.addEventListener('\"'pointerlockchange',()=>{if(\"'!document.pointerLockElement&&this.hadPointerLock&&this.mode==='\"'campaign'&&\"'!this.screen)this.ui.open('\"'pause');this.hadPointerLock=\"'!!document.pointerLockElement;},options);}\n ready(ctx){if(typeof window!=='\"'undefined')window.__GAME__=this;this.round?.startNetwork();this.options.session?.ready();}\n noFireZone(){return this.truce&&Math.hypot(this.pos.x,this.pos.z-40)<70&&this.mode==='campaign';}\n teleport(x,z,y){if(this.vehicle)this.vehicles.exit();const height=y??this.world.heightAt(x,z)+.1;this.player?.teleport([x,height,z]);this.pos.set(x,height,z);}\n equip(id,cond){if(\"'!WEAPONS[id])return false;if(!this.inventory[id]||cond!==undefined)this.inventory[id]=makeWeapon(id,cond??100);this.weapon=this.inventory[id];this.shotCD=0;this.reloadTime=0;return true;}\n unlock(id){if(!this.unlocked.includes(id))this.unlocked.push(id);if(!this.inventory[id])this.inventory[id]=makeWeapon(id);const slot=WEAPONS[id]?.slot;if(slot)this.loadout[slot]=id;}\n cycleWeapon(dir=1){const ids=[this.loadout.sidearm,this.loadout.main,this.loadout.special,'\"'cane'].filter(Boolean);const index=ids.indexOf(this.weapon.id);this.equip(ids[(index+dir+ids.length)%ids.length]);}\n toast(text,seconds=5){this.toastText=String(text).toUpperCase();this.toastAge=seconds;}\n say(speaker,text){if(\"'!text)return;this.speaker=speaker;this.subtitle=text;this.subtitleAge=Math.max(4,Math.min(13,text.length*.065));this.sound?.say(speaker,text);}\n emit(type,tag=type,value=1){this.mission.emit(type,tag,value);}\n direction(){return new THREE.Vector3(0,0,-1).applyEuler(new THREE.Euler(this.ctx.camera.pitch,this.ctx.camera.yaw,0,'\"'YXZ'));}\n aimPoint(range=65){const from=this.eyePosition().clone(),dir=this.direction();const hit=this.ctx.physics.castRay(from,dir,range,this.player.body);if(hit)return hit.point;for(let d=2;d<range;d+=1){const p=from.clone().addScaledVector(dir,d);if(p.y<=this.world.heightAt(p.x,p.z))return p;}return from.addScaledVector(dir,Math.min(range,35));}\n fire(){if(this.noFireZone()||this.sprinting||this.body.busy||this.reloadTime>0||this.shotCD>0||this.mapUp||this.screen)return false;const w=this.weapon,def=WEAPONS[w.id];if(w.jammed){this.sound.play('jam');this.toast('JAMMED / '+keyLabel(this,'reload')+' SLAP AND RACK',2);this.shotCD=.25;return false;}if(w.cond<=0&&w.id\"'!=='\"'cane'){this.breakGun();return false;}if(w.mag<=0){this.reload();return false;}w.shots++;if(this.mission.current?.id==='m1'&&w.id==='tractor'&&w.shots===5&&\"'!this.mission.flags.jammed){w.jammed=true;w.racks=3;this.mission.flags.jammed=true;this.sound.play('\"'jam');return false;}\n if(\"'!this.cheats.noJams&&w.id!=='\"'cane'&&this.rng.combat.chance(this.tuning.jamRate*.12*(1-w.cond/100)**2)){w.jammed=true;w.racks=this.rng.combat.int(2,4);this.sound.play('jam');return false;}\n this.shotCD=1/def.rate;if(\"'!this.cheats.ammo&&w.id!=='\"'cane')w.mag--;w.cond=Math.max(0,w.cond-def.wear*this.tuning.wearRate*(this.upgrades.cleaning?.6:1));this.shotAge=0;this.combatAge=0;this.hands.shoot();this.sound.play(w.id,1,this.rng.combat.range(-.5,.5));this.ctx.engine.shake.add(w.id==='empire'?.2:.08);if(\"'!this.settings.reducedFlashes)this.ctx.lights.request({position:this.eyePosition().toArray(),color:PALETTE.sand,intensity:9,radius:8,lifetime:.06});const origin=this.eyePosition().clone(),dir=this.direction();if(!this.aim&&w.id!=='\"'cane'){dir.x+=this.rng.combat.range(-.013,.013);dir.y+=this.rng.combat.range(-.013,.013);dir.normalize();}\n if(this.round){this.round.local({type:'shot',origin:origin.toArray(),dir:dir.toArray(),weapon:w.id});}else if(def.projectile){this.projectile(w.id,origin,dir,w.id==='tube'?42:29);}else if(w.id==='weed'){const p=origin.clone().addScaledVector(dir,11);this.world.fire.ignite(p.x,p.z,4);for(const a of this.actors.list)if(\"'!a.dead&&Math.hypot(a.x-p.x,a.z-p.z)<5)this.actors.damage(a,def.damage*this.tuning.weaponDamage);}else this.resolveShot(origin,dir,w.id);if(w.cond<=0)this.breakGun();return true;}\n resolveShot(origin,dir,id,shooter=null){const def=WEAPONS[id]||WEAPONS.tractor;const hit=this.ctx.physics.castRay(origin,dir,def.range,this.player.body);let max=hit?.distance??def.range,target=hit?this.actors.handles.get(hit.collider?.handle):null,damageY=hit?.point?.y-(target?.y||0);for(const a of this.actors.list){if(a.dead||a.kind==='\"'speaker')continue;const centre=new THREE.Vector3(a.x,a.y+1,a.z),v=centre.clone().sub(origin),t=v.dot(dir);if(t<0||t>max+.6)continue;const miss=v.addScaledVector(dir,-t).length();if(miss<(id==='mule'?1.7:.48)){target=a;max=t;damageY=origin.y+dir.y*t-a.y;}}\n let object=null;for(const o of this.world.objects){if(\"'!o.active||!o.explosive)continue;const v=new THREE.Vector3(o.x,o.y+1.4,o.z).sub(origin),t=v.dot(dir),miss=v.addScaledVector(dir,-t).length();if(t>0&&t<max+2&&miss<(o.tag==='\"'fuel-tank'?3.7:1.7)){object=o;target=null;max=t;}}for(const v of this.vehicles.list){if(v.dead)continue;const p=this.vehicles.position(v),d=new THREE.Vector3(p.x,p.y,p.z).sub(origin),t=d.dot(dir);if(t>0&&t<max+1&&d.addScaledVector(dir,-t).length()<1.7){this.vehicles.damage(v,def.damage*this.tuning.weaponDamage);target=null;object=null;max=t;this.hitAge=.15;}}\n if(target){if(this.actors.damage(target,def.damage*this.tuning.weaponDamage,damageY)){this.hitAge=.17;this.ctx.particles.burst('impact',[target.x,target.y+1,target.z],{colors:['red','plum'],count:5});}}else if(object){object.hp-=def.damage*this.tuning.weaponDamage;this.hitAge=.15;if(object.hp<=0)this.explode(object.x,object.z,9,object);}else if(hit)this.ctx.particles.burst('impact',hit.point,{count:4});return target||object;}\n resolveRoundShot(p,ev){const id=WEAPONS[ev.weapon]?ev.weapon:'tractor',def=WEAPONS[id];if(\"'!Array.isArray(ev.dir)||ev.dir.length!==3)return;const from=new THREE.Vector3(p.x,this.world.heightAt(p.x,p.z)+1.55,p.z),dir=new THREE.Vector3(...ev.dir).normalize();if(id==='\"'flare'||id==='weed'||id==='tube'){const point=from.clone().addScaledVector(dir,id==='weed'?12:35);this.world.fire.ignite(point.x,point.z,id==='tube'?8:4);}for(const q of Object.values(this.round.players)){if(q.id===p.id||q.left||q.hp<=0)continue;const v=new THREE.Vector3(q.x,this.world.heightAt(q.x,q.z)+1,q.z).sub(from),t=v.dot(dir);if(t>0&&t<def.range&&v.addScaledVector(dir,-t).length()<.65)this.round.damage(q.id,def.damage*this.tuning.weaponDamage);}this.resolveShot(from,dir,id,p);}\n breakGun(){this.hands.animate('Break');this.sound.play('break');const id=this.weapon.id;this.toast('THE GUN HAS FINISHED ITS CONTRACT.',4);delete this.inventory[id];for(const slot of Object.keys(this.loadout))if(this.loadout[slot]===id)this.loadout[slot]=null;this.equip('cane');}\n reload(){const w=this.weapon;if(w.jammed){w.racks--;this.hands.animate('Unjam');this.sound.play(w.racks%2?'rack':'slap');if(w.racks<=0){w.jammed=false;this.toast('THE ARGUMENT IS SETTLED.',2);}return true;}if(w.mag<WEAPONS[w.id].mag&&w.reserve>0&&\"'!this.reloadTime){this.reloadTime=w.id==='\"'mule'?2.8:w.id==='empire'?2.5:1.8;this.hands.animate('Reload');this.sound.play(w.id==='m38'?'cylinder':'magazine');return true;}return false;}\n projectile(kind,origin,dir,speed){const mesh=new THREE.Mesh(new THREE.BoxGeometry(.12,.12,.23),new THREE.MeshBasicNodeMaterial({color:kind==='tube'?PALETTE.slate:PALETTE.orange}));mesh.position.copy(origin);this.ctx.scene.add(mesh);const v=dir.clone().multiplyScalar(speed);if(kind==='bottle')v.y+=5;this.projectiles.push({kind,pos:origin.clone(),v,age:0,mesh});}\n throw(){if(this.remoteCharge){this.explode(this.remoteCharge.x,this.remoteCharge.z,8);this.remoteCharge=null;return true;}if(this.aim||this.throwable==='charge'){if(this.charges<=0)return false;this.charges--;const p=this.aimPoint(4);this.remoteCharge={x:p.x,z:p.z};this.hands.animate('Throw');this.sound.play('magazine');this.emit('plant','charge');this.toast('CHARGE PLANTED / '+keyLabel(this,'throw')+' DETONATE',4);return true;}if(this.bottles<=0)return false;this.bottles--;this.hands.animate('Throw');this.projectile('bottle',this.eyePosition().clone(),this.direction(),16);return true;}\n explode(x,z,r=8,source){if(source&&\"'!source.active)return;const y=this.world.heightAt(x,z);if(source){source.active=false;source.hp=0;if(source.view){source.view.visible=false;}this.emit('\"'destroy',source.tag);}this.world.fire.ignite(x,z,r);this.ctx.physics.explode([x,y+1,z],{radius:r,impulse:10});this.ctx.particles.burst('smoke',[x,y+2,z],{count:30});this.ctx.particles.burst('impact',[x,y+1,z],{count:25,colors:['sand','orange','red']});this.sound.play('explosion',.7);if(Math.hypot(x-this.pos.x,z-this.pos.z)<80)this.ctx.engine.shake.add(.55);for(const a of this.actors.list)if(\"'!a.dead&&a.kind==='\"'soldier'){const d=Math.hypot(a.x-x,a.z-z);if(d<r)this.actors.damage(a,220*(1-d/r),1);}const d=Math.hypot(this.pos.x-x,this.pos.z-z);if(d<r)this.body.damage(90*(1-d/r),'fire');for(const o of this.world.objects)if(o\"'!==source&&o.active&&o.explosive&&Math.hypot(o.x-x,o.z-z)<r*.7)o.hp-=120;}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat >> src/game.js <<'EOF'\n contextPrompt(){if(\"'!['\"'campaign','round','attract'].includes(this.mode)||this.screen)return null;if(this.vehicle)return {text:this.vehicle.hp<35?'EXIT / REPAIR OUTSIDE':'GET OUT',action:'use'};if(this.mapUp)return null;if(this.ridingTrain&&this.mission.current?.id\"'!=='\"'m0')return null;if(this.round){const p=this.round.players[this.round.session.me];if(p?.carrying>=0&&Math.hypot(this.pos.x-this.round.extraction.x,this.pos.z-this.round.extraction.z)<9)return {text:'BANK THE CASE',action:'use'};const q=Object.values(this.round.players).find(q=>q.id\"'!==p?.id&&q.bleed>0&&Math.hypot(q.x-this.pos.x,q.z-this.pos.z)<4);if(q)return {text:'\"'REVIVE '+q.name,hold:3,action:'use',round:true};const c=this.round.cases.find(c=>\"'!c.banked&&!c.burned&&c.carrier<0&&Math.hypot(c.x-this.pos.x,c.z-this.pos.z)<5);if(c)return {text:'\"'TAKE THE CASE',action:'use'};return null;}\n const b=this.buddies.find(b=>b.down&&\"'!b.dead&&b.actor&&Math.hypot(b.actor.x-this.pos.x,b.actor.z-this.pos.z)<4);if(b)return {text:(this.syrettes>0?'\"'SYRETTE / '+keyLabel(this,'melee')+' FINISH IT':'NO SYRETTES / '+keyLabel(this,'melee')+' FINISH IT'),action:'use',hold:.8,buddy:b};\n const candidates=[];const dir=this.direction();for(const o of this.world.objects){if(\"'!o.active||o.explosive||o.tag==='\"'border'||o.tag==='payroll'&&\"'!this.vehicles.list.find(v=>v.id==='\"'pay-truck')?.dead)continue;const dx=o.x-this.pos.x,dz=o.z-this.pos.z,d=Math.hypot(dx,dz);if(d>o.r)continue;const dot=(dx*dir.x+dz*dir.z)/(d||1);if(dot<.7&&d>1.5)continue;if(o.site&&\"'!this.world.siteById(o.site)?.cleared)continue;candidates.push({text:o.name,action:'\"'use',hold:o.tag==='cage'?2:0,object:o,d});}\n for(const v of this.vehicles.list){if(v.dead)continue;const p=this.vehicles.position(v),d=Math.hypot(p.x-this.pos.x,p.z-this.pos.z);if(d<3.8)candidates.push({text:v.hp<35?'OPEN THE BONNET / REPAIR':'DRIVE '+v.kind.toUpperCase(),action:'use',hold:v.hp<35?(this.upgrades.vehicle?1.5:3):0,vehicle:v,d:d-.5});}\n if(this.mission.current?.id==='m8'&&this.mission.step()?.tag==='board-train'&&Math.hypot(this.pos.x,this.pos.z-70)<25)candidates.push({text:'BOARD THE FLATCAR',action:'use',train:true,d:0});\n for(const a of this.actors.list){if(a.dead&&\"'!a.looted&&Math.hypot(a.x-this.pos.x,a.z-this.pos.z)<2.4)candidates.push({text:'\"'TAKE THE FALLEN RIFLE',action:'use',loot:a,d:1.7});}\n candidates.sort((a,b)=>a.d-b.d);return candidates[0]||null;}\n interact(prompt=this.contextPrompt()){if(\"'!prompt)return false;if(this.round){this.round.local({type:'\"'use',held:prompt.hold||0});return true;}if(this.vehicle){this.vehicles.exit();return true;}if(prompt.buddy){if(this.syrettes<=0)return false;this.syrettes--;const b=prompt.buddy;b.down=false;b.hp=100;b.trust++;b.actor.hp=100;b.actor.state='idle';this.hands.animate('Syrette');this.sound.play('syrette');this.emit('buddy-choice','buddy-choice');return true;}if(prompt.vehicle){if(prompt.vehicle.hp<35)return this.vehicles.repair(prompt.vehicle);this.vehicles.enter(prompt.vehicle);return true;}if(prompt.train){this.ridingTrain=true;this.vehicles.train.speed=7;this.equip('mg');this.emit('use','board-train');return true;}if(prompt.loot){prompt.loot.looted=true;this.unlock('tractor');this.equip('tractor',this.rng.combat.range(20,55));this.sound.play('magazine');return true;}\n const o=prompt.object;if(\"'!o)return false;const target=()=>this.emit('\"'use',o.id);switch(o.tag){case 'board':this.ui.open('board');break;\n case 'speaker':this.ui.speaker=o.person;this.say(o.person,(DIALOGUE[this.mission.current?.id]||[]).find(l=>l[0]===o.person)?.[1]||({odile:'I do not need you to be good. I need you to be on time.',vance:'Your invoice will be honoured, regrettably.',ansa:'A hungry man learns to read the wind.',harrow:'You have been drawing for me. Look at it.'}[o.person]||'The account is still open.'));this.ui.open('dialogue');if(this.mission.current?.id==='m9')this.cam.override={position:[this.pos.x,this.pos.y+1.55,this.pos.z],target:[o.x,o.y+1.3,o.z]};break;\n case 'shop':this.say('tibor','Everything on this rack has been returned at least once.');this.ui.open('shop');break;\n case 'bar':{const b=this.buddies.find(b=>b.met&&\"'!b.dead);if(b){this.buddyActive=b.id;this.spawnBuddy(b.id);this.say(b.id,'\"'The account is still open. I will come.');}else this.say('tibor','There is always someone missing from this room.');break;}\n case 'medicine':o.active=false;o.view.visible=false;target();this.toast('MEDICINE LOADED / THE TRUCK IS OUTSIDE',4);break;\n case 'delivery':target();this.say('mags','Hold still. No, you cannot feel that. No, that is normal. Hold still.');break;\n case 'case':case 'payroll':this.stones+=o.value;this.ledger.earned+=o.value;o.active=false;o.view.visible=false;this.sound.play('ui-confirm');target();this.toast(o.value+' STONES / ROUGHLY COUNTED',4);break;\n case 'trig':if(\"'!this.notes.includes(o.id)){this.notes.push(o.id);this.noteOpen=this.notes.length;this.mapUp=true;this.toast('\"'A NOTE IN THE MARGIN / M TO LOWER',5);if(this.notes.length===6){this.unlock('empire');this.toast('A CLEAN OLD EMPIRE WAITS IN YOUR LOCKER.',6);}}else{this.noteOpen=this.notes.indexOf(o.id)+1;this.mapUp=true;}break;\n case 'bed':this.ui.open('bed');break;case 'locker':this.ui.open(this.truce?'locker':'shop');break;\n case 'supply':this.resupply();this.toast('AMMUNITION AND SYRETTES / THE SMALL MERCIES',4);break;\n case 'halt':if(\"'!this.visitedHalts.includes(o.halt))this.visitedHalts.push(o.halt);this.ui.open('\"'rail');break;\n case 'cage':o.active=false;o.view.getObjectByName('Gate').rotation.y=-1.8;this.metBuddy('ines');this.buddyActive='ines';this.spawnBuddy('ines');this.say('ines','I flew for both of them. Neither paid. Get in.');target();break;\n case 'harrow-ledger':o.active=false;target();this.say('harrow','One contractor, paid in advance, to walk the Kettle. Signed: Emil Harrow.');break;\n case 'bypass':this.cisternTime=60;this.mission.flags.bypass=false;this.toast('CISTERN FILLING / HOLD FOR 60 SECONDS',8);this.emit('use','bypass');break;\n default:target();}return true;}\n metBuddy(id){const b=this.buddies.find(b=>b.id===id);if(b&&\"'!b.dead)b.met=true;}\n spawnBuddy(id){const b=this.buddies.find(b=>b.id===id);if(!b||b.dead)return;if(!b.actor)b.actor=this.actors.spawn({id:'\"'buddy-'+id,kind:'buddy',model:id==='pell'?'harvest':id,x:this.pos.x+2,z:this.pos.z+2,hp:b.hp,site:'buddy'});b.actor.x=this.pos.x+2;b.actor.z=this.pos.z+2;b.actor.y=this.world.heightAt(b.actor.x,b.actor.z);b.actor.view.visible=true;}\n downBuddy(id){const b=this.buddies.find(b=>b.id===id);if(\"'!b||b.dead)return;this.spawnBuddy(id);b.hp=0;b.down=true;b.bleed=40;b.actor.x=this.pos.x+2.2;b.actor.z=this.pos.z-1;b.actor.y=this.world.heightAt(b.actor.x,b.actor.z);b.actor.hp=0;b.actor.state='\"'wounded';this.actors.play(b.actor,'WoundedSit');this.say(id,'Do not let it be the fire. Please. Not the fire.');this.toast(keyLabel(this,'use')+' SYRETTE / '+keyLabel(this,'melee')+' FINISH IT',8);}\n finishBuddy(id){const b=this.buddies.find(b=>b.id===id);if(\"'!b||b.dead)return false;b.dead=true;b.down=false;b.hp=0;b.actor?.view?.rotateZ(1.5);if(b.actor){b.actor.dead=true;b.actor.state='\"'dead';}this.ledger.friendsLost++;this.hands.shoot();this.sound.play('m38');this.emit('buddy-choice','buddy-choice');this.say('aster','A name for the wall.');return true;}\n nearestSafehouse(){return this.world.sites.filter(s=>s.kind==='safehouse'||s.safehouse&&s.cleared).sort((a,b)=>Math.hypot(this.pos.x-a.at[0],this.pos.z-a.at[1])-Math.hypot(this.pos.x-b.at[0],this.pos.z-b.at[1]))[0]||SITE_BY_ID['pump-shed'];}\n resupply(){for(const w of Object.values(this.inventory)){w.mag=WEAPONS[w.id].mag;w.reserve=Math.floor(WEAPONS[w.id].reserve*(this.upgrades.belt?1.5:1));}this.syrettes=this.upgrades.pouch?5:3;this.bottles=3;this.charges=2;if(this.buddies.find(b=>b.id==='mags'&&b.met&&\"'!b.dead))this.syrettes++;}\n buy(id){const def=WEAPONS[id]||UPGRADES.find(u=>u.id===id);if(!def)return false;const owned=this.unlocked.includes(id)||this.upgrades[id];if(!owned&&this.stones<def.cost){this.toast('\"'TIBOR DOES NOT EXTEND CREDIT.',4);this.sound.play('jam');return false;}if(\"'!owned){this.stones-=def.cost;if(WEAPONS[id])this.unlock(id);else this.upgrades[id]=true;}if(WEAPONS[id])this.equip(id,100);this.sound.play('\"'magazine');this.toast(owned?'A CLEAN COPY. FOR NOW.':'THE ACCOUNT IS SETTLED.',3);return true;}\n sleep(hour){const delta=((hour-this.hour)+24)%24||24;this.absoluteHours+=delta;this.hour=hour;this.world.fire.time+=delta/24*this.tuning.dayMinutes*60;this.hp=100;this.body.fever.active=false;this.body.fever.next=this.clock+this.tuning.feverMinutes*60;this.resupply();for(const v of this.vehicles.list)if(Math.hypot(this.pos.x-this.vehicles.position(v).x,this.pos.z-this.vehicles.position(v).z)<50)v.hp=100;this.save();this.toast('THE GREEN COMES BACK FASTER THAN THE PEOPLE.',6);}\n travel(id){const h=HALTS.find(h=>h.id===id);if(\"'!h||this.stones<1)return false;this.stones--;this.absoluteHours++;this.hour=(this.hour+1)%24;this.teleport(h.at[0],h.at[1]+3);this.say('\"'bakr','They paint the signs over. Whoever won last.');this.sound.play('train-clack');return true;}\n startMercy(){if(this.mercy){this.toast('THE CLINIC IS STILL WAITING.',4);return;}this.mercy={left:300,target:'three-wells'};this.waypoint={x:-260,z:240,name:'MERCY RUN / FIVE MINUTES'};this.say('odile','I do not need you to be good. I need you to be on time.');}\n newCampaign(){this.round?.dispose();this.round=null;this.options.session=null;this.world.reset();this.actors.reset();this.vehicles.reset();this.mode='campaign';this.completed=false;this.screen='';this.ctx.engine.timeScale=1;this.clock=0;this.hp=100;this.stones=0;this.tablets=0;this.syrettes=3;this.bottles=3;this.charges=2;this.absoluteHours=16.5;this.hour=16.5;this.act=1;this.truce=true;this.inventory={tractor:makeWeapon('tractor',45),m38:makeWeapon('m38'),cane:makeWeapon('cane')};this.weapon=this.inventory.tractor;this.unlocked=['cane','m38','tractor'];this.loadout={melee:'cane',sidearm:'m38',main:'tractor',special:null};this.upgrades={};this.ledger={kills:0,displaced:0,friendsLost:0,earned:0,rescues:0,harrowKilled:false};for(const b of this.buddies){Object.assign(b,{met:false,dead:false,down:false,hp:200,trust:b.id==='ines'?1:0,readyAt:0,bleed:0});if(b.actor){b.actor.dead=false;b.actor.hp=200;b.actor.view.visible=false;}}Object.assign(this.cheats,{god:false,ammo:false,noJams:false,noFever:false,invisible:false,noclip:false});this.mission=new MissionRunner(this);this.cam.override=null;this.cam.enabled=true;this.ctx.camera.yaw=-Math.PI/2;this.ctx.camera.pitch=0;this.body=new Body(this);this.fever=this.body.fever;this.mission.start('m0');this.saveStore.disabled=false;this.save();}\n toTitle(){if(this.options.session)return;this.round?.dispose();this.round=null;this.link?.dispose();this.link=null;if(this.vehicle)this.vehicles.exit();this.mode='title';this.completed=false;this.ctx.engine.timeScale=1;this.mapUp=false;this.trackerUp=false;this.ridingTrain=false;this.body.rescueTime=0;this.world.reset();this.actors.reset();this.vehicles.reset();this.world.fire.ignite(-224,-283,19);this.cam.override=this.titleView();this.ui.open('title');this.idle=0;}\n prepareRound(){this.mode='round';this.screen=this.round.session.kind==='solo'?'':'card';this.cam.override=null;this.cam.enabled=\"'!this.screen;this.truce=false;this.cheats.god=false;this.mapUp=false;this.ridingTrain=false;this.equip('\"'tractor',70);this.unlock('flare');this.loadout.sidearm='flare';this.bottles=2;this.syrettes=2;const p=this.round.players[this.round.session.me];if(p)this.teleport(p.x,p.z);this.world.fire.ignite(215,-325,10);}\n startRound(){this.round?.dispose();this.round=new CashRound(this,soloSession());this.world.reset();this.actors.reset();this.ctx.engine.timeScale=1;this.prepareRound();}\n startLink(host){this.link?.dispose();this.link=linkSession(host);this.link.on('start',()=>{this.round?.dispose();this.round=new CashRound(this,this.link);this.round.started=true;this.world.reset();this.actors.reset();this.prepareRound();this.round.startNetwork();});this.link.ready();this.ui.open('lobby');}\n roundEnded(outcome){this.screen='results';this.cam.enabled=false;this.sound?.stop();if(this.options.session)this.ctx?.audio.setVolume('master',0);}\n endCampaign(){this.completed=true;this.screen='ending';this.cam.enabled=false;this.weather='clear';this.hour=5.5;this.ctx.engine.timeScale=1;this.ui.open('ending');this.save();}\n hasSave(){return \"'!!this.saveStore.read();}\n exportSave(){return {version:1,pos:this.pos.toArray(),yaw:this.ctx.camera.yaw,hp:this.hp,stones:this.stones,tablets:this.tablets,syrettes:this.syrettes,inventory:this.inventory,weapon:this.weapon.id,loadout:this.loadout,unlocked:this.unlocked,upgrades:this.upgrades,hour:this.hour,absoluteHours:this.absoluteHours,clock:this.clock,act:this.act,truce:this.truce,ledger:this.ledger,notes:this.notes,visitedHalts:this.visitedHalts,buddies:this.buddies.map(({actor,...b})=>({...b})),mission:this.mission.save(),fire:this.world.fire.save(),objects:this.world.objects.map(o=>[o.id,o.active,o.hp]),actors:this.actors.list.filter(a=>a.kind==='\"'soldier').map(a=>[a.id,a.hp,a.dead]),vehicles:this.vehicles.list.map(v=>[v.id,v.hp,v.dead]),fever:{...this.body.fever},endingChoice:this.endingChoice,completed:this.completed,truce:this.truce,trackerUnlocked:this.trackerUnlocked,bottles:this.bottles,charges:this.charges};}\n save(){if(this.options.session||this.mode==='attract')return false;return this.saveStore.write(this.exportSave());}\n load(data){const s=data||this.saveStore.read();if(\"'!s||s.version!==1)return false;this.round?.dispose();this.round=null;this.ctx.engine.timeScale=1;this.mode='\"'campaign';this.ui.close();this.cam.override=null;this.cam.enabled=true;this.world.reset();this.actors.reset();this.vehicles.reset();for(const k of ['hp','stone