{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"cat > tests/suites/static.mjs <<'EOF'\nimport {readFile,readdir} from 'node:fs/promises';\nimport {execFileSync} from 'node:child_process';\nimport {checkModel,validateTexture,parseSong,renderSound,compileClips,buildModel,validateClip} from '../../pixel-engine.js';\nimport {ALL_MODELS,MODELS} from '../../src/art/models.js';\nimport {VIEW_DEFS,HAND_CLIPS,HAND_RIG} from '../../src/art/viewmodels.js';\nimport {ACTOR_CLIPS} from '../../src/art/clips.js';\nimport {ALL_TEXTURES} from '../../src/art/textures.js';\nimport {SFX} from '../../src/audio/sfx.js';\nimport {SONGS} from '../../src/audio/music.js';\nimport {MISSIONS} from '../../src/content/missions.js';\nimport {SITE_BY_ID} from '../../src/content/sites.js';\nimport {DIALOGUE} from '../../src/content/dialogue.js';\nasync function walk(dir){const list=[];for(const e of await readdir(dir,{withFileTypes:true})){if(e.isDirectory())list.push(...await walk(dir+'/'+e.name));else list.push(dir+'/'+e.name);}return list;}\nexport const covers=['src/art/models.js','src/art/viewmodels.js','src/art/clips.js','src/audio/sfx.js','src/audio/music.js','src/content/missions.js'];\nexport async function run(check){const original=execFileSync('unzip',['-p','vendor/pixel-engine.zip','pixel-engine/pixel-engine.js'],{maxBuffer:1<<26});check(original.equals(await readFile('pixel-engine.js')),'engine is byte identical to release');const files=await walk('src');let clean=true;for(const f of files){const txt=await readFile(f,'utf8');if(/Math\\\\.random|\\\\bTODO\\\\b|\\\\bFIXME\\\\b|\\\\bplaceholder\\\\b|\\\\bstub\\\\b|coming soon/i.test(txt)){check(false,'unfinished content or unseeded randomness in '+f);clean=false;}}check(clean,'source complete');for(const m of [...ALL_MODELS,...VIEW_DEFS]){const r=checkModel(m,{catalog:MODELS});check(\"'!r.problems.length,m.id+'\"': '+r.problems.join(', '));}for(const t of ALL_TEXTURES){const r=validateTexture(t);check(\"'!r.problems.length,t.id+'\"' texture valid');}for(const [id,s] of Object.entries(SONGS)){try{parseSong(s);check(true,id+' music valid');}catch(e){check(false,id+' music: '+e.message);}}for(const [id,s] of Object.entries(SFX)){const v=renderSound(s,22050,12);let peak=0;for(const x of v)peak=Math.max(peak,Math.abs(x));check(v.length>0&&peak>.0001,id+' synthesizes non-silent samples');}for(const m of MISSIONS){check(m.requires.every(id=>MISSIONS.some(m=>m.id===id)),m.id+' prerequisites');check(m.steps.every(s=>\"'!s.site||SITE_BY_ID[s.site]),m.id+'\"' sites');check((DIALOGUE[m.id]||[]).length>=8,m.id+' narrative content');}try{const view=buildModel(VIEW_DEFS.find(d=>d.id==='view-tractor')).object;const clips=compileClips(HAND_CLIPS,HAND_RIG,view);check(clips.length===HAND_CLIPS.length,'all first person clips compile');}catch(e){check(false,e.message);}const html=await readFile('../Hardly-Far-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-063014.html','utf8');check(\"'!html.includes('\"'src=\\\"http')&&\"'!html.includes('\"'href=\\\"http'),'single file has no remote runtime assets');check(html.indexOf('aihub-session')<html.indexOf('hub:session'),'session client precedes game scripts and tags');}\nEOF\ncat > tests/suites/systems.mjs <<'EOF'\nimport {Engine,Rng} from '../../pixel-engine.js';\nimport {createGame} from '../../src/game.js';\nimport {FireGrid} from '../../src/world/fire.js';\nimport {makeTuning,DEFAULTS,SLIDERS} from '../../src/content/tuning-defaults.js';\nimport {WEAPONS,makeWeapon} from '../../src/content/weapons.js';\nimport {CashRound} from '../../src/net/round.js';\nimport {soloSession} from '../../src/net/session.js';\nexport const covers=['src/game.js','src/body/health.js','src/world/fire.js','src/vehicles/vehicles.js','src/actors/actors.js','src/ui/menu.js','src/net/round.js','src/dev/devmode.js'];\nconst tap=(e,k,n=1)=>{e.input.setKey(k,true);e.step(n);e.input.setKey(k,false);e.step(1);};\nexport async function run(check){\n const f=new FireGrid(new Rng(1337),makeTuning());f.ignite(-100,0,12);for(let i=0;i<240;i++)f.tick(.25,{x:1,z:0,speed:5});const coords=[...f.scorched,...f.active].map(i=>f.coords(i));const head=(Math.max(...coords.map(p=>p[0]))+87.5)/60,flank=Math.max(...coords.map(p=>Math.abs(p[1])))/60;check(head>=2&&head<=5,'fire head 2-5m/s, measured '+head);check(head>flank*1.2,'fire flanks slower than head');const index=[...f.scorched][0];check(\"'!f.lightIndex(index),'\"'burned grass cannot burn twice');const save=f.save(),f2=new FireGrid(new Rng(1),makeTuning());f2.load(save);check(JSON.stringify(f.counts())===JSON.stringify(f2.counts()),'fire save round trip');f2.regrow();check(f2.counts().regrowing===f2.scorched.size,'scar regrowth');const barrier=new FireGrid(new Rng(19),makeTuning(),()=>40,(x)=>Math.abs(x)<12?0:1);barrier.ignite(-30,0,9);for(let i=0;i<300;i++)barrier.tick(.25,{x:1,z:0,speed:5});check(\"'![...barrier.scorched,...barrier.active].some(i=>barrier.coords(i)[0]>12),'\"'ordinary wind cannot cross fuel-free road');\n const e=await Engine.headless(createGame(),{camera:{preset:'first'},viewport:{width:1920,height:1080,dpr:1},settings:{button:false,key:false},seed:7341});const g=e.game;\n try{check(e.audio.volume.music===.1,'music defaults to ten percent');check(g.mode==='title','starts at title');e.step(599);check(g.mode==='title','attract waits ten seconds');e.step(3);check(g.mode==='attract','attract starts after ten seconds');const before=g.saveStore.read();tap(e,'Space');check(g.mode==='title','any input exits attract');check(g.saveStore.read()===before,'attract leaves saves untouched');tap(e,'Enter');check(g.screen==='main','title enters main menu');tap(e,'Enter');check(g.mode==='campaign'&&g.mission.current.id==='m0','new game enters story');g.cheats.god=true;g.cheats.invisible=true;g.mission.current=null;g.ridingTrain=false;g.teleport(-142,145);g.cam.override=null;g.ui.close();e.step(2);const start=g.pos.clone();e.input.setKey('KeyW',true);e.step(60);e.input.setKey('KeyW',false);check(g.pos.distanceTo(start)>3,'WASD drives grounded movement');tap(e,'KeyM');check(g.mapUp,'map raised through action');const oldClock=g.clock;e.step(60);check(g.clock>oldClock,'world continues with map raised');g.map.cursor={x:100,y:100};tap(e,'KeyE');check(\"'!!g.waypoint,'\"'map cursor sets a waypoint');tap(e,'KeyM');\n g.equip('tractor',100);g.weapon.shots=20;g.shotCD=0;g.tuning.jamRate=0;const initial=g.weapon.cond;check(g.fire(),'rifle fires');check(g.weapon.cond<initial&&g.weapon.mag===29,'shots consume ammo and wear');g.weapon.jammed=true;g.weapon.racks=3;g.shotCD=0;const mag=g.weapon.mag;check(\"'!g.fire()&&g.weapon.mag===mag,'\"'jam blocks shots');tap(e,'KeyR');tap(e,'KeyR');tap(e,'KeyR');check(\"'!g.weapon.jammed,'\"'repeated reload clears jam');g.weapon.cond=0;g.shotCD=0;g.fire();check(g.weapon.id==='cane','failed gun falls apart and leaves slot');\n g.hp=30;g.syrettes=3;tap(e,'KeyQ');e.step(55);check(g.hp>=70&&g.syrettes===2,'syrette heals and consumes one');g.hp=12;g.body.lastType='bullet';tap(e,'KeyQ');check(g.body.busy?.kind==='surgery','critical health uses surgery');e.step(250);check(g.hp>=40,'surgery restores critical health without item');g.body.attackFever();g.tablets=2;tap(e,'KeyH');e.step(370);check(\"'!g.body.fever.active&&g.tablets===1,'\"'tablet cures fever');g.stones=100;g.body.attackFever();e.step(1550);check(g.stones===80&&\"'!g.body.fever.active,'\"'ignored fever collapses and costs stones');\n g.cheats.god=false;g.metBuddy('ines');g.body.damage(1000);check(g.hp===40&&g.body.rescueTime>0,'available buddy rescues at zero');e.step(250);g.buddies.find(b=>b.id==='ines').readyAt=1e9;g.body.damage(1000);check(g.screen==='dead','no available buddy reaches death screen');g.ui.close();g.hp=100;g.cheats.god=true;g.teleport(-120,154);g.metBuddy('mags');g.spawnBuddy('mags');g.downBuddy('mags');g.syrettes=1;check(g.interact({buddy:g.buddies.find(b=>b.id==='mags')}),'heal downed buddy');check(\"'!g.buddies.find(b=>b.id==='\"'mags').down,'friend survives syrette');g.downBuddy('mags');g.finishBuddy('mags');check(g.buddies.find(b=>b.id==='mags').dead&&g.ledger.friendsLost===1,'finish choice is permanent');\n const v=g.vehicles.list[0];g.vehicles.enter(v);e.input.setKey('KeyW',true);e.step(180);e.input.setKey('KeyW',false);check(Math.abs(v.rig.speed)>6,'native vehicle accelerates');tap(e,'KeyM');check(g.mapUp&&\"'!!g.vehicle,'\"'map works at wheel');tap(e,'KeyM');g.vehicles.exit();v.hp=0;v.dead=false;check(g.vehicles.repair(v)&&v.hp===50,'stalled vehicle repairs');g.stones=100;check(g.buy('empire')&&g.unlocked.includes('empire'),'shop unlocks clean gun');check(g.weapon.id==='empire'&&g.weapon.cond===100,'shop equips clean copy');g.sleep(0);check(g.hour===0&&g.hasSave(),'sleep chooses hour and saves');const saved=g.exportSave();g.stones=1;g.load(saved);check(g.stones===saved.stones&&g.hour===0,'campaign save round trip');\n tap(e,'Escape');check(e.timeScale===0&&g.screen==='pause','pause freezes physics');const time=g.clock;e.step(30);check(g.clock===time,'clock is frozen in pause');tap(e,'ArrowDown');check(g.focus===1,'keyboard navigates menus');g.settings.glyphs='Xbox';g.device='pad';check(g.state().glyphSet==='Xbox','Xbox glyph setting');g.ui.close();\n for(const [id,,,lo,hi] of SLIDERS){g.dev.setBalance(id,hi);check(g.tuning[id]===hi,'live balance '+id);}g.dev.reset();check(Object.entries(DEFAULTS).every(([k,v])=>g.tuning[k]===v),'balance reset restores every default');g.settings.music=.8;g.resetSettings();check(e.audio.volume.music===.1,'settings reset restores ten percent music');\n const solo=soloSession(),round=new CashRound(g,solo);g.round=round;const p=round.players[0],c=round.cases[0];p.x=c.x;p.z=c.z;round.local({type:'use'});check(p.carrying===0,'cash run picks up case');p.x=round.extraction.x;p.z=round.extraction.z;round.local({type:'use'});check(p.stones===5&&c.banked,'extraction banks the case');round.damage(1,999);p.x=round.players[1].x;p.z=round.players[1].z;round.action(p,{type:'use',held:3});check(round.players[1].hp===45&&p.revives===1,'cash run revives player');round.finish();check(round.ended&&round.outcome.standings.flat().length===4,'time-up standings contain all players');round.dispose();g.round=null;\n }finally{e.dispose();}}\nEOF\nnode tests/run.mjs --only static && node tests/run.mjs --only systems\"","aggregated_output":"148 passed, 0 failed, 0 suites unchanged\nFAIL systems: pause freezes physics\nFAIL systems: clock is frozen in pause\nFAIL systems: keyboard navigates menus\n67 passed, 3 failed, 0 suites unchanged\n","exit_code":1,"status":"failed"}}
