{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"cat >> src/art/viewmodels.js <<'EOF'\nexport const MAP_HANDS=model({id:'map-hands',about:'Both hands gripping the lower corners of a paper map',tags:['viewmodel','hands'],floats:true,collider:'none',palette:{skin:'orange',sleeve:'sand',shadow:'plum'},parts:[-1,1].flatMap(s=>[{box:[.075,.085,.12],at:[s*.245,-.17,.07],c:'sleeve'},{box:[.055,.09,.035],at:[s*.235,-.112,.016],c:'skin'},{box:[.027,.045,.029],at:[s*.214,-.095,.035],c:'skin'},{box:[.056,.025,.027],at:[s*.236,-.075,.014],c:'shadow'}])});\nEOF\npython3 - <<'PY'\np='src/world/map-texture.js';s=open(p).read().replace(\\\"import {THREE,toonMaterial,PALETTE}\\\",\\\"import {THREE,toonMaterial,PALETTE,buildModel}\\\");s=s.replace(\\\"import {clamp}\\\",\\\"import {MAP_HANDS} from '../art/viewmodels.js';\\\\nimport {clamp}\\\");s=s.replace(\\\"this.texture.colorSpace=\\\", \\\"this.texture.flipY=true;this.texture.colorSpace=\\\")\ns=s.replace(\\\"this.group.add(this.plane);\\\", \\\"this.group.add(this.plane);this.group.add(buildModel(MAP_HANDS).object);const gps=new THREE.Mesh(new THREE.BoxGeometry(.073,.066,.022),toonMaterial(PALETTE.plum));gps.position.set(.22,.145,.02);this.group.add(gps);const gpsScreen=new THREE.Mesh(new THREE.PlaneGeometry(.056,.045),new THREE.MeshBasicNodeMaterial({color:PALETTE.green}));gpsScreen.position.set(.22,.145,.033);this.group.add(gpsScreen);\\\")\ns=s.replace(\\\"this.tracker.add(body,screen);\\\", \\\"this.tracker.add(body,screen);const hand=new THREE.Mesh(new THREE.BoxGeometry(.07,.09,.06),toonMaterial(PALETTE.orange));hand.position.set(0,-.09,.015);this.tracker.add(hand);const sleeve=new THREE.Mesh(new THREE.BoxGeometry(.085,.16,.09),toonMaterial(PALETTE.sand));sleeve.position.set(0,-.20,.035);this.tracker.add(sleeve);\\\")\nopen(p,'w').write(s)\np='src/combat/viewmodel.js';s=open(p).read();s=s.replace(\\\"this.current='';this.action\\\", \\\"this.preview=new THREE.Group();ctx.camera.camera.add(this.preview);this.preview.position.set(.33,-.07,-.67);this.preview.rotation.y=1.2;this.preview.rotation.z=-.15;setLookLayer(this.preview,'actors');this.previewId='';this.current='';this.action\\\")\ns=s.replace(\\\"update(dt){const g=this.g;\\\", \\\"update(dt){const g=this.g;this.preview.visible=g.screen==='shop';if(this.preview.visible){const stock=g.ui.stock(),entry=stock[g.ui.shopIndex%stock.length],id=entry.id;if(this.previewId\"'!==id){this.previewId=id;this.preview.clear();const def=VIEW_DEFS.find(d=>d.id==='\"'view-'+id);if(def){const object=buildModel(def).object;object.getObjectByName('ArmL').visible=false;object.getObjectByName('ArmR').visible=false;object.getObjectByName('Rust').visible=false;object.getObjectByName('Tape').visible=false;this.preview.add(object);}}this.preview.rotation.y=1.1+Math.sin(g.clock*.3)*.12;}\\\")\nopen(p,'w').write(s)\np='src/game.js';s=open(p).read().replace(\\\"this.hands?.group,this.map\\\", \\\"this.hands?.group,this.hands?.preview,this.map\\\")\n# Rumble is optional and guarded for browsers or devices without an actuator.\ns=s.replace(\\\"this.hands.shoot();this.sound.play(w.id\\\", \\\"this.hands.shoot();if(this.settings.rumble&&this.device==='pad'&&typeof navigator\"'!=='\"'undefined'){const p=Array.from(navigator.getGamepads?.()||[]).find(p=>p?.connected);p?.vibrationActuator?.playEffect?.('dual-rumble',{duration:65,strongMagnitude:.3,weakMagnitude:.5})?.catch?.(()=>{});}this.sound.play(w.id\\\")\nopen(p,'w').write(s)\np='src/missions/runner.js';s=open(p).read().replace(\\\"g.pass=['concord'\\\", \\\"if(g.buddies.some(b=>b.id==='dov'&&b.met&&\"'!b.dead))g.charges+=2;g.pass=['\"'concord'\\\");open(p,'w').write(s)\nPY\nnode --check src/combat/viewmodel.js && node check.mjs --sheets src/art/models.js > tests/model-sheets.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
