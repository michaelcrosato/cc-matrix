{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat >> src/game.js <<'EOF'\n fixedUpdate(ctx,dt){this.clock+=dt;this.shotAge+=dt;this.combatAge+=dt;this.shotCD=Math.max(0,this.shotCD-dt);if(this.reloadTime>0){this.reloadTime-=dt;if(this.reloadTime<=0){const w=this.weapon,n=Math.min(WEAPONS[w.id].mag-w.mag,w.reserve);w.mag+=n;w.reserve-=n;}}\n const playing=['campaign','round','attract'].includes(this.mode);if(this.mode==='attract')this.attract.tick(dt);if(this.round){this.round.tick(dt);if(this.round.ended)return;}\n if(playing&&(\"'!this.screen||this.screen==='\"'dev'&&this.dev.running)&&(\"'!this.round||this.round.started&&this.round.session.time()>=0)){\n if(this.mode!=='\"'attract')this.playerInput(dt);this.world.tick(dt);this.actors.tick(dt);this.vehicles.tick(dt);if(this.mode==='campaign'){this.body.tick(dt);this.mission.tick(dt);this.absoluteHours+=dt*24/(this.tuning.dayMinutes*60);this.hour=(this.hour+dt*24/(this.tuning.dayMinutes*60))%24;}\n for(let j=this.projectiles.length-1;j>=0;j--){const p=this.projectiles[j],old=p.pos.clone();p.age+=dt;p.v.y-=dt*(p.kind==='tube'?0:p.kind==='flare'?5:9.8);p.pos.addScaledVector(p.v,dt);p.mesh.position.copy(p.pos);const delta=p.pos.clone().sub(old),hit=this.ctx.physics.castRay(old,delta.clone().normalize(),delta.length(),this.player.body);if(p.age>6||p.pos.y<=this.world.heightAt(p.pos.x,p.pos.z)+.12||hit){if(p.kind==='tube')this.explode(p.pos.x,p.pos.z,7);else {this.world.fire.ignite(p.pos.x,p.pos.z,p.kind==='bottle'?6:4);this.sound.play(p.kind==='bottle'?'bottle':'flare-hiss');}p.mesh.removeFromParent();p.mesh.geometry.dispose();this.projectiles.splice(j,1);}}\n for(const b of this.buddies){if(b.dead||\"'!b.actor)continue;if(b.down){b.bleed-=dt;if(b.bleed<=0)this.finishBuddy(b.id);}else if(this.buddyActive===b.id){const a=b.actor,dx=this.pos.x-a.x,dz=this.pos.z-a.z,d=Math.hypot(dx,dz);if(d>5){a.x+=dx/(d||1)*dt*4.8;a.z+=dz/(d||1)*dt*4.8;a.y=this.world.heightAt(a.x,a.z);