{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/world/world.js';s=open(p).read().replace('this.build();this.fireSprites','this.build();for(const o of this.objects.filter(o=>o.explosive)){for(let dz=-3;dz<=3;dz+=3)for(let dx=-3;dx<=3;dx+=3){const i=this.fire.index(o.x+dx,o.z+dz);if(i>=0)this.fire.fuel[i]=4;}}this.fireSprites');open(p,'w').write(s)\np='src/game.js';s=open(p).read().replace(\\\"for(const o of this.world.objects)if(o\"'!==source\", \"for(const v of this.vehicles.list){if(v.dead)continue;const p=this.vehicles.position(v),vd=Math.hypot(p.x-x,p.z-z);if(vd<r)this.vehicles.damage(v,220*(1-vd/r));}for(const o of this.world.objects)if(o!==source\");s=s.replace(\"this.ctx.engine.renderer.canvas?.requestPointerLock?.()?.catch?.(()=>{});\", \"document.querySelector('\"'#app canvas')?.requestPointerLock?.()?.catch?.(()=>{});\\\");open(p,'w').write(s)\nPY\ncat >> tests/ISSUES.md <<'EOF'\n4. **Noncritical, fixed:** Fuel tanks stood on fuel-free depot dirt, so grass ignition could not reach them. Tank cells now carry building fuel and participate in the same fire grid.\n5. **Noncritical, fixed:** Blast damage reached soldiers and props but omitted vehicle bodies. Explosions now damage nearby vehicles, including the payroll convoy.\nEOF\ncat > tests/suites/playthrough.mjs <<'EOF'\nimport {Engine} from '../../pixel-engine.js';\nimport {createGame} from '../../src/game.js';\nimport {SITE_BY_ID} from '../../src/content/sites.js';\nexport const covers=['src/game.js','src/missions/runner.js','src/content/missions.js','src/vehicles/vehicles.js','src/body/health.js','src/world/fire.js'];\nconst tap=(e,k,n=1)=>{e.input.setKey(k,true);e.step(n);e.input.setKey(k,false);e.step(2);};\nexport async function run(check){const e=await Engine.headless(createGame(),{camera:{preset:'first'},viewport:{width:1920,height:1080,dpr:1},settings:{button:false,key:false},seed:7341}),g=e.game;const log=[];\n const aim=(x,z,y)=>{const p=g.eyePosition();const dx=x-p.x,dz=z-p.z,d=Math.hypot(dx,dz);e.camera.yaw=Math.atan2(-dx,-dz);e.camera.pitch=Math.atan2((y??g.world.heightAt(x,z)+1)-p.y,d);};\n const goto=(id)=>{const s=SITE_BY_ID[id];g.dev.teleport(id);e.step(3);log.push(g.mission.current?.id+':'+g.mission.index+' '+id);};\n const useObject=(id,hold=1)=>{const o=g.world.object(id);g.teleport(o.x,o.z+1.2);aim(o.x,o.z,o.y+1);e.step(2);const p=g.contextPrompt();if(p?.object?.id\"'!==id)throw Error('\"'Expected use '+id+', got '+JSON.stringify(p?.text)+' / '+g.status());tap(e,'KeyE',hold);};\n const shootActor=a=>{g.teleport(a.x,a.z+7);g.ui.close();g.equip('tractor',100);for(let n=0;n<16&&\"'!a.dead;n++){aim(a.x,a.z,a.y+1.5);g.shotCD=0;if(g.weapon.jammed){tap(e,'\"'KeyR');continue;}tap(e,'MouseLeft',1);e.step(9);}if(\"'!a.dead)throw Error('\"'Could not kill '+a.id);};\n const shootObject=(id)=>{const o=g.world.object(id),v=g.vehicles.list.find(v=>v.id===id),p=o?{x:o.x,z:o.z,y:o.y}:g.vehicles.position(v);g.teleport(p.x,p.z+14);g.equip('tractor',100);for(let n=0;n<40&&(o?.active??\"'!v.dead);n++){aim(p.x,p.z,p.y+1.3);g.shotCD=0;tap(e,'\"'MouseLeft');e.step(8);}if(o?.active||v&&\"'!v.dead)throw Error('\"'Could not destroy '+id);};\n const report=(id)=>{useObject(id);if(g.screen\"'!=='\"'dialogue')throw Error('No report dialogue '+g.status());tap(e,'Enter');e.step(3);};\n const start=id=>{if(\"'!g.mission.available('\"'board').some(m=>m.id===id))throw Error('Unavailable '+id+' / '+g.status()+' done '+g.mission.done);g.mission.start(id);g.ui.close();e.step(3);};\n try {g.newCampaign();g.cheats.god=true;g.cheats.invisible=true;g.cheats.ammo=true;g.cheats.noJams=true;tap(e,'KeyM');check(g.mission.index===1,'intro requires held map');tap(e,'Enter');e.step(4);check(g.mission.current?.id==='m1','intro arrives at clinic');tap(e,'KeyM');tap(e,'KeyH');e.step(65);useObject('medicine');const car=g.vehicles.list[0];g.teleport(car.rig.body.translation().x,car.rig.body.translation().z+3);tap(e,'KeyE');check(\"'!!g.vehicle,'\"'medicine truck entered through Use');e.input.setKey('KeyW',true);e.step(240);e.input.setKey('KeyW',false);check(Math.abs(car.rig.speed)>6,'medicine truck actually driven');g.vehicles.exit();goto('three-wells');useObject('medicine-delivery');goto('p2');for(const a of g.actors.list.filter(a=>a.site==='p2'&&\"'!a.dead).slice(0,3))shootActor(a);check(g.mission.flags.jammed,'\"'first contract demonstrates scripted fifth-shot jam');\n car.rig.reset([-175,g.world.heightAt(-175,65)+1.4,65],0);g.teleport(-175,68);g.vehicles.enter(car);e.step(2);g.vehicles.exit();e.step(2);g.teleport(-175,68);const p=g.contextPrompt();check(p?.vehicle===car,'stalled truck has bonnet prompt');tap(e,'KeyE',190);check(car.hp>=50,'repair completed through held Use');tap(e,'KeyQ');e.step(55);report('odile');check(g.mission.done.includes('m1')&&g.tablets>=3,'Mercy Run completed and supplied tablets');\n start('m2');goto('ranger-post');for(const a of g.actors.list.filter(a=>a.site==='ranger-post'&&\"'!a.dead).slice(0,5))shootActor(a);useObject('\"'ines-cage',125);goto('pump-shed');check(g.mission.done.includes('m2')&&g.buddies.find(b=>b.id==='ines').met,'Ines freed and safehouse reached');\n start('m3');g.mission.acceptAlt();const tanker=g.vehicles.list.find(v=>v.id==='tanker');g.vehicles.enter(tanker);e.step(2);g.vehicles.exit();goto('east-siding');for(const id of ['tank-0','tank-1','tank-2']){const o=g.world.object(id);g.teleport(o.x,o.z+22);g.equip('flare',100);aim(o.x,o.z,o.y+1.8);g.shotCD=0;tap(e,'MouseLeft');e.step(400);}e.step(500);if(g.world.objects.some(o=>o.tag==='fuel-tank'&&o.active))for(const o of g.world.objects.filter(o=>o.tag==='fuel-tank'&&o.active))shootObject(o.id);goto('water-tower');report('vance');check(g.mission.done.includes('m3')&&g.world.fire.totalBurnt>20,'fuel tanks burned and scar A persisted');\n start('m4');goto('salt-pan');shootObject('pay-truck');useObject('payroll');report('ansa');check(g.mission.done.includes('m4')&&g.trackerUnlocked,'payroll recovered and tracker unlocked');\n start('m5');g.mission.acceptAlt();goto('pump-station');useObject('bypass');e.step(3650);shootObject('water-pump');report('vance');check(g.mission.done.includes('m5')&&\"'!g.clinicDebt,'\"'water bypass saves village');\n start('m6');goto('long-field');g.equip('flare',100);for(const [dx,dz] of [[-32,0],[32,0],[0,37]]){g.teleport(-260+dx,-300+dz+15);aim(-260+dx,-300+dz,g.world.heightAt(-260+dx,-300+dz));g.shotCD=0;tap(e,'MouseLeft');e.step(450);}for(let j=0;j<20&&g.mission.index<3;j++)e.step(180);check(g.mission.index===3,'field fire turns wind and downs a buddy');const buddy=g.buddies.find(b=>b.down);if(\"'!buddy)throw Error('\"'Missing wounded buddy '+g.status());g.teleport(buddy.actor.x,buddy.actor.z+1);g.syrettes=0;tap(e,'KeyF');check(buddy.dead&&g.ledger.friendsLost>=1,'forced finish-it choice with no syrettes');goto('pump-shed');report('ansa');check(g.mission.done.includes('m6'),'Long Field completes after loss');\n start('m7');goto('cut');for(const a of g.actors.list.filter(a=>a.site==='cut'&&\"'!a.dead).slice(0,5))shootActor(a);useObject('\"'harrow-ledger');goto('ranger-post');check(g.mission.done.includes('m7')&&\"'!g.truce,'\"'Harrow contract reveal collapses truce');\n start('m8');goto('mile-forty');e.step(7250);g.teleport(0,70);tap(e,'KeyE');e.step(3650);check(g.mission.done.includes('m8')&&g.column,'last train launches refugee column');\n start('m9');goto('observatory');if(g.mapUp)tap(e,'KeyM');report('harrow');check(g.screen==='choice','Harrow offers final contract choice');tap(e,'Enter');check(g.screen==='choice'&&g.mission.index===3,'sheet choice follows Harrow choice');const branch=g.exportSave();for(const ending of ['column','walk']){if(ending==='walk'){g.load(branch);e.step(2);}g.mission.choose(ending);e.step(3);check(g.mission.current?.id==='end','ending path '+ending);goto('pass');e.step(5150);g.equip('flare',100);g.teleport(-570,-408);aim(-587,-430,g.world.heightAt(-587,-430));g.shotCD=0;tap(e,'MouseLeft');for(let j=0;j<30&&\"'!g.completed;j++)e.step(180);if(!g.completed){g.throwable='\"'bottle';g.bottles=3;tap(e,'KeyG');e.step(1800);}check(g.completed&&g.screen==='ending'&&g.endingChoice===ending,'complete ending '+ending+' / '+g.status());}check(g.mission.done.includes('m9')&&g.ledger.friendsLost>=1,'story finishes with a dead buddy and persistent ledger');check(e.errors.length===0,'campaign has no engine errors');\n }catch(err){throw Error(err.message+'\\\\nPath: '+log.join(' > ')+'\\\\n'+g.status());}finally{e.dispose();}}\nEOF\nnode tests/run.mjs --only playthrough\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
