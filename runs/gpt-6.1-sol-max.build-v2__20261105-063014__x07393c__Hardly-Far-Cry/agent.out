{"type":"item.started","item":{"id":"item_105","type":"command_execution","command":"/bin/bash -lc \"cat >> src/content/roads.js <<'EOF'\nexport const COLUMN_ROUTE=[...SCARS.A,...SCARS.C.slice(1),...SCARS.B.slice(1),[-590,-430]];\nEOF\ncat >> src/core/math.js <<'EOF'\nexport function alongPolyline(points,distance){let d=Math.max(0,distance);for(let i=1;i<points.length;i++){const a=points[i-1],b=points[i],len=Math.hypot(b[0]-a[0],b[1]-a[1]);if(d<=len||i===points.length-1){const t=clamp(d/(len||1),0,1);return {x:lerp(a[0],b[0],t),z:lerp(a[1],b[1],t),yaw:Math.atan2(b[0]-a[0],b[1]-a[1])};}d-=len;}return {x:points[0][0],z:points[0][1],yaw:0};}\nEOF\npython3 - <<'PY'\np='src/game.js';s=open(p).read().replace(\\\"import {SITES,SITE_BY_ID,HALTS}\\\", \\\"import {COLUMN_ROUTE} from './content/roads.js';\\\\nimport {SITES,SITE_BY_ID,HALTS}\\\");s=s.replace(\\\" endCampaign(){\\\", \\\" formColumn(){this.column=true;this.columnDistance??=0;for(const a of this.actors.list.filter(a=>a.kind==='civilian')){a.kind='column';if(\"'!a.displaced){a.displaced=true;this.ledger.displaced++;}a.state='\"'walking';}}\\\\n endCampaign(){\\\")\ns=s.replace(\\\"this.body.tick(dt);this.mission.tick(dt);\\\", \\\"this.body.tick(dt);if(this.column)this.columnDistance=(this.columnDistance||0)+dt*(this.columnHasSheet?2.8:2.1);this.mission.tick(dt);\\\")\ns=s.replace(\\\"this.completed=false;this.finalBuddies=false;\\\", \\\"this.completed=false;this.column=false;this.columnDistance=0;this.columnHasSheet=false;this.finalBuddies=false;\\\")\ns=s.replace(\\\"fever:{...this.body.fever},endingChoice\\\", \\\"civilians:this.actors.list.filter(a=>a.kind==='civilian'||a.kind==='column').map(a=>[a.id,a.kind,a.x,a.z,a.state,a.displaced]),column:\"'!!this.column,columnDistance:this.columnDistance||0,columnHasSheet:!!this.columnHasSheet,fever:{...this.body.fever},endingChoice\")\ns=s.replace(\"'\"'bottles','charges'])if\\\", \\\"'bottles','charges','column','columnDistance','columnHasSheet'])if\\\")\ns=s.replac