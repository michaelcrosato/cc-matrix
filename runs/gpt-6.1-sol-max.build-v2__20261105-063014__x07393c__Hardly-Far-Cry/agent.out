1.8,.45,1.5],[0,1.45,1.3],'body'),box([1.85,.18,1.8],[0,2.48,-.05],'metal'),...[-.85,.85].flatMap(x=>[-.8,.75].map(z=>box([.12,1.1,.12],[x,1.98,z],'metal'))),box([1.65,.55,.16],[0,1.6,.6],'dark'),...[-.48,.48].map(x=>box([.56,.55,.2],[x,1.65,-.5],'seat')),box([1.7,.1,1.8],[0,1.45,-1.15],'body'),box([1.9,.5,.12],[0,1.67,-2.05],'body'),...[-.92,.92].map(x=>box([.1,.45,1.9],[x,1.65,-1.15],'body')),box([1.98,.14,.18],[0,.9,2.25],'metal'),...[-.65,.65].map(x=>box([.35,.24,.08],[x,1.43,2.1],'light')),box([.9,.22,.08],[0,1.15,2.12],'dark'),...(truck?[box([2.2,1.5,2.8],[0,1.95,-1.5],'body'),box([2.3,.16,2.9],[0,2.8,-1.5],'metal')]:[]),...(technical?[{cyl:[.12,1.2,.12],at:[0,2,-1.1],c:'metal'},box([.22,.28,1.2],[0,2.7,-.8],'dark'),box([.3,.4,.25],[.25,2.65,-1],'body')]:[])]});}\nexport const pickup=vehicleDef('pickup');export const technical=vehicleDef('technical',false,true);export const truck=vehicleDef('cargo-truck',true);\nexport const locomotive=model({id:'locomotive',about:'Weathered diesel locomotive for the goods line',tags:['train','vehicle'],collider:'none',palette:{body:'red',roof:'slate',dark:'night',mark:'sand'},parts:[box([3,2.8,9],[0,2.3,0],'body'),box([3.2,.25,9.2],[0,3.85,0],'roof'),box([2.4,.9,.1],[0,3,4.56],'dark'),...[-1.35,1.35].flatMap(x=>[-3,-1,1,3].map(z=>({cyl:[1.2,.4,1.2],at:[x,.6,z],rot:[0,0,90],c:'dark',seg:8}))),box([3.05,.3,8.9],[0,1.65,0],'mark')]});\nexport const flatcar=model({id:'flatcar',about:'Rail flatcar with timber deck and steel bogies',tags:['train','vehicle'],collider:'none',palette:{deck:'orange',steel:'slate',dark:'night'},parts:[box([3,.4,10],[0,1.2,0],'deck'),box([2.8,.4,9.8],[0,.85,0],'steel'),...[-1.35,1.35].flatMap(x=>[-3.5,-2.5,2.5,3.5].map(z=>({cyl:[.9,.3,.9],at:[x,.45,z],rot:[0,0,90],c:'dark',seg:8})))]});\nexport const ALL_MODELS=[soldier,harvest,ines,dov,mags,odile,tibor,vance,ansa,harrow,bakr,civilian,acacia,bottleTree,shack,bunker,tower,sandbags,gate,fuelTank,silo,waterTower,pump,clinic,cage,trig,caseModel,headframe,dome,mound,pickup,technical,truck,locomotive,flatcar];\nexport const MODELS=new ModelCatalog([...MODEL_LIBRARY.all(),...ALL_MODELS]);\nEOF\ncat > src/art/textures.js <<'EOF'\nimport {textureDef} from '../../pixel-engine.js';\nconst FRAMES=[['..........','.....a....','....ab....','...aba....','...abc.a..','..abcbab..','..abcdba..','.abcddba..','.abcddcba.','.abcddcba.','abccddccba','abccddccba','.abbccbb..','..aaaaaa..'],['..........','...a......','...ba.....','...bca....','..abca....','..abcba...','.abbcb.a..','.abddcaba.','abbddccba.','abcdddccba','abccddccba','.bccddcba.','..bbccba..','...aaaa...'],['..........','......a...','.....ab...','..a..ba...','..baaba...','..bcabba..','.abcdcba..','.abcddcba.','abccdddba.','abcddddcba','.bccddccba','..bccdcba.','..bbccba..','...aaaa...'],['..........','....a.....','...ab.....','...ba.....','..abc..a..','..abc.ab..','.abcbaaba.','.abcddcba.','abccdddba.','abccdddcb.','.bccddcba.','..bccdcba.','..bbccba..','...aaaa...']];\nexport const flame=textureDef({id:'grass-flame',about:'Four frame grass fire with bright core and windblown tips',tags:['fx','fire'],size:[40,14],frames:4,palette:{a:'red',b:'orange',c:'sand',d:'white'},layers:FRAMES.map((pixels,i)=>({at:[i*10,0],pixels,legend:{a:'a',b:'b',c:'c',d:'d'}}))});\nexport const ALL_TEXTURES=[flame];\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > src/world/terrain.js <<'EOF'\nimport {Terrain,createNoise,PALETTE,THREE} from '../../pixel-engine.js';\nimport {SITES} from '../content/sites.js';\nimport {ROADS,RIVER} from '../content/roads.js';\nimport {clamp,lerp,smooth,polyDistance} from '../core/math.js';\nexport function buildTerrain(ctx){\n const noise=createNoise(61407);const base=(x,z)=>40+14*noise.fbm2(x*.0032,z*.0032)+2.5*noise.fbm2(x*.02,z*.02);\n const raw=(x,z)=>{let y=base(x,z);const ridge=Math.hypot((x+130)*.8,z+520);y+=42*(1-smooth(20,280,ridge))*(.65+.35*noise.ridged2(x*.012,z*.012));y+=30*(1-smooth(-635,-510,x))*(smooth(0,70,Math.hypot(x+590,z+430)));const pan=1-smooth(100,170,Math.hypot(x-200,z-470));y=lerp(y,36,pan);const mine=Math.hypot(x-150,z+300);if(mine<80)y-=Math.floor((1-smooth(12,80,mine))*4)*5;return y;};\n const stamps=SITES.map(s=>({...s,y:raw(...s.at)}));const roadSegs=ROADS.flatMap(p=>p.slice(1).map((b,i)=>({a:p[i],b,ya:raw(...p[i]),yb:raw(...b)})));\n const height=(x,z)=>{let y=raw(x,z);const river=polyDistance(x,z,RIVER);if(river.d<24)y-=3.6*(1-smooth(7,24,river.d));for(const s of stamps){const d=Math.hypot(x-s.at[0],z-s.at[1]);if(d<s.r+10)y=lerp(y,s.y,1-smooth(s.r*.7,s.r+10,d));}let near=null;for(const r of roadSegs){const dx=r.b[0]-r.a[0],dz=r.b[1]-r.a[1],t=clamp(((x-r.a[0])*dx+(z-r.a[1])*dz)/(dx*dx+dz*dz),0,1),d=Math.hypot(x-r.a[0]-dx*t,z-r.a[1]-dz*t);if(d<8&&(\"'!near||d<near.d))near={d,y:lerp(r.ya,r.yb,t)};}if(near&&river.d>16)y=lerp(y,near.y,1-smooth(3.6,8,near.d));return y;};\n const land=new Terrain({size:[1280,1280],cells:[512,512],bands:[{below:10000,color:PALETTE.sand}],steep:.62,rock:PALETTE.plum}).generate(height);land.attach(ctx.physics);ctx.scene.add(land.mesh);land.mesh.receiveShadow=true;\n const classify=(x,z)=>{const river=polyDistance(x,z,RIVER).d;if(river<8)return '\"'water';const road=Math.min(...ROADS.map(p=>polyDistance(x,z,p).d));if(road<4.3)return 'road';if(Math.hypot(x-200,z-470)<135)return 'salt';const n=land.normalAt(x,z);if(n.y<.72)return 'rock';if(SITES.some(s=>Math.hypot(x-s.at[0],z-s.at[1])<s.r*.72))return 'dirt';return river<23?'bank':'grass';};\n const colors=land.mesh.geometry.getAttribute('color');const colorSet=Object.fromEntries(Object.entries(PALETTE).map(([k,v])=>[k,new THREE.Color(v)]));\n for(let z=0;z<512;z++)for(let x=0;x<512;x++){const wx=-640+(x+.5)*2.5,wz=-640+(z+.5)*2.5,type=classify(wx,wz),q=noise.fbm2(wx*.11,wz*.11);let c=type==='road'?colorSet.red:type==='salt'?colorSet.mist:type==='rock'?colorSet.plum:type==='water'?colorSet.teal:type==='bank'?colorSet.green:type==='dirt'?colorSet.orange:colorSet.sand;const f=type==='grass'?.72+q*.16:type==='road'?.7+q*.14:.8+q*.15;const i=(x+z*512)*6;for(let k=0;k<6;k++)colors.setXYZ(i+k,c.r*f,c.g*f,c.b*f);}\n colors.needsUpdate=true;const baseColors=new Float32Array(colors.array);\n return {land,baseColors,classify,noise,heightAt:(x,z)=>land.heightAt(x,z)};\n}\nEOF\ncat > src/world/world.js <<'EOF'\nimport {THREE,PALETTE,buildModel,addModelColliders,mergeStaticMeshes,GrassField,SpriteBatch,spriteSheet,WaterSurface,clothGrid,SoftMesh,toonMaterial,Precipitation} from '../../pixel-engine.js';\nimport {MODELS} from '../art/models.js';\nimport {flame} from '../art/textures.js';\nimport {SITES,SITE_BY_ID,CASES,TRIGS,HALTS} from '../content/sites.js';\nimport {RIVER,RAIL} from '../content/roads.js';\nimport {buildTerrain} from './terrain.js';\nimport {FireGrid} from './fire.js';\nimport {polyDistance,dist} from '../core/math.js';\nexport class World {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.terrain=buildTerrain(ctx);this.heightAt=this.terrain.heightAt;this.sites=SITES.map(s=>({...s,seen:false,cleared:\"'!s.guards,clearedAt:-999}));this.objects=[];this.trees=[];this.grasses=new Map();this.flags=[];this.water=[];this.changed=new Set();this.clock=0;this.seed=ctx.random.fork('\"'world');this.fire=new FireGrid(ctx.random.fork('fire'),g.tuning,this.heightAt,(x,z)=>{const t=this.terrain.classify(x,z);return ['grass','bank'].includes(t)?1:0;});this.fire.onChange=(i,state)=>{this.changed.add(i);if(g.round?.session.isHost&&state>0)g.round.world.push([state===1?'fire':'burnt',i]);};this.build();this.fireSprites=new SpriteBatch(spriteSheet(flame),{capacity:1800});for(let i=0;i<1800;i++)this.fireSprites.spawn([0,-1000,0],{size:2});ctx.scene.add(this.fireSprites);this.fireLight=ctx.lights.request({position:[0,-1000,0],color:0xff7a30,intensity:35,radius:65,flicker:'torch'});this.rain=new Precipitation({kind:'rain',count:1700});this.rain.intensity=0;ctx.scene.add(this.rain);this.fireLoop=ctx.audio.loop('fire-loop',{volume:0});}\n place(id,x,z,yaw=0,{collide=true,palette,scale=1,staticMerge=false}={}){const build=buildModel(id,{catalog:MODELS,palette,seed:this.seed.int(1,99999)});const y=this.heightAt(x,z);build.object.position.set(x,y,z);build.object.rotation.y=yaw;build.object.scale.setScalar(scale);build.object.updateMatrixWorld(true);if(collide&&scale===1)addModelColliders(this.ctx.physics,build,[x,y,z],yaw);build.object.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true;}});if(staticMerge)this.staticObjects.push(build.object);else this.ctx.scene.add(build.object);return build.object;}\n item(id,tag,name,x,z,model,r=2.7,props={}){const view=model?this.place(model,x,z,props.yaw||0,{collide:false}):null;const item={id,tag,name,x,z,y:this.heightAt(x,z),view,r,hp:props.hp??100,active:true,...props};this.objects.push(item);return item;}\n build(){this.staticObjects=[];for(const s of this.sites)this.site(s);\n for(const c of CASES)this.item(c.id,'case','TAKE THE STONES',...c.at,'stone-case',2.7,{value:c.value});\n for(const t of TRIGS)this.item(t.id,'trig','READ THE MARGIN',...t.at,'trig-pillar');\n for(const h of HALTS){this.item('halt-'+h.id,'halt','TAKE THE GOODS LINE',...h.at,'signpost',4,{halt:h.id});}\n for(let i=0;i<410;i++){const x=this.seed.range(-625,625),z=this.seed.range(-625,625);if(this.terrain.classify(x,z)\"'!=='\"'grass')continue;const view=this.place(i%13?'acacia':'bottle-tree',x,z,this.seed.range(0,6.28),{scale:this.seed.range(.7,1.5),collide:false,staticMerge:false,palette:i%3?{leaf:'green',lit:'green'}:{leaf:'teal',lit:'green'}});this.ctx.physics.addStaticCylinder([x,this.heightAt(x,z)+1.8,z],1.8,.4);this.trees.push({view,x,z,cell:this.fire.index(x,z),burnt:false});}\n for(let i=0;i<130;i++){const x=this.seed.range(-625,625),z=this.seed.range(-625,625);if(this.terrain.classify(x,z)\"'!=='\"'grass')continue;this.place(i%4?'bush':'termite-mound',x,z,this.seed.range(0,6),{collide:false,staticMerge:true,scale:this.seed.range(.7,1.5)});}\n for(let i=0;i<70;i++){const x=this.seed.range(-520,260),z=this.seed.range(-630,-390);this.place('rock',x,z,0,{collide:false,staticMerge:true,scale:this.seed.range(2,6)});}\n for(let i=1;i<RIVER.length;i++){const a=RIVER[i-1],b=RIVER[i],x=(a[0]+b[0])/2,z=(a[1]+b[1])/2,y=this.heightAt(x,z)+1.1;const w=new WaterSurface({size:[14,Math.hypot(b[0]-a[0],b[1]-a[1])+9],at:[x,y,z]});w.rotation.y=Math.atan2(b[0]-a[0],b[1]-a[1]);this.ctx.scene.add(w);this.water.push(w);}\n for(const [x,z] of [[250,80],[120,230], [270,-5]]){const y=this.heightAt(x,z)+1.3;const deck=new THREE.Mesh(new THREE.BoxGeometry(12,.4,32),toonMaterial(PALETTE.plum));deck.position.set(x,y,z);this.ctx.scene.add(deck);this.ctx.physics.addStaticBox({position:[x,y,z],halfExtents:[6,.2,16]});}\n for(let k=1;k<RAIL.length;k++){const a=RAIL[k-1],b=RAIL[k],d=Math.hypot(b[0]-a[0],b[1]-a[1]),yaw=Math.atan2(b[0]-a[0],b[1]-a[1]);for(let t=0;t<d;t+=5){const x=a[0]+(b[0]-a[0])*t/d,z=a[1]+(b[1]-a[1])*t/d;const tie=new THREE.Mesh(new THREE.BoxGeometry(3.3,.12,.32),toonMaterial(PALETTE.plum));tie.position.set(x,this.heightAt(x,z)+.09,z);tie.rotation.y=yaw;this.staticObjects.push(tie);for(const off of [-.9,.9]){const rail=new THREE.Mesh(new THREE.BoxGeometry(.1,.15,5.1),toonMaterial(PALETTE.slate));rail.position.set(x+Math.cos(yaw)*off,this.heightAt(x,z)+.19,z-Math.sin(yaw)*off);rail.rotation.y=yaw;this.staticObjects.push(rail);}}}\n const meshes=[];for(const o of this.staticObjects){o.updateMatrixWorld(true);o.traverse(m=>{if(m.isMesh)meshes.push(m);});}this.ctx.scene.add(...mergeStaticMeshes(meshes));this.staticObjects=[];\n }\n site(s){const [x,z]=s.at;const prop=(m,dx,dz,rot=0,opt)=>this.place(m,x+dx,z+dz,rot,{staticMerge:true,...opt});const item=(id,tag,name,dx,dz,m,r,p)=>this.item(id,tag,name,x+dx,z+dz,m,r,p);\n if(s.kind==='town'){prop('clinic-tent',-14,4);prop('shack',13,-4);prop('shack',-17,-21);prop('shack',17,20);prop('market-stall',-3,14,0,{collide:false});prop('well',8,9);prop('lamp-post',0,3);item('board','board','READ THE CONTRACTS',0,-10,'notice-board');item('odile','speaker','TALK TO ODILE',-13,7,null,3.4,{person:'odile'});item('tibor','shop','TIBOR / GUNS AND RETURNS',13,-1,null,3.4,{person:'tibor'});item('bar','bar','THE HIRED HANDS',-17,-17,'table',3.5);item('medicine','medicine','TAKE THE MEDICINE',-10,5,'crate',2.7);}\n else if(s.kind==='safehouse'||s.safehouse){prop('shack',0,0);item(s.id+'-bed','bed','SLEEP AND SAVE',-2,0,'bed',2.8,{site:s.id});item(s.id+'-locker','locker','OPEN THE LOCKER',2,-1,'crate',2.8,{site:s.id});item(s.id+'-supply','supply','RESTOCK',2,1,'barrel',2.8,{site:s.id});if(s.kind==='tower')prop('water-tower',10,-8);if(s.id==='ranger-post'){prop('watchtower',-14,-8);item('ines-cage','cage','OPEN THE CAGE',11,0,'cage',3.8);}}\n if(s.kind==='checkpoint'||s.kind==='post'){prop('sandbag-run',-6,-4);prop('sandbag-run',6,4);prop('boom-gate',0,1);prop('shack',-11,7);prop('barrel',7,-4);}\n if(s.kind==='fort'){for(const dz of [-20,20])for(const dx of [-26,-18,-10,10,18,26])prop('stone-wall',dx,dz,0,{collide:false,scale:2});prop('bunker',0,-5);prop('shack',-16,0);prop('watchtower',23,-18);item('vance','speaker','TALK TO VANCE',0,0,null,3.6,{person:'vance'});}\n if(s.kind==='granary'){for(const dx of [-12,0,12])prop('silo',dx,-15);prop('shack',0,7);prop('shack',18,9);item('ansa','speaker','TALK TO MOTHER ANSA',0,11,null,3.6,{person:'ansa'});}\n if(s.kind==='field'){prop('bunker',0,-12);item('ammo-bunker','ammo-bunker','AMMUNITION BUNKER',0,-9,'crate',3,{hp:180,explosive:true});for(const dx of [-35,35])prop('shack',dx,0);}\n if(s.kind==='fuel'){for(const [i,dz] of [-13,0,13].entries())item('tank-'+i,'fuel-tank','FUEL RESERVOIR',0,dz,'fuel-tank',5,{hp:85,explosive:true});prop('shack',20,0);prop('watchtower',-20,-15);}\n if(s.kind==='village'){for(let i=0;i<8;i++)prop('shack',Math.cos(i*.785)*24,Math.sin(i*.785)*24,i*.785);for(const dx of [-8,0,8])prop('well',dx,0);item('medicine-delivery','delivery','DELIVER THE MEDICINE',0,4,'crate',3.5);}\n if(s.kind==='pump'){prop('shack',0,0);item('water-pump','pump','THE WATER QUESTION',0,3,'pump',3.5,{hp:160,explosive:true});item('bypass','bypass','OPEN THE BYPASS',-5,4,'barrel',3);}\n if(s.kind==='salt'){item('payroll','payroll','TAKE THE PAYROLL',0,0,'stone-case',4,{value:20});prop('shack',18,0);}\n if(s.kind==='mine'){prop('mine-headframe',0,-18);prop('shack',-15,8);prop('shack',20,14);for(let i=0;i<7;i++)prop('rock',Math.cos(i)*50,Math.sin(i)*50,0,{collide:false,scale:9});item('harrow-ledger','harrow-ledger','TAKE THE SURVEYOR\\\\'S LEDGER',-15,11,'table',3.5);}\n if(s.kind==='observatory'){prop('observatory-dome',0,-15);prop('shack',0,3);item('harrow','speaker','SIT WITH THE SURVEYOR',0,7,null,3.6,{person:'harrow'});prop('table',0,5);prop('radio-mast',12,-8,0,{collide:false});}\n if(s.kind==='pass'){prop('sandbag-run',-10,-5);prop('sandbag-run',10,-8);item('border','border','THE LAST GRASS',0,-4,'signpost',5);}\n if(s.guards){const x0=x-8,z0=z+8,y=this.heightAt(x0,z0);const flag=clothGrid({width:1.4,height:.7,cols:8,rows:5,origin:[x0,y+3.3,z0],pin:'left'});const mesh=new SoftMesh(flag,toonMaterial(PALETTE.red));this.ctx.scene.add(mesh);this.flags.push({body:flag,mesh});}\n }\n object(id){return this.objects.find(o=>o.id===id);}\n siteById(id){return this.sites.find(s=>s.id===id);}\n fuelAt(x,z){const i=this.fire.index(x,z);return i>=0&&this.fire.fuel[i]&&this.fire.state[i]===0;}\n tick(dt){this.clock+=dt;const g=this.g;if(\"'!g.round||g.round.session.isHost)this.fire.tick(dt,g.wind,g.weather==='\"'storm');for(const f of this.flags){f.body.wind=[g.wind.x*g.wind.speed,0,g.wind.z*g.wind.speed];f.body.step(dt);}for(const o of this.objects){if(\"'!o.active||!o.explosive)continue;const i=this.fire.index(o.x,o.z);if(i>=0&&this.fire.state[i]===1){o.hp-=dt*25;if(o.hp<=0)g.explode(o.x,o.z,9,o);}}if(this.clock%1<dt){for(const s of this.sites){if(Math.hypot(g.pos.x-s.at[0],g.pos.z-s.at[1])<110)s.seen=true;if(s.guards&&s.cleared&&(g.absoluteHours-s.clearedAt)>g.tuning.postRemanHours){s.cleared=false;g.actors?.remann(s);}}}}\n paint(){const attr=this.terrain.land.mesh.geometry.getAttribute('\"'color');if(this.changed.has(-1)){attr.array.set(this.terrain.baseColors);this.changed.delete(-1);for(const i of this.fire.scorched)this.changed.add(i);}for(const i of this.changed){const state=this.fire.state[i];if(state<2)continue;const ix=(i%256)*2,iz=((i/256)|0)*2;for(let dz=0;dz<2;dz++)for(let dx=0;dx<2;dx++){const base=((ix+dx)+(iz+dz)*512)*6;const col=new THREE.Color(state===3?PALETTE.green:((i+dx)%3===0?PALETTE.night:PALETTE.ink));for(let k=0;k<6;k++)attr.setXYZ(base+k,col.r,col.g,col.b);}}\n if(this.changed.size){attr.clearUpdateRanges();attr.needsUpdate=true;for(const tree of this.trees)if(\"'!tree.burnt&&this.fire.state[tree.cell]>=2){tree.burnt=true;tree.view.traverse(m=>{if(m.isMesh)m.material=toonMaterial(PALETTE.ink);});}for(const grass of this.grasses.values()){const roots=grass.geometry.getAttribute('\"'aRoot');let altered=false;const zero=new THREE.Matrix4().makeScale(0,0,0);for(let i=0;i<grass.blades;i++){const cell=this.fire.index(roots.getX(i),roots.getY(i));if(cell>=0&&this.fire.state[cell]>=2){grass.setMatrixAt(i,zero);altered=true;}}if(altered)grass.instanceMatrix.needsUpdate=true;}}this.changed.clear();}\n update(dt){const g=this.g,p=g.cam.override?{x:g.cam.override.position[0],z:g.cam.override.position[2]}:g.pos;this.paint();let created=0;const gx=Math.floor(p.x/48),gz=Math.floor(p.z/48);for(let dz=-3;dz<=3;dz++)for(let dx=-3;dx<=3;dx++){const x=(gx+dx)*48+24,z=(gz+dz)*48+24,key=(gx+dx)+','+(gz+dz),d=Math.hypot(x-p.x,z-p.z);if(d>178||Math.abs(x)>620||Math.abs(z)>620)continue;if(\"'!this.grasses.has(key)&&created<3){const grass=new GrassField({area:[48,48],at:[x,0,z],count:6800,height:[.55,1.15],width:.13,base:PALETTE.orange,tip:PALETTE.sand,seed:(gx+dx)*1337+(gz+dz)*841+900000,ground:this.heightAt,mask:(x,z)=>this.fuelAt(x,z)});this.ctx.scene.add(grass);this.grasses.set(key,grass);created++;}}\n for(const [key,grass] of this.grasses){const [x,z]=key.split('\"',').map(Number);const d=Math.hypot(x*48+24-p.x,z*48+24-p.z);grass.visible=d<215;grass.wind.set(g.wind.x*g.wind.speed,g.wind.z*g.wind.speed);grass.update(this.clock);if(d>340){grass.removeFromParent();grass.dispose();this.grasses.delete(key);}}\n let n=0,nearest=null;for(const i of this.fire.active){const [x,z]=this.fire.coords(i);const d=Math.hypot(x-p.x,z-p.z);if(d>230)continue;if(\"'!nearest||d<nearest.d)nearest={x,z,d};for(let k=0;k<3&&n<1800;k++){this.fireSprites.set(n++,{at:[x+(i*(k+3)%19)/4-2,this.heightAt(x,z)+.7+k*.2,z+(i*(k+7)%17)/4-2],size:1.7+(i%5)*.25,frame:((this.clock*10)|0)+i+k&3,flip:(i+k)%2===0});}}\n for(;n<1800;n++)this.fireSprites.put(n,0,-1000,0);if(nearest){this.fireLight.position?.set?.(nearest.x,this.heightAt(nearest.x,nearest.z)+3,nearest.z);this.fireLight.set?.({position:[nearest.x,this.heightAt(nearest.x,nearest.z)+3,nearest.z],intensity:40});this.fireLoop.set({volume:Math.max(0,1-nearest.d/130)*.55,pan:0});if(this.clock%1<dt)this.ctx.particles.burst('\"'smoke',[nearest.x,this.heightAt(nearest.x,nearest.z)+2,nearest.z],{count:3});}else{this.fireLoop.set({volume:0});this.fireLight.set?.({intensity:0});}for(const f of this.flags)f.mesh.sync();for(const w of this.water)w.update(this.clock);this.rain.intensity=g.weather==='storm'?.85:0;this.rain.update(dt,new THREE.Vector3(p.x,this.heightAt(p.x,p.z)+2,p.z));}\n reset(){this.fire.reset();for(const o of this.objects){o.active=true;o.hp=o.explosive?120:100;if(o.view)o.view.visible=true;}for(const s of this.sites){s.cleared=\"'!s.guards;s.seen=false;s.clearedAt=-999;}for(const t of this.trees){t.burnt=false;}for(const gr of this.grasses.values()){gr.removeFromParent();gr.dispose();}this.grasses.clear();}\n}\nEOF\nnode --input-type=module - <<'\"'JS'\nimport {ALL_MODELS,MODELS} from './src/art/models.js';import {checkModel,validateTexture} from './pixel-engine.js';import {flame} from './src/art/textures.js';let n=0;for(const m of ALL_MODELS){const r=checkModel(m,{catalog:MODELS});if(r.problems.length){console.log(m.id,r.problems);n++;}}console.log('Models:',ALL_MODELS.length,'invalid:',n,'texture:',validateTexture(flame).problems);\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > src/world/terrain.js <<'EOF'\nimport {Terrain,createNoise,PALETTE,THREE} from '../../pixel-engine.js';\nimport {SITES} from '../content/sites.js';\nimport {ROADS,RIVER} from '../content/roads.js';\nimport {clamp,lerp,smooth,polyDistance} from '../core/math.js';\nexport function buildTerrain(ctx){\n const noise=createNoise(61407);const base=(x,z)=>40+14*noise.fbm2(x*.0032,z*.0032)+2.5*noise.fbm2(x*.02,z*.02);\n const raw=(x,z)=>{let y=base(x,z);const ridge=Math.hypot((x+130)*.8,z+520);y+=42*(1-smooth(20,280,ridge))*(.65+.35*noise.ridged2(x*.012,z*.012));y+=30*(1-smooth(-635,-510,x))*(smooth(0,70,Math.hypot(x+590,z+430)));const pan=1-smooth(100,170,Math.hypot(x-200,z-470));y=lerp(y,36,pan);const mine=Math.hypot(x-150,z+300);if(mine<80)y-=Math.floor((1-smooth(12,80,mine))*4)*5;return y;};\n const stamps=SITES.map(s=>({...s,y:raw(...s.at)}));const roadSegs=ROADS.flatMap(p=>p.slice(1).map((b,i)=>({a:p[i],b,ya:raw(...p[i]),yb:raw(...b)})));\n const height=(x,z)=>{let y=raw(x,z);const river=polyDistance(x,z,RIVER);if(river.d<24)y-=3.6*(1-smooth(7,24,river.d));for(const s of stamps){const d=Math.hypot(x-s.at[0],z-s.at[1]);if(d<s.r+10)y=lerp(y,s.y,1-smooth(s.r*.7,s.r+10,d));}let near=null;for(const r of roadSegs){const dx=r.b[0]-r.a[0],dz=r.b[1]-r.a[1],t=clamp(((x-r.a[0])*dx+(z-r.a[1])*dz)/(dx*dx+dz*dz),0,1),d=Math.hypot(x-r.a[0]-dx*t,z-r.a[1]-dz*t);if(d<8&&(\"'!near||d<near.d))near={d,y:lerp(r.ya,r.yb,t)};}if(near&&river.d>16)y=lerp(y,near.y,1-smooth(3.6,8,near.d));return y;};\n const land=new Terrain({size:[1280,1280],cells:[512,512],bands:[{below:10000,color:PALETTE.sand}],steep:.62,rock:PALETTE.plum}).generate(height);land.attach(ctx.physics);ctx.scene.add(land.mesh);land.mesh.receiveShadow=true;\n const classify=(x,z)=>{const river=polyDistance(x,z,RIVER).d;if(river<8)return '\"'water';const road=Math.min(...ROADS.map(p=>polyDistance(x,z,p).d));if(road<4.3)return 'road';if(Math.hypot(x-200,z-470)<135)return 'salt';const n=land.normalAt(x,z);if(n.y<.72)return 'rock';if(SITES.some(s=>Math.hypot(x-s.at[0],z-s.at[1])<s.r*.72))return 'dirt';return river<23?'bank':'grass';};\n const colors=land.mesh.geometry.getAttribute('color');const colorSet=Object.fromEntries(Object.entries(PALETTE).map(([k,v])=>[k,new THREE.Color(v)]));\n for(let z=0;z<512;z++)for(let x=0;x<512;x++){const wx=-640+(x+.5)*2.5,wz=-640+(z+.5)*2.5,type=classify(wx,wz),q=noise.fbm2(wx*.11,wz*.11);let c=type==='road'?colorSet.red:type==='salt'?colorSet.mist:type==='rock'?colorSet.plum:type==='water'?colorSet.teal:type==='bank'?colorSet.green:type==='dirt'?colorSet.orange:colorSet.sand;const f=type==='grass'?.72+q*.16:type==='road'?.7+q*.14:.8+q*.15;const i=(x+z*512)*6;for(let k=0;k<6;k++)colors.setXYZ(i+k,c.r*f,c.g*f,c.b*f);}\n colors.needsUpdate=true;const baseColors=new Float32Array(colors.array);\n return {land,baseColors,classify,noise,heightAt:(x,z)=>land.heightAt(x,z)};\n}\nEOF\ncat > src/world/world.js <<'EOF'\nimport {THREE,PALETTE,buildModel,addModelColliders,mergeStaticMeshes,GrassField,SpriteBatch,spriteSheet,WaterSurface,clothGrid,SoftMesh,toonMaterial,Precipitation} from '../../pixel-engine.js';\nimport {MODELS} from '../art/models.js';\nimport {flame} from '../art/textures.js';\nimport {SITES,SITE_BY_ID,CASES,TRIGS,HALTS} from '../content/sites.js';\nimport {RIVER,RAIL} from '../content/roads.js';\nimport {buildTerrain} from './terrain.js';\nimport {FireGrid} from './fire.js';\nimport {polyDistance,dist} from '../core/math.js';\nexport class World {\n constructor(g,ctx){this.g=g;this.ctx=ctx;this.terrain=buildTerrain(ctx);this.heightAt=this.terrain.heightAt;this.sites=SITES.map(s=>({...s,seen:false,cleared:\"'!s.guards,clearedAt:-999}));this.objects=[];this.trees=[];this.grasses=new Map();this.flags=[];this.water=[];this.changed=new Set();this.clock=0;this.seed=ctx.random.fork('\"'world');this.fire=new FireGrid(ctx.random.fork('fire'),g.tuning,this.heightAt,(x,z)=>{const t=this.terrain.classify(x,z);return ['grass','bank'].includes(t)?1:0;});this.fire.onChange=(i,state)=>{this.changed.add(i);if(g.round?.session.isHost&&state>0)g.round.world.push([state===1?'fire':'burnt',i]);};this.build();this.fireSprites=new SpriteBatch(spriteSheet(flame),{capacity:1800});for(let i=0;i<1800;i++)this.fireSprites.spawn([0,-1000,0],{size:2});ctx.scene.add(this.fireSprites);this.fireLight=ctx.lights.request({position:[0,-1000,0],color:0xff7a30,intensity:35,radius:65,flicker:'torch'});this.rain=new Precipitation({kind:'rain',count:1700});this.rain.intensity=0;ctx.scene.add(this.rain);this.fireLoop=ctx.audio.loop('fire-loop',{volume:0});}\n place(id,x,z,yaw=0,{collide=true,palette,scale=1,staticMerge=false}={}){const build=buildModel(id,{catalog:MODELS,palette,seed:this.seed.int(1,99999)});const y=this.heightAt(x,z);build.object.position.set(x,y,z);build.object.rotation.y=yaw;build.object.scale.setScalar(scale);build.object.updateMatrixWorld(true);if(collide&&scale===1)addModelColliders(this.ctx.physics,build,[x,y,z],yaw);build.object.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true;}});if(staticMerge)this.staticObjects.push(build.object);else this.ctx.scene.add(build.object);return build.object;}\n item(id,tag,name,x,z,model,r=2.7,props={}){const view=model?this.place(model,x,z,props.yaw||0,{collide:false}):null;const item={id,tag,name,x,z,y:this.heightAt(x,z),view,r,hp:props.hp??100,active:true,...props};this.objects.push(item);return item;}\n build(){this.staticObjects=[];for(const s of this.sites)this.site(s);\n for(const c of CASES)this.item(c.id,'case','TAKE THE STONES',...c.at,'stone-case',2.7,{value:c.value});\n for(const t of TRIGS)this.item(t.id,'trig','READ THE MARGIN',...t.at,'trig-pillar');\n for(const h of HALTS){this.item('halt-'+h.id,'halt','TAKE THE GOODS LINE',...h.at,'signpost',4,{halt:h.id});}\n for(let i=0;i<410;i++){const x=this.seed.range(-625,625),z=this.seed.range(-625,625);if(this.terrain.cla