?.server){const e=await Engine.headless(game,OPTIONS);window.__PIXEL_ENGINE__=e;window.__PIXEL_READY__=Promise.resolve(e);const timer=setInterval(()=>{if(game.round?.ended){clearInterval(timer);return;}e.step(6,1/60);},100);window.addEventListener('pagehide',()=>clearInterval(timer),{once:true});}\n else if(!navigator.gpu){compatibility('WebGPU is unavailable in this browser.');if(info)hub.fail('This game needs WebGPU');}\n else await Engine.start(game,OPTIONS);\n}catch(e){if(info){hub.fail(String(e.message||e));throw e;}if(/webgpu|adapter|gpu device/i.test(String(e.message||e)))compatibility(String(e.message||e));else throw e;}\nif(info&&!info.server){const answer=e=>{if(game.round?.ended||game.round?.started)return;if(e.code==='Enter')hub.answer('ready');if(e.code==='KeyM')hub.answer('more');};window.addEventListener('keydown',answer);window.addEventListener('pagehide',()=>window.removeEventListener('keydown',answer),{once:true});}\n13: open(screen){const g=this.g;g.screen=screen;this.focus=0;g.focus=0;this.page=0;this.tabPage=0;this.uiAge=0;g.cam.enabled=false;if(['pause','dead'].includes(screen))g.ctx.engine.timeScale=0;else if(!['settings','sound','controls','picture','comfort','about','ledger','dev'].includes(screen))g.ctx.engine.timeScale=1;if(typeof document!=='undefined'&&document.pointerLockElement)document.exitPointerLock();}\n62: const p=i.pointer,x=(p.x+1)/2*g.ctx.hud.width,y=(1-p.y)/2*g.ctx.hud.height;const moved=Math.abs(p.x-this.lastPointer.x)+Math.abs(p.y-this.lastPointer.y)>.001;this.lastPointer={x:p.x,y:p.y};if(moved&&p.over){const r=this.rects.find(r=>x>=r.x&&x<=r.x+r.w&&y>=r.y&&y<r.y+r.h);if(r)this.focus=r.i;}\n","exit_code":0,"status":"completed"}}
