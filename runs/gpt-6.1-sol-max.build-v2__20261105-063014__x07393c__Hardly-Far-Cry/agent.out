468,-397],[-17,-388],[318,474],[-129,-488]].map((at,i)=>({id:'trig-'+i,at}));\nexport const HALTS=[{id:'west-cutting',name:'WEST CUTTING',at:[-405,97]},{id:'mile-forty',name:'MILE FORTY',at:[0,70]},{id:'east-siding',name:'EAST SIDING',at:[430,-60]},{id:'cut-spur',name:'CUT SPUR',at:[190,-242]}];\nEOF\ncat > src/content/roads.js <<'EOF'\nexport const ROADS=[[[0,40],[90,-80],[40,-170],[280,-210],[150,-300]],[[0,40],[-200,30],[-260,240],[-330,395]],[[-200,30],[-320,-90],[-430,-180],[-260,-300]],[[0,40],[170,90],[250,80],[325,145],[400,280]],[[250,80],[430,-60],[470,-180]],[[400,280],[300,390],[200,470]],[[0,40],[45,172],[120,230],[225,330],[300,390]],[[-260,-300],[-425,-354],[-590,-430]],[[150,-300],[82,-365],[-20,-400],[8,-455],[-130,-520]],[[0,40],[-60,300],[-260,240]]];\nexport const RIVER=[[600,-640],[420,-320],[300,-120],[250,80],[120,230],[-60,300],[-240,380],[-420,430],[-640,470]];\nexport const RAIL=[[-640,110],[0,70],[430,-60],[640,-110]];\nexport const SCARS={A:[[430,-60],[300,-160],[150,-270]],C:[[150,-270],[130,-310],[65,-320]],B:[[65,-320],[-260,-300],[-425,-354],[-570,-420]]};\nEOF\ncat > src/content/weapons.js <<'EOF'\nexport const WEAPONS={\n cane:{name:'CANE KNIFE',slot:'melee',mag:1,reserve:0,rate:1.6,damage:55,range:2.6,wear:0,cost:0,noise:7},\n m38:{name:'SERVICE REVOLVER',slot:'sidearm',mag:6,reserve:36,rate:3,damage:34,range:65,wear:.5,cost:0,noise:90},\n flare:{name:'FLARE PISTOL',slot:'sidearm',mag:1,reserve:8,rate:.6,damage:12,range:85,wear:0,cost:0,noise:60,projectile:true},\n tractor:{name:'TRACTOR RIFLE',slot:'main',mag:30,reserve:150,rate:9,damage:24,range:150,wear:.35,cost:6,noise:120,automatic:true},\n mule:{name:'MULE PUMP GUN',slot:'main',mag:6,reserve:36,rate:1.1,damage:90,range:28,wear:.8,cost:8,noise:120},\n empire:{name:'OLD EMPIRE',slot:'main',mag:5,reserve:30,rate:.8,damage:95,range:360,wear:1,cost:14,noise:150},\n weed:{name:'WEED BURNER',slot:'special',mag:120,reserve:240,rate:12,damage:2.4,range:16,wear:.12,cost:18,noise:55,automatic:true},\n tube:{name:'LONG TUBE',slot:'special',mag:1,reserve:5,rate:.4,damage:180,range:180,wear:2,cost:20,noise:180,projectile:true},\n mg:{name:'MOUNTED MG',slot:'mounted',mag:999,reserve:999,rate:10,damage:20,range:200,wear:0,cost:0,noise:200,automatic:true}\n};\nexport const UPGRADES=[{id:'cleaning',name:'CLEANING KIT',cost:6,description:'SLOWER WEAR. THE RUST STILL WINS.'},{id:'pouch',name:'SYRETTE POUCH',cost:5,description:'FIVE SYRETTES. FIVE SMALL ARGUMENTS.'},{id:'belt',name:'AMMO BELT',cost:5,description:'HALF AS MUCH AMMUNITION AGAIN.'},{id:'vehicle',name:'VEHICLE KIT',cost:6,description:'HALVE THE TIME UNDER THE BONNET.'}];\nexport const makeWeapon=(id,cond=100)=>({id,cond,jammed:false,racks:0,mag:WEAPONS[id].mag,reserve:WEAPONS[id].reserve,shots:0});\nEOF\ncat > src/world/fire.js <<'EOF'\nimport {clamp,polyDistance,rle,unrle} from '../core/math.js';\nimport {SCARS} from '../content/roads.js';\nexport class FireGrid {\n constructor(rng,tuning,height=()=>40,fuelAt=()=>1){this.n=256;this.cell=5;this.rng=rng;this.tuning=tuning;this.height=height;this.fuel=new Uint8Array(65536);this.state=new Uint8Array(65536);this.burnEnd=new Float32Array(65536);this.burntAt=new Float32Array(65536);this.active=new Set();this.scorched=new Set();this.time=0;this.totalBurnt=0;this.clock=0;this.onChange=null;for(let i=0;i<65536;i++){const [x,z]=this.coords(i);this.fuel[i]=fuelAt(x,z);}}\n index(x,z){const ix=Math.floor((x+640)/5),iz=Math.floor((z+640)/5);return ix<0||iz<0||ix>=256||iz>=256?-1:ix+iz*256;}\n coords(i){return [-637.5+(i%256)*5,-637.5+Math.floor(i/256)*5];}\n lightIndex(i){if(i<0||i>=65536||\"'!this.fuel[i]||this.state[i]!==0)return false;this.state[i]=1;this.burnEnd[i]=this.time+this.rng.range(9,14)+(this.fuel[i]>1?6:0);this.active.add(i);this.onChange?.(i,1);return true;}\n ignite(x,z,radius=3){let n=0;for(let zz=z-radius;zz<=z+radius;zz+=2.5)for(let xx=x-radius;xx<=x+radius;xx+=2.5)if(Math.hypot(xx-x,zz-z)<=radius)n+=this.lightIndex(this.index(xx,zz))?1:0;return n;}\n markBurnt(i){if(i<0||this.state[i]===2)return;this.active.delete(i);this.state[i]=2;this.scorched.add(i);this.burntAt[i]=this.time;this.totalBurnt++;this.onChange?.(i,2);}\n tick(dt,wind={x:1,z:0,speed:5},rain=false,gameHours=0){this.time+=dt;this.clock+=dt;if(this.clock<.25)return;this.clock-=.25;const newly=[];for(const i of this.active){if(this.time>=this.burnEnd[i]){this.markBurnt(i);continue;}const [x,z]=this.coords(i),ix=i%256,iz=(i/256)|0;for(let dz=-1;dz<=1;dz++)for(let dx=-1;dx<=1;dx++){if(!dx&&!dz||ix+dx<0||ix+dx>255||iz+dz<0||iz+dz>255)continue;const j=i+dx+dz*256;if(this.state[j]||!this.fuel[j])continue;const len=Math.hypot(dx,dz),w=clamp(1+this.tuning.windEffect*wind.speed/5*1.6*(dx*wind.x+dz*wind.z)/len,.15,3.5),s=this.height(x+dx*5,z+dz*5)>this.height(x,z)+.1?1.4:.7;const p=.02*[0,1,.8,.6,.4][this.fuel[j]]*w*s*(rain?.15:1)*this.tuning.fireSpread/len;if(this.rng.chance(p))newly.push(j);}if(wind.speed>6&&this.rng.chance(.012*this.tuning.fireSpread)){const jump=this.rng.int(2,3);newly.push(this.index(x+wind.x*jump*5,z+wind.z*jump*5));}}\n for(const i of newly)this.lightIndex(i);if(this.time%3<.25)for(const i of this.scorched){if(this.state[i]===2&&(this.time-this.burntAt[i])*24/(this.tuning.dayMinutes*60)>=this.tuning.regrowHours){this.state[i]=3;this.onChange?.(i,3);}}}\n burnStrip(id,width=20){for(let i=0;i<65536;i++){const [x,z]=this.coords(i);if(this.fuel[i]&&polyDistance(x,z,SCARS[id]).d<width/2)this.markBurnt(i);}}\n extinguish(){for(const i of this.active)this.markBurnt(i);}\n regrow(){for(const i of this.scorched){this.state[i]=3;this.onChange?.(i,3);}}\n reset(){this.active.clear();this.scorched.clear();this.state.fill(0);this.burnEnd.fill(0);this.burntAt.fill(0);this.totalBurnt=0;this.time=0;this.clock=0;this.onChange?.(-1,0);}\n save(){return {state:rle(this.state),time:this.time,active:[...this.active].map(i=>[i,this.burnEnd[i]]),scorched:[...this.scorched].map(i=>[i,this.burntAt[i]]),total:this.totalBurnt,rng:this.rng.state};}\n load(s){unrle(s.state,this.state);this.time=s.time;this.totalBurnt=s.total;this.active=new Set();this.scorched=new Set();for(const [i,t] of s.active){this.active.add(i);this.burnEnd[i]=t;}for(const [i,t] of s.scorched){this.scorched.add(i);this.burntAt[i]=t;}this.rng.state=s.rng;this.onChange?.(-1,0);}\n counts(){return {burning:this.active.size,burnt:this.totalBurnt,regrowing:[...this.scorched].filter(i=>this.state[i]===3).length};}\n}\nEOF\nnode --input-type=module - <<'\"'JS'\nimport {Rng} from './pixel-engine.js';import {FireGrid} from './src/world/fire.js';import {makeTuning} from './src/content/tuning-defaults.js';\nconst f=new FireGrid(new Rng(1337),makeTuning());f.ignite(-100,0,12);for(let i=0;i<240;i++)f.tick(.25,{x:1,z:0,speed:5});const cells=[...f.scorched,...f.active].map(i=>f.coords(i));console.log('Fire trial:',f.counts(),(Math.max(...cells.map(p=>p[0]))+87.5)/60);\nJS\"","aggregated_output":"Fire trial: { burning: 309, burnt: 724, regrowing: 0 } 2.9166666666666665\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"agent_message","text":"All four hub scenarios pass, including packet loss, host departure, and a server without a player. The first fire simulation also lands within the required spread-speed range. I’m now building the red-grass basin and the first-person art."}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > src/art/models.js <<'EOF'\nimport {model,ModelCatalog,MODEL_LIBRARY} from '../../pixel-engine.js';\nconst box=(size,at,c,more={})=>({box:size,at,c,...more});\nconst limb=(name,len,w,c,kids=[],at=[0,0,0])=>({group:[box([w,len,w],[0,-len/2,0],c),...kids],at,pivot:true,name});\nconst foot=name=>({group:[box([.12,.1,.26],[0,-.05,.05],'boot')],at:[0,-.22,0],pivot:true,name});\nexport function person(id,cloth='slate',hat='navy',extra=[]){return model({id,about:'Articulated '+id+' with original clothes and silhouette',tags:['person','rigged'],floats:true,collider:'none',palette:{cloth,dark:'night',skin:'plum',boot:'ink',hat,strap:'sand',eye:'white'},parts:[{group:[box([.34,.2,.2],[0,.06,0],'dark'),{group:[box([.38,.5,.22],[0,.25,0],'cloth'),box([.06,.56,.24],[.1,.25,0],'strap',{rot:[0,0,28]}),{group:[box([.2,.22,.2],[0,.11,0],'skin'),box([.24,.07,.24],[.01,.25,0],'hat',{rot:[0,0,-8]}),box([.16,.03,.025],[0,.14,.108],'eye'),...extra],at:[0,.52,0],pivot:true,name:'Head'},limb('ArmR',.25,.11,'cloth',[limb('ForearmR',.16,.09,'cloth',[limb('HandR',.08,.08,'skin',[],[0,-.16,0])],[0,-.25,0])],[-.25,.47,0]),limb('ArmL',.25,.11,'cloth',[limb('ForearmL',.16,.09,'cloth',[limb('HandL',.08,.08,'skin',[],[0,-.16,0])],[0,-.25,0])],[.25,.47,0])],at:[0,.04,0],pivot:true,name:'Torso'},limb('LegR',.3,.13,'dark',[limb('ShinR',.22,.11,'dark',[foot('FootR')],[0,-.3,0])],[-.14,0,0]),limb('LegL',.3,.13,'dark',[limb('ShinL',.22,.11,'dark',[foot('FootL')],[0,-.3,0])],[.14,0,0])],at:[0,.62,0],pivot:true,name:'Pelvis'}]});}\nexport const soldier=person('soldier');\nexport const harvest=person('harvest','orange','red',[box([.16,.11,.08],[0,.08,-.12],'hat')]);\nexport const ines=person('ines','sand','plum',[box([.26,.055,.1],[0,.15,.12],'boot'),box([.08,.22,.2],[-.13,.12,0],'hat')]);\nexport const dov=person('dov','slate','plum',[box([.17,.05,.17],[0,.29,0],'skin')]);\nexport const mags=person('mags','green','night',[box([.055,.28,.065],[-.11,.06,-.06],'hat'),box([.055,.28,.065],[.11,.06,-.06],'hat')]);\nexport const odile=person('odile','white','white',[box([.27,.3,.11],[0,.13,-.08],'hat'),box([.075,.035,.035],[.09,.035,.13],'strap')]);\nexport const tibor=person('tibor','red','sand');\nexport const vance=person('vance','slate','navy',[box([.28,.04,.27],[0,.23,.035],'boot')]);\nexport const ansa=person('ansa','orange','red',[box([.26,.24,.22],[0,.14,-.08],'hat')]);\nexport const harrow=person('harrow','plum','sand',[box([.42,.04,.38],[0,.25,0],'hat')]);\nexport const bakr=person('bakr','navy','slate');\nexport const civilian=person('civilian','sand','red');\nexport const acacia=model({id:'acacia',about:'Flat umbrella acacia, forked trunk and weathered canopy',tags:['tree','savanna'],collider:'none',palette:{bark:'plum',leaf:'green',lit:'teal'},parts:[{cyl:[.64,4.8,.64],at:[0,2.4,0],top:.55,c:'bark',seg:6},{tube:[[0,3.1,0],[-2.1,5.2,.2]],r:[.22,.1],c:'bark'},{tube:[[0,3.6,0],[1.8,5.4,-.5]],r:[.2,.09],c:'bark'},{lump:[8.2,1.6,5.6],at:[-.7,5.8,.1],c:'leaf',seed:2},{lump:[5.2,1.5,5.4],at:[2,6.15,-.4],c:'lit',seed:8}]});\nexport const bottleTree=model({id:'bottle-tree',about:'Fat bottle tree with sparse high crown',tags:['tree','savanna'],collider:'none',palette:{bark:'plum',leaf:'green'},parts:[{lathe:[[0,0],[.9,0],[1.5,1.3],[1.3,3],[.4,6],[.2,7]],c:'bark',seg:7},{tube:[[0,5,0],[-2,7.8,0]],r:[.3,.12],c:'bark'},{lump:[4,1.3,3.8],at:[-1.5,7.8,0],seed:4,c:'leaf'}]});\nexport const shack=model({id:'shack',about:'Open tin roof shack with a walkable doorway',tags:['building','tin'],collider:'parts',palette:{wall:'sand',tin:'slate',beam:'plum',step:'red'},parts:[box([7,.22,5],[0,.11,0],'step'),box([7,3,.22],[0,1.7,-2.4],'wall'),box([.22,3,5],[-3.4,1.7,0],'wall'),box([.22,3,5],[3.4,1.7,0],'wall'),box([2.4,3,.22],[-2.3,1.7,2.4],'wall'),box([2.4,3,.22],[2.3,1.7,2.4],'wall'),box([2.3,.5,.22],[0,2.95,2.4],'beam'),box([7.6,.16,3.2],[0,3.48,-1.25],'tin',{rot:[-10,0,0]}),box([7.6,.16,3.2],[0,3.48,1.25],'tin',{rot:[10,0,0]}),...[-2.5,-1.2,0,1.2,2.5].map(x=>box([.1,.12,6.3],[x,3.7,0],'beam'))]});\nexport const bunker=model({id:'bunker',about:'Concrete bunker with low roof and open doorway',tags:['building','military'],collider:'parts',palette:{wall:'mist',roof:'slate'},parts:[box([6,3,.7],[0,1.5,-2.5],'wall'),box([.7,3,5],[-2.7,1.5,0],'wall'),box([.7,3,5],[2.7,1.5,0],'wall'),box([6,.6,6],[0,3.1,0],'roof'),box([1.8,2.7,.5],[-2,1.35,2.5],'wall'),box([1.8,2.7,.5],[2,1.35,2.5],'wall')]});\nexport const tower=model({id:'watchtower',about:'Timber watchtower with roof and sandbagged platform',tags:['building','military'],collider:'parts',palette:{wood:'plum',tin:'slate',bag:'sand'},parts:[...[-1.6,1.6].flatMap(x=>[-1.6,1.6].map(z=>box([.25,7,.25],[x,3.5,z],'wood'))),box([4,.3,4],[0,6,0],'wood'),box([4,.65,.5],[0,6.48,1.8],'bag'),box([4,.65,.5],[0,6.48,-1.8],'bag'),box([4.7,.15,4.7],[0,8,0],'tin')]});\nexport const sandbags=model({id:'sandbag-run',about:'Staggered row of cover sandbags',tags:['military','cover'],collider:'parts',palette:{bag:'sand',shadow:'orange'},parts:[...Array.from({length:6},(_,i)=>box([.95,.4,.65],[(i-2.5)*.92,.2,0],i%2?'bag':'shadow')),...Array.from({length:5},(_,i)=>box([.95,.4,.65],[(i-2)*.92,.58,0],i%2?'shadow':'bag'))]});\nexport const gate=model({id:'boom-gate',about:'Raised checkpoint barrier with striped arm',tags:['military','road'],collider:'none',palette:{post:'slate',bar:'white',red:'red'},parts:[box([.5,1.6,.5],[-3,.8,0],'post'),box([6,.18,.18],[0,1.3,0],'bar'),...[-2,-1,0,1,2].map(x=>box([.32,.2,.2],[x,1.3,0],'red'))]});\nexport const fuelTank=model({id:'fuel-tank',about:'Horizontal fuel tank on concrete saddles',tags:['fuel','explosive'],collider:'parts',palette:{metal:'red',band:'slate',feet:'mist'},parts:[{cyl:[2.8,7,2.8],at:[0,2,0],rot:[0,0,90],c:'metal',seg:10},...[-2,2].map(x=>box([.6,1.5,2.7],[x,.75,0],'feet')),{cyl:[.4,.5,.4],at:[0,3.6,0],c:'band'},box([.4,2.9,2.9],[0,2,0],'band')]});\nexport const silo