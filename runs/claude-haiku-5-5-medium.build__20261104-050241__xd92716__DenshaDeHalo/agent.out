oking back as it passes */\nDH.camFor = (sim, view, S) => {\n  const T = sim.train;\n  if (view === 'cab') return { s: T.s - 1.5, x: 0, h: 2.9 + ((S && S.camBump) || 0), dir: 1, fov: DH.TUNING.fov, horizon: .40, pitchPx: -Math.round(T.a * 1.5) };\n  if (view === 'chase') return { s: T.s - 25, x: 2, h: 9, dir: 1, fov: 70, horizon: .50 };\n  if (view === 'trackside') return { s: T.s + 180, x: -4, h: 2, dir: -1, fov: 75, horizon: .50 };\n  const st = sim.stops.find(x => x.target >= T.s - 40) || sim.stops[sim.stops.length - 1];\n  return { s: st ? st.target + 15 : T.s, x: -5, h: 1.7, dir: -1, fov: 75, horizon: .50 };\n};\"\"\")\nrep(\"\"\"      let cam;\n      if (view === 'cab') cam = { s: T.s - 1.5, x: 0, h: 2.9 + (S.camBump || 0), dir: 1, fov: DH.TUNING.fov, horizon: .40, pitchPx: -Math.round(T.a * 1.5) };\n      else if (view === 'chase') cam = { s: T.s - 25, x: 2, h: 9, dir: 1, fov: 70, horizon: .50 };\n      else {\n        const st = sim.stops.find(x => x.target >= T.s - 40) || sim.stops[sim.stops.length - 1];\n        const at = st ? st.target + 15 : T.s;\n        cam = { s: at, x: -5, h: 1.7, dir: -1, fov: 75, horizon: .50 };\n      }\"\"\",\"      const cam = DH.camFor(sim, view, S);\")\nrep(\"        if (view === 'cab') DH.drawCab\",\"        if (view === 'cab') DH.drawCab\")\ns=s.replace(\"rows.push({ label: 'Camera', value: () => (cur() ? ['cab', 'chase', 'platform'][cur().view] : '-'), act: () => { if (cur()) cur().view = (cur().view + 1) % 3; } });\",\n\"rows.push({ label: 'Camera', value: () => (cur() ? VIEWS[cur().view] : '-'), act: () => { if (cur()) cur().view = (cur().view + 1) % VIEWS.length; } });\")\nopen(p,'w').write(s); print('ok')\nEOF\ngrep -n \"% 3\" src/61-drive.js | cut -c1-120; node -e \"new (require('vm').Script)(require('fs').readFileSync('src/61-drive.js','utf8'))\" && echo OK","description":"Move camera choice into a shared helper and add trackside view"}},"wire_ingest_context":{"toolu_01SdYX6JcmAdbAcDot1Y2L9W":{"cwd":"/home/micha/dev/