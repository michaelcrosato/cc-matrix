ar < c.s + 1;\n      let g = this.crossingGates[c.id] || { state: 'up', t: 0 };\n      if (g.state === 'up' && d > -20 && (d < 500 || (d / Math.max(T.v / 3.6, 1) < 25 && T.v > 1))) { g.state = 'down'; g.t = 0; this.bus.emit('gates', { id: c.id, down: true }); }\n      if (g.state === 'down') { if (T.rear > c.s + 12 || (d > 1500)) { g.state = 'up'; this.bus.emit('gates', { id: c.id, down: false }); } }\n      if (c.special && this.obstruction === null && this.stage.obstruction && this.stage.obstruction.id === c.id && d < 350 && d > -20) {\n        this.obstruction = { id: c.id, active: true, since: this.t, cleared: false };\n        this.bus.emit('obstruction', { id: c.id, on: true });\n        this.fire('obstruction');\n      }\n      g.onIt = onIt;\n      this.crossingGates[c.id] = g;\n    }\n    const ob = this.obstruction;\n    if (ob && ob.active) {\n      const c = this.route.crossings.find(x => x.id === ob.id), T = this.train;\n      if (c && T.s > c.s - 2 && T.rear < c.s + 2 && !ob.passed) {\n        // into the blocked crossing: an emergency stop too late\n        ob.passed = true; this.addTime(-3 * this.D.pen, 'HAZARD'); this.addScore(-200); this.bus.emit('hazard');\n        T.emergency(); this.onEmergency();\n      }\n      if (T.v === 0 && c && T.s < c.s - 3 && !ob.counted) {\n        ob.counted = true; ob.stoppedAt = this.t;\n        this.addTime(5, 'HAZARD AVOIDED'); this.addScore(800); this.stats.hazard = (this.stats.hazard || 0) + 1;\n        this.judgments.push({ label: 'HAZARD AVOIDED', t: this.t, halo: 5, pts: 800 });\n        this.setSubtitle('Mika', 'The crossing alarm! Something is on the tracks!');\n      }\n      if (ob.stoppedAt !== undefined && this.t - ob.stoppedAt > 12) { ob.active = false; this.bus.emit('obstruction', { id: ob.id, on: false }); }\n    }\n  }\n  updateObstruction(dt) { void dt; }\n\n  // ---- the horn (section 4.7) ----\n  setHorn(on) {\n    const H = this.horn;\n    if (on && !H.held) { H.held = true; H.tHeld = 0; this.bus.emit('horn', { on: true }); }\n    if (!on && H.held) { H.held = false; this.bus.emit('horn', { on: false }); }\n  }\n  updateHorn(dt) {\n    const H = this.horn, T = this.train;\n    if (H.held) H.tHeld += dt;\n    for (const h of this.route.horns) {\n      const inZone = T.s >= h.s && T.s < h.s + h.zone;\n      const key = 'horn' + h.s;\n      if (inZone && H.held && H.tHeld >= 0.5 && !H.sounded.has(key)) {\n        H.sounded.add(key); this.stats.horn++;\n        this.addTime(1, 'HORN +1'); this.addScore(100); this.judgments.push({ label: 'HORN +1', t: this.t, halo: 1, pts: 100 });\n        this.bus.emit('hornOK', { s: h.s });\n      }\n      if (!inZone && T.s >= h.s + h.zone && !H.sounded.has(key) && !H.missed?.has?.(key)) {\n        H.missed = H.missed || new Set(); H.missed.add(key);\n        if (this.difficulty !== 'easy') this.addTime(-1 * this.D.pen, 'NO HORN');\n      }\n    }\n    if (H.held && this.horn.lastHeld) void 0;\n    this.horn.lastHeld = H.held;\n    // the workers wave when they hear the horn\n    for (const w of this.route.workers || []) {\n      if (H.held && T.s > w.s - 300 && T.s < w.until) this.bus.emit('workersHeard', { s: w.s });\n    }\n  }\n\n  // ---- the calls (section 4.7) ----\n  openCall(kind) { this.callOpen = { kind, opened: this.t, made: false, early: false }; this.bus.emit('callOpen', { kind }); }\n  call() {\n    const T = this.train;\n    // departure call: its own window\n    if (this.callOpen && this.callOpen.kind === 'departure') {\n      const c = this.callOpen; c.made = true; this.callOpen = null;\n      const great = !!c.early || !this.firstPowerDone;\n      this.scoreCall(great, 'departure');\n      return { kind: 'departure', great };\n    }\n    // the nearest open point ahead: 30 to 180 m; GREAT between 60 and the sweet spot's far edge\n    let best = null, bd = 1e9;\n    for (const c of this.calls) {\n      if (c.called) continue;\n      const d = c.s - T.s;\n      if (d > 30 && d <= 180 && d < bd) {\n        if