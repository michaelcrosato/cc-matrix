\"      if (data.attract || data.auto) S.auto = new DH.Auto(sim, { skill: data.skill || 1 });\",\n    \"      if (data.attract || data.auto) { S.auto = new DH.Auto(sim, { skill: data.skill || 1 }); S.keepAuto = true; }\")\n# S0 lessons: Hoshino speaks each step once\nrep(\"      // the sound follows the train\",\n    \"      if (S.st.tutorial) { const L = DH.lessonStep(S); if (L && S.lessonSpoken !== S.lessonIdx) { S.lessonSpoken = S.lessonIdx; S.speak('Hoshino', L); } }\\n      // the sound follows the train\")\n# overlays: the Stop Cam and the debug overlay\nrep(\"        if (glove) DH.drawGlove(g, Math.round(r.W * .5), Math.round(r.H * .45), glove.t);\",\n    \"        if (glove) DH.drawGlove(g, Math.round(r.W * .5), Math.round(r.H * .45), glove.t);\\n        if (S.stopCam && game.time - S.stopCam.t0 < 2.5) DH.drawStopCam(g, r, S, game.time - S.stopCam.t0);\\n        if (DH.devDebug) DH.drawDebug(g, sim);\")\n# postcards on finish\nrep(\"  DH.Progress.save(p);\\n  const order\",\n    \"  const got = DH.unlockPostcards(p, sim);\\n  DH.Progress.save(p);\\n  const order\")\nrep(\"  const data = { stage: st.id, rank,\",\n    \"  if (got.length) rows.push(['POSTCARD', got.map(c => c.title).join(', ')]);\\n  const data = { stage: st.id, rank,\")\nopen(p,'w').write(s)\nprint('drive patched')\nEOF\nnode -e \"new (require('vm').Script)(require('fs').readFileSync('src/61-drive.js','utf8'))\" && echo SYNTAX_OK","description":"Patch drive for lever keys, auto, lessons, stop cam and postcards"}},"wire_ingest_context":{"toolu_01JPFyqzAQbNKj2zYsz3xZe7":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241"}}}
