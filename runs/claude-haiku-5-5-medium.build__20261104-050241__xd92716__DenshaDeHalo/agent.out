{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghsHSVC6xWfVRgW7Xitt","type":"message","role":"assistant","content":[{"type":"text","text":"All the physics check values pass, matching the plan's own figures (30.4 s, 39.2 s/439 m, 181 m, 8.2 km/h, 232 m). Next is the simulation core: signals and ATS, speed limits, stops and judgments, dwell, Halo Time, score, calls, horn, events and the other trains. It's the largest piece, so I'll write it as one module."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":504,"cache_read_input_tokens":240598,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":504},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"5e560a78-3736-498b-aaf7-ca3890398044","timestamp":"2026-11-04T12:13:47.401Z","request_id":"req_011CghsHS9bcH76aXAFfUcDn"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghsHSVC6xWfVRgW7Xitt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PGPiGQLrGwipMHgfws35ef","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/31-sim.js","content":"/* Densha de Halo! · 31-sim: the world of a stage, stepped at 1/120 s. Pure: no drawing, no sound, no engine.\n * It owns the train (30-train), the signals and blocks, the other trains, the limits, ATS, the stops, the dwell and the\n * departure sequence, the timetable and the clock, Halo Time, the score and comfort, the calls and the horn, and the events.\n * The scenes read it through snapshot() and send it commands through cmd(). Rules: section 4.4 to 4.11. */\n(() => {\n'use strict';\nconst DH = window.DH;\n\nconst DIFF = {\n  easy: { name: 'Easy', grace: 40 / 25, win: 1.5, pen: 0.5, guide: true, calls: 'auto?' },\n  normal: { name: 'Normal', grace: 1, win: 1.0, pen: 1.0 },\n  expert: { name: 'Expert', grace: 15 / 25, win: 0.7, pen: 1.5 }\n};\nDH.DIFF = DIFF;\nconst ASPECT_SPEED = { G: null, YG: 65, Y: 45, YY: 25, R: 0 };   // G means the line speed\nDH.ASPECT_SPEED = ASPECT_SPEED;\n\n/* the aspect a 4-lamp head shows from the clear blocks ahead (section 4.4): 0 -> R, 1 -> Y, 2 -> YG, 3+ -> G */\nconst LAMPS = { R: [0, 0, 1, 0], Y: [1, 0, 0, 0], YG: [1, 1, 0, 0], G: [0, 1, 0, 0], YY: [1, 0, 0, 1] };\nDH.LAMPS = LAMPS;\n\n/* a train that is not the player's: an oncoming train, a freight, a rival. Its legs are a script; it moves at a set speed\n * (its own lag-free model; it never affects the player's train except by occupying blocks on its own lane) */\nclass TrainActor {\n  constructor(o) {\n    Object.assign(this, { id: o.id, kind: o.kind || 'other', spec: DH.TRAINS[o.train || 'freight'], lane: o.lane || 'B', dir: o.dir || 1,\n      s: o.s, v: o.v || 0, cars: o.cars || 4, legs: (o.legs || []).slice(), leg: 0, wait: 0, livery: o.livery || null, clockAt: o.clockAt || null, done: false, log: [] });\n    this.cars = this.cars || (this.spec ? this.spec.cars : 4);\n    this.nose = o.nose || '#ffffff';\n  }\n  get length() { return this.cars * 20; }\n  get rear() { return this.dir > 0 ? this.s - this.length : this.s + this.length; }\n  /** the segment spans the train covers: [lo, hi] in route metres */\n  span() { return this.dir > 0 ? [this.rear, this.s] : [this.s, this.rear]; }\n  step(dt, world) {\n    if (this.done) return;\n    if (this.clockAt !== null && world.clock() < this.clockAt) return;\n    if (this.leg >= this.legs.length) { this.v = Math.max(0, this.v - 5 * dt); this.s += this.dir * this.v / 3.6 * dt; this.done = this.v === 0 && !this.legs.length; return; }\n    const L = this.legs[this.leg];\n    if (L.lane) this.lane = L.lane;\n    if (this.wait > 0) { this.wait -= dt; this.v = 0; if (this.wait <= 0) this.leg++; return; }\n    const target = L.v, acc = L.acc || 4;   // km/h/s\n    this.v += DH.clamp(target - this.v, -acc * dt, acc * dt);\n    if (L.stopAt !== undefined) {\n      const remain = (L.stopAt - this.s) * this.dir;   // metres to the stop, along the direction of travel\n      if (remain <= 0.02 || (this.v > 0 && remain < this.v / 3.6 * this.v / 3.6 / (2 * acc / 3.6) + 0.02 && L.v === 0)) {\n        this.v = 0; this.s = L.stopAt; this.wait = L.dwell || 0.05; if (!L.dwell) this.leg++;\n        return;\n      }\n    }\n    this.s += this.dir * this.v / 3.6 * dt;\n    if (L.until !== undefined && (this.s - L.until) * this.dir >= 0) this.leg++;\n  }\n}\nDH.TrainActor = TrainActor;\n\n/* the sim: built from a stage and a route */\nclass Sim {\n  constructor(stage, route, opts = {}) {\n    this.stage = stage; this.route = route; this.opts = opts;\n    this.difficulty = opts.difficulty || 'normal'; this.D = DIFF[this.difficulty];\n    this.t = 0;                     // stage time (s), paused with the game\n    this.events = new Set(); this.fired = [];\n    this.bus = new DH.Bus();\n    this.score = 0; this.comfort = 100; this.comfortRecover = 0;\n    this.halo = 0; this.haloStart = 0; this.haloMax = 99;\n    this.log = [];                   // judgments and penalties, for the results and the story\n    this.toasts = []; this.judgments = []; this.subtitles = [];\n    this.stats = { stops: 0, perfect: 0, great: 0, good: 0, ok: 0, onTime: 0, late: 0, early: 0, smooth: 0, calls: 0, callsGreat: 0, horn: 0, overruns: 0, slips: 0, ats: 0, spad: 0, limit: 0, ebs: 0, km: 0 };\n    this.maxPoints = 0; this.maxStat = { stops: 0, onTime: 0, smooth: 0, calls: 0, horn: 0, hazard: 0 };\n    this.gameOver = false; this.finished = false; this.results = null;\n    this.lastCall = null; this.callOpen = null;\n    this.sighted = new Set(); this.atsLatched = new Set(); this.spadLatched = new Set(); this.limitArmed = new Map();\n    this.station = null; this.stopIdx = 0; this.phase = 'run';\n    this.dwell = null; this.departed = false;\n    this.readySignals = new Set(); this.signalPassed = new Set();\n    this.weather = stage.weather || 'clear'; this.fogDist = 900; this.hour = stage.hour || 12;\n    this.lineLimit = null; this.aspectCap = null; this.lastAspect = 'G';\n    this.horn = { held: false, zoneFrom: null, sounded: new Set(), tHeld: 0 };\n    this.atsRinging = false; this.atsConfirmTimer = 0; this.atsOn = false; this.speedAlarm = false;\n    this.backup = null; this.obstruction = null; this.rollbackWarn = 0;\n    this.checkpoint = null;\n    this.halted = false;\n    this.spec = DH.TRAINS[stage.train || 'h8000'];\n    this.train = new DH.Train(this.spec, { s: opts.s0 !== undefined ? opts.s0 : (stage.startS || 0) });\n    this.train.dir = 1;\n    this.train.cars = stage.cars || 6;\n    this.dryRail = this.weather !== 'rain';\n    this.others = [];\n    this.setup();\n  }\n\n  // ---- setup ----\n  setup() {\n    const st = this.stage, R = this.route;\n    this.clockOffset = DH.parseClock(st.startClock || '06:40:00');\n    // the stops of the stage, in route order: each stop is a station with its timetable\n    this.stops = (st.stops || []).map(x => Object.assign({}, x, { st: R.stationById(x.id), target: 0 }));\n    for (const x of this.stops) {\n      const cars = this.train.cars;\n      const target = R.stopOf(x.id, cars) !== undefined ? R.stopOf(x.id, cars) : (x.st && x.st.stops ? Object.values(x.st.stops)[0] : 0);\n      x.target = target; x.arrS = target;\n      x.arrival = x.arr ? DH.parseClock(x.arr) : null; x.departure = x.dep ? DH.parseClock(x.dep) : null;\n      x.judged = false; x.attempts = 0; x.restops = 0; x.done = false; x.missed = false;\n      x.start = x.st ? x.st.start : x.target;\n      x.startSig = null;\n      // its departure signal: the first start signal in the 400 m past its platform\n      if (x.st) x.startSig = R.signals.find(g => g.kind === 'start' && g.s >= x.st.end - 5 && g.s <= x.st.end + 420) || null;\n    }\n    this.passes = (st.passes || []).map(p => Object.assign({}, p, { at: R.stationById(p.id) ? R.stationById(p.id).start : p.at }));\n    this.endS = st.endS !== undefined ? st.endS : (this.stops.length ? this.stops[this.stops.length - 1].target : this.train.s);\n    // the blocks and signals, ordered\n    this.signals = R.signals.slice().sort((a, b) => a.s - b.s);\n    for (const g of this.signals) g.aspect = 'R';\n    // the other trains from the stage's list\n    for (const o of (st.trains || [])) this.others.push(new TrainActor(o));\n    this.limits = R.limits.slice();\n    this.calls = [];\n    this.buildCalls();\n    // the initial state of the station the train starts at: doors open, the dwell's clock running from the stage start\n    if (st.startDwell) this.startDwell(st.startDwell);\n    this.train.v = 0;\n    this.applyWeather();\n    this.recordCheckpoint('start');\n  }\n  applyWeather() {\n    const w = this.weather;\n    this.dryRail = w !== 'rain';\n    this.fogDist = w === 'fog' ? 180 : 900;\n    if (this.stage.fogDist) this.fogDist = this.stage.fogDist;\n  }\n  buildCalls() {\n    const R = this.route, add = (o) => this.calls.push(Object.assign({ called: false, grade: null, key: o.id + '@' + o.s }, o));\n    for (const g of this.signals) {\n      if (g.kind === 'shunt' || g.kind === 'block' || g.kind === 'home' || g.kind === 'start') add({ s: g.s, id: g.id, kind: 'signal', sig: g.id });\n    }\n    for (const L of this.limits) add({ s: L.s, id: 'lim' + L.s, kind: 'limit', v: L.v });\n    for (const h of R.horns) add({ s: h.s, id: 'horn' + h.s, kind: 'horn' });\n    for (const x of this.stops) if (x.st) add({ s: x.st.start - 400, id: 'app' + x.id, kind: 'approach', stopId: x.id });\n    for (const c of R.crossings) if (c.special === false) add({ s: c.s, id: 'cross' + c.id, kind: 'crossing', optional: true });\n    for (const w of R.workers || []) add({ s: w.s, id: 'work' + w.s, kind: 'workers' });\n  }\n\n  // ---- the clock and time ----\n  clock() { return this.clockOffset + this.t; }\n  now() { return this.clock(); }\n\n  // ---- commands (from the controller, the keyboard, the autopilot) ----\n  cmd(name, val) {\n    const T = this.train, out = {};\n    switch (name) {\n      case 'power':\n        if (this.halted) break;\n        if (!this.pilotLit() && !T.eb && T.notch >= 0) { if (T.v === 0 && this.phase !== 'run') { this.bus.emit('buzz', 'doors'); } }\n        if (!this.pilotLit() && T.notch >= 0 && T.v === 0 && !T.eb) { this.note('doors'); T.notch = Math.min(T.notch + 1, T.spec.notchesP); break; }\n        if (T.power()) { this.bus.emit('notch', { name: T.notchName, dir: 1 }); if (!this.firstPowerDone) this.onFirstPower(); }\n        break;\n      case 'brake': if (T.brake()) this.bus.emit('notch', { name: T.notchName, dir: -1 }); break;\n      case 'neutral': if (!T.eb) { T.neutral(); this.bus.emit('notch', { name: 'N', dir: 0 }); } break;\n      case 'eb': if (!T.eb) { T.emergency(); this.onEmergency(); } break;\n      case 'ebRelease': break;\n      case 'ats': this.confirmATS(); break;\n      case 'horn': this.setHorn(!!val); break;\n      case 'call': return this.call();\n      case 'backup': break;\n      default: break;\n    }\n    return out;\n  }\n  note(kind) { this.bus.emit('note', kind); }\n  onFirstPower() { this.firstPowerDone = true; if (this.callOpen && this.callOpen.kind === 'departure' && !this.callOpen.made) this.callOpen.early = true; }\n  onEmergency() {\n    if (this.dwell || this.phase !== 'run') return;\n    this.stats.ebs++;\n    if (!this.hazardOpen()) { this.addTime(-3 * this.D.pen, 'EMERGENCY'); this.addScore(-200); }\n    this.bus.emit('eb');\n  }\n\n  // ---- the stop and dwell phase machine ----\n  get pilot() { return this.dwell ? this.dwell.pilotLit : false; }\n  pilotLit() { return this.dwell ? !!this.dwell.pilotLit : true; }\n\n  startDwell(o) {\n    const x = this.stops[this.stopIdx] || {};\n    const T0 = DH.parseClock(o.t0 || this.stage.startClock || '06:40:00');\n    this.dwell = { T0, phase: 'dwell', x, ...this.dwellTimes(T0, x.departure !== null ? x.departure : T0 + 25), pilotLit: false, doorsOpen: true, closed: false, melodyDone: false, doorRush: false };\n    this.train.v = 0; this.phase = 'dwell';\n    this.bus.emit('doors', { open: true });\n    this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai', at: this.dwell.melodyAt });\n  }\n  dwellTimes(T0, dep) {\n    const min = DH.TUNING.dwell;\n    const melodyAt = Math.max(dep - 9, T0 + 6);\n    const closeAt = Math.max(melodyAt + 7, dep - 4, T0 + min);\n    const pilotAt = closeAt + 1.5;\n    const signalAt = Math.max(dep - 3, pilotAt);\n    return { melodyAt, closeAt, pilotAt, signalAt, dep, doorsAt: T0 + 1 };\n  }\n\n  /** the train has stopped at its target and been judged: open the doors and start the dwell */\n  beginDwell(x, T0) {\n    this.phase = 'dwell';\n    const dep = x.departure !== null ? x.departure : T0 + 20;\n    this.dwell = Object.assign({ T0, x, phase: 'dwell', pilotLit: false, doorsOpen: false, closed: false, melodyDone: false, doorRushed: false, boardDone: false }, this.dwellTimes(T0, dep));\n    this.dwell.doorsOpen = false;\n    this.bus.emit('doors', { open: false, at: this.dwell.doorsAt });\n    this.stats.stops++;\n    this.recordCheckpoint('stop');\n  }\n\n  stepDwell(dt) {\n    const d = this.dwell, now = this.clock(), x = d.x;\n    if (!d) return;\n    if (!d.doorsOpen && now >= d.doorsAt) { d.doorsOpen = true; this.bus.emit('doors', { open: true }); this.bus.emit('chime', 'open'); }\n    if (!d.melodyDone && now >= d.melodyAt) { d.melodyDone = true; this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai' }); this.bus.emit('pa', { id: x.id, kind: 'depart' }); }\n    if (d.doorsOpen && d.melodyDone && !d.closed && now >= d.closeAt) {\n      d.closed = true; d.doorsOpen = false; this.bus.emit('doors', { open: false }); this.bus.emit('chime', 'close');\n      this.bus.emit('buzzer');\n    }\n    if (d.closed && !d.pilotLit && now >= d.pilotAt) { d.pilotLit = true; this.bus.emit('pilot'); this.bus.emit('ready'); this.onPilot(); }\n    if (d.pilotLit && !this.departed && now >= d.signalAt) {\n      if (x.startSig) this.readySignals.add(x.startSig.id);\n      this.openCall('departure');\n    }\n  }\n  onPilot() {\n    const x = this.stops[this.stopIdx];\n    if (x && x.startSig) this.readySignals.add(x.startSig.id);\n    this.departed = false; this.firstPowerDone = false;\n    this.recordCheckpoint('depart');\n  }\n\n  // ---- the judgment table (section 4.6) ----\n  judgeStop(err) {\n    const W = DH.TUNING.stopWindow * this.D.win;\n    if (err <= 0.10 * W) return 'PERFECT HALO!';\n    if (err <= 0.30 * W) return 'GREAT!';\n    if (err <= 0.70 * W) return 'GOOD';\n    if (err <= 1.00 * W) return 'OK';\n    return null;\n  }\n  stoppedJudgment(x) {\n    const err = this.train.s - x.target;   // + is past the mark (the front)\n    const T = this.train;\n    const sm = this.smoothOK();\n    const W = DH.TUNING.stopWindow * this.D.win;\n    x.attempts++;\n    if (Math.abs(err) > 50) return null;\n    if (err >= -1.0 * W && err <= 1.0 * W) return 'ok';\n    if (err < -1.0 * W && err >= -5) return 'short';\n    if (err < -5) return 'moveup';\n    if (err > 1.0 * W && err <= 5) return 'over';\n    return 'overmark';\n  }\n  smoothOK() { return this.lastDecel !== undefined && Math.abs(this.lastDecel) <= 1.0 && !this.ebWithin100; }\n\n  /** the stop judgment at standstill; returns the label and the points, applies the Halo Time and score */\n  judgeAt(x) {\n    const T = this.train, err = T.s - x.target, cls = this.stoppedJudgment(x), D = this.D;\n    const W = DH.TUNING.stopWindow * D.win;\n    let label = null, pts = 0, halo = 0;\n    if (cls === 'ok') {\n      if (err <= 0.10 * W) { label = 'PERFECT HALO!'; halo = 5; pts = 1000; this.stats.perfect++; }\n      else if (err <= 0.30 * W) { label = 'GREAT!'; halo = 3; pts = 700; this.stats.great++; }\n      else if (err <= 0.70 * W) { label = 'GOOD'; halo = 1; pts = 400; this.stats.good++; }\n      else { label = 'OK'; halo = 0; pts = 200; this.stats.ok++; }\n      halo *= 1; pts *= 1;\n    } else if (cls === 'short') {\n      // a short stop: up to 6 s to creep up to the mark and re-stop, each re-stop costs a second\n      if (x.restops < 3 && !x.shortSince) { x.shortSince = this.t; this.bus.emit('short', { m: -err }); this.setSubtitle('Hoshino', 'Short. Ease forward to the mark.'); x.shortCountdown = 6; return null; }\n      label = 'SHORT'; halo = Math.round(err) * 1 * D.pen; pts = 0;\n      this.stats.short = (this.stats.short || 0) + 1;\n    } else if (cls === 'moveup') {\n      return null;   // the doors stay shut until it's up to the mark\n    } else if (cls === 'over') {\n      label = 'OVERRUN!'; halo = -Math.abs(err) * DH.TUNING.overrunCost * D.pen; pts = 0; this.stats.overruns++;\n    } else if (cls === 'overmark') {\n      label = 'OVER THE MARK'; halo = -10 * D.pen; pts = -300;\n      this.backup = { target: x.target, from: T.s, x };\n      this.addTime(halo, label); this.addScore(pts); this.judgments.push({ label, t: this.t });\n      return null;\n    }\n    if (label !== null) {\n      this.addTime(halo, label);\n      this.addScore(pts);\n      this.judgments.push({ label, t: this.t, halo, pts, err, sub: this.stats.stops + 1 });\n      x.label = label; x.err = err;\n      if (label === 'SHORT') this.stats.short = this.stats.short || 0;\n      if (cls === 'ok' || cls === 'over' || cls === 'short' || cls === 'moveup') {\n        // the arrival against the timetable\n        this.judgeArrival(x);\n        if (this.smoothOK()) { this.addTime(2, 'SMOOTH!'); this.addScore(300); this.stats.smooth++; this.judgments.push({ label: 'SMOOTH!', t: this.t, halo: 2, pts: 300 }); }\n      }\n      x.judged = true; x.done = true;\n    }\n    return label;\n  }\n  judgeArrival(x) {\n    if (x.arrival === null || x.arrival === undefined) return;\n    const d = this.clock() - x.arrival, W = DH.TUNING.onTimeWindow;\n    if (Math.abs(d) <= W) { this.addTime(3, 'ON TIME!'); this.addScore(500); this.stats.onTime++; this.judgments.push({ label: 'ON TIME!', t: this.t, halo: 3, pts: 500 }); }\n    else if (d > W) { const h = -DH.TUNING.lateCost * (d - W) * this.D.pen; this.addTime(h, 'LATE +' + Math.round(d)); this.stats.late++; this.judgments.push({ label: 'LATE +' + Math.round(d), t: this.t, halo: h, pts: 0 }); }\n    else { this.addScore(100); this.stats.early++; this.judgments.push({ label: 'EARLY', t: this.t, halo: 0, pts: 100 }); }\n  }\n\n  // ---- Halo Time, score, comfort, toasts ----\n  addTime(v, why) {\n    if (!v) return;\n    this.halo = DH.clamp(this.halo + v, -1, this.haloMax);\n    this.toast(why, v);\n    if (this.halo <= 0 && !this.gameOver) { this.gameOver = true; this.bus.emit('gameover'); }\n  }\n  addScore(p) { this.score += p; }\n  toast(text, v) { this.toasts.push({ text, v, t: this.t }); if (this.toasts.length > 5) this.toasts.shift(); }\n  setSubtitle(who, text) { this.subtitles.push({ who, text, t: this.t, until: this.t + 4 }); if (this.subtitles.length > 3) this.subtitles.shift(); this.bus.emit('line', { who, text }); }\n  penalty(c) { this.comfort = Math.max(0, this.comfort - c * DH.TUNING.comfortSens); }\n\n  // ---- signals, blocks and ATS ----\n  occupied(a, b, lane) {\n    // a block [a, b) on a lane is occupied when any part of any train is in it\n    const tr = this.train, lanes = this.laneOfPlayer === undefined ? 'A' : this.laneOfPlayer;\n    if (lane === lanes && tr.s > a && tr.rear < b) return true;\n    for (const o of this.others) {\n      if (o.done || o.lane !== lane) continue;\n      const [lo, hi] = o.span();\n      if (hi > a && lo < b) return true;\n    }\n    return false;\n  }\n  /** the aspect of a signal: from the clear blocks ahead of it on its track (section 4.4) */\n  aspectOf(g) {\n    if (g.kind === 'shunt') return 'R';\n    if (g.forced) return g.forced;\n    if (g.kind === 'start' && !this.readySignals.has(g.id)) return 'R';\n    const idx = this.signals.indexOf(g);\n    const next = (i) => (this.signals[i + 1] ? this.signals[i + 1].s : this.route.to);\n    let c = 0;\n    for (let i = idx; i < this.signals.length && c < 3; i++) {\n      const a = this.signals[i].s, b = next(i);\n      if (this.signals[i].track !== g.track) continue;\n      if (this.occupied(a, b, 'A')) break;\n      if (i > idx && this.signals[i].kind === 'start' && !this.readySignals.has(this.signals[i].id)) break;\n      c++;\n    }\n    if (g.obstruct && this.obstruction && this.obstruction.active) return 'R';\n    return ['R', 'Y', 'YG', 'G'][Math.min(c, 3)];\n  }\n  /** the aspect's speed (km/h), for the speed limit in force */\n  aspectSpeed(asp) {\n    if (asp === 'G') return null;\n    return ASPECT_SPEED[asp];\n  }\n\n  /** a signal is sighted when it is within 600 m and visible (or within 180 m in fog) */\n  sighted(g, d) {\n    return d >= 0 && (d <= 600 && (this.fogDist > 400 || d <= 180 || d <= 600)) && d <= (this.fogDist < 400 ? 180 : 600);\n  }\n\n  confirmATS() {\n    if (!this.atsRinging) return false;\n    this.atsRinging = false; this.atsOn = true; this.atsConfirmTimer = 0;\n    this.bus.emit('atsConfirm');\n    this.toast('ATS CONFIRM', 0);\n    return true;\n  }\n  hazardOpen() { return !!(this.obstruction && this.obstruction.active); }\n\n  // ---- speed limits (section 4.5) ----\n  limitInForce() {\n    const T = this.train, R = this.route, front = T.s, rear = T.rear;\n    let lim = R.lineSpeedAt(front) || 85;\n    if (this.stage.lineSpeed) lim = Math.min(lim, this.stage.lineSpeed);\n    for (const L of this.limits) {\n      if (L.end === null) continue;\n      if (front >= L.s && rear <= L.end) lim = Math.min(lim, L.v);   // in force while any of the train is in its section\n      if (front >= L.s && rear > L.end && front <= L.end) lim = Math.min(lim, L.v);\n    }\n    if (this.aspectCap !== null) lim = Math.min(lim, this.aspectCap);\n    if (this.slowOrder) lim = Math.min(lim, this.slowOrder);\n    return lim;\n  }\n\n  // ---- the events (section 4.11): each fires once ----\n  fire(id, data) { if (this.events.has(id)) return false; this.events.add(id); this.fired.push(id); this.bus.emit('event', { id, data }); return true; }\n\n  // ---- the step ----\n  step(dt) {\n    if (this.gameOver || this.finished) return;\n    this.t += dt;\n    if (this.stage.frozenHalo) this.halo = this.stage.frozenHalo;\n    const T = this.train, R = this.route;\n    // the step's order (section 3.4): dynamics, other trains, signals, ATS and limits, events, station, calls, halo\n    if (this.backup) {\n      const b = this.backup;\n      T.v = -5; T.s -= 5 / 3.6 * dt; T.notch = 0;\n      if (T.s <= b.target + 1) { T.s = Math.max(T.s, b.target); T.v = 0; this.backup = null; this.judgeAt(b.x); this.judgeAt; this.pendingDone = true; }\n      return;\n    }\n    const traction = this.pilotLit();\n    const env = { grade: R.gradeAt(T.s), dry: this.dryRail, traction };\n    const sBefore = T.s;\n    if (!this.halted && !this.gameOver) {\n      const r = T.step(dt, env);\n      if (T.slipT > 0 && !this.slipFlag) { this.slipFlag = true; this.stats.slips++; this.penalty(3); this.bus.emit('slip'); this.toast('SLIP', 0); }\n      if (T.slipT <= 0) this.slipFlag = false;\n      if (T.slide && !this.slideFlag) { this.slideFlag = true; this.penalty(3); this.bus.emit('slide'); }\n      if (!T.slide) this.slideFlag = false;\n      if (T.rolled > 1 && !this.rollFlag) { this.rollFlag = true; this.addTime(-2 * this.D.pen, 'ROLLBACK'); this.penalty(5); }\n      if (r) this.lastA = r.a;\n      this.stats.km += Math.max(0, T.s - sBefore) / 1000;\n    }\n    // the decel near standstill, for SMOOTH\n    if (T.v > 0 && T.v <= 3) this.lastDecel = T.a;\n    if (T.eb) this.ebSince = (this.ebSince || 0) + dt; else this.ebSince = 0;\n    this.ebWithin100 = false;\n    for (const o of this.others) o.step(dt, this);\n    this.updateObstruction(dt);\n    this.updateSignals(dt);\n    this.updateATS(dt);\n    this.updateLimits(dt);\n    this.updateCrossings(dt);\n    this.updateHorn(dt);\n    this.updateCalls(dt);\n    this.updateStations(dt);\n    this.updateComfort(dt);\n    this.updateEvents(dt);\n    this.updateHalo(dt);\n    this.toasts = this.toasts.filter(t => this.t - t.t < 2.6);\n    this.judgments = this.judgments.filter(j => this.t - j.t < 1.6 || j === this.judgments[this.judgments.length - 1]);\n    this.subtitles = this.subtitles.filter(s => this.t < s.until);\n    void R;\n  }\n\n  updateSignals(dt) {\n    for (const g of this.signals) {\n      g.aspect = this.aspectOf(g);\n      const d = g.s - this.train.s;\n      if (!this.sighted.has(g.id) && this.sighted1(g, d)) { this.sighted.add(g.id); this.bus.emit('sighted', { id: g.id, aspect: g.aspect }); }\n      // passing a red at speed (the front crosses its signal while R): a SPAD\n      if (this.train.s > g.s && this.lastS !== undefined && this.lastS <= g.s && !this.signalPassed.has(g.id) && g.track === 'A') {\n        this.signalPassed.add(g.id);\n        if (g.aspect === 'R' && g.kind !== 'shunt' && !this.spadLatched.has(g.id)) { this.spad(g); }\n      }\n      if (this.train.s > g.s) this.signalPassed.has(g.id) || (this.signalPassed.add(g.id), 0);\n    }\n    this.lastS = this.train.s;\n    // the aspect speed of the last signal passed (the cap until the next one)\n    let last = null;\n    for (const g of this.signals) if (g.s <= this.train.s) last = g;\n    this.lastPassed = last;\n    this.aspectCap = last ? this.aspectSpeed(last.aspect) : null;\n    if (last && last.aspect === 'G') this.aspectCap = null;\n  }\n  sighted1(g, d) { const fog = this.fogDist < 400; return d >= 0 && d <= (fog ? 180 : 600) && (g.s - this.train.s) <= (fog ? 180 : 600); }\n  spad(g) {\n    this.spadLatched.add(g.id); this.stats.spad++;\n    this.bus.emit('spad', { id: g.id });\n    this.addTime(-20 * this.D.pen, 'SIGNAL PASSED AT DANGER'); this.addScore(-1000); this.penalty(15);\n    this.setSubtitle('Hoshino', 'Stop! That was a red.');\n    this.judgments.push({ label: 'SIGNAL PASSED AT DANGER', t: this.t, halo: -20 * this.D.pen, pts: -1000 });\n    this.train.emergency(); this.bus.emit('eb');\n  }\n\n  updateATS(dt) {\n    const T = this.train;\n    // ATS: passing a beacon 600 m before a red signal rings the bell; it must be confirmed within the time\n    for (const g of this.signals) {\n      if (g.kind === 'shunt') continue;\n      const beacon = g.s - 600;\n      if (T.s >= beacon && (this.lastS0 === undefined || this.lastS0 < beacon) && g.aspect === 'R' && !this.atsLatched.has(g.id)) {\n        this.atsLatched.add(g.id);\n        if (T.s < g.s) { this.atsRinging = true; this.atsTimer = DH.TUNING.atsTime; this.stats.ats++; this.bus.emit('ats', { id: g.id }); this.toast('ATS!', 0); this.setSubtitle('Hoshino', 'ATS! Confirm it. Then brake.'); }\n      }\n    }\n    this.lastS0 = T.s;\n    if (this.atsRinging) {\n      this.atsTimer -= dt;\n      if (this.atsTimer <= 0) { this.atsRinging = false; this.train.emergency(); this.onEmergency(); this.addTime(-3 * this.D.pen, 'ATS EB'); this.stats.ebs++; }\n    }\n    if (this.atsOn) { if (T.v < 15 || (this.lastPassed && this.lastPassed.aspect !== 'R')) this.atsOn = false; }\n    // the speed check: over the limit by more than 10 km/h fires the brake\n    const lim = this.limitInForce(), over = T.v - lim;\n    if (over > 10 && !this.speedAlarm && !T.eb) { this.speedAlarm = true; this.train.emergency(); this.onEmergency(); this.addTime(-3 * this.D.pen, 'ATS EB'); this.toast('ATS!', 0); }\n    if (over < 0) this.speedAlarm = false;\n  }\n\n  updateLimits(dt) {\n    const T = this.train, lim = this.limitInForce(), tol = DH.TUNING.limitTol;\n    const over = T.v - lim;\n    if (over > tol) {\n      if (!this.limitBroken) {\n        this.limitBroken = true; this.stats.limit++;\n        this.limitPeak = over;\n        this.addTime(-2 * this.D.pen, 'LIMIT!'); this.addScore(-300); this.penalty(3); this.bus.emit('limit', { v: lim });\n        this.judgments.push({ label: 'LIMIT!', t: this.t, halo: -2 * this.D.pen, pts: -300 });\n      } else if (over > (this.limitPeak || 0) + 5) {\n        const extra = Math.floor((over - (this.limitPeak || 0)) / 5);\n        this.limitPeak = over;\n        this.addTime(-1 * extra * this.D.pen, 'LIMIT!');\n      }\n    } else if (over < 0 && this.limitBroken) { this.limitBroken = false; this.limitPeak = 0; }\n  }\n\n  // ---- crossings and the obstruction ----\n  updateCrossings(dt) {\n    this.crossingGates = this.crossingGates || {};\n    for (const c of this.route.crossings) {\n      const T = this.train, d = c.s - T.s, onIt = T.s > c.s - 1 && T.rear < c.s + 1;\n      let g = this.crossingGates[c.id] || { state: 'up', t: 0 };\n      if (g.state === 'up' && d > -20 && (d < 500 || (d / Math.max(T.v / 3.6, 1) < 25 && T.v > 1))) { g.state = 'down'; g.t = 0; this.bus.emit('gates', { id: c.id, down: true }); }\n      if (g.state === 'down') { if (T.rear > c.s + 12 || (d > 1500)) { g.state = 'up'; this.bus.emit('gates', { id: c.id, down: false }); } }\n      if (c.special && this.obstruction === null && this.stage.obstruction && this.stage.obstruction.id === c.id && d < 350 && d > -20) {\n        this.obstruction = { id: c.id, active: true, since: this.t, cleared: false };\n        this.bus.emit('obstruction', { id: c.id, on: true });\n        this.fire('obstruction');\n      }\n      g.onIt = onIt;\n      this.crossingGates[c.id] = g;\n    }\n    const ob = this.obstruction;\n    if (ob && ob.active) {\n      const c = this.route.crossings.find(x => x.id === ob.id), T = this.train;\n      if (c && T.s > c.s - 2 && T.rear < c.s + 2 && !ob.passed) {\n        // into the blocked crossing: an emergency stop too late\n        ob.passed = true; this.addTime(-3 * this.D.pen, 'HAZARD'); this.addScore(-200); this.bus.emit('hazard');\n        T.emergency(); this.onEmergency();\n      }\n      if (T.v === 0 && c && T.s < c.s - 3 && !ob.counted) {\n        ob.counted = true; ob.stoppedAt = this.t;\n        this.addTime(5, 'HAZARD AVOIDED'); this.addScore(800); this.stats.hazard = (this.stats.hazard || 0) + 1;\n        this.judgments.push({ label: 'HAZARD AVOIDED', t: this.t, halo: 5, pts: 800 });\n        this.setSubtitle('Mika', 'The crossing alarm! Something is on the tracks!');\n      }\n      if (ob.stoppedAt !== undefined && this.t - ob.stoppedAt > 12) { ob.active = false; this.bus.emit('obstruction', { id: ob.id, on: false }); }\n    }\n  }\n  updateObstruction(dt) { void dt; }\n\n  // ---- the horn (section 4.7) ----\n  setHorn(on) {\n    const H = this.horn;\n    if (on && !H.held) { H.held = true; H.tHeld = 0; this.bus.emit('horn', { on: true }); }\n    if (!on && H.held) { H.held = false; this.bus.emit('horn', { on: false }); }\n  }\n  updateHorn(dt) {\n    const H = this.horn, T = this.train;\n    if (H.held) H.tHeld += dt;\n    for (const h of this.route.horns) {\n      const inZone = T.s >= h.s && T.s < h.s + h.zone;\n      const key = 'horn' + h.s;\n      if (inZone && H.held && H.tHeld >= 0.5 && !H.sounded.has(key)) {\n        H.sounded.add(key); this.stats.horn++;\n        this.addTime(1, 'HORN +1'); this.addScore(100); this.judgments.push({ label: 'HORN +1', t: this.t, halo: 1, pts: 100 });\n        this.bus.emit('hornOK', { s: h.s });\n      }\n      if (!inZone && T.s >= h.s + h.zone && !H.sounded.has(key) && !H.missed?.has?.(key)) {\n        H.missed = H.missed || new Set(); H.missed.add(key);\n        if (this.difficulty !== 'easy') this.addTime(-1 * this.D.pen, 'NO HORN');\n      }\n    }\n    if (H.held && this.horn.lastHeld) void 0;\n    this.horn.lastHeld = H.held;\n    // the workers wave when they hear the horn\n    for (const w of this.route.workers || []) {\n      if (H.held && T.s > w.s - 300 && T.s < w.until) this.bus.emit('workersHeard', { s: w.s });\n    }\n  }\n\n  // ---- the calls (section 4.7) ----\n  openCall(kind) { this.callOpen = { kind, opened: this.t, made: false, early: false }; this.bus.emit('callOpen', { kind }); }\n  call() {\n    const T = this.train;\n    // departure call: its own window\n    if (this.callOpen && this.callOpen.kind === 'departure') {\n      const c = this.callOpen; c.made = true; this.callOpen = null;\n      const great = !!c.early || !this.firstPowerDone;\n      this.scoreCall(great, 'departure');\n      return { kind: 'departure', great };\n    }\n    // the nearest open point ahead: 30 to 180 m; GREAT between 60 and the sweet spot's far edge\n    let best = null, bd = 1e9;\n    for (const c of this.calls) {\n      if (c.called) continue;\n      const d = c.s - T.s;\n      if (d > 30 && d <= 180 && d < bd) {\n        if (c.kind === 'signal' && !this.sighted.has(c.sig)) continue;\n        best = c; bd = d;\n      }\n    }\n    if (!best) { this.bus.emit('callMiss'); return null; }\n    best.called = true;\n    const great = bd >= 60 && bd <= DH.TUNING.callGreat;\n    this.scoreCall(great, best.kind, best);\n    return { kind: best.kind, great, point: best };\n  }\n  scoreCall(great, kind, point) {\n    this.stats.calls++;\n    if (great) { this.stats.callsGreat++; this.addTime(0.5, 'CALL GREAT'); this.addScore(100); }\n    else { this.addScore(50); this.toast('CALL', 0); }\n    this.bus.emit('call', { kind, great, point: point || null });\n    this.judgments.push({ label: great ? 'CALL GREAT' : 'CALL', t: this.t, halo: great ? .5 : 0, pts: great ? 100 : 50 });\n  }\n  updateCalls(dt) {\n    // auto-calls (assist): make the call at the sweet spot, without points\n    if (this.opts.autoCalls) for (const c of this.calls) {\n      if (c.called) continue;\n      const d = c.s - this.train.s;\n      if (d <= DH.TUNING.callGreat && d > 60 && (c.kind !== 'signal' || this.sighted.has(c.sig))) { c.called = true; this.bus.emit('call', { kind: c.kind, great: true, auto: true, point: c }); }\n    }\n    if (this.callOpen && this.callOpen.kind === 'departure' && !this.callOpen.made && this.t - this.callOpen.opened > 20) this.callOpen = null;\n  }\n\n  // ---- stations: the approach, the stop, the miss (section 4.6) ----\n  updateStations(dt) {\n    const T = this.train;\n    if (this.dwell) {\n      this.stepDwell(dt);\n      // a pass-through or the last stop ends the stage once its doors have closed and its departure is done\n      return;\n    }\n    if (this.shortCountdown !== undefined) void 0;\n    const x = this.stops[this.stopIdx];\n    if (!x) { if (this.stopIdx >= this.stops.length && !this.finished && this.stage.endOnLastStop !== false) this.stageEnd(); return; }\n    const err = T.s - x.target, moved = T.s;\n    // judgment at standstill\n    if (!x.judged && Math.abs(T.v) < 0.05 && Math.abs(err) <= 50 && err > -50) {\n      if (x.shortSince !== undefined || (err >= -1.01 * DH.TUNING.stopWindow * this.D.win && err <= 50)) {\n        // stopped inside the window: judge it (a short one waits for the creep)\n        const label = this.judgeAt(x);\n        if (label || (x.judged)) { this.beginDwell(x, this.clock()); this.stopIdx++; this.dwellNext = true; }\n        else if (this.backup) { /* back-up in progress */ }\n        else if (x.shortCountdown !== undefined) { x.shortCountdown -= dt; if (x.shortCountdown <= 0) { x.shortCountdown = undefined; const lab = this.judgeAt(Object.assign(x, { forceShort: true })); void lab; this.beginDwell(x, this.clock()); this.stopIdx++; } }\n      }\n    }\n    if (!x.judged && err > 5 && Math.abs(T.v) < 0.05 && !this.backup) { /* moving up or overrun over 5 m: the back-up applies */ }\n    // passed the mark without stopping: the stop is missed\n    if (!x.judged && T.s > x.target + 50 && !x.missed) {\n      x.missed = true; x.judged = true; x.done = true;\n      this.addTime(-10 * this.D.pen, 'MISSED STOP'); this.addScore(-300); this.judgments.push({ label: 'MISSED STOP', t: this.t, halo: -10 * this.D.pen, pts: -300 });\n      this.setSubtitle('Hoshino', 'Missed. We were meant to stop there.');\n      this.stopIdx++;\n    }\n    if (x.judged && x.done && this.stopIdx >= this.stops.length) this.stageEnd();\n    void moved;\n  }\n  stageEnd() { if (this.finished) return; this.finished = true; this.recordCheckpoint('end'); this.bus.emit('stageEnd'); }\n  smoothAfterStop() { return true; }\n\n  // ---- comfort (section 4.10) ----\n  updateComfort(dt) {\n    const T = this.train;\n    if (T.jerk && Math.abs(T.jerk) > 80 && T.v > 2) { this.jerkWarn = (this.jerkWarn || 0) + dt; }\n    if (T.eb && !this.ebComfortHit) { this.ebComfortHit = true; this.penalty(15); }\n    if (!T.eb) this.ebComfortHit = false;\n    if (this.lastNotchT !== undefined && this.lastNotch !== undefined) void 0;\n    if (Math.abs(T.a) < 1.5 && T.v > 1) this.comfortRecover += dt;\n    if (this.comfortRecover >= 8) { this.comfortRecover = 0; this.comfort = Math.min(100, this.comfort + 1); }\n  }\n\n  // ---- events: data-driven per stage (section 4.11) ----\n  updateEvents(dt) {\n    const T = this.train, evs = this.stage.events || [];\n    for (const e of evs) {\n      if (this.events.has(e.id)) continue;\n      let go = false;\n      if (e.at !== undefined && T.s >= e.at) go = true;\n      if (e.clock !== undefined && this.clock() >= DH.parseClock(e.clock)) go = true;\n      if (e.stop && this.dwell && this.dwell.x && this.dwell.x.id === e.stop) go = true;\n      if (go) this.runEvent(e);\n    }\n  }\n  runEvent(e) {\n    this.fire(e.id, e);\n    switch (e.type) {\n      case 'oncoming': {\n        const lane = e.lane || 'B', s = this.train.s + (e.ahead || 1400);\n        this.others.push(new TrainActor({ id: e.id, kind: 'oncoming', train: e.train || 'h8000', lane, dir: -1, s, v: e.v || 80, cars: 6, legs: [{ v: e.v || 80, acc: 4, until: -1e9 }] }));\n        break;\n      }\n      case 'radio': this.setSubtitle(e.who, e.text); this.bus.emit('radio', e); break;\n      case 'tip': this.bus.emit('tip', e); break;\n      case 'doorRush': if (this.dwell && !this.dwell.doorRushed) { this.dwell.doorRushed = true; this.dwell.closeAt += 8; this.dwell.pilotAt += 8; this.dwell.signalAt += 8; this.setSubtitle('Mika', 'One moment please! Doors re-opening!'); this.bus.emit('doorRush'); } break;\n      case 'flash': this.bus.emit('flash', e); break;\n      case 'rival': this.others.push(new TrainActor(e.train)); break;\n      case 'freight': this.others.push(new TrainActor(e.train)); break;\n      case 'workers': this.slowOrder = e.v || 25; this.bus.emit('workers', e); break;\n      case 'fog': this.fogDist = 180; this.bus.emit('fog', e); break;\n      case 'glare': this.bus.emit('glare', e); break;\n      case 'festival': this.bus.emit('festival', e); break;\n      default: this.bus.emit('event', e);\n    }\n  }\n  updateHalo(dt) {\n    if (this.stage.frozenHalo) return;\n    // Halo Time drains nothing: it changes only at events. Reset the step's flags\n    this.ebWithin100 = false;\n  }\n\n  // ---- checkpoints (section 4.9) ----\n  recordCheckpoint(why) {\n    const T = this.train;\n    this.checkpoint = { why, s: T.s, v: 0, clock: this.clock(), halo: this.halo, score: this.score, comfort: this.comfort, stopIdx: this.stopIdx,\n      fired: this.fired.slice(), t: this.t, stats: Object.assign({}, this.stats), judgments: this.judgments.slice(-6) };\n  }\n\n  // ---- what the scenes and the tests read ----\n  snapshot() {\n    const T = this.train, next = this.stops[this.stopIdx] || null;\n    const ahead = this.signals.filter(g => g.s > T.s).slice(0, 3).map(g => ({ id: g.id, dist: Math.round(g.s - T.s), aspect: g.aspect, sighted: this.sighted.has(g.id) }));\n    return {\n      t: this.t, clock: DH.clock(this.clock()), s: T.s, km: T.s / 1000, v: T.v, notch: T.notchName, P: T.P, B: T.B, a: T.a, jerk: T.jerk,\n      eb: T.eb, slip: T.slipT > 0, slide: T.slide, brakeEff: T.B, halo: this.halo, score: this.score, comfort: Math.round(this.comfort),\n      limit: this.limitInForce(), nextStop: next ? { id: next.id, dist: Math.round(next.target - T.s), arr: next.arr || null, target: next.target } : null,\n      signals: ahead, lastJudgment: this.judgments.length ? this.judgments[this.judgments.length - 1] : null,\n      events: this.fired.slice(), doors: !!(this.dwell && this.dwell.doorsOpen), pilot: this.pilotLit(), ats: { ringing: this.atsRinging, confirmed: this.atsOn },\n      dwell: this.dwell ? { phase: this.dwell.melodyDone ? 'melody' : 'doors', closed: this.dwell.closed, pilot: this.dwell.pilotLit } : null,\n      stopped: Math.abs(T.v) < 0.05, finished: this.finished, gameOver: this.gameOver, stats: Object.assign({}, this.stats), weather: this.weather, fogDist: this.fogDist,\n      call: this.callOpen ? this.callOpen.kind : null, obstruction: this.obstruction ? this.obstruction.active : false, backup: !!this.backup, phase: this.phase,\n      difficulty: this.difficulty, others: this.others.map(o => ({ id: o.id, s: Math.round(o.s), v: Math.round(o.v), lane: o.lane })), toasts: this.toasts.map(t => t.text)\n    };\n  }\n}\nDH.Sim = Sim;\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":504,"cache_read_input_tokens":240598,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":504},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"91bce688-f668-40f1-8d03-58ffb72fc0a7","timestamp":"2026-11-04T12:14:53.004Z","request_id":"req_011CghsHS9bcH76aXAFfUcDn","wire_tool_inputs":{"toolu_01PGPiGQLrGwipMHgfws35ef":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/31-sim.js","content":"/* Densha de Halo! · 31-sim: the world of a stage, stepped at 1/120 s. Pure: no drawing, no sound, no engine.\n * It owns the train (30-train), the signals and blocks, the other trains, the limits, ATS, the stops, the dwell and the\n * departure sequence, the timetable and the clock, Halo Time, the score and comfort, the calls and the horn, and the events.\n * The scenes read it through snapshot() and send it commands through cmd(). Rules: section 4.4 to 4.11. */\n(() => {\n'use strict';\nconst DH = window.DH;\n\nconst DIFF = {\n  easy: { name: 'Easy', grace: 40 / 25, win: 1.5, pen: 0.5, guide: true, calls: 'auto?' },\n  normal: { name: 'Normal', grace: 1, win: 1.0, pen: 1.0 },\n  expert: { name: 'Expert', grace: 15 / 25, win: 0.7, pen: 1.5 }\n};\nDH.DIFF = DIFF;\nconst ASPECT_SPEED = { G: null, YG: 65, Y: 45, YY: 25, R: 0 };   // G means the line speed\nDH.ASPECT_SPEED = ASPECT_SPEED;\n\n/* the aspect a 4-lamp head shows from the clear blocks ahead (section 4.4): 0 -> R, 1 -> Y, 2 -> YG, 3+ -> G */\nconst LAMPS = { R: [0, 0, 1, 0], Y: [1, 0, 0, 0], YG: [1, 1, 0, 0], G: [0, 1, 0, 0], YY: [1, 0, 0, 1] };\nDH.LAMPS = LAMPS;\n\n/* a train that is not the player's: an oncoming train, a freight, a rival. Its legs are a script; it moves at a set speed\n * (its own lag-free model; it never affects the player's train except by occupying blocks on its own lane) */\nclass TrainActor {\n  constructor(o) {\n    Object.assign(this, { id: o.id, kind: o.kind || 'other', spec: DH.TRAINS[o.train || 'freight'], lane: o.lane || 'B', dir: o.dir || 1,\n      s: o.s, v: o.v || 0, cars: o.cars || 4, legs: (o.legs || []).slice(), leg: 0, wait: 0, livery: o.livery || null, clockAt: o.clockAt || null, done: false, log: [] });\n    this.cars = this.cars || (this.spec ? this.spec.cars : 4);\n    this.nose = o.nose || '#ffffff';\n  }\n  get length() { return this.cars * 20; }\n  get rear() { return this.dir > 0 ? this.s - this.length : this.s + this.length; }\n  /** the segment spans the train covers: [lo, hi] in route metres */\n  span() { return this.dir > 0 ? [this.rear, this.s] : [this.s, this.rear]; }\n  step(dt, world) {\n    if (this.done) return;\n    if (this.clockAt !== null && world.clock() < this.clockAt) return;\n    if (this.leg >= this.legs.length) { this.v = Math.max(0, this.v - 5 * dt); this.s += this.dir * this.v / 3.6 * dt; this.done = this.v === 0 && !this.legs.length; return; }\n    const L = this.legs[this.leg];\n    if (L.lane) this.lane = L.lane;\n    if (this.wait > 0) { this.wait -= dt; this.v = 0; if (this.wait <= 0) this.leg++; return; }\n    const target = L.v, acc = L.acc || 4;   // km/h/s\n    this.v += DH.clamp(target - this.v, -acc * dt, acc * dt);\n    if (L.stopAt !== undefined) {\n      const remain = (L.stopAt - this.s) * this.dir;   // metres to the stop, along the direction of travel\n      if (remain <= 0.02 || (this.v > 0 && remain < this.v / 3.6 * this.v / 3.6 / (2 * acc / 3.6) + 0.02 && L.v === 0)) {\n        this.v = 0; this.s = L.stopAt; this.wait = L.dwell || 0.05; if (!L.dwell) this.leg++;\n        return;\n      }\n    }\n    this.s += this.dir * this.v / 3.6 * dt;\n    if (L.until !== undefined && (this.s - L.until) * this.dir >= 0) this.leg++;\n  }\n}\nDH.TrainActor = TrainActor;\n\n/* the sim: built from a stage and a route */\nclass Sim {\n  constructor(stage, route, opts = {}) {\n    this.stage = stage; this.route = route; this.opts = opts;\n    this.difficulty = opts.difficulty || 'normal'; this.D = DIFF[this.difficulty];\n    this.t = 0;                     // stage time (s), paused with the game\n    this.events = new Set(); this.fired = [];\n    this.bus = new DH.Bus();\n    this.score = 0; this.comfort = 100; this.comfortRecover = 0;\n    this.halo = 0; this.haloStart = 0; this.haloMax = 99;\n    this.log = [];                   // judgments and penalties, for the results and the story\n    this.toasts = []; this.judgments = []; this.subtitles = [];\n    this.stats = { stops: 0, perfect: 0, great: 0, good: 0, ok: 0, onTime: 0, late: 0, early: 0, smooth: 0, calls: 0, callsGreat: 0, horn: 0, overruns: 0, slips: 0, ats: 0, spad: 0, limit: 0, ebs: 0, km: 0 };\n    this.maxPoints = 0; this.maxStat = { stops: 0, onTime: 0, smooth: 0, calls: 0, horn: 0, hazard: 0 };\n    this.gameOver = false; this.finished = false; this.results = null;\n    this.lastCall = null; this.callOpen = null;\n    this.sighted = new Set(); this.atsLatched = new Set(); this.spadLatched = new Set(); this.limitArmed = new Map();\n    this.station = null; this.stopIdx = 0; this.phase = 'run';\n    this.dwell = null; this.departed = false;\n    this.readySignals = new Set(); this.signalPassed = new Set();\n    this.weather = stage.weather || 'clear'; this.fogDist = 900; this.hour = stage.hour || 12;\n    this.lineLimit = null; this.aspectCap = null; this.lastAspect = 'G';\n    this.horn = { held: false, zoneFrom: null, sounded: new Set(), tHeld: 0 };\n    this.atsRinging = false; this.atsConfirmTimer = 0; this.atsOn = false; this.speedAlarm = false;\n    this.backup = null; this.obstruction = null; this.rollbackWarn = 0;\n    this.checkpoint = null;\n    this.halted = false;\n    this.spec = DH.TRAINS[stage.train || 'h8000'];\n    this.train = new DH.Train(this.spec, { s: opts.s0 !== undefined ? opts.s0 : (stage.startS || 0) });\n    this.train.dir = 1;\n    this.train.cars = stage.cars || 6;\n    this.dryRail = this.weather !== 'rain';\n    this.others = [];\n    this.setup();\n  }\n\n  // ---- setup ----\n  setup() {\n    const st = this.stage, R = this.route;\n    this.clockOffset = DH.parseClock(st.startClock || '06:40:00');\n    // the stops of the stage, in route order: each stop is a station with its timetable\n    this.stops = (st.stops || []).map(x => Object.assign({}, x, { st: R.stationById(x.id), target: 0 }));\n    for (const x of this.stops) {\n      const cars = this.train.cars;\n      const target = R.stopOf(x.id, cars) !== undefined ? R.stopOf(x.id, cars) : (x.st && x.st.stops ? Object.values(x.st.stops)[0] : 0);\n      x.target = target; x.arrS = target;\n      x.arrival = x.arr ? DH.parseClock(x.arr) : null; x.departure = x.dep ? DH.parseClock(x.dep) : null;\n      x.judged = false; x.attempts = 0; x.restops = 0; x.done = false; x.missed = false;\n      x.start = x.st ? x.st.start : x.target;\n      x.startSig = null;\n      // its departure signal: the first start signal in the 400 m past its platform\n      if (x.st) x.startSig = R.signals.find(g => g.kind === 'start' && g.s >= x.st.end - 5 && g.s <= x.st.end + 420) || null;\n    }\n    this.passes = (st.passes || []).map(p => Object.assign({}, p, { at: R.stationById(p.id) ? R.stationById(p.id).start : p.at }));\n    this.endS = st.endS !== undefined ? st.endS : (this.stops.length ? this.stops[this.stops.length - 1].target : this.train.s);\n    // the blocks and signals, ordered\n    this.signals = R.signals.slice().sort((a, b) => a.s - b.s);\n    for (const g of this.signals) g.aspect = 'R';\n    // the other trains from the stage's list\n    for (const o of (st.trains || [])) this.others.push(new TrainActor(o));\n    this.limits = R.limits.slice();\n    this.calls = [];\n    this.buildCalls();\n    // the initial state of the station the train starts at: doors open, the dwell's clock running from the stage start\n    if (st.startDwell) this.startDwell(st.startDwell);\n    this.train.v = 0;\n    this.applyWeather();\n    this.recordCheckpoint('start');\n  }\n  applyWeather() {\n    const w = this.weather;\n    this.dryRail = w !== 'rain';\n    this.fogDist = w === 'fog' ? 180 : 900;\n    if (this.stage.fogDist) this.fogDist = this.stage.fogDist;\n  }\n  buildCalls() {\n    const R = this.route, add = (o) => this.calls.push(Object.assign({ called: false, grade: null, key: o.id + '@' + o.s }, o));\n    for (const g of this.signals) {\n      if (g.kind === 'shunt' || g.kind === 'block' || g.kind === 'home' || g.kind === 'start') add({ s: g.s, id: g.id, kind: 'signal', sig: g.id });\n    }\n    for (const L of this.limits) add({ s: L.s, id: 'lim' + L.s, kind: 'limit', v: L.v });\n    for (const h of R.horns) add({ s: h.s, id: 'horn' + h.s, kind: 'horn' });\n    for (const x of this.stops) if (x.st) add({ s: x.st.start - 400, id: 'app' + x.id, kind: 'approach', stopId: x.id });\n    for (const c of R.crossings) if (c.special === false) add({ s: c.s, id: 'cross' + c.id, kind: 'crossing', optional: true });\n    for (const w of R.workers || []) add({ s: w.s, id: 'work' + w.s, kind: 'workers' });\n  }\n\n  // ---- the clock and time ----\n  clock() { return this.clockOffset + this.t; }\n  now() { return this.clock(); }\n\n  // ---- commands (from the controller, the keyboard, the autopilot) ----\n  cmd(name, val) {\n    const T = this.train, out = {};\n    switch (name) {\n      case 'power':\n        if (this.halted) break;\n        if (!this.pilotLit() && !T.eb && T.notch >= 0) { if (T.v === 0 && this.phase !== 'run') { this.bus.emit('buzz', 'doors'); } }\n        if (!this.pilotLit() && T.notch >= 0 && T.v === 0 && !T.eb) { this.note('doors'); T.notch = Math.min(T.notch + 1, T.spec.notchesP); break; }\n        if (T.power()) { this.bus.emit('notch', { name: T.notchName, dir: 1 }); if (!this.firstPowerDone) this.onFirstPower(); }\n        break;\n      case 'brake': if (T.brake()) this.bus.emit('notch', { name: T.notchName, dir: -1 }); break;\n      case 'neutral': if (!T.eb) { T.neutral(); this.bus.emit('notch', { name: 'N', dir: 0 }); } break;\n      case 'eb': if (!T.eb) { T.emergency(); this.onEmergency(); } break;\n      case 'ebRelease': break;\n      case 'ats': this.confirmATS(); break;\n      case 'horn': this.setHorn(!!val); break;\n      case 'call': return this.call();\n      case 'backup': break;\n      default: break;\n    }\n    return out;\n  }\n  note(kind) { this.bus.emit('note', kind); }\n  onFirstPower() { this.firstPowerDone = true; if (this.callOpen && this.callOpen.kind === 'departure' && !this.callOpen.made) this.callOpen.early = true; }\n  onEmergency() {\n    if (this.dwell || this.phase !== 'run') return;\n    this.stats.ebs++;\n    if (!this.hazardOpen()) { this.addTime(-3 * this.D.pen, 'EMERGENCY'); this.addScore(-200); }\n    this.bus.emit('eb');\n  }\n\n  // ---- the stop and dwell phase machine ----\n  get pilot() { return this.dwell ? this.dwell.pilotLit : false; }\n  pilotLit() { return this.dwell ? !!this.dwell.pilotLit : true; }\n\n  startDwell(o) {\n    const x = this.stops[this.stopIdx] || {};\n    const T0 = DH.parseClock(o.t0 || this.stage.startClock || '06:40:00');\n    this.dwell = { T0, phase: 'dwell', x, ...this.dwellTimes(T0, x.departure !== null ? x.departure : T0 + 25), pilotLit: false, doorsOpen: true, closed: false, melodyDone: false, doorRush: false };\n    this.train.v = 0; this.phase = 'dwell';\n    this.bus.emit('doors', { open: true });\n    this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai', at: this.dwell.melodyAt });\n  }\n  dwellTimes(T0, dep) {\n    const min = DH.TUNING.dwell;\n    const melodyAt = Math.max(dep - 9, T0 + 6);\n    const closeAt = Math.max(melodyAt + 7, dep - 4, T0 + min);\n    const pilotAt = closeAt + 1.5;\n    const signalAt = Math.max(dep - 3, pilotAt);\n    return { melodyAt, closeAt, pilotAt, signalAt, dep, doorsAt: T0 + 1 };\n  }\n\n  /** the train has stopped at its target and been judged: open the doors and start the dwell */\n  beginDwell(x, T0) {\n    this.phase = 'dwell';\n    const dep = x.departure !== null ? x.departure : T0 + 20;\n    this.dwell = Object.assign({ T0, x, phase: 'dwell', pilotLit: false, doorsOpen: false, closed: false, melodyDone: false, doorRushed: false, boardDone: false }, this.dwellTimes(T0, dep));\n    this.dwell.doorsOpen = false;\n    this.bus.emit('doors', { open: false, at: this.dwell.doorsAt });\n    this.stats.stops++;\n    this.recordCheckpoint('stop');\n  }\n\n  stepDwell(dt) {\n    const d = this.dwell, now = this.clock(), x = d.x;\n    if (!d) return;\n    if (!d.doorsOpen && now >= d.doorsAt) { d.doorsOpen = true; this.bus.emit('doors', { open: true }); this.bus.emit('chime', 'open'); }\n    if (!d.melodyDone && now >= d.melodyAt) { d.melodyDone = true; this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai' }); this.bus.emit('pa', { id: x.id, kind: 'depart' }); }\n    if (d.doorsOpen && d.melodyDone && !d.closed && now >= d.closeAt) {\n      d.closed = true; d.doorsOpen = false; this.bus.emit('doors', { open: false }); this.bus.emit('chime', 'close');\n      this.bus.emit('buzzer');\n    }\n    if (d.closed && !d.pilotLit && now >= d.pilotAt) { d.pilotLit = true; this.bus.emit('pilot'); this.bus.emit('ready'); this.onPilot(); }\n    if (d.pilotLit && !this.departed && now >= d.signalAt) {\n      if (x.startSig) this.readySignals.add(x.startSig.id);\n      this.openCall('departure');\n    }\n  }\n  onPilot() {\n    const x = this.stops[this.stopIdx];\n    if (x && x.startSig) this.readySignals.add(x.startSig.id);\n    this.departed = false; this.firstPowerDone = false;\n    this.recordCheckpoint('depart');\n  }\n\n  // ---- the judgment table (section 4.6) ----\n  judgeStop(err) {\n    const W = DH.TUNING.stopWindow * this.D.win;\n    if (err <= 0.10 * W) return 'PERFECT HALO!';\n    if (err <= 0.30 * W) return 'GREAT!';\n    if (err <= 0.70 * W) return 'GOOD';\n    if (err <= 1.00 * W) return 'OK';\n    return null;\n  }\n  stoppedJudgment(x) {\n    const err = this.train.s - x.target;   // + is past the mark (the front)\n    const T = this.train;\n    const sm = this.smoothOK();\n    const W = DH.TUNING.stopWindow * this.D.win;\n    x.attempts++;\n    if (Math.abs(err) > 50) return null;\n    if (err >= -1.0 * W && err <= 1.0 * W) return 'ok';\n    if (err < -1.0 * W && err >= -5) return 'short';\n    if (err < -5) return 'moveup';\n    if (err > 1.0 * W && err <= 5) return 'over';\n    return 'overmark';\n  }\n  smoothOK() { return this.lastDecel !== undefined && Math.abs(this.lastDecel) <= 1.0 && !this.ebWithin100; }\n\n  /** the stop judgment at standstill; returns the label and the points, applies the Halo Time and score */\n  judgeAt(x) {\n    const T = this.train, err = T.s - x.target, cls = this.stoppedJudgment(x), D = this.D;\n    const W = DH.TUNING.stopWindow * D.win;\n    let label = null, pts = 0, halo = 0;\n    if (cls === 'ok') {\n      if (err <= 0.10 * W) { label = 'PERFECT HALO!'; halo = 5; pts = 1000; this.stats.perfect++; }\n      else if (err <= 0.30 * W) { label = 'GREAT!'; halo = 3; pts = 700; this.stats.great++; }\n      else if (err <= 0.70 * W) { label = 'GOOD'; halo = 1; pts = 400; this.stats.good++; }\n      else { label = 'OK'; halo = 0; pts = 200; this.stats.ok++; }\n      halo *= 1; pts *= 1;\n    } else if (cls === 'short') {\n      // a short stop: up to 6 s to creep up to the mark and re-stop, each re-stop costs a second\n      if (x.restops < 3 && !x.shortSince) { x.shortSince = this.t; this.bus.emit('short', { m: -err }); this.setSubtitle('Hoshino', 'Short. Ease forward to the mark.'); x.shortCountdown = 6; return null; }\n      label = 'SHORT'; halo = Math.round(err) * 1 * D.pen; pts = 0;\n      this.stats.short = (this.stats.short || 0) + 1;\n    } else if (cls === 'moveup') {\n      return null;   // the doors stay shut until it's up to the mark\n    } else if (cls === 'over') {\n      label = 'OVERRUN!'; halo = -Math.abs(err) * DH.TUNING.overrunCost * D.pen; pts = 0; this.stats.overruns++;\n    } else if (cls === 'overmark') {\n      label = 'OVER THE MARK'; halo = -10 * D.pen; pts = -300;\n      this.backup = { target: x.target, from: T.s, x };\n      this.addTime(halo, label); this.addScore(pts); this.judgments.push({ label, t: this.t });\n      return null;\n    }\n    if (label !== null) {\n      this.addTime(halo, label);\n      this.addScore(pts);\n      this.judgments.push({ label, t: this.t, halo, pts, err, sub: this.stats.stops + 1 });\n      x.label = label; x.err = err;\n      if (label === 'SHORT') this.stats.short = this.stats.short || 0;\n      if (cls === 'ok' || cls === 'over' || cls === 'short' || cls === 'moveup') {\n        // the arrival against the timetable\n        this.judgeArrival(x);\n        if (this.smoothOK()) { this.addTime(2, 'SMOOTH!'); this.addScore(300); this.stats.smooth++; this.judgments.push({ label: 'SMOOTH!', t: this.t, halo: 2, pts: 300 }); }\n      }\n      x.judged = true; x.done = true;\n    }\n    return label;\n  }\n  judgeArrival(x) {\n    if (x.arrival === null || x.arrival === undefined) return;\n    const d = this.clock() - x.arrival, W = DH.TUNING.onTimeWindow;\n    if (Math.abs(d) <= W) { this.addTime(3, 'ON TIME!'); this.addScore(500); this.stats.onTime++; this.judgments.push({ label: 'ON TIME!', t: this.t, halo: 3, pts: 500 }); }\n    else if (d > W) { const h = -DH.TUNING.lateCost * (d - W) * this.D.pen; this.addTime(h, 'LATE +' + Math.round(d)); this.stats.late++; this.judgments.push({ label: 'LATE +' + Math.round(d), t: this.t, halo: h, pts: 0 }); }\n    else { this.addScore(100); this.stats.early++; this.judgments.push({ label: 'EARLY', t: this.t, halo: 0, pts: 100 }); }\n  }\n\n  // ---- Halo Time, score, comfort, toasts ----\n  addTime(v, why) {\n    if (!v) return;\n    this.halo = DH.clamp(this.halo + v, -1, this.haloMax);\n    this.toast(why, v);\n    if (this.halo <= 0 && !this.gameOver) { this.gameOver = true; this.bus.emit('gameover'); }\n  }\n  addScore(p) { this.score += p; }\n  toast(text, v) { this.toasts.push({ text, v, t: this.t }); if (this.toasts.length > 5) this.toasts.shift(); }\n  setSubtitle(who, text) { this.subtitles.push({ who, text, t: this.t, until: this.t + 4 }); if (this.subtitles.length > 3) this.subtitles.shift(); this.bus.emit('line', { who, text }); }\n  penalty(c) { this.comfort = Math.max(0, this.comfort - c * DH.TUNING.comfortSens); }\n\n  // ---- signals, blocks and ATS ----\n  occupied(a, b, lane) {\n    // a block [a, b) on a lane is occupied when any part of any train is in it\n    const tr = this.train, lanes = this.laneOfPlayer === undefined ? 'A' : this.laneOfPlayer;\n    if (lane === lanes && tr.s > a && tr.rear < b) return true;\n    for (const o of this.others) {\n      if (o.done || o.lane !== lane) continue;\n      const [lo, hi] = o.span();\n      if (hi > a && lo < b) return true;\n    }\n    return false;\n  }\n  /** the aspect of a signal: from the clear blocks ahead of it on its track (section 4.4) */\n  aspectOf(g) {\n    if (g.kind === 'shunt') return 'R';\n    if (g.forced) return g.forced;\n    if (g.kind === 'start' && !this.readySignals.has(g.id)) return 'R';\n    const idx = this.signals.indexOf(g);\n    const next = (i) => (this.signals[i + 1] ? this.signals[i + 1].s : this.route.to);\n    let c = 0;\n    for (let i = idx; i < this.signals.length && c < 3; i++) {\n      const a = this.signals[i].s, b = next(i);\n      if (this.signals[i].track !== g.track) continue;\n      if (this.occupied(a, b, 'A')) break;\n      if (i > idx && this.signals[i].kind === 'start' && !this.readySignals.has(this.signals[i].id)) break;\n      c++;\n    }\n    if (g.obstruct && this.obstruction && this.obstruction.active) return 'R';\n    return ['R', 'Y', 'YG', 'G'][Math.min(c, 3)];\n  }\n  /** the aspect's speed (km/h), for the speed limit in force */\n  aspectSpeed(asp) {\n    if (asp === 'G') return null;\n    return ASPECT_SPEED[asp];\n  }\n\n  /** a signal is sighted when it is within 600 m and visible (or within 180 m in fog) */\n  sighted(g, d) {\n    return d >= 0 && (d <= 600 && (this.fogDist > 400 || d <= 180 || d <= 600)) && d <= (this.fogDist < 400 ? 180 : 600);\n  }\n\n  confirmATS() {\n    if (!this.atsRinging) return false;\n    this.atsRinging = false; this.atsOn = true; this.atsConfirmTimer = 0;\n    this.bus.emit('atsConfirm');\n    this.toast('ATS CONFIRM', 0);\n    return true;\n  }\n  hazardOpen() { return !!(this.obstruction && this.obstruction.active); }\n\n  // ---- speed limits (section 4.5) ----\n  limitInForce() {\n    const T = this.train, R = this.route, front = T.s, rear = T.rear;\n    let lim = R.lineSpeedAt(front) || 85;\n    if (this.stage.lineSpeed) lim = Math.min(lim, this.stage.lineSpeed);\n    for (const L of this.limits) {\n      if (L.end === null) continue;\n      if (front >= L.s && rear <= L.end) lim = Math.min(lim, L.v);   // in force while any of the train is in its section\n      if (front >= L.s && rear > L.end && front <= L.end) lim = Math.min(lim, L.v);\n    }\n    if (this.aspectCap !== null) lim = Math.min(lim, this.aspectCap);\n    if (this.slowOrder) lim = Math.min(lim, this.slowOrder);\n    return lim;\n  }\n\n  // ---- the events (section 4.11): each fires once ----\n  fire(id, data) { if (this.events.has(id)) return false; this.events.add(id); this.fired.push(id); this.bus.emit('event', { id, data }); return true; }\n\n  // ---- the step ----\n  step(dt) {\n    if (this.gameOver || this.finished) return;\n    this.t += dt;\n    if (this.stage.frozenHalo) this.halo = this.stage.frozenHalo;\n    const T = this.train, R = this.route;\n    // the step's order (section 3.4): dynamics, other trains, signals, ATS and limits, events, station, calls, halo\n    if (this.backup) {\n      const b = this.backup;\n      T.v = -5; T.s -= 5 / 3.6 * dt; T.notch = 0;\n      if (T.s <= b.target + 1) { T.s = Math.max(T.s, b.target); T.v = 0; this.backup = null; this.judgeAt(b.x); this.judgeAt; this.pendingDone = true; }\n      return;\n    }\n    const traction = this.pilotLit();\n    const env = { grade: R.gradeAt(T.s), dry: this.dryRail, traction };\n    const sBefore = T.s;\n    if (!this.halted && !this.gameOver) {\n      const r = T.step(dt, env);\n      if (T.slipT > 0 && !this.slipFlag) { this.slipFlag = true; this.stats.slips++; this.penalty(3); this.bus.emit('slip'); this.toast('SLIP', 0); }\n      if (T.slipT <= 0) this.slipFlag = false;\n      if (T.slide && !this.slideFlag) { this.slideFlag = true; this.penalty(3); this.bus.emit('slide'); }\n      if (!T.slide) this.slideFlag = false;\n      if (T.rolled > 1 && !this.rollFlag) { this.rollFlag = true; this.addTime(-2 * this.D.pen, 'ROLLBACK'); this.penalty(5); }\n      if (r) this.lastA = r.a;\n      this.stats.km += Math.max(0, T.s - sBefore) / 1000;\n    }\n    // the decel near standstill, for SMOOTH\n    if (T.v > 0 && T.v <= 3) this.lastDecel = T.a; \n    if (T.eb) this.ebSince = (this.ebSince || 0) + dt; else this.ebSince = 0;\n    this.ebWithin100 = false;\n    for (const o of this.others) o.step(dt, this);\n    this.updateObstruction(dt);\n    this.updateSignals(dt);\n    this.updateATS(dt);\n    this.updateLimits(dt);\n    this.updateCrossings(dt);\n    this.updateHorn(dt);\n    this.updateCalls(dt);\n    this.updateStations(dt);\n    this.updateComfort(dt);\n    this.updateEvents(dt);\n    this.updateHalo(dt);\n    this.toasts = this.toasts.filter(t => this.t - t.t < 2.6);\n    this.judgments = this.judgments.filter(j => this.t - j.t < 1.6 || j === this.judgments[this.judgments.length - 1]);\n    this.subtitles = this.subtitles.filter(s => this.t < s.until);\n    void R;\n  }\n\n  updateSignals(dt) {\n    for (const g of this.signals) {\n      g.aspect = this.aspectOf(g);\n      const d = g.s - this.train.s;\n      if (!this.sighted.has(g.id) && this.sighted1(g, d)) { this.sighted.add(g.id); this.bus.emit('sighted', { id: g.id, aspect: g.aspect }); }\n      // passing a red at speed (the front crosses its signal while R): a SPAD\n      if (this.train.s > g.s && this.lastS !== undefined && this.lastS <= g.s && !this.signalPassed.has(g.id) && g.track === 'A') {\n        this.signalPassed.add(g.id);\n        if (g.aspect === 'R' && g.kind !== 'shunt' && !this.spadLatched.has(g.id)) { this.spad(g); }\n      }\n      if (this.train.s > g.s) this.signalPassed.has(g.id) || (this.signalPassed.add(g.id), 0);\n    }\n    this.lastS = this.train.s;\n    // the aspect speed of the last signal passed (the cap until the next one)\n    let last = null;\n    for (const g of this.signals) if (g.s <= this.train.s) last = g;\n    this.lastPassed = last;\n    this.aspectCap = last ? this.aspectSpeed(last.aspect) : null;\n    if (last && last.aspect === 'G') this.aspectCap = null;\n  }\n  sighted1(g, d) { const fog = this.fogDist < 400; return d >= 0 && d <= (fog ? 180 : 600) && (g.s - this.train.s) <= (fog ? 180 : 600); }\n  spad(g) {\n    this.spadLatched.add(g.id); this.stats.spad++;\n    this.bus.emit('spad', { id: g.id });\n    this.addTime(-20 * this.D.pen, 'SIGNAL PASSED AT DANGER'); this.addScore(-1000); this.penalty(15);\n    this.setSubtitle('Hoshino', 'Stop! That was a red.');\n    this.judgments.push({ label: 'SIGNAL PASSED AT DANGER', t: this.t, halo: -20 * this.D.pen, pts: -1000 });\n    this.train.emergency(); this.bus.emit('eb');\n  }\n\n  updateATS(dt) {\n    const T = this.train;\n    // ATS: passing a beacon 600 m before a red signal rings the bell; it must be confirmed within the time\n    for (const g of this.signals) {\n      if (g.kind === 'shunt') continue;\n      const beacon = g.s - 600;\n      if (T.s >= beacon && (this.lastS0 === undefined || this.lastS0 < beacon) && g.aspect === 'R' && !this.atsLatched.has(g.id)) {\n        this.atsLatched.add(g.id);\n        if (T.s < g.s) { this.atsRinging = true; this.atsTimer = DH.TUNING.atsTime; this.stats.ats++; this.bus.emit('ats', { id: g.id }); this.toast('ATS!', 0); this.setSubtitle('Hoshino', 'ATS! Confirm it. Then brake.'); }\n      }\n    }\n    this.lastS0 = T.s;\n    if (this.atsRinging) {\n      this.atsTimer -= dt;\n      if (this.atsTimer <= 0) { this.atsRinging = false; this.train.emergency(); this.onEmergency(); this.addTime(-3 * this.D.pen, 'ATS EB'); this.stats.ebs++; }\n    }\n    if (this.atsOn) { if (T.v < 15 || (this.lastPassed && this.lastPassed.aspect !== 'R')) this.atsOn = false; }\n    // the speed check: over the limit by more than 10 km/h fires the brake\n    const lim = this.limitInForce(), over = T.v - lim;\n    if (over > 10 && !this.speedAlarm && !T.eb) { this.speedAlarm = true; this.train.emergency(); this.onEmergency(); this.addTime(-3 * this.D.pen, 'ATS EB'); this.toast('ATS!', 0); }\n    if (over < 0) this.speedAlarm = false;\n  }\n\n  updateLimits(dt) {\n    const T = this.train, lim = this.limitInForce(), tol = DH.TUNING.limitTol;\n    const over = T.v - lim;\n    if (over > tol) {\n      if (!this.limitBroken) {\n        this.limitBroken = true; this.stats.limit++;\n        this.limitPeak = over;\n        this.addTime(-2 * this.D.pen, 'LIMIT!'); this.addScore(-300); this.penalty(3); this.bus.emit('limit', { v: lim });\n        this.judgments.push({ label: 'LIMIT!', t: this.t, halo: -2 * this.D.pen, pts: -300 });\n      } else if (over > (this.limitPeak || 0) + 5) {\n        const extra = Math.floor((over - (this.limitPeak || 0)) / 5);\n        this.limitPeak = over;\n        this.addTime(-1 * extra * this.D.pen, 'LIMIT!');\n      }\n    } else if (over < 0 && this.limitBroken) { this.limitBroken = false; this.limitPeak = 0; }\n  }\n\n  // ---- crossings and the obstruction ----\n  updateCrossings(dt) {\n    this.crossingGates = this.crossingGates || {};\n    for (const c of this.route.crossings) {\n      const T = this.train, d = c.s - T.s, onIt = T.s > c.s - 1 && T.rear < c.s + 1;\n      let g = this.crossingGates[c.id] || { state: 'up', t: 0 };\n      if (g.state === 'up' && d > -20 && (d < 500 || (d / Math.max(T.v / 3.6, 1) < 25 && T.v > 1))) { g.state = 'down'; g.t = 0; this.bus.emit('gates', { id: c.id, down: true }); }\n      if (g.state === 'down') { if (T.rear > c.s + 12 || (d > 1500)) { g.state = 'up'; this.bus.emit('gates', { id: c.id, down: false }); } }\n      if (c.special && this.obstruction === null && this.stage.obstruction && this.stage.obstruction.id === c.id && d < 350 && d > -20) {\n        this.obstruction = { id: c.id, active: true, since: this.t, cleared: false };\n        this.bus.emit('obstruction', { id: c.id, on: true });\n        this.fire('obstruction');\n      }\n      g.onIt = onIt;\n      this.crossingGates[c.id] = g;\n    }\n    const ob = this.obstruction;\n    if (ob && ob.active) {\n      const c = this.route.crossings.find(x => x.id === ob.id), T = this.train;\n      if (c && T.s > c.s - 2 && T.rear < c.s + 2 && !ob.passed) {\n        // into the blocked crossing: an emergency stop too late\n        ob.passed = true; this.addTime(-3 * this.D.pen, 'HAZARD'); this.addScore(-200); this.bus.emit('hazard');\n        T.emergency(); this.onEmergency();\n      }\n      if (T.v === 0 && c && T.s < c.s - 3 && !ob.counted) {\n        ob.counted = true; ob.stoppedAt = this.t;\n        this.addTime(5, 'HAZARD AVOIDED'); this.addScore(800); this.stats.hazard = (this.stats.hazard || 0) + 1;\n        this.judgments.push({ label: 'HAZARD AVOIDED', t: this.t, halo: 5, pts: 800 });\n        this.setSubtitle('Mika', 'The crossing alarm! Something is on the tracks!');\n      }\n      if (ob.stoppedAt !== undefined && this.t - ob.stoppedAt > 12) { ob.active = false; this.bus.emit('obstruction', { id: ob.id, on: false }); }\n    }\n  }\n  updateObstruction(dt) { void dt; }\n\n  // ---- the horn (section 4.7) ----\n  setHorn(on) {\n    const H = this.horn;\n    if (on && !H.held) { H.held = true; H.tHeld = 0; this.bus.emit('horn', { on: true }); }\n    if (!on && H.held) { H.held = false; this.bus.emit('horn', { on: false }); }\n  }\n  updateHorn(dt) {\n    const H = this.horn, T = this.train;\n    if (H.held) H.tHeld += dt;\n    for (const h of this.route.horns) {\n      const inZone = T.s >= h.s && T.s < h.s + h.zone;\n      const key = 'horn' + h.s;\n      if (inZone && H.held && H.tHeld >= 0.5 && !H.sounded.has(key)) {\n        H.sounded.add(key); this.stats.horn++;\n        this.addTime(1, 'HORN +1'); this.addScore(100); this.judgments.push({ label: 'HORN +1', t: this.t, halo: 1, pts: 100 });\n        this.bus.emit('hornOK', { s: h.s });\n      }\n      if (!inZone && T.s >= h.s + h.zone && !H.sounded.has(key) && !H.missed?.has?.(key)) {\n        H.missed = H.missed || new Set(); H.missed.add(key);\n        if (this.difficulty !== 'easy') this.addTime(-1 * this.D.pen, 'NO HORN');\n      }\n    }\n    if (H.held && this.horn.lastHeld) void 0;\n    this.horn.lastHeld = H.held;\n    // the workers wave when they hear the horn\n    for (const w of this.route.workers || []) {\n      if (H.held && T.s > w.s - 300 && T.s < w.until) this.bus.emit('workersHeard', { s: w.s });\n    }\n  }\n\n  // ---- the calls (section 4.7) ----\n  openCall(kind) { this.callOpen = { kind, opened: this.t, made: false, early: false }; this.bus.emit('callOpen', { kind }); }\n  call() {\n    const T = this.train;\n    // departure call: its own window\n    if (this.callOpen && this.callOpen.kind === 'departure') {\n      const c = this.callOpen; c.made = true; this.callOpen = null;\n      const great = !!c.early || !this.firstPowerDone;\n      this.scoreCall(great, 'departure');\n      return { kind: 'departure', great };\n    }\n    // the nearest open point ahead: 30 to 180 m; GREAT between 60 and the sweet spot's far edge\n    let best = null, bd = 1e9;\n    for (const c of this.calls) {\n      if (c.called) continue;\n      const d = c.s - T.s;\n      if (d > 30 && d <= 180 && d < bd) {\n        if (c.kind === 'signal' && !this.sighted.has(c.sig)) continue;\n        best = c; bd = d;\n      }\n    }\n    if (!best) { this.bus.emit('callMiss'); return null; }\n    best.called = true;\n    const great = bd >= 60 && bd <= DH.TUNING.callGreat;\n    this.scoreCall(great, best.kind, best);\n    return { kind: best.kind, great, point: best };\n  }\n  scoreCall(great, kind, point) {\n    this.stats.calls++;\n    if (great) { this.stats.callsGreat++; this.addTime(0.5, 'CALL GREAT'); this.addScore(100); }\n    else { this.addScore(50); this.toast('CALL', 0); }\n    this.bus.emit('call', { kind, great, point: point || null });\n    this.judgments.push({ label: great ? 'CALL GREAT' : 'CALL', t: this.t, halo: great ? .5 : 0, pts: great ? 100 : 50 });\n  }\n  updateCalls(dt) {\n    // auto-calls (assist): make the call at the sweet spot, without points\n    if (this.opts.autoCalls) for (const c of this.calls) {\n      if (c.called) continue;\n      const d = c.s - this.train.s;\n      if (d <= DH.TUNING.callGreat && d > 60 && (c.kind !== 'signal' || this.sighted.has(c.sig))) { c.called = true; this.bus.emit('call', { kind: c.kind, great: true, auto: true, point: c }); }\n    }\n    if (this.callOpen && this.callOpen.kind === 'departure' && !this.callOpen.made && this.t - this.callOpen.opened > 20) this.callOpen = null;\n  }\n\n  // ---- stations: the approach, the stop, the miss (section 4.6) ----\n  updateStations(dt) {\n    const T = this.train;\n    if (this.dwell) {\n      this.stepDwell(dt);\n      // a pass-through or the last stop ends the stage once its doors have closed and its departure is done\n      return;\n    }\n    if (this.shortCountdown !== undefined) void 0;\n    const x = this.stops[this.stopIdx];\n    if (!x) { if (this.stopIdx >= this.stops.length && !this.finished && this.stage.endOnLastStop !== false) this.stageEnd(); return; }\n    const err = T.s - x.target, moved = T.s;\n    // judgment at standstill\n    if (!x.judged && Math.abs(T.v) < 0.05 && Math.abs(err) <= 50 && err > -50) {\n      if (x.shortSince !== undefined || (err >= -1.01 * DH.TUNING.stopWindow * this.D.win && err <= 50)) {\n        // stopped inside the window: judge it (a short one waits for the creep)\n        const label = this.judgeAt(x);\n        if (label || (x.judged)) { this.beginDwell(x, this.clock()); this.stopIdx++; this.dwellNext = true; }\n        else if (this.backup) { /* back-up in progress */ }\n        else if (x.shortCountdown !== undefined) { x.shortCountdown -= dt; if (x.shortCountdown <= 0) { x.shortCountdown = undefined; const lab = this.judgeAt(Object.assign(x, { forceShort: true })); void lab; this.beginDwell(x, this.clock()); this.stopIdx++; } }\n      }\n    }\n    if (!x.judged && err > 5 && Math.abs(T.v) < 0.05 && !this.backup) { /* moving up or overrun over 5 m: the back-up applies */ }\n    // passed the mark without stopping: the stop is missed\n    if (!x.judged && T.s > x.target + 50 && !x.missed) {\n      x.missed = true; x.judged = true; x.done = true;\n      this.addTime(-10 * this.D.pen, 'MISSED STOP'); this.addScore(-300); this.judgments.push({ label: 'MISSED STOP', t: this.t, halo: -10 * this.D.pen, pts: -300 });\n      this.setSubtitle('Hoshino', 'Missed. We were meant to stop there.');\n      this.stopIdx++;\n    }\n    if (x.judged && x.done && this.stopIdx >= this.stops.length) this.stageEnd();\n    void moved;\n  }\n  stageEnd() { if (this.finished) return; this.finished = true; this.recordCheckpoint('end'); this.bus.emit('stageEnd'); }\n  smoothAfterStop() { return true; }\n\n  // ---- comfort (section 4.10) ----\n  updateComfort(dt) {\n    const T = this.train;\n    if (T.jerk && Math.abs(T.jerk) > 80 && T.v > 2) { this.jerkWarn = (this.jerkWarn || 0) + dt; }\n    if (T.eb && !this.ebComfortHit) { this.ebComfortHit = true; this.penalty(15); }\n    if (!T.eb) this.ebComfortHit = false;\n    if (this.lastNotchT !== undefined && this.lastNotch !== undefined) void 0;\n    if (Math.abs(T.a) < 1.5 && T.v > 1) this.comfortRecover += dt;\n    if (this.comfortRecover >= 8) { this.comfortRecover = 0; this.comfort = Math.min(100, this.comfort + 1); }\n  }\n\n  // ---- events: data-driven per stage (section 4.11) ----\n  updateEvents(dt) {\n    const T = this.train, evs = this.stage.events || [];\n    for (const e of evs) {\n      if (this.events.has(e.id)) continue;\n      let go = false;\n      if (e.at !== undefined && T.s >= e.at) go = true;\n      if (e.clock !== undefined && this.clock() >= DH.parseClock(e.clock)) go = true;\n      if (e.stop && this.dwell && this.dwell.x && this.dwell.x.id === e.stop) go = true;\n      if (go) this.runEvent(e);\n    }\n  }\n  runEvent(e) {\n    this.fire(e.id, e);\n    switch (e.type) {\n      case 'oncoming': {\n        const lane = e.lane || 'B', s = this.train.s + (e.ahead || 1400);\n        this.others.push(new TrainActor({ id: e.id, kind: 'oncoming', train: e.train || 'h8000', lane, dir: -1, s, v: e.v || 80, cars: 6, legs: [{ v: e.v || 80, acc: 4, until: -1e9 }] }));\n        break;\n      }\n      case 'radio': this.setSubtitle(e.who, e.text); this.bus.emit('radio', e); break;\n      case 'tip': this.bus.emit('tip', e); break;\n      case 'doorRush': if (this.dwell && !this.dwell.doorRushed) { this.dwell.doorRushed = true; this.dwell.closeAt += 8; this.dwell.pilotAt += 8; this.dwell.signalAt += 8; this.setSubtitle('Mika', 'One moment please! Doors re-opening!'); this.bus.emit('doorRush'); } break;\n      case 'flash': this.bus.emit('flash', e); break;\n      case 'rival': this.others.push(new TrainActor(e.train)); break;\n      case 'freight': this.others.push(new TrainActor(e.train)); break;\n      case 'workers': this.slowOrder = e.v || 25; this.bus.emit('workers', e); break;\n      case 'fog': this.fogDist = 180; this.bus.emit('fog', e); break;\n      case 'glare': this.bus.emit('glare', e); break;\n      case 'festival': this.bus.emit('festival', e); break;\n      default: this.bus.emit('event', e);\n    }\n  }\n  updateHalo(dt) {\n    if (this.stage.frozenHalo) return;\n    // Halo Time drains nothing: it changes only at events. Reset the step's flags\n    this.ebWithin100 = false;\n  }\n\n  // ---- checkpoints (section 4.9) ----\n  recordCheckpoint(why) {\n    const T = this.train;\n    this.checkpoint = { why, s: T.s, v: 0, clock: this.clock(), halo: this.halo, score: this.score, comfort: this.comfort, stopIdx: this.stopIdx,\n      fired: this.fired.slice(), t: this.t, stats: Object.assign({}, this.stats), judgments: this.judgments.slice(-6) };\n  }\n\n  // ---- what the scenes and the tests read ----\n  snapshot() {\n    const T = this.train, next = this.stops[this.stopIdx] || null;\n    const ahead = this.signals.filter(g => g.s > T.s).slice(0, 3).map(g => ({ id: g.id, dist: Math.round(g.s - T.s), aspect: g.aspect, sighted: this.sighted.has(g.id) }));\n    return {\n      t: this.t, clock: DH.clock(this.clock()), s: T.s, km: T.s / 1000, v: T.v, notch: T.notchName, P: T.P, B: T.B, a: T.a, jerk: T.jerk,\n      eb: T.eb, slip: T.slipT > 0, slide: T.slide, brakeEff: T.B, halo: this.halo, score: this.score, comfort: Math.round(this.comfort),\n      limit: this.limitInForce(), nextStop: next ? { id: next.id, dist: Math.round(next.target - T.s), arr: next.arr || null, target: next.target } : null,\n      signals: ahead, lastJudgment: this.judgments.length ? this.judgments[this.judgments.length - 1] : null,\n      events: this.fired.slice(), doors: !!(this.dwell && this.dwell.doorsOpen), pilot: this.pilotLit(), ats: { ringing: this.atsRinging, confirmed: this.atsOn },\n      dwell: this.dwell ? { phase: this.dwell.melodyDone ? 'melody' : 'doors', closed: this.dwell.closed, pilot: this.dwell.pilotLit } : null,\n      stopped: Math.abs(T.v) < 0.05, finished: this.finished, gameOver: this.gameOver, stats: Object.assign({}, this.stats), weather: this.weather, fogDist: this.fogDist,\n      call: this.callOpen ? this.callOpen.kind : null, obstruction: this.obstruction ? this.obstruction.active : false, backup: !!this.backup, phase: this.phase,\n      difficulty: this.difficulty, others: this.others.map(o => ({ id: o.id, s: Math.round(o.s), v: Math.round(o.v), lane: o.lane })), toasts: this.toasts.map(t => t.text)\n    };\n  }\n}\nDH.Sim = Sim;\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PGPiGQLrGwipMHgfws35ef","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/31-sim.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"62afba44-9cc3-4b84-b285-1437007945f0","timestamp":"2026-11-04T12:14:53.016Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/31-sim.js","content":"/* Densha de Halo! · 31-sim: the world of a stage, stepped at 1/120 s. Pure: no drawing, no sound, no engine.\n * It owns the train (30-train), the signals and blocks, the other trains, the limits, ATS, the stops, the dwell and the\n * departure sequence, the timetable and the clock, Halo Time, the score and comfort, the calls and the horn, and the events.\n * The scenes read it through snapshot() and send it commands through cmd(). Rules: section 4.4 to 4.11. */\n(() => {\n'use strict';\nconst DH = window.DH;\n\nconst DIFF = {\n  easy: { name: 'Easy', grace: 40 / 25, win: 1.5, pen: 0.5, guide: true, calls: 'auto?' },\n  normal: { name: 'Normal', grace: 1, win: 1.0, pen: 1.0 },\n  expert: { name: 'Expert', grace: 15 / 25, win: 0.7, pen: 1.5 }\n};\nDH.DIFF = DIFF;\nconst ASPECT_SPEED = { G: null, YG: 65, Y: 45, YY: 25, R: 0 };   // G means the line speed\nDH.ASPECT_SPEED = ASPECT_SPEED;\n\n/* the aspect a 4-lamp head shows from the clear blocks ahead (section 4.4): 0 -> R, 1 -> Y, 2 -> YG, 3+ -> G */\nconst LAMPS = { R: [0, 0, 1, 0], Y: [1, 0, 0, 0], YG: [1, 1, 0, 0], G: [0, 1, 0, 0], YY: [1, 0, 0, 1] };\nDH.LAMPS = LAMPS;\n\n/* a train that is not the player's: an oncoming train, a freight, a rival. Its legs are a script; it moves at a set speed\n * (its own lag-free model; it never affects the player's train except by occupying blocks on its own lane) */\nclass TrainActor {\n  constructor(o) {\n    Object.assign(this, { id: o.id, kind: o.kind || 'other', spec: DH.TRAINS[o.train || 'freight'], lane: o.lane || 'B', dir: o.dir || 1,\n      s: o.s, v: o.v || 0, cars: o.cars || 4, legs: (o.legs || []).slice(), leg: 0, wait: 0, livery: o.livery || null, clockAt: o.clockAt || null, done: false, log: [] });\n    this.cars = this.cars || (this.spec ? this.spec.cars : 4);\n    this.nose = o.nose || '#ffffff';\n  }\n  get length() { return this.cars * 20; }\n  get rear() { return this.dir > 0 ? this.s - this.length : this.s + this.length; }\n  /** the segment spans the train covers: [lo, hi] in route metres */\n  span() { return this.dir > 0 ? [this.rear, this.s] : [this.s, this.rear]; }\n  step(dt, world) {\n    if (this.done) return;\n    if (this.clockAt !== null && world.clock() < this.clockAt) return;\n    if (this.leg >= this.legs.length) { this.v = Math.max(0, this.v - 5 * dt); this.s += this.dir * this.v / 3.6 * dt; this.done = this.v === 0 && !this.legs.length; return; }\n    const L = this.legs[this.leg];\n    if (L.lane) this.lane = L.lane;\n    if (this.wait > 0) { this.wait -= dt; this.v = 0; if (this.wait <= 0) this.leg++; return; }\n    const target = L.v, acc = L.acc || 4;   // km/h/s\n    this.v += DH.clamp(target - this.v, -acc * dt, acc * dt);\n    if (L.stopAt !== undefined) {\n      const remain = (L.stopAt - this.s) * this.dir;   // metres to the stop, along the direction of travel\n      if (remain <= 0.02 || (this.v > 0 && remain < this.v / 3.6 * this.v / 3.6 / (2 * acc / 3.6) + 0.02 && L.v === 0)) {\n        this.v = 0; this.s = L.stopAt; this.wait = L.dwell || 0.05; if (!L.dwell) this.leg++;\n        return;\n      }\n    }\n    this.s += this.dir * this.v / 3.6 * dt;\n    if (L.until !== undefined && (this.s - L.until) * this.dir >= 0) this.leg++;\n  }\n}\nDH.TrainActor = TrainActor;\n\n/* the sim: built from a stage and a route */\nclass Sim {\n  constructor(stage, route, opts = {}) {\n    this.stage = stage; this.route = route; this.opts = opts;\n    this.difficulty = opts.difficulty || 'normal'; this.D = DIFF[this.difficulty];\n    this.t = 0;                     // stage time (s), paused with the game\n    this.events = new Set(); this.fired = [];\n    this.bus = new DH.Bus();\n    this.score = 0; this.comfort = 100; this.comfortRecover = 0;\n    this.halo = 0; this.haloStart = 0; this.haloMax = 99;\n    this.log = [];                   // judgments and penalties, for the results and the story\n    this.toasts = []; this.judgments = []; this.subtitles = [];\n    this.stats = { stops: 0, perfect: 0, great: 0, good: 0, ok: 0, onTime: 0, late: 0, early: 0, smooth: 0, calls: 0, callsGreat: 0, horn: 0, overruns: 0, slips: 0, ats: 0, spad: 0, limit: 0, ebs: 0, km: 0 };\n    this.maxPoints = 0; this.maxStat = { stops: 0, onTime: 0, smooth: 0, calls: 0, horn: 0, hazard: 0 };\n    this.gameOver = false; this.finished = false; this.results = null;\n    this.lastCall = null; this.callOpen = null;\n    this.sighted = new Set(); this.atsLatched = new Set(); this.spadLatched = new Set(); this.limitArmed = new Map();\n    this.station = null; this.stopIdx = 0; this.phase = 'run';\n    this.dwell = null; this.departed = false;\n    this.readySignals = new Set(); this.signalPassed = new Set();\n    this.weather = stage.weather || 'clear'; this.fogDist = 900; this.hour = stage.hour || 12;\n    this.lineLimit = null; this.aspectCap = null; this.lastAspect = 'G';\n    this.horn = { held: false, zoneFrom: null, sounded: new Set(), tHeld: 0 };\n    this.atsRinging = false; this.atsConfirmTimer = 0; this.atsOn = false; this.speedAlarm = false;\n    this.backup = null; this.obstruction = null; this.rollbackWarn = 0;\n    this.checkpoint = null;\n    this.halted = false;\n    this.spec = DH.TRAINS[stage.train || 'h8000'];\n    this.train = new DH.Train(this.spec, { s: opts.s0 !== undefined ? opts.s0 : (stage.startS || 0) });\n    this.train.dir = 1;\n    this.train.cars = stage.cars || 6;\n    this.dryRail = this.weather !== 'rain';\n    this.others = [];\n    this.setup();\n  }\n\n  // ---- setup ----\n  setup() {\n    const st = this.stage, R = this.route;\n    this.clockOffset = DH.parseClock(st.startClock || '06:40:00');\n    // the stops of the stage, in route order: each stop is a station with its timetable\n    this.stops = (st.stops || []).map(x => Object.assign({}, x, { st: R.stationById(x.id), target: 0 }));\n    for (const x of this.stops) {\n      const cars = this.train.cars;\n      const target = R.stopOf(x.id, cars) !== undefined ? R.stopOf(x.id, cars) : (x.st && x.st.stops ? Object.values(x.st.stops)[0] : 0);\n      x.target = target; x.arrS = target;\n      x.arrival = x.arr ? DH.parseClock(x.arr) : null; x.departure = x.dep ? DH.parseClock(x.dep) : null;\n      x.judged = false; x.attempts = 0; x.restops = 0; x.done = false; x.missed = false;\n      x.start = x.st ? x.st.start : x.target;\n      x.startSig = null;\n      // its departure signal: the first start signal in the 400 m past its platform\n      if (x.st) x.startSig = R.signals.find(g => g.kind === 'start' && g.s >= x.st.end - 5 && g.s <= x.st.end + 420) || null;\n    }\n    this.passes = (st.passes || []).map(p => Object.assign({}, p, { at: R.stationById(p.id) ? R.stationById(p.id).start : p.at }));\n    this.endS = st.endS !== undefined ? st.endS : (this.stops.length ? this.stops[this.stops.length - 1].target : this.train.s);\n    // the blocks and signals, ordered\n    this.signals = R.signals.slice().sort((a, b) => a.s - b.s);\n    for (const g of this.signals) g.aspect = 'R';\n    // the other trains from the stage's list\n    for (const o of (st.trains || [])) this.others.push(new TrainActor(o));\n    this.limits = R.limits.slice();\n    this.calls = [];\n    this.buildCalls();\n    // the initial state of the station the train starts at: doors open, the dwell's clock running from the stage start\n    if (st.startDwell) this.startDwell(st.startDwell);\n    this.train.v = 0;\n    this.applyWeather();\n    this.recordCheckpoint('start');\n  }\n  applyWeather() {\n    const w = this.weather;\n    this.dryRail = w !== 'rain';\n    this.fogDist = w === 'fog' ? 180 : 900;\n    if (this.stage.fogDist) this.fogDist = this.stage.fogDist;\n  }\n  buildCalls() {\n    const R = this.route, add = (o) => this.calls.push(Object.assign({ called: false, grade: null, key: o.id + '@' + o.s }, o));\n    for (const g of this.signals) {\n      if (g.kind === 'shunt' || g.kind === 'block' || g.kind === 'home' || g.kind === 'start') add({ s: g.s, id: g.id, kind: 'signal', sig: g.id });\n    }\n    for (const L of this.limits) add({ s: L.s, id: 'lim' + L.s, kind: 'limit', v: L.v });\n    for (const h of R.horns) add({ s: h.s, id: 'horn' + h.s, kind: 'horn' });\n    for (const x of this.stops) if (x.st) add({ s: x.st.start - 400, id: 'app' + x.id, kind: 'approach', stopId: x.id });\n    for (const c of R.crossings) if (c.special === false) add({ s: c.s, id: 'cross' + c.id, kind: 'crossing', optional: true });\n    for (const w of R.workers || []) add({ s: w.s, id: 'work' + w.s, kind: 'workers' });\n  }\n\n  // ---- the clock and time ----\n  clock() { return this.clockOffset + this.t; }\n  now() { return this.clock(); }\n\n  // ---- commands (from the controller, the keyboard, the autopilot) ----\n  cmd(name, val) {\n    const T = this.train, out = {};\n    switch (name) {\n      case 'power':\n        if (this.halted) break;\n        if (!this.pilotLit() && !T.eb && T.notch >= 0) { if (T.v === 0 && this.phase !== 'run') { this.bus.emit('buzz', 'doors'); } }\n        if (!this.pilotLit() && T.notch >= 0 && T.v === 0 && !T.eb) { this.note('doors'); T.notch = Math.min(T.notch + 1, T.spec.notchesP); break; }\n        if (T.power()) { this.bus.emit('notch', { name: T.notchName, dir: 1 }); if (!this.firstPowerDone) this.onFirstPower(); }\n        break;\n      case 'brake': if (T.brake()) this.bus.emit('notch', { name: T.notchName, dir: -1 }); break;\n      case 'neutral': if (!T.eb) { T.neutral(); this.bus.emit('notch', { name: 'N', dir: 0 }); } break;\n      case 'eb': if (!T.eb) { T.emergency(); this.onEmergency(); } break;\n      case 'ebRelease': break;\n      case 'ats': this.confirmATS(); break;\n      case 'horn': this.setHorn(!!val); break;\n      case 'call': return this.call();\n      case 'backup': break;\n      default: break;\n    }\n    return out;\n  }\n  note(kind) { this.bus.emit('note', kind); }\n  onFirstPower() { this.firstPowerDone = true; if (this.callOpen && this.callOpen.kind === 'departure' && !this.callOpen.made) this.callOpen.early = true; }\n  onEmergency() {\n    if (this.dwell || this.phase !== 'run') return;\n    this.stats.ebs++;\n    if (!this.hazardOpen()) { this.addTime(-3 * this.D.pen, 'EMERGENCY'); this.addScore(-200); }\n    this.bus.emit('eb');\n  }\n\n  // ---- the stop and dwell phase machine ----\n  get pilot() { return this.dwell ? this.dwell.pilotLit : false; }\n  pilotLit() { return this.dwell ? !!this.dwell.pilotLit : true; }\n\n  startDwell(o) {\n    const x = this.stops[this.stopIdx] || {};\n    const T0 = DH.parseClock(o.t0 || this.stage.startClock || '06:40:00');\n    this.dwell = { T0, phase: 'dwell', x, ...this.dwellTimes(T0, x.departure !== null ? x.departure : T0 + 25), pilotLit: false, doorsOpen: true, closed: false, melodyDone: false, doorRush: false };\n    this.train.v = 0; this.phase = 'dwell';\n    this.bus.emit('doors', { open: true });\n    this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai', at: this.dwell.melodyAt });\n  }\n  dwellTimes(T0, dep) {\n    const min = DH.TUNING.dwell;\n    const melodyAt = Math.max(dep - 9, T0 + 6);\n    const closeAt = Math.max(melodyAt + 7, dep - 4, T0 + min);\n    const pilotAt = closeAt + 1.5;\n    const signalAt = Math.max(dep - 3, pilotAt);\n    return { melodyAt, closeAt, pilotAt, signalAt, dep, doorsAt: T0 + 1 };\n  }\n\n  /** the train has stopped at its target and been judged: open the doors and start the dwell */\n  beginDwell(x, T0) {\n    this.phase = 'dwell';\n    const dep = x.departure !== null ? x.departure : T0 + 20;\n    this.dwell = Object.assign({ T0, x, phase: 'dwell', pilotLit: false, doorsOpen: false, closed: false, melodyDone: false, doorRushed: false, boardDone: false }, this.dwellTimes(T0, dep));\n    this.dwell.doorsOpen = false;\n    this.bus.emit('doors', { open: false, at: this.dwell.doorsAt });\n    this.stats.stops++;\n    this.recordCheckpoint('stop');\n  }\n\n  stepDwell(dt) {\n    const d = this.dwell, now = this.clock(), x = d.x;\n    if (!d) return;\n    if (!d.doorsOpen && now >= d.doorsAt) { d.doorsOpen = true; this.bus.emit('doors', { open: true }); this.bus.emit('chime', 'open'); }\n    if (!d.melodyDone && now >= d.melodyAt) { d.melodyDone = true; this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai' }); this.bus.emit('pa', { id: x.id, kind: 'depart' }); }\n    if (d.doorsOpen && d.melodyDone && !d.closed && now >= d.closeAt) {\n      d.closed = true; d.doorsOpen = false; this.bus.emit('doors', { open: false }); this.bus.emit('chime', 'close');\n      this.bus.emit('buzzer');\n    }\n    if (d.closed && !d.pilotLit && now >= d.pilotAt) { d.pilotLit = true; this.bus.emit('pilot'); this.bus.emit('ready'); this.onPilot(); }\n    if (d.pilotLit && !this.departed && now >= d.signalAt) {\n      if (x.startSig) this.readySignals.add(x.startSig.id);\n      this.openCall('departure');\n    }\n  }\n  onPilot() {\n    const x = this.stops[this.stopIdx];\n    if (x && x.startSig) this.readySignals.add(x.startSig.id);\n    this.departed = false; this.firstPowerDone = false;\n    this.recordCheckpoint('depart');\n  }\n\n  // ---- the judgment table (section 4.6) ----\n  judgeStop(err) {\n    const W = DH.TUNING.stopWindow * this.D.win;\n    if (err <= 0.10 * W) return 'PERFECT HALO!';\n    if (err <= 0.30 * W) return 'GREAT!';\n    if (err <= 0.70 * W) return 'GOOD';\n    if (err <= 1.00 * W) return 'OK';\n    return null;\n  }\n  stoppedJudgment(x) {\n    const err = this.train.s - x.target;   // + is past the mark (the front)\n    const T = this.train;\n    const sm = this.smoothOK();\n    const W = DH.TUNING.stopWindow * this.D.win;\n    x.attempts++;\n    if (Math.abs(err) > 50) return null;\n    if (err >= -1.0 * W && err <= 1.0 * W) return 'ok';\n    if (err < -1.0 * W && err >= -5) return 'short';\n    if (err < -5) return 'moveup';\n    if (err > 1.0 * W && err <= 5) return 'over';\n    return 'overmark';\n  }\n  smoothOK() { return this.lastDecel !== undefined && Math.abs(this.lastDecel) <= 1.0 && !this.ebWithin100; }\n\n  /** the stop judgment at standstill; returns the label and the points, applies the Halo Time and score */\n  judgeAt(x) {\n    const T = this.train, err = T.s - x.target, cls = this.stoppedJudgment(x), D = this.D;\n    const W = DH.TUNING.stopWindow * D.win;\n    let label = null, pts = 0, halo = 0;\n    if (cls === 'ok') {\n      if (err <= 0.10 * W) { label = 'PERFECT HALO!'; halo = 5; pts = 1000; this.stats.perfect++; }\n      else if (err <= 0.30 * W) { label = 'GREAT!'; halo = 3; pts = 700; this.stats.great++; }\n      else if (err <= 0.70 * W) { label = 'GOOD'; halo = 1; pts = 400; this.stats.good++; }\n      else { label = 'OK'; halo = 0; pts = 200; this.stats.ok++; }\n      halo *= 1; pts *= 1;\n    } else if (cls === 'short') {\n      // a short stop: up to 6 s to creep up to the mark and re-stop, each re-stop costs a second\n      if (x.restops < 3 && !x.shortSince) { x.shortSince = this.t; this.bus.emit('short', { m: -err }); this.setSubtitle('Hoshino', 'Short. Ease forward to the mark.'); x.shortCountdown = 6; return null; }\n      label = 'SHORT'; halo = Math.round(err) * 1 * D.pen; pts = 0;\n      this.stats.short = (this.stats.short || 0) + 1;\n    } else if (cls === 'moveup') {\n      return null;   // the doors stay shut until it's up to the mark\n    } else if (cls === 'over') {\n      label = 'OVERRUN!'; halo = -Math.abs(err) * DH.TUNING.overrunCost * D.pen; pts = 0; this.stats.overruns++;\n    } else if (cls === 'overmark') {\n      label = 'OVER THE MARK'; halo = -10 * D.pen; pts = -300;\n      this.backup = { target: x.target, from: T.s, x };\n      this.addTime(halo, label); this.addScore(pts); this.judgments.push({ label, t: this.t });\n      return null;\n    }\n    if (label !== null) {\n      this.addTime(halo, label);\n      this.addScore(pts);\n      this.judgments.push({ label, t: this.t, halo, pts, err, sub: this.stats.stops + 1 });\n      x.label = label; x.err = err;\n      if (label === 'SHORT') this.stats.short = this.stats.short || 0;\n      if (cls === 'ok' || cls === 'over' || cls === 'short' || cls === 'moveup') {\n        // the arrival against the timetable\n        this.judgeArrival(x);\n        if (this.smoothOK()) { this.addTime(2, 'SMOOTH!'); this.addScore(300); this.stats.smooth++; this.judgments.push({ label: 'SMOOTH!', t: this.t, halo: 2, pts: 300 }); }\n      }\n      x.judged = true; x.done = true;\n    }\n    return label;\n  }\n  judgeArrival(x) {\n    if (x.arrival === null || x.arrival === undefined) return;\n    const d = this.clock() - x.arrival, W = DH.TUNING.onTimeWindow;\n    if (Math.abs(d) <= W) { this.addTime(3, 'ON TIME!'); this.addScore(500); this.stats.onTime++; this.judgments.push({ label: 'ON TIME!', t: this.t, halo: 3, pts: 500 }); }\n    else if (d > W) { const h = -DH.TUNING.lateCost * (d - W) * this.D.pen; this.addTime(h, 'LATE +' + Math.round(d)); this.stats.late++; this.judgments.push({ label: 'LATE +' + Math.round(d), t: this.t, halo: h, pts: 0 }); }\n    else { this.addScore(100); this.stats.early++; this.judgments.push({ label: 'EARLY', t: this.t, halo: 0, pts: 100 }); }\n  }\n\n  // ---- Halo Time, score, comfort, toasts ----\n  addTime(v, why) {\n    if (!v) return;\n    this.halo = DH.clamp(this.halo + v, -1, this.haloMax);\n    this.toast(why, v);\n    if (this.halo <= 0 && !this.gameOver) { this.gameOver = true; this.bus.emit('gameover'); }\n  }\n  addScore(p) { this.score += p; }\n  toast(text, v) { this.toasts.push({ text, v, t: this.t }); if (this.toasts.length > 5) this.toasts.shift(); }\n  setSubtitle(who, text) { this.subtitles.push({ who, text, t: this.t, until: this.t + 4 }); if (this.subtitles.length > 3) this.subtitles.shift(); this.bus.emit('line', { who, text }); }\n  penalty(c) { this.comfort = Math.max(0, this.comfort - c * DH.TUNING.comfortSens); }\n\n  // ---- signals, blocks and ATS ----\n  occupied(a, b, lane) {\n    // a block [a, b) on a lane is occupied when any part of any train is in it\n    const tr = this.train, lanes = this.laneOfPlayer === undefined ? 'A' : this.laneOfPlayer;\n    if (lane === lanes && tr.s > a && tr.rear < b) return true;\n    for (const o of this.others) {\n      if (o.done || o.lane !== lane) continue;\n      const [lo, hi] = o.span();\n      if (hi > a && lo < b) return true;\n    }\n    return false;\n  }\n  /** the aspect of a signal: from the clear blocks ahead of it on its track (section 4.4) */\n  aspectOf(g) {\n    if (g.kind === 'shunt') return 'R';\n    if (g.forced) return g.forced;\n    if (g.kind === 'start' && !this.readySignals.has(g.id)) return 'R';\n    const idx = this.signals.indexOf(g);\n    const next = (i) => (this.signals[i + 1] ? this.signals[i + 1].s : this.route.to);\n    let c = 0;\n    for (let i = idx; i < this.signals.length && c < 3; i++) {\n      const a = this.signals[i].s, b = next(i);\n      if (this.signals[i].track !== g.track) continue;\n      if (this.occupied(a, b, 'A')) break;\n      if (i > idx && this.signals[i].kind === 'start' && !this.readySignals.has(this.signals[i].id)) break;\n      c++;\n    }\n    if (g.obstruct && this.obstruction && this.obstruction.active) return 'R';\n    return ['R', 'Y', 'YG', 'G'][Math.min(c, 3)];\n  }\n  /** the aspect's speed