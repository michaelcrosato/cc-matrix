{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghsRZ7mg6gzCx33PXurE","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":27170,"cache_read_input_tokens":241102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":27170},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"e4eb5d6f-c792-4c26-b8e4-fd4226aa6388","timestamp":"2026-11-04T12:15:19.518Z","request_id":"req_011CghsRYoBPqxdTDmqWjJiM","thinking_duration_ms":24902,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghsRZ7mg6gzCx33PXurE","type":"message","role":"assistant","content":[{"type":"text","text":"The first draft of the sim has bugs I can see on re-reading: the short-stop creep logic can never finish, the back-up path has junk statements, and the SMOOTH check reads a field nothing sets. Patching those one by one would be error-prone, so I'll rewrite the file cleanly."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":27170,"cache_read_input_tokens":241102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":27170},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"03773e0e-6671-403f-90b1-c04b604d5fe0","timestamp":"2026-11-04T12:15:20.014Z","request_id":"req_011CghsRYoBPqxdTDmqWjJiM"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghsRZ7mg6gzCx33PXurE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JGAFCoBzdYVSaGZjiApK1B","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/31-sim.js","content":"/* Densha de Halo! · 31-sim: the world of a stage, stepped at 1/120 s. Pure: no drawing, no sound, no engine.\n * It owns the train (30-train), the signals and blocks, the other trains, the speed limits, ATS, the stops and the dwell\n * and departure sequence, the timetable and the clock, Halo Time, the score and comfort, the calls and the horn, the\n * crossings and the events. Scenes read it through snapshot() and steer it through cmd(). Rules: sections 4.4 to 4.11.\n * Each step runs in the order of section 3.4. Everything that happens is announced on bus ('sound', 'judgment', ...). */\n(() => {\n'use strict';\nconst DH = window.DH;\n\nconst DIFF = {\n  easy: { name: 'Easy', grace: 40 / 25, win: 1.5, pen: 0.5 },\n  normal: { name: 'Normal', grace: 1, win: 1.0, pen: 1.0 },\n  expert: { name: 'Expert', grace: 15 / 25, win: 0.7, pen: 1.5 }\n};\nDH.DIFF = DIFF;\nconst ASPECT_SPEED = { G: null, YG: 65, Y: 45, YY: 25, R: 0 };   // G means the line speed\nDH.ASPECT_SPEED = ASPECT_SPEED;\nconst LAMPS = { R: [0, 0, 1, 0], Y: [1, 0, 0, 0], YG: [1, 1, 0, 0], G: [0, 1, 0, 0], YY: [1, 0, 0, 1] };\nDH.LAMPS = LAMPS;\n\n/* another train: its own speed and legs (no lag model; it never affects the player's train, only the blocks it occupies).\n * A leg: { v (km/h target), acc (km/h/s), until (route s, stop passing it), stopAt (route s, stop there), dwell (s), lane,\n * wait (s before it starts), at (the clock to start at) } */\nclass TrainActor {\n  constructor(o) {\n    this.id = o.id; this.kind = o.kind || 'other'; this.spec = DH.TRAINS[o.train || 'freight'];\n    this.lane = o.lane || 'B'; this.dir = o.dir || 1; this.s = o.s; this.v = o.v || 0;\n    this.cars = o.cars || (this.spec ? this.spec.cars : 4); this.carLen = 20;\n    this.legs = (o.legs || []).map(l => Object.assign({}, l)); this.leg = 0; this.wait = 0;\n    this.clockAt = o.clockAt === undefined ? null : o.clockAt; this.done = false;\n    this.light = o.light || 'tail';\n  }\n  get length() { return this.cars * this.carLen; }\n  get rear() { return this.s - this.dir * this.length; }\n  span() { return this.dir > 0 ? [this.rear, this.s] : [this.s, this.rear]; }\n  step(dt, world) {\n    if (this.done) return;\n    if (this.clockAt !== null && world.clock() < this.clockAt) return;\n    const L = this.legs[this.leg];\n    if (!L) { this.v = Math.max(0, this.v - 6 * dt); this.s += this.dir * this.v / 3.6 * dt; if (this.v === 0) this.done = true; return; }\n    if (L.lane) this.lane = L.lane;\n    if (this.wait > 0) { this.wait -= dt; this.v = 0; if (this.wait <= 0) this.leg++; return; }\n    const acc = L.acc || 4, want = L.v === undefined ? this.v : L.v;\n    this.v += DH.clamp(want - this.v, -acc * dt, acc * dt);\n    if (L.stopAt !== undefined) {\n      const remain = (L.stopAt - this.s) * this.dir;\n      const brake = (this.v / 3.6) ** 2 / (2 * Math.max(acc, .5) / 3.6);   // distance to stop from here, at its decel\n      if (remain <= brake + .05 || remain <= .05) {\n        const k = (this.v / 3.6) ** 2 > 0 ? 1 : 1;\n        void k;\n        if (this.v > 0) { this.v = Math.max(0, this.v - acc * dt * 2); }\n        if (remain <= .05 || this.v <= 0.01) { this.s = L.stopAt; this.v = 0; this.wait = L.dwell || 0; if (!L.dwell) this.leg++; else this.leg++; return; }\n      }\n    }\n    this.s += this.dir * this.v / 3.6 * dt;\n    if (L.until !== undefined && (this.s - L.until) * this.dir >= 0) this.leg++;\n  }\n}\nDH.TrainActor = TrainActor;\n\nclass Sim {\n  constructor(stage, route, opts = {}) {\n    this.stage = stage; this.route = route; this.opts = opts;\n    this.difficulty = opts.difficulty || 'normal'; this.D = DIFF[this.difficulty] || DIFF.normal;\n    this.t = 0; this.clockOffset = DH.parseClock(stage.startClock || '06:40:00');\n    this.bus = new DH.Bus();\n    this.spec = DH.TRAINS[stage.train || 'h8000'];\n    this.cars = stage.cars || 6;\n    this.train = new DH.Train(this.spec, { s: stage.startS || 0 });\n    this.train.cars = this.cars;\n    this.weather = stage.weather || 'clear'; this.dryRail = this.weather !== 'rain';\n    this.fogDist = this.weather === 'fog' ? 180 : 900;\n    this.hour = stage.hour === undefined ? 12 : stage.hour;\n    // scoring and state\n    this.halo = 0; this.haloStart = Math.round(DH.TUNING.graceStart * this.D.grace); this.haloMax = 99;\n    this.score = 0; this.comfort = 100; this.comfortCalm = 0; this.gameOver = false; this.finished = false;\n    this.stats = { stops: 0, perfect: 0, great: 0, good: 0, ok: 0, onTime: 0, late: 0, early: 0, smooth: 0, short: 0, overruns: 0, over: 0,\n      calls: 0, callsGreat: 0, horn: 0, hornMiss: 0, slips: 0, ats: 0, spad: 0, limit: 0, ebs: 0, km: 0, hazard: 0, missed: 0, wrong: 0, rollback: 0 };\n    this.judgments = []; this.toasts = []; this.subtitles = []; this.log = [];\n    this.events = new Set(); this.fired = [];\n    this.sighted = new Set(); this.atsLatched = new Set(); this.spadLatched = new Set(); this.signalPassed = new Set();\n    this.limitBroken = false; this.limitPeak = 0; this.slowOrder = null; this.aspectCap = null;\n    this.atsRinging = false; this.atsTimer = 0; this.atsOn = false; this.speedAlarm = false;\n    this.horn = { held: false, tHeld: 0, sounded: new Set(), missed: new Set() };\n    this.dwell = null; this.backup = null; this.obstruction = null; this.crossingGates = {};\n    this.lastDecel = 0; this.lastEbS = -1e9; this.prevS = this.train.s; this.readySignals = new Set();\n    this.firstPowerDone = false; this.callOpen = null; this.departedFlag = false;\n    this.checkpoint = null;\n    this.setup();\n  }\n\n  // ---- the stage's set-up: stops, signals, calls, the others ----\n  setup() {\n    const st = this.stage, R = this.route;\n    this.stops = (st.stops || []).map(x => {\n      const station = R.stationById(x.id);\n      const target = R.stopOf(x.id, this.cars);\n      const tgt = target !== undefined ? target : (station && station.stops ? Object.values(station.stops)[0] : this.train.s);\n      return Object.assign({}, x, { st: station, target: tgt, arrival: x.arr ? DH.parseClock(x.arr) : null, departure: x.dep ? DH.parseClock(x.dep) : null,\n        judged: false, done: false, restops: 0, shortT: null, startSig: station ? R.signals.find(g => g.kind === 'start' && g.s >= station.end - 5 && g.s <= station.end + 420) || null : null });\n    });\n    this.passes = (st.passes || []).map(p => { const station = R.stationById(p.id); return { id: p.id, at: station ? station.start : p.at, arr: p.at, passed: false }; });\n    this.signals = R.signals.slice().sort((a, b) => a.s - b.s);\n    for (const g of this.signals) g.aspect = 'R';\n    this.others = (st.trains || []).map(o => new TrainActor(o));\n    this.limits = R.limits.slice();\n    this.buildCalls();\n    this.stopIdx = 0;\n    if (st.startStopped) {   // the stage opens with the train standing at its first stop, doors open\n      const first = this.stops[0];\n      this.train.s = first.target; this.train.v = 0; this.stopIdx = 1; first.judged = true; first.done = true;\n      this.beginDwell(first, this.clockOffset, true);\n    }\n    this.prevS = this.train.s;\n    this.recordCheckpoint('start');\n  }\n  buildCalls() {\n    const R = this.route, calls = this.calls = [];\n    const add = (o) => calls.push(Object.assign({ called: false }, o));\n    for (const g of this.signals) add({ s: g.s, id: g.id, kind: 'signal', sig: g.id });\n    for (const L of this.limits) add({ s: L.s, id: 'lim' + L.s, kind: 'limit', v: L.v });\n    for (const h of R.horns) add({ s: h.s, id: 'horn' + h.s, kind: 'horn' });\n    for (const x of this.stops) if (x.st) add({ s: x.st.start - 400, id: 'app' + x.id, kind: 'approach', stopId: x.id });\n    for (const p of this.passes) add({ s: p.at - 400, id: 'pass' + p.id, kind: 'pass' });\n  }\n\n  // ---- the clock and the lever ----\n  clock() { return this.clockOffset + this.t; }\n  pilotLit() { return !this.dwell || this.dwell.pilotLit; }\n  doorsOpen() { return !!(this.dwell && this.dwell.doorsOpen); }\n  cmd(name, val) {\n    const T = this.train;\n    if (this.gameOver || this.finished) return null;\n    switch (name) {\n      case 'power': {\n        if (this.dwell && !this.dwell.pilotLit && T.notch >= 0 && !T.eb) this.bus.emit('note', 'doors');\n        const moved = T.power();\n        if (moved) this.bus.emit('notch', { name: T.notchName, dir: 1 });\n        if (T.eb === false && moved && this.callOpen && this.callOpen.kind === 'departure' && !this.firstPowerDone) this.firstPowerDone = true;\n        return moved;\n      }\n      case 'brake': { const moved = T.brake(); if (moved) this.bus.emit('notch', { name: T.notchName, dir: -1 }); return moved; }\n      case 'neutral': if (!T.eb) { T.neutral(); this.bus.emit('notch', { name: 'N', dir: 0 }); } return true;\n      case 'eb': if (!T.eb) this.emergency(); return true;\n      case 'ats': return this.confirmATS();\n      case 'horn': this.setHorn(!!val); return true;\n      case 'call': return this.call();\n      default: return null;\n    }\n  }\n  emergency() {\n    const T = this.train;\n    if (T.eb) return;\n    T.emergency(); this.stats.ebs++; this.lastEbS = T.s;\n    this.penalty(15);\n    if (!this.hazardOn()) { this.addTime(-3 * this.D.pen, 'EMERGENCY'); this.addScore(-200); }\n    this.bus.emit('eb');\n  }\n  hazardOn() { return !!(this.obstruction && this.obstruction.active && !this.obstruction.passed); }\n\n  // ---- the halo time, score, comfort and the toasts ----\n  addTime(v, why) {\n    if (!v) return;\n    this.halo = Math.min(this.haloMax, this.halo + v);\n    this.toast(why, v);\n    if (this.halo <= 0 && !this.gameOver) { this.halo = 0; this.gameOver = true; this.bus.emit('gameover'); }\n  }\n  addScore(p) { this.score += p; }\n  toast(text, v) { this.toasts.push({ text, v, t: this.t }); if (this.toasts.length > 4) this.toasts.shift(); }\n  judge(label, halo, pts) { this.judgments.push({ label, t: this.t, halo, pts }); this.bus.emit('judgment', { label, halo, pts }); }\n  setSubtitle(who, text) { this.subtitles.push({ who, text, t: this.t, until: this.t + 4.5 }); if (this.subtitles.length > 2) this.subtitles.shift(); this.bus.emit('line', { who, text }); }\n  penalty(c) { this.comfort = Math.max(0, this.comfort - c * DH.TUNING.comfortSens); }\n\n  // ---- signals and blocks (section 4.4) ----\n  occupied(a, b) {\n    const T = this.train;\n    if (T.s > a && T.rear < b) return true;\n    for (const o of this.others) {\n      if (o.done || o.lane !== 'A') continue;\n      const [lo, hi] = o.span(); if (hi > a && lo < b) return true;\n    }\n    return false;\n  }\n  aspectOf(g) {\n    if (g.kind === 'shunt') return 'R';\n    if (g.forced) return g.forced;\n    if (g.kind === 'start' && !this.readySignals.has(g.id)) return 'R';\n    if (g.obstruct && this.hazardOn()) return 'R';\n    const i0 = this.signals.indexOf(g);\n    let c = 0;\n    for (let i = i0; i < this.signals.length && c < 3; i++) {\n      const sg = this.signals[i], nxt = this.signals[i + 1] ? this.signals[i + 1].s : this.route.to;\n      if (this.occupied(sg.s, nxt)) break;\n      if (i > i0 && sg.kind === 'start' && !this.readySignals.has(sg.id)) break;\n      c++;\n    }\n    return ['R', 'Y', 'YG', 'G'][Math.min(c, 3)];\n  }\n  updateSignals() {\n    const T = this.train, prev = this.prevS;\n    for (const g of this.signals) {\n      const prevAsp = g.aspect;\n      g.aspect = this.aspectOf(g);\n      const d = g.s - T.s;\n      const range = this.fogDist < 400 ? 180 : 600;\n      if (!this.sighted.has(g.id) && d >= 0 && d <= range) { this.sighted.add(g.id); this.bus.emit('sighted', { id: g.id, aspect: g.aspect }); }\n      // the front crosses the signal this step: a red at that moment is a SPAD\n      if (prev < g.s && T.s >= g.s && !this.signalPassed.has(g.id)) {\n        this.signalPassed.add(g.id);\n        if (prevAsp === 'R' && g.kind !== 'shunt' && !this.spadLatched.has(g.id)) this.spad(g);\n      }\n    }\n    let last = null;\n    for (const g of this.signals) if (g.s <= T.s) last = g;\n    this.lastPassed = last;\n    this.aspectCap = last && last.aspect !== 'G' ? ASPECT_SPEED[last.aspect] : null;\n  }\n  spad(g) {\n    this.spadLatched.add(g.id); this.stats.spad++;\n    this.addTime(-20 * this.D.pen, 'SIGNAL PASSED AT DANGER'); this.addScore(-1000); this.penalty(15);\n    this.judge('SIGNAL PASSED AT DANGER', -20 * this.D.pen, -1000);\n    this.setSubtitle('Hoshino', 'Stop! That was a red.');\n    this.bus.emit('spad', { id: g.id });\n    this.emergency();\n  }\n  confirmATS() {\n    if (!this.atsRinging) return false;\n    this.atsRinging = false; this.atsOn = true;\n    this.bus.emit('atsConfirm'); this.toast('ATS CONFIRM', 0);\n    return true;\n  }\n  updateATS(dt) {\n    const T = this.train, prev = this.prevS;\n    for (const g of this.signals) {\n      if (g.kind === 'shunt') continue;\n      const beacon = g.s - 600;\n      if (prev < beacon && T.s >= beacon && g.aspect === 'R' && !this.atsLatched.has(g.id)) {\n        this.atsLatched.add(g.id);\n        if (T.s < g.s) {\n          this.atsRinging = true; this.atsTimer = DH.TUNING.atsTime; this.stats.ats++;\n          this.bus.emit('ats', { id: g.id }); this.toast('ATS!', 0);\n          this.setSubtitle('Hoshino', 'ATS. Confirm it, then brake.');\n        }\n      }\n    }\n    if (this.atsRinging) {\n      this.atsTimer -= dt;\n      if (this.atsTimer <= 0) { this.atsRinging = false; this.addTime(-3 * this.D.pen, 'ATS EB'); this.emergency(); }\n    }\n    if (this.atsOn && (T.v < 15 || (this.lastPassed && this.lastPassed.aspect !== 'R' && this.lastPassed.aspect !== 'Y'))) this.atsOn = false;\n    // the speed check: over the limit by more than 10 km/h fires the brake, once per section\n    const lim = this.limitInForce(), over = T.v - lim;\n    if (over > 10 && !this.speedAlarm && !T.eb) { this.speedAlarm = true; this.addTime(-3 * this.D.pen, 'ATS EB'); this.emergency(); }\n    if (over < 0) this.speedAlarm = false;\n  }\n\n  // ---- speed limits (section 4.5) ----\n  limitInForce() {\n    const T = this.train, R = this.route;\n    let lim = R.lineSpeedAt(T.s) || 85;\n    if (this.stage.lineSpeed) lim = Math.min(lim, this.stage.lineSpeed);\n    for (const L of this.limits) {\n      // in force while the front is in its section, and the section lasts until its END board (the rear passes it)\n      if (T.s >= L.s && (L.end === null || T.rear <= L.end || T.s <= L.end)) lim = Math.min(lim, L.v);\n    }\n    if (this.aspectCap !== null) lim = Math.min(lim, this.aspectCap);\n    if (this.slowOrder) lim = Math.min(lim, this.slowOrder);\n    return lim;\n  }\n  updateLimits() {\n    const T = this.train, lim = this.limitInForce(), tol = DH.TUNING.limitTol, over = T.v - lim;\n    if (over > tol) {\n      if (!this.limitBroken) {\n        this.limitBroken = true; this.limitPeak = over; this.stats.limit++;\n        this.addTime(-2 * this.D.pen, 'LIMIT!'); this.addScore(-300); this.penalty(3);\n        this.judge('LIMIT!', -2 * this.D.pen, -300); this.bus.emit('limit', { v: lim });\n      } else if (over > this.limitPeak + 5) {\n        const extra = Math.floor((over - this.limitPeak) / 5); this.limitPeak = over;\n        this.addTime(-extra * this.D.pen, 'LIMIT!');\n      }\n    } else if (over < 0 && this.limitBroken) { this.limitBroken = false; this.limitPeak = 0; }\n  }\n\n  // ---- crossings, gates and the obstruction (section 4.11) ----\n  updateCrossings() {\n    const T = this.train;\n    for (const c of this.route.crossings) {\n      const d = c.s - T.s;\n      let g = this.crossingGates[c.id] || (this.crossingGates[c.id] = { down: false });\n      if (!g.down && d > -20 && (d < 500 || (T.v > 1 && d / (T.v / 3.6) < 25))) { g.down = true; this.bus.emit('gates', { id: c.id, down: true }); }\n      if (g.down && T.rear > c.s + 12) { g.down = false; this.bus.emit('gates', { id: c.id, down: false }); }\n    }\n    const st = this.stage.obstruction;\n    if (st && !this.obstruction) {\n      const c = this.route.crossings.find(x => x.id === st.id);\n      if (c && c.s - T.s < 350 && c.s - T.s > -20) {\n        this.obstruction = { id: st.id, active: true, passed: false, stoppedAt: null, counted: false };\n        this.bus.emit('obstruction', { id: st.id, on: true }); this.fire('obstruction');\n      }\n    }\n    const ob = this.obstruction;\n    if (ob && ob.active) {\n      const c = this.route.crossings.find(x => x.id === ob.id);\n      if (c && !ob.passed && T.s > c.s - 1 && T.rear < c.s + 1) {\n        ob.passed = true; this.addTime(-3 * this.D.pen, 'HAZARD'); this.addScore(-200); this.stats.hazard--; this.bus.emit('hazard');\n        this.emergency();\n      }\n      if (c && !ob.counted && T.v === 0 && T.s < c.s - 3) {\n        ob.counted = true; ob.stoppedAt = this.t;\n        this.addTime(5, 'HAZARD AVOIDED'); this.addScore(800); this.stats.hazard++; this.judge('HAZARD AVOIDED', 5, 800);\n        this.setSubtitle('Mika', 'The crossing alarm! Something is on the tracks!');\n      }\n      if (ob.stoppedAt !== null && this.t - ob.stoppedAt > 12) { ob.active = false; this.bus.emit('obstruction', { id: ob.id, on: false }); }\n    }\n  }\n\n  // ---- the horn (section 4.7) ----\n  setHorn(on) {\n    const H = this.horn;\n    if (on && !H.held) { H.held = true; H.tHeld = 0; this.bus.emit('horn', { on: true }); }\n    if (!on && H.held) { H.held = false; this.bus.emit('horn', { on: false }); }\n  }\n  updateHorn(dt) {\n    const H = this.horn, T = this.train;\n    if (H.held) H.tHeld += dt;\n    for (const h of this.route.horns) {\n      if (h.s < this.stageSpan[0] || h.s > this.stageSpan[1]) continue;\n      const key = 'horn' + h.s, inZone = T.s >= h.s && T.s < h.s + h.zone;\n      if (inZone && H.held && H.tHeld >= 0.5 && !H.sounded.has(key)) {\n        H.sounded.add(key); this.stats.horn++;\n        this.addTime(1, 'HORN +1'); this.addScore(100); this.judge('HORN +1', 1, 100);\n        this.bus.emit('hornOK', { s: h.s });\n      }\n      if (T.s >= h.s + h.zone && !H.sounded.has(key) && !H.missed.has(key)) {\n        H.missed.add(key); this.stats.hornMiss++;\n        if (this.difficulty !== 'easy') this.addTime(-1 * this.D.pen, 'NO HORN');\n      }\n    }\n    if (H.held && this.route.workers) for (const w of this.route.workers) if (T.s > w.s - 300 && T.s < w.until) this.bus.emit('workersHeard', { s: w.s });\n  }\n\n  // ---- the calls (section 4.7) ----\n  openCall(kind) { this.callOpen = { kind, opened: this.t, made: false }; this.firstPowerDone = false; this.bus.emit('callOpen', { kind }); }\n  call() {\n    const T = this.train;\n    if (this.callOpen && this.callOpen.kind === 'departure') {\n      const great = !this.firstPowerDone;\n      this.callOpen.made = true; this.callOpen = null;\n      this.scoreCall(great, 'departure');\n      return { kind: 'departure', great };\n    }\n    let best = null, bd = 1e9;\n    for (const c of this.calls) {\n      if (c.called || c.s < this.stageSpan[0] || c.s > this.stageSpan[1] + 400) continue;\n      const d = c.s - T.s;\n      if (d > 30 && d <= 180 && d < bd && (c.kind !== 'signal' || this.sighted.has(c.sig))) { best = c; bd = d; }\n    }\n    if (!best) { this.bus.emit('callMiss'); return null; }\n    best.called = true;\n    const great = bd >= 60 && bd <= DH.TUNING.callGreat;\n    this.scoreCall(great, best.kind, best);\n    return { kind: best.kind, great, point: best };\n  }\n  scoreCall(great, kind, point) {\n    this.stats.calls++;\n    if (great) { this.stats.callsGreat++; this.addTime(0.5, 'CALL GREAT'); this.addScore(100); this.judge('CALL GREAT', .5, 100); }\n    else { this.addScore(50); this.judge('CALL', 0, 50); }\n    this.bus.emit('call', { kind, great, point: point || null });\n  }\n  updateCalls() {\n    if (this.opts.autoCalls) for (const c of this.calls) {\n      if (c.called) continue;\n      const d = c.s - this.train.s;\n      if (d <= DH.TUNING.callGreat && d > 60 && (c.kind !== 'signal' || this.sighted.has(c.sig))) { c.called = true; this.bus.emit('call', { kind: c.kind, great: true, auto: true, point: c }); }\n    }\n    if (this.callOpen && this.callOpen.kind === 'departure' && this.t - this.callOpen.opened > 60) this.callOpen = null;\n  }\n\n  // ---- stations: the stop judgment, the dwell and the departure (section 4.6) ----\n  classify(err) {\n    const W = DH.TUNING.stopWindow * this.D.win;\n    if (err > 50 || err < -50) return null;\n    if (err <= W * 1.0 && err >= -W * 1.0) return 'ok';\n    if (err < -W && err >= -5) return 'short';\n    if (err < -5) return 'moveup';\n    if (err > W && err <= 5) return 'over';\n    return 'overmark';\n  }\n  stopJudgment(x) {\n    const T = this.train, err = T.s - x.target, W = DH.TUNING.stopWindow * this.D.win;\n    let label, halo, pts;\n    if (err <= 0.10 * W) { label = 'PERFECT HALO!'; halo = 5; pts = 1000; this.stats.perfect++; }\n    else if (err <= 0.30 * W) { label = 'GREAT!'; halo = 3; pts = 700; this.stats.great++; }\n    else if (err <= 0.70 * W) { label = 'GOOD'; halo = 1; pts = 400; this.stats.good++; }\n    else { label = 'OK'; halo = 0; pts = 200; this.stats.ok++; }\n    this.finishStop(x, label, halo * (1), pts, err);\n  }\n  finishStop(x, label, halo, pts, err) {\n    this.addTime(halo, label); this.addScore(pts); this.judge(label, halo, pts);\n    x.label = label; x.err = err; x.judged = true;\n    this.arrivalJudgment(x);\n    if (this.smoothOK()) { this.stats.smooth++; this.addTime(2, 'SMOOTH!'); this.addScore(300); this.judge('SMOOTH!', 2, 300); }\n    this.stats.stops++;\n    this.beginDwell(x, this.clock());\n  }\n  arrivalJudgment(x) {\n    if (x.arrival === null) return;\n    const d = this.clock() - x.arrival, W = DH.TUNING.onTimeWindow;\n    if (Math.abs(d) <= W) { this.stats.onTime++; this.addTime(3, 'ON TIME!'); this.addScore(500); this.judge('ON TIME!', 3, 500); }\n    else if (d > W) { const h = -DH.TUNING.lateCost * (d - W) * this.D.pen; this.stats.late++; this.addTime(h, 'LATE +' + Math.round(d)); this.judge('LATE +' + Math.round(d), h, 0); }\n    else { this.stats.early++; this.addScore(100); this.judge('EARLY', 0, 100); }\n  }\n  smoothOK() { return Math.abs(this.lastDecel) <= 1.0 && this.train.s - this.lastEbS > 100; }\n  shortStop(x, err) {\n    const short = -err;\n    this.stats.short++;\n    this.finishStop(x, 'SHORT', -short * this.D.pen, 0, err);\n    this.addTime(0, '');\n  }\n  overrunStop(x, err) {\n    this.stats.overruns++;\n    this.finishStop(x, 'OVERRUN!', -err * DH.TUNING.overrunCost * this.D.pen, 0, err);\n  }\n\n  updateStations(dt) {\n    const T = this.train, x = this.stops[this.stopIdx];\n    if (this.dwell) { this.stepDwell(); return; }\n    if (this.backup) return;\n    if (!x) { if (!this.finished && this.stops.length && !this.passesLeft()) this.endStage(); return; }\n    const err = T.s - x.target, stopped = Math.abs(T.v) < 0.05;\n    // a stop approached from below: the creep window\n    if (x.shortT !== null && T.v > 0.3 && !x.restarted) { x.restarted = true; x.restops++; this.addTime(-1 * this.D.pen, 'RE-STOP'); }\n    if (x.shortT !== null) x.shortT -= (T.v > 0.3 ? 0 : dt);\n    if (stopped && !x.judged) {\n      const cls = this.classify(err);\n      if (cls === 'ok') this.stopJudgment(x);\n      else if (cls === 'over') this.overrunStop(x, err);\n      else if (cls === 'short') {\n        if (x.shortT === null) { x.shortT = 6; x.restarted = false; this.bus.emit('short', { m: -err }); this.setSubtitle('Hoshino', 'Short. Ease forward to the mark.'); }\n        else if (x.shortT <= 0 || x.restops >= 3) this.shortStop(x, err);\n        else if (x.restarted) { x.restarted = false; if (this.classify(err) === 'ok') this.stopJudgment(x); }\n      } else if (cls === 'overmark') {\n        this.backup = { x, target: x.target };\n        this.addTime(-10 * this.D.pen, 'OVER THE MARK'); this.addScore(-300); this.stats.over++; this.judge('OVER THE MARK', -10 * this.D.pen, -300);\n        this.setSubtitle('Hoshino', 'Back up to the mark.');\n      }\n    }\n    // past the mark without stopping: a missed stop\n    if (!x.judged && T.s > x.target + 50) {\n      x.judged = true; x.done = true; this.stats.missed++;\n      this.addTime(-10 * this.D.pen, 'MISSED STOP'); this.addScore(-300); this.judge('MISSED STOP', -10 * this.D.pen, -300);\n      this.setSubtitle('Hoshino', 'Missed. We were meant to stop there.');\n      this.stopIdx++;\n      if (this.stopIdx >= this.stops.length) this.endStage();\n    }\n  }\n  passesLeft() { return this.passes.some(p => !p.passed); }\n  /** the back-up at 5 km/h to the mark (over the mark), then the stop is judged as OK */\n  updateBackup(dt) {\n    const b = this.backup, T = this.train;\n    T.eb = false; T.notch = 0; T.v = -5; T.s -= 5 / 3.6 * dt;\n    if (T.s <= b.target + 1) {\n      T.s = Math.max(T.s, b.target); T.v = 0; this.backup = null;\n      this.finishStop(b.x, 'OK', 0, 200, T.s - b.target);\n      this.stats.ok++; this.stats.stops--;   // (counted once, in finishStop)\n    }\n  }\n  beginDwell(x, T0, initial) {\n    const dep = x.departure !== null ? x.departure : T0 + 20;\n    const min = DH.TUNING.dwell;\n    const melodyAt = Math.max(dep - 9, T0 + 6);\n    const closeAt = Math.max(melodyAt + 7, dep - 4, T0 + min);\n    this.dwell = { x, T0, dep, doorsAt: T0 + 1, melodyAt, closeAt, pilotAt: closeAt + 1.5, signalAt: 0, doorsOpen: false, melodyDone: false,\n      closed: false, pilotLit: false, rushed: false, initial: !!initial };\n    this.dwell.signalAt = Math.max(dep - 3, this.dwell.pilotAt);\n    this.phase = 'dwell';\n    this.bus.emit('doors', { open: false });\n    this.recordCheckpoint('stop');\n  }\n  stepDwell() {\n    const d = this.dwell, now = this.clock(), x = d.x;\n    if (!d.doorsOpen && !d.closed && now >= d.doorsAt) { d.doorsOpen = true; this.bus.emit('doors', { open: true }); this.bus.emit('chime', 'open'); this.passengers('alight'); }\n    if (!d.melodyDone && now >= d.melodyAt) { d.melodyDone = true; this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai' }); this.bus.emit('pa', { id: x.id }); }\n    if (d.doorsOpen && d.melodyDone && !d.closed && now >= d.closeAt) {\n      d.closed = true; d.doorsOpen = false; this.bus.emit('doors', { open: false }); this.bus.emit('chime', 'close');\n    }\n    if (d.closed && !d.buzz && now >= d.closeAt + 1) { d.buzz = true; this.bus.emit('buzzer'); }\n    if (d.closed && !d.pilotLit && now >= d.pilotAt) { d.pilotLit = true; this.bus.emit('pilot'); }\n    if (d.pilotLit && x.startSig && now >= d.signalAt) { this.readySignals.add(x.startSig.id); if (!d.departCall) { d.departCall = true; this.openCall('departure'); } }\n    if (d.pilotLit && x.startSig && !this.readySignals.has(x.startSig.id) && now >= d.signalAt) this.readySignals.add(x.startSig.id);\n    if (d.pilotLit && !x.startSig && !d.departCall) { d.departCall = true; this.openCall('departure'); }\n    // the train leaves once it's moving: the dwell ends\n    if (d.pilotLit && this.train.v > 0.5) { this.dwell = null; this.phase = 'run'; this.recordCheckpoint('depart'); }\n  }\n  passengers(what) { void what; }\n  /** a door rush (S4): the doors re-open for 8 s more */\n  doorRush() { const d = this.dwell; if (!d || d.rushed || !d.closed) return false; d.rushed = true; d.closeAt += 8; d.pilotAt += 8; d.signalAt += 8; d.closed = false; d.doorsOpen = true; d.melodyDone = true; this.bus.emit('doors', { open: true }); return true; }\n  endStage() { if (this.finished) return; this.finished = true; this.recordCheckpoint('end'); this.bus.emit('stageEnd'); }\n\n  // ---- comfort (section 4.10) ----\n  updateComfort(dt) {\n    const T = this.train;\n    if (T.eb && !this.ebHit) { this.ebHit = true; this.penalty(15); }\n    if (!T.eb) this.ebHit = false;\n    if (T.slipT > 0 && !this.slipHit) { this.slipHit = true; this.stats.slips++; this.penalty(3); this.bus.emit('slip'); this.toast('SLIP', 0); }\n    if (T.slipT <= 0) this.slipHit = false;\n    if (T.slide && !this.slideHit) { this.slideHit = true; this.penalty(3); this.bus.emit('slide'); }\n    if (!T.slide) this.slideHit = false;\n    if (Math.abs(T.a) < 1.5 && T.v > 1) this.comfortCalm += dt; else this.comfortCalm = 0;\n    if (this.comfortCalm >= 8) { this.comfortCalm = 0; this.comfort = Math.min(100, this.comfort + 1); }\n    if (this.dwell === null && T.v === 0 && this.prevV > 0 && this.lastBrakeA < -2) { this.penalty(8); }\n    this.prevV = T.v;\n    this.lastBrakeA = T.a;\n  }\n\n  // ---- events (section 4.11) ----\n  fire(id) { if (this.events.has(id)) return false; this.events.add(id); this.fired.push(id); return true; }\n  updateEvents() {\n    const T = this.train;\n    for (const e of this.stage.events || []) {\n      if (this.events.has(e.id)) continue;\n      const go = (e.at !== undefined && T.s >= e.at) || (e.clock !== undefined && this.clock() >= DH.parseClock(e.clock)) || (e.stop && this.dwell && this.dwell.x && this.dwell.x.id === e.stop && this.dwell.closed);\n      if (go) this.runEvent(e);\n    }\n  }\n  runEvent(e) {\n    this.fire(e.id);\n    switch (e.type) {\n      case 'oncoming': this.others.push(new TrainActor({ id: e.id, kind: 'oncoming', train: 'h8000', lane: e.lane || 'B', dir: -1, s: this.train.s + (e.ahead || 1400), v: 80, cars: 6, legs: [{ v: 80, acc: 4 }] })); this.bus.emit('oncoming', e); break;\n      case 'radio': this.setSubtitle(e.who, e.text); this.bus.emit('radio', e); break;\n      case 'tip': this.bus.emit('tip', e); break;\n      case 'doorRush': this.doorRush(); this.setSubtitle('Mika', 'One moment please! Doors re-opening!'); this.bus.emit('doorRush'); break;\n      case 'flash': this.flashAt = this.t; this.bus.emit('flash', e); break;\n      case 'workers': this.slowOrder = e.v || 25; this.bus.emit('workers', e); break;\n      case 'fog': this.fogDist = 180; this.bus.emit('fog', e); break;\n      case 'glare': this.bus.emit('glare', e); break;\n      case 'festival': this.bus.emit('festival', e); break;\n      case 'other': this.others.push(new TrainActor(e.train)); this.bus.emit('other', e); break;\n      default: this.bus.emit('event', e);\n    }\n  }\n\n  // ---- the step (section 3.4) ----\n  step(dt) {\n    if (this.gameOver || this.finished) return;\n    this.t += dt;\n    this.stageSpan = this.stageSpan || [this.route.from, this.route.to];\n    if (this.backup) { this.updateBackup(dt); this.prevS = this.train.s; return; }\n    const T = this.train, R = this.route;\n    const env = { grade: R.gradeAt(T.s), dry: this.dryRail, traction: this.pilotLit() && !this.doorsOpen() };\n    const before = T.s;\n    T.step(dt, env);\n    this.stats.km += Math.max(0, T.s - before) / 1000;\n    if (T.v > 0 && T.v <= 3) this.lastDecel = T.a;\n    if (T.rolled > 0.5 && !this.rollHit) { this.rollHit = true; this.stats.rollback++; this.addTime(-2 * this.D.pen, 'ROLLBACK'); this.penalty(5); }\n    for (const o of this.others) o.step(dt, this);\n    this.updateSignals();\n    this.updateATS(dt);\n    this.updateLimits();\n    this.updateCrossings();\n    this.updateHorn(dt);\n    this.updateCalls();\n    this.updateStations(dt);\n    this.updateComfort(dt);\n    this.updateEvents();\n    this.toasts = this.toasts.filter(t => this.t - t.t < 2.6);\n    this.subtitles = this.subtitles.filter(s => this.t < s.until);\n    this.prevS = T.s;\n  }\n\n  // ---- checkpoints (section 4.9) ----\n  recordCheckpoint(why) {\n    this.checkpoint = { why, s: this.train.s, clock: this.clock(), halo: this.halo, score: this.score, comfort: this.comfort, stopIdx: this.stopIdx,\n      fired: this.fired.slice(), t: this.t, stats: JSON.parse(JSON.stringify(this.stats)), others: this.others.map(o => ({ id: o.id, s: o.s, v: o.v, leg: o.leg, done: o.done })) };\n  }\n  /** the maximum score the stage can give (section 4.9 \"Max\") and the rank cut-offs */\n  maxPoints() {\n    const stops = this.stops.filter(x => x.st && x.arrival !== null).length + this.stops.filter(x => x.st).length;\n    const calls = this.calls.filter(c => c.kind === 'signal' || c.kind === 'limit' || c.kind === 'approach' || c.kind === 'horn').length;\n    const horns = this.route.horns.filter(h => h.s >= this.stageSpan[0] && h.s <= this.stageSpan[1]).length;\n    const maxHalo = this.haloStart + this.stops.length * 10 + horns * 1 + calls * 0.5;\n    return stops * (1000 + 500 + 300) + calls * 100 + horns * 100 + 800 + maxHalo * 50 + 100 * 5;\n  }\n  rankOf(total) {\n    const M = this.maxPoints(), f = total / M;\n    return f >= .9 ? 'S' : f >= .75 ? 'A' : f >= .55 ? 'B' : f >= .35 ? 'C' : 'D';\n  }\n  totals() {\n    const halo = Math.max(0, this.halo), base = this.score;\n    const bonus = halo * 50 + this.comfort * 5;\n    return { score: this.score, halo: Math.round(halo), comfort: Math.round(this.comfort), total: Math.round(base + bonus), max: Math.round(this.maxPoints()) };\n  }\n\n  // ---- what the scenes and tests read ----\n  snapshot() {\n    const T = this.train, next = this.stops[this.stopIdx] || null;\n    const ahead = this.signals.filter(g => g.s > T.s).slice(0, 3).map(g => ({ id: g.id, dist: Math.round(g.s - T.s), aspect: g.aspect, sighted: this.sighted.has(g.id) }));\n    return {\n      t: Math.round(this.t * 100) / 100, clock: DH.clock(this.clock()), s: Math.round(T.s * 10) / 10, km: Math.round(T.s) / 1000, v: Math.round(T.v * 10) / 10,\n      notch: T.notchName, P: T.P, B: T.B, a: T.a, jerk: T.jerk, eb: T.eb, slip: T.slipT > 0, slide: T.slide,\n      halo: Math.round(this.halo * 10) / 10, score: Math.round(this.score), comfort: Math.round(this.comfort), limit: this.limitInForce(),\n      nextStop: next ? { id: next.id, dist: Math.round(next.target - T.s), target: next.target, arr: next.arr || null } : null,\n      signals: ahead, lastJudgment: this.judgments.length ? this.judgments[this.judgments.length - 1] : null, judgments: this.judgments.map(j => j.label),\n      events: this.fired.slice(), doors: this.doorsOpen(), pilot: this.pilotLit(), ats: { ringing: this.atsRinging, confirmed: this.atsOn },\n      stopped: Math.abs(T.v) < 0.05, finished: this.finished, gameOver: this.gameOver, stats: JSON.parse(JSON.stringify(this.stats)),\n      weather: this.weather, fogDist: this.fogDist, call: this.callOpen ? this.callOpen.kind : null, backup: !!this.backup,\n      obstruction: !!(this.obstruction && this.obstruction.active), difficulty: this.difficulty, toasts: this.toasts.map(t => t.text),\n      others: this.others.map(o => ({ id: o.id, s: Math.round(o.s), v: Math.round(o.v), lane: o.lane, done: o.done }))\n    };\n  }\n}\nDH.Sim = Sim;\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":27170,"cache_read_input_tokens":241102,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":27170},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"bd0ff742-fc3e-4ed1-a1e3-9313ce340746","timestamp":"2026-11-04T12:16:09.160Z","request_id":"req_011CghsRYoBPqxdTDmqWjJiM","wire_tool_inputs":{"toolu_01JGAFCoBzdYVSaGZjiApK1B":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/31-sim.js","content":"/* Densha de Halo! · 31-sim: the world of a stage, stepped at 1/120 s. Pure: no drawing, no sound, no engine.\n * It owns the train (30-train), the signals and blocks, the other trains, the speed limits, ATS, the stops and the dwell\n * and departure sequence, the timetable and the clock, Halo Time, the score and comfort, the calls and the horn, the\n * crossings and the events. Scenes read it through snapshot() and steer it through cmd(). Rules: sections 4.4 to 4.11.\n * Each step runs in the order of section 3.4. Everything that happens is announced on bus ('sound', 'judgment', ...). */\n(() => {\n'use strict';\nconst DH = window.DH;\n\nconst DIFF = {\n  easy: { name: 'Easy', grace: 40 / 25, win: 1.5, pen: 0.5 },\n  normal: { name: 'Normal', grace: 1, win: 1.0, pen: 1.0 },\n  expert: { name: 'Expert', grace: 15 / 25, win: 0.7, pen: 1.5 }\n};\nDH.DIFF = DIFF;\nconst ASPECT_SPEED = { G: null, YG: 65, Y: 45, YY: 25, R: 0 };   // G means the line speed\nDH.ASPECT_SPEED = ASPECT_SPEED;\nconst LAMPS = { R: [0, 0, 1, 0], Y: [1, 0, 0, 0], YG: [1, 1, 0, 0], G: [0, 1, 0, 0], YY: [1, 0, 0, 1] };\nDH.LAMPS = LAMPS;\n\n/* another train: its own speed and legs (no lag model; it never affects the player's train, only the blocks it occupies).\n * A leg: { v (km/h target), acc (km/h/s), until (route s, stop passing it), stopAt (route s, stop there), dwell (s), lane,\n * wait (s before it starts), at (the clock to start at) } */\nclass TrainActor {\n  constructor(o) {\n    this.id = o.id; this.kind = o.kind || 'other'; this.spec = DH.TRAINS[o.train || 'freight'];\n    this.lane = o.lane || 'B'; this.dir = o.dir || 1; this.s = o.s; this.v = o.v || 0;\n    this.cars = o.cars || (this.spec ? this.spec.cars : 4); this.carLen = 20;\n    this.legs = (o.legs || []).map(l => Object.assign({}, l)); this.leg = 0; this.wait = 0;\n    this.clockAt = o.clockAt === undefined ? null : o.clockAt; this.done = false;\n    this.light = o.light || 'tail';\n  }\n  get length() { return this.cars * this.carLen; }\n  get rear() { return this.s - this.dir * this.length; }\n  span() { return this.dir > 0 ? [this.rear, this.s] : [this.s, this.rear]; }\n  step(dt, world) {\n    if (this.done) return;\n    if (this.clockAt !== null && world.clock() < this.clockAt) return;\n    const L = this.legs[this.leg];\n    if (!L) { this.v = Math.max(0, this.v - 6 * dt); this.s += this.dir * this.v / 3.6 * dt; if (this.v === 0) this.done = true; return; }\n    if (L.lane) this.lane = L.lane;\n    if (this.wait > 0) { this.wait -= dt; this.v = 0; if (this.wait <= 0) this.leg++; return; }\n    const acc = L.acc || 4, want = L.v === undefined ? this.v : L.v;\n    this.v += DH.clamp(want - this.v, -acc * dt, acc * dt);\n    if (L.stopAt !== undefined) {\n      const remain = (L.stopAt - this.s) * this.dir;\n      const brake = (this.v / 3.6) ** 2 / (2 * Math.max(acc, .5) / 3.6);   // distance to stop from here, at its decel\n      if (remain <= brake + .05 || remain <= .05) {\n        const k = (this.v / 3.6) ** 2 > 0 ? 1 : 1;\n        void k;\n        if (this.v > 0) { this.v = Math.max(0, this.v - acc * dt * 2); }\n        if (remain <= .05 || this.v <= 0.01) { this.s = L.stopAt; this.v = 0; this.wait = L.dwell || 0; if (!L.dwell) this.leg++; else this.leg++; return; }\n      }\n    }\n    this.s += this.dir * this.v / 3.6 * dt;\n    if (L.until !== undefined && (this.s - L.until) * this.dir >= 0) this.leg++;\n  }\n}\nDH.TrainActor = TrainActor;\n\nclass Sim {\n  constructor(stage, route, opts = {}) {\n    this.stage = stage; this.route = route; this.opts = opts;\n    this.difficulty = opts.difficulty || 'normal'; this.D = DIFF[this.difficulty] || DIFF.normal;\n    this.t = 0; this.clockOffset = DH.parseClock(stage.startClock || '06:40:00');\n    this.bus = new DH.Bus();\n    this.spec = DH.TRAINS[stage.train || 'h8000'];\n    this.cars = stage.cars || 6;\n    this.train = new DH.Train(this.spec, { s: stage.startS || 0 });\n    this.train.cars = this.cars;\n    this.weather = stage.weather || 'clear'; this.dryRail = this.weather !== 'rain';\n    this.fogDist = this.weather === 'fog' ? 180 : 900;\n    this.hour = stage.hour === undefined ? 12 : stage.hour;\n    // scoring and state\n    this.halo = 0; this.haloStart = Math.round(DH.TUNING.graceStart * this.D.grace); this.haloMax = 99;\n    this.score = 0; this.comfort = 100; this.comfortCalm = 0; this.gameOver = false; this.finished = false;\n    this.stats = { stops: 0, perfect: 0, great: 0, good: 0, ok: 0, onTime: 0, late: 0, early: 0, smooth: 0, short: 0, overruns: 0, over: 0,\n      calls: 0, callsGreat: 0, horn: 0, hornMiss: 0, slips: 0, ats: 0, spad: 0, limit: 0, ebs: 0, km: 0, hazard: 0, missed: 0, wrong: 0, rollback: 0 };\n    this.judgments = []; this.toasts = []; this.subtitles = []; this.log = [];\n    this.events = new Set(); this.fired = [];\n    this.sighted = new Set(); this.atsLatched = new Set(); this.spadLatched = new Set(); this.signalPassed = new Set();\n    this.limitBroken = false; this.limitPeak = 0; this.slowOrder = null; this.aspectCap = null;\n    this.atsRinging = false; this.atsTimer = 0; this.atsOn = false; this.speedAlarm = false;\n    this.horn = { held: false, tHeld: 0, sounded: new Set(), missed: new Set() };\n    this.dwell = null; this.backup = null; this.obstruction = null; this.crossingGates = {};\n    this.lastDecel = 0; this.lastEbS = -1e9; this.prevS = this.train.s; this.readySignals = new Set();\n    this.firstPowerDone = false; this.callOpen = null; this.departedFlag = false;\n    this.checkpoint = null;\n    this.setup();\n  }\n\n  // ---- the stage's set-up: stops, signals, calls, the others ----\n  setup() {\n    const st = this.stage, R = this.route;\n    this.stops = (st.stops || []).map(x => {\n      const station = R.stationById(x.id);\n      const target = R.stopOf(x.id, this.cars);\n      const tgt = target !== undefined ? target : (station && station.stops ? Object.values(station.stops)[0] : this.train.s);\n      return Object.assign({}, x, { st: station, target: tgt, arrival: x.arr ? DH.parseClock(x.arr) : null, departure: x.dep ? DH.parseClock(x.dep) : null,\n        judged: false, done: false, restops: 0, shortT: null, startSig: station ? R.signals.find(g => g.kind === 'start' && g.s >= station.end - 5 && g.s <= station.end + 420) || null : null });\n    });\n    this.passes = (st.passes || []).map(p => { const station = R.stationById(p.id); return { id: p.id, at: station ? station.start : p.at, arr: p.at, passed: false }; });\n    this.signals = R.signals.slice().sort((a, b) => a.s - b.s);\n    for (const g of this.signals) g.aspect = 'R';\n    this.others = (st.trains || []).map(o => new TrainActor(o));\n    this.limits = R.limits.slice();\n    this.buildCalls();\n    this.stopIdx = 0;\n    if (st.startStopped) {   // the stage opens with the train standing at its first stop, doors open\n      const first = this.stops[0];\n      this.train.s = first.target; this.train.v = 0; this.stopIdx = 1; first.judged = true; first.done = true;\n      this.beginDwell(first, this.clockOffset, true);\n    }\n    this.prevS = this.train.s;\n    this.recordCheckpoint('start');\n  }\n  buildCalls() {\n    const R = this.route, calls = this.calls = [];\n    const add = (o) => calls.push(Object.assign({ called: false }, o));\n    for (const g of this.signals) add({ s: g.s, id: g.id, kind: 'signal', sig: g.id });\n    for (const L of this.limits) add({ s: L.s, id: 'lim' + L.s, kind: 'limit', v: L.v });\n    for (const h of R.horns) add({ s: h.s, id: 'horn' + h.s, kind: 'horn' });\n    for (const x of this.stops) if (x.st) add({ s: x.st.start - 400, id: 'app' + x.id, kind: 'approach', stopId: x.id });\n    for (const p of this.passes) add({ s: p.at - 400, id: 'pass' + p.id, kind: 'pass' });\n  }\n\n  // ---- the clock and the lever ----\n  clock() { return this.clockOffset + this.t; }\n  pilotLit() { return !this.dwell || this.dwell.pilotLit; }\n  doorsOpen() { return !!(this.dwell && this.dwell.doorsOpen); }\n  cmd(name, val) {\n    const T = this.train;\n    if (this.gameOver || this.finished) return null;\n    switch (name) {\n      case 'power': {\n        if (this.dwell && !this.dwell.pilotLit && T.notch >= 0 && !T.eb) this.bus.emit('note', 'doors');\n        const moved = T.power();\n        if (moved) this.bus.emit('notch', { name: T.notchName, dir: 1 });\n        if (T.eb === false && moved && this.callOpen && this.callOpen.kind === 'departure' && !this.firstPowerDone) this.firstPowerDone = true;\n        return moved;\n      }\n      case 'brake': { const moved = T.brake(); if (moved) this.bus.emit('notch', { name: T.notchName, dir: -1 }); return moved; }\n      case 'neutral': if (!T.eb) { T.neutral(); this.bus.emit('notch', { name: 'N', dir: 0 }); } return true;\n      case 'eb': if (!T.eb) this.emergency(); return true;\n      case 'ats': return this.confirmATS();\n      case 'horn': this.setHorn(!!val); return true;\n      case 'call': return this.call();\n      default: return null;\n    }\n  }\n  emergency() {\n    const T = this.train;\n    if (T.eb) return;\n    T.emergency(); this.stats.ebs++; this.lastEbS = T.s;\n    this.penalty(15);\n    if (!this.hazardOn()) { this.addTime(-3 * this.D.pen, 'EMERGENCY'); this.addScore(-200); }\n    this.bus.emit('eb');\n  }\n  hazardOn() { return !!(this.obstruction && this.obstruction.active && !this.obstruction.passed); }\n\n  // ---- the halo time, score, comfort and the toasts ----\n  addTime(v, why) {\n    if (!v) return;\n    this.halo = Math.min(this.haloMax, this.halo + v);\n    this.toast(why, v);\n    if (this.halo <= 0 && !this.gameOver) { this.halo = 0; this.gameOver = true; this.bus.emit('gameover'); }\n  }\n  addScore(p) { this.score += p; }\n  toast(text, v) { this.toasts.push({ text, v, t: this.t }); if (this.toasts.length > 4) this.toasts.shift(); }\n  judge(label, halo, pts) { this.judgments.push({ label, t: this.t, halo, pts }); this.bus.emit('judgment', { label, halo, pts }); }\n  setSubtitle(who, text) { this.subtitles.push({ who, text, t: this.t, until: this.t + 4.5 }); if (this.subtitles.length > 2) this.subtitles.shift(); this.bus.emit('line', { who, text }); }\n  penalty(c) { this.comfort = Math.max(0, this.comfort - c * DH.TUNING.comfortSens); }\n\n  // ---- signals and blocks (section 4.4) ----\n  occupied(a, b) {\n    const T = this.train;\n    if (T.s > a && T.rear < b) return true;\n    for (const o of this.others) {\n      if (o.done || o.lane !== 'A') continue;\n      const [lo, hi] = o.span(); if (hi > a && lo < b) return true;\n    }\n    return false;\n  }\n  aspectOf(g) {\n    if (g.kind === 'shunt') return 'R';\n    if (g.forced) return g.forced;\n    if (g.kind === 'start' && !this.readySignals.has(g.id)) return 'R';\n    if (g.obstruct && this.hazardOn()) return 'R';\n    const i0 = this.signals.indexOf(g);\n    let c = 0;\n    for (let i = i0; i < this.signals.length && c < 3; i++) {\n      const sg = this.signals[i], nxt = this.signals[i + 1] ? this.signals[i + 1].s : this.route.to;\n      if (this.occupied(sg.s, nxt)) break;\n      if (i > i0 && sg.kind === 'start' && !this.readySignals.has(sg.id)) break;\n      c++;\n    }\n    return ['R', 'Y', 'YG', 'G'][Math.min(c, 3)];\n  }\n  updateSignals() {\n    const T = this.train, prev = this.prevS;\n    for (const g of this.signals) {\n      const prevAsp = g.aspect;\n      g.aspect = this.aspectOf(g);\n      const d = g.s - T.s;\n      const range = this.fogDist < 400 ? 180 : 600;\n      if (!this.sighted.has(g.id) && d >= 0 && d <= range) { this.sighted.add(g.id); this.bus.emit('sighted', { id: g.id, aspect: g.aspect }); }\n      // the front crosses the signal this step: a red at that moment is a SPAD\n      if (prev < g.s && T.s >= g.s && !this.signalPassed.has(g.id)) {\n        this.signalPassed.add(g.id);\n        if (prevAsp === 'R' && g.kind !== 'shunt' && !this.spadLatched.has(g.id)) this.spad(g);\n      }\n    }\n    let last = null;\n    for (const g of this.signals) if (g.s <= T.s) last = g;\n    this.lastPassed = last;\n    this.aspectCap = last && last.aspect !== 'G' ? ASPECT_SPEED[last.aspect] : null;\n  }\n  spad(g) {\n    this.spadLatched.add(g.id); this.stats.spad++;\n    this.addTime(-20 * this.D.pen, 'SIGNAL PASSED AT DANGER'); this.addScore(-1000); this.penalty(15);\n    this.judge('SIGNAL PASSED AT DANGER', -20 * this.D.pen, -1000);\n    this.setSubtitle('Hoshino', 'Stop! That was a red.');\n    this.bus.emit('spad', { id: g.id });\n    this.emergency();\n  }\n  confirmATS() {\n    if (!this.atsRinging) return false;\n    this.atsRinging = false; this.atsOn = true;\n    this.bus.emit('atsConfirm'); this.toast('ATS CONFIRM', 0);\n    return true;\n  }\n  updateATS(dt) {\n    const T = this.train, prev = this.prevS;\n    for (const g of this.signals) {\n      if (g.kind === 'shunt') continue;\n      const beacon = g.s - 600;\n      if (prev < beacon && T.s >= beacon && g.aspect === 'R' && !this.atsLatched.has(g.id)) {\n        this.atsLatched.add(g.id);\n        if (T.s < g.s) {\n          this.atsRinging = true; this.atsTimer = DH.TUNING.atsTime; this.stats.ats++;\n          this.bus.emit('ats', { id: g.id }); this.toast('ATS!', 0);\n          this.setSubtitle('Hoshino', 'ATS. Confirm it, then brake.');\n        }\n      }\n    }\n    if (this.atsRinging) {\n      this.atsTimer -= dt;\n      if (this.atsTimer <= 0) { this.atsRinging = false; this.addTime(-3 * this.D.pen, 'ATS EB'); this.emergency(); }\n    }\n    if (this.atsOn && (T.v < 15 || (this.lastPassed && this.lastPassed.aspect !== 'R' && this.lastPassed.aspect !== 'Y'))) this.atsOn = false;\n    // the speed check: over the limit by more than 10 km/h fires the brake, once per section\n    const lim = this.limitInForce(), over = T.v - lim;\n    if (over > 10 && !this.speedAlarm && !T.eb) { this.speedAlarm = true; this.addTime(-3 * this.D.pen, 'ATS EB'); this.emergency(); }\n    if (over < 0) this.speedAlarm = false;\n  }\n\n  // ---- speed limits (section 4.5) ----\n  limitInForce() {\n    const T = this.train, R = this.route;\n    let lim = R.lineSpeedAt(T.s) || 85;\n    if (this.stage.lineSpeed) lim = Math.min(lim, this.stage.lineSpeed);\n    for (const L of this.limits) {\n      // in force while the front is in its section, and the section lasts until its END board (the rear passes it)\n      if (T.s >= L.s && (L.end === null || T.rear <= L.end || T.s <= L.end)) lim = Math.min(lim, L.v);\n    }\n    if (this.aspectCap !== null) lim = Math.min(lim, this.aspectCap);\n    if (this.slowOrder) lim = Math.min(lim, this.slowOrder);\n    return lim;\n  }\n  updateLimits() {\n    const T = this.train, lim = this.limitInForce(), tol = DH.TUNING.limitTol, over = T.v - lim;\n    if (over > tol) {\n      if (!this.limitBroken) {\n        this.limitBroken = true; this.limitPeak = over; this.stats.limit++;\n        this.addTime(-2 * this.D.pen, 'LIMIT!'); this.addScore(-300); this.penalty(3);\n        this.judge('LIMIT!', -2 * this.D.pen, -300); this.bus.emit('limit', { v: lim });\n      } else if (over > this.limitPeak + 5) {\n        const extra = Math.floor((over - this.limitPeak) / 5); this.limitPeak = over;\n        this.addTime(-extra * this.D.pen, 'LIMIT!');\n      }\n    } else if (over < 0 && this.limitBroken) { this.limitBroken = false; this.limitPeak = 0; }\n  }\n\n  // ---- crossings, gates and the obstruction (section 4.11) ----\n  updateCrossings() {\n    const T = this.train;\n    for (const c of this.route.crossings) {\n      const d = c.s - T.s;\n      let g = this.crossingGates[c.id] || (this.crossingGates[c.id] = { down: false });\n      if (!g.down && d > -20 && (d < 500 || (T.v > 1 && d / (T.v / 3.6) < 25))) { g.down = true; this.bus.emit('gates', { id: c.id, down: true }); }\n      if (g.down && T.rear > c.s + 12) { g.down = false; this.bus.emit('gates', { id: c.id, down: false }); }\n    }\n    const st = this.stage.obstruction;\n    if (st && !this.obstruction) {\n      const c = this.route.crossings.find(x => x.id === st.id);\n      if (c && c.s - T.s < 350 && c.s - T.s > -20) {\n        this.obstruction = { id: st.id, active: true, passed: false, stoppedAt: null, counted: false };\n        this.bus.emit('obstruction', { id: st.id, on: true }); this.fire('obstruction');\n      }\n    }\n    const ob = this.obstruction;\n    if (ob && ob.active) {\n      const c = this.route.crossings.find(x => x.id === ob.id);\n      if (c && !ob.passed && T.s > c.s - 1 && T.rear < c.s + 1) {\n        ob.passed = true; this.addTime(-3 * this.D.pen, 'HAZARD'); this.addScore(-200); this.stats.hazard--; this.bus.emit('hazard');\n        this.emergency();\n      }\n      if (c && !ob.counted && T.v === 0 && T.s < c.s - 3) {\n        ob.counted = true; ob.stoppedAt = this.t;\n        this.addTime(5, 'HAZARD AVOIDED'); this.addScore(800); this.stats.hazard++; this.judge('HAZARD AVOIDED', 5, 800);\n        this.setSubtitle('Mika', 'The crossing alarm! Something is on the tracks!');\n      }\n      if (ob.stoppedAt !== null && this.t - ob.stoppedAt > 12) { ob.active = false; this.bus.emit('obstruction', { id: ob.id, on: false }); }\n    }\n  }\n\n  // ---- the horn (section 4.7) ----\n  setHorn(on) {\n    const H = this.horn;\n    if (on && !H.held) { H.held = true; H.tHeld = 0; this.bus.emit('horn', { on: true }); }\n    if (!on && H.held) { H.held = false; this.bus.emit('horn', { on: false }); }\n  }\n  updateHorn(dt) {\n    const H = this.horn, T = this.train;\n    if (H.held) H.tHeld += dt;\n    for (const h of this.route.horns) {\n      if (h.s < this.stageSpan[0] || h.s > this.stageSpan[1]) continue;\n      const key = 'horn' + h.s, inZone = T.s >= h.s && T.s < h.s + h.zone;\n      if (inZone && H.held && H.tHeld >= 0.5 && !H.sounded.has(key)) {\n        H.sounded.add(key); this.stats.horn++;\n        this.addTime(1, 'HORN +1'); this.addScore(100); this.judge('HORN +1', 1, 100);\n        this.bus.emit('hornOK', { s: h.s });\n      }\n      if (T.s >= h.s + h.zone && !H.sounded.has(key) && !H.missed.has(key)) {\n        H.missed.add(key); this.stats.hornMiss++;\n        if (this.difficulty !== 'easy') this.addTime(-1 * this.D.pen, 'NO HORN');\n      }\n    }\n    if (H.held && this.route.workers) for (const w of this.route.workers) if (T.s > w.s - 300 && T.s < w.until) this.bus.emit('workersHeard', { s: w.s });\n  }\n\n  // ---- the calls (section 4.7) ----\n  openCall(kind) { this.callOpen = { kind, opened: this.t, made: false }; this.firstPowerDone = false; this.bus.emit('callOpen', { kind }); }\n  call() {\n    const T = this.train;\n    if (this.callOpen && this.callOpen.kind === 'departure') {\n      const great = !this.firstPowerDone;\n      this.callOpen.made = true; this.callOpen = null;\n      this.scoreCall(great, 'departure');\n      return { kind: 'departure', great };\n    }\n    let best = null, bd = 1e9;\n    for (const c of this.calls) {\n      if (c.called || c.s < this.stageSpan[0] || c.s > this.stageSpan[1] + 400) continue;\n      const d = c.s - T.s;\n      if (d > 30 && d <= 180 && d < bd && (c.kind !== 'signal' || this.sighted.has(c.sig))) { best = c; bd = d; }\n    }\n    if (!best) { this.bus.emit('callMiss'); return null; }\n    best.called = true;\n    const great = bd >= 60 && bd <= DH.TUNING.callGreat;\n    this.scoreCall(great, best.kind, best);\n    return { kind: best.kind, great, point: best };\n  }\n  scoreCall(great, kind, point) {\n    this.stats.calls++;\n    if (great) { this.stats.callsGreat++; this.addTime(0.5, 'CALL GREAT'); this.addScore(100); this.judge('CALL GREAT', .5, 100); }\n    else { this.addScore(50); this.judge('CALL', 0, 50); }\n    this.bus.emit('call', { kind, great, point: point || null });\n  }\n  updateCalls() {\n    if (this.opts.autoCalls) for (const c of this.calls) {\n      if (c.called) continue;\n      const d = c.s - this.train.s;\n      if (d <= DH.TUNING.callGreat && d > 60 && (c.kind !== 'signal' || this.sighted.has(c.sig))) { c.called = true; this.bus.emit('call', { kind: c.kind, great: true, auto: true, point: c }); }\n    }\n    if (this.callOpen && this.callOpen.kind === 'departure' && this.t - this.callOpen.opened > 60) this.callOpen = null;\n  }\n\n  // ---- stations: the stop judgment, the dwell and the departure (section 4.6) ----\n  classify(err) {\n    const W = DH.TUNING.stopWindow * this.D.win;\n    if (err > 50 || err < -50) return null;\n    if (err <= W * 1.0 && err >= -W * 1.0) return 'ok';\n    if (err < -W && err >= -5) return 'short';\n    if (err < -5) return 'moveup';\n    if (err > W && err <= 5) return 'over';\n    return 'overmark';\n  }\n  stopJudgment(x) {\n    const T = this.train, err = T.s - x.target, W = DH.TUNING.stopWindow * this.D.win;\n    let label, halo, pts;\n    if (err <= 0.10 * W) { label = 'PERFECT HALO!'; halo = 5; pts = 1000; this.stats.perfect++; }\n    else if (err <= 0.30 * W) { label = 'GREAT!'; halo = 3; pts = 700; this.stats.great++; }\n    else if (err <= 0.70 * W) { label = 'GOOD'; halo = 1; pts = 400; this.stats.good++; }\n    else { label = 'OK'; halo = 0; pts = 200; this.stats.ok++; }\n    this.finishStop(x, label, halo * (1), pts, err);\n  }\n  finishStop(x, label, halo, pts, err) {\n    this.addTime(halo, label); this.addScore(pts); this.judge(label, halo, pts);\n    x.label = label; x.err = err; x.judged = true;\n    this.arrivalJudgment(x);\n    if (this.smoothOK()) { this.stats.smooth++; this.addTime(2, 'SMOOTH!'); this.addScore(300); this.judge('SMOOTH!', 2, 300); }\n    this.stats.stops++;\n    this.beginDwell(x, this.clock());\n  }\n  arrivalJudgment(x) {\n    if (x.arrival === null) return;\n    const d = this.clock() - x.arrival, W = DH.TUNING.onTimeWindow;\n    if (Math.abs(d) <= W) { this.stats.onTime++; this.addTime(3, 'ON TIME!'); this.addScore(500); this.judge('ON TIME!', 3, 500); }\n    else if (d > W) { const h = -DH.TUNING.lateCost * (d - W) * this.D.pen; this.stats.late++; this.addTime(h, 'LATE +' + Math.round(d)); this.judge('LATE +' + Math.round(d), h, 0); }\n    else { this.stats.early++; this.addScore(100); this.judge('EARLY', 0, 100); }\n  }\n  smoothOK() { return Math.abs(this.lastDecel) <= 1.0 && this.train.s - this.lastEbS > 100; }\n  shortStop(x, err) {\n    const short = -err;\n    this.stats.short++;\n    this.finishStop(x, 'SHORT', -short * this.D.pen, 0, err);\n    this.addTime(0, '');\n  }\n  overrunStop(x, err) {\n    this.stats.overruns++;\n    this.finishStop(x, 'OVERRUN!', -err * DH.TUNING.overrunCost * this.D.pen, 0, err);\n  }\n\n  updateStations(dt) {\n    const T = this.train, x = this.stops[this.stopIdx];\n    if (this.dwell) { this.stepDwell(); return; }\n    if (this.backup) return;\n    if (!x) { if (!this.finished && this.stops.length && !this.passesLeft()) this.endStage(); return; }\n    const err = T.s - x.target, stopped = Math.abs(T.v) < 0.05;\n    // a stop approached from below: the creep window\n    if (x.shortT !== null && T.v > 0.3 && !x.restarted) { x.restarted = true; x.restops++; this.addTime(-1 * this.D.pen, 'RE-STOP'); }\n    if (x.shortT !== null) x.shortT -= (T.v > 0.3 ? 0 : dt);\n    if (stopped && !x.judged) {\n      const cls = this.classify(err);\n      if (cls === 'ok') this.stopJudgment(x);\n      else if (cls === 'over') this.overrunStop(x, err);\n      else if (cls === 'short') {\n        if (x.shortT === null) { x.shortT = 6; x.restarted = false; this.bus.emit('short', { m: -err }); this.setSubtitle('Hoshino', 'Short. Ease forward to the mark.'); }\n        else if (x.shortT <= 0 || x.restops >= 3) this.shortStop(x, err);\n        else if (x.restarted) { x.restarted = false; if (this.classify(err) === 'ok') this.stopJudgment(x); }\n      } else if (cls === 'overmark') {\n        this.backup = { x, target: x.target };\n        this.addTime(-10 * this.D.pen, 'OVER THE MARK'); this.addScore(-300); this.stats.over++; this.judge('OVER THE MARK', -10 * this.D.pen, -300);\n        this.setSubtitle('Hoshino', 'Back up to the mark.');\n      }\n    }\n    // past the mark without stopping: a missed stop\n    if (!x.judged && T.s > x.target + 50) {\n      x.judged = true; x.done = true; this.stats.missed++;\n      this.addTime(-10 * this.D.pen, 'MISSED STOP'); this.addScore(-300); this.judge('MISSED STOP', -10 * this.D.pen, -300);\n      this.setSubtitle('Hoshino', 'Missed. We were meant to stop there.');\n      this.stopIdx++;\n      if (this.stopIdx >= this.stops.length) this.endStage();\n    }\n  }\n  passesLeft() { return this.passes.some(p => !p.passed); }\n  /** the back-up at 5 km/h to the mark (over the mark), then the stop is judged as OK */\n  updateBackup(dt) {\n    const b = this.backup, T = this.train;\n    T.eb = false; T.notch = 0; T.v = -5; T.s -= 5 / 3.6 * dt;\n    if (T.s <= b.target + 1) {\n      T.s = Math.max(T.s, b.target); T.v = 0; this.backup = null;\n      this.finishStop(b.x, 'OK', 0, 200, T.s - b.target);\n      this.stats.ok++; this.stats.stops--;   // (counted once, in finishStop)\n    }\n  }\n  beginDwell(x, T0, initial) {\n    const dep = x.departure !== null ? x.departure : T0 + 20;\n    const min = DH.TUNING.dwell;\n    const melodyAt = Math.max(dep - 9, T0 + 6);\n    const closeAt = Math.max(melodyAt + 7, dep - 4, T0 + min);\n    this.dwell = { x, T0, dep, doorsAt: T0 + 1, melodyAt, closeAt, pilotAt: closeAt + 1.5, signalAt: 0, doorsOpen: false, melodyDone: false,\n      closed: false, pilotLit: false, rushed: false, initial: !!initial };\n    this.dwell.signalAt = Math.max(dep - 3, this.dwell.pilotAt);\n    this.phase = 'dwell';\n    this.bus.emit('doors', { open: false });\n    this.recordCheckpoint('stop');\n  }\n  stepDwell() {\n    const d = this.dwell, now = this.clock(), x = d.x;\n    if (!d.doorsOpen && !d.closed && now >= d.doorsAt) { d.doorsOpen = true; this.bus.emit('doors', { open: true }); this.bus.emit('chime', 'open'); this.passengers('alight'); }\n    if (!d.melodyDone && now >= d.melodyAt) { d.melodyDone = true; this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai' }); this.bus.emit('pa', { id: x.id }); }\n    if (d.doorsOpen && d.melodyDone && !d.closed && now >= d.closeAt) {\n      d.closed = true; d.doorsOpen = false; this.bus.emit('doors', { open: false }); this.bus.emit('chime', 'close');\n    }\n    if (d.closed && !d.buzz && now >= d.closeAt + 1) { d.buzz = true; this.bus.emit('buzzer'); }\n    if (d.closed && !d.pilotLit && now >= d.pilotAt) { d.pilotLit = true; this.bus.emit('pilot'); }\n    if (d.pilotLit && x.startSig && now >= d.signalAt) { this.readySignals.add(x.startSig.id); if (!d.departCall) { d.departCall = true; this.openCall('departure'); } }\n    if (d.pilotLit && x.startSig && !this.readySignals.has(x.startSig.id) && now >= d.signalAt) this.readySignals.add(x.startSig.id);\n    if (d.pilotLit && !x.startSig && !d.departCall) { d.departCall = true; this.openCall('departure'); }\n    // the train leaves once it's moving: the dwell ends\n    if (d.pilotLit && this.train.v > 0.5) { this.dwell = null; this.phase = 'run'; this.recordCheckpoint('depart'); }\n  }\n  passengers(what) { void what; }\n  /** a door rush (S4): the doors re-open for 8 s more */\n  doorRush() { const d = this.dwell; if (!d || d.rushed || !d.closed) return false; d.rushed = true; d.closeAt += 8; d.pilotAt += 8; d.signalAt += 8; d.closed = false; d.doorsOpen = true; d.melodyDone = true; this.bus.emit('doors', { open: true }); return true; }\n  endStage() { if (this.finished) return; this.finished = true; this.recordCheckpoint('end'); this.bus.emit('stageEnd'); }\n\n  // ---- comfort (section 4.10) ----\n  updateComfort(dt) {\n    const T = this.train;\n    if (T.eb && !this.ebHit) { this.ebHit = true; this.penalty(15); }\n    if (!T.eb) this.ebHit = false;\n    if (T.slipT > 0 && !this.slipHit) { this.slipHit = true; this.stats.slips++; this.penalty(3); this.bus.emit('slip'); this.toast('SLIP', 0); }\n    if (T.slipT <= 0) this.slipHit = false;\n    if (T.slide && !this.slideHit) { this.slideHit = true; this.penalty(3); this.bus.emit('slide'); }\n    if (!T.slide) this.slideHit = false;\n    if (Math.abs(T.a) < 1.5 && T.v > 1) this.comfortCalm += dt; else this.comfortCalm = 0;\n    if (this.comfortCalm >= 8) { this.comfortCalm = 0; this.comfort = Math.min(100, this.comfort + 1); }\n    if (this.dwell === null && T.v === 0 && this.prevV > 0 && this.lastBrakeA < -2) { this.penalty(8); }\n    this.prevV = T.v;\n    this.lastBrakeA = T.a;\n  }\n\n  // ---- events (section 4.11) ----\n  fire(id) { if (this.events.has(id)) return false; this.events.add(id); this.fired.push(id); return true; }\n  updateEvents() {\n    const T = this.train;\n    for (const e of this.stage.events || []) {\n      if (this.events.has(e.id)) continue;\n      const go = (e.at !== undefined && T.s >= e.at) || (e.clock !== undefined && this.clock() >= DH.parseClock(e.clock)) || (e.stop && this.dwell && this.dwell.x && this.dwell.x.id === e.stop && this.dwell.closed);\n      if (go) this.runEvent(e);\n    }\n  }\n  runEvent(e) {\n    this.fire(e.id);\n    switch (e.type) {\n      case 'oncoming': this.others.push(new TrainActor({ id: e.id, kind: 'oncoming', train: 'h8000', lane: e.lane || 'B', dir: -1, s: this.train.s + (e.ahead || 1400), v: 80, cars: 6, legs: [{ v: 80, acc: 4 }] })); this.bus.emit('oncoming', e); break;\n      case 'radio': this.setSubtitle(e.who, e.text); this.bus.emit('radio', e); break;\n      case 'tip': this.bus.emit('tip', e); break;\n      case 'doorRush': this.doorRush(); this.setSubtitle('Mika', 'One moment please! Doors re-opening!'); this.bus.emit('doorRush'); break;\n      case 'flash': this.flashAt = this.t; this.bus.emit('flash', e); break;\n      case 'workers': this.slowOrder = e.v || 25; this.bus.emit('workers', e); break;\n      case 'fog': this.fogDist = 180; this.bus.emit('fog', e); break;\n      case 'glare': this.bus.emit('glare', e); break;\n      case 'festival': this.bus.emit('festival', e); break;\n      case 'other': this.others.push(new TrainActor(e.train)); this.bus.emit('other', e); break;\n      default: this.bus.emit('event', e);\n    }\n  }\n\n  // ---- the step (section 3.4) ----\n  step(dt) {\n    if (this.gameOver || this.finished) return;\n    this.t += dt;\n    this.stageSpan = this.stageSpan || [this.route.from, this.route.to];\n    if (this.backup) { this.updateBackup(dt); this.prevS = this.train.s; return; }\n    const T = this.train, R = this.route;\n    const env = { grade: R.gradeAt(T.s), dry: this.dryRail, traction: this.pilotLit() && !this.doorsOpen() };\n    const before = T.s;\n    T.step(dt, env);\n    this.stats.km += Math.max(0, T.s - before) / 1000;\n    if (T.v > 0 && T.v <= 3) this.lastDecel = T.a;\n    if (T.rolled > 0.5 && !this.rollHit) { this.rollHit = true; this.stats.rollback++; this.addTime(-2 * this.D.pen, 'ROLLBACK'); this.penalty(5); }\n    for (const o of this.others) o.step(dt, this);\n    this.updateSignals();\n    this.updateATS(dt);\n    this.updateLimits();\n    this.updateCrossings();\n    this.updateHorn(dt);\n    this.updateCalls();\n    this.updateStations(dt);\n    this.updateComfort(dt);\n    this.updateEvents();\n    this.toasts = this.toasts.filter(t => this.t - t.t < 2.6);\n    this.subtitles = this.subtitles.filter(s => this.t < s.until);\n    this.prevS = T.s;\n  }\n\n  // ---- checkpoints (section 4.9) ----\n  recordCheckpoint(why) {\n    this.checkpoint = { why, s: this.train.s, clock: this.clock(), halo: this.halo, score: this.score, comfort: this.comfort, stopIdx: this.stopIdx,\n      fired: this.fired.slice(), t: this.t, stats: JSON.parse(JSON.stringify(this.stats)), others: this.others.map(o => ({ id: o.id, s: o.s, v: o.v, leg: o.leg, done: o.done })) };\n  }\n  /** the maximum score the stage can give (section 4.9 \"Max\") and the rank cut-offs */\n  maxPoints() {\n    const stops = this.stops.filter(x => x.st && x.arrival !== null).length + this.stops.filter(x => x.st).length;\n    const calls = this.calls.filter(c => c.kind === 'signal' || c.kind === 'limit' || c.kind === 'approach' || c.kind === 'horn').length;\n    const horns = this.route.horns.filter(h => h.s >= this.stageSpan[0] && h.s <= this.stageSpan[1]).length;\n    const maxHalo = this.haloStart + this.stops.length * 10 + horns * 1 + calls * 0.5;\n    return stops * (1000 + 500 + 300) + calls * 100 + horns * 100 + 800 + maxHalo * 50 + 100 * 5;\n  }\n  rankOf(total) {\n    const M = this.maxPoints(), f = total / M;\n    return f >= .9 ? 'S' : f >= .75 ? 'A' : f >= .55 ? 'B' : f >= .35 ? 'C' : 'D';\n  }\n  totals() {\n    const halo = Math.max(0, this.halo), base = this.score;\n    const bonus = halo * 50 + this.comfort * 5;\n    return { score: this.score, halo: Math.round(halo), comfort: Math.round(this.comfort), total: Math.round(base + bonus), max: Math.round(this.maxPoints()) };\n  }\n\n  // ---- what the scenes and tests read ----\n  snapshot() {\n    const T = this.train, next = this.stops[this.stopIdx] || null;\n    const ahead = this.signals.filter(g => g.s > T.s).slice(0, 3).map(g => ({ id: g.id, dist: Math.round(g.s - T.s), aspect: g.aspect, sighted: this.sighted.has(g.id) }));\n    return {\n      t: Math.round(this.t * 100) / 100, clock: DH.clock(this.clock()), s: Math.round(T.s * 10) / 10, km: Math.round(T.s) / 1000, v: Math.round(T.v * 10) / 10,\n      notch: T.notchName, P: T.P, B: T.B, a: T.a, jerk: T.jerk, eb: T.eb, slip: T.slipT > 0, slide: T.slide,\n      halo: Math.round(this.halo * 10) / 10, score: Math.round(this.score), comfort: Math.round(this.comfort), limit: this.limitInForce(),\n      nextStop: next ? { id: next.id, dist: Math.round(next.target - T.s), target: next.target, arr: next.arr || null } : null,\n      signals: ahead, lastJudgment: this.judgments.length ? this.judgments[this.judgments.length - 1] : null, judgments: this.judgments.map(j => j.label),\n      events: this.fired.slice(), doors: this.doorsOpen(), pilot: this.pilotLit(), ats: { ringing: this.atsRinging, confirmed: this.atsOn },\n      stopped: Math.abs(T.v) < 0.05, finished: this.finished, gameOver: this.gameOver, stats: JSON.parse(JSON.stringify(this.stats)),\n      weather: this.weather, fogDist: this.fogDist, call: this.callOpen ? this.callOpen.kind : null, backup: !!this.backup,\n      obstruction: !!(this.obstruction && this.obstruction.active), difficulty: this.difficulty, toasts: this.toasts.map(t => t.text),\n      others: this.others.map(o => ({ id: o.id, s: Math.round(o.s), v: Math.round(o.v), lane: o.lane, done: o.done }))\n    };\n  }\n}\nDH.Sim = Sim;\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JGAFCoBzdYVSaGZjiApK1B","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/31-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"b4b0c4ba-965f-4ac1-9b30-2f55e5bb417e","timestamp":"2026-11-04T12:16:09.178Z","tool_use_result":{"type":"update","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/31-sim.js","content":"/* Densha de Halo! · 31-sim: the world of a stage, stepped at 1/120 s. Pure: no drawing, no sound, no engine.\n * It owns the train (30-train), the signals and blocks, the other trains, the speed limits, ATS, the stops and the dwell\n * and departure sequence, the timetable and the clock, Halo Time, the score and comfort, the calls and the horn, the\n * crossings and the events. Scenes read it through snapshot() and steer it through cmd(). Rules: sections 4.4 to 4.11.\n * Each step runs in the order of section 3.4. Everything that happens is announced on bus ('sound', 'judgment', ...). */\n(() => {\n'use strict';\nconst DH = window.DH;\n\nconst DIFF = {\n  easy: { name: 'Easy', grace: 40 / 25, win: 1.5, pen: 0.5 },\n  normal: { name: 'Normal', grace: 1, win: 1.0, pen: 1.0 },\n  expert: { name: 'Expert', grace: 15 / 25, win: 0.7, pen: 1.5 }\n};\nDH.DIFF = DIFF;\nconst ASPECT_SPEED = { G: null, YG: 65, Y: 45, YY: 25, R: 0 };   // G means the line speed\nDH.ASPECT_SPEED = ASPECT_SPEED;\nconst LAMPS = { R: [0, 0, 1, 0], Y: [1, 0, 0, 0], YG: [1, 1, 0, 0], G: [0, 1, 0, 0], YY: [1, 0, 0, 1] };\nDH.LAMPS = LAMPS;\n\n/* another train: its own speed and legs (no lag model; it never affects the player's train, only the blocks it occupies).\n * A leg: { v (km/h target), acc (km/h/s), until (route s, stop passing it), stopAt (route s, stop there), dwell (s), lane,\n * wait (s before it starts), at (the clock to start at) } */\nclass TrainActor {\n  constructor(o) {\n    this.id = o.id; this.kind = o.kind || 'other'; this.spec = DH.TRAINS[o.train || 'freight'];\n    this.lane = o.lane || 'B'; this.dir = o.dir || 1; this.s = o.s; this.v = o.v || 0;\n    this.cars = o.cars || (this.spec ? this.spec.cars : 4); this.carLen = 20;\n    this.legs = (o.legs || []).map(l => Object.assign({}, l)); this.leg = 0; this.wait = 0;\n    this.clockAt = o.clockAt === undefined ? null : o.clockAt; this.done = false;\n    this.light = o.light || 'tail';\n  }\n  get length() { return this.cars * this.carLen; }\n  get rear() { return this.s - this.dir * this.length; }\n  span() { return this.dir > 0 ? [this.rear, this.s] : [this.s, this.rear]; }\n  step(dt, world) {\n    if (this.done) return;\n    if (this.clockAt !== null && world.clock() < this.clockAt) return;\n    const L = this.legs[this.leg];\n    if (!L) { this.v = Math.max(0, this.v - 6 * dt); this.s += this.dir * this.v / 3.6 * dt; if (this.v === 0) this.done = true; return; }\n    if (L.lane) this.lane = L.lane;\n    if (this.wait > 0) { this.wait -= dt; this.v = 0; if (this.wait <= 0) this.leg++; return; }\n    const acc = L.acc || 4, want = L.v === undefined ? this.v : L.v;\n    this.v += DH.clamp(want - this.v, -acc * dt, acc * dt);\n    if (L.stopAt !== undefined) {\n      const remain = (L.stopAt - this.s) * this.dir;\n      const brake = (this.v / 3.6) ** 2 / (2 * Math.max(acc, .5) / 3.6);   // distance to stop from here, at its decel\n      if (remain <= brake + .05 || remain <= .05) {\n        const k = (this.v / 3.6) ** 2 > 0 ? 1 : 1;\n        void k;\n        if (this.v > 0) { this.v = Math.max(0, this.v - acc * dt * 2); }\n        if (remain <= .05 || this.v <= 0.01) { this.s = L.stopAt; this.v = 0; this.wait = L.dwell || 0; if (!L.dwell) this.leg++; else this.leg++; return; }\n      }\n    }\n    this.s += this.dir * this.v / 3.6 * dt;\n    if (L.until !== undefined && (this.s - L.until) * this.dir >= 0) this.leg++;\n  }\n}\nDH.TrainActor = TrainActor;\n\nclass Sim {\n  constructor(stage, route, opts = {}) {\n    this.stage = stage; this.route = route; this.opts = opts;\n    this.difficulty = opts.difficulty || 'normal'; this.D = DIFF[this.difficulty] || DIFF.normal;\n    this.t = 0; this.clockOffset = DH.parseClock(stage.startClock || '06:40:00');\n    this.bus = new DH.Bus();\n    this.spec = DH.TRAINS[stage.train || 'h8000'];\n    this.cars = stage.cars || 6;\n    this.train = new DH.Train(this.spec, { s: stage.startS || 0 });\n    this.train.cars = this.cars;\n    this.weather = stage.weather || 'clear'; this.dryRail = this.weather !== 'rain';\n    this.fogDist = this.weather === 'fog' ? 180 : 900;\n    this.hour = stage.hour === undefined ? 12 : stage.hour;\n    // scoring and state\n    this.halo = 0; this.haloStart = Math.round(DH.TUNING.graceStart * this.D.grace); this.haloMax = 99;\n    this.score = 0; this.comfort = 100; this.comfortCalm = 0; this.gameOver = false; this.finished = false;\n    this.stats = { stops: 0, perfect: 0, great: 0, good: 0, ok: 0, onTime: 0, late: 0, early: 0, smooth: 0, short: 0, overruns: 0, over: 0,\n      calls: 0, callsGreat: 0, horn: 0, hornMiss: 0, slips: 0, ats: 0, spad: 0, limit: 0, ebs: 0, km: 0, hazard: 0, missed: 0, wrong: 0, rollback: 0 };\n    this.judgments = []; this.toasts = []; this.subtitles = []; this.log = [];\n    this.events = new Set(); this.fired = [];\n    this.sighted = new Set(); this.atsLatched = new Set(); this.spadLatched = new Set(); this.signalPassed = new Set();\n    this.limitBroken = false; this.limitPeak = 0; this.slowOrder = null; this.aspectCap = null;\n    this.atsRinging = false; this.atsTimer = 0; this.atsOn = false; this.speedAlarm = false;\n    this.horn = { held: false, tHeld: 0, sounded: new Set(), missed: new Set() };\n    this.dwell = null; this.backup = null; this.obstruction = null; this.crossingGates = {};\n    this.lastDecel = 0; this.lastEbS = -1e9; this.prevS = this.train.s; this.readySignals = new Set();\n    this.firstPowerDone = false; this.callOpen = null; this.departedFlag = false;\n    this.checkpoint = null;\n    this.setup();\n  }\n\n  // ---- the stage's set-up: stops, signals, calls, the others ----\n  setup() {\n    const st = this.stage, R = this.route;\n    this.stops = (st.stops || []).map(x => {\n      const station = R.stationById(x.id);\n      const target = R.stopOf(x.id, this.cars);\n      const tgt = target !== undefined ? target : (station && station.stops ? Object.values(station.stops)[0] : this.train.s);\n      return Object.assign({}, x, { st: station, target: tgt, arrival: x.arr ? DH.parseClock(x.arr) : null, departure: x.dep ? DH.parseClock(x.dep) : null,\n        judged: false, done: false, restops: 0, shortT: null, startSig: station ? R.signals.find(g => g.kind === 'start' && g.s >= station.end - 5 && g.s <= station.end + 420) || null : null });\n    });\n    this.passes = (st.passes || []).map(p => { const station = R.stationById(p.id); return { id: p.id, at: station ? station.start : p.at, arr: p.at, passed: false }; });\n    this.signals = R.signals.slice().sort((a, b) => a.s - b.s);\n    for (const g of this.signals) g.aspect = 'R';\n    this.others = (st.trains || []).map(o => new TrainActor(o));\n    this.limits = R.limits.slice();\n    this.buildCalls();\n    this.stopIdx = 0;\n    if (st.startStopped) {   // the stage opens with the train standing at its first stop, doors open\n      const first = this.stops[0];\n      this.train.s = first.target; this.train.v = 0; this.stopIdx = 1; first.judged = true; first.done = true;\n      this.beginDwell(first, this.clockOffset, true);\n    }\n    this.prevS = this.train.s;\n    this.recordCheckpoint('start');\n  }\n  buildCalls() {\n    const R = this.route, calls = this.calls = [];\n    const add = (o) => calls.push(Object.assign({ called: false }, o));\n    for (const g of this.signals) add({ s: g.s, id: g.id, kind: 'signal', sig: g.id });\n    for (const L of this.limits) add({ s: L.s, id: 'lim' + L.s, kind: 'limit', v: L.v });\n    for (const h of R.horns) add({ s: h.s, id: 'horn' + h.s, kind: 'horn' });\n    for (const x of this.stops) if (x.st) add({ s: x.st.start - 400, id: 'app' + x.id, kind: 'approach', stopId: x.id });\n    for (const p of this.passes) add({ s: p.at - 400, id: 'pass' + p.id, kind: 'pass' });\n  }\n\n  // ---- the clock and the lever ----\n  clock() { return this.clockOffset + this.t; }\n  pilotLit() { return !this.dwell || this.dwell.pilotLit; }\n  doorsOpen() { return !!(this.dwell && this.dwell.doorsOpen); }\n  cmd(name, val) {\n    const T = this.train;\n    if (this.gameOver || this.finished) return null;\n    switch (name) {\n      case 'power': {\n        if (this.dwell && !this.dwell.pilotLit && T.notch >= 0 && !T.eb) this.bus.emit('note', 'doors');\n        const moved = T.power();\n        if (moved) this.bus.emit('notch', { name: T.notchName, dir: 1 });\n        if (T.eb === false && moved && this.callOpen && this.callOpen.kind === 'departure' && !this.firstPowerDone) this.firstPowerDone = true;\n        return moved;\n      }\n      case 'brake': { const moved = T.brake(); if (moved) this.bus.emit('notch', { name: T.notchName, dir: -1 }); return moved; }\n      case 'neutral': if (!T.eb) { T.neutral(); this.bus.emit('notch', { name: 'N', dir: 0 }); } return true;\n      case 'eb': if (!T.eb) this.emergency(); return true;\n      case 'ats': return this.confirmATS();\n      case 'horn': this.setHorn(!!val); return true;\n      case 'call': return this.call();\n      default: return null;\n    }\n  }\n  emergency() {\n    const T = this.train;\n    if (T.eb) return;\n    T.emergency(); this.stats.ebs++; this.lastEbS = T.s;\n    this.penalty(15);\n    if (!this.hazardOn()) { this.addTime(-3 * this.D.pen, 'EMERGENCY'); this.addScore(-200); }\n    this.bus.emit('eb');\n  }\n  hazardOn() { return !!(this.obstruction && this.obstruction.active && !this.obstruction.passed); }\n\n  // ---- the halo time, score, comfort and the toasts ----\n  addTime(v, why) {\n    if (!v) return;\n    this.halo = Math.min(this.haloMax, this.halo + v);\n    this.toast(why, v);\n    if (this.halo <= 0 && !this.gameOver) { this.halo = 0; this.gameOver = true; this.bus.emit('gameover'); }\n  }\n  addScore(p) { this.score += p; }\n  toast(text, v) { this.toasts.push({ text, v, t: this.t }); if (this.toasts.length > 4) this.toasts.shift(); }\n  judge(label, halo, pts) { this.judgments.push({ label, t: this.t, halo, pts }); this.bus.emit('judgment', { label, halo, pts }); }\n  setSubtitle(who, text) { this.subtitles.push({ who, text, t: this.t, until: this.t + 4.5 }); if (this.subtitles.length > 2) this.subtitles.shift(); this.bus.emit('line', { who, text }); }\n  penalty(c) { this.comfort = Math.max(0, this.comfort - c * DH.TUNING.comfortSens); }\n\n  // ---- signals and blocks (section 4.4) ----\n  occupied(a, b) {\n    const T = this.train;\n    if (T.s > a && T.rear < b) return true;\n    for (const o of this.others) {\n      if (o.done || o.lane !== 'A') continue;\n      const [lo, hi] = o.span(); if (hi > a && lo < b) return true;\n    }\n    return false;\n  }\n  aspectOf(g) {\n    if (g.kind === 'shunt') return 'R';\n    if (g.forced) return g.forced;\n    if (g.kind === 'start' && !this.readySignals.has(g.id)) return 'R';\n    if (g.obstruct && this.hazardOn()) return 'R';\n    const i0 = this.signals.indexOf(g);\n    let c = 0;\n    for (let i = i0; i < this.signals.length && c < 3; i++) {\n      const sg = this.signals[i], nxt = this.signals[i + 1] ? this.signals[i + 1].s : this.route.to;\n      if (this.occupied(sg.s, nxt)) break;\n      if (i > i0 && sg.kind === 'start' && !this.readySignals.has(sg.id)) break;\n      c++;\n    }\n    return ['R', 'Y', 'YG', 'G'][Math.min(c, 3)];\n  }\n  updateSignals() {\n    const T = this.train, prev = this.prevS;\n    for (const g of this.signals) {\n      const prevAsp = g.aspect;\n      g.aspect = this.aspectOf(g);\n      const d = g.s - T.s;\n      const range = this.fogDist < 400 ? 180 : 600;\n      if (!this.sighted.has(g.id) && d >= 0 && d <= range) { this.sighted.add(g.id); this.bus.emit('sighted', { id: g.id, aspect: g.aspect }); }\n      // the front crosses the signal this step: a red at that moment is a SPAD\n      if (prev < g.s && T.s >= g.s && !this.signalPassed.has(g.id)) {\n        this.signalPassed.add(g.id);\n        if (prevAsp === 'R' && g.kind !== 'shunt' && !this.spadLatched.has(g.id)) this.spad(g);\n      }\n    }\n    let last = null;\n    for (const g of this.signals) if (g.s <= T.s) last = g;\n    this.lastPassed = last;\n    this.aspectCap = last && last.aspect !== 'G' ? ASPECT_SPEED[last.aspect] : null;\n  }\n  spad(g) {\n    this.spadLatched.add(g.id); this.stats.spad++;\n    this.addTime(-20 * this.D.pen, 'SIGNAL PASSED AT DANGER'); this.addScore(-1000); this.penalty(15);\n    this.judge('SIGNAL PASSED AT DANGER', -20 * this.D.pen, -1000);\n    this.setSubtitle('Hoshino', 'Stop! That was a red.');\n    this.bus.emit('spad', { id: g.id });\n    this.emergency();\n  }\n  confirmATS() {\n    if (!this.atsRinging) return false;\n    this.atsRinging = false; this.atsOn = true;\n    this.bus.emit('atsConfirm'); this.toast('ATS CONFIRM', 0);\n    return true;\n  }\n  updateATS(dt) {\n    const T = this.train, prev = this.prevS;\n    for (const g of this.signals) {\n      if (g.kind === 'shunt') continue;\n      const beacon = g.s - 600;\n      if (prev < beacon && T.s >= beacon && g.aspect === 'R' && !this.atsLatched.has(g.id)) {\n        this.atsLatched.add(g.id);\n        if (T.s < g.s) {\n          this.atsRinging = true; this.atsTimer = DH.TUNING.atsTime; this.stats.ats++;\n          this.bus.emit('ats', { id: g.id }); this.toast('ATS!', 0);\n          this.setSubtitle('Hoshino', 'ATS. Confirm it, then brake.');\n        }\n      }\n    }\n    if (this.atsRinging) {\n      this.atsTimer -= dt;\n      if (this.atsTimer <= 0) { this.atsRinging = false; this.addTime(-3 * this.D.pen, 'ATS EB'); this.emergency(); }\n    }\n    if (this.atsOn && (T.v < 15 || (this.lastPassed && this.lastPassed.aspect !== 'R' && this.lastPassed.aspect !== 'Y'))) this.atsOn = false;\n    // the speed check: over the limit by more than 10 km/h fires the brake, once per section\n    const lim = this.limitInForce(), over = T.v - lim;\n    if (over > 10 && !this.speedAlarm && !T.eb) { this.speedAlarm = true; this.addTime(-3 * this.D.pen, 'ATS EB'); this.emergency(); }\n    if (over < 0) this.speedAlarm = false;\n  }\n\n  // ---- speed limits (section 4.5) ----\n  limitInForce() {\n    const T = this.train, R = this.route;\n    let lim = R.lineSpeedAt(T.s) || 85;\n    if (this.stage.lineSpeed) lim = Math.min(lim, this.stage.lineSpeed);\n    for (const L of this.limits) {\n      // in force while the front is in its section, and the section lasts until its END board (the rear passes it)\n      if (T.s >= L.s && (L.end === null || T.rear <= L.end || T.s <= L.end)) lim = Math.min(lim, L.v);\n    }\n    if (this.aspectCap !== null) lim = Math.min(lim, this.aspectCap);\n    if (this.slowOrder) lim = Math.min(lim, this.slowOrder);\n    return lim;\n  }\n  updateLimits() {\n    const T = this.train, lim = this.limitInForce(), tol = DH.TUNING.limitTol, over = T.v - lim;\n    if (over > tol) {\n      if (!this.limitBroken) {\n        this.limitBroken = true; this.limitPeak = over; this.stats.limit++;\n        this.addTime(-2 * this.D.pen, 'LIMIT!'); this.addScore(-300); this.penalty(3);\n        this.judge('LIMIT!', -2 * this.D.pen, -300); this.bus.emit('limit', { v: lim });\n      } else if (over > this.limitPeak + 5) {\n        const extra = Math.floor((over - this.limitPeak) / 5); this.limitPeak = over;\n        this.addTime(-extra * this.D.pen, 'LIMIT!');\n      }\n    } else if (over < 0 && this.limitBroken) { this.limitBroken = false; this.limitPeak = 0; }\n  }\n\n  // ---- crossings, gates and the obstruction (section 4.11) ----\n  updateCrossings() {\n    const T = this.train;\n    for (const c of this.route.crossings) {\n      const d = c.s - T.s;\n      let g = this.crossingGates[c.id] || (this.crossingGates[c.id] = { down: false });\n      if (!g.down && d > -20 && (d < 500 || (T.v > 1 && d / (T.v / 3.6) < 25))) { g.down = true; this.bus.emit('gates', { id: c.id, down: true }); }\n      if (g.down && T.rear > c.s + 12) { g.down = false; this.bus.emit('gates', { id: c.id, down: false }); }\n    }\n    const st = this.stage.obstruction;\n    if (st && !this.obstruction) {\n      const c = this.route.crossings.find(x => x.id === st.id);\n      if (c && c.s - T.s < 350 && c.s - T.s > -20) {\n        this.obstruction = { id: st.id, active: true, passed: false, stoppedAt: null, counted: false };\n        this.bus.emit('obstruction', { id: st.id, on: true }); this.fire('obstruction');\n      }\n    }\n    const ob = this.obstruction;\n    if (ob && ob.active) {\n      const c = this.route.crossings.find(x => x.id === ob.id);\n      if (c && !ob.passed && T.s > c.s - 1 && T.rear < c.s + 1) {\n        ob.passed = true; this.addTime(-3 * this.D.pen, 'HAZARD'); this.addScore(-200); this.stats.hazard--; this.bus.emit('hazard');\n        this.emergency();\n      }\n      if (c && !ob.counted && T.v === 0 && T.s < c.s - 3) {\n        ob.counted = true; ob.stoppedAt = this.t;\n        this.addTime(5, 'HAZARD AVOIDED'); this.addScore(800); this.stats.hazard++; this.judge('HAZARD AVOIDED', 5, 800);\n        this.setSubtitle('Mika', 'The crossing alarm! Something is on the tracks!');\n      }\n      if (ob.stoppedAt !== null && this.t - ob.stoppedAt > 12) { ob.active = false; this.bus.emit('obstruction', { id: ob.id, on: false }); }\n    }\n  }\n\n  // ---- the horn (section 4.7) ----\n  setHorn(on) {\n    const H = this.horn;\n    if (on && !H.held) { H.held = true; H.tHeld = 0; this.bus.emit('horn', { on: true }); }\n    if (!on && H.held) { H.held = false; this.bus.emit('horn', { on: false }); }\n  }\n  updateHorn(dt) {\n    const H = this.horn, T = this.train;\n    if (H.held) H.tHeld += dt;\n    for (const h of this.route.horns) {\n      if (h.s < this.stageSpan[0] || h.s > this.stageSpan[1]) continue;\n      const key = 'horn' + h.s, inZone = T.s >= h.s && T.s < h.s + h.zone;\n      if (inZone && H.held && H.tHeld >= 0.5 && !H.sounded.has(key)) {\n        H.sounded.add(key); this.stats.horn++;\n        this.addTime(1, 'HORN +1'); this.addScore(100); this.judge('HORN +1', 1, 100);\n        this.bus.emit('hornOK', { s: h.s });\n      }\n      if (T.s >= h.s + h.zone && !H.sounded.has(key) && !H.missed.has(key)) {\n        H.missed.add(key); this.stats.hornMiss++;\n        if (this.difficulty !== 'easy') this.addTime(-1 * this.D.pen, 'NO HORN');\n      }\n    }\n    if (H.held && this.route.workers) for (const w of this.route.workers) if (T.s > w.s - 300 && T.s < w.until) this.bus.emit('workersHeard', { s: w.s });\n  }\n\n  // ---- the calls (section 4.7) ----\n  openCall(kind) { this.callOpen = { kind, opened: this.t, made: false }; this.firstPowerDone = false; this.bus.emit('callOpen', { kind }); }\n  call() {\n    const T = this.train;\n    if (this.callOpen && this.callOpen.kind === 'departure') {\n      const great = !this.firstPowerDone;\n      this.callOpen.made = true; this.callOpen = null;\n      this.scoreCall(great, 'departure');\n      return { kind: 'departure', great };\n    }\n    let best = null, bd = 1e9;\n    for (const c of this.calls) {\n      if (c.called || c.s < this.stageSpan[0] || c.s > this.stageSpan[1] + 400) continue;\n      const d = c.s - T.s;\n      if (d > 30 && d <= 180 && d < bd && (c.kind !== 'signal' || this.sighted.has(c.sig))) { best = c; bd = d; }\n    }\n    if (!best) { this.bus.emit('callMiss'); return null; }\n    best.called = true;\n    const great = bd >= 60 && bd <= DH.TUNING.callGreat;\n    this.scoreCall(great, best.kind, best);\n    return { kind: best.kind, great, point: best };\n  }\n  scoreCall(great, kind, point) {\n    this.stats.calls++;\n    if (great) { this.stats.callsGreat++; this.addTime(0.5, 'CALL GREAT'); this.addScore(100); this.judge('CALL GREAT', .5, 100); }\n    else { this.addScore(50); this.judge('CALL', 0, 50); }\n    this.bus.emit('call', { kind, great, point: point || null });\n  }\n  updateCalls() {\n    if (this.opts.autoCalls) for (const c of this.calls) {\n      if (c.called) continue;\n      const d = c.s - this.train.s;\n      if (d <= DH.TUNING.callGreat && d > 60 && (c.kind !== 'signal' || this.sighted.has(c.sig))) { c.called = true; this.bus.emit('call', { kind: c.kind, great: true, auto: true, point: c }); }\n    }\n    if (this.callOpen && this.callOpen.kind === 'departure' && this.t - this.callOpen.opened > 60) this.callOpen = null;\n  }\n\n  // ---- stations: the stop judgment, the dwell and the departure (section 4.6) ----\n  classify(err) {\n    const W = DH.TUNING.stopWindow * this.D.win;\n    if (err > 50 || err < -50) return null;\n    if (err <= W * 1.0 && err >= -W * 1.0) return 'ok';\n    if (err < -W && err >= -5) return 'short';\n    if (err < -5) return 'moveup';\n    if (err > W && err <= 5) return 'over';\n    return 'overmark';\n  }\n  stopJudgment(x) {\n    const T = this.train, err = T.s - x.target, W = DH.TUNING.stopWindow * this.D.win;\n    let label, halo, pts;\n    if (err <= 0.10 * W) { label = 'PERFECT HALO!'; halo = 5; pts = 1000; this.stats.perfect++; }\n    else if (err <= 0.30 * W) { label = 'GREAT!'; halo = 3; pts = 700; this.stats.great++; }\n    else if (err <= 0.70 * W) { label = 'GOOD'; halo = 1; pts = 400; this.stats.good++; }\n    else { label = 'OK'; halo = 0; pts = 200; this.stats.ok++; }\n    this.finishStop(x, label, halo * (1), pts, err);\n  }\n  finishStop(x, label, halo, pts, err) {\n    this.addTime(halo, label); this.addScore(pts); this.judge(label, halo, pts);\n    x.label = label; x.err = err; x.judged = true;\n    this.arrivalJudgment(x);\n    if (this.smoothOK()) { this.stats.smooth++; this.addTime(2, 'SMOOTH!'); this.addScore(300); this.judge('SMOOTH!', 2, 300); }\n    this.stats.stops++;\n    this.beginDwell(x, this.clock());\n  }\n  arrivalJudgment(x) {\n    if (x.arrival === null) return;\n    const d = this.clock() - x.arrival, W = DH.TUNING.onTimeWindow;\n    if (Math.abs(d) <= W) { this.stats.onTime++; this.addTime(3, 'ON TIME!'); this.addScore(500); this.judge('ON TIME!', 3, 500); }\n    else if (d > W) { const h = -DH.TUNING.lateCost * (d - W) * this.D.pen; this.stats.late++; this.addTime(h, 'LATE +' + Math.round(d)); this.judge('LATE +' + Math.round(d), h, 0); }\n    else { this.stats.early++; this.addScore(100); this.judge('EARLY', 0, 100); }\n  }\n  smoothOK() { return Math.abs(this.lastDecel) <= 1.0 && this.train.s - this.lastEbS > 100; }\n  shortStop(x, err) {\n    const short = -err;\n    this.stats.short++;\n    this.finishStop(x, 'SHORT', -short * this.D.pen, 0, err);\n    this.addTime(0, '');\n  }\n  overrunStop(x, err) {\n    this.stats.overruns++;\n    this.finishStop(x, 'OVERRUN!', -err * DH.TUNING.overrunCost * this.D.pen, 0, err);\n  }\n\n  updateStations(dt) {\n    const T = this.train, x = this.stops[this.stopIdx];\n    if (this.dwell) { this.stepDwell(); return; }\n    if (this.backup) return;\n    if (!x) { if (!this.finished && this.stops.length && !this.passesLeft()) this.endStage(); return; }\n    const err = T.s - x.target, stopped = Math.abs(T.v) < 0.05;\n    // a stop approached from below: the creep window\n    if (x.shortT !== null && T.v > 0.3 && !x.restarted) { x.restarted = true; x.restops++; this.addTime(-1 * this.D.pen, 'RE-STOP'); }\n    if (x.shortT !== null) x.shortT -= (T.v > 0.3 ? 0 : dt);\n    if (stopped && !x.judged) {\n      const cls = this.classify(err);\n      if (cls === 'ok') this.stopJudgment(x);\n      else if (cls === 'over') this.overrunStop(x, err);\n      else if (cls === 'short') {\n        if (x.shortT === null) { x.shortT = 6; x.restarted = false; this.bus.emit('short', { m: -err }); this.setSubtitle('Hoshino', 'Short. Ease forward to the mark.'); }\n        else if (x.shortT <= 0 || x.restops >= 3) this.shortStop(x, err);\n        else if (x.restarted) { x.restarted = false; if (this.classify(err) === 'ok') this.stopJudgment(x); }\n      } else if (cls === 'overmark') {\n        this.backup = { x, target: x.target };\n        this.addTime(-10 * this.D.pen, 'OVER THE MARK'); this.addScore(-300); this.stats.over++; this.judge('OVER THE MARK', -10 * this.D.pen, -300);\n        this.setSubtitle('Hoshino', 'Back up to the mark.');\n      }\n    }\n    // past the mark without stopping: a missed stop\n    if (!x.judged && T.s > x.target + 50) {\n      x.judged = true; x.done = true; this.stats.missed++;\n      this.addTime(-10 * this.D.pen, 'MISSED STOP'); this.addScore(-300); this.judge('MISSED STOP', -10 * this.D.pen, -300);\n      this.setSubtitle('Hoshino', 'Missed. We were meant to stop there.');\n      this.stopIdx++;\n      if (this.stopIdx >= this.stops.length) this.endStage();\n    }\n  }\n  passesLeft() { return this.passes.some(p => !p.passed); }\n  /** the back-up at 5 km/h to the mark (over the mark), then the stop is judged as OK */\n  updateBackup(dt) {\n    const b = this.backup, T = this.train;\n    T.eb = false; T.notch = 0; T.v = -5; T.s -= 5 / 3.6 * dt;\n    if (T.s <= b.target + 1) {\n      T.s = Math.max(T.s, b.target); T.v = 0; this.backup = null;\n      this.finishStop(b.x, 'OK', 0, 200, T.s - b.target);\n      this.stats.ok++; this.stats.stops--;   // (counted once, in finishStop)\n    }\n  }\n  beginDwell(x, T0, initial) {\n    const dep = x.departure !== null ? x.departure : T0 + 20;\n    const min = DH.TUNING.dwell;\n    const melodyAt = Math.max(dep - 9, T0 + 6);\n    const closeAt = Math.max(melodyAt + 7, dep - 4, T0 + min);\n    this.dwell = { x, T0, dep, doorsAt: T0 + 1, melodyAt, closeAt, pilotAt: closeAt + 1.5, signalAt: 0, doorsOpen: false, melodyDone: false,\n      closed: false, pilotLit: false, rushed: false, initial: !!initial };\n    this.dwell.signalAt = Math.max(dep - 3, this.dwell.pilotAt);\n    this.phase = 'dwell';\n    this.bus.emit('doors', { open: false });\n    this.recordCheckpoint('stop');\n  }\n  stepDwell() {\n    const d = this.dwell, now = this.clock(), x = d.x;\n    if (!d.doorsOpen && !d.closed && now >= d.doorsAt) { d.doorsOpen = true; this.bus.emit('doors', { open: true }); this.bus.emit('chime', 'open'); this.passengers('alight'); }\n    if (!d.melodyDone && now >= d.melodyAt) { d.melodyDone = true; this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai' }); this.bus.emit('pa', { id: x.id }); }\n    if (d.doorsOpen && d.melodyDone && !d.closed && now >= d.closeAt) {\n      d.closed = true; d.doorsOpen = false; this.bus.emit('doors', { open: false }); this.bus.emit('chime', 'close');\n    }\n    if (d.closed && !d.buzz && now >= d.closeAt + 1) { d.buzz = true; this.bus.emit('buzzer'); }\n    if (d.closed && !d.pilotLit && now >= d.pilotAt) { d.pilotLit = true; this.bus.emit('pilot'); }\n    if (d.pilotLit && x.startSig && now >= d.signalAt) { this.readySignals.add(x.startSig.id); if (!d.departCall) { d.departCall = true; this.openCall('departure'); } }\n    if (d.pilotLit && x.startSig && !this.readySignals.has(x.startSig.id) && now >= d.signalAt) this.readySignals.add(x.startSig.id);\n    if (d.pilotLit && !x.startSig && !d.departCall) { d.departCall = true; this.openCall('departure'); }\n    // the train leaves once it's moving: the dwell ends\n    if (d.pilotLit && this.train.v > 0.5) { this.dwell = null; this.phase = 'run'; this.recordCheckpoint('depart'); }\n  }\n  passengers(what) { void what; }\n  /** a door rush (S4): the doors re-open for 8 s more */\n  doorRush() { const d = this.dwell; if (!d || d.rushed || !d.closed) return false; d.rushed = true; d.closeAt += 8; d.pilotAt += 8; d.signalAt += 8; d.closed = false; d.doorsOpen = true; d.melodyDone = true; this.bus.emit('doors', { open: true }); return true; }\n  endStage() { if (this.finished) return; this.finished = true; this.recordCheckpoint('end'); this.bus.emit('stageEnd'); }\n\n  // ---- comfort (section 4.10) ----\n  updateComfort(dt) {\n    const T = this.train;\n    if (T.eb && !this.ebHit) { this.ebHit = true; this.penalty(15); }\n    if (!T.eb) this.ebHit = false;\n    if (T.slipT > 0 && !this.slipHit) { this.slipHit = true; this.stats.slips++; this.penalty(3); this.bus.emit('slip'); this.toast('SLIP', 0); }\n    if (T.slipT <= 0) this.slipHit = false;\n    if (T.slide && !this.slideHit) { this.slideHit = true; this.penalty(3); this.bus.emit('slide'); }\n    if (!T.slide) this.slideHit = false;\n    if (Math.abs(T.a) < 1.5 && T.v > 1) this.comfortCalm += dt; else this.comfortCalm = 0;\n    if (this.comfortCalm >= 8) { this.comfortCalm = 0; this.comfort = Math.min(100, this.comfort + 1); }\n    if (this.dwell === null && T.v === 0 && this.prevV > 0 && this.lastBrakeA < -2) { this.penalty(8); }\n    this.prevV = T.v;\n    this.lastBrakeA = T.a;\n  }\n\n  // ---- events (section 4.11) ----\n  fire(id) { if (this.events.has(id)) return false; this.events.add(id); this.fired.push(id); return true; }\n  updateEvents() {\n    const T = this.train;\n    for (const e of this.stage.events || []) {\n      if (this.events.has(e.id)) continue;\n      const go = (e.at !== undefined && T.s >= e.at) || (e.clock !== undefined && this.clock() >= DH.parseClock(e.clock)) || (e.stop && this.dwell && this.dwell.x && this.dwell.x.id === e.stop && this.dwell.closed);\n      if (go) this.runEvent(e);\n    }\n  }\n  runEvent(e) {\n    this.fire(e.id);\n    switch (e.type) {\n      case 'oncoming': this.others.push(new TrainActor({ id: e.id, kind: 'oncoming', train: 'h8000', lane: e.lane || 'B', dir: -1, s: this.train.s + (e.ahead || 1400), v: 80, cars: 6, legs: [{ v: 80, acc: 4 }] })); this.bus.emit('oncoming', e); break;\n      case 'radio': this.setSubtitle(e.who, e.text); this.bus.emit('radio', e); break;\n      case 'tip': this.bus.emit('tip', e); break;\n      case 'doorRush': this.doorRush(); this.setSubtitle('Mika', 'One moment please! Doors re-opening!'); this.bus.emit('doorRush'); break;\n      case 'flash': this.flashAt = this.t; this.bus.emit('flash', e); break;\n      case 'workers': this.slowOrder = e.v || 25; this.bus.emit('workers', e); break;\n      case 'fog': this.fogDist = 180; this.bus.emit('fog', e); break;\n      case 'glare': this.bus.emit('glare', e); break;\n      case 'festival': this.bus.emit('festival', e); break;\n      case 'other': this.others.push(new TrainActor(e.train)); this.bus.emit('other', e); break;\n      default: this.bus.emit('event', e);\n    }\n  }\n\n  // ---- the step (section 3.4) ----\n  step(dt) {\n    if (this.gameOver || this.finished) return;\n    this.t += dt;\n    this.stageSpan = this.stageSpan || [this.route.from, this.route.to];\n    if (this.backup) { this.updateBackup(dt); this.prevS = this.train.s; return; }\n    const T = this.train, R = this.route;\n    const env = { grade: R.gradeAt(T.s), dry: this.dryRail, traction: this.pilotLit() && !this.doorsOpen() };\n    const before = T.s;\n    T.step(dt, env);\n    this.stats.km += Math.max(0, T.s - before) / 1000;\n    if (T.v > 0 && T.v <= 3) this.lastDecel = T.a;\n    if (T.rolled > 0.5 && !this.rollHit) { this.rollHit = true; this.stats.rollback++; this.addTime(-2 * this.D.pen, 'ROLLBACK'); this.penalty(5); }\n    for (const o of this.others) o.step(dt, this);\n    this.updateSignals();\n    this.updateATS(dt);\n    this.updateLimits();\n    this.updateCrossings();\n    this.updateHorn(dt);\n    this.updateCalls();\n    this.updateStations(dt);\n    this.updateComfort(dt);\n    this.updateEvents();\n    this.toasts = this.toasts.filter(t => this.t - t.t < 2.6);\n    this.subtitles = this.subtitles.filter(s => this.t < s.until);\n    this.prevS = T.s;\n  }\n\n  // ---- checkpoints (section 4.9) ----\n  recordCheckpoint(why) {\n    this.checkpoint = { why, s: this.train.s, clock: this.clock(), halo: this.halo, score: this.score, comfort: this.comfort, stopIdx: this.stopIdx,\n      fired: this.fired.slice(), t: this.t, stats: JSON.parse(JSON.stringify(this.stats)), others: this.others.map(o => ({ id: o.id, s: o.s, v: o.v, leg: o.leg, done: o.done })) };\n  }\n  /** the maximum score the stage can give (section 4.9 \"Max\") and the rank cut-offs */\n  maxPoints() {\n    const stops = this.stops.filter(x => x.st && x.arrival !== null).length + this.stops.filter(x => x.st).length;\n    const calls = this.calls.filter(c => c.kind === 'signal' || c.kind === 'limit' || c.kind === 'approach' || c.kind === 'horn').length;\n    const horns = this.route.horns.filter(h => h.s >= this.stageSpan[0] && h.s <= this.stageSpan[1]).length;\n    const maxHalo = this.haloStart + this.stops.length * 10 + horns * 1 + calls * 0.5;\n    return stops * (1000 + 500 + 300) + calls * 100 + horns * 100 + 800 + maxHalo * 50 + 100 * 5;\n  }\n  rankOf(total) {\n    const M = this.maxPoints(), f = total / M;\n    return f >= .9 ? 'S' : f >= .75 ? 'A' : f >= .55 ? 'B' : f >= .35 ? 'C' : 'D';\n  }\n  totals() {\n    const halo = Math.max(0, this.halo), base = this.score;\n    const bonus = halo * 50 + this.comfort * 5;\n    return { score: this.score, halo: Math.round(halo), comfort: Math.round(this.comfort), total: Math.round(base + bonus), max: Math.round(this.maxPoints()) };\n  }\n\n  // ---- what the scenes and tests read ----\n  snapshot() {\n    const T = this.train, next = this.stops[this.stopIdx] || null;\n    const ahead = this.signals.filter(g => g.s > T.s).slice(0, 3).map(g => ({ id: g.id, dist: Math.round(g.s - T.s), aspect: g.aspect, sighted: this.sighted.has(g.id) }));\n    return {\n      t: Math.round(this.t * 100) / 100, clock: DH.clock(this.clock()), s: Math.round(T.s * 10) / 10, km: Math.round(T.s) / 1000, v: Math.round(T.v * 10) / 10,\n      notch: T.notchName, P: T.P, B: T.B, a: T.a, jerk: T.jerk, eb: T.eb, slip: T.slipT > 0, slide: T.slide,\n      halo: Math.round(this.halo * 10) / 10, score: Math.round(this.score), comfort: Math.round(this.comfort), limit: this.limitInForce(),\n      nextStop: next ? { id: next.id, dist: Math.round(next.target - T.s), target: next.target, arr: next.arr || null } : null,\n      signals: ahead, lastJudgment: this.judgments.length ? this.judgments[this.judgments.length - 1] : null, judgments: this.judgments.map(j => j.label),\n      events: this.fired.slice(), doors: this.doorsOpen(), pilot: this.pilotLit(), ats: { ringing: this.atsRinging, confirmed: this.atsOn },\n      stopped: Math.abs(T.v) < 0.05, finished: this.finished, gameOver: this.gameOver, stats: JSON.parse(JSON.stringify(this.stats)),\n      weather: this.weather, fogDist: this.fogDist, call: this.callOpen ? this.callOpen.kind : null, backup: !!this.backup,\n      obstruction: !!(this.obstruction && this.obstruction.active), difficulty: this.difficulty, toasts: this.toasts.map(t => t.text),\n      others: this.others.map(o => ({ id: o.id, s: Math.round(o.s), v: Math.round(o.v), lane: o.lane, done: o.done }))\n    };\n  }\n}\nDH.Sim = Sim;\n})();\n","structuredPatch":[{"oldStart":1,"oldLines":51,"newStart":1,"newLines":55,"lines":[" /* Densha de Halo! · 31-sim: the world of a stage, stepped at 1/120 s. Pure: no drawing, no sound, no engine.","- * It owns the train (30-train), the signals and blocks, the other trains, the limits, ATS, the stops, the dwell and the","- * departure sequence, the timetable and the clock, Halo Time, the score and comfort, the calls and the horn, and the events.","- * The scenes read it through snapshot() and send it commands through cmd(). Rules: section 4.4 to 4.11. */","+ * It owns the train (30-train), the signals and blocks, the other trains, the speed limits, ATS, the stops and the dwell","+ * and departure sequence, the timetable and the clock, Halo Time, the score and comfort, the calls and the horn, the","+ * crossings and the events. Scenes read it through snapshot() and steer it through cmd(). Rules: sections 4.4 to 4.11.","+ * Each step runs in the order of section 3.4. Everything that happens is announced on bus ('sound', 'judgment', ...). */"," (() => {"," 'use strict';"," const DH = window.DH;"," "," const DIFF = {","-  easy: { name: 'Easy', grace: 40 / 25, win: 1.5, pen: 0.5, guide: true, calls: 'auto?' },","+  easy: { name: 'Easy', grace: 40 / 25, win: 1.5, pen: 0.5 },","   normal: { name: 'Normal', grace: 1, win: 1.0, pen: 1.0 },","   expert: { name: 'Expert', grace: 15 / 25, win: 0.7, pen: 1.5 }"," };"," DH.DIFF = DIFF;"," const ASPECT_SPEED = { G: null, YG: 65, Y: 45, YY: 25, R: 0 };   // G means the line speed"," DH.ASPECT_SPEED = ASPECT_SPEED;","-","-/* the aspect a 4-lamp head shows from the clear blocks ahead (section 4.4): 0 -> R, 1 -> Y, 2 -> YG, 3+ -> G */"," const LAMPS = { R: [0, 0, 1, 0], Y: [1, 0, 0, 0], YG: [1, 1, 0, 0], G: [0, 1, 0, 0], YY: [1, 0, 0, 1] };"," DH.LAMPS = LAMPS;"," ","-/* a train that is not the player's: an oncoming train, a freight, a rival. Its legs are a script; it moves at a set speed","- * (its own lag-free model; it never affects the player's train except by occupying blocks on its own lane) */","+/* another train: its own speed and legs (no lag model; it never affects the player's train, only the blocks it occupies).","+ * A leg: { v (km/h target), acc (km/h/s), until (route s, stop passing it), stopAt (route s, stop there), dwell (s), lane,","+ * wait (s before it starts), at (the clock to start at) } */"," class TrainActor {","   constructor(o) {","-    Object.assign(this, { id: o.id, kind: o.kind || 'other', spec: DH.TRAINS[o.train || 'freight'], lane: o.lane || 'B', dir: o.dir || 1,","-      s: o.s, v: o.v || 0, cars: o.cars || 4, legs: (o.legs || []).slice(), leg: 0, wait: 0, livery: o.livery || null, clockAt: o.clockAt || null, done: false, log: [] });","-    this.cars = this.cars || (this.spec ? this.spec.cars : 4);","-    this.nose = o.nose || '#ffffff';","+    this.id = o.id; this.kind = o.kind || 'other'; this.spec = DH.TRAINS[o.train || 'freight'];","+    this.lane = o.lane || 'B'; this.dir = o.dir || 1; this.s = o.s; this.v = o.v || 0;","+    this.cars = o.cars || (this.spec ? this.spec.cars : 4); this.carLen = 20;","+    this.legs = (o.legs || []).map(l => Object.assign({}, l)); this.leg = 0; this.wait = 0;","+    this.clockAt = o.clockAt === undefined ? null : o.clockAt; this.done = false;","+    this.light = o.light || 'tail';","   }","-  get length() { return this.cars * 20; }","-  get rear() { return this.dir > 0 ? this.s - this.length : this.s + this.length; }","-  /** the segment spans the train covers: [lo, hi] in route metres */","+  get length() { return this.cars * this.carLen; }","+  get rear() { return this.s - this.dir * this.length; }","   span() { return this.dir > 0 ? [this.rear, this.s] : [this.s, this.rear]; }","   step(dt, world) {","     if (this.done) return;","     if (this.clockAt !== null && world.clock() < this.clockAt) return;","-    if (this.leg >= this.legs.length) { this.v = Math.max(0, this.v - 5 * dt); this.s += this.dir * this.v / 3.6 * dt; this.done = this.v === 0 && !this.legs.length; return; }","     const L = this.legs[this.leg];","+    if (!L) { this.v = Math.max(0, this.v - 6 * dt); this.s += this.dir * this.v / 3.6 * dt; if (this.v === 0) this.done = true; return; }","     if (L.lane) this.lane = L.lane;","     if (this.wait > 0) { this.wait -= dt; this.v = 0; if (this.wait <= 0) this.leg++; return; }","-    const target = L.v, acc = L.acc || 4;   // km/h/s","-    this.v += DH.clamp(target - this.v, -acc * dt, acc * dt);","+    const acc = L.acc || 4, want = L.v === undefined ? this.v : L.v;","+    this.v += DH.clamp(want - this.v, -acc * dt, acc * dt);","     if (L.stopAt !== undefined) {","-      const remain = (L.stopAt - this.s) * this.dir;   // metres to the stop, along the direction of travel","-      if (remain <= 0.02 || (this.v > 0 && remain < this.v / 3.6 * this.v / 3.6 / (2 * acc / 3.6) + 0.02 && L.v === 0)) {","-        this.v = 0; this.s = L.stopAt; this.wait = L.dwell || 0.05; if (!L.dwell) this.leg++;","-        return;","+      const remain = (L.stopAt - this.s) * this.dir;","+      const brake = (this.v / 3.6) ** 2 / (2 * Math.max(acc, .5) / 3.6);   // distance to stop from here, at its decel","+      if (remain <= brake + .05 || remain <= .05) {","+        const k = (this.v / 3.6) ** 2 > 0 ? 1 : 1;","+        void k;","+        if (this.v > 0) { this.v = Math.max(0, this.v - acc * dt * 2); }","+        if (remain <= .05 || this.v <= 0.01) { this.s = L.stopAt; this.v = 0; this.wait = L.dwell || 0; if (!L.dwell) this.leg++; else this.leg++; return; }","       }","     }","     this.s += this.dir * this.v / 3.6 * dt;"]},{"oldStart":54,"oldLines":487,"newStart":58,"newLines":261,"lines":[" }"," DH.TrainActor = TrainActor;"," ","-/* the sim: built from a stage and a route */"," class Sim {","   constructor(stage, route, opts = {}) {","     this.stage = stage; this.route = route; this.opts = opts;","-    this.difficulty = opts.difficulty || 'normal'; this.D = DIFF[this.difficulty];","-    this.t = 0;                     // stage time (s), paused with the game","-    this.events = new Set(); this.fired = [];","+    this.difficulty = opts.difficulty || 'normal'; this.D = DIFF[this.difficulty] || DIFF.normal;","+    this.t = 0; this.clockOffset = DH.parseClock(stage.startClock || '06:40:00');","     this.bus = new DH.Bus();","-    this.score = 0; this.comfort = 100; this.comfortRecover = 0;","-    this.halo = 0; this.haloStart = 0; this.haloMax = 99;","-    this.log = [];                   // judgments and penalties, for the results and the story","-    this.toasts = []; this.judgments = []; this.subtitles = [];","-    this.stats = { stops: 0, perfect: 0, great: 0, good: 0, ok: 0, onTime: 0, late: 0, early: 0, smooth: 0, calls: 0, callsGreat: 0, horn: 0, overruns: 0, slips: 0, ats: 0, spad: 0, limit: 0, ebs: 0, km: 0 };","-    this.maxPoints = 0; this.maxStat = { stops: 0, onTime: 0, smooth: 0, calls: 0, horn: 0, hazard: 0 };","-    this.gameOver = false; this.finished = false; this.results = null;","-    this.lastCall = null; this.callOpen = null;","-    this.sighted = new Set(); this.atsLatched = new Set(); this.spadLatched = new Set(); this.limitArmed = new Map();","-    this.station = null; this.stopIdx = 0; this.phase = 'run';","-    this.dwell = null; this.departed = false;","-    this.readySignals = new Set(); this.signalPassed = new Set();","-    this.weather = stage.weather || 'clear'; this.fogDist = 900; this.hour = stage.hour || 12;","-    this.lineLimit = null; this.aspectCap = null; this.lastAspect = 'G';","-    this.horn = { held: false, zoneFrom: null, sounded: new Set(), tHeld: 0 };","-    this.atsRinging = false; this.atsConfirmTimer = 0; this.atsOn = false; this.speedAlarm = false;","-    this.backup = null; this.obstruction = null; this.rollbackWarn = 0;","-    this.checkpoint = null;","-    this.halted = false;","     this.spec = DH.TRAINS[stage.train || 'h8000'];","-    this.train = new DH.Train(this.spec, { s: opts.s0 !== undefined ? opts.s0 : (stage.startS || 0) });","-    this.train.dir = 1;","-    this.train.cars = stage.cars || 6;","-    this.dryRail = this.weather !== 'rain';","-    this.others = [];","+    this.cars = stage.cars || 6;","+    this.train = new DH.Train(this.spec, { s: stage.startS || 0 });","+    this.train.cars = this.cars;","+    this.weather = stage.weather || 'clear'; this.dryRail = this.weather !== 'rain';","+    this.fogDist = this.weather === 'fog' ? 180 : 900;","+    this.hour = stage.hour === undefined ? 12 : stage.hour;","+    // scoring and state","+    this.halo = 0; this.haloStart = Math.round(DH.TUNING.graceStart * this.D.grace); this.haloMax = 99;","+    this.score = 0; this.comfort = 100; this.comfortCalm = 0; this.gameOver = false; this.finished = false;","+    this.stats = { stops: 0, perfect: 0, great: 0, good: 0, ok: 0, onTime: 0, late: 0, early: 0, smooth: 0, short: 0, overruns: 0, over: 0,","+      calls: 0, callsGreat: 0, horn: 0, hornMiss: 0, slips: 0, ats: 0, spad: 0, limit: 0, ebs: 0, km: 0, hazard: 0, missed: 0, wrong: 0, rollback: 0 };","+    this.judgments = []; this.toasts = []; this.subtitles = []; this.log = [];","+    this.events = new Set(); this.fired = [];","+    this.sighted = new Set(); this.atsLatched = new Set(); this.spadLatched = new Set(); this.signalPassed = new Set();","+    this.limitBroken = false; this.limitPeak = 0; this.slowOrder = null; this.aspectCap = null;","+    this.atsRinging = false; this.atsTimer = 0; this.atsOn = false; this.speedAlarm = false;","+    this.horn = { held: false, tHeld: 0, sounded: new Set(), missed: new Set() };","+    this.dwell = null; this.backup = null; this.obstruction = null; this.crossingGates = {};","+    this.lastDecel = 0; this.lastEbS = -1e9; this.prevS = this.train.s; this.readySignals = new Set();","+    this.firstPowerDone = false; this.callOpen = null; this.departedFlag = false;","+    this.checkpoint = null;","     this.setup();","   }"," ","-  // ---- setup ----","+  // ---- the stage's set-up: stops, signals, calls, the others ----","   setup() {","     const st = this.stage, R = this.route;","-    this.clockOffset = DH.parseClock(st.startClock || '06:40:00');","-    // the stops of the stage, in route order: each stop is a station with its timetable","-    this.stops = (st.stops || []).map(x => Object.assign({}, x, { st: R.stationById(x.id), target: 0 }));","-    for (const x of this.stops) {","-      const cars = this.train.cars;","-      const target = R.stopOf(x.id, cars) !== undefined ? R.stopOf(x.id, cars) : (x.st && x.st.stops ? Object.values(x.st.stops)[0] : 0);","-      x.target = target; x.arrS = target;","-      x.arrival = x.arr ? DH.parseClock(x.arr) : null; x.departure = x.dep ? DH.parseClock(x.dep) : null;","-      x.judged = false; x.attempts = 0; x.restops = 0; x.done = false; x.missed = false;","-      x.start = x.st ? x.st.start : x.target;","-      x.startSig = null;","-      // its departure signal: the first start signal in the 400 m past its platform","-      if (x.st) x.startSig = R.signals.find(g => g.kind === 'start' && g.s >= x.st.end - 5 && g.s <= x.st.end + 420) || null;","-    }","-    this.passes = (st.passes || []).map(p => Object.assign({}, p, { at: R.stationById(p.id) ? R.stationById(p.id).start : p.at }));","-    this.endS = st.endS !== undefined ? st.endS : (this.stops.length ? this.stops[this.stops.length - 1].target : this.train.s);","-    // the blocks and signals, ordered","+    this.stops = (st.stops || []).map(x => {","+      const station = R.stationById(x.id);","+      const target = R.stopOf(x.id, this.cars);","+      const tgt = target !== undefined ? target : (station && station.stops ? Object.values(station.stops)[0] : this.train.s);","+      return Object.assign({}, x, { st: station, target: tgt, arrival: x.arr ? DH.parseClock(x.arr) : null, departure: x.dep ? DH.parseClock(x.dep) : null,","+        judged: false, done: false, restops: 0, shortT: null, startSig: station ? R.signals.find(g => g.kind === 'start' && g.s >= station.end - 5 && g.s <= station.end + 420) || null : null });","+    });","+    this.passes = (st.passes || []).map(p => { const station = R.stationById(p.id); return { id: p.id, at: station ? station.start : p.at, arr: p.at, passed: false }; });","     this.signals = R.signals.slice().sort((a, b) => a.s - b.s);","     for (const g of this.signals) g.aspect = 'R';","-    // the other trains from the stage's list","-    for (const o of (st.trains || [])) this.others.push(new TrainActor(o));","+    this.others = (st.trains || []).map(o => new TrainActor(o));","     this.limits = R.limits.slice();","-    this.calls = [];","     this.buildCalls();","-    // the initial state of the station the train starts at: doors open, the dwell's clock running from the stage start","-    if (st.startDwell) this.startDwell(st.startDwell);","-    this.train.v = 0;","-    this.applyWeather();","+    this.stopIdx = 0;","+    if (st.startStopped) {   // the stage opens with the train standing at its first stop, doors open","+      const first = this.stops[0];","+      this.train.s = first.target; this.train.v = 0; this.stopIdx = 1; first.judged = true; first.done = true;","+      this.beginDwell(first, this.clockOffset, true);","+    }","+    this.prevS = this.train.s;","     this.recordCheckpoint('start');","   }","-  applyWeather() {","-    const w = this.weather;","-    this.dryRail = w !== 'rain';","-    this.fogDist = w === 'fog' ? 180 : 900;","-    if (this.stage.fogDist) this.fogDist = this.stage.fogDist;","-  }","   buildCalls() {","-    const R = this.route, add = (o) => this.calls.push(Object.assign({ called: false, grade: null, key: o.id + '@' + o.s }, o));","-    for (const g of this.signals) {","-      if (g.kind === 'shunt' || g.kind === 'block' || g.kind === 'home' || g.kind === 'start') add({ s: g.s, id: g.id, kind: 'signal', sig: g.id });","-    }","+    const R = this.route, calls = this.calls = [];","+    const add = (o) => calls.push(Object.assign({ called: false }, o));","+    for (const g of this.signals) add({ s: g.s, id: g.id, kind: 'signal', sig: g.id });","     for (const L of this.limits) add({ s: L.s, id: 'lim' + L.s, kind: 'limit', v: L.v });","     for (const h of R.horns) add({ s: h.s, id: 'horn' + h.s, kind: 'horn' });","     for (const x of this.stops) if (x.st) add({ s: x.st.start - 400, id: 'app' + x.id, kind: 'approach', stopId: x.id });","-    for (const c of R.crossings) if (c.special === false) add({ s: c.s, id: 'cross' + c.id, kind: 'crossing', optional: true });","-    for (const w of R.workers || []) add({ s: w.s, id: 'work' + w.s, kind: 'workers' });","+    for (const p of this.passes) add({ s: p.at - 400, id: 'pass' + p.id, kind: 'pass' });","   }"," ","-  // ---- the clock and time ----","+  // ---- the clock and the lever ----","   clock() { return this.clockOffset + this.t; }","-  now() { return this.clock(); }","-","-  // ---- commands (from the controller, the keyboard, the autopilot) ----","+  pilotLit() { return !this.dwell || this.dwell.pilotLit; }","+  doorsOpen() { return !!(this.dwell && this.dwell.doorsOpen); }","   cmd(name, val) {","-    const T = this.train, out = {};","+    const T = this.train;","+    if (this.gameOver || this.finished) return null;","     switch (name) {","-      case 'power':","-        if (this.halted) break;","-        if (!this.pilotLit() && !T.eb && T.notch >= 0) { if (T.v === 0 && this.phase !== 'run') { this.bus.emit('buzz', 'doors'); } }","-        if (!this.pilotLit() && T.notch >= 0 && T.v === 0 && !T.eb) { this.note('doors'); T.notch = Math.min(T.notch + 1, T.spec.notchesP); break; }","-        if (T.power()) { this.bus.emit('notch', { name: T.notchName, dir: 1 }); if (!this.firstPowerDone) this.onFirstPower(); }","-        break;","-      case 'brake': if (T.brake()) this.bus.emit('notch', { name: T.notchName, dir: -1 }); break;","-      case 'neutral': if (!T.eb) { T.neutral(); this.bus.emit('notch', { name: 'N', dir: 0 }); } break;","-      case 'eb': if (!T.eb) { T.emergency(); this.onEmergency(); } break;","-      case 'ebRelease': break;","-      case 'ats': this.confirmATS(); break;","-      case 'horn': this.setHorn(!!val); break;","+      case 'power': {","+        if (this.dwell && !this.dwell.pilotLit && T.notch >= 0 && !T.eb) this.bus.emit('note', 'doors');","+        const moved = T.power();","+        if (moved) this.bus.emit('notch', { name: T.notchName, dir: 1 });","+        if (T.eb === false && moved && this.callOpen && this.callOpen.kind === 'departure' && !this.firstPowerDone) this.firstPowerDone = true;","+        return moved;","+      }","+      case 'brake': { const moved = T.brake(); if (moved) this.bus.emit('notch', { name: T.notchName, dir: -1 }); return moved; }","+      case 'neutral': if (!T.eb) { T.neutral(); this.bus.emit('notch', { name: 'N', dir: 0 }); } return true;","+      case 'eb': if (!T.eb) this.emergency(); return true;","+      case 'ats': return this.confirmATS();","+      case 'horn': this.setHorn(!!val); return true;","       case 'call': return this.call();","-      case 'backup': break;","-      default: break;","+      default: return null;","     }","-    return out;","   }","-  note(kind) { this.bus.emit('note', kind); }","-  onFirstPower() { this.firstPowerDone = true; if (this.callOpen && this.callOpen.kind === 'departure' && !this.callOpen.made) this.callOpen.early = true; }","-  onEmergency() {","-    if (this.dwell || this.phase !== 'run') return;","-    this.stats.ebs++;","-    if (!this.hazardOpen()) { this.addTime(-3 * this.D.pen, 'EMERGENCY'); this.addScore(-200); }","+  emergency() {","+    const T = this.train;","+    if (T.eb) return;","+    T.emergency(); this.stats.ebs++; this.lastEbS = T.s;","+    this.penalty(15);","+    if (!this.hazardOn()) { this.addTime(-3 * this.D.pen, 'EMERGENCY'); this.addScore(-200); }","     this.bus.emit('eb');","   }","+  hazardOn() { return !!(this.obstruction && this.obstruction.active && !this.obstruction.passed); }"," ","-  // ---- the stop and dwell phase machine ----","-  get pilot() { return this.dwell ? this.dwell.pilotLit : false; }","-  pilotLit() { return this.dwell ? !!this.dwell.pilotLit : true; }","-","-  startDwell(o) {","-    const x = this.stops[this.stopIdx] || {};","-    const T0 = DH.parseClock(o.t0 || this.stage.startClock || '06:40:00');","-    this.dwell = { T0, phase: 'dwell', x, ...this.dwellTimes(T0, x.departure !== null ? x.departure : T0 + 25), pilotLit: false, doorsOpen: true, closed: false, melodyDone: false, doorRush: false };","-    this.train.v = 0; this.phase = 'dwell';","-    this.bus.emit('doors', { open: true });","-    this.bus.emit('melody', { id: x.st ? x.st.melody : 'todai', at: this.dwell.melodyAt });"