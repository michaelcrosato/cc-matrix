{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghsYqv1YNiwjqpQt6aWK","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5808,"cache_read_input_tokens":289494,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5808},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"df2a2e42-4895-4954-a641-31d63be9ed1b","timestamp":"2026-11-04T12:17:09.935Z","request_id":"req_011CghsYqaBYnBEd4YH6ZxTq","thinking_duration_ms":34585,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghsYqv1YNiwjqpQt6aWK","type":"message","role":"assistant","content":[{"type":"text","text":"The sim now parses. Next is the autopilot, which drives attract mode, the tests and the par calibration. It uses short-horizon simulation of the same physics model to pick a notch that stops on the mark, and it respects the speed limits."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5808,"cache_read_input_tokens":289494,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5808},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"04903680-1f38-4cca-b6df-cb178ef4d4f5","timestamp":"2026-11-04T12:17:10.342Z","request_id":"req_011CghsYqaBYnBEd4YH6ZxTq"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghsYqv1YNiwjqpQt6aWK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01L42HUo8sKzxKNSEoJeKeoG","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/35-autopilot.js","content":"/* Densha de Halo! · 35-autopilot: the AI driver (section 4.19). It drives a DH.Sim through its commands: the same\n * commands a player's keys make. Used by attract mode, Dev auto-drive, the tests and tools/calibrate.\n *\n * Control. Each decision, it simulates the same train model (30-train) forward for each candidate: brake with notch n\n * after coasting k seconds, or hold a notch. It picks the candidate whose predicted stop is closest to the mark (in a\n * stop) or whose predicted speeds stay under the limits ahead (on the road). Decisions run every 0.25 s; the model is\n * exact, so the prediction is exact, and the stop converges on the mark. Skill (0..1) adds human-like reaction delay and\n * aim noise; skill 1 is perfect. Its runs are deterministic: noise comes from a seeded stream (DH.rng('auto')). */\n(() => {\n'use strict';\nconst DH = window.DH;\n\nconst PRED_DT = 1 / 30;\n\n/* predict where a train stops, and its speeds at given route distances, under a plan: coast k s then hold notch n */\nfunction predict(sim, n, k, points, horizon = 1600) {\n  const T0 = sim.train, spec = T0.spec;\n  const T = new DH.Train(spec, { s: T0.s, v: T0.v });\n  T.cars = T0.cars; T.P = T0.P; T.B = T0.B; T.eb = T0.eb; T.notch = 0; T.slipT = 0;\n  const out = { stopS: null, hit: points.map(() => null), maxV: T.v };\n  const env = { grade: 0, dry: sim.dryRail, traction: true };\n  let t = 0, i = 0;\n  const end = Math.min(60, horizon / Math.max(T.v / 3.6, 2) + 30);\n  for (let guard = 0; guard < 60 * 30 * 4; guard++) {\n    if (t >= k) T.notch = n;\n    if (T.notch === 0 && t < k) T.notch = 0;\n    env.grade = sim.route.gradeAt(T.s);\n    T.step(PRED_DT, env);\n    t += PRED_DT;\n    for (let j = 0; j < points.length; j++) if (out.hit[j] === null && T.s >= points[j].s) out.hit[j] = T.v;\n    if (T.s - T0.s > horizon) break;\n    if (Math.abs(T.v) < 0.02 && t > k + .2) break;\n    if (t > end) break;\n  }\n  out.stopS = T.s;\n  return out;\n}\n\nclass Auto {\n  constructor(sim, o = {}) {\n    this.sim = sim; this.skill = o.skill === undefined ? 1 : o.skill; this.minTime = !!o.minTime;\n    this.rng = DH.rng('auto:' + (sim.stage.id || 'x'));\n    this.next = 0; this.holdHorn = 0; this.hornDone = new Set(); this.plan = null; this.delay = 0;\n    this.aim = 0; this.lastDecide = -1;\n    this.cmds = [];\n  }\n  /** the reaction the skill allows: a human-like pause and an aim error */\n  humanize(dt) {\n    if (this.skill >= 1) return;\n    this.delay -= dt;\n    if (this.delay <= 0) { this.delay = .25 * this.rng() * (1 - this.skill) * 2 + .05; this.aim = (this.rng() - .5) * 0.8 * (1 - this.skill) * 2; }\n  }\n  /** called before each sim step: issues this step's commands */\n  act(dt) {\n    const sim = this.sim, T = sim.train, st = sim.snapshot();\n    if (sim.gameOver || sim.finished) return;\n    this.humanize(dt);\n    // the dwell: doors open, then nothing until the pilot lamp is lit; then depart when the signal allows\n    if (sim.dwell) {\n      if (sim.dwell.pilotLit && (!sim.stopIdx || true)) {\n        if (sim.callOpen && sim.callOpen.kind === 'departure' && !sim.callOpen.made) sim.cmd('call');\n        if (this.canDepart()) { sim.cmd('neutral'); sim.cmd('power'); }\n      }\n      if (T.notch < 0 && !T.eb) sim.cmd('neutral');\n      this.doHorn(st); return;\n    }\n    if (sim.atsRinging) sim.cmd('ats');\n    this.doCalls(st);\n    this.doHorn(st);\n    // obstruction: an emergency stop when a service brake can't stop short of the crossing\n    if (sim.obstruction && sim.obstruction.active && !sim.obstruction.passed) {\n      const c = sim.route.crossings.find(x => x.id === sim.obstruction.id);\n      if (c && T.v > 0) { const p = predict(sim, -8, 0, []); if (p.stopS > c.s - 4 && !T.eb) { sim.cmd('eb'); return; } }\n    }\n    const target = this.targetFor(st);\n    if (!target) { this.cruise(dt); return; }\n    this.stopMode(dt, target);\n  }\n  canDepart() {\n    const sim = this.sim, x = sim.stops[sim.stopIdx];\n    if (sim.train.v > 0.5) return false;\n    if (!x) return true;\n    return !(x.startSig && !sim.readySignals.has(x.startSig.id));\n  }\n  doCalls(st) {\n    const sim = this.sim;\n    for (const c of sim.calls) {\n      if (c.called) continue;\n      const d = c.s - sim.train.s;\n      if (d > 60 && d <= 110 && (c.kind !== 'signal' || sim.sighted.has(c.sig))) { if (this.skill > .5 || this.rng() < this.skill * 2) { sim.cmd('call'); } break; }\n    }\n  }\n  doHorn(st) {\n    const sim = this.sim, T = sim.train;\n    if (this.holdHorn > 0) { this.holdHorn -= DH.FIXED; sim.cmd('horn', true); if (this.holdHorn <= 0) sim.cmd('horn', false); return; }\n    for (const h of sim.route.horns) {\n      if (h.s < sim.stageSpan[0] || h.s > sim.stageSpan[1]) continue;\n      const key = h.s;\n      if (!this.hornDone.has(key) && T.s >= h.s - 40 && T.s < h.s + 20) { this.hornDone.add(key); this.holdHorn = 0.9; sim.cmd('horn', true); }\n    }\n    // the flash of the oncoming last train (S5): answer with the horn\n    if (sim.flashAt !== undefined && sim.t - sim.flashAt < 3 && !this.flashAnswered) { this.flashAnswered = true; this.holdHorn = 0.8; sim.cmd('horn', true); }\n  }\n  /** the stop the train should make next: the next stop, or a red signal's stop point 25 m before it */\n  targetFor(st) {\n    const sim = this.sim, T = sim.train;\n    const x = sim.stops[sim.stopIdx];\n    let tgt = null;\n    if (x && !sim.dwell && !x.judged) tgt = x.target + (this.aim || 0) * (this.skill < 1 ? 1 : 0);\n    // a red ahead within 400 m with no stop of ours before it: stop 25 m short of it\n    for (const g of sim.signals) {\n      if (g.s <= T.s || g.s - T.s > 400) continue;\n      if (g.aspect === 'R' && g.kind !== 'shunt' && !(tgt !== null && tgt < g.s - 25) && !(g.kind === 'start' && (!sim.stops[sim.stopIdx] || x.target > g.s))) { tgt = tgt === null ? g.s - 25 : Math.min(tgt, g.s - 25); break; }\n    }\n    if (tgt !== null && tgt - T.s > 500) return null;\n    if (tgt !== null && tgt < T.s - 60) return null;\n    return tgt;\n  }\n  /** a stop: choose the brake plan whose predicted stop is closest to the target */\n  stopMode(dt, tgt) {\n    const sim = this.sim, T = sim.train, d = tgt - T.s;\n    // a train below the mark that stopped: creep up slowly (the short-stop rule), or leave it to the stop judgment\n    if (Math.abs(T.v) < 0.05) {\n      if (d > 0.3 && d < 5 && !sim.dwell) { if (T.notch !== 1) { sim.cmd('neutral'); sim.cmd('power'); } return; }\n      sim.cmd('neutral');\n      return;\n    }\n    if (this.nextDecide !== undefined && sim.t < this.nextDecide && T.notch < 0 && !T.eb) return;\n    this.nextDecide = sim.t + 0.25;\n    let best = null;\n    const lowSpeed = T.v < 8;\n    for (let n = -8; n <= 0; n++) {\n      if (lowSpeed && n < -2 && d < 3) continue;\n      const ks = n === 0 ? [0] : [0, .5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 5, 6, 7, 8, 9, 10];\n      for (const k of ks) {\n        const p = predict(sim, n, k, [], 1600);\n        const err = p.stopS - tgt;\n        const cost = Math.abs(err) + (n < 0 && lowSpeed ? -n * 0.01 : 0) + (n === 0 ? 40 : 0) + k * 0.001;\n        if (!best || cost < best.cost) best = { n, k, cost, err };\n      }\n    }\n    if (!best) return;\n    // the plan: brake with n now if k is 0, otherwise coast for now\n    if (best.k > 0.01 || best.n === 0) { if (T.notch < 0) sim.cmd('neutral'); else if (T.notch > 0) sim.cmd('neutral'); return; }\n    // brake to the notch: step the lever one notch at a time toward it\n    while (T.notch > best.n && !T.eb) { if (!sim.cmd('brake')) break; }\n    while (T.notch < best.n) { if (!sim.cmd('neutral')) break; if (T.notch < best.n) { sim.cmd('brake'); break; } }\n  }\n  /** on the road: keep under every limit and the aspect caps ahead; power when there's room, coast otherwise */\n  cruise(dt) {\n    const sim = this.sim, T = sim.train, lim = sim.limitInForce(), tt = this.timetableCap();\n    let want = Math.min(lim, tt === null ? 999 : tt);\n    // limits and the signal caps ahead: the speed needed at each point\n    const points = [];\n    for (const L of sim.limits) if (L.s > T.s && L.s - T.s < 1400) points.push({ s: L.s, v: L.v });\n    for (const g of sim.signals) if (g.s > T.s && g.s - T.s < 1400 && g.kind !== 'shunt') { const sp = DH.ASPECT_SPEED[g.aspect]; if (sp !== null && sp !== undefined) points.push({ s: g.s, v: sp }); }\n    let ok = true;\n    for (const p of points) {\n      const dist = p.s - T.s;\n      const allow = Math.sqrt(Math.max(0, (p.v / 3.6) ** 2 + 2 * 0.45 * dist)) * 3.6;   // with a 0.45 m/s^2 brake\n      if (T.v > allow + 0.5) { ok = false; break; }\n      want = Math.min(want, allow);\n    }\n    const eps = T.v - want;\n    if (!ok) { // too fast for a point ahead: brake with the notch the plan picks\n      let best = null;\n      for (let n = -8; n <= 0; n++) {\n        const k = 0, p = predict(sim, n, k, points, 1600);\n        let bad = 0; for (let j = 0; j < points.length; j++) if (p.hit[j] !== null) bad = Math.max(bad, p.hit[j] - points[j].v);\n        const cost = bad * 10 - n * 0.01;\n        if (!best || cost < best.cost) best = { n, cost };\n      }\n      while (T.notch > best.n && !T.eb) { if (!sim.cmd('brake')) break; }\n      while (T.notch < best.n && T.notch < 0) { sim.cmd('neutral'); break; }\n      if (T.notch === 0) sim.cmd('brake');\n      return;\n    }\n    if (eps < -3 && T.notch <= 0) { sim.cmd('neutral'); sim.cmd('power'); }\n    else if (eps < -3 && T.notch > 0) { if (T.notch < T.spec.notchesP) sim.cmd('power'); }\n    else if (eps > 1.5) { if (T.notch > 0) sim.cmd('neutral'); else if (T.notch === 0) sim.cmd('brake'); }\n    else if (T.notch > 0) sim.cmd('neutral');\n    if (T.notch < 0 && eps < 0 && !T.eb) sim.cmd('neutral');\n  }\n  /** a speed that keeps the timetable: the average speed needed to be on time at the next stop, with a margin */\n  timetableCap() {\n    const sim = this.sim, x = sim.stops[sim.stopIdx];\n    if (!x || x.arrival === null || x.arrival === undefined || this.minTime) return null;\n    const left = x.arrival - 4 - sim.clock(), dist = x.target - sim.train.s;\n    if (left <= 0 || dist <= 0) return null;\n    return dist / left * 3.6 * 1.25 + 3;\n  }\n}\nDH.Auto = Auto;\nDH.predictStop = predict;\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5808,"cache_read_input_tokens":289494,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5808},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ed18f8de-7c3c-4ed5-a440-ff3ec45bd88d","uuid":"9b623a2e-5e9a-4e9c-a049-e1c4b1278703","timestamp":"2026-11-04T12:17:29.456Z","request_id":"req_011CghsYqaBYnBEd4YH6ZxTq","wire_tool_inputs":{"toolu_01L42HUo8sKzxKNSEoJeKeoG":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050241__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-haiku-5-5-medium-20261104-050241/src/35-autopilot.js","content":"/* Densha de Halo! · 35-autopilot: the AI driver (section 4.19). It drives a DH.Sim through its commands: the same\n * commands a player's keys make. Used by attract mode, Dev auto-drive, the tests and tools/calibrate.\n *\n * Control. Each decision, it simulates the same train model (30-train) forward for each candidate: brake with notch n\n * after coasting k seconds, or hold a notch. It picks the candidate whose predicted stop is closest to the mark (in a\n * stop) or whose predicted speeds stay under the limits ahead (on the road). Decisions run every 0.25 s; the model is\n * exact, so the prediction is exact, and the stop converges on the mark. Skill (0..1) adds human-like reaction delay and\n * aim noise; skill 1 is perfect. Its runs are deterministic: noise comes from a seeded stream (DH.rng('auto')). */\n(() => {\n'use strict';\nconst DH = window.DH;\n\nconst PRED_DT = 1 / 30;\n\n/* predict where a train stops, and its speeds at given route distances, under a plan: coast k s then hold notch n */\nfunction predict(sim, n, k, points, horizon = 1600) {\n  const T0 = sim.train, spec = T0.spec;\n  const T = new DH.Train(spec, { s: T0.s, v: T0.v });\n  T.cars = T0.cars; T.P = T0.P; T.B = T0.B; T.eb = T0.eb; T.notch = 0; T.slipT = 0;\n  const out = { stopS: null, hit: points.map(() => null), maxV: T.v };\n  const env = { grade: 0, dry: sim.dryRail, traction: true };\n  let t = 0, i = 0;\n  const end = Math.min(60, horizon / Math.max(T.v / 3.6, 2) + 30);\n  for (let guard = 0; guard < 60 * 30 * 4; guard++) {\n    if (t >= k) T.notch = n;\n    if (T.notch === 0 && t < k) T.notch = 0;\n    env.grade = sim.route.gradeAt(T.s);\n    T.step(PRED_DT, env);\n    t += PRED_DT;\n    for (let j = 0; j < points.length; j++) if (out.hit[j] === null && T.s >= points[j].s) out.hit[j] = T.v;\n    if (T.s - T0.s > horizon) break;\n    if (Math.abs(T.v) < 0.02 && t > k + .2) break;\n    if (t > end) break;\n  }\n  out.stopS = T.s;\n  return out;\n}\n\nclass Auto {\n  constructor(sim, o = {}) {\n    this.sim = sim; this.skill = o.skill === undefined ? 1 : o.skill; this.minTime = !!o.minTime;\n    this.rng = DH.rng('auto:' + (sim.stage.id || 'x'));\n    this.next = 0; this.holdHorn = 0; this.hornDone = new Set(); this.plan = null; this.delay = 0;\n    this.aim = 0; this.lastDecide = -1;\n    this.cmds = [];\n  }\n  /** the reaction the skill allows: a human-like pause and an aim error */\n  humanize(dt) {\n    if (this.skill >= 1) return;\n    this.delay -= dt;\n    if (this.delay <= 0) { this.delay = .25 * this.rng() * (1 - this.skill) * 2 + .05; this.aim = (this.rng() - .5) * 0.8 * (1 - this.skill) * 2; }\n  }\n  /** called before each sim step: issues this step's commands */\n  act(dt) {\n    const sim = this.sim, T = sim.train, st = sim.snapshot();\n    if (sim.gameOver || sim.finished) return;\n    this.humanize(dt);\n    // the dwell: doors open, then nothing until the pilot lamp is lit; then depart when the signal allows\n    if (sim.dwell) {\n      if (sim.dwell.pilotLit && (!sim.stopIdx || true)) {\n        if (sim.callOpen && sim.callOpen.kind === 'departure' && !sim.callOpen.made) sim.cmd('call');\n        if (this.canDepart()) { sim.cmd('neutral'); sim.cmd('power'); }\n      }\n      if (T.notch < 0 && !T.eb) sim.cmd('neutral');\n      this.doHorn(st); return;\n    }\n    if (sim.atsRinging) sim.cmd('ats');\n    this.doCalls(st);\n    this.doHorn(st);\n    // obstruction: an emergency stop when a service brake can't stop short of the crossing\n    if (sim.obstruction && sim.obstruction.active && !sim.obstruction.passed) {\n      const c = sim.route.crossings.find(x => x.id === sim.obstruction.id);\n      if (c && T.v > 0) { const p = predict(sim, -8, 0, []); if (p.stopS > c.s - 4 && !T.eb) { sim.cmd('eb'); return; } }\n    }\n    const target = this.targetFor(st);\n    if (!target) { this.cruise(dt); return; }\n    this.stopMode(dt, target);\n  }\n  canDepart() {\n    const sim = this.sim, x = sim.stops[sim.stopIdx];\n    if (sim.train.v > 0.5) return false;\n    if (!x) return true;\n    return !(x.startSig && !sim.readySignals.has(x.startSig.id));\n  }\n  doCalls(st) {\n    const sim = this.sim;\n    for (const c of sim.calls) {\n      if (c.called) continue;\n      const d = c.s - sim.train.s;\n      if (d > 60 && d <= 110 && (c.kind !== 'signal' || sim.sighted.has(c.sig))) { if (this.skill > .5 || this.rng() < this.skill * 2) { sim.cmd('call'); } break; }\n    }\n  }\n  doHorn(st) {\n    const sim = this.sim, T = sim.train;\n    if (this.holdHorn > 0) { this.holdHorn -= DH.FIXED; sim.cmd('horn', true); if (this.holdHorn <= 0) sim.cmd('horn', false); return; }\n    for (const h of sim.route.horns) {\n      if (h.s < sim.stageSpan[0] || h.s > sim.stageSpan[1]) continue;\n      const key = h.s;\n      if (!this.hornDone.has(key) && T.s >= h.s - 40 && T.s < h.s + 20) { this.hornDone.add(key); this.holdHorn = 0.9; sim.cmd('horn', true); }\n    }\n    // the flash of the oncoming last train (S5): answer with the horn\n    if (sim.flashAt !== undefined && sim.t - sim.flashAt < 3 && !this.flashAnswered) { this.flashAnswered = true; this.holdHorn = 0.8; sim.cmd('horn', true); }\n  }\n  /** the stop the train should make next: the next stop, or a red signal's stop point 25 m before it */\n  targetFor(st) {\n    const sim = this.sim, T = sim.train;\n    const x = sim.stops[sim.stopIdx];\n    let tgt = null;\n    if (x && !sim.dwell && !x.judged) tgt = x.target + (this.aim || 0) * (this.skill < 1 ? 1 : 0);\n    // a red ahead within 400 m with no stop of ours before it: stop 25 m short of it\n    for (const g of sim.signals) {\n      if (g.s <= T.s || g.s - T.s > 400) continue;\n      if (g.aspect === 'R' && g.kind !== 'shunt' && !(tgt !== null && tgt < g.s - 25) && !(g.kind === 'start' && (!sim.stops[sim.stopIdx] || x.target > g.s))) { tgt = tgt === null ? g.s - 25 : Math.min(tgt, g.s - 25); break; }\n    }\n    if (tgt !== null && tgt - T.s > 500) return null;\n    if (tgt !== null && tgt < T.s - 60) return null;\n    return tgt;\n  }\n  /** a stop: choose the brake plan whose predicted stop is closest to the target */\n  stopMode(dt, tgt) {\n    const sim = this.sim, T = sim.train, d = tgt - T.s;\n    // a train below the mark that stopped: creep up slowly (the short-stop rule), or leave it to the stop judgment\n    if (Math.abs(T.v) < 0.05) {\n      if (d > 0.3 && d < 5 && !sim.dwell) { if (T.notch !== 1) { sim.cmd('neutral'); sim.cmd('power'); } return; }\n      sim.cmd('neutral');\n      return;\n    }\n    if (this.nextDecide !== undefined && sim.t < this.nextDecide && T.notch < 0 && !T.eb) return;\n    this.nextDecide = sim.t + 0.25;\n    let best = null;\n    const lowSpeed = T.v < 8;\n    for (let n = -8; n <= 0; n++) {\n      if (lowSpeed && n < -2 && d < 3) continue;\n      const ks = n === 0 ? [0] : [0, .5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 5, 6, 7, 8, 9, 10];\n      for (const k of ks) {\n        const p = predict(sim, n, k, [], 1600);\n        const err = p.stopS - tgt;\n        const cost = Math.abs(err) + (n < 0 && lowSpeed ? -n * 0.01 : 0) + (n === 0 ? 40 : 0) + k * 0.001;\n        if (!best || cost < best.cost) best = { n, k, cost, err };\n      }\n    }\n    if (!best) return;\n    // the plan: brake with n now if k is 0, otherwise coast for now\n    if (best.k > 0.01 || best.n === 0) { if (T.notch < 0) sim.cmd('neutral'); else if (T.notch > 0) sim.cmd('neutral'); return; }\n    // brake to the notch: step the lever one notch at a time toward it\n    while (T.notch > best.n && !T.eb) { if (!sim.cmd('brake')) break; }\n    while (T.notch < best.n) { if (!sim.cmd('neutral')) break; if (T.notch < best.n) { sim.cmd('brake'); break; } }\n  }\n  /** on the road: keep under every limit and the aspect caps ahead; power when there's room, coast otherwise */\n  cruise(dt) {\n    const sim = this.sim, T = sim.train, lim = sim.limitInForce(), tt = this.timetableCap();\n    let want = Math.min(lim, tt === null ? 999 : tt);\n    // limits and the signal caps ahead: the speed needed at each point\n    const points = [];\n    for (const L of sim.limits) if (L.s > T.s && L.s - T.s < 1400) points.push({ s: L.s, v: L.v });\n    for (const g of sim.signals) if (g.s > T.s && g.s - T.s < 1400 && g.kind !== 'shunt') { const sp = DH.ASPECT_SPEED[g.aspect]; if (sp !== null && sp !== undefined) points.push({ s: g.s, v: sp }); }\n    let ok = true;\n    for (const p of points) {\n      const dist = p.s - T.s;\n      const allow = Math.sqrt(Math.max(0, (p.v / 3.6) ** 2 + 2 * 0.45 * dist)) * 3.6;   // with a 0.45 m/s^2 brake\n      if (T.v > allow + 0.5) { ok = false; break; }\n      want = Math.min(want, allow);\n    }\n    const eps = T.v - want;\n    if (!ok) { // too fast for a point ahead: brake with the notch the plan picks\n      let best = null;\n      for (let n = -8; n <= 0; n++) {\n        const k = 0, p = predict(sim, n, k, points, 1600);\n        let bad = 0; for (let j = 0; j < points.length; j++) if (p.hit[j] !== null) bad = Math.max(bad, p.hit[j] - points[j].v);\n        const cost = bad * 10 - n * 0.01;\n        if (!best || cost < best.cost) best = { n, cost };\n      }\n      while (T.notch > best.n && !T.eb) { if (!sim.cmd('brake')) break; }\n      while (T.notch < best.n && T.notch < 0) { sim.cmd('neutral'); break; }\n      if (T.notch === 0) sim.cmd('brake');\n      return;\n    }\n    if (eps < -3 && T.notch <= 0) { sim.cmd('neutral'); sim.cmd('power'); }\n    else if (eps < -3 && T.notch > 0) { if (T.notch < T.spec.notchesP) sim.cmd('power'); }\n    else if (eps > 1.5) { if (T.notch > 0) sim.cmd('neutral'); else if (T.notch === 0) sim.cmd('brake'); }\n    else if (T.notch > 0) sim.cmd('neutral');\n    if (T.notch < 0 && eps < 0 && !T.eb) sim.cmd('neutral');\n  }\n  /** a speed that keeps the timetable: the average speed needed to be on time at the next stop, with a margin */\n  timetableCap() {\n    const sim = this.sim, x = sim.stops[sim.stopIdx];\n    if (!x || x.arrival === null || x.arrival === undefined || this.minTime) return null;\n    const left = x.arrival - 4 - sim.clock(), dist = x.target - sim.train.s;\n    if (left <= 0 || dist <= 0) return null;\n    return dist / left * 3.6 * 1.25 + 3;\n  }\n}\nDH.Auto = Auto;\nDH.predictStop = predict;\n})();\n"}}}
