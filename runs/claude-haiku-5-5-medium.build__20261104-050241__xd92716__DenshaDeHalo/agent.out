t dt = DH.FIXED; for (let i = 0; i < 120 * 5; i++) t.step(dt, { dry: false, grade: 0 }); console.log('wet, P5 from stand: slipped =', t.slipCount > 0, '(want true)'); }\n{ const t = new DH.Train(H, { v: 0 }); t.notch = 5; const dt = DH.FIXED; for (let i = 0; i < 120 * 5; i++) t.step(dt, { dry: true, grade: 0 }); console.log('dry, P5 from stand: slipped =', t.slipCount > 0, '(want false)'); }\n{ const t = new DH.Train(H, { v: 0 }); t.notch = -4; const dt = DH.FIXED; for (let i = 0; i < 120 * 5; i++) t.step(dt, { dry: true, grade: 0 }); console.log('brake on level at standstill: v =', t.v, 'B =', t.B.toFixed(2)); }\n{ const a = new DH.Train(H, { v: 80 }), b = new DH.Train(H, { v: 80 }); a.brakeScaleTest = 1; const dt = DH.FIXED; DH.TUNING.brakeScale = 2; const r2 = DH.simBrake(H, 80, 4); DH.TUNING.brakeScale = 1; const r1 = DH.simBrake(H, 80, 4); console.log('brakeScale 2 vs 1: dist', r2.dist.toFixed(0), r1.dist.toFixed(0), 'drop', ((1 - r2.dist / r1.dist) * 100).toFixed(0) + '% (want 45-55%)'); }\nprocess.exit(0);\n"}}}
