hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n====\n126 game/game.js\n58: *    plays it back headless, exactly, and stops where it differs (game.stateHash = () => [...] sharpens that).\n59: * 11. TESTS. new E.Game({ headless: true }) (the default in Node) runs with no screen: game.advance(1) runs 120 fixed\n66: *    template game with a headless test.\n162:/** a new canvas of w x h pixels (scratch images and sprite sheets). With no document (Node: a headless game) a stand-in\n633:   *  headless game's, sized as a 1280 x 720 window would size it, with nothing to draw on */\n635:    /** canvas: the page's canvas (null in a headless game); o: the sizing options (the game's o) */\n637:    /** buf: the low-resolution buffer the game draws into (W + 2 by H + 2 pixels; null when headless); ctx: its 2D\n745:  /** signal: an AbortSignal that removes every listener this adds (game.dispose()). A screen without a canvas (headless)\n1474:    if (!game.headless) { this._cv = mkCanvas(8, 8); this._g = this._cv.getContext('2d'); this.refresh(); }   // (a headless game never draws)\n2272:   * new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu,\n2280:   * - headless: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default):\n2296:    /** true for a game with no display (o.headless, or no DOM: Node) */\n2297:    this.headless = !!o.headless || typeof document === 'undefined';\n2298:    if (this.headless) o.canvas = null;\n2305:     *  step, input, loop, headless) */\n2306:    this.o = Object.assign({ view: 'iso', minH: 190, minW: 300, maxW: 560, maxH: 330, bg: '#07060d', step: 1 / 120, input: Input.DEFAULT, loop: !this.headless }, o);\n2327:    this.time = 0; this.real = 0; this.hitstop = 0; this.timeScale = 1; this._shakeAmt = 0; this.reduceMotion = !this.headless && !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);\n2345:     *  draw); r: the renderer handed to draw(r) (null when headless) */\n2346:    this.particles = new Particles(this); this.lights = new Lighting(this); this.r = this.headless ? null : new Renderer(this);\n2366:    if (this.headless) this.audio.failed = 'a headless game has no sound';","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01YHwt5uajSLNZbLsSY9HP7N","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
