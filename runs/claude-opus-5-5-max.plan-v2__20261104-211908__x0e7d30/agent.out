r'\"),(87,r'Controller or keyboard required'),(87,r'attract reel runs behind the notice'),(90,r'No TODOs, placeholders, stubs'),(93,r'in the in-game About/Credits \\*\\*and\\*\\* in your final chat reply'),(94,r'Date, Source, Plan, Genre and Perspective, Tech, Art Direction, Animation, Audio, Online, Testing, Research, Environment, Model, and Usage'),(107,r'Usage is literally `added on import`.*don.t estimate'),(109,r'under the name TASK\\.md gives it: one JSON object in exactly the shape below'),(109,r'Plain text, every value filled in'),(109,r'check that it parses as JSON'),(115,r'3 to 6 lowercase tags'),(128,r\"catalogue's model, effort, CLI, date and usage come from the run's record\"),(130,r'Testing: how many issues testing caught; how many were critical or game breaking; the most helpful test; the least helpful test'),(137,r'Engine: what you liked most; whether you got stuck or guessed wrong; the most important thing you had to build yourself; the hardest part of using the engine; what you changed in it and why'),(146,r'Prompt: what you liked most; what was confusing; the hardest thing to do; what you would change')]\nmiss = [(n, r) for n, r in A if not any(re.search(r, l) for l in plan)]\nprint(f'{len(A)} wording checks across {len(set(n for n, _ in A))} TASK.md lines, {len(miss)} missing', miss)\ntj = json.loads(task[task.index('{\\n  \"sourceInformation\"'):task.index(\"The catalogue's model, effort\")])\ni = planText.index('```json\\n') + 8; pj = json.loads(planText[i:planText.index('\\n```', i)])\nsh = lambda o: {k: sh(v) for k, v in o.items()} if isinstance(o, dict) else type(o).__name__\nprint('exit interview block: same keys, order and types as TASK.md:', sh(tj) == sh(pj) and list(tj) == list(pj) and list(tj['sourceInformation']) == list(pj['sourceInformation']) and list(tj['aiHub']) == list(pj['aiHub']))\nnames = ['exit-interview', 'GameTitle', 'SOURCE-', 'claude-', 'opus-5', '5-5-max', '20261104', '211908', 'x0e7d30', 'check-environment', 'planner-ex