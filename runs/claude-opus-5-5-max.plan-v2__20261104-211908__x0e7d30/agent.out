cv = mkCanvas(W, H), g = cv.getContext('2d'), img = g.createImageData(W, H), a = img.data, oc = outline && hex(outline); a.set(r.rgba);\nmy-3d2dge.js:8604:  g.putImageData(img, 0, 0); return cv;\nmy-3d2dge.js:8614:  const cv = mkCanvas(r.w, r.h), g = cv.getContext('2d'), img = g.createImageData(r.w, r.h);\nmy-3d2dge.js:8616:  g.putImageData(img, 0, 0); return { cv, runs: rasterRuns(r, j => r.glow[j]) };\nmy-3d2dge.js:8732:  const W = r.w, H = r.h, cv = r.cv, fl = mkCanvas(W, H), fg = ctx2d(fl), d = cv.getContext('2d').getImageData(0, 0, W, H).data, runs = [];\nmy-3d2dge.js:9963:    const src = new Uint8Array(buf.getMappedRange()), c = mkCanvas(w, h), g = c.getContext('2d'), img = g.createImageData(w, h);\nmy-3d2dge.js:9965:    buf.unmap(); buf.destroy(); g.putImageData(img, 0, 0);\nmy-3d2dge.js:12613:    const cv = E.mkCanvas(W, H), g = cv.getContext('2d'), img = g.createImageData(W, H), d = img.data;\nmy-3d2dge.js:12618:    g.putImageData(img, 0, 0); return (this._tex = cv);\nmy-3d2dge.js:12634:      if (!this._px) this._px = new Uint32Array(F.getContext('2d').getImageData(0, 0, TW, TH).data.buffer);\nmy-3d2dge.js:12636:      const B = this._buf && this._buf.width === w && this._buf.height === h ? this._buf : (this._buf = E.mkCanvas(w, h)), bg = B.getContext('2d'), img = bg.createImageData(w, h), o\nmy-3d2dge.js:12648:      bg.putImageData(img, 0, 0); g.drawImage(B, vp.x, top);\nmy-3d2dge.js:14868:    const k = this.chunk; cv = cv || E.mkCanvas(k, k); const g = E.ctx2d(cv), img = g.createImageData(k, k), D = img.data, W = this.w, C = this.cells;\n=== px.sprite\n198:- `px.blend(g, a, mode, fn)`: draw fn() at alpha a (stepped, like PS1 hardware) with a blend mode: 'normal', 'add', 'multiply', 'screen' (E.style.trans = 'dither' dithers instead)\n199:- `px.col(g, c)`: set the fill color (px.* do it themselves)\n200:- `px.ddisc(g, cx, cy, r, c, a, wx = 0, wy = 0)`: soft disc that fades toward its edge (glows, smoke, dust): stepped alpha rings, or dithering in 'dither' style\n201:- `px.disc(g, cx, cy, r, c)`: a filled circle\n202:- `px.dot(g, x, y, c)`: one pixel\n203:- `px.ell(g, cx, cy, rx, ry, c)`: a filled ellipse\n204:- `px.glow(g, e = 1)`: GPU lighting: what follows glows (0..1). No effect in Canvas mode, so call it freely.\n205:- `px.line(g, x0, y0, x1, y1, c, w = 1)`: a line w pixels thick, no smoothing\n206:- `px.poly(g, pts, c)`: a filled polygon through [[x, y], ...]\n207:- `px.polyDither(g, pts, c, a, wx = 0, wy = 0)`: translucent polygon: a = 0..1 opacity (stepped alpha, or a dither pattern in 'dither' style). wx/wy = world pixel offset for the pattern\n208:- `px.rect(g, x, y, w, h, c)`: a filled rectangle, snapped to whole pixels\n209:- `px.reset(g)`: forget the color cache (after drawing on g with the canvas API directly)\n210:- `px.sprite(g, spr, x, y, flip = false)`: draw a sprite with its top-left corner at buffer pixel (x, y). flip mirrors it left-right; or o: { flip, rot (radians, turned about its center: E.rotSpri\n=== screen scale\n3:Every public name in `engine/my-3d2dge.js` and its modules (`engine/modules/`: a section each, after the core's), one line each: its signature (and default, for a field) and what its doc comment says (a long one's options on lines of their own: `new E.Game({ expand })`). Written by `node tools/api\n267:- `game.screen.scale = 'auto'`: how a fixed resolution fills the screen: 'sharp' (whole-number scale, every pixel the same size, black bars unless o.expand grows the picture into them), 'fill' (the largest fit, pixels a device pixel apart in size) or 'auto' (fill on high-density screens, phones \n459:- `new E.Game(o = {}) → game`: new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu, fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features (section 10b) every game gets: m\n461:- `new E.Game({ expand })`: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars (expand: { maxW, maxH } stops it growing there)\n511:- `game.start(hooks)`: Start the loop. Either one scene: game.start({ update(dt), draw(r) }) or several: game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' }) A scene is { enter(data), exit(), update(dt), draw(r), back(), pausable, view, views, input, res, expand, touch, camera }\n512:- `game.start({ view, views, input, res, expand, touch })`: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'), expand (true), touch (['jump', 'attack']); res and expand stay until another scene sets them\n518:- `game.upright`: true while the game's screen (r.W x r.H) is upright, taller than 1.3 times its width: a phone held upright, with expand: true (a fixed res keeps its own shape on any phone, so it is never upright there). A scene's camera.tall zoom applies then: it zooms a tall picture in to fil\n542:- `game.o`: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg, step, input, loop, headless)\n=== attract\n91:- 1234 Module arcade: the coin-op's frame: scores, high-score tables and initials, lives, credits, turns, cards, the attract mode (engine/modules/arcade.js); E.Arcade: arcade\n492:- `game.hook(kind, fn)` †: a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an attract mode's watcher); 'enter' fn(name, \n505:- `game.script(fn, o)` †: run a coroutine on game time, in the update step: game.script(function* (game) { yield .5; yield E.until(() => door.open); yield game.tween(cam, { y: 0 }, 1); yield E.all([a, b]); ... }, { keep }). Each yield waits: a number (seconds), nothing (one step), a condition (a\n1234:## Module arcade: the coin-op's frame: scores, high-score tables and initials, lives, credits, turns, cards, the attract mode (engine/modules/arcade.js)\n1236:- `new E.Arcade(game, o = {}) → arcade`: new E.Arcade(game, { id, lives: 3, extra: [] (the scores that give a life) or every (a life each that many points), credits: null (free play) or the coins a game takes, idle: 20, demo: 30, scores: 6 (the attract mode's seconds), hud: true, colors: [label\n1238:- `arcade.attract(dt)`: the attract mode, each step on the title: 'title', 'demo' (o.idle seconds without input; it lasts o.demo seconds or until endDemo()), 'scores' (o.scores seconds), then 'title' again; any input goes back to 'title'\n1247:- `arcade.drawTable(r, mode = '', y = 40, title = 'HIGH SCORES')`: a table as a screen (the attract mode's, or after a game), its title at y: rank, name, score\n1248:- `arcade.endDemo()`: the demo is over (a demo in a scene of its own: call it on the way back): the attract mode shows the scores\n1252:- `arcade.start(players = 1, o = {})`: begin a game for 1 or 2 players (taking turns), o: { demo: true } for the attract mode's; spends the credits a game takes unless it is free play or a demo. Returns false without them\n1255:- `arcade.wake()`: the attract mode back to the title, its idle clock at zero (as any input does)\n1265:- `arcade.phase = 'title'`: the attract mode's, 'title' | 'demo' | 'scores'\n476:- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\n479:- `game.allowJoin(o = {})` †: let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's)\n499:- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\n510:- `game.splitScreen(n, o = {})` †: split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, \n519:- `game.viewports` †: a split screen's viewports ({ i, x, y, w, h, cam, focus(x, y, z), follow(target, { z }): game.splitScreen), or [] on one screen","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_011oe9opijFiQstrhnFX9CN5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
