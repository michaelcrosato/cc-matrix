ase: -10, warp: 8 }); }\n  const coil = (x0, y0, len, dir, r) => { const pts = [[x0, y0]]; let a = dir, x = x0, y = y0; for (let i = 0; i < len; i++) { a += (n.R() - .5) * 1.5 + Math.sin(i * .9) * .5; x += Math.cos(a) * r * 1.3; y += Math.sin(a) * r * 1.3; if (((x - cx) / (rx * .92)) ** 2 + ((y - cy) / (ry * .92)) ** 2 > 1) { a += 2.4; x += Math.cos(a) * r; y += Math.sin(a) * r; } pts.push([x, y]); } return pts; };\n  F.tube(coil(cx + rx * .05, cy - ry * .25, 34, .2, 9), 11, 14, 'bowel', { base: -8 }); F.tube(coil(cx + rx * .45, cy + ry * .25, 26, 2.6, 9), 10, 15, 'bowel', { base: -7 }); F.tube(coil(cx - rx * .35, cy + ry * .45, 22, -.3, 9), 10, 15, 'bowel', { base: -6 });\n  const veins = (x, y, a, len, r, mat) => { const pts = [[x, y]]; for (let i = 0; i < len; i++) { a += (n.R() - .5) * .8; x += Math.cos(a) * 7; y += Math.sin(a) * 7; pts.push([x, y]); if (r > 1.2 && n.R() < .22) veins(x, y, a + (n.R() < .5 ? .9 : -.9), len * .5 | 0, r * .7, mat); } F.tube(pts, r, 1.6, mat, { add: true, pulse: mat === 'artery' ? .35 : 0 }); };\n  veins(cx - rx * .7, cy - ry * .05, -.2, 16, 2.2, 'vessel'); veins(cx + rx * .7, cy - ry * .6, 2.4, 14, 2, 'artery'); veins(cx + rx * .1, cy + ry * .75, -1.5, 12, 1.8, 'vessel');\n  for (const a of [-.45, .5, 2.7, 3.6]) { const ex = cx + Math.cos(a) * rx * 1.02, ey = cy + Math.sin(a) * ry * 1.02, ox = cx + Math.cos(a) * rx * 1.5, oy = cy + Math.sin(a) * ry * 1.5; F.tube([[ex, ey], [ox, oy]], 4, 5, 'steel', { base: 10 }); F.tube([[ex - Math.sin(a) * 9, ey + Math.cos(a) * 9], [ex + Math.sin(a) * 9, ey - Math.cos(a) * 9]], 3, 5, 'steel', { base: 10 }); } // retractors\n  F.finish(1.1); return F; }\n'''\nopen('final_bake.js', 'w').write(bake)\nb = open('bust.js').read()\nb = b.replace(\"// Reference portrait painter: a bust from data, in hard-edged tones, cached per expression. 112 x 128 buffer pixels.\\nfunction drawBust(g, c, o = {}) { const E = My3D2dge, px = E.px,\", \"// A bust from data in hard-edged tones, 112 x 128 buffer pixels. Cache each expression in a canvas; the sim never reads it. Needs E = My3D2dge in scope.\\n// o: { expr: neutral | smile | angry | sad | shock | shout, blink: 0..1, talk: 0..1, look: -1..1 }\\nfunction drawBust(g, c, o = {}) { const px = E.px,\")\nb = b.replace(\"  if (c.scar) px.line(g, ...f(c.scar[0]\", \"  if (o.maskUp && c.mask) { const k = T(c.mask); P([f(-27, 36), f(-8, 34), f(0, 36), f(8, 34), f(27, 36), f(25, 54), f(11, 66), f(0, 68), f(-11, 66), f(-25, 54)], k.base); P([f(-27, 36), f(-8, 34), f(-3, 50), f(-11, 66), f(-25, 54)], k.sh); for (const yy of [44, 52]) px.line(g, ...f(-18, yy), ...f(18, yy), k.lt, 1); px.line(g, ...f(-27, 38), ...f(-31, 32), k.lt, 1); px.line(g, ...f(27, 38), ...f(31, 32), k.lt, 1); }\\n  if (c.scar) px.line(g, ...f(c.scar[0]\")\nb = b.replace(\"  if (c.mask) { const k = T(c.mask); P([f(-20, 62)\", \"  if (c.mask && !o.maskUp) { const k = T(c.mask); P([f(-20, 62)\")\nb = b.replace(\"  immy: { name: 'DR. VALE', skin: '#f6d0b2', hair: '#c9562a', iris: '#3f8a58', cloth: '#2f9c8e', cap: '#2bb0a2', undershirt: '#e9fff6', blush: '#f0a48c', browDrop: 0, wide: .95,\", \"  vale: { name: 'DR. VALE', skin: '#f6d0b2', hair: '#c9562a', iris: '#3f8a58', cloth: '#2f9c8e', cap: '#2bb0a2', mask: '#bfe6dc', undershirt: '#e9fff6', blush: '#f0a48c', wide: .95,\")\nb = b.replace(\"  chief: { name: 'CHIEF OYELARAN',\", \"  oyelaran: { name: 'CHIEF OYELARAN',\")\nb = b.replace(\"  zhenya: { name: 'DR. SOKOLOVA',\", \"  sokolova: { name: 'DR. SOKOLOVA',\")\nb = b.replace(\"window.drawBust = drawBust; window.CAST = CAST;\\n\", \"\")\nopen('final_bust.js', 'w').write(b)\nEOF\ncat > proto3.html <<'EOF'\n<!doctype html><html><head><meta charset=\"utf-8\"><title>proto3</title>\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}#screen{width:100%;height:100%;display:block;image-rendering:pixelated;touch-action:none}</style></head>\n<body><canvas id=\"screen\"></canvas>\n<script src=\"../engine/dist/handoff/my-3d2dge.js\"></script>\n<script>const E = My3D2dge;</script>\n<script src=\"final_tissue.js\"></script><script src=\"final_bake.js\"></script><script src=\"final_bust.js\"></script>\n<script>\n(() => { const { px } = E, q = new URLSearchParams(location.search);\nconst game = window.G = new E.Game({ canvas: 'screen', res: [426, 240], expand: true, view: 'overhead', touch: 'never' });\nlet F, t = 0, bq, bv;\nconst cache = (c, o) => { const cv = E.mkCanvas(112, 128), g = cv.getContext('2d'); g.imageSmoothingEnabled = false; px.reset(g); drawBust(g, c, o); px.reset(g); return cv; };\ngame.start({ scene: 'p', scenes: { p: { pausable: true, camera: { zoom: false }, update(dt) { t += dt; game.focus(game.W / 2, game.H / 2, 0); },\n  draw(r) { if (!F || F.W !== r.W || F.H !== r.H) { F = bakeAbdomen(r.W, r.H); bq = cache(CAST.quill, { maskUp: true, expr: 'neutral' }); bv = cache(CAST.vale, { maskUp: true, expr: 'shock' }); }\n    const W = r.W, H = r.H, cx = W / 2, cy = H / 2 - 4, beat = Math.pow(Math.max(0, Math.sin(t * 5.4)), 14) * .28; F.stampDisc(cx + 30, cy + 20, 22, 3.2, 'blood');\n    F.shade({ beat, breath: Math.sin(t * 1.3) * 1.1 }); const o = r.w(0, 0, 0); r.ctx.drawImage(F.cv, o[0], o[1]);\n    r.overlay(g => { E.ui.box(g, 6, 6, 148, 30, { bg: '#04140e', alpha: .86, gradient: false, border: '#2c6a55' }); E.font.text(g, '72', 150, 12, '#46f0a0', { scale: 2, align: 'right', outline: false });\n      E.ui.box(g, W - 76, 6, 70, 22, { bg: '#14100a', alpha: .86, gradient: false, border: '#7a6a3a' }); E.font.text(g, '01:42', W - 12, 10, '#ffe9a8', { scale: 2, align: 'right', outline: false });\n      g.drawImage(bq, 28, 16, 56, 64, 4, H - 62, 56, 64); E.ui.box(g, 62, H - 34, 236, 28, { bg: '#0c1420', alpha: .88, gradient: false, border: '#4a6a90' }); E.font.text(g, 'NURSE QUILL', 68, H - 31, '#ffd36a', { outline: false }); E.font.text(g, 'That was the liver, Doctor.', 68, H - 19, '#ffffff', { outline: false });\n      g.drawImage(bv, 300, 4 ,1,1,0,0,0,0); }); } } } });\n})();\n</script></body></html>\nEOF\ncat > proto3.py <<'EOF'\nimport sys as _s; _s.path.insert(0, \"/home/micha/.local/lib/python3.14/site-packages\")\nimport json, os\nfrom playwright.sync_api import sync_playwright\nhere = os.path.dirname(os.path.abspath(__file__)); url = 'file://' + here + '/proto3.html'\nwith sync_playwright() as p:\n    b = p.chromium.launch(args=['--autoplay-policy=no-user-gesture-required'])\n    out = {}\n    for label, vw, vh in [('1080', 1920, 1080), ('720', 1280, 720)]:\n        ctx = b.new_context(viewport={'width': vw, 'height': vh}); pg = ctx.new_page(); errs = []\n        pg.on('pageerror', lambda e: errs.append(str(e))); pg.on('console', lambda m: errs.append(m.text) if m.type in ('error', 'warning') else None)\n        pg.goto(url); pg.wait_for_timeout(1100); pg.screenshot(path=os.path.join(here, f'p3{label}.png')); out[label] = errs[:5]; ctx.close()\n    print(json.dumps(out)); b.close()\nEOF\ntimeout 60 python3 -I proto3.py 2>&1 | cut -c1-500; sed -i 's#tissue2.js#final_tissue.js#; s#./bust.js#./final_bust.js#' headless.mjs; sed -i \"s#vm.runInContext('window.E3 = My3D2dge;', ctx);#vm.runInContext('var E = My3D2dge;', ctx);#; s#const E = My3D2dge; let F#let F#; s#CAST.immy#CAST.vale#\" headless.mjs; node headless.mjs ../engine/dist/handoff/my-3d2dge.js 2>&1 | cut -c1-500; wc -c final_tissue.js final_bake.js final_bust.js","description":"Assemble final reference code, then render and headless-test it","timeout":90000}},"wire_ingest_context":{"toolu_019VXQ6tqjQE6o1gDnjzU8zG":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211908__x0e7d30/work/_research/probe"}}}
