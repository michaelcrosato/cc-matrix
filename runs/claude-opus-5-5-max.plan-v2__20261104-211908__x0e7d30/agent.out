e = '''<!doctype html><html><head><meta charset=\"utf-8\"><title>extracted</title><style>html,body{margin:0;height:100%%;background:#000;overflow:hidden}#screen{width:100%%;height:100%%;display:block;image-rendering:pixelated;touch-action:none}</style></head><body><canvas id=\"screen\"></canvas>\n<script src=\"../engine/dist/handoff/my-3d2dge.js\"></script><script>const E = My3D2dge;</script><script src=\"tissue.js\"></script><script src=\"bake.js\"></script><script src=\"bust.js\"></script><script src=\"input.js\"></script>\n<script>\nconst game = window.G = new E.Game({ canvas: 'screen', res: [426, 240], expand: true, view: 'overhead', touch: 'never', input: INPUT, menu: { settings: [{ key: 'music', value: .1 }, { key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] }] } });\nlet F, t = 0, bust; const px = E.px;\ngame.start({ scene: 'op', scenes: { op: { pausable: true, camera: { zoom: false, wheel: false }, update(dt) { t += dt; game.focus(game.W / 2, game.H / 2, 0); window.S = { label: game.input.label('useTool'), gift: game.input.label('gift'), aim: game.input.padAim, move: game.input.padMove, trig: game.input.value('useTool'), device: game.input.lastDevice }; },\n  draw(r) { if (!F || F.W !== r.W || F.H !== r.H) { F = bakeAbdomen(r.W, r.H); const c = E.mkCanvas(112, 128), g = c.getContext('2d'); g.imageSmoothingEnabled = false; px.reset(g); drawBust(g, CAST.vale, { expr: 'shock' }); px.reset(g); bust = c; }\n    F.stampDisc(F.W / 2 + 20, F.H / 2, 18, 3, 'blood'); F.stampLine([[150, 90], [190, 100]], 3, -3, 'wound'); F.shade({ beat: .2, breath: 1, slow: new URLSearchParams(location.search).has('slow') }); const o = r.w(0, 0, 0); r.ctx.drawImage(F.cv, o[0], o[1]); r.overlay(g => { g.drawImage(bust, r.W - 116, r.H - 128); E.font.text(g, 'extracted from the plan', 8, 8, '#fff', { outline: false }); }); } } } });\n</script></body></html>'''\nopen('verify/page.html', 'w').write(page)\nstub = open('verify/padstub.js').read(