'short', outfit: 'coat', sleeves: 'long', colors: { skin: '#7a4a2e', hair: '#b9b4ac', cloth: '#2c2b33', coat: '#ece8df', pants: '#2c2b33', boot: '#1c1b22', trim: '#c0b8a8' } });\nconst zhenya = mk({ build: 'bulky', hair: 'ponytail', hat: { style: 'band', color: '#b23a3a' }, colors: { skin: '#e6c4a8', hair: '#d9d6cf', cloth: '#6a7a4a', pants: '#3f4a30', boot: '#2b2b2b', trim: '#b23a3a' } });\nlet t = 0, W = 0, H = 0, field, fg, img, u32, oW = 0;\nconst ensure = (w, h) => { if (w === W && h === H) return; W = w; H = h; field = E.mkCanvas(w, h); fg = field.getContext('2d'); img = fg.createImageData(w, h); u32 = new Uint32Array(img.data.buffer); };\n// a tiny \"wet tissue\" test: heightfield from sines, normal, lamp + specular, quantised to a ramp\nconst ramp = E.ramp('#b0444a', 12).map(E.hex);\nfunction paint() {\n  const beat = Math.pow(Math.max(0, Math.sin(t * 5.2)), 6) * 1.5;\n  const h = (x, y) => 6 * Math.sin(x * .045 + 1.3 * Math.sin(y * .03)) * Math.cos(y * .05 + .8 * Math.sin(x * .02)) + 3 * Math.sin(x * .13 + y * .09) + beat * Math.sin(x * .02) * 3;\n  for (let y = 0, i = 0; y < H; y++) for (let x = 0; x < W; x++, i++) {\n    const dx = h(x + 1, y) - h(x - 1, y), dy = h(x, y + 1) - h(x, y - 1), n = 1 / Math.hypot(dx * .5, dy * .5, 1);\n    const nx = -dx * .5 * n, ny = -dy * .5 * n, nz = n;\n    const lx = -.35, ly = -.45, lz = .82, d = Math.max(0, nx * lx + ny * ly + nz * lz), s = Math.pow(Math.max(0, nz * .9 + nx * lx * .4 + ny * ly * .4), 40);\n    const dith = ((x & 1) ^ (y & 1)) * .35;\n    const k = Math.min(ramp.length - 1, Math.max(0, (d * 8.5 + dith) | 0));\n    let c = ramp[k], r = c[0], g = c[1], b = c[2];\n    if (s > .55) { r = 255; g = 236; b = 226; }\n    u32[i] = 0xff000000 | (b << 16) | (g << 8) | r;\n  }\n  fg.putImageData(img, 0, 0);\n}\ngame.start({ scene: 'op', scenes: {\n  op: { pausable: true, camera: { zoom: false }, enter() {},\n    update(dt) { t += dt; game.focus(game.W / 2, game.H / 2, 0); for (const q of [immy, quill, chief, zhenya]) q.update(dt, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: Math.PI / 2 });\n      if (((t * 3) | 0) !== (((t - dt) * 3) | 0)) game.particles.sparks(game.W * .5, game.H * .5, 0, 12, 0); window.__t = t; },\n    draw(r) { ensure(r.W, r.H); paint(); const o = r.w(0, 0, 0); window.__o = [o[0], o[1], r.bw, r.bh, game.cam && game.cam.x, game.cam && game.cam.y];\n      r.ctx.drawImage(field, Math.round(o[0]), Math.round(o[1]));\n      r.overlay(g => {\n        immy.drawPortrait(g, 8, 8, 64, { zoom: 5, turn: .5, frame: true, bg: '#1a2050' });\n        quill.drawPortrait(g, 8, 80, 64, { zoom: 5, turn: .5, frame: true, bg: '#1a3040' });\n        chief.drawPortrait(g, 80, 8, 64, { zoom: 5, turn: .5, frame: true, bg: '#301a30' });\n        zhenya.drawPortrait(g, 80, 80, 64, { zoom: 5, turn: .5, frame: true, bg: '#303018' });\n        immy.drawPortrait(g, r.W - 104, 8, 96, { zoom: 8, turn: .3, frame: true, bg: '#1a2050' });\n        E.font.text(g, 'VITALS 72', r.W - 104, 112, '#ffffff', { scale: 2, shadow: '#000', outline: false });\n        E.font.text(g, 'That was the liver, Doctor. We are keeping that one.', 8, r.H - 24, '#ffffff', { shadow: '#000', outline: false });\n        E.font.text(g, 'R2 Pull   ' + game.input.label('useTool'), 8, r.H - 12, '#ffd36a', { shadow: '#000', outline: false });\n      });\n    } } } });\n})();\n</script></body></html>\nEOF\ncat > look.py <<'EOF'\nimport sys as _s; _s.path.insert(0, \"/home/micha/.local/lib/python3.14/site-packages\")\nimport json, os\nfrom playwright.sync_api import sync_playwright\nhere = os.path.dirname(os.path.abspath(__file__)); url = 'file://' + here + '/look.html'\nwith sync_playwright() as p:\n    b = p.chromium.launch(args=['--autoplay-policy=no-user-gesture-required'])\n    out = {}\n    for label, vw, vh in [('tv1080', 1920, 1080), ('desk720', 1280, 720), ('qhd', 2560, 1440), ('tv4k', 3840, 2160)]:\n        ctx = b.new_context(viewport={'width': vw, 'height': vh}); pg = ctx.new_page(); errs = []\n        pg.on('pageer