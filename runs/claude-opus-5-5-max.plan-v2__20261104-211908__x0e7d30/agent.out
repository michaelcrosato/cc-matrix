ake.js', 'w').write(block('## Appendix B: a site recipe', 'js'))\nopen('verify/bust.js', 'w').write(block('## Appendix C: portrait painter', 'js'))\nopen('verify/hubgame.js', 'w').write(block('**Skeleton.**', 'js'))\nopen('verify/hubtest.py', 'w').write(block('**Harness runner.**', 'python'))\nopen('verify/padstub.js', 'w').write(block('**A DualSense in the standard mapping', 'js'))\nopen('verify/input.js', 'w').write(block('Settings adds **Swap sticks**', 'js'))\nopen('verify/setup.sh', 'w').write(block('1. **Getting the code.**', 'sh'))\nhead = block('**Page head.**', 'html')\nopen('verify/head.html', 'w').write(head)\nfor f in os.listdir('verify'):\n    if os.path.isfile('verify/' + f): print(f, os.path.getsize('verify/' + f))\nEOF\npython3 -I probe/extract.py && (cd verify/setup && sed 's/^   //' ../setup.sh > s.sh && bash s.sh 2>&1 | tail -3; ls vendor/hub vendor/hub/examples; ls vendor/my-3d2dge/dist/handoff | head -5; test -f vendor/hub/README.md && echo README-ok; du -sh vendor | cut -f1) && cat > probe/verify2.py <<'EOF'\nimport sys as _s; _s.path.insert(0, \"/home/micha/.local/lib/python3.14/site-packages\")\nimport json, os\nfrom playwright.sync_api import sync_playwright\nroot = os.path.abspath('.')\npage = '''<!doctype html><html><head><meta charset=\"utf-8\"><title>extracted</title><style>html,body{margin:0;height:100%%;background:#000;overflow:hidden}#screen{width:100%%;height:100%%;display:block;image-rendering:pixelated;touch-action:none}</style></head><body><canvas id=\"screen\"></canvas>\n<script src=\"../engine/dist/handoff/my-3d2dge.js\"></script><script>const E = My3D2dge;</script><script src=\"tissue.js\"></script><script src=\"bake.js\"></script><script src=\"bust.js\"></script><script src=\"input.js\"></script>\n<script>\nconst game = window.G = new E.Game({ canvas: 'screen', res: [426, 240], expand: true, view: 'overhead', touch: 'never', input: INPUT, menu: { settings: [{ key: 'music', value: .1 }, { key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] }] } });\nlet F, t = 0, bust; const px = E.px;\ngame.start({ scene: 'op', scenes: { op: { pausable: true, camera: { zoom: false, wheel: false }, update(dt) { t += dt; game.focus(game.W / 2, game.H / 2, 0); window.S = { label: game.input.label('useTool'), gift: game.input.label('gift'), aim: game.input.padAim, move: game.input.padMove, trig: game.input.value('useTool'), device: game.input.lastDevice }; },\n  draw(r) { if (!F || F.W !== r.W || F.H !== r.H) { F = bakeAbdomen(r.W, r.H); const c = E.mkCanvas(112, 128), g = c.getContext('2d'); g.imageSmoothingEnabled = false; px.reset(g); drawBust(g, CAST.vale, { expr: 'shock' }); px.reset(g); bust = c; }\n    F.stampDisc(F.W / 2 + 20, F.H / 2, 18, 3, 'blood'); F.stampLine([[150, 90], [190, 100]], 3, -3, 'wound'); F.shade({ beat: .2, breath: 1, slow: new URLSearchParams(location.search).has('slow') }); const o = r.w(0, 0, 0); r.ctx.drawImage(F.cv, o[0], o[1]); r.overlay(g => { g.drawImage(bust, r.W - 116, r.H - 128); E.font.text(g, 'extracted from the plan', 8, 8, '#fff', { outline: false }); }); } } } });\n</script></body></html>'''\nopen('verify/page.html', 'w').write(page)\nstub = open('verify/padstub.js').read()\nwith sync_playwright() as p:\n    b = p.chromium.launch(args=['--autoplay-policy=no-user-gesture-required']); ctx = b.new_context(viewport={'width': 1920, 'height': 1080}); pg = ctx.new_page(); errs = []\n    pg.on('pageerror', lambda e: errs.append(str(e))); pg.on('console', lambda m: errs.append(m.text) if m.type in ('error', 'warning') else None)\n    pg.add_init_script(stub); pg.goto('file://' + root + '/verify/page.html'); pg.wait_for_timeout(900)\n    pg.evaluate(\"() => { __pad.axes[2] = .8; __pad.axes[3] = -.4; __pad.axes[0] = -.9; __pad.buttons[7].value = .5; __pad.buttons[7].pressed = true; __pad.timestamp++; }\"); pg.wait_for_timeout(200)\n    print(json.dumps(pg.evaluate('window.S'))); pg.screenshot(path='verify/extracted.png'); print('errors', errs[:4]); b.close()\nEOF\npython3 -I probe/verify2.py 2>&1 | cut -c1-500; cat > probe/headless2.mjs <<'EOF'\nimport vm from 'node:vm'; import { readFileSync } from 'node:fs';\nconst ctx = { console, performance }; ctx.window = ctx; vm.createContext(ctx);\nconst R = f => vm.runInContext(readFileSync(f, 'utf8'), ctx, { filename: f });\nR('engine/dist/handoff/my-3d2dge.js'); vm.runInContext('var E = My3D2dge;', ctx); R('verify/tissue.js'); R('verify/bake.js'); R('verify/bust.js');\nvm.runInContext(`let F, n = 0; const game = new E.Game({ res: [426, 240], expand: true, view: 'overhead', draw: true });\ngame.start({ scene: 'op', scenes: { op: { update(dt) { game.focus(game.W / 2, game.H / 2, 0); }, draw(r) { if (!F) F = bakeAbdomen(r.W, r.H); F.stampDisc(50, 50, 10, 3, 'blood'); F.shade({ beat: .2, breath: 1, lens: { x: 10, y: 10, r: 5 }, dim: .5, spot: { x: 9, y: 9, r: 9 }, light: [-.1, -.4] }); const o = r.w(0, 0, 0); r.ctx.drawImage(F.cv, o[0], o[1]); r.overlay(g => { drawBust(g, CAST.sokolova, { expr: 'sad', talk: 1 }); drawBust(g, CAST.quill, { maskUp: true }); }); n++; } } } });\ngame.advance(.5); globalThis.__r = { n, errors: game.errors.map(e => e.message) };`, ctx);\nconsole.log('headless', JSON.stringify(ctx.__r));\nEOF\nnode probe/headless2.mjs 2>&1 | cut -c1-300; rm -rf verify/setup; mkdir -p hubverify && cp hub/lib/hub/harness.html hub/lib/hub/bridge.js hub/lib/hub/round.js hubverify/ && cp verify/hubgame.js probe/hubgame_x.js && sed -e \"s#probe/hubgame.js#verify/hubgame.js#; s#hubprobe/game.html#hubverify/game.html#\" probe/hubbuild.py > probe/hubbuild_x.py && python3 -I probe/hubbuild_x.py \"$PWD\" >/dev/null && sed '1i import sys as _s; _s.path.insert(0, \"/home/micha/.local/lib/python3.14/site-packages\")' verify/hubtest.py > probe/hubtest_x.py && timeout 400 python3 -I probe/hubtest_x.py hubverify 2>&1 | cut -c1-300","description":"Run setup commands, painter, pad stub and Hub skeleton as extracted from the plan","timeout":520000}}}
