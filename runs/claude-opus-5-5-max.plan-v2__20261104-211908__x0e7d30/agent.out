width': 1280, 'height': 720})\n        pg.goto(f'http://127.0.0.1:{port}/harness.html?game=game.html&players=2&auto=1&play=16000')\n        pg.wait_for_function(\"() => [...document.querySelectorAll('iframe')].length >= 2\", timeout=20000)\n        fr = [f for f in pg.frames if 'game.html' in f.url]\n        for _ in range(120):\n            pg.wait_for_timeout(250)\n            st = fr[0].evaluate(\"() => window.__hubProbe ? window.__hubProbe() : null\")\n            if st and st['phase'] == 'play': break\n        fr[0].evaluate(\"() => G.pause('test')\"); pg.wait_for_timeout(100)\n        a = fr[0].evaluate(\"() => ({ paused: G.paused, screen: G.shell && G.shell.screen, rows: [...document.querySelectorAll('button')].filter(x=>x.offsetParent).map(x=>x.textContent.trim()).filter(Boolean), ...window.__hubProbe() })\")\n        pg.wait_for_timeout(1500); c = fr[0].evaluate(\"() => window.__hubProbe()\")\n        print('host while paused', json.dumps(a)[:400]); print('1.5s later', json.dumps(c)[:200], 'world kept stepping:', c['v'] < a['v'])\n        pg.wait_for_function(\"() => document.body.dataset.complete === 'true'\", timeout=120000)\n        print('harness with pausable+live', pg.evaluate(\"() => ({ pass: __hubCheck.pass, failed: __hubCheck.checks.filter(c=>!c.pass).map(c=>c.name+': '+c.detail) })\")); b.close()\nfinally:\n    srv.terminate(); srv.wait(timeout=5)\nEOF\ntimeout 200 python3 -I probe/hubpause.py hubprobe 2>&1 | cut -c1-700","description":"Test bindings, idle hook, CSS, touch patch and pause during a session","timeout":320000}},"wire_ingest_context":{"toolu_01E53HDS5mP8QspDfqErhoA7":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211908__x0e7d30/work/_research/probe"}}}
