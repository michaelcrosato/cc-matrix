.phase]]\nname = \"The eye opens\"\nnow = \"SCALPEL across the eye, twice\"\nsay = [\"0.2|bashir|The eye. It is open. Cut it, Doctor.\"]\nspawn = [\"eye 0 0.3\"]\n\n[[case.phase]]\nname = \"Second wave\"\nnow = \"Faster this time\"\nsay = [\"0.2|teddy|It is doing it again. It is doing it faster.\"]\nspawn = [\"sac -6 2 8\", \"sac -2.5 -2.5 8\", \"sac 1 2 9\", \"sac 4 -2.5 8\", \"sac 7 2 9\", \"sac 0 0 10\"]\ncheckpoint = true\n\n[[case.phase]]\nname = \"The eye again\"\nnow = \"SCALPEL across the eye, twice\"\nspawn = [\"eye 0 0.3\"]\n\n[[case.phase]]\nname = \"Third wave\"\nnow = \"Faster still\"\nsay = [\"0.2|bashir|Doctor. Steady.\"]\nspawn = [\"sac -6 0 7\", \"sac -3 2.5 7\", \"sac -1 -2.5 7\", \"sac 2 0 8\", \"sac 5 2.5 7\", \"sac 7 -2 8\"]\ncheckpoint = true\n\n[[case.phase]]\nname = \"Pull the eye\"\nnow = \"FORCEPS the eye bed, GEL the burn\"\nsay = [\"0.2|mara|Out. Come out.\", \"2.0|bashir|Gel the bed. Then rest.\"]\nspawn = [\"tendril 0 0.3\", \"burn 0 0.3 1.4\"]\n\n[[case]]\nid = 5\nname = \"Second Opinion\"\nsurgeon = \"pet\"\nplate = \"femur\"\ntimer = 360\npar = 14500\npatient = \"Dmitri Okafor\"\ndx = \"Shattered femur with marrow cysts, longshoreman, 41\"\nfate = \"Dmitri Okafor will walk the quay again, slowly, complaining.\"\nring = [1, 2, 3, 4, 5, 6, 7, 8]\nstrain = \"cysts\"\n\n[[case.phase]]\nname = \"Reassemble\"\nnow = \"FORCEPS the bone to its outline, rotate it to fit, then SUTURE the wire\"\nsay = [\"0.4|pet|I have buried better surgeons than you, and I liked them less. Scalpel.\", \"2.0|pet|Rotate it. Bring it home. Gently.\"]\nspawn = [\"bone -5 2.5 70 -3 -0.5\", \"bone 4 2.5 -40 3 -0.5\", \"bone 0 -3 130 0 0.2\"]\ncheckpoint = true\n\n[[case.phase]]\nname = \"Cysts\"\nnow = \"LASER the cysts. Wake the ECHO when the gift is ready\"\nsay = [\"0.2|pet|Cysts in the marrow. Of course there are.\", \"3.0|pet|My hands. Do you hear that, young man? There were two of me.\"]\nspawn = [\"polyp -6 -2\", \"polyp -3 2\", \"polyp 0 -2\", \"polyp 3 2\", \"polyp 6 -2\", \"nodule 0 0.4 0\"]\nbeats = 3\necho_wake = true\ncheckpoint = true\n\n[[case.phase]]\nname = \"Close\"\nnow = \"SUTURE and DRESS\"\nsay = [\"0.4|pet|Scalpel. Needle. Thread. The oldest song there is.\"]\nspawn = [\"lace -4 -1 4 -1\", \"dress -5 3.4 5 3.4\"]\n\n[[case]]\nid = 6\nname = \"Dies Irae\"\nsurgeon = \"pet\"\nplate = \"pericardium\"\ntimer = 420\npar = 17500\npatient = \"Chief Ottoline Voss\"\ndx = \"R.E.Q.U.I.E.M. strain Dies Irae, carried eleven years\"\nfate = \"Ottoline Voss will name the funder when she wakes.\"\nring = [1, 2, 3, 4, 5, 6, 0, 8]\nstrain = \"dies_irae\"\ncryo = true\n\n[[case.phase]]\nname = \"Embers\"\nnow = \"CRYOPROBE an ember, SCALPEL to crack it, FORCEPS the pieces. Never hold the trigger as a ring passes\"\nsay = [\"0.4|voss|If I die on your table, Perpetua, you will have to fill out the form.\", \"1.2|pet|I have been looking forward to it.\", \"4.0|bashir|Count-in. Five beats. Lift off, Doctor!\"]\nspawn = [\"ember -5 1.5\", \"ember -2 -2\", \"ember 1 2.5\", \"ember 4 -1.5\", \"ember 7 1\"]\nrings = 5\nfever = true\ncheckpoint = true\n\n[[case.phase]]\nname = \"Roaming ember\"\nnow = \"Two embers have merged and roam\"\nsay = [\"0.2|teddy|Two embers merged. They are roaming. I did not know embers could roam.\"]\nspawn = [\"burn -3 0 1.2\", \"burn 3 1 1.2\"]\nrings = 5\nfever = true\n\n[[case.phase]]\nname = \"The furnace\"\nnow = \"SCALPEL, then every tool in sequence\"\nsay = [\"0.2|bashir|Incision. The furnace is beneath.\"]\nspawn = [\"line -5 0 5 0\", \"ember 0 0.5\"]\nrings = 5\nfever = true\ncheckpoint = true\n\n[[case.phase]]\nname = \"Close\"\nnow = \"DRESS the closure\"\nspawn = [\"dress -5 3.4 5 3.4\"]\n\n[[case]]\nid = 7\nname = \"Libera Me\"\nsurgeon = \"both\"\nplate = \"heart\"\ntimer = 540\npar = 24000\npatient = \"Bashir Haddad\"\ndx = \"R.E.Q.U.I.E.M. strain Libera Me, delivered in flowers\"\nfate = \"Bashir Haddad woke at dawn and said: clean, Doctor.\"\nring = [1, 2, 3, 4, 5, 6, 7, 8]\nstrain = \"libera\"\ncryo = true\n\n[[case.phase]]\nname = \"A: Introit\"\nnow = \"Nodules and pools\"\nsay = [\"0.4|mara|Scalpel.\", \"1.2|teddy|...I will do it. I have seen it done. Mostly.\", \"3.0|pet|Breathe, Doctor. I have you.\"]\nspawn = [\"nodule -4 1 0\", \"pool 3 -1 1.2\", \"pool -2 -2 1.0\"]\nbeats = 3\ncheckpoint = true\n\n[[case.phase]]\nname = \"B: Lacrimosa\"\nnow = \"Sacs on the coronary arteries\"\nsay = [\"0.2|pet|Sacs. Laser the stems.\"]\nspawn = [\"sac -5 -2 9\", \"sac -2 2.5 9\", \"sac 1 -2.5 9\", \"sac 4 2 9\", \"sac 7 -1 9\"]\n\n[[case.phase]]\nname = \"C: Dies Irae\"\nnow = \"Embers and heat rings\"\nsay = [\"0.2|teddy|Heat! It is seven-eight now! I do not know what to do with seven-eight!\"]\nspawn = [\"ember -4 1\", \"ember 2 -2\", \"ember 6 2\"]\nrings = 7\nfever = true\ncheckpoint = true\n\n[[case.phase]]\nname = \"D: The heart stops\"\nnow = \"Three shocks, each on a ghost beat\"\nsay = [\"0.2|pet|It stopped on purpose.\", \"1.0|mara|Charge it.\"]\nshocks = 3\ncheckpoint = true\n\n[[case.phase]]\nname = \"E: The Soloist\"\nnow = \"SCALPEL strokes on the beat. Fire the DUET when the meter is full\"\nsay = [\"0.2|teddy|Something just stood up in there.\", \"2.0|pet|There you are.\"]\nspawn = [\"line -6 -1 -2 -1\", \"line -2 -1 2 -1\", \"line 2 -1 6 -1\"]\nrhythm = true\ncheckpoint = true\n\n[[case.phase]]\nname = \"The tendril\"\nnow = \"FORCEPS: pull only while the heart relaxes\"\nsay = [\"0.2|pet|Pull when it relaxes. Not before. Wait for it.\"]\nspawn = [\"tendril 0 0.3\"]\n\n[[case.phase]]\nname = \"Close\"\nnow = \"DRESS the closure\"\nsay = [\"0.4|teddy|Clean, Doctor? That is Bashir's line. I am just saying it for him.\"]\nspawn = [\"dress -5 3.4 5 3.4\"]\n\n[[case]]\nid = 8\nname = \"Code Blue\"\nsurgeon = \"team\"\nplate = \"torso\"\ntimer = 240\npar = 16000\npatient = \"A stranger from the harbour\"\ndx = \"Mass casualty, one patient, many hands\"\nfate = \"The stranger lives. The team has no idea who he is.\"\nring = [1, 2, 3, 4, 5, 6, 7, 8]\ndirector = true\n\n[[case.phase]]\nname = \"Code Blue\"\nnow = \"Keep the patient alive until the clock runs out\"\nsay = [\"0.4|bashir|Everyone to the table. Keep him alive.\"]\nspawn = [\"pool 0 0 1.0\", \"hook -4 1 30\", \"polyp 4 -1\"]\nE\necho done"}}}
