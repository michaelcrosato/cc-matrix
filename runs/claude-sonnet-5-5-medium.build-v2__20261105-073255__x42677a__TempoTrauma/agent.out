{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjxZrd3Dyc3piLHuvq46","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01N864FtkXUuDgXJDq3P5Kvd","name":"Bash","input":{"command":"cat > bot.rs <<'E'\n//! The bot: one stateless task planner. It picks the most urgent valid task, selects the tool,\n//! moves at a human cursor speed and performs the gesture. `skill` scales speed and accuracy.\n//! It drives the tests, the balance tool, attract mode, the Case 7 partner and the Echo.\n\nuse glam::Vec2;\n\nuse super::*;\nuse crate::input::{SurgeonInput, sbtn};\n\nfn slot_of(kind: u8, case: u8) -> u8 {\n    match kind {\n        CRYO => {\n            if case == 7 {\n                7\n            } else {\n                5\n            }\n        }\n        DRESS => 1,\n        k => k,\n    }\n}\n\nfn hash(t: u32, s: usize) -> f32 {\n    let mut x = t.wrapping_mul(2654435761).wrapping_add(s as u32 * 40503);\n    x ^= x >> 15;\n    x = x.wrapping_mul(2246822519);\n    x ^= x >> 13;\n    (x & 0xffff) as f32 / 65535.0 * 2.0 - 1.0\n}\n\nfn urgency(g: &Surgery, h: &Hz) -> f32 {\n    let mut u = h.drain() * 10.0;\n    match h.k {\n        Kind::Sac => u += 40.0 - (h.aux - h.grown).max(0.0) * 3.0,\n        Kind::Nodule => u += if h.si == 1 { 50.0 } else { 6.0 },\n        Kind::Bleeder => u += 60.0,\n        Kind::Eye => u += 45.0,\n        Kind::Ember => u += if h.si > 0 { 20.0 } else { 8.0 },\n        Kind::Tendril => u += 5.0,\n        _ => {}\n    }\n    let _ = g;\n    u\n}\n\npub fn bot_slot(g: &Surgery, s: usize) -> SurgeonInput {\n    let sg = &g.sg[s];\n    let skill = g.bot_skill;\n    let mut inp = SurgeonInput { active: true, aim: sg.pos, tool: 0, ..Default::default() };\n    let tick = g.tick;\n    if skill <= 0.01 {\n        return inp;\n    }\n    let speed = 15.0 * (0.35 + 0.65 * skill) / 60.0;\n    let wob = (1.0 - skill) * 0.6;\n    let noise = Vec2::new(hash(tick / 4, s), hash(tick / 4 + 7919, s)) * wob;\n    let mv = |to: Vec2| -> Vec2 { sg.pos + (to - sg.pos).clamp_length_max(speed) };\n    if g.mode != Mode::Op {\n        return inp;\n    }\n    // Code: charge and release on the ghost beat.\n    if g.code_t > 0.0 {\n        let hold = !(sg.charge >= 1.25 && (g.ghost_phase - 0.5).abs() < 0.08);\n        if hold {\n            inp.held |= sbtn::DEFIB;\n        }\n        return inp;\n    }\n    // Gift: hold, release on the beat.\n    if sg.unlocked_gift && sg.gift >= 100.0 && g.hush <= 0.0 && g.echo <= 0.0 && g.beat > 0.15 && g.beat < 0.999 {\n        inp.held |= sbtn::GIFT;\n    }\n    let case = g.case;\n    // IV when vitals fall.\n    if g.vitals < 42.0 && sg.iv_cd <= 0.0 && g.ring_unlocked(8) && s == 0 {\n        inp.tool = 8;\n        if sg.dose < 0.86 {\n            inp.held |= sbtn::USE;\n        }\n        inp.aim = IV_PORT;\n        return inp;\n    } else if sg.dose > 0.0 && sg.tool == 8 {\n        // release to finish the dose\n        inp.tool = 8;\n        return inp;\n    }\n    // Candidates.\n    let mut cands: Vec<usize> = (0..g.hz.len())\n        .filter(|&i| {\n            let h = &g.hz[i];\n            if h.covered {\n                return false;\n            }\n            if h.k == Kind::Eye && h.aux > 0.5 {\n                return false;\n            }\n            if h.k == Kind::Dress {\n                return g.hz.iter().all(|o| o.k == Kind::Dress);\n            }\n            true\n        })\n        .collect();\n    cands.sort_by(|&a, &b| urgency(g, &g.hz[b]).total_cmp(&urgency(g, &g.hz[a])).then(g.hz[a].id.cmp(&g.hz[b].id)));\n    // Keep working on a held gesture.\n    let locked = g.hz.iter().position(|h| h.grabbed == Some(s as u8)).or_else(|| sg.target.and_then(|id| g.hz.iter().position(|h| h.id == id)));\n    let pick = match locked {\n        Some(i) => Some(i),\n        None => {\n            // Share the work between bots.\n            let others = (0..s).filter(|&o| g.sg[o].active).count();\n            let mut avail: Vec<usize> = cands.clone();\n            // hidden things need scanning first\n            avail.retain(|&i| true || i < usize::MAX);\n            avail.get(others.min(avail.len().saturating_sub(1))).copied()\n        }\n    };\n    let Some(i) = pick else {\n        // nothing to do: park\n        inp.aim = mv(Vec2::new(0.0, 3.8));\n        return inp;\n    };\n    let h = &g.hz[i];\n    // Hidden: scan first.\n    let hidden = (h.hidden && h.reveal <= 0.0) && g.ring_unlocked(7);\n    let kind = if hidden { SCAN } else { h.need() };\n    let kind = if h.k == Kind::Dress { DRESS } else { kind };\n    let slot = slot_of(kind, case);\n    inp.tool = if kind == DRESS { 0 } else { slot };\n    if h.k == Kind::Dress {\n        inp.tool = 0;\n    }\n    // If the slot is locked in this case, nothing to do.\n    let target = h.p;\n    match kind {\n        SCAN => {\n            inp.aim = mv(target + noise);\n            if (sg.pos - target).length() < 1.0 {\n                inp.held |= sbtn::USE;\n            }\n        }\n        SCALPEL => {\n            let (a, b) = Surgery::stroke(h);\n            let l = (b - a).length().max(0.01);\n            let dir = (b - a) / l;\n            let engaged = sg.target == Some(h.id);\n            if !engaged {\n                inp.aim = mv(a + noise * 0.3);\n                if (sg.pos - a).length() < 0.35 {\n                    inp.held |= sbtn::USE;\n                }\n            } else {\n                let t = (((sg.pos - a).dot(dir) / l) + 0.12 / l * 6.0).clamp(0.0, 1.0);\n                let goal = a + dir * (t * l).min(l) + noise * 0.15;\n                inp.aim = mv(goal);\n                inp.held |= sbtn::USE;\n            }\n        }\n        FORCEPS => {\n            if h.k == Kind::Bone {\n                let grabbed = h.grabbed == Some(s as u8);\n                if !grabbed {\n                    inp.aim = mv(h.p);\n                    if (sg.pos - h.p).length() < 0.2 {\n                        inp.held |= sbtn::USE;\n                    }\n                } else {\n                    inp.aim = mv(h.q);\n                    let d = (h.p - h.q).length();\n                    let diff = (h.ang - h.goal).rem_euclid(std::f32::consts::PI);\n                    let diff = if diff > std::f32::consts::FRAC_PI_2 { diff - std::f32::consts::PI } else { diff };\n                    if diff.abs() > 0.05 {\n                        inp.held |= if diff > 0.0 { sbtn::ROT_L } else { sbtn::ROT_R };\n                    }\n                    let angle_ok = diff.abs().to_degrees() < 6.0;\n                    if d < 0.12 && angle_ok {\n                        // release to snap\n                    } else {\n                        inp.held |= sbtn::USE;\n                    }\n                }\n            } else if h.grabbed == Some(s as u8) {\n                inp.held |= sbtn::USE;\n                let axis = Vec2::from_angle(h.ang);\n                if h.k == Kind::Tendril && g.case == 7 {\n                    let diastole = g.beat > 0.45;\n                    inp.aim = if diastole { mv(sg.pos + axis * 0.5) } else { sg.pos };\n                } else {\n                    inp.aim = mv(sg.gp + axis * 1.6 + noise * 0.1);\n                }\n            } else {\n                inp.aim = mv(h.p + noise * 0.1);\n                if (sg.pos - h.p).length() < 0.18 {\n                    inp.held |= sbtn::USE;\n                }\n            }\n        }\n        SUTURE => {\n            let (needle, axis) = {\n                let (n, a) = match h.k {\n                    Kind::Lace => {\n                        let n = h.count().max(1) as f32;\n                        let f = (h.cnt as f32 + 0.5) / n;\n                        let ab = h.q - h.p;\n                        (h.p + ab * f, ab.normalize_or(Vec2::X))\n                    }\n                    _ => (h.p, Vec2::X),\n                };\n                (n, a)\n            };\n            let perp = Vec2::new(-axis.y, axis.x);\n            let lat = (sg.pos - needle).dot(perp);\n            let far = (sg.pos - needle).length() > 1.0;\n            if far {\n                inp.aim = mv(needle + perp * 0.5);\n            } else {\n                let want = if lat > 0.18 {\n                    -0.55\n                } else if lat < -0.18 {\n                    0.55\n                } else if h.last_side >= 0 {\n                    -0.55\n                } else {\n                    0.55\n                };\n                inp.aim = sg.pos + ((needle + perp * want + noise * 0.1) - sg.pos).clamp_length_max(speed * 1.6);\n                inp.held |= sbtn::USE;\n            }\n            if !far {\n                inp.held |= sbtn::USE;\n            }\n        }\n        SUCTION => {\n            inp.aim = mv(target + noise * 0.3);\n            inp.pressure = 1.0;\n            if (sg.pos - target).length() < h.r * 0.7 + 0.2 {\n                inp.held |= sbtn::USE;\n            }\n        }\n        LASER | CRYO => {\n            inp.aim = mv(target + noise * 0.05);\n            let on = (sg.pos - target).length() < 0.2;\n            let auto = h.k == Kind::Sac;\n            let engaged = sg.target == Some(h.id);\n            if on {\n                if auto || !engaged || sg.heat < 0.88 {\n                    inp.held |= sbtn::USE;\n                }\n            }\n        }\n        GEL => {\n            let r = h.r * 0.55;\n            let w = g.t * 7.0;\n            inp.aim = mv(target + Vec2::new(w.cos(), w.sin()) * r);\n            let near = (sg.pos - target).length() < h.r + 0.1;\n            if near && sg.flow > 0.08 {\n                inp.held |= sbtn::USE;\n            }\n            if sg.flow < 0.08 {\n                inp.aim = sg.pos;\n            }\n        }\n        DRESS => {\n            let (a, b) = (h.p, h.q);\n            let l = (b - a).length().max(0.01);\n            let dir = (b - a) / l;\n            let engaged = h.prog > 0.01 && (sg.pos - a).dot(dir) > -0.5;\n            if !engaged && (sg.pos - a).length() > 0.3 {\n                inp.aim = mv(a);\n            } else {\n                let t = (((sg.pos - a).dot(dir)) / l + 0.5 / l).clamp(0.0, 1.0);\n                inp.aim = mv(a + dir * t * l + noise * 0.1);\n                inp.held |= sbtn::USE;\n            }\n        }\n        _ => {}\n    }\n    // Rhythm / Echo helpers could go here.\n    inp\n}\nE\npython3 - <<'E'\nimport re\np='mod.rs'\ns=open(p).read()\ns=s.replace(\"    pub opt_surgeons: u8,\\n\",\"    pub opt_surgeons: u8,\\n    pub bot_skill: f32,\\n\",1)\ns=s.replace(\"            opt_surgeons: 1,\\n\",\"            opt_surgeons: 1,\\n            bot_skill: 1.0,\\n\",1)\nopen(p,'w').write(s)\nE\ncat > frame.rs <<'E'\n//! What the surgery game publishes for drawing: the single source of everything on screen.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct HzView {\n    pub id: u32,\n    pub k: u8,\n    pub p: [f32; 2],\n    pub q: [f32; 2],\n    pub r: f32,\n    pub need: u8,\n    pub si: u8,\n    pub cnt: u8,\n    pub count: u8,\n    pub prog: f32,\n    pub hidden: bool,\n    pub covered: bool,\n    pub reveal: f32,\n    pub ang: f32,\n    pub goal: f32,\n    pub lvl: u8,\n    pub aux: f32,\n    pub grown: f32,\n    pub window: f32,\n    pub grabbed: i8,\n    pub stitches: Vec<f32>,\n    pub frost: f32,\n    pub t: f32,\n    pub stages: usize,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct SurgeonView {\n    pub seat: u8,\n    pub active: bool,\n    pub pos: [f32; 2],\n    pub tool: u8,\n    pub kind: u8,\n    pub held: bool,\n    pub score: i64,\n    pub chain: u32,\n    pub gift: f32,\n    pub gift_on: bool,\n    pub heat: f32,\n    pub dose: f32,\n    pub flow: f32,\n    pub charge: f32,\n    pub recoil: f32,\n    pub ghost: Option<[f32; 2]>,\n    pub bot: bool,\n}\n\n/// Camera shot: target, tilt (deg), yaw (deg), distance, fov (deg).\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct CameraShot {\n    pub target: [f32; 3],\n    pub tilt: f32,\n    pub yaw: f32,\n    pub distance: f32,\n    pub fov: f32,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct SurgeryFrame {\n    pub mode: Mode,\n    pub scene: String,\n    pub case: u8,\n    pub case_name: String,\n    pub step: u16,\n    pub plate: String,\n    pub plate_prev: String,\n    pub plate_t: f32,\n    pub vitals: f32,\n    pub bpm: f32,\n    pub beat: f32,\n    pub beats: u32,\n    pub time_left: f32,\n    pub hz: Vec<HzView>,\n    pub sg: Vec<SurgeonView>,\n    pub pops: Vec<Pop>,\n    pub fx: Vec<Fx>,\n    pub sub: Option<Sub>,\n    pub now_line: String,\n    pub banner: String,\n    pub banner_t: f32,\n    pub fever: f32,\n    pub ring_r: f32,\n    pub ring_warn: bool,\n    pub hush: f32,\n    pub echo: f32,\n    pub code_t: f32,\n    pub ghost_phase: f32,\n    pub flat: f32,\n    pub shake: f32,\n    pub flash: f32,\n    pub results: Option<Results>,\n    pub death_time: f32,\n    pub story: String,\n    pub line: u16,\n    pub typed: f32,\n    pub patient: String,\n    pub dx: String,\n    pub guided: bool,\n    pub attract: bool,\n    pub duet: f32,\n    pub unlocked: Vec<u8>,\n    pub cryo_slot: u8,\n    pub mistakes: i64,\n    pub camera: CameraShot,\n    pub t: f32,\n    pub xbox: bool,\n    pub phase: i32,\n    pub tune_hush: f32,\n    pub surgeon_name: String,\n    pub seg: u8,\n    pub paused: bool,\n    pub codes_left: i32,\n}\n\npub fn build(g: &Surgery) -> SurgeryFrame {\n    let c = g.case_def();\n    let hz = g\n        .hz\n        .iter()\n        .map(|h| HzView {\n            id: h.id,\n            k: h.k as u8,\n            p: h.p.to_array(),\n            q: h.q.to_array(),\n            r: h.r,\n            need: h.need(),\n            si: h.si,\n            cnt: h.cnt,\n            count: h.count(),\n            prog: h.prog,\n            hidden: h.hidden,\n            covered: h.covered,\n            reveal: h.reveal,\n            ang: h.ang,\n            goal: h.goal,\n            lvl: h.lvl,\n            aux: h.aux,\n            grown: h.grown,\n            window: h.window,\n            grabbed: h.grabbed.map(|v| v as i8).unwrap_or(-1),\n            stitches: h.stitches.clone(),\n            frost: h.frost,\n            t: h.t,\n            stages: h.stages.len(),\n        })\n        .collect();\n    let sg = g\n        .sg\n        .iter()\n        .map(|s| SurgeonView {\n            seat: s.seat,\n            active: s.active,\n            pos: s.pos.to_array(),\n            tool: s.tool,\n            kind: g.kind_of(s.tool),\n            held: s.held,\n            score: s.score,\n            chain: s.chain,\n            gift: s.gift,\n            gift_on: s.gift_on,\n            heat: s.heat,\n            dose: s.dose,\n            flow: s.flow,\n            charge: s.charge,\n            recoil: s.recoil,\n            ghost: s.ghost.map(|v| v.to_array()),\n            bot: s.bot,\n        })\n        .collect();\n    // Camera: the operative field from 73 degrees; a push on banners and gifts.\n    let push = if g.hush > 0.0 { 0.9 } else { 1.0 };\n    let camera = CameraShot { target: [0.0, 0.0, 0.2], tilt: 73.0, yaw: 0.0, distance: 19.9 * push, fov: 36.0 };\n    SurgeryFrame {\n        mode: g.mode,\n        scene: g.scene.clone(),\n        case: g.case,\n        case_name: c.name.clone(),\n        step: g.step,\n        plate: g.plate.clone(),\n        plate_prev: g.plate_prev.clone(),\n        plate_t: g.plate_t,\n        vitals: g.vitals,\n        bpm: g.bpm,\n        beat: g.beat,\n        beats: g.beats,\n        time_left: g.time_left,\n        hz,\n        sg,\n        pops: g.pops.clone(),\n        fx: g.fx.clone(),\n        sub: g.sub.clone(),\n        now_line: g.now_line.clone(),\n        banner: g.banner.clone(),\n        banner_t: g.banner_t,\n        fever: g.fever,\n        ring_r: if g.ring_on { g.ring_r } else { -1.0 },\n        ring_warn: g.ring_warn,\n        hush: g.hush,\n        echo: g.echo,\n        code_t: g.code_t,\n        ghost_phase: g.ghost_phase,\n        flat: g.flat,\n        shake: g.shake,\n        flash: g.flash,\n        results: g.results.clone(),\n        death_time: g.death_time,\n        story: g.story.clone(),\n        line: g.line,\n        typed: g.typed,\n        patient: c.patient.clone(),\n        dx: c.dx.clone(),\n        guided: c.guided,\n        attract: g.attract,\n        duet: g.duet,\n        unlocked: c.ring.clone(),\n        cryo_slot: match g.case {\n            6 => 5,\n            7 => 7,\n            _ => 0,\n        },\n        mistakes: g.mistakes,\n        camera,\n        t: g.t,\n        xbox: g.xbox,\n        phase: g.phase,\n        tune_hush: g.tune.get(\"hush_scale\"),\n        surgeon_name: c.surgeon.clone(),\n        seg: g.seg,\n        paused: g.paused,\n        codes_left: g.codes_left,\n    }\n}\n\nimpl SurgeryFrame {\n    pub fn pos(v: [f32; 2]) -> Vec2 {\n        Vec2::from_array(v)\n    }\n}\nE\ncd .. && python3 - <<'E'\np='mod.rs'\ns=open(p).read()\ns=s.replace(\"pub mod starter;\",\"pub mod starter;\\npub mod surgery;\")\ns=s.replace('''    &[entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build)];''','''    &[\n        entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build),\n        entry::<surgery::Surgery>(\"Tempo Trauma: a surgical-action drama (surgery/title, surgery/campaign, surgery/case/<n>, surgery/codeblue).\", surgery::build),\n    ];''')\nopen(p,'w').write(s)\np='../frame.rs'\ns=open(p).read()\ns=s.replace('''    /// Arrived somewhere else (Shardfall place code).\n    Travel {\n        place: u32,\n    },''','''    /// Arrived somewhere else (Shardfall place code).\n    Travel {\n        place: u32,\n    },\n    /// Tempo Trauma: a sound cue (see `games::surgery::cue`) with gain and pitch.\n    Cue {\n        id: u8,\n        pos: Vec3,\n        gain: f32,\n        pitch: f32,\n    },''')\ns=s.replace('''    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\n    /// Agent-readable''','''    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\n    /// Tempo Trauma's frame (None outside the game).\n    pub surgery: Option<std::sync::Arc<crate::games::surgery::SurgeryFrame>>,\n    /// Agent-readable''')\nopen(p,'w').write(s)\np='../sim.rs'\ns=open(p).read()\ns=s.replace('''            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),''','''            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\n            surgery: self.state.play.as_ref().and_then(|p| p.surgery_frame()),''')\nopen(p,'w').write(s)\nE\ncd ../.. && tail -3 ../../../build.log; grep -rn \"RenderFrame {\" --include=*.rs .. | grep -v \"pub struct\" | head"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3652,"cache_read_input_tokens":172376,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3652},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c","uuid":"b9daf004-5278-4762-8a95-5ded476efb74","timestamp":"2026-11-05T14:44:14.248Z","request_id":"req_011CgjxZrMAqFVEGMfYjyq69","wire_tool_inputs":{"toolu_01N864FtkXUuDgXJDq3P5Kvd":{"command":"cat > bot.rs <<'E'\n//! The bot: one stateless task planner. It picks the most urgent valid task, selects the tool,\n//! moves at a human cursor speed and performs the gesture. `skill` scales speed and accuracy.\n//! It drives the tests, the balance tool, attract mode, the Case 7 partner and the Echo.\n\nuse glam::Vec2;\n\nuse super::*;\nuse crate::input::{SurgeonInput, sbtn};\n\nfn slot_of(kind: u8, case: u8) -> u8 {\n    match kind {\n        CRYO => {\n            if case == 7 {\n                7\n            } else {\n                5\n            }\n        }\n        DRESS => 1,\n        k => k,\n    }\n}\n\nfn hash(t: u32, s: usize) -> f32 {\n    let mut x = t.wrapping_mul(2654435761).wrapping_add(s as u32 * 40503);\n    x ^= x >> 15;\n    x = x.wrapping_mul(2246822519);\n    x ^= x >> 13;\n    (x & 0xffff) as f32 / 65535.0 * 2.0 - 1.0\n}\n\nfn urgency(g: &Surgery, h: &Hz) -> f32 {\n    let mut u = h.drain() * 10.0;\n    match h.k {\n        Kind::Sac => u += 40.0 - (h.aux - h.grown).max(0.0) * 3.0,\n        Kind::Nodule => u += if h.si == 1 { 50.0 } else { 6.0 },\n        Kind::Bleeder => u += 60.0,\n        Kind::Eye => u += 45.0,\n        Kind::Ember => u += if h.si > 0 { 20.0 } else { 8.0 },\n        Kind::Tendril => u += 5.0,\n        _ => {}\n    }\n    let _ = g;\n    u\n}\n\npub fn bot_slot(g: &Surgery, s: usize) -> SurgeonInput {\n    let sg = &g.sg[s];\n    let skill = g.bot_skill;\n    let mut inp = SurgeonInput { active: true, aim: sg.pos, tool: 0, ..Default::default() };\n    let tick = g.tick;\n    if skill <= 0.01 {\n        return inp;\n    }\n    let speed = 15.0 * (0.35 + 0.65 * skill) / 60.0;\n    let wob = (1.0 - skill) * 0.6;\n    let noise = Vec2::new(hash(tick / 4, s), hash(tick / 4 + 7919, s)) * wob;\n    let mv = |to: Vec2| -> Vec2 { sg.pos + (to - sg.pos).clamp_length_max(speed) };\n    if g.mode != Mode::Op {\n        return inp;\n    }\n    // Code: charge and release on the ghost beat.\n    if g.code_t > 0.0 {\n        let hold = !(sg.charge >= 1.25 && (g.ghost_phase - 0.5).abs() < 0.08);\n        if hold {\n            inp.held |= sbtn::DEFIB;\n        }\n        return inp;\n    }\n    // Gift: hold, release on the beat.\n    if sg.unlocked_gift && sg.gift >= 100.0 && g.hush <= 0.0 && g.echo <= 0.0 && g.beat > 0.15 && g.beat < 0.999 {\n        inp.held |= sbtn::GIFT;\n    }\n    let case = g.case;\n    // IV when vitals fall.\n    if g.vitals < 42.0 && sg.iv_cd <= 0.0 && g.ring_unlocked(8) && s == 0 {\n        inp.tool = 8;\n        if sg.dose < 0.86 {\n            inp.held |= sbtn::USE;\n        }\n        inp.aim = IV_PORT;\n        return inp;\n    } else if sg.dose > 0.0 && sg.tool == 8 {\n        // release to finish the dose\n        inp.tool = 8;\n        return inp;\n    }\n    // Candidates.\n    let mut cands: Vec<usize> = (0..g.hz.len())\n        .filter(|&i| {\n            let h = &g.hz[i];\n            if h.covered {\n                return false;\n            }\n            if h.k == Kind::Eye && h.aux > 0.5 {\n                return false;\n            }\n            if h.k == Kind::Dress {\n                return g.hz.iter().all(|o| o.k == Kind::Dress);\n            }\n            true\n        })\n        .collect();\n    cands.sort_by(|&a, &b| urgency(g, &g.hz[b]).total_cmp(&urgency(g, &g.hz[a])).then(g.hz[a].id.cmp(&g.hz[b].id)));\n    // Keep working on a held gesture.\n    let locked = g.hz.iter().position(|h| h.grabbed == Some(s as u8)).or_else(|| sg.target.and_then(|id| g.hz.iter().position(|h| h.id == id)));\n    let pick = match locked {\n        Some(i) => Some(i),\n        None => {\n            // Share the work between bots.\n            let others = (0..s).filter(|&o| g.sg[o].active).count();\n            let mut avail: Vec<usize> = cands.clone();\n            // hidden things need scanning first\n            avail.retain(|&i| true || i < usize::MAX);\n            avail.get(others.min(avail.len().saturating_sub(1))).copied()\n        }\n    };\n    let Some(i) = pick else {\n        // nothing to do: park\n        inp.aim = mv(Vec2::new(0.0, 3.8));\n        return inp;\n    };\n    let h = &g.hz[i];\n    // Hidden: scan first.\n    let hidden = (h.hidden && h.reveal <= 0.0) && g.ring_unlocked(7);\n    let kind = if hidden { SCAN } else { h.need() };\n    let kind = if h.k == Kind::Dress { DRESS } else { kind };\n    let slot = slot_of(kind, case);\n    inp.tool = if kind == DRESS { 0 } else { slot };\n    if h.k == Kind::Dress {\n        inp.tool = 0;\n    }\n    // If the slot is locked in this case, nothing to do.\n    let target = h.p;\n    match kind {\n        SCAN => {\n            inp.aim = mv(target + noise);\n            if (sg.pos - target).length() < 1.0 {\n                inp.held |= sbtn::USE;\n            }\n        }\n        SCALPEL => {\n            let (a, b) = Surgery::stroke(h);\n            let l = (b - a).length().max(0.01);\n            let dir = (b - a) / l;\n            let engaged = sg.target == Some(h.id);\n            if !engaged {\n                inp.aim = mv(a + noise * 0.3);\n                if (sg.pos - a).length() < 0.35 {\n                    inp.held |= sbtn::USE;\n                }\n            } else {\n                let t = (((sg.pos - a).dot(dir) / l) + 0.12 / l * 6.0).clamp(0.0, 1.0);\n                let goal = a + dir * (t * l).min(l) + noise * 0.15;\n                inp.aim = mv(goal);\n                inp.held |= sbtn::USE;\n            }\n        }\n        FORCEPS => {\n            if h.k == Kind::Bone {\n                let grabbed = h.grabbed == Some(s as u8);\n                if !grabbed {\n                    inp.aim = mv(h.p);\n                    if (sg.pos - h.p).length() < 0.2 {\n                        inp.held |= sbtn::USE;\n                    }\n                } else {\n                    inp.aim = mv(h.q);\n                    let d = (h.p - h.q).length();\n                    let diff = (h.ang - h.goal).rem_euclid(std::f32::consts::PI);\n                    let diff = if diff > std::f32::consts::FRAC_PI_2 { diff - std::f32::consts::PI } else { diff };\n                    if diff.abs() > 0.05 {\n                        inp.held |= if diff > 0.0 { sbtn::ROT_L } else { sbtn::ROT_R };\n                    }\n                    let angle_ok = diff.abs().to_degrees() < 6.0;\n                    if d < 0.12 && angle_ok {\n                        // release to snap\n                    } else {\n                        inp.held |= sbtn::USE;\n                    }\n                }\n            } else if h.grabbed == Some(s as u8) {\n                inp.held |= sbtn::USE;\n                let axis = Vec2::from_angle(h.ang);\n                if h.k == Kind::Tendril && g.case == 7 {\n                    let diastole = g.beat > 0.45;\n                    inp.aim = if diastole { mv(sg.pos + axis * 0.5) } else { sg.pos };\n                } else {\n                    inp.aim = mv(sg.gp + axis * 1.6 + noise * 0.1);\n                }\n            } else {\n                inp.aim = mv(h.p + noise * 0.1);\n                if (sg.pos - h.p).length() < 0.18 {\n                    inp.held |= sbtn::USE;\n                }\n            }\n        }\n        SUTURE => {\n            let (needle, axis) = {\n                let (n, a) = match h.k {\n                    Kind::Lace => {\n                        let n = h.count().max(1) as f32;\n                        let f = (h.cnt as f32 + 0.5) / n;\n                        let ab = h.q - h.p;\n                        (h.p + ab * f, ab.normalize_or(Vec2::X))\n                    }\n                    _ => (h.p, Vec2::X),\n                };\n                (n, a)\n            };\n            let perp = Vec2::new(-axis.y, axis.x);\n            let lat = (sg.pos - needle).dot(perp);\n            let far = (sg.pos - needle).length() > 1.0;\n            if far {\n                inp.aim = mv(needle + perp * 0.5);\n            } else {\n                let want = if lat > 0.18 {\n                    -0.55\n                } else if lat < -0.18 {\n                    0.55\n                } else if h.last_side >= 0 {\n                    -0.55\n                } else {\n                    0.55\n                };\n                inp.aim = sg.pos + ((needle + perp * want + noise * 0.1) - sg.pos).clamp_length_max(speed * 1.6);\n                inp.held |= sbtn::USE;\n            }\n            if !far {\n                inp.held |= sbtn::USE;\n            }\n        }\n        SUCTION => {\n            inp.aim = mv(target + noise * 0.3);\n            inp.pressure = 1.0;\n            if (sg.pos - target).length() < h.r * 0.7 + 0.2 {\n                inp.held |= sbtn::USE;\n            }\n        }\n        LASER | CRYO => {\n            inp.aim = mv(target + noise * 0.05);\n            let on = (sg.pos - target).length() < 0.2;\n            let auto = h.k == Kind::Sac;\n            let engaged = sg.target == Some(h.id);\n            if on {\n                if auto || !engaged || sg.heat < 0.88 {\n                    inp.held |= sbtn::USE;\n                }\n            }\n        }\n        GEL => {\n            let r = h.r * 0.55;\n            let w = g.t * 7.0;\n            inp.aim = mv(target + Vec2::new(w.cos(), w.sin()) * r);\n            let near = (sg.pos - target).length() < h.r + 0.1;\n            if near && sg.flow > 0.08 {\n                inp.held |= sbtn::USE;\n            }\n            if sg.flow < 0.08 {\n                inp.aim = sg.pos;\n            }\n        }\n        DRESS => {\n            let (a, b) = (h.p, h.q);\n            let l = (b - a).length().max(0.01);\n            let dir = (b - a) / l;\n            let engaged = h.prog > 0.01 && (sg.pos - a).dot(dir) > -0.5;\n            if !engaged && (sg.pos - a).length() > 0.3 {\n                inp.aim = mv(a);\n            } else {\n                let t = (((sg.pos - a).dot(dir)) / l + 0.5 / l).clamp(0.0, 1.0);\n                inp.aim = mv(a + dir * t * l + noise * 0.1);\n                inp.held |= sbtn::USE;\n            }\n        }\n        _ => {}\n    }\n    // Rhythm / Echo helpers could go here.\n    inp\n}\nE\npython3 - <<'E'\nimport re\np='mod.rs'\ns=open(p).read()\ns=s.replace(\"    pub opt_surgeons: u8,\\n\",\"    pub opt_surgeons: u8,\\n    pub bot_skill: f32,\\n\",1)\ns=s.replace(\"            opt_surgeons: 1,\\n\",\"            opt_surgeons: 1,\\n            bot_skill: 1.0,\\n\",1)\nopen(p,'w').write(s)\nE\ncat > frame.rs <<'E'\n//! What the surgery game publishes for drawing: the single source of everything on screen.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct HzView {\n    pub id: u32,\n    pub k: u8,\n    pub p: [f32; 2],\n    pub q: [f32; 2],\n    pub r: f32,\n    pub need: u8,\n    pub si: u8,\n    pub cnt: u8,\n    pub count: u8,\n    pub prog: f32,\n    pub hidden: bool,\n    pub covered: bool,\n    pub reveal: f32,\n    pub ang: f32,\n    pub goal: f32,\n    pub lvl: u8,\n    pub aux: f32,\n    pub grown: f32,\n    pub window: f32,\n    pub grabbed: i8,\n    pub stitches: Vec<f32>,\n    pub frost: f32,\n    pub t: f32,\n    pub stages: usize,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct SurgeonView {\n    pub seat: u8,\n    pub active: bool,\n    pub pos: [f32; 2],\n    pub tool: u8,\n    pub kind: u8,\n    pub held: bool,\n    pub score: i64,\n    pub chain: u32,\n    pub gift: f32,\n    pub gift_on: bool,\n    pub heat: f32,\n    pub dose: f32,\n    pub flow: f32,\n    pub charge: f32,\n    pub recoil: f32,\n    pub ghost: Option<[f32; 2]>,\n    pub bot: bool,\n}\n\n/// Camera shot: target, tilt (deg), yaw (deg), distance, fov (deg).\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct CameraShot {\n    pub target: [f32; 3],\n    pub tilt: f32,\n    pub yaw: f32,\n    pub distance: f32,\n    pub fov: f32,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct SurgeryFrame {\n    pub mode: Mode,\n    pub scene: String,\n    pub case: u8,\n    pub case_name: String,\n    pub step: u16,\n    pub plate: String,\n    pub plate_prev: String,\n    pub plate_t: f32,\n    pub vitals: f32,\n    pub bpm: f32,\n    pub beat: f32,\n    pub beats: u32,\n    pub time_left: f32,\n    pub hz: Vec<HzView>,\n    pub sg: Vec<SurgeonView>,\n    pub pops: Vec<Pop>,\n    pub fx: Vec<Fx>,\n    pub sub: Option<Sub>,\n    pub now_line: String,\n    pub banner: String,\n    pub banner_t: f32,\n    pub fever: f32,\n    pub ring_r: f32,\n    pub ring_warn: bool,\n    pub hush: f32,\n    pub echo: f32,\n    pub code_t: f32,\n    pub ghost_phase: f32,\n    pub flat: f32,\n    pub shake: f32,\n    pub flash: f32,\n    pub results: Option<Results>,\n    pub death_time: f32,\n    pub story: String,\n    pub line: u16,\n    pub typed: f32,\n    pub patient: String,\n    pub dx: String,\n    pub guided: bool,\n    pub attract: bool,\n    pub duet: f32,\n    pub unlocked: Vec<u8>,\n    pub cryo_slot: u8,\n    pub mistakes: i64,\n    pub camera: CameraShot,\n    pub t: f32,\n    pub xbox: bool,\n    pub phase: i32,\n    pub tune_hush: f32,\n    pub surgeon_name: String,\n    pub seg: u8,\n    pub paused: bool,\n    pub codes_left: i32,\n}\n\npub fn build(g: &Surgery) -> SurgeryFrame {\n    let c = g.case_def();\n    let hz = g\n        .hz\n        .iter()\n        .map(|h| HzView {\n            id: h.id,\n            k: h.k as u8,\n            p: h.p.to_array(),\n            q: h.q.to_array(),\n            r: h.r,\n            need: h.need(),\n            si: h.si,\n            cnt: h.cnt,\n            count: h.count(),\n            prog: h.prog,\n            hidden: h.hidden,\n            covered: h.covered,\n            reveal: h.reveal,\n            ang: h.ang,\n            goal: h.goal,\n            lvl: h.lvl,\n            aux: h.aux,\n            grown: h.grown,\n            window: h.window,\n            grabbed: h.grabbed.map(|v| v as i8).unwrap_or(-1),\n            stitches: h.stitches.clone(),\n            frost: h.frost,\n            t: h.t,\n            stages: h.stages.len(),\n        })\n        .collect();\n    let sg = g\n        .sg\n        .iter()\n        .map(|s| SurgeonView {\n            seat: s.seat,\n            active: s.active,\n            pos: s.pos.to_array(),\n            tool: s.tool,\n            kind: g.kind_of(s.tool),\n            held: s.held,\n            score: s.score,\n            chain: s.chain,\n            gift: s.gift,\n            gift_on: s.gift_on,\n            heat: s.heat,\n            dose: s.dose,\n            flow: s.flow,\n            charge: s.charge,\n            recoil: s.recoil,\n            ghost: s.ghost.map(|v| v.to_array()),\n            bot: s.bot,\n        })\n        .collect();\n    // Camera: the operative field from 73 degrees; a push on banners and gifts.\n    let push = if g.hush > 0.0 { 0.9 } else { 1.0 };\n    let camera = CameraShot { target: [0.0, 0.0, 0.2], tilt: 73.0, yaw: 0.0, distance: 19.9 * push, fov: 36.0 };\n    SurgeryFrame {\n        mode: g.mode,\n        scene: g.scene.clone(),\n        case: g.case,\n        case_name: c.name.clone(),\n        step: g.step,\n        plate: g.plate.clone(),\n        plate_prev: g.plate_prev.clone(),\n        plate_t: g.plate_t,\n        vitals: g.vitals,\n        bpm: g.bpm,\n        beat: g.beat,\n        beats: g.beats,\n        time_left: g.time_left,\n        hz,\n        sg,\n        pops: g.pops.clone(),\n        fx: g.fx.clone(),\n        sub: g.sub.clone(),\n        now_line: g.now_line.clone(),\n        banner: g.banner.clone(),\n        banner_t: g.banner_t,\n        fever: g.fever,\n        ring_r: if g.ring_on { g.ring_r } else { -1.0 },\n        ring_warn: g.ring_warn,\n        hush: g.hush,\n        echo: g.echo,\n        code_t: g.code_t,\n        ghost_phase: g.ghost_phase,\n        flat: g.flat,\n        shake: g.shake,\n        flash: g.flash,\n        results: g.results.clone(),\n        death_time: g.death_time,\n        story: g.story.clone(),\n        line: g.line,\n        typed: g.typed,\n        patient: c.patient.clone(),\n        dx: c.dx.clone(),\n        guided: c.guided,\n        attract: g.attract,\n        duet: g.duet,\n        unlocked: c.ring.clone(),\n        cryo_slot: match g.case {\n            6 => 5,\n            7 => 7,\n            _ => 0,\n        },\n        mistakes: g.mistakes,\n        camera,\n        t: g.t,\n        xbox: g.xbox,\n        phase: g.phase,\n        tune_hush: g.tune.get(\"hush_scale\"),\n        surgeon_name: c.surgeon.clone(),\n        seg: g.seg,\n        paused: g.paused,\n        codes_left: g.codes_left,\n    }\n}\n\nimpl SurgeryFrame {\n    pub fn pos(v: [f32; 2]) -> Vec2 {\n        Vec2::from_array(v)\n    }\n}\nE\ncd .. && python3 - <<'E'\np='mod.rs'\ns=open(p).read()\ns=s.replace(\"pub mod starter;\",\"pub mod starter;\\npub mod surgery;\")\ns=s.replace('''    &[entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build)];''','''    &[\n        entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build),\n        entry::<surgery::Surgery>(\"Tempo Trauma: a surgical-action drama (surgery/title, surgery/campaign, surgery/case/<n>, surgery/codeblue).\", surgery::build),\n    ];''')\nopen(p,'w').write(s)\np='../frame.rs'\ns=open(p).read()\ns=s.replace('''    /// Arrived somewhere else (Shardfall place code).\n    Travel {\n        place: u32,\n    },''','''    /// Arrived somewhere else (Shardfall place code).\n    Travel {\n        place: u32,\n    },\n    /// Tempo Trauma: a sound cue (see `games::surgery::cue`) with gain and pitch.\n    Cue {\n        id: u8,\n        pos: Vec3,\n        gain: f32,\n        pitch: f32,\n    },''')\ns=s.replace('''    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\n    /// Agent-readable''','''    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\n    /// Tempo Trauma's frame (None outside the game).\n    pub surgery: Option<std::sync::Arc<crate::games::surgery::SurgeryFrame>>,\n    /// Agent-readable''')\nopen(p,'w').write(s)\np='../sim.rs'\ns=open(p).read()\ns=s.replace('''            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),''','''            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\n            surgery: self.state.play.as_ref().and_then(|p| p.surgery_frame()),''')\nopen(p,'w').write(s)\nE\ncd ../.. && tail -3 ../../../build.log; grep -rn \"RenderFrame {\" --include=*.rs .. | grep -v \"pub struct\" | head"}}}
