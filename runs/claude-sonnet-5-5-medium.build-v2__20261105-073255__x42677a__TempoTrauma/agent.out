{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cgjx3mwgSzhUon7hTFLja","type":"message","role":"assistant","content":[{"type":"text","text":"I'm writing the story script (the cutscene dialogue between operations), then the core simulation code."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8722,"cache_read_input_tokens":101461,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8722},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c","uuid":"cda38ce2-5987-4e88-9791-f8dfbbc8fca9","timestamp":"2026-11-05T14:36:46.041Z","request_id":"req_011Cgjx3mWNwZhSbqPQBUY2y"}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cgjx3mwgSzhUon7hTFLja","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011v4QmRMycq2CpiYfmwWSPq","name":"Bash","input":{"command":"cat > story.toml <<'E'\n# Story scenes. Each [[scene]] has a set (backdrop), optional music, and [[scene.line]]s.\n# who: mara, pet, bashir, teddy, voss, vane, narrator.  expr: neutral, alarmed, stern, soft.\n\n[[scene]]\nid = \"s0\"\nset = \"corridor\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Mercy Harbor General. Port Verity. It is raining, as it has rained every night since the Vane Wing opened.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"The attending is elbow-deep in a bus driver, Doctor. This one is yours.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"Mine? Alone? I have only been a resident for fourteen months.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"soft\"\ntext = \"Anton Deverell, net-mender. Hooks and cable splinters, left forearm. I will be at your elbow the whole time.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"neutral\"\ntext = \"My father tuned pianos. He told me a good hand listens before it moves.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"Then listen, Doctor. Scrub in.\"\n\n[[scene]]\nid = \"s0b\"\nset = \"scrub\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"soft\"\ntext = \"Your hands were steady.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"soft\"\ntext = \"They were not. I was counting his heartbeats.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"That is the same thing, Doctor. In my experience.\"\n\n[[scene]]\nid = \"s1\"\nset = \"gallery\"\nmusic = \"tense\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Rosalind Pike. Harbour pilot. Appendix. It is the most routine operation in the history of operations. So why is the Chief in the gallery?\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"In my hospital, adequate is a kind of malpractice, Doctor Quill.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"Yes, Chief.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"Scalpel, Doctor. Ignore the glass.\"\n\n[[scene]]\nid = \"s1b\"\nset = \"scrub\"\nmusic = \"tense\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"An artery let go as you closed. You found it, and you tied it. Adequate.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"soft\"\ntext = \"Thank you, Chief.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"neutral\"\ntext = \"It was not a compliment.\"\n\n[[scene]]\nid = \"s2\"\nset = \"corridor\"\nmusic = \"tense\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"A grain terminal burns across the harbour. By midnight the corridors are triage.\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Gunnar Holt. Foreman. Fifty-two. Shrapnel in the chest, and I am panicking. I would like that noted.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"Noted, Doctor Lark. Doctor Quill. Open him.\"\n\n[[scene]]\nid = \"s2b\"\nset = \"scrub\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"You said now. Half a beat before the monitor flatlined.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"I heard it go flat. The string was already slack.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"soft\"\ntext = \"I will not ask what that means. I will only say that I noticed.\"\n\n[[scene]]\nid = \"s3\"\nset = \"atrium\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"vane\"\nexpr = \"soft\"\ntext = \"Doctor Quill! The Vane Wing is only possible because of nights like this. Please. Take a glass. The rain is lovely from up here.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"neutral\"\ntext = \"I am due in theatre, Miss Vane.\"\n[[scene.line]]\nwho = \"vane\"\nexpr = \"soft\"\ntext = \"Of course. Go. Save someone. It is what I pay you for.\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Downstairs a courier waits for a liver mass that every scan swears is benign.\"\n\n[[scene]]\nid = \"s3b\"\nset = \"theatre\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"It moved.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"alarmed\"\ntext = \"Masses do not move.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"Bashir. It moved.\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Guys? The ECG just went into three-four time. That is a waltz. Hearts are not allowed to waltz.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"You will wash your hands. You will sign nothing. And you will tell no one what you did not see in this room.\"\n\n[[scene]]\nid = \"s4\"\nset = \"nightward\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"We call it Requiem. Recombinant Enzymatic Quiescent Immuno-Evasive Microfilaria. It is the only organism ever designed to keep time.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"Keep time for what?\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"For the end of you, Doctor.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"Rosalind Pike is on the table again, Doctor. It was in her all along. Seeded while she slept.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"There is no guidance in this room. You will do this alone.\"\n\n[[scene]]\nid = \"s4b\"\nset = \"nightward\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"My hands. They will not open.\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"She is down! Mara is down! Somebody catch the surgeon!\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"Then we need a second opinion.\"\n\n[[scene]]\nid = \"s5\"\nset = \"depot\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"A bus depot at three in the morning. A vending machine hums. Beside it, an old woman holds a paper cup of the worst tea in Port Verity.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"Chief Voss. You look terrible. And you have brought me a child.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"A longshoreman. A shattered femur. A thing in the marrow. And you, Perpetua, who retired.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"I have buried better surgeons than you, and I liked them less. Scalpel.\"\n\n[[scene]]\nid = \"s5b\"\nset = \"scrub\"\nmusic = \"tense\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Doctor Nwosu... there were two of you.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"soft\"\ntext = \"There were always two of me, young man. One of them retired.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"Perpetua. I must tell you something about the strain. Where it came f...\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Chief Ottoline Voss goes down mid-sentence, as a tree goes down, all at once.\"\n\n[[scene]]\nid = \"s6\"\nset = \"theatre\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"I have carried it for eleven years. I helped build it, when Cordelia Vane paid for my laboratory.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"Eleven years, and you never once thought to mention it.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"soft\"\ntext = \"If I die on your table, Perpetua, you will have to fill out the form.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"soft\"\ntext = \"I have been looking forward to it.\"\n\n[[scene]]\nid = \"s6b\"\nset = \"recovery\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"soft\"\ntext = \"Vane. Cordelia Vane. She was the funder.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"Say it again, Ottoline, for the record.\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Upstairs, the Vane Foundation sends flowers to every member of the operating staff. Lilies, white, a card in a lovely hand.\"\n\n[[scene]]\nid = \"s7\"\nset = \"theatre\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Bashir collapsed. The flowers. He smelled the flowers, and he just...\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"The voice that has guided you all night is on the table, child. Wake up.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"I am awake. Scrub me in. Scalpel.\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Nobody hands it to her. Then Teddy does, shaking.\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"...I will do it. I have seen it done. Mostly.\"\n\n[[scene]]\nid = \"s7b\"\nset = \"recovery\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"soft\"\ntext = \"Clean, Doctor.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"soft\"\ntext = \"Clean, Bashir.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"soft\"\ntext = \"Sit down, child. You are not tall enough to cry standing.\"\n\n[[scene]]\nid = \"epilogue\"\nset = \"cabin\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"vane\"\nexpr = \"soft\"\ntext = \"A promising first movement. Have them tune the orchestra.\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"On a ship a long way out in the rain, a very kind woman puts down the phone and listens to the sea keep time.\"\nE\nls"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8722,"cache_read_input_tokens":101461,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8722},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c","uuid":"4980a753-6747-4bb3-9593-1341888f7ccd","timestamp":"2026-11-05T14:37:08.287Z","request_id":"req_011Cgjx3mWNwZhSbqPQBUY2y","wire_tool_inputs":{"toolu_011v4QmRMycq2CpiYfmwWSPq":{"command":"cat > story.toml <<'E'\n# Story scenes. Each [[scene]] has a set (backdrop), optional music, and [[scene.line]]s.\n# who: mara, pet, bashir, teddy, voss, vane, narrator.  expr: neutral, alarmed, stern, soft.\n\n[[scene]]\nid = \"s0\"\nset = \"corridor\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Mercy Harbor General. Port Verity. It is raining, as it has rained every night since the Vane Wing opened.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"The attending is elbow-deep in a bus driver, Doctor. This one is yours.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"Mine? Alone? I have only been a resident for fourteen months.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"soft\"\ntext = \"Anton Deverell, net-mender. Hooks and cable splinters, left forearm. I will be at your elbow the whole time.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"neutral\"\ntext = \"My father tuned pianos. He told me a good hand listens before it moves.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"Then listen, Doctor. Scrub in.\"\n\n[[scene]]\nid = \"s0b\"\nset = \"scrub\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"soft\"\ntext = \"Your hands were steady.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"soft\"\ntext = \"They were not. I was counting his heartbeats.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"That is the same thing, Doctor. In my experience.\"\n\n[[scene]]\nid = \"s1\"\nset = \"gallery\"\nmusic = \"tense\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Rosalind Pike. Harbour pilot. Appendix. It is the most routine operation in the history of operations. So why is the Chief in the gallery?\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"In my hospital, adequate is a kind of malpractice, Doctor Quill.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"Yes, Chief.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"Scalpel, Doctor. Ignore the glass.\"\n\n[[scene]]\nid = \"s1b\"\nset = \"scrub\"\nmusic = \"tense\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"An artery let go as you closed. You found it, and you tied it. Adequate.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"soft\"\ntext = \"Thank you, Chief.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"neutral\"\ntext = \"It was not a compliment.\"\n\n[[scene]]\nid = \"s2\"\nset = \"corridor\"\nmusic = \"tense\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"A grain terminal burns across the harbour. By midnight the corridors are triage.\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Gunnar Holt. Foreman. Fifty-two. Shrapnel in the chest, and I am panicking. I would like that noted.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"Noted, Doctor Lark. Doctor Quill. Open him.\"\n\n[[scene]]\nid = \"s2b\"\nset = \"scrub\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"You said now. Half a beat before the monitor flatlined.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"I heard it go flat. The string was already slack.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"soft\"\ntext = \"I will not ask what that means. I will only say that I noticed.\"\n\n[[scene]]\nid = \"s3\"\nset = \"atrium\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"vane\"\nexpr = \"soft\"\ntext = \"Doctor Quill! The Vane Wing is only possible because of nights like this. Please. Take a glass. The rain is lovely from up here.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"neutral\"\ntext = \"I am due in theatre, Miss Vane.\"\n[[scene.line]]\nwho = \"vane\"\nexpr = \"soft\"\ntext = \"Of course. Go. Save someone. It is what I pay you for.\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Downstairs a courier waits for a liver mass that every scan swears is benign.\"\n\n[[scene]]\nid = \"s3b\"\nset = \"theatre\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"It moved.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"alarmed\"\ntext = \"Masses do not move.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"Bashir. It moved.\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Guys? The ECG just went into three-four time. That is a waltz. Hearts are not allowed to waltz.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"You will wash your hands. You will sign nothing. And you will tell no one what you did not see in this room.\"\n\n[[scene]]\nid = \"s4\"\nset = \"nightward\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"We call it Requiem. Recombinant Enzymatic Quiescent Immuno-Evasive Microfilaria. It is the only organism ever designed to keep time.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"Keep time for what?\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"For the end of you, Doctor.\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"neutral\"\ntext = \"Rosalind Pike is on the table again, Doctor. It was in her all along. Seeded while she slept.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"There is no guidance in this room. You will do this alone.\"\n\n[[scene]]\nid = \"s4b\"\nset = \"nightward\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"My hands. They will not open.\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"She is down! Mara is down! Somebody catch the surgeon!\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"Then we need a second opinion.\"\n\n[[scene]]\nid = \"s5\"\nset = \"depot\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"A bus depot at three in the morning. A vending machine hums. Beside it, an old woman holds a paper cup of the worst tea in Port Verity.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"Chief Voss. You look terrible. And you have brought me a child.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"A longshoreman. A shattered femur. A thing in the marrow. And you, Perpetua, who retired.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"I have buried better surgeons than you, and I liked them less. Scalpel.\"\n\n[[scene]]\nid = \"s5b\"\nset = \"scrub\"\nmusic = \"tense\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Doctor Nwosu... there were two of you.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"soft\"\ntext = \"There were always two of me, young man. One of them retired.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"Perpetua. I must tell you something about the strain. Where it came f...\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Chief Ottoline Voss goes down mid-sentence, as a tree goes down, all at once.\"\n\n[[scene]]\nid = \"s6\"\nset = \"theatre\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"I have carried it for eleven years. I helped build it, when Cordelia Vane paid for my laboratory.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"Eleven years, and you never once thought to mention it.\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"soft\"\ntext = \"If I die on your table, Perpetua, you will have to fill out the form.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"soft\"\ntext = \"I have been looking forward to it.\"\n\n[[scene]]\nid = \"s6b\"\nset = \"recovery\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"voss\"\nexpr = \"soft\"\ntext = \"Vane. Cordelia Vane. She was the funder.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"Say it again, Ottoline, for the record.\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Upstairs, the Vane Foundation sends flowers to every member of the operating staff. Lilies, white, a card in a lovely hand.\"\n\n[[scene]]\nid = \"s7\"\nset = \"theatre\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"Bashir collapsed. The flowers. He smelled the flowers, and he just...\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"stern\"\ntext = \"The voice that has guided you all night is on the table, child. Wake up.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"alarmed\"\ntext = \"I am awake. Scrub me in. Scalpel.\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"Nobody hands it to her. Then Teddy does, shaking.\"\n[[scene.line]]\nwho = \"teddy\"\nexpr = \"alarmed\"\ntext = \"...I will do it. I have seen it done. Mostly.\"\n\n[[scene]]\nid = \"s7b\"\nset = \"recovery\"\nmusic = \"tender\"\n[[scene.line]]\nwho = \"bashir\"\nexpr = \"soft\"\ntext = \"Clean, Doctor.\"\n[[scene.line]]\nwho = \"mara\"\nexpr = \"soft\"\ntext = \"Clean, Bashir.\"\n[[scene.line]]\nwho = \"pet\"\nexpr = \"soft\"\ntext = \"Sit down, child. You are not tall enough to cry standing.\"\n\n[[scene]]\nid = \"epilogue\"\nset = \"cabin\"\nmusic = \"crisis\"\n[[scene.line]]\nwho = \"vane\"\nexpr = \"soft\"\ntext = \"A promising first movement. Have them tune the orchestra.\"\n[[scene.line]]\nwho = \"narrator\"\nexpr = \"neutral\"\ntext = \"On a ship a long way out in the rain, a very kind woman puts down the phone and listens to the sea keep time.\"\nE\nls"}}}
