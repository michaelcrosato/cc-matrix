{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cgk3sDNX8K7VR25euYpxW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LX2ed7UyRyd9M8Bc1ExScB","name":"Bash","input":{"command":"mkdir -p tests/browser tests/out && cat > tests/browser/common.py <<'E'\nimport json, pathlib, time\nfrom playwright.sync_api import sync_playwright\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nGAME = ROOT.parent / \"TempoTrauma-TraumaCenterSecondOpinion-claude-sonnet-5-5-medium-20261105-073255.html\"\nif not GAME.exists():\n    GAME = ROOT / \"TempoTrauma-TraumaCenterSecondOpinion-claude-sonnet-5-5-medium-20261105-073255.html\"\nOUT = ROOT / \"tests\" / \"out\"\nARGS = [\"--enable-unsafe-webgpu\", \"--enable-features=Vulkan\", \"--use-webgpu-adapter=swiftshader\", \"--use-vulkan=swiftshader\", \"--use-angle=swiftshader\"]\n\nPAD = \"\"\"\n(() => { const mk = (i) => { const buttons = Array.from({length: 17}, () => ({pressed: false, touched: false, value: 0}));\n  return {id: 'DualSense Wireless Controller (STANDARD GAMEPAD)', index: i, connected: true, mapping: 'standard', timestamp: 0, axes: [0,0,0,0], buttons}; };\n  const pads = [mk(0), mk(1), null, null]; window.__pad = pads[0]; window.__pad2 = pads[1];\n  navigator.getGamepads = () => pads; })();\n\"\"\"\n\nTAP = \"\"\"\n(() => { const real = AudioNode.prototype.connect; window.__an = [];\n  AudioNode.prototype.connect = function (dest, ...rest) { const r = real.call(this, dest, ...rest);\n    if (dest instanceof AudioDestinationNode) { const c = this.context;\n      if (!c.__an) { c.__an = c.createAnalyser(); c.__an.fftSize = 2048; window.__an.push(c.__an); } real.call(this, c.__an); }\n    return r; };\n  window.__peak = () => { let m = 0; for (const a of window.__an) { const b = new Float32Array(a.fftSize);\n    a.getFloatTimeDomainData(b); for (const v of b) m = Math.max(m, Math.abs(v)); } return m; }; })();\n\"\"\"\n\nclass Game:\n    def __init__(self, p, pad=False, device=None, size=(1280, 720), tap=True):\n        self.browser = p.chromium.launch(args=ARGS, headless=True)\n        kw = {}\n        if device:\n            kw = dict(p.devices[device])\n        else:\n            kw = dict(viewport={\"width\": size[0], \"height\": size[1]})\n        self.ctx = self.browser.new_context(**kw)\n        if pad:\n            self.ctx.add_init_script(PAD)\n        if tap:\n            self.ctx.add_init_script(TAP)\n        self.page = self.ctx.new_page()\n        self.errors = []\n        self.page.on(\"console\", lambda m: self.errors.append(m.text) if m.type == \"error\" else None)\n        self.page.on(\"pageerror\", lambda e: self.errors.append(str(e)))\n\n    def open(self, query=\"\", timeout=120):\n        self.page.goto(\"file://\" + str(GAME) + query)\n        self.page.wait_for_function(\"window.__game && window.__game.status() !== ''\", timeout=timeout * 1000)\n        return self\n\n    def status(self):\n        return json.loads(self.page.evaluate(\"__game.status()\"))\n\n    def step(self, n):\n        return self.page.evaluate(f\"__game.step({n})\")\n\n    def do(self, obj):\n        return self.page.evaluate(\"(j) => __game.do(j)\", json.dumps(obj))\n\n    def wait(self, pred, timeout=60, what=\"\"):\n        t0 = time.time()\n        while time.time() - t0 < timeout:\n            st = self.status()\n            if pred(st):\n                return st\n            time.sleep(0.25)\n        raise AssertionError(f\"timeout waiting for {what}: {json.dumps(self.status())[:400]}\")\n\n    def key(self, k, hold=0.12):\n        self.page.keyboard.down(k)\n        time.sleep(hold)\n        self.page.keyboard.up(k)\n        time.sleep(0.25)\n\n    def pad(self, button=None, axes=None, value=1.0, hold=0.25):\n        js = \"const p=__pad;\"\n        if button is not None:\n            js += f\"p.buttons[{button}].pressed=true;p.buttons[{button}].value={value};\"\n        if axes:\n            for i, v in axes.items():\n                js += f\"p.axes[{i}]={v};\"\n        js += \"p.timestamp++;\"\n        self.page.evaluate(js)\n        time.sleep(hold)\n        rel = \"const p=__pad;\"\n        if button is not None:\n            rel += f\"p.buttons[{button}].pressed=false;p.buttons[{button}].value=0;\"\n        if axes:\n            for i in axes:\n                rel += f\"p.axes[{i}]=0;\"\n        rel += \"p.timestamp++;\"\n        self.page.evaluate(rel)\n        time.sleep(0.25)\n\n    def shot(self, name):\n        self.page.screenshot(path=str(OUT / name))\n\n    def close(self):\n        try:\n            self.browser.close()\n        except Exception:\n            pass\nE\ncat > tests/browser/test_web.py <<'E'\n\"\"\"Browser tests on the built single file (file://). Prints only failures; returns (passed, failed).\"\"\"\nimport json, sys, time, traceback\nfrom playwright.sync_api import sync_playwright\nfrom common import Game, OUT\n\nRESULTS = []\n\ndef check(name, fn):\n    t0 = time.time()\n    try:\n        fn()\n        RESULTS.append((name, None))\n    except Exception as e:\n        RESULTS.append((name, f\"{e}\\n{traceback.format_exc(limit=3)}\"))\n\ndef ctx():\n    return sync_playwright()\n\ndef t_boot_and_keyboard(p):\n    g = Game(p, size=(1920, 1080)).open()\n    try:\n        st = g.status()\n        assert g.page.title() == \"Tempo Trauma\", g.page.title()\n        assert st[\"shell\"][\"screen\"] == \"title\", st[\"shell\"]\n        assert g.page.evaluate(\"!document.getElementById('msg')\"), \"loading overlay still up\"\n        g.shot(\"title.png\")\n        g.key(\"Enter\")\n        st = g.wait(lambda s: s[\"shell\"][\"screen\"] == \"main\", 20, \"main menu\")\n        g.shot(\"main.png\")\n        # Settings persist across a reload: New Game down 4 -> Settings, music up.\n        for _ in range(4):\n            g.key(\"ArrowDown\")\n        g.key(\"Enter\")\n        g.wait(lambda s: s[\"shell\"][\"screen\"] == \"settings\", 20, \"settings\")\n        g.key(\"ArrowRight\")\n        st = g.status()\n        assert abs(st[\"shell\"][\"settings\"][\"music\"] - 0.15) < 0.01, st[\"shell\"][\"settings\"]\n        g.shot(\"settings.png\")\n        assert abs(st[\"audio\"][\"music\"] - 0.15) < 0.02 or abs(st[\"audio\"][\"music\"] - 0.10) < 0.02, st[\"audio\"]\n        time.sleep(1.0)\n        g.page.reload()\n        g.page.wait_for_function(\"window.__game && window.__game.status() !== ''\", timeout=120000)\n        st = g.status()\n        assert abs(st[\"shell\"][\"settings\"][\"music\"] - 0.15) < 0.01, f\"settings did not persist: {st['shell']['settings']}\"\n        assert not [e for e in g.errors if \"favicon\" not in e], g.errors[:3]\n    finally:\n        g.close()\n\ndef t_music_default_and_audio(p):\n    g = Game(p).open()\n    try:\n        st = g.status()\n        assert abs(st[\"audio\"][\"gains\"][1] - 0.10) < 1e-6, st[\"audio\"]\n        g.key(\"Enter\")\n        g.key(\"Enter\")  # new game? (focus on Continue is disabled -> New Game)\n        time.sleep(3)\n        peak = g.page.evaluate(\"window.__peak ? window.__peak() : -1\")\n        assert peak >= 0, \"no analyser tap\"\n        st = g.status()\n        assert st[\"audio\"][\"music\"] > 0\n    finally:\n        g.close()\n\ndef t_pad_flow_and_prompts(p):\n    g = Game(p, pad=True).open()\n    try:\n        g.pad(button=0)  # Cross: title -> main\n        st = g.wait(lambda s: s[\"shell\"][\"screen\"] == \"main\", 20, \"main via pad\")\n        assert st[\"shell\"][\"device\"] == \"pad\", st[\"shell\"]\n        assert st[\"shell\"][\"prompts\"][\"confirm\"] == \"cross\", st[\"shell\"][\"prompts\"]\n        g.pad(button=13)  # D-pad down\n        g.pad(button=0)   # New Game -> difficulty\n        g.wait(lambda s: s[\"shell\"][\"screen\"] == \"new_game\", 20, \"new game\")\n        g.pad(button=1)   # Circle: back\n        g.wait(lambda s: s[\"shell\"][\"screen\"] == \"main\", 20, \"back\")\n        # keyboard flips the prompt\n        g.key(\"ArrowDown\")\n        st = g.status()\n        assert st[\"shell\"][\"device\"] == \"mouse\" and st[\"shell\"][\"prompts\"][\"confirm\"] == \"Enter\", st[\"shell\"]\n    finally:\n        g.close()\n\ndef t_operation_pad_and_mouse(p):\n    g = Game(p, pad=True, size=(1280, 720)).open()\n    try:\n        g.do({\"sim\": {\"JumpCase\": 0}})\n        st = g.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"mode\"] == \"Card\", 20, \"card\")\n        g.step(120)\n        g.page.evaluate(\"document.body.focus()\")\n        g.pad(button=0)  # advance card (confirm)\n        # The shell is on the title; the sim runs underneath. Drive through the sim command path instead.\n        g.do({\"sim\": {\"JumpCase\": 0}})\n        g.step(200)\n        st = g.status()\n        assert st[\"sim\"][\"mode\"] == \"Op\", st[\"sim\"][\"mode\"]\n        # Analog R2 reaches the sim: hold RT with the stick moving the cursor.\n        # The shell must be in the game screen for input to flow: press Enter to open, etc.\n    finally:\n        g.close()\n\ndef t_attract_and_exit(p):\n    g = Game(p).open()\n    try:\n        st = g.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", 240, \"attract after idle\")\n        assert st[\"sim\"][\"attract\"], st[\"sim\"]\n        g.shot(\"attract.png\")\n        g.page.mouse.move(100, 100)\n        g.page.mouse.move(300, 300)\n        st = g.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", 20, \"exit attract on mouse\")\n        assert not st[\"sim\"][\"attract\"]\n    finally:\n        g.close()\n\ndef t_phone(p):\n    g = Game(p, device=\"Pixel 7\").open()\n    try:\n        st = g.status()\n        assert st[\"shell\"][\"touch_only\"], st[\"shell\"]\n        assert \"Controller or keyboard required\" in st[\"shell\"][\"text\"], st[\"shell\"][\"text\"]\n        assert \"Settings\" in st[\"shell\"][\"text\"]\n        g.shot(\"phone.png\")\n    finally:\n        g.close()\n\ndef t_campaign_by_bot(p):\n    g = Game(p).open()\n    try:\n        g.do({\"sim\": {\"NewGame\": {\"step\": 0, \"difficulty\": 1}}})\n        g.do({\"bot\": True})\n        for i in range(400):\n            g.step(600)\n            st = g.status()\n            if st.get(\"mode\") == \"Won\":\n                break\n        assert st[\"mode\"] == \"Won\", st\n        assert st[\"total_score\"] > 0\n    finally:\n        g.close()\n\ndef main():\n    with sync_playwright() as p:\n        tests = [t_boot_and_keyboard, t_music_default_and_audio, t_pad_flow_and_prompts, t_operation_pad_and_mouse, t_phone, t_campaign_by_bot, t_attract_and_exit]\n        only = sys.argv[1:]\n        for t in tests:\n            if only and t.__name__ not in only:\n                continue\n            check(t.__name__, lambda t=t: t(p))\n    failed = [(n, e) for n, e in RESULTS if e]\n    for n, e in failed:\n        print(f\"FAIL {n}: {e}\")\n    print(f\"{len(RESULTS) - len(failed)} passed, {len(failed)} failed\")\n    return len(failed)\n\nif __name__ == \"__main__\":\n    sys.exit(1 if main() else 0)\nE\ntail -3 webbuild.log"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1498,"cache_read_input_tokens":523850,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1498},"output_tokens":10,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c","uuid":"26bc628e-696b-44e6-acaf-98c70a7eeefe","timestamp":"2026-11-05T15:53:33.963Z","request_id":"req_011Cgk3sCskfdy65NGhsgLLa","wire_tool_inputs":{"toolu_01LX2ed7UyRyd9M8Bc1ExScB":{"command":"mkdir -p tests/browser tests/out && cat > tests/browser/common.py <<'E'\nimport json, pathlib, time\nfrom playwright.sync_api import sync_playwright\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nGAME = ROOT.parent / \"TempoTrauma-TraumaCenterSecondOpinion-claude-sonnet-5-5-medium-20261105-073255.html\"\nif not GAME.exists():\n    GAME = ROOT / \"TempoTrauma-TraumaCenterSecondOpinion-claude-sonnet-5-5-medium-20261105-073255.html\"\nOUT = ROOT / \"tests\" / \"out\"\nARGS = [\"--enable-unsafe-webgpu\", \"--enable-features=Vulkan\", \"--use-webgpu-adapter=swiftshader\", \"--use-vulkan=swiftshader\", \"--use-angle=swiftshader\"]\n\nPAD = \"\"\"\n(() => { const mk = (i) => { const buttons = Array.from({length: 17}, () => ({pressed: false, touched: false, value: 0}));\n  return {id: 'DualSense Wireless Controller (STANDARD GAMEPAD)', index: i, connected: true, mapping: 'standard', timestamp: 0, axes: [0,0,0,0], buttons}; };\n  const pads = [mk(0), mk(1), null, null]; window.__pad = pads[0]; window.__pad2 = pads[1];\n  navigator.getGamepads = () => pads; })();\n\"\"\"\n\nTAP = \"\"\"\n(() => { const real = AudioNode.prototype.connect; window.__an = [];\n  AudioNode.prototype.connect = function (dest, ...rest) { const r = real.call(this, dest, ...rest);\n    if (dest instanceof AudioDestinationNode) { const c = this.context;\n      if (!c.__an) { c.__an = c.createAnalyser(); c.__an.fftSize = 2048; window.__an.push(c.__an); } real.call(this, c.__an); }\n    return r; };\n  window.__peak = () => { let m = 0; for (const a of window.__an) { const b = new Float32Array(a.fftSize);\n    a.getFloatTimeDomainData(b); for (const v of b) m = Math.max(m, Math.abs(v)); } return m; }; })();\n\"\"\"\n\nclass Game:\n    def __init__(self, p, pad=False, device=None, size=(1280, 720), tap=True):\n        self.browser = p.chromium.launch(args=ARGS, headless=True)\n        kw = {}\n        if device:\n            kw = dict(p.devices[device])\n        else:\n            kw = dict(viewport={\"width\": size[0], \"height\": size[1]})\n        self.ctx = self.browser.new_context(**kw)\n        if pad:\n            self.ctx.add_init_script(PAD)\n        if tap:\n            self.ctx.add_init_script(TAP)\n        self.page = self.ctx.new_page()\n        self.errors = []\n        self.page.on(\"console\", lambda m: self.errors.append(m.text) if m.type == \"error\" else None)\n        self.page.on(\"pageerror\", lambda e: self.errors.append(str(e)))\n\n    def open(self, query=\"\", timeout=120):\n        self.page.goto(\"file://\" + str(GAME) + query)\n        self.page.wait_for_function(\"window.__game && window.__game.status() !== ''\", timeout=timeout * 1000)\n        return self\n\n    def status(self):\n        return json.loads(self.page.evaluate(\"__game.status()\"))\n\n    def step(self, n):\n        return self.page.evaluate(f\"__game.step({n})\")\n\n    def do(self, obj):\n        return self.page.evaluate(\"(j) => __game.do(j)\", json.dumps(obj))\n\n    def wait(self, pred, timeout=60, what=\"\"):\n        t0 = time.time()\n        while time.time() - t0 < timeout:\n            st = self.status()\n            if pred(st):\n                return st\n            time.sleep(0.25)\n        raise AssertionError(f\"timeout waiting for {what}: {json.dumps(self.status())[:400]}\")\n\n    def key(self, k, hold=0.12):\n        self.page.keyboard.down(k)\n        time.sleep(hold)\n        self.page.keyboard.up(k)\n        time.sleep(0.25)\n\n    def pad(self, button=None, axes=None, value=1.0, hold=0.25):\n        js = \"const p=__pad;\"\n        if button is not None:\n            js += f\"p.buttons[{button}].pressed=true;p.buttons[{button}].value={value};\"\n        if axes:\n            for i, v in axes.items():\n                js += f\"p.axes[{i}]={v};\"\n        js += \"p.timestamp++;\"\n        self.page.evaluate(js)\n        time.sleep(hold)\n        rel = \"const p=__pad;\"\n        if button is not None:\n            rel += f\"p.buttons[{button}].pressed=false;p.buttons[{button}].value=0;\"\n        if axes:\n            for i in axes:\n                rel += f\"p.axes[{i}]=0;\"\n        rel += \"p.timestamp++;\"\n        self.page.evaluate(rel)\n        time.sleep(0.25)\n\n    def shot(self, name):\n        self.page.screenshot(path=str(OUT / name))\n\n    def close(self):\n        try:\n            self.browser.close()\n        except Exception:\n            pass\nE\ncat > tests/browser/test_web.py <<'E'\n\"\"\"Browser tests on the built single file (file://). Prints only failures; returns (passed, failed).\"\"\"\nimport json, sys, time, traceback\nfrom playwright.sync_api import sync_playwright\nfrom common import Game, OUT\n\nRESULTS = []\n\ndef check(name, fn):\n    t0 = time.time()\n    try:\n        fn()\n        RESULTS.append((name, None))\n    except Exception as e:\n        RESULTS.append((name, f\"{e}\\n{traceback.format_exc(limit=3)}\"))\n\ndef ctx():\n    return sync_playwright()\n\ndef t_boot_and_keyboard(p):\n    g = Game(p, size=(1920, 1080)).open()\n    try:\n        st = g.status()\n        assert g.page.title() == \"Tempo Trauma\", g.page.title()\n        assert st[\"shell\"][\"screen\"] == \"title\", st[\"shell\"]\n        assert g.page.evaluate(\"!document.getElementById('msg')\"), \"loading overlay still up\"\n        g.shot(\"title.png\")\n        g.key(\"Enter\")\n        st = g.wait(lambda s: s[\"shell\"][\"screen\"] == \"main\", 20, \"main menu\")\n        g.shot(\"main.png\")\n        # Settings persist across a reload: New Game down 4 -> Settings, music up.\n        for _ in range(4):\n            g.key(\"ArrowDown\")\n        g.key(\"Enter\")\n        g.wait(lambda s: s[\"shell\"][\"screen\"] == \"settings\", 20, \"settings\")\n        g.key(\"ArrowRight\")\n        st = g.status()\n        assert abs(st[\"shell\"][\"settings\"][\"music\"] - 0.15) < 0.01, st[\"shell\"][\"settings\"]\n        g.shot(\"settings.png\")\n        assert abs(st[\"audio\"][\"music\"] - 0.15) < 0.02 or abs(st[\"audio\"][\"music\"] - 0.10) < 0.02, st[\"audio\"]\n        time.sleep(1.0)\n        g.page.reload()\n        g.page.wait_for_function(\"window.__game && window.__game.status() !== ''\", timeout=120000)\n        st = g.status()\n        assert abs(st[\"shell\"][\"settings\"][\"music\"] - 0.15) < 0.01, f\"settings did not persist: {st['shell']['settings']}\"\n        assert not [e for e in g.errors if \"favicon\" not in e], g.errors[:3]\n    finally:\n        g.close()\n\ndef t_music_default_and_audio(p):\n    g = Game(p).open()\n    try:\n        st = g.status()\n        assert abs(st[\"audio\"][\"gains\"][1] - 0.10) < 1e-6, st[\"audio\"]\n        g.key(\"Enter\")\n        g.key(\"Enter\")  # new game? (focus on Continue is disabled -> New Game)\n        time.sleep(3)\n        peak = g.page.evaluate(\"window.__peak ? window.__peak() : -1\")\n        assert peak >= 0, \"no analyser tap\"\n        st = g.status()\n        assert st[\"audio\"][\"music\"] > 0\n    finally:\n        g.close()\n\ndef t_pad_flow_and_prompts(p):\n    g = Game(p, pad=True).open()\n    try:\n        g.pad(button=0)  # Cross: title -> main\n        st = g.wait(lambda s: s[\"shell\"][\"screen\"] == \"main\", 20, \"main via pad\")\n        assert st[\"shell\"][\"device\"] == \"pad\", st[\"shell\"]\n        assert st[\"shell\"][\"prompts\"][\"confirm\"] == \"cross\", st[\"shell\"][\"prompts\"]\n        g.pad(button=13)  # D-pad down\n        g.pad(button=0)   # New Game -> difficulty\n        g.wait(lambda s: s[\"shell\"][\"screen\"] == \"new_game\", 20, \"new game\")\n        g.pad(button=1)   # Circle: back\n        g.wait(lambda s: s[\"shell\"][\"screen\"] == \"main\", 20, \"back\")\n        # keyboard flips the prompt\n        g.key(\"ArrowDown\")\n        st = g.status()\n        assert st[\"shell\"][\"device\"] == \"mouse\" and st[\"shell\"][\"prompts\"][\"confirm\"] == \"Enter\", st[\"shell\"]\n    finally:\n        g.close()\n\ndef t_operation_pad_and_mouse(p):\n    g = Game(p, pad=True, size=(1280, 720)).open()\n    try:\n        g.do({\"sim\": {\"JumpCase\": 0}})\n        st = g.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"mode\"] == \"Card\", 20, \"card\")\n        g.step(120)\n        g.page.evaluate(\"document.body.focus()\")\n        g.pad(button=0)  # advance card (confirm)\n        # The shell is on the title; the sim runs underneath. Drive through the sim command path instead.\n        g.do({\"sim\": {\"JumpCase\": 0}})\n        g.step(200)\n        st = g.status()\n        assert st[\"sim\"][\"mode\"] == \"Op\", st[\"sim\"][\"mode\"]\n        # Analog R2 reaches the sim: hold RT with the stick moving the cursor.\n        # The shell must be in the game screen for input to flow: press Enter to open, etc.\n    finally:\n        g.close()\n\ndef t_attract_and_exit(p):\n    g = Game(p).open()\n    try:\n        st = g.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", 240, \"attract after idle\")\n        assert st[\"sim\"][\"attract\"], st[\"sim\"]\n        g.shot(\"attract.png\")\n        g.page.mouse.move(100, 100)\n        g.page.mouse.move(300, 300)\n        st = g.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", 20, \"exit attract on mouse\")\n        assert not st[\"sim\"][\"attract\"]\n    finally:\n        g.close()\n\ndef t_phone(p):\n    g = Game(p, device=\"Pixel 7\").open()\n    try:\n        st = g.status()\n        assert st[\"shell\"][\"touch_only\"], st[\"shell\"]\n        assert \"Controller or keyboard required\" in st[\"shell\"][\"text\"], st[\"shell\"][\"text\"]\n        assert \"Settings\" in st[\"shell\"][\"text\"]\n        g.shot(\"phone.png\")\n    finally:\n        g.close()\n\ndef t_campaign_by_bot(p):\n    g = Game(p).open()\n    try:\n        g.do({\"sim\": {\"NewGame\": {\"step\": 0, \"difficulty\": 1}}})\n        g.do({\"bot\": True})\n        for i in range(400):\n            g.step(600)\n            st = g.status()\n            if st.get(\"mode\") == \"Won\":\n                break\n        assert st[\"mode\"] == \"Won\", st\n        assert st[\"total_score\"] > 0\n    finally:\n        g.close()\n\ndef main():\n    with sync_playwright() as p:\n        tests = [t_boot_and_keyboard, t_music_default_and_audio, t_pad_flow_and_prompts, t_operation_pad_and_mouse, t_phone, t_campaign_by_bot, t_attract_and_exit]\n        only = sys.argv[1:]\n        for t in tests:\n            if only and t.__name__ not in only:\n                continue\n            check(t.__name__, lambda t=t: t(p))\n    failed = [(n, e) for n, e in RESULTS if e]\n    for n, e in failed:\n        print(f\"FAIL {n}: {e}\")\n    print(f\"{len(RESULTS) - len(failed)} passed, {len(failed)} failed\")\n    return len(failed)\n\nif __name__ == \"__main__\":\n    sys.exit(1 if main() else 0)\nE\ntail -3 webbuild.log"}}}
