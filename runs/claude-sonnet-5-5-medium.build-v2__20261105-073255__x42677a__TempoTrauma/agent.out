eld();\n        host.set_control(|c| c.rewinding = rewinding);\n\n        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let studio_mode = curr.studio_mode();\n        let studio_active = curr.studio_active();\n        self.studio_navigation |= studio_active;\n        let snap_camera = studio_mode != self.studio_mode\n            || prev.studio_mode() != studio_mode\n            || prev.live_edit_ticket != curr.live_edit_ticket;\n        let game_input = game_input && !studio_active;\n12:use pav_render::gpu::BackendChoice;\n13:use pav_render::scene::{MeshInstance, MeshKey, Style, flags as rflags};\n397:        let window = gfx.window.clone();\n399:            let st = UiInput::new(&self.egui_ctx, &window, gfx.device.limits().max_texture_dimension_2d as usize);\n948:        if self.gfx.is_none() || self.host.is_none() {\n1017:                gfx.renderer.clear_particles();\n1147:        let (w, h) = self.gfx.as_ref().unwrap().size();\n1241:        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\n1310:        let gfx = self.gfx.as_mut().unwrap();\n1311:        let (render_scale, lights) =\n1312:            self.scaler.update(self.prefs.quality, self.touch_screen, dt * 1000.0, gfx.size(), gfx.window.scale_factor() as f32);\n1313:        gfx.renderer.render_scale = render_scale;\n1314:        gfx.renderer.max_shadow_lights = lights;\n1322:            gpu_errors: gfx.gpu_errors.load(std::sync::atomic::Ordering::Relaxed),\n1323:            adapter: &gfx.adapter_name,\n1328:            render_scale,\n1355:        let mut raw = state.take(&gfx.window);\n1409:        let out = self.egui_ctx.run_ui(raw, |ui| {\n1449:                let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new(\"pad_cursor\")));\n1452:                painter.add(egui::Shape::convex_polygon(\n1522:                    let m = ui::TouchMenu { prefs: &mut prefs, show_fps, difficulty, portal, scal