{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjzkRnbeTF8BikFM7ftY","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1687,"cache_read_input_tokens":317551,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1687},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c","uuid":"98d9efe0-92e5-4f88-af68-e0a7cf6e69ce","timestamp":"2026-11-05T15:12:17.650Z","request_id":"req_011CgjzkRUk68bNhcKYrvYT1","thinking_duration_ms":8702,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjzkRnbeTF8BikFM7ftY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DJodFBa4hVNtsWTDKYYB7i","name":"Bash","input":{"command":"python3 - <<'E'\np='crates/pav_core/src/games/surgery/mod.rs'\ns=open(p).read()\ns=s.replace(\"\"\"        let h = &mut self.hz[hi];\n        h.cnt += 1;\n        h.prog = 0.0;\"\"\",\"\"\"        let one_hit = self.one_hit;\n        let h = &mut self.hz[hi];\n        if one_hit && matches!(h.k, Kind::Nodule | Kind::Ember | Kind::Eye | Kind::Tendril | Kind::Sac | Kind::Tumor) {\n            h.si = h.stages.len() as u8;\n            h.cnt = 0;\n        }\n        h.cnt += 1;\n        h.prog = 0.0;\"\"\",1)\ns=s.replace(\"\"\"        if h.cnt >= h.count() {\n            h.si += 1;\"\"\",\"\"\"        if h.si as usize >= h.stages.len() {\n            // finished by a one-hit kill\n        } else if h.cnt >= h.count() {\n            h.si += 1;\"\"\",1)\nopen(p,'w').write(s)\nE\nmkdir -p crates/pav_ui/src/surgery && cat > crates/pav_ui/src/surgery/mod.rs <<'E'\n//! Tempo Trauma's shell and HUD: plain Rust plus egui, drawn by `pav_app` and by the headless\n//! tools alike. It takes an abstract input and emits commands.\n\npub mod glyphs;\npub mod shell;\n\npub use shell::{NavIn, Screen, Shell, ShellCmd};\n\nuse serde::{Deserialize, Serialize};\n\npub const SAVE_VERSION: u32 = 1;\n\n/// Settings (saved).\n#[derive(Clone, Debug, Serialize, Deserialize)]\n#[serde(default)]\npub struct Settings {\n    pub music: f32,\n    pub sfx: f32,\n    pub voices: f32,\n    pub xbox: bool,\n    pub cursor_speed: f32,\n    pub aim_assist: f32,\n    pub rumble: bool,\n    pub tremor: bool,\n    pub shake: f32,\n    pub reduce_flashes: bool,\n    pub clinical: bool,\n    pub text_speed: f32,\n    pub fullscreen: bool,\n    pub difficulty: u8,\n}\n\nimpl Default for Settings {\n    fn default() -> Self {\n        Self {\n            music: 0.10,\n            sfx: 0.8,\n            voices: 0.7,\n            xbox: false,\n            cursor_speed: 1.0,\n            aim_assist: 1.0,\n            rumble: true,\n            tremor: true,\n            shake: 1.0,\n            reduce_flashes: false,\n            clinical: false,\n            text_speed: 1.0,\n            fullscreen: false,\n            difficulty: 1,\n        }\n    }\n}\n\n/// Progress (saved): where Continue goes, which cases are unlocked and the best ranks.\n#[derive(Clone, Debug, Serialize, Deserialize, Default)]\n#[serde(default)]\npub struct Progress {\n    pub step: u16,\n    pub unlocked: u8,\n    pub best: Vec<String>,\n    pub total: i64,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct SaveFile {\n    pub version: u32,\n    pub settings: Settings,\n    pub progress: Progress,\n}\n\nimpl Default for SaveFile {\n    fn default() -> Self {\n        Self { version: SAVE_VERSION, settings: Settings::default(), progress: Progress::default() }\n    }\n}\n\nimpl SaveFile {\n    pub fn from_json(s: &str) -> Self {\n        serde_json::from_str::<SaveFile>(s).ok().filter(|f| f.version == SAVE_VERSION).unwrap_or_default()\n    }\n    pub fn to_json(&self) -> String {\n        serde_json::to_string(self).unwrap_or_default()\n    }\n}\n\npub fn rank_value(r: &str) -> u8 {\n    match r {\n        \"C\" => 1,\n        \"B\" => 2,\n        \"A\" => 3,\n        \"S\" => 4,\n        \"ENCORE\" => 5,\n        _ => 0,\n    }\n}\nE\ncat > crates/pav_ui/src/surgery/glyphs.rs <<'E'\n//! Button prompts drawn as vector shapes: PlayStation, Xbox, or keys and mouse, following the\n//! device used last.\n\nuse egui::{Align2, Color32, FontId, Painter, Pos2, Rect, Shape, Stroke, StrokeKind, Vec2};\n\nuse crate::Device;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Act {\n    Confirm,\n    Back,\n    Square,\n    Triangle,\n    Use,\n    Cancel,\n    Gift,\n    Chart,\n    Pause,\n    Pick,\n    Defib,\n    Precision,\n    Rotate,\n    Advance,\n    Skip,\n    Move,\n    Tabs,\n    CycleTool,\n}\n\n/// What to draw for an action on a device: glyph ids (for tests) and a label.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct Prompt {\n    pub glyph: String,\n    pub label: &'static str,\n}\n\npub fn prompt(act: Act, device: Device, xbox: bool) -> Prompt {\n    let g = |s: &str| Prompt { glyph: s.to_string(), label: \"\" };\n    let ps = |ps: &str, xb: &str| if xbox { xb.to_string() } else { ps.to_string() };\n    let pad = device == Device::Gamepad;\n    let id = if pad {\n        match act {\n            Act::Confirm | Act::Advance => ps(\"cross\", \"A\"),\n            Act::Back | Act::Cancel => ps(\"circle\", \"B\"),\n            Act::Square | Act::Chart => ps(\"square\", \"X\"),\n            Act::Triangle | Act::Gift => ps(\"triangle\", \"Y\"),\n            Act::Use => ps(\"R2\", \"RT\"),\n            Act::Pause => ps(\"options\", \"Menu\"),\n            Act::Pick => \"stick_l\".into(),\n            Act::Defib => ps(\"L2+R2\", \"LT+RT\"),\n            Act::Precision => ps(\"L2\", \"LT\"),\n            Act::Rotate | Act::Tabs | Act::CycleTool => ps(\"L1/R1\", \"LB/RB\"),\n            Act::Skip => ps(\"cross-hold\", \"A-hold\"),\n            Act::Move => \"stick_r\".into(),\n        }\n    } else {\n        match act {\n            Act::Confirm | Act::Advance => \"Enter\".into(),\n            Act::Back => \"Esc\".into(),\n            Act::Cancel => \"Q\".into(),\n            Act::Square | Act::Chart => \"Tab\".into(),\n            Act::Triangle | Act::Gift => \"Space\".into(),\n            Act::Use => \"LMB\".into(),\n            Act::Pause => \"Esc\".into(),\n            Act::Pick => \"1-8\".into(),\n            Act::Defib => \"LMB+RMB\".into(),\n            Act::Precision => \"Shift\".into(),\n            Act::Rotate => \"Wheel\".into(),\n            Act::Tabs | Act::CycleTool => \"Q/E\".into(),\n            Act::Skip => \"Ctrl\".into(),\n            Act::Move => \"WASD\".into(),\n        }\n    };\n    let label = match act {\n        Act::Confirm => \"Select\",\n        Act::Back => \"Back\",\n        Act::Square | Act::Chart => \"Chart\",\n        Act::Triangle | Act::Gift => \"Gift\",\n        Act::Use => \"Operate\",\n        Act::Cancel => \"Let go\",\n        Act::Pause => \"Pause\",\n        Act::Pick => \"Instrument\",\n        Act::Defib => \"Defibrillate\",\n        Act::Precision => \"Precision\",\n        Act::Rotate => \"Rotate\",\n        Act::Advance => \"Continue\",\n        Act::Skip => \"Skip\",\n        Act::Move => \"Move\",\n        Act::Tabs => \"Page\",\n        Act::CycleTool => \"Cycle\",\n    };\n    let mut p = g(&id);\n    p.label = label;\n    p\n}\n\nfn ps_color(id: &str) -> Color32 {\n    match id {\n        \"cross\" => Color32::from_rgb(110, 150, 255),\n        \"circle\" => Color32::from_rgb(255, 100, 110),\n        \"square\" => Color32::from_rgb(240, 150, 220),\n        \"triangle\" => Color32::from_rgb(90, 220, 170),\n        _ => Color32::from_rgb(210, 214, 224),\n    }\n}\n\nfn xb_color(id: &str) -> Color32 {\n    match id {\n        \"A\" => Color32::from_rgb(110, 200, 90),\n        \"B\" => Color32::from_rgb(235, 90, 80),\n        \"X\" => Color32::from_rgb(90, 150, 240),\n        \"Y\" => Color32::from_rgb(240, 200, 70),\n        _ => Color32::from_rgb(210, 214, 224),\n    }\n}\n\n/// Draws a glyph for `id` (see `prompt`) centred at `c`, `s` points across. Returns its width.\npub fn glyph(p: &Painter, id: &str, c: Pos2, s: f32, xbox: bool) -> f32 {\n    let r = s * 0.5;\n    let dark = Color32::from_rgb(24, 28, 36);\n    let stroke = Stroke::new((s * 0.09).max(1.5), Color32::WHITE);\n    let face = |p: &Painter, col: Color32| {\n        p.circle_filled(c, r, dark);\n        p.circle_stroke(c, r, Stroke::new((s * 0.07).max(1.5), col));\n    };\n    let font = FontId::proportional(s * 0.62);\n    if xbox && matches!(id, \"A\" | \"B\" | \"X\" | \"Y\") {\n        face(p, xb_color(id));\n        p.text(c, Align2::CENTER_CENTER, id, font, xb_color(id));\n        return s;\n    }\n    match id {\n        \"cross\" | \"circle\" | \"square\" | \"triangle\" => {\n            let col = ps_color(id);\n            face(p, col);\n            let k = r * 0.5;\n            let st = Stroke::new((s * 0.1).max(2.0), col);\n            match id {\n                \"cross\" => {\n                    p.line_segment([c + Vec2::new(-k, -k), c + Vec2::new(k, k)], st);\n                    p.line_segment([c + Vec2::new(-k, k), c + Vec2::new(k, -k)], st);\n                }\n                \"circle\" => {\n                    p.circle_stroke(c, k * 1.05, st);\n                }\n                \"square\" => {\n                    p.rect_stroke(Rect::from_center_size(c, Vec2::splat(k * 1.9)), 1.0, st, StrokeKind::Middle);\n                }\n                _ => {\n                    let pts = vec![c + Vec2::new(0.0, -k * 1.1), c + Vec2::new(k * 1.05, k * 0.8), c + Vec2::new(-k * 1.05, k * 0.8)];\n                    p.add(Shape::closed_line(pts, st));\n                }\n            }\n            s\n        }\n        \"stick_l\" | \"stick_r\" => {\n            face(p, Color32::from_rgb(210, 214, 224));\n            p.circle_filled(c, r * 0.5, Color32::from_rgb(210, 214, 224));\n            let l = if id == \"stick_l\" { \"L\" } else { \"R\" };\n            p.text(c, Align2::CENTER_CENTER, l, FontId::proportional(s * 0.5), dark);\n            s\n        }\n        \"A\" | \"B\" | \"X\" | \"Y\" | \"cross-hold\" | \"A-hold\" => {\n            face(p, Color32::WHITE);\n            s\n        }\n        _ => {\n            // Wide key or trigger shape with a label.\n            let g = p.layout_no_wrap(id.to_string(), font.clone(), Color32::WHITE);\n            let w = (g.size().x + s * 0.6).max(s);\n            let rect = Rect::from_center_size(c, Vec2::new(w, s * 0.86));\n            let kbd = !matches!(id, \"L1\" | \"R1\" | \"L2\" | \"R2\" | \"LB\" | \"RB\" | \"LT\" | \"RT\" | \"options\" | \"Menu\" | \"L2+R2\" | \"LT+RT\" | \"L1/R1\" | \"LB/RB\" | \"stick\");\n            p.rect_filled(rect, if kbd { 5.0 } else { s * 0.4 }, Color32::from_rgb(36, 42, 54));\n            p.rect_stroke(rect, if kbd { 5.0 } else { s * 0.4 }, stroke, StrokeKind::Middle);\n            p.text(c, Align2::CENTER_CENTER, id, font, Color32::WHITE);\n            w\n        }\n    }\n}\nE\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1687,"cache_read_input_tokens":317551,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1687},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c","uuid":"6f353f44-daea-4771-a000-a0db68c3e479","timestamp":"2026-11-05T15:12:41.022Z","request_id":"req_011CgjzkRUk68bNhcKYrvYT1","wire_tool_inputs":{"toolu_01DJodFBa4hVNtsWTDKYYB7i":{"command":"python3 - <<'E'\np='crates/pav_core/src/games/surgery/mod.rs'\ns=open(p).read()\ns=s.replace(\"\"\"        let h = &mut self.hz[hi];\n        h.cnt += 1;\n        h.prog = 0.0;\"\"\",\"\"\"        let one_hit = self.one_hit;\n        let h = &mut self.hz[hi];\n        if one_hit && matches!(h.k, Kind::Nodule | Kind::Ember | Kind::Eye | Kind::Tendril | Kind::Sac | Kind::Tumor) {\n            h.si = h.stages.len() as u8;\n            h.cnt = 0;\n        }\n        h.cnt += 1;\n        h.prog = 0.0;\"\"\",1)\ns=s.replace(\"\"\"        if h.cnt >= h.count() {\n            h.si += 1;\"\"\",\"\"\"        if h.si as usize >= h.stages.len() {\n            // finished by a one-hit kill\n        } else if h.cnt >= h.count() {\n            h.si += 1;\"\"\",1)\nopen(p,'w').write(s)\nE\nmkdir -p crates/pav_ui/src/surgery && cat > crates/pav_ui/src/surgery/mod.rs <<'E'\n//! Tempo Trauma's shell and HUD: plain Rust plus egui, drawn by `pav_app` and by the headless\n//! tools alike. It takes an abstract input and emits commands.\n\npub mod glyphs;\npub mod shell;\n\npub use shell::{NavIn, Screen, Shell, ShellCmd};\n\nuse serde::{Deserialize, Serialize};\n\npub const SAVE_VERSION: u32 = 1;\n\n/// Settings (saved).\n#[derive(Clone, Debug, Serialize, Deserialize)]\n#[serde(default)]\npub struct Settings {\n    pub music: f32,\n    pub sfx: f32,\n    pub voices: f32,\n    pub xbox: bool,\n    pub cursor_speed: f32,\n    pub aim_assist: f32,\n    pub rumble: bool,\n    pub tremor: bool,\n    pub shake: f32,\n    pub reduce_flashes: bool,\n    pub clinical: bool,\n    pub text_speed: f32,\n    pub fullscreen: bool,\n    pub difficulty: u8,\n}\n\nimpl Default for Settings {\n    fn default() -> Self {\n        Self {\n            music: 0.10,\n            sfx: 0.8,\n            voices: 0.7,\n            xbox: false,\n            cursor_speed: 1.0,\n            aim_assist: 1.0,\n            rumble: true,\n            tremor: true,\n            shake: 1.0,\n            reduce_flashes: false,\n            clinical: false,\n            text_speed: 1.0,\n            fullscreen: false,\n            difficulty: 1,\n        }\n    }\n}\n\n/// Progress (saved): where Continue goes, which cases are unlocked and the best ranks.\n#[derive(Clone, Debug, Serialize, Deserialize, Default)]\n#[serde(default)]\npub struct Progress {\n    pub step: u16,\n    pub unlocked: u8,\n    pub best: Vec<String>,\n    pub total: i64,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct SaveFile {\n    pub version: u32,\n    pub settings: Settings,\n    pub progress: Progress,\n}\n\nimpl Default for SaveFile {\n    fn default() -> Self {\n        Self { version: SAVE_VERSION, settings: Settings::default(), progress: Progress::default() }\n    }\n}\n\nimpl SaveFile {\n    pub fn from_json(s: &str) -> Self {\n        serde_json::from_str::<SaveFile>(s).ok().filter(|f| f.version == SAVE_VERSION).unwrap_or_default()\n    }\n    pub fn to_json(&self) -> String {\n        serde_json::to_string(self).unwrap_or_default()\n    }\n}\n\npub fn rank_value(r: &str) -> u8 {\n    match r {\n        \"C\" => 1,\n        \"B\" => 2,\n        \"A\" => 3,\n        \"S\" => 4,\n        \"ENCORE\" => 5,\n        _ => 0,\n    }\n}\nE\ncat > crates/pav_ui/src/surgery/glyphs.rs <<'E'\n//! Button prompts drawn as vector shapes: PlayStation, Xbox, or keys and mouse, following the\n//! device used last.\n\nuse egui::{Align2, Color32, FontId, Painter, Pos2, Rect, Shape, Stroke, StrokeKind, Vec2};\n\nuse crate::Device;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Act {\n    Confirm,\n    Back,\n    Square,\n    Triangle,\n    Use,\n    Cancel,\n    Gift,\n    Chart,\n    Pause,\n    Pick,\n    Defib,\n    Precision,\n    Rotate,\n    Advance,\n    Skip,\n    Move,\n    Tabs,\n    CycleTool,\n}\n\n/// What to draw for an action on a device: glyph ids (for tests) and a label.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct Prompt {\n    pub glyph: String,\n    pub label: &'static str,\n}\n\npub fn prompt(act: Act, device: Device, xbox: bool) -> Prompt {\n    let g = |s: &str| Prompt { glyph: s.to_string(), label: \"\" };\n    let ps = |ps: &str, xb: &str| if xbox { xb.to_string() } else { ps.to_string() };\n    let pad = device == Device::Gamepad;\n    let id = if pad {\n        match act {\n            Act::Confirm | Act::Advance => ps(\"cross\", \"A\"),\n            Act::Back | Act::Cancel => ps(\"circle\", \"B\"),\n            Act::Square | Act::Chart => ps(\"square\", \"X\"),\n            Act::Triangle | Act::Gift => ps(\"triangle\", \"Y\"),\n            Act::Use => ps(\"R2\", \"RT\"),\n            Act::Pause => ps(\"options\", \"Menu\"),\n            Act::Pick => \"stick_l\".into(),\n            Act::Defib => ps(\"L2+R2\", \"LT+RT\"),\n            Act::Precision => ps(\"L2\", \"LT\"),\n            Act::Rotate | Act::Tabs | Act::CycleTool => ps(\"L1/R1\", \"LB/RB\"),\n            Act::Skip => ps(\"cross-hold\", \"A-hold\"),\n            Act::Move => \"stick_r\".into(),\n        }\n    } else {\n        match act {\n            Act::Confirm | Act::Advance => \"Enter\".into(),\n            Act::Back => \"Esc\".into(),\n            Act::Cancel => \"Q\".into(),\n            Act::Square | Act::Chart => \"Tab\".into(),\n            Act::Triangle | Act::Gift => \"Space\".into(),\n            Act::Use => \"LMB\".into(),\n            Act::Pause => \"Esc\".into(),\n            Act::Pick => \"1-8\".into(),\n            Act::Defib => \"LMB+RMB\".into(),\n            Act::Precision => \"Shift\".into(),\n            Act::Rotate => \"Wheel\".into(),\n            Act::Tabs | Act::CycleTool => \"Q/E\".into(),\n            Act::Skip => \"Ctrl\".into(),\n            Act::Move => \"WASD\".into(),\n        }\n    };\n    let label = match act {\n        Act::Confirm => \"Select\",\n        Act::Back => \"Back\",\n        Act::Square | Act::Chart => \"Chart\",\n        Act::Triangle | Act::Gift => \"Gift\",\n        Act::Use => \"Operate\",\n        Act::Cancel => \"Let go\",\n        Act::Pause => \"Pause\",\n        Act::Pick => \"Instrument\",\n        Act::Defib => \"Defibrillate\",\n        Act::Precision => \"Precision\",\n        Act::Rotate => \"Rotate\",\n        Act::Advance => \"Continue\",\n        Act::Skip => \"Skip\",\n        Act::Move => \"Move\",\n        Act::Tabs => \"Page\",\n        Act::CycleTool => \"Cycle\",\n    };\n    let mut p = g(&id);\n    p.label = label;\n    p\n}\n\nfn ps_color(id: &str) -> Color32 {\n    match id {\n        \"cross\" => Color32::from_rgb(110, 150, 255),\n        \"circle\" => Color32::from_rgb(255, 100, 110),\n        \"square\" => Color32::from_rgb(240, 150, 220),\n        \"triangle\" => Color32::from_rgb(90, 220, 170),\n        _ => Color32::from_rgb(210, 214, 224),\n    }\n}\n\nfn xb_color(id: &str) -> Color32 {\n    match id {\n        \"A\" => Color32::from_rgb(110, 200, 90),\n        \"B\" => Color32::from_rgb(235, 90, 80),\n        \"X\" => Color32::from_rgb(90, 150, 240),\n        \"Y\" => Color32::from_rgb(240, 200, 70),\n        _ => Color32::from_rgb(210, 214, 224),\n    }\n}\n\n/// Draws a glyph for `id` (see `prompt`) centred at `c`, `s` points across. Returns its width.\npub fn glyph(p: &Painter, id: &str, c: Pos2, s: f32, xbox: bool) -> f32 {\n    let r = s * 0.5;\n    let dark = Color32::from_rgb(24, 28, 36);\n    let stroke = Stroke::new((s * 0.09).max(1.5), Color32::WHITE);\n    let face = |p: &Painter, col: Color32| {\n        p.circle_filled(c, r, dark);\n        p.circle_stroke(c, r, Stroke::new((s * 0.07).max(1.5), col));\n    };\n    let font = FontId::proportional(s * 0.62);\n    if xbox && matches!(id, \"A\" | \"B\" | \"X\" | \"Y\") {\n        face(p, xb_color(id));\n        p.text(c, Align2::CENTER_CENTER, id, font, xb_color(id));\n        return s;\n    }\n    match id {\n        \"cross\" | \"circle\" | \"square\" | \"triangle\" => {\n            let col = ps_color(id);\n            face(p, col);\n            let k = r * 0.5;\n            let st = Stroke::new((s * 0.1).max(2.0), col);\n            match id {\n                \"cross\" => {\n                    p.line_segment([c + Vec2::new(-k, -k), c + Vec2::new(k, k)], st);\n                    p.line_segment([c + Vec2::new(-k, k), c + Vec2::new(k, -k)], st);\n                }\n                \"circle\" => {\n                    p.circle_stroke(c, k * 1.05, st);\n                }\n                \"square\" => {\n                    p.rect_stroke(Rect::from_center_size(c, Vec2::splat(k * 1.9)), 1.0, st, StrokeKind::Middle);\n                }\n                _ => {\n                    let pts = vec![c + Vec2::new(0.0, -k * 1.1), c + Vec2::new(k * 1.05, k * 0.8), c + Vec2::new(-k * 1.05, k * 0.8)];\n                    p.add(Shape::closed_line(pts, st));\n                }\n            }\n            s\n        }\n        \"stick_l\" | \"stick_r\" => {\n            face(p, Color32::from_rgb(210, 214, 224));\n            p.circle_filled(c, r * 0.5, Color32::from_rgb(210, 214, 224));\n            let l = if id == \"stick_l\" { \"L\" } else { \"R\" };\n            p.text(c, Align2::CENTER_CENTER, l, FontId::proportional(s * 0.5), dark);\n            s\n        }\n        \"A\" | \"B\" | \"X\" | \"Y\" | \"cross-hold\" | \"A-hold\" => {\n            face(p, Color32::WHITE);\n            s\n        }\n        _ => {\n            // Wide key or trigger shape with a label.\n            let g = p.layout_no_wrap(id.to_string(), font.clone(), Color32::WHITE);\n            let w = (g.size().x + s * 0.6).max(s);\n            let rect = Rect::from_center_size(c, Vec2::new(w, s * 0.86));\n            let kbd = !matches!(id, \"L1\" | \"R1\" | \"L2\" | \"R2\" | \"LB\" | \"RB\" | \"LT\" | \"RT\" | \"options\" | \"Menu\" | \"L2+R2\" | \"LT+RT\" | \"L1/R1\" | \"LB/RB\" | \"stick\");\n            p.rect_filled(rect, if kbd { 5.0 } else { s * 0.4 }, Color32::from_rgb(36, 42, 54));\n            p.rect_stroke(rect, if kbd { 5.0 } else { s * 0.4 }, stroke, StrokeKind::Middle);\n            p.text(c, Align2::CENTER_CENTER, id, font, Color32::WHITE);\n            w\n        }\n    }\n}\nE\necho ok"}}}
