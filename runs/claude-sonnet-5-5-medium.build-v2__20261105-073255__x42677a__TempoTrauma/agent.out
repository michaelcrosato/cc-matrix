itter=50&loss=5&auto=1&limit=20\", \"players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave&limit=20\", \"players=2&scenario=server&auto=1&limit=20\", \"players=1&auto=1&limit=20\"):\n                try:\n                    r = run_harness(p, port, q)\n                    ok = bool(r.get(\"pass\"))\n                    RESULTS.append((q, None if ok else json.dumps(r)[:1500]))\n                except Exception as e:\n                    RESULTS.append((q, str(e)[:500]))\n    finally:\n        proc.terminate()\n    failed = [(n, e) for n, e in RESULTS if e]\n    for n, e in failed:\n        print(\"FAIL\", n, e)\n    print(f\"{len(RESULTS) - len(failed)} passed, {len(failed)} failed\")\n    return len(failed)\n\nif __name__ == \"__main__\":\n    sys.exit(1 if main() else 0)\nE\necho ok","is_backgrounded":false,"task_type":"local_bash","uuid":"36a57788-21be-44d1-8daa-54b36f97adb5","session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c"}
