e), info: null, events: [], last: null, cardLeft: null, started: false };\n  // Controller rumble from the game, on any pad that has an actuator.\n  window.__rumble = function (v, ms) {\n    try {\n      var pads = navigator.getGamepads ? navigator.getGamepads() : [];\n      for (var i = 0; i < pads.length; i++) {\n        var p = pads[i];\n        var act = p && (p.vibrationActuator || (p.hapticActuators && p.hapticActuators[0]));\n        if (act && act.playEffect) act.playEffect('dual-rumble', { duration: ms || 100, strongMagnitude: Math.min(1, v), weakMagnitude: Math.min(1, v * 0.6) });\n      }\n    } catch (e) { /* no rumble here */ }\n  };\n  if (!H.active) return;\n  H.pollQueue = [];\n  A.connect({ mode: 'shared-world', seats: [1, 4], card: true }).then(function (info) {\n    if (!info) { H.active = false; return; }   // no hub after all: run as on its own\n    H.info = info;\n    ['card', 'start', 'leave', 'end'].forEach(function (ev) {\n      A.on(ev, function (d) { H.events.push([ev, d]); });\n    });\n    A.on('message', function (d, from) { H.events.push(['message', d, from]); });\n    A.on('time-up', function () {\n      H.events.push(['time-up']);\n      // Answer now: frames may be slow. The host finishes from the standings Rust last published.\n      if (A.isHost) {\n        var fin = H.last || { standings: [A.players.map(function (p) { return p.id; })], won: false };\n        try { A.finish(fin); } catch (e) { /* already finished */ }\n      }\n    });\n  });\n  addEventListener('keydown', function (e) { if (e.key === 'Enter') { try { A.answer('ready'); } catch (x) { /* not on the card */ } } }, true);\n  H.poll = function () { var a = H.events; H.events = []; return JSON.stringify(a); };\n  H.infoJson = function () { return H.info ? JSON.stringify({ me: H.info.me, players: H.info.players, host: H.info.host, isHost: !!A.isHost, server: !!A.server, seed: H.info.seed, mode: H.info.mode, limitMs: H.info.limitMs }) : ''; };\n  H.ready = function () { if (!H.readied) { H.readied = true; try { A.ready(); } catch (e) { /* ignore */ } } };\n  H.answer = function (what) { try { A.answer(what); } catch (e) { /* not on the card */ } };\n  H.time = function () { return A.time(); };\n  H.finish = function (json) { try { A.finish(JSON.parse(json)); } catch (e) { /* ignore */ } };\n  H.send = function (json, to) { try { A.send(JSON.parse(json), to === undefined || to < 0 ? { reliable: false } : { reliable: false, to: to }); } catch (e) { /* dropped */ } };\n  H.publish = function (json) { try { H.last = JSON.parse(json); } catch (e) { /* ignore */ } };\n  H.fail = function (msg) { try { A.fail(msg); } catch (e) { /* ignore */ } };\n})();\nE\npython3 - <<'E'\np='scripts/pack_single_html.py'\ns=open(p).read()\ns=s.replace('''    ap.add_argument(\"--out\", type=pathlib.Path, help=\"output file (default: target/web/<title>.html)\")''','''    ap.add_argument(\"--out\", type=pathlib.Path, help=\"output file (default: target/web/<title>.html)\")\n    ap.add_argument(\"--about\", type=pathlib.Path, help=\"JSON for the About screen (a script#about-data block)\")\n    ap.add_argument(\"--session-client\", type=pathlib.Path, default=ROOT / \"web\" / \"session.js\", help=\"the AI Hub session client, pasted unmodified\")\n    ap.add_argument(\"--shim\", type=pathlib.Path, default=ROOT / \"web\" / \"hub_shim.js\", help=\"the game's AI Hub shim\")\n    ap.add_argument(\"--tags\", type=pathlib.Path, default=ROOT / \"web\" / \"hub_tags.html\", help=\"the hub:session meta tags\")''')\ns=s.replace('''    wasm = wasm_path.read_bytes()\n    packed = gzip''','''    # AI Hub: the session client (byte for byte) first in <head>, the tags, then the shim.\n    for what, path in ((\"session client\", a.session_client), (\"shim\", a.shim)):\n        if path.is_file() and re.search(r\"(?i)</script|<script|<!--\", path.read_text(encoding=\"utf-8\")):\n            fail(f\"the {what} contains <script, </script or <!--, which can't sit inside an inline script\")\n    if a.session_client.is_file() and a.shim.is_file() and a.tags.is_file():\n        client, shim, tags = (p.read_text(encoding=\"utf-8\") for p in (a.session_client, a.shim, a.tags))\n        page, n = re.subn(\n            r'<meta charset=\"utf-8\">\\\\n',\n            lambda m: m.group(0) + \"<script>\\\\n\" + client + \"\\\\n</script>\\\\n\" + tags + \"<script>\\\\n\" + shim + \"\\\\n</script>\\\\n\",\n            page,\n            count=1,\n        )\n        if n != 1:\n            fail(\"expected one <meta charset> in index.html\")\n    if a.about is not None:\n        about = a.about.read_text(encoding=\"utf-8\")\n        json.loads(about)\n        page = replace_one(\n            page,\n            r\"</head>\",\n            lambda m: '<script type=\"application/json\" id=\"about-data\">' + about.replace(\"<\", \"\\\\\\\\u003c\") + \"</script>\\\\n</head>\",\n            \"</head>\",\n        )\n\n    wasm = wasm_path.read_bytes()\n    packed = gzip''',1)\nopen(p,'w').write(s)\np='scripts/build-web.sh'\ns=open(p).read()\ns=s.replace(\"--title | --description | --theme-color | --scene | --out)\",\"--title | --description | --theme-color | --scene | --out | --about)\")\ns=s.replace(\"[[ $1 == --out && $value != /* ]] && value=$caller/$value\",\"[[ ( $1 == --out || $1 == --about ) && $value != /* ]] && value=$caller/$value\")\nopen(p,'w').write(s)\np='web/index.html'\ns=open(p).read()\ns=s.replace(\"Loading Shardfall…\",\"Loading…\")\ns=s.replace(\"\"\"  if (!navigator.gpu) {\n    msg.replaceChildren(\"\"\",\"\"\"  if (!navigator.gpu) {\n    if (window.AIHub && window.AIHub.active) { try { window.AIHub.fail(`${name} needs WebGPU.`); } catch (e) { /* ignore */ } }\n    msg.replaceChildren(\"\"\",1)\nopen(p,'w').write(s)\nE\ncat > web/hub_tags.html <<'E'\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:webgpu\" content=\"required\">\n<meta name=\"hub:session-goal\" content=\"Keep the patient alive until the clock runs out.\">\n<meta name=\"hub:session-howto\" content=\"Aim: mouse or right stick. Operate: click or R2. Instruments: 1-8 or flick.\">\nE\ngrep -n \"hub:\" web/hub_tags.html | wc -l; grep -n \"dist\" Cargo.toml | head"}}}
