    Bus(u8, f32),\n    Track(music::Mus),\n    Overlay(music::Mus),\n    Bpm(f32),\n    Crisis(f32),\n    Hush(bool),\n    Beat,\n}\"\"\",1)\ns=s.replace(\"\"\"    pub sample_rate: u32,\n    pub device: String,\n}\"\"\",\"\"\"    pub sample_rate: u32,\n    pub device: String,\n    /// Peak per bus since last read (effects, music, voices).\n    pub peaks: std::sync::Arc<std::sync::Mutex<[f32; 3]>>,\n    pub gains: std::sync::Arc<std::sync::Mutex<[f32; 3]>>,\n}\"\"\",1)\ns=s.replace(\"\"\"        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\"\"\",\"\"\"        let (tx, rx) = channel::<Cmd>();\n        let peaks = std::sync::Arc::new(std::sync::Mutex::new([0.0f32; 3]));\n        let gains = std::sync::Arc::new(std::sync::Mutex::new([0.8f32, 0.10, 0.7]));\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels, peaks.clone(), gains.clone())?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels, peaks.clone(), gains.clone())?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels, peaks.clone(), gains.clone())?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, peaks, gains })\"\"\",1)\ns=s.replace(\"            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\",\"            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay, BUS_FX));\",1)\ns=s.replace(\"\"\"    pub fn set_master(&self, v: f32) {\n        let _ = self.tx.send(Cmd::Master(v));\n    }\"\"\",\"\"\"    pub fn set_master(&self, v: f32) {\n        let _ = self.tx.send(Cmd::Master(v));\n    }\n\n    /// Bus gain: 0 effects, 1 music (default 0.10), 2 voices.\n    pub fn set_bus(&self, bus: u8, v: f32) {\n        if let Ok(mut g) = self.gains.lock() {\n            g[bus.min(2) as usize] = v;\n        }\n        let _ = self.tx.send(Cmd::Bus(bus, v));\n    }\n\n    pub fn set_track(&self, t: music::Mus) {\n        let _ = self.tx.send(Cmd::Track(t));\n    }\n\n    pub fn set_overlay(&self, t: music::Mus) {\n        let _ = self.tx.send(Cmd::Overlay(t));\n    }\n\n    pub fn set_bpm(&self, b: f32) {\n        let _ = self.tx.send(Cmd::Bpm(b));\n    }\n\n    pub fn set_crisis(&self, c: f32) {\n        let _ = self.tx.send(Cmd::Crisis(c));\n    }\n\n    pub fn set_hush(&self, h: bool) {\n        let _ = self.tx.send(Cmd::Hush(h));\n    }\n\n    pub fn heartbeat(&self) {\n        let _ = self.tx.send(Cmd::Beat);\n    }\n\n    /// Animalese for a line of text, on the voice bus.\n    pub fn speak(&self, text: &str, who: &str) {\n        for (p, d) in voice::speak(text, who) {\n            let _ = self.tx.send(Cmd::Play(p, 0.0, 1.0, d, BUS_VOICE));\n        }\n    }\n\n    /// Peaks per bus since the last call.\n    pub fn take_peaks(&self) -> [f32; 3] {\n        self.peaks.lock().map(|mut p| std::mem::take(&mut *p)).unwrap_or([0.0; 3])\n    }\"\"\",1)\ns=s.replace(\"\"\"fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\"\"\",\"\"\"fn build<T>(\n    device: &cpal::Device,\n    config: cpal::StreamConfig,\n    rx: Receiver<Cmd>,\n    channels: usize,\n    peaks: std::sync::Arc<std::sync::Mutex<[f32; 3]>>,\n    _gains: std::sync::Arc<std::sync::Mutex<[f32; 3]>>,\n) -> anyhow::Result<cpal::Stream>\"\"\",1)\ns=s.replace(\"\"\"                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                }\n            }\"\"\",\"\"\"                    Cmd::Play(p, pan, gain, delay, bus) => mixer.play_bus(p, pan, gain, delay, bus),\n                    Cmd::Master(v) => mixer.master = v,\n                    Cmd::Bus(b, v) => mixer.bus_gain[b.min(2) as usize] = v,\n                    Cmd::Track(t) => mixer.music.set_track(t),\n                    Cmd::Overlay(t) => mixer.music.set_overlay(t),\n                    Cmd::Bpm(b) => mixer.music.bpm = b,\n                    Cmd::Crisis(c) => mixer.music.crisis = c,\n                    Cmd::Hush(h) => mixer.music.hush = h,\n                    Cmd::Beat => {\n                        let mut m = std::mem::take(&mut mixer.music);\n                        m.heartbeat(&mut mixer);\n                        mixer.music = m;\n                    }\n                }\n            }\"\"\",1)\ns=s.replace(\"\"\"            mixer.render(&mut buf);\n            for (i, frame) in data.chunks_mut\"\"\",\"\"\"            mixer.render(&mut buf);\n            if let Ok(mut pk) = peaks.lock() {\n                for (a, b) in pk.iter_mut().zip(mixer.take_peaks()) {\n                    *a = a.max(b);\n                }\n            }\n            for (i, frame) in data.chunks_mut\"\"\",1)\nopen(p,'w').write(s)\nE\ncd ../../.. && CARGO_BUILD_JOBS=3 cargo check -p pav_audio 2>&1 | grep -E \"^error\" -A10 | head -80","timeout":600000}}}
