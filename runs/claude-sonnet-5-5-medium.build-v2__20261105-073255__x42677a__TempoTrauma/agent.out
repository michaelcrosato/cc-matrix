ow.__game ? __game.status() : ''\")\n                        if s:\n                            st.append(json.loads(s))\n                    except Exception:\n                        pass\n                playing = [s for s in st if s[\"hub\"][\"phase\"] == \"Play\"]\n                if len(playing) >= 2:\n                    host = [s for s in playing if s[\"hub\"][\"host\"]]\n                    cli = [s for s in playing if not s[\"hub\"][\"host\"]]\n                    if host and cli and cli[0][\"hub\"][\"seen\"] > 0 and host[0][\"hub\"][\"remote_active\"][1 - host[0][\"hub\"][\"me\"] if host[0][\"hub\"][\"me\"] in (0, 1) else 1]:\n                        hv, cv = host[0][\"sim\"][\"vitals\"], cli[0][\"sim\"][\"vitals\"]\n                        ok = host[0][\"sim\"][\"case\"] == 8 and cli[0][\"sim\"][\"case\"] == 8 and abs(hv - cv) < 25\n                        why = f\"host vitals {hv}, client vitals {cv}, case {host[0]['sim']['case']}/{cli[0]['sim']['case']}\"\n                        break\n                time.sleep(1.0)\n            else:\n                why = \"never reached play with both copies talking\"\n            b.close()\n    finally:\n        proc.terminate()\n    return ok, why\nE\npython3 - <<'E'\np='../tests/browser/test_hub.py'\ns=open(p).read()\ns=s.replace('''            for q in (\n                \"players=4&latency=150''','''            for q in (\n                \"players=4&latency=150''',1)\ns=s.replace('''    finally:\n        proc.terminate()\n    failed = [(n, e) for n, e in RESULTS if e]''','''    finally:\n        proc.terminate()\n    ok, why = two_copies()\n    RESULTS.append((\"two copies: input crosses, vitals agree\", None if ok else why))\n    failed = [(n, e) for n, e in RESULTS if e]''',1)\nopen(p,'w').write(s)\nE\nuntil [ \"$(free -m | awk '/Mem:/{print $7}')\" -gt 3000 ]; do sleep 5; done; CARGO_BUILD_JOBS=3 scripts/build-web.sh --single-file --scene surgery/title --title \"Tempo Trauma\" --description \"A surgical-action drama: race a failing heart, with the pulse as the game's clock.\" --theme-color \"#0a1a1e\" --about ../about-data.json --out ../TempoTrauma-TraumaCenterSecondOpinion-claude-sonnet-5-5-medium-20261105-073255.html > ../webbuild.log 2>&1; tail -1 ../webbuild.log | cut -c1-80; cd ../tests/browser && timeout 3000 python3 test_hub.py 2>&1 | grep -E \"^FAIL|passed\" | cut -c1-600","uuid":"597fd2ff-9411-4e07-82d8-abb28c02a43e","session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c"}
