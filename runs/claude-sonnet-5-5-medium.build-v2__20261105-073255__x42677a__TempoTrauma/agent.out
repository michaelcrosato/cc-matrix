w = \"Sacs on the coronary arteries\"\nsay = [\"0.2|pet|Sacs. Laser the stems.\"]\nspawn = [\"sac -5 -2 9\", \"sac -2 2.5 9\", \"sac 1 -2.5 9\", \"sac 4 2 9\", \"sac 7 -1 9\"]\n\n[[case.phase]]\nname = \"C: Dies Irae\"\nnow = \"Embers and heat rings\"\nsay = [\"0.2|teddy|Heat! It is seven-eight now! I do not know what to do with seven-eight!\"]\nspawn = [\"ember -4 1\", \"ember 2 -2\", \"ember 6 2\"]\nrings = 7\nfever = true\ncheckpoint = true\n\n[[case.phase]]\nname = \"D: The heart stops\"\nnow = \"Three shocks, each on a ghost beat\"\nsay = [\"0.2|pet|It stopped on purpose.\", \"1.0|mara|Charge it.\"]\nshocks = 3\ncheckpoint = true\n\n[[case.phase]]\nname = \"E: The Soloist\"\nnow = \"SCALPEL strokes on the beat. Fire the DUET when the meter is full\"\nsay = [\"0.2|teddy|Something just stood up in there.\", \"2.0|pet|There you are.\"]\nspawn = [\"line -6 -1 -2 -1\", \"line -2 -1 2 -1\", \"line 2 -1 6 -1\"]\nrhythm = true\ncheckpoint = true\n\n[[case.phase]]\nname = \"The tendril\"\nnow = \"FORCEPS: pull only while the heart relaxes\"\nsay = [\"0.2|pet|Pull when it relaxes. Not before. Wait for it.\"]\nspawn = [\"tendril 0 0.3\"]\n\n[[case.phase]]\nname = \"Close\"\nnow = \"DRESS the closure\"\nsay = [\"0.4|teddy|Clean, Doctor? That is Bashir's line. I am just saying it for him.\"]\nspawn = [\"dress -5 3.4 5 3.4\"]\n\n[[case]]\nid = 8\nname = \"Code Blue\"\nsurgeon = \"team\"\nplate = \"torso\"\ntimer = 240\npar = 16000\npatient = \"A stranger from the harbour\"\ndx = \"Mass casualty, one patient, many hands\"\nfate = \"The stranger lives. The team has no idea who he is.\"\nring = [1, 2, 3, 4, 5, 6, 7, 8]\ndirector = true\n\n[[case.phase]]\nname = \"Code Blue\"\nnow = \"Keep the patient alive until the clock runs out\"\nsay = [\"0.4|bashir|Everyone to the table. Keep him alive.\"]\nspawn = [\"pool 0 0 1.0\", \"hook -4 1 30\", \"polyp 4 -1\"]\nE\necho done"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1790,"cache_read_input_tokens":99671,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1790},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c","uuid":"cfb6a626-cd60-441a-90d6-ce27835b02d3","timestamp":"2026-11-05T14:36:42.861Z","request_id":"req_011CgjwyL4ZwsjVqzEELyXy3","wire_tool_inputs":{"toolu_0137FNzUJ1RDSVdeQCphFTJJ":{"command":"cd content && cat > cases.toml <<'E'\n# Cases for Tempo Trauma. One [[case]] per operation; [[case.phase]] lists what is on the field.\n# spawn strings: \"<kind> x z [x2 z2 | r | angle | lvl] [flags]\". Kinds are documented in README.md.\n# Field: x in -9..9, z in -4..4.2 is playable. `say` lines: \"seconds|speaker|text\".\n\n[[case]]\nid = 0\nname = \"Barbs\"\nsurgeon = \"mara\"\nplate = \"forearm\"\ntimer = 240\npar = 5200\npatient = \"Anton Deverell\"\ndx = \"Fish hooks and cable splinters, left forearm\"\nfate = \"Anton Deverell will mend nets again by spring.\"\nguided = true\nring = [1, 2, 3, 4, 0, 6, 0, 0]\n\n[[case.phase]]\nname = \"Clear the blood\"\nnow = \"SUCTION the pool\"\nsay = [\"0.4|bashir|Your first one, Doctor. Take the suction. Hold it over the blood.\", \"3.0|bashir|Harder pressure, faster flow. Keep the field clear.\"]\nspawn = [\"pool -2 0 1.1\", \"pool 3 1 0.8\"]\n\n[[case.phase]]\nname = \"Remove the barbs\"\nnow = \"FORCEPS: pull each barb out along its length\"\nsay = [\"0.4|bashir|Forceps, Doctor. Grip the barb. Pull the way it points.\", \"4.0|bashir|Clean. Again.\"]\nspawn = [\"hook -4 -1 20\", \"hook 1 2.2 -30\", \"hook -2 0 80 covered\"]\ncheckpoint = true\n\n[[case.phase]]\nname = \"One more\"\nnow = \"FORCEPS: the barb under the blood\"\nsay = [\"0.2|mara|There is another one. Under the pool. I felt it.\", \"2.0|bashir|Then you have good hands. Suction first, Doctor.\"]\nspawn = [\"pool -2 0 1.0\", \"hook -2 0 -60 covered\"]\n\n[[case.phase]]\nname = \"Close the wounds\"\nnow = \"SUTURE: zigzag across the wound\"\nsay = [\"0.4|bashir|Suture. Cross the wound, side to side. Even stitches.\", \"8.0|bashir|Doctor, that's healthy tissue. Even spacing.\"]\nspawn = [\"lace -4 -1 0 1\", \"lace 1 2.5 5 2.5\"]\ncheckpoint = true\n\n[[case.phase]]\nname = \"Burns and dressing\"\nnow = \"GEL the inflammation, then DRESS the arm\"\nsay = [\"0.4|bashir|Gel on the inflamed tissue. Paint it until the ring fills.\", \"6.0|bashir|Last. The dressing, Doctor. Draw it along the closure.\"]\nspawn = [\"burn 2 -1 1.2\", \"dress -5 3.4 5 3.4\"]\n\n[[case]]\nid = 1\nname = \"Routine\"\nsurgeon = \"mara\"\nplate = \"abdomen\"\ntimer = 270\npar = 8500\npatient = \"Rosalind Pike\"\ndx = \"Acute appendicitis, harbour pilot, 44\"\nfate = \"Rosalind Pike will pilot the morning tide on Thursday.\"\nring = [1, 2, 3, 4, 5, 6, 0, 8]\n\n[[case.phase]]\nname = \"Open the abdomen\"\nnow = \"SCALPEL: one stroke along the dashed line\"\nsay = [\"0.4|bashir|Scalpel, Doctor. One stroke. Do not lift.\", \"6.0|voss|Adequate so far.\"]\nspawn = [\"line -5 0 5 0.4\"]\nplate_next = \"bowel\"\n\n[[case.phase]]\nname = \"Polyps\"\nnow = \"LASER: hold until the ring is nearly full, release\"\nsay = [\"0.4|bashir|Laser. Hold until the ring fills nearly to the top. Release.\", \"5.0|teddy|Vitals are steady. I am also steady. Nobody ask me anything.\"]\nspawn = [\"polyp -5 -1\", \"polyp -2 2\", \"polyp 1 -2\", \"polyp 4 1.5\", \"polyp 6 -2\"]\ncheckpoint = true\n\n[[case.phase]]\nname = \"The artery\"\nnow = \"SUTURE the bleeders. IV PUSH if vitals fall\"\nsay = [\"0.2|teddy|Pressure's dropping. That is an artery. That is a real artery.\", \"0.8|bashir|Vitals falling. IV Push, up-left. Release in the green.\", \"6.0|bashir|Stitch the bleeder, Doctor. Three quick crossings.\"]\nspawn = [\"bleeder -1 0.5\", \"pool -1 0.5 1.4\", \"lace -5 -1.5 -1 -2.5\"]\ndrop_vitals = 40\n\n[[case.phase]]\nname = \"Close\"\nnow = \"DRESS the closure\"\nsay = [\"0.4|voss|Adequate.\", \"1.5|bashir|Close, Doctor.\"]\nspawn = [\"dress -5 0.2 5 0.2\"]\n\n[[case]]\nid = 2\nname = \"Shrapnel Night\"\nsurgeon = \"mara\"\nplate = \"chest\"\ntimer = 300\npar = 11000\npatient = \"Gunnar Holt\"\ndx = \"Blast shrapnel in the chest wall and lung, grain-terminal foreman, 52\"\nfate = \"Gunnar Holt will complain about the grain prices for years.\"\nring = [1, 2, 3, 4, 5, 6, 7, 8]\n\n[[case.phase]]\nname = \"Open the chest\"\nnow = \"SCALPEL along the dashed line\"\nsay = [\"0.4|teddy|Doctor, this man is sixty percent grain dust.\", \"1.0|bashir|Scalpel, Doctor. Quickly.\"]\nspawn = [\"line -5 0 5 -0.2\"]\nplate_next = \"lung\"\n\n[[case.phase]]\nname = \"Find the shrapnel\"\nnow = \"SCANNER: sweep to reveal hidden shards\"\nsay = [\"0.4|bashir|You cannot see them. The Scanner, left. Sweep slowly.\", \"5.0|bashir|Now Forceps. Pull the way they point.\"]\nspawn = [\"hook -5 -2 40 hidden\", \"hook 0 2.5 -70 hidden\", \"hook 4 -1 10 hidden\", \"hook -3 1.5 110 hidden\", \"pool 4 -1 1.0\"]\ncheckpoint = true\n\n[[case.phase]]\nname = \"The heart stops\"\nnow = \"DEFIBRILLATE: hold both triggers, release on the ghost beat\"\nsay = [\"0.2|mara|Now.\", \"1.0|teddy|Asystole! He's flat! Bashir, he is FLAT!\"]\nshocks = 1\nscripted = true\n\n[[case.phase]]\nname = \"Finish\"\nnow = \"SUTURE and DRESS\"\nsay = [\"0.4|bashir|You called it before the monitor did, Doctor. I noticed.\", \"6.0|bashir|Suture.\"]\nspawn = [\"lace -4 0 4 0.6\", \"dress -5 3.4 5 3.4\"]\n\n[[case]]\nid = 3\nname = \"Something Moved\"\nsurgeon = \"mara\"\nplate = \"liver\"\ntimer = 360\npar = 14500\npatient = \"Piet Marlow\"\ndx = \"'Benign' liver mass, courier, 37\"\nfate = \"Piet Marlow is asleep in recovery. He will not remember the waltz.\"\nring = [1, 2, 3, 4, 5, 6, 7, 8]\nstrain = \"introit\"\n\n[[case.phase]]\nname = \"The mass\"\nnow = \"SCALPEL ring, FORCEPS out, GEL the bed\