{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjxBttrfMXEHswwD5DTL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EMciVz54YFm9u1om6wK9L9","name":"Bash","input":{"command":"cat > mod.rs <<'E'\n//! Tempo Trauma: a surgical-action drama. The whole game is a deterministic simulation here\n//! (cases, story, strains, gifts, the bot); `pav_view`, `pav_ui` and `pav_audio` draw and\n//! play what `frame()` publishes.\n\nuse std::collections::BTreeMap;\n\nuse anyhow::Result;\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse super::{Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, SurgeonInput, SurgeryCmd, sbtn};\nuse crate::rng::Rng;\nuse crate::sim::Sim;\n\npub mod bot;\npub mod data;\npub mod frame;\npub mod tune;\n\nuse data::*;\npub use frame::SurgeryFrame;\nuse tune::Tune;\n\npub const KEY: &str = \"surgery\";\npub const TITLE: &str = \"Tempo Trauma\";\npub const FIELD_X: f32 = 9.0;\npub const FIELD_Z0: f32 = -4.0;\npub const FIELD_Z1: f32 = 4.2;\npub const IV_PORT: Vec2 = Vec2::new(7.6, 3.4);\n\n/// Sound cue ids (`SimEvent::Cue`).\npub mod cue {\n    pub const PICK: u8 = 1;\n    pub const SLICE: u8 = 2;\n    pub const SQUISH: u8 = 3;\n    pub const FORCEPS: u8 = 4;\n    pub const POP: u8 = 5;\n    pub const ZIP: u8 = 6;\n    pub const GURGLE: u8 = 7;\n    pub const LASER: u8 = 8;\n    pub const SIZZLE: u8 = 9;\n    pub const GEL: u8 = 10;\n    pub const IV: u8 = 11;\n    pub const PING: u8 = 12;\n    pub const DEFIB_WHINE: u8 = 13;\n    pub const DEFIB_THUMP: u8 = 14;\n    pub const LUBDUB: u8 = 15;\n    pub const BEEP: u8 = 16;\n    pub const ALARM: u8 = 17;\n    pub const STING_SLOPPY: u8 = 18;\n    pub const STING_GOOD: u8 = 19;\n    pub const STING_CLEAN: u8 = 20;\n    pub const STING_IMM: u8 = 21;\n    pub const CHAIN: u8 = 22;\n    pub const ONBEAT: u8 = 23;\n    pub const STRAIN: u8 = 24;\n    pub const BURST: u8 = 25;\n    pub const UI_NAV: u8 = 26;\n    pub const UI_OK: u8 = 27;\n    pub const UI_BACK: u8 = 28;\n    pub const BANNER: u8 = 29;\n    pub const FLATLINE: u8 = 30;\n    pub const WRONG: u8 = 31;\n    pub const GIFT: u8 = 32;\n    pub const HUSH_END: u8 = 33;\n    pub const RIPPLE: u8 = 34;\n    pub const FROST: u8 = 35;\n    pub const RING: u8 = 36;\n    pub const STAMP: u8 = 37;\n    pub const NAMES: [&str; 38] = [\n        \"\", \"pick\", \"slice\", \"squish\", \"forceps\", \"pop\", \"zip\", \"gurgle\", \"laser\", \"sizzle\", \"gel\", \"iv\", \"ping\", \"defib_whine\",\n        \"defib_thump\", \"lubdub\", \"beep\", \"alarm\", \"sting_sloppy\", \"sting_good\", \"sting_clean\", \"sting_imm\", \"chain\", \"onbeat\",\n        \"strain\", \"burst\", \"ui_nav\", \"ui_ok\", \"ui_back\", \"banner\", \"flatline\", \"wrong\", \"gift\", \"hush_end\", \"ripple\", \"frost\",\n        \"ring\", \"stamp\",\n    ];\n}\n\n/// The campaign: a story scene (`S`) or a case (`C`).\n#[derive(Clone, Copy, Debug)]\npub enum Step {\n    S(&'static str),\n    C(u8),\n}\npub const STEPS: &[Step] = &[\n    Step::S(\"s0\"),\n    Step::C(0),\n    Step::S(\"s0b\"),\n    Step::S(\"s1\"),\n    Step::C(1),\n    Step::S(\"s1b\"),\n    Step::S(\"s2\"),\n    Step::C(2),\n    Step::S(\"s2b\"),\n    Step::S(\"s3\"),\n    Step::C(3),\n    Step::S(\"s3b\"),\n    Step::S(\"s4\"),\n    Step::C(4),\n    Step::S(\"s4b\"),\n    Step::S(\"s5\"),\n    Step::C(5),\n    Step::S(\"s5b\"),\n    Step::S(\"s6\"),\n    Step::C(6),\n    Step::S(\"s6b\"),\n    Step::S(\"s7\"),\n    Step::C(7),\n    Step::S(\"s7b\"),\n    Step::S(\"epilogue\"),\n];\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum Mode {\n    Idle,\n    Story,\n    Card,\n    Op,\n    Results,\n    Dead,\n    Won,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Surgeon {\n    pub active: bool,\n    pub bot: bool,\n    pub pos: Vec2,\n    pub prev: Vec2,\n    pub tool: u8,\n    pub held: bool,\n    pub held_prev: bool,\n    pub score: i64,\n    pub chain: u32,\n    pub best_chain: u32,\n    pub chain_t: f32,\n    pub gift: f32,\n    pub gift_hold: f32,\n    pub gift_on: bool,\n    pub target: Option<u32>,\n    pub gp: Vec2,\n    pub heat: f32,\n    pub dose: f32,\n    pub iv_cd: f32,\n    pub flow: f32,\n    pub over: f32,\n    pub charge: f32,\n    pub wrong_cd: f32,\n    pub cut_cd: f32,\n    pub recoil: f32,\n    pub last_kind: u8,\n    pub last_rating: u8,\n    pub rot: f32,\n    pub unlocked_gift: bool,\n    pub moved: f32,\n    pub ghost: Option<Vec2>,\n    pub seat: u8,\n    pub actions: u32,\n    pub imm: u32,\n}\n\nimpl Surgeon {\n    fn new(seat: u8) -> Self {\n        Self {\n            active: seat == 0,\n            bot: false,\n            pos: Vec2::new(0.0, 0.5),\n            prev: Vec2::new(0.0, 0.5),\n            tool: 2,\n            held: false,\n            held_prev: false,\n            score: 0,\n            chain: 0,\n            best_chain: 0,\n            chain_t: 0.0,\n            gift: 0.0,\n            gift_hold: 0.0,\n            gift_on: false,\n            target: None,\n            gp: Vec2::ZERO,\n            heat: 0.0,\n            dose: 0.0,\n            iv_cd: 0.0,\n            flow: 1.0,\n            over: 0.0,\n            charge: 0.0,\n            wrong_cd: 0.0,\n            cut_cd: 0.0,\n            recoil: 0.0,\n            last_kind: 0,\n            last_rating: 0,\n            rot: 0.0,\n            unlocked_gift: false,\n            moved: 0.0,\n            ghost: None,\n            seat,\n            actions: 0,\n            imm: 0,\n        }\n    }\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Pop {\n    pub pos: Vec2,\n    pub rating: u8,\n    pub t: f32,\n    pub on_beat: bool,\n    pub chain: u32,\n    pub seat: u8,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Fx {\n    pub id: u32,\n    pub kind: u8,\n    pub pos: Vec2,\n    pub v: f32,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Sub {\n    pub who: String,\n    pub text: String,\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize, Default)]\npub struct Results {\n    pub case: u8,\n    pub score: i64,\n    pub vitals_bonus: i64,\n    pub time_bonus: i64,\n    pub mistakes: i64,\n    pub total: i64,\n    pub par: i64,\n    pub rank: String,\n    pub fate: String,\n    pub patient: String,\n    pub name: String,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\nstruct Checkpoint {\n    phase: i32,\n    vitals: f32,\n    time_left: f32,\n}\n\npub const RATING_NAMES: [&str; 4] = [\"SLOPPY\", \"GOOD\", \"CLEAN\", \"IMMACULATE\"];\nconst POINTS: [i64; 4] = [10, 120, 250, 400];\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct Surgery {\n    pub mode: Mode,\n    pub scene: String,\n    pub step: u16,\n    pub difficulty: u8,\n    pub case: u8,\n    pub attract: bool,\n    pub paused: bool,\n    rng: Rng,\n    // story\n    pub story: String,\n    pub line: u16,\n    pub typed: f32,\n    pub card_t: f32,\n    // operation\n    pub t: f32,\n    pub time_left: f32,\n    pub phase: i32,\n    pub phase_t: f32,\n    pub clear_t: f32,\n    pub plate: String,\n    pub plate_prev: String,\n    pub plate_t: f32,\n    pub vitals: f32,\n    pub beat: f32,\n    pub beats: u32,\n    pub beat_now: bool,\n    pub bpm: f32,\n    pub sbeat: f32,\n    pub sbeat_now: bool,\n    pub sbeats: u32,\n    pub hz: Vec<Hz>,\n    next_id: u32,\n    pending: Vec<String>,\n    pub sg: Vec<Surgeon>,\n    pub pops: Vec<Pop>,\n    pub fx: Vec<Fx>,\n    fx_id: u32,\n    pub sub: Option<Sub>,\n    says: Vec<(f32, String, String)>,\n    pub now_line: String,\n    pub banner: String,\n    pub banner_t: f32,\n    pub tune: Tune,\n    pub fever: f32,\n    pub rings: u32,\n    pub ring_r: f32,\n    pub ring_warn: bool,\n    pub ring_on: bool,\n    pub hush: f32,\n    pub echo: f32,\n    echo_cd: f32,\n    pub woke: bool,\n    pub code_t: f32,\n    pub code_scripted: bool,\n    pub codes_left: i32,\n    pub shocks_left: u32,\n    pub ghost_phase: f32,\n    pub mistakes: i64,\n    pub dir_t: f32,\n    pub flat: f32,\n    pub shake: f32,\n    pub flash: f32,\n    pub results: Option<Results>,\n    cp: Option<Checkpoint>,\n    pub death_time: f32,\n    pub cheat_immortal: bool,\n    pub cheat_freeze: bool,\n    pub tremor_on: bool,\n    pub time_scale: f32,\n    pub assist_user: f32,\n    pub cov: BTreeMap<String, u32>,\n    pub total_score: i64,\n    pub seg: u8,\n    pub seg_t: f32,\n    pub guided_hint: bool,\n    pub duet: f32,\n    pub xbox: bool,\n    pub opt_surgeons: u8,\n    pub last_cmd_tick: u32,\n    pub tick: u32,\n}\n\nfn lerp(a: f32, b: f32, t: f32) -> f32 {\n    a + (b - a) * t\n}\n\nfn rank_of(total: i64, par: i64) -> &'static str {\n    let r = total as f32 / par.max(1) as f32;\n    if r >= 1.15 {\n        \"ENCORE\"\n    } else if r >= 1.0 {\n        \"S\"\n    } else if r >= 0.85 {\n        \"A\"\n    } else if r >= 0.7 {\n        \"B\"\n    } else {\n        \"C\"\n    }\n}\n\n/// Builds the scene. `rest`: \"title\", \"attract\", \"campaign[/step]\", \"case/<n>[/<phase>]\", \"codeblue\", \"mirror\", \"card\".\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    crate::scenes::build_standalone_room(sim, KEY, crate::room::RoomDef::parse(ROOM)?);\n    if let Some(p) = sim.state.player {\n        sim.despawn(p);\n        sim.state.player = None;\n    }\n    sim.state.focus = Vec3::ZERO;\n    let seed = sim.state.rng.next_u32() as u64 | ((sim.state.rng.next_u32() as u64) << 32);\n    let mut g = Surgery::new(seed);\n    let rest = rest.unwrap_or(\"title\");\n    let mut parts = rest.split('/');\n    let head = parts.next().unwrap_or(\"title\");\n    let arg = parts.next();\n    let arg2 = parts.next();\n    g.scene = head.to_string();\n    match head {\n        \"campaign\" => {\n            let step: u16 = arg.and_then(|a| a.parse().ok()).unwrap_or(0);\n            g.enter_step(step);\n        }\n        \"case\" => {\n            let n: u8 = arg.and_then(|a| a.parse().ok()).unwrap_or(0);\n            let ph: i32 = arg2.and_then(|a| a.parse().ok()).unwrap_or(0);\n            g.begin_case(n, ph);\n        }\n        \"codeblue\" => {\n            g.sg[0].active = true;\n            g.begin_case(8, 0);\n        }\n        \"attract\" => {\n            g.attract = true;\n            g.start_attract_seg(0);\n        }\n        _ => {}\n    }\n    sim.state.play = Some(GameBox::new(g));\n    Ok(())\n}\n\nconst ROOM: &str = r#\"\nname = \"Operating theatre\"\nabout = \"Tempo Trauma's stage: the field itself is drawn by the surgery view.\"\nentrance = { at = [2, 3], facing = \"south\" }\n[camera]\ntilt = 73.0\ndistance = 19.9\n[layout]\norigin = [90.0, 0.0, -8.0]\n[[layout.layer]]\ny = 0\nmap = '''\n####\n#..#\n#..#\n####\n'''\n[layout.legend]\n\"#\" = { block = { height = 3.0, color = \"#2a3a3a\" } }\n\"#;\n\nimpl Surgery {\n    pub fn new(seed: u64) -> Self {\n        let mut sg: Vec<Surgeon> = (0..4).map(|i| Surgeon::new(i)).collect();\n        sg[0].active = true;\n        Self {\n            mode: Mode::Idle,\n            scene: String::new(),\n            step: 0,\n            difficulty: 1,\n            case: 0,\n            attract: false,\n            paused: false,\n            rng: Rng::new(seed),\n            story: String::new(),\n            line: 0,\n            typed: 0.0,\n            card_t: 0.0,\n            t: 0.0,\n            time_left: 0.0,\n            phase: -1,\n            phase_t: 0.0,\n            clear_t: 0.0,\n            plate: \"forearm\".into(),\n            plate_prev: \"forearm\".into(),\n            plate_t: 1.0,\n            vitals: 100.0,\n            beat: 0.0,\n            beats: 0,\n            beat_now: false,\n            bpm: 72.0,\n            sbeat: 0.0,\n            sbeat_now: false,\n            sbeats: 0,\n            hz: vec![],\n            next_id: 1,\n            pending: vec![],\n            sg,\n            pops: vec![],\n            fx: vec![],\n            fx_id: 0,\n            sub: None,\n            says: vec![],\n            now_line: String::new(),\n            banner: String::new(),\n            banner_t: 0.0,\n            tune: Tune::default(),\n            fever: 0.0,\n            rings: 0,\n            ring_r: -1.0,\n            ring_warn: false,\n            ring_on: false,\n            hush: 0.0,\n            echo: 0.0,\n            echo_cd: 0.0,\n            woke: false,\n            code_t: 0.0,\n            code_scripted: false,\n            codes_left: 1,\n            shocks_left: 0,\n            ghost_phase: 0.0,\n            mistakes: 0,\n            dir_t: 0.0,\n            flat: 0.0,\n            shake: 0.0,\n            flash: 0.0,\n            results: None,\n            cp: None,\n            death_time: 0.0,\n            cheat_immortal: false,\n            cheat_freeze: false,\n            tremor_on: true,\n            time_scale: 1.0,\n            assist_user: 1.0,\n            cov: BTreeMap::new(),\n            total_score: 0,\n            seg: 0,\n            seg_t: 0.0,\n            guided_hint: false,\n            duet: 0.0,\n            xbox: false,\n            opt_surgeons: 1,\n            last_cmd_tick: 0,\n            tick: 0,\n        }\n    }\n\n    // ---------- bookkeeping helpers ----------\n\n    pub fn cov(&mut self, key: &str) {\n        *self.cov.entry(key.to_string()).or_insert(0) += 1;\n    }\n\n    fn content(&self) -> std::sync::Arc<Content> {\n        data::load()\n    }\n\n    pub fn case_def(&self) -> Case {\n        let c = self.content();\n        c.cases.iter().find(|c| c.id == self.case).cloned().unwrap_or_default()\n    }\n\n    fn push_fx(&mut self, kind: u8, pos: Vec2, v: f32) {\n        self.fx_id += 1;\n        let id = self.fx_id;\n        self.fx.push(Fx { id, kind, pos, v });\n        if self.fx.len() > 40 {\n            self.fx.remove(0);\n        }\n    }\n\n    fn cue(&mut self, ev: &mut Vec<SimEvent>, id: u8, pos: Vec2, gain: f32, pitch: f32) {\n        ev.push(SimEvent::Cue { id, pos: Vec3::new(pos.x, 0.0, pos.y), gain, pitch });\n    }\n\n    fn say(&mut self, who: &str, text: &str) {\n        self.sub = Some(Sub { who: who.to_string(), text: text.to_string(), t: 4.2 });\n    }\n\n    fn callout(&mut self, text: &str) {\n        if self.case_def().silent && self.case != 8 {\n            return;\n        }\n        let who = if self.case >= 7 { \"teddy\" } else { \"bashir\" };\n        self.say(who, text);\n    }\n\n    fn diff_drain(&self) -> f32 {\n        [0.7, 1.0, 1.4][self.difficulty.min(2) as usize]\n    }\n\n    fn strain_mul(&self) -> f32 {\n        [0.85, 1.0, 1.2][self.difficulty.min(2) as usize] * self.tune.get(\"strain_speed\")\n    }\n\n    pub fn surgeon_count(&self) -> usize {\n        self.sg.iter().filter(|s| s.active).count()\n    }\n\n    /// The instrument kind a surgeon's slot holds in this case.\n    pub fn kind_of(&self, tool: u8) -> u8 {\n        match tool {\n            5 if self.case == 6 => CRYO,\n            7 if self.case == 7 => CRYO,\n            1..=8 => tool,\n            _ => 0,\n        }\n    }\n\n    pub fn ring_unlocked(&self, slot: u8) -> bool {\n        let c = self.case_def();\n        c.ring.get(slot as usize - 1).map(|v| *v != 0).unwrap_or(true)\n    }\n\n    /// Beats per phase when a strain stepping speed is requested.\n    pub fn on_beat(&self) -> bool {\n        let p = self.beat.min(1.0 - self.beat);\n        p * 60.0 / self.bpm.max(30.0) <= self.tune.get(\"beat_ms\") / 1000.0\n    }\n\n    fn world_scale(&self) -> f32 {\n        if self.hush > 0.0 { self.tune.get(\"hush_scale\") } else { 1.0 }\n    }\n\n    // ---------- campaign / flow ----------\n\n    pub fn enter_step(&mut self, i: u16) {\n        self.step = i;\n        match STEPS.get(i as usize) {\n            Some(Step::S(id)) => {\n                self.mode = Mode::Story;\n                self.story = id.to_string();\n                self.line = 0;\n                self.typed = 0.0;\n                self.card_t = 0.0;\n            }\n            Some(Step::C(n)) => {\n                self.case = *n;\n                self.setup_case(*n);\n                self.mode = Mode::Card;\n                self.card_t = 0.0;\n            }\n            None => {\n                self.mode = Mode::Won;\n            }\n        }\n    }\n\n    fn setup_case(&mut self, n: u8) {\n        self.case = n;\n        let c = self.case_def();\n        self.hz.clear();\n        self.pending.clear();\n        self.pops.clear();\n        self.says.clear();\n        self.sub = None;\n        self.t = 0.0;\n        self.time_left = c.timer * [1.25, 1.0, 0.8][self.difficulty.min(2) as usize] * self.tune.get(\"timer\");\n        self.vitals = 100.0;\n        self.phase = -1;\n        self.phase_t = 0.0;\n        self.clear_t = 0.0;\n        self.plate = c.plate.clone();\n        self.plate_prev = c.plate.clone();\n        self.plate_t = 1.0;\n        self.fever = 0.0;\n        self.rings = 0;\n        self.ring_r = -1.0;\n        self.hush = 0.0;\n        self.echo = 0.0;\n        self.code_t = 0.0;\n        self.shocks_left = 0;\n        self.mistakes = 0;\n        self.woke = false;\n        self.cp = None;\n        self.flat = 0.0;\n        self.dir_t = 6.0;\n        self.codes_left = [2, 1, 0][self.difficulty.min(2) as usize];\n        self.results = None;\n        let team = n == 8;\n        for (i, s) in self.sg.iter_mut().enumerate() {\n            let keep_active = s.active;\n            let bot = s.bot;\n            let seat = s.seat;\n            *s = Surgeon::new(seat);\n            s.bot = bot;\n            s.active = if i == 0 { true } else { keep_active };\n            s.tool = if n == 0 { 4 } else { 2 };\n            s.unlocked_gift = false;\n        }\n        if n == 7 {\n            // Mara + Pet: the partner is a bot on slot 1 unless a human took it.\n            if !self.sg[1].active {\n                self.sg[1].active = true;\n                self.sg[1].bot = true;\n            }\n        } else if !team && !self.attract {\n            for i in 1..4 {\n                if self.sg[i].bot && !self.attract && n != 7 {\n                    self.sg[i].active = false;\n                    self.sg[i].bot = false;\n                }\n            }\n        }\n        // Gifts exist from Case 3 (Hush), 5 (Echo), 7 (both), Code Blue (both).\n        let gift = matches!(n, 3 | 4 | 5 | 6 | 7 | 8);\n        for s in self.sg.iter_mut() {\n            s.unlocked_gift = gift;\n        }\n        self.guided_hint = c.guided;\n    }\n\n    /// Start the operation itself on a phase (banner, spawns).\n    pub fn begin_case(&mut self, n: u8, phase: i32) {\n        self.setup_case(n);\n        self.mode = Mode::Op;\n        self.banner = \"OPERATION START\".into();\n        self.banner_t = 1.6;\n        self.start_phase(phase.max(0));\n    }\n\n    fn start_phase(&mut self, i: i32) {\n        let c = self.case_def();\n        let Some(ph) = c.phase.get(i as usize).cloned() else {\n            self.finish_case();\n            return;\n        };\n        self.phase = i;\n        self.phase_t = 0.0;\n        self.clear_t = 0.0;\n        self.hz.clear();\n        self.pending.clear();\n        self.says.clear();\n        self.now_line = ph.now.clone();\n        for s in &ph.say {\n            let mut it = s.splitn(3, '|');\n            let t: f32 = it.next().and_then(|v| v.parse().ok()).unwrap_or(0.5);\n            let who = it.next().unwrap_or(\"bashir\").to_string();\n            let text = it.next().unwrap_or(\"\").to_string();\n            self.says.push((t, who, text));\n        }\n        self.rings = ph.rings;\n        self.ring_r = -1.0;\n        if ph.rings == 0 {\n            self.ring_on = false;\n        }\n        if !ph.fever {\n            self.fever = 0.0;\n        }\n        if let Some(v) = ph.drop_vitals {\n            self.vitals = self.vitals.min(v + 25.0);\n        }\n        let tough = self.tune.get(\"strain_tough\");\n        if ph.rhythm {\n            self.pending = ph.spawn.clone();\n        } else {\n            for s in &ph.spawn {\n                match make(self.next_id, s, tough) {\n                    Ok(mut h) => {\n                        h.born = self.sbeats as f32;\n                        h.window = if h.k == Kind::Eye { 4.0 } else { h.window };\n                        self.next_id += 1;\n                        self.hz.push(h);\n                    }\n                    Err(e) => panic!(\"case {} phase {}: {e}\", c.id, ph.name),\n                }\n            }\n        }\n        if ph.hush_wake || ph.echo_wake {\n            self.wake_gift();\n        }\n        if ph.shocks > 0 {\n            self.shocks_left = ph.shocks;\n            self.dir_t = 1.2;\n        }\n        if ph.checkpoint {\n            self.cp = Some(Checkpoint { phase: i, vitals: self.vitals, time_left: self.time_left });\n        }\n        self.cov(&format!(\"phase:{}:{}\", self.case, i));\n    }\n\n    fn wake_gift(&mut self) {\n        if !self.woke {\n            self.woke = true;\n            for s in self.sg.iter_mut().filter(|s| s.active) {\n                s.gift = 100.0;\n                s.unlocked_gift = true;\n            }\n            if self.case == 3 {\n                self.say(\"bashir\", \"Doctor... your hands.\");\n            } else if self.case == 5 {\n                self.say(\"pet\", \"Doctor Nwosu... there were two of you.\");\n            }\n        }\n    }\n\n    fn finish_case(&mut self) {\n        let c = self.case_def();\n        let sc: i64 = self.sg.iter().map(|s| s.score).sum();\n        let vb = (self.vitals.max(0.0) * 20.0) as i64;\n        let tb = (self.time_left.max(0.0) * 5.0) as i64;\n        let mis = self.mistakes * -100;\n        let total = ((sc + vb + tb + mis) as f32).max(0.0) as i64;\n        self.results = Some(Results {\n            case: c.id,\n            score: sc,\n            vitals_bonus: vb,\n            time_bonus: tb,\n            mistakes: mis,\n            total,\n            par: c.par,\n            rank: rank_of(total, c.par).to_string(),\n            fate: c.fate.clone(),\n            patient: c.patient.clone(),\n            name: c.name.clone(),\n        });\n        self.total_score += total;\n        self.mode = Mode::Results;\n        self.card_t = 0.0;\n        self.banner = \"OPERATION COMPLETE\".into();\n        self.banner_t = 2.0;\n        self.hush = 0.0;\n        self.echo = 0.0;\n        self.cov(&format!(\"case_done:{}\", c.id));\n    }\n\n    fn die(&mut self, ev: &mut Vec<SimEvent>) {\n        self.mode = Mode::Dead;\n        self.death_time = self.t;\n        self.card_t = 0.0;\n        self.hush = 0.0;\n        self.echo = 0.0;\n        self.cue(ev, cue::FLATLINE, Vec2::ZERO, 1.0, 1.0);\n        self.cov(\"deaths\");\n    }\n\n    fn retry(&mut self) {\n        let (ph, v, tl) = match &self.cp {\n            Some(cp) => (cp.phase, cp.vitals.max(60.0), cp.time_left.max(60.0)),\n            None => (0, 100.0, self.case_def().timer),\n        };\n        let score_keep: Vec<i64> = self.sg.iter().map(|s| s.score).collect();\n        let case = self.case;\n        let cp = self.cp.clone();\n        self.begin_case(case, ph);\n        self.vitals = v;\n        self.time_left = tl;\n        self.cp = cp;\n        for (s, sc) in self.sg.iter_mut().zip(score_keep) {\n            s.score = sc;\n        }\n        self.banner = \"OPERATION START\".into();\n        self.cov(\"retries\");\n    }\n\n    // ---------- the operation ----------\n\n    fn spawn_hz(&mut self, spec: &str) -> Option<usize> {\n        let tough = self.tune.get(\"strain_tough\");\n        match make(self.next_id, spec, tough) {\n            Ok(mut h) => {\n                self.next_id += 1;\n                h.born = self.sbeats as f32;\n                self.hz.push(h);\n                Some(self.hz.len() - 1)\n            }\n            Err(_) => None,\n        }\n    }\n\n    fn rand_pos(&mut self) -> Vec2 {\n        Vec2::new(self.rng.range(-6.5, 6.5), self.rng.range(-3.2, 3.6))\n    }\n\n    fn hz_index(&self, id: u32) -> Option<usize> {\n        self.hz.iter().position(|h| h.id == id)\n    }\n\n    fn visible(&self, h: &Hz) -> bool {\n        (!h.hidden || h.reveal > 0.0) && !h.covered\n    }\n\n    /// Nearest hazard the instrument `kind` can work on within `reach` of `c`.\n    fn find(&self, c: Vec2, kind: u8, reach: f32) -> Option<usize> {\n        let mut best: Option<(usize, f32)> = None;\n        for (i, h) in self.hz.iter().enumerate() {\n            if h.need() != kind || !self.visible(h) {\n                continue;\n            }\n            if h.k == Kind::Eye && h.aux > 0.5 {\n                continue;\n            }\n            let d = if matches!(h.k, Kind::Line | Kind::Dress | Kind::Lace) { h.dist(c) } else { (c - h.p).length() - h.r };\n            if d <= reach && best.map(|b| d < b.1).unwrap_or(true) {\n                best = Some((i, d));\n            }\n        }\n        best.map(|b| b.0)\n    }\n\n    /// Stroke endpoints for a scalpel target.\n    pub fn stroke(h: &Hz) -> (Vec2, Vec2) {\n        if h.is_line() {\n            (h.p, h.q)\n        } else {\n            let a = Vec2::from_angle(h.cnt as f32 * 1.05 + 0.2 + if h.k == Kind::Eye { 0.0 } else { 0.6 });\n            (h.p - a * h.r * 1.05, h.p + a * h.r * 1.05)\n        }\n    }\n\n    fn award(&mut self, s: usize, pos: Vec2, err: f32, ev: &mut Vec<SimEvent>) -> u8 {\n        let e = err * self.tune.get(\"strict\");\n        let r: u8 = if e <= 1.0 {\n            3\n        } else if e <= 2.0 {\n            2\n        } else if e <= 3.2 {\n            1\n        } else {\n            0\n        };\n        let on_beat = self.on_beat();\n        let mut pts = POINTS[r as usize] as f32;\n        let sg = &mut self.sg[s];\n        if r >= 2 {\n            sg.chain += 1;\n            sg.chain_t = 0.0;\n            sg.best_chain = sg.best_chain.max(sg.chain);\n        } else if r == 0 {\n            sg.chain = 0;\n        }\n        let mult = if sg.chain >= 20 {\n            2.0\n        } else if sg.chain >= 10 {\n            1.5\n        } else if sg.chain >= 5 {\n            1.25\n        } else {\n            1.0\n        };\n        pts *= mult;\n        if on_beat {\n            pts *= 1.25;\n        }\n        pts *= self.tune.get(\"score\");\n        sg.score += pts as i64;\n        sg.last_rating = r;\n        sg.actions += 1;\n        if r == 3 {\n            sg.imm += 1;\n        }\n        sg.recoil = 1.0;\n        let gain = match r {\n            3 => 8.0,\n            2 => 4.0,\n            _ => 0.0,\n        } + if on_beat { 2.0 } else { 0.0 };\n        let chain = sg.chain;\n        if sg.unlocked_gift && self.hush <= 0.0 && self.echo <= 0.0 {\n            sg.gift = (sg.gift + gain * self.tune.get(\"gift_gain\")).min(100.0);\n        }\n        let seat = sg.seat;\n        self.pops.push(Pop { pos, rating: r, t: 0.0, on_beat, chain, seat });\n        self.cov(&format!(\"rating:{}\", r));\n        if on_beat {\n            self.cov(\"onbeat\");\n            if self.hush > 0.0 {\n                self.hush += 1.0;\n            }\n        }\n        let id = [cue::STING_SLOPPY, cue::STING_GOOD, cue::STING_CLEAN, cue::STING_IMM][r as usize];\n        self.cue(ev, id, pos, 0.8, 1.0);\n        if on_beat {\n            self.cue(ev, cue::ONBEAT, pos, 0.5, 1.0);\n        }\n        if chain > 0 && chain % 5 == 0 {\n            self.cue(ev, cue::CHAIN, pos, 0.7, 1.0 + chain as f32 * 0.01);\n        }\n        if r == 2 && self.rng.below(4) == 0 {\n            self.callout(\"Clean. Again.\");\n        }\n        r\n    }\n\n    /// One count of the hazard's current stage is done. Returns true if the hazard is gone.\n    fn step_hz(&mut self, hi: usize, s: usize, err: f32, ev: &mut Vec<SimEvent>) -> bool {\n        let pos = self.hz[hi].p;\n        let kind = self.hz[hi].need();\n        let r = if err >= 0.0 { self.award(s, pos, err, ev) } else { 1 };\n        if err >= 0.0 {\n            self.sg[s].last_kind = kind;\n            if self.echo > 0.0 && s == 0 && self.echo_cd <= 0.0 {\n                self.echo_repeat(kind, r, hi, ev);\n            }\n        }\n        self.cov(&format!(\"tool_done:{}\", kind));\n        let h = &mut self.hz[hi];\n        h.cnt += 1;\n        h.prog = 0.0;\n        h.dev = 0.0;\n        h.dev_n = 0.0;\n        h.over = 0.0;\n        h.grabbed = None;\n        if h.cnt >= h.count() {\n            h.si += 1;\n            h.cnt = 0;\n            h.born = self.sbeats as f32;\n            h.stitches.clear();\n            h.last_side = 0;\n            h.last_cross = -9.0;\n            if h.k == Kind::Tumor && h.si == 2 {\n                h.hidden = false;\n            }\n        } else if h.k == Kind::Ember && h.si == 2 {\n            h.ang = h.cnt as f32 * 2.1;\n            h.q = Vec2::from_angle(h.ang);\n        }\n        if h.need() == 0 {\n            let dead = self.hz.remove(hi);\n            self.on_removed(dead, s, ev);\n            true\n        } else {\n            false\n        }\n    }\n\n    fn on_removed(&mut self, h: Hz, s: usize, ev: &mut Vec<SimEvent>) {\n        self.cov(&format!(\"hazard_done:{:?}\", h.k));\n        match h.k {\n            Kind::Nodule => {\n                if h.lvl == 0 && self.case == 3 {\n                    for dx in [-1.2f32, 1.2] {\n                        if let Some(i) = self.spawn_hz(&format!(\"nodule {} {} 1 seen\", (h.p.x + dx).clamp(-7.0, 7.0), h.p.y)) {\n                            self.hz[i].hidden = true;\n                        }\n                    }\n                    self.cov(\"strain:split\");\n                    if !self.woke {\n                        self.wake_gift();\n                    }\n                }\n                self.cue(ev, cue::POP, h.p, 0.9, 1.0);\n                self.push_fx(3, h.p, 1.0);\n            }\n            Kind::Ember => {\n                self.fever = (self.fever - 22.0).max(0.0);\n                self.cue(ev, cue::POP, h.p, 0.9, 0.8);\n                self.push_fx(4, h.p, 1.0);\n            }\n            Kind::Sac => {\n                self.push_fx(5, h.p, 0.5);\n            }\n            Kind::Tumor => {\n                self.push_fx(3, h.p, 1.0);\n            }\n            Kind::Pool | Kind::Burn => {}\n            _ => {}\n        }\n        let _ = s;\n    }\n\n    fn echo_repeat(&mut self, kind: u8, rating: u8, from: usize, ev: &mut Vec<SimEvent>) {\n        // The ghost hands repeat the technique at once on the next valid target for that tool.\n        let src = self.hz.get(from).map(|h| h.p).unwrap_or(Vec2::ZERO);\n        let mut best: Option<(usize, f32)> = None;\n        for (i, h) in self.hz.iter().enumerate() {\n            if h.need() != kind || !self.visible(h) || i == from {\n                continue;\n            }\n            if matches!(h.k, Kind::Nodule | Kind::Eye) {\n                continue;\n            }\n            let d = (h.p - src).length();\n            if best.map(|b| d < b.1).unwrap_or(true) {\n                best = Some((i, d));\n            }\n        }\n        if let Some((i, _)) = best {\n            self.echo_cd = 0.4;\n            let pos = self.hz[i].p;\n            self.sg[3].ghost = Some(pos);\n            self.cov(\"echo_repeat\");\n            let err = [4.0f32, 2.5, 1.5, 0.5][rating as usize];\n            self.cue(ev, cue::GIFT, pos, 0.4, 1.6);\n            self.step_hz_echo(i, err, ev);\n        }\n    }\n\n    fn step_hz_echo(&mut self, hi: usize, err: f32, ev: &mut Vec<SimEvent>) {\n        // Rated for the owner (slot 0) without re-triggering another echo.\n        let saved = self.echo;\n        self.echo = 0.0;\n        self.step_hz(hi, 0, err, ev);\n        self.echo = saved;\n    }\n\n    fn spawn_pop_hz(&mut self, spec: String) {\n        let _ = self.spawn_hz(&spec);\n    }\n\n    fn vitals_hit(&mut self, v: f32) {\n        if self.cheat_immortal || self.attract {\n            return;\n        }\n        self.vitals = (self.vitals - v).clamp(0.0, 100.0);\n    }\n\n    // ---------- the tick ----------\n\n    fn handle_cmd(&mut self, cmd: SurgeryCmd, ev: &mut Vec<SimEvent>) {\n        match cmd {\n            SurgeryCmd::NewGame { step, difficulty } => {\n                self.difficulty = difficulty.min(2);\n                self.total_score = 0;\n                self.attract = false;\n                self.scene = \"campaign\".into();\n                for s in self.sg.iter_mut() {\n                    s.score = 0;\n                }\n                self.enter_step(step);\n            }\n            SurgeryCmd::Retry => {\n                if self.mode == Mode::Dead {\n                    self.retry();\n                }\n            }\n            SurgeryCmd::Restart => {\n                if self.case_def().id == self.case && matches!(self.mode, Mode::Op | Mode::Dead) {\n                    self.cp = None;\n                    let c = self.case;\n                    self.begin_case(c, 0);\n                }\n            }\n            SurgeryCmd::JumpCase(n) => {\n                self.attract = false;\n                self.begin_case(n, 0);\n            }\n            SurgeryCmd::SkipPhase => {\n                if self.mode == Mode::Op {\n                    let p = self.phase + 1;\n                    self.start_phase(p);\n                }\n            }\n            SurgeryCmd::WinCase => {\n                if self.mode == Mode::Op {\n                    self.finish_case();\n                }\n            }\n            SurgeryCmd::ForceCode => {\n                if self.mode == Mode::Op {\n                    self.vitals = 0.0;\n                }\n            }\n            SurgeryCmd::KillPatient => {\n                if self.mode == Mode::Op {\n                    self.codes_left = 0;\n                    self.vitals = 0.0;\n                    self.code_t = 0.001;\n                }\n            }\n            SurgeryCmd::NextStep => {\n                if self.mode == Mode::Results {\n                    let n = self.step + 1;\n                    if self.scene == \"campaign\" {\n                        self.enter_step(n);\n                    } else {\n                        self.mode = Mode::Won;\n                    }\n                }\n            }\n            SurgeryCmd::Spawn(k) => {\n                if let Some((name, _)) = KINDS.get(k as usize) {\n                    let c = self.sg[0].pos;\n                    let spec = match *name {\n                        \"line\" | \"lace\" | \"dress\" => format!(\"{name} {} {} {} {}\", c.x - 2.0, c.y, c.x + 2.0, c.y),\n                        \"pool\" | \"burn\" | \"tumor\" => format!(\"{name} {} {} 1.0\", c.x, c.y),\n                        _ => format!(\"{name} {} {} 0\", c.x, c.y),\n                    };\n                    self.spawn_pop_hz(spec);\n                }\n            }\n            SurgeryCmd::SetSurgeons(n) => {\n                for (i, s) in self.sg.iter_mut().enumerate() {\n                    s.active = i < n as usize;\n                }\n            }\n            SurgeryCmd::Pause(p) => self.paused = p,\n        }\n        let _ = ev;\n    }\n\n    fn do_pre(&mut self, input: &InputFrame, dt0: f32, ev: &mut Vec<SimEvent>) {\n        self.tick = self.tick.wrapping_add(1);\n        if let Some(c) = input.scmd {\n            self.handle_cmd(c, ev);\n        }\n        if self.paused {\n            return;\n        }\n        let dt = dt0 * self.time_scale;\n        self.fx.retain(|f| self.fx_id.saturating_sub(f.id) < 30);\n        if let Some(s) = &mut self.sub {\n            s.t -= dt;\n            if s.t <= 0.0 {\n                self.sub = None;\n            }\n        }\n        if self.banner_t > 0.0 {\n            self.banner_t -= dt;\n        }\n        self.shake = (self.shake - dt * 3.0).max(0.0);\n        self.flash = (self.flash - dt * 2.0).max(0.0);\n        self.plate_t = (self.plate_t + dt / 0.8).min(1.0);\n        match self.mode {\n            Mode::Idle | Mode::Won => {}\n            Mode::Story => self.tick_story(input, dt),\n            Mode::Card => {\n                self.card_t += dt;\n                let adv = self.any_press(input, sbtn::ADVANCE | sbtn::USE);\n                let bot = self.attract || self.sg[0].bot || self.scene == \"mirror\";\n                if (adv && self.card_t > 0.4) || (bot && self.card_t > 1.0) {\n                    let c = self.case;\n                    let step = self.step;\n                    let cp = self.cp.clone();\n                    let _ = cp;\n                    self.begin_case(c, 0);\n                    self.step = step;\n                }\n            }\n            Mode::Results => {\n                self.card_t += dt;\n                let adv = self.any_press(input, sbtn::ADVANCE);\n                if (adv && self.card_t > 3.0) || ((self.attract || self.sg[0].bot) && self.card_t > 4.0) {\n                    self.handle_cmd(SurgeryCmd::NextStep, ev);\n                }\n            }\n            Mode::Dead => {\n                self.card_t += dt;\n                let adv = self.any_press(input, sbtn::ADVANCE | sbtn::USE);\n                if adv && self.card_t > 0.8 {\n                    self.retry();\n                }\n            }\n            Mode::Op => self.tick_op(input, dt, ev),\n        }\n    }\n\n    fn any_press(&self, input: &InputFrame, bit: u16) -> bool {\n        input.surgeons.iter().any(|s| s.pressed & bit != 0)\n    }\n\n    fn tick_story(&mut self, input: &InputFrame, dt: f32) {\n        let content = self.content();\n        let Some(sc) = content.scenes.iter().find(|s| s.id == self.story) else {\n            self.enter_step(self.step + 1);\n            return;\n        };\n        let Some(line) = sc.line.get(self.line as usize) else {\n            self.enter_step(self.step + 1);\n            return;\n        };\n        let len = line.text.chars().count() as f32;\n        let speed = 48.0;\n        let skip = input.surgeons.iter().any(|s| s.held & sbtn::SKIP != 0);\n        self.typed = (self.typed + dt * speed * if skip { 8.0 } else { 1.0 }).min(len);\n        self.card_t += dt;\n        let adv = self.any_press(input, sbtn::ADVANCE | sbtn::USE);\n        let auto = (self.attract || self.sg[0].bot) && self.typed >= len && self.card_t > 0.5 + len * 0.012;\n        if adv {\n            if self.typed < len {\n                self.typed = len;\n            } else {\n                self.next_line(sc.line.len());\n            }\n        } else if auto || (skip && self.typed >= len) {\n            self.next_line(sc.line.len());\n        }\n    }\n\n    fn next_line(&mut self, n: usize) {\n        self.line += 1;\n        self.typed = 0.0;\n        self.card_t = 0.0;\n        if self.line as usize >= n {\n            if self.attract && self.scene == \"attract\" {\n                self.start_attract_seg(self.seg + 1);\n            } else {\n                let s = self.step + 1;\n                self.enter_step(s);\n            }\n        }\n    }\n\n    pub fn story_line(&self) -> Option<(Scene, Line)> {\n        let c = self.content();\n        let sc = c.scenes.iter().find(|s| s.id == self.story)?;\n        let l = sc.line.get(self.line as usize)?;\n        Some((sc.clone(), l.clone()))\n    }\n\n    // Attract mode: ~25 s segments cycling through the demo.\n    pub fn start_attract_seg(&mut self, i: u8) {\n        let segs: [(u8, i32); 7] = [(3, 1), (4, 0), (5, 1), (7, 4), (8, 0), (0, 3), (6, 0)];\n        let n = (i as usize) % (segs.len() + 1);\n        self.seg = n as u8;\n        self.seg_t = 0.0;\n        self.attract = true;\n        for s in self.sg.iter_mut() {\n            s.bot = true;\n        }\n        if n == segs.len() {\n            self.mode = Mode::Story;\n            self.story = \"s3b\".into();\n            self.line = 0;\n            self.typed = 0.0;\n            self.card_t = 0.0;\n            return;\n        }\n        let (c, p) = segs[n];\n        self.case = c;\n        self.begin_case(c, p);\n        let count = if c == 8 { 4 } else if c == 7 { 2 } else { 1 };\n        for (k, s) in self.sg.iter_mut().enumerate() {\n            s.active = k < count;\n            s.bot = true;\n            s.unlocked_gift = true;\n            s.gift = 100.0;\n        }\n        self.vitals = 100.0;\n        self.banner_t = 0.0;\n    }\n\n    fn tick_op(&mut self, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        let ws = self.world_scale();\n        let dtw = dt * ws;\n        self.t += dt;\n        self.phase_t += dtw;\n        self.echo_cd = (self.echo_cd - dt).max(0.0);\n        if self.attract {\n            self.seg_t += dt;\n            self.vitals = self.vitals.max(40.0);\n            if self.seg_t > 26.0 {\n                let n = self.seg + 1;\n                self.start_attract_seg(n);\n                return;\n            }\n        }\n        // Subtitles from the phase script.\n        let mut fire = vec![];\n        for s in self.says.iter_mut() {\n            s.0 -= dt;\n            if s.0 <= 0.0 && s.0 > -100.0 {\n                fire.push((s.1.clone(), s.2.clone()));\n                s.0 = -1000.0;\n            }\n        }\n        for (w, t) in fire {\n            self.say(&w, &t);\n        }\n        // Heart.\n        let base = lerp(72.0, 148.0, 1.0 - self.vitals / 100.0);\n        let coup = self.tune.get(\"coupling\");\n        self.bpm = 72.0 + (base - 72.0) * coup;\n        if self.code_t > 0.0 {\n            self.bpm = 0.0;\n        } else {\n            self.beat += self.bpm / 60.0 * dtw;\n        }\n        self.beat_now = false;\n        if self.beat >= 1.0 {\n            self.beat -= 1.0;\n            self.beats += 1;\n            self.beat_now = true;\n            self.cue(ev, cue::LUBDUB, Vec2::ZERO, 0.5, 1.0 + (self.bpm - 72.0) * 0.002);\n            if self.hush > 0.0 {\n                self.hush -= 1.0;\n                if self.hush <= 0.0 {\n                    self.hush = 0.0;\n                    self.cue(ev, cue::HUSH_END, Vec2::ZERO, 0.7, 1.0);\n                }\n            }\n        }\n        let sbpm = self.bpm.min(72.0 * 1.4);\n        self.sbeat += sbpm / 60.0 * dtw * self.strain_mul();\n        self.sbeat_now = false;\n        if self.sbeat >= 1.0 {\n            self.sbeat -= 1.0;\n            self.sbeats += 1;\n            self.sbeat_now = true;\n        }\n        if self.echo > 0.0 {\n            self.echo -= dt;\n            if self.echo <= 0.0 {\n                self.echo = 0.0;\n                self.sg[3].ghost = None;\n            }\n        }\n        for s in self.sg.iter_mut() {\n            s.chain_t += dt;\n            if s.chain > 0 && s.chain_t > self.tune.get(\"chain_window\") {\n                s.chain = 0;\n            }\n            s.recoil = (s.recoil - dt * 3.0).max(0.0);\n            s.iv_cd = (s.iv_cd - dt).max(0.0);\n            s.wrong_cd = (s.wrong_cd - dt).max(0.0);\n            s.cut_cd = (s.cut_cd - dt).max(0.0);\n        }\n        self.pops.retain_mut(|p| {\n            p.t += dt;\n            p.t < 1.3\n        });\n        // Code (cardiac arrest).\n        if self.code_t > 0.0 {\n            self.tick_code(input, dt, ev);\n            return;\n        }\n        // Surgeons.\n        let ins = self.gather_inputs(input);\n        for s in 0..4 {\n            if self.sg[s].active {\n                self.tick_surgeon(s, &ins[s], dt, ev);\n            }\n        }\n        // Gifts need real time too.\n        for s in 0..4 {\n            if self.sg[s].active {\n                self.tick_gift(s, &ins[s], dt, ev);\n            }\n        }\n        // Hazards.\n        self.tick_hazards(dtw, ev);\n        // Vitals.\n        let mut drain = 0.0;\n        for h in &self.hz {\n            if !h.hidden || h.reveal > 0.0 || h.k == Kind::Pool {\n                drain += h.drain();\n            } else {\n                drain += h.drain() * 0.5;\n            }\n        }\n        if self.fever > 100.0 {\n            drain += 6.0 / self.diff_drain().max(0.1);\n        }\n        if self.case == 0 {\n            drain *= 0.7;\n        }\n        if self.mode == Mode::Op {\n            let d = drain * self.tune.get(\"drain\") * self.diff_drain() * dtw;\n            self.vitals_hit(d);\n        }\n        if self.attract {\n            self.vitals = self.vitals.max(40.0);\n        }\n        if !self.cheat_freeze && !self.attract {\n            self.time_left -= dtw;\n        }\n        // Low vitals warning.\n        if self.vitals < 30.0 && self.beat_now {\n            self.cue(ev, cue::BEEP, Vec2::ZERO, 0.4, 1.4);\n        }\n        // Code?\n        if self.vitals <= 0.0 && self.code_t <= 0.0 && self.mode == Mode::Op {\n            if self.codes_left > 0 || self.case == 8 {\n                self.codes_left -= 1;\n                self.start_code(false, ev);\n            } else {\n                self.die(ev);\n                return;\n            }\n        }\n        if self.time_left <= 0.0 && self.mode == Mode::Op {\n            if self.case_def().director {\n                self.finish_case();\n            } else {\n                self.die(ev);\n                return;\n            }\n        }\n        // Director (Code Blue).\n        if self.case_def().director {\n            self.tick_director(dtw);\n        }\n        // Phase done?\n        if self.mode == Mode::Op {\n            self.check_phase(dtw);\n        }\n    }\n\n    fn start_code(&mut self, scripted: bool, ev: &mut Vec<SimEvent>) {\n        self.code_t = if scripted { 15.0 } else { self.tune.get(\"code_window\") };\n        self.code_scripted = scripted;\n        self.ghost_phase = 0.0;\n        self.banner = \"CODE\".into();\n        self.banner_t = 1.5;\n        self.hush = 0.0;\n        self.echo = 0.0;\n        for s in self.sg.iter_mut() {\n            s.charge = 0.0;\n        }\n        self.cue(ev, cue::FLATLINE, Vec2::ZERO, 0.6, 1.0);\n        self.cov(if scripted { \"code:scripted\" } else { \"code\" });\n        if !scripted {\n            self.callout(\"Vitals at zero. Defibrillate. Now!\");\n        }\n    }\n\n    fn tick_code(&mut self, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        self.flat += dt;\n        self.code_t -= dt;\n        self.ghost_phase = (self.ghost_phase + dt) % 1.0;\n        let ins = self.gather_inputs(input);\n        let mut shocked = false;\n        for s in 0..4 {\n            if !self.sg[s].active {\n                continue;\n            }\n            let held = ins[s].held & sbtn::DEFIB != 0;\n            let sg = &mut self.sg[s];\n            if held {\n                sg.charge += dt;\n                if sg.charge < 0.05 + dt {\n                    // charge whine starts\n                }\n            } else if sg.charge > 0.0 {\n                let ok = sg.charge >= 1.2 && (self.ghost_phase - 0.5).abs() <= 0.14 || (self.ghost_phase - 0.5).abs() <= 0.14 && sg.charge >= 1.1;\n                sg.charge = 0.0;\n                if ok {\n                    shocked = true;\n                    sg.score += 300;\n                    self.pops.push(Pop { pos: Vec2::ZERO, rating: 3, t: 0.0, on_beat: true, chain: 0, seat: s as u8 });\n                } else {\n                    self.cue(ev, cue::WRONG, Vec2::ZERO, 0.6, 0.6);\n                }\n            }\n            if held && self.sg[s].charge > 0.0 && self.sg[s].charge < dt * 1.5 {\n                self.cue(ev, cue::DEFIB_WHINE, Vec2::ZERO, 0.6, 1.0);\n            }\n        }\n        if shocked {\n            self.cue(ev, cue::DEFIB_THUMP, Vec2::ZERO, 1.0, 1.0);\n            self.push_fx(6, Vec2::ZERO, 1.0);\n            self.shake = 1.0;\n            self.flash = 1.0;\n            self.vitals = if self.code_scripted && self.shocks_left > 1 { 8.0 } else { 30.0 };\n            self.code_t = 0.0;\n            self.flat = 0.0;\n            self.cov(\"defib_success\");\n            if self.shocks_left > 0 {\n                self.shocks_left -= 1;\n                if self.shocks_left > 0 {\n                    self.dir_t = 3.0;\n                }\n            }\n        } else if self.code_t <= 0.0 {\n            self.code_t = 0.0;\n            self.vitals = 0.0;\n            self.die(ev);\n        }\n    }\n\n    fn tick_director(&mut self, dtw: f32) {\n        let n = self.surgeon_count().max(1) as f32;\n        let tempo = 1.0 + (self.t / 30.0).floor() * 0.18;\n        self.dir_t -= dtw * tempo;\n        if self.dir_t <= 0.0 {\n            self.dir_t = 7.0;\n            let budget = ((0.6 + 0.4 * n) * 3.0).round() as i32;\n            let late = self.t > 190.0;\n            for _ in 0..budget.min(6) {\n                if self.hz.len() >= 14 {\n                    break;\n                }\n                let p = self.rand_pos();\n                let roll = self.rng.below(100);\n                let spec = if late && roll < 30 {\n                    format!(\"nodule {} {} 2 seen\", p.x, p.y)\n                } else if roll < 22 {\n                    format!(\"pool {} {} 0.9\", p.x, p.y)\n                } else if roll < 40 {\n                    format!(\"hook {} {} {}\", p.x, p.y, self.rng.range(0.0, 360.0))\n                } else if roll < 58 {\n                    format!(\"polyp {} {}\", p.x, p.y)\n                } else if roll < 72 {\n                    format!(\"lace {} {} {} {}\", p.x - 1.5, p.y, p.x + 1.5, p.y + 0.5)\n                } else if roll < 84 {\n                    format!(\"bleeder {} {}\", p.x, p.y)\n                } else if roll < 93 {\n                    format!(\"burn {} {} 1.0\", p.x, p.y)\n                } else {\n                    format!(\"sac {} {} 11\", p.x, p.y)\n                };\n                let id = self.next_id;\n                if let Some(i) = self.spawn_hz(&spec) {\n                    if self.hz[i].k == Kind::Nodule {\n                        self.hz[i].hidden = false;\n                    }\n                }\n                let _ = id;\n            }\n        }\n    }\n\n    fn check_phase(&mut self, dtw: f32) {\n        let c = self.case_def();\n        if c.director {\n            return;\n        }\n        let Some(ph) = c.phase.get(self.phase as usize) else { return };\n        // rhythm: feed pending strokes on the beat\n        if ph.rhythm && !self.pending.is_empty() && self.sbeat_now && self.sbeats % 2 == 0 && self.hz.len() < 2 {\n            let spec = self.pending.remove(0);\n            self.spawn_pop_hz(spec);\n        }\n        if ph.shocks > 0 {\n            if self.shocks_left > 0 {\n                if self.code_t <= 0.0 {\n                    self.dir_t -= dtw;\n                    if self.dir_t <= 0.0 {\n                        self.vitals = 0.0;\n                        self.start_code(true, &mut vec![]);\n                    }\n                }\n                return;\n            }\n        }\n        let clear = self.hz.is_empty() && self.pending.is_empty();\n        if clear && self.phase_t > 0.5 {\n            self.clear_t += dtw;\n            if self.clear_t > 0.9 {\n                if let Some(pn) = &ph.plate_next {\n                    self.plate_prev = self.plate.clone();\n                    self.plate = pn.clone();\n                    self.plate_t = 0.0;\n                }\n                let n = self.phase + 1;\n                self.start_phase(n);\n            }\n        } else {\n            self.clear_t = 0.0;\n        }\n    }\n\n    fn gather_inputs(&mut self, input: &InputFrame) -> [SurgeonInput; 4] {\n        let mut out = input.surgeons;\n        for s in 0..4 {\n            if self.attract || self.sg[s].bot {\n                if self.sg[s].active {\n                    out[s] = bot::bot_slot(self, s);\n                }\n            } else if out[s].active && !self.sg[s].active && self.mode == Mode::Op {\n                self.sg[s].active = true;\n            }\n        }\n        out\n    }\n\n    fn tick_surgeon(&mut self, s: usize, inp: &SurgeonInput, dt: f32, ev: &mut Vec<SimEvent>) {\n        // Cursor.\n        let aim = Vec2::new(inp.aim.x.clamp(-FIELD_X, FIELD_X), inp.aim.y.clamp(-4.6, 4.8));\n        let mut pos = aim;\n        let tremor = self.case_def().surgeon == \"pet\" || (self.case == 7 && s == 1);\n        if tremor && self.tremor_on && self.echo <= 0.0 && inp.held & sbtn::PRECISION == 0 && !self.sg[s].bot {\n            let t = self.t;\n            pos += Vec2::new((t * 1.7).sin() + 0.5 * (t * 4.1).sin(), (t * 2.3).cos() + 0.5 * (t * 3.3).cos()) * 0.07;\n        }\n        self.sg[s].prev = self.sg[s].pos;\n        // Aim assist (pad / keyboard cursor only).\n        let assist = self.tune.get(\"assist\") * self.assist_user;\n        let moved_vec = pos - self.sg[s].prev;\n        if inp.assist && assist > 0.0 && moved_vec.length() > 0.002 {\n            let kind = self.effective_kind(s);\n            if let Some(i) = self.find(pos, kind, 1.2) {\n                let tgt = self.hz[i].p;\n                let tgt = if self.hz[i].is_line() {\n                    // nearest point on the line\n                    let (a, b) = (self.hz[i].p, self.hz[i].q);\n                    let ab = b - a;\n                    let t = ((pos - a).dot(ab) / ab.length_squared().max(1e-4)).clamp(0.0, 1.0);\n                    a + ab * t\n                } else {\n                    tgt\n                };\n                let pull = (tgt - pos).clamp_length_max(3.0 * dt * assist);\n                pos += pull;\n            }\n        }\n        self.sg[s].moved = (pos - self.sg[s].prev).length();\n        self.sg[s].pos = pos;\n        // Instrument selection.\n        if inp.tool >= 1 && inp.tool <= 8 && inp.tool != self.sg[s].tool && self.ring_unlocked(inp.tool) {\n            self.sg[s].tool = inp.tool;\n            self.sg[s].target = None;\n            self.sg[s].heat = 0.0;\n            self.sg[s].dose = 0.0;\n            self.sg[s].charge = 0.0;\n            self.release_grab(s);\n            let p = self.sg[s].pos;\n            self.cue(ev, cue::PICK, p, 0.6, 0.8 + inp.tool as f32 * 0.07);\n            self.cov(&format!(\"pick:{}\", self.kind_of(inp.tool)));\n        }\n        let held = inp.held & sbtn::USE != 0 || inp.pressure > 0.25;\n        let pressed = held && !self.sg[s].held;\n        self.sg[s].held_prev = self.sg[s].held;\n        self.sg[s].held = held;\n        if inp.pressed & sbtn::CANCEL != 0 {\n            self.release_grab(s);\n            self.sg[s].target = None;\n        }\n        let kind = self.effective_kind(s);\n        let pressure = if inp.pressure > 0.0 { inp.pressure.clamp(0.2, 1.0) } else { 1.0 };\n        match kind {\n            SCALPEL => self.do_scalpel(s, held, dt, ev),\n            FORCEPS => self.do_forceps(s, held, pressed, inp, dt, ev),\n            SUTURE => self.do_suture(s, held, dt, ev),\n            SUCTION => self.do_suction(s, held, pressure, dt, ev),\n            LASER | CRYO => self.do_laser(s, kind, held, dt, ev),\n            GEL => self.do_gel(s, held, dt, ev),\n            SCAN => self.do_scan(s, held, dt, ev),\n            IV => self.do_iv(s, held, dt, ev),\n            DRESS => self.do_dress(s, held, dt, ev),\n            _ => {}\n        }\n        if pressed {\n            self.wrong_tool_check(s, kind, ev);\n        }\n    }\n\n    fn effective_kind(&self, s: usize) -> u8 {\n        let k = self.kind_of(self.sg[s].tool);\n        // Dressing is a context tool: auto-selected once only the closure is left.\n        let only_dress = !self.hz.is_empty() && self.hz.iter().all(|h| h.k == Kind::Dress);\n        if only_dress { DRESS } else { k }\n    }\n\n    fn release_grab(&mut self, s: usize) {\n        for h in self.hz.iter_mut() {\n            if h.grabbed == Some(s as u8) {\n                h.grabbed = None;\n            }\n        }\n    }\n\n    fn wrong_tool_check(&mut self, s: usize, kind: u8, ev: &mut Vec<SimEvent>) {\n        if matches!(kind, SCAN | IV) {\n            return;\n        }\n        let c = self.sg[s].pos;\n        let mut near = false;\n        for h in &self.hz {\n            if self.visible(h) && h.need() != kind && h.dist(c) < 0.25 && !(kind == SUCTION && h.k == Kind::Pool) {\n                near = true;\n            }\n        }\n        if near && self.sg[s].wrong_cd <= 0.0 && self.find(c, kind, 0.4).is_none() {\n            self.sg[s].wrong_cd = 2.0;\n            self.sg[s].chain = 0;\n            self.cue(ev, cue::WRONG, c, 0.6, 1.0);\n            self.callout(\"Wrong instrument, Doctor.\");\n            let pen = self.tune.get(\"wrong_pen\");\n            self.vitals_hit(pen);\n            self.cov(\"wrong_tool\");\n        }\n    }\n\n    fn do_scalpel(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        let c = self.sg[s].pos;\n        if !held {\n            self.sg[s].target = None;\n            return;\n        }\n        // Engaged target?\n        let tgt = self.sg[s].target.and_then(|id| self.hz_index(id));\n        let hi = match tgt {\n            Some(i) => i,\n            None => {\n                // Must start near the stroke's beginning.\n                let mut found = None;\n                for (i, h) in self.hz.iter().enumerate() {\n                    if h.need() != SCALPEL || !self.visible(h) || (h.k == Kind::Eye && h.aux > 0.5) {\n                        continue;\n                    }\n                    let (a, _) = Self::stroke(h);\n                    let startd = (c - a).length();\n                    if startd < 0.9 + h.prog * 6.0 {\n                        found = Some(i);\n                        break;\n                    }\n                }\n                match found {\n                    Some(i) => {\n                        let id = self.hz[i].id;\n                        self.sg[s].target = Some(id);\n                        i\n                    }\n                    None => {\n                        // Healthy tissue.\n                        if self.sg[s].cut_cd <= 0.0 && self.sg[s].moved > 0.02 && self.find(c, SCALPEL, 1.0).is_none() {\n                            self.sg[s].cut_cd = 1.6;\n                            self.sg[s].chain = 0;\n                            self.mistakes += 1;\n                            self.vitals_hit(1.5);\n                            self.cue(ev, cue::SLICE, c, 0.5, 0.7);\n                            self.push_fx(2, c, 0.5);\n                            let spec = format!(\"lace {} {} {} {}\", c.x, c.y, c.x + 0.6, c.y + 0.1);\n                            self.spawn_pop_hz(spec);\n                            self.callout(\"Doctor, that's healthy tissue.\");\n                            self.cov(\"healthy_cut\");\n                        }\n                        return;\n                    }\n                }\n            }\n        };\n        let (a, b) = Self::stroke(&self.hz[hi]);\n        let ab = b - a;\n        let l = ab.length().max(0.01);\n        let dir = ab / l;\n        let t = ((c - a).dot(dir) / l).clamp(0.0, 1.0);\n        let dev = (c - (a + dir * (t * l))).length();\n        if dev > 1.3 {\n            // Slipped off the line: lift.\n            self.sg[s].target = None;\n            return;\n        }\n        let power = self.tune.get(\"power\");\n        // Rail assist is done in aim assist; here: progress only moves forward.\n        let h = &mut self.hz[hi];\n        if t > h.prog && t - h.prog < 0.35 * power.max(1.0) {\n            h.prog = t;\n            h.dev += dev;\n            h.dev_n += 1.0;\n            let _ = dt;\n        }\n        let prog = h.prog;\n        self.sg[s].recoil = self.sg[s].recoil.max(0.15);\n        if (self.tick % 6) == 0 {\n            self.push_fx(1, c, 0.3);\n            self.cue(ev, cue::SLICE, c, 0.25, 1.0 + prog * 0.3);\n        }\n        if prog >= 0.97 {\n            let avg = if self.hz[hi].dev_n > 0.0 { self.hz[hi].dev / self.hz[hi].dev_n } else { 0.5 };\n            self.sg[s].target = None;\n            self.cov(\"rated:scalpel\");\n            self.step_hz(hi, s, avg / 0.25, ev);\n        }\n    }\n\n    fn do_forceps(&mut self, s: usize, held: bool, pressed: bool, inp: &SurgeonInput, dt: f32, ev: &mut Vec<SimEvent>) {\n        let c = self.sg[s].pos;\n        // Rotate a held bone.\n        let rot = (if inp.held & sbtn::ROT_R != 0 { 1.0 } else { 0.0 }) - (if inp.held & sbtn::ROT_L != 0 { 1.0 } else { 0.0 });\n        let grabbed = self.hz.iter().position(|h| h.grabbed == Some(s as u8));\n        if !held {\n            if let Some(i) = grabbed {\n                // Dropped. A bone snaps if it was brought home.\n                if self.hz[i].k == Kind::Bone {\n                    self.try_snap_bone(i, s, ev);\n                }\n                self.hz[i].grabbed = None;\n            }\n            return;\n        }\n        if grabbed.is_none() {\n            if pressed || !self.sg[s].held_prev {\n                if let Some(i) = self.find(c, FORCEPS, 0.45) {\n                    if self.hz[i].k == Kind::Nodule && self.hz[i].hidden && self.hz[i].reveal <= 0.0 {\n                        return;\n                    }\n                    self.hz[i].grabbed = Some(s as u8);\n                    self.sg[s].gp = c;\n                    self.cue(ev, cue::FORCEPS, c, 0.6, 1.0);\n                }\n            }\n            return;\n        }\n        let i = grabbed.unwrap();\n        let k = self.hz[i].k;\n        if k == Kind::Bone {\n            self.hz[i].p = c;\n            self.hz[i].ang += rot * 1.9 * dt;\n            return;\n        }\n        let gp = self.sg[s].gp;\n        let v = c - gp;\n        let len = v.length();\n        let axis = Vec2::from_angle(self.hz[i].ang);\n        let need = if k == Kind::Tendril { 2.2 } else { 1.0 } / self.tune.get(\"power\").max(0.3);\n        if k == Kind::Tendril && self.case == 7 {\n            // Tug-of-war with the pulse: only diastole (beat phase > 0.45) lets it come.\n            let fwd = ((c - self.sg[s].prev).dot(axis)).max(0.0);\n            let diastole = self.beat > 0.45;\n            let h = &mut self.hz[i];\n            if diastole {\n                h.prog += fwd / need;\n            } else {\n                h.prog = (h.prog - 0.5 * dt).max(0.0);\n                if fwd > 0.02 {\n                    h.prog = (h.prog - fwd * 0.8 / need).max(0.0);\n                }\n            }\n            let done = h.prog >= 1.0;\n            if done {\n                self.sg[s].chain = self.sg[s].chain;\n                self.cov(\"tendril_pull\");\n                self.step_hz(i, s, 0.8, ev);\n            }\n            return;\n        }\n        if len >= need {\n            let ang_err = {\n                let d = v.normalize_or_zero();\n                let dot = d.dot(axis).abs().clamp(0.0, 1.0);\n                dot.acos().to_degrees()\n            };\n            if ang_err > 40.0 && k == Kind::Hook {\n                // Yanked off-axis: it tears.\n                let spec = format!(\"lace {} {} {} {}\", self.hz[i].p.x, self.hz[i].p.y, self.hz[i].p.x + 0.8, self.hz[i].p.y + 0.3);\n                self.spawn_pop_hz(spec);\n                self.mistakes += 1;\n                self.vitals_hit(2.0);\n                self.cov(\"forceps_tear\");\n            }\n            self.sg[s].gp = c;\n            self.cov(\"rated:forceps\");\n            self.step_hz(i, s, ang_err / 8.0, ev);\n            self.cue(ev, cue::POP, c, 0.7, 1.0);\n        }\n    }\n\n    fn try_snap_bone(&mut self, i: usize, s: usize, ev: &mut Vec<SimEvent>) {\n        let h = &self.hz[i];\n        let d = (h.p - h.q).length();\n        let a = {\n            let x = (h.ang - h.goal).rem_euclid(std::f32::consts::PI);\n            x.min(std::f32::consts::PI - x).to_degrees()\n        };\n        if d < 0.35 && a < 12.0 {\n            let err = (d / 0.12).max(a / 4.0);\n            self.hz[i].p = self.hz[i].q;\n            self.hz[i].ang = self.hz[i].goal;\n            self.cov(\"bone_snap\");\n            self.cue(ev, cue::POP, self.hz[i].p, 0.8, 0.7);\n            self.step_hz(i, s, err, ev);\n        }\n    }\n\n    fn do_suture(&mut self, s: usize, held: bool, _dt: f32, ev: &mut Vec<SimEvent>) {\n        if !held {\n            self.sg[s].target = None;\n            return;\n        }\n        let c = self.sg[s].pos;\n        let assist = self.tune.get(\"assist\") * self.assist_user;\n        let reach = if self.sg[s].tool > 0 { 0.9 + 0.4 * assist } else { 0.9 };\n        let t = self.t;\n        // Find a target: a lace (needle position) / bleeder / bone wire.\n        let mut best: Option<usize> = None;\n        for (i, h) in self.hz.iter().enumerate() {\n            if h.need() != SUTURE || !self.visible(h) {\n                continue;\n            }\n            let (needle, _) = Self::needle(h);\n            if (c - needle).length() < reach + if h.k == Kind::Lace { 0.0 } else { 0.4 } {\n                best = Some(i);\n                break;\n            }\n        }\n        let Some(i) = best else { return };\n        let (needle, axis) = Self::needle(&self.hz[i]);\n        let perp = Vec2::new(-axis.y, axis.x);\n        let lat = (c - needle).dot(perp);\n        let side: i8 = if lat > 0.18 {\n            1\n        } else if lat < -0.18 {\n            -1\n        } else {\n            0\n        };\n        let h = &mut self.hz[i];\n        if side != 0 {\n            if h.last_side != 0 && h.last_side != side {\n                // A crossing.\n                let k = h.k;\n                if k == Kind::Lace {\n                    let f = if h.len() > 0.01 { (needle - h.p).length() / h.len() } else { 0.0 };\n                    h.stitches.push(f);\n                    h.last_cross = t;\n                    self.cue(ev, cue::ZIP, c, 0.5, 1.0 + h.stitches.len() as f32 * 0.02);\n                    self.push_fx(7, needle, 0.3);\n                    let done = self.hz[i].cnt as usize + 1 >= self.hz[i].count() as usize;\n                    if done {\n                        let err = self.suture_error(i);\n                        self.cov(\"rated:suture\");\n                        self.step_hz(i, s, err, ev);\n                    } else {\n                        self.hz[i].cnt += 1;\n                    }\n                } else {\n                    // Bleeder / wire: crossings must come quickly.\n                    if h.last_cross > 0.0 && t - h.last_cross > 1.4 {\n                        h.cnt = 0;\n                    }\n                    h.last_cross = t;\n                    let dur = h.dev;\n                    let _ = dur;\n                    self.cue(ev, cue::ZIP, c, 0.5, 1.2);\n                    self.push_fx(7, needle, 0.3);\n                    let done = self.hz[i].cnt as usize + 1 >= self.hz[i].count() as usize;\n                    if done {\n                        self.cov(\"rated:suture\");\n                        self.hz[i].cnt = self.hz[i].count() - 1;\n                        let started = self.hz[i].aux;\n                        let _ = started;\n                        self.step_hz(i, s, 1.4, ev);\n                    } else {\n                        self.hz[i].cnt += 1;\n                    }\n                }\n            }\n            if let Some(h) = self.hz.get_mut(i) {\n                h.last_side = side;\n            }\n        }\n    }\n\n    /// Where the next stitch goes, and the direction of the wound.\n    fn needle(h: &Hz) -> (Vec2, Vec2) {\n        match h.k {\n            Kind::Lace => {\n                let n = h.count().max(1) as f32;\n                let f = (h.cnt as f32 + 0.5) / n;\n                let ab = h.q - h.p;\n                (h.p + ab * f, ab.normalize_or(Vec2::X))\n            }\n            _ => (h.p, Vec2::X),\n        }\n    }\n\n    fn suture_error(&self, i: usize) -> f32 {\n        let h = &self.hz[i];\n        // Evenness of the stitches' spacing along the wound.\n        let n = h.stitches.len().max(1) as f32;\n        let mut sd = 0.0;\n        let mean = h.stitches.iter().sum::<f32>() / n;\n        for f in &h.stitches {\n            sd += (f - mean).powi(2);\n        }\n        let _ = sd;\n        let mut gaps = vec![];\n        let mut last = 0.0;\n        for f in &h.stitches {\n            gaps.push((f - last) * h.len());\n            last = *f;\n        }\n        let gm = gaps.iter().sum::<f32>() / gaps.len().max(1) as f32;\n        let var = gaps.iter().map(|g| (g - gm).powi(2)).sum::<f32>() / gaps.len().max(1) as f32;\n        var.sqrt() / 0.18\n    }\n\n    fn do_suction(&mut self, s: usize, held: bool, pressure: f32, dt: f32, ev: &mut Vec<SimEvent>) {\n        if !held {\n            return;\n        }\n        let c = self.sg[s].pos;\n        let power = self.tune.get(\"power\");\n        let mut hit = None;\n        for (i, h) in self.hz.iter().enumerate() {\n            if h.need() == SUCTION && (c - h.p).length() < h.r * (1.0 - h.prog * 0.6) + 0.35 {\n                hit = Some(i);\n                break;\n            }\n        }\n        let Some(i) = hit else { return };\n        let h = &mut self.hz[i];\n        let rate = (0.5 + 0.9 * pressure) * power / (0.9 + h.r * h.r * 0.8);\n        h.prog += rate * dt;\n        self.sg[s].recoil = self.sg[s].recoil.max(0.2);\n        if self.tick % 9 == 0 {\n            self.cue(ev, cue::GURGLE, c, 0.15 + 0.35 * pressure, 0.8 + pressure * 0.5);\n            self.push_fx(8, c, 0.3);\n        }\n        if self.hz[i].prog >= 1.0 {\n            self.cov(\"rated:suction\");\n            self.step_hz(i, s, 2.5, ev);\n        }\n    }\n\n    fn do_laser(&mut self, s: usize, kind: u8, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        let c = self.sg[s].pos;\n        let power = self.tune.get(\"power\");\n        if held {\n            let hi = self.sg[s].target.and_then(|id| self.hz_index(id)).filter(|&i| self.hz[i].need() == kind).or_else(|| {\n                self.find(c, kind, 0.25)\n            });\n            let Some(i) = hi else {\n                // Burning nothing: a lasing hum only.\n                if self.tick % 20 == 0 {\n                    self.cue(ev, cue::LASER, c, 0.2, 0.7);\n                }\n                return;\n            };\n            if (c - self.hz[i].p).length() > self.hz[i].r + 0.4 {\n                self.sg[s].target = None;\n                self.sg[s].heat = 0.0;\n                return;\n            }\n            self.sg[s].target = Some(self.hz[i].id);\n            let (t_full, auto) = match self.hz[i].k {\n                Kind::Sac => (0.6, true),\n                Kind::Nodule if self.hz[i].lvl == 1 => (0.72, false),\n                _ => (if kind == CRYO { 1.0 } else { 1.2 }, false),\n            };\n            let t_full = t_full * self.tune.get(\"strain_tough\").max(0.3) / power;\n            self.sg[s].heat += dt / t_full;\n            self.sg[s].recoil = self.sg[s].recoil.max(0.3);\n            if self.tick % 8 == 0 {\n                self.cue(ev, if kind == CRYO { cue::FROST } else { cue::LASER }, c, 0.3, 0.9 + self.sg[s].heat * 0.5);\n                self.push_fx(if kind == CRYO { 9 } else { 10 }, c, self.sg[s].heat);\n            }\n            if auto && self.sg[s].heat >= 1.0 {\n                self.sg[s].heat = 0.0;\n                self.sg[s].target = None;\n                self.cov(\"rated:laser\");\n                self.step_hz(i, s, 1.5, ev);\n            } else if self.sg[s].heat > 1.05 {\n                // Overheat.\n                self.sg[s].heat = 0.0;\n                self.sg[s].target = None;\n                self.sg[s].chain = 0;\n                self.mistakes += 1;\n                self.vitals_hit(3.0);\n                let (x, y) = (c.x, c.y);\n                self.spawn_pop_hz(format!(\"burn {x} {y} 0.5\"));\n                self.cue(ev, cue::SIZZLE, c, 0.7, 1.0);\n                self.cov(\"overheat\");\n            }\n        } else if self.sg[s].heat > 0.0 {\n            let heat = self.sg[s].heat;\n            let tgt = self.sg[s].target.and_then(|id| self.hz_index(id));\n            self.sg[s].heat = 0.0;\n            self.sg[s].target = None;\n            if let Some(i) = tgt {\n                if heat >= 0.8 && heat <= 1.05 {\n                    let err = (heat - 0.9).abs() / 0.03;\n                    self.cov(\"rated:laser\");\n                    if kind == CRYO {\n                        self.hz[i].frost = 1.0;\n                    }\n                    self.step_hz(i, s, err, ev);\n                }\n            }\n        }\n    }\n\n    fn do_gel(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        let c = self.sg[s].pos;\n        if !held {\n            self.sg[s].flow = (self.sg[s].flow + 0.55 * dt).min(1.0);\n            return;\n        }\n        if self.sg[s].flow <= 0.02 {\n            return;\n        }\n        self.sg[s].flow = (self.sg[s].flow - 0.28 * dt).max(0.0);\n        let power = self.tune.get(\"power\");\n        let moved = (self.sg[s].moved / (dt * 1.5)).clamp(0.0, 1.0);\n        let hi = self.find(c, GEL, 0.15);\n        if self.tick % 5 == 0 {\n            self.cue(ev, cue::GEL, c, 0.2, 1.0);\n            self.push_fx(11, c, 0.3);\n        }\n        match hi {\n            Some(i) => {\n                let r = self.hz[i].r;\n                let h = &mut self.hz[i];\n                h.prog += dt * (0.25 + 0.75 * moved) * power / (0.9 + r * 0.6);\n                if h.prog >= 1.0 {\n                    let o = self.sg[s].over;\n                    let frac = o / (o + 1.2);\n                    self.sg[s].over = 0.0;\n                    self.sg[s].flow = (self.sg[s].flow + 0.4).min(1.0);\n                    self.cov(\"rated:gel\");\n                    self.step_hz(i, s, frac / 0.12, ev);\n                }\n            }\n            None => self.sg[s].over += dt,\n        }\n    }\n\n    fn do_scan(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        if !held {\n            return;\n        }\n        let c = self.sg[s].pos;\n        if self.tick % 18 == 0 {\n            self.cue(ev, cue::PING, c, 0.3, 1.0);\n            self.push_fx(12, c, 1.0);\n        }\n        let mut found = false;\n        for h in self.hz.iter_mut() {\n            if (h.p - c).length() < 2.6 + h.r && (h.hidden || h.k == Kind::Nodule) {\n                if h.reveal <= 0.0 {\n                    found = true;\n                }\n                h.reveal = 8.0;\n            }\n        }\n        let _ = dt;\n        if found {\n            self.cov(\"scan_reveal\");\n            self.cue(ev, cue::PING, c, 0.6, 1.8);\n        }\n    }\n\n    fn do_iv(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        // The tool lives at the IV port.\n        self.sg[s].pos = if held || self.sg[s].dose > 0.0 { IV_PORT } else { self.sg[s].pos };\n        if self.sg[s].iv_cd > 0.0 {\n            return;\n        }\n        if held {\n            self.sg[s].dose += dt / 1.8 * self.tune.get(\"power\");\n            if self.tick % 10 == 0 {\n                self.cue(ev, cue::IV, IV_PORT, 0.3, 1.0 + self.sg[s].dose * 0.3);\n            }\n            if self.sg[s].dose > 1.15 {\n                // Overdose: a spike, then a drop.\n                self.sg[s].dose = 0.0;\n                self.sg[s].iv_cd = 4.0;\n                self.vitals = (self.vitals + 5.0).min(100.0);\n                self.vitals_hit(8.0);\n                self.sg[s].chain = 0;\n                self.mistakes += 1;\n                self.cov(\"iv_overdose\");\n                self.cue(ev, cue::WRONG, IV_PORT, 0.7, 0.7);\n            }\n        } else if self.sg[s].dose > 0.1 {\n            let d = self.sg[s].dose;\n            self.sg[s].dose = 0.0;\n            self.sg[s].iv_cd = 4.0;\n            let full = if d >= 0.7 { d.min(1.0) } else { d * 0.6 };\n            let heal = 18.0 * full * self.tune.get(\"iv\");\n            self.vitals = (self.vitals + heal).min(100.0);\n            self.cov(\"rated:iv\");\n            self.award(s, IV_PORT, (d - 0.85).abs() / 0.05, ev);\n            self.cov(\"tool_done:8\");\n        }\n    }\n\n    fn do_dress(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        if !held {\n            self.sg[s].target = None;\n            return;\n        }\n        let c = self.sg[s].pos;\n        let Some(i) = self.hz.iter().position(|h| h.k == Kind::Dress) else { return };\n        let (a, b) = (self.hz[i].p, self.hz[i].q);\n        let ab = b - a;\n        let l = ab.length().max(0.01);\n        let dir = ab / l;\n        let t = ((c - a).dot(dir) / l).clamp(0.0, 1.0);\n        let dev = (c - (a + dir * (t * l))).length();\n        if dev > 1.3 || (t < self.hz[i].prog - 0.05) {\n            return;\n        }\n        let h = &mut self.hz[i];\n        if t > h.prog && t - h.prog < 0.3 {\n            h.prog = t;\n            h.dev += dev;\n            h.dev_n += 1.0;\n        }\n        let _ = dt;\n        if self.tick % 5 == 0 {\n            self.cue(ev, cue::GEL, c, 0.15, 0.7);\n        }\n        if self.hz[i].prog >= 0.97 {\n            let avg = self.hz[i].dev / self.hz[i].dev_n.max(1.0);\n            self.cov(\"rated:dress\");\n            self.step_hz(i, s, avg / 0.4, ev);\n        }\n    }\n\n    // ---------- gifts ----------\n\n    fn tick_gift(&mut self, s: usize, inp: &SurgeonInput, dt: f32, ev: &mut Vec<SimEvent>) {\n        let held = inp.held & sbtn::GIFT != 0;\n        let ready = self.sg[s].unlocked_gift && self.sg[s].gift >= 100.0 && self.hush <= 0.0 && self.echo <= 0.0;\n        if held && ready {\n            if !self.sg[s].gift_on {\n                self.cue(ev, cue::GIFT, Vec2::ZERO, 0.5, 0.6);\n                self.cov(\"gift_hold\");\n            }\n            self.sg[s].gift_on = true;\n            self.sg[s].gift_hold += dt;\n        } else if self.sg[s].gift_on {\n            let ok = self.sg[s].gift_hold >= 0.25 && (self.beat < 0.14 || self.beat > 0.86);\n            self.sg[s].gift_on = false;\n            self.sg[s].gift_hold = 0.0;\n            if ok && ready {\n                self.fire_gift(s, ev);\n            }\n        } else {\n            self.sg[s].gift_hold = 0.0;\n        }\n        if self.sg[s].gift_on && !held {\n            self.sg[s].gift_on = false;\n        }\n    }\n\n    fn fire_gift(&mut self, s: usize, ev: &mut Vec<SimEvent>) {\n        let dur = self.tune.get(\"gift_dur\");\n        self.sg[s].gift = 0.0;\n        let duet = self.case == 7 || self.case == 8 && self.surgeon_count() > 1;\n        let mara = match self.case {\n            0..=4 => true,\n            5 | 6 => false,\n            7 => s == 0,\n            _ => s % 2 == 0,\n        };\n        let hush = mara || duet && self.case == 7;\n        let echo = !mara || duet && self.case == 7;\n        if hush {\n            self.hush = 6.0 * dur;\n            self.cov(\"gift:hush\");\n        }\n        if echo {\n            self.echo = self.tune.get(\"echo_dur\") * dur;\n            self.cov(\"gift:echo\");\n        }\n        if duet && self.case == 7 {\n            self.cov(\"gift:duet\");\n            self.duet = 1.5;\n            for o in self.sg.iter_mut() {\n                o.gift = 0.0;\n            }\n            self.say(\"pet\", \"Together, child.\");\n        }\n        self.push_fx(13, Vec2::ZERO, 1.0);\n        self.flash = 0.6;\n        self.cue(ev, cue::GIFT, Vec2::ZERO, 1.0, 1.0);\n        if echo && !hush {\n            self.say(\"pet\", \"There they are. Thirty years younger, and no better tempered.\");\n        }\n    }\n\n    // ---------- hazards and strains ----------\n\n    fn tick_hazards(&mut self, dtw: f32, ev: &mut Vec<SimEvent>) {\n        let sbeat = self.sbeat_now;\n        let sb = self.sbeats;\n        let ph = self.case_def().phase.get(self.phase.max(0) as usize).cloned().unwrap_or_default();\n        let step_beats = if ph.beats > 0 { ph.beats } else { 3 };\n        let mut spawns: Vec<String> = vec![];\n        let mut burst_fx: Vec<(Vec2, u8)> = vec![];\n        let pools: Vec<(Vec2, f32)> = self.hz.iter().filter(|h| h.k == Kind::Pool).map(|h| (h.p, h.r)).collect();\n        let mut to_remove: Vec<u32> = vec![];\n        let mut vit = 0.0f32;\n        let mut moves: Vec<(usize, Vec2)> = vec![];\n        let mut pend: Vec<(usize, Vec2)> = vec![];\n        for i in 0..self.hz.len() {\n            let rpos = Vec2::new(self.rng.range(-6.5, 6.5), self.rng.range(-3.0, 3.6));\n            let h = &mut self.hz[i];\n            h.t += dtw;\n            if h.reveal > 0.0 {\n                h.reveal -= dtw;\n            }\n            match h.k {\n                Kind::Hook | Kind::Bone => {\n                    if h.k == Kind::Hook {\n                        h.covered = h.covered && pools.iter().any(|(p, r)| (*p - h.p).length() < r + 0.7);\n                    }\n                }\n                Kind::Bleeder => {\n                    if h.t > 1.5 && !pools.iter().any(|(p, r)| (*p - h.p).length() < r + 0.3) && (h.t * 10.0) as i32 % 40 == 0 {\n                        spawns.push(format!(\"pool {} {} 0.6\", h.p.x, h.p.y));\n                    }\n                    if sbeat && sb % 2 == 0 {\n                        burst_fx.push((h.p, 14));\n                    }\n                }\n                Kind::Nodule => {\n                    if h.si == 1 && (sb as f32 - h.born) > 2.0 + 0.5 * (h.lvl == 1) as i32 as f32 && sbeat {\n                        // Pulled too late: the shell closes again.\n                        h.si = 0;\n                        h.cnt = 0;\n                        h.born = sb as f32;\n                    }\n                    if h.lvl == 4 {\n                        // a pest: slow\n                    }\n                    let steps = if h.lvl >= 2 && h.lvl != 3 { 2 } else { step_beats.max(2) };\n                    if sbeat && h.lvl != 3 {\n                        h.aux += 1.0;\n                        if h.aux as u32 + 1 == steps {\n                            burst_fx.push((h.p, 15));\n                            h.window = 1.0;\n                        }\n                        if h.aux as u32 >= steps {\n                            h.aux = 0.0;\n                            h.window = 0.0;\n                            moves.push((i, rpos));\n                        }\n                    }\n                    if h.lvl == 3 {\n                        // the Amen: tethers pulse\n                        h.window = (h.t * 2.0).sin();\n                    }\n                }\n                Kind::Sac => {\n                    if sbeat {\n                        h.grown += 1.0;\n                        if h.grown >= h.aux {\n                            to_remove.push(h.id);\n                            spawns.push(format!(\"pool {} {} 1.1\", h.p.x, h.p.y));\n                            spawns.push(format!(\"burn {} {} 0.8\", h.p.x, h.p.y));\n                            vit += 8.0;\n                            burst_fx.push((h.p, 16));\n                        }\n                    }\n                }\n                Kind::Eye => {\n                    if sbeat {\n                        h.window -= 1.0;\n                        if h.window <= 0.0 {\n                            if h.aux < 0.5 {\n                                h.aux = 1.0;\n                                h.window = 3.0;\n                                h.prog = 0.0;\n                                h.cnt = 0;\n                                vit += 3.0;\n                            } else {\n                                h.aux = 0.0;\n                                h.window = 4.0;\n                            }\n                        }\n                    }\n                }\n                Kind::Ember => {\n                    if h.lvl == 1 && sbeat && sb % 2 == 0 {\n                        pend.push((i, rpos));\n                    }\n                }\n                _ => {}\n            }\n            // Growing pool.\n        }\n        for (i, p) in moves {\n            let old = self.hz[i].p;\n            let new = p;\n            let h = &mut self.hz[i];\n            h.p = new;\n            h.reveal = h.reveal.max(0.0);\n            let id = h.id;\n            for sg in self.sg.iter_mut() {\n                if sg.target == Some(id) {\n                    sg.target = None;\n                    sg.heat = 0.0;\n                }\n            }\n            if self.rng.below(2) == 0 {\n                spawns.push(format!(\"pool {} {} 0.55\", old.x, old.y));\n            } else {\n                spawns.push(format!(\"lace {} {} {} {}\", old.x - 0.6, old.y, old.x + 0.6, old.y + 0.2));\n            }\n            self.push_fx(17, new, 1.0);\n            self.cue(ev, cue::RIPPLE, new, 0.5, 1.0);\n        }\n        for (i, p) in pend {\n            self.hz[i].p = p;\n        }\n        for (p, k) in burst_fx {\n            self.push_fx(k, p, 1.0);\n            if k == 16 {\n                self.cue(ev, cue::BURST, p, 0.9, 1.0);\n            } else if k == 15 {\n                self.cue(ev, cue::RIPPLE, p, 0.4, 1.3);\n            }\n        }\n        for id in to_remove {\n            if let Some(i) = self.hz_index(id) {\n                self.hz.remove(i);\n            }\n        }\n        for sp in spawns {\n            if self.hz.len() < 30 {\n                self.spawn_pop_hz(sp);\n            }\n        }\n        if vit > 0.0 {\n            self.vitals_hit(vit);\n            self.shake = 0.5;\n        }\n        // Bleeders feed pools, pools grow slowly.\n        let growers: Vec<Vec2> = self.hz.iter().filter(|h| h.k == Kind::Bleeder).map(|h| h.p).collect();\n        for h in self.hz.iter_mut().filter(|h| h.k == Kind::Pool) {\n            if growers.iter().any(|g| (*g - h.p).length() < h.r + 0.4) && h.r < 2.2 {\n                h.r += 0.06 * dtw;\n            }\n        }\n        // Fever and heat rings.\n        if ph.fever {\n            let embers = self.hz.iter().filter(|h| h.k == Kind::Ember).count() as f32;\n            self.fever = (self.fever + embers * 1.6 * dtw * self.strain_mul()).min(130.0);\n            if self.fever > 100.0 {\n                self.cov(\"fever_over\");\n            }\n        }\n        if self.rings > 0 {\n            let in_ring = self.sbeats % self.rings;\n            self.ring_warn = in_ring == self.rings - 1;\n            if sbeat && in_ring == 0 {\n                self.ring_r = 0.0;\n                self.ring_on = true;\n                self.cue(ev, cue::RING, Vec2::ZERO, 0.7, 1.0);\n                self.cov(\"heat_ring\");\n            }\n            if self.ring_on {\n                let prev = self.ring_r;\n                self.ring_r += 16.0 * dtw * self.strain_mul().max(0.5) * (self.bpm / 72.0).min(1.4);\n                for s in 0..4 {\n                    if !self.sg[s].active {\n                        continue;\n                    }\n                    let d = self.sg[s].pos.length();\n                    if d > prev && d <= self.ring_r && self.sg[s].held {\n                        let c = self.sg[s].pos;\n                        self.sg[s].chain = 0;\n                        self.vitals_hit(3.0);\n                        self.mistakes += 1;\n                        self.spawn_pop_hz(format!(\"burn {} {} 0.6\", c.x, c.y));\n                        self.cue(ev, cue::SIZZLE, c, 0.8, 0.8);\n                        self.cov(\"ring_scorch\");\n                        self.callout(\"Lift off! Lift off!\");\n                    } else if d > prev && d <= self.ring_r && self.sg[s].tool > 0 {\n                        self.cov(\"ring_dodge\");\n                    }\n                }\n                if self.ring_r > 16.0 {\n                    self.ring_on = false;\n                    self.ring_r = -1.0;\n                }\n            }\n        }\n    }\n\n    // ---------- queries ----------\n\n    pub fn status_json(&self) -> serde_json::Value {\n        let c = self.case_def();\n        json!({\n            \"mode\": self.mode,\n            \"scene\": self.scene,\n            \"step\": self.step,\n            \"case\": self.case,\n            \"case_name\": c.name,\n            \"phase\": self.phase,\n            \"phases\": c.phase.len(),\n            \"vitals\": (self.vitals * 10.0).round() / 10.0,\n            \"bpm\": self.bpm.round(),\n            \"time_left\": self.time_left.round(),\n            \"t\": (self.t * 10.0).round() / 10.0,\n            \"hazards\": self.hz.len(),\n            \"hush\": self.hush,\n            \"echo\": self.echo,\n            \"code\": self.code_t > 0.0,\n            \"score\": self.sg.iter().map(|s| s.score).sum::<i64>(),\n            \"total_score\": self.total_score,\n            \"chain\": self.sg[0].chain,\n            \"gift\": self.sg[0].gift,\n            \"tool\": self.sg[0].tool,\n            \"cursor\": [self.sg[0].pos.x, self.sg[0].pos.y],\n            \"surgeons\": self.surgeon_count(),\n            \"attract\": self.attract,\n            \"banner\": self.banner,\n            \"rank\": self.results.as_ref().map(|r| r.rank.clone()),\n            \"story\": self.story,\n            \"line\": self.line,\n            \"fever\": self.fever.round(),\n            \"mistakes\": self.mistakes,\n            \"paused\": self.paused,\n            \"codes_left\": self.codes_left,\n            \"cheat_immortal\": self.cheat_immortal,\n            \"cov\": self.cov,\n        })\n    }\n}\n\nimpl Game for Surgery {\n    const KEY: &'static str = KEY;\n\n    fn pre(&mut self, _sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        self.do_pre(input, dt, events);\n        BTreeMap::new()\n    }\n\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        self.status_json()\n    }\n\n    fn outcome(&self) -> Outcome {\n        match self.mode {\n            Mode::Won => Outcome::Won,\n            Mode::Dead => Outcome::Lost,\n            Mode::Results if self.scene != \"campaign\" => Outcome::Won,\n            _ => Outcome::Playing,\n        }\n    }\n\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        for s in 0..4 {\n            if self.sg[s].active && self.mode == Mode::Op {\n                f.surgeons[s] = bot::bot_slot(self, s);\n            }\n        }\n        if matches!(self.mode, Mode::Story | Mode::Card | Mode::Results | Mode::Dead) {\n            f.surgeons[0].active = true;\n            f.surgeons[0].pressed = sbtn::ADVANCE;\n        }\n        f.surgeons[0].active = true;\n        f\n    }\n}\n\nimpl crate::games::GameBox {\n    /// The frame the view and the shell draw from (None for other games).\n    pub fn surgery_frame(&self) -> Option<std::sync::Arc<SurgeryFrame>> {\n        self.get::<Surgery>().map(|g| std::sync::Arc::new(frame::build(g)))\n    }\n    pub fn surgery(&self) -> Option<&Surgery> {\n        self.get::<Surgery>()\n    }\n    pub fn surgery_mut(&mut self) -> Option<&mut Surgery> {\n        self.get_mut::<Surgery>()\n    }\n}\nE\necho written"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12417,"cache_read_input_tokens":114258,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12417},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c","uuid":"cdb9a966-cce8-4351-ad33-1a5b5794180f","timestamp":"2026-11-05T14:42:54.761Z","request_id":"req_011CgjxBtUoRnfgxRG2u25uT","wire_tool_inputs":{"toolu_01EMciVz54YFm9u1om6wK9L9":{"command":"cat > mod.rs <<'E'\n//! Tempo Trauma: a surgical-action drama. The whole game is a deterministic simulation here\n//! (cases, story, strains, gifts, the bot); `pav_view`, `pav_ui` and `pav_audio` draw and\n//! play what `frame()` publishes.\n\nuse std::collections::BTreeMap;\n\nuse anyhow::Result;\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse super::{Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, SurgeonInput, SurgeryCmd, sbtn};\nuse crate::rng::Rng;\nuse crate::sim::Sim;\n\npub mod bot;\npub mod data;\npub mod frame;\npub mod tune;\n\nuse data::*;\npub use frame::SurgeryFrame;\nuse tune::Tune;\n\npub const KEY: &str = \"surgery\";\npub const TITLE: &str = \"Tempo Trauma\";\npub const FIELD_X: f32 = 9.0;\npub const FIELD_Z0: f32 = -4.0;\npub const FIELD_Z1: f32 = 4.2;\npub const IV_PORT: Vec2 = Vec2::new(7.6, 3.4);\n\n/// Sound cue ids (`SimEvent::Cue`).\npub mod cue {\n    pub const PICK: u8 = 1;\n    pub const SLICE: u8 = 2;\n    pub const SQUISH: u8 = 3;\n    pub const FORCEPS: u8 = 4;\n    pub const POP: u8 = 5;\n    pub const ZIP: u8 = 6;\n    pub const GURGLE: u8 = 7;\n    pub const LASER: u8 = 8;\n    pub const SIZZLE: u8 = 9;\n    pub const GEL: u8 = 10;\n    pub const IV: u8 = 11;\n    pub const PING: u8 = 12;\n    pub const DEFIB_WHINE: u8 = 13;\n    pub const DEFIB_THUMP: u8 = 14;\n    pub const LUBDUB: u8 = 15;\n    pub const BEEP: u8 = 16;\n    pub const ALARM: u8 = 17;\n    pub const STING_SLOPPY: u8 = 18;\n    pub const STING_GOOD: u8 = 19;\n    pub const STING_CLEAN: u8 = 20;\n    pub const STING_IMM: u8 = 21;\n    pub const CHAIN: u8 = 22;\n    pub const ONBEAT: u8 = 23;\n    pub const STRAIN: u8 = 24;\n    pub const BURST: u8 = 25;\n    pub const UI_NAV: u8 = 26;\n    pub const UI_OK: u8 = 27;\n    pub const UI_BACK: u8 = 28;\n    pub const BANNER: u8 = 29;\n    pub const FLATLINE: u8 = 30;\n    pub const WRONG: u8 = 31;\n    pub const GIFT: u8 = 32;\n    pub const HUSH_END: u8 = 33;\n    pub const RIPPLE: u8 = 34;\n    pub const FROST: u8 = 35;\n    pub const RING: u8 = 36;\n    pub const STAMP: u8 = 37;\n    pub const NAMES: [&str; 38] = [\n        \"\", \"pick\", \"slice\", \"squish\", \"forceps\", \"pop\", \"zip\", \"gurgle\", \"laser\", \"sizzle\", \"gel\", \"iv\", \"ping\", \"defib_whine\",\n        \"defib_thump\", \"lubdub\", \"beep\", \"alarm\", \"sting_sloppy\", \"sting_good\", \"sting_clean\", \"sting_imm\", \"chain\", \"onbeat\",\n        \"strain\", \"burst\", \"ui_nav\", \"ui_ok\", \"ui_back\", \"banner\", \"flatline\", \"wrong\", \"gift\", \"hush_end\", \"ripple\", \"frost\",\n        \"ring\", \"stamp\",\n    ];\n}\n\n/// The campaign: a story scene (`S`) or a case (`C`).\n#[derive(Clone, Copy, Debug)]\npub enum Step {\n    S(&'static str),\n    C(u8),\n}\npub const STEPS: &[Step] = &[\n    Step::S(\"s0\"),\n    Step::C(0),\n    Step::S(\"s0b\"),\n    Step::S(\"s1\"),\n    Step::C(1),\n    Step::S(\"s1b\"),\n    Step::S(\"s2\"),\n    Step::C(2),\n    Step::S(\"s2b\"),\n    Step::S(\"s3\"),\n    Step::C(3),\n    Step::S(\"s3b\"),\n    Step::S(\"s4\"),\n    Step::C(4),\n    Step::S(\"s4b\"),\n    Step::S(\"s5\"),\n    Step::C(5),\n    Step::S(\"s5b\"),\n    Step::S(\"s6\"),\n    Step::C(6),\n    Step::S(\"s6b\"),\n    Step::S(\"s7\"),\n    Step::C(7),\n    Step::S(\"s7b\"),\n    Step::S(\"epilogue\"),\n];\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum Mode {\n    Idle,\n    Story,\n    Card,\n    Op,\n    Results,\n    Dead,\n    Won,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Surgeon {\n    pub active: bool,\n    pub bot: bool,\n    pub pos: Vec2,\n    pub prev: Vec2,\n    pub tool: u8,\n    pub held: bool,\n    pub held_prev: bool,\n    pub score: i64,\n    pub chain: u32,\n    pub best_chain: u32,\n    pub chain_t: f32,\n    pub gift: f32,\n    pub gift_hold: f32,\n    pub gift_on: bool,\n    pub target: Option<u32>,\n    pub gp: Vec2,\n    pub heat: f32,\n    pub dose: f32,\n    pub iv_cd: f32,\n    pub flow: f32,\n    pub over: f32,\n    pub charge: f32,\n    pub wrong_cd: f32,\n    pub cut_cd: f32,\n    pub recoil: f32,\n    pub last_kind: u8,\n    pub last_rating: u8,\n    pub rot: f32,\n    pub unlocked_gift: bool,\n    pub moved: f32,\n    pub ghost: Option<Vec2>,\n    pub seat: u8,\n    pub actions: u32,\n    pub imm: u32,\n}\n\nimpl Surgeon {\n    fn new(seat: u8) -> Self {\n        Self {\n            active: seat == 0,\n            bot: false,\n            pos: Vec2::new(0.0, 0.5),\n            prev: Vec2::new(0.0, 0.5),\n            tool: 2,\n            held: false,\n            held_prev: false,\n            score: 0,\n            chain: 0,\n            best_chain: 0,\n            chain_t: 0.0,\n            gift: 0.0,\n            gift_hold: 0.0,\n            gift_on: false,\n            target: None,\n            gp: Vec2::ZERO,\n            heat: 0.0,\n            dose: 0.0,\n            iv_cd: 0.0,\n            flow: 1.0,\n            over: 0.0,\n            charge: 0.0,\n            wrong_cd: 0.0,\n            cut_cd: 0.0,\n            recoil: 0.0,\n            last_kind: 0,\n            last_rating: 0,\n            rot: 0.0,\n            unlocked_gift: false,\n            moved: 0.0,\n            ghost: None,\n            seat,\n            actions: 0,\n            imm: 0,\n        }\n    }\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Pop {\n    pub pos: Vec2,\n    pub rating: u8,\n    pub t: f32,\n    pub on_beat: bool,\n    pub chain: u32,\n    pub seat: u8,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Fx {\n    pub id: u32,\n    pub kind: u8,\n    pub pos: Vec2,\n    pub v: f32,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Sub {\n    pub who: String,\n    pub text: String,\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize, Default)]\npub struct Results {\n    pub case: u8,\n    pub score: i64,\n    pub vitals_bonus: i64,\n    pub time_bonus: i64,\n    pub mistakes: i64,\n    pub total: i64,\n    pub par: i64,\n    pub rank: String,\n    pub fate: String,\n    pub patient: String,\n    pub name: String,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\nstruct Checkpoint {\n    phase: i32,\n    vitals: f32,\n    time_left: f32,\n}\n\npub const RATING_NAMES: [&str; 4] = [\"SLOPPY\", \"GOOD\", \"CLEAN\", \"IMMACULATE\"];\nconst POINTS: [i64; 4] = [10, 120, 250, 400];\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct Surgery {\n    pub mode: Mode,\n    pub scene: String,\n    pub step: u16,\n    pub difficulty: u8,\n    pub case: u8,\n    pub attract: bool,\n    pub paused: bool,\n    rng: Rng,\n    // story\n    pub story: String,\n    pub line: u16,\n    pub typed: f32,\n    pub card_t: f32,\n    // operation\n    pub t: f32,\n    pub time_left: f32,\n    pub phase: i32,\n    pub phase_t: f32,\n    pub clear_t: f32,\n    pub plate: String,\n    pub plate_prev: String,\n    pub plate_t: f32,\n    pub vitals: f32,\n    pub beat: f32,\n    pub beats: u32,\n    pub beat_now: bool,\n    pub bpm: f32,\n    pub sbeat: f32,\n    pub sbeat_now: bool,\n    pub sbeats: u32,\n    pub hz: Vec<Hz>,\n    next_id: u32,\n    pending: Vec<String>,\n    pub sg: Vec<Surgeon>,\n    pub pops: Vec<Pop>,\n    pub fx: Vec<Fx>,\n    fx_id: u32,\n    pub sub: Option<Sub>,\n    says: Vec<(f32, String, String)>,\n    pub now_line: String,\n    pub banner: String,\n    pub banner_t: f32,\n    pub tune: Tune,\n    pub fever: f32,\n    pub rings: u32,\n    pub ring_r: f32,\n    pub ring_warn: bool,\n    pub ring_on: bool,\n    pub hush: f32,\n    pub echo: f32,\n    echo_cd: f32,\n    pub woke: bool,\n    pub code_t: f32,\n    pub code_scripted: bool,\n    pub codes_left: i32,\n    pub shocks_left: u32,\n    pub ghost_phase: f32,\n    pub mistakes: i64,\n    pub dir_t: f32,\n    pub flat: f32,\n    pub shake: f32,\n    pub flash: f32,\n    pub results: Option<Results>,\n    cp: Option<Checkpoint>,\n    pub death_time: f32,\n    pub cheat_immortal: bool,\n    pub cheat_freeze: bool,\n    pub tremor_on: bool,\n    pub time_scale: f32,\n    pub assist_user: f32,\n    pub cov: BTreeMap<String, u32>,\n    pub total_score: i64,\n    pub seg: u8,\n    pub seg_t: f32,\n    pub guided_hint: bool,\n    pub duet: f32,\n    pub xbox: bool,\n    pub opt_surgeons: u8,\n    pub last_cmd_tick: u32,\n    pub tick: u32,\n}\n\nfn lerp(a: f32, b: f32, t: f32) -> f32 {\n    a + (b - a) * t\n}\n\nfn rank_of(total: i64, par: i64) -> &'static str {\n    let r = total as f32 / par.max(1) as f32;\n    if r >= 1.15 {\n        \"ENCORE\"\n    } else if r >= 1.0 {\n        \"S\"\n    } else if r >= 0.85 {\n        \"A\"\n    } else if r >= 0.7 {\n        \"B\"\n    } else {\n        \"C\"\n    }\n}\n\n/// Builds the scene. `rest`: \"title\", \"attract\", \"campaign[/step]\", \"case/<n>[/<phase>]\", \"codeblue\", \"mirror\", \"card\".\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    crate::scenes::build_standalone_room(sim, KEY, crate::room::RoomDef::parse(ROOM)?);\n    if let Some(p) = sim.state.player {\n        sim.despawn(p);\n        sim.state.player = None;\n    }\n    sim.state.focus = Vec3::ZERO;\n    let seed = sim.state.rng.next_u32() as u64 | ((sim.state.rng.next_u32() as u64) << 32);\n    let mut g = Surgery::new(seed);\n    let rest = rest.unwrap_or(\"title\");\n    let mut parts = rest.split('/');\n    let head = parts.next().unwrap_or(\"title\");\n    let arg = parts.next();\n    let arg2 = parts.next();\n    g.scene = head.to_string();\n    match head {\n        \"campaign\" => {\n            let step: u16 = arg.and_then(|a| a.parse().ok()).unwrap_or(0);\n            g.enter_step(step);\n        }\n        \"case\" => {\n            let n: u8 = arg.and_then(|a| a.parse().ok()).unwrap_or(0);\n            let ph: i32 = arg2.and_then(|a| a.parse().ok()).unwrap_or(0);\n            g.begin_case(n, ph);\n        }\n        \"codeblue\" => {\n            g.sg[0].active = true;\n            g.begin_case(8, 0);\n        }\n        \"attract\" => {\n            g.attract = true;\n            g.start_attract_seg(0);\n        }\n        _ => {}\n    }\n    sim.state.play = Some(GameBox::new(g));\n    Ok(())\n}\n\nconst ROOM: &str = r#\"\nname = \"Operating theatre\"\nabout = \"Tempo Trauma's stage: the field itself is drawn by the surgery view.\"\nentrance = { at = [2, 3], facing = \"south\" }\n[camera]\ntilt = 73.0\ndistance = 19.9\n[layout]\norigin = [90.0, 0.0, -8.0]\n[[layout.layer]]\ny = 0\nmap = '''\n####\n#..#\n#..#\n####\n'''\n[layout.legend]\n\"#\" = { block = { height = 3.0, color = \"#2a3a3a\" } }\n\"#;\n\nimpl Surgery {\n    pub fn new(seed: u64) -> Self {\n        let mut sg: Vec<Surgeon> = (0..4).map(|i| Surgeon::new(i)).collect();\n        sg[0].active = true;\n        Self {\n            mode: Mode::Idle,\n            scene: String::new(),\n            step: 0,\n            difficulty: 1,\n            case: 0,\n            attract: false,\n            paused: false,\n            rng: Rng::new(seed),\n            story: String::new(),\n            line: 0,\n            typed: 0.0,\n            card_t: 0.0,\n            t: 0.0,\n            time_left: 0.0,\n            phase: -1,\n            phase_t: 0.0,\n            clear_t: 0.0,\n            plate: \"forearm\".into(),\n            plate_prev: \"forearm\".into(),\n            plate_t: 1.0,\n            vitals: 100.0,\n            beat: 0.0,\n            beats: 0,\n            beat_now: false,\n            bpm: 72.0,\n            sbeat: 0.0,\n            sbeat_now: false,\n            sbeats: 0,\n            hz: vec![],\n            next_id: 1,\n            pending: vec![],\n            sg,\n            pops: vec![],\n            fx: vec![],\n            fx_id: 0,\n            sub: None,\n            says: vec![],\n            now_line: String::new(),\n            banner: String::new(),\n            banner_t: 0.0,\n            tune: Tune::default(),\n            fever: 0.0,\n            rings: 0,\n            ring_r: -1.0,\n            ring_warn: false,\n            ring_on: false,\n            hush: 0.0,\n            echo: 0.0,\n            echo_cd: 0.0,\n            woke: false,\n            code_t: 0.0,\n            code_scripted: false,\n            codes_left: 1,\n            shocks_left: 0,\n            ghost_phase: 0.0,\n            mistakes: 0,\n            dir_t: 0.0,\n            flat: 0.0,\n            shake: 0.0,\n            flash: 0.0,\n            results: None,\n            cp: None,\n            death_time: 0.0,\n            cheat_immortal: false,\n            cheat_freeze: false,\n            tremor_on: true,\n            time_scale: 1.0,\n            assist_user: 1.0,\n            cov: BTreeMap::new(),\n            total_score: 0,\n            seg: 0,\n            seg_t: 0.0,\n            guided_hint: false,\n            duet: 0.0,\n            xbox: false,\n            opt_surgeons: 1,\n            last_cmd_tick: 0,\n            tick: 0,\n        }\n    }\n\n    // ---------- bookkeeping helpers ----------\n\n    pub fn cov(&mut self, key: &str) {\n        *self.cov.entry(key.to_string()).or_insert(0) += 1;\n    }\n\n    fn content(&self) -> std::sync::Arc<Content> {\n        data::load()\n    }\n\n    pub fn case_def(&self) -> Case {\n        let c = self.content();\n        c.cases.iter().find(|c| c.id == self.case).cloned().unwrap_or_default()\n    }\n\n    fn push_fx(&mut self, kind: u8, pos: Vec2, v: f32) {\n        self.fx_id += 1;\n        let id = self.fx_id;\n        self.fx.push(Fx { id, kind, pos, v });\n        if self.fx.len() > 40 {\n            self.fx.remove(0);\n        }\n    }\n\n    fn cue(&mut self, ev: &mut Vec<SimEvent>, id: u8, pos: Vec2, gain: f32, pitch: f32) {\n        ev.push(SimEvent::Cue { id, pos: Vec3::new(pos.x, 0.0, pos.y), gain, pitch });\n    }\n\n    fn say(&mut self, who: &str, text: &str) {\n        self.sub = Some(Sub { who: who.to_string(), text: text.to_string(), t: 4.2 });\n    }\n\n    fn callout(&mut self, text: &str) {\n        if self.case_def().silent && self.case != 8 {\n            return;\n        }\n        let who = if self.case >= 7 { \"teddy\" } else { \"bashir\" };\n        self.say(who, text);\n    }\n\n    fn diff_drain(&self) -> f32 {\n        [0.7, 1.0, 1.4][self.difficulty.min(2) as usize]\n    }\n\n    fn strain_mul(&self) -> f32 {\n        [0.85, 1.0, 1.2][self.difficulty.min(2) as usize] * self.tune.get(\"strain_speed\")\n    }\n\n    pub fn surgeon_count(&self) -> usize {\n        self.sg.iter().filter(|s| s.active).count()\n    }\n\n    /// The instrument kind a surgeon's slot holds in this case.\n    pub fn kind_of(&self, tool: u8) -> u8 {\n        match tool {\n            5 if self.case == 6 => CRYO,\n            7 if self.case == 7 => CRYO,\n            1..=8 => tool,\n            _ => 0,\n        }\n    }\n\n    pub fn ring_unlocked(&self, slot: u8) -> bool {\n        let c = self.case_def();\n        c.ring.get(slot as usize - 1).map(|v| *v != 0).unwrap_or(true)\n    }\n\n    /// Beats per phase when a strain stepping speed is requested.\n    pub fn on_beat(&self) -> bool {\n        let p = self.beat.min(1.0 - self.beat);\n        p * 60.0 / self.bpm.max(30.0) <= self.tune.get(\"beat_ms\") / 1000.0\n    }\n\n    fn world_scale(&self) -> f32 {\n        if self.hush > 0.0 { self.tune.get(\"hush_scale\") } else { 1.0 }\n    }\n\n    // ---------- campaign / flow ----------\n\n    pub fn enter_step(&mut self, i: u16) {\n        self.step = i;\n        match STEPS.get(i as usize) {\n            Some(Step::S(id)) => {\n                self.mode = Mode::Story;\n                self.story = id.to_string();\n                self.line = 0;\n                self.typed = 0.0;\n                self.card_t = 0.0;\n            }\n            Some(Step::C(n)) => {\n                self.case = *n;\n                self.setup_case(*n);\n                self.mode = Mode::Card;\n                self.card_t = 0.0;\n            }\n            None => {\n                self.mode = Mode::Won;\n            }\n        }\n    }\n\n    fn setup_case(&mut self, n: u8) {\n        self.case = n;\n        let c = self.case_def();\n        self.hz.clear();\n        self.pending.clear();\n        self.pops.clear();\n        self.says.clear();\n        self.sub = None;\n        self.t = 0.0;\n        self.time_left = c.timer * [1.25, 1.0, 0.8][self.difficulty.min(2) as usize] * self.tune.get(\"timer\");\n        self.vitals = 100.0;\n        self.phase = -1;\n        self.phase_t = 0.0;\n        self.clear_t = 0.0;\n        self.plate = c.plate.clone();\n        self.plate_prev = c.plate.clone();\n        self.plate_t = 1.0;\n        self.fever = 0.0;\n        self.rings = 0;\n        self.ring_r = -1.0;\n        self.hush = 0.0;\n        self.echo = 0.0;\n        self.code_t = 0.0;\n        self.shocks_left = 0;\n        self.mistakes = 0;\n        self.woke = false;\n        self.cp = None;\n        self.flat = 0.0;\n        self.dir_t = 6.0;\n        self.codes_left = [2, 1, 0][self.difficulty.min(2) as usize];\n        self.results = None;\n        let team = n == 8;\n        for (i, s) in self.sg.iter_mut().enumerate() {\n            let keep_active = s.active;\n            let bot = s.bot;\n            let seat = s.seat;\n            *s = Surgeon::new(seat);\n            s.bot = bot;\n            s.active = if i == 0 { true } else { keep_active };\n            s.tool = if n == 0 { 4 } else { 2 };\n            s.unlocked_gift = false;\n        }\n        if n == 7 {\n            // Mara + Pet: the partner is a bot on slot 1 unless a human took it.\n            if !self.sg[1].active {\n                self.sg[1].active = true;\n                self.sg[1].bot = true;\n            }\n        } else if !team && !self.attract {\n            for i in 1..4 {\n                if self.sg[i].bot && !self.attract && n != 7 {\n                    self.sg[i].active = false;\n                    self.sg[i].bot = false;\n                }\n            }\n        }\n        // Gifts exist from Case 3 (Hush), 5 (Echo), 7 (both), Code Blue (both).\n        let gift = matches!(n, 3 | 4 | 5 | 6 | 7 | 8);\n        for s in self.sg.iter_mut() {\n            s.unlocked_gift = gift;\n        }\n        self.guided_hint = c.guided;\n    }\n\n    /// Start the operation itself on a phase (banner, spawns).\n    pub fn begin_case(&mut self, n: u8, phase: i32) {\n        self.setup_case(n);\n        self.mode = Mode::Op;\n        self.banner = \"OPERATION START\".into();\n        self.banner_t = 1.6;\n        self.start_phase(phase.max(0));\n    }\n\n    fn start_phase(&mut self, i: i32) {\n        let c = self.case_def();\n        let Some(ph) = c.phase.get(i as usize).cloned() else {\n            self.finish_case();\n            return;\n        };\n        self.phase = i;\n        self.phase_t = 0.0;\n        self.clear_t = 0.0;\n        self.hz.clear();\n        self.pending.clear();\n        self.says.clear();\n        self.now_line = ph.now.clone();\n        for s in &ph.say {\n            let mut it = s.splitn(3, '|');\n            let t: f32 = it.next().and_then(|v| v.parse().ok()).unwrap_or(0.5);\n            let who = it.next().unwrap_or(\"bashir\").to_string();\n            let text = it.next().unwrap_or(\"\").to_string();\n            self.says.push((t, who, text));\n        }\n        self.rings = ph.rings;\n        self.ring_r = -1.0;\n        if ph.rings == 0 {\n            self.ring_on = false;\n        }\n        if !ph.fever {\n            self.fever = 0.0;\n        }\n        if let Some(v) = ph.drop_vitals {\n            self.vitals = self.vitals.min(v + 25.0);\n        }\n        let tough = self.tune.get(\"strain_tough\");\n        if ph.rhythm {\n            self.pending = ph.spawn.clone();\n        } else {\n            for s in &ph.spawn {\n                match make(self.next_id, s, tough) {\n                    Ok(mut h) => {\n                        h.born = self.sbeats as f32;\n                        h.window = if h.k == Kind::Eye { 4.0 } else { h.window };\n                        self.next_id += 1;\n                        self.hz.push(h);\n                    }\n                    Err(e) => panic!(\"case {} phase {}: {e}\", c.id, ph.name),\n                }\n            }\n        }\n        if ph.hush_wake || ph.echo_wake {\n            self.wake_gift();\n        }\n        if ph.shocks > 0 {\n            self.shocks_left = ph.shocks;\n            self.dir_t = 1.2;\n        }\n        if ph.checkpoint {\n            self.cp = Some(Checkpoint { phase: i, vitals: self.vitals, time_left: self.time_left });\n        }\n        self.cov(&format!(\"phase:{}:{}\", self.case, i));\n    }\n\n    fn wake_gift(&mut self) {\n        if !self.woke {\n            self.woke = true;\n            for s in self.sg.iter_mut().filter(|s| s.active) {\n                s.gift = 100.0;\n                s.unlocked_gift = true;\n            }\n            if self.case == 3 {\n                self.say(\"bashir\", \"Doctor... your hands.\");\n            } else if self.case == 5 {\n                self.say(\"pet\", \"Doctor Nwosu... there were two of you.\");\n            }\n        }\n    }\n\n    fn finish_case(&mut self) {\n        let c = self.case_def();\n        let sc: i64 = self.sg.iter().map(|s| s.score).sum();\n        let vb = (self.vitals.max(0.0) * 20.0) as i64;\n        let tb = (self.time_left.max(0.0) * 5.0) as i64;\n        let mis = self.mistakes * -100;\n        let total = ((sc + vb + tb + mis) as f32).max(0.0) as i64;\n        self.results = Some(Results {\n            case: c.id,\n            score: sc,\n            vitals_bonus: vb,\n            time_bonus: tb,\n            mistakes: mis,\n            total,\n            par: c.par,\n            rank: rank_of(total, c.par).to_string(),\n            fate: c.fate.clone(),\n            patient: c.patient.clone(),\n            name: c.name.clone(),\n        });\n        self.total_score += total;\n        self.mode = Mode::Results;\n        self.card_t = 0.0;\n        self.banner = \"OPERATION COMPLETE\".into();\n        self.banner_t = 2.0;\n        self.hush = 0.0;\n        self.echo = 0.0;\n        self.cov(&format!(\"case_done:{}\", c.id));\n    }\n\n    fn die(&mut self, ev: &mut Vec<SimEvent>) {\n        self.mode = Mode::Dead;\n        self.death_time = self.t;\n        self.card_t = 0.0;\n        self.hush = 0.0;\n        self.echo = 0.0;\n        self.cue(ev, cue::FLATLINE, Vec2::ZERO, 1.0, 1.0);\n        self.cov(\"deaths\");\n    }\n\n    fn retry(&mut self) {\n        let (ph, v, tl) = match &self.cp {\n            Some(cp) => (cp.phase, cp.vitals.max(60.0), cp.time_left.max(60.0)),\n            None => (0, 100.0, self.case_def().timer),\n        };\n        let score_keep: Vec<i64> = self.sg.iter().map(|s| s.score).collect();\n        let case = self.case;\n        let cp = self.cp.clone();\n        self.begin_case(case, ph);\n        self.vitals = v;\n        self.time_left = tl;\n        self.cp = cp;\n        for (s, sc) in self.sg.iter_mut().zip(score_keep) {\n            s.score = sc;\n        }\n        self.banner = \"OPERATION START\".into();\n        self.cov(\"retries\");\n    }\n\n    // ---------- the operation ----------\n\n    fn spawn_hz(&mut self, spec: &str) -> Option<usize> {\n        let tough = self.tune.get(\"strain_tough\");\n        match make(self.next_id, spec, tough) {\n            Ok(mut h) => {\n                self.next_id += 1;\n                h.born = self.sbeats as f32;\n                self.hz.push(h);\n                Some(self.hz.len() - 1)\n            }\n            Err(_) => None,\n        }\n    }\n\n    fn rand_pos(&mut self) -> Vec2 {\n        Vec2::new(self.rng.range(-6.5, 6.5), self.rng.range(-3.2, 3.6))\n    }\n\n    fn hz_index(&self, id: u32) -> Option<usize> {\n        self.hz.iter().position(|h| h.id == id)\n    }\n\n    fn visible(&self, h: &Hz) -> bool {\n        (!h.hidden || h.reveal > 0.0) && !h.covered\n    }\n\n    /// Nearest hazard the instrument `kind` can work on within `reach` of `c`.\n    fn find(&self, c: Vec2, kind: u8, reach: f32) -> Option<usize> {\n        let mut best: Option<(usize, f32)> = None;\n        for (i, h) in self.hz.iter().enumerate() {\n            if h.need() != kind || !self.visible(h) {\n                continue;\n            }\n            if h.k == Kind::Eye && h.aux > 0.5 {\n                continue;\n            }\n            let d = if matches!(h.k, Kind::Line | Kind::Dress | Kind::Lace) { h.dist(c) } else { (c - h.p).length() - h.r };\n            if d <= reach && best.map(|b| d < b.1).unwrap_or(true) {\n                best = Some((i, d));\n            }\n        }\n        best.map(|b| b.0)\n    }\n\n    /// Stroke endpoints for a scalpel target.\n    pub fn stroke(h: &Hz) -> (Vec2, Vec2) {\n        if h.is_line() {\n            (h.p, h.q)\n        } else {\n            let a = Vec2::from_angle(h.cnt as f32 * 1.05 + 0.2 + if h.k == Kind::Eye { 0.0 } else { 0.6 });\n            (h.p - a * h.r * 1.05, h.p + a * h.r * 1.05)\n        }\n    }\n\n    fn award(&mut self, s: usize, pos: Vec2, err: f32, ev: &mut Vec<SimEvent>) -> u8 {\n        let e = err * self.tune.get(\"strict\");\n        let r: u8 = if e <= 1.0 {\n            3\n        } else if e <= 2.0 {\n            2\n        } else if e <= 3.2 {\n            1\n        } else {\n            0\n        };\n        let on_beat = self.on_beat();\n        let mut pts = POINTS[r as usize] as f32;\n        let sg = &mut self.sg[s];\n        if r >= 2 {\n            sg.chain += 1;\n            sg.chain_t = 0.0;\n            sg.best_chain = sg.best_chain.max(sg.chain);\n        } else if r == 0 {\n            sg.chain = 0;\n        }\n        let mult = if sg.chain >= 20 {\n            2.0\n        } else if sg.chain >= 10 {\n            1.5\n        } else if sg.chain >= 5 {\n            1.25\n        } else {\n            1.0\n        };\n        pts *= mult;\n        if on_beat {\n            pts *= 1.25;\n        }\n        pts *= self.tune.get(\"score\");\n        sg.score += pts as i64;\n        sg.last_rating = r;\n        sg.actions += 1;\n        if r == 3 {\n            sg.imm += 1;\n        }\n        sg.recoil = 1.0;\n        let gain = match r {\n            3 => 8.0,\n            2 => 4.0,\n            _ => 0.0,\n        } + if on_beat { 2.0 } else { 0.0 };\n        let chain = sg.chain;\n        if sg.unlocked_gift && self.hush <= 0.0 && self.echo <= 0.0 {\n            sg.gift = (sg.gift + gain * self.tune.get(\"gift_gain\")).min(100.0);\n        }\n        let seat = sg.seat;\n        self.pops.push(Pop { pos, rating: r, t: 0.0, on_beat, chain, seat });\n        self.cov(&format!(\"rating:{}\", r));\n        if on_beat {\n            self.cov(\"onbeat\");\n            if self.hush > 0.0 {\n                self.hush += 1.0;\n            }\n        }\n        let id = [cue::STING_SLOPPY, cue::STING_GOOD, cue::STING_CLEAN, cue::STING_IMM][r as usize];\n        self.cue(ev, id, pos, 0.8, 1.0);\n        if on_beat {\n            self.cue(ev, cue::ONBEAT, pos, 0.5, 1.0);\n        }\n        if chain > 0 && chain % 5 == 0 {\n            self.cue(ev, cue::CHAIN, pos, 0.7, 1.0 + chain as f32 * 0.01);\n        }\n        if r == 2 && self.rng.below(4) == 0 {\n            self.callout(\"Clean. Again.\");\n        }\n        r\n    }\n\n    /// One count of the hazard's current stage is done. Returns true if the hazard is gone.\n    fn step_hz(&mut self, hi: usize, s: usize, err: f32, ev: &mut Vec<SimEvent>) -> bool {\n        let pos = self.hz[hi].p;\n        let kind = self.hz[hi].need();\n        let r = if err >= 0.0 { self.award(s, pos, err, ev) } else { 1 };\n        if err >= 0.0 {\n            self.sg[s].last_kind = kind;\n            if self.echo > 0.0 && s == 0 && self.echo_cd <= 0.0 {\n                self.echo_repeat(kind, r, hi, ev);\n            }\n        }\n        self.cov(&format!(\"tool_done:{}\", kind));\n        let h = &mut self.hz[hi];\n        h.cnt += 1;\n        h.prog = 0.0;\n        h.dev = 0.0;\n        h.dev_n = 0.0;\n        h.over = 0.0;\n        h.grabbed = None;\n        if h.cnt >= h.count() {\n            h.si += 1;\n            h.cnt = 0;\n            h.born = self.sbeats as f32;\n            h.stitches.clear();\n            h.last_side = 0;\n            h.last_cross = -9.0;\n            if h.k == Kind::Tumor && h.si == 2 {\n                h.hidden = false;\n            }\n        } else if h.k == Kind::Ember && h.si == 2 {\n            h.ang = h.cnt as f32 * 2.1;\n            h.q = Vec2::from_angle(h.ang);\n        }\n        if h.need() == 0 {\n            let dead = self.hz.remove(hi);\n            self.on_removed(dead, s, ev);\n            true\n        } else {\n            false\n        }\n    }\n\n    fn on_removed(&mut self, h: Hz, s: usize, ev: &mut Vec<SimEvent>) {\n        self.cov(&format!(\"hazard_done:{:?}\", h.k));\n        match h.k {\n            Kind::Nodule => {\n                if h.lvl == 0 && self.case == 3 {\n                    for dx in [-1.2f32, 1.2] {\n                        if let Some(i) = self.spawn_hz(&format!(\"nodule {} {} 1 seen\", (h.p.x + dx).clamp(-7.0, 7.0), h.p.y)) {\n                            self.hz[i].hidden = true;\n                        }\n                    }\n                    self.cov(\"strain:split\");\n                    if !self.woke {\n                        self.wake_gift();\n                    }\n                }\n                self.cue(ev, cue::POP, h.p, 0.9, 1.0);\n                self.push_fx(3, h.p, 1.0);\n            }\n            Kind::Ember => {\n                self.fever = (self.fever - 22.0).max(0.0);\n                self.cue(ev, cue::POP, h.p, 0.9, 0.8);\n                self.push_fx(4, h.p, 1.0);\n            }\n            Kind::Sac => {\n                self.push_fx(5, h.p, 0.5);\n            }\n            Kind::Tumor => {\n                self.push_fx(3, h.p, 1.0);\n            }\n            Kind::Pool | Kind::Burn => {}\n            _ => {}\n        }\n        let _ = s;\n    }\n\n    fn echo_repeat(&mut self, kind: u8, rating: u8, from: usize, ev: &mut Vec<SimEvent>) {\n        // The ghost hands repeat the technique at once on the next valid target for that tool.\n        let src = self.hz.get(from).map(|h| h.p).unwrap_or(Vec2::ZERO);\n        let mut best: Option<(usize, f32)> = None;\n        for (i, h) in self.hz.iter().enumerate() {\n            if h.need() != kind || !self.visible(h) || i == from {\n                continue;\n            }\n            if matches!(h.k, Kind::Nodule | Kind::Eye) {\n                continue;\n            }\n            let d = (h.p - src).length();\n            if best.map(|b| d < b.1).unwrap_or(true) {\n                best = Some((i, d));\n            }\n        }\n        if let Some((i, _)) = best {\n            self.echo_cd = 0.4;\n            let pos = self.hz[i].p;\n            self.sg[3].ghost = Some(pos);\n            self.cov(\"echo_repeat\");\n            let err = [4.0f32, 2.5, 1.5, 0.5][rating as usize];\n            self.cue(ev, cue::GIFT, pos, 0.4, 1.6);\n            self.step_hz_echo(i, err, ev);\n        }\n    }\n\n    fn step_hz_echo(&mut self, hi: usize, err: f32, ev: &mut Vec<SimEvent>) {\n        // Rated for the owner (slot 0) without re-triggering another echo.\n        let saved = self.echo;\n        self.echo = 0.0;\n        self.step_hz(hi, 0, err, ev);\n        self.echo = saved;\n    }\n\n    fn spawn_pop_hz(&mut self, spec: String) {\n        let _ = self.spawn_hz(&spec);\n    }\n\n    fn vitals_hit(&mut self, v: f32) {\n        if self.cheat_immortal || self.attract {\n            return;\n        }\n        self.vitals = (self.vitals - v).clamp(0.0, 100.0);\n    }\n\n    // ---------- the tick ----------\n\n    fn handle_cmd(&mut self, cmd: SurgeryCmd, ev: &mut Vec<SimEvent>) {\n        match cmd {\n            SurgeryCmd::NewGame { step, difficulty } => {\n                self.difficulty = difficulty.min(2);\n                self.total_score = 0;\n                self.attract = false;\n                self.scene = \"campaign\".into();\n                for s in self.sg.iter_mut() {\n                    s.score = 0;\n                }\n                self.enter_step(step);\n            }\n            SurgeryCmd::Retry => {\n                if self.mode == Mode::Dead {\n                    self.retry();\n                }\n            }\n            SurgeryCmd::Restart => {\n                if self.case_def().id == self.case && matches!(self.mode, Mode::Op | Mode::Dead) {\n                    self.cp = None;\n                    let c = self.case;\n                    self.begin_case(c, 0);\n                }\n            }\n            SurgeryCmd::JumpCase(n) => {\n                self.attract = false;\n                self.begin_case(n, 0);\n            }\n            SurgeryCmd::SkipPhase => {\n                if self.mode == Mode::Op {\n                    let p = self.phase + 1;\n                    self.start_phase(p);\n                }\n            }\n            SurgeryCmd::WinCase => {\n                if self.mode == Mode::Op {\n                    self.finish_case();\n                }\n            }\n            SurgeryCmd::ForceCode => {\n                if self.mode == Mode::Op {\n                    self.vitals = 0.0;\n                }\n            }\n            SurgeryCmd::KillPatient => {\n                if self.mode == Mode::Op {\n                    self.codes_left = 0;\n                    self.vitals = 0.0;\n                    self.code_t = 0.001;\n                }\n            }\n            SurgeryCmd::NextStep => {\n                if self.mode == Mode::Results {\n                    let n = self.step + 1;\n                    if self.scene == \"campaign\" {\n                        self.enter_step(n);\n                    } else {\n                        self.mode = Mode::Won;\n                    }\n                }\n            }\n            SurgeryCmd::Spawn(k) => {\n                if let Some((name, _)) = KINDS.get(k as usize) {\n                    let c = self.sg[0].pos;\n                    let spec = match *name {\n                        \"line\" | \"lace\" | \"dress\" => format!(\"{name} {} {} {} {}\", c.x - 2.0, c.y, c.x + 2.0, c.y),\n                        \"pool\" | \"burn\" | \"tumor\" => format!(\"{name} {} {} 1.0\", c.x, c.y),\n                        _ => format!(\"{name} {} {} 0\", c.x, c.y),\n                    };\n                    self.spawn_pop_hz(spec);\n                }\n            }\n            SurgeryCmd::SetSurgeons(n) => {\n                for (i, s) in self.sg.iter_mut().enumerate() {\n                    s.active = i < n as usize;\n                }\n            }\n            SurgeryCmd::Pause(p) => self.paused = p,\n        }\n        let _ = ev;\n    }\n\n    fn do_pre(&mut self, input: &InputFrame, dt0: f32, ev: &mut Vec<SimEvent>) {\n        self.tick = self.tick.wrapping_add(1);\n        if let Some(c) = input.scmd {\n            self.handle_cmd(c, ev);\n        }\n        if self.paused {\n            return;\n        }\n        let dt = dt0 * self.time_scale;\n        self.fx.retain(|f| self.fx_id.saturating_sub(f.id) < 30);\n        if let Some(s) = &mut self.sub {\n            s.t -= dt;\n            if s.t <= 0.0 {\n                self.sub = None;\n            }\n        }\n        if self.banner_t > 0.0 {\n            self.banner_t -= dt;\n        }\n        self.shake = (self.shake - dt * 3.0).max(0.0);\n        self.flash = (self.flash - dt * 2.0).max(0.0);\n        self.plate_t = (self.plate_t + dt / 0.8).min(1.0);\n        match self.mode {\n            Mode::Idle | Mode::Won => {}\n            Mode::Story => self.tick_story(input, dt),\n            Mode::Card => {\n                self.card_t += dt;\n                let adv = self.any_press(input, sbtn::ADVANCE | sbtn::USE);\n                let bot = self.attract || self.sg[0].bot || self.scene == \"mirror\";\n                if (adv && self.card_t > 0.4) || (bot && self.card_t > 1.0) {\n                    let c = self.case;\n                    let step = self.step;\n                    let cp = self.cp.clone();\n                    let _ = cp;\n                    self.begin_case(c, 0);\n                    self.step = step;\n                }\n            }\n            Mode::Results => {\n                self.card_t += dt;\n                let adv = self.any_press(input, sbtn::ADVANCE);\n                if (adv && self.card_t > 3.0) || ((self.attract || self.sg[0].bot) && self.card_t > 4.0) {\n                    self.handle_cmd(SurgeryCmd::NextStep, ev);\n                }\n            }\n            Mode::Dead => {\n                self.card_t += dt;\n                let adv = self.any_press(input, sbtn::ADVANCE | sbtn::USE);\n                if adv && self.card_t > 0.8 {\n                    self.retry();\n                }\n            }\n            Mode::Op => self.tick_op(input, dt, ev),\n        }\n    }\n\n    fn any_press(&self, input: &InputFrame, bit: u16) -> bool {\n        input.surgeons.iter().any(|s| s.pressed & bit != 0)\n    }\n\n    fn tick_story(&mut self, input: &InputFrame, dt: f32) {\n        let content = self.content();\n        let Some(sc) = content.scenes.iter().find(|s| s.id == self.story) else {\n            self.enter_step(self.step + 1);\n            return;\n        };\n        let Some(line) = sc.line.get(self.line as usize) else {\n            self.enter_step(self.step + 1);\n            return;\n        };\n        let len = line.text.chars().count() as f32;\n        let speed = 48.0;\n        let skip = input.surgeons.iter().any(|s| s.held & sbtn::SKIP != 0);\n        self.typed = (self.typed + dt * speed * if skip { 8.0 } else { 1.0 }).min(len);\n        self.card_t += dt;\n        let adv = self.any_press(input, sbtn::ADVANCE | sbtn::USE);\n        let auto = (self.attract || self.sg[0].bot) && self.typed >= len && self.card_t > 0.5 + len * 0.012;\n        if adv {\n            if self.typed < len {\n                self.typed = len;\n            } else {\n                self.next_line(sc.line.len());\n            }\n        } else if auto || (skip && self.typed >= len) {\n            self.next_line(sc.line.len());\n        }\n    }\n\n    fn next_line(&mut self, n: usize) {\n        self.line += 1;\n        self.typed = 0.0;\n        self.card_t = 0.0;\n        if self.line as usize >= n {\n            if self.attract && self.scene == \"attract\" {\n                self.start_attract_seg(self.seg + 1);\n            } else {\n                let s = self.step + 1;\n                self.enter_step(s);\n            }\n        }\n    }\n\n    pub fn story_line(&self) -> Option<(Scene, Line)> {\n        let c = self.content();\n        let sc = c.scenes.iter().find(|s| s.id == self.story)?;\n        let l = sc.line.get(self.line as usize)?;\n        Some((sc.clone(), l.clone()))\n    }\n\n    // Attract mode: ~25 s segments cycling through the demo.\n    pub fn start_attract_seg(&mut self, i: u8) {\n        let segs: [(u8, i32); 7] = [(3, 1), (4, 0), (5, 1), (7, 4), (8, 0), (0, 3), (6, 0)];\n        let n = (i as usize) % (segs.len() + 1);\n        self.seg = n as u8;\n        self.seg_t = 0.0;\n        self.attract = true;\n        for s in self.sg.iter_mut() {\n            s.bot = true;\n        }\n        if n == segs.len() {\n            self.mode = Mode::Story;\n            self.story = \"s3b\".into();\n            self.line = 0;\n            self.typed = 0.0;\n            self.card_t = 0.0;\n            return;\n        }\n        let (c, p) = segs[n];\n        self.case = c;\n        self.begin_case(c, p);\n        let count = if c == 8 { 4 } else if c == 7 { 2 } else { 1 };\n        for (k, s) in self.sg.iter_mut().enumerate() {\n            s.active = k < count;\n            s.bot = true;\n            s.unlocked_gift = true;\n            s.gift = 100.0;\n        }\n        self.vitals = 100.0;\n        self.banner_t = 0.0;\n    }\n\n    fn tick_op(&mut self, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        let ws = self.world_scale();\n        let dtw = dt * ws;\n        self.t += dt;\n        self.phase_t += dtw;\n        self.echo_cd = (self.echo_cd - dt).max(0.0);\n        if self.attract {\n            self.seg_t += dt;\n            self.vitals = self.vitals.max(40.0);\n            if self.seg_t > 26.0 {\n                let n = self.seg + 1;\n                self.start_attract_seg(n);\n                return;\n            }\n        }\n        // Subtitles from the phase script.\n        let mut fire = vec![];\n        for s in self.says.iter_mut() {\n            s.0 -= dt;\n            if s.0 <= 0.0 && s.0 > -100.0 {\n                fire.push((s.1.clone(), s.2.clone()));\n                s.0 = -1000.0;\n            }\n        }\n        for (w, t) in fire {\n            self.say(&w, &t);\n        }\n        // Heart.\n        let base = lerp(72.0, 148.0, 1.0 - self.vitals / 100.0);\n        let coup = self.tune.get(\"coupling\");\n        self.bpm = 72.0 + (base - 72.0) * coup;\n        if self.code_t > 0.0 {\n            self.bpm = 0.0;\n        } else {\n            self.beat += self.bpm / 60.0 * dtw;\n        }\n        self.beat_now = false;\n        if self.beat >= 1.0 {\n            self.beat -= 1.0;\n            self.beats += 1;\n            self.beat_now = true;\n            self.cue(ev, cue::LUBDUB, Vec2::ZERO, 0.5, 1.0 + (self.bpm - 72.0) * 0.002);\n            if self.hush > 0.0 {\n                self.hush -= 1.0;\n                if self.hush <= 0.0 {\n                    self.hush = 0.0;\n                    self.cue(ev, cue::HUSH_END, Vec2::ZERO, 0.7, 1.0);\n                }\n            }\n        }\n        let sbpm = self.bpm.min(72.0 * 1.4);\n        self.sbeat += sbpm / 60.0 * dtw * self.strain_mul();\n        self.sbeat_now = false;\n        if self.sbeat >= 1.0 {\n            self.sbeat -= 1.0;\n            self.sbeats += 1;\n            self.sbeat_now = true;\n        }\n        if self.echo > 0.0 {\n            self.echo -= dt;\n            if self.echo <= 0.0 {\n                self.echo = 0.0;\n                self.sg[3].ghost = None;\n            }\n        }\n        for s in self.sg.iter_mut() {\n            s.chain_t += dt;\n            if s.chain > 0 && s.chain_t > self.tune.get(\"chain_window\") {\n                s.chain = 0;\n            }\n            s.recoil = (s.recoil - dt * 3.0).max(0.0);\n            s.iv_cd = (s.iv_cd - dt).max(0.0);\n            s.wrong_cd = (s.wrong_cd - dt).max(0.0);\n            s.cut_cd = (s.cut_cd - dt).max(0.0);\n        }\n        self.pops.retain_mut(|p| {\n            p.t += dt;\n            p.t < 1.3\n        });\n        // Code (cardiac arrest).\n        if self.code_t > 0.0 {\n            self.tick_code(input, dt, ev);\n            return;\n        }\n        // Surgeons.\n        let ins = self.gather_inputs(input);\n        for s in 0..4 {\n            if self.sg[s].active {\n                self.tick_surgeon(s, &ins[s], dt, ev);\n            }\n        }\n        // Gifts need real time too.\n        for s in 0..4 {\n            if self.sg[s].active {\n                self.tick_gift(s, &ins[s], dt, ev);\n            }\n        }\n        // Hazards.\n        self.tick_hazards(dtw, ev);\n        // Vitals.\n        let mut drain = 0.0;\n        for h in &self.hz {\n            if !h.hidden || h.reveal > 0.0 || h.k == Kind::Pool {\n                drain += h.drain();\n            } else {\n                drain += h.drain() * 0.5;\n            }\n        }\n        if self.fever > 100.0 {\n            drain += 6.0 / self.diff_drain().max(0.1);\n        }\n        if self.case == 0 {\n            drain *= 0.7;\n        }\n        if self.mode == Mode::Op {\n            let d = drain * self.tune.get(\"drain\") * self.diff_drain() * dtw;\n            self.vitals_hit(d);\n        }\n        if self.attract {\n            self.vitals = self.vitals.max(40.0);\n        }\n        if !self.cheat_freeze && !self.attract {\n            self.time_left -= dtw;\n        }\n        // Low vitals warning.\n        if self.vitals < 30.0 && self.beat_now {\n            self.cue(ev, cue::BEEP, Vec2::ZERO, 0.4, 1.4);\n        }\n        // Code?\n        if self.vitals <= 0.0 && self.code_t <= 0.0 && self.mode == Mode::Op {\n            if self.codes_left > 0 || self.case == 8 {\n                self.codes_left -= 1;\n                self.start_code(false, ev);\n            } else {\n                self.die(ev);\n                return;\n            }\n        }\n        if self.time_left <= 0.0 && self.mode == Mode::Op {\n            if self.case_def().director {\n                self.finish_case();\n            } else {\n                self.die(ev);\n                return;\n            }\n        }\n        // Director (Code Blue).\n        if self.case_def().director {\n            self.tick_director(dtw);\n        }\n        // Phase done?\n        if self.mode == Mode::Op {\n            self.check_phase(dtw);\n        }\n    }\n\n    fn start_code(&mut self, scripted: bool, ev: &mut Vec<SimEvent>) {\n        self.code_t = if scripted { 15.0 } else { self.tune.get(\"code_window\") };\n        self.code_scripted = scripted;\n        self.ghost_phase = 0.0;\n        self.banner = \"CODE\".into();\n        self.banner_t = 1.5;\n        self.hush = 0.0;\n        self.echo = 0.0;\n        for s in self.sg.iter_mut() {\n            s.charge = 0.0;\n        }\n        self.cue(ev, cue::FLATLINE, Vec2::ZERO, 0.6, 1.0);\n        self.cov(if scripted { \"code:scripted\" } else { \"code\" });\n        if !scripted {\n            self.callout(\"Vitals at zero. Defibrillate. Now!\");\n        }\n    }\n\n    fn tick_code(&mut self, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        self.flat += dt;\n        self.code_t -= dt;\n        self.ghost_phase = (self.ghost_phase + dt) % 1.0;\n        let ins = self.gather_inputs(input);\n        let mut shocked = false;\n        for s in 0..4 {\n            if !self.sg[s].active {\n                continue;\n            }\n            let held = ins[s].held & sbtn::DEFIB != 0;\n            let sg = &mut self.sg[s];\n            if held {\n                sg.charge += dt;\n                if sg.charge < 0.05 + dt {\n                    // charge whine starts\n                }\n            } else if sg.charge > 0.0 {\n                let ok = sg.charge >= 1.2 && (self.ghost_phase - 0.5).abs() <= 0.14 || (self.ghost_phase - 0.5).abs() <= 0.14 && sg.charge >= 1.1;\n                sg.charge = 0.0;\n                if ok {\n                    shocked = true;\n                    sg.score += 300;\n                    self.pops.push(Pop { pos: Vec2::ZERO, rating: 3, t: 0.0, on_beat: true, chain: 0, seat: s as u8 });\n                } else {\n                    self.cue(ev, cue::WRONG, Vec2::ZERO, 0.6, 0.6);\n                }\n            }\n            if held && self.sg[s].charge > 0.0 && self.sg[s].charge < dt * 1.5 {\n                self.cue(ev, cue::DEFIB_WHINE, Vec2::ZERO, 0.6, 1.0);\n            }\n        }\n        if shocked {\n            self.cue(ev, cue::DEFIB_THUMP, Vec2::ZERO, 1.0, 1.0);\n            self.push_fx(6, Vec2::ZERO, 1.0);\n            self.shake = 1.0;\n            self.flash = 1.0;\n            self.vitals = if self.code_scripted && self.shocks_left > 1 { 8.0 } else { 30.0 };\n            self.code_t = 0.0;\n            self.flat = 0.0;\n            self.cov(\"defib_success\");\n            if self.shocks_left > 0 {\n                self.shocks_left -= 1;\n                if self.shocks_left > 0 {\n                    self.dir_t = 3.0;\n                }\n            }\n        } else if self.code_t <= 0.0 {\n            self.code_t = 0.0;\n            self.vitals = 0.0;\n            self.die(ev);\n        }\n    }\n\n    fn tick_director(&mut self, dtw: f32) {\n        let n = self.surgeon_count().max(1) as f32;\n        let tempo = 1.0 + (self.t / 30.0).floor() * 0.18;\n        self.dir_t -= dtw * tempo;\n        if self.dir_t <= 0.0 {\n            self.dir_t = 7.0;\n            let budget = ((0.6 + 0.4 * n) * 3.0).round() as i32;\n            let late = self.t > 190.0;\n            for _ in 0..budget.min(6) {\n                if self.hz.len() >= 14 {\n                    break;\n                }\n                let p = self.rand_pos();\n                let roll = self.rng.below(100);\n                let spec = if late && roll < 30 {\n                    format!(\"nodule {} {} 2 seen\", p.x, p.y)\n                } else if roll < 22 {\n                    format!(\"pool {} {} 0.9\", p.x, p.y)\n                } else if roll < 40 {\n                    format!(\"hook {} {} {}\", p.x, p.y, self.rng.range(0.0, 360.0))\n                } else if roll < 58 {\n                    format!(\"polyp {} {}\", p.x, p.y)\n                } else if roll < 72 {\n                    format!(\"lace {} {} {} {}\", p.x - 1.5, p.y, p.x + 1.5, p.y + 0.5)\n                } else if roll < 84 {\n                    format!(\"bleeder {} {}\", p.x, p.y)\n                } else if roll < 93 {\n                    format!(\"burn {} {} 1.0\", p.x, p.y)\n                } else {\n                    format!(\"sac {} {} 11\", p.x, p.y)\n                };\n                let id = self.next_id;\n                if let Some(i) = self.spawn_hz(&spec) {\n                    if self.hz[i].k == Kind::Nodule {\n                        self.hz[i].hidden = false;\n                    }\n                }\n                let _ = id;\n            }\n        }\n    }\n\n    fn check_phase(&mut self, dtw: f32) {\n        let c = self.case_def();\n        if c.director {\n            return;\n        }\n        let Some(ph) = c.phase.get(self.phase as usize) else { return };\n        // rhythm: feed pending strokes on the beat\n        if ph.rhythm && !self.pending.is_empty() && self.sbeat_now && self.sbeats % 2 == 0 && self.hz.len() < 2 {\n            let spec = self.pending.remove(0);\n            self.spawn_pop_hz(spec);\n        }\n        if ph.shocks > 0 {\n            if self.shocks_left > 0 {\n                if self.code_t <= 0.0 {\n                    self.dir_t -= dtw;\n                    if self.dir_t <= 0.0 {\n                        self.vitals = 0.0;\n                        self.start_code(true, &mut vec![]);\n                    }\n                }\n                return;\n            }\n        }\n        let clear = self.hz.is_empty() && self.pending.is_empty();\n        if clear && self.phase_t > 0.5 {\n            self.clear_t += dtw;\n            if self.clear_t > 0.9 {\n                if let Some(pn) = &ph.plate_next {\n                    self.plate_prev = self.plate.clone();\n                    self.plate = pn.clone();\n                    self.plate_t = 0.0;\n                }\n                let n = self.phase + 1;\n                self.start_phase(n);\n            }\n        } else {\n            self.clear_t = 0.0;\n        }\n    }\n\n    fn gather_inputs(&mut self, input: &InputFrame) -> [SurgeonInput; 4] {\n        let mut out = input.surgeons;\n        for s in 0..4 {\n            if self.attract || self.sg[s].bot {\n                if self.sg[s].active {\n                    out[s] = bot::bot_slot(self, s);\n                }\n            } else if out[s].active && !self.sg[s].active && self.mode == Mode::Op {\n                self.sg[s].active = true;\n            }\n        }\n        out\n    }\n\n    fn tick_surgeon(&mut self, s: usize, inp: &SurgeonInput, dt: f32, ev: &mut Vec<SimEvent>) {\n        // Cursor.\n        let aim = Vec2::new(inp.aim.x.clamp(-FIELD_X, FIELD_X), inp.aim.y.clamp(-4.6, 4.8));\n        let mut pos = aim;\n        let tremor = self.case_def().surgeon == \"pet\" || (self.case == 7 && s == 1);\n        if tremor && self.tremor_on && self.echo <= 0.0 && inp.held & sbtn::PRECISION == 0 && !self.sg[s].bot {\n            let t = self.t;\n            pos += Vec2::new((t * 1.7).sin() + 0.5 * (t * 4.1).sin(), (t * 2.3).cos() + 0.5 * (t * 3.3).cos()) * 0.07;\n        }\n        self.sg[s].prev = self.sg[s].pos;\n        // Aim assist (pad / keyboard cursor only).\n        let assist = self.tune.get(\"assist\") * self.assist_user;\n        let moved_vec = pos - self.sg[s].prev;\n        if inp.assist && assist > 0.0 && moved_vec.length() > 0.002 {\n            let kind = self.effective_kind(s);\n            if let Some(i) = self.find(pos, kind, 1.2) {\n                let tgt = self.hz[i].p;\n                let tgt = if self.hz[i].is_line() {\n                    // nearest point on the line\n                    let (a, b) = (self.hz[i].p, self.hz[i].q);\n                    let ab = b - a;\n                    let t = ((pos - a).dot(ab) / ab.length_squared().max(1e-4)).clamp(0.0, 1.0);\n                    a + ab * t\n                } else {\n                    tgt\n                };\n                let pull = (tgt - pos).clamp_length_max(3.0 * dt * assist);\n                pos += pull;\n            }\n        }\n        self.sg[s].moved = (pos - self.sg[s].prev).length();\n        self.sg[s].pos = pos;\n        // Instrument selection.\n        if inp.tool >= 1 && inp.tool <= 8 && inp.tool != self.sg[s].tool && self.ring_unlocked(inp.tool) {\n            self.sg[s].tool = inp.tool;\n            self.sg[s].target = None;\n            self.sg[s].heat = 0.0;\n            self.sg[s].dose = 0.0;\n            self.sg[s].charge = 0.0;\n            self.release_grab(s);\n            let p = self.sg[s].pos;\n            self.cue(ev, cue::PICK, p, 0.6, 0.8 + inp.tool as f32 * 0.07);\n            self.cov(&format!(\"pick:{}\", self.kind_of(inp.tool)));\n        }\n        let held = inp.held & sbtn::USE != 0 || inp.pressure > 0.25;\n        let pressed = held && !self.sg[s].held;\n        self.sg[s].held_prev = self.sg[s].held;\n        self.sg[s].held = held;\n        if inp.pressed & sbtn::CANCEL != 0 {\n            self.release_grab(s);\n            self.sg[s].target = None;\n        }\n        let kind = self.effective_kind(s);\n        let pressure = if inp.pressure > 0.0 { inp.pressure.clamp(0.2, 1.0) } else { 1.0 };\n        match kind {\n            SCALPEL => self.do_scalpel(s, held, dt, ev),\n            FORCEPS => self.do_forceps(s, held, pressed, inp, dt, ev),\n            SUTURE => self.do_suture(s, held, dt, ev),\n            SUCTION => self.do_suction(s, held, pressure, dt, ev),\n            LASER | CRYO => self.do_laser(s, kind, held, dt, ev),\n            GEL => self.do_gel(s, held, dt, ev),\n            SCAN => self.do_scan(s, held, dt, ev),\n            IV => self.do_iv(s, held, dt, ev),\n            DRESS => self.do_dress(s, held, dt, ev),\n            _ => {}\n        }\n        if pressed {\n            self.wrong_tool_check(s, kind, ev);\n        }\n    }\n\n    fn effective_kind(&self, s: usize) -> u8 {\n        let k = self.kind_of(self.sg[s].tool);\n        // Dressing is a context tool: auto-selected once only the closure is left.\n        let only_dress = !self.hz.is_empty() && self.hz.iter().all(|h| h.k == Kind::Dress);\n        if only_dress { DRESS } else { k }\n    }\n\n    fn release_grab(&mut self, s: usize) {\n        for h in self.hz.iter_mut() {\n            if h.grabbed == Some(s as u8) {\n                h.grabbed = None;\n            }\n        }\n    }\n\n    fn wrong_tool_check(&mut self, s: usize, kind: u8, ev: &mut Vec<SimEvent>) {\n        if matches!(kind, SCAN | IV) {\n            return;\n        }\n        let c = self.sg[s].pos;\n        let mut near = false;\n        for h in &self.hz {\n            if self.visible(h) && h.need() != kind && h.dist(c) < 0.25 && !(kind == SUCTION && h.k == Kind::Pool) {\n                near = true;\n            }\n        }\n        if near && self.sg[s].wrong_cd <= 0.0 && self.find(c, kind, 0.4).is_none() {\n            self.sg[s].wrong_cd = 2.0;\n            self.sg[s].chain = 0;\n            self.cue(ev, cue::WRONG, c, 0.6, 1.0);\n            self.callout(\"Wrong instrument, Doctor.\");\n            let pen = self.tune.get(\"wrong_pen\");\n            self.vitals_hit(pen);\n            self.cov(\"wrong_tool\");\n        }\n    }\n\n    fn do_scalpel(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        let c = self.sg[s].pos;\n        if !held {\n            self.sg[s].target = None;\n            return;\n        }\n        // Engaged target?\n        let tgt = self.sg[s].target.and_then(|id| self.hz_index(id));\n        let hi = match tgt {\n            Some(i) => i,\n            None => {\n                // Must start near the stroke's beginning.\n                let mut found = None;\n                for (i, h) in self.hz.iter().enumerate() {\n                    if h.need() != SCALPEL || !self.visible(h) || (h.k == Kind::Eye && h.aux > 0.5) {\n                        continue;\n                    }\n                    let (a, _) = Self::stroke(h);\n                    let startd = (c - a).length();\n                    if startd < 0.9 + h.prog * 6.0 {\n                        found = Some(i);\n                        break;\n                    }\n                }\n                match found {\n                    Some(i) => {\n                        let id = self.hz[i].id;\n                        self.sg[s].target = Some(id);\n                        i\n                    }\n                    None => {\n                        // Healthy tissue.\n                        if self.sg[s].cut_cd <= 0.0 && self.sg[s].moved > 0.02 && self.find(c, SCALPEL, 1.0).is_none() {\n                            self.sg[s].cut_cd = 1.6;\n                            self.sg[s].chain = 0;\n                            self.mistakes += 1;\n                            self.vitals_hit(1.5);\n                            self.cue(ev, cue::SLICE, c, 0.5, 0.7);\n                            self.push_fx(2, c, 0.5);\n                            let spec = format!(\"lace {} {} {} {}\", c.x, c.y, c.x + 0.6, c.y + 0.1);\n                            self.spawn_pop_hz(spec);\n                            self.callout(\"Doctor, that's healthy tissue.\");\n                            self.cov(\"healthy_cut\");\n                        }\n                        return;\n                    }\n                }\n            }\n        };\n        let (a, b) = Self::stroke(&self.hz[hi]);\n        let ab = b - a;\n        let l = ab.length().max(0.01);\n        let dir = ab / l;\n        let t = ((c - a).dot(dir) / l).clamp(0.0, 1.0);\n        let dev = (c - (a + dir * (t * l))).length();\n        if dev > 1.3 {\n            // Slipped off the line: lift.\n            self.sg[s].target = None;\n            return;\n        }\n        let power = self.tune.get(\"power\");\n        // Rail assist is done in aim assist; here: progress only moves forward.\n        let h = &mut self.hz[hi];\n        if t > h.prog && t - h.prog < 0.35 * power.max(1.0) {\n            h.prog = t;\n            h.dev += dev;\n            h.dev_n += 1.0;\n            let _ = dt;\n        }\n        let prog = h.prog;\n        self.sg[s].recoil = self.sg[s].recoil.max(0.15);\n        if (self.tick % 6) == 0 {\n            self.push_fx(1, c, 0.3);\n            self.cue(ev, cue::SLICE, c, 0.25, 1.0 + prog * 0.3);\n        }\n        if prog >= 0.97 {\n            let avg = if self.hz[hi].dev_n > 0.0 { self.hz[hi].dev / self.hz[hi].dev_n } else { 0.5 };\n            self.sg[s].target = None;\n            self.cov(\"rated:scalpel\");\n            self.step_hz(hi, s, avg / 0.25, ev);\n        }\n    }\n\n    fn do_forceps(&mut self, s: usize, held: bool, pressed: bool, inp: &SurgeonInput, dt: f32, ev: &mut Vec<SimEvent>) {\n        let c = self.sg[s].pos;\n        // Rotate a held bone.\n        let rot = (if inp.held & sbtn::ROT_R != 0 { 1.0 } else { 0.0 }) - (if inp.held & sbtn::ROT_L != 0 { 1.0 } else { 0.0 });\n        let grabbed = self.hz.iter().position(|h| h.grabbed == Some(s as u8));\n        if !held {\n            if let Some(i) = grabbed {\n                // Dropped. A bone snaps if it was brought home.\n                if self.hz[i].k == Kind::Bone {\n                    self.try_snap_bone(i, s, ev);\n                }\n                self.hz[i].grabbed = None;\n            }\n            return;\n        }\n        if grabbed.is_none() {\n            if pressed || !self.sg[s].held_prev {\n                if let Some(i) = self.find(c, FORCEPS, 0.45) {\n                    if self.hz[i].k == Kind::Nodule && self.hz[i].hidden && self.hz[i].reveal <= 0.0 {\n                        return;\n                    }\n                    self.hz[i].grabbed = Some(s as u8);\n                    self.sg[s].gp = c;\n                    self.cue(ev, cue::FORCEPS, c, 0.6, 1.0);\n                }\n            }\n            return;\n        }\n        let i = grabbed.unwrap();\n        let k = self.hz[i].k;\n        if k == Kind::Bone {\n            self.hz[i].p = c;\n            self.hz[i].ang += rot * 1.9 * dt;\n            return;\n        }\n        let gp = self.sg[s].gp;\n        let v = c - gp;\n        let len = v.length();\n        let axis = Vec2::from_angle(self.hz[i].ang);\n        let need = if k == Kind::Tendril { 2.2 } else { 1.0 } / self.tune.get(\"power\").max(0.3);\n        if k == Kind::Tendril && self.case == 7 {\n            // Tug-of-war with the pulse: only diastole (beat phase > 0.45) lets it come.\n            let fwd = ((c - self.sg[s].prev).dot(axis)).max(0.0);\n            let diastole = self.beat > 0.45;\n            let h = &mut self.hz[i];\n            if diastole {\n                h.prog += fwd / need;\n            } else {\n                h.prog = (h.prog - 0.5 * dt).max(0.0);\n                if fwd > 0.02 {\n                    h.prog = (h.prog - fwd * 0.8 / need).max(0.0);\n                }\n            }\n            let done = h.prog >= 1.0;\n            if done {\n                self.sg[s].chain = self.sg[s].chain;\n                self.cov(\"tendril_pull\");\n                self.step_hz(i, s, 0.8, ev);\n            }\n            return;\n        }\n        if len >= need {\n            let ang_err = {\n                let d = v.normalize_or_zero();\n                let dot = d.dot(axis).abs().clamp(0.0, 1.0);\n                dot.acos().to_degrees()\n            };\n            if ang_err > 40.0 && k == Kind::Hook {\n                // Yanked off-axis: it tears.\n                let spec = format!(\"lace {} {} {} {}\", self.hz[i].p.x, self.hz[i].p.y, self.hz[i].p.x + 0.8, self.hz[i].p.y + 0.3);\n                self.spawn_pop_hz(spec);\n                self.mistakes += 1;\n                self.vitals_hit(2.0);\n                self.cov(\"forceps_tear\");\n            }\n            self.sg[s].gp = c;\n            self.cov(\"rated:forceps\");\n            self.step_hz(i, s, ang_err / 8.0, ev);\n            self.cue(ev, cue::POP, c, 0.7, 1.0);\n        }\n    }\n\n    fn try_snap_bone(&mut self, i: usize, s: usize, ev: &mut Vec<SimEvent>) {\n        let h = &self.hz[i];\n        let d = (h.p - h.q).length();\n        let a = {\n            let x = (h.ang - h.goal).rem_euclid(std::f32::consts::PI);\n            x.min(std::f32::consts::PI - x).to_degrees()\n        };\n        if d < 0.35 && a < 12.0 {\n            let err = (d / 0.12).max(a / 4.0);\n            self.hz[i].p = self.hz[i].q;\n            self.hz[i].ang = self.hz[i].goal;\n            self.cov(\"bone_snap\");\n            self.cue(ev, cue::POP, self.hz[i].p, 0.8, 0.7);\n            self.step_hz(i, s, err, ev);\n        }\n    }\n\n    fn do_suture(&mut self, s: usize, held: bool, _dt: f32, ev: &mut Vec<SimEvent>) {\n        if !held {\n            self.sg[s].target = None;\n            return;\n        }\n        let c = self.sg[s].pos;\n        let assist = self.tune.get(\"assist\") * self.assist_user;\n        let reach = if self.sg[s].tool > 0 { 0.9 + 0.4 * assist } else { 0.9 };\n        let t = self.t;\n        // Find a target: a lace (needle position) / bleeder / bone wire.\n        let mut best: Option<usize> = None;\n        for (i, h) in self.hz.iter().enumerate() {\n            if h.need() != SUTURE || !self.visible(h) {\n                continue;\n            }\n            let (needle, _) = Self::needle(h);\n            if (c - needle).length() < reach + if h.k == Kind::Lace { 0.0 } else { 0.4 } {\n                best = Some(i);\n                break;\n            }\n        }\n        let Some(i) = best else { return };\n        let (needle, axis) = Self::needle(&self.hz[i]);\n        let perp = Vec2::new(-axis.y, axis.x);\n        let lat = (c - needle).dot(perp);\n        let side: i8 = if lat > 0.18 {\n            1\n        } else if lat < -0.18 {\n            -1\n        } else {\n            0\n        };\n        let h = &mut self.hz[i];\n        if side != 0 {\n            if h.last_side != 0 && h.last_side != side {\n                // A crossing.\n                let k = h.k;\n                if k == Kind::Lace {\n                    let f = if h.len() > 0.01 { (needle - h.p).length() / h.len() } else { 0.0 };\n                    h.stitches.push(f);\n                    h.last_cross = t;\n                    self.cue(ev, cue::ZIP, c, 0.5, 1.0 + h.stitches.len() as f32 * 0.02);\n                    self.push_fx(7, needle, 0.3);\n                    let done = self.hz[i].cnt as usize + 1 >= self.hz[i].count() as usize;\n                    if done {\n                        let err = self.suture_error(i);\n                        self.cov(\"rated:suture\");\n                        self.step_hz(i, s, err, ev);\n                    } else {\n                        self.hz[i].cnt += 1;\n                    }\n                } else {\n                    // Bleeder / wire: crossings must come quickly.\n                    if h.last_cross > 0.0 && t - h.last_cross > 1.4 {\n                        h.cnt = 0;\n                    }\n                    h.last_cross = t;\n                    let dur = h.dev;\n                    let _ = dur;\n                    self.cue(ev, cue::ZIP, c, 0.5, 1.2);\n                    self.push_fx(7, needle, 0.3);\n                    let done = self.hz[i].cnt as usize + 1 >= self.hz[i].count() as usize;\n                    if done {\n                        self.cov(\"rated:suture\");\n                        self.hz[i].cnt = self.hz[i].count() - 1;\n                        let started = self.hz[i].aux;\n                        let _ = started;\n                        self.step_hz(i, s, 1.4, ev);\n                    } else {\n                        self.hz[i].cnt += 1;\n                    }\n                }\n            }\n            if let Some(h) = self.hz.get_mut(i) {\n                h.last_side = side;\n            }\n        }\n    }\n\n    /// Where the next stitch goes, and the direction of the wound.\n    fn needle(h: &Hz) -> (Vec2, Vec2) {\n        match h.k {\n            Kind::Lace => {\n                let n = h.count().max(1) as f32;\n                let f = (h.cnt as f32 + 0.5) / n;\n                let ab = h.q - h.p;\n                (h.p + ab * f, ab.normalize_or(Vec2::X))\n            }\n            _ => (h.p, Vec2::X),\n        }\n    }\n\n    fn suture_error(&self, i: usize) -> f32 {\n        let h = &self.hz[i];\n        // Evenness of the stitches' spacing along the wound.\n        let n = h.stitches.len().max(1) as f32;\n        let mut sd = 0.0;\n        let mean = h.stitches.iter().sum::<f32>() / n;\n        for f in &h.stitches {\n            sd += (f - mean).powi(2);\n        }\n        let _ = sd;\n        let mut gaps = vec![];\n        let mut last = 0.0;\n        for f in &h.stitches {\n            gaps.push((f - last) * h.len());\n            last = *f;\n        }\n        let gm = gaps.iter().sum::<f32>() / gaps.len().max(1) as f32;\n        let var = gaps.iter().map(|g| (g - gm).powi(2)).sum::<f32>() / gaps.len().max(1) as f32;\n        var.sqrt() / 0.18\n    }\n\n    fn do_suction(&mut self, s: usize, held: bool, pressure: f32, dt: f32, ev: &mut Vec<SimEvent>) {\n        if !held {\n            return;\n        }\n        let c = self.sg[s].pos;\n        let power = self.tune.get(\"power\");\n        let mut hit = None;\n        for (i, h) in self.hz.iter().enumerate() {\n            if h.need() == SUCTION && (c - h.p).length() < h.r * (1.0 - h.prog * 0.6) + 0.35 {\n                hit = Some(i);\n                break;\n            }\n        }\n        let Some(i) = hit else { return };\n        let h = &mut self.hz[i];\n        let rate = (0.5 + 0.9 * pressure) * power / (0.9 + h.r * h.r * 0.8);\n        h.prog += rate * dt;\n        self.sg[s].recoil = self.sg[s].recoil.max(0.2);\n        if self.tick % 9 == 0 {\n            self.cue(ev, cue::GURGLE, c, 0.15 + 0.35 * pressure, 0.8 + pressure * 0.5);\n            self.push_fx(8, c, 0.3);\n        }\n        if self.hz[i].prog >= 1.0 {\n            self.cov(\"rated:suction\");\n            self.step_hz(i, s, 2.5, ev);\n        }\n    }\n\n    fn do_laser(&mut self, s: usize, kind: u8, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        let c = self.sg[s].pos;\n        let power = self.tune.get(\"power\");\n        if held {\n            let hi = self.sg[s].target.and_then(|id| self.hz_index(id)).filter(|&i| self.hz[i].need() == kind).or_else(|| {\n                self.find(c, kind, 0.25)\n            });\n            let Some(i) = hi else {\n                // Burning nothing: a lasing hum only.\n                if self.tick % 20 == 0 {\n                    self.cue(ev, cue::LASER, c, 0.2, 0.7);\n                }\n                return;\n            };\n            if (c - self.hz[i].p).length() > self.hz[i].r + 0.4 {\n                self.sg[s].target = None;\n                self.sg[s].heat = 0.0;\n                return;\n            }\n            self.sg[s].target = Some(self.hz[i].id);\n            let (t_full, auto) = match self.hz[i].k {\n                Kind::Sac => (0.6, true),\n                Kind::Nodule if self.hz[i].lvl == 1 => (0.72, false),\n                _ => (if kind == CRYO { 1.0 } else { 1.2 }, false),\n            };\n            let t_full = t_full * self.tune.get(\"strain_tough\").max(0.3) / power;\n            self.sg[s].heat += dt / t_full;\n            self.sg[s].recoil = self.sg[s].recoil.max(0.3);\n            if self.tick % 8 == 0 {\n                self.cue(ev, if kind == CRYO { cue::FROST } else { cue::LASER }, c, 0.3, 0.9 + self.sg[s].heat * 0.5);\n                self.push_fx(if kind == CRYO { 9 } else { 10 }, c, self.sg[s].heat);\n            }\n            if auto && self.sg[s].heat >= 1.0 {\n                self.sg[s].heat = 0.0;\n                self.sg[s].target = None;\n                self.cov(\"rated:laser\");\n                self.step_hz(i, s, 1.5, ev);\n            } else if self.sg[s].heat > 1.05 {\n                // Overheat.\n                self.sg[s].heat = 0.0;\n                self.sg[s].target = None;\n                self.sg[s].chain = 0;\n                self.mistakes += 1;\n                self.vitals_hit(3.0);\n                let (x, y) = (c.x, c.y);\n                self.spawn_pop_hz(format!(\"burn {x} {y} 0.5\"));\n                self.cue(ev, cue::SIZZLE, c, 0.7, 1.0);\n                self.cov(\"overheat\");\n            }\n        } else if self.sg[s].heat > 0.0 {\n            let heat = self.sg[s].heat;\n            let tgt = self.sg[s].target.and_then(|id| self.hz_index(id));\n            self.sg[s].heat = 0.0;\n            self.sg[s].target = None;\n            if let Some(i) = tgt {\n                if heat >= 0.8 && heat <= 1.05 {\n                    let err = (heat - 0.9).abs() / 0.03;\n                    self.cov(\"rated:laser\");\n                    if kind == CRYO {\n                        self.hz[i].frost = 1.0;\n                    }\n                    self.step_hz(i, s, err, ev);\n                }\n            }\n        }\n    }\n\n    fn do_gel(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        let c = self.sg[s].pos;\n        if !held {\n            self.sg[s].flow = (self.sg[s].flow + 0.55 * dt).min(1.0);\n            return;\n        }\n        if self.sg[s].flow <= 0.02 {\n            return;\n        }\n        self.sg[s].flow = (self.sg[s].flow - 0.28 * dt).max(0.0);\n        let power = self.tune.get(\"power\");\n        let moved = (self.sg[s].moved / (dt * 1.5)).clamp(0.0, 1.0);\n        let hi = self.find(c, GEL, 0.15);\n        if self.tick % 5 == 0 {\n            self.cue(ev, cue::GEL, c, 0.2, 1.0);\n            self.push_fx(11, c, 0.3);\n        }\n        match hi {\n            Some(i) => {\n                let r = self.hz[i].r;\n                let h = &mut self.hz[i];\n                h.prog += dt * (0.25 + 0.75 * moved) * power / (0.9 + r * 0.6);\n                if h.prog >= 1.0 {\n                    let o = self.sg[s].over;\n                    let frac = o / (o + 1.2);\n                    self.sg[s].over = 0.0;\n                    self.sg[s].flow = (self.sg[s].flow + 0.4).min(1.0);\n                    self.cov(\"rated:gel\");\n                    self.step_hz(i, s, frac / 0.12, ev);\n                }\n            }\n            None => self.sg[s].over += dt,\n        }\n    }\n\n    fn do_scan(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        if !held {\n            return;\n        }\n        let c = self.sg[s].pos;\n        if self.tick % 18 == 0 {\n            self.cue(ev, cue::PING, c, 0.3, 1.0);\n            self.push_fx(12, c, 1.0);\n        }\n        let mut found = false;\n        for h in self.hz.iter_mut() {\n            if (h.p - c).length() < 2.6 + h.r && (h.hidden || h.k == Kind::Nodule) {\n                if h.reveal <= 0.0 {\n                    found = true;\n                }\n                h.reveal = 8.0;\n            }\n        }\n        let _ = dt;\n        if found {\n            self.cov(\"scan_reveal\");\n            self.cue(ev, cue::PING, c, 0.6, 1.8);\n        }\n    }\n\n    fn do_iv(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        // The tool lives at the IV port.\n        self.sg[s].pos = if held || self.sg[s].dose > 0.0 { IV_PORT } else { self.sg[s].pos };\n        if self.sg[s].iv_cd > 0.0 {\n            return;\n        }\n        if held {\n            self.sg[s].dose += dt / 1.8 * self.tune.get(\"power\");\n            if self.tick % 10 == 0 {\n                self.cue(ev, cue::IV, IV_PORT, 0.3, 1.0 + self.sg[s].dose * 0.3);\n            }\n            if self.sg[s].dose > 1.15 {\n                // Overdose: a spike, then a drop.\n                self.sg[s].dose = 0.0;\n                self.sg[s].iv_cd = 4.0;\n                self.vitals = (self.vitals + 5.0).min(100.0);\n                self.vitals_hit(8.0);\n                self.sg[s].chain = 0;\n                self.mistakes += 1;\n                self.cov(\"iv_overdose\");\n                self.cue(ev, cue::WRONG, IV_PORT, 0.7, 0.7);\n            }\n        } else if self.sg[s].dose > 0.1 {\n            let d = self.sg[s].dose;\n            self.sg[s].dose = 0.0;\n            self.sg[s].iv_cd = 4.0;\n            let full = if d >= 0.7 { d.min(1.0) } else { d * 0.6 };\n            let heal = 18.0 * full * self.tune.get(\"iv\");\n            self.vitals = (self.vitals + heal).min(100.0);\n            self.cov(\"rated:iv\");\n            self.award(s, IV_PORT, (d - 0.85).abs() / 0.05, ev);\n            self.cov(\"tool_done:8\");\n        }\n    }\n\n    fn do_dress(&mut self, s: usize, held: bool, dt: f32, ev: &mut Vec<SimEvent>) {\n        if !held {\n            self.sg[s].target = None;\n            return;\n        }\n        let c = self.sg[s].pos;\n        let Some(i) = self.hz.iter().position(|h| h.k == Kind::Dress) else { return };\n        let (a, b) = (self.hz[i].p, self.hz[i].q);\n        let ab = b - a;\n        let l = ab.length().max(0.01);\n        let dir = ab / l;\n        let t = ((c - a).dot(dir) / l).clamp(0.0, 1.0);\n        let dev = (c - (a + dir * (t * l))).length();\n        if dev > 1.3 || (t < self.hz[i].prog - 0.05) {\n            return;\n        }\n        let h = &mut self.hz[i];\n        if t > h.prog && t - h.prog < 0.3 {\n            h.prog = t;\n            h.dev += dev;\n            h.dev_n += 1.0;\n        }\n        let _ = dt;\n        if self.tick % 5 == 0 {\n            self.cue(ev, cue::GEL, c, 0.15, 0.7);\n        }\n        if self.hz[i].prog >= 0.97 {\n            let avg = self.hz[i].dev / self.hz[i].dev_n.max(1.0);\n            self.cov(\"rated:dress\");\n            self.step_hz(i, s, avg / 0.4, ev);\n        }\n    }\n\n    // ---------- gifts ----------\n\n    fn tick_gift(&mut self, s: usize, inp: &SurgeonInput, dt: f32, ev: &mut Vec<SimEvent>) {\n        let held = inp.held & sbtn::GIFT != 0;\n        let ready = self.sg[s].unlocked_gift && self.sg[s].gift >= 100.0 && self.hush <= 0.0 && self.echo <= 0.0;\n        if held && ready {\n            if !self.sg[s].gift_on {\n                self.cue(ev, cue::GIFT, Vec2::ZERO, 0.5, 0.6);\n                self.cov(\"gift_hold\");\n            }\n            self.sg[s].gift_on = true;\n            self.sg[s].gift_hold += dt;\n        } else if self.sg[s].gift_on {\n            let ok = self.sg[s].gift_hold >= 0.25 && (self.beat < 0.14 || self.beat > 0.86);\n            self.sg[s].gift_on = false;\n            self.sg[s].gift_hold = 0.0;\n            if ok && ready {\n                self.fire_gift(s, ev);\n            }\n        } else {\n            self.sg[s].gift_hold = 0.0;\n        }\n        if self.sg[s].gift_on && !held {\n            self.sg[s].gift_on = false;\n        }\n    }\n\n    fn fire_gift(&mut self, s: usize, ev: &mut Vec<SimEvent>) {\n        let dur = self.tune.get(\"gift_dur\");\n        self.sg[s].gift = 0.0;\n        let duet = self.case == 7 || self.case == 8 && self.surgeon_count() > 1;\n        let mara = match self.case {\n            0..=4 => true,\n            5 | 6 => false,\n            7 => s == 0,\n            _ => s % 2 == 0,\n        };\n        let hush = mara || duet && self.case == 7;\n        let echo = !mara || duet && self.case == 7;\n        if hush {\n            self.hush = 6.0 * dur;\n            self.cov(\"gift:hush\");\n        }\n        if echo {\n            self.echo = self.tune.get(\"echo_dur\") * dur;\n            self.cov(\"gift:echo\");\n        }\n        if duet && self.case == 7 {\n            self.cov(\"gift:duet\");\n            self.duet = 1.5;\n            for o in self.sg.iter_mut() {\n                o.gift = 0.0;\n            }\n            self.say(\"pet\", \"Together, child.\");\n        }\n        self.push_fx(13, Vec2::ZERO, 1.0);\n        self.flash = 0.6;\n        self.cue(ev, cue::GIFT, Vec2::ZERO, 1.0, 1.0);\n        if echo && !hush {\n            self.say(\"pet\", \"There they are. Thirty years younger, and no better tempered.\");\n        }\n    }\n\n    // ---------- hazards and strains ----------\n\n    fn tick_hazards(&mut self, dtw: f32, ev: &mut Vec<SimEvent>) {\n        let sbeat = self.sbeat_now;\n        let sb = self.sbeats;\n        let ph = self.case_def().phase.get(self.phase.max(0) as usize).cloned().unwrap_or_default();\n        let step_beats = if ph.beats > 0 { ph.beats } else { 3 };\n        let mut spawns: Vec<String> = vec![];\n        let mut burst_fx: Vec<(Vec2, u8)> = vec![];\n        let pools: Vec<(Vec2, f32)> = self.hz.iter().filter(|h| h.k == Kind::Pool).map(|h| (h.p, h.r)).collect();\n        let mut to_remove: Vec<u32> = vec![];\n        let mut vit = 0.0f32;\n        let mut moves: Vec<(usize, Vec2)> = vec![];\n        let mut pend: Vec<(usize, Vec2)> = vec![];\n        for i in 0..self.hz.len() {\n            let rpos = Vec2::new(self.rng.range(-6.5, 6.5), self.rng.range(-3.0, 3.6));\n            let h = &mut self.hz[i];\n            h.t += dtw;\n            if h.reveal > 0.0 {\n                h.reveal -= dtw;\n            }\n            match h.k {\n                Kind::Hook | Kind::Bone => {\n                    if h.k == Kind::Hook {\n                        h.covered = h.covered && pools.iter().any(|(p, r)| (*p - h.p).length() < r + 0.7);\n                    }\n                }\n                Kind::Bleeder => {\n                    if h.t > 1.5 && !pools.iter().any(|(p, r)| (*p - h.p).length() < r + 0.3) && (h.t * 10.0) as i32 % 40 == 0 {\n                        spawns.push(format!(\"pool {} {} 0.6\", h.p.x, h.p.y));\n                    }\n                    if sbeat && sb % 2 == 0 {\n                        burst_fx.push((h.p, 14));\n                    }\n                }\n                Kind::Nodule => {\n                    if h.si == 1 && (sb as f32 - h.born) > 2.0 + 0.5 * (h.lvl == 1) as i32 as f32 && sbeat {\n                        // Pulled too late: the shell closes again.\n                        h.si = 0;\n                        h.cnt = 0;\n                        h.born = sb as f32;\n                    }\n                    if h.lvl == 4 {\n                        // a pest: slow\n                    }\n                    let steps = if h.lvl >= 2 && h.lvl != 3 { 2 } else { step_beats.max(2) };\n                    if sbeat && h.lvl != 3 {\n                        h.aux += 1.0;\n                        if h.aux as u32 + 1 == steps {\n                            burst_fx.push((h.p, 15));\n                            h.window = 1.0;\n                        }\n                        if h.aux as u32 >= steps {\n                            h.aux = 0.0;\n                            h.window = 0.0;\n                            moves.push((i, rpos));\n                        }\n                    }\n                    if h.lvl == 3 {\n                        // the Amen: tethers pulse\n                        h.window = (h.t * 2.0).sin();\n                    }\n                }\n                Kind::Sac => {\n                    if sbeat {\n                        h.grown += 1.0;\n                        if h.grown >= h.aux {\n                            to_remove.push(h.id);\n                            spawns.push(format!(\"pool {} {} 1.1\", h.p.x, h.p.y));\n                            spawns.push(format!(\"burn {} {} 0.8\", h.p.x, h.p.y));\n                            vit += 8.0;\n                            burst_fx.push((h.p, 16));\n                        }\n                    }\n                }\n                Kind::Eye => {\n                    if sbeat {\n                        h.window -= 1.0;\n                        if h.window <= 0.0 {\n                            if h.aux < 0.5 {\n                                h.aux = 1.0;\n                                h.window = 3.0;\n                                h.prog = 0.0;\n                                h.cnt = 0;\n                                vit += 3.0;\n                            } else {\n                                h.aux = 0.0;\n                                h.window = 4.0;\n                            }\n                        }\n                    }\n                }\n                Kind::Ember => {\n                    if h.lvl == 1 && sbeat && sb % 2 == 0 {\n                        pend.push((i, rpos));\n                    }\n                }\n                _ => {}\n            }\n            // Growing pool.\n        }\n        for (i, p) in moves {\n            let old = self.hz[i].p;\n            let new = p;\n            let h = &mut self.hz[i];\n            h.p = new;\n            h.reveal = h.reveal.max(0.0);\n            let id = h.id;\n            for sg in self.sg.iter_mut() {\n                if sg.target == Some(id) {\n                    sg.target = None;\n                    sg.heat = 0.0;\n                }\n            }\n            if self.rng.below(2) == 0 {\n                spawns.push(format!(\"pool {} {} 0.55\", old.x, old.y));\n            } else {\n                spawns.push(format!(\"lace {} {} {} {}\", old.x - 0.6, old.y, old.x + 0.6, old.y + 0.2));\n            }\n            self.push_fx(17, new, 1.0);\n            self.cue(ev, cue::RIPPLE, new, 0.5, 1.0);\n        }\n        for (i, p) in pend {\n            self.hz[i].p = p;\n        }\n        for (p, k) in burst_fx {\n            self.push_fx(k, p, 1.0);\n            if k == 16 {\n                self.cue(ev, cue::BURST, p, 0.9, 1.0);\n            } else if k == 15 {\n                self.cue(ev, cue::RIPPLE, p, 0.4, 1.3);\n            }\n        }\n        for id in to_remove {\n            if let Some(i) = self.hz_index(id) {\n                self.hz.remove(i);\n            }\n        }\n        for sp in spawns {\n            if self.hz.len() < 30 {\n                self.spawn_pop_hz(sp);\n            }\n        }\n        if vit > 0.0 {\n            self.vitals_hit(vit);\n            self.shake = 0.5;\n        }\n        // Bleeders feed pools, pools grow slowly.\n        let growers: Vec<Vec2> = self.hz.iter().filter(|h| h.k == Kind::Bleeder).map(|h| h.p).collect();\n        for h in self.hz.iter_mut().filter(|h| h.k == Kind::Pool) {\n            if growers.iter().any(|g| (*g - h.p).length() < h.r + 0.4) && h.r < 2.2 {\n                h.r += 0.06 * dtw;\n            }\n        }\n        // Fever and heat rings.\n        if ph.fever {\n            let embers = self.hz.iter().filter(|h| h.k == Kind::Ember).count() as f32;\n            self.fever = (self.fever + embers * 1.6 * dtw * self.strain_mul()).min(130.0);\n            if self.fever > 100.0 {\n                self.cov(\"fever_over\");\n            }\n        }\n        if self.rings > 0 {\n            let in_ring = self.sbeats % self.rings;\n            self.ring_warn = in_ring == self.rings - 1;\n            if sbeat && in_ring == 0 {\n                self.ring_r = 0.0;\n                self.ring_on = true;\n                self.cue(ev, cue::RING, Vec2::ZERO, 0.7, 1.0);\n                self.cov(\"heat_ring\");\n            }\n            if self.ring_on {\n                let prev = self.ring_r;\n                self.ring_r += 16.0 * dtw * self.strain_mul().max(0.5) * (self.bpm / 72.0).min(1.4);\n                for s in 0..4 {\n                    if !self.sg[s].active {\n                        continue;\n                    }\n                    let d = self.sg[s].pos.length();\n                    if d > prev && d <= self.ring_r && self.sg[s].held {\n                        let c = self.sg[s].pos;\n                        self.sg[s].chain = 0;\n                        self.vitals_hit(3.0);\n                        self.mistakes += 1;\n                        self.spawn_pop_hz(format!(\"burn {} {} 0.6\", c.x, c.y));\n                        self.cue(ev, cue::SIZZLE, c, 0.8, 0.8);\n                        self.cov(\"ring_scorch\");\n                        self.callout(\"Lift off! Lift off!\");\n                    } else if d > prev && d <= self.ring_r && self.sg[s].tool > 0 {\n                        self.cov(\"ring_dodge\");\n                    }\n                }\n                if self.ring_r > 16.0 {\n                    self.ring_on = false;\n                    self.ring_r = -1.0;\n                }\n            }\n        }\n    }\n\n    // ---------- queries ----------\n\n    pub fn status_json(&self) -> serde_json::Value {\n        let c = self.case_def();\n        json!({\n            \"mode\": self.mode,\n            \"scene\": self.scene,\n            \"step\": self.step,\n            \"case\": self.case,\n            \"case_name\": c.name,\n            \"phase\": self.phase,\n            \"phases\": c.phase.len(),\n            \"vitals\": (self.vitals * 10.0).round() / 10.0,\n            \"bpm\": self.bpm.round(),\n            \"time_left\": self.time_left.round(),\n            \"t\": (self.t * 10.0).round() / 10.0,\n            \"hazards\": self.hz.len(),\n            \"hush\": self.hush,\n            \"echo\": self.echo,\n            \"code\": self.code_t > 0.0,\n            \"score\": self.sg.iter().map(|s| s.score).sum::<i64>(),\n            \"total_score\": self.total_score,\n            \"chain\": self.sg[0].chain,\n            \"gift\": self.sg[0].gift,\n            \"tool\": self.sg[0].tool,\n            \"cursor\": [self.sg[0].pos.x, self.sg[0].pos.y],\n            \"surgeons\": self.surgeon_count(),\n            \"attract\": self.attract,\n            \"banner\": self.banner,\n            \"rank\": self.results.as_ref().map(|r| r.rank.clone()),\n            \"story\": self.story,\n            \"line\": self.line,\n            \"fever\": self.fever.round(),\n            \"mistakes\": self.mistakes,\n            \"paused\": self.paused,\n            \"codes_left\": self.codes_left,\n            \"cheat_immortal\": self.cheat_immortal,\n            \"cov\": self.cov,\n        })\n    }\n}\n\nimpl Game for Surgery {\n    const KEY: &'static str = KEY;\n\n    fn pre(&mut self, _sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        self.do_pre(input, dt, events);\n        BTreeMap::new()\n    }\n\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        self.status_json()\n    }\n\n    fn outcome(&self) -> Outcome {\n        match self.mode {\n            Mode::Won => Outcome::Won,\n            Mode::Dead => Outcome::Lost,\n            Mode::Results if self.scene != \"campaign\" => Outcome::Won,\n            _ => Outcome::Playing,\n        }\n    }\n\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        for s in 0..4 {\n            if self.sg[s].active && self.mode == Mode::Op {\n                f.surgeons[s] = bot::bot_slot(self, s);\n            }\n        }\n        if matches!(self.mode, Mode::Story | Mode::Card | Mode::Results | Mode::Dead) {\n            f.surgeons[0].active = true;\n            f.surgeons[0].pressed = sbtn::ADVANCE;\n        }\n        f.surgeons[0].active = true;\n        f\n    }\n}\n\nimpl crate::games::GameBox {\n    /// The frame the view and the shell draw from (None for other games).\n    pub fn surgery_frame(&self) -> Option<std::sync::Arc<SurgeryFrame>> {\n        self.get::<Surgery>().map(|g| std::sync::Arc::new(frame::build(g)))\n    }\n    pub fn surgery(&self) -> Option<&Surgery> {\n        self.get::<Surgery>()\n    }\n    pub fn surgery_mut(&mut self) -> Option<&mut Surgery> {\n        self.get_mut::<Surgery>()\n    }\n}\nE\necho written"}}}
