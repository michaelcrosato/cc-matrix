{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjzDGZMbMkMfJqsC324C","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YPnC4NUQQBBcTtjXzLxg43","name":"Bash","input":{"command":"cat > surgery/plates.rs <<'E'\n//! The operative field: one per-frame mesh with per-vertex colour doing the painting.\n\nuse glam::{Vec2, Vec3};\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_render::mesh::{MeshData, Vertex};\n\nuse super::{NK, lin};\n\npub const GX: usize = 220;\npub const GZ: usize = 126;\nconst W: f32 = 22.0;\nconst D: f32 = 12.6;\n\nstruct Lobe {\n    cx: f32,\n    cz: f32,\n    a: f32,\n    b: f32,\n    h: f32,\n}\n\nstruct Plate {\n    lobes: Vec<Lobe>,\n    bed: Vec3,\n    flesh: Vec3,\n    top: Vec3,\n    vein: Vec3,\n    veins: f32,\n    ridges: f32,\n}\n\nfn plate(name: &str) -> Plate {\n    let l = |cx, cz, a, b, h| Lobe { cx, cz, a, b, h };\n    let std_lobes = vec![l(0.0, 0.0, 22.0, 9.0, 1.25)];\n    let mut p = Plate {\n        lobes: std_lobes,\n        bed: lin(74, 22, 30),\n        flesh: lin(214, 92, 84),\n        top: lin(246, 150, 128),\n        vein: lin(150, 40, 60),\n        veins: 0.5,\n        ridges: 0.0,\n    };\n    match name {\n        \"abdomen\" => {\n            p.flesh = lin(232, 150, 130);\n            p.top = lin(250, 196, 170);\n            p.veins = 0.15;\n        }\n        \"bowel\" => {\n            p.flesh = lin(228, 108, 120);\n            p.top = lin(250, 160, 168);\n            p.ridges = 0.35;\n            p.lobes = vec![l(-3.0, 0.0, 14.0, 6.0, 1.0), l(3.5, 0.5, 14.0, 7.0, 1.1)];\n        }\n        \"chest\" => {\n            p.flesh = lin(224, 140, 122);\n            p.top = lin(248, 190, 164);\n            p.veins = 0.2;\n        }\n        \"lung\" => {\n            p.flesh = lin(220, 120, 140);\n            p.top = lin(250, 176, 190);\n            p.bed = lin(80, 30, 50);\n            p.vein = lin(110, 60, 120);\n            p.veins = 0.9;\n            p.lobes = vec![l(-4.0, 0.0, 16.0, 8.0, 1.2), l(4.5, 0.0, 16.0, 8.0, 1.2)];\n        }\n        \"liver\" => {\n            p.flesh = lin(150, 56, 56);\n            p.top = lin(196, 100, 90);\n            p.bed = lin(60, 18, 24);\n            p.veins = 0.35;\n            p.lobes = vec![l(0.0, 0.0, 24.0, 9.0, 1.3), l(-5.0, 1.0, 10.0, 5.0, 0.4)];\n        }\n        \"femur\" => {\n            p.flesh = lin(200, 100, 90);\n            p.top = lin(236, 190, 170);\n            p.bed = lin(70, 26, 28);\n            p.ridges = 0.1;\n        }\n        \"pericardium\" => {\n            p.flesh = lin(236, 170, 150);\n            p.top = lin(255, 224, 200);\n            p.bed = lin(90, 40, 40);\n            p.veins = 0.7;\n            p.vein = lin(190, 70, 70);\n        }\n        \"heart\" => {\n            p.flesh = lin(184, 40, 56);\n            p.top = lin(240, 100, 100);\n            p.bed = lin(60, 10, 24);\n            p.veins = 0.8;\n            p.vein = lin(240, 180, 90);\n            p.lobes = vec![l(-1.0, 0.2, 18.0, 8.0, 1.5), l(3.0, -0.5, 9.0, 5.0, 0.7)];\n        }\n        \"torso\" => {\n            p.flesh = lin(224, 120, 104);\n            p.top = lin(250, 176, 150);\n            p.veins = 0.45;\n        }\n        _ => {}\n    }\n    p\n}\n\nfn hash(x: i32, z: i32) -> f32 {\n    let mut h = (x as u32).wrapping_mul(374761393).wrapping_add((z as u32).wrapping_mul(668265263));\n    h = (h ^ (h >> 13)).wrapping_mul(1274126177);\n    ((h ^ (h >> 16)) & 0xffff) as f32 / 65535.0\n}\n\nfn vnoise(x: f32, z: f32) -> f32 {\n    let (xi, zi) = (x.floor(), z.floor());\n    let (fx, fz) = (x - xi, z - zi);\n    let (sx, sz) = (fx * fx * (3.0 - 2.0 * fx), fz * fz * (3.0 - 2.0 * fz));\n    let (xi, zi) = (xi as i32, zi as i32);\n    let a = hash(xi, zi);\n    let b = hash(xi + 1, zi);\n    let c = hash(xi, zi + 1);\n    let d = hash(xi + 1, zi + 1);\n    (a + (b - a) * sx) + ((c + (d - c) * sx) - (a + (b - a) * sx)) * sz\n}\n\nfn fbm(x: f32, z: f32) -> f32 {\n    vnoise(x, z) * 0.55 + vnoise(x * 2.1 + 5.0, z * 2.1 - 3.0) * 0.3 + vnoise(x * 4.3 - 2.0, z * 4.3 + 7.0) * 0.15\n}\n\nfn base_height(p: &Plate, x: f32, z: f32) -> f32 {\n    let mut h = 0.0;\n    for l in &p.lobes {\n        let dx = x - l.cx;\n        let dz = z - l.cz;\n        h += l.h * (1.0 - dx * dx / l.a - dz * dz / l.b).max(0.0).powf(0.55);\n    }\n    h += 0.07 * fbm(x * 0.7, z * 0.7);\n    if p.ridges > 0.0 {\n        h += p.ridges * 0.12 * ((x * 1.3 + (z * 0.7).sin() * 2.0).sin() * 0.5 + 0.5);\n    }\n    h\n}\n\nfn seg_dist(c: Vec2, a: Vec2, b: Vec2) -> (f32, f32) {\n    let ab = b - a;\n    let l2 = ab.length_squared().max(1e-6);\n    let t = ((c - a).dot(ab) / l2).clamp(0.0, 1.0);\n    ((c - (a + ab * t)).length(), t)\n}\n\npub fn field_mesh(f: &SurgeryFrame, time: f32, pulse: f32) -> MeshData {\n    let pa = plate(&f.plate);\n    let pb = plate(&f.plate_prev);\n    let blend_active = f.plate_t < 1.0;\n    let nv = (GX + 1) * (GZ + 1);\n    let mut hs = vec![0.0f32; nv];\n    let mut cs = vec![Vec3::ZERO; nv];\n    let to_sun = Vec3::new(0.25, 1.0, 0.35).normalize();\n    let view_dir = Vec3::new(0.0, 0.96, 0.29).normalize();\n    let half = (to_sun + view_dir).normalize();\n    // Hazards that stamp the tissue.\n    struct Stamp {\n        k: &'static str,\n        p: Vec2,\n        q: Vec2,\n        r: f32,\n        prog: f32,\n        cnt: u8,\n        stages: u8,\n        si: u8,\n    }\n    let stamps: Vec<Stamp> = f\n        .hz\n        .iter()\n        .filter(|h| matches!(NK[h.k as usize], \"line\" | \"lace\" | \"pool\" | \"burn\" | \"bleeder\" | \"tumor\" | \"eye\"))\n        .map(|h| Stamp { k: NK[h.k as usize], p: Vec2::from(h.p), q: Vec2::from(h.q), r: h.r, prog: h.prog, cnt: h.cnt, stages: h.count, si: h.si })\n        .collect();\n    let breathe = 1.0 + 0.012 * (time * 1.3).sin();\n    let pul = 1.0 + 0.05 * pulse;\n    let cut = lin(44, 8, 14);\n    let pool_c = lin(120, 6, 16);\n    for iz in 0..=GZ {\n        for ix in 0..=GX {\n            let x = -W * 0.5 + W * ix as f32 / GX as f32;\n            let z = -D * 0.5 + D * iz as f32 / GZ as f32;\n            let i = iz * (GX + 1) + ix;\n            let mut h = base_height(&pa, x, z);\n            let mut pl = (&pa, h);\n            if blend_active {\n                let hb = base_height(&pb, x, z);\n                let d = (Vec2::new(x, z)).length() / 12.0;\n                let k = (f.plate_t * 1.7 - d).clamp(0.0, 1.0);\n                let k = k * k * (3.0 - 2.0 * k);\n                h = hb + (h - hb) * k;\n                pl = (if k > 0.5 { &pa } else { &pb }, h);\n            }\n            let pp = pl.0;\n            let mut hh = h * breathe * pul;\n            // colour ramp\n            let t = (hh / 1.4).clamp(0.0, 1.0);\n            let mut col = if t < 0.5 { pp.bed.lerp(pp.flesh, t * 2.0) } else { pp.flesh.lerp(pp.top, (t - 0.5) * 2.0) };\n            let n = fbm(x * 1.7 + 11.0, z * 1.7 - 4.0);\n            col *= 0.9 + 0.2 * n;\n            // veins\n            let vn = (vnoise(x * 1.1 + 3.0, z * 1.1) - 0.5).abs();\n            if vn < 0.03 * pp.veins {\n                col = col.lerp(pp.vein, 0.7);\n            }\n            let p2 = Vec2::new(x, z);\n            for s in &stamps {\n                match s.k {\n                    \"line\" => {\n                        let (d, t) = seg_dist(p2, s.p, s.q);\n                        if d < 0.45 {\n                            let opened = t <= s.prog;\n                            let w = if opened { 0.17 } else { 0.0 };\n                            if d < w {\n                                col = cut;\n                                hh -= 0.14;\n                            } else if opened && d < w + 0.14 {\n                                hh += 0.06;\n                                col = col.lerp(lin(236, 120, 110), 0.6);\n                            } else if !opened && d < 0.03 {\n                                col = col.lerp(lin(60, 20, 30), 0.35);\n                            }\n                        }\n                    }\n                    \"lace\" => {\n                        let (d, _) = seg_dist(p2, s.p, s.q);\n                        let closed = (s.cnt as f32) / (s.stages.max(1) as f32);\n                        let w = 0.13 * (1.0 - 0.8 * closed);\n                        if d < w {\n                            col = pool_c.lerp(cut, 0.4);\n                            hh -= 0.08 * (1.0 - closed);\n                        } else if d < w + 0.1 {\n                            col = col.lerp(lin(210, 70, 70), 0.5);\n                        }\n                    }\n                    \"pool\" => {\n                        let r = s.r * (1.0 - s.prog * 0.75);\n                        let wob = 1.0 + 0.25 * (fbm(x * 2.0 + s.p.x, z * 2.0 + s.p.y) - 0.5);\n                        let d = (p2 - s.p).length() / wob;\n                        if d < r {\n                            col = pool_c * (0.85 + 0.3 * (1.0 - d / r));\n                            hh = hh * 0.6 + 0.12;\n                        } else if d < r + 0.12 {\n                            col = col.lerp(pool_c, 0.5);\n                        }\n                    }\n                    \"bleeder\" => {\n                        let d = (p2 - s.p).length();\n                        if d < 0.45 {\n                            col = pool_c;\n                            hh += 0.08;\n                        }\n                    }\n                    \"burn\" => {\n                        let wob = 1.0 + 0.3 * (fbm(x * 2.2 - s.p.x, z * 2.2 + s.p.y) - 0.5);\n                        let d = (p2 - s.p).length() / wob;\n                        if d < s.r {\n                            let k = (1.0 - d / s.r) * (1.0 - s.prog);\n                            col = col.lerp(lin(48, 24, 20), 0.85 * k.clamp(0.0, 1.0) + 0.1);\n                            if s.prog > 0.0 {\n                                col = col.lerp(lin(160, 230, 240), s.prog * 0.5);\n                            }\n                        }\n                    }\n                    \"tumor\" => {\n                        let d = (p2 - s.p).length();\n                        if s.si < 2 && d < s.r {\n                            col = col.lerp(lin(90, 40, 100), 0.4);\n                            hh += 0.1 * (1.0 - d / s.r);\n                        } else if s.si >= 2 && d < s.r * 0.9 {\n                            col = col.lerp(lin(180, 60, 60), 0.5);\n                            hh -= 0.1;\n                        }\n                    }\n                    \"eye\" => {\n                        let d = (p2 - s.p).length();\n                        if d < s.r * 1.1 {\n                            col = col.lerp(lin(90, 30, 100), 0.35);\n                        }\n                    }\n                    _ => {}\n                }\n            }\n            // Hush: colour drains from everything but the tissue (handled by the filter).\n            hs[i] = hh;\n            cs[i] = col;\n        }\n    }\n    // Normals + toon highlight.\n    let mut vertices = Vec::with_capacity(nv);\n    let dx = W / GX as f32;\n    let dz = D / GZ as f32;\n    for iz in 0..=GZ {\n        for ix in 0..=GX {\n            let i = iz * (GX + 1) + ix;\n            let hl = hs[iz * (GX + 1) + ix.saturating_sub(1)];\n            let hr = hs[iz * (GX + 1) + (ix + 1).min(GX)];\n            let hu = hs[iz.saturating_sub(1) * (GX + 1) + ix];\n            let hd = hs[(iz + 1).min(GZ) * (GX + 1) + ix];\n            let n = Vec3::new((hl - hr) / (2.0 * dx), 1.0, (hu - hd) / (2.0 * dz)).normalize();\n            let spec = n.dot(half).max(0.0).powf(60.0);\n            let mut col = cs[i];\n            if spec > 0.5 {\n                col = col.lerp(Vec3::ONE, 0.55);\n            }\n            let x = -W * 0.5 + W * ix as f32 / GX as f32;\n            let z = -D * 0.5 + D * iz as f32 / GZ as f32;\n            debug_assert!(hs[i].is_finite() && col.is_finite());\n            let hv = if hs[i].is_finite() { hs[i] } else { 0.0 };\n            vertices.push(Vertex {\n                pos: [x, hv, z],\n                normal: n.to_array(),\n                uv: [0.0, 0.0],\n                color: [col.x.min(4.0), col.y.min(4.0), col.z.min(4.0), 1.0],\n            });\n        }\n    }\n    let mut indices = Vec::with_capacity(GX * GZ * 6);\n    for iz in 0..GZ {\n        for ix in 0..GX {\n            let a = (iz * (GX + 1) + ix) as u32;\n            let b = a + 1;\n            let c = a + (GX + 1) as u32;\n            let d = c + 1;\n            // counter-clockwise seen from above (+Y)\n            indices.extend_from_slice(&[a, c, b, b, c, d]);\n        }\n    }\n    MeshData { vertices, indices }\n}\nE\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19509,"cache_read_input_tokens":231209,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19509},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c","uuid":"21182ecf-f9e2-481c-b694-75ffb89fdee4","timestamp":"2026-11-05T15:05:37.672Z","request_id":"req_011CgjzDGHELxDeAT42AY7ee","wire_tool_inputs":{"toolu_01YPnC4NUQQBBcTtjXzLxg43":{"command":"cat > surgery/plates.rs <<'E'\n//! The operative field: one per-frame mesh with per-vertex colour doing the painting.\n\nuse glam::{Vec2, Vec3};\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_render::mesh::{MeshData, Vertex};\n\nuse super::{NK, lin};\n\npub const GX: usize = 220;\npub const GZ: usize = 126;\nconst W: f32 = 22.0;\nconst D: f32 = 12.6;\n\nstruct Lobe {\n    cx: f32,\n    cz: f32,\n    a: f32,\n    b: f32,\n    h: f32,\n}\n\nstruct Plate {\n    lobes: Vec<Lobe>,\n    bed: Vec3,\n    flesh: Vec3,\n    top: Vec3,\n    vein: Vec3,\n    veins: f32,\n    ridges: f32,\n}\n\nfn plate(name: &str) -> Plate {\n    let l = |cx, cz, a, b, h| Lobe { cx, cz, a, b, h };\n    let std_lobes = vec![l(0.0, 0.0, 22.0, 9.0, 1.25)];\n    let mut p = Plate {\n        lobes: std_lobes,\n        bed: lin(74, 22, 30),\n        flesh: lin(214, 92, 84),\n        top: lin(246, 150, 128),\n        vein: lin(150, 40, 60),\n        veins: 0.5,\n        ridges: 0.0,\n    };\n    match name {\n        \"abdomen\" => {\n            p.flesh = lin(232, 150, 130);\n            p.top = lin(250, 196, 170);\n            p.veins = 0.15;\n        }\n        \"bowel\" => {\n            p.flesh = lin(228, 108, 120);\n            p.top = lin(250, 160, 168);\n            p.ridges = 0.35;\n            p.lobes = vec![l(-3.0, 0.0, 14.0, 6.0, 1.0), l(3.5, 0.5, 14.0, 7.0, 1.1)];\n        }\n        \"chest\" => {\n            p.flesh = lin(224, 140, 122);\n            p.top = lin(248, 190, 164);\n            p.veins = 0.2;\n        }\n        \"lung\" => {\n            p.flesh = lin(220, 120, 140);\n            p.top = lin(250, 176, 190);\n            p.bed = lin(80, 30, 50);\n            p.vein = lin(110, 60, 120);\n            p.veins = 0.9;\n            p.lobes = vec![l(-4.0, 0.0, 16.0, 8.0, 1.2), l(4.5, 0.0, 16.0, 8.0, 1.2)];\n        }\n        \"liver\" => {\n            p.flesh = lin(150, 56, 56);\n            p.top = lin(196, 100, 90);\n            p.bed = lin(60, 18, 24);\n            p.veins = 0.35;\n            p.lobes = vec![l(0.0, 0.0, 24.0, 9.0, 1.3), l(-5.0, 1.0, 10.0, 5.0, 0.4)];\n        }\n        \"femur\" => {\n            p.flesh = lin(200, 100, 90);\n            p.top = lin(236, 190, 170);\n            p.bed = lin(70, 26, 28);\n            p.ridges = 0.1;\n        }\n        \"pericardium\" => {\n            p.flesh = lin(236, 170, 150);\n            p.top = lin(255, 224, 200);\n            p.bed = lin(90, 40, 40);\n            p.veins = 0.7;\n            p.vein = lin(190, 70, 70);\n        }\n        \"heart\" => {\n            p.flesh = lin(184, 40, 56);\n            p.top = lin(240, 100, 100);\n            p.bed = lin(60, 10, 24);\n            p.veins = 0.8;\n            p.vein = lin(240, 180, 90);\n            p.lobes = vec![l(-1.0, 0.2, 18.0, 8.0, 1.5), l(3.0, -0.5, 9.0, 5.0, 0.7)];\n        }\n        \"torso\" => {\n            p.flesh = lin(224, 120, 104);\n            p.top = lin(250, 176, 150);\n            p.veins = 0.45;\n        }\n        _ => {}\n    }\n    p\n}\n\nfn hash(x: i32, z: i32) -> f32 {\n    let mut h = (x as u32).wrapping_mul(374761393).wrapping_add((z as u32).wrapping_mul(668265263));\n    h = (h ^ (h >> 13)).wrapping_mul(1274126177);\n    ((h ^ (h >> 16)) & 0xffff) as f32 / 65535.0\n}\n\nfn vnoise(x: f32, z: f32) -> f32 {\n    let (xi, zi) = (x.floor(), z.floor());\n    let (fx, fz) = (x - xi, z - zi);\n    let (sx, sz) = (fx * fx * (3.0 - 2.0 * fx), fz * fz * (3.0 - 2.0 * fz));\n    let (xi, zi) = (xi as i32, zi as i32);\n    let a = hash(xi, zi);\n    let b = hash(xi + 1, zi);\n    let c = hash(xi, zi + 1);\n    let d = hash(xi + 1, zi + 1);\n    (a + (b - a) * sx) + ((c + (d - c) * sx) - (a + (b - a) * sx)) * sz\n}\n\nfn fbm(x: f32, z: f32) -> f32 {\n    vnoise(x, z) * 0.55 + vnoise(x * 2.1 + 5.0, z * 2.1 - 3.0) * 0.3 + vnoise(x * 4.3 - 2.0, z * 4.3 + 7.0) * 0.15\n}\n\nfn base_height(p: &Plate, x: f32, z: f32) -> f32 {\n    let mut h = 0.0;\n    for l in &p.lobes {\n        let dx = x - l.cx;\n        let dz = z - l.cz;\n        h += l.h * (1.0 - dx * dx / l.a - dz * dz / l.b).max(0.0).powf(0.55);\n    }\n    h += 0.07 * fbm(x * 0.7, z * 0.7);\n    if p.ridges > 0.0 {\n        h += p.ridges * 0.12 * ((x * 1.3 + (z * 0.7).sin() * 2.0).sin() * 0.5 + 0.5);\n    }\n    h\n}\n\nfn seg_dist(c: Vec2, a: Vec2, b: Vec2) -> (f32, f32) {\n    let ab = b - a;\n    let l2 = ab.length_squared().max(1e-6);\n    let t = ((c - a).dot(ab) / l2).clamp(0.0, 1.0);\n    ((c - (a + ab * t)).length(), t)\n}\n\npub fn field_mesh(f: &SurgeryFrame, time: f32, pulse: f32) -> MeshData {\n    let pa = plate(&f.plate);\n    let pb = plate(&f.plate_prev);\n    let blend_active = f.plate_t < 1.0;\n    let nv = (GX + 1) * (GZ + 1);\n    let mut hs = vec![0.0f32; nv];\n    let mut cs = vec![Vec3::ZERO; nv];\n    let to_sun = Vec3::new(0.25, 1.0, 0.35).normalize();\n    let view_dir = Vec3::new(0.0, 0.96, 0.29).normalize();\n    let half = (to_sun + view_dir).normalize();\n    // Hazards that stamp the tissue.\n    struct Stamp {\n        k: &'static str,\n        p: Vec2,\n        q: Vec2,\n        r: f32,\n        prog: f32,\n        cnt: u8,\n        stages: u8,\n        si: u8,\n    }\n    let stamps: Vec<Stamp> = f\n        .hz\n        .iter()\n        .filter(|h| matches!(NK[h.k as usize], \"line\" | \"lace\" | \"pool\" | \"burn\" | \"bleeder\" | \"tumor\" | \"eye\"))\n        .map(|h| Stamp { k: NK[h.k as usize], p: Vec2::from(h.p), q: Vec2::from(h.q), r: h.r, prog: h.prog, cnt: h.cnt, stages: h.count, si: h.si })\n        .collect();\n    let breathe = 1.0 + 0.012 * (time * 1.3).sin();\n    let pul = 1.0 + 0.05 * pulse;\n    let cut = lin(44, 8, 14);\n    let pool_c = lin(120, 6, 16);\n    for iz in 0..=GZ {\n        for ix in 0..=GX {\n            let x = -W * 0.5 + W * ix as f32 / GX as f32;\n            let z = -D * 0.5 + D * iz as f32 / GZ as f32;\n            let i = iz * (GX + 1) + ix;\n            let mut h = base_height(&pa, x, z);\n            let mut pl = (&pa, h);\n            if blend_active {\n                let hb = base_height(&pb, x, z);\n                let d = (Vec2::new(x, z)).length() / 12.0;\n                let k = (f.plate_t * 1.7 - d).clamp(0.0, 1.0);\n                let k = k * k * (3.0 - 2.0 * k);\n                h = hb + (h - hb) * k;\n                pl = (if k > 0.5 { &pa } else { &pb }, h);\n            }\n            let pp = pl.0;\n            let mut hh = h * breathe * pul;\n            // colour ramp\n            let t = (hh / 1.4).clamp(0.0, 1.0);\n            let mut col = if t < 0.5 { pp.bed.lerp(pp.flesh, t * 2.0) } else { pp.flesh.lerp(pp.top, (t - 0.5) * 2.0) };\n            let n = fbm(x * 1.7 + 11.0, z * 1.7 - 4.0);\n            col *= 0.9 + 0.2 * n;\n            // veins\n            let vn = (vnoise(x * 1.1 + 3.0, z * 1.1) - 0.5).abs();\n            if vn < 0.03 * pp.veins {\n                col = col.lerp(pp.vein, 0.7);\n            }\n            let p2 = Vec2::new(x, z);\n            for s in &stamps {\n                match s.k {\n                    \"line\" => {\n                        let (d, t) = seg_dist(p2, s.p, s.q);\n                        if d < 0.45 {\n                            let opened = t <= s.prog;\n                            let w = if opened { 0.17 } else { 0.0 };\n                            if d < w {\n                                col = cut;\n                                hh -= 0.14;\n                            } else if opened && d < w + 0.14 {\n                                hh += 0.06;\n                                col = col.lerp(lin(236, 120, 110), 0.6);\n                            } else if !opened && d < 0.03 {\n                                col = col.lerp(lin(60, 20, 30), 0.35);\n                            }\n                        }\n                    }\n                    \"lace\" => {\n                        let (d, _) = seg_dist(p2, s.p, s.q);\n                        let closed = (s.cnt as f32) / (s.stages.max(1) as f32);\n                        let w = 0.13 * (1.0 - 0.8 * closed);\n                        if d < w {\n                            col = pool_c.lerp(cut, 0.4);\n                            hh -= 0.08 * (1.0 - closed);\n                        } else if d < w + 0.1 {\n                            col = col.lerp(lin(210, 70, 70), 0.5);\n                        }\n                    }\n                    \"pool\" => {\n                        let r = s.r * (1.0 - s.prog * 0.75);\n                        let wob = 1.0 + 0.25 * (fbm(x * 2.0 + s.p.x, z * 2.0 + s.p.y) - 0.5);\n                        let d = (p2 - s.p).length() / wob;\n                        if d < r {\n                            col = pool_c * (0.85 + 0.3 * (1.0 - d / r));\n                            hh = hh * 0.6 + 0.12;\n                        } else if d < r + 0.12 {\n                            col = col.lerp(pool_c, 0.5);\n                        }\n                    }\n                    \"bleeder\" => {\n                        let d = (p2 - s.p).length();\n                        if d < 0.45 {\n                            col = pool_c;\n                            hh += 0.08;\n                        }\n                    }\n                    \"burn\" => {\n                        let wob = 1.0 + 0.3 * (fbm(x * 2.2 - s.p.x, z * 2.2 + s.p.y) - 0.5);\n                        let d = (p2 - s.p).length() / wob;\n                        if d < s.r {\n                            let k = (1.0 - d / s.r) * (1.0 - s.prog);\n                            col = col.lerp(lin(48, 24, 20), 0.85 * k.clamp(0.0, 1.0) + 0.1);\n                            if s.prog > 0.0 {\n                                col = col.lerp(lin(160, 230, 240), s.prog * 0.5);\n                            }\n                        }\n                    }\n                    \"tumor\" => {\n                        let d = (p2 - s.p).length();\n                        if s.si < 2 && d < s.r {\n                            col = col.lerp(lin(90, 40, 100), 0.4);\n                            hh += 0.1 * (1.0 - d / s.r);\n                        } else if s.si >= 2 && d < s.r * 0.9 {\n                            col = col.lerp(lin(180, 60, 60), 0.5);\n                            hh -= 0.1;\n                        }\n                    }\n                    \"eye\" => {\n                        let d = (p2 - s.p).length();\n                        if d < s.r * 1.1 {\n                            col = col.lerp(lin(90, 30, 100), 0.35);\n                        }\n                    }\n                    _ => {}\n                }\n            }\n            // Hush: colour drains from everything but the tissue (handled by the filter).\n            hs[i] = hh;\n            cs[i] = col;\n        }\n    }\n    // Normals + toon highlight.\n    let mut vertices = Vec::with_capacity(nv);\n    let dx = W / GX as f32;\n    let dz = D / GZ as f32;\n    for iz in 0..=GZ {\n        for ix in 0..=GX {\n            let i = iz * (GX + 1) + ix;\n            let hl = hs[iz * (GX + 1) + ix.saturating_sub(1)];\n            let hr = hs[iz * (GX + 1) + (ix + 1).min(GX)];\n            let hu = hs[iz.saturating_sub(1) * (GX + 1) + ix];\n            let hd = hs[(iz + 1).min(GZ) * (GX + 1) + ix];\n            let n = Vec3::new((hl - hr) / (2.0 * dx), 1.0, (hu - hd) / (2.0 * dz)).normalize();\n            let spec = n.dot(half).max(0.0).powf(60.0);\n            let mut col = cs[i];\n            if spec > 0.5 {\n                col = col.lerp(Vec3::ONE, 0.55);\n            }\n            let x = -W * 0.5 + W * ix as f32 / GX as f32;\n            let z = -D * 0.5 + D * iz as f32 / GZ as f32;\n            debug_assert!(hs[i].is_finite() && col.is_finite());\n            let hv = if hs[i].is_finite() { hs[i] } else { 0.0 };\n            vertices.push(Vertex {\n                pos: [x, hv, z],\n                normal: n.to_array(),\n                uv: [0.0, 0.0],\n                color: [col.x.min(4.0), col.y.min(4.0), col.z.min(4.0), 1.0],\n            });\n        }\n    }\n    let mut indices = Vec::with_capacity(GX * GZ * 6);\n    for iz in 0..GZ {\n        for ix in 0..GX {\n            let a = (iz * (GX + 1) + ix) as u32;\n            let b = a + 1;\n            let c = a + (GX + 1) as u32;\n            let d = c + 1;\n            // counter-clockwise seen from above (+Y)\n            indices.extend_from_slice(&[a, c, b, b, c, d]);\n        }\n    }\n    MeshData { vertices, indices }\n}\nE\necho ok"}}}
