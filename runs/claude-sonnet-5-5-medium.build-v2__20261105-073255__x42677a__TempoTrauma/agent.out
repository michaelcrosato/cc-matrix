\"shell\"][\"screen\"] == \"game\", 30, \"options resumes\")\n        # Keyboard and mouse: 5 picks the laser slot, the mouse aims and clicks.\n        g.key(\"5\")\n        st = g.wait(lambda s: s[\"sim\"][\"tool\"] == 5, 30, \"key 5\")\n        assert st[\"shell\"][\"device\"] == \"mouse\"\n        g.page.mouse.move(200, 300)\n        g.frames(2)\n        g.page.mouse.move(210, 305)\n        g.frames(3)\n        xl = g.status()[\"sim\"][\"cursor\"][0]\n        g.page.mouse.move(760, 300)\n        g.frames(2)\n        g.page.mouse.move(770, 305)\n        g.frames(3)\n        xr = g.status()[\"sim\"][\"cursor\"][0]\n        assert xr > xl + 4, (xl, xr)\n        g.page.mouse.down()\n        g.frames(3)\n        assert g.status()[\"sim\"][\"sg0\"][\"held\"]\n        g.page.mouse.up()\n        g.frames(2)\n        # Wheel cycles instruments.\n        t0 = g.status()[\"sim\"][\"tool\"]\n        g.page.mouse.wheel(0, 120)\n        g.frames(3)\n        assert g.status()[\"sim\"][\"tool\"] != t0\n        g.shot(\"op_inputs.png\")\n    finally:\n        g.close()\n\n'''\nt=t[:i]+new+t[j:]\nopen(p,'w').write(t)\nE\ntimeout 1500 python3 test_web.py t_operation_pad_and_mouse t_phone t_music_default_and_audio 2>&1 | grep -v \"^  \" | cut -c1-500 | tail -14","uuid":"023ed93e-4287-4137-9962-532d39059a4d","session_id":"c4040135-dd9a-415a-bbb7-ba7a9152393c"}
