          0 => self.cheat_immortal = on,\n                1 => self.cheat_freeze = on,\n                2 => {\n                    for s in self.sg.iter_mut() {\n                        s.unlocked_gift = true;\n                        s.gift = if on { 100.0 } else { 0.0 };\n                    }\n                }\n                3 => self.one_hit = on,\n                4 => self.sg[0].bot = on,\n                _ => {}\n            },\n            SurgeryCmd::Opt(k, v) => match k {\n                0 => self.xbox = v > 0.5,\n                1 => self.tremor_on = v > 0.5,\n                2 => self.assist_user = v,\n                _ => {}\n            },\n            SurgeryCmd::TimeScale(v) => self.time_scale = v.clamp(0.05, 4.0),\n            SurgeryCmd::BotSkill(v) => self.bot_skill = v,\n        }\"\"\")\ns=s.replace(\"    pub bot_skill: f32,\\n\",\"    pub bot_skill: f32,\\n    pub one_hit: bool,\\n\",1)\ns=s.replace(\"            bot_skill: 1.0,\\n\",\"            bot_skill: 1.0,\\n            one_hit: false,\\n\",1)\ns=s.replace(\"    fn handle_cmd(&mut self,\",\"    /// Runs a shell command now (dev tools, the app).\\n    pub fn command(&mut self, cmd: SurgeryCmd) {\\n        let mut ev = Vec::new();\\n        self.handle_cmd(cmd, &mut ev);\\n    }\\n\\n    fn handle_cmd(&mut self,\",1)\nopen(p,'w').write(s)\nE\ngrep -n \"one_hit\" crates/pav_core/src/games/surgery/mod.rs | head"}}}
