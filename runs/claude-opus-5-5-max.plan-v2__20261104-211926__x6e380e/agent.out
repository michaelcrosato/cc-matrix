n448:        SimEvent::Roll { .. } => vec![(\n452:        SimEvent::Spotted { .. } => vec![\n456:        SimEvent::Shot { .. } => {\n459:        SimEvent::Damage { .. } => {\n462:        SimEvent::Destroyed { size, .. } => {\n484:pub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n486:        SimEvent::Jump { pos }\n487:        | SimEvent::Land { pos, .. }\n488:        | SimEvent::Step { pos }\n489:        | SimEvent::Throw { pos }\n490:        | SimEvent::Explosion { pos, .. }\n491:        | SimEvent::Impact { pos, .. }\n492:        | SimEvent::Hit { pos, .. }\n493:        | SimEvent::Splash { pos }\n494:        | SimEvent::Grab { pos }\n495:        | SimEvent::Roll { pos }\n496:        | SimEvent::Break { pos }\n497:        | SimEvent::Crack { pos }\n498:        | SimEvent::Bounce { pos }\n499:        | SimEvent::Shot { pos }\n500:        | SimEvent::Damage { pos }\n501:        | SimEvent::Destroyed { pos, .. }\n502:        | SimEvent::Swing { pos, .. }\n503:        | SimEvent::Strike { pos, .. }\n504:        | SimEvent::Slain { pos, .. }\n505:        | SimEvent::Slam { pos, .. }\n506:        | SimEvent::Blast { pos, .. }\n507:        | SimEvent::Spell { pos, .. }\n508:        | SimEvent::Coin { pos }\n509:        | SimEvent::Loot { pos, .. }\n510:        | SimEvent::Pickup { pos, .. }\n511:        | SimEvent::Block { pos } => Some(*pos),\n517:pub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n532:pub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n556:pub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n594:    pub fn start() -> anyhow::Result<Self> {\n615:    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n628:    pub fn set_master(&self, v: f32) {\n634:    pub fn resume(&self) {\n640:fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Strea