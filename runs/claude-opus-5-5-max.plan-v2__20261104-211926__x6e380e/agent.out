{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W6HjVQxpPtP4fcjZYt8SSt","type":"tool_result","content":"//! Shardfall's game UI, drawn with egui: the HUD (`arpg_ui`), the inventory, shop, stash and\n//! character windows (`arpg_items`), the passive tree (`arpg_tree`) and the touch controls\n//! (`touch`). The window (`pav_app`) draws it over the game; the tools draw the same code on a\n//! headless context (`headless`): a text reading of what is on screen, and the UI over captures.\n\npub mod arpg_items;\npub mod arpg_tree;\npub mod arpg_ui;\npub mod headless;\npub mod touch;\n\n/// The input device the player is on: hints and the HUD follow it.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub enum Device {\n    #[default]\n    KeyboardMouse,\n    Gamepad,\n    /// A phone or tablet (touch.rs).\n    Touch,\n}\n\n/// Touch screens: bigger targets, a little bigger text, thicker scroll bars, and dragging\n/// scrolls. `on = false` puts the desktop sizes back.\npub fn touch_style(ctx: &egui::Context, on: bool) {\n    use egui::{FontId, TextStyle};\n    ctx.all_styles_mut(|s| {\n        s.spacing = egui::style::Spacing::default();\n        s.text_styles = egui::style::default_text_styles();\n        if on {\n            let sp = &mut s.spacing;\n            sp.interact_size = egui::vec2(44.0, 34.0);\n            sp.button_padding = egui::vec2(12.0, 7.0);\n            sp.item_spacing = egui::vec2(10.0, 8.0);\n            sp.slider_width = 170.0;\n            sp.icon_width = 20.0;\n            sp.icon_width_inner = 12.0;\n            sp.combo_height = 320.0;\n            sp.scroll = egui::style::ScrollStyle::solid();\n            sp.scroll.bar_width = 8.0;\n            for (style, size) in\n                [(TextStyle::Body, 15.0), (TextStyle::Button, 15.0), (TextStyle::Small, 12.0), (TextStyle::Heading, 20.0)]\n            {\n                s.text_styles.insert(style, FontId::proportional(size));\n            }\n            s.interaction.tooltip_delay = 0.35;\n        }\n    });\n}\n\n/// A `pav_core::games` game's HUD lines (`Game::hud`), top left.\npub fn game_lines(ctx: &egui::Context, h: &pav_core::frame::HudFrame) {\n    if h.lines.is_empty() {\n        return;\n    }\n    egui::Area::new(egui::Id::new(\"game_lines\")).anchor(egui::Align2::LEFT_TOP, [16.0, 60.0]).show(ctx, |ui| {\n        egui::Frame::popup(ui.style()).show(ui, |ui| {\n            for line in &h.lines {\n                ui.label(egui::RichText::new(line).monospace().size(18.0).strong());\n            }\n        });\n167:pub fn pause_menu(\n168-    ctx: &egui::Context,\n169-    device: Device,\n170-    scene: &str,\n171-    difficulty: Option<&mut pav_core::arpg::Difficulty>,\n172-) -> Option<MenuAction> {\n173-    let mut action = None;\n174-    let game = difficulty.is_some();\n175-    egui::Window::new(\"Paused\")\n176-        .anchor(egui::Align2::CENTER_CENTER, [0.0, 0.0])\n177-        .collapsible(false)\n178-        .resizable(false)\n179-        .show(ctx, |ui| {\n180-            ui.label(format!(\"Room: {scene}\"));\n181-            ui.horizontal(|ui| {\n182-                if ui.button(\"Resume (Esc)\").clicked() {\n183-                    action = Some(MenuAction::Resume);\n184-                }\n185-                if ui.button(\"Rooms (F2)\").clicked() {\n186-                    action = Some(MenuAction::Rooms);\n187-                }\n188-                if ui.button(\"Room info\").clicked() {\n189-                    action = Some(MenuAction::RoomCard);\n190-                }\n191-                if ui.button(\"Reset scene\").clicked() {\n192-                    action = Some(MenuAction::Reset);\n193-                }\n194-                if ui.button(\"Tuning (F1)\").clicked() {\n195-                    action = Some(MenuAction::Tuning);\n196-                }\n197-                if ui\n198-                    .button(\"Look & filters\")\n199-                    .on_hover_text(\"Pixel art, cel shading, outlines, palettes, grading and more, on the whole scene, the characters & objects or the environment\")\n200-                    .clicked()\n201-                {\n202-                    action = Some(MenuAction::Look);\n203-                }\n204-                if ui.button(\"Animation Studio\").clicked() {\n205-                    action = Some(MenuAction::AnimationStudio);\n206-                }\n207-                if ui.button(\"Object Studio\").clicked() {\n208-                    action = Some(MenuAction::AssetStudio);\n209-                }\n210-                if ui.button(\"Creature Studio\").clicked() {\n211-                    action = Some(MenuAction::CreatureStudio);\n212-                }\n213-                if !game\n214-                    && ui\n215-                        .button(\"How it works (H)\")\n216-                        .on_hover_text(\"The station guide of the room you are in: how it works, where games use it, how to ask for it\")\n217-                        .clicked()\n218-                {\n219-                    action = Some(MenuAction::Guide);\n220-                }\n221-                if !game && ui.button(\"Field guide\").on_hover_text(\"Every word, and what to ask for in every room\").clicked() {\n222-                    action = Some(MenuAction::FieldGuide);\n223-                }\n224-                if ui.button(\"Feel metrics\").clicked() {\n225-                    action = Some(MenuAction::Feel);\n226-                }\n227-                if ui.button(\"Physics stats\").clicked() {\ncrates/pav_core/src/sim.rs:973:            course: c.hud(self.state.tick, self.dt()),\ncrates/pav_core/src/sim.rs:986:            lines: self.play_hud(),\ncrates/pav_app/src/app.rs:345:        } else if self.hud.teleport_open {\ncrates/pav_app/src/app.rs:346:            self.hud.teleport_open = false;\ncrates/pav_app/src/app.rs:347:        } else if self.hud.card_visible() {\ncrates/pav_app/src/app.rs:348:            self.hud.hide_card();\nc