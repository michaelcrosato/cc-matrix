k\": [8,50], \"TwoFootJump_Walk\": [11,49], \"WalkingStickLeft_Walk\": [10,79], \"WalkingStickRight_Walk\": [10,83], \"Waving_Walk\": [14,130], \"WhirlArms_Walk\": [11,75], \"WideLegs_Walk\": [21,157], \"WiggleHips_Walk\": [28,158], \"WildArms_Walk\": [9,72], \"WildLegs_Walk\": [71,546], \"Zombie_Walk\": [8,48]},\n5198:\"Swat_Walk\": {\"clip\": \"Swat_Walk\", \"src\": \"100STYLE\", \"take\": \"Swat_FW 81.57-82.68\", \"dur\": 1.133, \"loop\": true, \"speed\": 68, \"tags\": [\"walk\",\"style\"], \"desc\": \"As if holding a rifle and raiding a building\", \"keys\": [\n//! Game data from /game (embedded at build time; `reload` re-reads the folder for live\n//! editing). Every table is plain TOML: skills, monster families, and later items, the\n//! passive tree, themes and levels.\n\nuse std::collections::BTreeMap;\nuse std::sync::{Arc, RwLock};\n\nuse serde::{Deserialize, Serialize};\n\nuse super::items::{AffixDef, BaseDef, Slot, UniqueDef};\nuse super::stats::Stat;\nuse crate::moves::MoveId;\nuse crate::puppet::{BodyPlan, PuppetDef};\n\ninclude!(concat!(env!(\"OUT_DIR\"), \"/game_data.rs\"));\n\n/// The text of a data file (`\"skills\"`, `\"levels/01_shrines\"`), embedded or from disk.\npub fn source(key: &str) -> Option<String> {\n    if let Some(dir) = disk_dir() {\n        if let Ok(t) = std::fs::read_to_string(dir.join(format!(\"{key}.toml\"))) {\n            return Some(t);\n        }\n    }\n    GAME_DATA.iter().find(|(k, _)| *k == key).map(|(_, v)| v.to_string())\n}\n\n/// Keys of the data files under a folder (`\"levels\"`).\npub fn keys_under(prefix: &str) -> Vec<String> {\n    let p = format!(\"{prefix}/\");\n    let mut v: Vec<String> = GAME_DATA.iter().filter(|(k, _)| k.starts_with(&p)).map(|(k, _)| k.to_string()).collect();","is_error":false}]},"parent_tool_use_id":null,"session_id":"b664ff9f-3df3-486c-8cc6-7a0b3ccfba7c","uuid":"8e52b05d-8aa9-434a-8dd1-301b7f1ef110","timestamp":"2026-11-05T04:41:13.281Z","tool_use_result":{"stdout":"sheet: poke, hidden, z_