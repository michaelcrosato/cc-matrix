{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0159536YbJJz4yyY6FRuLSZx","type":"tool_result","content":" */\n\nimport { createServer } from 'node:http';\nimport { createRequire } from 'node:module';\nimport { mkdir, readdir, readFile, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { staticHandler } from './lib/serve.mjs';\nimport { modeOf, SELF_REPORTED } from '../lib/hub/round.js';\nimport { findClients } from './lib/hub-client.mjs';\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst EXAMPLES = ['/lib/hub/examples/arena.html', '/lib/hub/examples/ghost.html', '/lib/hub/examples/parallel.html'];\nconst PAGE_MS = 300_000;\n\nconst args = process.argv.slice(2);\nconst option = (name, fallback) => {\n  const at = args.indexOf(`--${name}`);\n  if (at === -1) return fallback;\n  const [value] = args.splice(at, 2).slice(1);\n  return value;\n};\nconst asked = option('players', null);\nlet base = option('base', null);\nconst original = option('original', null);\nconst asJson = args.includes('--json');\nconst solo = !args.includes('--no-solo');\nconst retrofit = args.includes('--retrofit');\nconst drawsOnly = args.includes('--draws-only');\nconst record = args.includes('--record');\n/** Extra flags for the browser, e.g. the ones that give it WebGPU where the machine can (lib/kit/README.md). */\nconst browserArgs = (option('browser-args', '') || '').split(/\\s+/).filter(Boolean);\nconst asPath = (g) => (g.startsWith('/') || /^https?:/.test(g) ? g : `/${g}`);\nconst games = args.filter((a) => !a.startsWith('--')).map(asPath);\nif (!games.length) games.push(...EXAMPLES);\n\n/**\n * The player counts to try: as asked, or by the game's mode, within the seats\n * the game takes. Parallel shares nothing, so 1 and 2 say it all.\n */\nfunction countsFor(mode, [least, most]) {\n  const list = asked ?? (mode === 'parallel' ? '1,2' : '2,3,4');\n  return list.split(',').map(Number).filter((n) => n >= 1 && n <= 4 && (asked || (n >= least && n <= most)));\n}\n\n/** The game's session mode (older tags read as today's) and its seats, from its head. */\nasync function headOf(game) {\n  try {\n    const html = await (await fetch(/^https?:/.test(game) ? game : `${base}${game}`)).text();\n    const meta = (name) => html.match(new RegExp(`<meta\\\\s+name=[\"']${name}[\"']\\\\s+content=[\"']([^\"']+)[\"']`, 'i'))?.[1] ?? null;\n    const [least = 1, most = least] = (meta('hub:session-players')?.match(/\\d+/g) ?? []).map(Number);\n    return { mode: modeOf(meta('hub:session-mode')), seats: [least, most] };\n  } catch {\n    return { mode: null, seats: [1, 4] };\n  }\n}\n\nlet chromium;\ntry {\n  ({ chromium } = createRequire(import.meta.url)('playwright'));\n} catch {\n  console.error('hub-check needs Playwright: pnpm add -D playwright && pnpm exec playwright install chromium');\n  process.exit(2);\n}\n\n/**\n * Runs in every frame before its own scripts: it notes what the page asks of\n * the graphics stack, and session-mode pages are watched for dialogs and sockets.\n */\nfunction watch() {\n8: * once more with the host leaving. Then the game on its own, outside a session:\n9: * it opens, Enter and Space are pressed, and it must draw its screen with no\n29: * original page already had are forgiven when it is opened on its own.\n30: * --draws-only does only that last part, for any page: the retrofit runs it on\n33: * when its title screen shows: it asked for an adapter, got none, and drew\n36: * software adapter:\n37: *   --browser-args \"--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-webgpu-adapter=swiftshader --use-angle=swiftshader\"\n47: * Usage:  node scripts/hub-check.mjs [game paths…] [--players 2,3,4] [--base URL] [--json] [--no-solo]\n48: *                                    [--retrofit [--original <path>]] [--draws-only] [--record] [--browser-args \"<flags>\"]\n77:const solo = !args.includes('--no-solo');\n79:const drawsOnly = args.includes('--draws-only');\n112:  console.error('hub-check needs Playwright: pnpm add -D playwright && pnpm exec playwright install chromium');\n121:  // What the page asked of the graphics stack: a WebGPU adapter it never got, and\n131:        const adapter = await ask(...a);\n132:        if (adapter) gfx.gotAdapter = true;\n133:        return adapter;\n178:    if (drawsOnly) {\n180:      runs.push({ game, players: 1, scenario: 'draws', pass: report.pass, checks: report.checks });\n181:      if (!asJson) console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  draws on its own`);\n187:      if (!asJson && !client.pass) console.log(`FAIL  ${game}  ✗ ${client.name} — ${client.detail}`);\n203:      page.on('pageerror', (e) => pageErrors.push(e.message));\n204:      page.on('console', (m) => m.text().startsWith('[AIHub]') && warnings.push(m.text()));\n224:        console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  ${n} players  ${scenario}`);\n225:        for (const c of report.checks) if (!c.pass) console.log(`        ✗ ${c.name}${c.detail ? ` — ${c.detail}` : ''}`);\n229:    if (solo) {\n233:        console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  on its own`);\n234:        for (const c of report.checks) if (!c.pass) console.log(`        ✗ ${c.name}${c.detail ? ` — ${c.detail}` : ''}`);\n266: * The game on its own: open it as someone at the wall would, press Enter and\n279:    tab.on('pageerror', (e) => errors.push(e.message));\n282:    for (const key of ['Enter', 'Space', 'Enter', 'Space']) {\n289:    // A WebGL or WebGPU canvas often reads back blank from a script, so look at the screen instead:\n290:    // a blank one compresses to almost nothing, so a PNG past a blank page's size means something is drawn.\n291:    const bytes = (await tab.screenshot({ type: 'png' }).catch(() => Buffer.alloc(0))).length;\n295:  const blank = await (async () => {\n299:    const bytes = (await tab.screenshot({ type: 'png' })).length;\n305:  after.drawn = after.bytes > blank + 1200;\n309:    check('on its own: the session client is there and inactive', after.hub && after.hub.active === false, JSON.stringify(after.hub));\n311:    check('on its own: Math.random is left alone', after.hub && after.hub.seeded !== true, JSON.stringify(after.hub));\n315:  const asked = g ? `WebGPU ${g.askedForWebGPU ? (g.gotAdapter ? 'asked, adapter' : 'asked, no adapter') : 'not asked'}; WebGL ${g.webgl ? 'yes' : 'no'}; 2D ${g.twoD ? 'yes' : 'no'}` : 'not seen';\n316:  check('on its own: this browser can run it', !noWebGPU, noWebGPU ? `it asked for WebGPU, this browser has no adapter, and drew nothing with WebGL or 2D instead (${asked})` : asked);\n317:  check('on its own: it draws its screen', after.drawn, `${after.bytes} bytes of screenshot, a blank screen is ${blank}`);\n319:  if (!bare) check(`on its own: no errors${before ? ' the original did not have' : ''}`, !fresh.length, fresh.slice(0, 3).join('; '));\n332:    console.log('--record needs data/games.json: run pnpm scan first');\n343:      console.log(`--record: ${game} is not in the catalogue, nothing recorded`);\n359:    console.log(`--record: ${slug} ${failed.length ? 'kept out of sessions' : 'may be dealt'}`);\n368:if (asJson) console.log(JSON.stringify({ pass, runs }, null, 2));\n369:else console.log(`\\n${pass ? 'All checks passed' : 'Some checks failed'} — report in .cache/hub-check.json`);\n52:import { createServer } from 'node:http';\n53:import { createRequire } from 'node:module';\n54:import { mkdir, readdir, readFile, writeFile } from 'node:fs/promises';\n55:import path from 'node:path';\n56:import { fileURLToPath } from 'node:url';\n58:import { staticHandler } from './lib/serve.mjs';\n59:import { modeOf, SELF_REPORTED } from '../lib/hub/round.js';\n60:import { findClients } from './lib/hub-client.mjs';\naudio-inventory.mjs\ndates.mjs\nfill.mjs\nhub-client.mjs\nhub-pages.mjs\nimport-registry.mjs\nintake.mjs\nlayout.mjs\nlibraries.mjs\nmat