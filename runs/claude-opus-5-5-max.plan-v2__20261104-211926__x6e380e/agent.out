.\"),\ncrates/pav_core/src/world.rs:2://! corridors, and an infinite procedural wilderness around it. Everything streams around\ncrates/pav_core/src/world.rs:22:use crate::terrain::{Footprint, TerrainGen};\ncrates/pav_core/src/world.rs:98:    /// False for small test scenes (no hub, no terrain, no streaming).\ncrates/pav_core/src/world.rs:105:    /// Corridor ends (feet positions) leading out into the wilderness.\ncrates/pav_core/src/world.rs:373:    /// Sets up the full world (hub, rooms, wilderness) and spawns the player on the plaza.\ncrates/pav_core/src/world.rs:783:        let tp = self.config.terrain.clone();\ncrates/pav_core/src/world.rs:914:            st.statics.set_terrain(&mut st.physics, key, Arc::new(patch));\ncrates/pav_core/src/world.rs:955:    /// Puts a region to sleep: statics go dormant, its entities are stored. For terrain chunks\ncrates/pav_core/src/world.rs:1004:            // Untouched terrain: drop it, it regenerates from the seed.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01V81twH8RRu891BfPTz7Mqa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
