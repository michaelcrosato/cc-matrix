screenshot(path=f\"shots-web-{w}.png\")\n        ctx.close()\n    b.close()\nEOF\ntimeout 280 python3 spike-web.py spike/spike.html 2>&1 | cut -c1-500","description":"Measure load time and frame rate of the single-file page","timeout":300000}}}
