'?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n</script>\n</body>\n</html>\n---\n/**\n * bridge.js — the hub's end of one game frame in a session.\n *\n * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\n * The bridge checks every message, enforces the limits, and routes it: control\n * messages (hello, ready, result, finish, error) to whoever coordinates the\n * round (lib/hub/round.js), game traffic straight to the other players, and a\n * game's answers on its own card to the page that holds it. What\n * comes back from the network is checked again before it reaches the game,\n * and anything from another round is dropped, so a slow packet can never land\n * in the next game.\n *\n * The network is anything with `send(toKey, envelope, {reliable})`: the\n * simulated one below (harness, tests), a BroadcastChannel between tabs, or a\n * WebRTC mesh. Envelopes:\n *   {k:'c', r, m}       to the coordinator: a message from this game\n *   {k:'h', r, m}       from the coordinator: welcome, start, leave, time-up, end\n *   {k:'g', r, f, d}    game traffic from player id f\n *   {k:'p', r, f, d}    player id f's progress, {score, label}, for the scoreboard\n */\n\nexport const LIMITS = Object.freeze({\n  maxBytes: 16_384,\n  ratePerS: 20,\n  burst: 40,\n  queueMessages: 64,\n  queueBytes: 262_144,\n  /**\n   * progress() reaches the hub about once a second. Two closer than this are a\n   * report delivered late (a long task in the game) or a client misbehaving:\n   * the later is dropped, and the next report, a second on, has the newest score.\n   */\n  progressMs: 250,\n  label: 24,\n});\n\nconst FROM_GAME = new Set(['hello', 'ready', 'send', 'result', 'finish', 'error', 'progress', 'fullscreen', 'answer']);\n\n/** A progress report, checked: a finite score and an optional short label. Null when it is not one. */\nexport function cleanProgress(p) {\n  if (!p || typeof p !== 'object') return null;\n  // A number, or text that is one: never null, '', true or [], which Number() would make 0 or 1.\n  const score = typeof p.score === 'number' || (typeof p.score === 'string' && p.score.trim() !== '') ? Number(p.score) : NaN;\n  if (!Number.isFinite(score)) return null;\n  const label = typeof p.label === 'string' ? p.label.trim().slice(0, LIMITS.label) : '';\n  return label ? { score, label } : { score };\n}\n\n/**\n * @param {object} o\n * @param {string} o.key              this player's key in the session\n * @param {number} o.round\n * @param {string} o.coordinator      key of whoever runs round.js\n * @param {(msg:object) => void} o.post            to the game frame\n * @param {{send:Function}} o.net\n * @param {{now:()=>number}} [o.clock]             the coordinator's time, as seen here\n * @param {(issue:{key:string, problem:string}) => void} [o.onIssue]\n * @param {(id:number, progress:{score:number, label?:string}) => void} [o.onProgress]   a player's\n *        progress, this one's included, for the hub's scoreboard; it never reaches the games\n * @param {(on:boolean) => void} [o.onFullscreen]   the game asked for fullscreen (or out of it): the\nbridge.js:262: * Wire a bridge to an iframe: only messages from that frame's window count.\nharness.html:27:  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\nharness.html:115: * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\nharness.html:146:        log(`${cell.name}: ${name}() called — not allowed in a session`);\nharness.html:210:    const frame = document.createElement('iframe');\nharness.html:211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\n * without waiting for one.\n *\n * Players are known by `key` (whatever the session calls them); games see\n * contiguous ids 0..N-1 in slot order.\n */\n\nexport const TIMINGS = Object.freeze({\n  helloMs: 10_000,\n  readyMs: 45_000,\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n  loadGraceMs: 20_000,\n  countdownMs: 3_000,\n  graceMs: 5_000,\n  hiddenMs: 20_000,\n  maxRoundMs: 15 * 60_000,\n});\n\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n\n/** Each mode's name on screen. */\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\n\n/** The mode a tag or a hello names, older tags included; null for anything else. */\nexport function modeOf(word) {\n  const w = String(word ?? '').trim().toLowerCase();\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\n}\n\n/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\nexport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n\n/**\n * Whether a game's round carries the seed in its address, so the client seeds\n * Math.random and every copy starts the same: read from the game's own tag,\n * parallel or ghost. A game still tagged race was built for an unseeded start\n * (ids it makes from Math.random must differ between its copies), so it keeps one.\nREADME.md\nhub\nkit\nrapier\nthree\nthree-addons.exclude\nvendor\n# AI Hub sessions: the hub's side\n\nWhat the hub does around a round, and how a round travels between the\ndevices. Games never need this page: the protocol a game follows is\n`lib/hub/README.md` (served at\n<https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md>), and that is the only\nthing the game factory is given. This page is for whoever changes the hub:\n`lib/hub/` (client, bridge, round, harness) and `assets/js/session/` (the\nsession page).\n\n## Around a round\n\nA game only plays its round. Everything around it belongs to the hub and is\nthe same for every game, so players learn it once.\n\n### Points and wins\n\n- Each round, a player scores **one point for every player they beat**. A\n  player who left or sat out without reporting counts as beaten; one who\n  reported and then left keeps their place. Tied players share a place. Every\n  round of four is worth three points to its winner, whatever the game.\n- **First place is a win**; in a team result (a shared world's `finish` with\n  `won`) only when the team won.\n- The **table** orders players by points, then wins, then the better average\n  place (`assets/js/session/score.js`).\n\n### Awards\n\n- **Game awards** come from a game's `result()` or `finish()`. The hub shows\n  them on the results, in the player's colour, and counts them for the\n  session.\n- **Session awards** are the hub's, given when a session ends:\n  **Showstopper** (most game awards), **Hot streak** (most wins in a row, at\n  least two) and **Steady hand** (best average place).\n\n### Ways to win a session\n\nThe host picks a format in the lobby:\n\n| Format | Ends | Winner |\n|---|---|---|\n| **Party** (default) | after 8 rounds | most points, after the three session awards add **3 bonus points** each, so the last word is never certain |\n| **Sprint** | after 5 rounds | most points |\n| **First to 12** | when someone has 12 points after a round | that player |\n| **Endless** | when the host ends it | most points |\n\nTies go to more wins, then the better average place, and otherwise stay ties.\n\n### The deal\n\nThe host's own picks come first: **Up next** in the lobby, the games the host\nchose (`state.queue`, at most twelve slugs), played in their order before\nRandom Mode deals. The host picks from every game that seats the players\npresent and that every seat's browser can run; the deal's filters and the\ntouch-screen rule narrow only Random Mode. A pick that does not seat the\nplayers yet keeps its place for a later round. A session hosted from a game's\npage in the Friends view (`/session?first=<slug>`) starts with that game in\nthe list, and the address drops it once the session has it. The round's\nstate says `picked: true`, and its card reads *The host's pick*. A pick is\nadded to the played list, so Random Mode does not deal it again in the same","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01TPUoEWuJMfGYwkpGsDgbMS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
