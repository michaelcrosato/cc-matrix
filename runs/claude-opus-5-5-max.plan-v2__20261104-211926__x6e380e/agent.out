{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DKwDojjeiBjo4MxzeFtSYR","type":"tool_result","content":"1\t//! Lightweight projectiles: plain structs moved by the simulation (no physics bodies), so\n2\t//! thousands are cheap. They stop at static geometry and hit characters (capsule test).\n3\t\n4\tuse glam::Vec3;\n5\tuse rapier::prelude::*;\n6\tuse serde::{Deserialize, Serialize};\n7\t\n8\tuse crate::character::RADIUS;\n9\tuse crate::color::Color;\n10\tuse crate::entity::EntityId;\n11\t\n12\t#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\n13\tpub struct Projectile {\n14\t    pub pos: Vec3,\n15\t    pub vel: Vec3,\n16\t    pub radius: f32,\n17\t    /// Seconds left.\n18\t    pub life: f32,\n19\t    pub color: Color,\n20\t    pub knockback: f32,\n21\t    pub gravity: f32,\n22\t    /// The emitter (or character) that fired it; it never hits its owner.\n23\t    pub owner: Option<EntityId>,\n24\t    /// Player shots damage enemies (things with health); enemy shots hit characters.\n25\t    #[serde(default)]\n26\t    pub team: Team,\n27\t    #[serde(default = \"one\")]\n28\t    pub damage: f32,\n29\t}\n30\t\n31\tfn one() -> f32 {\n32\t    1.0\n33\t}\n34\t\n35\t#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n36\tpub enum Team {\n37\t    #[default]\n38\t    Enemy,\n39\t    Player,\n40\t}\n41\t\n42\t/// Something with health that player shots can hit: id, centre, radius.\n43\t#[derive(Clone, Copy, Debug)]\n44\tpub struct Enemy {\n45\t    pub id: EntityId,\n46\t    pub center: Vec3,\n47\t    pub radius: f32,\n48\t}\n49\t\n50\t#[derive(Clone, Debug, Default, Serialize, Deserialize)]\n51\tpub struct Projectiles {\n52\t    pub list: Vec<Projectile>,\n53\t}\n54\t\n55\t/// Hard cap so a runaway emitter can't eat the machine.\n56\tpub const MAX_PROJECTILES: usize = 6000;\n57\t\n58\t/// A character's capsule for hit tests: feet position, height.\n59\t#[derive(Clone, Copy, Debug)]\n60\tpub struct Target {\n61\t    pub id: EntityId,\n62\t    pub feet: Vec3,\n63\t    pub height: f32,\n64\t    /// Hit radius (a small hitbox makes dense bullet patterns fair).\n65\t    pub radius: f32,\n66\t}\n67\t\n68\t/// What happened to projectiles this tick.\n69\t#[derive(Default)]\n70\tpub struct ProjectileStep {\n71\t    pub hits: Vec<(EntityId, Vec3, Vec3, f32)>, // target, position, direction, knockback\n72\t    /// Enemies hit by player shots: enemy, position, damage.\n73\t    pub damage: Vec<(EntityId, Vec3, f32)>,\n74\t    pub impacts: usize,\n75\t}\n76\t\n77\tfn segment_distance(p: Vec3, a: Vec3, b: Vec3) -> f32 {\n78\t    let ab = b - a;\n79\t    let t = ((p - a).dot(ab) / ab.length_squared().max(1e-6)).clamp(0.0, 1.0);\n80\t    p.distance(a + ab * t)\n81\t}\n82\t\n83\timpl Projectiles {\n84\t    pub fn spawn(&mut self, p: Projectile) {\n85\t        if self.list.len() < MAX_PROJECTILES {\n86\t            self.list.push(p);\n87\t        }\n88\t    }\n89\t\n90\t    /// Moves every projectile; removes the ones that hit geometry, characters or expire.\n91\t    /// `blocked(from, dir, len)` casts against static geometry.\n92\t    pub fn step(\n93\t        &mut self,\n94\t        dt: f32,\n95\t        targets: &[Target],\n96\t        enemies: &[Enemy],\n97\t        mut blocked: impl FnMut(Vec3, Vec3, f32, Option<EntityId>) -> bool,\n98\t    ) -> ProjectileStep {\n99\t        let mut out = ProjectileStep::default();\n100\t        self.list.retain_mut(|p| {\n101\t            p.life -= dt;\n102\t            if p.life <= 0.0 {\n103\t                return false;\n104\t            }\n105\t            p.vel.y -= p.gravity * dt;\n106\t            let step = p.vel * dt;\n107\t            let len = step.length();\n108\t            let next = p.pos + step;\n109\t            if p.team == Team::Player {\n110\t                for e in enemies {\n111\t                    if Some(e.id) == p.owner {\n112\t                        continue;\n113\t                    }\n114\t                    if segment_distance(e.center, p.pos, next) < e.radius + p.radius {\n115\t                        out.damage.push((e.id, next, p.damage));\n116\t                        return false;\n117\t                    }\n118\t                }\n119\t            } else {\n120\t                for t in targets {\n121\t                    if Some(t.id) == p.owner {\n122\t                        continue;\n123\t                    }\n124\t                    let a = t.feet + Vec3::Y * RADIUS;\n125\t                    let b = t.feet + Vec3::Y * (t.height - RADIUS).max(RADIUS);\n126\t                    // Test the midpoint and the end so fast bullets don't skip through.\n127\t                    let d = segment_distance(next, a, b).min(segment_distance(p.pos + step * 0.5, a, b));\n128\t                    if d < t.radius + p.radius {\n129\t                        out.hits.push((t.id, next, p.vel.normalize_or(Vec3::X), p.knockback));\n130\t                        return false;\n131\t                    }\n132\t                }\n133\t            }\n134\t            if len > 1e-6 && blocked(p.pos, step / len, len + p.radius * 0.5, p.owner) {\n135\t                out.impacts += 1;\n136\t                return false;\n137\t            }\n138\t            p.pos = next;\n139\t            true\n140\t        });\n141\t        out\n142\t    }\n143\t}\n144\t\n145\t/// Ray test against fixed geometry (static blocks, terrain, fixed bodies) only, ignoring the\n146\t/// shooter's own body (a turret).\n147\tpub fn static_blocked(\n148\t    physics: &crate::physics::PhysicsState,\n149\t    from: Vec3,\n150\t    dir: Vec3,\n151\t    len: f32,\n152\t    ignore: Option<RigidBodyHandle>,\n153\t) -> bool {\n154\t    let mut filter = QueryFilter::only_fixed().exclude_sensors();\n155\t    if let Some(b) = ignore {\n156\t        filter = filter.exclude_rigid_body(b);\n157\t    }\n158\t    let qp = physics.query_filtered(filter);\n159\t    let ray = Ray::new(from, dir);\n160\t    qp.cast_ray(&ray, len as Real, true).is_some()\n161\t}\n162\t\n163\t/// Distance along `dir` to fixed geometry within `len`, if any.\n164\tpub fn static_hit(\n165\t    physics: &crate::physics::PhysicsState,\n166\t    from: Vec3,\n167\t    dir: Vec3,\n168\t    len: f32,\n169\t    ignore: Option<RigidBodyHandle>,\n170\t) -> Option<f32> {\n171\t    let mut filter = QueryFilter::only_fixed().exclude_sensors();\n172\t    if let Some(b) = ignore {\n173\t        filter = filter.exclude_rigid_body(b);\n174\t    }\n175\t    let qp = physics.query_filtered(filter);\n176\t    qp.cast_ray(&Ray::new(from, dir), len as Real, true).map(|(_, t)| t as f32)\n177\t}\n178\t"}]},"parent_tool_use_id":null,"session_id":"b664ff9f-3df3-486c-8cc6-7a0b3ccfba7c","uuid":"06c8934d-eb97-4937-932c-55db6a4c3739","timestamp":"2026-11-05T04:24:37.483Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211926__x6e380e/work/.research/shardfall/repo/crates/pav_core/src/projectile.rs","content":"//! Lightweight projectiles: plain structs moved by the simulation (no physics bodies), so\n//! thousands are cheap. They stop at static geometry and hit characters (capsule test).\n\nuse glam::Vec3;\nuse rapier::prelude::*;\nuse serde::{Deserialize, Serialize};\n\nuse crate::character::RADIUS;\nuse crate::color::Color;\nuse crate::entity::EntityId;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Projectile {\n    pub pos: Vec3,\n    pub vel: Vec3,\n    pub radius: f32,\n    /// Seconds left.\n    pub life: f32,\n    pub color: Color,\n    pub knockback: f32,\n    pub gravity: f32,\n    /// The emitter (or character) that fired it; it never hits its owner.\n    pub owner: Option<EntityId>,\n    /// Player shots damage enemies (things with health); enemy shots hit characters.\n    #[serde(default)]\n    pub team: Team,\n    #[serde(default = \"one\")]\n    pub damage: f32,\n}\n\nfn one() -> f32 {\n    1.0\n}\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Team {\n    #[default]\n    Enemy,\n    Player,\n}\n\n/// Something with health that player shots can hit: id, centre, radius.\n#[derive(Clone, Copy, Debug)]\npub struct Enemy {\n    pub id: EntityId,\n    pub center: Vec3,\n    pub radius: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Projectiles {\n    pub list: Vec<Projectile>,\n}\n\n/// Hard cap so a runaway emitter can't eat the machine.\npub const MAX_PROJECTILES: usize = 6000;\n\n/// A character's capsule for hit tests: feet position, height.\n#[derive(Clone, Copy, Debug)]\npub struct Target {\n    pub id: EntityId,\n    pub feet: Vec3,\n    pub height: f32,\n    /// Hit radius (a small hitbox makes dense bullet patterns fair).\n    pub radius: f32,\n}\n\n/// What happened to projectiles this tick.\n#[derive(Default)]\npub struct ProjectileStep {\n    pub hits: Vec<(EntityId, Vec3, Vec3, f32)>, // target, position, direction, knockback\n    /// Enemies hit by player shots: enemy, position, damage.\n    pub damage: Vec<(EntityId, Vec3, f32)>,\n    pub impacts: usize,\n}\n\nfn segment_distance(p: Vec3, a: Vec3, b: Vec3) -> f32 {\n    let ab = b - a;\n    let t = ((p - a).dot(ab) / ab.length_squared().max(1e-6)).clamp(0.0, 1.0);\n    p.distance(a + ab * t)\n}\n\nimpl Projectiles {\n    pub fn spawn(&mut self, p: Projectile) {\n        if self.list.len() < MAX_PROJECTILES {\n            self.list.push(p);\n        }\n    }\n\n    /// Moves every projectile; removes the ones that hit geometry, characters or expire.\n    /// `blocked(from, dir, len)` casts against static geometry.\n    pub fn step(\n        &mut self,\n        dt: f32,\n        targets: &[Target],\n        enemies: &[Enemy],\n        mut blocked: impl FnMut(Vec3, Vec3, f32, Option<EntityId>) -> bool,\n    ) -> ProjectileStep {\n        let mut out = ProjectileStep::default();\n        self.list.retain_mut(|p| {\n            p.life -= dt;\n            if p.life <= 0.0 {\n                return false;\n            }\n            p.vel.y -= p.gravity * dt;\n            let step = p.vel * dt;\n            let len = step.length();\n            let next = p.pos + step;\n            if p.team == Team::Player {\n                for e in enemies {\n                    if Some(e.id) == p.owner {\n                        continue;\n                    }\n                    if segment_distance(e.center, p.pos, next) < e.radius + p.radius {\n                        out.damage.push((e.id, next, p.damage));\n                        return false;\n                    }\n                }\n            } else {\n                for t in targets {\n                    if Some(t.id) == p.owner {\n                        continue;\n                    }\n                    let a = t.feet + Vec3::Y * RADIUS;\n                    let b = t.feet + Vec3::Y * (t.height - RADIUS).max(RADIUS);\n                    // Test the midpoint and the end so fast bullets don't skip through.\n                    let d = segment_distance(next, a, b).min(segment_distance(p.pos + step * 0.5, a, b));\n                    if d < t.radius + p.radius {\n                        out.hits.push((t.id, next, p.vel.normalize_or(Vec3::X), p.knockback));\n                        return false;\n                    }\n                }\n            }\n            if len > 1e-6 && blocked(p.pos, step / len, len + p.radius * 0.5, p.owner) {\n                out.impacts += 1;\n                return false;\n            }\n            p.pos = next;\n            true\n        });\n        out\n    }\n}\n\n/// Ray test against fixed geometry (static blocks, terrain, fixed bodies) only, ignoring the\n/// shooter's own body (a turret).\npub fn static_blocked(\n    physics: &crate::physics::PhysicsState,\n    from: Vec3,\n    dir: Vec3,\n    len: f32,\n    ignore: Option<RigidBodyHandle>,\n) -> bool {\n    let mut filter = QueryFilter::only_fixed().exclude_sensors();\n    if let Some(b) = ignore {\n        filter = filter.exclude_rigid_body(b);\n    }\n    let qp = physics.query_filtered(filter);\n    let ray = Ray::new(from, dir);\n    qp.cast_ray(&ray, len as Real, true).is_some()\n}\n\n/// Distance along `dir` to fixed geometry within `len`, if any.\npub fn static_hit(\n    physics: &crate::physics::PhysicsState,\n    from: Vec3,\n    dir: Vec3,\n    len: f32,\n    ignore: Option<RigidBodyHandle>,\n) -> Option<f32> {\n    let mut filter = QueryFilter::only_fixed().exclude_sensors();\n    if let Some(b) = ignore {\n        filter = filter.exclude_rigid_body(b);\n    }\n    let qp = physics.query_filtered(filter);\n    qp.cast_ray(&Ray::new(from, dir), len as Real, true).map(|(_, t)| t as f32)\n}\n","numLines":178,"startLine":1,"totalLines":178}},"tool_result_meta":[{"id":"toolu_01DKwDojjeiBjo4MxzeFtSYR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
