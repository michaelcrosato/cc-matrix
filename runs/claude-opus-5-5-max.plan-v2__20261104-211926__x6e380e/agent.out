{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GtXCjxGPi5sznqxLA77ejd","type":"tool_result","content":"[{\"help\":\"Force one surface style everywhere\",\"kind\":{\"Choice\":{\"options\":[\"per object\",\"flat\",\"cel\",\"lit\"]}},\"path\":\"view.style\",\"value\":\"per object\"},{\"help\":\"Surface style of the characters and objects (when style is per object)\",\"kind\":{\"Choice\":{\"options\":[\"per object\",\"flat\",\"cel\",\"lit\"]}},\"path\":\"view.style_objects\",\"value\":\"per object\"},{\"help\":\"Surface style of the environment (when style is per object)\",\"kind\":{\"Choice\":{\"options\":[\"per object\",\"flat\",\"cel\",\"lit\"]}},\"path\":\"view.style_environment\",\"value\":\"per object\"},{\"help\":\"Screen-space outlines\",\"kind\":\"Bool\",\"path\":\"view.outlines\",\"value\":true},{\"help\":\"Outlines on: all, objects (characters and objects), environment\",\"kind\":{\"Choice\":{\"options\":[\"all\",\"objects\",\"environment\"]}},\"path\":\"view.outlines_on\",\"value\":\"all\"},{\"help\":\"Outline thickness (pixels)\",\"kind\":{\"Float\":{\"max\":4,\"min\":1}},\"path\":\"view.outline_px\",\"value\":1},{\"help\":\"Outline brightness relative to the surface\",\"kind\":{\"Float\":{\"max\":1,\"min\":0}},\"path\":\"view.outline_darken\",\"value\":0.35},{\"help\":\"Light bands in cel style\",\"kind\":{\"Float\":{\"max\":6,\"min\":2}},\"path\":\"view.cel_bands\",\"value\":2},{\"help\":\"Shadow brightness in flat style\",\"kind\":{\"Float\":{\"max\":1,\"min\":0}},\"path\":\"view.flat_shadow\",\"value\":0.62},{\"help\":\"Rim light (cel)\",\"kind\":{\"Float\":{\"max\":1,\"min\":0}},\"path\":\"view.rim\",\"value\":0.25},{\"help\":\"Specular highlights (lit)\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.specular\",\"value\":0.35},{\"help\":\"Exposure\",\"kind\":{\"Float\":{\"max\":3,\"min\":0.2}},\"path\":\"view.exposure\",\"value\":1},{\"help\":\"HDR to screen mapping\",\"kind\":{\"Choice\":{\"options\":[\"clamp\",\"soft knee\",\"aces\"]}},\"path\":\"view.tonemap\",\"value\":\"soft knee\"},{\"help\":\"Color saturation\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.saturation\",\"value\":1},{\"help\":\"Glow around bright things (0 = off)\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.bloom\",\"value\":0.35},{\"help\":\"Brightness where glow starts\",\"kind\":{\"Float\":{\"max\":4,\"min\":0.2}},\"path\":\"view.bloom_threshold\",\"value\":1.2},{\"help\":\"Screen distortion (shockwaves, heat haze)\",\"kind\":\"Bool\",\"path\":\"view.distortion\",\"value\":true},{\"help\":\"GPU particles\",\"kind\":\"Bool\",\"path\":\"view.particles\",\"value\":true},{\"help\":\"Screen-space global illumination: bounce light and occlusion (0 = off)\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.gi\",\"value\":0},{\"help\":\"Hazy air: volumetric light (0 = off)\",\"kind\":{\"Float\":{\"max\":3,\"min\":0}},\"path\":\"view.haze\",\"value\":0},{\"help\":\"Haze thins out over this height above the player's feet (m)\",\"kind\":{\"Float\":{\"max\":30,\"min\":0.5}},\"path\":\"view.haze_height\",\"value\":4},{\"help\":\"Sunlight in the haze: light shafts where shadows cut it\",\"kind\":{\"Float\":{\"max\":4,\"min\":0}},\"path\":\"view.shafts\",\"value\":1},{\"help\":\"Forward scattering: haze glows toward the sun (0 = evenly)\",\"kind\":{\"Float\":{\"max\":0.9,\"min\":0}},\"path\":\"view.shafts_forward\",\"value\":0.4},{\"help\":\"Lamp halos: lights glowing in the air (0 = off)\",\"kind\":{\"Float\":{\"max\":4,\"min\":0}},\"path\":\"view.halos\",\"value\":0},{\"help\":\"Wind in foliage and grass (0 = still)\",\"kind\":{\"Float\":{\"max\":3,\"min\":0}},\"path\":\"view.wind\",\"value\":0.6},{\"help\":\"Compass direction the wind blows toward (degrees)\",\"kind\":{\"Float\":{\"max\":360,\"min\":0}},\"path\":\"view.wind_angle\",\"value\":60},{\"help\":\"How fast gusts roll across\",\"kind\":{\"Float\":{\"max\":3,\"min\":0}},\"path\":\"view.wind_gusts\",\"value\":1},{\"help\":\"Grass parts around the player\",\"kind\":\"Bool\",\"path\":\"view.grass_push\",\"value\":true},{\"help\":\"Water ripples where things move through it (a CPU wave simulation)\",\"kind\":\"Bool\",\"path\":\"view.water_ripples\",\"value\":true},{\"help\":\"Ripple speed (m/s)\",\"kind\":{\"Float\":{\"max\":4,\"min\":0.3}},\"path\":\"view.water_speed\",\"value\":1.6},{\"help\":\"Seconds for a ripple to lose half its height\",\"kind\":{\"Float\":{\"max\":8,\"min\":0.2}},\"path\":\"view.water_fade\",\"value\":1.4},{\"help\":\"Raindrops per square metre per second on water\",\"kind\":{\"Float\":{\"max\":3,\"min\":0}},\"path\":\"view.water_rain\",\"value\":0},{\"help\":\"Distance fog (hides streaming edges)\",\"kind\":\"Bool\",\"path\":\"view.fog\",\"value\":true},{\"help\":\"Fog starts at this distance from the camera target (m)\",\"kind\":{\"Float\":{\"max\":300,\"min\":5}},\"path\":\"view.fog_start\",\"value\":48},{\"help\":\"Fog is complete at this distance (m)\",\"kind\":{\"Float\":{\"max\":400,\"min\":10}},\"path\":\"view.fog_end\",\"value\":80},{\"help\":\"Materials: full, first_layer (cheaper; phones), off (plain colours)\",\"kind\":{\"Choice\":{\"options\":[\"off\",\"first_layer\",\"full\"]}},\"path\":\"view.material_detail\",\"value\":\"full\"},{\"help\":\"Sun height (degrees)\",\"kind\":{\"Float\":{\"max\":90,\"min\":5}},\"path\":\"view.light.sun_elevation\",\"value\":58},{\"help\":\"Sun compass direction (degrees)\",\"kind\":{\"Float\":{\"max\":360,\"min\":0}},\"path\":\"view.light.sun_azimuth\",\"value\":215},{\"help\":\"Direct light strength\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.light.sun_intensity\",\"value\":0.55},{\"help\":\"Sky/ground fill light multiplier\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.light.ambient\",\"value\":1},{\"help\":\"Sun shadows\",\"kind\":\"Bool\",\"path\":\"view.lig\n# Presets for the Look & Filters menu (and the `look` agent tool).\n#\n# [[preset]]  one filter's settings: `section` is pixel, shading, outlines, stylize, palette,\n#             grading, scanlines, grain, screen, glow or air; `set` holds view paths (as in `pav params\n#             prefix=view`, without `view.`) and only paths of that section. A filter preset\n#             never changes which part of the scene the filter is on (the *_on / *_target keys),\n#             so picking \"Chunky\" keeps pixel art on the characters if that is where it was.\n# [[look]]    a whole look: it switches on every section it names a path of (starting from the\n#             defaults) and switches the others off, so the scene's own settings show there.\n#\n# Parts of the scene: \"all\", \"objects\" (characters and objects: anything that moves, fights or\n# can be picked up) and \"environment\" (level geometry, fixed scenery, the sky).\n\n# ---------------------------------------------------------------- pixel art\n[[preset]]\nsection = \"pixel\"\nname = \"Fine\"\nabout = \"3 px blocks, no outline\"\nset = { \"filter.pixel_art\" = 3.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = false }\n\n[[preset]]\nsection = \"pixel\"\nname = \"Classic\"\nabout = \"4 px blocks with a dark outline\"\nset = { \"filter.pixel_art\" = 4.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"Bold\"\nabout = \"5 px blocks with a dark outline\"\nset = { \"filter.pixel_art\" = 5.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"Chunky\"\nabout = \"6 px blocks with a dark outline\"\nset = { \"filter.pixel_art\" = 6.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"16-bit\"\nabout = \"4 px blocks, 24 shades per channel\"\nset = { \"filter.pixel_art\" = 4.0, \"filter.pixel_levels\" = 24.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"8-bit\"\nabout = \"6 px blocks, 8 shades per channel\"\nset = { \"filter.pixel_art\" = 6.0, \"filter.pixel_levels\" = 8.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"Giant\"\nabout = \"10 px blocks\"\nset = { \"filter.pixel_art\" = 10.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = true }\n\n# ---------------------------------------------------------------- shading\n[[preset]]\nsection = \"shading\"\nname = \"As authored\"\n{\"current\":{\"on\":[],\"settings\":{}},\"looks\":[{\"about\":\"A clean, sharp world; the characters and objects are outlined pixel art.\",\"name\":\"Pixel heroes\"},{\"about\":\"Pixel-art characters and objects in a soft, glowing 3D world with dark corners.\",\"name\":\"HD-2D\"},{\"about\":\"The environment is pixel art; the characters and objects stay sharp, lit and inked.\",\"name\":\"Pixel world, crisp heroes\"},{\"about\":\"The environment in four Game Boy greens; the characters and objects in full colour with ink outlines.\",\"name\":\"Game Boy world\"},{\"about\":\"Everything in four greens, pixelated and dithered.\",\"name\":\"Game Boy\"},{\"about\":\"The whole scene as 16-bit pixel art with a slightly vivid grade.\",\"name\":\"16-bit\"},{\"about\":\"Cel shading everywhere, bold ink outlines and vivid colour.\",\"name\":\"Cartoon\"},{\"about\":\"A black-and-white world; the characters and objects keep their colour, inked.\",\"name\":\"Comic noir\"},{\"about\":\"Flat colours, thin outlines and a faded grade, like a printed page.\",\"name\":\"Flat paper\"},{\"about\":\"Low resolution on a curved tube with scanlines, glow and colour fringes.\",\"name\":\"Arcade CRT\"},{\"about\":\"Characters and objects flicker like holograms: cool, scanlined and fringed. The world stays clean.\",\"name\":\"Hologram heroes\"},{\"about\":\"The environment in a few flat shades with flat shading; lit characters and objects in full colour.\",\"name\":\"Posterized world\"},{\"about\":\"The whole scene in oil paint: flat strokes, brush streaks, canvas.\",\"name\":\"Oil painting\"},{\"about\":\"A painted b\n# Optional: view settings while inside (`pav params prefix=view`, without \"view.\"), e.g. night:\n# \"light.sun_intensity\" = 0.06, \"light.ambient\" = 0.25, sky = \"#0e1424\", bloom = 0.6, gi = 1.0,\n# \"light.sun_elevation\" = 20, distortion = true, particles = true, exposure = 1.2\n# Filters can aim at a part of the scene: \"filter.pixel_target\" = \"objects\" (characters & objects)\n# or \"environment\", \"filter.color_on\" / \"grade_on\" / \"scanlines_on\" / \"grain_on\" / \"chroma_on\",\n# outlines_on = \"objects\", style_objects = \"lit\", style_environment = \"flat\" (see rooms/mix_match.toml)\n# Painterly and print styles: \"filter.stylize\" = \"paint\" | \"halftone\" | \"ascii\" | \"sketch\",\n# \"filter.stylize_on\", \"filter.stylize_size\" (px), \"filter.stylize_color\" (rooms/paint_print.toml).\n# Hazy air: haze, haze_height, shafts, shafts_forward, halos (rooms/light_shafts.toml).\n# Wind and water: wind, wind_angle, wind_gusts, grass_push, water_ripples, water_speed,\n# water_fade, water_rain (rooms/wind_water.toml). Transitions: \"filter.transition\" = \"iris\",\n# \"filter.transition_demo\" = true loops it (rooms/transitions.toml).\n# Rooms without roofs can keep tall things whole near the player: \"cutaway.height_cut\" = false\n[view]\n\n# Optional: simulation parameter overrides while inside (full paths, see `pav params`).\n[params]\n# \"movement.jump_height\" = 2.0\n# \"movement.ledge_grab\" = true     # off by default: a jump reaches ledges up to ~3.4 m, so keep\n#                                   # walls you must not climb at 4 m or more in such rooms\n# \"movement.lock_axis\" = \"z\"       # side-view rooms (axis in the room's own frame)\n\n# Optional: keyboard remapping while inside (action = [physical key names]).\n[keys]\n# jump = [\"KeyW\", \"Space\"]\n# move_up = [\"ArrowUp\"]\n\n[layout]\n# origin is only used when the room is loaded on its own (`pav load scene=<key>`).\norigin = [-5.0, 0.0, -5.0]\n\n[[layout.layer]]\ny = 0                         # more layers = more floors (add at = [col, row] to offset one)\nmap = '''\n###########\n#.........#\n#....B....#\n#.........#\n#.........#\n#.........#\n#.........#\n#.........#\n#.........#\n#####..####\n'''\n\n# Each map character: blocks (y0/y1 relative to the layer), ladder, prop or marker.\n[layout.legend.'.']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#c8c8c8\" }]\n\n[layout.legend.'#']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#c8c8c8\" }, { y0 = 0, y1 = 2.0, color = \"#9aa5b1\" }]\n\n[layout.legend.'B']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#c8c8c8\" }, { y0 = 0, y1 = 1.0, color = \"#c9a27a\", rounded = true }]\n# Other options: destructible = true, ghost = true (no collision), inset = 0.3 (thinner),\n# crumble = 0.8 (falls 0.8 s after being stepped on), regrow = 4 (comes back after 4 s),\n# strength = 40 (breaks when hit with more than this contact force, e.g. glass),\n# look = \"flat\" | \"cel\" | \"lit\" | \"unlit\",\n# ladder = { facing = \"north\", height = 3.0 },\n# prop = { shape = { type = \"box\", half = [0.35, 0.35, 0.35] }, color = \"#e8704a\" },\n   Compiling web-sys v0.3.106\n   Compiling wasm-bindgen-futures v0.4.79\n   Compiling web-time v1.1.0","is_error":false}]},"parent_tool_use_id":null,"session_id":"b664ff9f-3df3-486c-8cc6-7a0b3ccfba7c","uuid":"f1b24355-967d-49bc-af9b-07b1cf841bc8","timestamp":"2026-11-05T04:30:50.336Z","tool_use_result":{"stdout":"[{\"help\":\"Force one surface style everywhere\",\"kind\":{\"Choice\":{\"options\":[\"per object\",\"flat\",\"cel\",\"lit\"]}},\"path\":\"view.style\",\"value\":\"per object\"},{\"help\":\"Surface style of the characters and objects (when style is per object)\",\"kind\":{\"Choice\":{\"options\":[\"per object\",\"flat\",\"cel\",\"lit\"]}},\"path\":\"view.style_objects\",\"value\":\"per object\"},{\"help\":\"Surface style of the environment (when style is per object)\",\"kind\":{\"Choice\":{\"options\":[\"per object\",\"flat\",\"cel\",\"lit\"]}},\"path\":\"view.style_environment\",\"value\":\"per object\"},{\"help\":\"Screen-space outlines\",\"kind\":\"Bool\",\"path\":\"view.outlines\",\"value\":true},{\"help\":\"Outlines on: all, objects (characters and objects), environment\",\"kind\":{\"Choice\":{\"options\":[\"all\",\"objects\",\"environment\"]}},\"path\":\"view.outlines_on\",\"value\":\"all\"},{\"help\":\"Outline thickness (pixels)\",\"kind\":{\"Float\":{\"max\":4,\"min\":1}},\"path\":\"view.outline_px\",\"value\":1},{\"help\":\"Outline brightness relative to the surface\",\"kind\":{\"Float\":{\"max\":1,\"min\":0}},\"path\":\"view.outline_darken\",\"value\":0.35},{\"help\":\"Light bands in cel style\",\"kind\":{\"Float\":{\"max\":6,\"min\":2}},\"path\":\"view.cel_bands\",\"value\":2},{\"help\":\"Shadow brightness in flat style\",\"kind\":{\"Float\":{\"max\":1,\"min\":0}},\"path\":\"view.flat_shadow\",\"value\":0.62},{\"help\":\"Rim light (cel)\",\"kind\":{\"Float\":{\"max\":1,\"min\":0}},\"path\":\"view.rim\",\"value\":0.25},{\"help\":\"Specular highlights (lit)\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.specular\",\"value\":0.35},{\"help\":\"Exposure\",\"kind\":{\"Float\":{\"max\":3,\"min\":0.2}},\"path\":\"view.exposure\",\"value\":1},{\"help\":\"HDR to screen mapping\",\"kind\":{\"Choice\":{\"options\":[\"clamp\",\"soft knee\",\"aces\"]}},\"path\":\"view.tonemap\",\"value\":\"soft knee\"},{\"help\":\"Color saturation\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.saturation\",\"value\":1},{\"help\":\"Glow around bright things (0 = off)\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.bloom\",\"value\":0.35},{\"help\":\"Brightness where glow starts\",\"kind\":{\"Float\":{\"max\":4,\"min\":0.2}},\"path\":\"view.bloom_threshold\",\"value\":1.2},{\"help\":\"Screen distortion (shockwaves, heat haze)\",\"kind\":\"Bool\",\"path\":\"view.distortion\",\"value\":true},{\"help\":\"GPU particles\",\"kind\":\"Bool\",\"path\":\"view.particles\",\"value\":true},{\"help\":\"Screen-space global illumination: bounce light and occlusion (0 = off)\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.gi\",\"value\":0},{\"help\":\"Hazy air: volumetric light (0 = off)\",\"kind\":{\"Float\":{\"max\":3,\"min\":0}},\"path\":\"view.haze\",\"value\":0},{\"help\":\"Haze thins out over this height above the player's feet (m)\",\"kind\":{\"Float\":{\"max\":30,\"min\":0.5}},\"path\":\"view.haze_height\",\"value\":4},{\"help\":\"Sunlight in the haze: light shafts where shadows cut it\",\"kind\":{\"Float\":{\"max\":4,\"min\":0}},\"path\":\"view.shafts\",\"value\":1},{\"help\":\"Forward scattering: haze glows toward the sun (0 = evenly)\",\"kind\":{\"Float\":{\"max\":0.9,\"min\":0}},\"path\":\"view.shafts_forward\",\"value\":0.4},{\"help\":\"Lamp halos: lights glowing in the air (0 = off)\",\"kind\":{\"Float\":{\"max\":4,\"min\":0}},\"path\":\"view.halos\",\"value\":0},{\"help\":\"Wind in foliage and grass (0 = still)\",\"kind\":{\"Float\":{\"max\":3,\"min\":0}},\"path\":\"view.wind\",\"value\":0.6},{\"help\":\"Compass direction the wind blows toward (degrees)\",\"kind\":{\"Float\":{\"max\":360,\"min\":0}},\"path\":\"view.wind_angle\",\"value\":60},{\"help\":\"How fast gusts roll across\",\"kind\":{\"Float\":{\"max\":3,\"min\":0}},\"path\":\"view.wind_gusts\",\"value\":1},{\"help\":\"Grass parts around the player\",\"kind\":\"Bool\",\"path\":\"view.grass_push\",\"value\":true},{\"help\":\"Water ripples where things move through it (a CPU wave simulation)\",\"kind\":\"Bool\",\"path\":\"view.water_ripples\",\"value\":true},{\"help\":\"Ripple speed (m/s)\",\"kind\":{\"Float\":{\"max\":4,\"min\":0.3}},\"path\":\"view.water_speed\",\"value\":1.6},{\"help\":\"Seconds for a ripple to lose half its height\",\"kind\":{\"Float\":{\"max\":8,\"min\":0.2}},\"path\":\"view.water_fade\",\"value\":1.4},{\"help\":\"Raindrops per square metre per second on water\",\"kind\":{\"Float\":{\"max\":3,\"min\":0}},\"path\":\"view.water_rain\",\"value\":0},{\"help\":\"Distance fog (hides streaming edges)\",\"kind\":\"Bool\",\"path\":\"view.fog\",\"value\":true},{\"help\":\"Fog starts at this distance from the camera target (m)\",\"kind\":{\"Float\":{\"max\":300,\"min\":5}},\"path\":\"view.fog_start\",\"value\":48},{\"help\":\"Fog is complete at this distance (m)\",\"kind\":{\"Float\":{\"max\":400,\"min\":10}},\"path\":\"view.fog_end\",\"value\":80},{\"help\":\"Materials: full, first_layer (cheaper; phones), off (plain colours)\",\"kind\":{\"Choice\":{\"options\":[\"off\",\"first_layer\",\"full\"]}},\"path\":\"view.material_detail\",\"value\":\"full\"},{\"help\":\"Sun height (degrees)\",\"kind\":{\"Float\":{\"max\":90,\"min\":5}},\"path\":\"view.light.sun_elevation\",\"value\":58},{\"help\":\"Sun compass direction (degrees)\",\"kind\":{\"Float\":{\"max\":360,\"min\":0}},\"path\":\"view.light.sun_azimuth\",\"value\":215},{\"help\":\"Direct light strength\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.light.sun_intensity\",\"value\":0.55},{\"help\":\"Sky/ground fill light multiplier\",\"kind\":{\"Float\":{\"max\":2,\"min\":0}},\"path\":\"view.light.ambient\",\"value\":1},{\"help\":\"Sun shadows\",\"kind\":\"Bool\",\"path\":\"view.lig\n# Presets for the Look & Filters menu (and the `look` agent tool).\n#\n# [[preset]]  one filter's settings: `section` is pixel, shading, outlines, stylize, palette,\n#             grading, scanlines, grain, screen, glow or air; `set` holds view paths (as in `pav params\n#             prefix=view`, without `view.`) and only paths of that section. A filter preset\n#             never changes which part of the scene the filter is on (the *_on / *_target keys),\n#             so picking \"Chunky\" keeps pixel art on the characters if that is where it was.\n# [[look]]    a whole look: it switches on every section it names a path of (starting from the\n#             defaults) and switches the others off, so the scene's own settings show there.\n#\n# Parts of the scene: \"all\", \"objects\" (characters and objects: anything that moves, fights or\n# can be picked up) and \"environment\" (level geometry, fixed scenery, the sky).\n\n# ---------------------------------------------------------------- pixel art\n[[preset]]\nsection = \"pixel\"\nname = \"Fine\"\nabout = \"3 px blocks, no outline\"\nset = { \"filter.pixel_art\" = 3.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = false }\n\n[[preset]]\nsection = \"pixel\"\nname = \"Classic\"\nabout = \"4 px blocks with a dark outline\"\nset = { \"filter.pixel_art\" = 4.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"Bold\"\nabout = \"5 px blocks with a dark outline\"\nset = { \"filter.pixel_art\" = 5.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"Chunky\"\nabout = \"6 px blocks with a dark outline\"\nset = { \"filter.pixel_art\" = 6.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"16-bit\"\nabout = \"4 px blocks, 24 shades per channel\"\nset = { \"filter.pixel_art\" = 4.0, \"filter.pixel_levels\" = 24.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"8-bit\"\nabout = \"6 px blocks, 8 shades per channel\"\nset = { \"filter.pixel_art\" = 6.0, \"filter.pixel_levels\" = 8.0, \"filter.pixel_outline\" = true }\n\n[[preset]]\nsection = \"pixel\"\nname = \"Giant\"\nabout = \"10 px blocks\"\nset = { \"filter.pixel_art\" = 10.0, \"filter.pixel_levels\" = 0.0, \"filter.pixel_outline\" = true }\n\n# ---------------------------------------------------------------- shading\n[[preset]]\nsection = \"shading\"\nname = \"As authored\"\n{\"current\":{\"on\":[],\"settings\":{}},\"looks\":[{\"about\":\"A clean, sharp world; the characters and objects are outlined pixel art.\",\"name\":\"Pixel heroes\"},{\"about\":\"Pixel-art characters and objects in a soft, glowing 3D world with dark corners.\",\"name\":\"HD-2D\"},{\"about\":\"The environment is pixel art; the characters and objects stay sharp, lit and inked.\",\"name\":\"Pixel world, crisp heroes\"},{\"about\":\"The environment in four Game Boy greens; the characters and objects in full colour with ink outlines.\",\"name\":\"Game Boy world\"},{\"about\":\"Everything in four greens, pixelated and dithered.\",\"name\":\"Game Boy\"},{\"about\":\"The whole scene as 16-bit pixel art with a slightly vivid grade.\",\"name\":\"16-bit\"},{\"about\":\"Cel shading everywhere, bold ink outlines and vivid colour.\",\"name\":\"Cartoon\"},{\"about\":\"A black-and-white world; the characters and objects keep their colour, inked.\",\"name\":\"Comic noir\"},{\"about\":\"Flat colours, thin outlines and a faded grade, like a printed page.\",\"name\":\"Flat paper\"},{\"about\":\"Low resolution on a curved tube with scanlines, glow and colour fringes.\",\"name\":\"Arcade CRT\"},{\"about\":\"Characters and objects flicker like holograms: cool, scanlined and fringed. The world stays clean.\",\"name\":\"Hologram heroes\"},{\"about\":\"The environment in a few flat shades with flat shading; lit characters and objects in full colour.\",\"name\":\"Posterized world\"},{\"about\":\"The whole scene in oil paint: flat strokes, brush streaks, canvas.\",\"name\":\"Oil painting\"},{\"about\":\"A painted b\n# Optional: view settings while inside (`pav params prefix=view`, without \"view.\"), e.g. night:\n# \"light.sun_intensity\" = 0.06, \"light.ambient\" = 0.25, sky = \"#0e1424\", bloom = 0.6, gi = 1.0,\n# \"light.sun_elevation\" = 20, distortion = true, particles = true, exposure = 1.2\n# Filters can aim at a part of the scene: \"filter.pixel_target\" = \"objects\" (characters & objects)\n# or \"environment\", \"filter.color_on\" / \"grade_on\" / \"scanlines_on\" / \"grain_on\" / \"chroma_on\",\n# outlines_on = \"objects\", style_objects = \"lit\", style_environment = \"flat\" (see rooms/mix_match.toml)\n# Painterly and print styles: \"filter.stylize\" = \"paint\" | \"halftone\" | \"ascii\" | \"sketch\",\n# \"filter.stylize_on\", \"filter.stylize_size\" (px), \"filter.stylize_color\" (rooms/paint_print.toml).\n# Hazy air: haze, haze_height, shafts, shafts_forward, halos (rooms/light_shafts.toml).\n# Wind and water: wind, wind_angle, wind_gusts, grass_push, water_ripples, water_speed,\n# water_fade, water_rain (rooms/wind_water.toml). Transitions: \"filter.transition\" = \"iris\",\n# \"filter.transition_demo\" = true loops it (rooms/transitions.toml).\n# Rooms without roofs can keep tall things whole near the player: \"cutaway.height_cut\" = false\n[view]\n\n# Optional: simulation parameter overrides while inside (full paths, see `pav params`).\n[params]\n# \"movement.jump_height\" = 2.0\n# \"movement.ledge_grab\" = true     # off by default: a jump reaches ledges up to ~3.4 m, so keep\n#                                   # walls you must not climb at 4 m or more in such rooms\n# \"movement.lock_axis\" = \"z\"       # side-view rooms (axis in the room's own frame)\n\n# Optional: keyboard remapping while inside (action = [physical key names]).\n[keys]\n# jump = [\"KeyW\", \"Space\"]\n# move_up = [\"ArrowUp\"]\n\n[layout]\n# origin is only used when the room is loaded on its own (`pav load scene=<key>`).\norigin = [-5.0, 0.0, -5.0]\n\n[[layout.layer]]\ny = 0                         # more layers = more floors (add at = [col, row] to offset one)\nmap = '''\n###########\n#.........#\n#....B....#\n#.........#\n#.........#\n#.........#\n#.........#\n#.........#\n#.........#\n#####..####\n'''\n\n# Each map character: blocks (y0/y1 relative to the layer), ladder, prop or marker.\n[layout.legend.'.']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#c8c8c8\" }]\n\n[layout.legend.'#']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#c8c8c8\" }, { y0 = 0, y1 = 2.0, color = \"#9aa5b1\" }]\n\n[layout.legend.'B']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#c8c8c8\" }, { y0 = 0, y1 = 1.0, color = \"#c9a27a\", rounded = true }]\n# Other options: destructible = true, ghost = true (no collision), inset = 0.3 (thinner),\n# crumble = 0.8 (falls 0.8 s after being stepped on), regrow = 4 (comes back after 4 s),\n# strength = 40 (breaks when hit with more than this contact force, e.g. glass),\n# look = \"flat\" | \"cel\" | \"lit\" | \"unlit\",\n# ladder = { facing = \"north\", height = 3.0 },\n# prop = { shape = { type = \"box\", half = [0.35, 0.35, 0.35] }, color = \"#e8704a\" },\n   Compiling web-sys v0.3.106\n   Compiling wasm-bindgen-futures v0.4.79\n   Compiling web-time v1.1.0","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01GtXCjxGPi5sznqxLA77ejd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
