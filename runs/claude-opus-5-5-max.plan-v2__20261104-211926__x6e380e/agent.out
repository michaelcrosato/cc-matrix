{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TsrMRBDNtJB6aJ5rQDTN8Q","type":"tool_result","content":"//! Shardfall — the game executable.\n#![cfg_attr(all(windows, not(debug_assertions)), windows_subsystem = \"windows\")]\n\nmod animation_ui;\nmod animation_watch;\nmod app;\nmod asset_ui;\nmod asset_watch;\nmod boot;\n#[cfg(not(target_arch = \"wasm32\"))]\nmod bridge;\nmod creature_ui;\nmod creature_watch;\nmod edit;\nmod gfx;\nmod guide_ui;\nmod hud;\nmod input;\nmod look_ui;\nmod panel;\nmod platform;\nmod quality;\nmod rooms;\nmod save;\nmod settings;\nmod simhost;\nmod ui;\nmod uiinput;\n\nuse pav_ui::{arpg_items, arpg_ui, touch};\n\nfn fatal(msg: &str) -> ! {\n    let path = boot::diag().log_path.display().to_string();\n    log::error!(\"fatal: {msg}\");\n    platform::error_box(\"Shardfall could not start\", &format!(\"{msg}\\n\\nThe full log is in:\\n{path}\"));\n    std::process::exit(1);\n}\n\nfn main() {\n    platform::attach_console();\n    let d = boot::init();\n    boot::install_panic_hook();\n    let args: Vec<String> = std::env::args().skip(1).collect();\n    if args.iter().any(|a| a == \"--help\" || a == \"-h\") {\n        println!(\n            \"shardfall [--room NAME | --scene NAME] [--seed N] [--backend vulkan|dx12] [--no-vsync] [--fullscreen] [--bridge [ADDR]]\\n\\\n             --bridge opens the live agent bridge (default 127.0.0.1:7878; drive it with `pav live`).\\n\\\n             --animation-studio [SET/Clip] opens the animation workspace and the live agent bridge.\\n\\\n             --creature-studio [CREATURE/name] opens the creature workspace and the live agent bridge.\\n\\\n             --asset-studio [SET/name] opens the object workspace and the live agent bridge.\\n\\\n             Startup settings live in shardfall.toml next to the executable.\"\n        );\n        return;\n    }\n    log::info!(\n        \"Shardfall {} ({} {}, {} build) — log file: {}\",\n        env!(\"CARGO_PKG_VERSION\"),\n        if cfg!(target_arch = \"wasm32\") { \"browser\" } else { std::env::consts::OS },\n        std::env::consts::ARCH,\n        if cfg!(debug_assertions) { \"debug\" } else { \"release\" },\n        d.log_path.display()\n    );\n    let settings = match boot::stage(\"settings\", || {\n        let (s, note) = settings::Settings::load(&args);\n        Ok((s, note))\n    }) {\n        Ok(s) => s,\n        Err(e) => fatal(&format!(\"{e:#}\")),\n    };\n    // The browser's event loop runs on after `run` returns; errors show on the page.\n    #[cfg(target_arch = \"wasm32\")]\n    if let Err(e) = app::run(settings) {\n        fatal(&format!(\"{e:#}\"));\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    match std::panic::catch_unwind(|| app::run(settings)) {\n        Ok(Ok(())) => log::info!(\"clean exit\"),\n        Ok(Err(e)) => fatal(&format!(\"{e:#}\")),\n        Err(_) => {\n            let msg = boot::LAST_CRASH.lock().ok().and_then(|c| c.clone()).unwrap_or_else(|| \"unknown crash\".into());\n            fatal(&format!(\"Shardfall crashed:\\n{msg}\"));\n        }\n    }\n}\n----\ncrates/pav_app/src/save.rs:25:fn storage() -> Option<web_sys::Storage> {\ncrates/pav_app/src/save.rs:26:    web_sys::window()?.local_storage().ok()?\ncrates/pav_app/src/platform.rs:23:    if let Some(body) = web_sys::window().and_then(|w| w.document()).and_then(|d| d.body()) {\ncrates/pav_app/src/platform.rs:47:    web_sys::window().and_then(|w| w.match_media(\"(pointer: coarse)\").ok().flatten()).is_some_and(|m| m.matches())\ncrates/pav_app/src/platform.rs:59:    let Some(doc) = web_sys::window().and_then(|w| w.document()) else { return };\ncrates/pav_app/src/boot.rs:106:            let js = wasm_bindgen::JsValue::from_str(&line);\ncrates/pav_app/src/boot.rs:108:                log::Level::Error => web_sys::console::error_1(&js),\ncrates/pav_app/src/boot.rs:109:                log::Level::Warn => web_sys::console::warn_1(&js),\ncrates/pav_app/src/boot.rs:110:                _ => web_sys::con