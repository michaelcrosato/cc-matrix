value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n2992:  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\n2994:  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n2995:  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n2997:  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { g.input.deadzone = v; } },\n3000:  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { g.input.rumbleScale = v; } },\n3003:  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\n3004:  touchOpacity: { group: 'Touch', label: 'Button opacity', type: 'slider', value: .8, min: .3, max: 1, step: .05, apply: g => g.input._touchSync() }\n3010:  if (sp.type === 'slider') return typeof v === 'number' && isFinite(v) ? clamp(v, sp.min === undefined ? 0 : sp.min, sp.max === undefined ? 1 : sp.max) : undefined;\n3040:  /** add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value,\n3046:    const s = Object.assign({ group: 'Game', type: sp.options ? 'select' : typeof sp.value === 'number' ? 'slider' : typeof sp.value === 'boolean' || sp.value === undefined ? 'toggle' : 'value' }, sp);\n3060:  /** change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told.\n7300: *      const seen = E.sees(guard, hero, { map, range: 120, fov: 1.6 });   // { seen, d, angle, exposure }\n7309: * (default 1) and .6 when it crouches 