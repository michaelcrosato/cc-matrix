h in, out and\\n\" +\n    ' *  inOut: inSine, outSine, inOutSine, ...), the names every tween library uses (section 1b) */\\n' +\n    'const ease = {\\n' +\n    '  linear: u => u,   // even speed\\n' +\n    '  outCubic: u => 1 - Math.pow(1 - u, 3),   // fast start, smooth stop\\n' +\n    '  outQuad: u => 1 - (1 - u) * (1 - u),   // fast start, smooth stop (gentler than outCubic)\\n' +\n    '  inQuad: u => u * u,   // slow start, fast end\\n' +\n    '  inOut: u => u < .5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2,   // slow start and end\\n' +\n    '  outBack: u => { const c1 = 1.9, c3 = c1 + 1; return 1 + c3 * Math.pow(u - 1, 3) + c1 * Math.pow(u - 1, 2); }   // overshoots past 1, then settles: pop-ups, landings\\n' +\n    '};\\n' +\n    '/** v wrapped into lo..hi (hi left out): wrap(-1, 0, 10) is 9, wrap(330, 0, 320) is 10. A world whose edges meet\\n' +\n    ' *  (Asteroids, a looping stage): x = E.wrap(x, 0, W) */\\n' +\n    'const wrap = (v, lo, hi) => { const s = hi - lo; return s > 0 ? lo + ((v - lo) % s + s) % s : lo; };\\n' +\n    '/** the shortest signed difference from a to b on a span of size that wraps round: wrapDiff(9, 1, 10) is 2 (across the\\n' +\n    ' *  seam, not -8). Aim and chase across the edge */\\n' +\n    'const wrapDiff = (a, b, size) => wrap(b - a + size / 2, 0, size) - size / 2;\\n' +\n    '/** the shortest signed turn from angle a to angle b, -π..π (radians) */\\n' +\n    'const angDiff = (a, b) => ((b - a + Math.PI) % TAU + TAU) % TAU - Math.PI;\\n' +\n    '/** an angle t of the way from a to b by the shorter way round */\\n' +\n    'const lerpAng = (a, b, t) => a + angDiff(a, b) * t;\\n' +\n    '/** angle a turned toward b by at most s radians: facing = approachAng(facing, target, turnSpeed * dt) */\\n' +\n    'const approachAng = (a, b, s) => { const d = angDiff(a, b); return Math.abs(d) <= s ? b : a + Math.sign(d) * s; };\\n' +\n    '/** a seeded random stream: const R = E.rng(42); R() gives 0..1, the same numbers for the same s'... 1726611 more characters\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Am8fHJ7RVL4M6YQ1ranvZq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
