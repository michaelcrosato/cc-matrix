.src === e.id && !t.done) { t.done = true; t.cancelled = true; } }\"\"\"\nassert old in s\ns=s.replace(old,new)\nopen(p,'w').write(s)\np='src/31-stage1.js'; s=open(p).read()\ns=s.replace(\"def('scene', '1-4', { title: 'CANAL RUN', time: 60, carrier: 'boat', carrierHold: 1180,\",\"def('scene', '1-4', { title: 'CANAL RUN', time: 60, carrier: 'boat', carrierHold: 1180, holds: [[230, 'b1'], [640, 'b2'], [940, 'gb']],\")\ns=s.replace(\"    { atD: 140, spawn: [['gunner', 'bg1'],\",\"    { id: 'b1', atD: 140, spawn: [['gunner', 'bg1'],\")\ns=s.replace(\"    { atD: 560, spawn: [['gunner', 'bg2'],\",\"    { id: 'b2', atD: 560, spawn: [['gunner', 'bg2'],\")\ns=s.replace(\"    { atD: 860, spawn: [['quartermaster',\",\"    { id: 'gb', atD: 860, spawn: [['quartermaster',\")\nopen(p,'w').write(s)\np='src/32-stage2.js'; s=open(p).read()\ns=s.replace(\"def('scene', '2-3', { title: 'FUNICULAR', time: 60, carrier: 'funi', carrierHold: 600,\",\"def('scene', '2-3', { title: 'FUNICULAR', time: 60, carrier: 'funi', carrierHold: 600, holds: [[120, 'w0'], [300, 'w2']],\")\nopen(p,'w').write(s)\np='src/21-enemies.js'; s=open(p).read()\ns=s.replace(\"  const c0 = e.center, R = e.orbit;\",\"  if (e.o.follow) { const C = sim.carriers[e.o.follow]; if (C && C.M) e.center = xform(C.M, e.o.local || [60, 0, 40]); }\\n  const c0 = e.center, R = e.orbit;\")\nopen(p,'w').write(s)\np='src/33-stage3.js'; s=open(p).read()\ns=s.replace(\"\"\"    { atD: 10, spawn: [['drone', null, { from: [1340, -40, 80], orbit: 60 }], ['drone', null, { from: [1340, 40, 110], orbit: 60, delay: .5 }], ['drone', null, { from: [1320, 0, 140], orbit: 70, delay: 1 }]] },\"\"\",\"\"\"    { atD: 10, spawn: [['drone', null, { from: [1340, -40, 80], orbit: 50, follow: 'lift', local: [90, -40, 30] }], ['drone', null, { from: [1340, 40, 110], orbit: 50, follow: 'lift', local: [100, 40, 50], delay: .5 }], ['drone', null, { from: [1320, 0, 140], orbit: 60, follow: 'lift', local: [120, 0, 70], delay: 1 }]] },\"\"\")\ns=s.replace(\"def('