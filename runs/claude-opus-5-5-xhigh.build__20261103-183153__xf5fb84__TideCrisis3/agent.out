({ data: { hero, flags }, place: 'Brightwater', level: hero.lv });   // what a save holds\n *      game.saves.read = save => { hero = save.data.hero; ... };                                    // what a load does\n *      game.saves.save(0); game.saves.load(0); game.saves.copy(0, 1); game.saves.erase(1); game.saves.autosave();\n7556:      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n7557:      this._musBus = c.createGain(); this._musBus.connect(this._master);\n7570:  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || this.ducked ? .35 : 1); }\n7623:    try { for (const v of Array.isArray(p) ? p : [p]) this._voice(o.vol === undefined ? v : Object.assign({}, v, { vol: (v.vol === undefined ? .3 : v.vol) * o.vol }), this._sfxBus, at, mul); }\n7739:    const c = this.ctx, bus = c.createGain(); bus.connect(this._musBus); C.bus = bus;\n896:  codeLabel(code) {\n9422:    if (r === 'reserved') { this._status = I.codeLabel(code) + ' is kept for the menus. Choose another, or press Escape.'; this._render(); return; }\n9423:    if (r) { this._status = I.codeLabel(code) + ' is already ' + nm(r) + '. Rebind ' + nm(r) + ' first, or choose another.'; this._render(); return; }\n9424:    this._capEnd(nm(c.a) + ': ' + I.codeLabel(code) + '. Saved.');","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01U7HzvUG7kSfJgaC465tDq9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
