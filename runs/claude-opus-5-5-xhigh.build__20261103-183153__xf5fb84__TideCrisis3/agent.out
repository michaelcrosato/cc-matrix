id, handlers: {}, sent: [], finished: null, readyCalled: false,\n    on(ev, fn) { (this.handlers[ev] || (this.handlers[ev] = [])).push(fn); return () => {}; },\n    emit(ev, ...a) { for (const f of this.handlers[ev] || []) f(...a); },\n    send(data, o = {}) { const rel = o.reliable !== false, size = bus.post(id, data, rel, o.to); this.sent.push({ t: bus.t, size, rel, kind: data.t }); return true; },\n    time() { return bus.t }, finish(r) { if (!this.finished) this.finished = r; }, ready() { this.readyCalled = true; }, answer() {} };\n  return h;\n}\nfunction round(t, o) {\n  const bus = makeBus(o), n = o.players, ids = [...Array(n).keys()], copies = [];\n  const info0 = { players: ids.map(i => ({ id: i, name: 'Agent' + i, color: '#ffffff' })), host: o.server ? 99 : 0, round: o.round || 1, seed: 4242, mode: 'shared-world' };\n  const all = o.server ? [99, ...ids] : ids;\n  for (const id of all) {\n    const { TC } = t.load(), info = Object.assign({}, info0, { me: id, isHost: id === info0.host, server: o.server && id === 99 });\n    const stage = ((info.round - 1) % 3) + 1, sim = new TC.Sim({ mode: 'host', stage, seed: info.seed, players: info.players.map(p => ({ name: p.name })), skipIntro: true });\n    info.players.forEach((p, i) => { sim.players[i].remote = !(p.id === info.host && !info.server); });\n    const hub = makeHub(bus, id), net = new TC.Net(hub, info), bot = new TC.Autopilot('fair'), P = { sim, localCmd: (i, dt) => bot.command(sim, i, dt) };\n    TC.play = P; const c = { id, TC, sim, hub, net, P, hashes: new Map(), gone: false }; copies.push(c); bus.copies.push(c);\n  }\n  return { bus, copies };\n}\nfunction run(R, secs, stopHostAt) {\n  const { bus, copies } = R;\n  for (let i = 0; i < secs * 120; i++) {\n    bus.step(1 / 120);\n    for (const c of copies) {\n      if (c.gone) continue;\n      if (stopHostAt !== undefined && c.net.isHost && i >= stopHostAt * 120) continue;\n      c.TC.play = c.P; c.net.update(1 / 120, c.P);\n      const k = c.net.isHost ? c.net.k : c.net.next; if (k % 120 === 0 && k > 0 && !c.hashes.has(k)) c.hashes.set(k, c.sim.hash());\n    }\n  }\n}\nexport default {\n  net(t) {\n    for (const o of [{ players: 1 }, { players: 2, lat: 40 }, { players: 4, lat: 150, jit: 50, loss: .05 }, { players: 2, server: true, lat: 60, jit: 20, loss: .02 }]) {\n      const label = o.players + 'p' + (o.server ? ' server' : '') + (o.lat ? ' lat' + o.lat : '');\n      const R = round(t, o); run(R, 16); const host = R.copies.find(c => c.net.isHost), reps = R.copies.filter(c => !c.net.isHost);\n      t.check(label + ': the host plays the round', host.sim.t > 10 && host.sim.phase !== 'gameover', host.sim.t);\n      for (const c of reps) {\n        let same = 0, diff = 0; for (const [k, h] of c.hashes) { if (!host.hashes.has(k)) continue; if (host.hashes.get(k) === h) same++; else diff++; }\n        t.check(label + ': replica ' + c.id + ' runs the same world', same >= 5 && diff === 0, same + ' same, ' + diff + ' differ');\n        t.check(label + ': replica ' + c.id + ' scores match', c.sim.players.every((p, i) => p.score === host.sim.players[i].score || Math.abs(p.score - host.sim.players[i].score) < 1));\n      }\n      for (const c of R.copies) {\n        const per = {}; for (const m of c.hub.sent) { const s = Math.floor(m.t / 1000); per[s] = (per[s] || 0) + 1; }\n        t.check(label + ': copy ' + c.id + ' sends at most 20 a second', Object.values(per).every(v => v <= 20), Math.max(0, ...Object.values(per)));\n        t.check(label + ': unreliable messages under 1,200 bytes', c.hub.sent.filter(m => !m.rel).every(m => m.size <= 1200));\n        t.check(label + ': reliable messages under 16 KB', c.hub.sent.filter(m => m.rel).every(m => m.size <= 16000));\n      }\n      if (o.players > 1) t.check(label + ': traffic both ways', host.hub.sent.length > 0 && reps.some(c => c.hub.sent.length > 0));\n      // time-up: the host finishes at once with valid standings\n      host.hub.emit('time-up', { graceMs: 3000 }); const fin = host.hub.finished;\n      t.check(label + ': time-up -> finish', !!fin && Array.isArray(fin.standings) && fin.standings.flat().length === o.players && fin.standings.flat().every(id => typeof id === 'number'));\n      t.check(label + ': finish has scores, stats and awards', fin && Object.keys(fin.scores).length === o.players && Object.keys(fin.stats).length === o.players && fin.awards.length === 3);\n      for (const c of R.copies) { c.hub.emit('end', { reason: 'finished' }); t.check(label + ': copy ' + c.id + ' stops on end', c.net.ended); }\n    }\n    // a player leaving, then the host leaving\n    const R = round(t, { players: 3, lat: 50 }); run(R, 4);\n    const host = R.copies.find(c => c.net.isHost); R.copies[2].gone = true; host.hub.emit('leave', { id: 2, reason: 'left' }); run(R, 3);\n    t.check('a player leaving: their agent is gone everywhere', !host.sim.players[2].present && !R.copies[1].sim.players[2].present);\n    host.gone = true; for (const c of R.copies) if (!c.gone) { c.hub.emit('leave', { id: 0, reason: 'left' }); c.hub.emit('end', { reason: 'host-left' }); }\n    t.check('the host leaving: the round ends void on the replicas', R.copies[1].net.ended && R.copies[1].net.endReason === 'host-left');\n  }\n};\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_013fFrTsQ7LgZGwUimW3Yq22","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh8czjh4MY79hvEYN35v","type":"message","role":"assistant","content":[{"type":"text","text":"Writing the test suites (gameplay, content, UI, net with a fake hub). Next: playthrough + browser suites, then run everything."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4200,"cache_read_input_tokens":740310,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4200},"output_tokens":65,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fcbe5b02-218b-4276-a1cd-eeebf017e39a","uuid":"3400cd95-bab3-4ca3-a417-6c9caaa0480a","timestamp":"2026-11-04T02:53:36.423Z","request_id":"req_011Cgh8czQ6dgi5reco3thHv"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh8czjh4MY79hvEYN35v","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HWcvY5hHhrNc69wg9Z4fS3","name":"Bash","input":{"command":"cat > tests/playthrough.suite.mjs <<'EOF'\n// --playthrough: the expert bot clears every stage (god mode off where it can), the fair bot clears Stage 1, the\n// showoff bot plays the whole ARCADE through its cutscenes, the Training range completes\nexport default async t => {\n  const { TC } = t.load();\n  const play = (o, style, secs) => { const s = new TC.Sim(o), bot = new TC.Autopilot(style); bot.skipCuts = true; const times = {}; let last = s.scene.id, ts = 0;\n    for (let i = 0; i < secs * 120; i++) { s.step(1 / 120, [bot.command(s, 0, 1 / 120)]); s.drain(); if (s.scene.id !== last) { times[last] = +(s.t - ts).toFixed(1); last = s.scene.id; ts = s.t; } if (s.phase === 'done' || s.phase === 'gameover' || s.phase === 'continue') break; if (o.stages && s.phase === 'done') break; }\n    return { s, times }; };\n  for (const st of [1, 2, 3]) { const { s, times } = play({ mode: 'stage', stage: st, seed: 21, skipIntro: true, cheats: { god: true } }, 'expert', 900); t.check('expert bot clears stage ' + st, s.phase === 'done', s.phase + ' at ' + s.scene.id + ' ' + JSON.stringify(times)); }\n  { const { s, times } = play({ mode: 'stage', stage: 1, seed: 22, skipIntro: true }, 'fair', 900); t.check('the fair bot clears stage 1 on Normal', s.phase === 'done', s.phase + ' ' + s.scene.id + ' lives ' + s.players[0].lives + ' ' + JSON.stringify(times)); }\n  { const { s } = play({ mode: 'range', stage: 'range', seed: 23 }, 'expert', 400); t.check('the Training range completes', s.phase === 'done', s.phase + ' ' + s.scene.id); }\n  // the whole ARCADE with its cutscenes: stage 1 -> 2 -> 3\n  { const s = new TC.Sim({ mode: 'arcade', stage: 1, seed: 24, cheats: { god: true, ammo: true } }), bot = new TC.Autopilot('showoff'); bot.skipCuts = true; let stage = 1, cuts = 0;\n    for (let i = 0; i < 120 * 2400; i++) { s.step(1 / 120, [bot.command(s, 0, 1 / 120)]); for (const e of s.drain()) if (e.type === 'cutstart') cuts++; if (s.phase === 'done') { if (stage < 3) { stage++; s.nextStage(stage); } else break; } }\n    t.check('the showoff bot plays the whole ARCADE to the ending', s.phase === 'done' && stage === 3, 'stage ' + stage + ' ' + s.phase + ' ' + s.scene.id);\n    t.check('every stage intro and outro played', cuts >= 6, cuts); }\n};\nEOF\ncat > tests/browser.suite.mjs <<'EOF'\n// --browser: the bundle in headless Chromium at four window sizes (no errors, the canvas drawn); --hub: the AI Hub\n// harness scenarios, served on 127.0.0.1 at a port the OS picks (our own server, stopped by its PID)\nimport { resolve } from 'node:path';\nimport { mkdirSync, copyFileSync, existsSync } from 'node:fs';\nimport { spawn } from 'node:child_process';\nconst NAME = 'TideCrisis3-TimeCrisis3-claude-opus-5-5-xhigh-20261103-183153';\nasync function browserOf(t) { process.env.TMPDIR = resolve(new URL('.tmp', t.root).pathname); mkdirSync(process.env.TMPDIR, { recursive: true }); const { chromium } = await import('playwright'); return chromium.launch({ args: ['--autoplay-policy=no-user-gesture-required'] }); }\nexport default {\n  async browser(t) {\n    const b = await browserOf(t), file = 'file://' + resolve(new URL('../../' + NAME + '.html', t.root).pathname);\n    for (const [w, h] of [[1920, 1080], [1280, 720], [2560, 1080], [1024, 768]]) {\n      const page = await b.newPage({ viewport: { width: w, height: h } }), errs = [];\n      page.on('pageerror', e => errs.push(e.message)); page.on('console', m => { if (m.type() === 'error') errs.push(m.text()); });\n      await page.goto(file); await page.waitForTimeout(2500);\n      await page.evaluate(() => TC.debug.start({ stage: 1, scene: '1-1' })); await page.waitForTimeout(2500);\n      const snap = await page.evaluate(() => TC.debug.snapshot());\n      t.check(w + 'x' + h + ': plays with no errors', errs.length === 0 && snap.scene === 'play' && snap.errors === 0, errs.slice(0, 2).join(' | '));\n      const filled = await page.evaluate(() => { const c = document.getElementById('screen'); return c.width > 0 && c.height > 0; });\n      t.check(w + 'x' + h + ': the canvas is drawn', filled);\n      if (w === 1280) { await page.mouse.move(640, 300); await page.mouse.down(); await page.waitForTimeout(80); await page.mouse.up(); await page.waitForTimeout(200); const sh = await page.evaluate(() => TC.play.sim.players[0].stats.shots); t.check('a mouse click fires', sh >= 1, sh); }\n      await page.close();\n    }\n    await b.close();\n  },\n  async hub(t) {\n    const dir = new URL('hubtest/', t.root).pathname; mkdirSync(dir, { recursive: true });\n    copyFileSync(resolve(new URL('../../' + NAME + '.html', t.root).pathname), dir + 'game.html');\n    for (const f of ['harness.html', 'bridge.js', 'round.js', 'session.js']) copyFileSync(new URL('hub/' + f, t.root).pathname, dir + f);\n    const srv = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\n    const port = await new Promise((ok, no) => { let buf = ''; const f = d => { buf += d; const m = buf.match(/port (\\d+)/); if (m) ok(+m[1]); }; srv.stdout.on('data', f); srv.stderr.on('data', f); setTimeout(() => no(new Error('no port')), 8000); });\n    const b = await browserOf(t);\n    try {\n      const page0 = await b.newPage(); await page0.goto('http://127.0.0.1:' + port + '/game.html'); await page0.waitForTimeout(1500);\n      t.check('the served page is our game', (await page0.title()) === 'Tide Crisis 3'); await page0.close();\n      for (const q of ['players=2&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1', 'players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1', 'players=2&scenario=server&auto=1']) {\n        const page = await b.newPage({ viewport: { width: 1400, height: 900 } });\n        await page.goto('http://127.0.0.1:' + port + '/harness.html?game=game.html&' + q);\n        try { await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 240000 }); } catch (e) { /* reported below */ }\n        const r = await page.evaluate(() => ({ pass: window.__hubCheck && window.__hubCheck.pass, fails: (window.__hubCheck && (window.__hubCheck.checks || window.__hubCheck.results) || []).filter(c => c && (c.ok === false || c.pass === false)).map(c => c.name || c.label || JSON.stringify(c)).slice(0, 6) }));\n        t.check('hub harness ' + q, r.pass === true, JSON.stringify(r.fails));\n        await page.close();\n      }\n    } finally { await b.close(); srv.kill(); }\n  }\n};\nEOF\nsed -i \"s/for (const f of readdirSync(t.at('src')).filter(f => \\/^(1\\[0-9\\]|2\\[0-9\\]|3\\[0-9\\]|60)-\\/.test(f) \\&\\& !f.startsWith('10-'))) /for (const f of readdirSync(t.at('src')).filter(f => \\/^(1[0-9]|2[0-9]|3[0-9]|60|62)-\\/.test(f))) /\" tests/core.suite.mjs && grep -n \"no Math.random in\" tests/core.suite.mjs | head -2; for st in 2 3; do echo \"== $st\"; grep -E \"scene|clear|STUCK|END\" /tmp/xf5_f$st.txt | tail -12; done","description":"Write playthrough and browser/hub suites; check fair-bot logs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4200,"cache_read_input_tokens":740310,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4200},"output_tokens":65,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fcbe5b02-218b-4276-a1cd-eeebf017e39a","uuid":"60f95cbd-10e3-4d2c-9e5a-d0049d44dab8","timestamp":"2026-11-04T02:54:00.620Z","request_id":"req_011Cgh8czQ6dgi5reco3thHv","wire_tool_inputs":{"toolu_01HWcvY5hHhrNc69wg9Z4fS3":{"command":"cd /home/micha/dev/cc-matrix/runs/cla