- L.t < .35 && Math.hypot(x - L.x, y - L.y) < 8) { this._gTap2 = [x, y]; this._lastTap = null; }\n      else this._lastTap = { x, y, t: this.clock };\n    }\n  }\n  /** browser client coords -> screen pixels [x, y] (the HUD's space, with no camera), or null without a canvas */\n  screenPoint(cx, cy) {\n    const S = this.screen; if (!S.canvas) return null;\n    const rc = S.canvas.getBoundingClientRect(); return [((cx - rc.left) * S.dpr - S.OX) / S.S, ((cy - rc.top) * S.dpr - S.OY) / S.S];\n  }\n  /** advance input by one step: read the gamepad and turn presses since the last step into this step's pressed() and\n   *  released() (the engine calls it every step) */\n  tick(dt) {\n    this._suppressed.clear();\n    this.clock += dt;\n    let pads = [];\n    try { pads = navigator.getGamepads ? navigator.getGamepads() : []; } catch (e) { /* gamepads blocked */ }\n    const C = this._claimed, ok = p => p && p.connected !== false && (this.pad === 'any' ? !(C && C.has(p.index)) : p.index === this.pad);   // (its own pad, or any another player hasn't)\n1250:const MENU_KEYS = {\n1256:const BINDABLE = /^(Key[A-Z]|Digit\\d|Numpad\\d|Arrow(Up|Down|Left|Right)|Space|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Tab|Backspace|Backquote|Minus|Equal|Bracket(Left|Right)|Backslash|Semicolon|Quote|Comma|Period|Slash|CapsLock|Mouse[0-4]|Pad([0-8]|1[0-5]))$/;\n1259:const STICK_CODES = { up: 'PadAxisUp', down: 'PadAxisDown', left: 'PadAxisLeft', right: 'PadAxisRight' };\n1263:const PAD_GLYPHS = {\n1269:const CODE_LABELS = { Space: 'Space', ShiftLeft: 'Shift', ShiftRight: 'R Shift', ControlLeft: 'Ctrl', ControlRight: 'R Ctrl', AltLeft: 'Alt', AltRight: 'R Alt',\n1275:Input.DEFAULT = {\n1295:Input.SHMUP = {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019FJTANPxxQZYxuTS4TUUWt","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
