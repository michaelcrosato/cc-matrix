e: o.stage || 1, difficulty: diff, coop: !!o.coop, table: o.mode === 'arcade' ? (o.coop ? 'coop' : 'arcade') : 'stage' + (o.stage || 1), sim: null, players };\n  return TC.run;\n}\n5:const PRESET = {\n17:TC.PRESET = PRESET;\n49:    // pad: right stick, else left stick; keys: the moves (arrows / WASD)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Bc6BvRYmbDEciwrMJ7ajvu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
