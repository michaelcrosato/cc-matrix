mv(slot.cover.at), look: mv(slot.cover.look) }, auto: true };\n  };\n  if (sc.slots.length === 1) sc.slots.push(off(sc.slots[0], 26));\n  sc.slots[2] = sc.slots[2] || off(sc.slots[0], -28);\n  sc.slots[3] = sc.slots[3] || off(sc.slots[1], 28);\n  sc.coverList = []; sc.coversById = {};\n  const tgt = sc.carrier ? null : s0.stand.at;\n  for (const [id, c] of Object.entries(sc.covers || {})) {\n    const cv = Object.assign({ id, h: 20, peek: ['up'] }, c);\n    if (cv.face === undefined) cv.face = tgt ? Math.atan2(tgt[1] - cv.at[1], tgt[0] - cv.at[0]) : Math.PI;\n    else cv.face *= DEG;\n    sc.coverList.push(cv); sc.coversById[id] = cv;\n  }\n  return sc;\n}\nTC.prepScene = prepScene;\n\n/* ---- the Director: one scene at a time ---- */\nclass Director {\n  constructor(sim, sc) {\n    this.sim = sim; this.sc = prepScene(sc); this.t = 0; this.fired = new Set(); this.kills = 0; this.cues = new Set(); this.pending = [];\nsrc/60-sim.js:7: * Phases: cut (a cutscene) -> travel (WAIT) -> arrive -> action (TIME runs) -> clear -> travel ... -> outro (cut) ->\nsrc/60-sim.js:65:    else if (sceneId) this.arriveNow();\nsrc/60-sim.js:85:    const from = this.prevSlots ? this.prevSlots[0].stand : this.startPose || (sc.arrive.start ? { x: sc.arrive.start[0], y: sc.arrive.start[1], z: sc.arrive.start[2] } : null);\nsrc/60-sim.js:87:    for (const p of sc.arrive.path) pts.push(p.slice());\nsrc/60-sim.js:94:  arriveNow() { this.travelD = this.travelL; this.setPhase('arrive'); this.phaseT = .35; }\nsrc/60-sim.js:101:      this.arriveNow();\nsrc/60-sim.js:148:      const bob = this.scene.arrive.walk ? Math.sin(this.t * 12.6) * 1.2 * (1 - lk) : 0;\nsrc/60-sim.js:153:    if (ph === 'arrive' && this.railEnd) { const k = smooth(clamp(this.phaseT / .35, 0, 1)); yaw = lerpAng(this.railEnd.yaw, yaw, k); pitch = lerp(this.railEnd.pitch, pitch, k); }\nsrc/60-sim.js:159:  swapSlots(alt) { const from = this.players.map((p, i) => this.cameraFor(i)); this.slotsAlt = prepScene({ slots: alt.map(s => ({