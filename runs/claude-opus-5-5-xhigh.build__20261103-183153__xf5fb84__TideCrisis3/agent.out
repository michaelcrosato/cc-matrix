2500);\n      const snap = await page.evaluate(() => TC.debug.snapshot());\n      t.check(w + 'x' + h + ': plays with no errors', errs.length === 0 && snap.scene === 'play' && snap.errors === 0, errs.slice(0, 2).join(' | '));\n      const filled = await page.evaluate(() => { const c = document.getElementById('screen'); return c.width > 0 && c.height > 0; });\n      t.check(w + 'x' + h + ': the canvas is drawn', filled);\n      if (w === 1280) { await page.mouse.move(640, 300); await page.mouse.down(); await page.waitForTimeout(80); await page.mouse.up(); await page.waitForTimeout(200); const sh = await page.evaluate(() => TC.play.sim.players[0].stats.shots); t.check('a mouse click fires', sh >= 1, sh); }\n      await page.close();\n    }\n    await b.close();\n  },\n  async hub(t) {\n    const dir = new URL('hubtest/', t.root).pathname; mkdirSync(dir, { recursive: true });\n    copyFileSync(resolve(new URL('../' + NAME + '.html', t.root).pathname), dir + 'game.html');\n    for (const f of ['harness.html', 'bridge.js', 'round.js', 'session.js']) copyFileSync(new URL('hub/' + f, t.root).pathname, dir + f);\n    const srv = spawn('python3', ['-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\n    const port = await new Promise((ok, no) => { let buf = ''; const f = d => { buf += d; const m = buf.match(/port (\\d+)/); if (m) ok(+m[1]); }; srv.stdout.on('data', f); srv.stderr.on('data', f); setTimeout(() => no(new Error('no port')), 8000); });\n    const b = await browserOf(t);\n    try {\n      const page0 = await b.newPage(); await page0.goto('http://127.0.0.1:' + port + '/game.html'); await page0.waitForTimeout(1500);\n      t.check('the served page is our game', (await page0.title()) === 'Tide Crisis 3'); await page0.close();\n      for (const q of ['players=2&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1', 'players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1', 'players=2&scenario=server&auto=1']) {\n        const page = await b.newPage({ viewport: { width: 1400, height: 900 } });\n        await page.goto('http://127.0.0.1:' + port + '/harness.html?game=game.html&' + q);\n        try { await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 240000 }); } catch (e) { /* reported below */ }\n        const r = await page.evaluate(() => ({ pass: window.__hubCheck && window.__hubCheck.pass, fails: (window.__hubCheck && (window.__hubCheck.checks || window.__hubCheck.results) || []).filter(c => c && (c.ok === false || c.pass === false)).map(c => c.name || c.label || JSON.stringify(c)).slice(0, 6) }));\n        t.check('hub harness ' + q, r.pass === true, JSON.stringify(r.fails));\n        await page.close();\n      }\n    } finally { await b.close(); srv.kill(); }\n  }\n};","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BBQzUXhXtAo5Nf9qYmeTqP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghDPyPYkzuoxzkJPiXL9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012hZZnLLmBEyiMoD7Ga5R1o","name":"Bash","input":{"command":"cat tests/run.mjs tests/content.suite.mjs tests/playthrough.suite.mjs tests/play.mjs; cat tools/shot.mjs | head -60","description":"Show runner, content, playthrough and shot tool"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4512,"cache_read_input_tokens":49144,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4512},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fcbe5b02-218b-4276-a1cd-eeebf017e39a","uuid":"917614e2-997f-4604-8976-a17302982a50","timestamp":"2026-11-04T03:56:16.341Z","request_id":"req_011CghDPyAeYHqMDjierA7c5","wire_tool_inputs":{"toolu_012hZZnLLmBEyiMoD7Ga5R1o":{"command":"cat tests/run.mjs tests/content.suite.mjs tests/playthrough.suite.mjs tests/play.mjs; cat tools/shot.mjs | head -60","description":"Show runner, content, playthrough and shot tool"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012hZZnLLmBEyiMoD7Ga5R1o","type":"tool_result","content":"// THE test command. node tests/run.mjs [suite ...] [--playthrough] [--browser] [--hub] [--all]\n// Prints only failures (\"FAIL suite › check: detail\") and one line: \"N passed, M failed (T s)\". Exit code 1 on failure.\nimport vm from 'node:vm';\nimport { readFileSync, statSync, readdirSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nconst root = new URL('../', import.meta.url), at = p => new URL(p, root);\nconst args = process.argv.slice(2), flags = new Set(args.filter(a => a.startsWith('--'))), pick = args.filter(a => !a.startsWith('--'));\n// rebuild build/game.js when a fragment is newer\nconst built = (() => { try { return statSync(at('build/game.js')).mtimeMs; } catch (e) { return 0; } })();\nif (readdirSync(at('src')).some(f => statSync(at('src/' + f)).mtimeMs > built)) execFileSync('node', [new URL('tools/build.mjs', root).pathname, '--js-only']);\nconst ENGINE = readFileSync(at('engine/my-3d2dge.js'), 'utf8'), GAME = readFileSync(at('build/game.js'), 'utf8');\nlet passed = 0, failed = 0; const t0 = Date.now();\n/** a fresh headless engine + game in its own context */\nfunction load(o = {}) {\n  const ctx = { console: { log() {}, warn() {}, error: (...a) => o.errors && o.errors.push(a.join(' ')) }, setTimeout, clearTimeout, TC_NO_BOOT: !o.boot };\n  vm.createContext(ctx); vm.runInContext(ENGINE, ctx); vm.runInContext(GAME, ctx);\n  return { ctx, E: ctx.My3D2dge, TC: ctx.TC, game: ctx.TC.game };\n}\nfunction makeT(suite) {\n  return {\n    check(name, ok, detail = '') { if (ok) passed++; else { failed++; console.log('FAIL ' + suite + ' › ' + name + (detail ? ': ' + detail : '')); } },\n    load,\n    /** a Sim, stepped by the given command function; returns the sim */\n    sim(TC, o) { return new TC.Sim(Object.assign({ mode: 'stage', stage: 1, seed: 7, skipIntro: true }, o)); },\n    step(sim, secs, cmd) { const n = Math.round(secs * 120); for (let i = 0; i < n; i++) sim.step(1 / 120, typeof cmd === 'function' ? cmd(sim, i) : cmd || []); },\n    root, at\n  };\n}\nconst suites = {};\nconst mods = ['core', 'gameplay', 'content', 'ui', 'net'];\nfor (const m of mods) Object.assign(suites, (await import(new URL('./' + m + '.suite.mjs', import.meta.url))).default);\nconst slow = { playthrough: (await import('./playthrough.suite.mjs')).default, browser: (await import('./browser.suite.mjs')).default.browser, hub: (await import('./browser.suite.mjs')).default.hub };\nconst run = pick.length ? pick : Object.keys(suites);\nfor (const name of run) {\n  const s = suites[name] || slow[name]; if (!s) { console.log('FAIL runner › unknown suite ' + name); failed++; continue; }\n  try { await s(makeT(name)); } catch (e) { failed++; console.log('FAIL ' + name + ' › threw: ' + (e && e.stack ? e.stack.split('\\n').slice(0, 3).join(' | ') : e)); }\n}\nfor (const f of ['playthrough', 'browser', 'hub']) if ((flags.has('--' + f) || flags.has('--all')) && !pick.includes(f)) { try { await slow[f](makeT(f)); } catch (e) { failed++; console.log('FAIL ' + f + ' › threw: ' + (e && e.stack ? e.stack.split('\\n').slice(0, 3).join(' | ') : e)); } }\nconsole.log(passed + ' passed, ' + failed + ' failed (' + ((Date.now() - t0) / 1000).toFixed(1) + ' s)');\nprocess.exit(failed ? 1 : 0);\n// content suites: the validators over every stage (ids, exposed peeks visible from the slots), the cutscenes\nexport default {\n  content(t) {\n    const { TC } = t.load(), V3 = TC.V3;\n    const errs = TC.validateContent(); t.check('validators: every id resolves', errs.length === 0, errs.slice(0, 4).join('; '));\n    // every cover point's exposed head (an 'up' peek) can be seen from slot 1's stand pose (or slot 2's)\n    for (const st of Object.values(TC.REG.stage)) {\n      const sim = new TC.Sim({ mode: 'stage', stage: st.id, seed: 1, skipIntro: true });\n      for (let k = 0; k < st.scenes.length; k++) {\n        const sc = TC.REG.scene[st.scenes[k]]; if (sc.carrier || sc.boss) continue;\n        sim.startScene(k, true);\n        for (const cv of sc.coverList) {\n          if (cv.noCheck) continue;\n          const side = m => { const k = m === 'left' ? -12 : m === 'right' ? 12 : 0; return [cv.at[0] - Math.sin(cv.face) * k, cv.at[1] + Math.cos(cv.face) * k, cv.at[2] + 27]; };\n          const seen = cv.peek.some(m => { const head = side(m); return [0, 1].some(i => { const c = sim.slotPose(i, 0), o = [c.x, c.y, c.z], d = V3.sub(head, o), L = V3.len(d), w = sim.rayWorld({ o, d: V3.mul(d, 1 / L) }, L, false); const a = TC.worldToAim(c, head); return (!w || w.t > L - 4) && a && Math.abs(a[0]) < 1.7 && Math.abs(a[1]) < .95; }); });\n          let why = ''; if (!seen) { const c = sim.slotPose(0, 0), o = [c.x, c.y, c.z], head = side(cv.peek[0]), d = V3.sub(head, o), L = V3.len(d), w = sim.rayWorld({ o, d: V3.mul(d, 1 / L) }, L, false), a = TC.worldToAim(c, head); why = 'aim ' + (a ? a[0].toFixed(2) + ',' + a[1].toFixed(2) : '-') + ' block ' + (w ? w.t.toFixed(0) + '/' + L.toFixed(0) + ' ' + (w.col.box ? w.col.box.map(v => v.toFixed(0)).join(',') : w.col.impact) : '-'); }\n          t.check(sc.id + ' cover ' + cv.id + ': the exposed head is visible', seen, why);\n        }\n      }\n    }\n    // the hub's slots 3 and 4 exist and differ\n    for (const sc of Object.values(TC.REG.scene)) t.check(sc.id + ': 4 slots', sc.slots && sc.slots.length === 4);\n  },\n  story(t) {\n    const { TC } = t.load();\n    for (const id of Object.keys(TC.REG.cutscene)) {\n      const s = new TC.Sim({ mode: 'stage', stage: 1, seed: 1, skipIntro: true }); let done = false;\n      TC.startCut(s, id, () => { done = true; }); for (let i = 0; i < 120 * 90 && !done; i++) s.step(1 / 120, []);\n      t.check('cutscene ' + id + ' runs to its end headless', done);\n      const s2 = new TC.Sim({ mode: 'stage', stage: 1, seed: 1, skipIntro: true }); let d2 = false; TC.startCut(s2, id, () => { d2 = true; }); for (let i = 0; i < 120 && !d2; i++) s2.step(1 / 120, [{ aim: [0, 0], fireDown: true, firePressed: i === 0 }]);\n      t.check('cutscene ' + id + ': holding skips it', d2);\n      for (const st of TC.REG.cutscene[id].steps) if (st.say) t.check(id + ': speaker ' + st.say[0], !!TC.REG.speaker[st.say[0]]);\n    }\n    for (const st of [1, 2, 3]) { const S = TC.REG.stage[st]; t.check('stage ' + st + ' briefing', S.briefing && S.briefing.length >= 2 && S.briefing.every(b => TC.REG.speaker[b[0]])); }\n    t.check('voice durations positive', Object.keys(TC.REG.speaker).every(id => TC.lineDur('Test line for ' + id + '!', id) > 0));\n    const s = new TC.Sim({ mode: 'arcade', stage: 1, seed: 1 }); t.check('an arcade run opens on the stage intro', !!s.cut && s.cut.id === 'c1-intro');\n  }\n};\n// --playthrough: the expert bot clears every stage in god mode, the fair bot clears every stage on Normal, the\n// showoff bot plays the whole ARCADE through its cutscenes, the Training range completes\nexport default async t => {\n  const { TC } = t.load();\n  const play = (o, style, secs) => { const s = new TC.Sim(o), bot = new TC.Autopilot(style); bot.skipCuts = true; const times = {}; let last = s.scene.id, ts = 0;\n    for (let i = 0; i < secs * 120; i++) { s.step(1 / 120, [bot.command(s, 0, 1 / 120)]); s.drain(); if (s.scene.id !== last) { times[last] = +(s.t - ts).toFixed(1); last = s.scene.id; ts = s.t; } if (s.phase === 'done' || s.phase === 'gameover' || s.phase === 'continue') break; if (o.stages && s.phase === 'done') break; }\n    return { s, times }; };\n  for (const st of [1, 2, 3]) { const { s, times } = play({ mode: 'stage', stage: st, seed: 21, skipIntro: true, cheats: { god: true } }, 'expert', 900); t.check('expert bot clears stage ' + st, s.phase === 'done', s.phase + ' at ' + s.scene.id + ' ' + JSON.stringify(times)); }\n  for (const st of [1, 2, 3]) { const { s, times } = play({ mode: 'stage', stage: st, seed: 31, skipIntro: true }, 'fair', 1200); t.check('the fair bot clears stage ' + st + ' on Normal without a continue', s.phase === 'done' && s.players[0].conts === 0, s.phase + ' ' + s.scene.id + ' lives ' + s.players[0].lives + ' ' + JSON.stringify(times)); }\n  { const { s } = play({ mode: 'range', stage: 'range', seed: 23 }, 'expert', 400); t.check('the Training range completes', s.phase === 'done', s.phase + ' ' + s.scene.id); }\n  // the whole ARCADE with its cutscenes: stage 1 -> 2 -> 3\n  { const s = new TC.Sim({ mode: 'arcade', stage: 1, seed: 24, cheats: { god: true, ammo: true } }), bot = new TC.Autopilot('showoff'); bot.skipCuts = true; let stage = 1, cuts = 0;\n    for (let i = 0; i < 120 * 2400; i++) { s.step(1 / 120, [bot.command(s, 0, 1 / 120)]); for (const e of s.drain()) if (e.type === 'cutstart') cuts++; if (s.phase === 'done') { if (stage < 3) { stage++; s.nextStage(stage); } else break; } }\n    t.check('the showoff bot plays the whole ARCADE to the ending', s.phase === 'done' && stage === 3, 'stage ' + stage + ' ' + s.phase + ' ' + s.scene.id);\n    t.check('every stage intro and outro played', cuts >= 6, cuts); }\n};\n// quick bot playthrough: node tests/play.mjs <stage> [style] [god]\nimport vm from 'node:vm'; import { readFileSync } from 'node:fs';\nconst ctx = { console, setTimeout, clearTimeout, TC_NO_BOOT: true }; vm.createContext(ctx); ctx.window = undefined;\nvm.runInContext(readFileSync(new URL('../engine/my-3d2dge.js', import.meta.url), 'utf8'), ctx);\nvm.runInContext(readFileSync(new URL('../build/game.js', import.meta.url), 'utf8'), ctx);\nconst TC = ctx.TC, stage = isNaN(+process.argv[2]) ? process.argv[2] : +process.argv[2], style = process.argv[3] || 'fair', god = process.argv[4] === 'god';\nconst sim = new TC.Sim({ mode: stage === 'range' ? 'range' : 'stage', stage, seed: 11, skipIntro: true, cheats: { god } });\nconst bot = new TC.Autopilot(style); let last = '', t0 = Date.now(), log = [];\nfor (let i = 0; i < 120 * 60 * 12; i++) {\n  sim.step(1 / 120, [bot.command(sim, 0, 1 / 120)]);\n  for (const e of sim.drain()) if (['scene', 'clear', 'hurt', 'timeup', 'bossdown', 'gameover', 'stageclear', 'continue', 'out'].includes(e.type)) log.push(sim.t.toFixed(1) + ' ' + e.type + ' ' + (e.id || e.scene || e.why || e.name || ''));\n  const k = sim.phase + ':' + sim.scene.id; if (k !== last) { last = k; }\n  if (sim.phase === 'done' || sim.phase === 'gameover' || sim.phase === 'continue') break;\n}\nconst p = sim.players[0];\nconsole.log(log.join('\\n'));\nconsole.log('END', sim.phase, sim.scene.id, 't', sim.t.toFixed(1), 'score', p.score, 'lives', p.lives, 'acc', (p.stats.hits / Math.max(1, p.stats.shots)).toFixed(2), 'kills', p.stats.kills, 'saves', p.stats.saves, 'ms', Date.now() - t0);\nif (sim.phase !== 'done') console.log(JSON.stringify(sim.snapshot()).slice(0, 800));\nif (sim.phase !== 'done') {\n  const V3 = TC.V3, cam = sim.cameraFor(0), o = [cam.x, cam.y, cam.z];\n  for (const e of sim.enemies) if (e.alive && !e.civ && !e.ally) { const h = e.vols && e.vols.head ? e.vols.head.c : [e.x, e.y, e.z + 20], a = TC.worldToAim(cam, h), d = V3.sub(h, o), L = V3.len(d), w = sim.rayWorld({ o, d: V3.mul(d, 1 / L) }, L);\n    console.log('STUCK', e.type, 'cover', e.cover && e.cover.id, 'entry', e.entry, 'state', e.state, 'st', e.st.toFixed(1), 'pos', [e.x, e.y, e.z].map(v => v.toFixed(0)).join(','), 'dz', e.dz.toFixed(1), 'head', h.map(v => v.toFixed(0)).join(','), 'aim', a && a.map(v => v.toFixed(2)).join(','), 'block', w ? w.t.toFixed(0) + '/' + L.toFixed(0) + ' ' + (w.col.box ? w.col.box.map(v => v.toFixed(0)).join(',') : w.col.impact) : 'clear'); }\n}\n// node tools/shot.mjs <page> <out.png> [--wait ms] [--size 1280x720] [--eval js] [--keys \"Enter,wait:500,...\"]\n// Opens a page from file:// in headless Chromium, runs steps, saves a screenshot, prints console errors.\nimport { chromium } from 'playwright';\nimport { resolve } from 'node:path';\nimport { mkdirSync } from 'node:fs';\nconst args = process.argv.slice(2), page0 = args[0], out = args[1];\nconst opt = k => { const i = args.indexOf('--' + k); return i >= 0 ? args[i + 1] : null; };\nconst [w, h] = (opt('size') || '1280x720').split('x').map(Number);\nprocess.env.TMPDIR = process.env.TMPDIR || resolve('.tmp'); mkdirSync(process.env.TMPDIR, { recursive: true });\nconst browser = await chromium.launch({ args: ['--autoplay-policy=no-user-gesture-required'] });\nconst page = await browser.newPage({ viewport: { width: w, height: h } });\nconst errs = [];\npage.on('console', m => { if (m.type() === 'error' || m.type() === 'warning') errs.push(m.type() + ': ' + m.text()); else if (args.includes('--log')) console.log('log:', m.text()); });\npage.on('pageerror', e => errs.push('pageerror: ' + e.message + '\\n' + (e.stack || '').split('\\n').slice(0, 4).join('\\n')));\nconst url = page0.startsWith('http') ? page0 : 'file://' + resolve(page0.split('#')[0]) + (page0.includes('#') ? '#' + page0.split('#')[1] : '') + (page0.includes('?') ? '' : '');\nawait page.goto(url);\nawait page.waitForTimeout(+(opt('wait') || 1500));\nfor (const s of (opt('keys') || '').split('|').filter(Boolean)) {\n  if (s.startsWith('wait:')) await page.waitForTimeout(+s.slice(5));\n  else if (s.startsWith('eval:')) console.log('eval:', JSON.stringify(await page.evaluate(s.slice(5))));\n  else if (s.startsWith('down:')) await page.keyboard.down(s.slice(5));\n  else if (s.startsWith('up:')) await page.keyboard.up(s.slice(5));\n  else if (s.startsWith('click:')) { const [x, y] = s.slice(6).split(':').map(Number); await page.mouse.click(x, y); }\n  else if (s.startsWith('move:')) { const [x, y] = s.slice(5).split(':').map(Number); await page.mouse.move(x, y); }\n  else if (s.startsWith('shot:')) await page.screenshot({ path: s.slice(5) });\n  else await page.keyboard.press(s);\n}\nif (opt('eval')) console.log('eval:', JSON.stringify(await page.evaluate(opt('eval'))));\nif (out) await page.screenshot({ path: out });\nfor (const e of errs.slice(0, 20)) console.log(e);\nawait browser.close();","is_erro