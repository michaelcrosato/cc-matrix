{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh4Cm9zH9YTF8xK4izSV","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6938,"cache_read_input_tokens":353918,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6938},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fcbe5b02-218b-4276-a1cd-eeebf017e39a","uuid":"89b42425-40b4-41bd-a55b-48d2e5381378","timestamp":"2026-11-04T01:56:12.438Z","request_id":"req_011Cgh4Cks8VCJdcqmHePv3R","thinking_duration_ms":32596,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh4Cm9zH9YTF8xK4izSV","type":"message","role":"assistant","content":[{"type":"text","text":"Now the stage format/Director and the Sim core that ties everything together."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6938,"cache_read_input_tokens":353918,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6938},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fcbe5b02-218b-4276-a1cd-eeebf017e39a","uuid":"6da0f6f9-cd74-47dc-9230-41dacc2deb56","timestamp":"2026-11-04T01:56:12.440Z","request_id":"req_011Cgh4Cks8VCJdcqmHePv3R"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh4Cm9zH9YTF8xK4izSV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Nvc6BaRPno7adZxCkrSshP","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183153__xf5fb84/work/TideCrisis3-TimeCrisis3-claude-opus-5-5-xhigh-20261103-183153/src/30-stagefmt.js","content":"/* 30-stagefmt: the stage and scene schema, the Director (rail travel -> ACTION -> waves by time, by carrier distance,\n * after a clear, after kills, on a cue -> clear -> ride on -> boss -> outro) and the content validators.\n *   def('stage', n, { name, place, clock, music, env, build(G, S), carriers, intro, outro, scenes: [ids] })\n *   def('scene', id, { title, time, arrive: { path, speed, look }, slots: [{ stand: { at, look }, cover: { at, look } }],\n *     carrier, covers: { id: { at, h, peek, face, ledge, water, floor } }, waves: [{ id, at | after | atD | kills | on,\n *     delay, spawn: [[type, coverId, opts]] }], civilians, allies, cues: [{ at | on, say, prompt, do }], boss, objective })\n * Slots 3 and 4 (AI Hub) are slot 1 moved 28 units to its left and slot 2 moved 28 units to its right. */\nconst EYE = 24, EYE_COVER = 12;\nfunction lookAngles(from, to) { const dx = to[0] - from[0], dy = to[1] - from[1], dz = to[2] - from[2]; return [Math.atan2(dy, dx), Math.atan2(dz, Math.hypot(dx, dy))]; }\nTC.lookAngles = lookAngles;\n\n/** prepare a scene for play: derived slots, cover faces, lists */\nfunction prepScene(sc) {\n  if (sc._prepped) return sc; sc._prepped = true;\n  const s0 = sc.slots[0];\n  const off = (slot, k) => {\n    const st = slot.stand, look = st.look || [st.at[0] + 100, st.at[1], st.at[2]], [yaw] = sc.carrier ? [(st.yaw || 0) * DEG] : lookAngles(st.at, look);\n    const r = [-Math.sin(yaw) * k, Math.cos(yaw) * k], mv = p => p && [p[0] + r[0], p[1] + r[1], p[2]];\n    if (sc.carrier) return { stand: Object.assign({}, st, { at: [st.at[0], st.at[1] + k, st.at[2]] }), cover: Object.assign({}, slot.cover, { at: [slot.cover.at[0], slot.cover.at[1] + k, slot.cover.at[2]] }), auto: true };\n    return { stand: { at: mv(st.at), look: mv(st.look) }, cover: { at: mv(slot.cover.at), look: mv(slot.cover.look) }, auto: true };\n  };\n  if (sc.slots.length === 1) sc.slots.push(off(sc.slots[0], 26));\n  sc.slots[2] = sc.slots[2] || off(sc.slots[0], -28);\n  sc.slots[3] = sc.slots[3] || off(sc.slots[1], 28);\n  sc.coverList = []; sc.coversById = {};\n  const tgt = sc.carrier ? null : s0.stand.at;\n  for (const [id, c] of Object.entries(sc.covers || {})) {\n    const cv = Object.assign({ id, h: 20, peek: ['up'] }, c);\n    if (cv.face === undefined) cv.face = tgt ? Math.atan2(tgt[1] - cv.at[1], tgt[0] - cv.at[0]) : Math.PI;\n    else cv.face *= DEG;\n    sc.coverList.push(cv); sc.coversById[id] = cv;\n  }\n  return sc;\n}\nTC.prepScene = prepScene;\n\n/* ---- the Director: one scene at a time ---- */\nclass Director {\n  constructor(sim, sc) {\n    this.sim = sim; this.sc = prepScene(sc); this.t = 0; this.kills = 0; this.cues = new Set(); this.pending = [];\n    this.waves = (sc.waves || []).map((w, i) => ({ w, id: w.id || 'w' + i, started: false, ids: [], i }));\n    this.civs = (sc.civilians || []).map(c => ({ c, done: false }));\n    this.allies = [];\n  }\n  start() {\n    const sim = this.sim, sc = this.sc;\n    for (const cv of sc.coverList) cv.taken = 0;\n    if (sim.players.length === 1 && sim.mode !== 'attract' || sim.mode === 'attract') for (const a of sc.allies || []) this.allies.push(spawnEnemy(sim, 'ally', null, { who: a.who, from: a.at, facing: a.facing, every: a.every, kills: a.kills }));\n    if (sc.onStart) sc.onStart(sim);\n  }\n  waveDone(W) { return W.started && W.ids.every(id => { const e = this.sim.enemyById(id); return !e || !e.alive || e.civ; }) && !this.pending.some(p => p.wave === W.id); }\n  step(dt) {\n    const sim = this.sim, sc = this.sc; this.t += dt;\n    for (const W of this.waves) {\n      if (W.started) continue;\n      const w = W.w; let go = false;\n      if (w.at !== undefined) go = this.t >= w.at;\n      else if (w.atD !== undefined) go = sim.carrierD() >= w.atD;\n      else if (w.kills !== undefined) go = this.kills >= w.kills;\n      else if (w.on) go = this.cues.has(w.on);\n      else if (w.after === 'clear' || !w.after) go = this.waves.slice(0, W.i).every(o => this.waveDone(o));\n      else go = this.waves.some(o => o.id === w.after && this.waveDone(o));\n      if (go && w.delay) { if (W.wait === undefined) W.wait = this.t + w.delay; go = this.t >= W.wait; }\n      if (!go) continue;\n      W.started = true;\n      for (const s of w.spawn || []) { const o = Object.assign({ wave: W.id }, s[2] || {}); if (o.delay) this.pending.push({ at: this.t + o.delay, s, o, wave: W.id }); else W.ids.push(spawnEnemy(sim, s[0], s[1], o).id); }\n      if (w.say) sim.say(w.say[0], w.say[1]);\n      if (w.cue) sim.cue(w.cue);\n      if (w.do) w.do(sim);\n    }\n    for (const P of this.pending.slice()) if (this.t >= P.at) { this.pending.splice(this.pending.indexOf(P), 1); const W = this.waves.find(x => x.id === P.wave); const e = spawnEnemy(sim, P.s[0], P.s[1], P.o); if (W) W.ids.push(e.id); }\n    for (const C of this.civs) if (!C.done && this.t >= C.c.at) { C.done = true; spawnEnemy(sim, 'civilian', null, { route: C.c.route, from: C.c.route[0], look: C.c.look, leave: C.c.leave, speed: C.c.speed }); if (C.c.say) sim.say(C.c.say[0], C.c.say[1]); }\n    for (const c of sc.cues || []) if (c.at !== undefined && !c._k && this.t >= c.at) { this.fire(c); }\n  }\n  cue(name, data) {\n    this.cues.add(name);\n    for (const c of this.sc.cues || []) if (c.on === name && !c._k) this.fire(c, data);\n  }\n  fire(c, data) {\n    const sim = this.sim; if (!c.repeat) c._k = true;\n    if (c.say) sim.say(c.say[0], c.say[1]);\n    if (c.prompt) sim.ev({ type: 'prompt', id: c.prompt });\n    if (c.do) c.do(sim, data);\n    if (c.music) sim.ev({ type: 'music', song: c.music });\n  }\n  reset() { for (const c of this.sc.cues || []) c._k = false; }\n  clear() {\n    const sim = this.sim;\n    if (this.waves.some(W => !W.started) || this.pending.length) return false;\n    if (!this.waves.every(W => this.waveDone(W))) return false;\n    if (sim.boss && !sim.boss.dead) return false;\n    if (this.sc.objective && !this.sc.objective(sim)) return false;\n    return true;\n  }\n}\nTC.Director = Director;\n\n/* ---- validators (the tests run them over every stage) ---- */\nfunction validateContent() {\n  const errs = [], E2 = m => errs.push(m);\n  for (const st of regAll('stage')) {\n    for (const id of st.scenes) {\n      const sc = reg('scene', id); if (!sc) { E2('stage ' + st.id + ': scene ' + id + ' missing'); continue; }\n      prepScene(sc);\n      if (!sc.title) E2(id + ': no title');\n      if (!(sc.time > 0)) E2(id + ': no time');\n      if (!sc.arrive || !sc.arrive.path || sc.arrive.path.length < 2) E2(id + ': no arrive path');\n      for (const w of sc.waves || []) for (const s of w.spawn || []) { if (!reg('enemy', s[0])) E2(id + ': unknown enemy ' + s[0]); if (s[1] && !sc.coversById[s[1]]) E2(id + ': unknown cover ' + s[1]); }\n      for (const c of sc.cues || []) if (c.say && !reg('speaker', c.say[0])) E2(id + ': unknown speaker ' + c.say[0]);\n      for (const a of sc.allies || []) if (!reg('speaker', a.who)) E2(id + ': unknown ally ' + a.who);\n      if (sc.boss && !reg('boss', sc.boss)) E2(id + ': unknown boss ' + sc.boss);\n      if (sc.carrier && !(st.carriers && st.carriers[sc.carrier])) E2(id + ': unknown carrier ' + sc.carrier);\n      if (sc.slots.length < 4) E2(id + ': slots not derived');\n    }\n    if (st.intro && !reg('cutscene', st.intro)) E2('stage ' + st.id + ': intro ' + st.intro + ' missing');\n    if (st.outro && !reg('cutscene', st.outro)) E2('stage ' + st.id + ': outro ' + st.outro + ' missing');\n    if (st.music && !reg('song', st.music)) E2('stage ' + st.id + ': song ' + st.music + ' missing');\n  }\n  for (const h of regAll('highlight')) if (!reg('scene', h.scene)) E2('highlight ' + h.id + ': scene ' + h.scene + ' missing');\n  return errs;\n}\nTC.validateContent = validateContent;\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6938,"cache_read_input_tokens":353918,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6938},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fcbe5b02-218b-4276-a1cd-eeebf017e39a","uuid":"c251269c-d10f-497a-80b8-921ac54e9216","timestamp":"2026-11-04T01:56:42.508Z","request_id":"req_011Cgh4Cks8VCJdcqmHePv3R","wire_tool_inputs":{"toolu_01Nvc6BaRPno7adZxCkrSshP":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183153__xf5fb84/work/TideCrisis3-TimeCrisis3-claude-opus-5-5-xhigh-20261103-183153/src/30-stagefmt.js","content":"/* 30-stagefmt: the stage and scene schema, the Director (rail travel -> ACTION -> waves by time, by carrier distance,\n * after a clear, after kills, on a cue -> clear -> ride on -> boss -> outro) and the content validators.\n *   def('stage', n, { name, place, clock, music, env, build(G, S), carriers, intro, outro, scenes: [ids] })\n *   def('scene', id, { title, time, arrive: { path, speed, look }, slots: [{ stand: { at, look }, cover: { at, look } }],\n *     carrier, covers: { id: { at, h, peek, face, ledge, water, floor } }, waves: [{ id, at | after | atD | kills | on,\n *     delay, spawn: [[type, coverId, opts]] }], civilians, allies, cues: [{ at | on, say, prompt, do }], boss, objective })\n * Slots 3 and 4 (AI Hub) are slot 1 moved 28 units to its left and slot 2 moved 28 units to its right. */\nconst EYE = 24, EYE_COVER = 12;\nfunction lookAngles(from, to) { const dx = to[0] - from[0], dy = to[1] - from[1], dz = to[2] - from[2]; return [Math.atan2(dy, dx), Math.atan2(dz, Math.hypot(dx, dy))]; }\nTC.lookAngles = lookAngles;\n\n/** prepare a scene for play: derived slots, cover faces, lists */\nfunction prepScene(sc) {\n  if (sc._prepped) return sc; sc._prepped = true;\n  const s0 = sc.slots[0];\n  const off = (slot, k) => {\n    const st = slot.stand, look = st.look || [st.at[0] + 100, st.at[1], st.at[2]], [yaw] = sc.carrier ? [(st.yaw || 0) * DEG] : lookAngles(st.at, look);\n    const r = [-Math.sin(yaw) * k, Math.cos(yaw) * k], mv = p => p && [p[0] + r[0], p[1] + r[1], p[2]];\n    if (sc.carrier) return { stand: Object.assign({}, st, { at: [st.at[0], st.at[1] + k, st.at[2]] }), cover: Object.assign({}, slot.cover, { at: [slot.cover.at[0], slot.cover.at[1] + k, slot.cover.at[2]] }), auto: true };\n    return { stand: { at: mv(st.at), look: mv(st.look) }, cover: { at: mv(slot.cover.at), look: mv(slot.cover.look) }, auto: true };\n  };\n  if (sc.slots.length === 1) sc.slots.push(off(sc.slots[0], 26));\n  sc.slots[2] = sc.slots[2] || off(sc.slots[0], -28);\n  sc.slots[3] = sc.slots[3] || off(sc.slots[1], 28);\n  sc.coverList = []; sc.coversById = {};\n  const tgt = sc.carrier ? null : s0.stand.at;\n  for (const [id, c] of Object.entries(sc.covers || {})) {\n    const cv = Object.assign({ id, h: 20, peek: ['up'] }, c);\n    if (cv.face === undefined) cv.face = tgt ? Math.atan2(tgt[1] - cv.at[1], tgt[0] - cv.at[0]) : Math.PI;\n    else cv.face *= DEG;\n    sc.coverList.push(cv); sc.coversById[id] = cv;\n  }\n  return sc;\n}\nTC.prepScene = prepScene;\n\n/* ---- the Director: one scene at a time ---- */\nclass Director {\n  constructor(sim, sc) {\n    this.sim = sim; this.sc = prepScene(sc); this.t = 0; this.kills = 0; this.cues = new Set(); this.pending = [];\n    this.waves = (sc.waves || []).map((w, i) => ({ w, id: w.id || 'w' + i, started: false, ids: [], i }));\n    this.civs = (sc.civilians || []).map(c => ({ c, done: false }));\n    this.allies = [];\n  }\n  start() {\n    const sim = this.sim, sc = this.sc;\n    for (const cv of sc.coverList) cv.taken = 0;\n    if (sim.players.length === 1 && sim.mode !== 'attract' || sim.mode === 'attract') for (const a of sc.allies || []) this.allies.push(spawnEnemy(sim, 'ally', null, { who: a.who, from: a.at, facing: a.facing, every: a.every, kills: a.kills }));\n    if (sc.onStart) sc.onStart(sim);\n  }\n  waveDone(W) { return W.started && W.ids.every(id => { const e = this.sim.enemyById(id); return !e || !e.alive || e.civ; }) && !this.pending.some(p => p.wave === W.id); }\n  step(dt) {\n    const sim = this.sim, sc = this.sc; this.t += dt;\n    for (const W of this.waves) {\n      if (W.started) continue;\n      const w = W.w; let go = false;\n      if (w.at !== undefined) go = this.t >= w.at;\n      else if (w.atD !== undefined) go = sim.carrierD() >= w.atD;\n      else if (w.kills !== undefined) go = this.kills >= w.kills;\n      else if (w.on) go = this.cues.has(w.on);\n      else if (w.after === 'clear' || !w.after) go = this.waves.slice(0, W.i).every(o => this.waveDone(o));\n      else go = this.waves.some(o => o.id === w.after && this.waveDone(o));\n      if (go && w.delay) { if (W.wait === undefined) W.wait = this.t + w.delay; go = this.t >= W.wait; }\n      if (!go) continue;\n      W.started = true;\n      for (const s of w.spawn || []) { const o = Object.assign({ wave: W.id }, s[2] || {}); if (o.delay) this.pending.push({ at: this.t + o.delay, s, o, wave: W.id }); else W.ids.push(spawnEnemy(sim, s[0], s[1], o).id); }\n      if (w.say) sim.say(w.say[0], w.say[1]);\n      if (w.cue) sim.cue(w.cue);\n      if (w.do) w.do(sim);\n    }\n    for (const P of this.pending.slice()) if (this.t >= P.at) { this.pending.splice(this.pending.indexOf(P), 1); const W = this.waves.find(x => x.id === P.wave); const e = spawnEnemy(sim, P.s[0], P.s[1], P.o); if (W) W.ids.push(e.id); }\n    for (const C of this.civs) if (!C.done && this.t >= C.c.at) { C.done = true; spawnEnemy(sim, 'civilian', null, { route: C.c.route, from: C.c.route[0], look: C.c.look, leave: C.c.leave, speed: C.c.speed }); if (C.c.say) sim.say(C.c.say[0], C.c.say[1]); }\n    for (const c of sc.cues || []) if (c.at !== undefined && !c._k && this.t >= c.at) { this.fire(c); }\n  }\n  cue(name, data) {\n    this.cues.add(name);\n    for (const c of this.sc.cues || []) if (c.on === name && !c._k) this.fire(c, data);\n  }\n  fire(c, data) {\n    const sim = this.sim; if (!c.repeat) c._k = true;\n    if (c.say) sim.say(c.say[0], c.say[1]);\n    if (c.prompt) sim.ev({ type: 'prompt', id: c.prompt });\n    if (c.do) c.do(sim, data);\n    if (c.music) sim.ev({ type: 'music', song: c.music });\n  }\n  reset() { for (const c of this.sc.cues || []) c._k = false; }\n  clear() {\n    const sim = this.sim;\n    if (this.waves.some(W => !W.started) || this.pending.length) return false;\n    if (!this.waves.every(W => this.waveDone(W))) return false;\n    if (sim.boss && !sim.boss.dead) return false;\n    if (this.sc.objective && !this.sc.objective(sim)) return false;\n    return true;\n  }\n}\nTC.Director = Director;\n\n/* ---- validators (the tests run them over every stage) ---- */\nfunction validateContent() {\n  const errs = [], E2 = m => errs.push(m);\n  for (const st of regAll('stage')) {\n    for (const id of st.scenes) {\n      const sc = reg('scene', id); if (!sc) { E2('stage ' + st.id + ': scene ' + id + ' missing'); continue; }\n      prepScene(sc);\n      if (!sc.title) E2(id + ': no title');\n      if (!(sc.time > 0)) E2(id + ': no time');\n      if (!sc.arrive || !sc.arrive.path || sc.arrive.path.length < 2) E2(id + ': no arrive path');\n      for (const w of sc.waves || []) for (const s of w.spawn || []) { if (!reg('enemy', s[0])) E2(id + ': unknown enemy ' + s[0]); if (s[1] && !sc.coversById[s[1]]) E2(id + ': unknown cover ' + s[1]); }\n      for (const c of sc.cues || []) if (c.say && !reg('speaker', c.say[0])) E2(id + ': unknown speaker ' + c.say[0]);\n      for (const a of sc.allies || []) if (!reg('speaker', a.who)) E2(id + ': unknown ally ' + a.who);\n      if (sc.boss && !reg('boss', sc.boss)) E2(id + ': unknown boss ' + sc.boss);\n      if (sc.carrier && !(st.carriers && st.carriers[sc.carrier])) E2(id + ': unknown carrier ' + sc.carrier);\n      if (sc.slots.length < 4) E2(id + ': slots not derived');\n    }\n    if (st.intro && !reg('cutscene', st.intro)) E2('stage ' + st.id + ': intro ' + st.intro + ' missing');\n    if (st.outro && !reg('cutscene', st.outro)) E2('stage ' + st.id + ': outro ' + st.outro + ' missing');\n    if (st.music && !reg('song', st.music)) E2('stage ' + st.id + ': song ' + st.music + ' missing');\n  }\n  for (const h of regAll('highlight')) if (!reg('scene', h.scene)) E2('highlight ' + h.id + ': scene ' + h.scene + ' missing');\n  return errs;\n}\nTC.validateContent = validateContent;\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nvc6BaRPno7adZxCkrSshP","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183153__xf5fb84/work/TideCrisis3-TimeCrisis3-claude-opus-5-5-xhigh-20261103-183153/src/30-stagefmt.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fcbe5b02-218b-4276-a1cd-eeebf017e39a","uuid":"ec1bf6cc-feed-41ef-8d5a-5f95fb46975b","timestamp":"2026-11-04T01:56:42.522Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183153__xf5fb84/work/TideCrisis3-TimeCrisis3-claude-opus-5-5-xhigh-20261103-183153/src/30-stagefmt.js","content":"/* 30-stagefmt: the stage and scene schema, the Director (rail travel -> ACTION -> waves by time, by carrier distance,\n * after a clear, after kills, on a cue -> clear -> ride on -> boss -> outro) and the content validators.\n *   def('stage', n, { name, place, clock, music, env, build(G, S), carriers, intro, outro, scenes: [ids] })\n *   def('scene', id, { title, time, arrive: { path, speed, look }, slots: [{ stand: { at, look }, cover: { at, look } }],\n *     carrier, covers: { id: { at, h, peek, face, ledge, water, floor } }, waves: [{ id, at | after | atD | kills | on,\n *     delay, spawn: [[type, coverId, opts]] }], civilians, allies, cues: [{ at | on, say, prompt, do }], boss, objective })\n * Slots 3 and 4 (AI Hub) are slot 1 moved 28 units to its left and slot 2 moved 28 units to its right. */\nconst EYE = 24, EYE_COVER = 12;\nfunction lookAngles(from, to) { const dx = to[0] - from[0], dy = to[1] - from[1], dz = to[2] - from[2]; return [Math.atan2(dy, dx), Math.atan2(dz, Math.hypot(dx, dy))]; }\nTC.lookAngles = lookAngles;\n\n/** prepare a scene for play: derived slots, cover faces, lists */\nfunction prepScene(sc) {\n  if (sc._prepped) return sc; sc._prepped = true;\n  const s0 = sc.slots[0];\n  const off = (slot, k) => {\n    const st = slot.stand, look = st.look || [st.at[0] + 100, st.at[1], st.at[2]], [yaw] = sc.carrier ? [(st.yaw || 0) * DEG] : lookAngles(st.at, look);\n    const r = [-Math.sin(yaw) * k, Math.cos(yaw) * k], mv = p => p && [p[0] + r[0], p[1] + r[1], p[2]];\n    if (sc.carrier) return { stand: Object.assign({}, st, { at: [st.at[0], st.at[1] + k, st.at[2]] }), cover: Object.assign({}, slot.cover, { at: [slot.cover.at[0], slot.cover.at[1] + k, slot.cover.at[2]] }), auto: true };\n    return { stand: { at: mv(st.at), look: mv(st.look) }, cover: { at: mv(slot.cover.at), look: mv(slot.cover.look) }, auto: true };\n  };\n  if (sc.slots.length === 1) sc.slots.push(off(sc.slots[0], 26));\n  sc.slots[2] = sc.slots[2] || off(sc.slots[0], -28);\n  sc.slots[3] = sc.slots[3] || off(sc.slots[1], 28);\n  sc.coverList = []; sc.coversById = {};\n  const tgt = sc.carrier ? null : s0.stand.at;\n  for (const [id, c] of Object.entries(sc.covers || {})) {\n    const cv = Object.assign({ id, h: 20, peek: ['up'] }, c);\n    if (cv.face === undefined) cv.face = tgt ? Math.atan2(tgt[1] - cv.at[1], tgt[0] - cv.at[0]) : Math.PI;\n    else cv.face *= DEG;\n    sc.coverList.push(cv); sc.coversById[id] = cv;\n  }\n  return sc;\n}\nTC.prepScene = prepScene;\n\n/* ---- the Director: one scene at a time ---- */\nclass Director {\n  constructor(sim, sc) {\n    this.sim = sim; this.sc = prepScene(sc); this.t = 0; this.kills = 0; this.cues = new Set(); this.pending = [];\n    this.waves = (sc.waves || []).map((w, i) => ({ w, id: w.id || 'w' + i, started: false, ids: [], i }));\n    this.civs = (sc.civilians || []).map(c => ({ c, done: false }));\n    this.allies = [];\n  }\n  start() {\n    const sim = this.sim, sc = this.sc;\n    for (const cv of sc.coverList) cv.taken = 0;\n    if (sim.players.length === 1 && sim.mode !== 'attract' || sim.mode === 'attract') for (const a of sc.allies || []) this.allies.push(spawnEnemy(sim, 'ally', null, { who: a.who, from: a.at, facing: a.facing, every: a.every, kills: a.kills }));\n    if (sc.onStart) sc.onStart(sim);\n  }\n  waveDone(W) { return W.started && W.ids.every(id => { const e = this.sim.enemyById(id); return !e || !e.alive || e.civ; }) && !this.pending.some(p => p.wave === W.id); }\n  step(dt) {\n    const sim = this.sim, sc = this.sc; this.t += dt;\n    for (const W of this.waves) {\n      if (W.started) continue;\n      const w = W.w; let go = false;\n      if (w.at !== undefined) go = this.t >= w.at;\n      else if (w.atD !== undefined) go = sim.carrierD() >= w.atD;\n      else if (w.kills !== undefined) go = this.kills >= w.kills;\n      else if (w.on) go = this.cues.has(w.on);\n      else if (w.after === 'clear' || !w.after) go = this.waves.slice(0, W.i).every(o => this.waveDone(o));\n      else go = this.waves.some(o => o.id === w.after && this.waveDone(o));\n      if (go && w.delay) { if (W.wait === undefined) W.wait = this.t + w.delay; go = this.t >= W.wait; }\n      if (!go) continue;\n      W.started = true;\n      for (const s of w.spawn || []) { const o = Object.assign({ wave: W.id }, s[2] || {}); if (o.delay) this.pending.push({ at: this.t + o.delay, s, o, wave: W.id }); else W.ids.push(spawnEnemy(sim, s[0], s[1], o).id); }\n      if (w.say) sim.say(w.say[0], w.say[1]);\n      if (w.cue) sim.cue(w.cue);\n      if (w.do) w.do(sim);\n    }\n    for (const P of this.pending.slice()) if (this.t >= P.at) { this.pending.splice(this.pending.indexOf(P), 1); const W = this.waves.find(x => x.id === P.wave); const e = spawnEnemy(sim, P.s[0], P.s[1], P.o); if (W) W.ids.push(e.id); }\n    for (const C of this.civs) if (!C.done && this.t >= C.c.at) { C.done = true; spawnEnemy(sim, 'civilian', null, { route: C.c.route, from: C.c.route[0], look: C.c.look, leave: C.c.leave, speed: C.c.speed }); if (C.c.say) sim.say(C.c.say[0], C.c.say[1]); }\n    for (const c of sc.cues || []) if (c.at !== undefined && !c._k && this.t >= c.at) { this.fire(c); }\n  }\n  cue(name, data) {\n    this.cues.add(name);\n    for (const c of this.sc.cues || []) if (c.on === name && !c._k) this.fire(c, data);\n  }\n  fire(c, data) {\n    const sim = this.sim; if (!c.repeat) c._k = true;\n    if (c.say) sim.say(c.say[0], c.say[1]);\n    if (c.prompt) sim.ev({ type: 'prompt', id: c.prompt });\n    if (c.do) c.do(sim, data);\n    if (c.music) sim.ev({ type: 'music', song: c.music });\n  }\n  reset() { for (const c of this.sc.cues || []) c._k = false; }\n  clear() {\n    const sim = this.sim;\n    if (this.waves.some(W => !W.started) || this.pending.length) return false;\n    if (!this.waves.every(W => this.waveDone(W))) return false;\n    if (sim.boss && !sim.boss.dead) return false;\n    if (this.sc.objective && !this.sc.objective(sim)) return false;\n    return true;\n  }\n}\nTC.Director = Director;\n\n/* ---- validators (the tests run them over every stage) ---- */\nfunction validateContent() {\n  const errs = [], E2 = m => errs.push(m);\n  for (const st of regAll('stage')) {\n    for (const id of st.scenes) {\n      const sc = reg('scene', id); if (!sc) { E2('stage ' + st.id + ': scene ' + id + ' missing'); continue; }\n      prepScene(sc);\n      if (!sc.title) E2(id + ': no title');\n      if (!(sc.time > 0)) E2(id + ': no time');\n      if (!sc.arrive || !sc.arrive.path || sc.arrive.path.length < 2) E2(id + ': no arrive path');\n      for (const w of sc.waves || []) for (const s of w.spawn || []) { if (!reg('enemy', s[0])) E2(id + ': unknown enemy ' + s[0]); if (s[1] && !sc.coversById[s[1]]) E2(id + ': unknown cover ' + s[1]); }\n      for (const c of sc.cues || []) if (c.say && !reg('speaker', c.say[0])) E2(id + ': unknown speaker ' + c.say[0]);\n      for (const a of sc.allies || []) if (!reg('speaker', a.who)) E2(id + ': unknown ally ' + a.who);\n      if (sc.boss && !reg('boss', sc.boss)) E2(id + ': unknown boss ' + sc.boss);\n      if (sc.carrier && !(st.carriers && st.carriers[sc.carrier])) E2(id + ': unknown carrier ' + sc.carrier);\n      if (sc.slots.length < 4) E2(id + ': slots not derived');\n    }\n    if (st.intro && !reg('cutscene', st.intro)) E2('stage ' + st.id + ': intro ' + st.intro + ' missing');\n    if (st.outro && !reg('cutscene', st.outro)) E2('stage ' + st.id + ': outro ' + st.outro + ' missing');\n    if (st.music && !reg('song', st.music)) E2('stage ' + st.id + ': song ' + st.music + ' missing');\n  }\n  for (const h of regAll('highlight')) if (!reg('scene', h.scene)) E2('highlight ' + h.id + ': scene ' + h.scene + ' missing');\n  return errs;\n}\nTC.validateContent = validateContent;\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Nvc6BaRPno7adZxCkrSshP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
