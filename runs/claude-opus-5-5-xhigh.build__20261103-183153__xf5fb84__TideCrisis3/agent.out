(rig, x, y, z = 0) { return this.add(x, y, z, (g, sx, sy, k) => rig.draw(g, Math.round(sx), Math.round(sy), this.view(k))); }\n12394:      const v = this.view(k), f = Math.round((o.facing === undefined ? Math.PI / 2 : o.facing) / Math.PI * 8) / 8 * Math.PI, key = id + ':' + v.scale + ':' + v.yawDeg + ':' + v.pitchDeg + ':' + f + ':' + (o.size || 1);\n12400:  view(k) {\n12562:class PBody {\n12661:class Physics {\n12948:class Rhythm {\n13110:class Road {\n13278:class World {\n13472:class Member {\n13539:class Inventory {\n13587:class Party {\n13624:class Shop {\n13639:class Encounters {\n13663:class RPG {\n13949:class Story {\n14164:class Strategy {\n14487:class Clock {\n14588:class Terrain {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JFt4kkG2Hw5ed8KuumwF7h","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
