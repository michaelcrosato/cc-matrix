, delay = .3, rate = .08) {\n    if (this.pressed(a)) return true;\n    if (!this.down(a) || this._pt[a] === undefined) return false;\n    const t = this.clock - this._pt[a]; if (t < delay) return false;\n    const k = Math.floor((t - delay) / rate); if (k !== this._rk[a]) { this._rk[a] = k; return true; }\n    return false;\n  }\n  /** was it pressed within the last `win` seconds and not yet consumed? (input buffering) */\n  buffered(a, win = .15) { if (!this.map[a]) this._check(a); const t = this._pt[a]; return !this._suppressed.has(a) && t !== undefined && !this._used[a] && this.clock - t <= win; }\n  /** mark a buffered press of action a as used, so buffered(a) is false until the next press */\n  consume(a) { this._used[a] = true; }\n  /** Suppress a held action until the next tick (a HUD widget owns the pointer this step). */\n  suppress(a) { this.consume(a); this._suppressed.add(a); }\n  /** A widget owns this button; other devices bound to the same action still work. */\n  suppressCode(code) {\n    for (const a of this._codes[code] || []) if (!this.map[a].some(c => c !== code && this.held.has(c))) this.suppress(a);\n  }\n  /** forget every pending press (after closing a menu or dialog, so the same press does not also attack) */\n  consumeAll() { for (const a in this.map) this._used[a] = true; this._now.clear(); this._fresh.clear(); this._clickAt = this._click = null; }\n  /** Release all devices and discard buffered input on focus loss or a modal transition. */\n  clear() {\n    this.held.clear(); this.consumeAll(); this._nowUp.clear(); this._freshUp.clear(); this._pt = {}; this._rk = {}; this._down = null;\n    this.padMove = [0, 0]; this.padAim = null; this._fingers.clear(); this._zoneOf.clear(); this._pinching = false; this._zoomAcc = 1;\n    this._stickEnd({ pointerId: this.stickId });\n    for (const b of this._boundButtons || []) { b.classList.remove('on'); b._inputPointers.clear(); }\n  }\n  /** the last second of input, oldest first: [{ t (input.clock), dir (numpad 1-9 for a fighter facing right: 5 neutral),\n   *  pressed: the actions pressed then, directions aside }], one entry each time the direction changes or a button is\n   *  pressed: an input display draws it; sequence() and motion() read it (section 10h: a kit without it has none) */\n  get history() { return this._hist || []; }\n  /** any action pressed this step (title screens: \"press any button\") */\n  anyPressed() { return this._now.size > 0; }\n  /** movement intent in screen directions: x right, y down, length <= 1 */\n  move() {\n    let x = (this.down('right') ? 1 : 0) - (this.down('left') ? 1 : 0), y = (this.down('down') ? 1 : 0) - (this.down('up') ? 1 : 0);\n    if (this.stickOn) { x = this.stick[0]; y = this.stick[1]; }\n    if (Math.hypot(this.padMove[0], this.padMove[1]) > 0) { x = this.padMove[0]; y = this.padMove[1]; }\n    const l = Math.hypot(x, y); if (l > 1) { x /= l; y /= l; }\n    return [x, y];\n  }\n  /** mouse position in projected screen pixels, or null */\n  mouseScreen() { return this.mouse.active ? this.screen.clientToScreen(this.mouse.cx, this.mouse.cy) : null; }\n  /** where a click or tap on the canvas landed, in screen pixels [x, y] (the HUD's space: r.W, r.H), during the step\n   *  after it lifted (a press that drags away, like the touch stick's, is none); else null. Menus and dialogs answer to\n   *  it; a HUD button of your own can: if (hit(input.clicked())) ... */\n  clicked() { return this._clickAt; }\n  /** how far the touch stick's finger moved since the last step, in screen pixels [dx, dy] (the HUD's space), or null while\n   *  no finger holds it: to steer one to one (a shooter's ship follows the thumb) instead of by the stick's direction */\n  drag() { return this._drag || null; }\n  /** the camera zoom the player asked for since the last step, as a factor (1.1: 10% closer, .9: farther; 1: none): the\n   *  wheel, - and = and a pinch, where the scene lets them zoom. The game applies it (game.zoomBy) */\n  zoom() { return this._zoomNow; }\n  /** the mouse pointer in screen pixels [x, y] (the HUD's space), or null before it has moved over the canvas */\n  pointer() { return this._fedAt || (this.mouse.active ? this.screenPoint(this.mouse.cx, this.mouse.cy) : null); }\n  /** the pointer's gestures, read each step in screen pixels (the HUD's space), from a mouse or one finger:\n   *  box() -> { x0, y0, x1, y1, from, to, done } while a box is drawn (a mouse's left button dragged; on a touch screen a long\n   *  press, then a drag), done the step it is let go; else null */\n  box() { return this._boxAt; }\n  /** [x, y] the step a press held still has been held .45 s (a long press), else null */\n  longPress() { return this._longAt; }\n  /** [x, y] the step a second tap or click lands within .35 s and 8 pixels of the first (a double tap), else null */\n  doubleTap() { return this._tap2At; }\n  /** [dx, dy] how far a drag moved this step: one finger on open ground (not a box), or a mouse's middle or right button;\n   *  else null. A free camera pans by it (game.cam.free) */\n  pan() { return this._panAt; }\n  /** [x, y] where the last zoom was asked for: the mouse pointer for the wheel, between the fingers for a pinch; null when\n   *  the keys zoomed (about the screen's middle) */\n  zoomPoint() { return this._zoomPt; }\n  /** a pointer event in screen pixels, as the browser's would give: feed('down' | 'move' | 'up', x, y, { touch: false,\n   *  button: 0, id: 0 (which finger, for zones) }) (a test's or a bot's mouse and fingers: clicks, boxes, long presses,\n   *  double taps and pans follow; a finger in one of the zones holds its act), or\n   *  feed('zoom', x, y, { k: 1.1 }): a wheel's notch or a pinch about that point */\n  feed(type, x, y, o = {}) {\n    if (type === 'zoom') { this._zoomAcc *= o.k || 1.1; this._zoomPt = [x, y]; return; }\n    if (!o.touch) this._fedAt = [x, y];\n    const S = this.screen, z = o.touch && type === 'down' && this.zones && this._zone(x / S.W, y / S.H);\n    if (z) { this._zoneDown('fed' + (o.id || 0), z); return; }   // (a finger in a zone: its act, no gesture)\n    if (o.touch && type === 'up' && this._zoneOf.has('fed' + (o.id || 0))) { this._zoneUp('fed' + (o.id || 0)); return; }\n    if (type === 'down') { this._fed = [x, y]; if (!o.touch) this.press('Mouse' + (o.button || 0)); this._gesture('down', x, y, { touch: !!o.touch, button: o.button || 0, id: 'fed' }); }\n    else if (type === 'move') this._gesture('move', x, y);\n    else if (type === 'up') {\n      if (this._fed && Math.hypot(x - this._fed[0], y - this._fed[1]) < 4 && !(o.button > 0)) this._click = [x, y];\n      if (!o.touch) this.release('Mouse' + (o.button || 0)); this._fed = null; this._gesture('up', x, y);\n    }\n  }\n  // a press followed from down to up: past 4 pixels it is a box (a left button, or a finger after a long press) or a pan\n  // (a finger, a middle or right button); lifted unmoved it is a tap, and a second within .35 s a double tap\n  _gesture(type, x, y, o = {}) {\n    const g = this._g;\n    if (type === 'down') { this._g = { id: o.id, x0: x, y0: y, x, y, t: this.clock, touch: !!o.touch, button: o.button || 0, mode: null, long: false, moved: false }; return; }\n    if (!g) return;\n    if (type === 'move') {\n      const px = g.x, py = g.y; g.x = x; g.y = y;\n      if (!g.moved && Math.hypot(x - g.x0, y - g.y0) > 4) { g.moved = true; g.mode = (!g.touch && g.button === 0) || (g.touch && g.long) ? 'box' : g.touch || g.button > 0 ? 'pan' : null; }\n      if (g.mode === 'box') this._gBox = { x0: Math.min(g.x0, x), y0: Math.min(g.y0, y), x1: Math.max(g.x0, x), y1: Math.max(g.y0, y), from: [g.x0, g.y0], to: [x, y], done: false };\n      else if (g.mode === 'pan') { const p = this._gPan || (this._gPan = [0, 0]); p[0] += x - (g.moved && g.panned ? px : g.x0); p[1] += y - (g.moved && g.panned ? py : g.y0); g.panned = true; }\n      return;\n    }\n    this._g = null;   // up\n    if (g.mode === 'box' && this._gBox) this._gBox.done = true;\n    else if (!g.moved) {\n      const L = this._lastTap;\n      if (L && this.clock - L.t < .35 && Math.hypot(x - L.x, y - L.y) < 8) { this._gTap2 = [x, y]; this._lastTap = null; }\n      else this._lastTap = { x, y, t: this.clock };\n    }\n  }\n  /** browser client coords -> screen pixels [x, y] (the HUD's space, with no camera), or null without a canvas */\n  screenPoint(cx, cy) {\n    const S = this.screen; if (!S.canvas) return null;\n    const rc = S.canvas.getBoundingClientRect(); return [((cx - rc.left) * S.dpr - S.OX) / S.S, ((cy - rc.top) * S.dpr - S.OY) / S.S];\n  }\n  /** advance input by one step: read the gamepad and turn presses since the last step into this step's pressed() and\n   *  released() (the engine calls it every step) */\n  tick(dt) {\n    this._suppressed.clear();\n    this.clock += dt;\n    let pads = [];\n    try { pads = navigator.getGamepads ? navigator.getGamepads() : []; } catch (e) { /* gamepads blocked */ }\n    const C = this._claimed, ok = p => p && p.connected !== false && (this.pad === 'any' ? !(C && C.has(p.index)) : p.index === this.pad);   // (its own pad, or any another player hasn't)\n1250:const MENU_KEYS = {\n1256:const BINDABLE = /^(Key[A-Z]|Digit\\d|Numpad\\d|Arrow(Up|Down|Left|Right)|Space|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Tab|Backspace|Backquote|Minus|Equal|Bracket(Left|Right)|Backslash|Semicolon|Quote|Comma|Period|Slash|CapsLock|Mouse[0-4]|Pad([0-8]|1[0-5]))$/;\n1259:const STICK_CODES = { up: 'PadAxisUp', down: 'PadAxisDown', left: 'PadAxisLeft', right: 'PadAxisRight' };\n1263:const PAD_GLYPHS = {\n1269:const CODE_LABELS = { Space: 'Space', ShiftLeft: 'Shift', ShiftRight: 'R Shift', ControlLeft: 'Ctrl', ControlRight: 'R Ctrl', AltLeft: 'Alt', AltRight: 'R Alt',\n1275:Input.DEFAULT = {\n1295:Input.SHMUP = {","is_error":false}]},"parent_tool_use_id":null,"session_id":"fcbe5b02-218b-4276-a1cd-eeebf017e39a","uuid":"c6b64a3a-2445-471f-9849-7c9ad6ab3cd7","timestamp":"2026-11-04T01:34:33.02