d = () => this.voices.delete(node);\n      }\n    }\n    update(w, silent = false) {\n      if (this.ended || silent) return;\n        }\n      }\n      const events = w.events;\n      const index = this.lastEvent ? events.findIndex((e) => e.id === this.lastEvent) : events.length - 1;\n      for (const ev of events.slice(Math.max(0, index + 1)))\n        if (\n          [\n            'hit',\n            'stun',\n            'hurt',\n            'pickup',\n            'ring-return',\n            'safe-shift',\n            'bind',\n            'revive',\n            'primary',\n            'power',\n            'companion-return',\n          ].includes(ev.type)\n        ) {\n          const h = w.heroes[ev.hero || 0];\n          this.fx.push({\n            ...ev,\n            x: ev.x ?? h.x,\n            y: ev.y ?? h.y,\n            life: ev.type === 'pickup' || ev.type === 'bind' ? 1.8 : 0.6,\n{\n  \"policy\": \"Actual game findings from tests and visual/code review, deduplicated by underlying cause. Test fixture and tool configuration mistakes are recorded separately and excluded from game defect counts.\",\n  \"issues\": [\n    {\n      \"id\": 1,\n      \"severity\": \"major\",\n      \"finding\": \"All-cloaked targets caused an early return before contact damage.\",\n      \"resolution\": \"Resolve cloaked contact before target selection.\",\n{\n  \"suite\": \"all\",\n  \"sourceHash\": \"0399bdd3921c1c4ca1012a13b43ce3088efc0d081a7c01ab404d1d2c32189812\",\n  \"results\": [\n    {\n      \"name\": \"all authored room states have safe spawns and ordinary objective paths\",\n      \"pass\": true,\n      \"detail\": \"\"\n    },\n    {\n","exit_code":0,"status":"completed"}}
