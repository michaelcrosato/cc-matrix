{"type":"item.started","item":{"id":"item_148","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('docs/issues.json');d=json.loads(p.read_text());d['issues'].extend([\n{'id':17,'severity':'major','finding':'The initial finale camera could frame the party while leaving the dragon offscreen.','resolution':'Use a bounded shared sanctum framing that includes the dragon and party.','evidence':'Final sanctum visual capture and normal final-file campaign.'},\n{'id':18,'severity':'minor','finding':'Courtyard tutorial cards remained over the route board and ending.','resolution':'Clear scene-owned teaching cards on title, board and victory transitions.','evidence':'Route and victory captures.'},\n{'id':19,'severity':'major','finding':'The release of a touch extraction gesture could click a newly opened route-menu button.','resolution':'Validate pointer-down screen ownership before accepting a menu click, and clear touch state at menu transitions.','evidence':'Real touch extraction followed by an unpaused route-screen assertion.'},\n{'id':20,'severity':'major','finding':'Selection portraits continued painting detached canvases after leaving hero selection.','resolution':'Update portrait canvases only while their selection screen is active and release their references at new-run transition.','evidence':'Full browser campaign, attract and replay lifecycle checks.'},\n{'id':21,'severity':'major','finding':'Possession echoes used a generic claw timeline even when copying a caster.','resolution':'Copy the native sword/cast timeline and show class-appropriate rune, pulse or mirror effects.','evidence':'Director/normal campaign and shared gameplay checks.'}\n]);d['gameFindingCount']=21;p.write_text(json.dumps(d,indent=2)+'\\\\n')\np=Path('../exit-interview.json');d=json.loads(p.read_text());d['testingFeedback'][0]='21 game findings from automated tests and visual/code review were repaired; test-fixture and tool-confi