{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser.py <<'PY'\nimport functools\nimport hashlib\nimport http.server\nimport json\nimport math\nimport sys\nimport threading\nfrom pathlib import Path\nfrom urllib.parse import quote\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parents[1]\nDELIVERABLE = ROOT.parent / f\\\"{ROOT.name}.html\\\"\nSUITE = sys.argv[1] if len(sys.argv) > 1 else \\\"all\\\"\nresults = []\n\n\ndef check(name, fn):\n    try:\n        fn()\n        results.append({\\\"name\\\": name, \\\"pass\\\": True})\n    except Exception as error:\n        results.append({\\\"name\\\": name, \\\"pass\\\": False, \\\"detail\\\": str(error)})\n\n\ndef require(value, message):\n    if not value:\n        raise AssertionError(message)\n\n\ndef capture(page, name):\n    page.screenshot(path=str(ROOT / f\\\"evidence/{name}.png\\\"), animations=\\\"disabled\\\")\n\n\ndef ready(page):\n    page.goto(DELIVERABLE.as_uri())\n    page.wait_for_function(\\\"window.__rings && __rings.ui.shell.screen === 'title'\\\")\n\n\ndef start(page, a=\\\"Warrior\\\", b=\\\"Wizard\\\"):\n    page.get_by_role(\\\"button\\\", name=\\\"New Expedition\\\", exact=True).click()\n    page.get_by_role(\\\"button\\\", name=f\\\"{a}.\\\", exact=False).click()\n    page.get_by_role(\\\"button\\\", name=f\\\"{b}.\\\", exact=False).click()\n    page.wait_for_function(\\\"__rings.stage === 'expedition' && __rings.world.mode === 'court'\\\")\n\n\nGAMEPAD = \\\"\\\"\\\"(() => {\nconst make = index => ({id:'Standard Gamepad',index,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:18},()=>({pressed:false,touched:false,value:0})),timestamp:0});\nwindow.__pads=[make(0),make(1)];window.__makePad=make;\nObject.defineProperty(navigator,'getGamepads',{value:()=>window.__pads});\n})()\\\"\\\"\\\"\n\n# This driver submits ordinary movement/action intentions. It never writes world/objective fields.\nDRIVER = \\\"\\\"\\\"(function drive(){\nconst app=__rings,w=app.world,h=w.heroes[0],dt=1/120,c=MA.neutral();\nif(w.mode==='board'){const next=['dungeon','crystal','inferno','shifting','final'].find(s=>w.reachable(s));if(next)app.intent('travel',next);return c;}\nif(h.down)return c;\nconst partner=w.heroes[1];let target=partner.down?partner:w.objectivePoint(h);\nif(w.dangerAt(h.x,h.y,true))target=w.nearestSafe(h);\n[c.mx,c.my]=w.steer(h,target,dt,true);\nconst e=w.enemies.filter(e=>\"'!e.dead&&e.kind!=='\"'dragon').sort((a,b)=>MA.distance(h,a)-MA.distance(h,b))[0];\nif(e&&MA.distance(h,e)<130){const n=MA.distance(h,e)||1;c.ax=(e.x-h.x)/n;c.ay=(e.y-h.y)/n;c.primary=n<(h.classId==='wizard'?125:46);c.power=n<44;}\nif(MA.distance(h,target)<23){c.interact=true;if(e&&MA.distance(h,e)<90&&h.classId\"'!=='\"'warrior')c.power=true;}\nif(w.dangerAt(h.x,h.y,true))c.dodge=true;\nreturn c;})\\\"\\\"\\\"\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch()\n    if SUITE in [\\\"all\\\", \\\"browser\\\", \\\"visual\\\"]:\n        context = browser.new_context(viewport={\\\"width\\\": 1920, \\\"height\\\": 1080})\n        page = context.new_page()\n        errors = []\n        requests = []\n        page.on(\\\"pageerror\\\", lambda error: errors.append(str(error)))\n        page.on(\\\"request\\\", lambda request: requests.append(request.url))\n        ready(page)\n\n        def boot():\n            require(page.title() == \\\"Much Ado About Rings\\\", \\\"Wrong page identity\\\")\n            require(page.evaluate(\\\"__game.settings.music\\\") == 0.1, \\\"Music is not 10%\\\")\n            require(len(page.locator(\\\"script[src]\\\").all()) == 0, \\\"External script dependency\\\")\n            html = DELIVERABLE.read_text()\n            client = (ROOT / \\\"vendor/hub/session.js\\\").read_text()\n            require(html.split(\\\"<script>\\\", 1)[1].split(\\\"</script>\\\", 1)[0] == client, \\\"Hub client was modified\\\")\n            page.keyboard.press(\\\"Escape\\\")\n            require(page.evaluate(\\\"__rings.ui.shell.screen\\\") == \\\"title\\\", \\\"Escape stranded title\\\")\n            capture(page, \\\"title\\\")\n\n        check(\\\"final file boots independently, unchanged first Hub script, title back and 10% music\\\", boot)\n\n        def ui_path():\n            page.get_by_role(\\\"button\\\", name=\\\"New Expedition\\\", exact=True).click()\n            capture(page, \\\"selection\\\")\n            page.get_by_role(\\\"button\\\", name=\\\"Warrior.\\\", exact=False).click()\n            page.get_by_role(\\\"button\\\", name=\\\"Wizard.\\\", exact=False).click()\n            page.wait_for_function(\\\"__rings.stage === 'expedition' && __rings.world.mode === 'court'\\\")\n            page.keyboard.down(\\\"d\\\")\n            page.wait_for_function(\\\"__rings.world.heroes[0].x > 70\\\")\n            page.keyboard.up(\\\"d\\\")\n            capture(page, \\\"courtyard\\\")\n            page.keyboard.press(\\\"Escape\\\")\n            page.get_by_role(\\\"button\\\", name=\\\"Dev Mode\\\", exact=True).wait_for()\n            page.get_by_role(\\\"button\\\", name=\\\"Dev Mode\\\", exact=True).click()\n            page.get_by_role(\\\"button\\\", name=\\\"Live balance sliders\\\", exact=True).click()\n            require(page.locator(\\\"input[type=range]\\\").count() >= 12, \\\"Missing tuning controls\\\")\n            require(page.evaluate(\\\"document.activeElement.type\\\") == \\\"range\\\", \\\"Slider focus missing\\\")\n            before = page.evaluate(\\\"__rings.world.tuning.speed\\\")\n            page.keyboard.press(\\\"ArrowRight\\\")\n            page.wait_for_function(\\\"__rings.world.assisted\\\")\n            require(page.evaluate(\\\"__rings.world.tuning.speed\\\") > before, \\\"Slider not live\\\")\n            capture(page, \\\"dev\\\")\n            page.get_by_role(\\\"button\\\", name=\\\"Reset to Defaults\\\", exact=True).click()\n            require(page.evaluate(\\\"__rings.world.tuning.speed\\\") == 66, \\\"Reset failed\\\")\n            page.evaluate(\\\"__rings.ui.shell.hide()\\\")\n\n        check(\\\"keyboard/pointer gameplay, native Dev focus, live slider and reset\\\", ui_path)\n\n        def save_continue():\n            page.evaluate(\\\"\\\"\\\"__game.stop();__rings.world.toBoard();__rings.intent('travel','dungeon');__rings.world.transition=0;__rings.world.completeRoom();__rings.world.checkpoint();\\\"\\\"\\\")\n            page.reload()\n            page.wait_for_function(\\\"window.__rings && __rings.ui.shell.screen === 'title'\\\")\n            page.get_by_role(\\\"button\\\", name=\\\"Continue Expedition\\\", exact=True).click()\n            page.wait_for_function(\\\"__rings.world.roomId === 'd2'\\\")\n            require(page.evaluate(\\\"__rings.world.dread\\\") == 1, \\\"Continue charged Dread\\\")\n            require(page.evaluate(\\\"__rings.world.ring.carrier\\\") is None, \\\"Continue ring not restored\\\")\n            page.evaluate(\\\"__rings.ui.title()\\\")\n            page.get_by_role(\\\"button\\\", name=\\\"About & Credits\\\", exact=True).click()\n            capture(page, \\\"credits\\\")\n            for title in [\\\"Testing Feedback\\\", \\\"Engine Feedback\\\", \\\"Prompt Feedback\\\"]:\n                page.get_by_role(\\\"button\\\", name=\\\"Next page\\\", exact=True).click()\n                require(page.get_by_role(\\\"heading\\\", name=title, exact=True).count() == 1, \\\"About page missing\\\")\n            page.get_by_role(\\\"button\\\", name=\\\"Back\\\", exact=True).click()\n\n        check(\\\"safe room-two checkpoint Continue and all four credits pages\\\", save_continue)\n\n        def audio():\n            data = page.evaluate(\\\"\\\"\\\"async()=>{const ctx=new OfflineAudioContext(1,24000,24000);MA.tone(ctx,ctx.destination,0,440,.25,.15,'triangle',660);MA.tone(ctx,ctx.destination,.35,110,.1,.1,'sine',160);const b=await ctx.startRendering(),a=b.getChannelData(0);let peak=0,sum=0,finite=true;for(const v of a){peak=Math.max(peak,Math.abs(v));sum+=v*v;finite=finite&&Number.isFinite(v);}return {peak,rms:Math.sqrt(sum/a.length),finite,tail:Array.from(a.slice(-100)).every(x=>Math.abs(x)<.00001),music:__game.settings.music,voice:__game.audio.voiceVolume,ready:__game.audio.ready};}\\\"\\\"\\\")\n            require(data[\\\"finite\\\"] and data[\\\"tail\\\"] and 0.03 < data[\\\"peak\\\"] < 0.4 and data[\\\"rms\\\"] > 0.01, json.dumps(data))\n            require(data[\\\"music\\\"] == 0.1 and data[\\\"ready\\\"], \\\"Audio routing/unlock\\\")\n            page.evaluate(\\\"__game.settings.set('music',.7);__game.settings.reset('Sound')\\\")\n            require(page.evaluate(\\\"__game.settings.music\\\") == 0.1, \\\"Music reset not 10%\\\")\n            (ROOT / \\\"evidence/audio.json\\\").write_text(json.dumps(data, indent=2))\n\n        check(\\\"procedural audio finite/non-silent/enveloped with gesture unlock and 10% reset\\\", audio)\n\n        def attract():\n            page.evaluate(\\\"__game.stop();__rings.ui.title();__rings.lastInput=__game.real;window.__savedBefore=localStorage.getItem('ma-rings-checkpoint-v2');window.__realBefore=JSON.stringify(__rings.world.save());__game.advance(9.99,{draw:false})\\\")\n            require(not page.evaluate(\\\"\"'!!__rings.demo\"), \"Attract entered early\")\n            page.evaluate(\"__game.advance(.02,{draw:false})\")\n            require(page.evaluate(\"!!__rings.demo\"), \"Attract did not enter at ten seconds\")\n            page.evaluate(\"__game.advance(92,{draw:false})\")\n            require(page.evaluate(\"new Set(__rings.demo.seen).size\") == 5, \"Attract missed families/dragon\")\n            require(page.evaluate(\"__savedBefore===localStorage.getItem('\"'ma-rings-checkpoint-v2')&&__realBefore===JSON.stringify(__rings.world.save())\\\"), \\\"Attract altered real run/save\\\")\n            page.keyboard.press(\\\"Enter\\\")\n            require(page.evaluate(\\\"\"'!__rings.demo && __rings.ui.shell.screen==='\"'title'\\\"), \\\"Input not consumed on attract exit\\\")\n            page.evaluate(\\\"__game.advance(10.4,{draw:false})\\\")\n            require(page.evaluate(\\\"\"'!!__rings.demo\"), \"Attract did not repeat\")\n            page.mouse.move(20, 20)\n            require(page.evaluate(\"!__rings.demo && __rings.ui.shell.screen==='\"'title'\\\"), \\\"Pointer did not exit\\\")\n            page.get_by_role(\\\"button\\\", name=\\\"Settings\\\", exact=True).click()\n            page.evaluate(\\\"__game.advance(12,{draw:false})\\\")\n            require(not page.evaluate(\\\"\"'!!__rings.demo\"), \"Attract over Settings\")\n            page.evaluate(\"__rings.ui.title();__game.start()\")\n\n        check(\"exact ten-second disposable attract, all five segments, repeat, exits and Settings exclusion\", attract)\n\n        def full_browser_run():\n            page.evaluate(\"__game.stop();__rings.startRun(['\"'warrior','wizard']);__rings.ui.shell.hide();__game.advance(.02,{draw:false})\\\")\n            summary = page.evaluate(f\\\"\\\"\\\"()=>{{const drive={DRIVER};let n=0;for(;n<120*500;n++){{const c=drive();__rings.scriptCommands=[c];__game.advance(1/120,{{draw:false}});if(['victory','failure'].includes(__rings.world.mode))break;}}__rings.scriptCommands=null;__game.advance(.02);return {{n,state:__rings.world.snapshot(),errors:__game.errors}};}}\\\"\\\"\\\")\n            (ROOT / \\\"evidence/browser-normal-playthrough.json\\\").write_text(json.dumps(summary, indent=2))\n            require(summary[\\\"state\\\"][\\\"mode\\\"] == \\\"victory\\\" and not summary[\\\"state\\\"][\\\"assisted\\\"], json.dumps(summary))\n            require(len(summary[\\\"state\\\"][\\\"rings\\\"]) == 4 and all(summary[\\\"state\\\"][\\\"bound\\\"]), \\\"Missing actual rings/bindings\\\")\n            capture(page, \\\"victory\\\")\n            page.get_by_role(\\\"button\\\", name=\\\"Another Expedition\\\", exact=True).click()\n            page.get_by_role(\\\"button\\\", name=\\\"Phantom.\\\", exact=False).click()\n            page.get_by_role(\\\"button\\\", name=\\\"Changeling.\\\", exact=False).click()\n            page.evaluate(\\\"__game.advance(.1)\\\")\n            require(page.evaluate(\\\"__rings.world.rings.length===0&&__rings.world.roomId==='court'&&\"'!__rings.world.assisted\"), \"Replay did not reset\")\n\n        check(\"bundled HTML normal-action complete expedition, actual ending and clean replay\", full_browser_run)\n        check(\"no missing runtime requests or browser/native errors\", lambda: require(not errors and page.evaluate(\"__game.errors.length\") == 0 and not any(url.startswith(\"http\") for url in requests), json.dumps({\"errors\": errors, \"requests\": requests})))\n\n        if SUITE in [\"all\", \"visual\"]:\n            def visuals():\n                page.evaluate(\"__rings.ui.shell.hide();__rings.world.toBoard();__rings.world.rings=['\"'dungeon'];__rings.world.shortcut=['dungeon'];__rings.ui.board();__game.advance(.05)\\\")\n                capture(page, \\\"map\\\")\n                for room in [\\\"d2\\\", \\\"c2\\\", \\\"i2\\\", \\\"s2\\\", \\\"final\\\"]:\n                    page.evaluate(\\\"\\\"\\\"room=>{__rings.world.debug('jump',room);__rings.ui.shell.hide();__rings.ui.lastMode='';__game.advance(.8);const h=__rings.world.heroes[0];const p=room==='final'?{x:280,y:190}:__rings.world.nearestSafe({x:290,y:170});Object.assign(h,p);Object.assign(__rings.world.heroes[1],{x:p.x-25,y:p.y+10});__rings.ui.shell.tutorial(null);__game.advance(.05);}\\\"\\\"\\\", room)\n                    capture(page, room)\n                page.evaluate(\\\"__rings.ui.about();__game.advance(.05)\\\")\n                capture(page, \\\"credits\\\")\n                require(not page.evaluate(\\\"__game.errors.length\\\"), page.evaluate(\\\"JSON.stringify(__game.errors)\\\"))\n\n            check(\\\"visual captures of board, all four families, dragon and credits\\\", visuals)\n        context.close()\n\n    if SUITE in [\\\"all\\\", \\\"browser\\\"]:\n        def pad_path():\n            ctx = browser.new_context(viewport={\\\"width\\\": 1920, \\\"height\\\": 1080})\n            ctx.add_init_script(GAMEPAD)\n            pg = ctx.new_page()\n            ready(pg)\n            pg.evaluate(\\\"__game.stop()\\\")\n\n            def button(index, b):\n                pg.evaluate(\\\"([i,b])=>{__pads[i].buttons[b]={pressed:true,touched:true,value:1};__game.advance(.04);__pads[i].buttons[b]={pressed:false,touched:false,value:0};__game.advance(.24);}\\\", [index, b])\n\n            button(0, 0)\n            require(pg.evaluate(\\\"__rings.ui.shell.screen\\\") == \\\"selection\\\", \\\"Pad confirm title\\\")\n            button(0, 0)\n            button(0, 0)\n            pg.evaluate(\\\"__pads[0].axes=[1,0,0,0];__game.advance(.7);__pads[0].axes=[0,0,0,0];__game.advance(.03)\\\")\n            require(pg.evaluate(\\\"__rings.world.heroes[0].x\\\") > 75, \\\"Pad did not move\\\")\n            require(pg.evaluate(\\\"__game.input.label('interact')\\\") == \\\"△\\\", \\\"PlayStation glyph\\\")\n            pg.evaluate(\\\"__game.settings.set('glyphs','xbox')\\\")\n            require(pg.evaluate(\\\"__game.input.label('interact')\\\") == \\\"Y\\\", \\\"Xbox glyph\\\")\n            pg.keyboard.down(\\\"d\\\")\n            pg.evaluate(\\\"__game.advance(.1)\\\")\n            pg.keyboard.up(\\\"d\\\")\n            require(pg.evaluate(\\\"__game.input.lastDevice\\\") == \\\"keyboard\\\", \\\"Keyboard hot switch\\\")\n            pg.mouse.move(1000, 450)\n            pg.evaluate(\\\"__game.advance(.1)\\\")\n            require(pg.evaluate(\\\"__game.input.lastDevice\\\") == \\\"mouse\\\", \\\"Mouse hot switch\\\")\n            button(1, 9)\n            require(pg.evaluate(\\\"\"'!!__rings.pendingJoin\"), \"Spare pad did not request join\")\n            pg.evaluate(\"__rings.world.toBoard();__game.advance(.1)\")\n            require(pg.evaluate(\"__rings.localJoined&&!__rings.world.heroes[1].ai\"), \"Couch takeover not applied\")\n            pg.evaluate(\"__rings.intent('\"'travel','dungeon');__rings.ui.shell.hide();__game.advance(.8);window.__p2before=__rings.world.heroes[1].x;__pads[1].axes=[1,0,0,0];__game.advance(.5);__pads[1].axes=[0,0,0,0]\\\")\n            require(pg.evaluate(\\\"__rings.world.heroes[1].x>__p2before+8\\\"), \\\"Player two pad did not move own hero\\\")\n            pg.evaluate(\\\"__pads[1]=null;__game.advance(.1)\\\")\n            require(pg.evaluate(\\\"__rings.ui.shell.screen\\\") == \\\"reconnect\\\", \\\"Disconnect did not show recovery choice\\\")\n            pg.get_by_role(\\\"button\\\", name=\\\"Continue with AI companion\\\", exact=True).click()\n            pg.evaluate(\\\"__game.advance(.1)\\\")\n            require(pg.evaluate(\\\"__rings.world.heroes[1].ai\\\"), \\\"Companion recovery failed\\\")\n            ctx.close()\n\n        check(\\\"standard pad navigation/movement, glyph switch, hot devices, couch takeover and disconnect\\\", pad_path)\n\n        def mobile():\n            ctx = browser.new_context(**p.devices[\\\"iPhone 13\\\"])\n            pg = ctx.new_page()\n            ready(pg)\n            capture(pg, \\\"phone-title\\\")\n            start(pg, \\\"Phantom\\\", \\\"Wizard\\\")\n            pg.evaluate(\\\"__game.stop();__game.advance(.8)\\\")\n            if pg.get_by_role(\\\"button\\\", name=\\\"Dismiss\\\", exact=True).count():\n                pg.get_by_role(\\\"button\\\", name=\\\"Dismiss\\\", exact=True).click()\n            cdp = ctx.new_cdp_session(pg)\n            points = [{\\\"x\\\": 70, \\\"y\\\": 500, \\\"id\\\": 11}]\n            cdp.send(\\\"Input.dispatchTouchEvent\\\", {\\\"type\\\": \\\"touchStart\\\", \\\"touchPoints\\\": points})\n            points = [{\\\"x\\\": 120, \\\"y\\\": 500, \\\"id\\\": 11}, {\\\"x\\\": 290, \\\"y\\\": 440, \\\"id\\\": 22}]\n            cdp.send(\\\"Input.dispatchTouchEvent\\\", {\\\"type\\\": \\\"touchStart\\\", \\\"touchPoints\\\": points})\n            cdp.send(\\\"Input.dispatchTouchEvent\\\", {\\\"type\\\": \\\"touchMove\\\", \\\"touchPoints\\\": points})\n            pg.evaluate(\\\"window.__touchBefore=__rings.world.heroes[0].x;__game.advance(.5)\\\")\n            require(pg.evaluate(\\\"__rings.touch.points.size\\\") == 2, \\\"Actual two-pointer tracking failed\\\")\n            require(pg.evaluate(\\\"__rings.world.heroes[0].x>__touchBefore+5\\\"), \\\"Invisible stick did not move\\\")\n            power = pg.locator('#touch-actions button[data-action=\\\"power\\\"]')\n            require(power.is_visible(), \\\"Context class power unavailable\\\")\n            box = power.bounding_box()\n            points.append({\\\"x\\\": box[\\\"x\\\"] + box[\\\"width\\\"] / 2, \\\"y\\\": box[\\\"y\\\"] + box[\\\"height\\\"] / 2, \\\"id\\\": 33})\n            cdp.send(\\\"Input.dispatchTouchEvent\\\", {\\\"type\\\": \\\"touchStart\\\", \\\"touchPoints\\\": points})\n            pg.evaluate(\\\"__game.advance(.08)\\\")\n            require(pg.evaluate(\\\"__rings.world.heroes[0].powerTime\\\") > 0, \\\"Touch power did not activate\\\")\n            cdp.send(\\\"Input.dispatchTouchEvent\\\", {\\\"type\\\": \\\"touchCancel\\\", \\\"touchPoints\\\": []})\n            pg.evaluate(\\\"__game.advance(.05)\\\")\n            require(pg.evaluate(\\\"__rings.touch.points.size===0&&__rings.touch.actions.size===0\\\"), \\\"Touch cancellation left held input\\\")\n            capture(pg, \\\"phone-play\\\")\n            pg.set_viewport_size({\\\"width\\\": 844, \\\"height\\\": 390})\n            pg.evaluate(\\\"__game.advance(.05)\\\")\n            capture(pg, \\\"phone-landscape\\\")\n            require(pg.evaluate(\\\"__game.errors.length\\\") == 0, \\\"Mobile native draw errors\\\")\n            ctx.close()\n\n        check(\\\"phone real multitouch movement plus class power, cancellation and resize\\\", mobile)\n\n        def alternate_browsers():\n            for kind in [p.webkit, p.firefox]:\n                other = kind.launch()\n                ctx = other.new_context(viewport={\\\"width\\\": 1024, \\\"height\\\": 768})\n                pg = ctx.new_page()\n                ready(pg)\n                start(pg)\n                pg.evaluate(\\\"__game.stop();__game.advance(.7)\\\")\n                require(pg.evaluate(\\\"__rings.world.mode==='court'&&__game.errors.length===0\\\"), f\\\"{kind.name}: native path failed\\\")\n                pg.close()\n                ctx.close()\n                other.close()\n\n        check(\\\"native renderer and gameplay boot in WebKit and Firefox stand-ins\\\", alternate_browsers)\n\n        def blocked_storage():\n            ctx = browser.new_context()\n            ctx.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new Error('storage denied')}})\\\")\n            pg = ctx.new_page()\n            ready(pg)\n            start(pg)\n            pg.evaluate(\\\"__rings.world.checkpoint();__game.advance(.1)\\\")\n            require(pg.evaluate(\\\"__rings.storageFailed&&__rings.world.mode==='court'\\\"), \\\"Storage denial prevented play\\\")\n            ctx.close()\n\n        check(\\\"unavailable storage does not block new expeditions\\\", blocked_storage)\n\n    if SUITE in [\\\"all\\\", \\\"hub\\\"]:\n        handler = functools.partial(QuietHandler, directory=str(ROOT.parent))\n        server = http.server.ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), handler)\n        thread = threading.Thread(target=server.serve_forever, daemon=True)\n        thread.start()\n        port = server.server_address[1]\n        base = f\\\"http://127.0.0.1:{port}/{quote(ROOT.name)}/vendor/hub/harness.html\\\"\n        game = quote(f\\\"../../../{ROOT.name}.html\\\")\n        try:\n            for name, extra in [(\\\"two-player\\\", \\\"players=2\\\"), (\\\"bad-network\\\", \\\"players=2&latency=150&jitter=50&loss=5\\\"), (\\\"host-departure\\\", \\\"players=2&scenario=host-leave\\\"), (\\\"server-only-host\\\", \\\"players=2&scenario=server\\\"), (\\\"one-player\\\", \\\"players=1\\\")]:\n                def conformance(name=name, extra=extra):\n                    ctx = browser.new_context(viewport={\\\"width\\\": 1280, \\\"height\\\": 900})\n                    pg = ctx.new_page()\n                    pg.goto(f\\\"{base}?game={game}&auto=1&play=2400&{extra}\\\")\n                    pg.wait_for_function(\\\"document.body.dataset.complete === 'true'\\\", timeout=65000)\n                    report = pg.evaluate(\\\"window.__hubCheck\\\")\n                    (ROOT / f\\\"evidence/hub-{name}.json\\\").write_text(json.dumps(report, indent=2))\n                    require(report[\\\"pass\\\"], json.dumps([c for c in report[\\\"checks\\\"] if not c[\\\"pass\\\"]]))\n                    identities = pg.evaluate(\\\"Array.from(document.querySelectorAll('iframe')).map(f=>f.contentDocument?.title).filter(Boolean)\\\")\n                    require(all(n == \\\"Much Ado About Rings\\\" for n in identities), \\\"Wrong served game identity\\\")\n                    ctx.close()\n                check(f\\\"AI Hub conformance: {name}\\\", conformance)\n        finally:\n            server.shutdown()\n            server.server_close()\n    browser.close()\n\nprint(json.dumps(results))\nPY\nnode tools/build.mjs --quiet\nnode tools/test.mjs hub\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_55","type":"agent_message","text":"Testing and code review found several edge cases to repair: cloak contact damage when both heroes vanish, cache claims after Continue, companion hero selection, and Escape closing the title menu. Those fixes are in place. The Hub conformance suite is now running standard, lossy-network, departure, and server-only-host cases.\n"}}
