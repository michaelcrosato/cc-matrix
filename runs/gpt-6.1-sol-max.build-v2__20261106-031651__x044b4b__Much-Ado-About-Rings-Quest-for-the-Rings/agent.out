{"type":"item.completed","item":{"id":"item_128","type":"command_execution","command":"/bin/bash -lc \"sed -n '290,353p' src/sim/world.js && sed -n '136,156p' src/sim/world.js && rg -n \\\"corrupted|malformed\\\" tests/simulation.mjs && rg -n 'THE ROADS REMEMBER|DREAD \\\\\"'$'\"' src/view/view.js && sed -n '66,87p' tests/browser.py\"","aggregated_output":"    }\n    setOwner(i, owner) {\n      this.owners[i] = owner;\n      this.heroes[i].owner = owner;\n      this.heroes[i].ai = owner == null;\n      this.heroes[i].cmd = neutral();\n      this.emit('ownership', { hero: i, owner });\n    }\n    toBoard() {\n      this.mode = 'board';\n      this.site = null;\n      this.projectiles = [];\n      this.heroes.forEach((h) => {\n        h.hp = 5;\n        h.down = false;\n      });\n      this.emit('board');\n      this.checkpoint();\n    }\n    checkpoint() {\n      if (!this.demo && this.onCheckpoint) this.onCheckpoint(this.save());\n    }\n    save() {\n      return {\n        version: 2,\n        seed: this.seed,\n        mode:\n          this.mode === 'court'\n            ? 'court'\n            : this.mode === 'board' || this.mode === 'victory'\n              ? 'board'\n              : 'room',\n        room: this.roomId,\n        site: this.site || null,\n        dread: this.dread,\n        rings: [...this.rings],\n        caches: [...this.caches],\n        shortcut: [...this.shortcut],\n        classes: [...this.classes],\n        flags: { ...this.flags },\n        stats: JSON.parse(JSON.stringify(this.stats)),\n        assisted: this.assisted,\n        elapsed: this.time,\n      };\n    }\n    static validSave(s) {\n      return (\n        !!s &&\n        s.version === 2 &&\n        Number.isFinite(s.seed) &&\n        ['court', 'board', 'room'].includes(s.mode) &&\n        !!M.ROOMS[s.room] &&\n        Number.isInteger(s.dread) &&\n        s.dread >= 0 &&\n        s.dread <= 6 &&\n        Array.isArray(s.rings) &&\n        new Set(s.rings).size === s.rings.length &&\n        s.rings.every((r) => ['dungeon', 'crystal', 'inferno', 'shifting'].includes(r)) &&\n        Array.isArray(s.caches) &&\n        new Set(s.caches).size === s.caches.length &&\n        s.caches.every((r) => ['cache1', 'cache2'].includes(r)) &&\n        Array.isArray(s.classes) &&\n        s.classes.length === 2 &&\n        s.classes.every((c) => M.HEROES.some((h) => h.id === c)) &&\n      this.transition = 0.6;\n      this.reveal = 4;\n      this.shiftState = 0;\n      this.shiftTimer = 0;\n      this.finalBeat = 'learn';\n      this.finalLearn = 0;\n      this.bound = [false, false, false, false];\n      this.bindProgress = [0, 0, 0, 0];\n      this.escape = 0;\n      this.cacheClaimed = !!def.cache && this.caches.includes(def.site);\n      this.cacheProgress = this.cacheClaimed ? 1 : 0;\n      this.map = mapFor(def);\n      this.phaseMap = mapFor(def, true);\n      this.navVersion = 0;\n      const shortcut = M.SITES.find((s) => this.rings.includes(s.id) && s.shortcutTo === def.site);\n      const entrySpawns = shortcut && def.shortcutSpawns ? def.shortcutSpawns : def.spawns;\n      this.activeShortcut = shortcut && def.shortcutSpawns ? shortcut.shortcut : null;\n      this.heroes = entrySpawns.map((p, i) =>\n        Object.assign(new E.Body({ ...p, r: 4, friction: 0, gravity: 700 }), {\n          id: i,\n          classId: this.classes[i],\n74:  test('malformed, outdated and impossible saves are rejected', () => {\n700:        E.font.text(g, `DREAD ${w.dread}/6`, hx, hy + 15, '#e8d0a1', { align: 'center', outline: false });\n701:        E.font.text(g, 'THE ROADS REMEMBER', left + width * 0.52, top + height + 16, '#b6b5aa', {\nif(e&&MA.distance(h,e)<130){const n=MA.distance(h,e)||1;c.ax=(e.x-h.x)/n;c.ay=(e.y-h.y)/n;c.primary=n<(h.classId==='wizard'?125:46);c.power=n<44;}\nif(MA.distance(h,target)<23){c.interact=true;if(e&&MA.distance(h,e)<90&&h.classId!=='warrior')c.power=true;}\nif(w.dangerAt(h.x,h.y,true))c.dodge=true;\nreturn c;})\"\"\"\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch()\n    if SUITE in [\"all\", \"browser\", \"visual\"]:\n        context = browser.new_context(viewport={\"width\": 1920, \"height\": 1080})\n        page = context.new_page()\n        errors = []\n        requests = []\n        page.on(\"pageerror\", lambda error: errors.append(str(error)))\n        page.on(\"request\", lambda request: requests.append(request.url))\n        ready(page)\n\n","exit_code":0,"status":"completed"}}
