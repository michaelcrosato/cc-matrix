 'spider' ? 1.15 : 0.85;\n          e.target = { x: target.x, y: target.y };\n          e.struck = false;\n          e.attack.start();\n          this.emit('enemy-wind', { enemy: e.id, kind: e.kind, ...e.target });\n        } else if (e.kind !== 'dragon' && D(e, target) > (e.kind === 'fire' ? 80 : 17)) {\n          const [dx, dy] = this.steer(e, target, dt);\n          const speed =\n            this.tuning.enemySpeed *\n            (e.kind === 'nightmare' ? 1.18 : e.kind === 'spider' ? 0.6 : 1) *\n            (1 + this.dread * 0.025);\n          e.vx = dx * speed;\n          e.vy = dy * speed;\n          const nx = e.x + e.vx * dt,\n            ny = e.y + e.vy * dt;\n          if (this.safe(nx, e.y)) e.x = nx;\n          if (this.safe(e.x, ny)) e.y = ny;\n        }\n      } else {\n        e.timer -= dt;\n        if (e.phase === 'wind' && e.timer <= 0) {\n          e.phase = 'active';\n          e.timer = e.kind === 'dragon' ? 0.85 : 0.32;\n          if (e.kind === 'fire') {\n            const n = Math.hypot(e.target.x - e.x, e.target.y - e.y) || 1;\n            this.projectiles.push({\n              id: `p${++this.serial}`,\n              x: e.x,\n              y: e.y,\n              z: 15,\n              vx: ((e.target.x - e.x) / n) * 69,\n              vy: ((e.target.y - e.y) / n) * 69,\n              life: 2.5,\n              team: 'enemy',\n              color: '#ffb36d',\n            });\n          }\n          if (e.kind === 'spider' || e.kind === 'nightmare') {\n            const p = this.nearestSafe(e.target);\n            e.x = p.x;\n            e.y = p.y;\n      else {\n        const candidates = [\n          { x: 40, y: 40 },\n          { x: (this.room.w - 3) * 16, y: (this.room.h - 3) * 16 },\n          { x: 40, y: (this.room.h - 4) * 16 },\n        ]\n          .map((p) => this.nearestSafe(p))\n          .filter((p) => this.heroes.every((h) => D(h, p) > 100));\n        if (candidates.length) {\n          const p = candidates[Math.floor(this.random('director-spawn') * candidates.length)];\n          const enemy = this.makeEnemy(choice === 'possession' ? 'echo' : 'fighter', p.x, p.y);\n          if (choice === 'possession') enemy.copy = this.heroes[d.used % 2].classId;\n          enemy.cd = 2.5;\n          this.enemies.push(enemy);\n        }\n      }\n      this.emit('director', { event: choice, reason: d.reason });\n    }\n    step(dt = 1 / 120, commands = []) {\n      if (!Number.isFinite(dt) || dt <= 0 || dt > 0.1) return;\n      this.tick++;\n      this.time += dt;\n      if (!['room', 'court'].includes(this.mode)) return;\n      this.roomTime += dt;\n      this.transition = Math.max(0, this.transition - dt);\n      this.reveal = Math.max(0, this.reveal - dt);\n      this.passLock = Math.max(0, (this.passLock || 0) - dt);\n-rw-r--r-- 1 micha micha 4772 Nov  6 04:27 evidence/sim-latest.json\n-rw-r--r-- 1 micha micha  263 Nov  6 04:25 evidence/pad-latest.json\n-rw-r--r-- 1 micha micha  802 Nov  6 04:22 evidence/hub-latest.json\n-rw-r--r-- 1 micha micha 1099 Nov  6 04:21 evidence/visual-latest.json\n-rw-r--r-- 1 micha micha  782 Nov  6 04:18 evidence/browser-input-latest.json\n-rw-r--r-- 1 micha micha 1746 Nov  6 04:12 evidence/browser-latest.json\n-rw-r--r-- 1 micha micha  400 Nov  6 03:59 evidence/hub-gameplay-latest.json\n    step(w, 0.03, [M.neutral()]);\n    step(w, 0.05, [command]);\n    assert(w.ring.carrier === 1, 'a new press could not pass to willing AI');\n  });\n  test('dragon sweeping breath respects cover and Wizard wards', () => {\n    const w = new M.World();\n    w.rings = ['dungeon', 'crystal', 'inferno', 'shifting'];\n    w.loadRoom('final', false);\n    const e = w.enemies[0],\n      p = { x: e.x, y: 330 };\n    e.phase = 'active';\n    e.timer = 0.425;\n    e.target = p;\n    assert(!w.dragonThreat(e, p), 'cover did not block breath');\n    w.map.set(17, 12, 0);\n    assert(w.dragonThreat(e, p), 'open sweeping ray did not threaten');\n    w.wards.push({ ...p, r: 42, life: 2 });\n    assert(!w.dragonThreat(e, p), 'ward did not interrupt breath');\n    h.hurt = 0;\n    h.context = { type: 'revive', target: 1 };\n    w.ring.carrier = 0;\n    w.hurt(h, 1);\n    assert(p.revive === 0 && h.interrupt > 0 && w.ring.carrier === 0, 'hold not interrupted cleanly');\n  });\n  test('claimed cache reloads ready for departure and cannot grant the ward again', () => {\n    const w = new M.World();\n    w.rings = ['dungeon'];\n    w.site = 'cache1';\n    w.loadRoom('cache1', false);\n    w.caches = ['cache1'];\n    w.flags.teamWard = false;\n    const r = M.World.restore(w.save());\n    assert(\n      r.cacheClaimed && !r.flags.teamWard && !r.reachable('cache1'),\n      'cache reward duplicated on Continue',\n    );\n  });\n  test('normal full expedition through all eight rooms and four binding stations', () => {\n    const w = new M.World({ seed: 73461 });\n    const history = [];\n    for (let leg = 0; leg < 8 && w.mode !== 'victory'; leg++) {\n      if (w.mode === 'board') {\n        const next = ['dungeon', 'crystal', 'inferno', 'shifting', 'final'].find((s) => w.reachable(s));\n        assert(next && w.intent(0, 'travel', next), 'no legal route');\n      }\n      const p = play(w, 280);\n      history.push(p);\n      if (w.mode === 'failure')\n","exit_code":0,"status":"completed"}}
