s.ring.carrier !== h.id)),\n      );\n      if (this.lures.length && e.kind !== 'dragon')\n        targets = [...targets, ...this.lures.map((l) => ({ ...l, lure: true }))];\n      targets.sort(\n        (a, b) =>\n          D(e, a) * (a.lure ? 0.25 : this.ring && this.ring.carrier === a.id ? 0.65 : 1) -\n          D(e, b) * (b.lure ? 0.25 : this.ring && this.ring.carrier === b.id ? 0.65 : 1),\n      );\n      const target = targets[0];\n      if (!target) return;\n      e.facing = Math.atan2(target.y - e.y, target.x - e.x);\n      e.vx = e.vy = 0;\n      const range =\n        e.kind === 'dragon'\n          ? 999\n          : e.kind === 'fire'\n            ? 135\n            : e.kind === 'spider'\n              ? 75\n              : e.kind === 'nightmare'\n                ? 85\n1125:          const enemy = this.makeEnemy(choice === 'possession' ? 'echo' : 'fighter', p.x, p.y);\n1126:          if (choice === 'possession') enemy.copy = this.heroes[d.used % 2].classId;\n","exit_code":0,"status":"completed"}}
