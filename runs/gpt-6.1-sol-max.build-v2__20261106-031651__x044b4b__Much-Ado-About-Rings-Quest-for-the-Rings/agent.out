{"type":"item.completed","item":{"id":"item_111","type":"command_execution","command":"/bin/bash -lc \"rg -n 'SOURCE|sourceHash' project.json tools/test.mjs docs/build-manifest.json && sed -n '1,70p' tools/build.mjs && sed -n '528,565p' src/entry.js\"","aggregated_output":"project.json:4:  \"base\": \"Much-Ado-About-Rings-SOURCE-gpt-6.1-sol-max-20261106-031651\",\ntools/test.mjs:59:const sourceHash = createHash('sha256')\ntools/test.mjs:60:  .update(readFileSync('../Much-Ado-About-Rings-SOURCE-gpt-6.1-sol-max-20261106-031651.html'))\ntools/test.mjs:64:  JSON.stringify({ suite, sourceHash, results: result }, null, 2),\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { resolve, dirname } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nconst root = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nconst project = JSON.parse(readFileSync(resolve(root, 'project.json'), 'utf8'));\nconst read = (path) => readFileSync(resolve(root, path), 'utf8');\nconst inline = (source) => source.replace(/<\\/script/gi, '<\\\\/script');\nconst parts = [\n  'vendor/engine/my-3d2dge.js',\n  'src/content/content.js',\n  'src/sim/world.js',\n  'src/view/assets.js',\n  'src/view/view.js',\n  'src/audio/audio.js',\n  'src/net/hub.js',\n  'src/ui/ui.js',\n  'src/entry.js',\n];\nconst interview = readFileSync(resolve(root, '../exit-interview.json'), 'utf8');\nJSON.parse(interview);\nconst html = `<!doctype html>\\n<html lang=\"en\"><head><meta charset=\"utf-8\">\\n<script>${read('vendor/hub/session.js')}</script>\\n<title>${project.title}</title>\\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\\n<meta name=\"theme-color\" content=\"#152232\">\\n<meta name=\"hub:session\" content=\"1\">\\n<meta name=\"hub:session-players\" content=\"1-2\">\\n<meta name=\"hub:session-mode\" content=\"shared-world\">\\n<meta name=\"hub:session-goal\" content=\"Steal four rings together, bind the deathless dragon at four stations, and escape.\">\\n<meta name=\"hub:session-howto\" content=\"Left stick / WASD move; right stick / mouse aim; R2 / click primary; L2 / right click power; Cross / Space evade; Triangle / E interact; R1 / Q companion ping; Square / Tab map; Options / Escape local menu.\">\\n<meta name=\"hub:session-minutes\" content=\"25\">\\n<style id=\"game-css\">${read('src/ui/style.css')}</style></head><body>\\n<canvas id=\"screen\" aria-label=\"${project.title} game world\"></canvas>\\n<div id=\"demo-label\" hidden>THE RINGMASTER IS WATCHING<small>AI DEMONSTRATION · Any input returns to the title</small></div>\\n<script>globalThis.MA = { INTERVIEW: ${inline(interview)} };</script>\\n${parts.map((path) => `<script>\\n${inline(read(path))}\\n</script>`).join('\\n')}\\n</body></html>\\n`;\nwriteFileSync(resolve(root, `../${project.base}.html`), html);\nwriteFileSync(resolve(root, 'index.html'), html);\nwriteFileSync(\n  resolve(root, 'docs/build-manifest.json'),\n  JSON.stringify(\n    {\n      title: project.title,\n      files: parts,\n      engine: project.engineCommit,\n      hub: project.hubCommit,\n      bytes: Buffer.byteLength(html),\n      externalRuntimeDependencies: [],\n    },\n    null,\n    2,\n  ),\n);\nif (!process.argv.includes('--quiet'))\n  console.log(`Built ${project.base}.html (${Math.round(Buffer.byteLength(html) / 1024)} KiB)`);\n      this.view.remote = this.net.active && !this.net.isHost();\n      this.view.update(w, dt);\n      this.view.camera(w);\n      this.audio.update(w, !this.game.audio.ready);\n    }\n    update(dt) {\n      const w = this.world;\n      if (this.stage === 'title' && !this.net.active) {\n        if (!this.demo && this.ui.shell.screen === 'title' && this.game.real - this.lastInput >= 10)\n          this.startAttract();\n        if (this.demo) this.updateAttract(dt);\n        else this.view.update(w, dt, true);\n        this.ui.update(w, dt);\n        return;\n      }\n      if (this.net.ended) return;\n      if (this.pendingJoin && (w.mode === 'board' || w.roomTime < 0.5 || this.stage === 'title')) {\n        this.localJoined = true;\n        w.setOwner(1, 1);\n        this.pendingJoin = null;\n        this.ui.shell.toast('Two heroes, two hands', 'Player 2 now commands the second hero.');\n      }\n      if (this.game.input.pressed('map') && !this.ui.shell.screen) {\n        this.ui.objectiveMap();\n      }\n      const localSeat = this.net.active ? Math.max(0, this.net.seat()) : 0,\n        local = this.inputFor(this.game.input, w.heroes[localSeat]);\n      if (this.net.active) this.net.update(dt, local);\n      else if (!this.ui.shell.screen || w.mode === 'board') {\n        const commands = this.scriptCommands || [local, this.inputFor(this.game.players[1], w.heroes[1])];\n        w.step(dt, commands);\n      }\n      this.view.remote = this.net.active && !this.net.isHost();\n      this.view.update(w, dt);\n      if (['room', 'court'].includes(w.mode)) this.view.camera(w);\n      this.ui.update(w, dt);\n      this.touch.update(w);\n      this.audio.update(w);\n","exit_code":0,"status":"completed"}}
