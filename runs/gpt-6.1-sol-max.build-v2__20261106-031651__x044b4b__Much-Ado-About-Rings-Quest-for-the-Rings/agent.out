{"type":"item.completed","item":{"id":"item_145","type":"command_execution","command":"/bin/bash -lc \"sed -n '60,88p' src/view/view.js && sed -n '117,154p' src/view/view.js && rg -n 'voice\\\\(|base =|i \\\\* 0.075|e.type === .revive' src/audio/audio.js && sed -n '365,384p' tests/simulation.mjs && sed -n '462,489p' tests/simulation.mjs && head -18 tools/test.mjs\"","aggregated_output":"      if (this.epoch !== w.epoch) {\n        this.epoch = w.epoch;\n        this.rigs.clear();\n        this.positions.clear();\n        this.fx = [];\n        this.lastEvent = null;\n      }\n      for (const source of w.heroes) {\n        const h = this.interpolate(source, `h${source.id}`, dt);\n        const rig = this.rig(`h${h.id}:${h.classId}`, () => M.heroRig(h.classId));\n        const pose = h.down\n          ? 'down'\n          : h.context && h.cmd.interact && ['revive', 'bind', 'cache'].includes(h.context.type)\n            ? 'binding'\n            : h.powerTime > 0\n              ? { warrior: 'guard', wizard: 'cast', phantom: 'stonewalk', changeling: 'mirrorcloak' }[\n                  h.classId\n                ]\n              : w.ring && w.ring.carrier === h.id\n                ? 'ringCarry'\n                : null;\n        rig.update(dt, {\n          x: h.x,\n          y: h.y,\n          z: h.z || 0,\n          vx: h.vx,\n          vy: h.vy,\n          facing: h.facing,\n          hurt: h.hurt < 0.4 && h.hurt > 0,\n          });\n        }\n      }\n      const events = w.events;\n      const index = this.lastEvent ? events.findIndex((e) => e.id === this.lastEvent) : events.length - 1;\n      for (const ev of events.slice(Math.max(0, index + 1)))\n        if (\n          [\n            'hit',\n            'stun',\n            'hurt',\n            'pickup',\n            'ring-return',\n            'safe-shift',\n            'bind',\n            'revive',\n            'primary',\n            'power',\n            'companion-return',\n          ].includes(ev.type)\n        ) {\n          const h = w.heroes[ev.hero || 0];\n          this.fx.push({\n            ...ev,\n            x: ev.x ?? h.x,\n            y: ev.y ?? h.y,\n            life: ev.type === 'pickup' || ev.type === 'bind' ? 1.8 : 0.6,\n            max: ev.type === 'pickup' || ev.type === 'bind' ? 1.8 : 0.6,\n          });\n        }\n      this.lastEvent = events.length ? events[events.length - 1].id : null;\n      this.fx.forEach((f) => {\n        f.life -= dt;\n      });\n      this.fx = this.fx.filter((f) => f.life > 0);\n    }\n    camera(w) {\n      const game = this.game,\n109:    voice(kind = 'master') {\n113:        base = kind === 'master' ? 95 : kind === 'wizard' ? 230 : 165;\n118:          ctx.currentTime + i * 0.075,\n159:        if (e.type === 'director') this.voice('master');\n160:        if (e.type === 'revive') this.voice(w.heroes[e.hero].classId);\n163:          this.voice('wizard');\n        ['inferno', 'i2'],\n        ['shifting', 's2'],\n      ]) {\n        const w = new M.World({ classes: pair, seed: 1981 });\n        w.site = site;\n        w.dread = 6;\n        if (site !== 'dungeon') w.rings = ['dungeon'];\n        w.loadRoom(room, false);\n        const p = play(w, 180);\n        assert(\n          w.mode === 'board' && w.rings.includes(site) && !w.assisted,\n          JSON.stringify({ pair, site, ...p, state: w.snapshot() }),\n        );\n      }\n    });\n  test('companion actually navigates to and revives a fallen hero in every family', () => {\n    for (const room of ['d2', 'c2', 'i2', 's2']) {\n      const w = new M.World();\n      w.loadRoom(room, false);\n      w.heroes[0].down = true;\n      'evidence/normal-playthrough.json',\n      JSON.stringify(\n        { seed: 73461, assisted: w.assisted, history, state: w.snapshot(), events: w.events },\n        null,\n        2,\n      ),\n    );\n    assert(\n      w.mode === 'victory' && !w.assisted && w.rings.length === 4 && w.bound.every(Boolean),\n      JSON.stringify({ history, state: w.sn