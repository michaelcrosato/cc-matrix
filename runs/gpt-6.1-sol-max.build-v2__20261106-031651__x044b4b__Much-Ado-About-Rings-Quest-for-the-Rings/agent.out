{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '155,345p' vendor/engine/kits/adventure.js && rg -n 'Shell|settings\\\\.add|register|Cam|groundRing|groundPoly|Humanoid.pose|attack.state|_pause' vendor/engine/API-INDEX.md | head -65\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '155,345p' vendor/engine/kits/adventure.js && rg -n 'Shell|settings\\\\.add|register|Cam|groundRing|groundPoly|Humanoid.pose|attack.state|_pause' vendor/engine/API-INDEX.md | head -65\"","aggregated_output":"    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 1  ADVENTURE  (Secret of Mana, Zelda: ALttP). Three rooms: village, ruins, shrine. Talk, clear the ruins for\n * the key, open the great door, claim the crystal. THE LOOK: wall MATERIALS, ONE floorTex with PAINTED LIGHT, pitched\n * roofs, leaf-clump bushes, light shafts, dialog PORTRAITS.\n * KEYS: WASD or arrows move, J or X swings the sword, Enter or Space talks. TOUCH: the stick, ATTACK, CONFIRM.\n * ANY SCREEN: rooms are 4:3 in a world that goes on past them (forest above and below, the next rooms beside), so a\n * screen of any shape is filled. CAMERA (Settings, or C): ROOMS slides screen by screen as Zelda's does, the rooms beside\n * this one under a dim CURTAIN (they wait, as their monsters do); SCROLL follows the hero. The HUD sits in the corners.\n * ===================================================================================== */\nconst ADV = (() => {\n  const T = 16, ROOM = [14 * T, 12 * T], AREAS = ['Mana Village', 'Mossy Ruins', 'Shrine of Mana'];\n  const ROWS = [\n    // village          ruins             shrine\n    ['^^^^^^^^^^^^^^', 'RRRRRRRRRRRRRR', 'XXXXXXXXXXXXXX'],\n    ['^^#^^^^^^^^#^^', 'RHhJKFYDYFKhHR', 'XwjiXnWXnXijwX'],\n    ['#UUUU.ZZZZ.~~#', 'R.u..qv.vq.S.R', 'X.S*.B..B.*S.X'],\n    ['#GQOQbzNzZu~~#', 'H.KK....x....H', 'X.....rA.....X'],\n    ['#ccccV~ccLe~~#', 'K..s.q::::.s.H', 'X..I..++..I..X'],\n    ['#cM@cPccac=~~#', 'H.....::::k..K', 'X....m++m....X'],\n    ['#,,,,,,,,,,__,', ',,....::C:...H', 'X4.I..++..I.4X'],\n    ['#.b...b.g,d__,', ',,..o.::::.s.H', 'X.....++.....X'],\n    ['#...%%%f..s~~#', 'Hb.K..::::q.KH', 'X..I..++..I..X'],\n    ['#T..%%%.u..~~#', 'H.u..s....y.RH', 'X.p...++...p.X'],\n    ['#.3........~~#', 'H...bK...b.xRH', 'X.....E+.....X'],\n    ['##############', 'RRRRRRRRRRRRRR', 'XXXXXX++XXXXXX']\n  ].map(r => r.join(''));\n  // the world AROUND the rooms: PAD rows of forest canopy above and below (a meadow's edge first, the shrine's stone under\n  // the shrine), so a screen of any shape is filled. The rooms' rows start at OY\n  const PAD = 12, OY = PAD * T, wood = (cx, cy) => cx >= 28 ? 'X' : E.hash2(cx * 7, cy * 5) < .18 ? '2' : '1';\n  const AROUND = (cy0, meadow) => Array.from({ length: PAD }, (_, i) => Array.from({ length: 42 }, (_, cx) => meadow && i < 2 && cx < 28 ? '.' : wood(cx, cy0 + i)).join(''));\n  ROWS.unshift(...AROUND(0)); ROWS.push(...AROUND(PAD + 12, true));\n  const LEGEND = {\n    // walls: a wall type (TYPES), or { tile, spawn } = a wall with a prop on its face (THINGS)\n    '#': 1, 'U': 5, 'Z': 8, 'R': 9, 'H': 3, 'K': 4, 'F': 6, 'X': 2, 'A': 7, '1': 10, '2': { tile: 10, spawn: 'tree' },\n    '^': { tile: 1, spawn: 'tree' }, 'G': { tile: 5, spawn: 'ivy' }, 'Q': { tile: 5, spawn: 'pane' }, 'O': { tile: 5, spawn: 'door' },\n    'z': { tile: 8, spawn: 'pane' }, 'N': { tile: 8, spawn: 'shop' }, 'h': { tile: 3, spawn: 'vines' }, 'J': { tile: 3, spawn: 'cobweb' }, 'Y': { tile: 6, spawn: 'moss' }, 'D': { tile: 6, spawn: 'gate' },\n    'w': { tile: 2, spawn: 'window' }, 'W': { tile: 2, spawn: 'rose' }, 'i': { tile: 2, spawn: 'torch' }, 'n': { tile: 2, spawn: 'banner' }, 'j': { tile: 2, spawn: 'cobweb' }, 'r': { tile: 7, spawn: 'relic' },\n    // floors: a tag for floorTex; block = not walkable\n    ',': { floor: 'path' }, 'c': { floor: 'plaza' }, '~': { floor: 'water', block: true }, '_': { floor: 'bridge' }, ':': { floor: 'pave' }, '+': { floor: 'carpet' }, '%': { floor: 'bed' },\n    '@': { floor: 'plaza', spawn: 'hero' }, 'M': { floor: 'plaza', spawn: 'elder' }, 'P': { floor: 'plaza', spawn: 'pot' }, 'L': { floor: 'plaza', spawn: 'lamp' },\n    'V': { floor: 'water', block: true, spawn: 'fountain' }, 'C': { floor: 'pave', spawn: 'chest' }, 'E': { floor: 'carpet', spawn: 'entry' }, 'd': { floor: 'path', spawn: 'villager' },\n    // people, creatures and props\n    'f': 'florist', 'a': { floor: 'plaza', spawn: 'cat' }, 's': 'rabite', 'v': 'bat', 'k': 'goblin', 'm': 'mage', 'b': 'bush', 'p': 'pot', 'T': 'oak', 'g': 'sign', 'u': 'mushroom',\n    'e': 'barrel', '=': 'crate', '3': 'stump', '4': 'obelisk', 'q': 'ruin', 'I': 'pillar', 'S': 'statue', 'o': 'rock', 'x': 'crystal', 'y': 'skull', 'B': 'brazier', '*': 'candelabra'\n  };\n  // wall MATERIALS: face = side, roof = top pattern (beam = timber); cut = lowered to cutH in front of the camera\n  const SLAB = { face: 'stone', roof: 'slab' }, TYPES = {\n    1: { h: 16, cut: true, cutH: 7, face: 'hedge', roof: 'leaves', top: '#3f8c3c', side: '#2e6a34' },   // hedge\n    2: { h: 34, cut: true, cutH: 8, ...SLAB, top: '#4e4670', side: '#6a6294', course: 9 },   // shrine stone\n    3: { h: 26, cut: true, cutH: 8, face: 'ruin', roof: 'slab', top: '#7a8a66', side: '#8e8a98' },   // ruin wall, mossy top: the 'ruin' MATERIAL (stones, cracks, moss, dirt; docs/ASSETS.md)\n    4: { h: 12, cut: true, ...SLAB, top: '#72845e', side: '#8e8a98', course: 6 },   // crumbled ruin\n    5: { h: 36, face: 'timber', roof: 'tiles', top: '#c4583a', side: '#f0e0c0', beam: '#6a4228' },   // cottage\n    6: { h: 36, ...SLAB, top: '#5a5480', side: '#7a7298', course: 9 },   // shrine facade\n    7: { h: 9, ...SLAB, top: '#8a84b4', side: '#5a5484', course: 4 },   // altar\n    8: { h: 36, face: 'plaster', roof: 'tiles', top: '#3a7ab4', side: '#f4e6c8' },   // shop\n    9: { h: 30, cut: true, cutH: 8, face: 'rock', roof: 'grass', top: '#5a9a44', side: '#8a7462' },   // cliff\n    10: { h: 22, face: 'hedge', roof: 'leaves', top: '#2c6a36', side: '#1f4a2a' }   // the forest round the rooms\n  };\n  // set dressing: tag -> prop(s). r = solid, cut = breakable (debris), drop = loot, face = on the wall at z (anchor\n  // 'top' hangs it), light = GPU light, dx = nudge, hidden = appears later; shape = a SHAPE (E.SHAPES, docs/ASSETS.md:\n  // right in every view and turn, no drawing code) in place of a prop, size its scale\n  const THINGS = {\n    // village\n    door: [{ face: true, size: 1.1, color: '#7a4222' }, { prop: 'lantern', face: true, z: 33, dx: 14, anchor: 'top', light: '#ffb060' }],\n    shop: [{ prop: 'door', face: true, size: 1.1, color: '#2a4a7a' }, { prop: 'awning', face: true, z: 23, size: .95, color: '#d8483a' }],\n    pane: { prop: 'window', face: true, z: 12, size: .65, color: '#6a4424', colors: ['#fff0b0', '#ffd070'] }, ivy: { prop: 'vines', face: true, z: 35, anchor: 'top', color: '#3a8a3a', blossom: '#f890b0' },\n    fountain: { prop: 'statue', size: .8, color: '#a8a6c0', dx: 8 }, lamp: { prop: 'streetlamp', r: 3, size: .8, halo: false }, oak: { prop: 'tree', size: 1.45, r: 8 },   // lamp: unlit by day\n    bush: { r: 6, cut: ['#2f7a34', '#5ab04a', '#9ad86a'] }, pot: { size: .95, r: 5, cut: ['#7a3a22', '#c07040', '#e8a878'], drop: 'gem' }, sign: { r: 4 },\n    mushroom: { size: .75, color: '#e0503a' }, barrel: { shape: 'barrel', r: 5, size: .75 }, crate: { shape: 'crate', r: 6, size: .65 },\n    // from the asset store, cut into the page's 'adventure' set (src/assets/sets/adventure.js); without it, props\n    ...(E.addAssets((window.ASSETS || {}).adventure || { set: 'adventure' }).shapes.length ? { stump: { shape: 'adventure:stump-round', r: 5, size: .7 },\n      obelisk: { shape: 'adventure:pillar-obelisk', r: 6, size: .8 } } : { stump: { prop: 'rock', r: 5, color: '#8a5a3a' }, obelisk: { prop: 'pillar', r: 6 } }),\n    // ruins\n    vines: { face: true, z: 25, anchor: 'top', color: '#4a8a3a', blossom: '#f890b0' }, moss: { prop: 'vines', face: true, z: 35, anchor: 'top', size: .8, color: '#5a8a3a', blossom: '#f890b0' },\n    gate: { prop: 'door', face: true, size: 1.1, color: '#5a3a6a' }, ruin: { prop: 'pillar', broken: true, r: 7 }, rock: { r: 5, color: '#8a8698' }, skull: { prop: 'bones' },\n    crystal: { r: 4, light: '#5ad8f0' }, chest: { r: 6, hidden: true },\n    // shrine\n    window: { face: true, z: 7, size: .8, colors: ['#e05a6a', '#5a8ae8', '#f0c85a', '#6ad08a'], light: '#8ab0ff' }, torch: { face: true, z: 14, light: '#ff9a4a' },\n    rose: { prop: 'window', face: true, z: 2, size: 1, dx: 8, colors: ['#e8c85a', '#c04aa0', '#5a8ae8'], light: '#c8a0ff' }, banner: { face: true, z: 8, size: .8, color: '#8a1a3a', emblem: '#e8c04a' },\n    cobweb: { face: true, z: 34, anchor: 'top', size: .9 }, pillar: { r: 7 }, statue: { r: 6, color: '#9a98b0' }, brazier: { r: 5, size: .9, light: '#ff9a4a' }, candelabra: { r: 3, size: .8, light: '#ffc060' }\n  };\n  // palettes: E.ramp(hex, n, strength) = n hue-shifted shades, dark to light\n  const rgb = hexes => hexes.map(E.hex), R5 = (c, s = .6) => rgb(E.ramp(c, 5, s)), FLAG = (s, mortar) => ({ stones: s.slice(1, 4), mortar, hi: s[4], lo: s[0], speck: s[1] });\n  const GRASS = [['#4c9a3e', '#5aa640', '#6cb44c'], ['#42804a', '#4a8a48', '#5a9a4e']].map(room => room.map(c => R5(c))), DIRT = R5('#b08652', .7), WATER = R5('#2a7ac4', .9), STONE = R5('#a49a8a', .7), SOIL = R5('#6e4a34');\n  const PLAZA = FLAG(R5('#b4a894'), E.hex('#6a5e52')), PAVE = FLAG(R5('#8a8a96'), E.hex('#3a3a3e')), TILE = [R5('#5a5688'), R5('#403c68')], PETAL = rgb(['#ffffff', '#ffe070', '#f890b0']);\n  const CARPET = rgb(E.ramp('#9a2438', 4)), GOLD = rgb(E.ramp('#d8a840', 3)), RUNE = [...E.hex('#6ae8e0'), .35], LILY = R5('#4aa050');   // 4th value = GPU glow\n  const SKY = rgb(['#a8dcf4', '#e8f8ff']), REFLECT = E.hex('#1e5a5a');   // sky glints, the hedge's reflection\n  const TUFT = ['.l.l.', '.dld.', '..d..'], BLOOM = ['.w.', 'wyw', '.w.'];   // grass stamps\n  const MOOD = [[.92, .9, .84], [.8, .88, .8], [.34, .3, .46]];   // GPU ambient light per room\n  const mood = m => { if (gpu) gpu.ambient = m; L.ambient = (m[0] + m[1] + m[2]) / 3; };   // (and the canvas lighting's, where WebGPU is missing and it stands in)\n  // light shafts per room: beam x, tint (a dark tint = a faint beam), lean\n  const BEAMS = [[[34, 128, 196], '#7a5a26', 60], [[50, 150], '#566a22', 60], [[24, 120, 200], '#4a3a8a', 12]];\n  const WIN = { bg: ['#3a4a9e', '#12163e'], border: '#f0e0a8' }, FACE_BG = ['#7aa4e8', '#1e2a66'];\n  // pixel sprites ('.' = transparent)\n  const GEM = E.sprite(['..g..', '.gGg.', 'gGWGg', 'gGGGg', 'dgGgd', '.dgd.', '..d..'], { g: '#1e9a3a', G: '#56e070', W: '#e8fff0', d: '#0e5a24' });\n  const HEART = E.sprite(['.R.R.', 'RWRRR', 'RRRRR', '.RRR.', '..R..'], { R: '#e8384a', W: '#ffd0d6' });\n  const KEYS = [1, 2].map(s => E.sprite(['.yy....', 'y..y...', 'Y..Yyyy', '.YY..y.', '.....yY'], { y: '#f8d048', Y: '#b07818' }, s));   // scale 2: held up high\n  const CRYSTALS = [1, 2].map(s => E.sprite(['....w....', '...wWc...', '..wWWcc..', '.wWWWccC.', 'wWWWccccC', '.wWWcccC.', '.cWWccCC.', '..cWcCC..', '..ccCC...', '...cC....'], { w: '#f0ffff', W: '#a8f0ff', c: '#4ac8e8', C: '#2a5ab0' }, s));\n\n  // THE CAST: chibi rigs, anime eyes, own outfits and palettes; the hero's cape is SECONDARY MOTION\n  const RIGS = {\n    hero: () => new E.Humanoid({ size: 1.3, outfit: 'tunic', hair: 'spiky', face: { eyes: 'big', bangs: .8 }, cape: { len: 4, width: 3.2, seg: 2.2 },\n      colors: { skin: '#f8cca4', hair: '#e8902c', cloth: '#3a8a4a', trim: '#f0d070', pants: '#4a3a5a', boot: '#8a4a26', belt: '#6a3a1a', glove: '#7a5238', eye: '#3a2a6a', cape: '#d0483a', capeIn: '#7a1e2e' } }),\n    elder: () => new E.Humanoid({ size: 1.2, weapon: 'staff', outfit: 'robe', hair: 'short', sleeves: 'long', hunch: .45, hat: { style: 'pointed', color: '#3e3278' }, face: { eyes: 'big', bangs: .35 },\n      colors: { skin: '#f0c4a8', hair: '#b8b2c4', cloth: '#5a4a9a', trim: '#f0cc60', belt: '#f0cc60', boot: '#4a3a2a', eye: '#2a2a4a' } }),\n    florist: () => new E.Humanoid({ size: 1.15, weapon: null, outfit: 'robe', sleeves: 'long', hair: 'ponytail', face: { eyes: 'big', bangs: 1 },\n      colors: { skin: '#f8cca4', hair: '#b0482a', cloth: '#d86a8a', trim: '#f4a8c0', belt: '#fff0d0', pants: '#d86a8a', boot: '#6a3a2a', eye: '#2a5a3a' } }),\n    villager: () => new E.Humanoid({ size: 1.1, weapon: null, hair: 'short', hat: { style: 'band', color: '#d8483a' }, face: { eyes: 'big', bangs: .7 }, shoulderHalf: 4.6, armUpper: 5.2, armLower: 5,   // the wave clears his face\n      colors: { skin: '#f0c090', hair: '#6a3a1e', cloth: '#e8a83a', trim: '#fff0d0', pants: '#4a5a8a', boot: '#6a4a2a', belt: '#6a4a2a', eye: '#2a3a5a' } }),\n    goblin: () => new E.Humanoid({ size: 1.1, build: 'bulky', weapon: null, outfit: 'tunic', hair: 'bald', eyeGlow: '#ffd84a',\n      colors: { skin: '#8ab84a', cloth: '#8a5a32', trim: '#c8a040', pants: '#4a3a2a', boot: '#3a2a1a', belt: '#3a2a1a' } }),\n    mage: () => new E.Humanoid({ size: 1.3, build: 'heroic', weapon: 'staff', outfit: 'robe', hood: true, sleeves: 'long', eyeGlow: '#ff6ab0',\n      colors: { skin: '#c8b8e0', hair: '#2e2450', cloth: '#4a3a86', trim: '#d070f0', belt: '#d070f0', boot: '#1a1628', orb: '#ff80e0' } })\n  };\n  // BLOB CREATURES: a round body plus parts\n  const RABITE = { dk: '#b0703a', base: '#f4d49a', lt: '#fff4dc', pupil: '#5a1a2a', inner: '#f09aa8', ext: '#d8a060' };\n  const BAT = { dk: '#2e1a44', base: '#6a4a9a', lt: '#a890d0', eye: '#fff0a0', pupil: '#c02020', wing: '#4a2a6a', inner: '#e08aa0' };\n  const CAT = { dk: '#9a5028', base: '#f0a050', lt: '#ffd8a0', pupil: '#2a4a1a', inner: '#f8b0b0', ext: '#fff0e0' };\n  const FOES = {   // hp (a hit does 8-12), look, moves (E.MOVES with a long, deep wind-up: the TELL)\n    rabite: { hp: 18, look: () => new E.Blob({ R: 5.5, colors: RABITE, ears: 'rabbit', feet: true, tail: true, mouth: true, face: 'front' }) },\n    bat: { hp: 12, fly: 17, look: () => new E.Blob({ R: 4.5, colors: BAT, wings: true, ears: 'cat', mouth: 'fangs', face: 'front' }) },\n    goblin: { hp: 40, look: RIGS.goblin, moves: ['claw', 'twohand'], tune: { wind: .34, crouch: 1, lean: .9 } },   // a raking claw, a two-fist SLAM\n    mage: { hp: 30, look: RIGS.mage, moves: ['cast'], tune: { wind: .6, lean: .6 } }   // leans back to raise, recoils forward to release\n  };\n  // spins at the waist; CHARGE: the spin's wind-up, deeper\n  const WAIST = { z0: -10, z1: -10 }, CHARGE = { ...E.MOVES.spin, ...WAIST, a0: 2.4, crouch: .6, lean: .6 };\n  // idle: poses in turn; near: turn to the hero (wave: say hello); talk: gestures; chore: a move while kneeling\n  const NPCS = {\n    elder: { name: 'ELDER', idle: [null, null, 'hips'], near: 56, talk: ['block', null, 'hips', null], lines: [() => 'Rabites overran the Mossy Ruins across the river. Press ' + game.input.label('attack') + ' to swing your sword and clear them out!',\n      'Clear the ruins and the old chest opens. The Mana crystal sleeps in the shrine behind the great door.'] },\n    florist: { name: 'LISE', face: Math.PI, idle: ['kneel', 'kneel', null], near: 36, talk: ['hips', 'cast'],   // tends the flower bed\n      chore: () => new E.Attack('plunge', { hand: 'both', a0: -.5, a1: -.9, r0: 4, r1: 9, wind: .3, active: .16, recover: .45 }),\n      lines: ['A rabite got into my garden again! Could you shoo it away?', 'Mind the bats in the ruins. They swoop when you get close!'] },\n    villager: { name: 'PIP', idle: [null, 'hips'], near: 50, wave: true, talk: ['hips', null], lines: ['Hi! The bridge leads to the Mossy Ruins.', () => 'Keep ' + game.input.label('attack') + ' held after a swing, then let go: a SPIN ATTACK!'] }   // a function: the player's own key\n  };\n  // BACKDROP (iso view): a sea of clouds\n  const bg = new E.Backdrop({ sky: ['#3a74c8', '#8ac2ea', '#e4f2f4', '#9ccae6', '#5a90c8'], layers: [{ kind: 'clouds', color: '#ffffff', y: .3, height: .16, parallax: .04, drift: 3 },\n    { kind: 'clouds', color: '#ffffff', y: .98, height: .4, parallax: .1, drift: 3, seed: 9 }] });\n  let map, relic, entry, hero, npcs, foes, pets, items, things, roofs, shots, talk, speaker, won, keys, gems, area, held, fx;\n  // CAMERA, the player's choice: 'rooms' slides screen by screen (Zelda), 'scroll' follows the hero (Settings, or C)\n  game.settings.define({ key: 'advCamera', group: 'Adventure', label: 'Camera', options: [['rooms', 'Rooms'], ['scroll', 'Scroll']], value: 'rooms', help: 'Rooms: screen by screen, as Zelda. Scroll: it follows the hero' });\n  // LIGHTING: GPU lights (pools of light and shadows, WebGPU) draw every frame twice and light each pixel: a phone's frame\n  // rate pays for them, so Auto keeps them for a computer (its main pointer a mouse or touchpad) and a phone gets Fast (the\n  // floor is lit already): the main pointer, as a phone with a stylus has a fine one too\n  const gpuWanted = () => game.settings.advLight === 'gpu' || (game.settings.advLight === 'auto' && !!(window.matchMedia && matchMedia('(pointer: fine)').matches));\n  const lighting = () => { if (!map) return; if (gpuWanted() && !gpu) gpu = game.enableGPU({ map }); if (gpu) Object.assign(gpu, { map, enabled: gpuWanted(), bands: 24, wrap: .5 }); };\n  game.settings.define({ key: 'advLight', group: 'Adventure', label: 'Lighting', options: [['auto', 'Auto'], ['gpu', 'GPU'], ['fast', 'Fast']], value: 'auto', help: 'GPU: pools of light and shadows (slow on a phone). Fast: smooth on a phone. Auto: GPU on a computer, Fast on a phone', apply: () => { if (game.sceneName === 'adventure') lighting(); } });\n  addEventListener('keydown', e => { if (e.code !== 'KeyC' || e.repeat || game.sceneName !== 'adventure' || game.paused) return; const v = game.settings.advCamera === 'rooms' ? 'scroll' : 'rooms'; game.settings.set('advCamera', v); game.note('CAMERA: ' + v.toUpperCase()); });\n  const sliding = () => !!game.cam.room && game.cam.moving;   // a room slide holds the world still\n  const roomOf = x => Math.floor(x / ROOM[0]), mod = (a, n) => ((a % n) + n) % n, near = (cx, cy, tag) => map.floorAt((cx + .5) * T, (cy + .5) * T) === tag;\n  const txt = (g, s, x, y, c, o) => E.font.text(g, s, x, y, c, { shadow: '#07040c', outline: false, ...o });\n  const talkable = () => npcs.find(n => E.dist(hero, n) < 34);\n  // CONTACT SHADOWS: a darker core in a soft ellipse, cool purple\n  const shadow = (r, x, y, rad) => { r.shadow(x, y, rad, .28, '#2a2048'); r.shadow(x, y, rad * .6, .22, '#2a2048'); };\n\n  /* ---- FLOORS: floorTex(x, y, tag) = [r, g, b(, glow)], baked once per view ---- */\n  // AUTOTILING: distance to the nearest side bordering another floor, corners rounded by K\n  function edge(cx, cy, lx, ly, tag, K) {\n    const o = (dx, dy) => { const t = map.floorAt((cx + dx + .5) * T, (cy + dy + .5) * T), c = map.cell(cx + dx, cy + dy); return tag === 'water' ? t !== tag && t !== 'bridge' && !c : t !== tag || c !== 0; };\n    const a = Math.min(o(-1, 0) ? lx : 99, o(1, 0) ? T - lx : 99), b = Math.min(o(0, -1) ? ly : 99, o(0, 1) ? T - ly : 99);\n    return a < K && b < K ? K - Math.hypot(K - a, K - b) : Math.min(a, b);\n  }\n  // GRASS: TUFT and BLOOM stamps on a staggered lattice in SCREEN pixels\n  function grass(sx, sy, G) {\n    const row = Math.floor(sy / 7), X = sx + (row & 1) * 6, k = E.hash2(Math.floor(X / 12), row), pat = k < .07 ? BLOOM : k < .62 ? TUFT : null;\n    const ch = pat && (pat[mod(Math.floor(sy), 7) - 2] || '')[mod(Math.floor(X), 12) - (pat === BLOOM ? 5 : 4)];\n    return ch === 'l' ? G[3] : ch === 'd' ? G[1] : ch === 'y' ? PETAL[1] : ch === 'w' ? PETAL[k < .035 ? 0 : 2] : G[2];\n  }\n  function ground(x, y, tag) {\n    const cx = Math.floor(x / T), cy = Math.floor(y / T), lx = x - cx * T, ly = y - cy * T, room = roomOf(x), [sx, sy] = game.view.p(x, y), h = E.hash2(cx, cy);\n    const e = tag && tag !== 'carpet' ? edge(cx, cy, lx, ly, tag, tag === 'water' ? 7 : tag === 'pave' ? 1 : 4) : 99;\n    if (e < 0) tag = null;   // outside a rounded corner\n    // WATER: bank, lip, shadow, reflection, foam, then depth BANDS bent by value noise\n    if (tag === 'water') {\n      if (e < 2.6) return e < 1 ? STONE[0] : E.hash2(Math.floor(y / 3), cx) < .2 ? STONE[1] : STONE[e < 1.8 ? 4 : 3];\n      const w = (E.noise2(x / 6, y / 9) - .5) * 5, foam = near(cx, cy - 1, 'bridge') ? ly : near(cx, cy + 1, 'bridge') ? T - ly : 99;\n      if (e < 3.3 || foam < 3 + w + E.hash2(Math.floor(sx / 2), 1) * 2) return foam < 1.5 + w ? SKY[1] : WATER[4];\n      if (!near(cx - 1, cy, 'water') && lx < 6 + w) return WATER[0];\n      if (map.cell(cx + 1, cy) > 0 && lx > 11 + w) return REFLECT;\n      const px_ = lx - 4 - h * 8, py_ = ly - 4 - h * 7, pad = Math.hypot(px_, py_);\n      if (h < .3 && pad < 3) return LILY[pad < 1 ? 4 : px_ > .5 && Math.abs(py_) < .5 ? 1 : 2];\n      const k = mod(Math.floor(sx) + Math.floor(sy / 6) * 7, 23);   // sky glints on every 6th row\n      return mod(Math.floor(sy), 6) === 0 && k < 4 ? SKY[k ? 0 : 1] : WATER[e + w < 8 ? 3 : e + w < 12 ? 2 : 1];\n    }\n    if (tag === 'bridge') return (ly < 2 && !near(cx, cy - 1, tag)) || (ly > T - 2 && !near(cx, cy + 1, tag)) ? DIRT[0] : E.tex.planks(y, x, { base: '#b07c44', dark: '#8a5c32', line: '#4a2e1a' });\n    // path and paving: grass erodes the edge by a hash; dirt, pebbles\n    const q = E.hash2(Math.floor(sx / 6), Math.floor(sy / 5)), b = E.hash2(Math.floor(x / 4), Math.floor(y / 4)) * 3;\n88:- 1184 21d. Shell; E.Shell: shell\n427:- `r.groundRing(x, y, rad, color, alpha = 1, z = 0)`: a ring lying on the ground (radius in world units)\n501:- `game.resetCamera()` †: undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1 without), no turn. The player's zoom stays (settings.zoom) [... omitted end of long line]\n514:- `game.start({ camera })`: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, o [... omitted end of long line]\n555:- `game.shell = null` †: the E.Shell over this game (an HTML interface: screens and HUD), or null\n637:- `saves.show(mode = 'load', done)` †: open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or a save. False without a menu (a headless game,  [... omitted end of long line]\n679:- `E.Humanoid.pose(id, fn)` †: a held pose of the game's own: fn(J, w, rig) moves the joints (the rig's frame: forward, right, up) toward the pose by w, 0..1, which eases in and out as state.pose name [... omitted end of long line]\n680:- `E.Humanoid.poses` †: the held poses of a game's own, by id (the built-in poses are the rig's own solve: state.pose names either)\n693:- `rig.update(dt, s = {})`: s: { x, y, z, vx, vy, facing, dash, hurt, attack, air, point } air: true while jumping or falling (legs tuck), point: true to hold the weapon hand forward (aiming a gun) at [... omitted end of long line]\n1114:- `E.addAssets(set)`: register a store set (src/assets/sets/*.js: { set, format: 1, credit, sources, materials, shapes, sprites }): its entries are named 'SET:id' (so one set never changes another's,  [... omitted end of long line]\n1184:## 21d. Shell\n1186:- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HT [... omitted end of long line]\n1187:- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) f [... omitted end of long line]\n1188:- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n1189:- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard [... omitted end of long line]\n1190:- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\n1191:- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\n1628:- `world.shellMap()`: the explored map for E.Shell's minimap: game.shell.hud({ minimap: world.shellMap() }) (a cell a square, the save and boss rooms marked, the hero's cell)\n1718:- `strategy.minimap(colors = {})` †: E.Shell's minimap spec: the map, the fog, the camera's view, the units seen as dots by side, a click moving the camera\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"agent_message","text":"I’ve inspected the scanned art and gameplay pages. The game’s visual direction will pair warm gold treasure with four distinct labyrinth palettes. The architecture will keep simulation separate from rendering so the companion, headless tests, and Hub host all use the same rules.\n"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"sed -n '1184,1238p' vendor/engine/API-INDEX.md && rg -n 'buttons:|rows:|ui.show|shell.show|type: .slider|settings.define|new E.Shell|PadAxis|input.bind' vendor/engine/kits/adventure.js vendor/engine/API-INDEX.md | head -80 && sed -n '1,95p' vendor/engine/game/test.mjs && sed -n '1,50p' vendor/engine/tools/asset-sheet.mjs && rg -n 'case .|scenario|setTimeout|check|players=' vendor/hub/harness.html | tail -55\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"sed -n '1184,1238p' vendor/engine/API-INDEX.md && rg -n 'buttons:|rows:|ui.show|shell.show|type: .slider|settings.define|new E.Shell|PadAxis|input.bind' vendor/engine/kits/adventure.js vendor/engine/API-INDEX.md | head -80 && sed -n '1,95p' vendor/engine/game/test.mjs && sed -n '1,50p' vendor/engine/tools/asset-sheet.mjs && rg -n 'case .|scenario|setTimeout|check|players=' vendor/hub/harness.html | tail -55\"","aggregated_output":"## 21d. Shell\n\n- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HTML interface over the game (see the section's header)\n- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by the window's width (14 px text at 875 px, up to 30 at 1,875)\n- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard ones)\n- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\n- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\n- `shell.back()` †: what cancel does: the screen's own back(), or close it (back to the screen under it; closing the pause screen resumes)\n- `shell.dispose()` †: take its elements away and let go of the game (game.dispose() does it)\n- `shell.hide()` †: close every screen (and resume, when the menu paused the game)\n- `shell.hud(st = {})` †: the HUD, from this step's state (call it every step; a piece left out is hidden, and only what changed is redrawn)\n- `shell.hud({ objective })` †: { step: '01 / 04', title, text, at: { x, y, z }, from: hero } (the distance in meters, and above or below)\n- `shell.hud({ status, place, tip })` †: status: 'UNSEEN' or { text, color }; place: 'The Old Harbour'; tip: 'text' or { title, text }\n- `shell.hud({ bars, counts })` †: bars: [{ label, value, max, kind: 'bar' | 'pips', color }] (health, stamina, a meter); counts: [[label, value]]\n- `shell.hud({ prompt })` †: { key: 'E' (or act: 'interact': its key on the player's device), label, hint, progress: 0..1 }\n- `shell.hud({ keys, buttons })` †: keys: [['WASD', 'Move'], ...] (hidden on touch screens); buttons: [[label, fn or action]] (top right: pause and map where there is no Escape key)\n- `shell.hud({ minimap })` †: { map, at (with facing), markers: [{ x, y, kind: 'dot' | 'diamond' | 'ring' | 'cross', color }], onClick(x, y) (the world point clicked), fog (an E.Fog: unseen cells black, seen ones dim), camera: true (the ground the screen shows) }\n- `shell.screen` †: the name of the open screen ('pause', 'settings', 'controls', ...), or null while the game plays\n- `shell.settings` †: the player's settings: game.settings (the standard ones and the game's own, by key)\n- `shell.show(name, spec = {})` †: open a screen: 'title' | 'pause' | 'settings' | 'help' | 'results' | 'map' or a name of your own, from spec over o.screens[name]. A spec: { kicker, title, text (strings or functions), actions: [[label, fn] or { label, fn, act, primary, disabled }], back (fn for cancel), rows: ['glyphs', 'invertY', '#A heading'] (settings' rows, changed as on the settings screen) }. From another screen it stacks (back() returns); shown again, it updates (the new spec over the old). 'settings' takes its items\n- `shell.show('title')` †: { name, subtitle, meta: [...], footer }\n- `shell.show('help')` †: { keys: [[key, what]], sections: [[heading, text]] }\n- `shell.show('results')` †: { emblem, stats: [[value, label]], medals: [[label, earned]] }\n- `shell.show('map')` †: { map, at, markers (a list or a function), labels: [[text, x, y]], onPick(x, y) }\n- `shell.toast(title, text = '', seconds = 4)` †: a message that slides in at the top for a few seconds\n- `shell.tutorial(title, text = '', seconds = 15)` †: a tutorial card (bottom left, dismissable) for some seconds; tutorial(null) takes it away\n- `shell.root = null` †: game: the game it is over; o: its options; root: its DOM element (null in a headless game)\n\n## 22. Gpu lighting (webgpu)\n\n- `game.gpu.active(view)` †: true when it lights frames in this view (ready, enabled and a ground view)\n- `game.gpu.snapshot()` †: offscreen mode only: read the last frame back as a PNG data URL\n- `game.gpu.status()` †: 'loading' | 'on' | 'off' | 'unavailable'\n- `game.gpu.adapterInfo` †: the GPU's description from the browser (vendor, architecture), or null\n- `game.gpu.ambient` †: the unlit color, [r, g, b] 0..1\n- `game.gpu.bands = 6` †: how many light bands (fewer is more retro)\n- `game.gpu.enabled = true` †: false switches it off for now (and the canvas lighting with it, unless game.lights.enabled)\n- `game.gpu.failed = null` †: why it couldn't start, or null\n- `game.gpu.fallback = true` †: false keeps a frame it can't draw unlit (by default the canvas lighting stands in, game.lights.on)\n- `game.gpu.glow = .22` †: the strength of px.glow surfaces\n- `game.gpu.map = null` †: the TileMap it measures walls on\n- `game.gpu.offscreen = false` †: render into a texture instead of the page (automated tests; read it with snapshot())\n- `game.gpu.onStatus = null` †: called (gpu) when its status changes\n- `game.gpu.ready = false` †: true once the GPU is set up\n- `game.gpu.shadows = true` †: casters block light\n- `game.gpu.skipped` †: never queue more than two frames: a slow GPU drops frames instead of building up lag\n- `game.gpu.spill = 1.1` †: how far light spills past its radius\n- `game.gpu.wrap = .45` †: how far light wraps round wall corners, 0..1\n\n## 23. Sessions\n\n- `E.session` †: records a play session on any device and replays it exactly (this section's header says how)\n- `E.session.frame` †: the frames run since the page loaded\n- `E.session.record(on)` †: turn recording on or off for the next page loads (each load is a session of its own)\nvendor/engine/kits/adventure.js:70:const MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\nvendor/engine/kits/adventure.js:299:  game.settings.define({ key: 'advCamera', group: 'Adventure', label: 'Camera', options: [['rooms', 'Rooms'], ['scroll', 'Scroll']], value: 'rooms', help: 'Rooms: screen by screen, as Zelda. Scroll: i [... omitted end of long line]\nvendor/engine/kits/adventure.js:305:  game.settings.define({ key: 'advLight', group: 'Adventure', label: 'Lighting', options: [['auto', 'Auto'], ['gpu', 'GPU'], ['fast', 'Fast']], value: 'auto', help: 'GPU: pools of light and shadows (s [... omitted end of long line]\nvendor/engine/kits/adventure.js:372:    map = new E.TileMap({ rows: ROWS, legend: LEGEND, types: TYPES, floorTex, ao: 8 });\nvendor/engine/API-INDEX.md:39:const E = My3D2dge, map = new E.TileMap({ rows: ['#######', '#.....#', '#..RR.#', '#######'], legend: { '#': 1, R: 2 }, types: { 1: { h: 80 }, 2: { h: 40 } } });\nvendor/engine/API-INDEX.md:278:- `input.bindButtons(root)` †: wire every element with data-act=\"<action>\" inside root to the action\nvendor/engine/API-INDEX.md:279:- `input.bindings` †: the player's bindings over the preset: { action: { keys: [codes], pad: [codes] } } (game.settings.bindings keeps them)\nvendor/engine/API-INDEX.md:322:- `input.value(a)` †: how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick's direction (PadAxisUp ..., or up / down / left / right on the  [... omitted end of long line]\nvendor/engine/API-INDEX.md:527:- `game.cam`: camera. smooth = seconds of lag; bounds(view) = clamp rect; room = [w, h] world units for screen-by-screen rooms; moving = sliding between rooms; offset = [dx, dy] screen pixels from the [... omitted end of long line]\nvendor/engine/API-INDEX.md:575:- `settings.define(sp)`: add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value, label]] or [value], help, group: 'Game', apply(game, value) }. Its  [... omitted end of long line]\nvendor/engine/API-INDEX.md:749:- `new E.TileMap(o = {}) → map`: Walls standing on a floor (top-down, isometric, brawler). Either { rows: [...ASCII...], legend: { '#': 1, '@': 'hero' }, types, floorTex } (recommended) or { w, h, cel [... omitted end of long line]\nvendor/engine/API-INDEX.md:806:- `map.spawns`: spawn points from the ASCII rows: { tag, ch, cx, cy, x, y, z } (x, y = cell center)\nvendor/engine/API-INDEX.md:863:- `new E.PlatformMap(o = {}) → level`: { rows: [...ASCII, top row first...], legend: { '#': 1, '@': 'hero' }, types: { 1: {...} }, tile: 16, depth: 16 }. Tile kinds: 'solid' (default) | 'oneway' | 'la [... omitted end of long line]\nvendor/engine/API-INDEX.md:1186:- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HT [... omitted end of long line]\nvendor/engine/API-INDEX.md:1187:- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) f [... omitted end of long line]\nvendor/engine/API-INDEX.md:1188:- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\nvendor/engine/API-INDEX.md:1189:- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard [... omitted end of long line]\nvendor/engine/API-INDEX.md:1190:- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\nvendor/engine/API-INDEX.md:1191:- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\nvendor/engine/API-INDEX.md:1200:- `shell.hud({ keys, buttons })` †: keys: [['WASD', 'Move'], ...] (hidden on touch screens); buttons: [[label, fn or action]] (top right: pause and map where there is no Escape key)\nvendor/engine/API-INDEX.md:1204:- `shell.show(name, spec = {})` †: open a screen: 'title' | 'pause' | 'settings' | 'help' | 'results' | 'map' or a name of your own, from spec over o.screens[name]. A spec: { kicker, title, text (stri [... omitted end of long line]\nvendor/engine/API-INDEX.md:1205:- `shell.show('title')` †: { name, subtitle, meta: [...], footer }\nvendor/engine/API-INDEX.md:1206:- `shell.show('help')` †: { keys: [[key, what]], sections: [[heading, text]] }\nvendor/engine/API-INDEX.md:1207:- `shell.show('results')` †: { emblem, stats: [[value, label]], medals: [[label, earned]] }\nvendor/engine/API-INDEX.md:1208:- `shell.show('map')` †: { map, at, markers (a list or a function), labels: [[text, x, y]], onPick(x, y) }\n// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n// Asset sheet: draws a shape the way a game will (the full engine, headless) and says what reads badly, so a model that\n// wrote an object can look at it before using it (docs/ASSETS.md, \"Make one\").\n//   node tools/asset-sheet.mjs barrel                     a core shape\n//   node tools/asset-sheet.mjs mine.js#stool              a file that sets E.SHAPES.stool, or a store set\n//                                                         ((window.ASSETS = window.ASSETS || {}).MINE = {...}, then 'stool'\n//                                                         finds MINE:stool)\n//   node tools/asset-sheet.mjs mine.js                    every shape the file adds\n//   [--out check-output/asset-sheet] [--zoom 3] [--json]  (--json prints the numbers and lints as JSON)\n//   node tools/asset-sheet.mjs src/assets/sets/kenney-furniture.js --grid\n//                                                         contact sheets of a whole set, 30 to a page, for curating it:\n//                                                         each entry in the isometric and three-quarter views (a sprite\n//                                                         as it is), with its id, parts and fit; and a page of the\n//                                                         set's materials, each with the entries that use it\n// Each sheet (a PNG per shape): every view (isometric, three-quarter, top-down as games draw it, brawler, side) and three\n// more facings, beside the hero, on a light and a dark floor, the contact shadow under it. The lints:\n//   small from above   under 30 pixels seen from the top-down view\n//   a part not seen    a part with no pixel in the isometric or the three-quarter view (under a pixel, or hidden)\n//   few tones          fewer than 4 colors in the isometric view (a flat-looking object)\n//   low contrast       its mean lightness within 12% of a floor's\n//   tokens             the entry as written, in cl100k tokens (exact)\n// Exit code 1 on an engine warning or a page error (an unknown material, a broken part).\nimport { chromium } from 'playwright';\nimport { readFileSync, writeFileSync, mkdirSync, existsSync } from 'node:fs';\nimport { join, dirname, resolve, basename } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { engineFile } from './asset-lib.mjs';\n\nconst root = join(dirname(fileURLToPath(import.meta.url)), '..'), args = process.argv.slice(2);\nconst opt = (k, d) => { const i = args.indexOf('--' + k); return i >= 0 ? args[i + 1] : d; };\nconst target = args.find((a, i) => !a.startsWith('--') && !(i && args[i - 1].startsWith('--') && !['--json'].includes(args[i - 1])));\nif (!target) { console.error('Usage: node tools/asset-sheet.mjs <id | file.js[#id]> [--out dir] [--zoom 3] [--json]'); process.exit(2); }\nconst out = resolve(opt('out', join(root, 'check-output/asset-sheet'))), zoom = +opt('zoom', 3), json = args.includes('--json');\nconst [file, want] = target.includes('.js') ? target.split('#') : [null, target];\nif (file && !existsSync(file)) { console.error('no such file: ' + file); process.exit(2); }\nconst src = file ? readFileSync(file, 'utf8') : null;\nlet tok = s => Math.ceil(s.length / 3.2); try { const { encode } = await import('gpt-tokenizer/encoding/cl100k_base'); tok = s => encode(s).length; } catch (e) { /* estimated */ }\n\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined });\nconst page = await browser.newPage(), problems = [];\npage.on('pageerror', e => problems.push(String(e))); page.on('console', m => { if ((m.type() === 'warning' || m.type() === 'error') && !/willReadFrequently/.test(m.text())) problems.push(m.text()); });   // (not Chromium's readback hint)\nawait page.setContent('<!doctype html><html><body></body></html>');\nawait page.addScriptTag({ content: readFileSync(engineFile, 'utf8') });   // (the repository's engine, or the handoff package's)\nconst before = await page.evaluate(() => Object.keys(My3D2dge.SHAPES));\nif (src) await page.addScriptTag({ content: src });\n// the shapes to draw: the file's sets (registered), the shapes it added to E.SHAPES, or the core id asked for\nconst ids = await page.evaluate(([before, want, own]) => {\n  const E = My3D2dge, added = [];\n  for (const set of Object.values(window.ASSETS || {})) added.push(...E.addAssets(set).shapes);\n  for (const k of Object.keys(E.SHAPES)) if (!before.includes(k) && !added.includes(k)) added.push(k);\n  if (!want) return added;\n32:  #checks li { list-style: none; }\n33:  #checks ul { margin: 0; padding: 0; }\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n383:const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n400:  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n405:  const checks = [];\n406:  const check = (name, pass, detail = '') => {\n407:    checks.push({ name, pass: !!pass, detail });\n408:    renderChecks(checks);\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n416:      check('game named', false, 'pass ?game=<path> of a page on this site');\n421:    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n424:    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n425:    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n430:    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n433:    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n434:    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n436:      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n442:    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n449:      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n453:    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n474:      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.A [... omitted end of long line]\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n483:        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n486:        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n489:      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n492:      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n502:      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n506:      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n508:      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n511:    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n513:    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n521:    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n523:    check('harness ran', false, String(error?.stack || error));\n525:    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n532:function renderChecks(checks) {\n533:  $('checklist').replaceChildren(\n534:    ...checks.map((c) => {\n","exit_code":0,"status":"completed"}}
