{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'NODE'\nimport {writeFileSync,mkdirSync} from 'node:fs';\nconst base='Much-Ado-About-Rings-SOURCE-gpt-6.1-sol-max-20261106-031651';\nconst jobs=[...['README.md','API.md','API-INDEX.md','docs/ASSETS.md','my-3d2dge.js','kits/adventure.js','src/assets/sets/adventure.js','tools/asset-sheet.mjs','tools/asset-lib.mjs','tools/check.mjs','tools/replay.mjs','game/game.js','game/test.mjs'].map(p=>['michaelcrosato/my-3d2dge','8ecc2f62353761187bdfe226f327b7ea5d2eb691','dist/handoff/'+p,base+'/vendor/engine/'+p]),...['README.md','session.js','harness.html','bridge.js','round.js'].map(p=>['michaelcrosato/ai-hub','35a1047f2067b2af3de3943f0fe452f39105d869','lib/hub/'+p,base+'/vendor/hub/'+p])];\nconst r=await Promise.allSettled(jobs.map(async([repo,rev,path,dest])=>{const res=await fetch(\"'`https://raw.githubusercontent.com/${repo}/${rev}/${path}`);if(!res.ok)throw Error(path+'\"': '+res.status);mkdirSync(dest.substring(0,dest.lastIndexOf('/')),{recursive:true});writeFileSync(dest,await res.text());return path}));\nfor(const j of r)if(j.status==='rejected')console.log(j.reason.message);\nconsole.log(r.filter(j=>j.status==='fulfilled').length+' dependency files saved');\nconst res=await fetch('https://odyssey2.info/library/manuals/us_questfortherings/Quest%20for%20the%20Rings%20%28USA%29.pdf');writeFileSync(base+'/docs/original-manual.pdf',Buffer.from(await res.arrayBuffer()));\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
