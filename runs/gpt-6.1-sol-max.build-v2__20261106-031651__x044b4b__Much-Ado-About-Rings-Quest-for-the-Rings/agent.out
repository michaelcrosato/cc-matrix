{"type":"item.started","item":{"id":"item_158","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport vm from 'node:vm';\nimport {readFileSync,writeFileSync,statSync} from 'node:fs';\nimport {createHash} from 'node:crypto';\nconst project=JSON.parse(readFileSync('project.json','utf8'));\nconst html=readFileSync('../'+project.base+'.html','utf8');\nconst interview=JSON.parse(readFileSync('../exit-interview.json','utf8'));\nconst result=JSON.parse(readFileSync('evidence/all-latest.json','utf8'));\nconst digest=createHash('sha256').update(html).digest('hex');\nfunction assert(ok,msg){if(\"'!ok)throw Error(msg)}\nassert(result.sourceHash===digest,'\"'Final HTML differs from tested file');\nassert(result.results.length===59&&result.results.every(r=>r.pass),'Final verification did not pass');\nassert(Object.keys(interview).join(',')==='sourceInformation,testingFeedback,engineFeedback,promptFeedback,aiHub','Interview shape');\nassert(interview.testingFeedback.length===4&&interview.engineFeedback.length===6&&interview.promptFeedback.length===4,'Feedback lengths');\nassert(Object.values(interview.sourceInformation).every(v=>typeof v==='string'&&v.length>0),'Empty source information');\nassert(interview.sourceInformation.usage==='added on import','Usage');\nassert(interview.aiHub.players==='1–2'&&interview.aiHub.genre==='Adventure'&&interview.aiHub.name===project.title,'Catalogue identity');\nassert(html.split('<script>')[1].split('</script>')[0]===readFileSync('vendor/hub/session.js','utf8'),'Hub client changed');\nassert(\"'!/<script'\"\\\\s+src=/i.test(html),'External script dependency');\nfor(const dep of JSON.parse(readFileSync('docs/dependencies.json','utf8')))assert(createHash('sha256').update(readFileSync(dep.path)).digest('hex')===dep.sha256,'Vendor changed: '+dep.path);\nconst context={console:{log(){},warn(){},error(){}}};vm.createContext(context);\nfor(const f of ['vendor/engine/my-3d2dge.js','src/content/content.js'])vm.runInContext(readFileSync(f,'utf8'),context);\nwriteFileSync('docs/content-manifest.json',JSON.stringify({title:project.title,sites:context.MA.SITES,rooms:Object.values(context.MA.ROOMS)},null,2)+'\\\\n');\nconst report={title:project.title,deliverable:project.base+'.html',bytes:statSync('../'+project.base+'.html').size,sha256:digest,checks:result.results.length,passed:result.results.length,failed:0,engine:project.engineCommit,hub:project.hubCommit,externalRuntimeDependencies:[],feedback:{gameFindings:25,critical:2},interviewValid:true,vendorChecksumsValid:true};\nwriteFileSync('docs/final-acceptance.json',JSON.stringify(report,null,2)+'\\\\n');\nconsole.log(JSON.stringify({checks:report.checks,passed:report.passed,bytes:report.bytes,interviewValid:report.interviewValid,vendorChecksumsValid:report.vendorChecksumsValid}));\nJS\npython3 - <<'PY'\nimport json\nimport os\nfrom pathlib import Path\ncurrent=Path.cwd().resolve()\nowned=[]\nfor entry in Path('/proc').iterdir():\n    if not entry.name.isdigit() or int(entry.name) in [os.getpid(),os.getppid()]:\n        continue\n    try:\n        if (entry/'cwd').resolve()\"'!=current:\n            continue\n        args=(entry/'\"'cmdline').read_bytes().replace(b'\\\\0',b' ').decode(errors='replace')\n        if 'tests/browser.py' in args or 'node tools/test.mjs' in args or 'headless_shell' in args or 'chrome-headless-shell' in args:\n            owned.append({'pid':int(entry.name),'command':args[:200]})\n    except (OSError,PermissionError):\n        pass\nPath('evidence/process-cleanup.json').write_text(json.dumps({'remainingTaskTestProcesses':owned},indent=2)+'\\\\n')\nprint(json.dumps({'remainingTaskTestProcesses':owned}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
