*= 0.4;\n  return { steer, throttle, brake, abs: true, auto: true, tcs: 0, steerRate: 6 };\n}\n'''\ns=s.replace(old,new)\nopen(p,'w').write(s)\nEOF\nnode simtest.mjs; node simdebug.mjs | sed -n 1,30p | cut -c1-120","description":"Add yaw-rate damping to the AI driver and rerun laps","timeout":60000}},"wire_ingest_context":{"toolu_01Bqm2ocMiHQeDEkiyv945p3":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261105-162057__x4c6ec5/work/_research/tools"}}}
