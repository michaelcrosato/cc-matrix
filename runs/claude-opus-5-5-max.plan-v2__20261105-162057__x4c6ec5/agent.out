21, corners: [\n    [420, 0, 18, 0, 12, 0], [420, 190, 16, 0, 11, 0], [620, 190, 16, 1, 11, 0], [620, 400, 20, 2, 11, 0], [470, 520, 40, 3, 11, 0], [470, 660, 16, 3, 11, 0],\n    [210, 660, 30, 2, 11, 0], [170, 610, 24, 2, 11, 0], [110, 660, 30, 2, 11, 0], [-60, 660, 16, 1, 11, 0], [-60, 420, 18, 1, 11, 0], [-190, 420, 16, 0, 11, 0],\n    [-190, 200, 22, 0, 11, 0], [-300, 110, 30, 0, 11, 0], [-300, 0, 18, 0, 12, 0] ] },\n  saltline: { name: 'Saltline Speedbowl', surface: 'asphalt', edge: 'apron', runoff: 3, hour: 18.5, corners: [\n    [632, 0, 215, 0, 18, 16], [0, 1095, 215, 0, 18, 16], [-632, 0, 215, 0, 18, 16] ] },\n  redclay: { name: 'Red Clay Stage', surface: 'dirt', edge: 'gravel', runoff: 4, hour: 17, crests: [[420, 36, 2.6], [1660, 30, 2]], corners: [\n    [240, 0, 40, 0, 9, 0], [300, 160, 25, 4, 9, 0], [170, 260, 30, 8, 9, 0], [280, 400, 20, 12, 9, 0], [120, 470, 16, 16, 9, 0], [0, 360, 30, 14, 9, 0],\n    [-120, 470, 20, 18, 9, 0], [-300, 380, 35, 20, 9, 0], [-220, 220, 18, 14, 9, 0], [-380, 120, 30, 8, 9, 0], [-300, -40, 35, 4, 9, 0], [-60, -60, 40, 1, 9, 0] ] },\n  proving: { name: 'Proving Ground', surface: 'asphalt', edge: 'apron', runoff: 14, hour: 11, corners: [\n    [1040, 0, 80, 0, 28, 0], [1040, 240, 80, 0, 16, 0], [800, 240, 40, 0, 14, 0], [720, 150, 30, 0, 14, 0], [600, 240, 30, 0, 14, 0], [480, 150, 30, 0, 14, 0], [360, 240, 40, 0, 14, 0],\n    [200, 240, 22, 0, 14, 0], [200, 130, 22, 0, 14, 0], [40, 130, 22, 0, 14, 0], [40, 240, 22, 0, 14, 0], [-160, 240, 80, 0, 16, 0], [-160, 0, 80, 0, 28, 0] ] },\n};\nEOF\ncat > regress.mjs <<'EOF'\n// The numbers the plan quotes: spec sheet, 97% lap table, keyboard-style driver check, tyre and fuel run.\nimport { buildTrack, racingLine, speedProfile, carParams, newCar, stepCar, collideCars, aiDrive, G } from './sim.mjs';\nimport { TRACKS } from './tracks.data.mjs';\nimport { CARS } from './carsdata.mjs';\nconst T = {}, L = {}; for (const k in TRACKS) { T[k] = buildTrack(TRACKS[k]); L[k] = racingLine(T[k]); }\nconsole.log('lengths', Object.keys(T).map((k) => `${k} ${T[k].length.toFixed(0)}`).join(', '));\nconst flat = (() => { const n = 60000, A = () => new Float64Array(n); const t = { N: n, ds: 4, length: n * 4, x: A(), z: A(), y: A(), width: A().fill(60), bank: A(), tx: A(), tz: A().fill(1), kappa: A(), slope: A(), wallL: A().fill(50), wallR: A().fill(50), surface: 'asphalt', edge: 'apron' }; for (let i = 0; i < n; i++) t.z[i] = i * 4; return t; })();\nconsole.log('SPEC id 0-100 0-200 topspeed brake100');\nfor (const [id, d] of Object.entries(CARS)) {\n  const p = carParams(d), c = newCar(p, flat, 25); let t = 0, a = null, b = null, v = 0;\n  while (t < 70) { stepCar(c, { steer: 0, throttle: 1, brake: 0, abs: true, tcs: 0.5, asm: 0 }, 1 / 240, flat); t += 1 / 240; const k = c.u * 3.6; if (!a && k >= 100) a = t; if (!b && k >= 200) b = t; v = Math.max(v, k); c.fuel = 1; }\n  c.vx = 0; c.vz = 100 / 3.6; c.yaw = 0; c.gear = 2; const z0 = c.z; let tb = 0; while (c.u > 0.5 && tb < 15) { stepCar(c, { steer: 0, throttle: 0, brake: 1, abs: true }, 1 / 240, flat); tb += 1 / 240; }\n  console.log(id.padEnd(9), a?.toFixed(1), b?.toFixed(1) ?? '-', v.toFixed(0), (c.z - z0).toFixed(0));\n}\nconsole.log('LAPS at 97%: ' + Object.keys(T).join(' '));\nfor (const [id, d] of Object.entries(CARS)) {\n  const row = []; for (const k in T) {\n    const tr = T[k], p = carParams(d), c = newCar(p, tr), surf = tr.surface === 'dirt' ? (p.tyreTable?.dirt ?? 0.62) : 1, sp = speedProfile(tr, L[k], p, surf);\n    let t = 0, laps = [], last = 0, st = 0, ls = 0, resets = 0;\n    while (laps.length < 2 && t < 500) { const inp = aiDrive(c, tr, L[k], sp, { skill: 0.97 }); for (let i = 0; i < 4; i++) { stepCar(c, inp, 1 / 240, tr, { wearRate: 0, fuelRate: 0 }); t += 1 / 240; }\n      if (Math.hypot(c.vx, c.vz) < 2) { st += 1 / 60; if (st > 3) { c.x = L[k].px[c.loc.i]; c.z = L[k].pz[c.loc.i]; c.yaw = Math.atan2(tr.tx[c.loc.i], tr.tz[c.loc.i]); c.vx = c.vz = c.r = 0; st = 0; resets++; } } else st = 0;\n      if (last > tr.length * 0.9 && c.loc.s < tr.length * 0.1) { laps.push(t - ls); ls = t; } last = c.loc.s; }\n    row.push((laps[1]?.toFixed(0) ?? 'DNF') + (resets ? '!' : ''));\n  }\n  console.log(id.padEnd(9), row.join(' '));\n}\nconsole.log('KEYBOARD driver: digital steer through the filter, digital throttle and brake, default assists, 90% pace');\nfor (const [id, k] of [['pico', 'kestrel'], ['kite', 'cedar'], ['ginga', 'kestrel'], ['ryu', 'harbour'], ['longhorn', 'kestrel'], ['heck', 'cedar'], ['libeccio', 'harbour'], ['works', 'cedar'], ['type9', 'kestrel'], ['ryuRally', 'redclay']]) {\n  const tr = T[k], p = carParams(CARS[id]), c = newCar(p, tr), surf = tr.surface === 'dirt' ? (p.tyreTable?.dirt ?? 0.62) : 1, sp = speedProfile(tr, L[k], p, surf);\n  let t = 0, laps = [], last = 0, st = 0, ls = 0, resets = 0, kb = 0;\n  while (laps.length < 2 && t < 500) {\n    const a = aiDrive(c, tr, L[k], sp, { skill: 0.9 }), target = a.steer > 0.2 ? 1 : a.steer < -0.2 ? -1 : 0, rate = (target === 0 ? 6 : 3.2) / 60;\n    kb += Math.max(-rate, Math.min(rate, target - kb));\n    const inp = { steer: kb, throttle: a.throttle > 0 ? 1 : 0, brake: a.brake > 0.05 ? 1 : 0, abs: true, tcs: 0.5, asm: 0.5, auto: true, steerRate: 3 };\n    for (let i = 0; i < 4; i++) { stepCar(c, inp, 1 / 240, tr, { wearRate: 0, fuelRate: 0 }); t += 1 / 240; }\n    if (Math.hypot(c.vx, c.vz) < 2) { st += 1 / 60; if (st > 3) { c.x = L[k].px[c.loc.i]; c.z = L[k].pz[c.loc.i]; c.yaw = Math.atan2(tr.tx[c.loc.i], tr.tz[c.loc.i]); c.vx = c.vz = c.r = 0; st = 0; resets++; } } else st = 0;\n    if (last > tr.length * 0.9 && c.loc.s < tr.length * 0.1) { laps.push(t - ls); ls = t; } last = c.loc.s;\n  }\n  console.log(' ', id.padEnd(9), k.padEnd(8), 'lap', laps[1]?.toFixed(0) ?? 'DNF', 'resets', resets, 'wall', c.wallHits);\n}\nEOF\ntimeout 250 node regress.mjs 2>&1 | cut -c1-120; wc -c sim.mjs tracks.data.mjs carsdata.mjs; wc -l sim.mjs","description":"Run regression numbers for the plan including a keyboard-styl