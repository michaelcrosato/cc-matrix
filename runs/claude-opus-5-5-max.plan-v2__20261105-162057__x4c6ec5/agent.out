{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgke5KJ246JaW5VpcxZxM","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DuF6LQCVRZYUYraeDMd5cc","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261105-162057__x4c6ec5/work/_research/hub/examples/ghost.html","offset":510,"limit":340},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15535,"cache_read_input_tokens":82020,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15535},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"66624378-a7bb-42a2-8c1d-fc63666b5654","uuid":"e4168307-5405-4bac-a901-58f7b6c8b872","timestamp":"2026-11-05T23:21:39.307Z","request_id":"req_011Cgke5K581nPkhF5WCC173","wire_tool_inputs":{"toolu_01DuF6LQCVRZYUYraeDMd5cc":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261105-162057__x4c6ec5/work/_research/hub/examples/ghost.html","offset":510,"limit":340}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DuF6LQCVRZYUYraeDMd5cc","type":"tool_result","content":"510\t</script>\n511\t</head>\n512\t<body>\n513\t<canvas id=\"c\" aria-label=\"Comet Dash\"></canvas>\n514\t<script>\n515\t'use strict';\n516\t// Comet Dash: the smallest honest ghost game. Every copy runs its own comet\n517\t// down the same course (built from the session seed), sends its comet and the\n518\t// area it is in ten times a second, and draws the others as ghosts while they\n519\t// are in its area. Each copy reports its own progress and result; the hub ranks\n520\t// them.\n521\tconst W = 600, H = 800, LENGTH = 9000, SPEED = 330, R = 14, ROW = 260;\n522\tconst canvas = document.getElementById('c');\n523\tconst ctx = canvas.getContext('2d');\n524\tconst keys = new Set();\n525\tlet pointerX = null;\n526\tlet audio = null;\n527\t\n528\taddEventListener('keydown', (e) => {\n529\t  if (e.key === 'Escape') return toggleMenu();\n530\t  if (menu.open) return menuKey(e.key);\n531\t  keys.add(e.key.toLowerCase());\n532\t  gesture();\n533\t});\n534\taddEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));\n535\t\n536\t// ---- the controller, in the browser's standard mapping (a PS5 DualSense:\n537\t// Cross 0, Circle 1, Create 8, Options 9, D-pad 12-15, left stick axis 0).\n538\t// Buttons count on the frame they go down.\n539\tconst PAD = { cross: 0, circle: 1, create: 8, options: 9, up: 12, down: 13, left: 14, right: 15 };\n540\tlet pad = null, padNow = [], padWas = [];\n541\tfunction readPad() {\n542\t  pad = navigator.getGamepads ? [...navigator.getGamepads()].find((p) => p && p.connected) || null : null;\n543\t  padWas = padNow;\n544\t  padNow = pad ? pad.buttons.map((b) => b.pressed) : [];\n545\t  // Create + Options is the hub's: it opens the hub's corner bar, so Options alone opens the menu.\n546\t  if (pressed(PAD.options) && !padNow[PAD.create]) return toggleMenu();\n547\t  if (menu.open) {\n548\t    if (pressed(PAD.up)) menuKey('ArrowUp');\n549\t    if (pressed(PAD.down)) menuKey('ArrowDown');\n550\t    if (pressed(PAD.cross)) menuKey('Enter');\n551\t    if (pressed(PAD.circle)) toggleMenu();\n552\t  } else if (padNow.some((b, i) => b && !padWas[i] && i !== PAD.create && i !== PAD.options)) gesture();\n553\t}\n554\tconst pressed = (b) => !!padNow[b] && !padWas[b];\n555\t\n556\t// ---- the settings menu: Esc or Options, over the running race. It never\n557\t// pauses anything; while it is open your comet just flies straight.\n558\tlet muted = false;\n559\tconst menu = {\n560\t  open: false,\n561\t  at: 0,\n562\t  items: [\n563\t    { label: () => `Sound: ${muted ? 'off' : 'on'}`, act: () => { muted = !muted; } },\n564\t    { label: () => 'Back to the race', act: () => toggleMenu() },\n565\t  ],\n566\t};\n567\tfunction toggleMenu() { menu.open = !menu.open; menu.at = 0; keys.clear(); }\n568\tfunction menuKey(key) {\n569\t  if (key === 'ArrowUp' || key === 'w') menu.at = (menu.at + menu.items.length - 1) % menu.items.length;\n570\t  if (key === 'ArrowDown' || key === 's') menu.at = (menu.at + 1) % menu.items.length;\n571\t  if (key === 'Enter' || key === ' ') menu.items[menu.at].act();\n572\t}\n573\tcanvas.addEventListener('pointerdown', (e) => { pointerX = e.clientX; gesture(); });\n574\tcanvas.addEventListener('pointermove', (e) => { if (pointerX !== null) pointerX = e.clientX; });\n575\taddEventListener('pointerup', () => { pointerX = null; });\n576\t\n577\tfunction beep(freq) {\n578\t  if (!audio || muted) return;\n579\t  const o = audio.createOscillator(), g = audio.createGain();\n580\t  o.frequency.value = freq; g.gain.value = 0.05;\n581\t  o.connect(g).connect(audio.destination);\n582\t  o.start(); o.stop(audio.currentTime + 0.1);\n583\t}\n584\t\n585\t/** Rocks in rows, the same on every device: built only from integers off the seeded generator. */\n586\tfunction course(rng) {\n587\t  const rocks = [];\n588\t  for (let y = 600; y < LENGTH - 200; y += ROW) {\n589\t    const gaps = 1 + Math.floor(rng() * 2);\n590\t    const lanes = [0, 1, 2, 3, 4];\n591\t    for (let i = 0; i < gaps; i++) lanes.splice(Math.floor(rng() * lanes.length), 1);\n592\t    for (const lane of lanes) if (rng() < 0.7) rocks.push({ x: 60 + lane * 120, y });\n593\t  }\n594\t  return rocks;\n595\t}\n596\t\n597\tconst run = {\n598\t  phase: 'title',     // title | waiting | racing | done | over\n599\t  x: W / 2, d: 0, stun: 0,\n600\t  rocks: course(Math.random),\n601\t  finishedAt: null,\n602\t  message: 'Comet Dash — press any key or tap to race',\n603\t};\n604\tconst ghosts = new Map();   // id -> {x, d, area, name, color, done}\n605\t/** The whole course is one area, so every ghost on it is in view. */\n606\tconst AREA = 'course';\n607\tlet hub = null;\n608\tlet soloStart = 0;\n609\tlet lastSent = 0;\n610\tlet felt = 0;    // the local steering as last read\n611\tlet boost = false;   // Space or Cross held: a little faster\n612\t\n613\tfunction steer() {\n614\t  if (menu.open) return 0;\n615\t  let x = 0;\n616\t  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n617\t  if (keys.has('arrowright') || keys.has('d')) x += 1;\n618\t  if (pad && Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n619\t  if (padNow[PAD.left]) x = -1;\n620\t  if (padNow[PAD.right]) x = 1;\n621\t  if (pointerX !== null) {\n622\t    const r = canvas.getBoundingClientRect();\n623\t    const target = ((pointerX - r.left) / r.width) * W;\n624\t    x = Math.max(-1, Math.min(1, (target - run.x) / 40));\n625\t  }\n626\t  return x;\n627\t}\n628\t\n629\tasync function connect() {\n630\t  const info = await AIHub.connect({ mode: 'ghost', seats: [2, 4] });\n631\t  if (!info) return;\n632\t  hub = info;\n633\t  run.rocks = course(AIHub.rng('course'));\n634\t  for (const p of info.players) if (p.id !== info.me) ghosts.set(p.id, { ...p, x: W / 2, d: 0, done: null });\n635\t  // The hub's card collects everyone's ready: ready up as soon as the course is built.\n636\t  run.phase = 'waiting';\n637\t  run.message = 'Get ready…';\n638\t  AIHub.ready();\n639\t  AIHub.on('start', () => { run.phase = 'racing'; unlockAudio(); });\n640\t  AIHub.on('message', (data, from) => {\n641\t    const g = ghosts.get(from);\n642\t    if (!g) return;\n643\t    if (data.t === 'g') { g.tx = data.x; g.td = data.d; g.area = data.area; }\n644\t    if (data.t === 'done') { g.done = data.time; beep(330); }\n645\t  });\n646\t  AIHub.on('leave', ({ id }) => ghosts.delete(id));\n647\t  AIHub.on('time-up', () => {\n648\t    if (run.phase === 'racing') AIHub.result({ score: Math.floor(run.d) });\n649\t  });\n650\t  AIHub.on('end', ({ reason, standings }) => {\n651\t    run.phase = 'over';\n652\t    run.standings = standings;\n653\t    run.message = reason === 'finished' ? 'Race over' : reason === 'sat-out' ? 'You sat this one out' : 'Race cancelled';\n654\t  });\n655\t}\n656\t\n657\tfunction unlockAudio() {\n658\t  if (!audio) {\n659\t    try { audio = new AudioContext(); } catch { audio = null; }\n660\t  }\n661\t  audio?.resume?.().catch(() => {});\n662\t}\n663\t\n664\tfunction gesture() {\n665\t  unlockAudio();\n666\t  if (!hub && (run.phase === 'title' || run.phase === 'over')) {\n667\t    Object.assign(run, { phase: 'racing', x: W / 2, d: 0, stun: 0, rocks: course(Math.random), finishedAt: null });\n668\t    soloStart = performance.now();\n669\t  }\n670\t}\n671\t\n672\t/** Race time: the hub's shared clock in a session, the local one alone. */\n673\tconst raceTime = () => (hub ? AIHub.time() : performance.now() - soloStart);\n674\t\n675\tlet last = performance.now();\n676\tfunction frame(now) {\n677\t  const dt = Math.min((now - last) / 1000, 0.25);\n678\t  last = now;\n679\t  readPad();\n680\t  felt = steer();\n681\t  boost = !menu.open && (keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7]);\n682\t  if (run.phase === 'racing' && raceTime() >= 0) {\n683\t    run.x = Math.max(R + 20, Math.min(W - R - 20, run.x + felt * 320 * dt));\n684\t    if (run.stun > 0) run.stun -= dt;\n685\t    else run.d += SPEED * (boost ? 1.3 : 1) * dt;\n686\t    for (const rock of run.rocks) {\n687\t      if (Math.abs(rock.y - run.d) < 18 && Math.abs(rock.x - run.x) < 40 && run.stun <= 0) {\n688\t        run.stun = 0.7; run.d -= 20; beep(140);\n689\t      }\n690\t    }\n691\t    if (run.d >= LENGTH) {\n692\t      run.d = LENGTH;\n693\t      run.finishedAt = Math.round(raceTime());\n694\t      run.phase = 'done';\n695\t      run.message = `Finished in ${(run.finishedAt / 1000).toFixed(2)} s`;\n696\t      beep(880);\n697\t      if (hub) {\n698\t        AIHub.result({ time: run.finishedAt });\n699\t        AIHub.send({ t: 'done', time: run.finishedAt });\n700\t        run.message += ' — waiting for the others';\n701\t      }\n702\t    }\n703\t  }\n704\t  if (hub && (run.phase === 'racing' || run.phase === 'done') && now - lastSent > 100) {\n705\t    lastSent = now;\n706\t    AIHub.send({ t: 'g', area: AREA, x: Math.round(run.x), d: Math.round(run.d) }, { reliable: false });\n707\t    if (run.phase === 'racing') AIHub.progress({ score: Math.round(run.d), label: `${Math.round((run.d / LENGTH) * 100)}% of the course` });\n708\t  }\n709\t  for (const g of ghosts.values()) if (g.tx !== undefined) {\n710\t    const k = 1 - Math.pow(0.002, dt);\n711\t    g.x += (g.tx - g.x) * k; g.d += (g.td - g.d) * k;\n712\t  }\n713\t  draw();\n714\t  requestAnimationFrame(frame);\n715\t}\n716\t\n717\tfunction draw() {\n718\t  const r = canvas.getBoundingClientRect();\n719\t  const dpr = devicePixelRatio || 1;\n720\t  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n721\t    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n722\t  }\n723\t  const s = Math.min(canvas.width / W, canvas.height / H);\n724\t  ctx.setTransform(1, 0, 0, 1, 0, 0);\n725\t  ctx.fillStyle = '#081120'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n726\t  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n727\t  ctx.fillStyle = '#0f1b2e'; ctx.fillRect(0, 0, W, H);\n728\t\n729\t  const screenY = (d) => H - 160 - (d - run.d);\n730\t  ctx.fillStyle = '#5b6b86';\n731\t  for (const rock of run.rocks) {\n732\t    const y = screenY(rock.y);\n733\t    if (y > -40 && y < H + 40) ctx.fillRect(rock.x - 34, y - 12, 68, 24);\n734\t  }\n735\t  const fy = screenY(LENGTH);\n736\t  if (fy > -10 && fy < H) { ctx.fillStyle = '#eef3fb'; ctx.fillRect(0, fy - 3, W, 6); }\n737\t\n738\t  ctx.textAlign = 'center';\n739\t  ctx.font = '13px system-ui';\n740\t  for (const g of ghosts.values()) {\n741\t    if (g.area !== AREA) continue;\n742\t    const y = screenY(g.d);\n743\t    ctx.globalAlpha = 0.45;\n744\t    ctx.fillStyle = g.color;\n745\t    ctx.beginPath(); ctx.arc(g.x, Math.max(20, Math.min(H - 20, y)), R, 0, Math.PI * 2); ctx.fill();\n746\t    ctx.globalAlpha = 1;\n747\t    ctx.fillText(g.name, g.x, Math.max(20, Math.min(H - 20, y)) - R - 6);\n748\t  }\n749\t  const mine = hub ? hub.players.find((p) => p.id === hub.me) : null;\n750\t  ctx.fillStyle = run.stun > 0 ? '#ffffff' : (mine?.color || '#f5b700');\n751\t  ctx.beginPath(); ctx.arc(run.x, H - 160, R, 0, Math.PI * 2); ctx.fill();\n752\t\n753\t  // progress strip: everyone's distance down the course\n754\t  const bar = (d, color) => { ctx.fillStyle = color; ctx.fillRect(W - 14, H - 20 - (H - 40) * Math.min(1, d / LENGTH), 10, 4); };\n755\t  ctx.fillStyle = '#1d2c45'; ctx.fillRect(W - 14, 20, 10, H - 40);\n756\t  for (const g of ghosts.values()) bar(g.d, g.color);\n757\t  bar(run.d, mine?.color || '#f5b700');\n758\t\n759\t  ctx.fillStyle = '#eef3fb';\n760\t  ctx.font = '20px system-ui';\n761\t  if (run.phase === 'racing') {\n762\t    const t = raceTime();\n763\t    if (t < 0) { ctx.font = 'bold 96px system-ui'; ctx.fillText(String(Math.ceil(-t / 1000)), W / 2, H / 2); }\n764\t    else ctx.fillText(`${(t / 1000).toFixed(1)} s`, W / 2, 34);\n765\t  } else {\n766\t    ctx.fillStyle = 'rgba(0,0,0,.6)'; ctx.fillRect(0, H / 2 - 130, W, 260);\n767\t    ctx.fillStyle = '#eef3fb';\n768\t    ctx.fillText(run.message, W / 2, H / 2 - 80);\n769\t    if (run.standings && hub) {\n770\t      ctx.font = '18px system-ui';\n771\t      let row = 0;\n772\t      run.standings.forEach((ids, place) => ids.forEach((id) => {\n773\t        const p = hub.players.find((q) => q.id === id) || { name: `Player ${id + 1}`, color: '#eef3fb' };\n774\t        ctx.fillStyle = p.color;\n775\t        ctx.fillText(`${place + 1}. ${p.name}${id === hub.me ? ' (you)' : ''}`, W / 2, H / 2 - 40 + row++ * 28);\n776\t      }));\n777\t    }\n778\t  }\n779\t  if (menu.open) drawMenu();\n780\t}\n781\t\n782\tfunction drawMenu() {\n783\t  ctx.fillStyle = 'rgba(4,10,20,.85)'; ctx.fillRect(W / 2 - 160, 250, 320, 70 + menu.items.length * 40);\n784\t  ctx.textAlign = 'center';\n785\t  ctx.fillStyle = '#eef3fb'; ctx.font = 'bold 22px system-ui';\n786\t  ctx.fillText('Settings', W / 2, 286);\n787\t  ctx.font = '18px system-ui';\n788\t  menu.items.forEach((item, i) => {\n789\t    ctx.fillStyle = i === menu.at ? '#ffd34d' : '#eef3fb';\n790\t    ctx.fillText(`${i === menu.at ? '▸ ' : ''}${item.label()}`, W / 2, 326 + i * 40);\n791\t  });\n792\t}\n793\t\n794\tconnect();\n795\trequestAnimationFrame(frame);\n796\t</script>\n797\t</body>\n798\t</html>\n799\t"}]},"parent_tool_use_id":null,"session_id":"66624378-a7bb-42a2-8c1d-fc63666b5654","uuid":"91a51915-712a-4dd8-81cb-25986b506110","timestamp":"2026-11-05T23:21:39.313Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261105-162057__x4c6ec5/work/_research/hub/examples/ghost.html","content":"</script>\n</head>\n<body>\n<canvas id=\"c\" aria-label=\"Comet Dash\"></canvas>\n<script>\n'use strict';\n// Comet Dash: the smallest honest ghost game. Every copy runs its own comet\n// down the same course (built from the session seed), sends its comet and the\n// area it is in ten times a second, and draws the others as ghosts while they\n// are in its area. Each copy reports its own progress and result; the hub ranks\n// them.\nconst W = 600, H = 800, LENGTH = 9000, SPEED = 330, R = 14, ROW = 260;\nconst canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\nconst keys = new Set();\nlet pointerX = null;\nlet audio = null;\n\naddEventListener('keydown', (e) => {\n  if (e.key === 'Escape') return toggleMenu();\n  if (menu.open) return menuKey(e.key);\n  keys.add(e.key.toLowerCase());\n  gesture();\n});\naddEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));\n\n// ---- the controller, in the browser's standard mapping (a PS5 DualSense:\n// Cross 0, Circle 1, Create 8, Options 9, D-pad 12-15, left stick axis 0).\n// Buttons count on the frame they go down.\nconst PAD = { cross: 0, circle: 1, create: 8, options: 9, up: 12, down: 13, left: 14, right: 15 };\nlet pad = null, padNow = [], padWas = [];\nfunction readPad() {\n  pad = navigator.getGamepads ? [...navigator.getGamepads()].find((p) => p && p.connected) || null : null;\n  padWas = padNow;\n  padNow = pad ? pad.buttons.map((b) => b.pressed) : [];\n  // Create + Options is the hub's: it opens the hub's corner bar, so Options alone opens the menu.\n  if (pressed(PAD.options) && !padNow[PAD.create]) return toggleMenu();\n  if (menu.open) {\n    if (pressed(PAD.up)) menuKey('ArrowUp');\n    if (pressed(PAD.down)) menuKey('ArrowDown');\n    if (pressed(PAD.cross)) menuKey('Enter');\n    if (pressed(PAD.circle)) toggleMenu();\n  } else if (padNow.some((b, i) => b && !padWas[i] && i !== PAD.create && i !== PAD.options)) gesture();\n}\nconst pressed = (b) => !!padNow[b] && !padWas[b];\n\n// ---- the settings menu: Esc or Options, over the running race. It never\n// pauses anything; while it is open your comet just flies straight.\nlet muted = false;\nconst menu = {\n  open: false,\n  at: 0,\n  items: [\n    { label: () => `Sound: ${muted ? 'off' : 'on'}`, act: () => { muted = !muted; } },\n    { label: () => 'Back to the race', act: () => toggleMenu() },\n  ],\n};\nfunction toggleMenu() { menu.open = !menu.open; menu.at = 0; keys.clear(); }\nfunction menuKey(key) {\n  if (key === 'ArrowUp' || key === 'w') menu.at = (menu.at + menu.items.length - 1) % menu.items.length;\n  if (key === 'ArrowDown' || key === 's') menu.at = (menu.at + 1) % menu.items.length;\n  if (key === 'Enter' || key === ' ') menu.items[menu.at].act();\n}\ncanvas.addEventListener('pointerdown', (e) => { pointerX = e.clientX; gesture(); });\ncanvas.addEventListener('pointermove', (e) => { if (pointerX !== null) pointerX = e.clientX; });\naddEventListener('pointerup', () => { pointerX = null; });\n\nfunction beep(freq) {\n  if (!audio || muted) return;\n  const o = audio.createOscillator(), g = audio.createGain();\n  o.frequency.value = freq; g.gain.value = 0.05;\n  o.connect(g).connect(audio.destination);\n  o.start(); o.stop(audio.currentTime + 0.1);\n}\n\n/** Rocks in rows, the same on every device: built only from integers off the seeded generator. */\nfunction course(rng) {\n  const rocks = [];\n  for (let y = 600; y < LENGTH - 200; y += ROW) {\n    const gaps = 1 + Math.floor(rng() * 2);\n    const lanes = [0, 1, 2, 3, 4];\n    for (let i = 0; i < gaps; i++) lanes.splice(Math.floor(rng() * lanes.length), 1);\n    for (const lane of lanes) if (rng() < 0.7) rocks.push({ x: 60 + lane * 120, y });\n  }\n  return rocks;\n}\n\nconst run = {\n  phase: 'title',     // title | waiting | racing | done | over\n  x: W / 2, d: 0, stun: 0,\n  rocks: course(Math.random),\n  finishedAt: null,\n  message: 'Comet Dash — press any key or tap to race',\n};\nconst ghosts = new Map();   // id -> {x, d, area, name, color, done}\n/** The whole course is one area, so every ghost on it is in view. */\nconst AREA = 'course';\nlet hub = null;\nlet soloStart = 0;\nlet lastSent = 0;\nlet felt = 0;    // the local steering as last read\nlet boost = false;   // Space or Cross held: a little faster\n\nfunction steer() {\n  if (menu.open) return 0;\n  let x = 0;\n  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n  if (keys.has('arrowright') || keys.has('d')) x += 1;\n  if (pad && Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n  if (padNow[PAD.left]) x = -1;\n  if (padNow[PAD.right]) x = 1;\n  if (pointerX !== null) {\n    const r = canvas.getBoundingClientRect();\n    const target = ((pointerX - r.left) / r.width) * W;\n    x = Math.max(-1, Math.min(1, (target - run.x) / 40));\n  }\n  return x;\n}\n\nasync function connect() {\n  const info = await AIHub.connect({ mode: 'ghost', seats: [2, 4] });\n  if (!info) return;\n  hub = info;\n  run.rocks = course(AIHub.rng('course'));\n  for (const p of info.players) if (p.id !== info.me) ghosts.set(p.id, { ...p, x: W / 2, d: 0, done: null });\n  // The hub's card collects everyone's ready: ready up as soon as the course is built.\n  run.phase = 'waiting';\n  run.message = 'Get ready…';\n  AIHub.ready();\n  AIHub.on('start', () => { run.phase = 'racing'; unlockAudio(); });\n  AIHub.on('message', (data, from) => {\n    const g = ghosts.get(from);\n    if (!g) return;\n    if (data.t === 'g') { g.tx = data.x; g.td = data.d; g.area = data.area; }\n    if (data.t === 'done') { g.done = data.time; beep(330); }\n  });\n  AIHub.on('leave', ({ id }) => ghosts.delete(id));\n  AIHub.on('time-up', () => {\n    if (run.phase === 'racing') AIHub.result({ score: Math.floor(run.d) });\n  });\n  AIHub.on('end', ({ reason, standings }) => {\n    run.phase = 'over';\n    run.standings = standings;\n    run.message = reason === 'finished' ? 'Race over' : reason === 'sat-out' ? 'You sat this one out' : 'Race cancelled';\n  });\n}\n\nfunction unlockAudio() {\n  if (!audio) {\n    try { audio = new AudioContext(); } catch { audio = null; }\n  }\n  audio?.resume?.().catch(() => {});\n}\n\nfunction gesture() {\n  unlockAudio();\n  if (!hub && (run.phase === 'title' || run.phase === 'over')) {\n    Object.assign(run, { phase: 'racing', x: W / 2, d: 0, stun: 0, rocks: course(Math.random), finishedAt: null });\n    soloStart = performance.now();\n  }\n}\n\n/** Race time: the hub's shared clock in a session, the local one alone. */\nconst raceTime = () => (hub ? AIHub.time() : performance.now() - soloStart);\n\nlet last = performance.now();\nfunction frame(now) {\n  const dt = Math.min((now - last) / 1000, 0.25);\n  last = now;\n  readPad();\n  felt = steer();\n  boost = !menu.open && (keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7]);\n  if (run.phase === 'racing' && raceTime() >= 0) {\n    run.x = Math.max(R + 20, Math.min(W - R - 20, run.x + felt * 320 * dt));\n    if (run.stun > 0) run.stun -= dt;\n    else run.d += SPEED * (boost ? 1.3 : 1) * dt;\n    for (const rock of run.rocks) {\n      if (Math.abs(rock.y - run.d) < 18 && Math.abs(rock.x - run.x) < 40 && run.stun <= 0) {\n        run.stun = 0.7; run.d -= 20; beep(140);\n      }\n    }\n    if (run.d >= LENGTH) {\n      run.d = LENGTH;\n      run.finishedAt = Math.round(raceTime());\n      run.phase = 'done';\n      run.message = `Finished in ${(run.finishedAt / 1000).toFixed(2)} s`;\n      beep(880);\n      if (hub) {\n        AIHub.result({ time: run.finishedAt });\n        AIHub.send({ t: 'done', time: run.finishedAt });\n        run.message += ' — waiting for the others';\n      }\n    }\n  }\n  if (hub && (run.phase === 'racing' || run.phase === 'done') && now - lastSent > 100) {\n    lastSent = now;\n    AIHub.send({ t: 'g', area: AREA, x: Math.round(run.x), d: Math.round(run.d) }, { reliable: false });\n    if (run.phase === 'racing') AIHub.progress({ score: Math.round(run.d), label: `${Math.round((run.d / LENGTH) * 100)}% of the course` });\n  }\n  for (const g of ghosts.values()) if (g.tx !== undefined) {\n    const k = 1 - Math.pow(0.002, dt);\n    g.x += (g.tx - g.x) * k; g.d += (g.td - g.d) * k;\n  }\n  draw();\n  requestAnimationFrame(frame);\n}\n\nfunction draw() {\n  const r = canvas.getBoundingClientRect();\n  const dpr = devicePixelRatio || 1;\n  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n  }\n  const s = Math.min(canvas.width / W, canvas.height / H);\n  ctx.setTransform(1, 0, 0, 1, 0, 0);\n  ctx.fillStyle = '#081120'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n  ctx.fillStyle = '#0f1b2e'; ctx.fillRect(0, 0, W, H);\n\n  const screenY = (d) => H - 160 - (d - run.d);\n  ctx.fillStyle = '#5b6b86';\n  for (const rock of run.rocks) {\n    const y = screenY(rock.y);\n    if (y > -40 && y < H + 40) ctx.fillRect(rock.x - 34, y - 12, 68, 24);\n  }\n  const fy = screenY(LENGTH);\n  if (fy > -10 && fy < H) { ctx.fillStyle = '#eef3fb'; ctx.fillRect(0, fy - 3, W, 6); }\n\n  ctx.textAlign = 'center';\n  ctx.font = '13px system-ui';\n  for (const g of ghosts.values()) {\n    if (g.area !== AREA) continue;\n    const y = screenY(g.d);\n    ctx.globalAlpha = 0.45;\n    ctx.fillStyle = g.color;\n    ctx.beginPath(); ctx.arc(g.x, Math.max(20, Math.min(H - 20, y)), R, 0, Math.PI * 2); ctx.fill();\n    ctx.globalAlpha = 1;\n    ctx.fillText(g.name, g.x, Math.max(20, Math.min(H - 20, y)) - R - 6);\n  }\n  const mine = hub ? hub.players.find((p) => p.id === hub.me) : null;\n  ctx.fillStyle = run.stun > 0 ? '#ffffff' : (mine?.color || '#f5b700');\n  ctx.beginPath(); ctx.arc(run.x, H - 160, R, 0, Math.PI * 2); ctx.fill();\n\n  // progress strip: everyone's distance down the course\n  const bar = (d, color) => { ctx.fillStyle = color; ctx.fillRect(W - 14, H - 20 - (H - 40) * Math.min(1, d / LENGTH), 10, 4); };\n  ctx.fillStyle = '#1d2c45'; ctx.fillRect(W - 14, 20, 10, H - 40);\n  for (const g of ghosts.values()) bar(g.d, g.color);\n  bar(run.d, mine?.color || '#f5b700');\n\n  ctx.fillStyle = '#eef3fb';\n  ctx.font = '20px system-ui';\n  if (run.phase === 'racing') {\n    const t = raceTime();\n    if (t < 0) { ctx.font = 'bold 96px system-ui'; ctx.fillText(String(Math.ceil(-t / 1000)), W / 2, H / 2); }\n    else ctx.fillText(`${(t / 1000).toFixed(1)} s`, W / 2, 34);\n  } else {\n    ctx.fillStyle = 'rgba(0,0,0,.6)'; ctx.fillRect(0, H / 2 - 130, W, 260);\n    ctx.fillStyle = '#eef3fb';\n    ctx.fillText(run.message, W / 2, H / 2 - 80);\n    if (run.standings && hub) {\n      ctx.font = '18px system-ui';\n      let row = 0;\n      run.standings.forEach((ids, place) => ids.forEach((id) => {\n        const p = hub.players.find((q) => q.id === id) || { name: `Player ${id + 1}`, color: '#eef3fb' };\n        ctx.fillStyle = p.color;\n        ctx.fillText(`${place + 1}. ${p.name}${id === hub.me ? ' (you)' : ''}`, W / 2, H / 2 - 40 + row++ * 28);\n      }));\n    }\n  }\n  if (menu.open) drawMenu();\n}\n\nfunction drawMenu() {\n  ctx.fillStyle = 'rgba(4,10,20,.85)'; ctx.fillRect(W / 2 - 160, 250, 320, 70 + menu.items.length * 40);\n  ctx.textAlign = 'center';\n  ctx.fillStyle = '#eef3fb'; ctx.font = 'bold 22px system-ui';\n  ctx.fillText('Settings', W / 2, 286);\n  ctx.font = '18px system-ui';\n  menu.items.forEach((item, i) => {\n    ctx.fillStyle = i === menu.at ? '#ffd34d' : '#eef3fb';\n    ctx.fillText(`${i === menu.at ? '▸ ' : ''}${item.label()}`, W / 2, 326 + i * 40);\n  });\n}\n\nconnect();\nrequestAnimationFrame(frame);\n</script>\n</body>\n</html>\n","numLines":290,"startLine":510,"totalLines":799}},"tool_result_meta":[{"id":"toolu_01DuF6LQCVRZYUYraeDMd5cc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
