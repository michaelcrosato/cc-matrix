open(p,'w').write(s)\nEOF\ncat > ../spike/app/real.js <<'EOF'\n// Integration check: the real sim, the real Kestrel data, an AI car, a chase camera, hard-edged road.\nimport { Engine, THREE, toonMaterial, PALETTE, mergeStaticMeshes, setLookLayer, buildModel, skyAt, applySky, ContactShadow } from './pixel-engine.js';\nimport { buildTrack, racingLine, speedProfile, carParams, newCar, aiDrive, stepCar, collideCars } from './sim.js';\nimport { TRACKS } from './tracks.data.js';\nimport { CARS } from './carsdata.js';\nimport { coupe, hatch } from './cars.js';\nconst { Mesh, BufferGeometry, Float32BufferAttribute, Vector3, Color, Group, CylinderGeometry, PlaneGeometry, BoxGeometry } = THREE;\nconst q = new URLSearchParams(location.search);\nconst ID = q.get('track') ?? 'kestrel';\n// One band of the road, outward from t0 to t1, in quads that share no vertices so colours stay hard.\nfunction band(tr, t0, t1, y, colourAt) {\n  const pos = [], col = [], c = new Color();\n  const P = (i, t) => { const k = i % tr.N, rx = -tr.tz[k], rz = tr.tx[k]; return [tr.x[k] + rx * t, tr.y[k] + y - t * Math.sin(tr.bank[k]), tr.z[k] + rz * t]; };\n  for (let i = 0; i < tr.N; i++) {\n    const a = P(i, t0), b = P(i, t1), d = P(i + 1, t0), e = P(i + 1, t1);\n    c.set(colourAt(i)); for (const v of [a, d, b, b, d, e]) { pos.push(...v); col.push(c.r, c.g, c.b); }\n  }\n  const g = new BufferGeometry(); g.setAttribute('position', new Float32BufferAttribute(pos, 3)); g.setAttribute('color', new Float32BufferAttribute(col, 3)); g.computeVertexNormals();\n  const m = new Mesh(g, toonMaterial(0xffffff, { vertexColors: true })); m.receiveShadow = true; return m;\n}\nclass Real {\n  name = 'Real'; target = new Vector3(); camPos = new Vector3(); smooth = new Vector3();\n  async setup(ctx) {\n    const tr = this.tr = buildTrack(TRACKS[ID]); this.line = racingLine(tr);\n    applySky(ctx.engine, skyAt(TRACKS[ID].hour));\n    const road = tr.surface === 'dirt' ? PALETTE.orange : PALETTE.slate, edge = tr.edge === 'grass' ? [PALETTE.green, PALETTE.lime] : tr.edge === 'gravel' ? [PALETTE.sand, PALETTE.orange] : [PALETTE.mist, PALETTE.slate];\n    const shade = new Color(road).multiplyScalar(0.9).getHex();\n    const kerb = tr.surface === 'asphalt';\n    const W = (i) => tr.width[i % tr.N] / 2;\n    const parts = [];\n    // width varies, so bands are built per sample with half-width offsets\n    const roadBand = (from, to, y, colourAt) => { const pos = [], col = [], c = new Color(); const P = (i, f) => { const k = i % tr.N, h = W(k), t = f(h), rx = -tr.tz[k], rz = tr.tx[k]; return [tr.x[k] + rx * t, tr.y[k] + y - t * Math.sin(tr.bank[k]), tr.z[k] + rz * t]; }; for (let i = 0; i < tr.N; i++) { const a = P(i, from), b = P(i, to), d = P(i + 1, from), e = P(i + 1, to); c.set(colourAt(i)); for (const v of [a, d, b, b, d, e]) { pos.push(...v); col.push(c.r, c.g, c.b); } } const g = new BufferGeometry(); g.setAttribute('position', new Float32BufferAttribute(pos, 3)); g.setAttribute('color', new Float32BufferAttribute(col, 3)); g.computeVertexNormals(); const m = new Mesh(g, toonMaterial(0xffffff, { vertexColors: true })); m.receiveShadow = true; return m; };\n    parts.push(roadBand((h) => -h, (h) => h, 0, (i) => (i % 4 < 2 ? road : shade)));\n    if (kerb) for (const s of [-1, 1]) parts.push(roadBand((h) => s * h, (h) => s * (h + 1.6), 0.02, (i) => (Math.abs(tr.kappa[i]) > 0.004 && Math.sign(tr.kappa[i]) === s ? (i % 2 ? PALETTE.red : PALETTE.white) : road)));\n    for (const s of [-1, 1]) parts.push(roadBand((h) => s * (h + (kerb ? 1.6 : 0)), (h) => s * (h + 40), -0.03, (i) => edge[(i >> 3) % 2]));\n    for (const s of [-1, 1]) parts.push(roadBand((h) => s * (h - 0.5), (h) => s * (h - 0.25), 0.03, () => PALETTE.white));\n    const wall = (s) => { const pos = [], col = [], c = new Color(PALETTE.mist); for (let i = 0; i < tr.N; i++) { const k = i, n = (i + 1) % tr.N, t0 = s * (W(k) + tr.wallL[k]), t1 = s * (W(n) + tr.wallL[n]); const a = [tr.x[k] - tr.tz[k] * t0, tr.y[k], tr.z[k] + tr.tx[k] * t0], b = [tr.x[n] - tr.tz[n] * t1, tr.y[n], tr.z[n] + tr.tx[n] * t1], a2 = [a[0], a[1] + 0.9, a[2]], b2 = [b[0], b[1] + 0.9, b[2]]; for (const v of (s > 0 ? [a, a2, b, b, a2, b2] : [a, b, a2, a2, b, b2])) { pos.push(...v); col.push(c.r, c.g, c.b); } } const g = new BufferGeometry(); g.setAttribute('position', new Float32BufferAttribute(pos, 3)); g.setAttribute('color', new Float32BufferAttribute(col, 3)); g.computeVertexNormals(); return new Mesh(g, toonMaterial(0xffffff, { vertexColors: true })); };\n    parts.push(wall(1), wall(-1));\n    const ground = new Mesh(new PlaneGeometry(9000, 9000).rotateX(-Math.PI / 2), toonMaterial(edge[0])); ground.position.y = Math.min(...tr.y) - 2; parts.push(ground);\n    // Trackside: posts and oaks, so speed reads\n    for (let i = 0; i < tr.N; i += 6) { const s = i % 12 ? 1 : -1, t = s * (W(i) + tr.wallL[i] + 4), x = tr.x[i] - tr.tz[i] * t, z = tr.z[i] + tr.tx[i] * t; const m = new Mesh(new BoxGeometry(0.5, 3, 0.5), toonMaterial(i % 24 ? PALETTE.mist : PALETTE.orange)); m.position.set(x, tr.y[i] + 1.5, z); m.castShadow = true; parts.push(m); }\n    ctx.scene.add(...mergeStaticMeshes(parts));\n    // Field\n    const mk = (def, paint) => { const g = new Group(); const b = buildModel(def, { palette: { paint } }).object; g.add(b); for (const [x, z] of [[-0.8, 1.32], [0.8, 1.32], [-0.8, -1.32], [0.8, -1.32]]) { const w = new Mesh(new CylinderGeometry(0.33, 0.33, 0.26, 10).rotateZ(Math.PI / 2), toonMaterial(PALETTE.ink)); w.position.set(x, 0.33, z); g.add(w); } g.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = false; } }); setLookLayer(g, 'actors'); ctx.scene.add(g); return g; };\n    const p = carParams(CARS.ginga), surf = tr.surface === 'dirt' ? 0.5 : 1; this.speeds = speedProfile(tr, this.line, p, surf);\n    this.field = []; const paints = ['red', 'blue', 'lime', 'white', 'orange', 'teal']; for (let i = 0; i < 6; i++) { const c = newCar(p, tr, (tr.N - 4 - i * 3) % tr.N, i % 2 ? 2.6 : -2.6); c.view = mk(i % 2 ? coupe : hatch, paints[i]); c.skill = 0.9 + i * 0.012; this.field.push(c); }\n    this.me = this.field[0];\n    const cam = ctx.camera.camera; cam.near = 0.5; cam.far = 6000; cam.fov = 58; cam.updateProjectionMatrix();\n    globalThis.__REAL__ = this;\n  }\n  fixedUpdate(ctx) {\n    for (const c of this.field) c.inp = aiDrive(c, this.tr, this.line, this.speeds, { skill: c.skill }, this.field);\n    for (let k = 0; k < 4; k++) { for (const c of this.field) stepCar(c, c.inp, 1 / 240, this.tr); collideCars(this.field); }\n  }\n  update(ctx, dt) {\n    for (const c of this.field) { const v = c.view; v.position.set(c.x, c.y, c.z); v.rotation.set(-c.ax * 0.004, c.yaw, c.ay * 0.008, 'YXZ'); }\n    const c = this.me, sn = Math.sin(c.yaw), cs = Math.cos(c.yaw), cam = ctx.camera.camera;\n    this.smooth.set(c.x - sn * 8.5, c.y + 3.1, c.z - cs * 8.5);\n    if (!this.started) { this.camPos.copy(this.smooth); this.started = true; }\n    this.camPos.lerp(this.smooth, 1 - Math.exp(-dt * 8));\n    cam.position.copy(this.camPos); cam.lookAt(c.x + sn * 8, c.y + 1.1, c.z + cs * 8);\n    ctx.hud.clear();\n    ctx.hud.text(6, 6, `${TRACKS[ID].name.toUpperCase()}  S ${c.loc.s | 0}`, { color: 'sand' });\n    ctx.hud.text(6, 6, `${Math.abs(c.u * 3.6) | 0}`, { anchor: 'bottom-right', scale: 3 });\n    ctx.hud.text(6, 32, `GEAR ${c.gear}  ${c.rpm | 0} RPM`, { anchor: 'bottom-right' });\n  }\n  cameraTarget() { return this.me ? this.target.set(this.me.x, this.me.y, this.me.z) : this.target; }\n  status() { return this.me ? `s ${this.me.loc.s | 0} t ${this.me.loc.t.toFixed(1)} u ${(this.me.u * 3.6) | 0} walls ${this.field.map((c) => c.wallHits).join(',')}` : ''; }\n}\nconst e = await Engine.start(new Real(), { container: document.getElementById('p1'), camera: { preset: 'fixed', position: [0, 5, -10], target: [0, 1, 0], fov: 58, minZoom: 1, maxZoom: 1 }, settings: { button: false }, touch: false });\nglobalThis.__PIXEL_ENGINE__ = e;\nEOF\ncp sim.mjs ../spike/app/sim.js; cp tracks.data.mjs ../spike/app/tracks.data.js; cp carsdata.mjs ../spike/app/carsdata.js\nsed 's/split.js/real.js/' build_split2.mjs > build_real.mjs && node build_real.mjs ../spike/app ../spike/real.html 2>/dev/null; cat > shoot_real.py <<'EOF'\nimport sys, json\nfrom playwright.sync_api import sync_playwright\nurl, out, secs = sys.argv[1], sys.argv[2], [float(x) for x in sys.argv[3].split(',')]\nARGS = ['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader','--use-webgpu-adapter=swiftshader']\nwith sync_playwright() as p:\n    b = p.chromium.launch(args=ARGS, headless=True)\n    pg = b.new_page(viewport={'width': 960, 'height': 540})\n    logs = []\n    pg.on('console', lambda m: logs.append(m.type + ': ' + m.text) if m.type in ('error','warning') else None)\n    pg.on('pageerror', lambda e: logs.append('pageerror: ' + str(e)))\n    pg.goto(url)\n    pg.wait_for_function('() => !!globalThis.__REAL__', timeout=120000)\n    done = 0\n    for i, s in enumerate(secs):\n        pg.evaluate(f'() => {{ const e = __PIXEL_ENGINE__; e.step({int((s-done)*60)}); e.manual = false; }}')\n        done = s\n        pg.wait_for_timeout(1200)\n        print(s, pg.evaluate('() => __PIXEL_ENGINE__.game.status()'), pg.evaluate('() => __PIXEL_ENGINE__.errors'))\n        pg.screenshot(path=f'{out}_{i}.png')\n    print('\\n'.join(logs[:12]))\n    b.close()\nEOF\ntimeout 170 python3 shoot_real.py \"file://$PWD/../spike/real.html?track=kestrel\" ../spike/real 8,30,55","description":"Integration test: real sim, Kestrel data, AI field, chase camera","timeout":220000}}}
