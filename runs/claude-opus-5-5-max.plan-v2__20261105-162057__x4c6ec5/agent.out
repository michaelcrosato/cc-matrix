' + t.tz[0]; console.log(k.padEnd(9), 'net turn', (sum * 57.3).toFixed(0), sum > 0 ? 'right-hand' : 'left-hand', 'start heading', t.tx[0].toFixed(2), t.tz[0].toFixed(2)); }\nEOF\nnode netturn.mjs","description":"Compute each track's net turning direction","timeout":30000}}}
