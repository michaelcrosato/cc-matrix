400, 20, 2, 11, 0], [470, 520, 40, 3, 11, 0], [470, 660, 16, 3, 11, 0],\n    [210, 660, 30, 2, 11, 0], [170, 610, 24, 2, 11, 0], [110, 660, 30, 2, 11, 0], [-60, 660, 16, 1, 11, 0], [-60, 420, 18, 1, 11, 0], [-190, 420, 16, 0, 11, 0],\n    [-190, 200, 22, 0, 11, 0], [-300, 110, 30, 0, 11, 0], [-300, 0, 18, 0, 12, 0],\n  ] },\n  saltline: { name: 'Saltline Speedbowl', runoff: 3, corners: [\n    [632, 0, 215, 0, 18, 16], [0, 1095, 215, 0, 18, 16], [-632, 0, 215, 0, 18, 16],\n  ] },\n  redclay: { name: 'Red Clay Stage', runoff: 4, crests: [[420, 60, 2.6], [1660, 50, 2.2]], corners: [\n    [240, 0, 40, 0, 9, 0], [300, 160, 25, 4, 9, 0], [170, 260, 30, 8, 9, 0], [280, 400, 20, 12, 9, 0], [120, 470, 16, 16, 9, 0], [0, 360, 30, 14, 9, 0],\n    [-120, 470, 20, 18, 9, 0], [-300, 380, 35, 20, 9, 0], [-220, 220, 18, 14, 9, 0], [-380, 120, 30, 8, 9, 0], [-300, -40, 35, 4, 9, 0], [-60, -60, 40, 1, 9, 0],\n  ] },\n  proving: { name: 'Proving Ground', runoff: 14, corners: [\n    [1040, 0, 80, 0, 28, 0], [1040, 240, 80, 0, 16, 0], [800, 240, 40, 0, 14, 0], [720, 150, 30, 0, 14, 0], [600, 240, 30, 0, 14, 0], [480, 150, 30, 0, 14, 0], [360, 240, 40, 0, 14, 0],\n    [200, 240, 22, 0, 14, 0], [200, 130, 22, 0, 14, 0], [40, 130, 22, 0, 14, 0], [40, 240, 22, 0, 14, 0], [-160, 240, 80, 0, 16, 0], [-160, 0, 80, 0, 28, 0],\n  ] },\n};\n\nexport function trackFromCorners(L, step = 4) {\n  const C = L.corners, n = C.length;\n  // Dense path at 1 m: straight, arc, straight...; y, width and bank ease between corners along the way.\n  const px = [], pz = [], key = [];\n  const tangents = C.map((c, i) => {\n    const a = C[(i - 1 + n) % n], b = C[(i + 1) % n];\n    let ux = a[0] - c[0], uz = a[1] - c[1], ul = Math.hypot(ux, uz); ux /= ul; uz /= ul;\n    let vx = b[0] - c[0], vz = b[1] - c[1], vl = Math.hypot(vx, vz); vx /= vl; vz /= vl;\n    const ang = Math.acos(Math.max(-1, Math.min(1, ux * vx + uz * vz))); // interior angle\n    const t = c[2] / Math.tan(ang / 2);\n    const inX = c[0] + ux * t, inZ = c[1] + uz * t, outX = c[0] + vx * t, outZ = c[1] + vz * t;\n    const bx = ux + vx, bz = uz + vz, bl = Math.hypot(bx, bz);\n    const cx = c[0] + (bx / bl) * (c[2] / Math.sin(ang / 2)), cz = c[1] + (bz / bl) * (c[2] / Math.sin(ang / 2));\n    return { inX, inZ, outX, outZ, cx, cz, r: c[2], ul, vl, t };\n  });\n  const push = (x, z, ci, f) => { px.push(x); pz.push(z); key.push(ci + f); };\n  const n0 = n - 1, mid = { x: (C[n0][0] + C[0][0]) / 2, z: (C[n0][1] + C[0][1]) / 2 };\n  // start at the middle of the last edge, heading to corner 0\n  let cx = mid.x, cz = mid.z;\n  const line = (x0, z0, x1, z1, ci, f0, f1) => { const l = Math.hypot(x1 - x0, z1 - z0), m = Math.max(1, Math.round(l)); for (let i = 0; i < m; i++) { const f = i / m; push(x0 + (x1 - x0) * f, z0 + (z1 - z0) * f, ci, f0 + (f1 - f0) * f); } };\n  for (let i = 0; i < n; i++) {\n    const T = tangents[i];\n    const startF = i === 0 ? 0.5 : 0; // key fraction runs from corner i-1 (0) to corner i (1) along the edge\n    line(cx, cz, T.inX, T.inZ, i - 1, startF, 0.85);\n    const a0 = Math.atan2(T.inZ - T.cz, T.inX - T.cx); let a1 = Math.atan2(T.outZ - T.cz, T.outX - T.cx), da = a1 - a0;\n    while (da > Math.PI) da -= 2 * Math.PI; while (da < -Math.PI) da += 2 * Math.PI;\n    const arc = Math.abs(da) * T.r, m = Math.max(1, Math.round(arc));\n    for (let k = 0; k < m; k++) { const f = k / m, a = a0 + da * f; push(T.cx + T.r * Math.cos(a), T.cz + T.r * Math.sin(a), i - 1, 0.85 + 0.15 * f); }\n    cx = T.outX; cz = T.outZ;\n  }\n  line(cx, cz, mid.x, mid.z, n - 1, 0, 0.5);\n  // Smooth the path so curvature ramps in and out (a closed moving average, twice).\n  const m = px.length;\n  const smooth = (a, r) => { const o = new Float64Array(m); let s = 0; for (let i = -r; i <= r; i++) s += a[(i + m) % m]; for (let i = 0; i < m; i++) { o[i] = s / (2 * r + 1); s += a[(i + r + 1) % m] - a[(i - r + m) % m]; } return o; };\n  let sx = smooth(smooth(px, 7), 7), sz = smooth(smooth(pz, 7), 7);\n  // Arc length of the smoothed path, then resample at `step`.\n  const cum = new Float64Array(m + 1); for (let i = 0; i < m; i++) cum[i + 1] = cum[i] + Math.hypot(sx[(i + 1) % m] - sx[i], sz[(i + 1) % m] - sz[i]);\n  const length = cum[m], N = Math.round(length / step), ds = length / N;\n  const T = { N, ds, length, x: new Float64Array(N), z: new Float64Array(N), y: new Float64Array(N), width: new Float64Array(N), bank: new Float64Array(N), tx: new Float64Array(N), tz: new Float64Array(N), kappa: new Float64Array(N), slope: new Float64Array(N), runoff: L.runoff };\n  const ease = (f) => f * f * (3 - 2 * f);\n  const attr = (k, q) => { const ci = Math.floor(k), f = ease(k - ci), a = C[(ci + n) % n], b = C[(ci + 1 + n) % n]; return a[q] + (b[q] - a[q]) * f; };\n  for (let i = 0, j = 0; i < N; i++) {\n    const s = i * ds; while (cum[j + 1] < s) j++;\n    const f = (s - cum[j]) / (cum[j + 1] - cum[j]), q = (j + 1) % m;\n    T.x[i] = sx[j] + (sx[q] - sx[j]) * f; T.z[i] = sz[j] + (sz[q] - sz[j]) * f;\n    const k = key[j];\n    T.y[i] = attr(k, 3); T.width[i] = attr(k, 4); T.bank[i] = (attr(k, 5) * Math.PI) / 180;\n  }\n  for (const [cs, cl, ch] of L.crests ?? []) for (let i = 0; i < N; i++) { const d = (i * ds - cs) / cl; if (Math.abs(d) < 1) T.y[i] += ch * (0.5 + 0.5 * Math.cos(Math.PI * d)); }\n  for (let i = 0; i < N; i++) { const p = (i - 1 + N) % N, q = (i + 1) % N; const dx = T.x[q] - T.x[p], dz = T.z[q] - T.z[p], l = Math.hypot(dx, dz); T.tx[i] = dx / l; T.tz[i] = dz / l; T.slope[i] = (T.y[q] - T.y[p]) / l; }\n  for (let i = 0; i < N; i++) { const p = (i - 1 + N) % N, q = (i + 1) % N; T.kappa[i] = (T.tx[p] * T.tz[q] - T.tz[p] * T.tx[q]) / (2 * ds); }\n  // Bank pushes toward the inside of the corner: + pushes to the driver's right.\n  for (let i = 0; i < N; i++) { T.bank[i] = T.bank[i] * Math.sign(-T.kappa[i] || 1); }\n  return T;\n}\nexport function plot(T, path, size = 420) {\n  let x0 = Infinity, x1 = -Infinity, z0 = Infinity, z1 = -Infinity, y0 = Infinity, y1 = -Infinity;\n  for (let i = 0; i < T.N; i++) { x0 = Math.min(x0, T.x[i]); x1 = Math.max(x1, T.x[i]); z0 = Math.min(z0, T.z[i]); z1 = Math.max(z1, T.z[i]); y0 = Math.min(y0, T.y[i]); y1 = Math.max(y1, T.y[i]); }\n  const s = (size - 20) / Math.max(x1 - x0, z1 - z0), img = new Uint8Array(size * size * 3).fill(245);\n  const dot = (px, py, c) => { for (let a = -1; a <= 1; a++) for (let b = -1; b <= 1; b++) { const X = Math.round(px) + a, Y = Math.round(py) + b; if (X < 0 || Y < 0 || X >= size || Y >= size) continue; const o = (Y * size + X) * 3; img[o] = c[0]; img[o + 1] = c[1]; img[o + 2] = c[2]; } };\n  for (let i = 0; i < T.N; i++) { const h = (T.y[i] - y0) / Math.max(1, y1 - y0); dot(10 + (x1 - T.x[i]) * s, 10 + (z1 - T.z[i]) * s, i < 8 ? [230, 30, 30] : [Math.round(30 + 200 * h), 60, Math.round(220 - 200 * h)]); }\n  writeFileSync(path, Buffer.concat([Buffer.from(`P6 ${size} ${size} 255\\n`), Buffer.from(img)]));\n  return { w: x1 - x0, d: z1 - z0, rise: y1 - y0 };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Mo2cpWiTBJfZxNnfNZ9T3K","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
