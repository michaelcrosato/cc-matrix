{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DTWPRNFfiN5L4VTNSLoW1G","type":"tool_result","content":"import { type Camera, OrthographicCamera, PerspectiveCamera, Vector3 } from 'three/webgpu';\nimport { type Resolution } from './framing';\nimport type { Input } from './input';\n/**\n * Camera presets. A game picks ONE at startup (EngineOptions.camera / `?camera=`). For\n * reviewing, `engine.setCamera()` swaps presets live without touching the world. `free`\n * is an authoring tool: fly around, press Enter to fix the view, and paste the printed\n * `fixed` config into your game.\n */\nexport type CameraPreset = 'iso' | 'topdown' | 'side' | 'third' | 'first' | 'free' | 'fixed';\nexport declare const CAMERA_PRESETS: readonly CameraPreset[];\nexport interface CameraConfig {\n    preset?: CameraPreset;\n    /** Zoom factor, 1 = preset default, >1 = closer. Ignored by `first`. */\n    zoom?: number;\n    minZoom?: number;\n    maxZoom?: number;\n    /** Ortho presets: visible world height at zoom 1. */\n    viewHeight?: number;\n    /** iso: degrees below horizon / around Y. */\n    pitch?: number;\n    yaw?: number;\n    /** Perspective presets: vertical field of view in degrees. */\n    fov?: number;\n    /** third: orbit distance at zoom 1. */\n    distance?: number;\n    /** fixed: camera position and look-at target. */\n    position?: [number, number, number];\n    target?: [number, number, number];\n    /** fixed/free: projection. */\n    projection?: 'perspective' | 'ortho';\n    /** Follow smoothing; higher is snappier. */\n    stiffness?: number;\n}\n/** What rigs may ask of the world (e.g. third-person wall avoidance). */\nexport interface CameraWorld {\n    /** Distance from `from` along `dir` to the first obstacle, or null. */\n    raycast?(from: Vector3, dir: Vector3, maxDistance: number): number | null;\n}\nexport interface CameraUpdate {\n    /** Point to follow (character center/chest). */\n    target: Vector3;\n    /** First-person eye point. */\n    eye: Vector3;\n    dt: number;\n    resolution: Resolution;\n    input: Input;\n    world: CameraWorld;\n    /**\n     * Screen shake: added to the camera's position after the rig placed it (the engine's\n     * `CameraShake`). Ortho rigs move it by whole art pixels.\n     */\n    shake?: Vector3;\n}\n/** Where a rig is and looks, as data (`engine.snapshot()`): the frame after a restore sees the camera the frame after the snapshot did. */\nexport interface CameraRigState {\n    readonly preset: CameraPreset;\n    readonly focus: readonly number[];\n    readonly zoom: number;\n    readonly aspect: number;\n    readonly position: readonly number[];\n    readonly quaternion: readonly number[];\n    readonly shaken: readonly number[];\n    /** What a preset keeps of its own (an orbit's yaw, pitch and distance). */\n    readonly own: Readonly<Record<string, number>>;\n}\n/** Base rig: owns the three.js camera, zoom and the ground-plane movement basis. */\nexport declare abstract class CameraRig {\n    abstract readonly preset: CameraPreset;\n    abstract readonly camera: OrthographicCamera | PerspectiveCamera;\n    /** World point the rig is centred on (used for shadow framing). */\n    readonly focus: Vector3;\n    zoom: number;\n    readonly minZoom: number;\n    readonly maxZoom: number;\n    /** Whether zoom applies (all presets except first person). */\n    readonly zoomable: boolean;\n    /** First person hides the player model. */\n    readonly hidesTarget: boolean;\n    /** Side-scroller: characters should stay on their depth lane. */\n    readonly lockDepth: boolean;\n    /** False while the free camera is flying (input drives the camera, not the player). */\n    controlsCharacter: boolean;\n    /** Pixel-snap the camera (ortho only). */\n    snap: boolean;\n    /** Viewport aspect (width / height), following the art resolution (see `setAspect`). */\n    aspect: number;\n    protected readonly stiffness: number;\n    constructor(config: CameraConfig);\n    /**\n     * The ray through screen point (x, y) in normalised device coordinates (−1..1, y up, as\n     * `input.pointer` gives them): where it starts (on the near plane) and its unit direction.\n     * For picking things with the mouse, or aiming at it. An orthographic rig stands far back from\n     * what it frames (over a hundred metres for iso), so its rays start far from the scene: cast\n     * them long (hundreds of metres).\n     */\n    rayAt(x: number, y: number, origin: Vector3, dir: Vector3): void;\n    setZoom(zoom: number): void;\n    /**\n     * Match the art resolution's aspect (adaptive framing changes it with the screen).\n     * `update()` calls this from `CameraUpdate.resolution`; the engine also calls it on swap.\n     */\n    setAspect(aspect: number): void;\n    /** Called once after construction and whenever zoom (or the aspect of an ortho camera) changes. */\n    protected abstract applyZoom(): void;\n    /** Place the camera without smoothing. */\n    teleport(target: Vector3): void;\n    /** Screen-relative movement basis on the ground plane. */\n    groundBasis(): {\n        right: Vector3;\n        forward: Vector3;\n    };\n    update(u: CameraUpdate): void;\n    protected abstract step(u: CameraUpdate): void;\n    /** The shake offset actually applied this frame (zero when still). */\n    private readonly shaken;\n    /** The offset a shake moves the placed camera by (into `out`). */\n    protected shakeOffset(offset: Vector3, out: Vector3): void;\n    /** Serializable description (debug UI, `state()`). */\n    describe(): Record<string, unknown>;\n    /** The rig as data, exact (`engine.snapshot()`). */\n    state(): CameraRigState;\n    /** Put the rig back where `state()` found it (the same preset). */\n    setState(s: CameraRigState): void;\n    /** What a preset keeps beyond the base (`state()`). */\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    protected follow(target: Vector3, dt: number): void;\n}\n/** Orthographic presets: classic 3/4 isometric, straight top-down, straight side-on. */\nexport declare class OrthoRig extends CameraRig {\n    readonly camera: OrthographicCamera;\n    readonly preset: 'iso' | 'topdown' | 'side';\n    readonly lockDepth: boolean;\n    readonly baseViewHeight: number;\n    private readonly offset;\n    private readonly right;\n    private readonly up;\n    private readonly forward;\n    private readonly tmp;\n    /** World units per art pixel at the last update. */\n    private pixel;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(preset: 'iso' | 'topdown' | 'side', config?: CameraConfig);\n    get viewHeight(): number;\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    /** Shake by whole art pixels across the view (depth doesn't move an ortho picture). */\n    protected shakeOffset(offset: Vector3, out: Vector3): void;\n}\n/** Over-the-shoulder orbit camera: mouse-drag or Q/E to orbit, wheel to zoom, avoids walls. */\nexport declare class ThirdPersonRig extends CameraRig {\n    readonly preset: \"third\";\n    readonly camera: PerspectiveCamera;\n    yaw: number;\n    pitch: number;\n    private readonly baseDistance;\n    private currentDistance;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(config?: CameraConfig);\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    describe(): {\n        yaw: number;\n        pitch: number;\n    };\n}\n/** Eyes of the character: mouse look (click to lock the pointer) or Q/E to turn. No zoom. */\nexport declare class FirstPersonRig extends CameraRig {\n    readonly preset: \"first\";\n    readonly camera: PerspectiveCamera;\n    readonly zoomable = false;\n    readonly hidesTarget = true;\n    yaw: number;\n    pitch: number;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(config?: CameraConfig);\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    groundBasis(): {\n        right: Vector3;\n        forward: Vector3;\n    };\n    describe(): {\n        yaw: number;\n        pitch: number;\n    };\n}\n/**\n * Authoring camera. While flying: WASD move, Q/E down/up, drag (or click to lock) to look,\n * Shift = fast, wheel = field of view. Press Enter to fix it: the view freezes, the player\n * gets control, and `fixedConfig()` returns the config to hard-code (preset 'fixed').\n * Enter again unfixes.\n */\nexport declare class FreeRig extends CameraRig {\n    readonly preset: 'free' | 'fixed';\n    readonly camera: PerspectiveCamera | OrthographicCamera;\n\n40:export interface CameraUpdate {\n41-    /** Point to follow (character center/chest). */\n42-    target: Vector3;\n43-    /** First-person eye point. */\n44-    eye: Vector3;\n45-    dt: number;\n46-    resolution: Resolution;\n47-    input: Input;\n48-    world: CameraWorld;\n49-    /**\n50-     * Screen shake: added to the camera's position after the rig placed it (the engine's\n51-     * `CameraShake`). Ortho rigs move it by whole art pixels.\n52-     */\n53-    shake?: Vector3;\n54-}\n55-/** Where a rig is and looks, as data (`engine.snapshot()`): the frame after a restore sees the camera the frame after the snapshot did. */\n56-export interface CameraRigState {\n--\n101:     * `update()` calls this from `CameraUpdate.resolution`; the engine also calls it on swap.\n102-     */\n103-    setAspect(aspect: number): void;\n104-    /** Called once after construction and whenever zoom (or the aspect of an ortho camera) changes. */\n105-    protected abstract applyZoom(): void;\n106-    /** Place the camera without smoothing. */\n107-    teleport(target: Vector3): void;\n108-    /** Screen-relative movement basis on the ground plane. */\n109-    groundBasis(): {\n110-        right: Vector3;\n111-        forward: Vector3;\n112-    };\n113:    update(u: CameraUpdate): void;\n114:    protected abstract step(u: CameraUpdate): void;\n115-    /** The shake offset actually applied this frame (zero when still). */\n116-    private readonly shaken;\n117-    /** The offset a shake moves the placed camera by (into `out`). */\n118-    protected shakeOffset(offset: Vector3, out: Vector3): void;\n119-    /** Serializable description (debug UI, `state()`). */\n120-    describe(): Record<string, unknown>;\n121-    /** The rig as data, exact (`engine.snapshot()`). */\n122-    state(): CameraRigState;\n123-    /** Put the rig back where `state()` found it (the same preset). */\n124-    setState(s: CameraRigState): void;\n125-    /** What a preset keeps beyond the base (`state()`). */\n126-    protected ownState(): Record<string, number>;\n127-    protected setOwnState(own: Readonly<Record<string, number>>): void;\n128-    protected follow(target: Vector3, dt: number): void;\n129-}\n130-/** Orthographic presets: classic 3/4 isometric, straight top-down, straight side-on. */\n--\n148:    protected step(u: CameraUpdate): void;\n---\n../../API.md:1385:- `dissolve?: boolean`: Pixel dissolve: the material reads its own `dissolve` property (0 = solid, 1 = gone) and discards a per-art-pixel noise pattern below it, with a 1-pixel glowing front in the rim \n../../API.md:1413:- `linger?: number`: Seconds the pieces lie around before they dissolve (default 4).\n../../API.md:1424:- `restore(b: Breakable): void`: Put a broken block back, whole (its old pieces dissolve as usual).\n../../API.md:1429:- `update(dt: number, standing = -1): void`: Per frame: tiles under `standing` (a collider handle: the character's `groundCollider`) start to shake, shaking tiles drop, dropped ones grow back; old chunk\n../../API.md:4948:const TRANSITION_CELLS: { readonly diamonds: 16; readonly blinds: 12; readonly dissolve: 3; readonly mosaic: 20; }\n../../API.md:4951:Art pixels per diamond cell, blind band, dissolve block; the most a mosaic block grows to.\n../../API.md:4956:type TransitionKind = 'fade' | 'iris' | 'diamonds' | 'dissolve' | 'dither' | 'blinds' | 'wipe' | 'curtain' | 'mosaic'\n---\n### toonMaterial()\n\n```ts\nfunction toonMaterial(color: ColorRepresentation, options: ToonMaterialOptions = {}): MeshToonNodeMaterial\n```\n\nShared 3-band toon node material for a palette color, optionally textured and/or\nvertex-colored (color × map × vertex color), cached per combination. Untextured ones\n(and ones whose texture is itself shared, e.g. from a cached GLB) are marked\n`userData.shared`, so level unloads keep them; a material with a level's own texture is\ndisposed with the level, and disposing it drops it from the cache.\n\n### interface ToonMaterialOptions\n\n- `map?: Texture | null`: Base color texture. Switched to nearest filtering (crisp texels, no mip blur).\n- `vertexColors?: boolean`: Multiply by the geometry's `color` attribute (vertex colors).\n- `rim?: number`: A hard-banded rim light in this colour (hex) on grazing, upward-facing surfaces: a silhouette that reads against dark floors (monsters in dark levels). Added to the emissive, so `material.emissive` (hit flashes) still works on top. Same shade\n- `dissolve?: boolean`: Pixel dissolve: the material reads its own `dissolve` property (0 = solid, 1 = gone) and discards a per-art-pixel noise pattern below it, with a 1-pixel glowing front in the rim colour (or white). Set it on per-body clones (`material.di","is_error":false}]},"parent_tool_use_id":null,"session_id":"66624378-a7bb-42a2-8c1d-fc63666b5654","uuid":"ecca417d-f373-4629-84cd-0e80ba4ce49e","timestamp":"2026-11-05T23:27:06.329Z","tool_use_result":{"stdout":"import { type Camera, OrthographicCamera, PerspectiveCamera, Vector3 } from 'three/webgpu';\nimport { type Resolution } from './framing';\nimport type { Input } from './input';\n/**\n * Camera presets. A game picks ONE at startup (EngineOptions.camera / `?camera=`). For\n * reviewing, `engine.setCamera()` swaps presets live without touching the world. `free`\n * is an authoring tool: fly around, press Enter to fix the view, and paste the printed\n * `fixed` config into your game.\n */\nexport type CameraPreset = 'iso' | 'topdown' | 'side' | 'third' | 'first' | 'free' | 'fixed';\nexport declare const CAMERA_PRESETS: readonly CameraPreset[];\nexport interface CameraConfig {\n    preset?: CameraPreset;\n    /** Zoom factor, 1 = preset default, >1 = closer. Ignored by `first`. */\n    zoom?: number;\n    minZoom?: number;\n    maxZoom?: number;\n    /** Ortho presets: visible world height at zoom 1. */\n    viewHeight?: number;\n    /** iso: degrees below horizon / around Y. */\n    pitch?: number;\n    yaw?: number;\n    /** Perspective presets: vertical field of view in degrees. */\n    fov?: number;\n    /** third: orbit distance at zoom 1. */\n    distance?: number;\n    /** fixed: camera position and look-at target. */\n    position?: [number, number, number];\n    target?: [number, number, number];\n    /** fixed/free: projection. */\n    projection?: 'perspective' | 'ortho';\n    /** Follow smoothing; higher is snappier. */\n    stiffness?: number;\n}\n/** What rigs may ask of the world (e.g. third-person wall avoidance). */\nexport interface CameraWorld {\n    /** Distance from `from` along `dir` to the first obstacle, or null. */\n    raycast?(from: Vector3, dir: Vector3, maxDistance: number): number | null;\n}\nexport interface CameraUpdate {\n    /** Point to follow (character center/chest). */\n    target: Vector3;\n    /** First-person eye point. */\n    eye: Vector3;\n    dt: number;\n    resolution: Resolution;\n    input: Input;\n    world: CameraWorld;\n    /**\n     * Screen shake: added to the camera's position after the rig placed it (the engine's\n     * `CameraShake`). Ortho rigs move it by whole art pixels.\n     */\n    shake?: Vector3;\n}\n/** Where a rig is and looks, as data (`engine.snapshot()`): the frame after a restore sees the camera the frame after the snapshot did. */\nexport interface CameraRigState {\n    readonly preset: CameraPreset;\n    readonly focus: readonly number[];\n    readonly zoom: number;\n    readonly aspect: number;\n    readonly position: readonly number[];\n    readonly quaternion: readonly number[];\n    readonly shaken: readonly number[];\n    /** What a preset keeps of its own (an orbit's yaw, pitch and distance). */\n    readonly own: Readonly<Record<string, number>>;\n}\n/** Base rig: owns the three.js camera, zoom and the ground-plane movement basis. */\nexport declare abstract class CameraRig {\n    abstract readonly preset: CameraPreset;\n    abstract readonly camera: OrthographicCamera | PerspectiveCamera;\n    /** World point the rig is centred on (used for shadow framing). */\n    readonly focus: Vector3;\n    zoom: number;\n    readonly minZoom: number;\n    readonly maxZoom: number;\n    /** Whether zoom applies (all presets except first person). */\n    readonly zoomable: boolean;\n    /** First person hides the player model. */\n    readonly hidesTarget: boolean;\n    /** Side-scroller: characters should stay on their depth lane. */\n    readonly lockDepth: boolean;\n    /** False while the free camera is flying (input drives the camera, not the player). */\n    controlsCharacter: boolean;\n    /** Pixel-snap the camera (ortho only). */\n    snap: boolean;\n    /** Viewport aspect (width / height), following the art resolution (see `setAspect`). */\n    aspect: number;\n    protected readonly stiffness: number;\n    constructor(config: CameraConfig);\n    /**\n     * The ray through screen point (x, y) in normalised device coordinates (−1..1, y up, as\n     * `input.pointer` gives them): where it starts (on the near plane) and its unit direction.\n     * For picking things with the mouse, or aiming at it. An orthographic rig stands far back from\n     * what it frames (over a hundred metres for iso), so its rays start far from the scene: cast\n     * them long (hundreds of metres).\n     */\n    rayAt(x: number, y: number, origin: Vector3, dir: Vector3): void;\n    setZoom(zoom: number): void;\n    /**\n     * Match the art resolution's aspect (adaptive framing changes it with the screen).\n     * `update()` calls this from `CameraUpdate.resolution`; the engine also calls it on swap.\n     */\n    setAspect(aspect: number): void;\n    /** Called once after construction and whenever zoom (or the aspect of an ortho camera) changes. */\n    protected abstract applyZoom(): void;\n    /** Place the camera without smoothing. */\n    teleport(target: Vector3): void;\n    /** Screen-relative movement basis on the ground plane. */\n    groundBasis(): {\n        right: Vector3;\n        forward: Vector3;\n    };\n    update(u: CameraUpdate): void;\n    protected abstract step(u: CameraUpdate): void;\n    /** The shake offset actually applied this frame (zero when still). */\n    private readonly shaken;\n    /** The offset a shake moves the placed camera by (into `out`). */\n    protected shakeOffset(offset: Vector3, out: Vector3): void;\n    /** Serializable description (debug UI, `state()`). */\n    describe(): Record<string, unknown>;\n    /** The rig as data, exact (`engine.snapshot()`). */\n    state(): CameraRigState;\n    /** Put the rig back where `state()` found it (the same preset). */\n    setState(s: CameraRigState): void;\n    /** What a preset keeps beyond the base (`state()`). */\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    protected follow(target: Vector3, dt: number): void;\n}\n/** Orthographic presets: classic 3/4 isometric, straight top-down, straight side-on. */\nexport declare class OrthoRig extends CameraRig {\n    readonly camera: OrthographicCamera;\n    readonly preset: 'iso' | 'topdown' | 'side';\n    readonly lockDepth: boolean;\n    readonly baseViewHeight: number;\n    private readonly offset;\n    private readonly right;\n    private readonly up;\n    private readonly forward;\n    private readonly tmp;\n    /** World units per art pixel at the last update. */\n    private pixel;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(preset: 'iso' | 'topdown' | 'side', config?: CameraConfig);\n    get viewHeight(): number;\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    /** Shake by whole art pixels across the view (depth doesn't move an ortho picture). */\n    protected shakeOffset(offset: Vector3, out: Vector3): void;\n}\n/** Over-the-shoulder orbit camera: mouse-drag or Q/E to orbit, wheel to zoom, avoids walls. */\nexport declare class ThirdPersonRig extends CameraRig {\n    readonly preset: \"third\";\n    readonly camera: PerspectiveCamera;\n    yaw: number;\n    pitch: number;\n    private readonly baseDistance;\n    private currentDistance;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(config?: CameraConfig);\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    describe(): {\n        yaw: number;\n        pitch: number;\n    };\n}\n/** Eyes of the character: mouse look (click to lock the pointer) or Q/E to turn. No zoom. */\nexport declare class FirstPersonRig extends CameraRig {\n    readonly preset: \"first\";\n    readonly camera: PerspectiveCamera;\n    readonly zoomable = false;\n    readonly hidesTarget = true;\n    yaw: number;\n    pitch: number;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(config?: CameraConfig);\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    groundBasis(): {\n        right: Vector3;\n        forward: Vector3;\n    };\n    describe(): {\n        yaw: number;\n        pitch: number;\n    };\n}\n/**\n * Authoring camera. While flying: WASD move, Q/E down/up, drag (or click to lock) to look,\n * Shift = fast, wheel = field of view. Press Enter to fix it: the view freezes, the player\n * gets control, and `fixedConfig()` returns the config to hard-code (preset 'fixed').\n * Enter again unfixes.\n */\nexport declare class FreeRig extends CameraRig {\n    readonly preset: 'free' | 'fixed';\n    readonly camera: PerspectiveCamera | OrthographicCamera;\n\n40:export interface CameraUpdate {\n41-    /** Point to follow (character center/chest). */\n42-    target: Vector3;\n43-    /** First-person eye point. */\n44-    eye: Vector3;\n45-    dt: number;\n46-    resolution: Resolution;\n47-    input: Input;\n48-    world: CameraWorld;\n49-    /**\n50-     * Screen shake: added to the camera's position after the rig placed it (the engine's\n51-     * `CameraShake`). Ortho rigs move it by whole art pixels.\n52-     */\n53-    shake?: Vector3;\n54-}\n55-/** Where a rig is and looks, as data (`engine.snapshot()`): the frame after a restore sees the camera the frame after the snapshot did. */\n56-export interface CameraRigState {\n--\n101:     * `update()` calls this from `CameraUpdate.resolution`; the engine also calls it on swap.\n102-     */\n103-    setAspect(aspect: number): void;\n104-    /** Called once after construction and whenever zoom (or the aspect of an ortho camera) changes. */\n105-    protected abstract applyZoom(): void;\n106-    /** Place the camera without smoothing. */\n107-    teleport(target: Vector3): void;\n108-    /** Screen-relative movement basis on the ground plane. */\n109-    groundBasis(): {\n110-        right: Vector3;\n111-        forward: Vector3;\n112-    };\n113:    update(u: CameraUpdate): void;\n114:    protected abstract step(u: CameraUpdate): void;\n115-    /** The shake 