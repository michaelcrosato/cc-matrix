ls/build.mjs game.html 2>&1 | tail -2; ls -la game.html | cut -c20-; grep -c \"aihub-session 1.4.0\" game.html; (cd src && timeout 90 node check.mjs --headless main.js --keys KeyW*240 --out ../check-headless 2>&1 | tail -3 | cut -c1-160); cp tools/hub/harness.html tools/hub/bridge.js tools/hub/round.js . ; cd ../tools && cat > final_check.py <<'EOF'\nimport sys, json\nfrom playwright.sync_api import sync_playwright\nurl, out = sys.argv[1], sys.argv[2]\nARGS = ['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader','--use-webgpu-adapter=swiftshader']\nwith sync_playwright() as p:\n    b = p.chromium.launch(args=ARGS, headless=True)\n    pg = b.new_page(viewport={'width': 1920, 'height': 1080})\n    logs = []\n    pg.on('console', lambda m: logs.append(m.type + ': ' + m.text) if m.type in ('error','warning') else None)\n    pg.on('pageerror', lambda e: logs.append('pageerror: ' + str(e)))\n    pg.goto(url)\n    pg.wait_for_function('() => !!globalThis.__PIXEL_ENGINE__', timeout=120000)\n    pg.evaluate('() => { const e = __PIXEL_ENGINE__; e.step(1500); e.manual = false; }')\n    pg.wait_for_timeout(1500)\n    print('status', pg.evaluate('() => __PIXEL_ENGINE__.game.status()'), 'errors', pg.evaluate('() => __PIXEL_ENGINE__.errors'), 'fps', pg.evaluate('() => __PIXEL_ENGINE__.fps'))\n    pg.screenshot(path=out)\n    print('\\n'.join(logs[:10]))\n    b.close()\nEOF\ntimeout 100 python3 final_check.py \"file://$PWD/../final/game.html\" ../final/shot.png; timeout 100 python3 -u run_harness.py ../final \"game=game.html&players=2&auto=1\" 80 | grep -E \"complete|PASS|FAIL|BAD\"; timeout 100 python3 -u run_harness.py ../final \"game=game.html&players=4&latency=150&jitter=50&loss=5&auto=1\" 80 | grep -E \"complete|PASS|FAIL|BAD\"; timeout 100 python3 -u run_harness.py ../final \"game=game.html&players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1\" 80 | grep -E \"complete|PASS|FAIL|BAD\"","description":"Build a test