{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/40-weapons.js');s=p.read_text();line=\\\"S.pitch=clamp(S.pitch+(w.slot==='side'?.018:w.rate<2?.045:.007),-1.45,1.45);\\\";s=s.replace(line,'');s=s.replace(\\\"if(g.cond<=0){\\\",line+\\\"\\\\n if(g.cond<=0){\\\");s=s.replace(\\\"else if(hit.actor?.data?.remote)netDamage(hit.actor.data.remote,w.dmg);\\\",\\\"else if(hit.actor?.data?.remote\"'!==undefined)netDamage(hit.actor.data.remote,w.dmg);else if(hit.actor===hero&&owner!==hero)hurtPlayer(w.dmg);\");p.write_text(s)\np=Path('\"'src/45-fire.js');s=p.read_text().replace('function fireStep(dt){Fire.acc+=dt;',\\\"function fireStep(dt){if(inSession&&\"'!AIHub.isHost){for(const k of Fire.burning){Fire.t[k]-=dt;if(Fire.t[k]<=0){Fire.state[k]=2;burnData[k]=255;}}Fire.burning=Fire.burning.filter(k=>Fire.state[k]===1);if(Fire.state[cellAt(hero.x,hero.y)]===1)hurtPlayer(25*dt);if(Fire.tex)Fire.tex.needsUpdate=true;return;}Fire.acc+=dt;\");p.write_text(s)\np=Path('\"'src/85-net.js');s=p.read_text().replace(\\\"p.hp=data.hp;\\\", \\\"p.hp=Math.min(p.hp,data.hp);\\\");s=s.replace(\\\"for(const [id,x,y,z,yw,hp,combat]of data.E)\\\",\\\"const present=new Set(data.E.map(e=>e[0]));for(const e of raiders)if(e.netID&&\"'!present.has(e.netID)){e.alive=false;e.a.setSolid(false);if(!e.b.dead)e.b.dead={t:1,dir:0,g:e.a.z};}for(const [id,x,y,z,yw,hp,combat]of data.E)\");s=s.replace(\"p.yaw=yw/1000;p.hp=hp;\", \"p.yaw=yw/1000;p.hp=hp;\");p.write_text(s)\np=Path('\"'test/ISSUES.md');s=p.read_text()+'\\\\n3. Aim validation: recoil changed the shot direction before casting, causing single-shot weapons to shoot above the aimed point (especially rockets). Recoil now applies after the cast. Critical combat/progression defect.\\\\n4. Network review: clients were spreading their own fire and kept enemies omitted from new snapshots; clients now apply host ignition events and remove missing enemies. Critical shared-world consistency defect.\\\\n5. Network review: player seat 0 and the host hero were skipped by PvP ray damage. Fixed explicit remote-id checks and host damage dispatch. Critical multiplayer combat defect.\\\\n';p.write_text(s)\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
