{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"sed -n '1972,2035p' engine/my-3d2dge-3d.js\"","aggregated_output":"/** the ground's surfaces as a vehicle feels them (a vehicle's o.surfaces adds or changes them) */\nconst SURFACES = { road: {}, grass: { top: .55, grip: .9 }, dirt: { top: .7, grip: .8 }, sand: { top: .45, grip: .6 }, snow: { top: .6, grip: .5 }, ice: { grip: .15 }, water: { top: .35, grip: .5 }, lava: { top: .3 }, boost: { boost: .8 } };\nclass Vehicle extends Actor {\n  /** made by world.vehicle(o): see the manual */\n  constructor(world, o) {\n    super(world, 'mob', Object.assign({}, o, { half: 0 }));\n    /** o: its handling (the kind's, with yours over it: top, accel, brake, reverse, turn, grip, drift, drag, hop, kart,\n     *  seat, float, surfaces, ground, color); angle: its heading; speed: along it; slide: across it; drifting (-1, 0, 1);\n     *  charge (a kart's drift: 1 blue, 2 orange); boostT, spinT (seconds); surface: the ground's tag under it; offroad;\n     *  onGround; airT; bumped (it hit something this step); tilt: [pitch, roll] it is drawn at (the ground's slope) */\n    this.o = o; this.isVehicle = true; this.vehicle = o.kind; this.angle = o.angle ?? o.facing ?? 0; this.facing = this.angle;\n    Object.assign(this, { speed: 0, slide: 0, drifting: 0, charge: 0, boostT: 0, spinT: 0, surface: null, offroad: false, onGround: false, airT: 0, bumped: false, tilt: [0, 0], steer: 0, _boostK: 0, _hopDir: 0, _held: false, _want: 0 });\n    this.o.surfaces = Object.assign({}, SURFACES, o.surfaces);\n  }\n  /** a boost: seconds of it, power (.4: its top speed up by that share) */\n  boost(sec = .8, power = .4) { this._boostK = this.boostT > 0 ? Math.max(this._boostK, power) : power; this.boostT = Math.max(this.boostT, sec); return this; }\n  /** a spin-out (a shot, a hazard): seconds without control, most of its speed lost */\n  spinOut(sec = 1) { if (this.spinT > 0) return this; this.spinT = sec; this.vx *= .3; this.vy *= .3; this.drifting = 0; this.charge = 0; return this; }\n  /** one step's driving (before world.step): an intent { steer: -1..1, gas, brake (0..1), drift (held), top (a factor) }\n   *  or an input (its move()'s x steers; gas, brake, drift: actions). E.Race calls it as it does an E.Car's (map: not\n   *  read). Sets the velocity world.step gives Rapier */\n  update(dt, map, c = {}) {\n    const o = this.o, inp = typeof c.move === 'function';\n    let steer = inp ? c.move()[0] : c.steer || 0, gas = inp ? (c.down('gas') || o.auto ? 1 : 0) : c.gas || 0, brake = inp ? (c.down('brake') ? 1 : 0) : c.brake || 0;\n    const drift = inp ? c.down('drift') : !!c.drift, hop = inp ? c.pressed('drift') : drift && !this._held; this._held = drift;\n    const S = o.surfaces[this.surface] || {}, air = !this.onGround;\n    if (S.boost && !air) this.boost(S.boost);\n    if (this.spinT > 0) { this.spinT -= dt; this.angle += 11 * dt; steer = 0; gas = 0; brake = .5; }\n    if (this.boostT > 0) { this.boostT -= dt; gas = 1; }\n    if (o.kart) {   // a hop on the drift button; landing still steering, it drifts that way while held, charging a boost\n      if (hop && !air && this.spinT <= 0) { this.vz = o.hop; this._hopDir = Math.sign(steer); }\n      if (!air && !this.drifting && drift && this._hopDir && this.speed > o.top * .4) this.drifting = this._hopDir;\n      if (this.drifting) {\n        if (!drift || this.speed < o.top * .2) { if (this.charge >= 1) this.boost(this.charge >= 2 ? 1 : .55, .35); this.drifting = 0; this.charge = 0; this._hopDir = 0; }\n        else this.charge += dt * (steer * this.drifting > 0 ? 1.5 : .8);\n      }\n      if (!drift) this._hopDir = 0;\n    } else this.drifting = drift && Math.abs(this.speed) > o.top * .3 ? Math.sign(steer) || this.drifting : 0;   // a car's handbrake\n    const k = clamp(Math.abs(this.speed) / (o.top * .25), 0, 1) * Math.sign(this.speed || 1), turn = this.drifting ? this.drifting * .6 + steer * .4 : steer;\n    this.angle += turn * o.turn * k * dt * (air ? .5 : 1); this.steer = steer;\n    const fx = Math.cos(this.angle), fy = Math.sin(this.angle);\n    let v = this.vx * fx + this.vy * fy, s = this.vy * fx - this.vx * fy;\n    const top = o.top * (S.top || 1) * (c.top || 1) * (this.boostT > 0 ? 1 + this._boostK : 1);\n    if (gas > 0 && v < top) v = Math.min(top, v + o.accel * gas * (this.boostT > 0 ? 2.5 : 1) * dt);\n    else if (v > top && !air) v = Math.max(top, v - o.accel * 1.6 * dt);\n    if (brake > 0) v = v > 1 ? Math.max(0, v - o.brake * brake * dt) : Math.max(-o.reverse, v - o.accel * .6 * brake * dt);\n    if (!gas && !brake) v *= Math.exp(-o.drag * dt);\n    if (!air || o.float) s *= Math.exp(-(this.drifting ? o.drift : o.grip) * (S.grip || 1) * dt);\n    this.vx = fx * v - fy * s; this.vy = fy * v + fx * s; this._want = Math.hypot(this.vx, this.vy);\n    if (o.float) this.vz = this._gz !== null && this._gz !== undefined ? (this._gz + o.float - this.z) * 6 : this.vz - this.world.gravity * dt;   // (a hovercraft rides its cushion; past an edge it falls)\n    this.facing = this.angle; this.anim = { vx: 0, vy: 0, down: .4, hurt: this.spinT > 0 };   // (the driver, seated)\n    return this;\n  }\n}\n/** a vehicle's ground after a step: a ray under it (tracks, the level, the terrain): on the ground or not, its slope (the\n *  tilt it is drawn at), the surface's tag, a bump (it lost speed it wanted) */\nfunction vehicleGround(w, a, dt) {\n  const o = a.o, h = w.ray(a.x, a.y, a.z + a.r, 0, 0, -1, a.r + (o.float ? o.float + 10 : 3.5), { level: true });\n  a.onGround = a.grounded = !!h; a._gz = h ? h.z : null; a.airT = h ? 0 : a.airT + dt;\n  const fx = Math.cos(a.angle), fy = Math.sin(a.angle), n = h ? [h.nx, h.ny, h.nz] : [0, 0, 1];\n  const tp = h ? Math.atan2(-(n[0] * fx + n[1] * fy), n[2]) : clamp(a.vz / 400, -.5, .5), tr = h ? Math.atan2(-fy * n[0] + fx * n[1], n[2]) : 0, k = Math.min(1, dt * 12);\n  a.tilt[0] += (tp - a.tilt[0]) * k; a.tilt[1] += (tr + clamp(a.steer * a.speed / a.o.top, -1, 1) * .08 - a.tilt[1]) * k;\n  a.surface = o.ground ? o.ground(a.x, a.y) : w._surfaceAt(a.x, a.y, a.z);\n  a.offroad = ((o.surfaces[a.surface] || {}).top || 1) < 1;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"cat > src/50-vehicles.js <<'EOF'\nfunction drawVehicle(pen,a,t){const q=vehicles.find(q=>q.v===a),type=q?.type||'jeep',col=q?.clinic?'#d0cbb0':type==='technical'?'#696d4a':'#897548',dark='#30382d';pen.at(a.x,a.y,a.z,a.angle);if(type==='airboat'){pen.box(0,0,3,62,29,5,col).box(1,0,7,20,17,3,dark);for(let i=0;i<16;i++){const an=i/16*TAU;pen.tube(-24,Math.cos(an)*13,17+Math.sin(an)*13,-24,Math.cos(an+.4)*13,17+Math.sin(an+.4)*13,.4,'#686e58');}for(let i=0;i<3;i++){const an=t*35+i*TAU/3;pen.tube(-23,0,17,-23,Math.cos(an)*11,17+Math.sin(an)*11,.9,'#4d5545');}}\n else{const truck=type==='truck',L=truck?78:58;pen.box(0,0,7,L,26,7,col).box(13,0,13,21,25,5,col).box(-11,0,10,18,23,4,'#343b2e');for(const x of [-20,20])for(const y of [-15,15]){pen.tube(x,y-3,4,x,y+3,4,6,'#262c24').tube(x,y-3.2,4,x,y+3.2,4,3,'#a29267');}for(const y of [-12,12])pen.tube(4,y,16,4,y,31,.4,dark).tube(4,y,31,-8,y,31,.4,dark);pen.tube(4,-12,31,4,12,31,.5,dark);pen.box(25,0,11,2,23,2,dark);for(const y of [-8,8])pen.box(26,y,15,1,5,4,'#cfbd7e');for(let y=-7;y<8;y+=3)pen.box(26,y,11,1,1,5,'#484d38');if(truck)pen.box(-21,0,23,38,25,25,'#76785b');if(type==='technical'){pen.tube(-17,0,10,-17,0,30,.6,dark).tube(-17,0,30,7,0,32,.5,dark).box(-18,0,31,5,3,3,'#404734');}if(q?.clinic){pen.box(14,0,16,9,3,.2,'#863d2d').box(14,0,16.1,3,9,.2,'#863d2d');}}\n if(q&&q.hp<q.max*.5){const n=Math.floor(t*5)%5;pen.ball(16,0,24+n*5,3+n*2,3+n*2,4+n*2,q.hp<q.max*.2?'#35362d':'#aaa999');}pen.at();}\nfunction makeVehicle(type,x,y,o={}){const spec=V_TYPES[type],surfaces=type==='airboat'?{brine:{top:1},reeds:{top:1},mud:{top:.5},salt:{top:.35},grass:{top:.25},road:{top:.25},pad:{top:.25}}:{road:{top:1},grass:{top:.7},salt:{top:.95,grip:.6},mud:{top:.5},reeds:{top:.4},brine:{top:.3},pad:{top:.85}};const v=world.vehicle({...spec,x,y,z:height(x,y)+2,angle:o.angle||0,ground:(x,y)=>biomeAt(x/M,y/M),surfaces,color:'#897548',draw:drawVehicle});const q={id:'vehicle'+vehicles.length,type,v,hp:spec.hp,max:spec.hp,stalled:false,burn:0,ai:null,...o};vehicles.push(q);return q;}\nfunction setupVehicles(){makeVehicle('jeep',OP.mission.x+14*M,OP.mission.y+5*M,{clinic:true,angle:-Math.PI/2});makeVehicle('jeep',OP.strip.x+5*M,OP.strip.y+10*M);makeVehicle('technical',OP.k9.x+12*M,OP.k9.y+12*M);makeVehicle('airboat',OP.remnant.x,OP.remnant.y);makeVehicle('truck',OP.salt.x+12*M,OP.salt.y+3*M,{bank:true});makeVehicle('jeep',OP.tannery.x+12*M,OP.tannery.y+14*M);}\nfunction enterVehicle(q){if(q.hp<=0)return false;S.vehicle=q;S.yaw=q.v.angle;S.seat='drive';hero.setSolid(false);hero.fly=true;S.tool=null;A.sfx('engine');say('Papa Static',RADIO[Math.floor(rnd()*RADIO.length)]);return true;}\nfunction exitVehicle(){const q=S.vehicle;if(\"'!q)return;const v=q.v;for(let i=0;i<8;i++){const a=v.angle+Math.PI/2+i*Math.PI/4,x=v.x+Math.cos(a)*30,y=v.y+Math.sin(a)*30,z=height(x,y)+1;if(!world.ray(x,y,z+3,0,0,1,30,{skip:[hero,v],level:true})){hero.place(x,y,z);break;}}hero.fly=false;hero.setSolid(true);S.vehicle=null;A.sfx('\"'door');}\nfunction damageVehicle(q,d){if(q.hp<=0)return;q.hp=Math.max(0,q.hp-d);if(q.hp<=0){q.burn=3;if(S.vehicle===q){exitVehicle();hurtPlayer(35);}Fire.ignite(q.v.x,q.v.y,4,true);} }\nfunction repairVehicle(q){if(q.hp<=0||S.act)return false;act('repair',S.merc===2?2:4,()=>{q.hp=Math.max(q.hp,q.max*.6);q.stalled=false;A.sfx('rack');});return true;}\nfunction vehicleStep(dt,I){for(const q of vehicles){const v=q.v;if(q.hp<=0){v.update(dt,null,{brake:1});if(q.burn>0){q.burn-=dt;if(q.burn<=0){explodeAt(v.x,v.y,v.z,6,100);q.wreck=true;}}if(q.wreck&&(S.time*2)%1<dt*2)Fire.ignite(v.x,v.y,3,true);continue;}let c={steer:0,gas:0,brake:0,top:TUNE.carTop};if(S.vehicle===q){const m=I.move;c={steer:m[0],gas:S.seat==='gun'?0:Math.max(-m[1],game.input.value('fire')||0),brake:Math.max(m[1],game.input.value('aim')||0),drift:I.down('jump'),top:TUNE.carTop*(q.hp<q.max*.2?.5:1)};if(I.pressed('seat')||I.pressed('swap')){I.use('seat');I.use('swap');if(q.type==='technical')S.seat=S.seat==='gun'?'drive':'gun';}if(I.pressed('radio')){I.use('radio');S.radio=\"'!S.radio;}if(q.stalled)c.gas=0;if(S.seat==='\"'gun'&&I.down('fire')&&S.fireCd<=0){castShot('choir',[v.x,v.y,v.z+30],frameYP([0,0,0],S.yaw,S.pitch).f);S.fireCd=.12;A.sfx('gun_choir');}}\n else if(q.ai){const road=roads[q.ai.road],p=road[q.ai.index],dx=p[0]*M-v.x,dy=p[1]*M-v.y,angle=Math.atan2(dy,dx),diff=Math.atan2(Math.sin(angle-v.angle),Math.cos(angle-v.angle));c.steer=clamp(diff*2,-1,1);c.gas=.65;if(Math.hypot(dx,dy)<12*M)q.ai.index=(q.ai.index+4)%road.length;if(Math.hypot(hero.x-v.x,hero.y-v.y)<120*M&&q.type==='technical'&&(S.time%1)<dt){if(\"'!hasPapers(q.faction))hurtPlayer(5*TUNE.enemyDamage);}if(v.bumped&&Math.abs(v.speed)<10){q.ai=null;spawnEnemy(v.x+30,v.y,q.faction);spawnEnemy(v.x-30,v.y,q.faction);}}\n if(q.hp<q.max*.2&&rnd()<dt*.08)q.stalled=true;v.update(dt,null,c);if(v.bumped&&Math.abs(v.speed)>120)damageVehicle(q,Math.abs(v.speed)*.08*dt*5);}\n if(S.vehicle){hero.place(S.vehicle.v.x,S.vehicle.v.y,S.vehicle.v.z);hero.vx=hero.vy=hero.vz=0;const rot=S.vehicle.v.angle-(S.prevVehicleAngle??S.vehicle.v.angle);S.yaw+=rot;S.prevVehicleAngle=S.vehicle.v.angle;S.driven=(S.driven||0)+Math.abs(S.vehicle.v.speed)*dt/M;if(S.radio&&S.time-(S.lastRadio||0)>28){S.lastRadio=S.time;say('\"'Papa Static',RADIO[Math.floor(rnd()*RADIO.length)]);}}else S.prevVehicleAngle=null;\n}\nfunction spawnPatrol(faction='authority'){const p=POSTS.find(p=>p.faction===faction&&\"'!p.clear);if(!p)return;const q=makeVehicle('\"'technical',p.x+10*M,p.y,{faction,ai:{road:Math.max(0,ROADS.findIndex(r=>r[0]===p.a&&r[1]===p.b)),index:0}});return q;}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/my-3d2dge-3d.js');s=p.read_text().replace('vehicleParts(this.pen, a, t);','if (a.o.draw) a.o.draw(this.pen, a, t); else vehicleParts(this.pen, a, t);');p.write_text(s)\np=Path('ENGINE-CHANGES.md');p.write_text('# Engine patches\\\\n- World3D vehicle draw seam (line 3006): call \"'`o.draw(pen, actor, time)` when supplied, so native physics vehicles can use original jeep, technical, truck and airboat models.'\"\\\\n')\np=Path('src/30-player.js');s=p.read_text().replace('setupPeople();initBuddies();world.camera','setupPeople();initBuddies();setupVehicles();world.camera').replace('fireStep(dt);aiStep(dt);','fireStep(dt);vehicleStep(dt,input);aiStep(dt);');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"cat > src/50-vehicles.js <<'EOF'\nfunction drawVehicle(pen,a,t){const q=vehicles.find(q=>q.v===a),type=q?.type||'jeep',col=q?.clinic?'#d0cbb0':type==='technical'?'#696d4a':'#897548',dark='#30382d';pen.at(a.x,a.y,a.z,a.angle);if(type==='airboat'){pen.box(0,0,3,62,29,5,col).box(1,0,7,20,17,3,dark);for(let i=0;i<16;i++){const an=i/16*TAU;pen.tube(-24,Math.cos(an)*13,17+Math.sin(an)*13,-24,Math.cos(an+.4)*13,17+Math.sin(an+.4)*13,.4,'#686e58');}for(let i=0;i<3;i++){const an=t*35+i*TAU/3;pen.tube(-23,0,17,-23,Math.cos(an)*11,17+Math.sin(an)*11,.9,'#4d5545');}}\n else{const truck=type==='truck',L=truck?78:58;pen.box(0,0,7,L,26,7,col).box(13,0,13,21,25,5,col).box(-11,0,10,18,23,4,'#343b2e');for(const x of [-20,20])for(const y of [-15,15]){pen.tube(x,y-3,4,x,y+3,4,6,'#262c24').tube(x,y-3.2,4,x,y+3.2,4,3,'#a29267');}for(const y of [-12,12])pen.tube(4,y,16,4,y,31,.4,dark).tube(4,y,31,-8,y,31,.4,dark);pen.tube(4,-12,31,4,12,31,.5,dark);pen.box(25,0,11,2,23,2,dark);for(const y of [-8,8])pen.box(26,y,15,1,5,4,'#cfbd7e');for(let y=-7;y<8;y+=3)pen.box(26,y,11,1,1,5,'#484d38');if(truck)pen.box(-21,0,23,38,25,25,'#76785b');if(type==='technical'){pen.tube(-17,0,10,-17,0,30,.6,dark).tube(-17,0,30,7,0,32,.5,dark).box(-18,0,31,5,3,3,'#404734');}if(q?.clinic){pen.box(14,0,16,9,3,.2,'#863d2d').box(14,0,16.1,3,9,.2,'#863d2d');}}\n if(q&&q.hp<q.max*.5){const n=Math.floor(t*5)%5;pen.ball(16,0,24+n*5,3+n*2,3+n*2,4+n*2,q.hp<q.max*.2?'#35362d':'#aaa999');}pen.at();}\nfunction makeVehicle(type,x,y,o={}){const spec=V_TYPES[type],surfaces=type==='airboat'?{brine:{top:1},reeds:{top:1},mud:{top:.5},salt:{top:.35},grass:{top:.25},road:{top:.25},pad:{top:.25}}:{road:{top:1},grass:{top:.7},salt:{top:.95,grip:.6},mud:{top:.5},reeds:{top:.4},brine:{top:.3},pad:{top:.85}};const v=world.vehicle({...spec,x,y,z:height(x,y)+2,angle:o.angle||0,ground:(x,y)=>biomeAt(x/M,y/M),surfaces,color:'#897548',draw:drawVehicle});const q={id:'vehicle'+vehicles.length,type,v,hp:spec.hp,max:spec.hp,stalled:false,burn:0,ai:null,...o};vehicles.push(q);return q;}\nfunction setupVehicles(){makeVehicle('jeep',OP.mission.x+14*M,OP.mission.y+5*M,{clinic:true,angle:-Math.PI/2});makeVehicle('jeep',OP.strip.x+5*M,OP.strip.y+10*M);makeVehicle('technical',OP.k9.x+12*M,OP.k9.y+12*M);makeVehicle('airboat',OP.remnant.x,OP.remnant.y);makeVehicle('truck',OP.salt.x+12*M,OP.salt.y+3*M,{bank:true});makeVehicle('jeep',OP.tannery.x+12*M,OP.tannery.y+14*M);}\nfunction enterVehicle(q){if(q.hp<=0)return false;S.vehicle=q;S.yaw=q.v.angle;S.seat='drive';hero.setSolid(false);hero.fly=true;S.tool=null;A.sfx('engine');say('Papa Static',RADIO[Math.floor(rnd()*RADIO.length)]);return true;}\nfunction exitVehicle(){const q=S.vehicle;if(\"'!q)return;const v=q.v;for(let i=0;i<8;i++){const a=v.angle+Math.PI/2+i*Math.PI/4,x=v.x+Math.cos(a)*30,y=v.y+Math.sin(a)*30,z=height(x,y)+1;if(!world.ray(x,y,z+3,0,0,1,30,{skip:[hero,v],level:true})){hero.place(x,y,z);break;}}hero.fly=false;hero.setSolid(true);S.vehicle=null;A.sfx('\"'door');}\nfunction damageVehicle(q,d){if(q.hp<=0)return;q.hp=Math.max(0,q.hp-d);if(q.hp<=0){q.burn=3;if(S.vehicle===q){exitVehicle();hurtPlayer(35);}Fire.ignite(q.v.x,q.v.y,4,true);} }\nfunction repairVehicle(q){if(q.hp<=0||S.act)return false;act('repair',S.merc===2?2:4,()=>{q.hp=Math.max(q.hp,q.max*.6);q.stalled=false;A.sfx('rack');});return true;}\nfunction vehicleStep(dt,I){for(const q of vehicles){const v=q.v;if(q.hp<=0){v.update(dt,null,{brake:1});if(q.burn>0){q.burn-=dt;if(q.burn<=0){explodeAt(v.x,v.y,v.z,6,100);q.wreck=true;}}if(q.wreck&&(S.time*2)%1<dt*2)Fire.ignite(v.x,v.y,3,true);continue;}let c={steer:0,gas:0,brake:0,top:TUNE.carTop};if(S.vehicle===q){const m=I.move;c={steer:m[0],gas:S.seat==='gun'?0:Math.max(-m[1],game.input.value('fire')||0),brake:Math.max(m[1],game.input.value('aim')||0),drift:I.down('jump'),top:TUNE.carTop*(q.hp<q.max*.2?.5:1)};if(I.pressed('seat')||I.pressed('swap')){I.use('seat');I.use('swap');if(q.type==='technical')S.seat=S.seat==='gun'?'drive':'gun';}if(I.pressed('radio')){I.use('radio');S.radio=\"'!S.radio;}if(q.stalled)c.gas=0;if(S.seat==='\"'gun'&&I.down('fire')&&S.fireCd<=0){castShot('choir',[v.x,v.y,v.z+30],frameYP([0,0,0],S.yaw,S.pitch).f);S.fireCd=.12;A.sfx('gun_choir');}}\n else if(q.ai){const road=roads[q.ai.road],p=road[q.ai.index],dx=p[0]*M-v.x,dy=p[1]*M-v.y,angle=Math.atan2(dy,dx),diff=Math.atan2(Math.sin(angle-v.angle),Math.cos(angle-v.angle));c.steer=clamp(diff*2,-1,1);c.gas=.65;if(Math.hypot(dx,dy)<12*M)q.ai.index=(q.ai.index+4)%road.length;if(Math.hypot(hero.x-v.x,hero.y-v.y)<120*M&&q.type==='technical'&&(S.time%1)<dt){if(\"'!hasPapers(q.faction))hurtPlayer(5*TUNE.enemyDamage);}if(v.bumped&&Math.abs(v.speed)<10){q.ai=null;spawnEnemy(v.x+30,v.y,q.faction);spawnEnemy(v.x-30,v.y,q.faction);}}\n if(q.hp<q.max*.2&&rnd()<dt*.08)q.stalled=true;v.update(dt,null,c);if(v.bumped&&Math.abs(v.speed)>120)damageVehicle(q,Math.abs(v.speed)*.08*dt*5);}\n if(S.vehicle){hero.place(S.vehicle.v.x,S.vehicle.v.y,S.vehicle.v.z);hero.vx=hero.vy=hero.vz=0;const rot=S.vehicle.v.angle-(S.prevVehicleAngle??S.vehicle.v.angle);S.yaw+=rot;S.prevVehicleAngle=S.vehicle.v.angle;S.driven=(S.driven||0)+Math.abs(S.vehicle.v.speed)*dt/M;if(S.radio&&S.time-(S.lastRadio||0)>28){S.lastRadio=S.time;say('\"'Papa Static',RADIO[Math.floor(rnd()*RADIO.length)]);}}else S.prevVehicleAngle=null;\n}\nfunction spawnPatrol(faction='authority'){const p=POSTS.find(p=>p.faction===faction&&\"'!p.clear);if(!p)return;const q=makeVehicle('\"'technical',p.x+10*M,p.y,{faction,ai:{road:Math.max(0,ROADS.findIndex(r=>r[0]===p.a&&r[1]===p.b)),index:0}});return q;}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/my-3d2dge-3d.js');s=p.read_text().replace('vehicleParts(this.pen, a, t);','if (a.o.draw) a.o.draw(this.pen, a, t); else vehicleParts(this.pen, a, t);');p.write_text(s)\np=Path('ENGINE-CHANGES.md');p.write_text('# Engine patches\\\\n- World3D vehicle draw seam (line 3006): call \"'`o.draw(pen, actor, time)` when supplied, so native physics vehicles can use original jeep, technical, truck and airboat models.'\"\\\\n')\np=Path('src/30-player.js');s=p.read_text().replace('setupPeople();initBuddies();world.camera','setupPeople();initBuddies();setupVehicles();world.camera').replace('fireStep(dt);aiStep(dt);','fireStep(dt);vehicleStep(dt,input);aiStep(dt);');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
