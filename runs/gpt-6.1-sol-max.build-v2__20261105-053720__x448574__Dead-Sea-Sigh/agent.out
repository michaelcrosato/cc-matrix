{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > src/35-health.js <<'EOF'\nfunction act(name,dur,done){S.act=name;S.actT=0;S.actDur=dur;S.actDone=done||null;}\nfunction actionStep(dt){if(\"'!S.act)return;S.actT+=dt;if(S.actT>=S.actDur){const done=S.actDone;S.act=null;S.actDone=null;if(done)done();}}\nfunction useAmpoule(){if(!S.ampoules||S.act==='\"'surgery')return false;S.ampoules--;S.lung=0;S.fit=0;S.healHold=-1;act('ampoule',1.1);A.sfx('heal');say(MERCS[S.merc].name,'One less in the box.');return true;}\nfunction heal(){if(S.act)return false;if(S.hp<=20){S.surgeryKind=Math.floor(rnd()*4);act('surgery',S.merc===1?3.75:5,()=>{S.hp=60;S.blood=true;});A.sfx('surgery');return true;}if(S.syrettes&&S.hp<100){S.syrettes--;act('heal',.9,()=>{S.hp=Math.min(100,S.hp+40);});A.sfx('heal');return true;}return false;}\nfunction fitStart(){if(CHEATS.noFits)return;const rapid=S.time-S.lastFit<180;S.lastFit=S.time;S.fit=S.ampoules>0?6:14;S.lung=100;S.fitPulse=0;A.sfx('cough');noise(hero.x,hero.y,40);if(\"'!S.ampoules&&rapid){hurtPlayer(1000);return;}say(MERCS[S.merc].name,S.ampoules?prompt('\"'heal','Ampoule. Now.'):'No ampoules. Breathe through it.');}\nfunction healthStep(dt,I){if(\"'!S.alive||S.down)return;if(S.hp>0&&S.time-S.lastDamage>6&&S.hp%20>.001)S.hp=Math.min(Math.ceil(S.hp/20)*20,S.hp+6*dt);if(S.rescueCd>0)S.rescueCd-=dt;if(!CHEATS.noFits){S.lung+=dt*(100/840)*TUNE.lung*(S.storm>0?4:1)*(Fire.near(hero.x,hero.y,15)?6:1)*(S.sprint?1.5:1);if(S.lung>=100&&S.fit<=0)fitStart();if(S.lung>=85&&S.lung-dt*.2<85)A.sfx('\"'breath');}if(S.fit>0){S.fit-=dt;S.fitPulse=(S.fitPulse||0)+dt;if(S.fitPulse>.9){S.fitPulse=0;A.sfx('cough'+(Math.floor(rnd()*4)));noise(hero.x,hero.y,40);}if(S.fit<=0)S.lung=30;}\n if(I.pressed('heal')&&S.fit>0){I.use('heal');useAmpoule();}else if(I.down('heal')){S.healHold=Math.max(0,S.healHold??0)+dt;if(S.healHold>=.4&&\"'!S.act)useAmpoule();}else if((S.healHold??-1)>=0){if(S.healHold<.4)heal();S.healHold=-1;}\n}\nfunction hurtPlayer(damage,angle=0){if(CHEATS.god||S.attract||!S.alive||S.down)return;S.hp=Math.max(0,S.hp-damage);S.lastDamage=S.time;S.hurtT=.5;S.hitDir=angle;A.sfx('\"'hurt',{vol:.5});game.input.rumble?.(.3,.5,150);if(S.hp<=0){if(S.mode==='salvage'){salvageDeath();return;}if(\"'!buddyRescue()){S.alive=false;S.act=null;game.go('\"'dead');}}}\nEOF\ncat > src/40-weapons.js <<'EOF'\nfunction equip(id){if(\"'!S.inventory[id])return;S.cur=id;S.act=null;S.tool=null;A.sfx('\"'rack');}\nfunction giveGun(id,cond=1){const W=WEAPONS[id];S.inventory[id]={cond,mag:W.mag,reserve:W.reserve,jammed:false};const i=['side','primary','heavy'].indexOf(W.slot);const old=S.slots[i];S.slots[i]=id;if(old&&old\"'!==id)delete S.inventory[old];equip(id);}\nfunction startReload(){if(S.act)return;const g=S.inventory[S.cur],w=WEAPONS[S.cur];if(!g)return;if(g.jammed){act('\"'jam',1.3,()=>{g.jammed=false;A.sfx('rack');});A.sfx('rack');}else if(g.mag<w.mag&&g.reserve>0){act('reload',w.reload,()=>{const n=Math.min(w.mag-g.mag,g.reserve);g.mag+=n;g.reserve-=n;A.sfx('rack');});A.sfx('reload');}}\nfunction gunShot(){if(S.act||S.fireCd>0)return false;const g=S.inventory[S.cur],w=WEAPONS[S.cur];if(\"'!g)return false;if(g.jammed){S.fireCd=.25;A.sfx('\"'jam');return false;}if(g.mag<=0){A.sfx('jam');S.fireCd=.3;return false;}if(g.cond<.7&&\"'!CHEATS.noJams&&rnd()<TUNE.jam*w.jam*.09*(1-g.cond/.7)**2){g.jammed=true;A.sfx('\"'jam');S.fireCd=.3;S.jams=(S.jams||0)+1;return false;}if(g.cond<.15&&rnd()<.08){A.sfx('jam');S.fireCd=.4;return false;}\n if(\"'!CHEATS.ammo)g.mag--;g.cond=Math.max(0,g.cond-w.wear*TUNE.wear*(S.merc===3&&S.cur==='\"'sexton'?.5:1));S.shots++;S.lastShot=S.time;S.flash=1;S.fireCd=1/w.rate;S.pitch=clamp(S.pitch+(w.slot==='side'?.018:w.rate<2?.045:.007),-1.45,1.45);S.tool=null;A.sfx('gun_'+w.id);game.input.rumble?.(.2,.6,70);noise(hero.x,hero.y,150);burnPapers();\n const eye=[hero.x,hero.y,hero.z+S.eye],F=frameYP(eye,S.yaw,S.pitch);for(let i=0;i<w.pellets;i++){const spread=S.ads?.002:w.hip*(S.tool==='locator'?2:1),D=nrm(add(add(F.f,F.r,(rnd()-.5)*spread),F.u,(rnd()-.5)*spread));castShot(w.id,eye,D,hero);if(inSession&&\"'!AIHub.isHost)queueShot(w.id,eye,D);}\n if(g.cond<=0){say(MERCS[S.merc].name,'\"'That was the last thing it had to say.');loot.push({id:'broken'+S.time,x:hero.x,y:hero.y,z:hero.z,weapon:S.cur,cond:0});const i=S.slots.indexOf(S.cur);if(i>=0)S.slots[i]=null;delete S.inventory[S.cur];S.cur=S.slots.find(Boolean)||'verger';if(\"'!S.inventory[S.cur])S.inventory[S.cur]={cond:0,mag:0,reserve:0,jammed:true};A.sfx('\"'break');}return true;\n}\nfunction castShot(id,eye,D,owner=hero){const w=WEAPONS[id],range=w.range*M,hit=world.ray(...eye,...D,range,{skip:owner}),p=hit?[hit.x,hit.y,hit.z]:add(eye,D,range);if(\"'!NO_RENDER)tracer(add(eye,D,12),p);if(inSession&&!AIHub.isHost)return;\n if(id==='\"'gardener'){for(let d=2;d<13;d+=2)Fire.ignite(eye[0]+D[0]*d*M,eye[1]+D[1]*d*M,2);}\n if(id==='bishop'){explodeAt(...p,7,200);return;}if(id==='acolyte')Fire.ignite(p[0],p[1],4,true);if(hit){const e=hit.actor?.data?.entity;if(e)hurtEnemy(e,w.dmg*TUNE.playerDamage*(p[2]>e.a.z+24?2:1),p[2]>e.a.z+24);else if(hit.actor?.data?.remote)netDamage(hit.actor.data.remote,w.dmg);if(\"'!NO_RENDER)decal(p,[hit.nx||0,hit.ny||0,hit.nz||1],.5);}\n for(const v of vehicles){if(v.hp<=0)continue;const f=dot(sub([v.v.x,v.v.y,v.v.z+10],eye),D);if(f>0&&f<Math.min(range,hit?.dist??range)+30&&Math.hypot(...sub(add(eye,D,f),[v.v.x,v.v.y,v.v.z+10]))<23){damageVehicle(v,id==='\"'bishop'?140:w.dmg*.45);break;}}\n for(const b of barrels){if(b.dead)continue;const f=dot(sub([b.x,b.y,b.z+8],eye),D);if(f>0&&f<Math.min(range,hit?.dist??range)+10&&Math.hypot(...sub(add(eye,D,f),[b.x,b.y,b.z+8]))<12){b.hp-=w.dmg;if(b.hp<=0)barrelBoom(b);}}\n if(id==='choir'&&rnd()<.02)Fire.ignite(p[0],p[1],2);\n}\nfunction throwObject(kind){if(S.act)return;if(kind==='bottle'?\"'!S.bottles:!S.nades)return;S.throwKind=kind;act('\"'throw',.7,()=>{if(kind==='bottle')S.bottles--;else S.nades--;const F=frameYP([hero.x,hero.y,hero.z+S.eye],S.yaw,S.pitch);const p=add(F.o,F.f,9);nades.push({kind,x:p[0],y:p[1],z:p[2],vx:F.f[0]*340+hero.vx*.4,vy:F.f[1]*340+hero.vy*.4,vz:F.f[2]*340+55,t:0});A.sfx('throw');});}\nfunction stepNades(dt){for(const n of nades.slice()){const p=[n.x,n.y,n.z];n.vz-=GRAV*dt;const D=[n.vx*dt,n.vy*dt,n.vz*dt],len=Math.hypot(...D);const h=world.ray(...p,...nrm(D),len+1,{skip:hero});n.x+=D[0];n.y+=D[1];n.z+=D[2];n.t+=dt;if(h||n.z<height(n.x,n.y)+2||n.t>2.3){if(n.kind==='bottle'){Fire.ignite(n.x,n.y,S.merc===0?8:6,true);A.sfx('glass');}else explodeAt(n.x,n.y,n.z,7,110);nades.splice(nades.indexOf(n),1);}}}\nfunction explodeAt(x,y,z,r=7,damage=110){Fire.ignite(x,y,4,true);A.sfx('explode');game.shake(5);for(const e of raiders)if(e.alive){const d=Math.hypot(e.a.x-x,e.a.y-y,e.a.z-z)/M;if(d<r)hurtEnemy(e,damage*(1-d/r),true);}for(const v of vehicles){const d=Math.hypot(v.v.x-x,v.v.y-y)/M;if(d<r)damageVehicle(v,140*(1-d/r));}const d=Math.hypot(hero.x-x,hero.y-y,hero.z-z)/M;if(d<r)hurtPlayer(damage*(1-d/r));for(const b of barrels)if(\"'!b.dead&&Math.hypot(b.x-x,b.y-y)<r*M){b.dead=true;Fire.ignite(b.x,b.y,8,true);} }\nfunction actions(dt,I){S.fireCd=Math.max(0,S.fireCd-dt);S.ads=I.down('\"'aim')&&\"'!S.tool&&!S.act;actionStep(dt);if(S.act==='\"'surgery')return;\n for(const [i,a]of ['one','two','three'].entries())if(I.pressed(a)){I.use(a);if(S.slots[i])equip(S.slots[i]);}\n if(I.pressed('swap')){I.use('swap');const ids=S.slots.filter(Boolean);equip(ids[(ids.indexOf(S.cur)+1)%ids.length]);}\n if(I.pressed('reload')){I.use('reload');startReload();}\n for(const tool of ['map','locator','monocular'])if(I.pressed(tool)){I.use(tool);S.tool=S.tool===tool?null:tool;S.toolT=0;A.sfx('paper');}\n if(S.tool==='map'&&I.pressed('fire')){I.use('fire');S.waypoint=[S.pencil[0]*SIZE,S.pencil[1]*SIZE];A.sfx('beep');return;}\n if((WEAPONS[S.cur]?.auto?I.down('fire'):I.pressed('fire'))&&\"'!S.vehicle){if(S.tool){S.tool=null;A.sfx('\"'paper');}if(gunShot())I.use('fire');}\n if(I.pressed('bottle')){I.use('bottle');throwObject('bottle');}if(I.pressed('grenade')){I.use('grenade');throwObject('frag');}\n if(I.pressed('melee')&&\"'!S.act){I.use('\"'melee');act('melee',.6,()=>{for(const e of raiders)if(e.alive&&Math.hypot(e.a.x-hero.x,e.a.y-hero.y)<3*M&&Math.cos(Math.atan2(e.a.y-hero.y,e.a.x-hero.x)-S.yaw)>.4){hurtEnemy(e,60,false);break;}const d=doors.find(d=>Math.hypot(d.x-hero.x,d.y-hero.y)<3*M);if(d)d.open=true;});A.sfx('swing');}\n if(I.pressed('use')){I.use('use');if(S.near)useNear(S.near);else if(S.vehicle)exitVehicle();else startReload();}\n if(S.tool==='monocular'){const F=frameYP([hero.x,hero.y,hero.z+S.eye],S.yaw,S.pitch);let tag=null;for(const e of raiders)if(e.alive){const D=nrm(sub([e.a.x,e.a.y,e.a.z+20],F.o));if(dot(D,F.f)>.996)tag=e;}if(tag){S.tagTime=(S.tagTarget===tag.id?S.tagTime:0)+dt;S.tagTarget=tag.id;if(S.tagTime>.6&&\"'!S.tags.includes(tag.id)){S.tags.push(tag.id);A.sfx('\"'beep');}}}\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('src/30-player.js');s=p.read_text().replace('look(dt,input);if(S.alive&&\"'!S.down){move(dt,input);}'\"','look(dt,input);if(S.alive&&\"'!S.down){move(dt,input);actions(dt,input);healthStep(dt,input);}stepNades(dt);'\"')\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > src/35-health.js <<'EOF'\nfunction act(name,dur,done){S.act=name;S.actT=0;S.actDur=dur;S.actDone=done||null;}\nfunction actionStep(dt){if(\"'!S.act)return;S.actT+=dt;if(S.actT>=S.actDur){const done=S.actDone;S.act=null;S.actDone=null;if(done)done();}}\nfunction useAmpoule(){if(!S.ampoules||S.act==='\"'surgery')return false;S.ampoules--;S.lung=0;S.fit=0;S.healHold=-1;act('ampoule',1.1);A.sfx('heal');say(MERCS[S.merc].name,'One less in the box.');return true;}\nfunction heal(){if(S.act)return false;if(S.hp<=20){S.surgeryKind=Math.floor(rnd()*4);act('surgery',S.merc===1?3.75:5,()=>{S.hp=60;S.blood=true;});A.sfx('surgery');return true;}if(S.syrettes&&S.hp<100){S.syrettes--;act('heal',.9,()=>{S.hp=Math.min(100,S.hp+40);});A.sfx('heal');return true;}return false;}\nfunction fitStart(){if(CHEATS.noFits)return;const rapid=S.time-S.lastFit<180;S.lastFit=S.time;S.fit=S.ampoules>0?6:14;S.lung=100;S.fitPulse=0;A.sfx('cough');noise(hero.x,hero.y,40);if(\"'!S.ampoules&&rapid){hurtPlayer(1000);return;}say(MERCS[S.merc].name,S.ampoules?prompt('\"'heal','Ampoule. Now.'):'No ampoules. Breathe through it.');}\nfunction healthStep(dt,I){if(\"'!S.alive||S.down)return;if(S.hp>0&&S.time-S.lastDamage>6&&S.hp%20>.001)S.hp=Math.min(Math.ceil(S.hp/20)*20,S.hp+6*dt);if(S.rescueCd>0)S.rescueCd-=dt;if(!CHEATS.noFits){S.lung+=dt*(100/840)*TUNE.lung*(S.storm>0?4:1)*(Fire.near(hero.x,hero.y,15)?6:1)*(S.sprint?1.5:1);if(S.lung>=100&&S.fit<=0)fitStart();if(S.lung>=85&&S.lung-dt*.2<85)A.sfx('\"'breath');}if(S.fit>0){S.fit-=dt;S.fitPulse=(S.fitPulse||0)+dt;if(S.fitPulse>.9){S.fitPulse=0;A.sfx('cough'+(Math.floor(rnd()*4)));noise(hero.x,hero.y,40);}if(S.fit<=0)S.lung=30;}\n if(I.pressed('heal')&&S.fit>0){I.use('heal');useAmpoule();}else if(I.down('heal')){S.healHold=Math.max(0,S.healHold??0)+dt;if(S.healHold>=.4&&\"'!S.act)useAmpoule();}else if((S.healHold??-1)>=0){if(S.healHold<.4)heal();S.healHo