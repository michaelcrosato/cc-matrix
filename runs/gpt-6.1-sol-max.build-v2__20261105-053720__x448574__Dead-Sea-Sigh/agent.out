sync = C ? C.sync : false, now = this._now(sync); let t = now;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"sed -n '3918,3949p' engine/my-3d2dge.js && sed -n '268,279p' engine-repo/tools/kit3d-test.mjs && cat > test/hub_check.py <<'EOF'\nfrom pathlib import Path\nimport subprocess,re,threading,shutil,json\nfrom urllib.parse import quote\nfrom playwright.sync_api import sync_playwright\nR=Path(__file__).resolve().parent.parent\n\ndef run_hub(p,render=False,scenarios=None):\n shutil.copyfile(R.parent/(R.name+'.html'),R/'hub/game.html')\n srv=subprocess.Popen(['python3','-u','-m','http.server','0','--bind','127.0.0.1'],cwd=R/'hub',stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)\n line=srv.stdout.readline();port=int(re.search(r'port (\\\\d+)',line).group(1));threading.Thread(target=lambda:[None for _ in srv.stdout],daemon=True).start()\n out=[]\n try:\n  b=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required','--use-angle=swiftshader','--enable-webgl'])\n  page=b.new_page(viewport={'width':1280,'height':800})\n  errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n  for n,scenario in scenarios or [(1,'standard'),(2,'standard'),(4,'standard'),(4,'host-leave'),(2,'server')]:\n   game='game.html'+('' if render else '?norender=1')\n   url=f'http://127.0.0.1:{port}/harness.html?game={quote(game,safe=\\\"\\\")}&players={n}&latency=150&jitter=50&loss=5&auto=1&scenario={scenario}&play=8000'\n   page.goto(url);page.wait_for_selector('body[data-complete=\\\"true\\\"]',timeout=240000)\n   report=page.evaluate('window.__hubCheck');out.append({'name':f'hub {n} {scenario} '+('render' if render else 'fast'),'pass':report.get('pass',False),'detail':report})\n  b.close()\n finally:srv.terminate();srv.wait(timeout=10)\n return out\nif __name__=='__main__':\n with sync_playwright() as p:\n  for r in run_hub(p):print(json.dumps(r))\nEOF\npython3 test/hub_check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_68","type":"agent_message","text":"The campaign bot now completes every contract and reaches the helicopter ending. The core suite passes 19/19 checks, covering fire spread and saves, jams, surgery, vehicles, papers, and both kinds of buddy rescue. Next are the other endings, controller and viewport checks, and multiplayer harness tests.\n"}}
{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"sed -n '3918,3949p' engine/my-3d2dge.js && sed -n '268,279p' engine-repo/tools/kit3d-test.mjs && cat > test/hub_check.py <<'EOF'\nfrom pathlib import Path\nimport subprocess,re,threading,shutil,json\nfrom urllib.parse import quote\nfrom playwright.sync_api import sync_playwright\nR=Path(__file__).resolve().parent.parent\n\ndef run_hub(p,render=False,scenarios=None):\n shutil.copyfile(R.parent/(R.name+'.html'),R/'hub/game.html')\n srv=subprocess.Popen(['python3','-u','-m','http.server','0','--bind','127.0.0.1'],cwd=R/'hub',stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)\n line=srv.stdout.readline();port=int(re.search(r'port (\\\\d+)',line).group(1));threading.Thread(target=lambda:[None for _ in srv.stdout],daemon=True).start()\n out=[]\n try:\n  b=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required','--use-angle=swiftshader','--enable-webgl'])\n  page=b.new_page(viewport={'width':1280,'height':800})\n  errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n  for n,scenario in scenarios or [(1,'standard'),(2,'standard'),(4,'standard'),(4,'host-leave'),(2,'server')]:\n   game='game.html'+('' if render else '?norender=1')\n   url=f'http://127.0.0.1:{port}/harness.html?game={quote(game,safe=\\\"\\\")}&players={n}&latency=150&jitter=50&loss=5&auto=1&scenario={scenario}&play=8000'\n   page.goto(url);page.wait_for_selector('body[data-complete=\\\"true\\\"]',timeout=240000)\n   report=page.evaluate('window.__hubCheck');out.append({'name':f'hub {n} {scenario} '+('render' if render else 'fast'),'pass':report.get('pass',False),'detail':report})\n  b.close()\n finally:srv.terminate();srv.wait(timeout=10)\n return out\nif __name__=='__main__':\n with sync_playwright() as p:\n  for r in run_hub(p):print(json.dumps(r))\nEOF\npython3 test/hub_check.py\"","aggregated_output":"  /** save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept\n   *  (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save */\n  save(slot, o) {\n    if (!this._ok(slot)) { warn('saves:slot:' + slot, 'game.saves: no slot ' + slot + ' (0 to ' + (this.slots - 1) + ', or \"auto\")'); return false; }\n    if (!o && this.write) try { o = this.write(slot); } catch (e) { this.game.fail('saves.write', e); return false; }\n    if (!o || !('data' in o)) { warn('saves:write', 'game.saves: nothing to save: give save(slot, { data, place, level }) or set saves.write'); return false; }\n    let text; try { text = JSON.stringify({ v: SAVE_FORMAT, version: this.version, data: o.data, place: o.place || '', level: o.level === undefined ? null : o.level, time: Math.round(this.played * 10) / 10, at: Date.now() }); }\n    catch (e) { this.game.fail('saves.save', e); return false; }\n    this._put(slot, text); return true;\n  }\n  /** save to the autosave (what write() gives) */\n  autosave(o) { return this.save('auto', o); }\n  /** load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save\n   *  ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version */\n  load(slot) {\n    const s = this.get(slot); if (!s || s.damaged || s.newer) return null;\n    if (s.version < this.version && this.migrate) try { s.data = this.migrate(s.data, s.version); } catch (e) { this.game.fail('saves.migrate', e); return null; }\n    this.played = s.time;\n    if (this.read) try { this.read(s); } catch (e) { this.game.fail('saves.read', e); return null; }\n    return s;\n  }\n  /** copy a slot's save onto another (over what is there); false when the first is empty */\n  copy(from, to) { if (!this._ok(from) || !this._ok(to)) return false; const t = this._raw(from); if (t === null || t === undefined) return false; this._put(to, t); return true; }\n  /** erase a slot */\n  erase(slot) { if (this._ok(slot)) this._put(slot, null); }\n  /** is there any save to load (a title's Continue)? */\n  get any() { return this.list().some(s => !s.empty && !s.damaged && !s.newer); }\n  /** the most recent save that loads, or null (a title's Continue loads it) */\n  latest() { return this.list().filter(s => !s.empty && !s.damaged && !s.newer).sort((a, b) => b.at - a.at)[0] || null; }\n  /** open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or\n   *  a save. False without a menu (a headless game, menu: false) */\n  show(mode = 'load', done) {\n    const buf = d.createBuffer({ size: bpr * h, usage: GPUBufferUsage.COPY_DST | GPUBufferUsage.MAP_READ }), enc = d.createCommandEncoder();\n    enc.copyTextureToBuffer({ texture: t }, { buffer: buf, bytesPerRow: bpr }, [w, h]); d.queue.submit([enc.finish()]);\n    await buf.mapAsync(GPUMapMode.READ); const src = new Uint8Array(buf.getMappedRange()), img = new ImageData(w, h), bgra = /^bgra/.test(window.__frameFormat);\n    for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) { const i = y * bpr + x * 4, o = (y * w + x) * 4; img.data[o] = src[i + (bgra ? 2 : 0)]; img.data[o + 1] = src[i + 1]; img.data[o + 2] = src[i + (bgra ? 0 : 2)]; img.data[o + 3] = 255; }\n    buf.unmap(); buf.destroy();\n    const a = document.createElement('canvas'); a.width = w; a.height = h; a.getContext('2d').putImageData(img, 0, 0);\n    const b = document.createElement('canvas'); b.width = w * scale; b.height = h * scale; const g = b.getContext('2d'); g.imageSmoothingEnabled = false; g.drawImage(a, 0, 0, b.width, b.height);\n    return b.toDataURL('image/png');\n  };\n}\nconst watch = page => { const errors = []; page.on('pageerror', e => errors.push(String(e))); page.on('console', m => { if (m.type() === 'error' && !/Failed to load resource/.test(m.text())) errors.push('console: ' + m.text()); }); return errors; };\nlet pictures = 0;\n{\"name\": \"hub 1 standard fast\", \"pass\": true, \"detail\": {\"done\": true, \"pass\": true, \"game\": \"game.html?norender=1\", \"players\": 1, \"scenario\": \"standard\", \"checks\": [{\"name\": \"head metas\", \"pass\": true, \"detail\": \"hub:session=1 mode=shared-world\"}, {\"name\": \"hub:session-players is a range within 1\\u20134\", \"pass\": true, \"detail\": \"hub:session-players=1-4\"}, {\"name\": \"hub:session-minutes, when given, is a number\", \"pass\": true, \"detail\": \"hub:session-minutes=6\"}, {\"name\": \"every copy says hello\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"hello names protocol 1 and the mode\", \"pass\": true, \"detail\": \"{\\\"v\\\":1,\\\"client\\\":\\\"1.4.0\\\",\\\"mode\\\":\\\"shared-world\\\",\\\"seats\\\":[1,4],\\\"card\\\":false}\"}, {\"name\": \"hello seats cover this player count\", \"pass\": true, \"detail\": \"[1,4]\"}, {\"name\": \"ready without a key press (the card asks the players)\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"the round starts when the card ends\", \"pass\": true, \"detail\": \"countdown\"}, {\"name\": \"game traffic flows both ways\", \"pass\": true, \"detail\": \"p0 \\u219163 \\u21930\"}, {\"name\": \"the round ends with a valid result\", \"pass\": true, \"detail\": \"played (finished)\"}, {\"name\": \"every remaining copy is told the round ended\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"no protocol problems\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"no errors, dialogs, popups or sockets\", \"pass\": true, \"detail\": \"\"}], \"log\": [\"   0.11  round 1: 1 player, seed 3211916135, limit 540 s, mode shared-world\", \"   0.38  p0 \\u2192 hub: hello\", \"   0.68  hub \\u2192 p0: welcome\", \"   0.83  p0 \\u2192 hub: ready\", \"   0.89  splash over: the round starts once every game has loaded\", \"   2.00  hub \\u2192 p0: start in 1886 ms\", \"   9.69  hub \\u2192 p0: time-up\", \"   9.89  p0 \\u2192 hub: finish [[0]]\", \"   9.89  round 1 played: finished \\u2014 standings [[0]]\", \"  10.09