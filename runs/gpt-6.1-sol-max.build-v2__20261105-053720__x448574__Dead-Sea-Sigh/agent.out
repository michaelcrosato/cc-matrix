{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"cat > test/integration.py <<'EOF'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nR=Path(__file__).resolve().parent.parent\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required'])\n page=b.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n page.goto((R.parent/(R.name+'.html')).as_uri()+'?norender=1&backend=webgl');page.wait_for_function('__game?.ready',timeout=90000);page.evaluate('__game.game.stop()')\n try:\n  result=page.evaluate('() => __game.Bot.playthrough(\\\"contract\\\")')\n  print(result)\n  print('state',page.evaluate('() => ({c:__game.S.contract,s:__game.S.step,card:__game.S.card?.title,alive:__game.S.alive,act:__game.S.act,near:__game.S.near?.kind})'))\n except Exception as e:print(str(e))\n print('errors',errors)\n b.close()\nEOF\npython3 test/integration.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
