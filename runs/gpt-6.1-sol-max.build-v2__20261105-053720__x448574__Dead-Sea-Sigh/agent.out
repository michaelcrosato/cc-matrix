e.jam-dt);if(e.dragging){const w=e.dragging;if(!w.alive||!w.wounded){e.dragging=null;continue;}const angle=S.windDir+Math.PI/2;a.vx=Math.cos(angle)*22;a.vy=Math.sin(angle)*22;e.yaw=angle;e.state='drag';w.a.place(a.x-Math.cos(angle)*10,a.y-Math.sin(angle)*10,a.z);continue;}if(e.wounded){const helper=raiders.find(q=>q!==e&&q.alive&&!q.wounded&&!q.civilian&&q.faction===e.faction&&!q.dragging&&Math.hypot(q.a.x-a.x,q.a.y-a.y)<15*M);if(helper){if(e.betrayer&&helper.betrayer){e.wounded=false;e.hp=120;e.state='combat';helper.cooldown=2;}else if(Math.hypot(helper.a.x-a.x,helper.a.y-a.y)<5*M){helper.dragging=e;}else{helper.goal=[a.x,a.y];helper.state='hunt';}}e.woundTime-=dt;if(e.woundTime<=0){hurtEnemy(e,100,true);continue;}a.vx=Math.cos(e.yaw)*14;a.vy=Math.sin(e.yaw)*14;continue;}if(e.civilian){const flee=Fire.near(a.x,a.y,24)||(e.alert>0);const yaw=flee?Math.atan2(a.y-target.y,a.x-target.x):e.age*.08+e.id;const sp=flee?70:9;a.vx=Math.cos(yaw)*sp;a.vy=Math.sin(yaw)*sp;e.yaw=yaw;e.alert=Math.max(0,e.alert-dt);continue;}if(e.friendly){if(S.down){const dx=target.x-a.x,dy=target.y-a.y,L=Math.hypot(dx,dy)||1;a.vx=dx/L*110;a.vy=dy/L*110;e.yaw=Math.atan2(dy,dx);}else{const target=raiders.find(q=>q.alive&&!q.friendly&&!q.civilian&&Math.hypot(q.a.x-a.x,q.a.y-a.y)<120*M);if(target&&e.cooldown<0){hurtEnemy(target,24,true);e.cooldown=.3;e.flash=1;e.yaw=Math.atan2(target.a.y-a.y,target.a.x-a.x);}}continue;}\nsrc/55-ai.js:23: if(e.state==='combat'){const angle=Math.atan2(target.y-a.y,target.x-a.x);e.yaw=angle;const flank=e.id%3===0?Math.PI/2:0,sp=dist>25?40:dist<12?-30:0;a.vx=Math.cos(angle+flank)*sp;a.vy=Math.sin(angle+flank)*sp;if(e.cooldown<=0&&!e.jam){e.cooldown=.35+rnd()*.35;if(rnd()<.05){e.jam=1.5;say(e.faction==='front'?'Front soldier':'Provisional','Come on. Come on.');}else{e.flash=1;if(!NO_RENDER)tracer([a.x,a.y,a.z+22],[target.x,target.y,target.z+16],'#f4ba76',8000,.35);if(rnd()<.22*TUNE.enemyAccuracy*Math.min(1,55/dist))(targetId!==null&&targetId!==AIHub.me?netDamage(targetId