.5, bd[2] * 1.5); wp(J.handR, t1, bd[0] * Lb, bd[1] * Lb, bd[2] * Lb);\n    const fl = Math.hypot(bd[0], bd[1]) > 1e-3 ? [-bd[1], bd[0]] : [0, 1]; wp([hx + fl[0], hy + fl[1], hz], t2); wp(J.handR, t3);\n    const ax = t2[0] - t3[0], ay = t2[1] - t3[1], az = t2[2] - t3[2], al = Math.hypot(ax, ay, az) || 1; t4[0] = ax / al; t4[1] = ay / al; t4[2] = az / al;\n    B.box.box(t0, t1, t4, 1.3 * u, .3 * u, C.metal || lin('#dce8f1'));\n    wp(J.handR, t2, bd[0] * 1.2, bd[1] * 1.2, bd[2] * 1.2); wp(J.handR, t5, bd[0] * 1.7, bd[1] * 1.7, bd[2] * 1.7); B.box.box(t2, t5, t4, 3.4 * u, .5 * u, C.hilt || lin('#e8b04e'));\n  }\n}\n/** a Blob (slime): its body squashed as the Blob squashes, eyes looking where it looks, horns, ears or wings */\nfunction blobParts(B, a, flash, sink) {\n  const b = a.blob, o = b.o, R = o.R * (b.scale || 1), sq = b.sq || 0, ka = 1 - sq * .55, hk = 1 + sq, C = b.C, u = 1 / U;\n  const base = flash ? FLASH : lin(C.base), dk = lin(C.dk), x = a.x / U, z = a.y / U, y = ((a.z || 0) + R * hk + sink) / U;\n  const [c, p] = P3; c[0] = x; c[1] = y; c[2] = z;\n  B.ball.ball(c, R * ka * u, R * hk * u, R * ka * u, base);\n  const look = b.look || [Math.cos(a.facing), Math.sin(a.facing)], la = Math.atan2(look[1], look[0]), fx = Math.cos(la), fz = Math.sin(la);\n  for (const s of [-1, 1]) {   // eyes: white, a pupil in front (a squint is a dark slit)\n    const ea = la + s * .42; p[0] = x + Math.cos(ea) * R * ka * .86 * u; p[1] = y + R * hk * .2 * u; p[2] = z + Math.sin(ea) * R * ka * .86 * u;\n    if (b.squint) { B.ball.ball(p, 1.1 * u, .3 * u, 1.1 * u, lin(C.pupil)); continue; }\n    B.ball.ball(p, 1.25 * u, 1.6 * u, 1.25 * u, lin(C.eye)); p[0] += fx * .9 * u; p[2] += fz * .9 * u; B.ball.ball(p, .7 * u, 1 * u, .7 * u, lin(C.pupil));\n  }\n  if (o.horns || o.ears) for (const s of [-1, 1]) {   // horns and cat ears: cones on top, toward the sides\n    const sa = la + s * Math.PI / 2, bx = x + Math.cos(sa) * R * ka * .45 * u, bz = z + Math.sin(sa) * R * ka * .45 * u, by = y + R * hk * .7 * u;\n    const ht = (o.horns ? .9 : .75) * R * u, tip = [bx + Math.cos(sa) * ht * .35, by + ht, bz + Math.sin(sa) * ht * .35];\n    B.cone.tube([bx, by, bz], tip, R * .3 * u, o.horns ? lin(C.horn || '#e8dcc0') : dk);\n    E.showError('error in ' + where + '()' + (this.sceneName && this.sceneName !== 'main' ? ' of scene \"' + this.sceneName + '\"' : ''), e);\n    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n      this.focus(t.x + dir[0] * f.lead, (t.y || 0) + dir[1] * f.lead, (t.z || 0) + f.z);\n    }\n    this.particles.update(dt);\n    if (this.cam.free) this._freeCam(dt);\n    this._camStep(dt);\n  }\n  // a screen-pixel move [dx, dy] as the ground's (world x, y) at the zoom the player sees (during a zoom's preview, the goal)\n  _screenToGround(dx, dy) {\n    const v = this.view, k = this.zoom / (this._zoomTo || this.zoom);\n    return v.inv ? [(v.inv[0] * dx + v.inv[1] * dy) * k, (v.inv[2] * dx + v.inv[3] * dy) * k] : [dx / (v.ax || 1) * k, 0];\n  }\n  // cam.free: the keys and a stick, the screen's edges, a drag, a zoom toward its point; the focus kept to bounds\n  _freeCam(dt) {\n[\n  {\n    \"name\": \"rendered shared pickup and bank replication\",\n    \"pass\": true,\n    \"detail\": [\n      {\n        \"me\": 0,\n        \"banked\": 2,\n        \"errors\": 0\n      },\n      {\n        \"me\": 1,\n        \"banked\": 2,\n        \"errors\": 0\n      }\n    ]\n  },\n  {\n    \"name\": \"host melee damages remote player\",\n    \"pass\": false,\n    \"detail\": 100\n  },\n  {\n    \"name\": \"client bottle ignites host world\",\n    \"pass\": true,\n    \"detail\": 12\n  },\n  {\n    \"name\": \"hub 2 standard render\",\n    \"pass\": true,\n    \"detail\": {\n      \"done\": true,\n      \"pass\": true,\n      \"game\": \"game.html\",\n      \"players\": 2,\n      \"scenario\": \"standard\",\n      \"checks\": [\n        {\n          \"name\": \"head metas\",\n          \"pass\": true,\n          \"detail\": \"hub:session=1 mode=shared-world\"\n        },\n        {\n          \"name\": \"hub:session-players is a range within 1\\u20134\",\n          \"pass\": true,\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_123","type":"command_execution","command":"/bin/bash -lc \"sed -n '1900,1951p' engine/my-3d2dge-3d.js && sed -n '1,40p' test/hub_check.py && sed -n '40,80p' test/hub_check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_123","type":"command_execution","command":"/bin/bash -lc \"sed -n '1900,1951p' engine/my-3d2dge-3d.js && sed -n '1,40p' test/hub_check.py && sed -n '40,80p' test/hub_check.py\"","aggregated_output":"}\nconst _sph = new THREE.Sphere();\n\n/* =============================================================================\n * 8. ACTORS  world.hero(o): a kinematic capsule that Rapier's character controller walks (it slides along walls,\n *    climbs stairs and slopes, steps up curbs, jumps, rides moving platforms, pushes crates and shoves mobs aside);\n *    world.mob(o): a dynamic body (a capsule, or a ball for blobs and orbs) that the crowd's own physics resolves.\n *    Either way the game sets what it wants each step (vx, vy: ground velocity in units a second; jump(v) or vz) and\n *    world.step moves it and reads back where it is.\n * ============================================================================= */\nclass Actor {\n  /** made by world.hero(o) and world.mob(o); see the manual for its fields */\n  constructor(world, kind, o) {\n    const round = !!(o.blob || o.orb), r = o.r ?? (kind === 'hero' ? 4.5 : round ? 6 : 5), half = o.half ?? (round ? 0 : kind === 'hero' ? 9 : 8);\n    /** kind: 'hero' | 'mob'; x, y, z: its feet (engine units); vx, vy, vz: velocity (units a second); facing: radians;\n     *  r, half: its capsule (radius, half its straight part; half 0 is a ball); rig | blob | orb: what is drawn; fly:\n     *  no gravity; grounded, landed (this step), fell (dropped below the world): read them; alive: yours to keep */\n    Object.assign(this, { world, kind, x: o.x ?? 0, y: o.y ?? 0, z: o.z ?? 0, vx: 0, vy: 0, vz: 0, facing: o.facing ?? -Math.PI / 2, r, half, foot: half + r,\n      rig: o.rig || null, blob: o.blob || null, orb: o.orb || null, fly: !!o.fly, mass: o.mass ?? 1, grounded: false, landed: false, fell: false, solid: true, alive: true });\n    /** anim: what its rig is doing this step, given to rig.update with its motion (world.step poses it: { attack, pose,\n     *  hurt, dash, expr, ... } as the 2D engine's rigs take them; a blob's: { squash, look, squint, flap }); pose: false\n     *  poses it yourself; look: 'card' | 'puppet' for this one (null: the world's); flash: seconds of hit flash; fade:\n     *  0..1 shown; sink: units drawn into the floor (rising from it, falling into it); visible; shadow; trail: a color\n     *  for its rig's weapon trail (null none); data: yours */\n    Object.assign(this, { anim: null, pose: o.pose !== false, look: o.look || null, flash: 0, fade: 1, sink: 0, visible: o.visible !== false, shadow: o.shadow !== false, trail: o.trail || null, data: o.data || {}, on: null, _rv: [0, 0, 0] });\n    if (this.rig) { this.rig.x = this.x; this.rig.y = this.y; this.rig.z = this.z; this.rig.facing = this.facing; }\n  }\n  /** put it at (x, y) on the floor there (or at height z), standing still */\n  place(x, y, z) {\n    const w = this.world; z = z ?? w.floorAt(x, y);\n    Object.assign(this, { x, y, z, vx: 0, vy: 0, vz: 0, fell: false });\n    if (this.body) { this.body.setTranslation({ x, y, z: z + this.foot + (this.kind === 'hero' ? .4 : 0) }, true); if (this.kind === 'mob') this.body.setLinvel({ x: 0, y: 0, z: 0 }, true); }\n    this._rv[0] = this._rv[1] = this._rv[2] = 0;\n    return this;\n  }\n  /** leave the ground at v units a second upward (a hero only from the ground: check grounded first if it matters) */\n  jump(v) { this.vz = v; this.grounded = false; return this; }\n  /** add a push of velocity (knockback; vz > 0 throws it up) */\n  push(vx, vy, vz = 0) { this.vx += vx; this.vy += vy; if (vz) this.vz = Math.max(this.vz, vz); return this; }\n  /** false: it stops blocking heroes and mobs (a body that has fallen): it still rests on the level, props and platforms */\n  setSolid(on) {\n    this.solid = !!on; if (!this.col) return this;\n    this.col.setCollisionGroups(on ? (this.kind === 'hero' ? GROUPS.hero : this.fly ? GROUPS.flyer : GROUPS.mob) : GROUPS.down);\n    if (!on && this.kind === 'mob') { this.col.setFriction(.9); this.col.setFrictionCombineRule(RAPIER.CoefficientCombineRule.Average); }\n    return this;\n  }\n  /** a new half for its capsule (its straight part), the feet kept where they are: a crouch, a slide, standing up again\n   *  (check the room above first: world.ray up from its head) */\n  resize(half) {\n    if (half === this.half || !this.col || !this.half) return this;\n    const d = half - this.half; this.half = half; this.foot = half + this.r; this.col.setHalfHeight(half);\n    const p = this.body.translation(); this.body.setTranslation({ x: p.x, y: p.y, z: p.z + d }, true);\nfrom pathlib import Path\nimport subprocess,re,threading,shutil,json\nfrom urllib.parse import quote\nfrom playwright.sync_api import sync_playwright\nR=Path(__file__).resolve().parent.parent\n\ndef run_hub(p,render=False,scenarios=None):\n shutil.copyfile(R.parent/(R.name+'.html'),R/'hub/game.html')\n srv=subprocess.Popen(['python3','-u','-m','http.server','0','--bind','127.0.0.1'],cwd=R/'hub',stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)\n line=srv.stdout.readline();port=int(re.search(r'port (\\d+)',line).group(1));threading.Thread(target=lambda:[None for _ in srv.stdout],daemon=True).start()\n out=[]\n try:\n  b=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required','--use-angle=swiftshader','--enable-webgl'])\n  page=b.new_page(viewport={'width':1280,'height':800})\n  errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n  for n,scenario in scenarios or [(1,'standard'),(2,'standard'),(4,'standard'),(4,'host-leave'),(2,'server')]:\n   game='game.html'+('' if render else '?norender=1')\n   url=f'http://127.0.0.1:{port}/harness.html?game={quote(game,safe=\"\")}&players={n}&latency=150&jitter=50&loss=5&auto=1&scenario={scenario}&play={18000 if render else 8000}'\n   page.goto(url)\n   if render:\n    page.wait_for_selector('iframe',timeout=30000)\n    frames=[f for f in page.frames if f.parent_frame is not None and 'game.html' in f.url]\n    for f in frames:f.wait_for_function('window.__game?.Net.started && AIHub.time()>=0',timeout=90000)\n    host=next(f for f in frames if f.evaluate('AIHub.isHost'))\n    host.evaluate('''() => {const q=__game;q.CHEATS.god=true;q.CHEATS.freezeAI=true;q.game.audio.mute(true);const c=q.Salvage.cases[0];q.Bot.teleport(c.x,c.y);q.Bot.tick(.03);q.Bot.use();}''')\n    page.wait_for_timeout(800)\n    host.evaluate('''() => {const q=__game,b=q.vehicles.find(v=>v.bank);q.Bot.teleport(b.v.x,b.v.y+16);q.Bot.tick(.03);q.Bot.tick(3.2,{move:[0,0],mouse:[0,0],stick2:null,pressed:()=>false,down:a=>a==='use',use(){}});}''')\n    page.wait_for_timeout(900)\n    banks=[f.evaluate('''() => ({me:AIHub.me,banked:__game.Net.players.get(0)?.banked||0,errors:__game.game.errors.length})''') for f in frames]\n    out.append({'name':'rendered shared pickup and bank replication','pass':len(banks)==2 and all(q['banked']>0 and not q['errors'] for q in banks),'detail':banks})\n    client=next(f for f in frames if not f.evaluate('AIHub.isHost'))\n    client_pos=client.evaluate('() => [__game.hero.x,__game.hero.y,__game.hero.z]')\n    host.evaluate('''(p) => {const q=__game;q.Bot.teleport(p[0]-2*16,p[1],p[2]);q.S.yaw=0;q.Bot.tick(.03);q.Bot.press('melee');q.Bot.tick(.7);}''',client_pos)\n    page.wait_for_timeout(800)\n    hp=client.evaluate('__game.S.hp')\n    out.append({'name':'host melee damages remote player','pass':hp<=40,'detail':hp})\n    client.evaluate('''() => {const q=__game;q.Bot.press('bottle');q.Bot.tick(3.2);}''')\n    page.wait_for_timeout(800)\n    lit=host.evaluate('__game.Fire.lit')\n    out.append({'name':'client bottle ignites host world','pass':lit>0,'detail':lit})\n    out.append({'name':'client bottle ignites host world','pass':lit>0,'detail':lit})\n\n   page.wait_for_selector('body[data-complete=\"true\"]',timeout=240000)\n   report=page.evaluate('window.__hubCheck');out.append({'name':f'hub {n} {scenario} '+('render' if render else 'fast'),'pass':report.get('pass',False),'detail':report})\n  b.close()\n finally:srv.terminate();srv.wait(timeout=10)\n (R/'test'/('hub-render-report.json' if render else 'hub-report.json')).write_text(json.dumps(out,indent=2))\n return out\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_120","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/80-audio.js');s=p.read_text().replace(\\\"const AudioFX={loops:[],pluck:null,ready:false}\\\", \\\"const AudioFX={loops:[],pluck:null,ready:false,rng:E.rng(0x4d555349)}\\\").replace(\\\"[Math.floor(rnd()*4)];g.gain\\\", \\\"[Math.floor(AudioFX.rng()*4)];g.gain\\\");p.write_text(s)\np=Path('test/checks.js');s=p.read_text().replace(\\\"reset();check('data tables and all map sites'\\\", \\\"\\\"\\\"reset();check('sound does not change simulation',()=>{const simulate=mute=>{reset();q.game.audio.mute(mute);q.CHEATS.ammo=true;q.S.inventory.verger.cond=.2;q.TUNE.wear=0;q.TUNE.jam=5;for(let i=0;i<1920;i++){const pressed=new Set();if(i%42===0)pressed.add('fire');if(q.S.inventory.verger.jammed)pressed.add('reload');q.step(1/120,{move:[0,0],mouse:[0,0],stick2:null,pressed:a=>pressed.has(a),down:()=>false,use:a=>pressed.delete(a)});}return [q.S.shots,q.S.jams||0,q.world.hash()];};const a=simulate(true),b=simulate(false);q.game.audio.mute(true);return JSON.stringify(a)===JSON.stringify(b)||{muted:a,audible:b};});\n reset();check('data tables and all map sites'\\\"\\\"\\\")\np.write_text(s)\np=Path('test/ISSUES.md');p.write_text(p.read_text()+'\\\\n26. Determinism check: cosmetic plucked-note selection consumed the gameplay RNG when audio was active. Give music its own seeded random stream and compare identical jam/fire/reload sequences with sound muted and active. Noncritical reproducibility defect.\\\\n')\nimport json\np=Path('../exit-interview.json');d=json.loads(p.read_text());d['testingFeedback'][0]=d['testingFeedback'][0].replace('25 distinct','26 distinct');p.write_text(json.dumps(d,indent=2,ensure_ascii=False)+'\\\\n')\nPY\nnode build.mjs\npython3 test/run.py\"","aggregated_output":"77/77 checks passed; 0 failures\n","exit_code":0,"status":"completed"}}
