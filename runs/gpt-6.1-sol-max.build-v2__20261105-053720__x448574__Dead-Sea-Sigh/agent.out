interLock?.();if(\"'!aboutUI)aboutUI=new E.Shell(game,{theme:{ink:'\"'#e8e1c9',paper:'#1b241a',accent:'#c9a96b',muted:'#b7b697'}});const answers=window.__answers;const sections=answers?[['Source Information',Object.entries(answers.sourceInformation).map(([k,v])=>k+': '+v).join('\\\\n')],['Testing Feedback',answers.testingFeedback.join('\\\\n\\\\n')],['Engine Feedback',answers.engineFeedback.join('\\\\n\\\\n')],['Prompt Feedback',answers.promptFeedback.join('\\\\n\\\\n')]]:[['Source Information','Date: 2026-11-05 05:37:20. Source: Far Cry 2. Plan: PLAN.md. Genre: open-world survival shooter. Perspective: first person. Tech: my-3D2dge v0.88.0, World3D, three.js r182, Rapier 0.19.3. Art: native low-poly pen geometry. Animation: native IK and procedural hands. Audio: original code synths, music, gibberish voices. Online: AI Hub shared-world Salvage Rights. Testing: headless scripted playthroughs and browser checks. Research: supplied plan, engine and hub documentation. Environment: Codex CLI (headless); Linux. Model: OpenAI gpt-6.1-sol, reasoning effort max. Usage: added on import.'],['Testing Feedback','unknown'],['Engine Feedback','unknown'],['Prompt Feedback','unknown']];sections.push(['Libraries & original work','my-3D2dge v0.88.0 — MIT. Three.js r182 — MIT. Rapier 0.19.3 — Apache-2.0. AI Hub Session Protocol v1. All locations, characters, music, sounds, gun and vehicle models are original. Generic props use the engine core library.']);aboutUI.show('help',{title:'ABOUT / CREDITS',sections});setTimeout(()=>{const m=document.querySelector('.esh-mod');if(m)m.scrollTop=0;},30);}\nfunction updateAboutScroll(dt){if(\"'!aboutUI?.screen)return;const m=document.querySelector('\"'.esh-mod');if(\"'!m)return;const a=game.input.padAim;if(a)m.scrollTop+=(a[1]||0)*-450*dt;if(game.input.down('\"'down'))m.scrollTop+=350*dt;if(game.input.down('up'))m.scrollTop-=350*dt;}\nfunction titlePose(){S.title=true;hero.place(1070*M,1200*M,height(1070*M,1200*M));S.yaw=.84;S.pitch=.025;camStep(0