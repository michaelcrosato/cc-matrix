n_verger');killBuddy\\\").replace(\\\"b.down=false;b.rep++;\\\", \\\"b.down=false;b.rep++;b.fightUntil=S.time+60;\\\")\np.write_text(s)\np=Path('src/55-ai.js');s=p.read_text().replace(\\\"for(const n of people){if(Math.hypot\\\", \\\"for(const n of people){if(n.gone||n.buddy?.dead||n.buddy?.entity?.alive&&\"'!n.buddy.down)continue;if(Math.hypot\")\na=s.index('\"'function aiStep(dt)');b=s.index('function drawPeople(',a);chunk=s[a:b]\nchunk=chunk.replace(\\\"if(e.salvager)continue;const a=e.a,dist=\\\", \\\"if(e.salvager)continue;const target=inSession&&S.mode==='salvage'?[...Net.players.values()].filter(p=>p.hp>0).sort((p,q)=>Math.hypot(p.x-e.a.x,p.y-e.a.y)-Math.hypot(q.x-e.a.x,q.y-e.a.y))[0]||hero:hero;const targetId=inSession&&target\"'!==hero?target.id:null;const a=e.a,dist=\")\n# Keep the actual local hero fallback in target selection; replace references only after the a/dist declaration.\ni=chunk.index('\"'const a=e.a,dist=');prefix=chunk[:i];rest=chunk[i:].replace('hero.x','target.x').replace('hero.y','target.y').replace('hero.z','target.z')\nrest=rest.replace(\\\"&&S.alive&&\"'!S.down&&world.clear\", \"&&(inSession?target.hp>0:S.alive&&!S.down)&&world.clear\")\nrest=rest.replace(\"hurtPlayer(8*TUNE.enemyDamage,angle+Math.PI)\", \"(targetId!==null&&targetId!==AIHub.me?netDamage(targetId,8*TUNE.enemyDamage):hurtPlayer(8*TUNE.enemyDamage,angle+Math.PI))\")\ns=s[:a]+prefix+rest+s[b:];p.write_text(s)\np=Path('\"'src/70-hud.js');s=p.read_text().replace(\\\"const dam=OP.sill;\\\", \\\"for(const b of S.buddies)if(b.dead){const o=OP[b.site];p.at(o.x-3*M,o.y+6*M,o.z+8);p.tube(0,0,0,0,0,5,.8,'#6d7350').tube(0,0,5,0,0,7,.3,'#6d7350');}const dam=OP.sill;\\\");p.write_text(s)\np=Path('src/30-player.js');s=p.read_text().replace('S.merc=merc;for(const p of POSTS)', 'S.merc=merc;LOOKS.player.skin=MERCS[merc].color;for(const p of POSTS)');p.write_text(s)\np=Path('src/75-screens.js');s=p.read_text().replace(\\\"world.step(dt);fireStep(dt);},draw(r)\\\", \\\"world.step(dt);fireStep(dt);audioStep(dt);},draw(r)\\\");p.write_text(s)\np=Path('test/ISSUES.md');p.write_text(p.read_text()+'\\\\n21. Buddy persistence visual check: the people renderer ignored the gone flag, and departing rescue actors remained drawn. Hide dead/deployed home NPCs, remove departed rescue actors, and leave a bottle at the empty chair. Noncritical visual persistence defect.\\\\n22. Shared-world AI review: soldiers evaluated only the host hero, leaving clients and dedicated-server players untargeted. Pick the nearest living network player and route remote damage through host events. Critical multiplayer AI defect.\\\\n')\np=Path('../exit-interview.json');import json;d=json.loads(p.read_text());d['testingFeedback'][0]=d['testingFeedback'][0].replace('20 distinct','22 distinct');d['testingFeedback'][1]=d['testingFeedback'][1].replace('8 were','9 were').replace('multiplayer consistency and PvP','multiplayer consistency, targeting and PvP');p.write_text(json.dumps(d,indent=2,ensure_ascii=False)+'\\\\n')\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
