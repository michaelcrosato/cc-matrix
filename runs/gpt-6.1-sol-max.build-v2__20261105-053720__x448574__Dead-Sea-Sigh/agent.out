)*damage*.15,0];if(e.hp>0)return;\n if(\"'!head&&!e.civilian&&!e.wounded&&!e.buddy&&rnd()<.3){e.wounded=true;e.hp=12;e.woundTime=25;e.state='\"'wounded';e.a.vx=e.a.vy=0;say(e.faction==='front'?'Wounded Front soldier':'Wounded Provisional','Not like this. Not in triplicate.');return;}\n e.alive=false;e.a.setSolid(false);e.a.vx=e.a.vy=0;e.b.dead={t:0,dir:S.yaw,g:e.a.z};S.kills++;if(e.civilian){S.flags.civilianDied=(S.flags.civilianDied||0)+1;say('Sister Perpetua','Four hundred and seven. Then you came.');}if(e.buddy){downBuddy(e.buddy);return;}if(e.target)S.flags[e.target]=true;loot.push({id:'gun'+e.id,x:e.a.x,y:e.a.y,z:e.a.z,weapon:e.b.weapon,cond:.2+rnd()*.35});\n if(e.post){const p=POSTS.find(p=>p.id===e.post);if(\"'!raiders.some(q=>q.alive&&q.post===e.post)){p.clear=true;S.tags=[];say('\"'Road ledger','Post cleared. It will stay quiet until you sleep.');}}\n}\nfunction aiStep(dt){if(CHEATS.freezeAI)return;streamSoldiers();for(const e of raiders){e.flash=Math.max(0,e.flash-dt*12);if(\"'!e.alive){if(e.b.dead)e.b.dead.t+=dt;continue;}const a=e.a,dist=Math.hypot(a.x-hero.x,a.y-hero.y)/M;e.age+=dt;e.cooldown-=dt;e.jam=Math.max(0,e.jam-dt);if(e.wounded){e.woundTime-=dt;if(e.woundTime<=0){hurtEnemy(e,100,true);continue;}a.vx=Math.cos(e.yaw)*14;a.vy=Math.sin(e.yaw)*14;continue;}if(e.civilian){const flee=Fire.near(a.x,a.y,24)||(e.alert>0);const yaw=flee?Math.atan2(a.y-hero.y,a.x-hero.x):e.age*.08+e.id;const sp=flee?70:9;a.vx=Math.cos(yaw)*sp;a.vy=Math.sin(yaw)*sp;e.yaw=yaw;e.alert=Math.max(0,e.alert-dt);continue;}if(e.friendly){if(S.down){const dx=hero.x-a.x,dy=hero.y-a.y,L=Math.hypot(dx,dy)||1;a.vx=dx/L*110;a.vy=dy/L*110;e.yaw=Math.atan2(dy,dx);}else{const target=raiders.find(q=>q.alive&&!q.friendly&&!q.civilian&&Math.hypot(q.a.x-a.x,q.a.y-a.y)<120*M);if(target&&e.cooldown<0){hurtEnemy(target,24,true);e.cooldown=.3;e.flash=1;e.yaw=Math.atan2(target.a.y-a.y,target.a.x-a.x);}}continue;}\n const fire=Fire.near(a.x,a.y,24);if(fire||e.burning>0){e.state='\"'fleeFire';let best=