at('up',.3,.15))S.choiceIndex=(S.choiceIndex+c.options.length-1)%c.options.length;const pos=game.input.pointer();if(pos){const W=game.W,H=game.H,w=Math.min(W-30,W*380/(game.renderer?.W||427));if(game.input.clicked()){const i=S.choiceIndex;S.choiceUI=null;S.choiceIndex=0;c.options[i][1]();game.input.consumeAll();return;}}if(game.input.pressed('confirm')||game.input.pressed('use')){const i=S.choiceIndex;S.choiceUI=null;S.choiceIndex=0;game.input.consumeAll();c.options[i][1]();}}\nfunction inputActivity(e){lastInputAt=performance.now();if(Attract.active){Attract.stop();if(e?.preventDefault)e.preventDefault();}}\nfor(const ev of ['keydown','pointermove','pointerdown','touchstart'])addEventListener(ev,inputActivity,{passive:ev==='touchstart'});\ngame.hook('input',()=>{if(game.input.lastDevice==='gamepad'){const pads=navigator.getGamepads?.()||[];if([...pads].some(p=>p&&(p.buttons.some(b=>b.pressed)||p.axes.some(a=>Math.abs(a)>.2))))inputActivity();}});\nEOF\ncat >> src/page.css <<'EOF'\n.esh{--paper:#1c261b;--ink:#e2d9bc;--accent:#c3a067;--muted:#b2b39b;--font:monospace;--title:monospace}.esh-sh{background:rgba(12,20,13,.82)\"'!important}.esh-box{border-color:#777b5a!important}.esh button:hover,.esh button:focus-visible{outline-color:#d3b073!important}#devpanel{position:absolute;z-index:50;right:3vw;top:4vh;width:min(470px,88vw);max-height:88vh;overflow:auto;box-sizing:border-box;background:rgba(24,35,23,.96);color:#e0d8bc;border:1px solid #838263;padding:25px;font:18px monospace;box-shadow:0 15px 70px #0008}#devpanel h2{font-size:27px;margin:12px 0 20px;font-weight:500}#devpanel .dev-kicker{font-size:12px;letter-spacing:2px;color:#c1a675}#devpanel nav{display:flex;gap:8px;margin-bottom:18px}#devpanel button,#devpanel select{font:inherit;color:inherit;background:#34432e;border:1px solid #58634a;padding:12px;text-align:left;min-height:44px;cursor:pointer}#devpanel>button,#devpanel>select{display:block;width:100%;margin:7px 0}#devpanel nav button{flex:1;font-size:14px;text