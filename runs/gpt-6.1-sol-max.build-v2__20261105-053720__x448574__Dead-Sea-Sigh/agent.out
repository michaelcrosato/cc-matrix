{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"head -18 src/14-environment.js && sed -n '738,812p' reference-shooter.js && sed -n '96,255p' hub/README.md\"","aggregated_output":"   *      concrete with stains, corrugated metal, a container's ribs, planks, sandbags in rows ---- */\n  let NOISE = null;\n  function noiseTex() {   // value noise that tiles (128 px), grey, filtered and mipmapped: seen from near and far\n    if (NOISE) return NOISE;\n    const S = 128, cv = document.createElement('canvas'); cv.width = cv.height = S; const g = cv.getContext('2d'), img = g.createImageData(S, S);\n    const wn = (x, y, per) => { const xi = Math.floor(x), yi = Math.floor(y), u = x - xi, v = y - yi, su = u * u * (3 - 2 * u), sv = v * v * (3 - 2 * v), m = a => ((a % per) + per) % per, h = (a, b) => E.hash2(m(a) + 11, m(b) + 57);\n      return lerp(lerp(h(xi, yi), h(xi + 1, yi), su), lerp(h(xi, yi + 1), h(xi + 1, yi + 1), su), sv); };\n    for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {\n      let v = 0, a = .5, t = 0; for (let o = 0, f = 4; o < 5; o++, f *= 2) { v += a * wn(x / S * f, y / S * f, f); t += a; a *= .5; }\n      const i = (y * S + x) * 4; img.data[i] = img.data[i + 1] = img.data[i + 2] = clamp((v / t - .5) * 1.7 + .5, 0, 1) * 255; img.data[i + 3] = 255;\n    }\n    g.putImageData(img, 0, 0); NOISE = new E.THREE.CanvasTexture(cv); NOISE.wrapS = NOISE.wrapT = E.THREE.RepeatWrapping; NOISE.colorSpace = E.THREE.NoColorSpace; NOISE.anisotropy = 4;\n    return NOISE;\n  }\n  function structureMesh(world) {\n    const T3 = E.THREE, { attribute, positionWorld, normalWorld, texture, vec2, float, fract, sin, step, abs, mix, floor, max, length } = E.TSL, NZ = noiseTex();\n    const geo = new T3.BufferGeometry();\n    geo.setAttribute('position', new T3.Float32BufferAttribute(GEO.P, 3)); geo.setAttribute('normal', new T3.Float32BufferAttribute(GEO.N, 3));\n    // the pelvis: standing, crouched, sliding, in the air; the walk's bob and sway; a landing's dip\n    const run = clamp((sp - 60) / 50, 0, 1), bob = walking ? Math.abs(Math.sin(b.ph * TAU)) : 0;\n    let pz = (15.2 - b.cr * 5.2 - b.sl * 9.8 - b.air * .6) * k + (walking ? (bob - .6) * (.5 + run * .9) * b.amp * k : 0) + b.dip.x;\n    if (b.move === 'stand' && !walking) pz += Math.sin(drawT * 1.6) * .12 * k;   // breathing\n    const P = [b.x + b.jx.x * .3, b.y + b.jy.x * .3, b.z + pz];\n    if (walking) { const sw = Math.sin(b.ph * TAU) * (.35 + run * .25) * b.amp * k; P[0] += rt[0] * sw; P[1] += rt[1] * sw; }\n    // turning on the spot: the feet keep the heading they planted at (the hips turn over them) until the body has turned\n    // past it, then step round one after the other, the foot on the side it turns to first\n    if (!((b.move === 'stand' || b.move === 'crouch') && !(walking && b.amp > .02))) b.stance = null;\n    else {\n      if (!b.stance || Math.hypot(b.x - b.stance.x, b.y - b.stance.y) > 3 * k) b.stance = { yaw: b.yaw, x: b.x, y: b.y, from: null, t: 1, lead: 0 };\n      const S0 = b.stance, dyaw = ((b.yaw - S0.yaw + Math.PI * 3) % TAU) - Math.PI, turning = Math.abs(((b.yaw - (b.pyaw ?? b.yaw) + Math.PI * 3) % TAU) - Math.PI) > dt * .3;\n      S0.still = turning ? 0 : (S0.still || 0) + dt; b.pyaw = b.yaw;\n      if (S0.t >= 1 && (Math.abs(dyaw) > .48 || (Math.abs(dyaw) > .2 && S0.still > .3)))   // (past the feet: step round, aiming past the turn; stopped turning askew: a last step squares them)\n        Object.assign(S0, { from: { yaw: S0.yaw, x: S0.x, y: S0.y }, yaw: b.yaw + (turning ? Math.sign(dyaw) * Math.min(.35, Math.abs(dyaw) * .45) : 0), x: b.x, y: b.y, t: 0, lead: dyaw > 0 ? 1 : 0 });\n      if (S0.t < 1) {   // (the hips shift over the planted foot while the other lifts, and dip a little as each lands)\n        S0.t = Math.min(1, S0.t + dt / .32); const t = S0.t, u0 = clamp(t / .58, 0, 1), u1 = clamp((t - .42) / .58, 0, 1), sh = (Math.sin(u0 * Math.PI) * (S0.lead ? -1 : 1) + Math.sin(u1 * Math.PI) * (S0.lead ? 1 : -1)) * .5 * k;\n        P[0] += rt[0] * sh; P[1] += rt[1] * sh; P[2] -= (Math.max(0, 1 - Math.abs(t - .6) / .1) + Math.max(0, 1 - Math.abs(t - .96) / .08)) * .3 * k;\n      }\n    }\n    const standFoot = (i, yaw, x, y) => {\n      const f = [Math.cos(yaw), Math.sin(yaw), 0], r = [-f[1], f[0], 0], side = i ? 1 : -1;\n      return { p: add(add([x, y, 0], r, side * (2.1 + b.cr * .7) * k), f, (i ? 1.2 : -.9) * k * (1 + b.cr)), toe: nrm(add(f, r, side * .25)) };\n    };\n    // ---- the feet on the ground (the gait, standing, crouched, sliding, on a rung), before the pelvis settles to them ----\n    const footZ = (x, y) => fine ? footGround(world, b, x, y) : b.z, A = [null, null], toe = [fw, fw];\n    if (!(walking && b.amp > .02)) b.feetW = null;\n    for (let i = 0; i < 2; i++) {\n      const side = i ? 1 : -1;\n      if (b.move === 'slide') {   // the lead leg out ahead, the other tucked under\n        const vd = sp > 1 ? [b.vx / sp, b.vy / sp, 0] : fw, out = i === 1;\n        A[i] = add(add([b.x, b.y, b.z], vd, out ? 9 * k : 2 * k), rt, side * (out ? 1.2 : 2.6) * k); A[i][2] = footZ(A[i][0], A[i][1]) + (out ? 1.6 : 1.1) * k; toe[i] = vd;\n      } else if (b.move === 'ladder') {   // on the rungs, stepping in turn\n        const Ld = b.ladder, st = .3 * M, ph = (b.z / st + i * .5) % 1, rung = Math.floor(b.z / st + i * .5) * st - i * st / 2;\n        A[i] = add(add([b.x, b.y, 0], fw, 1.6 * k), rt, side * 1.9 * k); A[i][2] = Math.max(Ld ? Ld.z0 : 0, rung) + (ph < .3 ? ph * 6 : 0) * k + 1;\n      } else if (walking && b.amp > .02) {   // the gait: stance plants the foot (it moves back as fast as the body goes on), swing lifts it forward\n        const q = (b.ph + i * .5) % 1, duty = lerp(.6, .34, clamp((sp - 30) / 70, 0, 1)), reach = duty * L * .5, md = sp > 1 ? [b.vx / sp, b.vy / sp, 0] : fw;\n        let along, lift, roll = 0;\n        if (q < duty) { const t = q / duty; along = reach * (1 - 2 * t); lift = 0; roll = t > .7 ? -(t - .7) / .3 * .6 : 0; }   // (the heel rises as it pushes off)\n        else { const t = (q - duty) / (1 - duty); along = -reach + 2 * reach * ease(t); lift = Math.sin(t * Math.PI) * (2 + run * 3.2) * k; roll = lerp(-.7, .45, t); }   // (toe down off the ground, up to meet it)\n        const base = add(add([b.x, b.y, 0], rt, side * (2.1 - run * .5) * k * (1 + b.cr * .25)), md, along * b.amp * Math.min(1, sp / 24));   // (the stride shrinks to nothing as the body turns back through a stop: its way flips there)\n        // (the foot on the ground stays where it was put down while the body turns, slows or changes way over it, up\n        // to half a stride from where the gait would have it; a swing carries it on from where it left the ground)\n        const FW = b.feetW || (b.feetW = [null, null]); let f = FW[i], p = [base[0], base[1]];\n        if (q < duty) { if (!f || !f.st) f = FW[i] = { st: true, p }; else p = f.p; }\n        else { if (!f || f.st) f = FW[i] = { st: false, from: f ? f.p : p }; const u = ease((q - duty) / (1 - duty)); p = [lerp(f.from[0], p[0], u), lerp(f.from[1], p[1], u)]; }\n        { const dx = p[0] - base[0], dy = p[1] - base[1], dd = Math.hypot(dx, dy), lim = (reach * .45 + 1.5 * k) * Math.min(1, b.amp * 1.5);   // (half a stride at most; as the body stops, the feet come in under it)\n          if (dd > lim) { p = [base[0] + dx * lim / dd, base[1] + dy * lim / dd]; if (f.st) f.p = p; } }\n        A[i] = [p[0], p[1], footZ(p[0], p[1]) + 1.15 * k + lift * b.amp]; toe[i] = nrm(add(add(fw, md, .5), UP, roll * b.amp));\n      } else if (b.move === 'stand' || b.move === 'crouch') {   // standing: feet apart, the rear one turned out; crouched: wider, a knee forward\n        const S0 = b.stance, now = standFoot(i, S0.yaw, S0.x, S0.y); let base = now.p, lift = 0, tq = now.toe;\n        if (S0.t < 1 && S0.from) {   // a step round: lifted, carried, put down\n          const u = clamp((S0.t - (i === S0.lead ? 0 : .42)) / .58, 0, 1), was = standFoot(i, S0.from.yaw, S0.from.x, S0.from.y);\n          base = mixv(was.p, now.p, ease(u)); lift = Math.sin(u * Math.PI) * 2.3 * k; tq = nrm(mixv(was.toe, now.toe, u));\n        }\n        A[i] = [base[0], base[1], footZ(base[0], base[1]) + 1.15 * k + lift]; toe[i] = tq;\n      }\n    }\n    // a kick: the right leg snaps out ahead at the waist and back (the torso leans away to balance)\n    const kick = b.act === 'kick' ? win(b.actT, .04, .2) * (1 - win(b.actT, .3, .58)) : 0;\n    if (kick > 0 && A[1]) A[1] = mixv(A[1], add(add([b.x, b.y, b.z + 9 * k], fw, 12.5 * k), rt, .8 * k), kick), toe[1] = nrm(mixv(toe[1], add(fw, UP, 1.2), kick));\n    // the pelvis comes down until both legs reach their feet (a long stride lowers it: the run's bob)\n    const pz0 = P[2];\n    for (let i = 0; i < 2; i++) if (A[i] && !(kick > 0 && i === 1)) { const hx = P[0] + rt[0] * (i ? 1.85 : -1.85) * k - A[i][0], hy = P[1] + rt[1] * (i ? 1.85 : -1.85) * k - A[i][1], R = (LT + LS) * .985; P[2] = Math.min(P[2], A[i][2] + Math.sqrt(Math.max(0, R * R - hx * hx - hy * hy))); }\n    // (the hips go down to the feet on a stiff spring, not at once: a foot held to the ground a little far, then lifted,\n    // dropped the hips and sprang them back up in a frame)\n    { const drop = pz0 - P[2], D = b.dropS || (b.dropS = { x: drop, v: 0 }); spring(D, drop, 900, 60, dt); P[2] = pz0 - Math.max(0, D.x); }\n    // the torso: leaning, twisting toward the aim, curling back on a slide; the head looks along the aim\n    const twist = clamp(((b.aimYaw - b.yaw + Math.PI * 3) % TAU) - Math.PI, -1.2, 1.2);\n    const lf = b.leanF.x + b.sl * -.55 + b.cr * .18 + b.air * (b.vz > 0 ? .08 : -.05) - kick * .35, ls = b.leanS.x;\n    const upT = nrm(add(add(add(UP, fw, lf), rt, ls), [b.jx.x * .05, b.jy.x * .05, 0]));\n    const chestYaw = b.yaw + twist * .75, cf = [Math.cos(chestYaw), Math.sin(chestYaw), 0];\n    let rtT = nrm(cross(upT, cf)); rtT = nrm(sub(rtT, mul(upT, dot(rtT, upT)))); const fT = nrm(cross(rtT, upT));\n    const pitchBend = b.aimPitch * (.42 + b.adsB * .1) * (1 - b.spB);\n    const upC = nrm(add(mul(upT, Math.cos(pitchBend)), fT, Math.sin(pitchBend))), fC = nrm(cross(rtT, upC));\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\nBefore every round the players get 10 to 30 seconds to learn what comes\nnext and say when they are ready. By default the hub shows its own card over\nthe game. A game can make the card its own, as part of the game:\n\n```js\nAIHub.connect({ mode, seats, card: true });\n```\n\nThe hub's card then steps aside when the game calls `ready()`, and the game's\nscreen is the card until `start`. How it looks and sounds is the game's: its\ntitle, its music, its world, the players lining up. Introduce the game the way\nit deserves.\n\nWhile it is on, the card shows:\n\n- the game's name;\n- the players, each in their colour, and which of them are ready;\n- how to win the round;\n- the controls this player will use;\n- the time left, from the `card` event.\n\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\non the card:\n\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\n  `AIHub.answer('ready')`.\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\n\nNothing done on the card changes the round. It has no menus, settings or\nchoices, and play begins only at `start`. In parallel and ghost it draws no\nnumbers from `Math.random`, which would change the round's start: use\n`AIHub.rng('card')`.\n\n`card` arrives whenever it changes, and every second while the countdown runs:\n\n| Field | |\n|---|---|\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\n| `paused` | `true` while most players asked for more time |\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\n| `ready` | the ids of the players who are ready |\n| `asking` | how many players asked for more time (never who) |\n| `asked` | `true` when this player asked for more time |\n\n### The start\n\n`start` arrives when the round starts. Play begins three seconds later, when\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\n`start`.\n\n### Reporting\n\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n  standing during the round. `score` is a number, higher is ahead; `label` is\n  text for the hub's scoreboard. The hub takes the latest about once a second.\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\n  ghost, once, when the player's round is over. `time` is milliseconds of\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\n  by the host only:\n  - `standings`: arrays of player ids, best first; players in the same array\n    tie. It lists every player still in the round once; anyone left out is\n    placed last.\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\n  - `won` (optional): `true` or `false` when the round is a team result.\n\n### Time-up and the end\n\n- The hub may call time while the round is still going. On `time-up`, the\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\n  `finish()` from the host in a shared world. A shared world with no\n  `finish()` by then is void.\n- `end` is the last message of a round. After it, the game takes no input and\n  sends nothing, and its sound stops. The hub shows its results over the\n  game, then removes it.\n\n| `end` reason | |\n|---|---|\n| `finished` | the round counted; `standings` is the final order |\n| `void` | it didn't count (no result, a fatal error, skipped) |\n| `host-left` | the host of a shared world left |\n| `sat-out` | this player missed the ready deadline |\n| `session-ended` | the session closed |\n\n### Leaving\n\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\n- A parallel or ghost round goes on whoever leaves, the host included.\n- A shared-world round is void when its host leaves, isn't ready, or has its\n  tab hidden for more than 20 seconds.\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\n  of a shared world it voids the round; from any other copy it counts as\n  that player leaving.\n\n### Scoring\n\n- Parallel and ghost: players with a `time` rank first, lowest first; then\n  the rest by `score`. A player with no result is ranked by their last\n  progress.\n- Shared world: the host's `standings`. With `won`, the results show a team\n  result instead of medals.\n- Each player gets one point for every player they beat.\n\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\nresults:\n\n- in `result()`: `stats` is `{ name: value }` and `awards` is\n  `[{ title, detail }]`, for this player;\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\n  `[{ id, title, detail }]`, for each player.\n\nPlaces and points come only from the standings, `time` and `score`.\n\n---\n\n## Sending data between copies\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '85,162p' src/12-pieces.js && sed -n '150,248p' src/14-environment.js && sed -n '255,365p' hub/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '85,162p' src/12-pieces.js && sed -n '150,248p' src/14-environment.js && sed -n '255,365p' hub/README.md\"","aggregated_output":"    for (const op of ops) {\n      const [w, oh, sill] = OPEN[op.kind], a = op.at - w / 2, b = op.at + w / 2;\n      piece(s0, a, 0, h); piece(a, b, sill + oh, h); if (sill) piece(a, b, 0, sill);\n      const [cx, cy] = at(op.at), [x, y] = atP(P, cx, cy);\n      if (op.kind === 'door') { const [hx, hy] = atP(P, ...at(a)); doors.push({ x, y, z: P.z + lz * M, hx, hy, yaw: P.yaw + yaw, w: w * M, h: oh * M, t: .09 * M, color: op.color || '#6a5a48', state: 'shut', ang: 0, vel: 0, want: 0, block: null, deb: null }); }\n      s0 = b;\n    }\n    piece(s0, L, 0, h);\n  }\n  /** a single-room building: w x d metres, h tall, flat roof with a low parapet; walls: { n, s, e, w: [openings] } */\n  function shack(P, lx, ly, w, d, h, walls, color = CON, roof = CON2, parapet = true) {\n    const x0 = lx - w / 2, x1 = lx + w / 2, y0 = ly - d / 2, y1 = ly + d / 2, t = .22;\n    B(P, lx, ly, -.3, w + .3, d + .3, .32, 0, CON2, K_CONCRETE, false);   // the slab it stands on\n    wall(P, x0, y0, x1, y0, h, t, color, K_CONCRETE, walls.n); wall(P, x1, y1, x0, y1, h, t, color, K_CONCRETE, walls.s);\n    wall(P, x1, y0 + t / 2, x1, y1 - t / 2, h, t, color, K_CONCRETE, walls.e); wall(P, x0, y1 - t / 2, x0, y0 + t / 2, h, t, color, K_CONCRETE, walls.w);\n    B(P, lx, ly, h, w + .2, d + .2, .24, 0, roof, K_CONCRETE);\n    if (parapet) { for (const yy of [y0, y1]) B(P, lx, yy, h + .24, w + .2, .2, .38, 0, roof, K_CONCRETE); for (const xx of [x0, x1]) B(P, xx, ly, h + .24, .2, d - .2, .38, 0, roof, K_CONCRETE); }\n    B(P, lx, y1 + .1, h - .55, w + .2, .14, .14, 0, TRIM, K_PLAIN, false);   // a trim band and a rain pipe\n    beam(P, [x1 + .12, y1 + .12, 0], [x1 + .12, y1 + .12, h], .12, .12, TRIM, K_PLAIN);\n  }\n  /** a shipping container, 6.1 x 2.45 x 2.6 m, its foot lz up; open: both ends open to walk through */\n  function container(P, lx, ly, lz, lyaw, color, open = false) {\n    const c = Math.cos(lyaw), s = Math.sin(lyaw), L = 6.1, Wd = 2.45, Hh = 2.6, t = .1, at = (u, v) => [lx + u * c - v * s, ly + u * s + v * c];\n    if (!open) B(P, lx, ly, lz, L, Wd, Hh, lyaw, color, K_RIBS);\n    else {\n      for (const v of [-1, 1]) { const [x, y] = at(0, v * (Wd / 2 - t / 2)); B(P, x, y, lz, L, t, Hh, lyaw, color, K_RIBS); }\n      B(P, lx, ly, lz + Hh - t, L, Wd, t, lyaw, color, K_RIBS); B(P, lx, ly, lz, L, Wd, .12, lyaw, '#4a3a2a', K_PLANKS, .12);\n      for (const v of [-1, 1]) { const [x, y] = at(L / 2 + .55, v * (Wd / 2 + .05)), a = lyaw + v * 1.2; B(P, x + Math.cos(a) * .05, y, lz + .04, 1.2, .08, Hh - .08, a, E.shade(color, -.08), K_RIBS, false); }\n    }\n    for (const u of [-1, 1]) { const [x, y] = at(u * (L / 2 - .06), 0); B(P, x, y, lz, .14, Wd + .04, Hh + .02, lyaw, E.shade(color, -.25), K_PLAIN, false); }   // the frame's ends\n  }\n  /** a ladder up to z1 metres (its rails at the foot (lx, ly), climbed facing lyaw), with its record for climbing */\n  function ladder(P, lx, ly, z0, z1, lyaw) {\n    const c = Math.cos(lyaw), s = Math.sin(lyaw);\n    for (const v of [-1, 1]) beam(P, [lx - s * v * .24, ly + c * v * .24, z0], [lx - s * v * .24, ly + c * v * .24, z1 + .9], .06, .06, STEEL, K_PLAIN);\n    for (let z = z0 + .3; z < z1 + .1; z += .3) beam(P, [lx - s * .24, ly + c * .24, z], [lx + s * .24, ly - c * .24, z], .045, .045, GALV, K_PLAIN);\n    const [x, y] = atP(P, lx, ly), a = P.yaw + lyaw;\n    ladders.push({ x, y, z0: P.z + z0 * M, z1: P.z + z1 * M, yaw: a, top: [x + Math.cos(a) * 1.1 * M, y + Math.sin(a) * 1.1 * M, P.z + z1 * M] });\n  }\n  /** a watch tower: four legs, braces, a platform h metres up with railings (a gap where the ladder comes up), a roof;\n   *  returns its zipline anchor (world units) */\n  function tower(P, lx, ly, lyaw, h = 8) {\n    const c = Math.cos(lyaw), s = Math.sin(lyaw), at = (u, v) => [lx + u * c - v * s, ly + u * s + v * c], R = 1.45;\n    for (const [u, v] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) { const [x, y] = at(u * R, v * R); B(P, x, y, 0, .26, .26, h + 3.2, lyaw, WOOD, K_PLANKS); }\n    for (let k = 0; k < 4; k++) for (const z of [0, h / 2]) {   // the braces: an X on each side\n      const [u0, v0] = [[-1, -1], [1, -1], [1, 1], [-1, 1]][k], [u1, v1] = [[1, -1], [1, 1], [-1, 1], [-1, -1]][k], a = at(u0 * R, v0 * R), b = at(u1 * R, v1 * R);\n      beam(P, [a[0], a[1], z + .3], [b[0], b[1], z + h / 2 - .2], .14, .1, WOOD, K_PLANKS); beam(P, [b[0], b[1], z + .3], [a[0], a[1], z + h / 2 - .2], .14, .1, WOOD, K_PLANKS);\n    }\n    B(P, lx, ly, h - .2, 3.3, 3.3, .22, lyaw, WOOD, K_PLANKS);\n    const rail = (u0, v0, u1, v1) => { const a = at(u0, v0), b = at(u1, v1), L = Math.hypot(b[0] - a[0], b[1] - a[1]); B(P, (a[0] + b[0]) / 2, (a[1] + b[1]) / 2, h, L, .12, 1.0, Math.atan2(b[1] - a[1], b[0] - a[0]), WOOD, K_PLANKS); };\n    rail(-1.6, -1.6, 1.6, -1.6); rail(-1.6, 1.6, 1.6, 1.6); rail(-1.6, -1.6, -1.6, -.6); rail(-1.6, .6, -1.6, 1.6); rail(1.6, -1.6, 1.6, -.5);   // (the ladder comes up at +u, +v; the zipline leaves from the gap at -u)\n    B(P, lx, ly, h + 3.0, 3.8, 3.8, .16, lyaw, GALV, K_METAL);\n    const [lx2, ly2] = at(1.95, .9); ladder(P, lx2, ly2, 0, h, lyaw + Math.PI);\n    const [ax, ay] = atP(P, ...at(-2.05, 0)); beam(P, [...at(-1.45, 0), h + 2.95], [...at(-2.15, 0), h + 2.95], .12, .12, STEEL, K_PLAIN); return [ax, ay, P.z + (h + 2.85) * M];\n  }\n  /** a zipline from a (an anchor, world units) to b, sagging a little; a post at a ground end */\n  function unusedZipline(a, b, post) {\n    const L = Math.hypot(b[0] - a[0], b[1] - a[1], b[2] - a[2]), sag = L * .03, pts = [];\n    for (let k = 0; k <= 24; k++) { const t = k / 24; pts.push([lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t) - sag * 4 * t * (1 - t)]); }\n    const Z = { x: 0, y: 0, z: 0, c: 1, s: 0, yaw: 0 };\n    for (let k = 0; k < 24; k++) beam(Z, [pts[k][0] / M, pts[k][1] / M, pts[k][2] / M], [pts[k + 1][0] / M, pts[k + 1][1] / M, pts[k + 1][2] / M], .035, .035, '#2a2a2e', K_PLAIN);\n    if (post) { const g = height(b[0], b[1]) / M; beam(Z, [b[0] / M, b[1] / M, g], [b[0] / M, b[1] / M, b[2] / M + .5], .22, .22, WOOD, K_PLANKS); beam(Z, [b[0] / M - .6, b[1] / M, b[2] / M + .2], [b[0] / M + .6, b[1] / M, b[2] / M + .2], .14, .14, WOOD, K_PLANKS); }\n    const zp = { a, b, pts, len: L }; zips.push(zp); return zp;\n  }\n  /** concrete barrier (jersey), 3 m long, 0.82 m tall: vault over it */\n  const barrier = (P, lx, ly, lyaw) => { B(P, lx, ly, 0, 3, .62, .3, lyaw, CON, K_CONCRETE, .82); B(P, lx, ly, .3, 3, .3, .52, lyaw, CON, K_CONCRETE, false); };\n  const sandbags = (P, lx, ly, lyaw, len = 4, h = 1.05) => B(P, lx, ly, 0, len, .7, h, lyaw, BAG, K_BAGS);\n  const crate = (P, lx, ly, lz, lyaw, k = 1.2) => B(P, lx, ly, lz, k, k, k, lyaw, WOOD, K_PLANKS);\n  const bin = (P, lx, ly, lz, lyaw) => { const [x, y] = atP(P, lx, ly); bins.push({ x, y, z: P.z + lz * M, yaw: P.yaw + lyaw, open: 0, used: false }); solids.push({ x, y, z: P.z + lz * M, w: 1.1 * M, d: .62 * M, h: .66 * M, yaw: P.yaw + lyaw }); };\n  const spawn = (o, P, lx, ly, lz = 0, o2 = {}) => { const [x, y] = atP(P, lx, ly); spawns.push(Object.assign({ op: o.id, x, y, z: P.z + lz * M }, o2)); };\n  /** a fuel tank on its side, on two saddles */\n  function tank(P, lx, ly, lyaw, L = 5, r = 1.2) {\n    const c = Math.cos(lyaw), s = Math.sin(lyaw), a = [...atP(P, lx - c * L / 2, ly - s * L / 2)], b = [...atP(P, lx + c * L / 2, ly + s * L / 2)];\n    cylAx([a[0], a[1], P.z + (r + .35) * M], [b[0], b[1], P.z + (r + .35) * M], r * M, 14, '#d8d4c8', K_PLAIN);\n    for (const u of [-.32, .32]) B(P, lx + c * u * L, ly + s * u * L, 0, .4, r * 1.6, .6, lyaw, STEEL, K_PLAIN, false);\n    solids.push({ x: (a[0] + b[0]) / 2, y: (a[1] + b[1]) / 2, z: P.z, w: L * M, d: r * 2 * M, h: (r * 2 + .35) * M, yaw: P.yaw + lyaw });\n  }\n\n  const TR_MAX = 64, DC_MAX = 160, FL_MAX = 24, FL_V = 3 * (16 + 6 * 2 + 2), fx = { tracers: [], decals: 0, trMesh: null, dcMesh: null, flW: null, flO: null, cam: [0, 0, 0], flashes: { world: [], ov: [] }, stars: [] };\n  function fxMeshes(world) {\n    const T3 = E.THREE, { attribute } = E.TSL;\n    const tg = new T3.BufferGeometry(), ti = [];\n    for (let k = 0; k < TR_MAX; k++) ti.push(k * 4, k * 4 + 1, k * 4 + 2, k * 4, k * 4 + 2, k * 4 + 3);\n    tg.setAttribute('position', new T3.BufferAttribute(new Float32Array(TR_MAX * 12), 3)); tg.setAttribute('color', new T3.BufferAttribute(new Float32Array(TR_MAX * 12), 3)); tg.setIndex(ti);\n    tg.setAttribute('normal', new T3.BufferAttribute(new Float32Array(TR_MAX * 12), 3)); tg.setDrawRange(0, 6);\n    const tm = new T3.MeshBasicNodeMaterial({ transparent: true, depthWrite: false, blending: T3.AdditiveBlending, side: T3.DoubleSide, fog: false }); tm.colorNode = attribute('color', 'vec3');\n    fx.trMesh = new T3.Mesh(tg, tm); fx.trMesh.frustumCulled = false; fx.trMesh.renderOrder = 3; world.scene.add(fx.trMesh);\n    const dg = new T3.BufferGeometry(), di = [];\n    for (let k = 0; k < DC_MAX; k++) for (let q = 0; q < 6; q++) di.push(k * 7, k * 7 + 1 + q, k * 7 + 1 + (q + 1) % 6);\n    dg.setAttribute('position', new T3.BufferAttribute(new Float32Array(DC_MAX * 21), 3)); dg.setAttribute('dc', new T3.BufferAttribute(new Float32Array(DC_MAX * 28), 4));\n    dg.setAttribute('normal', new T3.BufferAttribute(new Float32Array(DC_MAX * 21), 3)); dg.setIndex(di);\n    const dm = new T3.MeshBasicNodeMaterial({ transparent: true, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2, side: T3.DoubleSide });\n    dm.colorNode = attribute('dc', 'vec4').rgb; dm.opacityNode = attribute('dc', 'vec4').a;\n    fx.dcMesh = new T3.Mesh(dg, dm); fx.dcMesh.frustumCulled = false; fx.dcMesh.renderOrder = 1; world.scene.add(fx.dcMesh);\n    const flashMesh = (sc, mat) => {\n      const g = new T3.BufferGeometry(); for (const a of ['position', 'color', 'normal']) g.setAttribute(a, new T3.BufferAttribute(new Float32Array(FL_MAX * FL_V * 3), 3));\n      g.setDrawRange(0, 3); const m = new T3.Mesh(g, mat); m.frustumCulled = false; m.renderOrder = 4; sc.add(m); return m;\n    };\n    const tmO = tm.clone(); tmO.colorNode = tm.colorNode; tmO.depthTest = false;   // (on the overlay a flash draws over the gun or the fist that made it)\n    fx.flW = flashMesh(world.scene, tm); fx.flO = flashMesh(world.overlay.scene, tmO);\n  }\n  /** a tracer from a to b (engine units): a bright streak flying at `speed` units a second */\n  function tracer(a, b, color = '#ffd890', speed = 9000, width = .5) {\n    const d = Math.hypot(b[0] - a[0], b[1] - a[1], b[2] - a[2]); if (d < 8) return;\n    fx.tracers.push({ a: a.slice(), b: b.slice(), d, t: 0, life: d / speed + .03, c: linOf(color), w: width });\n    if (fx.tracers.length > TR_MAX) fx.tracers.shift();\n  }\n  /** a bullet hole (or a scorch: big) at a point on a surface, facing its normal n */\n  function decal(p, n, r = .9, color = '#16120e', alpha = .92) {\n    const k = fx.decals++ % DC_MAX, g = fx.dcMesh.geometry, P = g.attributes.position.array, Cc = g.attributes.dc.array, c = linOf(color);\n    const nl = Math.hypot(n[0], n[1], n[2]) || 1, nx = n[0] / nl, ny = n[1] / nl, nz = n[2] / nl, ax = Math.abs(nz) < .9 ? [0, 0, 1] : [1, 0, 0];\n    let tx = ny * ax[2] - nz * ax[1], ty = nz * ax[0] - nx * ax[2], tz = nx * ax[1] - ny * ax[0]; const tl = Math.hypot(tx, ty, tz); tx /= tl; ty /= tl; tz /= tl;\n    const bx = ny * tz - nz * ty, by = nz * tx - nx * tz, bz = nx * ty - ny * tx, rot = (fx.decals * 2.39) % TAU;\n    const set = (i, x, y, z, a) => { P[(k * 7 + i) * 3] = x / M; P[(k * 7 + i) * 3 + 1] = z / M; P[(k * 7 + i) * 3 + 2] = y / M; const o = (k * 7 + i) * 4; Cc[o] = c[0]; Cc[o + 1] = c[1]; Cc[o + 2] = c[2]; Cc[o + 3] = a; };\n    const cx = p[0] + nx * .12, cy = p[1] + ny * .12, cz = p[2] + nz * .12; set(0, cx, cy, cz, alpha);\n    for (let q = 0; q < 6; q++) { const a = rot + q * TAU / 6, rr = r * (.8 + ((q * 7 + fx.decals) % 5) * .1), u = Math.cos(a) * rr, v = Math.sin(a) * rr; set(1 + q, cx + tx * u + bx * v, cy + ty * u + by * v, cz + tz * u + bz * v, 0); }\n    g.attributes.position.needsUpdate = g.attributes.dc.needsUpdate = true;\n  }\n  /** a frame's tracers as quads facing the camera (each a streak along its path with a bright head) */\n  function drawTracers(dt) {\n    const g = fx.trMesh.geometry, P = g.attributes.position.array, C = g.attributes.color.array, cam = fx.cam; let n = 0;\n    for (let i = fx.tracers.length - 1; i >= 0; i--) {\n      const t = fx.tracers[i]; t.t += dt; if (t.t > t.life) { fx.tracers.splice(i, 1); continue; }\n      const u1 = Math.min(1, t.t / t.life * 1.08), u0 = Math.max(0, u1 - Math.min(.5, 260 / t.d)), d = [(t.b[0] - t.a[0]) / t.d, (t.b[1] - t.a[1]) / t.d, (t.b[2] - t.a[2]) / t.d];\n      const h = [t.a[0] + d[0] * t.d * u1, t.a[1] + d[1] * t.d * u1, t.a[2] + d[2] * t.d * u1], e = [t.a[0] + d[0] * t.d * u0, t.a[1] + d[1] * t.d * u0, t.a[2] + d[2] * t.d * u0];\n      // each end as wide as it needs to be seen at its own distance, thinning to nothing at the eye (a streak that\n      // passes the camera never fills the picture)\n      const o = n * 12, fade = 1 - t.t / t.life * .5, pts = [[e, -1, .15], [e, 1, .15], [h, 1, 1], [h, -1, 1]];\n      pts.forEach(([q, sg, k], j) => {\n        const v = [q[0] - cam[0], q[1] - cam[1], q[2] - cam[2]], dist = Math.hypot(...v); let sx = d[1] * v[2] - d[2] * v[1], sy = d[2] * v[0] - d[0] * v[2], sz = d[0] * v[1] - d[1] * v[0]; const sl = Math.hypot(sx, sy, sz) || 1;\n        const w = t.w * (1 + dist / 900) * clamp((dist - 12) / 60, 0, 1) * sg; sx = sx / sl * w; sy = sy / sl * w; sz = sz / sl * w;\n        P[o + j * 3] = (q[0] + sx) / M; P[o + j * 3 + 1] = (q[2] + sz) / M; P[o + j * 3 + 2] = (q[1] + sy) / M; C[o + j * 3] = t.c[0] * k * fade; C[o + j * 3 + 1] = t.c[1] * k * fade; C[o + j * 3 + 2] = t.c[2] * k * fade;\n      });\n      if (++n >= TR_MAX) break;\n    }\n    g.setDrawRange(0, Math.max(6, n * 6)); if (!n) P.fill(0, 0, 12);\n    g.attributes.position.needsUpdate = g.attributes.color.needsUpdate = true;\n  }\n  /** a frame's muzzle flashes as stars facing the eye at cam: a white-hot core, four to six spikes of flame of different\n   *  lengths turned at random, a plume along the barrel; additive, so each fades to nothing at its edges and tips. They\n   *  last two frames: the shot's, full, and one fading (each its own shape) */\n  const FL_PAL = { fire: [[1.7, 1.45, 1], [1.3, .7, .22], [.5, .17, .03]], white: [[1.6, 1.6, 1.55], [1.1, 1, .85], [.35, .3, .26]], blue: [[1.3, 1.6, 1.8], [.45, .9, 1.4], [.08, .24, .5]], purple: [[1.6, 1.4, 1.8], [.95, .55, 1.4], [.3, .1, .5]] };\n  /** a hit's star at p (facing d's way, size s, palette 'white', 'blue' or 'purple'): two frames, held through a hit-stop;\n   *  (s 0: chips only); shards: chips thrown off it; ov: p is in the eye's frame, drawn on the overlay (over the fist that threw it) */\n  function impactStar(p, d, s, pal, shards = 0, ov = false) {\n    if (s > 0 && fx.stars.length < 12) fx.stars.push({ p: p.slice(), f: d.slice(), s, pal, t: 0, ov, seed: 1 + Math.floor(Math.abs(p[0] * 31 + p[1] * 17 + p[2] * 7)) % 2147483000 });\n    const sd = [-d[1], d[0], 0];\n    for (let i = 0; i < shards && fx.stars.length < 24; i++) { const a = (i % 2 ? 1 : -1) * (.4 + Math.random() * .8), v = [(sd[0] * a * 1.6 - d[0] * .4) * 45, (sd[1] * a * 1.6 - d[1] * .4) * 45, 20 + Math.random() * 30]; fx.stars.push({ p: p.slice(), f: d.slice(), s: ov ? .22 : .45, pal, t: 0, v: ov ? mul(v, .5) : v, ov, life: .1, seed: 7 + i * 131 }); }   // (chips thrown aside and back toward the eye, arcing down for six frames)\n  }\n  function drawFlashes(mesh, list, cam) {\n    const g = mesh.geometry, P = g.attributes.position.array, C = g.attributes.color.array, K = [0, 0, 0]; let v = 0;\n    const put = (q, c) => { P[v * 3] = q[0] / M; P[v * 3 + 1] = q[2] / M; P[v * 3 + 2] = q[1] / M; C[v * 3] = c[0]; C[v * 3 + 1] = c[1]; C[v * 3 + 2] = c[2]; v++; };\n    const tri = (a, ca, b, cb, c, cc) => { put(a, ca); put(b, cb); put(c, cc); };\n    for (const fl of list) {\n      const { p, s } = fl, h = fl.heat, view = nrm(sub(p, cam)), a = nrm(cross(view, Math.abs(view[2]) < .95 ? UP : [1, 0, 0])), b = cross(a, view);\n      let r = fl.seed; const rn = () => (r = (r * 16807) % 2147483647) / 2147483647;\n      const pal = FL_PAL[fl.pal || 'fire'], hot = mul(pal[fl.thin && fl.pal !== 'fire' ? 1 : 0], h * (fl.thin ? 1.6 : 1)), warm = mul(pal[1], h * (fl.thin ? 1.6 : 1)), tip = mul(pal[2], h), ring = (rr, t) => add(add(p, a, Math.cos(t) * rr), b, Math.sin(t) * rr);\n      const rc = s * (.55 + rn() * .2), dim = mul(warm, h >= 1 ? .16 : 0);\n      for (let i = 0; i < 8; i++) { tri(p, hot, ring(rc, i / 8 * TAU), K, ring(rc, (i + 1) / 8 * TAU), K); tri(p, dim, ring(rc * 2.1, i / 8 * TAU), K, ring(rc * 2.1, (i + 1) / 8 * TAU), K); }   // (and the air round it, lit, on the first frame)\n      const n = 4 + Math.floor(rn() * 3), rot = rn() * TAU;\n      for (let i = 0; i < n; i++) {\n        const t = rot + i / n * TAU + (rn() - .5) * .6, d = add(mul(a, Math.cos(t)), b, Math.sin(t)), pp = add(mul(a, -Math.sin(t)), b, Math.cos(t));\n        const len = s * (1 + rn() * 1.9) * (i % 2 ? .7 : 1), w = s * (.16 + rn() * .1) * (fl.thin ? .6 : 1), e = add(p, d, len), m = add(p, d, len * .2);\n        tri(p, warm, add(m, pp, w), K, e, tip); tri(p, warm, e, tip, add(m, pp, -w), K);\n      }\n      const wa = cross(fl.f, view), wl = Math.hypot(...wa);\n      if (wl > .05) {\n        const len = s * (1.8 + rn() * 1.2), e = add(p, fl.f, len), m = add(p, fl.f, len * .3), w = mul(wa, s * .34 / wl);\n        tri(p, hot, add(m, w), K, e, tip); tri(p, hot, e, tip, sub(m, w), K);\n      }\n    }\n    g.setDrawRange(0, Math.max(3, v)); if (!v) P.fill(0, 0, 9);\n    g.attributes.position.needsUpdate = g.attributes.color.needsUpdate = true; list.length = 0;\n  }\n\n\n### Parallel\n\nThe copies send nothing to each other. `send()` is not used.\n\n### Ghost\n\nEach copy sends its own player's position and what the player is doing to\nthe other copies with `send()`. Each copy shows the other players' characters\nonly while they are in the same area of the game as its own player, and those\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\n\n### Shared world\n\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\n  host what their own player does, and show the world the host sends them.\n- The hub can run the host's copy with no player of its own: `AIHub.server`\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\n  the world in that case too, with no local player, camera or input.\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\n  every copy.\n\n### `send()` and `message`\n\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n  to the one player `to`. It returns `false` when the message is dropped.\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n  sender's player id. A copy never receives its own messages. Messages sent\n  before another copy has loaded are queued for it.\n- `data` is JSON, at most 16 KB.\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\npython3 -m http.server 8000\n```\n\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\nThe hub's own test also runs ghost and shared-world games with\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\n`&scenario=host-leave`, and shared worlds once more with\n`&players=2&scenario=server`.\n\nThe checklist fills in as it runs. **A game passes when\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\n`\"true\"` at the end. It checks:\n\n- the tags, `connect()`, `ready()` with no key press, and the start;\n- with the game's own card, that Enter answers Ready;\n- parallel and ghost: `Math.random` the same on every copy, and progress from\n  every copy; parallel sends nothing, ghost sends;\n- shared world: traffic both ways, and a round hosted by a copy with no\n  player of its own;\n- a player leaving, the host leaving, time-up, a valid result, and every copy\n  told the round ended;\n- no protocol problems, errors, dialogs, popups or sockets.\n\n**New round**, **Time up**, **Remove player** and **Hide host tab** run the\ncases by hand; clicking a player's frame gives it the keyboard and mouse.\n`&limit=` sets the round's length in seconds and `&seed=` fixes the seed. The\ngame is served from the harness's own origin.\n\nIn the AI Hub repository, `node scripts/hub-check.mjs <game>` runs the same\nchecks with Playwright, then opens the game outside a session to see it still\nruns there.\n\n---\n\n## Reference\n\n### Tags\n\n| Tag | |\n|---|---|\n| `hub:session` | `1`: this protocol |\n| `hub:session-players` | `MIN-MAX`: the number of players the game takes in a session |\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"rg -n 'const CON|function arm|WEAPONS|reloadCurve|pumpCurve|keysAt|MANTLE' src/12-pieces.js src/20-soldier.js && sed -n '1,168p' engine-repo/dist/handoff/docs/ASSETS.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"rg -n 'const CON|function arm|WEAPONS|reloadCurve|pumpCurve|keysAt|MANTLE' src/12-pieces.js src/20-soldier.js && sed -n '1,168p' engine-repo/dist/handoff/docs/ASSETS.md\"","aggregated_output":"src/20-soldier.js:212:      if (a === 'reload') { const R = reloadCurve(b.weapon, t, b.reloadDur, b.reloadEmpty); F = turn(F, R.pitch, R.yaw, R.roll); F.o = add(F.o, F.u, R.lift * k); }\nsrc/20-soldier.js:224:    const k = b.k, W = WEAPONS[b.weapon];\nsrc/20-soldier.js:227:    if (a === 'reload') { const R2 = reloadCurve(b.weapon, t, b.reloadDur, b.reloadEmpty); if (R2.hand) Lh = at(G, R2.hand[0] * k, R2.hand[1] * k, R2.hand[2] * k); }\nsrc/12-pieces.js:78:  const CON = '#bdb4a2', CON2 = '#9a9284', TRIM = '#5a5650', STEEL = '#3a3e44', GALV = '#9aa09a', WOOD = '#9a7448', BAG = '#b8a478', TARP = '#5f6e4c';\n# Objects and materials as data\n\nThe full engine draws still objects (barrels, tables, trees, wells) from a few lines of data, in every view and facing,\nwith the house shading and outline, and gives every surface (floors, wall faces, wall tops, platform tiles, the objects'\nown faces) a material from one open registry. An object costs one to a few hundred tokens of data (the core's median is\n125); you check it headless with one command. Read this card whole before you write one. (The agent edition keeps the\nregistries and ignores the calls: `E.addAssets` returns empty lists, the others null.)\n\n## Use one\n\n```js\n// in draw(r): feet on the point, depth sorted like an actor; its front toward facing\nr.shape('barrel', x, y, 0, { facing: Math.PI / 2 });\n// once, before the updates: bodies stop at it, a body coming down lands on it, one wholly below passes under\nmap.solid('table', 120, 80, 0, { facing: 0 });\n// a sprite of it, for an inventory or a HUD (r.sprite, px.sprite)\nconst icon = E.shapeSprite('chest', { view: 'iso' });\n```\n\n- **r.shape options:** facing (radians, where the front points: 0 east, π/2 south, as written), scale, mats ({ slot:\n  material }), flip (mirrors it x to -x, collision too), params (a generator's: { h: 30 }), bias, hides (default true),\n  light (adds its lights to game.lights), shadow (default true).\n- **map.solid** takes the same id and placement, so one object can feed both calls. Bodies span z to z + h (E.Body's h, 32).\n- **In 3D** the 3D engine draws the same entries, materials and boxes: `world.shape(id, x, y, z, o)` (its header).\n- **Steep views** (top-down) draw shapes from the characters' lower angle, as rigs are drawn. The light comes from the\n  viewer's upper left in every view.\n- **Glow and fire:** a material with glow: 1 ignores the light and stays bright in the dark; an entry's flames ([[x, y, z,\n  w, h]]) draw the engine's animated flame (r.shape only: a sprite has none). Anything else that moves stays a prop\n  (r.prop) or your own code.\n- **Dressing a generated level:** a scene is a few entries as [id, across, forward] from an anchor (a wall spot, forward\n  into the room); place it whole or not at all, each part on free floor, after the level's own random picks and from a\n  seeded stream of its own, so the level stays as its seed builds it (Emberdeep's `src/emberdeep/53-scenes.js`).\n\n## The core library\n\n**Shapes** (sized for a 26-unit hero; generators take params): barrel, crate, chest, table, chair, stool, bench, bed,\nbookcase, shelf, pot, jar, sack, cart, well, sign, lamppost, anvil; fence { len: 16 }, pine { h: 41, tiers: 4 },\ntree { h: 40, seed: 1 }, bush { r: 7 }, grass { h: 6, n: 6 }, rock { r: 7.5, seed: 2 }, crystal { h: 18, seed: 1 }.\n`r.shape('pine', x, y, 0, { params: { h: 30 } })`; `E.SHAPES.barrel.about` says what each is.\n\n**Materials:** woods oak walnut birch crate plank planks wood; stones stone cobble marble granite sandstone slate rock\nbrick flagstone ruin; metals iron steel gold copper bronze metal rusted; clay glazed porcelain; cloth linen burlap wool velvet leather;\nplants bark needles leaves shrub moss straw hedge grass; ground dirt sand snow mud; water ice crystal flame bone shingle;\nwalls timber plaster; tops speckle plain tiles slab; tiles block bonus ground pipe checker.\n\n## Materials on surfaces\n\n```js\nE.MATERIALS.mossy = { color: '#6a7a5a', pattern: 'stones', size: 6 };   // or the shorthand '#6a7a5a stones size=6'\nconst types = { 1: { h: 32, top: '#6a6280', side: '#4a4360', face: 'cobble', roof: 'slate' } };   // TileMap walls\nconst map = new E.TileMap({ rows, legend, types, floorMat: 'flagstone', floorMats: { water: 'water' } });   // floors\nconst level = new E.PlatformMap({ rows, legend, types: { 1: { kind: 'solid', style: 'block', mat: 'mossy' } } });\n```\n\nfloorMats is keyed by the floor tags of the legend ('~': { floor: 'water' }); either stands in for floorTex.\n\nA material is `{ color, pattern, ...the pattern's numbers, ramp, glow, over }`. Its five tones come from `E.tones(color)`\n(or its own `ramp` of five, dark to light); the light picks a band, the pattern moves it a step, so a material works on\nevery surface and in every palette and recolors with one hex. An unknown name warns with the list of names.\nOverlays, the last on top, each in its own color's tones: `over: [['moss', '#5f7a3a', { up: .6 }], ['cracks']]`; moss on\nwhat looks up, cracks (the material a step darker), dirt near the ground (h 6), rust; each takes amount and size.\n\n| Pattern | Numbers | What |\n| --- | --- | --- |\n| none | | the light alone |\n| planks | bw 3, len 14, dir | boards with joints; staves on round parts; dir: 'v' turns them |\n| crate | frame 2, bw 3 | a framed, braced side; planks on its lid |\n| bricks | bw 6, bh 3, mortar | running bond |\n| stones | size 5 | irregular stones (Voronoi), dark joints, a lit rim |\n| tiles | size 4 | square tiles, grout |\n| speck, noise | amount .08; scale 4 | specks; soft patches |\n| foliage | size 3.5 | leaf clumps lit on top |\n| bark | | fissures; rings on a cut end |\n| metal | rivet | a shine where lit; rivets |\n| cloth | fold .9 | weave and folds |\n| glaze | | a glossy shine |\n| thatch, shingles | course; bw | straw courses; roof tiles |\n\nYour own pattern: `E.PATTERNS.waves = (s, m) => Math.sin(s.u / (m.size || 3)) > .8 ? 1 : 0` (s.u, s.v: world units\nacross and up the surface; s.lid, s.curved, s.lit, s.W, s.H; return a step, -1 to +2). A material may also paint one kind\nof surface its own way, per pixel: `face(wx, z, tones, type, cx, cy, fi, nh, h)` or `roof(wx, wy, tones, type)` returning\na color or null, `floor(x, y, tag, view)` returning [r, g, b].\n\n## Write one\n\nUnits: 16 = 1 m = one tile; x east, y south, z up. The origin is the middle of the footprint on the ground; write it\nfacing south (+y). Use whole or half units: a pixel at game size is about 0.7 units.\n\n```js\nE.SHAPES.stool = { about: 'round three-legged stool', tags: 'furniture tavern', mats: { w: 'oak', l: 'walnut' },\n  parts: [['cyl','w',[0,0,8],5,1.5], ['ring',3,3,['box','l',[0,0,0],[1.5,1.5,8],{rot:[0,-8,0]}]]] };\n```\n\nAn entry: `about`, `tags`, `mats` (slot to material; a slot name that is not in mats is a material itself), and `parts`, or\n`make(params)` returning parts with `params` its defaults. Optional: `scale` (times the placement's), `foot: [x0, y0,\nx1, y1]` (the footprint for collision, and for sorting when it stands raised; the bounds by default), `lights: [[x, y,\nz, color, radius]]`, `flames: [[x, y, z, w, h]]`.\n\n| Part | Form | Notes |\n| --- | --- | --- |\n| box | `['box', m, at, [w, d, h], { rot }]` | at: the bottom middle |\n| cyl | `['cyl', m, at, r, h, { r2, seg, sq }]` | r2: top radius (0: a cone); sq squashes y; seg: 6 for a hexagon |\n| lathe | `['lathe', m, at, [[r, z], ...], { seg }]` | a profile turned about z, bottom to top; [0, z] closes an end |\n| ball | `['ball', m, at, r, { sz }]` | at: its centre; sz below 1 flattens it |\n| prism | `['prism', m, at, [[a, b], ...], h, { axis }]` | an outline pushed h: up z (outline x, y), or centred along y (outline x, z) or x (outline y, z) |\n| wedge | `['wedge', m, at, [w, d, h]]` | h tall at the back, down to the floor at the front |\n| rock | `['rock', m, at, r, { sz, seed, rough }]` | a lumpy, faceted ball; below the floor is not drawn |\n| use | `['use', id, at, { rot, scale, mats, ...params }]` | another shape inside this one |\n| mirror | `['mirror', 'x' \\| 'y' \\| 'xy', part]` | the part and its mirror copies |\n| ring, row | `['ring', n, radius, part]`, `['row', n, [dx, dy, dz], part]` | n copies round z (the part moved out to radius); n copies in a line, centred |\n| group | `['group', at, rot, [parts]]` | parts moved and turned together |\n\nEvery part takes `{ rot }`: a yaw in degrees, or [x, y, z] degrees. Write arrays densely (`[0,0,8]`, not `[0, 0, 8]`):\nspaces cost a third more tokens.\n\n### Worked entries\n\n```js\nbarrel: { about: 'oak barrel, two iron hoops', tags: 'container wood', mats: { w: 'oak', h: 'iron' },\n  parts: [['lathe','w',[0,0,0],[[0,0],[5,0],[6,3],[6.5,8],[6,13],[5,16],[0,16]]], ['row',2,[0,0,9],['cyl','h',[0,0,7.5],6.5,1.5]]] },\ncrate: { about: 'wooden crate, framed and braced', tags: 'container wood', mats: { c: 'crate' }, parts: [['box','c',[0,0,0],[15,15,14]]] },\ntable: { about: 'plank table, four legs', tags: 'furniture tavern', mats: { t: 'oak', l: 'walnut' },\n  parts: [['box','t',[0,0,10],[24,14,2]], ['mirror','xy',['box','l',[10,5,0],[2,2,10]]]] },\nchest: { about: 'oak chest, round lid, iron bands', tags: 'container treasure', mats: { w: 'oak', b: 'iron', l: 'gold' },\n  parts: [['box','w',[0,0,0],[16,10,8]], ['prism','w',[0,0,8],[[-5,0],[5,0],[4,3],[0,5],[-4,3]],16,{axis:'x'}],\n    ['mirror','x',['box','b',[5.5,0,0],[1.5,11,8.5]]], ['box','l',[0,5,5],[3,1,3]]] },\nlamppost: { about: 'iron street lamp, glowing head', tags: 'town light', mats: { m: 'iron', g: 'flame' }, lights: [[0,0,40,'#ffd070',70]],\n  parts: [['cyl','m',[0,0,0],2.5,3], ['cyl','m',[0,0,3],1,34], ['box','g',[0,0,37],[4,4,5]], ['cyl','m',[0,0,42],3.5,3,{r2:0,seg:4}]] },\nfence: { about: 'rail fence, len long (16)', tags: 'village farm', mats: { w: 'oak' }, params: { len: 16 },\n  make: p => [['mirror','x',['box','w',[p.len / 2 - 1,0,0],[2,2,12]]], ['row',2,[0,0,5],['box','w',[0,0,6],[p.len - 2,1,1.5]]]] },\n```\n\nA generator seeds its noise from its params (`E.rng(seed)`), never `Math.random`, so it draws the same pixels everywhere.\n\n## Make one: the recipe\n\n1. **Read this card whole.**\n2. **Find** the nearest entry: `node tools/asset-find.mjs \"tavern table\"` searches the core library and the store's sets\n   (`src/assets/sets/`, about a thousand objects, materials and sprites converted from CC0 libraries, each with where it\n   came from) and `--show set:id` prints one; the Asset Lab (`/asset-lab`) shows them all.\n3. **Copy** it and change its names, parts and materials, or write a new one from the parts above. Give the cue a player\n   knows it by parts of its own (a skep's coils as stacked rings, an anvil's horn, a barrow's open tub dark inside), and\n   keep small parts plain ('none', 'glaze'): a busy pattern on a part a few pixels wide reads as speckle.\n4. **Look:** `node tools/asset-sheet.mjs mine.js#stool` (a file that sets `E.SHAPES.stool`, or a store set; a core id\n   alone works too: `node tools/asset-sheet.mjs barrel`). It draws `check-output/asset-sheet/stool.png`: every view and\n   four facings, beside the hero, on a light and a dark floor. It lints what reads badly: too small from above, a part\n   under a pixel, too few tones, low contrast with the floor, its tokens. Read the picture, fix, repeat.\n5. **Use** it: `E.SHAPES.stool = {...}` and `r.shape('stool', ...)`; or a set file\n   (`(window.ASSETS = window.ASSETS || {}).MINE = { set: 'MINE', format: 1, materials, shapes }`) and\n   `E.addAssets(window.ASSETS.MINE)`, which names its entries 'MINE:stool' so they never collide, and returns the names.\n   A store set loads the same way (its script, then `E.addAssets(window.ASSETS['kenney-furniture'])`);\n   `node tools/asset-set.mjs <sets> --ids a,b --name mine --out mine.js` cuts the few a game uses, with what they need\n   (Emberdeep's set dressing loads `src/assets/sets/emberdeep.js`, cut so).\n\n## Limits\n\n- Still objects. Lids that open, swinging signs and held weapons are code (or props) for now.\n- A shape sorts by one point, as props do; a long one (a bed, a cart) may cross a body walking right beside it.\n- Collision is the footprint's box, turned with the shape, and the bounds' height: a table is solid under its top too.\n- Bigger than about 240 pixels on screen, a shape skips the actors' effects (flash, x-ray).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/14-environment.js');p.write_text('  /* Structures: '+p.read_text())\n# Use thorn crowns and the new bottle-tree silhouette; no conifers in Lacustria.\np=Path('src/14-environment.js');s=p.read_text().replace(\\\"pine: () => ['pine', { params: { h: 44, tiers: 5 }, mats: { l: '#335c3a foliage size=3', b: '#6a4a30 bark' } }],\\\",\\\"pine: () => ['bottle', { mats: { l: '#8e8a55 foliage size=3', b: '#8e795b bark' } }],\\\")\ns=s.replace(\\\"if (m < 150\\\", \\\"if (biomeAt(m,n)==='salt'||biomeAt(m,n)==='brine') continue;\\\\n      if (m < 150\\\")\ns=s.replace(\\\"const keep = (1 -\\\", \\\"const keep = (FUEL[biomeAt(m,n)]?1:0) * (1 -\\\")\ns=s.replace(\\\"(sage ? .3 : .3 + b * .26) * M\\\", \\\"(biomeAt(m,n)==='reeds'?1.3+b*.85:(sage ? .3 : .3 + b * .26)) * M\\\")\np.write_text(s)\nPY\ncat > src/13-layout.js <<'EOF'\nconst PROPS=[];\nfunction prop(id,P,x,y,z=0,o={}){PROPS.push({id,x:atP(P,x,y)[0],y:atP(P,x,y)[1],z:P.z+z*M,o});}\nfunction tentRow(P,count,x,y){for(let k=0;k<count;k++){const xx=x+(k%6)*7,yy=y+Math.floor(k/6)*8;for(const s of [-1,1])beam(P,[xx,yy,2.4],[xx,yy+s*2,0],5,.08,'#a59b75',K_PLAIN);beam(P,[xx-2.6,yy,2.4],[xx+2.6,yy,2.4],.08,.08,WOOD,K_PLANKS);B(P,xx,yy,0,4.8,3.5,.15,0,'#554934',K_PLANKS,false);}}\nfunction hull(P,x,y,yaw=0,index=0){const q={...P,x:atP(P,x,y)[0],y:atP(P,x,y)[1],yaw,c:Math.cos(yaw),s:Math.sin(yaw)};const C=index%2?'#4f5c50':'#7a3a1e';\n B(q,0,0,.2,22,5.7,.3,0,'#38362b',K_METAL);for(const side of [-1,1]){B(q,0,side*3,.3,22,.18,4.6,0,C,K_METAL);beam(q,[-11,side*3,.3],[-15,0,2],.15,3,C,K_METAL);beam(q,[11,side*3,.3],[14,0,2],.15,3,C,K_METAL);for(let i=-9;i<10;i+=3)B(q,i,side*3.12,.5,.16,.16,4.6,0,'#9a6346',K_PLAIN,false);}\n B(q,-7,0,4.9,6,5.8,.2,0,'#8b805f',K_METAL);shack({...q,z:q.z+4.9*M},-6,0,4.6,4.3,3,{n:[{at:2.3,kind:'window'}],s:[{at:2,kind:'door'}],e:[{at:2,kind:'window'}]},'#b4a888','#70634d',false);ladder(q,-9,3.6,0,4.9,-Math.PI/2);\n beam(q,[-1,0,0],[-1,0,14],.2,.2,'#665340',K_PLAIN);beam(q,[-1,-4,10],[-1,4,10],.12,.12,'#665340',K_PLAIN);beam(q,[-1,0,14],[9,3,4.7],.025,.025,'#3b3630',K_PLAIN);beam(q,[-1,0,14],[-9,-3,4.7],.025,.025,'#3b3630',K_PLAIN);\n for(let i=-5;i<7;i+=4)crate(q,i,0,.6,.1,1.1);B(q,7,0,.3,4,4,.2,0,'#3e392e',K_PLANKS);return q;\n}\nfunction layout(){E.SHAPES.bottle={about:'Bottle tree with swollen trunk and flat thorn crown',mats:{b:'#8e795b bark',l:'#8e8a55 foliage'},parts:[['lathe','b',[0,0,0],[[5,0],[7,13],[5,28],[2,45],[1.5,54]],{seg:8}],['ball','l',[0,0,56],12,{sz:.23}],['ball','l',[10,0,54],8,{sz:.25}]]};\n for(const o of SITES){const q=o.P;if(o.id==='fleet'){for(let i=0;i<9;i++)hull(q,(i%3-1)*43,(Math.floor(i/3)-1)*36,(i%3-1)*.37,i);}\n else if(o.id==='salt'){shack(q,-9,-8,24,9,4,{s:[{at:9,kind:'bay'},{at:18,kind:'door'}]},'#a9a08a','#7a6e5c');for(let i=0;i<8;i++)B(q,12+i%3*3,Math.floor(i/3)*4,0,3,3,1+i%2,.1,'#d9d2bd',K_PLAIN,false);tentRow({...q,y:q.y+120*M,z:height(q.x,q.y+120*M)},30,-20,-10);}\n else if(o.id==='lamp'){CYL(q,0,0,0,4.8,33,'#c4b9a0',K_CONCRETE,18);CYL(q,0,0,0,4.95,4,'#8c4430',K_CONCRETE,18);CYL(q,0,0,33,5.6,.4,'#433d35',K_METAL,18);CYL(q,0,0,33.4,4.1,4.5,'#a99f7c',K_PLAIN,12);CYL(q,0,0,37.9,5.3,1,'#413c35',K_METAL,12);CYL(q,0,0,39,1,2,'#433d35',K_METAL,8);ladder(q,5,0,0,33,Math.PI);shack(q,14,6,7,6,3,{s:[{at:3,kind:'door'}]},'#c3b69b');}\n else if(o.id==='sill'){B(q,0,0,-20,240,14,46,0,'#9e9480',K_CONCRETE);for(const x of [-65,0,65]){B(q,x,7.2,-15,28,.6,31,0,'#4b5148',K_RIBS);beam(q,[x,8,-15],[x,8,26],.4,.4,STEEL,K_PLAIN);}B(q,0,0,26,242,16,.3,0,'#b6a98b',K_CONCRETE);shack({...q,z:q.z+26.3*M},0,0,13,10,4.3,{s:[{at:6.5,kind:'bay'}],n:[{at:3,kind:'window'},{at:9,kind:'window'}]},'#ada78e');for(let i=0;i<92;i++)B(q,-120+i*1.2,15,0+i*.286,1.25,3,.3,0,CON2,K_CONCRETE);B(q,38,-18,26,22,22,.3,0,'#525448',K_CONCRETE);ladder(q,-4,8,0,26,-Math.PI/2);}\n else if(o.id==='mission'){wall(q,-12,-10,12,-10,5,.6,'#c2b69b',K_CONCRETE,[{at:12,kind:'bay'}]);wall(q,-12,-10,-12,10,4,.6,'#b9ad94',K_CONCRETE,[{at:5,kind:'window'},{at:15,kind:'window'}]);wall(q,12,-10,12,10,3.2,.6,'#b9ad94',K_CONCRETE);B(q,0,-10,5,2,.5,2.5,0,'#b9ad94',K_CONCRETE);tentRow(q,12,-30,20);tank(q,18,-10,0);prop('bed',q,-7,0,0,{scale:1.5});prop('table',q,4,0,0,{scale:1.4});}\n else if(o.id==='port'){for(let i=0;i<14;i++){const x=(i%5-2)*16,y=(Math.floor(i/5)-1)*22;shack(q,x,y,10+i%3,9,4+(i===2?8:0),{s:[{at:5,kind:'door'}],n:[{at:3,kind:'window'}]},i%2?'#b9a789':'#bfae8e');}B(q,0,65,-4,160,5,5,0,'#a89a80',K_CONCRETE);hull(q,-30,47,.1,2);}\n else if(o.id==='reedcamp'){tentRow(q,12,-20,-15);B(q,0,10,0,50,2,.3,0,WOOD,K_PLANKS);tower(q,-24,12,0,7);}\n else if(o.id==='strip'){B(q,0,0,-.1,90,8,.15,0,'#b6a487',K_PLAIN,false);for(let i=-40;i<40;i+=9)B(q,i,0,.06,4,.2,.02,0,'#ded4b8',K_PLAIN,false);B(q,-16,15,0,10,1.8,1.5,.3,'#a78c54',K_METAL);B(q,-16,15,1.3,2,14,.2,.3,'#c1aa74',K_METAL,false);}\n else if(o.id==='st4'){shack(q,0,0,12,9,4,{s:[{at:6,kind:'bay'}],n:[{at:3,kind:'window'}]},'#a7a18a');tank(q,16,0,0,8,2);beam(q,[-15,3,.4],[18,3,.4],.4,.4,'#6e6554',K_METAL);tower(q,-16,16,0,7);}\n else if(o.id==='tannery'){shack(q,-6,-6,9,7,3,{s:[{at:4,kind:'door'}]},'#b09b7a');for(let i=0;i<6;i++){CYL(q,8+i%3*4,Math.floor(i/3)*5,0,1.5,1,'#725c46',K_CONCRETE,10);}}\n else if(o.id==='watertower'){tower(q,0,0,0,12);CYL(q,0,0,12,3.5,5,'#8a8b75',K_RIBS,12);shack(q,8,8,6,6,3,{s:[{at:3,kind:'door'}]},'#a89b7a');}\n else if(o.id==='k9'||o.id==='red'){for(let i=0;i<6;i++)container(q,(i%3-1)*10,(Math.floor(i/3)*2-1)*14,0,0,i%2?'#716e50':'#9b6747',i===1);tower(q,-22,20,0,9);shack(q,0,-28,12,8,4,{s:[{at:6,kind:'bay'}]},'#b6a585');for(let x=-24;x<25;x+=8)sandbags(q,x,25,0,6);}\n if(o.faction==='safe'){prop('bed',q,0,6,0,{scale:1.5});prop('chest',q,5,6,0,{scale:1.5});prop('chair',q,-3,6,0,{scale:1.3});}\n if(\"'!['\"'remnant','fleet','strip','sill'].includes(o.id)){prop('barrel',q,12,12,0,{scale:1.5});prop('crate',q,14,12,0,{scale:1.2});}\n }\n for(const p of POSTS){const q=p.P;barrier(q,0,-3,Math.PI/2);sandbags(q,3,7,Math.PI/2,6);sandbags(q,-3,-8,Math.PI/2,6);tower(q,-9,8,0,5);prop('barrel',q,4,7,0,{scale:1.5});}\n for(const st of STAKES){const q={x:st.m*M,y:st.n*M,z:height(st.m*M,st.n*M),c:1,s:0,yaw:0};for(const a of [0,2.1,4.2])beam(q,[Math.cos(a)*.5,Math.sin(a)*.5,0],[0,0,1.2],.05,.05,STEEL,K_PLAIN);B(q,0,0,1.15,.8,.6,.4,0,'#8e967b',K_METAL,false);}\n}\nfunction placeProps(){for(const p of PROPS)world.shape(p.id,p.x,p.y,p.z,{...p.o,solid:false});}\nEOF\ncat > src/25-guns.js <<'EOF'\nfunction drawGun(pen,F,weapon,st={},k=1){if(\"'!weapon||!WEAPONS[weapon])return;const W=WEAPONS[weapon],cond=st.cond??1,c=E.hex('\"'#343a35'),rust=E.hex('#7a4930'),col='#'+c.map((v,i)=>Math.round(lerp(rust[i],v,cond)).toString(16).padStart(2,'0')).join(''),wood='#75543a',dk='#252924';const L=(a,b,c=0)=>at(F,a*k,b*k,c*k),bar=(a,b,w,t,c)=>pen.slab(...a,...b,...F.r,w*k,t*k,c),tube=(a,b,r,c)=>pen.tube(...a,...b,r*k,c);const side=W.slot==='side',len=side?6:weapon==='bishop'?16:weapon==='curate'?18:13;\n bar(L(-2,0),L(side?2:4,0),side?1:1.2,side?1.5:1.7,col);bar(L(-.5,0),L(-1.5,-2.7),.85,1.1,wood);tube(L(side?1.5:3,.6),L(len,.6),weapon==='bishop'?1.3:.3,dk);\n if(\"'!side){bar(L(-2,0),L(-7,-.9),.9,1.5,wood);bar(L(4,0),L(8,0),1.3,1.2,wood);if(weapon!=='\"'curate'&&weapon\"'!=='\"'sexton')bar(L(1,-.8),L(2.2,-4.5-(st.mag||0)*2),.85,1.2,col);}\n if(weapon==='verger')tube(L(0,0),L(1.6,0),1.1,col);\n if(weapon==='curate'){tube(L(-1,2.1),L(4,2.1),.65,dk);tube(L(3.6,2.1),L(4.3,2.1),.8,'#424d42');}\n if(weapon==='gardener'){tube(L(3,0),L(13,0),.6,'#746a45');tube(L(6,-1.2),L(11,-1.2),.3,dk);pen.glow(...L(13,.5),.3,'#f6b957');}\n if(weapon==='choir'){bar(L(1,-.7),L(3,-4),2,2,dk);tube(L(11,-.5),L(13,-3),.12,dk);}\n for(const a of [side?0:1,len-1])bar(L(a,.8),L(a,1.7),.22,.3,dk);\n if(cond<.5)for(let i=0;i<3;i++)bar(L(4+i*.45,-.7),L(4+i*.45,.6),1.4,.18,'#aca181');\n if(st.bolt)tube(L(-1-st.bolt*2,1,1),L(-1-st.bolt*2,1,1.8),.2,dk);\n if(st.flash>0){pen.glow(...L(len+1,.6),1.3*st.flash,'#ffc775');pen.cone(...L(len,.6),...L(len+6*st.flash,.6),1.4,'#ffd18a');}\n}\nfunction keysAt(keys,t){if(t<=keys[0][0])return keys[0][1];for(let i=0;i<keys.length-1;i++)if(t<keys[i+1][0])return mixv(keys[i][1],keys[i+1][1],win(t,keys[i][0],keys[i+1][0]));return keys[keys.length-1][1];}\nfunction reloadCurve(weapon,t,dur=2){const v=Math.sin(clamp(t/dur,0,1)*Math.PI);return {pitch:v*.3,yaw:0,roll:v*.9,lift:v,hand:[2,-2-v*5,-1],mag:v>.7?1:0,bolt:win(t,dur*.7,dur*.85)*(1-win(t,dur*.9,dur))};}\nfunction drawArms(pen,L,R,blood=false){const c=LOOKS.player;for(const [i,hand]of[L,R].entries()){const sh=[-.5,i?5.2:-5.2,-10],el=ik(sh,hand,8.6,8.6,[-.3,i?1:-1,-1])[0];pen.tube(...sh,...el,1.25,c.cloth).tube(...el,...hand,1,c.skin).ball(...hand,1.05,.9,.8,c.glove);if(blood)pen.ball(...add(hand,[0,0,.75]),.7,.5,.12,'#742c25');}}\nfunction drawViewModel(pen){pen.at();let t=S.actT||0,u=S.actDur?t/S.actDur:0,tool=S.tool,L=[13,-4,-5],R=[10,4,-5];const bob=Math.sin(S.stepPh*TAU)*.25,Sway=Math.sin(S.time*1.6)*.08;\n if(S.vehicle){const s=S.vehicle.v.steer||0;for(let i=0;i<18;i++){const a=i/18*TAU;pen.tube(11,Math.cos(a)*3,-7+Math.sin(a)*3,11,Math.cos(a+.35)*3,-7+Math.sin(a+.35)*3,.18,'#35372c');}L=[11,-2.6,-7+s];R=[11,2.6,-7-s];pen.box(16,0,-11,2,18,3,'#5b5f49');drawArms(pen,L,R);return;}\n if(tool==='map'||tool==='log'||tool==='card'){L=[8,-4,-5.3];R=[8,4,-5.3];drawArms(pen,L,R,S.blood);return;}\n if(tool==='monocular'){pen.tube(3,-1,0,8,-1,0,2,'#444c3b');drawArms(pen,[6,-2,-1],[5,3,-4]);return;}\n if(S.act==='surgery'||S.act==='heal'||S.act==='ampoule'){const cyc=Math.sin(u*Math.PI*6);L=[12,-1,-5];R=[11+cyc,1,-4.5];pen.tube(7,-7,-6,13,-1,-5,1.2,LOOKS.player.skin);if(S.act==='surgery'){pen.tube(11+cyc,1,-4,12,-1,-4,.16,'#b9b9a3');if(S.surgeryKind%2===0)pen.tube(12,0,-4,13,1,-3,.17,'#8b8e80');else pen.cone(12,-1,-4,14,-2,-4,.7,'#c4c4af');}else{pen.tube(...R,...add(R,[3,-2,0]),.35,'#d2d9c0');if(S.act==='ampoule')for(let i=0;i<S.ampoules;i++)pen.tube(7,-3+i*.6,-6,9,-3+i*.6,-6,.18,'#98b7a6');}drawArms(pen,L,R,true);return;}\n if(S.act==='repair'||S.act==='wheel'){L=[13,-3,-3+Math.sin(t*8)];R=[13,3,-3-Math.sin(t*8)];pen.tube(...R,14,0,-3,.3,'#9a9f8a');drawArms(pen,L,R,S.blood);return;}\n if(S.act==='melee'){const sw=Math.sin(u*Math.PI);R=[10+sw*5,4-sw*7,-5+sw*6];pen.slab(...R,...add(R,[7,-1,2]),0,0,1,1.1,.15,'#b9baa2');drawArms(pen,L,R,S.blood);return;}\n let F=frameYP([lerp(8,6,S.adsB)-S.flash*.9,lerp(4.3,0,S.adsB)+bob,lerp(-6,-1.65,S.adsB)+Sway],0,.015+S.flash*.12,0);\n if(S.sprint){F=turn(F,-.3,-.65,-.55);F.o[2]-=1.2;}\n let st={flash:S.flash,cond:S.inventory[S.cur]?.cond??0};if(S.act==='reload'||S.act==='jam'){const a=reloadCurve(S.cur,t,S.actDur);F=turn(F,a.pitch,a.yaw,a.roll);L=at(F,...a.hand);st.mag=a.mag;st.bolt=a.bolt;}else L=at(F,WEAPONS[S.cur]?.fore??5,-.5);R=at(F,-.5,-1.6);\n if(S.act==='throw'){L=keysAt([[0,L],[.15,[6,-6,-3]],[.35,[14,-2,0]],[.7,L]],t);pen.tube(...L,...add(L,[2,0,0]),.6,'#6e7250');if(S.throwKind==='bottle')pen.glow(...add(L,[2,0,1]),.6,'#ff9b38');}\n if(S.tool==='locator'){L=[9,-4.5,-3];pen.box(...L,1.2,3,4.8,'#4c5944');for(let i=0;i<4;i++)pen.glow(8.3,-5.2+i*.4,-1.4,.12,i===(Math.floor(S.time*3)%4)?'#ddbd68':'#76845e');}\n drawGun(pen,F,S.cur,st);drawArms(pen,L,R,S.blood);\n}\nEOF\ncat > src/30-player.js <<'EOF'\nfunction newState(){const inv={};for(const id of ['verger','parson','bishop']){const w=WEAPONS[id];inv[id]={cond:id==='verger'?.43:1,mag:w.mag,reserve:w.reserve,jammed:false};}return {hp:100,alive:true,mode:'campaign',time:0,cur:'verger',inventory:inv,slots:['verger','parson','bishop'],unlocked:['verger','parson'],syrettes:3,ampoules:2,bottles:4,nades:4,stones:8,lung:0,fit:0,lastFit:-999,stamina:1,blood:false,merc:0,buddies:[],papers:'clinic',burnedPapers:[],flags:{},contract:0,step:0,completed:[],hour:18,windDir:.15,wind:.65,storm:0,weatherTimer:0,yaw:-Math.PI/2,pitch:0,eye:EYE,ads:false,adsB:0,sprint:false,crouch:false,move:'stand',stepPh:0,view:'first',fireCd:0,flash:0,act:null,actT:0,actDur:0,tool:null,toolT:0,lastDamage:-99,lastShot:-99,shots:0,kills:0,near:null,focus:{x:0,y:0,z:0},cam:null,waypoint:null,mapZoom:1,pencil:[.5,.5],subtitle:null,objectiveT:8,read:[],rescueCd:0,down:false,vehicle:null,ending:null,endingTime:0,defend:0,attract:false,tags:[],banked:0,carried:0,radio:true};}\nfunction reset(seed=1,merc=0){world.reset();rnd=E.rng(seed);raiders.length=loot.length=nades.length=vehicles.length=people.length=0;placed.clear();for(const s of solids)world.block(s);placeProps();S=newState();S.merc=merc;hero=world.hero({x:OP.strip.x-12*M,y:OP.strip.y-8*M,z:height(OP.strip.x-12*M,OP.strip.y-8*M),r:5,half:9,visible:false,shadow:false,slope:48,step:5,snap:5});pb=body('player');world.camera.set('fixed');world.camera.follow(S.focus);active=world;camStep(0);}\nfunction look(dt,I){if(S.tool==='map'){S.pencil[0]=clamp(S.pencil[0]+I.mouse[0]*.001+(I.stick2?.[0]||0)*dt*.3,0,1);S.pencil[1]=clamp(S.pencil[1]+I.mouse[1]*.001-(I.stick2?.[1]||0)*dt*.3,0,1);return;}const zoom=S.tool==='monocular'?.22:lerp(1,WEAPONS[S.cur]?.adsFov/FOV||.7,S.adsB);S.yaw+=I.mouse[0]*.0021*zoom;S.pitch=clamp(S.pitch-I.mouse[1]*.0021*zoom,-1.45,1.45);const a=I.stick2;if(a){S.yaw+=(a[0]||0)*2.4*zoom*dt;S.pitch=clamp(S.pitch+(a[1]||0)*1.9*zoom*dt,-1.45,1.45);}}\nfunction move(dt,I){const h=hero;if(S.vehicle)return;const m=I.move,cs=Math.cos(S.yaw),sn=Math.sin(S.yaw);S.crouch=I.down('crouch');S.sprint=I.down('sprint')&&\"'!S.crouch&&S.stamina>.02&&m[1]<-.1&&!S.act;S.stamina=clamp(S.stamina+dt*(S.sprint?-1/8:1/12),0,1);const speed=(S.sprint?RUN:S.crouch?CROUCH:S.ads?46:WALK)*(S.tool==='\"'map'?.6:1)*(S.fit>0?.4:1)*(biomeAt(h.x/M,h.y/M)==='brine'?.6:1);h.fly=CHEATS.noclip;if(h.fly){h.vx=(m[0]*-sn-m[1]*cs)*speed*5;h.vy=(m[0]*cs-m[1]*sn)*speed*5;h.vz=(I.down('jump')?1:I.down('crouch')?-1:0)*speed*4;}else{h.vx=approach(h.vx,(-sn*m[0]-cs*m[1])*speed,600*dt);h.vy=approach(h.vy,(cs*m[0]-sn*m[1])*speed,600*dt);if(I.pressed('jump')&&h.grounded){h.jump(JUMP);I.use('jump');A.sfx('jump');}}S.move=S.crouch?'crouch':'stand';h.facing=S.yaw;S.stepPh+=Math.hypot(h.vx,h.vy)*dt/55;}\nfunction camStep(dt){S.eye=approach(S.eye,S.down?5:S.crouch?17:EYE,dt*80);let x=hero.x,y=hero.y,z=hero.z+S.eye;if(S.vehicle){const v=S.vehicle.v;x=v.x;y=v.y;z=v.z+18;}S.adsB=approach(S.adsB,S.ads?1:0,dt*5);S.cam={x,y,z,yaw:S.yaw,pitch:S.pitch+(S.fit?Math.sin(S.time*9)*.035:0),roll:S.down?.12:S.act==='surgery'?Math.sin(S.actT*2)*.05:0,fov:S.tool==='monocular'?14:lerp(FOV,WEAPONS[S.cur]?.adsFov||50,S.adsB),near:1.1};world.camera.fixed=S.cam;world.camera.near=1.1;Object.assign(S.focus,{x:x+Math.cos(S.yaw)*320,y:y+Math.sin(S.yaw)*320,z:z-10});}\nconst I={move:[0,0],mouse:[0,0],stick2:null,pressed:a=>game.input.buffered(a,.12),down:a=>game.input.down(a),use:a=>game.input.consume(a)};\nfunction step(dt,input=I){if(\"'!S||!hero)return;S.time+=dt;look(dt,input);if(S.alive&&!S.down){move(dt,input);}world.step(dt);S.flash=Math.max(0,S.flash-dt*12);camStep(dt);}\nfunction run(n=600){reset(3);const c={move:[0,-1],mouse:[0,0],stick2:null,pressed:()=>false,down:a=>a==='\"'sprint',use(){}};for(let i=0;i<n;i++)step(1/120,c);return world.hash([S.hp,S.shots,Math.round(S.yaw*1000)]);}\nfunction onDraw(w){if(\"'!S)return;drawT=w.time;const cam=S.cam;fx.cam=[cam.x,cam.y,cam.z];drawGrass(w,cam.x,cam.y);grass.uT.value=w.time;grass.uP.value.set(hero.x/M,hero.z/M,hero.y/M);drawTracers(.016);w.overlay.on=S.alive;drawViewModel(w.overlay.pen);}\nEOF\ncat > src/75-screens.js <<'\"'EOF'\nlet titleMenu,mercIndex=0;\nfunction openDev(){game.resume();}\nfunction showAbout(){const ui=new E.Shell(game,{});ui.show('help',{sections:[['Dead Sea Sigh','Everything wears out. An original first-person mercenary game inspired by Far Cry 2.'],['Libraries','my-3D2dge v0.88.0 / MIT. Three.js r182 / MIT. Rapier 0.19.3 / Apache-2.0.']]});setTimeout(()=>{const m=document.querySelector('.esh-mod');if(m)m.scrollTop=0;},30);}\nscenes.title={input:KEYS,enter(){document.exitPointerLock?.();},update(dt){titleMenu.update(dt);world.step(dt);},draw(r){world.draw(r);r.overlay(g=>{veil(g,r,0,.3);E.font.title(g,'DEAD SEA SIGH',22,28,{scale:3,colors:['#efe7c9','#cbb98b','#9e865d'],depth:2});E.font.text(g,'EVERYTHING WEARS OUT.',24,64,'#d1c396');});titleMenu.y=110;titleMenu.draw(r);}};\nscenes.play={input:KEYS,pausable:true,enter(){reset();},update(dt){I.move=game.input.move();world.camera.takeMouse(I.mouse);I.stick2=game.input.padAim;step(dt,I);},draw(r){world.draw(r);}};\nEOF\ncat > src/90-start.js <<'EOF'\nlet built=false;\nBOOT.push(['Mapping Lacustria',()=>{planLand();layout();}],['The dead inland sea',()=>{world=new W3(game,{terrain:{size:SIZE,cell:32,chunk:32,height,color,far:17000,physics:1400,detail:1.2,rock:{colors:['#a8644a','#c47e5a','#8e523c','#d0946a'],band:46,slope:[.34,.52]},speckle:.2,mottle:.3},sky:{top:'#485d77',horizon:'#ebaa6e',ground:'#b49070',sun:'#fff0c8'},fog:{color:'#d7a97c',near:2500,far:19000},ambient:['#c4bdac','#8a6a48',1.5],sun:{color:'#ffdaaa',intensity:2.5,dir:[-.55,.4,-.62],area:1150,map:2048},torchLights:0,glowLights:4,lights:3,overlay:{fov:58},camera:{mode:'fixed',capture:true,near:1.1},res:'balanced',gravity:GRAV,onDraw});structureMesh(world);grassMeshes(world);fxMeshes(world);reset();built=true;}]);\ntitleMenu=new E.Menu(game,['New contract','Settings','About / Credits'],{x:24,y:110,align:'left',room:23,onPick:i=>{if(i===0)game.go('play');else if(i===1)game.menu('settings');else showAbout();}});\ngame.start({scenes,scene:'title',boot:{title:GAME_TITLE,steps:[['The 3D engine',()=>W3.init(game,{render:\"'!NO_RENDER})],...BOOT,['\"'Warming the shaders',()=>world.prepare()]]}});\nwindow.__game={game,scenes,get S(){return S;},get world(){return world;},get hero(){return hero;},TUNE,CHEATS,run,reset,get ready(){return built;}};\ngame.debug={snapshot:()=>({title:GAME_TITLE,hp:S?.hp,at:[hero?.x,hero?.y],time:S?.time}),teleport:(x,y,z)=>{hero.place(x,y,z??height(x,y)+1);camStep(0);}};\nEOF\ncat > test/run.py <<'EOF'\nfrom pathlib import Path\nimport sys\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parent.parent\nGAME=ROOT.parent/(ROOT.name+'.html')\nfail=[];count=0\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required'])\n page=b.new_page();errs=[];page.on('pageerror',lambda e:errs.append(str(e)))\n page.goto(GAME.as_uri()+'?norender=1&backend=webgl');page.wait_for_function('window.__game?.ready',timeout=90000)\n page.evaluate('window.__game.game.stop()')\n def check(name,code):\n  global count\n  count+=1\n  try:\n   result=page.evaluate(code)\n   if result is not True:fail.append(name+': '+str(result))\n  except Exception as e:fail.append(name+': '+str(e)[:350])\n check('boot',\\\"() => document.title==='Dead Sea Sigh' && __game.S.hp===100 && __game.game.settings.music===.1 && __game.game.settings.glyphs==='playstation'\\\")\n check('replay',\\\"() => {const a=__game.run(120);const b=__game.run(120);return a===b||[a,b]}\\\")\n count+=1\n if errs:fail.append('page errors: '+' | '.join(errs))\n b.close()\nfor f in fail:print('FAIL '+f)\nprint(f'{count-len(fail)}/{count} checks passed; {len(fail)} failures')\nsys.exit(bool(fail))\nEOF\ncat > ENGINE-CHANGES.md <<'EOF'\n# Engine patches\nNone yet. Native shooter geometry, procedural skeleton and grass are adapted in game modules.\nEOF\ncat > test/ISSUES.md <<'EOF'\n# Testing issues\nRecord confirmed defects caught by tests below, including severity and fix.\nEOF\nnode build.mjs\npython3 test/run.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/14-environment.js');p.write_text('  /* Structures: '+p.read_text())\n# Use thorn crowns and the new bottle-tree silhouette; no conifers in Lacustria.\np=Path('src/14-environment.js');s=p.read_text().replace(\\\"pine: () => ['pine', { params: { h: 44, tiers: 5 }, mats: { l: '#335c3a foliage size=3', b: '#6a4a30 bark' } }],\\\",\\\"pine: () => ['bottle', { mats: { l: '#8e8a55 foliage size=3', b: '#8e795b bark' } }],\\\")\ns=s.replace(\\\"if (m < 150\\\", \\\"if (biomeAt(m,n)==='salt'||biomeAt(m,n)==='brine') continue;\\\\n      if (m < 150\\\")\ns=s.replace(\\\"const keep = (1 -\\\", \\\"const keep = (FUEL[biomeAt(m,n)]?1:0) * (1 -\\\")\ns=s.replace(\\\"(sage ? .3 : .3 + b * .26) * M\\\", \\\"(biomeAt(m,n)==='reeds'?1.3+b*.85:(sage ? .3 : .3 + b * .26)) * M\\\")\np.write_text(s)\nPY\ncat > src/13-layout.js <<'EOF'\nconst PROPS=[];\nfunction prop(id,P,x,y,z=0,o={}){PROPS.push({id,x:atP(P,x,y)[0],y:atP(P,x,y)[1],z:P.z+z*M,o});}\nfunction tentRow(P,count,x,y){for(let k=0;k<count;k++){const xx=x+(k%6)*7,yy=y+Math.floor(k/6)*8;for(const s of [-1,1])beam(P,[xx,yy,2.4],[xx,yy+s*2,0],5,.08,'#a59b75',K_PLAIN);beam(P,[xx-2.6,yy,2.4],[xx+2.6,yy,2.4],.08,.08,WOOD,K_PLANKS);B(P,xx,yy,0,4.8,3.5,.15,0,'#554934',K_PLANKS,false);}}\nfunction hull(P,x,y,yaw=0,index=0){const q={...P,x:atP(P,x,y)[0],y:atP(P,x,y)[1],yaw,c:Math.cos(yaw),s:Math.sin(yaw)};const C=index%2?'#4f5c50':'#7a3a1e';\n B(q,0,0,.2,22,5.7,.3,0,'#38362b',K_METAL);for(const side of [-1,1]){B(q,0,side*3,.3,22,.18,4.6,0,C,K_METAL);beam(q,[-11,side*3,.3],[-15,0,2],.15,3,C,K_METAL);beam(q,[11,side*3,.3],[14,0,2],.15,3,C,K_METAL);for(let i=-9;i<10;i+=3)B(q,i,side*3.12,.5,.16,.16,4.6,0,'#9a6346',K_PLAIN,false);}\n B(q,-7,0,4.9,6,5.8,.2,0,'#8b805f',K_METAL);shack({...q,z:q.z+4.9*M},-6,0,4.6,4.3,3,{n:[{at:2.3,kind:'window'}],s:[{at:2,kind:'door'}],e:[{at:2,kind:'window'}]},