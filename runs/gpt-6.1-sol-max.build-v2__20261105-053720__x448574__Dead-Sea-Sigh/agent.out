{"type":"item.completed","item":{"id":"item_87","type":"agent_message","text":"All three endings now pass the campaign playthrough. The rendered checks also pass on small phones and tablets in WebKit, with the controller-required notice and Settings working. Firefox’s wide-screen render timed out; I’m investigating that before the final rebuild.\n"}}
{"type":"item.started","item":{"id":"item_88","type":"command_execution","command":"/bin/bash -lc \"cat > test/firefox_diagnose.py <<'EOF'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nimport os,subprocess\nR=Path(__file__).resolve().parent.parent\nwith sync_playwright() as p:\n b=p.firefox.launch(headless=True,env={**os.environ,'LIBGL_ALWAYS_SOFTWARE':'1','MOZ_WEBRENDER':'1'},firefox_user_prefs={'webgl.force-enabled':True,'webgl.disabled':False,'webgl.enable-webgl2':True,'webgl.allow-software':True})\n page=b.new_page(viewport={'width':1280,'height':720});errs=[];page.on('pageerror',lambda e:errs.append(str(e)));page.on('console',lambda m:errs.append(m.type+': '+m.text) if m.type in ['error','warning'] else None)\n page.goto((R.parent/(R.name+'.html')).as_uri()+'?backend=webgl');page.wait_for_timeout(15000)\n print('state',page.evaluate('() => ({title:document.title,ready:window.__game?.ready,body:document.body.innerText,errors:window.__game?.game.errors.map(e=>String(e.error||e.message||e)),gl:\"'!!document.createElement(\"canvas\").getContext(\"webgl2\")})'\"'))\n print('logs',errs[:20]);b.close()\nEOF\npython3 test/firefox_diagnose.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
