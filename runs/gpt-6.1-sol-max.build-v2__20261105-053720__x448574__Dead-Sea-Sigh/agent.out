{"type":"item.completed","item":{"id":"item_88","type":"command_execution","command":"/bin/bash -lc \"cat > test/firefox_diagnose.py <<'EOF'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nimport os,subprocess\nR=Path(__file__).resolve().parent.parent\nwith sync_playwright() as p:\n b=p.firefox.launch(headless=True,env={**os.environ,'LIBGL_ALWAYS_SOFTWARE':'1','MOZ_WEBRENDER':'1'},firefox_user_prefs={'webgl.force-enabled':True,'webgl.disabled':False,'webgl.enable-webgl2':True,'webgl.allow-software':True})\n page=b.new_page(viewport={'width':1280,'height':720});errs=[];page.on('pageerror',lambda e:errs.append(str(e)));page.on('console',lambda m:errs.append(m.type+': '+m.text) if m.type in ['error','warning'] else None)\n page.goto((R.parent/(R.name+'.html')).as_uri()+'?backend=webgl');page.wait_for_timeout(15000)\n print('state',page.evaluate('() => ({title:document.title,ready:window.__game?.ready,body:document.body.innerText,errors:window.__game?.game.errors.map(e=>String(e.error||e.message||e)),gl:\"'!!document.createElement(\"canvas\").getContext(\"webgl2\")})'\"'))\n print('logs',errs[:20]);b.close()\nEOF\npython3 test/firefox_diagnose.py\"","aggregated_output":"state {'title': 'Dead Sea Sigh', 'ready': None, 'body': 'my-3D2dge: script error (the game could not start, or crashed outside update/draw)\\n@file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-053720__x448574/work/Dead%20Sea%20Sigh-Far%20Cry%202-gpt-6.1-sol-max-20261105-053720.html?backend=webgl:15645:18465\\n\\nv0.88.0 · dev-build · Firefox 155 · Linux · 1280x720 @1x · no game yet\\n(click to hide. Full details are in the browser console; My3D2dge.diagnose() gives the report.)', 'errors': None, 'gl': False}\nlogs ['can\\'t access property \"VERTEX\", Gt is undefined']\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/40-weapons.js');s=p.read_text().replace(\\\"for(const tool of ['map','locator','monocular'])\\\", \\\"if(['log','card','watch'].includes(S.tool)&&(I.pressed('fire')||I.pressed('jump')||I.pressed('confirm'))){I.use('fire');I.use('jump');I.use('confirm');if(S.tool==='log')closeCard();else if(S.tool==='card')buyGun();else sleep(S.sleepHour);return;}\\\\n for(const tool of ['map','locator','monocular'])\\\");p.write_text(s)\np=Path('src/30-player.js');s=p.read_text().replace(\\\"S.tool\"'!=='\"'map'&&h.grounded\\\", \\\"\"'!['\"'map','log','card','watch'].includes(S.tool)&&h.grounded\\\").replace(\\\"S.tool\"'!=='\"'map'&&hero.grounded\\\", \\\"\"'!['\"'map','log','card','watch'].includes(S.tool)&&hero.grounded\\\");p.write_text(s)\np=Path('src/50-vehicles.js');s=p.read_text().replace(\\\"for(const q of vehicles){const v=q.v;\\\", \\\"for(const q of vehicles){const v=q.v;q.crashCd=Math.max(0,(q.crashCd||0)-dt);const impact=Math.max(q.prevSpeed||0,Math.abs(v.speed));if(v.bumped&&impact>120&&\"'!q.crashCd){damageVehicle(q,impact*.08);q.crashCd=.7;}q.prevSpeed=Math.abs(v.speed);\")\ns=s.replace(\"if(v.bumped&&Math.abs(v.speed)>120)damageVehicle(q,Math.abs(v.speed)*.08*dt*5);\",'\"'')\np.write_text(s)\np=Path('test/ISSUES.md');p.write_text(p.read_text()+'\\\\n18. Crash review: damage checked the speed after impact, so a wall stopping the vehicle could suppress damage. Use the previous approach speed, with a short impact cooldown. Noncritical vehicle damage defect.\\\\n19. Held-card review: left click fired a gun instead of activating a held shop/log/watch card. Click and Cross now act on the paper; jump is suppressed while using a held card. Noncritical input defect.\\\\n')\np=Path('test/hub_check.py');s=p.read_text().replace(\\\"&play=8000'\\\", \\\"&play={18000 if render else 8000}'\\\")\ns=s.replace(\\\"page.goto(url);page.wait_for_selector\\\", \\\"\\\"\\\"page.goto(url)\n   if render:\n    page.wait_for_selector('iframe',timeout=30000)\n    frames=[f for f in page.frames if 'game.html' in f.url]\n    for f in frames:f.wait_for_function('window.__game?.Net.started && AIHub.time()>=0',timeout=90000)\n    host=next(f for f in frames if f.evaluate('AIHub.isHost'))\n    host.evaluate('''() => {const q=__game;q.CHEATS.god=true;q.CHEATS.freezeAI=true;q.game.audio.mute(true);const c=q.Salvage.cases[0];q.Bot.teleport(c.x,c.y);q.Bot.tick(.03);q.Bot.use();}''')\n    page.wait_for_timeout(800)\n    host.evaluate('''() => {const q=__game,b=q.vehicles.find(v=>v.bank);q.Bot.teleport(b.v.x,b.v.y+16);q.Bot.tick(.03);q.Bot.tick(3.2,{move:[0,0],mouse:[0,0],stick2:null,pressed:()=>false,down:a=>a==='use',use(){}});}''')\n    page.wait_for_timeout(900)\n    banks=[f.evaluate('''() => ({me:AIHub.me,banked:__game.Net.players.get(0)?.banked||0,errors:__game.game.errors.length})''') for f in frames]\n    out.append({'name':'rendered shared pickup and bank replication','pass':len(banks)==2 and all(q['banked']>0 and not q['errors'] for q in banks),'detail':banks})\n   page.wait_for_selector\\\"\\\"\\\")\np.write_text(s)\np=Path('test/checks.js');s=p.read_text().replace(\\\"reset();check('wreck ignites ground'\\\", \\\"\\\"\\\"reset();check('road and mud vehicle speeds differ',()=>{const v=q.vehicles.find(v=>v.clinic),drive={move:[0,-1],mouse:[0,0],stick2:null,pressed:()=>false,down:()=>false,use(){}};const speed=surface=>{v.v.place(1035*16,1130*16,q.OP.salt.z+3);v.v.angle=0;v.v.vx=v.v.vy=0;v.v.o.ground=()=>surface;v.v.surface=surface;q.enterVehicle(v);q.Bot.tick(4,drive);return Math.abs(v.v.speed);};const road=speed('road'),mud=speed('mud');q.exitVehicle();return road>mud*1.3||{road,mud};});\n reset();check('crash damages vehicle',()=>{const v=q.vehicles.find(v=>v.clinic);v.v.place(1035*16,1130*16,q.OP.salt.z+3);v.v.angle=0;q.world.block({x:1060*16,y:1130*16,z:q.OP.salt.z,w:2*16,d:20*16,h:5*16});q.enterVehicle(v);q.Bot.tick(6,{move:[0,-1],mouse:[0,0],stick2:null,pressed:()=>false,down:()=>false,use(){}});return v.hp<v.max||v.hp;});\n reset();check('wreck ignites ground'\\\"\\\"\\\")\np.write_text(s)\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
