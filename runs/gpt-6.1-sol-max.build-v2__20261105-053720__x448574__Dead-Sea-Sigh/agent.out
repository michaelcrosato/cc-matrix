{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/88-bot.js');s=p.read_text().replace('this.oldCheats={...CHEATS};Object.assign(CHEATS', 'this.oldCheats={...CHEATS};this.oldTune={...TUNE};Object.assign(CHEATS').replace('Object.assign(CHEATS,this.oldCheats);game.input', 'Object.assign(CHEATS,this.oldCheats);Object.assign(TUNE,this.oldTune);game.input');p.write_text(s)\np=Path('src/65-contracts.js');s=p.read_text();old=\\\"S.stolenTruck=q;if(q.hp>q.max*.18)q.hp=q.max*.18;\\\";new=\\\"if(S.stolenTruck\"'!==q){S.stolenTruck=q;if(q.hp>q.max*.18)q.hp=q.max*.18;say('\"'Your buddy','The truck is coughing. Repair it, then bring it to Red Steps. Do not open the cargo.');S.stepHint='Repair the stolen truck. Drive it to Red Steps.';}\\\";s=s.replace(old,new).replace(\\\"function targetPoint(st=currentStep()){\\\", \\\"function targetPoint(st=currentStep()){if(st?.kind==='destroy'&&S.stolenTruck&&S.stolenTruck.hp>0)return[OP.red.x,OP.red.y,OP.red.z];\\\").replace(\\\"S.stepTime=0;S.prepared='';S.objectiveT=7;\\\", \\\"S.stepTime=0;S.prepared='';S.stepHint=null;S.objectiveT=7;\\\");p.write_text(s)\np=Path('src/70-hud.js');s=p.read_text().replace(\\\"currentStep()?.text||''\\\", \\\"S.stepHint||currentStep()?.text||''\\\");p.write_text(s)\np=Path('src/72-held.js');s=p.read_text().replace(\\\"currentStep()?.text||'Bank\\\", \\\"S.stepHint||currentStep()?.text||'Bank\\\");p.write_text(s)\np=Path('src/90-start.js');s=p.read_text().replace('TUNE,CHEATS,Dev,Bot,', 'TUNE,CHEATS,Dev,openDev,renderDev,showAbout,openShop,refill,sleep,getNear,Bot,');p.write_text(s)\np=Path('src/55-ai.js');s=p.read_text().replace(\\\"if(e.wounded){e.woundTime-=dt;\\\", \\\"if(e.dragging){const w=e.dragging;if(\"'!w.alive||!w.wounded){e.dragging=null;continue;}const angle=S.windDir+Math.PI/2;a.vx=Math.cos(angle)*22;a.vy=Math.sin(angle)*22;e.yaw=angle;e.state='\"'drag';w.a.place(a.x-Math.cos(angle)*10,a.y-Math.sin(angle)*10,a.z);continue;}if(e.wounded){const helper=raiders.find(q=>q\"'!==e&&q.alive&&!q.wounded&&!q.civilian&&q.faction===e.faction&&!q.dragging&&Math.hypot(q.a.x-a.x,q.a.y-a.y)<15*M);if(helper){if(e.betrayer&&helper.betrayer){e.wounded=false;e.hp=120;e.state='\"'combat';helper.cooldown=2;}else if(Math.hypot(helper.a.x-a.x,helper.a.y-a.y)<5*M){helper.dragging=e;}else{helper.goal=[a.x,a.y];helper.state='hunt';}}e.woundTime-=dt;\\\")\ns=s.replace(\\\"pose(world,b,dt);drawSoldier(pen,b);if(Dev\\\", \\\"pose(world,b,dt);if(e.dragging&&b.J){b.G=null;const hand=[e.dragging.a.x,e.dragging.a.y,e.dragging.a.z+10];b.J.hands[0]=hand;b.J.arms[0]=ik(b.J.S[0],hand,4.9*b.k,4.7*b.k,[0,0,-1]);}drawSoldier(pen,b);if(Dev\\\")\np.write_text(s)\np=Path('test/hub_check.py');s=p.read_text().replace(' return out\\\\nif __name__',\\\" (R/'test'/('hub-render-report.json' if render else 'hub-report.json')).write_text(json.dumps(out,indent=2))\\\\n return out\\\\nif __name__\\\")\np.write_text(s)\np=Path('test/ISSUES.md');p.write_text(p.read_text()+'\\\\n12. Alternate convoy plan: a repaired stolen truck was forced back to 18% health each tick, and its map target stayed at the convoy. Apply the initial damage once and point the objective to Red Steps. Critical alternate-contract progression defect.\\\\n')\nPY\ncat > test/browser_checks.py <<'EOF'\nfrom pathlib import Path\nimport json\nR=Path(__file__).resolve().parent.parent\nURL=(R.parent/(R.name+'.html')).as_uri()\nPAD=\\\"\\\"\\\"(() => { const pad={id:'Stub DualSense (STANDARD GAMEPAD)',index:0,connected:true,mapping:'standard',timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),vibrationActuator:null};window.__pad=pad;navigator.getGamepads=()=>[pad,null,null,null];})();\\\"\\\"\\\"\n\ndef run_browser(p, pictures=True):\n out=[];screens=R/'test/screenshots';screens.mkdir(exist_ok=True)\n def add(name,ok,detail=''):out.append({'name':name,'pass':bool(ok),'detail':str(detail)})\n b=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required','--use-angle=swiftshader','--enable-webgl'])\n page=b.new_page(viewport={'width':1920,'height':1080});errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n try:\n  page.goto(URL+'?backend=webgl');page.wait_for_function('window.__game?.ready',timeout=120000);page.wait_for_timeout(1700)\n  add('rendered Chromium boot',page.title()=='Dead Sea Sigh' and not errors,errors)\n  page.evaluate('__game.game.stop();__game.game.audio.mute(true);__game.game.fadeTime=0')\n  def shot(name):\n   page.evaluate('__game.game.advance(.02,{draw:true})');page.wait_for_timeout(700)\n   if pictures:page.screenshot(path=str(screens/(name+'.png')))\n  shot('title')\n  page.evaluate(\\\"() => {const q=__game;q.game.go('play');q.game.advance(.05);q.S.card=null;q.S.tool=null;q.S.bound=false;q.CHEATS.god=true;q.CHEATS.freezeAI=true;q.CHEATS.noFits=true;q.Bot.teleport(710*16,1450*16);q.S.yaw=-.45;q.S.pitch=.02;}\\\")\n  for name,hour in [('noon',12),('dusk',18.3),('night',22)]:\n   page.evaluate('(h)=>__game.setHour(h)',hour);shot(name)\n  page.evaluate(\\\"() => {const q=__game;q.setHour(18.7);for(let i=0;i<9;i++)q.Fire.ignite((728+i*4)*16,(1430+i%2*4)*16,6,true);q.spawnEnemy(754*16,1425*16,'front');q.game.advance(.1);}\\\");shot('fire-front')\n  page.evaluate(\\\"() => {const q=__game;q.S.tool='map';q.S.toolT=1;q.S.card=null;}\\\");shot('held-map')\n  add('held map is an in-world mesh',page.evaluate(\\\"() => __game.S.tool==='map' && __game.world.overlay.scene.children.some(x=>x.isMesh&&x.visible&&x.geometry?.type==='PlaneGeometry')\\\"))\n  page.evaluate(\\\"() => {const q=__game;q.S.tool=null;q.Bot.tick(14);q.setHour(12);}\\\");shot('ash')\n  page.evaluate(\\\"() => {const q=__game;q.Bot.teleport(1035*16,1150*16);q.S.yaw=0;q.S.pitch=-.03;q.spawnEnemy(q.hero.x+2.3*16,q.hero.y,'authority',{yaw:Math.PI});}\\\");shot('soldier-face')\n  page.evaluate(\\\"() => {const q=__game;q.Bot.teleport(1040*16,1150*16);q.makeVehicle('jeep',q.hero.x+6*16,q.hero.y);q.S.yaw=0;q.S.pitch=-.1;}\\\");shot('jeep')\n  page.evaluate(\\\"() => {const q=__game;q.Bot.teleport(1134*16,1250*16);q.S.yaw=1.25;q.S.pitch=.08;q.setHour(18);}\\\");shot('hulk')\n  page.evaluate(\\\"() => {const q=__game;q.Bot.teleport(1060*16,714*16);q.S.yaw=-Math.PI/2;q.S.pitch=.42;q.setHour(22);}\\\");shot('lamp-night')\n  page.evaluate('__game.openShop();__game.S.toolT=1');shot('sunday-catalogue')\n  page.evaluate('__game.S.tool=null;__game.game.pause()');page.wait_for_timeout(400)\n  add('pause includes Dev and About',page.get_by_role('button',name='Dev mode',exact=True).count()>0 and page.get_by_role('button',name='About / Credits',exact=True).count()>0)\n  if pictures:page.screenshot(path=str(screens/'pause.png'))\n  page.get_by_role('button',name='Dev mode',exact=True).click();page.wait_for_timeout(300)\n  add('live Dev panel opens from pause',page.locator('#devpanel').is_visible())\n  if pictures:page.screenshot(path=str(screens/'dev.png'))\n  live=page.evaluate(\\\"\\\"\\\"() => {const q=__game,old=q.TUNE.fireSpread;const el=document.querySelector('#devpanel input[aria-label=\\\"fireSpread\\\"]');el.value=2.5;el.dispatchEvent(new Event('input'));const ok=q.TUNE.fireSpread===2.5;q.Dev.reset();return ok&&q.TUNE.fireSpread===1;}\\\"\\\"\\\")\n  add('live slider and reset',live)\n  page.evaluate(\\\"__game.Dev.open=false;document.getElementById('devpanel')?.remove();__game.showAbout()\\\");page.wait_for_timeout(200)\n  add('About feedback sections',all(page.get_by_text(x,exact=True).count()>0 for x in ['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback']))\n  add('About opens at top',page.evaluate(\\\"() => (document.querySelector('.esh-mod')?.scrollTop||0)===0\\\"))\n  page.evaluate(\\\"() => {__game.game.shell.hide();const q=__game;q.Bot.teleport(q.OP.sill.x,q.OP.sill.y,q.OP.sill.z+26.5*16);q.S.yaw=Math.PI/2;q.S.pitch=-.25;q.chooseEnding('arithmetic');q.Bot.tick(88);}\\\");shot('flood')\n  add('flood reaches basin and engine has no errors',page.evaluate(\\\"() => __game.S.ending==='arithmetic'&&__game.world.scene.children.some(x=>x.isMesh&&x.geometry?.type==='PlaneGeometry'&&x.position.y>-8)\\\") and not errors,errors)\n finally:b.close()\n # Gamepad and real idle attract clock use the fast rig; preserve a clean storage context.\n b=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required']);ctx=b.new_context();ctx.add_init_script(PAD);page=ctx.new_page()\n try:\n  page.goto(URL+'?norender=1');page.wait_for_function('__game?.ready',timeout=90000);page.evaluate('__game.game.fadeTime=0;__game.game.audio.mute(true)')\n  page.evaluate(\\\"__pad.buttons[7]={pressed:true,touched:true,value:1};__pad.timestamp++\\\");page.wait_for_function(\\\"__game.game.input.lastDevice==='gamepad'\\\",timeout=10000)\n  add('DualSense R2 prompt',page.evaluate(\\\"__game.game.input.label('fire')==='R2'\\\"))\n  page.evaluate(\\\"__game.game.settings.set('glyphs','xbox')\\\");add('Xbox RT prompt',page.evaluate(\\\"__game.game.input.label('fire')==='RT'\\\"))\n  page.evaluate(\\\"__pad.buttons[7]={pressed:false,touched:false,value:0};__pad.timestamp++\\\");page.keyboard.press('KeyN');page.wait_for_timeout(150)\n  add('keyboard prompt follows input',page.evaluate(\\\"__game.game.input.lastDevice==='keyboard' && __game.game.input.label('fire')==='Left click'\\\"))\n  page.evaluate(\\\"__game.game.settings.set('glyphs','playstation');__game.game.go('title')\\\")\n  page.wait_for_function('__game.Attract.active',timeout=18000)\n  add('attract starts after real idle',page.evaluate('__game.Attract.active'))\n  page.evaluate(\\\"() => {for(let i=0;i<8;i++){__game.Attract.next();__game.Attract.update(.01);}}\\\")\n  add('eight attract vignettes',page.evaluate('__game.Attract.seen.size===8'))\n  page.keyboard.press('KeyX');page.wait_for_function('\"'!__game.Attract.active'\"',timeout=5000);add('key exits attract',True)\n  page.evaluate('__game.Attract.start()');page.wait_for_timeout(100);page.mouse.move(50,50);page.wait_for_function('\"'!__game.Attract.active'\"',timeout=5000);add('mouse exits attract',True)\n  page.evaluate('__game.Attract.start()');page.wait_for_timeout(100);page.evaluate('__pad.axes[0]=.8;__pad.timestamp++');page.wait_for_function('\"'!__game.Attract.active'\"',timeout=5000);add('stick exits attract',True)\n  page.evaluate('__pad.axes[0]=0;__pad.timestamp++')\n finally:b.close()\n # Sequential viewport checks also inspect Safari's engine with the actual renderer.\n viewports=[('small-phone','webkit',{'width':375,'height':667},True),('phone','chromium',{'width':390,'height':844},True),('foldable','chromium',{'width':344,'height':882},True),('tablet','webkit',{'width':1024,'height':768},True),('wide','firefox',{'width':2560,'height':1080},False)]\n for name,engine,size,mobile in viewports:\n  browser=getattr(p,engine).launch(headless=True,**({'args':['--use-angle=swiftshader','--enable-webgl']} if engine=='chromium' else {}));ctx=browser.new_context(viewport=size,has_touch=mobile,**({'is_mobile':True} if mobile and engine\"'!='\"'firefox' else {}));page=ctx.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n  try:\n   page.goto(URL+'?backend=webgl');page.wait_for_function('window.__game?.ready',timeout=120000);page.wait_for_timeout(1500)\n   add(name+' '+engine+' rendered viewport',page.title()=='Dead Sea Sigh' and not errors,errors)\n   add(name+' no horizontal overflow',page.evaluate('document.documentElement.scrollWidth<=innerWidth'))\n   if mobile:\n    notice=page.get_by_text('Controller or keyboard required',exact=False)\n    add(name+' controller-only notice',notice.count()>0 and notice.first.is_visible())\n    settings=page.get_by_role('button',name='Settings',exact=True)\n    if settings.count():settings.last.click();page.wait_for_timeout(100);add(name+' touch settings usable',page.get_by_text('Sound',exact=True).count()>0 or page.get_by_role('button',name='Sound',exact=True).count()>0)\n   if pictures:page.screenshot(path=str(screens/(name+'-'+engine+'.png')))\n  except Exception as e:add(name+' '+engine+' viewport',False,str(e)[:500])\n  finally:browser.close()\n (R/'test/browser-report.json').write_text(json.dumps(out,indent=2));return out\nEOF\ncat > test/run.py <<'EOF'\nfrom pathlib import Path\nimport sys,json,argparse,time\nfrom playwright.sync_api import sync_playwright\nfrom browser_checks import run_browser\nfrom hub_check import run_hub\nR=Path(__file__).resolve().parent.parent\nURL=(R.parent/(R.name+'.html')).as_uri()\nparser=argparse.ArgumentParser();parser.add_argument('--suite',choices=['all','core','story','browser','hub','gpu'],default='all');opts=parser.parse_args()\nresults=[]\ndef add(name,ok,detail=''):results.append({'name':name,'pass':bool(ok),'detail':str(detail)})\nwith sync_playwright() as p:\n if opts.suite in ['all','core','story']:\n  b=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required'])\n  if opts.suite in ['all','core']:\n   page=b.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n   page.goto(URL+'?norender=1&backend=webgl');page.wait_for_function('window.__game?.ready',timeout=90000);page.evaluate('__game.game.stop();__game.game.audio.mute(true)')\n   add('boot and defaults',page.evaluate(\\\"document.title==='Dead Sea Sigh'&&__game.S.hp===100&&__game.game.settings.music===.1&&__game.game.settings.glyphs==='playstation'\\\"))\n   add('deterministic replay',page.evaluate('() => __game.run(120)===__game.run(120)'))\n   results.extend(page.evaluate((R/'test/checks.js').read_text()));add('core no page errors',not errors,errors)\n   # Offline Web Audio proves generated voice and percussion are non-silent and finite.\n   audio=page.evaluate(\\\"\\\"\\\"async () => {const c=new OfflineAudioContext(1,22050,22050),g=c.createGain();g.connect(c.destination);__game.voiceSound(c,g,'a',2,'Ilse Tarn');const osc=c.createOscillator(),env=c.createGain();osc.type='sawtooth';osc.frequency.setValueAtTime(130,.12);osc.frequency.exponentialRampToValueAtTime(35,.3);env.gain.setValueAtTime(.5,.12);env.gain.exponentialRampToValueAtTime(.001,.3);osc.connect(env).connect(c.destination);osc.start(.12);osc.stop(.31);const b=await c.startRendering(),d=b.getChannelData(0);let energy=0;for(const v of d){if(\"'!Number.isFinite(v))return false;energy+=v*v;}return energy>1;}\"\"\")\n   add('\"'offline generated voice and gunshot',audio);add('music bus defaults below effects',page.evaluate('__game.game.audio.musicVolume<__game.game.audio.sfxVolume&&__game.game.audio.musicVolume===.1'))\n   page.close()\n  if opts.suite in ['all','story']:\n   for ending in ['contract','arithmetic','sounding']:\n    page=b.new_page();page.goto(URL+'?norender=1&backend=webgl');page.wait_for_function('window.__game?.ready',timeout=90000);page.evaluate('__game.game.stop();__game.game.audio.mute(true);__game.game.fadeTime=0')\n    try:\n     report=page.evaluate('(ending)=>__game.Bot.playthrough(ending)',ending);add('complete campaign / '+ending,report['pass'],report)\n    except Exception as e:add('complete campaign / '+ending,False,str(e)[:800])\n    page.close()\n  b.close()\n if opts.suite in ['all','browser']:\n  try:results.extend(run_browser(p))\n  except Exception as e:add('browser suite',False,str(e)[:1200])\n if opts.suite in ['all','hub']:\n  try:results.extend(run_hub(p));results.extend(run_hub(p,render=True,scenarios=[(2,'standard')]))\n  except Exception as e:add('hub suite',False,str(e)[:1200])\n if opts.suite in ['all','gpu']:\n  try:\n   from gpu_check import run_gpu\n   results.extend(run_gpu(p))\n  except Exception as e:add('WebGPU suite',False,str(e)[:1200])\n(R/'test/report.json').write_text(json.dumps(results,indent=2))\nfor r in results:\n if not r['pass']:print('FAIL '+r['name']+': '+str(r.get('detail',''))[:1500])\nfail=sum(not r['pass'] for r in results);print(f'{len(results)-fail}/{len(results)} checks passed; {fail} failures')\nsys.exit(bool(fail))\nEOF\nnode build.mjs\npython3 test/run.py --suite story\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/85-net.js');s=p.read_text().replace('snapshots:new Map(),ready:', 'snapshots:new Map(),vehicleSnapshots:new Map(),lastVehicles:0,ready:')\ns=s.replace(\\\"a:S.vehicle?.id||null}\\\", \\\"a:S.vehicle?.id||null,v:S.vehicle?[Math.round(S.vehicle.v.x),Math.round(S.vehicle.v.y),Math.round(S.vehicle.v.z),Math.round(S.vehicle.v.angle*1000),Math.round(S.vehicle.v.speed),Math.round(S.vehicle.hp)]:null}\\\")\ns=s.replace(\\\"if(now-Net.lastEvents>=300)\\\",\\\"if(isHost&&now-Net.lastVehicles>=350){Net.lastVehicles=now;AIHub.send({t:'v',V:vehicles.map((q,i)=>[i,Math.round(q.v.x),Math.round(q.v.y),Math.round(q.v.z),Math.round(q.v.angle*1000),Math.round(q.v.speed),Math.round(q.hp),q.owner??-1])},{reliable:false});}\\\\n if(now-Net.lastEvents>=300)\\\")\ns=s.replace(\\\"p.hp=Math.min(p.hp,data.hp);if(p.actor)\\\", \\\"p.hp=Math.min(p.hp,data.hp);for(const q of vehicles)if(q.owner===from&&q.id\"'!==data.a)q.owner=null;p.vehicle=data.a;if(data.a&&data.v){const q=vehicles.find(q=>q.id===data.a);if(q&&(q.owner===undefined||q.owner===null||q.owner===from)){q.owner=from;q.v.place(data.v[0],data.v[1],data.v[2]);q.v.angle=data.v[3]/1000;q.v.speed=data.v[4];q.hp=Math.min(q.hp,data.v[5]);q.v.vx=q.v.vy=0;}}if(p.actor)\")\ns=s.replace(\"if(data.t==='\"'s'){for\\\", \\\"if(data.t==='v'){for(const [i,x,y,z,a,speed,hp,owner]of data.V){const q=vehicles[i];if(\"'!q)continue;q.hp=hp;q.owner=owner<0?null:owner;if(S.vehicle!==q)Net.vehicleSnapshots.set(i,{x,y,z,a:a/1000,speed});}}else if(data.t==='\"'s'){for\\\")\ns=s.replace(\\\"function interpolatePlayers(dt){\\\", \\\"function interpolatePlayers(dt){for(const [i,s]of Net.vehicleSnapshots){const q=vehicles[i];if(\"'!q||S.vehicle===q)continue;const k=Math.min(1,dt*10);q.v.place(lerp(q.v.x,s.x,k),lerp(q.v.y,s.y,k),lerp(q.v.z,s.z,k));q.v.angle=E.approachAng(q.v.angle,s.a,dt*8);q.v.speed=s.speed;}\