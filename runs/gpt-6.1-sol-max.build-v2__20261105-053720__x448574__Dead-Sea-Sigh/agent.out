{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/55-ai.js');s=p.read_text().replace('r:4.5,half:8.5','r:5,half:9.5');p.write_text(s)\np=Path('src/88-bot.js');s=p.read_text().replace('for(let k=0;k<12&&e.alive;k++){this.aim(e.a.x,e.a.y,e.a.z+26);','for(let k=0;k<20&&e.alive;k++){if(S.inventory[S.cur].jammed){this.press(\\\\'reload\\\\');this.tick(1.4);}this.aim(e.a.x,e.a.y,e.a.z+24);');p.write_text(s)\np=Path('src/13-layout.js');s=p.read_text().replace('ladder(q,-4,8,0,26,-Math.PI/2);','B(q,-9,10,26,4,10,.3,0,CON2,K_CONCRETE);ladder(q,-4,8,0,26,-Math.PI/2);');p.write_text(s)\np=Path('src/30-player.js');s=p.read_text().replace(\\\"const m=I.move,cs=Math.cos(S.yaw)\\\",\\\"if(traversal(dt,I))return;const m=I.move,cs=Math.cos(S.yaw)\\\")\ns=s.replace('function camStep(dt){', '''function traversal(dt,I){\n if(S.mantle){const m=S.mantle;m.t+=dt;hero.fly=true;const u=sstep(0,.55,m.t);hero.place(lerp(m.from[0],m.to[0],u),lerp(m.from[1],m.to[1],u),lerp(m.from[2],m.to[2],sstep(0,.4,m.t))+Math.sin(u*Math.PI)*4);hero.vx=hero.vy=hero.vz=0;if(m.t>.55){S.mantle=null;hero.fly=false;}return true;}\n if(S.ladder){const l=S.ladder;hero.fly=true;const fx=Math.cos(l.yaw),fy=Math.sin(l.yaw);hero.vx=(l.x-fx*8-hero.x)*10;hero.vy=(l.y-fy*8-hero.y)*10;hero.vz=-I.move[1]*76;S.move='ladder';if(hero.z>l.z1-3&&I.move[1]<0){hero.place(...l.top);S.ladder=null;hero.fly=false;hero.vz=0;}else if(I.pressed('jump')||hero.z<l.z0-2){S.ladder=null;hero.fly=false;hero.vx=-fx*70;hero.vy=-fy*70;hero.vz=60;I.use('jump');}return true;}\n if(I.move[1]<-.25&&\"'!CHEATS.noclip){for(const l of ladders)if(Math.hypot(hero.x-l.x,hero.y-l.y)<20&&hero.z>=l.z0-3&&hero.z<l.z1-3&&Math.cos(S.yaw-l.yaw)>.1){S.ladder=l;return true;}}\n if(I.pressed('\"'jump')&&hero.grounded&&\"'!CHEATS.noclip){const fx=Math.cos(S.yaw),fy=Math.sin(S.yaw);let hit=null;for(const h of [8,18]){hit=world.ray(hero.x,hero.y,hero.z+h,fx,fy,0,16,{skip:hero,level:true});if(hit)break;}if(hit){const x=hit.x+fx*12,y=hit.y+fy*12,top=world.ray(x,y,hero.z+43,0,0,-1,45,{skip:hero,level:true});if(top&&top.nz>.7&&top.z>hero.z+5&&top.z<hero.z+41&&!world.ray(x,y,top.z+1,0,0,1,29,{skip:hero,level:true})){S.mantle={from:[hero.x,hero.y,hero.z],to:[x,y,top.z+1],t:0};I.use('\"'jump');A.sfx('jump');return true;}}}return false;}\nfunction camStep(dt){''')\np.write_text(s)\np=Path('src/25-guns.js');s=p.read_text().replace(\\\"if(S.vehicle){\\\", \\\"if(S.mantle||S.ladder){const phase=Math.sin(S.time*8);drawArms(pen,[12,-4,2+phase],[12,4,2-phase],S.blood);return;}\\\\n if(S.vehicle){\\\");p.write_text(s)\np=Path('test/ISSUES.md');s=p.read_text()+'\\\\n1. Gameplay: soldier head art exceeded collision capsule; raised soldier capsule to match the visible head so aimed headshots connect. Noncritical.\\\\n2. Traversal review: dam stair ended outside the top walkway; added a connected landing and native ladder/mantle traversal. Critical progression defect fixed before final testing.\\\\n';p.write_text(s)\nPY\nnode build.mjs\npython3 test/integration.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
