{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\ns=Path('engine/three-0.182.0/three.webgpu.min.js').read_text()\nfor name in ['GPUShaderStage','GPUBufferUsage','GPUTextureUsage','GPUMapMode','GPUColorWrite']:\n print(name, sorted(set(re.findall(r'\\\\b'+name+r'\\\\.\\\\w+',s))))\nPY\ncat > test/firefox_xvfb.py <<'EOF'\nfrom pathlib import Path\nimport os,subprocess\nfrom playwright.sync_api import sync_playwright\nR=Path(__file__).resolve().parent.parent\nproc=subprocess.Popen(['Xvfb','-displayfd','1','-screen','0','2560x1440x24','-nolisten','tcp'],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)\ndisplay=':'+proc.stdout.readline().strip()\ntry:\n with sync_playwright() as p:\n  b=p.firefox.launch(headless=False,env={**os.environ,'DISPLAY':display,'LIBGL_ALWAYS_SOFTWARE':'1'},firefox_user_prefs={'webgl.force-enabled':True,'webgl.disabled':False,'webgl.enable-webgl2':True,'webgl.allow-software':True})\n  page=b.new_page(viewport={'width':2560,'height':1080});page.add_init_script('window.GPUShaderStage={VERTEX:1,FRAGMENT:2,COMPUTE:4};window.GPUBufferUsage={MAP_READ:1,MAP_WRITE:2,COPY_SRC:4,COPY_DST:8,INDEX:16,VERTEX:32,UNIFORM:64,STORAGE:128,INDIRECT:256,QUERY_RESOLVE:512};window.GPUTextureUsage={COPY_SRC:1,COPY_DST:2,TEXTURE_BINDING:4,STORAGE_BINDING:8,RENDER_ATTACHMENT:16};window.GPUMapMode={READ:1,WRITE:2};window.GPUColorWrite={RED:1,GREEN:2,BLUE:4,ALPHA:8,ALL:15};')\n  errors=[];page.on('pageerror',lambda e:errors.append(str(e)));page.goto((R.parent/(R.name+'.html')).as_uri()+'?backend=webgl');page.wait_for_timeout(15000)\n  print(page.evaluate('() => ({ready:window.__game?.ready,gl:\"'!!document.createElement(\"canvas\").getContext(\"webgl2\"),body:document.body.innerText,errors:window.__game?.game.errors.map(e=>String(e.error||e.message||e))})'\"'));print(errors)\n  page.screenshot(path=str(R/'test/screenshots/firefox-diag.png'));b.close()\nfinally:proc.terminate();proc.wait(timeout=10)\nEOF\npython3 test/firefox_xvfb.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
