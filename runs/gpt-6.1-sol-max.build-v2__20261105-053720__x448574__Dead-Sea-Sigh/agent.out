{const p=Net.players.get(id);if(!p)continue;p.carried=carried;p.banked=banked;p.hp=hp;if(id===AIHub.me){S.carried=carried;S.banked=banked;continue;}Net.snapshots.set(id,{x,y,z,yaw:yw/1000,at:data.at});}const present=new Set(data.E.map(e=>e[0]));for(const e of raiders)if(e.netID&&!present.has(e.netID)){e.alive=false;e.a.setSolid(false);if(!e.b.dead)e.b.dead={t:1,dir:0,g:e.a.z};}for(const [id,x,y,z,yw,hp,combat]of data.E){let e=raiders.find(e=>e.netID===id);if(!e){e=spawnEnemy(x,y,'front',{netID:id});}e.a.place(x,y,z);e.yaw=yw/1000;e.hp=hp;e.state=combat?'combat':'idle';}}else if(data.t==='e'){for(const k of data.lit||[])if(!Fire.state[k]){Fire.state[k]=1;Fire.t[k]=9;burnData[k]=170;Fire.burning.push(k);}for(const e of data.L||[]){if(e.t==='case'){const c=Salvage.cases.find(c=>c.id===e.id);if(c)c.taken=e.taken;}if(e.t==='drop')Salvage.cases.push(e.c);if(e.t==='damage'&&e.id===AIHub.me){S.hp=e.hp;if(e.hp<=0)salvageDeath();}if(e.t==='bank'){const p=Net.players.get(e.id);if(p){p.banked=e.banked;p.carried=0;}}}Fire.tex.needsUpdate=true;}}}\n","exit_code":0,"status":"completed"}}
