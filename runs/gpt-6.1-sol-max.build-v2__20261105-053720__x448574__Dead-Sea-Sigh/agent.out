)if(e.alive&&Math.hypot(e.a.x-hero.x,e.a.y-hero.y)<3*M&&Math.cos(Math.atan2(e.a.y-hero.y,e.a.x-hero.x)-S.yaw)>.4){hurtEnemy(e,60,false);break;}const d=doors.find(d=>Math.hypot(d.x-hero.x,d.y-hero.y)<3*M);if(d)d.open=true;});A.sfx('swing');return true;}\\\\n\\\"\np.write_text(s)\np=Path('src/65-contracts.js');s=p.read_text().replace(\\\"for(const id of S.unlocked)giveGun(id,1);refill();\\\", \\\"for(const id of S.slots.filter(Boolean)){if(S.unlocked.includes(id))S.inventory[id].cond=1;}refill();\\\").replace(\\\"\"'!['\"'rifle','shotgun','verger'].includes(k)\\\",\\\"\"'!['\"'rifle','shotgun','verger','machete'].includes(k)\\\")\np.write_text(s)\np=Path('src/75-screens.js');s=p.read_text().replace(\\\"\"'!['\"'rifle','shotgun'].includes(k)\\\", \\\"\"'!['\"'rifle','shotgun','machete'].includes(k)\\\");p.write_text(s)\np=Path('src/70-hud.js');s=p.read_text().replace(\\\"gun?.jammed?'JAMMED':(gun?.mag||0)+' / '+(gun?.reserve||0)\\\", \\\"S.cur==='machete'?'':gun?.jammed?'JAMMED':(gun?.mag||0)+' / '+(gun?.reserve||0)\\\");p.write_text(s)\nPY\nnode build.mjs\npython3 test/run.py --suite hub\"","aggregated_output":"FAIL hub suite: Frame.wait_for_function: Timeout 90000ms exceeded.\n5/6 checks passed; 1 failures\n","exit_code":1,"status":"failed"}}
{"type":"item.completed","item":{"id":"item_97","type":"agent_message","text":"Firefox hit a Three.js import issue on browsers without WebGPU; the build now supplies the missing flag constants for the WebGL fallback. This machine still gives headless Firefox no WebGL context, so I’m checking its simulation separately and using Chromium for the wide-screen render. The map is now fully readable, and the finale faces the basin so the flood stays visible.\n"}}
