6,{skip:hero,level:true});if(hit)break;}if(hit){const x=hit.x+fx*12,y=hit.y+fy*12,top=world.ray(x,y,hero.z+43,0,0,-1,45,{skip:hero,level:true});if(top&&top.nz>.7&&top.z>hero.z+5&&top.z<hero.z+41&&!world.ray(x,y,top.z+1,0,0,1,29,{skip:hero,level:true})){S.mantle={from:[hero.x,hero.y,hero.z],to:[x,y,top.z+1],t:0};I.use('\"'jump');A.sfx('jump');return true;}}}return false;}\nfunction camStep(dt){''')\np.write_text(s)\np=Path('src/25-guns.js');s=p.read_text().replace(\\\"if(S.vehicle){\\\", \\\"if(S.mantle||S.ladder){const phase=Math.sin(S.time*8);drawArms(pen,[12,-4,2+phase],[12,4,2-phase],S.blood);return;}\\\\n if(S.vehicle){\\\");p.write_text(s)\np=Path('test/ISSUES.md');s=p.read_text()+'\\\\n1. Gameplay: soldier head art exceeded collision capsule; raised soldier capsule to match the visible head so aimed headshots connect. Noncritical.\\\\n2. Traversal review: dam stair ended outside the top walkway; added a connected landing and native ladder/mantle traversal. Critical progression defect fixed before final testing.\\\\n';p.write_text(s)\nPY\nnode build.mjs\npython3 test/integration.py\"","aggregated_output":"{'pass': False, 'problems': ['Did not advance C2:1 (destroy)'], 'completed': ['P0', 'P1', 'C1'], 'ending': None}\nstate {'c': 3, 's': 1, 'card': None, 'alive': True, 'act': None, 'near': None}\nerrors []\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"cat src/90-start.js && cat > test/checks.js <<'EOF'\n() => {\n const q=window.__game,results=[];\n const check=(name,fn)=>{try{const v=fn();results.push({name,pass:v===true,detail:v===true?'':JSON.stringify(v)});}catch(e){results.push({name,pass:false,detail:e.stack});}};\n const reset=()=>{q.reset(3);Object.assign(q.CHEATS,{god:true,ammo:false,noJams:false,noFits:true,freezeAI:true,noclip:false});Object.assign(q.TUNE,{fireSpread:1,wind:.65,wear:1,jam:1,enemyAccuracy:1,enemyDamage:1,enemySight:1,playerDamage:1,lung:1,rescueChance:.8,postRespawn:.4,carTop:1,dayLength:90});};\n reset();\n check('weapon condition and ammo',()=>{const s=q.S,g=s.inventory.verger,c=g.cond;q.gunShot();return g.cond<c&&g.mag===5;});\n check('jam and clear',()=>{const g=q.S.inventory.verger;g.cond=.2;q.TUNE.wear=0;q.TUNE.jam=5;for(let i=0;i<100&&\"'!g.jammed;i++){q.S.fireCd=0;g.mag=6;q.gunShot();}if(!g.jammed)return '\"'jam never happened';q.S.fireCd=0;q.startReload();q.Bot.tick(1.4);return \"'!g.jammed;});\n reset();check('\"'broken gun leaves slot',()=>{q.TUNE.jam=0;q.S.inventory.verger.cond=.00001;q.gunShot();return q.S.slots[0]===null&&\"'!q.S.inventory.verger;});\n reset();check('\"'segmented health',()=>{q.S.hp=46;q.S.lastDamage=-10;q.Bot.tick(8);return q.S.hp===60;});\n reset();check('syrette and field surgery',()=>{q.S.hp=50;q.heal();q.Bot.tick(1);if(q.S.hp\"'!==90)return ['\"'syrette',q.S.hp];q.S.hp=12;q.S.lastDamage=q.S.time;q.heal();const kind=q.S.surgeryKind;q.Bot.tick(5.2);return q.S.hp===60&&q.S.blood&&Number.isInteger(kind);});\n reset();check('fit and ampoule',()=>{q.CHEATS.noFits=false;q.S.lung=100;q.fitStart();if(\"'!q.S.fit)return '\"'no fit';const before=q.S.ampoules;const ok=q.useAmpoule();return ok&&q.S.ampoules===before-1&&q.S.lung===0&&q.S.fit===0;});\n reset();check('second untreated fit is fatal',()=>{q.CHEATS.noFits=false;q.CHEATS.god=false;q.S.ampoules=0;q.fitStart();q.Bot.tick(14.1);q.fitStart();return \"'!q.S.alive;});\n reset();check('\"'firebreaks and ash',()=>{let grass=null,salt=null,road=null;for(let y=400;y<1800;y+=17)for(let x=300;x<1700;x+=17){const b=q.biomeAt(x,y);if(b==='grass'&&\"'!grass)grass=[x*16,y*16];if(b==='\"'salt'&&\"'!salt)salt=[x*16,y*16];if(b==='\"'road'&&\"'!road)road=[x*16,y*16];}if(!grass||!salt||!road)return '\"'missing biome';const a=q.Fire.ignite(...grass,2),b=q.Fire.ignite(...salt,0),c=q.Fire.ignite(...road,0);q.Bot.tick(12);const idx=Math.floor(grass[1]/64)*512+Math.floor(grass[0]/64);q.Fire.state[idx]=2;const d=q.Fire.ignite((idx%512+.5)*64,(Math.floor(idx/512)+.5)*64,0);return a>0&&b===0&&c===0&&d===0;});\n reset();check('wind-driven spread and burn mask save',()=>{let p=null;for(let y=1650;y<1750&&\"'!p;y+=5)for(let x=500;x<700&&!p;x+=5)if(q.biomeAt(x,y)==='\"'grass')p=[x*16,y*16];q.S.windDir=0;q.S.wind=1;q.TUNE.wind=1;q.TUNE.fireSpread=3;q.Fire.ignite(...p,5);q.Bot.tick(35);let dx=0,n=0;for(let i=0;i<q.Fire.state.length;i++)if(q.Fire.state[i]){dx+=(i%512+.5)*64-p[0];n++;}const data=q.saveData();q.loadData(data);let n2=0;for(const v of q.Fire.state)if(v)n2++;return n>8&&dx>0&&n2===n||{n,dx,n2};});\n reset();check('burning actor takes damage',()=>{q.CHEATS.god=false;q.Fire.ignite(q.hero.x,q.hero.y,5,true);const hp=q.S.hp;q.Bot.tick(.2);return q.S.hp<hp;});\n reset();check('papers recognise clinic and burn on gunfire',()=>{q.S.papers='clinic';if(\"'!q.hasPapers('\"'front')||\"'!q.hasPapers('\"'authority'))return 'clinic pass';q.Bot.teleport(1535*16,1620*16);q.gunShot();return \"'!q.hasPapers('\"'front');});\n reset();check('vehicle enter drive exit repair',()=>{const v=q.vehicles.find(v=>v.clinic);v.v.place(1035*16,1130*16,q.world.ground(1035*16,1130*16)+3);v.v.angle=0;q.enterVehicle(v);const start=v.v.x;const input={move:[0,-1],mouse:[0,0],stick2:null,pressed:()=>false,down:()=>false,use(){}};q.Bot.tick(4,input);const moved=v.v.x-start;q.exitVehicle();v.hp=10;q.repairVehicle(v);q.Bot.tick(4.1);return moved>150&&\"'!q.S.vehicle&&v.hp===v.max*.6||{moved,hp:v.hp,vehicle:!!q.S.vehicle};});\n reset();check('\"'wreck ignites ground',()=>{const v=q.vehicles[0];q.damageVehicle(v,999);q.Bot.tick(3.2);return v.wreck&&q.Fire.burning.length>0;});\n reset();check('buddy rescue and cooldown',()=>{q.CHEATS.god=false;q.TUNE.rescueChance=1;q.S.buddies[0].met=true;q.hurtPlayer(1000);if(\"'!q.S.down)return '\"'no rescue';q.Bot.tick(10.2);if(q.S.hp<60||q.S.down)return 'rescue did not finish';return q.S.rescueCd>0&&\"'!q.buddyRescue();});\n reset();check('\"'save buddy with medicine; mercy persists',()=>{const b=q.S.buddies[0];b.met=true;q.downBuddy(b);const meds=q.S.syrettes;q.saveBuddy(b);if(b.down||q.S.syrettes\"'!==meds-1)return '\"'medicine';q.downBuddy(b);q.saveBuddy(b,true);const d=q.saveData();q.loadData(d);return q.S.buddies[0].dead;});\n reset();check('data tables and all map sites',()=>Object.keys(q.OP).length===14&&q.STAKES.length===8&&q.CASES.length===12);\n reset();\n return results;\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('test/run.py');s=p.read_text();s=s.replace(\\\"count+=1\\\\n if errs\\\", \\\"for item in page.evaluate((ROOT/'test/checks.js').read_text()):\\\\n  count+=1\\\\n  if not item['pass']:fail.append(item['name']+': '+item['detail'][:500])\\\\n count+=1\\\\n if errs\\\");p.write_text(s)\nPY\npython3 test/run.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
