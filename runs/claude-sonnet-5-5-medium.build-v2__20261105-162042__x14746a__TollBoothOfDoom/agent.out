am: Deeps', gen: { rooms: 10 }, level: 8, mon: ['rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'peatwalker'], elites: ['pallid_bearer', 'choir_skull'], nests: true, look: 'ossuary', song: 'under_gloam', tex: 'flagstones', wall: 'ashlar', fog: 'green', next: 'counting', ambient: 'fire', traps: true },\n  counting: { name: \"The Bursar's Counting House\", authored: 'BURSAR_ARENA', level: 9, mon: [], look: 'ossuary', song: 'the_ledger', tex: 'marble', wall: 'ashlar', boss: 'bursar', ambient: 'fire' },\n  cloister: { name: 'The Cinder Cloister', gen: { rooms: 12, outdoor: true }, level: 11, mon: ['cinderling', 'tithe_collector', 'penitent', 'clapperjaw', 'ash_gargoyle', 'shade_acolyte', 'pallid_bearer'], elites: ['penitent', 'clapperjaw', 'cinderling'], nests: true, look: 'cloister', song: 'cinders', tex: 'slate-tiles', wall: 'ruined-wall', fog: 'ember', ambient: 'fire', defend: true, lychgates: 1 },\n  chapter: { name: 'The Chapter House', authored: 'AMBROSE_ARENA', level: 13, mon: [], look: 'cloister', song: 'the_ledger', tex: 'slate-tiles', wall: 'ruined-wall', boss: 'ambrose', ambient: 'fire' },\n  belfry1: { name: 'The Cracked Belfry: Stair', gen: { rooms: 6 }, level: 15, mon: ['rattlebones', 'cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle'], elites: ['penitent', 'clapperjaw'], look: 'belfry', song: 'the_climb', tex: 'basalt', wall: 'ashlar', fog: 'void', next: 'belfry2', ambient: 'wind' },\n  belfry2: { name: 'The Cracked Belfry: Gallery', gen: { rooms: 6 }, level: 15, mon: ['rattlebones', 'cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle'], elites: ['penitent', 'ash_gargoyle'], look: 'belfry', song: 'the_climb', tex: 'rune-floor', wall: 'ashlar', fog: 'void', next: 'belfry3', ambient: 'wind' },\n  belfry3: { name: 'The Cracked Belfry: Ringers Loft', gen: { rooms: 5 }, level: 16, mon: ['rattlebones', 'cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle'], elites: ['clapperjaw', 'penitent'], look: 'belfry', song: 'the_climb', tex: 'basalt', wall: 'ashlar', fog: 'void', next: 'summit', ambient: 'wind' },\n  summit: { name: 'The Bell Chamber', authored: 'BELFRY_ARENA', level: 17, mon: [], look: 'belfry', song: 'eventide', tex: 'rune-floor', wall: 'ashlar', boss: 'malison', ambient: 'wind' },\n  knell: { name: 'The Knell', gen: { rooms: 14, mixed: true }, level: 1, mon: [], look: 'ossuary', song: 'the_knell', tex: 'flagstones', wall: 'ashlar', fog: 'green', ambient: 'fire', knell: true },\n  knell_arena: { name: 'The Wardens Ring', authored: 'KNELL_ARENA', level: 1, mon: [], look: 'belfry', song: 'the_knell', tex: 'rune-floor', wall: 'ashlar', ambient: 'fire', knell: true },\n};\n// Story order, and which zone each quest lives in\nexport const CAMPAIGN = ['yard', 'town', 'causeway', 'ossuary1', 'ossuary2', 'ossuary3', 'counting', 'cloister', 'chapter', 'belfry1', 'belfry2', 'belfry3', 'summit'];\nexport const DUNGEON_BIOMES = ['causeway', 'ossuary1', 'cloister', 'belfry1'];\nEOF\necho ok"}},"wire_ingest_context":{"toolu_01UWw6Fe9bnCLgEfizqSswhX":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162042__x14746a/work/TollBoothOfDoom-Diablo3-claude-sonnet-5-5-medium-20261105-162042"}}}
