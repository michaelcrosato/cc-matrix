essed = true; window.__pad.buttons[0].value = 1; }\"); time.sleep(0.3)\n    pg.evaluate(\"() => { window.__pad.buttons[0].pressed = false; window.__pad.buttons[0].value = 0; }\")\n    pg.evaluate(\"() => { window.__pad.axes[0] = 0.8; window.__pad.axes[1] = -0.6; }\"); time.sleep(0.3)\n    print('device:', pg.evaluate(\"() => window.__game.game.input.lastDevice\"))\n    print('stick, not inverted   ->', pg.evaluate(\"() => window.__game.heroMove()\"))\n    pg.evaluate(\"() => window.__game.game.settings.set('invertX', true)\")\n    pg.evaluate(\"() => window.__game.game.settings.set('invertY', true)\")\n    time.sleep(0.2)\n    print('stick, both inverted  ->', pg.evaluate(\"() => window.__game.heroMove()\"))\n    pg.evaluate(\"() => { window.__pad.axes[0] = 0; window.__pad.axes[1] = 0; }\")\n    pg.evaluate(\"() => { window.__game.game.settings.set('invertX', false); window.__game.game.settings.set('invertY', false); }\")\n    # --- the Wire Room with the mouse: hover focus, click to flag ---\n    pg.evaluate(\"() => { const g = window.__game.game; g.go('wire', null, { fade: 0 }); g.timeScale = 1; }\")\n    time.sleep(6)   # first lines typed and revealed\n    st = pg.evaluate(\"() => window.__game.WIRE.state()\")\n    print('rows on screen:', [(r['i'], r['y']) for r in st['rows']][:4], 'cursor', st['S']['cur'])\n    tgt = st['rows'][0]\n    cs = pg.evaluate(\"([x, y]) => { const c = document.getElementById('screen').getBoundingClientRect(); const S = window.__game.game.screen; const p = S.W ? [c.left + (x / S.W) * c.width, c.top + (y / S.H) * c.height] : [0, 0]; return p; }\", [tgt['x'] + 20, tgt['y'] + 6])\n    pg.mouse.move(cs[0], cs[1]); time.sleep(0.3)\n    pg.mouse.down(); pg.mouse.up(); time.sleep(0.4)\n    st = pg.evaluate(\"() => window.__game.WIRE.state()\")\n    print('after click on row 0: flags', st['S']['flags'], 'cursor', st['S']['cur'])\n    pg.screenshot(path='/home/micha/.cache/wire-ref/shots/wire-mouse.png')\n    print('errors:', errs or 'none'); 