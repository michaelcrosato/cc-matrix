{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > browser-test.py <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json,sys,time\nbase=sys.argv[1] if len(sys.argv)>1 else 'http://127.0.0.1:38449'\nresults=[]\ndef check(name,condition,detail=''):\n results.append({'name':name,'pass':bool(condition),'detail':str(detail)})\ndef state(page):return page.evaluate('window.__stellar.state()')\ndef loaded(page,url):\n page.goto(url);page.wait_for_function('window.__stellar || window.__bootError',timeout=90000)\n if page.evaluate('\"'!!window.__bootError'\"'):raise RuntimeError(page.evaluate('window.__bootError'))\n check('correct page',page.title()=='Stellar Raiders')\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--no-sandbox'])\n context=b.new_context(viewport={'width':1440,'height':900},ignore_https_errors=True)\n page=context.new_page();errors=[];console=[]\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.on('console',lambda m:console.append(m.text) if m.type=='error' else None)\n try:\n  loaded(page,base+'/game.html')\n  check('WebGPU selected',state(page)['renderer']=='WebGPU',state(page)['renderer'])\n  check('music defaults to 10%',state(page)['audio']['musicVolume']==.1)\n  page.locator('[data-action=start]').click();page.wait_for_timeout(700)\n  check('launch enters flight',state(page)['running'] and state(page)['screen']=='flight')\n  z=state(page)['position']['z'];page.keyboard.down('w');page.wait_for_timeout(300);page.keyboard.up('w')\n  check('flight physics advances',state(page)['position']['z']<z)\n  page.keyboard.press('e');check('shield toggle',not page.evaluate('__stellar.game.shields'))\n  page.keyboard.press('e');page.keyboard.press('r');check('torpedo launch',state(page)['missiles']==5)\n  page.keyboard.press('Escape');t=state(page)['time'];page.wait_for_timeout(250)\n  check('pause stops campaign',state(page)['screen']=='pause' and state(page)['time']==t)\n  page.get_by_role('button',name='Dev flight deck').click()\n  slider=page.locator('[data-tune=enemyDamage]');slider.fill('3');slider.dispatch_event('input')\n  check('dev tuning live',state(page)['tuning']['enemyDamage']==3)\n  page.get_by_role('button',name='Reset defaults').click();check('dev reset defaults',state(page)['tuning']['enemyDamage']==9)\n  page.locator('[data-action=god]').click();check('dev invulnerability',page.evaluate('__stellar.game.god'))\n  page.keyboard.press('Escape');page.get_by_role('button',name='Settings',exact=True).click()\n  music=page.locator('[data-setting=music]');music.fill('24');music.dispatch_event('input')\n  check('music slider live',state(page)['audio']['musicVolume']==.24)\n  page.locator('[data-action=glyphs]').click();check('Xbox glyph setting',page.locator('[data-action=glyphs]').inner_text().startswith('Xbox'))\n  page.keyboard.press('Escape');page.locator('[data-action=resume]').click();page.keyboard.press('m')\n  check('sector chart usable',page.locator('.sector-cell').count()==20)\n  page.locator('[data-sector=\\\"16\\\"]').click();page.locator('[data-action=jump]').click()\n  page.wait_for_function('__stellar.game.sector===16',timeout=15000)\n  check('hyperspace reached starbase',state(page)['jumps']==1)\n  page.evaluate(\\\"__stellar.game.player.setTranslation({x:0,y:0,z:-330},true);__stellar.game.throttle=0;__stellar.game.hull=30;__stellar.game.energy=40\\\")\n  page.wait_for_function('__stellar.game.docked',timeout=12000)\n  check('docking repairs and reloads',state(page)['hull']==100 and state(page)['energy']>99 and state(page)['missiles']==6)\n  # Verify real Web Audio output and lifecycle, without human listening.\n  page.evaluate(\\\"__stellar.audio.sfx('explode');__stellar.audio.voice(7)\\\");page.wait_for_timeout(120)\n  check('procedural audio output',state(page)['audio']['rms']>0 and state(page)['audio']['voiceCount']>0)\n  page.evaluate('__stellar.audio.setMuted(true)');page.wait_for_timeout(100)\n  check('audio mute stops context',state(page)['audio']['state']=='suspended')\n  page.evaluate('__stellar.audio.setMuted(false)')\n  page.evaluate('__stellar.returnTitle()');page.wait_for_timeout(10400)\n  check('attract begins after inactivity',page.evaluate('__stellar.game.attract') and state(page)['screen']=='flight')\n  page.keyboard.press('z');check('input exits attract',state(page)['screen']=='title' and not page.evaluate('__stellar.game.attract'))\n  # Standard-mapping synthetic DualSense.\n  page.evaluate(\\\"window.testPad={id:'DualSense test',connected:true,mapping:'standard',index:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};navigator.getGamepads=()=>[testPad]\\\")\n  def button(i):\n   page.evaluate('(i)=>{testPad.buttons[i]={pressed:true,touched:true,value:1}}',i);page.wait_for_timeout(100)\n   page.evaluate('(i)=>{testPad.buttons[i]={pressed:false,touched:false,value:0}}',i);page.wait_for_timeout(100)\n  page.locator('[data-action=start]').focus();button(0)\n  check('gamepad launches patrol',state(page)['screen']=='flight' and state(page)['input']=='gamepad')\n  button(3);check('gamepad opens map',state(page)['screen']=='map')\n  button(15);button(0);page.wait_for_function('__stellar.game.jump || __stellar.game.sector\"'!==11'\"',timeout=3000)\n  check('gamepad confirms hyperspace',page.evaluate('\"'!!__stellar.game.jump'\"') or state(page)['sector']\"'!=11)\n  button(9);check('\"'gamepad pause',state(page)['screen']=='pause')\n  button(13);check('gamepad focus navigation',page.evaluate('document.activeElement.dataset.action')=='map')\n  button(12);check('gamepad focus reverse',page.evaluate('document.activeElement.dataset.action')=='resume')\n  check('keyboard/gamepad no exceptions',not errors,errors)\n  check('renderer no console errors',not console,console)\n  # Same-browser standalone multiplayer: actual BroadcastChannel, two pages.\n  other=context.new_page();loaded(other,base+'/game.html')\n  page.evaluate(\\\"__stellar.network.hostRoom('TESTWING');__stellar.start()\\\")\n  other.evaluate(\\\"__stellar.network.joinRoom('TESTWING');__stellar.start()\\\")\n  page.wait_for_function('__stellar.network.players.length===2',timeout=8000)\n  other.wait_for_function('__stellar.visuals.ghosts.size===1',timeout=8000)\n  check('local ghost wing exchanges ships',other.evaluate('__stellar.visuals.ghosts.size===1') and page.evaluate('__stellar.visuals.ghosts.size===1'))\n  other.evaluate('__stellar.network.leaveRoom()');page.wait_for_timeout(200)\n  check('local wing departure removes ghost',page.evaluate('__stellar.visuals.ghosts.size===0'))\n  other.close();page.close();context.close()\n  # Touch emulation uses a separate fresh profile.\n  mobile=b.new_context(viewport={'width':844,'height':390},device_scale_factor=1,is_mobile=True,has_touch=True,ignore_https_errors=True)\n  mp=mobile.new_page();loaded(mp,base+'/game.html');mp.locator('[data-action=start]').tap();mp.wait_for_timeout(100)\n  check('touch has minimal HUD',mp.locator('.dashboard').is_hidden() and mp.locator('#touchMenu').is_visible())\n  y=state(mp)['position']['z'];mp.dispatch_event('#space','pointerdown',{'pointerType':'touch','pointerId':1,'clientX':100,'clientY':200});mp.dispatch_event('#space','pointermove',{'pointerType':'touch','pointerId':1,'clientX':150,'clientY':170});mp.wait_for_timeout(350);mp.dispatch_event('#space','pointerup',{'pointerType':'touch','pointerId':1})\n  check('invisible touch stick steers',abs(mp.evaluate('__stellar.game.yaw'))>.01)\n  mp.locator('#touchMenu').tap();check('touch pause menu',state(mp)['screen']=='pause')\n  mp.close();mobile.close()\n  # Required AI Hub conformance scenarios, each within one browser page.\n  for suffix in ['players=2','players=4&latency=150&jitter=50&loss=5','players=4&latency=150&jitter=50&loss=5&scenario=host-leave']:\n   hc=b.new_context(viewport={'width':1440,'height':900},ignore_https_errors=True);hp=hc.new_page()\n   hp.goto(base+'/harness.html?game=game.html&auto=1&'+suffix)\n   hp.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=120000)\n   report=hp.evaluate('window.__hubCheck')\n   for c in report['checks']:check('Hub '+suffix+': '+c['name'],c['pass'],c.get('detail',''))\n   hp.close();hc.close()\n except Exception as e:check('browser suite completed',False,str(e))\n finally:b.close()\nPath('browser-results.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps({'checks':len(results),'passed':sum(r['pass'] for r in results),'failures':[r for r in results if not r['pass']]}))\nsys.exit(0 if all(r['pass'] for r in results) else 1)\nPY\ncat > verify.mjs <<'JS'\nimport {execFileSync,spawn} from 'node:child_process';\nimport {fileURLToPath} from 'node:url';\nimport {dirname} from 'node:path';\nconst cwd=dirname(fileURLToPath(import.meta.url));\nlet n=0,fail=0;\ntry{const out=execFileSync('node',['core-test.mjs'],{cwd,encoding:'utf8',stdio:['ignore','pipe','pipe']});n+=14;if(\"'!out.includes('\"'0 failed')){fail++;console.log('FAIL core tests: '+out.trim());}}catch(e){fail++;console.log('FAIL core tests: '+e.stdout?.toString().trim());}\nconst server=spawn('python3',['-u','-m','http.server','0','--bind','127.0.0.1'],{cwd,stdio:['ignore','pipe','ignore']});\ntry{const url=await new Promise((resolve,reject)=>{let s='';server.stdout.on('data',v=>{s+=v;const m=s.match(/port (\\\\d+)/);if(m)resolve('http://127.0.0.1:'+m[1]);});server.on('error',reject);setTimeout(()=>reject(new Error('server startup timed out')),10000).unref();});\n const out=await new Promise((resolve,reject)=>{const p=spawn('/home/micha/.local/share/pipx/venvs/playwright/bin/python',['browser-test.py',url],{cwd,stdio:['ignore','pipe','pipe']});let s='',err='';p.stdout.on('data',v=>s+=v);p.stderr.on('data',v=>err+=v);p.on('exit',()=>{try{resolve(JSON.parse(s.trim()));}catch{reject(new Error(err||s));}});p.on('error',reject);});n+=out.checks;for(const f of out.failures){fail++;console.log('FAIL '+f.name+': '+f.detail);}\n}catch(e){fail++;console.log('FAIL verification: '+e.message);}finally{server.kill('SIGINT');}\nconsole.log(\"'`${n} checks: ${n-fail} passed, ${fail} failed`);process.exitCode=fail?1:0;\nJS\nnode --check verify.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > browser-test.py <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json,sys,time\nbase=sys.argv[1] if len(sys.argv)>1 else 'http://127.0.0.1:38449'\nresults=[]\ndef check(name,condition,detail=''):\n results.append({'name':name,'pass':bool(condition),'detail':str(detail)})\ndef state(page):return page.evaluate('window.__stellar.state()')\ndef loaded(page,url):\n page.goto(url);page.wait_for_function('window.__stellar || window.__bootError',timeout=90000)\n if page.evaluate('\"'!!window.__bootError'\"'):raise RuntimeError(page.evaluate('window.__bootError'))\n check('correct page',page.title()=='Stellar Raiders')\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--no-sandbox'])\n context=b.new_context(viewport={'width':1440,'height':900},ignore_https_errors=True)\n page=context.new_page();errors=[];console=[]\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.on('console',lambda m:console.append(m.text) if m.type=='error' else None)\n try:\n  loaded(page,base+'/game.html')\n  check('WebGPU selected',state(page)['renderer']=='WebGPU',state(page)['renderer'])\n  check('music defaults to 10%',state(page)['audio']['musicVolume']==.1)\n  page.locator('[data-action=start]').click();page.wait_for_timeout(700)\n  check('launch enters flight',state(page)['running'] and state(page)['screen']=='flight')\n  z=state(page)['position']['z'];page.keyboard.down('w');page.wait_for_timeout(300);page.keyboard.up('w')\n  check('flight physics advances',state(page)['position']['z']<z)\n  page.keyboard.press('e');check('shield toggle',not page.evaluate('__stellar.game.shields'))\n  page.keyboard.press('e');page.keyboard.press('r');check('torpedo launch',state(page)['missiles']==5)\n  page.keyboard.press('Escape');t=state(page)['time'];page.wait_for_timeout(250)\n  check('pause stops campaign',state(page)['screen']=='pause' and state(page)['time']==t)\n  page.get_by_role('button',name='Dev flight deck').click()\n  slider=page.locator('[data-tune=enemyDamage]');slider.fill('3');slider.dispatch_event('input')\n  check('dev tuning live',state(page)['tuning']['enemyDamage']==3)\n  page.get_by_role('button',name='Reset defaults').click();check('dev reset defaults',state(page)['tuning']['enemyDamage']==9)\n  page.locator('[data-action=god]').click();check('dev invulnerability',page.evaluate('__stellar.game.god'))\n  page.keyboard.press('Escape');page.get_by_role('button',name='Settings',exact=True).click()\n  music=page.locator('[data-setting=music]');music.fill('24');music.dispatch_event('input')\n  check('music slider live',state(page)['audio']['musicVolume']==.24)\n  page.locator('[data-action=glyphs]').click();check('Xbox glyph setting',page.locator('[data-action=glyphs]').inner_text().startswith('Xbox'))\n  page.keyboard.press('Escape');page.locator('[data-action=resume]').click();page.keyboard.press('m')\n  check('sector chart usable',page.locator('.sector-cell').count()==20)\n  page.locator('[data-sector=\\\"16\\\"]').click();page.locator('[data-action=jump]').click()\n  page.wait_for_function('__stellar.game.sector===16',timeout=15000)\n  check('hyperspace reached starbase',state(page)['jumps']==1)\n  page.evaluate(\\\"__stellar.game.player.setTranslation({x:0,y:0,z:-330},true);__stellar.game.throttle=0;__stellar.game.hull=30;__stellar.game.energy=40\\\")\n  page.wait_for_function('__stellar.game.docked',timeout=12000)\n  check('docking repairs and reloads',state(page)['hull']==100 and state(page)['energy']>99 and state(page)['missiles']==6)\n  # Verify real Web Audio output and lifecycle, without human listening.\n  page.evaluate(\\\"__stellar.audio.sfx('explode');__stellar.audio.voice(7)\\\");page.wait_for_timeout(120)\n  check('procedural audio output',state(page)['audio']['rms']>0 and state(page)['audio']['voiceCount']>0)\n  page.evaluate('__stellar.audio.setMuted(true)');page.wait_for_timeout(100)\n  check('audio mute stops context',state(page)['audio']['state']=='suspended')\n  page.evaluate('__stellar.audio.setMuted(false)')\n  page.evaluate('__stellar.returnTitle()');page.wait_for_timeout(10400)\n  check('attract begins after inactivity',page.evaluate('__stellar.game.attract') and state(page)['screen']=='flight')\n  page.keyboard.press('z');check('input exits attract',state(page)['screen']=='title' and not page.evaluate('__stellar.game.attract'))\n  # Standard-mapping synthetic DualSense.\n  page.evaluate(\\\"window.testPad={id:'DualSense test',connected:true,mapping:'standard',index:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};navigator.getGamepads=()=>[testPad]\\\")\n  def button(i):\n   page.evaluate('(i)=>{testPad.buttons[i]={pressed:true,touched:true,value:1}}',i);page.wait_for_timeout(100)\n   page.evaluate('(i)=>{testPad.buttons[i]={pressed:false,touched:false,value:0}}',i);page.wait_for_timeout(100)\n  page.locator('[data-action=start]').focus();button(0)\n  check('gamepad launches patrol',state(page)['screen']=='flight' and state(page)['input']=='gamepad')\n  button(3);check('gamepad opens map',state(page)['screen']=='map')\n  button(15);button(0);page.wait_for_function('__stellar.game.jump || __stellar.game.sector\"'!==11'\"',timeout=3000)\n  check('gamepad confirms hyperspace',page.evaluate('\"'!!__stellar.game.jump'\"') or state(page)['sector']\"'!=11)\n  button(9);check('\"'gamepad pause',state(page)['screen']=='pause')\n  button(13);check('gamepad focus navigation',page.evaluate('document.activeElement.dataset.action')=='map')\n  button(12);check('gamepad focus reverse',page.evaluate('document.activeElement.dataset.action')=='resume')\n  check('keyboard/gamepad no exceptions',not errors,errors)\n  check('renderer no console errors',not console,console)\n  # Same-browser standalone multiplayer: actual BroadcastChannel, two pages.\n  other=context.new_page();loaded(other,base+'/game.html')\n  page.evaluate(\\\"__stellar.network.hostRoom('TESTWING');__stellar.start()\\\")\n  other.evaluate(\\\"__stellar.network.joinRoom('TESTWING');__stellar.start()\\\")\n  page.wait_for_function('__stellar.network.players.length===2',timeout=8000)\n  other.wait_for_function('__stellar.visuals.ghosts.size===1',timeout=8000)\n  check('local ghost wing exchanges ships',other.evaluate('__stellar.visuals.ghosts.size===1') and page.evaluate('__stellar.visuals.ghosts.size===1'))\n  other.evaluate('__stellar.network.leaveRoom()');page.wait_for_timeout(200)\n  check('local wing departure removes ghost',page.evaluate('__stellar.visuals.ghosts.size===0'))\n  other.close();page.close();context.close()\n  # Touch emulation uses a separate fresh profile.\n  mobile=b.new_context(viewport={'width':844,'height':390},device_scale_factor=1,is_mobile=True,has_touch=True,ignore_https_errors=True)\n  mp=mobile.new_page();loaded(mp,base+'/game.html');mp.locator('[data-action=start]').tap();mp.wait_for_timeout(100)\n  check('touch has minimal HUD',mp.locator('.dashboard').is_hidden() and mp.locator('#touchMenu').is_visible())\n  y=state(mp)['position']['z'];mp.dispatch_event('#space','pointerdown',{'pointerType':'touch','pointerId':1,'clientX':100,'clientY':200});mp.dispatch_event('#space','pointermove',{'pointerType':'touch','pointerId':1,'clientX':150,'clientY':170});mp.wait_for_timeout(350);mp.dispatch_event('#space','pointerup',{'pointerType':'touch','pointerId':1})\n  check('invisible touch stick steers',abs(mp.evaluate('__stellar.game.yaw'))>.01)\n  mp.locator('#touchMenu').tap();check('touch pause menu',state(mp)['screen']=='pause')\n  mp.close();mobile.close()\n  # Required AI Hub conformance scenarios, each within one browser page.\n  for suffix in ['players=2','players=4&latency=150&jitter=50&loss=5','players=4&latency=150&jitter=50&loss=5&scenario=host-leave']:\n   hc=b.new_context(viewport={'width':1440,'height':900},ignore_https_errors=True);hp=hc.new_page()\n   hp.goto(base+'/harness.html?game=game.html&auto=1&'+suffix)\n   hp.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=120000)\n   report=hp.evaluate('window.__hubCheck')\n   for c in report['checks']:check('Hub '+suffix+': '+c['name'],c['pass'],c.get('detail',''))\n   hp.close();hc.close()\n except Exception as e:check('browser suite completed',False,str(e))\n finally:b.close()\nPath('browser-results.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps({'checks':len(results),'passed':sum(r['pass'] for r in results),'failures':[r for r in results if not r['pass']]}))\nsys.exit(0 if all(r['pass'] for r in results) else 1)\nPY\ncat > verify.mjs <<'JS'\nimport {execFileSync,spawn} from 'node:child_process';\nimport {fileURLToPath} from 'node:url';\nimport {dirname} from 'node:path';\nconst cwd=dirname(fileURLToPath(import.meta.url));\nlet n=0,fail=0;\ntry{const out=execFileSync('node',['core-test.mjs'],{cwd,encoding:'utf8',stdio:['ignore','pipe','pipe']});n+=14;if(\"'!out.includes('\"'0 failed')){fail++;console.log('FAIL core tests: '+out.trim());}}catch(e){fail++;console.log('FAIL core tests: '+e.stdout?.toString().trim());}\nconst server=spawn('python3',['-u','-m','http.server','0','--bind','127.0.0.1'],{cwd,stdio:['ignore','pipe','ignore']});\ntry{const url=await new Promise((resolve,reject)=>{let s='';server.stdout.on('data',v=>{s+=v;const m=s.match(/port (\\\\d+)/);if(m)resolve('http://127.0.0.1:'+m[1]);});server.on('error',reject);setTimeout(()=>reject(new Error('server startup timed out')),10000).unref();});\n const out=await new Promise((resolve,reject)=>{const p=spawn('/home/micha/.local/share/pipx/venvs/playwright/bin/python',['browser-test.py',url],{cwd,stdio:['ignore','pipe','pipe']});let s='',err='';p.stdout.on('data',v=>s+=v);p.stderr.on('data',v=>err+=v);p.on('exit',()=>{try{resolve(JSON.parse(s.trim()));}catch{reject(new Error(err||s));}});p.on('error',reject);});n+=out.checks;for(const f of out.failures){fail++;console.log('FAIL '+f.name+': '+f.detail);}\n}catch(e){fail++;console.log('FAIL verification: '+e.message);}finally{server.kill('SIGINT');}\nconsole.log(\"'`${n} checks: ${n-fail} passed, ${fail} failed`);process.exitCode=fail?1:0;\nJS\nnode --check verify.mjs'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat package.json && sed -n '1,60p' core-test.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat package.json && sed -n '1,60p' core-test.mjs\"","aggregated_output":"{\n  \"name\": \"stellar-raiders-star-raiders-gpt-6.1-sol-ultra-20261105-223041\",\n  \"version\": \"1.0.0\",\n  \"description\": \"\",\n  \"main\": \"bridge.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\",\n    \"build\": \"node build.mjs\"\n  },\n  \"keywords\": [],\n  \"type\": \"module\",\n  \"devDependencies\": {\n    \"esbuild\": \"^0.28.2\"\n  },\n  \"dependencies\": {\n    \"@dimforge/rapier3d-compat\": \"^0.19.3\",\n    \"three\": \"^0.180.0\"\n  }\n}\nimport assert from 'node:assert/strict';\nimport { readFile } from 'node:fs/promises';\nimport RAPIER from '@dimforge/rapier3d-compat';\n\nconst originalWarn = console.warn;\nconsole.warn = (...args) => { if (!String(args[0]).includes('deprecated parameters')) originalWarn(...args); };\nawait RAPIER.init();\nconsole.warn = originalWarn;\n// Also works before package.json switches to ESM during development.\nconst source = (await readFile(new URL('./core.js', import.meta.url), 'utf8')).replace(\"'@dimforge/rapier3d-compat'\", JSON.stringify(import.meta.resolve('@dimforge/rapier3d-compat')));\nconst { Campaign, DEFAULTS, dist } = await import('data:text/javascript;base64,' + Buffer.from(source).toString('base64'));\nlet passed = 0, failed = 0;\nconst dt = 1 / 60;\nconst close = (a, b, tolerance = 0.001) => assert.ok(Math.abs(a - b) <= tolerance, `${a} differs from ${b}`);\nconst tick = (game, seconds, input = {}) => { for (let i = 0; i < Math.ceil(seconds / dt); i++) game.update(dt, typeof input === 'function' ? input(game) : input); };\nconst free = game => { game.events.free(); game.world.free(); };\nasync function test(name, fn) {\n  const log = [];\n  let game;\n  try { game = new Campaign((type, data) => log.push({ type, data })); await fn(game, log); passed++; }\n  catch (error) { failed++; console.log(`FAIL ${name}: ${error.message}`); }\n  finally { if (game) free(game); }\n}\nfunction launch(game) {\n  game.launch();\n}\nfunction aim(game, target = game.target) {\n  if (!target || target.dead) return { yaw: 0, pitch: 0 };\n  const p = game.position, q = target.body.translation();\n  const d = dist(p, q) || 1;\n  const yaw = Math.atan2(-(q.x - p.x), -(q.z - p.z));\n  const pitch = Math.asin((q.y - p.y) / d);\n  const error = Math.atan2(Math.sin(yaw - game.yaw), Math.cos(yaw - game.yaw));\n  return { yaw: Math.max(-1, Math.min(1, error * 4)), pitch: Math.max(-1, Math.min(1, (pitch - game.pitch) * 4)) };\n}\nfunction transit(game, sector, input = {}) {\n  assert.equal(game.beginJump(sector), true, 'jump must initiate');\n  let frames = 0;\n  while (game.jump && frames++ < 310) game.update(dt, input);\n  assert.equal(game.jump, null, 'jump must complete');\n  assert.equal(game.sector, sector);\n}\n\nawait test('real Rapier launch and initial mission', (game, log) => {\n  assert.equal(RAPIER.version(), '0.19.3');\n  launch(game);\n  assert.equal(game.running, true);\n  assert.equal(game.sector, 11);\n  assert.equal(game.remaining, 13);\n  assert.equal(game.enemies.length, 3);\n  assert.equal(game.world.bodies.len(), 4);\n  assert.ok(log.some(e => e.type === 'message'));\n});\nawait test('player physics movement and steering', game => {\n  launch(game); game.tuning.enemyRate = 0;\n  const before = { ...game.position };\n  tick(game, 1);\n  assert.ok(game.position.z < before.z - 30, 'forward thrust must move the real rigid body');\n  tick(game, 0.5, { yaw: 1, pitch: 0.5, thrust: 1, strafe: 1 });\n  assert.ok(game.yaw > .7 && game.pitch > .35);\n","exit_code":0,"status":"completed"}}
