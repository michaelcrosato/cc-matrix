{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'cat ui.html && cat network.js && cat build.mjs'","aggregated_output":"<div class=\"screen-vignette\" aria-hidden=\"true\"></div>\n<div class=\"screen-grain\" aria-hidden=\"true\"></div>\n<section id=\"menu\" class=\"panel title-screen\" data-screen=\"title\" aria-label=\"Stellar Raiders title screen\">\n  <div class=\"title-topline\"><span class=\"insignia\" aria-hidden=\"true\">✦</span><span>FRONTIER DEFENCE COMMAND <i>/</i> 1982 → 2026</span><span class=\"registration\">SR—01</span></div>\n  <div class=\"title-content\">\n    <div class=\"eyebrow title-kicker\"><span class=\"live-dot\"></span> ONE PILOT. AN ENTIRE FRONTIER.</div>\n    <h1><span>STELLAR</span><span class=\"title-outline\">RAIDERS<span class=\"title-period\">.</span></span></h1>\n    <p class=\"tagline\">A small ship.<br>A very big problem.</p>\n    <nav class=\"title-actions\" aria-label=\"Main menu\">\n      <button class=\"button primary launch\" data-action=\"start\"><span class=\"button-mark\" aria-hidden=\"true\">↗</span><span>Launch patrol</span><span class=\"button-trail\" aria-hidden=\"true\">01</span></button>\n      <div class=\"title-secondary\"><button class=\"button\" data-action=\"manual\">Flight manual</button><button class=\"button\" data-action=\"online\">Wing link <span class=\"link-symbol\" aria-hidden=\"true\">⌁</span></button></div>\n      <div class=\"title-small-actions\"><button data-action=\"settings\">Settings</button><span>/</span><button data-action=\"about\">About & credits</button></div>\n    </nav>\n  </div>\n  <div class=\"title-scene-label\" aria-hidden=\"true\"><span class=\"label-rule\"></span><span>FDC INTERCEPTOR</span><b>“LITTLE PROBLEM”</b><small>LONG RANGE / SHORT TEMPER</small></div>\n  <footer class=\"title-footer\"><span>INKSPACE <i>/</i> FLIGHT LOG 01</span><span id=\"bootStatus\"><span class=\"live-dot\"></span> PREPARING FLIGHT SYSTEMS</span><span class=\"title-footer-right\">THE FRONTIER IS CALLING<span>ANSWER WITH BOTH BARRELS.</span></span></footer>\n</section>\n<section id=\"hud\" class=\"hud\" hidden aria-label=\"Flight instruments\">\n  <div class=\"hud-top\">\n    <div class=\"mission-block\"><div class=\"eyebrow\"><span class=\"live-dot\"></span> FRONTIER PATROL <span id=\"missionProgress\">01 / 03</span></div><div id=\"objective\">Clear the raider squadrons</div><div class=\"mission-sub\"><span id=\"sectorLabel\">SECTOR A1</span><span class=\"separator\">/</span><span id=\"statusLabel\">ALL SYSTEMS NOMINAL</span></div></div>\n    <div class=\"navigation-block\"><span class=\"eyebrow\">NAV COMPUTER</span><strong id=\"navTarget\">NO JUMP PLOTTED</strong><span id=\"threatValue\">SCAN THE FRONTIER</span></div>\n  </div>\n  <div class=\"reticle\" aria-hidden=\"true\"><span class=\"reticle-cross\"></span><span class=\"reticle-dot\"></span><span class=\"reticle-left\"></span><span class=\"reticle-right\"></span></div>\n  <div id=\"targetInfo\" class=\"target-info\"></div>\n  <div id=\"comms\" class=\"comms\"><div class=\"comms-portrait\" aria-hidden=\"true\"><span>✦</span><i></i><i></i><i></i><i></i><i></i></div><div><span id=\"speaker\" class=\"eyebrow\">COMMAND</span><p id=\"message\">The frontier is yours, pilot. Make it count.</p></div></div>\n  <div class=\"cockpit-rim cockpit-rim-left\" aria-hidden=\"true\"></div><div class=\"cockpit-rim cockpit-rim-right\" aria-hidden=\"true\"></div>\n  <div class=\"dashboard\">\n    <div class=\"instrument-panel systems-panel\">\n      <div class=\"instrument-heading\"><span>SHIP INTEGRITY</span><span class=\"micro-square\">▰</span></div>\n      <div class=\"instrument\"><span class=\"instrument-name\">SHIELD</span><div class=\"meter\"><div id=\"shieldBar\" class=\"meter-fill shield\" style=\"width:100%\"></div></div><strong id=\"shieldValue\">100</strong></div>\n      <div class=\"instrument\"><span class=\"instrument-name\">HULL</span><div class=\"meter\"><div id=\"hullBar\" class=\"meter-fill hull\" style=\"width:100%\"></div></div><strong id=\"hullValue\">100</strong></div>\n      <div class=\"system-foot\">FDC / INTERCEPTOR CLASS <span>✦</span></div>\n    </div>\n    <div class=\"instrument-panel radar-panel\"><div class=\"instrument-heading\"><span>LOCAL SCAN</span><span class=\"radar-live\">LIVE</span></div><canvas id=\"radar\" width=\"220\" height=\"150\" aria-label=\"Local radar\"></canvas><div class=\"radar-bottom\"><span>FRONT</span><span>▵ YOU</span><span>REAR</span></div></div>\n    <div class=\"flight-center\"><div class=\"speed\"><strong id=\"speedValue\">0</strong><span>IMPULSE</span></div><div id=\"prompts\" class=\"prompts\">W / S THRUST <span>·</span> M GALACTIC MAP</div></div>\n    <div class=\"instrument-panel weapons-panel\">\n      <div class=\"instrument-heading\"><span>COMBAT SYSTEMS</span><span class=\"micro-square\">▰</span></div>\n      <div class=\"instrument\"><span class=\"instrument-name\">ENERGY</span><div class=\"meter\"><div id=\"energyBar\" class=\"meter-fill energy\" style=\"width:100%\"></div></div><strong id=\"energyValue\">100</strong></div>\n      <div class=\"instrument\"><span class=\"instrument-name\">HEAT</span><div class=\"meter\"><div id=\"heatBar\" class=\"meter-fill heat\" style=\"width:0%\"></div></div><strong id=\"heatValue\">0</strong></div>\n      <div class=\"combat-stats\"><span><b id=\"killsValue\">0</b> KILLS</span><span><b id=\"basesValue\">3</b> BASES</span><span><b id=\"ammoValue\">6</b> TORPS</span></div>\n    </div>\n  </div>\n</section>\n<div id=\"jumpOverlay\" class=\"jump-overlay\" hidden><div class=\"jump-line\"></div><span class=\"eyebrow\">HYPERSPACE TRANSIT</span><strong>HOLD YOUR COURSE</strong><span class=\"jump-coordinates\">SPACE IS MOSTLY A SUGGESTION.</span></div>\n<div id=\"attractBanner\" class=\"attract-banner\" hidden><span class=\"live-dot\"></span>AUTOPILOT DEMONSTRATION <span class=\"attract-hint\">ANY INPUT TO RETURN</span></div>\n<div id=\"flash\" class=\"damage-flash\" aria-hidden=\"true\"></div>\n<div id=\"toast\" class=\"toast\" role=\"status\" hidden></div>\n<div id=\"modal\" class=\"modal\" hidden role=\"dialog\" aria-modal=\"true\"></div>\n<button id=\"touchMenu\" class=\"touch-menu\" data-action=\"pause\" aria-label=\"Pause game\">Ⅱ</button>\n<button id=\"touchAction\" class=\"touch-action\" data-action=\"context\" hidden>JUMP</button>\n<div id=\"loading\" class=\"loading-screen\"><span class=\"loading-symbol\">✦</span><span class=\"eyebrow\">STELLAR RAIDERS</span><strong>Waking the frontier.</strong><p>Preparing navigation, physics & flight systems</p><div class=\"loading-track\"><span></span></div></div>\n// AI Hub ghost sessions and an optional same-browser practice wing.\nexport class Network {\n  constructor(callbacks = {}) {\n    this.callbacks = callbacks;\n    this.hub = globalThis.AIHub || null;\n    this._active = !!this.hub?.active;\n    this._started = false;\n    this._ended = false;\n    this._finished = false;\n    this._score = 0;\n    this._stats = {};\n    this._sendElapsed = 0;\n    this._progressElapsed = 1;\n    this._room = '';\n    this._channel = null;\n    this._peers = new Map();\n    this._localId = globalThis.crypto?.randomUUID?.() || `pilot-${Date.now()}-${performance.now()}`;\n    this._localTimer = null;\n    this._closedIds = new Set();\n  }\n\n  get active() { return this._active; }\n  get started() { return this._started; }\n  get ended() { return this._ended; }\n  get me() { return this._active ? this.hub.me : this._localId; }\n  get room() { return this._room; }\n  get players() {\n    if (this._active) return this.hub.players || [];\n    const ids = [this._localId, ...this._peers.keys()].sort().slice(0, 4);\n    const colors = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\n    return ids.map((id, i) => ({ id, name: `Pilot ${i + 1}`, color: colors[i] }));\n  }\n  get status() {\n    if (this._active) return this._ended ? 'Hub round complete' : this.canPlay() ? `AI Hub · ${this.players.length} pilots` : 'AI Hub · awaiting launch';\n    if (!this._room) return 'Solo patrol';\n    return `Local wing ${this._room} · ${this.players.length}/4 pilots`;\n  }\n\n  async init() {\n    if (!this._active) return null;\n    this.hub.on('start', () => {\n      if (this._ended) return;\n      this._started = true;\n      this.callbacks.start?.();\n    });\n    this.hub.on('message', (data, from) => {\n      if (this._ended || this._closedIds.has(from) || data?.t !== 'pilot') return;\n      const snapshot = this._snapshot(data.p);\n      if (snapshot) this.callbacks.ghost?.(snapshot, from);\n    });\n    this.hub.on('leave', ({ id }) => {\n      this._closedIds.add(id);\n      this.callbacks.leave?.(id);\n    });\n    this.hub.on('time-up', () => {\n      if (this._ended) return;\n      const result = this.callbacks.timeup?.();\n      if (typeof result === 'number') this.finish(result);\n      else this.finish(result?.score ?? this._score, result?.stats ?? this._stats);\n    });\n    this.hub.on('end', (event) => {\n      if (this._ended) return;\n      this._ended = true;\n      this.callbacks.end?.(event);\n    });\n    const info = await this.hub.connect({ mode: 'ghost', seats: [1, 4] });\n    if (!info) {\n      this._active = false;\n      return null;\n    }\n    this.hub.ready();\n    return info;\n  }\n\n  canPlay() {\n    return !this._ended && (!this._active || (this._started && this.hub.time() >= 0));\n  }\n\n  tick(dt, playerSnapshot, score) {\n    if (this._ended) return;\n    this._score = Number.isFinite(score) ? score : this._score;\n    if (!this.canPlay()) return;\n    this._sendElapsed += Math.max(0, dt || 0);\n    this._progressElapsed += Math.max(0, dt || 0);\n    if (this._active && !this._finished && this._progressElapsed >= 1) {\n      this._progressElapsed %= 1;\n      this.hub.progress({ score: this._score, label: `${Math.floor(this._score)} command points` });\n    }\n    if (this._sendElapsed < 0.1) return;\n    this._sendElapsed %= 0.1;\n    const snapshot = this._snapshot(playerSnapshot);\n    if (!snapshot) return;\n    if (this._active) this.hub.send({ t: 'pilot', p: snapshot }, { reliable: false });\n    else if (this._channel && this.players.some((p) => p.id === this._localId)) this._post({ t: 'pilot', p: snapshot, score: this._score });\n  }\n\n  finish(score, stats = {}) {\n    if (this._ended || this._finished) return;\n    this._finished = true;\n    this._score = Number.isFinite(score) ? score : this._score;\n    this._stats = stats && typeof stats === 'object' ? stats : {};\n    if (this._active) this.hub.result({ score: this._score, stats: this._stats });\n  }\n\n  hostRoom(code) {\n    if (this._active) return false;\n    if (!code) {\n      const bytes = new Uint8Array(4);\n      crypto.getRandomValues(bytes);\n      code = Array.from(bytes, (b) => 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[b % 32]).join('');\n    }\n    return this.joinRoom(code);\n  }\n\n  joinRoom(code) {\n    if (this._active || typeof BroadcastChannel !== 'function') return false;\n    const cleaned = String(code || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 8);\n    if (!cleaned) return false;\n    this.leaveRoom();\n    this._room = cleaned;\n    this._channel = new BroadcastChannel(`stellar-raiders-wing-v1-${cleaned}`);\n    this._channel.onmessage = ({ data }) => this._receiveLocal(data);\n    this._post({ t: 'hello' });\n    this._localTimer = setInterval(() => {\n      this._post({ t: 'presence' });\n      const now = performance.now();\n      for (const [id, peer] of this._peers) {\n        if (now - peer.seen > 6000) {\n          this._peers.delete(id);\n          this.callbacks.leave?.(id);\n        }\n      }\n    }, 1000);\n    return cleaned;\n  }\n\n  leaveRoom() {\n    if (this._channel) {\n      this._post({ t: 'bye' });\n      this._channel.close();\n      this._channel = null;\n    }\n    clearInterval(this._localTimer);\n    this._localTimer = null;\n    for (const id of this._peers.keys()) this.callbacks.leave?.(id);\n    this._peers.clear();\n    this._room = '';\n  }\n\n  _post(data) {\n    try { this._channel?.postMessage({ ...data, id: this._localId, v: 1 }); } catch { /* A closed practice wing is harmless. */ }\n  }\n\n  _receiveLocal(data) {\n    if (!data || data.v !== 1 || typeof data.id !== 'string' || data.id === this._localId || data.id.length > 100) return;\n    if (data.t === 'bye') {\n      this._peers.delete(data.id);\n      this.callbacks.leave?.(data.id);\n      return;\n    }\n    if (!['hello', 'presence', 'pilot'].includes(data.t)) return;\n    if (!this._peers.has(data.id) && this._peers.size >= 3) return;\n    this._peers.set(data.id, { seen: performance.now(), score: Number(data.score) || 0 });\n    if (data.t === 'hello') this._post({ t: 'presence' });\n    if (data.t === 'pilot') {\n      const snapshot = this._snapshot(data.p);\n      if (snapshot) this.callbacks.ghost?.(snapshot, data.id);\n    }\n  }\n\n  _snapshot(value) {\n    if (!value || typeof value !== 'object' || Array.isArray(value)) return null;\n    try {\n      const json = JSON.stringify(value);\n      return json.length <= 4000 ? JSON.parse(json) : null;\n    } catch { return null; }\n  }\n}\nimport { build } from 'esbuild';\nimport { readFile, writeFile, rename } from 'node:fs/promises';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst directory = dirname(fileURLToPath(import.meta.url));\nconst filename = 'Stellar-Raiders-Star-Raiders-gpt-6.1-sol-ultra-20261105-223041.html';\nconst read = (name) => readFile(join(directory, name), 'utf8');\nconst jsonForHTML = (value) => JSON.stringify(value).replaceAll('<', '\\\\u003c');\nconst [markup, css, session, metadataText] = await Promise.all([\n  read('ui.html'), read('ui.css'), read('hub-session.js'), read('metadata.json'),\n]);\nconst metadata = JSON.parse(metadataText);\nconst body = markup.match(/<body\\b[^>]*>([\\s\\S]*?)<\\/body>/i)?.[1] ?? markup;\nif (/<\\/script/i.test(session)) throw new Error('The unmodified Hub client unexpectedly contains an HTML closing script tag.');\nif (/<\\/style/i.test(css)) throw new Error('UI stylesheet contains an HTML closing style tag.');\n\nconst result = await build({\n  absWorkingDir: directory,\n  entryPoints: ['main.js'],\n  bundle: true,\n  write: false,\n  platform: 'browser',\n  format: 'esm',\n  target: ['es2022'],\n  minify: false,\n  treeShaking: true,\n  legalComments: 'inline',\n  external: ['three', 'three/webgpu', 'three/tsl', '@dimforge/rapier3d-compat'],\n  logLevel: 'silent',\n});\nconst javascript = result.outputFiles[0].text.replace(/<\\/script/gi, '<\\\\/script');\nconst imports = {\n  three: 'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js',\n  'three/webgpu': 'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js',\n  'three/tsl': 'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.tsl.js',\n  '@dimforge/rapier3d-compat': 'https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-compat@0.19.3/+esm',\n};\nconst favicon = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 rx=%2214%22 fill=%22%230c1726%22/%3E%3Cpath d=%22M32 6L40 24L58 32L40 40L32 58L24 40L6 32L24 24Z%22 fill=%22%23ffcd75%22 stroke=%22%23060810%22 stroke-width=%223%22/%3E%3C/svg%3E';\nconst html = `<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<script>${session}</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#0c1726\">\n<meta name=\"description\" content=\"An ink-drawn cockpit space adventure. Defend the frontier, hunt the raider fleet, and bring your ship home.\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Stop the incursion. Destroy the raider fleet and its flagship; score command points while keeping the frontier starbases alive.\">\n<meta name=\"hub:session-howto\" content=\"Stick / mouse: steer. R2 / left click: fire. L2 / right click: missile. Cross / E: interact. Triangle / M: sector map. Options / Esc: pause.\">\n<meta name=\"hub:session-minutes\" content=\"8\">\n<title>Stellar Raiders</title>\n<link rel=\"icon\" href=\"${favicon}\">\n<script type=\"importmap\">${jsonForHTML({ imports })}</script>\n<style>${css}</style>\n</head>\n<body>\n${body}\n<script type=\"application/json\" id=\"creditsData\">${jsonForHTML(metadata)}</script>\n<script type=\"module\">\n${javascript}\n</script>\n</body>\n</html>\n`;\nconst temporary = join(directory, '.game-build.html');\nawait writeFile(temporary, html);\nawait rename(temporary, join(directory, 'game.html'));\nawait writeFile(resolve(directory, '..', filename), html);\nconsole.log(`Built Stellar Raiders · ${Math.round(Buffer.byteLength(html) / 1024)} KiB · one HTML file`);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='core.js'\ns=open(p).read().replace('if(this.world)this.world.free();','if(this.events)this.events.free();if(this.world)this.world.free();').replace('.setEnabledRotations(false,false,false)','.enabledRotations(false,false,false)')\nopen(p,'w').write(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
