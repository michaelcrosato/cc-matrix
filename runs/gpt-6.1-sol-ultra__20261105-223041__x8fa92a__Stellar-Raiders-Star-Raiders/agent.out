{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"rg 'class Mesh.*NodeMaterial|MeshToon' node_modules/three/src/materials/nodes -n | head -25 && rg 'export.*(normalWorld|positionWorld|cameraPosition)' node_modules/three/src/Three.TSL.js\"","aggregated_output":"node_modules/three/src/materials/nodes/MeshPhysicalNodeMaterial.js:20:class MeshPhysicalNodeMaterial extends MeshStandardNodeMaterial {\nnode_modules/three/src/materials/nodes/MeshBasicNodeMaterial.js:19:class MeshBasicNodeMaterial extends NodeMaterial {\nnode_modules/three/src/materials/nodes/MeshPhongNodeMaterial.js:17:class MeshPhongNodeMaterial extends NodeMaterial {\nnode_modules/three/src/materials/nodes/MeshLambertNodeMaterial.js:14:class MeshLambertNodeMaterial extends NodeMaterial {\nnode_modules/three/src/materials/nodes/MeshNormalNodeMaterial.js:19:class MeshNormalNodeMaterial extends NodeMaterial {\nnode_modules/three/src/materials/nodes/MeshMatcapNodeMaterial.js:17:class MeshMatcapNodeMaterial extends NodeMaterial {\nnode_modules/three/src/materials/nodes/MeshStandardNodeMaterial.js:19:class MeshStandardNodeMaterial extends NodeMaterial {\nnode_modules/three/src/materials/nodes/MeshToonNodeMaterial.js:4:import { MeshToonMaterial } from '../MeshToonMaterial.js';\nnode_modules/three/src/materials/nodes/MeshToonNodeMaterial.js:6:const _defaultValues = /*@__PURE__*/ new MeshToonMaterial();\nnode_modules/three/src/materials/nodes/MeshToonNodeMaterial.js:9: * Node material version of {@link MeshToonMaterial}.\nnode_modules/three/src/materials/nodes/MeshToonNodeMaterial.js:13:class MeshToonNodeMaterial extends NodeMaterial {\nnode_modules/three/src/materials/nodes/MeshToonNodeMaterial.js:17:\t\treturn 'MeshToonNodeMaterial';\nnode_modules/three/src/materials/nodes/MeshToonNodeMaterial.js:37:\t\tthis.isMeshToonNodeMaterial = true;\nnode_modules/three/src/materials/nodes/MeshToonNodeMaterial.js:66:export default MeshToonNodeMaterial;\nnode_modules/three/src/materials/nodes/MeshSSSNodeMaterial.js:75:class MeshSSSNodeMaterial extends MeshPhysicalNodeMaterial {\nnode_modules/three/src/materials/nodes/NodeMaterials.js:16:export { default as MeshToonNodeMaterial } from './MeshToonNodeMaterial.js';\nexport const cameraPosition = TSL.cameraPosition;\nexport const normalWorld = TSL.normalWorld;\nexport const normalWorldGeometry = TSL.normalWorldGeometry;\nexport const positionWorld = TSL.positionWorld;\nexport const positionWorldDirection = TSL.positionWorldDirection;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > core.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nexport const DEFAULTS={enemyDamage:9,enemyRate:1,turnSpeed:1.45,aimAssist:.965,energyDrain:1,weaponDamage:26};\nexport const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nexport const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y,a.z-b.z);\nexport class Campaign{\n constructor(event=()=>{}){this.event=event;this.tuning={...DEFAULTS};this.god=false;this.reset();}\n reset(){if(this.world)this.world.free();this.world=new RAPIER.World({x:0,y:0,z:0});this.events=new RAPIER.EventQueue(true);this.world.timestep=1/60;this.time=0;this.score=0;this.kills=0;this.shots=0;this.hits=0;this.jumps=0;this.docks=0;this.missiles=6;this.energy=100;this.hull=100;this.shield=100;this.shields=true;this.heat=0;this.cooldown=0;this.missileCooldown=0;this.hurt=0;this.throttle=.25;this.yaw=0;this.pitch=0;this.roll=0;this.jump=null;this.docking=0;this.docked=false;this.won=false;this.lost=false;this.running=false;this.attract=false;this.autopilot=false;this.bullets=[];this.enemies=[];this.colliderMap=new Map;this.effects=[];this.target=null;this.targetIndex=0;this.bases=[{sector:16,name:'KESTREL',health:100},{sector:9,name:'LANTERN',health:100}];this.roster={11:['scout','scout','scout'],7:['raider','raider','scout'],3:['bomber','bomber','scout','scout'],4:['flagship','raider','raider']};this.sectors=Array.from({length:20},(_,i)=>({id:i,name:['CINDER','VEIL','SHARD','IRON WAKE','CROWN','DRIFT','EMBER','GLASS','HOLLOW','LANTERN','DUSK','RAZOR','ECHO','RIFT','QUILL','WISP','KESTREL','HALO','SABLE','TIDE'][i],storm:[2,8,13,18].includes(i),visited:false}));this.player=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0,0,0).setLinearDamping(.8).setEnabledRotations(false,false,false).setCcdEnabled(true));const c=this.world.createCollider(RAPIER.ColliderDesc.ball(5).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),this.player);this.colliderMap.set(c.handle,{type:'player'});this.enterSector(11);}\n get position(){return this.player.translation();}\n get remaining(){return Object.values(this.roster).reduce((n,a)=>n+a.length,0);}\n get aliveBases(){return this.bases.filter(b=>b.health>0).length;}\n get base(){return this.bases.find(b=>b.sector===this.sector&&b.health>0);}\n get forward(){return {x:-Math.sin(this.yaw)*Math.cos(this.pitch),y:Math.sin(this.pitch),z:-Math.cos(this.yaw)*Math.cos(this.pitch)};}\n launch(attract=false){this.reset();this.running=true;this.attract=attract;this.event('sector',{id:this.sector});this.say('COMMAND','Patrol 07. Three contacts in Razor. Keep our starbases burning bright.');}\n say(speaker,text){this.event('message',{speaker,text});}\n enterSector(id){for(const e of this.enemies){this.colliderMap.delete(e.collider.handle);this.world.removeRigidBody(e.body);}for(const b of this.bullets){this.colliderMap.delete(b.collider.handle);this.world.removeRigidBody(b.body);}this.bullets=[];this.enemies=[];this.target=null;this.sector=id;this.sectors[id].visited=true;this.player.setTranslation({x:0,y:0,z:0},true);this.player.setLinvel({x:0,y:0,z:0},true);this.yaw=0;this.pitch=0;this.docked=false;this.docking=0;this.roster[id]?.forEach((type,i)=>this.spawnEnemy(type,i));this.stationPosition={x:0,y:0,z:-420};this.event('sector',{id});if(this.enemies.length)this.target=this.enemies[0];}\n spawnEnemy(type,i){const flagship=type==='flagship';const p={x:(i-((this.roster[this.sector]?.length||1)-1)/2)*100,y:(i%2)*65-20,z:-360-i*90};const body=this.world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(p.x,p.y,p.z));const collider=this.world.createCollider(RAPIER.ColliderDesc.ball(flagship?42:type==='bomber'?19:14).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);const e={id:\"'`${this.sector}-${i}-${Math.random()}`,type,body,collider,hp:flagship?650:type==='\"'bomber'?130:type==='raider'?100:65,maxHp:flagship?650:type==='bomber'?130:type==='raider'?100:65,phase:i*2.1,cool:2+i*.8,dead:false};this.colliderMap.set(collider.handle,{type:'enemy',entity:e});this.enemies.push(e);this.event('spawn',e);return e;}\n aimTarget(){const p=this.position,f=this.forward;let best=null,dot=this.tuning.aimAssist;for(const e of this.enemies){if(e.dead)continue;const q=e.body.translation(),l=dist(q,p),d=((q.x-p.x)*f.x+(q.y-p.y)*f.y+(q.z-p.z)*f.z)/l;if(d>dot){dot=d;best=e;}}return best;}\n cycleTarget(){const alive=this.enemies.filter(e=>\"'!e.dead);if(!alive.length){this.target=null;return;}this.target=alive[(alive.indexOf(this.target)+1)%alive.length];this.event('\"'sound','select');}\n projectile(owner,p,v,damage,missile=false){const body=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(p.x,p.y,p.z).setLinvel(v.x,v.y,v.z).setCcdEnabled(true).setGravityScale(0));const collider=this.world.createCollider(RAPIER.ColliderDesc.ball(missile?4:owner==='player'?2.6:3.8).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);const b={body,collider,owner,damage,life:missile?6:2.8,missile,target:missile?this.target:null,dead:false};this.bullets.push(b);this.colliderMap.set(collider.handle,{type:'bullet',entity:b});this.event('shot',b);}\n fire(){if(\"'!this.running||this.jump||this.docked||this.cooldown>0||this.heat>94||this.energy<1)return false;this.cooldown=.125;this.heat+=6.5;this.energy-=.32*this.tuning.energyDrain;this.shots++;const p=this.position;let f=this.forward;const a=this.aimTarget();if(a){const q=a.body.translation(),l=dist(q,p);f={x:(q.x-p.x)/l,y:(q.y-p.y)/l,z:(q.z-p.z)/l};}const side=this.shots%2?1:-1;this.projectile('\"'player',{x:p.x+f.x*12+Math.cos(this.yaw)*side*3,y:p.y+f.y*12-1,z:p.z+f.z*12-Math.sin(this.yaw)*side*3},{x:f.x*900,y:f.y*900,z:f.z*900},this.tuning.weaponDamage);this.event('sound','laser');return true;}\n missile(){if(\"'!this.running||this.missileCooldown>0||this.missiles<1||!this.target||this.target.dead||this.jump)return false;const p=this.position,f=this.forward;this.projectile('\"'player',{x:p.x+f.x*14,y:p.y-3,z:p.z+f.z*14},{x:f.x*300,y:f.y*300,z:f.z*300},180,true);this.missiles--;this.missileCooldown=1.2;this.event('sound','missile');return true;}\n toggleShield(){this.shields=\"'!this.shields;this.event('\"'sound','shield');this.say('SYSTEMS',this.shields?'Deflectors online.':'Deflectors offline. Energy recharge increased.');}\n beginJump(id){if(\"'!this.running||this.jump||id===this.sector||this.lost||this.won)return false;const cost=this.jumpCost(id);if(this.energy<cost){this.say('\"'SYSTEMS','Insufficient energy. Lower deflectors or seek a starbase.');return false;}this.jump={to:id,t:0,alignment:0};this.event('sound','jump');this.say('NAVIGATION','Hyperspace corridor acquired. Hold the flight marker inside the ring.');return true;}\n jumpCost(id){return Math.round(8+Math.hypot(id%5-this.sector%5,Math.floor(id/5)-Math.floor(this.sector/5))*2.5);}\n damage(amount){if(this.god||this.attract||this.won||this.lost)return;this.hurt=3;let d=amount;if(this.shields&&this.energy>0){const absorbed=Math.min(this.shield,d);this.shield-=absorbed;this.energy=Math.max(0,this.energy-absorbed*.09);d-=absorbed;}this.hull=clamp(this.hull-d,0,100);this.event('damage',amount);this.event('sound','hit');if(this.hull<=0)this.finish(false);}\n kill(e){if(e.dead)return;e.dead=true;this.kills++;this.score+=e.type==='flagship'?2400:e.type==='bomber'?450:e.type==='raider'?300:200;const r=this.roster[this.sector];r.splice(r.indexOf(e.type),1);this.event('explosion',{position:{...e.body.translation()},big:e.type==='flagship'});this.event('sound','explode');if(this.target===e)this.target=this.enemies.find(x=>\"'!x.dead)||null;if(!r.length){this.score+=500;this.bases.forEach(b=>b.health=Math.min(100,b.health+10));this.say('\"'COMMAND',this.remaining?'Sector secure. Open the tactical chart and choose your next jump.':'All contacts eliminated. The frontier is yours.');if(\"'!this.remaining)this.finish(true);}else if(e.type==='\"'flagship')this.say('COMMAND','Command ship destroyed\"'! Sweep up the remaining hostiles.'\"');}\n finish(won){if(this.won||this.lost)return;this.won=won;this.lost=\"'!won;this.running=false;if(won)this.score+=Math.round(this.hull*10+this.aliveBases*500);this.event('\"'finish',{won,score:this.score});this.event('sound',won?'victory':'alarm');}\n update(dt,input={}){if(\"'!this.running)return;dt=Math.min(dt,.05);this.time+=dt;this.cooldown=Math.max(0,this.cooldown-dt);this.missileCooldown=Math.max(0,this.missileCooldown-dt);this.hurt=Math.max(0,this.hurt-dt);this.heat=Math.max(0,this.heat-25*dt);if(this.god||this.attract){this.energy=100;this.hull=100;this.shield=100;this.missiles=Math.max(6,this.missiles);}if(this.jump){this.jump.t+=dt;this.jump.alignment=clamp(this.jump.alignment+dt*(Math.abs(input.yaw||0)+Math.abs(input.pitch||0)<.75?1:-.8),0,3);if(this.jump.t>4){const to=this.jump.to,steady=this.jump.alignment>2;this.energy-=this.jumpCost(to);this.jumps++;this.jump=null;this.enterSector(to);this.score+=steady?120:0;this.say('\"'NAVIGATION',steady?'Clean transit. Long-range scan complete.':'Rough transit. All systems responding.');}return;}\n const p=this.position;this.yaw+=(input.yaw||0)*this.tuning.turnSpeed*dt;this.pitch=clamp(this.pitch+(input.pitch||0)*this.tuning.turnSpeed*dt,-1.48,1.48);this.throttle=clamp(this.throttle+(input.thrust||0)*dt*.5,0,1);const boosting=input.boost&&this.energy>5;const speed=this.docked?0:(12+this.throttle*92)*(boosting?2.6:1);const f=this.forward;const right={x:Math.cos(this.yaw),y:0,z:-Math.sin(this.yaw)};this.player.setLinvel({x:f.x*speed+right.x*(input.strafe||0)*45,y:f.y*speed,z:f.z*speed+right.z*(input.strafe||0)*45},true);this.energy=clamp(this.energy+dt*((this.shields?.22:1.7)-(boosting?3.7:0)-speed*.0015)*this.tuning.energyDrain,0,100);if(this.shields&&this.hurt===0&&this.energy>5)this.shield=Math.min(100,this.shield+dt*3);if(input.fire)this.fire();\n if(this.base&&dist(p,this.stationPosition)<115&&this.throttle<.32){this.docking+=dt;if(this.docking>=3&&\"'!this.docked){this.docked=true;this.docks++;this.hull=100;this.shield=100;this.energy=100;this.missiles=6;this.score+=250;this.event('\"'sound','dock');this.say('KESTREL OPS','Service complete. Hull sealed. Cells charged. Good hunting, patrol.');}if(this.docked&&input.thrust>0){this.docked=false;this.docking=0;this.player.setTranslation({x:p.x+90,y:p.y,z:p.z},true);}}else this.docking=0;\n for(const base of this.bases){if(base.health>0&&this.remaining>0){base.health=Math.max(0,base.health-dt*(this.roster[3]?.length? .07:.025));if(base.health===0){this.say('COMMAND',\"'`${base.name} has gone dark. Protect the other station.`);this.event('\"'sound','alarm');}}}if(\"'!this.aliveBases)this.finish(false);\n for(const e of this.enemies){if(e.dead)continue;const q=e.body.translation(),d=dist(q,p);e.phase+=dt*(e.type==='\"'flagship'?.12:e.type==='bomber'?.24:.42);let desired;if(e.type==='flagship'){desired={x:p.x+Math.sin(e.phase)*280,y:p.y+60,z:p.z-480};}else{const r=e.type==='bomber'?370:230;desired={x:p.x+Math.sin(e.phase)*r,y:p.y+Math.sin(e.phase*.71)*95,z:p.z-Math.cos(e.phase)*r};}const lerp=dt*(e.type==='flagship'?.13:.28);e.body.setNextKinematicTranslation({x:q.x+(desired.x-q.x)*lerp,y:q.y+(desired.y-q.y)*lerp,z:q.z+(desired.z-q.z)*lerp});e.cool-=dt*this.tuning.enemyRate;if(e.cool<0&&d<1000){e.cool=(e.type==='flagship'?1.05:e.type==='bomber'?2.7:2.4)+Math.random();const l=d||1;const spread=e.type==='flagship'?4:12;const aim={x:p.x+(Math.random()-.5)*spread,y:p.y+(Math.random()-.5)*spread,z:p.z};const dir={x:(aim.x-q.x)/l,y:(aim.y-q.y)/l,z:(aim.z-q.z)/l};this.projectile('enemy',{x:q.x+dir.x*50,y:q.y+dir.y*50,z:q.z+dir.z*50},{x:dir.x*230,y:dir.y*230,z:dir.z*230},this.tuning.enemyDamage);}if(d<22&&e.type\"'!=='\"'flagship')this.damage(dt*6);}\n for(const b of this.bullets){b.life-=dt;if(b.missile&&b.target&&\"'!b.target.dead){const q=b.body.translation(),t=b.target.body.translation(),l=dist(q,t)||1;b.body.setLinvel({x:(t.x-q.x)/l*420,y:(t.y-q.y)/l*420,z:(t.z-q.z)/l*420},true);}}\n this.world.timestep=dt;this.world.step(this.events);this.events.drainCollisionEvents((a,b,started)=>{if(!started)return;const A=this.colliderMap.get(a),B=this.colliderMap.get(b);if(!A||!B)return;const shot=A.type==='\"'bullet'?A.entity:B.type==='bullet'?B.entity:null;const hit=A.type==='bullet'?B:A;if(\"'!shot||shot.dead)return;if(shot.owner==='\"'player'&&hit.type==='enemy'&&\"'!hit.entity.dead){shot.dead=true;hit.entity.hp-=shot.damage;this.hits++;this.event('\"'impact',{position:{...shot.body.translation()}});this.event('sound','hit');if(hit.entity.hp<=0)this.kill(hit.entity);}if(shot.owner==='enemy'&&hit.type==='player'){shot.dead=true;this.damage(shot.damage);}});\n // Swept proximity protects very fast sensor projectiles between physics ticks.\n for(const b of this.bullets){if(b.dead)continue;const q=b.body.translation();if(b.owner==='player'){for(const e of this.enemies){if(e.dead)continue;const t=e.body.translation();if(dist(q,t)<(e.type==='flagship'?44:e.type==='bomber'?22:17)){b.dead=true;e.hp-=b.damage;this.hits++;this.event('impact',{position:{...q}});if(e.hp<=0)this.kill(e);break;}}}else if(dist(q,this.position)<9){b.dead=true;this.damage(b.damage);}}\n for(let i=this.bullets.length-1;i>=0;i--){const b=this.bullets[i];if(b.dead||b.life<=0){this.event('removeShot',b);this.colliderMap.delete(b.collider.handle);this.world.removeRigidBody(b.body);this.bullets.splice(i,1);}}for(let i=this.enemies.length-1;i>=0;i--){const e=this.enemies[i];if(e.dead){this.event('removeEnemy',e);this.colliderMap.delete(e.collider.handle);this.world.removeRigidBody(e.body);this.enemies.splice(i,1);}}\n }\n snapshot(){const p=this.position;return {sector:this.sector,x:p.x,y:p.y,z:p.z,yaw:this.yaw,pitch:this.pitch,shooting:this.cooldown>.05,kills:this.kills};}\n debug(){return {running:this.running,won:this.won,lost:this.lost,sector:this.sector,enemies:this.enemies.length,remaining:this.remaining,kills:this.kills,score:this.score,hull:this.hull,shield:this.shield,energy:this.energy,heat:this.heat,jumps:this.jumps,docks:this.docks,missiles:this.missiles,time:this.time,position:{...this.position},physics:'rapier 0.19.3',tuning:{...this.tuning}};}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > core.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nexport const DEFAULTS={enemyDamage:9,enemyRate:1,turnSpeed:1.45,aimAssist:.965,energyDrain:1,weaponDamage:26};\nexport const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nexport const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y,a.z-b.z);\nexport class Campaign{\n constructor(event=()=>{}){this.event=event;this.tuning={...DEFAULTS};this.god=false;this.reset();}\n reset(){if(this.world)this.world.free();this.world=new RAPIER.World({x:0,y:0,z:0});this.events=new RAPIER.EventQueue(true);this.world.timestep=1/60;this.time=0;this.score=0;this.kills=0;this.shots=0;this.hits=0;this.jumps=0;this.docks=0;this.missiles=6;this.energy=100;this.hull=100;this.shield=100;this.shields=true;this.heat=0;this.cooldown=0;this.missileCooldown=0;this.hurt=0;this.throttle=.25;this.yaw=0;this.pitch=0;this.roll=0;this.jump=null;this.docking=0;this.docked=false;this.won=false;this.lost=false;this.running=false;this.attract=false;this.autopilot=false;this.bullets=[];this.enemies=[];this.colliderMap=new Map;this.effects=[];this.target=null;this.targetIndex=0;this.bases=[{sector:16,name:'KESTREL',health:100},{sector:9,name:'LANTERN',health:100}];this.roster={11:['scout','scout','scout'],7:['raider','raider','scout'],3:['bomber','bomber','scout','scout'],4:['flagship','raider','raider']};this.sectors=Array.from({length:20},(_,i)=>({id:i,name:['CINDER','VEIL','SHARD','IRON WAKE','CROWN','DRIFT','EMBER','GLASS','HOLLOW','LANTERN','DUSK','RAZOR','ECHO','RIFT','QUILL','WISP','KESTREL','HALO','SABLE','TIDE'][i],storm:[2,8,13,18].includes(i),visited:false}));this.player=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0,0,0).setLinearDamping(.8).setEnabledRotations(false,false,false).setCcdEnabled(true));const c=this.world.createCollider(RAPIER.ColliderDesc.ball(5).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),this.player);this.colliderMap.set(c.handle,{type:'player'});this.enterSector(11);}\n get position(){return this.player.translation();}\n get remaining(){return Object.values(this.roster).reduce((n,a)=>n+a.length,0);}\n get aliveBases(){return this.bases.filter(b=>b.health>0).length;}\n get base(){return this.bases.find(b=>b.sector===this.sector&&b.health>0);}\n get forward(){return {x:-Math.sin(this.yaw)*Math.cos(this.pitch),y:Math.sin(this.pitch),z:-Math.cos(this.yaw)*Math.cos(this.pitch)};}\n launch(attract=false){this.reset();this.running=true;this.attract=attract;this.event('sector',{id:this.sector});this.say('COMMAND','Patrol 07. Three contacts in Razor. Keep our starbases burning bright.');}\n say(speaker,text){this.event('message',{speaker,text});}\n enterSector(id){for(const e of this.enemies){this.colliderMap.delete(e.collider.handle);this.world.removeRigidBody(e.body);}for(const b of this.bullets){this.colliderMap.delete(b.collider.handle);this.world.removeRigidBody(b.body);}this.bullets=[];this.enemies=[];this.target=null;this.sector=id;this.sectors[id].visited=true;this.player.setTranslation({x:0,y:0,z:0},true);this.player.setLinvel({x:0,y:0,z:0},true);this.yaw=0;this.pitch=0;this.docked=false;this.docking=0;this.roster[id]?.forEach((type,i)=>this.spawnEnemy(type,i));this.stationPosition={x:0,y:0,z:-420};this.event('sector',{id});if(this.enemies.length)this.target=this.enemies[0];}\n spawnEnemy(type,i){const flagship=type==='flagship';const p={x:(i-((this.roster[this.sector]?.length||1)-1)/2)*100,y:(i%2)*65-20,z:-360-i*90};const body=this.world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(p.x,p.y,p.z));const collider=this.world.createCollider(RAPIER.ColliderDesc.ball(flagship?42:type==='bomber'?19:14).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);const e={id:\"'`${this.sector}-${i}-${Math.random()}`,type,body,collider,hp:flagship?650:type==='\"'bomber'?130:type==='raider'?100:65,maxHp:flagship?650:type==='bomber'?130:type==='raider'?100:65,phase:i*2.1,cool:2+i*.8,dead:false};this.colliderMap.set(collider.handle,{type:'enemy',entity:e});this.enemies.push(e);this.event('spawn',e);return e;}\n aimTarget(){const p=this.position,f=this.forward;let best=null,dot=this.tuning.aimAssist;for(const e of this.enemies){if(e.dead)continue;const q=e.body.translation(),l=dist(q,p),d=((q.x-p.x)*f.x+(q.y-p.y)*f.y+(q.z-p.z)*f.z)/l;if(d>dot){dot=d;best=e;}}return best;}\n cycleTarget(){const alive=this.enemies.filter(e=>\"'!e.dead);if(!alive.length){this.target=null;return;}this.target=alive[(alive.indexOf(this.target)+1)%alive.length];this.event('\"'sound','select');}\n projectile(owner,p,v,damage,missile=false){const body=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(p.x,p.y,p.z).setLinvel(v.x,v.y,v.z).setCcdEnabled(true).setGravityScale(0));const collider=this.world.createCollider(RAPIER.ColliderDesc.ball(missile?4:owner==='player'?2.6:3.8).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);const b={body,collider,owner,damage,life:missile?6:2.8,missile,target:missile?this.target:null,dead:false};this.bullets.push(b);this.colliderMap.set(collider.handle,{type:'bullet',entity:b});this.event('shot',b);}\n fire(){if(\"'!this.running||this.jump||this.docked||this.cooldown>0||this.heat>94||this.energy<1)return false;this.cooldown=.125;this.heat+=6.5;this.energy-=.32*this.tuning.energyDrain;this.shots++;const p=this.position;let f=this.forward;const a=this.aimTarget();if(a){const q=a.body.translation(),l=dist(q,p);f={x:(q.x-p.x)/l,y:(q.y-p.y)/l,z:(q.z-p.z)/l};}const side=this.shots%2?1:-1;this.projectile('\"'player',{x:p.x+f.x*12+Math.cos(this.yaw)*side*3,y:p.y+f.y*12-1,z:p.z+f.z*12-Math.sin(this.yaw)*side*3},{x:f.x*900,y:f.y*900,z:f.z*900},this.tuning.weaponDamage);this.event('sound','laser');return true;}\n missile(){if(\"'!this.running||this.missileCooldown>0||this.missiles<1||!this.target||this.target.dead||this.jump)return false;const p=this.position,f=this.forward;this.projectile('\"'player',{x:p.x+f.x*14,y:p.y-3,z:p.z+f.z*14},{x:f.x*300,y:f.y*300,z:f.z*300},180,true);this.missiles--;this.missileCooldown=1.2;this.event('sound','missile');return true;}\n toggleShield(){this.shields=\"'!this.shields;this.event('\"'sound','shield');this.say('SYSTEMS',this.shields?'Deflectors online.':'Deflectors offline. Energy recharge increased.');}\n beginJump(id){if(\"'!this.running||this.jump||id===this.sector||this.lost||this.won)return false;const cost=this.jumpCost(id);if(this.energy<cost){this.say('\"'SYSTEMS','Insufficient energy. Lower deflectors or seek a starbase.');return false;}this.jump={to:id,t:0,alignment:0};this.event('sound','jump');this.say('NAVIGATION','Hyperspace corridor acquired. Hold the flight marker inside the ring.');return true;}\n jumpCost(id){return Math.round(8+Math.hypot(id%5-this.sector%5,Math.floor(id/5)-Math.floor(this.sector/5))*2.5);}\n damage(amount){if(this.god||this.attract||this.won||this.lost)return;this.hurt=3;let d=amount;if(this.shields&&this.energy>0){const absorbed=Math.min(this.shield,d);this.shield-=absorbed;this.energy=Math.max(0,this.energy-absorbed*.09);d-=absorbed;}this.hull=clamp(this.hull-d,0,100);this.event('damage',amount);this.event('sound','hit');if(this.hull<=0)this.finish(false);}\n kill(e){if(e.dead)return;e.dead=true;this.kills++;this.score+=e.type==='flagship'?2400:e.type==='bomber'?450:e.type==='raider'?300:200;const r=this.roster[this.sector];r.splice(r.indexOf(e.type),1);this.event('explosion',{position:{...e.body.translation()},big:e.type==='flagship'});this.event('sound','explode');if(this.target===e)this.target=this.enemies.find(x=>\"'!x.dead)||null;if(!r.length){this.score+=500;this.bases.forEach(b=>b.health=Math.min(100,b.health+10));this.say('\"'COMMAND',this.remaining?'Sector secure. Open the tactical chart and choose your next jump.':'All contacts eliminated. The frontier is yours.');if(\"'!this.remaining)this.finish(true);}else if(e.type==='\"'flagship')this.say('COMMAND','Command ship destroyed\"'! Sweep up the remaining hostiles.'\"');}\n finish(won){if(this.won||this.lost)return;this.won=won;this.lost=\"'!won;this.running=false;if(won)this.score+=Math.round(this.hull*10+this.aliveBases*500);this.event('\"'finish',{won,score:this.score});this.event('sound',won?'victory':'alarm');}\n update(dt,input={}){if(\"'!this.running)return;dt=Math.min(dt,.05);this.time+=dt;this.cooldown=Math.max(0,this.cooldown-dt);this.missileCooldown=Math.max(0,this.missileCooldown-dt);this.hurt=Math.max(0,this.hurt-dt);this.heat=Math.max(0,this.heat-25*dt);if(this.god||this.attract){this.energy=100;this.hull=100;this.shield=100;this.missiles=Math.max(6,this.missiles);}if(this.jump){this.jump.t+=dt;this.jump.alignment=clamp(this.jump.alignment+dt*(Math.abs(input.yaw||0)+Math.abs(input.pitch||0)<.75?1:-.8),0,3);if(this.jump.t>4){const to=this.jump.to,steady=this.jump.alignment>2;this.energy-=this.jumpCost(to);this.jumps++;this.jump=null;this.enterSector(to);this.score+=steady?120:0;this.say('\"'NAVIGATION',steady?'Clean transit. Long-range scan complete.':'Rough transit. All systems responding.');}return;}\n const p=this.position;this.yaw+=(input.yaw||0)*this.tuning.turnSpeed*dt;this.pitch=clamp(this.pitch+(input.pitch||0)*this.tuning.turnSpeed*dt,-1.48,1.48);this.throttle=clamp(this.throttle+(input.thrust||0)*dt*.5,0,1);const boosting=input.boost&&this.energy>5;const speed=this.docked?0:(12+this.throttle*92)*(boosting?2.6:1);const f=this.forward;const right={x:Math.cos(this.yaw),y:0,z:-Math.sin(this.yaw)};this.player.setLinvel({x:f.x*speed+right.x*(input.strafe||0)*45,y:f.y*speed,z:f.z*speed+right.z*(input.strafe||0)*45},true);this.energy=clamp(this.energy+dt*((this.shields?.22:1.7)-(boosting?3.7:0)-speed*.0015)*this.tuning.energyDrain,0,100);if(this.shields&&this.hurt===0&&this.energy>5)this.shield=Math.min(100,this.shield+dt*3);if(input.fire)this.fire();\n if(this.base&&dist(p,this.stationPosition)<115&&this.throttle<.32){this.docking+=dt;if(this.docking>=3&&\"'!this.docked){this.docked=true;this.docks++;this.hull=100;this.shield=100;this.energy=100;this.missiles=6;this.score+=250;this.event('\"'sound','dock');this.say('KESTREL OPS','Service complete. Hull sealed. Cells charged. Good hunting, patrol.');}if(this.docked&&input.thrust>0){this.docked=false;this.docking=0;this.player.setTranslation({x:p.x+90,y:p.y,z:p.z},true);}}else this.docking=0;\n for(const base of this.bases){if(base.health>0&&this.remaining>0){base.health=Math.max(0,base.health-dt*(this.roster[3]?.length? .07:.025));if(base.health===0){this.say('COMMAND',\"'`${base.name} has gone dark. Protect the other station.`);this.event('\"'sound','alarm');}}}if(\"'!this.aliveBases)this.finish(false);\n for(const e of this.enemies){if(e.dead)continue;const q=e.body.translation(),d=dist(q,p);e.phase+=dt*(e.type==='\"'flagship'?.12:e.type==='bomber'?.24:.42);let desired;if(e.type==='flagship'){desired={x:p.x+Math.sin(e.phase)*280,y:p.y+60,z:p.z-480};}else{const r=e.type==='bomber'?370:230;desired={x:p.x+Math.sin(e.phase)*r,y:p.y+Math.sin(e.phase*.71)*95,z:p.z-Math.cos(e.phase)*r};}const lerp=dt*(e.type==='flagship'?.13:.28);e.body.setNextKinematicTranslation({x:q.x+(desired.x-q.x)*lerp,y:q.y+(desired.y-q.y)*lerp,z:q.z+(desired.z-q.z)*lerp});e.cool-=dt*this.tuning.enemyRate;if(e.cool<0&&d<1000){e.cool=(e.type==='flagship'?1.05:e.type==='bomber'?2.7:2.4)+Math.random();const l=d||1;const spread=e.type==='flagship'?4:12;const aim={x:p.x+(Math.random()-.5)*spread,y:p.y+(Math.random()-.5)*spread,z:p.z};const dir={x:(aim.x-q.x)/l,y:(aim.y-q.y)/l,z:(aim.z-q.z)/l};this.projectile('enemy',{x:q.x+dir.x*50,y:q.y+dir.y*50,z:q.z+dir.z*50},{x:dir.x*230,y:dir.y*230,z:dir.z*230},this.tuning.enemyDamage);}if(d<22&&e.type\"'!=='\"'flagship')this.damage(dt*6);}\n for(const b of this.bullets){b.life-=dt;if(b.missile&&b.target&&\"'!b.target.dead){const q=b.body.translation(),t=b.target.body.translation(),l=dist(q,t)||1;b.body.setLinvel({x:(t.x-q.x)/l*420,y:(t.y-q.y)/l*420,z:(t.z-q.z)/l*420},true);}}\n this.world.timestep=dt;this.world.step(this.events);this.events.drainCollisionEvents((a,b,started)=>{if(!started)return;const A=this.colliderMap.get(a),B=this.colliderMap.get(b);if(!A||!B)return;const shot=A.type==='\"'bullet'?A.entity:B.type==='bullet'?B.entity:null;const hit=A.type==='bullet'?B:A;if(\"'!shot||shot.dead)return;if(shot.owner==='\"'player'&&hit.type==='enemy'&&\"'!hit.entity.dead){shot.dead=true;hit.entity.hp-=shot.damage;this.hits++;this.event('\"'impact',{position:{...shot.body.translation()}});this.event('sound','hit');if(hit.entity.hp<=0)this.kill(hit.entity);}if(shot.owner==='enemy'&&hit.type==='player'){shot.dead=true;this.damage(shot.damage);}});\n // Swept proximity protects very fast sensor projectiles between physics ticks.\n for(const b of this.bullets){if(b.dead)continue;const q=b.body.translation();if(b.owner==='player'){for(const e of this.enemies){if(e.dead)continue;const t=e.body.translation();if(dist(q,t)<(e.type==='flagship'?44:e.type==='bomber'?22:17)){b.dead=true;e.hp-=b.damage;this.hits++;this.event('impact',{position:{...q}});if(e.hp<=0)this.kill(e);break;}}}else if(dist(q,this.position)<9){b.dead=true;this.damage(b.damage);}}\n for(let i=this.bullets.length-1;i>=0;i--){const b=this.bullets[i];if(b.dead||b.life<=0){this.event('removeShot',b);this.colliderMap.delete(b.collider.handle);this.world.removeRigidBody(b.body);this.bullets.splice(i,1);}}for(let i=this.enemies.length-1;i>=0;i--){const e=this.enemies[i];if(e.dead){this.event('removeEnemy',e);this.colliderMap.delete(e.collider.handle);this.world.removeRigidBody(e.body);this.enemies.splice(i,1);}}\n }\n snapshot(){const p=this.position;return {sector:this.sector,x:p.x,y:p.y,z:p.z,yaw:this.yaw,pitch:this.pitch,shooting:this.cooldown>.05,kills:this.kills};}\n debug(){return {running:this.running,won:this.won,lost:this.lost,sector:this.sector,enemies:this.enemies.length,remaining:this.remaining,kills:this.kills,score:this.score,hull:this.hull,shield:this.shield,energy:this.energy,heat:this.heat,jumps:this.jumps,docks:this.docks,missiles:this.missiles,time:this.time,position:{...this.position},physics:'rapier 0.19.3',tuning:{...this.tuning}};}\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > visuals.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nconst V=THREE.Vector3;\nlet seed=721;const rnd=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296;};\nexport class Visuals{\n constructor(canvas){this.canvas=canvas;this.scene=new THREE.Scene();this.scene.background=new THREE.Color('#080f20');this.scene.fog=new THREE.FogExp2('#0d1529',.000032);this.camera=new THREE.PerspectiveCamera(67,innerWidth/innerHeight,.05,18000);this.scene.add(this.camera);this.renderer=new THREE.WebGPURenderer({canvas,antialias:true,powerPreference:'high-performance'});this.renderer.setPixelRatio(Math.min(devicePixelRatio,2));this.renderer.setSize(innerWidth,innerHeight);this.renderer.toneMapping=THREE.ACESFilmicToneMapping;this.renderer.toneMappingExposure=1.22;this.mixers=[];this.enemyMeshes=new Map;this.shotMeshes=new Map;this.ghosts=new Map;this.particles=[];this.time=0;this.shake=0;this.makePalette();this.scene.add(new THREE.AmbientLight('#91a8c4',1.6));const sun=new THREE.DirectionalLight('#ffe1ad',3.3);sun.position.set(-600,500,200);this.scene.add(sun);const fill=new THREE.DirectionalLight('#5d8cdb',1.5);fill.position.set(500,-100,-200);this.scene.add(fill);this.makeSpace();this.station=this.makeStation();this.scene.add(this.station);this.makeCockpit();this.titleShips=new THREE.Group;for(let i=0;i<3;i++){const g=this.makeShip(i===0?'bomber':'scout');g.position.set(50+i*85,30-i*45,-260-i*75);g.rotation.set(.1,i*.35+2.9,-.18);this.titleShips.add(g);}this.scene.add(this.titleShips);window.addEventListener('resize',()=>this.resize());}\n async init(){await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'WebGPU':'WebGL compatibility';}\n makePalette(){const grad=new Uint8Array([55,75,99,130,164,191,225,237,242,255,255,255]);const tex=new THREE.DataTexture(grad,4,1,THREE.RGBFormat);tex.needsUpdate=true;tex.magFilter=THREE.NearestFilter;tex.minFilter=THREE.NearestFilter;this.materials={};for(const [name,color]of Object.entries({cream:'#e4d8b3',orange:'#e97442',red:'#be4938',navy:'#24374a',ink:'#09101c',teal:'#44baa8',gray:'#788893',gold:'#e4ad56',planet:'#c5714e'})){this.materials[name]=new THREE.MeshToonNodeMaterial({color,gradientMap:tex,flatShading:true});}this.materials.light=new THREE.MeshBasicNodeMaterial({color:'#b6ffdb'});this.materials.flame=new THREE.MeshBasicNodeMaterial({color:'#7fece0',transparent:true,opacity:.8});this.materials.enemyFlame=new THREE.MeshBasicNodeMaterial({color:'#ffb66b',transparent:true,opacity:.85});this.materials.line=new THREE.LineBasicMaterial({color:'#080d19'});}\n mesh(geo,mat='cream',edges=true){const m=new THREE.Mesh(geo,typeof mat==='string'?this.materials[mat]:mat);if(edges){const edge=new THREE.LineSegments(new THREE.EdgesGeometry(geo,23),this.materials.line);m.add(edge);}return m;}\n box(g,w,h,d,x,y,z,mat='cream'){const m=this.mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);g.add(m);return m;}\n makeShip(type='scout',ghost=false){const g=new THREE.Group;const boss=type==='flagship',bomber=type==='bomber';const hull=new THREE.BufferGeometry();hull.setAttribute('position',new THREE.Float32BufferAttribute([0,3,-25,-9,-2,14,9,-2,14, 0,3,-25,9,-2,14,0,7,12, 0,3,-25,0,7,12,-9,-2,14, -9,-2,14,0,7,12,9,-2,14],3));hull.computeVertexNormals();g.add(this.mesh(hull,ghost?'teal':boss?'navy':'orange'));this.box(g,8,3,11,0,5,-3,'ink');this.box(g,5,1,8,0,7,-4,'teal');for(const s of [-1,1]){const wing=new THREE.Group;wing.name=s<0?'port':'starboard';wing.position.set(s*7,-1,3);const w=this.mesh(new THREE.BoxGeometry(bomber?25:22,2,16),ghost?'teal':boss?'red':'cream');w.position.x=s*9;w.rotation.z=s*.17;wing.add(w);this.box(wing,3,6,20,s*19,-1,6,boss?'gold':'red');this.box(wing,2,2,29,s*17,0,-4,'ink');g.add(wing);const engine=this.mesh(new THREE.ConeGeometry(3,13,6),ghost?'flame':'enemyFlame',false);engine.position.set(s*7,0,21);engine.rotation.x=Math.PI/2;engine.name=s<0?'engineL':'engineR';g.add(engine);}this.box(g,2,9,10,0,10,11,'red');if(bomber){this.box(g,13,9,16,0,-5,5,'navy');for(const s of [-1,1])this.box(g,5,7,24,s*24,-4,0,'orange');g.scale.setScalar(1.3);}if(boss){g.scale.set(3.1,2.5,3);this.box(g,13,7,30,0,-5,5,'navy');for(const s of [-1,1]){this.box(g,5,5,20,s*22,6,8,'gold');this.box(g,2,2,18,s*22,6,-5,'ink');}}\n const mixer=new THREE.AnimationMixer(g);const clip=new THREE.AnimationClip('reactor & flight surfaces',1.6,[new THREE.NumberKeyframeTrack('port.rotation[z]',[0,.8,1.6],[-.05,.04,-.05]),new THREE.NumberKeyframeTrack('starboard.rotation[z]',[0,.8,1.6],[.05,-.04,.05]),new THREE.NumberKeyframeTrack('engineL.scale[y]',[0,.4,.8,1.2,1.6],[.8,1.3,.9,1.5,.8]),new THREE.NumberKeyframeTrack('engineR.scale[y]',[0,.4,.8,1.2,1.6],[1.2,.8,1.4,.9,1.2])]);mixer.clipAction(clip).play();this.mixers.push(mixer);g.userData.mixer=mixer;return g;}\n makeStation(){const g=new THREE.Group;const ring=new THREE.Group;ring.name='stationRing';const torus=this.mesh(new THREE.TorusGeometry(92,8,5,24),'cream');ring.add(torus);const inner=this.mesh(new THREE.TorusGeometry(76,2,4,24),'teal');ring.add(inner);for(let i=0;i<8;i++){const a=i*Math.PI/4;const spoke=this.mesh(new THREE.BoxGeometry(8,75,10),'navy');spoke.position.set(Math.sin(a)*48,Math.cos(a)*48,0);spoke.rotation.z=-a;ring.add(spoke);const pod=new THREE.Group;this.box(pod,24,19,42,0,0,0,i%2?'orange':'cream');this.box(pod,25,5,14,0,0,-23,'teal');pod.position.set(Math.sin(a)*94,Math.cos(a)*94,0);pod.rotation.z=-a;ring.add(pod);}g.add(ring);g.add(this.mesh(new THREE.IcosahedronGeometry(27,0),'gold'));this.box(g,17,17,86,0,0,-13,'navy');const gate=this.mesh(new THREE.TorusGeometry(21,2,4,8),'teal');gate.position.z=-60;g.add(gate);for(let i=0;i<3;i++){const panel=this.mesh(new THREE.BoxGeometry(75,32,2),'navy');panel.position.set(0,145+i*34,0);g.add(panel);this.box(g,3,125,4,0,155,0,'cream');for(let j=-3;j<=3;j++)this.box(g,1,30,3,j*10,145+i*34,0,'teal');}const mix=new THREE.AnimationMixer(g);mix.clipAction(new THREE.AnimationClip('habitat rotation',80,[new THREE.NumberKeyframeTrack('stationRing.rotation[z]',[0,80],[0,Math.PI*2])])).play();this.mixers.push(mix);g.position.set(0,0,-420);return g;}\n makeSpace(){const vertices=[],colors=[];for(let i=0;i<3200;i++){const u=rnd()*Math.PI*2,v=Math.acos(rnd()*2-1),r=7000+rnd()*3000;vertices.push(Math.sin(v)*Math.cos(u)*r,Math.cos(v)*r,Math.sin(v)*Math.sin(u)*r);const c=new THREE.Color().setHSL(.52+rnd()*.15,.1+rnd()*.2,.4+rnd()*.6);colors.push(c.r,c.g,c.b);}const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(vertices,3));geo.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));this.stars=new THREE.Points(geo,new THREE.PointsMaterial({size:9,sizeAttenuation:true,vertexColors:true}));this.scene.add(this.stars);\n this.planet=new THREE.Group;const sphere=this.mesh(new THREE.IcosahedronGeometry(1500,4),'planet',false);this.planet.add(sphere);const continents=new THREE.Group;for(let i=0;i<22;i++){const s=this.mesh(new THREE.IcosahedronGeometry(150+rnd()*230,1),i%3?'gold':'red',false);const a=rnd()*Math.PI*2,b=Math.acos(rnd()*2-1);s.position.set(Math.sin(b)*Math.cos(a)*1400,Math.cos(b)*1400,Math.sin(b)*Math.sin(a)*1400);s.scale.y=.4+rnd()*.35;continents.add(s);}this.planet.add(continents);const orbit=this.mesh(new THREE.TorusGeometry(2010,2.5,3,140),'gold',false);orbit.rotation.x=1.12;this.planet.add(orbit);const rim=this.mesh(new THREE.TorusGeometry(1510,11,3,100),'gold',false);this.planet.add(rim);this.planet.position.set(1900,900,-3800);this.planet.rotation.z=-.27;this.scene.add(this.planet);const moon=this.mesh(new THREE.IcosahedronGeometry(290,2),'gray');moon.position.set(-2100,1300,-4200);this.scene.add(moon);\n this.rocks=new THREE.Group;for(let i=0;i<65;i++){const r=7+rnd()*35;const rock=this.mesh(new THREE.IcosahedronGeometry(r,0),i%3?'navy':'gray');rock.position.set((rnd()-.5)*3500,(rnd()-.5)*2200,-200-rnd()*4000);rock.rotation.set(rnd()*3,rnd()*3,rnd()*3);rock.scale.set(1,.6+rnd(),.6+rnd());this.rocks.add(rock);}this.scene.add(this.rocks);\n this.jumpLines=new THREE.Group;for(let i=0;i<90;i++){const line=new THREE.Mesh(new THREE.BoxGeometry(.12,.12,25+rnd()*80),this.materials.flame);const a=rnd()*Math.PI*2,r=8+rnd()*32;line.position.set(Math.cos(a)*r,Math.sin(a)*r,-rnd()*160);this.jumpLines.add(line);}this.camera.add(this.jumpLines);this.jumpLines.visible=false;}\n makeCockpit(){this.cockpit=new THREE.Group;const g=this.cockpit;for(const s of [-1,1]){const rail=this.box(g,.1,.1,2.2,s*.83,-.5,-.4,'navy');rail.rotation.z=s*.3;const strut=this.box(g,.055,1.6,.07,s*1.05,.05,-1.15,'ink');strut.rotation.z=s*.37;this.box(g,.32,.12,1,s*.86,-.58,-1.4,'cream');this.box(g,.035,.024,.75,s*.78,-.51,-1.45,'teal');this.box(g,.2,.1,.2,s*.83,-.5,-1.82,'orange');}this.box(g,1.9,.13,.5,0,-.83,-.85,'navy');this.box(g,.22,.07,.3,0,-.74,-1.07,'orange');this.box(g,.12,.014,.12,0,-.7,-1.08,'teal');this.camera.add(g);g.visible=false;}\n addEnemy(e){const m=this.makeShip(e.type);this.enemyMeshes.set(e,m);this.scene.add(m);}\n removeEnemy(e){const m=this.enemyMeshes.get(e);if(m){this.scene.remove(m);this.stopMixer(m);this.enemyMeshes.delete(e);}}\n stopMixer(g){const m=g.userData.mixer;if(m){m.stopAllAction();m.uncacheRoot(g);this.mixers=this.mixers.filter(x=>x\"'!==m);}}\n shot(b){const m=this.mesh(new THREE.BoxGeometry(b.missile?2.5:1.1,b.missile?2.5:1.1,b.missile?10:22),b.owner==='\"'player'?'light':'enemyFlame',false);this.scene.add(m);this.shotMeshes.set(b,m);}\n removeShot(b){const m=this.shotMeshes.get(b);if(m){this.scene.remove(m);m.geometry.dispose();this.shotMeshes.delete(b);}}\n explode(position,big=false){const origin=new V(position.x,position.y,position.z);for(let i=0;i<(big?75:25);i++){const m=this.mesh(new THREE.IcosahedronGeometry(1.5+rnd()*4,0),i%3?'orange':'gold',false);m.position.copy(origin);this.scene.add(m);this.particles.push({mesh:m,v:new V((rnd()-.5)*130,(rnd()-.5)*130,(rnd()-.5)*130),life:.5+rnd()*1.2,max:1.7});}const ring=this.mesh(new THREE.TorusGeometry(1,1,4,32),'flame',false);ring.position.copy(origin);this.scene.add(ring);this.particles.push({mesh:ring,ring:true,life:.7,max:.7,v:new V()});}\n impact(position){for(let i=0;i<4;i++){const m=this.mesh(new THREE.OctahedronGeometry(2),'light',false);m.position.set(position.x,position.y,position.z);this.scene.add(m);this.particles.push({mesh:m,v:new V((rnd()-.5)*70,(rnd()-.5)*70,(rnd()-.5)*70),life:.25,max:.25});}}\n setSector(game){for(const [e]of this.enemyMeshes)if(\"'!game.enemies.includes(e))this.removeEnemy(e);for(const [b]of this.shotMeshes)if(!game.bullets.includes(b))this.removeShot(b);for(const e of game.enemies)if(!this.enemyMeshes.has(e))this.addEnemy(e);this.station.visible=!!game.base;this.station.position.set(0,0,-420);const storm=game.sectors[game.sector].storm;this.scene.background.set(storm?'\"'#1b1830':'#080f20');this.rocks.visible=\"'!game.base;}\n ghost(data,id){let entry=this.ghosts.get(id);if(!entry){const mesh=this.makeShip('\"'scout',true);this.scene.add(mesh);entry={mesh,data,last:performance.now()};this.ghosts.set(id,entry);}entry.data=data;entry.last=performance.now();}\n removeGhost(id){const e=this.ghosts.get(id);if(e){this.scene.remove(e.mesh);this.stopMixer(e.mesh);this.ghosts.delete(id);}}\n project(position){const v=new V(position.x,position.y,position.z).project(this.camera);return{x:(v.x*.5+.5)*innerWidth,y:(-.5*v.y+.5)*innerHeight,visible:v.z<1&&Math.abs(v.x)<.85&&Math.abs(v.y)<.85};}\n render(dt,game,title=false){this.time+=dt;for(const m of this.mixers)m.update(dt);this.planet.rotation.y+=dt*.008;this.titleShips.visible=title;this.cockpit.visible=\"'!title;this.jumpLines.visible=!!game.jump;\n if(title){this.station.visible=true;this.station.position.set(130,25,-400);this.station.rotation.y=.35+Math.sin(this.time*.12)*.12;this.camera.position.set(0,10,80);this.camera.lookAt(45,20,-450);this.titleShips.rotation.y=Math.sin(this.time*.13)*.09;this.titleShips.position.y=Math.sin(this.time*.4)*8;this.rocks.visible=true;}else{this.station.rotation.y=0;const p=game.position;this.camera.position.set(p.x,p.y+2,p.z);this.camera.rotation.order='\"'YXZ';this.camera.rotation.set(game.pitch,game.yaw,game.roll||0,'YXZ');this.shake=Math.max(0,this.shake-dt*2);if(this.shake>0){this.camera.position.x+=Math.sin(this.time*85)*this.shake;this.camera.position.y+=Math.cos(this.time*97)*this.shake;}for(const [e,m]of this.enemyMeshes){const q=e.body.translation();m.position.set(q.x,q.y,q.z);const dir=new V(p.x-q.x,p.y-q.y,p.z-q.z).normalize();m.quaternion.setFromUnitVectors(new V(0,0,-1),dir);m.rotateZ(Math.sin(this.time*.8+e.phase)*.18);}for(const [b,m]of this.shotMeshes){const p=b.body.translation(),v=b.body.linvel();m.position.set(p.x,p.y,p.z);m.quaternion.setFromUnitVectors(new V(0,0,1),new V(v.x,v.y,v.z).normalize());}for(const [id,e]of this.ghosts){e.mesh.visible=e.data.sector===game.sector&&performance.now()-e.last<6000;e.mesh.position.lerp(new V(e.data.x,e.data.y,e.data.z),Math.min(1,dt*12));e.mesh.rotation.set(e.data.pitch,e.data.yaw,0,'YXZ');}this.cockpit.rotation.z=Math.sin(game.yaw-this.camera.rotation.y)*.03;if(game.jump){for(const line of this.jumpLines.children){line.position.z+=dt*220;if(line.position.z>5)line.position.z=-170;}}}\n this.stars.position.copy(this.camera.position);for(let i=this.particles.length-1;i>=0;i--){const p=this.particles[i];p.life-=dt;if(p.life<0){this.scene.remove(p.mesh);p.mesh.geometry.dispose();this.particles.splice(i,1);continue;}p.mesh.position.addScaledVector(p.v,dt);if(p.ring)p.mesh.scale.setScalar((1-p.life/p.max)*150);else{p.mesh.rotation.x+=dt*3;p.mesh.scale.setScalar(Math.max(.01,p.life/p.max));}}this.renderer.render(this.scene,this.camera);}\n resize(){this.camera.aspect=innerWidth/innerHeight;this.camera.updateProjectionMatrix();this.renderer.setSize(innerWidth,innerHeight);}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > visuals.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nconst V=THREE.Vector3;\nlet seed=721;const rnd=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296;};\nexport class Visuals{\n constructor(canvas){this.canvas=canvas;this.scene=new THREE.Scene();this.scene.background=new THREE.Color('#080f20');this.scene.fog=new THREE.FogExp2('#0d1529',.000032);this.camera=new THREE.PerspectiveCamera(67,innerWidth/innerHeight,.05,18000);this.scene.add(this.camera);this.renderer=new THREE.WebGPURenderer({canvas,antialias:true,powerPreference:'high-performance'});this.renderer.setPixelRatio(Math.min(devicePixelRatio,2));this.renderer.setSize(innerWidth,innerHeight);this.renderer.toneMapping=THREE.ACESFilmicToneMapping;this.renderer.toneMappingExposure=1.22;this.mixers=[];this.enemyMeshes=new Map;this.shotMeshes=new Map;this.ghosts=new Map;this.particles=[];this.time=0;this.shake=0;this.makePalette();this.scene.add(new THREE.AmbientLight('#91a8c4',1.6));const sun=new THREE.DirectionalLight('#ffe1ad',3.3);sun.position.set(-600,500,200);this.scene.add(sun);const fill=new THREE.DirectionalLight('#5d8cdb',1.5);fill.position.set(500,-100,-200);this.scene.add(fill);this.makeSpace();this.station=this.makeStation();this.scene.add(this.station);this.makeCockpit();this.titleShips=new THREE.Group;for(let i=0;i<3;i++){const g=this.makeShip(i===0?'bomber':'scout');g.position.set(50+i*85,30-i*45,-260-i*75);g.rotation.set(.1,i*.35+2.9,-.18);this.titleShips.add(g);}this.scene.add(this.titleShips);window.addEventListener('resize',()=>this.resize());}\n async init(){await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'WebGPU':'WebGL compatibility';}\n makePalette(){const grad=new Uint8Array([55,75,99,130,164,191,225,237,242,255,255,255]);const tex=new THREE.DataTexture(grad,4,1,THREE.RGBFormat);tex.needsUpdate=true;tex.magFilter=THREE.NearestFilter;tex.minFilter=THREE.NearestFilter;this.materials={};for(const [name,color]of Object.entries({cream:'#e4d8b3',orange:'#e97442',red:'#be4938',navy:'#24374a',ink:'#09101c',teal:'#44baa8',gray:'#788893',gold:'#e4ad56',planet:'#c5714e'})){this.materials[name]=new THREE.MeshToonNodeMaterial({color,gradientMap:tex,flatShading:true});}this.materials.light=new THREE.MeshBasicNodeMaterial({color:'#b6ffdb'});this.materials.flame=new THREE.MeshBasicNodeMaterial({color:'#7fece0',transparent:true,opacity:.8});this.materials.enemyFlame=new THREE.MeshBasicNodeMaterial({color:'#ffb66b',transparent:true,opacity:.85});this.materials.line=new THREE.LineBasicMaterial({color:'#080d19'});}\n mesh(geo,mat='cream',edges=true){const m=new THREE.Mesh(geo,typeof mat==='string'?this.materials[mat]:mat);if(edges){const edge=new THREE.LineSegments(new THREE.EdgesGeometry(geo,23),this.materials.line);m.add(edge);}return m;}\n box(g,w,h,d,x,y,z,mat='cream'){const m=this.mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);g.add(m);return m;}\n makeShip(type='scout',ghost=false){const g=new THREE.Group;const boss=type==='flagship',bomber=type==='bomber';const hull=new THREE.BufferGeometry();hull.setAttribute('position',new THREE.Float32BufferAttribute([0,3,-25,-9,-2,14,9,-2,14, 0,3,-25,9,-2,14,0,7,12, 0,3,-25,0,7,12,-9,-2,14, -9,-2,14,0,7,12,9,-2,14],3));hull.computeVertexNormals();g.add(this.mesh(hull,ghost?'teal':boss?'navy':'orange'));this.box(g,8,3,11,0,5,-3,'ink');this.box(g,5,1,8,0,7,-4,'teal');for(const s of [-1,1]){const wing=new THREE.Group;wing.name=s<0?'port':'starboard';wing.position.set(s*7,-1,3);const w=this.mesh(new THREE.BoxGeometry(bomber?25:22,2,16),ghost?'teal':boss?'red':'cream');w.position.x=s*9;w.rotation.z=s*.17;wing.add(w);this.box(wing,3,6,20,s*19,-1,6,boss?'gold':'red');this.box(wing,2,2,29,s*17,0,-4,'ink');g.add(wing);const engine=this.mesh(new THREE.ConeGeometry(3,13,6),ghost?'flame':'enemyFlame',false);engine.position.set(s*7,0,21);engine.rotation.x=Math.PI/2;engine.name=s<0?'engineL':'engineR';g.add(engine);}this.box(g,2,9,10,0,10,11,'red');if(bomber){this.box(g,13,9,16,0,-5,5,'navy');for(const s of [-1,1])this.box(g,5,7,24,s*24,-4,0,'orange');g.scale.setScalar(1.3);}if(boss){g.scale.set(3.1,2.5,3);this.box(g,13,7,30,0,-5,5,'navy');for(const s of [-1,1]){this.box(g,5,5,20,s*22,6,8,'gold');this.box(g,2,2,18,s*22,6,-5,'ink');}}\n const mixer=new THREE.AnimationMixer(g);const clip=new THREE.AnimationClip('reactor & flight surfaces',1.6,[new THREE.NumberKeyframeTrack('port.rotation[z]',[0,.8,1.6],[-.05,.04,-.05]),new THREE.NumberKeyframeTrack('starboard.rotation[z]',[0,.8,1.6],[.05,-.04,.05]),new THREE.NumberKeyframeTrack('engineL.scale[y]',[0,.4,.8,1.2,1.6],[.8,1.3,.9,1.5,.8]),new THREE.NumberKeyframeTrack('engineR.scale[y]',[0,.4,.8,1.2,1.6],[1.2,.8,1.4,.9,1.2])]);mixer.clipAction(clip).play();this.mixers.push(mixer);g.userData.mixer=mixer;return g;}\n makeStation(){const g=new THREE.Group;const ring=new THREE.Group;ring.name='stationRing';const torus=this.mesh(new THREE.TorusGeometry(92,8,5,24),'cream');ring.add(torus);const inner=this.mesh(new THREE.TorusGeometry(76,2,4,24),'teal');ring.add(inner);for(let i=0;i<8;i++){const a=i*Math.PI/4;const spoke=this.mesh(new THREE.BoxGeometry(8,75,10),'navy');spoke.position.set(Math.sin(a)*48,Math.cos(a)*48,0);spoke.rotation.z=-a;ring.add(spoke);const pod=new THREE.Group;this.box(pod,24,19,42,0,0,0,i%2?'orange':'cream');this.box(pod,25,5,14,0,0,-23,'teal');pod.position.set(Math.sin(a)*94,Math.cos(a)*94,0);pod.rotation.z=-a;ring.add(pod);}g.add(ring);g.add(this.mesh(new THREE.IcosahedronGeometry(27,0),'gold'));this.box(g,17,17,86,0,0,-13,'navy');const gate=this.mesh(new THREE.TorusGeometry(21,2,4,8),'teal');gate.position.z=-60;g.add(gate);for(let i=0;i<3;i++){const panel=this.mesh(new THREE.BoxGeometry(75,32,2),'navy');panel.position.set(0,145+i*34,0);g.add(panel);this.box(g,3,125,4,0,155,0,'cream');for(let j=-3;j<=3;j++)this.box(g,1,30,3,j*10,145+i*34,0,'teal');}const mix=new THREE.AnimationMixer(g);mix.clipAction(new THREE.AnimationClip('habitat rotation',80,[new THREE.NumberKeyframeTrack('stationRing.rotation[z]',[0,80],[0,Math.PI*2])])).play();this.mixers.push(mix);g.position.set(0,0,-420);return g;}\n makeSpace(){const vertices=[],colors=[];for(let i=0;i<3200;i++){const u=rnd()*Math.PI*2,v=Math.acos(rnd()*2-1),r=7000+rnd()*3000;vertices.push(Math.sin(v)*Math.cos(u)*r,Math.cos(v)*r,Math.sin(v)*Math.sin(u)*r);const c=new THREE.Color().setHSL(.52+rnd()*.15,.1+rnd()*.2,.4+rnd()*.6);colors.push(c.r,c.g,c.b);}const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(vertices,3));geo.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));this.stars=new THREE.Points(geo,new THREE.PointsMaterial({size:9,sizeAttenuation:true,vertexColors:true}));this.scene.add(this.stars);\n this.planet=new THREE.Group;const sphere=this.mesh(new THREE.IcosahedronGeometry(1500,4),'planet',false);this.planet.add(sphere);const continents=new THREE.Group;for(let i=0;i<22;i++){const s=this.mesh(new THREE.IcosahedronGeometry(150+rnd()*230,1),i%3?'gold':'red',false);const a=rnd()*Math.PI*2,b=Math.acos(rnd()*2-1);s.position.set(Math.sin(b)*Math.cos(a)*1400,Math.cos(b)*1400,Math.sin(b)*Math.sin(a)*1400);s.scale.y=.4+rnd()*.35;continents.add(s);}this.planet.add(continents);const orbit=this.mesh(new THREE.TorusGeometry(2010,2.5,3,140),'gold',false);orbit.rotation.x=1.12;this.planet.add(orbit);const rim=this.mesh(new THREE.TorusGeometry(1510,11,3,100),'gold',false);this.planet.add(rim);this.planet.position.set(1900,900,-3800);this.planet.rotation.z=-.27;this.scene.add(this.planet);const moon=this.mesh(new THREE.IcosahedronGeometry(290,2),'gray');moon.position.set(-2100,1300,-4200);this.scene.add(moon);\n this.rocks=new THREE.Group;for(let i=0;i<65;i++){const r=7+rnd()*35;const rock=this.mesh(new THREE.IcosahedronGeometry(r,0),i%3?'navy':'gray');rock.position.set((rnd()-.5)*3500,(rnd()-.5)*2200,-200-rnd()*4000);rock.rotation.set(rnd()*3,rnd()*3,rnd()*3);rock.scale.set(1,.6+rnd(),.6+rnd());this.rocks.add(rock);}this.scene.add(this.rocks);\n this.jumpLines=new THREE.Group;for(let i=0;i<90;i++){const line=new THREE.Mesh(new THREE.BoxGeometry(.12,.12,25+rnd()*80),this.materials.flame);const a=rnd()*Math.PI*2,r=8+rnd()*32;line.position.set(Math.cos(a)*r,Math.sin(a)*r,-rnd()*160);this.jumpLines.add(line);}this.camera.add(this.jumpLines);this.jumpLines.visible=false;}\n makeCockpit(){this.cockpit=new THREE.Group;const g=this.cockpit;for(const s of [-1,1]){const rail=this.box(g,.1,.1,2.2,s*.83,-.5,-.4,'navy');rail.rotation.z=s*.3;const strut=this.box(g,.055,1.6,.07,s*1.05,.05,-1.15,'ink');strut.rotation.z=s*.37;this.box(g,.32,.12,1,s*.86,-.58,-1.4,'cream');this.box(g,.035,.024,.75,s*.78,-.51,-1.45,'teal');this.box(g,.2,.1,.2,s*.83,-.5,-1.82,'orange');}this.box(g,1.9,.13,.5,0,-.83,-.85,'navy');this.box(g,.22,.07,.3,0,-.74,-1.07,'orange');this.box(g,.12,.014,.12,0,-.7,-1.08,'teal');this.camera.add(g);g.visible=false;}\n addEnemy(e){const m=this.makeShip(e.type);this.enemyMeshes.set(e,m);this.scene.add(m);}\n removeEnemy(e){const m=this.enemyMeshes.get(e);if(m){this.scene.remove(m);this.stopMixer(m);this.enemyMeshes.delete(e);}}\n stopMixer(g){const m=g.userData.mixer;if(m){m.stopAllAction();m.uncacheRoot(g);this.mixers=this.mixers.filter(x=>x\"'!==m);}}\n shot(b){const m=this.mesh(new THREE.BoxGeometry(b.missile?2.5:1.1,b.missile?2.5:1.1,b.missile?10:22),b.owner==='\"'player'?'light':'enemyFlame',false);this.scene.add(m);this.shotMeshes.set(b,m);}\n removeShot(b){const m=this.shotMeshes.get(b);if(m){this.scene.remove(m);m.geometry.dispose();this.shotMeshes.delete(b);}}\n explode(position,big=false){const origin=new V(position.x,position.y,position.z);for(let i=0;i<(big?75:25);i++){const m=this.mesh(new THREE.IcosahedronGeometry(1.5+rnd()*4,0),i%3?'orange':'gold',false);m.position.copy(origin);this.scene.add(m);this.particles.push({mesh:m,v:new V((rnd()-.5)*130,(rnd()-.5)*130,(rnd()-.5)*130),life:.5+rnd()*1.2,max:1.7});}const ring=this.mesh(new THREE.TorusGeometry(1,1,4,32),'flame',false);ring.position.copy(origin);this.scene.add(ring);this.particles.push({mesh:ring,ring:true,life:.7,max:.7,v:new V()});}\n impact(position){for(let i=0;i<4;i++){const m=this.mesh(new THREE.OctahedronGeometry(2),'light',false);m.position.set(position.x,position.y,position.z);this.scene.add(m);this.particles.push({mesh:m,v:new V((rnd()-.5)*70,(rnd()-.5)*70,(rnd()-.5)*70),life:.25,max:.25});}}\n setSector(game){for(const [e]of this.enemyMeshes)if(\"'!game.enemies.includes(e))this.removeEnemy(e);for(const [b]of this.shotMeshes)if(!game.bullets.includes(b))this.removeShot(b);for(const e of game.enemies)if(!this.enemyMeshes.has(e))this.addEnemy(e);this.station.visible=!!game.base;this.station.position.set(0,0,-420);const storm=game.sectors[game.sector].storm;this.scene.background.set(storm?'\"'#1b1830':'#080f20');this.rocks.visible=\"'!game.base;}\n ghost(data,id){let entry=this.ghosts.get(id);if(!entry){const mesh=this.makeShip('\"'scout',true);this.scene.add(mesh);entry={mesh,data,last:performance.now()};this.ghosts.set(id,entry);}entry.data=data;entry.last=performance.now();}\n removeGhost(id){const e=this.ghosts.get(id);if(e){this.scene.remove(e.mesh);this.stopMixer(e.mesh);this.ghosts.delete(id);}}\n project(position){const v=new V(position.x,position.y,position.z).project(this.camera);return{x:(v.x*.5+.5)*innerWidth,y:(-.5*v.y+.5)*innerHeight,visible:v.z<1&&Math.abs(v.x)<.85&&Math.abs(v.y)<.85};}\n render(dt,game,title=false){this.time+=dt;for(const m of this.mixers)m.update(dt);this.planet.rotation.y+=dt*.008;this.titleShips.visible=title;this.cockpit.visible=\"'!title;this.jumpLines.visible=!!game.jump;\n if(title){this.station.visible=true;this.station.position.set(130,25,-400);this.station.rotation.y=.35+Math.sin(this.time*.12)*.12;this.camera.position.set(0,10,80);this.camera.lookAt(45,20,-450);this.titleShips.rotation.y=Math.sin(this.time*.13)*.09;this.titleShips.position.y=Math.sin(this.time*.4)*8;this.rocks.visible=true;}else{this.station.rotation.y=0;const p=game.position;this.camera.position.set(p.x,p.y+2,p.z);this.camera.rotation.order='\"'YXZ';this.camera.rotation.set(game.pitch,game.yaw,game.roll||0,'YXZ');this.shake=Math.max(0,this.shake-dt*2);if(this.shake>0){this.camera.position.x+=Math.sin(this.time*85)*this.shake;this.camera.position.y+=Math.cos(this.time*97)*this.shake;}for(const [e,m]of this.enemyMeshes){const q=e.body.translation();m.position.set(q.x,q.y,q.z);const dir=new V(p.x-q.x,p.y-q.y,p.z-q.z).normalize();m.quaternion.setFromUnitVectors(new V(0,0,-1),dir);m.rotateZ(Math.sin(this.time*.8+e.phase)*.18);}for(const [b,m]of this.shotMeshes){const p=b.body.translation(),v=b.body.linvel();m.position.set(p.x,p.y,p.z);m.quaternion.setFromUnitVectors(new V(0,0,1),new V(v.x,v.y,v.z).normalize());}for(const [id,e]of this.ghosts){e.mesh.visible=e.data.sector===game.sector&&performance.now()-e.last<6000;e.mesh.position.lerp(new V(e.data.x,e.data.y,e.data.z),Math.min(1,dt*12));e.mesh.rotation.set(e.data.pitch,e.data.yaw,0,'YXZ');}this.cockpit.rotation.z=Math.sin(game.yaw-this.camera.rotation.y)*.03;if(game.jump){for(const line of this.jumpLines.children){line.position.z+=dt*220;if(line.position.z>5)line.position.z=-170;}}}\n this.stars.position.copy(this.camera.position);for(let i=this.particles.length-1;i>=0;i--){const p=this.particles[i];p.life-=dt;if(p.life<0){this.scene.remove(p.mesh);p.mesh.geometry.dispose();this.particles.splice(i,1);continue;}p.mesh.position.addScaledVector(p.v,dt);if(p.ring)p.mesh.scale.setScalar((1-p.life/p.max)*150);else{p.mesh.rotation.x+=dt*3;p.mesh.scale.setScalar(Math.max(.01,p.life/p.max));}}this.renderer.render(this.scene,this.camera);}\n resize(){this.camera.aspect=innerWidth/innerHeight;this.camera.updateProjectionMatrix();this.renderer.setSize(innerWidth,innerHeight);}\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
