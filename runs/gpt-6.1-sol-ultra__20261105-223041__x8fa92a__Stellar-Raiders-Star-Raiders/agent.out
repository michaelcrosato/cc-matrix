{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js';s=open(p).read().replace(\\\"canvas.requestPointerLock?.();\\\", \\\"canvas.requestPointerLock?.()?.catch(()=>{pointer.inside=false;note('Mouse capture unavailable. Arrow keys also steer the ship.');});\\\")\ns=s.replace(\\\"window.addEventListener('mouseup',()=>pointer.fire=false);\\\", \\\"document.addEventListener('pointerlockchange',()=>{if(\"'!document.pointerLockElement){pointer.inside=false;pointer.fire=false;pointer.dx=pointer.dy=0;if(screen==='\"'flight'&&game?.running&&\"'!game.attract&&!hubEnded)openPause();}});window.addEventListener('\"'mouseup',()=>pointer.fire=false);\\\")\nopen(p,'w').write(s)\np='browser-test.py';s=open(p).read().replace(\\\"check('launch enters flight',state(page)['running'] and state(page)['screen']=='flight')\\\", \\\"check('launch enters flight',state(page)['running'] and state(page)['screen']=='flight')\\\\n  page.locator('#space').click(position={'x':720,'y':450});page.wait_for_function('\"'!!document.pointerLockElement'\"',timeout=10000)\\\\n  check('mouse capture on flight click',page.evaluate('document.pointerLockElement?.id')=='space')\\\\n  page.keyboard.press('Escape');page.wait_for_function('__stellar.state().screen===\\\\\\\\\\\\\\\"pause\\\\\\\\\\\\\\\"',timeout=10000)\\\\n  check('Escape releases mouse and pauses',not page.evaluate('\"'!!document.pointerLockElement'\"') and state(page)['screen']=='pause')\\\\n  page.locator('[data-action=resume]').click()\\\")\nopen(p,'w').write(s)\nPY\nnode --check main.js\npython3 -m py_compile browser-test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
