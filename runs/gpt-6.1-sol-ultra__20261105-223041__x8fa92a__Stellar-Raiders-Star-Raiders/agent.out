{"type":"item.completed","item":{"id":"item_14","type":"agent_message","text":"The campaign simulation now passes a full scripted patrol: all 13 enemies can be defeated with the flight controls, lasers, and homing torpedoes. Tests also cover docking, hyperspace, starbase loss, and victory. They caught a Rapier API mismatch and a physics-event cleanup leak; both are fixed. I’m now connecting the cockpit, controls, menus, and live tuning tools.\n"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {Campaign,DEFAULTS,clamp,dist} from './core.js';\nimport {Visuals} from './visuals.js';\nimport {AudioEngine} from './audio.js';\nimport {Network} from './network.js';\nconst \"'$=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"'\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst metadata=JSON.parse(\"'$('\"'creditsData').textContent);\nconst audio=new AudioEngine();\nlet game,visuals,net,ready=false,screen='title',lastInput='keyboard',lastActivity=performance.now(),messageUntil=0,selected=16,simSpeed=1,attractTime=0,attractStage=0,pausedFrom='title',modalTab='source',hubEnded=false,frameCount=0;\nlet settings={music:10,volume:75,sensitivity:1,glyphs:'playstation',reducedMotion:false};try{Object.assign(settings,JSON.parse(localStorage.getItem('stellar-settings')||'{}'));}catch{}\naudio.setMusic(settings.music/100);audio.setVolume(settings.volume/100);\nconst keys=new Set;const pointer={x:0,y:0,dx:0,dy:0,fire:false,inside:false};const touch={look:null,thrust:null,x:0,y:0,boost:false};let padButtons=[],padLastNav=0,lastPadAxes=[0,0,0,0];let debugInput=null;\nconst canvas=document.createElement('canvas');canvas.id='space';canvas.setAttribute('aria-label','Three-dimensional flight view');document.body.prepend(canvas);\nconst extra=document.createElement('style');extra.textContent=\"'`#space{position:fixed;inset:0;width:100%;height:100%;z-index:0;touch-action:none}.target-info{position:fixed!important;transform:translate(-50%,-50%);pointer-events:none;min-width:125px;text-align:center}.target-info .target-box{display:block;width:72px;height:58px;margin:0 auto 9px;border:2px solid var(--coral,#f08361);clip-path:polygon(0 0,28% 0,28% 3%,3% 3%,3% 28%,0 28%,0 0,100% 0,100% 28%,97% 28%,97% 3%,72% 3%,72% 0,100% 0,100% 100%,72% 100%,72% 97%,97% 97%,97% 72%,100% 72%,100% 100%,0 100%,0 72%,3% 72%,3% 97%,28% 97%,28% 100%,0 100%)}.target-info small{display:block;color:#ffb28b;font-size:13px;letter-spacing:.1em}.target-info.offscreen{top:35%!important;left:50%!important}.target-info.offscreen .target-box{border:0;clip-path:none;height:20px}.range-value{font-variant-numeric:tabular-nums;color:#cdf282}.sector-grid{grid-template-columns:repeat(5,minmax(0,1fr))!important}.sector-cell{min-height:80px;font-size:16px}.sector-cell b{font-size:23px;display:block}.sector-cell small{display:block;font-size:10px;letter-spacing:.08em}.sector-cell.current{box-shadow:inset 0 0 0 2px #d7ee9c}.sector-cell.danger b{color:#ef926e}.sector-cell.base b{color:#7cdbc7}.map-side h3{font-size:32px;margin:.25em 0}.map-side p{line-height:1.5;color:#bcc8cf}.brief-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.manual-key{display:inline-block;border:1px solid #6b828d;padding:2px 8px;color:#d8eea3;font-size:18px;min-width:32px;text-align:center}.modal-card .fine{font-size:14px;color:#91a5b1;line-height:1.5}.modal-card h2{font-size:clamp(28px,4vw,48px);margin:8px 0 22px}.modal-card p{line-height:1.5}.modal-card input[type=text]{font:inherit;background:#101d2d;border:1px solid #63798b;color:#e7eddf;padding:14px;width:190px;text-transform:uppercase}.credits{max-height:55vh;overflow:auto;padding-right:20px;font-size:17px;line-height:1.6}.credits dl{display:grid;grid-template-columns:150px 1fr;gap:8px 22px}.credits dt{color:#a9c0cc}.credits dd{margin:0}.credits p{border-bottom:1px solid #354455;padding:12px 0}.row{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:14px 0}.slider-row{display:grid;grid-template-columns:1fr 1.2fr 65px;gap:20px;align-items:center;margin:18px 0;font-size:18px}.slider-row input{width:100%;accent-color:#d7ee9c}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:24px 0}.stat-grid div{padding:18px;background:#132437;border-top:1px solid #738892}.stat-grid strong{display:block;color:#d7ee9c;font-size:38px}.stat-grid span{font-size:14px;color:#b0c3cb}.buttons{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}button:disabled{opacity:.4;cursor:default}.modal-card .button{min-height:48px}.brief-grid h3{color:#d7ee9c}.context-hint{font-size:18px;color:#d7ee9c}.dev-toggle{padding:12px;background:#1c3040}body.in-flight #space{cursor:crosshair}body.touch #targetInfo{font-size:13px}body.touch #comms{max-width:75%;bottom:65px}.reticle{top:50%!important}.jump-overlay{pointer-events:none}#touchMenu{z-index:35}#touchAction{z-index:35}.toast{z-index:90}.credits-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.credits-tabs button{font-size:15px;padding:8px 14px}.hud-top{pointer-events:none}.modal-card{max-height:90vh;overflow:auto}@media(max-width:700px){.brief-grid{grid-template-columns:1fr;gap:4px}.sector-cell{min-height:54px;padding:5px;font-size:12px}.sector-cell small{font-size:8px}.sector-cell b{font-size:17px}.credits dl{grid-template-columns:1fr;gap:3px}.credits dd{margin-bottom:12px}.slider-row{grid-template-columns:1fr 1fr 40px;font-size:14px;gap:8px}.stat-grid{gap:7px}.stat-grid div{padding:10px}.stat-grid strong{font-size:26px}}`;document.head.append(extra);\nfunction saveSettings(){try{localStorage.setItem('\"'stellar-settings',JSON.stringify(settings));}catch{}}\nfunction note(text){\"'$('\"'toast').textContent=text;\"'$('\"'toast').hidden=false;setTimeout(()=>\"'$('\"'toast').hidden=true,2600);}\nfunction activity(type='keyboard'){lastActivity=performance.now();lastInput=type;if(game?.attract){returnTitle();return true;}return false;}\nfunction promptText(){if(lastInput==='gamepad'){const ps=settings.glyphs==='playstation';return \"'`${ps?'\"'R2':'RT'} FIRE · \"'${ps?'\"'R1':'RB'} TORPEDO · \"'${ps?'\"'△':'Y'} CHART · \"'${ps?'\"'○':'B'} CONTEXT\"'`;}if(lastInput==='\"'touch')return 'DRAG LEFT TO STEER · RIGHT TO THRUST · AUTO FIRE';return 'LMB FIRE · R TORPEDO · M CHART · E SHIELDS · ESC PAUSE';}\nfunction setModal(name,html,wide=false){screen=name;\"'$('\"'modal').innerHTML=\"'`<section class=\"modal-card ${wide?'\"'wide':''}\\\">\"'${html}</section>`;$('\"'modal').hidden=false;if(document.pointerLockElement)document.exitPointerLock();pointer.fire=false;keys.clear();setTimeout(()=>{\"'$('\"'modal').querySelector('button:not(:disabled),input')?.focus({preventScroll:true});},20);}\nfunction closeModal(){screen=game.running?'flight':'title';\"'$('\"'modal').hidden=true;keys.clear();pointer.fire=false;lastActivity=performance.now();}\nconst backButton=(label='Back')=>\"'`<button class=\"button\" data-action=\"back\">← ${label}</button>`;\nfunction openPause(){if(!game.running||hubEnded)return;pausedFrom='\"'flight';setModal('pause',\"'`<div class=\"eyebrow\">PATROL ${String(game.sector+1).padStart(2,'\"'0')} / FLIGHT PAUSED</div><h2>Take a breath, pilot.</h2><p>One ship is still a fighting chance.</p><div class=\\\"buttons\\\"><button class=\\\"button primary\\\" data-action=\\\"resume\\\">Resume flight</button><button class=\\\"button\\\" data-action=\\\"map\\\">Sector chart</button><button class=\\\"button\\\" data-action=\\\"manual\\\">Flight manual</button><button class=\\\"button\\\" data-action=\\\"settings\\\">Settings</button><button class=\\\"button\\\" data-action=\\\"dev\\\">Dev flight deck</button><button class=\\\"button\\\" data-action=\\\"title\\\" \"'${net.active?'\"'disabled':''}>End patrol</button></div><p class=\\\"fine\\\">\"'${net.active?'\"'The Hub clock keeps running while your flight is paused.':net.status}</p>\"'`);}\nfunction openManual(){if(screen==='\"'title')pausedFrom='title';else if(screen==='flight')pausedFrom='flight';const pad=lastInput==='gamepad',ps=settings.glyphs==='playstation';setModal('manual',\"'`<div class=\"eyebrow\">FDC / PILOT FIELD NOTES</div><h2>Hold the frontier.</h2><div class=\"brief-grid\"><div><h3>01 / Hunt</h3><p>Destroy thirteen raiders across <b>Razor, Glass, Iron Wake and Crown</b>. The flagship at Crown carries heavy armour. Follow the target brackets; cycle your lock to find contacts behind you.</p><h3>02 / Navigate</h3><p>Open the sector chart, choose a destination, then engage hyperspace. Each transit uses energy. Keep the flight marker steady for a clean-jump bonus.</p><h3>03 / Come home</h3><p>Jump to Kestrel or Lantern. Approach the station within <b>115 units</b> and lower throttle below <b>32%</b>. Hold for three seconds to repair and reload. Throttle up to depart. Starbases suffer while the fleet survives.</p></div><div><h3>Flight controls</h3><p>${pad?`<span class=\"manual-key\">L</span> Steer &nbsp; <span class=\"manual-key\">R ↑↓</span> Throttle<br><span class=\"manual-key\">${ps?'\"'R2':'RT'}</span> Cannons &nbsp; <span class=\\\"manual-key\\\">\"'${ps?'\"'L2':'LT'}</span> Boost<br><span class=\\\"manual-key\\\">\"'${ps?'\"'R1':'RB'}</span> Homing torpedo<br><span class=\\\"manual-key\\\">\"'${ps?'\"'L1':'LB'}</span> Deflectors<br><span class=\\\"manual-key\\\">\"'${ps?'\"'□':'X'}</span> Cycle lock<br><span class=\\\"manual-key\\\">\"'${ps?'\"'△':'Y'}</span> Sector chart<br><span class=\\\"manual-key\\\">\"'${ps?'\"'○':'B'}</span> Context / dock approach<br><span class=\\\"manual-key\\\">Options</span> Pause\"'`:`<span class=\"manual-key\">Mouse</span> Steer; click flight view to capture<br><span class=\"manual-key\">W / S</span> Throttle<br><span class=\"manual-key\">A / D</span> Strafe<br><span class=\"manual-key\">LMB / Space</span> Cannons<br><span class=\"manual-key\">R / RMB</span> Homing torpedo<br><span class=\"manual-key\">Shift</span> Boost<br><span class=\"manual-key\">E</span> Deflectors<br><span class=\"manual-key\">T</span> Cycle lock<br><span class=\"manual-key\">M</span> Sector chart<br><span class=\"manual-key\">H</span> Context / dock approach<br><span class=\"manual-key\">Esc</span> Pause`}</p><p class=\"fine\">Touch: drag the left half to steer; drag the right half up/down for thrust. Cannons, targeting and torpedoes assist automatically. A context button appears near a station or after a sector is secure.</p><p class=\"fine\">Cannons build heat. Deflectors regenerate after a quiet moment. Lowering them recharges energy faster. Every starbase saved improves your final rating.</p></div></div><div class=\"buttons\">${backButton()}</div>`,true);}\nfunction openSettings(){if(screen==='\"'title')pausedFrom='title';else if(screen==='flight')pausedFrom='flight';setModal('settings',\"'`<div class=\"eyebrow\">FDC / PERSONAL FLIGHT PROFILE</div><h2>Make yourself at home.</h2><label class=\"slider-row\"><span>Music</span><input type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"${settings.music}\" data-setting=\"music\"><output>${settings.music}%</output></label><label class=\"slider-row\"><span>Sound & voice</span><input type=\"range\" min=\"0\" max=\"100\" value=\"${settings.volume}\" data-setting=\"volume\"><output>${settings.volume}%</output></label><label class=\"slider-row\"><span>Steering sensitivity</span><input type=\"range\" min=\"0.5\" max=\"2.5\" step=\"0.1\" value=\"${settings.sensitivity}\" data-setting=\"sensitivity\"><output>${settings.sensitivity}×</output></label><div class=\"row\"><span>Controller glyphs</span><button class=\"button\" data-action=\"glyphs\">${settings.glyphs==='\"'playstation'?'PlayStation: ✕ ○ □ △':'Xbox: A B X Y'}</button></div><div class=\\\"row\\\"><span>Reduced camera motion</span><button class=\\\"button\\\" data-action=\\\"motion\\\">\"'${settings.reducedMotion?'\"'ON':'OFF'}</button></div><div class=\\\"buttons\\\"><button class=\\\"button\\\" data-action=\\\"fullscreen\\\">Fullscreen</button>\"'${backButton()}</div>`);}\nfunction openMap(){if(!game.running)return;selected=game.energy<35?16:Number(Object.keys(game.roster).find(id=>game.roster[id].length&&+id!==game.sector)??16);screen='\"'map';drawMap();}\nfunction drawMap(){const s=game.sectors[selected],n=game.roster[selected]?.length||0,base=game.bases.find(b=>b.sector===selected);setModal('map',\"'`<div class=\"eyebrow\">GALACTIC CHART / ${game.aliveBases} STARBASES ONLINE</div><h2>Choose your next move.</h2><div class=\"map-layout\"><div><div class=\"sector-grid\">${game.sectors.map(s=>{const n=game.roster[s.id]?.length||0,b=game.bases.find(b=>b.sector===s.id);return `<button class=\"sector-cell ${s.id===selected?'\"'selected':''} \"'${s.id===game.sector?'\"'current':''} \"'${n?'\"'danger':''} \"'${b?'\"'base':''}\\\" data-action=\\\"sector\\\" data-sector=\\\"\"'${s.id}\" aria-label=\"${s.name}, ${n?'\"'hostiles '+n:b?'starbase':'clear space'}\\\"><small>\"'${String.fromCharCode(65+s.id%5)}${1+Math.floor(s.id/5)}</small><b>${s.id===game.sector?'\"'▵':n?'✦':b?'◇':s.storm?'≈':'·'}</b><small>\"'${n?`${n} HOSTILE`:b?b.name:s.name}</small></button>`;}).join('\"'')}</div><p class=\\\"fine\\\">▵ YOU &nbsp; ✦ RAIDERS &nbsp; ◇ STARBASE &nbsp; ≈ ION CLOUD</p></div><div class=\\\"map-side\\\"><div class=\\\"eyebrow\\\">SECTOR \"'${String.fromCharCode(65+selected%5)}${1+Math.floor(selected/5)}</div><h3>${s.name}</h3><p>${n?`${n} hostile ${n===1?'\"'vessel':'vessels'} detected.\"'${selected===4?'\"' Command signature confirmed. Bring torpedoes.':''}\"'`:base?`Starbase ${base.name}. ${Math.ceil(base.health)}% integrity. Full repair, energy and torpedo resupply.`:s.storm?'\"'Ion cloud. No hostile contacts. A quiet place to recharge with deflectors lowered.':'No hostile contacts. Frontier space under your protection.'}</p><p class=\\\"context-hint\\\">\"'${selected===game.sector?'\"'CURRENT SECTOR':\"'`TRANSIT COST ${game.jumpCost(selected)} / ENERGY ${Math.floor(game.energy)}`}</p><button class=\"button primary\" data-action=\"jump\" ${selected===game.sector||game.energy<game.jumpCost(selected)?'\"'disabled':''}>Engage hyperspace ↗</button></div></div><div class=\\\"buttons\\\"><button class=\\\"button\\\" data-action=\\\"resume\\\">Return to flight</button></div>\"'`,true);const focused=$('\"'modal').querySelector(\"'`[data-sector=\"${selected}\"]`);focused?.focus({preventScroll:true});}\nfunction openDev(){const rows=[['\"'enemyDamage','Enemy damage',0,25,1],['enemyRate','Enemy firing rate',.1,3,.1],['turnSpeed','Turn speed',.5,3,.05],['aimAssist','Aim assist cone',.9,.999,.001],['energyDrain','Energy use / recharge',.1,3,.1],['weaponDamage','Cannon damage',10,100,1]];setModal('dev',\"'`<div class=\"eyebrow\">DEVELOPMENT / LIVE FLIGHT DECK</div><h2>Fly. Break. Tune. Repeat.</h2>${rows.map(([key,label,min,max,step])=>`<label class=\"slider-row\"><span>${label}</span><input data-tune=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${game.tuning[key]}\"><output>${game.tuning[key]}</output></label>`).join('\"'')}<label class=\\\"slider-row\\\"><span>Simulation speed</span><input data-speed type=\\\"range\\\" min=\\\"0.25\\\" max=\\\"4\\\" step=\\\"0.25\\\" value=\\\"\"'${simSpeed}\"><output>${simSpeed}×</output></label><div class=\"buttons\"><button class=\"button\" data-action=\"god\">Invulnerable: ${game.god?'\"'ON':'OFF'}</button><button class=\\\"button\\\" data-action=\\\"resupply\\\">Repair & rearm</button><button class=\\\"button\\\" data-action=\\\"clear\\\">Clear sector</button><button class=\\\"button\\\" data-action=\\\"spawn\\\">Spawn raider</button><button class=\\\"button\\\" data-action=\\\"resetTune\\\">Reset defaults</button>\"'${backButton('\"'Pause menu')}</div><p class=\\\"fine\\\">All changes apply immediately. Dev assistance marks this patrol as a training flight.</p>\"'`,true);}\nfunction openOnline(){pausedFrom=game.running?'\"'flight':'title';setModal('online',\"'`<div class=\"eyebrow\">WING LINK / 1–4 PILOTS</div><h2>Never quite alone.</h2><p>Fly rival patrols across the same frontier. Other pilots appear as cyan ghost ships when you share a sector. Compare command points in AI Hub.</p><div class=\"brief-grid\"><div><h3>Across devices</h3><p>Launch this game together in an <b>AI Hub session</b>. The Hub handles invitations, countdowns, synchronized rounds and final standings.</p></div><div><h3>Local practice wing</h3><p>For two tabs in the same browser, open this same file or URL, then enter the same wing code.</p><div class=\"row\"><input id=\"roomCode\" type=\"text\" maxlength=\"8\" placeholder=\"WING CODE\" aria-label=\"Wing code\" value=\"${esc(net.room)}\"><button class=\"button\" data-action=\"joinRoom\">Link</button></div><button class=\"button\" data-action=\"hostRoom\">Generate wing code</button></div></div><p class=\"context-hint\" id=\"networkStatus\">${esc(net.status)}</p><div class=\"buttons\"><button class=\"button\" data-action=\"leaveRoom\" ${net.room?'\"'':'disabled'}>Disconnect local wing</button>\"'${backButton()}</div><p class=\"fine\">Ghost pilots have independent ships, enemies and scores. They cannot damage your ship. Local practice uses BroadcastChannel and does not cross devices.</p>`,true);}\nfunction openAbout(tab='\"'source'){modalTab=tab;pausedFrom=game.running?'flight':'title';const labels={source:'Source information',testing:'Testing feedback',engine:'Engine feedback',prompt:'Prompt feedback'};let content;if(tab==='source')content=\"'`<dl>${Object.entries(metadata.sourceInformation).map(([k,v])=>`<dt>${esc(k.replace(/([A-Z])/g,'\"' \"'$1'\"'))}</dt><dd>\"'${esc(v)}</dd>`).join('\"'')}</dl><p>Design, code, geometric art, synthesis & flight systems: OpenAI gpt-6.1-sol. Inspired by the pioneering cockpit and strategic-map spirit of Star Raiders. This is an original, unofficial game.</p><p>Open-source components: Three.js (MIT), Rapier (Apache-2.0), AI Hub session client. No external images, voices or audio recordings.</p>\"'`;else content=metadata[`${tab}Feedback`].map((a,i)=>`<p><b>${i+1}.</b> ${esc(a)}</p>`).join('\"'');setModal('about',\"'`<div class=\"eyebrow\">STELLAR RAIDERS / FLIGHT RECORD</div><h2>About this little universe.</h2><div class=\"credits-tabs\">${Object.entries(labels).map(([k,v])=>`<button class=\"button ${k===tab?'\"'primary':''}\\\" data-action=\\\"creditsTab\\\" data-tab=\\\"\"'${k}\">${v}</button>`).join('\"'')}</div><div class=\\\"credits\\\" tabindex=\\\"0\\\">\"'${content}</div><div class=\"buttons\">${backButton()}</div>`,true);}\nfunction returnTitle(){if(net?.active)return;if(game){game.running=false;game.attract=false;}screen='\"'title';\"'$('\"'menu').hidden=false;\"'$('\"'hud').hidden=true;\"'$('\"'modal').hidden=true;\"'$('\"'attractBanner').hidden=true;\"'$('\"'jumpOverlay').hidden=true;document.body.classList.remove('in-flight');if(document.pointerLockElement)document.exitPointerLock();keys.clear();pointer.fire=false;lastActivity=performance.now();}\nfunction startGame(attract=false){if(hubEnded)return;game.launch(attract);screen='flight';\"'$('\"'menu').hidden=true;\"'$('\"'hud').hidden=false;\"'$('\"'modal').hidden=true;\"'$('\"'attractBanner').hidden=\"'!attract;document.body.classList.add('\"'in-flight');attractTime=0;attractStage=0;simSpeed=1;visuals.setSector(game);if(\"'!attract){audio.unlock();audio.setMuted(false);}lastActivity=performance.now();}\nfunction finish(data){if(game.attract)return;if(net.active)net.finish(game.score,stats());let best=0;try{best=+localStorage.getItem('\"'stellar-best')||0;if(game.score>best)localStorage.setItem('stellar-best',game.score);}catch{}setModal('debrief',\"'`<div class=\"eyebrow\">${game.god?'\"'TRAINING FLIGHT / ':''}MISSION DEBRIEF / \"'${data.won?'\"'FRONTIER SECURE':'SIGNAL LOST'}</div><h2>\"'${data.won?'\"'A very big problem. Solved.':'The stars remember.'}</h2><p>\"'${data.won?'\"'The raider fleet is scattered. Starbase crews are already arguing over who buys the first round.':'Command has your flight recorder. Another patrol will carry the light.'}</p><div class=\\\"stat-grid\\\"><div><strong>\"'${game.score.toLocaleString()}</strong><span>COMMAND POINTS</span></div><div><strong>${game.kills} / 13</strong><span>RAIDERS DESTROYED</span></div><div><strong>${game.aliveBases} / 2</strong><span>STARBASES SAVED</span></div><div><strong>${Math.floor(game.time/60)}:${String(Math.floor(game.time%60)).padStart(2,'\"'0')}</strong><span>FLIGHT TIME</span></div><div><strong>\"'${Math.round(game.hits/Math.max(1,game.shots)*100)}%</strong><span>WEAPON ACCURACY</span></div><div><strong>${game.jumps}</strong><span>HYPERSPACE JUMPS</span></div></div><p class=\"context-hint\">${data.won?(game.aliveBases===2?'\"'RATING: STAR COMMANDER':'RATING: FRONTIER ACE'):'RATING: A BRAVE LITTLE SHIP'} · BEST \"'${Math.max(best,game.score).toLocaleString()}</p><div class=\"buttons\">${net.active?'\"'<span>Awaiting the Hub’s final standings.</span>':'<button class=\\\"button primary\\\" data-action=\\\"start\\\">Fly another patrol</button><button class=\\\"button\\\" data-action=\\\"title\\\">Return to command</button>'}<button class=\\\"button\\\" data-action=\\\"about\\\">Flight record</button></div>\"'`,true);}\nfunction stats(){return {'\"'Raiders destroyed':game.kills,'Bases saved':game.aliveBases,'Clean transits':game.jumps,'Hull remaining':Math.round(game.hull)};}\nfunction context(){if(\"'!game.running)return;if(game.base){const p=game.position,q=game.stationPosition;game.yaw=Math.atan2(-(q.x-p.x),-(q.z-p.z));game.pitch=Math.atan2(q.y-p.y,Math.hypot(q.x-p.x,q.z-p.z));game.throttle=dist(p,q)>110?.7:0;game.autopilot=true;game.say('\"'DOCK CONTROL','Approach assist engaged. Keep clear of the habitat ring.');}else openMap();}\nfunction action(name,el){if(\"'!ready||hubEnded)return;audio.unlock();audio.sfx('\"'select');switch(name){case'start':if(\"'!net.active)startGame();break;case'\"'title':returnTitle();break;case'pause':openPause();break;case'resume':closeModal();break;case'back':if(pausedFrom==='flight'&&game.running)openPause();else returnTitle();break;case'manual':openManual();break;case'settings':openSettings();break;case'online':openOnline();break;case'about':openAbout();break;case'creditsTab':openAbout(el.dataset.tab);break;case'map':openMap();break;case'sector':selected=+el.dataset.sector;drawMap();break;case'jump':if(game.beginJump(selected))closeModal();break;case'context':context();break;case'dev':openDev();break;case'god':game.god=\"'!game.god;openDev();break;case'\"'resupply':game.hull=game.shield=game.energy=100;game.missiles=6;game.god=true;note('Training resupply complete');break;case'clear':game.god=true;for(const e of [...game.enemies])game.kill(e);openDev();break;case'spawn':game.god=true;game.roster[game.sector]??=[];game.roster[game.sector].push('raider');game.spawnEnemy('raider',game.enemies.length);note('Training raider spawned');break;case'resetTune':game.tuning={...DEFAULTS};simSpeed=1;openDev();break;case'glyphs':settings.glyphs=settings.glyphs==='playstation'?'xbox':'playstation';saveSettings();openSettings();break;case'motion':settings.reducedMotion=\"'!settings.reducedMotion;saveSettings();openSettings();break;case'\"'fullscreen':if(document.fullscreenElement)document.exitFullscreen();else document.documentElement.requestFullscreen().catch(()=>note('Fullscreen unavailable in this browser'));break;case'hostRoom':net.hostRoom();openOnline();break;case'joinRoom':if(\"'!net.joinRoom($('\"'roomCode').value))note('Enter a wing code first');else openOnline();break;case'leaveRoom':net.leaveRoom();openOnline();break;}}\ndocument.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b){if(activity(lastInput==='touch'?'touch':'keyboard'))return;action(b.dataset.action,b);}});\ndocument.addEventListener('pointerover',e=>{const b=e.target.closest('button,input');if(b&&e.pointerType==='mouse'){b.focus({preventScroll:true});}});\ndocument.addEventListener('input',e=>{const el=e.target;if(el.dataset.setting){const k=el.dataset.setting;settings[k]=+el.value;el.nextElementSibling.textContent=el.value+(k==='sensitivity'?'×':'%');audio.setMusic(settings.music/100);audio.setVolume(settings.volume/100);saveSettings();}if(el.dataset.tune){game.tuning[el.dataset.tune]=+el.value;el.nextElementSibling.textContent=el.value;}if(el.hasAttribute('data-speed')){simSpeed=+el.value;el.nextElementSibling.textContent=el.value+'×';}lastActivity=performance.now();});\nwindow.addEventListener('keydown',e=>{if(activity('keyboard')){e.preventDefault();return;}if(\"'!ready||hubEnded)return;audio.unlock();if(['\"'Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code)&&screen==='flight')e.preventDefault();if(e.repeat){keys.add(e.code);return;}keys.add(e.code);if(e.code==='Escape'){e.preventDefault();if(screen==='flight')openPause();else if(screen==='map')closeModal();else if(game.running)openPause();else returnTitle();return;}if(screen==='flight'){if(e.code==='KeyM'){openMap();return;}if(e.code==='KeyT')game.cycleTarget();if(e.code==='KeyR')game.missile();if(e.code==='KeyE')game.toggleShield();if(e.code==='KeyH')context();}else if(screen==='map'&&e.code.startsWith('Arrow')){e.preventDefault();selected=clamp(selected+({ArrowLeft:-1,ArrowRight:1,ArrowUp:-5,ArrowDown:5}[e.code]),0,19);drawMap();}else if(e.code==='Enter'&&screen==='title')action('start');});\nwindow.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();pointer.fire=false;if(screen==='flight'&&\"'!game.attract&&!net.active)openPause();});\nwindow.addEventListener('\"'mousemove',e=>{if(activity('keyboard'))return;pointer.inside=true;pointer.x=e.clientX/innerWidth*2-1;pointer.y=e.clientY/innerHeight*2-1;if(document.pointerLockElement){pointer.dx+=e.movementX;pointer.dy+=e.movementY;}});\ncanvas.addEventListener('mousedown',e=>{if(activity('keyboard')||screen\"'!=='\"'flight'||hubEnded)return;audio.unlock();if(e.button===0){pointer.fire=true;if(\"'!document.pointerLockElement)canvas.requestPointerLock?.();}if(e.button===2)game.missile();});window.addEventListener('\"'mouseup',()=>pointer.fire=false);window.addEventListener('contextmenu',e=>e.preventDefault());\ncanvas.addEventListener('pointerdown',e=>{if(e.pointerType\"'!=='\"'touch')return;e.preventDefault();if(activity('touch'))return;document.body.classList.add('touch');audio.unlock();if(screen\"'!=='\"'flight')return;canvas.setPointerCapture(e.pointerId);if(e.clientX<innerWidth/2)touch.look={id:e.pointerId,x:e.clientX,y:e.clientY};else touch.thrust={id:e.pointerId,x:e.clientX,y:e.clientY};});canvas.addEventListener('pointermove',e=>{if(e.pointerType\"'!=='\"'touch')return;if(touch.look?.id===e.pointerId){touch.x=clamp((e.clientX-touch.look.x)/85,-1,1);touch.y=clamp((e.clientY-touch.look.y)/85,-1,1);}if(touch.thrust?.id===e.pointerId){touch.boost=e.clientY<touch.thrust.y-100;touch.thrust.value=clamp((touch.thrust.y-e.clientY)/80,-1,1);}});function endTouch(e){if(touch.look?.id===e.pointerId){touch.look=null;touch.x=touch.y=0;}if(touch.thrust?.id===e.pointerId){touch.thrust=null;touch.boost=false;}}canvas.addEventListener('pointerup',endTouch);canvas.addEventListener('pointercancel',endTouch);\nfunction menuMove(x,y){if(screen==='map'&&Math.abs(y)+Math.abs(x)>0){selected=clamp(selected+(x?Math.sign(x):Math.sign(y)*5),0,19);drawMap();return;}const current=document.activeElement;if(current?.type==='range'&&x){current.value=+current.value+Math.sign(x)*(+current.step||1);current.dispatchEvent(new Event('input',{bubbles:true}));return;}const root=\"'$('\"'modal').hidden?\"'$('\"'menu'):\"'$('\"'modal');const items=[...root.querySelectorAll('button:not(:disabled),input,[tabindex=\\\"0\\\"]')].filter(el=>el.getBoundingClientRect().width>0);let i=items.indexOf(current);i=(i+(y||x>0?1:-1)+items.length)%items.length;items[i]?.focus();}\nfunction pollPad(now){const pad=[...(navigator.getGamepads?.()||[])].find(p=>p?.connected);if(\"'!pad){padButtons=[];return null;}const axes=pad.axes.map(v=>Math.abs(v)<.14?0:v);const buttons=pad.buttons.map(b=>b.pressed);const changed=buttons.some((v,i)=>v&&!padButtons[i])||axes.some((v,i)=>Math.abs(v-lastPadAxes[i])>.1);if(changed){if(activity('\"'gamepad')){padButtons=buttons;return null;}audio.unlock();}const edge=i=>buttons[i]&&\"'!padButtons[i];if(!hubEnded){if(edge(9)&&!buttons[8]){if(screen==='\"'flight')openPause();else if(game.running)closeModal();}if(screen==='flight'){if(edge(3))openMap();if(edge(2))game.cycleTarget();if(edge(5))game.missile();if(edge(4))game.toggleShield();if(edge(1))context();}else{if(edge(0))document.activeElement?.click();if(edge(1)){if(game.running)closeModal();else returnTitle();}const x=(buttons[15]?1:0)-(buttons[14]?1:0)||(Math.abs(axes[0])>.55?Math.sign(axes[0]):0);const y=(buttons[13]?1:0)-(buttons[12]?1:0)||(Math.abs(axes[1])>.55?Math.sign(axes[1]):0);if((x||y)&&now-padLastNav>210){menuMove(x,y);padLastNav=now;}if(Math.abs(axes[3])>.2){const credits=\"'$('\"'modal').querySelector('.credits');if(credits)credits.scrollTop+=axes[3]*16;}}}padButtons=buttons;lastPadAxes=axes;return {axes,buttons};}\nfunction autoPilot(dt){const target=game.target&&\"'!game.target.dead?game.target:game.enemies.find(e=>!e.dead);if(!target)return {yaw:0,pitch:0,thrust:-1};game.target=target;const p=game.position,q=target.body.translation();const yaw=Math.atan2(-(q.x-p.x),-(q.z-p.z));const pitch=Math.atan2(q.y-p.y,Math.hypot(q.x-p.x,q.z-p.z));let dy=yaw-game.yaw;dy=Math.atan2(Math.sin(dy),Math.cos(dy));return {yaw:clamp(dy*3,-1.8,1.8),pitch:clamp((pitch-game.pitch)*3,-1.8,1.8),thrust:game.throttle>.32?-1:0,fire:Math.abs(dy)<.2&&Math.abs(pitch-game.pitch)<.2};}\nfunction runAttract(dt){attractTime+=dt;if(attractTime>125||game.won||game.lost){startGame(true);return;}if(!game.jump){if(attractStage===0&&(game.enemies.length===0||attractTime>17)){game.enterSector(16);visuals.setSector(game);game.player.setTranslation({x:0,y:0,z:-330},true);game.throttle=0;attractStage=1;}else if(attractStage===1&&game.docks>0){game.beginJump(7);attractStage=2;}else if(attractStage>=2&&game.enemies.length===0){const next=[7,3,4,11].find(id=>game.roster[id].length&&game.sector!==id);if(next!==undefined)game.beginJump(next);else startGame(true);}}const input=attractStage===1?{thrust:-1}:autoPilot(dt);if(attractStage>1&&Math.floor(attractTime*2)%7===0)game.missile();return input;}\nfunction getInput(dt,pad){if(debugInput)return {...debugInput};if(game.attract)return runAttract(dt)||{};let yaw=0,pitch=0;if(document.pointerLockElement){yaw=-pointer.dx*.0027/Math.max(dt,.001);pitch=-pointer.dy*.0027/Math.max(dt,.001);}else if(pointer.inside&&lastInput==='\"'keyboard'){yaw=-pointer.x*.8;pitch=-pointer.y*.8;}pointer.dx=pointer.dy=0;yaw+=(keys.has('ArrowLeft')?1:0)-(keys.has('ArrowRight')?1:0);pitch+=(keys.has('ArrowUp')?1:0)-(keys.has('ArrowDown')?1:0);let thrust=(keys.has('KeyW')?1:0)-(keys.has('KeyS')?1:0);let strafe=(keys.has('KeyD')?1:0)-(keys.has('KeyA')?1:0);let fire=pointer.fire||keys.has('Space'),boost=keys.has('ShiftLeft')||keys.has('ShiftRight');if(pad&&lastInput==='gamepad'){yaw=-pad.axes[0];pitch=-pad.axes[1];thrust=-pad.axes[3];strafe=pad.axes[2];fire=pad.buttons[7];boost=pad.buttons[6];}if(lastInput==='touch'){yaw=-touch.x;pitch=-touch.y;thrust=touch.thrust?.value||0;fire=\"'!!game.aimTarget();boost=touch.boost;if(game.target&&!game.target.dead&&game.missiles>0&&game.missileCooldown<=0&&Math.random()<dt*.13)game.missile();}if(game.autopilot){const p=game.position,q=game.stationPosition;if(dist(p,q)<110){game.throttle=0;thrust=-1;}else{const desiredYaw=Math.atan2(-(q.x-p.x),-(q.z-p.z));yaw=clamp(Math.atan2(Math.sin(desiredYaw-game.yaw),Math.cos(desiredYaw-game.yaw))*3,-1,1);pitch=clamp((Math.atan2(q.y-p.y,Math.hypot(q.x-p.x,q.z-p.z))-game.pitch)*3,-1,1);}if(game.docked||Math.abs(touch.x)+Math.abs(touch.y)>0||keys.has('\"'KeyW')||keys.has('KeyA')||keys.has('KeyD'))game.autopilot=false;}return {yaw:clamp(yaw*settings.sensitivity,-3,3),pitch:clamp(pitch*settings.sensitivity,-3,3),thrust,strafe,fire,boost};}\nfunction drawRadar(){const c=\"'$('\"'radar'),ctx=c.getContext('2d'),w=c.width,h=c.height;ctx.clearRect(0,0,w,h);ctx.strokeStyle='#365662';ctx.lineWidth=1;for(const r of[25,48,69]){ctx.beginPath();ctx.ellipse(w/2,h/2,r,r*.82,0,0,Math.PI*2);ctx.stroke();}ctx.beginPath();ctx.moveTo(20,h/2);ctx.lineTo(w-20,h/2);ctx.moveTo(w/2,7);ctx.lineTo(w/2,h-7);ctx.stroke();const p=game.position;function dot(q,color,size=4){const dx=q.x-p.x,dz=q.z-p.z,cs=Math.cos(game.yaw),sn=Math.sin(game.yaw);let x=(dx*cs-dz*sn)*.14,z=(dx*sn+dz*cs)*.14;const k=Math.max(1,Math.hypot(x,z)/65);x/=k;z/=k;ctx.fillStyle=color;ctx.fillRect(w/2+x-size/2,h/2+z-size/2,size,size);}for(const e of game.enemies)if(\"'!e.dead)dot(e.body.translation(),e===game.target?'\"'#fff4c2':'#ed805d',e.type==='flagship'?7:4);if(game.base)dot(game.stationPosition,'#75d6be',7);for(const e of visuals.ghosts.values())if(e.data.sector===game.sector)dot(e.data,'#7dcbdc',4);ctx.fillStyle='#d3efa1';ctx.beginPath();ctx.moveTo(w/2,h/2-7);ctx.lineTo(w/2-5,h/2+4);ctx.lineTo(w/2+5,h/2+4);ctx.fill();}\nfunction updateHUD(now){for(const k of['shield','hull','energy','heat']){\"'$(k+'\"'Value').textContent=Math.round(game[k]);\"'$(k+'\"'Bar').style.width=game[k]+'%';}\"'$('\"'shieldBar').style.opacity=game.shields?1:.2;\"'$('\"'sectorLabel').textContent=\"'`${String.fromCharCode(65+game.sector%5)}${1+Math.floor(game.sector/5)} / ${game.sectors[game.sector].name}`;$('\"'statusLabel').textContent=game.docked?'SERVICE COMPLETE':game.docking>0?\"'`DOCKING ${Math.round(game.docking/3*100)}%`:game.energy<25?'\"'ENERGY RESERVE LOW':\"'!game.shields?'\"'DEFLECTORS OFFLINE':'DEFLECTORS ONLINE';\"'$('\"'speedValue').textContent=game.docked?'0':Math.round(12+game.throttle*92);\"'$('\"'killsValue').textContent=game.kills;\"'$('\"'basesValue').textContent=game.aliveBases;\"'$('\"'ammoValue').textContent=game.missiles;\"'$('\"'missionProgress').textContent=\"'`${game.kills} / 13`;$('\"'objective').textContent=game.base?(game.docked?'Ship ready. Plot the next intercept.':'Approach slowly to repair & resupply'):game.enemies.length?(game.sector===4?'Destroy the raider command ship':'Clear the raider squadron'):'Sector secure. Plot your next jump.';\"'$('\"'navTarget').textContent=game.jump?game.sectors[game.jump.to].name:\"'`${game.remaining} CONTACTS REMAIN`;$('\"'threatValue').textContent=game.bases.map(b=>\"'`${b.name} ${Math.ceil(b.health)}%`).join('\"' / ');\"'$('\"'prompts').textContent=promptText();\"'$('\"'jumpOverlay').hidden=\"'!game.jump;if(game.jump)$('\"'jumpOverlay').querySelector('strong').textContent=game.jump.alignment>2?'CORRIDOR STABLE':'HOLD YOUR COURSE';\"'$('\"'comms').style.opacity=now<messageUntil?'1':'0';const target=game.target;if(target&&\"'!target.dead){const q=target.body.translation(),p=visuals.project(q);$('\"'targetInfo').hidden=false;\"'$('\"'targetInfo').classList.toggle('offscreen',\"'!p.visible);$('\"'targetInfo').style.left=p.x+'px';\"'$('\"'targetInfo').style.top=p.y+'px';\"'$('\"'targetInfo').innerHTML=\"'`<span class=\"target-box\">${p.visible?'\"'':'↶'}</span><small>\"'${target.type.toUpperCase()} · ${Math.round(dist(game.position,q))}u</small><small>${Math.max(0,Math.ceil(target.hp/target.maxHp*100))}% ARMOUR</small>`;}else $('\"'targetInfo').hidden=true;const touchMode=lastInput==='touch';\"'$('\"'touchAction').hidden=\"'!touchMode||(!game.base&&game.enemies.length>0)||screen!=='\"'flight';\"'$('\"'touchAction').textContent=game.base?'DOCK ASSIST':'SECTOR CHART';drawRadar();}\nfunction handleEvent(type,data){if(\"'!visuals)return;switch(type){case'\"'sector':visuals.setSector(game);break;case'spawn':visuals.addEnemy(data);break;case'removeEnemy':visuals.removeEnemy(data);break;case'shot':visuals.shot(data);break;case'removeShot':visuals.removeShot(data);break;case'explosion':visuals.explode(data.position,data.big);break;case'impact':visuals.impact(data.position);break;case'sound':if(\"'!game.attract)audio.sfx(data);break;case'\"'damage':if(\"'!settings.reducedMotion)visuals.shake=.8;$('\"'flash').classList.add('active');setTimeout(()=>\"'$('\"'flash').classList.remove('active'),180);break;case'message':\"'$('\"'speaker').textContent=data.speaker;\"'$('\"'message').textContent=data.text;messageUntil=performance.now()+6500;if(\"'!game.attract)audio.voice(game.kills+game.sector);break;case'\"'finish':finish(data);break;}}\nlet last=performance.now();function loop(now){const dt=Math.min((now-last)/1000,.05);last=now;const pad=pollPad(now);if(ready){if(screen==='title'&&\"'!net.active&&now-lastActivity>10000)startGame(true);if(screen==='\"'flight'&&\"'!hubEnded&&net.canPlay()){let remain=dt*simSpeed;const input=getInput(dt,pad);while(remain>.00001){const step=Math.min(remain,1/60);game.update(step,input);remain-=step;}}if(net.active||game.running)net.tick(dt,game.snapshot(),game.score);if(!net.active||net.canPlay()){updateHUD(now);audio.setIntensity(screen==='\"'flight'&&game.enemies.length?game.sector===4?1:.5:0);}else if(\"'!hubEnded){$('\"'statusLabel').textContent='AWAITING HUB LAUNCH';}visuals.render(dt,game,screen==='title'||(pausedFrom==='title'&&\"'!game.running));frameCount++;}requestAnimationFrame(loop);}\nasync function boot(){try{await RAPIER.init();game=new Campaign(handleEvent);visuals=new Visuals(canvas);await visuals.init();visuals.setSector(game);net=new Network({start:()=>startGame(),end:()=>{hubEnded=true;game.running=false;pointer.fire=false;keys.clear();audio.setMuted(true);$('\"'modal').hidden=true;\"'$('\"'attractBanner').hidden=true;},timeup:()=>({score:game.score,stats:stats()}),ghost:(data,id)=>visuals.ghost(data,id),leave:id=>visuals.removeGhost(id)});ready=true;\"'$('\"'loading').hidden=true;\"'$('\"'bootStatus').textContent=\"'`${visuals.backend.toUpperCase()} / FLIGHT SYSTEMS READY`;if(navigator.maxTouchPoints>0){document.body.classList.add('\"'touch');lastInput='touch';}if(net.active){\"'$('\"'menu').hidden=true;\"'$('\"'hud').hidden=false;screen='waiting';}await net.init();window.__stellar={game,visuals,audio,network:net,action:(name)=>action(name),state:()=>({...game.debug(),screen,input:lastInput,renderer:visuals.backend,frames:frameCount,hubEnded,audio:audio.debug()}),setInput:v=>debugInput=v,start:()=>startGame(),returnTitle,openMap,openDev};last=performance.now();requestAnimationFrame(loop);\"'$('\"'menu').querySelector('[data-action=start]')?.focus({preventScroll:true});}catch(error){console.error(error);\"'$('\"'loading').querySelector('strong').textContent='Flight systems need attention.';\"'$('\"'loading').querySelector('p').textContent=error.message+' — A current Chromium browser with internet access is recommended.';globalThis.AIHub?.fail?.(error.message);window.__bootError=error.message;}}\nboot();\nEOF\nnode --check main.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {Campaign,DEFAULTS,clamp,dist} from './core.js';\nimport {Visuals} from './visuals.js';\nimport {AudioEngine} from './audio.js';\nimport {Network} from './network.js';\nconst \"'$=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"'\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst metadata=JSON.parse(\"'$('\"'creditsData').textContent);\nconst audio=new AudioEngine();\nlet game,visuals,net,ready=false,screen='title',lastInput='keyboard',lastActivity=performance.now(),messageUntil=0,selected=16,simSpeed=1,attractTime=0,attractStage=0,pausedFrom='title',modalTab='source',hubEnded=false,frameCount=0;\nlet settings={music:10,volume:75,sensitivity:1,glyphs:'playstation',reducedMotion:false};try{Object.assign(settings,JSON.parse(localStorage.getItem('stellar-settings')||'{}'));}catch{}\naudio.setMusic(settings.music/100);audio.setVolume(settings.volume/100);\nconst keys=new Set;const pointer={x:0,y:0,dx:0,dy:0,fire:false,inside:false};const touch={look:null,thrust:null,x:0,y:0,boost:false};let padButtons=[],padLastNav=0,lastPadAxes=[0,0,0,0];let debugInput=null;\nconst canvas=document.createElement('canvas');canvas.id='space';canvas.setAttribute('aria-label','Three-dimensional flight view');document.body.prepend(canvas);\nconst extra=document.createElement('style');extra.textContent=\"'`#space{position:fixed;inset:0;width:100%;height:100%;z-index:0;touch-action:none}.target-info{position:fixed!important;transform:translate(-50%,-50%);pointer-events:none;min-width:125px;text-align:center}.target-info .target-box{display:block;width:72px;height:58px;margin:0 auto 9px;border:2px solid var(--coral,#f08361);clip-path:polygon(0 0,28% 0,28% 3%,3% 3%,3% 28%,0 28%,0 0,100% 0,100% 28%,97% 28%,97% 3%,72% 3%,72% 0,100% 0,100% 100%,72% 100%,72% 97%,97% 97%,97% 72%,100% 72%,100% 100%,0 100%,0 72%,3% 72%,3% 97%,28% 97%,28% 100%,0 100%)}.target-info small{display:block;color:#ffb28b;font-size:13px;letter-spacing:.1em}.target-info.offscreen{top:35%!important;left:50%!important}.target-info.offscreen .target-box{border:0;clip-path:none;height:20px}.range-value{font-variant-numeric:tabular-nums;color:#cdf282}.sector-grid{grid-template-columns:repeat(5,minmax(0,1fr))!important}.sector-cell{min-height:80px;font-size:16px}.sector-cell b{font-size:23px;display:block}.sector-cell small{display:block;font-size:10px;letter-spacing:.08em}.sector-cell.current{box-shadow:inset 0 0 0 2px #d7ee9c}.sector-cell.danger b{color:#ef926e}.sector-cell.base b{color:#7cdbc7}.map-side h3{font-size:32px;margin:.25em 0}.map-side p{line-height:1.5;color:#bcc8cf}.brief-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.manual-key{display:inline-block;border:1px solid #6b828d;padding:2px 8px;color:#d8eea3;font-size:18px;min-width:32px;text-align:center}.modal-card .fine{font-size:14px;color:#91a5b1;line-height:1.5}.modal-card h2{font-size:clamp(28px,4vw,48px);margin:8px 0 22px}.modal-card p{line-height:1.5}.modal-card input[type=text]{font:inherit;background:#101d2d;border:1px solid #63798b;color:#e7eddf;padding:14px;width:190px;text-transform:uppercase}.credits{max-height:55vh;overflow:auto;padding-right:20px;font-size:17px;line-height:1.6}.credits dl{display:grid;grid-template-columns:150px 1fr;gap:8px 22px}.credits dt{color:#a9c0cc}.credits dd{margin:0}.credits p{border-bottom:1px solid #354455;padding:12px 0}.row{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:14px 0}.slider-row{display:grid;grid-template-columns:1fr 1.2fr 65px;gap:20px;align-items:center;margin:18px 0;font-size:18px}.slider-row input{width:100%;accent-color:#d7ee9c}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:24px 0}.stat-grid div{padding:18px;background:#132437;border-top:1px solid #738892}.stat-grid strong{display:block;color:#d7ee9c;font-size:38px}.stat-grid span{font-size:14px;color:#b0c3cb}.buttons{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}button:disabled{opacity:.4;cursor:default}.modal-card .button{min-height:48px}.brief-grid h3{color:#d7ee9c}.context-hint{font-size:18px;color:#d7ee9c}.dev-toggle{padding:12px;background:#1c3040}body.in-flight #space{cursor:crosshair}body.touch #targetInfo{font-size:13px}body.touch #comms{max-width:75%;bottom:65px}.reticle{top:50%!important}.jump-overlay{pointer-events:none}#touchMenu{z-index:35}#touchAction{z-index:35}.toast{z-index:90}.credits-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.credits-tabs button{font-size:15px;padding:8px 14px}.hud-top{pointer-events:none}.modal-card{max-height:90vh;overflow:auto}@media(max-width:700px){.brief-grid{grid-template-columns:1fr;gap:4px}.sector-cell{min-height:54px;padding:5px;font-size:12px}.sector-cell small{font-size:8px}.sector-cell b{font-size:17px}.credits dl{grid-template-columns:1fr;gap:3px}.credits dd{margin-bottom:12px}.slider-row{grid-template-columns:1fr 1fr 40px;font-size:14px;gap:8px}.stat-grid{gap:7px}.stat-grid div{padding:10px}.stat-grid strong{font-size:26px}}`;document.head.append(extra);\nfunction saveSettings(){try{localStorage.setItem('\"'stellar-settings',JSON.stringify(settings));}catch{}}\nfunction note(text){\"'$('\"'toast').textContent=text;\"'$('\"'toast').hidden=false;setTimeout(()=>\"'$('\"'toast').hidden=true,2600);}\nfunction activity(type='keyboard'){lastActivity=performance.now();lastInput=type;if(game?.attract){returnTitle();return true;}return false;}\nfunction promptText(){if(lastInput==='gamepad'){const ps=settings.glyphs==='playstation';return \"'`${ps?'\"'R2':'RT'} FIRE · \"'${ps?'\"'R1':'RB'} TORPEDO · \"'${ps?'\"'△':'Y'} CHART · \"'${ps?'\"'○':'B'} CONTEXT\"'`;}if(lastInput==='\"'touch')return 'DRAG LEFT TO STEER · RIGHT TO THRUST · AUTO FIRE';return 'LMB FIRE · R TORPEDO · M CHART · E SHIELDS · ESC PAUSE';}\nfunction setModal(name,html,wide=false){screen=name;\"'$('\"'modal').innerHTML=\"'`<section class=\"modal-card ${wide?'\"'wide':''}\\\">\"'${html}</section>`;$('\"'modal').hidden=false;if(document.pointerLockElement)document.exitPointerLock();pointer.fire=false;keys.clear();setTimeout(()=>{\"'$('\"'modal').querySelector('button:not(:disabled),input')?.focus({preventScroll:true});},20);}\nfunction closeModal(){screen=game.running?'flight':'title';\"'$('\"'modal').hidden=true;keys.clear();pointer.fire=false;lastActivity=performance.now();}\nconst backButton=(label='Back')=>\"'`<button class=\"button\" data-action=\"back\">← ${label}</button>`;\nfunction openPause(){if(!game.running||hubEnded)return;pausedFrom='\"'flight';setModal('pause',\"'`<div class=\"eyebrow\">PATROL ${String(game.sector+1).padStart(2,'\"'0')} / FLIGHT PAUSED</div><h2>Take a breath, pilot.</h2><p>One ship is still a fighting chance.</p><div class=\\\"buttons\\\"><button class=\\\"button primary\\\" data-action=\\\"resume\\\">Resume flight</button><button class=\\\"button\\\" data-action=\\\"map\\\">Sector chart</button><button class=\\\"button\\\" data-action=\\\"manual\\\">Flight manual</button><button class=\\\"button\\\" data-action=\\\"settings\\\">Settings</button><button class=\\\"button\\\" data-action=\\\"dev\\\">Dev flight deck</button><button class=\\\"button\\\" data-action=\\\"title\\\" \"'${net.active?'\"'disabled':''}>End patrol</button></div><p class=\\\"fine\\\">\"'${net.active?'\"'The Hub clock keeps running while your flight is paused.':net.status}</p>\"'`);}\nfunction openManual(){if(screen==='\"'title')pausedFrom='title';else if(screen==='flight')pausedFrom='flight';const pad=lastInput==='gamepad',ps=settings.glyphs==='playstation';setModal('manual',\"'`<div class=\"eyebrow\">FDC / PILOT FIELD NOTES</div><h2>Hold the frontier.</h2><div class=\"brief-grid\"><div><h3>01 / Hunt</h3><p>Destroy thirteen raiders across <b>Razor, Glass, Iron Wake and Crown</b>. The flagship at Crown carries heavy armour. Follow the target brackets; cycle your lock to find contacts behind you.</p><h3>02 / Navigate</h3><p>Open the sector chart, choose a destination, then engage hyperspace. Each transit uses energy. Keep the flight marker steady for a clean-jump bonus.</p><h3>03 / Come home</h3><p>Jump to Kestrel or Lantern. Approach the station within <b>115 units</b> and lower throttle below <b>32%</b>. Hold for three seconds to repair and reload. Throttle up to depart. Starbases suffer while the fleet survives.</p></div><div><h3>Flight controls</h3><p>${pad?`<span class=\"manual-key\">L</span> Steer &nbsp; <span class=\"manual-key\">R ↑↓</span> Throttle<br><span class=\"manual-key\">${ps?'\"'R2':'RT'}</span> Cannons &nbsp; <span class=\\\"manual-key\\\">\"'${ps?'\"'L2':'LT'}</span> Boost<br><span class=\\\"manual-key\\\">\"'${ps?'\"'R1':'RB'}</span> Homing torpedo<br><span class=\\\"manual-key\\\">\"'${ps?'\"'L1':'LB'}</span> Deflectors<br><span class=\\\"manual-key\\\">\"'${ps?'\"'□':'X'}</span> Cycle lock<br><span class=\\\"manual-key\\\">\"'${ps?'\"'△':'Y'}</span> Sector chart<br><span class=\\\"manual-key\\\">\"'${ps?'\"'○':'B'}</span> Context / dock approach<br><span class=\\\"manual-key\\\">Options</span> Pause\"'`:`<span class=\"manual-key\">Mouse</span> Steer; click flight view to capture<br><span class=\"manual-key\">W / S</span> Throttle<br><span class=\"manual-key\">A / D</span> Strafe<br><span class=\"manual-key\">LMB / Space</span> Cannons<br><span class=\"manual-key\">R / RMB</span> Homing torpedo<br><span class=\"manual-key\">Shift</span> Boost<br><span class=\"manual-key\">E</span> Deflectors<br><span class=\"manual-key\">T</span> Cycle lock<br><span class=\"manual-key\">M</span> Sector chart<br><span class=\"manual-key\">H</span> Context / dock approach<br><span class=\"manual-key\">Esc</span> Pause`}</p><p class=\"fine\">Touch: drag the left half to steer; drag the right half up/down for thrust. Cannons, targeting and torpedoes assist automatically. A context button appears near a station or after a sector is secure.</p><p class=\"fine\">Cannons build heat. Deflectors regenerate after a quiet moment. Lowering them recharges energy faster. Every starbase saved improves your final rating.</p></div></div><div class=\"buttons\">${backButton()}</div>`,true);}\nfunction openSettings(){if(screen==='\"'title')pausedFrom='title';else if(screen==='flight')pausedFrom='flight';setModal('settings',\"'`<div class=\"eyebrow\">FDC / PERSONAL FLIGHT PROFILE</div><h2>Make yourself at home.</h2><label class=\"slider-row\"><span>Music</span><input type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"${settings.music}\" data-setting=\"music\"><output>${settings.music}%</output></label><label class=\"slider-row\"><span>Sound & voice</span><input type=\"range\" min=\"0\" max=\"100\" value=\"${settings.volume}\" data-setting=\"volume\"><output>${settings.volume}%</output></label><label class=\"slider-row\"><span>Steering sensitivity</span><input type=\"range\" min=\"0.5\" max=\"2.5\" step=\"0.1\" value=\"${settings.sensitivity}\" data-setting=\"sensitivity\"><output>${settings.sensitivity}×</output></label><div class=\"row\"><span>Controller glyphs</span><button class=\"button\" data-action=\"glyphs\">${settings.glyphs==='\"'playstation'?'PlayStation: ✕ ○ □ △':'Xbox: A B X Y'}</button></div><div class=\\\"row\\\"><span>Reduced camera motion</span><button class=\\\"button\\\" data-action=\\\"motion\\\">\"'${settings.reducedMotion?'\"'ON':'OFF'}</button></div><div class=\\\"buttons\\\"><button class=\\\"button\\\" data-action=\\\"fullscreen\\\">Fullscreen</button>\"'${backButton()}</div>`);}\nfunction openMap(){if(!game.running)return;selected=game.energy<35?16:Number(Object.keys(game.roster).find(id=>game.roster[id].length&&+id!==game.sector)??16);screen='\"'map';drawMap();}\nfunction drawMap(){const s=game.sectors[selected],n=game.roster[selected]?.length||0,base=game.bases.find(b=>b.sector===selected);setModal('map',\"'`<div class=\"eyebrow\">GALACTIC CHART / ${game.aliveBases} STARBASES ONLINE</div><h2>Choose your next move.</h2><div class=\"map-layout\"><div><div class=\"sector-grid\">${game.sectors.map(s=>{const n=game.roster[s.id]?.length||0,b=game.bases.find(b=>b.sector===s.id);return `<button class=\"sector-cell ${s.id===selected?'\"'selected':''} \"'${s.id===game.sector?'\"'current':''} \"'${n?'\"'danger':''} \"'${b?'\"'base':''}\\\" data-action=\\\"sector\\\" data-sector=\\\"\"'${s.id}\" aria-label=\"${s.name}, ${n?'\"'hostiles '+n:b?'starbase':'clear space'}\\\"><small>\"'${String.fromCharCode(65+s.id%5)}${1+Math.floor(s.id/5)}</small><b>${s.id===game.sector?'\"'▵':n?'✦':b?'◇':s.storm?'≈':'·'}</b><small>\"'${n?`${n} HOSTILE`:b?b.name:s.name}</small></button>`;}).join('\"'')}</div><p class=\\\"fine\\\">▵ YOU &nbsp; ✦ RAIDERS &nbsp; ◇ STARBASE &nbsp; ≈ ION CLOUD</p></div><div class=\\\"map-side\\\"><div class=\\\"eyebrow\\\">SECTOR \"'${String.fromCharCode(65+selected%5)}${1+Math.floor(selected/5)}</div><h3>${s.name}</h3><p>${n?`${n} hostile ${n===1?'\"'vessel':'vessels'} detected.\"'${selected===4?'\"' Command signature confirmed. Bring torpedoes.':''}\"'`:base?`Starbase ${base.name}. ${Math.ceil(base.health)}% integrity. Full repair, energy and torpedo resupply.`:s.storm?'\"'Ion cloud. No hostile contacts. A quiet place to recharge with deflectors lowered.':'No hostile contacts. Frontier space under your protection.'}</p><p class=\\\"context-hint\\\">\"'${selected===game.sector?'\"'CURRENT SECTOR':\"'`TRANSIT COST ${game.jumpCost(selected)} / ENERGY ${Math.floor(game.energy)}`}</p><button class=\"button primary\" data-action=\"jump\" ${selected===game.sector||game.energy<game.jumpCost(selected)?'\"'disabled':''}>Engage hyperspace ↗</button></div></div><div class=\\\"buttons\\\"><button class=\\\"button\\\" data-action=\\\"resume\\\">Return to flight</button></div>\"'`,true);const focused=$('\"'modal').querySelector(\"'`[data-sector=\"${selected}\"]`);focused?.focus({preventScroll:true});}\nfunction openDev(){const rows=[['\"'enemyDamage','Enemy damage',0,25,1],['enemyRate','Enemy firing rate',.1,3,.1],['turnSpeed','Turn speed',.5,3,.05],['aimAssist','Aim assist cone',.9,.999,.001],['energyDrain','Energy use / recharge',.1,3,.1],['weaponDamage','Cannon damage',10,100,1]];setModal('dev',\"'`<div class=\"eyebrow\">DEVELOPMENT / LIVE FLIGHT DECK</div><h2>Fly. Break. Tune. Repeat.</h2>${rows.map(([key,label,min,max,step])=>`<label class=\"slider-row\"><span>${label}</span><input data-tune=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${game.tuning[key]}\"><output>${game.tuning[key]}</output></label>`).join('\"'')}<label class=\\\"slider-row\\\"><span>Simulation speed</span><input data-speed type=\\\"range\\\" min=\\\"0.25\\\" max=\\\"4\\\" step=\\\"0.25\\\" value=\\\"\"'${simSpeed}\"><output>${simSpeed}×</output></label><div class=\"buttons\"><button class=\"button\" data-action=\"god\">Invulnerable: ${game.god?'\"'ON':'OFF'}</button><button class=\\\"button\\\" data-action=\\\"resupply\\\">Repair & rearm</button><button class=\\\"button\\\" data-action=\\\"clear\\\">Clear sector</button><button class=\\\"button\\\" data-action=\\\"spawn\\\">Spawn raider</button><button class=\\\"button\\\" data-action=\\\"resetTune\\\">Reset defaults</button>\"'${backButton('\"'Pause menu')}</div><p class=\\\"fine\\\">All changes apply immediately. Dev assistance marks this patrol as a training flight.</p>\"'`,true);}\nfunction openOnline(){pausedFrom=game.running?'\"'flight':'title';setModal('online',\"'`<div class=\"eyebrow\">WING LINK / 1–4 PILOTS</div><h2>Never quite alone.</h2><p>Fly rival patrols across the same frontier. Other pilots appear as cyan ghost ships when you share a sector. Compare command points in AI Hub.</p><div class=\"brief-grid\"><div><h3>Across devices</h3><p>Launch this game together in an <b>AI Hub session</b>. The Hub handles invitations, countdowns, synchronized rounds and final standings.</p></div><div><h3>Local practice wing</h3><p>For two tabs in the same browser, open this same file or URL, then enter the same wing code.</p><div class=\"row\"><input id=\"roomCode\" type=\"text\" maxlength=\"8\" placeholder=\"WING CODE\" aria-label=\"Wing code\" value=\"${esc(net.room)}\"><button class=\"button\" data-action=\"joinRoom\">Link</button></div><button class=\"button\" data-action=\"hostRoom\">Generate wing code</button></div></div><p class=\"context-hint\" id=\"networkStatus\">${esc(net.status)}</p><div class=\"buttons\"><button class=\"button\" data-action=\"leaveRoom\" ${net.room?'\"'':'disabled'}>Disconnect local wing</button>\"'${backButton()}</div><p class=\"fine\">Ghost pilots have independent ships, enemies and scores. They cannot damage your ship. Local practice uses BroadcastChannel and does not cross devices.</p>`,true);}\nfunction openAbout(tab='\"'source'){modalTab=tab;pausedFrom=game.running?'flight':'title';const labels={source:'Source information',testing:'Testing feedback',engine:'Engine feedback',prompt:'Prompt feedback'};let content;if(tab==='source')content=\"'`<dl>${Object.entries(metadata.sourceInformation).map(([k,v])=>`<dt>${esc(k.replace(/([A-Z])/g,'\"' \"'$1'\"'))}</dt><dd>\"'${esc(v)}</dd>`).join('\"'')}</dl><p>Design, code, geometric art, synthesis & flight systems: OpenAI gpt-6.1-sol. Inspired by the pioneering cockpit and strategic-map spirit of Star Raiders. This is an original, unofficial game.</p><p>Open-source components: Three.js (MIT), Rapier (Apache-2.0), AI Hub session client. No external images, voices or audio recordings.</p>\"'`;else content=metadata[`${tab}Feedback`].map((a,i)=>`<p><b>${i+1}.</b> ${esc(a)}</p>`).join('\"'');setModal('about',\"'`<div class=\"eyebrow\">STELLAR RAIDERS / FLIGHT RECORD</div><h2>About this little universe.</h2><div class=\"credits-tabs\">${Object.entries(labels).map(([k,v])=>`<button class=\"button ${k===tab?'\"'primary':''}\\\" data-action=\\\"creditsTab\\\" data-tab=\\\"\"'${k}\">${v}</button>`).join('\"'')}</div><div class=\\\"credits\\\" tabindex=\\\"0\\\">\"'${content}</div><div class=\"buttons\">${backButton()}</div>`,true);}\nfunction returnTitle(){if(net?.active)return;if(game){game.running=false;game.attract=false;}screen='\"'title';\"'$('\"'menu').hidden=false;\"'$('\"'hud').hidden=true;\"'$('\"'modal').hidden=true;\"'$('\"'attractBanner').hidden=true;\"'$('\"'jumpOverlay').hidden=true;document.body.classList.remove('in-flight');if(document.pointerLockElement)document.exitPointerLock();keys.clear();pointer.fire=false;lastActivity=performance.now();}\nfunction startGame(attract=false){if(hubEnded)return;game.launch(attract);screen='flight';\"'$('\"'menu').hidden=true;\"'$('\"'hud').hidden=false;\"'$('\"'modal').hidden=true;\"'$('\"'attractBanner').hidden=\"'!attract;document.body.classList.add('\"'in-flight');attractTime=0;attractStage=0;simSpeed=1;visuals.setSector(game);if(\"'!attract){audio.unlock();audio.setMuted(false);}lastActivity=performance.now();}\nfunction finish(data){if(game.attract)return;if(net.active)net.finish(game.score,stats());let best=0;try{best=+localStorage.getItem('\"'stellar-best')||0;if(game.score>best)localStorage.setItem('stellar-best',game.score);}catch{}setModal('debrief',\"'`<div class=\"eyebrow\">${game.god?'\"'TRAINING FLIGHT / ':''}MISSION DEBRIEF / \"'${data.won?'\"'FRONTIER SECURE':'SIGNAL LOST'}</div><h2>\"'${data.won?'\"'A very big problem. Solved.':'The stars remember.'}</h2><p>\"'${data.won?'\"'The raider fleet is scattered. Starbase crews are already arguing over who buys the first round.':'Command has your flight recorder. Another patrol will carry the light.'}</p><div class=\\\"stat-grid\\\"><div><strong>\"'${game.score.toLocaleString()}</strong><span>COMMAND POINTS</span></div><div><strong>${game.kills} / 13</strong><span>RAIDERS DESTROYED</span></div><div><strong>${game.aliveBases} / 2</strong><span>STARBASES SAVED</span></div><div><strong>${Math.floor(game.time/60)}:${String(Math.floor(game.time%60)).padStart(2,'\"'0')}</strong><span>FLIGHT TIME</span></div><div><strong>\"'${Math.round(game.hits/Math.max(1,game.shots)*100)}%</strong><span>WEAPON ACCURACY</span></div><div><strong>${game.jumps}</strong><span>HYPERSPACE JUMPS</span></div></div><p class=\"context-hint\">${data.won?(game.aliveBases===2?'\"'RATING: STAR COMMANDER':'RATING: FRONTIER ACE'):'RATING: A BRAVE LITTLE SHIP'} · BEST \"'${Math.max(best,game.score).toLocaleString()}</p><div class=\"buttons\">${net.active?'\"'<span>Awaiting the Hub’s final standings.</span>':'<button class=\\\"button primary\\\" data-action=\\\"start\\\">Fly another patrol</button><button class=\\\"button\\\" data-action=\\\"title\\\">Return to command</button>'}<button class=\\\"button\\\" data-action=\\\"about\\\">Flight record</button></div>\"'`,true);}\nfunction stats(){return {'\"'Raiders destroyed':game.kills,'Bases saved':game.aliveBases,'Clean transits':game.jumps,'Hull remaining':Math.round(game.hull)};}\nfunction context(){if(\"'!game.running)return;if(game.base){const p=game.position,q=game.stationPosition;game.yaw=Math.atan2(-(q.x-p.x),-(q.z-p.z));game.pitch=Math.atan2(q.y-p.y,Math.hypot(q.x-p.x,q.z-p.z));game.throttle=dist(p,q)>110?.7:0;game.autopilot=true;game.say('\"'DOCK CONTROL','Approach assist engaged. Keep clear of the habitat ring.');}else openMap();}\nfunction action(name,el){if(\"'!ready||hubEnded)return;audio.unlock();audio.sfx('\"'select');switch(name){case'start':if(\"'!net.active)startGame();break;case'\"'title':returnTitle();break;case'pause':openPause();break;case'resume':closeModal();break;case'back':if(pausedFrom==='flight'&&game.running)openPause();else returnTitle();break;case'manual':openManual();break;case'settings':openSettings();break;case'online':openOnline();break;case'about':openAbout();break;case'creditsTab':openAbout(el.dataset.tab);break;case'map':openMap();break;case'sector':selected=+el.dataset.sector;drawMap();break;case'jump':if(game.beginJump(selected))closeModal();break;case'context':context();break;case'dev':openDev();break;case'god':game.god=\"'!game.god;openDev();break;case'\"'resupply':game.hull=game.shield=game.energy=100;game.missiles=6;game.god=true;note('Training resupply complete');break;case'clear':game.god=true;for(const e of [...game.enemies])game.kill(e);openDev();break;case'spawn':game.god=true;game.roster[game.sector]??=[];game.roster[game.sector].push('raider');game.spawnEnemy('raider',game.enemies.length);note('Training raider spawned');break;case'resetTune':game.tuning={...DEFAULTS};simSpeed=1;openDev();break;case'glyphs':settings.glyphs=settings.glyphs==='playstation'?'xbox':'playstation';saveSettings();openSettings();break;case'motion':settings.reducedMotion=\"'!settings.reducedMotion;saveSettings();openSettings();break;case'\"'fullscreen':if(document.fullscreenElement)document.exitFullscreen();else document.documentElement.requestFullscreen().catch(()=>note('Fullscreen unavailable in this browser'));break;case'hostRoom':net.hostRoom();openOnline();break;case'joinRoom':if(\"'!net.joinRoom($('\"'roomCode').value))note('Enter a wing code first');else openOnline();break;case'leaveRoom':net.leaveRoom();openOnline();break;}}\ndocument.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b){if(activity(lastInput==='touch'?'touch':'keyboard'))return;action(b.dataset.action,b);}});\ndocument.addEventListener('pointerover',e=>{const b=e.target.closest('button,input');if(b&&e.pointerType==='mouse'){b.focus({preventScroll:true});}});\ndocument.addEventListener('input',e=>{const el=e.target;if(el.dataset.setting){const k=el.dataset.setting;settings[k]=+el.value;el.nextElementSibling.textContent=el.value+(k==='sensitivity'?'×':'%');audio.setMusic(settings.music/100);audio.setVolume(settings.volume/100);saveSettings();}if(el.dataset.tune){game.tuning[el.dataset.tune]=+el.value;el.nextElementSibling.textContent=el.value;}if(el.hasAttribute('data-speed')){simSpeed=+el.value;el.nextElementSibling.textContent=el.value+'×';}lastActivity=performance.now();});\nwindow.addEventListener('keydown',e=>{if(activity('keyboard')){e.preventDefault();return;}if(\"'!ready||hubEnded)return;audio.unlock();if(['\"'Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code)&&screen==='flight')e.preventDefault();if(e.repeat){keys.add(e.code);return;}keys.add(e.code);if(e.code==='Escape'){e.preventDefault();if(screen==='flight')openPause();else if(screen==='map')closeModal();else if(game.running)openPause();else returnTitle();return;}if(screen==='flight'){if(e.code==='KeyM'){openMap();return;}if(e.code==='KeyT')game.cycleTarget();if(e.code==='KeyR')game.missile();if(e.code==='KeyE')game.toggleShield();if(e.code==='KeyH')context();}else if(screen==='map'&&e.code.startsWith('Arrow')){e.preventDefault();selected=clamp(selected+({ArrowLeft:-1,ArrowRight:1,ArrowUp:-5,ArrowDown:5}[e.code]),0,19);drawMap();}else if(e.code==='Enter'&&screen==='title')action('start');});\nwindow.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();pointer.fire=false;if(screen==='flight'&&\"'!game.attract&&!net.active)openPause();});\nwindow.addEventListener('\"'mousemove',e=>{if(activity('keyboard'))return;pointer.inside=true;pointer.x=e.clientX/innerWidth*2-1;pointer.y=e.clientY/innerHeight*2-1;if(document.pointerLockElement){pointer.dx+=e.movementX;pointer.dy+=e.movementY;}});\ncanvas.addEventListener('mousedown',e=>{if(activity('keyboard')||screen\"'!=='\"'flight'||hubEnded)return;audio.unlock();if(e.button===0){pointer.fire=true;if(\"'!document.pointerLockElement)canvas.requestPointerLock?.();}if(e.button===2)game.missile();});window.addEventListener('\"'mouseup',()=>pointer.fire=false);window.addEventListener('contextmenu',e=>e.preventDefault());\ncanvas.addEventListener('pointerdown',e=>{if(e.pointerType\"'!=='\"'touch')return;e.preventDefault();if(activity('touch'))return;document.body.classList.add('touch');audio.unlock();if(screen\"'!=='\"'flight')return;canvas.setPointerCapture(e.pointerId);if(e.clientX<innerWidth/2)touch.look={id:e.pointerId,x:e.clientX,y:e.clientY};else touch.thrust={id:e.pointerId,x:e.clientX,y:e.clientY};});canvas.addEventListener('pointermove',e=>{if(e.pointerType\"'!=='\"'touch')return;if(touch.look?.id===e.pointerId){touch.x=clamp((e.clientX-touch.look.x)/85,-1,1);touch.y=clamp((e.clientY-touch.look.y)/85,-1,1);}if(touch.thrust?.id===e.pointerId){touch.boost=e.clientY<touch.thrust.y-100;touch.thrust.value=clamp((touch.thrust.y-e.clientY)/80,-1,1);}});function endTouch(e){if(touch.look?.id===e.pointerId){touch.look=null;touch.x=touch.y=0;}if(touch.thrust?.id===e.pointerId){touch.thrust=null;touch.boost=false;}}canvas.addEventListener('pointerup',endTouch);canvas.addEventListener('pointercancel',endTouch);\nfunction menuMove(x,y){if(screen==='map'&&Math.abs(y)+Math.abs(x)>0){selected=clamp(selected+(x?Math.sign(x):Math.sign(y)*5),0,19);drawMap();return;}const current=document.activeElement;if(current?.type==='range'&&x){current.value=+current.value+Math.sign(x)*(+current.step||1);current.dispatchEvent(new Event('input',{bubbles:true}));return;}const root=\"'$('\"'modal').hidden?\"'$('\"'menu'):\"'$('\"'modal');const items=[...root.querySelectorAll('button:not(:disabled),input,[tabindex=\\\"0\\\"]')].filter(el=>el.getBoundingClientRect().width>0);let i=items.indexOf(current);i=(i+(y||x>0?1:-1)+items.length)%items.length;items[i]?.focus();}\nfunction pollPad(now){const pad=[...(navigator.getGamepads?.()||[])].find(p=>p?.connected);if(\"'!pad){padButtons=[];return null;}const axes=pad.axes.map(v=>Math.abs(v)<.14?0:v);const buttons=pad.buttons.map(b=>b.pressed);const changed=buttons.some((v,i)=>v&&!padButtons[i])||axes.some((v,i)=>Math.abs(v-lastPadAxes[i])>.1);if(changed){if(activity('\"'gamepad')){padButtons=buttons;return null;}audio.unlock();}const edge=i=>buttons[i]&&\"'!padButtons[i];if(!hubEnded){if(edge(9)&&!buttons[8]){if(screen==='\"'flight')openPause();else if(game.running)closeModal();}if(screen==='flight'){if(edge(3))openMap();if(edge(2))game.cycleTarget();if(edge(5))game.missile();if(edge(4))game.toggleShield();if(edge(1))context();}else{if(edge(0))document.activeElement?.click();if(edge(1)){if(game.running)closeModal();else returnTitle();}const x=(buttons[15]?1:0)-(buttons[14]?1:0)||(Math.abs(axes[0])>.55?Math.sign(axes[0]):0);const y=(buttons[13]?1:0)-(buttons[12]?1:0)||(Math.abs(axes[1])>.55?Math.sign(axes[1]):0);if((x||y)&&now-padLastNav>210){menuMove(x,y);padLastNav=now;}if(Math.abs(axes[3])>.2){const credits=\"'$('\"'modal').querySelector('.credits');if(credits)credits.scrollTop+=axes[3]*16;}}}padButtons=buttons;lastPadAxes=axes;return {axes,buttons};}\nfunction autoPilot(dt){const target=game.target&&\"'!game.target.dead?game.target:game.enemies.find(e=>!e.dead);if(!target)return {yaw:0,pitch:0,thrust:-1};game.target=target;const p=game.position,q=target.body.translation();const yaw=Math.atan2(-(q.x-p.x),-(q.z-p.z));const pitch=Math.atan2(q.y-p.y,Math.hypot(q.x-p.x,q.z-p.z));let dy=yaw-game.yaw;dy=Math.atan2(Math.sin(dy),Math.cos(dy));return {yaw:clamp(dy*3,-1.8,1.8),pitch:clamp((pitch-game.pitch)*3,-1.8,1.8),thrust:game.throttle>.32?-1:0,fire:Math.abs(dy)<.2&&Math.abs(pitch-game.pitch)<.2};}\nfunction runAttract(dt){attractTime+=dt;if(attractTime>125||game.won||game.lost){startGame(true);return;}if(!game.jump){if(attractStage===0&&(game.enemies.length===0||attractTime>17)){game.enterSector(16);visuals.setSector(game);game.player.setTranslation({x:0,y:0,z:-330},true);game.throttle=0;attractStage=1;}else if(attractStage===1&&game.docks>0){game.beginJump(7);attractStage=2;}else if(attractStage>=2&&game.enemies.length===0){const next=[7,3,4,11].find(id=>game.roster[id].length&&game.sector!==id);if(next!==undefined)game.beginJump(next);else startGame(true);}}const input=attractStage===1?{thrust:-1}:autoPilot(dt);if(attractStage>1&&Math.floor(attractTime*2)%7===0)game.missile();return input;}\nfunction getInput(dt,pad){if(debugInput)return {...debugInput};if(game.attract)return runAttract(dt)||{};let yaw=0,pitch=0;if(document.pointerLockElement){yaw=-pointer.dx*.0027/Math.max(dt,.001);pitch=-pointer.dy*.0027/Math.max(dt,.001);}else if(pointer.inside&&lastInput==='\"'keyboard'){yaw=-pointer.x*.8;pitch=-pointer.y*.8;}pointer.dx=pointer.dy=0;yaw+=(keys.has('ArrowLeft')?1:0)-(keys.has('ArrowRight')?1:0);pitch+=(keys.has('ArrowUp')?1:0)-(keys.has('ArrowDown')?1:0);let thrust=(keys.has('KeyW')?1:0)-(keys.has('KeyS')?1:0);let strafe=(keys.has('KeyD')?1:0)-(keys.has('KeyA')?1:0);let fire=pointer.fire||keys.has('Space'),boost=keys.has('ShiftLeft')||keys.has('ShiftRight');if(pad&&lastInput==='gamepad'){yaw=-pad.axes[0];pitch=-pad.axes[1];thrust=-pad.axes[3];strafe=pad.axes[2];fire=pad.buttons[7];boost=pad.buttons[6];}if(lastInput==='touch'){yaw=-touch.x;pitch=-touch.y;thrust=touch.thrust?.value||0;fire=\"'!!game.aimTarget();boost=touch.boost;if(game.target&&!game.target.dead&&game.missiles>0&&game.missileCooldown<=0&&Math.random()<dt*.13)game.missile();}if(game.autopilot){const p=game.position,q=game.stationPosition;if(dist(p,q)<110){game.throttle=0;thrust=-1;}else{const desiredYaw=Math.atan2(-(q.x-p.x),-(q.z-p.z));yaw=clamp(Math.atan2(Math.sin(desiredYaw-game.yaw),Math.cos(desiredYaw-game.yaw))*3,-1,1);pitch=clamp((Math.atan2(q.y-p.y,Math.hypot(q.x-p.x,q.z-p.z))-game.pitch)*3,-1,1);}if(game.docked||Math.abs(touch.x)+Math.abs(touch.y)>0||keys.has('\"'KeyW')||keys.has('KeyA')||keys.has('KeyD'))game.autopilot=false;}return {yaw:clamp(yaw*settings.sensitivity,-3,3),pitch:clamp(pitch*settings.sensitivity,-3,3),thrust,strafe,fire,boost};}\nfunction drawRadar(){const c=\"'$('\"'radar'),ctx=c.getContext('2d'),w=c.width,h=c.height;ctx.clearRect(0,0,w,h);ctx.strokeStyle='#365662';ctx.lineWidth=1;for(const r of[25,48,69]){ctx.beginPath();ctx.ellipse(w/2,h/2,r,r*.82,0,0,Math.PI*2);ctx.stroke();}ctx.beginPath();ctx.moveTo(20,h/2);ctx.lineTo(w-20,h/2);ctx.moveTo(w/2,7);ctx.lineTo(w/2,h-7);ctx.stroke();const p=game.position;function dot(q,color,size=4){const dx=q.x-p.x,dz=q.z-p.z,cs=Math.cos(game.yaw),sn=Math.sin(game.yaw);let x=(dx*cs-dz*sn)*.14,z=(dx*sn+dz*cs)*.14;const k=Math.max(1,Math.hypot(x,z)/65);x/=k;z/=k;ctx.fillStyle=color;ctx.fillRect(w/2+x-size/2,h/2+z-size/2,size,size);}for(const e of game.enemies)if(\"'!e.dead)dot(e.body.translation(),e===game.target?'\"'#fff4c2':'#ed805d',e.type==='flagship'?7:4);if(game.base)dot(game.stationPosition,'#75d6be',7);for(const e of visuals.ghosts.values())if(e.data.sector===game.sector)dot(e.data,'#7dcbdc',4);ctx.fillStyle='#d3efa1';ctx.beginPath();ctx.moveTo(w/2,h/2-7);ctx.lineTo(w/2-5,h/2+4);ctx.lineTo(w/2+5,h/2+4);ctx.fill();}\nfunction updateHUD(now){for(const k of['shield','hull','energy','heat']){\"'$(k+'\"'Value').textContent=Math.round(game[k]);\"'$(k+'\"'Bar').style.width=game[k]+'%';}\"'$('\"'shieldBar').style.opacity=game.shields?1:.2;\"'$('\"'sectorLabel').textContent=\"'`${String.fromCharCode(65+game.sector%5)}${1+Math.floor(game.sector/5)} / ${game.sectors[game.sector].name}`;$('\"'statusLabel').textContent=game.docked?'SERVICE COMPLETE':game.docking>0?\"'`DOCKING ${Math.round(game.docking/3*100)}%`:game.energy<25?'\"'ENERGY RESERVE LOW':\"'!game.shields?'\"'DEFLECTORS OFFLINE':'DEFLECTORS ONLINE';\"'$('\"'speedValue').textContent=game.docked?'0':Math.round(12+game.throttle*92);\"'$('\"'killsValue').textContent=game.kills;\"'$('\"'basesValue').textContent=game.aliveBases;\"'$('\"'ammoValue').textContent=game.missiles;\"'$('\"'missionProgress').textContent=\"'`${game.kills} / 13`;$('\"'objective').textContent=game.base?(game.docked?'Ship ready. Plot the next intercept.':'Approach slowly to repair & resupply'):game.enemies.length?(game.sector===4?'Destroy the raider command ship':'Clear the raider squadron'):'Sector secure. Plot your next jump.';\"'$('\"'navTarget').textContent=game.jump?game.sectors[game.jump.to].name:\"'`${game.remaining} CONTACTS REMAIN`;$('\"'threatValue').textContent=game.bases.map(b=>\"'`${b.name} ${Math.ceil(b.health)}%`).join('\"' / ');\"'$('\"'prompts').textContent=promptText();\"'$('\"'jumpOverlay').hidden=\"'!game.jump;if(game.jump)$('\"'jumpOverlay').querySelector('strong').textContent=game.jump.alignment>2?'CORRIDOR STABLE':'HOLD YOUR COURSE';\"'$('\"'comms').style.opacity=now<messageUntil?'1':'0';const target=game.target;if(target&&\"'!target.dead){const q=target.body.translation(),p=visuals.project(q);$('\"'targetInfo').hidden=false;\"'$('\"'targetInfo').classList.toggle('offscreen',\"'!p.visible);$('\"'targetInfo').style.left=p.x+'px';\"'$('\"'targetInfo').style.top=p.y+'px';\"'$('\"'targetInfo').innerHTML=\"'`<span class=\"target-box\">${p.visible?'\"'':'↶'}</span><small>\"'${target.type.toUpperCase()} · ${Math.round(dist(game.position,q))}u</small><small>${Math.max(0,Math.ceil(target.hp/target.maxHp*100))}% ARMOUR</small>`;}else $('\"'targetInfo').hidden=true;const touchMode=lastInput==='touch';\"'$('\"'touchAction').hidden=\"'!touchMode||(!game.base&&game.enemies.length>0)||screen!=='\"'flight';\"'$('\"'touchAction').textContent=game.base?'DOCK ASSIST':'SECTOR CHART';drawRadar();}\nfunction handleEvent(type,data){if(\"'!visuals)return;switch(type){case'\"'sector':visuals.setSector(game);break;case'spawn':visuals.addEnemy(data);break;case'removeEnemy':visuals.removeEnemy(data);break;case'shot':visuals.shot(data);break;case'removeShot':visuals.removeShot(data);break;case'explosion':visuals.explode(data.position,data.big);break;case'impact':visuals.impact(data.position);break;case'sound':if(\"'!game.attract)audio.sfx(data);break;case'\"'damage':if(\"'!settings.reducedMotion)visuals.shake=.8;$('\"'flash').classList.add('active');setTimeout(()=>\"'$('\"'flash').classList.remove('active'),180);break;case'message':\"'$('\"'speaker').textContent=data.speaker;\"'$('\"'message').textContent=data.text;messageUntil=performance.now()+6500;if(\"'!game.attract)audio.voice(game.kills+game.sector);break;case'\"'finish':finish(data);break;}}\nlet last=performance.now();function loop(now){const dt=Math.min((now-last)/1000,.05);last=now;const pad=pollPad(now);if(ready){if(screen==='title'&&\"'!net.active&&now-lastActivity>10000)startGame(true);if(screen==='\"'flight'&&\"'!hubEnded&&net.canPlay()){let remain=dt*simSpeed;const input=getInput(dt,pad);while(remain>.00001){const step=Math.min(remain,1/60);game.update(step,input);remain-=step;}}if(net.active||game.running)net.tick(dt,game.snapshot(),game.score);if(!net.active||net.canPlay()){updateHUD(now);audio.setIntensity(screen==='\"'flight'&&game.enemies.length?game.sector===4?1:.5:0);}else if(\"'!hubEnded){$('\"'statusLabel').textContent='AWAITING HUB LAUNCH';}visuals.render(dt,game,screen==='title'||(pausedFrom==='title'&&\"'!game.running));frameCount++;}requestAnimationFrame(loop);}\nasync function boot(){try{await RAPIER.init();game=new Campaign(handleEvent);visuals=new Visuals(canvas);await visuals.init();visuals.setSector(game);net=new Network({start:()=>startGame(),end:()=>{hubEnded=true;game.running=false;pointer.fire=false;keys.clear();audio.setMuted(true);$('\"'modal').hidden=true;\"'$('\"'attractBanner').hidden=true;},timeup:()=>({score:game.score,stats:stats()}),ghost:(data,id)=>visuals.ghost(data,id),leave:id=>visuals.removeGhost(id)});ready=true;\"'$('\"'loading').hidden=true;\"'$('\"'bootStatus').textContent=\"'`${visuals.backend.toUpperCase()} / FLIGHT SYSTEMS READY`;if(navigator.maxTouchPoints>0){document.body.classList.add('\"'touch');lastInput='touch';}if(net.active){\"'$('\"'menu').hidden=true;\"'$('\"'hud').hidden=false;screen='waiting';}await net.init();window.__stellar={game,visuals,audio,network:net,action:(name)=>action(name),state:()=>({...game.debug(),screen,input:lastInput,renderer:visuals.backend,frames:frameCount,hubEnded,audio:audio.debug()}),setInput:v=>debugInput=v,start:()=>startGame(),returnTitle,openMap,openDev};last=performance.now();requestAnimationFrame(loop);\"'$('\"'menu').querySelector('[data-action=start]')?.focus({preventScroll:true});}catch(error){console.error(error);\"'$('\"'loading').querySelector('strong').textContent='Flight systems need attention.';\"'$('\"'loading').querySelector('p').textContent=error.message+' — A current Chromium browser with internet access is recommended.';globalThis.AIHub?.fail?.(error.message);window.__bootError=error.message;}}\nboot();\nEOF\nnode --check main.js\"","aggregated_output":"","exit_code":0,"status":"completed"}}
