{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js';s=open(p).read().replace(\\\"\"'${b?'\"'base':''}\\\", \\\"\"'${b?(b.health>0?'\"'base':'danger'):''}\\\").replace(\\\"n?'✦':b?'◇':s.storm\\\", \\\"n?'✦':b?(b.health>0?'◇':'×'):s.storm\\\")\ns=s.replace(\\\"base?\"'`Starbase ${base.name}. ${Math.ceil(base.health)}% integrity. Full repair, energy and torpedo resupply.`\", \"base?(base.health>0?`Starbase ${base.name}. ${Math.ceil(base.health)}% integrity. Full repair, energy and torpedo resupply.`:`Starbase ${base.name} is lost. No docking services remain.`)\")\nopen(p,'\"'w').write(s)\np='visuals.js';s=open(p).read().replace(\\\"}else{this.station.rotation.y=0;\\\", \\\"}else{this.station.visible=\"'!!game.base;this.station.rotation.y=0;\");open(p,'\"'w').write(s)\nPY\nnode --check main.js\npython3 - <<'PY'\nimport json,pathlib\np=pathlib.Path('browser-progress.json')\nif p.exists():\n d=json.loads(p.read_text());print('Checks completed:',len(d));print('Last:',d[-1]['name']);print('Failures:',[x for x in d if not x['pass']])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
