mode':'ghost','hub:session-minutes':'3','hub:session-goal':'Stay balanced through the class: highest score wins','hub:session-howto':'Lean: stick, WASD or mouse. Feet: L2 R2, Q E or clicks. Flail: Square or F','hub:type':'Game','hub:players':'1-4','hub:source':'Wii Fit'};\nconst out=['<\"'!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>'\"',session,'</script>',Object.entries(metas).map(([name,content])=>\"'`<meta name=\"${name}\" content=\"${content}\">`).join('\"''),'<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,viewport-fit=cover\\\">',\"'`<title>${TITLE} · Level Best Retreat</title><meta name=\"description\" content=\"${TAGLINE}\"><style>`,[400,500,600].map(w=>`@font-face{font-family:Fredoka;font-style:normal;font-weight:${w};font-display:swap;src:url(data:font/woff2;base64,${font(w)}) format('\"'woff2')}\"'`).join('\"''),readFileSync('src/ui/ui.css','utf8'),'</style></head><body><div id=\\\"boot\\\" class=\\\"error\\\">Stretching…<br><small>Trudy is finding the middle.</small></div><script>',js,'</script></body></html>'].join('');writeFileSync('../'+project.slug+'.html',out);writeFileSync('game.html',out);console.log(\"'`${project.slug}.html · ${(out.length/1048576).toFixed(2)} MB`);\nEOF\ncat > src/main.js <<'\"'EOF'\nimport {View} from './render/renderer.js';\nimport {Input} from './input/input.js';\nimport {AudioEngine} from './audio/engine.js';\nimport {Save} from './core/save.js';\nimport {UI} from './ui/ui.js';\nimport {FruitHat} from './events/fruit.js';\nimport {tuning} from './data/tuning.js';\nimport {R} from './physics/world.js';\nasync function main(){const connect=AIHub.active?AIHub.connect({mode:'ghost',seats:[1,4],card:true}):null;await R.init();let view=await new View().init(new URLSearchParams(location.search).get('render')==='0');let save=new Save(),input=new Input(),game={view,save,input,settings:save.settings,tuning,dev:{god:false},errors:[],fx(){},bark(){}};game.audio=new AudioEngine(game.settings);game.ui=new UI(game);window.__game=game;game.event=new FruitHat(game,'fruit',1,[{name:'Gentle Margaret'}]);game.event.start();game.ui.eventHud(game.event);input.onPadGesture=()=>game.audio.unlock();let acc=0,last=performance.now();const fixed=dt=>{const s=input.poll(dt);game.event.fixed(dt,[s]);};const frame=dt=>{game.event.frame(dt);game.ui.updateEvent(game.event);view.frame(dt,game.settings);game.audio.update();};const advance=sec=>{for(let i=0;i<Math.ceil(sec*120);i++)fixed(1/120);game.event.frame(0);game.ui.updateEvent(game.event);};window.__TEST__={state:()=>({event:game.event.state(),render:{backend:view.backend,lost:view.lost,frames:view.frames},errors:game.errors}),advance};document.querySelector('#boot')?.remove();if(connect){const info=await connect;if(info){AIHub.on('time-up',()=>AIHub.result({score:0}));AIHub.ready();}}function loop(now){let dt=Math.min((now-last)/1000,.25);last=now;acc+=dt;for(let i=0;acc>=1/120&&i<30;i++){fixed(1/120);acc-=1/120;}frame(dt);requestAnimationFrame(loop);}if(\"'!new URLSearchParams(location.search).has('\"'manual'))requestAnimationFrame(loop);else frame(0);}\nmain().catch(e=>{console.error(e);document.querySelector('#boot').textContent='Unable to start: '+e.message;AIHub.fail(e.message);});\nEOF\nnode tools/build.mjs\"","aggregated_output":"Wee-Knit-Wii-Fit-gpt-6.1-sol-max-20261104-232145.html · 3.04 MB\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"cat > tools/test.mjs <<'EOF'\nimport {chromium} from 'playwright';\nimport {resolve} from 'node:path';\nimport {mkdirSync} from 'node:fs';\nconst groups=process.argv.slice(2),RENDER=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--use-vulkan=swiftshader','--use-angle=swiftshader'];\nlet pass=0,fail=0;const check=(v,msg)=>{if(v)pass++;else{fail++;console.log('FAIL '+msg);}};\nconst browser=await chromium.launch({headless:true,args:groups.includes('render')?RENDER:[]});const page=await browser.newPage({viewport:{width:1280,height:720}});let errors=[];page.on('pageerror',e=>errors.push(e.message));\nawait page.addInitScript(()=>{window.__pads=[{connected:true,mapping:'standard',index:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))}];navigator.getGamepads=()=>window.__pads;});\ntry{await page.goto('file://'+resolve('game.html')+'?test=1&manual=1'+(groups.includes('render')?'':'&render=0'));await page.waitForFunction(()=>window.__TEST__,{timeout:20000});\nconst result=await page.evaluate(()=>{let g=window.__game;for(let i=0;i<120*60;i++){let s=g.event.botInput(g.event.lanes[0],g.event.t,'sharp'),pad=window.__pads[0];pad.axes[0]=s.x;pad.axes[1]=s.z;pad.buttons[0]={pressed:s.hopPress,value:s.hopPress?1:0};__TEST__.advance(1/120);}return __TEST__.state();});check(result.event.lanes[0].score>10,'Fruit catches and banks: '+JSON.stringify(result.event));check(result.event.phase==='done','Fruit completes');check(result.event.lanes[0].falls<5,'Fruit survives frequent banking');check(errors.length===0,'JS errors: '+errors.join(', '));\nif(groups.includes('render')){await page.evaluate(()=>{__game.view.render();});await page.waitForTimeout(1500);let s=await page.evaluate(()=>__TEST__.state());check(s.render.backend==='webgpu','WebGPU active');check(\"'!s.render.lost,'\"'GPU device alive');mkdirSync('shots',{recursive:true});await page.screenshot({path:'shots/fruit-initial.png'});}\n}catch(e){check(false,e.stack);}finally{await browser.close();}console.log(\"'`${pass} passed, ${fail} failed`);process.exitCode=fail?1:0;\nEOF\nnode tools/test.mjs m1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
