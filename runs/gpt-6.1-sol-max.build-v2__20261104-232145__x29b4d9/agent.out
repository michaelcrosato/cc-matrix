{"type":"item.completed","item":{"id":"item_138","type":"command_execution","command":"/bin/bash -lc \"rg -n 'rock|pivot|ConeGeometry\\\\(19' src/art/island.js && sed -n '12,23p' src/render/renderer.js && head -4 notes/test-last.json\"","aggregated_output":"6:export function makeIsland(){let root=group();cyl(root,0xe6d0a5,0,-.36,0,22,.7);let grass=cyl(root,0xa8bd87,0,-.02,0,15,.08);cyl(root,0xbca58c,0,-1.1,0,20.4,.9,21.6);let rock=mesh(new T.ConeGeometry(19.5,11,14),0x8b9c9a,root,0,-6.3,0);rock.rotation.z=Math.PI;const pivot=ball(root,0xb2a591,0,-8.5,0,2.3,1,1.2,1);let road=torus(root,0xe8d7af,0,.035,0,18.7,.9);road.rotation.x=Math.PI/2;for(let i=0;i<45;i++){let a=i*Math.PI*2/45;box(root,0xf8eccd,Math.cos(a)*18.7,.08,Math.sin(a)*18.7,.13,.014,.7,-a);}let inner=torus(root,0xc7c29a,0,.02,0,12,.19);inner.rotation.x=Math.PI/2;\n const skyMat=new T.MeshBasicNodeMaterial({side:T.BackSide,depthWrite:false});skyMat.colorNode=Fn(()=>{const y=positionWorld.y.div(600);return mix(mix(this.paletteUniforms.skyLow,this.paletteUniforms.skyMid,smoothstep(0,.15,y)),this.paletteUniforms.skyTop,smoothstep(.12,.55,y));})();this.scene.add(new T.Mesh(new T.SphereGeometry(600,32,24),skyMat));this.clouds=group(this.scene);for(let i=0;i<15;i++){let g=group(this.clouds,Math.sin(i*7)*95,22+i%4*6,-70-Math.cos(i*3)*35);for(let j=0;j<3;j++)ball(g,0xffeedb,(j-1)*3,Math.sin(j)*.6,0,3.2,1.5,.35,.75);}\n if(skip)return this;\n this.renderer=new T.WebGPURenderer({antialias:true});this.renderer.setPixelRatio(Math.min(devicePixelRatio,1.7));this.renderer.setSize(innerWidth,innerHeight);this.renderer.toneMapping=T.NoToneMapping;this.renderer.shadowMap.enabled=true;this.renderer.shadowMap.type=T.PCFShadowMap;document.body.prepend(this.renderer.domElement);this.renderer.domElement.id='world';this.paper=document.createElement('div');this.paper.id='paper-grain';this.paper.innerHTML='<svg width=\"100%\" height=\"100%\" aria-hidden=\"true\"><filter id=\"paper-noise\"><feTurbulence type=\"fractalNoise\" baseFrequency=\".68\" numOctaves=\"3\" stitchTiles=\"stitch\"/></filter><rect width=\"100%\" height=\"100%\" filter=\"url(#paper-noise)\" opacity=\".5\"/></svg>';document.body.append(this.paper);await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'webgpu':'webgl2';const currentRenderer=this.renderer;this.renderer.backend.device?.lost.then(info=>{if(this.renderer!==currentRenderer)return;this.lost=info.message||info.reason||'Device lost';window.__game?.errors.push(this.lost);});this.ink=makeInk(this.renderer,this.scene,this.camera);window.addEventListener('resize',()=>this.resize());return this;\n }\n refreshScene(){const old=this.scene,next=new T.Scene();next.background=old.background;next.fog=old.fog;for(const child of [...old.children])next.add(child);this.scene=next;if(this.renderer){this.pendingReset=true;}}\n async recreateRenderer(){if(this.rebuilding)return this.ready;this.rebuilding=true;const old=this.renderer;this.renderer=null;old?.setAnimationLoop(null);old?.backend?.gl?.getExtension('WEBGL_lose_context')?.loseContext();old?.dispose();old?.domElement.remove();const r=new T.WebGPURenderer({antialias:true});r.setPixelRatio(Math.min(devicePixelRatio,1.7));r.setSize(innerWidth,innerHeight);r.toneMapping=T.NoToneMapping;r.shadowMap.enabled=true;r.shadowMap.type=T.PCFShadowMap;r.domElement.id='world';document.body.prepend(r.domElement);await r.init();this.renderer=r;this.backend=r.backend.isWebGPUBackend?'webgpu':'webgl2';r.backend.device?.lost.then(info=>{if(this.renderer!==r)return;this.lost=info.message||info.reason||'Device lost';window.__game?.errors.push(this.lost);});this.ink=makeInk(r,this.scene,this.camera);r.setAnimationLoop(()=>{});this.rebuilding=false;}\n setPalette(name){if(PALETTES[name])this.paletteName=name;}\n resize(){this.camera.aspect=innerWidth/innerHeight;this.camera.updateProjectionMatrix();this.renderer?.setSize(innerWidth,innerHeight);}\n setCamera(p,t,snap=false){this.wantPos.set(...p);this.wantTarget.set(...t);if(snap){this.camera.position.copy(this.wantPos);this.target.copy(this.wantTarget);this.camera.lookAt(this.target);}}\n frame(dt,settings){if(this.pendingReset&&!this.rebuilding){this.pendingReset=false;this.ready=this.recreateRenderer();}const pal=PALETTES[this.paletteName],blend=1-Math.exp(-dt);for(let [key,u] of Object.entries(this.paletteUniforms))u.value.lerp(new T.Color(pal[key]),blend);this.sun.color.lerp(new T.Color(pal.sun),blend);this.sun.intensity+=(pal.intensity-this.sun.intensity)*blend;this.hemi.color.lerp(new T.Color(pal.hemi),blend);this.hemi.groundColor.lerp(new T.Color(pal.ground),blend);this.scene.fog.color.lerp(new T.Color(pal.skyLow),blend);const k=1-Math.exp(-dt*4);this.camera.position.lerp(this.wantPos,k);this.target.lerp(this.wantTarget,k);this.camera.lookAt(this.target);this.clouds.rotation.y+=dt*.0015;if(this.ink&&!this.rebuilding&&this.renderer){let u=this.ink.u;u.hull.value=tuning.hull*settings.ink;u.width.value=tuning.lineWidth*settings.ink;u.boil.value=settings.reduceShake?0:tuning.boil;u.grain.value=tuning.grain;if(this.paper)this.paper.style.opacity=String(tuning.grain*1.7);u.far.value=this.camera.far;this.ink.render();this.frames++;}}\n render(){if(this.ink&&!this.rebuilding&&this.renderer){this.ink.render();this.frames++;}}\n}\n{\n  \"groups\": [\n    \"render\",\n    \"visual\"\n","exit_code":0,"status":"completed"}}
