{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/game/island.js';s=open(p).read();s=s.replace(\\\"else{x=input.rawX||input.x;z=input.rawZ||input.z;}let c=Math.cos(this.yaw),s=Math.sin(this.yaw),xx=x*c+z*s,zz=z*c-x*s;x=xx;z=zz;\\\", \\\"else{x=this.game.input.lastDevice==='pad'?input.x:(input.rawX||0);z=this.game.input.lastDevice==='pad'?input.z:(input.rawZ||0);let c=Math.cos(this.yaw),s=Math.sin(this.yaw),xx=x*c+z*s,zz=z*c-x*s;x=xx;z=zz;}\\\")\nopen(p,'w').write(s)\np='src/game/director.js';s=open(p).read().replace(\\\"const touch=this.input.touchOnly;this.ui.show\\\", \\\"const touch=this.input.touchOnly;this.titleTouch=touch;this.ui.show\\\")\ns=s.replace(\\\"const paused=['pause'\\\", \\\"if(this.screen==='title'&&this.titleTouch&&\"'!this.input.touchOnly){this.title();return;}'\"\\\\n const paused=['pause'\\\")\ns=s.replace(\\\"Math.cos(this.attractT*.45),lookX:.08},'tutorial'\\\", \\\"Math.cos(this.attractT*.45),lookX:.08},'walk'\\\")\nopen(p,'w').write(s)\np='src/events/base.js';s=open(p).read().replace(\\\"lane.input=lane.kind==='bot'?this.botInput\\\", \\\"this.cameraYaw=this.id==='grand'?Math.atan2(this.game.view.camera.position.x-this.game.view.target.x,this.game.view.camera.position.z-this.game.view.target.z):0;lane.input=lane.kind==='bot'?this.botInput\\\")\ns=s.replace(\\\"const b=lane.balancer;b.god\\\", \\\"if(this.cameraYaw){let c=Math.cos(this.cameraYaw),s=Math.sin(this.cameraYaw),x=lane.input.x||0,z=lane.input.z||0;lane.input={...lane.input,x:x*c+z*s,z:z*c-x*s};}const b=lane.balancer;b.god\\\")\ns=s.replace(\\\"this.botActions?.(lane,result,t,s,skill);return result;\\\", \\\"this.botActions?.(lane,result,t,s,skill);if(this.cameraYaw){let c=Math.cos(this.cameraYaw),s=Math.sin(this.cameraYaw),x=result.x,z=result.z;result.x=x*c-z*s;result.z=x*s+z*c;}return result;\\\")\nopen(p,'w').write(s)\np='src/ui/ui.js';s=open(p).read();old=\\\"target=l.target||e.target,x=clamp(bal.cob.x,-1.05,1.05)*82,z=clamp(bal.cob.z,-1.05,1.05)*82,inside=\\\";new=\\\"target=l.target||e.target,yaw=e.cameraYaw||0,c=Math.cos(yaw),s=Math.sin(yaw),screenX=bal.cob.x*c-bal.cob.z*s,screenZ=bal.cob.x*s+bal.cob.z*c,tx=target.x*c-target.z*s,tz=target.x*s+target.z*c,x=clamp(screenX,-1.05,1.05)*82,z=clamp(screenZ,-1.05,1.05)*82,inside=\\\";s=s.replace(old,new).replace(\\\"110+(l.input.x||0)*82\\\", \\\"110+((l.input.x||0)*c-(l.input.z||0)*s)*82\\\").replace(\\\"110+(l.input.z||0)*82\\\", \\\"110+((l.input.x||0)*s+(l.input.z||0)*c)*82\\\").replace(\\\"110+target.x*82\\\", \\\"110+tx*82\\\").replace(\\\"110+target.z*82\\\", \\\"110+tz*82\\\");open(p,'w').write(s)\nPY\ncat >> src/ui/ui.css <<'EOF'\n.choices button small,.topline,.event-tag,.widget,.event-message,.breath,.world-hotspot,.toast,.settings-row button,.totals span,.calendar div{font-size:max(2.78vh,.8em)}\n@media(max-aspect-ratio:1/1){.topline,.event-tag,.widget,.event-message,.breath,.world-hotspot,.toast{font-size:2.2vh}.settings-row button,.totals span,.calendar div{font-size:2.5vh}.title h1 span:after{height:.05em}}\nEOF\ncat >> notes/issues.md <<'EOF'\n- 14 [input] Mouse hover made the island walker move because pointer lean was being reused as walking. Island mouse movement now only aims at hotspots; clicking walks there. Also corrected click-to-walk after orbiting the camera.\n- 15 [input] A keyboard waking a touch-only title activated its old Settings button. Rebuild the title when a keyboard or controller becomes available.\n- 16 [input] The circling finale camera made lean directions drift away from screen directions. Rotate both wishes and the Balance Disc with the camera.\nEOF\nnode tools/build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
