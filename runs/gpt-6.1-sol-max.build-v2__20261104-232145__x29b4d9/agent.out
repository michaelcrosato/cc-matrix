{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/events/fruit.js';s=open(p).read().replace(\\\"R,PROP,rigid\\\",\\\"R,PROP,rigid,groups,RAG\\\")\ns=s.replace(\\\"p.spent=true;l.data.caught=Math.max(0,l.data.caught-1);l.data.spilled++;\\\", \\\"p.spent=true;p.expire=this.t+2;p.body.collider(0).setCollisionGroups(groups(RAG,1));l.data.caught=Math.max(0,l.data.caught-1);l.data.spilled++;\\\")\ns=s.replace(\\\"if(pos.y<-.1||this.t>p.landing+10&&\"'!p.caught)this.disable(p);\", \"if(!p.caught&&!p.spent&&pos.y<1.15&&this.t>p.landing-.1){p.spent=true;p.expire=this.t+2;p.body.collider(0).setCollisionGroups(groups(RAG,1));}if(pos.y<-.1||p.expire&&this.t>p.expire||this.t>p.landing+6&&!p.caught)this.disable(p);\")\ns=s.replace(\"p.spent=true;p.caught=false;p.body.applyImpulse\", \"p.spent=true;p.caught=false;p.expire=this.t+2;p.body.collider(0).setCollisionGroups(groups(RAG,1));p.body.applyImpulse\")\nopen(p,'\"'w').write(s)\nPY\ncat >> notes/issues.md <<'EOF'\n- 19 [critical physics] Spilled fruit stayed in the doll's collision lane on the floor, where it contacted the doll's feet and caused falls even with an empty hat. Spills now collide only with scenery, then retire after two seconds. Loaded fruit still uses real doll contacts.\nEOF\nnode tools/build.mjs && node tools/test.mjs fruit balance\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
