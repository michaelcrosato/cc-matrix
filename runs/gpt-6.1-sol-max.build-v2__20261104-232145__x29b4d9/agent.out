{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/events/fruit.js'\ns=open(p).read().replace('b.setLinvel({x:(x-start.x)/flight','b.setLinearDamping(0);b.setLinvel({x:(x-start.x)/flight').replace('if(\"'!p.caught&&this.t>p.landing-.15'\"','if(\"'!p.caught&&!p.spent&&this.t>p.landing-.15'\"')\nopen(p,'w').write(s)\np='src/events/base.js'\ns=open(p).read().replace('if(this.t>=this.duration)this.finish();','if(this.t+1e-7>=this.duration)this.finish();')\nopen(p,'w').write(s)\np='tools/test.mjs'\ns=open(p).read().replace(\\\"cob:g.event.lanes[0].balancer.cob\\\",\\\"cob:{...g.event.lanes[0].balancer.cob}\\\")\nopen(p,'w').write(s)\nPY\ncat >> notes/issues.md <<'EOF'\n- 01 [gameplay] Fruit inherited general prop damping, causing ballistic shots to land short. Set flight damping to zero; excluded spent fruit from recatching.\n- 02 [flow] Floating-point accumulation left an event just short of its timer. Added a fixed-step epsilon to completion.\nEOF\nnode tools/build.mjs && node tools/test.mjs m1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
