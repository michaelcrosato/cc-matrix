{"type":"item.completed","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"cat > tools/shots.mjs <<'EOF'\nimport {chromium} from 'playwright';\nimport {resolve} from 'node:path';\nimport {mkdirSync,writeFileSync,readFileSync} from 'node:fs';\nimport {execFile} from 'node:child_process';\nimport {promisify} from 'node:util';\nimport {EVENTS} from '../src/data/events.js';\nconst exec=promisify(execFile),RENDER=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--use-vulkan=swiftshader','--use-angle=swiftshader'];\nexport async function artShots(check){mkdirSync('shots/art',{recursive:true});const browser=await chromium.launch({headless:true,args:RENDER}),page=await browser.newPage({viewport:{width:1920,height:1080}});await page.addInitScript(()=>{window.__pads=[{connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({value:0,pressed:false}))}];Object.defineProperty(navigator,'getGamepads',{value:()=>__pads});});await page.goto('file://'+resolve('game.html')+'?test=1&manual=1');await page.waitForFunction(()=>window.__TEST__);await page.evaluate(()=>document.fonts.ready);\n async function shot(name){await page.evaluate(()=>{const g=__game;g.frame(.05);g.view.camera.position.copy(g.view.wantPos);g.view.target.copy(g.view.wantTarget);g.view.camera.lookAt(g.view.target);g.view.render();});await page.waitForTimeout(250);await page.screenshot({path:'shots/art/'+name+'.png'});let s=await page.evaluate(()=>__TEST__.state());check(\"'!s.render.lost&&!s.errors.length,'\"'Art '+name+' alive');}\n try{await shot('title');await page.evaluate(()=>__TEST__.goto('profile'));await shot('island-day-1');for(let e of EVENTS){await page.evaluate(id=>{__TEST__.goto('event',{id,play:true});__game.dev.bot=true;__TEST__.advance(id==='water'?34:id==='cairn'?19:id==='grand'?34:id==='step'?18:id==='spring'?6:9);},e.id);await shot(e.id);}\n await page.evaluate(()=>{__TEST__.goto('event',{id:'fruit',play:true});__game.event.finish();__game.results();});await shot('results');await page.evaluate(()=>__TEST__.goto('age',{age:74}));await page.evaluate(()=>__TEST__.advance(3));await shot('age');await page.evaluate(()=>__TEST__.goto('jar',{count:10}));await page.evaluate(()=>__TEST__.advance(2));await shot('jar');await page.evaluate(()=>{__TEST__.goto('island');__game.profile.steps=19;__game.profile.levelled=true;__game.island.walker.setTranslation({x:0,y:.81,z:10},true);});await page.evaluate(()=>__TEST__.advance(8));await shot('island-day-5');await page.evaluate(()=>{__TEST__.goto('event',{id:'fruit',play:true});__game.pause();__game.devMenu();});await shot('dev');await page.evaluate(()=>{__game.groupSeats=Array.from({length:4},(_,i)=>({name:['Margaret','Kevin','Sandra','Gerald'][i],device:'pad',pad:i,colour:['#e8443a','#3b82f6','#22c55e','#f5b700'][i]}));__game.startGroup(['fruit','poses','step']);__game.beginPlay();});await shot('group-four');await page.evaluate(()=>__game.about(0));await shot('about');}finally{await browser.close();}}\nexport async function viewportShots(check,engine='webkit'){mkdirSync('shots/matrix-'+engine,{recursive:true});const args=['file://'+resolve('game.html'),'-o',resolve('shots/matrix-'+engine),'--engines',engine,'--dpr1','--wait','2500','--timeout','45'];let cmd='viewport-matrix';if(engine==='firefox'){args.push('--only','desktop','--headed');args.unshift('viewport-matrix');cmd='xvfb-run';}try{const r=await exec(cmd,args,{maxBuffer:5000000,timeout:300000});writeFileSync('notes/matrix-'+engine+'.log',r.stdout+'\\\\n'+r.stderr);}catch(e){writeFileSync('notes/matrix-'+engine+'.log',(e.stdout||'')+'\\\\n'+(e.stderr||''));}let report=JSON.parse(readFileSync('shots/matrix-'+engine+'/report.json','utf8'));writeFileSync('notes/matrix-'+engine+'-shape.json',JSON.stringify(report,null,2));const list=Array.isArray(report)?report:report.results||report.viewports||[];for(let row of list){let errors=row.errors||row.pageErrors||[];let overflow=row.overflow||row.horizontalOverflow;check(\"'!row.error&&(!Array.isArray(errors)||!errors.length)&&!overflow,'\"'Viewport '+engine+' '+(row.name||row.device||row.label||JSON.stringify(row)));}}\nEOF\npython3 - <<'PY'\np='tools/test.mjs';s=open(p).read();pos=s.index(\\\"if(has('render'))\\\")\ns=s[:pos]+\\\"if(has('visual'))await test('art screenshots',async()=>{const {artShots}=await import('./shots.mjs');await artShots(check);});\\\\nif(has('matrix'))await test('viewport matrix',async()=>{const {viewportShots}=await import('./shots.mjs');for(const engine of ['webkit','chromium','firefox'])await viewportShots(check,engine);});\\\\n\\\"+s[pos:];open(p,'w').write(s)\np='src/events/fruit.js';s=open(p).read().replace(\\\" resultDetail(l){\\\", \\\" widget(){const d=this.lanes[0].data;return \"'`<b>${d.caught} in your hat</b><div class='\"\\\\\\\"meter\\\\\\\"><span style=\\\\\\\"width:\"'${Math.min(100,d.caught/12*100)}%;background:${d.caught>7?'\"'#d68665':'#88ad83'}\\\\\\\"></span></div>\"'${d.banked} banked · ×${(1+.1*Math.max(0,d.caught-1)).toFixed(1)}<br>Hop to bank the whole basket.`;}'\"\\\\n resultDetail(l){\\\")\nopen(p,'w').write(s)\nPY\nnode tools/build.mjs && node tools/test.mjs visual matrix\"","aggregated_output":"Wee-Knit-Wii-Fit-gpt-6.1-sol-max-20261104-232145.html · 3.15 MB\nFAIL viewport matrix: ENOENT: no such file or directory, open 'shots/matrix-firefox/report.json'\n51 passed, 1 failed\n","exit_code":1,"status":"failed"}}
