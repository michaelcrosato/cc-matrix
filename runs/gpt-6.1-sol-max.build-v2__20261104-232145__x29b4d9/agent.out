{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"sed -n '9,43p' src/physics/balancer.js && sed -n '7,45p' src/events/fruit.js\"","aggregated_output":" if(this.fallen>0){this.fallen-=dt;if(this.fallen<=0)this.recover();return;}\n if(input.flailPress&&this.cooldown<=0){this.flail=.35;this.cooldown=tuning.flailCooldown;this.onFlail?.();}\n const still=dist.still;const inhale=this.t%8<4;const breathe=this.settings.autoBreathe||input.breathe;if(still){this.breathTotal+=dt;if(breathe===inhale)this.breathGood+=dt;if(this.breathTotal>=8){this.breathBonus=this.breathGood/this.breathTotal>=.7;this.breathTotal=this.breathGood=0;}}\n const o=this.opts,diff=DIFFICULTY[this.settings.difficulty]||DIFFICULTY.Standard;\n const maxLean=rad((o.maxLean||18)*tuning.maxLean/18);this.maxLean=maxLean;\n let margin=(o.margin??.45)*tuning.margin/.45*(dist.oneFoot?.5:1),G=tuning.gravity*.75,I=.75*.75+.06,K=G*(1+margin),wn=Math.sqrt((K-G)/I),D=2*tuning.zeta*wn*I;\n const r=1-Math.exp(-(o.reflex||10)*tuning.reflex/10*dt);const mag=Math.max(1,Math.hypot(input.x||0,input.z||0)),ix=(input.x||0)/mag,iz=(input.z||0)/mag;this.wx+=(ix-this.wx)*r;this.wz+=(iz-this.wz)*r;\n let tx=this.wx*maxLean,tz=this.wz*maxLean,q=this.body.rotation(),ux=2*(q.x*q.y-q.w*q.z),uy=1-2*(q.x*q.x+q.z*q.z),uz=2*(q.y*q.z+q.w*q.x);\n this.leanX=Math.atan2(ux,uy);this.leanZ=Math.atan2(uz,uy);this.cob.x=this.leanX/maxLean;this.cob.z=this.leanZ/maxLean;\n let ang=this.body.angvel(),Tx=-(G*Math.sin(tx)+K*(this.leanX-tx))+D*ang.z,Tz=-(G*Math.sin(tz)+K*(this.leanZ-tz))-D*ang.x;\n let limit=(o.ankleMax||4.6)*tuning.ankleMax/4.6*diff.ankle*(this.flail>0?tuning.flailBoost:1),m=Math.hypot(Tx,Tz);if(m>limit){Tx*=limit/m;Tz*=limit/m;}\n let sway=(dist.sway??.1)*tuning.swayScale,tremor=(dist.tremor??.06)*tuning.tremorScale,t=this.t,ph=this.lane*1.77+1.26;let bonus=this.breathBonus&&still?.6:1;\n let nx=(sway*(Math.sin(t*.9+ph)*.6+Math.sin(t*1.73+ph*2.1)*.4)+tremor*(Math.sin(t*8.2+1.1)*.6+Math.sin(t*18.3)*.4))*diff.disturbance*bonus+(dist.nx||0);\n let nz=(sway*(Math.sin(t*.77+ph*1.7)*.6+Math.sin(t*1.51+ph*.6)*.4)+tremor*(Math.sin(t*7.1+2.3)*.6+Math.sin(t*15.7+.7)*.4))*diff.disturbance*bonus+(dist.nz||0);\n this.body.resetTorques(true);this.body.addTorque({x:Tz+nz,y:-ang.y*.6,z:-(Tx+nx)},true);\n if(this.settings.rumble&&Math.hypot(this.leanX,this.leanZ)>rad(30)&&this.t-(this.lastTipRumble||0)>.5){this.lastTipRumble=this.t;this.onNearTip?.();}if(!this.god&&!dist.noFalls&&Math.hypot(this.leanX,this.leanZ)>rad(tuning.fallAngle))this.fall();\n }\n fall(){if(this.fallen>0)return;this.falls++;this.fallen=tuning.recoverTime;this.body.setEnabled(false);this.doll.root.visible=false;this.ragdoll.spawn(this.x,this.y,this.z,this.body.rotation());this.onFall?.();}\n recover(){this.fallen=0;this.ragdoll.hide();this.doll.root.visible=true;this.body.setEnabled(true);this.body.setTranslation({x:this.x,y:this.y+.75,z:this.z},true);this.body.setRotation({x:0,y:0,z:0,w:1},true);this.body.setLinvel({x:0,y:0,z:0},true);this.body.setAngvel({x:0,y:0,z:0},true);this.body.resetTorques(true);this.leanX=this.leanZ=this.wx=this.wz=this.cob.x=this.cob.z=0;this.onRecover?.();}\n frame(dt){this.doll.anim.update(dt);if(this.fallen>0){this.ragdoll.frame();return;}this.doll.root.position.set(this.x,this.y,this.z);this.doll.root.quaternion.copy(this.body.rotation());if(this.flail>0)this.doll.anim.play('flail');this.doll.joints.head.rotation.z+=Math.sin(this.t*4)*.015;}\n}\nimport {tuning} from '../data/tuning.js';\nexport class FruitHat extends EventBase{\n balanceOptions(){return this.tier===1?{}:{margin:.6,ankleMax:5};}\n buildSet(){super.buildSet();let barge=group(this.group,0,-.5,-10);box(barge,0x659393,0,0,0,3.5,.7,2);box(barge,0xe4bc75,0,.5,0,2.2,.6,1.2);let cannon=cyl(barge,0x776670,0,1,-.2,.22,1);cannon.rotation.x=-.6;for(let x of [-1.3,1.3])cyl(barge,0xe9dfc0,x,.6,.1,.05,2.4);}\n buildLane(l){super.buildLane(l);basket(l.doll.root,1.5);crate(this.group,l.x,1.5);if(l.balancer){let b=l.balancer.body;this.world.createCollider(R.ColliderDesc.cylinder(.02,.36).setTranslation(0,.75,0).setMass(.01).setFriction(.9).setCollisionGroups(PROP(l.id)),b);for(let i=0;i<8;i++){let a=i*Math.PI/4;this.world.createCollider(R.ColliderDesc.cuboid(.02,.1,.16).setTranslation(Math.cos(a)*.36,.85,Math.sin(a)*.36).setRotation({x:0,y:Math.sin(-a/2),z:0,w:Math.cos(-a/2)}).setMass(.001).setFriction(.9).setCollisionGroups(PROP(l.id)),b);}}l.data={caught:0,banked:0,banks:0,next:1,banking:0,spilled:0};l.fruit=[];}\n spawnFruit(l,forcedType=null){const radius=tuning.landingRadius+(this.tier-1)*.1,a=this.random()*Math.PI*2,r=radius*Math.sqrt(this.random()),x=l.x+Math.cos(a)*r,z=Math.sin(a)*r,type=forcedType||(this.random()<(this.tier===1?.025:.07)?'urchin':this.random()<(this.tier===1?.025:.05)?'gold':this.random()<(this.tier===1?.02:.05)?'boot':this.random()<.4?'apple':'orange'),flight=1.5;let start={x:l.x,y:2.1,z:-7},mass=type==='boot'?.03:type==='gold'?.027:tuning.fruitMass*(this.tier>1?.8:1);let b=rigid(this.world,R.ColliderDesc.ball(type==='gold'?.1:.075),[start.x,start.y,start.z],mass,l.id);b.setLinearDamping(0);b.setLinvel({x:(x-start.x)/flight,y:(1.75-start.y+.5*tuning.gravity*flight*flight)/flight,z:(z-start.z)/flight},true);let shadow=torus(this.group,type==='urchin'?0x88658c:0xe9b76a,x,.025,z,.14,.012);shadow.rotation.x=Math.PI/2;let p=this.addProp(b,fruitMesh(null,type),l,{type,tx:x,tz:z,landing:this.t+flight,shadow,caught:false,spent:false,value:type==='gold'?5:1});l.fruit.push(p);return p;}\n tickLane(l,dt){const d=l.data,b=l.balancer;l.target={x:0,z:0,r:.28};l.dist={sway:.045,tremor:.03};d.banking=Math.max(0,d.banking-dt);if(this.t>=d.next){this.spawnFruit(l);d.next=this.t+(tuning.fruitInterval-(this.tier-1)*.3);}if(l.input.hopPress&&d.banking<=0&&d.caught>0)this.bank(l);if(d.banking>0)l.input={...l.input,x:l.input.x*.3,z:l.input.z*.3};let next=l.fruit.filter(p=>p.active&&!p.caught&&p.landing-this.t<.95&&p.landing>this.t-.15).sort((a,b)=>a.landing-b.landing)[0];if(next){l.target.x=clamp((next.tx-l.x)/.51,-1,1);l.target.z=clamp(next.tz/.51,-1,1);}this.message=d.banking>0?'BANKED! A sensible decision.':d.caught>=7?'Getting ambitious? Hop to bank.':'Catch with your hat. Hop to bank.';}\n afterStep(dt){for(const l of this.lanes){if(!l.fruit)continue;for(const p of l.fruit){if(!p.active)continue;const pos=p.body.translation(),hat=new T.Vector3(0,.85,0).applyQuaternion(l.balancer.body.rotation()).add(new T.Vector3().copy(l.balancer.body.translation()));if(this.t>p.landing-.1)p.shadow.visible=false;if(!p.caught&&!p.spent&&this.t>p.landing-.15&&this.t<p.landing+.5&&Math.hypot(pos.x-hat.x,pos.z-hat.z)<.36&&pos.y>hat.y-.12&&pos.y<hat.y+.6){p.caught=true;const incoming=p.body.linvel();p.body.setLinvel({x:incoming.x*.08,y:Math.max(incoming.y,-.8),z:incoming.z*.08},true);l.data.caught++;if(this.game.settings.rumble)this.game.input.rumble(l.pad,.12,35);this.game.audio.sfx(p.type==='urchin'?'spike':'fruit');if(p.type==='urchin'){l.score=Math.max(0,l.score-2);l.balancer.body.applyTorqueImpulse({x:.1,y:0,z:.15},true);this.disable(p);l.data.caught--;}}\n if(p.caught&&!p.spent&&(pos.y<1||Math.hypot(pos.x-l.x,pos.z)>1.4)){p.spent=true;p.expire=this.t+2;p.body.collider(0).setCollisionGroups(groups(RAG,1));l.data.caught=Math.max(0,l.data.caught-1);l.data.spilled++;}\n if(!p.caught&&!p.spent&&pos.y<1.15&&this.t>p.landing-.1){p.spent=true;p.expire=this.t+2;p.body.collider(0).setCollisionGroups(groups(RAG,1));}if(pos.y<-.1||p.expire&&this.t>p.expire||this.t>p.landing+6&&!p.caught)this.disable(p);\n }}}\n bank(l){let held=l.fruit.filter(p=>p.active&&p.caught&&!p.spent);let value=held.reduce((s,p)=>s+p.value,0)*(1+.1*Math.max(0,held.length-1));l.score+=value;l.data.banked+=held.length;l.data.banks++;l.data.caught=0;l.data.banking=1;for(const p of held){p.spent=true;this.disable(p);p.shadow.visible=false;}this.game.fx('+'+Math.round(value),l.x,2,0);this.game.audio.sfx('bank');}\n onFall(l){super.onFall(l);l.data.spilled+=l.data.caught;l.data.caught=0;for(const p of l.fruit||[])if(p.active&&p.caught){p.spent=true;p.caught=false;p.expire=this.t+2;p.body.collider(0).setCollisionGroups(groups(RAG,1));p.body.applyImpulse({x:(this.random()-.5)*.04,y:.04,z:.02},true);}}\n onFlail(l){const top=l.fruit?.findLast(p=>p.active&&p.caught&&!p.spent);if(top){this.disable(top);top.spent=true;l.data.caught=Math.max(0,l.data.caught-1);}}\n botGoal(l){const bad=l.fruit.find(p=>p.active&&!p.caught&&p.type==='urchin'&&p.landing-this.t<.95&&p.landing>this.t-.15);if(bad)return {x:-Math.sign(bad.tx-l.x)*.75,z:0};return l.target;}\n botActions(l,input,t,s,skill){const bank=this.game.dev.neverBank?Infinity:(this.game.dev.bankAt|| (skill==='clumsy'?5:7));input.hopPress=l.data.caught>=bank&&l.data.banking<=0;input.hop=input.hopPress;}\n computeForm(l){let held=l.fruit.filter(p=>p.active&&p.caught&&!p.spent).reduce((s,p)=>s+p.value,0);l.score+=held*.5;return clamp(l.score/([52,65,78][this.tier-1])*100,0,100);}\n resultDetail(l){return `${l.data.banked} fruit banked · ${l.data.banks} banks · ${l.balancer.falls} floor exercises`;}\n}\n","exit_code":0,"status":"completed"}}
