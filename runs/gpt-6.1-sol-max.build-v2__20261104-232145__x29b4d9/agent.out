{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cat > src/art/materials.js <<'EOF'\nimport * as T from 'three/webgpu';\nexport const INK=0x26232e;\nconst ramp=new T.DataTexture(new Uint8Array([100,180,255]),3,1,T.RedFormat);ramp.minFilter=ramp.magFilter=T.NearestFilter;ramp.colorSpace=T.NoColorSpace;ramp.needsUpdate=true;\nconst cache=new Map();\nexport function mat(colour){if(\"'!cache.has(colour))cache.set(colour,new T.MeshToonNodeMaterial({color:colour,gradientMap:ramp}));return cache.get(colour);}\nexport const glass=new T.MeshBasicNodeMaterial({color:0xd7f4f5,transparent:true,opacity:.17,side:T.DoubleSide,depthWrite:false});\nexport function mesh(g,c,parent,x=0,y=0,z=0){const m=new T.Mesh(g,typeof c==='\"'object'?c:mat(c));m.position.set(x,y,z);m.castShadow=m.receiveShadow=true;parent?.add(m);return m;}\nexport function box(p,c,x,y,z,w,h,d,r=0){const m=mesh(new T.BoxGeometry(w,h,d),c,p,x,y,z);m.rotation.y=r;return m;}\nexport function ball(p,c,x,y,z,r,sx=1,sy=1,sz=1){const m=mesh(new T.SphereGeometry(r,18,12),c,p,x,y,z);m.scale.set(sx,sy,sz);return m;}\nexport function cyl(p,c,x,y,z,r,h,rt=r){return mesh(new T.CylinderGeometry(rt,r,h,32),c,p,x,y,z);}\nexport function torus(p,c,x,y,z,r,tube=.025){return mesh(new T.TorusGeometry(r,tube,8,48),c,p,x,y,z);}\nexport function group(parent,x=0,y=0,z=0){const g=new T.Group();g.position.set(x,y,z);parent?.add(g);return g;}\nexport function beam(p,c,a,b,r=.04){let mid=new T.Vector3().addVectors(new T.Vector3(...a),new T.Vector3(...b)).multiplyScalar(.5);let v=new T.Vector3(...b).sub(new T.Vector3(...a));let m=cyl(p,c,...mid.toArray(),r,v.length());m.quaternion.setFromUnitVectors(new T.Vector3(0,1,0),v.normalize());return m;}\nexport function label(text,colour='#302a35',bg=null,size=1){const can=document.createElement('canvas');can.width=768;can.height=160;const ctx=can.getContext('2d');if(bg){ctx.fillStyle=bg;ctx.fillRect(0,0,768,160);}ctx.fillStyle=colour;ctx.textAlign='center';ctx.textBaseline='middle';ctx.font='600 70px Fredoka, sans-serif';ctx.fillText(text,384,82,740);let tex=new T.CanvasTexture(can);tex.colorSpace=T.SRGBColorSpace;let m=new T.Sprite(new T.SpriteMaterial({map:tex,depthTest:true}));m.scale.set(size*4.8,size,1);return m;}\nEOF\ncat > src/anim/clips.js <<'EOF'\nimport * as T from 'three/webgpu';\nconst q=(x=0,y=0,z=0)=>new T.Quaternion().setFromEuler(new T.Euler(x*Math.PI/180,y*Math.PI/180,z*Math.PI/180)).toArray();\nexport function poseClip(name,duration,frames){const joints=new Set(frames.flatMap(f=>Object.keys(f.pose)));let tracks=[];for(const joint of joints){let times=[],values=[];for(const f of frames){times.push(f.t);values.push(...q(...(f.pose[joint]||[0,0,0])));}tracks.push(new T.QuaternionKeyframeTrack(joint+'.quaternion',times,values));}return new T.AnimationClip(name,duration,tracks);}\nconst f=(t,pose)=>({t,pose});\nexport function dollClips(){const idle={shoulderL:[0,0,10],shoulderR:[0,0,-10],hipL:[0,0,0],hipR:[0,0,0],spine:[0,0,0],head:[0,0,0]};const clips=[\n poseClip('idle',3,[f(0,idle),f(1.5,{...idle,head:[0,4,2],spine:[-2,0,0]}),f(3,idle)]),\n poseClip('walk',.7,[f(0,{...idle,hipL:[28,0,0],hipR:[-28,0,0],shoulderL:[-22,0,8],shoulderR:[22,0,-8]}),f(.35,{...idle,hipL:[-28,0,0],hipR:[28,0,0],shoulderL:[22,0,8],shoulderR:[-22,0,-8]}),f(.7,{...idle,hipL:[28,0,0],hipR:[-28,0,0],shoulderL:[-22,0,8],shoulderR:[22,0,-8]})]),\n poseClip('cheer',.8,[f(0,{...idle,shoulderL:[0,0,140],shoulderR:[0,0,-140]}),f(.4,{...idle,shoulderL:[0,0,165],shoulderR:[0,0,-165],head:[0,0,5]}),f(.8,{...idle,shoulderL:[0,0,140],shoulderR:[0,0,-140]})]),\n poseClip('flail',.3,[f(0,{...idle,shoulderL:[0,0,90],shoulderR:[0,0,-90]}),f(.15,{...idle,shoulderL:[170,0,90],shoulderR:[-170,0,-90]}),f(.3,{...idle,shoulderL:[0,0,90],shoulderR:[0,0,-90]})]),\n poseClip('slab',2,[f(0,{...idle,shoulderL:[0,0,160],shoulderR:[0,0,-160],elbowL:[0,0,-20],elbowR:[0,0,20]}),f(2,{...idle,shoulderL:[0,0,160],shoulderR:[0,0,-160]})]),\n poseClip('tray',2,[f(0,{...idle,shoulderL:[-65,0,15],shoulderR:[-65,0,-15],elbowL:[-30,0,0],elbowR:[-30,0,0]}),f(2,{...idle,shoulderL:[-65,0,15],shoulderR:[-65,0,-15]})]),\n poseClip('squat',1,[f(0,idle),f(1,{...idle,hipL:[-65,0,0],hipR:[-65,0,0],kneeL:[115,0,0],kneeR:[115,0,0],spine:[18,0,0],shoulderL:[0,0,80],shoulderR:[0,0,-80]})]),\n poseClip('plank',2,[f(0,{...idle,spine:[75,0,0],hipL:[0,0,0],hipR:[0,0,0],shoulderL:[-70,0,0],shoulderR:[-70,0,0]}),f(2,{...idle,spine:[75,0,0],shoulderL:[-70,0,0],shoulderR:[-70,0,0]})]),\n poseClip('sit',2,[f(0,{...idle,hipL:[-80,0,-45],hipR:[-80,0,45],kneeL:[90,0,0],kneeR:[90,0,0]}),f(2,{...idle,hipL:[-80,0,-45],hipR:[-80,0,45],kneeL:[90,0,0],kneeR:[90,0,0]})]),\n poseClip('tug',2,[f(0,{...idle,spine:[-12,0,0],shoulderL:[-75,0,15],shoulderR:[-75,0,-15],kneeL:[22,0,0],kneeR:[22,0,0]}),f(2,{...idle,spine:[-12,0,0],shoulderL:[-75,0,15],shoulderR:[-75,0,-15]})]),\n poseClip('tuck',2,[f(0,{...idle,hipL:[-105,0,0],hipR:[-105,0,0],kneeL:[130,0,0],kneeR:[130,0,0],shoulderL:[-60,0,0],shoulderR:[-60,0,0]}),f(2,{...idle,hipL:[-105,0,0],hipR:[-105,0,0],kneeL:[130,0,0],kneeR:[130,0,0]})])\n ];\n for(let i=0;i<8;i++){const pose={...idle,shoulderL:[0,0,65+i*8],shoulderR:[0,0,-65-i*8],hipL:[i%2?0:-20,0,i%2?0:15],kneeL:[i%2?0:70,0,0],head:[0,0,i%2?8:-8]};clips.push(poseClip('pose'+i,4,[f(0,pose),f(4,pose)]));}\n for(const name of ['hop','land','bow','shrug','sleep','step-L','step-R','pike','dive-ready','clap','breathe','hip-circle']){let pose={...idle};if(name==='bow')pose.spine=[25,0,0];if(name==='sleep')pose.head=[0,0,60];if(name==='step-L')pose.hipL=[-35,0,0];if(name==='step-R')pose.hipR=[-35,0,0];if(name==='clap') {pose.shoulderL=[-60,0,30];pose.shoulderR=[-60,0,-30];}clips.push(poseClip(name,1,[f(0,idle),f(.5,pose),f(1,idle)]));}\n return clips;\n}\nexport class Animator{\n constructor(root){this.mixer=new T.AnimationMixer(root);this.actions=Object.fromEntries(dollClips().map(c=>[c.name,this.mixer.clipAction(c)]));this.play('idle');}\n play(name){if(this.current===name)return;const action=this.actions[name]||this.actions.idle;action.reset().play();if(this.current)this.actions[this.current]?.crossFadeTo(action,.2,false);this.current=name;}\n update(dt){this.mixer.update(dt);}\n}\nEOF\ncat > src/art/cast.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {box,ball,cyl,torus,beam,group,mesh,mat,INK} from './materials.js';\nimport {Animator} from '../anim/clips.js';\nexport function doll(colour='#e76b57',hat=0){const root=group(),joints={};const joint=(name,parent,x,y,z)=>{let g=group(parent,x,y,z);g.name=name;joints[name]=g;return g;};let hips=joint('hips',root,0,.51,0),spine=joint('spine',hips,0,.08,0);ball(hips,0x315272,0,0,0,.21,1,.75,.8);mesh(new T.CapsuleGeometry(.21,.22,6,16),colour,spine,0,.25,0).scale.z=.86;const neck=joint('head',spine,0,.69,0);ball(neck,0xf2d3a8,0,0,0,.235);torus(neck,colour,0,.08,0,.223,.023).rotation.x=Math.PI/2;for(let s of [-1,1]){ball(neck,INK,s*.077,.012,.214,.023);ball(neck,0xe59781,s*.144,-.055,.181,.04,1,.5,.2);}let mouth=torus(neck,INK,0,-.068,.224,.031,.006);mouth.scale.y=.45;\n for(const [side,s] of [['L',-1],['R',1]]){let shoulder=joint('shoulder'+side,spine,s*.27,.42,0);ball(shoulder,0xd4a36e,0,0,0,.076);mesh(new T.CapsuleGeometry(.065,.15,4,12),0xf2d3a8,shoulder,0,-.13,0);let elbow=joint('elbow'+side,shoulder,0,-.26,0);ball(elbow,0xd4a36e,0,0,0,.06);mesh(new T.CapsuleGeometry(.06,.13,4,12),0xf2d3a8,elbow,0,-.11,0);ball(elbow,0xfff6df,0,-.24,0,.076,1,1.08,1);let hip=joint('hip'+side,hips,s*.12,-.06,0);ball(hip,0xd4a36e,0,0,0,.073);mesh(new T.CapsuleGeometry(.075,.13,4,12),0xf2d3a8,hip,0,-.1,0);let knee=joint('knee'+side,hip,0,-.21,0);ball(knee,0xd4a36e,0,0,0,.068);mesh(new T.CapsuleGeometry(.065,.12,4,12),0xf2d3a8,knee,0,-.09,0);let ankle=joint('ankle'+side,knee,0,-.2,0);ball(ankle,0xfff6df,0,0,.045,.095,1,.6,1.5);}\n const hatGroup=group(neck,0,.17,0);\n if(hat===1){cyl(hatGroup,colour,0,.04,.08,.28,.035);cyl(hatGroup,colour,0,.09,0,.225,.09);}\n if(hat===2)ball(hatGroup,0