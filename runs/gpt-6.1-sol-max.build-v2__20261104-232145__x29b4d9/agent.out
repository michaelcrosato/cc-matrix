room in the journal.|The lighthouse will hear about this.|A quiet achievement.|We have a form for that.|I am trying not to look pleased.');\ntrudy.observe=observations.flatMap(a=>replies.map(b=>a+' '+b));\nconst stillwater=lines('Breathe in. Breathe out. Thank you for trying.|The pose is called the Apologetic Pine. Feel it apologise.|A heron can stand like this for hours. Nobody has asked why.|You got off the mat. I saw. It is all right.|Quiet is a direction too.|Let the ring come to you. Then follow it.|Your arms are allowed to have doubts.|A stone is in no particular hurry.|I have never hurried a pond.|There is a space between the wobbles.|The gull is also practising.|You may borrow some of my patience.|Imagine a tree with very small plans.|The air is doing half the work.|That was a useful breath.|You found a little quiet.|Stay for another moment.|The pond remembers every ripple.|A little less correction, perhaps.|We can begin again from here.').flatMap(a=>['That is enough for now.','The next breath is available.','I am still here.'].map(b=>a+' '+b));\nconst bolster=lines('YOU ARE DOING IT. Your form is a form.|That is the last one. THIS one is the last one.|I believe in both of your feet.|What a promising pair of knees.|A small step is still a whole step.|Your elbows have entered the building.|We are all counting. Differently.|One more. My numbers are a guide.|I have never been prouder of a tempo.|The log thinks very highly of you.|That is a rep with personality.|You have a rhythm. We shall find it.|Left. Right. A lovely arrangement.|BOTH FEET. We have enough of them.|Your commitment has a nice sound.|That was nearly coordinated.|I am cheering at a sensible volume.|A new personal attendance record.|Steady as something quite steady.|Excellent. We can use that.').flatMap(a=>['YOU HAVE GOT THIS.','We will take the next one together.','I knew you would turn up.'].map(b=>a+' '+b));\nconst guests=lines('Kevin says this is the short way.|I came for the view. It moved.|Both Sandras agree with that.|My hat is doing most of the work.|I have been upright since breakfast time.|The pond has excellent manners.|A gull has reserved my shoulder.|I think the lighthouse winked.|I am here voluntarily, apparently.|This is my quietest hobby.|I have found my favourite angle.|The bed looks very well balanced.|I am getting used to the middle.|Yesterday I leaned the other way.|My knees have read the notice board.|The coach is still counting.|One day I shall become a tree.|I was standing here already.|The marbles make a pleasing argument.|I have brought a spare intention.').flatMap(a=>['Lovely place, though.','Same time tomorrow.','Please do not tell Trudy.'].map(b=>a+' '+b));\nexport const DIALOGUE={Trudy:trudy,'Ms. Stillwater':{observe:stillwater},'Coach Bolster':{observe:bolster},Guests:{observe:guests}};\nconst decks=new Map();\nexport function line(situation='observe',speaker='Trudy'){let pool=DIALOGUE[speaker]?.[situation]||DIALOGUE[speaker]?.observe||trudy.observe,key=speaker+':'+situation;if(\"'!decks.get(key)?.length)decks.set(key,shuffled(pool,'\"'lines-'+key));return decks.get(key).pop();}\nexport const QUESTIONS=[\n {q:'Do you trust your knees?',yes:'They speak highly of you too.',no:'They know.'},\n {q:'Do you ever stand on one leg without knowing why?',yes:'I thought so.',no:'That is what someone on one leg would say.'},\n {q:'Have you been leaning on things? Be honest.',yes:'I could tell. The furniture sent a note.',no:'How very self-supporting of you.'},\n {q:'Do you consider yourself reasonably upright?',yes:'An ambitious assessment. I like it.',no:'There is room in the programme for that.'},\n {q:'Shall we try a little middle today?',yes:'Good. I have been saving you some.',no:'We can approach it from the side.'}\n];\nEOF\ncat >> ../PROGRESS.md <<'EOF'\n\n## Implementation checkpoint 2\n- First milestone test: **4 passed, 0 failed** for real-input Fruit loop after fixes. WebGPU visual milestone **6 passed, 0 failed**, device remains alive; screenshot inspected (toon/ink, basket, Trudy, disc all render).\n- Issues logged: flight damping and timer floating-point boundary. Fruit score still needs balance calibration against the plan's stronger targets.\n- Added shared training implementation for Poses, Cairn, Still Water, Log Reps, Plank, Tug, Step, Plates, Service, Loop; dedicated Springboard, Raft, Grand Hold. Not yet integrated or tested.\n- Added detailed island diorama and tilted-gravity walker/props/jar, not yet wired to Director.\n- Added original situational dialogue (>200 Trudy, 60 per instructor, 60 guests), question/reply pairs.\n- Remaining: Director/screens/programme/check-in/couch/session/dev/attract, full tests and art pass, final metadata.\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > src/game/checkin.js <<'EOF'\nimport {EventBase} from '../events/base.js';\nimport {REGISTRY} from '../data/events.js';\nimport {clamp} from '../data/config.js';\nexport const CHECKS={stand:{title:'Stand Still',seconds:10,instruction:'Keep your dot in the middle.'},match:{title:'Lean Match',seconds:18,instruction:'Follow the target. Hold each lean.'},step:{title:'Step Time',seconds:16,instruction:'Alternate feet with the click.'},quick:{title:'Quick Lean',seconds:15,instruction:'Lean toward the lit quadrant.'},foot:{title:'One-Foot Hold',seconds:12,instruction:'Hold your right foot. Keep the dot centred.'}};\nREGISTRY.check={id:'check',title:'The Check-In',discipline:'Stillness',instructor:'Trudy',place:'The Mat',one:'A little introduction to your knees.',can:'Three short tests. Follow Trudy’s instructions.',cant:'There is no failing. The result is an imaginary Wobble Age.',verbs:['lean','feet','breathe'],durations:[44,44,44]};\nexport class CheckIn extends EventBase{\n buildSet(){super.buildSet();this.tests=this.options.tests||['stand','match','step'];this.duration=this.tests.reduce((s,k)=>s+CHECKS[k].seconds,0);}\n buildLane(l){super.buildLane(l);l.data={scores:[],current:-1,err:0,n:0,stepSum:0,stepN:0,lastBeat:-1,quickHits:0,quickSum:0,quickIndex:-1,reacted:false};}\n tickLane(l,dt){const d=l.data,b=l.balancer;let sum=0,index=0;for(let i=0;i<this.tests.length;i++){if(this.t>=sum+CHECKS[this.tests[i]].seconds){sum+=CHECKS[this.tests[i]].seconds;index=i+1;}else break;}index=Math.min(this.tests.length-1,index);let key=this.tests[index],local=this.t-sum;if(index\"'!==d.current){if(d.current>=0)d.scores.push(this.testScore(l,this.tests[d.current]));Object.assign(d,{current:index,err:0,n:0,stepSum:0,stepN:0,lastBeat:-1,quickHits:0,quickSum:0,quickIndex:-1,reacted:false});this.game.audio.sfx('\"'bell');}l.target={x:0,z:0,r:.2};l.dist={sway:key==='stand'?.1:key==='match'?.04:.07,tremor:.06,oneFoot:key==='foot',still:true};\n if(key==='match'){const targets=[[-.7,0],[.7,0],[0,-.7]],p=Math.min(2,Math.floor(local/6));l.target.x=targets[p][0];l.target.z=targets[p][1];if(local%6>1.5){d.err+=Math.hypot(b.cob.x-l.target.x,b.cob.z-l.target.z)*dt;d.n+=dt;}this.message=['Lean 70% left.','Lean 70% right.','Lean 70% forward.'][p];}\n else if(key==='step'){const beat=60/96,bi=Math.floor(local/beat);if(bi\"'!==d.lastBeat){if(d.lastBeat>=0&&!d.hitBeat){d.stepSum+=.12;d.stepN++;}d.lastBeat=bi;d.hitBeat=false;this.game.audio.sfx('\"'foot');}if(l.input.leftPress||l.input.rightPress){const error=Math.abs(local-Math.round(local/beat)*beat);d.stepSum+=Math.min(.12,error);d.stepN++;d.hitBeat=true;}this.message=bi%2?'Right foot.':'Left foot.';}\n else if(key==='quick'){const qi=Math.min(5,Math.floor(local/2.5)),points=[[-.7,0],[0,-.7],[.7,0],[0,.7],[-.7,0],[.7,0]];l.target.x=points[qi][0];l.target.z=points[qi][1];if(d.quickIndex\"'!==qi){if(d.quickIndex>=0&&!d.reacted){d.quickSum+=1.25;d.quickHits++;}d.quickIndex=qi;d.reacted=false;}if(!d.reacted&&Math.hypot(b.cob.x-l.target.x,b.cob.z-l.target.z)<.35){d.reacted=true;d.quickSum+=local%2.5;d.quickHits++;}this.message='\"'Lean toward the lit ring.';}\n else{d.err+=Math.hypot(b.cob.x,b.cob.z)*dt;d.n+=dt;if(key==='foot'&&l.input.right<.6)d.err+=dt*.15;this.message=CHECKS[key].instruction;}d.key=key;d.local=local;l.score=100*this.testScore(l,key);}\n testScore(l,key){const d=l.data;if(key==='step')return clamp(1-d.stepSum/Math.max(1,d.stepN)/.12);if(key==='quick')return clamp(1-(d.quickSum/Math.max(1,d.quickHits)-.35)/.9);return clamp(1-d.err/Math.max(.01,d.n)/(key==='match'?.4:.25));}\n finish(){if(this.done)return;for(let l of this.lanes)l.data.scores.push(this.testScore(l,this.tests.at(-1)));super.finish();}\n computeForm(l){return 100*l.data.scores.reduce((a,b)=>a+b,0)/this.tests.length;}\n botActions(l,i,t){const d=l.data;if(d.key==='foot')i.right=1;if(d.key==='step'){const phase=Math.floor(d.local/(60/96)),left=phase%2===0;if(d.botStep\"'!==phase){i.leftPress=left;i.rightPress=!left;d.botStep=phase;}i.left=left?1:0;i.right=left?0:1;}}\n widget(){const d=this.lanes[0].data;return `${CHECKS[d.key||'\"'stand'].title}<br>Test \"'${d.current+1} / 3`;}\n}\nEOF\ncat > src/core/script.js <<'\"'EOF'\nexport class Scheduler{\n constructor(){this.time=0;this.items=[];}\n after(seconds,fn){this.items.push({at:this.time+seconds,fn});}\n fixed(dt){this.time+=dt;let due=this.items.filter(i=>i.at<=this.time);this.items=this.items.filter(i=>i.at>this.time);for(let i of due)i.fn();}\n clear(){this.items=[];}\n}\nEOF\ncat > src/game/director.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {TITLE,TAGLINE,COLOURS,SEATS,TIERS,clamp} from '../data/config.js';\nimport {EVENTS,REGISTRY,HOTSPOTS} from '../data/events.js';\nimport {DAYS,TOTAL_STEPS,restTilt,age,medal,payout,nextTier} from '../data/programme.js';\nimport {NAMES,HATS,UNLOCKS} from '../data/names.js';\nimport {QUESTIONS,line} from '../data/dialogue.js';\nimport {ABOUT} from '../data/about.js';\nimport {TUNING,tuning,resetTuning} from '../data/tuning.js';\nimport {rng,pick,shuffled} from '../core/rng.js';\nimport {Save,freshProfile} from '../core/save.js';\nimport {Scheduler} from '../core/script.js';\nimport {UI,btn,panel,esc,discSVG} from '../ui/ui.js';\nimport {prompts,glyph} from '../input/glyphs.js';\nimport {AudioEngine} from '../audio/engine.js';\nimport {Island} from './island.js';\nimport {CheckIn,CHECKS} from './checkin.js';\nimport {createEvent} from '../events/registry.js';\nimport {label,ball,group} from '../art/materials.js';\nexport class Director{\n constructor(view,input,save=new Save()){\n this.view=view;this.input=input;this.save=save;this.settings=save.settings;this.tuning=tuning;this.audio=new AudioEngine(this.settings);this.ui=new UI(this);this.island=new Island(this);this.scheduler=new Scheduler();this.screen='boot';this.simTime=0;this.stateTime=0;this.errors=[];this.dev={god:false,timeScale:1,bot:false,debug:false,stats:false,freeCamera:false,neverBank:false};this.event=null;this.flow='programme';this.effects=[];this.testBot=null;this.idle=0;this.attract=false;this.attractIndex=0;this.menuPage=0;this.settingsPage=0;this.groupSeats=[];this.session=null;this.input.onActivity=(type,e)=>{this.idle=0;this.audio.unlock();if(this.attract){this.stopAttract();return true;}if(this.screen==='island'&&type==='click'&&e?.target?.id==='world'&&e.button===0){let h=this.island.hitTest(e.clientX,e.clientY);if(h)this.island.target=h;}};this.input.onPadGesture=()=>this.audio.unlock();this.input.onDisconnect=index=>{if(this.screen==='play'&&\"'!this.session){this.pause();this.ui.toast('\"'Controller disconnected. Reconnect, or use the keyboard.',8);}};this.input.onPointerMove=e=>{const b=e.target.closest?.('button');if(b&&this.ui.screen.contains(b)){const i=this.ui.buttons.indexOf(b);if(i>=0)this.ui.setFocus(i);}if(this.screen==='island')this.island.hover=this.island.hitTest(e.clientX,e.clientY);};\n }\n get profile(){return this.save.profile;}\n get dayData(){return DAYS[Math.min(4,(this.profile?.day||1)-1)];}\n get today(){if((this.profile?.day||1)<=5)return this.dayData.events;const seed=(this.profile?.day||6),arr=shuffled(EVENTS.filter(e=>e.id\"'!=='\"'grand').map(e=>e.id),'maintenance-'+seed);return this.maintenance||=arr.slice(0,3);}\n setScreen(screen){this.screen=screen;this.stateTime=0;this.ui.pageMove=null;}\n disposeEvent(){if(this.event){this.event.dispose();this.event=null;}this.ui.clearHud();}\n standalone(){this.title();}\n title(){this.disposeEvent();this.setScreen('title');this.island.root.visible=true;this.audio.setTrack('title');this.ui.clearHud();this.idle=0;const touch=this.input.touchOnly;this.ui.show(\"'`<div class=\"title\"><div class=\"seal\">Level Best Retreat</div><h1><span>Wee</span><br><span>Knit</span></h1><div class=\"tagline\">${TAGLINE}</div><div class=\"subtitle\">A crooked little island.<br>A very patient pair of knees.</div></div><div class=\"island-caption\">Perfectly imperfect since forever.</div><div class=\"title-bottom\">${touch?'\"'<div class=\\\"tag\\\">Controller or keyboard required</div>'+btn('Settings','settings'):btn(\"'`<span data-prompt=\"confirm\"></span> Step into something wobbly`,'\"'start','','primary')}<div class=\\\"note\\\">\"'${touch?'\"'The island will show you around shortly.':'1–4 guests · no balance hardware required'}</div></div><div class=\\\"corner\\\">Original toys. Real wobbles.</div>\"'`,{start:()=>this.mainMenu(),settings:()=>this.settingsMenu('\"'title')});}\n mainMenu(){this.disposeEvent();this.setScreen('menu');this.ui.show(panel('Level Best Retreat','Make yourself almost comfortable.',\"'`<div class=\"choices\">${btn(this.profile?'\"'Continue your stay':'Begin your stay','programme','Five days. Fourteen questionable activities.','primary')}\"'${btn('\"'Group Class','group','1–4 on one screen')}\"'${btn('\"'Free Play','free','A little practice')}\"'${btn('\"'Journal','journal','Proof that you turned up')}\"'${btn('\"'Settings','settings','For your particular knees')}\"'${btn('\"'About & Credits','about','The small print, enlarged')}</div>\"'`,`<span class=\"page-indicator\">${this.profile?esc(this.profile.name)+'\"' · Day '+this.profile.day:'A retreat for everyone who has ever leaned.'}</span>\"'`),{programme:()=>this.chooseProfiles(),group:()=>this.groupLobby(),free:()=>this.freePlay(),journal:()=>this.journal(),settings:()=>this.settingsMenu('\"'menu'),about:()=>this.about()},()=>this.title());}\n chooseProfiles(){this.setScreen('profiles');this.ui.show(panel('Who’s here today?','Pick a mat.',\"'`<div class=\"profile-mats\">${this.save.data.profiles.map((p,i)=>btn(`<span class=\"peg\" style=\"color:${p?.colour||'\"'#acaa95'}\\\">●</span>\"'${p?esc(p.name):'\"'A new guest'}\"'`,'\"'p'+i,p?'Day '+p.day:'Make yourself known')).join('')}</div>\"'`,`<span class=\"muted\">Up to four familiar faces.</span>${btn('\"'Back','back')}\"'`),Object.fromEntries([...this.save.data.profiles.map((p,i)=>['\"'p'+i,()=>{this.save.data.selected=i;if(p){this.island.setProfile(p);this.save.write();this.enterStay();}else this.newProfile();}]),['back',()=>this.mainMenu()]]),()=>this.mainMenu());}\n newProfile(){this.setScreen('newProfile');this.pendingName=this.pendingName||pick(NAMES,'names');this.pendingPaint=this.pendingPaint??0;this.ui.show(panel('Welcome, probably','A name to grow into.',\"'`<p style=\"font-size:1.3em;color:var(--teal)\">${esc(this.pendingName)}</p><p class=\"muted\">Pick a paint. Your knees will remain anonymous.</p><div style=\"height:4vh;background:${COLOURS[this.pendingPaint]};border:2px solid var(--ink);border-radius:1vh\"></div><div class=\"choices\">${btn('\"'Another name','name')}\"'${btn('\"'Next paint','paint')}\"'${btn('\"'This is me','accept','','primary')}\"'${btn('\"'Back','back')}</div>\"'`),{name:()=>{this.pendingName=pick(NAMES,'\"'names');this.newProfile();},paint:()=>{this.pendingPaint=(this.pendingPaint+1)%COLOURS.length;this.newProfile();},accept:()=>{this.save.data.profiles[this.save.data.selected]=freshProfile(this.pendingName,COLOURS[this.pendingPaint]);this.pendingName=null;this.island.setProfile(this.profile);this.save.write();this.island.walker.setTranslation({x:0,y:4,z:10},true);this.say('Trudy','Oh\"'! A person. Please step on. Not on me. On the island.'\"',()=>this.tutorial(0));},back:()=>this.chooseProfiles()},()=>this.chooseProfiles());}\n say(speaker,text,next){this.setScreen('speech');this.speechNext=next;this.speechText=text;this.audio.say(text,speaker);this.ui.speech(speaker,text);this.speechDuration=Math.max(1.2,text.length/(speaker==='Trudy'?24:18));}\n tutorial(step=0){this.setScreen('tutorial');this.tutorialStep=step;this.tutorialHold=0;const text=['Lean left. Your other left. No, that was correct.','Now lean right. The whole island can feel that, by the way.','Now forward. Excellent. The oranges are having a very full day.'][step];this.audio.say(text,'Trudy');this.ui.show(\"'`<div class=\"topline\"><div class=\"tag\">Your first small adjustment</div></div><div class=\"speech\"><span class=\"name\">Trudy · Head of Alignment</span>${text}<div class=\"prompts\" data-prompt=\"lean\"></div></div>`);}\n enterStay(){this.flow='\"'programme';this.maintenance=null;this.island.setProfile(this.profile);if(\"'!this.profile.tutorial){this.tutorial(0);return;}if(this.profile.checkDone)this.showIsland();else this.morning();}\n morning(){const day=this.profile.day;let text=day===1?'\"'Welcome to your first day. The island is nine degrees from normal. So am I.':line('morning');const elapsed=(Date.now()-this.profile.lastVisit)/864e5;if(elapsed>=2)text=\"'`It has been ${Math.floor(elapsed)} days. The island tilted a bit. I am not saying those things are connected.`;this.say('\"'Trudy',text,()=>this.question());}\n question(){this.setScreen('question');const q=QUESTIONS[(this.profile.day-1)%QUESTIONS.length];this.audio.say(q.q,'Trudy');this.ui.show(panel(\"'`Morning ${this.profile.day} · A personal question`,q.q,`<div class=\"choices\">${btn('\"'Yes','yes','','primary')}\"'${btn('\"'No','no')}</div>\"'`),{yes:()=>this.say('\"'Trudy',q.yes,()=>this.checkIntro()),no:()=>this.say('Trudy',q.no,()=>this.checkIntro())});}\n checkIntro(){this.setScreen('checkIntro');this.ui.show(panel('The morning Check-In','Let’s ask your knees.',\"'`<div class=\"diagram\">${discSVG()}</div><p>Three short tests. A little stillness, a little leaning, a little footwork.</p><p class=\"muted\">Your Wobble Age is imaginary. No real age required.</p><div class=\"prompts\" data-prompt=\"lean,feet\"></div>`,`${btn('\"'Begin Check-In','begin','','primary')}\"'${btn('\"'How to play','how')}\"'`),{begin:()=>this.startCheck(),how:()=>this.howTo('\"'checkIntro')});}\n startCheck(){this.disposeEvent();this.flow='check';this.island.hide();this.event=new CheckIn(this,'check',1,[this.localConfig()],{tests:this.dayData.tests});this.countdown();}\n localConfig(){return {name:this.profile?.name||'Guest',colour:this.profile?.colour||COLOURS[0],hat:this.profile?.hat||0,kind:'local',device:'main',pad:this.input.padIndex||0};}\n showIsland(){this.disposeEvent();this.flow='programme';this.setScreen('island');this.island.root.visible=true;this.audio.setTrack('island');this.ui.clear();this.ui.hud.innerHTML=\"'`<div class=\"topline\"><div class=\"tag\">Day ${this.profile?.day||1} · ${esc(this.profile?.name||'\"'Guest')}</div><div class=\\\"tag gold\\\"><span class=\\\"marble-count\\\">\"'${this.profile?.marbles||0}</span> marbles · <span class=\"tilt-count\">${restTilt(this.profile?.steps||0).toFixed(1)}°</span></div></div><div class=\"bottom-prompts prompts\" data-prompt=\"steer,confirm,ask,pause\"></div><div id=\"hotspot\" class=\"world-hotspot\" hidden></div>`;this.ui.updatePrompts();}\n useHotspot(id){if(this.screen!=='\"'island')return;if(id==='bed'){if(this.today.every(x=>this.profile.done.includes(x)))this.bedPrompt();else this.say('Trudy','Your bed is ready. Your classes are not quite ready to let you go.',()=>this.todayPlan());}else if(id==='plan')this.todayPlan();else if(id==='mirror')this.mirror();else if(id==='jar')this.jarView(0,()=>this.showIsland());else if(REGISTRY[id]){if(this.profile.levelled||this.profile.medals[id]||this.today.includes(id)){this.flow=this.today.includes(id)&&\"'!this.profile.done.includes(id)?'\"'programme':'free';this.intro(id);}else this.ui.toast('We will meet that class on a later day.');}}\n todayPlan(){this.setScreen('plan');let ids=this.today;this.ui.show(panel(\"'`Day ${this.profile.day} · ${this.profile.day<=5?this.dayData.name:'\"'Maintenance'}\"'`,this.today.every(x=>this.profile.done.includes(x))?'\"'A pleasing amount of attendance.':'Today’s small intentions.',\"'`<div class=\"choices\">${ids.map(id=>btn(`${this.profile.done.includes(id)?'\"'✓ ':''}\"'${REGISTRY[id].title}`,id,REGISTRY[id].place,this.profile.done.includes(id)?'\"'secondary':'')).join('')}\"'${btn('\"'Walk around','island')}\"'${btn('\"'Go to bed','bed')}</div>\"'`,`<span class=\"muted\">Any order. No skill gate. ${this.profile.done.length}/${ids.length} classes attended.</span>`),Object.fromEntries([...ids.map(id=>[id,()=>{this.flow=this.profile.done.includes(id)?'\"'free':'programme';this.intro(id);}]),['island',()=>this.showIsland()],['bed',()=>this.bedPrompt()]]),()=>this.showIsland());}\n bedPrompt(){this.setScreen('bed');const complete=this.today.every(x=>this.profile.done.includes(x));this.ui.show(panel('The Bed Hut',complete?'A well-earned horizontal moment.':'A little more day left.',\"'`<p>${complete?'\"'We will stamp the calendar and put the island away until morning.':'You can finish today’s classes in any order. Trudy has kept your place.'}</p><div class=\\\"choices\\\">\"'${complete?btn('\"'Good night','sleep','','primary'):btn('Today’s plan','plan','','primary')}\"'${btn('\"'Stay a little longer','stay')}</div>\"'`),{sleep:()=>this.sleep(),plan:()=>this.todayPlan(),stay:()=>this.showIsland()},()=>this.showIsland());}\n sleep(){const p=this.profile;p.stamps.push({day:p.day,date:new Date().toLocaleDateString()});p.day++;p.done=[];p.checkDone=false;p.lastVisit=Date.now();this.maintenance=null;this.save.write();this.setScreen('\"'sleep');this.ui.show(\"'`<div class=\"backdrop\" style=\"background:#302c37e8\"></div><div class=\"countdown\" style=\"font-size:8vh;color:#fff4dc\">Day ${p.day}<br>A little more level.</div>`);this.audio.sfx('\"'stamp');this.scheduler.after(2.5,()=>this.morning());}\n intro(id,tier=1){this.disposeEvent();this.currentId=id;this.currentTier=tier;this.setScreen('intro');this.island.hide();const m=REGISTRY[id];this.audio.setTrack(m.discipline==='Stillness'?'still':m.discipline==='Strength'?'strength':m.discipline==='Cardio'?'cardio':id==='grand'?'level':'balance');this.buildEvent(id,tier);this.ui.clearHud();this.ui.show(panel(\"'`${m.discipline} · ${m.place} · ${TIERS[tier-1]}`,m.title,`<div class=\"diagram\">${discSVG()}</div><p>${m.one}</p><p>${m.can}</p><p class=\"muted\">${m.cant}</p><div class=\"prompts\" data-prompt=\"${m.verbs.join('\"',')}\\\"></div>\"'`,`${btn('\"'Let’s try','start','','primary')}\"'${btn('\"'Back','back')}\"'`),{start:()=>this.countdown(),back:()=>this.leaveEvent()},()=>this.leaveEvent());}\n buildEvent(id,tier=1,opts={}){this.disposeEvent();let configs=this.groupRun?this.groupRun.seats.map(s=>({...s,kind:'\"'local'})):[this.localConfig()];if(opts.configs)configs=opts.configs;this.event=createEvent(this,id,tier,configs,opts);}\n countdown(){this.setScreen('countdown');this.ui.clear();this.ui.eventHud(this.event);this.audio.sfx('bell');this.ui.screen.innerHTML='<div class=\\\"countdown\\\">3</div>';}\n beginPlay(){this.setScreen('play');this.ui.clear();this.event.start();}\n finishEvent(){if(\"'!this.event)return;if(this.flow==='\"'check'){const mean=this.event.lanes[0].form/100,p=this.profile,number=age(mean,p.day);p.ages.push({day:p.day,age:number,tests:[...this.event.lanes[0].data.scores]});p.checkDone=true;p.steps=Math.min(TOTAL_STEPS,p.steps+1);p.marbles++;this.save.write();this.ageReveal(number);return;}this.results();}\n results(){this.setScreen('results');const e=this.event,r=e.laneResult(0),m=medal(r.form);this.ui.clearHud();this.audio.sting(m);const speaker=e.meta.instructor;this.resultLine=r.form<40?'You attended with considerable presence.':r.form>=97?'Suspicious. I have written that in permanent ink.':line('observe',speaker);this.audio.say(this.resultLine,speaker);this.ui.show(panel(\"'`${e.meta.title} · ${TIERS[e.tier-1]}`,'\"'A small achievement.',\"'`<div class=\"result-layout\"><div><div class=\"result-number\">${r.form}<span style=\"font-size:.3em\">%</span></div><div class=\"number-label\">form</div></div><div class=\"stamp\">${m}</div></div><p class=\"muted\">${esc(r.detail)}</p><p>“${esc(this.resultLine)}”</p>`,`${btn('\"'Continue','continue','','primary')}\"'${btn('\"'One more go','retry')}\"'`),{continue:()=>this.acceptResult(),retry:()=>{let id=e.id,t=e.tier;this.intro(id,t);}},()=>this.acceptResult());}\n acceptResult(){if(!this.event)return;if(this.groupRun){this.groupAccept();return;}const e=this.event,p=this.profile,r=e.laneResult(0);if(!p){this.leaveEvent();return;}const first=!p.medals[e.id],old=p.medals[e.id]||[0,0,0];old[e.tier-1]=Math.max(old[e.tier-1],r.form);p.medals[e.id]=old;p.falls+=r.falls;p.minutes+=e.t/60;let n=payout(e.t,r.form,first,tuning.marblesPerMinute);p.marbles+=n;let programme=this.flow==='\"'programme';if(programme&&\"'!p.done.includes(e.id)){p.done.push(e.id);p.steps=Math.min(TOTAL_STEPS,p.steps+1);}if(e.id==='\"'grand'){p.levelled=true;p.steps=TOTAL_STEPS;}this.save.write();if(e.id==='grand'){this.ending();return;}const callback=programme?()=>this.todayPlan():()=>this.freePlay(this.freePage||0);this.jarView(n,callback,medal(r.form));}\n ageReveal(number){this.disposeEvent();this.setScreen('age');this.currentAge=number;this.ui.show(\"'`<div class=\"backdrop\"></div><section class=\"panel paper\" style=\"text-align:center\"><div class=\"eyebrow\">The Check-In · Day ${this.profile.day}</div><h1>Your Wobble Age</h1><div class=\"result-number\" id=\"age-counter\">99</div><p id=\"age-line\">A moment for your knees…</p><div id=\"age-continue\" hidden>${btn('\"'A distinguished start','continue','','primary')}</div></section>\"'`,{continue:()=>this.jarView(1,()=>this.todayPlan())});this.audio.sfx('\"'stamp');}\n jarView(count,callback,medalName='Pleasant'){this.disposeEvent();this.setScreen('jar');this.island.root.visible=true;this.jarCount=count;this.jarAdded=0;this.jarCallback=callback;this.jarMedal=medalName;this.ui.show(\"'`<div class=\"topline\"><div class=\"tag\">A little more level</div><div class=\"tag gold\" id=\"jar-count\">${this.profile?.marbles-count||0} marbles</div></div><div class=\"speech\"><span class=\"name\">Trudy</span>${line('\"'jar')}<div class=\\\"footer\\\">\"'${btn('\"'Lovely','continue','','primary')}<span class=\\\"muted\\\">Your island is \"'${restTilt(this.profile?.steps||0).toFixed(1)}° from the middle.</span></div></div>`,{continue:()=>{while(this.jarAdded<count){this.island.addMarbles(1);this.jarAdded++;}callback();}});this.audio.sfx('\"'creak');let unlocked=UNLOCKS.filter(u=>this.profile&&this.profile.marbles>=u.n&&this.profile.marbles-count<u.n);if(unlocked.length)this.ui.toast('New for the Mirror: '+unlocked.map(x=>x.name).join(', '),5);}\n leaveEvent(){this.disposeEvent();if(this.groupRun){this.groupRun=null;this.groupLobby();}else if(this.flow==='free')this.freePlay();else if(this.profile)this.todayPlan();else this.mainMenu();}\n freePlay(page=0){this.disposeEvent();this.groupRun=null;this.flow='free';this.freePage=page;this.setScreen('free');const ids=EVENTS.filter(e=>this.profile?.levelled||this.profile?.medals[e.id]||this.today.includes(e.id)),pages=Math.max(1,Math.ceil(ids.length/4)),list=ids.slice(page*4,page*4+4);this.ui.show(panel('Free Play','Choose a little wobble.',\"'`<div class=\"choices\">${list.map(e=>btn(e.title,e.id,e.discipline)).join('\"'')}\"'${btn('\"'Back','back')}</div>\"'`,`<span class=\"page-indicator\">${page+1} / ${pages} · Classes open as you meet them.</span>${btn('\"'Next page','next')}\"'`),Object.fromEntries([...list.map(e=>[e.id,()=>this.tierMenu(e.id)]),['\"'back',()=>this.mainMenu()],['next',()=>this.freePlay((page+1)%pages)]]),()=>this.mainMenu());this.ui.pageMove=dir=>this.freePlay((page+dir+pages)%pages);}\n tierMenu(id){this.setScreen('tiers');let open=this.profile?.levelled?Math.max(1,nextTier(this.profile.medals[id]||[])):nextTier(this.profile?.medals[id]||[]);this.ui.show(panel(REGISTRY[id].title,'How unreasonable?',\"'`<div class=\"choices one\">${TIERS.map((name,i)=>btn(`${name}${i+1>open?'\"' · locked':''}\"'`,'\"'tier'+i,i===0?'A gentle beginning':i===1?'Pleasant on Gentle opens this':'Exemplary on Honest opens this',i+1>open?'secondary':'')).join('')}</div>\"'`,btn('\"'Back','back')),Object.fromEntries([...TIERS.map((_,i)=>['tier'+i,()=>{if(i+1<=open){this.flow='free';this.intro(id,i+1);}else this.ui.toast('Earn a medal on the previous tier first.');}]),['back',()=>this.freePlay(this.freePage)]]),()=>this.freePlay(this.freePage));}\n pause(){if(this.session){this.settingsMenu('session');return;}if(['title','menu','settings','pause','dev','about'].includes(this.screen))return;this.pausedScreen=this.screen;this.setScreen('pause');this.pauseMenu();}\n pauseMenu(){this.ui.show(panel('A small intermission','Take your time.',\"'`<div class=\"choices\">${btn('\"'Resume','resume','','primary')}\"'${btn('\"'Restart class','restart')}\"'${btn('\"'How to play','how')}\"'${btn('\"'Settings','settings')}\"'${btn('\"'Dev Mode','dev')}\"'${btn('\"'Leave class','leave')}</div>\"'`),{resume:()=>this.resume(),restart:()=>this.restart(),how:()=>this.howTo('\"'pause'),settings:()=>this.settingsMenu('pause'),dev:()=>this.devMenu(),leave:()=>this.leaveEvent()},()=>this.resume());}\n resume(){const s=this.pausedScreen||'island';this.setScreen(s);this.ui.clear();if(s==='play'&&this.event)this.ui.eventHud(this.event);else if(s==='island')this.showIsland();else if(s==='intro')this.intro(this.currentId,this.currentTier);else if(s==='tutorial')this.tutorial(this.tutorialStep);else if(s==='speech')this.ui.speech('Trudy',this.speechText);else if(s==='countdown')this.countdown();else this.showIsland();}\n restart(){if(this.event){if(this.event.id==='check')this.startCheck();else this.intro(this.event.id,this.event.tier);}else this.showIsland();}\n howTo(returnTo='pause'){this.setScreen('how');const m=this.event?.meta;this.ui.show(panel(m?.title||'A little balance','One verb: shift your weight.',\"'`<div class=\"diagram\">${discSVG()}</div><p>Your solid dot is your real balance. The dotted ring is where you asked to lean. Keep the dot in the green zone.</p><p class=\"muted\">${m?.can||'\"'Stick or mouse: lean. Keys move the ring and leave it there. C recentres.'}<br>\"'${m?.cant||'\"'Flail is a last-moment save. Falls are just floor exercises.'}</p><div class=\\\"prompts\\\" data-prompt=\\\"\"'${(m?.verbs||['\"'lean','flail']).join(',')}\\\"></div>\"'`,btn('\"'Understood','back','','primary')),{back:()=>returnTo==='pause'?(this.setScreen('pause'),this.pauseMenu()):this.checkIntro()},()=>returnTo==='pause'?(this.setScreen('pause'),this.pauseMenu()):this.checkIntro());}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > src/game/checkin.js <<'EOF'\nimport {EventBase} from '../events/base.js';\nimport {REGISTRY} from '../data/events.js';\nimport {clamp} from '../data/config.js';\nexport const CHECKS={stand:{title:'Stand Still',seconds:10,instruction:'Keep your dot in the middle.'},match:{title:'Lean Match',seconds:18,instruction:'Follow the target. Hold each lean.'},step:{title:'Step Time',seconds:16,instruction:'Alternate feet with the click.'},quick:{title:'Quick Lean',seconds:15,instruction:'Lean toward the lit quadrant.'},foot:{title:'One-Foot Hold',seconds:12,instruction:'Hold your right foot. Keep the dot centred.'}};\nREGISTRY.check={id:'check',title:'The Check-In',discipline:'Stillness',instructor:'Trudy',place:'The Mat',one:'A little introduction to your knees.',can:'Three short tests. Follow Trudy’s instructions.',cant:'There is no failing. The result is an imaginary Wobble Age.',verbs:['lean','feet','breathe'],durations:[44,44,44]};\nexport class CheckIn extends EventBase{\n buildSet(){super.buildSet();this.tests=this.options.tests||['stand','match','step'];this.duration=this.tests.reduce((s,k)=>s+CHECKS[k].seconds,0);}\n buildLane(l){super.buildLane(l);l.data={scores:[],current:-1,err:0,n:0,stepSum:0,stepN:0,lastBeat:-1,quickHits:0,quickSum:0,quickIndex:-1,reacted:false};}\n tickLane(l,dt){const d=l.data,b=l.balancer;let sum=0,index=0;for(let i=0;i<this.tests.length;i++){if(this.t>=sum+CHECKS[this.tests[i]].seconds){sum+=CHECKS[this.tests[i]].seconds;index=i+1;}else break;}index=Math.min(this.tests.length-1,index);let key=this.tests[index],local=this.t-sum;if(index\"'!==d.current){if(d.current>=0)d.scores.push(this.testScore(l,this.tests[d.current]));Object.assign(d,{current:index,err:0,n:0,stepSum:0,stepN:0,lastBeat:-1,quickHits:0,quickSum:0,quickIndex:-1,reacted:false});this.game.audio.sfx('\"'bell');}l.target={x:0,z:0,r:.2};l.dist={sway:key==='stand'?.1:key==='match'?.04:.07,tremor:.06,oneFoot:key==='foot',still:true};\n if(key==='match'){const targets=[[-.7,0],[.7,0],[0,-.7]],p=Math.min(2,Math.floor(local/6));l.target.x=targets[p][0];l.target.z=targets[p][1];if(local%6>1.5){d.err+=Math.hypot(b.cob.x-l.target.x,b.cob.z-l.target.z)*dt;d.n+=dt;}this.message=['Lean 70% left.','Lean 70% right.','Lean 70% forward.'][p];}\n else if(key==='step'){const beat=60/96,bi=Math.floor(local/beat);if(bi\"'!==d.lastBeat){if(d.lastBeat>=0&&!d.hitBeat){d.stepSum+=.12;d.stepN++;}d.lastBeat=bi;d.hitBeat=false;this.game.audio.sfx('\"'foot');}if(l.input.leftPress||l.input.rightPress){const error=Math.abs(local-Math.round(local/beat)*beat);d.stepSum+=Math.min(.12,error);d.stepN++;d.hitBeat=true;}this.message=bi%2?'Right foot.':'Left foot.';}\n else if(key==='quick'){const qi=Math.min(5,Math.floor(local/2.5)),points=[[-.7,0],[0,-.7],[.7,0],[0,.7],[-.7,0],[.7,0]];l.target.x=points[qi][0];l.target.z=points[qi][1];if(d.quickIndex\"'!==qi){if(d.quickIndex>=0&&!d.reacted){d.quickSum+=1.25;d.quickHits++;}d.quickIndex=qi;d.reacted=false;}if(!d.reacted&&Math.hypot(b.cob.x-l.target.x,b.cob.z-l.target.z)<.35){d.reacted=true;d.quickSum+=local%2.5;d.quickHits++;}this.message='\"'Lean toward the lit ring.';}\n else{d.err+=Math.hypot(b.cob.x,b.cob.z)*dt;d.n+=dt;if(key==='foot'&&l.input.right<.6)d.err+=dt*.15;this.message=CHECKS[key].instruction;}d.key=key;d.local=local;l.score=100*this.testScore(l,key);}\n testScore(l,key){const d=l.data;if(key==='step')return clamp(1-d.stepSum/Math.max(1,d.stepN)/.12);if(key==='quick')return clamp(1-(d.quickSum/Math.max(1,d.quickHits)-.35)/.9);return clamp(1-d.err/Math.max(.01,d.n)/(key==='match'?.4:.25));}\n finish(){if(this.done)return;for(let l of this.lanes)l.data.scores.push(this.testScore(l,this.tests.at(-1)));super.finish();}\n computeForm(l){return 100*l.data.scores.reduce((a,b)=>a+b,0)/this.tests.length;}\n botActions(l,i,t){const d=l.data;if(d.key==='foot')i.right=1;if(d.key==='step'){const phase=Math.floor(d.local/(60/96)),left=phase%2===0;if(d.botStep\"'!==phase){i.leftPress=left;i.rightPress=!left;d.botStep=phase;}i.left=left?1:0;i.right=left?0:1;}}\n widget(){const d=this.lanes[0].data;return `${CHECKS[d.key||'\"'stand'].title}<br>Test \"'${d.current+1} / 3`;}\n}\nEOF\ncat > src/core/script.js <<'\"'EOF'\nexport class Scheduler{\n constructor(){this.time=0;this.items=[];}\n after(seconds,fn){this.items.push({at:this.time+seconds,fn});}\n fixed(dt){this.time+=dt;let due=this.items.filter(i=>i.at<=this.time);this.items=this.items.filter(i=>i.at>this.time);for(let i of due)i.fn();}\n clear(){this.items=[];}\n}\nEOF\ncat > src/game/director.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {TITLE,TAGLINE,COLOURS,SEATS,TIERS,clamp} from '../data/config.js';\nimport {EVENTS,REGISTRY,HOTSPOTS} from '../data/events.js';\nimport {DAYS,TOTAL_STEPS,restTilt,age,medal,payout,nextTier} from '../data/programme.js';\nimport {NAMES,HATS,UNLOCKS} from '../data/names.js';\nimport {QUESTIONS,line} from '../data/dialogue.js';\nimport {ABOUT} from '../data/about.js';\nimport {TUNING,tuning,resetTuning} from '../data/tuning.js';\nimport {rng,pick,shuffled} from '../core/rng.js';\nimport {Save,freshProfile} from '../core/save.js';\nimport {Scheduler} from '../core/script.js';\nimport {UI,btn,panel,esc,discSVG} from '../ui/ui.js';\nimport {prompts,glyph} from '../input/glyphs.js';\nimport {AudioEngine} from '../audio/engine.js';\nimport {Island} from './island.js';\nimport {CheckIn,CHECKS} from './checkin.js';\nimport {createEvent} from '../events/registry.js';\nimport {label,ball,group} from '../art/materials.js';\nexport class Director{\n constructor(view,input,save=new Save()){\n this.view=view;this.input=input;this.save=save;this.settings=save.settings;this.tuning=tuning;this.audio=new AudioEngine(this.settings);this.ui=new UI(this);this.island=new Island(this);this.scheduler=new Scheduler();this.screen='boot';this.simTime=0;this.stateTime=0;this.errors=[];this.dev={god:false,timeScale:1,bot:false,debug:false,stats:false,freeCamera:false,neverBank:false};this.event=null;this.flow='programme';this.effects=[];this.testBot=null;this.idle=0;this.attract=false;this.attractIndex=0;this.menuPage=0;this.settingsPage=0;this.groupSeats=[];this.session=null;this.input.onActivity=(type,e)=>{this.idle=0;this.audio.unlock();if(this.attract){this.stopAttract();return true;}if(this.screen==='island'&&type==='click'&&e?.target?.id==='world'&&e.button===0){let h=this.island.hitTest(e.clientX,e.clientY);if(h)this.island.target=h;}};this.input.onPadGesture=()=>this.audio.unlock();this.input.onDisconnect=index=>{if(this.screen==='play'&&\"'!this.session){this.pause();this.ui.toast('\"'Controller disconnected. Reconnect, or use the keyboard.',8);}};this.input.onPointerMove=e=>{const b=e.target.closest?.('button');if(b&&this.ui.screen.contains(b)){const i=this.ui.buttons.indexOf(b);if(i>=0)this.ui.setFocus(i);}if(this.screen==='island')this.island.hover=this.island.hitTest(e.clientX,e.clientY);};\n }\n get profile(){return this.save.profile;}\n get dayData(){return DAYS[Math.min(4,(this.profile?.day||1)-1)];}\n get today(){if((this.profile?.day||1)<=5)return this.dayData.events;const seed=(this.profile?.day||6),arr=shuffled(EVENTS.filter(e=>e.id\"'!=='\"'grand').map(e=>e.id),'maintenance-'+seed);return this.maintenance||=arr.slice(0,3);}\n setScreen(screen){this.screen=screen;this.stateTime=0;this.ui.pageMove=null;}\n disposeEvent(){if(this.event){this.event.dispose();this.event=null;}this.ui.clearHud();}\n standalone(){this.title();}\n title(){this.disposeEvent();this.setScreen('title');this.island.root.visible=true;this.audio.setTrack('title');this.ui.clearHud();this.idle=0;const touch=this.input.touchOnly;this.ui.show(\"'`<div class=\"title\"><div class=\"seal\">Level Best Retreat</div><h1><span>Wee</span><br><span>Knit</span></h1><div class=\"tagline\">${TAGLINE}</div><div class=\"subtitle\">A crooked little island.<br>A very patient pair of knees.</div></div><div class=\"island-caption\">Perfectly imperfect since forever.</div><div class=\"title-bottom\">${touch?'\"'<div class=\\\"tag\\\">Controller or keyboard required</div>'+btn('Settings','settings'):btn(\"'`<span data-prompt=\"confirm\"></span> Step into something wobbly`,'\"'start','','primary')}<div class=\\\"note\\\">\"'${touch?'\"'The island will show you around shortly.':'1–4 guests · no balance hardware required'}</div></div><div class=\\\"corner\\\">Original toys. Real wobbles.</div>\"'`,{start:()=>this.mainMenu(),settings:()=>this.settingsMenu('\"'title')});}\n mainMenu(){this.disposeEvent();this.setScreen('menu');this.ui.show(panel('Level Best Retreat','Make yourself almost comfortable.',\"'`<div class=\"choices\">${btn(this.profile?'\"'Continue your stay':'Begin your stay','programme','Five days. Fourteen questionable activities.','primary')}\"'${btn('\"'Group Class','group','1–4 on one screen')}\"'${btn('\"'Free Play','free','A little practice')}\"'${btn('\"'Journal','journal','Proof that you turned up')}\"'${btn('\"'Settings','settings','For your particular knees')}\"'${btn('\"'About & Credits','about','The small print, enlarged')}</div>\"'`,`<span class=\"page-indicator\">${this.profile?esc(this.profile.name)+'\"' · Day '+this.profile.day:'A retreat for everyone who has ever leaned.'}</span>\"'`),{programme:()=>this.chooseProfiles(),group:()=>this.groupLobby(),free:()=>this.freePlay(),journal:()=>this.journal(),settings:()=>this.settingsMenu('\"'menu'),about:()=>this.about()},()=>this.title());}\n chooseProfiles(){this.setScreen('profiles');this.ui.show(panel('Who’s here today?','Pick a mat.',\"'`<div class=\"profile-mats\">${this.save.data.profiles.map((p,i)=>btn(`<span class=\"peg\" style=\"color:${p?.colour||'\"'#acaa95'}\\\">●</span>\"'${p?esc(p.name):'\"'A new guest'}\"'`,'\"'p'+i,p?'Day '+p.day:'Make yourself known')).join('')}</div>\"'`,`<span class=\"muted\">Up to four familiar faces.</span>${btn('\"'Back','back')}\"'`),Object.fromEntries([...this.save.data.profiles.map((p,i)=>['\"'p'+i,()=>{this.save.data.selected=i;if(p){this.island.setProfile(p);this.save.write();this.enterStay();}else this.newProfile();}]),['back',()=>this.mainMenu()]]),()=>this.mainMenu());}\n newProfile(){this.setScreen('newProfile');this.pendingName=this.pendingName||pick(NAMES,'names');this.pendingPaint=this.pendingPaint??0;this.ui.show(panel('Welcome, probably','A name to grow into.',\"'`<p style=\"font-size:1.3em;color:var(--teal)\">${esc(this.pendingName)}</p><p class=\"muted\">Pick a paint. Your knees will remain anonymous.</p><div style=\"height:4vh;background:${COLOURS[this.pendingPaint]};border:2px solid var(--ink);border-radius:1vh\"></div><div class=\"choices\">${btn('\"'Another name','name')}\"'${btn('\"'Next paint','paint')}\"'${btn('\"'This is me','accept','','primary')}\"'${btn('\"'Back','back')}</div>\"'`),{name:()=>{this.pendingName=pick(NAMES,'\"'names');this.newProfile();},paint:()=>{this.pendingPaint=(this.pendingPaint+1)%COLOURS.length;this.newProfile();},accept:()=>{this.save.data.profiles[this.save.data.selected]=freshProfile(this.pendingName,COLOURS[this.pendingPaint]);this.pendingName=null;this.island.setProfile(this.profile);this.save.write();this.island.walker.setTranslation({x:0,y:4,z:10},true);this.say('Trudy','Oh\"'! A person. Please step on. Not on me. On the island.'\"',()=>this.tutorial(0));},back:()=>this.chooseProfiles()},()=>this.chooseProfiles());}\n say(speaker,text,next){this.setScreen('speech');this.speechNext=next;this.speechText=text;this.audio.say(text,speaker);this.ui.speech(speaker,text);this.speechDuration=Math.max(1.2,text.length/(speaker==='Trudy'?24:18));}\n tutorial(step=0){this.setScreen('tutorial');this.tutorialStep=step;this.tutorialHold=0;const text=['Lean left. Your other left. No, that was correct.','Now lean right. The whole island can feel that, by the way.','Now forward. Excellent. The oranges are having a very full day.'][step];this.audio.say(text,'Trudy');this.ui.show(\"'`<div class=\"topline\"><div class=\"tag\">Your first small adjustment</div></div><div class=\"speech\"><span class=\"name\">Trudy · Head of Alignment</span>${text}<div class=\"prompts\" data-prompt=\"lean\"></div></div>`);}\n enterStay(){this.flow='\"'programme';this.maintenance=null;this.island.setProfile(this.profile);if(\"'!this.profile.tutorial){this.tutorial(0);return;}if(this.profile.checkDone)this.showIsland();else this.morning();}\n morning(){const day=this.profile.day;let text=day===1?'\"'Welcome to your first day. The island is nine degrees from normal. So am I.':line('morning');const elapsed=(Date.now()-this.profile.lastVisit)/864e5;if(elapsed>=2)text=\"'`It has been ${Math.floor(elapsed)} days. The island tilted a bit. I am not saying those things are connected.`;this.say('\"'Trudy',text,()=>this.question());}\n question(){this.setScreen('question');const q=QUESTIONS[(this.profile.day-1)%QUESTIONS.length];this.audio.say(q.q,'Trudy');this.ui.show(panel(\"'`Morning ${this.profile.day} · A personal question`,q.q,`<div class=\"choices\">${btn('\"'Yes','yes','','primary')}\"'${btn('\"'No','no')}</div>\"'`),{yes:()=>this.say('\"'Trudy',q.yes,()=>this.checkIntro()),no:()=>this.say('Trudy',q.no,()=>this.checkIntro())});}\n checkIntro(){this.setScreen('checkIntro');this.ui.show(panel('The morning Check-In','Let’s ask your knees.',\"'`<div class=\"diagram\">${discSVG()}</div><p>Three short tests. A little stillness, a little leaning, a little footwork.</p><p class=\"muted\">Your Wobble Age is imaginary. No real age required.</p><div class=\"prompts\" data-prompt=\"lean,feet\"></div>`,`${btn('\"'Begin Check-In','begin','','primary')}\"'${btn('\"'How to play','how')}\"'`),{begin:()=>this.startCheck(),how:()=>this.howTo('\"'checkIntro')});}\n startCheck(){this.disposeEvent();this.flow='check';this.island.hide();this.event=new CheckIn(this,'check',1,[this.localConfig()],{tests:this.dayData.tests});this.countdown();}\n localConfig(){return {name:this.profile?.name||'Guest',colour:this.profile?.colour||COLOURS[0],hat:this.profile?.hat||0,kind:'local',device:'main',pad:this.input.padIndex||0};}\n showIsland(){this.disposeEvent();this.flow='programme';this.setScreen('island');this.island.root.visible=true;this.audio.setTrack('island');this.ui.clear();this.ui.hud.innerHTML=\"'`<div class=\"topline\"><div class=\"tag\">Day ${this.profile?.day||1} · ${esc(this.profile?.name||'\"'Guest')}</div><div class=\\\"tag gold\\\"><span class=\\\"marble-count\\\">\"'${this.profile?.marbles||0}</span> marbles · <span class=\"tilt-count\">${restTilt(this.profile?.steps||0).toFixed(1)}°</span></div></div><div class=\"bottom-prompts prompts\" data-prompt=\"steer,confirm,ask,pause\"></div><div id=\"hotspot\" class=\"world-hotspot\" hidden></div>`;this.ui.updatePrompts();}\n useHotspot(id){if(this.screen!=='\"'island')return;if(id==='bed'){if(this.today.every(x=>this.profile.done.includes(x)))this.bedPrompt();else this.say('Trudy','Your bed is ready. Your classes are not quite ready to let you go.',()=>this.todayPlan());}else if(id==='plan')this.todayPlan();else if(id==='mirror')this.mirror();else if(id==='jar')this.jarView(0,()=>this.showIsland());else if(REGISTRY[id]){if(this.profile.levelled||this.profile.medals[id]||this.today.includes(id)){this.flow=this.today.includes(id)&&\"'!this.profile.done.includes(id)?'\"'programme':'free';this.intro(id);}else this.ui.toast('We will meet that class on a later day.');}}\n todayPlan(){this.setScreen('plan');let ids=this.today;this.ui.show(panel(\"'`Day ${this.profile.day} · ${this.profile.day<=5?this.dayData.name:'\"'Maintenance'}\"'`,this.today.every(x=>this.profile.done.includes(x))?'\"'A pleasing amount of attendance.':'Today’s small intentions.',\"'`<div class=\"choices\">${ids.map(id=>btn(`${this.profile.done.includes(id)?'\"'✓ ':''}\"'${REGISTRY[id].title}`,id,REGISTRY[id].place,this.profile.done.includes(id)?'\"'secondary':'')).join('')}\"'${btn('\"'Walk around','island')}\"'${btn('\"'Go to bed','bed')}</div>\"'`,`<span class=\"muted\">Any order. No skill gate. ${this.profile.done.length}/${ids.length} classes attended.</span>`),Object.fromEntries([...ids.map(id=>[id,()=>{this.flow=this.profile.done.includes(id)?'\"'free':'programme';this.intro(id);}]),['island',()=>this.showIsland()],['bed',()=>this.bedPrompt()]]),()=>this.showIsland());}\n bedPrompt(){this.setScreen('bed');const complete=this.today.every(x=>this.profile.done.includes(x));this.ui.show(panel('The Bed Hut',complete?'A well-earned horizontal moment.':'A little more day left.',\"'`<p>${complete?'\"'We will stamp the calendar and put the island away until morning.':'You can finish today’s classes in any order. Trudy has kept your place.'}</p><div class=\\\"choices\\\">\"'${complete?btn('\"'Good night','sleep','','primary'):btn('Today’s plan','plan','','primary')}\"'${btn('\"'Stay a little longer','stay')}</div>\"'`),{sleep:()=>this.sleep(),plan:()=>this.todayPlan(),stay:()=>this.showIsland()},()=>this.showIsland());}\n sleep(){const p=this.profile;p.stamps.push({day:p.day,date:new Date().toLocaleDateString()});p.day++;p.done=[];p.checkDone=false;p.lastVisit=Date.now();this.maintenance=null;this.save.write();this.setScreen('\"'sleep');this.ui.show(\"'`<div class=\"backdrop\" style=\"background:#302c37e8\"></div><div class=\"countdown\" style=\"font-size:8vh;color:#fff4dc\">Day ${p.day}<br>A little more level.</div>`);this.audio.sfx('\"'stamp');this.scheduler.after(2.5,()=>this.morning());}\n intro(id,tier=1){this.disposeEvent();this.currentId=id;this.currentTier=tier;this.setScreen('intro');this.island.hide();const m=REGISTRY[id];this.audio.setTrack(m.discipline==='Stillness'?'still':m.discipline==='Strength'?'strength':m.discipline==='Cardio'?'cardio':id==='grand'?'level':'balance');this.buildEvent(id,tier);this.ui.clearHud();this.ui.show(panel(\"'`${m.discipline} · ${m.place} · ${TIERS[tier-1]}`,m.title,`<div class=\"diagram\">${discSVG()}</div><p>${m.one}</p><p>${m.can}</p><p class=\"muted\">${m.cant}</p><div class=\"prompts\" data-prompt=\"${m.verbs.join('\"',')}\\\"></div>\"'`,`${btn('\"'Let’s try','start','','primary')}\"'${btn('\"'Back','back')}\"'`),{start:()=>this.countdown(),back:()=>this.leaveEvent()},()=>this.leaveEvent());}\n buildEvent(id,tier=1,opts={}){this.disposeEvent();let configs=this.groupRun?this.groupRun.seats.map(s=>({...s,kind:'\"'local'})):[this.localConfig()];if(opts.configs)configs=opts.configs;this.event=createEvent(this,id,tier,configs,opts);}\n countdown(){this.setScreen('countdown');this.ui.clear();this.ui.eventHud(this.event);this.audio.sfx('bell');this.ui.screen.innerHTML='<div class=\\\"countdown\\\">3</div>';}\n beginPlay(){this.setScreen('play');this.ui.clear();this.event.start();}\n finishEvent(){if(\"'!this.event)return;if(this.flow==='\"'check'){const mean=this.event.lanes[0].form/100,p=this.profile,number=age(mean,p.day);p.ages.push({day:p.day,age:number,tests:[...this.event.lanes[0].data.scores]});p.checkDone=true;p.steps=Math.min(TOTAL_STEPS,p.steps+1);p.marbles++;this.save.write();this.ageReveal(number);return;}this.results();}\n results(){this.setScreen('results');const e=this.event,r=e.laneResult(0),m=medal(r.form);this.ui.clearHud();this.audio.sting(m);const speaker=e.meta.instructor;this.resultLine=r.form<40?'You attended with considerable presence.':r.form>=97?'Suspicious. I have written that in permanent ink.':line('observe',speaker);this.audio.say(this.resultLine,speaker);this.ui.show(panel(\"'`${e.meta.title} · ${TIERS[e.tier-1]}`,'\"'A small achievement.',\"'`<div class=\"result-layout\"><div><div class=\"result-number\">${r.form}<span style=\"font-size:.3em\">%</span></div><div class=\"number-label\">form</div></div><div class=\"stamp\">${m}</div></div><p class=\"muted\">${esc(r.detail)}</p><p>“${esc(this.resultLine)}”</p>`,`${btn('\"'Continue','continue','','primary')}\"'${btn('\"'One more go','retry')}\"'`),{continue:()=>this.acceptResult(),retry:()=>{let id=e.id,t=e.tier;this.intro(id,t);}},()=>this.acceptResult());}\n acceptResult(){if(!this.event)return;if(this.groupRun){this.groupAccept();return;}const e=this.event,p=this.profile,r=e.laneResult(0);if(!p){this.leaveEvent();return;}const first=!p.medals[e.id],old=p.medals[e.id]||[0,0,0];old[e.tier-1]=Math.max(old[e.tier-1],r.form);p.medals[e.id]=old;p.falls+=r.falls;p.minutes+=e.t/60;let n=payout(e.t,r.form,first,tuning.marblesPerMinute);p.marbles+=n;let programme=this.flow==='\"'programme';if(programme&&\"'!p.done.includes(e.id)){p.done.push(e.id);p.steps=Math.min(TOTAL_STEPS,p.steps+1);}if(e.id==='\"'grand'){p.levelled=true;p.steps=TOTAL_STEPS;}this.save.write();if(e.id==='grand'){this.ending();return;}const callback=programme?()=>this.todayPlan():()=>this.freePlay(this.freePage||0);this.jarView(n,callback,medal(r.form));}\n ageReveal(number){this.disposeEvent();this.setScreen('age');this.currentAge=number;this.ui.show(\"'`<div class=\"backdrop\"></div><section class=\"panel paper\" style=\"text-align:center\"><div class=\"eyebrow\">The Check-In · Day ${this.profile.day}</div><h1>Your Wobble Age</h1><div class=\"result-number\" id=\"age-counter\">99</div><p id=\"age-line\">A moment for your knees…</p><div id=\"age-continue\" hidden>${btn('\"'A distinguished start','continue','','primary')}</div></section>\"'`,{continue:()=>this.jarView(1,()=>this.todayPlan())});this.audio.sfx('\"'stamp');}\n jarView(count,callback,medalName='Pleasant'){this.disposeEvent();this.setScreen('jar');this.island.root.visible=true;this.jarCount=count;this.jarAdded=0;this.jarCallback=callback;this.jarMedal=medalName;this.ui.show(\"'`<div class=\"topline\"><div class=\"tag\">A little more level</div><div class=\"tag gold\" id=\"jar-count\">${this.profile?.marbles-count||0} marbles</div></div><div class=\"speech\"><span class=\"name\">Trudy</span>${line('\"'jar')}<div class=\\\"footer\\\">\"'${btn('\"'Lovely','continue','','primary')}<span class=\\\"muted\\\">Your island is \"'${restTilt(this.profile?.steps||0).toFixed(1)}° from the middle.</span></div></div>`,{continue:()=>{while(this.jarAdded<count){this.island.addMarbles(1);this.jarAdded++;}callback();}});this.audio.sfx('\"'creak');let unlocked=UNLOCKS.filter(u=>this.profile&&this.profile.marbles>=u.n&&this.profile.marbles-count<u.n);if(unlocked.length)this.ui.toast('New for the Mirror: '+unlocked.map(x=>x.name).join(', '),5);}\n leaveEvent(){this.disposeEvent();if(this.groupRun){this.groupRun=null;this.groupLobby();}else if(this.flow==='free')this.freePlay();else if(this.profile)this.todayPlan();else this.mainMenu();}\n freePlay(page=0){this.disposeEvent();this.groupRun=null;this.flow='free';this.freePage=page;this.setScreen('free');const ids=EVENTS.filter(e=>this.profile?.levelled||this.profile?.medals[e.id]||this.today.includes(e.id)),pages=Math.max(1,Math.ceil(ids.length/4)),list=ids.slice(page*4,page*4+4);this.ui.show(panel('Free Play','Choose a little wobble.',\"'`<div class=\"choices\">${list.map(e=>btn(e.title,e.id,e.discipline)).join('\"'')}\"'${btn('\"'Back','back')}</div>\"'`,`<span class=\"page-indicator\">${page+1} / ${pages} · Classes open as you meet them.</span>${btn('\"'Next page','next')}\"'`),Object.fromEntries([...list.map(e=>[e.id,()=>this.tierMenu(e.id)]),['\"'back',()=>this.mainMenu()],['next',()=>this.freePlay((page+1)%pages)]]),()=>this.mainMenu());this.ui.pageMove=dir=>this.freePlay((page+dir+pages)%pages);}\n tierMenu(id){this.setScreen('tiers');let open=this.profile?.levelled?Math.max(1,nextTier(this.profile.medals[id]||[])):nextTier(this.profile?.medals[id]||[]);this.ui.show(panel(REGISTRY[id].title,'How unreasonable?',\"'`<div class=\"choices one\">${TIERS.map((name,i)=>btn(`${name}${i+1>open?'\"' · locked':''}\"'`,'\"'tier'+i,i===0?'A gentle beginning':i===1?'Pleasant on Gentle opens this':'Exemplary on Honest opens this',i+1>open?'secondary':'')).join('')}</div>\"'`,btn('\"'Back','back')),Object.fromEntries([...TIERS.map((_,i)=>['tier'+i,()=>{if(i+1<=open){this.flow='free';this.intro(id,i+1);}else this.ui.toast('Earn a medal on the previous tier first.');}]),['back',()=>this.freePlay(this.freePage)]]),()=>this.freePlay(this.freePage));}\n pause(){if(this.session){this.settingsMenu('session');return;}if(['title','menu','settings','pause','dev','about'].includes(this.screen))return;this.pausedScreen=this.screen;this.setScreen('pause');this.pauseMenu();}\n pauseMenu(){this.ui.show(panel('A small intermission','Take your time.',\"'`<div class=\"choices\">${btn('\"'Resume','resume','','primary')}\"'${btn('\"'Restart class','restart')}\"'${btn('\"'How to play','how')}\"'${btn('\"'Settings','settings')}\"'${btn('\"'Dev Mode','dev')}\"'${btn('\"'Leave class','leave')}</div>\"'`),{resume:()=>this.resume(),restart:()=>this.restart(),how:()=>this.howTo('\"'pause'),settings:()=>this.settingsMenu('pause'),dev:()=>this.devMenu(),leave:()=>this.leaveEvent()},()=>this.resume());}\n resume(){const s=this.pausedScreen||'island';this.setScreen(s);this.ui.clear();if(s==='play'&&this.event)this.ui.eventHud(this.event);else if(s==='island')this.showIsland();else if(s==='intro')this.intro(this.currentId,this.currentTier);else if(s==='tutorial')this.tutorial(this.tutorialStep);else if(s==='speech')this.ui.speech('Trudy',this.speechText);else if(s==='countdown')this.countdown();else this.showIsland();}\n restart(){if(this.event){if(this.event.id==='check')this.startCheck();else this.intro(this.event.id,this.event.tier);}else this.showIsland();}\n howTo(returnTo='pause'){this.setScreen('how');const m=this.event?.meta;this.ui.show(panel(m?.title||'A little balance','One verb: shift your weight.',\"'`<div class=\"diagram\">${discSVG()}</div><p>Your solid dot is your real balance. The dotted ring is where you asked to lean. Keep the dot in the green zone.</p><p class=\"muted\">${m?.can||'\"'Stick or mouse: lean. Keys move the ring and leave it there. C recentres.'}<br>\"'${m?.cant||'\"'Flail is a last-moment save. Falls are just floor exercises.'}</p><div class=\\\"prompts\\\" data-prompt=\\\"\"'${(m?.verbs||['\"'lean','flail']).join(',')}\\\"></div>\"'`,btn('\"'Understood','back','','primary')),{back:()=>returnTo==='pause'?(this.setScreen('pause'),this.pauseMenu()):this.checkIntro()},()=>returnTo==='pause'?(this.setScreen('pause'),this.pauseMenu()):this.checkIntro());}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_43","type":"agent_message","text":"All 14 activities are implemented, including the three-dive Springboard, shrinking Tippy Raft and Grand Hold finale. I’m connecting the programme flow now: profiles, morning tests, Wobble Age, marble rewards, unlocks, bedtime and the ending.\n"}}
{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"cat >> src/game/director.js <<'EOF'\n settingsMenu(returnTo=this.screen,page=0){this.settingsReturn=returnTo;this.settingsPage=page;this.setScreen('settings');const groups=[['Sound',['music','Music',0,100,5],['sfx','Sound effects',0,100,5],['voice','Voices',0,100,5]],['Controls',['glyphs','Controller glyphs',['PlayStation','Xbox']],['rumble','Rumble'],['autoBreathe','Auto-breathe'],['offset','Rhythm offset (ms)',-200,200,10]],['Display',['uiScale','UI size',.8,1.2,.05],['ink','Ink strength',0,1.5,.1],['reduceShake','Reduce movement'],['fullscreen','Fullscreen']],['Game',['difficulty','Difficulty',['Gentle','Standard','Honest']],['reset','Reset saved stay']]];\n const list=this.session?[groups[0]]:groups;page=page%list.length;const [title,...rows]=list[page],actions={};let html=rows.map(([key,label,a,b,step])=>{if(typeof a==='number'){actions[key]=(dir,button,percent)=>{let val=percent===undefined?this.settings[key]+(typeof dir==='number'?dir:1)*step:a+percent*(b-a);this.settings[key]=clamp(Math.round(val/step)*step,a,b);this.audio.updateMix();this.save.write();this.updateSettingButton(button,key,label,a,b);};return this.slider(key,label,this.settings[key],a,b);}actions[key]=()=>{if(key==='fullscreen'){if(document.fullscreenElement)document.exitFullscreen?.().catch(()=>{});else document.documentElement.requestFullscreen?.().catch(()=>this.ui.toast('Fullscreen is not available here.'));}else if(key==='reset'){this.resetConfirm();return;}else if(Array.isArray(a)){this.settings[key]=a[(a.indexOf(this.settings[key])+1)%a.length];}else this.settings[key]=\"'!this.settings[key];this.save.write();this.settingsMenu(returnTo,page);};let value=key==='\"'fullscreen'?(document.fullscreenElement?'On':'Off'):key==='reset'?'…':Array.isArray(a)?this.settings[key]:this.settings[key]?'On':'Off';return \"'`<div class=\"settings-row\"><label>${label}</label>${btn(value,key)}</div>`;}).join('\"'');actions.next=()=>this.settingsMenu(returnTo,(page+1)%list.length);actions.back=()=>this.returnSettings();this.ui.show(panel(\"'`Settings · ${page+1} / ${list.length}`,title,html,`${btn('\"'Back','back')}<span class=\\\"page-indicator\\\">Left / right adjusts a slider.</span>\"'${this.session?'\"'':btn('Next page','next')}\"'`),actions,()=>this.returnSettings());this.ui.pageMove=dir=>this.settingsMenu(returnTo,(page+dir+list.length)%list.length);}\n slider(key,label,value,min,max){const p=clamp((value-min)/(max-min));return `<button class=\"slider-row\" data-action=\"${key}\" data-slider=\"${key}\" role=\"slider\" aria-label=\"${label}\" aria-valuemin=\"${min}\" aria-valuemax=\"${max}\" aria-valuenow=\"${value}\"><span class=\"slider-line\"><span>${label}</span><b>${Number(value.toFixed(3))}${['\"'music','sfx','voice'].includes(key)?'%':''}</b></span><div class=\\\"slider-track\\\"><div class=\\\"slider-fill\\\" style=\\\"width:\"'${p*100}%\"></div><div class=\"slider-knob\" style=\"left:calc(${p*100}% - 1.15vh)\"></div></div></button>`;}\n updateSettingButton(button,key,label,min,max){if(!button)return;let val=this.settings[key],p=(val-min)/(max-min);button.querySelector('\"'b').textContent=Number(val.toFixed(3))+(['music','sfx','voice'].includes(key)?'%':'');button.querySelector('.slider-fill').style.width=p*100+'%';button.querySelector('.slider-knob').style.left=\"'`calc(${p*100}% - 1.15vh)`;button.setAttribute('\"'aria-valuenow',val);}\n returnSettings(){const s=this.settingsReturn;this.save.write();if(this.session){this.setScreen('sessionPlay');this.ui.clear();return;}if(s==='pause'){this.setScreen('pause');this.pauseMenu();}else if(s==='title')this.title();else this.mainMenu();}\n resetConfirm(){this.setScreen('resetConfirm');this.ui.show(panel('A clean mat','Start the stay again?',\"'`<p>This clears the four guest profiles, journal and marbles on this device.</p><div class=\"choices\">${btn('\"'Keep my stay','keep','','primary')}\"'${btn('\"'Clear the saved stay','clear')}</div>\"'`),{keep:()=>this.settingsMenu(this.settingsReturn,3),clear:()=>{this.save.reset();this.settings=this.save.settings;this.audio.settings=this.settings;this.audio.updateMix();this.title();}},()=>this.settingsMenu(this.settingsReturn,3));}\n journal(page=0){this.disposeEvent();this.setScreen('\"'journal');let p=this.profile||freshProfile(),medals=Object.entries(p.medals),medalPages=Math.max(1,Math.ceil(medals.length/6)),pages=3+medalPages;page=(page+pages)%pages;let body,title;if(page===0){title='Proof of attendance.';body=\"'`<div class=\"calendar\">${Array.from({length:14},(_,i)=>`<div class=\"${p.stamps.some(s=>s.day===i+1)?'\"'done':''}\\\">Day \"'${i+1}<br>${p.stamps.some(s=>s.day===i+1)?'\"'✓':'·'}</div>\"'`).join('\"'')}</div>\"'`;}else if(page===1){title='\"'Your knees, over time.';let maxDay=Math.max(5,...p.ages.map(a=>a.day)),points=p.ages.map(a=>\"'`${60+(a.day-1)/(maxDay-1)*780},${220-(a.age-18)/81*190}`);body=`<svg class=\"journal-graph\" viewBox=\"0 0 900 260\"><path d=\"M60 20V225H850\" stroke=\"#a99b7d\" fill=\"none\" stroke-width=\"3\"/><polyline points=\"${points.join('\"' ')}\\\" stroke=\\\"#537d78\\\" fill=\\\"none\\\" stroke-width=\\\"6\\\"/>\"'${p.ages.map((a,i)=>`<circle cx=\"${points[i].split('\"',')[0]}\\\" cy=\\\"\"'${points[i].split('\"',')[1]}\\\" r=\\\"7\\\" fill=\\\"#da9872\\\"/><text x=\\\"\"'${points[i].split('\"',')[0]}\\\" y=\\\"\"'${Number(points[i].split('\"',')[1])-15}\\\" font-size=\\\"30\\\" font-family=\\\"Fredoka\\\" text-anchor=\\\"middle\\\">\"'${a.age}</text>`).join('\"'')}</svg><div class=\\\"totals\\\"><div><strong>\"'${p.ages[0]?.age??'\"'—'}</strong><span>First visit</span></div><div><strong>\"'${p.ages.at(-1)?.age??'\"'—'}</strong><span>Latest</span></div><div><strong>\"'${p.ages.length?Math.min(...p.ages.map(a=>a.age)):'\"'—'}</strong><span>Most spry</span></div></div>\"'`;}else if(page===pages-1){title='\"'Some very silly totals.';body=\"'`<div class=\"totals\"><div><strong>${p.falls}</strong><span>Floor exercises</span></div><div><strong>${Math.round(p.minutes)}</strong><span>Minutes here</span></div><div><strong>${p.marbles}</strong><span>Marbles</span></div></div><p class=\"muted\">${p.levelled?'\"'One island, finally level.':'The world is your progress bar.'}</p>\"'`;}else{title='\"'A modest medal shelf.';body=\"'`<div class=\"choices\">${medals.slice((page-2)*6,(page-1)*6).map(([id,m])=>`<div class=\"tag\">${REGISTRY[id]?.title}<br>${medal(Math.max(...m))}</div>`).join('\"'')||'<p>The shelf has excellent potential.</p>'}</div>\"'`;}this.ui.show(panel('\"'The Journal',title,body,\"'`${btn('\"'Back','back')}<span class=\\\"page-indicator\\\">\"'${page+1} / ${pages}</span>${btn('\"'Next page','next')}\"'`),{back:()=>this.mainMenu(),next:()=>this.journal((page+1)%pages)},()=>this.mainMenu());this.ui.pageMove=dir=>this.journal(page+dir);}\n mirror(){this.setScreen('\"'mirror');if(\"'!this.profile){this.chooseProfiles();return;}if(this.profile.day<3&&!this.profile.levelled){this.say('\"'Trudy','The Mirror opens on Day 3. It is taking some time to reflect.',()=>this.showIsland());return;}let p=this.profile,next=(p.hat+1)%HATS.length,need=UNLOCKS.find(u=>u.hat===next)?.n||0;this.ui.show(panel('The Mirror','A small personal renovation.',\"'`<p><span style=\"display:inline-block;background:${p.colour};width:4vh;height:4vh;border:2px solid var(--ink);border-radius:50%;vertical-align:middle\"></span> ${esc(p.name)}</p><p>Your hat: <b>${HATS[p.hat]}</b></p><p class=\"muted\">Next: ${HATS[next]}${p.marbles<need?'\"' · opens at '+need+' marbles':''}</p><div class=\\\"choices\\\">\"'${btn('\"'Next paint','paint')}\"'${btn('\"'Next hat','hat')}\"'${btn('\"'Lovely','back','','primary')}</div>\"'`),{paint:()=>{p.colour=COLOURS[(COLOURS.indexOf(p.colour)+1)%COLOURS.length];this.island.setProfile(p);this.save.write();this.mirror();},hat:()=>{if(p.marbles>=need){p.hat=next;this.island.setProfile(p);this.save.write();this.mirror();}else this.ui.toast(need+'\"' marbles, and it is yours.');},back:()=>this.showIsland()},()=>this.showIsland());}\n about(page=0,ending=false){this.setScreen('about');this.aboutEnding=ending;let info=Object.entries(ABOUT.sourceInformation),sections=[];for(let i=0;i<info.length;i+=3)sections.push({title:'Source Information',body:info.slice(i,i+3).map(([k,v])=>\"'`<p><b>${k.replace(/([A-Z])/g,'\"' \"'$1'\"').replace(/\"'^./,s=>s.toUpperCase())}</b><br>${esc(v)}</p>`).join('\"'')});for(let [key,title] of [['testingFeedback','Testing Feedback'],['engineFeedback','Engine Feedback'],['promptFeedback','Prompt Feedback']]){const qs={testingFeedback:['Issues caught','Critical issues','Most helpful test','Least helpful test'],engineFeedback:['What worked best','What surprised me','Most important custom system','Hardest engine task','Engine changes','One engine improvement'],promptFeedback:['What worked in the prompt','What was confusing','Hardest part','One prompt improvement']}[key];for(let i=0;i<ABOUT[key].length;i+=2)sections.push({title,body:ABOUT[key].slice(i,i+2).map((v,j)=>\"'`<p><b>${qs[i+j]}</b><br>${esc(v)}</p>`).join('\"'')});}sections.push({title:'Made of small things.',body:\"'`<p><b>${TITLE}</b><br>Original models, animation, writing, music, voices and effects made in code.</p><p>Three.js R180 · MIT<br>Rapier 0.19.3 · Apache-2.0<br>Fredoka · SIL Open Font License 1.1<br>AI Hub client 1.4.0 · Session Protocol v1</p>`});page=(page+sections.length)%sections.length;let s=sections[page];this.ui.show(panel(`About & Credits · ${page+1} / ${sections.length}`,s.title,`<div class=\"about-copy\">${s.body}</div>`,`${btn(ending?'\"'Same time tomorrow':'Back','back')}<span class=\\\"page-indicator\\\">← / → · Turn the page</span>\"'${btn('\"'Next page','next')}\"'`,'\"'about-panel'),{back:()=>ending?this.afterEnding():this.mainMenu(),next:()=>this.about(page+1,ending)},()=>ending?this.afterEnding():this.mainMenu());this.ui.pageMove=dir=>this.about(page+dir,ending);}\n groupLobby(){this.disposeEvent();this.setScreen('groupLobby');this.groupRun=null;this.ui.show(panel('Group Class · One screen','Bring your favourite knees.',\"'`<div class=\"profile-mats\">${Array.from({length:4},(_,i)=>`<div class=\"tag\" style=\"min-height:15vh;display:flex;flex-direction:column;justify-content:center;border-color:${SEATS[i]}\"><span style=\"font-size:3vh;color:${SEATS[i]}\">●</span><span style=\"font-size:.7em\">${this.groupSeats[i]?esc(this.groupSeats[i].name):'\"'Press Cross'}</span></div>\"'`).join('\"'')}</div><p class=\\\"muted\\\">Each controller presses Cross to join. Keyboard and mouse share one mat.</p><div class=\\\"choices\\\">\"'${btn('\"'Join keyboard & mouse','join')}\"'${btn('\"'Let’s have a class','begin','','primary')}\"'${btn('\"'Back','back')}</div>\"'`),{join:()=>this.joinGroup('\"'kbm',0),begin:()=>{if(this.groupSeats.length)this.groupPlaylist();else this.ui.toast('At least one pair of knees, please.');},back:()=>{this.groupSeats=[];this.mainMenu();}},()=>{this.groupSeats=[];this.mainMenu();});}\n joinGroup(device,pad){if(this.groupSeats.length>=4||this.groupSeats.some(s=>s.device===device&&s.pad===pad))return;let i=this.groupSeats.length;this.groupSeats.push({name:device==='kbm'?'Gentle Margaret':['Retired Kevin','Both Sandras','Young Gerald','Unsteady Paul'][i],colour:SEATS[i],device,pad,hat:i});this.groupLobby();this.ui.setFocus(1);this.audio.sfx('confirm');}\n groupPlaylist(picked=[],page=0){this.setScreen('groupPlaylist');const list=EVENTS.filter(e=>e.couch),pages=Math.ceil(list.length/3);let shown=list.slice(page*3,page*3+3);this.ui.show(panel('Group Class',picked.length?\"'`${picked.length} of 3 chosen.`:'\"'Three small competitions.',\"'`<div class=\"choices\">${btn('\"'Quick Class','quick','Three surprises','primary')}\"'${shown.map(e=>btn((picked.includes(e.id)?'\"'✓ ':'')+e.title,e.id)).join('')}\"'${btn('\"'Back','back')}</div>\"'`,`<span class=\"page-indicator\">${page+1} / ${pages}</span>${btn('\"'Next page','next')}\"'`),Object.fromEntries([['\"'quick',(