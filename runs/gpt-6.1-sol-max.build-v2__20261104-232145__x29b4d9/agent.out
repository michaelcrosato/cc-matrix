{"type":"item.started","item":{"id":"item_136","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='tools/shots.mjs';s=open(p).read().replace(\\\"import {chromium} from 'playwright';\\\", \\\"import {chromium,webkit,firefox} from 'playwright';\\\")\nstart=s.index('export async function viewportShots(')\ns=s[:start]+'''export async function serialMatrix(engine){const all=[['Pixel 10',360,732,true],['iPhone SE',375,667,true],['iPhone 17 Pro',402,681,true],['iPhone 17 Pro Max',440,763,true],['iPhone 17 landscape',756,352,true],['Galaxy Z Fold',984,1016,true],['iPad Mini',768,1024,true],['iPad Pro landscape',1194,834,true],['Galaxy Tab',640,1024,true],['Laptop',1366,768,false],['Desktop 16-9',1920,1080,false],['Desktop 16-10',1440,900,false],['Desktop 4-3',1024,768,false],['Ultrawide',2560,1080,false]],cases=engine==='firefox'?all.filter(c=>\"'!c[3]):all,results=[],out='\"'shots/matrix-'+engine;mkdirSync(out,{recursive:true});for(const [label,width,height,touch] of cases){let browser;const row={label,width,height,engine,errors:[],overflow:false};try{browser=await ({chromium,webkit,firefox}[engine]).launch({headless:engine\"'!=='\"'firefox'});const context=await browser.newContext({viewport:{width,height},deviceScaleFactor:1,isMobile:engine==='firefox'?false:touch,hasTouch:touch});const page=await context.newPage();page.on('pageerror',e=>row.errors.push(e.message));page.on('console',m=>{if(m.type()==='error')row.errors.push(m.text());});await page.goto('file://'+resolve('game.html')+'?test=1');await page.waitForFunction(()=>window.__TEST__&&__TEST__.state().render.frames>=2,{timeout:30000});await page.waitForTimeout(700);row.overflow=await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth);row.file=label.toLowerCase().replace(/[\"'^a-z0-9]/g,'\"'-')+'.png';await page.screenshot({path:out+'/'+row.file});const state=await page.evaluate(()=>__TEST__.state());if(state.render.lost)row.errors.push(state.render.lost);row.backend=state.render.backend;}catch(e){row.errors.push(e.message);}finally{await browser?.close();}results.push(row);}writeFileSync(out+'/report.json',JSON.stringify({results},null,2));return results;}\nexport async function viewportShots(check,engine='webkit'){if(engine==='firefox'){try{await exec('xvfb-run',['-a','node','tools/firefox-matrix.mjs'],{timeout:240000,maxBuffer:500000});}catch(e){writeFileSync('notes/matrix-firefox.log',(e.stdout||'')+'\\\\\\\\n'+(e.stderr||''));}}else await serialMatrix(engine);const report=JSON.parse(readFileSync('shots/matrix-'+engine+'/report.json','utf8'));for(const row of report.results)check(\"'!row.errors.length&&!row.overflow,'\"'Viewport '+engine+' '+row.label+' '+row.errors.join('; '));}\n'''\nopen(p,'w').write(s)\np='src/render/renderer.js';s=open(p).read().replace(\\\"old?.setAnimationLoop(null);old?.dispose();\\\", \\\"old?.setAnimationLoop(null);old?.backend?.gl?.getExtension('WEBGL_lose_context')?.loseContext();old?.dispose();\\\")\nopen(p,'w').write(s)\nPY\ncat > tools/firefox-matrix.mjs <<'EOF'\nimport {serialMatrix} from './shots.mjs';\nawait serialMatrix('firefox');\nEOF\nnode tools/build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
