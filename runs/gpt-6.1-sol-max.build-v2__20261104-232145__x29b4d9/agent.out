{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/events/fruit.js';s=open(p).read().replace(\\\"type,tx:x,tz:z,landing:this.t+flight\\\", \\\"type,tx:x,tz:z,startX:start.x,startZ:start.z,born:this.t,landing:this.t+flight\\\")\ns=s.replace(\\\"d.banking=Math.max(0,d.banking-dt);\\\", \\\"d.banking=Math.max(0,d.banking-dt);for(const p of l.fruit){if(\"'!p.active||p.caught||p.spent||this.t>p.landing)continue;const u=clamp((this.t-p.born+dt)/1.5),ease=1-(1-u)**3,pos=p.body.translation(),v=p.body.linvel();p.body.setLinvel({x:(p.startX+(p.tx-p.startX)*ease-pos.x)/dt,y:v.y,z:(p.startZ+(p.tz-p.startZ)*ease-pos.z)/dt},true);}\")\nopen(p,'\"'w').write(s)\nPY\ncat >> notes/issues.md <<'EOF'\n- 20 [balance] The integrated fruit flights carried too much sideways speed into the hat. Gave their arc a soft horizontal finish and a cushioned first catch; their weight and motion inside the hat remain dynamic Rapier contacts.\nEOF\nnode tools/build.mjs && node tools/test.mjs balance\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
