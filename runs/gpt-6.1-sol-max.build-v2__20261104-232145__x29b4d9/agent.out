n this.current;\n }\n lane(index,kind='pad'){return kind==='kbm'?this.keyboard:this.padStates[index]||blank();}\n clear(){this.keys.clear();this.presses.clear();this.mousePress=0;this.ring.x=this.ring.z=0;}\n rumble(padIndex,strong=.25,duration=90){try{const p=navigator.getGamepads()[padIndex||0];p?.vibrationActuator?.playEffect('dual-rumble',{duration,strongMagnitude:strong,weakMagnitude:strong*.5})?.catch?.(()=>{});}catch{}}\n}\nexport {blank};\nEOF\ncat > src/input/glyphs.js <<'EOF'\nconst shape={confirm:'<path d=\\\"M10 10l12 12m0-12L10 22\\\"/>',back:'<circle cx=\\\"16\\\" cy=\\\"16\\\" r=\\\"8\\\"/>',flail:'<rect x=\\\"8\\\" y=\\\"8\\\" width=\\\"16\\\" height=\\\"16\\\"/>',ask:'<path d=\\\"M16 7L26 24H6Z\\\"/>'};\nexport function glyph(verb,device='kbm',style='PlayStation'){\n let label,inner;\n if(device==='pad'){label=style==='Xbox'?({confirm:'A',back:'B',flail:'X',ask:'Y',hop:'A',left:'LT',right:'RT',breathe:'RB',pause:'☰',lean:'L',steer:'L',circle:'L'})[verb]:({hop:'×',left:'L2',right:'R2',breathe:'R1',pause:'☰',lean:'L',steer:'L',circle:'L'})[verb];inner=style==='PlayStation'&&shape[verb]?shape[verb]:\"'`<text x=\"16\" y=\"22\" fill=\"currentColor\" stroke=\"none\" text-anchor=\"middle\" font-size=\"${(label||'\"'').length>1?13:21}\\\" font-family=\\\"Fredoka,sans-serif\\\">\"'${label||'\"'×'}</text>\"'`;return `<svg class=\"glyph\" data-glyph=\"${style}-${verb}\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"16\" cy=\"16\" r=\"14\" opacity=\".25\"/>${inner}</svg>`;}\n label=({confirm:'\"'↵',back:'Esc',flail:'F',ask:'T',hop:'Space',left:'Q',right:'E',breathe:'Shift',pause:'Esc',lean:'WASD',steer:'WASD',circle:'A ↔ D'})[verb]||verb;\n return \"'`<span class=\"keycap\" data-glyph=\"key-${verb}\">${label}</span>`;\n}\nexport function prompts(verbs,input,settings){return verbs.map(v=>v==='\"'feet'?\"'`${glyph('\"'left',input.lastDevice,settings.glyphs)} \"'${glyph('\"'right',input.lastDevice,settings.glyphs)}<span>Feet</span>\"'`:`${glyph(v,input.lastDevice,settings.glyphs)}<span>${({lean:'\"'Lean',steer:'Steer',circle:'Circle / alternate',hop:'Hop / bank',breathe:'Breathe',flail:'Flail',confirm:'Continue',ask:'Today’s plan',pause:'Pause'})[v]||v}</span>\"'`).join('\"'<i></i>');}\nEOF\ncat > src/render/ink.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {mrt,output,normalView,toonOutlinePass,color,float,vec2,vec4,uv,screenSize,Fn,abs,max,smoothstep,mix,uniform,perspectiveDepthToViewZ,time,length,hash,floor,oneMinus} from 'three/tsl';\nexport function makeInk(renderer,scene,camera){const u={hull:uniform(.0028),width:uniform(1.2),boil:uniform(.35),grain:uniform(.015),near:uniform(camera.near),far:uniform(camera.far),ink:uniform(new T.Color(0x26232e))};const p=toonOutlinePass(scene,camera,color(0x26232e),u.hull,float(1));p.setMRT(mrt({output,normal:normalView}));const c=p.getTextureNode('output'),n=p.getTextureNode('normal'),d=p.getTextureNode('depth'),post=new T.PostProcessing(renderer);post.outputNode=Fn(()=>{const cell=floor(uv().mul(vec2(40,23))),wob=hash(floor(time.mul(8)).add(cell.x).add(cell.y.mul(17))).sub(.5).mul(u.boil),px=u.width.add(wob).div(screenSize),dx=vec2(px.x,0),dy=vec2(0,px.y);const z=o=>perspectiveDepthToViewZ(d.sample(uv().add(o)).r,u.near,u.far),nn=o=>n.sample(uv().add(o)).xyz,z0=z(vec2(0,0)).abs();const dz=max(abs(z(dx).sub(z(dx.negate()))),abs(z(dy).sub(z(dy.negate())))).div(z0.max(.5)),dn=max(length(nn(dx).sub(nn(dx.negate()))),length(nn(dy).sub(nn(dy.negate()))));let e=max(smoothstep(.05,.12,dz),smoothstep(.7,1.1,dn)).mul(oneMinus(smoothstep(40,100,z0)));let pix=floor(uv().mul(screenSize)),g=hash(pix.x.add(pix.y.mul(1571))).sub(.5).mul(u.grain);return vec4(mix(c.rgb,u.ink,e).add(g).mul(oneMinus(length(uv().sub(.5)).mul(.35).pow(2.2))),1);})();return {post,u};}\nEOF\ncat > src/render/renderer.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {Fn,mix,color,vec3,positionWorld,smoothstep,sin,length,time,step} from 'three/tsl';\nimport {makeInk} from './ink.js';\nimport {tuning} from '../data/tuning.js';\nimport {ball,group} from '../art/materials.js';\nexport class View{\n async init(skip=false){this.scene=new T.Scene();this.camera=new T.PerspectiveCamera(38,innerWidth/innerHeight,.1,800);this.camera.position.set(45,36,50);this.camera.lookAt(0,0,0);this.frames=0;this.lost=null;this.backend='none';this.target=new T.Vector3();this.wantPos=this.camera.position.clone();this.wantTarget=new T.Vector3();this.skip=skip;\n const hemi=new T.HemisphereLight(0xffead8,0x8aa6af,2.3);this.scene.add(hemi);this.sun=new T.DirectionalLight(0xffe9c8,3);this.sun.position.set(-25,45,20);this.sun.castShadow=true;Object.assign(this.sun.shadow.camera,{left:-40,right:40,top:40,bottom:-40,far:140});this.sun.shadow.mapSize.set(2048,2048);this.sun.shadow.bias=-.0006;this.sun.shadow.normalBias=.035;this.scene.add(this.sun);\n this.scene.background=new T.Color(0xf6d8ba);this.scene.fog=new T.Fog(0xf6d8ba,100,400);\n const seaMat=new T.MeshBasicNodeMaterial();seaMat.colorNode=Fn(()=>{const d=length(positionWorld.xz),wave=sin(d.mul(.65).sub(time.mul(.7)).add(sin(positionWorld.x.mul(.11)).mul(2)));return mix(mix(color(0x55b6bd),color(0xa4e0d5),step(.93,wave)),color(0xf6d8ba),smoothstep(90,300,d));})();let sea=new T.Mesh(new T.CircleGeometry(590,128),seaMat);sea.rotation.x=-Math.PI/2;sea.position.y=-4.2;sea.receiveShadow=true;this.scene.add(sea);\n const skyMat=new T.MeshBasicNodeMaterial({side:T.BackSide,depthWrite:false});skyMat.colorNode=Fn(()=>{const y=positionWorld.y.div(600);return mix(mix(color(0xffe4bf),color(0xf2c6c7),smoothstep(0,.15,y)),color(0x91bdd5),smoothstep(.12,.55,y));})();this.scene.add(new T.Mesh(new T.SphereGeometry(600,32,24),skyMat));this.clouds=group(this.scene);for(let i=0;i<15;i++){let g=group(this.clouds,Math.sin(i*7)*95,22+i%4*6,-70-Math.cos(i*3)*35);for(let j=0;j<3;j++)ball(g,0xffeedb,(j-1)*3,Math.sin(j)*.6,0,3.2,1.5,.35,.75);}\n if(skip)return this;\n this.renderer=new T.WebGPURenderer({antialias:true});this.renderer.setPixelRatio(Math.min(devicePixelRatio,1.7));this.renderer.setSize(innerWidth,innerHeight);this.renderer.toneMapping=T.NoToneMapping;this.renderer.shadowMap.enabled=true;this.renderer.shadowMap.type=T.PCFShadowMap;document.body.prepend(this.renderer.domElement);this.renderer.domElement.id='world';await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'webgpu':'webgl2';this.renderer.backend.device?.lost.then(info=>{this.lost=info.message||info.reason||'Device lost';window.__game?.errors.push(this.lost);});this.ink=makeInk(this.renderer,this.scene,this.camera);window.addEventListener('resize',()=>this.resize());return this;\n }\n resize(){this.camera.aspect=innerWidth/innerHeight;this.camera.updateProjectionMatrix();this.renderer?.setSize(innerWidth,innerHeight);}\n setCamera(p,t,snap=false){this.wantPos.set(...p);this.wantTarget.set(...t);if(snap){this.camera.position.copy(this.wantPos);this.target.copy(this.wantTarget);this.camera.lookAt(this.target);}}\n frame(dt,settings){const k=1-Math.exp(-dt*4);this.camera.position.lerp(this.wantPos,k);this.target.lerp(this.wantTarget,k);this.camera.lookAt(this.target);this.clouds.rotation.y+=dt*.0015;if(this.ink){let u=this.ink.u;u.hull.value=tuning.hull*settings.ink;u.width.value=tuning.lineWidth*settings.ink;u.boil.value=settings.reduceShake?0:tuning.boil;u.grain.value=tuning.grain;u.far.value=this.camera.far;this.ink.post.render();this.frames++;}}\n render(){if(this.ink){this.ink.post.render();this.frames++;}}\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > src/art/props.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {box,ball,cyl,torus,group,mesh,beam,label,glass,INK} from './materials.js';\nexport function tree(parent,x,z,s=1){let g=group(parent,x,0,z);g.scale.setScalar(s);cyl(g,0xb58b65,0,1.3,0,.18,2.6,.13);ball(g,0x76a684,0,2.7,0,1,1,1.2,1);ball(g,0x8cbb8a,-.45,2.65,.2,.7);for(let i=0;i<4;i++)ball(g,0xedac58,Math.cos(i*1.5)*.66,2.65+Math.sin(i)*.2,Math.sin(i*1.5)*.65,.13);return g;}\nexport function sign(parent,text,x,y,z,w=3){let g=group(parent,x,y,z);box(g,0xb58961,-w*.3,.6,0,.13,1.2,.13);box(g,0xb58961,w*.3,.6,0,.13,1.2,.13);box(g,0xf5e5bd,0,1.2,0,w,.72,.13);const l=label(text,'#40343b',null,w/4.7);l.position.set(0,1.24,.08);g.add(l);return g;}\nexport function crate(parent,x=0,z=0){let g=group(parent,x,0,z);box(g,0xc08855,0,.12,0,.8,.2,.7);for(let s of [-1,1]){box(g,0xd1a16e,s*.39,.3,0,.06,.4,.76);box(g,0xd1a16e,0,.3,s*.35,.8,.4,.055);}for(let i=0;i<3;i++)box(g,0x9b6a47,0,.18+i*.115,.382,.8,.025,.005);return g;}\nexport function basket(parent,y=1.56){let g=group(parent,0,y,0);cyl(g,0xdcb178,0,0,0,.37,.04);let rim=torus(g,0xb27c50,0,.13,0,.37,.025);rim.rotation.x=Math.PI/2;for(let i=0;i<16;i++){let a=i*Math.PI/8;box(g,0xe5bd87,Math.cos(a)*.36,.07,Math.sin(a)*.36,.04,.16,.04);}return g;}\nexport function tray(parent,y=1.25){let g=group(parent,0,y,.3);box(g,0x83a6a4,0,0,0,.66,.045,.66);for(let s of [-1,1]){box(g,0xe9e4c8,s*.33,.035,0,.025,.08,.68);box(g,0xe9e4c8,0,.035,s*.33,.68,.08,.025);}return g;}\nexport function fruitMesh(parent,type='orange'){let g=group(parent);if(type==='boot'){box(g,0x5f5d6d,0,0,0,.15,.1,.24);box(g,0x5f5d6d,0,.1,-.06,.13,.14,.1);}else if(type==='urchin'){ball(g,0x665781,0,0,0,.09);for(let i=0;i<8;i++){let a=i*.785;let sp=mesh(new T.ConeGeometry(.025,.1,5),0x665781,g,Math.cos(a)*.11,0,Math.sin(a)*.11);sp.quaternion.setFromUnitVectors(new T.Vector3(0,1,0),new T.Vector3(Math.cos(a),0,Math.sin(a)));}}else{ball(g,type==='gold'?0xffd358:type==='apple'?0xe96b54:0xf2a54d,0,0,0,type==='gold'?.1:.075,1,type==='gold'?1.3:1,1);if(type==='gold'){for(let i=0;i<4;i++)mesh(new T.ConeGeometry(.025,.16,4),0x6e9b75,g,Math.sin(i)*.03,.16,Math.cos(i)*.03);}else{cyl(g,0x7e9260,0,.08,0,.013,.045);ball(g,0x7eaf77,.025,.09,0,.03,1,.15,.5);}}return g;}\nexport function stone(parent,r=.25,hh=.09){let m=ball(parent,0xa7afb1,0,0,0,1,r,hh,r*.9);return m;}\nexport function jar(parent,x=0,z=0,s=1){let g=group(parent,x,0,z);g.scale.setScalar(s);const pts=[[.01,0],[1,.02],[1.08,.12],[1.08,1.9],[.86,2.2],[.86,2.45],[.95,2.5]].map(([a,b])=>new T.Vector2(a,b));mesh(new T.LatheGeometry(pts,48),glass,g);for(let [r,y] of [[1.08,.12],[1.08,1.9],[.86,2.2],[.95,2.5]]){let t=torus(g,INK,0,y,0,r,.022);t.rotation.x=Math.PI/2;}box(g,new T.MeshBasicNodeMaterial({color:0xffffff,transparent:true,opacity:.55,depthWrite:false}),-.8,1.1,.65,.06,1.4,.02);cyl(g,0xd3a66b,0,-.12,0,1.3,.22);let l=label('A little more level','#534441',null,.33);l.position.set(0,.92,1.04);g.add(l);return g;}\nexport function pavilion(p,x,z,c=0x6faeaa,scale=1){let g=group(p,x,0,z);g.scale.setScalar(scale);for(let a of [-1,1])for(let b of [-1,1])cyl(g,0xd3ac76,a*1.1,1.25,b*1.1,.1,2.5);box(g,c,0,2.6,0,2.9,.22,2.9);let cap=mesh(new T.ConeGeometry(2.05,.55,4),c,g,0,2.94,0);cap.rotation.y=Math.PI/4;return g;}\nexport function lighthouse(p,x,z){let g=group(p,x,0,z);for(let i=0;i<6;i++)cyl(g,i%2?0xe6d9b7:0xd87966,0,.55+i*.9,0,1.1-i*.055,.9,1.05-i*.055);cyl(g,0x425c6c,0,5.75,0,1.1,.25);cyl(g,glass,0,6.3,0,.7,.9);ball(g,0xffdd87,0,6.3,0,.28);for(let a=0;a<6;a++)beam(g,0x425c6c,[Math.cos(a*1.047)*.7,5.87,Math.sin(a*1.047)*.7],[Math.cos(a*1.047)*.7,6.8,Math.sin(a*1.047)*.7],.04);mesh(new T.ConeGeometry(1.15,.7,12),0x4e7c89,g,0,7,0);cyl(g,0xb4a386,0,.08,0,1.6,.16);box(g,0x546d76,0,.65,1.01,.44,1.1,.08);return g;}\nexport function bunting(p,a,b,colour=0xe58c70){beam(p,0x51494b,a,b,.015);for(let i=1;i<11;i++){let t=i/11,x=a[0]+(b[0]-a[0])*t,y=a[1]+(b[1]-a[1])*t-.12,z=a[2]+(b[2]-a[2])*t;let m=mesh(new T.ConeGeometry(.15,.33,3),i%3===0?0xeabf69:i%3===1?colour:0x8fbaaa,p,x,y,z);m.rotation.z=Math.PI;}}\nEOF\ncat > src/events/base.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {makeWorld,R,PROP} from '../physics/world.js';\nimport {Balancer} from '../physics/balancer.js';\nimport {doll,heron,walrus,trudy} from '../art/cast.js';\nimport {group,box,cyl,ball,label,torus,mesh} from '../art/materials.js';\nimport {tree,sign,bunting} from '../art/props.js';\nimport {REGISTRY,SEATS,COLOURS,clamp,lerp} from '../data/config.js';\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > src/art/props.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {box,ball,cyl,torus,group,mesh,beam,label,glass,INK} from './materials.js';\nexport function tree(parent,x,z,s=1){let g=group(parent,x,0,z);g.scale.setScalar(s);cyl(g,0xb58b65,0,1.3,0,.18,2.6,.13);ball(g,0x76a684,0,2.7,0,1,1,1.2,1);ball(g,0x8cbb8a,-.45,2.65,.2,.7);for(let i=0;i<4;i++)ball(g,0xedac58,Math.cos(i*1.5)*.66,2.65+Math.sin(i)*.2,Math.sin(i*1.5)*.65,.13);return g;}\nexport function sign(parent,text,x,y,z,w=3){let g=group(parent,x,y,z);box(g,0xb58961,-w*.3,.6,0,.13,1.2,.13);box(g,0xb58961,w*.3,.6,0,.13,1.2,.13);box(g,0xf5e5bd,0,1.2,0,w,.72,.13);const l=label(text,'#40343b',null,w/4.7);l.position.set(0,1.24,.08);g.add(l);return g;}\nexport function crate(parent,x=0,z=0){let g=group(parent,x,0,z);box(g,0xc08855,0,.12,0,.8,.2,.7);for(let s of [-1,1]){box(g,0xd1a16e,s*.39,.3,0,.06,.4,.76);box(g,0xd1a16e,0,.3,s*.35,.8,.4,.055);}for(let i=0;i<3;i++)box(g,0x9b6a47,0,.18+i*.115,.382,.8,.025,.005);return g;}\nexport function basket(parent,y=1.56){let g=group(parent,0,y,0);cyl(g,0xdcb178,0,0,0,.37,.04);let rim=torus(g,0xb27c50,0,.13,0,.37,.025);rim.rotation.x=Math.PI/2;for(let i=0;i<16;i++){let a=i*Math.PI/8;box(g,0xe5bd87,Math.cos(a)*.36,.07,Math.sin(a)*.36,.04,.16,.04);}return g;}\nexport function tray(parent,y=1.25){let g=group(parent,0,y,.3);box(g,0x83a6a4,0,0,0,.66,.045,.66);for(let s of [-1,1]){box(g,0xe9e4c8,s*.33,.035,0,.025,.08,.68);box(g,0xe9e4c8,0,.035,s*.33,.68,.08,.025);}return g;}\nexport function fruitMesh(parent,type='orange'){let g=group(parent);if(type==='boot'){box(g,0x5f5d6d,0,0,0,.15,.1,.24);box(g,0x5f5d6d,0,.1,-.06,.13,.14,.1);}else if(type==='urchin'){ball(g,0x665781,0,0,0,.09);for(let i=0;i<8;i++){let a=i*.785;let sp=mesh(new T.ConeGeometry(.025,.1,5),0x665781,g,Math.cos(a)*.11,0,Math.sin(a)*.11);sp.quaternion.setFromUnitVectors(new T.Vector3(0,1,0),new T.Vector3(Math.cos(a),0,Math.sin(a)));}}else{ball(g,type==='gold'?0xffd358:type==='apple'?0xe96b54:0xf2a54d,0,0,0,type==='gold'?.1:.075,1,type==='gold'?1.3:1,1);if(type==='gold'){for(let i=0;i<4;i++)mesh(new T.ConeGeometry(.025,.16,4),0x6e9b75,g,Math.sin(i)*.03,.16,Math.cos(i)*.03);}else{cyl(g,0x7e9260,0,.08,0,.013,.045);ball(g,0x7eaf77,.025,.09,0,.03,1,.15,.5);}}return g;}\nexport function stone(parent,r=.25,hh=.09){let m=ball(parent,0xa7afb1,0,0,0,1,r,hh,r*.9);return m;}\nexport function jar(parent,x=0,z=0,s=1){let g=group(parent,x,0,z);g.scale.setScalar(s);const pts=[[.01,0],[1,.02],[1.08,.12],[1.08,1.9],[.86,2.2],[.86,2.45],[.95,2.5]].map(([a,b])=>new T.Vector2(a,b));mesh(new T.LatheGeometry(pts,48),glass,g);for(let [r,y] of [[1.08,.12],[1.08,1.9],[.86,2.2],[.95,2.5]]){let t=torus(g,INK,0,y,0,r,.022);t.rotation.x=Math.PI/2;}box(g,new T.MeshBasicNodeMaterial({color:0xffffff,transparent:true,opacity:.55,depthWrite:false}),-.8,1.1,.65,.06,1.4,.02);cyl(g,0xd3a66b,0,-.12,0,1.3,.22);let l=label('A little more level','#534441',null,.33);l.position.set(0,.92,1.04);g.add(l);return g;}\nexport function pavilion(p,x,z,c=0x6faeaa,scale=1){let g=group(p,x,0,z);g.scale.setScalar(scale);for(let a of [-1,1])for(let b of [-1,1])cyl(g,0xd3ac76,a*1.1,1.25,b*1.1,.1,2.5);box(g,c,0,2.6,0,2.9,.22,2.9);let cap=mesh(new T.ConeGeometry(2.05,.55,4),c,g,0,2.94,0);cap.rotation.y=Math.PI/4;return g;}\nexport function lighthouse(p,x,z){let g=group(p,x,0,z);for(let i=0;i<6;i++)cyl(g,i%2?0xe6d9b7:0xd87966,0,.55+i*.9,0,1.1-i*.055,.9,1.05-i*.055);cyl(g,0x425c6c,0,5.75,0,1.1,.25);cyl(g,glass,0,6.3,0,.7,.9);ball(g,0xffdd87,0,6.3,0,.28);for(let a=0;a<6;a++)beam(g,0x425c6c,[Math.cos(a*1.047)*.7,5.87,Math.sin(a*1.047)*.7],[Math.cos(a*1.047)*.7,6.8,Math.sin(a*1.047)*.7],.04);mesh(new T.ConeGeometry(1.15,.7,12),0x4e7c89,g,0,7,0);cyl(g,0xb4a386,0,.08,0,1.6,.16);box(g,0x546d76,0,.65,1.01,.44,1.1,.08);return g;}\nexport function bunting(p,a,b,colour=0xe58c70){beam(p,0x51494b,a,b,.015);for(let i=1;i<11;i++){let t=i/11,x=a[0]+(b[0]-a[0])*t,y=a[1]+(b[1]-a[1])*t-.12,z=a[2]+(b[2]-a[2])*t;let m=mesh(new T.ConeGeometry(.15,.33,3),i%3===0?0xeabf69:i%3===1?colour:0x8fbaaa,p,x,y,z);m.rotation.z=Math.PI;}}\nEOF\ncat > src/events/base.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {makeWorld,R,PROP} from '../physics/world.js';\nimport {Balancer} from '../physics/balancer.js';\nimport {doll,heron,walrus,trudy} from '../art/cast.js';\nimport {group,box,cyl,ball,label,torus,mesh} from '../art/materials.js';\nimport {tree,sign,bunting} from '../art/props.js';\nimport {REGISTRY,SEATS,COLOURS,clamp,lerp} from '../data/config.js';\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > src/events/base.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {makeWorld,R} from '../physics/world.js';\nimport {Balancer} from '../physics/balancer.js';\nimport {doll,heron,walrus,trudy} from '../art/cast.js';\nimport {group,box,cyl,ball,label,torus,mesh} from '../art/materials.js';\nimport {tree,sign,bunting} from '../art/props.js';\nimport {REGISTRY} from '../data/events.js';\nimport {SEATS,clamp} from '../data/config.js';\nimport {rng} from '../core/rng.js';\nimport {blank} from '../input/input.js';\nexport class EventBase{\n constructor(game,id,tier=1,configs=[{}],options={}){this.game=game;this.id=id;this.meta=REGISTRY[id];this.tier=tier;this.options=options;this.duration=options.duration||this.meta.durations[tier-1];this.t=0;this.done=false;this.props=[];this.random=rng('event-'+id);this.group=group(game.view.scene);this.world=makeWorld();this.lanes=[];this.target={x:0,z:0,r:.3};this.banner='';this.message='';this.buildSet();configs.forEach((c,i)=>{const x=(i-(configs.length-1)/2)*3.2;let d=doll(c.colour||SEATS[i],c.hat||0);d.root.userData.colour=c.colour||SEATS[i];this.group.add(d.root);const lane={id:i,kind:c.kind||'local',device:c.device||'main',pad:c.pad??i,name:c.name||'Guest',colour:c.colour||SEATS[i],doll:d,x,z:0,y:0,props:[],score:0,form:0,target:{x:0,z:0,r:.3},data:{},input:blank(),history:[],...c};d.root.position.x=x;if(c.kind\"'!=='\"'ghost'){lane.balancer=new Balancer(this.world,i,d,this.group,game.settings,{x,...this.balanceOptions()});lane.balancer.onFall=()=>{this.onFall(lane);game.fx('CLACK\"'!'\"',lane.x,1,lane.z);game.audio?.sfx('clack');if(game.settings.rumble)game.input.rumble(lane.pad,.65,180);game.bark('fall');};lane.balancer.onFlail=()=>{this.onFlail(lane);game.audio?.sfx('spring');};}this.lanes.push(lane);this.buildLane(lane);});const spread=(configs.length-1)*3.2,d=Math.max(9.3,(spread/2+2.8)/Math.tan(38*Math.PI/360));game.view.setCamera([0,4.4,d],[0,1,0],true);}\n balanceOptions(){return {};}\n buildSet(){const p=this.group;let c=this.meta.discipline==='Stillness'?0xb7c8b2:this.meta.discipline==='Strength'?0xe9bc8e:this.id==='step'?0xb78c9f:0xe3bd8d;cyl(p,c,0,-.16,0,6.5,.3);for(let i=-10;i<=10;i++)box(p,0xad835e,i*.55,-.004,0,.018,.013,11.5);for(let x of [-5.7,5.7]){cyl(p,0xc79f73,x,-1.2,-3,.14,3);cyl(p,0xc79f73,x,-1.2,3,.14,3);}for(let i=0;i<8;i++){let x=-5.5+i*1.55;cyl(p,0xd1b584,x,.52,-4.8,.055,1.1);}bunting(p,[-6,3.7,-4.8],[6,3.7,-4.8]);sign(p,'LEVEL BEST RETREAT',0,0,-5.3,4);tree(p,-8,-7,1.6);tree(p,8,-8,1.7);tree(p,11,-10,1.3);cyl(p,0xc9d1ad,-11,-2,-14,6,2);cyl(p,0xc9d1ad,13,-2,-22,8,2);this.instructor=this.meta.instructor==='Ms. Stillwater'?heron():this.meta.instructor==='Coach Bolster'?walrus():trudy();this.instructor.position.set(-3.8,0,.4);p.add(this.instructor);}\n buildLane(lane){let ring=torus(this.group,lane.colour,lane.x,.012,0,.7,.025);ring.rotation.x=Math.PI/2;}\n start(){this.started=true;}\n addProp(body,visual,lane=null,extra={}){this.group.add(visual);let p={body,visual,lane,active:true,...extra};this.props.push(p);if(lane)lane.props.push(p);return p;}\n disable(p,hide=true){if(\"'!p?.active)return;p.active=false;p.body.setEnabled(false);p.visual.visible=!hide;}\n tickLane(lane,dt){}\n afterStep(dt){}\n fixed(dt,inputs=[]){if(this.done)return;this.t+=dt;for(const lane of this.lanes){if(lane.kind==='\"'ghost')continue;lane.input=lane.kind==='bot'?this.botInput(lane,this.t,lane.skill||'average'):(inputs[lane.id]||blank());this.tickLane(lane,dt);const b=lane.balancer;b.god=this.game.dev.god||this.options.god;b.fixed(dt,lane.input,lane.dist||{sway:.1});lane.history.push({t:this.t,x:b.cob.x,z:b.cob.z});while(lane.history.length>100)lane.history.shift();}this.world.step();this.afterStep(dt);if(this.t>=this.duration)this.finish();}\n frame(dt){for(const lane of this.lanes){if(lane.kind==='ghost'){lane.doll.anim.update(dt);continue;}lane.balancer.frame(dt);}for(const p of this.props)if(p.active){p.visual.position.copy(p.body.translation());p.visual.quaternion.copy(p.body.rotation());}this.instructor.rotation.z=Math.sin(this.t*1.6)*.018;}\n onFall(lane){lane.data.hold=0;}\n onFlail(lane){}\n finish(){if(this.done)return;this.done=true;for(const l of this.lanes)if(l.kind\"'!=='\"'ghost')l.form=clamp(this.computeForm(l)*this.game.tuning.medalScale,0,100);}\n computeForm(l){return l.form||clamp(l.score,0,100);}\n laneResult(i){const l=this.lanes[i];return {name:l.name,score:Math.round(l.score*10)/10,form:Math.round(l.form),falls:l.balancer?.falls||0,detail:this.resultDetail?.(l)||\"'`${l.balancer?.falls||0} floor exercises`};}\n botGoal(lane){return lane.target||this.target;}\n botInput(lane,t,skill='\"'sharp'){const s={sharp:{delay:.16,gain:1.4,noise:0,lag:.028},average:{delay:.26,gain:1,noise:.03,lag:.055},clumsy:{delay:.38,gain:.8,noise:.07,lag:.095}}[skill]||{delay:.16,gain:1.4,noise:0,lag:.028};const goal=this.botGoal(lane),loaded=['fruit','cairn','log','service','grand','check'].includes(this.id);let old=lane.history.findLast(h=>h.t<=t-s.delay)||{x:0,z:0};let gain=loaded?s.gain*.5:s.gain;let result={...blank(),x:clamp((goal.x||0)+gain*((goal.x||0)-old.x)+s.noise*Math.sin(t*2.7),-1,1),z:clamp((goal.z||0)+gain*((goal.z||0)-old.z)+s.noise*Math.cos(t*2.1),-1,1),breathe:t%8<4};this.botActions?.(lane,result,t,s,skill);return result;}\n dispose(){if(this.disposed)return;this.disposed=true;this.game.view.scene.remove(this.group);this.world.free();this.props.length=0;this.lanes.length=0;this.group.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.material?.isSpriteMaterial){o.material.map?.dispose();o.material.dispose();}});}\n state(){return {id:this.id,tier:this.tier,t:this.t,phase:this.done?'done':'play',duration:this.duration,score:this.lanes[0]?.score||0,lanes:this.lanes.map(l=>({kind:l.kind,leanX:l.balancer?.leanX||0,leanZ:l.balancer?.leanZ||0,cob:{...l.balancer?.cob},fallen:l.balancer?.fallen||0,falls:l.balancer?.falls||0,form:l.form,score:l.score,props:l.props.filter(p=>p.active).length,data:JSON.parse(JSON.stringify(l.data))}))};}\n}\nEOF\ncat > src/events/fruit.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {EventBase} from './base.js';\nimport {R,PROP,rigid} from '../physics/world.js';\nimport {basket,crate,fruitMesh} from '../art/props.js';\nimport {box,ball,cyl,torus,group} from '../art/materials.js';\nimport {clamp} from '../data/config.js';\nimport {tuning} from '../data/tuning.js';\nexport class FruitHat extends EventBase{\n balanceOptions(){return this.tier===1?{}:{margin:.6,ankleMax:5};}\n buildSet(){super.buildSet();let barge=group(this.group,0,-.5,-10);box(barge,0x659393,0,0,0,3.5,.7,2);box(barge,0xe4bc75,0,.5,0,2.2,.6,1.2);let cannon=cyl(barge,0x776670,0,1,-.2,.22,1);cannon.rotation.x=-.6;for(let x of [-1.3,1.3])cyl(barge,0xe9dfc0,x,.6,.1,.05,2.4);}\n buildLane(l){super.buildLane(l);basket(l.doll.root);crate(this.group,l.x,1.5);if(l.balancer){let b=l.balancer.body;this.world.createCollider(R.ColliderDesc.cylinder(.02,.36).setTranslation(0,.81,0).setMass(.01).setFriction(.9).setCollisionGroups(PROP(l.id)),b);for(let i=0;i<8;i++){let a=i*Math.PI/4;this.world.createCollider(R.ColliderDesc.cuboid(.02,.1,.16).setTranslation(Math.cos(a)*.36,.91,Math.sin(a)*.36).setRotation({x:0,y:Math.sin(-a/2),z:0,w:Math.cos(-a/2)}).setMass(.001).setFriction(.9).setCollisionGroups(PROP(l.id)),b);}}l.data={caught:0,banked:0,banks:0,next:1,banking:0,spilled:0};l.fruit=[];}\n spawnFruit(l,forcedType=null){const radius=tuning.landingRadius+(this.tier-1)*.1,a=this.random()*Math.PI*2,r=radius*Math.sqrt(this.random()),x=l.x+Math.cos(a)*r,z=Math.sin(a)*r,type=forcedType||(this.random()<.08?'urchin':this.random()<.07?'gold':this.random()<.07?'boot':this.random()<.4?'apple':'orange'),flight=1.5;let start={x:l.x,y:2.1,z:-7},mass=type==='boot'?.05:type==='gold'?.04:tuning.fruitMass*(this.tier>1?.8:1);let b=rigid(this.world,R.ColliderDesc.ball(type==='gold'?.1:.075),[start.x,start.y,start.z],mass,l.id);b.setLinvel({x:(x-start.x)/flight,y:(1.75-start.y+.5*tuning.gravity*flight*flight)/flight,z:(z-start.z)/flight},true);let shadow=torus(this.group,type==='urchin'?0x88658c:0xe9b76a,x,.025,z,.14,.012);shadow.rotation.x=Math.PI/2;let p=this.addProp(b,fruitMesh(null,type),l,{type,tx:x,tz:z,landing:this.t+flight,shadow,caught:false,spent:false,value:type==='gold'?5:1});l.fruit.push(p);return p;}\n tickLane(l,dt){const d=l.data,b=l.balancer;l.target={x:0,z:0,r:.28};l.dist={sway:.045,tremor:.03};d.banking=Math.max(0,d.banking-dt);if(this.t>=d.next){this.spawnFruit(l);d.next=this.t+(tuning.fruitInterval-(this.tier-1)*.3);}if(l.input.hopPress&&d.banking<=0&&d.caught>0)this.bank(l);if(d.banking>0)l.input={...l.input,x:l.input.x*.3,z:l.input.z*.3};let next=l.fruit.filter(p=>p.active&&\"'!p.caught&&p.landing-this.t<.95&&p.landing>this.t-.15).sort((a,b)=>a.landing-b.landing)[0];if(next){l.target.x=clamp((next.tx-l.x)/.51,-1,1);l.target.z=clamp(next.tz/.51,-1,1);}this.message=d.banking>0?'\"'BANKED\"'! A sensible decision.'\"':d.caught>=7?'Getting ambitious? Hop to bank.':'Catch with your hat. Hop to bank.';}\n afterStep(dt){for(const l of this.lanes){if(\"'!l.fruit)continue;for(const p of l.fruit){if(!p.active)continue;const pos=p.body.translation(),hat=new T.Vector3(0,.9,0).applyQuaternion(l.balancer.body.rotation()).add(new T.Vector3().copy(l.balancer.body.translation()));if(this.t>p.landing-.1)p.shadow.visible=false;if(!p.caught&&this.t>p.landing-.15&&this.t<p.landing+.5&&Math.hypot(pos.x-hat.x,pos.z-hat.z)<.36&&pos.y>hat.y-.12&&pos.y<hat.y+.6){p.caught=true;l.data.caught++;this.game.audio.sfx(p.type==='\"'urchin'?'spike':'fruit');if(p.type==='urchin'){l.score=Math.max(0,l.score-2);l.balancer.body.applyTorqueImpulse({x:.1,y:0,z:.15},true);this.disable(p);l.data.caught--;}}\n if(p.caught&&\"'!p.spent&&(pos.y<1||Math.hypot(pos.x-l.x,pos.z)>1.4)){p.spent=true;l.data.caught=Math.max(0,l.data.caught-1);l.data.spilled++;}\n if(pos.y<-.1||this.t>p.landing+10&&!p.caught)this.disable(p);\n }}}\n bank(l){let held=l.fruit.filter(p=>p.active&&p.caught&&!p.spent);let value=held.reduce((s,p)=>s+p.value,0)*(1+.1*Math.max(0,held.length-1));l.score+=value;l.data.banked+=held.length;l.data.banks++;l.data.caught=0;l.data.banking=1;for(const p of held){p.spent=true;this.disable(p);p.shadow.visible=false;}this.game.fx('\"'+'+Math.round(value),l.x,2,0);this.game.audio.sfx('bank');}\n onFall(l){super.onFall(l);l.data.spilled+=l.data.caught;l.data.caught=0;for(const p of l.fruit||[])if(p.active&&p.caught){p.spent=true;p.caught=false;p.body.applyImpulse({x:(this.random()-.5)*.04,y:.04,z:.02},true);}}\n onFlail(l){const top=l.fruit?.findLast(p=>p.active&&p.caught&&\"'!p.spent);if(top){this.disable(top);top.spent=true;l.data.caught=Math.max(0,l.data.caught-1);}}\n botGoal(l){return l.target;}\n botActions(l,input,t,s,skill){const bank=this.game.dev.neverBank?Infinity:skill==='\"'clumsy'?5:7;input.hopPress=l.data.caught>=bank&&l.data.banking<=0;input.hop=input.hopPress;}\n computeForm(l){let held=l.fruit.filter(p=>p.active&&p.caught&&\"'!p.spent).reduce((s,p)=>s+p.value,0);l.score+=held*.5;return clamp(l.score/([52,65,78][this.tier-1])*100,0,100);}\n resultDetail(l){return `${l.data.banked} fruit banked · ${l.data.banks} banks · ${l.balancer.falls} floor exercises`;}\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > src/events/base.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {makeWorld,R} from '../physics/world.js';\nimport {Balancer} from '../physics/balancer.js';\nimport {doll,heron,walrus,trudy} from '../art/cast.js';\nimport {group,box,cyl,ball,label,torus,mesh} from '../art/materials.js';\nimport {tree,sign,bunting} from '../art/props.js';\nimport {REGISTRY} from '../data/events.js';\nimport {SEATS,clamp} from '../data/config.js';\nimport {rng} from '../core/rng.js';\nimport {blank} from '../input/input.js';\nexport class EventBase{\n constructor(game,id,tier=1,configs=[{}],options={}){this.game=game;this.id=id;this.meta=REGISTRY[id];this.tier=tier;this.options=options;this.duration=options.duration||this.meta.durations[tier-1];this.t=0;this.done=false;this.props=[];this.random=rng('event-'+id);this.group=group(game.view.scene);this.world=makeWorld();this.lanes=[];this.target={x:0,z:0,r:.3};this.banner='';this.message='';this.buildSet();configs.forEach((c,i)=>{const x=(i-(configs.length-1)/2)*3.2;let d=doll(c.colour||SEATS[i],c.hat||0);d.root.userData.colour=c.colour||SEATS[i];this.group.add(d.root);const lane={id:i,kind:c.kind||'local',device:c.device||'main',pad:c.pad??i,name:c.name||'Guest',colour:c.colour||SEATS[i],doll:d,x,z:0,y:0,props:[],score:0,form:0,target:{x:0,z:0,r:.3},data:{},input:blank(),history:[],...c};d.root.position.x=x;if(c.kind\"'!=='\"'ghost'){lane.balancer=new Balancer(this.world,i,d,this.group,game.settings,{x,...this.balanceOptions()});lane.balancer.onFall=()=>{this.onFall(lane);game.fx('CLACK\"'!'\"',lane.x,1,lane.z);game.audio?.sfx('clack');if(game.settings.rumble)game.input.rumble(lane.pad,.65,180);game.bark('fall');};lane.balancer.onFlail=()=>{this.onFlail(lane);game.audio?.sfx('spring');};}this.lanes.push(lane);this.buildLane(lane);});const spread=(configs.length-1)*3.2,d=Math.max(9.3,(spread/2+2.8)/Math.tan(38*Math.PI/360));game.view.setCamera([0,4.4,d],[0,1,0],true);}\n balanceOptions(){return {};}\n buildSet(){const p=this.group;let c=this.meta.discipline==='Stillness'?0xb7c8b2:this.meta.discipline==='Strength'?0xe9bc8e:this.id==='step'?0xb78c9f:0xe3bd8d;cyl(p,c,0,-.16,0,6.5,.3);for(let i=-10;i<=10;i++)box(p,0xad835e,i*.55,-.004,0,.018,.013,11.5);for(let x of [-5.7,5.7]){cyl(p,0xc79f73,x,-1.2,-3,.14,3);cyl(p,0xc79f73,x,-1.2,3,.14,3);}for(let i=0;i<8;i++){let x=-5.5+i*1.55;cyl(p,0xd1b584,x,.52,-4.8,.055,1.1);}bunting(p,[-6,3.7,-4.8],[6,3.7,-4.8]);sign(p,'LEVEL BEST RETREAT',0,0,-5.3,4);tree(p,-8,-7,1.6);tree(p,8,-8,1.7);tree(p,11,-10,1.3);cyl(p,0xc9d1ad,-11,-2,-14,6,2);cyl(p,0xc9d1ad,13,-2,-22,8,2);this.instructor=this.meta.instructor==='Ms. Stillwater'?heron():this.meta.instructor==='Coach Bolster'?walrus():trudy();this.instructor.position.set(-3.8,0,.4);p.add(this.instructor);}\n buildLane(lane){let ring=torus(this.group,lane.colour,lane.x,.012,0,.7,.025);ring.rotation.x=Math.PI/2;}\n start(){this.started=true;}\n addProp(body,visual,lane=null,extra={}){this.group.add(visual);let p={body,visual,lane,active:true,...extra};this.props.push(p);if(lane)lane.props.push(p);return p;}\n disable(p,hide=true){if(\"'!p?.active)return;p.active=false;p.body.setEnabled(false);p.visual.visible=!hide;}\n tickLane(lane,dt){}\n afterStep(dt){}\n fixed(dt,inputs=[]){if(this.done)return;this.t+=dt;for(const lane of this.lanes){if(lane.kind==='\"'ghost')continue;lane.input=lane.kind==='bot'?this.botInput(lane,this.t,lane.skill||'average'):(inputs[lane.id]||blank());this.tickLane(lane,dt);const b=lane.balancer;b.god=this.game.dev.god||this.options.god;b.fixed(dt,lane.input,lane.dist||{sway:.1});lane.history.push({t:this.t,x:b.cob.x,z:b.cob.z});while(lane.history.length>100)lane.history.shift();}this.world.step();this.afterStep(dt);if(this.t>=this.duration)this.finish();}\n frame(dt){for(const lane of this.lanes){if(lane.kind==='ghost'){lane.doll.anim.update(dt);continue;}lane.balancer.frame(dt);}for(const p of this.props)if(p.active){p.visual.position.copy(p.body.translation());p.visual.quaternion.copy(p.body.rotation());}this.instructor.rotation.z=Math.sin(this.t*1.6)*.018;}\n onFall(lane){lane.data.hold=0;}\n onFlail(lane){}\n finish(){if(this.done)return;this.done=true;for(const l of this.lanes)if(l.kind\"'!=='\"'ghost')l.form=clamp(this.computeForm(l)*this.game.tuning.medalScale,0,100);}\n computeForm(l){return l.form||clamp(l.score,0,100);}\n laneResult(i){const l=this.lanes[i];return {name:l.name,score:Math.round(l.score*10)/10,form:Math.round(l.form),falls:l.balancer?.falls||0,detail:this.resultDetail?.(l)||\"'`${l.balancer?.falls||0} floor exercises`};}\n botGoal(lane){return lane.target||this.target;}\n botInput(lane,t,skill='\"'sharp'){const s={sharp:{delay:.16,gain:1.4,noise:0,lag:.028},average:{delay:.26,gain:1,noise:.03,lag:.055},clumsy:{delay:.38,gain:.8,noise:.07,lag:.095}}[skill]||{delay:.16,gain:1.4,noise:0,lag:.028};const goal=this.botGoal(lane),loaded=['fruit','cairn','log','service','grand','check'].includes(this.id);let old=lane.history.findLast(h=>h.t<=t-s.delay)||{x:0,z:0};let gain=loaded?s.gain*.5:s.gain;let result={...blank(),x:clamp((goal.x||0)+gain*((goal.x||0)-old.x)+s.noise*Math.sin(t*2.7),-1,1),z:clamp((goal.z||0)+gain*((goal.z||0)-old.z)+s.noise*Math.cos(t*2.1),-1,1),breathe:t%8<4};this.botActions?.(lane,result,t,s,skill);return result;}\n dispose(){if(this.disposed)return;this.disposed=true;this.game.view.scene.remove(this.group);this.world.free();this.props.length=0;this.lanes.length=0;this.group.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.material?.isSpriteMaterial){o.material.map?.dispose();o.material.dispose();}});}\n state(){return {id:this.id,tier:this.tier,t:this.t,phase:this.done?'done':'play',duration:this.duration,score:this.lanes[0]?.score||0,lanes:this.lanes.map(l=>({kind:l.kind,leanX:l.balancer?.leanX||0,leanZ:l.balancer?.leanZ||0,cob:{...l.balancer?.cob},fallen:l.balancer?.fallen||0,falls:l.balancer?.falls||0,form:l.form,score:l.score,props:l.props.filter(p=>p.active).length,data:JSON.parse(JSON.stringify(l.data))}))};}\n}\nEOF\ncat > src/events/fruit.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {EventBase} from './base.js';\nimport {R,PROP,rigid} from '../physics/world.js';\nimport {basket,crate,fruitMesh} from '../art/props.js';\nimport {box,ball,cyl,torus,group} from '../art/materials.js';\nimport {clamp} from '../data/config.js';\nimport {tuning} from '../data/tuning.js';\nexport class FruitHat extends EventBase{\n balanceOptions(){return this.tier===1?{}:{margin:.6,ankleMax:5};}\n buildSet(){super.buildSet();let barge=group(this.group,0,-.5,-10);box(barge,0x659393,0,0,0,3.5,.7,2);box(barge,0xe4bc75,0,.5,0,2.2,.6,1.2);let cannon=cyl(barge,0x776670,0,1,-.2,.22,1);cannon.rotation.x=-.6;for(let x of [-1.3,1.3])cyl(barge,0xe9dfc0,x,.6,.1,.05,2.4);}\n buildLane(l){super.buildLane(l);basket(l.doll.root);crate(this.group,l.x,1.5);if(l.balancer){let b=l.balancer.body;this.world.createCollider(R.ColliderDesc.cylinder(.02,.36).setTranslation(0,.81,0).setMass(.01).setFriction(.9).setCollisionGroups(PROP(l.id)),b);for(let i=0;i<8;i++){let a=i*Math.PI/4;this.world.createCollider(R.ColliderDesc.cuboid(.02,.1,.16).setTranslation(Math.cos(a)*.36,.91,Math.sin(a)*.36).setRotation({x:0,y:Math.sin(-a/2),z:0,w:Math.cos(-a/2)}).setMass(.001).setFriction(.9).setCollisionGroups(PROP(l.id)),b);}}l.data={caught:0,banked:0,banks:0,next:1,banking:0,spilled:0};l.fruit=[];}\n spawnFruit(l,forcedType=null){const radius=tuning.landingRadius+(this.tier-1)*.1,a=this.random()*Math.PI*2,r=radius*Math.sqrt(this.random()),x=l.x+Math.cos(a)*r,z=Math.sin(a)*r,type=forcedType||(this.random()<.08?'urchin':this.random()<.07?'gold':this.random()<.07?'boot':this.random()<.4?'apple':'orange'),flight=1.5;let start={x:l.x,y:2.1,z:-7},mass=type==='boot'?.05:type==='gold'?.04:tuning.fruitMass*(this.tier>1?.8:1);let b=rigid(this.world,R.ColliderDesc.ball(type==='gold'?.1:.075),[start.x,start.y,start.z],mass,l.id);b.setLinvel({x:(x-start.x)/flight,y:(1.75-start.y+.5*tuning.gravity*flight*flight)/flight,z:(z-start.z)/flight},true);let shadow=torus(this.group,type==='urchin'?0x88658c:0xe9b76a,x,.025,z,.14,.012);shadow.rotation.x=Math.PI/2;let p=this.addProp(b,fruitMesh(null,type),l,{type,tx:x,tz:z,landing:this.t+flight,shadow,caught:false,spent:false,value:type==='gold'?5:1});l.fruit.push(p);return p;}\n tickLane(l,dt){const d=l.data,b=l.balancer;l.target={x:0,z:0,r:.28};l.dist={sway:.045,tremor:.03};d.banking=Math.max(0,d.banking-dt);if(this.t>=d.next){this.spawnFruit(l);d.next=this.t+(tuning.fruitInterval-(this.tier-1)*.3);}if(l.input.hopPress&&d.banking<=0&&d.caught>0)this.bank(l);if(d.banking>0)l.input={...l.input,x:l.input.x*.3,z:l.input.z*.3};let next=l.fruit.filter(p=>p.active&&\"'!p.caught&&p.landing-this.t<.95&&p.landing>this.t-.15).sort((a,b)=>a.landing-b.landing)[0];if(next){l.target.x=clamp((next.tx-l.x)/.51,-1,1);l.target.z=clamp(next.tz/.51,-1,1);}this.message=d.banking>0?'\"'BANKED\"'! A sensible decision.'\"':d.caught>=7?'Getting ambitious? Hop to bank.':'Catch with your hat. Hop to bank.';}\n afterStep(dt){for(const l of this.lanes){if(\"'!l.fruit)continue;for(const p of l.fruit){if(!p.active)continue;const pos=p.body.translation(),hat=new T.Vector3(0,.9,0).applyQuaternion(l.balancer.body.rotation()).add(new T.Vector3().copy(l.balancer.body.translation()));if(this.t>p.landing-.1)p.shadow.visible=false;if(!p.caught&&this.t>p.landing-.15&&this.t<p.landing+.5&&Math.hypot(pos.x-hat.x,pos.z-hat.z)<.36&&pos.y>hat.y-.12&&pos.y<hat.y+.6){p.caught=true;l.data.caught++;this.game.audio.sfx(p.type==='\"'urchin'?'spike':'fruit');if(p.type==='urchin'){l.score=Math.max(0,l.score-2);l.balancer.body.applyTorqueImpulse({x:.1,y:0,z:.15},true);this.disable(p);l.data.caught--;}}\n if(p.caught&&\"'!p.spent&&(pos.y<1||Math.hypot(pos.x-l.x,pos.z)>1.4)){p.spent=true;l.data.caught=Math.max(0,l.data.caught-1);l.data.spilled++;}\n if(pos.y<-.1||this.t>p.landing+10&&!p.caught)this.disable(p);\n }}}\n bank(l){let held=l.fruit.filter(p=>p.active&&p.caught&&!p.spent);let value=held.reduce((s,p)=>s+p.value,0)*(1+.1*Math.max(0,held.length-1));l.score+=value;l.data.banked+=held.length;l.data.banks++;l.data.caught=0;l.data.banking=1;for(const p of held){p.spent=true;this.disable(p);p.shadow.visible=false;}this.game.fx('\"'+'+Math.round(value),l.x,2,0);this.game.audio.sfx('bank');}\n onFall(l){super.onFall(l);l.data.spilled+=l.data.caught;l.data.caught=0;for(const p of l.fruit||[])if(p.active&&p.caught){p.spent=true;p.caught=false;p.body.applyImpulse({x:(this.random()-.5)*.04,y:.04,z:.02},true);}}\n onFlail(l){const top=l.fruit?.findLast(p=>p.active&&p.caught&&\"'!p.spent);if(top){this.disable(top);top.spent=true;l.data.caught=Math.max(0,l.data.caught-1);}}\n botGoal(l){return l.target;}\n botActions(l,input,t,s,skill){const bank=this.game.dev.neverBank?Infinity:skill==='\"'clumsy'?5:7;input.hopPress=l.data.caught>=bank&&l.data.banking<=0;input.hop=input.hopPress;}\n computeForm(l){let held=l.fruit.filter(p=>p.active&&p.caught&&\"'!p.spent).reduce((s,p)=>s+p.value,0);l.score+=held*.5;return clamp(l.score/([52,65,78][this.tier-1])*100,0,100);}\n resultDetail(l){return `${l.data.banked} fruit banked · ${l.data.banks} banks · ${l.balancer.falls} floor exercises`;}\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"cat > src/audio/engine.js <<'EOF'\nimport {cosmetic} from '../core/rng.js';\nexport const TRACKS={title:{bpm:92,root:61,chords:[[0,4,7,11,14],[-3,0,4,7,11],[2,5,9,12,16],[7,11,14,17,21]]},island:{bpm:84,root:53,chords:[[0,4,7,11],[4,7,11,14],[5,9,12,16],[7,11,14,17]]},still:{bpm:60,root:50,chords:[[0,4,7,11,14],[2,6,9,13,16]]},strength:{bpm:100,root:40,chords:[[0,3,7,10,14],[5,9,12,16,19]]},cardio:{bpm:116,root:49,chords:[[0,4,7,11],[-1,2,6,9],[-3,0,4,7],[2,7,9,12]]},balance:{bpm:118,root:48,chords:[[0,4,7,9],[-3,0,4,7],[2,5,9,12],[7,11,14,17]]},level:{bpm:82,root:61,chords:[[0,4,7,11,14],[-3,0,4,7,11],[2,5,9,12,16],[7,11,14,17,21]]}};\nexport const MOTIF=[[[0,77,3],[3,75,1],[4,73,2],[6,68,4],[12,70,2],[14,72,2]],[[0,73,3],[3,72,1],[4,70,2],[6,65,6],[14,68,2]],[[0,70,3],[3,68,1],[4,66,2],[6,63,4],[12,65,2],[14,66,2]],[[0,68,3],[3,70,1],[4,72,2],[6,75,6]]];\nconst hz=m=>440*2**((m-69)/12);\nexport function tone(ctx,dest,midi,start,duration=.3,volume=.2,type='sine',detune=0){const o=ctx.createOscillator(),g=ctx.createGain();o.type=type;o.frequency.setValueAtTime(hz(midi),start);o.detune.value=detune;g.gain.setValueAtTime(0,start);g.gain.linearRampToValueAtTime(volume,start+.008);g.gain.exponentialRampToValueAtTime(.0001,start+Math.max(.02,duration));o.connect(g).connect(dest);o.start(start);o.stop(start+duration+.02);return o;}\nexport function epiano(ctx,dest,midi,start,duration=.6,volume=.15,detune=0){const carrier=ctx.createOscillator(),mod=ctx.createOscillator(),mg=ctx.createGain(),env=ctx.createGain();let f=hz(midi);carrier.frequency.value=f;carrier.detune.value=detune;mod.frequency.value=f*14;mg.gain.setValueAtTime(f*.3,start);mg.gain.exponentialRampToValueAtTime(.01,start+.17);mod.connect(mg).connect(carrier.frequency);env.gain.setValueAtTime(0,start);env.gain.linearRampToValueAtTime(volume,start+.005);env.gain.exponentialRampToValueAtTime(.0001,start+duration);carrier.connect(env).connect(dest);carrier.start(start);mod.start(start);carrier.stop(start+duration+.02);mod.stop(start+duration+.02);}\nexport function noise(ctx,dest,start,duration=.12,volume=.1,freq=1800){const len=Math.max(1,Math.floor(ctx.sampleRate*duration)),buf=ctx.createBuffer(1,len,ctx.sampleRate),data=buf.getChannelData(0);for(let i=0;i<len;i++)data[i]=(cosmetic()*2-1)*Math.exp(-i/len*5);let src=ctx.createBufferSource(),filter=ctx.createBiquadFilter(),g=ctx.createGain();src.buffer=buf;filter.type='bandpass';filter.frequency.value=freq;filter.Q.value=.8;g.gain.value=volume;src.connect(filter).connect(g).connect(dest);src.start(start);}\nexport function synthSfx(ctx,dest,name,start=ctx.currentTime){if(['splash','crash','wind','clack','stamp','sneeze'].includes(name)){noise(ctx,dest,start,name==='wind'?.8:.28,.3,name==='splash'?550:name==='clack'?1200:2200);if(name==='clack')for(let i=0;i<3;i++)tone(ctx,dest,48+i*7,start+i*.025,.07,.2,'triangle');}\n else if(name==='spring'){for(let i=0;i<8;i++)tone(ctx,dest,50+i*3,start+i*.025,.1,.12);}\n else if(name==='bank'||name==='unlock'||name==='bell'){[72,76,79,84].forEach((n,i)=>epiano(ctx,dest,n,start+i*.07,.5,.16));}\n else if(name==='whistle')tone(ctx,dest,96,start,.26,.11);\n else if(name==='spike'){tone(ctx,dest,42,start,.2,.2,'sawtooth');}\n else if(name==='creak'){tone(ctx,dest,37,start,.8,.06,'sawtooth');noise(ctx,dest,start,.7,.1,400);}\n else {tone(ctx,dest,name==='foot'?81:name==='move'?73:name==='fruit'?69:76,start,.055,name==='foot'?.34:.14,'triangle');}}\nexport function voiceLine(ctx,dest,text,speaker='Trudy',start=ctx.currentTime){const pitch=speaker==='Ms. Stillwater'?170:speaker==='Coach Bolster'?95:420,rate=speaker==='Ms. Stillwater'?7:speaker==='Coach Bolster'?11:16,letters=text.toLowerCase().replace(/[\"'^a-z?! .]/g,'\"'').slice(0,140);let at=start,blips=0;for(let i=0;i<letters.length;i+=2){const ch=letters[i];if(\"'!/[a-z]/.test(ch)){at+=.03;continue;}let o=ctx.createOscillator(),f1=ctx.createBiquadFilter(),f2=ctx.createBiquadFilter(),g=ctx.createGain();o.type=speaker==='\"'Coach Bolster'?'sawtooth':'square';o.frequency.value=pitch*(1+(cosmetic()-.5)*.14)*(text.includes('?')?1+i/letters.length*.18:1);f1.type=f2.type='bandpass';f1.frequency.value=({a:800,e:450,i:300,o:500,u:350})[ch]||650;f2.frequency.value=({a:1250,e:1900,i:2300,o:900,u:800})[ch]||1700;f1.Q.value=1.2;f2.Q.value=.8;g.gain.setValueAtTime(0,at);g.gain.linearRampToValueAtTime(speaker==='Trudy'?.13:.24,at+.008);g.gain.exponentialRampToValueAtTime(.0001,at+.065);o.connect(f1).connect(f2).connect(g).connect(dest);o.start(at);o.stop(at+.08);at+=1/rate;blips++;}return {duration:at-start,blips};}\nexport class AudioEngine{\n constructor(settings){this.settings=settings;this.track='title';this.stopped=false;this.tilt=9;this.steps=0;this.next=0;this.voiceUntil=0;}\n unlock(){try{if(\"'!this.ctx){const C=globalThis.AudioContext||globalThis.webkitAudioContext;if(!C)return;this.setup(new C());}this.ctx.resume().catch(()=>{});}catch{}}\n setup(ctx){this.ctx=ctx;this.master=ctx.createDynamicsCompressor();this.master.threshold.value=-12;this.master.ratio.value=3;this.master.connect(ctx.destination);this.buses={};this.analysers={};for(let name of ['\"'music','sfx','voice']){let bus=ctx.createGain(),a=ctx.createAnalyser();a.fftSize=256;bus.connect(a).connect(this.master);this.buses[name]=bus;this.analysers[name]=a;}this.updateMix();this.next=ctx.currentTime+.05;}\n updateMix(){if(this.buses)for(let k of ['music','sfx','voice'])this.buses[k].gain.value=this.stopped?0:this.settings[k]/100;}\n setTrack(name){if(this.track===name)return;this.track=name;this.steps=0;this.next=(this.ctx?.currentTime||0)+.05;}\n detune(t=0){return this.tilt*1.6*Math.sin(t*.7);}\n update(){if(\"'!this.ctx||this.ctx.state!=='\"'running'||this.stopped)return;const ctx=this.ctx,tr=TRACKS[this.track]||TRACKS.title,beat=60/tr.bpm/4;let count=0;if(this.next<ctx.currentTime-.3)this.next=ctx.currentTime+.02;while(this.next<ctx.currentTime+.15&&count++<20){let n=this.steps%16,bar=Math.floor(this.steps/16),ch=tr.chords[bar%tr.chords.length],dt=this.detune(this.next),dest=this.buses.music;if(n===0){for(const c of ch)epiano(ctx,dest,tr.root+c,this.next,beat*10,.09,dt);}if(n%4===0){tone(ctx,dest,tr.root-12+ch[0]+(n===8?12:0),this.next,.22,.22,'triangle',dt);noise(ctx,dest,this.next,.035,.09,6000);}\n if(this.track==='title'||this.track==='level'){for(let [step,midi,len] of MOTIF[bar%4])if(step===n)epiano(ctx,dest,midi,this.next,beat*len*.9,.19,dt);}else if(n%2===0)tone(ctx,dest,tr.root+12+ch[(n/2+bar)%ch.length],this.next,beat*1.5,.065,'sine',dt);\n if(n===4||n===12)noise(ctx,dest,this.next,.09,.08,2400);if(this.track==='cardio'&&n%4===0)tone(ctx,dest,38,this.next,.09,.3);this.next+=beat;this.steps++;}}\n sfx(name){if(this.ctx?.state==='running'&&\"'!this.stopped)synthSfx(this.ctx,this.buses.sfx,name);}\n say(text,speaker){if(this.ctx?.state!=='\"'running'||this.stopped)return;const now=this.ctx.currentTime;if(now<this.voiceUntil)return;const v=voiceLine(this.ctx,this.buses.voice,text,speaker);this.voiceUntil=now+v.duration;}\n sting(medal){if(\"'!this.ctx||this.stopped)return;let notes=medal==='\"'Suspicious'?[72,76,79,84,88]:medal==='Exemplary'?[65,69,72,77]:[60,64,67];notes.forEach((n,i)=>epiano(this.ctx,this.buses.sfx,n,this.ctx.currentTime+i*.13,.8,.17));}\n stop(){this.stopped=true;this.updateMix();}\n}\nEOF\ncat > src/ui/ui.css <<'EOF'\n:root{--ink:#302c37;--paper:#fff4dc;--teal:#487c7b;--coral:#e67960;--unit:1vh;font-family:Fredoka,system-ui,sans-serif;color:var(--ink);font-weight:500;background:#ecdbc5}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden}button,input,select{font:inherit;color:inherit}button{cursor:pointer;touch-action:manipulation}#world{position:fixed;inset:0;width:100%;height:100%;display:block}#ui{position:fixed;inset:0;pointer-events:none;font-size:clamp(17px,2.95vh,36px);line-height:1.25}#ui>*{pointer-events:auto}button{border:.28vh solid var(--ink);border-radius:.75vh;background:var(--paper);padding:1.2vh 2.1vh;box-shadow:0 .4vh 0 #302c3733;position:relative;transition:transform .12s,background .12s;min-height:5.5vh}button:focus-visible,button.focus{outline:.45vh solid var(--coral);outline-offset:.45vh;transform:translateY(-.3vh) rotate(-.6deg);background:#ffdfa5;z-index:1}button:hover{background:#ffe7b5}button:active{transform:translateY(.2vh);box-shadow:none}button:disabled{opacity:.5;cursor:default}.primary{background:#edb65d;color:#302c37}.secondary{background:#e8edda}.eyebrow{text-transform:uppercase;font-size:.55em;letter-spacing:.18em;font-weight:600;color:#55736c}.paper{background:var(--paper);border:.28vh solid var(--ink);box-shadow:.65vh .8vh 0 #302c3722;border-radius:1.2vh;padding:3.4vh}.panel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-.35deg);width:min(88vw,112vh);max-height:88vh}.panel h1,.panel h2{font-size:clamp(28px,5.4vh,70px);font-weight:600;line-height:1.02;margin:.8vh 0 2.1vh;letter-spacing:-.035em}.panel p{margin:1.2vh 0 2vh}.panel .muted{font-size:.8em;color:#6e6d65}.choices{display:grid;grid-template-columns:1fr 1fr;gap:1.8vh;margin-top:2.6vh}.choices.one{grid-template-columns:1fr}.choices button{text-align:left;min-height:7vh}.choices button small{display:block;font-size:.68em;opacity:.75;margin-top:.4vh}.footer{display:flex;align-items:center;justify-content:space-between;margin-top:2.5vh;gap:2vh}.footer button{min-width:15vh}.backdrop{position:absolute;inset:0;background:#2422383d;backdrop-filter:blur(4px)}.topline{position:absolute;left:5%;right:5%;top:4.7%;display:flex;justify-content:space-between;align-items:start;gap:2vh;font-size:.8em;pointer-events:none\"'!important}.tag{display:inline-flex;align-items:center;gap:1vh;padding:.7vh 1.4vh;background:var(--paper);border:.22vh solid var(--ink);box-shadow:0 .35vh 0 #302c3722;transform:rotate(-1deg);border-radius:.4vh}.tag.gold{background:#f0c56f}.brand-small{letter-spacing:.11em;font-size:.65em;text-transform:uppercase}.title{position:absolute;left:6.4%;top:11%;width:43%;pointer-events:none!important}.seal{font-size:clamp(15px,1.7vh,23px);letter-spacing:.22em;text-transform:uppercase;display:flex;align-items:center;gap:1vh}.seal:before,.seal:after{content:'\"'';height:2px;background:currentColor;width:4vh}.title h1{font-size:clamp(70px,16.5vh,210px);line-height:.88;letter-spacing:-.075em;font-weight:600;margin:3vh 0 2.6vh;filter:drop-shadow(0 .45vh 0 #fff3d1)}.title h1 span{display:inline-block;transform:rotate(-4deg)}.title h1 span:nth-child(2){transform:rotate(3deg)}.title .tagline{font-size:clamp(19px,3.4vh,44px);max-width:31vw;line-height:1.25}.title .subtitle{font-size:.65em;max-width:30vw;line-height:1.4;color:#4d625e;margin-top:1.8vh}.title-bottom{position:absolute;left:6.4%;bottom:9%;display:flex;flex-direction:column;align-items:start;gap:1.6vh}.title-bottom button{font-size:1.15em;min-width:23vw;padding:1.5vh 3vh;background:#f1c36c;transform:rotate(-1deg)}.title-bottom .note{font-size:.6em;color:#526b69}.corner{position:absolute;right:5%;bottom:5%;font-size:.6em;color:#466669}.island-caption{position:absolute;right:9%;top:15%;font-size:.62em;transform:rotate(4deg);padding:1vh 2vh;background:var(--paper);border:.2vh solid var(--ink);border-radius:.3vh}.island-caption:after{content:'';display:block;position:absolute;top:90%;left:30%;width:2vh;height:2vh;transform:rotate(45deg);border-right:.2vh solid var(--ink);border-bottom:.2vh solid var(--ink);background:var(--paper)}.glyph{width:1.2em;height:1.2em;vertical-align:middle;flex-shrink:0}.keycap{font-family:Fredoka,sans-serif;font-size:.7em;display:inline-flex;align-items:center;justify-content:center;min-width:1.7em;min-height:1.6em;padding:.08em .32em;border:.12em solid currentColor;border-radius:.22em;box-shadow:0 .11em 0 currentColor;vertical-align:middle;background:#fff6df}.prompts{display:flex;align-items:center;gap:.7vh;flex-wrap:wrap;font-size:.67em}.prompts i{width:1.4vh}.bottom-prompts{position:absolute;bottom:4%;left:32%;right:5%;display:flex;justify-content:flex-end;padding:.7vh 1.2vh;background:#fff4dce8;border-radius:.4vh;pointer-events:none\"'!important}.hudscore{position:absolute;right:5%;top:5%;text-align:right;pointer-events:none!important}.hudscore strong{font-size:6.2vh;line-height:1;display:block}.hudscore span{font-size:.62em}.timer{position:absolute;left:50%;top:5%;transform:translateX(-50%);font-size:1.15em;pointer-events:none!important}.event-tag{position:absolute;left:5%;top:5%;font-size:.78em;pointer-events:none!important}.event-message{position:absolute;left:50%;top:16%;transform:translateX(-50%);text-align:center;max-width:65%;padding:.6vh 1.3vh;background:#fff4dce8;border-radius:.5vh;font-size:.82em;pointer-events:none!important}.balance{position:absolute;left:5%;bottom:6.5%;width:23vh;height:23vh;pointer-events:none!important;filter:drop-shadow(.3vh .4vh 0 #302c3722)}.balance svg{width:100%;height:100%;overflow:visible}.disc-label{position:absolute;left:0;right:0;bottom:-2.5vh;text-align:center;font-size:.57em;text-transform:uppercase;letter-spacing:.12em}.breath{position:absolute;left:5%;bottom:33%;font-size:.65em;background:#fff4dcde;padding:.8vh 1.3vh;border-radius:2vh}.speech{position:absolute;left:25%;right:7%;bottom:12%;padding:2.3vh 3vh;background:var(--paper);border:.28vh solid var(--ink);border-radius:1vh;box-shadow:.7vh .7vh 0 #302c3722}.speech .name{font-size:.64em;text-transform:uppercase;letter-spacing:.12em;color:#53807a;display:block;margin-bottom:.6vh}.speech .advance{position:absolute;right:1vh;bottom:1vh;font-size:.65em}.countdown{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:24vh;font-weight:600;text-shadow:.5vh .5vh 0 var(--paper);pointer-events:none!important}.toast{position:absolute;top:23%;left:50%;transform:translateX(-50%) rotate(-2deg);padding:1.2vh 2vh;background:#f3d184;border:.25vh solid var(--ink);font-size:.8em;border-radius:.5vh;pointer-events:none!important}.widget{position:absolute;right:5%;bottom:15%;max-width:32%;min-width:20%;background:#fff4dce8;border:.2vh solid var(--ink);border-radius:.6vh;padding:1.5vh;font-size:.8em;pointer-events:none!important}.meter{height:1.8vh;border:.2vh solid var(--ink);background:#ede1c4;border-radius:2vh;overflow:hidden;margin:.8vh 0}.meter>span{display:block;height:100%;background:#84ac85}.result-number{font-size:12vh;line-height:1;font-weight:600;color:#487d7d}.stamp{display:inline-block;border:.45vh double #c86d50;color:#ba684e;padding:.5vh 2vh;font-size:4.4vh;font-weight:600;text-transform:uppercase;transform:rotate(-8deg);border-radius:.5vh}.result-layout{display:flex;align-items:center;justify-content:space-between;gap:3vh}.result-layout .number-label{font-size:.7em}.diagram{float:right;width:19vh;height:19vh;margin:1vh 0 1vh 3vh}.profile-mats{display:grid;grid-template-columns:repeat(4,1fr);gap:2vh;margin:4vh 0}.profile-mats button{min-height:19vh;text-align:center;background:#eddfbc}.profile-mats .peg{font-size:5vh;display:block;margin-bottom:1vh}.profile-mats small{font-size:.6em;display:block;margin-top:1vh}.profile-mats button.active{background:#b7cba4}.settings-row{display:flex;align-items:center;justify-content:space-between;gap:3vh;margin:2vh 0}.settings-row label{flex:1}.settings-row button{width:44%;font-size:.85em}.slider-row{display:block;text-align:left;width:100%;margin:1.5vh 0;background:#f6e7c8}.slider-line{display:flex;justify-content:space-between;margin-bottom:1vh}.slider-track{height:1.2vh;background:#d5c6a7;border-radius:1vh;position:relative}.slider-fill{height:100%;background:#82aca0;border-radius:1vh}.slider-knob{position:absolute;top:-.6vh;width:2.3vh;height:2.3vh;border-radius:50%;background:#e7ae62;border:.2vh solid var(--ink)}.page-indicator{font-size:.65em;opacity:.7}.about-copy{font-size:.75em;line-height:1.45;min-height:28vh}.about-copy p{margin:1.8vh 0}.about-copy b{color:#407775;font-weight:600}.about-panel{width:min(88vw,126vh)}.journal-graph{height:24vh;width:100%}.totals{display:flex;justify-content:space-around;text-align:center;margin:4vh 0}.totals strong{display:block;font-size:6vh}.totals span{font-size:.7em}.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:1vh}.calendar div{border:.2vh solid #ab9e83;min-height:7vh;padding:.6vh;text-align:center;font-size:.75em}.calendar .done{background:#aac3a2;color:#38544a}.demo-banner{position:absolute;bottom:5%;left:50%;transform:translateX(-50%);font-size:.85em}.demo-title{position:absolute;left:5%;top:5%;font-size:1.2em}.world-hotspot{position:absolute;transform:translate(-50%,-100%);white-space:nowrap;font-size:.65em;padding:.5vh 1vh;background:var(--paper);border:.25vh solid var(--ink);box-shadow:0 .3vh 0 #302c3722;pointer-events:none}.world-hotspot.selected{background:#f2c86f;border-color:#ce6b53}.ink-wipe{position:fixed;inset:0;pointer-events:none;background:#302c37;opacity:0;z-index:100;transition:opacity .18s}.stats{position:absolute;left:5%;top:22%;max-width:35%;background:#fff4dce6;font-size:.55em;white-space:pre-line;padding:1vh}.online-names{display:flex;flex-wrap:wrap;gap:2vh}.online-names span{border-bottom:.4vh solid var(--seat);padding:.5vh}.error{padding:8vh;font:24px system-ui;color:#302c37;background:#fff4dc;position:fixed;inset:0}.rhythm-ribbon{position:absolute;left:34%;right:18%;bottom:18%;height:11vh;border-bottom:.5vh solid #594d5e;background:#fff4dcbb;border-radius:1vh;overflow:hidden}.note-foot{position:absolute;top:1vh;border-radius:1vh;border:.25vh solid var(--ink);width:5vh;height:7vh;background:#edbb69;display:flex;align-items:center;justify-content:center}.rhythm-line{position:absolute;left:15%;top:0;bottom:0;border-left:.5vh solid #d46c57}.replay{position:absolute;right:5%;top:28%;background:#edbc72;border:.2vh solid var(--ink);padding:1vh 2vh;transform:rotate(4deg)}\n@media(max-aspect-ratio:1/1){.title{top:8%;left:8%;width:84%}.title h1{font-size:min(22vw,16vh);margin-top:3vh}.title h1 br{display:none}.title .tagline{max-width:80vw;font-size:5.5vw}.title .subtitle{max-width:75vw}.title-bottom{left:8%;bottom:7%;right:8%}.title-bottom button{min-width:66vw;font-size:1em}.island-caption{top:44%;right:7%;font-size:.65em}.panel{width:88%;padding:2.3vh}.choices{grid-template-columns:1fr;gap:1.1vh}.choices button{min-height:5.5vh}.choices button small{display:none}.profile-mats{grid-template-columns:1fr 1fr;gap:1vh;margin:2vh 0}.profile-mats button{min-height:12vh}.profile-mats .peg{font-size:3vh}.title .seal{font-size:3.2vw}.corner{bottom:2%;font-size:.55em}.balance{width:19vh;height:19vh;bottom:8%;left:5%}.bottom-prompts{left:31%;font-size:.57em;bottom:3%}.event-tag{max-width:38%;font-size:.65em}.hudscore strong{font-size:4.5vh}.timer{font-size:.8em}.event-message{top:17%;max-width:90%;width:85%;font-size:.75em}.speech{left:5%;right:5%;bottom:28%;font-size:.9em}.widget{right:5%;bottom:30%;max-width:48%;font-size:.7em;min-width:32%}.breath{bottom:30%}.diagram{width:12vh;height:12vh}.result-layout{flex-wrap:wrap}.stamp{font-size:3.2vh}.result-number{font-size:9vh}.about-copy{font-size:.82em;min-height:30vh}.panel h1,.panel h2{font-size:4.4vh}.footer button{min-width:11vh;padding:.8vh 1.1vh}.settings-row{gap:1vh}.settings-row button{width:46%;padding:1vh;font-size:.8em}.rhythm-ribbon{left:8%;right:8%;bottom:33%;height:9vh}.topline{font-size:.62em}.island-labels{display:none}}\n@media(prefers-reduced-motion:reduce){button{transition:none}}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"cat > src/audio/engine.js <<'EOF'\nimport {cosmetic} from '../core/rng.js';\nexport const TRACKS={title:{bpm:92,root:61,chords:[[0,4,7,11,14],[-3,0,4,7,11],[2,5,9,12,16],[7,11,14,17,21]]},island:{bpm:84,root:53,chords:[[0,4,7,11],[4,7,11,14],[5,9,12,16],[7,11,14,17]]},still:{bpm:60,root:50,chords:[[0,4,7,11,14],[2,6,9,13,16]]},strength:{bpm:100,root:40,chords:[[0,3,7,10,14],[5,9,12,16,19]]},cardio:{bpm:116,root:49,chords:[[0,4,7,11],[-1,2,6,9],[-3,0,4,7],[2,7,9,12]]},balance:{bpm:118,root:48,chords:[[0,4,7,9],[-3,0,4,7],[2,5,9,12],[7,11,14,17]]},level:{bpm:82,root:61,chords:[[0,4,7,11,14],[-3,0,4,7,11],[2,5,9,12,16],[7,11,14,17,21]]}};\nexport const MOTIF=[[[0,77,3],[3,75,1],[4,73,2],[6,68,4],[12,70,2],[14,72,2]],[[0,73,3],[3,72,1],[4,70,2],[6,65,6],[14,68,2]],[[0,70,3],[3,68,1],[4,66,2],[6,63,4],[12,65,2],[14,66,2]],[[0,68,3],[3,70,1],[4,72,2],[6,75,6]]];\nconst hz=m=>440*2**((m-69)/12);\nexport function tone(ctx,dest,midi,start,duration=.3,volume=.2,type='sine',detune=0){const o=ctx.createOscillator(),g=ctx.createGain();o.type=type;o.frequency.setValueAtTime(hz(midi),start);o.detune.value=detune;g.gain.setValueAtTime(0,start);g.gain.linearRampToValueAtTime(volume,start+.008);g.gain.exponentialRampToValueAtTime(.0001,start+Math.max(.02,duration));o.connect(g).connect(dest);o.start(start);o.stop(start+duration+.02);return o;}\nexport function epiano(ctx,dest,midi,start,duration=.6,volume=.15,detune=0){const carrier=ctx.createOscillator(),mod=ctx.createOscillator(),mg=ctx.createGain(),env=ctx.createGain();let f=hz(midi);carrier.frequency.value=f;carrier.detune.value=detune;mod.frequency.value=f*14;mg.gain.setValueAtTime(f*.3,start);mg.gain.exponentialRampToValueAtTime(.01,start+.17);mod.connect(mg).connect(carrier.frequency);env.gain.setValueAtTime(0,start);env.gain.linearRampToValueAtTime(volume,start+.005);env.gain.exponentialRampToValueAtTime(.0001,start+duration);carrier.connect(env).connect(dest);carrier.start(start);mod.start(start);carrier.stop(start+duration+.02);mod.stop(start+duration+.02);}\nexport function noise(ctx,dest,start,duration=.12,volume=.1,freq=1800){const len=Math.max(1,Math.floor(ctx.sampleRate*duration)),buf=ctx.createBuffer(1,len,ctx.sampleRate),data=buf.getChannelData(0);for(let i=0;i<len;i++)data[i]=(cosmetic()*2-1)*Math.exp(-i/len*5);let src=ctx.createBufferSource(),filter=ctx.createBiquadFilter(),g=ctx.createGain();src.buffer=buf;filter.type='bandpass';filter.frequency.value=freq;filter.Q.value=.8;g.gain.value=volume;src.connect(filter).connect(g).connect(dest);src.start(start);}\nexport function synthSfx(ctx,dest,name,start=ctx.currentTime){if(['splash','crash','wind','clack','stamp','sneeze'].includes(name)){noise(ctx,dest,start,name==='wind'?.8:.28,.3,name==='splash'?550:name==='clack'?1200:2200);if(name==='clack')for(let i=0;i<3;i++)tone(ctx,dest,48+i*7,start+i*.025,.07,.2,'triangle');}\n else if(name==='spring'){for(let i=0;i<8;i++)tone(ctx,dest,50+i*3,start+i*.025,.1,.12);}\n else if(name==='bank'||name==='unlock'||name==='bell'){[72,76,79,84].forEach((n,i)=>epiano(ctx,dest,n,start+i*.07,.5,.16));}\n else if(name==='whistle')tone(ctx,dest,96,start,.26,.11);\n else if(name==='spike'){tone(ctx,dest,42,start,.2,.2,'sawtooth');}\n else if(name==='creak'){tone(ctx,dest,37,start,.8,.06,'sawtooth');noise(ctx,dest,start,.7,.1,400);}\n else {tone(ctx,dest,name==='foot'?81:name==='move'?73:name==='fruit'?69:76,start,.055,name==='foot'?.34:.14,'triangle');}}\nexport function voiceLine(ctx,dest,text,speaker='Trudy',start=ctx.currentTime){const pitch=speaker==='Ms. Stillwater'?170:speaker==='Coach Bolster'?95:420,rate=speaker==='Ms. Stillwater'?7:speaker==='Coach Bolster'?11:16,letters=text.toLowerCase().replace(/[\"'^a-z?! .]/g,'\"'').slice(0,140);let at=start,blips=0;for(let i=0;i<letters.length;i+=2){const ch=letters[i];if(\"'!/[a-z]/.test(ch)){at+=.03;continue;}let o=ctx.createOscillator(),f1=ctx.createBiquadFilter(),f2=ctx.createBiquadFilter(),g=ctx.createGain();o.type=speaker==='\"'Coach Bolster'?'sawtooth':'square';o.frequency.value=pitch*(1+(cosmetic()-.5)*.14)*(text.includes('?')?1+i/letters.length*.18:1);f1.type=f2.type='bandpass';f1.frequency.value=({a:800,e:450,i:300,o:500,u:350})[ch]||650;f2.frequency.value=({a:1250,e:1900,i:2300,o:900,u:800})[ch]||1700;f1.Q.value=1.2;f2.Q.value=.8;g.gain.setValueAtTime(0,at);g.gain.linearRampToValueAtTime(speaker==='Trudy'?.13:.24,at+.008);g.gain.exponentialRampToValueAtTime(.0001,at+.065);o.connect(f1).connect(f2).connect(g).connect(dest);o.start(at);o.stop(at+.08);at+=1/rate;blips++;}return {duration:at-start,blips};}\nexport class AudioEngine{\n constructor(settings){this.settings=settings;this.track='title';this.stopped=false;this.tilt=9;this.steps=0;this.next=0;this.voiceUntil=0;}\n unlock(){try{if(\"'!this.ctx){const C=globalThis.AudioContext||globalThis.webkitAudioContext;if(!C)return;this.setup(new C());}this.ctx.resume().catch(()=>{});}catch{}}\n setup(ctx){this.ctx=ctx;this.master=ctx.createDynamicsCompressor();this.master.threshold.value=-12;this.master.ratio.value=3;this.master.connect(ctx.destination);this.buses={};this.analysers={};for(let name of ['\"'music','sfx','voice']){let bus=ctx.createGain(),a=ctx.createAnalyser();a.fftSize=256;bus.connect(a).connect(this.master);this.buses[name]=bus;this.analysers[name]=a;}this.updateMix();this.next=ctx.currentTime+.05;}\n updateMix(){if(this.buses)for(let k of ['music','sfx','voice'])this.buses[k].gain.value=this.stopped?0:this.settings[k]/100;}\n setTrack(name){if(this.track===name)return;this.track=name;this.steps=0;this.next=(this.ctx?.currentTime||0)+.05;}\n detune(t=0){return this.tilt*1.6*Math.sin(t*.7);}\n update(){if(\"'!this.ctx||this.ctx.state!=='\"'running'||this.stopped)return;const ctx=this.ctx,tr=TRACKS[this.track]||TRACKS.title,beat=60/tr.bpm/4;let count=0;if(this.next<ctx.currentTime-.3)this.next=ctx.currentTime+.02;while(this.next<ctx.currentTime+.15&&count++<20){let n=this.steps%16,bar=Math.floor(this.steps/16),ch=tr.chords[bar%tr.chords.length],dt=this.detune(this.next),dest=this.buses.music;if(n===0){for(const c of ch)epiano(ctx,dest,tr.root+c,this.next,beat*10,.09,dt);}if(n%4===0){tone(ctx,dest,tr.root-12+ch[0]+(n===8?12:0),this.next,.22,.22,'triangle',dt);noise(ctx,dest,this.next,.035,.09,6000);}\n if(this.track==='title'||this.track==='level'){for(let [step,midi,len] of MOTIF[bar%4])if(step===n)epiano(ctx,dest,midi,this.next,beat*len*.9,.19,dt);}else if(n%2===0)tone(ctx,dest,tr.root+12+ch[(n/2+bar)%ch.length],this.next,beat*1.5,.065,'sine',dt);\n if(n===4||n===12)noise(ctx,dest,this.next,.09,.08,2400);if(this.track==='cardio'&&n%4===0)tone(ctx,dest,38,this.next,.09,.3);this.next+=beat;this.steps++;}}\n sfx(name){if(this.ctx?.state==='running'&&\"'!this.stopped)synthSfx(this.ctx,this.buses.sfx,name);}\n say(text,speaker){if(this.ctx?.state!=='\"'running'||this.stopped)return;const now=this.ctx.currentTime;if(now<this.voiceUntil)return;const v=voiceLine(this.ctx,this.buses.voice,text,speaker);this.voiceUntil=now+v.duration;}\n sting(medal){if(\"'!this.ctx||this.stopped)return;let notes=medal==='\"'Suspicious'?[72,76,79,84,88]:medal==='Exemplary'?[65,69,72,77]:[60,64,67];notes.forEach((n,i)=>epiano(this.ctx,this.buses.sfx,n,this.ctx.currentTime+i*.13,.8,.17));}\n stop(){this.stopped=true;this.updateMix();}\n}\nEOF\ncat > src/ui/ui.css <<'EOF'\n:root{--ink:#302c37;--paper:#fff4dc;--teal:#487c7b;--coral:#e67960;--unit:1vh;font-family:Fredoka,system-ui,sans-serif;color:var(--ink);font-weight:500;background:#ecdbc5}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden}button,input,select{font:inherit;color:inherit}button{cursor:pointer;touch-action:manipulation}#world{position:fixed;inset:0;width:100%;height:100%;display:block}#ui{position:fixed;inset:0;pointer-events:none;font-size:clamp(17px,2.95vh,36px);line-height:1.25}#ui>*{pointer-events:auto}button{border:.28vh solid var(--ink);border-radius:.75vh;background:var(--paper);padding:1.2vh 2.1vh;box-shadow:0 .4vh 0 #302c3733;position:relative;transition:transform .12s,background .12s;min-height:5.5vh}button:focus-visible,button.focus{outline:.45vh solid var(--coral);outline-offset:.45vh;transform:translateY(-.3vh) rotate(-.6deg);background:#ffdfa5;z-index:1}button:hover{background:#ffe7b5}button:active{transform:translateY(.2vh);box-shadow:none}button:disabled{opacity:.5;cursor:default}.primary{background:#edb65d;color:#302c37}.secondary{background:#e8edda}.eyebrow{text-transform:uppercase;font-size:.55em;letter-spacing:.18em;font-weight:600;color:#55736c}.paper{background:var(--paper);border:.28vh solid var(--ink);box-shadow:.65vh .8vh 0 #302c3722;border-radius:1.2vh;padding:3.4vh}.panel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-.35deg);width:min(88vw,112vh);max-height:88vh}.panel h1,.panel h2{font-size:clamp(28px,5.4vh,70px);font-weight:600;line-height:1.02;margin:.8vh 0 2.1vh;letter-spacing:-.035em}.panel p{margin:1.2vh 0 2vh}.panel .muted{font-size:.8em;color:#6e6d65}.choices{display:grid;grid-template-columns:1fr 1fr;gap:1.8vh;margin-top:2.6vh}.choices.one{grid-template-columns:1fr}.choices button{text-align:left;min-height:7vh}.choices button small{display:block;font-size:.68em;opacity:.75;margin-top:.4vh}.footer{display:flex;align-items:center;justify-content:space-between;margin-top:2.5vh;gap:2vh}.footer button{min-width:15vh}.backdrop{position:absolute;inset:0;background:#2422383d;backdrop-filter:blur(4px)}.topline{position:absolute;left:5%;right:5%;top:4.7%;display:flex;justify-content:space-between;align-items:start;gap:2vh;font-size:.8em;pointer-events:none\"'!important}.tag{display:inline-flex;align-items:center;gap:1vh;padding:.7vh 1.4vh;background:var(--paper);border:.22vh solid var(--ink);box-shadow:0 .35vh 0 #302c3722;transform:rotate(-1deg);border-radius:.4vh}.tag.gold{background:#f0c56f}.brand-small{letter-spacing:.11em;font-size:.65em;text-transform:uppercase}.title{position:absolute;left:6.4%;top:11%;width:43%;pointer-events:none!important}.seal{font-size:clamp(15px,1.7vh,23px);letter-spacing:.22em;text-transform:uppercase;display:flex;align-items:center;gap:1vh}.seal:before,.seal:after{content:'\"'';height:2px;background:currentColor;width:4vh}.title h1{font-size:clamp(70px,16.5vh,210px);line-height:.88;letter-spacing:-.075em;font-weight:600;margin:3vh 0 2.6vh;filter:drop-shadow(0 .45vh 0 #fff3d1)}.title h1 span{display:inline-block;transform:rotate(-4deg)}.title h1 span:nth-child(2){transform:rotate(3deg)}.title .tagline{font-size:clamp(19px,3.4vh,44px);max-width:31vw;line-height:1.25}.title .subtitle{font-size:.65em;max-width:30vw;line-height:1.4;color:#4d625e;margin-top:1.8vh}.title-bottom{position:absolute;left:6.4%;bottom:9%;display:flex;flex-direction:column;align-items:start;gap:1.6vh}.title-bottom button{font-size:1.15em;min-width:23vw;padding:1.5vh 3vh;background:#f1c36c;transform:rotate(-1deg)}.title-bottom .note{font-size:.6em;color:#526b69}.corner{position:absolute;right:5%;bottom:5%;font-size:.6em;color:#466669}.island-caption{position:absolute;right:9%;top:15%;font-size:.62em;transform:rotate(4deg);padding:1vh 2vh;background:var(--paper);border:.2vh solid var(--ink);border-radius:.3vh}.island-caption:after{content:'';display:block;position:absolute;top:90%;left:30%;width:2vh;height:2vh;transform:rotate(45deg);border-right:.2vh solid var(--ink);border-bottom:.2vh solid var(--ink);background:var(--paper)}.glyph{width:1.2em;height:1.2em;vertical-align:middle;flex-shrink:0}.keycap{font-family:Fredoka,sans-serif;font-size:.7em;display:inline-flex;align-items:center;justify-content:center;min-width:1.7em;min-height:1.6em;padding:.08em .32em;border:.12em solid currentColor;border-radius:.22em;box-shadow:0 .11em 0 currentColor;vertical-align:middle;background:#fff6df}.prompts{display:flex;align-items:center;gap:.7vh;flex-wrap:wrap;font-size:.67em}.prompts i{width:1.4vh}.bottom-prompts{position:absolute;bottom:4%;left:32%;right:5%;display:flex;justify-content:flex-end;padding:.7vh 1.2vh;background:#fff4dce8;border-radius:.4vh;pointer-events:none\"'!important}.hudscore{position:absolute;right:5%;top:5%;text-align:right;pointer-events:none!important}.hudscore strong{font-size:6.2vh;line-height:1;display:block}.hudscore span{font-size:.62em}.timer{position:absolute;left:50%;top:5%;transform:translateX(-50%);font-size:1.15em;pointer-events:none!important}.event-tag{position:absolute;left:5%;top:5%;font-size:.78em;pointer-events:none!important}.event-message{position:absolute;left:50%;top:16%;transform:translateX(-50%);text-align:center;max-width:65%;padding:.6vh 1.3vh;background:#fff4dce8;border-radius:.5vh;font-size:.82em;pointer-events:none!important}.balance{position:absolute;left:5%;bottom:6.5%;width:23vh;height:23vh;pointer-events:none!important;filter:drop-shadow(.3vh .4vh 0 #302c3722)}.balance svg{width:100%;height:100%;overflow:visible}.disc-label{position:absolute;left:0;right:0;bottom:-2.5vh;text-align:center;font-size:.57em;text-transform:uppercase;letter-spacing:.12em}.breath{position:absolute;left:5%;bottom:33%;font-size:.65em;background:#fff4dcde;padding:.8vh 1.3vh;border-radius:2vh}.speech{position:absolute;left:25%;right:7%;bottom:12%;padding:2.3vh 3vh;background:var(--paper);border:.28vh solid var(--ink);border-radius:1vh;box-shadow:.7vh .7vh 0 #302c3722}.speech .name{font-size:.64em;text-transform:uppercase;letter-spacing:.12em;color:#53807a;display:block;margin-bottom:.6vh}.speech .advance{position:absolute;right:1vh;bottom:1vh;font-size:.65em}.countdown{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:24vh;font-weight:600;text-shadow:.5vh .5vh 0 var(--paper);pointer-events:none!important}.toast{position:absolute;top:23%;left:50%;transform:translateX(-50%) rotate(-2deg);padding:1.2vh 2vh;background:#f3d184;border:.25vh solid var(--ink);font-size:.8em;border-radius:.5vh;pointer-events:none!important}.widget{position:absolute;right:5%;bottom:15%;max-width:32%;min-width:20%;background:#fff4dce8;border:.2vh solid var(--ink);border-radius:.6vh;padding:1.5vh;font-size:.8em;pointer-events:none!important}.meter{height:1.8vh;border:.2vh solid var(--ink);background:#ede1c4;border-radius:2vh;overflow:hidden;margin:.8vh 0}.meter>span{display:block;height:100%;background:#84ac85}.result-number{font-size:12vh;line-height:1;font-weight:600;color:#487d7d}.stamp{display:inline-block;border:.45vh double #c86d50;color:#ba684e;padding:.5vh 2vh;font-size:4.4vh;font-weight:600;text-transform:uppercase;transform:rotate(-8deg);border-radius:.5vh}.result-layout{display:flex;align-items:center;justify-content:space-between;gap:3vh}.result-layout .number-label{font-size:.7em}.diagram{float:right;width:19vh;height:19vh;margin:1vh 0 1vh 3vh}.profile-mats{display:grid;grid-template-columns:repeat(4,1fr);gap:2vh;margin:4vh 0}.profile-mats button{min-height:19vh;text-align:center;background:#eddfbc}.profile-mats .peg{font-size:5vh;display:block;margin-bottom:1vh}.profile-mats small{font-size:.6em;display:block;margin-top:1vh}.profile-mats button.active{background:#b7cba4}.settings-row{display:flex;align-items:center;justify-content:space-between;gap:3vh;margin:2vh 0}.settings-row label{flex:1}.settings-row button{width:44%;font-size:.85em}.slider-row{display:block;text-align:left;width:100%;margin:1.5vh 0;background:#f6e7c8}.slider-line{display:flex;justify-content:space-between;margin-bottom:1vh}.slider-track{height:1.2vh;background:#d5c6a7;border-radius:1vh;position:relative}.slider-fill{height:100%;background:#82aca0;border-radius:1vh}.slider-knob{position:absolute;top:-.6vh;width:2.3vh;height:2.3vh;border-radius:50%;background:#e7ae62;border:.2vh solid var(--ink)}.page-indicator{font-size:.65em;opacity:.7}.about-copy{font-size:.75em;line-height:1.45;min-height:28vh}.about-copy p{margin:1.8vh 0}.about-copy b{color:#407775;font-weight:600}.about-panel{width:min(88vw,126vh)}.journal-graph{height:24vh;width:100%}.totals{display:flex;justify-content:space-around;text-align:center;margin:4vh 0}.totals strong{display:block;font-size:6vh}.totals span{font-size:.7em}.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:1vh}.calendar div{border:.2vh solid #ab9e83;min-height:7vh;padding:.6vh;text-align:center;font-size:.75em}.calendar .done{background:#aac3a2;color:#38544a}.demo-banner{position:absolute;bottom:5%;left:50%;transform:translateX(-50%);font-size:.85em}.demo-title{position:absolute;left:5%;top:5%;font-size:1.2em}.world-hotspot{position:absolute;transform:translate(-50%,-100%);white-space:nowrap;font-size:.65em;padding:.5vh 1vh;background:var(--paper);border:.25vh solid var(--ink);box-shadow:0 .3vh 0 #302c3722;pointer-events:none}.world-hotspot.selected{background:#f2c86f;border-color:#ce6b53}.ink-wipe{position:fixed;inset:0;pointer-events:none;background:#302c37;opacity:0;z-index:100;transition:opacity .18s}.stats{position:absolute;left:5%;top:22%;max-width:35%;background:#fff4dce6;font-size:.55em;white-space:pre-line;padding:1vh}.online-names{display:flex;flex-wrap:wrap;gap:2vh}.online-names span{border-bottom:.4vh solid var(--seat);padding:.5vh}.error{padding:8vh;font:24px system-ui;color:#302c37;background:#fff4dc;position:fixed;inset:0}.rhythm-ribbon{position:absolute;left:34%;right:18%;bottom:18%;height:11vh;border-bottom:.5vh solid #594d5e;background:#fff4dcbb;border-radius:1vh;overflow:hidden}.note-foot{position:absolute;top:1vh;border-radius:1vh;border:.25vh solid var(--ink);width:5vh;height:7vh;background:#edbb69;display:flex;align-items:center;justify-content:center}.rhythm-line{position:absolute;left:15%;top:0;bottom:0;border-left:.5vh solid #d46c57}.replay{position:absolute;right:5%;top:28%;background:#edbc72;border:.2vh solid var(--ink);padding:1vh 2vh;transform:rotate(4deg)}\n@media(max-aspect-ratio:1/1){.title{top:8%;left:8%;width:84%}.title h1{font-size:min(22vw,16vh);margin-top:3vh}.title h1 br{display:none}.title .tagline{max-width:80vw;font-size:5.5vw}.title .subtitle{max-width:75vw}.title-bottom{left:8%;bottom:7%;right:8%}.title-bottom button{min-width:66vw;font-size:1em}.island-caption{top:44%;right:7%;font-size:.65em}.panel{width:88%;padding:2.3vh}.choices{grid-template-columns:1fr;gap:1.1vh}.choices button{min-height:5.5vh}.choices button small{display:none}.profile-mats{grid-template-columns:1fr 1fr;gap:1vh;margin:2vh 0}.profile-mats button{min-height:12vh}.profile-mats .peg{font-size:3vh}.title .seal{font-size:3.2vw}.corner{bottom:2%;font-size:.55em}.balance{width:19vh;height:19vh;bottom:8%;left:5%}.bottom-prompts{left:31%;font-size:.57em;bottom:3%}.event-tag{max-width:38%;font-size:.65em}.hudscore strong{font-size:4.5vh}.timer{font-size:.8em}.event-message{top:17%;max-width:90%;width:85%;font-size:.75em}.speech{left:5%;right:5%;bottom:28%;font-size:.9em}.widget{right:5%;bottom:30%;max-width:48%;font-size:.7em;min-width:32%}.breath{bottom:30%}.diagram{width:12vh;height:12vh}.result-layout{flex-wrap:wrap}.stamp{font-size:3.2vh}.result-number{font-size:9vh}.about-copy{font-size:.82em;min-height:30vh}.panel h1,.panel h2{font-size:4.4vh}.footer button{min-width:11vh;padding:.8vh 1.1vh}.settings-row{gap:1vh}.settings-row button{width:46%;padding:1vh;font-size:.8em}.rhythm-ribbon{left:8%;right:8%;bottom:33%;height:9vh}.topline{font-size:.62em}.island-labels{display:none}}\n@media(prefers-reduced-motion:reduce){button{transition:none}}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui/ui.js <<'EOF'\nimport {prompts,glyph} from '../input/glyphs.js';\nimport {clamp} from '../data/config.js';\nexport const esc=s=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nexport const btn=(text,action,sub='',cls='')=>\"'`<button data-action=\"${action}\" class=\"${cls}\">${text}${sub?`<small>${sub}</small>`:'\"''}</button>\"'`;\nexport const panel=(eyebrow,title,body,footer='\"'',cls='')=>\"'`<div class=\"backdrop\"></div><section class=\"panel paper ${cls}\"><div class=\"eyebrow\">${eyebrow}</div><h1>${title}</h1>${body}${footer?`<div class=\"footer\">${footer}</div>`:'\"''}</section>\"'`;\nexport const discSVG=(i=0)=>`<svg viewBox=\"0 0 220 220\" aria-label=\"Balance Disc\"><circle cx=\"110\" cy=\"110\" r=\"105\" fill=\"#fff4dc\" stroke=\"#302c37\" stroke-width=\"3\"/><circle cx=\"110\" cy=\"110\" r=\"81\" fill=\"none\" stroke=\"#cabea1\" stroke-width=\"1.5\"/><circle cx=\"110\" cy=\"110\" r=\"41\" fill=\"none\" stroke=\"#d5c8ae\" stroke-width=\"1.5\"/><path d=\"M16 110H204M110 16V204\" stroke=\"#d5c8ae\" stroke-width=\"1.5\"/><circle class=\"target\" cx=\"110\" cy=\"110\" r=\"24\" fill=\"#acd4ae88\" stroke=\"#558a77\" stroke-width=\"2\"/><path class=\"trail\" fill=\"none\" stroke=\"#9aaca3\" stroke-width=\"2.5\"/><circle class=\"asking\" cx=\"110\" cy=\"110\" r=\"9\" fill=\"none\" stroke=\"#d47d52\" stroke-width=\"2.5\" stroke-dasharray=\"3 2\"/><circle class=\"dot\" cx=\"110\" cy=\"110\" r=\"6.5\" fill=\"#314950\" stroke=\"#fff4dc\" stroke-width=\"2\"/><path d=\"M91 9v-8h38v8\" fill=\"#efc064\" stroke=\"#302c37\" stroke-width=\"2\"/><circle cx=\"110\" cy=\"3\" r=\"4\" fill=\"#aaca7c\"/></svg>`;\nexport class UI{\n constructor(game){this.game=game;this.root=document.createElement('\"'div');this.root.id='ui';this.root.innerHTML='<div id=\\\"hud\\\"></div><div id=\\\"screen\\\"></div><div id=\\\"float\\\"></div>';document.body.append(this.root);this.screen=this.root.querySelector('#screen');this.hud=this.root.querySelector('#hud');this.float=this.root.querySelector('#float');this.focus=0;this.navCooldown=0;this.lastPrompt='';this.trails=[];game.input.onPointerMove=e=>{const b=e.target.closest?.('button');if(b&&this.screen.contains(b)){let index=this.buttons.indexOf(b);if(index>=0)this.setFocus(index);}};}\n show(html,actions={},back=null){this.screen.innerHTML=html;this.actions=actions;this.back=back;this.buttons=Array.from(this.screen.querySelectorAll('button:not(:disabled)'));this.focus=0;for(let b of this.buttons){b.addEventListener('click',e=>{this.game.audio.unlock();this.game.audio.sfx('confirm');const action=b.dataset.action;this.actions[action]?.(e,b);});if(b.dataset.slider){const move=e=>{if(\"'!b.hasPointerCapture?.(e.pointerId))return;const r=b.getBoundingClientRect(),p=clamp((e.clientX-r.left)/(r.width));this.actions[b.dataset.action]?.(null,b,p);};b.addEventListener('\"'pointerdown',e=>{b.setPointerCapture(e.pointerId);move(e);});b.addEventListener('pointermove',move);}}\n this.setFocus(0);this.lastPrompt='';this.updatePrompts();}\n setFocus(index){if(\"'!this.buttons?.length)return;this.buttons[this.focus]?.classList.remove('\"'focus');this.focus=(index+this.buttons.length)%this.buttons.length;this.buttons[this.focus]?.classList.add('focus');}\n poll(dt,input){this.navCooldown-=dt;if(\"'!this.buttons?.length){if(input.back)this.back?.();return;}let b=this.buttons[this.focus];let dir=input.menuY||input.menuX;if(dir&&this.navCooldown<=0){this.navCooldown=.18;if(input.menuX&&b?.dataset.slider){this.actions[b.dataset.action]?.(input.menuX,b);}else if(input.menuX&&this.pageMove){this.pageMove(input.menuX);}else{const grid=b?.parentElement.classList.contains('\"'choices')&&getComputedStyle(b.parentElement).gridTemplateColumns.split(' ').length===2;let delta=input.menuY?(grid?input.menuY*2:input.menuY):input.menuX;this.setFocus(this.focus+delta);this.game.audio.sfx('move');}}\n if(input.confirm)this.buttons[this.focus]?.click();else if(input.back)this.back?.();this.updatePrompts();}\n updatePrompts(){const g=this.game,key=g.input.lastDevice+g.settings.glyphs;if(key===this.lastPrompt)return;this.lastPrompt=key;for(const e of this.root.querySelectorAll('[data-prompt]'))e.innerHTML=prompts(e.dataset.prompt.split(','),g.input,g.settings);}\n clear(){this.show('');}\n clearHud(){this.hud.innerHTML='';this.hudEvent=null;}\n eventHud(event){this.hudEvent=event.id;this.trails=event.lanes.map(()=>[]);this.hud.innerHTML=\"'`<div class=\"event-tag tag\">${esc(event.meta.title)}<br></div><div class=\"timer tag\"></div><div class=\"hudscore\"><span>FORM / SCORE</span><strong>0</strong></div><div class=\"event-message\"></div>${event.lanes.map((l,i)=>`<div class=\"balance\" data-disc=\"${i}\" ${event.lanes.length>1?`style=\"width:16vh;height:16vh;left:${5+i*23}%;bottom:7%\"`:'\"''}>\"'${discSVG(i)}<div class=\"disc-label\">${event.lanes.length>1?esc(l.name):'\"'Balance Disc'}</div></div>\"'`).join('\"'')}<div class=\\\"breath\\\" \"'${event.meta.discipline!=='\"'Stillness'&&event.id\"'!=='\"'grand'?'hidden':''}></div><div class=\\\"widget\\\" hidden></div><div class=\\\"rhythm-ribbon\\\" hidden></div><div class=\\\"bottom-prompts prompts\\\" data-prompt=\\\"\"'${event.meta.verbs.join('\"',')}\\\"></div>\"'`;this.updatePrompts();}\n updateEvent(e){if(this.hudEvent!==e.id)this.eventHud(e);this.hud.querySelector('\"'.timer').textContent=\"'`${Math.max(0,Math.ceil(e.duration-e.t))}s`;this.hud.querySelector('\"'.hudscore strong').textContent=Math.round(e.lanes[0]?.score||0);this.hud.querySelector('.event-message').textContent=e.message||e.meta.one;\n for(let i=0;i<e.lanes.length;i++){let l=e.lanes[i],bal=l.balancer;if(\"'!bal)continue;let d=this.hud.querySelector(`[data-disc=\"${i}\"]`),target=l.target||e.target,x=clamp(bal.cob.x,-1.05,1.05)*82,z=clamp(bal.cob.z,-1.05,1.05)*82,inside=Math.hypot(bal.cob.x-target.x,bal.c