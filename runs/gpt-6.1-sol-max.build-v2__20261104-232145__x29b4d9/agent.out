r').textContent=18+Math.floor((this.stateTime*49)%82);if(Math.floor(this.stateTime*16)\"'!==this.ageRollTick){this.ageRollTick=Math.floor(this.stateTime*16);this.audio.sfx('\"'move');}}else if(\"'!this.ageShown){this.ageShown=true;this.ui.screen.querySelector('\"'#age-counter').textContent=this.currentAge;let text=this.currentAge>55?line('highAge'):line('lowAge');this.ui.screen.querySelector('#age-line').textContent=text;this.ui.screen.querySelector('#age-continue').hidden=false;this.audio.sting('Pleasant');this.audio.say(text,'Trudy');}this.ui.poll(dt,s);return;}\n if(this.screen==='jar'){this.island.fixed(dt,{x:0,z:0},'idle');let intended=Math.min(this.jarCount,Math.floor(this.stateTime*5));while(this.jarAdded<intended){this.island.addMarbles(1,false,this.jarMedal==='Exemplary'?0xe9bd5c:0x91b5a7);this.jarAdded++;this.audio.sfx('fruit');}const node=this.ui.screen.querySelector('#jar-count');if(node)node.textContent=(this.profile.marbles-this.jarCount+this.jarAdded)+' marbles';this.ui.poll(dt,s);return;}\n if(this.screen==='ending'){this.island.fixed(dt,{x:0,z:0},'idle');let beat=Math.floor(this.stateTime/6),text=['Oh. So that’s what the middle looks like.','', 'It’s quite flat, isn’t it?', '…Same time tomorrow?'][Math.min(3,beat)];if(beat\"'!==this.endingBeat){this.endingBeat=beat;this.ui.show(`<div class=\"topline\"><div class=\"tag gold\">The island is level.</div></div>${text?`<div class=\"speech\"><span class=\"name\">Trudy</span>${text}${beat>=3?`<div class=\"footer\">${btn('\"'A very small curtain call','credits','','primary')}</div>\"'`:'\"''}</div>\"'`:'\"''}\"'`,{credits:()=>this.about(0,true)});if(text)this.audio.say(text,'\"'Trudy');if(beat===1)this.audio.sting('Suspicious');}if(s.confirm&&beat>=3)this.about(0,true);return;}\n if(this.screen==='podium'&&this.event){this.event.fixed(dt,this.event.lanes.map(()=>({x:0,z:0})));if(this.stateTime>2&&this.podiumRoot)this.podiumRoot.rotation.z=Math.min(.9,(this.stateTime-2)*.1);}\n if(['title','menu','profiles','newProfile','question','checkIntro','intro','results','plan','bed','free','tiers','pause','settings','how','dev','journal','mirror','about','groupLobby','groupPlaylist','podium','resetConfirm'].includes(this.screen)){this.ui.poll(dt,s);}\n if(['title','menu','profiles','newProfile','question','checkIntro','plan','bed','free','tiers','journal','mirror','about','groupLobby','groupPlaylist'].includes(this.screen))this.island.fixed(dt,{x:0,z:0},'idle');\n }\n frame(dt){if(this.session?.ended)return;if(this.event)this.event.frame(dt);if(this.island.root.visible){const title=['title','menu','profiles','newProfile','about','journal','groupLobby','groupPlaylist','ending'].includes(this.screen)||this.attract&&this.attractId==='island';this.island.frame(dt,title);if(this.screen==='jar')this.view.setCamera([-3,4.4,3.7],[-3,1.4,-4]);if(this.screen==='ending'){let a=this.stateTime*.025;this.view.setCamera([Math.sin(a)*48,26,Math.cos(a)*48],[0,0,0]);}}\n if(this.screen==='island'){let h=this.island.hover||this.island.focus,e=this.ui.hud.querySelector('#hotspot');if(e){e.hidden=\"'!h;if(h){let p=new T.Vector3(h.x,2,h.z).applyMatrix4(this.island.root.matrixWorld).project(this.view.camera);e.style.left=(p.x+1)*50+'\"'%';e.style.top=(1-p.y)*50+'%';e.className='world-hotspot selected';e.textContent=(REGISTRY[h.id]?.title||{bed:'The Bed Hut',mirror:'The Mirror',plan:'Today’s Plan',jar:'The Marble Jar'}[h.id])+' · Use';}}}\n if(this.event&&(['play','countdown'].includes(this.screen)||this.attract))this.ui.updateEvent(this.event);this.ui.frame(dt);for(let i=this.effects.length-1;i>=0;i--){let f=this.effects[i];f.t-=dt;if(f.vx\"'!==undefined){f.v.position.x+=f.vx*dt;f.v.position.y+=f.vy*dt;f.v.position.z+=f.vz*dt;f.vy-=5*dt;}else f.v.position.y+=dt*.25;f.v.material.opacity=Math.min(1,f.t*2);if(f.t<=0){f.v.removeFromParent();f.v.geometry?.dispose();f.v.material?.map?.dispose();f.v.material?.dispose();this.effects.splice(i,1);}}\n this.audio.tilt=this.profile?restTilt(this.profile.steps):9;this.audio.update();this.debugFrame();if(this.dev.freeCamera&&this.input.current){const s=this.input.current;this.view.wantPos.x+=s.lookX*dt*6;this.view.wantPos.z+=s.lookY*dt*6;}this.view.frame(dt,this.settings);}\n debugFrame(){if(this.dev.debug&&this.event){let data=this.event.world.debugRender();if(!this.debugLines){this.debugLines=new T.LineSegments(new T.BufferGeometry(),new T.LineBasicMaterial({vertexColors:true}));this.view.scene.add(this.debugLines);}this.debugLines.visible=true;this.debugLines.geometry.setAttribute('\"'position',new T.BufferAttribute(data.vertices,3));this.debugLines.geometry.setAttribute('color',new T.BufferAttribute(data.colors,4));}else if(this.debugLines)this.debugLines.visible=false;if(this.dev.stats){let s=this.ui.hud.querySelector('.stats');if(\"'!s){s=document.createElement('\"'div');s.className='stats';this.ui.hud.append(s);}s.textContent=\"'`${this.view.backend} · ${this.view.frames} frames'\"\\\\n\"'${this.event?.world.bodies.len()||this.island.world.bodies.len()} bodies · ${this.view.renderer?.info.render.drawCalls||0} draws'\"\\\\n\"'${this.input.lastDevice} · x ${this.lastInput?.x?.toFixed(2)||0} · z ${this.lastInput?.z?.toFixed(2)||0}'\"\\\\nL \"'${this.lastInput?.left?.toFixed(2)||0} · R ${this.lastInput?.right?.toFixed(2)||0}`;}else this.ui.hud.querySelector('\"'.stats')?.remove();}\n state(){return {screen:this.screen,attract:this.attract,attractId:this.attractId,day:this.profile?.day||0,step:this.profile?.steps||0,profile:this.profile?JSON.parse(JSON.stringify(this.profile)):null,marbles:this.profile?.marbles||0,tilt:restTilt(this.profile?.steps||0),wobbleAge:this.profile?.ages.at(-1)?.age||0,event:this.event?.state()||null,input:{lastDevice:this.input.lastDevice,glyphSet:this.settings.glyphs,...this.lastInput},audio:{state:this.audio.ctx?.state||'silent',music:this.settings.music,sfx:this.settings.sfx,voice:this.settings.voice,detune:this.audio.detune(this.simTime)},render:{backend:this.view.backend,frames:this.view.frames,lost:this.view.lost},world:this.simTime,errors:[...this.errors]};}\n goto(screen,args={}){switch(screen){case 'title':this.title();break;case 'menu':this.mainMenu();break;case 'profile':if(\"'!this.profile){this.save.data.profiles[0]=freshProfile();this.save.data.selected=0;this.profile.tutorial=true;}this.island.setProfile(this.profile);this.showIsland();break;case '\"'event':this.flow='free';this.groupRun=null;this.intro(args.id||'fruit',args.tier||1);if(args.play)this.beginPlay();break;case 'island':this.showIsland();break;case 'plan':this.todayPlan();break;case 'pause':this.pause();break;case 'about':this.about(args.page||0);break;case 'ending':this.ending();break;case 'jar':this.jarView(args.count||10,()=>this.showIsland());break;case 'age':this.ageShown=false;this.ageReveal(args.age||74);break;case 'group':this.groupLobby();break;case 'settings':this.settingsMenu(this.screen);break;case 'dev':if(this.screen==='pause')this.devMenu();break;case 'check':this.startCheck();this.beginPlay();break;case 'journal':this.journal(args.page||0);break;}}\n}\nEOF\npython3 - <<'PY'\np='src/game/director.js';s=open(p).read().replace(\\\"results(){this.setScreen('results');\\\",\\\"results(){if(this.groupRun){this.groupResults();return;}this.setScreen('results');\\\").replace(\\\"this.currentAge=number;this.ui.show\\\", \\\"this.currentAge=number;this.ageShown=false;this.ui.show\\\");open(p,'w').write(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > src/game/session.js <<'EOF'\nimport {TITLE,SEATS,clamp} from '../data/config.js';\nimport {SESSION_SET,REGISTRY} from '../data/events.js';\nimport {btn,panel,esc} from '../ui/ui.js';\nimport {createEvent} from '../events/registry.js';\nimport {prompts} from '../input/glyphs.js';\nexport class Session{\n constructor(game,info){this.game=game;this.info=info;this.clock=-Infinity;this.slot=-1;this.phase='card';this.scores=[0,0,0];this.sentAt=-1;this.progressAt=-1;this.finished=false;this.ended=false;this.card={left:30000,ready:[],starting:false,paused:false};this.remotes=new Map();this.left=new Set();let r=AIHub.rng('deal'),set=[...SESSION_SET];for(let i=set.length-1;i>0;i--){let j=Math.floor(r()*(i+1));[set[i],set[j]]=[set[j],set[i]];}this.deal=set.slice(0,3);game.island.hide();this.buildSlot(0);this.slot=-1;\n AIHub.on('card',card=>{this.card=card;if(this.phase==='card')this.cardScreen();});AIHub.on('start',()=>{this.phase='countdown';game.setScreen('sessionPlay');game.ui.clear();});AIHub.on('message',(data,from)=>this.message(data,from));AIHub.on('leave',({id})=>{this.left.add(id);let lane=game.event?.lanes.find(l=>l.playerId===id);if(lane)lane.doll.root.visible=false;});AIHub.on('time-up',()=>this.finish());AIHub.on('end',()=>{this.ended=true;game.audio.stop();});this.cardScreen();AIHub.ready();\n }\n configs(){const players=this.info.players.filter(p=>\"'!this.left.has(p.id)),me=players.find(p=>p.id===this.info.me)||players[0];return [me,...players.filter(p=>p!==me)].map((p,i)=>({name:p.name,colour:p.color||SEATS[p.id],playerId:p.id,kind:i===0?'\"'local':'ghost',device:'main',pad:0}));}\n buildSlot(slot){const g=this.game;g.disposeEvent();g.event=createEvent(g,this.deal[slot],1,this.configs(),{session:true,duration:50});this.slot=slot;g.event.start();g.ui.clearHud();g.audio.setTrack(g.event.meta.discipline==='Stillness'?'still':g.event.meta.discipline==='Strength'?'strength':g.event.meta.discipline==='Cardio'?'cardio':'balance');}\n cardScreen(){const g=this.game;g.setScreen('sessionCard');g.ui.show(panel('Level Best · Group Class',TITLE,\"'`<p>Three classes. Find your balance.<br>Highest total form wins.</p><div class=\"online-names\">${this.info.players.map(p=>`<span data-player=\"${p.id}\" style=\"--seat:${p.color||SEATS[p.id]}\"></span>`).join('\"'')}</div><p class=\\\"muted\\\">Lean: stick, WASD or mouse.<br>Feet: L2 / R2, Q / E or mouse buttons. Flail: Square / F.</p><div class=\\\"prompts\\\" data-prompt=\\\"lean,feet,flail\\\"></div><p id=\\\"card-clock\\\"></p>\"'`,`${btn('\"'Ready · Enter / Cross','ready','','primary')}\"'${btn('\"'More time · M / Triangle','more')}\"'`),{ready:()=>AIHub.answer('\"'ready'),more:()=>AIHub.answer('more')});for(const p of this.info.players){const el=g.ui.screen.querySelector(\"'`[data-player=\"${p.id}\"]`);if(el)el.textContent=p.name+(this.card.ready.includes(p.id)?'\"' ✓':'');}g.ui.screen.querySelector('#card-clock').textContent=this.card.starting?'Starting…':this.card.paused?'Paused · take your time.':\"'`Starting in ${Math.ceil((this.card.left||0)/1000)}s`;}\n fixed(dt,input){const g=this.game;if(this.ended)return;this.clock=AIHub.time()/1000;if(this.phase==='\"'card'){if(input.confirm)AIHub.answer('ready');if(input.more||input.ask)AIHub.answer('more');return;}if(input.pause){if(g.screen==='settings')g.returnSettings();else g.settingsMenu('session');}\n if(\"'!Number.isFinite(this.clock))return;if(this.clock<0){if(g.screen!=='\"'settings')g.ui.screen.innerHTML=\"'`<div class=\"countdown\">${Math.ceil(-this.clock)}</div>`;return;}if(this.finished)return;\n const slot=Math.min(2,Math.floor(this.clock/62)),local=this.clock-slot*62;if(slot!==this.slot)this.buildSlot(slot);\n if(this.clock>=186){this.finish();return;}\n const phase=local<6?'\"'intro':local<56?'play':'score';if(this.phase\"'!==phase){this.phase=phase;if(g.screen!=='\"'settings')g.ui.clear();if(phase==='score'){g.event