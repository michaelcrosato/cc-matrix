{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/events/fruit.js';s=open(p).read().replace('basket(l.doll.root);','basket(l.doll.root,1.5);').replace('setTranslation(0,.81,0)','setTranslation(0,.75,0)').replace('*.36,.91,','*.36,.85,').replace('new T.Vector3(0,.9,0)','new T.Vector3(0,.85,0)');open(p,'w').write(s)\np='src/events/training.js';s=open(p).read().replace(\\\"l.target.r=[.15,.12,.1][tier-1]\\\", \\\"l.target.r=[.17,.12,.1][tier-1]\\\");open(p,'w').write(s)\nPY\ncat >> notes/issues.md <<'EOF'\n- 17 [gameplay] Fruit basket colliders were 6 cm above the recipe, so fruit hit the back rim and knocked the doll instead of entering cleanly. Aligned the collider and drawn basket with the planned height.\n- 18 [balance] Three-seed clumsy Still Water scores averaged below Adequate. Slightly enlarged its teaching-tier calm zone.\nEOF\nnode tools/build.mjs && node tools/test.mjs balance\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
