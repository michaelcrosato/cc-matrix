{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"cat > tools/test.mjs <<'EOF'\nimport {chromium,webkit,firefox,devices} from 'playwright';\nimport {resolve} from 'node:path';\nimport {readFileSync,writeFileSync,mkdirSync,existsSync,readdirSync} from 'node:fs';\nimport {createHash} from 'node:crypto';\nimport {createServer} from 'node:http';\nimport {TITLE} from '../src/data/config.js';\nimport {DAYS,TOTAL_STEPS,age,restTilt,payout,medal,nextTier} from '../src/data/programme.js';\nimport {EVENTS} from '../src/data/events.js';\nimport {TUNING} from '../src/data/tuning.js';\nimport {PATTERNS,chart} from '../src/data/charts.js';\nimport {parseSave} from '../src/core/save.js';\nimport {mulberry} from '../src/core/rng.js';\nimport {DIALOGUE} from '../src/data/dialogue.js';\nconst requested=process.argv.slice(2),groups=requested.length?requested:['full'],has=g=>groups.includes('full')||groups.includes(g),RENDER=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--use-vulkan=swiftshader','--use-angle=swiftshader'];let passed=0,failed=0;const failures=[];mkdirSync('notes',{recursive:true});\nfunction check(value,label){if(value)passed++;else{failed++;failures.push(label);console.log('FAIL '+label);}}\nasync function test(label,fn){try{await fn();}catch(e){check(false,label+': '+e.message);}}\nconst padScript=()=>{window.__pads=Array.from({length:4},(_,index)=>({connected:true,index,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0})),vibrationActuator:{playEffect:()=>Promise.resolve()}}));Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pads});};\nlet browser,page,errors=[];\nasync function open(opts={}){browser=await (opts.engine==='webkit'?webkit:opts.engine==='firefox'?firefox:chromium).launch({headless:true,args:opts.render&&opts.engine\"'!=='\"'webkit'?RENDER:[]});const context=await browser.newContext({viewport:{width:1280,height:720},...opts.context});await context.addInitScript(padScript);page=await context.newPage();errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto('file://'+resolve('game.html')+'?test=1'+(opts.real?'':'&manual=1')+(opts.render?'':'&render=0'));await page.waitForFunction(()=>window.__TEST__,{timeout:30000});return page;}\nasync function close(){await browser?.close();browser=null;page=null;}\nconst advance=async s=>page.evaluate(s=>__TEST__.advance(s),s),state=async()=>page.evaluate(()=>__TEST__.state());\nasync function key(key){await page.keyboard.press(key);await advance(.025);await advance(.2);}\nasync function click(name){await page.getByRole('button',{name,exact:true}).click();await advance(.2);}\nasync function padButton(n,index=0){await page.evaluate(({n,index})=>{__pads[index].buttons[n]={pressed:true,value:1};}, {n,index});await advance(.025);await page.evaluate(({n,index})=>{__pads[index].buttons[n]={pressed:false,value:0};},{n,index});await advance(.2);}\nasync function playEvent(id,tier=1){await page.evaluate(({id,tier})=>{__TEST__.goto('event',{id,tier,play:true});__TEST__.bot('sharp');},{id,tier});const duration=(await state()).event.duration;await advance(duration+10);await page.evaluate(()=>__TEST__.bot(null));return state();}\nif(has('unit'))await test('unit',async()=>{\n check(age(1,5)===18&&age(0,1)===99,'Wobble Age bounds');check(age(.6,1)>age(.6,5),'Age handicap shrinks');check(restTilt(0)===9&&restTilt(TOTAL_STEPS)===0,'Tilt tracks attendance');check(DAYS.flatMap(d=>d.events).length===14,'Fourteen programme activities');check(DAYS.every(d=>d.events.every(id=>EVENTS.some(e=>e.id===id))),'Programme registry integrity');check(new Set(EVENTS.map(e=>e.id)).size===14,'Unique activity IDs');check(medal(97)==='Suspicious'&&medal(85)==='Exemplary'&&medal(65)==='Pleasant'&&medal(40)==='Adequate'&&medal(0)==='Attended','Medal thresholds');check(payout(60,85,true)===7,'Marble payout');check(nextTier([65,0])===2&&nextTier([65,85])===3,'Tier unlocks');check(Object.values(TUNING).every(t=>t.default>=t.min&&t.default<=t.max),'Tuning bounds');check(PATTERNS.every(p=>p.length===8&&/\"'^[LRB<>''^v.]+$/.test(p)),'\"'Rhythm charts valid');check(chart(1).notes.length>50&&chart(2,true).duration<=50,'Rhythm lengths');check(parseSave('{bad').profiles.length===4&&parseSave('{\\\"version\\\":99}').profiles[0]===null,'Corrupt and old saves recover');let r=mulberry(55),s=mulberry(55);check(Array.from({length:40},()=>r()===s()).every(Boolean),'Seeded RNG repeatable');check(Object.values(DIALOGUE.Trudy).flat().length>=200,'Trudy dialogue coverage');check(DIALOGUE['Ms. Stillwater'].observe.length>=60&&DIALOGUE['Coach Bolster'].observe.length>=60&&DIALOGUE.Guests.observe.length>=60,'Cast dialogue coverage');\n let client=readFileSync('vendor/session.js','utf8'),end=\\\"})(typeof window \"'!== '\"'undefined' ? window : globalThis);\\\";check(createHash('sha256').update(client.slice(client.indexOf('/*\"'! aihub-session '\"'),client.indexOf(end)+end.length)).digest('hex')==='529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a','Hub client checksum');let html=readFileSync('game.html','utf8');check(html.includes('<meta charset=\\\"utf-8\\\"><script>/*\"'! aihub-session'\"'),'Client is first script');check(html.includes('<meta name=\\\"hub:session-mode\\\" content=\\\"ghost\\\">'),'Ghost meta declaration');check(\"'!/<script[''^>]+src=|<link[''^>]+href=/.test(html),'\"'Offline bundle');\n function sources(dir){return readdirSync(dir,{withFileTypes:true}).flatMap(f=>f.isDirectory()?sources(dir+'/'+f.name):f.name.endsWith('.js')?[dir+'/'+f.name]:[]);}for(let f of sources('src')){const source=readFileSync(f,'utf8');check(\"'!/Math'\"\\\\.random|TODO|FIXME|placeholder|\\\\bstub\\\\b|alert\\\\(|confirm\\\\(|prompt\\\\(|window\\\\.open|WebSocket|RTCPeerConnection|decodeAudioData/.test(source),'Source hygiene '+f);}\n if(existsSync('../exit-interview.json')){let j=JSON.parse(readFileSync('../exit-interview.json','utf8'));check(Object.keys(j).sort().join(',')==='aiHub,engineFeedback,promptFeedback,sourceInformation,testingFeedback','Interview top-level shape');check(Object.keys(j.sourceInformation).length===15&&j.sourceInformation.usage==='added on import','Interview source fields');check(j.testingFeedback.length===4&&j.engineFeedback.length===6&&j.promptFeedback.length===4,'Interview feedback lengths');check(j.aiHub.name===TITLE&&j.aiHub.tags.length>=3&&j.aiHub.tags.length<=6,'Catalogue title and tags');check(Object.entries(j).every(([k,v])=>typeof v==='object'),'Interview objects');}\n});\nif(has('flow'))await test('whole programme',async()=>{await open();check((await state()).screen==='title','Boot title');await click('Step into something wobbly');await click('Begin your stay');await page.getByRole('button',{name:/A new guest/}).first().click();await advance(.2);await click('This is me');await advance(.5);await key('Enter');for(let axes of [[-.85,0],[.85,0],[0,-.85]]){await page.evaluate(a=>{__pads[0].axes[0]=a[0];__pads[0].axes[1]=a[1];},axes);await advance(1);}await page.evaluate(()=>{__pads[0].axes=[0,0,0,0];});await advance(.5);await key('Enter');await advance(.5);await key('Enter');check((await state()).screen==='question','Arrival and three leans lead to morning question');let lastMarbles=0,lastTilt=9;const visits=[];\n for(let day=1;day<=5;day++){let screen=(await state()).screen;if(screen==='speech'){await advance(.5);await key('Enter');}await click('Yes');await advance(.5);await key('Enter');await click('Begin Check-In');await page.evaluate(()=>__TEST__.bot('sharp'));await advance(100);await page.evaluate(()=>__TEST__.bot(null));check((await state()).screen==='age','Day '+day+' Check-In age reveal');await advance(3);await click('A distinguished start');await advance(1);await click('Lovely');check((await state()).day===day,'Day '+day+' recorded');for(let id of DAYS[day-1].events){await click(EVENTS.find(e=>e.id===id).title);await click('Let’s try');await page.evaluate(()=>__TEST__.bot('sharp'));const duration=(await state()).event.duration;await advance(duration+20);await page.evaluate(()=>__TEST__.bot(null));let s=await state();check(s.screen==='results','Programme '+id+' reaches results: '+s.screen);check(Number.isFinite(s.event?.lanes[0].form),'Programme '+id+' valid score');visits.push(id);await click('Continue');s=await state();check(s.marbles>lastMarbles,'Marbles rise after '+id);check(s.tilt<lastTilt,'Island straightens after '+id);lastMarbles=s.marbles;lastTilt=s.tilt;if(id\"'!=='\"'grand'){await advance(2);await click('Lovely');}}\n if(day<5){await click('Go to bed');await click('Good night');await advance(3);check((await state()).day===day+1,'Bed advances day '+day);}}\n check(new Set(visits).size===14,'Whole programme visits every event');check((await state()).tilt===0&&(await state()).profile.levelled,'Final island level');await advance(20);await click('A very small curtain call');check((await state()).screen==='about','Ending credits');await click('Same time tomorrow');check((await state()).day===6,'Maintenance day unlocked');await page.evaluate(()=>{__TEST__.goto('menu');__game.freePlay();});check(await page.getByText('Choose a little wobble.').count()>0,'Free Play after ending');check((await state()).errors.length===0&&errors.length===0,'Whole programme no errors');writeFileSync('notes/flow-result.json',JSON.stringify(await state(),null,2));await close();});\nif(has('events'))await test('all events and tiers',async()=>{await open();await page.evaluate(()=>__TEST__.goto('profile'));const scores={};for(let event of EVENTS){scores[event.id]=[];for(let tier=1;tier<=3;tier++){const s=await playEvent(event.id,tier);check(s.screen==='results',event.id+' tier '+tier+' completes: '+s.screen);const lane=s.event?.lanes[0];check(lane&&Number.isFinite(lane.form)&&lane.form>=0&&lane.form<=100,event.id+' tier '+tier+' finite form');scores[event.id].push({form:lane?.form,falls:lane?.falls,data:lane?.data});check(\"'!s.errors.length,event.id+'\"' no runtime errors');}if(\"'!['\"'spring','raft','grand'].includes(event.id)){await page.evaluate(id=>{__TEST__.goto('event',{id,play:true});__game.event.lanes[0].balancer.fall();},event.id);await advance(3);let s=await state();check(s.event.lanes[0].fallen===0,event.id+' ragdoll recovers');check(Number.isFinite(s.event.lanes[0].leanX),event.id+' recovery finite');}await page.evaluate(()=>__TEST__.goto('menu'));}check(errors.length===0,'All events page errors');writeFileSync('notes/event-scores.json',JSON.stringify(scores,null,2));await close();});\nif(has('input'))await test('input paths',async()=>{await open();await padButton(0);check((await state()).screen==='menu','Pad opens menu');await padButton(0);check((await state()).screen==='profiles','Pad selects programme');await page.evaluate(()=>__TEST__.goto('profile'));await page.evaluate(()=>__TEST__.goto('event',{id:'poses',play:true}));await page.keyboard.down('d');await advance(.25);await page.keyboard.up('d');let ring=await page.evaluate(()=>__game.input.ring.x);await advance(.2);check(Math.abs((await page.evaluate(()=>__game.input.ring.x))-ring)<.01&&ring>.3,'Sticky keyboard asking ring');await key('c');check(Math.abs((await page.evaluate(()=>__game.input.ring.x)))<.05,'C recentres');await page.keyboard.press('q');await advance(.01);check((await state()).input.leftPress,'Fast foot tap latched');await page.mouse.move(900,400);await advance(.02);check((await state()).input.x>.5,'Mouse analog weight');await page.mouse.down({button:'left'});await page.mouse.down({button:'right'});await advance(.15);check((await state()).input.left>.9&&(await state()).input.right>.9,'Mouse bitmask two feet');await page.mouse.up({button:'left'});await page.mouse.up({button:'right'});await page.evaluate(()=>{__pads[0].axes=[.7,0,0,0];});await advance(.02);check((await state()).input.lastDevice==='pad','Pad takes ownership');check(await page.locator('[data-glyph\"'^=\"PlayStation\"]'\"').count()>0,'PlayStation glyphs');await page.evaluate(()=>__TEST__.settings.glyphs='Xbox');await advance(.02);check(await page.locator('[data-glyph\"'^=\"Xbox\"]'\"').count()>0,'Xbox glyphs');await page.evaluate(()=>{__pads[0].axes=[0,0,0,0];__pads[0].buttons[8]={pressed:true,value:1};});await padButton(9);check((await state()).screen==='play','Create + Options ignored');await page.evaluate(()=>__pads[0].buttons[8]={pressed:false,value:0});await padButton(9);check((await state()).screen==='pause','Options pauses');let world=(await state()).event.t;await advance(2);check((await state()).event.t===world,'Pause freezes physics');await click('Dev Mode');check((await state()).screen==='dev','Dev from pause');await click('Live tuning');let before=await page.evaluate(()=>__TEST__.tuning.maxLean);await key('ArrowRight');check((await page.evaluate(()=>__TEST__.tuning.maxLean))>before,'Controller style tuning slider');await click('Reset to defaults');check((await page.evaluate(()=>__TEST__.tuning.maxLean))===18,'Tuning reset');await page.evaluate(()=>__TEST__.goto('group'));for(let i=0;i<4;i++)await padButton(0,i);check(await page.evaluate(()=>__game.groupSeats.length)===4,'Four pads join');await page.evaluate(()=>__game.startGroup(['fruit','poses','step']));check((await state()).event.lanes.length===4,'Four independent lanes');check(errors.length===0,'Input no page errors');await close();});\nif(has('attract'))await test('attract',async()=>{await open();await advance(10.1);check((await state()).attract,'Attract after ten simulation seconds');let seen=new Set();for(let i=0;i<7;i++){seen.add((await state()).attractId);await advance(18);}check(seen.size>=6,'Attract visits six activities');await key('Enter');check(\"'!(await state()).attract&&(await state()).screen==='\"'title','Attract exit input swallowed');await close();await open({real:true});await page.waitForTimeout(10600);check((await state()).attract,'Attract after ten wall-clock seconds');await close();});\nif(has('render'))await test('WebGPU render',async()=>{await open({render:true,real:true,context:{viewport:{width:1280,height:720}}});await page.waitForTimeout(3000);let s=await state();check(s.render.backend==='webgpu','WebGPU backend');check(\"'!s.render.lost,'\"'GPU alive on title');check(s.render.frames>1,'Real rendered frames');mkdirSync('shots',{recursive:true});await page.screenshot({path:'shots/title.png'});await page.evaluate(()=>__TEST__.goto('profile'));await page.waitForTimeout(2000);await page.screenshot({path:'shots/island.png'});for(let id of EVENTS.map(e=>e.id)){await page.evaluate(id=>{__TEST__.goto('event',{id,play:true});__game.dev.bot=true;},id);await page.waitForTimeout(1500);s=await state();check(s.render.lost===null,'GPU alive '+id);check(\"'!s.errors.length,'\"'Render no errors '+id);}check(errors.length===0,'Rendered page errors');await close();});\nif(has('ui'))await test('touch and fallback',async()=>{for(const name of ['iPhone SE (3rd gen)','iPad Pro 11','Pixel 7']){await open({engine:name.startsWith('i')?'webkit':undefined,context:{...devices[name]}});check(await page.getByText('Controller or keyboard required',{exact:true}).count()===1,name+' touch-only message');await page.getByRole('button',{name:'Settings',exact:true}).tap();await advance(.2);check((await state()).screen==='settings',name+' settings tap');const overflow=await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth);check(\"'!overflow,name+'\"' no horizontal overflow');await close();}await open({engine:'webkit',render:true,real:true});await page.waitForTimeout(2000);let s=await state();check(s.render.backend==='webgl2'&&\"'!s.render.lost,'\"'WebKit WebGL2 fallback');check(errors.length===0,'WebKit no page errors');await close();});\nif(has('audio'))await test('audio',async()=>{await open();check((await state()).audio.music===10,'Music defaults to ten percent');await key('Enter');let values=await page.evaluate(()=>({state:__game.audio.ctx?.state,gain:__game.audio.buses?.music.gain.value}));check(values.gain===.1,'Music bus gain 0.10');await close();});\nif(has('hub'))await test('hub harness',async()=>{let server=createServer((req,res)=>{let url=new URL(req.url,'http://127.0.0.1'),p=url.pathname;if(p==='/game.html')p='/game.html';else if(['/harness.html','/bridge.js','/round.js'].includes(p))p='/tools/hub'+p;else if(p==='/favicon.ico'){res.writeHead(204);res.end();return;}try{let data=readFileSync(resolve('.'+p));res.setHeader('Content-Type',p.endsWith('.js')?'text/javascript':'text/html');res.end(data);}catch{res.writeHead(404);res.end();}});await new Promise(r=>server.listen(0,'127.0.0.1',r));let base='http://127.0.0.1:'+server.address().port;check((await (await fetch(base+'/game.html')).text()).includes('<title>'+TITLE),'Server serves this game');try{for(let query of ['players=1','players=2','players=4&latency=150&jitter=50&loss=5','players=4&latency=150&jitter=50&loss=5&scenario=host-leave']){browser=await chromium.launch({headless:true,args:[...RENDER,'--no-sandbox','--autoplay-policy=no-user-gesture-required']});page=await browser.newPage({viewport:{width:1280,height:720}});await page.goto(base+'/harness.html?game=game.html&auto=1&'+query);await page.waitForSelector('body[data-complete=\\\"true\\\"]',{timeout:100000});let result=await page.evaluate(()=>window.__hubCheck);writeFileSync('notes/hub-'+query.replace(/[\"'^a-z0-9]/gi,'\"'-')+'.json',JSON.stringify(result,null,2));check(result.pass,'Hub '+query+' '+JSON.stringify(result));await close();}}finally{await close();await new Promise(r=>server.close(r));}});\nawait close();writeFileSync('notes/test-last.json',JSON.stringify({groups,passed,failed,failures},null,2));console.log(\"'`${passed} passed, ${failed} failed`);process.exitCode=failed?1:0;\nEOF\nnode tools/test.mjs unit flow events input attract audio'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"cat >> PROGRESS.md <<'EOF'\n\n## Implementation checkpoint 3\n- Director and all game screens implemented: title, profile/name/paint, arrival/tutorial, questions, Check-In, age reveal, day plans, walking hub, results, physical marble jar, bed, tier ladder, Journal, Mirror, settings, About, ending/Maintenance.\n- Couch lobby/three-event playlists/points/podium and AI Hub ghost sessions implemented. Session client connects before engine work; own Ready card, clock-based three slots, progress/ghost traffic from time zero, leave/time-up/end handlers.\n- Attract cycles real bots through island and all classes; input exits and is swallowed. Dev tools and live sliders implemented, isolated from session play.\n- Main boot switched to full Director. Build succeeds at 3.15 MB.\n- Comprehensive one-command test runner written. Currently running \"'`node tools/test.mjs unit flow events input attract audio`; results will inform next fixes.\n- Pending: calibrate balance scores, fix integrated test failures, run render/WebKit/mobile/large-screen/hub checks and inspect screenshots, finish precise metadata/credits/report.\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
