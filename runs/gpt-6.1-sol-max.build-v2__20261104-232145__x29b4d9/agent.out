dt;d.alive+=dt;if(p.energy<=0){p.down=6;d.crashes++;this.shatter(l,p.index);this.game.audio.sfx('crash');}}l.score=Math.max(0,200*d.alive/(Math.max(.001,d.total)*d.plates.length)-100);this.message=\"'`${d.omega.toFixed(1)} rad/s · Large 4 · Medium 7 · Small 10`;break;}\n case '\"'service':{const length=[30,45,60][tier-1];let press=input.leftPress?1:input.rightPress?2:0;if(press){if(press===d.lastFoot){d.penalty++;b.body.applyTorqueImpulse({x:0,y:0,z:.02},true);}else{d.lastStep=t;d.steps++;d.rock=t+.18;d.lastFoot=press;this.game.audio.sfx('foot');}}let wanted=t-d.lastStep<.672?.55/.42:0;d.speed+=(wanted-d.speed)*(1-Math.exp(-dt/.5));d.distance+=d.speed*dt;l.x+=b.leanX*.25*d.speed*dt;l.z=-d.distance;b.setFoot(l.x,0,l.z);l.target={x:0,z:0,r:.25};if(Math.abs(l.x-((l.id-(this.lanes.length-1)/2)*3.2))>.8){d.glasses=Math.max(0,d.glasses-1);l.x=(l.id-(this.lanes.length-1)/2)*3.2;this.dropGlass(l);this.game.fx('SPLOSH\"'!'\"',l.x,1,l.z);this.game.audio.sfx('splash');}\n let force=tuning.gustForce+(tier-1)*.55;if(t>d.nextGust-1&&t<d.nextGust+.5){l.target.x=-.2*force*d.gustDir;this.message=t<d.nextGust?'Wind coming. Lean toward the green zone.':'A small, early lean.';if(t>=d.nextGust)l.dist.nx=force*d.gustDir;}else this.message='Alternate feet. Keep the glasses.';if(t>d.nextGust+.5){d.nextGust=t+([7,6,5][tier-1]);d.gustDir*=-1;}if(t<d.rock)l.dist.nx=(l.dist.nx||0)+.2*(d.lastFoot===1?-1:1);l.dist.sway=.03;d.glasses=l.glasses.filter(p=>p.active).length;for(let p of l.glasses)if(p.active&&p.body.translation().y<.7){this.disable(p);this.game.audio.sfx('clack');}l.score=d.glasses*100;if(d.distance>=length){l.finished=true;if(this.lanes.length===1||this.lanes.every(l=>l.finished))this.finish();else if(\"'!this.finishBy)this.finishBy=t+15;}if(this.finishBy&&t>this.finishBy)this.finish();break;}\n case '\"'loop':{let press=input.leftPress?1:input.rightPress?2:0;if(press&&press\"'!==d.lastFoot){let cadence=t-d.lastStep;d.speed=clamp(1.4/Math.max(.2,cadence),0,6);d.lastStep=t;d.lastFoot