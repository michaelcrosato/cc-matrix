{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/input/input.js';s=open(p).read().replace(\\\"plateTap:this.pressed('a','d','left','right')\\\",\\\"plateTap:this.pressed('a','d','left','right'),plateDir:this.pressed('a','left')?-1:this.pressed('d','right')?1:0\\\");open(p,'w').write(s)\nPY\ncat > src/events/training.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {EventBase} from './base.js';\nimport {R,PROP,rigid} from '../physics/world.js';\nimport {POSES} from '../data/poses.js';\nimport {chart} from '../data/charts.js';\nimport {clamp,lerp,rad} from '../data/config.js';\nimport {tuning} from '../data/tuning.js';\nimport {box,ball,cyl,torus,group,mesh,glass,label} from '../art/materials.js';\nimport {stone,tray,bunting} from '../art/props.js';\nimport {gull,doll} from '../art/cast.js';\nconst meter=(p,c='#83ac88')=>\"'`<div class=\"meter\"><span style=\"width:${clamp(p)*100}%;background:${c}\"></span></div>`;\nexport class TrainingEvent extends EventBase{\n balanceOptions(){if(['\"'cairn','log','service'].includes(this.id))return {margin:.8,ankleMax:6,...this.id==='service'?{reflex:5}:{}};if(this.id==='poses')return {maxLean:14};return {};}\n buildSet(){super.buildSet();if(this.id==='step'){this.chart=chart(this.tier,this.options.session);if(\"'!this.options.session)this.duration=this.chart.duration;this.classGuests=[];for(let i=0;i<8;i++){let d=doll(['\"'#91b6a1','#e9af6a','#ac8db4','#75a6bc'][i%4],i%4);d.root.position.set((i%4-1.5)*1.35,0,-2.3-Math.floor(i/4)*1.4);d.root.scale.setScalar(.78);this.group.add(d.root);this.classGuests.push(d);}this.game.view.sun.color.set(0xffcdaf);}\n if(this.id==='water'){let pond=cyl(this.group,0x6ca6a2,0,.02,0,5,.03);for(let i=0;i<9;i++){let p=cyl(this.group,0x94b69b,Math.sin(i*2)*4,.06,Math.cos(i*2)*4,.4,.035);if(i%3===0)ball(this.group,0xe9b9b5,p.position.x,.16,p.position.z,.16,1,.5,1);}}\n if(this.id==='plank')box(this.group,0xcbb38b,0,.1,0,