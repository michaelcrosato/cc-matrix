PI/2;return root;}\nexport function walrus(){let root=group();let body=mesh(new T.CapsuleGeometry(.64,.4,8,24),0xb9806a,root,0,.9,0);body.scale.set(1.08,1,.9);for(let s of [-1,1]){ball(root,0x8d5f4f,s*.63,.42,.05,.32,.4,.35,1.2);ball(root,0xe6c3a0,s*.18,1.28,.51,.22);ball(root,INK,s*.23,1.53,.46,.035);let tusk=mesh(new T.ConeGeometry(.075,.34,12),0xfff1cc,root,s*.22,1.02,.59);tusk.rotation.z=Math.PI;}let band=torus(root,0xd85f56,0,1.64,0,.42,.065);band.rotation.x=Math.PI/2;let lanyard=torus(root,0xf7eace,0,.97,.52,.24,.015);lanyard.scale.y=1.3;box(root,0xe9be4b,0,.65,.59,.14,.16,.08);return root;}\nexport function gull(){let root=group();ball(root,0xfff7e6,0,.16,0,.18,1,1,1.3);for(let s of [-1,1]){let wing=ball(root,0xadc0c7,s*.2,.2,0,.22,1.7,.15,.65);wing.name=s<0?'wingL':'wingR';ball(root,INK,s*.105,.25,.14,.022);}let beak=mesh(new T.ConeGeometry(.045,.16,8),0xe2b04a,root,0,.19,.27);beak.rotation.x=Math.PI/2;return root;}\nEOF\ncat > src/physics/world.js <<'EOF'\nimport R from '@dimforge/rapier3d-compat';\nexport {R};\nexport const GROUND=1,RAG=0x1000;\nexport const groups=(member,filter)=>(member<<16)|filter;\nexport const DOLL=i=>groups(0x100<<i,0x10<<i);\nexport const PROP=i=>groups(0x10<<i,1|(0x10<<i)|(0x100<<i));\nexport function makeWorld(gravity=9.81){const w=new R.World({x:0,y:-gravity,z:0});w.timestep=1/120;w.integrationParameters.numSolverIterations=10;w.createCollider(R.ColliderDesc.cuboid(200,.15,200).setTranslation(0,-.15,0).setCollisionGroups(groups(1,0xffff)).setFriction(.9));return w;}\nexport function rigid(w,shape,xyz,mass=.02,lane=0){let desc=R.RigidBodyDesc.dynamic().setTranslation(...xyz).setCanSleep(false).setLinearDamping(.1).setAngularDamping(.6).setCcdEnabled(true);let b=w.createRigidBody(desc);w.createCollider(shape.setMass(mass).setCollisionGroups(PROP(lane)).setFriction(.9).setRestitution(0),b);return b;}\nEOF\ncat > src/physics/ragdoll.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {R,groups,RAG} from './world.js';\nimport {mesh,ball,mat} from '../art/materials.js';\nexport class Ragdoll{\n constructor(w,scene,colour){this.w=w;this.scene=scene;this.colour=colour;this.parts=[];}\n spawn(x,y,z,rotation){this.active=true;if(\"'!this.parts.length){const parts=[['\"'torso',[0,.85,0],.2,.2,.45,-1],['head',[0,1.28,0],.02,.21,.15,0],['armL',[-.32,.83,0],.12,.07,.05,0],['handL',[-.4,.55,0],.1,.065,.04,2],['armR',[.32,.83,0],.12,.07,.05,0],['handR',[.4,.55,0],.1,.065,.04,4],['thighL',[-.13,.4,0],.12,.09,.08,0],['legL',[-.13,.15,0],.12,.08,.06,6],['thighR',[.13,.4,0],.12,.09,.08,0],['legR',[.13,.15,0],.12,.08,.06,8]];for(const [name,p,hh,r,m,parent] of parts){let b=this.w.createRigidBody(R.RigidBodyDesc.dynamic().setTranslation(x+p[0],y+p[1],z+p[2]).setCanSleep(false).setLinearDamping(.05).setAngularDamping(.6));this.w.createCollider(R.ColliderDesc.capsule(hh,r).setMass(m).setFriction(.7).setRestitution(.15).setCollisionGroups(groups(RAG,1)),b);let v=mesh(new T.CapsuleGeometry(r,hh*2,4,12),name==='torso'?this.colour:0xf2d3a8,this.scene);this.parts.push({b,v,p,parent});if(parent>=0){let pp=parts[parent][1],mid=p.map((n,k)=>(n+pp[k])*.5);const j=this.w.createImpulseJoint(R.JointData.spherical({x:mid[0]-pp[0],y:mid[1]-pp[1],z:mid[2]-pp[2]},{x:mid[0]-p[0],y:mid[1]-p[1],z:mid[2]-p[2]}),this.parts[parent].b,b,true);j.setContactsEnabled(false);}}}\n for(const p of this.parts){p.b.setEnabled(true);const off=new T.Vector3(...p.p).applyQuaternion(rotation);p.b.setTranslation({x:x+off.x,y:y+off.y,z:z+off.z},true);p.b.setRotation(rotation,true);p.b.setLinvel({x:0,y:0,z:0},true);p.b.setAngvel({x:0,y:0,z:0},true);p.v.visible=true;}this.parts[1].b.applyImpulse({x:.07,y:.02,z:.06},true);}\n frame(){for(const {b,v} of this.parts){v.position.copy(b.translation());v.quaternion.copy(b.rotation());}}\n hide(){this.active=false;for(const p of this.parts){p.b.setEnabled(false);p.v.visible=false;}}\n}\nEOF\ncat > src/physics/balancer.js <<'EOF'\nimport {R,DOLL} from './world.js';\nimport {tuning} from '../data/tuning.js';\nimport {rad,DIFFICULTY} from '../data/config.js';\nimport {Ragdoll} from './ragdoll.js';\nexport class Balancer{\n constructor(w,lane,doll,scene,settings,opts={}){this.w=w;this.lane=lane;this.doll=doll;this.settings=settings;this.opts=opts;this.x=opts.x||0;this.y=opts.y||0;this.z=opts.z||0;this.foot=w.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(this.x,this.y,this.z));this.body=w.createRigidBody(R.RigidBodyDesc.dynamic().setTranslation(this.x,this.y+.75,this.z).setCanSleep(false).setAdditionalSolverIterations(4));w.createCollider(R.ColliderDesc.capsule(.5,.25).setMass(1).setCollisionGroups(DOLL(lane)),this.body);this.joint=w.createImpulseJoint(R.JointData.spherical({x:0,y:0,z:0},{x:0,y:-.75,z:0}),this.foot,this.body,true);this.joint.setContactsEnabled(false);this.wx=this.wz=this.leanX=this.leanZ=0;this.cob={x:0,z:0};this.flail=0;this.cooldown=0;this.fallen=0;this.falls=0;this.t=0;this.breathGood=0;this.breathTotal=0;this.breathBonus=false;this.ragdoll=new Ragdoll(w,scene,doll.root.userData.colour||'#e76b57');}\n setFoot(x,y,z){this.x=x;this.y=y;this.z=z;this.foot.setNextKinematicTranslation({x,y,z});}\n fixed(dt,input,dist={}){this.t+=dt;this.flail=Math.max(0,this.flail-dt);this.cooldown=Math.max(0,this.cooldown-dt);\n if(this.fallen>0){this.fallen-=dt;if(this.fallen<=0)this.recover();return;}\n if(input.flailPress&&this.cooldown<=0){this.flail=.35;this.cooldown=tuning.flailCooldown;this.onFlail?.();}\n const still=dist.still;const inhale=this.t%8<4;const breathe=this.settings.autoBreathe||input.breathe;if(still){this.breathTotal+=dt;if(breathe===inhale)this.breathGood+=dt;if(this.breathTotal>=8){this.breathBonus=this.breathGood/this.breathTotal>=.7;this.breathTotal=this.breathGood=0;}}\n const o=this.opts,diff=DIFFICULTY[this.settings.difficulty]||DIFFICULTY.Standard;\n const maxLean=rad(o.maxLean||tuning.maxLean);this.maxLean=maxLean;\n let margin=(o.margin??tuning.margin)*(dist.oneFoot?.5:1),G=tuning.gravity*.75,I=.75*.75+.06,K=G*(1+margin),wn=Math.sqrt((K-G)/I),D=2*tuning.zeta*wn*I;\n const r=1-Math.exp(-(o.reflex||tuning.reflex)*dt);this.wx+=(input.x-this.wx)*r;this.wz+=(input.z-this.wz)*r;\n let tx=this.wx*maxLean,tz=this.wz*maxLean,q=this.body.rotation(),ux=2*(q.x*q.y-q.w*q.z),uy=1-2*(q.x*q.x+q.z*q.z),uz=2*(q.y*q.z+q.w*q.x);\n this.leanX=Math.atan2(ux,uy);this.leanZ=Math.atan2(uz,uy);this.cob.x=this.leanX/maxLean;this.cob.z=this.leanZ/maxLean;\n let ang=this.body.angvel(),Tx=-(G*Math.sin(tx)+K*(this.leanX-tx))+D*ang.z,Tz=-(G*Math.sin(tz)+K*(this.leanZ-tz))-D*ang.x;\n let limit=(o.ankleMax||tuning.ankleMax)*diff.ankle*(this.flail>0?tuning.flailBoost:1),m=Math.hypot(Tx,Tz);if(m>limit){Tx*=limit/m;Tz*=limit/m;}\n let sway=(dist.sway??.1)*tuning.swayScale,tremor=(dist.tremor??.06)*tuning.tremorScale,t=this.t,ph=this.lane*1.77+1.26;let bonus=this.breathBonus&&still?.6:1;\n let nx=(sway*(Math.sin(t*.9+ph)*.6+Math.sin(t*1.73+ph*2.1)*.4)+tremor*(Math.sin(t*8.2+1.1)*.6+Math.sin(t*18.3)*.4))*diff.disturbance*bonus+(dist.nx||0);\n let nz=(sway*(Math.sin(t*.77+ph*1.7)*.6+Math.sin(t*1.51+ph*.6)*.4)+tremor*(Math.sin(t*7.1+2.3)*.6+Math.sin(t*15.7+.7)*.4))*diff.disturbance*bonus+(dist.nz||0);\n this.body.resetTorques(true);this.body.addTorque({x:Tz+nz,y:-ang.y*.6,z:-(Tx+nx)},true);\n if(\"'!this.god&&!dist.noFalls&&Math.hypot(this.leanX,this.leanZ)>rad(tuning.fallAngle))this.fall();\n }\n fall(){if(this.fallen>0)return;this.falls++;this.fallen=tuning.recoverTime;this.body.setEnabled(false);this.doll.root.visible=false;this.ragdoll.spawn(this.x,this.y,this.z,this.body.rotation());this.onFall?.();}\n recover(){this.fallen=0;this.ragdoll.hide();this.doll.root.visible=true;this.body.setEnabled(true);this.body.setTranslation({x:this.x,y:this.y+.75,z:this.z},true);this.body.setRotation({x:0,y:0,z:0,w:1},true);this.body.setLinvel({x:0,y:0,z:0},true);this.body.setAngvel({x:0,y:0,z:0},true);this.body.resetTorques(true);this.leanX=this.leanZ=this.wx=this.wz=this.cob.x=this.cob.z=0;this.onRecover?.();}\n frame(dt){this.doll.anim.update(dt);if(this.fallen>0){this.ragdoll.frame();return;}this.doll.root.position.set(this.x,this.y,this.z);this.doll.root.quaternion.copy(this.body.rotation());if(this.flail>0)this.doll.anim.play('\"'flail');this.doll.joints.head.rotation.z+=Math.sin(this.t*4)*.015;}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cat > src/art/materials.js <<'EOF'\nimport * as T from 'three/webgpu';\nexport const INK=0x26232e;\nconst ramp=new T.DataTexture(new Uint8Array([100,180,255]),3,1,T.RedFormat);ramp.minFilter=ramp.magFilter=T.NearestFilter;ramp.colorSpace=T.NoColorSpace;ramp.needsUpdate=true;\nconst cache=new Map();\nexport function mat(colour){if(\"'!cache.has(colour))cache.set(colour,new T.MeshToonNodeMaterial({color:colour,gradientMap:ramp}));return cache.get(colour);}\nexport const glass=new T.MeshBasicNodeMaterial({color:0xd7f4f5,transparent:true,opacity:.17,side:T.DoubleSide,depthWrite:false});\nexport function mesh(g,c,parent,x=0,y=0,z=0){const m=new T.Mesh(g,typeof c==='\"'object'?c:mat(c));m.position.set(x,y,z);m.castShadow=m.receiveShadow=true;parent?.add(m);return m;}\nexport function box(p,c,x,y,z,w,h,d,r=0){const m=mesh(new T.BoxGeometry(w,h,d),c,p,x,y,z);m.rotation.y=r;return m;}\nexport function ball(p,c,x,y,z,r,sx=1,sy=1,sz=1){const m=mesh(new T.SphereGeometry(r,18,12),c,p,x,y,z);m.scale.set(sx,sy,sz);return m;}\nexport function cyl(p,c,x,y,z,r,h,rt=r){return mesh(new T.CylinderGeometry(rt,r,h,32),c,p,x,y,z);}\nexport function torus(p,c,x,y,z,r,tube=.025){return mesh(new T.TorusGeometry(r,tube,8,48),c,p,x,y,z);}\nexport function group(parent,x=0,y=0,z=0){const g=new T.Group();g.position.set(x,y,z);parent?.add(g);return g;}\nexport function beam(p,c,a,b,r=.04){let mid=new T.Vector3().addVectors(new T.Vector3(...a),new T.Vector3(...b)).multiplyScalar(.5);let v=new T.Vector3(...b).sub(new T.Vector3(...a));let m=cyl(p,c,...mid.toArray(),r,v.length());m.quaternion.setFromUnitVectors(new T.Vector3(0,1,0),v.normalize());return m;}\nexport function label(text,colour='#302a35',bg=null,size=1){const can=document.createElement('canvas');can.width=768;can.height=160;const ctx=can.getContext('2d');if(bg){ctx.fillStyle=bg;ctx.fillRect(0,0,768,160);}ctx.fillStyle=colour;ctx.textAlign='center';ctx.textBaseline='middle';ctx.font='600 70px Fredoka, sans-serif';ctx.fillText(text,384,82,740);let tex=new T.CanvasTexture(can);tex.colorSpace=T.SRGBColorSpace;let m=new T.Sprite(new T.SpriteMaterial({map:tex,depthTest:true}));m.scale.set(size*4.8,size,1);return m;}\nEOF\ncat > src/anim/clips.js <<'EOF'\nimport * as T from 'three/webgpu';\nconst q=(x=0,y=0,z=0)=>new T.Quaternion().setFromEuler(new T.Euler(x*Math.PI/180,y*Math.PI/180,z*Math.PI/180)).toArray();\nexport function poseClip(name,duration,frames){const joints=new Set(frames.flatMap(f=>Object.keys(f.pose)));let tracks=[];for(const joint of joints){let times=[],values=[];for(const f of frames){times.push(f.t);values.push(...q(...(f.pose[joint]||[0,0,0])));}tracks.push(new T.QuaternionKeyframeTrack(joint+'.quaternion',times,values));}return new T.AnimationClip(name,duration,tracks);}\nconst f=(t,pose)=>({t,pose});\nexport function dollClips(){const idle={shoulderL:[0,0,10],shoulderR:[0,0,-10],hipL:[0,0,0],hipR:[0,0,0],spine:[0,0,0],head:[0,0,0]};const clips=[\n poseClip('idle',3,[f(0,idle),f(1.5,{...idle,head:[0,4,2],spine:[-2,0,0]}),f(3,idle)]),\n poseClip('walk',.7,[f(0,{...idle,hipL:[28,0,0],hipR:[-28,0,0],shoulderL:[-22,0,8],shoulderR:[22,0,-8]}),f(.35,{...idle,hipL:[-28,0,0],hipR:[28,0,0],shoulderL:[22,0,8],shoulderR:[-22,0,-8]}),f(.7,{...idle,hipL:[28,0,0],hipR:[-28,0,0],shoulderL:[-22,0,8],shoulderR:[22,0,-8]})]),\n poseClip('cheer',.8,[f(0,{...idle,shoulderL:[0,0,140],shoulderR:[0,0,-140]}),f(.4,{...idle,shoulderL:[0,0,165],shoulderR:[0,0,-165],head:[0,0,5]}),f(.8,{...idle,shoulderL:[0,0,140],shoulderR:[0,0,-140]})]),\n poseClip('flail',.3,[f(0,{...idle,shoulderL:[0,0,90],shoulderR:[0,0,-90]}),f(.15,{...idle,shoulderL:[170,0,90],shoulderR:[-170,0,-90]}),f(.3,{...idle,shoulderL:[0,0,90],shoulderR:[0,0,-90]})]),\n poseClip('slab',2,[f(0,{...idle,shoulderL:[0,0,160],shoulderR:[0,0,-160],elbowL:[0,0,-20],elbowR:[0,0,20]}),f(2,{...idle,shoulderL:[0,0,160],shoulderR:[0,0,-160]})]),\n poseClip('t