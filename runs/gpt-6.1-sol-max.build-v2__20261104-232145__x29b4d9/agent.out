{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='tools/test.mjs';s=open(p).read();pos=s.index(\\\"if(has('balance'))\\\")\ndiag='''if(has('fruit'))await test('fruit tuning',async()=>{await open();await page.evaluate(()=>__TEST__.goto('profile'));let report=[];for(let cfg of [{margin:.45,ankle:4.6,aim:1},{margin:.6,ankle:5,aim:1},{margin:.45,ankle:4.6,aim:.7},{margin:.6,ankle:5,aim:.7},{margin:.65,ankle:5.4,aim:.7}]){let runs=[];for(let seed of [11,23,47]){let result=await page.evaluate(({cfg,seed})=>{__TEST__.seed(seed);__TEST__.goto('event',{id:'fruit',play:true});let e=__game.event,l=e.lanes[0];l.balancer.opts.margin=cfg.margin;l.balancer.opts.ankleMax=cfg.ankle;const goal=e.botGoal.bind(e);e.botGoal=lane=>{let a=goal(lane);return {x:a.x*cfg.aim,z:a.z*cfg.aim};};let falls=[],original=e.onFall.bind(e);e.onFall=lane=>{falls.push({t:e.t,caught:lane.data.caught,input:lane.input,cob:{...lane.balancer.cob},fruit:lane.fruit.filter(f=>f.active&&f.caught&&\"'!f.spent).map(f=>({type:f.type,pos:f.body.translation(),mass:f.body.mass()}))});original(lane);};__TEST__.bot('\"'sharp');__TEST__.advance(61);__TEST__.bot(null);return {form:l.form,score:l.score,banked:l.data.banked,falls};},{cfg,seed});runs.push(result);}report.push({cfg,runs});}writeFileSync('notes/fruit-tuning.json',JSON.stringify(report,null,2));check(report.length===5,'Fruit candidate runs finite');await close();});\n'''\ns=s[:pos]+diag+s[pos:];open(p,'w').write(s)\nPY\nnode tools/test.mjs fruit\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
