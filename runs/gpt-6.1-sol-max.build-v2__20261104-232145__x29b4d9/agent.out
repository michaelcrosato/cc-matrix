{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/input/input.js';s=open(p).read().replace(\\\"plateTap:this.pressed('a','d','left','right')\\\",\\\"plateTap:this.pressed('a','d','left','right'),plateDir:this.pressed('a','left')?-1:this.pressed('d','right')?1:0\\\");open(p,'w').write(s)\nPY\ncat > src/events/training.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {EventBase} from './base.js';\nimport {R,PROP,rigid} from '../physics/world.js';\nimport {POSES} from '../data/poses.js';\nimport {chart} from '../data/charts.js';\nimport {clamp,lerp,rad} from '../data/config.js';\nimport {tuning} from '../data/tuning.js';\nimport {box,ball,cyl,torus,group,mesh,glass,label} from '../art/materials.js';\nimport {stone,tray,bunting} from '../art/props.js';\nimport {gull,doll} from '../art/cast.js';\nconst meter=(p,c='#83ac88')=>\"'`<div class=\"meter\"><span style=\"width:${clamp(p)*100}%;background:${c}\"></span></div>`;\nexport class TrainingEvent extends EventBase{\n balanceOptions(){if(['\"'cairn','log','service'].includes(this.id))return {margin:.8,ankleMax:6,...this.id==='service'?{reflex:5}:{}};if(this.id==='poses')return {maxLean:14};return {};}\n buildSet(){super.buildSet();if(this.id==='step'){this.chart=chart(this.tier,this.options.session);if(\"'!this.options.session)this.duration=this.chart.duration;this.classGuests=[];for(let i=0;i<8;i++){let d=doll(['\"'#91b6a1','#e9af6a','#ac8db4','#75a6bc'][i%4],i%4);d.root.position.set((i%4-1.5)*1.35,0,-2.3-Math.floor(i/4)*1.4);d.root.scale.setScalar(.78);this.group.add(d.root);this.classGuests.push(d);}this.game.view.sun.color.set(0xffcdaf);}\n if(this.id==='water'){let pond=cyl(this.group,0x6ca6a2,0,.02,0,5,.03);for(let i=0;i<9;i++){let p=cyl(this.group,0x94b69b,Math.sin(i*2)*4,.06,Math.cos(i*2)*4,.4,.035);if(i%3===0)ball(this.group,0xe9b9b5,p.position.x,.16,p.position.z,.16,1,.5,1);}}\n if(this.id==='plank')box(this.group,0xcbb38b,0,.1,0,9,.2,.9);\n if(this.id==='tug'){box(this.group,0xe6d2a0,0,.015,0,11,.03,7);for(let i=-4;i<=4;i++)box(this.group,0xf7ebc7,i,.04,0,.035,.01,5);this.rope=box(this.group,0xc18e5d,0,.85,.1,8,.04,.04);this.flag=box(this.group,0xdd7766,0,.75,.1,.2,.4,.05);}\n if(this.id==='loop'){cyl(this.group,0x99ba8c,0,-.1,0,22,.2);let track=torus(this.group,0xe8d5a5,0,.018,0,19,1.2);track.rotation.x=Math.PI/2;this.kevin=doll('#929eac',3);this.group.add(this.kevin.root);this.kevin.anim.play('walk');this.duration=95;}\n if(this.id==='service'){const len=[30,45,60][this.tier-1];for(let lane=0;lane<4;lane++){let x=(lane-1.5)*3.2;for(let i=0;i<len+5;i++){box(this.group,0xd3ac7d,x,-.02,-i,1.65,.08,.92);if(i%4===0){cyl(this.group,0xad8a69,x-.7,-1.5,-i,.06,3);cyl(this.group,0xad8a69,x+.7,-1.5,-i,.06,3);}}}box(this.group,0x75a6a0,0,.1,-len-2,14,.2,3);}\n }\n buildLane(l){super.buildLane(l);l.data={inside:0,total:0,gain:0,maxGain:0,outside:0,penalty:0};let d=l.data;\n if(this.id==='poses'){l.doll.anim.play('pose0');d.pose=-1;}\n if(this.id==='cairn'){d.added=0;d.next=2;d.onSlab=0;d.top=1.78;l.stones=[];l.slab=box(l.doll.root,0x93a7a0,0,1.7,0,1.1,.06,1.1);l.doll.anim.play('slab');if(l.balancer)this.world.createCollider(R.ColliderDesc.cuboid(.55,.03,.55).setTranslation(0,.95,0).setMass(.05).setFriction(1).setCollisionGroups(PROP(l.id)),l.balancer.body);}\n if(this.id==='water'){d.calm=0;d.nextSneeze=17;d.sneezeUntil=0;d.stifled=false;l.doll.anim.play('sit');l.creatures=[];for(let i=0;i<5;i++){let g=i===0?gull():i===4?gull():group();if(i>0&&i<4){ball(g,[0x8aab70,0xe3b664,0xa5ad78][i-1],0,0,0,.13,1.2,.6,1);ball(g,0x323340,.05,.06,.08,.025);}g.position.set(l.x+(i%2?.35:-.35),i<2?1.3:.15,i<2?0:.4);g.visible=false;this.group.add(g);l.creatures.push(g);}cyl(this.group,0x799d77,l.x,.08,0,.9,.08);}\n if(this.id==='log'){d.depth=0;d.offset=0;d.logLost=0;d.band=0;d.rep=0;l.log=cyl(l.doll.root,0xb17f59,0,1.06,0,.16,1.55);l.log.rotation.z=Math.PI/2;for(let x of [-.8,.8]){let ring=torus(l.doll.root,0xdbb57b,x,1.06,0,.12,.012);ring.rotation.y=Math.PI/2;}l.doll.anim.play('squat');}\n if(this.id==='plank'){l.doll.anim.play('plank');d.gulls=0;d.next=4;d.pushX=0;d.pushZ=0;l.gulls=[];}\n if(this.id==='tug'){l.doll.anim.play('tug');d.rope=0;d.wins=0;d.losses=0;d.nextCall=2;d.lastFoot=-10;d.calls=0;d.round=1;}\n if(this.id==='step'){d.notes=this.chart.notes.map(n=>({...n}));d.hits=0;d.combo=0;d.best=0;d.judged=0;d.lastBeat=-1;}\n if(this.id==='plates'){d.omega=0;d.measured=0;d.phase=0;d.angle=0;d.lastTap=-1;d.lastDir=0;d.alive=0;d.crashes=0;d.plates=([['L','M','S'],['L','M','M','S'],['L','L','M','M','S','S']][this.tier-1]).map((type,i)=>({type,energy:.7,down:0,index:i}));l.plateVisuals=d.plates.map((p,i)=>{let angle=(i/d.plates.length)*Math.PI*2,g=group(this.group,l.x+Math.cos(angle)*1.22,0,Math.sin(angle)*1.22);cyl(g,0xc5a171,0,.85,0,.025,1.7);let plate=cyl(g,p.type==='L'?0x8db4ad:p.type==='M'?0xe4ac69:0xc59abb,0,1.73,0,p.type==='L'?.26:p.type==='M'?.2:.16,.03);return {g,plate};});l.hoop=torus(l.doll.root,0xe4b55c,0,.65,0,.6,.025);l.hoop.rotation.x=Math.PI/2;}\n if(this.id==='service'){d.distance=0;d.speed=0;d.lastStep=-5;d.lastFoot=0;d.steps=0;d.glasses=5;d.gust=0;d.gustDir=1;d.nextGust=7;d.warnings=0;l.glasses=[];tray(l.doll.root);l.doll.anim.play('tray');if(l.balancer){this.world.createCollider(R.ColliderDesc.cuboid(.3,.02,.3).setTranslation(0,.5,.3).setMass(.04).setFriction(1).setCollisionGroups(PROP(l.id)),l.balancer.body);for(let i=0;i<5;i++){let x=(i%3-1)*.15,z=Math.floor(i/3)*.18+.2,body=rigid(this.world,R.ColliderDesc.cylinder(.06,.05),[l.x+x,1.34,z],.012,l.id),g=group();cyl(g,glass,0,0,0,.05,.12);let r=torus(g,0x567d80,0,.06,0,.05,.006);r.rotation.x=Math.PI/2;cyl(g,0xd7ae61,0,-.02,0,.044,.06);l.glasses.push(this.addProp(body,g,l));}}}\n if(this.id==='loop'){d.angle=0;d.distance=0;d.lastStep=-5;d.lastFoot=0;d.speed=0;d.steps=0;d.shells=0;l.balancer?.setFoot(19,0,0);l.doll.anim.play('walk');}\n }\n spawnStone(l){const d=l.data,i=d.added,r=this.tier===3?.28-i*.01:[.26,.24,.22,.2,.18,.165,.15,.14,.125,.11][i],hh=[.09,.085,.08,.078,.074,.07,.066,.062,.058,.054][i];if(\"'!r)return;let last=l.stones.filter(p=>p.active).at(-1),pos=last?last.body.translation():{x:l.x,y:1.73,z:0},y=last?pos.y+(last.hh||.09)+hh+.012:1.73+hh+.012,offset=(this.tier===1?.015:.02);let b=rigid(this.world,R.ColliderDesc.cuboid(r*.8,hh,r*.8),[pos.x+(this.random()-.5)*offset*2,y,pos.z+(this.random()-.5)*offset*2],tuning.stoneMass,l.id);l.stones.push(this.addProp(b,stone(null,r,hh),l,{hh}));d.added++;this.game.audio.sfx('\"'clack');}\n tickLane(l,dt){const d=l.data,b=l.balancer,input=l.input,t=this.t,progress=clamp(t/this.duration),tier=this.tier;l.dist={sway:.1,tremor:.05};l.target={x:0,z:0,r:.3};d.total+=dt;const dist=()=>Math.hypot(b.cob.x-l.target.x,b.cob.z-l.target.z);\n switch(this.id){\n case 'poses':{let hold=[8,10,12][tier-1],cycle=hold+3,index=Math.min([3,4,5][tier-1]-1,Math.floor(t/cycle)),local=t%cycle,pose=POSES[index],prev=index?POSES[index-1]:['',0,0],r=clamp(local/3);l.target={x:lerp(prev[1],pose[1],r),z:lerp(prev[2],pose[2],r),r:lerp(.3,tuning.ringEnd-(tier-1)*.03,clamp((local-3)/hold))};l.dist={sway:lerp([.08,.12,.15][tier-1],[.22,.3,.38][tier-1],progress),tremor:lerp(.08,.2,progress),still:true};if(d.pose\"'!==index){d.pose=index;l.doll.anim.play('\"'pose'+index);}if(local>3){const weight=.3/l.target.r;d.maxGain+=weight*dt;if(dist()<l.target.r&&\"'!b.fallen)d.gain+=weight*dt*(b.breathBonus?1.25:1);}l.score=100*d.gain/Math.max(.001,d.maxGain);this.message=pose[0]+(local<3?'\"' · Follow the ring':' · Hold gently');break;}\n case 'cairn':{l.target.r=.17;l.dist={sway:lerp(tier===1?.1:.15,tier===1?.3:.4,progress),tremor:lerp(.05,.15,progress),still:true};let total=[6,8,10][tier-1];if(t>=d.next&&d.added<total){this.spawnStone(l);d.next=t+tuning.stoneInterval-(tier-1)*.5;}d.onSlab=l.stones.filter(p=>p.active&&p.body.translation().y>1.5&&Math.hypot(p.body.translation().x-l.x,p.body.translation().z)<.65).length;l.score=d.onSlab*100;this.message=\"'`${d.added} of ${total} stones · Breathe. They can tell.`;break;}\n case '\"'water':{l.target.r=[.15,.12,.1][tier-1];l.dist={sway:lerp([.07,.1,.12][tier-1],[.18,.22,.26][tier-1],progress),tremor:.05,still:true};if(dist()<l.target.r&&\"'!b.fallen){d.inside+=dt;d.calm=clamp(d.calm+dt/30);}else d.calm=clamp(d.calm-dt/8);for(let i=0;i<5;i++)l.creatures[i].visible=d.calm>=(i+1)*.2;if(t>d.nextSneeze-1.2&&t<d.nextSneeze){this.message='\"'Ah… ah… Flail to stifle it.';if(input.flailPress)d.stifled=true;}else this.message=d.calm>.8?'You have become a local landmark.':'Keep the pond quiet.';if(t>=d.nextSneeze){if(\"'!d.stifled){d.sneezeUntil=t+.3;this.game.audio.sfx('\"'sneeze');}d.stifled=false;d.nextSneeze+=60/([2,3,4][tier-1]+1);}if(t<d.sneezeUntil)l.dist.nx=2.2;l.score=d.calm*100;break;}\n case 'log':{let cycle=tuning.repTempo,local=t%cycle,p=local/cycle,target=p<.4?p/.4:p<.5?1:p<.9?1-(p-.5)/.4:0;d.rep=Math.floor(t/cycle);const analog=l.kind==='bot'||l.device==='pad'||this.game.input.lastDevice==='pad';d.depth=analog?(input.left+input.right)/2:clamp(d.depth+((input.left>.7&&input.right>.7)?dt/(cycle*.4):-dt/(cycle*.4)));let depth=d.depth+lerp(.015,.07,progress)*Math.sin(t*23),band=lerp(.16,.1,progress)-(tier-1)*.02,inside=Math.abs(depth-target)<band;d.targetDepth=target;d.bandWidth=band;l.dist={sway:lerp(.08,.22,progress)*(1+(tier-1)*.35),tremor:lerp(.04,.12,progress)};d.offset+=Math.sign(b.leanX)*Math.max(0,Math.abs(b.leanX)*180/Math.PI-6)*.05*dt;l.dist.nx=.06*9.81*d.offset;d.offset=clamp(d.offset,-.55,.55);if(Math.abs(d.offset)>.5&&d.logLost<=0){d.logLost=1.4;d.penalty+=3;d.offset=0;this.game.fx('COACH HAS IT',l.x,2,0);this.game.audio.sfx('clack');}d.logLost=Math.max(0,d.logLost-dt);l.log.visible=d.logLost<=0;l.log.position.x=d.offset;if(inside&&d.logLost<=0)d.gain+=dt*(.5+.5*(dist()<.3?1:0));d.maxGain+=dt;l.score=100*d.gain/Math.max(.01,d.maxGain);this.message=d.rep>=[6,9,12][tier-1]?'THIS one’s the last one\"'! · Bonus reps'\"':'Sink with the ribbon. Both feet together.';l.doll.anim.play('squat');let action=l.doll.anim.actions.squat;action.paused=true;action.time=d.depth;l.doll.anim.mixer.update(0);break;}\n case 'plank':{l.target.r=.28;if(t>=d.next){let side=d.pushX===0?(this.random()<.5?-1:1):this.random()<.7?Math.sign(d.pushX):-Math.sign(d.pushX);let push=(.2+this.random()*.2)*(tier===3?1.15:1);d.pushX+=push*side;d.gulls++;let g=gull();g.position.set(l.x+side*.22,.8+(d.gulls%3)*.2,.15+(d.gulls%2)*.2);this.group.add(g);l.gulls.push(g);d.next=t+[5,4.5,4][tier-1];this.game.audio.sfx('fruit');}l.dist.nx=d.pushX;l.dist.nz=d.pushZ;if(dist()<.28&&\"'!b.fallen){d.inside+=dt;d.outside=0;}else d.outside+=dt;if(d.outside>2){b.fall();d.outside=0;}l.score=100*d.inside/d.total;this.message=`${d.gulls} gull${d.gulls===1?'\"'':'s'} · Being popular takes balance.\"'`;break;}\n case '\"'tug':{l.target={x:0,z:.9,r:.25};l.dist={sway:.04,nz:-.1-.3*[.35,.5,.54][tier-1]};if(input.leftPress||input.rightPress)d.lastFoot=t;const until=d.nextCall-t;this.message=until<.3?'HEAVE\"'!'\"':until<.8?'Ready…':'Ease into it.';if(t>=d.nextCall){let error=Math.abs(t-d.lastFoot),timing=clamp(1-error/.3),share=clamp(b.cob.z),mine=timing*share,theirs=[.35,.5,.54][tier-1]*(.8+.4*this.random());d.rope+=(mine-theirs)*.33;d.calls++;d.nextCall=t+1.2;this.game.audio.sfx('foot');if(d.rope>=1||d.rope<=-1){if(d.rope>=1)d.wins++;else d.losses++;d.rope=0;d.round++;this.game.audio.sfx('bell');if(d.wins>=2||d.losses>=2){l.finished=true;if(this.lanes.every(l=>l.finished||l.kind==='ghost'))this.finish();}}}if(tier>1&&Math.floor(t)%([12,9][tier-2])===0&&b.cob.z>.72){l.dist.nz=3.2;this.message='They have politely let go.';}this.flag.position.x=d.rope*3;l.score=40+30*d.wins-5*b.falls;break;}\n case 'step':{l.dist={sway:.02,tremor:.03,noFalls:true};let beat=Math.floor(t/(60/this.chart.bpm));if(beat\"'!==d.lastBeat){d.lastBeat=beat;this.game.audio.sfx('\"'foot');}let window=.135*tuning.rhythmWindow;const grade=err=>err<=.045?1:err<=.09?.7:.4;for(let note of d.notes){if(note.done)continue;const delta=t-note.t-this.game.settings.offset/1000,isLean='< > \"'^ v'\"'.split(' ').includes(note.kind);if(isLean){const yes=note.kind==='<'?b.cob.x<-.25:note.kind==='>'?b.cob.x>.25:note.kind==='\"'^'\"'?b.cob.z<-.25:b.cob.z>.25;if(delta>=-.2&&delta<2*60/this.chart.bpm&&yes){note.done=true;d.hits+=delta<1.5*60/this.chart.bpm?1:.5;d.combo++;d.judged++;}else if(delta>2*60/this.chart.bpm){note.done=true;d.combo=0;d.judged++;}}\n else{const hit=note.kind==='L'?input.leftPress:note.kind==='R'?input.rightPress:input.hopPress||(input.left>.5&&input.right>.5&&(input.leftPress||input.rightPress));if(Math.abs(delta)<=window&&hit){note.done=true;d.hits+=grade(Math.abs(delta));d.combo++;d.judged++;l.doll.anim.play(note.kind==='R'?'step-R':'step-L');this.game.audio.sfx('fruit');}else if(delta>window){note.done=true;d.combo=0;d.judged++;}}d.best=Math.max(d.best,d.combo);}l.score=d.hits/Math.max(1,d.judged)*100;this.message=d.combo>=16?'The whole class is with you.':\"'`Keep the beat · ${d.combo} in a row`;break;}\n case '\"'plates':{l.dist={sway:0,tremor:0,noFalls:true};let raw=0,mag=Math.hypot(input.x,input.z),angle=Math.atan2(input.z,input.x);if(input.plateTap&&input.plateDir\"'!==d.lastDir){if(d.lastTap>0)raw=Math.PI/Math.max(.12,t-d.lastTap);d.lastTap=t;d.lastDir=input.plateDir;}else if(this.game.input.lastDevice==='\"'kbm'&&this.game.input.owner==='keys'&&l.kind==='local'){raw=t-d.lastTap<1?d.keySpeed||0:0;}else if(mag>.5){let delta=angle-d.angle;delta=Math.atan2(Math.sin(delta),Math.cos(delta));raw=Math.min(18,Math.abs(delta/dt));}d.angle=angle;if(input.plateTap&&raw)d.keySpeed=raw;d.measured+=(raw-d.measured)*(1-Math.exp(-dt/.12));d.omega+=(d.measured-d.omega)*(1-Math.exp(-dt/.5));d.phase+=d.omega*dt;const bands={L:[3.5,5],M:[6.5,8],S:[9.5,11]};for(let p of d.plates){if(p.down>0){p.down-=dt;if(p.down<=0)p.energy=.7;continue;}if(d.omega>=bands[p.type][0]&&d.omega<=bands[p.type][1])p.energy=clamp(p.energy+tuning.plateGain*dt);else p.energy-=((tuning.plateDecay)+(tier-1)*.025)*dt;d.alive+=dt;if(p.energy<=0){p.down=6;d.crashes++;this.shatter(l,p.index);this.game.audio.sfx('crash');}}l.score=Math.max(0,200*d.alive/(Math.max(.001,d.total)*d.plates.length)-100);this.message=\"'`${d.omega.toFixed(1)} rad/s · Large 4 · Medium 7 · Small 10`;break;}\n case '\"'service':{const length=[30,45,60][tier-1];let press=input.leftPress?1:input.rightPress?2:0;if(press){if(press===d.lastFoot){d.penalty++;b.body.applyTorqueImpulse({x:0,y:0,z:.02},true);}else{d.lastStep=t;d.steps++;d.rock=t+.18;d.lastFoot=press;this.game.audio.sfx('foot');}}let wanted=t-d.lastStep<.672?.55/.42:0;d.speed+=(wanted-d.speed)*(1-Math.exp(-dt/.5));d.distance+=d.speed*dt;l.x+=b.leanX*.25*d.speed*dt;l.z=-d.distance;b.setFoot(l.x,0,l.z);l.target={x:0,z:0,r:.25};if(Math.abs(l.x-((l.id-(this.lanes.length-1)/2)*3.2))>.8){d.glasses=Math.max(0,d.glasses-1);l.x=(l.id-(this.lanes.length-1)/2)*3.2;this.dropGlass(l);this.game.fx('SPLOSH\"'!'\"',l.x,1,l.z);this.game.audio.sfx('splash');}\n let force=tuning.gustForce+(tier-1)*.55;if(t>d.nextGust-1&&t<d.nextGust+.5){l.target.x=-.2*force*d.gustDir;this.message=t<d.nextGust?'Wind coming. Lean toward the green zone.':'A small, early lean.';if(t>=d.nextGust)l.dist.nx=force*d.gustDir;}else this.message='Alternate feet. Keep the glasses.';if(t>d.nextGust+.5){d.nextGust=t+([7,6,5][tier-1]);d.gustDir*=-1;}if(t<d.rock)l.dist.nx=(l.dist.nx||0)+.2*(d.lastFoot===1?-1:1);l.dist.sway=.03;d.glasses=l.glasses.filter(p=>p.active).length;for(let p of l.glasses)if(p.active&&p.body.translation().y<.7){this.disable(p);this.game.audio.sfx('clack');}l.score=d.glasses*100;if(d.distance>=length){l.finished=true;if(this.lanes.length===1||this.lanes.every(l=>l.finished))this.finish();else if(\"'!this.finishBy)this.finishBy=t+15;}if(this.finishBy&&t>this.finishBy)this.finish();break;}\n case '\"'loop':{let press=input.leftPress?1:input.rightPress?2:0;if(press&&press\"'!==d.lastFoot){let cadence=t-d.lastStep;d.speed=clamp(1.4/Math.max(.2,cadence),0,6);d.lastStep=t;d.lastFoot=press;d.steps++;this.game.audio.sfx('\"'foot');}if(t-d.lastStep>1)d.speed*=Math.exp(-dt*2);d.distance+=d.speed*dt;d.angle=d.distance/19;let radius=19+clamp((l.x||0)-19,-1,1);d.radial=clamp((d.radial||0)+input.x*dt*2,-1,1);radius=19+d.radial;l.x=Math.cos(d.angle)*radius;l.z=Math.sin(d.angle)*radius;b.setFoot(l.x,0,l.z);if(d.speed>2.98&&d.speed<4.03)d.inside+=dt;d.shells=Math.floor(d.distance/15);l.score=100*d.inside/Math.max(.01,d.total);l.dist={sway:.04,noFalls:true};this.message=\"'`Lap ${Math.min(2,Math.floor(d.distance/(Math.PI*38))+1)} / 2 · ${d.speed.toFixed(1)} m/s · Follow Kevin`;if(d.distance>=Math.PI*76)this.finish();break;}\n }\n if(['\"'poses','cairn','water'].includes(this.id)&&dist()<l.target.r&&\"'!b.fallen)d.inside+=dt;\n }\n shatter(l,index){const p=l.plateVisuals[index].g.position;for(let i=0;i<6;i++){let b=rigid(this.world,R.ColliderDesc.cuboid(.06,.015,.06),[p.x,1.7,p.z],.005,l.id);b.setLinvel({x:(this.random()-.5)*2,y:1+this.random(),z:(this.random()-.5)*2},true);let v=box(null,0xdfcfb2,0,0,0,.12,.03,.12);this.addProp(b,v,l,{expire:this.t+3});}}\n dropGlass(l){const p=l.glasses.find(p=>p.active);if(p)this.disable(p);}\n onFall(l){super.onFall(l);if(this.id==='\"'tug')l.data.rope-=.3;if(this.id==='water')l.data.calm=0;if(this.id==='plank')this.onFlail(l);}\n onFlail(l){l.data.penalty+=this.id==='plank'?5:1;if(this.id==='plank'){l.data.pushX=l.data.pushZ=l.data.gulls=0;for(let g of l.gulls)g.visible=false;l.gulls.length=0;}}\n afterStep(){for(let p of this.props)if(p.active&&p.expire&&p.expire<this.t)this.disable(p);}\n frame(dt){super.frame(dt);for(const l of this.lanes){const d=l.data;if(this.id==='plates'){l.hoop.rotation.z=d.phase;for(let i=0;i<l.plateVisuals.length;i++){let p=d.plates[i],v=l.plateVisuals[i].plate;v.visible=p.down<=0;v.rotation.z=Math.sin(this.t*(7+p.energy*10)+i)*(1-p.energy)*.35;v.rotation.y=this.t*(4+p.energy*8);}}if(this.id==='log')l.doll.root.position.y-=d.depth*.25;}\n if(this.classGuests)for(let i=0;i<this.classGuests.length;i++){let g=this.classGuests[i];g.anim.play((this.lanes[0].data.combo||0)>8?'cheer':'step-'+(Math.floor(this.t*2)%2?'L':'R'));g.anim.update(dt);}\n if(this.id==='service'){const z=this.lanes[0].z;this.game.view.setCamera([0,4.4,z+9.3],[0,1,z-2]);}\n if(this.id==='loop'){const d=this.lanes[0].data,a=d.angle;this.kevin.root.position.set(Math.cos(a+.18)*19,0,Math.sin(a+.18)*19);this.kevin.root.rotation.y=-a;this.kevin.anim.update(dt);this.game.view.setCamera([Math.cos(a-.3)*22,5,Math.sin(a-.3)*22],[Math.cos(a+.08)*19,1,Math.sin(a+.08)*19]);}\n }\n botGoal(l){if(this.id==='plank')return {x:-l.data.pushX/(9.81*.75*.45*rad(18)),z:0};if(this.id==='tug')return {x:0,z:.9};if(this.id==='step'){let n=l.data.notes.find(n=>\"'!n.done&&'\"'< > \"'^ v'\"'.split(' ').includes(n.kind)&&n.t-this.t<1.2);return {x:n?.kind==='<'?-.7:n?.kind==='>'?.7:0,z:n?.kind==='\"'^'\"'?-.7:n?.kind==='v'?.7:0};}return l.target;}\n botActions(l,input,t,s,skill){const d=l.data;\n if(this.id==='water'&&t>d.nextSneeze-.5&&t<d.nextSneeze)input.flailPress=l.balancer.cooldown<=0;\n if(this.id==='log'){let c=tuning.repTempo,p=((t-s.lag)%c)/c;let target=p<.4?p/.4:p<.5?1:p<.9?1-(p-.5)/.4:0;let error=skill==='sharp'?.025:skill==='average'?.09:.2;input.left=input.right=clamp(target+Math.sin(t*7)*error);}\n if(this.id==='plank'&&d.outside>1.2&&Math.hypot(l.balancer.cob.x,l.balancer.cob.z)>.65)input.flailPress=l.balancer.cooldown<=0;\n if(this.id==='tug'){let on=Math.abs(t-d.nextCall)<.12;input.left=input.right=on?1:0;input.leftPress=input.rightPress=on&&t-d.lastFoot>.3;}\n if(this.id==='step'){let error=s.lag*Math.sin(d.judged*7.13),note=d.notes.find(n=>\"'!n.done&&!'\"'< > \"'^ v'\"'.split(' ').includes(n.kind)&&Math.abs(t-n.t-error)<.025);if(note){input.left=note.kind\"'!=='\"'R'?1:0;input.right=note.kind\"'!=='\"'L'?1:0;input.leftPress=note.kind\"'!=='\"'R';input.rightPress=note.kind\"'!=='\"'L';input.hopPress=note.kind==='B';}}\n if(this.id==='plates'){let low=d.plates.filter(p=>p.down<=0).sort((a,b)=>a.energy-b.energy)[0],speed=low?{L:4.25,M:7.25,S:10.25}[low.type]:4.25;speed+=s.noise*12*Math.sin(t*4)+(skill==='clumsy'?1.4*Math.sin(t*2):0);d.botAngle=(d.botAngle||0)+speed/120;input.x=Math.cos(d.botAngle)*.85;input.z=Math.sin(d.botAngle)*.85;}\n if(this.id==='service'||this.id==='loop'){let cadence=this.id==='service'?.42:.4;let phase=Math.floor((t+s.lag*Math.sin(t*3))/cadence),left=phase%2===0;if(d.botStep\"'!==phase){input.leftPress=left;input.rightPress=!left;d.botStep=phase;}input.left=left?1:0;input.right=left?0:1;if(this.id==='\"'loop')input.x=0;}\n }\n computeForm(l){const d=l.data;switch(this.id){case 'poses':return 100*d.gain/Math.max(.001,d.maxGain)-d.penalty;case 'cairn':return d.onSlab/[6,8,10][this.tier-1]*90+10*d.inside/Math.max(.001,d.total);case 'water':return 50*(d.inside/Math.max(.001,d.total)+d.calm);case 'log':return 100*d.gain/Math.max(.001,d.maxGain)-d.penalty;case 'plank':return 100*(d.inside/Math.max(.001,d.total)*100+d.gulls*1.5-d.penalty)/[85,65,58][this.tier-1];case 'step':return 100*d.hits/Math.max(1,d.notes.length);case 'service':return d.glasses*18+10*clamp(d.distance/[30,45,60][this.tier-1]);case 'loop':return 95*d.inside/Math.max(.001,d.total)+Math.min(5,d.shells);default:return l.score;}}\n resultDetail(l){const d=l.data;switch(this.id){case 'cairn':return \"'`${d.onSlab} stones still standing · ${d.added} delivered`;case '\"'water':return \"'`${Math.round(d.calm*100)}% calm · ${Math.round(d.inside/d.total*100)}% in the zone`;case '\"'log':return \"'`${d.rep+1} reps · ${l.balancer.falls} floor exercises`;case '\"'plank':return \"'`${d.gulls} gulls at the finish`;case '\"'tug':return \"'`${d.wins} pulls won · ${d.losses} lost`;case '\"'step':return \"'`${d.best} best combo · ${Math.round(d.hits)} clean steps`;case '\"'plates':return \"'`${d.crashes} plates excused themselves`;case '\"'service':return \"'`${d.glasses} of 5 glasses delivered · ${Math.round(d.distance)} m`;case '\"'loop':return \"'`${Math.min(2,d.distance/(Math.PI*38)).to