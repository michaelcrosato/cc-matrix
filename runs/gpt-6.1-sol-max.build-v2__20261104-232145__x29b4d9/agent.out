les, and it is yours.');},back:()=>this.showIsland()},()=>this.showIsland());}\n about(page=0,ending=false){this.setScreen('about');this.aboutEnding=ending;let info=Object.entries(ABOUT.sourceInformation),sections=[];for(let i=0;i<info.length;i+=3)sections.push({title:'Source Information',body:info.slice(i,i+3).map(([k,v])=>\"'`<p><b>${k.replace(/([A-Z])/g,'\"' \"'$1'\"').replace(/\"'^./,s=>s.toUpperCase())}</b><br>${esc(v)}</p>`).join('\"'')});for(let [key,title] of [['testingFeedback','Testing Feedback'],['engineFeedback','Engine Feedback'],['promptFeedback','Prompt Feedback']]){const qs={testingFeedback:['Issues caught','Critical issues','Most helpful test','Least helpful test'],engineFeedback:['What worked best','What surprised me','Most important custom system','Hardest engine task','Engine changes','One engine improvement'],promptFeedback:['What worked in the prompt','What was confusing','Hardest part','One prompt improvement']}[key];for(let i=0;i<ABOUT[key].length;i+=2)sections.push({title,body:ABOUT[key].slice(i,i+2).map((v,j)=>\"'`<p><b>${qs[i+j]}</b><br>${esc(v)}</p>`).join('\"'')});}sections.push({title:'Made of small things.',body:\"'`<p><b>${TITLE}</b><br>Original models, animation, writing, music, voices and effects made in code.</p><p>Three.js R180 · MIT<br>Rapier 0.19.3 · Apache-2.0<br>Fredoka · SIL Open Font License 1.1<br>AI Hub client 1.4.0 · Session Protocol v1</p>`});page=(page+sections.length)%sections.length;let s=sections[page];this.ui.show(panel(`About & Credits · ${page+1} / ${sections.length}`,s.title,`<div class=\"about-copy\">${s.body}</div>`,`${btn(ending?'\"'Same time tomorrow':'Back','back')}<span class=\\\"page-indicator\\\">← / → · Turn the page</span>\"'${btn('\"'Next page','next')}\"'`,'\"'about-panel'),{back:()=>ending?this.afterEnding():this.mainMenu(),next:()=>this.about(page+1,ending)},()=>ending?this.afterEnding():this.mainMenu());this.ui.pageMove=dir=>this.about(page+dir,ending);}\n groupLobby(){this.disposeEvent();this.setScreen('groupLobby');this.groupRun=null;this.ui.show(panel('Group Class · One screen','Bring your favourite knees.',\"'`<div class=\"profile-mats\">${Array.from({length:4},(_,i)=>`<div class=\"tag\" style=\"min-height:15vh;display:flex;flex-direction:column;justify-content:center;border-color:${SEATS[i]}\"><span style=\"font-size:3vh;color:${SEATS[i]}\">●</span><span style=\"font-size:.7em\">${this.groupSeats[i]?esc(this.groupSeats[i].name):'\"'Press Cross'}</span></div>\"'`).join('\"'')}</div><p class=\\\"muted\\\">Each controller presses Cross to join. Keyboard and mouse share one mat.</p><div class=\\\"choices\\\">\"'${btn('\"'Join keyboard & mouse','join')}\"'${btn('\"'Let’s have a class','begin','','primary')}\"'${btn('\"'Back','back')}</div>\"'`),{join:()=>this.joinGroup('\"'kbm',0),begin:()=>{if(this.groupSeats.length)this.groupPlaylist();else this.ui.toast('At least one pair of knees, please.');},back:()=>{this.groupSeats=[];this.mainMenu();}},()=>{this.groupSeats=[];this.mainMenu();});}\n joinGroup(device,pad){if(this.groupSeats.length>=4||this.groupSeats.some(s=>s.device===device&&s.pad===pad))return;let i=this.groupSeats.length;this.groupSeats.push({name:device==='kbm'?'Gentle Margaret':['Retired Kevin','Both Sandras','Young Gerald','Unsteady Paul'][i],colour:SEATS[i],device,pad,hat:i});this.groupLobby();this.ui.setFocus(1);this.audio.sfx('confirm');}\n groupPlaylist(picked=[],page=0){this.setScreen('groupPlaylist');const list=EVENTS.filter(e=>e.couch),pages=Math.ceil(list.length/3);let shown=list.slice(page*3,page*3+3);this.ui.show(panel('Group Class',picked.length?\"'`${picked.length} of 3 chosen.`:'\"'Three small competitions.',\"'`<div class=\"choices\">${btn('\"'Quick Class','quick','Three surprises','primary')}\"'${shown.map(e=>btn((picked.includes(e.id)?'\"'✓ ':'')+e.title,e.id)).join('')}\"'${btn('\"'Back','back')}</div>\"'`,`<span class=\"page-indicator\">${page+1} / ${pages}</span>${btn('\"'Next page','next')}\"'`),Object.fromEntries([['\"'quick',()=>this.startGroup(shuffled(list.map(e=>e.id),'group-deal').slice(0,3))],...shown.map(e=>[e.id,()=>{if(picked.includes(e.id))return;let a=[...picked,e.id];if(a.length===3)this.startGroup(a);else this.groupPlaylist(a,page);}]),['back',()=>this.groupLobby()],['next',()=>this.groupPlaylist(picked,(page+1)%pages)]]),()=>this.groupLobby());this.ui.pageMove=dir=>this.groupPlaylist(picked,(page+dir+pages)%pages);}\n startGroup(ids){this.groupRun={seats:this.groupSeats.map(s=>({...s})),ids,index:0,points:this.groupSeats.map(()=>0)};this.flow='group';this.intro(ids[0]);}\n groupResults(){this.setScreen('results');const e=this.event,rank=e.lanes.map((l,i)=>({i,name:l.name,form:Math.round(l.form)})).filter(l=>l.i<this.groupRun.seats.length).sort((a,b)=>b.form-a.form);this.ui.clearHud();this.audio.sting('Exemplary');this.ui.show(panel('Group Class · '+e.meta.title,'A room full of small victories.',\"'`<div class=\"choices\">${rank.map((r,i)=>`<div class=\"tag\" style=\"border-color:${this.groupRun.seats[r.i].colour}\">${i+1}. ${esc(r.name)}<br>${r.form}% · +${4-i} points</div>`).join('\"'')}</div>\"'`,`${btn('\"'Next class','continue','','primary')}\"'${btn('\"'Again','retry')}\"'`),{continue:()=>this.groupAccept(),retry:()=>this.intro(e.id)},()=>this.groupAccept());}\n groupAccept(){const run=this.groupRun,rank=this.event.lanes.map((l,i)=>({i,form:l.form})).filter(x=>x.i<run.seats.length).sort((a,b)=>b.form-a.form);rank.forEach((r,i)=>run.points[r.i]+=4-i);run.index++;if(run.index>=run.ids.length)this.groupPodium();else this.intro(run.ids[run.index]);}\n groupPodium(){this.disposeEvent();this.setScreen('\"'podium');const rank=this.groupRun.seats.map((s,i)=>({...s,points:this.groupRun.points[i]})).sort((a,b)=>b.points-a.points);this.buildEvent('poses',1,{configs:rank.map(s=>({...s,kind:'bot'})),god:true});this.podiumRoot=group(this.event.group);rank.forEach((s,i)=>{let h=(rank.length-i)*.45;let b=this.event.lanes[i];b.doll.anim.play('cheer');b.balancer.setFoot((i-(rank.length-1)/2)*1.8,h,0);this.podiumRoot.add(ball(null,s.colour,(i-(rank.length-1)/2)*1.8,h/2,0,.6,1,h/.9,1));});this.ui.show(panel('Group Class','Everyone came. Someone won.',\"'`<p><b>${esc(rank[0].name)}</b> · ${rank[0].points} points</p><p class=\"muted\">The podium would like to sit down now.</p>`,`${btn('\"'Another class','again','','primary')}\"'${btn('\"'Main menu','back')}\"'`),{again:()=>{this.groupRun=null;this.groupLobby();},back:()=>{this.groupRun=null;this.mainMenu();}},()=>{this.groupRun=null;this.mainMenu();});}\n devMenu(page=0){this.setScreen('\"'dev');this.devPage=page;const tools=[['Jump to a class',()=>this.devEvents()],['Jump to a day',()=>this.devDays()],['Skip to Results',()=>{if(this.event){this.event.finish();this.flow=this.event.id==='check'?'check':this.flow;this.finishEvent();}}],['Go to the ending',()=>{if(this.profile){this.profile.levelled=true;this.profile.steps=TOTAL_STEPS;this.save.write();}this.ending();}],['God mode: '+(this.dev.god?'On':'Off'),()=>{this.dev.god=\"'!this.dev.god;this.devMenu(page);}],['\"'Live tuning',()=>this.devTuning()],['Time scale: '+this.dev.timeScale+'×',()=>{this.dev.timeScale=this.dev.timeScale>=4?.1:Math.round((this.dev.timeScale+.5)*10)/10;this.devMenu(page);}],['Single simulation step',()=>{if(this.event){this.event.fixed(1/120,this.event.lanes.map(()=>this.input.current));this.event.frame(1/120);this.ui.toast('Advanced 1 / 120 second.');}}],['Free camera: '+(this.dev.freeCamera?'On':'Off'),()=>{this.dev.freeCamera=\"'!this.dev.freeCamera;this.devMenu(page);}],['\"'Physics lines: '+(this.dev.debug?'On':'Off'),()=>{this.dev.debug=\"'!this.dev.debug;this.devMenu(page);}],['\"'Stats / input: '+(this.dev.stats?'On':'Off'),()=>{this.dev.stats=\"'!this.dev.stats;this.devMenu(page);}],['\"'Let the bot play: '+(this.dev.bot?'On':'Off'),()=>{this.dev.bot=\"'!this.dev.bot;this.devMenu(page);}],['\"'Force a fall',()=>{this.event?.lanes[0]?.balancer?.fall();this.resume();}],['Force a gust',()=>{this.event?.lanes[0]?.balancer?.body.applyTorqueImpulse({x:0,y:0,z:-.8},true);this.resume();}],['Drop a fruit / stone',()=>{let l=this.event?.lanes[0];if(this.event?.spawnFruit)this.event.spawnFruit(l);else if(this.event?.spawnStone)this.event.spawnStone(l);this.resume();}],['Speak a Trudy line',()=>{const text=line('observe');this.audio.say(text,'Trudy');this.ui.toast(text,6);}],['Next music track',()=>{const tracks=['title','island','still','strength','cardio','balance','level'];this.audio.setTrack(tracks[(tracks.indexOf(this.audio.track)+1)%tracks.length]);this.ui.toast('Playing '+this.audio.track);}],['Play a medal sting',()=>this.audio.sting('Suspicious')],['Set Wobble Age + 5',()=>{if(this.profile){let n=((this.profile.ages.at(-1)?.age||18)+5);this.profile.ages.push({day:this.profile.day,age:n>99?18:n,tests:[]});this.save.write();this.ui.toast('Wobble Age set to '+this.profile.ages.at(-1).age);}}],['Add 10 marbles',()=>{if(this.profile){this.profile.marbles+=10;this.island.addMarbles(10);this.save.write();this.ui.toast('10 marbles added.');}}],['Unlock everything',()=>{if(this.profile){for(let e of EVENTS)this.profile.medals[e.id]=[100,100,100];this.profile.marbles=Math.max(60,this.profile.marbles);this.save.write();this.ui.toast('All classes, tiers, hats and paints open.');}}],['Toggle ink',()=>{this.settings.ink=this.settings.ink?0:1;this.devMenu(page);}],['Next time of day',()=>{let cols=[0xffe9c8,0xffffff,0xffc17c,0xe6adc9];this.paletteIndex=((this.paletteIndex||0)+1)%4;this.view.sun.color.set(cols[this.paletteIndex]);this.ui.toast(['Dawn','Noon','Golden hour','Dusk'][this.paletteIndex]);}],['Copy tuning JSON',()=>this.copyTuning()],['Reset saved stay',()=>this.resetConfirm()]];const pages=Math.ceil(tools.length/6);page=(page+pages)%pages;let list=tools.slice(page*6,page*6+6);this.ui.show(panel('Dev Mode','A little behind the curtain.',\"'`<div class=\"choices\">${list.map(([text],i)=>btn(text,'\"'tool'+i)).join('')}</div>\"'`,`${btn('\"'Back to pause','back')}<span class=\\\"page-indicator\\\">\"'${page+1} / ${pages}</span>${btn('\"'Next page','next')}\"'`),Object.fromEntries([...list.map(([,fn],i)=>['\"'tool'+i,fn]),['back',()=>{this.setScreen('pause');this.pauseMenu();}],['next',()=>this.devMenu((page+1)%pages)]]),()=>{this.setScreen('pause');this.pauseMenu();});this.ui.pageMove=dir=>this.devMenu(page+dir);}\n devEvents(page=0,tier=1){const events=EVENTS,pages=Math.ceil(events.length/4),list=events.slice(page*4,page*4+4);this.setScreen('dev');this.ui.show(panel('Dev · Jump to class',\"'`Tier ${tier} · ${TIERS[tier-1]}`,`<div class=\"choices\">${list.map(e=>btn(e.title,e.id)).join('\"'')}\"'${btn('\"'Change tier','tier')}\"'${btn('\"'Back','back')}</div>\"'`,`${btn('\"'Next page','next')}<span class=\\\"page-indicator\\\">\"'${page+1}/${pages}</span>`),Object.fromEntries([...list.map(e=>[e.id,()=>{this.groupRun=null;this.flow='\"'free';this.intro(e.id,tier);}]),['tier',()=>this.devEvents(page,tier%3+1)],['back',()=>this.devMenu()],['next',()=>this.devEvents((page+1)%pages,tier)]]),()=>this.devMenu());}\n devDays(){this.setScreen('dev');this.ui.show(panel('Dev · Jump to morning','Pick a day.',\"'`<div class=\"choices\">${DAYS.map((d,i)=>btn('\"'Day '+(i+1),'d'+i,d.name)).join('')}\"'${btn('\"'Back','back')}</div>\"'`),Object.fromEntries([...DAYS.map((d,i)=>['\"'d'+i,()=>{if(\"'!this.profile)this.save.data.profiles[this.save.data.selected]=freshProfile();let p=this.profile;p.day=i+1;p.steps=DAYS.slice(0,i).reduce((n,d)=>n+d.events.length+1,0);p.done=[];p.checkDone=false;p.tutorial=true;this.save.write();this.disposeEvent();this.island.root.visible=true;this.morning();}]),['\"'back',()=>this.devMenu()]]),()=>this.devMenu());}\n devTuning(page=0){const entries=Object.entries(TUNING),pages=Math.ceil(entries.length/5);page=(page+pages)%pages;const list=entries.slice(page*5,page*5+5);this.setScreen('dev');let actions={reset:()=>{resetTuning();this.devTuning(page);},back:()=>this.devMenu(),next:()=>this.devTuning((page+1)%pages)};let body=list.map(([key,v])=>{actions[key]=(dir,b,p)=>{tuning[key]=clamp(p===undefined?tuning[key]+(typeof dir==='number'?dir:1)*v.step:v.min+p*(v.max-v.min),v.min,v.max);let x=tuning[key],frac=(x-v.min)/(v.max-v.min);b.querySelector('b').textContent=Number(x.toFixed(4));b.querySelector('.slider-fill').style.width=frac*100+'%';b.querySelector('.slider-knob').style.left=\"'`calc(${frac*100}% - 1.15vh)`;};return this.slider(key,v.label,tuning[key],v.min,v.max);}).join('\"'');this.ui.show(panel('Dev · '+list[0][1].group,'Live tuning',body+btn('Reset to defaults','reset'),\"'`${btn('\"'Back','back')}<span class=\\\"page-indicator\\\">\"'${page+1}/${pages}</span>${btn('\"'Next page','next')}\"'`),actions,()=>this.devMenu());this.ui.pageMove=dir=>this.devTuning(page+dir);}\n copyTuning(){let text=JSON.stringify(tuning,null,2);navigator.clipboard?.writeText(text).then(()=>this.ui.toast('\"'Tuning copied.')).catch(()=>this.tuningText(text));if(\"'!navigator.clipboard)this.tuningText(text);}\n tuningText(text){this.ui.show(panel('\"'Dev · Tuning JSON','Your current recipe.',\"'`<textarea readonly style=\"width:100%;height:42vh;font:2vh monospace;background:#fff7e5\">${esc(text)}</textarea>`,btn('\"'Back','back')),{back:()=>this.devMenu()});}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"rg -n 'function time|time:|function progress|function answer|function probe' vendor/session.js && sed -n '285,350p' vendor/HUB-README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"rg -n 'function time|time:|function progress|function answer|function probe' vendor/session.js && sed -n '285,350p' vendor/HUB-README.md\"","aggregated_output":"422:  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\npython3 -m http.server 8000\n```\n\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\nThe hub's own test also runs ghost and shared-world games with\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\n`&scenario=host-leave`, and shared worlds once more with\n`&players=2&scenario=server`.\n\nThe checklist fills in as it runs. **A game passes when\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\n`\"true\"` at the end. It checks:\n\n- the tags, `connect()`, `ready()` with no key press, and the start;\n- with the game's own card, that Enter answers Ready;\n- parallel and ghost: `Math.random` the same on every copy, and progress from\n  every copy; parallel sends nothing, ghost sends;\n- shared world: traffic both ways, and a round hosted by a copy with no\n  player of its own;\n- a player leaving, the host leaving, time-up, a valid result, and every copy\n  told the round ended;\n- no protocol problems, errors, dialogs, popups or sockets.\n\n**New round**, **Time up**, **Remove player** and **Hide host tab** run the\ncases by hand; clicking a player's frame gives it the keyboard and mouse.\n`&limit=` sets the round's length in seconds and `&seed=` fixes the seed. The\ngame is served from the harness's own origin.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"rg -n 'time =|time\\\\(|probe|inspect' vendor/session.js | tail -22 && sed -n '350,425p' vendor/session.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"rg -n 'time =|time\\\\(|probe|inspect' vendor/session.js | tail -22 && sed -n '350,425p' vendor/session.js\"","aggregated_output":"170:  var probeFn = null;\n382:  hub.time = function () {\n430:    if (finite(given.time)) fields.time = Number(given.time);\n467:  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n468:  hub.probe = function (fn) {\n469:    probeFn = typeof fn === 'function' ? fn : null;\n472:  hub.inspect = function () {\n473:    if (!probeFn) return null;\n475:      return JSON.parse(JSON.stringify(probeFn()));\n\n  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n  hub.send = function (data, opts) {\n    if (!welcomed || ended) return false;\n    opts = opts || {};\n    var text;\n    try {\n      text = JSON.stringify(data);\n    } catch (e) {\n      warn('send: data is not JSON');\n      return false;\n    }\n    if (text === undefined) return false;\n    if (text.length > limits.maxBytes) {\n      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n      return false;\n    }\n    var t = now();\n    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n    refilled = t;\n    if (tokens < 1) {\n      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n      return false;\n    }\n    tokens -= 1;\n    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n    post('send', fields);\n    return true;\n  };\n\n  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n  hub.time = function () {\n    return goAt === null ? -Infinity : now() - goAt;\n  };\n\n  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n  hub.rng = function (label) {\n    var h = 2166136261;\n    var s = String(label === undefined ? '' : label);\n    for (var i = 0; i < s.length; i++) {\n      h ^= s.charCodeAt(i);\n      h = Math.imul(h, 16777619);\n    }\n    return generator((hub.seed ^ h) >>> 0);\n  };\n\n  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n  function finite(v) {\n    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n  }\n\n  /**\n   * The whole outcome as plain JSON, field by field: the hub checks and trims\n   * it, so new optional fields need no new client. A field that is not JSON\n   * (a cycle, a BigInt) is left out, not the whole outcome.\n   */\n  function outcomeOf(outcome) {\n    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n      warn('the outcome is not a plain object');\n      return null;\n    }\n    var copy = {};\n    for (var key in outcome) {\n      if (!own(outcome, key)) continue;\n      var value = json(outcome[key]);\n      if (value !== undefined) copy[key] = value;\n      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n    }\n    return copy;\n  }\n\n  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n  hub.result = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    var fields = outcomeOf(outcome);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"cat >> src/game/director.js <<'EOF'\n ending(){this.disposeEvent();this.setScreen('ending');this.endingBeat=-1;this.island.root.visible=true;this.island.walker.setTranslation({x:0,y:.81,z:0},true);this.audio.setTrack('level');this.ui.clearHud();this.ui.clear();this.audio.sfx('bell');}\n afterEnding(){let p=this.profile;if(p&&p.day<=5){p.stamps.push({day:5,date:new Date().toLocaleDateString()});p.day=6;p.done=[];p.checkDone=false;p.levelled=true;p.steps=TOTAL_STEPS;this.save.write();}this.morning();}\n startAttract(){if(this.session)return;this.attract=true;this.attractIndex=-1;this.attractT=0;this.nextAttract();}\n nextAttract(){this.disposeEvent();const sequence=['island','fruit','cairn','step','plates','spring','raft','service','poses','water','log','plank','tug','loop','grand'];this.attractIndex=(this.attractIndex+1)%sequence.length;this.attractId=sequence[this.attractIndex];this.attractT=0;this.setScreen('attract');if(this.attractId==='island'){this.island.root.visible=true;}else{this.island.hide();this.buildEvent(this.attractId,1,{configs:[{name:'Gentle Margaret',colour:COLOURS[0],kind:'bot',skill:'sharp'}],god:this.attractId\"'!=='\"'fruit'});this.event.start();this.ui.eventHud(this.event);}this.ui.show(\"'`<div class=\"demo-title tag\">${TITLE}</div><div class=\"demo-banner tag\">DEMO · ${this.attractId==='\"'island'?'A little off.':REGISTRY[this.attractId].title} · Press any button</div>\"'`);}\n stopAttract(){this.attract=false;this.disposeEvent();this.input.clear();this.title();}\n fx(text,x=0,y=1,z=0){let v=label(text,'\"'#392d3c','#fff0cc',.33);v.position.set(x,y,z);(this.event?.group||this.island.root).add(v);this.effects.push({v,t:1.4});}\n splash(x,y,z,size=1){for(let i=0;i<14;i++){let a=i*Math.PI/7,v=ball(this.event?.group||this.island.root,0xc9f1e0,x,y,z,.09*size);this.effects.push({v,t:1.2,vx:Math.cos(a)*size,vy:2.5+Math.sin(i)*size,vz:Math.sin(a)*size});}}\n bark(situation){if(this.simTime-(this.lastBark||-10)<6)return;this.lastBark=this.simTime;const text=line(situation);this.audio.say(text,'Trudy');this.ui.toast(text,4);}\n driveBot(){if(\"'!this.event||!['\"'play','countdown'].includes(this.screen)||\"'!this.testBot)return;let p=window.__pads?.[0];if(!p)return;const l=this.event.lanes[0],s=this.event.botInput(l,this.event.t,this.testBot),old=p.buttons.map(b=>b.value);p.axes[0]=s.x||0;p.axes[1]=s.z||0;const set=(n,val)=>p.buttons[n]={value:val||0,pressed:(val||0)>.5};set(0,s.hopPress?1:s.hop?1:0);set(2,s.flailPress?1:0);set(5,s.breathe?1:0);set(6,s.leftPress?1:s.left||0);set(7,s.rightPress?1:s.right||0);}\n fixed(dt){if(this.session?.ended)return;this.driveBot();const direct=this.screen==='\"'island'||['raft','loop','spring'].includes(this.event?.id),s=this.input.poll(dt,direct);this.lastInput=s;this.ui.updatePrompts();\n if(this.session){this.simTime+=dt;this.session.fixed(dt,s);if(this.screen==='settings')this.ui.poll(dt,s);return;}\n if(s.pause&&this.screen==='pause'){this.resume();return;}if(s.pause&&this.screen==='settings'){this.returnSettings();return;}if(s.pause&&this.screen==='dev'){this.setScreen('pause');this.pauseMenu();return;}\n if(s.pause&&\"'!['\"'menu','title','settings','pause','dev','about','groupLobby'].includes(this.screen)){this.pause();return;}\n const paused=['pause','settings','how','dev','resetConfirm'].includes(this.screen);if(\"'!paused){this.simTime+=dt;this.stateTime+=dt;this.scheduler.fixed(dt);}\n if(['\"'title','menu'].includes(this.screen)){this.idle+=dt;if(this.idle>=10){this.startAttract();return;}}\n if(this.attract){this.attractT+=dt;if(this.attractId==='island')this.island.fixed(dt,{x:Math.sin(this.attractT*.45),z:Math.cos(this.attractT*.45),rawX:Math.sin(this.attractT*.45),rawZ:Math.cos(this.attractT*.45),lookX:.08},'tutorial');else if(this.event&&\"'!this.event.done)this.event.fixed(dt);if(this.attractT>=18)this.nextAttract();return;}\n if(this.screen==='\"'groupLobby