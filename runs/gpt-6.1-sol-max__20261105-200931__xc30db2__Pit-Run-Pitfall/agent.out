{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"cat >> style.css <<'EOF'\n@media(max-height:600px){\n #screen.title-screen{padding:3vh 5vw}\n .brand-overline{font-size:.5rem;margin-bottom:.4rem}\n .game-title{font-size:clamp(60px,16vh,94px);margin:.5rem 0 .8rem}\n .title-tagline{font-size:.85rem;margin:.6rem 0 .8rem;line-height:1.35}\n .title-buttons{gap:.3rem}\n .title-buttons .menu-button{min-height:2.15rem;padding:.4rem .8rem;font-size:.8rem}\n .title-note{top:8%;width:11rem}\n .title-note strong{font-size:1.15rem}\n .title-bottom{bottom:-4vh;font-size:.45rem}\n .panel{max-height:92vh}\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('qa.py');s=p.read_text().replace('                check(\\\"touch browser suite\\\", lambda: touch_checks(browser, base))','                if \\\"--core-only\\\" in sys.argv:\\\\n                    browser.close()\\\\n                    return\\\\n                check(\\\"touch browser suite\\\", lambda: touch_checks(browser, base))')\n# Keep the main runner unified; the extra flag is deliberately not shipped.\ns=s.replace('                if \\\"--core-only\\\" in sys.argv:\\\\n                    browser.close()\\\\n                    return\\\\n','')\np.write_text(s)\nPY\nbiome format --write graphics.js audio.js world.js input.js network.js game.js ui.js bootstrap.js build.mjs playthrough.js style.css template.html package.json\nshfmt -w test.sh\nshellcheck test.sh\nnode build.mjs\nnode --check combined-check.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
