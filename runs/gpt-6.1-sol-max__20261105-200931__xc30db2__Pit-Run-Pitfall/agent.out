is.testInput=null;\\\",\\\"this.roundId=0;this.remoteRound=null;this.testInput=null;\\\")\ns=s.replace(\\\"this.clearPlayers();this.world.reset();this.events=[];\\\",\\\"this.clearPlayers();this.roundId++;this.controls.jumpSerial=0;this.world.reset();this.events=[];\\\")\ns=s.replace(\\\"jumpPrev:false,actionPrev:false\\\",\\\"jumpPrev:false,jumpSerial:0,actionPrev:false\\\")\ns=s.replace(\\\"const jump=f.jump&&\"'!p.jumpPrev,action=f.action&&!p.actionPrev;\",\"const token=[REDACTED_SECRET]'\"\\\\n  const jump=(f.jump&&\"'!p.jumpPrev)||token!==p.jumpSerial,action=f.action&&!p.actionPrev;p.jumpSerial=token;\")\ns=s.replace(\"return {type:'\"'snapshot',t:\\\",\\\"return {type:'snapshot',round:this.roundId,t:\\\")\ns=s.replace(\\\"if(\"'!Array.isArray(s.players)||!Array.isArray(s.found))return;\",\"if(!Array.isArray(s.players)||!Array.isArray(s.found))return;'\"\\\\n  if(s.round\"'!==this.remoteRound){this.remoteRound=s.round;this.net.lastEvent=0;this.ui.close();}\")\ns=s.replace(\"this.encounter(p);if(this.state==='\"'playing')this.collect(p);\\\",\\\"this.encounter(p);if(p.y<-4)p.layer=1;if(this.state==='playing')this.collect(p);\\\")\np.write_text(s)\np=Path('qa.py');s=p.read_text().replace('str(error).split(\\\"Call log:\\\")[0].strip()','str(error).strip()[:1800]');p.write_text(s)\nPY\nnode build.mjs\nnode --check combined-check.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
