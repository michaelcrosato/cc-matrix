d(x,-.65,w,1.3);\n  const reg=REGIONS.reduce((r,v)=>x>=v.x?v:r,REGIONS[0]);\n  shape(this.root,'box',0x6b5738,x,-2.05,-.1,w,4,4);\n  shape(this.root,'box',reg.color,x,-.11,-.05,w,.23,4.2);\n  shape(this.root,'box',0x9baa62,x,-.01,2.07,w,.13,.12,false);\n  for(let xx=a+.5;xx<b;xx+=rnd(1.7,3.8)){\n   shape(this.root,'rough',rand()>.5?0x8d744b:0x4c5034,xx,-rnd(.8,3.8),2.025,rnd(.2,.65),rnd(.12,.35),.035,false);\n   if(rand()<.65)curve(this.root,[[xx,-.2,2.04],[xx+.2,-1.1,2.04],[xx-.1,-1.9,2.04]],.025,0x384c30);\n  }\n }\n palm(x,z,h=9){\n  const g=new THREE.Group();g.position.set(x,0,z);this.root.add(g);\n  const bend=rnd(-1.8,1.8);\n  curve(g,[[0,0,0],[bend*.3,h*.45,0],[bend,h,0]],.35,0x486443,true);\n  for(let j=0;j<6;j++){\n   const angle=j*TAU/6,r=3.7;\n   const pts=[[bend,h,0],[bend+Math.cos(angle)*r*.6,h+.55,Math.sin(angle)*1.2],[bend+Math.cos(angle)*r,h-.9,Math.sin(angle)*2]];\n   curve(g,pts,.2,j%2?0x398257:0x559954);\n   for(let k=1;k<5;k++){\n    const t=k/5,xx=lerp(bend,pts[2][0],t),yy=h+Math.sin(t*Math.PI)*.5-t*.9,zz=pts[2][2]*t;\n    const m=shape(g,'rough',j%2?0x3e8653:0x70a458,xx,yy,zz,.75*(1-t*.5),.1,.4,false);m.rotation.z=-Math.cos(angle)*.4;\n   }\n  }\n  for(let i=0;i<3;i++)shape(g,'ball',0x8f784a,bend+rnd(-.3,.3),h-.4,rnd(-.3,.3),.22,.24,.22);\n }\n fern(x,y,z,size=1){\n  const g=new THREE.Group();g.position.set(x,y,z);g.scale.setScalar(size);this.root.add(g);\n  for(let side=-1;side<=1;side+=2)for(let i=0;i<4;i++){\n   const angle=.25+i*.38;\n   const f=shape(g,'rough',i%2?0x2d7452:0x61954c,side*Math.sin(angle)*.7,Math.cos(angle)*.7,0,.22,.9,.12,false);f.rotation.z=-side*angle;\n  }\n }\n buildNature(){\n  for(let x=-6;x<247;x+=rnd(7,11))this.palm(x,rnd(-6,-3),rnd(8.3,12.5));\n  for(let x=-5;x<246;x+=rnd(2.5,5)){\n   if(PITS.some(p=>x>p.a&&x<p.b)||LADDERS.some(l=>Math.abs(l-x)<1.2))continue;\n   this.fern(x,0,rnd(-1.3,-.9),rnd(.55,1.1));\n   if(rand()<.4){shape(this.root,'rough',0x829467,x,.12,1.5,rnd(.2,.5),.3,.4);}\n   if(rand()<.2){\n    for(let i=0;i<3;i++){const xx=x+i*.22;rod(this.root,[xx,0,1.5],[xx,.6,1.5],.025,0x709456,false);shape(this.root,'ball',0xf3b56c,xx,.65,1.5,.12,.15,.09,false);}\n   }\n  }\n  // Foreground leaves frame the diorama without covering the running lane.\n  for(let x=-8;x<248;x+=rnd(7,12)){\n   this.fern(x,-1.5,4.2,rnd(1.3,2));\n   if(rand()<.35){const m=shape(this.root,'rough',0x1a5848,x,8.5,3.8,2.7,1.2,.25,false);m.rotation.z=rnd(-.5,.5);}\n  }\n  for(let i=0;i<55;i++){\n   const m=shape(this.root,'ball',i%4===0?0xffe19a:0xd3e6a0,rnd(-5,242),rnd(.6,6),rnd(-1,2),.035,.035,.035,false);\n   this.bugs.push({m,x:m.position.x,y:m.position.y,phase:rnd(0,TAU)});\n  }\n  for(const x of [34,78,115,186,224]){\n   for(let i=0;i<3;i++){const m=shape(this.root,'cone',0xffa95a,x+rnd(-1,1),rnd(1,3),-1,.11,.23,.05,false);this.bugs.push({m,x:m.position.x,y:m.position.y,phase:rnd(0,TAU)});}\n  }\n }\n makeCroc(x){\n  const g=new THREE.Group();g.position.set(x,-.07,0);this.root.add(g);\n  shape(g,'rough',0x518851,-.15,-.15,0,1.08,.3,.56);\n  shape(g,'cone',0x42774a,-1.2,-.15,0,.34,1.2,.35).rotation.z=Math.PI/2;\n  const jaw=new THREE.Group();jaw.position.set(.2,.05,0);g.add(jaw);\n  shape(jaw,'box',0x78a15d,.55,.1,0,1.1,.2,.58);\n  shape(g,'box',0xc5cb8a,.75,-.19,.05,1.2,.1,.6);\n  for(let i=0;i<5;i++){shape(jaw,'cone',0xffe8b8,.15+i*.21,-.075,.27,.05,.13,.05,false).rotation.z=Math.PI;shape(g,'cone',0xffe8b8,.32+i*.21,-.08,.29,.05,.13,.05,false);}\n  shape(jaw,'ball',0xd1bc6c,.2,.3,.3,.12,.13,.09);\n  shape(jaw,'ball',0x122f28,.23,.33,.37,.035,.05,.02,false);\n  for(let i=0;i<5;i++)shape(g,'cone',0x315e3b,-.9+i*.3,.12,-.12,.12,.23,.15);\n  const c=this.fixed(x,-.19,1.9,.4);\n  this.crocs.push({x,g,jaw,c,phase:x*.37,open:false});\n }\n makeSnake(x,y=0){\n  const g=new THREE.Group();g.position.set(x,y,.2);this.root.add(g);\n  const co=shape(g,'torus',0xa8ac55,0,.3,0,.36,.25,.32);co.rotation.x=Math.PI/2;\n  curve(g,[[.15,.2,0],[.3,.6,0],[.15,1,0]],.11,0xb0bb5b,true);\n  const head=shape(g,'ball',0xc5