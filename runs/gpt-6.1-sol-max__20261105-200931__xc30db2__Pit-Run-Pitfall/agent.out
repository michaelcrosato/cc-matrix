{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"cat > Pit-Run-Pitfall-gpt-6.1-sol-max-20261105-200931/smoke.py <<'EOF'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json\nROOT=Path(__file__).parent\nerrors=[]\nwith sync_playwright() as p:\n    browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-dev-shm-usage'])\n    ctx=browser.new_context(viewport={'width':1600,'height':900})\n    def asset(route):\n        url=route.request.url\n        name=url.split('/')[-1].split('?')[0]\n        if name in ['three.webgpu.js','three.core.js','three.tsl.js','rapier.mjs']:\n            route.fulfill(path=str(ROOT/'vendor'/name),content_type='text/javascript',headers={'Access-Control-Allow-Origin':'*'})\n        else: route.continue_()\n    ctx.route('https://cdn.jsdelivr.net/**',asset)\n    page=ctx.new_page()\n    page.on('pageerror',lambda e: errors.append(str(e)))\n    page.on('console',lambda m: errors.append(m.text) if m.type=='error' else None)\n    page.goto('http://127.0.0.1:39775/Pit-Run-Pitfall-gpt-6.1-sol-max-20261105-200931.html')\n    try:\n        page.wait_for_function('window.__gameReady === true',timeout=120000)\n        page.screenshot(path=str(ROOT/'title.png'))\n        state=page.evaluate('({state:__game.state,backend:__game.backend,objects:__game.scene.children.length,revision:__game.renderer.constructor.name})')\n        (ROOT/'smoke-state.json').write_text(json.dumps(state,indent=2))\n        page.get_by_role('button',name='Begin expedition').click()\n        page.wait_for_timeout(1500)\n        page.keyboard.down('KeyD')\n        page.keyboard.press('Space')\n        page.wait_for_timeout(800)\n        page.keyboard.up('KeyD')\n        page.screenshot(path=str(ROOT/'gameplay.png'))\n        (ROOT/'smoke-gameplay.json').write_text(json.dumps(page.evaluate('({state:__game.state,x:__game.primary().x,y:__game.primary().y,hp:__game.primary().health,frames:__game.frames,audio:__game.audio.rms()})'),indent=2))\n    except Exception as e:\n        errors.append(str(e))\n        (ROOT/'smoke-error.txt').write_text(page.locator('#loadMessage').inner_text())\n    browser.close()\nfor e in errors: print('FAIL:',e)\nprint(str(len(errors))+' failures; smoke completed')\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python smoke.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
