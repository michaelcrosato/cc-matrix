absolute;left:1rem;top:7rem;z-index:7;font-family:monospace;font-size:.5rem;line-height:1.6;padding:.6rem;background:#0a2028cd;pointer-events:none;white-space:pre}\n#letterbox{position:absolute;inset:0;pointer-events:none;z-index:6;border-block:7vh solid #081e24}#cinematicText{position:absolute;bottom:-4.5vh;left:0;right:0;text-align:center;font-size:.65rem;letter-spacing:.15em;color:var(--gold)}.menu-hint{font-size:.54rem;color:#a4ba99;margin:1.1rem 0 0}.trail-map{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.9rem 0;margin:.8rem 0;border-block:1px solid #bdcfa329}.trail-map span{color:var(--gold);font-size:.58rem;line-height:1.7;text-align:center}.trail-map i{height:1px;background:#b6c9a640;flex:1}.tiny{font-size:.6rem;color:#9db794;line-height:1.6}.danger{color:#ffb28e}a{color:var(--gold)}\n@media(max-width:700px){:root{font-size:17px}.game-title{font-size:19vw;max-width:90vw}.title-tagline{font-size:.85rem;max-width:20rem}.title-buttons{width:min(80vw,24rem)}.title-note{display:none}.brand-overline{font-size:.5rem}.title-bottom{font-size:.45rem;bottom:-4vh}.panel{padding:1.2rem 1.4rem;width:94vw;max-height:92vh}.panel h2{font-size:1.9rem}.control-grid{gap:.6rem}.control-card{padding:.65rem}.credits-list{grid-template-columns:5.5rem 1fr;font-size:.6rem}.hud-right{gap:.6rem}.hud-right b{font-size:1.1rem}.hearts{font-size:.68rem}#mission{max-width:70vw;font-size:.55rem}#route{bottom:3vh;width:40%;left:30%}#treasurePips{gap:.17rem}#treasurePips i{font-size:1rem}.title-bottom .right{display:none}#contextPrompt{font-size:.6rem;bottom:12%}#toastText{font-size:1.2rem}}\n@media(pointer:coarse){#mission,#route{display:none}.hud-left .eyebrow{font-size:.43rem}.hud-right .hearts{display:none}#hud{padding:1.2rem}.hud-left{top:1rem;left:1rem}.hud-right{top:1rem;right:1rem}#contextPrompt{bottom:7%;background:transparent;border:0;text-shadow:0 2px 3px #061a20}#clock{font-size:1rem}}\nEOF'","aggregated_output":"","exit_code":0,"status":"complete