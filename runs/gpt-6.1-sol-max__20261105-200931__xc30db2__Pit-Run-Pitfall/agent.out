{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,80p' playthrough.js; rg -n 'tuning:|remoteRound|leave.*bc|departed' network.js game.js\"","aggregated_output":"// Deterministic controller bot. Uses the shipped movement controller, Rapier,\n// vine attachment/release, both ladders, all six pickups and the final gate.\n// Invulnerability removes damage variance; it does not bypass collision or travel.\nfunction scriptedExpedition() {\n\tresetRun();\n\tconst a = __game,\n\t\tp = a.primary();\n\ta.dev.god = true;\n\tconst priorMute = a.audio.muted;\n\ta.audio.muted = true;\n\tconst log = [];\n\tlet frames = 0,\n\t\tjumpHold = 0;\n\tconst frame = (f) => {\n\t\tif (++frames > 22000)\n\t\t\tthrow Error(\n\t\t\t\t\"playthrough exceeded frame limit at \" +\n\t\t\t\t\tJSON.stringify({ x: p.x, y: p.y, state: a.state }),\n\t\t\t);\n\t\ta.testInput = { 0: { x: 0, y: 0, jump: false, action: false, ...f } };\n\t\ta.step(1 / 60);\n\t};\n\tconst dangerAhead = () => {\n\t\tif (p.layer)\n\t\t\treturn a.world.scorpions.some((s) => s.x - p.x > 0 && s.x - p.x < 1.9);\n\t\treturn (\n\t\t\ta.world.logs.some((s) => s.x - p.x > 0 && s.x - p.x < 2) ||\n\t\t\ta.world.snakes.some((s) => s.x - p.x > 0 && s.x - p.x < 1.9) ||\n\t\t\ta.world.fires.some((s) => !s.decor && s.x - p.x > 0 && s.x - p.x < 1.9)\n\t\t);\n\t};\n\tconst groundWalk = (target) => {\n\t\tfor (let i = 0; i < 1800 && Math.abs(p.x - target) > 0.22; i++) {\n\t\t\tif (p.grounded && dangerAhead() && jumpHold === 0) jumpHold = 24;\n\t\t\tframe({ x: Math.sign(target - p.x), jump: jumpHold > 0 });\n\t\t\tjumpHold = Math.max(0, jumpHold - 1);\n\t\t}\n\t\tif (Math.abs(p.x - target) > 0.5)\n\t\t\tthrow Error(\n\t\t\t\t\"walk blocked at \" + JSON.stringify({ x: p.x, y: p.y, target }),\n\t\t\t);\n\t};\n\tconst cross = (pit) => {\n\t\tgroundWalk(pit.a - 2);\n\t\tfor (let i = 0; i < 120 && !p.grounded; i++) frame({});\n\t\tconst v = a.world.vines.find(\n\t\t\t(v) => Math.abs(v.x - (pit.a + pit.b) / 2) < 0.1,\n\t\t);\n\t\tlet ready = false;\n\t\tfor (let i = 0; i < 700; i++) {\n\t\t\tconst derivative = Math.cos(\n\t\t\t\ta.simTime * a.tuning.hazardSpeed * 0.82 + v.phase,\n\t\t\t);\n\t\t\tif (v.end.x < pit.a + 1.2 && derivative > 0 && p.grounded) {\n\t\t\t\tready = true;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\tframe({});\n\t\t}\n\t\tif (!ready) throw Error(\"vine never reached bank \" + pit.a);\n\t\tjumpHold = 0;\n\t\tframe({});\n\t\tfor (let i = 0; i < 65 && p.swing === null; i++)\n\t\t\tframe({ x: 1, jump: true });\n\t\tif (p.swing === null)\n\t\t\tthrow Error(\n\t\t\t\t\"missed vine \" +\n\t\t\t\t\tJSON.stringify({ pit: pit.a, x: p.x, y: p.y, end: v.end.toArray() }),\n\t\t\t);\n\t\tframe({ x: 1, jump: false });\n\t\tfor (let i = 0; i < 600; i++) {\n\t\t\tif (v.end.x > pit.b - 1.7 && Math.cos(a.simTime * 0.82 + v.phase) > 0)\n\t\t\t\tbreak;\n\t\t\tframe({ x: 1 });\n\t\t}\n\t\tframe({ x: 1, jump: true });\n\t\tfor (let i = 0; i < 100; i++) {\n\t\t\tframe({ x: 1, jump: i < 18 });\n\t\t\tif (p.x > pit.b + 0.7 && p.grounded) break;\n\t\t}\ngame.js:36:\t\tthis.remoteRound = null;\ngame.js:1101:\t\t\ttuning: this.tuning,\ngame.js:1108:\t\tif (s.round !== this.remoteRound) {\ngame.js:1109:\t\t\tthis.remoteRound = s.round;\nnetwork.js:14:\t\tthis.departed = new Set();\nnetwork.js:35:\t\t\tthis.departed.add(id);\nnetwork.js:91:\t\tif (data.type === \"leave\" && this.bc) {\nnetwork.js:145:\t\t\t\t? this.info.players.filter((p) => !this.departed.has(p.id))\nnetwork.js:276:\t\tthis.departed.clear();\n","exit_code":0,"status":"completed"}}
