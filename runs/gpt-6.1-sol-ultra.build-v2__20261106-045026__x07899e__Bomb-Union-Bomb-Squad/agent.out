{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"sed -n '340,388p' src/sim/model.js; sed -n '1,85p' tests/net-hub.py; cat evidence/campaign-browser.json | tail -16; rg -n 'function results|medals:|Return to title|game.resume=' src/main.js\"","aggregated_output":"    return fail('Unknown tool operation.');\n  }\n  function advance(s,dt) {\n    if(s.status!=='active'||!Number.isFinite(dt)||dt<=0)return;\n    let remaining=dt*s.tuning.timeScale;\n    // Bound internal steps so hazard and expiry ordering do not depend on renderer cadence.\n    while(remaining>1e-8&&s.status==='active'){\n      const step=Math.min(remaining,1/60,s.remaining);\n      if(step<=0){terminalOutcome(s,'lost','time-expired');break;}\n      remaining-=step;s.elapsed+=step;s.remaining=Math.max(0,s.remaining-step);\n      for(const b of s.boards){\n        const h=b.hold;\n        if(h){\n          h.duration+=step;\n          if(h.tool==='solder'){\n            b.heat+=step*s.tuning.heatGain*(h.duration>s.tuning.solderMax?3:0.4);\n            ignite(s,b);\n          }\n          if(h.duration>=s.tuning.maxHold){b.hold=null;emit(s,'hold-timeout','Tool hold released safely after its maximum duration.',{board:b.id});}\n        }else if(!b.fire)b.heat=Math.max(0,b.heat-step*s.tuning.cooling);\n        if(b.fire)b.heat=Math.min(160,b.heat+step*2*s.tuning.fireIntensity);\n        if(b.recovery&&!b.recovery.overdue){\n          b.recovery.remaining=Math.max(0,b.recovery.remaining-step);\n          if(b.recovery.remaining<=1e-7){\n            b.recovery.overdue=true;s.remaining=Math.max(0,s.remaining-s.tuning.penalty);b.heat+=25;\n            s.metrics.penalties++;ignite(s,b);\n            emit(s,'penalty',`PIP: Recovery window missed. ${s.tuning.penalty} fuse seconds lost. The joint can still be restored.`,{board:b.id});\n          }\n        }\n      }\n      // At the exact deadline expiry wins; no proposal can also resolve successfully.\n      if(s.remaining<=1e-7){s.remaining=0;terminalOutcome(s,'lost','time-expired');break;}\n      if(s.proposal){s.proposal.remaining-=step;votes(s);}\n    }\n  }\n  function instruction(s,id) {\n    const b=board(s,id);if(!b)return 'Choose an evidence sector to claim a repair board.';\n    if(b.complete)return 'Board secure. Evidence published. Return to the stencil display.';\n    if(b.fire)return `FIRE · ${b.name}: hold the extinguisher, then release when the foam band fills.`;\n    if(b.recovery){const r=b.recovery;return `RESTORE ${r.component} ${r.terminal===0?'LEFT':'RIGHT'} lead with solder${r.overdue?' · penalty applied':` · ${Math.ceil(r.remaining)}s recovery`}.`;}\n    const c=component(b,b.order[b.step]);\n    if(!c)return 'Repair complete. Clear any remaining hazard.';\n    const label=`${c.id} · ${c.shape.toUpperCase()} · ${B.COLORS[c.color]?.label||c.color}`;\n    if(!c.removed){if(!c.cuts[0])return `CUT ${label}: left terminal first.`;if(!c.cuts[1])return `CUT ${label}: now the right terminal.`;return `GRIP ${label}: both leads free; lift it out.`;}\n    if(!c.part){if(b.held)return `PLACE held ${b.held} in ${label}'s empty socket.`;return `PICK ${c.kind==='jumper'?'a gray jumper':`a spare matching ${b.ruleKnown?b.rule.toUpperCase():'the board rule — inspect/test to discover it'}`} for ${label}.`;}\n    if(!compatible(b,c,b.spares.find(p=>p.id===c.part)))return `WRONG SPARE in ${c.id}: GRIP it out, then choose another. Stock is reusable.`;\n    return `SOLDER ${label}: ${!c.joints[0]?'LEFT':'RIGHT'} terminal. Hold, then release in the safe band.`;\n  }\n  function nextAction(s,id) {\n\"\"\"Run the official Hub automatic harness against a game or transport fixture.\"\"\"\n\nimport functools\nimport http.server\nimport json\nimport pathlib\nimport sys\nimport threading\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\nBASE = pathlib.Path(__file__).resolve().parent.parent\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\ndef run():\n    game = sys.argv[1] if len(sys.argv) > 1 else \"/tests/net-hub.html\"\n    directory = BASE.parent if len(sys.argv) > 1 else BASE\n    prefix = \"/\" + BASE.name if directory == BASE.parent else \"\"\n    handler = functools.partial(QuietHandler, directory=str(directory))\n    server = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    results = []\n    browser = None\n    try:\n        with sync_playwright() as p:\n            browser = p.chromium.launch(headless=True)\n            context = browser.new_context()\n            page = context.new_page()\n            scenarios = [\n                (\"standard\", {\"players\": 2}),\n                (\"lagged\", {\"players\": 4, \"latency\": 150, \"jitter\": 50, \"loss\": 5}),\n                (\"host-leave\", {\"players\": 2, \"scenario\": \"host-leave\"}),\n                (\"server\", {\"players\": 2, \"scenario\": \"server\"}),\n            ]\n            if len(sys.argv) > 2:\n                scenarios = [item for item in scenarios if item[0] == sys.argv[2]]\n            for name, args in scenarios:\n                query = urlencode({\"game\": game, \"auto\": 1, \"play\": 2500, **args})\n                page.goto(\n                    f\"http://127.0.0.1:{server.server_port}{prefix}/vendor/hub/harness.html?{query}\"\n                )\n                page.wait_for_function(\n                    \"document.body.dataset.complete==='true'\", timeout=55000\n                )\n                report = page.evaluate(\"window.__hubCheck\")\n                if name != \"host-leave\":\n                    states = page.evaluate(\"\"\"() => Array.from(document.querySelectorAll('iframe')).map(f=>{\n                      const n=f.contentWindow.BU?.app?.net || f.contentWindow.net;\n                      return n?.state ? n.state : null;\n                    }).filter(Boolean)\"\"\")\n                    same = len(states) >= 2 and all(\n                        state == states[0] for state in states[1:]\n                    )\n                    (BASE / \"evidence\" / f\"net-hub-state-{name}.json\").write_text(\n                        json.dumps(states, indent=2)\n                    )\n                    report[\"checks\"].append(\n                        {\n                            \"name\": \"final authoritative game-state agreement\",\n                            \"pass\": same,\n                            \"detail\": f\"{len(states)} copies compared\",\n                        }\n                    )\n                    report[\"pass\"] = report[\"pass\"] and same\n                results.append({\"scenario\": name, **report})\n                if not report[\"pass\"]:\n                    for check in report[\"checks\"]:\n                        if not check[\"pass\"]:\n                            print(\"FAIL: Hub\", name, check[\"name\"], check[\"detail\"])\n            context.close()\n            browser.close()\n            browser = None\n    except Exception as error:  # noqa: BLE001 - test runner must persist failures\n        results.append({\"scenario\": \"runner\", \"pass\": False, \"error\": str(error)})\n        print(\"FAIL: Hub runner\", str(error))\n    finally:\n        if browser:\n            browser.close()\n{\n  \"group\": \"campaign-browser\",\n  \"checks\": 21,\n  \"failures\": [],\n  \"actions\": 13,\n  \"artifact\": \"Bomb-Union-Bomb-Squad-gpt-6.1-sol-ultra-20261106-045026.html\"\n}27:game.resume=()=>{nativeResume();if(!(app.net?.mode==='hub'&&app.net?.ended))app.audio.suspend?.(false);};\n121:function results(){\n124: setPage('results',{kicker:won?(s.caseId==='central'?'THE CITY GETS ANOTHER MORNING':'DISPOSAL COMPLETE'):'INCIDENT REPORT',title:won?'Clock stopped. City saved.':s.cause==='time-expired'?'The fuse ra [... omitted end of long line]\n132:app.net=new B.Network({onState:s=>{app.state=s;},onStart:s=>{ui.hide();startCase(s.caseId,s.seed,s);},onStatus:text=>{if(app.screen==='lobby')lobby();},onRoster:()=>{if(app.screen==='lobby')lobby();}, [... omitted end of long line]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read();s=s.replace(\\\"app.lastEvent=0;proposalSeen=null;app.boardId=null;\\\", \\\"app.lastEvent=snapshot?.eventId||0;proposalSeen=null;app.boardId=null;\\\")\ns=s.replace(\\\"/recover|fire|wrong|fail|fault|penalty/.test(type)\\\",\\\"/recover|fire|wrong|fail|fault|penalty|test/.test(type)\\\")\ns=s.replace(\\\"if(app.devApplying&&app.state&&app.net?.mode\"'!=='\"'hub'\\\", \\\"if(app.state&&app.net?.mode\"'!=='\"'hub'\\\")\ns=s.replace(\\\"step:1,group:'Authoring'\\\", \\\"step:1,group:'Controls'\\\")\ns=s.replace(\\\"'evidence published':owner?\\\", \\\"'evidence published':b.recovery?\"'`RESTORE · ${Math.ceil(b.recovery.remaining)}s`:owner?\")\ns=s.replace(\"medals:[['\"'Clean work'\\\", \\\"sections:[['Score breakdown',\"'`Disposal ${s.result?.cards?.disposal||0} + fuse time ${s.result?.cards?.time||0} + clean work ${s.result?.cards?.clean||0} + early inference ${s.result?.cards?.inference||0}. Assistance and developer changes are labeled below.`]],medals:[['\"'Clean work'\\\")\ns=s.replace(\\\"const I=game.input;const pad\\\", \\\"if(ui.screen==='settings'&&(app.net.mode==='hub'||app.net.online&&\"'!app.net.authority)){for(const label of Object.values(tuningLabels)){const input=ui.root.querySelector('\"'input[aria-label=\\\\\\\"'+label+'\\\\\\\"]');if(input){input.disabled=true;input.title='Gameplay tuning requires standalone host authority.';}}}\\\\n if(ui.screen==='evidence')for(const b of app.state?.boards||[]){if(b.recovery){const note=ui.root.querySelector('[data-board=\\\\\\\"'+b.id+'\\\\\\\"] small');if(note)note.textContent='RESTORE · '+Math.ceil(b.recovery.remaining)+'s · solder highlighted joint';}}\\\\n const I=game.input;const pad\\\")\nopen(p,'w').write(s)\nPY\nnode --check src/main.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
