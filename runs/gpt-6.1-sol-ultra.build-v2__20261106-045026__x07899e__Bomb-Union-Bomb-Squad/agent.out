ker.toLowerCase().includes(\"tick\") ? \"saboteur\" : \"partner\",\n\t\t\tapp.caption,\n\t\t\tpriority ? 2 : 1,\n\t\t);\n\t}\n\tfunction events() {\n\t\tif (!app.state) return;\n\t\tfor (const e of app.state.events || []) {\n\t\t\tif (e.id <= app.lastEvent) continue;\n\t\t\tapp.lastEvent = e.id;\n\t\t\tapp.art.event?.(e);\n\t\t\tconst type = e.type || \"\";\n\t\t\tapp.audio.effect?.(type);\n\t\t\tif (e.text)\n\t\t\t\tmessage(\n\t\t\t\t\te.text,\n\t\t\t\t\ttype.includes(\"taunt\") ? \"DR. TICK\" : \"PIP\",\n\t\t\t\t\t/recover|fire|wrong|fail|fault|penalty|test/.test(type),\n\t\t\t\t);\n\t\t}\n\t}\n\tfunction setTool(t) {\n\t\tif (!tools.includes(t)) return;\n\t\tcancelHold();\n\t\tapp.tool = t;\n\t\tapp.audio.effect?.(\"select\");\n\t}\n\tfunction cancelHold() {\n                        any(\n                            e[\"type\"] == \"test\" and e.get(\"pass\") is True\n                            for e in state()[\"state\"][\"events\"]\n                        ),\n                        \"Actual test socket reports passing diagnostic information.\",\n                    )\n                    if wrong_part:\n                        wrong = next(\n                            p\n                            for p in b[\"spares\"]\n                            if p[\"available\"] and p[rule] != c[rule]\n                        )\n                        click_target(\"spare:\" + wrong[\"id\"])\n                        click_target(component_id + \":body\")\n                        check(\n                            any(\n                                e[\"type\"] == \"wrong-part\"\n                                for e in state()[\"state\"][\"events\"]\n                            ),\n                            \"Wrong spare produces failed continuity through ordinary controls.\",\n                        )\n                        click_target(component_id + \":body\")\n                        check(\n                            next(\n                            