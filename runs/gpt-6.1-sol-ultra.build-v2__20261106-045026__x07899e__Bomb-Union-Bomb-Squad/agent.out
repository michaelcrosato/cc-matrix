 ],\n              \"shape\": \"capacitor\",\n              \"color\": \"coral\",\n              \"pattern\": \"dots\",\n              \"kind\": \"jumper\",\n              \"cuts\": [\n                false,\n                false\n              ],\n              \"removed\": false,\n              \"part\": null,\n              \"joints\": [\n                false,\n                false\n              ],\n              \"done\": false\n            },\n            {\n              \"id\": \"C2\",\n              \"x\": 54,\n              \"y\": -24,\n              \"terminals\": [\n                [\n                  -18,\n                  0\n                ],\n                [\n                  18,\n                  0\n                ]\n              ],\n              \"shape\": \"chip\",\n              \"color\": \"amber\",\n              \"pattern\": \"bars\",\n              \"kind\": \"jumper\",\n              \"cuts\": [\n                false,\n                false\n              ],\n              \"removed\": false,\n              \"part\": null,\n              \"joints\": [\n                false,\n                false\n              ],\n              \"done\": false\n            },\n            {\n              \"id\": \"C3\",\n              \"x\": 0,\n              \"y\": 28,\n              \"terminals\": [\n                [\n                  -18,\n                  0\n                ],\n                [\n                  18,\n                  0\n                ]\n              ],\n              \"shape\": \"resistor\",\n              \"color\": \"cyan\",\n              \"pattern\": \"cross\",\n              \"kind\": \"jumper\",\n              \"cuts\": [\n                false,\n                false\n              ],\n              \"removed\": false,\n              \"part\": null,\n              \"joints\": [\n                false,\n                false\n              ],\n              \"done\": false\n            }\n          ],\n    