=groups[page];setPage('credits',{kicker:\"'`ABOUT BOMB UNION · ${page+1} / ${groups.length}`,title:name,sections:items.map(([k,v])=>[k,String(v)]),actions:[['\"'Next page',()=>credits(page+1)],['Previous page',()=>credits(page-1)],['Back',()=>ui.back()]],back:()=>ui.back()});}\napp.credits=credits;\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' src/sim/model.js; cat docs/art-contract.md 2>/dev/null; cat src/net/network.js | head -100\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' src/sim/model.js; cat docs/art-contract.md 2>/dev/null; cat src/net/network.js | head -100\"","aggregated_output":"(function (root) {\n  'use strict';\n  const B = root.BU = root.BU || {};\n  const VERSION = B.CONTENT_VERSION;\n  const clone = value => JSON.parse(JSON.stringify(value));\n  const clamp = (n, a, b) => Math.max(a, Math.min(b, n));\n  const shapes = ['resistor','capacitor','chip'];\n  const colors = ['amber','coral','cyan'];\n  function random(seed) {\n    let a = seed >>> 0;\n    return () => {\n      a += 0x6D2B79F5;\n      let t = a;\n      t = Math.imul(t ^ t >>> 15, t | 1);\n      t ^= t + Math.imul(t ^ t >>> 7, t | 61);\n      return ((t ^ t >>> 14) >>> 0) / 4294967296;\n    };\n  }\n  function shuffle(values, rng) {\n    const list = [...values];\n    for (let i=list.length-1;i>0;i--) {\n      const j = Math.floor(rng()*(i+1));\n      [list[i],list[j]]=[list[j],list[i]];\n    }\n    return list;\n  }\n  function tuning(values={}) {\n    const out = {...B.DEFAULTS};\n    for (const [key,range] of Object.entries(B.TUNING_RANGES)) {\n      const value=Number(values[key]);\n      if (Number.isFinite(value)) out[key]=clamp(value,...range);\n    }\n    out.solderMax=Math.max(out.solderMax,out.solderMin+0.15);\n    out.maxHold=Math.max(out.maxHold,out.solderMax+0.25,out.extinguishTime+0.25);\n    return out;\n  }\n  function candidates(cells) {\n    return B.GLYPHS.map((_,i)=>i).filter(d=>B.GLYPHS[d].every((bit,i)=>cells[i]===-1 || cells[i]==null || bit===cells[i]));\n  }\n  function board(s,id) { return s.boards.find(b=>b.id===id); }\n  function component(b,id) { return b.components.find(c=>c.id===id); }\n  function compatible(b,c,p) {\n    if (!p || !c) return false;\n    return c.kind==='jumper' ? !!p.jumper : !p.jumper && p[b.rule]===c[b.rule];\n  }\n  function emit(s,type,text,data={}) {\n    const e={id:++s.eventId,type,text,...data};\n    s.events.push(e);\n    if (s.events.length>24) s.events.shift();\n    return e;\n  }\n  function makeBoard(def,index,code,rng,party) {\n    const digit=index%def.digits;\n    const sector=Math.floor(index/def.digits);\n    const perDigit=def.boardCount/def.digits;\n    // These authored columns are deliberately interleaved: a sector contains both lit and dark evidence.\n    const cellOrder=[0,5,10,15,16, 1,6,11,12,17, 2,7,8,13,18, 3,4,9,14,19];\n    const begin=Math.floor(sector*20/perDigit), end=Math.floor((sector+1)*20/perDigit);\n    const rule=def.id==='training'||def.id==='waterfront'?'jumper':index%2===0?'shape':'color';\n    const count=def.components + (party>=3 && def.id==='waterfront'?1:0);\n    const shapeOrder=shuffle(shapes,rng), colorOrder=shuffle(colors,rng);\n    const positions=[[-54,-24],[54,-24],[0,28]];\n    const components=positions.map(([x,y],i)=>({\n      id:`C${i+1}`,x,y,terminals:[[-18,0],[18,0]],shape:shapeOrder[i],color:colorOrder[i],\n      pattern:B.COLORS[colorOrder[i]].pattern,kind:rule==='jumper'?'jumper':'replace',\n      cuts:[false,false],removed:false,part:null,joints:[false,false],done:false,\n    }));\n    const order=components.slice(0,count).map(c=>c.id);\n    let spares;\n    if (rule==='jumper') {\n      spares=components.map((c,i)=>({id:`S${i+1}`,shape:'jumper',color:'cyan',pattern:'cross',jumper:true,available:true}));\n    } else {\n      spares=components.map((c,i)=>{\n        const color=rule==='color'?c.color:colorOrder[(i+1)%3];\n        return {id:`S${i+1}`,shape:rule==='shape'?c.shape:shapeOrder[(i+1)%3],color,\n          pattern:B.COLORS[color].pattern,jumper:false,available:true};\n      });\n    }\n    spares=shuffle(spares,rng);\n    const sample=components[0], sampleSpare=spares.find(p=>compatible({rule},sample,p));\n    return {\n      id:`B${index+1}`,name:def.sectorNames[index]||`Sector ${index+1}`,digit,\n      mask:cellOrder.slice(begin,end),rule,ruleKnown:rule==='jumper',\n      example:{source:{shape:sample.shape,color:sample.color,pattern:sample.pattern},replacement:{shape:sampleSpare.shape,color:sampleSpare.color,pattern:sampleSpare.pattern}},\n      components,order,step:0,spares,held:null,claim:null,heat:0,fire:false,\n      recovery:null,hold:null,complete:false,revision:0,tests:0,\n    };\n  }\n  function create(caseId='waterfront',seed=1,party=1,values={}) {\n    const def=B.CONTENT[caseId];\n    if (!def) throw new Error(`Unknown case: ${caseId}`);\n    const seats=Array.isArray(party)?[...new Set(party)]:Array.from({length:clamp(Number(party)||1,1,4)},(_,i)=>i+1);\n    if (!seats.length||seats.length>4) throw new Error('A case requires one to four seats.');\n    const t=tuning(values), r=random(seed);\n    const code=Array.from({length:def.digits},()=>Math.floor(r()*10));\n    const duration=def.partyDurations[seats.length-1]*t.fuseScale;\n    const s={version:VERSION,caseId,seed:seed>>>0,party:seats.length,seats,duration,remaining:duration,\n      elapsed:0,revision:0,status:'active',cause:null,code,evidence:code.map(()=>Array(20).fill(-1)),\n      boards:[],events:[],eventId:0,metrics:{boards:0,components:0,mistakes:0,penalties:0,tests:0,repairs:0},\n      proposal:null,tuning:t,modified:false,assisted:!!values.assisted,result:null,seen:[]};\n    s.boards=Array.from({length:def.boardCount},(_,i)=>makeBoard(def,i,code,r,seats.length));\n    // A contained, visible hot-loop lesson. It stays burning until a player extinguishes it.\n    if (caseId==='relay') { s.boards[2].fire=true; s.boards[2].heat=78; }\n    emit(s,'dispatch',def.intro);\n    return s;\n  }\n  function terminalOutcome(s,status,cause) {\n    if (s.status!=='active') return false;\n    s.status=status;s.cause=cause;s.proposal=null;\n    for (const b of s.boards) b.hold=null;\n    const complete=s.metrics.boards;\n    const early=status==='won' && complete<s.boards.length;\n    const clean=Math.max(0,1000-s.metrics.mistakes*100-s.metrics.penalties*150);\n    const disposal=status==='won'?2000:0;\n    const time=status==='won'?Math.floor(Math.max(0,s.remaining)*5):0;\n    const inference=status==='won'&&early?500:0;\n    s.result={won:status==='won',cause,score:disposal+time+clean+inference,\n      cards:{disposal,time,clean,inference},remaining:Math.max(0,s.remaining),seed:s.seed,\n      modified:s.modified,assisted:s.assisted,early,boards:complete};\n    emit(s,status,status==='won'?B.CONTENT[s.caseId].success: cause==='wrong-code'?'PIP: That code was wrong. The lock has fired. We can retry this exact case.':'PIP: Fuse expired. Tools down. Behind the van, everyone.');\n    s.revision++;\n    return true;\n  }\n  function resolveCode(s,code) {\n    terminalOutcome(s,code.length===s.code.length && code.every((d,i)=>d===s.code[i])?'won':'lost',\n      code.length===s.code.length&&code.every((d,i)=>d===s.code[i])?'disarmed':'wrong-code');\n  }\n  function finishBoard(s,b) {\n    if (b.complete || b.fire || b.recovery || b.step<b.order.length) return;\n    b.complete=true;b.hold=null;b.held=null;\n    for (const cell of b.mask) s.evidence[b.digit][cell]=B.GLYPHS[s.code[b.digit]][cell];\n    s.metrics.boards++;\n    emit(s,'evidence',`PIP: ${b.name} secure. ${b.mask.length} truthful cells published to digit ${b.digit+1}.`,{board:b.id,digit:b.digit,cells:[...b.mask]});\n  }\n  function ignite(s,b) {\n    if (!b.fire && b.heat>=100) {\n      b.fire=true;\n      emit(s,'fire',`PIP: Fire on ${b.name}! Extinguisher, then resume.`,{board:b.id});\n    }\n  }\n  function recover(s,b,c,terminal) {\n    c.cuts[terminal]=true;\n    b.recovery={component:c.id,terminal,remaining:s.tuning.recoveryWindow,overdue:false};\n    s.metrics.mistakes++;\n    emit(s,'fault',`PIP: Wrong joint. Resolder ${c.id}, ${terminal===0?'left':'right'} lead within ${Math.round(s.tuning.recoveryWindow)} seconds.`,{board:b.id,component:c.id,terminal});\n  }\n  function touch(s,b) {s.revision++;if(b)b.revision++;}\n  function release(s,seat) {\n    for (const b of s.boards) if (b.claim===seat) {\n      b.claim=null;b.hold=null;\n      if (b.held) {const p=b.spares.find(p=>p.id===b.held);if(p)p.available=true;b.held=null;}\n      b.revision++;\n    }\n  }\n  function join(s,seat) {\n    if (s.seats.includes(seat)) return true;\n    if (s.seats.length>=4 || s.status!=='active') return false;\n    s.seats.push(seat);touch(s);\n    emit(s,'join',`Response seat ${seat} connected. Workload and fuse stay locked.`);\n    return true;\n# Native art and audio contract\n\nLoad `src/view/art.js` and `src/audio/audio.js` after the full native engine and simulation. Both attach classes to `globalThis.BU`.\n\n## Art\n\n`new BU.Art(game)` registers original `BU:` native asset shapes/materials and three fully dressed crew Humanoid rigs. `art.update(dt, state, viewState)` advances only cosmetic state, consumes accepted simulation event IDs for interrupted-safe native tween responses, and establishes stable camera framing. `art.draw(r,state,viewState)` draws with `E.px`, `r.box`, native asset definitions and native rigs; no gameplay mutation, second renderer, image files, or external resources.\n\n`viewState = {screen, boardId, focusTarget, tool, attract, success, reducedMotion, inspecting}`. Workspace is selected whenever boardId exists and screen is `board`, `play`, `workspace`, or `repair`. Other screens receive a themed 2.5D city diorama. Theme comes from state.caseId; title rotates among the three themes. Default workspace width is the left 74% of landscape; top 13% and bottom 12% remain readable HUD space. Tall screens center the workspace and reduce visual dressing. Camera: original native orthographic View, x/y world plane, z up, almost overhead for the board. `art.frame(state,v)` exposes current layout.\n\n`art.targets(state,v)` returns screen-buffer pixel targets (not CSS pixels), available before drawing. Each has `id,kind,x,y,wx,wy,wz,radius,label` and semantic fields:\n- `C1:0`, `C1:1`: `kind:'terminal', componentId:'C1', component:'C1',terminal:0|1`.\n- `C1:body`: `kind:'component',componentId:'C1',component:'C1'`.\n- `spare:S1`: `kind:'spare',spare:'S1'`.\n- `test`: `kind:'test'`.\n- `fire`: `kind:'fire'`, only during an active fire.\n\n`focusTarget` can be a target object or ID. Tool string is `cut`, `grip`, `solder`, `extinguish` (numeric 0–3 also accepted). Renderer preserves shape/pattern/label differences without relying on color. Components, terminal cut/solder states, current order, held spare, fire, recovery, and hold safe band are depicted from authoritative state. `art.portrait(r,who,x,y,size)` draws a native crew portrait in an overlay; who is `partner`, `saboteur`, or `crew`.\n\n## Audio\n\n`new BU.Audio(game)` builds on `game.audio` native synth, instrument registration, music composition and native buses. It explicitly sets real music default to 0.1. Methods:\n- `unlock()` called on genuine user activation; returns promise; creates/resumes native Web Audio context.\n- `set({music,effects,voice,volume,muted})` applies independent finite levels, live, to native buses.\n- `effect(name)` (`cut`,`grip`,`pick`,`place`,`solder`,`test-pass`,`test-fail`,`foam`,`recovery`,`fire`,`evidence`,`disarm`,`failure`,`radio`,`tick`,`sirens`).\n- `voice(who,text,priority=1,id?)` emits distinct deterministic code-generated gibberish envelopes through native voice bus. Urgent priority preempts lower-priority taunts; event IDs deduplicate.\n- `music(theme='investigation',urgent=false)` original restrained electronic score; urgent layer activates as fuse falls.\n- `update(dt,state)` controls fuse pulse and urgency; `suspend(on=true)` stops custom sources and ducks/stops native music while paused/ended; `dispose()` stops owned sources only.\n- `snapshot()` exposes actual bus values, pending voice count, initialized context state and last cue, for verification.\n- `static renderProbe(context)` synthesizes representative effects/voice/music into a supplied OfflineAudioContext for finite/nonzero/peak checks without playing anything.\n\nThere are no audio files. Listening quality remains unverified on this headless workstation.\n/* Bomb Union cooperative transports. Official Hub owns embedded networking;\n   standalone rooms use a real PeerJS/WebRTC reliable data connection. */\n((root) => {\n\tconst BU = (root.BU = root.BU || {});\n\tconst PROTOCOL = 1,\n\t\tCONTENT = 1;\n\tconst COLORS = [\"#ff9f76\", \"#66d5dd\", \"#c0df7a\", \"#c2a7ec\"];\n\tconst ALPHABET = \"ABCDEFGHJKLMNPQRSTUVWXYZ23456789\";\n\tconst stamp = () =>\n\t\ttypeof performance !== \"undefined\"\n\t\t\t? performance.now() / 1000\n\t\t\t: Date.now() / 1000;\n\tconst randomId = (n = 18) => {\n\t\tconst bytes = new Uint8Array(n);\n\t\tif (root.crypto && root.crypto.getRandomValues)\n\t\t\troot.crypto.getRandomValues(bytes);\n\t\telse for (let i = 0; i < n; i++) bytes[i] = Math.floor(Math.random() * 256);\n\t\treturn Array.from(bytes, (x) => ALPHABET[x % ALPHABET.length]).join(\"\");\n\t};\n\tconst clone = (x) => JSON.parse(JSON.stringify(x));\n\tconst noop = () => {};\n\tclass Network {\n\t\tconstructor(options = {}) {\n\t\t\tthis.callbacks = options;\n\t\t\tthis.mode = \"solo\";\n\t\t\tthis.online = false;\n\t\t\tthis.authority = false;\n\t\t\tthis.seat = 0;\n\t\t\tthis.state = null;\n\t\t\tthis.status = \"Offline\";\n\t\t\tthis.code = \"\";\n\t\t\tthis.roster = [];\n\t\t\tthis.running = false;\n\t\t\tthis.ended = false;\n\t\t\tthis.peer = null;\n\t\t\tthis.connection = null;\n\t\t\tthis.connections = new Map();\n\t\t\tthis.tokens = new Map();\n\t\t\tthis.unsubscribers = [];\n\t\t\tthis.timers = new Set();\n\t\t\tthis.sequence = 0;\n\t\t\tthis.snapshotSequence = 0;\n\t\t\tthis.parts = new Map();\n\t\t\tthis.pendingPatches = new Set();\n\t\t\tthis.nextPatch = 0;\n\t\t\tthis.lastWall = stamp();\n\t\t\tthis.nextSnapshot = 0;\n\t\t\tthis.nextPing = 0;\n\t\t\tthis.hubStarted = false;\n\t\t\tthis.hubReady = false;\n\t\t\tthis.hubFinished = false;\n\t\t\tthis.hub = null;\n\t\t\tthis.hubLast = 0;\n\t\t\tthis.connected = false;\n\t\t\tthis.disposed = false;\n\t\t\tthis.options = options;\n\t\t\tthis._generation = 0;\n\t\t\tthis._joinSettler = null;\n\t\t\tthis._visibility = () => {\n\t\t\t\tif (this.online && !this.ended) this.tick(0);\n\t\t\t};\n\t\t\tif (root.document)\n\t\t\t\troot.document.addEventListener(\"visibilitychange\", this._visibility);\n\t\t}\n\t\tget canPlay() {\n\t\t\treturn (\n\t\t\t\tthis.online &&\n\t\t\t\tthis.running &&\n\t\t\t\t!this.ended &&\n\t\t\t\tthis.connected &&\n\t\t\t\tthis.seat !== null &&\n\t\t\t\tthis.state &&\n\t\t\t\tthis.state.status === \"active\"\n\t\t\t);\n\t\t}\n\t\t_emit(name, value) {\n\t\t\t(this.callbacks[name] || noop)(value);\n\t\t}\n\t\t_status(text) {\n\t\t\tthis.status = text;\n\t\t\tthis._emit(\"onStatus\", text);\n\t\t}\n\t\t_roster() {\n\t\t\tthis._emit(\"onRoster\", clone(this.roster));\n\t\t}\n\t\t_timer(fn, ms) {\n\t\t\tconst id = setTimeout(() => {\n\t\t\t\tthis.timers.delete(id);\n\t\t\t\tfn();\n\t\t\t}, ms);\n\t\t\tthis.timers.add(id);\n\t\t\treturn id;\n\t\t}\n\t\t_clearTimer(id) {\n\t\t\tif (id) {\n\t\t\t\tclearTimeout(id);\n\t\t\t\tthis.timers.delete(id);\n\t\t\t}\n\t\t}\n\t\t_packet(data) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat >> src/main.js <<'EOF'\nconst tuningLabels={timeScale:'Simulation speed',fuseScale:'Authored fuse scale',solderMin:'Safe band begins',solderMax:'Safe band ends',heatGain:'Iron heat gain',cooling:'Board cooling',recoveryWindow:'Recovery window',penalty:'Mistake time penalty',fireIntensity:'Fire intensity',extinguishTime:'Foam hold time',hintDelay:'Guidance delay',precision:'Snap precision',toolTravel:'Tool travel speed',maxHold:'Maximum hold',testCost:'Diagnosis time cost'};\nfor(const [key,range] of Object.entries(B.TUNING_RANGES)){game.settings.define({key:'dev_'+key,label:tuningLabels[key]||key,type:'slider',value:B.DEFAULTS[key],min:range[0],max:range[1],step:range[1]<=5?.05:1,group:'Workbench',apply:(_,value)=>{if(app.devApplying&&app.state&&app.net?.mode\"'!=='\"'hub'&&(\"'!app.net?.online||app.net.authority))command({type:'\"'tune',values:{[key]:value}});}});}\nfunction openDev(){\n const allowed=app.net.mode\"'!=='\"'hub'&&(\"'!app.net.online||app.net.authority);\n setPage('\"'dev',{kicker:allowed?'DEVELOPER WORKBENCH · MODIFIED RUNS LABELED':'LIVE HUB · INSPECTION ONLY',title:'Make the invisible inspectable.',text:app.state?\"'`Case ${app.state.caseId} · seed ${app.state.seed} · revision ${app.state.revision}'\"\\\\nSeat \"'${seat()} · ${app.net.status}'\"\\\\n\"'${board()?B.Sim.instruction(app.state,app.boardId):'\"'Choose a board to inspect its physical state.'}\"'`:'\"'Start a case to inspect, tune, or author a scratch board.',actions:[{label:'Live balance sliders',disabled:\"'!allowed||!app.state,fn:()=>tuningPage(0)},{label:'\"'Board / case authoring',disabled:\"'!allowed,fn:()=>openEditor()},{label:'\"'Inspect physical state',disabled:\"'!app.state,fn:()=>inspectState()},{label:'\"'Checkpoint current device',disabled:\"'!allowed||!app.state,fn:()=>{app.checkpoint=B.Sim.snapshot(app.state);ui.toast('\"'Checkpoint stored','Only this developer visit; ordinary records stay separate.');}},{label:'Restore checkpoint',disabled:\"'!allowed||!app.checkpoint,fn:()=>{app.state=B.Sim.restore(app.checkpoint);app.state.modified=true;if(app.net.online)app.net.state=app.state;ui.hide();openEvidence();}},{label:'\"'Step one second',disabled:\"'!allowed||!app.state,fn:()=>{B.Sim.advance(app.state,1);app.state.modified=true;openDev();}},{label:'\"'Add 60 fuse seconds',disabled:\"'!allowed||!app.state,fn:()=>{command({type:'\"'dev',operation:'fuse',value:app.state.remaining+60});openDev();}},{label:'Inject fire on first board',disabled:\"'!allowed||!app.state,fn:()=>{command({type:'\"'dev',operation:'fire',board:app.boardId||app.state.boards.find(b=>\"'!b.complete)?.id});ui.hide();openEvidence();}},{label:'\"'Inject recoverable joint',disabled:\"'!allowed||!app.state,fn:()=>{command({type:'\"'dev',operation:'fault',board:app.boardId||app.state.boards.find(b=>\"'!b.complete)?.id});ui.hide();openEvidence();}},{label:'\"'Reveal evidence',disabled:\"'!allowed||!app.state,fn:()=>{command({type:'\"'dev',operation:'reveal'});ui.hide();openEvidence();}},{label:'Solve device',disabled:\"'!allowed||!app.state,fn:()=>{command({type:'\"'dev',operation:'solve'});ui.hide();}},{label:'Case and seed selector',disabled:\"'!allowed||app.net.online,fn:()=>devCaseSeed()},['\"'Return',()=>ui.back()]],back:()=>ui.back()});\n}\nfunction tuningPage(page){app.devApplying=true;const keys=Object.keys(B.TUNING_RANGES),part=keys.slice(page*5,page*5+5);setPage('tuning',{kicker:'LIVE BALANCE · CURRENT HOLD CANCELS ON CHANGE',title:\"'`Balance ${page+1} / ${Math.ceil(keys.length/5)}`,text:'\"'Changes apply immediately and mark this run. Fuse scale affects a fresh case; use fuse adjustment for the current countdown.',rows:part.map(k=>'dev_'+k),actions:[['Next settings',()=>tuningPage((page+1)%Math.ceil(keys.length/5))],['Reset all balance defaults',()=>{game.settings.reset('Workbench');command({type:'tune',values:{...B.DEFAULTS}});tuningPage(page);}],['Back to workbench',()=>{app.devApplying=false;openDev();}]],back:()=>{app.devApplying=false;openDev();}});}\nfunction inspectState(){const s=app.state;setPage('inspection',{kicker:'READ-ONLY SIMULATION INSPECTION',title:\"'`${s.caseId} · revision ${s.revision}`,sections:[['\"'Authority',\"'`${app.net.mode} · local seat ${seat()} · host ${app.net.authority} · ${app.net.status}`],['\"'Code and candidates',\"'`Hidden code ${s.code.join('\"'')}\\\\nRevealed candidates: \"'${s.evidence.map(x=>B.Sim.candidates(x).join('\"'/')).join(' · ')}\"'`],...s.boards.map(b=>[`${b.id} · ${b.name}`,`owner ${b.claim} · step ${b.step}/${b.order.length} · heat ${b.heat.toFixed(1)} · fire ${b.fire}'\"\\\\n\"'${b.components.map(c=>`${c.id}: cuts ${c.cuts.map(Number)}; removed ${c.removed}; part ${c.part}; joints ${c.joints.map(Number)}`).join('\"'\\\\n')}\"'`]),['\"'Input',\"'`${game.input.lastDevice} · held ${[...game.input.held].join('\"', ')}\"'`]],actions:[['\"'Back to workbench',openDev]],back:openDev});}\nfunction devCaseSeed(){let seed=app.state?.seed||1;setPage('dev-case',{kicker:'SCRATCH DISPATCH',title:'Case and seed',text:'Choose a case below. Edit the seed using left/right or the keyboard. Developer dispatches are labeled modified.',actions:Object.values(B.CONTENT).map(c=>[c.title,()=>{startCase(c.id,seed);app.state.modified=true;}]).concat([['Back',openDev]]),back:openDev});const input=el('input','bu-json');input.type='number';input.value=seed;input.min=0;input.max=4294967295;input.style.height='40px';input.setAttribute('aria-label','Case seed');input.oninput=()=>seed=Number(input.value)>>>0;addPanel(input);}\nlet edit=null,editComponent=0,editSeed=1;\nfunction openEditor(){if(\"'!edit){const scratch=B.Sim.create('\"'relay',1,[0]);edit=B.Sim.exportTemplate(scratch.boards[0]);}app.editing=true;editorPage();}\nfunction editorPage(){\n const c=edit.components[editComponent];\n for(const [key,label,min,max,value] of [['ex','Component X',-90,90,c.x],['ey','Component Y',-50,50,c.y],['el','Lef