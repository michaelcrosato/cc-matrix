y;for(const q of targets){const x=q.x-t.x,y=q.y-t.y,dot=x*dx+y*dy;if(dot<3)continue;const cross=Math.abs(x*dy-y*dx),v=Math.hypot(x,y)+cross*1.8;if(v<score){score=v;best=q;}}if(best){cancelHold();app.focusTarget=best.id;app.audio.effect?.('\"'select');}}\nfunction workspaceInput(){\n const I=game.input;if(\"'!canAct()||ui.screen)return;\n if(I.pressed('\"'evidence')){openEvidence();return;}if(I.pressed('repeatOrder'))message(B.Sim.instruction(app.state,app.boardId),'PIP',true);if(I.pressed('inspect'))inspect();\n if(I.pressed('previousTool'))setTool(tools[(tools.indexOf(app.tool)+3)%4]);if(I.pressed('nextTool'))setTool(tools[(tools.indexOf(app.tool)+1)%4]);['toolCut','toolGrip','toolSolder','toolExtinguish'].forEach((a,i)=>{if(I.pressed(a))setTool(tools[i]);});\n if(I.pressed('drop')){cancelHold();if(board()?.held)command({type:'drop',board:app.boardId});else openEvidence();return;}\n for(const [act,dx,dy]of [['left',-1,0],['right',1,0],['up',0,-1],['down',0,1]])if(I.repeat(act,.32,.12))focusDirection(dx,dy);\n const pointer=I.pointer(),click=I.clicked(),targets=app.art.targets(app.state,view());\n const aim=p=>{if(\"'!p)return null;let best=null,d=Infinity;for(const t of targets){const distance=Math.hypot(t.x-p[0],t.y-p[1]);if(distance<Math.max(t.radius||12,I.lastDevice==='\"'touch'?20:12)&&distance<d){d=distance;best=t;}}return best;};\n if(pointer&&(I.lastDevice==='mouse'||I.lastDevice==='touch')&&(\"'!lastPointer||Math.hypot(pointer[0]-lastPointer[0],pointer[1]-lastPointer[1])>.4)){const hovered=aim(pointer);if(hovered&&!actionHeld)app.focusTarget=hovered.id;lastPointer=pointer;}\n if(click){const selected=aim(click);if(selected){app.focusTarget=selected.id;if(I.lastDevice==='\"'touch'){apply(selected,true);}else if(\"'!I.pressed('\"'apply')&&\"'!actionHeld)apply(selected);}}\n if(I.pressed('\"'apply')){if(I.lastDevice==='mouse'){const selected=aim(pointer);if(selected){app.focusTarget=selected.id;apply(selected);}}else apply();}\n if(actionHeld&&\"'!touchAuto&&I.released('\"'apply'))endHold();\n if(touchAuto&&board()?.hold){const hold=board().hold,limit=hold.tool==='solder'?app.state.tuning.solderMin+.09:app.state.tuning.extinguishTime+.04;if(hold.duration>=limit)endHold();}\n}\nfunction attractStart(){if(app.net.online||app.net.mode==='hub'||app.editing||document.activeElement?.tagName==='INPUT'||document.activeElement?.tagName==='TEXTAREA')return;app.attract=true;ui.hide();app.state=B.Sim.create(['training','relay','central'][attractCase%3],7331+attractCase,[0]);app.lastEvent=0;app.boardId=app.state.boards[0].id;app.focusTarget=null;app.screen='work';app.tool='cut';attractClock=0;attractStage=0;attractWait=0;app.demo=document.createElement('div');app.demo.className='bu-demo';app.demo.innerHTML='BOMB UNION · NIGHT SHIFT DEMONSTRATION<small>Any input to clock in · repairs, diagnosis, hazards, evidence, disposal</small>';document.body.appendChild(app.demo);message('Two cuts, one careful repair. Every little circuit tells part of the story.','PIP',true);}\nfunction wake(){app.demo?.remove();app.demo=null;app.attract=false;app.state=null;app.audio.suspend?.();game.input.clear();title();}\nfunction attractUpdate(dt){\n const s=app.state;if(\"'!s)return;attractClock+=dt;B.Sim.advance(s,dt);\n if(s.status!=='\"'active'){attractWait+=dt;if(attractWait>5){attractCase++;app.demo?.remove();app.attract=false;attractStart();}return;}\n if(attractClock<.7)return;attractClock=0;const b=s.boards.find(x=>\"'!x.complete);if(!b){B.Sim.command(s,0,{type:'\"'propose',code:s.code.slice()});return;}\n app.boardId=b.id;app.screen='work';if(b.claim\"'!==0)B.Sim.command(s,0,{type:'\"'claim',board:b.id});\n if(b.hold){const min=b.hold.tool==='solder'?s.tuning.solderMin:s.tuning.extinguishTime;if(b.hold.duration>=min)B.Sim.command(s,0,{type:'end',board:b.id});return;}\n if(b.rule\"'!=='\"'jumper'&&\"'!b.ruleKnown){const spare=b.spares.find(p=>p.available);app.focusTarget='\"'spare:'+spare.id;app.tool='grip';B.Sim.command(s,0,{type:'test',board:b.id,spare:spare.id});return;}\n const a=B.Sim.nextAction(s,b.id);if(a){app.tool=a.type==='cut'?'cut':a.type==='begin'?(a.tool==='extinguish'?'extinguish':'solder'):'grip';app.focusTarget=a.type==='pick'?'spare:'+a.spare:a.type==='begin'&&a.tool==='extinguish'?'fire':a.component?\"'`${a.component}:${a.terminal??'\"'body'}\"'`:app.focusTarget;B.Sim.command(s,0,a);}\n}\nlet proposalSeen=null;\nfunction update(dt){\n const I=game.input;const pad=I.padPrev||[];const padEdge=pad.some((on,i)=>on&&!lastPad[i]);lastPad=pad.slice();if(padEdge){idleAt=now();if(app.attract){wake();return;}app.audio.unlock?.();}\n app.net.tick(dt);\n if(app.attract){attractUpdate(dt);events();app.art.update(dt,app.state,view());updateHUD();return;}\n if(app.screen==='\"'title'&&ui.screen==='title'&&\"'!app.net.online&&now()-idleAt>=10000)attractStart();\n if(app.state){if(!app.net.online&&app.state.status==='\"'active')B.Sim.advance(app.state,dt);events();if(app.state.status\"'!=='\"'active'){if(now()-justStarted>500)results();}else{\n  if(app.screen==='work'){workspaceInput();const b=board();if(b?.complete){message('Sector secure. Its clue cells are now on the evidence display.','PIP',true);openEvidence();}else if(b&&now()>stickyCaption+game.settings.hintDelay*1000&&app.state.elapsed-lastTaunt>45){const c=B.CONTENT[app.state.caseId];message(c.taunts[Math.floor(app.state.elapsed/45)%c.taunts.length],'DR. TICK');lastTaunt=app.state.elapsed;}}\n  const p=app.state.proposal;if(p&&p.proposer\"'!==seat()&&proposalSeen!==p.id){proposalSeen=p.id;votePanel();}if(!p&&ui.screen==='\"'vote')openEvidence();\n  if(ui.screen==='evidence'&&app.state.revision\"'!==revisionShown&&now()-lastHUD>650){lastHUD=now();openEvidence();}\n }\n app.audio.update?.(dt,app.state);\n }\n app.art.update(dt,app.state,view());updateHUD();\n}\nconst draw=r=>app.art.draw(r,app.state,view());\ngame.debug={snapshot:()=>({title:'\"'Bomb Union',screen:app.screen,boardId:app.boardId,focusTarget:app.focusTarget,tool:app.tool,attract:app.attract,state:app.state?B.Sim.snapshot(app.state):null,network:{mode:app.net.mode,seat:app.net.seat,authority:app.net.authority,status:app.net.status},audio:app.audio.snapshot?.(),errors:game.errors}),targets:()=>app.art.targets(app.state,view())};\napp.debug=game.debug;\nconst scene={pausable:true,update,draw,enter(){game.lights.enabled=true;game.lights.ambient=.7;}};\ngame.start({scenes:{title:{...scene,pausable:false,enter(){title();}},play:scene},scene:'title'});\nglobalThis.__game=game;\n(async()=>{if(AIHub.active){ui.hide();app.screen='standby';setPage('standby',{kicker:'AI HUB · SHARED DISPATCH',title:'Crew assembling',text:'Ready automatically. The round begins on the Hub clock.',actions:[]});await app.net.detectHub();}else await app.net.detectHub();\"'$('\"'#bu-loading').hidden=true;})().catch(e=>{ui.toast('Startup error',e.message);\"'$('\"'#bu-loading').hidden=true;});\n// The gameplay scene is always pausable; native title is only the arrival scene.\nconst originalStart=app.startCase;app.startCase=(...args)=>{originalStart(...args);};\naddEventListener('pagehide',()=>{app.audio.suspend?.();cancelHold();});\n})();\nEOF\npython3 - <<'PY'\np='src/main.js'\ns=open(p).read().replace(\\\"B.Sim.create(caseId,seed,1)\\\",\\\"B.Sim.create(caseId,seed,[0])\\\")\ns=s.replace(\\\"app.audio.voice?.(app.caption,speaker.toLowerCase().includes('tick')?'saboteur':'partner',priority?2:1)\\\",\\\"app.audio.voice?.(speaker.toLowerCase().includes('tick')?'saboteur':'partner',app.caption,priority?2:1)\\\")\ns=s.replace('app.audio.resume?.();','app.audio.suspend?.(false);')\ns=s.replace(\\\"app.screen='evidence';ui.hide();nativeResume();game.live=\\\", \\\"app.screen='evidence';ui.hide();nativeResume();if(game.sceneName\"'!=='\"'play')game.go('play',null,{fade:0});game.live=\\\")\ns=s.replace(\\\"function title(){\\\\n cancelHold();\\\", \\\"function title(){\\\\n app.editing=false;app.editorApplying=false;app.devApplying=false;cancelHold();\\\")\nopen(p,'w').write(s)\nPY\nnode --check src/main.js\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_33","type":"agent_message","text":"The simulation now supports the full repair sequence, stencil deduction, recovery windows, heat and fire, and all four campaign beats. Cooperative testing has also completed a real PeerJS Cloud connection, repairs, shared-code disposal, disconnect, and rejoin in two browser pages. I’m integrating the player-facing screens and controls next, then I’ll test the bundled game itself.\n"}}
