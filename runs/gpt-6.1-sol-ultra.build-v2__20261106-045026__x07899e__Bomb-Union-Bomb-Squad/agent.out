caseId]||0,s.result?.score||0);save();}\n const order=['\"'training','waterfront','relay','central'],next=order[order.indexOf(s.caseId)+1];\n setPage('results',{kicker:won?(s.caseId==='central'?'THE CITY GETS ANOTHER MORNING':'DISPOSAL COMPLETE'):'INCIDENT REPORT',title:won?'Clock stopped. City saved.':s.cause==='expired'?'The fuse ran out.':'That was the wrong code.',emblem:won?'✓':'×',text:won?c.ending:\"'`${c.failure}'\"\\\\nCause: \"'${s.cause||'\"'unknown'}. The same seed lets you learn from this device.\"'`,stats:[[String(s.result?.score||0),'\"'TOTAL SCORE'],[formatTime(s.remaining),'FUSE SAVED'],[\"'`${s.boards.filter(b=>b.complete).length}/${s.boards.length}`,'\"'SECTORS'],[String(s.metrics?.mistakes||s.metrics?.errors||0),'MISTAKES']],medals:[['Clean work',\"'!(s.metrics?.mistakes||s.metrics?.errors)],['\"'Assisted',\"'!!s.assisted],['\"'Developer modified',\"'!!s.modified]],actions:[...(won&&next&&!app.net?.online?[[next==='\"'waterfront'?'Begin first dispatch':'Next dispatch',()=>brief(next)]]:[]),...(\"'!app.net?.online?[['\"'Retry same device',()=>brief(s.caseId,s.seed)],['Fresh device',()=>brief(s.caseId)],['Case select',()=>caseSelect(false)]]:[]),['About & acknowledgments',()=>credits(0)],['Return to title',title]],back:title});\n}\nfunction formatTime(t){t=Math.max(0,Math.ceil(t||0));return \"'`${Math.floor(t/60).toString().padStart(2,'\"'0')}:\"'${(t%60).toString().padStart(2,'\"'0')}\"'`;}\nfunction onlineMenu(){setPage('\"'online',{kicker:'ONE DEVICE · UP TO FOUR TECHNICIANS',title:'Cooperative dispatch',text:'Claim different sectors. Share truthful evidence. Decide the final code together. Cloud signaling connects standalone crews; some networks may require a TURN relay.',actions:[['Host a dispatch',async()=>{setPage('connecting',{title:'Calling the crew…',text:'Opening secure PeerJS Cloud signaling.',actions:[['Cancel',()=>{app.net.leave();onlineMenu();}]]});try{await app.net.host();lobby();}catch(e){networkError(e);}}],['Join a crew',()=>join