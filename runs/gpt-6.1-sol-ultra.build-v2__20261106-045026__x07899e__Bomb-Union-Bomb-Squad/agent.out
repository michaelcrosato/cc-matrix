", `bu-cell ${v === 1 ? \"lit\" : v === 0 ? \"dark\" : \"unknown\"}`),\n\t\t\t),\n\t\t);\n\t\treturn n;\n\t}\n\tfunction evidenceRow(data = app.state?.evidence) {\n\t\tconst row = el(\"div\", \"bu-stencils\");\nactions = []\nARTIFACT_SHA256 = hashlib.sha256(ARTIFACT.read_bytes()).hexdigest()\n\n\ndef check(condition, message):\n    global checks\n    checks += 1\n    if not condition:\n        raise AssertionError(message)\n\n\ndef run():\n    global checks\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page(viewport={\"width\": 1920, \"height\": 1080})\n        errors = []\n        page.on(\"pageerror\", lambda error: errors.append(str(error)))\n        page.goto(ARTIFACT.as_uri(), wait_until=\"load\")\n    except Exception as exc:\n        check(\"Presentation verification completed\", False, str(exc))\n    finally:\n        try:\n            page.evaluate(\n                \"BU.app.audio.dispose();BU.app.art.dispose();__game.dispose()\"\n            )\n        except Exception:\n            pass\n        browser.close()\nresult = {\n    \"checks\": checks,\n    \"probe\": probe,\n    \"failures\": [c for c in checks if not c[\"pass\"]],\n","exit_code":0,"status":"completed"}}
