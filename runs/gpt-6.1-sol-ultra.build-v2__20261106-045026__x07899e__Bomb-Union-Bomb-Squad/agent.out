 through node tools/verify.mjs.\\\\n- Complete truthful exit-interview.json and embedded credits from same data, rebuild and final artifact checks.\\\\n- Update issue ledger, progress, final deliverable/feedback links.\\\\n';open(p,'w').write(s)\nPY\nnode tools/build.mjs\"","aggregated_output":"Built Bomb-Union-Bomb-Squad-gpt-6.1-sol-ultra-20261106-045026.html\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser.py <<'EOF'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nimport json,time,traceback\nROOT=Path(__file__).resolve().parents[1];PROJECT=json.loads((ROOT/'project.json').read_text());URL=(ROOT.parent/(PROJECT['slug']+'.html')).as_uri()\nresults=[]\ndef check(name,ok,detail=''):\n results.append({'name':name,'pass':bool(ok),'detail':str(detail) if not ok else ''})\ndef state(page):return page.evaluate('BU.app.state')\ndef snap(page):return page.evaluate('__game.debug.snapshot()')\ndef wait(page):page.wait_for_timeout(120)\ndef click(page,name):page.get_by_role('button',name=name,exact=True).click();wait(page)\ndef training(page):\n page.goto(URL);page.wait_for_function('window.BU?.app?.ui.screen===\\\"title\\\"');click(page,'Start your shift');click(page,'TRAINING · First day, last wire');click(page,'Open the device');page.locator('[data-board=\\\"B1\\\"]').click();wait(page)\ndef target(page,id):\n t=page.evaluate('(id)=>__game.debug.targets().find(t=>t.id===id)',id);s=page.locator('#screen').bounding_box();dims=page.evaluate('({w:__game.W,h:__game.H})');return (s['x']+t['x']*s['width']/dims['w'],s['y']+t['y']*s['height']/dims['h'])\ndef aim(page,id):page.mouse.move(*target(page,id));wait(page)\ndef tool(page,key):page.keyboard.press(key);wait(page)\ndef action(page,id,hold=0):\n aim(page,id);page.mouse.down();page.wait_for_timeout(hold or 70);page.mouse.up();wait(page)\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True)\n context=browser.new_context(viewport={'width':1920,'height':1080})\n context.add_init_script(\\\"window.__pad={id:'Emulated standard DualSense',index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:18},()=>({pressed:false,touched:false,value:0})),timestamp:0};navigator.getGamepads=()=>[window.__pad];\\\")\n page=context.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n try:\n  training(page)\n  check('file artifact title and normal dispatch',state(page)['caseId']=='training' and page.evaluate('BU.app.screen')=='work')\n  check('readable native board targets',len(page.evaluate('__game.debug.targets()'))>=12)\n  page.keyboard.press('Space');wait(page)\n  check('keyboard apply cuts focused lead',state(page)['boards'][0]['components'][0]['cuts'][0])\n  # Standard pad D-pad and cross through actual navigator polling.\n  def pad(button,hold=.12):\n   page.evaluate('(i)=>{__pad.buttons[i]={pressed:true,touched:true,value:1};__pad.timestamp=performance.now()}',button);page.wait_for_timeout(int(hold*1000));page.evaluate('(i)=>{__pad.buttons[i]={pressed:false,touched:false,value:0};__pad.timestamp=performance.now()}',button);wait(page)\n  pad(15)\n  check('controller moves focus',page.evaluate('BU.app.focusTarget')\"'!='\"'C1:0')\n  check('controller prompt family defaults PlayStation',page.evaluate('__game.settings.glyphs')=='playstation')\n  # Mouse aims actual target before applying; selected prior focus is intentionally different.\n  action(page,'C1:1')\n  check('mouse click operates on hovered terminal',state(page)['boards'][0]['components'][0]['cuts']==[True,True])\n  tool(page,'Digit2');action(page,'C1:body')\n  check('pliers remove only freed component',state(page)['boards'][0]['components'][0]['removed'])\n  action(page,'spare:S1');check('tray pickup',state(page)['boards'][0]['held']=='S1')\n  page.mouse.click(*target(page,'C1:body'));wait(page)\n  check('placement into empty socket',state(page)['boards'][0]['components'][0]['part']=='S1')\n  tool(page,'Digit3');action(page,'C1:0',660)\n  check('solder hold release completes joint in safe band',state(page)['boards'][0]['components'][0]['joints'][0])\n  # Solo pause preserves time and repair; native settings/rebinding paths remain reachable.\n  page.keyboard.press('Escape');wait(page);before=state(page)['remaining'];page.wait_for_timeout(350);after=state(page)['remaining'];check('solo native pause freezes fuse',abs(before-after)<.02)\n  click(page,'Settings');check('native settings opened',page.evaluate('BU.app.ui.screen')=='settings')\n  page.evaluate(\\\"__game.settings.set('glyphs','xbox')\\\");check('Xbox prompt option applies',page.evaluate(\\\"__game.input.label('apply','gamepad')\\\")=='A')\n  page.evaluate(\\\"__game.settings.set('glyphs','playstation')\\\");page.keyboard.press('Escape');wait(page)\n  # Escape returns pause, then Resume returns full workspace.\n  if page.get_by_role('button',name='Resume',exact=True).count():click(page,'Resume')\n  else:page.keyboard.press('Escape');wait(page)\n  check('pause overlay restores workspace',page.evaluate('\"'!BU.app.ui.screen&&BU.app.screen===\"work\"'\"'))\n  check('audio resumes with native menu',not snap(page)['audio']['paused'])\n  # Finish with actual mouse hold and open code confirmation from fresh evidence.\n  action(page,'C1:1',660)\n  page.wait_for_function('BU.app.state.boards[0].complete')\n  check('completed board automatically publishes evidence',all(v\"'!=-1 for v in state(page)['\"'evidence'][0]))\n  click(page,'Enter disarm code');check('code selection distinct from submission',state(page)['status']=='active' and page.evaluate('BU.app.ui.screen')=='code')\n  # Native _cycle left/right support must be reversible without committing.\n  page.locator('[data-digit=\\\"0\\\"]').focus();page.keyboard.press('ArrowRight');wait(page);forward=page.evaluate('BU.app.codeDraft[0]');page.keyboard.press('ArrowLeft');wait(page);check('dial left/right native focus support',forward==1 and page.evaluate('BU.app.codeDraft[0]')==0)\n  click(page,'Review this code');check('deliberate confirmation has safe default',page.evaluate(\\\"document.activeElement.textContent\\\").upper()=='KEEP CHECKING')\n  click(page,'Keep checking')\n  # Developer tools and settings reset work through the actual native shell.\n  click(page,'Pause / settings');click(page,'Developer workbench');click(page,'Live balance sliders');r=page.locator('input[aria-label=\\\"Simulation speed\\\"]');r.fill('2');r.dispatch_event('input');wait(page);check('live dev slider changes authoritative tuning',state(page)['tuning']['timeScale']==2 and state(page)['modified'])\n  click(page,'Reset all balance defaults');check('native reset coherently restores tuning',state(page)['tuning']['timeScale']==1)\n  click(page,'Back to workbench');click(page,'Board / case authoring');click(page,'Reveal full stencil mask');click(page,'Validate scratch content');check('editor validates authored content',page.evaluate('document.body.innerText').find('Content valid')>=0)\n  click(page,'JSON import / export');value=page.locator('#bu-editor-json').input_value();check('versioned editor export model',json.loads(value)['version']=='bomb-union-1')\n  page.locator('#bu-editor-json').fill('{broken');click(page,'Import text');check('invalid editor import is recoverable',page.evaluate('document.body.innerText').find('Import rejected')>=0)\n  page.locator('#bu-editor-json').fill(value);click(page,'Import text');click(page,'Playtest scratch copy');check('editor playtest isolates modified copy',state(page)['modified'] and len(state(page)['boards'])==1)\n  page.keyboard.press('Escape');wait(page)\n  if not page.get_by_role('button',name='Developer workbench',exact=True).count():page.evaluate('__game.menu()');wait(page)\n  # Direct developer control is intentionally separate from ordinary-input campaign acceptance.\n  page.evaluate(\\\"BU.app.command({type:'dev',operation:'fuse',value:.01});__game.resume();BU.app.ui.hide()\\\")\n  page.wait_for_function('BU.app.state.status===\\\"lost\\\"');page.wait_for_timeout(200)\n  check('expiry reports actual cause exactly once',state(page)['cause']=='time-expired' and 'fuse ran out' in page.locator('body').inner_text().lower())\n  check('developer modified results remain labeled',state(page)['result']['modified'])\n  page.screenshot(path=str(ROOT/'evidence/failure.png'))\n  click(page,'Return to title');click(page,'About & credits');check('credits source information reachable',page.evaluate('BU.app.ui.screen')=='credits');click(page,'Next page');check('credits required feedback pagination','Testing Feedback' in page.locator('body').inner_text());page.evaluate('BU.app.title()');wait(page)\n  # Real ten-second idle clock and wake consumption, separate state/records.\n  storage=page.evaluate(\\\"JSON.stringify(localStorage)\\\");page.mouse.move(1800,1000);page.wait_for_timeout(10300);check('attract starts after ten seconds',page.evaluate('BU.app.attract'))\n  page.wait_for_timeout(900);check('attract advances actual repair simulation',page.evaluate('BU.app.state.revision>0'))\n  page.keyboard.press('Enter');wait(page);check('attract wake input consumed',page.evaluate('\"'!BU.app.attract&&BU.app.ui.screen===\"title\"&&BU.app.state===null'\"'))\n  check('attract does not write saves/settings',page.evaluate('JSON.stringify(localStorage)')==storage)\n  # Unavailable/corrupted local storage stays playable (new context initialization).\n  bad=browser.new_context(viewport={'width':1280,'height':720});bad.add_init_script(\\\"Storage.prototype.getItem=function(){return '{malformed'};Storage.prototype.setItem=function(){throw Error('blocked')}\\\")\n  bp=bad.new_page();bp.goto(URL);bp.wait_for_function('window.__game');check('blocked corrupted storage fallback',bp.evaluate('__game.errors.length===0&&BU.app.ui.screen===\\\"title\\\"'));bad.close()\n  check('browser runtime has no errors',not errors and not page.evaluate('__game.errors'),errors)\n except Exception as e:\n  check('browser integration driver',False,str(e)+'\\\\n'+traceback.format_exc());page.screenshot(path=str(ROOT/'evidence/browser-failure.png'))\n context.close()\n # Touch browser emulation in both tablet landscape and phone portrait.\n for name,device in [('tablet',p.devices['iPad Pro 11']),('phone',p.devices['iPhone 13'])]:\n  c=browser.new_context(**device);tp=c.new_page()\n  try:\n   training(tp);t=target(tp,'C1:0');tp.touchscreen.tap(*t);tp.wait_for_timeout(180)\n   check(name+' direct touch selects terminal',tp.evaluate('BU.app.focusTarget')=='C1:0')\n   check(name+' contextual touch action is reachable',tp.locator('.bu-touch-action').is_visible())\n   check(name+' assisted physical action',state(tp)['boards'][0]['components'][0]['cuts'][0])\n   tp.screenshot(path=str(ROOT/('evidence/'+name+'.png')))\n   tp.evaluate('__game.menu()');wait(tp);check(name+' menu reachable',tp.get_by_role('button',name='Resume',exact=True).is_visible())\n  except Exception as e:check(name+' touch emulation',False,str(e))\n  c.close()\n browser.close()\n(ROOT/'evidence/browser.json').write_text(json.dumps({'checks':results,'runtime':'Chromium 153 / Playwright 1.63; emulated standard gamepad, phone/tablet'},indent=2))\nprint(json.dumps({'checks':results}))\nraise SystemExit(0 if all(r['pass'] for r in results) else 1)\nEOF\nnode --check src/main.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
