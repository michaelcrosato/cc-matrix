_board()\n                if c[\"kind\"] == \"jumper\":\n                    match = next(\n                        p for p in b[\"spares\"] if p[\"available\"] and p[\"jumper\"]\n                    )\n                else:\n                    ex = b[\"example\"]\n                    rule = (\n                        \"shape\"\n                        if ex[\"source\"][\"shape\"] == ex[\"replacement\"][\"shape\"]\n                        else \"color\"\n                    )\n-rw-r--r-- 1 micha micha 246254 Nov  6 05:19 evidence/campaign-relay-evidence.png\n-rw-r--r-- 1 micha micha 104696 Nov  6 05:19 evidence/campaign-relay-work.png\n-rw-r--r-- 1 micha micha 224339 Nov  6 05:19 evidence/campaign-waterfront-result.png\n-rw-r--r-- 1 micha micha 210194 Nov  6 05:19 evidence/campaign-waterfront-evidence.png\n      \"name\": \"pad input path has no runtime errors\",\n      \"pass\": true,\n      \"detail\": \"[]\"\n    }\n  ]\n}Found 1 error (1 fixed, 0 remaining).\n1 file reformatted\n","exit_code":0,"status":"completed"}}
