reateStereoPanner ? c.createStereoPanner() : null, srcs = [];   // (a looped or panned one: its own  [... omitted end of long line]\n7989:    if (this._stings.length) this._stings = this._stings.filter(S => { const live = this._clockNow(S) < S.end + .5; if (!live) try { S.bus.disconnect(); } catch (e) { /* gone */ } return live; });\n10672:    this.players = Array.from({ length: Math.max(1, Math.min(2, players)) }, (_, i) => ({ n: i + 1, score: 0, lives: this.o.lives, save: null, next: this.o.every || (this.o.extra[0] === undefined ? In [... omitted end of long line]\n10770:        this._cont = null; for (const p of this.players) p.lives = this.o.lives;\n13885:    const items = [].concat(r.items || []).filter(it => this.inv.add(it, 1)), alive = this.alive, share = alive.length ? Math.ceil((r.exp || 0) / alive.length) : 0;\n(function (root) {\n  'use strict';\n  const B = root.BU = root.BU || {};\n  B.CONTENT_VERSION = 'bomb-union-1';\n  B.GLYPHS = [\n    ['0110','1001','1001','1001','0110'],\n    ['0010','0110','0010','0010','0111'],\n    ['1110','0001','0110','1000','1111'],\n    ['1110','0001','0110','0001','1110'],\n    ['1001','1001','1111','0001','0001'],\n    ['1111','1000','1110','0001','1110'],\n    ['0111','1000','1110','1001','0110'],\n    ['1111','0001','0010','0100','0100'],\n    ['0110','1001','0110','1001','0110'],\n    ['0110','1001','0111','0001','1110'],\n  ].map(rows => rows.join('').split('').map(Number));\n  B.COLORS = {\n    amber: { label:'AMBER / BARS', pattern:'bars', hex:'#f4bd55' },\n    coral: { label:'CORAL / DOTS', pattern:'dots', hex:'#ff786d' },\n    cyan: { label:'CYAN / CROSS', pattern:'cross', hex:'#6de3e2' },\n  };\n  B.DEFAULTS = Object.freeze({\n    timeScale:1, fuseScale:1, solderMin:0.48, solderMax:1.05,\n    heatGain:32, cooling:8, recoveryWindow:8, penalty:10,\n    fireIntensity:1, extinguishTime:0.8, hintDelay:8,\n    precision:1, toolTravel:1, maxHold:5, testCost:2,\n  });\n  B.TUNING_RANGES = {\n    timeScale:[0.1,4], fuseScale:[0.25,3], solderMin:[0.15,1.2],\n    solderMax:[0.35,2.5], heatGain:[5,80], cooling:[1,24],\n    recoveryWindow:[3,20], penalty:[0,40], fireIntensity:[0.25,3],\n    extinguishTime:[0.2,2.5], hintDelay:[0,30], precision:[0.4,2],\n    toolTravel:[0.25,3], maxHold:[2,8], testCost:[0,5],\n  };\n  B.CONTENT = {\n    training: {\n      id:'training', title:'First day, last wire', subtitle:'Guided workbench',\n      theme:'workshop', digits:1, boardCount:1, components:1, duration:180,\n      partyDurations:[180,150,150,150],\n      brief:'Welcome to the union. We fix the little things before they become very large things. This training fuse is safe. Repair one board, read its stencil, and deliberately confirm the code.',\n      intro:'PIP: Two cuts. Grip the old part. Fit a jumper. Solder both ends. Tea comes after continuity.',\n      taunts:['DR. TICK: Even your practice bomb has excellent taste.'],\n      success:'PIP: Certified! You can now be nervous professionally.',\n      failure:'The training buzzer sounds. Nobody is hurt. The kettle is disappointed.',\n      mechanics:['cut','grip','place','solder','evidence','confirm'],\n      sectorNames:['Practice loop'],\n      ending:'Your municipal response van rolls toward the waterfront. The city has three appointments with trouble.',\n    },\n    waterfront: {\n      id:'waterfront', title:'The waterfront job', subtitle:'Case 01 · Saltwater & short circuits',\n      theme:'waterfront', digits:1, boardCount:4, components:1, duration:300,\n      partyDurations:[300,240,210,200],\n      brief:'A suspicious parcel is holding the ferry terminal hostage. Four evidence sectors hide one digit. Repair two sectors before trying a code; more evidence buys certainty. Wrong cuts can be resoldered for eight seconds.',\n      intro:'PIP: One digit between this harbour and a very abrupt low tide. Start with any free sector.',\n      taunts:['DR. TICK: My parcel is waterproof. Is your confidence?','DR. TICK: Take your time. I have thoughtfully provided less of it.','DR. TICK: The ferry service has never been this punctual.'],\n      success:'PIP: Harbour safe! The ferry captain says the next round of biscuits is on him.',\n      failure:'A stylized pressure wave splashes the harbour. The response crew retreats behind the van. The parcel wins this round.',\n      mechanics:['jumper','recovery','early-submission'],\n      sectorNames:['Dock lights','Ferry bell','Tide gauge','Beacon loop'],\n      ending:'Warm lights ripple across the water. The crew applauds with gloved hands. Dispatch has another call.',\n    },\n    relay: {\n      id:'relay', title:'A little power struggle', subtitle:'Case 02 · The municipal relay',\n      theme:'relay', digits:2, boardCount:6, components:2, duration:420,\n      partyDurations:[420,330,290,260],\n      brief:'The relay is feeding a two-digit device. Each board accepts replacements by shape OR color identity. The test socket reveals the rule for two fuse seconds. Bars, dots, and crosses duplicate the colors. Keep the iron in its safe band; extinguish established fires.',\n      intro:'PIP: Test a spare against the marked example. A board keeps the same rule. Also: that warm-looking loop really is warm.',\n      taunts:['DR. TICK: I matched these parts by artistic temperament. Good luck with your little meter.','DR. TICK: Smoke is simply electricity expressing an opinion.','DR. TICK: The city requested a power cut. I am being extremely accommodating.'],\n      success:'PIP: Power restored. Please tell me that was the last smoking component.',\n      failure:'The relay flashes, then the district dims. Emergency lights guide the crew to safety. There is still time to learn and retry.',\n      mechanics:['shape','color','diagnosis','wrong-part','heat','fire'],\n      sectorNames:['North feeder','West busbar','Fan controller','East feeder','Meter bridge','Safety loop'],\n      ending:'Amber windows return one block at a time. From the hill, the city looks like a circuit learning to breathe.',\n    },\n    central: {\n      id:'central', title:'The last municipal minute', subtitle:'Case 03 · Central Exchange',\n      theme:'central', digits:3, boardCount:9, components:2, duration:480,\n      partyDurations:[480,390,340,310],\n      brief:'Dr. Tick has wired the Central Exchange clock into a three-digit lock. Nine sectors mix ordered work, matching rules, heat and recovery. Divide the evidence by digit, keep an eye on distant hazards, and make the final decision together.',\n      intro:'PIP: Three digits. One city. Absolutely no pressure beyond the normal, considerable pressure.',\n      taunts:['DR. TICK: You have reached my flagship product. The warranty expires shortly.','DR. TICK: Such tidy soldering. I almost regret the whole exploding part.','DR. TICK: The clock tower and I have creative differences about the ending.'],\n      success:'PIP: Disarmed. All three digits. All those people. You did it. Now we can shake.',\n      failure:'The clock tower blooms with a theatrical orange flash. The skyline falls quiet, and emergency beacons answer. The crew is safe; the city needs a better ending.',\n      mechanics:['ordered-work','shape','color','heat','recovery','three-digits'],\n      sectorNames:['Clock drive','Tram signal','Civic line','Bell motor','Tower lamp','Square relay','Chime bank','Main breaker','Exchange core'],\n      ending:'The tower strikes the hour. A ferry answers from the water. Dr. Tick’s radio gives one small, offended click. BOMB UNION: clocking out, city intact.',\n    },\n  };\n})(globalThis);\nsrc/audio:\n\nsrc/view:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\n/* Bomb Union — native Game/Shell foundation adapted from the handoff pointclick/adventure kits. */\n(() => {\n'use strict';\nconst E=My3D2dge, B=globalThis.BU, \"'$=s=>document.querySelector(s);\nconst INPUT={...E.Input.DEFAULT,confirm:['\"'Enter','Space','Pad0'],cancel:['Escape','Backspace','Pad1'],apply:['Space','Enter','Mouse0','Pad0'],drop:['Mouse2','Backspace','Pad1'],inspect:['KeyE','Mouse1','Pad2'],repeatOrder:['KeyR','Pad3'],previousTool:['KeyQ','WheelUp','Pad4'],nextTool:['KeyF','WheelDown','Pad5'],precision:['ShiftLeft','ShiftRight','Pad6'],evidence:['Tab','Pad7','Pad17'],toolCut:['Digit1'],toolGrip:['Digit2'],toolSolder:['Digit3'],toolExtinguish:['Digit4']};\nconst app=B.app={state:null,screen:'title',boardId:null,focusTarget:null,tool:'cut',lastEvent:0,caption:'Pip is checking the kettle. You can check the circuits.',speaker:'DISPATCH',attract:false,seed:1,codeDraft:[],editing:false};\nconst tools=['cut','grip','solder','extinguish'], toolNames=['Cutters','Pliers','Iron','Foam'];\nconst game=app.game=new E.Game({id:'bomb-union-v1',canvas:'screen',res:[640,360],expand:true,view:'topdown',views:['topdown'],input:INPUT,draw:true,fullscreen:'button',autoPause:true,bg:'#081b22',menu:{quit:false,items:[['Developer workbench',()=>openDev()],['Case evidence',()=>openEvidence()],['About & credits',()=>credits(0)]],settings:[{key:'music',value:.1},{key:'glyphs',value:'playstation'},{key:'voice',label:'Radio voices',type:'slider',value:.75,min:0,max:1,step:.05,group:'Sound',apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},{key:'candidates',label:'Show possible digits',type:'toggle',value:false,help:'Adds automatic stencil elimination. Assisted results are labeled.',group:'Game'},{key:'touchAssist',label:'Touch solder assistance',type:'toggle',value:true,help:'Releases a legal joint inside the safe band.',group:'Game'},{key:'hintDelay',label:'Guidance delay',type:'slider',value:8,min:0,max:30,step:1,group:'Game'}],controls:{apply:'Apply selected tool',drop:'Drop / back',inspect:'Test / inspect',repeatOrder:'Repeat work order',previousTool:'Previous tool',nextTool:'Next tool',precision:'Precision snap',evidence:'Evidence / board',toolCut:'Cutters',toolGrip:'Pliers',toolSolder:'Soldering iron',toolExtinguish:'Extinguisher',attack:false,dash:false,jump:false,skill:false}}});\nconst ui=app.ui=new E.Shell(game,{tv:true,theme:{font:'Trebuchet MS, system-ui, sans-serif',titleFont:'Trebuchet MS, sans-serif',scale:()=>Math.max(.82,Math.min(2.12,innerWidth/930))},screens:{pause:{kicker:()=>app.net?.online?'Online · fuse continues':'Union break',text:()=>app.net?.online?'This is a local menu. Your crew and the fuse keep going.':'The fuse is paused. Your tea, unfortunately, is not.'},help:{title:'Field manual',sections:[['One careful repair','Cut BOTH leads of the ordered part. Grip it out. Grip a spare from the tray, place it in the empty socket, then hold the iron on each lead. Release inside the green band.'],['A useful mistake','A wrong cut marks a recovery joint. Resolder it within eight seconds. Wrong replacements fail continuity and can be gripped out. An established fire needs foam.'],['Read the code','Each completed sector publishes lit AND dark cells. Unknown cells mean nothing yet. Compare the exact stencil alphabet, then deliberately confirm your chosen code.']]}}});\napp.art=new B.Art(game); app.audio=new B.Audio(game);\nlet progress={v:1,unlocks:['training','waterfront'],best:{},seeds:{},completed:[]};\ntry{const p=E.store.get('bomb-union-progress-v1',null);if(p?.v===1&&Array.isArray(p.completed)&&p.best&&p.seeds) progress={...progress,...p};}catch{}\napp.progress=progress;\nconst hud=document.createElement('div');hud.id='bu-hud';hud.hidden=true;\nhud.innerHTML='<div class=\\\"bu-top\\\"><div class=\\\"bu-case\\\"><small>MUNICIPAL RESPONSE · BOMB UNION</small><strong></strong></div><div class=\\\"bu-fuse\\\"><small>FUSE<br>REMAINING</small><strong>00:00</strong></div></div><div class=\\\"bu-online\\\"></div><div class=\\\"bu-side\\\"><div class=\\\"bu-order\\\"><small>CURRENT WORK ORDER</small><p></p><div class=\\\"bu-next\\\"></div></div><button class=\\\"bu-mini-evidence\\\" aria-label=\\\"Open evidence\\\"></button><div class=\\\"bu-heat\\\">IRON HEAT <span></span><div><i></i></div></div><div class=\\\"bu-alert\\\" hidden></div></div><div class=\\\"bu-context\\\"></div><div class=\\\"bu-holdbar\\\" hidden><div class=\\\"safe\\\"></div><div class=\\\"fill\\\"></div><div class=\\\"bu-holdlabel\\\"></div></div><div class=\\\"bu-bottom\\\"><div class=\\\"bu-caption\\\"><b>PIP · TECHNICAL PARTNER</b><span></span></div><div class=\\\"bu-tools\\\"></div></div><button class=\\\"bu-touch-action\\\" hidden></button>';\ndocument.body.appendChild(hud);\nconst H={case:hud.querySelector('.bu-case strong'),fuse:hud.querySelector('.bu-fuse strong'),fuseBox:hud.querySelector('.bu-fuse'),order:hud.querySelector('.bu-order p'),next:hud.querySelector('.bu-next'),evidence:hud.querySelector('.bu-mini-evidence'),heat:hud.querySelector('.bu-heat'),heatText:hud.querySelector('.bu-heat span'),heatFill:hud.querySelector('.bu-heat i'),alert:hud.querySelector('.bu-alert'),context:hud.querySelector('.bu-context'),hold:hud.querySelector('.bu-holdbar'),safe:hud.querySelector('.safe'),fill:hud.querySelector('.fill'),holdText:hud.querySelector('.bu-holdlabel'),caption:hud.querySelector('.bu-caption span'),speaker:hud.querySelector('.bu-caption b'),online:hud.querySelector('.bu-online'),touch:hud.querySelector('.bu-touch-action')};\nH.evidence.onclick=()=>openEvidence();\nconst toolButtons=tools.map((t,i)=>{const b=document.createElement('button');b.innerHTML='<kbd>'+(i+1)+'</kbd>'+toolNames[i];b.onclick=()=>setTool(t);hud.querySelector('.bu-tools').appendChild(b);return b;});\nlet actionHeld=false, touchAuto=false, idleAt=performance.now(), lastHUD=0,lastPointer=null, lastPad=[],attractClock=0,attractStage=0,attractCase=0,attractWait=0,lastTaunt=0,justStarted=0,revisionShown=-1,resultShown=false,stickyCaption=0;\nconst randomSeed=()=>crypto.getRandomValues(new Uint32Array(1))[0];\nconst save=()=>{if(\"'!app.attract&&!app.net?.online)try{E.store.set('\"'bomb-union-progress-v1',progress);}catch{}};\nconst now=()=>performance.now();\nconst nativePause=game.pause.bind(game),nativeResume=game.resume.bind(game);\ngame.pause=reason=>{cancelHold();if(\"'!app.net?.online)app.audio.suspend?.();return nativePause(reason);};\ngame.resume=()=>{nativeResume();app.audio.resume?.();};\nfunction signalInput(e){\n if(e.type==='\"'pointermove'&&e.movementX===0&&e.movementY===0)return;\n idleAt=now();\n if(app.attract){e.preventDefault?.();e.stopImmediatePropagation?.();wake();return;}\n if(e.type\"'!=='\"'pointermove')app.audio.unlock?.();\n}\nfor(const type of ['keydown','pointerdown','pointermove','touchstart','wheel'])addEventListener(type,signalInput,{capture:true,passive:false});\naddEventListener('contextmenu',e=>e.preventDefault());\naddEventListener('blur',()=>cancelHold());\naddEventListener('pointerup',()=>{if(actionHeld)endHold();},{capture:true});\naddEventListener('pointercancel',()=>cancelHold());\nconst view=()=>({screen:app.screen,boardId:app.boardId,focusTarget:app.focusTarget,tool:app.tool,attract:app.attract,success:app.state?.status==='won',reducedMotion:game.settings.reduceMotion,precision:game.input.down('precision')});\nconst board=()=>app.state?.boards.find(b=>b.id===app.boardId);\nconst seat=()=>app.net?.online?app.net.seat:0;\nconst canAct=()=>app.state?.status==='active'&&(\"'!app.net?.online||app.net.canPlay)&&!app.attract;\nfunction command(cmd){if(!app.state)return {ok:false,reason:'\"'No active case.'};const result=app.net?.online?app.net.command(cmd):B.Sim.command(app.state,0,{...cmd,id:cmd.id||'local-'+(++app.commandId),caseId:app.state.caseId});if(result?.ok===false)ui.toast('Check the target',result.reason,2.5);return result;}\napp.commandId=0;app.command=command;\nfunction message(text,speaker='PIP',priority=false){if(\"'!priority&&now()<stickyCaption)return;app.caption=String(text).replace(/''^(PIP|DR'\"\\\\. TICK):\\\\s*/,'');app.speaker=speaker;if(priority)stickyCaption=now()+3500;app.audio.voice?.(app.caption,speaker.toLowerCase().includes('tick')?'saboteur':'partner',priority?2:1);}\nfunction events(){if(\"'!app.state)return;for(const e of app.state.events||[]){if(e.id<=app.lastEvent)continue;app.lastEvent=e.id;app.art.event?.(e);const type=e.type||'\"'';app.audio.effect?.(type);if(e.text)message(e.text,type.includes('taunt')?'DR. TICK':'PIP',/recover|fire|wrong|fail/.test(type));} }\nfunction setTool(t){if(\"'!tools.includes(t))return;cancelHold();app.tool=t;app.audio.effect?.('\"'select');}\nfunction cancelHold(){if(\"'!actionHeld&&!board()?.hold)return;actionHeld=false;touchAuto=false;if(app.state?.status==='\"'active'&&board()?.hold)command({type:'cancel',board:app.boardId});}\nfunction endHold(){if(\"'!actionHeld)return;actionHeld=false;touchAuto=false;command({type:'\"'end',board:app.boardId});}\nfunction target(){return app.art.targets(app.state,view()).find(t=>t.id===app.focusTarget);}\nfunction apply(t=target(),assisted=false){\n if(\"'!canAct()||!t)return;app.focusTarget=t.id;const b=board();if(!b||b.claim!==seat())return;\n const c=t.componentId||t.component;\n if(assisted){\n  if(t.kind==='\"'fire')setTool('extinguish');\n  else if(t.kind==='spare')setTool('grip');\n  else if(t.kind==='terminal')setTool(b.recovery||b.components.find(q=>q.id===c)?.part?'solder':'cut');\n  else if(t.kind==='component')setTool('grip');\n }\n if(t.kind==='test'){inspect();return;}\n let cmd;\n if(app.tool==='cut'&&t.kind==='terminal')cmd={type:'cut',component:c,terminal:t.terminal};\n else if(app.tool==='grip'&&t.kind==='spare')cmd={type:'pick',spare:t.spare};\n else if(app.tool==='grip'&&t.kind==='component')cmd={type:b.held?'place':'grip',component:c};\n else if(app.tool==='solder'&&t.kind==='terminal')cmd={type:'begin',tool:'solder',component:c,terminal:t.terminal};\n else if(app.tool==='extinguish'&&(t.kind==='fire'||b.fire))cmd={type:'begin',tool:'extinguish'};\n else {ui.toast('Tool ready',app.tool==='grip'?'Aim at a component body or a spare in the tray.':app.tool==='extinguish'?'Aim at the marked fire.':'Aim at one of the two round terminals.');return;}\n const r=command({...cmd,board:app.boardId});if(cmd.type==='begin'&&r?.ok\"'!==false){actionHeld=true;touchAuto=assisted&&game.settings.touchAssist;}\n}\nfunction inspect(){const b=board(),t=target();if(!b||!canAct())return;if(b.rule==='\"'jumper'){message('A straight jumper completes this loop. No diagnosis needed.');return;}const spare=t?.kind==='spare'?t.spare:b.held||b.spares.find(s=>s.available)?.id;if(\"'!spare)return;command({type:'\"'test',board:b.id,spare,component:b.order[b.step]});}\nH.touch.onpointerdown=e=>{e.stopPropagation();e.preventDefault();apply(target(),true);};\nfunction setPage(page,spec={}){cancelHold();app.screen=page;ui.show(page,spec);const sh=ui.root?.querySelector('.esh-sh');if(sh)sh.dataset.page=page;hud.hidden=true;}\nfunction addPanel(node,where='before'){const box=ui.root?.querySelector('.esh-sh>div');if(\"'!box)return;const acts=box.querySelector('\"'.esh-btns');if(where==='before'&&acts)box.insertBefore(node,acts);else box.appendChild(node);}\nfunction el(tag,cls,text){const n=document.createElement(tag);n.className=cls||'';if(text\"'!==undefined)n.textContent=text;return n;}\nfunction stencil(cells,extra='\"''){const n=el('div','bu-stencil '+extra);cells.forEach(v=>n.appendChild(el('i','bu-cell '+(v===1?'lit':v===0?'dark':'unknown'))));return n;}\nfunction evidenceRow(data=app.state?.evidence){const row=el('div','bu-stencils');(data||[]).forEach((cells,d)=>{const block=el('div','bu-digit-block');block.append(stencil(cells),el('small','',\"'`DIGIT ${d+1}`));if(game.settings.candidates)block.append(el('\"'small','',\"'`Possible: ${B.Sim.candidates(cells).join('\"' ')}\"'`));row.append(block);});return row;}\nfunction title(){\n cancelHold();if(app.net?.online&&app.net.mode!=='\"'hub')app.net.leave();app.state=null;app.boardId=null;app.attract=false;app.screen='title';resultShown=false;hud.hidden=true;idleAt=now();game.live=false;game.o.autoPause=true;ui.hide();nativeResume();setPage('title',{kicker:'CITY EMERGENCY SERVICE · LOCAL 1982',name:'Bomb Union',subtitle:'Small repairs. Enormous consequences.',text:'Clock in. Cut carefully. Save the city.',actions:[['Start your shift',()=>caseSelect(true)],['Case files & replay',()=>caseSelect(false)],['Cooperative dispatch',()=>onlineMenu()],['Settings',()=>game.menu('settings')],['Field manual',()=>help()],['About & credits',()=>credits(0)]],meta:['1–4 TECHNICIANS','REAL-TIME DEDUCTION','ALL NATIVE PIXELS'],footer:'A loose connection is a team-building exercise.'});app.audio.music?.('title');\n}\napp.title=title;\nfunction caseSelect(campaign=false){const defs=Object.values(B.CONTENT);setPage('cases',{kicker:'DISPATCH BOARD',title:campaign?'A city-sized first shift':'Choose a case',text:campaign?'Start with the safe workbench, then take three calls across the city. Training can be skipped.':'Every case is available. Retry a saved seed or make a fresh dispatch.',actions:defs.map((c,i)=>({label:\"'`${i===0?'\"'TRAINING':\"'`CASE 0${i}`} · ${c.title}`,fn:()=>brief(c.id),primary:i===(campaign?0:1)})).concat([['\"'Back to title',title]]),back:title});}\nfunction brief(caseId,seed=randomSeed()){\n const c=B.CONTENT[caseId];app.pendingCase=caseId;app.seed=seed;setPage('brief',{kicker:c.subtitle,title:c.title,text:c.brief,sections:[['Dispatch',c.intro],['Your shift',caseId==='training'?'Safe practice · one board · one digit':\"'`${Math.floor(c.duration/60)} minute fuse · ${c.boardCount} sectors · ${c.digits} digit${c.digits>1?'\"'s':''}\"'`]],actions:[['\"'Open the device',()=>startCase(caseId,seed)],...(caseId==='training'?[['Skip training · waterfront',()=>brief('waterfront')]]:[]),['Case select',()=>caseSelect(false)]],back:()=>caseSelect(false)});\n}\nfunction startCase(caseId,seed=randomSeed(),snapshot=null){\n cancelHold();app.state=snapshot||B.Sim.create(caseId,seed,1);app.seed=app.state.seed;app.lastEvent=0;app.boardId=null;app.focusTarget=null;app.tool='cut';resultShown=false;lastTaunt=0;revisionShown=-1;justStarted=now();app.screen='evidence';ui.hide();nativeResume();game.live=\"'!!app.net?.online;game.o.autoPause=!app.net?.online;\n if(!app.net?.online&&game.settings.candidates)command({type:'\"'assist',enabled:true});\n progress.seeds[caseId]=seed;save();message(B.CONTENT[caseId].intro,'PIP',true);app.audio.music?.('investigation');openEvidence();\n}\napp.startCase=startCase;\nfunction openEvidence(){\n if(\"'!app.state){help();return;}if(app.attract)return;\n cancelHold();app.boardId=null;app.focusTarget=null;\n const s=app.state,count=s.boards.filter(b=>b.complete).length,gate=s.caseId==='\"'training'?1:2;\n setPage('evidence',{kicker:\"'`${B.CONTENT[s.caseId].subtitle} · SHARED EVIDENCE`,title:'\"'Read the gaps. Pick a sector.',text:'Bright = lit. A dash = confirmed dark. ? = unknown. Every repaired sector publishes a truthful patch.',actions:[{label:count>=gate?'Enter disarm code':\"'`Code locked · complete ${gate} sectors`,disabled:count<gate,fn:()=>codeEntry()},['\"'Stencil alphabet',()=>glyphReference()],['Field manual',()=>help()],['Pause / settings',()=>game.menu()],...(app.net?.online?[]:[['Return to dispatch',()=>confirmQuit()]])],back:()=>{const claimed=s.boards.find(b=>b.claim===seat()&&\"'!b.complete);if(claimed)openBoard(claimed.id);else game.menu();}});\n addPanel(evidenceRow());\n const grid=el('\"'div','bu-sectors');for(const b of s.boards){const owner=b.claim\"'!==null?app.net?.roster?.find(p=>p.id===b.claim)?.name||`Technician ${Number(b.claim)+1}`:null;const btn=el('\"'button',(b.complete?'done ':'')+(b.fire||b.recovery?'hazard':''));btn.dataset.board=b.id;btn.append(el('strong','',\"'`${b.complete?'\"'✓ ':b.fire?'FIRE · ':''}\"'${b.id} · ${b.name}`),el('\"'small','',\"'`Digit ${b.digit+1} · ${b.complete?'\"'evidence published':owner?\"'`${owner} · observe`:b.rule==='\"'jumper'?'jumper repair':'diagnose replacement'}\"'`));btn.disabled=b.complete;btn.onclick=()=>openBoard(b.id);grid.appendChild(btn);}addPanel(grid);\n const first=grid.querySelector('\"'button:not(:disabled)');if(first)first.focus({preventScroll:true});revisionShown=s.revision;\n}\napp.openEvidence=openEvidence;\nfunction openBoard(id){\n const b=app.state?.boards.find(q=>q.id===id);if(\"'!b||b.complete)return;\n if(b.claim===null||b.claim===seat())command({type:'\"'claim',board:id});\n ui.hide();nativeResume();app.screen='work';app.boardId=id;app.tool='cut';app.focusTarget=null;app.observing=b.claim\"'!==seat();\n message(app.observing?'\"'Quiet observation. This board belongs to another technician.':B.Sim.instruction(app.state,id),'PIP',true);\n const next=app.art.targets(app.state,view()).find(t=>t.componentId===b.order[b.step]&&t.kind==='terminal');app.focusTarget=next?.id||app.art.targets(app.state,view())[0]?.id;hud.hidden=false;\n}\napp.openBoard=openBoard;\nfunction help(){setPage('help',{kicker:'UNION FIELD MANUAL',title:'Little things, in the right order',sections:[['1 · Follow Pip’s order','Choose a sector. Cut the ordered component’s two round leads. Grip the body to remove it. Grip a spare in the tray and place it into the empty socket.'],['2 · Diagnose and join','Jumpers are straight wire. Other boards match SHAPE or COLOR/PATTERN. Select a spare and test it with Inspect. Hold the iron on each terminal and release in the green safe band.'],['3 · Recover','Wrong cut: solder the marked joint before its deadline. Wrong part: grip it back out and reuse the tray. Fire: hold foam on the fire marker. Leaving a board preserves every hazard.'],['4 · Deduce and dare','Repair evidence sectors, compare their 4×5 stencils, then choose digits. The next confirmation submits. An incorrect code ends the case. Dark cells count as evidence.']],keys:[[game.input.label('apply'),'Apply / hold; release in the safe band'],[game.input.label('inspect'),'Test spare / inspect'],[game.input.label('repeatOrder'),'Repeat current instruction'],[game.input.label('evidence'),'Evidence and board selection'],['1–4 / L1–R1','Choose physical tool'],['WASD / D-pad','Snap between targets']],actions:[['Stencil alphabet',glyphReference],['Back',()=>ui.back()]]});}\nfunction glyphReference(){setPage('alphabet',{kicker:'THE EXACT CODE ALPHABET',title:'Ten digits. Twenty cells each.',text:'These are the same cells the device uses. A confirmed dark cell rules out a digit just as surely as a lit cell.',actions:[['Back',()=>ui.back()]]});const grid=el('div','bu-help-glyphs');B.GLYPHS.forEach((g,i)=>{const d=el('div','bu-digit-block');d.append(stencil(g),el('small','',String(i)));grid.appendChild(d);});addPanel(grid);}\nfunction codeEntry(){\n if(\"'!app.state||app.state.status!=='\"'active')return;const s=app.state;if(app.codeDraft.length\"'!==s.evidence.length)app.codeDraft=s.evidence.map(()=>0);\n setPage('\"'code',{kicker:'DISARM CONSOLE · SELECT DIGITS',title:'A small act of courage.',text:'Choose the exact stencil. This screen only selects; the next screen submits.',actions:[['Review this code',()=>confirmCode()],['Back to evidence',openEvidence]],back:openEvidence});\n addPanel(evidenceRow());const dials=el('div','bu-dials');app.codeDraft.forEach((value,i)=>{const d=el('div','bu-dial'),b=el('button','',String(value)),preview=stencil(B.GLYPHS[value]);b.setAttribute('aria-label',\"'`Digit ${i+1}: ${value}`);b.dataset.digit=i;b._cycle=delta=>{app.codeDraft[i]=(app.codeDraft[i]+delta+10)%10;b.textContent=String(app.codeDraft[i]);b.setAttribute('\"'aria-label',\"'`Digit ${i+1}: ${app.codeDraft[i]}`);preview.replaceWith(stencil(B.GLYPHS[app.codeDraft[i]]));codeEntry();ui.root.querySelector(`[data-digit=\"${i}\"]`)?.focus();};b.onclick=()=>b._cycle(1);d.append(el('\"'small','bu-note',\"'`DIGIT ${i+1} · ◂ ▸`),b,preview);dials.appendChild(d);});addPanel(dials);dials.querySelector('\"'button')?.focus();\n}\nfunction confirmCode(){setPage('confirm-code',{kicker:'FINAL CONFIRMATION',title:\"'`Submit ${app.codeDraft.join('\"'')}?\"'`,text:app.net?.online?'\"'Your confirmation proposes this code to the crew. Others have five seconds to accept or veto. The fuse continues.':'A wrong code triggers the device. You can return to the evidence and keep working.',actions:[['Keep checking',openEvidence],{label:\"'`CONFIRM · SUBMIT ${app.codeDraft.join('\"'')}\"'`,fn:()=>{ui.hide();command({type:'\"'propose',code:app.codeDraft.slice()});if(app.state.status==='active')openEvidence();},primary:false}],back:codeEntry});}\nfunction votePanel(){const p=app.state?.proposal;if(\"'!p)return;setPage('\"'vote',{kicker:'CREW DECISION · FUSE CONTINUES',title:\"'`Submit ${p.code?.join('\"'')||'the proposed code'}?\"'`,text:'\"'Any veto cancels. Unanimous acceptance submits now; a strict majority may submit at the five-second deadline.',actions:[['Accept code',()=>{command({type:'vote',accept:true});ui.hide();openEvidence();}],['Veto · keep working',()=>{command({type:'vote',accept:false});ui.hide();openEvidence();}]],back:()=>{command({type:'vote',accept:false});openEvidence();}});}\nfunction confirmQuit(){setPage('quit',{kicker:'CLOCKING OUT?',title:'Leave this device?',text:'The current repair will be lost. Your completed case records are safe.',actions:[['Keep working',()=>ui.back()],['Return to dispatch',title]],back:()=>ui.back()});}\nfunction results(){\n if(resultShown||\"'!app.state)return;resultShown=true;cancelHold();app.boardId=null;const s=app.state,c=B.CONTENT[s.caseId],won=s.status==='\"'won';app.screen='results';app.audio.music?.(won?'success':'failure');message(won?c.success:c.failure,'PIP',true);if(won&&\"'!app.attract&&!app.net?.online&&!s.modified){if(!progress.completed.includes(s.caseId))progress.completed.push(s.caseId);progress.best[s.caseId]=Math.max(progress.best[s.caseId]||0,s.result?.score||0);save();}\n const order=['\"'training','waterfront','relay','central'],next=order[order.indexOf(s.caseId)+1];\n setPage('results',{kicker:won?(s.caseId==='central'?'THE CITY GETS ANOTHER MORNING':'DISPOSAL COMPLETE'):'INCIDENT REPORT',title:won?'Clock stopped. City saved.':s.cause==='expired'?'The fuse ran out.':'That was the wrong code.',emblem:won?'✓':'×',text:won?c.ending:\"'`${c.failure}'\"\\\\nCause: \"'${s.cause||'\"'unknown'}. The same seed lets you learn from this device.\"'`,stats:[[String(s.result?.score||0),'\"'TOTAL SCORE'],[formatTime(s.remaining),'FUSE SAVED'],[\"'`${s.boards.filter(b=>b.complete).length}/${s.boards.length}`,'\"'SECTORS'],[String(s.metrics?.mistakes||s.metrics?.errors||0),'MISTAKES']],medals:[['Clean work',\"'!(s.metrics?.mistakes||s.metrics?.errors)],['\"'Assisted',\"'!!s.assisted],['\"'Developer modified',\"'!!s.modified]],actions:[...(won&&next&&!app.net?.online?[[next==='\"'waterfront'?'Begin first dispatch':'Next dispatch',()=>brief(next)]]:[]),...(\"'!app.net?.online?[['\"'Retry same device',()=>brief(s.caseId,s.seed)],['Fresh device',()=>brief(s.caseId)],['Case select',()=>caseSelect(false)]]:[]),['About & acknowledgments',()=>credits(0)],['Return to title',title]],back:title});\n}\nfunction formatTime(t){t=Math.max(0,Math.ceil(t||0));return \"'`${Math.floor(t/60).toString().padStart(2,'\"'0')}:\"'${(t%60).toString().padStart(2,'\"'0')}\"'`;}\nfunction onlineMenu(){setPage('\"'online',{kicker:'ONE DEVICE · UP TO FOUR TECHNICIANS',title:'Cooperative dispatch',text:'Claim different sectors. Share truthful evidence. Decide the final code together. Cloud signaling connects standalone crews; some networks may require a TURN relay.',actions:[['Host a dispatch',async()=>{setPage('connecting',{title:'Calling the crew…',text:'Opening secure PeerJS Cloud signaling.',actions:[['Cancel',()=>{app.net.leave();onlineMenu();}]]});try{await app.net.host();lobby();}catch(e){networkError(e);}}],['Join a crew',()=>joinMenu()],['Back',title]],back:title});}\nconst alphabet='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let roomDraft='AAAAAA';\nfunction joinMenu(){setPage('join',{kicker:'ENTER SIX-CHARACTER ROOM CODE',title:'Find your crew',text:'Turn each character with left/right, then connect. Keyboard users may paste a room code below.',actions:[['Connect to room',async()=>{try{setPage('connecting',{title:'Connecting…',text:\"'`Looking for ${roomDraft}.`,actions:[['\"'Cancel',()=>{app.net.leave();joinMenu();}]]});await app.net.join(roomDraft);lobby();}catch(e){networkError(e);}}],['Back',onlineMenu]],back:onlineMenu});const row=el('div','bu-code-entry');roomDraft.split('').forEach((ch,i)=>{const b=el('button','',ch);b._cycle=d=>{roomDraft=roomDraft.slice(0,i)+alphabet[(alphabet.indexOf(roomDraft[i])+d+alphabet.length)%alphabet.length]+roomDraft.slice(i+1);b.textContent=roomDraft[i];};b.onclick=()=>b._cycle(1);row.appendChild(b);});addPanel(row);const input=el('input','bu-json');input.type='text';input.value=roomDraft;input.maxLength=6;input.style.height='40px';input.setAttribute('aria-label','Paste room code');input.oninput=()=>{roomDraft=input.value.toUpperCase().replace(/[\"'^A-Z2-9]/g,'\"'').slice(0,6);};addPanel(input);}\nfunction lobby(){setPage('lobby',{kicker:'COOPERATIVE DISPATCH',title:app.net.code?\"'`Room ${app.net.code}`:'\"'Crew connected',text:()=>\"'`${app.net.status}'\"\\\\n\"'${app.net.roster.map(p=>p.name).join('\"' · ')}\\\\nWorkload and fuse lock when dispatch begins.\"'`,actions:app.net.authority?[['\"'Dispatch · waterfront',()=>app.net.start('waterfront',randomSeed())],['Dispatch · power relay',()=>app.net.start('relay',randomSeed())],['Dispatch · central',()=>app.net.start('central',randomSeed())],['Close room',()=>{app.net.leave();onlineMenu();}]]:[['Waiting for host · refresh',lobby],['Leave crew',()=>{app.net.leave();onlineMenu();}]],back:()=>{app.net.leave();onlineMenu();}});}\nfunction networkError(e){setPage('connection-error',{kicker:'RADIO CONTACT LOST',title:'The crew could not connect.',text:String(e?.message||e)+'\\\\nCheck the room code and network connection. Try hosting from the other device; restrictive networks may need a TURN relay.',actions:[['Try again',onlineMenu],['Back to title',title]],back:title});}\napp.net=new B.Network({onState:s=>{app.state=s;},onStart:s=>{ui.hide();startCase(s.caseId,s.seed,s);},onStatus:text=>{if(app.screen==='lobby')lobby();},onRoster:()=>{if(app.screen==='lobby')lobby();},onEnd:reason=>{cancelHold();app.audio.suspend?.();if(app.state&&app.state.status\"'!=='\"'active')return;setPage('network-ended',{kicker:'DISPATCH CLOSED',title:'The radio has gone quiet.',text:String(reason||'The host ended the dispatch.'),actions:[['Return to title',title]],back:title});}});\nfunction credits(page=0){const report=B.REPORT;const groups=[['Source Information',Object.entries(report?.sourceInformation||{source:'Bomb Squad (1982)',plan:'PLAN.md'}).map(([k,v])=>[k,v])],['Testing Feedback',(report?.testingFeedback||['unknown']).map((v,i)=>[String(i+1),v])],['Engine Feedback',(report?.engineFeedback||['unknown']).map((v,i)=>[String(i+1),v])],['Prompt Feedback',(report?.promptFeedback||['unknown']).map((v,i)=>[String(i+1),v])],['Credits & licenses',[['Original game','Bomb Squad (1982), Mattel Electronics. Source manual and creator history: Blue Sky Rangers. This is an original homage, not an official sequel.'],['Bomb Union','Original design, code, content, native pixel art, animations and procedural sound produced with Codex. Partner: Pip. Saboteur: Dr. Tick. Response crew: municipal union Local 1982.'],['Engine','my-3D2dge v0.89.1, Michael Crosato, MIT. Unmodified engine; game-owned native extensions.'],['Networking','AI Hub session protocol 1 / client 1.4.0. PeerJS 1.5.5, MIT.'],['Acknowledgments','The Blue Sky Rangers preserve the manuals and design history that made this repair-and-deduction homage possible.'],['Usage','added on import']]]];page=(page+groups.length)%groups.length;const [name,items]=groups[page];setPage('credits',{kicker:\"'`ABOUT BOMB UNION · ${page+1} / ${groups.length}`,title:name,sections:items.map(([k,v])=>[k,String(v)]),actions:[['\"'Next page',()=>credits(page+1)],['Previous page',()=>credits(page-1)],['Back',()=>ui.back()]],back:()=>ui.back()});}\napp.credits=credits;\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\n/* Bomb Union — native Game/Shell foundation adapted from the handoff pointclick/adventure kits. */\n(() => {\n'use strict';\nconst E=My3D2dge, B=globalThis.BU, \"'$=s=>document.querySelector(s);\nconst INPUT={...E.Input.DEFAULT,confirm:['\"'Enter','Space','Pad0'],cancel:['Escape','Backspace','Pad1'],apply:['Space','Enter','Mouse0','Pad0'],drop:['Mouse2','Backspace','Pad1'],inspect:['KeyE','Mouse1','Pad2'],repeatOrder:['KeyR','Pad3'],previousTool:['KeyQ','WheelUp','Pad4'],nextTool:['KeyF','WheelDown','Pad5'],precision:['ShiftLeft','ShiftRight','Pad6'],evidence:['Tab','Pad7','Pad17'],toolCut:['Digit1'],toolGrip:['Digit2'],toolSolder:['Digit3'],toolExtinguish:['Digit4']};\nconst app=B.app={state:null,screen:'title',boardId:null,focusTarget:null,tool:'cut',lastEvent:0,caption:'Pip is checking the kettle. You can check the circuits.',speaker:'DISPATCH',attract:false,seed:1,codeDraft:[],editing:false};\nconst tools=['cut','grip','solder','extinguish'], toolNames=['Cutters','Pliers','Iron','Foam'];\nconst game=app.game=new E.Game({id:'bomb-union-v1',canvas:'screen',res:[640,360],expand:true,view:'topdown',views:['topdown'],input:INPUT,draw:true,fullscreen:'button',autoPause:true,bg:'#081b22',menu:{quit:false,items:[['Developer workbench',()=>openDev()],['Case evidence',()=>openEvidence()],['About & credits',()=>credits(0)]],settings:[{key:'music',value:.1},{key:'glyphs',value:'playstation'},{key:'voice',label:'Radio voices',type:'slider',value:.75,min:0,max:1,step:.05,group:'Sound',apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},{key:'candidates',label:'Show possible digits',type:'toggle',value:false,help:'Adds automatic stencil elimination. Assisted results are labeled.',group:'Game'},{key:'touchAssist',label:'Touch solder assistance',type:'toggle',value:true,help:'Releases a legal joint inside the safe band.',group:'Game'},{key:'hintDelay',label:'Guidance delay',type:'slider',value:8,min:0,max:30,step:1,group:'Game'}],controls:{apply:'Apply selected tool',drop:'Drop / back',inspect:'Test / inspect',repeatOrder:'Repeat work order',previousTool:'Previous tool',nextTool:'Next tool',precision:'Precision snap',evidence:'Evidence / board',toolCut:'Cutters',toolGrip:'Pliers',toolSolder:'Soldering iron',toolExtinguish:'Extinguisher',attack:false,dash:false,jump:false,skill:false}}});\nconst ui=app.ui=new E.Shell(game,{tv:true,theme:{font:'Trebuchet MS, system-ui, sans-serif',titleFont:'Trebuchet MS, sans-serif',scale:()=>Math.max(.82,Math.min(2.12,innerWidth/930))},screens:{pause:{kicker:()=>app.net?.online?'Online · fuse continues':'Union break',text:()=>app.net?.online?'This is a local menu. Your crew and the fuse keep going.':'The fuse is paused. Your tea, unfortunately, is not.'},help:{title:'Field manual',sections:[['One careful repair','Cut BOTH leads of the ordered part. Grip it out. Grip a spare from the tray, place it in the empty socket, then hold the iron on each lead. Release inside the green band.'],['A useful mistake','A wrong cut marks a recovery joint. Resolder it within eight seconds. Wrong replacements fail continuity and can be gripped out. An established fire needs foam.'],['Read the code','Each completed sector publishes lit AND dark cells. Unknown cells mean nothing yet. Compare the exact stencil alphabet, then deliberately confirm your chosen code.']]}}});\napp.art=new B.Art(game); app.audio=new B.Audio(game);\nlet progress={v:1,unlocks:['training','waterfront'],best:{},seeds:{},completed:[]};\ntry{const p=E.store.get('bomb-union-progress-v1',null);if(p?.v===1&&Array.isArray(p.completed)&&p.best&&p.seeds) progress={...progress,...p};}catch{}\napp.progress=progress;\nconst hud=document.createElement('div');hud.id='bu-hud';hud.hidden=true;\nhud.innerHTML='<div class=\\\"bu-top\\\"><div class=\\\"bu-case\\\"><small>MUNICIPAL RESPONSE · BOMB UNION</small><strong></strong></div><div class=\\\"bu-fuse\\\"><small>FUSE<br>REMAINING</small><strong>00:00</strong></div></div><div class=\\\"bu-online\\\"></div><div class=\\\"bu-side\\\"><div class=\\\"bu-order\\\"><small>CURRENT WORK ORDER</small><p></p><div class=\\\"bu-next\\\"></div></div><button class=\\\"bu-mini-evidence\\\" aria-label=\\\"Open evidence\\\"></button><div class=\\\"bu-heat\\\">IRON HEAT <span></span><div><i></i></div></div><div class=\\\"bu-alert\\\" hidden></div></div><div class=\\\"bu-context\\\"></div><div class=\\\"bu-holdbar\\\" hidden><div class=\\\"safe\\\"></div><div class=\\\"fill\\\"></div><div class=\\\"bu-holdlabel\\\"></div></div><div class=\\\"bu-bottom\\\"><div class=\\\"bu-caption\\\"><b>PIP · TECHNICAL PARTNER</b><span></span></div><div class=\\\"bu-tools\\\"></div></div><button class=\\\"bu-touch-action\\\" hidden></button>';\ndocument.body.appendChild(hud);\nconst H={case:hud.querySelector('.bu-case strong'),fuse:hud.querySelector('.bu-fuse strong'),fuseBox:hud.querySelector('.bu-fuse'),order:hud.querySelector('.bu-order p'),next:hud.querySelector('.bu-next'),evidence:hud.querySelector('.bu-mini-evidence'),heat:hud.querySelector('.bu-heat'),heatText:hud.querySelector('.bu-heat span'),heatFill:hud.querySelector('.bu-heat i'),alert:hud.querySelector('.bu-alert'),context:hud.querySelector('.bu-context'),hold:hud.querySelector('.bu-holdbar'),safe:hud.querySelector('.safe'),fill:hud.querySelector('.fill'),holdText:hud.querySelector('.bu-holdlabel'),caption:hud.querySelector('.bu-caption span'),speaker:hud.querySelector('.bu-caption b'),online:hud.querySelector('.bu-online'),touch:hud.querySelector('.bu-touch-action')};\nH.evidence.onclick=()=>openEvidence();\nconst toolButtons=tools.map((t,i)=>{const b=document.createElement('button');b.innerHTML='<kbd>'+(i+1)+'</kbd>'+toolNames[i];b.onclick=()=>setTool(t);hud.querySelector('.bu-tools').appendChild(b);return b;});\nlet actionHeld=false, touchAuto=false, idleAt=performance.now(), lastHUD=0,lastPointer=null, lastPad=[],attractClock=0,attractStage=0,attractCase=0,attractWait=0,lastTaunt=0,justStarted=0,revisionShown=-1,resultShown=false,stickyCaption=0;\nconst randomSeed=()=>crypto.getRandomValues(new Uint32Array(1))[0];\nconst save=()=>{if(\"'!app.attract&&!app.net?.online)try{E.store.set('\"'bomb-union-progress-v1',progress);}catch{}};\nconst now=()=>performance.now();\nconst nativePause=game.pause.bind(game),nativeResume=game.resume.bind(game);\ngame.pause=reason=>{cancelHold();if(\"'!app.net?.online)app.audio.suspend?.();return nativePause(reason);};\ngame.resume=()=>{nativeResume();app.audio.resume?.();};\nfunction signalInput(e){\n if(e.type==='\"'pointermove'&&e.movementX===0&&e.movementY===0)return;\n idleAt=now();\n if(app.attract){e.preventDefault?.();e.stopImmediatePropagation?.();wake();return;}\n if(e.type\"'!=='\"'pointermove')app.audio.unlock?.();\n}\nfor(const type of ['keydown','pointerdown','pointermove','touchstart','wheel'])addEventListener(type,signalInput,{capture:true,passive:false});\naddEventListener('contextmenu',e=>e.preventDefault());\naddEventListener('blur',()=>cancelHold());\naddEventListener('pointerup',()=>{if(actionHeld)endHold();},{capture:true});\naddEventListener('pointercancel',()=>cancelHold());\nconst view=()=>({screen:app.screen,boardId:app.boardId,focusTarget:app.focusTarget,tool:app.tool,attract:app.attract,success:app.state?.status==='won',reducedMotion:game.settings.reduceMotion,precision:game.input.down('precision')});\nconst board=()=>app.state?.boards.find(b=>b.id===app.boardId);\nconst seat=()=>app.net?.online?app.net.seat:0;\nconst canAct=()=>app.state?.status==='active'&&(\"'!app.net?.online||app.net.canPlay)&&!app.attract;\nfunction command(cmd){if(!app.state)return {ok:false,reason:'\"'No active case.'};const result=app.net?.online?app.net.command(cmd):B.Sim.command(app.state,0,{...cmd,id:cmd.id||'local-'+(++app.commandId),caseId:app.state.caseId});if(result?.ok===false)ui.toast('Check the target',result.reason,2.5);return result;}\napp.commandId=0;app.command=command;\nfunction message(text,speaker='PIP',priority=false){if(\"'!priority&&now()<stickyCaption)return;app.caption=String(text).replace(/''^(PIP|DR'\"\\\\. TICK):\\\\s*/,'');app.speaker=speaker;if(priority)stickyCaption=now()+3500;app.audio.voice?.(app.caption,speaker.toLowerCase().includes('tick')?'saboteur':'partner',priority?2:1);}\nfunction events(){if(\"'!app.state)return;for(const e of app.state.events||[]){if(e.id<=app.lastEvent)continue;app.lastEvent=e.id;app.art.event?.(e);const type=e.type||'\"'';app.audio.effect?.(type);if(e.text)message(e.text,type.includes('taunt')?'DR. TICK':'PIP',/recover|fire|wrong|fail/.test(type));} }\nfunction setTool(t){if(\"'!tools.includes(t))return;cancelHold();app.tool=t;app.audio.effect?.('\"'select');}\nfunction cancelHold(){if(\"'!actionHeld&&!board()?.hold)return;actionHeld=false;touchAuto=false;if(app.state?.status==='\"'active'&&board()?.hold)command({type:'cancel',board:app.boardId});}\nfunction endHold(){if(\"'!actionHeld)return;actionHeld=false;touchAuto=false;command({type:'\"'end',board:app.boardId});}\nfunction target(){return app.art.targets(app.state,view()).find(t=>t.id===app.focusTarget);}\nfunction apply(t=target(),assisted=false){\n if(\"'!canAct()||!t)return;app.focusTarget=t.id;const b=board();if(!b||b.claim!==seat())return;\n const c=t.componentId||t.component;\n if(assisted){\n  if(t.kind==='\"'fire')setTool('extinguish');\n  else if(t.kind==='spare')setTool('grip');\n  else if(t.kind==='terminal')setTool(b.recovery||b.components.find(q=>q.id===c)?.part?'solder':'cut');\n  else if(t.kind==='component')setTool('grip');\n }\n if(t.kind==='test'){inspect();return;}\n let cmd;\n if(app.tool==='cut'&&t.kind==='terminal')cmd={type:'cut',component:c,terminal:t.terminal};\n else if(app.tool==='grip'&&t.kind==='spare')cmd={type:'pick',spare:t.spare};\n else if(app.tool==='grip'&&t.kind==='component')cmd={type:b.held?'place':'grip',component:c};\n else if(app.tool==='solder'&&