{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"ps -eo pid,ppid,args | rg 'git clone --depth 1 https://github.com/michaelcrosato/ai-hub.git|git-remote-https origin https://github.com/michaelcrosato/ai-hub.git|git index-pack'\"","aggregated_output":"1451477 1449194 git clone --depth 1 https://github.com/michaelcrosato/ai-hub.git vendor/hub-repo\n1451487 1451486 /usr/lib/git-core/git-remote-https origin https://github.com/michaelcrosato/ai-hub.git\n1455058 1449194 /bin/bash -c ps -eo pid,ppid,args | rg 'git clone --depth 1 https://github.com/michaelcrosato/ai-hub.git|git-remote-https origin https://github.com/michaelcrosato/ai-hub.git|git index- [... omitted end of long line]\n1455061 1455058 rg git clone --depth 1 https://github.com/michaelcrosato/ai-hub.git|git-remote-https origin https://github.com/michaelcrosato/ai-hub.git|git index-pack\n","exit_code":0,"status":"completed"}}
