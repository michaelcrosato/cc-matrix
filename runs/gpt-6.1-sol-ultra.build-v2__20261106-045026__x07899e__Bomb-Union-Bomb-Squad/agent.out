if(cmd.operation==='fault'&&b){if(b.complete)return fail('Inject a fault into an unfinished board.');const c=component(b,cmd.component)||b.components.find(c=>!c.done&&c.id!==b.order[b.step] [... omitted end of long line]\n208:      else if(cmd.operation==='reveal'){for(const bb of s.boards)for(const i of bb.mask)s.evidence[bb.digit][i]=B.GLYPHS[s.code[bb.digit]][i];}\n209:      else if(cmd.operation==='solve'){resolveCode(s,s.code);}\n210:      else return fail('Unknown developer operation.');\n213:    if(cmd.type==='propose') {\n219:      s.proposal={code:[...code],proposer:seat,eligible:[...s.seats],accepted:[seat],remaining:5};\n220:      event=emit(s,'vote','PIP: Code proposed. Accept or veto; the fuse continues.');\n226:      if(cmd.accept===false){s.proposal=null;return accept('vote-cancel','PIP: Veto received. Keep repairing.');}\n340:    return fail('Unknown tool operation.');\n388:  function nextAction(s,id) {\n449:  function createScratch(t,seed=1) {\n482:  B.Sim={create,command,advance,board,component,compatible,candidates,instruction,nextAction,snapshot,restore,join,\n483:    validateContent,validateTemplate,exportTemplate,createScratch,tuning,random,version:VERSION};\n","exit_code":0,"status":"completed"}}
