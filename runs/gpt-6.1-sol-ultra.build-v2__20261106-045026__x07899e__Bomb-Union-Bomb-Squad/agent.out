{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > tests/smoke.py <<'EOF'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nimport json\nroot=Path(__file__).resolve().parents[1]\nproject=json.loads((root/'project.json').read_text())\nurl=(root.parent/(project['slug']+'.html')).as_uri()\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True)\n page=browser.new_page(viewport={'width':1920,'height':1080})\n errors=[]\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.goto(url)\n page.wait_for_timeout(1300)\n print(json.dumps({'errors':errors,'game':page.evaluate('({loaded:\"'!!window.__game,errors:window.__game?.errors,screen:BU.app?.screen,body:document.body.innerText.slice(-1500)})'\"')},indent=2))\n page.screenshot(path=str(root/'evidence/title-initial.png'))\n browser.close()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/smoke.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
