oin('\"' ')}\"'`));row.append(block);});return row;}\nfunction title(){\n cancelHold();if(app.net?.online&&app.net.mode!=='\"'hub')app.net.leave();app.state=null;app.boardId=null;app.attract=false;app.screen='title';resultShown=false;hud.hidden=true;idleAt=now();game.live=false;game.o.autoPause=true;ui.hide();nativeResume();setPage('title',{kicker:'CITY EMERGENCY SERVICE · LOCAL 1982',name:'Bomb Union',subtitle:'Small repairs. Enormous consequences.',text:'Clock in. Cut carefully. Save the city.',actions:[['Start your shift',()=>caseSelect(true)],['Case files & replay',()=>caseSelect(false)],['Cooperative dispatch',()=>onlineMenu()],['Settings',()=>game.menu('settings')],['Field manual',()=>help()],['About & credits',()=>credits(0)]],meta:['1–4 TECHNICIANS','REAL-TIME DEDUCTION','ALL NATIVE PIXELS'],footer:'A loose connection is a team-building exercise.'});app.audio.music?.('title');\n}\napp.title=title;\nfunction caseSelect(campaign=false){const defs=Object.values(B.CONTENT);setPage('cases',{kicker:'DISPATCH BOARD',title:campaign?'A city-sized first shift':'Choose a case',text:campaign?'Start with the safe workbench, then take three calls across the city. Training can be skipped.':'Every case is available. Retry a saved seed or make a fresh dispatch.',actions:defs.map((c,i)=>({label:\"'`${i===0?'\"'TRAINING':\"'`CASE 0${i}`} · ${c.title}`,fn:()=>brief(c.id),primary:i===(campaign?0:1)})).concat([['\"'Back to title',title]]),back:title});}\nfunction brief(caseId,seed=randomSeed()){\n const c=B.CONTENT[caseId];app.pendingCase=caseId;app.seed=seed;setPage('brief',{kicker:c.subtitle,title:c.title,text:c.brief,sections:[['Dispatch',c.intro],['Your shift',caseId==='training'?'Safe practice · one board · one digit':\"'`${Math.floor(c.duration/60)} minute fuse · ${c.boardCount} sectors · ${c.digits} digit${c.digits>1?'\"'s':''}\"'`]],actions:[['\"'Open the device',()=>startCase(caseId,seed)],...(caseId==='training'?[['Skip training · waterfront',()=>brief('waterfront')]]:[]),['Case select',()=>caseSelect(false)]],back:()=>caseSelect(false)});\n}\nfunction startCase(caseId,seed=randomSeed(),snapshot=null){\n cancelHold();app.state=snapshot||B.Sim.create(caseId,seed,1);app.seed=app.state.seed;app.lastEvent=0;app.boardId=null;app.focusTarget=null;app.tool='cut';resultShown=false;lastTaunt=0;revisionShown=-1;justStarted=now();app.screen='evidence';ui.hide();nativeResume();game.live=\"'!!app.net?.online;game.o.autoPause=!app.net?.online;\n if(!app.net?.online&&game.settings.candidates)command({type:'\"'assist',enabled:true});\n progress.seeds[caseId]=seed;save();message(B.CONTENT[caseId].intro,'PIP',true);app.audio.music?.('investigation');openEvidence();\n}\napp.startCase=startCase;\nfunction openEvidence(){\n if(\"'!app.state){help();return;}if(app.attract)return;\n cancelHold();app.boardId=null;app.focusTarget=null;\n const s=app.state,count=s.boards.filter(b=>b.complete).length,gate=s.caseId==='\"'training'?1:2;\n setPage('evidence',{kicker:\"'`${B.CONTENT[s.caseId].subtitle} · SHARED EVIDENCE`,title:'\"'Read the gaps. Pick a sector.',text:'Bright = lit. A dash = confirmed dark. ? = unknown. Every repaired sector publishes a truthful patch.',actions:[{label:count>=gate?'Enter disarm code':\"'`Code locked · complete ${gate} sectors`,disabled:count<gate,fn:()=>codeEntry()},['\"'Stencil alphabet',()=>glyphReference()],['Field manual',()=>help()],['Pause / settings',()=>game.menu()],...(app.net?.online?[]:[['Return to dispatch',()=>confirmQuit()]])],back:()=>{const claimed=s.boards.find(b=>b.claim===seat()&&\"'!b.complete);if(claimed)openBoard(claimed.id);else game.menu();}});\n addPanel(evidenceRow());\n const grid=el('\"'div','bu-sectors');for(const b of s.boards){const owner=b.claim\"'!==null?app.net?.roster?.find(p=>p.id===b.claim)?.name||`Technician ${Number(b.claim)+1}`:null;const btn=el('\"'button',(b.complete?'done ':'')+(b.fire||b.recovery?'hazard':''));btn.dataset.board=b.id;btn.append(el('strong','',\"'`${b.complete?'\"'✓ ':b.f