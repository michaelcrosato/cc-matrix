{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat >> src/main.js <<'EOF'\nconst tuningLabels={timeScale:'Simulation speed',fuseScale:'Authored fuse scale',solderMin:'Safe band begins',solderMax:'Safe band ends',heatGain:'Iron heat gain',cooling:'Board cooling',recoveryWindow:'Recovery window',penalty:'Mistake time penalty',fireIntensity:'Fire intensity',extinguishTime:'Foam hold time',hintDelay:'Guidance delay',precision:'Snap precision',toolTravel:'Tool travel speed',maxHold:'Maximum hold',testCost:'Diagnosis time cost'};\nfor(const [key,range] of Object.entries(B.TUNING_RANGES)){game.settings.define({key:'dev_'+key,label:tuningLabels[key]||key,type:'slider',value:B.DEFAULTS[key],min:range[0],max:range[1],step:range[1]<=5?.05:1,group:'Workbench',apply:(_,value)=>{if(app.devApplying&&app.state&&app.net?.mode\"'!=='\"'hub'&&(\"'!app.net?.online||app.net.authority))command({type:'\"'tune',values:{[key]:value}});}});}\nfunction openDev(){\n const allowed=app.net.mode\"'!=='\"'hub'&&(\"'!app.net.online||app.net.authority);\n setPage('\"'dev',{kicker:allowed?'DEVELOPER WORKBENCH · MODIFIED RUNS LABELED':'LIVE HUB · INSPECTION ONLY',title:'Make the invisible inspectable.',text:app.state?\"'`Case ${app.state.caseId} · seed ${app.state.seed} · revision ${app.state.revision}'\"\\\\nSeat \"'${seat()} · ${app.net.status}'\"\\\\n\"'${board()?B.Sim.instruction(app.state,app.boardId):'\"'Choose a board to inspect its physical state.'}\"'`:'\"'Start a case to inspect, tune, or author a scratch board.',actions:[{label:'Live balance sliders',disabled:\"'!allowed||!app.state,fn:()=>tuningPage(0)},{label:'\"'Board / case authoring',disabled:\"'!allowed,fn:()=>openEditor()},{label:'\"'Inspect physical state',disabled:\"'!app.state,fn:()=>inspectState()},{label:'\"'Checkpoint current device',disabled:\"'!allowed||!app.state,fn:()=>{app.checkpoint=B.Sim.snapshot(app.state);ui.toast('\"'Checkpoint stored','Only this developer visit; 