{"type":"system","subtype":"background_tasks_changed","tasks":[{"task_id":"brirxkx7z","run_id":"0mw01k37w-de6c4c11","task_type":"local_bash","description":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium__20261102-183711__xb81546/work/Walter*/\npython3 - <<'EOF'\np='src/g2-world.js'\ns=open(p).read()\ns=s.replace(\"talk.say(g.texts, { name: W.names[g.who] || '', portrait: g.who === 'narrator' || !W.looks[portraitKind(g.who)] ? null : rigFor(portraitKind(g.who)), onDone: next });\",\n\"talk.say(g.texts, { name: W.names[g.who] || '', portrait: g.who === 'narrator' || !W.looks[portraitKind(g.who)] ? null : rigFor(portraitKind(g.who)), onDone: next, auto: auto ? 1.6 : undefined });\")\ns=s.replace(\"function ask(text, who, choices, onChoice) {\\n  mode = 'talk';\",\"function ask(text, who, choices, onChoice) {\\n  if (auto) return onChoice(choices.length - 1);   // the demo never sleeps on its own\\n  mode = 'talk';\")\nopen(p,'w').write(s)\np='test/features.py'\ns=open(p).read()\ns=s.replace(\"check('About shows ' + key, key in t, key)\",\"check('About shows ' + key, key.lower() in t.lower(), key)\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"auto: auto\" src/g2-world.js | head -2; node build.mjs >/dev/null\ncat > /tmp/attract.py <<'EOF'\nimport os, json, sys\nfrom playwright.sync_api import sync_playwright\nF = os.path.abspath(sys.argv[1])\nwith sync_playwright() as pw:\n    br = pw.chromium.launch(args=['--autoplay-policy=no-user-gesture-required']); p = br.new_context(viewport={'width':1280,'height':720}).new_page(); errs=[]\n    p.on('pageerror', lambda e: errs.append(str(e))); p.on('console', lambda m: errs.append(m.text) if m.type=='error' else None)\n    p.goto('file://'+F); p.wait_for_timeout(2000)\n    p.evaluate(\"WW.debug.setLastInput(0)\"); \n    p.evaluate(\"WW.debug.game.go('attract')\"); \n    last=None\n    for i in range(150):\n        p.wait_for_timeout(1000); s=json.loads(p.evaluate(\"JSON.stringify(WW.debug.game.debug.snapshot())\"))\n        if s['auto']!=last: print(i, s['scene'], s['auto'], s['map'], s['mode'], 'cash', s['dirty'], s['clean'], 'day', s['day']); last=s['auto']\n        if i in (30,60,90): p.screenshot(path=f'/tmp/ww-shots/att-{i}.png')\n        if s['scene']!='attract': print('left attract', s['scene']); break\n    print('errors', errs)\n    br.close()\nEOF\ntimeout 170 python3 /tmp/attract.py ../Walter-Whitewash-BreakingBad-claude-sonnet-5-5-medium-20261102-183711.html"},{"task_id":"b124d9amp","run_id":"0mw01n3bi-30a2cf77","task_type":"local_bash","description":"Wait for attract-mode browser run"}],"uuid":"ce455c50-d025-431a-917a-2bd4f57dbe38","session_id":"8704baa7-6f68-414d-afec-f55fd2d8121c"}
