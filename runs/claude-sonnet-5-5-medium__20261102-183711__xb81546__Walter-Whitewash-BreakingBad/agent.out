stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n// my-3D2dge game checker: loads a game in a headless browser, presses start, plays it for a\n// moment, switches through the game's camera views, and reports errors, warnings, frame rate,\n// how much of the window the picture covers (covers: 1 = no black bars), how much is actually on screen, and screenshots.\n//\n// Setup (once):   npm install          (installs Playwright)\n//                 npx playwright install chromium\n// Usage:          node tools/check.mjs path/to/game.html[#scene] [--seconds 4] [--out check-output] [--size 390x844@3]\n//                 (--size: the window in CSS pixels and its pixel density; @2 and up is a phone or tablet, with touch)\n// Exit code is 1 if the page threw any error or never drew anything, so agents and CI can rely on it.\n// A game that sets game.debug = { snapshot() { return {...} } } gets its snapshot printed after play (its own state:\n// the hero, the objective, what an agent needs to see the game is where it should be).\nimport { chromium } from 'playwright';\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { resolve, join } from 'node:path';\nimport { pathToFileURL } from 'node:url';\n\nconst args = process.argv.slice(2);\nconst file = args.find(a => !a.startsWith('--') && !/^\\d+(\\.\\d+)?$/.test(a));\nconst opt = (name, def) => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : def; };\nif (!file) { console.error('Usage: node tools/check.mjs path/to/game.html [--seconds 4] [--out check-output]'); process.exit(2); }\nconst seconds = +opt('seconds', 4), out = resolve(opt('out', 'check-output'));\nconst [, sw, sh, sd] = (opt('size', '1280x720') || '').match(/^(\\d+)x(\\d+)(?:@(\\d+(?:\\.\\d+)?))?$/) || [0, 1280, 720];\nconst dpr = +(sd || 1), size = { viewport: { width: +sw, height: +sh }, deviceScaleFactor: dpr, ...(dpr >= 2 && { isMobile: true, hasTouch: true }) };\nmkdirSync(out, { recursive: true });\n\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--autoplay-policy=no-user-gesture-required'] });\nconst page = await browser.newPage(size);\nconst errors = [], warnings = [], engineWarnings = [], external = new Set();\npage.on('pageerror', e => errors.push(String(e && e.stack || e)));\npage.on('console', m => {\n  const t = m.text();\n  if (m.type() === 'error') errors.push(t);\n  else if (m.type() === 'warning') (t.startsWith('my-3D2dge:') ? engineWarnings : warnings).push(t);\n});\npage.on('request', r => { const u = r.url(); if (/^https?:/i.test(u)) external.add(u.split('?')[0]); });\n\n// a #hash after the file name is kept, so deep links like game.html#platformer work\nconst [filePath, hash] = file.split('#');\nawait page.goto(pathToFileURL(resolve(filePath)).href + (hash ? '#' + hash : ''));\nawait page.waitForTimeout(1200);\n789:    /** glyphs: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' |\n792:    this.glyphs = 'auto'; this.rumbleScale = .6; this.padLost = false;\n895:   *  button by its symbol on the controller in use ('A', '✕', 'B'...; glyphs picks the family) */\n901:    if (/^Pad\\d+$/.test(code)) return (PAD_GLYPHS[this.padStyle()] || PAD_GLYPHS.xbox)[+code.slice(3)] || code;\n904:  /** the controller family whose symbols label() shows: glyphs, or with glyphs 'auto' the one its name says */\n906:    if (this.glyphs && this.glyphs !== 'auto') return this.glyphs;\n908:    return /054c|playstation|dualsense|dualshock|wireless controller/i.test(id) ? 'playstation' : /057e|nintendo|pro controller|joy-con/i.test(id) ? 'nintendo' : 'xbox';\n1264:  xbox: ['A', 'B', 'X', 'Y', 'LB', 'RB', 'LT', 'RT', 'View', 'Menu', 'LS', 'RS', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Guide'],\n1302: * 6. PIXEL FONT  3x5 glyphs for in-world numbers and labels\n1354:  normal: { glyphs: parseFont(G57), h: 7, desc: 2, gap: 1, space: 3, upper: false },\n1355:  tiny: { glyphs: parseFont(GLYPHS), h: 5, desc: 0, gap: 2, space: 3, upper: true, mono: 3 }\n1369:  _glyph(f, ch) { return f.glyphs[f.upper ? ch.toUpperCase() : ch] || f.glyphs[ch.toUpperCase()] || f.glyphs['?']; },\n1372:    for (const ch of line) w += ch === ' ' ? f.space + 1 : (f.mono || this._glyph(f, ch).w) + 1;\n1411:          const gl = this._glyph(f, ch), off = f.mono ? Math.floor((f.mono - gl.w) / 2) : 0;\n1426:   * Big logo text for title screens: scaled glyphs with a vertical color gradient, an outline and an extruded 3D edge.\n1444:        const gl = this._glyph(f, ch);\n2999:  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { g.input.glyphs = v; } },\n6096: *      extra: moss: '#4a7a3a' (stone), flower: '#ffe070' (ground), glyph (bonus)\n6490:  /** the block with a glyph on it (t.glyph, '?'; t.glyphColor) */\n6491:  bonus(g, f) { TILES._bevel(g, f); const { X0, Y0, W, H, lo, t } = f, sc = Math.max(1, Math.round(W / 12)); E.font.text(g, t.glyph || '?', X0 + W / 2, Y0 + Math.round(H / 2) - Math.round(3.5 * sc), t.glyphColor || '#fff4c8', { align: 'center', outline: lo, scale: sc }); },\n9107: *    changes; the controller's dead zone, aim, symbols and vibration; the touch buttons' side, size and opacity; restore\nv24.22.1\n/home/micha/.local/bin/playwright","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01N3K2Tv1i12Le418Pw9XhDr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
