: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#0c0814;color:#c8b8a0;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#fff0d0;font-size:16px;letter-spacing:.08em\">MAD MUGS</b><span>Pouring the first drink of the day...</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9a85c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n<script>${engine}</script>\n<script>${game}</script>\n</body>\n</html>\n`;\nwriteFileSync(join(here, '..', NAME + '.html'), html);\nconsole.log('built', NAME + '.html', (html.length / 1024).toFixed(0) + ' KB');\nEOF\nnode build.mjs && node --check game.js && echo syntax-ok"}}}
