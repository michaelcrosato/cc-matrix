d ↓', 'D-pad ←', 'D-pad →', 'Home'],\n  generic: ['Bottom', 'Right', 'Left', 'Top', 'L1', 'R1', 'L2', 'R2', 'Select', 'Start', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home']\n};\nconst CODE_LABELS = { Space: 'Space', ShiftLeft: 'Shift', ShiftRight: 'R Shift', ControlLeft: 'Ctrl', ControlRight: 'R Ctrl', AltLeft: 'Alt', AltRight: 'R Alt',","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"staleReadFileStateHint":"[This command modified 1 file you've previously read: src/01-input.js. Call Read before editing.]"},"tool_result_meta":[{"id":"toolu_01PdhL5pkX7jzPTxpwhWc94J","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
