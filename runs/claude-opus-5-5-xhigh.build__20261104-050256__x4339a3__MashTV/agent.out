r 1 neither pauses nor turns to the pad)\n    game.addPlayer({ pad: p.index });\n  }\n});\nHOOKS.enter.push(game => {   // a scene's start: the others take its keys too (a half each where they share the keyboard); a split ends\n  game._split = null; const P = game._players; if (!P || P.length < 2) return;\n  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\n  for (const q of P.slice(1)) q.use(_pPreset(game, q));\n});\nHOOKS.step.push((game, dt) => { if (game._split) for (const v of game._split.vps) _vpCam(game, v, dt); });\n// a split screen's frame: the scene drawn in each viewport (its own camera, lights and overlays, clipped to it), then","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017J3WEzjYcktXTizSojgPhz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
