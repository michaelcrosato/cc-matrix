rn list of [vx, v2] (v2 = vy on the ground plane, vz in side view)\n1021:- `shots.clear(team)`: remove every bullet, or only one team's\n1022:- `shots.draw(r)`: queue them for drawing (glowing cores, or their sprites)\n1023:- `shots.fire(b)`: fire one bullet. Fields: x, y, z, vx, vy, vz, r, dmg, life, team, color, core, sprite, pierce, grav, data\n1024:- `shots.hit(targets, fn, team)`: test bullets of `team` against targets (objects with x, y, z and r, or w/h in side view). fn(bullet, target). Returns hits\n1025:- `shots.update(dt, map)`: move them one step; with a map they stop at walls (a TileMap, or a PlatformMap in side views)\n1026:- `shots.list = []`: the live bullets\n1027:- `shots.max`: at most this many at once\n1028:- `shots.plane`: 'ground' (they fly over x and y) or 'side' (x and z)\n1029:- `shots.sparks`: a puff of sparks where one hits a wall","is_error":false}]},"parent_tool_use_id":null,"session_id":"320246ab-3447-463f-809e-86ed7a6b39d9","uuid":"9a1fa299-c430-43fc-bd7d-4893e9aa8a29","timestamp":"2026-11-04T12:07:08.399Z","tool_use_result":{"stdout":"handoff/API-INDEX.md:179:- `E.rng(s)`: a seeded random stream: const R = E.rng(42); R() gives 0..1, the same numbers for the same seed (mulberry32)\nengine/my-3d2dge.js:123:/** a seeded random stream: const R = E.rng(42); R() gives 0..1, the same numbers for the same seed (mulberry32) */\nengine/my-3d2dge.js:124:function rng(s) { return () => { s |= 0; s = s + 0x6D2B79F5 | 0; let t = Math.imul(s ^ s >>> 15, 1 | s); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }\nengine/my-3d2dge.js:8769:  make: ({ h, seed }) => { const r = rng(seed * 977 + 13), t = h * .62, out = [['cyl','b',[0,0,0],h / 14,t,{r2:h / 25}], ['ball','l',[0,0,t + h * .16],h * .2,{sz:.85}]];\nengine/my-3d2dge.js:8779:  make: ({ h, seed }) => { const q = rng(seed * 31 + 5); return [0, 1, 2].map(i => { const k = i ? .45 + q() * .2 : 1, w = h / 7 * (i ? .75 : 1), a = i * 2.2 + q();\nengine/my-3d2dge.j