:10px;letter-spacing:.14em;text-transform:uppercase;text-align:center}\n.esh-bind button{text-align:center;text-transform:none;letter-spacing:.02em;font-size:12px;padding:8px 10px}.esh-bind button.cap{outline:2px dashed var(--accent);outline-offset:2px}\n@keyframes esh-in{from{opacity:0}}`;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01H2sPJEVzEctBx77BDwbtaw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
