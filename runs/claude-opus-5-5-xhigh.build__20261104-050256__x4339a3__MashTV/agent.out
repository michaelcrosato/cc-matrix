ces.penny > r.voices.lance * 1.6, r.voices);\\n      t.check('the Announcer and The Network are the lowest voices', r.voices.annc < r.voices.lance && r.voices.network < r.voices.annc, r.voices);\\n      t.check('Penny sounds brighter than the Announcer', r.bright.penny > r.bright.annc, r.bright);\\n      t.check('every voice is heard (a real spectrum)', Object.values(r.bright).every(v => v > 100), r.bright);\")\nopen(p,'w').write(s)\nEOF\ngrep -c \"Penny sounds brighter\" tests/balance.test.mjs; AUDIO_REPORT=1 timeout 400 node tools/test.mjs --only audio-browser 2>&1 | tail -3 | grep -o '\"voices.*' | cut -c1-300; timeout 400 node tools/test.mjs --only audio-browser 2>&1 | tail -2","description":"Measure voice pitch from oscillators and brightness; rerun"}}}
