ing = !!intent.fire \\&\\& this.slideT <= .1 || (!!intent.fire \\&\\& this.slideT > 0);/    this.firing = !!intent.fire;/\" src/11-contestant.js; grep -n \"this.firing = !!intent.fire\" src/11-contestant.js","description":"Fix fireworks particle fields and firing expression"}}}
