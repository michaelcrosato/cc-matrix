k, t)); }\\n    if (PLAY.staticT > 0) r.overlay(g => { px.blend(g, Math.min(1, PLAY.staticT) * .8, 'normal', () => px.rect(g, 0, 0, r.bw, r.bh, '#ffffff')); UI.static(g, r, Math.min(1, PLAY.staticT), t); UI.title(g, MT.TEXT.ui.signalLost, r.W / 2, r.H * .4, 3, { colors: ['#140a24', '#5a5468'] }); });\\n    if (!game.headless && game.screen.canvas)\")\n# 3. reactions: the network's static fade, commercial-break music\nsub('src/19-react.js', \"  bossDead(w, d) { MT.music.sting('bossdown');\", \"  bossDead(w, d) { if (d.boss === 'finale') PLAY.staticT = 2.2; MT.music.sting('bossdown');\")\nsub('src/19-react.js', \"  commercial(w) { LINES.seq('commercial'); BANNERS.show(MT.TEXT.ui.commercial, { color: '#ff9a3c', dur: 2.5 }); MT.music.sting('jingle'); },\\n  backFromBreak(w) { LINES.seq('backFromBreak'); },\",\n    \"  commercial(w) { LINES.seq('commercial'); BANNERS.show(MT.TEXT.ui.commercial, { color: '#ff9a3c', dur: 2.5 }); MT.music.play('commercial', { fade: .3 }); },\\n  backFromBreak(w) { LINES.seq('backFromBreak'); MT.music.play('bossShowdown', { fade: .3 }); },\")\nsub('src/19-react.js', \"  pattern(w, d) { BANNERS.show(d.name + '!', { color: '#c08aff', dur: 1.4 }); },\", \"  pattern(w, d) { BANNERS.show(d.name + '!', { color: '#c08aff', dur: 1.4, big: false }); },\")\n# 4. boss intros can be skipped\nsub('src/17-bosses.js', \"  onArmDown() {\", \"  skipIntro() { this.y = 70; this.x = AR.CX; this.introDone = true; this.setPhase('p1', this.p1()); }\\n  onArmDown() {\")\nsub('src/17-bosses.js', \"  *intro() { const w = this.world; this.flat = 0;\", \"  skipIntro() { this.introDone = true; this.setPhase('p1', this.cycle()); }\\n  *intro() { const w = this.world; this.flat = 0;\")\nsub('src/17-bosses.js', \"  *intro() { const w = this.world; for (let t = 0; t < 2; t += w.lastDt) { this.y = lerp(-40, 80, easeOut(t / 2)); yield; }\",\n    \"  skipIntro() { this.y = 80; this.z = 20; this.introDone = true; this.setPhase('lance', this.lancePhase()); }\\n  *intro() { const w = this.world; for (let t = 0; t < 2; t += w.lastDt) { this.y = lerp(-40, 80, easeOut(t / 2)); yield; }\")\n# 5. HUD: banners lower; no room name under the gauge while a boss bar shows\nsub('src/31-hud.js', \"  let y = Math.round(r.H * .36);\", \"  let y = Math.round(r.H * .56);\")\nsub('src/31-hud.js', \"  else if (world.room) UI.text(g, (world.room.lightning ? 'LIGHTNING ROUND' : world.room.id) + '  ' + world.room.name, cx, y + 38, '#fff7e8', { align: 'center' });\",\n    \"  else if (world.room && !(world.boss && !world.boss.dead && world.boss.phase !== 'intro')) UI.text(g, (world.room.lightning ? 'LIGHTNING ROUND' : world.room.id) + '  ' + world.room.name, cx, y + 38, '#fff7e8', { align: 'center' });\")\nsub('src/31-hud.js', \"const w = Math.min(220, r.W - 240), x = Math.round(r.W / 2 - w / 2), y = 50, k = boss.hpPct();\", \"const w = Math.min(220, r.W - 240), x = Math.round(r.W / 2 - w / 2), y = 41, k = boss.hpPct();\")\n# 6. dev panel: full tab names; the FROZEN label beside the title\nsub('src/33-dev.js', \"UI.text(g, 'DEV MODE', x + 6, y + 3, '#ff9a3c'); UI.text(g, DEV.freeze ? 'FROZEN' : 'LIVE', x + w - 6, y + 3, DEV.freeze ? '#2ee6ff' : '#3aff6a', { align: 'right' });\",\n    \"UI.text(g, 'DEV MODE', x + 6, y + 3, '#ff9a3c'); UI.text(g, DEV.freeze ? 'FROZEN' : 'LIVE', x + 12 + UI.width('DEV MODE'), y + 3, DEV.freeze ? '#2ee6ff' : '#3aff6a');\")\nsub('src/33-dev.js', \"UI.text(g, T2.slice(0, Math.max(3, Math.floor(tw2 / 6))),\", \"UI.text(g, T2.slice(0, Math.max(4, Math.floor(tw2 / 4))),\")\n# 7. a shared camera for front scenes that don't use frontStep\nsub('src/32-screens.js', \"MT.IDLE_SCENES = \", \"function frontCam() { if (!game.headless) { if (!BACKDROP.arena) BACKDROP.arena = new Arena('studio'); BACKDROP.arena.fitCamera(); game.focus(AR.CX, AR.CY, 0); } game.lights.enabled = true; game.lights.ambient = .5; }\\nMT.frontCam = frontCam;\\nMT.IDLE_SCENES = \")\nsub('src/32-screens.js', \"    this.t += dt; LINES.step(1 / 120); MT.idleStep(dt);\\n    if (!MT.cfg.skipRigs) this.penny.update\", \"    this.t += dt; LINES.step(1 / 120); frontCam();\\n    if (!MT.cfg.skipRigs) this.penny.update\")\nsub('src/32-screens.js', \"    this.t += dt; LINES.step(1 / 120);\\n    if (!MT.cfg.skipRigs) this.rigs.forEach\", \"    this.t += dt; LINES.step(1 / 120); frontCam();\\n    if (!MT.cfg.skipRigs) this.rigs.forEach\")\nsub('src/32-screens.js', \"  update(dt) { this.t += dt; MT.cab.update(dt); },\", \"  update(dt) { this.t += dt; MT.cab.update(dt); frontCam(); },\")\nsub('src/50-net.js', \"  update(dt) { this.t += dt; for (const p of game.players) p.clear(); },\", \"  update(dt) { this.t += dt; for (const p of game.players) p.clear(); MT.frontCam(); },\")\n# 8. the aim glyph: a mouse with the left button lit\nsub('src/02-glyphs.js', \"  if (code === 'aim') { if (dev === 'gamepad') return stick(g, x, y, 'R', s, measure); return mouse(g, x, y, -1, s, measure); }\", \"  if (code === 'aim') { if (dev === 'gamepad') return stick(g, x, y, 'R', s, measure); return mouse(g, x, y, 0, s, measure); }\")\n# 9. the ending scene: straight to the credits from the dev warp\nsub('src/34-cutscenes.js', \"    this.co = new Co(this.kind === 'b' ? this.endingB() : this.endingA());\", \"    this.co = new Co(data.credits ? this.rollCredits() : this.kind === 'b' ? this.endingB() : this.endingA());\")\nEOF\nnode tools/build.mjs | tail -1; timeout 120 node tools/shot.mjs \"greenroom&players=2&bot=1\" \"dev\" \"recap=1\" --wait 3000 2>&1 | grep -v AudioContext","description":"Apply the polish and gap fixes; screenshot affected screens"}}}
