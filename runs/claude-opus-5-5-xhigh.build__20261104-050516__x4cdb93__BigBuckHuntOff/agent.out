l) px.disc(g, cx, cy, s * .92, (cy > ccy + cry * .25 ? C[0].deep : (r < .5 ? C[0] : C[Math.min(C.length - 1, 1)]).sh));\"\"\")\na=\"\"\"    if (u > .9) for (let i = 0; i < n * 2; i++) { const a = R() * TAU, rr = Math.sqrt(R()) * .9; px.dot(g, ox + lean + Math.cos(a) * rr * crx, ccy + Math.sin(a) * rr * cry, R() < .6 ? C[0].hi : C[C.length - 1].lt); }\"\"\"\nassert a in s; s=s.replace(a,\"\"\"    if (u > .9) for (let i = 0; i < n * (u > 2 ? 6 : 2); i++) { const a = R() * TAU, rr = Math.sqrt(R()) * .92, x = ox + lean + Math.cos(a) * rr * crx, y = ccy + Math.sin(a) * rr * cry, q = R(); px.dot(g, x, y, q < .35 ? C[0].hi : q < .7 ? C[C.length - 1].lt : C[0].sh); if (u > 2.2 && q > .8) px.dot(g, x + 1, y + 1, C[0].deep); }\"\"\")\na=\"if (o.heads && u > .5 && R() < .5) px.rect(g, x + lean - Math.max(1, u * .08), oy - hh - u * .25, Math.max(1, u * .16), Math.max(1, u * .4), TT(o.heads).base); }\"\nassert a in s; s=s.replace(a,\"if (o.heads && u > .5 && R() < .3) px.line(g, x + lean, oy - hh, x + lean * 1.15, oy - hh - u * .22, TT(o.heads).base, Math.max(1, Math.round(u * .08))); }\")\ns=s.replace(\"propDef('tallgrass', { size: [1 * M, 1 * M], variants: 4, wind: 1.6, bias: 4, paint: clumpPaint({ blades: 14, w: .7, h: .9, pal: ['#a89a4a', '#c8b05a', '#8a8a3a'], heads: '#d8c880', seed: 10 }) });\",\"propDef('tallgrass', { size: [1 * M, 1 * M], variants: 4, wind: 1.6, bias: 4, paint: clumpPaint({ blades: 22, w: .6, h: .85, pal: ['#8a8a3e', '#a89a4a', '#6e7a34'], heads: '#c8b878', seed: 10 }) });\")\nopen(p,'w').write(s)\np='engine/modules/vista.js'; s=open(p).read()\na=\"const m = 1 + mt[((py * .5) & 63) * 64 + ((px * .5) & 63)] / 128\"\nassert a in s; s=s.replace(a,\"const m = 1 + mt[((py * 1.6) & 63) * 64 + ((px * 1.6) & 63)] / 128\")\nopen(p,'w').write(s)\nprint('ok')\nEOF\nnode tests/scratch/viewer.mjs && for v in ridgeRock fieldBlind; do TMPDIR=$PWD/.tmp node tests/scratch/shot.mjs \"tests/scratch/viewer.html#hollow/$v\" tests/out/view-$v.png 9000 1440 810; done","descrip