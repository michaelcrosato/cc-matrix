n[i + 1] * ax) * (1 - ay) + (can[i + N] * (1 - ax) + can[i + N + 1] * ax) * ay) * M * k;\n              if (ch > 10) { h += ch; onCan = true; if (!can[ci]) ci = can[i] ? i : can[i + 1] ? i + 1 : can[i + N] ? i + N : i + N + 1; }\n            }\"\"\")\na=\"\"\"                const j = iy * N + ix, ty = typ[(qy - iy < .5 ? iy : iy + 1) * N + (qx - ix < .5 ? ix : ix + 1)], mt = micro[ty] || micro[0];\n                let cc = col[j];\n                const ax = qx - ix, ay = qy - iy;\n                if (ax > .5 && ay > .5) cc = col[j + N + 1]; else if (ax > .5) cc = col[j + 1]; else if (ay > .5) cc = col[j + N];\n                const mv = mt[((py * .5) & 63) * 64 + ((px * .5) & 63)];\n                let r = cc & 255, g = (cc >>> 8) & 255, b = (cc >>> 16) & 255;\n                if (mv > 127) { const m = mv - 128; r = r + m * .9; g = g + m; b = b + m * .5; } else { const m = 1 + mv / 160; r *= m; g *= m; b *= m; }\n                cc = pack(r > 255 ? 255 : r, g > 255 ? 255 : g, b > 255 ? 255 : b);\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"                const j = iy * N + ix, ax = qx - ix, ay = qy - iy, ty = typ[(ay < .5 ? iy : iy + 1) * N + (ax < .5 ? ix : ix + 1)], mt = micro[ty] || micro[0];\n                const c00 = col[j], c10 = col[j + 1], c01 = col[j + N], c11 = col[j + N + 1], w00 = (1 - ax) * (1 - ay), w10 = ax * (1 - ay), w01 = (1 - ax) * ay, w11 = ax * ay;\n                const m = 1 + mt[((py * .5) & 63) * 64 + ((px * .5) & 63)] / 128, dz = (E.bayer(sx, row) - .5) * 6;\n                let r = ((c00 & 255) * w00 + (c10 & 255) * w10 + (c01 & 255) * w01 + (c11 & 255) * w11) * m + dz;\n                let g = (((c00 >>> 8) & 255) * w00 + ((c10 >>> 8) & 255) * w10 + ((c01 >>> 8) & 255) * w01 + ((c11 >>> 8) & 255) * w11) * m + dz;\n                let b = (((c00 >>> 16) & 255) * w00 + ((c10 >>> 16) & 255) * w10 + ((c01 >>> 16) & 255) * w01 + ((c11 >>> 16) & 255) * w11) * m + dz;\n                let cc = pack(r > 255 ? 255 : r < 0 ? 0 : r, g > 255 ? 255 