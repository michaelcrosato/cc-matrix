 D5 G5 - - D5 G5 - - - - - - - -' }, { wave: 'pulse', vol: .05, notes: 'D4 G4 B4 D5 - - B4 D5 - - - - - - - -' }, { wave: 'triangle', vol: .18, notes: 'G2 - - - - - D3 G2 - - - - - - - -' }] },","+  siteclear: { bpm: 160, steps: 4, tracks: [{ wave: 'square', vol: .07, notes: 'C5 E5 G5 C6 - - - - . . . .' }, { wave: 'triangle', vol: .16, notes: 'C3 - G3 C4 - - - - . . . .' }] },","+  doe: { bpm: 70, steps: 4, tracks: [{ wave: 'saw', vol: .07, notes: 'D4 - - C#4 - - C4 - - B3 - - - - - - - -' }, { wave: 'triangle', vol: .12, notes: 'D3 - - C#3 - - C3 - - B2 - - - - - - - -' }] },","+  escaped: { bpm: 120, steps: 4, tracks: [{ wave: 'square', vol: .06, notes: 'E5 - - C5 - - - - . . .' }] },","+  newrecord: { bpm: 170, steps: 4, tracks: [{ wave: 'square', vol: .07, notes: 'C5 E5 G5 C6 E6 G6 - - E6 G6 C7 - - - - -' }, { wave: 'triangle', vol: .16, notes: 'C3 - G3 - C4 - - - G3 - C4 - - - - -' }] }","+};","+const NZ = (f, dur, vol, o = {}) => Object.assign({ wave: 'noise', freq: f, dur, vol }, o);","+const SFX_DEFS = {","+  dry: [NZ(5000, .02, .22, { filter: 'highpass' }), { wave: 'square', freq: 1500, dur: .012, vol: .08 }],","+  pump: [NZ(1900, .035, .28, { q: 3 }), NZ(900, .07, .12, { to: 1500, delay: .04 }), NZ(2300, .035, .3, { q: 3, delay: .1 })],","+  shell: [NZ(2700, .025, .2, { q: 4 }), { wave: 'square', freq: 950, dur: .015, vol: .05, delay: .01 }],","+  scope: [NZ(1300, .12, .07, { to: 600 })], breathIn: [NZ(650, .5, .045, { to: 950, attack: .2 })], breathOut: [NZ(950, .7, .05, { to: 380, attack: .05 })],","+  grunt: [{ wave: 'saw', freq: 92, to: 80, dur: .32, vol: .22, vib: [13, .09] }, { wave: 'saw', freq: 95, to: 78, dur: .28, vol: .2, vib: [13, .09], delay: .42 }],","+  bugle: [{ wave: 'sine', freq: 520, to: 1850, dur: .9, vol: .16, vib: [6, .02] }, NZ(2400, .55, .07, { q: 6, delay: .55 }), { wave: 'sine', freq: 1850, to: 700, dur: .55, vol: .12, delay: 1.1 }, { wave: 'saw', freq: 220, to: 180, dur: .3, vol: .05, delay: 1.5, vib: [20, .1] }],","+  moose: [{ wave: 'saw', freq: 68, to: 112, dur: .8, vol: .22, vib: [5, .06] }, { wave: 'saw', freq: 70, to: 52, dur: .4, vol: .16, delay: .85 }],","+  fur: [{ wave: 'sine', freq: 120, to: 55, dur: .12, vol: .3 }, NZ(420, .08, .2, { filter: 'lowpass' })],","+  wood: [{ wave: 'square', freq: 320, to: 260, dur: .04, vol: .14 }, NZ(900, .06, .2)],","+  ricochet: [NZ(3500, .03, .18, { filter: 'highpass' }), { wave: 'sine', freq: 3200, to: 1100, dur: .42, vol: .09 }],","+  thud: [NZ(320, .13, .26, { filter: 'lowpass' }), { wave: 'sine', freq: 70, to: 45, dur: .1, vol: .2 }],","+  splash: [NZ(1300, .38, .2, { to: 380 }), NZ(3000, .15, .08, { filter: 'highpass', delay: .05 })],","+  ping: [{ wave: 'sine', freq: 2800, to: 2400, dur: .3, vol: .12 }, { wave: 'square', freq: 1400, dur: .03, vol: .06 }],","+  hoof: [NZ(220, .03, .07, { filter: 'lowpass' })],","+  snort: [NZ(520, .22, .14, { to: 380 })], chirp: [{ wave: 'sine', freq: 1200, to: 1650, dur: .15, vol: .07 }],","+  gobble: [{ wave: 'square', freq: 420, dur: .45, vol: .07, arp: [0, 5, 0, 7, 0, 5, 0, 3], step: .04 }],","+  quack: [{ wave: 'saw', freq: 310, to: 220, dur: .14, vol: .1 }, { wave: 'saw', freq: 300, to: 210, dur: .14, vol: .09, delay: .2 }],","+  caw: [{ wave: 'saw', freq: 720, to: 480, dur: .22, vol: .07 }, NZ(900, .2, .05)],","+  chatter: [{ wave: 'square', freq: 1800, dur: .32, vol: .05, arp: [0, 3, 0, 3, 0, 5], step: .03 }],","+  whistle: [{ wave: 'sine', freq: 2200, to: 2350, dur: .42, vol: .09 }],","+  howl: [{ wave: 'sine', freq: 380, to: 720, dur: .8, vol: .08, vib: [5, .02] }, { wave: 'sine', freq: 720, to: 480, dur: .9, vol: .07, delay: .8, vib: [5, .02] }],","+  loon: [{ wave: 'sine', freq: 600, to: 920, dur: .7, vol: .08, vib: [5, .02] }, { wave: 'sine', freq: 920, to: 700, dur: 1, vol: .07, delay: .7, vib: [6, .03] }],","+  slap: [NZ(520, .16, .34, { filter: 'lowpass' }), NZ(1800, .3, .1, { to: 500, delay: .05 })],","+  moo: [{ wave: 'saw', freq: 125, to: 98, dur: .95, vol: .12, vib: [4, .03] }],","+  whi