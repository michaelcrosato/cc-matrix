ngth) { pages.push(cur); cur = { title, items: [] }; used = 0; }\n      }\n    }\n    if (cur.items.length) pages.push(cur);\n  };\n  // Source Information: as many fields a page as fit, so every word stays big\n  pack('SOURCE INFORMATION', SI_LABELS.map(([k, l]) => [l, SI[k] || 'unknown']));\n  for (const [key, title] of [['testingFeedback', 'TESTING FEEDBACK'], ['engineFeedback', 'ENGINE FEEDBACK'], ['promptFeedback', 'PROMPT FEEDBACK']]) {\n    const A = R[key] || []; QUESTIONS[key].forEach((q, i) => pack(title, [[q, A[i] || 'unknown']]));\n  }\n  const credits = [];\"\"\"\nassert old in s; s=s.replace(old,new)\n# credits pushes -> collect then pack each group\ns=s.replace(\"  pages.push({ title: 'CREDITS', items: [['Game',\",\"  credits.push({ title: 'CREDITS', items: [['Game',\")\ns=s.replace(\"  pages.push({ title: 'CREDITS', items: [['Sound',\",\"  credits.push({ title: 'CREDITS', items: [['Sound',\")\ns=s.replace(\"  pages.push({ title: 'CREDITS', items: [['Inspired by',\",\"  credits.push({ title: 'CREDITS', items: [['Inspired by',\")\nold=\"\"\"  return pages;\n}\nconst aboutScene\"\"\"\nnew=\"\"\"  for (const c of credits) pack(c.title, c.items);\n  return pages;\n}\nconst aboutScene\"\"\"\nassert old in s; s=s.replace(old,new)\nold=\"\"\"  enter(o = {}) { G.scene = 'about'; this.pages = aboutPages(); this.i = o.credits ? this.pages.findIndex(p => p.title === 'CREDITS') : 0;\"\"\"\nnew=\"\"\"  enter(o = {}) { G.scene = 'about'; this.pages = aboutPages(G.game.W, G.game.H); this._size = G.game.W + 'x' + G.game.H; this.i = o.credits ? this.pages.findIndex(p => p.title === 'CREDITS') : 0;\"\"\"\nassert old in s; s=s.replace(old,new)\nold=\"\"\"      const W = r.W, Ht = r.H, P = this.pages[this.i]; dim(g, W, Ht, .7);\"\"\"\nnew=\"\"\"      const W = r.W, Ht = r.H; if (this._size !== W + 'x' + Ht) { const t0 = this.pages[this.i] && this.pages[this.i].title; this.pages = aboutPages(W, Ht); this._size = W + 'x' + Ht; this.i = Math.max(0, Math.min(this.pages.findI