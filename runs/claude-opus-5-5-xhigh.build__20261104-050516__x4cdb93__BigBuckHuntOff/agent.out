 < 290 ? 1 : 0); },\n  farForest: () => .7, canopy: { min: 11, max: 16 },\n  palette: { types: { 0: { a: '#6a8a3a', b: '#7a9444', speck: .03, scale: 8 }, 14: { a: '#7a9a44', b: '#86a44c', c: '#a8b85a', speck: .03, scale: 6 }, 1: { a: '#a89a50', b: '#b4a45a' }, 2: { a: '#7a5a2a', b: '#8a6a32' }, 3: { a: '#8a6a44', b: '#7a5e3c' } }, canopy: ['#2a4a2a', '#3a5a30', '#4a6a34'], farTypes: () => GT.grass },\n  scatter: [{ where: c => c.forest * .9, spacing: 6.5, mix: [['oak', .5], ['maple', .3], ['birch', .2]], scale: [.8, 1.2] }, { where: c => c.mask & 64 ? 0 : c.forest < .3 ? .12 : 0, spacing: 4, prop: 'tallgrass' }],\n  vantages: { bench: { at: [512, 620], eye: 1.5, yaw: -90, kind: 'range', name: 'the bench' }, overlook: { at: [512, 760], eye: 20, yaw: -90, kind: 'air' } },\n  props: [['berm', [512, 594]], ['berm', [500, 574]], ['berm', [530, 574]], ['berm', [512, 462]], ['sign', [500, 616]], ['haybale', [490, 612]], ['haybale', [536, 612]], ['shed', [470, 630]]],\n  sites: [], extraFans: [], trophy: null, bonus: null, par: 3000, rivals: null\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2716,"cache_read_input_tokens":731527,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2716},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8fb56c77-99e2-4018-a816-6b0a42973b6b","uuid":"6f4b96b6-a559-4f69-8b0b-3bf44aa8e16c","timestamp":"2026-11-04T13:14:03.281Z","request_id":"req_011Cghwv3hz4poPucC4mQfM4","wire_tool_inputs":{"toolu_018s3JYparxJwT2ehzA1fQ5B":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-050516__x4cdb93/work/BigBuckHuntOff-BigBuckHunterPro-claude-opus-5-5-xhigh-20261104-050516/src/83-range-map.js","content":"// 83-range-map: UNCLE DU