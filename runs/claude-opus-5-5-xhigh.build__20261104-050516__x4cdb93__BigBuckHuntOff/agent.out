0, o.at[1] + 10]];\n  return [S.spawn(o.kind, Object.assign({}, o, { path, orders: [['walk', { to: .49 }], ['stand', { secs: o.secs || 3 }], ['trot', { to: 1 }], ['exit']] }))];\n} });\ndef('pattern', 'charge', { make(S, o) {   // runs straight at the vantage, then veers off\n  const path = o.path || [o.from, [o.from[0] * .3, 18], [o.veer || 40, 12], [(o.veer || 40) * 1.5, 30]];\n  return [S.spawn(o.kind, Object.assign({}, o, { path, orders: [['run', { to: 1 }], ['exit']], charge: true }))];\n} });\ndef('pattern', 'fight', { make(S, o) {   // two bulls lock antlers, then split\n  const A = S.spawn(o.kind || 'bull', Object.assign({}, o, { path: [o.fromA, o.at, o.exitA], points: o.pointsA, orders: [['walk', { to: .48 }], ['fight', { secs: o.secs || 5 }], ['run', { to: 1 }], ['exit']] }));\n  const B = S.spawn(o.kind || 'bull', Object.assign({}, o, { path: [o.fromB, [o.at[0] + 3, o.at[1] + 3], o.exitB], points: o.pointsB, orders: [['walk', { to: .48 }], ['fight', { secs: o.secs || 5 }], ['run', { to: 1 }], ['exit']] }));\n  A.orders[0][1].with = B; A.orders[1][1].with = B; B.orders[1][1].with = A;\n  for (const X of [A, B]) for (const q of X.orders) if (q[0] === 'fight') q[1].with = X === A ? B : A;\n  return [A, B];\n} });\n","structuredPatch":[{"oldStart":1,"oldLines":1,"newStart":1,"newLines":51,"lines":["-// (being written)","+// 31-patterns: the spawn patterns site scripts call: how animals come into a site and go out of it.","+// Points are [bearing, distance] from the site's vantage (degrees from its heading, metres).","+const orderFor = (o, gait) => {","+  const g = gait || o.gait || 'walk', list = [];","+  if (o.stop) list.push([g === 'run' || g === 'bound' ? 'trot' : g, { to: o.stop[0] }], [o.look === false ? 'stand' : 'look', { secs: o.stop[1] }], [g, { to: 1 }]);","+  else list.push([g, { to: 1 }]);","+  list.push(['exit']); return list;","+};","+def('pattern', 'cross', { make(S, o) {","+  if (o.follow) return [S.spawn(o.kind, Object.assign({}, o, { follow: