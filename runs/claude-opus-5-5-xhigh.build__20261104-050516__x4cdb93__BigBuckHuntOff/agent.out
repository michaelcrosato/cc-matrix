ce('browser/hub.mjs', 'hub/harness.mjs'));\n70:const params = new URLSearchParams(location.search);\n72:const auto = params.get('auto') === '1';\n73:const scenario = params.get('scenario') || 'standard';\n76:const playMs = Number(params.get('play')) || 6000;\n80:  if (params.has(key)) $(id).value = params.get(key);\n170:  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n171:  const seed = params.has('seed') ? Number(params.get('seed')) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n412:  window.__hubCheck = report;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Rjksw14jMoXsYRJUGjXd5P","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
