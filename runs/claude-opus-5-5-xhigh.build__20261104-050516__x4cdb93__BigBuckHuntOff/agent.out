[a.x, a.y, cz], rad) === null) continue;","+    const hits = rayZones(ray, ray, a.zones()); if (!hits.length) continue;","+    let tMin = Infinity, best = null; for (const h of hits) { tMin = Math.min(tMin, h.t); if (!best || (ZONES[h.id] || ZONES.body).pri > (ZONES[best.id] || ZONES.body).pri) best = h; }","+    if (tMin < R.t) Object.assign(R, { kind: a.cat, actor: a, zone: best.id, t: tMin, all: hits });","+  }","+  // trunks, stones, logs, buildings","+  H.world.propsAlong(ray, ray, Math.min(R.t, 600 * M), p => { for (const v of p.occ) { const t = rayVolume(ray, ray, v); if (t !== null && t < R.t) { R.kind = 'prop'; R.t = t; R.prop = p; R.actor = null; R.zone = null; } } });","+  for (const v of H.extraOcc || []) { const t = rayVolume(ray, ray, v); if (t !== null && t < R.t) { R.kind = 'prop'; R.t = t; R.prop = v.prop || null; R.actor = null; R.zone = null; } }","+  // the ground, then the water's surface","+  const tg = H.world.hf.rayHit(ray, ray, R.t, false); if (tg !== null && tg < R.t) { R.kind = 'ground'; R.t = tg; R.actor = null; R.zone = null; }","+  const tw = H.world.hf.rayHit(ray, ray, R.t, true); if (tw !== null && tw < R.t - .5) { R.kind = 'water'; R.t = tw; R.actor = null; R.zone = null; }","+  R.point = [ray.x + ray.dx * R.t, ray.y + ray.dy * R.t, ray.z + ray.dz * R.t];","+  R.dist = Math.hypot(R.point[0] - ray.x, R.point[1] - ray.y, R.point[2] - ray.z) / M;","+  return R;","+}","+/** the shots fired this step, resolved together (two players on one animal in one step: the better zone takes it;","+ *  equal zones share the kill) */","+function resolveShots(H, shots) {","+  const res = shots.map(s => Object.assign(resolveRay(H, s.ray), { shot: s }));","+  const byActor = new Map();","+  for (const r of res) if (r.actor) { const l = byActor.get(r.actor) || []; l.push(r); byActor.set(r.actor, l); }","+  for (const [a, l] of byActor) if (l.length > 1) {","+    l.sort((x, y) => (ZONES[y.zone] || ZONES.body).pri - (ZONES[x.zone] || ZONES.body).pri);","+    const top = (ZONES[l[0].zone] || ZONES.body).pri, sharers = l.filter(r => (ZONES[r.zone] || ZONES.body).pri === top);","+    if (sharers.length > 1) for (const r of sharers) r.shared = sharers.length;","+    for (const r of l) if ((ZONES[r.zone] || ZONES.body).pri < top) r.overtaken = true;","+  }","+  for (const r of res) applyShot(H, r);","+  return res;","+}","+function applyShot(H, R) {","+  const s = R.shot, p = s.p, site = H.site, res = site && site.results[p.i];","+  if (res) res.shots++;","+  p.stats.shots++; Records.stat('shots', 1);","+  bus.emit('shot', { p, R, ray: s.ray });","+  // everyone hears it: loud at the shooter, a smaller noise where it lands; a near miss bolts an animal at once","+  for (const a of H.actors) if (a.alive || a.state === 'hidden') {","+    if (a === R.actor) continue;","+    a.hear(s.ray.x, s.ray.y, 1, false);","+    if (R.kind !== 'sky') { const dI = Math.hypot(R.point[0] - a.x, R.point[1] - a.y) / M; if (dI < 4) a.hear(R.point[0], R.point[1], 1, true); else if (dI < 40) a.hear(R.point[0], R.point[1], .6, false); }","+  }","+  if (R.overtaken) { bus.emit('miss', { p, R }); return; }","+  const a = R.actor;","+  if (!a) { bus.emit('impact', { p, R }); bus.emit('miss', { p, R }); H.lastMiss = R; return; }","+  const Z = ZONES[R.zone] || ZONES.body;","+  if (a.cat === 'critter') return critterHit(H, a, R, p, res);","+  // an animal","+  const wasRunning = a.running, wasVisibleAt = a.seenAt;","+  const local = a.rig.toLocal ? a.rig.toLocal(R.point) : [0, 0, 0];","+  a.hits.push({ local, zone: R.zone, pn: p.n, lethal: Z.lethal, t: site ? site.t : 0, w: [R.point[0] - a.x, R.point[1] - a.y, R.point[2] - a.z] });","+  if (R.zone !== 'antler') { if (res) res.hits++; p.stats.hits++; Records.stat('hits', 1); } else if (res) res.pings++;","+  const out = a.hit(R.zone, Z.dmg, p.n, R.point);","+  bus.emit('hit', { p, a, R, out });","+  if (a.protected) {   // a doe, a fawn, a calf: benched (Classic) or a points penalty (Casual)","+    if (out === 'ping') return;","+    if (!a.penalized) { a.penalized = true; protectedPenalty(H, p, a, res); }","+    return;","+  }","+  if (out === 'kill') {","+    const kill = scoreKill(H, p, a, R, { running: wasRunning, quick: wasVisibleAt !== null && H.time - wasVisibleAt <= 1, shared: R.shared });","+    if (res) { res.kills.push(kill); res.add(kill.points); res.longest = Math.max(res.longest, kill.dist); }","+    p.addScore(kill.points);","+    p.stats.bucks++; p.stats.longest = Math.max(p.stats.longest, kill.dist); Records.stat('bucks', 1); Records.stat('longest', kill.dist, true);","+    bus.emit('kill', { p, a, R, kill });","+  } else if (out === 'wound') bus.emit('wound', { p, a, R });","+  else if (out === 'ping') bus.emit('ping', { p, a, R });","+}","+function protectedPenalty(H, p, a, res) {","+  const casual = G.game.settings.doeRule === 'casual' || H.casualDoe;","+  p.stats.does++; Records.stat('does', 1);","+  if (H.godMode) { bus.emit('doe', { p, a, benched: false, points: 0 }); return; }","+  if (casual || H.hubMode && false) { if (res) { res.penalties.push({ label: a.label + ' SHOT', points: -300 }); res.add(-300); } p.addScore(-300); bus.emit('doe', { p, a, benched: false, points: -300 }); }","+  else { p.benched = true; p.benchedAt = H.time; if (res) { res.benched = true; res.penalties.push({ label: a.label + ' SHOT: BENCHED', points: 0 }); } bus.emit('doe', { p, a, benched: true, points: 0 }); }","+}","+function critterHit(H, a, R, p, res) {","+  const C = a.def;","+  if (res) res.hits++; p.stats.hits++;","+  if (C.protected) {","+    if (a.penalized) return; a.penalized = true;","+    const pts = H.godMode ? 0 : C.points; if (res) { res.penalties.push({ label: C.label.toUpperCase(), points: pts }); res.add(pts); } p.addScore(pts);","+    if (C.effect === 'stink' && !H.godMode) { H.stink = Math.max(H.stink || 0, 3); }","+    a.startle(0, true); if (a.def.behavior === 'graze') { a.beh = 'hop'; a.state = 'flee'; a.path = new APath([{ x: a.x, y: a.y }, { x: a.x + 40 * M, y: a.y - 20 * M }]); a.d = 0; }","+    else if (a.bird) { a.state = 'flee'; a.flushed = true; a.beh = a.beh === 'swim' ? 'flush' : a.beh; if (!a.path) a.path = new APath([{ x: a.x, y: a.y }, { x: a.x + 60 * M, y: a.y - 80 * M }]); }","+    else { a.die(p.n); }","+    bus.emit('critter', { p, a, points: pts, protected: true });","+    return;","+  }","+  a.die(p.n); a.vz = 0;","+  const pts = Math.round(C.points * (R.dist > 60 ? 1.5 : 1));","+  if (res) { res.critters.push({ id: a.kind, label: C.label, points: pts }); res.add(pts); } p.addScore(pts); Records.stat('critters', 1);","+  bus.emit('critter', { p, a, points: pts, protected: false });","+}"]}],"originalFile":"// (being written)\n","userModified":false},"tool_result_meta":[{"id":"toolu_01MjmUjZJAZdFLyJagaJ15EM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
