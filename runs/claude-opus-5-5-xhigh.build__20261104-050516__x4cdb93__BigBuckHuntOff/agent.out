 15, spread: 1.1, vol: .2, echo: .16, formant: 1.05 });\nbab.define('dub', { pitch: 105, wave: 'sawtooth', speed: 10.5, spread: .8, grit: .35, vol: .2, formant: .9 });\nbab.define('granny', { pitch: 260, wave: 'sine', speed: 12, spread: 1.3, warble: .035, vol: .24, formant: 1.2 });\nbab.define('dwayne', { pitch: 185, wave: 'square', speed: 14, spread: 1.2, vol: .16, formant: 1.35 });\nbab.define('loretta', { pitch: 225, wave: 'triangle', speed: 13.5, spread: 1.2, vol: .26, formant: 1.15 });\nbab.define('earl', { pitch: 95, wave: 'square', speed: 9.5, spread: .7, vol: .18, formant: .85 });\nG.bab = bab;\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3948,"cache_read_input_tokens":444028,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3948},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8fb56c77-99e2-4018-a816-6b0a42973b6b","uuid":"10b1792e-e09d-48fd-a6f2-ad62f6acf36d","timestamp":"2026-11-04T12:33:57.633Z","request_id":"req_011Cghtqch7y3KbJbHWg9xrm","wire_tool_inputs":{"toolu_01BwLknUpM5K9uhHuZmQG7Zz":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-050516__x4cdb93/work/BigBuckHuntOff-BigBuckHunterPro-claude-opus-5-5-xhigh-20261104-050516/src/01-game.js","content":"// 01-game: the engine's game with our input map, settings, pause items and HTML shell; the cast's gibberish voices.\nconst HUB_ON = typeof AIHub !== 'undefined' && !!AIHub.active;\nconst HUNT_KEYS = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  fire: ['Mouse0', 'Pad7', 'KeyJ'],                 // left click, R2\n  pump: ['KeyR', 'Space', 'Pad2', 'KeyK'],          //