yers=2&scenario=server`.\n350:game is served from the harness's own origin.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Uhr1gAApsCxESgu5fSAawP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
