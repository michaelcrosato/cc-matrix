h: .85, pal: ['#8a8a3e', '#a89a4a', '#6e7a34'], heads: '#c8b878', seed: 10 }) });\")\nopen(p,'w').write(s)\np='engine/modules/vista.js'; s=open(p).read()\na=\"const m = 1 + mt[((py * .5) & 63) * 64 + ((px * .5) & 63)] / 128\"\nassert a in s; s=s.replace(a,\"const m = 1 + mt[((py * 1.6) & 63) * 64 + ((px * 1.6) & 63)] / 128\")\nopen(p,'w').write(s)\nprint('ok')\nEOF\nnode tests/scratch/viewer.mjs && for v in ridgeRock fieldBlind; do TMPDIR=$PWD/.tmp node tests/scratch/shot.mjs \"tests/scratch/viewer.html#hollow/$v\" tests/out/view-$v.png 9000 1440 810; done","description":"Apply scatter exclusions, finer textures, denser leaf clumps","timeout":240000}}}
