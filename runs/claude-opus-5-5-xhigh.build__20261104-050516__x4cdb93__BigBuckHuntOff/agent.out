 1.6], voice: 'moo' });","+def('critter', 'crow', { label: 'Crow', rig: BIRD('crow'), points: 100, behavior: 'flock', speed: 9, bark: 'critter', size: [.35, .35], bird: true, voice: 'caw' });","+def('critter', 'raven', { label: 'Raven', rig: BIRD('raven'), points: 100, behavior: 'flock', speed: 8, bark: 'critter', size: [.45, .45], bird: true, voice: 'caw' });","+def('critter', 'grouse', { label: 'Ruffed grouse', rig: BIRD('grouse'), points: 150, behavior: 'flush', speed: 11, bark: 'critter', size: [.45, .45], bird: true, voice: 'whirr' });","+def('critter', 'marmot', { label: 'Marmot', rig: Q('marmot'), points: 75, behavior: 'popup', speed: 2, bark: 'critter', size: [.7, .6], voice: 'whistle' });","+def('critter', 'coyote', { label: 'Coyote', rig: Q('coyote'), points: 250, behavior: 'trot', speed: 4, bark: 'critter', size: [1.1, 1], voice: 'howl' });","+def('critter', 'wolf', { label: 'Gray wolf', rig: Q('wolf'), points: 300, behavior: 'pack', speed: 9, bark: 'critter', size: [1.3, 1.2], voice: 'howl' });","+def('critter', 'eagle', { label: 'Bald eagle', rig: BIRD('eagle'), points: -400, protected: true, behavior: 'soar', speed: 10, bark: 'eagle', size: [1, .8], bird: true });","+def('critter', 'duck', { label: 'Mallard', rig: BIRD('duck'), points: 150, behavior: 'flush', speed: 12, bark: 'critter', size: [.45, .45], bird: true, water: true, voice: 'quack' });","+def('critter', 'loon', { label: 'Common loon', rig: BIRD('loon'), points: -400, protected: true, behavior: 'swim', speed: .8, bark: 'loon', size: [.7, .6], bird: true, water: true, voice: 'loon' });","+def('critter', 'beaver', { label: 'Beaver', rig: Q('beaver'), points: 100, behavior: 'swim', speed: 1, bark: 'critter', size: [.9, .5], water: true, voice: 'slap' });"]}],"originalFile":"// (being written)\n","userModified":false},"tool_result_meta":[{"id":"toolu_01MU8QfGakAv4M1G9zycFkGq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
