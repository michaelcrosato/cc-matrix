ax(0, this.fear - dt * .12);","+    if (this.cat === 'critter') { this.critterThink(dt); this.rigUpdate(dt, this.vx, this.vy); return; }","+    // alert -> flee","+    if (this.state === 'alert') { this.want = 0; this.alertT -= dt; if (this.alertT <= 0) this.flee(); }","+    // following a leader: the leader's path, a little behind and to the side","+    if (this.follow && this.state !== 'flee' && this.state !== 'wounded' && this.state !== 'alert') {","+      const L = this.follow; if (!L.live) this.follow = null;","+      else { if (!this.path) this.path = L.path; if (L.state === 'flee' || L.state === 'alert' || L.state === 'dying' || L.state === 'wounded') { this.react -= dt; if (this.react <= 0) this.startle(0, false); }","+        this.want = clamp((L.d - this.back * M - this.d) * 2 + L.speed, 0, this.gaitSpeed('run')); this.order = ['follow']; }","+    }","+    if (this.frozenT > 0) { this.frozenT -= dt; this.want = 0; if (this.stepIn > 0) { this.stepIn -= dt; this.want = this.gaitSpeed('walk') * .5; } }","+    else if (this.order) this.runOrder(dt);","+    // move along the path","+    const acc = (this.want > this.speed ? (this.want > this.speeds[1] ? 14 : 4) : 10) * M;","+    this.speed = E.approach(this.speed, this.want, acc * dt);","+    if (this.path && this.speed > 0) {","+      this.d += this.speed * dt;","+      const p = this.path.at(this.d), nx = p.x + Math.cos(p.angle + Math.PI / 2) * this.side * M, ny = p.y + Math.sin(p.angle + Math.PI / 2) * this.side * M;","+      this.vx = (nx - this.x) / dt; this.vy = (ny - this.y) / dt; this.x = nx; this.y = ny; this.heading = p.angle;","+      for (const j of this.jumps) if (!j.done && this.d >= j.d * this.path.len) { j.done = true; this.jumpT = this.jumpLen; bus.emit('jump', this); }","+      if (this.d >= this.path.len - .5 && this.order && (this.order[0] === 'exit' || this.order[0] === 'run' || this.order[0] === 'walk' || this.order[0] === 'trot')) { if (this.order[0] === 'exit' || this.orders.some(o => o[0] === 'exit') || this.state === 'flee' || this.state === 'wounded') this.goneOut(); else this.nextOrder(); }","+    } else { this.vx = this.vy = 0; }","+    // the ground (and the jump's arc over a log, a fence or the creek)","+    let gz = w.height(this.x, this.y); this.z = gz;","+    if (this.jumpT > 0) { this.jumpT -= dt; this.z = gz + Math.sin((1 - this.jumpT / this.jumpLen) * Math.PI) * 1.1 * M * (this.rig.sz || 1); }","+    const wl = w.hf.waterAt(this.x, this.y); this.inWater = wl !== null && wl > gz + 2;","+    if (this.inWater && this.speed > 20 && (this.splashT = (this.splashT || 0) - dt) <= 0) { this.splashT = this.running ? .12 : .35; bus.emit('splash', this); }","+    // in the fan, then out of it: gone","+    const [b] = w.bearingOf(H.vantageId, this.x, this.y), F = H.fanB;","+    if (b > F[0] - 2 && b < F[1] + 2) this.entered = true;","+    else if (this.entered && (b < F[0] - 12 || b > F[1] + 12)) this.goneOut();","+    this.rigUpdate(dt, this.vx, this.vy);","+  }","+  runOrder(dt) {","+    const o = this.order, a = o[1] || {}; this.oT += dt;","+    this.graze = 0; this.alertW = 0; this.callW = 0;","+    switch (o[0]) {","+      case 'walk': case 'trot': case 'run': case 'bound': {","+        this.want = this.gaitSpeed(o[0]) * (this.state === 'flee' ? (this.fleeBoost || 1) : 1) * (this.state === 'wounded' ? .6 : 1);","+        const to = (a.to === undefined ? 1 : a.to) * (this.path ? this.path.len : 0); if (this.path && this.d >= to - .5 && a.to !== undefined && a.to < 1) this.nextOrder(); break;","+      }","+      case 'graze': this.want = 0; this.graze = (this.oT % 3.4 < 2.6) ? 1 : 0; this.alertW = this.graze ? 0 : .6; if (this.oT > (a.secs || a)) this.nextOrder(); break;","+      case 'look': case 'stand': this.want = 0; this.alertW = o[0] === 'look' ? 1 : .3; this.lookAt = o[0] === 'look' ? { x: this.H.cam.x, y: this.H.cam.y, z: 0 } : null; if (this.oT > (a.secs || a)) this.nextOrder(); break;","+      case 'call': this.want = 0; this.callW = 1; if (this.oT < .05 && G.sfx) G.sfx.call(this.sp.call === 'bugle' ? 'bugle' : 'moose', this, 1); if (this.oT > (a.secs || a || 2)) this.nextOrder(); break;","+      case 'wait': this.want = 0; if (this.oT > (a.secs || a)) this.nextOrder(); break;","+      case 'face': this.want = 0; this.heading = E.approachAng(this.heading, a.yaw, dt * 3); if (this.oT > (a.secs || 1)) this.nextOrder(); break;","+      case 'fight': { const B = a.with; this.want = 0; this.alertW = .4; if (B && B.live) { this.lookAt = { x: B.x, y: B.y, z: B.z }; const dd = Math.hypot(B.x - this.x, B.y - this.y); this.shove = Math.sin(this.oT * 6) * .5; if (dd > 4.2 * M * this.rig.sz) this.want = this.gaitSpeed('walk') * .6; } if (this.oT > (a.secs || 4)) this.nextOrder(); break; }","+      case 'exit': this.want = this.gaitSpeed(this.state === 'flee' ? 'run' : 'trot'); break;","+      case 'hold': this.want = 0; break;","+      case 'follow': break;","+      default: this.nextOrder();","+    }","+  }","+  goneOut() {","+    if (this.state === 'gone') return;","+    const was = this.state; this.state = 'gone'; this.resolved = true;","+    if (this.cat === 'animal' && this.target) { if (was === 'wounded' || this.wounds > 0) { this.lost = true; bus.emit('lost', this); } else { this.escaped = true; bus.emit('escape', this); } }","+    else bus.emit('leave', this);","+  }","+  rigUpdate(dt, vx, vy) {","+    const R = this.rig, w = this.H.world;","+    if (this.cat === 'critter' && this.bird) { R.update(dt, { x: this.x, y: this.y, z: this.z, vx, vy, vz: this.vz, flap: this.flap === undefined ? 1 : this.flap, swim: this.swim, walk: this.walkW || 0, strut: this.strut, dead: this.state === 'dying' || this.state === 'dead', facing: this.heading }); return; }","+    // antlers read at range: an arcade boost that grows with distance from the hunt's camera","+    if (this.target && R.antlers) { const D = Math.hypot(this.x - this.H.cam.x, this.y - this.H.cam.y) / M; R.antlerScale = T('antlerBoost') * Math.min(1.6, 1 + Math.max(0, (D - 80) / 150)) * (this.o.antlerMul || 1); }","+    const dead = this.state === 'dying' ? clamp(this.deadT / 1.05, 0, 1) : this.state === 'dead' ? 1 : 0;","+    const ground = this.inWater ? ((x, y) => w.height(x, y)) : w.ground;","+    R.update(dt, { x: this.x, y: this.y, z: this.z, vx, vy, facing: this.faceTo !== undefined ? this.faceTo : this.heading, faceLock: this.faceTo !== undefined, ground, alert: this.state === 'alert' || this.frozenT > 0 ? 1 : (this.alertW || 0), graze: this.graze || 0, look: this.lookAt || (this.frozenT > 0 ? { x: this.H.cam.x, y: this.H.cam.y } : null),","+      hurt: this.hurtT > 0 ? 1 : 0, limp: this.state === 'wounded' ? this.limp : -1, jump: this.jumpT > 0 ? 1 : 0, dead, deadSide: this.deadSide, call: this.callW || 0, swim: this.swimW || 0, crouch: this.crouchW || 0, rear: this.rearW || 0 });","+  }","+  /* ---------- critters ---------- */","+  critterThink(dt) {","+    const C = this.def, H = this.H, w = H.world, b = this.beh, a = this.o;","+    this.flap = 1; this.swim = false; this.walkW = 0; this.strut = false;","+    if (this.state === 'alert') { this.alertT -= dt; if (this.alertT <= 0) this.state = 'flee'; }","+    const moveAlong = (sp) => { if (!this.path) return; this.d += sp * dt; const p = this.path.at(this.d); this.vx = (p.x - this.x) / dt; this.vy = (p.y - this.y) / dt; this.x = p.x; this.y = p.y; this.heading = p.angle; if (this.d >= this.path.len - .5) this.goneOut(); };","+    if (b === 'hop' || b === 'waddle' || b === 'scurry' || b === 'trot') {","+      const fleeing = this.state === 'flee'; let sp = fleeing ? this.speeds[2] : b === 'hop' ? (Math.sin(this.t * 7) > -.2 ? this.speeds[1] : 0) : this.speeds[0];","+      if (b === 'hop' && !fleeing && (this.t % 5) > 3.6) sp = 0;   // freezes now and then","+      if (b === 'scurry' && !fleeing && (this.t % 3) > 2) { sp = 0; this.rearW = 1; } else this.rearW = 0;","+      moveAlong(sp); this.z = w.height(this.x, this.y); if (b === 'hop' && sp > 0) this.z += Math.abs(Math.sin(this.t * 7 * Math.PI / 2)) * .35 * M;","+      if (b === 'trot' && this.t % 7 < .02 && G.sfx) G.sfx.critter('howl', this);","+    } else if (b === 'strut') {   // a turkey: walks the field, gobbles, runs off at a shot","+      const fleeing = this.state === 'flee'; this.walkW = 1; this.strut = !fleeing && (this.t % 6) < 2.5;","+      moveAlong(fleeing ? this.speeds[2] * 1.6 : this.strut ? 0 : this.speeds[0]); this.z = w.height(this.x, this.y);","+      if (this.strut && (this.t % 6) < .02 && G.sfx) G.sfx.critter('gobble', this);","+    } else if (b === 'peek') {   // a raccoon in a hollow log: up, look round, duck, up again","+      const ph = this.t % 4.5; this.z = w.height(this.x, this.y) + (ph < 2.6 ? 0 : -1.2 * M); this.peekUp = ph < 2.6; this.heading = Math.atan2(H.cam.y - this.y, H.cam.x - this.x);","+      if (this.state === 'flee' || this.t > (a.life || 14)) this.goneOut();","+    } else if (b === 'graze') { this.vx = this.vy = 0; this.graze = (this.t % 6) < 4.5 ? 1 : 0; this.z = w.height(this.x, this.y); if (this.t % 9 < .02 && G.sfx) G.sfx.critter('moo', this); if (this.path) moveAlong(this.speeds[0] * (this.graze ? 0 : 1)); }","+    else if (b === 'popup') { const ph = this.t % 5; this.rearW = ph < 3 ? 1 : 0; this.z = w.height(this.x, this.y) + (ph < 3.2 ? 0 : -1.4 * M); if (ph < .02 && G.sfx) G.sfx.critter('whistle', this); if (this.state === 'flee' || this.t > (a.life || 18)) this.goneOut(); }","+    else if (b === 'pack') { moveAlong(this.speeds[2] * (a.speedMul || 1)); this.z = w.height(this.x, this.y); }","+    else if (b === 'flock' || b === 'flush' || b === 'soar') {   // fliers: a path in the air (z above the ground)","+      if (b === 'flush' && !this.flushed) { this.z = w.height(this.x, this.y) + (C.water ? 0 : .2 * M); this.swim = !!C.water; this.flap = 0; if (this.t > (a.wait || 3) || this.state === 'flee') { this.flushed = true; if (G.sfx) G.sfx.critter(C.water ? 'quack' : 'whirr', this); } return; }","+      const sp = this.speeds[2] * (b === 'soar' ? .6 : 1); this.d += sp * dt; const p = this.path.at(this.d), alt = (a.alt || (b === 'soar' ? 60 : 12)) * M * (b === 'flush' ? Math.min(1, this.d / (30 * M)) : 1);","+      const nz = w.height(p.x, p.y) + alt + (b === 'flock' ? Math.sin(this.t * 2 + this.n) * 1.5 * M : 0);","+      this.vx = (p.x - this.x) / dt; this.vy = (p.y - this.y) / dt; this.vz = (nz - this.z) / dt; this.x = p.x; this.y = p.y; this.z = nz; this.heading = p.angle;","+      this.flap = b === 'soar' ? (Math.sin(this.t * .7) > .7 ? .6 : .05) : 1;","+      if (b === 'flock' && this.t % 4 < .02 && G.sfx && this.n % 3 === 0) G.sfx.critter('caw', this);","+      if (this.d >= this.path.len - .5) this.goneOut();","+    } else if (b === 'swim') {   // on the water: a loon floats and wails, a beaver swims with a wake and slaps","+      const wl = w.hf.waterAt(this.x, this.y); this.swim = true; this.flap = 0;","+      if (this.path) moveAlong(this.speeds[0] * (this.state === 'flee' ? 3 : 1)); this.z = (wl !== null ? wl : w.height(this.x, this.y)) - (this.bird ? 0 : .25 * M);","+      if (this.t % 8 < .02 && G.sfx) G.sfx.critter(C.voice || 'loon', this);","+      this.swimW = this.bird ? 0 : 1;","+      if (this.state === 'flee' && !this.bird && this.t - (this.fleeAt || 0) > .3) { this.goneOut(); if (G.sfx) G.sfx.critter('slap', this); }","+    }","+  }","+  /** for the hunt's renderer: a billboard item */","+  item(scale) {","+    if (this.state === 'hidden' || this.state === 'gone') return null;","+    const R = this.rig, s = (this.cat === 'animal' ? T('animalScale') : 1.15) * (scale || 1), H = this.H, glint = G.game.settings.glint;","+    if (this.cat === 'critter' && this.beh === 'peek' && !this.peekUp) return null;","+    const it = this._it || (this._it = { draw: null, outline: H.hunt ? H.hunt.outline : '#1a1010', bias: 10 });","+    it.x = this.x; it.y = this.y; it.z = this.z; it.scale = s; it.box = [Math.max(R.length || 10, R.height || 10) * .7, (R.height || 10) + 6]