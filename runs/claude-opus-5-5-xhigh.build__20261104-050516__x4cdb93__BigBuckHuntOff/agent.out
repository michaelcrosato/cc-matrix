acing: 16, mix: [['log', .5], ['rock', .3], ['stump', .2]], fanMargin: 2 },","+    { where: c => c.type === GT.rock ? .3 : 0, spacing: 7, prop: 'rock' }","+  ],","+  vantages: {","+    creekStand: { at: [542, 455], eye: 4.6, yaw: -100, kind: 'treestand', name: 'the creek stand' },","+    fieldBlind: { at: [676, 668], eye: 1.35, yaw: -95, kind: 'blind', name: 'the cornfield blind' },","+    ridgeRock: { at: [252, 470], eye: 2.3, yaw: 10, kind: 'rock', name: 'the ridge outcrop' },","+    gladeEdge: { at: [306, 300], eye: 1.7, yaw: -92, kind: 'ground', name: 'the edge of Fog Glade' },","+    porch: { at: [820, 728], eye: 2.2, yaw: -90, kind: 'porch', name: \"Granny Mae's porch\" },","+    overlook: { at: [560, 1000], eye: 70, yaw: -95, kind: 'air' }","+  },","+  props: [","+    ['farmhouse', [820, 744], { facing: 0 }], ['barn', [886, 772], { facing: 0 }], ['shed', [770, 776], { facing: 0 }], ['haybale', [860, 748]], ['haybale', [866, 752]], ['haybale', [902, 742]],","+    ['stand', [544, 458]], ['sign', [690, 700]], ['boulder', [254, 474]], ['boulder', [247, 466]],","+    ...Array.from({ length: 15 }, (_, i) => ['fence', [699, 686 - i * 8.6], { facing: Math.PI / 2 }]),","+    ...Array.from({ length: 11 }, (_, i) => ['fence', [604 + i * 8.6, 692], { facing: 0 }])","+  ],","+  sites: ['hollow-1', 'hollow-2', 'hollow-3'], trophy: 'iron-rack', bonus: 'crow-patrol', par: 6200,","+  rivals: { earl: 3400, loretta: 5300, dwayne: 6300 },","+  intro: 'hollow-intro', outro: 'hollow-outro', legendBeat: 'iron-rack-legend', bonusBeat: 'crow-patrol-brief',","+  establish: { from: [560, 1000, 70, -95], to: [560, 760, 45, -100], secs: 7 }","+});","+function hollowForest(c) {","+  const base = .5 + .5 * hollowN(c.x / 140, c.y / 140), d = c.mask & 233 ? 0 : 1, glade = Math.hypot(c.x - 305, c.y - 205) < 70 ? 0 : 1;","+  const ridge = Math.abs(c.x - 245) < 120 ? .35 : 0, creek = c.wdist < 10 ? 0 : 1;","+  return clamp((base - .35) * 2.2 + ridge, 0, 1) * d * glade * creek;","+}","+function 