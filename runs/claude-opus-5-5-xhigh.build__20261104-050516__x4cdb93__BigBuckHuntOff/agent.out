, ['bugle', 24, .12], ['bird', 7]],","+  muskeg: [['wind', 3.2], ['loon', 14, .3], ['ice', 9], ['caw', 16, .25]],","+  range: [['wind', 4], ['bird', 3]], lodge: []","+};","+const SFX = G.sfx = {","+  amb: null, ambT: {}, layers: {},","+  play(name, o = {}) { const v = SFX_DEFS[name]; if (v) G.game.audio.sfx(v, Object.assign({ vary: .04 }, o)); else G.game.audio.sfx(name, o); },","+  /** the rifle: a crack, a thump, a tail, and the echo off the far side of the valley */","+  shot(H) { const e = (H && H.hunt && H.hunt.echo) || [.35, .8], A = G.game.audio;","+    A.sfx([NZ(2600, .05, .55, { filter: 'highpass' }), { wave: 'sine', freq: 62, to: 38, dur: .16, vol: .55 }, NZ(900, .6, .26, { filter: 'lowpass', to: 220 }), NZ(700, .32, .12, { filter: 'lowpass', delay: e[0], to: 260 }), NZ(480, .4, .06, { filter: 'lowpass', delay: e[1], to: 200 })], { vary: .05 }); },","+  call(kind, actor, vol = 1) { const v = SFX_DEFS[kind === 'grunt' ? 'grunt' : kind === 'bugle' ? 'bugle' : 'moose']; if (actor) this.panned(v, actor, vol); else G.game.audio.sfx(v, { vol, vary: .02 }); },","+  critter(voice, a) { const v = SFX_DEFS[voice]; if (v) this.panned(v, a, .8); },","+  /** a sound placed left or right by where it is from the camera (a trophy's bugle from the timber) */","+  panned(voices, a, vol = 1) {","+    const A = G.game.audio, ctx = A.ctx, bus = A.bus && A.bus('sfx'); if (!ctx || !bus || A.muted || ctx.state !== 'running' || !G.hunt) { if (voices) A.sfx(voices, { vol }); return; }","+    const L = G.hunt.lens, dx = a.x - L.x, dy = a.y - L.y, d = Math.hypot(dx, dy) || 1, pan = clamp((dx * L.Rx + dy * L.Ry) / d, -1, 1), dist = clamp(1 - d / (420 * M), .15, 1);","+    const p = ctx.createStereoPanner ? ctx.createStereoPanner() : null, t0 = ctx.currentTime + .01;","+    if (p) { p.pan.value = pan * .9; p.connect(bus); }","+    for (const v of voices) {","+      const g = ctx.createGain(), dur = v.dur || .2, t = t0 + (v.delay || 0), f0 = E.note(v.freq || 440);","+      g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime((v.vol || .2) * vol * dist, t + (v.attack || .01)); g.gain.exponentialRampToValueAtTime(.0005, t + dur);","+      let src;","+      if (v.wave === 'noise') { src = ctx.createBufferSource(); src.buffer = A._noise; src.loop = true; const f = ctx.createBiquadFilter(); f.type = v.filter || 'bandpass'; f.frequency.value = f0; f.Q.value = v.q || 1.1; src.connect(f); f.connect(g); }","+      else { src = ctx.createOscillator(); src.type = v.wave === 'saw' ? 'sawtooth' : ['square', 'triangle', 'sine'].includes(v.wave) ? v.wave : 'square'; src.frequency.setValueAtTime(f0, t); if (v.to) src.frequency.exponentialRampToValueAtTime(E.note(v.to), t + dur); if (v.vib) { const l = ctx.createOscillator(), lg = ctx.createGain(); l.frequency.value = v.vib[0]; lg.gain.value = f0 * v.vib[1]; l.connect(lg); lg.connect(src.frequency); l.start(t); l.stop(t + dur + .05); } src.connect(g); }","+      g.connect(p || bus); src.start(t); src.stop(t + dur + .05);","+    }","+  },","+  music(name, o = {}) { const s = SONGS[name]; if (!s) return; if (G.game.audio.song === s && !o.restart) return; G.game.audio.music(s, { fade: o.fade === undefined ? .6 : o.fade, sync: false }); this.layers = {}; },","+  stopMusic(f = .5) { G.game.audio.stopMusic(f); },","+  layer(name, on) { if (this.layers[name] === on) return; this.layers[name] = on; if (G.game.audio.song === SONGS.stalk) G.game.audio.layer(name, on ? 1 : 0, on ? .6 : 1.2); },","+  sting(name) { const s = SONGS[name]; if (s) G.game.audio.sting(Object.assign({}, s, { loop: false }), { at: 'now', duck: .35 }); },","+  ambience(id) { this.amb = id; this.ambT = {}; },","+  update(dt) {","+    const bed = this.amb && AMB[this.amb]; if (!bed || G.game.paused) return;","+    for (const [name, every, vol] of bed) { const k = name; this.ambT[k] = (this.ambT[k] === undefined ? fxr(every) : this.ambT[k]) - dt; if (this.ambT[k] <= 0) { this.ambT[k] = every * fxr(.6, 1.5); G.game.audio.sfx(SFX_DEFS[name], { vol: vol || .9, pitch: fxr(.85, 1.2), vary: .1 }); } }","+  }","+};","+// what the game does, heard","+bus.on('pump', () => SFX.play('pump')); bus.on('reload', () => {}); bus.on('shell', () => SFX.play('shell'));","+bus.on('scope', () => SFX.play('scope')); bus.on('breathIn', () => SFX.play('breathIn')); bus.on('breathOut', () => SFX.play('breathOut'));","+bus.on('impact', e => { const R = e.R; SFX.play(R.kind === 'water' ? 'splash' : R.kind === 'prop' ? (R.prop && R.prop.occ && R.prop.occ[0].k === 'sph' ? 'ricochet' : 'wood') : R.kind === 'ground' ? 'thud' : 'tick', { vol: clamp(1.2 - R.dist / 200, .3, 1) }); });","+bus.on('hit', e => SFX.play(e.R.zone === 'antler' ? 'ping' : 'fur'));","+bus.on('critter', e => { if (e.a.def.effect === 'stink') SFX.play('stink'); else if (e.a.def.voice) SFX.critter(e.a.def.voice, e.a); });","+bus.on('jump', a => SFX.panned && a.cat === 'animal' && SFX.panned(SFX_DEFS.snort, a, .5));"]}],"originalFile":"// (being written)\n","userModified":false},"tool_result_meta":[{"id":"toolu_01J2VMU7y7GNo5piqM5MCW2e","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
