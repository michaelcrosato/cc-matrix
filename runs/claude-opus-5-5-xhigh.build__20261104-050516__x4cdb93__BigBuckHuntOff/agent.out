(q = d[i - n - 1] + b) < v) v = q; if (x < n - 1 && (q = d[i - n + 1] + b) < v) v = q; }\n      d[i] = v;\n    }\n    for (let y = n - 1; y >= 0; y--) for (let x = n - 1; x >= 0; x--) {\n      const i = y * n + x; let v = d[i], q;\n      if (x < n - 1 && (q = d[i + 1] + a) < v) v = q;\n      if (y < n - 1) { if ((q = d[i + n] + a) < v) v = q; if (x < n - 1 && (q = d[i + n + 1] + b) < v) v = q; if (x > 0 && (q = d[i + n - 1] + b) < v) v = q; }\n      d[i] = v;\n    }\n    const out = new Float32Array(N * N);\n    for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) out[y * N + x] = d[Math.min(n - 1, y >> 1) * n + Math.min(n - 1, x >> 1)];\n    return out;\n  }\n\"\"\"+s[j:]\nopen(p,'w').write(s); print('ok')\nEOF\nnode -e \"\nconst vm=require('vm'),fs=require('fs');const ctx={console};vm.createContext(ctx);\nvm.runInContext(fs.readFileSync('../my-3d2dge.js','utf8'),ctx);vm.runInContext(fs.readFileSync('vista.js','utf8'),ctx);\nconst E=ctx.My3D2dge;let t0=Date.now();const hf=new E.Heightfield({N:1024});hf.generate({seed:5,base:{amp:18,scale:260},features:[{kind:'river',path:[[100,100],[500,520],[900,900]],width:8},{kind:'lake',center:[700,300],radii:[80,60]},{kind:'clearView',at:[300,300],yaw:30,bearings:[-35,35],dist:[5,90],eye:4}],types:c=>c.water?9:c.slope>.5?4:0,forest:c=>c.n>.2?1:0});console.log('gen ms',Date.now()-t0);\n\"","description":"Rewrite water distance on a 2-sample grid and retime","timeout":60000}}}
