core: p.score, rounds: p.rifle.rounds, chambered: p.rifle.chambered, benched: p.benched, scoped: p.scope.up, breath: r1(p.scope.breath), calls: p.call.charges, reticle: [Math.round(p.rx), Math.round(p.ry)], bot: !!p.bot })) : [],","+      actors: H ? H.actors.map(a => ({ id: a.id, kind: a.kind, sex: a.sex, cat: a.cat, state: a.state, x: Math.round(a.x / M), y: Math.round(a.y / M), z: r1(a.z / M), hp: r1(a.hp), wounded: a.wounds > 0, bagger: a.bagger, visible: a.visible, trophy: a.trophy || null, target: a.target })) : [],","+      bucksLeft: H && H.site ? H.site.S.bucksLeft : 0, results: H && H.site ? H.site.results.map(r => ({ n: r.n, score: r.score, shots: r.shots, hits: r.hits, kills: r.kills.length, stars: r.stars })) : [],","+      siteResults: H ? H.siteResults.map(s => ({ id: s.id, reason: s.endReason, scores: s.results.map(r => r.score), stars: s.results.map(r => r.stars) })) : [],","+      trophy: H && H.trophyInfo ? { id: H.trophyInfo.id, seen: H.trophyInfo.seen, bagged: H.trophyInfo.bagged } : null, bonus: H && H.bonusResult ? { id: H.bonusResult.id, score: H.bonusResult.score, perfect: H.bonusResult.perfect } : null,","+      cam: H ? { yaw: r1(H.cam.yaw / DEG), pitch: r1(H.cam.pitch), fov: r1(H.cam.fov) } : null, timeScale: game.timeScale,","+      hub: G.hubLink ? G.hubLink.snapshot() : { active: HUB_ON },","+      records: Records.d ? { trophies: Object.keys(Records.d.trophies).filter(k => Records.d.trophies[k].bagged), best: Object.assign({}, Records.d.best), badge: Records.d.badge, champion: Records.d.champion } : null,","+      queue: H ? H.queue.map(q => q.kind) : [], errors: game.errors.length, touchOnly: G.touchOnly };","+  },","+  hunt: () => G.hunt,","+  actor(id) { const H = G.hunt; return H && H.actors.find(a => a.id === id); },","+  /** put a player's reticle on an actor's zone (the swayed point, so a scoped shot lands there) */","+  aimAt(pn, actorId, zone = 'heart') {","+    const H = G.hunt, p = H.players[pn - 1], a = typeof actorId === 'string' ? this.actor(actorId) : actorId; if (!p || !a) return false;","+    const z = a.zones(), v = z.find(q => q.id === zone) || z.find(q => q.id === 'body') || z[0]; if (!v) return false;","+    const c = v.kind === 'sphere' ? v.a : [(v.a[0] + v.b[0]) / 2, (v.a[1] + v.b[1]) / 2, (v.a[2] + v.b[2]) / 2];","+    H.lens.setup({ x: H.cam.x, y: H.cam.y, z: H.cam.z, yaw: H.cam.yaw, pitch: H.cam.pitch, fov: H.cam.fov }, H.W, H.H);","+    const q = H.lens.project(c[0], c[1], c[2]); if (!q) return false;","+    const s = p.scope.raise > .05 ? p.scope.sway() : [0, 0]; p.rx = q[0] - s[0]; p.ry = q[1] - s[1]; return true;","+  },","+  fire(pn = 1) { const p = G.hunt.players[pn - 1]; G.hunt.trigger(p); },","+  pump(pn = 1) { G.hunt.players[pn - 1].rifle.pump(); },","+  scope(pn = 1, on = true) { const p = G.hunt.players[pn - 1]; p.scope.toggle = on; p.scope.update(0, on, false); p.scope.raise = on ? 1 : 0; },","+  breath(pn = 1, on = true) { G.hunt.players[pn - 1].input.hold('breath', on); },","+  call(pn = 1) { G.hunt.useCall(G.hunt.players[pn - 1]); },","+  goto(huntId, kind, id) { if (!G.hunt || G.hunt.huntId !== huntId) { startHunt({ mode: 'single', hunt: huntId }); game.advance(.6); } G.hunt.skipTo(kind, id); },","+  spawn(kind, o = {}) { const H = G.hunt; if (!H || !H.site) return null; return H.site.spawn(kind, Object.assign({ at: o.at || [0, 40], path: o.path, orders: o.orders || [['hold']], hidden: false }, o)); },","+  skip() { if (G.hunt) G.hunt.skip(); },","+  bagAll(pn = 1) { const H = G.hunt; if (!H) return 0; let n = 0; for (const a of H.actors.slice()) if (a.alive && a.target && a.cat === 'animal') { a.state = a.state === 'hidden' ? 'move' : a.state; const R = { kind: 'animal', actor: a, zone: 'heart', t: 100, point: [a.x, a.y, a.z + 16], dist: Math.hypot(a.x - H.cam.x, a.y - H.cam.y) / M, shot: { p: H.players[pn - 1], ray: H.lens.ray(H.W / 2, H.H / 2) } }; applyShot(H, R); n++; } return n; },","+  bot(on = true, o = {}) { const H = G.hunt; if (!H) return; for