{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghyhCfMdbwYcF3yQpxWj","type":"message","role":"assistant","content":[{"type":"text","text":"Modes all pass. Now the misc suite (attract, dev mode, touch-only, saves, determinism) and the hub suite against the stub."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3060,"cache_read_input_tokens":864047,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3060},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8fb56c77-99e2-4018-a816-6b0a42973b6b","uuid":"669d36ad-6d78-4b96-a5b2-cdd66476f431","timestamp":"2026-11-04T13:37:10.701Z","request_id":"req_011CghyhCL1XVToKEgw9ArmG"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghyhCfMdbwYcF3yQpxWj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SEf3eHMN3YpD8dXUTML9hX","name":"Bash","input":{"command":"cat > tests/flow-misc.test.mjs <<'EOF'\nimport { run } from './lib/t.mjs';\nimport { load } from './lib/load.mjs';\nimport { startSite, finishSite } from './lib/play.mjs';\nrun('misc', async t => {\n  // ---- the attract mode ----\n  { const L = load({}), { game, I, step } = L, X = game.debug.internals; step(1);\n    step(9); t.ok('attract: not before 10 s idle', game.sceneName === 'title');\n    step(2); t.ok('attract: starts after 10 s idle on the title', game.sceneName === 'attract', game.sceneName);\n    const clips = new Set(); for (let k = 0; k < 520; k++) { step(.25); if (X.G.attract) clips.add(X.G.attract.clip); }\n    t.ok('attract: cycles its whole playlist', clips.size >= X.ATTRACT.length, [...clips].join(','));\n    I.press('KeyA'); step(.1); I.release('KeyA'); step(.6); t.ok('attract: a key goes back to the title', game.sceneName === 'title', game.sceneName);\n    step(11); t.ok('attract: and starts again after idling', game.sceneName === 'attract');\n    I.feed('move', 100, 100); step(.05); I.feed('move', 140, 130); step(.6); t.ok('attract: a mouse move goes back', game.sceneName === 'title', game.sceneName);\n    step(11); I.press('Pad0'); step(.1); I.release('Pad0'); step(.6); t.ok('attract: a pad button goes back', game.sceneName === 'title', game.sceneName);\n    I.tap('start'); step(.8); step(11); t.ok('attract: a top menu page idles into it too', game.sceneName === 'attract', game.sceneName);\n    t.ok('attract: no errors', !L.errs().length, L.errs().slice(0, 3).join(' | ')); }\n  // ---- dev mode ----\n  { const L = load({}), { game, I, D, step } = L, X = game.debug.internals; step(1);\n    const H = startSite(L, 'hollow', 'hollow-1', { seed: 2 }); step(1);\n    I.tap('pause'); step(.2); t.ok('dev: the pause menu opens', game.paused);\n    t.ok('dev: the pause menu lists Dev mode', (game.o.menu.items || []).some(i => i[0] === 'Dev mode'));\n    X.DEV.open(); step(.1); t.ok('dev: Dev mode opens its screen with the game running', X.G.ui.screen === 'dev' && !game.paused, X.G.ui.screen + ' ' + game.paused);\n    const a = H.site.spawn('buck', { at: [0, 30], path: [[0, 30], [20, 32]], orders: [['walk', { to: 1 }]], hidden: false }); a.appear(); const w1 = a.gaitSpeed('walk');\n    D.tuning('animalSpeed', 2); step(1 / 120); t.ok('dev: animal speed 2 doubles a walking deer', Math.abs(a.gaitSpeed('walk') / w1 - 2) < 1e-6);\n    D.tuning('rounds', 8); game.settings.reset('Dev'); t.ok('dev: Reset to defaults restores every key', Object.keys(X.TUNE_DEFAULT).every(k => X.T(k) === X.TUNE_DEFAULT[k]));\n    H.godMode = true; const doe = H.site.spawn('doe', { at: [2, 25], orders: [['hold']], hidden: false }); doe.appear(); step(.2); D.aimAt(1, doe, 'heart'); D.fire(1); step(.1); t.ok('dev: god mode means no benching', !H.players[0].benched); H.godMode = false;\n    H.skipTo('site', 'hollow-3'); step(.2); t.ok('dev: jump to a site loads it', H.site && H.site.id === 'hollow-3');\n    X.DEV.startFree(); const x0 = H.lens.x; I.hold('up'); for (let k = 0; k < 60; k++) step(1 / 120); I.hold('up', false); H.setupLens(); t.ok('dev: the free camera moves the lens', Math.abs(H.lens.x - x0) + Math.abs(H.lens.y - H.cam.y) > 4); I.tap('cancel'); step(.1);\n    t.ok('dev: no errors', !L.errs().length, L.errs().slice(0, 3).join(' | ')); }\n  // ---- a touch-only device ----\n  { const L = load({ touchOnly: true }), { game, I, step } = L, X = game.debug.internals; step(1);\n    t.ok('touch: the title knows it is touch-only (Controller or keyboard required)', X.G.touchOnly === true);\n    t.ok('touch: no touch buttons', game.input.touchEnabled === false);\n    I.feed('down', 240, 140, { touch: true }); step(.05); I.feed('up', 240, 140, { touch: true }); step(.8); t.ok('touch: a tap does not start a game', game.sceneName === 'title', game.sceneName);\n    step(11); t.ok('touch: the attract mode still runs', game.sceneName === 'attract', game.sceneName);\n    I.feed('down', 240, 140, { touch: true }); step(.05); I.feed('up', 240, 140, { touch: true }); step(.8); t.ok('touch: a tap leaves it', game.sceneName === 'title', game.sceneName);\n    I.press('KeyA'); step(.1); I.release('KeyA'); step(.1); t.ok('touch: a key clears the touch-only state', X.G.touchOnly === false); }\n  // ---- saves ----\n  { const storage = new Map(); let L = load({ storage }), X = L.game.debug.internals; L.step(1);\n    let H = startSite(L, 'hollow', 'hollow-1', { seed: 1 }); L.game.debug.bot(true, { skill: 'expert', cheat: true }); finishSite(L, H);\n    X.Records.trophy('iron-rack', { bagged: true, seen: 1, best: 80 }); X.Records.save();\n    L.game.saves.save('auto', { data: { next: 1, scores: { hollow: 4000 } }, place: 'Bugle Ridge', level: 2 });\n    const bucks = X.Records.d.stats.bucks;\n    L = load({ storage }); X = L.game.debug.internals; L.step(1);\n    t.ok('saves: records and trophies survive a reload', X.Records.d.stats.bucks === bucks && bucks > 0 && X.Records.d.trophies['iron-rack'].bagged, X.Records.d.stats.bucks + ' vs ' + bucks);\n    L.I.tap('start'); L.step(.8); const menu = L.game.scenes.menu.top; t.ok('saves: the menu offers CONTINUE HUNT-OFF', menu && menu.items[0].label === 'CONTINUE HUNT-OFF', menu && menu.items[0].label);\n    L.I.tap('confirm'); L.step(1); t.ok('saves: CONTINUE resumes at the next hunt', X.G.hunt && X.G.hunt.huntId === 'bugle' && X.G.hunt.mode === 'campaign'); }\n  // ---- determinism ----\n  { const sim = (extraFx) => { const L = load({}), X = L.game.debug.internals; L.step(1); const H = startSite(L, 'bugle', 'bugle-1', { seed: 9 }); L.game.debug.bot(true, { skill: 'average' }); for (let k = 0; k < 240; k++) { if (extraFx) for (let j = 0; j < 7; j++) X.RNG.stream('fx')(); L.step(.25); } return { hash: L.game.stateHash().join('|'), log: (H.site ? H.site.log : []).join(',') }; };\n    const a = sim(false), b = sim(false), c = sim(true);\n    t.ok('determinism: the same seed and inputs give the same state after 60 s', a.hash === b.hash);\n    t.ok('determinism: cosmetic random draws never change the spawns', a.log === c.log && a.log.length > 0, a.log + ' vs ' + c.log); }\n});\nEOF\ncat > tests/flow-hub.test.mjs <<'EOF'\nimport { run } from './lib/t.mjs';\nimport { load } from './lib/load.mjs';\nimport { hubStub } from './lib/hubstub.mjs';\nconst tick = () => new Promise(r => setImmediate(r));\nrun('hub', async t => {\n  const copy = async (me, shoot) => {\n    const hub = hubStub({ me }), L = load({ hub }), { game, I, step } = L, X = game.debug.internals; step(.5); await tick(); step(.1);\n    return { hub, L, game, I, step, X };\n  };\n  const A = await copy(0, true);\n  t.ok('hub: the game starts in the hub scene', A.game.sceneName === 'hub', A.game.sceneName);\n  t.ok('hub: it shows its own card', A.X.HubLink.phase === 'card', A.X.HubLink.phase);\n  t.ok('hub: ready() once, with no key press', A.hub.readyCalls === 1, A.hub.readyCalls);\n  A.hub.emit('card', { left: 9000, ready: [1], asking: 0 }); A.I.tap('confirm'); A.step(.1);\n  t.ok('hub: Enter answers Ready on the card', A.hub.answers.includes('ready'));\n  A.I.tap('call'); A.step(.1); t.ok('hub: Triangle asks for more time', A.hub.answers.includes('more'));\n  const B = await copy(1, false);\n  for (const C of [A, B]) { C.hub.emit('start', { in: 3000 }); C.hub.t = -3000; C.step(.1); }\n  t.ok('hub: start brings the countdown', A.X.HubLink.phase === 'countdown');\n  // play: the hub's clock drives both copies; A's player is a bot that shoots, B's never does\n  A.X.G.hunt = A.X.HubLink.H;\n  const segsA = [], logs = [[], []];\n  for (let s = 0; s <= 182 * 4; s++) {\n    for (const [i, C] of [A, B].entries()) { C.hub.t = s * 250; if (i === 0 && C.X.HubLink.H && C.X.HubLink.H.players[0] && !C.X.HubLink.H.players[0].bot) C.X.HubLink.H.players[0].bot = new C.X.HunterBot({ skill: 'expert' }); C.step(.25); const H = C.X.HubLink.H; if (H && H.site && H.site.log) logs[i][C.X.HubLink.segI] = H.site.log.join(','); }\n    const sg = A.X.HubLink.segI; if (segsA[segsA.length - 1] !== sg) segsA.push(sg);\n  }\n  t.ok('hub: segments change on the hub clock', segsA.join(',') === '0,1,2,3,4,5,6,7', segsA.join(','));\n  const prog = A.hub.progressLog; let gaps = 0; for (let i = 1; i < prog.length; i++) if (prog[i].at - prog[i - 1].at > 1600) gaps++;\n  t.ok('hub: progress at least once a second', prog.length >= 170 && gaps === 0, prog.length + ' reports, ' + gaps + ' gaps');\n  t.ok('hub: exactly one result at the end', A.hub.results.length === 1 && typeof A.hub.results[0].score === 'number' && A.hub.results[0].stats, JSON.stringify(A.hub.results));\n  t.ok('hub: the shooting copy scored', A.hub.results[0].score > 0, A.hub.results[0].score);\n  const g = A.hub.sends.filter(s => s.d.t === 'g'), shots = A.hub.sends.filter(s => s.d.t === 'shot');\n  let burst = 0; for (let i = 10; i < g.length; i++) if (g[i].at - g[i - 10].at < 950) burst++;\n  t.ok('hub: ghost updates at most 10 a second, unreliable', g.length > 100 && g.every(s => !s.reliable) && burst === 0, g.length + ' sends, ' + burst + ' bursts');\n  t.ok('hub: shots go out reliably', shots.length > 0 && shots.every(s => s.reliable), shots.length);\n  t.ok('hub: spawns are the same in a copy that shoots and one that does not', logs[0][1] && logs[0][1] === logs[1][1] && logs[0][3] === logs[1][3], (logs[0][1] || '') + ' | ' + (logs[1][1] || ''));\n  A.hub.emit('message', { t: 'g', s: A.X.HubLink.segI, a: [100, -20], sc: 0, p: 500 }, 1);\n  t.ok('hub: a ghost message moves the ghost', A.X.HubLink.ghosts.get(1) && A.X.HubLink.ghosts.get(1).p === 500);\n  A.hub.emit('end', { reason: 'finished', standings: [[0], [1]] }); A.step(.2);\n  t.ok('hub: end stops the round', A.X.HubLink.phase === 'over' && A.game.audio.muted);\n  // time-up before the end: a result at once\n  const Cc = await copy(0, false); Cc.hub.emit('start', { in: 3000 }); for (let s = 0; s < 120; s++) { Cc.hub.t = -3000 + s * 250; Cc.step(.25); } Cc.hub.emit('time-up', { graceMs: 3000 }); Cc.step(.1);\n  t.ok('hub: time-up sends the result at once', Cc.hub.results.length === 1, Cc.hub.results.length);\n  Cc.hub.emit('end', { reason: 'finished', standings: [[0]] }); Cc.step(.1); t.ok('hub: never a second result', Cc.hub.results.length === 1);\n  t.ok('hub: no errors', !A.L.errs().length && !B.L.errs().length, A.L.errs().concat(B.L.errs()).slice(0, 3).join(' | '));\n});\nEOF\nnode build/build.mjs >/dev/null && node tests/run.mjs flow-","description":"Write misc and hub suites; run all flow suites","timeout":900000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3060,"cache_read_input_tokens":864047,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3060},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8fb56c77-99e2-4018-a816-6b0a42973b6b","uuid":"8cd94ee2-2b9b-4381-909b-e4a5ce7a20da","timestamp":"2026-11-04T13:37:47.098Z","request_id":"req_011CghyhCL1XVToKEgw9ArmG","wire_tool_inputs":{"toolu_01SEf3eHMN3YpD8dXUTML9hX":{"command":"cat > tests/flow-misc.test.mjs <<'EOF'\nimport { run } from './lib/t.mjs';\nimport { load } from './lib/load.mjs';\nimport { startSite, finishSite } from './lib/play.mjs';\nrun('misc', async t => {\n  // ---- the attract mode ----\n  { const L = load({}), { game, I, step } = L, X = game.debug.internals; step(1);\n    step(9); t.ok('attract: not before 10 s idle', game.sceneName === 'title');\n    step(2); t.ok('attract: starts after 10 s idle on the title', game.sceneName === 'attract', game.sceneName);\n    const clips = new Set(); for (let k = 0; k < 520; k++) { step(.25); if (X.G.attract) clips.add(X.G.attract.clip); }\n    t.ok('attract: cycles its whole playlist', clips.size >= X.ATTRACT.length, [...clips].join(','));\n    I.press('KeyA'); step(.1); I.release('KeyA'); step(.6); t.ok('attract: a key goes back to the title', game.sceneName === 'title', game.sceneName);\n    step(11); t.ok('attract: and starts again after idling', game.sceneName === 'attract');\n    I.feed('move', 100, 100); step(.05); I.feed('move', 140, 130); step(.6); t.ok('attract: a mouse move goes back', game.sceneName === 'title', game.sceneName);\n    step(11); I.press('Pad0'); step(.1); I.release('Pad0'); step(.6); t.ok('attract: a pad button goes back', game.sceneName === 'title', game.sceneName);\n    I.tap('start'); step(.8); step(11); t.ok('attract: a top menu page idles into it too', game.sceneName === 'attract', game.sceneName);\n    t.ok('attract: no errors', !L.errs().length, L.errs().slice(0, 3).join(' | ')); }\n  // ---- dev mode ----\n  { const L = load({}), { game, I, D, step } = L, X = game.debug.internals; step(1);\n    const H = startSite(L, 'hollow', 'hollow-1', { seed: 2 }); step(1);\n    I.tap('pause'); step(.2); t.ok('dev: the pause menu opens', game.paused);\n    t.ok('dev: the pause menu lists Dev mode', (game.o.menu.items || []).some(i => i[0] === 'Dev mode'));\n    X.DEV.open(); step(.1); t.ok('dev: Dev mode opens its screen with the game running', X.G.ui.screen === 'dev' && !game.paused, X.G.ui.screen + ' ' + game.paused);\n    const a = H.site.spawn('buck', { at: [0, 30], path: [[0, 30], [20, 32]], orders: [['walk', { to: 1 }]], hidden: false }); a.appear(); const w1 = a.gaitSpeed('walk');\n    D.tuning('animalSpeed', 2); step(1 / 120); t.ok('dev: animal speed 2 doubles a walking deer', Math.abs(a.gaitSpeed('walk') / w1 - 2) < 1e-6);\n    D.tuning('rounds', 8); game.settings.reset('Dev'); t.ok('dev: Reset to defaults restores every key', Object.keys(X.TUNE_DEFAULT).every(k => X.T(k) === X.TUNE_DEFAULT[k]));\n    H.godMode = true; const doe = H.site.spawn('doe', { at: [2, 25], orders: [['hold']], hidden: false }); doe.appear(); step(.2); D.aimAt(1, doe, 'heart'); D.fire(1); step(.1); t.ok('dev: god mode means no benching', !H.players[0].benched); H.godMode = false;\n    H.skipTo('site', 'hollow-3'); step(.2); t.ok('dev: jump to a site loads it', H.site && H.site.id === 'hollow-3');\n    X.DEV.startFree(); const x0 = H.lens.x; I.hold('up'); for (let k = 0; k < 60; k++) step(1 / 120); I.hold('up', false); H.setupLens(); t.ok('dev: the free camera moves the lens', Math.abs(H.lens.x - x0) + Math.abs(H.lens.y - H.cam.y) > 4); I.tap('cancel'); step(.1);\n    t.ok('dev: no errors', !L.errs().length, L.errs().slice(0, 3).join(' | ')); }\n  // ---- a touch-only device ----\n  { const L = load({ touchOnly: true }), { game, I, step } = L, X = game.debug.internals; step(1);\n    t.ok('touch: the title knows it is touch-only (Controller or keyboard required)', X.G.touchOnly === true);\n    t.ok('touch: no touch buttons', game.input.touchEnabled === false);\n    I.feed('down', 240, 140, { touch: true }); step(.05); I.feed('up', 240, 140, { touch: true }); step(.8); t.ok('touch: a tap does not start a game', game.sceneName === 'title', game.sceneName);\n    step(11); t.ok('touch: the attract mode still runs', game.sceneName === 'attract', game.sceneName);\n    I.feed('down', 240, 140, { touch: true }); step(.05); I.feed('up', 240, 140, { touch: true }); step(.8); t.ok('touch: a tap leaves it', game.sceneName === 'title', game.sceneName);\n    I.press('KeyA'); step(.1); I.release('KeyA'); step(.1); t.ok('touch: a key clears the touch-only state', X.G.touchOnly === false); }\n  // ---- saves ----\n  { const storage = new Map(); let L = load({ storage }), X = L.game.debug.internals; L.step(1);\n    let H = startSite(L, 'hollow', 'hollow-1', { seed: 1 }); L.game.debug.bot(true, { skill: 'expert', cheat: true }); finishSite(L, H);\n    X.Records.trophy('iron-rack', { bagged: true, seen: 1, best: 80 }); X.Records.save();\n    L.game.saves.save('auto', { data: { next: 1, scores: { hollow: 4000 } }, place: 'Bugle Ridge', level: 2 });\n    const bucks = X.Records.d.stats.bucks;\n    L = load({ storage }); X = L.game.debug.internals; L.step(1);\n    t.ok('saves: records and trophies survive a reload', X.Records.d.stats.bucks === bucks && bucks > 0 && X.Records.d.trophies['iron-rack'].bagged, X.Records.d.stats.bucks + ' vs ' + bucks);\n    L.I.tap('start'); L.step(.8); const menu = L.game.scenes.menu.top; t.ok('saves: the menu offers CONTINUE HUNT-OFF', menu && menu.items[0].label === 'CONTINUE HUNT-OFF', menu && menu.items[0].label);\n    L.I.tap('confirm'); L.step(1); t.ok('saves: CONTINUE resumes at the next hunt', X.G.hunt && X.G.hunt.huntId === 'bugle' && X.G.hunt.mode === 'campaign'); }\n  // ---- determinism ----\n  { const sim = (extraFx) => { const L = load({}), X = L.game.debug.internals; L.step(1); const H = startSite(L, 'bugle', 'bugle-1', { seed: 9 }); L.game.debug.bot(true, { skill: 'average' }); for (let k = 0; k < 240; k++) { if (extraFx) for (let j = 0; j < 7; j++) X.RNG.stream('fx')(); L.step(.25); } return { hash: L.game.stateHash().join('|'), log: (H.site ? H.site.log : []).join(',') }; };\n    const a = sim(false), b = sim(false), c = sim(true);\n    t.ok('determinism: the same seed and inputs give the same state after 60 s', a.hash === b.hash);\n    t.ok('determinism: cosmetic random draws never change the spawns', a.log === c.log && a.log.length > 0, a.log + ' vs ' + c.log); }\n});\nEOF\ncat > tests/flow-hub.test.mjs <<'EOF'\nimport { run } from './lib/t.mjs';\nimport { load } from './lib/load.mjs';\nimport { hubStub } from './lib/hubstub.mjs';\nconst tick = () => new Promise(r => setImmediate(r));\nrun('hub', async t => {\n  const copy = async (me, shoot) => {\n    const hub = hubStub({ me }), L = load({ hub }), { game, I, step } = L, X = game.debug.internals; step(.5); await tick(); step(.1);\n    return { hub, L, game, I, step, X };\n  };\n  const A = await copy(0, true);\n  t.ok('hub: the game starts in the hub scene', A.game.sceneName === 'hub', A.game.sceneName);\n  t.ok('hub: it shows its own card', A.X.HubLink.phase === 'card', A.X.HubLink.phase);\n  t.ok('hub: ready() once, with no key press', A.hub.readyCalls === 1, A.hub.readyCalls);\n  A.hub.emit('card', { left: 9000, ready: [1], asking: 0 }); A.I.tap('confirm'); A.step(.1);\n  t.ok('hub: Enter answers Ready on the card', A.hub.answers.includes('ready'));\n  A.I.tap('call'); A.step(.1); t.ok('hub: Triangle asks for more time', A.hub.answers.includes('more'));\n  const B = await copy(1, false);\n  for (const C of [A, B]) { C.hub.emit('start', { in: 3000 }); C.hub.t = -3000; C.step(.1); }\n  t.ok('hub: start brings the countdown', A.X.HubLink.phase === 'countdown');\n  // play: the hub's clock drives both copies; A's player is a bot that shoots, B's never does\n  A.X.G.hunt = A.X.HubLink.H;\n  const segsA = [], logs = [[], []];\n  for (let s = 0; s <= 182 * 4; s++) {\n    for (const [i, C] of [A, B].entries()) { C.hub.t = s * 250; if (i === 0 && C.X.HubLink.H && C.X.HubLink.H.players[0] && !C.X.HubLink.H.players[0].bot) C.X.HubLink.H.players[0].bot = new C.X.HunterBot({ skill: 'expert' }); C.step(.25); const H = C.X.HubLink.H; if (H && H.site && H.site.log) logs[i][C.X.HubLink.segI] = H.site.log.join(','); }\n    const sg = A.X.HubLink.segI; if (segsA[segsA.length - 1] !== sg) segsA.push(sg);\n  }\n  t.ok('hub: segments change on the hub clock', segsA.join(',') === '0,1,2,3,4,5,6,7', segsA.join(','));\n  const prog = A.hub.progressLog; let gaps = 0; for (let i = 1; i < prog.length; i++) if (prog[i].at - prog[i - 1].at > 1600) gaps++;\n  t.ok('hub: progress at least once a second', prog.length >= 170 && gaps === 0, prog.length + ' reports, ' + gaps + ' gaps');\n  t.ok('hub: exactly one result at the end', A.hub.results.length === 1 && typeof A.hub.results[0].score === 'number' && A.hub.results[0].stats, JSON.stringify(A.hub.results));\n  t.ok('hub: the shooting copy scored', A.hub.results[0].score > 0, A.hub.results[0].score);\n  const g = A.hub.sends.filter(s => s.d.t === 'g'), shots = A.hub.sends.filter(s => s.d.t === 'shot');\n  let burst = 0; for (let i = 10; i < g.length; i++) if (g[i].at - g[i - 10].at < 950) burst++;\n  t.ok('hub: ghost updates at most 10 a second, unreliable', g.length > 100 && g.every(s => !s.reliable) && burst === 0, g.length + ' sends, ' + burst + ' bursts');\n  t.ok('hub: shots go out reliably', shots.length > 0 && shots.every(s => s.reliable), shots.length);\n  t.ok('hub: spawns are the same in a copy that shoots and one that does not', logs[0][1] && logs[0][1] === logs[1][1] && logs[0][3] === logs[1][3], (logs[0][1] || '') + ' | ' + (logs[1][1] || ''));\n  A.hub.emit('message', { t: 'g', s: A.X.HubLink.segI, a: [100, -20], sc: 0, p: 500 }, 1);\n  t.ok('hub: a ghost message moves the ghost', A.X.HubLink.ghosts.get(1) && A.X.HubLink.ghosts.get(1).p === 500);\n  A.hub.emit('end', { reason: 'finished', standings: [[0], [1]] }); A.step(.2);\n  t.ok('hub: end stops the round', A.X.HubLink.phase === 'over' && A.game.audio.muted);\n  // time-up before the end: a result at once\n  const Cc = await copy(0, false); Cc.hub.emit('start', { in: 3000 }); for (let s = 0; s < 120; s++) { Cc.hub.t = -3000 + s * 250; Cc.step(.25); } Cc.hub.emit('time-up', { graceMs: 3000 }); Cc.step(.1);\n  t.ok('hub: time-up sends the result at once', Cc.hub.results.length === 1, Cc.hub.results.length);\n  Cc.hub.emit('end', { reason: 'finished', standings: [[0]] }); Cc.step(.1); t.ok('hub: never a second result', Cc.hub.results.length === 1);\n  t.ok('hub: no errors', !A.L.errs().length && !B.L.errs().length, A.L.errs().concat(B.L.errs()).slice(0, 3).join(' | '));\n});\nEOF\nnode build/build.mjs >/dev/null && node tests/run.mjs flow-","description":"Write misc and hub suites; run all flow suites","timeout":900000}}}
