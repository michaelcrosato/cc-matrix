age(cv, x0, y0, 140, 100, 0, 0, 560, 400);\n  return c2.toDataURL();\n});\nconst fs = await import('node:fs'); fs.writeFileSync('tests/out/pick-debug.png', Buffer.from(url.split(',')[1], 'base64')); await b.close();\nEOF\nTMPDIR=$PWD/.tmp node tests/scratch/pickimg.mjs && echo done","description":"Render a pick-miss debug image","timeout":120000}}}
