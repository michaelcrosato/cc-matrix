": \"AI Hub Session Protocol v1 in ghost mode for 1-4 players: the game's own card, a timed 3-minute Hub Hunt-Off keyed to the hub clock, ghost reticles and shots, progress and result reporting\",\n    \"testing\": \"unknown\",\n    \"research\": \"Planning stage (2026-11-03): Wikipedia 'Big Buck Hunter', the Highway Games listing and Macworld's iPhone review read directly; Giant Bomb, TV Tropes, MobyGames and the Sinden wiki only as search summaries; the my-3D2dge handoff docs and the AI Hub protocol docs. Build stage: no web research; the engine's and the hub's own docs and source\",\n    \"environment\": \"Claude Code CLI (headless); Linux (WSL2); Playwright's Chromium for the browser checks\",\n    \"model\": \"Anthropic, claude-opus-5-5, reasoning effort xhigh\",\n    \"usage\": \"unknown\"\n  },\n  \"testingFeedback\": [\"unknown\", \"unknown\", \"unknown\", \"unknown\"],\n  \"engineFeedback\": [\"unknown\", \"unknown\", \"unknown\", \"unknown\", \"unknown\", \"unknown\"],\n  \"promptFeedback\": [\"unknown\", \"unknown\", \"unknown\", \"unknown\"],\n  \"aiHub\": {\n    \"name\": \"Big Buck Hunt-Off\",\n    \"tagline\": \"Bucks only. Bragging rights forever.\",\n    \"description\": \"An arcade light-gun hunting shooter in living pixel landscapes: bag the bucks, spare the does, and win the Hunt-Off alone, on the couch or online.\",\n    \"type\": \"Game\",\n    \"genre\": \"Shooter\",\n    \"source\": \"Big Buck Hunter Pro\",\n    \"series\": \"Big Buck Hunter\",\n    \"players\": \"1–4\",\n    \"controls\": \"Aim: mouse or left stick · Shoot: left click or R2 · Pump: R or Square · Scope: right click or L2 · Call: Q or Triangle\",\n    \"tags\": [\"first-person\", \"arcade\", \"pixel art\", \"versus\", \"comedy\", \"retro\"]\n  }\n}\nEOF\npython3 - <<'EOF'\np='build/build.mjs'; s=open(p).read()\na=\"writeFileSync(join(ROOT, 'build/game.js'), game.code);\"\nassert a in s; s=s.replace(a,a+\"\"\"\n// the exit interview, beside the game: report.json in exactly its shape\nconst rep = JSON.parse(read('report.json')), shape = { sourceInformation: ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'], aiHub: ['name', 'tagline', 'description', 'type', 'genre', 'source', 'series', 'players', 'controls', 'tags'] };\nconst exit = { sourceInformation: {}, testingFeedback: rep.testingFeedback, engineFeedback: rep.engineFeedback, promptFeedback: rep.promptFeedback, aiHub: {} };\nfor (const k of shape.sourceInformation) { if (typeof rep.sourceInformation[k] !== 'string' || !rep.sourceInformation[k]) fail('report.json: sourceInformation.' + k + ' is empty'); exit.sourceInformation[k] = rep.sourceInformation[k]; }\nfor (const k of shape.aiHub) exit.aiHub[k] = rep.aiHub[k];\nif (exit.testingFeedback.length !== 4 || exit.engineFeedback.length !== 6 || exit.promptFeedback.length !== 4) fail('report.json: the feedback lists need 4, 6 and 4 answers');\nwriteFileSync(join(ROOT, '..', 'exit-interview.json'), JSON.stringify(exit, null, 2) + '\\\\n');\"\"\")\nopen(p,'w').write(s); print('ok')\nEOF\nnode build/build.mjs && node -e \"JSON.parse(require('fs').readFileSync('../exit-interview.json','utf8')); console.log('exit-interview parses')\"","description":"Write report.json and generate exit-interview.json in the build","timeout":60000}}}
