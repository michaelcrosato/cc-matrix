.spawn(o.kind, Object.assign({}, o, { path: o.path, delay: o.after || 12, orders: [['run', { to: 1 }], ['exit']], jumps: [{ d: .02 }] }));","+  const off = bus.on('shot', () => { if (a.state === 'hidden') { a.delay = .25 + S.rng.f() * .3; } off(); });","+  S.cleanup.push(off);","+  return [a];","+} });","+def('pattern', 'decoyDoe', { make(S, o) { return [S.spawn(o.kind || (S.species === 'whitetail' ? 'doe' : 'cow'), Object.assign({}, o, { orders: orderFor(o, o.gait || 'walk'), decoy: true }))]; } });","+def('pattern', 'stand', { make(S, o) {","+  const path = [o.from, o.at, o.exit || [o.at[0] + 30, o.at[1] + 10]];","+  return [S.spawn(o.kind, Object.assign({}, o, { path, orders: [['walk', { to: .49 }], ['stand', { secs: o.secs || 3 }], ['trot', { to: 1 }], ['exit']] }))];","+} });","+def('pattern', 'charge', { make(S, o) {   // runs straight at the vantage, then veers off","+  const path = o.path || [o.from, [o.from[0] * .3, 18], [o.veer || 40, 12], [(o.veer || 40) * 1.5, 30]];","+  return [S.spawn(o.kind, Object.assign({}, o, { path, orders: [['run', { to: 1 }], ['exit']], charge: true }))];","+} });","+def('pattern', 'fight', { make(S, o) {   // two bulls lock antlers, then split","+  const A = S.spawn(o.kind || 'bull', Object.assign({}, o, { path: [o.fromA, o.at, o.exitA], points: o.pointsA, orders: [['walk', { to: .48 }], ['fight', { secs: o.secs || 5 }], ['run', { to: 1 }], ['exit']] }));","+  const B = S.spawn(o.kind || 'bull', Object.assign({}, o, { path: [o.fromB, [o.at[0] + 3, o.at[1] + 3], o.exitB], points: o.pointsB, orders: [['walk', { to: .48 }], ['fight', { secs: o.secs || 5 }], ['run', { to: 1 }], ['exit']] }));","+  A.orders[0][1].with = B; A.orders[1][1].with = B; B.orders[1][1].with = A;","+  for (const X of [A, B]) for (const q of X.orders) if (q[0] === 'fight') q[1].with = X === A ? B : A;","+  return [A, B];","+} });"]}],"originalFile":"// (being written)\n","userModified":false},"tool_result_meta":[{"id":"toolu_019ja6kE1qipM5NKLd8Co8ij","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
