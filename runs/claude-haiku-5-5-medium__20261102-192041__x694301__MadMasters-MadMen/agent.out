AGEERROR ' + str(e)))\n    pg.goto(URL); wait(pg, 2000)\n    # 1) pitch flow with brief and insights set by test hooks\n    pg.keyboard.press('Enter'); wait(pg, 500)\n    pg.evaluate(\"window.__game.debug.setBrief(); ['ruth','teddy','maren'].forEach(k=>window.__game.debug.setInsight(k))\"); wait(pg, 100)\n    pg.evaluate(\"window.__game.debug.teleport(360, 152)\"); wait(pg, 400)\n    print('at pitch trigger', snap(pg))\n    wait(pg, 300)\n    print('scene after trigger', snap(pg)['scene'])\n    pg.keyboard.press('Enter'); wait(pg, 300)   # choose angle\n    pg.screenshot(path='/tmp/mmtest/pitch_reel.png')\n    for i in range(3):\n        wait(pg, 700)\n        pg.keyboard.press('Enter'); wait(pg, 200)\n    wait(pg, 300)\n    pg.screenshot(path='/tmp/mmtest/pitch_result.png')\n    pg.keyboard.press('Enter'); wait(pg, 500)\n    print('after pitch', snap(pg))\n    pg.screenshot(path='/tmp/mmtest/end.png')\n    pg.keyboard.press('Enter'); wait(pg, 500)\n    print('back to', snap(pg)['scene'])\n    # 2) idle attract after 10 s on the title\n    wait(pg, 10800)\n    print('after idle 10.8s', snap(pg))\n    samples = []\n    for i in range(14):\n        wait(pg, 4000)\n        samples.append(snap(pg))\n        if i == 1: pg.screenshot(path='/tmp/mmtest/attract.png')\n    for s in samples: print('attract', s)\n    pg.keyboard.press('ArrowLeft'); wait(pg, 400)\n    print('after input in attract', snap(pg)['scene'])\n    print('ERRORS', [e for e in errs if 'unknown prop' not in e][:15])\n    b.close()\nEOF\ncd /tmp/mmtest && timeout 200 python3 flow.py 2>&1 | tail -40","description":"Replace middle dots, rebuild, test pitch, end and attract flow"}}}
