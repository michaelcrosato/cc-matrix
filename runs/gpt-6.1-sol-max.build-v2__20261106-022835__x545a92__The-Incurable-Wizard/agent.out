{"type":"item.started","item":{"id":"item_107","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='tests/core.mjs';s=open(p).read();idx=s.rfind('\\\\n}');s=s[:idx]+'''\n  test('portal arrival lock releases after a vertical exit from the arrival area',()=>{const w=newWorld();quiet(w);const p=w.players[0];p.m.place(0,6);w.portal(p);p.m.place(19,3);w.portal(p);if(p.portalLock)throw Error('vertical arrival exit kept portal locked');});\n  test('Wizard moves his warning if a player enters the apparition rune',()=>{const w=newWorld();w.loadRoom(1);quiet(w);w.phase='Intrusion';w.nextWizard(.01);run(w,.02);w.players[0].m.place(w.wizard.x,w.wizard.y);run(w,1.1);if(w.wizard.state==='active'&&Math.hypot(w.players[0].m.x-w.wizard.x,w.players[0].m.y-w.wizard.y)<1.25)throw Error('Wizard materialized inside a player');});\n  test('corrupt family data is rejected before rendering',()=>{const w=newWorld();w.spawn('hopper',[2,1]);const d=w.export();d.enemies[0].kind='invalid';let caught=false;try{w.restore(d);}catch{caught=true;}if(\"'!caught)throw Error('\"'invalid creature schema accepted');});\n''' +s[idx:];open(p,'w').write(s)\np='tools/finalize-metadata.py';s=open(p).read().replace('10 distinct implementation issues','13 distinct implementation issues');open(p,'w').write(s)\np='evidence/issues.md';s=open(p).read().replace('\\\\nHeadless pilot route','\\\\n11. A portal arrival lock only cleared along the horizontal axis. It now clears after leaving the arrival area in either axis.\\\\n12. A player could walk into a Wizard warning before he materialized. The warning relocates and restarts if its destination becomes occupied.\\\\n13. Checkpoint validation accepted unknown creature families. It now rejects invalid family/queue/projectile schemas before simulation or rendering.\\\\n\\\\nHeadless pilot route');open(p,'w').write(s)\nPY\npython3 tools/finalize-metadata.py\nbiome check --write src tools tests/*.mjs interview.json > evidence/format.txt 2>&1\nnode tools/build.mjs\nnode tools/verify.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
