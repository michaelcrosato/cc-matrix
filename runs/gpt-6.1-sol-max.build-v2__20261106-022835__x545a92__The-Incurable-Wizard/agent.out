se && fs.supported && !fs.standalone) acts.push([fs.on ? 'Leave full screen' : 'Full screen', () => { fs.toggle(); }]);\n    if (help) acts.push(['Help', () => this.show('help')]);\n    // a recorded page (?record=1) saves its session from the menu: a phone has no console (the share sheet, or a download).\n    // Its replay has the button too (doing nothing): the recorded tap on it lands on it, not on the next one (Quit)\n    if (E.session && (E.session.recording || E.session.replaying)) acts.push(['Save session', () => { if (E.session.recording) E.session.share(); }]);\n    if (quit && g.scenes && g.scenes[quit] && g.sceneName !== quit) acts.push(['Quit to ' + (quit === 'title' ? 'title' : actionName(quit).toLowerCase()), () => this.show('confirm', { kicker: 'Quit', title: 'Leave this game?', text: 'Progress since the last save is lost.',\n      actions: [{ label: 'Keep playing', fn: () => this.back() }, { label: 'Quit', fn: () => { this.hide(); g.go(quit); } }] })]);\n  }\n  /** draw a TileMap from above: floor, roofs by height, water and grass, then markers and the body at (an arrow) */\n  _map(cv, s, large) {\n    const m = s.map, g = cv.getContext('2d'), W = cv.width, H = cv.height, T = m.T, ww = m.w * T, hh = m.h * T, pad = large ? 22 : 8;\n    const k = Math.min((W - pad * 2) / ww, (H - pad * 2) / hh), ox = (W - ww * k) / 2, oy = (H - hh * k) / 2, P = (x, y) => [ox + x * k, oy + y * k];\n    cv._xf = { k, ox, oy };\n    if (!m._shellBase || m._shellBase.v !== m.version || m._shellBase.w !== W) {   // the cells, cached until the map changes\n      const b = mkCanvas(W, H), bg = ctx2d(b); bg.fillStyle = '#121b1d'; bg.fillRect(0, 0, W, H);\n      let top = 1; for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) top = Math.max(top, m.height(cx, cy));\n      for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) {\n        const c = m.cell(cx, cy), tag = m.floorAt((cx + .5) * T, (cy + .5) * T);\n        bg.fillStyle = c > 0 ? mix('#4a5650', '#d2c296', m.height(cx, cy) / top) : tag === 'water' || tag === 'lava' ? (tag === 'water' ? '#1d3e56' : '#6a2a1a') : tag === 'grass' ? '#29452f' : '#1f2b2c';\n        bg.fillRect(Math.floor(ox + cx * T * k), Math.floor(oy + cy * T * k), Math.ceil(T * k), Math.ceil(T * k));\n      }\n      m._shellBase = { v: m.version, w: W, cv: b };\n    }\n    g.drawImage(m._shellBase.cv, 0, 0);\n    g.textAlign = 'center'; g.font = (large ? 12 : 7) + 'px ' + (this._o.theme && this._o.theme.font || 'sans-serif');\n    if (large) for (const [t, x, y] of s.labels || []) { g.fillStyle = '#cbbf9e'; g.fillText(t, ...P(x, y)); }\n    for (const q of (typeof s.markers === 'function' ? s.markers() : s.markers) || []) {\n      const [x, y] = P(q.x, q.y), r = (q.size || (large ? 6 : 3)); g.strokeStyle = g.fillStyle = q.color || '#ffe0a0'; g.lineWidth = large ? 2 : 1; g.beginPath();\n      if (q.kind === 'diamond') { g.moveTo(x, y - r); g.lineTo(x + r, y); g.lineTo(x, y + r); g.lineTo(x - r, y); g.closePath(); g.stroke(); }\n      else if (q.kind === 'cross') { g.moveTo(x - r, y); g.lineTo(x + r, y); g.moveTo(x, y - r); g.lineTo(x, y + r); g.stroke(); }\n      else if (q.kind === 'ring') { g.arc(x, y, r, 0, TAU); g.stroke(); }\n      else { g.arc(x, y, r * .7, 0, TAU); g.fill(); }\n      if (large && q.label) { g.fillStyle = '#ebd3a0'; g.fillText(q.label, x, y + r + 13); }\n    }\n    const F = s.fog;   // fog of war: what was never seen is black, what isn't in sight now dimmed\n    if (F) for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) { const c = [cx, cy]; if (F.visible(c)) continue; g.fillStyle = F.seen(c) ? 'rgba(6,8,10,.5)' : '#06080a'; g.fillRect(Math.floor(ox + cx * T * k), Math.floor(oy + cy * T * k), Math.ceil(T * k), Math.ceil(T * k)); }\n    if (s.camera) {   // the screen's corners on the ground: what the camera shows\n      const G = this._game, v = G.view, c = G.cam, S = G.screen, q = [[0, 0], [S.W, 0], [S.W, S.H], [0, S.H]].map(([a, b]) => v.toGround(c.x + a, c.y + b));\n      if (q.every(Boolean)) { g.strokeStyle = '#f8efd0'; g.lineWidth = 1; g.beginPath(); q.forEach(([a, b], i) => i ? g.lineTo(...P(a, b)) : g.moveTo(...P(a, b))); g.closePath(); g.stroke(); }\n    }\n    if (s.at) {\n      const [x, y] = P(s.at.x, s.at.y), a = s.at.facing || 0, r = large ? 9 : 5; g.fillStyle = '#f8efd0'; g.strokeStyle = '#10181a'; g.lineWidth = 1.5; g.beginPath();\n      g.moveTo(x + Math.cos(a) * r, y + Math.sin(a) * r); g.lineTo(x + Math.cos(a + 2.45) * r * .8, y + Math.sin(a + 2.45) * r * .8); g.lineTo(x + Math.cos(a - 2.45) * r * .8, y + Math.sin(a - 2.45) * r * .8); g.closePath(); g.fill(); g.stroke();\n    }\n    g.fillStyle = '#b6c5b5'; g.textAlign = 'right'; g.fillText('N', W - (large ? 12 : 5), large ? 18 : 10);\n  }\n  /** each step (the game calls it after reading input): follow game.paused, time out the toast and the card, and while a\n   *  screen is open, move the focus with the game's input and hold the rest of it back from the game */\n  _step() {\n    const g = this._game, I = g.input, now = g.real, sc = g.scene, play = !!sc && (!!sc.pausable || g.sceneName === 'main');\n    const pause = this._pauseSpec() && (!this._sys || (g.pauseOverlay !== false && play));   // (the engine's own menu stays out of a game that draws its own pause)\n    if (pause && g.paused && !this._stack.length) this.show('pause');\n    if (!g.paused && this._stack.length && (this._ownPause || (pause && this._stack.some(t => t.name === 'pause')))) { this._stack.length = 0; this._ownPause = false; this._capEnd(); this._render(); }   // resumed from code\n    if (this.root) {\n      if (this._toastEnd && now > this._toastEnd) { this._els.toast.classList.remove('on'); this._toastEnd = 0; }\n      if (this._tutEnd && now > this._tutEnd) this.tutorial(null);\n      this.root.classList.toggle('esh-still', !!g.reduceMotion);\n    }\n    if (!this._stack.length) return;\nclass GridMover {\n  /** new E.GridMover({ cx, cy, speed: 6 (cells a second) }) */\n  constructor(o = {}) {\n    /** cx, cy: the cell it is in (or leaving); x, y: its smooth position in cells (draw it there); speed: cells a second;\n     *  dir: [dx, dy] it is moving (or last moved); moving: between cells; arrived: true the step it reaches a cell */\n    this.cx = o.cx || 0; this.cy = o.cy || 0; this.x = this.cx; this.y = this.cy; this.speed = o.speed || 6; this.dir = [0, 0]; this.moving = false; this.arrived = false;\n    this._want = null; this._to = null; this._u = 0;\n  }\n  /** a step of dt: want ([dx, dy] or null) is kept until it can be taken. o: { blocked(cx, cy): true where it can't go,\n   *  push(cx, cy, dx, dy): true when what is in the way moved (a crate), keep: true goes on in the same direction (a\n   *  maze) }. Returns true when it reached a cell this step */\n  update(dt, grid, want, o = {}) {\n    if (want && (want[0] || want[1])) this._want = want;\n    this.arrived = false; let t = dt * this.speed;\n    for (let guard = 0; guard < 8 && t > 0; guard++) {\n      if (!this.moving) {\n        const tryDir = d => { if (!d) return false; const n = [this.cx + d[0], this.cy + d[1]]; if (!grid.walk(n)) return false; if (o.blocked && o.blocked(n[0], n[1]) && !(o.push && o.push(n[0], n[1], d[0], d[1]))) return false; this._to = n; this.dir = d; this.moving = true; this._u = 0; return true; };\n        if (tryDir(this._want)) this._want = o.keep ? this._want : null; else if (!(o.keep && tryDir(this.dir))) break;\n      }\n      const left = 1 - this._u, step = Math.min(left, t); this._u += step; t -= step;\n      this.x = this.cx + (this._to[0] - this.cx) * this._u; this.y = this.cy + (this._to[1] - this.cy) * this._u;\n      if (this._u >= 1 - 1e-9) { [this.cx, this.cy] = this._to; this.x = this.cx; this.y = this.cy; this.moving = false; this.arrived = true; if (!o.keep && !this._want) break; }\n    }\n    return this.arrived;\n  }\n  /** put it on a cell at once, still */\n  place(cx, cy) { this.cx = this.x = cx; this.cy = this.y = cy; this.moving = false; this._want = null; }\n}\nE.GridMover = GridMover;\n\n/* =============================================================================\n * TURNS  who acts next: by speed (energy), by charge time, by phase, or by ATB gauges on game time\n * ========================================================================== */\nclass Turns {\n  /** new E.Turns(actors, { mode: 'speed' | 'ct' | 'phase' | 'atb', sides: ['hero', 'foe'] (phase), fill: 1 (atb: gauge\n   *  per second at speed 100) }). An actor is any object with speed (100: normal) and, in phase mode, side */\n  constructor(actors = [], o = {}) {\n    /** actors: in the order they were added (ties go to the earlier); mode: 'speed', 'ct', 'phase' or 'atb'; sides: the\n     *  sides in their order (phase; null: as the actors have them); fill: an atb gauge's fill a second at speed 100;\n     *  phase: the side acting now (phase mode) */\n    this.actors = actors.slice(); this.mode = o.mode || 'speed'; this.sides = o.sides || null; this.fill = o.fill || 1; this.phase = null; this._left = [];\n    for (const a of this.actors) this._init(a);\n  }\n  _init(a) { if (a._turn === undefined) a._turn = 0; }\n  /** add an actor (it starts with an empty gauge) */\n  add(a) { this._init(a); this.actors.push(a); }\n  /** take an actor out (it died, it left) */\n  remove(a) { const i = this.actors.indexOf(a); if (i >= 0) this.actors.splice(i, 1); this._left = this._left.filter(x => x !== a); }\n  // the speed and ct modes: fill every gauge until one is full; returns it\n  _tick(A, take) {\n    if (!A.length) return null;\n    for (let guard = 0; guard < 1e5; guard++) {\n      let best = null; for (const a of A) if (a._turn >= 100 && (!best || a._turn > best._turn)) best = a;\n      if (best) { if (take) best._turn -= 100; return best; }\n      for (const a of A) a._turn += Math.max(1, a.speed === undefined ? 100 : a.speed) / 10;\n    }\n    return null;\n  }\n  /** the actor whose turn it is (speed: its energy spent; ct: call done(actor, cost) after it acts; phase: each of the\n   *  side once, then the next side's) */\n  next() {\n    if (this.mode === 'phase') {\n      if (!this._left.length) {\n        const sides = this.sides || [...new Set(this.actors.map(a => a.side))]; if (!sides.length) return null;\n        let i = this.phase === null ? 0 : (sides.indexOf(this.phase) + 1) % sides.length;\n        for (let k = 0; k < sides.length && !this._left.length; k++, i = (i + 1) % sides.length) { this.phase = sides[i]; this._left = this.actors.filter(a => a.side === this.phase); }\n      }\n      return this._left.shift() || null;\n    }\n    return this._tick(this.actors, this.mode === 'speed');\n  }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"Both handoffs match the plan: engine **0.89.1** and Hub client **1.4.0**. I also inspected a frame from the archived recording; its open lanes and simple radar support the intended layout. Next I’ll build the deterministic combat model, then use it for solo, co-op, attract mode, and tests.\n"}}
