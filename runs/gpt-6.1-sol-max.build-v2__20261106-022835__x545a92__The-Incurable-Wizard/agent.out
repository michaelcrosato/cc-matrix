(w.wizard);if(\"'!w.bell(post)||e.reveal<=0||e.lure<=0)throw Error('\"'bell failed');if(w.bell(post))throw Error('bell spam');if(JSON.stringify(w.wizard)\"'!==before)throw Error('\"'wizard affected');run(w,1.6);if(e.reveal>0||e.lure>0)throw Error('bell permanent');});\ntest('finite replacement obligations prevent premature hunt clear',()=>{const w=newWorld();w.phase='Hunt';w.queue=[{done:false,kind:'stalker',at:1,after:2,port:[2,1]}];run(w,2);if(w.phase\"'!=='\"'Hunt'||w.enemies.length)throw Error('premature phase');w.roomKills=2;run(w,.02);if(w.enemies.length\"'!==1||!w.queue[0].done)throw Error('\"'replacement not spawned');});\ntest('spawn grace forbids spawn-frame damage',()=>{const w=newWorld();quiet(w);const p=w.players[0];p.protect=0;w.spawn('hopper',[1,11]);run(w,.2);if(p.lives\"'!==3)throw Error('\"'spawn frame damage');});\ntest('portal arrival legal, protected and no recursive transit',()=>{const w=newWorld();quiet(w);const p=w.players[0];p.m.place(0,6);w.portal(p);if(p.m.cx\"'!==19||!p.portalLock||p.protect<.6)throw Error('\"'arrival unsafe');for(let n=0;n<10;n++)w.portal(p);if(p.m.cx\"'!==19||w.portals!==1)throw Error('\"'recursive portal');p.m.place(17,6);w.portal(p);if(p.portalLock)throw Error('arrival lock never clears');});\ntest('bolts die at portal mouth and allies do not block them',()=>{const w=newWorld({seats:[0,1]});quiet(w);const[a,b]=w.players;a.m.place(2,6);b.m.place(1,6);a.aim=2;w.fire(a);run(w,.3);if(a.bolt||w.bolts.length||b.lives\"'!==3)throw Error('\"'portal/friendly fire');});\ntest('familiar escape advances without bonus',()=>{const w=newWorld();quiet(w);w.beginFamiliar();run(w,30);if(w.familiarOutcome\"'!=='\"'escaped'||w.roomIndex\"'!==1||w.currentMultiplier!==1)throw Error('\"'escape failed '+w.phase);});\ntest('familiar catch and Wizard bonus apply only to following room',()=>{const w=newWorld();quiet(w);w.currentMultiplier=2;w.beginFamiliar();w.catchFamiliar(w.players[0]);if(w.score\"'!==2000||w.currentMultiplier!==2||w.earnedNextMultiplier!==2)throw Error('\"'wrong current award');w.phase='Clear';w.descend();if(w.currentMultiplier\"'!==2||w.earnedNextMultiplier!==1)throw Error('\"'carry not consumed');});\ntest('Wizard attempt can fail without trapping campaign',()=>{const w=newWorld();w.loadRoom(1);quiet(w);w.afterFamiliar();run(w,25);if(\"'!w.wizardFailed&&w.roomIndex===1)throw Error('\"'wizard never departed');});\ntest('damage removes owned bolt and protects safe respawn',()=>{const w=newWorld();quiet(w);const p=w.players[0];p.protect=0;w.fire(p);w.damage(p);if(p.alive||p.lives\"'!==2||p.bolt)throw Error('\"'death ownership');run(w,1.1);if(\"'!p.alive||p.protect<=0)throw Error('\"'respawn missing');if(w.damage(p)||p.lives\"'!==2)throw Error('\"'protection failed');});\ntest('fallen co-op seat waits and returns after partner clears',()=>{const w=newWorld({seats:[0,1]});quiet(w);const p=w.players[0];p.lives=1;p.protect=0;w.damage(p);if(w.status\"'!=='\"'playing')throw Error('premature team defeat');w.phase='Clear';w.descend();if(p.lives\"'!==1||!p.alive)throw Error('\"'partner not returned');});\ntest('team defeat and atomic complete retry marked Practice',()=>{const w=newWorld({seats:[0,1]});const entry=JSON.stringify(w.entry);for(const p of w.players){p.lives=1;p.protect=0;w.damage(p);}if(w.status\"'!=='\"'defeat')throw Error('no team defeat');w.score=999;w.rngState=12;w.retry();if(w.status\"'!=='\"'playing'||\"'!w.practice||w.score!==0||w.rngState!==1972||w.phase!=='\"'Entry'||JSON.stringify(w.entry)\"'!==entry||w.players.some(p=>p.lives!==3))throw Error('\"'checkpoint incomplete');});\ntest('full checkpoint restores moving actors and simulation RNG',()=>{const a=newWorld();quiet(a);run(a,.11,{0:{move:0,aim:0,fire:true}});const b=newWorld();b.restore(a.export());run(a,1);run(b,1);if(JSON.stringify(a.export())\"'!==JSON.stringify(b.export()))throw Error('\"'checkpoint diverged');});\ntest('final bounty earned multiplier once, no retroactive score',()=>{const w=newWorld();w.loadRoom(5);quiet(w);w.score=7000;w.currentMultiplier=2;w.earnedNextMultiplier=4;w.phase='Clear';w.descend();w.descend();if(w.status\"'!=='\"'victory'||w.score\"'!==27000)throw Error('\"'bounty double or retroactive');});\ntest('blocked/corrupt versioned storage and record eligibility',()=>{const storage={getItem(){return'{bad'},setItem(){throw Error('blocked');}};const v=new I.Vault(storage),w=newWorld();v.save(w);if(\"'!v.data.checkpoint)throw Error('\"'no memory fallback');w.status='victory';if(\"'!v.record(w))throw Error('\"'ranked rejected');w.practice=true;if(v.record(w))throw Error('practice ranked');w.config.context='hub';w.practice=false;if(v.record(w))throw Error('hub persisted');const b=new I.Vault({getItem:()=>JSON.stringify(v.data)});if(b.data.v\"'!==1)throw Error('\"'schema');});\ntest('network command validation and stale/sender rejection',()=>{const w=newWorld({seats:[0,1]}),app={world:w,game:{real:5},controls:{clear(){}},audio:{stop(){}}},hub={active:true,isHost:true,host:0};const n=new I.Network(app,hub);n.seats=[0,1];n.receive({v:1,type:'input',seq:2,cmd:{move:0,aim:1,fire:true}},1);n.receive({v:1,type:'input',seq:1,cmd:{move:2,aim:1,fire:false}},1);n.receive({v:1,type:'input',seq:5,cmd:{move:3,aim:1,fire:false}},99);if(n.pending[1]?.move\"'!==0||n.pending[99])throw Error('\"'authority validation');if(n.valid({move:99,aim:1,fire:true})||n.valid({move:0,aim:0,fire:'yes'}))throw Error('malformed command accepted');});\n// Honest command-only campaign: bell and paired gate demonstration are ordinary movement/fire sequences.\nfunction campaign(seed,difficulty,seats=[0]){const w=newWorld({seed,difficulty,seats});const visited=new Set(),phases=new Set(),durations=[],steps=[];let oldRoom=0,roomStart=0,tutorial=0;\n for(let k=0;k<120*1250&&w.status==='playing';k++){\n if(w.roomIndex\"'!==oldRoom){durations.push(w.elapsed-roomStart);roomStart=w.elapsed;oldRoom=w.roomIndex;}\n visited.add(w.roomIndex);phases.add(w.phase);let cmds=Object.fromEntries(w.players.map(p=>[p.seat,I.bot(w,p)]));\n if(w.roomIndex===2&&tutorial<300){const p=w.players[0];if(tutorial<30)cmds[p.seat]={move:0,aim:3,fire:false};else if(tutorial<58)cmds[p.seat]={move:-1,aim:3,fire:true};else if(tutorial<88)cmds[p.seat]={move:2,aim:3,fire:false};else if(tutorial<238)cmds[p.seat]={move:3,aim:3,fire:false};else if(tutorial<270)cmds[p.seat]={move:2,aim:2,fire:false};else cmds[p.seat]={move:2,aim:2,fire:false};tutorial++;}\n w.step(1/120,cmds);\n if(k%120===0){for(const p of w.players){if(w.bolts.filter(b=>!b.dead&&b.owner===p.id).length>1)throw Error('\"'ownership violated in campaign');}if(w.radar().hunters.some(e=>e.kind==='wizard'))throw Error('wizard radar');}\n }\n durations.push(w.elapsed-roomStart);return{world:w,evidence:{seed,difficulty,seats,status:w.status,seconds:w.elapsed,score:w.score,kills:w.totalKills,deaths:w.deaths,bells:w.bells,portals:w.portals,familiars:w.familiars,banishments:w.banishments,rooms:[...visited],phases:[...phases],roomSeconds:durations}};}\nfor(const [seed,diff,seats] of [[1972,'Normal',[0]],[1982,'Gentle',[0]],[7,'Fierce',[0,1]]])test(\"'`ordinary-input campaign ${diff} ${seats.length} seat(s)`,()=>{const c=campaign(seed,diff,seats);evidence.campaigns??=[];evidence.campaigns.push(c.evidence);if(c.world.status!=='\"'victory'||c.evidence.rooms.length\"'!==6||c.world.banishments!==5||c.world.bells<1||c.world.portals<1)throw Error(JSON.stringify(c.evidence));});\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"cat > tests/hub-first.py <<'PY'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nimport json\nr=Path.cwd();name=r.name+'.html'\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True)\n q=b.new_page(viewport={'width':1400,'height':900})\n errors=[];q.on('pageerror',lambda e:errors.append(str(e)))\n url='http://127.0.0.1:40563/harness.html?game='+name+'&players=2&latency=150&jitter=50&loss=5&limit=12&auto=1'\n q.goto(url)\n try:q.wait_for_function('document.body.dataset.complete === \\\"true\\\"',timeout=100000)\n except Exception as e:print('TIMEOUT',str(e))\n out={'errors':errors,'check':q.evaluate('window.__hubCheck'),'frames':[]}\n for f in q.frames[1:]:\n  try:out['frames'].append(f.evaluate('({title:document.title,snap:window.__game?.debug.snapshot()})'))\n  except Exception as e:out['frames'].append(str(e))\n (r/'evidence/hub-first.json').write_text(json.dumps(out,indent=2))\n print(json.dumps({'errors':errors,'check':out['check'],'frames':[{'title':f.get('title'),'network':f.get('snap',{}).get('network'),'errors':f.get('snap',{}).get('errors')} for f in out['frames'] if isinstance(f,dict)]}))\n b.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/hub-first.py\"","aggregated_output":"{\"errors\": [], \"check\": {\"done\": true, \"pass\": true, \"game\": \"The-Incurable-Wizard-The-Incredible-Wizard-gpt-6.1-sol-max-20261106-022835.html\", \"players\": 2, \"scenario\": \"standard\", \"checks\": [{\"name\": \"head metas\", \"pass\": true, \"detail\": \"hub:session=1 mode=shared-world\"}, {\"name\": \"hub:session-players is a range within 1\\u20134\", \"pass\": true, \"detail\": \"hub:session-players=1-2\"}, {\"name\": \"hub:session-minutes, when given, is a number\", \"pass\": true, \"detail\": \"hub:session-minutes=12\"}, {\"name\": \"every copy says hello\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"hello names protocol 1 and the mode\", \"pass\": true, \"detail\": \"{\\\"v\\\":1,\\\"client\\\":\\\"1.4.0\\\",\\\"mode\\\":\\\"shared-world\\\",\\\"seats\\\":[1,2],\\\"card\\\":false}\"}, {\"name\": \"hello seats cover this player count\", \"pass\": true, \"detail\": \"[1,2]\"}, {\"name\": \"ready without a key press (the card asks the players)\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"the round starts when the card ends\", \"pass\": true, \"detail\": \"countdown\"}, {\"name\": \"game traffic flows both ways\", \"pass\": true, \"detail\": \"p0 \\u219148 \\u219368 p1 \\u219171 \\u219346\"}, {\"name\": \"the round ends with a valid result\", \"pass\": true, \"detail\": \"played (finished)\"}, {\"name\": \"every remaining copy is told the round ended\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"no protocol problems\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"no errors, dialogs, popups or sockets\", \"pass\": true, \"detail\": \"\"}], \"log\": [\"   0.08  round 1: 2 players, seed 3412932837, limit 12 s, mode shared-world\", \"   0.33  p0 \\u2192 hub: hello\", \"   0.40  p1 \\u2192 hub: hello\", \"   0.53  hub \\u2192 p0: welcome\", \"   0.76  hub \\u2192 p1: welcome\", \"   1.03  p0 \\u2192 hub: ready\", \"   1.16  p1 \\u2192 hub: ready\", \"   1.29  splash over: the round starts once every game has loaded\", \"   1.46  hub \\u2192 p1: start in 2831 ms\", \"   1.50  hub \\u2192 p0: start in 2792 ms\", \"   9.38  hub \\u2192 p0: time-up\", \"   9.43  hub \\u2192 p1: time-up\", \"   9.67  p0 \\u2192 hub: finish [[0,1]]\", \"   9.67  round 1 played: finished \\u2014 standings [[0,1]]\", \"   9.87  hub \\u2192 p1: end finished\", \"   9.87  hub \\u2192 p0: end finished\", \"  10.11  conformance: PASS\"]}, \"frames\": [{\"title\": \"The Incurable Wizard\", \"network\": {\"active\": true, \"started\": false, \"ended\": true, \"finished\": true, \"sent\": 55, \"maxBytes\": 4364}, \"errors\": []}, {\"title\": \"The Incurable Wizard\", \"network\": {