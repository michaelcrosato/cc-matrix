{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='tests/core.mjs';s=open(p).read();idx=s.rfind('\\\\n}')\ns=s[:idx]+'''\n  test('simultaneous allied shots resolve one enemy once',()=>{const w=newWorld({seats:[0,1]});quiet(w);const[a,b]=w.players;a.m.place(1,11);b.m.place(7,11);a.aim=0;b.aim=2;w.spawn('hopper',[4,11]).warning=0;w.fire(a);w.fire(b);run(w,.4);if(w.score\"'!==150||w.totalKills!==1)throw Error('\"'duplicate team award');});\n  test('second Wizard manifestation alternates axes with safe gaps',()=>{const w=newWorld();quiet(w);w.wizard={id:99,x:10,y:6,stage:1};w.lightning();const first=w.events.at(-1).dirs;w.lightning();const second=w.events.at(-1).dirs;if(first.join(',')\"'!=='\"'0,2'||second.join(',')\"'!=='\"'1,3')throw Error('no alternating cross lanes');});\n  test('structurally corrupt checkpoint is rejected before simulation',()=>{const w=newWorld(),bad=w.export();bad.enemies='broken';let rejected=false;try{w.restore(bad);}catch{rejected=true;}if(\"'!rejected)throw Error('\"'corrupt checkpoint accepted');});\n  test('packet rejection repairs through the following full snapshot',()=>{const w=newWorld({seats:[0,1]}),sent=[],app={world:w,game:{real:0},controls:{clear(){}},audio:{stop(){}}},hub={active:true,isHost:true,me:0,host:0,time:()=>1,send(d){sent.push(d);return sent.length>1;},finish(){}};const n=new I.Network(app,hub);n.active=true;n.started=true;n.seats=[0,1];n.step(.1,neutral);n.step(.1,neutral);if(sent.length\"'!==2||sent[1].state.tick<=sent[0].state.tick||sent[1].state.players.length!==2)throw Error('\"'snapshot repair failed');const client=new I.Network({world:newWorld(),game:{real:0}},{active:true,isHost:false,host:0});client.receive(sent[1],99);if(client.lastSnap\"'!==-1)throw Error('\"'forged snapshot accepted');client.receive(sent[1],0);if(client.lastSnap\"'!==sent[1].tick)throw Error('\"'repair not applied');client.receive(sent[0],0);if(client.lastSnap\"'!==sent[1].tick)throw Error('\"'stale snapshot applied');});\n  test('full native Game advances ordinary commands to results, credits and replay',()=>{const c=load(true),g=c.__game,app=c.IW.app;g.advance(.01);app.begin('Normal',[0],'campaign',1972);g.advance(.01);app.controls.sample=(w,p)=>c.IW.bot(w,p);for(let k=0;k<1200&&app.world.status==='playing';k++)g.advance(1);if(app.world.status\"'!=='\"'victory'||app.ui.screen\"'!=='\"'results'||g.errors.length)throw Error('integrated ending '+JSON.stringify(g.errors));if(app.world.practice)throw Error('honest run marked Practice');app.credits(0);if(app.ui.screen\"'!=='\"'credits')throw Error('credits unreachable');app.ui.back();const top=app.ui._stack.at(-1);const replay=top.s.actions.find(a=>a[0]==='New run');if(\"'!replay)throw Error('\"'no replay');replay[1]();g.advance(.01);if(app.world.roomIndex\"'!==0||app.world.status!=='\"'playing'||app.world.score\"'!==0)throw Error('\"'replay not clean');g.dispose();});\n''' +s[idx:];open(p,'w').write(s)\nPY\nbiome check --write src tools tests/*.mjs > evidence/format.txt 2>&1\nnode tools/verify.mjs --core\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
