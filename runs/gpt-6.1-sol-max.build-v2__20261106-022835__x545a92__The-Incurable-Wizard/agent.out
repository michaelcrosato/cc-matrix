us(168,104,0);this.area=area;this.radar=wide?{x:g.W-140,y:76,w:120,h:74}:{x:g.W/2-85,y:area.y+area.h+28,w:170,h:100};return area;}\n build(room){this.room=room.id;this.map=new E.TileMap({rows:room.rows,legend:{'#':1},types:{1:{h:7,top:room.wall,side:E.shade(room.wall,-.28),face:'stone',roof:'slab',line:'#2b2336'}},outside:false,ao:2,floorTex:(x,y)=>E.tex.flagstone(x,y,{stones:[room.floor,E.shade(room.floor,.045)].map(E.hex),mortar:E.hex(E.shade(room.floor,-.3)),hi:E.hex(E.shade(room.floor,.10)),lo:E.hex(E.shade(room.floor,-.06)),speck:E.hex(E.shade(room.floor,.015))})});}\n update(w,dt){if(\"'!w)return;if(this.room!==w.roomIndex)this.build(w.room);for(const p of w.players){let rig=this.rigs.get(p.id);if(!rig){rig=I.makeWarden(p.seat);this.rigs.set(p.id,rig);}rig.armed=!p.bolt;rig.update(dt,{x:I.world(p.m.x),y:I.world(p.m.y),z:0,vx:p.m.moving?p.m.dir[0]*40:0,vy:p.m.moving?p.m.dir[1]*40:0,facing:p.aim*Math.PI/2,point:true,hurt:!p.alive,pose:w.status==='\"'victory'?'cheer':\"'!p.alive?'\"'die':undefined,expr:w.status==='victory'?'smile':undefined});}\n for(const e of[...w.enemies,...(w.familiar?[w.familiar]:[])]){let rig=this.rigs.get(e.id);if(\"'!rig){rig=I.makeHunter(e.kind);this.rigs.set(e.id,rig);}rig.update(dt,{walk:e.m.moving?1:0,flap:e.kind==='\"'familiar'?1:0,squash:e.state==='anticipate'?-.2:e.kind==='hopper'?Math.sin(e.age*10)*.08:0,look:e.m.dir,squint:e.state==='pursue'});}\n if(w.wizard){const z=w.wizard;this.wizard.update(dt,{x:I.world(z.x),y:I.world(z.y),facing:Math.PI/2,pose:z.state==='banished'?'die':'cast',expr:'angry',attack:E.move('cast',(w.phaseTime%1.6)/1.6)});}\n for(const e of w.events){if(e.id<=this.seenEvent)continue;this.seenEvent=e.id;if(e.type==='banish'&&\"'!this.game.reduceMotion)this.game.shake(4);if(['\"'kill','catch','banish','bell','hurt','portal'].includes(e.type)&&e.x\"'!==undefined)this.pulses.push({...e,t:0});}\n this.pulses=this.pulses.filter(p=>(p.t+=dt)<1.2);if(this.rigs.size>180)this.rigs.clear();}\n drawTitle(r,t){r.sky(['\"'#100e21','#22182f','#171426']);r.overlay(g=>{for(let i=0;i<100;i++){const x=(i*67+11)%r.W,y=(i*79+9)%r.H,blink=.3+.7*Math.sin(t*.8+i);px.dot(g,x,y,blink>.75?'#89738d':'#3b304d');}const cx=r.W*.74,cy=r.H*.67;for(let i=7;i>0;i--)px.ell(g,cx,cy,38+i*11,8+i*3,['#1b162a','#211b30','#282036','#33243e','#3e2b48','#563751','#794b64'][7-i]);for(let j=0;j<12;j++){const a=j*Math.PI/6+t*.05;px.line(g,cx+Math.cos(a)*101,cy+Math.sin(a)*31,cx+Math.cos(a)*109,cy+Math.sin(a)*34,'#bd8c62',2);}});\n const x=220,y=110;r.actor(x,y,0,(g,ox,oy)=>{this.titleWizard.draw(g,ox,oy,r.view);});this.titleWizard.update(1/120,{x,y,pose:'cast',facing:Math.PI/2,expr:'angry'});\n // Native mural framed beside the shell's title actions.\n r.overlay(g=>{const x=r.W*.74,y=r.H*.33;E.font.title(g,'WANTED',x,y-53,{scale:1,colors:['#d5b27a','#947d68'],align:'center'});E.font.text(g,'ALIVE. AGAIN.',x,r.H*.88,'#a995aa',{align:'center',outline:false});});\n this.game.lights.enabled=true;this.game.lights.ambient=.65;this.game.lights.add(x,y,20,100,.6,{color:'#bf7c92'});\n }\n draw(r,w,opts={}){if(\"'!w)return this.drawTitle(r,this.game.time);if(this.room!==w.roomIndex)this.build(w.room);r.sky(['\"'#100f1b','#161323','#100f1b']);const room=w.room,win=w.status==='victory';this.game.lights.enabled=true;this.game.lights.ambient=win?.88:.67;\n this.map.drawFloor(r);this.map.queueWalls(r);\n r.decal(g=>{for(let y=1;y<12;y++)for(let x=1;x<20;x++){if(\"'!w.walk(x,y))continue;if((x+y*3)%13===0){const [sx,sy]=r.w(I.world(x),I.world(y),.1);px.line(g,sx-2,sy,sx+2,sy,win?'\"'#5b8d84':'#58435f');px.dot(g,sx,sy-2,win?'#8ec6a0':'#947256');}}});\n for(const x of[0,20]){r.shape('wardPortal',I.world(x),I.world(6),0,{scale:.68,facing:x===0?Math.PI/2:-Math.PI/2,hides:false,shadow:false});r.queue(I.world(x),I.world(6),3,g=>{const[sx,sy]=r.w(I.world(x),I.world(6),3);px.blend(g,.6,'add',()=>{px.ell(g,sx,sy-6,3+Math.sin(w.elapsed*3),8,win?'#b4e5c0':'#72b4b8');});},{emissive:true});this.game.lights.add(I.world(x),I.world(6),8,32,.6,{color:win?'#b6e1ae':'#7abfd0'});}\n for(const p of w.posts){r.shape('wardBell',I.world(p.x),I.world(p.y),0,{scale:.65,facing:Math.sin(p.ring*40)*p.ring*.08,hides:false});if(p.ring>0)r.decal(g=>{const a=r.groundPts(I.world(p.x),I.world(p.y),w.tuning.bellRevealRadius*16,32,0);px.polyDither(g,a,'#ecc886',.08+p.ring*.05,r.ix,r.iy);});r.queue(I.world(p.x),I.world(p.y),15,g=>{const[x,y]=r.w(I.world(p.x),I.world(p.y),15);px.disc(g,x,y,1.5,p.cool>0?'#645c63':'#ffdd83');if(p.cool>0)px.rect(g,x-4,y+2,8*(1-p.cool/w.tuning.bellCooldown),1,'#d2b772');},{emissive:true});}\n for(const[x,y]of[[1,1],[19,1],[1,11],[19,11]]){r.prop('candle',I.world(x)-5,I.world(y)-6,0,{size:.6,light:true});}\n if(opts.grid)r.decal(g=>{for(let x=0;x<=21;x++){const a=r.w(x*16,0,0),b=r.w(x*16,208,0);px.line(g,...a,...b,'#5e5367');}for(let y=0;y<=13;y++){const a=r.w(0,y*16,0),b=r.w(336,y*16,0);px.line(g,...a,...b,'#5e5367');}});\n for(const e of w.enemies){const x=I.world(e.m.x),y=I.world(e.m.y);if(e.warning>0){r.decal(g=>{const [sx,sy]=r.w(x,y,0),rad=4+Math.sin(w.elapsed*12);px.ell(g,sx,sy,rad,rad*.5,'#da9971');px.line(g,sx-4,sy,sx+4,sy,'#f0c7a0');});continue;}\n if(\"'!w.visible(e))continue;const rig=this.rigs.get(e.id);r.shadow(x,y,4,.25);r.actor(x,y,e.kind==='\"'hopper'?Math.max(0,Math.sin(e.age*9))*2:0,(g,ox,oy)=>{rig?.draw(g,ox,oy,r.view);if(e.kind==='skitter'){px.line(g,ox-6,oy-2,ox-10,oy-5,'#f3acb6');px.line(g,ox+6,oy-2,ox+10,oy-5,'#f3acb6');}if(e.lure>0)px.dot(g,ox,oy-14,'#ffe0a1');});}\n if(w.familiar){const f=w.familiar,rig=this.rigs.get(f.id);r.shadow(I.world(f.m.x),I.world(f.m.y),4,.2);r.actor(I.world(f.m.x),I.world(f.m.y),7+Math.sin(w.elapsed*9),(g,x,y)=>rig?.draw(g,x,y,r.view));}\n if(w.wizard){const z=w.wizard,x=I.world(z.x),y=I.world(z.y);if(z.state==='warning'){r.decal(g=>{const [sx,sy]=r.w(x,y,0);const rad=8+Math.sin(w.elapsed*16)*1.5;const pts=Array.from({length:6},(_,i)=>[sx+Math.cos(i*Math.PI/3)*rad,sy+Math.sin(i*Math.PI/3)*rad*.6]);for(let i=0;i<6;i++)px.line(g,...pts[i],...pts[(i+2)%6],'#f38fa5');});}else if(z.state\"'!=='\"'waiting'){r.shadow(x,y,7,.35);r.actor(x,y,1,(g,ox,oy)=>this.wizard.draw(g,ox,oy,r.view),{alpha:z.state==='banished'?Math.max(0,z.t/1.5):1});if(z.state==='active')this.game.lights.add(x,y,20,38,.55,{color:'#d870ac'});}}\n for(const p of w.players){const x=I.world(p.m.x),y=I.world(p.m.y),rig=this.rigs.get(p.id);if(\"'!p.alive&&p.respawn<=0)continue;r.shadow(x,y,4,.4);r.actor(x,y,0,(g,ox,oy)=>rig?.draw(g,ox,oy,r.view),{alpha:p.protect>0?.7+Math.sin(w.elapsed*16)*.2:1});this.game.lights.add(x,y,10,26,.35,{color:p.seat%2?'\"'#97c9d2':'#f1bd7d'});\n if(p.alive)r.decal(g=>{const d=I.DIRS[p.aim],a=r.w(x+d[0]*8,y+d[1]*8,1),b=r.w(x+d[0]*12,y+d[1]*12,1);px.line(g,...a,...b,p.bolt?'#756776':p.seat%2?'#b6e8f1':'#fbe0a1',2);const[sx,sy]=r.w(x,y,0);px.line(g,sx-4,sy+4,sx+4,sy+4,p.seat%2?'#8fceda':'#eac384');});}\n w.pool.draw(r);\n for(const p of this.pulses){r.queue(p.x,p.y,4,g=>{const[x,y]=r.w(p.x,p.y,4),c=p.type==='hurt'?'#eb8b8e':p.type==='banish'?'#e8b0f5':'#f0ce87',n=p.type==='banish'?24:10;for(let i=0;i<n;i++){const a=i*6.283/n+Math.sin(i)*.3,rad=p.t*(p.type==='banish'?80:30),fade=1-p.t/1.2;px.line(g,x+Math.cos(a)*rad,y+Math.sin(a)*rad*.7,x+Math.cos(a)*(rad+3*fade),y+Math.sin(a)*(rad+3*fade)*.7,c,fade> .5?2:1);}}, {emissive:true});}\n this.hud(r,w,opts);\n }\n hud(r,w,opts){const room=w.room,rad=this.radar||{x:500,y:74,w:120,h:74},wide=r.W/r.H>1.35;\n r.overlay(g=>{E.font.text(g,'THE INCURABLE WIZARD',14,12,'#a18ca9',{outline:false});E.font.text(g,String(w.score).padStart(7,'0'),r.W-158,11,'#f9dc9d',{scale:2,outline:false,shadow:'#100d18'});E.font.text(g,\"'`${w.roomIndex+1} / 6  ${room.name.toUpperCase()}`,14,28,'\"'#f1ddbe',{outline:false});\n E.ui.box(g,rad.x-6,rad.y-22,rad.w+12,rad.h+35,{bg:'#151c28',border:'#6b6773',alpha:.96});E.font.text(g,'ECHO RADAR',rad.x,rad.y-16,'#9bcac6',{outline:false});for(let j=1;j<4;j++)px.line(g,rad.x,rad.y+rad.h*j/4,rad.x+rad.w,rad.y+rad.h*j/4,'#273944');const sweep=(w.elapsed*.3%1)*rad.w;px.rect(g,rad.x+sweep,rad.y,1,rad.h,'#43726e');\n const radar=w.radar(),at=(x,y)=>[rad.x+x/20*rad.w,rad.y+y/12*rad.h];for(const e of radar.hunters){const[x,y]=at(e.x,e.y),c=I.FAMILIES[e.kind].color;if(e.kind==='hopper')px.disc(g,x,y,1.5,c);else if(e.kind==='stalker')px.poly(g,[[x,y-2],[x+2,y],[x,y+2],[x-2,y]],c);else{const n=2+Math.sin(w.elapsed*10)*.6;px.line(g,x-n,y-n,x+n,y+n,c);px.line(g,x+n,y-n,x-n,y+n,c);}}\n for(const p of radar.players){const[x,y]=at(p.x,p.y);px.rect(g,x-2,y-2,4,4,p.seat%2?'#a6dcf4':'#ffe0a6');px.dot(g,x,y,'#172532');}\n const x=wide?rad.x-4:14,y=wide?rad.y+rad.h+30:r.H-96;E.font.text(g,w.phase.toUpperCase(),x,y,w.phase==='Intrusion'?'#f299b4':'#d6c5d7',{outline:false});E.font.text(g,\"'`NOW ${w.currentMultiplier}x   NEXT ${w.earnedNextMultiplier}x`,x,y+17,'\"'#edd09c',{outline:false});\n if(w.phase==='Hunt'){const n=w.enemies.length+w.queue.filter(s=>\"'!s.done).length;E.font.text(g,`${n} HUNTERS LEFT`,x,y+34,'\"'#a996b5',{outline:false});}\n if(w.phase==='Familiar')E.font.text(g,w.familiar?.exit===0?'COVER LEFT GATE':'COVER RIGHT GATE',x,y+34,'#e0b4ed',{outline:false});if(w.phase==='Intrusion')E.font.text(g,\"'`BOAST ${w.manifest+1} / ${room.intrusions}`,x,y+34,'\"'#dba1be',{outline:false});\n const ly=wide?r.H-42:r.H-62;for(let i=0;i<w.players.length;i++){const p=w.players[i],lx=14+i*200,c=p.seat%2?'#9ed6f0':'#edcd93';E.font.text(g,\"'`P${i+1}`,lx,ly,c,{outline:false});for(let j=0;j<Math.max(p.lives,1);j++)E.font.text(g,p.lives<=0?'\"'x':'♥',lx+23+j*11,ly,p.lives<=0?'#6b5e75':c,{outline:false});E.font.text(g,p.alive?(p.bolt?'BOLT AWAY':'RIFLE READY'):'WATCHING',lx,ly+14,p.bolt?'#9c8ba4':c,{outline:false});}\n const prompt=opts.demo?'DEMONSTRATION — ANY INPUT RETURNS':w.practice?'PRACTICE — records disabled':this.game.input.lastDevice==='touch'?'Left thumb moves  •  Right thumb aims & fires':this.game.input.lastDevice==='gamepad'?\"'`${this.game.input.label('\"'fire')} Fire  •  Options Pause\"'`:'\"'WASD Move  •  Mouse / arrows Aim  •  Space Fire';E.font.text(g,prompt,r.W/2,r.H-10,'#9b8ea5',{outline:false,align:'center'});\n let notice='';if(w.phase==='Entry')notice=room.lesson;else if(w.phase==='Clear')notice=w.roomIndex===5?\"'`THE CURE IS VIOLENCE. EXIT BOUNTY ${5000*w.earnedNextMultiplier}`:`DESCENDING — NEXT CHAMBER ${w.earnedNextMultiplier}x POINTS`;else if(w.phase==='\"'Familiar'&&w.phaseTime<3)notice=room.bounty?'5,000 EXIT BOUNTY — CATCH THE FAMILIAR\"'!'\"':'THE FAMILIAR FLEES\"'! COVER ITS GATE.'\"';else if(w.phase==='Intrusion'&&w.phaseTime<2)notice='AN UNWELCOME CONSULTATION. WATCH FOR THE RUNE.';\n if(notice){const lines=E.font.wrap(notice,Math.min(r.W-40,470),{});const yy=this.area?this.area.y+this.area.h-16:280;E.ui.box(g,12,yy-6,Math.min(r.W-24,478),lines.length*11+12,{bg:'#201b2b',border:'#806b79',alpha:.9});lines.forEach((s,i)=>E.font.text(g,s,22,yy+i*11,'#f5dfb5',{outline:false}));}\n if(opts.grid)E.font.text(g,\"'`seed ${w.config.seed} / tick ${w.tick} / budget ${w.queue.filter(s=>!s.done).length}`,14,44,'\"'#82d3b7',{outline:false});\n });}\n}\nI.Stage=Stage;\n})(globalThis);\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/art.js'\ns=open(p).read().replace(\\\"px.line(w.g,...a,...b,'#342838',Math.max(2,u*3))\\\",\\\"px.line(w.g,a[0],a[1],b[0],b[1],'#342838',Math.max(2,u*3))\\\")\nopen(p,'w').write(s)\np='src/sim.js';s=open(p).read().replace('rand(){let x=this.rngState;', 'rand(){if(this.externalRng)return this.externalRng();let x=this.rngState;')\ns=s.replace(\\\"this.emit('fire',{owner:p.id,x:b.x,y:b.y});return true;\\\", \\\"this.emit('fire',{owner:p.id,x:b.x,y:b.y});for(const e of this.enemies)if(e.lure<=0&&Math.hypot(e.m.x-p.m.x,e.m.y-p.m.y)<7){e.target=[Math.round(p.m.x),Math.round(p.m.y)];e.memory=3;e.state='listen';}return true;\\\")\nopen(p,'w').write(s)\nPY\ncat > tools/build.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nconst dir=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');\nconst name=path.basename(dir)+'.html';\nconst read=f=>fs.readFileSync(path.join(dir,f),'utf8');\nconst client=read('vendor/session.js');\nif(/<\\\\/script/i.test(client))throw Error('Hub client cannot be safely byte-preserved inline');\nlet html=read('index.template.html');\nhtml=html.replace('<\"'!--HUB-->'\"',\"'`<script>${client}</script>`);\nconst src=['\"'vendor/my-3d2dge.js','src/content.js','src/sim.js','src/platform.js','src/audio.js','src/art.js','src/main.js'];\nhtml=html.replace('<\"'!--GAME-->'\"',src.map(f=>\"'`<script>'\"\\\\n\"'${read(f).replace(/<'\"\\\\/script/gi,'<\\\\\\\\/script')}\\\\n</script>\"'`).join('\"'\\\\n'));\nconst interview=JSON.parse(fs.readFileSync(path.join(dir,'interview.json'),'utf8'));\nhtml=html.replace('/*INTERVIEW*/',JSON.stringify(interview).replace(/</g,'\\\\\\\\u003c'));\nfs.writeFileSync(path.join(dir,name),html);fs.writeFileSync(path.join(dir,'..',name),html);\nfs.copyFileSync(path.join(dir,'interview.json'),path.join(dir,'..','exit-interview.json'));\nif(process.argv.includes('--report'))console.log(name+' ('+Buffer.byteLength(html)+' bytes)');\nEOF\ncat > index.template.html <<'EOF'\n<\"'!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><!--HUB-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-2\"><meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Clear six chambers, intercept the familiar, and banish all three final manifestations. Share a team score.\">\n<meta name=\"hub:session-howto\" content=\"Left stick / WASD move. Right stick / arrows / mouse aim. R2 / Cross / Space / click fire. Options / Escape pause. Touch: left thumb move, right thumb aim and fire.\">\n<meta name=\"hub:session-minutes\" content=\"12\"><meta name=\"description\" content=\"The Incurable Wizard. One bolt. Six floors. No known cure.\">\n<title>The Incurable Wizard</title>\n<style>\n:root{color-scheme:dark}*{box-sizing:border-box}html,body{margin:0;overflow:hidden;width:100%;height:100%;background:#100e1c}canvas#screen{display:block;width:100%;height:100%;image-rendering:pixelated;touch-action:none}.esh{--ink:#f2dfbd!important;--paper:#211b2e!important;--accent:#e9bc7d!important;--muted:#b2a0b8!important;--line:#67526e!important;font-family:Georgia,serif!important}.esh .esh-sh{background:rgba(10,8,19,.67);backdrop-filter:blur(3px)}.esh .esh-pan{box-shadow:0 12px 60px #08071099;border:1px solid #755d79!important;background:linear-gradient(145deg,#292035f7,#191928fc)!important}.esh h1,.esh h2{font-family:Georgia,serif;letter-spacing:-.035em}.esh h2{color:#f4dcac}.esh button{border-radius:3px!important;min-height:38px;transition:background .1s}.esh button:hover{background:#57435f!important}.esh button:focus{outline:2px solid #e3c48e!important;outline-offset:3px}.esh .esh-btns{gap:9px}.esh .esh-ttl{background:linear-gradient(90deg,#120f21ed,transparent 77%);backdrop-filter:none;justify-content:flex-start!important;padding-left:6vw!important}.esh .esh-ttl>div{width:45%;max-width:450px}.esh .esh-ttl h1{font-size:3.2em;line-height:.94;text-shadow:0 3px #523c56;color:#f6dfb4;max-width:420px;margin:0 0 18px}.esh .esh-ttl .esh-sub{font-size:1.04em;line-height:1.4;color:#c5a9b9;max-width:330px}.esh .esh-ttl .esh-k{letter-spacing:.23em}.esh .esh-ttl .esh-btns{display:flex!important;flex-direction:column;max-width:270px;margin-top:24px}.esh .esh-ttl button{font-family:Georgia,serif;font-size:1.05em;text-align:left;padding:10px 18px;background:#282134c9;border-color:#5a475f}.esh .esh-ttl button.pri{color:#241c2a;background:#e8c38a;border-color:#f4d7a6}.esh .esh-ttl .esh-tags{margin-top:18px}.esh .esh-mod{max-height:84vh!important;max-width:650px!important}.esh .esh-m{line-height:1.5;white-space:pre-line}.esh .esh-row small{font-size:.7em}.esh .esh-emb{font-family:Georgia,serif;color:#e3c48e}.esh .esh-nav{z-index:3}.esh .esh-stats b{color:#eac58f}.esh .esh-stats small{color:#bba8c4}#caption{position:fixed;left:0;bottom:0;pointer-events:none;visibility:hidden}\n@media(max-aspect-ratio:1/1){.esh .esh-ttl>div{width:89%;max-width:440px}.esh .esh-ttl{background:#151123df;padding-left:7vw!important}.esh .esh-ttl h1{font-size:2.8em}.esh .esh-ttl .esh-btns{max-width:100%;margin-top:18px}.esh .esh-mod{max-width:94vw!important}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important}}\n</style></head><body><canvas id=\"screen\" aria-label=\"The Incurable Wizard game arena\"></canvas><script>globalThis.INCURABLE_INTERVIEW=/*INTERVIEW*/;</script><!--GAME--></body></html>\nEOF\ncat > src/main.js <<'\"'EOF'\n/* Adapted from the full ARCADE kit's scene, fixed-step, grid and cabinet patterns.\n   Simultaneous seats, campaign and encounter rules are original game systems. */\n(function(root){'use strict';const E=root.My3D2dge,I=root.IW,online=\"'!!root.AIHub?.active;\nconst game=new E.Game({id:'\"'the-incurable-wizard',canvas:'screen',res:[640,360],expand:true,view:'topdown',views:['topdown'],input:I.PRESET,bg:'#100e1c',fullscreen:'button',autoPause:\"'!online,live:online,menu:{quit:online?false:'\"'title',controls:{moveUp:'Move north',moveDown:'Move south',moveLeft:'Move west',moveRight:'Move east',aimUp:'Aim north',aimDown:'Aim south',aimLeft:'Aim west',aimRight:'Aim east',fire:'Lantern rifle',up:false,down:false,left:false,right:false},settings:[{key:'music',value:.1},{key:'glyphs',value:'playstation'},{key:'voices',group:'Sound',label:'Wizard gibberish',type:'slider',value:.7,apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},{key:'assistance',group:'Game',label:'Touch auto-fire',type:'toggle',value:true,help:'Only fires at a visible target in a clear cardinal lane. Separate score category.'},{key:'contrast',group:'Comfort',label:'Radar contrast',type:'toggle',value:true}]}});\nlet storage;try{storage=root.localStorage;}catch{}const vault=new I.Vault(storage);\nconst app=I.app={game,world:null,vault,controls:new I.Controls(game),stage:new I.Stage(game),audio:new I.Sound(game),demo:false,idle:0,creditsPage:0,devPage:0,lastSaved:-1,recorded:false,debugGrid:false,resetting:false,coopMode:'keyboard-pad'};app.network=new I.Network(app,root.AIHub);\nconst ui=new E.Shell(game,{tv:true,theme:{ink:'#f0dcbb',paper:'#211c2d',accent:'#e9bf83',muted:'#b8a4bb',line:'#705c79',font:'Georgia, serif',titleFont:'Georgia, serif'},screens:{pause:{kicker:online?'ONLINE — THE DUNGEON CONTINUES':'A MOMENT OF PROFESSIONAL DOUBT',actions:[['Developer',()=>showDev()],['How to play',()=>help(0)],['About / Credits',()=>credits(0)]]}}});\napp.ui=ui;\nfunction clearInputs(){app.controls.clear();game.input.consumeAll();}\nfunction showTitle(){app.demo=false;app.world=null;app.recorded=false;app.idle=0;app.audio.resume();app.audio.lastEvent=0;app.stage.seenEvent=0;app.stage.pulses=[];resetDev();while(game.players.length>1)game.removePlayer(2);game.input.pad='any';game.paused=false;ui.hide();game.go('title',null,{fade:0});}\napp.title=showTitle;\nfunction titleMenu(){ui.show('title',{kicker:'A MENAGERIE OF BAD DECISIONS',name:I.TITLE,subtitle:I.TAGLINE,text:'The sorcerer has a condition.\\\\nYou have a lantern-rifle.',meta:['6 chambers','1–2 wardens','Arcade dungeon'],actions:[['Play',()=>setup(false)],['Couch co-op',()=>coop()],['Settings',()=>game.menu('settings')],['How to play',()=>help(0)],['About / Credits',()=>credits(0)]],footer:()=>game.input.lastDevice==='gamepad'?game.input.label('confirm')+' Choose   '+game.input.label('cancel')+' Back':'Enter Choose  •  Arrows Navigate'});}\nfunction setup(coop){app.seats=coop?[0,1]:[0];ui.show('setup',{kicker:coop?'TWO RIFLES. ONE DUNGEON.':'PLEASE SELECT YOUR DISCOMFORT',title:'Make an appointment',text:'Every bolt stays yours until it hits.\\\\nChoose the pressure. All six floors await.',actions:[['Gentle — 5 lives, longer warnings',()=>app.begin('Gentle',app.seats)],['Normal — 3 lives, intended pressure',()=>app.begin('Normal',app.seats)],['Fierce — 3 lives, sharper company',()=>app.begin('Fierce',app.seats)],...(vault.data.checkpoint?[['Continue saved descent',()=>app.continue()]]:[]),['Back',()=>ui.back()]]});}\nfunction coop(){ui.show('coop',{kicker:'SIMULTANEOUS CO-OP',title:'Bring a second opinion',text:'Wardens pass through each other. Bolts do too.\\\\nScore and radar belong to the team.\\\\nOnline play starts through an AI Hub session.',actions:[['Keyboard + controller',()=>{app.coopMode='keyboard-pad';setup(true);}],['Two controllers',()=>{app.coopMode='pads';setup(true);}],['Shared keyboard',()=>{app.coopMode='keys';setup(true);}],['Back',()=>ui.back()]]});}\nfunction configureSeats(seats,context){while(game.players.length>1)game.removePlayer(2);game.input.pad='any';game.input.use(I.PRESET);if(seats.length>1&&context\"'!=='\"'hub'&&context\"'!=='\"'attract'){\n if(app.coopMode==='keys'){const q=game.addPlayer({keys:'right'});game.input.use(I.PRESET);q.use({...I.PRESET,moveUp:['KeyI'],moveDown:['KeyK'],moveLeft:['KeyJ'],moveRight:['KeyL'],aimUp:['Numpad8'],aimDown:['Numpad2'],aimLeft:['Numpad4'],aimRight:['Numpad6'],fire:['ShiftRight'],up:['KeyI','ArrowUp'],down:['KeyK','ArrowDown'],left:['KeyJ','ArrowLeft'],right:['KeyL','ArrowRight']});game.input.pad=null;}\n else if(app.coopMode==='pads'){game.input.pad=0;game.addPlayer({pad:1});}else{game.input.pad=null;game.addPlayer({pad:0});}}\n clearInputs();}\napp.begin=(difficulty='Normal',seats=[0],context='campaign',seed)=>{if(app.network.active&&context\"'!=='\"'hub')return;resetDev();ui.hide();game.resume();configureSeats(seats,context);app.world=new I.World({difficulty,seats,context,seed:seed||((Date.now()\"'^Math.floor(Math.random()*1e9))>>>0)||1,assistance:game.input.lastDevice==='\"'touch'&&game.settings.assistance});app.demo=context==='attract';app.recorded=false;app.lastSaved=-1;app.audio.resume();app.audio.lastEvent=0;app.stage.seenEvent=0;app.stage.rigs.clear();app.stage.pulses=[];game.go('play',null,{fade:0});};\napp.continue=()=>{if(app.network.active||\"'!vault.data.checkpoint)return;try{const w=new I.World(vault.data.checkpoint.config);w.restore(vault.data.checkpoint);configureSeats(w.config.seats,'\"'campaign');app.world=w;ui.hide();game.resume();app.audio.resume();app.audio.lastEvent=w.eventSeq;app.stage.seenEvent=w.eventSeq;game.go('play',null,{fade:0});}catch{vault.clear();ui.toast('The old seal is broken','Start a new descent.');}};\nconst HELP=[\n ['One bolt is a commitment','Move with the left stick or WASD. Aim with the right stick, arrows, or mouse. Fire with R2 / Cross, Space, or left click. A pale mark shows the selected cardinal lane. The rifle lights again only when your bolt resolves. A nearby wall returns it sooner.'],\n ['Trust the radar','Knobbles hop in plain sight. Broad-jawed Hushjaws and angular Needlekin vanish behind corners. Sharing a clear row or column with either warden reveals them, whichever way you face. The radar always shows their location. It never shows the Wizard.'],\n ['Make a useful noise','Shoot an illuminated brass bell. It consumes your bolt, reveals hunters within 3 cells for 1.25 seconds and lures nearby hunters along legal paths for up to 1.5 seconds. The bell needs 5 seconds to recover. It does nothing to the Wizard.'],\n ['Doors, moths, and multipliers','Wardens and hunters wrap through the paired side gates. Bolts stop there. After the hunt, the winged Ledger Moth flees toward the announced gate. Catch it to double the next chamber. Banish that floor’s Wizard to double again, up to 4x. Final-floor bonuses multiply the 5,000 exit bounty.'],\n ['Your colleague has perished','Each hit costs a life. A returning warden glows safely for 1.25 seconds. An exhausted partner watches, then returns with one life at descent. The third and fourth descents restore a capped life. Retry restores the complete chamber-entry checkpoint and marks the run Practice.'],\n ['Other ways to be brave','Shared keyboard: P1 WASD + arrows + Space; P2 IJKL + numpad 8/4/2/6 + right Shift. Keyboard + controller assigns the pad only to P2. Two controllers use their own seats. Touch: invisible left thumb movement, right thumb aim and fire; visible-target auto-fire is optional in Settings.'],\n ['Online co-operation','AI Hub provides online sessions for 1–2 players. It loads this game directly and owns the round, restart, and results. The host simulates one shared world. Local menus neutralize your controls while the dungeon continues. Create + Options belongs to the Hub. Standalone co-op shares one screen.']\n];\nfunction help(page){const p=(page+HELP.length)%HELP.length;ui.show('help',{kicker:\"'`FIELD NOTES ${p+1} / ${HELP.length}`,title:HELP[p][0],text:HELP[p][1],actions:[['\"'Next note',()=>help(p+1)],['Previous',()=>help(p-1)],['Back',()=>ui.back()]]});}\nfunction credits(page){const data=root.INCURABLE_INTERVIEW||{},s=data.sourceInformation||{},pages=[\n ['Source Information',Object.entries(s).slice(0,7).map(([k,v])=>k+': '+v).join('\\\\n\\\\n')],['Source Information · continued',Object.entries(s).slice(7).map(([k,v])=>k+': '+v).join('\\\\n\\\\n')],\n ['Original work & research','Inspired by The Incredible Wizard (Astrocade, 1982), a licensed Wizard of Wor adaptation. Original title, wardens, hunters, Ledger Moth, bells, maps, score economy, compositions, gibberish and finale made for this game. Native Humanoid / Blob rigs and core candle prop: my-3D2dge.\\\\n\\\\nManual: ballyalley.com/cart_manuals/text_manuals/incredible_wizard.txt\\\\nScan: ballyalley.com/cart_manuals/pdf_manuals/Incredible_Wizard,_The.pdf\\\\nContemporary feature: vgpavilion.com/mags/1982/12/vi/conquering-the-incredible-wizard/\\\\nHardware footage: archive.org/details/IncredibleWizardBallyArcadeAstrocade1982\\\\n\\\\nRead and cross-checked manual scan; article has discrepancies, manual wins. Inspected hardware video frames. No human listening check. Historical AI and exact sound synthesis: unknown.'],\n ['Testing Feedback',(data.testingFeedback||[]).map((v,i)=>(i+1)+'. '+v).join('\\\\n\\\\n')],['Engine Feedback',(data.engineFeedback||[]).slice(0,3).map((v,i)=>(i+1)+'. '+v).join('\\\\n\\\\n')],['Engine Feedback · continued',(data.engineFeedback||[]).slice(3).map((v,i)=>(i+4)+'. '+v).join('\\\\n\\\\n')],['Prompt Feedback',(data.promptFeedback||[]).map((v,i)=>(i+1)+'. '+v).join('\\\\n\\\\n')]\n ];const p=(page+pages.length)%pages.length;ui.show('credits',{kicker:\"'`THE INCURABLE WIZARD · ${p+1} / ${pages.length}`,title:pages[p][0],text:pages[p][1],actions:[['\"'Next page',()=>credits(p+1)],['Previous',()=>credits(p-1)],['Back',()=>ui.back()]]});}\napp.credits=credits;\nconst ranges={playerSpeed:[2,7,.1],boltSpeed:[5,30,.5],fireInterval:[.08,.6,.01],hopperSpeed:[.5,3,.1],stalkerSpeed:[.5,4,.1],skitterSpeed:[1,5,.1],pressureRate:[0,.02,.001],pressureCap:[1,2,.05],spawnSpacing:[.5,8,.1],familiarSpeed:[1,6,.1],wizardInterval:[1.5,6,.1],wizardAttack:[.3,2,.05],wizardWarning:[.5,3,.05],protection:[.5,3,.05],bellRevealRadius:[1,6,.1],bellRevealTime:[.5,3,.05],bellLureRadius:[1,8,.1],bellLureTime:[.3,3,.05],bellCooldown:[2,10,.1],touchAssist:[0,1,.1]};\nfor(const[k,[min,max,step]]of Object.entries(ranges))game.settings.define({key:'dev_'+k,group:'Controls',label:k.replace(/([A-Z])/g,' \"'$1'\"'),type:'slider',value:I.DEFAULTS[k],min,max,step});\nfor(const spec of[{key:'dev_timeScale',label:'Slow motion',type:'slider',value:1,min:.1,max:1,step:.1},{key:'dev_invulnerable',label:'Invulnerable',type:'toggle',value:false},{key:'dev_lives',label:'Lives per warden',type:'slider',value:3,min:1,max:9,step:1},{key:'dev_grid',label:'Grid / collision / radar diagnostics',type:'toggle',value:false}])game.settings.define({...spec,group:'Controls'});\ngame.settings.onChange=k=>{if(k==='assistance'&&app.world&&game.input.lastDevice==='touch'&&game.settings.assistance)app.world.config.assistance=true;if(\"'!k.startsWith('\"'dev_')||app.resetting)return;if(k==='dev_grid'){app.debugGrid=game.settings[k];return;}if(app.network.active)return;const w=app.world;if(\"'!w)return;w.practice=true;const key=k.slice(4),v=game.settings[k];if(key==='\"'timeScale')game.timeScale=v;else if(key==='invulnerable')w.invulnerable=v;else if(key==='lives'){for(const p of w.players){p.lives=v;if(\"'!p.alive)w.respawn(p);}}else w.tuning[key]=v;};\nfunction resetDev(){app.resetting=true;for(const[k,v]of Object.entries(I.DEFAULTS))game.settings.set('\"'dev_'+k,v);game.settings.set('dev_timeScale',1);game.settings.set('dev_invulnerable',false);game.settings.set('dev_lives',3);game.settings.set('dev_grid',false);game.timeScale=1;app.debugGrid=false;if(app.world){app.world.tuning={...I.DEFAULTS};app.world.invulnerable=false;}app.resetting=false;}\nfunction mutate(fn){if(app.network.active||\"'!app.world)return;app.world.practice=true;fn(app.world);clearInputs();showDev(app.devPage);}\nconst devPages=[['\"'Movement & fire',['playerSpeed','boltSpeed','fireInterval']],['Hunter pressure',['hopperSpeed','stalkerSpeed','skitterSpeed','pressureRate','pressureCap','spawnSpacing']],['Familiar & Wizard',['familiarSpeed','wizardInterval','wizardAttack','wizardWarning']],['Bell & respawn',['protection','bellRevealRadius','bellRevealTime','bellLureRadius','bellLureTime','bellCooldown']],['Clock & assistance',['timeScale','invulnerable','lives','touchAssist','grid']]];\nfunction showDev(p=0){app.devPage=(p+devPages.length)%devPages.length;const w=app.world;if(\"'!w)return;const [title,keys]=devPages[app.devPage];ui.show('\"'dev',{kicker:app.network.active?'ONLINE · DIAGNOSTICS ONLY':\"'`DEVELOPER · ${w.practice?'\"'PRACTICE':'CHANGES MARK PRACTICE'}\"'`,title,text:`Seed ${w.config.seed}  ·  Tick ${w.tick}'\"\\\\n\"'${w.room.name} / ${w.phase} · ${w.enemies.length} live / ${w.queue.filter(s=>!s.done).length} queued'\"\\\\nSliders affect living actors immediately. Spawn spacing retimes queued warnings.\"'`,rows:(app.network.active?['\"'grid']:keys).map(k=>'dev_'+k),actions:[['Next tuning page',()=>showDev(app.devPage+1)],...(\"'!app.network.active?[\n ['\"'Encounter tools',()=>devEncounters()],['Step one simulation tick',()=>mutate(w=>{w.step(1/120,{});app.stage.update(w,1/120);})],['Reset to defaults',()=>{resetDev();showDev(app.devPage);}],['Restart chamber',()=>mutate(w=>w.retry())],['Restart run',()=>app.begin(w.config.difficulty,w.config.seats)],]:[]),['Resume',()=>{ui.hide();game.resume();clearInputs();}]]});}\nfunction devEncounters(){const action=(label,fn)=>[label,()=>{mutate(fn);devEncounters();}];ui.show('devencounters',{kicker:'PRACTICE TOOLS',title:'Rearrange the appointment',text:'Room selection preserves team score. All world changes exclude records.',actions:[action('Next chamber',w=>w.loadRoom((w.roomIndex+1)%6)),action('Previous chamber',w=>w.loadRoom((w.roomIndex+5)%6)),action('Force hunt',w=>w.loadRoom(w.roomIndex)),action('Force familiar chase',w=>{w.enemies=[];w.queue.forEach(s=>s.done=true);w.beginFamiliar();}),action('Force Wizard intrusion',w=>{w.enemies=[];w.familiar=null;w.setPhase('Intrusion');w.manifest=0;w.nextWizard(.1);}),action('Force final manifestations',w=>{w.loadRoom(5);w.queue.forEach(s=>s.done=true);w.setPhase('Intrusion');w.nextWizard(.1);}),...Object.entries(I.FAMILIES).map(([k,v])=>action('Spawn '+v.name,w=>w.spawn(k,[10,1]))),action('Remove all hunters',w=>{w.enemies=[];}),action('Clear chamber',w=>{w.enemies=[];w.queue.forEach(s=>s.done=true);w.familiar=null;w.wizard=null;w.clearRoom();}),['Back',()=>ui.back()]]});}\nfunction results(w){if(app.network.active)return;if(\"'!app.recorded){vault.record(w);app.recorded=true;}ui.show('\"'results',{kicker:w.status==='victory'?'THE MENAGERIE IS OPEN. HE REMAINS INCURABLE.':'THE MANAGEMENT SENDS ITS REGARDS.',title:w.status==='victory'?'Discharged\"'!'\"':'A difficult diagnosis',emblem:w.status==='victory'?'VI':'×',text:w.practice?'Practice run · excluded from local records':w.config.difficulty+(w.config.assistance?' · assisted':' · standard')+' · team score',stats:[[w.score.toLocaleString(),'POINTS'],[\"'`${w.roomIndex+(w.status==='\"'victory'?1:0)} / 6\"'`,'\"'CHAMBERS'],[\"'`${Math.floor(w.elapsed/60)}:${String(Math.floor(w.elapsed%60)).padStart(2,'\"'0')}\"'`,'\"'TIME']],medals:[['Familiar intercepted',w.familiars>0],['Wizard banished',w.banishments>0],['Bell keeper',w.bells>0]],sections:w.players.map((p,i)=>[\"'`Warden ${i+1}`,`${p.kills} contributions · ${p.shots} bolts committed`]),actions:[...(w.status==='\"'defeat'?[['Retry chamber · Practice',()=>{w.retry();ui.hide();game.resume();app.recorded=false;app.audio.resume();}]]:[]),['New run',()=>app.begin(w.config.difficulty,w.config.seats)],['Credits',()=>credits(0)],['Title',showTitle]]});}\nfunction beginAttract(){if(app.network.active)return;ui.hide();game.resume();app.begin('Normal',[0,1],'attract',1953);app.demo=true;app.demoTime=0;app.demoSegment=-1;}\nfunction demoStep(dt){app.demoTime+=dt;const seg=Math.floor(app.demoTime/18)%6,w=app.world;if(seg\"'!==app.demoSegment){app.demoSegment=seg;w.loadRoom(seg);w.phase='\"'Hunt';w.phaseTime=0;w.enemies=[];w.queue.forEach(s=>s.done=true);w.spawn('hopper',[15,5]);w.spawn(seg===1?'stalker':'skitter',[12,9]);if(seg===2){w.players[0].m.place(10,5);w.players[0].aim=3;w.spawn('stalker',[9,2]);}if(seg===3)w.players[0].m.place(1,6);}\n const t=app.demoTime%18,cmd={};for(const p of w.players)cmd[p.seat]=I.bot(w,p);if(seg===2&&t<2)cmd[0]={move:-1,aim:3,fire:true};if(seg===3&&t<.6)cmd[0]={move:2,aim:2,fire:false};if(t>8&&t<8+dt){w.enemies=[];w.beginFamiliar();}if(t>12&&t<12+dt&&seg\"'!==0){w.familiar=null;w.setPhase('\"'Intrusion');w.nextWizard(.1);}w.step(dt,cmd);if(w.status\"'!=='\"'playing')w.status='playing';}\nconst intentional=e=>{app.idle=0;if(\"'!app.demo)return false;showTitle();clearInputs();e?.preventDefault?.();e?.stopImmediatePropagation?.();return true;};app.controls.intent=intentional;\nif(ui.root)ui.root.addEventListener('\"'pointermove',e=>{const b=e.target.closest('button,input');if(b&&Math.hypot(e.movementX||0,e.movementY||0)>1)b.focus({preventScroll:true});});\ngame.hook('input',dt=>{if(app.network.ended){game.input.clear();return;}const pad=game.input.lastDevice==='gamepad'&&(game.input.anyPressed()||Math.hypot(...(game.input.padMove||[0,0]))>.3||Math.hypot(...(game.input.padAim||[0,0]))>.3);if(pad){if(app.demo){intentional();game.input.consumeAll();return;}app.idle=0;}\n if(\"'!app.network.active&&game.sceneName==='\"'title'){app.idle+=dt;if(app.idle>=10)beginAttract();}\n if(game.paused&&\"'!app.network.active)for(const p of game.players)p.clear();\n});\nconst scenes={title:{camera:{zoom:false,wheel:false},enter(){titleMenu();app.idle=0;game.cam.offset=[game.W*.24,game.H*.14];game.cam.smooth=0;game.focus(220,110,0);app.audio.music('\"'title');},update(dt){game.cam.offset=[game.W*.24,game.H*.14];game.focus(220,110,0);app.audio.update(null,dt);},draw(r){app.stage.drawTitle(r,game.real);}},\n play:{pausable:true,input:I.PRESET,touch:[],camera:{zoom:false,wheel:false},enter(){clearInputs();app.stage.layout();},update(dt){const w=app.world;if(\"'!w)return;app.stage.layout();if(app.network.ended)return;\n if(app.demo)demoStep(dt);else if(app.network.active){const p=w.players.find(p=>p.seat===app.network.hub.me),c=app.controls.sample(w,p);app.network.step(dt,c);}else if(!ui.screen){const commands={};for(let i=0;i<w.players.length;i++)commands[w.players[i].seat]=app.controls.sample(w,w.players[i],game.players[i]||game.input);w.step(dt,commands);}\n app.stage.update(w,dt);app.audio.update(w,dt,app.demo);\n if(!app.demo&&!app.network.active){if(w.roomIndex!==app.lastSaved&&w.status==='\"'playing'){vault.save(w);app.lastSaved=w.roomIndex;}if(w.status\"'!=='\"'playing'&&\"'!ui.screen)results(w);}\n },draw(r){app.stage.draw(r,app.world,{demo:app.demo,grid:app.debugGrid});}}};\ngame.fadeTime=0;game.start({scenes,scene:online?'\"'play':'title'});\ngame.debug={snapshot:()=>({title:I.TITLE,scene:game.sceneName,screen:ui.screen,demo:app.demo,paused:game.paused,network:{active:app.network.active,started:app.network.started,ended:app.network.ended,finished:app.network.finished,sent:app.network.sent,maxBytes:app.network.maxBytes},world:app.world?.snapshot()||null,settings:{music:game.settings.music,glyphs:game.settings.glyphs},errors:game.errors}),command:(cmds,seconds=1/120)=>{if(app.network.active)return;const w=app.world;if(\"'!w)return;for(let t=0;t<seconds;t+=1/120)w.step(1/120,cmds);app.stage.update(w,seconds);},setup:(fn)=>{if(app.network.active)return;app.world.practice=true;fn(app.world);},begin:app.begin,credits,dev:showDev,help,results:()=>app.world&&results(app.world),attract:beginAttract};root.__game=game;\nif(root.AIHub)app.network.connect();\n})(globalThis);\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/art.js'\ns=open(p).read().replace(\\\"px.line(w.g,...a,...b,'#342838',Math.max(2,u*3))\\\",\\\"px.line(w.g,a[0],a[1],b[0],b[1],'#342838',Math.max(2,u*3))\\\")\nopen(p,'w').write(s)\np='src/sim.js';s=open(p).read().replace('rand(){let x=this.rngState;', 'rand(){if(this.externalRng)return this.externalRng();let x=this.rngState;')\ns=s.replace(\\\"this.emit('fire',{owner:p.id,x:b.x,y:b.y});return true;\\\", \\\"this.emit('fire',{owner:p.id,x:b.x,y:b.y});for(const e of this.enemies)if(e.lure<=0&&Math.hypot(e.m.x-p.m.x,e.m.y-p.m.y)<7){e.target=[Math.round(p.m.x),Math.round(p.m.y)];e.memory=3;e.state='listen';}return true;\\\")\nopen(p,'w').write(s)\nPY\ncat > tools/build.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nconst dir=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');\nconst name=path.basename(dir)+'.html';\nconst read=f=>fs.readFileSync(path.join(dir,f),'utf8');\nconst client=read('vendor/session.js');\nif(/<\\\\/script/i.test(client))throw Error('Hub client cannot be safely byte-preserved inline');\nlet html=read('index.template.html');\nhtml=html.replace('<\"'!--HUB-->'\"',\"'`<script>${client}</script>`);\nconst src=['\"'vendor/my-3d2dge.js','src/content.js','src/sim.js','src/platform.js','src/audio.js','src/art.js','src/main.js'];\nhtml=html.replace('<\"'!--GAME-->'\"',src.map(f=>\"'`<script>'\"\\\\n\"'${read(f).replace(/<'\"\\\\/script/gi,'<\\\\\\\\/script')}\\\\n</script>\"'`).join('\"'\\\\n'));\nconst interview=JSON.parse(fs.readFileSync(path.join(dir,'interview.json'),'utf8'));\nhtml=html.replace('/*INTERVIEW*/',JSON.stringify(interview).replace(/</g,'\\\\\\\\u003c'));\nfs.writeFileSync(path.join(dir,name),html);fs.writeFileSync(path.join(dir,'..',name),html);\nfs.copyFileSync(path.join(dir,'interview.json'),path.join(dir,'..','exit-interview.json'));\nif(process.argv.includes('--report'))console.log(name+' ('+Buffer.byteLength(html)+' bytes)');\nEOF\ncat > index.template.html <<'EOF'\n<\"'!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><!--HUB-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-2\"><meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Clear six chambers, intercept the familiar, and banish all three final manifestations. Share a team score.\">\n<meta name=\"hub:session-howto\" content=\"Left stick / WASD move. Right stick / arrows / mouse aim. R2 / Cross / Space / click fire. Options / Escape pause. Touch: left thumb move, right thumb aim and fire.\">\n<meta name=\"hub:session-minutes\" content=\"12\"><meta name=\"description\" content=\"The Incurable Wizard. One bolt. Six floors. No known cure.\">\n<title>The Incurable Wizard</title>\n<style>\n:root{color-scheme:dark}*{box-sizing:border-box}html,body{margin:0;overflow:hidden;width:100%;height:100%;background:#100e1c}canvas#screen{display:block;width:100%;height:100%;image-rendering:pixelated;touch-action:none}.esh{--ink:#f2dfbd!important;--paper:#211b2e!important;--accent:#e9bc7d!important;--muted:#b2a0b8!important;--line:#67526e!important;font-family:Georgia,serif!important}.esh .esh-sh{background:rgba(10,8,19,.67);backdrop-filter:blur(3px)}.esh .esh-pan{box-shadow:0 12px 60px #08071099;border:1px solid #755d79!important;background:linear-gradient(145deg,#292035f7,#191928fc)!important}.esh h1,.esh h2{font-family:Georgia,serif;letter-spacing:-.035em}.esh h2{color:#f4dcac}.esh button{border-radius:3px!important;min-height:38px;transition:background .1s}.esh button:hover{background:#57435f!important}.esh button:focus{outline:2px solid #e3c48e!important;outline-offset:3px}.esh .esh-btns{gap:9px}.esh .esh-ttl{background:linear-gradient(90deg,#120f21ed,transparent 77%);backdrop-filter:none;justify-content:flex-start!important;padding-left:6vw!important}.esh .esh-ttl>div{width:45%;max-width:450px}.esh .esh-ttl h1{font-size:3.2em;line-height:.94;text-shadow:0 3px #523c56;color:#f6dfb4;max-width:420px;margin:0 0 18px}.esh .esh-ttl .esh-sub{font-size:1.04em;line-height:1.4;color:#c5a9b9;max-width:330px}.esh .esh-ttl .esh-k{letter-spacing:.23em}.esh .esh-ttl .esh-btns{display:flex!important;flex-direction:column;max-width:270px;margin-top:24px}.esh .esh-ttl button{font-family:Georgia,serif;font-size:1.05em;text-align:left;padding:10px 18px;background:#282134c9;border-color:#5a475f}.esh .esh-ttl button.pri{color:#241c2a;background:#e8c38a;border-color:#f4d7a6}.esh .esh-ttl .esh-tags{margin-top:18px}.esh .esh-mod{max-height:84vh!important;max-width:650px!important}.esh .esh-m{line-height:1.5;white-space:pre-line}.esh .esh-row small{font-size:.7em}.esh .esh-emb{font-family:Georgia,serif;color:#e3c48e}.esh .esh-nav{z-index:3}.esh .esh-stats b{color:#eac58f}.esh .esh-stats small{color:#bba8c4}#caption{position:fixed;left:0;bottom:0;pointer-events:none;visibility:hidden}\n@media(max-aspect-ratio:1/1){.esh .esh-ttl>div{width:89%;max-width:440px}.esh .esh-ttl{background:#151123df;padding-left:7vw!important}.esh .esh-ttl h1{font-size:2.8em}.esh .esh-ttl .esh-btns{max-width:100%;margin-top:18px}.esh .esh-mod{max-width:94vw!important}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important}}\n</style></head><body><canvas id=\"screen\" aria-label=\"The Incurable Wizard game arena\"></canvas><script>globalThis.INCURABLE_INTERVIEW=/*INTERVIEW*/;</script><!--GAME--></body></html>\nEOF\ncat > src/main.js <<'\"'EOF'\n/* Adapted from the full ARCADE kit's scene, fixed-step, grid and cabinet patterns.\n   Simultaneous seats, campaign and encounter rules are original game systems. */\n(function(root){'use strict';const E=root.My3D2dge,I=root.IW,online=\"'!!root.AIHub?.active;\nconst game=new E.Game({id:'\"'the-incurable-wizard',canvas:'screen',res:[640,360],expand:true,view:'topdown',views:['topdown'],input:I.PRESET,bg:'#100e1c',fullscreen:'button',autoPause:\"'!online,live:online,menu:{quit:online?false:'\"'title',controls:{moveUp:'Move north',moveDown:'Move south',moveLeft:'Move west',moveRight:'Move east',aimUp:'Aim north',aimDown:'Aim south',aimLeft:'Aim west',aimRight:'Aim east',fire:'Lantern rifle',up:false,down:false,left:false,right:false},settings:[{key:'music',value:.1},{key:'glyphs',value:'playstation'},{key:'voices',group:'Sound',label:'Wizard gibberish',type:'slider',value:.7,apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},{key:'assistance',group:'Game',label:'Touch auto-fire',type:'toggle',value:true,help:'Only fires at a visible target in a clear cardinal lane. Separate score category.'},{key:'contrast',group:'Comfort',label:'Radar contrast',type:'toggle',value:true}]}});\nlet storage;try{storage=root.localStorage;}catch{}const vault=new I.Vault(storage);\nconst app=I.app={game,world:null,vault,controls:new I.Controls(game),stage:new I.Stage(game),audio:new I.Sound(game),demo:false,idle:0,creditsPage:0,devPage:0,lastSaved:-1,recorded:false,debugGrid:false,resetting:false,coopMode:'keyboard-pad'};app.network=new I.Network(app,root.AIHub);\nconst ui=new E.Shell(game,{tv:true,theme:{ink:'#f0dcbb',paper:'#211c2d',accent:'#e9bf83',muted:'#b8a4bb',line:'#705c79',font:'Georgia, serif',titleFont:'Georgia, serif'},screens:{pause:{kicker:online?'ONLINE — THE DUNGEON CONTINUES':'A MOMENT OF PROFESSIONAL DOUBT',actions:[['Developer',()=>showDev()],['How to play',()=>help(0)],['About / Credits',()=>credits(0)]]}}});\napp.ui=ui;\nfunction clearInputs(){app.controls.clear();game.input.consumeAll();}\nfunction showTitle(){app.demo=false;app.world=null;app.recorded=false;app.idle=0;app.audio.resume();app.audio.lastEvent=0;app.stage.seenEvent=0;app.stage.pulses=[];resetDev();while(game.players.length>1)game.removePlayer(2);game.input.pad='any';game.paused=false;ui.hide();game.go('title',null,{fade:0});}\napp.title=showTitle;\nfunction titleMenu(){ui.show('title',{kicker:'A MENAGERIE OF BAD DECISIONS',name:I.TITLE,subtitle:I.TAGLINE,text:'The sorcerer has a condition.\\\\nYou have a lantern-rifle.',meta:['6 chambers','1–2 wardens','Arcade dungeon'],actions:[['Play',()=>setup(false)],['Couch co-op',()=>coop()],['Settings',()=>game.menu('settings')],['How to play',()=>help(0)],['About / Credits',()=>credits(0)]],footer:()=>game.input.lastDevice==='gamepad'?game.input.label('confirm')+' Choose   '+game.input.label('cancel')+' Back':'Enter Choose  •  Arrows Navigate'});}\nfunction setup(coop){app.seats=coop?[0,1]:[0];ui.show('setup',{kicker:coop?'TWO RIFLES. ONE DUNGEON.':'PLEASE SELECT YOUR DISCOMFORT',title:'Make an appointment',text:'Every bolt stays yours until it hits.\\\\nChoose the pressure. All six floors await.',actions:[['Gentle — 5 lives, longer warnings',()=>app.begin('Gentle',app.seats)],['Normal — 3 lives, intended pressure',()=>app.begin('Normal',app.seats)],['Fierce — 3 lives, sharper company',()=>app.begin('Fierce',app.seats)],...(vault.data.checkpoint?[['Continue saved descent',()=>app.continue()]]:[]),['Back',()=>ui.back()]]});}\nfunction coop(){ui.show('coop',{kicker:'SIMULTANEOUS CO-OP',title:'Bring a second opinion',text:'Wardens pass through each other. Bolts do too.\\\\nScore and radar belong to the team.\\\\nOnline play starts through an AI Hub session.',actions:[['Keyboard + controller',()=>{app.coopMode='keyboard-pad';setup(true);}],['Two controllers',()=>{app.coopMode='pads';setup(true);}],['Shared keyboard',()=>{app.coopMode='keys';setup(true);}],['Back',()=>ui.back()]]});}\nfunction configureSeats(seats,context){while(game.players.length>1)game.removePlayer(2);game.input.pad='any';game.input.use(I.PRESET);if(seats.length>1&&context\"'!=='\"'hub'&&context\"'!=='\"'attract'){\n if(app.coopMode==='keys'){const q=game.addPlayer({keys:'right'});game.input.use(I.PRESET);q.use({...I.PRESET,moveUp:['KeyI'],moveDown:['KeyK'],moveLeft:['KeyJ'],moveRight:['KeyL'],aimUp:['Numpad8'],aimDown:['Numpad2'],aimLeft:['Numpad4'],aimRight:['Numpad6'],fire:['ShiftRight'],up:['KeyI','ArrowUp'],down:['KeyK','ArrowDown'],left:['KeyJ','ArrowLeft'],right:['KeyL','ArrowRight']});game.input.pad=null;}\n else if(app.coopMode==='pads'){game.input.pad=0;game.addPlayer({pad:1});}else{game.input.pad=null;game.addPlayer({pad:0});}}\n clearInputs();}\napp.begin=(difficulty='Normal',seats=[0],context='campaign',seed)=>{if(app.network.active&&context\"'!=='\"'hub')return;resetDev();ui.hide();game.resume();configureSeats(seats,context);app.world=new I.World({difficulty,seats,context,seed:seed||((Date.now()\"'^Math.floor(Math.random()*1e9))>>>0)||1,assistance:game.input.lastDevice==='\"'touch'&&game.settings.assistance});app.demo=context==='attract';app.recorded=false;app.lastSaved=-1;app.audio.resume();app.audio.lastEvent=0;app.stage.seenEvent=0;app.stage.rigs.clear();app.stage.pulses=[];game.go('play',null,{fade:0});};\napp.continue=()=>{if(app.network.active||\"'!vault.data.checkpoint)return;try{const w=new I.World(vault.data.checkpoint.config);w.restore(vault.data.checkpoint);configureSeats(w.config.seats,'\"'campaign');app.world=w;ui.hide();game.resume();app.audio.resume();app.audio.lastEvent=w.eventSeq;app.stage.seenEvent=w.eventSeq;game.go('play',null,{fade:0});}catch{vault.clear();ui.toast('The old seal is broken','Start a new descent.');}};\nconst HELP=[\n ['One bolt is a commitment','Move with the left stick or WASD. Aim with the right stick, arrows, or mouse. Fire with R2 / Cross, Space, or left click. A pale mark shows the selected cardinal lane. The rifle lights again only when your bolt resolves. A nearby wall returns it sooner.'],\n ['Trust the radar','Knobbles hop in plain sight. Broad-jawed Hushjaws and angular Needlekin vanish behind corners. Sharing a clear row or column with either warden reveals them, whichever way you face. The radar always shows their location. It never shows the Wizard.'],\n ['Make a useful noise','Shoot an illuminated brass bell. It consumes your bolt, reveals hunters within 3 cells for 1.25 seconds and lures nearby hunters along legal paths for up to 1.5 seconds. The bell needs 5 seconds to recover. It does nothing to the Wizard.'],\n ['Doors, moths, and multipliers','Wardens and hunters wrap through the paired side gates. Bolts stop there. After the hunt, the winged Ledger Moth flees toward the announced gate. Catch it to double the next chamber. Banish that floor’s Wizard to double again, up to 4x. Final-floor bonuses multiply the 5,000 exit bounty.'],\n ['Your colleague has perished','Each hit costs a life. A returning warden glows safely for 1.25 seconds. An exhausted partner watches, then returns with one life at descent. The third and fourth descents restore a capped life. Retry restores the complete chamber-entry checkpoint and marks the run Practice.'],\n ['Other ways to be brave','Shared keyboard: P1 WASD + arrows + Space; P2 IJKL + numpad 8/4/2/6 + right Shift. Keyboard + controller assigns the pad only to P2. Two controllers use their own seats. Touch: invisible left thumb movement, right thumb aim and fire; visible-target auto-fire is optional in Settings.'],\n ['Online co-operation','AI Hub provides online sessions for 1–2 players. It loads this game directly and owns the round, restart, and results. The host simulates one shared world. Local menus neutralize your controls while the dungeon continues. Create + Options belongs to the Hub. Standalone co-op shares one screen.']\n];\nfunction help(page){const p=(page+HELP.length)%HELP.length;ui.show('help',{kicker:\"'`FIELD NOTES ${p+1} / ${HELP.length}`,title:HELP[p][0],text:HELP[p][1],actions:[['\"'Next note',()=>help(p+1)],['Previous',()=>help(p-1)],['Back',()=>ui.back()]]});}\nfunction credits(page){const data=root.INCURABLE_INTERVIEW||{},s=data.sourceInformation||{},pages=[\n ['Source Information',Object.entries(s).slice(0,7).map(([k,v])=>k+': '+v).join('\\\\n\\\\n')],['Source Information · continued',Object.entries(s).slice(7).map(([k,v])=>k+': '+v).join('\\\\n\\\\n')],\n ['Original work & research','Inspired by The Incredible Wizard (Astrocade, 1982), a licensed Wizard of Wor adaptation. Original title, wardens, hunters, Ledger Moth, bells, maps, score economy, compositions, gibberish and finale made for this game. Native Humanoid / Blob rigs and core candle prop: my-3D2dge.\\\\n\\\\nManual: ballyalley.com/cart_manuals/text_manuals/incredible_wizard.txt\\\\nScan: ballyalley.com/cart_manuals/pdf_manuals/Incredible_Wizard,_The.pdf\\\\nContemporary feature: vgpavilion.com/mags/1982/12/vi/conquering-the-incredible-wizard/\\\\nHardware footage: archive.org/details/IncredibleWizardBallyArcadeAstrocade1982\\\\n\\\\nRead and cross-checked manual scan; article has discrepancies, manual wins. Inspected hardware video frames. No human listening check. Historical AI and exact sound synthesis: unknown.'],\n ['Testing Feedback',(data.testingFeedback||[]).map((v,i)=>(i+1)+'. '+v).join('\\\\n\\\\n')],['Engine Feedback',(data.engineFeedback||[]).slice(0,3).map((v,i)=>(i+1)+'. '+v).join('\\\\n\\\\n')],['Engine Feedback · continued',(data.engineFeedback||[]).slice(3).map((v,i)=>(i+4)+'. '+v).join('\\\\n\\\\n')],['Prompt Feedback',(data.promptFeedback||[]).map((v,i)=>(i+1)+'. '+v).join('\\\\n\\\\n')]\n ];const p=(page+pages.length)%pages.length;ui.show('credits',{kicker:\"'`THE INCURABLE WIZARD · ${p+1} / ${pages.length}`,title:pages[p][0],text:pages[p][1],actions:[['\"'Next page',()=>credits(p+1)],['Previous',()=>credits(p-1)],['Back',()=>ui.back()]]});}\napp.credits=credits;\nconst ranges={playerSpeed:[2,7,.1],boltSpeed:[5,30,.5],fireInterval:[.08,.6,.01],hopperSpeed:[.5,3,.1],stalkerSpeed:[.5,4,.1],skitterSpeed:[1,5,.1],pressureRate:[0,.02,.001],pressureCap:[1,2,.05],spawnSpacing:[.5,8,.1],familiarSpeed:[1,6,.1],wizardInterval:[1.5,6,.1],wizardAttack:[.3,2,.05],wizardWarning:[.5,3,.05],protection:[.5,3,.05],bellRevealRadius:[1,6,.1],bellRevealTime:[.5,3,.05],bellLureRadius:[1,8,.1],bellLureTime:[.3,3,.05],bellCooldown:[2,10,.1],touchAssist:[0,1,.1]};\nfor(const[k,[min,max,step]]of Object.entries(ranges))game.settings.define({key:'dev_'+k,group:'Controls',label:k.replace(/([A-Z])/g,' \"'$1'\"'),type:'slider',value:I.DEFAULTS[k],min,max,step});\nfor(const spec of[{key:'dev_timeScale',label:'Slow motion',type:'slider',value:1,min:.1,max:1,step:.1},{key:'dev_invulnerable',label:'Invulnerable',type:'toggle',value:false},{key:'dev_lives',label:'Lives per warden',type:'slider',value:3,min:1,max:9,step:1},{key:'dev_grid',label:'Grid / collision / radar diagnostics',type:'toggle',value:false}])game.settings.define({...spec,group:'Controls'});\ngame.settings.onChange=k=>{if(k==='assistance'&&app.world&&game.input.lastDevice==='touch'&&game.settings.assistance)app.world.config.assistance=true;if(\"'!k.startsWith('\"'dev_')||app.resetting)return;if(k==='dev_grid'){app.debugGrid=game.settings[k];return;}if(app.network.active)return;const w=app.world;if(\"'!w)return;w.practice=true;const key=k.slice(4),v=game.settings[k];if(key==='\"'timeScale')game.timeScale=v;else if(key==='invulnerable')w.invulnerable=v;else if(key==='lives'){for(const p of w.players){p.lives=v;if(\"'!p.alive)w.respawn(p);}}else w.tuning[key]=v;};\nfunction resetDev(){app.resetting=true;for(const[k,v]of Object.entries(I.DEFAULTS))game.settings.set('\"'dev_'+k,v);game.settings.set('dev_timeScale',1);game.settings.set('dev_invulnerable',false);game.settings.set('dev_lives',3);game.settings.set('dev_grid',false);game.timeScale=1;app.debugGrid=false;if(app.world){app.world.tuning={...I.DEFAULTS};app.world.invulnerable=false;}app.resetting=false;}\nfunction mutate(fn){if(app.network.active||\"'!app.world)return;app.world.practice=true;fn(app.world);clearInputs();showDev(app.devPage);}\nconst devPages=[['\"'Movement & fire',['playerSpeed','boltSpeed','fireInterval']],['Hunter pressure',['hopperSpeed','stalkerSpeed','skitterSpeed','pressureRate','pressureCap','spawnSpacing']],['Familiar & Wizard',['familiarSpeed','wizardInterval','wizardAttack','wizardWarning']],['Bell & respawn',['protection','bellRevealRadius','bellRevealTime','bellLureRadius','bellLureTime','bellCooldown']],['Clock & assistance',['timeScale','invulnerable','lives','touchAssist','grid']]];\nfunction showDev(p=0){app.devPage=(p+devPages.length)%devPages.length;const w=app.world;if(\"'!w)return;const [title,keys]=devPages[app.devPage];ui.show('\"'dev',{kicker:app.network.active?'ONLINE · DIAGNOSTICS ONLY':\"'`DEVELOPER · ${w.practice?'\"'PRACTICE':'CHANGES MARK PRACTICE'}\"'`,title,text:`Seed ${w.config.seed}  ·  Tick ${w.tick}'\"\\\\n\"'${w.room.name} / ${w.phase} · ${w.enemies.length} live / ${w.queue.filter(s=>!s.done).length} queued'\"\\\\nSliders affect living actors immediately. Spawn spacing retimes queued warnings.\"'`,rows:(app.network.active?['\"'grid']:keys).map(k=>'dev_'+k),actions:[['Next tuning page',()=>showDev(app.devPage+1)],...(\"'!app.network.active?[\n ['\"'Encounter tools',()=>devEncounters()],['Step one simulation tick',()=>mutate(w=>{w.step(1/120,{});app.stage.update(w,1/120);})],['Reset to defaults',()=>{resetDev();showDev(app.devPage);}],['Restart chamber',()=>mutate(w=>w.retry())],['Restart run',()=>app.begin(w.config.difficulty,w.config.seats)],]:[]),['Resume',()=>{ui.hide();game.resume();clearInputs();}]]});}\nfunction devEncounters(){const action=(label,fn)=>[label,()=>{mutate(fn);devEncounters();}];ui.show('devencounters',{kicker:'PRACTICE TOOLS',title:'Rearrange the appointment',text:'Room selection preserves team score. All world changes exclude records.',actions:[action('Next chamber',w=>w.loadRoom((w.roomIndex+1)%6)),action('Previous chamber',w=>w.loadRoom((w.roomIndex+5)%6)),action('Force hunt',w=>w.loadRoom(w.roomIndex)),action('Force familiar chase',w=>{w.enemies=[];w.queue.forEach(s=>s.done=true);w.beginFamiliar();}),action('Force Wizard intrusion',w=>{w.enemies=[];w.familiar=null;w.setPhase('Intrusion');w.manifest=0;w.nextWizard(.1);}),action('Force final manifestations',w=>{w.loadRoom(5);w.queue.forEach(s=>s.done=true);w.setPhase('Intrusion');w.nextWizard(.1);}),...Object.entries(I.FAMILIES).map(([k,v])=>action('Spawn '+v.name,w=>w.spawn(k,[10,1]))),action('Remove all hunters',w=>{w.enemies=[];}),action('Clear chamber',w=>{w.enemies=[];w.queue.forEach(s=>s.done=true);w.familiar=null;w.wizard=null;w.clearRoom();}),['Back',()=>ui.back()]]});}\nfunction results(w){if(app.network.active)return;if(\"'!app.recorded){vault.record(w);app.recorded=true;}ui.show('\"'results',{kicker:w.status==='victory'?'THE MENAGERIE IS OPEN. HE REMAINS INCURABLE.':'THE MANAGEMENT SENDS ITS REGARDS.',title:w.status==='victory'?'Discharged\"'!'\"':'A difficult diagnosis',emblem:w.status==='victory'?'VI':'×',text:w.practice?'Practice run · excluded from local records':w.config.difficulty+(w.config.assistance?' · assisted':' · standard')+' · team score',stats:[[w.score.toLocaleString(),'POINTS'],[\"'`${w.roomIndex+(w.status==='\"'victory'?1:0)} / 6\"'`,'\"'CHAMBERS'],[\"'`${Math.floor(w.elapsed/60)}:${String(Math.floor(w.elapsed%60)).padStart(2,'\"'0')}\"'`,'\"'TIME']],medals:[['Familiar intercepted',w.familiars>0],['Wizard banished',w.banishments>0],['Bell keeper',w.bells>0]],sections:w.players.map((p,i)=>[\"'`Warden ${i+1}`,`${p.kills} contributions · ${p.shots} bolts committed`]),actions:[...(w.status==='\"'defeat'?[['Retry chamber · Practice',()=>{w.retry();ui.hide();game.resume();app.recorded=false;app.audio.resume();}]]:[]),['New run',()=>app.begin(w.config.difficulty,w.config.seats)],['Credits',()=>credits(0)],['Title',showTitle]]});}\nfunction beginAttract(){if(app.network.active)return;ui.hide();game.resume();app.begin('Normal',[0,1],'attract',1953);app.demo=true;app.demoTime=0;app.demoSegment=-1;}\nfunction demoStep(dt){app.demoTime+=dt;const seg=Math.floor(app.demoTime/18)%6,w=app.world;if(seg\"'!==app.demoSegment){app.demoSegment=seg;w.loadRoom(seg);w.phase='\"'Hunt';w.phaseTime=0;w.enemies=[];w.queue.forEach(s=>s.done=true);w.spawn('hopper',[15,5]);w.spawn(seg===1?'stalker':'skitter',[12,9]);if(seg===2){w.players[0].m.place(10,5);w.players[0].aim=3;w.spawn('stalker',[9,2]);}if(seg===3)w.players[0].m.place(1,6);}\n const t=app.demoTime%18,cmd={};for(const p of w.players)cmd[p.seat]=I.bot(w,p);if(seg===2&&t<2)cmd[0]={move:-1,aim:3,fire:true};if(seg===3&&t<.6)cmd[0]={move:2,aim:2,fire:false};if(t>8&&t<8+dt){w.enemies=[];w.beginFamiliar();}if(t>12&&t<12+dt&&seg\"'!==0){w.familiar=null;w.setPhase('\"'Intrusion');w.nextWizard(.1);}w.step(dt,cmd);if(w.status\"'!=='\"'playing')w.status='playing';}\nconst intentional=e=>{app.idle=0;if(\"'!app.demo)return false;showTitle();clearInputs();e?.preventDefault?.();e?.stopImmediatePropagation?.();return true;};app.controls.intent=intentional;\nif(ui.root)ui.root.addEventListener('\"'pointermove',e=>{const b=e.target.closest('button,input');if(b&&Math.hypot(e.movementX||0,e.movementY||0)>1)b.focus({preventScroll:true});});\ngame.hook('input',dt=>{if(app.network.ended){game.input.clear();return;}const pad=game.input.lastDevice==='gamepad'&&(game.input.anyPressed()||Math.hypot(...(game.input.padMove||[0,0]))>.3||Math.hypot(...(game.input.padAim||[0,0]))>.3);if(pad){if(app.demo){intentional();game.input.consumeAll();return;}app.idle=0;}\n if(\"'!app.network.active&&game.sceneName==='\"'title'){app.idle+=dt;if(app.idle>=10)beginAttract();}\n if(game.paused&&\"'!app.network.active)for(const p of game.players)p.clear();\n});\nconst scenes={title:{camera:{zoom:false,wheel:false},enter(){titleMenu();app.idle=0;game.cam.offset=[game.W*.24,game.H*.14];game.cam.smooth=0;game.focus(220,110,0);app.audio.music('\"'title');},update(dt){game.cam.offset=[game.W*.24,game.H*.14];game.focus(220,110,0);app.audio.update(null,dt);},draw(r){app.stage.drawTitle(r,game.real);}},\n play:{pausable:true,input:I.PRESET,touch:[],camera:{zoom:false,wheel:false},enter(){clearInputs();app.stage.layout();},update(dt){const w=app.world;if(\"'!w)return;app.stage.layout();if(app.network.ended)return;\n if(app.demo)demoStep(dt);else if(app.network.active){const p=w.players.find(p=>p.seat===app.network.hub.me),c=app.controls.sample(w,p);app.network.step(dt,c);}else if(!ui.screen){const commands={};for(let i=0;i<w.players.length;i++)commands[w.players[i].seat]=app.controls.sample(w,w.players[i],game.players[i]||game.input);w.step(dt,commands);}\n app.stage.update(w,dt);app.audio.update(w,dt,app.demo);\n if(!app.demo&&!app.network.active){if(w.roomIndex!==app.lastSaved&&w.status==='\"'playing'){vault.save(w);app.lastSaved=w.roomIndex;}if(w.status\"'!=='\"'playing'&&\"'!ui.screen)results(w);}\n },draw(r){app.stage.draw(r,app.world,{demo:app.demo,grid:app.debugGrid});}}};\ngame.fadeTime=0;game.start({scenes,scene:online?'\"'play':'title'});\ngame.debug={snapshot:()=>({title:I.TITLE,scene:game.sceneName,screen:ui.screen,demo:app.demo,paused:game.paused,network:{active:app.network.active,started:app.network.started,ended:app.network.ended,finished:app.network.finished,sent:app.network.sent,maxBytes:app.network.maxBytes},world:app.world?.snapshot()||null,settings:{music:game.settings.music,glyphs:game.settings.glyphs},errors:game.errors}),command:(cmds,seconds=1/120)=>{if(app.network.active)return;const w=app.world;if(\"'!w)return;for(let t=0;t<seconds;t+=1/120)w.step(1/120,cmds);app.stage.update(w,seconds);},setup:(fn)=>{if(app.network.active)return;app.world.practice=true;fn(app.world);},begin:app.begin,credits,dev:showDev,help,results:()=>app.world&&results(app.world),attract:beginAttract};root.__game=game;\nif(root.AIHub)app.network.connect();\n})(globalThis);\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat > tools/init-interview.mjs <<'EOF'\nimport fs from 'node:fs';\nconst data={sourceInformation:{date:'2026-11-06 02:28:35',source:'The Incredible Wizard (Astrocade, 1982), licensed from Wizard of Wor',plan:'PLAN.md',genre:'Arcade maze shooter',perspective:'Fixed near-overhead topdown camera',tech:'my-3D2dge 0.89.1 (8ecc2f6), JavaScript, Canvas 2D, Web Audio; AI Hub client 1.4.0; no runtime downloads',artDirection:'Original code-native volumetric pixel art, plum stone, brass and spectral teal',animation:'Native Humanoid and Blob rigs, original lantern-rifle and procedural poses, wings, bells and spell effects',audio:'Original code-written music, effects and gibberish voices. Music defaults to 10%. Human listening: unknown.',online:'Standalone solo and simultaneous couch co-op; AI Hub 1–2-player host-authoritative shared-world co-op',testing:'Unlimited headless tests permitted, no FPS gate; automated simulation, packaged browser, standard pad stub, touch profiles, Web Audio and Hub harness',research:'Read original manual and contemporary December 1982 feature; visually cross-checked manual scan and inspected archived hardware video frames. Exact historical AI and synthesis unknown.',environment:'Codex CLI (headless); Linux',model:'OpenAI, gpt-6.1-sol, reasoning effort max',usage:'added on import'},testingFeedback:['unknown','unknown','unknown','unknown'],engineFeedback:['The native rigs, textured TileMap and pixel render queue form a coherent style.','Verified APIs against the handoff. Details of final test findings: unknown.','The deterministic simultaneous campaign simulation and authoritative network adapter.','Keeping cell movement, world-space collisions, visibility and native shell ownership consistent.','No engine source changes; game adapters provide invisible touch sticks and live online menus, with native original shapes and a weapon extension.','Add a serializable swept projectile and simultaneous-seat arcade mode.'],promptFeedback:['The source-specific one-shot and radar pillars give the game a clear identity.','The plan suggested its own artifact naming, while TASK.md supplies the authoritative suffix.','Integrating six chambers, complete input, deterministic testing and shared-world lifecycle in one portable HTML.','Specify acceptance priorities and distinguish measured automated pacing from a human first-run duration.'],aiHub:{name:'The Incurable Wizard',tagline:'One bolt. Six floors. No known cure.',description:'Enter a pompous sorcerer’s sealed menagerie with a lantern-rifle that sustains one bolt. Read the radar, ring the bells and cover a partner through six original chambers and a three-part finale.',type:'Game',genre:'Shooter',source:'The Incredible Wizard (1982)',series:'',players:'1–2',controls:'Left stick / WASD move; right stick / arrows / mouse aim; R2 / Cross / Space / click fire; Options / Escape pause; touch twin thumbs.',tags:['arcade','co-op','top-down','pixel art','fantasy','boss fights']}};\nfs.writeFileSync(new URL('../interview.json',import.meta.url),JSON.stringify(data,null,2)+'\\\\n');\nEOF\nnode tools/init-interview.mjs\nnode tools/build.mjs --report\nnode --input-type=module - <<'JS'\nimport fs from 'node:fs';import vm from 'node:vm';const ctx=vm.createContext({console, setTimeout,clearTimeout});for(const f of ['vendor/my-3d2dge.js','src/content.js','src/sim.js','src/platform.js','src/audio.js','src/art.js','src/main.js'])vm.runInContext(fs.readFileSync(f,'utf8'),ctx,{filename:f});const {IW, __game:g}=ctx;g.advance(.1);g.debug.begin('Normal',[0],'campaign',1972);g.advance(1/120);console.log('boot',g.errors,g.debug.snapshot().world?.phase);const w=IW.app.world;let steps=0;for(;steps<120*1100&&w.status==='playing';steps++){w.step(1/120,Object.fromEntries(w.players.map(p=>[p.seat,IW.bot(w,p)])));}console.log('campaign',w.status,w.roomIndex,w.elapsed,w.score,w.totalKills,w.deaths,w.banishments,w.familiars);g.dispose();\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
