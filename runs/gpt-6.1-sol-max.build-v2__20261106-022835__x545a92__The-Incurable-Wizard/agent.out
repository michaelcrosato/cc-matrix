side>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    });\n    endpoint.onMessage((from, env) => cell.bridge.fromNet(from, env));\n    cell.detach = attachFrame(frame, (msg) => cell.bridge.fromGame(msg));\n    frame.addEventListener('load', () => instrument(cell), { once: true });\n    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n    state.cells.push(cell);\n  }\n  renderWho(state);\n  render(state);\n  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n  // the conformance run releases it itself.\n  const ticker = setInterval(() => {\n    if (state !== current || state.coordinator.released) return clearInterval(ticker);\n    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n    tickCard(state);\n  }, 250);\n  return state;\n}\n\n    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\n    if (state.record.standings) state.record.standings.forEach((ids, i) => lines.push(`  ${i + 1}. ${ids.map(name).join(', ')}`));\n  }\n  if (s.issues.length) lines.push(...s.issues.map((i) => `✗ ${i.key}: ${i.problem}`));\n  $('round').textContent = lines.join('\\n');\n}\n\n$('restart').onclick = () => newRound();\n$('release').onclick = () => releaseRound();\n$('timeup').onclick = () => current?.coordinator.timeUp();\n$('remove').onclick = () => {\n  const cell = current?.cells.find((c) => c.key === $('who').value);\n  if (cell) removeCell(cell);\n};\n$('hide').onclick = () => {\n  if (!current) return;\n  current.hidden = !current.hidden;\n  $('hide').setAttribute('aria-pressed', String(current.hidden));\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\n};\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\n\n/* ---------------------------------------------------------------------------\n67:import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n76:const playMs = Number(params.get('play')) || 6000;\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n266:  state.splashUntil = null;\n274:  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\n298:    state.splashUntil += 10_000;\n350:  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.n [... omitted end of long line]\n429:    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n456:    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n465:    await randomly(Math.min(1500, playMs / 4));\n479:    await randomly(playMs / 2);\n497:    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n","exit_code":0,"status":"completed"}}
