{"type":"item.completed","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"sed -n '120,141p' src/main.js && sed -n '258,280p' src/main.js && rg -n 'const dirs|w.stage === 1|lightning\\\\(|type.*fire|type.*hurt' src/sim.js src/art.js && sed -n '618,647p' src/sim.js && sed -n '185,220p' src/platform.js && sed -n '68,88p' src/audio.js\"","aggregated_output":"    game.input.consumeAll();\n  }\n  function showTitle() {\n    app.demo = false;\n    app.world = null;\n    app.recorded = false;\n    app.idle = 0;\n    app.audio.resume();\n    app.audio.lastEvent = 0;\n    app.stage.seenEvent = 0;\n    app.stage.pulses = [];\n    resetDev();\n    while (game.players.length > 1) game.removePlayer(2);\n    game.input.pad = 'any';\n    game.paused = false;\n    ui.hide();\n    game.go('title', null, { fade: 0 });\n  }\n  app.title = showTitle;\n  function titleMenu() {\n    ui.show('title', {\n      kicker: 'A MENAGERIE OF BAD DECISIONS',\n  app.begin = (\n    difficulty = 'Normal',\n    seats = [0],\n    context = 'campaign',\n    seed,\n  ) => {\n    if (app.network.active && context !== 'hub') return;\n    resetDev();\n    ui.hide();\n    game.resume();\n    configureSeats(seats, context);\n    app.world = new I.World({\n      difficulty,\n      seats,\n      context,\n      seed: seed || (Date.now() ^ Math.floor(Math.random() * 1e9)) >>> 0 || 1,\n      assistance: game.input.lastDevice === 'touch' && game.settings.assistance,\n    });\n    app.demo = context === 'attract';\n    app.recorded = false;\n    app.lastSaved = -1;\n    app.audio.resume();\n    app.audio.lastEvent = 0;\nsrc/art.js:591:                p.type === 'hurt'\nsrc/sim.js:783:          this.lightning();\nsrc/sim.js:807:    lightning() {\nsrc/sim.js:819:          w.stage === 1\n                b.x,\n                b.y,\n                dx,\n                dy,\n                W(this.wizard.x) - 6,\n                W(this.wizard.y) - 6,\n                W(this.wizard.x) + 6,\n                W(this.wizard.y) + 6,\n              ),\n              3,\n              this.wizard.id,\n              'wizard',\n              this.wizard,\n            );\n        } else\n          for (const p of this.players)\n            if (p.alive && p.protect <= 0)\n              add(\n                rayBox(\n                  b.x,\n                  b.y,\n                  dx,\n                  dy,\n                  W(p.m.x) - 4,\n                  W(p.m.y) - 4,\n                  W(p.m.x) + 4,\n                  W(p.m.y) + 4,\n                ),\n                4,\n                p.id,\n      if (\n        input === this.game.input &&\n        this.mouseActive &&\n        !touch &&\n        input.lastDevice !== 'gamepad'\n      ) {\n        const m = this.game.mouseGround();\n        if (m)\n          aim = I.cardinal(\n            m[0] - I.world(p.m.x),\n            m[1] - I.world(p.m.y),\n            this.aims[p.id] ?? -1,\n            5,\n          );\n        if (aim >= 0) this.aims[p.id] = aim;\n      }\n      const move = I.cardinal(mx, my, p.face, 0.25);\n      let fire = input.down('fire') || (touch && Math.hypot(ax, ay) > 0.5);\n      if (touch && this.game.settings.assistance) {\n        const targets = [\n          ...world.enemies\n            .filter((e) => world.visible(e) && e.warning <= 0)\n            .map((e) => ({ x: e.m.x, y: e.m.y })),\n          ...(world.familiar\n            ? [{ x: world.familiar.m.x, y: world.familiar.m.y }]\n            : []),\n          ...(world.wizard?.state === 'active' ? [world.wizard] : []),\n        ];\n        const t = targets.find((t) => world.los(p, t));\n        if (t && world.tuning.touchAssist) {\n          aim = I.cardinal(t.x - p.m.x, t.y - p.m.y);\n          fire = true;\n        }\n      }\n      return { move, aim, fire };\n    }\n        },\n        {\n          wave: 'pulse12',\n          vol: 0.09,\n          notes: 'D5 . Eb5 . . A4 . . | F5 . E5 . Eb5 - . .',\n        },\n        {\n          wave: 'drums',\n          vol: 0.12,\n          notes: 'k . . h s . . h | k . k . s . h .',\n        },\n      ],\n    },\n    victory: {\n      bpm: 112,\n      steps: 4,\n      tracks: [\n        {\n          wave: 'triangle',\n          vol: 0.28,\n          notes: 'D3 - A3 - B3 - G3 - | D4 - - - - - . .',\n","exit_code":0,"status":"completed"}}
