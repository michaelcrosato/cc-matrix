{"type":"item.completed","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc \"sed -n '807,835p' src/sim.js && rg -n 'const fx|fire:|seenEvent = e.id' src/audio.js src/art.js && tail -n 20 tests/core.mjs\"","aggregated_output":"    lightning() {\n      const w = this.wizard,\n        p = this.players\n          .filter((p) => p.alive)\n          .sort(\n            (a, b) =>\n              Math.hypot(a.m.x - w.x, a.m.y - w.y) -\n              Math.hypot(b.m.x - w.x, b.m.y - w.y),\n          )[0];\n      if (!p) return;\n      const aim = I.cardinal(p.m.x - w.x, p.m.y - w.y),\n        dirs =\n          w.stage === 1\n            ? [aim, (aim + 2) % 4]\n            : w.stage === 2\n              ? [aim, (aim + 1) % 4, (aim + 3) % 4]\n              : [aim];\n      for (const a of dirs) {\n        const d = D[a];\n        this.pool.fire({\n          id: this.nextId++,\n          x: W(w.x) + d[0] * 7,\n          y: W(w.y) + d[1] * 7,\n          z: 7,\n          vx: d[0] * 80,\n          vy: d[1] * 80,\n          r: 2,\n          team: 'hostile',\n          life: 5,\nsrc/art.js:286:        this.seenEvent = e.id;\nsrc/audio.js:109:  const fx = {\nsrc/audio.js:110:    fire: { wave: 'pulse12', freq: 760, to: 180, dur: 0.09, vol: 0.2 },\n  }\n  for (const [seed, diff, seats] of [\n    [1972, 'Normal', [0]],\n    [1982, 'Gentle', [0]],\n    [7, 'Fierce', [0, 1]],\n  ])\n    test(`ordinary-input campaign ${diff} ${seats.length} seat(s)`, () => {\n      const c = campaign(seed, diff, seats);\n      evidence.campaigns ??= [];\n      evidence.campaigns.push(c.evidence);\n      if (\n        c.world.status !== 'victory' ||\n        c.evidence.rooms.length !== 6 ||\n        c.world.banishments !== 5 ||\n        c.world.bells < 1 ||\n        c.world.portals < 1\n      )\n        throw Error(JSON.stringify(c.evidence));\n    });\n}\n","exit_code":0,"status":"completed"}}
