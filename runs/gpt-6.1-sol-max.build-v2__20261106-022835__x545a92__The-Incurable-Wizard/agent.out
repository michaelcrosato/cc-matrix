{"type":"item.completed","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -lc \"sed -n '62,125p' src/platform.js && sed -n '280,300p' src/art.js && sed -n '878,899p' src/art.js\"","aggregated_output":"      this.data.records[k] = Math.max(this.data.records[k] || 0, world.score);\n      this.data.checkpoint = null;\n      this.commit();\n      return true;\n    }\n  }\n  I.Vault = Vault;\n  class Controls {\n    constructor(game) {\n      this.game = game;\n      this.contacts = new Map();\n      this.touchMove = [0, 0];\n      this.touchAim = [0, 0];\n      this.mouseActive = false;\n      this.lastMouse = [-100, -100];\n      this.aims = {};\n      this.enabled = true;\n      this.intent = () => {};\n      const cv = game.screen.canvas;\n      if (!cv) return;\n      const wake = (e) => {\n        const deliberate =\n          e.type !== 'pointermove' ||\n          (e.pointerType === 'mouse' &&\n            Math.hypot(\n              e.clientX - this.lastMouse[0],\n              e.clientY - this.lastMouse[1],\n            ) > 6);\n        if (deliberate) this.intent(e);\n      };\n      addEventListener('keydown', wake, { capture: true });\n      addEventListener('pointerdown', wake, { capture: true });\n      cv.addEventListener('pointermove', (e) => {\n        if (\n          e.pointerType === 'mouse' &&\n          Math.hypot(\n            e.clientX - this.lastMouse[0],\n            e.clientY - this.lastMouse[1],\n          ) > 5\n        ) {\n          this.mouseActive = true;\n          this.lastMouse = [e.clientX, e.clientY];\n          this.intent(e);\n        }\n        const p = this.contacts.get(e.pointerId);\n        if (p) {\n          p.dx = e.clientX - p.x;\n          p.dy = e.clientY - p.y;\n          this.syncTouch();\n        }\n      });\n      cv.addEventListener('pointerdown', (e) => {\n        if (e.pointerType !== 'touch') return;\n        this.mouseActive = false;\n        game.input.lastDevice = 'touch';\n        if (game.shell?.screen) return;\n        const p = {\n          x: e.clientX,\n          y: e.clientY,\n          dx: 0,\n          dy: 0,\n          side:\n            e.clientX < cv.getBoundingClientRect().width / 2 ? 'move' : 'aim',\n        };\n          expr: 'angry',\n          attack: E.move('cast', (w.phaseTime % 1.6) / 1.6),\n        });\n      }\n      for (const e of w.events) {\n        if (e.id <= this.seenEvent) continue;\n        this.seenEvent = e.id;\n        if (e.type === 'fire') this.rigs.get(e.owner)?.kick(0.2);\n        if (e.type === 'hurt') this.rigs.get(e.owner)?.kick(0.4);\n        if (e.type === 'banish' && !this.game.reduceMotion) this.game.shake(4);\n        if (\n          ['kill', 'catch', 'banish', 'bell', 'hurt', 'portal'].includes(\n            e.type,\n          ) &&\n          e.x !== undefined\n        )\n          this.pulses.push({ ...e, t: 0 });\n      }\n      this.pulses = this.pulses.filter((p) => (p.t += dt) < 1.2);\n      if (this.rigs.size > 180) this.rigs.clear();\n    }\n","exit_code":0,"status":"completed"}}
