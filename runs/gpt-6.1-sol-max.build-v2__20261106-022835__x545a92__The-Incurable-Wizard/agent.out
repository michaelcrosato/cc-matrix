{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"rg -n 'auto|timeUp|setTimeout|remove|runAuto|scenario' harness.html | tail -n 50 && sed -n '8010,8040p' vendor/my-3d2dge.js && sed -n '7778,7788p' vendor/my-3d2dge.js\"","aggregated_output":"12:  body { display: grid; grid-template-rows: auto 1fr; }\n23:  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n26:  .cell__state { margin-left: auto; color: var(--dim); }\n29:  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n37:  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n54:  <button id=\"remove\" type=\"button\">Remove player</button>\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n72:const auto = params.get('auto') === '1';\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n309:  for (const cell of current.cells) removeCell(cell, false);\n314:function removeCell(cell, tellRound = true) {\n319:  cell.frame.remove();\n362:$('timeup').onclick = () => current?.coordinator.timeUp();\n363:$('remove').onclick = () => {\n365:  if (cell) removeCell(cell);\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n383:const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n400:  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n478:    else if (n >= 3) removeCell(state.cells[n - 1]);\n496:    if (!state.record) state.coordinator.timeUp();\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n544:if (auto) conformance();\n    const g = this._game; this._fr = { perf, acc: g._acc };\n    const C = this.song, c = this.ctx; if (!C || !C.anchor || !c || c.state !== 'running' || (C.sync && (g.paused || g.hitstop > 0))) return;\n    const ts = c.getOutputTimestamp && c.getOutputTimestamp(), ok = ts && ts.performanceTime > 0 && ts.contextTime > 0;\n    const heard = ok ? ts.contextTime : c.currentTime - (c.outputLatency || c.baseLatency || 0), p = ok ? ts.performanceTime : performance.now();\n    const err = heard - (C.anchor.ctx + (this._clockNow(C, p) - C.anchor.clk));\n    this.drift = err;\n    const big = Math.abs(err) > .01;\n    if (big && C.big) { C.anchor.ctx += err; C.drift = 0; C.big = false; this.anchors++; return; }   // (anchored again)\n    if ((C.big = big)) return;\n    C.drift += (err - C.drift) * .2;\n    if (Math.abs(C.drift) > .004) { C.anchor.ctx += C.drift; C.drift = 0; this.anchors++; }\n  }\n  _note(t, i, time, spb, bus) {\n    const tok = t.tokens[i]; if (tok === '.' || tok === '-' || tok === '_') return;\n    const vol = t.vol === undefined ? .18 : t.vol;\n    if (t.wave === 'drums' || t.wave === 'noise') {\n      const kit = DRUMS[tok[0].toLowerCase()]; if (!kit) { warn('drum:' + tok, 'music: drum token \"' + tok + '\" is unknown (k s h o c t or .)'); return; }\n      for (const v of kit) this._voice(Object.assign({}, v, { vol: v.vol * vol / .18 }), bus, time);\n      return;\n    }\n    let n = 1; while (i + n < t.tokens.length && t.tokens[i + n] === '-') n++;\n    const f = noteFreq(tok); if (!f) { warn('note:' + tok, 'music: \"' + tok + '\" is not a note (use C4, F#3, Bb2, \".\" for rest, \"-\" to hold)'); return; }\n    this._voice({ wave: t.wave || 'square', freq: f * Math.pow(2, t.octave || 0), dur: n * spb * (t.gate || .9), vol, hold: true, attack: .006, vib: t.vib }, bus, time);\n  }\n}\n/** ready-made chiptune loops (original compositions): title, adventure, dungeon, boss, victory. game.audio.music('adventure') */\nE.songs = {\n  title: { bpm: 112, steps: 4, tracks: [\n    { wave: 'square', vol: .16, notes: 'C5 - - - G4 - C5 - E5 - - - D5 - C5 - | D5 - - - G4 - B4 - D5 - - - F5 - E5 - | E5 - - - C5 - E5 - G5 - - - A5 - G5 - | F5 - E5 - D5 - B4 - C5 - - - - - . .' },\n    { wave: 'triangle', vol: .3, notes: 'C3 - . C3 G2 - . G2 C3 - . C3 G2 - . G2 | G2 - . G2 D3 - . D3 G2 - . G2 D3 - . D3 | A2 - . A2 E3 - . E3 A2 - . A2 E3 - . E3 | F2 - . F2 G2 - . G2 C3 - . C3 G2 - . .' },\n    { wave: 'drums', vol: .14, notes: 'k . h . s . h . k . h k s . h .' } ] },\n  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || this.ducked ? .35 : 1); this._voiceBus.gain.value = this.voiceVolume; }\n  /** a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument)\n   *  to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is\n   *  voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio) */\n  bus(name = 'sfx') {\n    if (!['sfx', 'music', 'voice', 'master'].includes(name)) warn('bus:' + name, 'audio.bus(\"' + name + '\"): no such bus (sfx, music, voice, master): the sfx bus');\n    if (this._game.headless || !this._init()) return null;\n    return name === 'master' ? this._master : name === 'music' ? this._musBus : name === 'voice' ? this._voiceBus : this._sfxBus;\n  }\n  /** set the master volume, 0..1 */\n  setVolume(v) { this.volume = clamp(v, 0, 1); this.applyVolume(); }\n","exit_code":0,"status":"completed"}}
