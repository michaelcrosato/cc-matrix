{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"sed -n '1160,1199p' vendor/my-3d2dge.js && sed -n '4728,4748p' vendor/my-3d2dge.js && sed -n '4823,4834p' vendor/my-3d2dge.js && sed -n '3770,3808p' vendor/my-3d2dge.js\"","aggregated_output":"  screenPoint(cx, cy) {\n    const S = this.screen; if (!S.canvas) return null;\n    const rc = S.canvas.getBoundingClientRect(); return [((cx - rc.left) * S.dpr - S.OX) / S.S, ((cy - rc.top) * S.dpr - S.OY) / S.S];\n  }\n  /** advance input by one step: read the gamepad and turn presses since the last step into this step's pressed() and\n   *  released() (the engine calls it every step) */\n  tick(dt) {\n    this._suppressed.clear();\n    this.clock += dt;\n    let pads = [];\n    try { pads = navigator.getGamepads ? navigator.getGamepads() : []; } catch (e) { /* gamepads blocked */ }\n    const C = this._claimed, ok = p => p && p.connected !== false && (this.pad === 'any' ? !(C && C.has(p.index)) : p.index === this.pad);   // (its own pad, or any another player hasn't)\n    const p = this.pad === null ? null : Array.from(pads || []).find(p => ok(p) && p.index === this.padIndex) || Array.from(pads || []).find(ok);\n    this.padLost = false;\n    if (!p || p.index !== this.padIndex || p.id !== this.padId) {\n      if (!p && this.padIndex !== null) { this.padLost = this.lastDevice === 'gamepad'; this.stopRumble(); }   // unplugged while in use\n      if (this.padIndex !== null) { this.padPrev.forEach((on, i) => { if (on) this.release('Pad' + i); }); for (const c of ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight', 'PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight']) this.release(c); }   // (a pad gone or changed lets go once; with none, a script's pad codes stay held)\n      this.padPrev = []; this.padMove = [0, 0]; this.padAim = null; this.padAxes = []; this.padValues = [];\n      this.padIndex = p ? p.index : null; this.padId = p ? p.id : '';\n      if (this.aimSource === 'pad') this.aimSource = 'move';\n    }\n    if (p) {\n      const dz = (x, y) => { const l = Math.hypot(x, y), d = clamp(this.deadzone, 0, .8); return l <= d ? [0, 0] : [x / l * Math.min(1, (l - d) / (1 - d)), y / l * Math.min(1, (l - d) / (1 - d))]; };\n      this.padAxes = Array.from(p.axes);\n      this.padMove = dz(p.axes[0] || 0, p.axes[1] || 0); if (this.invertMoveX) this.padMove[0] *= -1; if (this.invertMoveY) this.padMove[1] *= -1;   // (the Controller settings: a stick worn the wrong way)\n      const aim = dz(p.axes[2] || 0, p.axes[3] || 0);\n      this.padAim = Math.hypot(...aim) > 0 ? [aim[0], aim[1] * (this.invertAimY ? -1 : 1)] : null;\n      this.padValues = p.buttons.map(b => b.value || (b.pressed ? 1 : 0));\n      const ra = this.padAim || [0, 0], rd = [ra[1] < -.5, ra[1] > .5, ra[0] < -.5, ra[0] > .5];\n      ['PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight'].forEach((c, i) => rd[i] ? this.press(c) : this.release(c));   // (the right stick past halfway: codes to bind)\n      if (this.padAim || Math.hypot(...this.padMove) > 0) { this.aimSource = 'pad'; this.lastDevice = 'gamepad'; }\n      p.buttons.forEach((b, i) => { const on = b.pressed; if (on && !this.padPrev[i]) this.press('Pad' + i); if (!on && this.padPrev[i]) this.release('Pad' + i); this.padPrev[i] = on; });\n      const dirs = [this.padMove[1] < -.5, this.padMove[1] > .5, this.padMove[0] < -.5, this.padMove[0] > .5];\n      ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight'].forEach((c, i) => dirs[i] ? this.press(c) : this.release(c));\n    }\n    // a tap is held for the one step after it (its release comes the step after that)\n    for (const c of this._tapsDue) if (!this._holds.has(c)) this.release(c);\n    const due = this._tapsDue; due.clear(); this._tapsDue = this._taps; this._taps = due;\n    // presses since the last step become this step's pressed()/released()\n    const n = this._now; n.clear(); this._now = this._fresh; this._fresh = n; this._freshCodes.clear();\n  // what a weapon's draw(w) gets: w.style ('hd' | 'classic'), g, the rig and its o, C, J, Q (the joints on screen: [x, y,\n  // depth]), Sp(joint, f, r, z) (a point near a joint, projected), u (screen pixels a unit), at(t, dx, dy, dz) (the point\n  // t units along it from the hand, nudged), hand (Q.handR), push(depth, fn) (drawn in depth order with the body), cap\n  // (the HD style's capsule), and the raw hd (J.handR), bd (its direction), ops\n  _weaponDraw(style, g, Q, Sp, u, ops, cap) {\n    const J = this.J, hd = J.handR, bd = J.bladeDir;\n    return { style, g, rig: this, o: this.o, C: this.C, J, Q, Sp, u, ops, cap, hd, bd, hand: Q.handR, at: (t, dx = 0, dy = 0, dz = 0) => Sp(hd, bd[0] * t + dx, bd[1] * t + dy, bd[2] * t + dz), push: (d, f) => ops.push({ d, f }) };\n  }\n  // o.draw: { under(g, Q, rig), over(g, Q, rig) }: the game's own drawing before and after the body (Q: the joints on screen)\n  _drawHooks(g, Q, ops) { const D = this.o.draw; if (D.under) ops.push({ d: -1e9, f: () => D.under(g, Q, this) }); if (D.over) ops.push({ d: 1e9, f: () => D.over(g, Q, this) }); }\n  /** motion smear for the current swing, queued in front of the rig */\n  drawSmear(r, colors = ['#ffffff', '#dff8ff', '#8fe0f2', '#4bb1d4']) {\n    const T = this.trail;\n    if (T.length >= 2) {   // ribbon along the real blade path: correct in side, top-down and every other view\n      r.queue(this.x, this.y, this.z + 1, g => {\n        const lv = this.lastView, cv = lv && lv.id === r.view.id ? lv : this.o.charView !== false ? charView(r.view) : r.view;   // the angle the rig was drawn from\n        const W = cv === r.view ? (p, w) => r.w(w[0], w[1], w[2]) : (p, w) => { const s = r.w(p.o[0], p.o[1], p.o[2]), q = cv.p(w[0] - p.o[0], w[1] - p.o[1], w[2] - p.o[2]); return [s[0] + q[0], s[1] + q[1]]; };\n        px.glow(g, .85);\n        const n = T.length - 1, taper = (p, u) => V3.lerp(p.t, p.b, .25 + .75 * u);   // older samples are narrower\n        for (let i = 0; i < n; i++) {\n          const p0 = T[i], p1 = T[i + 1], f = 1 - p1.age / .14, u0 = i / n, u1 = (i + 1) / n;\nHUMANOID_WEAPONS.gun = { length: 5, rest: [.8, 0, -.6], blade: false, draw(w) {\n  const { g, C, J, Q, Sp, ops, cap, o } = w, u = w.u, sc = w.u;\n  if (w.style === 'hd') {\n    const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, mz = Sp(hd, bd[0] * 5.5, bd[1] * 5.5, bd[2] * 5.5), gp = Sp(hd, -bd[0] * .6, -bd[1] * .6, -bd[2] * .6 - 1.4), m = tones(C.metal);\n    ops.push({ d: Hn[2] + .03, f: () => { cap(Hn, gp, .8 * u, .7 * u, m.deep); cap(Hn, mz, .95 * u, .75 * u, m.sh); cap(Hn, mz, Math.max(.4, .95 * u - .8), Math.max(.4, .75 * u - .8), m.base, -.5, -.5); px.dot(g, mz[0], mz[1], '#ffffff'); } });\n  } else {\n    const hd = J.handR, bd = J.bladeDir, Hn = Q.handR, mz = Sp(hd, bd[0] * 5, bd[1] * 5, bd[2] * 5), gp = Sp(hd, -bd[0] * .6, -bd[1] * .6, -bd[2] * .6 - 1.2);\n    ops.push({ d: Hn[2] + .03, f: () => { px.line(g, Hn[0], Hn[1], gp[0], gp[1], C.metalDk, 2); px.line(g, gp[0], gp[1], mz[0], mz[1], C.metalDk, 2); px.line(g, Hn[0], Hn[1] - 1, mz[0], mz[1] - 1, C.metal); px.dot(g, mz[0], mz[1], '#ffffff'); } });\n  }\n} };\nHUMANOID_WEAPONS.staff = { length: 10, rest: [.3, .15, 1], blade: false, draw(w) {\n  const { g, C, J, Q, Sp, ops, cap, o } = w, u = w.u, sc = w.u;\n  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\n  q.use(_pPreset(this, q));\n  if (!this.settings.spec('playerBindings')) this.settings.define({ key: 'playerBindings', group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { for (const p of g.players.slice(1)) p.bindings = (v || {})[p.player] || {}; } });\n  q.bindings = (this.settings.playerBindings || {})[n] || {};\n  q._onBindings = b => this.settings.set('playerBindings', Object.assign({}, this.settings.playerBindings, { [n]: b }));\n  P.push(q); _pClaim(this);\n  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\n  this.note(q.name + ' JOINED', 1.5); this.audio.sfx('confirm');\n  return q;\n};\n/** a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it */\nGame.prototype.removePlayer = function (p) {\n  const P = this.players, i = typeof p === 'number' ? p - 1 : P.indexOf(p); if (i < 1 || i >= P.length) return;\n  P.splice(i, 1); P.forEach((q, k) => { q.player = k + 1; q.name = 'P' + (k + 1); q.color = E.PLAYER_COLORS[k]; });\n  const I = P[0]; if (I.half && !P.some(q => q !== I && q.half)) { I.half = null; I.use(I._full || I.preset); I._full = null; }\n  _pClaim(this);\n};\n/** split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide\n *  screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 } */\nGame.prototype.splitScreen = function (n, o = {}) {\n  if (!(n >= 2)) { this._split = null; return this; }\n  const prev = this._split, vps = Array.from({ length: Math.min(4, n) }, (_, i) => (prev && prev.vps[i]) || _vp(i));\n  this._split = { layout: o.layout || 'auto', gap: o.gap === undefined ? 1 : o.gap, vps };\n  if (o.follow) o.follow.forEach((t, i) => vps[i] && vps[i].follow(t, o));\n  _vpLayout(this); return this;\n};\n// a viewport: where it is on the screen, and its camera (as game.cam: a focus it eases to, the bounds of game.cam)\nfunction _vp(i) {\n  const v = { i, x: 0, y: 0, w: 0, h: 0, target: null, z: 16, cam: { tx: 0, ty: 0, tz: 0, x: undefined, y: 0, vx: 0, vy: 0, smooth: .12, snap: true, bounds: null } };\n  /** look at a world point */\n  v.focus = (x, y, z = 0) => { v.target = null; Object.assign(v.cam, { tx: x, ty: y, tz: z }); };\n  /** keep the camera on an object ({ x, y, z }); o.z: the height looked at (16) */\n  v.follow = (t, o = {}) => { v.target = t || null; if (o.z !== undefined) v.z = o.z; v.cam.snap = true; };\n  return v;\n}\nfunction _vpLayout(game) {\n  const S = game._split, n = S.vps.length, W = game.screen.W, H = game.screen.H, g = S.gap;\n  const mode = S.layout === 'auto' ? (n > 2 ? 'grid' : W >= H ? 'columns' : 'rows') : S.layout;\n  S.vps.forEach((v, i) => {\n","exit_code":0,"status":"completed"}}
