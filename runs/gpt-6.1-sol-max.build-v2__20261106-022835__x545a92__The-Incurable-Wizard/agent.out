.shownNote = { text: String(text), end: this.real + seconds }; }\n  /** pause the game, saying why ('player' | 'focus' | 'controller' | 'menu': pauseReason); returns true if it paused.\n   *  The player resumes (Escape, Start, Resume); resume() does it from code */\n  pause(reason = 'player') { this.input.stopRumble(); if (this.paused) return false; this.paused = true; this.pauseReason = reason; return true; }\n  _ownRun(kind, ...a) { const L = this._own && this._own[kind]; if (L) for (const f of L.slice()) try { f(...a); } catch (e) { this.fail('hook ' + kind, e); } }\n  /** take the game out of pause (and close the pause screen) */\n  resume() { this.paused = false; this.pauseReason = null; this._goOn = false; }\n  /** a pausable scene in play pauses when the page is hidden, the window loses focus or the controller is unplugged\n   *  (new E.Game({ autoPause: false }) turns that off); coming back never resumes by itself */\n  _autoPause(reason) { this.input.stopRumble(); return this.o.autoPause !== false && !!this.scene && !!this.scene.pausable && this.pause(reason); }\n  /**\n   * open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without\n   * scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or\n    if (ok('input')) this.input.use(s.input);\n    if (ok('res') || ok('expand')) this.screen.setOptions(Object.assign(ok('res') ? { res: s.res } : {}, ok('expand') ? { expand: s.expand } : {}));\n    if (ok('touch')) this.input.touchButtons(s.touch);\n    ok('camera');\n    if (s.propSize !== undefined) { s._propWas = E.style.propSize; E.style.propSize = s.propSize; }   // scene option: prop scale while this scene runs\n    this._zoomFit(true);   // its camera: its zoom to start at, and whether the player's applies\n    if (s.pausable || name === 'main') this._fsAuto = this._autoFull();   // a game starting from a tap goes full screen again\n    for (const f of HOOKS.enter) f(this, old);\n    this._ownRun('enter', name, data);\n    if (s.enter) s.enter(data);\n  }\n  /** report an error in game code without stopping the game: logged once per place and message, kept in game.errors\n   *  and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err) */\n  fail(where, e) {\n    const msg = (e && e.message) || String(e), key = where + ':' + msg;\n    if (!this._errKeys.has(key)) {\n      this._errKeys.add(key); this.errors.push({ where, scene: this.sceneName, message: msg, stack: e && e.stack });\n      console.error('my-3D2dge: error in ' + where + (this.sceneName ? ' (scene \"' + this.sceneName + '\")' : '') + ': ' + ((e && e.stack) || msg));\n    }\n    E.showError('error in ' + where + '()' + (this.sceneName && this.sceneName !== 'main' ? ' of scene \"' + this.sceneName + '\"' : ''), e);\n    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n      this.focus(t.x + dir[0] * f.lead, (t.y || 0) + dir[1] * f.lead, (t.z || 0) + f.z);\n    }\n    this.particles.update(dt);\n    if (this.cam.free) this._freeCam(dt);\n    this._camStep(dt);\n  }\n  // a screen-pixel move [dx, dy] as the ground's (world x, y) at the zoom the player sees (during a zoom's preview, the goal)\n  _screenToGround(dx, dy) {\n    const v = this.view, k = this.zoom / (this._zoomTo || this.zoom);\n    return v.inv ? [(v.inv[0] * dx + v.inv[1] * dy) * k, (v.inv[2] * dx + v.inv[3] * dy) * k] : [dx / (v.ax || 1) * k, 0];\n  }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > src/platform.js <<'EOF'\n(function(root){\n'use strict';const I=root.IW;\nI.PRESET={up:['KeyW','ArrowUp','Pad12','PadAxisUp'],down:['KeyS','ArrowDown','Pad13','PadAxisDown'],left:['KeyA','ArrowLeft','Pad14','PadAxisLeft'],right:['KeyD','ArrowRight','Pad15','PadAxisRight'],moveUp:['KeyW','Pad12','PadAxisUp'],moveDown:['KeyS','Pad13','PadAxisDown'],moveLeft:['KeyA','Pad14','PadAxisLeft'],moveRight:['KeyD','Pad15','PadAxisRight'],aimUp:['ArrowUp','PadRAxisUp'],aimDown:['ArrowDown','PadRAxisDown'],aimLeft:['ArrowLeft','PadRAxisLeft'],aimRight:['ArrowRight','PadRAxisRight'],fire:['Space','Mouse0','Pad7','Pad0'],confirm:['Enter','Space','Pad0'],cancel:['Escape','Backspace','Pad1'],start:['Enter','Pad9'],pause:['Escape','KeyP','Pad9']};\nclass Vault{\n constructor(storage){this.storage=storage;this.memory={};this.key='incurable:v1';this.data={v:1,records:{},checkpoint:null};try{const s=storage?.getItem(this.key);if(s){const d=JSON.parse(s);if(d.v===1&&d.records&&typeof d.records==='object')this.data=d;}}catch{} }\n commit(){try{this.storage?.setItem(this.key,JSON.stringify(this.data));}catch{} }\n save(world){if(world.config.context\"'!=='\"'campaign'||world.practice)return;this.data.checkpoint=world.export();this.commit();}\n clear(){this.data.checkpoint=null;this.commit();}\n record(world){if(world.config.context\"'!=='\"'campaign'||world.practice||world.status\"'!=='\"'victory')return false;const k=world.config.difficulty+(world.config.assistance?':assisted':':standard');this.data.records[k]=Math.max(this.data.records[k]||0,world.score);this.data.checkpoint=null;this.commit();return true;}\n}\nI.Vault=Vault;\nclass Controls{\n constructor(game){this.game=game;this.contacts=new Map();this.touchMove=[0,0];this.touchAim=[0,0];this.mouseActive=false;this.lastMouse=[-100,-100];this.aims={};this.enabled=true;this.intent=()=>{};const cv=game.screen.canvas;if(\"'!cv)return;\n const wake=e=>{const deliberate=e.type!=='\"'pointermove'||(e.pointerType==='mouse'&&Math.hypot(e.clientX-this.lastMouse[0],e.clientY-this.lastMouse[1])>6);if(deliberate)this.intent(e);};\n addEventListener('keydown',wake,{capture:true});addEventListener('pointerdown',wake,{capture:true});\n cv.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'&&Math.hypot(e.clientX-this.lastMouse[0],e.clientY-this.lastMouse[1])>5){this.mouseActive=true;this.lastMouse=[e.clientX,e.clientY];this.intent(e);}const p=this.contacts.get(e.pointerId);if(p){p.dx=e.clientX-p.x;p.dy=e.clientY-p.y;this.syncTouch();}});\n cv.addEventListener('pointerdown',e=>{if(e.pointerType\"'!=='\"'touch')return;this.mouseActive=false;game.input.lastDevice='touch';if(game.shell?.screen)return;const p={x:e.clientX,y:e.clientY,dx:0,dy:0,side:e.clientX<cv.getBoundingClientRect().width/2?'move':'aim'};this.contacts.set(e.pointerId,p);cv.setPointerCapture?.(e.pointerId);e.preventDefault();this.syncTouch();});\n const end=e=>{this.contacts.delete(e.pointerId);this.syncTouch();};cv.addEventListener('pointerup',end);cv.addEventListener('pointercancel',end);addEventListener('blur',()=>this.clear());\n // The native stick renderer stays hidden. Gameplay uses the two anchored, invisible contacts above.\n game.input.touchEnabled=false;game.input.touchButtons([]);game.input.touchFilter=()=>false;\n }\n syncTouch(){this.touchMove=[0,0];this.touchAim=[0,0];for(const p of this.contacts.values()){const v=[p.dx/40,p.dy/40];if(p.side==='move')this.touchMove=v;else this.touchAim=v;}}\n clear(){this.contacts.clear();this.syncTouch();this.mouseActive=false;for(const i of this.game.players)i.clear();}\n sample(world,p,input=this.game.input){if(\"'!p||!p.alive||!this.enabled||this.game.shell?.screen)return{move:-1,aim:-1,fire:false};const val=a=>input.value(a)||0;let mx=val('\"'moveRight')-val('moveLeft'),my=val('moveDown')-val('moveUp');let ax=val('aimRight')-val('aimLeft'),ay=val('aimDown')-val('aimUp');\n if(input.padMove?.some(n=>Math.abs(n)>.1)){[mx,my]=input.padMove;this.mouseActive=false;}if(input.padAim){[ax,ay]=input.padAim;this.mouseActive=false;}\n const touch=input===this.game.input&&(input.lastDevice==='touch'||this.contacts.size>0);if(touch){[mx,my]=this.touchMove;[ax,ay]=this.touchAim;}\n let aim=I.cardinal(ax,ay,this.aims[p.id]??-1);if(aim>=0)this.aims[p.id]=aim;\n if(input===this.game.input&&this.mouseActive&&\"'!touch&&input.lastDevice!=='\"'gamepad'){const m=this.game.mouseGround();if(m)aim=I.cardinal(m[0]-I.world(p.m.x),m[1]-I.world(p.m.y),this.aims[p.id]??-1,5);if(aim>=0)this.aims[p.id]=aim;}\n const move=I.cardinal(mx,my,p.face,.25);let fire=input.down('fire')||touch&&Math.hypot(ax,ay)>.5;\n if(touch&&this.game.settings.assistance){const targets=[...world.enemies.filter(e=>world.visible(e)&&e.warning<=0).map(e=>({x:e.m.x,y:e.m.y})),...(world.familiar?[{x:world.familiar.m.x,y:world.familiar.m.y}]:[]),...(world.wizard?.state==='active'?[world.wizard]:[])];const t=targets.find(t=>world.los(p,t));if(t&&world.tuning.touchAssist){aim=I.cardinal(t.x-p.m.x,t.y-p.m.y);fire=true;}}\n return{move,aim,fire};}\n}\nI.Controls=Controls;\nclass Network{\n constructor(app,hub){this.app=app;this.hub=hub;this.active=\"'!!hub?.active;this.started=false;this.ended=false;this.finished=false;this.seq=0;this.lastSnap=-1;this.pending={};this.recvSeq={};this.lastInput={};this.sendClock=0;this.inputClock=0;this.maxBytes=0;this.sent=0;this.rng=null;}\n async connect(){const h=this.hub;if(!h)return null;\n h.on('\"'start',()=>{this.started=true;});h.on('message',(d,from)=>this.receive(d,from));h.on('leave',({id})=>{if(this.ended)return;delete this.pending[id];this.seats=this.seats?.filter(s=>s\"'!==id);if(h.isHost)this.app.world?.removeSeat(id);});h.on('\"'time-up',()=>{if(h.isHost)this.finish(false);});h.on('end',()=>{this.ended=true;this.started=false;this.pending={};this.app.controls.clear();this.app.audio.stop();this.app.game.input.clear();});\n const info=await h.connect({mode:'shared-world',seats:[1,2]});if(\"'!info){this.active=false;return null;}this.active=true;this.info=info;this.seats=info.players.map(p=>p.id);this.rng=h.rng('\"'simulation');this.app.begin('Normal',this.seats,'hub',Math.floor(this.rng()*4294967295)||1);if(h.isHost)this.app.world.externalRng=this.rng;this.app.game.live=true;this.app.game.o.autoPause=false;this.app.game.o.menu.quit=false;h.ready();return info;}\n valid(c){return c&&Number.isInteger(c.move)&&c.move>=-1&&c.move<=3&&Number.isInteger(c.aim)&&c.aim>=-1&&c.aim<=3&&typeof c.fire==='boolean';}\n receive(d,from){if(\"'!this.active||this.ended||!d||d.v!==1)return;const h=this.hub;if(h.isHost){if(d.type!=='\"'input'||\"'!this.seats.includes(from)||from===h.host||!Number.isSafeInteger(d.seq)||d.seq<0||d.seq<=(this.recvSeq[from]??-1)||!this.valid(d.cmd))return;this.recvSeq[from]=d.seq;this.pending[from]=d.cmd;this.lastInput[from]=this.app.game.real;}else if(from===h.host&&d.type==='\"'world'&&Number.isSafeInteger(d.tick)&&d.tick>this.lastSnap&&d.state?.v===1){try{this.app.world.restore(d.state);this.lastSnap=d.tick;}catch{} }}\n send(d,to){const n=JSON.stringify(d).length;this.maxBytes=Math.max(this.maxBytes,n);if(n>16384)return false;const ok=this.hub.send(d,{to,reliable:true});if(ok)this.sent++;return ok;}\n step(dt,local){if(\"'!this.active||this.ended||!this.started||this.hub.time()<0)return;const h=this.hub;this.sendClock+=dt;this.inputClock+=dt;\n if(h.isHost){const cmds={};for(const seat of this.seats)cmds[seat]=seat===h.me?local:(this.app.game.real-(this.lastInput[seat]??-100)<.65?this.pending[seat]:{move:-1,aim:-1,fire:false});this.app.world.step(dt,cmds);\n if(this.sendClock>=.1){this.sendClock%=.1;const s=this.app.world.export(false);delete s.ledger;s.events=s.events.slice(-12);this.send({v:1,type:'\"'world',tick:this.app.world.tick,ack:this.recvSeq,state:s});}\n if(['victory','defeat'].includes(this.app.world.status))this.finish(this.app.world.status==='victory');\n }else if(this.inputClock>=1/15){this.in