ntrusions)this.nextWizard(.8);else{this.earnedNextMultiplier=Math.min(4,this.earnedNextMultiplier*2);this.wizard=null;this.clearRoom();}}}\n lightning(){const w=this.wizard,p=this.players.filter(p=>p.alive).sort((a,b)=>Math.hypot(a.m.x-w.x,a.m.y-w.y)-Math.hypot(b.m.x-w.x,b.m.y-w.y))[0];if(\"'!p)return;const aim=I.cardinal(p.m.x-w.x,p.m.y-w.y),dirs=w.stage===1?[aim,(aim+2)%4]:w.stage===2?[aim,(aim+1)%4,(aim+3)%4]:[aim];for(const a of dirs){const d=D[a];this.pool.fire({id:this.nextId++,x:W(w.x)+d[0]*7,y:W(w.y)+d[1]*7,z:7,vx:d[0]*80,vy:d[1]*80,r:2,team:'\"'hostile',life:5,color:'#f78cad'});}this.emit('lightning',{x:W(w.x),y:W(w.y),dirs});}\n banish(p){const w=this.wizard;if(\"'!w||w.state!=='\"'active')return;this.award('wizard:'+w.id,2500,p);this.banishments++;this.wizardHits++;w.state='banished';w.t=1.5;this.pool.list=this.bolts.filter(b=>b.team==='player');this.emit('banish',{x:W(w.x),y:W(w.y),stage:w.stage});}\n clearRoom(){this.setPhase('Clear');this.phaseDelay=3.2;this.pool.clear();for(const p of this.players)p.bolt=null;this.emit('clear',{next:this.earnedNextMultiplier});}\n descend(){if(this.phase\"'!=='\"'Clear')return false;\n if(this.roomIndex===5){this.status='victory';const key='exit-bounty';if(\"'!this.ledger[key]){this.ledger[key]=true;this.score+=this.room.bounty*this.earnedNextMultiplier;}this.emit('\"'victory',{bounty:this.room.bounty*this.earnedNextMultiplier});return true;}\n this.currentMultiplier=this.earnedNextMultiplier;for(const p of this.players){if(p.lives<=0){p.lives=1;p.alive=true;}if([2,3].includes(this.roomIndex))p.lives=Math.min(I.DIFFICULTY[this.config.difficulty].lives,p.lives+1);}this.loadRoom(this.roomIndex+1);return true;}\n step(dt,commands={}){if(this.status\"'!=='\"'playing'||dt<=0)return;this.tick++;this.elapsed+=dt;this.roomTime+=dt;this.phaseTime+=dt;\n for(const p of this.players){p.age+=dt;p.protect=Math.max(0,p.protect-dt);if(\"'!p.alive&&p.lives>0){p.respawn-=dt;if(p.respawn<=0)this.respawn(p);}if(p.alive)this.move(p,comma