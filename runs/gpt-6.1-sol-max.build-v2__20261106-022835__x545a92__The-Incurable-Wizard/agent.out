ll:{wave:'sine',freq:880,to:876,dur:1.1,vol:.25,arp:[0,12,7],step:.065},portal:{wave:'triangle',freq:180,to:1400,dur:.28,vol:.18},chase:{wave:'pulse12',freq:650,to:1350,dur:.3,vol:.18},teleport:{wave:'saw',freq:900,to:140,dur:.35,vol:.12},lightning:{wave:'noise',freq:1800,to:80,dur:.15,vol:.13},lightningBlock:{wave:'sine',freq:1400,to:700,dur:.12,vol:.15},hurt:{wave:'square',freq:280,to:45,dur:.4,vol:.2},catch:{wave:'triangle',freq:500,to:1800,dur:.3,vol:.22,arp:[0,4,7,12],step:.05},banish:{wave:'saw',freq:65,to:750,dur:.6,vol:.2,arp:[0,7,12],step:.1},escape:{wave:'triangle',freq:600,to:180,dur:.3,vol:.15},respawn:{wave:'sine',freq:300,to:900,dur:.4,vol:.16}};\nI.SONGS=songs;I.FX=fx;\nclass Sound{\n constructor(game){this.game=game;this.key=null;this.lastEvent=0;this.voiceHandles=[];this.stopped=false;this.lastFoot=-1;}\n music(key){if(this.key===key)return;this.key=key;this.game.audio.music(key?songs[key]:null,{sync:true});}\n update(world,dt,quiet=false){if(this.stopped)return;let key=\"'!world?'\"'title':world.status==='victory'?'victory':world.status==='defeat'?'defeat':world.phase==='Familiar'?'chase':world.phase==='Intrusion'?'wizard':'hunt';this.music(key);\n if(\"'!world)return;for(const e of world.events){if(e.id<=this.lastEvent)continue;this.lastEvent=e.id;if(quiet)continue;const f=fx[e.type];if(f)this.game.audio.sfx(f,{pan:e.x===undefined?0:Math.max(-.8,Math.min(.8,(e.x/336-.5)*1.6))});if(['\"'entry','apparition','banish'].includes(e.type))this.voice(e.id);}\n const beat=Math.floor(world.roomTime*(1+Math.min(.3,world.roomTime*.003)));if(beat\"'!==this.lastFoot&&world.enemies.some(e=>e.kind!=='\"'hopper'&&\"'!world.visible(e))){this.lastFoot=beat;if(!quiet)this.game.audio.sfx({wave:'\"'sine',freq:85,to:42,dur:.12,vol:.045});}\n }\n voice(seed){const a=this.game.audio;for(let i=0;i<5;i++){const n=(seed*31+i*17)%7;this.voiceHandles.push(a.sfx({wave:i%2?'triangle':'pulse12',freq:170+n*38,to:240+n*23,dur:.055+n*.008,vol:.055,arp:[0,n%3+2],step:.035},{step:i*.0