ath.max(0,shakeTime-dt);if(shakeTime>0){const s=shakeTime*settings.shake*.18;cameraPosition.x+=Math.sin(ambientTime*71)*s;cameraPosition.y+=Math.cos(ambientTime*83)*s}camera.position.copy(cameraPosition);camera.lookAt(cameraTarget.x,.3,cameraTarget.z);shadowLight.position.set(cameraTarget.x-18,30,cameraTarget.z+10);shadowLight.target.position.copy(cameraTarget);shadowLight.target.updateMatrixWorld();\n  const opacity=parseFloat($('\"'hitflash').style.opacity)||0;if(opacity>0)\"'$('\"'hitflash').style.opacity=Math.max(0,opacity-dt*2);if(game.toastTimer>0){game.toastTimer-=dt;if(game.toastTimer<=0)\"'$('\"'toast').classList.remove('visible')}if(game.dialogue){game.dialogue.time-=dt;if(game.dialogue.time<=0)game.dialogue=null}\n}\nfunction snapshot(){return{title:TITLE,status:game.status,phase:game.phase,attract:game.attract,elapsed:game.elapsed,score:game.score,treasures:game.treasures,kills:game.kills,gateOpen:game.gateOpen,hasRelic:game.hasRelic,cleanSwap:game.cleanSwap,balanceHits:game.balanceHits,balanceMisses:game.balanceMisses,balanceNeedle:balanceNeedle(),checkpoint:{...game.checkpoint},screen:ui.screen,input:controls.lastDevice,renderer:renderer?.backend?.isWebGPUBackend?'WebGPU':'WebGL2',physics:'Rapier 0.19.3',players:game.players.map(p=>({id:p.id,name:p.name,x:p.x,y:p.y,z:p.z,hp:p.hp,ammo:p.ammo,down:p.down,grounded:p.grounded,action:p.action,grapple:\"'!!p.grapple})),enemies:worldObjects.enemies.map(e=>({id:e.id,kind:e.kind,x:e.x,z:e.z,hp:e.hp,dead:e.dead})),mirrors:worldObjects.mirrors.map(m=>({rotation:m.rotation,correct:m.correct,powered:m.powered})),boulder:{active:worldObjects.boulder.active,z:worldObjects.boulder.z,started:game.boulderStarted},audio:{...audio.played,level:audio.level,musicVolume:settings.music,state:audio.ctx?.state||'\"'locked'},hub:{active:AIHub.active,isHost:hubInfo?.isHost,server:hubInfo?.server,started:hubStarted,ended:hubEnded},tuning:{...tuning},god:game.god,noclip:game.noclip}}\nfunction makeNetSnapshot(){return{t:'w',seq:++n