mera).then(()=>{drawReady=true}).catch(error=>{window.__gameError=String(error);AIHub.fail('\"'Graphics warm-up failed: '+error.message)})}if(drawReady&&renderer)renderer.render(scene,camera);requestAnimationFrame(frame);\\\")\nopen(p,'w').write(s)\np='tests/run.py';s=open(p).read();s=s.replace(\\\"check('Any input exits attract to title',state(p)['status']=='title' and not state(p)['attract'])\\\", \\\"check('Any input exits attract to title',state(p)['status']=='title' and not state(p)['attract'],str(state(p)))\\\")\ns=s.replace(\\\"p.wait_for_timeout(400);p.evaluate('window.__GG.unlockAudio();window.__GG.audioTick()');p.wait_for_function('window.__GG.snapshot().audio.level>0.000001',timeout=5000);audio=state(p)['audio'];check('Procedural audio produces a signal',audio['state']=='running' and audio['music']>0 and audio['level']>0,str(audio))\\\", \\\"audio=p.evaluate('window.__GG.offlineAudio()');(ART/'audio-levels.json').write_text(json.dumps(audio,indent=2));check('Procedural audio produces a signal',all(v['rms']>.0001 and v['peak']>0 for v in audio.values()) and audio['music']['gain']==.1,str(audio))\\\")\ns=s.replace(\\\"load(p);p.mouse.move(3,3);p.screenshot\\\", \\\"load(p,'?test=1&webgl=1');p.mouse.move(3,3);p.screenshot\\\")\nopen(p,'w').write(s)\nPY\nbash tests/run.sh --suite core > artifacts/core-run.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
