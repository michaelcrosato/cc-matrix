{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"sed -n '38,64p' harness.html; sed -n '220,275p' harness.html; cat artifacts/all-run.log\"","aggregated_output":"  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n    el.append(label, frame);\n    grid.append(el);\n\n    const endpoint = net.endpoint(p.key);\n    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n    const post = postTo(frame);\n    cell.bridge = createBridge({\n      key: p.key,\n      round,\n      coordinator: 'hub',\n      post: (msg) => {\n        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n        post(msg);\n      },\n      net: endpoint,\n      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n      onAnswer: (what) => answerCard(state, cell, what),\n      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n      onProgress: (id, report) => {\n        if (id !== cell.bridge?.me) return;\n        cell.progress.push({ at: performance.now(), ...report });\n        state.coordinator.progress(id, report.score);\n        render(state);\n      },\n    });\n    endpoint.onMessage((from, env) => cell.bridge.fromNet(from, env));\n    cell.detach = attachFrame(frame, (msg) => cell.bridge.fromGame(msg));\n    frame.addEventListener('load', () => instrument(cell), { once: true });\n    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n    state.cells.push(cell);\n  }\n  renderWho(state);\n  render(state);\n  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n  // the conformance run releases it itself.\n  const ticker = setInterval(() => {\n    if (state !== current || state.coordinator.released) return clearInterval(ticker);\n    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n    tickCard(state);\n  }, 250);\n  return state;\n}\n\nfunction releaseRound(state = current) {\n  if (!state || state !== current || state.coordinator.released) return;\n  state.splashUntil = null;\n  tickCard(state);\n  log('splash over: the round starts once every game has loaded');\n  state.coordinator.release();\n}\n\n/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\nfunction tickCard(state) {\n  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\n  const ready = state.cells.filter((c) => state.answers.ready.has(c.key)).map((c) => c.bridge.me);\n","exit_code":0,"status":"completed"}}
