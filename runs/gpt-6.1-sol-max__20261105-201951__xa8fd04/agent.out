{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > tests/serve.py <<'EOF'\nfrom http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler\nfrom pathlib import Path\nimport os,json\nos.chdir(Path(__file__).resolve().parents[1])\nclass Handler(SimpleHTTPRequestHandler):\n    def log_message(self,*args):pass\nserver=ThreadingHTTPServer(('127.0.0.1',0),Handler)\nPath('artifacts/server.json').write_text(json.dumps({'port':server.server_port,'pid':os.getpid()}))\nprint(json.dumps({'port':server.server_port,'pid':os.getpid()}),flush=True)\nserver.serve_forever()\nEOF\npython3 -u tests/serve.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > tests/probe.py <<'EOF'\nfrom pathlib import Path\nimport json\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parents[1]\nport=json.loads((ROOT/'artifacts/server.json').read_text())['port']\nwith sync_playwright() as pw:\n    browser=pw.chromium.launch(headless=True,args=['--no-sandbox','--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n    page=browser.new_page(viewport={'width':1600,'height':900},ignore_https_errors=True)\n    def route(r):\n        url=r.request.url\n        if 'three@0.180.0/build/' in url:\n            name=url.split('/')[-1];r.fulfill(path=ROOT/'node_modules/three/build'/name,content_type='application/javascript')\n        elif 'rapier3d-compat@0.19.3/rapier.mjs' in url:r.fulfill(path=ROOT/'node_modules/@dimforge/rapier3d-compat/rapier.mjs',content_type='application/javascript')\n        else:r.continue_()\n    page.route('https://cdn.jsdelivr.net/**',route)\n    page.on('pageerror',lambda err:print('ERROR',err))\n    page.on('console',lambda msg:print('CONSOLE',msg.type,msg.text[:500]) if msg.type in ['error','warning'] else None)\n    page.goto(f'http://127.0.0.1:{port}/game.html?test=1')\n    try:page.wait_for_function('window.__gameReady || window.__gameError',timeout=90000)\n    except Exception as e:print('WAIT ERROR',e)\n    print('READY',page.evaluate('({ready:window.__gameReady,error:window.__gameError,text:document.getElementById(\\\"loadtext\\\").textContent})'))\n    if page.evaluate('\"'!!window.__GG'\"'):\n        print('STATE',json.dumps(page.evaluate('window.__GG.snapshot()')))\n        page.screenshot(path=ROOT/'artifacts/title.png')\n        page.get_by_role('button',name='Begin expedition',exact=True).click()\n        page.evaluate('window.__GG.advance(120,{0:{mx:0,mz:-1,sprint:true}})')\n        page.evaluate('window.__GG.render()')\n        print('PLAY',json.dumps(page.evaluate('window.__GG.snapshot()')))\n        page.screenshot(path=ROOT/'artifacts/approach.png')\n    browser.close()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/probe.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
