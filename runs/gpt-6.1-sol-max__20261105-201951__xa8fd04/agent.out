{"type":"item.completed","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"cat artifacts/format.log; cat artifacts/all-run.log; sed -n '1,58p' tests/playthrough.js; sed -n '15,80p' src/engine.js\"","aggregated_output":"Checked 11 files in 15ms. Fixed 10 files.\n() => {\n  const api = window.__GG,\n    log = [];\n  let total = 0;\n  const state = () => api.snapshot();\n  const require = (condition, message) => {\n    if (!condition)\n      throw new Error(\n        message +\n          \" | \" +\n          JSON.stringify({\n            status: state().status,\n            phase: state().phase,\n            p: state().players[0],\n            stage: log.at(-1),\n          }),\n      );\n  };\n  function step(input = {}, n = 1) {\n    api.advance(n, { 0: input });\n    total += n;\n    require(state().status !== \"failed\", \"Explorer fell during scripted play\");\n  }\n  function combatInput(p, s) {\n    const candidates = s.enemies\n      .filter((e) => !e.dead && e.z < -58 === p.z < -58 && Math.hypot(e.x - p.x, e.z - p.z) < 13)\n      .sort((a, b) => Math.hypot(a.x - p.x, a.z - p.z) - Math.hypot(b.x - p.x, b.z - p.z));\n    const e = candidates[0];\n    if (!e) return { whip: true };\n    const d = Math.hypot(e.x - p.x, e.z - p.z);\n    return {\n      ax: (e.x - p.x) / d,\n      az: (e.z - p.z) / d,\n      mouseAim: true,\n      whip: true,\n      shoot: e.kind !== \"snake\" && d < 9 && d > 2.5 && p.ammo > 0,\n    };\n  }\n  function go(x, z, maxFrames = 1600) {\n    let oldD = 999,\n      stuck = 0;\n    for (let k = 0; k < maxFrames; k++) {\n      const s = state(),\n        p = s.players[0],\n        dx = x - p.x,\n        dz = z - p.z,\n        d = Math.hypot(dx, dz);\n      if (s.status === \"won\" && z >= 19) {\n        log.push({ exit: true, time: s.elapsed });\n        return;\n      }\n      if (d < 0.55) {\n        log.push({ where: [x, z], p: [p.x, p.z], hp: p.hp, time: s.elapsed });\n        return;\n      }\n      let input = { mx: dx / d, mz: dz / d, sprint: true, ...combatInput(p, s) };\n      if (p.x > 16 && p.z > -50.65 && p.z < -49 && p.grounded) input.jump = true;\n      const trapZ = p.x > 16 ? [-64, -55, -25, -4] : [-6, -31, -51];\n  trapTempo: 1,\n  boulderSpeed: 6.8,\n  damageScale: 1,\n});\nconst tuning = { ...DEFAULT_TUNING };\nconst settings = {\n  master: 0.7,\n  music: 0.1,\n  sfx: 0.8,\n  glyphs: \"PlayStation\",\n  zoom: 1,\n  shake: 0.65,\n  assist: true,\n};\nconst safeStore = {\n  get(key) {\n    try {\n      return localStorage.getItem(\"goldengoose:\" + key);\n    } catch {\n      return null;\n    }\n  },\n  set(key, val) {\n    try {\n      localStorage.setItem(\"goldengoose:\" + key, val);\n    } catch {}\n  },\n  remove(key) {\n    try {\n      localStorage.removeItem(\"goldengoose:\" + key);\n    } catch {}\n  },\n};\nif (!AIHub.active) {\n  try {\n    Object.assign(settings, JSON.parse(safeStore.get(\"settings\") || \"{}\"));\n  } catch {}\n}\nlet scene,\n  camera,\n  renderer,\n  physics,\n  groundMat,\n  actors,\n  worldObjects,\n  playerId = 0;\nlet actorsRoot,\n  decorRoot,\n  effectRoot,\n  ambientTime = 0,\n  renderTime = 0,\n  shakeTime = 0;\nlet shadowLight,\n  worldReady = false;\nconst cameraTarget = new THREE.Vector3(0, 0, -10);\nconst cameraPosition = new THREE.Vector3();\nconst aimPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);\nconst raycaster = new THREE.Raycaster();\nconst materials = {};\n// RGBA is used because WebGPU texture formats have no RGB8 equivalent.\nconst celTexture = new THREE.DataTexture(\n  new Uint8Array([80, 80, 80, 255, 174, 174, 174, 255, 255, 255, 255, 255]),\n  3,\n  1,\n  THREE.RGBAFormat,\n);\n","exit_code":0,"status":"completed"}}
