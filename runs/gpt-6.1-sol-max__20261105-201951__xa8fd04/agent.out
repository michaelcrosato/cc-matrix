{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > tests/playthrough.js <<'EOF'\n() => {\n const api=window.__GG,log=[];let total=0;\n const state=()=>api.snapshot();\n const require=(condition,message)=>{if(\"'!condition)throw new Error(message+'\"' | '+JSON.stringify({status:state().status,phase:state().phase,p:state().players[0],stage:log.at(-1)}))};\n function step(input={},n=1){api.advance(n,{0:input});total+=n;require(state().status\"'!=='\"'failed','Explorer fell during scripted play');}\n function combatInput(p,s){const candidates=s.enemies.filter(e=>\"'!e.dead&&((e.z<-58)===(p.z<-58))&&Math.hypot(e.x-p.x,e.z-p.z)<13).sort((a,b)=>Math.hypot(a.x-p.x,a.z-p.z)-Math.hypot(b.x-p.x,b.z-p.z));const e=candidates[0];if(!e)return{whip:true};const d=Math.hypot(e.x-p.x,e.z-p.z);return{ax:(e.x-p.x)/d,az:(e.z-p.z)/d,mouseAim:true,whip:true,shoot:e.kind!=='\"'snake'&&d<9&&d>2.5&&p.ammo>0};}\n function go(x,z,maxFrames=1600){let oldD=999,stuck=0;for(let k=0;k<maxFrames;k++){const s=state(),p=s.players[0],dx=x-p.x,dz=z-p.z,d=Math.hypot(dx,dz);if(d<.55){log.push({where:[x,z],p:[p.x,p.z],hp:p.hp,time:s.elapsed});return}let input={mx:dx/d,mz:dz/d,sprint:true,...combatInput(p,s)};if(p.x>16&&p.z> -50.65&&p.z< -49&&p.grounded)input.jump=true;const trapZ=p.x>16?[-64,-55,-25,-4]:[-6,-31,-51];if(trapZ.some(t=>Math.abs(t-p.z)<1.9)&&p.grounded&&k%20===0)input.jump=true;if(d>oldD-.006)stuck++;else stuck=0;if(stuck>45){input.jump=true;input.roll=true}oldD=d;step(input);}throw new Error('Could not reach '+[x,z]+' | '+JSON.stringify(state().players[0]));}\n function clearArea(){for(let k=0;k<1500;k++){const s=state(),p=s.players[0],enemies=s.enemies.filter(e=>\"'!e.dead&&((e.z<-58)===(p.z<-58))&&Math.abs(e.z-p.z)<17);if(!enemies.length)return;enemies.sort((a,b)=>Math.hypot(a.x-p.x,a.z-p.z)-Math.hypot(b.x-p.x,b.z-p.z));const e=enemies[0],d=Math.hypot(e.x-p.x,e.z-p.z);step({mx:d>2.3?(e.x-p.x)/d:0,mz:d>2.3?(e.z-p.z)/d:0,sprint:true,...combatInput(p,s),roll:false,jump:k%80===0&&p.grounded});}throw new Error('\"'Combat stalled');}\n api.start(false);step({},20);\n go(4,0);go(-7,-10);require(state().treasures===1,'First curio was not collected');\n go(0,-13.8);step({interact:true});require(state().players[0].grapple,'Grapple did not engage');step({},80);require(state().phase==='puzzle','River crossing did not advance chapter');\n go(0,-29);clearArea();go(-6,-33.7);step({interact:true});step({},30);require(state().mirrors[0].rotation===1,'Lens I failed');\n go(0,-33);go(6,-33.7);step({interact:true});step({},24);step({interact:true});step({},24);require(state().mirrors[1].rotation===0,'Lens II failed');\n go(3,-40);go(6,-46.7);step({interact:true});step({},24);step({interact:true});step({},24);require(state().gateOpen,'Vault door stayed shut');\n go(0,-46);go(-7,-48);require(state().treasures===2,'Second curio was not collected');go(-4,-52);go(0,-54);go(0,-61);clearArea();require(state().enemies.find(e=>e.kind==='boss').dead,'Captain Brass survived');\n go(7,-79);require(state().treasures===3,'Third curio was not collected');go(0,-74.1);step({interact:true});require(state().phase==='balance','Idol exchange did not start');\n for(let k=0;k<1800&&state().phase==='balance';k++){step({interact:Math.abs(state().balanceNeedle-.5)<.065});}\n require(state().hasRelic,'No goose after the exchange');require(state().cleanSwap,'The precise exchange failed');\n go(7,-74.3);go(21,-74.3);go(21,-50.7);go(21,20,2400);\n require(state().status==='won','Launch did not complete the expedition');require(state().score>3000,'Score did not include expedition rewards');\n return{steps:total,simulatedSeconds:total/60,milestones:log,final:state()};\n}\nEOF\ncat > tests/run.sh <<'EOF'\n#\"'!/usr/bin/env bash\nset -euo pipefail\ncd \"$(dirname \"$0\")/..\"\nnode build.mjs >artifacts/build.log\nnode --check artifacts/bundle-check.mjs\nexec /home/micha/.local/share/pipx/venvs/playwright/bin/python tests/run.py \"$@\"\nEOF\nchmod +x tests/run.sh\ncat > tests/run.py <<'\"'EOF'\nfrom __future__ import annotations\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler\nfrom functools import partial\nimport argparse,json,threading,traceback,time,sys\nfrom playwright.sync_api import sync_playwright\n\nROOT=Path(__file__).resolve().parents[1]\nART=ROOT/'artifacts';ART.mkdir(exist_ok=True)\nparser=argparse.ArgumentParser();parser.add_argument('--suite',choices=['core','hub','visual','all'],default='all');args=parser.parse_args()\nresults=[];errors=[]\ndef check(name,ok,detail=''):\n    results.append({'name':name,'pass':bool(ok),'detail':detail if not ok else ''})\n    if not ok:print(f'FAIL {name}: {detail}',flush=True)\ndef case(name,fn):\n    try:fn()\n    except Exception as e:\n        check(name,False,str(e));(ART/(name.replace(' ','-')+'-error.txt')).write_text(traceback.format_exc())\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self,*_):pass\nserver=ThreadingHTTPServer(('127.0.0.1',0),partial(QuietHandler,directory=str(ROOT)))\nthread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\nBASE=f'http://127.0.0.1:{server.server_port}'\n\ndef asset_route(route):\n    url=route.request.url\n    if 'three@0.180.0/build/' in url:\n        route.fulfill(path=ROOT/'node_modules/three/build'/url.split('/')[-1],content_type='application/javascript')\n    elif 'rapier3d-compat@0.19.3/rapier.mjs' in url:\n        route.fulfill(path=ROOT/'node_modules/@dimforge/rapier3d-compat/rapier.mjs',content_type='application/javascript')\n    else:route.continue_()\ndef context(browser,**kwargs):\n    ctx=browser.new_context(ignore_https_errors=True,viewport={'width':1280,'height':720},**kwargs)\n    ctx.route('https://cdn.jsdelivr.net/**',asset_route)\n    return ctx\n\ndef load(page,query='?test=1'):\n    page.goto(BASE+'/game.html'+query,wait_until='domcontentloaded')\n    page.wait_for_function('window.__gameReady || window.__gameError',timeout=90000)\n    err=page.evaluate('window.__gameError||null')\n    if err:raise RuntimeError(err)\n    assert page.title()=='Raiders of the Golden Goose','Server returned a different game'\n    return page.evaluate('window.__GG?.snapshot()')\ndef state(page):return page.evaluate('window.__GG.snapshot()')\n\nwith sync_playwright() as pw:\n    browser=pw.chromium.launch(channel='chromium',headless=True,args=['--no-sandbox','--disable-gpu-watchdog','--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n    def core():\n        ctx=context(browser);p=ctx.new_page();page_errors=[];p.on('pageerror',lambda e:page_errors.append(str(e)))\n        try:\n            s=load(p);check('Pinned WebGPU and Rapier initialise',s['renderer']=='WebGPU' and s['physics']=='Rapier 0.19.3',str(s))\n            check('Default music gain is ten percent',s['audio']['musicVolume']==.1)\n            check('Title has a field guide and credits',p.get_by_role('button',name='The field guide').count()==1 and p.get_by_role('button',name='About & credits').count()==1)\n            p.get_by_role('button',name='Begin expedition',exact=True).click(timeout=5000)\n            check('Mouse starts solo expedition',state(p)['status']=='playing')\n            p.keyboard.down('d');p.wait_for_function('window.__GG.input().mx>.9');inp=p.evaluate('window.__GG.input()');p.evaluate('(input)=>window.__GG.advance(30,{0:input})',inp);p.keyboard.up('d')\n            check('WASD moves a Rapier body',state(p)['players'][0]['x']>1)\n            p.keyboard.press('Escape');check('Escape opens pause menu',state(p)['screen']=='pause')\n            p.get_by_role('button',name='Developer toolkit',exact=True).click();slider=p.locator('#range-moveSpeed');slider.fill('8.1');slider.dispatch_event('input')\n            check('Live developer slider changes movement',abs(state(p)['tuning']['moveSpeed']-8.1)<.01)\n            p.get_by_role('button',name='Invulnerable: OFF').click();check('Developer invulnerability toggles',state(p)['god'])\n            p.get_by_role('button',name='Reset defaults',exact=True).click();check('Developer defaults restore balance',state(p)['tuning']['moveSpeed']==6.3 and not state(p)['god'])\n            p.get_by_role('button',name='← Back',exact=True).click();p.get_by_role('button',name='Back to the adventure',exact=True).click()\n            # Entire expedition with ordinary movement/actions at default tuning, no warps or immunity.\n            report=p.evaluate((ROOT/'tests/playthrough.js').read_text());(ART/'playthrough.json').write_text(json.dumps(report,indent=2))\n            check('Full default-balance playthrough wins with all curios',report['final']['status']=='won' and report['final']['treasures']==3 and not report['final']['god'])\n            check('All primary mechanics were exercised',report['final']['gateOpen'] and report['final']['cleanSwap'] and report['final']['boulder']['started'] and report['final']['kills']>=6)\n            p.evaluate(\\\"window.__GG.openMenu('about','pause')\\\")\n            for i,label in enumerate(['Source information','Testing feedback','Engine feedback','Prompt feedback']):\n                p.get_by_role('button',name=label,exact=True).click();check('Credits contain '+label,p.locator('.credit-row').count()>=4)\n            p.evaluate('window.__GG.closeMenu();window.__GG.start(true);window.__GG.advance(20)')\n            check('Standalone couch co-op creates two explorers',len(state(p)['players'])==2)\n            p.evaluate('window.__GG.damage(1,8)');check('Co-op partner can be downed without ending run',state(p)['players'][1]['down'] and state(p)['status']=='playing')\n            p.evaluate('window.__GG.interact(0)');check('Co-op interaction revives partner',not state(p)['players'][1]['down'] and state(p)['players'][1]['hp']==3)\n            p.evaluate('window.__GG.start();window.__GG.advance(20);window.__GG.damage(0,8)');check('Solo defeat shows checkpoint retry',state(p)['status']=='failed' and state(p)['screen']=='failure')\n            p.get_by_role('button',name='Try that again',exact=True).click();check('Checkpoint retry restores health',state(p)['status']=='playing' and state(p)['players'][0]['hp']==6)\n            p.evaluate('window.__GG.dev(\\\"warp-puzzle\\\");window.__GG.save();window.__GG.restore()');check('Checkpoint can be restored',state(p)['checkpoint']['name']=='Base camp')\n            p.evaluate(\\\"window.__GG.openMenu('pause')\\\");p.get_by_role('button',name='Return to title',exact=True).click();p.evaluate('window.__GG.idle()');p.wait_for_function('window.__GG.snapshot().attract',timeout=10000);check('Ten-second title idle begins attract replay',state(p)['attract'])\n            reel=p.evaluate('window.__GG.advance(5000)');(ART/'attract.json').write_text(json.dumps(reel,indent=2));check('Attract replay demonstrates advanced chapters',reel['hasRelic'] or reel['phase'] in ['escape','complete'],str(reel))\n            p.keyboard.press('z');check('Any input exits attract to title',state(p)['status']=='title' and not state(p)['attract'])\n            p.wait_for_timeout(400);p.evaluate('window.__GG.unlockAudio();window.__GG.audioTick()');p.wait_for_timeout(250);p.evaluate('window.__GG.audioTick()');audio=state(p)['audio'];check('Procedural audio produces a signal',audio['state']=='running' and audio['music']>0 and audio['level']>0,str(audio))\n            check('No graphics device loss',p.evaluate('\"'!window.__deviceLoss'\"'),str(p.evaluate('window.__deviceLoss||null')))\n            check('No runtime exceptions',not page_errors and not p.evaluate('window.__gameError||null'),str(page_errors))\n        finally:ctx.close()\n    def gamepad():\n        ctx=context(browser);p=ctx.new_page();ctx.add_init_script(\\\"\\\"\\\"window.__virtualPad={index:0,id:'Test DualSense',connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),timestamp:0};navigator.getGamepads=()=>[window.__virtualPad];\\\"\\\"\\\")\n        try:\n            load(p);p.evaluate('window.__virtualPad.buttons[0]={pressed:true,value:1}');p.wait_for_function('window.__GG.snapshot().status===\\\"playing\\\"',timeout=15000);p.evaluate('window.__virtualPad.buttons[0]={pressed:false,value:0};window.__virtualPad.axes[0]=.9');p.wait_for_function('window.__GG.input().mx>.5');inp=p.evaluate('window.__GG.input()');p.evaluate('(i)=>window.__GG.advance(30,{0:i})',inp)\n            check('Standard gamepad starts and moves explorer',state(p)['input']=='pad' and state(p)['players'][0]['x']>1)\n            check('PlayStation prompts follow controller input','□' in p.locator('#controls').inner_text())\n            p.evaluate('window.__virtualPad.axes[0]=0;window.__virtualPad.buttons[9]={pressed:true,value:1}');p.wait_for_function('window.__GG.snapshot().screen===\\\"pause\\\"');p.evaluate('window.__virtualPad.buttons[9]={pressed:false,value:0}')\n            check('Options opens controller pause menu',state(p)['screen']=='pause')\n            p.get_by_role('button',name='Settings',exact=True).click();p.locator('#glyph-choice').select_option('Xbox');p.evaluate('window.__virtualPad.axes[2]=.5');p.wait_for_function('window.__GG.snapshot().input===\\\"pad\\\"');check('Xbox option replaces face glyphs','X' in p.locator('#controls').inner_text() and 'RT' in p.locator('#controls').inner_text())\n        finally:ctx.close()\n    def touch():\n        ctx=context(browser,has_touch=True,is_mobile=True,device_scale_factor=1);p=ctx.new_page()\n        try:\n            load(p);p.get_by_role('button',name='Begin expedition',exact=True).tap();check('Touch starts the same expedition',state(p)['status']=='playing' and state(p)['input']=='touch')\n            cdp=ctx.new_cdp_session(p);cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':180,'y':540,'id':1}]});cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':230,'y':490,'id':1}]});p.wait_for_function('window.__GG.input().mx>.5');inp=p.evaluate('window.__GG.input()');p.evaluate('(i)=>window.__GG.advance(30,{0:i})',inp)\n            check('Invisible touch stick moves explorer',state(p)['players'][0]['x']>1)\n            cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':230,'y':490,'id':1},{'x':1000,'y':460,'id':2}]});check('Touch supports two simultaneous contacts',p.evaluate('window.__GG.input().touch') and p.evaluate('window.__GG.input().whip'))\n            cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]});p.evaluate('window.__GG.warp(0,0,-14);window.__GG.advance(1)');p.locator('#context-button').tap();p.evaluate('(i)=>window.__GG.advance(1,{0:i})',p.evaluate('window.__GG.input()'));check('Touch context button engages grapple',state(p)['players'][0]['grapple'])\n            check('Touch layout hides control clutter',p.locator('#controls').is_hidden() and p.locator('#pause-button').is_visible())\n        finally:ctx.close()\n    def hub():\n        ctx=context(browser);p=ctx.new_page()\n        try:\n            for players,scenario in [(2,'standard'),(4,'standard'),(4,'host-leave'),(2,'server')]:\n                p.goto(BASE+f'/harness.html?game=game.html&players={players}&latency=150&jitter=50&loss=5&auto=1&play=4000&scenario={scenario}')\n                p.wait_for_function('window.__hubCheck?.done',timeout=120000)\n                report=p.evaluate('window.__hubCheck');(ART/f'hub-{players}-{scenario}.json').write_text(json.dumps(report,indent=2))\n                for c in report['checks']:check(f'AI Hub {players} {scenario}: '+c['name'],c['pass'],c.get('detail',''))\n                check(f'AI Hub {players} {scenario} overall',report['pass'],json.dumps([c for c in report['checks'] if not c['pass']]))\n        finally:ctx.close()\n    def visual():\n        ctx=context(browser);p=ctx.new_page();p.set_viewport_size({'width':1920,'height':1080})\n        try:\n            load(p);p.mouse.move(3,3);p.screenshot(path=ART/'title.png');check('Title menu remains within the television viewport',p.locator('.title-menu').bounding_box()['y']>=0)\n            p.evaluate('window.__GG.start();window.__GG.advance(10)');p.evaluate('window.__GG.render()');p.screenshot(path=ART/'approach.png')\n            for stage in ['puzzle','vault','escape']:\n                p.evaluate('(s)=>window.__GG.dev(\\\"warp-\\\"+s)',stage);p.evaluate('window.__GG.advance(20);window.__GG.render()');p.screenshot(path=ART/(stage+'.png'))\n            p.evaluate(\\\"window.__GG.openMenu('dev','pause')\\\");p.screenshot(path=ART/'developer.png');check('Developer panel has seven balance sliders',p.locator('input[type=range]').count()==7)\n            p.set_viewport_size({'width':844,'height':390});p.evaluate(\\\"window.__GG.openMenu('title')\\\");p.screenshot(path=ART/'landscape-menu.png');check('Landscape title controls fit the viewport',p.locator('[data-action=about]').bounding_box()['y']+p.locator('[data-action=about]').bounding_box()['height']<=390)\n            check('Visual render has no runtime error',not p.evaluate('window.__gameError||window.__deviceLoss||null'))\n        finally:ctx.close()\n    if args.suite in ['core','all']:\n        case('core expedition',core);case('gamepad input',gamepad);case('touch input',touch)\n    if args.suite in ['hub','all']:case('hub conformance',hub)\n    if args.suite in ['visual','all']:case('visual inspection',visual)\n    browser.close()\nserver.shutdown();server.server_close()\nreport={'suite':args.suite,'count':len(results),'passed':sum(r['pass'] for r in results),'failed':sum(not r['pass'] for r in results),'results':results}\n(ART/f'test-results-{args.suite}.json').write_text(json.dumps(report,indent=2))\nprint(f'{report[\\\"passed\\\"]}/{report[\\\"count\\\"]} checks passed; {report[\\\"failed\\\"]} failures.',flush=True)\nsys.exit(1 if report['failed'] else 0)\nEOF\nbash tests/run.sh --suite core > artifacts/core-run.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > tests/playthrough.js <<'EOF'\n() => {\n const api=window.__GG,log=[];let total=0;\n const state=()=>api.snapshot();\n const require=(condition,message)=>{if(\"'!condition)throw new Error(message+'\"' | '+JSON.stringify({status:state().status,phase:state().phase,p:state().players[0],stage:log.at(-1)}))};\n function step(input={},n=1){api.advance(n,{0:input});total+=n;require(state().status\"'!=='\"'failed','Explorer fell during scripted play');}\n function combatInput(p,s){const candidates=s.enemies.filter(e=>\"'!e.dead&&((e.z<-58)===(p.z<-58))&&Math.hypot(e.x-p.x,e.z-p.z)<13).sort((a,b)=>Math.hypot(a.x-p.x,a.z-p.z)-Math.hypot(b.x-p.x,b.z-p.z));const e=candidates[0];if(!e)return{whip:true};const d=Math.hypot(e.x-p.x,e.z-p.z);return{ax:(e.x-p.x)/d,az:(e.z-p.z)/d,mouseAim:true,whip:true,shoot:e.kind!=='\"'snake'&&d<9&&d>2.5&&p.ammo>0};}\n function go(x,z,maxFrames=1600){let oldD=999,stuck=0;for(let k=0;k<maxFrames;k++){const s=state(),p=s.players[0],dx=x-p.x,dz=z-p.z,d=Math.hypot(dx,dz);if(d<.55){log.push({where:[x,z],p:[p.x,p.z],hp:p.hp,time:s.elapsed});return}let input={mx:dx/d,mz:dz/d,sprint:true,...combatInput(p,s)};if(p.x>16&&p.z> -50.65&&p.z< -49&&p.grounded)input.jump=true;const trapZ=p.x>16?[-64,-55,-25,-4]:[-6,-31,-51];if(trapZ.some(t=>Math.abs(t-p.z)<1.9)&&p.grounded&&k%20===0)input.jump=true;if(d>oldD-.006)stuck++;else stuck=0;if(stuck>45){input.jump=true;input.roll=true}oldD=d;step(input);}throw new Error('Could not reach '+[x,z]+' | '+JSON.stringify(state().players[0]));}\n function clearArea(){for(let k=0;k<1500;k++){const s=state(),p=s.players[0],enemies=s.enemies.filter(e=>\"'!e.dead&&((e.z<-58)===(p.z<-58))&&Math.abs(e.z-p.z)<17);if(!enemies.length)return;enemies.sort((a,b)=>Math.hypot(a.x-p.x,a.z-p.z)-Math.hypot(b.x-p.x,b.z-p.z));const e=enemies[0],d=Math.hypot(e.x-p.x,e.z-p.z);step({mx:d>2.3?(e.x-p.x)/d:0,mz:d>2.3?(e.z-p.z)/d:0,sprint:true,...combatInput(p,s),roll:false,jump:k%80===0&&p.grounded});}throw new Error('\"'Combat stalled');}\n api.start(false);step({},20);\n go(4,0);go(-7,-10);require(state().treasures===1,'First curio was not collected');\n go(0,-13.8);step({interact:true});require(state().players[0].grapple,'Grapple did not engage');step({},80);require(state().phase==='puzzle','River crossing did not advance chapter');\n go(0,-29);clearArea();go(-6,-33.7);step({interact:true});step({},30);require(state().mirrors[0].rotation===1,'Lens I failed');\n go(0,-33);go(6,-33.7);step({interact:true});step({},24);step({interact:true});step({},24);require(state().mirrors[1].rotation===0,'Lens II failed');\n go(3,-40);go(6,-46.7);step({interact:true});step({},24);step({interact:true});step({},24);require(state().gateOpen,'Vault door stayed shut');\n go(0,-46);go(-7,-48);require(state().treasures===2,'Second curio was not collected');go(-4,-52);go(0,-54);go(0,-61);clearArea();require(state().enemies.find(e=>e.kind==='boss').dead,'Captain Brass survived');\n go(7,-79);require(state().treasures===3,'Third curio was not collected');go(0,-74.1);step({interact:true});require(state().phase==='balance','Idol exchange did not start');\n for(let k=0;k<1800&&state().phase==='balance';k++){step({interact:Math.abs(state().balanceNeedle-.5)<.065});}\n require(state().hasRelic,'No goose after the exchange');require(state().cleanSwap,'The precise exchange failed');\n go(7,-74.3);go(21,-74.3);go(21,-50.7);go(21,20,2400);\n require(state().status==='won','Launch did not complete the expedition');require(state().score>3000,'Score did not include expedition rewards');\n return{steps:total,simulatedSeconds:total/60,milestones:log,final:state()};\n}\nEOF\ncat > tests/run.sh <<'EOF'\n#\"'!/usr/bin/env bash\nset -euo pipefail\ncd \"$(dirname \"$0\")/..\"\nnode build.mjs >artifacts/build.log\nnode --check artifacts/bundle-check.mjs\nexec /home/micha/.local/share/pipx/venvs/playwright/bin/python tests/run.py \"$@\"\nEOF\nchmod +x tests/run.sh\ncat > tests/run.py <<'\"'EOF'\nfrom __future__ import annotations\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler\nfrom functools import partial\nimport argparse,json,threading,traceback,time,sys\nfrom playwright.sync_api import sync_playwright\n\nROOT=Path(__file__).resolve().parents[1]\nART=ROOT/'artifacts';ART.mkdir(exist_ok=True)\nparser=argparse.ArgumentParser();parser.add_argument('--suite',choices=['core','hub','visual','all'],default='all');args=parser.parse_args()\nresults=[];errors=[]\ndef check(name,ok,detail=''):\n    results.append({'name':name,'pass':bool(ok),'detail':detail if not ok else ''})\n    if not ok:print(f'FAIL {name}: {detail}',flush=True)\ndef case(name,fn):\n    try:fn()\n    except Exception as e:\n        check(name,False,str(e));(ART/(name.replace(' ','-')+'-error.txt')).write_text(traceback.format_exc())\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self,*_):pass\nserver=ThreadingHTTPServer(('127.0.0.1',0),partial(QuietHandler,directory=str(ROOT)))\nthread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\nBASE=f'http://127.0.0.1:{server.server_port}'\n\ndef asset_route(route):\n    url=route.request.url\n    if 'three@0.180.0/build/' in url:\n        route.fulfill(path=ROOT/'node_modules/three/build'/url.split('/')[-1],content_type='application/javascript')\n    elif 'rapier3d-compat@0.19.3/rapier.mjs' in url:\n        route.fulfill(path=ROOT/'node_modules/@dimforge/rapier3d-compat/rapier.mjs',content_type='application/javascript')\n    else:route.continue_()\ndef context(browser,**kwargs):\n    ctx=browser.new_context(ignore_https_errors=True,viewport={'width':1280,'height':720},**kwargs)\n    ctx.route('https://cdn.jsdelivr.net/**',asset_route)\n    return ctx\n\ndef load(page,query='?test=1'):\n    page.goto(BASE+'/game.html'+query,wait_until='domcontentloaded')\n    page.wait_for_function('window.__gameReady || window.__gameError',timeout=90000)\n    err=page.evaluate('window.__gameError||null')\n    if err:raise RuntimeError(err)\n    assert page.title()=='Raiders of the Golden Goose','Server returned a different game'\n    return page.evaluate('window.__GG?.snapshot()')\ndef state(page):return page.evaluate('window.__GG.snapshot()')\n\nwith sync_playwright() as pw:\n    browser=pw.chromium.launch(channel='chromium',headless=True,args=['--no-sandbox','--disable-gpu-watchdog','--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n    def core():\n        ctx=context(browser);p=ctx.new_page();page_errors=[];p.on('pageerror',lambda e:page_errors.append(str(e)))\n        try:\n            s=load(p);check('Pinned WebGPU and Rapier initialise',s['renderer']=='WebGPU' and s['physics']=='Rapier 0.19.3',str(s))\n            check('Default music gain is ten percent',s['audio']['musicVolume']==.1)\n            check('Title has a field guide and credits',p.get_by_role('button',name='The field guide').count()==1 and p.get_by_role('button',name='About & credits').count()==1)\n            p.get_by_role('button',name='Begin expedition',exact=True).click(timeout=5000)\n            check('Mouse starts solo expedition',state(p)['status']=='playing')\n            p.keyboard.down('d');p.wait_for_function('window.__GG.input().mx>.9');inp=p.evaluate('window.__GG.input()');p.evaluate('(input)=>window.__GG.advance(30,{0:input})',inp);p.keyboard.up('d')\n            check('WASD moves a Rapier body',state(p)['players'][0]['x']>1)\n            p.keyboard.press('Escape');check('Escape opens pause menu',state(p)['screen']=='pause')\n            p.get_by_role('button',name='Developer toolkit',exact=True).click();slider=p.locator('#range-moveSpeed');slider.fill('8.1');slider.dispatch_event('input')\n            check('Live developer slider changes movement',abs(state(p)['tuning']['moveSpeed']-8.1)<.01)\n            p.get_by_role('button',name='Invulnerable: OFF').click();check('Developer invulnerability toggles',state(p)['god'])\n            p.get_by_role('button',name='Reset defaults',exact=True).click();check('Developer defaults restore balance',state(p)['tuning']['moveSpeed']==6.3 and not state(p)['god'])\n            p.get_by_role('button',name='← Back',exact=True).click();p.get_by_role('button',name='Back to the adventure',exact=True).click()\n            # Entire expedition with ordinary movement/actions at default tuning, no warps or immunity.\n            report=p.evaluate((ROOT/'tests/playthrough.js').read_text());(ART/'playthrough.json').write_text(json.dumps(report,indent=2))\n            check('Full default-balance playthrough wins with all curios',report['final']['status']=='won' and report['final']['treasures']==3 and not report['final']['god'])\n            check('All primary mechanics were exercised',report['final']['gateOpen'] and report['final']['cleanSwap'] and report['final']['boulder']['started'] and report['final']['kills']>=6)\n            p.evaluate(\\\"window.__GG.openMenu('about','pause')\\\")\n            for i,label in enumerate(['Source information','Testing feedback','Engine feedback','Prompt feedback']):\n                p.get_by_role('button',name=label,exact=True).click();check('Credits contain '+label,p.locator('.credit-row').count()>=4)\n            p.evaluate('window.__GG.closeMenu();window.__GG.start(true);window.__GG.advance(20)')\n            check('Standalone couch co-op creates two explorers',len(state(p)['players'])==2)\n            p.evaluate('window.__GG.damage(1,8)');check('Co-op partner can be downed without ending run',state(p)['players'][1]['down'] and state(p)['status']=='playing')\n            p.evaluate('window.__GG.interact(0)');check('Co-op interaction revives partner',not state(p)['players'][1]['down'] and state(p)['players'][1]['hp']==3)\n            p.evaluate('window.__GG.start();window.__GG.advance(20);window.__GG.damage(0,8)');check('Solo defeat shows checkpoint retry',state(p)['status']=='failed' and state(p)['screen']=='failure')\n            p.get_by_role('button',name='Try that again',exact=True).click();check('Checkpoint retry restores health',state(p)['status']=='playing' and state(p)['players'][0]['hp']==6)\n            p.evaluate('window.__GG.dev(\\\"warp-puzzle\\\");window.__GG.save();window.__GG.restore()');check('Checkpoint can be restored',state(p)['checkpoint']['name']=='Base camp')\n            p.evaluate(\\\"window.__GG.openMenu('pause')\\\");p.get_by_role('button',name='Return to title',exact=True).click();p.evaluate('window.__GG.idle()');p.wait_for_function('window.__GG.snapshot().attract',timeout=10000);check('Ten-second title idle begins attract replay',state(p)['attract'])\n            reel=p.evaluate('window.__GG.advance(5000)');(ART/'attract.json').write_text(json.dumps(reel,indent=2));check('Attract replay demonstrates advanced chapters',reel['hasRelic'] or reel['phase'] in ['escape','complete'],str(reel))\n            p.keyboard.press('z');check('Any input exits attract to title',state(p)['status']=='title' and not state(p)['attract'])\n            p.wait_for_timeout(400);p.evaluate('window.__GG.unlockAudio();window.__GG.audioTick()');p.wait_for_timeout(250);p.evaluate('window.__GG.audioTick()');audio=state(p)['audio'];check('Procedural audio produces a signal',audio['state']=='running' and audio['music']>0 and audio['level']>0,str(audio))\n            check('No graphics device loss',p.evaluate('\"'!window.__deviceLoss'\"'),str(p.evaluate('window.__deviceLoss||null')))\n            check('No runtime exceptions',not page_errors and not p.evaluate('window.__gameError||null'),str(page_errors))\n        finally:ctx.close()\n    def gamepad():\n        ctx=context(browser);p=ctx.new_page();ctx.add_init_script(\\\"\\\"\\\"window.__virtualPad={index:0,id:'Test DualSense',connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),timestamp:0};navigator.getGamepads=()=>[window.__virtualPad];\\\"\\\"\\\")\n        try:\n            load(p);p.evaluate('window.__virtualPad.buttons[0]={pressed:true,value:1}');p.wait_for_function('window.__GG.snapshot().status===\\\"playing\\\"',timeout=15000);p.evaluate('window.__virtualPad.buttons[0]={pressed:false,value:0};window.__virtualPad.axes[0]=.9');p.wait_for_function('window.__GG.input().mx>.5');inp=p.evaluate('window.__GG.input()');p.evaluate('(i)=>window.__GG.advance(30,{0:i})',inp)\n            check('Standard gamepad starts and moves explorer',state(p)['input']=='pad' and state(p)['players'][0]['x']>1)\n            check('PlayStation prompts follow controller input','□' in p.locator('#controls').inner_text())\n            p.evaluate('window.__virtualPad.axes[0]=0;window.__virtualPad.buttons[9]={pressed:true,value:1}');p.wait_for_function('window.__GG.snapshot().screen===\\\"pause\\\"');p.evaluate('window.__virtualPad.buttons[9]={pressed:false,value:0}')\n            check('Options opens controller pause menu',state(p)['screen']=='pause')\n            p.get_by_role('button',name='Settings',exact=True).click();p.locator('#glyph-choice').select_option('Xbox');p.evaluate('window.__virtualPad.axes[2]=.5');p.wait_for_function('window.__GG.snapshot().input===\\\"pad\\\"');check('Xbox option replaces face glyphs','X' in p.locator('#controls').inner_text() and 'RT' in p.locator('#controls').inner_text())\n        finally:ctx.close()\n    def touch():\n        ctx=context(browser,has_touch=True,is_mobile=True,device_scale_factor=1);p=ctx.new_page()\n        try:\n            load(p);p.get_by_role('button',name='Begin expedition',exact=True).tap();check('Touch starts the same expedition',state(p)['status']=='playing' and state(p)['input']=='touch')\n            cdp=ctx.new_cdp_session(p);cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':180,'y':540,'id':1}]});cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':230,'y':490,'id':1}]});p.wait_for_function('window.__GG.input().mx>.5');inp=p.evaluate('window.__GG.input()');p.evaluate('(i)=>window.__GG.advance(30,{0:i})',inp)\n            check('Invisible touch stick moves explorer',state(p)['players'][0]['x']>1)\n            cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':230,'y':490,'id':1},{'x':1000,'y':460,'id':2}]});check('Touch supports two simultaneous contacts',p.evaluate('window.__GG.input().touch') and p.evaluate('window.__GG.input().whip'))\n            cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]});p.evaluate('window.__GG.warp(0,0,-14);window.__GG.advance(1)');p.locator('#context-button').tap();p.evaluate('(i)=>window.__GG.advance(1,{0:i})',p.evaluate('window.__GG.input()'));check('Touch context button engages grapple',state(p)['players'][0]['grapple'])\n            check('Touch layout hides control clutter',p.locator('#controls').is_hidden() and p.locator('#pause-button').is_visible())\n        finally:ctx.close()\n    def hub():\n        ctx=context(browser);p=ctx.new_page()\n        try:\n            for players,scenario in [(2,'standard'),(4,'standard'),(4,'host-leave'),(2,'server')]:\n                p.goto(BASE+f'/harness.html?game=game.html&players={players}&latency=150&jitter=50&loss=5&auto=1&play=4000&scenario={scenario}')\n                p.wait_for_function('window.__hubCheck?.done',timeout=120000)\n                report=p.evaluate('window.__hubCheck');(ART/f'hub-{players}-{scenario}.json').write_text(json.dumps(report,indent=2))\n                for c in report['checks']:check(f'AI Hub {players} {scenario}: '+c['name'],c['pass'],c.get('detail',''))\n                check(f'AI Hub {players} {scenario} overall',report['pass'],json.dumps([c for c in report['checks'] if not c['pass']]))\n        finally:ctx.close()\n    def visual():\n        ctx=context(browser);p=ctx.new_page();p.set_viewport_size({'width':1920,'height':1080})\n        try:\n            load(p);p.mouse.move(3,3);p.screenshot(path=ART/'title.png');check('Title menu remains within the television viewport',p.locator('.title-menu').bounding_box()['y']>=0)\n            p.evaluate('window.__GG.start();window.__GG.advance(10)');p.evaluate('window.__GG.render()');p.screenshot(path=ART/'approach.png')\n            for stage in ['puzzle','vault','escape']:\n                p.evaluate('(s)=>window.__GG.dev(\\\"warp-\\\"+s)',stage);p.evaluate('window.__GG.advance(20);window.__GG.render()');p.screenshot(path=ART/(stage+'.png'))\n            p.evaluate(\\\"window.__GG.openMenu('dev','pause')\\\");p.screenshot(path=ART/'developer.png');check('Developer panel has seven balance sliders',p.locator('input[type=range]').count()==7)\n            p.set_viewport_size({'width':844,'height':390});p.evaluate(\\\"window.__GG.openMenu('title')\\\");p.screenshot(path=ART/'landscape-menu.png');check('Landscape title controls fit the viewport',p.locator('[data-action=about]').bounding_box()['y']+p.locator('[data-action=about]').bounding_box()['height']<=390)\n            check('Visual render has no runtime error',not p.evaluate('window.__gameError||window.__deviceLoss||null'))\n        finally:ctx.close()\n    if args.suite in ['core','all']:\n        case('core expedition',core);case('gamepad input',gamepad);case('touch input',touch)\n    if args.suite in ['hub','all']:case('hub conformance',hub)\n    if args.suite in ['visual','all']:case('visual inspection',visual)\n    browser.close()\nserver.shutdown();server.server_close()\nreport={'suite':args.suite,'count':len(results),'passed':sum(r['pass'] for r in results),'failed':sum(not r['pass'] for r in results),'results':results}\n(ART/f'test-results-{args.suite}.json').write_text(json.dumps(report,indent=2))\nprint(f'{report[\\\"passed\\\"]}/{report[\\\"count\\\"]} checks passed; {report[\\\"failed\\\"]} failures.',flush=True)\nsys.exit(1 if report['failed'] else 0)\nEOF\nbash tests/run.sh --suite core > artifacts/core-run.log 2>&1\"","aggregated_output":"","exit_code":1,"status":"failed"}}
