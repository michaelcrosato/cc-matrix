{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"rg -n 'window\\\\.|current =|function releaseRound|status' harness.html | head -60; cat artifacts/all-run.log\"","aggregated_output":"84:let current = null;\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n182:  current = state;\n195:    onStatus: (s) => { state.status = s; render(state); },\n198:      log(`round ${round} ${record.status}: ${record.reason}${record.standings ? ' — standings ' + JSON.stringify(record.standings) : ''}`);\n264:function releaseRound(state = current) {\n311:  current = null;\n332:  const s = state.status;\n353:    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n412:  window.__hubCheck = report;\n428:    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n452:    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n453:    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n456:    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n489:      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n502:      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n503:        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n506:      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n508:      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n512:    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n","exit_code":0,"status":"completed"}}
