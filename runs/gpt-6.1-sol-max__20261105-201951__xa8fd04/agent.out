{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"mkdir -p src tests artifacts && cat > build.mjs <<'EOF'\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport path from 'node:path';\nconst here=path.dirname(fileURLToPath(import.meta.url));\nconst {slug}=JSON.parse(readFileSync(path.join(here,'selection.json'),'utf8'));\nconst read=(f)=>readFileSync(path.join(here,f),'utf8');\nconst js=['engine','audio','world','input','game','ui','main'].map(n=>read('src/'+n+'.js')).join('\\\\n');\nconst html=read('src/shell.html').replace('<\"'!-- HUB_CLIENT -->'\"','<script>'+read('hub-session.js')+'</script>').replace('/* GAME_STYLE */',read('src/style.css')).replace('/* GAME_CODE */',js.replaceAll('</script','<\\\\\\\\/script'));\nwriteFileSync(path.join(here,'../'+slug+'.html'),html);\nwriteFileSync(path.join(here,'game.html'),html);\nwriteFileSync(path.join(here,'artifacts/bundle-check.mjs'),js);\nconsole.log('Built '+slug+'.html');\nEOF\ncat > src/shell.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<!-- HUB_CLIENT -->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#151f20\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Work together to recover the Golden Goose and escape the collapsing temple. Turn the sun lenses, beat the treasure hunters, and outrun the boulder.\">\n<meta name=\"hub:session-howto\" content=\"Move: left stick / WASD. Whip: Square / left click. Shoot: R2 / right click. Jump: Cross / Space. Roll: Circle / Ctrl. Interact: Triangle / E. Sprint: L2 / Shift. Pause: Options / Esc.\">\n<meta name=\"hub:session-minutes\" content=\"8\">\n<title>Raiders of the Golden Goose</title>\n<style>/* GAME_STYLE */</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/webgpu\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"@dimforge/rapier3d-compat\":\"https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-compat@0.19.3/rapier.mjs\"}}</script>\n</head>\n<body>\n<canvas id=\"scene\" aria-label=\"3D game world\"></canvas>\n<div id=\"papergrain\" aria-hidden=\"true\"></div><div id=\"vignette\" aria-hidden=\"true\"></div>\n<div id=\"loading\" class=\"fullpanel\"><div class=\"loader-goose\">✦</div><div class=\"eyebrow\">QUINN &amp; COMPANY · ADVENTURES OF QUESTIONABLE MERIT</div><h1>One moment.<br>The tomb is waking up.</h1><p id=\"loadtext\">Packing the whip. Counting the bullets.</p></div>\n<div id=\"hud\" hidden>\n  <div id=\"vitals\"></div>\n  <div id=\"chapter\"><span class=\"eyebrow\" id=\"chapter-num\">CHAPTER I</span><strong id=\"chapter-name\">THE SUNKEN APPROACH</strong></div>\n  <div id=\"map-wrap\"><canvas id=\"map\" width=\"180\" height=\"180\" aria-label=\"Expedition compass\"></canvas><span id=\"maplabel\">N</span></div>\n  <button id=\"pause-button\" class=\"icon-button\" aria-label=\"Pause\">Ⅱ</button>\n  <div id=\"objective\"><span id=\"objective-num\">01</span><div><div class=\"eyebrow\">THE JOB</div><strong id=\"objective-text\"></strong><small id=\"objective-detail\"></small></div></div>\n  <div id=\"context\" hidden><button id=\"context-button\"></button></div>\n  <div id=\"controls\"></div>\n  <div id=\"dialogue\" hidden><span id=\"speaker\"></span><p id=\"speech\"></p></div>\n  <div id=\"toast\" role=\"status\"></div>\n  <div id=\"escape-meter\" hidden><span>ANCIENT ARCHITECTURE. MODERN PANIC.</span><div><i></i></div><b id=\"escape-distance\"></b></div>\n  <div id=\"balance\" hidden><div class=\"eyebrow\">A PERFECTLY REASONABLE PLAN</div><h2>A goose for a bag of sand.</h2><p>Press <span id=\"balance-key\"></span> when the needle reaches the gold band. Three steady hands.</p><div class=\"balance-track\"><i id=\"balance-zone\"></i><b id=\"balance-needle\"></b></div><div id=\"balance-marks\">○ ○ ○</div></div>\n  <div id=\"attract-banner\" hidden><span class=\"eyebrow\">FIELD REEL 01 · AUTOMATIC DEMONSTRATION</span><strong>Fortune favours the slightly reckless.</strong><small>Any input returns to the title</small></div>\n  <div id=\"hub-banner\" hidden></div>\n  <div id=\"hitflash\" aria-hidden=\"true\"></div>\n</div>\n<div id=\"menu\" hidden></div>\n<div id=\"cinematic\" hidden></div>\n<script type=\"module\">/* GAME_CODE */</script>\n</body>\n</html>\nEOF\ncat > src/style.css <<'\"'EOF'\n:root{--ink:#172428;--paper:#f2e6c9;--gold:#f5be52;--ochre:#bc733b;--teal:#87b9ac;--dim:#c1c5b1;--ui:clamp(17px,1.38vw,26px);color-scheme:dark;font-family:Arial,Helvetica,sans-serif;color:var(--paper);font-size:var(--ui)}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#172a2c;overscroll-behavior:none;touch-action:none}button,input,select{font:inherit}button{color:inherit;cursor:pointer;touch-action:manipulation}button:focus{outline:none}button:focus-visible{outline:3px solid var(--gold);outline-offset:4px}[hidden]{display:none\"'!important}#scene{position:absolute;inset:0;width:100%;height:100%;display:block}#vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 52% 40%,transparent 35%,#08181a75 100%)}#papergrain{position:absolute;inset:0;z-index:1;opacity:.075;pointer-events:none;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='\"'0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23fff' filter='url(%23n)' opacity='.5' d='M0 0h150v150H0z'/%3E%3C/svg%3E\\\")}#loading{z-index:20;background:#16272a;text-align:center;display:flex;flex-direction:column;justify-content:center;align-items:center}h1,h2,h3,p{margin:0}h1,h2{font-family:Georgia,'Times New Roman',serif}h1{font-size:clamp(42px,4.8vw,88px);line-height:1.02;letter-spacing:-.045em}h2{font-size:clamp(32px,3.1vw,58px);line-height:1.08;letter-spacing:-.025em}.eyebrow{font-size:.62rem;font-weight:800;letter-spacing:.18em;line-height:1.6;text-transform:uppercase;color:var(--gold)}.loader-goose{font-size:3rem;color:var(--gold);animation:spin 6s linear infinite;margin-bottom:1rem}#loadtext{color:var(--dim);margin-top:1.5rem;font-size:.8rem}.fullpanel{position:absolute;inset:0}#menu{position:absolute;inset:0;z-index:4;display:flex;align-items:center;background:linear-gradient(90deg,#102125f7 0%,#102125ec 30%,#102125a0 53%,#1021250a 78%)}.title-menu{width:47%;max-width:880px;margin-left:5.5%;padding:3vh 0}.title-menu .series{display:flex;align-items:center;gap:.7rem;margin-bottom:1.2rem}.series i{width:2.4rem;height:2px;background:var(--gold)}.title-menu h1{font-size:clamp(44px,5.6vw,108px);font-style:italic;text-transform:uppercase;color:var(--paper);text-shadow:4px 5px 0 #081a1c}.title-menu h1 .gold{display:block;color:var(--gold);font-size:1.07em}.title-menu .tagline{font-family:Georgia,serif;font-size:1.03rem;font-style:italic;margin-top:1.1rem;color:#ddd8bd;max-width:25rem;line-height:1.45}.menu-actions{display:flex;flex-direction:column;align-items:stretch;gap:.28rem;margin-top:1.5rem;width:min(25rem,90%)}.menu-btn{position:relative;text-align:left;border:1px solid transparent;background:transparent;padding:.57rem .85rem .57rem 1.35rem;font-size:.91rem;min-height:2.15rem;transition:background .12s,color .12s;line-height:1.3;border-radius:2px}.menu-btn small{font-size:.62rem;display:block;margin-top:.18rem;font-weight:normal;opacity:.75}.menu-btn.focused,.menu-btn:hover{background:var(--paper);color:var(--ink);border-color:var(--paper)}.menu-btn.focused:before{content:'›';position:absolute;left:.45rem;color:var(--ochre);font-weight:bold}.menu-btn.primary{background:var(--gold);color:var(--ink);font-weight:800}.menu-btn.primary.focused{background:#ffdc8d;box-shadow:0 0 0 2px #f5be5255}.menu-btn.disabled{opacity:.4;pointer-events:none}.menu-footer{position:absolute;bottom:3.5vh;left:5.5%;right:5.5%;display:flex;justify-content:space-between;align-items:center;font-size:.58rem;color:#d4dacb;letter-spacing:.09em}.menu-footer .key{margin:0 .2rem}.edition-stamp{position:absolute;right:5.5%;top:7%;text-align:right;border-top:2px solid #f5be5266;padding-top:.6rem;line-height:1.5;color:#e4ddc2;font-family:Georgia,serif;font-style:italic;font-size:.8rem}.edition-stamp b{display:block;color:var(--gold);font:800 .6rem Arial;letter-spacing:.18em}.key{display:inline-flex;align-items:center;justify-content:center;min-width:1.55rem;height:1.45rem;border:1px solid #d9dfcc77;border-radius:4px;padding:0 .28rem;font-size:.62rem;font-weight:bold;line-height:1;background:#163236d9;color:var(--paper);white-space:nowrap}.key.ps{border-radius:50%;min-width:1.42rem;padding:0;font-size:.9rem}.key.ps.square{color:#f0a9d3}.key.ps.cross{color:#a3c6f0}.key.ps.triangle{color:#8ce3b6}.key.ps.circle{color:#f7a7a3}.sheet{width:min(53rem,89vw);margin:auto;padding:2rem 2.4rem;background:#13282aeb;border:1px solid #d4b46b55;box-shadow:0 22px 120px #0008;max-height:88vh;overflow:auto;scrollbar-color:#b59a5f #172b2d}.sheet.wide{width:min(66rem,92vw)}.sheet .subtitle{color:var(--dim);font-size:.8rem;line-height:1.6;margin:.65rem 0 1rem}.sheet .menu-actions{width:100%}.sheet .back{margin-top:1rem;width:auto}.sheet hr{border:0;border-top:1px solid #ead5aa33;margin:1rem 0}.pause-sheet{margin-left:7%;width:min(28rem,86vw)}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem}.panel-head .menu-btn{padding:.4rem .7rem;min-height:1.8rem;font-size:.72rem}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem 1.6rem;margin-top:1rem}.setting{padding:.45rem .6rem;border:1px solid #c4c9af25;display:flex;flex-direction:column;gap:.45rem}.setting.focused{border-color:var(--gold);background:#ead5aa0d}.setting label{display:flex;justify-content:space-between;gap:1rem;font-size:.78rem}.setting output{color:var(--gold);font-weight:bold}.setting input[type=range]{width:100%;accent-color:var(--gold);cursor:pointer;height:1rem}.setting .menu-btn{font-size:.77rem;padding:.2rem .7rem;min-height:1.6rem}select{background:#243d3c;color:var(--paper);padding:.25rem;border:1px solid #a69f77;max-width:100%}.toolrow{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.7rem}.toolrow .menu-btn{border:1px solid #d9ca9c44;padding:.45rem .65rem;font-size:.68rem;flex:1;min-width:7rem}.tabs{display:flex;gap:.3rem;border-bottom:1px solid #f5be5244;margin:.8rem 0 1rem;flex-wrap:wrap}.tabs .menu-btn{font-size:.67rem;padding:.5rem .6rem;min-height:2rem}.tabs .active{border-bottom:3px solid var(--gold);color:var(--gold)}.credits-scroll{max-height:50vh;overflow:auto;padding-right:1rem;touch-action:pan-y}.credit-row{margin-bottom:.9rem;line-height:1.45;font-size:.8rem;color:#dedfc8}.credit-row b{color:var(--gold);display:block;font-size:.65rem;letter-spacing:.09em;text-transform:uppercase;margin-bottom:.2rem}.credit-row a{color:var(--teal)}.help-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.3rem;margin:1.3rem 0}.help-card{border-left:2px solid var(--gold);padding-left:1rem}.help-card h3{font-family:Georgia,serif;font-size:1.15rem;margin-bottom:.5rem;color:var(--gold)}.help-card p{font-size:.78rem;line-height:1.6;color:#dde0ca}.journal-map{width:40%;max-height:48vh;float:right;margin-left:2rem}.journal-copy{font-size:.82rem;line-height:1.8;color:#e1deca}.journal-copy b{color:var(--gold)}#hud{position:absolute;inset:0;pointer-events:none;z-index:2}#hud button{pointer-events:auto}#vitals{position:absolute;top:4vh;left:3.4vw;display:flex;gap:1rem;flex-wrap:wrap;max-width:56vw}.vital{border-left:3px solid var(--gold);padding:.25rem .8rem;background:linear-gradient(90deg,#142a2bd9,transparent)}.vital .name{font-size:.58rem;letter-spacing:.13em;text-transform:uppercase;font-weight:bold;margin-bottom:.2rem}.vital .hearts{letter-spacing:.13em;color:#ffba73;font-size:.96rem;line-height:1.1}.vital .ammo{font-size:.58rem;color:#e2e7cf;margin-top:.25rem}.vital .down{color:#f39a7a}#chapter{position:absolute;top:4.2vh;left:50%;transform:translateX(-50%);text-align:center;text-shadow:1px 2px #0c2528}#chapter strong{display:block;font-family:Georgia,serif;font-size:.93rem;letter-spacing:.055em;margin-top:.18rem}#map-wrap{position:absolute;right:3.2vw;top:3.4vh;width:clamp(110px,9.5vw,180px);height:clamp(110px,9.5vw,180px);opacity:.92}#map{width:100%;height:100%;border-radius:50%;border:1px solid #dbc59160;background:#142b2cdd}#maplabel{position:absolute;top:.25rem;left:50%;transform:translateX(-50%);color:var(--gold);font-size:.6rem;font-family:Georgia}#pause-button{position:absolute;right:2.5vw;top:calc(4vh + clamp(110px,10vw,180px));background:#13272ac9;border:1px solid #d8d8b955;border-radius:50%;width:2rem;height:2rem;font-size:.85rem}#objective{position:absolute;left:3.4vw;bottom:7vh;display:flex;gap:.8rem;max-width:33vw;align-items:center;text-shadow:1px 2px #12272b}#objective-num{color:#f0b84e90;border:1px solid #f0b84e70;border-radius:50%;width:2.3rem;height:2.3rem;display:flex;justify-content:center;align-items:center;font:italic 1rem Georgia;flex-shrink:0}#objective strong{font-family:Georgia,serif;font-size:1rem;line-height:1.2;display:block;margin:.2rem 0}#objective small{display:block;font-size:.64rem;color:#d9ddc7;line-height:1.45;max-width:24rem}#controls{position:absolute;bottom:3vh;right:3.4vw;display:flex;gap:.65rem;align-items:center;font-size:.58rem;color:#e8e1c9;text-shadow:1px 2px #132a2a}#controls span{white-space:nowrap}#context{position:absolute;bottom:16vh;left:50%;transform:translateX(-50%);max-width:90vw}#context-button{display:flex;align-items:center;justify-content:center;gap:.65rem;background:#14292bec;color:var(--paper);padding:.65rem 1.2rem;border:1px solid #ecc377b3;box-shadow:0 6px 25px #0004;font-size:.77rem;border-radius:3px;white-space:nowrap}#dialogue{position:absolute;bottom:24vh;left:50%;transform:translateX(-50%);text-align:center;width:min(34rem,77vw);background:linear-gradient(90deg,transparent,#122326e8 15%,#122326e8 85%,transparent);padding:.6rem 1.5rem .8rem}#speaker{color:var(--gold);font-size:.56rem;letter-spacing:.15em;font-weight:bold}#speech{font-family:Georgia,serif;font-size:.92rem;line-height:1.4;margin-top:.25rem}#toast{position:absolute;left:50%;top:19vh;transform:translateX(-50%) translateY(-10px);background:#f4e5c5;color:var(--ink);padding:.55rem 1.3rem;font-size:.73rem;font-weight:bold;opacity:0;transition:opacity .2s,transform .2s;text-align:center;max-width:90vw}#toast.visible{opacity:1;transform:translateX(-50%) translateY(0)}#escape-meter{position:absolute;top:21vh;right:3.4vw;width:15rem;text-align:right}#escape-meter>span{font-size:.51rem;letter-spacing:.1em;color:#ffd088;font-weight:bold}#escape-meter>div{height:5px;background:#102426;transform:skewX(-10deg);margin:.45rem 0}#escape-meter i{height:100%;display:block;background:#ef9459;transition:width .15s}#escape-distance{font-size:.7rem;color:#f3c278}#balance{position:absolute;left:50%;top:43%;transform:translate(-50%,-50%);width:min(38rem,88vw);padding:1.6rem 2rem;background:#10292af5;border:1px solid #e7b359;text-align:center;box-shadow:0 0 0 200vmax #07191959}#balance h2{font-size:1.75rem;margin:.3rem 0 .6rem}#balance p{font-size:.73rem;line-height:1.5}#balance-marks{letter-spacing:.4em;color:var(--gold);margin-top:.7rem;font-size:1.2rem}.balance-track{margin:1.4rem auto .6rem;width:94%;height:1rem;background:#0a1e20;border:1px solid #6a8580;position:relative}.balance-track i{position:absolute;left:43%;width:14%;height:100%;background:#c99b3f}.balance-track b{position:absolute;left:50%;width:4px;top:-.3rem;height:1.55rem;background:#fff3c9;transform:translateX(-50%)}#attract-banner{position:absolute;bottom:6vh;left:50%;transform:translateX(-50%);text-align:center;padding:1rem 2.5rem;background:#13272be8;border-top:2px solid var(--gold);min-width:28rem}#attract-banner strong{font:italic 1.25rem Georgia;display:block;margin:.3rem 0}#attract-banner small{color:var(--dim);font-size:.66rem}#hub-banner{position:absolute;left:50%;top:40%;transform:translate(-50%,-50%);background:#12272be8;padding:1rem 2rem;text-align:center;font-family:Georgia,serif;font-size:1.3rem;border:1px solid #e4bc6a66}#hitflash{position:absolute;inset:0;box-shadow:inset 0 0 140px #c83c20;opacity:0;pointer-events:none}.stats{display:flex;gap:1.6rem;margin:1.3rem 0;flex-wrap:wrap}.stat strong{font-family:Georgia,serif;font-size:1.9rem;color:var(--gold);display:block}.stat span{font-size:.6rem;color:var(--dim);text-transform:uppercase;letter-spacing:.09em}#cinematic{position:absolute;inset:0;z-index:3;pointer-events:none;border-top:6vh solid #0c2025;border-bottom:6vh solid #0c2025}.hint-line{font-size:.63rem;color:var(--dim);line-height:1.6;margin-top:.7rem}.danger{color:#f3a686}.brand-feather{color:var(--gold);font-size:1.4rem}.touch #controls,.touch #map-wrap{display:none}.touch #pause-button{top:3vh;right:3vw;width:2.4rem;height:2.4rem}.touch #context{left:auto;right:5vw;bottom:10vh;transform:none}.touch #context-button{padding:.85rem 1rem;font-size:.8rem;border-radius:50px}.touch #objective{max-width:64vw;bottom:5vh}.touch #objective-detail{display:none}.touch #chapter{top:4vh;left:54%}.touch #dialogue{bottom:23vh}.touch #balance{font-size:14px}.touch #balance p{padding-bottom:.8rem}.touch #balance:after{content:'TAP TO STEADY';display:block;color:var(--gold);font-size:.7rem;margin-top:.4rem}.touch #escape-meter{top:16vh;right:3vw;width:10rem}@media(max-width:850px){:root{--ui:clamp(15px,2vw,19px)}.title-menu{width:58%;margin-left:5%}.title-menu h1{font-size:clamp(35px,6.8vw,60px)}.title-menu .tagline{font-size:.83rem}.edition-stamp{right:4%;font-size:.7rem}.menu-footer{font-size:.5rem}.settings-grid{gap:.4rem .8rem}.sheet{padding:1.2rem 1.5rem}#vitals{gap:.25rem}#chapter{left:51%}#chapter strong{font-size:.7rem}#objective{max-width:45vw}#controls{font-size:.5rem;gap:.4rem}#controls .key{font-size:.5rem;min-width:1.3rem;height:1.2rem}#dialogue{bottom:25vh}}@media(max-width:560px){.title-menu{width:85%;margin-left:7%;padding-bottom:2rem}.title-menu h1{font-size:clamp(42px,11vw,64px)}#menu{background:linear-gradient(90deg,#102125ee,#102125a5)}.edition-stamp{display:none}.title-menu .series{margin-bottom:.6rem}.title-menu .tagline{max-width:20rem}.menu-actions{margin-top:1.1rem}.menu-footer>span:last-child{display:none}.sheet{max-height:91vh;padding:1rem}.settings-grid{grid-template-columns:1fr}.help-grid{grid-template-columns:1fr;gap:.8rem}.help-card p{font-size:.75rem}.tabs .menu-btn{font-size:.61rem;padding:.35rem}.journal-map{display:none}#vitals{top:3vh;left:4vw}#chapter{display:none}#objective{left:4vw;bottom:5vh;max-width:80vw}#objective strong{font-size:.92rem}#objective-num{display:none}.vital .hearts{font-size:.85rem}#map-wrap{display:none}#controls{display:none}#pause-button{top:3vh;right:4vw}#context{bottom:16vh}#dialogue{bottom:28vh}#speech{font-size:.83rem}#attract-banner{min-width:90vw;padding:.7rem}#attract-banner strong{font-size:1rem}.title-menu h1 .gold{font-size:1.02em}.menu-btn{min-height:2.3rem}#balance{padding:1.2rem}#balance h2{font-size:1.5rem}#escape-meter{width:10rem;top:14vh}.sheet h2{font-size:1.9rem}}@media(max-height:650px) and (min-width:561px){.title-menu h1{font-size:clamp(36px,6vw,70px)}.title-menu .series{margin-bottom:.4rem}.title-menu .tagline{margin-top:.5rem}.menu-actions{margin-top:.7rem;gap:.08rem}.menu-btn{padding-top:.3rem;padding-bottom:.3rem;min-height:1.8rem}.title-menu{padding-bottom:1.8rem}.menu-footer{bottom:2vh}.sheet{max-height:91vh}.credits-scroll{max-height:46vh}#context{bottom:19vh}#objective{bottom:8vh}#dialogue{bottom:29vh}}@keyframes spin{to{transform:rotate(360deg)}}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"mkdir -p src tests artifacts && cat > build.mjs <<'EOF'\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport path from 'node:path';\nconst here=path.dirname(fileURLToPath(import.meta.url));\nconst {slug}=JSON.parse(readFileSync(path.join(here,'selection.json'),'utf8'));\nconst read=(f)=>readFileSync(path.join(here,f),'utf8');\nconst js=['engine','audio','world','input','game','ui','main'].map(n=>read('src/'+n+'.js')).join('\\\\n');\nconst html=read('src/shell.html').replace('<\"'!-- HUB_CLIENT -->'\"','<script>'+read('hub-session.js')+'</script>').replace('/* GAME_STYLE */',read('src/style.css')).replace('/* GAME_CODE */',js.replaceAll('</script','<\\\\\\\\/script'));\nwriteFileSync(path.join(here,'../'+slug+'.html'),html);\nwriteFileSync(path.join(here,'game.html'),html);\nwriteFileSync(path.join(here,'artifacts/bundle-check.mjs'),js);\nconsole.log('Built '+slug+'.html');\nEOF\ncat > src/shell.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<!-- HUB_CLIENT -->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#151f20\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Work together to recover the Golden Goose and escape the collapsing temple. Turn the sun lenses, beat the treasure hunters, and outrun the boulder.\">\n<meta name=\"hub:session-howto\" content=\"Move: left stick / WASD. Whip: Square / left click. Shoot: R2 / right click. Jump: Cross / Space. Roll: Circle / Ctrl. Interact: Triangle / E. Sprint: L2 / Shift. Pause: Options / Esc.\">\n<meta name=\"hub:session-minutes\" content=\"8\">\n<title>Raiders of the Golden Goose</title>\n<style>/* GAME_STYLE */</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/webgpu\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"@dimforge/rapier3d-compat\":\"https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-compat@0.19.3/rapier.mjs\"}}</script>\n</head>\n<body>\n<canvas id=\"scene\" aria-label=\"3D game world\"></canvas>\n<div id=\"papergrain\" aria-hidden=\"true\"></div><div id=\"vignette\" aria-hidden=\"true\"></div>\n<div id=\"loading\" class=\"fullpanel\"><div class=\"loader-goose\">✦</div><div class=\"eyebrow\">QUINN &amp; COMPANY · ADVENTURES OF QUESTIONABLE MERIT</div><h1>One moment.<br>The tomb is waking up.</h1><p id=\"loadtext\">Packing the whip. Counting the bullets.</p></div>\n<div id=\"hud\" hidden>\n  <div id=\"vitals\"></div>\n  <div id=\"chapter\"><span class=\"eyebrow\" id=\"chapter-num\">CHAPTER I</span><strong id=\"chapter-name\">THE SUNKEN APPROACH</strong></div>\n  <div id=\"map-wrap\"><canvas id=\"map\" width=\"180\" height=\"180\" aria-label=\"Expedition compass\"></canvas><span id=\"maplabel\">N</span></div>\n  <button id=\"pause-button\" class=\"icon-button\" aria-label=\"Pause\">Ⅱ</button>\n  <div id=\"objective\"><span id=\"objective-num\">01</span><div><div class=\"eyebrow\">THE JOB</div><strong id=\"objective-text\"></strong><small id=\"objective-detail\"></small></div></div>\n  <div id=\"context\" hidden><button id=\"context-button\"></button></div>\n  <div id=\"controls\"></div>\n  <div id=\"dialogue\" hidden><span id=\"speaker\"></span><p id=\"speech\"></p></div>\n  <div id=\"toast\" role=\"status\"></div>\n  <div id=\"escape-meter\" hidden><span>ANCIENT ARCHITECTURE. MODERN PANIC.</span><div><i></i></div><b id=\"escape-distance\"></b></div>\n  <div id=\"balance\" hidden><div class=\"eyebrow\">A PERFECTLY REASONABLE PLAN</div><h2>A goose for a bag of sand.</h2><p>Press <span id=\"balance-key\"></span> when the needle reaches the gold band. Three steady hands.</p><div class=\"balance-track\"><i id=\"balance-zone\"></i><b id=\"balance-needle\"></b></div><div id=\"balance-marks\">○ ○ ○</div></div>\n  <div id=\"attract-banner\" hidden><span class=\"eyebrow\">FIELD REEL 01 · AUTOMATIC DEMONSTRATION</span><strong>Fortune favours the slightly reckless.</strong><small>Any input returns to the title</small></div>\n  <div id=\"hub-banner\" hidden></div>\n  <div id=\"hitflash\" aria-hidden=\"true\"></div>\n</div>\n<div id=\"menu\" hidden></div>\n<div id=\"cinematic\" hidden></div>\n<script type=\"module\">/* GAME_CODE */</script>\n</body>\n</html>\nEOF\ncat > src/style.css <<'\"'EOF'\n:root{--ink:#172428;--paper:#f2e6c9;--gold:#f5be52;--ochre:#bc733b;--teal:#87b9ac;--dim:#c1c5b1;--ui:clamp(17px,1.38vw,26px);color-scheme:dark;font-family:Arial,Helvetica,sans-serif;color:var(--paper);font-size:var(--ui)}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#172a2c;overscroll-behavior:none;touch-action:none}button,input,select{font:inherit}button{color:inherit;cursor:pointer;touch-action:manipulation}button:focus{outline:none}button:focus-visible{outline:3px solid var(--gold);outline-offset:4px}[hidden]{display:none\"'!important}#scene{position:absolute;inset:0;width:100%;height:100%;display:block}#vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 52% 40%,transparent 35%,#08181a75 100%)}#papergrain{position:absolute;inset:0;z-index:1;opacity:.075;pointer-events:none;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='\"'0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23fff' filter='url(%23n)' opacity='.5' d='M0 0h150v150H0z'/%3E%3C/svg%3E\\\")}#loading{z-index:20;background:#16272a;text-align:center;display:flex;flex-direction:column;justify-content:center;align-items:center}h1,h2,h3,p{margin:0}h1,h2{font-family:Georgia,'Times New Roman',serif}h1{font-size:clamp(42px,4.8vw,88px);line-height:1.02;letter-spacing:-.045em}h2{font-size:clamp(32px,3.1vw,58px);line-height:1.08;letter-spacing:-.025em}.eyebrow{font-size:.62rem;font-weight:800;letter-spacing:.18em;line-height:1.6;text-transform:uppercase;color:var(--gold)}.loader-goose{font-size:3rem;color:var(--gold);animation:spin 6s linear infinite;margin-bottom:1rem}#loadtext{color:var(--dim);margin-top:1.5rem;font-size:.8rem}.fullpanel{position:absolute;inset:0}#menu{position:absolute;inset:0;z-index:4;display:flex;align-items:center;background:linear-gradient(90deg,#102125f7 0%,#102125ec 30%,#102125a0 53%,#1021250a 78%)}.title-menu{width:47%;max-width:880px;margin-left:5.5%;padding:3vh 0}.title-menu .series{display:flex;align-items:center;gap:.7rem;margin-bottom:1.2rem}.series i{width:2.4rem;height:2px;background:var(--gold)}.title-menu h1{font-size:clamp(44px,5.6vw,108px);font-style:italic;text-transform:uppercase;color:var(--paper);text-shadow:4px 5px 0 #081a1c}.title-menu h1 .gold{display:block;color:var(--gold);font-size:1.07em}.title-menu .tagline{font-family:Georgia,serif;font-size:1.03rem;font-style:italic;margin-top:1.1rem;color:#ddd8bd;max-width:25rem;line-height:1.45}.menu-actions{display:flex;flex-direction:column;align-items:stretch;gap:.28rem;margin-top:1.5rem;width:min(25rem,90%)}.menu-btn{position:relative;text-align:left;border:1px solid transparent;background:transparent;padding:.57rem .85rem .57rem 1.35rem;font-size:.91rem;min-height:2.15rem;transition:background .12s,color .12s;line-height:1.3;border-radius:2px}.menu-btn small{font-size:.62rem;display:block;margin-top:.18rem;font-weight:normal;opacity:.75}.menu-btn.focused,.menu-btn:hover{background:var(--paper);color:var(--ink);border-color:var(--paper)}.menu-btn.focused:before{content:'›';position:absolute;left:.45rem;color:var(--ochre);font-weight:bold}.menu-btn.primary{background:var(--gold);color:var(--ink);font-weight:800}.menu-btn.primary.focused{background:#ffdc8d;box-shadow:0 0 0 2px #f5be5255}.menu-btn.disabled{opacity:.4;pointer-events:none}.menu-footer{position:absolute;bottom:3.5vh;left:5.5%;right:5.5%;display:flex;justify-content:space-between;align-items:center;font-size:.58rem;color:#d4dacb;letter-spacing:.09em}.menu-footer .key{margin:0 .2rem}.edition-stamp{position:absolute;right:5.5%;top:7%;text-align:right;border-top:2px solid #f5be5266;padding-top:.6rem;line-height:1.5;color:#e4ddc2;font-family:Georgia,serif;font-style:italic;font-size:.8rem}.edition-stamp b{display:block;color:var(--gold);font:800 .6rem Arial;letter-spacing:.18em}.key{display:inline-flex;align-items:center;justify-content:center;min-width:1.55rem;height:1.45rem;border:1px solid #d9dfcc77;border-radius:4px;padding:0 .28rem;font-size:.62rem;font-weight:bold;line-height:1;background:#163236d9;color:var(--paper);white-space:nowrap}.key.ps{border-radius:50%;min-width:1.42rem;padding:0;font-size:.9rem}.key.ps.square{color:#f0a9d3}.key.ps.cross{color:#a3c6f0}.key.ps.triangle{color:#8ce3b6}.key.ps.circle{color:#f7a7a3}.sheet{width:min(53rem,89vw);margin:auto;padding:2rem 2.4rem;background:#13282aeb;border:1px solid #d4b46b55;box-shadow:0 22px 120px #0008;max-height:88vh;overflow:auto;scrollbar-color:#b59a5f #172b2d}.sheet.wide{width:min(66rem,92vw)}.sheet .subtitle{color:var(--dim);font-size:.8rem;line-height:1.6;margin:.65rem 0 1rem}.sheet .menu-actions{width:100%}.sheet .back{margin-top:1rem;width:auto}.sheet hr{border:0;border-top:1px solid #ead5aa33;margin:1rem 0}.pause-sheet{margin-left:7%;width:min(28rem,86vw)}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem}.panel-head .menu-btn{padding:.4rem .7rem;min-height:1.8rem;font-size:.72rem}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem 1.6rem;margin-top:1rem}.setting{padding:.45rem .6rem;border:1px solid #c4c9af25;display:flex;flex-direction:column;gap:.45rem}.setting.focused{border-color:var(--gold);background:#ead5aa0d}.setting label{display:flex;justify-content:space-between;gap:1rem;font-size:.78rem}.setting output{color:var(--gold);font-weight:bold}.setting input[type=range]{width:100%;accent-color:var(--gold);cursor:pointer;height:1rem}.setting .menu-btn{font-size:.77rem;padding:.2rem .7rem;min-height:1.6rem}select{background:#243d3c;color:var(--paper);padding:.25rem;border:1px solid #a69f77;max-width:100%}.toolrow{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.7rem}.toolrow .menu-btn{border:1px solid #d9ca9c44;padding:.45rem .65rem;font-size:.68rem;flex:1;min-width:7rem}.tabs{display:flex;gap:.3rem;border-bottom:1px solid #f5be5244;margin:.8rem 0 1rem;flex-wrap:wrap}.tabs .menu-btn{font-size:.67rem;padding:.5rem .6rem;min-height:2rem}.tabs .active{border-bottom:3px solid var(--gold);color:var(--gold)}.credits-scroll{max-height:50vh;overflow:auto;padding-right:1rem;touch-action:pan-y}.credit-row{margin-bottom:.9rem;line-height:1.45;font-size:.8rem;color:#dedfc8}.credit-row b{color:var(--gold);display:block;font-size:.65rem;letter-spacing:.09em;text-transform:uppercase;margin-bottom:.2rem}.credit-row a{color:var(--teal)}.help-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.3rem;margin:1.3rem 0}.help-card{border-left:2px solid var(--gold);padding-left:1rem}.help-card h3{font-family:Georgia,serif;font-size:1.15rem;margin-bottom:.5rem;color:var(--gold)}.help-card p{font-size:.78rem;line-height:1.6;color:#dde0ca}.journal-map{width:40%;max-height:48vh;float:right;margin-left:2rem}.journal-copy{font-size:.82rem;line-height:1.8;color:#e1deca}.journal-copy b{color:var(--gold)}#hud{position:absolute;inset:0;pointer-events:none;z-index:2}#hud button{pointer-events:auto}#vitals{position:absolute;top:4vh;left:3.4vw;display:flex;gap:1rem;flex-wrap:wrap;max-width:56vw}.vital{border-left:3px solid var(--gold);padding:.25rem .8rem;background:linear-gradient(90deg,#142a2bd9,transparent)}.vital .name{font-size:.58rem;letter-spacing:.13em;text-transform:uppercase;font-weight:bold;margin-bottom:.2rem}.vital .hearts{letter-spacing:.13em;color:#ffba73;font-size:.96rem;line-height:1.1}.vital .ammo{font-size:.58rem;color:#e2e7cf;margin-top:.25rem}.vital .down{color:#f39a7a}#chapter{position:absolute;top:4.2vh;left:50%;transform:translateX(-50%);text-align:center;text-shadow:1px 2px #0c2528}#chapter strong{display:block;font-family:Georgia,serif;font-size:.93rem;letter-spacing:.055em;margin-top:.18rem}#map-wrap{position:absolute;right:3.2vw;top:3.4vh;width:clamp(110px,9.5vw,180px);height:clamp(110px,9.5vw,180px);opacity:.92}#map{width:100%;height:100%;border-radius:50%;border:1px solid #dbc59160;background:#142b2cdd}#maplabel{position:absolute;top:.25rem;left:50%;transform:translateX(-50%);color:var(--gold);font-size:.6rem;font-family:Georgia}#pause-button{position:absolute;right:2.5vw;top:calc(4vh + clamp(110px,10vw,180px));background:#13272ac9;border:1px solid #d8d8b955;border-radius:50%;width:2rem;height:2rem;font-size:.85rem}#objective{position:absolute;left:3.4vw;bottom:7vh;display:flex;gap:.8rem;max-width:33vw;align-items:center;text-shadow:1px 2px #12272b}#objective-num{color:#f0b84e90;border:1px solid #f0b84e70;border-radius:50%;width:2.3rem;height:2.3rem;display:flex;justify-content:center;align-items:center;font:italic 1rem Georgia;flex-shrink:0}#objective strong{font-family:Georgia,serif;font-size:1rem;line-height:1.2;display:block;margin:.2rem 0}#objective small{display:block;font-size:.64rem;color:#d9ddc7;line-height:1.45;max-width:24rem}#controls{position:absolute;bottom:3vh;right:3.4vw;display:flex;gap:.65rem;align-items:center;font-size:.58rem;color:#e8e1c9;text-shadow:1px 2px #132a2a}#controls span{white-space:nowrap}#context{position:absolute;bottom:16vh;left:50%;transform:translateX(-50%);max-width:90vw}#context-button{display:flex;align-items:center;justify-content:center;gap:.65rem;background:#14292bec;color:var(--paper);padding:.65rem 1.2rem;border:1px solid #ecc377b3;box-shadow:0 6px 25px #0004;font-size:.77rem;border-radius:3px;white-space:nowrap}#dialogue{position:absolute;bottom:24vh;left:50%;transform:translateX(-50%);text-align:center;width:min(34rem,77vw);background:linear-gradient(90deg,transparent,#122326e8 15%,#122326e8 85%,transparent);padding:.6rem 1.5rem .8rem}#speaker{color:var(--gold);font-size:.56rem;letter-spacing:.15em;font-weight:bold}#speech{font-family:Georgia,serif;font-size:.92rem;line-height:1.4;margin-top:.25rem}#toast{position:absolute;left:50%;top:19vh;transform:translateX(-50%) translateY(-10px);background:#f4e5c5;color:var(--ink);padding:.55rem 1.3rem;font-size:.73rem;font-weight:bold;opacity:0;transition:opacity .2s,transform .2s;text-align:center;max-width:90vw}#toast.visible{opacity:1;transform:translateX(-50%) translateY(0)}#escape-meter{position:absolute;top:21vh;right:3.4vw;width:15rem;text-align:right}#escape-meter>span{font-size:.51rem;letter-spacing:.1em;color:#ffd088;font-weight:bold}#escape-meter>div{height:5px;background:#102426;transform:skewX(-10deg);margin:.45rem 0}#escape-meter i{height:100%;display:block;background:#ef9459;transition:width .15s}#escape-distance{font-size:.7rem;color:#f3c278}#balance{position:absolute;left:50%;top:43%;transform:translate(-50%,-50%);width:min(38rem,88vw);padding:1.6rem 2rem;background:#10292af5;border:1px solid #e7b359;text-align:center;box-shadow:0 0 0 200vmax #07191959}#balance h2{font-size:1.75rem;margin:.3rem 0 .6rem}#balance p{font-size:.73rem;line-height:1.5}#balance-marks{letter-spacing:.4em;color:var(--gold);margin-top:.7rem;font-size:1.2rem}.balance-track{margin:1.4rem auto .6rem;width:94%;height:1rem;background:#0a1e20;border:1px solid #6a8580;position:relative}.balance-track i{position:absolute;left:43%;width:14%;height:100%;background:#c99b3f}.balance-track b{position:absolute;left:50%;width:4px;top:-.3rem;height:1.55rem;background:#fff3c9;transform:translateX(-50%)}#attract-banner{position:absolute;bottom:6vh;left:50%;transform:translateX(-50%);text-align:center;padding:1rem 2.5rem;background:#13272be8;border-top:2px solid var(--gold);min-width:28rem}#attract-banner strong{font:italic 1.25rem Georgia;display:block;margin:.3rem 0}#attract-banner small{color:var(--dim);font-size:.66rem}#hub-banner{position:absolute;left:50%;top:40%;transform:translate(-50%,-50%);background:#12272be8;padding:1rem 2rem;text-align:center;font-family:Georgia,serif;font-size:1.3rem;border:1px solid #e4bc6a66}#hitflash{position:absolute;inset:0;box-shadow:inset 0 0 140px #c83c20;opacity:0;pointer-events:none}.stats{display:flex;gap:1.6rem;margin:1.3rem 0;flex-wrap:wrap}.stat strong{font-family:Georgia,serif;font-size:1.9rem;color:var(--gold);display:block}.stat span{font-size:.6rem;color:var(--dim);text-transform:uppercase;letter-spacing:.09em}#cinematic{position:absolute;inset:0;z-index:3;pointer-events:none;border-top:6vh solid #0c2025;border-bottom:6vh solid #0c2025}.hint-line{font-size:.63rem;color:var(--dim);line-height:1.6;margin-top:.7rem}.danger{color:#f3a686}.brand-feather{color:var(--gold);font-size:1.4rem}.touch #controls,.touch #map-wrap{display:none}.touch #pause-button{top:3vh;right:3vw;width:2.4rem;height:2.4rem}.touch #context{left:auto;right:5vw;bottom:10vh;transform:none}.touch #context-button{padding:.85rem 1rem;font-size:.8rem;border-radius:50px}.touch #objective{max-width:64vw;bottom:5vh}.touch #objective-detail{display:none}.touch #chapter{top:4vh;left:54%}.touch #dialogue{bottom:23vh}.touch #balance{font-size:14px}.touch #balance p{padding-bottom:.8rem}.touch #balance:after{content:'TAP TO STEADY';display:block;color:var(--gold);font-size:.7rem;margin-top:.4rem}.touch #escape-meter{top:16vh;right:3vw;width:10rem}@media(max-width:850px){:root{--ui:clamp(15px,2vw,19px)}.title-menu{width:58%;margin-left:5%}.title-menu h1{font-size:clamp(35px,6.8vw,60px)}.title-menu .tagline{font-size:.83rem}.edition-stamp{right:4%;font-size:.7rem}.menu-footer{font-size:.5rem}.settings-grid{gap:.4rem .8rem}.sheet{padding:1.2rem 1.5rem}#vitals{gap:.25rem}#chapter{left:51%}#chapter strong{font-size:.7rem}#objective{max-width:45vw}#controls{font-size:.5rem;gap:.4rem}#controls .key{font-size:.5rem;min-width:1.3rem;height:1.2rem}#dialogue{bottom:25vh}}@media(max-width:560px){.title-menu{width:85%;margin-left:7%;padding-bottom:2rem}.title-menu h1{font-size:clamp(42px,11vw,64px)}#menu{background:linear-gradient(90deg,#102125ee,#102125a5)}.edition-stamp{display:none}.title-menu .series{margin-bottom:.6rem}.title-menu .tagline{max-width:20rem}.menu-actions{margin-top:1.1rem}.menu-footer>span:last-child{display:none}.sheet{max-height:91vh;padding:1rem}.settings-grid{grid-template-columns:1fr}.help-grid{grid-template-columns:1fr;gap:.8rem}.help-card p{font-size:.75rem}.tabs .menu-btn{font-size:.61rem;padding:.35rem}.journal-map{display:none}#vitals{top:3vh;left:4vw}#chapter{display:none}#objective{left:4vw;bottom:5vh;max-width:80vw}#objective strong{font-size:.92rem}#objective-num{display:none}.vital .hearts{font-size:.85rem}#map-wrap{display:none}#controls{display:none}#pause-button{top:3vh;right:4vw}#context{bottom:16vh}#dialogue{bottom:28vh}#speech{font-size:.83rem}#attract-banner{min-width:90vw;padding:.7rem}#attract-banner strong{font-size:1rem}.title-menu h1 .gold{font-size:1.02em}.menu-btn{min-height:2.3rem}#balance{padding:1.2rem}#balance h2{font-size:1.5rem}#escape-meter{width:10rem;top:14vh}.sheet h2{font-size:1.9rem}}@media(max-height:650px) and (min-width:561px){.title-menu h1{font-size:clamp(36px,6vw,70px)}.title-menu .series{margin-bottom:.4rem}.title-menu .tagline{margin-top:.5rem}.menu-actions{margin-top:.7rem;gap:.08rem}.menu-btn{padding-top:.3rem;padding-bottom:.3rem;min-height:1.8rem}.title-menu{padding-bottom:1.8rem}.menu-footer{bottom:2vh}.sheet{max-height:91vh}.credits-scroll{max-height:46vh}#context{bottom:19vh}#objective{bottom:8vh}#dialogue{bottom:29vh}}@keyframes spin{to{transform:rotate(360deg)}}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"agent_message","text":"The controls and presentation are taking shape: a whip and six-shot pistol, contextual grappling, shared checkpoints, and an idol-swap timing challenge. The world uses procedural geometry and ink outlines; all music, effects, and gibberish voices will be synthesized in code."}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > src/engine.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nconst TITLE='Raiders of the Golden Goose';\nconst \"'$=id=>document.getElementById(id);\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst TAU=Math.PI*2;\nconst dist=(a,b)=>Math.hypot(a.x-b.x,a.z-b.z);\nconst testMode=new URLSearchParams(location.search).get('\"'test')==='1';\nconst DEFAULT_TUNING=Object.freeze({moveSpeed:6.3,jumpPower:8,whipReach:3.7,enemyAggression:1,trapTempo:1,boulderSpeed:6.8,damageScale:1});\nconst tuning={...DEFAULT_TUNING};\nconst settings={master:.7,music:.1,sfx:.8,glyphs:'PlayStation',zoom:1,shake:.65,assist:true};\nconst safeStore={get(key){try{return localStorage.getItem('goldengoose:'+key)}catch{return null}},set(key,val){try{localStorage.setItem('goldengoose:'+key,val)}catch{}},remove(key){try{localStorage.removeItem('goldengoose:'+key)}catch{}}};\nif(\"'!AIHub.active){try{Object.assign(settings,JSON.parse(safeStore.get('\"'settings')||'{}'))}catch{}}\nlet scene,camera,renderer,physics,groundMat,actors,worldObjects,playerId=0;\nlet actorsRoot,decorRoot,effectRoot,ambientTime=0,renderTime=0,shakeTime=0;\nlet shadowLight,worldReady=false;\nconst cameraTarget=new THREE.Vector3(0,0,-10);\nconst cameraPosition=new THREE.Vector3();\nconst aimPlane=new THREE.Plane(new THREE.Vector3(0,1,0),0);\nconst raycaster=new THREE.Raycaster();\nconst materials={};\nconst gradient=new THREE.DataTexture(new Uint8Array([85,85,85,178,178,178,255,255,255]),3,1,THREE.RGBFormat);\n// RGBA is used because WebGPU texture formats have no RGB8 equivalent.\nconst celTexture=new THREE.DataTexture(new Uint8Array([80,80,80,255,174,174,174,255,255,255,255,255]),3,1,THREE.RGBAFormat);\ncelTexture.needsUpdate=true;celTexture.minFilter=THREE.NearestFilter;celTexture.magFilter=THREE.NearestFilter;\nfunction toon(color,options={}){const key=color+JSON.stringify(options);if(\"'!materials[key])materials[key]=new THREE.MeshToonMaterial({color,gradientMap:celTexture,...options});return materials[key]}\nconst inkMat=new THREE.MeshBasicMaterial({color:0x122526,side:THREE.BackSide});\nconst lineMat=new THREE.LineBasicMaterial({color:0x1d3231,transparent:true,opacity:.5});\nconst geo={box:new THREE.BoxGeometry(1,1,1),sphere:new THREE.SphereGeometry(1,12,8),rock:new THREE.IcosahedronGeometry(1,1),cylinder:new THREE.CylinderGeometry(1,1,1,10),cone:new THREE.ConeGeometry(1,1,7),leaf:new THREE.SphereGeometry(1,6,3),torus:new THREE.TorusGeometry(1,.13,6,20)};\nfunction mesh(g,m,parent,x=0,y=0,z=0,sx=1,sy=sx,sz=sx,outline=false){const obj=new THREE.Mesh(g,m);obj.position.set(x,y,z);obj.scale.set(sx,sy,sz);obj.castShadow=true;obj.receiveShadow=true;parent.add(obj);if(outline){const ink=new THREE.Mesh(g,inkMat);ink.scale.setScalar(1.055);ink.castShadow=false;obj.add(ink)}return obj}\nfunction box(parent,m,x,y,z,w,h,d,outline=false){return mesh(geo.box,m,parent,x,y,z,w,h,d,outline)}\nconst staticGroups=new Map();\nconst edgePositions=[];\nconst tempObj=new THREE.Object3D();\nfunction stamp(g,m,x,y,z,sx=1,sy=sx,sz=sx,rx=0,ry=0,rz=0,edges=false){const key=g.uuid+'\"'/'+m.uuid;let batch=staticGroups.get(key);if(\"'!batch){batch={g,m,matrices:[]};staticGroups.set(key,batch)}tempObj.position.set(x,y,z);tempObj.rotation.set(rx,ry,rz);tempObj.scale.set(sx,sy,sz);tempObj.updateMatrix();batch.matrices.push(tempObj.matrix.clone());if(edges){const e=new THREE.EdgesGeometry(g,30);const a=e.attributes.position;const v=new THREE.Vector3();for(let i=0;i<a.count;i++){v.fromBufferAttribute(a,i).applyMatrix4(tempObj.matrix);edgePositions.push(v.x,v.y,v.z)}e.dispose()}}\nfunction finishStatic(){for(const b of staticGroups.values()){const im=new THREE.InstancedMesh(b.g,b.m,b.matrices.length);b.matrices.forEach((mt,i)=>im.setMatrixAt(i,mt));im.castShadow=true;im.receiveShadow=true;decorRoot.add(im)}staticGroups.clear();const eg=new THREE.BufferGeometry();eg.setAttribute('\"'position',new THREE.Float32BufferAttribute(edgePositions,3));decorRoot.add(new THREE.LineSegments(eg,lineMat));edgePositions.length=0}\nfunction solid(x,y,z,w,h,d,options={}){const body=physics.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x,y,z));const co=RAPIER.ColliderDesc.cuboid(w/2,h/2,d/2).setFriction(.85);if(options.sensor)co.setSensor(true);const collider=physics.createCollider(co,body);return {body,collider}}\nfunction rngFactory(seed){let s=seed>>>0;return()=>{s\"'^=s<<13;s''^=s>>>17;s''^=s<<5;return(s>>>0)/4294967296}}\nconst artRand=rngFactory(19821105);\nfunction makeLabel(text,w=5,color='\"'#f1d99f',size=52){const c=document.createElement('canvas');c.width=512;c.height=128;const ctx=c.getContext('2d');ctx.fillStyle=color;ctx.font='bold '+size+'px Georgia';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(text,256,64,490);const tex=new THREE.CanvasTexture(c);const m=new THREE.MeshBasicMaterial({map:tex,transparent:true,depthWrite:false,side:THREE.DoubleSide});const plane=new THREE.Mesh(new THREE.PlaneGeometry(w,w/4),m);return plane}\nfunction burst(x,y,z,color=0xf5c666,n=12,force=4){if(\"'!worldObjects)return;for(let i=0;i<n;i++){const part=mesh(geo.rock,toon(color),effectRoot,x,y,z,.045+artRand()*.09);worldObjects.particles.push({mesh:part,v:new THREE.Vector3((artRand()-.5)*force,artRand()*force+1,(artRand()-.5)*force),life:.5+artRand()*.6,max:1})}}\nfunction lineBetween(a,b,color=0xf8cb75,width=1){const g=new THREE.BufferGeometry().setFromPoints([a,b]);return new THREE.Line(g,new THREE.LineBasicMaterial({color,transparent:true,opacity:width}))}\nfunction clearEffects(){if(!worldObjects)return;for(const p of worldObjects.particles){effectRoot.remove(p.mesh)}worldObjects.particles=[];for(const p of worldObjects.projectiles){effectRoot.remove(p.mesh)}worldObjects.projectiles=[]}\nfunction resize(){if(!renderer)return;const w=innerWidth,h=innerHeight;renderer.setPixelRatio(Math.min(devicePixelRatio,1.7));renderer.setSize(w,h,false);const span=(h>w?30:24)*settings.zoom;camera.left=-span*w/h/2;camera.right=span*w/h/2;camera.top=span/2;camera.bottom=-span/2;camera.updateProjectionMatrix()}\nfunction screenToWorld(cx,cy){raycaster.setFromCamera(new THREE.Vector2(cx/innerWidth*2-1,-cy/innerHeight*2+1),camera);const p=new THREE.Vector3();return raycaster.ray.intersectPlane(aimPlane,p)}\nasync function initEngine(){\n  await RAPIER.init();\n  physics=new RAPIER.World({x:0,y:-22,z:0});physics.timestep=1/60;\n  scene=new THREE.Scene();scene.background=new THREE.Color(0x426b68);scene.fog=new THREE.FogExp2(0x426b68,.009);\n  camera=new THREE.OrthographicCamera(-20,20,12,-12,.1,240);\n  renderer=new THREE.WebGPURenderer({canvas:$('\"'scene'),antialias:true,powerPreference:'high-performance'});\n  renderer.setClearColor(0x426b68);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;\n  renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.2;\n  await renderer.init();\n  renderer.onDeviceLost=()=>{if(AIHub.active)AIHub.fail('The graphics device was lost.');\"'$('\"'loadtext').textContent='The graphics device was lost. Reload to resume your checkpoint.';\"'$('\"'loading').hidden=false};\n  scene.add(new THREE.HemisphereLight(0xfff0ce,0x2b6566,2.3));\n  shadowLight=new THREE.DirectionalLight(0xffdc95,3.1);shadowLight.position.set(-17,30,8);shadowLight.castShadow=true;shadowLight.shadow.mapSize.set(2048,2048);shadowLight.shadow.camera.left=-24;shadowLight.shadow.camera.right=24;shadowLight.shadow.camera.top=28;shadowLight.shadow.camera.bottom=-28;shadowLight.shadow.camera.far=90;shadowLight.shadow.bias=-.0006;shadowLight.shadow.normalBias=.04;scene.add(shadowLight);scene.add(shadowLight.target);\n  const rim=new THREE.DirectionalLight(0x8bdbd1,1.1);rim.position.set(15,12,-30);scene.add(rim);\n  decorRoot=new THREE.Group();actorsRoot=new THREE.Group();effectRoot=new THREE.Group();scene.add(decorRoot,actorsRoot,effectRoot);\n  resize();addEventListener('resize',resize);worldReady=true;\n}\nEOF\ncat > src/audio.js <<'EOF'\nclass PulpAudio{\n  constructor(){this.ctx=null;this.nextNote=0;this.note=0;this.played={music:0,effects:0,voices:0};this.muted=false;this.level=0;this.lastVoice=0}\n  unlock(){if(\"'!this.ctx){try{this.ctx=new (window.AudioContext||window.webkitAudioContext)();this.master=this.ctx.createGain();this.master.gain.value=settings.master;this.music=this.ctx.createGain();this.music.gain.value=settings.music;this.sfx=this.ctx.createGain();this.sfx.gain.value=settings.sfx;this.analyser=this.ctx.createAnalyser();this.analyser.fftSize=256;this.music.connect(this.master);this.sfx.connect(this.master);this.master.connect(this.analyser);this.analyser.connect(this.ctx.destination);this.noise=this.ctx.createBuffer(1,this.ctx.sampleRate,this.ctx.sampleRate);const a=this.noise.getChannelData(0),r=rngFactory(903);for(let i=0;i<a.length;i++)a[i]=r()*2-1;this.nextNote=this.ctx.currentTime+.1}catch{return}}if(this.ctx.state==='\"'suspended')this.ctx.resume().catch(()=>{})}\n  updateSettings(){if(\"'!this.ctx)return;const t=this.ctx.currentTime;this.master.gain.setTargetAtTime(this.muted?0:settings.master,t,.05);this.music.gain.setTargetAtTime(settings.music,t,.05);this.sfx.gain.setTargetAtTime(settings.sfx,t,.05)}\n  tone(freq,time,duration,gain=.1,type='\"'triangle',dest=this.sfx,endFreq=null){if(\"'!this.ctx||this.muted)return;const c=this.ctx,o=c.createOscillator(),g=c.createGain();o.type=type;o.frequency.setValueAtTime(freq,time);if(endFreq)o.frequency.exponentialRampToValueAtTime(Math.max(10,endFreq),time+duration);g.gain.setValueAtTime(.0001,time);g.gain.exponentialRampToValueAtTime(Math.max(.0002,gain),time+.012);g.gain.exponentialRampToValueAtTime(.0001,time+duration);o.connect(g);g.connect(dest);o.start(time);o.stop(time+duration+.02)}\n  hiss(duration,gain=.15,filter=1700){if(!this.ctx||this.muted)return;const c=this.ctx,t=c.currentTime,b=c.createBufferSource(),g=c.createGain(),f=c.createBiquadFilter();b.buffer=this.noise;f.type='\"'bandpass';f.frequency.value=filter;f.Q.value=.6;g.gain.setValueAtTime(gain,t);g.gain.exponentialRampToValueAtTime(.0001,t+duration);b.connect(f);f.connect(g);g.connect(this.sfx);b.start(t);b.stop(t+duration)}\n  effect(kind){if(\"'!this.ctx||this.muted)return;this.played.effects++;const t=this.ctx.currentTime;switch(kind){case'\"'whip':this.hiss(.16,.38,2400);this.tone(180,t+.06,.07,.22,'sawtooth',this.sfx,45);break;case'shot':this.hiss(.22,.5,950);this.tone(100,t,.15,.3,'square',this.sfx,28);break;case'hit':this.tone(150,t,.13,.15,'sawtooth',this.sfx,55);this.hiss(.1,.1,600);break;case'jump':this.tone(200,t,.18,.05,'triangle',this.sfx,420);break;case'roll':this.hiss(.25,.12,500);break;case'pickup':[523,659,784].forEach((n,i)=>this.tone(n,t+i*.07,.23,.08));break;case'lens':this.tone(330,t,.3,.1,'sine');this.tone(660,t+.1,.4,.07,'triangle');this.hiss(.1,.1,700);break;case'gate':this.hiss(1.3,.3,190);this.tone(65,t,1.1,.12,'sawtooth');break;case'grapple':this.hiss(.35,.17,1400);this.tone(220,t,.35,.08,'sine',this.sfx,640);break;case'dart':this.hiss(.13,.08,3500);break;case'empty':this.tone(900,t,.035,.035,'square');break;case'ui':this.tone(440,t,.065,.035,'triangle');break;case'rumble':this.hiss(.6,.27,100);this.tone(38,t,.6,.18,'sawtooth');break;case'win':[262,330,392,523,659,784,1046].forEach((n,i)=>this.tone(n,t+i*.16,.65,.11,'triangle'));break;case'fail':[220,207,196,147].forEach((n,i)=>this.tone(n,t+i*.2,.45,.08,'triangle'));break}}\n  voice(text,low=false){if(\"'!this.ctx||this.muted)return;const t=this.ctx.currentTime;if(t-this.lastVoice<.6)return;this.lastVoice=t;this.played.voices++;const syllables=Math.min(22,Math.max(5,Math.floor(text.length/4)));for(let i=0;i<syllables;i++){const base=(low?125:210)+((text.charCodeAt(i%text.length)*13+i*17)%190);this.tone(base,t+i*.075,.063,.027,'\"'sawtooth');this.tone(base*2.3,t+i*.075,.04,.009,'sine')}}\n  tick(phase,dt){if(\"'!this.ctx||this.muted||this.ctx.state!=='\"'running')return;this.updateSettings();const t=this.ctx.currentTime;if(this.nextNote<t-.5)this.nextNote=t+.05;const melody=[0,7,12,10,7,3,5,7,0,7,12,15,14,10,7,5,3,7,10,12,7,5,3,2,0,3,7,10,7,5,2,0];const fast=phase==='escape',beat=fast?.205:.32;while(this.nextNote<t+.12){const k=this.note%32,root=fast?146.83:130.81,n=melody[k],f=root*2**(n/12);this.tone(f,this.nextNote,beat*.83,.22,'triangle',this.music);if(k%4===0){this.tone(root/2,this.nextNote,beat*3,.23,'triangle',this.music);this.tone(f*1.5,this.nextNote,beat*1.8,.07,'sine',this.music)}if(k%2===0)this.tone(k%4===0?60:120,this.nextNote,.11,.16,'sine',this.music,24);this.note++;this.played.music++;this.nextNote+=beat}const bins=new Uint8Array(this.analyser.frequencyBinCount);this.analyser.getByteTimeDomainData(bins);this.level=Math.sqrt(bins.reduce((s,x)=>s+((x-128)/128)**2,0)/bins.length)}\n  stop(){this.muted=true;if(this.ctx)this.master.gain.setTargetAtTime(0,this.ctx.currentTime,.03)}\n  resume(){this.muted=false;this.updateSettings()}\n}\nconst audio=new PulpAudio();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > src/engine.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nconst TITLE='Raiders of the Golden Goose';\nconst \"'$=id=>document.getElementById(id);\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst TAU=Math.PI*2;\nconst dist=(a,b)=>Math.hypot(a.x-b.x,a.z-b.z);\nconst testMode=new URLSearchParams(location.search).get('\"'test')==='1';\nconst DEFAULT_TUNING=Object.freeze({moveSpeed:6.3,jumpPower:8,whipReach:3.7,enemyAggression:1,trapTempo:1,boulderSpeed:6.8,damageScale:1});\nconst tuning={...DEFAULT_TUNING};\nconst settings={master:.7,music:.1,sfx:.8,glyphs:'PlayStation',zoom:1,shake:.65,assist:true};\nconst safeStore={get(key){try{return localStorage.getItem('goldengoose:'+key)}catch{return null}},set(key,val){try{localStorage.setItem('goldengoose:'+key,val)}catch{}},remove(key){try{localStorage.removeItem('goldengoose:'+key)}catch{}}};\nif(\"'!AIHub.active){try{Object.assign(settings,JSON.parse(safeStore.get('\"'settings')||'{}'))}catch{}}\nlet scene,camera,renderer,physics,groundMat,actors,worldObjects,playerId=0;\nlet actorsRoot,decorRoot,effectRoot,ambientTime=0,renderTime=0,shakeTime=0;\nlet shadowLight,worldReady=false;\nconst cameraTarget=new THREE.Vector3(0,0,-10);\nconst cameraPosition=new THREE.Vector3();\nconst aimPlane=new THREE.Plane(new THREE.Vector3(0,1,0),0);\nconst raycaster=new THREE.Raycaster();\nconst materials={};\nconst gradient=new THREE.DataTexture(new Uint8Array([85,85,85,178,178,178,255,255,255]),3,1,THREE.RGBFormat);\n// RGBA is used because WebGPU texture formats have no RGB8 equivalent.\nconst celTexture=new THREE.DataTexture(new Uint8Array([80,80,80,255,174,174,174,255,255,255,255,255]),3,1,THREE.RGBAFormat);\ncelTexture.needsUpdate=true;celTexture.minFilter=THREE.NearestFilter;celTexture.magFilter=THREE.NearestFilter;\nfunction toon(color,options={}){const key=color+JSON.stringify(options);if(\"'!materials[key])materials[key]=new THREE.MeshToonMaterial({color,gradientMap:celTexture,...options});return materials[key]}\nconst inkMat=new THREE.MeshBasicMaterial({color:0x122526,side:THREE.BackSide});\nconst lineMat=new THREE.LineBasicMaterial({color:0x1d3231,transparent:true,opacity:.5});\nconst geo={box:new THREE.BoxGeometry(1,1,1),sphere:new THREE.SphereGeometry(1,12,8),rock:new THREE.IcosahedronGeometry(1,1),cylinder:new THREE.CylinderGeometry(1,1,1,10),cone:new THREE.ConeGeometry(1,1,7),leaf:new THREE.SphereGeometry(1,6,3),torus:new THREE.TorusGeometry(1,.13,6,20)};\nfunction mesh(g,m,parent,x=0,y=0,z=0,sx=1,sy=sx,sz=sx,outline=false){const obj=new THREE.Mesh(g,m);obj.position.set(x,y,z);obj.scale.set(sx,sy,sz);obj.castShadow=true;obj.receiveShadow=true;parent.add(obj);if(outline){const ink=new THREE.Mesh(g,inkMat);ink.scale.setScalar(1.055);ink.castShadow=false;obj.add(ink)}return obj}\nfunction box(parent,m,x,y,z,w,h,d,outline=false){return mesh(geo.box,m,parent,x,y,z,w,h,d,outline)}\nconst staticGroups=new Map();\nconst edgePositions=[];\nconst tempObj=new THREE.Object3D();\nfunction stamp(g,m,x,y,z,sx=1,sy=sx,sz=sx,rx=0,ry=0,rz=0,edges=false){const key=g.uuid+'\"'/'+m.uuid;let batch=staticGroups.get(key);if(\"'!batch){batch={g,m,matrices:[]};staticGroups.set(key,batch)}tempObj.position.set(x,y,z);tempObj.rotation.set(rx,ry,rz);tempObj.scale.set(sx,sy,sz);tempObj.updateMatrix();batch.matrices.push(tempObj.matrix.clone());if(edges){const e=new THREE.EdgesGeometry(g,30);const a=e.attributes.position;const v=new THREE.Vector3();for(let i=0;i<a.count;i++){v.fromBufferAttribute(a,i).applyMatrix4(tempObj.matrix);edgePositions.push(v.x,v.y,v.z)}e.dispose()}}\nfunction finishStatic(){for(const b of staticGroups.values()){const im=new THREE.InstancedMesh(b.g,b.m,b.matrices.length);b.matrices.forEach((mt,i)=>im.setMatrixAt(i,mt));im.castShadow=true;im.receiveShadow=true;decorRoot.add(im)}staticGroups.clear();const eg=new THREE.BufferGeometry();eg.setAttribute('\"'position',new THREE.Float32BufferAttribute(edgePositions,3));decorRoot.add(new THREE.LineSegments(eg,lineMat));edgePositions.length=0}\nfunction solid(x,y,z,w,h,d,options={}){const body=physics.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x,y,z));const co=RAPIER.ColliderDesc.cuboid(w/2,h/2,d/2).setFriction(.85);if(options.sensor)co.setSensor(true);const collider=physics.createCollider(co,body);return {body,collider}}\nfunction rngFactory(seed){let s=seed>>>0;return()=>{s\"'^=s<<13;s''^=s>>>17;s''^=s<<5;return(s>>>0)/4294967296}}\nconst artRand=rngFactory(19821105);\nfunction makeLabel(text,w=5,color='\"'#f1d99f',size=52){const c=document.createElement('canvas');c.width=512;c.height=128;const ctx=c.getContext('2d');ctx.fillStyle=color;ctx.font='bold '+size+'px Georgia';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(text,256,64,490);const tex=new THREE.CanvasTexture(c);const m=new THREE.MeshBasicMaterial({map:tex,transparent:true,depthWrite:false,side:THREE.DoubleSide});const plane=new THREE.Mesh(new THREE.PlaneGeometry(w,w/4),m);return plane}\nfunction burst(x,y,z,color=0xf5c666,n=12,force=4){if(\"'!worldObjects)return;for(let i=0;i<n;i++){const part=mesh(geo.rock,toon(color),effectRoot,x,y,z,.045+artRand()*.09);worldObjects.particles.push({mesh:part,v:new THREE.Vector3((artRand()-.5)*force,artRand()*force+1,(artRand()-.5)*force),life:.5+artRand()*.6,max:1})}}\nfunction lineBetween(a,b,color=0xf8cb75,width=1){const g=new THREE.BufferGeometry().setFromPoints([a,b]);return new THREE.Line(g,new THREE.LineBasicMaterial({color,transparent:true,opacity:width}))}\nfunction clearEffects(){if(!worldObjects)return;for(const p of worldObjects.particles){effectRoot.remove(p.mesh)}worldObjects.particles=[];for(const p of worldObjects.projectiles){effectRoot.remove(p.mesh)}worldObjects.projectiles=[]}\nfunction resize(){if(!renderer)return;const w=innerWidth,h=innerHeight;renderer.setPixelRatio(Math.min(devicePixelRatio,1.7));renderer.setSize(w,h,false);const span=(h>w?30:24)*settings.zoom;camera.left=-span*w/h/2;camera.right=span*w/h/2;camera.top=span/2;camera.bottom=-span/2;camera.updateProjectionMatrix()}\nfunction screenToWorld(cx,cy){raycaster.setFromCamera(new THREE.Vector2(cx/innerWidth*2-1,-cy/innerHeight*2+1),camera);const p=new THREE.Vector3();return raycaster.ray.intersectPlane(aimPlane,p)}\nasync function initEngine(){\n  await RAPIER.init();\n  physics=new RAPIER.World({x:0,y:-22,z:0});physics.timestep=1/60;\n  scene=new THREE.Scene();scene.background=new THREE.Color(0x426b68);scene.fog=new THREE.FogExp2(0x426b68,.009);\n  camera=new THREE.OrthographicCamera(-20,20,12,-12,.1,240);\n  renderer=new THREE.WebGPURenderer({canvas:$('\"'scene'),antialias:true,powerPreference:'high-performance'});\n  renderer.setClearColor(0x426b68);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;\n  renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.2;\n  await renderer.init();\n  renderer.onDeviceLost=()=>{if(AIHub.active)AIHub.fail('The graphics device was lost.');\"'$('\"'loadtext').textContent='The graphics device was lost. Reload to resume your checkpoint.';\"'$('\"'loading').hidden=false};\n  scene.add(new THREE.HemisphereLight(0xfff0ce,0x2b6566,2.3));\n  shadowLight=new THREE.DirectionalLight(0xffdc95,3.1);shadowLight.position.set(-17,30,8);shadowLight.castShadow=true;shadowLight.shadow.mapSize.set(2048,2048);shadowLight.shadow.camera.left=-24;shadowLight.shadow.camera.right=24;shadowLight.shadow.camera.top=28;shadowLight.shadow.camera.bottom=-28;shadowLight.shadow.camera.far=90;shadowLight.shadow.bias=-.0006;shadowLight.shadow.normalBias=.04;scene.add(shadowLight);scene.add(shadowLight.target);\n  const rim=new THREE.DirectionalLight(0x8bdbd1,1.1);rim.position.set(15,12,-30);scene.add(rim);\n  decorRoot=new THREE.Group();actorsRoot=new THREE.Group();effectRoot=new THREE.Group();scene.add(decorRoot,actorsRoot,effectRoot);\n  resize();addEventListener('resize',resize);worldReady=true;\n}\nEOF\ncat > src/audio.js <<'EOF'\nclass PulpAudio{\n  constructor(){this.ctx=null;this.nextNote=0;this.note=0;this.played={music:0,effects:0,voices:0};this.muted=false;this.level=0;this.lastVoice=0}\n  unlock(){if(\"'!this.ctx){try{this.ctx=new (window.AudioContext||window.webkitAudioContext)();this.master=this.ctx.createGain();this.master.gain.value=settings.master;this.music=this.ctx.createGain();this.music.gain.value=settings.music;this.sfx=this.ctx.createGain();this.sfx.gain.value=settings.sfx;this.analyser=this.ctx.createAnalyser();this.analyser.fftSize=256;this.music.connect(this.master);this.sfx.connect(this.master);this.master.connect(this.analyser);this.analyser.connect(this.ctx.destination);this.noise=this.ctx.createBuffer(1,this.ctx.sampleRate,this.ctx.sampleRate);const a=this.noise.getChannelData(0),r=rngFactory(903);for(let i=0;i<a.length;i++)a[i]=r()*2-1;this.nextNote=this.ctx.currentTime+.1}catch{return}}if(this.ctx.state==='\"'suspended')this.ctx.resume().catch(()=>{})}\n  updateSettings(){if(\"'!this.ctx)return;const t=this.ctx.currentTime;this.master.gain.setTargetAtTime(this.muted?0:settings.master,t,.05);this.music.gain.setTargetAtTime(settings.music,t,.05);this.sfx.gain.setTargetAtTime(settings.sfx,t,.05)}\n  tone(freq,time,duration,gain=.1,type='\"'triangle',dest=this.sfx,endFreq=null){if(\"'!this.ctx||this.muted)return;const c=this.ctx,o=c.createOscillator(),g=c.createGain();o.type=type;o.frequency.setValueAtTime(freq,time);if(endFreq)o.frequency.exponentialRampToValueAtTime(Math.max(10,endFreq),time+duration);g.gain.setValueAtTime(.0001,time);g.gain.exponentialRampToValueAtTime(Math.max(.0002,gain),time+.012);g.gain.exponentialRampToValueAtTime(.0001,time+duration);o.connect(g);g.connect(dest);o.start(time);o.stop(time+duration+.02)}\n  hiss(duration,gain=.15,filter=1700){if(!this.ctx||this.muted)return;const c=this.ctx,t=c.currentTime,b=c.createBufferSource(),g=c.createGain(),f=c.createBiquadFilter();b.buffer=this.noise;f.type='\"'bandpass';f.frequency.value=filter;f.Q.value=.6;g.gain.setValueAtTime(gain,t);g.gain.exponentialRampToValueAtTime(.0001,t+duration);b.connect(f);f.connect(g);g.connect(this.sfx);b.start(t);b.stop(t+duration)}\n  effect(kind){if(\"'!this.ctx||this.muted)return;this.played.effects++;const t=this.ctx.currentTime;switch(kind){case'\"'whip':this.hiss(.16,.38,2400);this.tone(180,t+.06,.07,.22,'sawtooth',this.sfx,45);break;case'shot':this.hiss(.22,.5,950);this.tone(100,t,.15,.3,'square',this.sfx,28);break;case'hit':this.tone(150,t,.13,.15,'sawtooth',this.sfx,55);this.hiss(.1,.1,600);break;case'jump':this.tone(200,t,.18,.05,'triangle',this.sfx,420);break;case'roll':this.hiss(.25,.12,500);break;case'pickup':[523,659,784].forEach((n,i)=>this.tone(n,t+i*.07,.23,.08));break;case'lens':this.tone(330,t,.3,.1,'sine');this.tone(660,t+.1,.4,.07,'triangle');this.hiss(.1,.1,700);break;case'gate':this.hiss(1.3,.3,190);this.tone(65,t,1.1,.12,'sawtooth');break;case'grapple':this.hiss(.35,.17,1400);this.tone(220,t,.35,.08,'sine',this.sfx,640);break;case'dart':this.hiss(.13,.08,3500);break;case'empty':this.tone(900,t,.035,.035,'square');break;case'ui':this.tone(440,t,.065,.035,'triangle');break;case'rumble':this.hiss(.6,.27,100);this.tone(38,t,.6,.18,'sawtooth');break;case'win':[262,330,392,523,659,784,1046].forEach((n,i)=>this.tone(n,t+i*.16,.65,.11,'triangle'));break;case'fail':[220,207,196,147].forEach((n,i)=>this.tone(n,t+i*.2,.45,.08,'triangle'));break}}\n  voice(text,low=false){if(\"'!this.ctx||this.muted)return;const t=this.ctx.currentTime;if(t-this.lastVoice<.6)return;this.lastVoice=t;this.played.voices++;const syllables=Math.min(22,Math.max(5,Math.floor(text.length/4)));for(let i=0;i<syllables;i++){const base=(low?125:210)+((text.charCodeAt(i%text.length)*13+i*17)%190);this.tone(base,t+i*.075,.063,.027,'\"'sawtooth');this.tone(base*2.3,t+i*.075,.04,.009,'sine')}}\n  tick(phase,dt){if(\"'!this.ctx||this.muted||this.ctx.state!=='\"'running')return;this.updateSettings();const t=this.ctx.currentTime;if(this.nextNote<t-.5)this.nextNote=t+.05;const melody=[0,7,12,10,7,3,5,7,0,7,12,15,14,10,7,5,3,7,10,12,7,5,3,2,0,3,7,10,7,5,2,0];const fast=phase==='escape',beat=fast?.205:.32;while(this.nextNote<t+.12){const k=this.note%32,root=fast?146.83:130.81,n=melody[k],f=root*2**(n/12);this.tone(f,this.nextNote,beat*.83,.22,'triangle',this.music);if(k%4===0){this.tone(root/2,this.nextNote,beat*3,.23,'triangle',this.music);this.tone(f*1.5,this.nextNote,beat*1.8,.07,'sine',this.music)}if(k%2===0)this.tone(k%4===0?60:120,this.nextNote,.11,.16,'sine',this.music,24);this.note++;this.played.music++;this.nextNote+=beat}const bins=new Uint8Array(this.analyser.frequencyBinCount);this.analyser.getByteTimeDomainData(bins);this.level=Math.sqrt(bins.reduce((s,x)=>s+((x-128)/128)**2,0)/bins.length)}\n  stop(){this.muted=true;if(this.ctx)this.master.gain.setTargetAtTime(0,this.ctx.currentTime,.03)}\n  resume(){this.muted=false;this.updateSettings()}\n}\nconst audio=new PulpAudio();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat > src/world.js <<'EOF'\nconst PALETTE={stone:0xc5a371,light:0xe1c18b,dark:0x987b54,edge:0x655b44,sand:0xc8b77d,moss:0x547b55,leaf:0x377465,lightleaf:0x619277,trunk:0x66553b,gold:0xf4ba46,water:0x285e61,red:0x9f483b,teal:0x388c89};\nfunction stoneBlock(x,y,z,w,h,d,c=PALETTE.stone,edges=true){stamp(geo.box,toon(c),x,y,z,w,h,d,0,0,0,edges)}\nfunction ground(x1,x2,z1,z2,kind='stone'){\n  const lo=Math.min(z1,z2),hi=Math.max(z1,z2);solid((x1+x2)/2,-.55,(lo+hi)/2,x2-x1,1.1,hi-lo);\n  stamp(geo.box,toon(0x4a5545),(x1+x2)/2,-.43,(lo+hi)/2,x2-x1,.6,hi-lo);\n  for(let x=x1+.98;x<x2;x+=2)for(let z=lo+.98;z<hi;z+=2){const c=kind==='sand'?[0xb5a272,0xc6b481,0xb9ab7c][Math.floor(artRand()*3)]:[0xc6ab7b,0xb59b70,0xd1b584,0xbca174][Math.floor(artRand()*4)];stamp(geo.box,toon(c),x,-.14,z,1.93,.28,1.93,0,0,0,false);if(artRand()<.13)stamp(geo.box,toon(PALETTE.moss),x+(artRand()-.5),.015,z+(artRand()-.5),.35+artRand()*.8,.025,.2+artRand()*.8,0,artRand()*3,0)}\n}\nfunction column(x,z,h=4.5){stoneBlock(x,.25,z,1.5,.5,1.5,PALETTE.dark);stoneBlock(x,.65,z,1.2,.3,1.2,PALETTE.light);stamp(geo.cylinder,toon(PALETTE.stone),x,h/2+.6,z,.47,h,.47,0,0,0,true);for(let k=1;k<4;k++)stamp(geo.torus,toon(PALETTE.dark),x,.75+k*h/4,z,.49,.49,.49,Math.PI/2);stoneBlock(x,h+.7,z,1.4,.45,1.4,PALETTE.light);solid(x,h/2,z,1.2,h,1.2)}\nfunction arch(x,z,w=7,h=5){column(x-w/2,z,h);column(x+w/2,z,h);stoneBlock(x,h+1,z,w+2,1.1,1.7,PALETTE.dark);stoneBlock(x,h+1.65,z,w+2.5,.3,2,PALETTE.light);for(let i=-2;i<=2;i++)stoneBlock(x+i*1.05,h+1.05,z+.88,.7,.55,.08,i===0?PALETTE.gold:PALETTE.light);for(let side of [-1,1]){stamp(geo.cone,toon(PALETTE.gold),x+side*(w/2),h+2,z,.5,.8,.5);}}\nfunction palm(x,z,s=1){const lean=(artRand()-.5)*.25;stamp(geo.cylinder,toon(PALETTE.trunk),x,3.8*s,z,.3*s,7.6*s,.3*s,0,0,lean);for(let k=0;k<7;k++){const a=k/7*TAU+artRand()*.2;stamp(geo.leaf,toon(k%2?PALETTE.leaf:PALETTE.lightleaf),x+Math.sin(a)*1.5*s,7.7*s,z+Math.cos(a)*1.5*s,.65*s,.18*s,2.8*s,.18,a,.08)}for(let k=0;k<3;k++)stamp(geo.sphere,toon(PALETTE.trunk),x+(artRand()-.5)*.6*s,7*s,z+(artRand()-.5)*.6*s,.23*s)}\nfunction fern(x,z,s=1){for(let k=0;k<5;k++){const a=k/5*TAU;stamp(geo.leaf,toon(k%2?PALETTE.moss:PALETTE.leaf),x+Math.sin(a)*.45*s,.35*s,z+Math.cos(a)*.45*s,.22*s,.12*s,1.1*s,-.4,a,0)}}\nfunction brazier(x,z){stoneBlock(x,.4,z,.7,.8,.7,PALETTE.edge);stamp(geo.cylinder,toon(PALETTE.gold),x,.95,z,.44,.3,.44);const flame=new THREE.Group();flame.position.set(x,1.3,z);mesh(geo.cone,new THREE.MeshBasicMaterial({color:0xffa23c}),flame,0,0,0,.22,.8,.22);mesh(geo.cone,new THREE.MeshBasicMaterial({color:0xffe8a0}),flame,0,-.1,.05,.12,.5,.12);decorRoot.add(flame);worldObjects.flames.push(flame)}\nfunction makeGoose(parent,scale=1){const goose=new THREE.Group();parent.add(goose);goose.scale.setScalar(scale);const gold=toon(PALETTE.gold),shade=toon(0xc4882d);mesh(geo.sphere,gold,goose,0,.45,0,.56,.43,.8,true);mesh(geo.sphere,shade,goose,.48,.51,-.05,.12,.28,.48,true);mesh(geo.sphere,shade,goose,-.48,.51,-.05,.12,.28,.48,true);mesh(geo.cylinder,gold,goose,0,.98,-.4,.16,.78,.16,true);mesh(geo.sphere,gold,goose,0,1.4,-.47,.29,.26,.32,true);mesh(geo.cone,toon(0xee8c32),goose,0,1.36,-.86,.15,.4,.15,true).rotation.x=-Math.PI/2;for(let s of [-1,1]){mesh(geo.sphere,inkMat,goose,s*.235,1.46,-.61,.055);box(goose,shade,s*.23,.07,.06,.26,.07,.45)}return goose}\nfunction makeExplorer(colorIndex=0,enemy=false,boss=false){\n  const root=new THREE.Group();const rig=new THREE.Group();rig.name='rig';root.add(rig);\n  const jacket=toon(enemy?(boss?0x754b3e:0x756b4a):[0x966241,0x398985,0xb37046,0x71855a][colorIndex%4]);\n  const shirt=toon(enemy?0xbeb485:0xead3a4),skin=toon([0xd59b68,0xb87b55,0xdfb37a,0x9a674e][colorIndex%4]),pants=toon(enemy?0x434c45:0x5b6256),boot=toon(0x383d35),band=toon(enemy?0x6a312a:[0xd7a445,0xe3b871,0x5aada6,0xc37b5d][colorIndex%4]);\n  const body=new THREE.Group();body.name='torso';body.position.y=1.03;rig.add(body);box(body,jacket,0,.09,0,.68,.69,.36,true);box(body,shirt,0,.13,-.193,.27,.56,.045);box(body,boot,0,-.16,-.01,.72,.1,.4);\n  const head=new THREE.Group();head.name='head';head.position.set(0,1.67,0);rig.add(head);mesh(geo.sphere,skin,head,0,0,0,.27,.31,.25,true);box(head,toon(0x4b3e31),0,.11,.07,.49,.2,.33);for(let s of [-1,1])box(head,toon(0x16272b),s*.1,.02,-.24,.04,.055,.02);box(head,skin,0,-.02,-.29,.08,.09,.12);\n  if(\"'!enemy||boss){mesh(geo.cylinder,toon(enemy?0x594a3a:0x9c7443),head,0,.27,0,.46,.075,.4,true);mesh(geo.cylinder,toon(enemy?0x594a3a:0x9c7443),head,0,.4,0,.29,.25,.27,true);mesh(geo.cylinder,band,head,0,.3,0,.295,.055,.275)}else{mesh(geo.cylinder,toon(0x665d45),head,0,.27,0,.31,.16,.3,true);box(head,boot,0,.23,-.3,.5,.05,.24)}\n  for(const s of [-1,1]){const leg=new THREE.Group();leg.name=s<0?'\"'legL':'legR';leg.position.set(s*.2,.77,0);rig.add(leg);box(leg,pants,0,-.24,0,.25,.53,.29,true);box(leg,boot,0,-.57,-.06,.29,.17,.43,true);const arm=new THREE.Group();arm.name=s<0?'armL':'armR';arm.position.set(s*.46,1.32,0);rig.add(arm);box(arm,jacket,0,-.22,0,.24,.43,.27,true);mesh(geo.sphere,skin,arm,0,-.49,-.015,.135,.16,.13,true)}\n  const satchel=box(rig,toon(0x6b4d32),.38,.84,.2,.29,.4,.22,true);satchel.rotation.z=-.15;box(rig,band,-.1,1.08,-.21,.075,.8,.04).rotation.z=-.55;\n  const gun=new THREE.Group();gun.name='gun';rig.getObjectByName('armL').add(gun);box(gun,boot,0,-.5,-.18,.12,.13,.48,true);box(gun,toon(0x7d6749),0,-.61,-.06,.12,.21,.13);gun.visible=enemy;\n  const loop=mesh(geo.torus,toon(0x61452e),rig,.48,.7,-.1,.2,.3,.2);loop.rotation.y=.2;\n  const mixer=new THREE.AnimationMixer(rig),clips={};\n  function clip(name,duration,tracks){const c=new THREE.AnimationClip(name,duration,tracks);clips[name]=mixer.clipAction(c);return clips[name]}\n  const track=(path,ts,vs)=>new THREE.NumberKeyframeTrack(path,ts,vs);\n  clip('idle',2,[track('torso.position[y]',[0,1,2],[1.03,1.065,1.03]),track('head.rotation[z]',[0,1,2],[.025,-.025,.025])]);\n  const ts=[0,.15,.3,.45,.6];\n  clip('run',.6,[track('legL.rotation[x]',ts,[-.65,0,.65,0,-.65]),track('legR.rotation[x]',ts,[.65,0,-.65,0,.65]),track('armL.rotation[x]',ts,[.6,0,-.6,0,.6]),track('armR.rotation[x]',ts,[-.6,0,.6,0,-.6]),track('torso.position[y]',ts,[1.02,1.09,1.02,1.09,1.02])]);\n  clip('whip',.43,[track('armR.rotation[x]',[0,.12,.21,.43],[-.1,-2.9,-1.3,0]),track('armR.rotation[z]',[0,.12,.21,.43],[0,-.4,.55,0]),track('torso.rotation[y]',[0,.12,.23,.43],[0,-.4,.5,0])]);\n  clip('shoot',.25,[track('armL.rotation[x]',[0,.06,.13,.25],[-1.5,-1.8,-1.55,0])]);\n  clip('jump',.7,[track('legL.rotation[x]',[0,.2,.5,.7],[0,-.65,-.4,0]),track('legR.rotation[x]',[0,.2,.5,.7],[0,.35,.6,0]),track('armR.rotation[x]',[0,.2,.5,.7],[0,-2.2,-1.5,0]),track('armL.rotation[x]',[0,.2,.5,.7],[0,-1.9,-1.1,0])]);\n  clip('roll',.5,[track('rig.rotation[x]',[0,.125,.25,.375,.5],[0,-Math.PI/2,-Math.PI,-Math.PI*1.5,-TAU]),track('rig.position[y]',[0,.2,.35,.5],[0,.5,.4,0])]);\n  clip('grapple',1.15,[track('armR.rotation[x]',[0,.2,.85,1.15],[-1,-3,-2.9,0]),track('legL.rotation[x]',[0,.4,.85,1.15],[0,-.8,.3,0]),track('legR.rotation[x]',[0,.4,.85,1.15],[0,-.6,.6,0])]);\n  clip('down',.7,[track('rig.rotation[z]',[0,.3,.7],[0,1.2,Math.PI/2]),track('rig.position[y]',[0,.4,.7],[0,-.2,-.2])]);\n  clips.idle.play();let base='idle',oneShot='';\n  return{root,rig,mixer,clips,gun,animate(name,move=0,dt=1/60){const target=move>.2?'run':'idle';if(target\"'!==base){clips[base].fadeOut(.15);clips[target].reset().fadeIn(.15).play();base=target}clips.run.timeScale=Math.max(.65,move/5);if(name&&name!==oneShot&&clips[name]){if(oneShot&&clips[oneShot])clips[oneShot].fadeOut(.08);const a=clips[name];a.reset().setLoop(THREE.LoopOnce,1);a.clampWhenFinished=false;a.fadeIn(.04).play();oneShot=name}if(!name)oneShot='\"'';mixer.update(dt)}}\n}\nfunction makeSnake(){const root=new THREE.Group(),body=new THREE.Group();root.add(body);for(let i=0;i<7;i++){const part=mesh(geo.sphere,toon(i%2?0x6e8050:0x9a9a57),body,Math.sin(i*.9)*.13,.14,-i*.16,.18-i*.013,.15,.23,true);part.name='coil'+i}const head=mesh(geo.sphere,toon(0x9da468),body,0,.22,.2,.23,.2,.3,true);for(let s of [-1,1])mesh(geo.sphere,toon(0xf3bf57),head,s*.7,.25,.55,.1);const mixer=new THREE.AnimationMixer(body),tracks=[];for(let i=0;i<7;i++)tracks.push(new THREE.NumberKeyframeTrack('coil'+i+'.position[x]',[0,.3,.6,.9,1.2],[Math.sin(i)*.15,Math.sin(i+1.5)*.15,Math.sin(i+3)*.15,Math.sin(i+4.5)*.15,Math.sin(i)*.15]));mixer.clipAction(new THREE.AnimationClip('slither',1.2,tracks)).play();return{root,mixer,animate(name,move,dt){mixer.update(dt)}}}\nfunction makePickup(kind,x,z,id){const group=new THREE.Group();group.position.set(x,.55,z);decorRoot.add(group);if(kind==='treasure'){mesh(geo.rock,toon(PALETTE.gold),group,0,.12,0,.3,.42,.3,true);mesh(geo.torus,toon(PALETTE.gold),group,0,.14,0,.55,.55,.55).rotation.x=Math.PI/2}else{box(group,toon(kind==='health'?0xe2cfa4:0x72573a),0,0,0,.7,.5,.5,true);if(kind==='health'){box(group,toon(0xaf5945),0,.27,0,.12,.02,.38);box(group,toon(0xaf5945),0,.275,0,.4,.02,.12)}else for(let i=0;i<3;i++)mesh(geo.cylinder,toon(0xe5b660),group,(i-1)*.17,.35,0,.05,.22,.05)}const aura=mesh(geo.torus,new THREE.MeshBasicMaterial({color:kind==='treasure'?0xffc654:0xaed7b9,transparent:true,opacity:.5}),group,0,-.47,0,.65,.65,.65);aura.rotation.x=Math.PI/2;return{id,kind,x,z,mesh:group,taken:false}}\nfunction createEnemy(kind,x,z,id){const actor=kind==='snake'?makeSnake():makeExplorer(2,true,kind==='boss');actorsRoot.add(actor.root);actor.root.position.set(x,0,z);const maxHp=kind==='boss'?9:kind==='snake'?2:3;const radius=kind==='snake'?.3:.36,half=kind==='snake'?.12:.46;const body=physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,half+radius+.06,z).lockRotations().setLinearDamping(6).setCcdEnabled(true));const collider=physics.createCollider(RAPIER.ColliderDesc.capsule(half,radius).setMass(2),body);const hpRoot=new THREE.Group();hpRoot.position.y=kind==='snake'?.9:2.25;box(hpRoot,toon(0x253936),0,0,0,1,.085,.07);const bar=box(hpRoot,toon(kind==='boss'?0xf0ab52:0xc67652),0,0,-.02,.95,.06,.08);actor.root.add(hpRoot);hpRoot.visible=false;return{id,kind,x,z,y:0,angle:0,hp:maxHp,maxHp,body,collider,actor,bar,hpRoot,cooldown:1+id*.2,stun:0,telegraph:0,dead:false,spawn:{x,z},height:half+radius+.06}}\nfunction createWorld(){\n  worldObjects={mirrors:[],flames:[],particles:[],projectiles:[],enemies:[],pickups:[],traps:[],rubble:[],beams:[],door:null,sideDoor:null,boulder:null,goose:null};\n  ground(-10,10,14,-17,'sand');ground(-10,10,-24,-58);ground(-12,12,-58,-84);ground(10,26,-70,-80);ground(16,26,-80,-49);ground(16,26,-45,24,'sand');\n  // The river is real negative space in the collision world.\n  stamp(geo.box,toon(0x173d45),0,-4,-20.5,75,1,7);stamp(geo.box,toon(PALETTE.water),0,-3.15,-20.5,75,.08,6.7);\n  for(let k=0;k<32;k++)stamp(geo.box,toon(k%2?0x448a85:0x3a7779),-34+k*2.2,-3.09,-20.5+(artRand()-.5)*4,1.3,.02,.07);\n  for(const z of [-17,-24]){stoneBlock(0,-.25,z,20,.6,.5,PALETTE.dark);for(const x of [-9,-6,6,9])stoneBlock(x,.28,z,1,.6,.7,PALETTE.stone)}\n  for(let z=9;z>-17;z-=6)for(const x of [-10.4,10.4]){stoneBlock(x,.45,z,1,.9,4,PALETTE.dark);solid(x,.45,z,1,.9,4)}\n  for(let z=-28;z>-82;z-=6)for(const x of [-11,11]){stoneBlock(x,1.2,z,1.4,2.4,5.8,PALETTE.dark);solid(x,1.2,z,1.4,2.4,5.8);stoneBlock(x,2.55,z,1.7,.3,5.9,PALETTE.light)}\n  for(let z=-31;z>-80;z-=12)for(const x of [-8.6,8.6])column(x,z,z<-58?5:3.7);\n  arch(0,-27,13,4.5);arch(0,-57.5,6,5.5);arch(0,-82,13,6);arch(21,16,8,4);\n  // Stepped skyline, reliefs and small shrines.\n  for(let s=0;s<5;s++)stoneBlock(0,1+s*1.3,-86-s*.9,29-s*3,1.3,6+s*.4,s%2?PALETTE.dark:PALETTE.stone);\n  for(let i=-3;i<=3;i++){stoneBlock(i*3.5,3,-83.7,2.3,2.9,.25,PALETTE.light);stamp(geo.rock,toon(PALETTE.gold),i*3.5,3.1,-83.4,.65,.85,.1,0,Math.PI/4)}\n  for(let z=-76;z<18;z+=6)for(const x of [15.5,26.5]){stoneBlock(x,.65,z,1,1.3,5.8,PALETTE.dark);solid(x,.65,z,1,1.3,5.8);if(z%12===-4)column(x,z,3.2)}\n  for(let z=-80;z<18;z+=14){brazier(25.4,z);stamp(geo.cone,toon(PALETTE.gold),16.8,.12,z+3,.35,.05,.6,0,Math.PI)}\n  for(let i=0;i<45;i++){const side=i%2?1:-1,x=side*(13+artRand()*16),z=18-artRand()*108;if(x>14&&x<28&&z>-81&&z<26)continue;palm(x,z,.7+artRand()*.65);for(let k=0;k<2;k++)fern(x+(artRand()-.5)*5,z+(artRand()-.5)*4,.7+artRand());}\n  for(let i=0;i<65;i++){const side=i%2?1:-1,z=12-artRand()*90;fern(side*(8.7+artRand()*2),z,.6+artRand()*.7)}\n  for(let i=0;i<30;i++){const x=-9+artRand()*18,z=10-artRand()*90;if(Math.abs(x)<4||z<-70||Math.abs(z+20)<6)continue;stamp(geo.rock,toon(i%2?PALETTE.dark:PALETTE.moss),x,.15,z,.2+artRand()*.5,.3+artRand()*.4,.4,0,artRand()*4)}\n  // Camp at the start, including a route map and a very optimistic exit sign.\n  stamp(geo.cone,toon(0xd7bd80),-6,1.3,9,2.4,2.7,2.1,0,Math.PI/4);stoneBlock(-6,.05,8,3,.1,2,0x3d5446);for(let x of [-7.5,-6,-4.5]){stoneBlock(x,.35,10.4,.9,.7,.8,0x74563a)}\n  const sign=makeLabel('QUINN & CO.  ·  BASE CAMP',6.2,'#e9d3a0',31);sign.position.set(-5,2.8,10);decorRoot.add(sign);\n  const anchor=new THREE.Group();anchor.position.set(0,6.5,-20.5);mesh(geo.torus,toon(PALETTE.gold),anchor,0,0,0,.8,.8,.8,true);mesh(geo.cylinder,toon(PALETTE.edge),anchor,0,1.8,0,.12,2.8,.12);decorRoot.add(anchor);worldObjects.anchor=anchor;\n  const marker=makeLabel('WHIP ANCHOR',3.6,'#ffd080',43);marker.position.set(0,8,-20.5);decorRoot.add(marker);\n  // Light puzzle. Cardinal routes are legible both from beams and the expedition journal.\n  const mirrorData=[[-6,-36,0,1,'I'],[6,-36,2,0,'II'],[6,-49,1,3,'III']];\n  mirrorData.forEach(([x,z,rotation,correct,label],id)=>{const base=new THREE.Group();base.position.set(x,0,z);decorRoot.add(base);box(base,toon(PALETTE.dark),0,.3,0,1.65,.6,1.65,true);mesh(geo.cylinder,toon(PALETTE.stone),base,0,.9,0,.48,1,.48,true);const rotor=new THREE.Group();rotor.position.y=1.8;base.add(rotor);mesh(geo.torus,toon(PALETTE.gold),rotor,0,0,0,.66,.66,.66,true);const mirror=mesh(geo.cylinder,toon(0x9ed9ca,{emissive:0x1d4b48,emissiveIntensity:.4}),rotor,0,0,0,.53,.08,.53);mirror.rotation.x=Math.PI/2;const arrow=mesh(geo.cone,toon(PALETTE.gold),rotor,0,.02,-.92,.18,.5,.18);arrow.rotation.x=-Math.PI/2;const text=makeLabel(label,1.3);text.position.set(0,.7,.88);base.add(text);solid(x,.75,z,1.5,1.5,1.5);worldObjects.mirrors.push({id,x,z,rotation,correct,rotor,base,powered:false})});\n  const sun=new THREE.Group();sun.position.set(-6,1.8,-28.8);mesh(geo.torus,toon(PALETTE.gold),sun,0,0,0,.9,.9,.9);for(let i=0;i<8;i++){const a=i/8*TAU;mesh(geo.cone,toon(PALETTE.gold),sun,Math.sin(a)*1.2,Math.cos(a)*1.2,0,.12,.4,.12).rotation.z=-a}decorRoot.add(sun);\n  const plaque=makeLabel('FOLLOW THE SUN  ·  I → II → III → VAULT',12,'#f0d49a',29);plaque.position.set(0,4.8,-28);decorRoot.add(plaque);\n  // The sealed vault door moves on a native animation track.\n  const door=new THREE.Group();door.name='vaultDoor';door.position.set(0,0,-57.5);box(door,toon(PALETTE.dark),0,2,0,5.8,4.5,.8,true);for(let i=-1;i<=1;i++){box(door,toon(PALETTE.gold),i*1.8,2,-.43,.14,3.3,.07);mesh(geo.rock,toon(PALETTE.light),door,i*1.8,2,.45,.32,.65,.12)}decorRoot.add(door);const ds=solid(0,2,-57.5,5.8,4.5,.8);const dm=new THREE.AnimationMixer(door);const dc=new THREE.AnimationClip('open',2.1,[new THREE.NumberKeyframeTrack('.position[y]',[0,2.1],[0,5.5])]);worldObjects.door={mesh:door,body:ds.body,collider:ds.collider,mixer:dm,action:dm.clipAction(dc)};\n  for(const x of [-8,-4,4,8])brazier(x,-54);for(const x of [-9,9])for(const z of [-64,-77])brazier(x,z);\n  const pedestal=new THREE.Group();pedestal.position.set(0,0,-77);decorRoot.add(pedestal);box(pedestal,toon(PALETTE.dark),0,.25,0,3,.5,3,true);box(pedestal,toon(PALETTE.light),0,.9,0,2,1,2,true);box(pedestal,toon(PALETTE.gold),0,1.46,0,2.3,.12,2.3,true);worldObjects.goose=makeGoose(pedestal,.85);worldObjects.goose.position.y=1.55;\n  const gooseSign=makeLabel('THE GOLDEN GOOSE',5.5,'#ffe0a0',43);gooseSign.position.set(0,4,-80);decorRoot.add(gooseSign);\n  const side=new THREE.Group();side.position.set(11.2,0,-74.8);box(side,toon(PALETTE.dark),0,1.7,0,.7,3.4,5,true);box(side,toon(PALETTE.gold),-.4,1.7,0,.05,2.2,.25);decorRoot.add(side);const sb=solid(11.2,1.7,-74.8,.7,3.4,5);worldObjects.sideDoor={mesh:side,body:sb.body,collider:sb.collider};\n  const escapeSign=makeLabel('RIVER EXIT  →',4.3,'#f0d89f',42);escapeSign.position.set(5.5,3.1,-76);decorRoot.add(escapeSign);\n  for(const [x,z,kind,id] of [[-7,-10,'treasure',0],[-7,-48,'treasure',1],[7,-79,'treasure',2],[6,-28,'health',3],[-7,-63,'health',4],[23,-31,'health',5],[4,0,'ammo',6],[-4,-52,'ammo',7],[24,-65,'ammo',8],[7,-66,'ammo',9]])worldObjects.pickups.push(makePickup(kind,x,z,id));\n  for(const [kind,x,z] of [['snake',-4,-3],['snake',4,-9],['snake',-4,-28],['hunter',3,-31],['hunter',-5,-44],['hunter',4,-63],['hunter',-6,-70],['boss',0,-69]])worldObjects.enemies.push(createEnemy(kind,x,z,worldObjects.enemies.length));\n  const trapData=[[-6,'dart','main'],[-31,'dart','main'],[-51,'spike','main'],[-64,'dart','escape'],[-55,'spike','escape'],[-25,'dart','escape'],[-4,'spike','escape']];\n  trapData.forEach(([z,kind,zone],id)=>{const cx=zone==='main'?0:21,w=zone==='main'?17:8,group=new THREE.Group();group.position.set(cx,0,z);decorRoot.add(group);box(group,toon(0x655c45),0,.025,0,w,.05,1.8);for(let x=-w/2+.4;x<w/2;x+=.7){if(kind==='spike')mesh(geo.cone,toon(0x8f9784),group,x,-.3,0,.14,.8,.14);else{box(group,toon(0xd19a55),x,.065,-.55,.36,.05,.08);box(group,toon(0xd19a55),x,.065,.55,.36,.05,.08)}}const warning=box(group,new THREE.MeshBasicMaterial({color:0xf38d4e,transparent:true,opacity:0}),0,.09,0,w,.02,1.7);worldObjects.traps.push({id,z,kind,zone,mesh:group,warning,clock:id*.73,active:false,fired:false});if(kind==='dart'){for(const side of [-1,1]){stoneBlock(cx+side*(w/2+.3),1,z,.6,2.1,2.2,PALETTE.dark);for(let k=0;k<3;k++)stamp(geo.cylinder,toon(0x2f423b),cx+side*(w/2+.65),.7+k*.35,z,.13,.1,.13,0,0,Math.PI/2)}}});\n  for(const z of [-39,-17,6]){const x=21+(z===-17?1.8:-1.6);const body=physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,.55,z).setLinearDamping(1));physics.createCollider(RAPIER.ColliderDesc.cuboid(.7,.55,.65).setMass(5),body);const obj=box(decorRoot,toon(0x9c7751),x,.55,z,1.4,1.1,1.3,true);worldObjects.rubble.push({body,mesh:obj})}\n  const boulderMesh=mesh(geo.rock,toon(0x8c8d72),actorsRoot,21,2.7,-82,2.6,2.6,2.6,true);boulderMesh.visible=false;const bb=physics.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(21,2.6,-82));const bc=physics.createCollider(RAPIER.ColliderDesc.ball(2.6).setFriction(1),bb);bc.setEnabled(false);worldObjects.boulder={mesh:boulderMesh,body:bb,collider:bc,z:-82,active:false};\n  // A waiting launch, the unmistakable destination of the escape.\n  const boat=new THREE.Group();boat.position.set(21,-.1,28);decorRoot.add(boat);box(boat,toon(0x624e38),0,.2,0,3.8,.7,6,true);box(boat,toon(0xddd0a2),0,.8,-1,3.4,.7,2.2,true);box(boat,toon(0x3b6965),0,1.1,-1,2.8,.3,1.8);mesh(geo.cone,toon(0x624e38),boat,0,.2,3.2,2,2.4,2,true).rotation.x=Math.PI/2;const escapeFlag=makeLabel('HOME. MORE OR LESS.',6.5,'#ffe1a0',37);escapeFlag.position.set(21,4,23);decorRoot.add(escapeFlag);\n  finishStatic();updateMirrors(true);\n}\nfunction updateMirrors(instant=false){if(\"'!worldObjects)return;for(const beam of worldObjects.beams){decorRoot.remove(beam);beam.geometry.dispose();beam.material.dispose()}worldObjects.beams=[];const mirrors=worldObjects.mirrors;let powered=true;const add=(a,b,hot)=>{const line=lineBetween(new THREE.Vector3(a.x,1.82,a.z),new THREE.Vector3(b.x,1.82,b.z),hot?0xffdf85:0x56817a,hot?.98:.3);decorRoot.add(line);worldObjects.beams.push(line);if(hot){const glow=new THREE.Mesh(new THREE.CylinderGeometry(.045,.045,dist(a,b),6),new THREE.MeshBasicMaterial({color:0xffd071,transparent:true,opacity:.7}));glow.position.set((a.x+b.x)/2,1.82,(a.z+b.z)/2);glow.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),new THREE.Vector3(b.x-a.x,0,b.z-a.z).normalize());decorRoot.add(glow);worldObjects.beams.push(glow)}};\n  add({x:-6,z:-28.8},mirrors[0],true);\n  mirrors.forEach((m,i)=>{m.powered=powered;if(instant)m.rotor.rotation.y=-m.rotation*Math.PI/2;const directions=[[0,-1],[1,0],[0,1],[-1,0]],v=directions[m.rotation];const correct=m.rotation===m.correct;const next=correct?(i<2?mirrors[i+1]:{x:0,z:-49}):{x:m.x+v[0]*4,z:m.z+v[1]*4};add(m,next,powered);powered=powered&&correct});\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat > src/world.js <<'EOF'\nconst PALETTE={stone:0xc5a371,light:0xe1c18b,dark:0x987b54,edge:0x655b44,sand:0xc8b77d,moss:0x547b55,leaf:0x377465,lightleaf:0x619277,trunk:0x66553b,gold:0xf4ba46,water:0x285e61,red:0x9f483b,teal:0x388c89};\nfunction stoneBlock(x,y,z,w,h,d,c=PALETTE.stone,edges=true){stamp(geo.box,toon(c),x,y,z,w,h,d,0,0,0,edges)}\nfunction ground(x1,x2,z1,z2,kind='stone'){\n  const lo=Math.min(z1,z2),hi=Math.max(z1,z2);solid((x1+x2)/2,-.55,(lo+hi)/2,x2-x1,1.1,hi-lo);\n  stamp(geo.box,toon(0x4a5545),(x1+x2)/2,-.43,(lo+hi)/2,x2-x1,.6,hi-lo);\n  for(let x=x1+.98;x<x2;x+=2)for(let z=lo+.98;z<hi;z+=2){const c=kind==='sand'?[0xb5a272,0xc6b481,0xb9ab7c][Math.floor(artRand()*3)]:[0xc6ab7b,0xb59b70,0xd1b584,0xbca174][Math.floor(artRand()*4)];stamp(geo.box,toon(c),x,-.14,z,1.93,.28,1.93,0,0,0,false);if(artRand()<.13)stamp(geo.box,toon(PALETTE.moss),x+(artRand()-.5),.015,z+(artRand()-.5),.35+artRand()*.8,.025,.2+artRand()*.8,0,artRand()*3,0)}\n}\nfunction column(x,z,h=4.5){stoneBlock(x,.25,z,1.5,.5,1.5,PALETTE.dark);stoneBlock(x,.65,z,1.2,.3,1.2,PALETTE.light);stamp(geo.cylinder,toon(PALETTE.stone),x,h/2+.6,z,.47,h,.47,0,0,0,true);for(let k=1;k<4;k++)stamp(geo.torus,toon(PALETTE.dark),x,.75+k*h/4,z,.49,.49,.49,Math.PI/2);stoneBlock(x,h+.7,z,1.4,.45,1.4,PALETTE.light);solid(x,h/2,z,1.2,h,1.2)}\nfunction arch(x,z,w=7,h=5){column(x-w/2,z,h);column(x+w/2,z,h);stoneBlock(x,h+1,z,w+2,1.1,1.7,PALETTE.dark);stoneBlock(x,h+1.65,z,w+2.5,.3,2,PALETTE.light);for(let i=-2;i<=2;i++)stoneBlock(x+i*1.05,h+1.05,z+.88,.7,.55,.08,i===0?PALETTE.gold:PALETTE.light);for(let side of [-1,1]){stamp(geo.cone,toon(PALETTE.gold),x+side*(w/2),h+2,z,.5,.8,.5);}}\nfunction palm(x,z,s=1){const lean=(artRand()-.5)*.25;stamp(geo.cylinder,toon(PALETTE.trunk),x,3.8*s,z,.3*s,7.6*s,.3*s,0,0,lean);for(let k=0;k<7;k++){const a=k/7*TAU+artRand()*.2;stamp(geo.leaf,toon(k%2?PALETTE.leaf:PALETTE.lightleaf),x+Math.sin(a)*1.5*s,7.7*s,z+Math.cos(a)*1.5*s,.65*s,.18*s,2.8*s,.18,a,.08)}for(let k=0;k<3;k++)stamp(geo.sphere,toon(PALETTE.trunk),x+(artRand()-.5)*.6*s,7*s,z+(artRand()-.5)*.6*s,.23*s)}\nfunction fern(x,z,s=1){for(let k=0;k<5;k++){const a=k/5*TAU;stamp(geo.leaf,toon(k%2?PALETTE.moss:PALETTE.leaf),x+Math.sin(a)*.45*s,.35*s,z+Math.cos(a)*.45*s,.22*s,.12*s,1.1*s,-.4,a,0)}}\nfunction brazier(x,z){stoneBlock(x,.4,z,.7,.8,.7,PALETTE.edge);stamp(geo.cylinder,toon(PALETTE.gold),x,.95,z,.44,.3,.44);const flame=new THREE.Group();flame.position.set(x,1.3,z);mesh(geo.cone,new THREE.MeshBasicMaterial({color:0xffa23c}),flame,0,0,0,.22,.8,.22);mesh(geo.cone,new THREE.MeshBasicMaterial({color:0xffe8a0}),flame,0,-.1,.05,.12,.5,.12);decorRoot.add(flame);worldObjects.flames.push(flame)}\nfunction makeGoose(parent,scale=1){const goose=new THREE.Group();parent.add(goose);goose.scale.setScalar(scale);const gold=toon(PALETTE.gold),shade=toon(0xc4882d);mesh(geo.sphere,gold,goose,0,.45,0,.56,.43,.8,true);mesh(geo.sphere,shade,goose,.48,.51,-.05,.12,.28,.48,true);mesh(geo.sphere,shade,goose,-.48,.51,-.05,.12,.28,.48,true);mesh(geo.cylinder,gold,goose,0,.98,-.4,.16,.78,.16,true);mesh(geo.sphere,gold,goose,0,1.4,-.47,.29,.26,.32,true);mesh(geo.cone,toon(0xee8c32),goose,0,1.36,-.86,.15,.4,.15,true).rotation.x=-Math.PI/2;for(let s of [-1,1]){mesh(geo.sphere,inkMat,goose,s*.235,1.46,-.61,.055);box(goose,shade,s*.23,.07,.06,.26,.07,.45)}return goose}\nfunction makeExplorer(colorIndex=0,enemy=false,boss=false){\n  const root=new THREE.Group();const rig=new THREE.Group();rig.name='rig';root.add(rig);\n  const jacket=toon(enemy?(boss?0x754b3e:0x756b4a):[0x966241,0x398985,0xb37046,0x71855a][colorIndex%4]);\n  const shirt=toon(enemy?0xbeb485:0xead3a4),skin=toon([0xd59b68,0xb87b55,0xdfb37a,0x9a674e][colorIndex%4]),pants=toon(enemy?0x434c45:0x5b6256),boot=toon(0x383d35),band=toon(enemy?0x6a312a:[0xd7a445,0xe3b871,0x5aada6,0xc37b5d][colorIndex%4]);\n  const body=new THREE.Group();body.name='torso';body.position.y=1.03;rig.add(body);box(body,jacket,0,.09,0,.68,.69,.36,true);box(body,shirt,0,.13,-.193,.27,.56,.045);box(body,boot,0,-.16,-.01,.72,.1,.4);\n  const head=new THREE.Group();head.name='head';head.position.set(0,1.67,0);rig.add(head);mesh(geo.sphere,skin,head,0,0,0,.27,.31,.25,true);box(head,toon(0x4b3e31),0,.11,.07,.49,.2,.33);for(let s of [-1,1])box(head,toon(0x16272b),s*.1,.02,-.24,.04,.055,.02);box(head,skin,0,-.02,-.29,.08,.09,.12);\n  if(\"'!enemy||boss){mesh(geo.cylinder,toon(enemy?0x594a3a:0x9c7443),head,0,.27,0,.46,.075,.4,true);mesh(geo.cylinder,toon(enemy?0x594a3a:0x9c7443),head,0,.4,0,.29,.25,.27,true);mesh(geo.cylinder,band,head,0,.3,0,.295,.055,.275)}else{mesh(geo.cylinder,toon(0x665d45),head,0,.27,0,.31,.16,.3,true);box(head,boot,0,.23,-.3,.5,.05,.24)}\n  for(const s of [-1,1]){const leg=new THREE.Group();leg.name=s<0?'\"'legL':'legR';leg.position.set(s*.2,.77,0);rig.add(leg);box(leg,pants,0,-.24,0,.25,.53,.29,true);box(leg,boot,0,-.57,-.06,.29,.17,.43,true);const arm=new THREE.Group();arm.name=s<0?'armL':'armR';arm.position.set(s*.46,1.32,0);rig.add(arm);box(arm,jacket,0,-.22,0,.24,.43,.27,true);mesh(geo.sphere,skin,arm,0,-.49,-.015,.135,.16,.13,true)}\n  const satchel=box(rig,toon(0x6b4d32),.38,.84,.2,.29,.4,.22,true);satchel.rotation.z=-.15;box(rig,band,-.1,1.08,-.21,.075,.8,.04).rotation.z=-.55;\n  const gun=new THREE.Group();gun.name='gun';rig.getObjectByName('armL').add(gun);box(gun,boot,0,-.5,-.18,.12,.13,.48,true);box(gun,toon(0x7d6749),0,-.61,-.06,.12,.21,.13);gun.visible=enemy;\n  const loop=mesh(geo.torus,toon(0x61452e),rig,.48,.7,-.1,.2,.3,.2);loop.rotation.y=.2;\n  const mixer=new THREE.AnimationMixer(rig),clips={};\n  function clip(name,duration,tracks){const c=new THREE.AnimationClip(name,duration,tracks);clips[name]=mixer.clipAction(c);return clips[name]}\n  const track=(path,ts,vs)=>new THREE.NumberKeyframeTrack(path,ts,vs);\n  clip('idle',2,[track('torso.position[y]',[0,1,2],[1.03,1.065,1.03]),track('head.rotation[z]',[0,1,2],[.025,-.025,.025])]);\n  const ts=[0,.15,.3,.45,.6];\n  clip('run',.6,[track('legL.rotation[x]',ts,[-.65,0,.65,0,-.65]),track('legR.rotation[x]',ts,[.65,0,-.65,0,.65]),track('armL.rotation[x]',ts,[.6,0,-.6,0,.6]),track('armR.rotation[x]',ts,[-.6,0,.6,0,-.6]),track('torso.position[y]',ts,[1.02,1.09,1.02,1.09,1.02])]);\n  clip('whip',.43,[track('armR.rotation[x]',[0,.12,.21,.43],[-.1,-2.9,-1.3,0]),track('armR.rotation[z]',[0,.12,.21,.43],[0,-.4,.55,0]),track('torso.rotation[y]',[0,.12,.23,.43],[0,-.4,.5,0])]);\n  clip('shoot',.25,[track('armL.rotation[x]',[0,.06,.13,.25],[-1.5,-1.8,-1.55,0])]);\n  clip('jump',.7,[track('legL.rotation[x]',[0,.2,.5,.7],[0,-.65,-.4,0]),track('legR.rotation[x]',[0,.2,.5,.7],[0,.35,.6,0]),track('armR.rotation[x]',[0,.2,.5,.7],[0,-2.2,-1.5,0]),track('armL.rotation[x]',[0,.2,.5,.7],[0,-1.9,-1.1,0])]);\n  clip('roll',.5,[track('rig.rotation[x]',[0,.125,.25,.375,.5],[0,-Math.PI/2,-Math.PI,-Math.PI*1.5,-TAU]),track('rig.position[y]',[0,.2,.35,.5],[0,.5,.4,0])]);\n  clip('grapple',1.15,[track('armR.rotation[x]',[0,.2,.85,1.15],[-1,-3,-2.9,0]),track('legL.rotation[x]',[0,.4,.85,1.15],[0,-.8,.3,0]),track('legR.rotation[x]',[0,.4,.85,1.15],[0,-.6,.6,0])]);\n  clip('down',.7,[track('rig.rotation[z]',[0,.3,.7],[0,1.2,Math.PI/2]),track('rig.position[y]',[0,.4,.7],[0,-.2,-.2])]);\n  clips.idle.play();let base='idle',oneShot='';\n  return{root,rig,mixer,clips,gun,animate(name,move=0,dt=1/60){const target=move>.2?'run':'idle';if(target\"'!==base){clips[base].fadeOut(.15);clips[target].reset().fadeIn(.15).play();base=target}clips.run.timeScale=Math.max(.65,move/5);if(name&&name!==oneShot&&clips[name]){if(oneShot&&clips[oneShot])clips[oneShot].fadeOut(.08);const a=clips[name];a.reset().setLoop(THREE.LoopOnce,1);a.clampWhenFinished=false;a.fadeIn(.04).play();oneShot=name}if(!name)oneShot='\"'';mixer.update(dt)}}\n}\nfunction makeSnake(){const root=new THREE.Group(),body=new THREE.Group();root.add(body);for(let i=0;i<7;i++){const part=mesh(geo.sphere,toon(i%2?0x6e8050:0x9a9a57),body,Math.sin(i*.9)*.13,.14,-i*.16,.18-i*.013,.15,.23,true);part.name='coil'+i}const head=mesh(geo.sphere,toon(0x9da468),body,0,.22,.2,.23,.2,.3,true);for(let s of [-1,1])mesh(geo.sphere,toon(0xf3bf57),head,s*.7,.25,.55,.1);const mixer=new THREE.AnimationMixer(body),tracks=[];for(let i=0;i<7;i++)tracks.push(new THREE.NumberKeyframeTrack('coil'+i+'.position[x]',[0,.3,.6,.9,1.2],[Math.sin(i)*.15,Math.sin(i+1.5)*.15,Math.sin(i+3)*.15,Math.sin(i+4.5)*.15,Math.sin(i)*.15]));mixer.clipAction(new THREE.AnimationClip('slither',1.2,tracks)).play();return{root,mixer,animate(name,move,dt){mixer.update(dt)}}}\nfunction makePickup(kind,x,z,id){const group=new THREE.Group();group.position.set(x,.55,z);decorRoot.add(group);if(kind==='treasure'){mesh(geo.rock,toon(PALETTE.gold),group,0,.12,0,.3,.42,.3,true);mesh(geo.torus,toon(PALETTE.gold),group,0,.14,0,.55,.55,.55).rotation.x=Math.PI/2}else{box(group,toon(kind==='health'?0xe2cfa4:0x72573a),0,0,0,.7,.5,.5,true);if(kind==='health'){box(group,toon(0xaf5945),0,.27,0,.12,.02,.38);box(group,toon(0xaf5945),0,.275,0,.4,.02,.12)}else for(let i=0;i<3;i++)mesh(geo.cylinder,toon(0xe5b660),group,(i-1)*.17,.35,0,.05,.22,.05)}const aura=mesh(geo.torus,new THREE.MeshBasicMaterial({color:kind==='treasure'?0xffc654:0xaed7b9,transparent:true,opacity:.5}),group,0,-.47,0,.65,.65,.65);aura.rotation.x=Math.PI/2;return{id,kind,x,z,mesh:group,taken:false}}\nfunction createEnemy(kind,x,z,id){const actor=kind==='snake'?makeSnake():makeExplorer(2,true,kind==='boss');actorsRoot.add(actor.root);actor.root.position.set(x,0,z);const maxHp=kind==='boss'?9:kind==='snake'?2:3;const radius=kind==='snake'?.3:.36,half=kind==='snake'?.12:.46;const body=physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,half+radius+.06,z).lockRotations().setLinearDamping(6).setCcdEnabled(true));const collider=physics.createCollider(RAPIER.ColliderDesc.capsule(half,radius).setMass(2),body);const hpRoot=new THREE.Group();hpRoot.position.y=kind==='snake'?.9:2.25;box(hpRoot,toon(0x253936),0,0,0,1,.085,.07);const bar=box(hpRoot,toon(kind==='boss'?0xf0ab52:0xc67652),0,0,-.02,.95,.06,.08);actor.root.add(hpRoot);hpRoot.visible=false;return{id,kind,x,z,y:0,angle:0,hp:maxHp,maxHp,body,collider,actor,bar,hpRoot,cooldown:1+id*.2,stun:0,telegraph:0,dead:false,spawn:{x,z},height:half+radius+.06}}\nfunction createWorld(){\n  worldObjects={mirrors:[],flames:[],particles:[],projectiles:[],enemies:[],pickups:[],traps:[],rubble:[],beams:[],door:null,sideDoor:null,boulder:null,goose:null};\n  ground(-10,10,14,-17,'sand');ground(-10,10,-24,-58);ground(-12,12,-58,-84);ground(10,26,-70,-80);ground(16,26,-80,-49);ground(16,26,-45,24,'sand');\n  // The river is real negative space in the collision world.\n  stamp(geo.box,toon(0x173d45),0,-4,-20.5,75,1,7);stamp(geo.box,toon(PALETTE.water),0,-3.15,-20.5,75,.08,6.7);\n  for(let k=0;k<32;k++)stamp(geo.box,toon(k%2?0x448a85:0x3a7779),-34+k*2.2,-3.09,-20.5+(artRand()-.5)*4,1.3,.02,.07);\n  for(const z of [-17,-24]){stoneBlock(0,-.25,z,20,.6,.5,PALETTE.dark);for(const x of [-9,-6,6,9])stoneBlock(x,.28,z,1,.6,.7,PALETTE.stone)}\n  for(let z=9;z>-17;z-=6)for(const x of [-10.4,10.4]){stoneBlock(x,.45,z,1,.9,4,PALETTE.dark);solid(x,.45,z,1,.9,4)}\n  for(let z=-28;z>-82;z-=6)for(const x of [-11,11]){stoneBlock(x,1.2,z,1.4,2.4,5.8,PALETTE.dark);solid(x,1.2,z,1.4,2.4,5.8);stoneBlock(x,2.55,z,1.7,.3,5.9,PALETTE.light)}\n  for(let z=-31;z>-80;z-=12)for(const x of [-8.6,8.6])column(x,z,z<-58?5:3.7);\n  arch(0,-27,13,4.5);arch(0,-57.5,6,5.5);arch(0,-82,13,6);arch(21,16,8,4);\n  // Stepped skyline, reliefs and small shrines.\n  for(let s=0;s<5;s++)stoneBlock(0,1+s*1.3,-86-s*.9,29-s*3,1.3,6+s*.4,s%2?PALETTE.dark:PALETTE.stone);\n  for(let i=-3;i<=3;i++){stoneBlock(i*3.5,3,-83.7,2.3,2.9,.25,PALETTE.light);stamp(geo.rock,toon(PALETTE.gold),i*3.5,3.1,-83.4,.65,.85,.1,0,Math.PI/4)}\n  for(let z=-76;z<18;z+=6)for(const x of [15.5,26.5]){stoneBlock(x,.65,z,1,1.3,5.8,PALETTE.dark);solid(x,.65,z,1,1.3,5.8);if(z%12===-4)column(x,z,3.2)}\n  for(let z=-80;z<18;z+=14){brazier(25.4,z);stamp(geo.cone,toon(PALETTE.gold),16.8,.12,z+3,.35,.05,.6,0,Math.PI)}\n  for(let i=0;i<45;i++){const side=i%2?1:-1,x=side*(13+artRand()*16),z=18-artRand()*108;if(x>14&&x<28&&z>-81&&z<26)continue;palm(x,z,.7+artRand()*.65);for(let k=0;k<2;k++)fern(x+(artRand()-.5)*5,z+(artRand()-.5)*4,.7+artRand());}\n  for(let i=0;i<65;i++){const side=i%2?1:-1,z=12-artRand()*90;fern(side*(8.7+artRand()*2),z,.6+artRand()*.7)}\n  for(let i=0;i<30;i++){const x=-9+artRand()*18,z=10-artRand()*90;if(Math.abs(x)<4||z<-70||Math.abs(z+20)<6)continue;stamp(geo.rock,toon(i%2?PALETTE.dark:PALETTE.moss),x,.15,z,.2+artRand()*.5,.3+artRand()*.4,.4,0,artRand()*4)}\n  // Camp at the start, including a route map and a very optimistic exit sign.\n  stamp(geo.cone,toon(0xd7bd80),-6,1.3,9,2.4,2.7,2.1,0,Math.PI/4);stoneBlock(-6,.05,8,3,.1,2,0x3d5446);for(let x of [-7.5,-6,-4.5]){stoneBlock(x,.35,10.4,.9,.7,.8,0x74563a)}\n  const sign=makeLabel('QUINN & CO.  ·  BASE CAMP',6.2,'#e9d3a0',31);sign.position.set(-5,2.8,10);decorRoot.add(sign);\n  const anchor=new THREE.Group();anchor.position.set(0,6.5,-20.5);mesh(geo.torus,toon(PALETTE.gold),anchor,0,0,0,.8,.8,.8,true);mesh(geo.cylinder,toon(PALETTE.edge),anchor,0,1.8,0,.12,2.8,.12);decorRoot.add(anchor);worldObjects.anchor=anchor;\n  const marker=makeLabel('WHIP ANCHOR',3.6,'#ffd080',43);marker.position.set(0,8,-20.5);decorRoot.add(marker);\n  // Light puzzle. Cardinal routes are legible both from beams and the expedition journal.\n  const mirrorData=[[-6,-36,0,1,'I'],[6,-36,2,0,'II'],[6,-49,1,3,'III']];\n  mirrorData.forEach(([x,z,rotation,correct,label],id)=>{const base=new THREE.Group();base.position.set(x,0,z);decorRoot.add(base);box(base,toon(PALETTE.dark),0,.3,0,1.65,.6,1.65,true);mesh(geo.cylinder,toon(PALETTE.stone),base,0,.9,0,.48,1,.48,true);const rotor=new THREE.Group();rotor.position.y=1.8;base.add(rotor);mesh(geo.torus,toon(PALETTE.gold),rotor,0,0,0,.66,.66,.66,true);const mirror=mesh(geo.cylinder,toon(0x9ed9ca,{emissive:0x1d4b48,emissiveIntensity:.4}),rotor,0,0,0,.53,.08,.53);mirror.rotation.x=Math.PI/2;const arrow=mesh(geo.cone,toon(PALETTE.gold),rotor,0,.02,-.92,.18,.5,.18);arrow.rotation.x=-Math.PI/2;const text=makeLabel(label,1.3);text.position.set(0,.7,.88);base.add(text);solid(x,.75,z,1.5,1.5,1.5);worldObjects.mirrors.push({id,x,z,rotation,correct,rotor,base,powered:false})});\n  const sun=new THREE.Group();sun.position.set(-6,1.8,-28.8);mesh(geo.torus,toon(PALETTE.gold),sun,0,0,0,.9,.9,.9);for(let i=0;i<8;i++){const a=i/8*TAU;mesh(geo.cone,toon(PALETTE.gold),sun,Math.sin(a)*1.2,Math.cos(a)*1.2,0,.12,.4,.12).rotation.z=-a}decorRoot.add(sun);\n  const plaque=makeLabel('FOLLOW THE SUN  ·  I → II → III → VAULT',12,'#f0d49a',29);plaque.position.set(0,4.8,-28);decorRoot.add(plaque);\n  // The sealed vault door moves on a native animation track.\n  const door=new THREE.Group();door.name='vaultDoor';door.position.set(0,0,-57.5);box(door,toon(PALETTE.dark),0,2,0,5.8,4.5,.8,true);for(let i=-1;i<=1;i++){box(door,toon(PALETTE.gold),i*1.8,2,-.43,.14,3.3,.07);mesh(geo.rock,toon(PALETTE.light),door,i*1.8,2,.45,.32,.65,.12)}decorRoot.add(door);const ds=solid(0,2,-57.5,5.8,4.5,.8);const dm=new THREE.AnimationMixer(door);const dc=new THREE.AnimationClip('open',2.1,[new THREE.NumberKeyframeTrack('.position[y]',[0,2.1],[0,5.5])]);worldObjects.door={mesh:door,body:ds.body,collider:ds.collider,mixer:dm,action:dm.clipAction(dc)};\n  for(const x of [-8,-4,4,8])brazier(x,-54);for(const x of [-9,9])for(const z of [-64,-77])brazier(x,z);\n  const pedestal=new THREE.Group();pedestal.position.set(0,0,-77);decorRoot.add(pedestal);box(pedestal,toon(PALETTE.dark),0,.25,0,3,.5,3,true);box(pedestal,toon(PALETTE.light),0,.9,0,2,1,2,true);box(pedestal,toon(PALETTE.gold),0,1.46,0,2.3,.12,2.3,true);worldObjects.goose=makeGoose(pedestal,.85);worldObjects.goose.position.y=1.55;\n  const gooseSign=makeLabel('THE GOLDEN GOOSE',5.5,'#ffe0a0',43);gooseSign.position.set(0,4,-80);decorRoot.add(gooseSign);\n  const side=new THREE.Group();side.position.set(11.2,0,-74.8);box(side,toon(PALETTE.dark),0,1.7,0,.7,3.4,5,true);box(side,toon(PALETTE.gold),-.4,1.7,0,.05,2.2,.25);decorRoot.add(side);const sb=solid(11.2,1.7,-74.8,.7,3.4,5);worldObjects.sideDoor={mesh:side,body:sb.body,collider:sb.collider};\n  const escapeSign=makeLabel('RIVER EXIT  →',4.3,'#f0d89f',42);escapeSign.position.set(5.5,3.1,-76);decorRoot.add(escapeSign);\n  for(const [x,z,kind,id] of [[-7,-10,'treasure',0],[-7,-48,'treasure',1],[7,-79,'treasure',2],[6,-28,'health',3],[-7,-63,'health',4],[23,-31,'health',5],[4,0,'ammo',6],[-4,-52,'ammo',7],[24,-65,'ammo',8],[7,-66,'ammo',9]])worldObjects.pickups.push(makePickup(kind,x,z,id));\n  for(const [kind,x,z] of [['snake',-4,-3],['snake',4,-9],['snake',-4,-28],['hunter',3,-31],['hunter',-5,-44],['hunter',4,-63],['hunter',-6,-70],['boss',0,-69]])worldObjects.enemies.push(createEnemy(kind,x,z,worldObjects.enemies.length));\n  const trapData=[[-6,'dart','main'],[-31,'dart','main'],[-51,'spike','main'],[-64,'dart','escape'],[-55,'spike','escape'],[-25,'dart','escape'],[-4,'spike','escape']];\n  trapData.forEach(([z,kind,zone],id)=>{const cx=zone==='main'?0:21,w=zone==='main'?17:8,group=new THREE.Group();group.position.set(cx,0,z);decorRoot.add(group);box(group,toon(0x655c45),0,.025,0,w,.05,1.8);for(let x=-w/2+.4;x<w/2;x+=.7){if(kind==='spike')mesh(geo.cone,toon(0x8f9784),group,x,-.3,0,.14,.8,.14);else{box(group,toon(0xd19a55),x,.065,-.55,.36,.05,.08);box(group,toon(0xd19a55),x,.065,.55,.36,.05,.08)}}const warning=box(group,new THREE.MeshBasicMaterial({color:0xf38d4e,transparent:true,opacity:0}),0,.09,0,w,.02,1.7);worldObjects.traps.push({id,z,kind,zone,mesh:group,warning,clock:id*.73,active:false,fired:false});if(kind==='dart'){for(const side of [-1,1]){stoneBlock(cx+side*(w/2+.3),1,z,.6,2.1,2.2,PALETTE.dark);for(let k=0;k<3;k++)stamp(geo.cylinder,toon(0x2f423b),cx+side*(w/2+.65),.7+k*.35,z,.13,.1,.13,0,0,Math.PI/2)}}});\n  for(const z of [-39,-17,6]){const x=21+(z===-17?1.8:-1.6);const body=physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,.55,z).setLinearDamping(1));physics.createCollider(RAPIER.ColliderDesc.cuboid(.7,.55,.65).setMass(5),body);const obj=box(decorRoot,toon(0x9c7751),x,.55,z,1.4,1.1,1.3,true);worldObjects.rubble.push({body,mesh:obj})}\n  const boulderMesh=mesh(geo.rock,toon(0x8c8d72),actorsRoot,21,2.7,-82,2.6,2.6,2.6,true);boulderMesh.visible=false;const bb=physics.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(21,2.6,-82));const bc=physics.createCollider(RAPIER.ColliderDesc.ball(2.6).setFriction(1),bb);bc.setEnabled(false);worldObjects.boulder={mesh:boulderMesh,body:bb,collider:bc,z:-82,active:false};\n  // A waiting launch, the unmistakable destination of the escape.\n  const boat=new THREE.Group();boat.position.set(21,-.1,28);decorRoot.add(boat);box(boat,toon(0x624e38),0,.2,0,3.8,.7,6,true);box(boat,toon(0xddd0a2),0,.8,-1,3.4,.7,2.2,true);box(boat,toon(0x3b6965),0,1.1,-1,2.8,.3,1.8);mesh(geo.cone,toon(0x624e38),boat,0,.2,3.2,2,2.4,2,true).rotation.x=Math.PI/2;const escapeFlag=makeLabel('HOME. MORE OR LESS.',6.5,'#ffe1a0',37);escapeFlag.position.set(21,4,23);decorRoot.add(escapeFlag);\n  finishStatic();updateMirrors(true);\n}\nfunction updateMirrors(instant=false){if(\"'!worldObjects)return;for(const beam of worldObjects.beams){decorRoot.remove(beam);beam.geometry.dispose();beam.material.dispose()}worldObjects.beams=[];const mirrors=worldObjects.mirrors;let powered=true;const add=(a,b,hot)=>{const line=lineBetween(new THREE.Vector3(a.x,1.82,a.z),new THREE.Vector3(b.x,1.82,b.z),hot?0xffdf85:0x56817a,hot?.98:.3);decorRoot.add(line);worldObjects.beams.push(line);if(hot){const glow=new THREE.Mesh(new THREE.CylinderGeometry(.045,.045,dist(a,b),6),new THREE.MeshBasicMaterial({color:0xffd071,transparent:true,opacity:.7}));glow.position.set((a.x+b.x)/2,1.82,(a.z+b.z)/2);glow.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),new THREE.Vector3(b.x-a.x,0,b.z-a.z).normalize());decorRoot.add(glow);worldObjects.beams.push(glow)}};\n  add({x:-6,z:-28.8},mirrors[0],true);\n  mirrors.forEach((m,i)=>{m.powered=powered;if(instant)m.rotor.rotation.y=-m.rotation*Math.PI/2;const directions=[[0,-1],[1,0],[0,1],[-1,0]],v=directions[m.rotation];const correct=m.rotation===m.correct;const next=correct?(i<2?mirrors[i+1]:{x:0,z:-49}):{x:m.x+v[0]*4,z:m.z+v[1]*4};add(m,next,powered);powered=powered&&correct});\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat > src/input.js <<'EOF'\nfunction keyName(e){const k=(e.key||'').toLowerCase();if(k===' '||e.code==='Space')return'space';return k}\nconst PS={jump:['×','cross'],roll:['○','circle'],whip:['□','square'],interact:['△','triangle'],shoot:['R2',''],sprint:['L2',''],pause:['OPTIONS',''],confirm:['×','cross'],back:['○','circle']};\nconst XB={jump:'A',roll:'B',whip:'X',interact:'Y',shoot:'RT',sprint:'LT',pause:'MENU',confirm:'A',back:'B'};\nconst KB={jump:'SPACE',roll:'CTRL',whip:'LMB',interact:'E',shoot:'RMB',sprint:'SHIFT',pause:'ESC',confirm:'ENTER',back:'ESC'};\nfunction glyph(action){if(controls?.lastDevice==='pad'){if(settings.glyphs==='Xbox')return '<span class=\\\"key\\\">'+XB[action]+'</span>';const a=PS[action];return '<span class=\\\"key '+(a[1]?'ps '+a[1]:'')+'\\\">'+a[0]+'</span>'}if(controls?.lastDevice==='touch')return '<span class=\\\"key\\\">TAP</span>';return '<span class=\\\"key\\\">'+KB[action]+'</span>'}\nclass Controls{\n  constructor(){this.keys=new Set();this.pressed=new Set();this.mouseHeld=new Set();this.mousePressed=new Set();this.mouse={x:innerWidth*.5,y:innerHeight*.5};this.lastDevice='keyboard';this.lastInput=performance.now();this.pads=[];this.prevPads=[];this.menuRepeat=0;this.touchLeft=null;this.touchRight=null;this.touchVector={x:0,z:0};this.padSuppressed=false;this.suppressUntil=0;this.init()}\n  activity(device){this.lastInput=performance.now();if(this.lastDevice\"'!==device){this.lastDevice=device;document.body.classList.toggle('\"'touch',device==='touch');if(typeof refreshPrompts==='function')refreshPrompts()}if(game?.attract){exitAttract();this.keys.clear();this.pressed.clear();this.mouseHeld.clear();this.mousePressed.clear();this.padSuppressed=true;this.suppressUntil=performance.now()+350;return false}return performance.now()>=this.suppressUntil}\n  init(){\n    addEventListener('keydown',e=>{const key=keyName(e);if(['space','arrowup','arrowdown','arrowleft','arrowright','tab'].includes(key))e.preventDefault();if(\"'!this.activity('\"'keyboard'))return;audio.unlock();if(\"'!this.keys.has(key))this.pressed.add(key);this.keys.add(key);if(ui.screen){if(!e.repeat)menuKey(key);return}if(key==='\"'escape'){e.preventDefault();togglePause()}else if(key==='j'&&\"'!AIHub.active)openMenu('\"'journal','pause')});\n    addEventListener('keyup',e=>this.keys.delete(keyName(e)));\n    addEventListener('blur',()=>{this.clear();if(game?.status==='playing'&&\"'!game.attract&&!AIHub.active)openMenu('\"'pause')});\n    document.addEventListener('pointermove',e=>{if(e.pointerType==='touch'){this.moveTouch(e);return}if(Math.abs(e.clientX-this.mouse.x)+Math.abs(e.clientY-this.mouse.y)>2)this.activity('keyboard');this.mouse.x=e.clientX;this.mouse.y=e.clientY;});\n    document.addEventListener('pointerdown',e=>{if(\"'!this.activity(e.pointerType==='\"'touch'?'touch':'keyboard')){e.preventDefault();e.stopPropagation();return}audio.unlock();if(ui.screen||e.target.closest('button,input,select'))return;if(e.pointerType==='touch'){this.startTouch(e);return}this.mouseHeld.add(e.button);this.mousePressed.add(e.button);if(e.button===0&&game?.status==='playing'){const target=contextFor(getLocalPlayer());const point=screenToWorld(e.clientX,e.clientY);if(target&&point&&Math.hypot(point.x-target.x,point.z-target.z)<2){this.pressed.add('e');this.mousePressed.delete(0);this.mouseHeld.delete(0)}}},true);\n    addEventListener('pointerup',e=>{this.mouseHeld.delete(e.button);if(this.touchLeft?.id===e.pointerId){this.touchLeft=null;this.touchVector={x:0,z:0}}if(this.touchRight?.id===e.pointerId){this.touchRight=null}});\n    addEventListener('pointercancel',e=>{if(this.touchLeft?.id===e.pointerId){this.touchLeft=null;this.touchVector={x:0,z:0}}if(this.touchRight?.id===e.pointerId)this.touchRight=null});\n    addEventListener('contextmenu',e=>e.preventDefault());\n    \"'$('\"'pause-button').addEventListener('click',()=>togglePause());\"'$('\"'context-button').addEventListener('click',()=>{if(this.lastDevice==='touch'&&game?.phase==='balance'){this.pressed.add('e')}else this.pressed.add('e')});\n    \"'$('\"'balance').addEventListener('pointerdown',e=>{if(e.pointerType==='touch')this.pressed.add('e')});\n    addEventListener('gamepadconnected',()=>{toast('Controller ready · '+settings.glyphs+' prompts');this.lastDevice='pad';refreshPrompts()});\n  }\n  startTouch(e){if(e.clientX<innerWidth*.52&&\"'!this.touchLeft){this.touchLeft={id:e.pointerId,x:e.clientX,y:e.clientY};this.touchVector={x:0,z:0}}else{this.touchRight={id:e.pointerId,x:e.clientX,y:e.clientY,time:performance.now()};this.pressed.add('\"'q');this.mouse.x=e.clientX;this.mouse.y=e.clientY}}\n  moveTouch(e){if(this.touchLeft?.id===e.pointerId){this.touchVector={x:clamp((e.clientX-this.touchLeft.x)/52,-1,1),z:clamp((e.clientY-this.touchLeft.y)/52,-1,1)}}else if(this.touchRight?.id===e.pointerId){this.mouse.x=e.clientX;this.mouse.y=e.clientY}}\n  clear(){this.keys.clear();this.pressed.clear();this.mouseHeld.clear();this.mousePressed.clear();this.touchLeft=null;this.touchRight=null;this.touchVector={x:0,z:0}}\n  poll(dt){this.menuRepeat-=dt;let pads=[];try{pads=Array.from(navigator.getGamepads?.()||[]).filter(Boolean)}catch{}this.pads=[];let any=false;\n    pads.forEach((pad,index)=>{const prev=this.prevPads[pad.index]||[];const held=pad.buttons.map(b=>b.pressed||b.value>.5),pressed=held.map((v,i)=>v&&\"'!prev[i]);const axis=v=>Math.abs(v||0)<.18?0:Math.sign(v)*(Math.abs(v)-.18)/.82;const mx=axis(pad.axes[0]),mz=axis(pad.axes[1]),ax=axis(pad.axes[2]),az=axis(pad.axes[3]);const active=held.some(Boolean)||Math.abs(mx)+Math.abs(mz)+Math.abs(ax)+Math.abs(az)>.1;any=any||active;if(active&&!this.padSuppressed)this.activity('\"'pad');this.pads[index]={mx,mz,ax,az,jump:pressed[0],roll:pressed[1],whip:held[2],interact:pressed[3],shoot:held[7],sprint:held[6],held,pressed};this.prevPads[pad.index]=held;if(\"'!this.padSuppressed&&active){audio.unlock();if(ui.screen){if(this.menuRepeat<=0){if(held[12]||mz<-.5){menuNavigate(-1);this.menuRepeat=.2}else if(held[13]||mz>.5){menuNavigate(1);this.menuRepeat=.2}if(held[14]||mx<-.5){menuAdjust(-1);this.menuRepeat=.16}else if(held[15]||mx>.5){menuAdjust(1);this.menuRepeat=.16}}if(pressed[0])menuActivate();if(pressed[1]||pressed[9]&&!held[8])menuBack();if(Math.abs(az)>.2)$('\"'menu').querySelector('.credits-scroll,.sheet')?.scrollBy(0,az*dt*550)}else{if(pressed[9]&&\"'!(AIHub.active&&held[8]))togglePause();if(!AIHub.active&&game?.localCoop&&index>=game.players.length&&pressed[0])joinLocalPlayer()}}});\n    if(!any)this.padSuppressed=false;\n  }\n  frame(slot=0){const hub=AIHub.active;const pad=this.pads[hub?0:slot];let mx=0,mz=0;const primary=slot===0||hub;\n    if(primary){mx=(this.keys.has('\"'d')?1:0)-(this.keys.has('a')?1:0);mz=(this.keys.has('s')?1:0)-(this.keys.has('w')?1:0);if((game?.players.length||0)<2){mx+=(this.keys.has('arrowright')?1:0)-(this.keys.has('arrowleft')?1:0);mz+=(this.keys.has('arrowdown')?1:0)-(this.keys.has('arrowup')?1:0)}}else if(slot===1){mx=(this.keys.has('arrowright')?1:0)-(this.keys.has('arrowleft')?1:0);mz=(this.keys.has('arrowdown')?1:0)-(this.keys.has('arrowup')?1:0)}\n    const touch=primary&&this.lastDevice==='touch';if(touch){mx=this.touchVector.x;mz=this.touchVector.z}\n    const len=Math.hypot(mx,mz);if(len>1){mx/=len;mz/=len}if(pad&&\"'!this.padSuppressed&&Math.abs(pad.mx)+Math.abs(pad.mz)>.08){mx=pad.mx;mz=pad.mz}\n    let ax=pad?.ax||0,az=pad?.az||0,mouseAim=false;if(primary&&this.lastDevice==='\"'keyboard'&&camera){const p=getLocalPlayer(),world=screenToWorld(this.mouse.x,this.mouse.y);if(p&&world){ax=world.x-p.x;az=world.z-p.z;mouseAim=Math.hypot(ax,az)>.4;const l=Math.hypot(ax,az);if(l>0){ax/=l;az/=l}}}\n    const pk=k=>this.pressed.has(k),hk=k=>this.keys.has(k),secondary=slot===1&&\"'!hub;\n    return{mx,mz,ax,az,mouseAim,whip:!!(pad?.whip||primary&&(this.mouseHeld.has(0)||hk('\"'q'))||secondary&&hk('/')),shoot:\"'!!(pad?.shoot||primary&&(this.mouseHeld.has(2)||hk('\"'f'))||secondary&&hk('.')),jump:\"'!!(pad?.jump||primary&&pk('\"'space')||secondary&&pk('enter')),roll:\"'!!(pad?.roll||primary&&(pk('\"'control')||pk('c'))||secondary&&pk('shift')),interact:\"'!!(pad?.interact||primary&&pk('\"'e')||secondary&&pk('\\\\'')),sprint:\"'!!(pad?.sprint||primary&&hk('\"'shift')||secondary&&hk('0')||touch&&game?.phase==='escape'),touch};\n  }\n  consume(){this.pressed.clear();this.mousePressed.clear();for(const p of this.pads){p.jump=false;p.roll=false;p.interact=false}}\n}\nlet controls;\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat > src/input.js <<'EOF'\nfunction keyName(e){const k=(e.key||'').toLowerCase();if(k===' '||e.code==='Space')return'space';return k}\nconst PS={jump:['×','cross'],roll:['○','circle'],whip:['□','square'],interact:['△','triangle'],shoot:['R2',''],sprint:['L2',''],pause:['OPTIONS',''],confirm:['×','cross'],back:['○','circle']};\nconst XB={jump:'A',roll:'B',whip:'X',interact:'Y',shoot:'RT',sprint:'LT',pause:'MENU',confirm:'A',back:'B'};\nconst KB={jump:'SPACE',roll:'CTRL',whip:'LMB',interact:'E',shoot:'RMB',sprint:'SHIFT',pause:'ESC',confirm:'ENTER',back:'ESC'};\nfunction glyph(action){if(controls?.lastDevice==='pad'){if(settings.glyphs==='Xbox')return '<span class=\\\"key\\\">'+XB[action]+'</span>';const a=PS[action];return '<span class=\\\"key '+(a[1]?'ps '+a[1]:'')+'\\\">'+a[0]+'</span>'}if(controls?.lastDevice==='touch')return '<span class=\\\"key\\\">TAP</span>';return '<span class=\\\"key\\\">'+KB[action]+'</span>'}\nclass Controls{\n  constructor(){this.keys=new Set();this.pressed=new Set();this.mouseHeld=new Set();this.mousePressed=new Set();this.mouse={x:innerWidth*.5,y:innerHeight*.5};this.lastDevice='keyboard';this.lastInput=performance.now();this.pads=[];this.prevPads=[];this.menuRepeat=0;this.touchLeft=null;this.touchRight=null;this.touchVector={x:0,z:0};this.padSuppressed=false;this.suppressUntil=0;this.init()}\n  activity(device){this.lastInput=performance.now();if(this.lastDevice\"'!==device){this.lastDevice=device;document.body.classList.toggle('\"'touch',device==='touch');if(typeof refreshPrompts==='function')refreshPrompts()}if(game?.attract){exitAttract();this.keys.clear();this.pressed.clear();this.mouseHeld.clear();this.mousePressed.clear();this.padSuppressed=true;this.suppressUntil=performance.now()+350;return false}return performance.now()>=this.suppressUntil}\n  init(){\n    addEventListener('keydown',e=>{const key=keyName(e);if(['space','arrowup','arrowdown','arrowleft','arrowright','tab'].includes(key))e.preventDefault();if(\"'!this.activity('\"'keyboard'))return;audio.unlock();if(\"'!this.keys.has(key))this.pressed.add(key);this.keys.add(key);if(ui.screen){if(!e.repeat)menuKey(key);return}if(key==='\"'escape'){e.preventDefault();togglePause()}else if(key==='j'&&\"'!AIHub.active)openMenu('\"'journal','pause')});\n    addEventListener('keyup',e=>this.keys.delete(keyName(e)));\n    addEventListener('blur',()=>{this.clear();if(game?.status==='playing'&&\"'!game.attract&&!AIHub.active)openMenu('\"'pause')});\n    document.addEventListener('pointermove',e=>{if(e.pointerType==='touch'){this.moveTouch(e);return}if(Math.abs(e.clientX-this.mouse.x)+Math.abs(e.clientY-this.mouse.y)>2)this.activity('keyboard');this.mouse.x=e.clientX;this.mouse.y=e.clientY;});\n    document.addEventListener('pointerdown',e=>{if(\"'!this.activity(e.pointerType==='\"'touch'?'touch':'keyboard')){e.preventDefault();e.stopPropagation();return}audio.unlock();if(ui.screen||e.target.closest('button,input,select'))return;if(e.pointerType==='touch'){this.startTouch(e);return}this.mouseHeld.add(e.button);this.mousePressed.add(e.button);if(e.button===0&&game?.status==='playing'){const target=contextFor(getLocalPlayer());const point=screenToWorld(e.clientX,e.clientY);if(target&&point&&Math.hypot(point.x-target.x,point.z-target.z)<2){this.pressed.add('e');this.mousePressed.delete(0);this.mouseHeld.delete(0)}}},true);\n    addEventListener('pointerup',e=>{this.mouseHeld.delete(e.button);if(this.touchLeft?.id===e.pointerId){this.touchLeft=null;this.touchVector={x:0,z:0}}if(this.touchRight?.id===e.pointerId){this.touchRight=null}});\n    addEventListener('pointercancel',e=>{if(this.touchLeft?.id===e.pointerId){this.touchLeft=null;this.touchVector={x:0,z:0}}if(this.touchRight?.id===e.pointerId)this.touchRight=null});\n    addEventListener('contextmenu',e=>e.preventDefault());\n    \"'$('\"'pause-button').addEventListener('click',()=>togglePause());\"'$('\"'context-button').addEventListener('click',()=>{if(this.lastDevice==='touch'&&game?.phase==='balance'){this.pressed.add('e')}else this.pressed.add('e')});\n    \"'$('\"'balance').addEventListener('pointerdown',e=>{if(e.pointerType==='touch')this.pressed.add('e')});\n    addEventListener('gamepadconnected',()=>{toast('Controller ready · '+settings.glyphs+' prompts');this.lastDevice='pad';refreshPrompts()});\n  }\n  startTouch(e){if(e.clientX<innerWidth*.52&&\"'!this.touchLeft){this.touchLeft={id:e.pointerId,x:e.clientX,y:e.clientY};this.touchVector={x:0,z:0}}else{this.touchRight={id:e.pointerId,x:e.clientX,y:e.clientY,time:performance.now()};this.pressed.add('\"'q');this.mouse.x=e.clientX;this.mouse.y=e.clientY}}\n  moveTouch(e){if(this.touchLeft?.id===e.pointerId){this.touchVector={x:clamp((e.clientX-this.touchLeft.x)/52,-1,1),z:clamp((e.clientY-this.touchLeft.y)/52,-1,1)}}else if(this.touchRight?.id===e.pointerId){this.mouse.x=e.clientX;this.mouse.y=e.clientY}}\n  clear(){this.keys.clear();this.pressed.clear();this.mouseHeld.clear();this.mousePressed.clear();this.touchLeft=null;this.touchRight=null;this.touchVector={x:0,z:0}}\n  poll(dt){this.menuRepeat-=dt;let pads=[];try{pads=Array.from(navigator.getGamepads?.()||[]).filter(Boolean)}catch{}this.pads=[];let any=false;\n    pads.forEach((pad,index)=>{const prev=this.prevPads[pad.index]||[];const held=pad.buttons.map(b=>b.pressed||b.value>.5),pressed=held.map((v,i)=>v&&\"'!prev[i]);const axis=v=>Math.abs(v||0)<.18?0:Math.sign(v)*(Math.abs(v)-.18)/.82;const mx=axis(pad.axes[0]),mz=axis(pad.axes[1]),ax=axis(pad.axes[2]),az=axis(pad.axes[3]);const active=held.some(Boolean)||Math.abs(mx)+Math.abs(mz)+Math.abs(ax)+Math.abs(az)>.1;any=any||active;if(active&&!this.padSuppressed)this.activity('\"'pad');this.pads[index]={mx,mz,ax,az,jump:pressed[0],roll:pressed[1],whip:held[2],interact:pressed[3],shoot:held[7],sprint:held[6],held,pressed};this.prevPads[pad.index]=held;if(\"'!this.padSuppressed&&active){audio.unlock();if(ui.screen){if(this.menuRepeat<=0){if(held[12]||mz<-.5){menuNavigate(-1);this.menuRepeat=.2}else if(held[13]||mz>.5){menuNavigate(1);this.menuRepeat=.2}if(held[14]||mx<-.5){menuAdjust(-1);this.menuRepeat=.16}else if(held[15]||mx>.5){menuAdjust(1);this.menuRepeat=.16}}if(pressed[0])menuActivate();if(pressed[1]||pressed[9]&&!held[8])menuBack();if(Math.abs(az)>.2)$('\"'menu').querySelector('.credits-scroll,.sheet')?.scrollBy(0,az*dt*550)}else{if(pressed[9]&&\"'!(AIHub.active&&held[8]))togglePause();if(!AIHub.active&&game?.localCoop&&index>=game.players.length&&pressed[0])joinLocalPlayer()}}});\n    if(!any)this.padSuppressed=false;\n  }\n  frame(slot=0){const hub=AIHub.active;const pad=this.pads[hub?0:slot];let mx=0,mz=0;const primary=slot===0||hub;\n    if(primary){mx=(this.keys.has('\"'d')?1:0)-(this.keys.has('a')?1:0);mz=(this.keys.has('s')?1:0)-(this.keys.has('w')?1:0);if((game?.players.length||0)<2){mx+=(this.keys.has('arrowright')?1:0)-(this.keys.has('arrowleft')?1:0);mz+=(this.keys.has('arrowdown')?1:0)-(this.keys.has('arrowup')?1:0)}}else if(slot===1){mx=(this.keys.has('arrowright')?1:0)-(this.keys.has('arrowleft')?1:0);mz=(this.keys.has('arrowdown')?1:0)-(this.keys.has('arrowup')?1:0)}\n    const touch=primary&&this.lastDevice==='touch';if(touch){mx=this.touchVector.x;mz=this.touchVector.z}\n    const len=Math.hypot(mx,mz);if(len>1){mx/=len;mz/=len}if(pad&&\"'!this.padSuppressed&&Math.abs(pad.mx)+Math.abs(pad.mz)>.08){mx=pad.mx;mz=pad.mz}\n    let ax=pad?.ax||0,az=pad?.az||0,mouseAim=false;if(primary&&this.lastDevice==='\"'keyboard'&&camera){const p=getLocalPlayer(),world=screenToWorld(this.mouse.x,this.mouse.y);if(p&&world){ax=world.x-p.x;az=world.z-p.z;mouseAim=Math.hypot(ax,az)>.4;const l=Math.hypot(ax,az);if(l>0){ax/=l;az/=l}}}\n    const pk=k=>this.pressed.has(k),hk=k=>this.keys.has(k),secondary=slot===1&&\"'!hub;\n    return{mx,mz,ax,az,mouseAim,whip:!!(pad?.whip||primary&&(this.mouseHeld.has(0)||hk('\"'q'))||secondary&&hk('/')),shoot:\"'!!(pad?.shoot||primary&&(this.mouseHeld.has(2)||hk('\"'f'))||secondary&&hk('.')),jump:\"'!!(pad?.jump||primary&&pk('\"'space')||secondary&&pk('enter')),roll:\"'!!(pad?.roll||primary&&(pk('\"'control')||pk('c'))||secondary&&pk('shift')),interact:\"'!!(pad?.interact||primary&&pk('\"'e')||secondary&&pk('\\\\'')),sprint:\"'!!(pad?.sprint||primary&&hk('\"'shift')||secondary&&hk('0')||touch&&game?.phase==='escape'),touch};\n  }\n  consume(){this.pressed.clear();this.mousePressed.clear();for(const p of this.pads){p.jump=false;p.roll=false;p.interact=false}}\n}\nlet controls;\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
