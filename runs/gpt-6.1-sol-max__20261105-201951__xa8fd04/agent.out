{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/ui.js';s=open(p).read().replace('Usage: added on import.</p></section>', 'Usage: \"'${esc(REPORT.sourceInformation.usage)}.</p></section>'\"');open(p,'w').write(s)\np='tests/run.py';s=open(p).read().replace(\\\"choices=['core','hub','visual','all']\\\", \\\"choices=['core','hub','visual','delivery','all']\\\")\nneedle='    def visual():'\nfn='''    def delivery():\n        ctx=browser.new_context(ignore_https_errors=True,viewport={'width':1280,'height':720});p=ctx.new_page();requests=[]\n        p.on('request',lambda request:requests.append(request.url))\n        try:\n            selection=json.loads((ROOT/'selection.json').read_text())\n            p.goto((ROOT.parent/(selection['slug']+'.html')).as_uri()+'?test=1',wait_until='domcontentloaded')\n            p.wait_for_function('window.__gameReady || window.__gameError',timeout=120000)\n            s=state(p);check('Export starts from file URL using actual CDN dependencies',s['status']=='title' and s['renderer']=='WebGPU' and not p.evaluate('window.__gameError||null'),str(s))\n            p.get_by_role('button',name='About & credits',exact=True).click(timeout=5000);p.get_by_role('button',name='Testing feedback',exact=True).click()\n            text=p.locator('.credits-scroll').inner_text();check('Exported credits contain final testing feedback','112/112' in text and '6 game/UI/integration defects' in text)\n            (ART/'delivery.json').write_text(json.dumps({'requests':requests,'state':s,'credits':text},indent=2))\n        finally:ctx.close()\n'''\ns=s.replace(needle,fn+needle)\ns=s.replace(\\\"if args.suite in ['visual','all']:\\\", \\\"if args.suite in ['delivery','all']:case('export delivery',delivery)\\\\n    if args.suite in ['visual','all']:\\\")\nopen(p,'w').write(s)\np='README.txt';s=open(p).read().replace('Optional focused suites: ./tests/run.sh --suite core|hub|visual', 'Optio