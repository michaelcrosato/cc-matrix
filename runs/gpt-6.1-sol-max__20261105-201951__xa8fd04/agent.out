{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/game.js';s=open(p).read().replace(\\\"p.id===playerId?controls.frame(0):remoteInput(p.id)\\\", \\\"p.id===playerId?(ui.screen?EMPTY_INPUT:controls.frame(0)):remoteInput(p.id)\\\")\nopen(p,'w').write(s)\np='tests/run.py';s=open(p).read();s=s.replace(\\\"def core():\\\", \\\"def static_files():\\\\n        selection=json.loads((ROOT/'selection.json').read_text());html=(ROOT.parent/(selection['slug']+'.html')).read_text();report=json.loads((ROOT.parent/'exit-interview.json').read_text())\\\\n        check('Single-file export and interview parse', '<title>Raiders of the Golden Goose</title>' in html and set(report)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'})\\\\n        check('Unmodified AI Hub client is first head script', html.split('<script>',1)[1].startswith((ROOT/'hub-session.js').read_text()))\\\\n        check('Title chosen from fifty with cryptographic RNG',selection['candidates']==50 and selection['method']=='node:crypto randomInt' and 1<=selection['index']<=50)\\\\n        check('No source module or media-file runtime dependencies', 'src/engine.js' not in html and not any(ext in html for ext in ['.mp3\\\\\\\\\\\\\\\"','.wav\\\\\\\\\\\\\\\"','.ogg\\\\\\\\\\\\\\\"']))\\\\n    def core():\\\")\n# Add standalone file URL proof at the end of keyboard core context, after all other assertions.\ns=s.replace(\\\"check('No runtime exceptions',not page_errors and not p.evaluate('window.__gameError||null'),str(page_errors))\\\", \\\"check('No runtime exceptions',not page_errors and not p.evaluate('window.__gameError||null'),str(page_errors))\\\\n            selection=json.loads((ROOT/'selection.json').read_text());p.goto((ROOT.parent/(selection['slug']+'.html')).as_uri()+'?test=1');p.wait_for_function('window.__gameReady || window.__gameError',timeout=90000);check('Export runs directly from file URL',p.evaluate('\"'!!window.__gameReady && !window.__gameError'\"'))\\\")\n# Verify that all four local seats can actually be created by independent standard pads.\ns=s.replace(\\\"check('Xbox option replaces face glyphs','X' in p.locator('#controls').inner_text() and 'RT' in p.locator('#controls').inner_text())\\\", \\\"check('Xbox option replaces face glyphs','X' in p.locator('#controls').inner_text() and 'RT' in p.locator('#controls').inner_text())\\\\n            p.evaluate('window.__virtualPad.axes[2]=0;window.__GG.closeMenu();window.__GG.start(true);window.__extraPads=[1,2,3].map(index=>({...window.__virtualPad,index,axes:[0,0,0,0],buttons:Array.from({length:17},(_,i)=>({pressed:index>1&&i===0,value:index>1&&i===0?1:0}))}));navigator.getGamepads=()=>[window.__virtualPad,...window.__extraPads]');p.wait_for_function('window.__GG.snapshot().players.length===4',timeout=15000);check('Four standard gamepads support four couch explorers',len(state(p)['players'])==4)\\\")\n# Manual session verifies real client input and mirror interaction reach host authority.\nneedle=\\\"    def visual():\\\"\nnetwork='''    def network_gameplay():\n        ctx=context(browser);p=ctx.new_page()\n        try:\n            p.goto(BASE+'/harness.html?game=game.html%3Ftest%3D1&players=2&latency=80&jitter=20&loss=0')\n            p.wait_for_function(\\\"document.querySelectorAll('iframe').length===2 && Array.from(document.querySelectorAll('iframe')).every(f=>f.contentWindow.__gameReady)\\\",timeout=90000)\n            p.locator('#release').click();p.wait_for_function(\\\"Array.from(document.querySelectorAll('iframe')).every(f=>f.contentWindow.AIHub.time()>=0)\\\",timeout=20000)\n            frames=[f for f in p.frames if f.parent_frame]\n            host=next(f for f in frames if f.evaluate('AIHub.isHost'));guest=next(f for f in frames if not f.evaluate('AIHub.isHost'))\n            host.evaluate('window.__GG.advance(20)');start=host.evaluate('window.__GG.snapshot().players[1].x')\n            guest.evaluate(\\\"window.dispatchEvent(new KeyboardEvent('keydown',{key:'d',code:'KeyD'}))\\\")\n            p.wait_for_timeout(300);host.evaluate('window.__GG.advance(30)')\n            guest.evaluate(\\\"window.dispatchEvent(new KeyboardEvent('keyup',{key:'d',code:'KeyD'}))\\\")\n            check('Remote ordinary input moves the correct shared-world seat',host.evaluate('window.__GG.snapshot().players[1].x')>start+1)\n            p.wait_for_timeout(300);host.evaluate('window.__GG.warp(1,-6,-33.7);window.__GG.advance(1)');p.wait_for_timeout(300)\n            guest.evaluate(\\\"window.dispatchEvent(new KeyboardEvent('keydown',{key:'e',code:'KeyE'}));window.dispatchEvent(new KeyboardEvent('keyup',{key:'e',code:'KeyE'}))\\\")\n            success=False\n            for _ in range(25):\n                p.wait_for_timeout(60);host.evaluate('window.__GG.advance(1)')\n                if host.evaluate('window.__GG.snapshot().mirrors[0].rotation===1'):success=True;break\n            check('Remote interaction rotates host-authoritative sun lens',success)\n            p.wait_for_function(\\\"Array.from(document.querySelectorAll('iframe')).every(f=>f.contentWindow.__GG.snapshot().mirrors[0].rotation===1)\\\",timeout=10000)\n            check('Shared puzzle state reaches both clients',True)\n            # A complete ordinary-action run on the host must finish the hub round as a team win.\n            report=host.evaluate((ROOT/'tests/playthrough.js').read_text());(ART/'online-playthrough.json').write_text(json.dumps(report,indent=2))\n            p.wait_for_function(\\\"Array.from(document.querySelectorAll('iframe')).every(f=>f.contentWindow.__GG.snapshot().hub.ended)\\\",timeout=15000)\n            check('Whole online expedition ends every seat with a team win',report['final']['status']=='won' and report['final']['hasRelic'])\n        finally:ctx.close()\n'''\ns=s.replace(needle,network+needle)\ns=s.replace(\\\"case('core expedition',core);\\\", \\\"case('package integrity',static_f