{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmyUJkbV6xpUErfLE79","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16873,"cache_read_input_tokens":460847,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16873},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f147b5a-afdb-41c5-bbfc-62264f8c7cee","uuid":"0331e09c-bb6b-413b-8e50-d54eda4505cb","timestamp":"2026-11-06T01:05:44.488Z","request_id":"req_011CgkmyU1Q6f39j2vuQVTrs","thinking_duration_ms":31565,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmyUJkbV6xpUErfLE79","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RFtaTEgLfd6Fz4xp1dNxzz","name":"Bash","input":{"command":"cat > src/systems/year.js <<'E'\n// The sixteen-day year: hourly beats, festivals, contests, Vesper, cheese, Rocco's story, snow, stars, the ending, Inspector Pimm.\nimport { THREE, buildModel, toonMaterial, glowMaterial, PALETTE, setLookLayer } from '../engine.js';\nimport { G, bus } from '../state.js';\nimport { HOSTS_TALK } from './talk.js';\nimport { Script, say, ask, Toasts, until, fill } from '../ui/dialogue.js';\nimport { HOSTS, FESTIVAL_LINES, TYPE_LINES } from '../data/lines.js';\nimport { UI, panel, promptRow, menu, hit, hitAt, dim, para } from '../ui/kit.js';\nimport { drawText, wrap, textWidth, LINE_H } from '../ui/font.js';\nimport { keyboardScreen, pocketsScreen, CONSTELLATIONS, readLetter, patternStudio } from '../ui/screens.js';\nimport { ITEMS, SONG_RECORDS, FISH_LIST, BUG_LIST } from '../data/items.js';\nimport { T } from '../dev/tuning.js';\nimport { earn, giveItem, remember, info, addEnt, removeEnt, entAt, isFree, friendGain, addLetter, hasItem, takeItem, museumCount } from '../core/world.js';\nimport { fmt, rngOf, clamp, lerp, dist2, fmtTime } from '../core/util.js';\nimport { hourOf, SEASON_NAMES, DAY_TYPES, weatherNow } from '../core/calendar.js';\nimport { NPC } from '../actors/npcs.js';\nimport { CAST, NEIGHBOURS, nameOf } from '../data/cast.js';\nimport { setPlace, Trans, rebuildRoom } from '../world/places.js';\nimport { LANDMARK, BUILDINGS } from '../world/layout.js';\nimport { M, playChime } from '../audio/music.js';\nimport { speakChar } from '../audio/voice.js';\nimport { cheesePrice } from './days.js';\nimport { townRating } from './services.js';\nimport { addTargets, setTimeout0 } from './interact.js';\nimport { Nature, collect } from './nature.js';\nimport { Actor } from '../actors/actor.js';\nimport { critterDef } from '../art/critter.js';\nconst R = () => rngOf(`${G.world.seed}:y:${G.world.clock.day}:${G.world.clock.minute}:${G.time}`);\nconst line = (arr) => R().pick(arr);\nexport const YI = { rindHere: false, vesperHere: false, cheesePrice: 100 }; G.yearInfo = YI;\nconst CONTEST = { derby: { name: 'Fishing Derby', from: 10, to: 13, rule: 'Biggest fish wins', trophy: 'trophy_fish' }, bugoff: { name: 'Bug-Off', from: 10, to: 13, rule: 'Most value wins', trophy: 'trophy_bug' }, snowman: { name: 'Snowman Contest', from: 10, to: 13, rule: 'Best proportions win. Bartleby judges. He would prefer not.', trophy: 'trophy_snow' } };\nexport const FEST_BY_YD = { 4: 'seedToss', 8: 'lantern', 12: 'soup', 16: 'longNight' };\nexport const CONTEST_BY_YD = { 6: 'derby', 10: 'bugoff', 14: 'snowman' };\n// ---- The clock calls this on every new hour.\nexport function onHour(h) {\n  const w = G.world, inf = info(w);\n  YI.rindHere = inf.slot === 0 && h >= 6 && h < 12; if (G.view.rindStall) G.view.rindStall.visible = YI.rindHere;\n  YI.vesperHere = inf.slot === 2 && h >= 20 && h < 24; syncVesper();\n  ITEMS.cheesewheel.price = cheesePrice(w); YI.cheesePrice = ITEMS.cheesewheel.price;\n  if (h === 9) { const due = w.mailQueue.filter((m) => m.at <= w.clock.day); if (due.length) { for (const m of due) { w.mail.push({ ...m, read: false, day: w.clock.day }); if (m.giftValue) m.onBag = true; } w.mailQueue = w.mailQueue.filter((m) => m.at > w.clock.day); G.ctx.audio.play('mailFlag'); Toasts.add('The postbox flag has gone up.'); bus.emit('mail'); } }\n  if (w.p.buffs.coffee && h >= 12) { delete w.p.buffs.coffee; Toasts.add('The coffee wears off. Your legs file a complaint.'); }\n  // the Bell plays your Chime on the hour\n  if (w.p.place === 'town') { G.view.bellRing(); playChime(G.ctx.audio, w.chime); bus.emit('bellRung'); w.stats.bells = (w.stats.bells ?? 0) + 1; }\n  // Contests\n  const c = CONTEST_BY_YD[inf.storyYd] ?? inf.contest; if (c && !G.demo && !w.day1Pending) { const def = CONTEST[c]; if (h === def.from && (!w.contest || w.contest.day !== w.clock.day)) startContest(c); if (h === def.to && w.contest?.day === w.clock.day && !w.contest.done) endContest(); }\n  // Show Day nights: the Bureau scores\n  if (inf.slot === 2 && h === 22) G.bureauMail?.(w);\n  // Lantern Float fireworks\n  if (G.fest?.id === 'lantern' && h === 21 && !G.fest.fired) { G.fest.fired = true; fireworkShow(); }\n  bus.emit('hour', h);\n}\n/** The morning after: story beats follow days played. */\nexport function onMorning() {\n  const w = G.world, inf = info(w), yd = inf.storyYd, r = R();\n  for (const k of ['seedToss', 'lantern', 'soup', 'longNight']) if (w.festival?.id === k && w.festival.day < w.clock.day) w.festival = null;\n  if (G.fest) G.fest = null;\n  if (w.day1 && !w.day1.done && w.clock.day >= 3) finishDayOne();\n  if (yd === 7 && w.year === 1 && !w.flags.roccoTalk) { w.flags.roccoHint = true; }\n  if (yd === 9 && !w.flags.roccoGone) roccoLeaves();\n  if (yd === 15 && !w.flags.roccoLetter) { w.flags.roccoLetter = true; w.mail.push({ from: 'rocco', subject: 'From Rocco', body: `${w.name}! Big hills out here! BIG! I rolled up one and it took three days! I won't lie, I miss the dents. I'm rolling back for the Long Night. Don't tell Tavi. Tell Tavi. Let's roll!`, read: false, day: w.clock.day }); G.ctx.audio.play('mailFlag'); }\n  if (yd === 3 && !w.flags.chimeAsked) { w.flags.chimeAsked = true; w.mail.push({ from: 'clementine', subject: 'From the Town Hall', body: `The Bell has played one note since the Mayor's cousin. Come and write it something. Any time. Today would be fine. Everything is fine. Clementine.`, read: false, day: w.clock.day }); }\n  if (yd === 2 && !w.flags.museumNote) { w.flags.museumNote = true; w.flags.museumOpen = true; w.mail.push({ from: 'quill', subject: 'From the Museum', body: `It's open! Or it's a very large shed! Bring your fossil! Bring anything! Bring a lamp, I can't find the lamp! Dr. Quill.`, read: false, day: w.clock.day }); }\n  if (inf.season === 3 && r) { for (let i = 0; i < 3; i++) { const tx = r.int(46, 76), tz = r.int(26, 46); if (isFree(w, tx, tz, 0)) addEnt(w, { t: 'snowball', x: tx + 0.5, z: tz + 0.5, size: 0.5 }); } for (let i = 0; i < 3; i++) { const tx = r.int(3, 36), tz = r.int(26, 46); if (isFree(w, tx, tz, 0)) addEnt(w, { t: 'snowball', x: tx + 0.5, z: tz + 0.5, size: 0.5 }); } }\n  if (w.festival?.bloom) { for (const [x, z, c] of w.festival.bloom) { const tx = Math.floor(x), tz = Math.floor(z); if (isFree(w, tx, tz, 0)) addEnt(w, { t: 'flower', sp: 'tulip', c, x: tx + 0.5, z: tz + 0.5, dry: 0, wet: 1 }); } w.flags.bloomed = true; w.festival = null; Toasts.add('The plaza has bloomed in the pattern you sowed.'); }\n  if (w.gagGift) { w.mail.push({ from: 'dorrit', subject: 'From Dorrit', body: \"I'm sorry about the soup, mmhm. Everyone's fine. Mostly. Here's the lid. Keep it. We don't want it back.\", gift: 'box', read: false, day: w.clock.day }); w.gagGift = false; }\n  const inFest = FEST_BY_YD[yd]; const c = CONTEST_BY_YD[yd]; G.dayTitle = `${SEASON_NAMES[inf.season]} · ${inf.type}`; const msg = inFest ? { seedToss: 'Today: The Seed Toss. Everyone to the plaza.', lantern: 'Today: The Lantern Float. At dusk, at the north bridge.', soup: \"Today: The Great Soup. Dorrit's pot is on the plaza.\", longNight: 'Today: The Long Night. The sun sets at four.' }[inFest] : c ? `Today: the ${CONTEST[c].name}, from 10 until 1.` : inf.slot === 2 ? 'Vesper plays tonight on the plaza, at eight.' : inf.slot === 0 ? 'Old Rind is on the plaza this morning. Follow your nose.' : null; if (msg) Toasts.add(msg, 5); bus.emit('morning', yd);\n}\n// ---- Notice board\nG.readNotice = () => { const w = G.world, inf = info(w); const c = w.cheese; const yd = inf.storyYd; Script.run((function* () { w.stats.notices = (w.stats.notices ?? 0) + 1; const fest = FEST_BY_YD[yd]; const today = fest ? { seedToss: 'THE SEED TOSS, 10 till dusk', lantern: 'THE LANTERN FLOAT, dusk', soup: 'THE GREAT SOUP, all day', longNight: 'THE LONG NIGHT' }[fest] : CONTEST_BY_YD[yd] ? `${CONTEST[CONTEST_BY_YD[yd]].name.toUpperCase()}, 10 till 1. ${CONTEST[CONTEST_BY_YD[yd]].rule}.` : inf.slot === 2 ? 'VESPER, 8pm, lamp post' : 'Nothing. Enjoy it.'; const text = `TODAY: ${today} | CHEESE: ${c.pattern ? `This week's wheels: ${c.pattern}. Today's price: ${fmt(cheesePrice(w))} beans. Wheels go off on Market Day.` : 'See Old Rind on Market Day morning. There is no Old Rind.'} | NOTICE: Whoever has been drawing on this board, the bee would like a word.`; yield say('narrator', text, { name: 'Notice Board' }); bus.emit('notice'); })()); };\nG.ringBell = () => { const w = G.world; G.view.bellRing(); G.playChime(w.chime); Toasts.add('It rings. Somewhere, a goose writes something down.'); };\nG.playChime = (ch) => playChime(G.ctx.audio, ch);\n// ---- Hosts out of doors\nHOSTS_TALK.trundle = function* (actor) { const w = G.world; if (G.storyTalk) { const s = G.storyTalk('trundle'); if (s) { yield* s; return; } } yield say('trundle', line(HOSTS.trundle), { actor }); const fid = FEST_BY_YD[info(w).storyYd]; if (fid && !w.flags[`fest${w.clock.day}`] && canFest(fid)) { const p = yield ask('trundle', fid === 'seedToss' ? 'Is it… time… for the Seed Toss?' : fid === 'soup' ? 'The… soup… is on.' : 'Are we… doing… the thing?', ['Yes, start it', 'Not yet'], { actor, cancel: 1 }); if (p === 0) startFestival(fid); } };\nHOSTS_TALK.hester = function* (actor) { yield say('hester', line(HOSTS.hester), { actor }); };\nHOSTS_TALK.vesper = function* (actor) {\n  const w = G.world; yield say('vesper', line(HOSTS.vesper), { actor }); const moods = [['Rainy', 'rec_rain'], ['Small', 'rec_small'], ['In debt', 'rec_debt'], ['By the sea', 'rec_sea'], ['Honking', 'rec_goose'], ['Leaving', 'rec_bye']]; const p = yield ask('vesper', \"What's your mood, friend?\", [...moods.map((m) => m[0]), 'Just listening'], { actor, cancel: 6 });\n  if (p === 6) return; const [mood, id] = moods[p]; M.override = ITEMS[id].song; bus.emit('vesper', id); G.ctx.audio.play('applause', { volume: 0.2 }); for (const n of NEIGHBOURS) NPC.rt[n].act = 'Sway';\n  const verse = R().pick([\"♪ La-da-dee, and it's raining on the lamp, / and I'm hanging here, and I'm a little bit damp… ♪\", \"♪ Oh, a small, small thing in a small, small town, / and it hung upside down, and it never came down… ♪\", \"♪ You owe, I owe, the moon owes the sea, / and the goose has it all, and she's writing to me… ♪\"]); const s = say('vesper', verse, { actor }); yield s; M.override = null; if (!w.p.records.includes(id)) { w.p.records.push(id); w.stats.recordsGot = (w.stats.recordsGot ?? 0) + 1; G.ctx.audio.play('reveal'); yield say('vesper', `Take the record. \"${ITEMS[id].name.replace('Vesper: ', '')}.\" Put it on when the house is too quiet to be funny.`, { actor }); } remember(w, 'vesper', { item: mood });\n};\nfunction syncVesper() { const rt = NPC.rt.vesper; if (!rt) return; rt.vis = (p) => p === 'town' && YI.vesperHere; rt.x = LANDMARK.lamp[0]; rt.z = LANDMARK.lamp[1] + 0.5; rt.y = 3.1; rt.clip = 'VesperHang'; rt.face = Math.PI / 6; }\nHOSTS_TALK.rind = function* (actor) {\n  const w = G.world; yield say('rind', line(HOSTS.rind), { actor }); const price = cheesePrice(w); if (!YI.rindHere) return; const p = yield ask('rind', `Wheel of cheese? ${fmt(price)} beans. This week it's looking… ${w.cheese.pattern}. You didn't hear that.`, ['Buy one', 'Buy five', 'No'], { actor, cancel: 2 });\n  if (p === 2) return; const n = p === 0 ? 1 : 5; let got = 0; for (let i = 0; i < n; i++) { if (w.p.beans < price || w.p.pockets.indexOf(null) < 0) break; w.p.beans -= price; giveItem(w, { id: 'cheesewheel', bought: w.clock.day, paid: price }); got++; } if (!got) { yield say('rind', \"No beans, no pockets, or no courage. Pick one and come back.\", { actor }); return; } G.ctx.audio.play('cheeseSmell'); w.stats.cheeseBought = (w.stats.cheeseBought ?? 0) + got; bus.emit('cheeseBought', got); yield say('rind', 'Sell at the goose. Sell before Market Day. Sell before it knows your name.', { actor });\n};\n// ---- Pimm\nHOSTS_TALK.pimm = function* (actor) { yield say('pimm', line(HOSTS.pimm.slice(4)), { actor }); };\nexport function pimmVisit(i) { const w = G.world; if (!NPC.actors.pimm) NPC.make('pimm'); const rt = NPC.rt.pimm, a = NPC.actors.pimm; rt.fixed = true; rt.x = w.p.x + 1.6; rt.z = w.p.z + 0.5; rt.y = G.place.heightAt(w.p.x, w.p.z); rt.vis = (p) => p === w.p.place; rt.force = [rt.x, rt.y, rt.z]; rt.clip = 'PimmScuttle'; rt.talkTo = true; w.stats.pimm = (w.stats.pimm ?? 0) + 1; Script.run((function* () { yield 0.6; rt.clip = 'Idle'; yield say('pimm', HOSTS.pimm[Math.min(i, 3)], { actor: a }); bus.emit('pimm', i); rt.clip = 'PimmScuttle'; rt.talkTo = false; rt.force = null; rt.vis = () => false; })()); }\n// ---- Festivals\nconst canFest = (id) => (id === 'lantern' ? G.world.clock.minute >= 17 * 60 : id === 'longNight' ? true : G.world.clock.minute >= 8 * 60);\naddTargets((place) => {\n  const w = G.world, out = []; if (place !== 'town') return out; const yd = info(w).storyYd, fid = FEST_BY_YD[yd], fest = G.fest;\n  if (fid === 'seedToss' && !w.flags[`fest${w.clock.day}`] && !fest) out.push({ kind: 'fest', x: 24, z: 41, reach: 2.2, label: 'The Seed Toss', verb: 'Join', act: () => startFestival('seedToss') });\n  if (fid === 'lantern' && !w.flags[`fest${w.clock.day}`] && canFest('lantern') && !fest) out.push({ kind: 'fest', x: 39.5, z: 23.2, reach: 2.5, label: 'Lantern Float', verb: 'Join', act: () => startFestival('lantern') });\n  if (fid === 'soup' && !w.flags[`fest${w.clock.day}`]) out.push({ kind: 'fest', x: LANDMARK.pot[0], z: LANDMARK.pot[1], reach: 2.2, label: 'The Great Pot', verb: 'Add', act: () => startFestival('soup') });\n  if (fid === 'longNight' && !w.flags[`fest${w.clock.day}`] && !fest) out.push({ kind: 'fest', x: 24, z: 40.4, reach: 2.4, label: 'String of Lights', verb: 'Take', act: () => startFestival('longNight') });\n  if (fest?.id === 'longNight' && fest.stage === 'doors') for (const d of fest.doors) if (!d.done) out.push({ kind: 'fest', x: d.x, z: d.z, reach: 1.6, label: `${CAST[d.id].short ?? CAST[d.id].name}'s door`, verb: 'String the lights', act: () => doorLight(d) });\n  if (fest?.id === 'longNight' && fest.stage === 'pear') out.push({ kind: 'fest', x: 24, z: 40.4, reach: 2.6, label: 'The Old Pear', verb: 'Wait for midnight', act: () => midnight() });\n  return out;\n});\nexport function startFestival(id) { const w = G.world; if (G.fest || w.flags[`fest${w.clock.day}`]) return; w.flags[`fest${w.clock.day}`] = true; bus.emit('festStart', id); M.override = id === 'lantern' ? 'lantern' : id === 'soup' ? 'soup' : id === 'longNight' ? 'longNight' : 'seedToss'; if (id === 'seedToss') return Script.run(seedToss()); if (id === 'lantern') return Script.run(lanternFloat()); if (id === 'soup') return Script.run(greatSoup()); if (id === 'longNight') return Script.run(longNight()); }\nconst gather = (x, z, r = 4) => { const rng = rngOf('gather' + G.time); for (const n of NEIGHBOURS) { const st = G.world.npcs[n], rt = NPC.rt[n]; if (st.moved === 'gone' || st.moved === 'notyet') continue; st.place = 'town'; rt.indoorLocal = false; const a = rng.range(0, 6.28); rt.x = x + Math.cos(a) * rng.range(r * 0.7, r); rt.z = z + Math.sin(a) * rng.range(r * 0.7, r); rt.path = null; rt.wait = 90; rt.pause = 1e4; rt.act = 'Sway'; rt.faceTo = [x, z]; rt.moving = false; } };\nconst release = () => { for (const n of NEIGHBOURS) { const rt = NPC.rt[n]; rt.pause = 0; rt.wait = 2; rt.act = null; rt.faceTo = null; const a = NPC.actors[n]; a.mood = null; } };\n// ---- The Seed Toss\nfunction* seedToss() {\n  const w = G.world, f = (G.fest = { id: 'seedToss', t: 90, score: 0, rings: [], seeds: [], bloom: [], hits: {} }); const rng = R(); gather(24, 39, 7); G.player.state = 'free'; w.p.x = 24; w.p.z = 42.5;\n  yield say('clementine', FESTIVAL_LINES.seedToss[0]); const g = new THREE.Group(); G.view.town.add(g); f.group = g;\n  for (let i = 0; i < 7; i++) { const x = rng.range(18, 30), z = rng.range(35, 43); const m = buildModel('sf-ringmark', {}).object; m.position.set(x, 0.02, z); g.add(m); f.rings.push({ x, z, r: 0.9, m }); }\n  f.running = true; G.player.actor.play('Idle');\n  yield until(() => f.t <= 0); f.running = false; G.ctx.audio.play('gavel'); for (const n of NEIGHBOURS) NPC.rt[n].act = 'Laugh';\n  yield say('clementine', `Time! You sowed ${f.score} ring${f.score === 1 ? '' : 's'}. It's fine. It's all fine. It's going to look wonderful.`);\n  const reward = f.score * 150; earn(w, reward); w.festival = { id: 'seedToss', day: w.clock.day, bloom: f.bloom.slice() }; w.stats.seedToss = f.score;\n  // The Mayor finally reaches the ribbon\n  const rt = NPC.rt.trundle; G.focusZoom = 2; yield say('trundle', 'I… have… arrived. I declare this… ribbon… cut.'); yield say('narrator', 'He reaches out. There is no ribbon. It was here in March. The crowd is very kind about it.'); yield say('trundle', 'Well. That… went… well. I shall… now… go back.'); w.flags.mayorArrived = true; G.focusZoom = null; G.ctx.audio.play('applause');\n  G.view.town.remove(g); G.fest = null; M.override = null; release(); bus.emit('festDone', 'seedToss', f.score);\n}\nexport function festFixed(dt) { const f = G.fest; if (!f) return; if (f.id === 'seedToss' && f.running) { f.t -= dt; const w = G.world; for (const s of f.seeds) { s.t += dt; const k = Math.min(1, s.t / s.dur); s.m.position.set(lerp(s.a[0], s.b[0], k), Math.sin(k * Math.PI) * 2 + 0.1, lerp(s.a[1], s.b[1], k)); if (k >= 1) { s.done = true; f.group.remove(s.m); seedLand(f, s); } } f.seeds = f.seeds.filter((s) => !s.done); f.npcT = (f.npcT ?? 0) - dt; if (f.npcT <= 0) { f.npcT = 0.7; const r = R(); const n = r.pick(NEIGHBOURS.filter((x) => !['gone', 'notyet'].includes(w.npcs[x].moved))); const rt = NPC.rt[n]; const ring = r.pick(f.rings); throwSeed(f, [rt.x, rt.z], [ring.x + r.range(-1, 1), ring.z + r.range(-1, 1)], false); } } }\nfunction throwSeed(f, a, b, mine) { const m = new THREE.Mesh(new THREE.SphereGeometry(0.1, 5, 4), toonMaterial(PALETTE.orange)); f.group.add(m); f.seeds.push({ m, a, b, t: 0, dur: 0.55, mine }); if (mine) G.ctx.audio.play('slingFire'); }\nfunction seedLand(f, s) { for (const ring of f.rings) if (dist2(s.b[0], s.b[1], ring.x, ring.z) < ring.r * ring.r) { G.ctx.particles.burst('confetti', [s.b[0], 0.4, s.b[1]], { count: 10 }); const c = R().pick(['red', 'sand', 'white', 'plum', 'orange']); const fm = buildModel('fl-tulip', { palette: { petal: c } }).object; fm.position.set(s.b[0], 0, s.b[1]); f.group.add(fm); if (s.mine) { f.score++; f.bloom.push([s.b[0], s.b[1], c]); G.ctx.audio.play('pop'); bus.emit('seedHit'); } return; } G.ctx.particles.burst('dust', [s.b[0], 0.1, s.b[1]], { count: 2 }); }\nexport function festTool(aimX, aimZ) { const f = G.fest; if (f?.id !== 'seedToss' || !f.running) return false; const w = G.world; const fx = aimX ?? w.p.x + Math.sin(w.p.facing) * 3.5, fz = aimZ ?? w.p.z + Math.cos(w.p.facing) * 3.5; G.player.actor.play('Cast', { then: 'Idle', restart: true }); throwSeed(f, [w.p.x, w.p.z], [fx, fz], true); return true; }\n// ---- The Lantern Float\nfunction* lanternFloat() {\n  const w = G.world, f = (G.fest = { id: 'lantern' }); gather(39.5, 21.5, 5); yield say('clementine', FESTIVAL_LINES.lantern[0]); const cols = ['Red', 'Orange', 'Sand', 'Lime', 'Sky', 'Plum'], cn = ['red', 'orange', 'sand', 'lime', 'sky', 'plum']; const pick = yield ask('clementine', 'Which colour? It matters. It does not matter.', cols, { cancel: 0 }); let wish = null; UI.push(keyboardScreen({ title: 'One line. Make a wish.', max: 40, lines: true, onDone: (t) => { wish = t; }, onCancel: () => { wish = '…'; } })); yield until(() => wish !== null);\n  w.stats.wishLine = wish; bus.emit('lantern', wish); w.mailQueue.push({ from: 'narrator', subject: 'A Reply, From the Sea', body: `Dear ${w.name}. Re: \"${wish}\". We have looked into this. The sea says: maybe. It also says it's keeping the lantern.`, at: w.clock.day + 1, gift: rngOf(wish).pick(['shell_pearl', 'drift_bottle', 's_navy']) });\n  // Hundreds of lights drifting to the sea\n  const N = 240; const geo = new THREE.BoxGeometry(0.28, 0.32, 0.28); const palette = ['orange', 'sand', 'red', 'lime', 'sky', 'plum']; const meshes = palette.map((c) => { const m = new THREE.InstancedMesh(geo, glowMaterial(PALETTE[c]), N); m.count = 0; m.frustumCulled = false; G.view.town.add(m); return m; }); const own = buildModel('sf-lantern', { palette: { glow: cn[pick] } }).object; own.scale.setScalar(1.6); G.view.town.add(own); f.lanterns = []; const r = R();\n  const path = [[39.5, 24], [39.5, 33], [41, 35], [42.5, 38], [42.5, 48], [43, 52], [43, 62], [46, 75]]; for (let i = 0; i < N; i++) f.lanterns.push({ p: r.range(-1, 0), s: r.range(0.018, 0.03), off: r.range(-1.4, 1.4), mesh: meshes[i % meshes.length] }); f.path = path; f.own = own; f.meshes = meshes; f.ownP = 0;\n  G.view.setFocus = [39.5, 26]; Toasts.add('You set it on the water. It leaves without looking back.'); f.running = true;\n  w.clock.minute = Math.max(w.clock.minute, 18 * 60); yield 5;\n  yield say('dorrit', \"They all go the same way, mmhm. Off to the sea. I like to think somebody's cooking down there.\");\n  yield until(() => hourOf(w.clock) >= 21 || (G.fest && (G.fest.skip = true))); if (hourOf(w.clock) < 21) { w.clock.minute = 21 * 60; onHour(21); }\n  fireworkShow(); f.fired = true; const pStart = G.time; yield 7; yield say('tavi', \"Look at it! Look at the sky! It's so loud! Isn't it?!\"); yield 2; G.fest.running = false; for (const m of meshes) G.view.town.remove(m); G.view.town.remove(own); G.fest = null; M.override = null; release(); G.view.setFocus = null; w.stats.lanternDone = true; bus.emit('festDone', 'lantern');\n}\nexport function festUpdate(dt) { const f = G.fest; if (f?.id === 'lantern' && f.running) { const seg = (p) => { const P = f.path, t = clamp(p, 0, 0.999) * (P.length - 1), i = Math.floor(t), k = t - i; return [lerp(P[i][0], P[i + 1][0], k), lerp(P[i][1], P[i + 1][1], k)]; }; const counts = new Map(); const dummy = (f.d ??= new THREE.Object3D()); for (const m of f.meshes) counts.set(m, 0); for (const l of f.lanterns) { l.p += l.s * dt; if (l.p > 1) l.p = 0; if (l.p < 0) continue; const [x, z] = seg(l.p); const c = counts.get(l.mesh); dummy.position.set(x + l.off, -0.14, z); dummy.updateMatrix(); l.mesh.setMatrixAt(c, dummy.matrix); counts.set(l.mesh, c + 1); } for (const m of f.meshes) { m.count = counts.get(m); m.instanceMatrix.needsUpdate = true; } f.ownP += 0.03 * dt; const [ox, oz] = seg(f.ownP); f.own.position.set(ox, -0.3, oz); } }\nexport function fireworkShow() { const w = G.world; const v = G.view; const fx = 30, fz = 58; const slot = w.p.patterns.findIndex(Boolean); let own = slot >= 0 ? w.p.patterns[slot] : null; const seq = [[20, 58], [40, 56], [30, 54], [28, 60], [46, 58], [34, 56]]; seq.forEach(([x, z], i) => setTimeout0(() => { if (i === 2 && own) { v.firework(x, z, own); w.stats.patternFirework = true; bus.emit('patternFirework'); } else v.firework(x, z); }, i * 1.1)); }\n// ---- The Great Soup\nfunction* greatSoup() {\n  const w = G.world, f = (G.fest = { id: 'soup' }); gather(LANDMARK.pot[0], LANDMARK.pot[1], 4); const pot = buildModel('giant-pot', {}).object; pot.position.set(LANDMARK.pot[0], 0, LANDMARK.pot[1]); G.view.town.add(pot); f.pot = pot; yield say('dorrit', FESTIVAL_LINES.soup[0]); const picks = []; for (let i = 0; i < 3; i++) { let c = null; UI.push(pocketsScreen({ title: `Ingredient ${i + 1} of 3`, pickLabel: 'In it goes', onPick: (e, idx, s) => { c = { e, idx }; UI.pop(s); }, onClose: () => { c = c ?? false; } })); yield until(() => c !== null); if (!c) { picks.push({ id: 'water', name: 'nothing', tags: [] }); continue; } const it = ITEMS[c.e.id]; w.p.pockets[c.idx] = null; picks.push(it); G.ctx.audio.play('plop'); G.ctx.particles.burst('splash', [LANDMARK.pot[0], 1.6, LANDMARK.pot[1]]); yield 0.3; }\n  const tagsOf = (it) => [it.cat, ...(it.tags ?? [])]; let score = 0; const cats = new Set(); for (const p of picks) { const t = tagsOf(p); if (t.includes('fish')) { score += 2; cats.add('fish'); } if (t.includes('fruit')) { score += 1; cats.add('fruit'); } if (t.includes('food') || t.includes('mushroom')) { score += 2; cats.add('mushroom'); } if (t.includes('boot')) { score += w.flags.bootYear ? 1 : -1; cats.add('boot'); } if (t.includes('cheese')) score += 1; if (t.includes('stinky')) score -= 3; if (t.includes('junk') && !t.includes('boot')) score -= 2; if (t.includes('flower')) score += 0; if (t.includes('bug')) score -= 2; } if (cats.size >= 3) score += 2; const good = score >= 3; w.stats.soup = { score, good }; f.good = good;\n  const tasters = NEIGHBOURS.filter((n) => !['gone', 'notyet'].includes(w.npcs[n].moved)).slice(0, 4); const goodLines = { hearth: \"That's the one, mmhm. That's the one my mother never made.\", sunshine: \"It's the best soup, isn't it?! It's got bits!\", grouch: 'Hm. …I would prefer more.', diva: \"Darling dear, one could almost call it food.\", gogetter: \"I can feel my plates! Let's roll!\", dreamer: \"It tastes like a Tuesday I forgot, or so the moon says.\", schemer: 'I detect nothing suspicious. That is very suspicious.', auntie: 'Oh, hon. Oh, I must tell someone about this soup.', hustler: 'I could sell this. No refunds.' }; const badLines = { hearth: \"…I've made a terrible mistake, mmhm. No. *You* have.\", sunshine: \"It's so… interesting! My mouth has gone away, isn't it?!\", grouch: \"I'd prefer not. I'd have preferred not.\", diva: \"Take me to the river. Not for dramatic reasons.\", gogetter: \"That's going straight to the… oh. Oh no.\", dreamer: 'I can see the moon. It is looking away.', schemer: \"This is how they get you. You didn't hear it from me.\", auntie: \"Well, hon. Somebody's going to hear about this.\", hustler: \"I wouldn't sell this. That has never happened.\" };\n  for (const n of tasters) { const a = NPC.actors[n]; a.play('Eat', { then: 'Idle', restart: true }); G.ctx.audio.play('eat'); if (!good) a.mood = 'queasy'; yield 0.4; yield say(n, (good ? goodLines : badLines)[CAST[n].type]); a.play(good ? 'Love' : 'ShakeHead', { then: 'Idle' }); }\n  if (good) { earn(w, 3000); for (const n of NEIGHBOURS) friendGain(w, n, 5); G.ctx.audio.play('applause'); yield say('dorrit', 'A feast, then. Everybody eats. Here, three thousand beans, from the whip-round. Don\\'t ask who whipped, mmhm.'); } else { w.gagGift = true; yield say('dorrit', \"Well. Nobody's dead. I've checked twice, mmhm. I'll send you something tomorrow. It's mostly a warning.\"); } G.view.town.remove(pot); G.fest = null; M.override = null; release(); bus.emit('festDone', 'soup', good);\n}\n// ---- The Long Night\nfunction* longNight() {\n  const w = G.world; const f = (G.fest = { id: 'longNight', stage: 'doors', doors: [], g: new THREE.Group() }); G.view.town.add(f.g); w.festival = { id: 'longNight', day: w.clock.day }; yield say('clementine', FESTIVAL_LINES.longNight[0]); yield say('clementine', FESTIVAL_LINES.longNight[1]); for (const n of NEIGHBOURS) { const st = w.npcs[n]; if (st.moved === 'gone' || st.moved === 'notyet') continue; const b = BUILDINGS.find((x) => x.id === (n === 'fitch' ? 'rocco' : n)); f.doors.push({ id: n, x: b.door[0], z: b.door[1] + 0.6, done: false, b }); } if (w.clock.minute < 16 * 60) w.clock.minute = 16 * 60; Toasts.add('Take the string to each door. Everyone gets a gift, and everyone gets you.', 6);\n}\nfunction doorLight(d) { const w = G.world, f = G.fest; Script.run((function* () { d.done = true; const mat = glowMaterial(PALETTE.sand), m2 = glowMaterial(PALETTE.red); const s = new THREE.Group(); for (let i = 0; i < 9; i++) { const l = new THREE.Mesh(new THREE.SphereGeometry(0.09, 4, 3), i % 2 ? mat : m2); l.position.set(d.b.x - 2.2 + i * 0.55, 2.3 + Math.sin(i) * 0.1, d.b.z + d.b.d / 2 + 0.1); s.add(l); } f.g.add(s); G.ctx.audio.play('pickup'); w.stats.doorsLit = (w.stats.doorsLit ?? 0) + 1; const st = w.npcs[d.id]; friendGain(w, d.id, 4); const lines = { hearth: 'Lights! Mmhm. Here, a pot of something, for the walk.', sunshine: \"It's so pretty, isn't it?! I got you a rock!\", grouch: \"I'd prefer not. …Leave them on, though.\", diva: 'At last, the estate is lit. Take this. It was a scarf. Not *that* scarf.', gogetter: '', dreamer: 'Each bulb is a very small moon. Have this page.', schemer: 'Who sent you? …Fine. Take this. You never had it.', auntie: \"Oh, hon. You've done my door crooked. I love it. Here, it's a mitten.\", hustler: 'Lights! Great. What do I owe you? Nothing? I like that. Here, a box.' }; yield say(d.id, lines[CAST[d.id].type] || 'Here. Thanks.'); giveItem(w, { id: 'pear', from: d.id }); bus.emit('doorLit', d.id); if (f.doors.every((x) => x.done)) { f.stage = 'pear'; Toasts.add('All the doors are lit. To the Old Pear.', 5); } })()); }\nfunction midnight() {\n  const w = G.world, f = G.fest; f.stage = 'finale'; Script.run((function* () {\n    gather(24, 39, 6); w.p.x = 24; w.p.z = 41.5; w.p.facing = Math.PI; w.clock.minute = 23 * 60 + 58; yield say('narrator', 'Everybody comes out. Nobody says why. It is nearly midnight.'); const rr = NPC.rt.rocco; if (w.npcs.rocco.moved === 'gone') { w.npcs.rocco.moved = 'visiting'; w.npcs.rocco.place = 'town'; rr.indoorLocal = false; rr.x = 24; rr.z = 47; rr.pause = 1e4; rr.path = null; rr.faceTo = [24, 38]; const rA = NPC.actors.rocco; rA.play('RoccoRoll'); yield 0.8; G.ctx.audio.play('roll'); rr.x = 26.5; rr.z = 42; rA.play('Wave', { then: 'Idle', restart: true }); yield say('rocco', \"I rolled here! From the next province! Did you start without me?! Let's roll!\", { actor: rA }); yield say('tavi', 'ROCCO!!! Isn\\'t it?!'); yield say('bartleby', \"…You're blocking the view. …Good to see you. I'd prefer not to discuss it.\"); w.flags.roccoReturned = true; bus.emit('roccoBack'); }\n    // The Old Pear lights up\n    const lights = new THREE.Group(); const mats = ['sand', 'red', 'lime', 'sky'].map((c) => glowMaterial(PALETTE[c])); const r = rngOf('pear'); for (let i = 0; i < 80; i++) { const m = new THREE.Mesh(new THREE.SphereGeometry(0.11, 4, 3), mats[i % 4]); const a = r.range(0, 6.28), rad = r.range(1.5, 3.1), y = r.range(3, 7.2); m.position.set(24 + Math.cos(a) * rad, y, 38 + Math.sin(a) * rad); lights.add(m); } G.view.town.add(lights); w.flags.pearLit = true; G.ctx.engine.screen.flash('white', { duration: 0.3 }); G.ctx.audio.play('fwBurst'); w.clock.minute = 0; yield 0.8; playChime(G.ctx.audio, w.chime, true); G.view.bellRing(); bus.emit('finaleBell'); for (const n of NEIGHBOURS) NPC.rt[n].act = 'Sway'; yield 3.4;\n    const [text, hint] = townRating(w); const high = (w.rating ?? 0) >= 60; yield say('clementine', `The town rating. I'll read it. ${text}`); if (high) { w.gotGold = true; w.flags.goldBell = true; G.view.setBellGold?.(); G.ctx.audio.play('reveal'); yield say('clementine', 'The bee says the Bell has gone gold. I went and checked. It has. It is fine. It is very fine.'); bus.emit('goldBell'); } else yield say('clementine', 'The bee says: next year. There is always next year. That is how it works.');\n    yield say('gander', w.p.debt > 0 ? `Happy new year, dear. You still owe ${fmt(w.p.debt)} beans. I wanted to be the first to say so.` : \"Happy new year, dear. You owe nothing. I don't care for it.\");\n    yield say('tavi', \"We're all still here, isn't it?!\"); yield say('dorrit', \"That's the idea, mmhm. There's soup.\");\n    w.year = Math.max(w.year, 2); w.flags.ending = (w.flags.ending ?? 0) + 1; w.stats.endings = (w.stats.endings ?? 0) + 1; bus.emit('ending');\n    const s = G.openCredits(); yield until(() => s.closed); G.view.town.remove(lights); G.view.town.remove(f.g); G.fest = null; M.override = null; release(); if (w.npcs.rocco.moved === 'visiting') { w.npcs.rocco.moved = 'gone'; NPC.rt.rocco.pause = 0; w.npcs.rocco.place = 'away'; } w.clock.minute = 60; w.mailQueue.push({ from: 'clementine', subject: 'Year Two', body: `${w.name}. It's the first of the year. Nothing has changed. The bee says that is the good news. Everything is where you left it. The Mayor has set out for the other side of the plaza. Clementine.`, at: w.clock.day + 1 }); G.sleepTo(0); bus.emit('yearTwo');\n  })());\n}\n// ---- Rocco\nfunction roccoLeaves() {\n  const w = G.world, st = w.npcs.rocco; w.flags.roccoGone = true; st.moved = 'gone'; st.place = 'away'; const best = st.friend >= 75; const argued = w.flags.roccoArgued; w.mail.push({ from: 'rocco', subject: 'From Rocco', body: `${w.name}! Gone rolling! ${argued ? \"You told me to stay. Nobody's ever told me that. I'm still going, but I rolled slower for the first bit.\" : 'Big hills out there! Somebody should see them!'} Keep up your rolls! Let's roll! Rocco.`, gift: best ? 'trophy_rocco' : null, read: false, day: w.clock.day }); remember(w, 'rocco'); bus.emit('roccoGone');\n  const f = w.npcs.fitch; f.moved = 'here'; f.place = 'h_fitch'; const b = BUILDINGS.find((x) => x.id === 'rocco'); b.modelOverride = 'cottage-fitch'; G.view.placeBuilding(b); NPC.goInside('fitch'); NPC.rt.fitch.indoorLocal = true; bus.emit('fitchHere');\n}\nexport const applyMovedState = () => { const w = G.world; if (w.flags.roccoGone) { const b = BUILDINGS.find((x) => x.id === 'rocco'); b.modelOverride = 'cottage-fitch'; G.view.placeBuilding(b); } };\nexport function roccoStory(id) {\n  const w = G.world, yd = info(w).storyYd;\n  if (id === 'rocco' && yd >= 7 && !w.flags.roccoTalk && !w.flags.roccoGone) return (function* () { w.flags.roccoTalk = true; const a = NPC.actors.rocco; yield say('rocco', \"Hey! So! I've been thinking! I know! Let's roll! | I've been the champion here nine years. There's nobody left to beat. I'm thinking… bigger hills. Saturday. Well. In a couple of days.\", { actor: a }); const p = yield ask('rocco', \"What do you reckon? Do I go?\", ['Stay. Please.', 'You should go', \"You've got this\"], { actor: a, cancel: 1 }); if (p === 0) { w.flags.roccoArgued = true; friendGain(w, 'rocco', 6); yield say('rocco', \"…Huh. Nobody's ever said that. I've got armour for most things. Not that. I'm still going! But huh.\", { actor: a }); } else yield say('rocco', \"Yeah! That's what I thought! Let's roll! …Yeah.\", { actor: a }); bus.emit('roccoTold'); })();\n  return null;\n}\n// ---- Contests\nfunction startContest(c) { const w = G.world, def = CONTEST[c]; w.contest = { id: c, day: w.clock.day, score: 0, best: null, done: false }; M.override = 'contest'; setTimeout0(() => { M.override = null; }, 8); bus.emit('contestStart', c); if (w.p.place === 'town') Script.run((function* () { yield say('clementine', `The ${def.name} has begun. ${def.rule}. You have until one o'clock. Nobody is timing you. I am timing you.`); })()); else Toasts.add(`The ${def.name} has begun!`, 5); }\nbus.on?.('x', () => {});\nexport function contestCaught(it) { const w = G.world, c = w.contest; if (!c || c.done || c.day !== w.clock.day) return; if (c.id === 'derby' && it.cat === 'fish') { if (!c.best || it.price > ITEMS[c.best].price) { c.best = it.id; c.score = it.price; Toasts.add(`New biggest fish: ${it.name}!`); } } if (c.id === 'bugoff' && it.cat === 'bug') { c.score += it.price; Toasts.add(`Bug-Off total: ${fmt(c.score)}`); } }\nexport function snowProportion(body, head) { const ratio = head / Math.max(0.01, body); return clamp(Math.round(100 - Math.abs(ratio - 0.72) * 200), 0, 100); }\nexport function endContest() {\n  const w = G.world, c = w.contest; if (!c || c.done) return; c.done = true; const def = CONTEST[c.id]; const r = rngOf(`${w.seed}:contest:${c.id}:${w.clock.day}`); const rivals = NEIGHBOURS.filter((n) => !['gone', 'notyet'].includes(w.npcs[n].moved)).slice(0, 5).map((n) => { let score; if (c.id === 'derby') { const list = FISH_LIST.filter((f) => f.seasons.includes(String(info(w).season))); const k = r.int(1, 4); score = 0; for (let i = 0; i < k; i++) score = Math.max(score, r.pick(list).price); } else if (c.id === 'bugoff') { const list = BUG_LIST.filter((f) => f.seasons.includes(String(info(w).season)) && !f.rare); score = 0; const k = r.int(2, 6); for (let i = 0; i < k; i++) score += r.pick(list).price; } else score = r.int(30, 92); return { n, score }; }); if (c.id === 'snowman') { c.score = Math.max(c.score, ...Object.values(w.ents).filter((e) => e.t === 'snowman').map((e) => e.score ?? 0), 0); } const you = { n: 'you', score: c.score }; const table = [...rivals, you].sort((a, b) => b.score - a.score); const place = table.indexOf(you) + 1; c.place = place; c.table = table; w.stats[`contest_${c.id}`] = place; if (place <= 3 && c.score > 0) { const trophy = def.trophy; w.mailQueue.push({ from: 'clementine', subject: `${def.name}: Result`, body: `You came ${['first', 'second', 'third'][place - 1]}. ${place === 1 ? 'There is a trophy. It is heavy. The bee helped carry it.' : 'There is a small trophy. It is mostly a compliment.'} Clementine.`, gift: trophy, at: w.clock.day + 1 }); } bus.emit('contestEnd', c.id, place); const top = table.slice(0, 3).map((e, i) => `${i + 1}. ${e.n === 'you' ? 'You' : nameOf(e.n)} (${fmt(e.score)})`).join('   ');\n  const judge = c.id === 'snowman' ? 'bartleby' : 'clementine'; const intro = c.id === 'snowman' ? \"I've been asked to judge. I'd prefer not. They all look like snowmen.\" : `Time. The ${def.name} is over. It was fine.`; if (w.p.place === 'town' || w.p.place === 'hall') Script.run((function* () { yield say(judge, `${intro} | ${top}`); })()); else Toasts.add(`${def.name}: you came ${place}.`, 6);\n}\nbus.on('caught', () => {});\n// ---- Snow\nG.tryStackSnow = (e) => { const w = G.world; for (const o of Object.values(w.ents)) { if (o === e || o.t !== 'snowball') continue; if (dist2(e.x, e.z, o.x, o.z) < 3.2) { const body = Math.max(e.size, o.size), head = Math.min(e.size, o.size); removeEnt(w, o); const x = e.x, z = e.z; removeEnt(w, e); const score = snowProportion(body, head); addEnt(w, { t: 'snowman', x, z, score, head, body }); G.ctx.audio.play('reveal'); G.ctx.particles.burst('sparkle', [x, 1.4, z]); w.stats.snowmen = (w.stats.snowmen ?? 0) + 1; bus.emit('snowman', score); Script.run((function* () { yield say('narrator', score >= 70 ? `\"Oh, these are good proportions. I feel balanced. I'll write.\" (${score}/100)` : score >= 40 ? `\"My head's a bit… no, it's fine. It's fine. I'm a snowman.\" (${score}/100)` : `\"What have you done? Look at me. Look at the size of me.\" (${score}/100)`, { name: 'The Snowman' }); })()); if (score >= 70) w.mailQueue.push({ from: 'narrator', subject: 'From the Snowman', body: 'Thank you for the proportions. I can feel myself going. Have this. Keep it cold. Yours, Snowman.', gift: 'snowman_gift', at: w.clock.day + 1 }); return; } } };\nG.snowmanTalk = (e) => Script.run((function* () { yield say('narrator', e.score >= 70 ? 'It looks peaceful. It looks like it knows what spring is.' : 'It stares. You did this.', { name: 'The Snowman' }); })());\n// ---- Stars\nG.stargaze = (bench) => { const w = G.world; G.player.state = 'sit'; G.player.actor.play('Sit'); const s = starScreen(); UI.push(s); w.stats.stargazed = (w.stats.stargazed ?? 0) + 1; bus.emit('stargaze'); };\nfunction starScreen() { const w = G.world, r = rngOf(`stars:${w.clock.day}`); const stars = Array.from({ length: 150 }, () => [r.int(0, 479), r.int(0, 240), r.pick(['white', 'mist', 'sky'])]); const cons = CONSTELLATIONS.map((c, i) => ({ ...c, ox: 40 + (i % 3) * 145, oy: 30 + Math.floor(i / 2) * 60 })); return { id: 'stars', title: 'The Lookout', t2: 0, next: 3, shoot: null, freezes: false, opaque: true, get prompts() { return this.shoot ? [['confirm', 'Wish!']] : [['back', 'Stand up']]; }, focusLabel: () => 'sky', input(c, dt) { this.t2 += dt; this.next -= dt; if (this.next <= 0 && !this.shoot) { this.shoot = { x: r.int(120, 450), y: r.int(10, 80), t: 1.4 }; this.next = r.range(5, 11); G.ctx.audio.play('starFall'); G.starNow = true; } if (this.shoot) { this.shoot.t -= dt; this.shoot.x -= dt * 180; this.shoot.y += dt * 70; if (c.confirm() || c.clickL()) { w.wishes.push({ gift: r.pick(['wish_star', 'shell_pearl', 'h_crown', 's_sky', 'bag']) }); w.stats.wished++; G.ctx.audio.play('wish'); Toasts.add('You wished. A present arrives in the morning.'); bus.emit('wish'); this.shoot = null; G.starNow = false; } else if (this.shoot.t <= 0) { this.shoot = null; G.starNow = false; } } if (c.back()) { UI.pop(this); G.player.state = 'free'; G.player.actor.play('Idle'); } }, draw(h) { h.rect(0, 0, 480, 270, 'night'); for (const [x, y, col] of stars) h.rect(x, y, 1, 1, Math.sin(this.t2 * 2 + x) > 0.9 ? 'night' : col); cons.forEach((c0, i) => { const pts = c0.pts.map(([a, b]) => [c0.ox + a * 26, c0.oy + b * 26]); for (let k = 0; k < pts.length - 1; k++) { for (let t = 0; t <= 8; t++) h.rect(Math.round(lerp(pts[k][0], pts[k + 1][0], t / 8)), Math.round(lerp(pts[k][1], pts[k + 1][1], t / 8)), 1, 1, 'slate'); } for (const [a, b] of pts) h.rect(a, b, 2, 2, 'white'); drawText(h, c0.ox, c0.oy + 42, w.almanac.stars[c0.id]?.name ?? c0.name, { color: 'mist' }); }); if (this.shoot) { for (let t = 0; t < 8; t++) h.rect(Math.round(this.shoot.x + t * 3), Math.round(this.shoot.y - t), 2, 1, t < 3 ? 'white' : 'sand'); promptRow(h, 240, 246, [['confirm', 'Wish!']], { align: 'center', back: 'ink' }); } else promptRow(h, 240, 246, [['back', 'Stand up']], { align: 'center', back: 'ink' }); h.rect(0, 255, 480, 15, 'ink'); } }; }\n// ---- Credits and the almanac of your year\nconst CREDITS_TEXT = (w) => { const s = w.stats; const most = Object.entries(s.talked).sort((a, b) => b[1] - a[1])[0]; return [`The Almanac of Your Year`, `Biggest catch: ${ITEMS[s.biggest]?.name ?? 'an old boot, spiritually'}`, `Sold to Mrs. Gander: ${fmt(s.sold)} beans`, `Debt: ${w.p.debt ? `${fmt(w.p.debt)} beans. She says hello.` : 'none. She is taking it badly.'}`, `Talked to most: ${most ? nameOf(most[0]) : 'nobody. Fair enough.'}`, `Museum pieces: ${museumCount(w)}`, `Town rating: ${w.rating ?? 'unread'}`, w.flags.goldBell ? 'The Old Bell went gold.' : 'The Old Bell is still bronze. It is fine.', '', 'Silly Folk', 'Written and built by an AI with a very small goose', 'Mrs. Gander as herself. Mayor Trundle, arriving shortly.', 'Hester, on the bus. Vesper, on the lamp post.', 'Thanks for visiting. Nothing was ever urgent.', '', 'Year Two begins in the morning.']; };\nG.openCredits = () => { const w = G.world; M.override = 'credits'; const lines = CREDITS_TEXT(w); const s = { id: 'credits', title: 'Credits', y: 280, closed: false, opaque: true, freezes: true, get prompts() { return [['confirm', 'Skip']]; }, focusLabel: () => 'credits', itemsModel() { return lines.slice(); }, input(c, dt) { this.y -= dt * 22; if (this.y < -lines.length * 18 - 20 || ((c.confirm() || c.back()) && (this.t > 1))) { this.closed = true; UI.pop(this); M.override = null; } }, draw(h) { h.rect(0, 0, 480, 270, 'night'); lines.forEach((l, i) => drawText(h, 240, Math.round(this.y + i * 18), l, { color: i === 0 || l === 'Silly Folk' ? 'sand' : 'white', align: 'center', scale: i === 0 || l === 'Silly Folk' ? 2 : 1 })); promptRow(h, 470, 252, [['confirm', 'Skip']], { align: 'right', back: 'ink' }); } }; UI.push(s); return s; };\nE\ncat > src/systems/dayone.js <<'E'\n// The first twenty minutes: the bus in the rain, the goose, and seven errands that teach every verb.\nimport { G, bus } from '../state.js';\nimport { Script, say, ask, Toasts, until } from '../ui/dialogue.js';\nimport { UI, panel, hit, promptRow } from '../ui/kit.js';\nimport { drawText, textWidth } from '../ui/font.js';\nimport { keyboardScreen } from '../ui/screens.js';\nimport { NPC } from '../actors/npcs.js';\nimport { HOSTS_TALK } from './talk.js';\nimport { setPlace, Trans } from '../world/places.js';\nimport { LANDMARK } from '../world/layout.js';\nimport { ITEMS, TOOL_ORDER } from '../data/items.js';\nimport { giveItem, hasItem, takeItem, earn, addEnt, remember, friendGain, addLetter } from '../core/world.js';\nimport { equip } from './interact.js';\nimport { T } from '../dev/tuning.js';\nimport { upgradeHome, letterFlow } from './services.js';\nimport { Nature } from './nature.js';\nimport { rngOf, fmt } from '../core/util.js';\nimport { M } from '../audio/music.js';\nimport { HAIRS } from '../art/critter.js';\nexport const ERRANDS = [['parcel', 'Fetch a parcel from Dorrit'], ['weed', 'Pull a weed, sell it at the store'], ['bug', 'Catch a butterfly for Tavi'], ['fish', 'Catch Bartleby a fish'], ['dig', 'Dig the crack on the plaza'], ['water', \"Water the Mayor's sapling\"], ['letter', 'Write to Gran at the Post']];\nconst PAY = 286;\nconst NAME_IDEAS = ['Pat', 'Morgan', 'Ash', 'Robin', 'Sam', 'Quinn', 'Jo', 'Toby', 'Wren', 'Bean'];\nconst TOWN_IDEAS = ['Lesser Wallop', 'Mudford', 'Nowhere-on-Sea', 'Tiddling', 'Upper Regret', 'Puddock', 'Little Fuss'];\nfunction done(k) { const w = G.world; const d = w.day1; if (d[k + 'Done']) return; d[k + 'Done'] = true; w.p.debt = Math.max(0, w.p.debt - Math.round(PAY * T.debt)); w.p.paidTotal += PAY; G.ctx.audio.play('reveal'); Toasts.add(`Errand done. ${fmt(PAY)} beans off your debt.`, 3.5); bus.emit('errand', k); if (ERRANDS.every(([e]) => d[e + 'Done'])) Script.run(evening()); }\nexport const errandsLeft = () => { const d = G.world.day1; return ERRANDS.filter(([k]) => !d[k + 'Done']); };\nexport function drawErrands(h, y = 28) { const w = G.world; if (!w.day1 || w.day1.done || !w.day1.started) return; const left = ERRANDS; const pw = 196, ph = 10 + left.length * 12 + 12; panel(h, 472 - pw, y, pw, ph, { fill: 'white' }); drawText(h, 472 - pw + 8, y + 5, \"Today's errands\", { color: 'navy' }); left.forEach(([k, label], i) => { const dn = w.day1[k + 'Done']; drawText(h, 472 - pw + 8, y + 18 + i * 12, (dn ? '✕ ' : '· ') + label, { color: dn ? 'mist' : 'ink' }); }); }\nfunction* evening() { const w = G.world; if (w.day1.done) return; w.day1.done = true; w.clock.speedHalf = false; if (w.clock.minute < 18 * 60) w.clock.minute = 18 * 60; yield 0.4; yield say('gander', `You've paid off 2,000 beans. You're free to go. Not that you were ever not free. Legally.`); yield say('gander', 'The roof has been installed. It is included. The bed is in. The rain is complimentary. Do use the bed, dear. It saves everything.'); w.flags.roofOn = true; bus.emit('dayOneDone'); }\nexport function finishDayOne() { const w = G.world; for (const [k] of ERRANDS) w.day1[k + 'Done'] = true; w.day1.done = true; w.clock.speedHalf = false; }\n// ---- The opening: bus, name, look\nexport function openingScript(world, opts) {\n  return (function* () {\n    const w = G.world; M.override = 'bus'; G.player.actor.visible = false; G.view.town.visible = false; w.clock.frozen = true; G.opening = { t: 0 };\n    const answers = {}; yield 1;\n    yield say('hester', 'End of the line? Nobody gets off there on purpose.', { name: 'The Driver' });\n    yield say('hester', 'Hester. I drive the bus. I only drive the bus. Who are you, then?');\n    let name = null; UI.push(keyboardScreen({ title: 'Your name', initial: '', max: 12, suggest: () => rngOf(`${G.time}`).pick(NAME_IDEAS), onDone: (t) => { name = t; }, opaque: false })); yield until(() => name); w.name = name;\n    yield say('hester', `${name}. Right. And what's the town called, ${name}? I only drive the bus.`);\n    let town = null; UI.push(keyboardScreen({ title: 'Name the village', initial: '', max: 16, suggest: () => rngOf(`${G.time}t`).pick(TOWN_IDEAS), onDone: (t) => { town = t; }, opaque: false })); yield until(() => town); w.town = town;\n    yield say('hester', `${town}. Never heard of it. That's the good news.`);\n    const a1 = yield ask('hester', 'What are you running from?', ['A family business', 'A bad haircut', 'My own potential', 'Nothing. Why? Who said?'], {});\n    const a2 = yield ask('hester', 'Favourite weather?', ['Rain', 'Fog', 'Sun, in moderation', 'Thunder, at a distance'], {});\n    const a3 = yield ask('hester', 'How do you take bad news?', ['With a nod', 'With soup', 'I hide', 'I bill someone'], {});\n    w.p.look.hair = [0, 3, 2, 5][a1]; w.p.look.hairColor = ['orange', 'plum', 'ink', 'red'][a2]; w.p.look.eyes = [0, 4, 3, 2][a3]; G.player.rebuild(); answersReflect(answers);\n    yield say('hester', \"There's a reflection in the window there, if you can stand it. You look like someone who owes money.\");\n    const s = reflectScreen(); UI.push(s); yield until(() => s.closed);\n    yield say('hester', 'End of the line. Mind the step. There is no step. Mind it anyway.');\n    let ok = false; Trans.go(() => { M.override = null; G.opening = null; w.clock.frozen = false; G.player.actor.visible = true; G.view.town.visible = true; setPlace('town', LANDMARK.busStop[0], LANDMARK.busStop[1] + 1, 0); ok = true; }); yield until(() => ok); yield 0.3;\n    const g = NPC.rt.gander; g.staffOut = [LANDMARK.busStop[0] + 1.6, LANDMARK.busStop[1] + 1.2]; g.force = [g.staffOut[0], 0, g.staffOut[1]]; NPC.rt.gander.talkTo = true; G.focusZoom = 2.1;\n    yield say('gander', \"You're late. No, you're exactly on time. I've already billed you for being late.\", { actor: NPC.actors.gander });\n    yield say('gander', \"Mrs. Gander. I hold the note on your shack. It's the one at the far end of the village, with no roof. The roof is included. The rain is complimentary. The 8,000 beans are not.\", { actor: NPC.actors.gander });\n    upgradeHome(1); w.p.debt = Math.round(8000 * T.debt); w.flags.intro = true; w.p.look.shirt = 's_apron'; G.player.rebuild(); w.day1.started = true; bus.emit('arrived');\n    yield say('gander', \"Apron on. You'll work it off. I've made a list. Take your time. I've noted how much.\", { actor: NPC.actors.gander });\n    g.force = null; g.talkTo = false; G.focusZoom = null; Toasts.add('Errands: see the list. The clock runs at half speed until they’re done.', 5);\n  })();\n}\nconst answersReflect = () => {};\nfunction reflectScreen() { const w = G.world; const rows = [['Hair', 'hair', HAIRS.map((_, i) => i), (v) => HAIRS[v]], ['Colour', 'hairColor', ['orange', 'ink', 'sand', 'red', 'plum', 'blue', 'white', 'lime'], (v) => v], ['Eyes', 'eyes', [0, 1, 2, 3, 4, 5], (v) => ['Dots', 'Tall', 'Wide', 'Sleepy', 'Sparkly', 'Crossed'][v]]]; return { id: 'reflect', title: 'Your reflection', focus: 0, closed: false, freezes: true, spin: 0, opaque: true, get prompts() { return [['confirm', 'That will do']]; }, focusLabel() { return rows[this.focus][0]; }, itemsModel() { return rows.map((r) => r[0]); }, input(c, dt) { const n = c.nav; if (n === 'up') this.focus = (this.focus + 2) % 3; if (n === 'down') this.focus = (this.focus + 1) % 3; const r = rows[this.focus]; if (n === 'left' || n === 'right') { const i = r[2].indexOf(w.p.look[r[1]]); w.p.look[r[1]] = r[2][(i + (n === 'left' ? r[2].length - 1 : 1)) % r[2].length]; G.player.rebuild(); UI.sfx('uiTick'); } if (c.confirm() || c.clickL()) { this.closed = true; UI.pop(this); } }, draw(h) { h.rect(0, 0, 480, 270, 'navy'); for (let i = 0; i < 26; i++) { const y = (i * 37 + Math.floor(UI.time * 70)) % 270, x = (i * 91) % 480; h.rect(x, y, 1, 6, 'blue'); } panel(h, 120, 30, 240, 170); drawText(h, 240, 38, 'A reflection, in a bus window, in the rain', { color: 'navy', align: 'center' }); G.drawAvatarCard?.(h, 186, 58); rows.forEach((r, i) => { const f = i === this.focus, y = 140 + i * 18; if (f) h.rect(128, y - 3, 224, 16, 'navy'); drawText(h, 136, y, r[0], { color: f ? 'white' : 'ink' }); drawText(h, 344, y, `← ${r[3](w.p.look[r[1]])} →`, { color: f ? 'sand' : 'slate', align: 'right' }); }); promptRow(h, 240, 206, [['confirm', 'That will do']], { align: 'center', back: 'ink' }); } }; }\n// ---- Errand conversations\nexport function storyTalk(id) {\n  const w = G.world, d = w.day1; if (!d || d.done) return null; const a = NPC.actors[id];\n  if (id === 'dorrit' && !d.parcel) return (function* () { d.parcel = true; yield say(id, 'You look peaky, mmhm. You must be the new one. I made soup. It\\'s Tuesday\\'s. Tuesday was a good day for soup, mmhm.', { actor: a }); yield say(id, \"Take this parcel to the goose. It's her waistcoat buttons. Don't shake it. Don't sniff it. Do sniff the soup.\", { actor: a }); giveItem(w, { id: 'parcel', to: 'gander' }); Toasts.add('Got the Parcel. Take it to Mrs. Gander, at the store.'); w.npcs.dorrit.lastTalk = w.clock.day; friendGain(w, id, 3); bus.emit('talked', id); })();\n  if (id === 'tavi' && !d.bugGiven) return (function* () { d.bugGiven = true; yield say(id, \"Hi hi hi! You're new! I love you! I've got a net! It's for you! I don't know why I had it!\", { actor: a }); w.p.tools.includes('net') || w.p.tools.push('net'); equip('net'); yield say(id, \"Press and hold to get ready, let go to swing! Walk soft, or they get scared, isn't it?! There's a butterfly! Catch it! Don't tell it I said!\", { actor: a }); const it = ITEMS.cabbagefly; Nature.spawnBug(it, w.p.x + 2.4, w.p.z + 1.4, 0.8, 'flower'); w.npcs.tavi.lastTalk = w.clock.day; friendGain(w, id, 3); bus.emit('talked', id); })();\n  if (id === 'tavi' && d.bugGiven && !d.bugDone && d.bug) return (function* () { const i = hasItem(w, 'cabbagefly'); yield say(id, \"You did it! You caught it! Now you can keep it, isn't it?! I'm so proud! I hardly know you!\", { actor: a }); done('bug'); })();\n  if (id === 'bartleby' && !d.fishGiven) return (function* () { d.fishGiven = true; yield say(id, \"Rod? I've got a rod. I'd prefer not. No. Take it. You can catch me a fish. Don't make it a thing.\", { actor: a }); w.p.tools.includes('rod') || w.p.tools.push('rod'); equip('rod'); yield say(id, \"Stand by the water. Cast. Wait for the big bite, not the little ones. Press again when it goes under. You'll work it out. Go away.\", { actor: a }); w.npcs.bartleby.lastTalk = w.clock.day; bus.emit('talked', id); })();\n  if (id === 'bartleby' && d.fishGiven && !d.fishDone && w.p.pockets.some((e) => e && ITEMS[e.id]?.cat === 'fish')) return (function* () { const i = w.p.pockets.findIndex((e) => e && ITEMS[e.id]?.cat === 'fish'); const it = ITEMS[w.p.pockets[i].id]; w.p.pockets[i] = null; yield say(id, `${/^[AEIOU]/.test(it.name) ? 'An' : 'A'} ${it.name.toLowerCase()}. Fine. I didn't ask for one. I did. I'd prefer not to discuss it.`, { actor: a }); done('fish'); friendGain(w, id, 5); })();\n  return null;\n}\nexport function wireDayOne() {\n  const prevG = HOSTS_TALK.gander, prevT = HOSTS_TALK.trundle, prevC = HOSTS_TALK.clementine;\n  HOSTS_TALK.gander = function* (actor) { const w = G.world, d = w.day1; if (d && !d.done) { const i = w.p.pockets.findIndex((e) => e?.id === 'parcel' && e.to === 'gander'); if (i >= 0) { w.p.pockets[i] = null; yield say('gander', \"My buttons. On time, for once. Well. In a sense. There. That's a little off your account, dear. Don't spend it all on breathing.\", { actor }); done('parcel'); } } yield* prevG(actor); };\n  HOSTS_TALK.trundle = function* (actor) { const w = G.world, d = w.day1; if (d && !d.done && !w.p.tools.includes('shovel')) { yield say('trundle', \"Ah… you're… the new… one. I'm on… my way… somewhere. Have… my shovel.\", { actor }); w.p.tools.push('shovel'); equip('shovel'); yield say('trundle', 'There\\'s a… crack… on the plaza. Star… shaped. Dig it. Stand… in front. I\\'ll… wait.', { actor }); return; } yield* prevT(actor); };\n  HOSTS_TALK.clementine = function* (actor) { const w = G.world, d = w.day1; if (d && !d.done) { if (!w.p.tools.includes('can')) { yield say('clementine', \"Welcome. It's fine here. Everything is. The bee says you'll want this watering can. The Mayor's sapling is by the pond. It looks thirsty. It's been fine about it.\", { actor }); w.p.tools.push('can'); equip('can'); } if (!d.letterDone) { const p = yield ask('clementine', 'You could write to your gran, while you are here. She has written to ask if you are dead.', ['Write to Gran', 'Not yet'], { actor, cancel: 1 }); if (p === 0) { const before = w.stats.letters; let text = null; UI.push(keyboardScreen({ title: 'Dear Gran…', max: 90, lines: true, onDone: (t) => { text = t; }, onCancel: () => { text = false; } })); yield until(() => text !== null); if (text) { G.ctx.audio.play('stamp'); w.stats.letters++; remember(w, 'letter', { to: 'gran', snip: text.slice(0, 18) }); addLetter(w, { from: 'gran', subject: 'From Gran', body: `Dear ${w.name}. You wrote: \"${text.slice(0, 40)}\". I've read worse. I've written worse. Here's some fruit. Gran.`, gift: 'fig' }); bus.emit('letter', 'gran', text); addLetter(w, { from: 'dorrit', subject: 'From Dorrit', body: `Welcome, ${w.name}, mmhm. I've left soup somewhere near you. You'll know. Dorrit.`, gift: 'pear' }); yield say('clementine', \"Your letter's stamped. A bee has been living in the stamp drawer. We've agreed to share.\", { actor }); done('letter'); return; } } } } yield* prevC(actor); };\n  bus.on('weed', () => { const d = G.world.day1; if (d && !d.done) { d.weed = true; Toasts.add('Now sell it to Mrs. Gander. She will take anything. It is her whole deal.'); } });\n  bus.on('sold', (it) => { const d = G.world.day1; if (d && !d.done && it.id === 'weed') done('weed'); });\n  bus.on('caught', (it) => { const d = G.world.day1; if (!d || d.done) return; if (it.cat === 'bug') { d.bug = true; if (d.bugGiven && !d.bugDone) done('bug'); } if (it.cat === 'fish') { d.fish = true; Toasts.add('Take it to Bartleby. He would prefer you did not.'); } });\n  bus.on('dug', () => { const d = G.world.day1; if (d && !d.done) { G.world.flags.day1Fossil = true; done('dig'); } });\n  bus.on('watered', (e) => { const d = G.world.day1; if (d && !d.done && e.mayor) done('water'); });\n}\nE\ncat >> ../PROGRESS.md <<'E'\nDone: systems/year, systems/dayone. Next: ui/shell (title, pause, settings, dev, about, attract), game.js, main.js; net (hub round + visit); tests; polish; exit-interview.\nE","description":"Write the year, festivals, contests and Day One"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16873,"cache_read_input_tokens":460847,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16873},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f147b5a-afdb-41c5-bbfc-62264f8c7cee","uuid":"a41f5b25-ed80-4477-9f3e-0b8c30ce9fd9","timestamp":"2026-11-06T01:09:31.047Z","request_id":"req_011CgkmyU1Q6f39j2vuQVTrs","wire_tool_inputs":{"toolu_01RFtaTEgLfd6Fz4xp1dNxzz":{"command":"cat > src/systems/year.js <<'E'\n// The sixteen-day year: hourly beats, festivals, contests, Vesper, cheese, Rocco's story, snow, stars, the ending, Inspector Pimm.\nimport { THREE, buildModel, toonMaterial, glowMaterial, PALETTE, setLookLayer } from '../engine.js';\nimport { G, bus } from '../state.js';\nimport { HOSTS_TALK } from './talk.js';\nimport { Script, say, ask, Toasts, until, fill } from '../ui/dialogue.js';\nimport { HOSTS, FESTIVAL_LINES, TYPE_LINES } from '../data/lines.js';\nimport { UI, panel, promptRow, menu, hit, hitAt, dim, para } from '../ui/kit.js';\nimport { drawText, wrap, textWidth, LINE_H } from '../ui/font.js';\nimport { keyboardScreen, pocketsScreen, CONSTELLATIONS, readLetter, patternStudio } from '../ui/screens.js';\nimport { ITEMS, SONG_RECORDS, FISH_LIST, BUG_LIST } from '../data/items.js';\nimport { T } from '../dev/tuning.js';\nimport { earn, giveItem, remember, info, addEnt, removeEnt, entAt, isFree, friendGain, addLetter, hasItem, takeItem, museumCount } from '../core/world.js';\nimport { fmt, rngOf, clamp, lerp, dist2, fmtTime } from '../core/util.js';\nimport { hourOf, SEASON_NAMES, DAY_TYPES, weatherNow } from '../core/calendar.js';\nimport { NPC } from '../actors/npcs.js';\nimport { CAST, NEIGHBOURS, nameOf } from '../data/cast.js';\nimport { setPlace, Trans, rebuildRoom } from '../world/places.js';\nimport { LANDMARK, BUILDINGS } from '../world/layout.js';\nimport { M, playChime } from '../audio/music.js';\nimport { speakChar } from '../audio/voice.js';\nimport { cheesePrice } from './days.js';\nimport { townRating } from './services.js';\nimport { addTargets, setTimeout0 } from './interact.js';\nimport { Nature, collect } from './nature.js';\nimport { Actor } from '../actors/actor.js';\nimport { critterDef } from '../art/critter.js';\nconst R = () => rngOf(`${G.world.seed}:y:${G.world.clock.day}:${G.world.clock.minute}:${G.time}`);\nconst line = (arr) => R().pick(arr);\nexport const YI = { rindHere: false, vesperHere: false, cheesePrice: 100 }; G.yearInfo = YI;\nconst CONTEST = { derby: { name: 'Fishing Derby', from: 10, to: 13, rule: 'Biggest fish wins', trophy: 'trophy_fish' }, bugoff: { name: 'Bug-Off', from: 10, to: 13, rule: 'Most value wins', trophy: 'trophy_bug' }, snowman: { name: 'Snowman Contest', from: 10, to: 13, rule: 'Best proportions win. Bartleby judges. He would prefer not.', trophy: 'trophy_snow' } };\nexport const FEST_BY_YD = { 4: 'seedToss', 8: 'lantern', 12: 'soup', 16: 'longNight' };\nexport const CONTEST_BY_YD = { 6: 'derby', 10: 'bugoff', 14: 'snowman' };\n// ---- The clock calls this on every new hour.\nexport function onHour(h) {\n  const w = G.world, inf = info(w);\n  YI.rindHere = inf.slot === 0 && h >= 6 && h < 12; if (G.view.rindStall) G.view.rindStall.visible = YI.rindHere;\n  YI.vesperHere = inf.slot === 2 && h >= 20 && h < 24; syncVesper();\n  ITEMS.cheesewheel.price = cheesePrice(w); YI.cheesePrice = ITEMS.cheesewheel.price;\n  if (h === 9) { const due = w.mailQueue.filter((m) => m.at <= w.clock.day); if (due.length) { for (const m of due) { w.mail.push({ ...m, read: false, day: w.clock.day }); if (m.giftValue) m.onBag = true; } w.mailQueue = w.mailQueue.filter((m) => m.at > w.clock.day); G.ctx.audio.play('mailFlag'); Toasts.add('The postbox flag has gone up.'); bus.emit('mail'); } }\n  if (w.p.buffs.coffee && h >= 12) { delete w.p.buffs.coffee; Toasts.add('The coffee wears off. Your legs file a complaint.'); }\n  // the Bell plays your Chime on the hour\n  if (w.p.place === 'town') { G.view.bellRing(); playChime(G.ctx.audio, w.chime); bus.emit('bellRung'); w.stats.bells = (w.stats.bells ?? 0) + 1; }\n  // Contests\n  const c = CONTEST_BY_YD[inf.storyYd] ?? inf.contest; if (c && !G.demo && !w.day1Pending) { const def = CONTEST[c]; if (h === def.from && (!w.contest || w.contest.day !== w.clock.day)) startContest(c); if (h === def.to && w.contest?.day === w.clock.day && !w.contest.done) endContest(); }\n  // Show Day nights: the Bureau scores\n  if (inf.slot === 2 && h === 22) G.bureauMail?.(w);\n  // Lantern Float fireworks\n  if (G.fest?.id === 'lantern' && h === 21 && !G.fest.fired) { G.fest.fired = true; fireworkShow(); }\n  bus.emit('hour', h);\n}\n/** The morning after: story beats follow days played. */\nexport function onMorning() {\n  const w = G.world, inf = info(w), yd = inf.storyYd, r = R();\n  for (const k of ['seedToss', 'lantern', 'soup', 'longNight']) if (w.festival?.id === k && w.festival.day < w.clock.day) w.festival = null;\n  if (G.fest) G.fest = null;\n  if (w.day1 && !w.day1.done && w.clock.day >= 3) finishDayOne();\n  if (yd === 7 && w.year === 1 && !w.flags.roccoTalk) { w.flags.roccoHint = true; }\n  if (yd === 9 && !w.flags.roccoGone) roccoLeaves();\n  if (yd === 15 && !w.flags.roccoLetter) { w.flags.roccoLetter = true; w.mail.push({ from: 'rocco', subject: 'From Rocco', body: `${w.name}! Big hills out here! BIG! I rolled up one and it took three days! I won't lie, I miss the dents. I'm rolling back for the Long Night. Don't tell Tavi. Tell Tavi. Let's roll!`, read: false, day: w.clock.day }); G.ctx.audio.play('mailFlag'); }\n  if (yd === 3 && !w.flags.chimeAsked) { w.flags.chimeAsked = true; w.mail.push({ from: 'clementine', subject: 'From the Town Hall', body: `The Bell has played one note since the Mayor's cousin. Come and write it something. Any time. Today would be fine. Everything is fine. Clementine.`, read: false, day: w.clock.day }); }\n  if (yd === 2 && !w.flags.museumNote) { w.flags.museumNote = true; w.flags.museumOpen = true; w.mail.push({ from: 'quill', subject: 'From the Museum', body: `It's open! Or it's a very large shed! Bring your fossil! Bring anything! Bring a lamp, I can't find the lamp! Dr. Quill.`, read: false, day: w.clock.day }); }\n  if (inf.season === 3 && r) { for (let i = 0; i < 3; i++) { const tx = r.int(46, 76), tz = r.int(26, 46); if (isFree(w, tx, tz, 0)) addEnt(w, { t: 'snowball', x: tx + 0.5, z: tz + 0.5, size: 0.5 }); } for (let i = 0; i < 3; i++) { const tx = r.int(3, 36), tz = r.int(26, 46); if (isFree(w, tx, tz, 0)) addEnt(w, { t: 'snowball', x: tx + 0.5, z: tz + 0.5, size: 0.5 }); } }\n  if (w.festival?.bloom) { for (const [x, z, c] of w.festival.bloom) { const tx = Math.floor(x), tz = Math.floor(z); if (isFree(w, tx, tz, 0)) addEnt(w, { t: 'flower', sp: 'tulip', c, x: tx + 0.5, z: tz + 0.5, dry: 0, wet: 1 }); } w.flags.bloomed = true; w.festival = null; Toasts.add('The plaza has bloomed in the pattern you sowed.'); }\n  if (w.gagGift) { w.mail.push({ from: 'dorrit', subject: 'From Dorrit', body: \"I'm sorry about the soup, mmhm. Everyone's fine. Mostly. Here's the lid. Keep it. We don't want it back.\", gift: 'box', read: false, day: w.clock.day }); w.gagGift = false; }\n  const inFest = FEST_BY_YD[yd]; const c = CONTEST_BY_YD[yd]; G.dayTitle = `${SEASON_NAMES[inf.season]} · ${inf.type}`; const msg = inFest ? { seedToss: 'Today: The Seed Toss. Everyone to the plaza.', lantern: 'Today: The Lantern Float. At dusk, at the north bridge.', soup: \"Today: The Great Soup. Dorrit's pot is on the plaza.\", longNight: 'Today: The Long Night. The sun sets at four.' }[inFest] : c ? `Today: the ${CONTEST[c].name}, from 10 until 1.` : inf.slot === 2 ? 'Vesper plays tonight on the plaza, at eight.' : inf.slot === 0 ? 'Old Rind is on the plaza this morning. Follow your nose.' : null; if (msg) Toasts.add(msg, 5); bus.emit('morning', yd);\n}\n// ---- Notice board\nG.readNotice = () => { const w = G.world, inf = info(w); const c = w.cheese; const yd = inf.storyYd; Script.run((function* () { w.stats.notices = (w.stats.notices ?? 0) + 1; const fest = FEST_BY_YD[yd]; const today = fest ? { seedToss: 'THE SEED TOSS, 10 till dusk', lantern: 'THE LANTERN FLOAT, dusk', soup: 'THE GREAT SOUP, all day', longNight: 'THE LONG NIGHT' }[fest] : CONTEST_BY_YD[yd] ? `${CONTEST[CONTEST_BY_YD[yd]].name.toUpperCase()}, 10 till 1. ${CONTEST[CONTEST_BY_YD[yd]].rule}.` : inf.slot === 2 ? 'VESPER, 8pm, lamp post' : 'Nothing. Enjoy it.'; const text = `TODAY: ${today} | CHEESE: ${c.pattern ? `This week's wheels: ${c.pattern}. Today's price: ${fmt(cheesePrice(w))} beans. Wheels go off on Market Day.` : 'See Old Rind on Market Day morning. There is no Old Rind.'} | NOTICE: Whoever has been drawing on this board, the bee would like a word.`; yield say('narrator', text, { name: 'Notice Board' }); bus.emit('notice'); })()); };\nG.ringBell = () => { const w = G.world; G.view.bellRing(); G.playChime(w.chime); Toasts.add('It rings. Somewhere, a goose writes something down.'); };\nG.playChime = (ch) => playChime(G.ctx.audio, ch);\n// ---- Hosts out of doors\nHOSTS_TALK.trundle = function* (actor) { const w = G.world; if (G.storyTalk) { const s = G.storyTalk('trundle'); if (s) { yield* s; return; } } yield say('trundle', line(HOSTS.trundle), { actor }); const fid = FEST_BY_YD[info(w).storyYd]; if (fid && !w.flags[`fest${w.clock.day}`] && canFest(fid)) { const p = yield ask('trundle', fid === 'seedToss' ? 'Is it… time… for the Seed Toss?' : fid === 'soup' ? 'The… soup… is on.' : 'Are we… doing… the thing?', ['Yes, start it', 'Not yet'], { actor, cancel: 1 }); if (p === 0) startFestival(fid); } };\nHOSTS_TALK.hester = function* (actor) { yield say('hester', line(HOSTS.hester), { actor }); };\nHOSTS_TALK.vesper = function* (actor) {\n  const w = G.world; yield say('vesper', line(HOSTS.vesper), { actor }); const moods = [['Rainy', 'rec_rain'], ['Small', 'rec_small'], ['In debt', 'rec_debt'], ['By the sea', 'rec_sea'], ['Honking', 'rec_goose'], ['Leaving', 'rec_bye']]; const p = yield ask('vesper', \"What's your mood, friend?\", [...moods.map((m) => m[0]), 'Just listening'], { actor, cancel: 6 });\n  if (p === 6) return; const [mood, id] = moods[p]; M.override = ITEMS[id].song; bus.emit('vesper', id); G.ctx.audio.play('applause', { volume: 0.2 }); for (const n of NEIGHBOURS) NPC.rt[n].act = 'Sway';\n  const verse = R().pick([\"♪ La-da-dee, and it's raining on the lamp, / and I'm hanging here, and I'm a little bit damp… ♪\", \"♪ Oh, a small, small thing in a small, small town, / and it hung upside down, and it never came down… ♪\", \"♪ You owe, I owe, the moon owes the sea, / and the goose has it all, and she's writing to me… ♪\"]); const s = say('vesper', verse, { actor }); yield s; M.override = null; if (!w.p.records.includes(id)) { w.p.records.push(id); w.stats.recordsGot = (w.stats.recordsGot ?? 0) + 1; G.ctx.audio.play('reveal'); yield say('vesper', `Take the record. \"${ITEMS[id].name.replace('Vesper: ', '')}.\" Put it on when the house is too quiet to be funny.`, { actor }); } remember(w, 'vesper', { item: mood });\n};\nfunction syncVesper() { const rt = NPC.rt.vesper; if (!rt) return; rt.vis = (p) => p === 'town' && YI.vesperHere; rt.x = LANDMARK.lamp[0]; rt.z = LANDMARK.lamp[1] + 0.5; rt.y = 3.1; rt.clip = 'VesperHang'; rt.face = Math.PI / 6; }\nHOSTS_TALK.rind = function* (actor) {\n  const w = G.world; yield say('rind', line(HOSTS.rind), { actor }); const price = cheesePrice(w); if (!YI.rindHere) return; const p = yield ask('rind', `Wheel of cheese? ${fmt(price)} beans. This week it's looking… ${w.cheese.pattern}. You didn't hear that.`, ['Buy one', 'Buy five', 'No'], { actor, cancel: 2 });\n  if (p === 2) return; const n = p === 0 ? 1 : 5; let got = 0; for (let i = 0; i < n; i++) { if (w.p.beans < price || w.p.pockets.indexOf(null) < 0) break; w.p.beans -= price; giveItem(w, { id: 'cheesewheel', bought: w.clock.day, paid: price }); got++; } if (!got) { yield say('rind', \"No beans, no pockets, or no courage. Pick one and come back.\", { actor }); return; } G.ctx.audio.play('cheeseSmell'); w.stats.cheeseBought = (w.stats.cheeseBought ?? 0) + got; bus.emit('cheeseBought', got); yield say('rind', 'Sell at the goose. Sell before Market Day. Sell before it knows your name.', { actor });\n};\n// ---- Pimm\nHOSTS_TALK.pimm = function* (actor) { yield say('pimm', line(HOSTS.pimm.slice(4)), { actor }); };\nexport function pimmVisit(i) { const w = G.world; if (!NPC.actors.pimm) NPC.make('pimm'); const rt = NPC.rt.pimm, a = NPC.actors.pimm; rt.fixed = true; rt.x = w.p.x + 1.6; rt.z = w.p.z + 0.5; rt.y = G.place.heightAt(w.p.x, w.p.z); rt.vis = (p) => p === w.p.place; rt.force = [rt.x, rt.y, rt.z]; rt.clip = 'PimmScuttle'; rt.talkTo = true; w.stats.pimm = (w.stats.pimm ?? 0) + 1; Script.run((function* () { yield 0.6; rt.clip = 'Idle'; yield say('pimm', HOSTS.pimm[Math.min(i, 3)], { actor: a }); bus.emit('pimm', i); rt.clip = 'PimmScuttle'; rt.talkTo = false; rt.force = null; rt.vis = () => false; })()); }\n// ---- Festivals\nconst canFest = (id) => (id === 'lantern' ? G.world.clock.minute >= 17 * 60 : id === 'longNight' ? true : G.world.clock.minute >= 8 * 60);\naddTargets((place) => {\n  const w = G.world, out = []; if (place !== 'town') return out; const yd = info(w).storyYd, fid = FEST_BY_YD[yd], fest = G.fest;\n  if (fid === 'seedToss' && !w.flags[`fest${w.clock.day}`] && !fest) out.push({ kind: 'fest', x: 24, z: 41, reach: 2.2, label: 'The Seed Toss', verb: 'Join', act: () => startFestival('seedToss') });\n  if (fid === 'lantern' && !w.flags[`fest${w.clock.day}`] && canFest('lantern') && !fest) out.push({ kind: 'fest', x: 39.5, z: 23.2, reach: 2.5, label: 'Lantern Float', verb: 'Join', act: () => startFestival('lantern') });\n  if (fid === 'soup' && !w.flags[`fest${w.clock.day}`]) out.push({ kind: 'fest', x: LANDMARK.pot[0], z: LANDMARK.pot[1], reach: 2.2, label: 'The Great Pot', verb: 'Add', act: () => startFestival('soup') });\n  if (fid === 'longNight' && !w.flags[`fest${w.clock.day}`] && !fest) out.push({ kind: 'fest', x: 24, z: 40.4, reach: 2.4, label: 'String of Lights', verb: 'Take', act: () => startFestival('longNight') });\n  if (fest?.id === 'longNight' && fest.stage === 'doors') for (const d of fest.doors) if (!d.done) out.push({ kind: 'fest', x: d.x, z: d.z, reach: 1.6, label: `${CAST[d.id].short ?? CAST[d.id].name}'s door`, verb: 'String the lights', act: () => doorLight(d) });\n  if (fest?.id === 'longNight' && fest.stage === 'pear') out.push({ kind: 'fest', x: 24, z: 40.4, reach: 2.6, label: 'The Old Pear', verb: 'Wait for midnight', act: () => midnight() });\n  return out;\n});\nexport function startFestival(id) { const w = G.world; if (G.fest || w.flags[`fest${w.clock.day}`]) return; w.flags[`fest${w.clock.day}`] = true; bus.emit('festStart', id); M.override = id === 'lantern' ? 'lantern' : id === 'soup' ? 'soup' : id === 'longNight' ? 'longNight' : 'seedToss'; if (id === 'seedToss') return Script.run(seedToss()); if (id === 'lantern') return Script.run(lanternFloat()); if (id === 'soup') return Script.run(greatSoup()); if (id === 'longNight') return Script.run(longNight()); }\nconst gather = (x, z, r = 4) => { const rng = rngOf('gather' + G.time); for (const n of NEIGHBOURS) { const st = G.world.npcs[n], rt = NPC.rt[n]; if (st.moved === 'gone' || st.moved === 'notyet') continue; st.place = 'town'; rt.indoorLocal = false; const a = rng.range(0, 6.28); rt.x = x + Math.cos(a) * rng.range(r * 0.7, r); rt.z = z + Math.sin(a) * rng.range(r * 0.7, r); rt.path = null; rt.wait = 90; rt.pause = 1e4; rt.act = 'Sway'; rt.faceTo = [x, z]; rt.moving = false; } };\nconst release = () => { for (const n of NEIGHBOURS) { const rt = NPC.rt[n]; rt.pause = 0; rt.wait = 2; rt.act = null; rt.faceTo = null; const a = NPC.actors[n]; a.mood = null; } };\n// ---- The Seed Toss\nfunction* seedToss() {\n  const w = G.world, f = (G.fest = { id: 'seedToss', t: 90, score: 0, rings: [], seeds: [], bloom: [], hits: {} }); const rng = R(); gather(24, 39, 7); G.player.state = 'free'; w.p.x = 24; w.p.z = 42.5;\n  yield say('clementine', FESTIVAL_LINES.seedToss[0]); const g = new THREE.Group(); G.view.town.add(g); f.group = g;\n  for (let i = 0; i < 7; i++) { const x = rng.range(18, 30), z = rng.range(35, 43); const m = buildModel('sf-ringmark', {}).object; m.position.set(x, 0.02, z); g.add(m); f.rings.push({ x, z, r: 0.9, m }); }\n  f.running = true; G.player.actor.play('Idle');\n  yield until(() => f.t <= 0); f.running = false; G.ctx.audio.play('gavel'); for (const n of NEIGHBOURS) NPC.rt[n].act = 'Laugh';\n  yield say('clementine', `Time! You sowed ${f.score} ring${f.score === 1 ? '' : 's'}. It's fine. It's all fine. It's going to look wonderful.`);\n  const reward = f.score * 150; earn(w, reward); w.festival = { id: 'seedToss', day: w.clock.day, bloom: f.bloom.slice() }; w.stats.seedToss = f.score;\n  // The Mayor finally reaches the ribbon\n  const rt = NPC.rt.trundle; G.focusZoom = 2; yield say('trundle', 'I… have… arrived. I declare this… ribbon… cut.'); yield say('narrator', 'He reaches out. There is no ribbon. It was here in March. The crowd is very kind about it.'); yield say('trundle', 'Well. That… went… well. I shall… now… go back.'); w.flags.mayorArrived = true; G.focusZoom = null; G.ctx.audio.play('applause');\n  G.view.town.remove(g); G.fest = null; M.override = null; release(); bus.emit('festDone', 'seedToss', f.score);\n}\nexport function festFixed(dt) { const f = G.fest; if (!f) return; if (f.id === 'seedToss' && f.running) { f.t -= dt; const w = G.world; for (const s of f.seeds) { s.t += dt; const k = Math.min(1, s.t / s.dur); s.m.position.set(lerp(s.a[0], s.b[0], k), Math.sin(k * Math.PI) * 2 + 0.1, lerp(s.a[1], s.b[1], k)); if (k >= 1) { s.done = true; f.group.remove(s.m); seedLand(f, s); } } f.seeds = f.seeds.filter((s) => !s.done); f.npcT = (f.npcT ?? 0) - dt; if (f.npcT <= 0) { f.npcT = 0.7; const r = R(); const n = r.pick(NEIGHBOURS.filter((x) => !['gone', 'notyet'].includes(w.npcs[x].moved))); const rt = NPC.rt[n]; const ring = r.pick(f.rings); throwSeed(f, [rt.x, rt.z], [ring.x + r.range(-1, 1), ring.z + r.range(-1, 1)], false); } } }\nfunction throwSeed(f, a, b, mine) { const m = new THREE.Mesh(new THREE.SphereGeometry(0.1, 5, 4), toonMaterial(PALETTE.orange)); f.group.add(m); f.seeds.push({ m, a, b, t: 0, dur: 0.55, mine }); if (mine) G.ctx.audio.play('slingFire'); }\nfunction seedLand(f, s) { for (const ring of f.rings) if (dist2(s.b[0], s.b[1], ring.x, ring.z) < ring.r * ring.r) { G.ctx.particles.burst('confetti', [s.b[0], 0.4, s.b[1]], { count: 10 }); const c = R().pick(['red', 'sand', 'white', 'plum', 'orange']); const fm = buildModel('fl-tulip', { palette: { petal: c } }).object; fm.position.set(s.b[0], 0, s.b[1]); f.group.add(fm); if (s.mine) { f.score++; f.bloom.push([s.b[0], s.b[1], c]); G.ctx.audio.play('pop'); bus.emit('seedHit'); } return; } G.ctx.particles.burst('dust', [s.b[0], 0.1, s.b[1]], { count: 2 }); }\nexport function festTool(aimX, aimZ) { const f = G.fest; if (f?.id !== 'seedToss' || !f.running) return false; const w = G.world; const fx = aimX ?? w.p.x + Math.sin(w.p.facing) * 3.5, fz = aimZ ?? w.p.z + Math.cos(w.p.facing) * 3.5; G.player.actor.play('Cast', { then: 'Idle', restart: true }); throwSeed(f, [w.p.x, w.p.z], [fx, fz], true); return true; }\n// ---- The Lantern Float\nfunction* lanternFloat() {\n  const w = G.world, f = (G.fest = { id: 'lantern' }); gather(39.5, 21.5, 5); yield say('clementine', FESTIVAL_LINES.lantern[0]); const cols = ['Red', 'Orange', 'Sand', 'Lime', 'Sky', 'Plum'], cn = ['red', 'orange', 'sand', 'lime', 'sky', 'plum']; const pick = yield ask('clementine', 'Which colour? It matters. It does not matter.', cols, { cancel: 0 }); let wish = null; UI.push(keyboardScreen({ title: 'One line. Make a wish.', max: 40, lines: true, onDone: (t) => { wish = t; }, onCancel: () => { wish = '…'; } })); yield until(() => wish !== null);\n  w.stats.wishLine = wish; bus.emit('lantern', wish); w.mailQueue.push({ from: 'narrator', subject: 'A Reply, From the Sea', body: `Dear ${w.name}. Re: \"${wish}\". We have looked into this. The sea says: maybe. It also says it's keeping the lantern.`, at: w.clock.day + 1, gift: rngOf(wish).pick(['shell_pearl', 'drift_bottle', 's_navy']) });\n  // Hundreds of lights drifting to the sea\n  const N = 240; const geo = new THREE.BoxGeometry(0.28, 0.32, 0.28); const palette = ['orange', 'sand', 'red', 'lime', 'sky', 'plum']; const meshes = palette.map((c) => { const m = new THREE.InstancedMesh(geo, glowMaterial(PALETTE[c]), N); m.count = 0; m.frustumCulled = false; G.view.town.add(m); return m; }); const own = buildModel('sf-lantern', { palette: { glow: cn[pick] } }).object; own.scale.setScalar(1.6); G.view.town.add(own); f.lanterns = []; const r = R();\n  const path = [[39.5, 24], [39.5, 33], [41, 35], [42.5, 38], [42.5, 48], [43, 52], [43, 62], [46, 75]]; for (let i = 0; i < N; i++) f.lanterns.push({ p: r.range(-1, 0), s: r.range(0.018, 0.03), off: r.range(-1.4, 1.4), mesh: meshes[i % meshes.length] }); f.path = path; f.own = own; f.meshes = meshes; f.ownP = 0;\n  G.view.setFocus = [39.5, 26]; Toasts.add('You set it on the water. It leaves without looking back.'); f.running = true;\n  w.clock.minute = Math.max(w.clock.minute, 18 * 60); yield 5;\n  yield say('dorrit', \"They all go the same way, mmhm. Off to the sea. I like to think somebody's cooking down there.\");\n  yield until(() => hourOf(w.clock) >= 21 || (G.fest && (G.fest.skip = true))); if (hourOf(w.clock) < 21) { w.clock.minute = 21 * 60; onHour(21); }\n  fireworkShow(); f.fired = true; const pStart = G.time; yield 7; yield say('tavi', \"Look at it! Look at the sky! It's so loud! Isn't it?!\"); yield 2; G.fest.running = false; for (const m of meshes) G.view.town.remove(m); G.view.town.remove(own); G.fest = null; M.override = null; release(); G.view.setFocus = null; w.stats.lanternDone = true; bus.emit('festDone', 'lantern');\n}\nexport function festUpdate(dt) { const f = G.fest; if (f?.id === 'lantern' && f.running) { const seg = (p) => { const P = f.path, t = clamp(p, 0, 0.999) * (P.length - 1), i = Math.floor(t), k = t - i; return [lerp(P[i][0], P[i + 1][0], k), lerp(P[i][1], P[i + 1][1], k)]; }; const counts = new Map(); const dummy = (f.d ??= new THREE.Object3D()); for (const m of f.meshes) counts.set(m, 0); for (const l of f.lanterns) { l.p += l.s * dt; if (l.p > 1) l.p = 0; if (l.p < 0) continue; const [x, z] = seg(l.p); const c = counts.get(l.mesh); dummy.position.set(x + l.off, -0.14, z); dummy.updateMatrix(); l.mesh.setMatrixAt(c, dummy.matrix); counts.set(l.mesh, c + 1); } for (const m of f.meshes) { m.count = counts.get(m); m.instanceMatrix.needsUpdate = true; } f.ownP += 0.03 * dt; const [ox, oz] = seg(f.ownP); f.own.position.set(ox, -0.3, oz); } }\nexport function fireworkShow() { const w = G.world; const v = G.view; const fx = 30, fz = 58; const slot = w.p.patterns.findIndex(Boolean); let own = slot >= 0 ? w.p.patterns[slot] : null; const seq = [[20, 58], [40, 56], [30, 54], [28, 60], [46, 58], [34, 56]]; seq.forEach(([x, z], i) => setTimeout0(() => { if (i === 2 && own) { v.firework(x, z, own); w.stats.patternFirework = true; bus.emit('patternFirework'); } else v.firework(x, z); }, i * 1.1)); }\n// ---- The Great Soup\nfunction* greatSoup() {\n  const w = G.world, f = (G.fest = { id: 'soup' }); gather(LANDMARK.pot[0], LANDMARK.pot[1], 4); const pot = buildModel('giant-pot', {}).object; pot.position.set(LANDMARK.pot[0], 0, LANDMARK.pot[1]); G.view.town.add(pot); f.pot = pot; yield say('dorrit', FESTIVAL_LINES.soup[0]); const picks = []; for (let i = 0; i < 3; i++) { let c = null; UI.push(pocketsScreen({ title: `Ingredient ${i + 1} of 3`, pickLabel: 'In it goes', onPick: (e, idx, s) => { c = { e, idx }; UI.pop(s); }, onClose: () => { c = c ?? false; } })); yield until(() => c !== null); if (!c) { picks.push({ id: 'water', name: 'nothing', tags: [] }); continue; } const it = ITEMS[c.e.id]; w.p.pockets[c.idx] = null; picks.push(it); G.ctx.audio.play('plop'); G.ctx.particles.burst('splash', [LANDMARK.pot[0], 1.6, LANDMARK.pot[1]]); yield 0.3; }\n  const tagsOf = (it) => [it.cat, ...(it.tags ?? [])]; let score = 0; const cats = new Set(); for (const p of picks) { const t = tagsOf(p); if (t.includes('fish')) { score += 2; cats.add('fish'); } if (t.includes('fruit')) { score += 1; cats.add('fruit'); } if (t.includes('food') || t.includes('mushroom')) { score += 2; cats.add('mushroom'); } if (t.includes('boot')) { score += w.flags.bootYear ? 1 : -1; cats.add('boot'); } if (t.includes('cheese')) score += 1; if (t.includes('stinky')) score -= 3; if (t.includes('junk') && !t.includes('boot')) score -= 2; if (t.includes('flower')) score += 0; if (t.includes('bug')) score -= 2; } if (cats.size >= 3) score += 2; const good = score >= 3; w.stats.soup = { score, good }; f.good = good;\n  const tasters = NEIGHBOURS.filter((n) => !['gone', 'notyet'].includes(w.npcs[n].moved)).slice(0, 4); const goodLines = { hearth: \"That's the one, mmhm. That's the one my mother never made.\", sunshine: \"It's the best soup, isn't it?! It's got bits!\", grouch: 'Hm. …I would prefer more.', diva: \"Darling dear, one could almost call it food.\", gogetter: \"I can feel my plates! Let's roll!\", dreamer: \"It tastes like a Tuesday I forgot, or so the moon says.\", schemer: 'I detect nothing suspicious. That is very suspicious.', auntie: 'Oh, hon. Oh, I must tell someone about this soup.', hustler: 'I could sell this. No refunds.' }; const badLines = { hearth: \"…I've made a terrible mistake, mmhm. No. *You* have.\", sunshine: \"It's so… interesting! My mouth has gone away, isn't it?!\", grouch: \"I'd prefer not. I'd have preferred not.\", diva: \"Take me to the river. Not for dramatic reasons.\", gogetter: \"That's going straight to the… oh. Oh no.\", dreamer: 'I can see the moon. It is looking away.', schemer: \"This is how they get you. You didn't hear it from me.\", auntie: \"Well, hon. Somebody's going to hear about this.\", hustler: \"I wouldn't sell this. That has never happened.\" };\n  for (const n of tasters) { const a = NPC.actors[n]; a.play('Eat', { then: 'Idle', restart: true }); G.ctx.audio.play('eat'); if (!good) a.mood = 'queasy'; yield 0.4; yield say(n, (good ? goodLines : badLines)[CAST[n].type]); a.play(good ? 'Love' : 'ShakeHead', { then: 'Idle' }); }\n  if (good) { earn(w, 3000); for (const n of NEIGHBOURS) friendGain(w, n, 5); G.ctx.audio.play('applause'); yield say('dorrit', 'A feast, then. Everybody eats. Here, three thousand beans, from the whip-round. Don\\'t ask who whipped, mmhm.'); } else { w.gagGift = true; yield say('dorrit', \"Well. Nobody's dead. I've checked twice, mmhm. I'll send you something tomorrow. It's mostly a warning.\"); } G.view.town.remove(pot); G.fest = null; M.override = null; release(); bus.emit('festDone', 'soup', good);\n}\n// ---- The Long Night\nfunction* longNight() {\n  const w = G.world; const f = (G.fest = { id: 'longNight', stage: 'doors', doors: [], g: new THREE.Group() }); G.view.town.add(f.g); w.festival = { id: 'longNight', day: w.clock.day }; yield say('clementine', FESTIVAL_LINES.longNight[0]); yield say('clementine', FESTIVAL_LINES.longNight[1]); for (const n of NEIGHBOURS) { const st = w.npcs[n]; if (st.moved === 'gone' || st.moved === 'notyet') continue; const b = BUILDINGS.find((x) => x.id === (n === 'fitch' ? 'rocco' : n)); f.doors.push({ id: n, x: b.door[0], z: b.door[1] + 0.6, done: false, b }); } if (w.clock.minute < 16 * 60) w.clock.minute = 16 * 60; Toasts.add('Take the string to each door. Everyone gets a gift, and everyone gets you.', 6);\n}\nfunction doorLight(d) { const w = G.world, f = G.fest; Script.run((function* () { d.done = true; const mat = glowMaterial(PALETTE.sand), m2 = glowMaterial(PALETTE.red); const s = new THREE.Group(); for (let i = 0; i < 9; i++) { const l = new THREE.Mesh(new THREE.SphereGeometry(0.09, 4, 3), i % 2 ? mat : m2); l.position.set(d.b.x - 2.2 + i * 0.55, 2.3 + Math.sin(i) * 0.1, d.b.z + d.b.d / 2 + 0.1); s.add(l); } f.g.add(s); G.ctx.audio.play('pickup'); w.stats.doorsLit = (w.stats.doorsLit ?? 0) + 1; const st = w.npcs[d.id]; friendGain(w, d.id, 4); const lines = { hearth: 'Lights! Mmhm. Here, a pot of something, for the walk.', sunshine: \"It's so pretty, isn't it?! I got you a rock!\", grouch: \"I'd prefer not. …Leave them on, though.\", diva: 'At last, the estate is lit. Take this. It was a scarf. Not *that* scarf.', gogetter: '', dreamer: 'Each bulb is a very small moon. Have this page.', schemer: 'Who sent you? …Fine. Take this. You never had it.', auntie: \"Oh, hon. You've done my door crooked. I love it. Here, it's a mitten.\", hustler: 'Lights! Great. What do I owe you? Nothing? I like that. Here, a box.' }; yield say(d.id, lines[CAST[d.id].type] || 'Here. Thanks.'); giveItem(w, { id: 'pear', from: d.id }); bus.emit('doorLit', d.id); if (f.doors.every((x) => x.done)) { f.stage = 'pear'; Toasts.add('All the doors are lit. To the Old Pear.', 5); } })()); }\nfunction midnight() {\n  const w = G.world, f = G.fest; f.stage = 'finale'; Script.run((function* () {\n    gather(24, 39, 6); w.p.x = 24; w.p.z = 41.5; w.p.facing = Math.PI; w.clock.minute = 23 * 60 + 58; yield say('narrator', 'Everybody comes out. Nobody says why. It is nearly midnight.'); const rr = NPC.rt.rocco; if (w.npcs.rocco.moved === 'gone') { w.npcs.rocco.moved = 'visiting'; w.npcs.rocco.place = 'town'; rr.indoorLocal = false; rr.x = 24; rr.z = 47; rr.pause = 1e4; rr.path = null; rr.faceTo = [24, 38]; const rA = NPC.actors.rocco; rA.play('RoccoRoll'); yield 0.8; G.ctx.audio.play('roll'); rr.x = 26.5; rr.z = 42; rA.play('Wave', { then: 'Idle', restart: true }); yield say('rocco', \"I rolled here! From the next province! Did you start without me?! Let's roll!\", { actor: rA }); yield say('tavi', 'ROCCO!!! Isn\\'t it?!'); yield say('bartleby', \"…You're blocking the view. …Good to see you. I'd prefer not to discuss it.\"); w.flags.roccoReturned = true; bus.emit('roccoBack'); }\n    // The Old Pear lights up\n    const lights = new THREE.Group(); const mats = ['sand', 'red', 'lime', 'sky'].map((c) => glowMaterial(PALETTE[c])); const r = rngOf('pear'); for (let i = 0; i < 80; i++) { const m = new THREE.Mesh(new THREE.SphereGeometry(0.11, 4, 3), mats[i % 4]); const a = r.range(0, 6.28), rad = r.range(1.5, 3.1), y = r.range(3, 7.2); m.position.set(24 + Math.cos(a) * rad, y, 38 + Math.sin(a) * rad); lights.add(m); } G.view.town.add(lights); w.flags.pearLit = true; G.ctx.engine.screen.flash('white', { duration: 0.3 }); G.ctx.audio.play('fwBurst'); w.clock.minute = 0; yield 0.8; playChime(G.ctx.audio, w.chime, true); G.view.bellRing(); bus.emit('finaleBell'); for (const n of NEIGHBOURS) NPC.rt[n].act = 'Sway'; yield 3.4;\n    const [text, hint] = townRating(w); const high = (w.rating ?? 0) >= 60; yield say('clementine', `The town rating. I'll read it. ${text}`); if (high) { w.gotGold = true; w.flags.goldBell = true; G.view.setBellGold?.(); G.ctx.audio.play('reveal'); yield say('clementine', 'The bee says the Bell has gone gold. I went and checked. It has. It is fine. It is very fine.'); bus.emit('goldBell'); } else yield say('clementine', 'The bee says: next year. There is always next year. That is how it works.');\n    yield say('gander', w.p.debt > 0 ? `Happy new year, dear. You still owe ${fmt(w.p.debt)} beans. I wanted to be the first to say so.` : \"Happy new year, dear. You owe nothing. I don't care for it.\");\n    yield say('tavi', \"We're all still here, isn't it?!\"); yield say('dorrit', \"That's the idea, mmhm. There's soup.\");\n    w.year = Math.max(w.year, 2); w.flags.ending = (w.flags.ending ?? 0) + 1; w.stats.endings = (w.stats.endings ?? 0) + 1; bus.emit('ending');\n    const s = G.openCredits(); yield until(() => s.closed); G.view.town.remove(lights); G.view.town.remove(f.g); G.fest = null; M.override = null; release(); if (w.npcs.rocco.moved === 'visiting') { w.npcs.rocco.moved = 'gone'; NPC.rt.rocco.pause = 0; w.npcs.rocco.place = 'away'; } w.clock.minute = 60; w.mailQueue.push({ from: 'clementine', subject: 'Year Two', body: `${w.name}. It's the first of the year. Nothing has changed. The bee says that is the good news. Everything is where you left it. The Mayor has set out for the other side of the plaza. Clementine.`, at: w.clock.day + 1 }); G.sleepTo(0); bus.emit('yearTwo');\n  })());\n}\n// ---- Rocco\nfunction roccoLeaves() {\n  const w = G.world, st = w.npcs.rocco; w.flags.roccoGone = true; st.moved = 'gone'; st.place = 'away'; const best = st.friend >= 75; const argued = w.flags.roccoArgued; w.mail.push({ from: 'rocco', subject: 'From Rocco', body: `${w.name}! Gone rolling! ${argued ? \"You told me to stay. Nobody's ever told me that. I'm still going, but I rolled slower for the first bit.\" : 'Big hills out there! Somebody should see them!'} Keep up your rolls! Let's roll! Rocco.`, gift: best ? 'trophy_rocco' : null, read: false, day: w.clock.day }); remember(w, 'rocco'); bus.emit('roccoGone');\n  const f = w.npcs.fitch; f.moved = 'here'; f.place = 'h_fitch'; const b = BUILDINGS.find((x) => x.id === 'rocco'); b.modelOverride = 'cottage-fitch'; G.view.placeBuilding(b); NPC.goInside('fitch'); NPC.rt.fitch.indoorLocal = true; bus.emit('fitchHere');\n}\nexport const applyMovedState = () => { const w = G.world; if (w.flags.roccoGone) { const b = BUILDINGS.find((x) => x.id === 'rocco'); b.modelOverride = 'cottage-fitch'; G.view.placeBuilding(b); } };\nexport function roccoStory(id) {\n  const w = G.world, yd = info(w).storyYd;\n  if (id === 'rocco' && yd >= 7 && !w.flags.roccoTalk && !w.flags.roccoGone) return (function* () { w.flags.roccoTalk = true; const a = NPC.actors.rocco; yield say('rocco', \"Hey! So! I've been thinking! I know! Let's roll! | I've been the champion here nine years. There's nobody left to beat. I'm thinking… bigger hills. Saturday. Well. In a couple of days.\", { actor: a }); const p = yield ask('rocco', \"What do you reckon? Do I go?\", ['Stay. Please.', 'You should go', \"You've got this\"], { actor: a, cancel: 1 }); if (p === 0) { w.flags.roccoArgued = true; friendGain(w, 'rocco', 6); yield say('rocco', \"…Huh. Nobody's ever said that. I've got armour for most things. Not that. I'm still going! But huh.\", { actor: a }); } else yield say('rocco', \"Yeah! That's what I thought! Let's roll! …Yeah.\", { actor: a }); bus.emit('roccoTold'); })();\n  return null;\n}\n// ---- Contests\nfunction startContest(c) { const w = G.world, def = CONTEST[c]; w.contest = { id: c, day: w.clock.day, score: 0, best: null, done: false }; M.override = 'contest'; setTimeout0(() => { M.override = null; }, 8); bus.emit('contestStart', c); if (w.p.place === 'town') Script.run((function* () { yield say('clementine', `The ${def.name} has begun. ${def.rule}. You have until one o'clock. Nobody is timing you. I am timing you.`); })()); else Toasts.add(`The ${def.name} has begun!`, 5); }\nbus.on?.('x', () => {});\nexport function contestCaught(it) { const w = G.world, c = w.contest; if (!c || c.done || c.day !== w.clock.day) return; if (c.id === 'derby' && it.cat === 'fish') { if (!c.best || it.price > ITEMS[c.best].price) { c.best = it.id; c.score = it.price; Toasts.add(`New biggest fish: ${it.name}!`); } } if (c.id === 'bugoff' && it.cat === 'bug') { c.score += it.price; Toasts.add(`Bug-Off total: ${fmt(c.score)}`); } }\nexport function snowProportion(body, head) { const ratio = head / Math.max(0.01, body); return clamp(Math.round(100 - Math.abs(ratio - 0.72) * 200), 0, 100); }\nexport function endContest() {\n  const w = G.world, c = w.contest; if (!c || c.done) return; c.done = true; const def = CONTEST[c.id]; const r = rngOf(`${w.seed}:contest:${c.id}:${w.clock.day}`); const rivals = NEIGHBOURS.filter((n) => !['gone', 'notyet'].includes(w.npcs[n].moved)).slice(0, 5).map((n) => { let score; if (c.id === 'derby') { const list = FISH_LIST.filter((f) => f.seasons.includes(String(info(w).season))); const k = r.int(1, 4); score = 0; for (let i = 0; i < k; i++) score = Math.max(score, r.pick(list).price); } else if (c.id === 'bugoff') { const list = BUG_LIST.filter((f) => f.seasons.includes(String(info(w).season)) && !f.rare); score = 0; const k = r.int(2, 6); for (let i = 0; i < k; i++) score += r.pick(list).price; } else score = r.int(30, 92); return { n, score }; }); if (c.id === 'snowman') { c.score = Math.max(c.score, ...Object.values(w.ents).filter((e) => e.t === 'snowman').map((e) => e.score ?? 0), 0); } const you = { n: 'you', score: c.score }; const table = [...rivals, you].sort((a, b) => b.score - a.score); const place = table.indexOf(you) + 1; c.place = place; c.table = table; w.stats[`contest_${c.id}`] = place; if (place <= 3 && c.score > 0) { const trophy = def.trophy; w.mailQueue.push({ from: 'clementine', subject: `${def.name}: Result`, body: `You came ${['first', 'second', 'third'][place - 1]}. ${place === 1 ? 'There is a trophy. It is heavy. The bee helped carry it.' : 'There is a small trophy. It is mostly a compliment.'} Clementine.`, gift: trophy, at: w.clock.day + 1 }); } bus.emit('contestEnd', c.id, place); const top = table.slice(0, 3).map((e, i) => `${i + 1}. ${e.n === 'you' ? 'You' : nameOf(e.n)} (${fmt(e.score)})`).join('   ');\n  const judge = c.id === 'snowman' ? 'bartleby' : 'clementine'; const intro = c.id === 'snowman' ? \"I've been asked to judge. I'd prefer not. They all look like snowmen.\" : `Time. The ${def.name} is over. It was fine.`; if (w.p.place === 'town' || w.p.place === 'hall') Script.run((function* () { yield say(judge, `${intro} | ${top}`); })()); else Toasts.add(`${def.name}: you came ${place}.`, 6);\n}\nbus.on('caught', () => {});\n// ---- Snow\nG.tryStackSnow = (e) => { const w = G.world; for (const o of Object.values(w.ents)) { if (o === e || o.t !== 'snowball') continue; if (dist2(e.x, e.z, o.x, o.z) < 3.2) { const body = Math.max(e.size, o.size), head = Math.min(e.size, o.size); removeEnt(w, o); const x = e.x, z = e.z; removeEnt(w, e); const score = snowProportion(body, head); addEnt(w, { t: 'snowman', x, z, score, head, body }); G.ctx.audio.play('reveal'); G.ctx.particles.burst('sparkle', [x, 1.4, z]); w.stats.snowmen = (w.stats.snowmen ?? 0) + 1; bus.emit('snowman', score); Script.run((function* () { yield say('narrator', score >= 70 ? `\"Oh, these are good proportions. I feel balanced. I'll write.\" (${score}/100)` : score >= 40 ? `\"My head's a bit… no, it's fine. It's fine. I'm a snowman.\" (${score}/100)` : `\"What have you done? Look at me. Look at the size of me.\" (${score}/100)`, { name: 'The Snowman' }); })()); if (score >= 70) w.mailQueue.push({ from: 'narrator', subject: 'From the Snowman', body: 'Thank you for the proportions. I can feel myself going. Have this. Keep it cold. Yours, Snowman.', gift: 'snowman_gift', at: w.clock.day + 1 }); return; } } };\nG.snowmanTalk = (e) => Script.run((function* () { yield say('narrator', e.score >= 70 ? 'It looks peaceful. It looks like it knows what spring is.' : 'It stares. You did this.', { name: 'The Snowman' }); })());\n// ---- Stars\nG.stargaze = (bench) => { const w = G.world; G.player.state = 'sit'; G.player.actor.play('Sit'); const s = starScreen(); UI.push(s); w.stats.stargazed = (w.stats.stargazed ?? 0) + 1; bus.emit('stargaze'); };\nfunction starScreen() { const w = G.world, r = rngOf(`stars:${w.clock.day}`); const stars = Array.from({ length: 150 }, () => [r.int(0, 479), r.int(0, 240), r.pick(['white', 'mist', 'sky'])]); const cons = CONSTELLATIONS.map((c, i) => ({ ...c, ox: 40 + (i % 3) * 145, oy: 30 + Math.floor(i / 2) * 60 })); return { id: 'stars', title: 'The Lookout', t2: 0, next: 3, shoot: null, freezes: false, opaque: true, get prompts() { return this.shoot ? [['confirm', 'Wish!']] : [['back', 'Stand up']]; }, focusLabel: () => 'sky', input(c, dt) { this.t2 += dt; this.next -= dt; if (this.next <= 0 && !this.shoot) { this.shoot = { x: r.int(120, 450), y: r.int(10, 80), t: 1.4 }; this.next = r.range(5, 11); G.ctx.audio.play('starFall'); G.starNow = true; } if (this.shoot) { this.shoot.t -= dt; this.shoot.x -= dt * 180; this.shoot.y += dt * 70; if (c.confirm() || c.clickL()) { w.wishes.push({ gift: r.pick(['wish_star', 'shell_pearl', 'h_crown', 's_sky', 'bag']) }); w.stats.wished++; G.ctx.audio.play('wish'); Toasts.add('You wished. A present arrives in the morning.'); bus.emit('wish'); this.shoot = null; G.starNow = false; } else if (this.shoot.t <= 0) { this.shoot = null; G.starNow = false; } } if (c.back()) { UI.pop(this); G.player.state = 'free'; G.player.actor.play('Idle'); } }, draw(h) { h.rect(0, 0, 480, 270, 'night'); for (const [x, y, col] of stars) h.rect(x, y, 1, 1, Math.sin(this.t2 * 2 + x) > 0.9 ? 'night' : col); cons.forEach((c0, i) => { const pts = c0.pts.map(([a, b]) => [c0.ox + a * 26, c0.oy + b * 26]); for (let k = 0; k < pts.length - 1; k++) { for (let t = 0; t <= 8; t++) h.rect(Math.round(lerp(pts[k][0], pts[k + 1][0], t / 8)), Math.round(lerp(pts[k][1], pts[k + 1][1], t / 8)), 1, 1, 'slate'); } for (const [a, b] of pts) h.rect(a, b, 2, 2, 'white'); drawText(h, c0.ox, c0.oy + 42, w.almanac.stars[c0.id]?.name ?? c0.name, { color: 'mist' }); }); if (this.shoot) { for (let t = 0; t < 8; t++) h.rect(Math.round(this.shoot.x + t * 3), Math.round(this.shoot.y - t), 2, 1, t < 3 ? 'white' : 'sand'); promptRow(h, 240, 246, [['confirm', 'Wish!']], { align: 'center', back: 'ink' }); } else promptRow(h, 240, 246, [['back', 'Stand up']], { align: 'center', back: 'ink' }); h.rect(0, 255, 480, 15, 'ink'); } }; }\n// ---- Credits and the almanac of your year\nconst CREDITS_TEXT = (w) => { const s = w.stats; const most = Object.entries(s.talked).sort((a, b) => b[1] - a[1])[0]; return [`The Almanac of Your Year`, `Biggest catch: ${ITEMS[s.biggest]?.name ?? 'an old boot, spiritually'}`, `Sold to Mrs. Gander: ${fmt(s.sold)} beans`, `Debt: ${w.p.debt ? `${fmt(w.p.debt)} beans. She says hello.` : 'none. She is taking it badly.'}`, `Talked to most: ${most ? nameOf(most[0]) : 'nobody. Fair enough.'}`, `Museum pieces: ${museumCount(w)}`, `Town rating: ${w.rating ?? 'unread'}`, w.flags.goldBell ? 'The Old Bell went gold.' : 'The Old Bell is still bronze. It is fine.', '', 'Silly Folk', 'Written and built by an AI with a very small goose', 'Mrs. Gander as herself. Mayor Trundle, arriving shortly.', 'Hester, on the bus. Vesper, on the lamp post.', 'Thanks for visiting. Nothing was ever urgent.', '', 'Year Two begins in the morning.']; };\nG.openCredits = () => { const w = G.world; M.override = 'credits'; const lines = CREDITS_TEXT(w); const s = { id: 'credits', title: 'Credits', y: 280, closed: false, opaque: true, freezes: true, get prompts() { return [['confirm', 'Skip']]; }, focusLabel: () => 'credits', itemsModel() { return lines.slice(); }, input(c, dt) { this.y -= dt * 22; if (this.y < -lines.length * 18 - 20 || ((c.confirm() || c.back()) && (this.t > 1))) { this.closed = true; UI.pop(this); M.override = null; } }, draw(h) { h.rect(0, 0, 480, 270, 'night'); lines.forEach((l, i) => drawText(h, 240, Math.round(this.y + i * 18), l, { color: i === 0 || l === 'Silly Folk' ? 'sand' : 'white', align: 'center', scale: i === 0 || l === 'Silly Folk' ? 2 : 1 })); promptRow(h, 470, 252, [['confirm', 'Skip']], { align: 'right', back: 'ink' }); } }; UI.push(s); return s; };\nE\ncat > src/systems/dayone.js <<'E'\n// The first twenty minutes: the bus in the rain, the goose, and seven errands that teach every verb.\nimport { G, bus } from '../state.js';\nimport { Script, say, ask, Toasts, until } from '../ui/dialogue.js';\nimport { UI, panel, hit, promptRow } from '../ui/kit.js';\nimport { drawText, textWidth } from '../ui/font.js';\nimport { keyboardScreen } from '../ui/screens.js';\nimport { NPC } from '../actors/npcs.js';\nimport { HOSTS_TALK } from './talk.js';\nimport { setPlace, Trans } from '../world/places.js';\nimport { LANDMARK } from '../world/layout.js';\nimport { ITEMS, TOOL_ORDER } from '../data/items.js';\nimport { giveItem, hasItem, takeItem, earn, addEnt, remember, friendGain, addLetter } from '../core/world.js';\nimport { equip } from './interact.js';\nimport { T } from '../dev/tuning.js';\nimport { upgradeHome, letterFlow } from './services.js';\nimport { Nature } from './nature.js';\nimport { rngOf, fmt } from '../core/util.js';\nimport { M } from '../audio/music.js';\nimport { HAIRS } from '../art/critter.js';\nexport const ERRANDS = [['parcel', 'Fetch a parcel from Dorrit'], ['weed', 'Pull a weed, sell it at the store'], ['bug', 'Catch a butterfly for Tavi'], ['fish', 'Catch Bartleby a fish'], ['dig', 'Dig the crack on the plaza'], ['water', \"Water the Mayor's sapling\"], ['letter', 'Write to Gran at the Post']];\nconst PAY = 286;\nconst NAME_IDEAS = ['Pat', 'Morgan', 'Ash', 'Robin', 'Sam', 'Quinn', 'Jo', 'Toby', 'Wren', 'Bean'];\nconst TOWN_IDEAS = ['Lesser Wallop', 'Mudford', 'Nowhere-on-Sea', 'Tiddling', 'Upper Regret', 'Puddock', 'Little Fuss'];\nfunction done(k) { const w = G.world; const d = w.day1; if (d[k + 'Done']) return; d[k + 'Done'] = true; w.p.debt = Math.max(0, w.p.debt - Math.round(PAY * T.debt)); w.p.paidTotal += PAY; G.ctx.audio.play('reveal'); Toasts.add(`Errand done. ${fmt(PAY)} beans off your debt.`, 3.5); bus.emit('errand', k); if (ERRANDS.every(([e]) => d[e + 'Done'])) Script.run(evening()); }\nexport const errandsLeft = () => { const d = G.world.day1; return ERRANDS.filter(([k]) => !d[k + 'Done']); };\nexport function drawErrands(h, y = 28) { const w = G.world; if (!w.day1 || w.day1.done || !w.day1.started) return; const left = ERRANDS; const pw = 196, ph = 10 + left.length * 12 + 12; panel(h, 472 - pw, y, pw, ph, { fill: 'white' }); drawText(h, 472 - pw + 8, y + 5, \"Today's errands\", { color: 'navy' }); left.forEach(([k, label], i) => { const dn = w.day1[k + 'Done']; drawText(h, 472 - pw + 8, y + 18 + i * 12, (dn ? '✕ ' : '· ') + label, { color: dn ? 'mist' : 'ink' }); }); }\nfunction* evening() { const w = G.world; if (w.day1.done) return; w.day1.done = true; w.clock.speedHalf = false; if (w.clock.minute < 18 * 60) w.clock.minute = 18 * 60; yield 0.4; yield say('gander', `You've paid off 2,000 beans. You're free to go. Not that you were ever not free. Legally.`); yield say('gander', 'The roof has been installed. It is included. The bed is in. The rain is complimentary. Do use the bed, dear. It saves everything.'); w.flags.roofOn = true; bus.emit('dayOneDone'); }\nexport function finishDayOne() { const w = G.world; for (const [k] of ERRANDS) w.day1[k + 'Done'] = true; w.day1.done = true; w.clock.speedHalf = false; }\n// ---- The opening: bus, name, look\nexport function openingScript(world, opts) {\n  return (function* () {\n    const w = G.world; M.override = 'bus'; G.player.actor.visible = false; G.view.town.visible = false; w.clock.frozen = true; G.opening = { t: 0 };\n    const answers = {}; yield 1;\n    yield say('hester', 'End of the line? Nobody gets off there on purpose.', { name: 'The Driver' });\n    yield say('hester', 'Hester. I drive the bus. I only drive the bus. Who are you, then?');\n    let name = null; UI.push(keyboardScreen({ title: 'Your name', initial: '', max: 12, suggest: () => rngOf(`${G.time}`).pick(NAME_IDEAS), onDone: (t) => { name = t; }, opaque: false })); yield until(() => name); w.name = name;\n    yield say('hester', `${name}. Right. And what's the town called, ${name}? I only drive the bus.`);\n    let town = null; UI.push(keyboardScreen({ title: 'Name the village', initial: '', max: 16, suggest: () => rngOf(`${G.time}t`).pick(TOWN_IDEAS), onDone: (t) => { town = t; }, opaque: false })); yield until(() => town); w.town = town;\n    yield say('hester', `${town}. Never heard of it. That's the good news.`);\n    const a1 = yield ask('hester', 'What are you running from?', ['A family business', 'A bad haircut', 'My own potential', 'Nothing. Why? Who said?'], {});\n    const a2 = yield ask('hester', 'Favourite weather?', ['Rain', 'Fog', 'Sun, in moderation', 'Thunder, at a distance'], {});\n    const a3 = yield ask('hester', 'How do you take bad news?', ['With a nod', 'With soup', 'I hide', 'I bill someone'], {});\n    w.p.look.hair = [0, 3, 2, 5][a1]; w.p.look.hairColor = ['orange', 'plum', 'ink', 'red'][a2]; w.p.look.eyes = [0, 4, 3, 2][a3]; G.player.rebuild(); answersReflect(answers);\n    yield say('hester', \"There's a reflection in the window there, if you can stand it. You look like someone who owes money.\");\n    const s = reflectScreen(); UI.push(s); yield until(() => s.closed);\n    yield say('hester', 'End of the line. Mind the step. There is no step. Mind it anyway.');\n    let ok = false; Trans.go(() => { M.override = null; G.opening = null; w.clock.frozen = false; G.player.actor.visible = true; G.view.town.visible = true; setPlace('town', LANDMARK.busStop[0], LANDMARK.busStop[1] + 1, 0); ok = true; }); yield until(() => ok); yield 0.3;\n    const g = NPC.rt.gander; g.staffOut = [LANDMARK.busStop[0] + 1.6, LANDMARK.busStop[1] + 1.2]; g.force = [g.staffOut[0], 0, g.staffOut[1]]; NPC.rt.gander.talkTo = true; G.focusZoom = 2.1;\n    yield say('gander', \"You're late. No, you're exactly on time. I've already billed you for being late.\", { actor: NPC.actors.gander });\n    yield say('gander', \"Mrs. Gander. I hold the note on your shack. It's the one at the far end of the village, with no roof. The roof is included. The rain is complimentary. The 8,000 beans are not.\", { actor: NPC.actors.gander });\n    upgradeHome(1); w.p.debt = Math.round(8000 * T.debt); w.flags.intro = true; w.p.look.shirt = 's_apron'; G.player.rebuild(); w.day1.started = true; bus.emit('arrived');\n    yield say('gander', \"Apron on. You'll work it off. I've made a list. Take your time. I've noted how much.\", { actor: NPC.actors.gander });\n    g.force = null; g.talkTo = false; G.focusZoom = null; Toasts.add('Errands: see the list. The clock runs at half speed until they’re done.', 5);\n  })();\n}\nconst answersReflect = () => {};\nfunction reflectScreen() { const w = G.world; const rows = [['Hair', 'hair', HAIRS.map((_, i) => i), (v) => HAIRS[v]], ['Colour', 'hairColor', ['orange', 'ink', 'sand', 'red', 'plum', 'blue', 'white', 'lime'], (v) => v], ['Eyes', 'eyes', [0, 1, 2, 3, 4, 5], (v) => ['Dots', 'Tall', 'Wide', 'Sleepy', 'Sparkly', 'Crossed'][v]]]; return { id: 'reflect', title: 'Your reflection', focus: 0, closed: false, freezes: true, spin: 0, opaque: true, get prompts() { return [['confirm', 'That will do']]; }, focusLabel() { return rows[this.focus][0]; }, itemsModel() { return rows.map((r) => r[0]); }, input(c, dt) { const n = c.nav; if (n === 'up') this.focus = (this.focus + 2) % 3; if (n === 'down') this.focus = (this.focus + 1) % 3; const r = rows[this.focus]; if (n === 'left' || n === 'right') { const i = r[2].indexOf(w.p.look[r[1]]); w.p.look[r[1]] = r[2][(i + (n === 'left' ? r[2].length - 1 : 1)) % r[2].length]; G.player.rebuild(); UI.sfx('uiTick'); } if (c.confirm() || c.clickL()) { this.closed = true; UI.pop(this); } }, draw(h) { h.rect(0, 0, 480, 270, 'navy'); for (let i = 0; i < 26; i++) { const y = (i * 37 + Math.floor(UI.time * 70)) % 270, x = (i * 91) % 480; h.rect(x, y, 1, 6, 'blue'); } panel(h, 120, 30, 240, 170); drawText(h, 240, 38, 'A reflection, in a bus window, in the rain', { color: 'navy', align: 'center' }); G.drawAvatarCard?.(h, 186, 58); rows.forEach((r, i) => { const f = i === this.focus, y = 140 + i * 18; if (f) h.rect(128, y - 3, 224, 16, 'navy'); drawText(h, 136, y, r[0], { color: f ? 'white' : 'ink' }); drawText(h, 344, y, `← ${r[3](w.p.look[r[1]])} →`, { color: f ? 'sand' : 'slate', align: 'right' }); }); promptRow(h, 240, 206, [['confirm', 'That will do']], { align: 'center', back: 'ink' }); } }; }\n// ---- Errand conversations\nexport function storyTalk(id) {\n  const w = G.world, d = w.day1; if (!d || d.done) return null; const a = NPC.actors[id];\n  if (id === 'dorrit' && !d.parcel) return (function* () { d.parcel = true; yield say(id, 'You look peaky, mmhm. You must be the new one. I made soup. It\\'s Tuesday\\'s. Tuesday was a good day for soup, mmhm.', { actor: a }); yield say(id, \"Take this parcel to the goose. It's her waistcoat buttons. Don't shake it. Don't sniff it. Do sniff the soup.\", { actor: a }); giveItem(w, { id: 'parcel', to: 'gander' }); Toasts.add('Got the Parcel. Take it to Mrs. Gander, at the store.'); w.npcs.dorrit.lastTalk = w.clock.day; friendGain(w, id, 3); bus.emit('talked', id); })();\n  if (id === 'tavi' && !d.bugGiven) return (function* () { d.bugGiven = true; yield say(id, \"Hi hi hi! You're new! I love you! I've got a net! It's for you! I don't know why I had it!\", { actor: a }); w.p.tools.includes('net') || w.p.tools.push('net'); equip('net'); yield say(id, \"Press and hold to get ready, let go to swing! Walk soft, or they get scared, isn't it?! There's a butterfly! Catch it! Don't tell it I said!\", { actor: a }); const it = ITEMS.cabbagefly; Nature.spawnBug(it, w.p.x + 2.4, w.p.z + 1.4, 0.8, 'flower'); w.npcs.tavi.lastTalk = w.clock.day; friendGain(w, id, 3); bus.emit('talked', id); })();\n  if (id === 'tavi' && d.bugGiven && !d.bugDone && d.bug) return (function* () { const i = hasItem(w, 'cabbagefly'); yield say(id, \"You did it! You caught it! Now you can keep it, isn't it?! I'm so proud! I hardly know you!\", { actor: a }); done('bug'); })();\n  if (id === 'bartleby' && !d.fishGiven) return (function* () { d.fishGiven = true; yield say(id, \"Rod? I've got a rod. I'd prefer not. No. Take it. You can catch me a fish. Don't make it a thing.\", { actor: a }); w.p.tools.includes('rod') || w.p.tools.push('rod'); equip('rod'); yield say(id, \"Stand by the water. Cast. Wait for the big bite, not the little ones. Press again when it goes under. You'll work it out. Go away.\", { actor: a }); w.npcs.bartleby.lastTalk = w.clock.day; bus.emit('talked', id); })();\n  if (id === 'bartleby' && d.fishGiven && !d.fishDone && w.p.pockets.some((e) => e && ITEMS[e.id]?.cat === 'fish')) return (function* () { const i = w.p.pockets.findIndex((e) => e && ITEMS[e.id]?.cat === 'fish'); const it = ITEMS[w.p.pockets[i].id]; w.p.pockets[i] = null; yield say(id, `${/^[AEIOU]/.test(it.name) ? 'An' : 'A'} ${it.name.toLowerCase()}. Fine. I didn't ask for one. I did. I'd prefer not to discuss it.`, { actor: a }); done('fish'); friendGain(w, id, 5); })();\n  return null;\n}\nexport function wireDayOne() {\n  const prevG = HOSTS_TALK.gander, prevT = HOSTS_TALK.trundle, prevC = HOSTS_TALK.clementine;\n  HOSTS_TALK.gander = function* (actor) { const w = G.world, d = w.day1; if (d && !d.done) { const i = w.p.pockets.findIndex((e) => e?.id === 'parcel' && e.to === 'gander'); if (i >= 0) { w.p.pockets[i] = null; yield say('gander', \"My buttons. On time, for once. Well. In a sense. There. That's a little off your account, dear. Don't spend it all on breathing.\", { actor }); done('parcel'); } } yield* prevG(actor); };\n  HOSTS_TALK.trundle = function* (actor) { const w = G.world, d = w.day1; if (d && !d.done && !w.p.tools.includes('shovel')) { yield say('trundle', \"Ah… you're… the new… one. I'm on… my way… somewhere. Have… my shovel.\", { actor }); w.p.tools.push('shovel'); equip('shovel'); yield say('trundle', 'There\\'s a… crack… on the plaza. Star… shaped. Dig it. Stand… in front. I\\'ll… wait.', { actor }); return; } yield* prevT(actor); };\n  HOSTS_TALK.clementine = function* (actor) { const w = G.world, d = w.day1; if (d && !d.done) { if (!w.p.tools.includes('can')) { yield say('clementine', \"Welcome. It's fine here. Everything is. The bee says you'll want this watering can. The Mayor's sapling is by the pond. It looks thirsty. It's been fine about it.\", { actor }); w.p.tools.push('can'); equip('can'); } if (!d.letterDone) { const p = yield ask('clementine', 'You could write to your gran, while you are here. She has written to ask if you are dead.', ['Write to Gran', 'Not yet'], { actor, cancel: 1 }); if (p === 0) { const before = w.stats.letters; let text = null; UI.push(keyboardScreen({ title: 'Dear Gran…', max: 90, lines: true, onDone: (t) => { text = t; }, onCancel: () => { text = false; } })); yield until(() => text !== null); if (text) { G.ctx.audio.play('stamp'); w.stats.letters++; remember(w, 'letter', { to: 'gran', snip: text.slice(0, 18) }); addLetter(w, { from: 'gran', subject: 'From Gran', body: `Dear ${w.name}. You wrote: \"${text.slice(0, 40)}\". I've read worse. I've written worse. Here's some fruit. Gran.`, gift: 'fig' }); bus.emit('letter', 'gran', text); addLetter(w, { from: 'dorrit', subject: 'From Dorrit', body: `Welcome, ${w.name}, mmhm. I've left soup somewhere near you. You'll know. Dorrit.`, gift: 'pear' }); yield say('clementine', \"Your letter's stamped. A bee has been living in the stamp drawer. We've agreed to share.\", { actor }); done('letter'); return; } } } } yield* prevC(actor); };\n  bus.on('weed', () => { const d = G.world.day1; if (d && !d.done) { d.weed = true; Toasts.add('Now sell it to Mrs. Gander. She will take anything. It is her whole deal.'); } });\n  bus.on('sold', (it) => { const d = G.world.day1; if (d && !d.done && it.id === 'weed') done('weed'); });\n  bus.on('caught', (it) => { const d = G.world.day1; if (!d || d.done) return; if (it.cat === 'bug') { d.bug = true; if (d.bugGiven && !d.bugDone) done('bug'); } if (it.cat === 'fish') { d.fish = true; Toasts.add('Take it to Bartleby. He would prefer you did not.'); } });\n  bus.on('dug', () => { const d = G.world.day1; if (d && !d.done) { G.world.flags.day1Fossil = true; done('dig'); } });\n  bus.on('watered', (e) => { const d = G.world.day1; if (d && !d.done && e.mayor) done('water'); });\n}\nE\ncat >> ../PROGRESS.md <<'E'\nDone: systems/year, systems/dayone. Next: ui/shell (title, pause, settings, dev, about, attract), game.js, main.js; net (hub round + visit); tests; polish; exit-interview.\nE","description":"Write the year, festivals, contests and Day One"}}}
