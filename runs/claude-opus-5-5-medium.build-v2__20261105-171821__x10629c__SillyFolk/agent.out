{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmobWKvSQ8L2eaB5Z5B","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HqZ6hujJHswVQPQVSJLerF","name":"Bash","input":{"command":"cat > src/systems/city.js <<'E'\n// The bus, the boulevard, the crowd, and eight venues, each with something that isn't a menu.\nimport { THREE, buildModel, toonMaterial, PALETTE, setLookLayer } from '../engine.js';\nimport { G, bus } from '../state.js';\nimport { HOSTS_TALK } from './talk.js';\nimport { Script, say, ask, Toasts, until, fill } from '../ui/dialogue.js';\nimport { HOSTS, BALLAD, GOSSIP } from '../data/lines.js';\nimport { UI, panel, promptRow, menu, hit, hitAt, dim, para } from '../ui/kit.js';\nimport { drawText, wrap, textWidth, LINE_H } from '../ui/font.js';\nimport { drawIcon } from '../ui/icons.js';\nimport { pocketsScreen, itemCard } from '../ui/screens.js';\nimport { ITEMS, CLOTHES, EMOTES, EMOTE_CLIP, FISH_LIST, BUG_LIST } from '../data/items.js';\nimport { T } from '../dev/tuning.js';\nimport { earn, giveItem, remember, info } from '../core/world.js';\nimport { fmt, rngOf, clamp } from '../core/util.js';\nimport { hourOf, SEASONS } from '../core/calendar.js';\nimport { NPC } from '../actors/npcs.js';\nimport { CAST, NEIGHBOURS, nameOf } from '../data/cast.js';\nimport { setPlace, Trans, enterRoom } from '../world/places.js';\nimport { CITY, LANDMARK } from '../world/layout.js';\nimport { M } from '../audio/music.js';\nimport { speakChar } from '../audio/voice.js';\nimport { railFlow, buyItem } from './services.js';\nimport { homeScore, gradeReward } from './home.js';\nimport { HAIRS, EYE_STYLES, critterDef } from '../art/critter.js';\nimport { Actor } from '../actors/actor.js';\nimport { paintingTexture, PAINT_ROWS, PAINT_COL, FORGERY } from '../art/textures.js';\nimport { addTargets } from './interact.js';\nconst R = () => rngOf(`${G.world.seed}:c:${G.world.clock.day}:${G.world.clock.minute}:${G.time}`);\nconst line = (arr) => R().pick(arr);\n// ---- The bus: a threshold you feel\nexport function balladVerse(w, r) {\n  const mem = w.memory.slice(-16).reverse(); const caught = mem.find((m) => m.k === 'caught' && m.cat === 'fish'), bug = mem.find((m) => m.k === 'caught' && m.cat === 'bug'), gift = mem.find((m) => m.k === 'gift'), sold = mem.find((m) => m.k === 'sold'), gone = mem.find((m) => m.k === 'soldGift'), bought = mem.find((m) => m.k === 'bought');\n  const tags = { catch: (caught?.item ?? 'an old boot').toLowerCase(), price: sold ? fmt(ITEMS[caught?.id]?.price ?? 10) : 'ten', debt: fmt(w.p.debt), bug: (bug?.item ?? 'butterfly').toLowerCase(), neighbour: nameOf(gift?.who ?? r.pick(NEIGHBOURS.slice(0, 8))), item: (gift?.item ?? bought?.item ?? 'hat').toLowerCase(), fossil: 'very old bone', pockets: String(w.p.pockets.filter(Boolean).length), season: SEASONS[info(w).season], tree: 'pears', player: w.name, town: w.town };\n  const candidates = BALLAD.verses.filter((v, i) => { if (v.includes('{catch}')) return !!caught; if (v.includes('{bug}')) return !!bug; if (v.includes('{item}') && i === 3) return !!gift; if (v.includes('sold it, you sold it')) return !!gone; return true; });\n  return fill(r.pick(candidates), tags);\n}\nconst Ride = { active: false };\nfunction busGroup() { if (Ride.group) return Ride.group; const g = new THREE.Group(); g.position.set(-2000, 0, 0); const m = buildModel('bus', {}).object; m.traverse((x) => { if (x.isMesh) x.castShadow = true; }); g.add(m); Ride.bus = m; G.ctx.scene.add(g); Ride.props = []; Ride.ground = new THREE.Mesh(new THREE.PlaneGeometry(90, 90).rotateX(-Math.PI / 2), toonMaterial(PALETTE.green)); g.add(Ride.ground); const road = new THREE.Mesh(new THREE.PlaneGeometry(4.6, 90).rotateX(-Math.PI / 2), toonMaterial(PALETTE.slate)); road.position.y = 0.02; g.add(road); for (let i = 0; i < 12; i++) { const dash = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.02, 1.4), toonMaterial(PALETTE.sand)); dash.position.set(-0.9, 0.04, -40 + i * 7); g.add(dash); Ride.props.push({ o: dash, loop: 84 }); } const r = rngOf('ride'); for (let i = 0; i < 26; i++) { const side = i % 2 ? 1 : -1; const t = buildModel(i % 3 === 0 ? 'pine-tree' : 'pear-tree', i % 3 === 0 ? {} : { palette: { leaf: 'green', leaf2: 'lime' } }).object; t.position.set(side * r.range(5, 16), 0, -42 + i * 3.3); g.add(t); Ride.props.push({ o: t, loop: 84 }); } Ride.group = g; g.visible = false; return g; }\nexport function busRide(dest) {\n  const w = G.world, r = rngOf(`${w.seed}:ride:${w.clock.day}:${w.clock.minute}`);\n  return (function* () {\n    let ready = false; Trans.go(() => { const g = busGroup(); g.visible = true; G.view.town.visible = false; G.view.city.visible = false; for (const rr of Object.values(G.rooms)) rr.group.visible = false; Ride.active = true; Ride.ground.material = toonMaterial(PALETTE[['lime', 'green', 'sand', 'white'][info(w).season]]); G.player.actor.visible = false; M.override = 'bus'; ready = true; }); yield until(() => ready);\n    G.ctx.audio.play('busHorn'); G.ctx.audio.play('busEngine');\n    const scr = rideScreen(w, r, dest); UI.push(scr); yield until(() => scr.closed);\n    let done = false; Trans.go(() => { Ride.group.visible = false; Ride.active = false; M.override = null; G.player.actor.visible = true; if (dest === 'city') setPlace('city', CITY.stop[0] + CITY.ox, CITY.stop[1] + 1.2, Math.PI / 2); else setPlace('town', LANDMARK.busStop[0], LANDMARK.busStop[1] + 0.8, 0); done = true; w.stats.rides = (w.stats.rides ?? 0) + 1; bus.emit('rode', dest); }); yield until(() => done);\n  })();\n}\nfunction rideScreen(w, r, dest) {\n  const verses = [balladVerse(w, r), r.pick(BALLAD.chorus), balladVerse(w, r), r.pick(BALLAD.chorus)]; const dur = 20; const melody = [0, 2, 4, 7, 4, 2, 0, -3, 0, 4, 7, 9, 7, 4, 2, 0];\n  return { id: 'busride', title: 'The Bus', t2: 0, v: 0, chars: 0, closed: false, freezes: true, opaque: false, verses, get prompts() { return [['back', 'Skip']]; }, itemsModel() { return verses.slice(); }, focusLabel() { return verses[this.v]; },\n    input(c, dt) { this.t2 += dt; const text = verses[this.v]; const before = Math.floor(this.chars); this.chars = Math.min(text.length, this.chars + dt * 16); for (let i = before; i < Math.floor(this.chars); i++) speakChar(G.ctx.audio, CAST.hester, text[i], i, text, 1, CAST.hester.voice.pitch + melody[i % melody.length]); if (this.chars >= text.length && (this.hold = (this.hold ?? 0) + dt) > 1.2) { this.hold = 0; this.v = (this.v + 1) % verses.length; this.chars = 0; }\n      if (Ride.bus) { Ride.bus.rotation.z = Math.sin(this.t2 * 6) * 0.012; Ride.bus.position.y = Math.abs(Math.sin(this.t2 * 8)) * 0.04; } for (const p of Ride.props ?? []) { p.o.position.z += dt * 11; if (p.o.position.z > 42) p.o.position.z -= p.loop; }\n      if (this.t2 > dur || c.back() || c.confirm()) { this.closed = true; UI.pop(this); G.ctx.audio.play('busBrake'); } },\n    draw(h) { panel(h, 42, 200, 396, 56); h.rect(52, 193, textWidth('Hester') + 12, 13, 'navy'); drawText(h, 58, 196, 'Hester', { color: 'white' }); const lines = wrap(verses[this.v].slice(0, Math.floor(this.chars)), 372); lines.forEach((l, i) => drawText(h, 54, 212 + i * LINE_H, l, { color: 'ink' })); promptRow(h, 440, 258, [['back', 'Skip']], { align: 'right', back: 'ink' }); drawText(h, 240, 8, dest === 'city' ? 'To the Big City' : `Home to ${w.town}`, { color: 'white', align: 'center', shadow: 'ink' }); } };\n}\nexport const rideFocus = () => (Ride.active ? new THREE.Vector3(-2000, 1, 0) : null);\nG.bus = { call(from) { const w = G.world; if (w.guest) return Toasts.add(\"Bus doesn't run while you have company.\"); if (G.visit?.hosting?.()) return Toasts.add(\"Bus doesn't run while you have company.\"); if (w.day1 && !w.day1.done && !G.noHours) return Script.run((function* () { yield say('hester', \"Not today. You've got a goose to see. Come back when you're not on the clock.\"); })()); Script.run((function* () { G.player.state = 'free'; G.ctx.audio.play('busHorn'); yield 0.3; if (from === 'town') { const p = yield ask('narrator', 'The bus has arrived. It was here all along, somehow.', ['To the Big City', 'Not now'], { cancel: 1 }); if (p) return; yield* busRide('city'); } else { const p = yield ask('narrator', 'The last bus. There is always a last bus.', [`Home to ${w.town}`, 'Stay a bit'], { cancel: 1 }); if (p) return; yield* busRide('town'); } })()); } };\n// ---- Crowd: assorted species walking the boulevard\nconst WAY = [[6, 8], [14, 8], [22, 8], [30, 8], [38, 8], [44, 8], [38, 14], [30, 14], [22, 14], [14, 14], [6, 14], [26, 15.5], [36, 21], [28, 21], [36, 16]].map(([x, z]) => [x + CITY.ox, z]);\nconst SPP = ['tapir', 'otter', 'toucan', 'walrus', 'newt', 'mink', 'tapir', 'otter', 'walrus', 'newt', 'mink', 'toucan', 'tapir', 'mink'];\nconst CROWD_LINES = [\"…so I said, that's not a pigeon, that's my solicitor…\", \"…they've closed the good bakery. Now it's a bad bakery…\", \"…four hundred beans for a coffee, and it was mostly the sloth…\", \"…I've moved to the City for the anonymity. Hello, I'm Brian…\", \"…have you seen the prices at Pemberton's? Have you heard them?…\", \"…she's a flamingo, Gerald. That's just how they stand…\", \"…you can tell it's real art because it's stolen…\", \"…the theatre's marvellous. I've no idea what happens…\", \"…mind the bus. It sings…\", \"…I knew a goose, once. I still do. I still owe her…\", \"…nobody looks up here. Look. There. See? Nothing…\", \"…every Sunday, I come here and I walk that way. Then I walk back…\"];\nexport const Crowd = { list: [], init() { const g = new THREE.Group(); this.group = g; G.ctx.scene.add(g); const r = rngOf('crowd'); const cols = ['sand', 'mist', 'orange', 'slate', 'plum', 'teal']; const shirts = ['red', 'blue', 'green', 'navy', 'plum', 'sand', 'white', 'teal']; this.list = SPP.map((sp, i) => { const a = new Actor(critterDef({ id: `crowd${i}`, species: sp, c1: cols[i % cols.length], c2: 'white', shirt: shirts[i % shirts.length], trousers: 'navy', shoes: 'ink' }), { seed: i * 7, scale: r.range(0.85, 1) }); a.addTo(g); const way = i % WAY.length; return { a, way, x: WAY[way][0], z: WAY[way][1], name: `${sp[0].toUpperCase()}${sp.slice(1)} in a hurry`, line: CROWD_LINES[i % CROWD_LINES.length], sp: r.range(1.4, 2.4), pause: 0 }; }); this.musician = new Actor(critterDef({ id: 'musician', species: 'walrus', c1: 'plum', c2: 'mist', shirt: 'red', trousers: 'ink', shoes: 'ink', hat: 'tophat', hatColor: 'ink' }), { seed: 3 }); this.musician.addTo(g); this.musician.place(CITY.ox + 28, 0, 15.8); this.musician.facing = this.musician.targetFacing = Math.PI / 4; this.musician.play('Sway'); },\n  fixed(dt) { if (G.world.p.place !== 'city') return; for (const c of this.list) { if (c.pause > 0) { c.pause -= dt; continue; } const [tx, tz] = WAY[c.way]; const dx = tx - c.x, dz = tz - c.z, d = Math.hypot(dx, dz); if (d < 0.2) { c.way = (c.way + 1) % WAY.length; if (c.way === 11 && (this.list.indexOf(c) % 2)) c.way = 0; continue; } c.x += (dx / d) * c.sp * dt; c.z += (dz / d) * c.sp * dt; c.face = Math.atan2(dx, dz); } },\n  update(dt) { const on = G.world.p.place === 'city'; this.group.visible = on; if (!on) return; for (const c of this.list) { c.a.place(c.x, 0, c.z); if (c.face != null) c.a.targetFacing = c.face; c.a.play(c.pause > 0 ? 'Listen' : 'Walk'); c.a.update(dt); } this.musician.update(dt); } };\nG.crowdList = () => (G.world.p.place === 'city' ? Crowd.list : []);\nG.crowdTalk = (c) => { c.pause = 3; Script.run((function* () { const scr = say('narrator', c.line, { name: c.name, freezes: false }); yield scr; })()); };\n// ---- Salon: live preview on a turntable\nHOSTS_TALK.fleece = function* (actor) { const w = G.world; yield say('fleece', line(HOSTS.fleece.filter((l) => !l.includes('{gossip}'))), { actor }); const p = yield ask('fleece', 'You will sit in the chair, yes? Fifteen hundred beans. The hair, it does not cut itself. Yet.', ['Sit', 'Not today'], { actor, cancel: 1 }); if (p === 0) yield* cutFlow(actor); };\nfunction* cutFlow(actor) { const w = G.world; if (w.p.beans < 1500 * T.buy) { yield say('fleece', 'Your pockets, they are bald. Come back.', { actor }); return; } const start = { ...w.p.look }; const s = salonScreen(); UI.push(s); yield until(() => s.closed); if (!s.kept) { Object.assign(w.p.look, start); G.player.rebuild(); yield say('fleece', 'You are afraid. I understand. It is a lot of hair.', { actor }); return; } w.p.beans -= Math.round(1500 * T.buy); w.stats.cuts = (w.stats.cuts ?? 0) + 1; remember(w, 'haircut'); bus.emit('cut'); G.ctx.audio.play('snip'); const names = NEIGHBOURS.slice(0, 8); const g = fill(R().pick(GOSSIP), { n1: nameOf(R().pick(names)), n2: nameOf(R().pick(names)) }); yield say('fleece', `Voilà. One piece of gossip per cut, this is the rule. So: ${g}`, { actor }); }\nfunction salonScreen() { const w = G.world; const COLORS = ['orange', 'ink', 'sand', 'red', 'plum', 'blue', 'white', 'lime']; const rows = [{ key: 'hair', label: 'Hair', list: HAIRS.map((_, i) => i), name: (v) => HAIRS[v] }, { key: 'hairColor', label: 'Colour', list: COLORS, name: (v) => v }, { key: 'eyes', label: 'Eyes', list: EYE_STYLES.map((_, i) => i), name: (v) => EYE_STYLES[v] }]; return { id: 'salon', title: 'The Chair', focus: 0, closed: false, kept: false, freezes: true, get prompts() { return this._p; }, focusLabel() { return rows[this.focus]?.label ?? 'Keep'; }, itemsModel() { return rows.map((r) => r.label); }, spin: 0, input(c, dt) { const n = c.nav; if (n === 'up') this.focus = (this.focus + 3) % 4; if (n === 'down') this.focus = (this.focus + 1) % 4; const row = rows[this.focus]; if ((n === 'left' || n === 'right') && row) { const i = row.list.indexOf(w.p.look[row.key]); const v = row.list[(i + (n === 'left' ? row.list.length - 1 : 1)) % row.list.length]; w.p.look[row.key] = v; G.player.rebuild(); G.ctx.audio.play('snip'); } this.spin += dt * 1.2; w.p.facing = this.spin; if (c.moved) { const id = hitAt(c.mx, c.my); if (typeof id === 'number') this.focus = id; } const click = c.clickL() && typeof hitAt(c.mx, c.my) === 'number'; if (click) { this.focus = hitAt(c.mx, c.my); if (this.focus < 3) { const r = rows[this.focus]; const i = r.list.indexOf(w.p.look[r.key]); w.p.look[r.key] = r.list[(i + 1) % r.list.length]; G.player.rebuild(); G.ctx.audio.play('snip'); } } if (c.confirm() || (click && this.focus === 3)) { if (this.focus === 3) { this.kept = true; this.close(); } else this.focus = 3; } if (c.back()) { this.close(); } }, close() { this.closed = true; UI.pop(this); }, draw(h) { panel(h, 12, 40, 170, 120); drawText(h, 24, 48, 'The Chair', { color: 'navy' }); rows.forEach((r, i) => { const f = i === this.focus, y = 66 + i * 20; if (f) h.rect(18, y - 3, 158, 18, 'navy'); drawText(h, 24, y + 1, r.label, { color: f ? 'white' : 'ink' }); drawText(h, 170, y + 1, `← ${r.name(w.p.look[r.key])} →`, { color: f ? 'sand' : 'slate', align: 'right' }); hit(18, y - 3, 158, 18, i); }); const f = this.focus === 3; if (f) h.rect(18, 123, 158, 18, 'red'); drawText(h, 24, 127, 'Keep it (1,500 beans)', { color: f ? 'white' : 'ink' }); hit(18, 123, 158, 18, 3); this._p = [['confirm', 'Choose'], ['back', 'Run away']]; promptRow(h, 18, 165, this._p, { back: 'ink' }); } }; }\n// ---- Couture: the fashion check\nconst THEMES = [['Something damp', 'damp'], ['Evening, possibly a funeral', 'evening'], ['Cosy, but threatening', 'cosy'], ['Very loud, indeed', 'loud'], ['The sea, but expensive', 'seaside'], ['Suspiciously clean', 'clean'], ['Practical footwear for a coup', 'practical'], ['The street, but the good street', 'city'], ['Wool. Only wool', 'wool'], ['Absurdly fancy', 'fancy'], ['Outdoors, reluctantly', 'outdoors'], ['Plain, as a threat', 'plain']];\nexport const todayTheme = (w) => THEMES[(w.clock.day * 7 + 3) % THEMES.length];\nexport function judgeOutfit(w, tag) { const items = [w.p.look.shirt, w.p.look.hat, w.p.look.glasses, w.p.look.umbrella && w.p.look.umbrella !== 'u_sand' ? w.p.look.umbrella : null].filter(Boolean).map((i) => ITEMS[i]); let score = 0; const said = []; for (const it of items) { const tags = it?.tags ?? []; if (tags.includes(tag)) { score += 2; said.push(`The ${it.name.toLowerCase()}: *yes*. It understood the brief.`); } else if (tags.includes('fancy')) { score += 1; said.push(`The ${it.name.toLowerCase()}: costly. I felt nothing, expensively.`); } else if (tags.includes('debt')) { said.push(`Is that an apron? Darling. Do you work here?`); } else said.push(`The ${it.name.toLowerCase()}: why?`); } if (w.p.look.pattern != null) { score += 1; said.push('A hand-drawn shirt. How brave. How damp.'); } return { score: clamp(score, 0, 5), said }; }\nHOSTS_TALK.flavia = function* (actor) {\n  const w = G.world; yield say('flavia', line(HOSTS.flavia.filter((l) => !l.includes('{theme}'))), { actor }); const [name, tag] = todayTheme(w); const p = yield ask('flavia', `Today's theme is \"${name}\". Well?`, w.fashion.day === w.clock.day ? ['See the rail', 'Bye'] : ['Be judged', 'See the rail', 'Bye'], { actor, cancel: w.fashion.day === w.clock.day ? 1 : 2 });\n  const judged = w.fashion.day === w.clock.day; if (!judged && p === 0) { const { score, said } = judgeOutfit(w, tag); G.player.actor.play('Idle'); for (const s of said.slice(0, 3)) yield say('flavia', s, { actor }); for (let i = 0; i < score; i++) { G.ctx.audio.play('plume', { pitch: i * 2 }); G.ctx.particles.burst('sparkle', [w.p.x, 1.8, w.p.z], { count: 6, colors: ['red', 'white'] }); yield 0.25; } w.fashion = { day: w.clock.day, score }; w.p.plumes = Math.max(w.p.plumes, 0) + score; w.stats.fashion = (w.stats.fashion ?? 0) + 1; remember(w, 'fashion', { plumes: score }); bus.emit('fashion', score); const a = NPC.actors.flavia; a.play(score >= 4 ? 'Love' : score <= 1 ? 'ShakeHead' : 'Nod', { then: 'Idle' }); yield say('flavia', score === 0 ? 'No plumes. I looked for one. It left.' : score === 5 ? `Five plumes! I'm so moved I'm almost standing on both feet.` : `${score} plume${score > 1 ? 's' : ''}. Treasure ${score > 1 ? 'them' : 'it'}. Lifetime plumes: ${w.p.plumes}.`, { actor }); return; }\n  if ((judged && p === 0) || (!judged && p === 1)) yield* coutureRail(actor);\n};\nfunction* coutureRail(actor) { const w = G.world; const rail = CLOTHES.filter((c) => c.couture && w.p.plumes >= c.couture * 3); if (!rail.length) { yield say('flavia', `You may approach the rail at three plumes. You have ${w.p.plumes}. There's a rope. It's velvet. It's mostly a feeling.`, { actor }); return; } yield* railFlow(rail.map((c) => ({ id: c.id, sold: w.catalog[c.id] })), 'flavia', actor); }\n// ---- Magda: spot the forgery\nHOSTS_TALK.magda = function* (actor) { yield say('magda', line(HOSTS.magda), { actor }); const w = G.world; const rare = w.magda?.rare; const opts = rare && !w.magda.rareSold ? [`Rare furniture: ${ITEMS[rare].name}`, 'Bye'] : ['Bye']; const p = yield ask('magda', 'Three on the easels. Have a look. Lean right in. Or don\\'t.', opts, { actor, cancel: opts.length - 1 }); if (p === 0 && opts.length > 1) { const s = { id: rare, sold: false }; const ok = yield* buyItem(s, 'magda', actor, Math.round(ITEMS[rare].price * 1.5)); if (ok) w.magda.rareSold = true; } };\nG.magdaProp = (idx) => { const w = G.world; const o = w.magda?.offers[idx]; if (!o) return; if (o.sold) return Toasts.add('Just an easel. And a shape where a painting was.'); Script.run((function* () { const s = artCard(o); UI.push(s); yield until(() => s.closed); if (s.bought) { w.p.beans -= o.price; o.sold = true; giveItem(w, { id: o.id, forged: o.forged }); G.ctx.audio.play('pickup'); w.stats.artBought = (w.stats.artBought ?? 0) + 1; bus.emit('artBought', o); yield say('magda', \"Pleasure. You've got a good eye. I've got it in a jar, next to the other one.\", { actor: NPC.actors.magda }); } })()); };\nfunction artCard(o) { const it = ITEMS[o.id]; const s = { id: 'artCard', title: it.name, closed: false, bought: false, freezes: true, focus: 0, offer: o, get prompts() { return this._p; }, focusLabel() { return this.focus ? 'Leave it' : 'Buy'; }, itemsModel() { return ['Buy', 'Leave it']; }, input(c) { if (c.nav === 'left' || c.nav === 'right') { this.focus = 1 - this.focus; UI.sfx('uiTick'); } if (c.moved) { const id = hitAt(c.mx, c.my); if (typeof id === 'number') this.focus = id; } const click = c.clickL() && typeof hitAt(c.mx, c.my) === 'number'; if (click) this.focus = hitAt(c.mx, c.my); if (c.confirm() || click) { if (this.focus === 0) { if (G.world.p.beans < o.price) { UI.sfx('uiNo'); Toasts.add('You have the eye, but not the beans.'); return; } this.bought = true; } this.close(); } if (c.back()) this.close(); }, close() { this.closed = true; UI.pop(this); }, draw(h) { dim(h); panel(h, 40, 24, 400, 196); drawText(h, 240, 32, it.name, { color: 'navy', align: 'center' }); drawPaint(h, 58, 56, it.art, o.forged, 10); drawPaint(h, 262, 56, it.art, false, 10); drawText(h, 138, 44, \"On Magda's easel\", { color: 'slate', align: 'center' }); drawText(h, 342, 44, 'Your catalogue print', { color: 'slate', align: 'center' }); drawText(h, 240, 182, `${fmt(o.price)} beans. \"One hundred percent genuine.\"`, { color: 'orange', align: 'center' }); ['Buy', 'Leave it'].forEach((l, i) => { const f = i === this.focus, x = 150 + i * 100; h.rect(x, 196, 80, 16, f ? 'navy' : 'sand'); drawText(h, x + 40, 200, l, { color: f ? 'white' : 'ink', align: 'center' }); hit(x, 196, 80, 16, i); }); this._p = [['confirm', 'Choose'], ['back', 'Leave']]; promptRow(h, 240, 224, this._p, { align: 'center', back: 'ink' }); } }; return s; }\nexport function drawPaint(h, x, y, id, forged, s = 8) { const rows = PAINT_ROWS[id], H = 12, W = 16; h.rect(x - 3, y - 3, W * s + 6, H * s + 6, 'sand'); for (let r = 0; r < H; r++) for (let c = 0; c < W; c++) { let ch = rows[r]?.[c] ?? rows[0][0]; if (forged && FORGERY[id][0] === c && FORGERY[id][1] === r) ch = FORGERY[id][2]; h.rect(x + c * s, y + r * s, s, s, PAINT_COL[ch] ?? 'mist'); } }\n// ---- Theatre: a sketch; press Laugh on the punchline\nconst SKETCHES = [\n  ['A hippo walks into a bar.', 'The bar says, \"Ow.\"', 'The hippo says, \"Why the long face?\"', 'The bar says: \"I have just told you. A hippo walked into me.\"'],\n  ['I shall now perform the entirety of the Scottish play. In one line.', '…', 'Everybody dies. They had it coming.', 'Thank you. Thank you. There will be no interval, because there is no more play.'],\n  ['\"To be, or not to be,\" I said to the waiter.', 'The waiter said: \"We have the fish.\"', 'I said: \"Is it fresh?\"', 'He said: \"It wishes it wasn\\'t.\"'],\n  ['My agent said, \"You will never work in this town again.\"', 'I said, \"That is wonderful. Which town is it?\"', 'He said, \"Reginald, we are on a bus.\"', 'And that, friends, is how I became a bus actor.'],\n];\nHOSTS_TALK.bellows = function* (actor) { const w = G.world; const h = hourOf(w.clock); yield say('bellows', line(HOSTS.bellows), { actor }); if ((h < 18 || h >= 24) && !G.noHours) { yield say('bellows', 'The curtain rises at six in the evening! Until then, I am merely a large person in a very dark room.', { actor }); return; } const p = yield ask('bellows', 'A short sketch? Do laugh at the end. You will know the end because I will stop.', ['Yes, go on', 'Not tonight'], { actor, cancel: 1 }); if (p) return; const r = R(); const sk = r.pick(SKETCHES); G.ctx.audio.play('curtain'); for (let i = 0; i < sk.length - 1; i++) yield say('bellows', sk[i], { actor }); const s = laughScreen(sk[sk.length - 1]); UI.push(s); yield until(() => s.closed); w.stats.sketches = (w.stats.sketches ?? 0) + 1; bus.emit('sketch', s.hit); if (s.hit) { G.ctx.audio.play('applause'); const learn = EMOTES.find((e) => !w.p.emotes.includes(e)); if (learn) { w.p.emotes.push(learn); G.player.actor.play(EMOTE_CLIP[learn], { then: 'Idle', restart: true }); bus.emit('emoteLearned', learn); yield say('bellows', `Bravo! You have the gift! You have learned to *${learn}*. Use it sparingly, like everything except me.`, { actor }); } else yield say('bellows', 'Bravo! You have nothing left to learn. Go away and be marvellous elsewhere.', { actor }); } else { yield say('bellows', s.early ? 'You laughed *before* the joke. Do you know what that does to an artist?' : 'Nothing? No? I see. There will be a short pause, in which I die.', { actor }); } };\nfunction laughScreen(punch) { return { id: 'laugh', title: 'Laugh!', t2: 0, chars: 0, closed: false, hit: false, early: false, freezes: true, get prompts() { return [['confirm', 'Laugh']]; }, focusLabel: () => 'laugh', input(c, dt) { this.t2 += dt; const before = Math.floor(this.chars); this.chars = Math.min(punch.length, this.chars + dt * 22); for (let i = before; i < Math.floor(this.chars); i++) speakChar(G.ctx.audio, CAST.bellows, punch[i], i, punch); const done = this.chars >= punch.length; if (done) this.after = (this.after ?? 0) + dt; if (c.confirm() || c.clickL()) { if (done) { this.hit = true; G.ctx.audio.play('laugh'); G.player.actor.play('Laugh', { then: 'Idle', restart: true }); } else this.early = true; this.closed = true; UI.pop(this); return; } if (this.after > 2.4) { this.closed = true; UI.pop(this); } }, draw(h) { panel(h, 42, 198, 396, 58); h.rect(52, 191, textWidth(CAST.bellows.name) + 12, 13, 'navy'); drawText(h, 58, 194, CAST.bellows.name, { color: 'white' }); wrap(punch.slice(0, Math.floor(this.chars)), 372).forEach((l, i) => drawText(h, 54, 210 + i * LINE_H, l, { color: 'ink' })); const ready = this.chars >= punch.length; const b = Math.floor(UI.time * 6) % 2; if (ready) { panel(h, 190, 150, 100, 28, { fill: b ? 'red' : 'sand' }); promptRow(h, 240, 158, [['confirm', 'LAUGH!']], { align: 'center', color: b ? 'white' : 'ink', shadow: false }); } } }; }\n// ---- Auction: three lots, AI bidders with hidden limits, a going-once clock\nHOSTS_TALK.pemberton = function* (actor) {\n  const w = G.world, h = hourOf(w.clock); yield say('pemberton', line(HOSTS.pemberton), { actor }); if ((h < 10 || h >= 18) && !G.noHours) { yield say('pemberton', 'Closed-closed-closed-ten-till-six-sleep-now-please.', { actor }); return; } const lots = w.auction?.lots ?? []; const left = lots.filter((l) => !l.done);\n  const p = yield ask('pemberton', `${left.length}-lots-left-today-paddle-or-consign?`, ['Bid on a lot', 'Consign something', 'Bye'], { actor, cancel: 2 });\n  if (p === 0) { if (!left.length) { yield say('pemberton', 'All-sold-come-back-tomorrow.', { actor }); return; } const lot = left[0]; const s = auctionScreen(lot); UI.push(s); yield until(() => s.closed); lot.done = true; w.stats.auctions = (w.stats.auctions ?? 0) + 1; if (s.won) { if (w.p.beans >= s.price && giveItem(w, { id: lot.id })) { w.p.beans -= s.price; w.catalog[lot.id] = true; w.stats.auctionsWon = (w.stats.auctionsWon ?? 0) + 1; G.ctx.audio.play('gavel'); bus.emit('auctionWon', lot); yield say('pemberton', `Sold-to-the-small-round-person-for-${fmt(s.price)}-well-done-do-not-wave.`, { actor }); } else yield say('pemberton', 'You-cannot-pay-that-is-very-embarrassing-for-us-both-next-bidder.', { actor }); } else yield say('pemberton', 'Sold-to-the-otter-in-the-damp-hat-better-luck.', { actor }); }\n  if (p === 1) { let c = null; UI.push(pocketsScreen({ title: 'Consign to Pemberton', pickLabel: 'Consign', onPick: (e, i, sc) => { c = { e, i }; UI.pop(sc); }, onClose: () => { c = c ?? false; } })); yield until(() => c !== null); if (!c) return; const it = ITEMS[c.e.id]; if (it.noSell) { yield say('pemberton', 'Not-that.', { actor }); return; } w.p.pockets[c.i] = null; const r = R(); const price = Math.round((it.price || 100) * r.range(0.8, 1.9)); w.mailQueue.push({ from: 'pemberton', subject: \"Pemberton's: Result of Sale\", body: `Your-${it.name}-sold-for-${fmt(price)}-to-a-damp-otter. Beans enclosed. Commission-modest-and-mine.`, gift: 'bag', giftValue: price, at: w.clock.day + 1, consigned: true }); w.stats.consigned = (w.stats.consigned ?? 0) + 1; bus.emit('consigned', it); yield say('pemberton', 'Lovely-lot. Result-by-post-tomorrow.', { actor }); }\n};\nconst BIDDERS = ['Damp Otter', 'Mink in a Hat', 'The Coat Stand'];\nfunction auctionScreen(lot) { const w = G.world; const it = ITEMS[lot.id]; const r = R(); const start = Math.round(it.price * 0.4); return { id: 'auction', title: 'Pemberton\\'s', closed: false, won: false, price: start, leader: null, clock: 1.2, stage: 0, t2: 0, aiT: 1.1, log: 'Lot up! Who\\'ll start me off?', freezes: true, lot, step: Math.max(50, Math.round(it.price * 0.08)), get prompts() { return [['confirm', 'Raise paddle'], ['back', 'Drop out']]; }, focusLabel: () => 'paddle', itemsModel() { return [String(this.price)]; }, input(c, dt) { this.t2 += dt; this.aiT -= dt; this.clock -= dt; const raise = (who) => { this.price += this.step; this.leader = who; this.clock = 1.4; this.stage = 0; G.ctx.audio.play('paddle'); this.log = `${who === 'you' ? 'You' : BIDDERS[who]}: ${fmt(this.price)}!`; if (who === 'you') { G.player.actor.play('Wave', { then: 'Idle', restart: true }); this.paddle = 0.3; } }; if ((c.confirm() || c.clickL()) && this.leader !== 'you') { if (w.p.beans >= this.price + this.step) raise('you'); else { UI.sfx('uiNo'); this.log = 'You have not the beans. Pemberton looked. Quickly.'; } } if (c.back()) { this.leader = this.leader === 'you' ? this.leader : (this.leader ?? 0); if (this.leader !== 'you') { this.finish(); return; } } if (this.aiT <= 0) { this.aiT = r.range(0.5, 1.3); const want = lot.limits.map((v, i) => ({ v, i })).filter((b) => b.i !== this.leader && b.v > this.price + this.step); if (want.length && (this.leader === 'you' || this.leader == null || r.chance(0.6))) raise(r.pick(want).i); } if (this.clock <= 0) { this.stage++; this.clock = 1.1; G.ctx.audio.play('uiTick'); this.log = ['', 'Going once…', 'Going twice…', 'Gone!'][this.stage] ?? this.log; if (this.stage >= 3) { G.ctx.audio.play('gavel'); this.finish(); } } this.paddle = Math.max(0, (this.paddle ?? 0) - dt); }, finish() { this.won = this.leader === 'you'; this.closed = true; UI.pop(this); }, draw(h) { panel(h, 60, 12, 360, 120); drawIcon(h, 76, 28, it, 5); drawText(h, 150, 24, it.name, { color: 'navy' }); drawText(h, 150, 42, `Current bid: ${fmt(this.price)} beans`, { color: 'orange' }); drawText(h, 150, 58, this.leader == null ? 'No bids yet' : this.leader === 'you' ? 'You are winning. Do not scratch your nose.' : `${BIDDERS[this.leader]} leads`, { color: 'ink' }); drawText(h, 150, 74, this.log, { color: 'red' }); const t = clamp(this.clock / 1.4, 0, 1); h.rect(150, 92, 240, 8, 'mist'); h.rect(150, 92, Math.round(240 * t), 8, this.stage ? 'red' : 'lime'); drawText(h, 150, 104, `You have ${fmt(w.p.beans)} beans`, { color: 'slate' }); promptRow(h, 240, 140, [['confirm', 'Raise paddle'], ['back', 'Drop out']], { align: 'center', back: 'ink' }); } }; }\n// ---- Bureau, café, fortunes\nHOSTS_TALK.brisket = function* (actor) { const w = G.world; yield say('brisket', line(HOSTS.brisket), { actor }); const r = homeScore(w); const p = yield ask('brisket', 'How may the Bureau inconvenience you?', ['Critique my home', 'Explain the scoring', 'Bye'], { actor, cancel: 2 }); if (p === 0) { w.stats.critiques = (w.stats.critiques ?? 0) + 1; bus.emit('critique'); yield say('brisket', `I've seen your home. Grade: ${r.grade}. ${r.critique}`, { actor }); const reward = gradeReward(w, r.grade); if (reward) { giveItem(w, { id: reward }); G.ctx.audio.play('reveal'); yield say('brisket', `A new grade. The Bureau issues you this: ${ITEMS[reward].name}. Do not read anything into it. We don't.`, { actor }); } } if (p === 1) yield say('brisket', 'Value of items. Sets of four or more. Colour harmony. Cozy rules: a lamp by a seat, a rug under a table, something growing. Music playing. Minus clutter. | We score on Show Day nights. The result comes by mail. We have a key.', { actor }); };\nconst BLENDS = [['The Slow One', 400], ['The Slower One', 600], ['Just Foam', 800]];\nHOSTS_TALK.lou = function* (actor) { const w = G.world; yield say('lou', line(HOSTS.lou), { actor }); const p = yield ask('lou', '…Blend…?', [...BLENDS.map(([n, c]) => `${n}, ${c}`), 'Nothing'], { actor, cancel: 3 }); if (p >= 3) { yield say('lou', '…Fine…', { actor }); return; } const [n, c] = BLENDS[p]; if (w.p.beans < c) { yield say('lou', '…Beans…?', { actor }); return; } w.p.beans -= c; G.ctx.audio.play('coffee'); w.p.buffs.coffee = true; w.stats.coffee = (w.stats.coffee ?? 0) + 1; bus.emit('coffee'); G.player.actor.play('Eat', { then: 'Idle' }); const s = String(info(w).season); const rare = [...FISH_LIST, ...BUG_LIST].filter((x) => x.rare && x.seasons.includes(s)); const hint = rare.length ? R().pick(rare) : null; const hintText = hint ? `${hint.name.split(' ')[0]}… ${hint.where ?? 'trunks'}… ${hint.hours ? (hint.hours[0] >= 18 ? 'night' : 'dawn') : 'soon'}…` : 'Nothing… much… today…'; yield say('lou', `…${hintText}`, { actor }); yield say('narrator', 'You feel extremely fast until noon. Your feet have been told about it.'); };\nconst LUCKS = [['fish', 'luckFish', 'I see fish. Great shoals of— (chew) —anyway. Fish. Good ones.'], ['finds', 'luckFinds', 'You will find something in the ground. It might be— (chew) —mm. That was the good part.'], ['friends', 'luckFriends', 'A friend will say something kind to you. Or a fiend. The card has a bite out of it.']];\nHOSTS_TALK.nibbles = function* (actor) { const w = G.world; if (w.flags.fortuneDay === w.clock.day) { yield say('nibbles', \"You've had yours. I've had yours too. It was delicious.\", { actor }); return; } yield say('nibbles', line(HOSTS.nibbles), { actor }); const p = yield ask('nibbles', 'Two hundred beans, and cross my card with… oh, I ate the rest of that.', ['Read my fortune', 'No thanks'], { actor, cancel: 1 }); if (p) return; if (w.p.beans < 200) { yield say('nibbles', \"The cards say you're broke. That one I didn't need to eat.\", { actor }); return; } w.p.beans -= 200; w.flags.fortuneDay = w.clock.day; const [k, buff, text] = R().pick(LUCKS); w.p.buffs[buff] = 1; w.stats.fortunes = (w.stats.fortunes ?? 0) + 1; bus.emit('fortune', k); G.ctx.audio.play('eat'); NPC.actors.nibbles.play('Eat', { then: 'Idle' }); yield say('nibbles', text, { actor }); yield say('narrator', `Your luck with ${k} feels nudged, until morning.`); };\nG.cityDoor = (f) => { const w = G.world, h = hourOf(w.clock); if (f.id === 'magda' && !(h >= 19 || h < 5) && !G.noHours) return Script.run((function* () { yield say('narrator', \"A blank door down an alley. A note says: 'After dark. Bring cash. This note does not exist.'\"); })()); if (f.id === 'auction' && (h < 10 || h >= 18) && !G.noHours) return Toasts.add('Closed. A very small snoring comes through the letterbox.'); if (f.id === 'theatre' && (h < 18) && !G.noHours) return Toasts.add('The Palace opens at six. A hippo is rehearsing, very loudly, in the dark.'); enterRoom(f.room); };\nE\ncat >> ../PROGRESS.md <<'E'\nDone: systems/city. Next: year (festivals, contests, vesper, rocco, ending, pimm, stars, snow), dayone; ui/shell; game.js,main.js; net; tests.\nE","description":"Write the bus, the City and all venues"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13968,"cache_read_input_tokens":446879,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13968},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f147b5a-afdb-41c5-bbfc-62264f8c7cee","uuid":"fa4a41a3-f1f3-44fb-b28c-0ba92680c447","timestamp":"2026-11-06T01:05:11.933Z","request_id":"req_011CgkmobFCEDsTDWFzsoGhE","wire_tool_inputs":{"toolu_01HqZ6hujJHswVQPQVSJLerF":{"command":"cat > src/systems/city.js <<'E'\n// The bus, the boulevard, the crowd, and eight venues, each with something that isn't a menu.\nimport { THREE, buildModel, toonMaterial, PALETTE, setLookLayer } from '../engine.js';\nimport { G, bus } from '../state.js';\nimport { HOSTS_TALK } from './talk.js';\nimport { Script, say, ask, Toasts, until, fill } from '../ui/dialogue.js';\nimport { HOSTS, BALLAD, GOSSIP } from '../data/lines.js';\nimport { UI, panel, promptRow, menu, hit, hitAt, dim, para } from '../ui/kit.js';\nimport { drawText, wrap, textWidth, LINE_H } from '../ui/font.js';\nimport { drawIcon } from '../ui/icons.js';\nimport { pocketsScreen, itemCard } from '../ui/screens.js';\nimport { ITEMS, CLOTHES, EMOTES, EMOTE_CLIP, FISH_LIST, BUG_LIST } from '../data/items.js';\nimport { T } from '../dev/tuning.js';\nimport { earn, giveItem, remember, info } from '../core/world.js';\nimport { fmt, rngOf, clamp } from '../core/util.js';\nimport { hourOf, SEASONS } from '../core/calendar.js';\nimport { NPC } from '../actors/npcs.js';\nimport { CAST, NEIGHBOURS, nameOf } from '../data/cast.js';\nimport { setPlace, Trans, enterRoom } from '../world/places.js';\nimport { CITY, LANDMARK } from '../world/layout.js';\nimport { M } from '../audio/music.js';\nimport { speakChar } from '../audio/voice.js';\nimport { railFlow, buyItem } from './services.js';\nimport { homeScore, gradeReward } from './home.js';\nimport { HAIRS, EYE_STYLES, critterDef } from '../art/critter.js';\nimport { Actor } from '../actors/actor.js';\nimport { paintingTexture, PAINT_ROWS, PAINT_COL, FORGERY } from '../art/textures.js';\nimport { addTargets } from './interact.js';\nconst R = () => rngOf(`${G.world.seed}:c:${G.world.clock.day}:${G.world.clock.minute}:${G.time}`);\nconst line = (arr) => R().pick(arr);\n// ---- The bus: a threshold you feel\nexport function balladVerse(w, r) {\n  const mem = w.memory.slice(-16).reverse(); const caught = mem.find((m) => m.k === 'caught' && m.cat === 'fish'), bug = mem.find((m) => m.k === 'caught' && m.cat === 'bug'), gift = mem.find((m) => m.k === 'gift'), sold = mem.find((m) => m.k === 'sold'), gone = mem.find((m) => m.k === 'soldGift'), bought = mem.find((m) => m.k === 'bought');\n  const tags = { catch: (caught?.item ?? 'an old boot').toLowerCase(), price: sold ? fmt(ITEMS[caught?.id]?.price ?? 10) : 'ten', debt: fmt(w.p.debt), bug: (bug?.item ?? 'butterfly').toLowerCase(), neighbour: nameOf(gift?.who ?? r.pick(NEIGHBOURS.slice(0, 8))), item: (gift?.item ?? bought?.item ?? 'hat').toLowerCase(), fossil: 'very old bone', pockets: String(w.p.pockets.filter(Boolean).length), season: SEASONS[info(w).season], tree: 'pears', player: w.name, town: w.town };\n  const candidates = BALLAD.verses.filter((v, i) => { if (v.includes('{catch}')) return !!caught; if (v.includes('{bug}')) return !!bug; if (v.includes('{item}') && i === 3) return !!gift; if (v.includes('sold it, you sold it')) return !!gone; return true; });\n  return fill(r.pick(candidates), tags);\n}\nconst Ride = { active: false };\nfunction busGroup() { if (Ride.group) return Ride.group; const g = new THREE.Group(); g.position.set(-2000, 0, 0); const m = buildModel('bus', {}).object; m.traverse((x) => { if (x.isMesh) x.castShadow = true; }); g.add(m); Ride.bus = m; G.ctx.scene.add(g); Ride.props = []; Ride.ground = new THREE.Mesh(new THREE.PlaneGeometry(90, 90).rotateX(-Math.PI / 2), toonMaterial(PALETTE.green)); g.add(Ride.ground); const road = new THREE.Mesh(new THREE.PlaneGeometry(4.6, 90).rotateX(-Math.PI / 2), toonMaterial(PALETTE.slate)); road.position.y = 0.02; g.add(road); for (let i = 0; i < 12; i++) { const dash = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.02, 1.4), toonMaterial(PALETTE.sand)); dash.position.set(-0.9, 0.04, -40 + i * 7); g.add(dash); Ride.props.push({ o: dash, loop: 84 }); } const r = rngOf('ride'); for (let i = 0; i < 26; i++) { const side = i % 2 ? 1 : -1; const t = buildModel(i % 3 === 0 ? 'pine-tree' : 'pear-tree', i % 3 === 0 ? {} : { palette: { leaf: 'green', leaf2: 'lime' } }).object; t.position.set(side * r.range(5, 16), 0, -42 + i * 3.3); g.add(t); Ride.props.push({ o: t, loop: 84 }); } Ride.group = g; g.visible = false; return g; }\nexport function busRide(dest) {\n  const w = G.world, r = rngOf(`${w.seed}:ride:${w.clock.day}:${w.clock.minute}`);\n  return (function* () {\n    let ready = false; Trans.go(() => { const g = busGroup(); g.visible = true; G.view.town.visible = false; G.view.city.visible = false; for (const rr of Object.values(G.rooms)) rr.group.visible = false; Ride.active = true; Ride.ground.material = toonMaterial(PALETTE[['lime', 'green', 'sand', 'white'][info(w).season]]); G.player.actor.visible = false; M.override = 'bus'; ready = true; }); yield until(() => ready);\n    G.ctx.audio.play('busHorn'); G.ctx.audio.play('busEngine');\n    const scr = rideScreen(w, r, dest); UI.push(scr); yield until(() => scr.closed);\n    let done = false; Trans.go(() => { Ride.group.visible = false; Ride.active = false; M.override = null; G.player.actor.visible = true; if (dest === 'city') setPlace('city', CITY.stop[0] + CITY.ox, CITY.stop[1] + 1.2, Math.PI / 2); else setPlace('town', LANDMARK.busStop[0], LANDMARK.busStop[1] + 0.8, 0); done = true; w.stats.rides = (w.stats.rides ?? 0) + 1; bus.emit('rode', dest); }); yield until(() => done);\n  })();\n}\nfunction rideScreen(w, r, dest) {\n  const verses = [balladVerse(w, r), r.pick(BALLAD.chorus), balladVerse(w, r), r.pick(BALLAD.chorus)]; const dur = 20; const melody = [0, 2, 4, 7, 4, 2, 0, -3, 0, 4, 7, 9, 7, 4, 2, 0];\n  return { id: 'busride', title: 'The Bus', t2: 0, v: 0, chars: 0, closed: false, freezes: true, opaque: false, verses, get prompts() { return [['back', 'Skip']]; }, itemsModel() { return verses.slice(); }, focusLabel() { return verses[this.v]; },\n    input(c, dt) { this.t2 += dt; const text = verses[this.v]; const before = Math.floor(this.chars); this.chars = Math.min(text.length, this.chars + dt * 16); for (let i = before; i < Math.floor(this.chars); i++) speakChar(G.ctx.audio, CAST.hester, text[i], i, text, 1, CAST.hester.voice.pitch + melody[i % melody.length]); if (this.chars >= text.length && (this.hold = (this.hold ?? 0) + dt) > 1.2) { this.hold = 0; this.v = (this.v + 1) % verses.length; this.chars = 0; }\n      if (Ride.bus) { Ride.bus.rotation.z = Math.sin(this.t2 * 6) * 0.012; Ride.bus.position.y = Math.abs(Math.sin(this.t2 * 8)) * 0.04; } for (const p of Ride.props ?? []) { p.o.position.z += dt * 11; if (p.o.position.z > 42) p.o.position.z -= p.loop; }\n      if (this.t2 > dur || c.back() || c.confirm()) { this.closed = true; UI.pop(this); G.ctx.audio.play('busBrake'); } },\n    draw(h) { panel(h, 42, 200, 396, 56); h.rect(52, 193, textWidth('Hester') + 12, 13, 'navy'); drawText(h, 58, 196, 'Hester', { color: 'white' }); const lines = wrap(verses[this.v].slice(0, Math.floor(this.chars)), 372); lines.forEach((l, i) => drawText(h, 54, 212 + i * LINE_H, l, { color: 'ink' })); promptRow(h, 440, 258, [['back', 'Skip']], { align: 'right', back: 'ink' }); drawText(h, 240, 8, dest === 'city' ? 'To the Big City' : `Home to ${w.town}`, { color: 'white', align: 'center', shadow: 'ink' }); } };\n}\nexport const rideFocus = () => (Ride.active ? new THREE.Vector3(-2000, 1, 0) : null);\nG.bus = { call(from) { const w = G.world; if (w.guest) return Toasts.add(\"Bus doesn't run while you have company.\"); if (G.visit?.hosting?.()) return Toasts.add(\"Bus doesn't run while you have company.\"); if (w.day1 && !w.day1.done && !G.noHours) return Script.run((function* () { yield say('hester', \"Not today. You've got a goose to see. Come back when you're not on the clock.\"); })()); Script.run((function* () { G.player.state = 'free'; G.ctx.audio.play('busHorn'); yield 0.3; if (from === 'town') { const p = yield ask('narrator', 'The bus has arrived. It was here all along, somehow.', ['To the Big City', 'Not now'], { cancel: 1 }); if (p) return; yield* busRide('city'); } else { const p = yield ask('narrator', 'The last bus. There is always a last bus.', [`Home to ${w.town}`, 'Stay a bit'], { cancel: 1 }); if (p) return; yield* busRide('town'); } })()); } };\n// ---- Crowd: assorted species walking the boulevard\nconst WAY = [[6, 8], [14, 8], [22, 8], [30, 8], [38, 8], [44, 8], [38, 14], [30, 14], [22, 14], [14, 14], [6, 14], [26, 15.5], [36, 21], [28, 21], [36, 16]].map(([x, z]) => [x + CITY.ox, z]);\nconst SPP = ['tapir', 'otter', 'toucan', 'walrus', 'newt', 'mink', 'tapir', 'otter', 'walrus', 'newt', 'mink', 'toucan', 'tapir', 'mink'];\nconst CROWD_LINES = [\"…so I said, that's not a pigeon, that's my solicitor…\", \"…they've closed the good bakery. Now it's a bad bakery…\", \"…four hundred beans for a coffee, and it was mostly the sloth…\", \"…I've moved to the City for the anonymity. Hello, I'm Brian…\", \"…have you seen the prices at Pemberton's? Have you heard them?…\", \"…she's a flamingo, Gerald. That's just how they stand…\", \"…you can tell it's real art because it's stolen…\", \"…the theatre's marvellous. I've no idea what happens…\", \"…mind the bus. It sings…\", \"…I knew a goose, once. I still do. I still owe her…\", \"…nobody looks up here. Look. There. See? Nothing…\", \"…every Sunday, I come here and I walk that way. Then I walk back…\"];\nexport const Crowd = { list: [], init() { const g = new THREE.Group(); this.group = g; G.ctx.scene.add(g); const r = rngOf('crowd'); const cols = ['sand', 'mist', 'orange', 'slate', 'plum', 'teal']; const shirts = ['red', 'blue', 'green', 'navy', 'plum', 'sand', 'white', 'teal']; this.list = SPP.map((sp, i) => { const a = new Actor(critterDef({ id: `crowd${i}`, species: sp, c1: cols[i % cols.length], c2: 'white', shirt: shirts[i % shirts.length], trousers: 'navy', shoes: 'ink' }), { seed: i * 7, scale: r.range(0.85, 1) }); a.addTo(g); const way = i % WAY.length; return { a, way, x: WAY[way][0], z: WAY[way][1], name: `${sp[0].toUpperCase()}${sp.slice(1)} in a hurry`, line: CROWD_LINES[i % CROWD_LINES.length], sp: r.range(1.4, 2.4), pause: 0 }; }); this.musician = new Actor(critterDef({ id: 'musician', species: 'walrus', c1: 'plum', c2: 'mist', shirt: 'red', trousers: 'ink', shoes: 'ink', hat: 'tophat', hatColor: 'ink' }), { seed: 3 }); this.musician.addTo(g); this.musician.place(CITY.ox + 28, 0, 15.8); this.musician.facing = this.musician.targetFacing = Math.PI / 4; this.musician.play('Sway'); },\n  fixed(dt) { if (G.world.p.place !== 'city') return; for (const c of this.list) { if (c.pause > 0) { c.pause -= dt; continue; } const [tx, tz] = WAY[c.way]; const dx = tx - c.x, dz = tz - c.z, d = Math.hypot(dx, dz); if (d < 0.2) { c.way = (c.way + 1) % WAY.length; if (c.way === 11 && (this.list.indexOf(c) % 2)) c.way = 0; continue; } c.x += (dx / d) * c.sp * dt; c.z += (dz / d) * c.sp * dt; c.face = Math.atan2(dx, dz); } },\n  update(dt) { const on = G.world.p.place === 'city'; this.group.visible = on; if (!on) return; for (const c of this.list) { c.a.place(c.x, 0, c.z); if (c.face != null) c.a.targetFacing = c.face; c.a.play(c.pause > 0 ? 'Listen' : 'Walk'); c.a.update(dt); } this.musician.update(dt); } };\nG.crowdList = () => (G.world.p.place === 'city' ? Crowd.list : []);\nG.crowdTalk = (c) => { c.pause = 3; Script.run((function* () { const scr = say('narrator', c.line, { name: c.name, freezes: false }); yield scr; })()); };\n// ---- Salon: live preview on a turntable\nHOSTS_TALK.fleece = function* (actor) { const w = G.world; yield say('fleece', line(HOSTS.fleece.filter((l) => !l.includes('{gossip}'))), { actor }); const p = yield ask('fleece', 'You will sit in the chair, yes? Fifteen hundred beans. The hair, it does not cut itself. Yet.', ['Sit', 'Not today'], { actor, cancel: 1 }); if (p === 0) yield* cutFlow(actor); };\nfunction* cutFlow(actor) { const w = G.world; if (w.p.beans < 1500 * T.buy) { yield say('fleece', 'Your pockets, they are bald. Come back.', { actor }); return; } const start = { ...w.p.look }; const s = salonScreen(); UI.push(s); yield until(() => s.closed); if (!s.kept) { Object.assign(w.p.look, start); G.player.rebuild(); yield say('fleece', 'You are afraid. I understand. It is a lot of hair.', { actor }); return; } w.p.beans -= Math.round(1500 * T.buy); w.stats.cuts = (w.stats.cuts ?? 0) + 1; remember(w, 'haircut'); bus.emit('cut'); G.ctx.audio.play('snip'); const names = NEIGHBOURS.slice(0, 8); const g = fill(R().pick(GOSSIP), { n1: nameOf(R().pick(names)), n2: nameOf(R().pick(names)) }); yield say('fleece', `Voilà. One piece of gossip per cut, this is the rule. So: ${g}`, { actor }); }\nfunction salonScreen() { const w = G.world; const COLORS = ['orange', 'ink', 'sand', 'red', 'plum', 'blue', 'white', 'lime']; const rows = [{ key: 'hair', label: 'Hair', list: HAIRS.map((_, i) => i), name: (v) => HAIRS[v] }, { key: 'hairColor', label: 'Colour', list: COLORS, name: (v) => v }, { key: 'eyes', label: 'Eyes', list: EYE_STYLES.map((_, i) => i), name: (v) => EYE_STYLES[v] }]; return { id: 'salon', title: 'The Chair', focus: 0, closed: false, kept: false, freezes: true, get prompts() { return this._p; }, focusLabel() { return rows[this.focus]?.label ?? 'Keep'; }, itemsModel() { return rows.map((r) => r.label); }, spin: 0, input(c, dt) { const n = c.nav; if (n === 'up') this.focus = (this.focus + 3) % 4; if (n === 'down') this.focus = (this.focus + 1) % 4; const row = rows[this.focus]; if ((n === 'left' || n === 'right') && row) { const i = row.list.indexOf(w.p.look[row.key]); const v = row.list[(i + (n === 'left' ? row.list.length - 1 : 1)) % row.list.length]; w.p.look[row.key] = v; G.player.rebuild(); G.ctx.audio.play('snip'); } this.spin += dt * 1.2; w.p.facing = this.spin; if (c.moved) { const id = hitAt(c.mx, c.my); if (typeof id === 'number') this.focus = id; } const click = c.clickL() && typeof hitAt(c.mx, c.my) === 'number'; if (click) { this.focus = hitAt(c.mx, c.my); if (this.focus < 3) { const r = rows[this.focus]; const i = r.list.indexOf(w.p.look[r.key]); w.p.look[r.key] = r.list[(i + 1) % r.list.length]; G.player.rebuild(); G.ctx.audio.play('snip'); } } if (c.confirm() || (click && this.focus === 3)) { if (this.focus === 3) { this.kept = true; this.close(); } else this.focus = 3; } if (c.back()) { this.close(); } }, close() { this.closed = true; UI.pop(this); }, draw(h) { panel(h, 12, 40, 170, 120); drawText(h, 24, 48, 'The Chair', { color: 'navy' }); rows.forEach((r, i) => { const f = i === this.focus, y = 66 + i * 20; if (f) h.rect(18, y - 3, 158, 18, 'navy'); drawText(h, 24, y + 1, r.label, { color: f ? 'white' : 'ink' }); drawText(h, 170, y + 1, `← ${r.name(w.p.look[r.key])} →`, { color: f ? 'sand' : 'slate', align: 'right' }); hit(18, y - 3, 158, 18, i); }); const f = this.focus === 3; if (f) h.rect(18, 123, 158, 18, 'red'); drawText(h, 24, 127, 'Keep it (1,500 beans)', { color: f ? 'white' : 'ink' }); hit(18, 123, 158, 18, 3); this._p = [['confirm', 'Choose'], ['back', 'Run away']]; promptRow(h, 18, 165, this._p, { back: 'ink' }); } }; }\n// ---- Couture: the fashion check\nconst THEMES = [['Something damp', 'damp'], ['Evening, possibly a funeral', 'evening'], ['Cosy, but threatening', 'cosy'], ['Very loud, indeed', 'loud'], ['The sea, but expensive', 'seaside'], ['Suspiciously clean', 'clean'], ['Practical footwear for a coup', 'practical'], ['The street, but the good street', 'city'], ['Wool. Only wool', 'wool'], ['Absurdly fancy', 'fancy'], ['Outdoors, reluctantly', 'outdoors'], ['Plain, as a threat', 'plain']];\nexport const todayTheme = (w) => THEMES[(w.clock.day * 7 + 3) % THEMES.length];\nexport function judgeOutfit(w, tag) { const items = [w.p.look.shirt, w.p.look.hat, w.p.look.glasses, w.p.look.umbrella && w.p.look.umbrella !== 'u_sand' ? w.p.look.umbrella : null].filter(Boolean).map((i) => ITEMS[i]); let score = 0; const said = []; for (const it of items) { const tags = it?.tags ?? []; if (tags.includes(tag)) { score += 2; said.push(`The ${it.name.toLowerCase()}: *yes*. It understood the brief.`); } else if (tags.includes('fancy')) { score += 1; said.push(`The ${it.name.toLowerCase()}: costly. I felt nothing, expensively.`); } else if (tags.includes('debt')) { said.push(`Is that an apron? Darling. Do you work here?`); } else said.push(`The ${it.name.toLowerCase()}: why?`); } if (w.p.look.pattern != null) { score += 1; said.push('A hand-drawn shirt. How brave. How damp.'); } return { score: clamp(score, 0, 5), said }; }\nHOSTS_TALK.flavia = function* (actor) {\n  const w = G.world; yield say('flavia', line(HOSTS.flavia.filter((l) => !l.includes('{theme}'))), { actor }); const [name, tag] = todayTheme(w); const p = yield ask('flavia', `Today's theme is \"${name}\". Well?`, w.fashion.day === w.clock.day ? ['See the rail', 'Bye'] : ['Be judged', 'See the rail', 'Bye'], { actor, cancel: w.fashion.day === w.clock.day ? 1 : 2 });\n  const judged = w.fashion.day === w.clock.day; if (!judged && p === 0) { const { score, said } = judgeOutfit(w, tag); G.player.actor.play('Idle'); for (const s of said.slice(0, 3)) yield say('flavia', s, { actor }); for (let i = 0; i < score; i++) { G.ctx.audio.play('plume', { pitch: i * 2 }); G.ctx.particles.burst('sparkle', [w.p.x, 1.8, w.p.z], { count: 6, colors: ['red', 'white'] }); yield 0.25; } w.fashion = { day: w.clock.day, score }; w.p.plumes = Math.max(w.p.plumes, 0) + score; w.stats.fashion = (w.stats.fashion ?? 0) + 1; remember(w, 'fashion', { plumes: score }); bus.emit('fashion', score); const a = NPC.actors.flavia; a.play(score >= 4 ? 'Love' : score <= 1 ? 'ShakeHead' : 'Nod', { then: 'Idle' }); yield say('flavia', score === 0 ? 'No plumes. I looked for one. It left.' : score === 5 ? `Five plumes! I'm so moved I'm almost standing on both feet.` : `${score} plume${score > 1 ? 's' : ''}. Treasure ${score > 1 ? 'them' : 'it'}. Lifetime plumes: ${w.p.plumes}.`, { actor }); return; }\n  if ((judged && p === 0) || (!judged && p === 1)) yield* coutureRail(actor);\n};\nfunction* coutureRail(actor) { const w = G.world; const rail = CLOTHES.filter((c) => c.couture && w.p.plumes >= c.couture * 3); if (!rail.length) { yield say('flavia', `You may approach the rail at three plumes. You have ${w.p.plumes}. There's a rope. It's velvet. It's mostly a feeling.`, { actor }); return; } yield* railFlow(rail.map((c) => ({ id: c.id, sold: w.catalog[c.id] })), 'flavia', actor); }\n// ---- Magda: spot the forgery\nHOSTS_TALK.magda = function* (actor) { yield say('magda', line(HOSTS.magda), { actor }); const w = G.world; const rare = w.magda?.rare; const opts = rare && !w.magda.rareSold ? [`Rare furniture: ${ITEMS[rare].name}`, 'Bye'] : ['Bye']; const p = yield ask('magda', 'Three on the easels. Have a look. Lean right in. Or don\\'t.', opts, { actor, cancel: opts.length - 1 }); if (p === 0 && opts.length > 1) { const s = { id: rare, sold: false }; const ok = yield* buyItem(s, 'magda', actor, Math.round(ITEMS[rare].price * 1.5)); if (ok) w.magda.rareSold = true; } };\nG.magdaProp = (idx) => { const w = G.world; const o = w.magda?.offers[idx]; if (!o) return; if (o.sold) return Toasts.add('Just an easel. And a shape where a painting was.'); Script.run((function* () { const s = artCard(o); UI.push(s); yield until(() => s.closed); if (s.bought) { w.p.beans -= o.price; o.sold = true; giveItem(w, { id: o.id, forged: o.forged }); G.ctx.audio.play('pickup'); w.stats.artBought = (w.stats.artBought ?? 0) + 1; bus.emit('artBought', o); yield say('magda', \"Pleasure. You've got a good eye. I've got it in a jar, next to the other one.\", { actor: NPC.actors.magda }); } })()); };\nfunction artCard(o) { const it = ITEMS[o.id]; const s = { id: 'artCard', title: it.name, closed: false, bought: false, freezes: true, focus: 0, offer: o, get prompts() { return this._p; }, focusLabel() { return this.focus ? 'Leave it' : 'Buy'; }, itemsModel() { return ['Buy', 'Leave it']; }, input(c) { if (c.nav === 'left' || c.nav === 'right') { this.focus = 1 - this.focus; UI.sfx('uiTick'); } if (c.moved) { const id = hitAt(c.mx, c.my); if (typeof id === 'number') this.focus = id; } const click = c.clickL() && typeof hitAt(c.mx, c.my) === 'number'; if (click) this.focus = hitAt(c.mx, c.my); if (c.confirm() || click) { if (this.focus === 0) { if (G.world.p.beans < o.price) { UI.sfx('uiNo'); Toasts.add('You have the eye, but not the beans.'); return; } this.bought = true; } this.close(); } if (c.back()) this.close(); }, close() { this.closed = true; UI.pop(this); }, draw(h) { dim(h); panel(h, 40, 24, 400, 196); drawText(h, 240, 32, it.name, { color: 'navy', align: 'center' }); drawPaint(h, 58, 56, it.art, o.forged, 10); drawPaint(h, 262, 56, it.art, false, 10); drawText(h, 138, 44, \"On Magda's easel\", { color: 'slate', align: 'center' }); drawText(h, 342, 44, 'Your catalogue print', { color: 'slate', align: 'center' }); drawText(h, 240, 182, `${fmt(o.price)} beans. \"One hundred percent genuine.\"`, { color: 'orange', align: 'center' }); ['Buy', 'Leave it'].forEach((l, i) => { const f = i === this.focus, x = 150 + i * 100; h.rect(x, 196, 80, 16, f ? 'navy' : 'sand'); drawText(h, x + 40, 200, l, { color: f ? 'white' : 'ink', align: 'center' }); hit(x, 196, 80, 16, i); }); this._p = [['confirm', 'Choose'], ['back', 'Leave']]; promptRow(h, 240, 224, this._p, { align: 'center', back: 'ink' }); } }; return s; }\nexport function drawPaint(h, x, y, id, forged, s = 8) { const rows = PAINT_ROWS[id], H = 12, W = 16; h.rect(x - 3, y - 3, W * s + 6, H * s + 6, 'sand'); for (let r = 0; r < H; r++) for (let c = 0; c < W; c++) { let ch = rows[r]?.[c] ?? rows[0][0]; if (forged && FORGERY[id][0] === c && FORGERY[id][1] === r) ch = FORGERY[id][2]; h.rect(x + c * s, y + r * s, s, s, PAINT_COL[ch] ?? 'mist'); } }\n// ---- Theatre: a sketch; press Laugh on the punchline\nconst SKETCHES = [\n  ['A hippo walks into a bar.', 'The bar says, \"Ow.\"', 'The hippo says, \"Why the long face?\"', 'The bar says: \"I have just told you. A hippo walked into me.\"'],\n  ['I shall now perform the entirety of the Scottish play. In one line.', '…', 'Everybody dies. They had it coming.', 'Thank you. Thank you. There will be no interval, because there is no more play.'],\n  ['\"To be, or not to be,\" I said to the waiter.', 'The waiter said: \"We have the fish.\"', 'I said: \"Is it fresh?\"', 'He said: \"It wishes it wasn\\'t.\"'],\n  ['My agent said, \"You will never work in this town again.\"', 'I said, \"That is wonderful. Which town is it?\"', 'He said, \"Reginald, we are on a bus.\"', 'And that, friends, is how I became a bus actor.'],\n];\nHOSTS_TALK.bellows = function* (actor) { const w = G.world; const h = hourOf(w.clock); yield say('bellows', line(HOSTS.bellows), { actor }); if ((h < 18 || h >= 24) && !G.noHours) { yield say('bellows', 'The curtain rises at six in the evening! Until then, I am merely a large person in a very dark room.', { actor }); return; } const p = yield ask('bellows', 'A short sketch? Do laugh at the end. You will know the end because I will stop.', ['Yes, go on', 'Not tonight'], { actor, cancel: 1 }); if (p) return; const r = R(); const sk = r.pick(SKETCHES); G.ctx.audio.play('curtain'); for (let i = 0; i < sk.length - 1; i++) yield say('bellows', sk[i], { actor }); const s = laughScreen(sk[sk.length - 1]); UI.push(s); yield until(() => s.closed); w.stats.sketches = (w.stats.sketches ?? 0) + 1; bus.emit('sketch', s.hit); if (s.hit) { G.ctx.audio.play('applause'); const learn = EMOTES.find((e) => !w.p.emotes.includes(e)); if (learn) { w.p.emotes.push(learn); G.player.actor.play(EMOTE_CLIP[learn], { then: 'Idle', restart: true }); bus.emit('emoteLearned', learn); yield say('bellows', `Bravo! You have the gift! You have learned to *${learn}*. Use it sparingly, like everything except me.`, { actor }); } else yield say('bellows', 'Bravo! You have nothing left to learn. Go away and be marvellous elsewhere.', { actor }); } else { yield say('bellows', s.early ? 'You laughed *before* the joke. Do you know what that does to an artist?' : 'Nothing? No? I see. There will be a short pause, in which I die.', { actor }); } };\nfunction laughScreen(punch) { return { id: 'laugh', title: 'Laugh!', t2: 0, chars: 0, closed: false, hit: false, early: false, freezes: true, get prompts() { return [['confirm', 'Laugh']]; }, focusLabel: () => 'laugh', input(c, dt) { this.t2 += dt; const before = Math.floor(this.chars); this.chars = Math.min(punch.length, this.chars + dt * 22); for (let i = before; i < Math.floor(this.chars); i++) speakChar(G.ctx.audio, CAST.bellows, punch[i], i, punch); const done = this.chars >= punch.length; if (done) this.after = (this.after ?? 0) + dt; if (c.confirm() || c.clickL()) { if (done) { this.hit = true; G.ctx.audio.play('laugh'); G.player.actor.play('Laugh', { then: 'Idle', restart: true }); } else this.early = true; this.closed = true; UI.pop(this); return; } if (this.after > 2.4) { this.closed = true; UI.pop(this); } }, draw(h) { panel(h, 42, 198, 396, 58); h.rect(52, 191, textWidth(CAST.bellows.name) + 12, 13, 'navy'); drawText(h, 58, 194, CAST.bellows.name, { color: 'white' }); wrap(punch.slice(0, Math.floor(this.chars)), 372).forEach((l, i) => drawText(h, 54, 210 + i * LINE_H, l, { color: 'ink' })); const ready = this.chars >= punch.length; const b = Math.floor(UI.time * 6) % 2; if (ready) { panel(h, 190, 150, 100, 28, { fill: b ? 'red' : 'sand' }); promptRow(h, 240, 158, [['confirm', 'LAUGH!']], { align: 'center', color: b ? 'white' : 'ink', shadow: false }); } } }; }\n// ---- Auction: three lots, AI bidders with hidden limits, a going-once clock\nHOSTS_TALK.pemberton = function* (actor) {\n  const w = G.world, h = hourOf(w.clock); yield say('pemberton', line(HOSTS.pemberton), { actor }); if ((h < 10 || h >= 18) && !G.noHours) { yield say('pemberton', 'Closed-closed-closed-ten-till-six-sleep-now-please.', { actor }); return; } const lots = w.auction?.lots ?? []; const left = lots.filter((l) => !l.done);\n  const p = yield ask('pemberton', `${left.length}-lots-left-today-paddle-or-consign?`, ['Bid on a lot', 'Consign something', 'Bye'], { actor, cancel: 2 });\n  if (p === 0) { if (!left.length) { yield say('pemberton', 'All-sold-come-back-tomorrow.', { actor }); return; } const lot = left[0]; const s = auctionScreen(lot); UI.push(s); yield until(() => s.closed); lot.done = true; w.stats.auctions = (w.stats.auctions ?? 0) + 1; if (s.won) { if (w.p.beans >= s.price && giveItem(w, { id: lot.id })) { w.p.beans -= s.price; w.catalog[lot.id] = true; w.stats.auctionsWon = (w.stats.auctionsWon ?? 0) + 1; G.ctx.audio.play('gavel'); bus.emit('auctionWon', lot); yield say('pemberton', `Sold-to-the-small-round-person-for-${fmt(s.price)}-well-done-do-not-wave.`, { actor }); } else yield say('pemberton', 'You-cannot-pay-that-is-very-embarrassing-for-us-both-next-bidder.', { actor }); } else yield say('pemberton', 'Sold-to-the-otter-in-the-damp-hat-better-luck.', { actor }); }\n  if (p === 1) { let c = null; UI.push(pocketsScreen({ title: 'Consign to Pemberton', pickLabel: 'Consign', onPick: (e, i, sc) => { c = { e, i }; UI.pop(sc); }, onClose: () => { c = c ?? false; } })); yield until(() => c !== null); if (!c) return; const it = ITEMS[c.e.id]; if (it.noSell) { yield say('pemberton', 'Not-that.', { actor }); return; } w.p.pockets[c.i] = null; const r = R(); const price = Math.round((it.price || 100) * r.range(0.8, 1.9)); w.mailQueue.push({ from: 'pemberton', subject: \"Pemberton's: Result of Sale\", body: `Your-${it.name}-sold-for-${fmt(price)}-to-a-damp-otter. Beans enclosed. Commission-modest-and-mine.`, gift: 'bag', giftValue: price, at: w.clock.day + 1, consigned: true }); w.stats.consigned = (w.stats.consigned ?? 0) + 1; bus.emit('consigned', it); yield say('pemberton', 'Lovely-lot. Result-by-post-tomorrow.', { actor }); }\n};\nconst BIDDERS = ['Damp Otter', 'Mink in a Hat', 'The Coat Stand'];\nfunction auctionScreen(lot) { const w = G.world; const it = ITEMS[lot.id]; const r = R(); const start = Math.round(it.price * 0.4); return { id: 'auction', title: 'Pemberton\\'s', closed: false, won: false, price: start, leader: null, clock: 1.2, stage: 0, t2: 0, aiT: 1.1, log: 'Lot up! Who\\'ll start me off?', freezes: true, lot, step: Math.max(50, Math.round(it.price * 0.08)), get prompts() { return [['confirm', 'Raise paddle'], ['back', 'Drop out']]; }, focusLabel: () => 'paddle', itemsModel() { return [String(this.price)]; }, input(c, dt) { this.t2 += dt; this.aiT -= dt; this.clock -= dt; const raise = (who) => { this.price += this.step; this.leader = who; this.clock = 1.4; this.stage = 0; G.ctx.audio.play('paddle'); this.log = `${who === 'you' ? 'You' : BIDDERS[who]}: ${fmt(this.price)}!`; if (who === 'you') { G.player.actor.play('Wave', { then: 'Idle', restart: true }); this.paddle = 0.3; } }; if ((c.confirm() || c.clickL()) && this.leader !== 'you') { if (w.p.beans >= this.price + this.step) raise('you'); else { UI.sfx('uiNo'); this.log = 'You have not the beans. Pemberton looked. Quickly.'; } } if (c.back()) { this.leader = this.leader === 'you' ? this.leader : (this.leader ?? 0); if (this.leader !== 'you') { this.finish(); return; } } if (this.aiT <= 0) { this.aiT = r.range(0.5, 1.3); const want = lot.limits.map((v, i) => ({ v, i })).filter((b) => b.i !== this.leader && b.v > this.price + this.step); if (want.length && (this.leader === 'you' || this.leader == null || r.chance(0.6))) raise(r.pick(want).i); } if (this.clock <= 0) { this.stage++; this.clock = 1.1; G.ctx.audio.play('uiTick'); this.log = ['', 'Going once…', 'Going twice…', 'Gone!'][this.stage] ?? this.log; if (this.stage >= 3) { G.ctx.audio.play('gavel'); this.finish(); } } this.paddle = Math.max(0, (this.paddle ?? 0) - dt); }, finish() { this.won = this.leader === 'you'; this.closed = true; UI.pop(this); }, draw(h) { panel(h, 60, 12, 360, 120); drawIcon(h, 76, 28, it, 5); drawText(h, 150, 24, it.name, { color: 'navy' }); drawText(h, 150, 42, `Current bid: ${fmt(this.price)} beans`, { color: 'orange' }); drawText(h, 150, 58, this.leader == null ? 'No bids yet' : this.leader === 'you' ? 'You are winning. Do not scratch your nose.' : `${BIDDERS[this.leader]} leads`, { color: 'ink' }); drawText(h, 150, 74, this.log, { color: 'red' }); const t = clamp(this.clock / 1.4, 0, 1); h.rect(150, 92, 240, 8, 'mist'); h.rect(150, 92, Math.round(240 * t), 8, this.stage ? 'red' : 'lime'); drawText(h, 150, 104, `You have ${fmt(w.p.beans)} beans`, { color: 'slate' }); promptRow(h, 240, 140, [['confirm', 'Raise paddle'], ['back', 'Drop out']], { align: 'center', back: 'ink' }); } }; }\n// ---- Bureau, café, fortunes\nHOSTS_TALK.brisket = function* (actor) { const w = G.world; yield say('brisket', line(HOSTS.brisket), { actor }); const r = homeScore(w); const p = yield ask('brisket', 'How may the Bureau inconvenience you?', ['Critique my home', 'Explain the scoring', 'Bye'], { actor, cancel: 2 }); if (p === 0) { w.stats.critiques = (w.stats.critiques ?? 0) + 1; bus.emit('critique'); yield say('brisket', `I've seen your home. Grade: ${r.grade}. ${r.critique}`, { actor }); const reward = gradeReward(w, r.grade); if (reward) { giveItem(w, { id: reward }); G.ctx.audio.play('reveal'); yield say('brisket', `A new grade. The Bureau issues you this: ${ITEMS[reward].name}. Do not read anything into it. We don't.`, { actor }); } } if (p === 1) yield say('brisket', 'Value of items. Sets of four or more. Colour harmony. Cozy rules: a lamp by a seat, a rug under a table, something growing. Music playing. Minus clutter. | We score on Show Day nights. The result comes by mail. We have a key.', { actor }); };\nconst BLENDS = [['The Slow One', 400], ['The Slower One', 600], ['Just Foam', 800]];\nHOSTS_TALK.lou = function* (actor) { const w = G.world; yield say('lou', line(HOSTS.lou), { actor }); const p = yield ask('lou', '…Blend…?', [...BLENDS.map(([n, c]) => `${n}, ${c}`), 'Nothing'], { actor, cancel: 3 }); if (p >= 3) { yield say('lou', '…Fine…', { actor }); return; } const [n, c] = BLENDS[p]; if (w.p.beans < c) { yield say('lou', '…Beans…?', { actor }); return; } w.p.beans -= c; G.ctx.audio.play('coffee'); w.p.buffs.coffee = true; w.stats.coffee = (w.stats.coffee ?? 0) + 1; bus.emit('coffee'); G.player.actor.play('Eat', { then: 'Idle' }); const s = String(info(w).season); const rare = [...FISH_LIST, ...BUG_LIST].filter((x) => x.rare && x.seasons.includes(s)); const hint = rare.length ? R().pick(rare) : null; const hintText = hint ? `${hint.name.split(' ')[0]}… ${hint.where ?? 'trunks'}… ${hint.hours ? (hint.hours[0] >= 18 ? 'night' : 'dawn') : 'soon'}…` : 'Nothing… much… today…'; yield say('lou', `…${hintText}`, { actor }); yield say('narrator', 'You feel extremely fast until noon. Your feet have been told about it.'); };\nconst LUCKS = [['fish', 'luckFish', 'I see fish. Great shoals of— (chew) —anyway. Fish. Good ones.'], ['finds', 'luckFinds', 'You will find something in the ground. It might be— (chew) —mm. That was the good part.'], ['friends', 'luckFriends', 'A friend will say something kind to you. Or a fiend. The card has a bite out of it.']];\nHOSTS_TALK.nibbles = function* (actor) { const w = G.world; if (w.flags.fortuneDay === w.clock.day) { yield say('nibbles', \"You've had yours. I've had yours too. It was delicious.\", { actor }); return; } yield say('nibbles', line(HOSTS.nibbles), { actor }); const p = yield ask('nibbles', 'Two hundred beans, and cross my card with… oh, I ate the rest of that.', ['Read my fortune', 'No thanks'], { actor, cancel: 1 }); if (p) return; if (w.p.beans < 200) { yield say('nibbles', \"The cards say you're broke. That one I didn't need to eat.\", { actor }); return; } w.p.beans -= 200; w.flags.fortuneDay = w.clock.day; const [k, buff, text] = R().pick(LUCKS); w.p.buffs[buff] = 1; w.stats.fortunes = (w.stats.fortunes ?? 0) + 1; bus.emit('fortune', k); G.ctx.audio.play('eat'); NPC.actors.nibbles.play('Eat', { then: 'Idle' }); yield say('nibbles', text, { actor }); yield say('narrator', `Your luck with ${k} feels nudged, until morning.`); };\nG.cityDoor = (f) => { const w = G.world, h = hourOf(w.clock); if (f.id === 'magda' && !(h >= 19 || h < 5) && !G.noHours) return Script.run((function* () { yield say('narrator', \"A blank door down an alley. A note says: 'After dark. Bring cash. This note does not exist.'\"); })()); if (f.id === 'auction' && (h < 10 || h >= 18) && !G.noHours) return Toasts.add('Closed. A very small snoring comes through the letterbox.'); if (f.id === 'theatre' && (h < 18) && !G.noHours) return Toasts.add('The Palace opens at six. A hippo is rehearsing, very loudly, in the dark.'); enterRoom(f.room); };\nE\ncat >> ../PROGRESS.md <<'E'\nDone: systems/city. Next: year (festivals, contests, vesper, rocco, ending, pimm, stars, snow), dayone; ui/shell; game.js,main.js; net; tests.\nE","description":"Write the bus, the City and all venues"}}}
