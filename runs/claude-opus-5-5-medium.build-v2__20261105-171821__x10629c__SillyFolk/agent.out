ox', 'Mailbox with a flag', ['town'], [cyl(0.12, 0.9, 0.12, [0, 0.45, 0], 'plum'), box(0.5, 0.36, 0.34, [0, 1.02, 0], 'blue'), { group: [box(0.04, 0.3, 0.04, [0, 0.15, 0], 'ink'), box(0.2, 0.14, 0.04, [0.1, 0.24, 0], 'red')], at: [0.28, 1, 0.02], pivot: true, name: 'Flag' }]);\nexport const dock = M('sf-dock', 'Dock planks', ['town'], [box(3, 0.14, 8, [0, 0.07, 0], 'orange'), ...[-3.5, -1.5, 0.5, 2.5].flatMap((z) => [box(0.2, 1, 0.2, [1.4, -0.1, z], 'plum', { floats: true }), box(0.2, 1, 0.2, [-1.4, -0.1, z], 'plum')])], { floats: true });\nexport const cheeseChair = M('cheese-chair', 'Wedge of cheese you can sit on', ['furniture'], [wedge(0.8, 0.9, 0.8, [0, 0.45, 0], 'sand', { rot: [0, 180, 0] }), cyl(0.2, 0.03, 0.2, [0.15, 0.91, -0.1], 'orange')]);\nexport const cheeseTable = M('cheese-table', 'A wheel of cheese as a table', ['furniture'], [cyl(1.5, 0.62, 1.5, [0, 0.31, 0], 'sand', { seg: 12 }), cyl(1.52, 0.1, 1.52, [0, 0.62, 0], 'orange', { seg: 12 }), cyl(0.28, 0.03, 0.28, [0.3, 0.68, 0.2], 'orange')]);\nexport const cheeseLamp = M('cheese-lamp', 'Cheese lamp', ['furniture'], [cyl(0.4, 0.1, 0.4, [0, 0.05, 0], 'orange'), cyl(0.1, 0.9, 0.1, [0, 0.5, 0], 'plum'), { cone: [0.8, 0.6, 0.8], at: [0, 1.15, 0], c: 'sand', glow: true }]);\nexport const cheeseBed = M('cheese-bed', 'Fondue bed', ['furniture'], [box(1, 0.44, 1.9, [0, 0.22, 0], 'sand'), box(0.9, 0.16, 0.5, [0, 0.52, -0.6], 'white'), cyl(0.2, 0.03, 0.2, [0.2, 0.46, 0.4], 'orange'), cyl(0.3, 0.03, 0.3, [-0.2, 0.46, 0.1], 'orange')]);\nexport const mirrorFurn = M('standing-mirror', 'Standing mirror', ['furniture'], [box(0.9, 0.08, 0.3, [0, 0.04, 0], 'plum'), box(0.84, 1.7, 0.08, [0, 0.92, -0.06], 'sand'), box(0.68, 1.5, 0.05, [0, 0.92, -0.01], 'cyan')]);\nexport const fishTank = M('fish-tank', 'A fish tank', ['furniture'], [box(0.9, 0.5, 0.6, [0, 0.25, 0], 'plum'), box(0.9, 0.6, 0.6, [0, 0.8, 0], 'cyan'), box(0.94, 0.05, 0.64, [0, 1.12, 0], 'ink'), box(0.8, 0.08, 0.5, [0, 0.54, 0], 'sand')]);\nexport const bugCage = M('bug-cage', 'A bug cage', ['furniture'], [box(0.8, 0.5, 0.6, [0, 0.25, 0], 'plum'), { group: [...[-0.34, -0.17, 0, 0.17, 0.34].map((x) => box(0.03, 0.6, 0.5, [x, 0.8, 0], 'ink'))] }, box(0.8, 0.05, 0.6, [0, 1.1, 0], 'ink'), box(0.7, 0.06, 0.5, [0, 0.52, 0], 'green')]);\nexport const floorClock = M('floor-clock', 'Grandfather clock', ['furniture'], [box(0.6, 1.9, 0.36, [0, 0.95, 0], 'plum'), cyl(0.44, 0.03, 0.44, [0, 1.55, 0.18], 'white', { rot: [90, 0, 0] }), box(0.03, 0.14, 0.03, [0, 1.6, 0.2], 'ink'), box(0.14, 0.14, 0.03, [0, 0.7, 0.2], 'sand')]);\nexport const trophy = M('trophy', 'A trophy', ['furniture'], [box(0.5, 0.2, 0.5, [0, 0.1, 0], 'plum'), cyl(0.12, 0.3, 0.12, [0, 0.35, 0], 'sand'), cyl(0.5, 0.5, 0.5, [0, 0.74, 0], 'sand', { top: 1.3 }), { mirror: [{ torus: [0.26, 0.06, 0.26], at: [0.32, 0.76, 0], rot: [90, 0, 0], c: 'sand' }], axis: 'x' }]);\nexport const plaque = M('plaque', 'A plaque on a stand', ['furniture'], [box(0.5, 0.1, 0.3, [0, 0.05, 0], 'plum'), box(0.1, 0.8, 0.1, [0, 0.5, 0], 'plum'), box(0.7, 0.5, 0.06, [0, 0.95, 0], 'sand')]);\nexport const snowGlobe = M('snow-globe', 'A tiny snow globe', ['furniture'], [box(0.5, 0.5, 0.4, [0, 0.25, 0], 'plum'), box(0.4, 0.14, 0.4, [0, 0.57, 0], 'navy'), ball(0.5, 0.5, 0.5, [0, 0.82, 0], 'sky'), ball(0.14, 0.14, 0.14, [0, 0.78, 0], 'white')]);\nexport const starLamp = M('star-lamp', 'A fallen star, warm', ['furniture'], [cyl(0.4, 0.1, 0.4, [0, 0.05, 0], 'ink'), { ball: [0.56, 0.56, 0.56], at: [0, 0.42, 0], c: 'sand', glow: true }]);\nexport const shopShelf = M('shop-shelf', 'A shop shelf', ['furniture'], [box(1.8, 0.1, 0.8, [0, 0.8, 0], 'orange'), { mirror: [box(0.1, 0.8, 0.7, [0.8, 0.4, 0], 'plum')], axis: 'x' }]);\nexport const counter = M('shop-counter', 'A shop counter', ['furniture'], [box(2.4, 0.95, 0.7, [0, 0.47, 0], 'orange'), box(2.5, 0.1, 0.8, [0, 1, 0], 'sand')]);\nexport const giantPot = M('giant-pot', \"Dorrit's giant pot\", ['town'], [cyl(2.4, 1.3, 2.4, [0, 0.85, 0], 'ink', { top: 1.15, seg: 10 }), { torus: [2.8, 0.14, 2.8], at: [0, 1.5, 0], c: 'slate' }, cyl(2.5, 0.08, 2.5, [0, 1.46, 0], 'soup', { seg: 10 }), { mirror: [box(0.2, 0.4, 0.2, [0.8, 0.2, 0.8], 'ink'), box(0.2, 0.4, 0.2, [0.8, 0.2, -0.8], 'ink')], axis: 'x' }], { palette: { soup: 'orange' } });\nexport const lantern = M('sf-lantern', 'A paper lantern on a little raft', ['festival'], [box(0.5, 0.06, 0.5, [0, 0.03, 0], 'plum'), { box: [0.3, 0.42, 0.3], at: [0, 0.3, 0], c: 'glow', glow: true }, box(0.34, 0.04, 0.34, [0, 0.52, 0], 'ink')], { palette: { glow: 'orange' } });\nexport const balloon = M('sf-balloon', 'A balloon with a present on a string', ['festival'], [ball(0.8, 1, 0.8, [0, 2.2, 0], 'b'), cone(0.14, 0.14, 0.14, [0, 1.7, 0], 'b', { rot: [180, 0, 0] }), box(0.04, 1.2, 0.04, [0, 1.05, 0], 'ink'), box(0.5, 0.42, 0.5, [0, 0.3, 0], 'orange'), box(0.54, 0.46, 0.1, [0, 0.3, 0], 'red'), box(0.1, 0.46, 0.54, [0, 0.3, 0], 'red')], { palette: { b: 'red' }, floats: true });\nexport const fireworkPost = M('sf-ringmark', 'A chalked ring on the ground', ['festival'], [{ torus: [1.8, 0.06, 1.8], at: [0, 0.04, 0], c: 'white' }]);\nexport const benchTown = M('lookout-bench', 'A bench', ['town'], [{ use: 'park-bench' }]);\n/** Generic display models by category, for HoldUp, the museum and shelves. */\nconst fishDef = (id, c, L = 1) => model({ id, about: 'Fish ' + id, tags: ['fish'], palette: { ...P16, f: c }, floats: true, parts: [ball(0.2 * L, 0.32 * L, 0.7 * L, [0, 0.4, 0], 'f'), cone(0.05, 0.3 * L, 0.26 * L, [0, 0.4, -0.42 * L], 'f', { rot: [90, 0, 0] }), box(0.03, 0.16 * L, 0.2, [0, 0.6, 0], 'f'), box(0.22, 0.05, 0.05, [0, 0.46, 0.22 * L], 'ink')] });\nconst bugDef = (id, c, shape) => model({ id, about: 'Bug ' + id, tags: ['bug'], palette: { ...P16, f: c }, floats: true, parts: shape === 'fly' ? [box(0.05, 0.05, 0.3, [0, 0.4, 0], 'ink'), { mirror: [ball(0.36, 0.04, 0.3, [0.2, 0.42, 0], 'f')], axis: 'x' }] : shape === 'long' ? [ball(0.14, 0.14, 0.42, [0, 0.4, 0], 'f'), { mirror: [box(0.3, 0.03, 0.03, [0.12, 0.34, 0.08], 'ink', { rot: [0, 0, -20] }), box(0.3, 0.03, 0.03, [0.12, 0.34, -0.08], 'ink', { rot: [0, 0, -20] })], axis: 'x' }] : shape === 'beetle' ? [ball(0.3, 0.2, 0.42, [0, 0.4, 0], 'f'), { mirror: [cone(0.05, 0.2, 0.05, [0.06, 0.48, 0.28], 'ink', { rot: [60, 0, 0] })], axis: 'x' }] : [ball(0.26, 0.2, 0.3, [0, 0.4, 0], 'f'), ball(0.1, 0.1, 0.1, [0, 0.42, 0.18], 'ink')] });\nconst blob = (id, c) => model({ id, about: 'Thing ' + id, tags: ['item'], palette: { ...P16, f: c }, floats: true, parts: [ball(0.42, 0.42, 0.42, [0, 0.4, 0], 'f'), ball(0.14, 0.14, 0.14, [0.1, 0.56, 0.1], 'white')] });\nconst defCache = new Map();\nexport function itemDef(it) {\n  let d = defCache.get(it.id); if (d) return d;\n  if (it.cat === 'fish') d = fishDef('x' + it.id, it.color, { S: 0.8, M: 1, L: 1.3, XL: 1.7 }[it.shadow] ?? 1);\n  else if (it.cat === 'bug') d = bugDef('x' + it.id, it.color, it.shape);\n  else if (it.cat === 'fossil' || it.cat === 'fossilunk') d = model({ id: 'x' + it.id, about: 'Fossil', tags: ['item'], palette: { ...P16 }, floats: true, parts: [{ lump: [0.5, 0.4, 0.5], at: [0, 0.4, 0], seed: 3, c: 'sand' }, box(0.26, 0.05, 0.05, [0, 0.42, 0.24], 'white')] });\n  else if (it.cat === 'cheese') d = model({ id: 'x' + it.id, about: 'Cheese', tags: ['item'], palette: { ...P16, f: it.color }, floats: true, parts: [cyl(0.6, 0.26, 0.6, [0, 0.36, 0], 'f', { seg: 10 }), cyl(0.14, 0.03, 0.14, [0.1, 0.5, 0.1], 'orange')] });\n  else if (it.cat === 'bag') d = model({ id: 'x' + it.id, about: 'Bag', tags: ['item'], palette: { ...P16 }, floats: true, parts: [ball(0.5, 0.5, 0.5, [0, 0.36, 0], 'orange'), cone(0.2, 0.2, 0.2, [0, 0.68, 0], 'orange'), box(0.24, 0.04, 0.05, [0, 0.36, 0.24], 'ink')] });\n  else d = blob('x' + it.id, typeof it.color === 'string' ? it.color : 'sand');\n  defCache.set(it.id, d); return d;\n}\nexport const TOOL_DEFS = {\n  net: model({ id: 't-net', about: 'Net', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.06, 1.1, 0.06, [0, -0.2, 0.4], 'orange', { rot: [70, 0, 0] }), { torus: [0.5, 0.06, 0.5], at: [0, -0.04, 0.92], c: 'ink', rot: [70, 0, 0] }, ball(0.4, 0.34, 0.4, [0, -0.1, 1.02], 'white')] }),\n  rod: model({ id: 't-rod', about: 'Rod', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.05, 1.4, 0.05, [0, -0.05, 0.6], 'orange', { rot: [75, 0, 0] }), ball(0.1, 0.1, 0.1, [0, -0.26, 0.1], 'red')] }),\n  shovel: model({ id: 't-shovel', about: 'Shovel', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.06, 1, 0.06, [0, -0.12, 0.34], 'orange', { rot: [70, 0, 0] }), box(0.3, 0.34, 0.06, [0, -0.04, 0.84], 'mist', { rot: [70, 0, 0] })] }),\n  axe: model({ id: 't-axe', about: 'Axe', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.06, 0.9, 0.06, [0, -0.1, 0.3], 'orange', { rot: [70, 0, 0] }), box(0.08, 0.3, 0.3, [0, 0.03, 0.7], 'mist', { rot: [70, 0, 0] })] }),\n  can: model({ id: 't-can', about: 'Can', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.34, 0.3, 0.34, [0, -0.14, 0.14], 'sky'), cone(0.06, 0.3, 0.06, [0, -0.1, 0.38], 'sky', { rot: [120, 0, 0] })] }),\n  sling: model({ id: 't-sling', about: 'Slingshot', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.06, 0.3, 0.06, [0, -0.04, 0.12], 'orange'), { mirror: [box(0.05, 0.2, 0.05, [0.08, 0.18, 0.12], 'orange', { rot: [0, 0, -20] })], axis: 'x' }] }),\n};\nexport const umbrellaDef = (c) => model({ id: 'umb-' + c, about: 'Umbrella', tags: ['tool'], palette: { ...P16, f: c }, floats: true, parts: [cyl(0.05, 1.1, 0.05, [0, 0.3, 0.12], 'ink'), { cone: [1.5, 0.5, 1.5], at: [0, 1.08, 0.12], c: 'f', seg: 8 }] });\n// City fronts\nconst front = (id, w, walls, trim, sign, signC, extra = []) => M(id, 'City front ' + sign, ['city'], [box(w, 4.2, 4, [0, 2.1, 0], walls), box(w + 0.1, 0.5, 4.1, [0, 4.4, 0], trim), box(w, 1.5, 3, [0, 5.2, -0.4], walls), box(w * 0.7, 2.2, 0.08, [0, 1.25, 2.02], 'cyan'), box(1, 2, 0.1, [w * 0.3, 1, 2.04], trim), box(0.08, 0.08, 0.1, [w * 0.3 - 0.35, 1, 2.1], 'sand'), box(w * 0.92, 0.9, 0.08, [0, 3.2, 2.04], 'night'), ...signParts(sign, [0, 3.48, 2.1], signC, 0.08), ...extra]);\nexport const cityFronts = { salon: front('front-salon', 7, 'plum', 'ink', 'SNIP & GOSSIP', 'red', [cyl(0.2, 1.4, 0.2, [3.3, 1.5, 2.3], 'red', { glow: true })]), couture: front('front-couture', 7, 'white', 'ink', 'MAISON PLUME', 'plum', [box(2, 0.1, 0.8, [0, 0.05, 2.5], 'red')]), magda: front('front-magda', 4.6, 'night', 'plum', 'GENUINE', 'lime', []), theatre: front('front-theatre', 8, 'red', 'sand', 'PALACE THEATRE', 'sand', [box(8, 0.14, 1.6, [0, 2.6, 2.8], 'ink')]), auction: front('front-auction', 7, 'teal', 'sand', 'PEMBERTON', 'sand', []), bureau: front('front-bureau', 6, 'slate', 'navy', 'B. B. BUREAU', 'cyan', []), cafe: front('front-cafe', 6, 'orange', 'plum', 'DAILY GRIND', 'white', [box(1.6, 0.8, 0.8, [-2, 0.4, 2.8], 'plum')]) };\nexport const skyline = [0, 1, 2].map((i) => M('skyline' + i, 'Skyline block', ['city'], [box(8, 12 + i * 4, 6, [0, 6 + i * 2, 0], i === 1 ? 'navy' : 'night'), ...Array.from({ length: 14 + i * 4 }, (_, k) => box(0.5, 0.7, 0.05, [-3 + (k % 6) * 1.2, 2 + Math.floor(k / 6) * 2.2, 3.02], k % 3 === 0 ? 'sand' : 'slate', k % 3 === 0 ? { glow: true } : {}))]));\nexport const tent = M('fortune-tent', \"Madame Nibbles' tent\", ['city'], [cone(4, 3, 4, [0, 1.5, 0], 'plum', { seg: 8 }), box(1, 1.7, 0.1, [0, 0.85, 1.72], 'ink'), ...signParts('FORTUNES', [0, 2.2, 1.8], 'sand', 0.05), ball(0.3, 0.3, 0.3, [0, 3.1, 0], 'sand', { glow: true })]);\nexport const ALL_MODELS = [homeT1, homeT2, homeT3, homeT4, ...cottages, store1, store2, store3, townHall, museum, mothwick, busShelter, bus, lighthouse, pearTree, pineTree, palmTree, bareTree, oldPear, stump, ...saplingDefs, ...beanstalkDef, rockDef, ...Object.values(flowers), weed, crackDef, holeDef, sparkleDef, shellDef, snowball, snowmanDef, oldBell, bridgeDef, mailbox, dock, cheeseChair, cheeseTable, cheeseLamp, cheeseBed, mirrorFurn, fishTank, bugCage, floorClock, trophy, plaque, snowGlobe, starLamp, shopShelf, counter, giantPot, lantern, balloon, fireworkPost, ...Object.values(TOOL_DEFS), ...Object.values(cityFronts), ...skyline, tent];\nfor (const m of ALL_MODELS) if (!MODEL_LIBRARY.get(m.id)) MODEL_LIBRARY.add(m);\nE\ncat > tests/tmp/t2.mjs <<'E'\nimport { checkModel, MODEL_LIBRARY, buildModel } from '../../src/engine.js';\nimport { ALL_MODELS, itemDef } from '../../src/art/models.js';\nlet n=0; for (const d of ALL_MODELS) { const r = checkModel(d, {catalog:MODEL_LIBRARY}); if (r.problems.length) { n++; console.log(d.id, r.problems.slice(0,4)); } buildModel(d,{}); }\nconsole.log('models', ALL_MODELS.length, 'bad', n);\nE\nnode tests/tmp/t2.mjs 2>&1 | cut -c1-260 | tail -30","description":"Write textures and models, then validate them"}}}
