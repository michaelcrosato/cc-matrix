ath.dirname(os.path.dirname(os.path.abspath(__file__))))\nhtml=os.path.abspath(glob.glob(os.path.join(root,'..','SillyFolk-*.html'))[0])\nwith sync_playwright() as p:\n    b=p.chromium.launch(args=FLAGS); g=b.new_page(viewport={'width':480,'height':270}); g.goto('file://'+html); g.wait_for_function('window.__GAME__ && window.__PIXEL_READY__',timeout=90000)\n    g.evaluate('__GAME__.game.idle=9.9'); g.wait_for_function(\"__GAME__.G.mode==='attract'\",timeout=30000); print('guest idled into', g.evaluate('__GAME__.G.mode'))\n    g.evaluate('__GAME__.G.visitMenu()'); g.wait_for_timeout(500); g.keyboard.press('ArrowDown'); g.wait_for_timeout(500); print('after first key: mode', g.evaluate('__GAME__.G.mode'), 'screen', g.evaluate('__GAME__.ui.model().screen')); g.keyboard.press('Enter'); g.wait_for_timeout(800)\n    print('G.visit is', g.evaluate('__GAME__.G.visit===null?\"null\":typeof __GAME__.G.visit'))\n    try: g.evaluate(\"__GAME__.G.visit.session.send({t:'x'})\")\n    except Exception as e: print('ERROR:', str(e).split('\\n')[0][:120])\n    b.close()\nE\nnode tools/build.mjs; timeout 100 node tests/run.mjs --only play 2>&1 | tail -2 | cut -c1-200; timeout 90 node tests/play/playthrough.mjs 2>&1 | grep -v '^`)' | tail -2 | cut -c1-250; timeout 110 python3 tests/browser/old_visit_race.py 2>&1 | cut -c1-200; timeout 200 node kit/check.mjs --sheets src/art/models.js 2>&1 | awk '/^  model /{m=$2} /floats|z-fighting|inside box/{print m, substr($0,1,95)}' | cut -c1-120; rm -rf check","description":"Add glide, catch validation; reproduce old error; recheck","timeout":520000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":3443,"cache_read_input_tokens":839635,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3443},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagno