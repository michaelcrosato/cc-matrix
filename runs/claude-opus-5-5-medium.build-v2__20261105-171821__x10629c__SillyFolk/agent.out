p).read()\ns=s.replace(\"if (p.id === 'patternstudio') { const s = patternStudio((slot) => { w.p.look.pattern = slot; G.player.rebuild(); }); UI.push(s); return; }\",\"if (p.id === 'patternstudio') return Script.run(patternFlow(NPC.actors.mothwick));\")\ns=s.replace(\"import { storeTargets, syncWing, animateWings, upgradeHome, homeDoors } from './systems/services.js';\",\"import { storeTargets, syncWing, animateWings, upgradeHome, homeDoors, patternFlow } from './systems/services.js';\")\ns=s.replace(\"    G.drawAvatarCard = (h, x, y) => this.avatarCard(h, x, y);\",\"\"\"    G.drawAvatarCard = (h, x, y) => this.avatarCard(h, x, y);\n    G.placeLost = () => { const w = G.world; for (const [tx, tz] of [[30, 34], [31, 35], [15, 42], [32, 44], [18, 45]]) if (!w.grid.get(tx + ',' + tz)) { addEnt(w, { t: 'item', it: 'lostthing', x: tx + 0.5, z: tz + 0.5 }); return; } };\n    G.onEntered = (id) => { if (id === 'store' && G.world.flags.chimeSet) G.playChime(G.world.chime.slice(0, 8)); };\"\"\")\ns=s.replace(\"    this.ambience(dt); updateMusic(ctx.audio); updateChime(ctx.audio);\",\"    this.ambience(dt); updateMusic(ctx.audio); updateChime(ctx.audio); this.smellT = (this.smellT ?? 0) - dt; if (this.smellT <= 0) { this.smellT = 0.8; if (w.p.pockets.some((e) => e?.id === 'cheesebad')) { ctx.particles.burst('steam', [w.p.x, 1.2, w.p.z], { count: 2, colors: ['lime', 'green'] }); } }\")\nopen(p,'w').write(s)\np='src/core/world.js'; s=open(p).read()\ns=s.replace(\"if (s) s.friend = clamp(s.friend + amt * T.friend, 0, 100); };\",\"if (s) s.friend = clamp(s.friend + amt * T.friend * (w.p.buffs.luckFriends ? 1.5 : 1), 0, 100); };\")\nopen(p,'w').write(s)\np='src/systems/interact.js'; s=open(p).read()\ns=s.replace(\"collect('bag', { id: 'bag', value: e.value }, { reveal: true }); return; }\",\"collect('bag', { id: 'bag', value: Math.round(e.value * (w.p.buffs.luckFinds ? 1.5 : 1)) }, { reveal: true }); return; }\")\nopen(p,'w').write(s)\np='src/systems/talk.js'; s=open(p).read()\ns=s.replace(\"  // accepted\\n  let ok = false;\",\"  // accepted\\n  if (fav.kind === 'catch' && w.clock.day * 1440 + w.clock.minute > fav.deadline) { fav.state = 'done'; yield say(id, 'Too late. It had to be within the hour. I have made other arrangements. They went badly.', { actor }); return; }\\n  let ok = false;\")\nopen(p,'w').write(s)\np='src/systems/home.js'; s=open(p).read()\ns=s.replace(\"  for (const x of r?.furn?.values() ?? []) if (x.mirror) x.mirror.enabled = true;\",\"  for (const rid of homeRoomIds()) for (const x of G.rooms[rid]?.furn?.values() ?? []) if (x.mirror) x.mirror.enabled = rid === place;\")\nopen(p,'w').write(s)\np='tests/browser/tour.py'; s=open(p).read()\ns=s.replace(\" 'city_day':\",\" 'home_full':\\\"G.world.p.tier=2;const it=[{id:'mirror',x:5,z:1,rot:0},{id:'tv',x:3,z:1,rot:0},{id:'c_lamp',x:1,z:4,rot:0},{id:'c_sofa',x:2,z:3,rot:0}];const r=g.actions.ensureRoom('home');for(const f of it){G.world.home.rooms.home.furn.push(f);G.placeF(r,f)};g.actions.setPlace('home',r.ox+3,4.5,0);G.tvS('home');\\\",\\n 'city_day':\")\ns=s.replace(\"    names=sys.argv[1:] or list(SC)\",\"    pg.evaluate(\\\"\\\")\\n    names=sys.argv[1:] or list(SC)\")\nopen(p,'w').write(s)\np='src/systems/home.js'; s=open(p).read()\ns+=\"\\nG.placeF = placeFurn; G.tvS = tvSync;\\n\"\nopen(p,'w').write(s)\nE\nnode tools/build.mjs; timeout 130 python3 tests/browser/tour.py waterfall beach home_full 2>&1 | tail -2 | cut -c1-500","description":"Fix water, add missing plan features, test Mirror/TV","timeout":140000}}}
