at = 'h_bucket'; G.player.rebuild(); hostTalk('flavia', 'couture', ['Be judged']); check('plumes judged', w().stats.fashion === 1, String(w().stats.fashion)); check('fashion day', w().fashion.day === w().clock.day); }\n  // Magda: find a forged painting, buy it, take it to Dr. Quill\n  { w().clock.minute = 21 * 60; b.step(2); const r = room('magda'); const o = w().magda.offers; o[0].forged = true; b.at(r.ox + r.def.props[0].x, r.def.props[0].z + 0.9, Math.PI); b.tap('KeyE'); b.step(3); check('art card', UI.top?.id === 'artCard', UI.top?.id); check('compares with catalogue', UI.top.offer.forged === true); UI.top.focus = 0; b.tap('KeyE'); b.step(3); b.talkThrough(); const item = w().p.pockets.find((p) => p?.forged); check('bought a forgery', !!item); const r2 = room('museum'); G.talk('quill'); b.step(2); b.talkThrough(['Donate']); pocketPick(item.id); b.step(2); b.talkThrough(['Bye']); check('forgery spotted', w().stats.forgeries === 1); check('not in gallery', true); }\n  // Theatre\n  { w().clock.minute = 20 * 60; hostTalk('bellows', 'theatre', ['Yes, go on']); check('laugh prompt', UI.top?.id === 'laugh', UI.top?.id); let g4 = 0; while (UI.top?.id === 'laugh' && UI.top.chars < 200 && g4++ < 400 && UI.top.chars < 1e9) { const t = UI.top; if (t.chars >= (t.after === undefined ? 1e9 : 0)) break; e.step(2); if (t.after > 0.1) break; } b.tap('KeyE'); b.step(3); b.talkThrough(); check('emote learned', w().p.emotes.length === 1, JSON.stringify(w().p.emotes)); }\n  // Auction\n  { w().clock.minute = 12 * 60; hostTalk('pemberton', 'auction', ['Bid']); check('auction screen', UI.top?.id === 'auction', UI.top?.id); let g5 = 0; while (UI.top?.id === 'auction' && g5++ < 3000) { if (UI.top.leader !== 'you') b.tap('KeyE'); else e.step(3); } b.talkThrough(); check('auction won', (w().stats.auctionsWon ?? 0) >= 1, JSON.stringify([w().stats.auctions, w().stats.auctionsWon])); giveItem(w(), { id: 'bear' }); hostTalk('pemberton', 'auction', ['Consign']); pocketPick('bear'); b.step(2);