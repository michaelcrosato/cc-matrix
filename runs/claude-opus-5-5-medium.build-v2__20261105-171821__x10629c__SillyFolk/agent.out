 [0, 1, 0], [sf, 0, cf]]; for (const c of this.chains) { const [ax, ay, az] = c.at; const rootP = [p.x + cf * ax + sf * az, p.y + ay, p.z - sf * ax + cf * az]; if (!c.ready) { c.chain.reset(rootP, basis); c.ready = true; } c.chain.update(dt, rootP, basis); c.meshes.forEach((m, i) => { const q = c.chain.points[i + 1]; m.position.set(q[0], q[1], q[2]); }); } }\"\"\"+s[b:]\ns=s.replace(\"if (v !== this.root.visible) this.tailReady = false; this.root.visible = v;\",\"if (v !== this.root.visible) for (const c of this.chains) c.ready = false; this.root.visible = v;\")\nopen(p,'w').write(s)\np='src/actors/npcs.js'\nsub(p,\"tail: id === 'nib' ? ['white', 'ink', 'white', 'ink', 'white', 'ink', 'white'] : null });\",\"springs: SPRINGS[id] });\")\nsub(p,\"const RIVER_POI =\",\"const SPRINGS = { nib: [{ colors: ['white', 'ink', 'white', 'ink', 'white', 'ink', 'white'], at: [0, 0.34, -0.22], rest: [0, 0.8, -0.6] }], bartleby: [{ colors: ['white', 'white', 'sky'], at: [-0.62, 1.32, 0.06], rest: [0, -1, 0.05], len: 0.12, r: 0.07, stiffness: 3, gravity: 7 }], yolanda: [{ colors: ['red', 'red', 'red', 'sand'], at: [0.14, 0.72, 0.22], rest: [0.1, -1, 0.15], len: 0.13, r: 0.08, stiffness: 4, gravity: 7 }], ottoline: [{ colors: ['sky', 'sky', 'white'], at: [0, 1.02, -0.28], rest: [0, -0.7, -0.7], len: 0.13, r: 0.06, stiffness: 5, gravity: 5 }], flavia: [{ colors: ['red', 'white', 'red'], at: [0, 1.0, -0.22], rest: [0, -0.5, -0.9], len: 0.14, r: 0.07, stiffness: 5, gravity: 5 }], trundle: [{ colors: ['red', 'red', 'sand'], at: [0.3, 0.42, 0.12], rest: [0.2, -1, 0], len: 0.1, r: 0.06, stiffness: 4, gravity: 7 }] };\\nconst RIVER_POI =\")\np='src/game.js'; s=open(p).read()\na=s.index(\"let river = 0, sea = 0; if (out && P)\"); b=s.index(\"const set = (k, v) => a[k]?.set({ volume: v });\")\ns=s[:a]+\"\"\"let river = null, sea = null; if (out && P) { for (let r = 2; r <= 12 && !(river && sea); r += 2) for (const [dx, dz] of [[r, 0], [-r, 0], [0, r], [0, -r], [r, r], [-r, r], [r, -r], [-r, -r]]) { const k = P.waterKind(w.p.x + dx, w.p.z + dz); if ((k === 'river' || k === 'pond' || k === 'mouth') && !river) river = [w.p.x + dx, w.p.z + dz]; if (k === 'sea' && !sea) sea = [w.p.x + dx, w.p.z + dz]; } } const ears = { position: { x: w.p.x, y: 1, z: w.p.z }, right: G.ctx.engine.camera.groundBasis().right }; const near = (at, k, gain) => { if (!at) return a[k]?.set({ volume: 0 }); const s0 = spatialize(ears, { x: at[0], y: 0, z: at[1] }, { max: 16 }); a[k]?.set({ volume: s0.gain * gain, pan: s0.pan }); }; near(river, 'river', 0.8); near(sea, 'surf', 0.9); G.ambNow = { river: !!river, sea: !!sea }; \"\"\"+s[b:]\ns=s.replace(\"set('river', river * 0.8); set('surf', sea * 0.9); \",\"\")\ns=s.replace(\"import { THREE, ContactShadow, loadPack, MODEL_LIBRARY, PALETTE, toonMaterial } from './engine.js';\",\"import { THREE, ContactShadow, loadPack, MODEL_LIBRARY, PALETTE, toonMaterial, spatialize } from './engine.js';\")\nopen(p,'w').write(s)\np='tests/play/playthrough.mjs'\nsub(p,\"// ---- save round trip and determinism\",\"\"\"// ---- Spring chains hang off characters; water is heard from where it is\n{ const y = NPC.actors.yolanda, ba = NPC.actors.bartleby; check('laundry and scarf are spring chains', ba.chains.length === 1 && y.chains.length === 1); town(39, 30.5); const d = NPC.rt.bartleby; w().npcs.bartleby.place = 'town'; d.indoorLocal = false; d.x = 37; d.z = 31; d.path = null; d.pause = 1e4; d.moving = false; b.step(30); const q0 = ba.chains[0].chain.points[3].slice(); check('laundry hangs below its hook', q0[1] < ba.chains[0].at[1] + ba.root.position.y, String(q0)); d.pause = 0; town(37, 29); b.step(40); check('river heard nearby', G.ambNow?.river === true); }\n// ---- save round trip and determinism\"\"\")\np='tests/PLAN_AUDIT.md'; s=open(p).read()\ns=s.replace(\"- Ambience uses distance to water; only the busker and crowd use `spatialize`.\\n- Lemur tail is the only SpringChain; `SpringChain` for ears and ribbons was not added.\\n- Fossil and museum exh