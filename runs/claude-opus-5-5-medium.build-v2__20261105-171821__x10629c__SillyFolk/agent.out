ne'); const t0 = 1.5; let t = 0; b.position.set(stop[0] - 18, 0, stop[1]); yield until(() => { t += 1 / 30; const k = Math.min(1, t / t0); b.position.x = stop[0] - 18 * (1 - k) * (1 - k); return k >= 1; }); G.ctx.audio.play('busBrake'); G.ctx.audio.play('busHorn'); const h = NPC.rt.hester; h.force = [stop[0] + 1.6, 0, stop[1] - 1.7]; h.fixed = true; h.vis = () => true; h.talkTo = true; const hA = NPC.actors.hester; hA.play('Wave', { then: 'Idle', restart: true }); const leave = () => { h.force = null; h.vis = () => false; h.talkTo = false; b.parent?.remove(b); }; if (from === 'town') { const p = yield ask('hester', 'Bus. Sit anywhere. They are all the same seat.', ['To the Big City', 'Not now'], { cancel: 1, actor: hA }); if (p) { leave(); return; } leave(); yield* busRide('city'); } else { const p = yield ask('hester', 'The last bus. There is always a last bus.', [`Home to ${w.town}`, 'Stay a bit'], { cancel: 1, actor: hA }); if (p) { leave(); return; } leave(); yield* busRide('town'); } })()); \"\"\"+s[b:]\nopen(p,'w').write(s)\n# ---- Day One: walked to the shack; roof at evening\np='src/systems/dayone.js'\nsub(p,\"\"\"    yield say('gander', \"Mrs. Gander. I hold the note on your shack.\"\"\",\"\"\"    let there = false; Trans.go(() => { setPlace('town', 74.5, 38.6, Math.PI); g.force = [76.4, 0, 38.8]; G.view.setHomeModel(1); there = true; }); yield until(() => there); yield 0.2;\n    yield say('gander', \"Mrs. Gander. I hold the note on your shack.\"\"\")\nsub(p,\"w.flags.roofOn = true; bus.emit('dayOneDone');\",\"w.flags.roofOn = true; G.view.setHomeModel(Math.max(1, w.p.tier)); bus.emit('dayOneDone');\")\nsub(p,\"export function finishDayOne() { const w = G.world;\",\"export function finishDayOne() { const w = G.world; w.flags.roofOn = true; G.view.setHomeModel(Math.max(1, w.p.tier));\")\nsub(p,\"It's the one at the far end of the village, with no roof.\",\"That's it, with no roof.\")\n# ---- guest gifts\np='src/systems/home.js'\nsub(p,\"const [tx, tz] = G.pl