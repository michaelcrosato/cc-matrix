[0, 0.8, 0], 'orange'), { mirror: [box(0.1, 0.8, 0.7, [0.8, 0.4, 0], 'plum')], axis: 'x' }]);\nexport const counter = M('shop-counter', 'A shop counter', ['furniture'], [box(2.4, 0.95, 0.7, [0, 0.47, 0], 'orange'), box(2.5, 0.1, 0.8, [0, 1, 0], 'sand')]);\nexport const giantPot = M('giant-pot', \"Dorrit's giant pot\", ['town'], [cyl(2.4, 1.3, 2.4, [0, 0.85, 0], 'ink', { top: 1.15, seg: 10 }), { torus: [2.8, 0.14, 2.8], at: [0, 1.5, 0], c: 'slate' }, cyl(2.5, 0.08, 2.5, [0, 1.46, 0], 'soup', { seg: 10 }), { mirror: [box(0.2, 0.4, 0.2, [0.8, 0.2, 0.8], 'ink'), box(0.2, 0.4, 0.2, [0.8, 0.2, -0.8], 'ink')], axis: 'x' }], { palette: { soup: 'orange' } });\nexport const lantern = M('sf-lantern', 'A paper lantern on a little raft', ['festival'], [box(0.5, 0.06, 0.5, [0, 0.03, 0], 'plum'), { box: [0.3, 0.42, 0.3], at: [0, 0.3, 0], c: 'glow', glow: true }, box(0.34, 0.04, 0.34, [0, 0.52, 0], 'ink')], { palette: { glow: 'orange' } });\nexport const balloon = M('sf-balloon', 'A balloon with a present on a string', ['festival'], [ball(0.8, 1, 0.8, [0, 2.2, 0], 'b'), cone(0.14, 0.14, 0.14, [0, 1.7, 0], 'b', { rot: [180, 0, 0] }), box(0.04, 1.2, 0.04, [0, 1.05, 0], 'ink'), box(0.5, 0.42, 0.5, [0, 0.3, 0], 'orange'), box(0.54, 0.46, 0.1, [0, 0.3, 0], 'red'), box(0.1, 0.46, 0.54, [0, 0.3, 0], 'red')], { palette: { b: 'red' }, floats: true });\nexport const fireworkPost = M('sf-ringmark', 'A chalked ring on the ground', ['festival'], [{ torus: [1.8, 0.06, 1.8], at: [0, 0.04, 0], c: 'white' }]);\nexport const benchTown = M('lookout-bench', 'A bench', ['town'], [{ use: 'park-bench' }]);\n/** Generic display models by category, for HoldUp, the museum and shelves. */\nconst fishDef = (id, c, L = 1) => model({ id, about: 'Fish ' + id, tags: ['fish'], palette: { ...P16, f: c }, floats: true, parts: [ball(0.2 * L, 0.32 * L, 0.7 * L, [0, 0.4, 0], 'f'), cone(0.05, 0.3 * L, 0.26 * L, [0, 0.4, -0.42 * L], 'f', { rot: [90, 0, 0] }), box(0.03, 0.16 * L, 0.2, [0, 0.6, 0], 'f'), box(0.22, 0.05, 0.05, [0, 0.46, 0.22 * L], 'ink')] });\nconst bugDef = (id, c, shape) => model({ id, about: 'Bug ' + id, tags: ['bug'], palette: { ...P16, f: c }, floats: true, parts: shape === 'fly' ? [box(0.05, 0.05, 0.3, [0, 0.4, 0], 'ink'), { mirror: [ball(0.36, 0.04, 0.3, [0.2, 0.42, 0], 'f')], axis: 'x' }] : shape === 'long' ? [ball(0.14, 0.14, 0.42, [0, 0.4, 0], 'f'), { mirror: [box(0.3, 0.03, 0.03, [0.12, 0.34, 0.08], 'ink', { rot: [0, 0, -20] }), box(0.3, 0.03, 0.03, [0.12, 0.34, -0.08], 'ink', { rot: [0, 0, -20] })], axis: 'x' }] : shape === 'beetle' ? [ball(0.3, 0.2, 0.42, [0, 0.4, 0], 'f'), { mirror: [cone(0.05, 0.2, 0.05, [0.06, 0.48, 0.28], 'ink', { rot: [60, 0, 0] })], axis: 'x' }] : [ball(0.26, 0.2, 0.3, [0, 0.4, 0], 'f'), ball(0.1, 0.1, 0.1, [0, 0.42, 0.18], 'ink')] });\nconst blob = (id, c) => model({ id, about: 'Thing ' + id, tags: ['item'], palette: { ...P16, f: c }, floats: true, parts: [ball(0.42, 0.42, 0.42, [0, 0.4, 0], 'f'), ball(0.14, 0.14, 0.14, [0.1, 0.56, 0.1], 'white')] });\nconst defCache = new Map();\nexport function itemDef(it) {\n  let d = defCache.get(it.id); if (d) return d;\n  if (it.cat === 'fish') d = fishDef('x' + it.id, it.color, { S: 0.8, M: 1, L: 1.3, XL: 1.7 }[it.shadow] ?? 1);\n  else if (it.cat === 'bug') d = bugDef('x' + it.id, it.color, it.shape);\n  else if (it.cat === 'fossil' || it.cat === 'fossilunk') d = model({ id: 'x' + it.id, about: 'Fossil', tags: ['item'], palette: { ...P16 }, floats: true, parts: [{ lump: [0.5, 0.4, 0.5], at: [0, 0.4, 0], seed: 3, c: 'sand' }, box(0.26, 0.05, 0.05, [0, 0.42, 0.24], 'white')] });\n  else if (it.cat === 'cheese') d = model({ id: 'x' + it.id, about: 'Cheese', tags: ['item'], palette: { ...P16, f: it.color }, floats: true, parts: [cyl(0.6, 0.26, 0.6, [0, 0.36, 0], 'f', { seg: 10 }), cyl(0.14, 0.03, 0.14, [0.1, 0.5, 0.1], 'orange')] });\n  else if (it.cat === 'bag') d = model({ id: 'x' + it.id, about: 'Bag', tags: ['item'], palette: { ...P16 }, floats: true, parts: [ball(0.5, 0.5, 0.5, [0, 0.36, 0], 'orange'), cone(0.2, 0.2, 0.2, [0, 0.68, 0], 'orange'), box(0.24, 0.04, 0.05, [0, 0.36, 0.24], 'ink')] });\n  else d = blob('x' + it.id, typeof it.color === 'string' ? it.color : 'sand');\n  defCache.set(it.id, d); return d;\n}\nexport const TOOL_DEFS = {\n  net: model({ id: 't-net', about: 'Net', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.06, 1.1, 0.06, [0, -0.2, 0.4], 'orange', { rot: [70, 0, 0] }), { torus: [0.5, 0.06, 0.5], at: [0, -0.04, 0.92], c: 'ink', rot: [70, 0, 0] }, ball(0.4, 0.34, 0.4, [0, -0.1, 1.02], 'white')] }),\n  rod: model({ id: 't-rod', about: 'Rod', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.05, 1.4, 0.05, [0, -0.05, 0.6], 'orange', { rot: [75, 0, 0] }), ball(0.1, 0.1, 0.1, [0, -0.26, 0.1], 'red')] }),\n  shovel: model({ id: 't-shovel', about: 'Shovel', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.06, 1, 0.06, [0, -0.12, 0.34], 'orange', { rot: [70, 0, 0] }), box(0.3, 0.34, 0.06, [0, -0.04, 0.84], 'mist', { rot: [70, 0, 0] })] }),\n  axe: model({ id: 't-axe', about: 'Axe', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.06, 0.9, 0.06, [0, -0.1, 0.3], 'orange', { rot: [70, 0, 0] }), box(0.08, 0.3, 0.3, [0, 0.03, 0.7], 'mist', { rot: [70, 0, 0] })] }),\n  can: model({ id: 't-can', about: 'Can', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.34, 0.3, 0.34, [0, -0.14, 0.14], 'sky'), cone(0.06, 0.3, 0.06, [0, -0.1, 0.38], 'sky', { rot: [120, 0, 0] })] }),\n  sling: model({ id: 't-sling', about: 'Slingshot', tags: ['tool'], palette: P16, floats: true, parts: [cyl(0.06, 0.3, 0.06, [0, -0.04, 0.12], 'orange'), { mirror: [box(0.05, 0.2, 0.05, [0.08, 0.18, 0.12], 'orange', { rot: [0, 0, -20] })], axis: 'x' }] }),\n};\nexport const umbrellaDef = (c) => model({ id: 'umb-' + c, about: 'Umbrella', tags: ['tool'], palette: { ...P16, f: c }, floats: true, parts: [cyl(0.05, 1.1, 0.05, [0, 0.3, 0.12], 'ink'), { cone: [1.5, 0.5, 1.5], at: [0, 1.08, 0.12], c: 'f', seg: 8 }] });\n// City fronts\nconst front = (id, w, walls, trim, sign, signC, extra = []) => M(id, 'City front ' + sign, ['city'], [box(w, 4.2, 4, [0, 2.1, 0], walls), box(w + 0.1, 0.5, 4.1, [0, 4.4, 0], trim), box(w, 1.5, 3, [0, 5.2, -0.4], walls), box(w * 0.7, 2.2, 0.08, [0, 1.25, 2.02], 'cyan'), box(1, 2, 0.1, [w * 0.3, 1, 2.04], trim), box(0.08, 0.08, 0.1, [w * 0.3 - 0.35, 1, 2.1], 'sand'), box(w * 0.92, 0.9, 0.08, [0, 3.2, 2.04], 'night'), ...signParts(sign, [0, 3.48, 2.1], signC, 0.08), ...extra]);\nexport const cityFronts = { salon: front('front-salon', 7, 'plum', 'ink', 'SNIP & GOSSIP', 'red', [cyl(0.2, 1.4, 0.2, [3.3, 1.5, 2.3], 'red', { glow: true })]), couture: front('front-couture', 7, 'white', 'ink', 'MAISON PLUME', 'plum', [box(2, 0.1, 0.8, [0, 0.05, 2.5], 'red')]), magda: front('front-magda', 4.6, 'night', 'plum', 'GENUINE', 'lime', []), theatre: front('front-theatre', 8, 'red', 'sand', 'PALACE THEATRE', 'sand', [box(8, 0.14, 1.6, [0, 2.6, 2.8], 'ink')]), auction: front('front-auction', 7, 'teal', 'sand', 'PEMBERTON', 'sand', []), bureau: front('front-bureau', 6, 'slate', 'navy', 'B. B. BUREAU', 'cyan', []), cafe: front('front-cafe', 6, 'orange', 'plum', 'DAILY GRIND', 'white', [box(1.6, 0.8, 0.8, [-2, 0.4, 2.8], 'plum')]) };\nexport const skyline = [0, 1, 2].map((i) => M('skyline' + i, 'Skyline block', ['city'], [box(8, 12 + i * 4, 6, [0, 6 + i * 2, 0], i === 1 ? 'navy' : 'night'), ...Array.from({ length: 14 + i * 4 }, (_, k) => box(0.5, 0.7, 0.05, [-3 + (k % 6) * 1.2, 2 + Math.floor(k / 6) * 2.2, 3.02], k % 3 === 0 ? 'sand' : 'slate', k % 3 === 0 ? { glow: true } : {}))]));\nexport const tent = M('fortune-tent', \"Madame Nibbles' tent\", ['city'], [cone(4, 3, 4, [0, 1.5, 0], 'plum', { seg: 8 }), box(1, 1.7, 0.1, [0, 0.85, 1.72], 'ink'), ...signParts('FORTUNES', [0, 2.2, 1.8], 'sand', 0.05), ball(0.3, 0.3, 0.3, [0, 3.1, 0], 'sand', { glow: true })]);\nexport const ALL_MODELS = [homeT1, homeT2, homeT3, homeT4, ...cottages, store1, store2, store3, townHall, museum, mothwick, busShelter, bus, lighthouse, pearTree, pineTree, palmTree, bareTree, oldPear, stump, ...saplingDefs, ...beanstalkDef, rockDef, ...Object.values(flowers), weed, crackDef, holeDef, sparkleDef, shellDef, snowball, snowmanDef, oldBell, bridgeDef, mailbox, dock, cheeseChair, cheeseTable, cheeseLamp, cheeseBed, mirrorFurn, fishTank, bugCage, floorClock, trophy, plaque, snowGlobe, starLamp, shopShelf, counter, giantPot, lantern, balloon, fireworkPost, ...Object.values(TOOL_DEFS), ...Object.values(cityFronts), ...skyline, tent];\nfor (const m of ALL_MODELS) if (!MODEL_LIBRARY.get(m.id)) MODEL_LIBRARY.add(m);\nE\ncat > tests/tmp/t2.mjs <<'E'\nimport { checkModel, MODEL_LIBRARY, buildModel } from '../../src/engine.js';\nimport { ALL_MODELS, itemDef } from '../../src/art/models.js';\nlet n=0; for (const d of ALL_MODELS) { const r = checkModel(d, {catalog:MODEL_LIBRARY}); if (r.problems.length) { n++; console.log(d.id, r.problems.slice(0,4)); } buildModel(d,{}); }\nconsole.log('models', ALL_MODELS.length, 'bad', n);\nE\nnode tests/tmp/t2.mjs 2>&1 | cut -c1-260 | tail -30","description":"Write textures and models, then validate them"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18574,"cache_read_input_tokens":221765,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18574},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f147b5a-afdb-41c5-bbfc-62264f8c7cee","uuid":"49dca13c-1429-4ab0-85ef-0a34cc3f0284","timestamp":"2026-11-06T00:34:45.694Z","request_id":"req_011CgkjS8VYG6am1wnKs29AA","wire_tool_inputs":{"toolu_012iR3UjwQTknLupBaWLDMqV":{"command":"cat > src/art/textures.js <<'E'\n// Quiet surfaces: flat base plus sparse specks. Seasons swap the maps under a cover.\nimport { textureDef, TEXTURE_LIBRARY, textureMap, toonMaterial, PALETTE, THREE, pixelTexture } from '../engine.js';\nconst full = (c) => ({ path: 'M0 0H32V32H0Z', fill: c });\nconst surf = (id, a, b, count = 9, seed = 4, c) => textureDef({ id, about: `Quiet surface ${id}`, tags: ['surface'], size: [32, 32], tile: true, palette: c ? { a, b, c } : { a, b }, layers: [full('a'), { pattern: 'scatter', colors: ['b'], count, size: 1, seed }, ...(c ? [{ pattern: 'scatter', colors: ['c'], count: 5, size: 1, seed: seed + 3 }] : [])] });\nexport const TEX = [\n  surf('sf-grass-spring', 'lime', 'green', 9, 4, 'white'), surf('sf-grass-summer', 'green', 'lime', 9, 4), surf('sf-grass-autumn', 'sand', 'orange', 8, 5), surf('sf-grass-winter', 'white', 'mist', 7, 6),\n  surf('sf-path-spring', 'sand', 'orange', 6, 8), surf('sf-path-summer', 'sand', 'orange', 6, 8), surf('sf-path-autumn', 'orange', 'red', 6, 8), surf('sf-path-winter', 'mist', 'slate', 5, 8),\n  surf('sf-sand', 'sand', 'white', 8, 3), surf('sf-sand-winter', 'mist', 'white', 8, 3), surf('sf-dirt', 'orange', 'red', 9, 2), surf('sf-cliff', 'slate', 'mist', 12, 9), surf('sf-cliff-winter', 'mist', 'white', 12, 9), surf('sf-asphalt', 'night', 'slate', 8, 9), surf('sf-kerb', 'slate', 'mist', 8, 5),\n  textureDef({ id: 'sf-plaza', about: 'Plaza stones', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'mist', b: 'white', c: 'slate' }, layers: [{ pattern: 'tiles', colors: ['c', 'a', 'b'], w: 16, h: 16, seed: 3 }] }),\n  textureDef({ id: 'sf-plaza-city', about: 'City paving', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'slate', b: 'mist', c: 'night' }, layers: [{ pattern: 'tiles', colors: ['c', 'a', 'b'], w: 16, h: 8, seed: 6 }] }),\n  textureDef({ id: 'sf-boards', about: 'Boards', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'plum', b: 'orange', c: 'sand' }, layers: [{ pattern: 'planks', colors: ['a', 'b', 'c'], w: 8, gap: 1, seed: 2 }] }),\n];\nfor (const t of TEX) TEXTURE_LIBRARY.add(t);\nconst mats = new Map();\nexport function surfaceMat(id) { let m = mats.get(id); if (!m) { m = toonMaterial(PALETTE.white, { map: textureMap(id) }); mats.set(id, m); } return m; }\n/** A two-colour stripe/check wall or floor, as data texture; cached by id. */\nconst texCache = new Map();\nexport function dataTexture(key, w, h, pixel) {\n  let t = texCache.get(key); if (t) return t;\n  const data = new Uint8Array(w * h * 4); for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) { const c = pixel(x, y); const i = (y * w + x) * 4; data[i] = (c >> 16) & 255; data[i + 1] = (c >> 8) & 255; data[i + 2] = c & 255; data[i + 3] = 255; }\n  t = pixelTexture(new THREE.DataTexture(data, w, h, THREE.RGBAFormat)); t.colorSpace = THREE.SRGBColorSpace; t.wrapS = t.wrapT = THREE.RepeatWrapping; t.needsUpdate = true; texCache.set(key, t); return t;\n}\nexport function patternTexture(key, rows) { texCache.delete(key); return dataTexture(key, 16, 16, (x, y) => PALETTE[PAL16[rows[15 - y]?.[x] ?? 15]] ?? PALETTE.white); }\nexport const PAL16 = 'ink plum red orange sand lime green teal navy blue sky cyan white mist slate night'.split(' ');\nexport function twoTone(key, a, b, kind = 'stripe') { return dataTexture(key, 8, 8, (x, y) => (kind === 'stripe' ? (x % 4 < 2 ? PALETTE[a] : PALETTE[b]) : kind === 'check' ? ((x >> 2) + (y >> 2)) % 2 ? PALETTE[a] : PALETTE[b] : kind === 'boards' ? (y % 4 === 0 ? PALETTE[b] : PALETTE[a]) : (x % 4 === 1 && y % 4 === 1 ? PALETTE[b] : PALETTE[a]))); }\nexport const shirtTexture = (it) => twoTone('shirt-' + it.id, it.color, it.tex === 'stripes' ? 'navy' : it.tex === 'check' ? 'night' : 'white', it.tex === 'stripes' ? 'stripe' : it.tex === 'check' ? 'check' : 'dots');\nconst PAINT = {\n  mona: ['ssssssssssssssss', 'sgggggggggggggss', 'sgggggwwwgggggss', 'sggggwwwwwggggss', 'sgggwwkwkwwgggss', 'sgggwwwwwwwgggss', 'sgggwwrrwwggggss', 'sggggwwwwgggggss', 'sggggowwoggggggs', 'sgggoooooogggggs', 'sggoooooooogggss', 'sggoooooooogggss', 'sssssssssssssss'],\n  pearl: ['kkkkkkkkkkkkkkkk', 'kkkkkkkwwwwkkkkk', 'kkkkkkwwwwwwkkkk', 'kkbbbwwwkwwwkkkk', 'kkbbbbwwwwwokkkk', 'kkkbbbbwwwoookkk', 'kkkkkbkwwwkkkkkk', 'kkkkkwkwwwkkkkkk', 'kkkkkkwwwwwkkkkk', 'kkkkkbbbbbbbkkkk', 'kkkkbbbbbbbbbkkk', 'kkkkbbbbbbbbbbkk'],\n  wave: ['ssssssssssssssss', 'ssssssswwssssrss', 'ssssswwbbwsssrss', 'ssswbbbbbbwsssss', 'sswbbwwbbbbwssss', 'swbbwsswbbbbwsss', 'sbbbwsssbbbbbwss', 'sbbbbssbbbbbbbbs', 'bbbbbbbbbbbbbbbb', 'bbooobbbbooobbbb', 'bbbbbbbbbbbbbbbb'],\n  starry: ['nnnnwnnnnnnwnnnn', 'nnbbbbnnwnnnnwnn', 'nbbsbbbbbnnnnnnn', 'nnbbbbbsbbbnnwnn', 'nnnwnbbbbbbbnnnn', 'nwnnnnnnbbsbbnnn', 'nnnnnnnnnnbbbnwn', 'kkknnnnnkknnnnnn', 'kkkkkkkkkkkkkkkk', 'kkrrrrrkkkkkkkkk', 'kkkkrkkkkkkkkkkk', 'kkkkrkkkkkkkkkkk'],\n  venus: ['bbbbbbbbbbbbbbbb', 'bbbbbbgggbbbbbbb', 'bbbbbgrrrgbbbbbb', 'bbbbbgrrrgbbbbbb', 'bbbbbbgggbbbbbbb', 'bbbbbbbgbbbbbbbb', 'bbbbbbbgbbbbbbbb', 'bbbwwwwwwwwwbbbb', 'bbwwswwswwswwbbb', 'bbbwwwwwwwwwbbbb', 'ssssssssssssssss'],\n  honk: ['ooorrroooorrrooo', 'oorrrroooorrroooo'.slice(0, 16), 'ooorrrrooorrrrro', 'rrrrbbbbbbbbbbbb', 'bbbbnnnnnnnnnnnn', 'bnnnnwwwwnnnnnnn', 'nnnnwwwwwwnnnnnn', 'nnnnwkwwkwnnnnnn', 'nnnnwwkkwwnnnnnn', 'nnnnnwwwwnnnnnnn', 'kkkkkkwwkkkkkkkk', 'kkkkkkwwkkkkkkkk'],\n  whistler: ['mmmmmmmmmmmmmmmm', 'mmmmmmmmmmmmmmmm', 'mmkkkkkkmmmmmmmm', 'mmkwwwwkmmmmoomm', 'mmkwwwwkmmmooomm', 'mmkkkkkkmmmoookm', 'mmmmmmmmmmmkkkkm', 'mmmmmmmmmkkkkkkm', 'mmmmmmmkkkkkkkkm', 'mmmmmkkkkkkkkkkk', 'sssssssssssssssk', 'ssssssssssssssss'],\n  cheese: ['bbbbbbbbbbbbbbbb', 'bbbsssbbbbsssbbb', 'bbsssssbbsssssbb', 'bbsksssbbsskssbb', 'bbsssssbbsssssbb', 'ggggggggggggggg', 'ggsgggsssggggsgg', 'ggssgsssssgggssg', 'gsssssksssssssss', 'ssssssssskssssss', 'sksssssssssssskk', 'ssssssssssssssss'],\n};\nconst CP = { s: 'sand', g: 'green', w: 'white', k: 'ink', r: 'red', o: 'orange', b: 'blue', n: 'navy', m: 'mist' };\n/** Painting texture. A forged one has one telling difference. */\nexport function paintingTexture(id, forged) {\n  const rows = PAINT[id]; const w = 16, h = 12;\n  return dataTexture(`art-${id}-${forged ? 'f' : 'r'}`, w, h, (x, y) => {\n    let ch = rows[h - 1 - y]?.[x] ?? rows[0][0];\n    if (forged && FORGERY[id]?.[0] === x && FORGERY[id]?.[1] === h - 1 - y) ch = FORGERY[id][2];\n    return PALETTE[CP[ch] ?? 'mist'];\n  });\n}\nexport const FORGERY = { mona: [8, 6, 'k'], pearl: [6, 7, 'k'], wave: [13, 1, 's'], starry: [11, 0, 'n'], venus: [8, 2, 'b'], honk: [7, 7, 'n'], whistler: [13, 3, 'k'], cheese: [6, 3, 'b'] };\nexport const PAINT_ROWS = PAINT; export const PAINT_COL = CP;\nE\ncat > src/art/models.js <<'E'\n// The game's own models as data. Everything exported is drawn by `node check.mjs --sheets src/art/models.js`.\nimport { model, MODEL_LIBRARY, ModelCatalog } from '../engine.js';\nimport { GLYPHS } from '../ui/font.js';\nimport { P16 } from './critter.js';\nconst box = (w, h, d, at, c, x) => ({ box: [w, h, d], at, c, ...x });\nconst ball = (w, h, d, at, c, x) => ({ ball: [w, h, d], at, c, ...x });\nconst cyl = (w, h, d, at, c, x) => ({ cyl: [w, h, d], at, c, ...x });\nconst cone = (w, h, d, at, c, x) => ({ cone: [w, h, d], at, c, ...x });\nconst wedge = (w, h, d, at, c, x) => ({ wedge: [w, h, d], at, c, ...x });\nconst M = (id, about, tags, parts, o = {}) => model({ id, about, tags, palette: { ...P16, ...(o.palette ?? {}) }, parts, ...o });\n/** Sign text in 3D: letters built from the bitmap font as small boxes. */\nexport function signParts(text, at, c = 'cyan', px = 0.09, glow = true, d = 0.05) {\n  const w = [...text].reduce((s, ch) => s + (GLYPHS[ch]?.w ?? 3) + 1, -1) * px; let cx = at[0] - w / 2; const out = [];\n  for (const ch of text) { const g = GLYPHS[ch] ?? GLYPHS[' ']; g.rows.forEach((r, ry) => { for (let i = 0; i < r.length; i++) if (r[i] === '#') out.push(box(px, px, d, [cx + i * px + px / 2, at[1] - ry * px, at[2]], c, glow ? { glow: true } : {})); }); cx += (g.w + 1) * px; }\n  return out;\n}\n/** Cottage shell: walls, two wedge roofs, door south (+Z), a window either side, chimney. */\nfunction shell(w = 4.4, h = 2.2, d = 3.6, walls = 'white', roof = 'red', door = 'orange', trim = 'ink', windowC = 'cyan') {\n  const rh = 1.2;\n  return [box(w, h, d, [0, h / 2, 0], walls), box(w + 0.1, 0.16, d + 0.1, [0, 0.08, 0], 'slate'),\n    wedge(w + 0.3, rh, d / 2 + 0.2, [0, h + rh / 2, -d / 4 - 0.05], roof), wedge(w + 0.3, rh, d / 2 + 0.2, [0, h + rh / 2, d / 4 + 0.05], roof, { rot: [0, 180, 0] }),\n    box(0.9, 1.7, 0.08, [0, 0.85, d / 2 + 0.02], door), box(1.06, 0.12, 0.1, [0, 1.74, d / 2 + 0.02], trim), box(0.1, 0.1, 0.06, [0.3, 0.85, d / 2 + 0.07], 'sand'),\n    { mirror: [box(0.72, 0.72, 0.06, [w / 2 - 0.85, 1.25, d / 2 + 0.02], trim), box(0.56, 0.56, 0.08, [w / 2 - 0.85, 1.25, d / 2 + 0.03], windowC, { name: 'win' })], axis: 'x' },\n    { mirror: [box(0.06, 0.72, 0.72, [w / 2 + 0.02, 1.25, -0.4], trim), box(0.08, 0.56, 0.56, [w / 2 + 0.03, 1.25, -0.4], windowC)], axis: 'x' },\n    box(0.5, 1.2, 0.5, [w / 2 - 0.8, h + 0.9, -0.5], 'slate'), box(0.6, 0.12, 0.6, [w / 2 - 0.8, h + 1.5, -0.5], 'ink')];\n}\nexport const homeT1 = M('home1', 'Starter shack with a tarp roof', ['building'], [box(3.4, 1.9, 3, [0, 0.95, 0], 'sand'), box(3.5, 0.14, 3.1, [0, 0.07, 0], 'slate'), wedge(3.7, 0.7, 3.3, [0, 2.25, 0], 'blue'), box(0.86, 1.6, 0.08, [0, 0.8, 1.52], 'orange'), box(0.6, 0.6, 0.06, [1.1, 1.2, 1.52], 'cyan'), box(0.2, 0.2, 0.08, [-1.1, 1.3, 1.53], 'ink')]);\nexport const homeT2 = M('home2', 'Proper cottage', ['building'], shell(4.4, 2.2, 3.6, 'sand', 'orange'));\nexport const homeT3 = M('home3', 'Cottage with annex', ['building'], [...shell(4.4, 2.2, 3.6, 'sand', 'orange'), box(2.2, 1.7, 2.6, [-3.2, 0.85, 0.2], 'white'), wedge(2.5, 0.8, 2.9, [-3.2, 2.1, 0.2], 'orange', { rot: [0, 90, 0] }), box(0.7, 0.7, 0.06, [-3.2, 1.05, 1.52], 'cyan')]);\nexport const homeT4 = M('home4', 'Two storeys and a plaque', ['building'], [box(4.4, 4.0, 3.6, [0, 2, 0], 'sand'), box(4.5, 0.14, 3.7, [0, 0.07, 0], 'slate'), box(4.5, 0.12, 3.7, [0, 2.1, 0], 'orange'), wedge(4.8, 1.2, 2, [0, 4.6, -0.95], 'red'), wedge(4.8, 1.2, 2, [0, 4.6, 0.95], 'red', { rot: [0, 180, 0] }), box(0.9, 1.7, 0.08, [0, 0.85, 1.82], 'red'), box(0.5, 0.3, 0.06, [1, 0.9, 1.82], 'sand'), { mirror: [box(0.64, 0.64, 0.08, [1.3, 3.1, 1.82], 'cyan'), box(0.64, 0.64, 0.08, [1.45, 1.3, 1.82], 'cyan')], axis: 'x' }, box(2.2, 1.7, 2.6, [-3.2, 0.85, 0.2], 'white'), wedge(2.5, 0.8, 2.9, [-3.2, 2.1, 0.2], 'orange', { rot: [0, 90, 0] })]);\nconst COTTAGE = { dorrit: ['orange', 'plum', 'red'], tavi: ['sand', 'orange', 'lime'], bartleby: ['slate', 'night', 'mist'], ottoline: ['plum', 'navy', 'sand'], rocco: ['red', 'slate', 'white'], nib: ['navy', 'plum', 'sky'], ozzie: ['mist', 'slate', 'ink'], yolanda: ['sand', 'red', 'blue'], fitch: ['red', 'slate', 'sand'] };\nexport const cottages = Object.entries(COTTAGE).map(([k, [walls, roof, door]]) => M('cottage-' + k, `Cottage of ${k}`, ['building', 'cottage'], [...shell(4.4, 2.2, 3.6, walls, roof, door), ...(k === 'tavi' ? [ball(0.7, 0.7, 0.1, [1.3, 3.3, 1.5], 'sand', { name: 'sun' })] : k === 'nib' ? [cyl(0.2, 0.9, 0.2, [-1.2, 3.1, 0.8], 'sand', { rot: [40, 0, 20] })] : k === 'ozzie' ? [box(0.7, 0.7, 0.7, [2.7, 0.35, 1.2], 'orange'), box(0.5, 0.5, 0.5, [2.7, 0.95, 1.2], 'sand')] : k === 'rocco' ? [cyl(0.2, 0.9, 0.2, [2.8, 0.45, 1.1], 'mist'), cyl(0.6, 0.1, 0.6, [2.8, 0.95, 1.1], 'ink')] : k === 'bartleby' ? [box(0.9, 0.06, 0.06, [-2.4, 1.6, 1.8], 'white')] : k === 'yolanda' ? [ball(0.5, 0.5, 0.5, [2.6, 0.26, 1.4], 'red'), ball(0.36, 0.36, 0.36, [2.2, 0.2, 1.4], 'blue')] : k === 'ottoline' ? [cyl(0.3, 0.8, 0.3, [-2.6, 0.4, 1.2], 'mist'), cone(0.5, 0.4, 0.5, [-2.6, 1, 1.2], 'plum')] : [cyl(0.4, 0.5, 0.4, [2.6, 0.25, 1.2], 'ink')])]));\nexport const store1 = M('store1', \"Mrs. Gander's first store\", ['building'], [...shell(5, 2.4, 4, 'sky', 'navy', 'red'), box(3.4, 0.6, 0.1, [0, 2.2, 2.08], 'white'), ...signParts('GANDER', [0, 2.42, 2.14], 'navy', 0.07, false), box(5.2, 0.14, 1, [0, 1.95, 2.4], 'white')]);\nexport const store2 = M('store2', \"Mrs. Gander's bigger