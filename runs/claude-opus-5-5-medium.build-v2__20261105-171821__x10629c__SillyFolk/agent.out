{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkni3h7Z8i6ZRoPXWZVv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Eg8GU8K5Ns8yAJefNSrHso","name":"Bash","input":{"command":"cat > src/net/transport.js <<'E'\n// One interface over the hub, BroadcastChannel and WebRTC: send(data, { to, reliable }), on('message'), players. The hub's budget holds everywhere.\nexport class Budget { constructor() { this.t = []; } ok(now) { while (this.t.length && now - this.t[0] > 1000) this.t.shift(); if (this.t.length >= 20 && this.burst(now)) return false; this.t.push(now); return true; } burst(now) { return this.t.length >= 40 || this.t.filter((x) => now - x < 1000).length >= 40; } }\nexport class Transport { constructor() { this.handlers = []; this.budget = new Budget(); } on(ev, f) { if (ev === 'message') this.handlers.push(f); } emit(data, from) { for (const h of this.handlers) h(data, from); } close() {} }\nexport class HubTransport extends Transport { constructor(hub) { super(); this.hub = hub; hub.on('message', (d, f) => this.emit(d, f)); } send(data, o = {}) { return this.hub.send(data, o); } }\n/** Two windows on one computer, same browser profile. Rooms are channels named per host. */\nexport class BroadcastTransport extends Transport {\n  constructor(channel, id) { super(); this.id = id; this.ch = new BroadcastChannel(channel); this.ch.onmessage = (e) => { const m = e.data; if (m.to != null && m.to !== this.id) return; if (m.from === this.id) return; this.emit(m.d, m.from); }; }\n  send(data, o = {}) { if (!this.budget.ok(Date.now())) return false; if (JSON.stringify(data).length > 16384) return false; this.ch.postMessage({ d: data, from: this.id, to: o.to }); return true; }\n  close() { this.ch.close(); }\n}\nconst zip = async (s) => { const cs = new CompressionStream('deflate-raw'); const w = cs.writable.getWriter(); w.write(new TextEncoder().encode(s)); w.close(); const b = new Uint8Array(await new Response(cs.readable).arrayBuffer()); return btoa(String.fromCharCode(...b)); };\nconst unzip = async (b64) => { const bin = Uint8Array.from(atob(b64.trim()), (c) => c.charCodeAt(0)); const ds = new DecompressionStream('deflate-raw'); const w = ds.writable.getWriter(); w.write(bin); w.close(); return new TextDecoder().decode(await new Response(ds.readable).arrayBuffer()); };\nconst waitIce = (pc) => new Promise((res) => { if (pc.iceGatheringState === 'complete') return res(); const t = setTimeout(res, 4000); pc.addEventListener('icegatheringstatechange', () => { if (pc.iceGatheringState === 'complete') { clearTimeout(t); res(); } }); });\n/** Serverless WebRTC: a Gate Pass (offer) goes to the friend, who returns a Reply Slip (answer). */\nexport class RtcTransport extends Transport {\n  constructor(id, iceServers) { super(); this.id = id; this.ice = iceServers ?? [{ urls: 'stun:stun.l.google.com:19302' }]; this.peers = new Map(); this.opening = null; }\n  wire(pc, ch, peerId) { ch.onmessage = (e) => { const m = JSON.parse(e.data); this.emit(m, peerId); }; ch.onopen = () => { this.onopen?.(peerId); }; ch.onclose = () => { this.peers.delete(peerId); this.onclose?.(peerId); }; this.peers.set(peerId, { pc, ch }); }\n  async makeGatePass(peerId) { const pc = new RTCPeerConnection({ iceServers: this.ice }); const ch = pc.createDataChannel('gate', { ordered: true }); this.wire(pc, ch, peerId); await pc.setLocalDescription(await pc.createOffer()); await waitIce(pc); return zip(JSON.stringify(pc.localDescription)); }\n  async acceptGatePass(code, hostId) { const pc = new RTCPeerConnection({ iceServers: this.ice }); pc.ondatachannel = (e) => this.wire(pc, e.channel, hostId); await pc.setRemoteDescription(JSON.parse(await unzip(code))); await pc.setLocalDescription(await pc.createAnswer()); await waitIce(pc); return zip(JSON.stringify(pc.localDescription)); }\n  async acceptReply(code, peerId) { await this.peers.get(peerId).pc.setRemoteDescription(JSON.parse(await unzip(code))); }\n  send(data, o = {}) { if (!this.budget.ok(Date.now())) return false; const s = JSON.stringify(data); if (s.length > 16384) return false; for (const [id, p] of this.peers) { if (o.to != null && o.to !== id) continue; if (p.ch.readyState === 'open') p.ch.send(s); } return true; }\n  close() { for (const p of this.peers.values()) p.pc.close(); this.peers.clear(); }\n}\nE\ncat > src/net/round.js <<'E'\n// AI Hub session: \"The Bean Bazaar\". Five minutes on a small green; the host's copy runs the world.\nimport { Engine, THREE, buildModel, toonMaterial, PALETTE, applySky, skyAt, WaterSurface, WAVES_CALM, loadPack, MODEL_LIBRARY, setLookLayer } from '../engine.js';\nimport { Place } from '../world/place.js';\nimport { TerrainView } from '../world/terrainMesh.js';\nimport { HubTransport } from './transport.js';\nimport { Actor } from '../actors/actor.js';\nimport { critterDef } from '../art/critter.js';\nimport { Controls } from '../ui/input.js';\nimport { UI, panel, promptRow, drawGlyph } from '../ui/kit.js';\nimport { drawText, textWidth } from '../ui/font.js';\nimport { G } from '../state.js';\nimport { CAST } from '../data/cast.js';\nimport { SONGS } from '../audio/composer.js';\nimport { SFX_DEFS } from '../audio/sfx.js';\nimport { itemDef } from '../art/models.js';\nimport { ITEMS } from '../data/items.js';\nimport '../art/textures.js';\nconst ROWS = (() => { const W = 32, H = 24; const g = Array.from({ length: H }, () => Array(W).fill('.')); const rect = (a, b, c, d, ch) => { for (let z = b; z <= d; z++) for (let x = a; x <= c; x++) g[z][x] = ch; }; rect(0, 0, 31, 0, '#'); rect(0, 23, 31, 23, '#'); rect(0, 0, 0, 23, '#'); rect(31, 0, 31, 23, '#'); rect(2, 16, 9, 21, 'o'); rect(24, 1, 26, 22, 'w'); rect(24, 11, 26, 13, 'b'); rect(12, 10, 19, 14, 'P'); return g.map((r) => r.join('')); })();\nconst STALL = [16, 11]; const SIZE = 5; const SEATS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700']; const ROUND_MS = 5 * 60000;\nconst ORDERS = [['dorrit', 'pear', 'Dorrit wants a pear'], ['tavi', 'bug', 'Tavi wants a butterfly'], ['bartleby', 'fish', 'Bartleby would prefer a fish'], ['yolanda', 'fossil', 'Yolanda wants a fossil, hon'], ['rocco', 'fish', 'Rocco needs fish. For protein']];\nconst VALUE = { pear: 100, flower: 80, bug: 200, fish: 300, goldfish: 3000, fossil: 600, goldpear: 800 };\nconst AWARDS = [['Most Fish Apologised To', (s) => s.fish], ['Tree Botherer of the Year', (s) => s.pears], ['Bug Whisperer', (s) => s.bugs], ['Bean Counter, Honorary', (s) => s.sold], ['Friend to Moles', (s) => s.fossils], ['Sash Bumper', (s) => s.bumps]];\nclass RoundGame {\n  name = 'Silly Folk: The Bean Bazaar'; target = new THREE.Vector3(16, 1, 12);\n  constructor(hub) { this.hub = hub; this.info = hub; }\n  async setup(ctx) {\n    this.ctx = ctx; G.ctx = ctx; const hub = this.hub; UI.ctrl = this.ctrl = new Controls(ctx); UI.clear(); await loadPack('packs/kenney-furniture.json', { into: MODEL_LIBRARY }).catch(() => {});\n    for (const [k, d] of Object.entries(SFX_DEFS)) ctx.audio.register(k, d);\n    if (!localStorageHasAudio()) ctx.audio.setVolume('music', 0.1);\n    applySky(ctx.engine, skyAt(11));\n    this.net = new HubTransport(hub); this.isHost = hub.isHost; this.me = hub.me; this.server = !!hub.server; this.place = new Place('fair', ROWS);\n    const g = (this.g = new THREE.Group()); ctx.scene.add(g); const t = new TerrainView(this.place, g); t.season = 1; t.buildAll();\n    const water = new WaterSurface({ size: [60, 50], at: [16, -0.35, 12], segments: [60, 50], waves: WAVES_CALM, deep: PALETTE.blue, shallow: PALETTE.sky, foam: PALETTE.white, foamAt: 0.6 }); g.add(water); this.water = water;\n    const under = new THREE.Mesh(new THREE.PlaneGeometry(90, 80).rotateX(-Math.PI / 2), toonMaterial(PALETTE.teal)); under.position.set(16, -0.1, 12); g.add(under);\n    const stall = buildModel('market-stall', { palette: { cloth: 'red' } }).object; stall.position.set(STALL[0], 0, STALL[1]); g.add(stall); this.place.rects.push({ x0: STALL[0] - 1.3, z0: STALL[1] - 0.8, x1: STALL[0] + 1.3, z1: STALL[1] + 0.8 });\n    const br = buildModel('sf-bridge', {}).object; br.position.set(25, 0, 12); br.rotation.y = 0; g.add(br);\n    // World: trees, cracks, flowers, bugs. Same on every copy from the hub's seed.\n    const rng = hub.rng('world'); const pick = (a, b) => a + rng() * (b - a);\n    this.trees = Array.from({ length: 8 }, (_, i) => ({ i, x: 4 + (i % 4) * 4.5 + pick(-0.4, 0.4), z: 3 + Math.floor(i / 4) * 4.5 + pick(-0.4, 0.4), fruit: 2, rich: false, cool: 0 }));\n    for (const tr of this.trees) { const m = buildModel('pear-tree', { palette: { leaf: 'green', leaf2: 'lime' } }).object; m.position.set(tr.x, 0, tr.z); g.add(m); tr.m = m; this.place.circles.push({ x: tr.x, z: tr.z, r: 0.45 }); const fmat = toonMaterial(PALETTE.lime); tr.fm = []; for (let k = 0; k < 3; k++) { const f = new THREE.Mesh(new THREE.SphereGeometry(0.17, 6, 5), fmat); f.position.set(Math.cos(k * 2.1), 1.8, Math.sin(k * 2.1) + 0.35); m.add(f); tr.fm.push(f); } }\n    this.cracks = Array.from({ length: 6 }, (_, i) => ({ i, x: Math.floor(pick(12, 22)) + 0.5, z: Math.floor(pick(16, 22)) + 0.5, alive: true })); this.crackM = this.cracks.map((c) => { const m = buildModel('sf-crack', {}).object; m.position.set(c.x, 0.01, c.z); g.add(m); return m; });\n    this.flowers = Array.from({ length: 6 }, (_, i) => ({ i, x: 28 + pick(0, 2.4), z: 2 + i * 3.4, alive: true })); this.flowerM = this.flowers.map((c, i) => { const m = buildModel('fl-tulip', { palette: { petal: ['red', 'sand', 'plum'][i % 3] } }).object; m.position.set(c.x, 0, c.z); g.add(m); return m; });\n    this.bugs = Array.from({ length: 5 }, (_, i) => ({ i, ax: pick(13, 22), az: pick(3, 9), x: 0, z: 0, alive: true })); this.bugM = this.bugs.map((b) => { const m = buildModel(itemDef(ITEMS.cabbagefly), {}).object; g.add(m); return m; });\n    this.fishSpot = { x: 5.5, z: 18.5, gold: false }; this.shadow = new THREE.Mesh(new THREE.SphereGeometry(0.6, 6, 4), toonMaterial(PALETTE.night)); this.shadow.scale.set(1, 0.05, 1.5); this.shadow.position.set(5.5, -0.27, 18.5); g.add(this.shadow);\n    this.mayor = new Actor(critterDef({ id: 'round-mayor', ...CAST.trundle.look }), { seed: 2 }); this.mayor.addTo(g); this.mayor.play('MayorSlide'); this.mayorX = 11;\n    this.orderers = {}; this.state = { players: {}, order: null, orderT: 12, bell: null, ended: false, time: 0 }; this.avatars = new Map(); this.seat = {};\n    (hub.players ?? []).forEach((p, i) => this.addPlayer(p.id, p.name, p.color ?? SEATS[i % 4], i));\n    this.net.on('message', (d, f) => this.onMsg(d, f));\n    hub.on('leave', ({ id }) => this.removePlayer(id)); hub.on('time-up', () => { if (this.isHost) this.finish(); }); hub.on('end', () => this.onEnd()); hub.on('card', (c) => { this.card = c; }); hub.on('start', () => { this.started = true; this.startAt = true; ctx.audio.playMusic(SONGS.round, 'round'); });\n    ctx.audio.playMusic(SONGS.card, 'card'); this.touchSpectator = navigator.maxTouchPoints > 0 && !matchMedia('(any-pointer: fine)').matches && !navigator.getGamepads?.()[0];\n    this.key = (e) => { if (this.ended) return; if (this.started) return; if (e.key === 'Enter') hub.answer('ready'); if (e.key === 't' || e.key === 'T') hub.answer('more'); }; window.addEventListener('keydown', this.key);\n    this.tap = (e) => { if (this.started || this.ended) return; const y = e.clientY / innerHeight; if (y > 0.8) hub.answer(e.clientX / innerWidth < 0.5 ? 'ready' : 'more'); }; window.addEventListener('pointerdown', this.tap);\n  }\n  ready() { this.hub.ready(); window.__ROUND__ = this; }\n  addPlayer(id, name, color, i) { if (this.state.players[id]) return; const sp = [14 + (i % 2) * 4, 15 + Math.floor(i / 2) * 1.5]; this.state.players[id] = { id, x: sp[0], z: sp[1], f: 0, a: 0, pockets: [], banked: 0, stats: { fish: 0, pears: 0, bugs: 0, sold: 0, fossils: 0, bumps: 0 }, fishing: null, bumpT: 0 }; const a = new Actor(critterDef({ id: 'round-p' + id, species: 'person', c1: 'sand', c2: 'white', shirt: 'white', trousers: 'navy', shoes: 'ink', hair: id % 8, hairColor: ['orange', 'ink', 'plum', 'sand'][id % 4], eyes: id % 6 }), { seed: id * 3 }); a.addTo(this.g); const col = toonMaterial(new THREE.Color(color).getHex()); const wh = new THREE.Color(PALETTE.white).getHex(); a.obj.traverse((m) => { if (m.isMesh && m.material?.color?.getHex?.() === wh && ['Torso', 'ArmR', 'ArmL'].includes(m.parent?.name)) m.material = col; }); this.avatars.set(id, { a, name, color, x: sp[0], z: sp[1], tx: sp[0], tz: sp[1], f: 0, hist: [] }); a.place(sp[0], 0, sp[1]); this.seat[id] = i; }\n  removePlayer(id) { const v = this.avatars.get(id); if (v) { v.a.removeFrom(); this.avatars.delete(id); } delete this.state.players[id]; }\n  onMsg(d, from) {\n    if (d.t === 'me' && this.isHost) { const p = this.state.players[from]; if (p) { p.x = d.x; p.z = d.z; p.f = d.f; p.a = d.a; } }\n    else if (d.t === 'do' && this.isHost) this.act(from);\n    else if (d.t === 'snap' && !this.isHost) { this.state.time = d.time; this.mayorX = d.mx; this.fishSpot = { x: d.fx, z: d.fz, gold: d.gold }; d.p.forEach(([id, x, z, f, a, banked, carried]) => { const v = this.avatars.get(id); if (!v) return; v.hist.push({ t: performance.now(), x, z, f, a }); if (v.hist.length > 6) v.hist.shift(); const st = this.state.players[id]; if (st) { st.banked = banked; st.carried = carried; if (id !== this.me) { st.x = x; st.z = z; } } }); }\n    else if (d.t === 'ev' && !this.isHost) this.applyEv(d);\n  }\n  applyEv(d) { if (d.tree) { const tr = this.trees[d.tree[0]]; tr.fruit = d.tree[1]; tr.rich = d.tree[2]; } if (d.crack != null) this.cracks[d.crack].alive = false; if (d.flower != null) this.flowers[d.flower].alive = false; if (d.bug) { this.bugs[d.bug[0]].alive = d.bug[1]; } if (d.order !== undefined) this.state.order = d.order; if (d.bell) this.announce(d.bell); if (d.say && d.say[0] === this.me) { this.toast = d.say[1]; this.toastT = 2.4; this.ctx.audio.play(d.say[2] ?? 'pickup'); } if (d.pockets && d.pockets[0] === this.me) { const st = this.state.players[this.me]; if (st) st.pockets = d.pockets[1]; } if (d.fishing && d.fishing[0] === this.me) { this.fishingLocal = d.fishing[1]; } }\n  announce(text) { this.bellText = text; this.bellT = 4; this.ctx.audio.play('reveal'); }\n  send(ev) { this.net.send({ t: 'ev', ...ev }); this.applyLocal(ev); }\n  applyLocal(ev) { if (ev.say && ev.say[0] === this.me) { this.toast = ev.say[1]; this.toastT = 2.4; this.ctx.audio.play(ev.say[2] ?? 'pickup'); } if (ev.bell) this.announce(ev.bell); if (ev.fishing && ev.fishing[0] === this.me) this.fishingLocal = ev.fishing[1]; }\n  /** Host: the one verb. Contextual on what's nearest. */\n  act(id) {\n    const p = this.state.players[id]; if (!p || this.state.ended || this.hub.time() < 0) return; const near = (x, z, r) => (p.x - x) ** 2 + (p.z - z) ** 2 < r * r; const say = (s, snd) => ({ say: [id, s, snd] });\n    if (p.fishing) { if (p.fishing.stage === 'bite') { const it = this.fishSpot.gold ? 'goldfish' : 'fish'; p.fishing = null; if (this.addPocket(p, it, id)) { p.stats.fish++; this.send({ ...say(it === 'goldfish' ? 'The golden fish!' : 'You caught a fish. Sorry, fish.', 'splash'), fishing: [id, null] }); if (it === 'goldfish') { this.fishSpot.gold = false; } } } else { p.fishing = null; this.send({ ...say('Too soon. It has told the others.', 'flee'), fishing: [id, null] }); } return; }\n    if (near(STALL[0], STALL[1] + 1, 2.4) && p.pockets.length) { let sum = 0; const o = this.state.order; for (const it of p.pockets) { let v = VALUE[it]; if (o && (o.want === it || (o.want === 'fish' && it === 'goldfish'))) { v *= 2; this.state.order = null; this.state.orderT = 15; this.send({ order: null }); } sum += v; } p.banked += sum; p.stats.sold += sum; p.pockets = []; this.net.send({ t: 'ev', pockets: [id, []] }); this.send(say(`Sold! +${sum} beans`, 'reveal')); return; }\n    if (p.pockets.length >= SIZE) { this.send(say('Your pockets are full. Sell at the stall!', 'uiNo')); return; }\n    const mayorHit = near(this.mayorX, 8.4, 1.4); if (mayorHit && p.bumpT <= 0) { p.bumpT = 30; p.banked += 150; p.stats.bumps++; this.send(say('The Mayor tips his sash. +150 beans', 'plume')); return; }\n    for (const b of this.bugs) if (b.alive && near(b.x, b.z, 1.8)) { b.alive = false; b.back = 20; p.stats.bugs++; this.addPocket(p, 'bug', id); this.send({ bug: [b.i, false], ...say('Swing! Got a butterfly.', 'netHit') }); return; }\n    for (const tr of this.trees) if (near(tr.x, tr.z, 1.5)) { if (tr.fruit > 0) { tr.fruit--; tr.cool = 18; p.stats.pears++; this.addPocket(p, tr.rich ? 'goldpear' : 'pear', id); if (tr.fruit === 0) tr.rich = false; this.send({ tree: [tr.i, tr.fruit, tr.rich], ...say('Shake! A pear falls on you.', 'shake') }); } else this.send(say('Nothing left. It looks at you.', 'shake')); return; }\n    for (const c of this.cracks) if (c.alive && near(c.x, c.z, 1.3)) { c.alive = false; p.stats.fossils++; this.addPocket(p, 'fossil', id); this.send({ crack: c.i, ...say('Dig! A fossil, or a very confident potato.', 'dig') }); return; }\n    for (const f of this.flowers) if (f.alive && near(f.x, f.z, 1.2)) { f.alive = false; this.addPocket(p, 'flower', id); this.send({ flower: f.i, ...say('Picked. It will die, but pretty.', 'pickup') }); return; }\n    const facing = [p.x + Math.sin(p.f) * 2, p.z + Math.cos(p.f) * 2]; if (this.place.isWater(facing[0], facing[1]) || this.place.isWater(p.x, p.z + 1.6) || this.place.isWater(p.x + 1.6, p.z)) { p.fishing = { stage: 'wait', t: 1 + Math.random() * 2 }; this.send({ ...say('Cast…', 'cast'), fishing: [id, 'wait'] }); return; }\n    this.send(say('Nothing here. Try a tree, a crack, the water or the stall.', 'uiNo'));\n  }\n  addPocket(p, it, id) { if (p.pockets.length >= SIZE) { this.send({ say: [id, 'Your pockets are full!', 'uiNo'] }); return false; } p.pockets.push(it); this.net.send({ t: 'ev', pockets: [id, p.pockets.slice()] }); return true; }\n  hostFixed(dt) {\n    const s = this.state, t = this.hub.time(); if (t < 0 || s.ended) return; s.time = t;\n    for (const p of Object.values(s.players)) { p.bumpT = Math.max(0, p.bumpT - dt); if (p.fishing) { p.fishing.t -= dt; if (p.fishing.stage === 'wait' && p.fishing.t <= 0) { p.fishing = { stage: 'bite', t: 0.9 }; this.send({ say: [p.id, 'Bite! Press now!', 'bite'], fishing: [p.id, 'bite'] }); } else if (p.fishing.stage === 'bite' && p.fishing.t <= 0) { p.fishing = null; this.send({ say: [p.id, 'It got away.', 'flee'], fishing: [p.id, null] }); } } }\n    for (const tr of this.trees) if (tr.fruit < 2) { tr.cool -= dt; if (tr.cool <= 0) { tr.fruit++; tr.cool = 18; this.send({ tree: [tr.i, tr.fruit, tr.rich] }); } }\n    for (const b of this.bugs) if (!b.alive) { b.back -= dt; if (b.back <= 0) { b.alive = true; this.send({ bug: [b.i, true] }); } }\n    s.orderT -= dt; if (!s.order && s.orderT <= 0) { const rng = this.hub.rng('order' + Math.floor(t / 1000)); const o = ORDERS[Math.floor(rng() * ORDERS.length)]; s.order = { who: o[0], want: o[1], text: `${o[2]}: double beans!` }; s.orderT = 25; this.send({ order: s.order }); }\n    if (s.order && s.orderT <= 0) { s.order = null; s.orderT = 10; this.send({ order: null }); }\n    const moments = [[60000, 'gold'], [150000, 'rich'], [240000, 'gold']]; s.bellI = s.bellI ?? 0; if (s.bellI < moments.length && t >= moments[s.bellI][0]) { const m = moments[s.bellI][1]; s.bellI++; if (m === 'gold') { this.fishSpot.gold = true; this.send({ bell: 'The bell rings! A golden fish in the pond!' }); } else { const tr = this.trees[Math.floor(this.hub.rng('rich')() * this.trees.length)]; tr.rich = true; tr.fruit = 2; this.send({ tree: [tr.i, 2, true], bell: 'The bell rings! A rich tree in the orchard!' }); } }\n    this.mayorX = 11 + (t / ROUND_MS) * 10; const bellAt = Math.min(ROUND_MS, (this.hub.limitMs ?? ROUND_MS) - 5000); if (t >= bellAt) this.finish();\n    this.fishSpot.x = 5.5 + Math.sin(t / 2000) * 2; this.fishSpot.z = 18.5 + Math.cos(t / 3000) * 1.6;\n    this.snapT = (this.snapT ?? 0) - dt; if (this.snapT <= 0) { this.snapT = 0.1; this.net.send({ t: 'snap', time: Math.round(t), mx: +this.mayorX.toFixed(2), fx: +this.fishSpot.x.toFixed(1), fz: +this.fishSpot.z.toFixed(1), gold: this.fishSpot.gold, p: Object.values(s.players).map((p) => [p.id, +p.x.toFixed(2), +p.z.toFixed(2), +p.f.toFixed(2), p.a, p.banked, p.pockets.length]) }, { reliable: false }); }\n  }\n  finish() { const s = this.state; if (s.ended || !this.isHost) return; s.ended = true; const players = Object.values(s.players).filter((p) => this.hub.players.some((q) => q.id === p.id)); const scoreOf = (p) => p.banked + Math.floor(p.pockets.reduce((a, it) => a + VALUE[it], 0) / 2); const scores = {}; const stats = {}; for (const p of players) { scores[p.id] = scoreOf(p); stats[p.id] = { Sold: p.stats.sold, Fish: p.stats.fish, Pears: p.stats.pears }; } const groups = new Map(); for (const p of players) { const k = scores[p.id]; if (!groups.has(k)) groups.set(k, []); groups.get(k).push(p.id); } const standings = [...groups.keys()].sort((a, b) => b - a).map((k) => groups.get(k)); const awards = []; for (const [title, f] of AWARDS) { let best = null, bv = 0; for (const p of players) { const v = f(p.stats); if (v > bv) { bv = v; best = p; } } if (best && awards.length < 3 && !awards.some((a) => a.id === best.id)) awards.push({ id: best.id, title, detail: `${bv}` }); } this.hub.finish({ standings, scores, stats, awards }); }\n  onEnd() { this.ended = true; this.state.ended = true; this.ctx.audio.stopMusic(); this.ctx.audio.stopLoops(); window.removeEventListener('keydown', this.key); window.removeEventListener('pointerdown', this.tap); }\n  fixedUpdate(ctx, dt) {\n    if (this.isHost) this.hostFixed(dt);\n    if (this.server || this.ended || this.touchSpectator) return; const t = this.hub.time(); const me = this.state.players[this.me]; if (!me || t < 0) return;\n    const ax = ctx.input.moveAxis(); const m = Math.min(1, Math.hypot(ax.x, ax.y)); this.moving = false; if (m > 0.1) { const b = ctx.engine.camera.groundBasis(); const fx = b.right.x * ax.x + b.forward.x * ax.y, fz = b.right.z * ax.x + b.forward.z * ax.y, l = Math.hypot(fx, fz) || 1; const sp = (ctx.input.isDown('ShiftLeft', 'PadCircle') ? 6 : 4.2) * dt; const [nx, nz] = this.place.move(me.x, me.z, (fx / l) * sp, (fz / l) * sp, 0.3); me.x = nx; me.z = nz; me.f = Math.atan2(fx, fz); this.moving = true; }\n    me.a = this.moving ? 1 : 0;\n    if (!this.isHost) { this.meT = (this.meT ?? 0) - dt; if (this.meT <= 0) { this.meT = 0.1; this.net.send({ t: 'me', x: +me.x.toFixed(2), z: +me.z.toFixed(2), f: +me.f.toFixed(2), a: me.a }, { reliable: false }); } }\n  }\n  update(ctx, dt) {\n    const c = this.ctrl, t = this.hub.time(); c.begin(dt); const h = ctx.hud; this.water.update(ctx.time);\n    if (!this.started && !this.ended) { if (c.input.wasPressed('PadCross')) this.hub.answer('ready'); if (c.input.wasPressed('PadTriangle')) this.hub.answer('more'); }\n    const pressed = !c.input.isDown('PadCreate') && (c.input.wasPressed('PadCross') || c.input.wasPressed('KeyE') || c.input.wasPressed('Enter') || c.input.wasPressed('Space'));\n    if (this.started && t >= 0 && pressed && !this.server && !this.ended && !this.touchSpectator) { if (this.isHost) this.act(this.me); else this.net.send({ t: 'do' }); const me = this.avatars.get(this.me); me?.a.play('PickUp', { then: 'Idle', restart: true }); }\n    const now = performance.now() - 120;\n    for (const [id, v] of this.avatars) { const st = this.state.players[id]; if (!st) continue; let x = st.x, z = st.z, f = st.f, a = st.a; if (!this.isHost && id !== this.me) { const hs = v.hist; if (hs.length >= 2) { let A = hs[0], B = hs[hs.length - 1]; for (let i = 0; i < hs.length - 1; i++) if (hs[i].t <= now && hs[i + 1].t >= now) { A = hs[i]; B = hs[i + 1]; break; } const k = Math.max(0, Math.min(1, (now - A.t) / Math.max(1, B.t - A.t))); x = A.x + (B.x - A.x) * k; z = A.z + (B.z - A.z) * k; f = B.f; a = B.a; } else if (hs.length) { x = hs[0].x; z = hs[0].z; f = hs[0].f; a = hs[0].a; } } else if (id === this.me && !this.isHost) { const last = v.hist[v.hist.length - 1]; if (last && Math.hypot(last.x - st.x, last.z - st.z) > 3) { st.x = last.x; st.z = last.z; x = st.x; z = st.z; } }\n      if (this.isHost && id !== this.me) { v.x += (x - v.x) * Math.min(1, dt * 12); v.z += (z - v.z) * Math.min(1, dt * 12); x = v.x; z = v.z; } v.a.place(x, this.place.heightAt(x, z), z); v.a.targetFacing = f; if (v.a.onceT <= 0 || a) v.a.play(a ? 'Jog' : 'Idle'); v.a.update(dt); }\n    for (let i = 0; i < this.trees.length; i++) { const tr = this.trees[i]; tr.fm.forEach((m, k) => { m.visible = k < tr.fruit; }); } this.cracks.forEach((c0, i) => { this.crackM[i].visible = c0.alive; }); this.flowers.forEach((f, i) => { this.flowerM[i].visible = f.alive; }); this.bugs.forEach((b, i) => { const ph = ctx.time * 0.7 + i; b.x = b.ax + Math.sin(ph) * 2; b.z = b.az + Math.cos(ph * 1.3) * 2; this.bugM[i].position.set(b.x, 0.8 + Math.sin(ctx.time * 3 + i) * 0.2, b.z); this.bugM[i].visible = b.alive; });\n    this.shadow.position.set(this.fishSpot.x, -0.27, this.fishSpot.z); this.shadow.material = toonMaterial(this.fishSpot.gold ? PALETTE.sand : PALETTE.night); this.mayor.place(this.mayorX, 0, 8.4); this.mayor.targetFacing = Math.PI / 2; this.mayor.update(dt);\n    const meA = this.avatars.get(this.me); const tgt = this.target; if (this.server || !meA) { const a = ctx.time * 0.1; tgt.set(16 + Math.cos(a) * 6, 1, 12 + Math.sin(a) * 4); if (!this.camSet) { this.camSet = true; ctx.engine.setCamera({ preset: 'iso', yaw: 45, pitch: 35, zoom: 0.8, minZoom: 0.8, maxZoom: 0.8 }, { syncUrl: false }); } } else tgt.set(meA.a.root.position.x, 1, meA.a.root.position.z);\n    this.toastT = Math.max(0, (this.toastT ?? 0) - dt); this.bellT = Math.max(0, (this.bellT ?? 0) - dt);\n    h.clear(); this.hudDraw(h, t);\n  }\n  hudDraw(h, t) {\n    const hub = this.hub, ctx = this.ctx; if (!this.started) return this.cardDraw(h); const s = this.state;\n    for (const [id, v] of this.avatars) { const pos = v.a.root.position; const P = pos.clone().setY(pos.y + 1.7).project(ctx.engine.camera.camera); const x = Math.round((P.x + 1) * 240), y = Math.round((1 - P.y) * 135); const w = textWidth(v.name) + 6; h.rect(x - w / 2, y - 9, w, 11, 'ink'); drawText(h, x, y - 7, v.name, { color: new THREE.Color(v.color).getHex(), align: 'center' }); }\n    let sx = 12; for (const [id, v] of this.avatars) { const st = s.players[id]; const b = st?.banked ?? 0; const label = `${v.name}: ${b}`; const w = textWidth(label) + 14; h.rect(sx, 12, w, 14, 'ink'); h.rect(sx, 12, 4, 14, new THREE.Color(v.color).getHex()); drawText(h, sx + 8, 15, label, { color: 'white' }); sx += w + 4; }\n    const left = Math.max(0, Math.ceil((Math.min(ROUND_MS, (hub.limitMs ?? ROUND_MS) - 5000) - Math.max(0, t)) / 1000)); const mm = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`; panel(h, 216, 30, 48, 15); drawText(h, 240, 34, mm, { color: 'navy', align: 'center' });\n    if (t < 0) { const n = Math.ceil(-t / 1000); drawText(h, 240, 100, String(n), { color: 'white', align: 'center', scale: 6, shadow: 'ink' }); }\n    if (s.order) { const w = textWidth(s.order.text) + 12; panel(h, 240 - w / 2, 48, w, 15); drawText(h, 240, 52, s.order.text, { color: 'red', align: 'center' }); }\n    if (this.bellT > 0) { const w = textWidth(this.bellText) + 12; panel(h, 240 - w / 2, 68, w, 15); drawText(h, 240, 72, this.bellText, { color: 'orange', align: 'center' }); }\n    if (this.toastT > 0 && this.toast) { const w = textWidth(this.toast) + 12; panel(h, 240 - w / 2, 214, w, 15); drawText(h, 240, 218, this.toast, { color: 'ink', align: 'center' }); }\n    const me = s.players[this.me]; if (me && !this.server) { const n = me.pockets?.length ?? 0; panel(h, 12, 240, 92, 18); for (let i = 0; i < SIZE; i++) { h.rect(18 + i * 16, 244, 13, 10, i < n ? 'orange' : 'mist'); } promptRow(h, 468, 245, [['confirm', 'Do the thing']], { align: 'right', back: 'ink' }); } if (this.touchSpectator) { panel(h, 110, 236, 260, 18); drawText(h, 240, 241, 'Controller or keyboard required', { color: 'red', align: 'center' }); }\n  }\n  cardDraw(h) { const c = this.card ?? {}; h.rect(0, 0, 480, 270, 'navy'); panel(h, 40, 16, 400, 234); drawText(h, 240, 26, 'The Bean Bazaar', { color: 'navy', align: 'center', scale: 3 }); drawText(h, 240, 56, 'Bank the most beans before the last bell.', { color: 'ink', align: 'center' }); drawText(h, 240, 70, 'Unbanked beans count half. Shake, dig, cast, swing, then sell at the stall.', { color: 'slate', align: 'center' }); let y = 90; for (const [id, v] of this.avatars) { h.rect(70, y, 340, 18, 'white'); h.rect(70, y, 8, 18, new THREE.Color(v.color).getHex()); drawText(h, 84, y + 5, v.name, { color: 'ink' }); drawText(h, 404, y + 5, c.ready?.includes(id) ? 'Ready!' : 'Getting ready', { color: c.ready?.includes(id) ? 'green' : 'slate', align: 'right' }); y += 20; } drawText(h, 240, 180, 'Move: stick or WASD. Do the thing: Cross or E. Run: Circle or Shift.', { color: 'ink', align: 'center' }); const left = c.left == null ? (c.paused ? 'Paused' : c.starting ? 'Starting…' : '') : `${Math.ceil(c.left / 1000)}s`; drawText(h, 240, 196, left, { color: 'red', align: 'center', scale: 2 }); h.rect(70, 218, 150, 20, 'navy'); drawText(h, 145, 224, 'Ready (Enter / Cross)', { color: 'white', align: 'center' }); h.rect(260, 218, 150, 20, c.asked ? 'red' : 'slate'); drawText(h, 335, 224, `More time (T / Triangle)`, { color: 'white', align: 'center' }); }\n  cameraTarget() { return this.target; }\n  status() { return `round t=${Math.round(this.hub.time())}`; }\n}\nconst localStorageHasAudio = () => { try { return !!localStorage.getItem('pixel-engine:audio'); } catch { return false; } };\nexport async function startRound(hub, options) {\n  const info = await hub.connect({ mode: 'shared-world', seats: [1, 4], card: true }); if (!info) return false;\n  try { await Engine.start(new RoundGame(hub), options('medium')); } catch (e) { hub.fail(String(e?.message ?? e)); }\n  return true;\n}\nE\ncat > src/net/visit.js <<'E'\n// Visit mode on its own: Open my gate / Visit a friend. Host's world is authoritative; guests keep only pockets and beans.\nimport { G, bus } from '../state.js';\nimport { UI, panel, menu, promptRow } from '../ui/kit.js';\nimport { drawText, textWidth } from '../ui/font.js';\nimport { Toasts, Script, say } from '../ui/dialogue.js';\nimport { BroadcastTransport, RtcTransport } from './transport.js';\nimport { serialize, deserialize, saveNow, loadSave, hasSave, markPlaying } from '../core/save.js';\nimport { storage } from '../core/storage.js';\nimport { setPlace, Trans } from '../world/places.js';\nimport { Actor } from '../actors/actor.js';\nimport { lookDef } from '../actors/player.js';\nimport { NPC } from '../actors/npcs.js';\nimport { THREE } from '../engine.js';\nimport { LANDMARK, BUILDINGS } from '../world/layout.js';\nimport { removeEnt, addEnt, giveItem, rebuildGrid } from '../core/world.js';\nimport { NEIGHBOURS } from '../data/cast.js';\nimport { ITEMS, EMOTE_CLIP } from '../data/items.js';\nimport { T } from '../dev/tuning.js';\nconst CANNED = ['Hello!', 'Nice town.', 'Is that goose always like that?', 'Look at this!', 'Thanks!', 'Bye!'];\nconst VISITOR_KEY = 'sillyfolk:visitor';\nconst myId = () => { let id = storage.get('sillyfolk:sid'); id = (typeof crypto !== 'undefined' ? crypto.randomUUID?.() : null) ?? String(Date.now() + Math.floor(performance.now())); return id; };\nconst Announce = 'sillyfolk-gates';\nclass Session {\n  constructor(role) { this.role = role; this.id = myId(); this.avatars = new Map(); this.transports = []; this.guests = new Map(); this.group = new THREE.Group(); G.ctx.scene.add(this.group); this.meT = 0; this.snapT = 0; this.entT = 0; this.lastEnts = new Map(); }\n  addTransport(t) { this.transports.push(t); t.on('message', (d, f) => this.onMsg(d, f, t)); }\n  send(d, o = {}) { for (const t of this.transports) t.send(d, o); }\n  avatar(id, look, name) { let v = this.avatars.get(id); if (v) return v; const a = new Actor(lookDef(look, 'g' + id.slice(0, 4))); a.addTo(this.group); a.play('Idle'); v = { a, name, x: 0, z: 0, f: 0, place: 'town', hist: [], bubble: null, bubbleT: 0 }; this.avatars.set(id, v); return v; }\n  dropAvatar(id) { const v = this.avatars.get(id); if (v) { v.a.removeFrom(); this.avatars.delete(id); } }\n  meNow() { const w = G.world; return { t: 'me', x: +w.p.x.toFixed(2), z: +w.p.z.toFixed(2), f: +w.p.facing.toFixed(2), place: w.p.place, a: G.player.speed > 0 ? 1 : 0 }; }\n  update(dt) {\n    const now = performance.now() - 120; const place = G.world.p.place;\n    for (const v of this.avatars.values()) { const hs = v.hist; let x = v.x, z = v.z, f = v.f, a = v.mv; if (hs.length >= 2) { let A = hs[0], B = hs[hs.length - 1]; for (let i = 0; i < hs.length - 1; i++) if (hs[i].t <= now && hs[i + 1].t >= now) { A = hs[i]; B = hs[i + 1]; break; } const k = Math.max(0, Math.min(1, (now - A.t) / Math.max(1, B.t - A.t))); x = A.x + (B.x - A.x) * k; z = A.z + (B.z - A.z) * k; f = B.f; a = B.a; v.x = x; v.z = z; } v.a.visible = v.place === place; if (v.place === place && G.place) { v.a.place(x, G.place.heightAt(x, z), z); v.a.targetFacing = f; if (v.a.onceT <= 0) v.a.play(a ? 'Jog' : 'Idle'); v.a.update(dt); } v.bubbleT = Math.max(0, v.bubbleT - dt); }\n  }\n  drawBubbles(h) { for (const v of this.avatars.values()) { if (!v.a.visible) continue; const pos = v.a.root.position; const [x, y] = G.view.project(pos.x, pos.y + 1.7, pos.z); const nw = textWidth(v.name) + 6; h.rect(x - nw / 2, y - 10, nw, 11, 'ink'); drawText(h, x, y - 8, v.name, { color: 'sand', align: 'center' }); if (v.bubbleT > 0 && v.bubble) { const w = textWidth(v.bubble) + 10; panel(h, x - w / 2, y - 28, w, 15); drawText(h, x, y - 24, v.bubble, { color: 'ink', align: 'center' }); } } }\n  emote(e) { this.send({ t: 'ev', from: this.id, emote: e }); }\n  phrase(i) { this.send({ t: 'ev', from: this.id, phrase: i }); const w = G.world; Toasts.add(`You say: ${CANNED[i]}`); }\n  applyGesture(d) { const v = this.avatars.get(d.from); if (!v) return; if (d.emote) v.a.play(EMOTE_CLIP[d.emote], { then: 'Idle', restart: true }); if (d.phrase != null) { v.bubble = CANNED[d.phrase]; v.bubbleT = 3; } }\n}\nexport class HostSession extends Session {\n  constructor() { super('host'); this.bc = null; this.announceT = 0; }\n  openBroadcast() { this.announcer = new BroadcastChannel(Announce); this.announcer.onmessage = (e) => { if (e.data?.t === 'who') this.announce(); }; const t = new BroadcastTransport('sillyfolk-gate-' + this.id, this.id); this.addTransport(t); this.bc = t; this.announce(); }\n  announce() { this.announcer?.postMessage({ t: 'gate', id: this.id, name: G.world.name, town: G.world.town }); }\n  async openRtc(iceServers) { this.rtc = this.rtc ?? new RtcTransport(this.id, iceServers); if (!this.transports.includes(this.rtc)) this.addTransport(this.rtc); this.rtc.onopen = (peer) => {}; this.pendingPeer = 'peer' + (this.rtc.peers.size + 1); return this.rtc.makeGatePass(this.pendingPeer); }\n  async acceptReply(code) { await this.rtc.acceptReply(code, this.pendingPeer); }\n  onMsg(d, from, t) {\n    if (d.t === 'hello') { if (this.guests.size >= 3) { t.send({ t: 'full' }, { to: from }); return; } this.guests.set(from, { name: d.name, t }); this.avatar(from, d.look, d.name); this.sendTown(from, t); Toasts.add(`${d.name} got off the bus.`, 4); G.world.stats.visitors = (G.world.stats.visitors ?? 0) + 1; bus.emit('visitorJoined', d.name); }\n    else if (d.t === 'me') { const v = this.avatars.get(from); if (v) { v.place = d.place; v.hist.push({ t: performance.now(), x: d.x, z: d.z, f: d.f, a: d.a }); if (v.hist.length > 6) v.hist.shift(); v.x = d.x; v.z = d.z; v.f = d.f; v.mv = d.a; } }\n    else if (d.t === 'do') this.doAction(d, from, t);\n    else if (d.t === 'ev') { this.applyGesture(d); this.send(d); }\n    else if (d.t === 'bye') { this.guests.delete(from); this.dropAvatar(from); Toasts.add('Your visitor went home. The bus never came. They just left.'); this.send({ t: 'gone', id: from }); }\n  }\n  sendTown(to, t) { const w = G.world; const { mail, mailQueue, memory, ...rest } = JSON.parse(serialize(w)); rest.p.pockets = []; rest.p.beans = 0; const text = JSON.stringify(rest); const CH = 12000; const n = Math.ceil(text.length / CH); let i = 0; this.chunkQ = this.chunkQ ?? []; for (; i < n; i++) this.chunkQ.push({ to, t, msg: { t: 'town', i, n, s: text.slice(i * CH, (i + 1) * CH), host: w.name, hostLook: w.p.look, hostId: this.id } }); }\n  doAction(d, from, t) { const w = G.world; const e = d.id ? w.ents[d.id] : null; if (d.a === 'pick' && e && (e.t === 'item' || e.t === 'shell')) { removeEnt(w, e); t.send({ t: 'ev', got: e.it, value: e.value }, { to: from }); } if (d.a === 'shake' && e?.t === 'tree' && e.fruit > 0) { const n = e.fruit; e.fruit = 0; e.regrow = T.fruitRegrow; w.dirty = true; for (let i = 0; i < n; i++) t.send({ t: 'ev', got: 'pear' }, { to: from }); } if (d.a === 'drop' && d.it) { const tx = Math.floor(d.x), tz = Math.floor(d.z); addEnt(w, { t: 'item', it: d.it, x: tx + 0.5, z: tz + 0.5, from: 'guest' }); } }\n  fixed(dt) {\n    this.announceT -= dt; if (this.announceT <= 0) { this.announceT = 2; this.announce(); }\n    if (this.chunkQ?.length) { this.chunkT = (this.chunkT ?? 0) - dt; if (this.chunkT <= 0) { this.chunkT = 0.08; const c = this.chunkQ.shift(); c.t.send(c.msg, { to: c.to }); } }\n    this.snapT -= dt; if (this.snapT <= 0 && this.guests.size) { this.snapT = 0.1; const w = G.world; const others = [...this.avatars.entries()].map(([id, v]) => [id, +v.x.toFixed(2), +v.z.toFixed(2), +v.f.toFixed(2), v.mv ? 1 : 0, v.place]); const npcs = NEIGHBOURS.filter((n) => w.npcs[n].place === 'town').map((n) => { const r = NPC.rt[n]; return [n, +r.x.toFixed(1), +r.z.toFixed(1)]; }); this.send({ t: 'snap', min: Math.floor(w.clock.minute), day: w.clock.day, h: [this.id, +w.p.x.toFixed(2), +w.p.z.toFixed(2), +w.p.facing.toFixed(2), G.player.speed > 0 ? 1 : 0, w.p.place], o: others, n: npcs }, { reliable: false }); }\n    this.entT -= dt; if (this.entT <= 0 && this.guests.size) { this.entT = 1; const w = G.world; const removed = [], added = []; const now = new Map(Object.entries(w.ents).map(([id, e]) => [id, `${e.t}:${e.fruit ?? ''}:${e.age ?? ''}`])); if (this.lastEnts.size) { for (const id of this.lastEnts.keys()) if (!now.has(id)) removed.push(id); for (const [id, sig] of now) if (this.lastEnts.get(id) !== sig) added.push(w.ents[id]); } this.lastEnts = now; if (removed.length || added.length) this.send({ t: 'ents', removed, added: added.slice(0, 30) }); }\n  }\n  close() { this.send({ t: 'hostgone' }); for (const t of this.transports) t.close(); this.announcer?.close(); this.transports = []; for (const id of [...this.avatars.keys()]) this.dropAvatar(id); }\n}\nexport class GuestSession extends Session {\n  constructor() { super('guest'); this.chunks = []; }\n  joinBroadcast(hostId) { const t = new BroadcastTransport('sillyfolk-gate-' + hostId, this.id); this.addTransport(t); this.hostId = hostId; this.hello(); }\n  async joinRtc(code, iceServers) { const t = new RtcTransport(this.id, iceServers); this.addTransport(t); const reply = await t.acceptGatePass(code, 'host'); t.onopen = () => this.hello(); return reply; }\n  hello() { const own = loadVisitor(); this.own = own; this.send({ t: 'hello', name: own.name, look: own.look }); }\n  onMsg(d, from) {\n    if (d.t === 'town') { this.chunks[d.i] = d.s; if (this.chunks.filter(Boolean).length === d.n) this.arrive(JSON.parse(this.chunks.join('')), d); }\n    else if (d.t === 'full') { Toasts.add('That gate is full. Three visitors is a crowd. The goose counted.'); G.visit = null; }\n    else if (d.t === 'snap') { const w = G.world; if (!w.guest) return; w.clock.minute = d.min; if (d.day !== w.clock.day) w.clock.day = d.day; const list = [d.h, ...d.o]; for (const [id, x, z, f, a, place] of list) { if (id === this.id) continue; const v = this.avatars.get(id) ?? this.avatar(id, id === this.hostKey ? this.hostLook : { hair: 2, hairColor: 'ink', eyes: 1, shirt: 's_red' }, id === this.hostKey ? this.hostName : 'A visitor'); v.place = place; v.hist.push({ t: performance.now(), x, z, f, a }); if (v.hist.length > 6) v.hist.shift(); v.x = x; v.z = z; v.f = f; v.mv = a; } for (const [n, x, z] of d.n) { const r = NPC.rt[n]; if (r) { r.x = x; r.z = z; if (w.npcs[n]) w.npcs[n].place = 'town'; r.path = null; } } }\n    else if (d.t === 'ents') { const w = G.world; if (!w.guest) return; for (const id of d.removed) { const e = w.ents[id]; if (e) removeEnt(w, e); } for (const e of d.added) { if (w.ents[e.id]) { Object.assign(w.ents[e.id], e); w.dirty = true; } else { w.ents[e.id] = e; rebuildGrid(w); w.dirty = true; } } }\n    else if (d.t === 'ev') { if (d.got) { if (giveItem(G.world, d.value ? { id: d.got, value: d.value } : { id: d.got })) { G.ctx.audio.play('pickup'); Toasts.add(`Got ${ITEMS[d.got]?.name}.`); this.save(); } } else this.applyGesture(d); }\n    else if (d.t === 'hostgone') { Toasts.add('Your host went to bed. You are sent home with what you carry.'); this.leave(); }\n    else if (d.t === 'gone') this.dropAvatar(d.id);\n  }\n  arrive(snap, m) { const own = this.own; const w = snap; rebuildGrid(w); w.guest = true; w.name = own.name; w.p.pockets = own.pockets.slice(); while (w.p.pockets.length < 15) w.p.pockets.push(null); w.p.beans = own.beans; w.p.look = own.look; w.p.tools = ['net', 'rod', 'can']; w.p.tool = null; w.p.place = 'town'; w.day1 = { done: true }; this.hostKey = m.hostId; this.hostLook = m.hostLook; this.hostName = m.host; G.mode = 'play'; UI.clear(); Trans.go(() => { G.game.useWorld(w); G.view.zoomTarget = T.zoom; G.player.actor.visible = true; G.player.rebuild(); setPlace('town', LANDMARK.busStop[0], LANDMARK.busStop[1] + 1, 0); Toasts.add(`You arrive in ${w.town} by bus. Mind the goose.`, 4); bus.emit('visitArrived'); }, 'fade', 2.4); }\n  fixed(dt) { this.meT -= dt; if (this.meT <= 0 && G.world?.guest) { this.meT = 0.1; this.send(this.meNow(), { reliable: false }); } }\n  save() { const w = G.world; if (!w.guest) return; storage.setJSON(VISITOR_KEY, { name: w.name, look: w.p.look, pockets: w.p.pockets.filter(Boolean), beans: w.p.beans }); }\n  leave() { this.save(); this.send({ t: 'bye' }); const own = storage.getJSON(VISITOR_KEY); const s = loadSave(); if (s && own) { s.p.pockets = [...own.pockets]; while (s.p.pockets.length < 15) s.p.pockets.push(null); s.p.beans = own.beans; saveNow(s, Date.now()); } for (const t of this.transports) t.close(); for (const id of [...this.avatars.keys()]) this.dropAvatar(id); G.visit = null; G.game.toTitle(); bus.emit('visitLeft'); }\n}\nfunction loadVisitor() { const v = storage.getJSON(VISITOR_KEY); const s = loadSave(); if (s) return { name: s.name, look: s.p.look, pockets: s.p.pockets.filter(Boolean), beans: s.p.beans }; if (v) return v; const o = { name: 'Visitor', look: { hair: 1, hairColor: 'plum', eyes: 4, shirt: 's_sky' }, pockets: [], beans: 500 }; return o; }\n// ---- DOM paste box: pixel-styled, needs a keyboard, says so\nfunction pasteBox(title, text, onDone) { const d = document.createElement('div'); d.id = 'sf-paste'; d.style.cssText = 'position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:60vw;background:#f4f4f4;border:6px solid #ffcd75;padding:18px;font:18px monospace;color:#1a1c2c;z-index:9;cursor:auto'; const h = document.createElement('div'); h.textContent = title; const ta = document.createElement('textarea'); ta.style.cssText = 'width:100%;height:22vh;font:14px monospace;margin:10px 0'; ta.value = text ?? ''; const row = document.createElement('div'); const mk = (label, f) => { const b = document.createElement('button'); b.textContent = label; b.style.cssText = 'font:16px monospace;margin-right:10px;padding:8px 14px'; b.onclick = f; row.appendChild(b); return b; }; if (text) mk('Copy', () => { ta.select(); navigator.clipboard?.writeText(ta.value).catch(() => {}); }); mk('OK', () => { d.remove(); onDone?.(ta.value.trim()); }); mk('Cancel', () => { d.remove(); onDone?.(null); }); d.append(h, ta, row); document.body.appendChild(d); ta.focus(); if (text) ta.select(); return d; }\n// ---- Menus\nexport function openVisitMenu() {\n  const m = menu({ id: 'visit', title: 'Visit', w: 330, items: () => [{ label: 'Open my gate', disabled: !hasSave(), value: () => (hasSave() ? '' : 'needs a save'), action: () => openGate() }, { label: 'Visit a friend', action: () => { UI.push(friendMenu()); } }], }); UI.push(m);\n}\nfunction openGate() { UI.clear(); G.game.continueGame(); const s = new HostSession(); s.openBroadcast(); G.visit = wrap(s); setTimeoutFrames(() => { UI.push(gateMenu(s)); }); }\nconst setTimeoutFrames = (f) => Script.run((function* () { yield 1.2; f(); })(), { background: true });\nfunction gateMenu(s) { const m = menu({ id: 'gate', title: 'Your gate is open', sub: 'Friends in other windows of this browser can see it. For another computer, make a Gate Pass.', w: 360, items: [{ label: 'Make a Gate Pass (invite code)', action: async () => { const code = await s.openRtc(); pasteBox('Gate Pass. Send it to your friend. They will send back a Reply Slip. Yes, this is a friend code. Yes, it is 600 characters. (Needs a keyboard.)', code, () => { pasteBox('Paste their Reply Slip here:', '', async (r) => { if (r) { try { await s.acceptReply(r); Toasts.add('They are on the bus.'); } catch { Toasts.add('That is not a Reply Slip. It might be a poem.'); } } }); }); } }, { label: 'Carry on', action: () => UI.pop(m) }] }); return m; }\nfunction friendMenu() { const gates = new Map(); const ch = new BroadcastChannel(Announce); ch.onmessage = (e) => { if (e.data?.t === 'gate') gates.set(e.data.id, e.data); }; ch.postMessage({ t: 'who' }); const m = menu({ id: 'friends', title: 'Visit a friend', w: 360, onBack: () => { ch.close(); UI.pop(m); }, items: () => [...[...gates.values()].slice(0, 4).map((g) => ({ label: `${g.name}, of ${g.town}`, action: () => { ch.close(); const s = new GuestSession(); G.visit = wrap(s); s.joinBroadcast(g.id); Toasts.add('Waiting for the bus…'); } })), { label: 'I have a Gate Pass', action: () => pasteBox('Paste the Gate Pass your friend sent you. (Needs a keyboard.)', '', async (code) => { if (!code) return; ch.close(); const s = new GuestSession(); G.visit = wrap(s); try { const reply = await s.joinRtc(code); pasteBox('Your Reply Slip. Send it back to your friend:', reply, () => {}); } catch { Toasts.add('That is not a Gate Pass.'); G.visit = null; } }) }, { label: gates.size ? 'Looking for more gates…' : 'No open gates in this browser yet…', disabled: true }] }); return m; }\nfunction wrap(s) { return { session: s, hosting: () => s.role === 'host', emote: (e) => s.emote(e), fixed: (dt) => s.fixed(dt), update: (dt) => s.update(dt), bubbles: (h) => s.drawBubbles(h), leave: () => { if (s.role === 'guest') s.leave(); else { s.close(); G.visit = null; } }, phrase: (i) => s.phrase(i), guest: s.role === 'guest', CANNED }; }\nexport { CANNED, wrap, loadVisitor };\nE\ncat >> ../PROGRESS.md <<'E'\nDone: net/transport, net/round (hub), net/visit. Next: wire visit in game.js (G.visitMenu, guest guards), tests/run.mjs suites, fix.\nE\npython3 - <<'E'\np='src/game.js'; s=open(p).read()\ns=s.replace(\"import './art/textures.js';\\nconst touchOnly\",\"import './art/textures.js';\\nimport { openVisitMenu } from './net/visit.js';\\nconst touchOnly\")\ns=s.replace(\"G.rumble = (a, s) => this.rumble(a, s);\",\"G.rumble = (a, s) => this.rumble(a, s); G.visitMenu = () => { if (typeof BroadcastChannel === 'undefined') return Toasts.add('Visiting needs a real browser.'); openVisitMenu(); };\")\ns=s.replace(\"G.saveAndQuit = () => { saveNow(G.world, G.nowMs()); markPlaying(false); UI.clear(); this.toTitle(); };\",\"G.saveAndQuit = () => { if (G.visit) { const v = G.visit; if (v.guest) { UI.clear(); v.leave(); return; } v.leave(); } saveNow(G.world, G.nowMs()); markPlaying(false); UI.clear(); this.toTitle(); };\")\ns=s.replace(\"UI.draw(h); Toasts.draw(h); drawCursor(h, c);\",\"if (G.visit) G.visit.bubbles(h); UI.draw(h); Toasts.draw(h); drawCursor(h, c);\")\ns=s.replace(\"\"\"if (!G.demo && !w.guest) { saveNow(w, G.nowMs()); if (G.time - this.cleanAt > 30) markPlaying(true); }\"\"\",\"\"\"if (!G.demo && !w.guest) { saveNow(w, G.nowMs()); if (G.time - this.cleanAt > 30) markPlaying(true); }\"\"\")\ns=s.replace(\"if (c.pressed('emotes')) { UI.push(emoteWheel()); return; }\",\"if (c.pressed('emotes')) { if (G.visit) { const m = menu({ id: 'phrases', title: 'Say something', w: 280, items: [{ label: 'Emotes…', action: () => { UI.pop(m); UI.push(emoteWheel()); } }, ...G.visit.CANNED.map((t, i) => ({ label: t, action: () => { UI.pop(m); G.visit.phrase(i); } }))] }); UI.push(m); } else UI.push(emoteWheel()); return; }\")\ns=s.replace(\"tick(dt) {\\n    const w = G.world, c = w.clock; if (c.frozen || G.clockFrozen) return;\",\"tick(dt) {\\n    const w = G.world, c = w.clock; if (c.frozen || G.clockFrozen || w.guest) return;\")\ns=s.replace(\"  ready(ctx) { const self = this;\",\"  ready(ctx) { const self = this; bus.emit('engineReady');\")\nopen(p,'w').write(s)\np='src/systems/interact.js'; s=open(p).read()\ns=s.replace(\"export function shakeTree(e) { const w = G.world, p = G.player, v = G.view.ents.get(e.id);\",\"export function shakeTree(e) { const w = G.world, p = G.player, v = G.view.ents.get(e.id); if (w.guest) { G.visit.session.send({ t: 'do', a: 'shake', id: e.id }); p.actor.play('ShakeTree', { then: 'Idle' }); p.busy = 0.5; if (v) v.shake = 0.5; G.ctx.audio.play('shake'); return; }\")\ns=s.replace(\"function pickFlower(e) { const w = G.world; if (!collect\",\"function pickFlower(e) { const w = G.world; if (w.guest) return Toasts.add(\\\"It's not your flower. Your host would notice.\\\"); if (!collect\")\ns=s.replace(\"function pickEnt(e) { const w = G.world; const entry\",\"function pickEnt(e) { const w = G.world; if (w.guest) { G.visit.session.send({ t: 'do', a: 'pick', id: e.id }); pickAnim(); return; } const entry\")\ns=s.replace(\"function pullWeed(e) { const w = G.world; if (!giveItem\",\"function pullWeed(e) { const w = G.world; if (w.guest) return Toasts.add('It is not your weed. It is a very nice weed.'); if (!giveItem\")\ns=s.replace(\"function axe() {\\n  const w = G.world,\",\"function axe() {\\n  if (G.world.guest) return Toasts.add(\\\"You can't fell your host's trees. They've got a goose.\\\");\\n  const w = G.world,\")\ns=s.replace(\"function shovel() {\\n  const w = G.world,\",\"function shovel() {\\n  if (G.world.guest) return Toasts.add('No digging on visits. It is in the terms.');\\n  const w = G.world,\")\ns=s.replace(\"  if (b.id === 'home') { if (w.p.tier === 0)\",\"  if (w.guest && b.id === 'home') return Toasts.add(\\\"It's your host's home. Knock politely, by leaving.\\\");\\n  if (b.id === 'home') { if (w.p.tier === 0)\")\nopen(p,'w').write(s)\np='src/net/visit.js'; s=open(p).read()\nopen(p,'w').write(s)\nE\nnode tools/build.mjs 2>&1 | tail -3","description":"Write hub round, Visit mode and wire them in"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5742,"cache_read_input_tokens":549707,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5742},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f147b5a-afdb-41c5-bbfc-62264f8c7cee","uuid":"33c7a299-dc74-4228-a200-afcaebcf10ef","timestamp":"2026-11-06T01:18:24.108Z","request_id":"req_011Cgkni3QFTh1hQhaM8phkJ","wire_tool_inputs":{"toolu_01Eg8GU8K5Ns8yAJefNSrHso":{"command":"cat > src/net/transport.js <<'E'\n// One interface over the hub, BroadcastChannel and WebRTC: send(data, { to, reliable }), on('message'), players. The hub's budget holds everywhere.\nexport class Budget { constructor() { this.t = []; } ok(now) { while (this.t.length && now - this.t[0] > 1000) this.t.shift(); if (this.t.length >= 20 && this.burst(now)) return false; this.t.push(now); return true; } burst(now) { return this.t.length >= 40 || this.t.filter((x) => now - x < 1000).length >= 40; } }\nexport class Transport { constructor() { this.handlers = []; this.budget = new Budget(); } on(ev, f) { if (ev === 'message') this.handlers.push(f); } emit(data, from) { for (const h of this.handlers) h(data, from); } close() {} }\nexport class HubTransport extends Transport { constructor(hub) { super(); this.hub = hub; hub.on('message', (d, f) => this.emit(d, f)); } send(data, o = {}) { return this.hub.send(data, o); } }\n/** Two windows on one computer, same browser profile. Rooms are channels named per host. */\nexport class BroadcastTransport extends Transport {\n  constructor(channel, id) { super(); this.id = id; this.ch = new BroadcastChannel(channel); this.ch.onmessage = (e) => { const m = e.data; if (m.to != null && m.to !== this.id) return; if (m.from === this.id) return; this.emit(m.d, m.from); }; }\n  send(data, o = {}) { if (!this.budget.ok(Date.now())) return false; if (JSON.stringify(data).length > 16384) return false; this.ch.postMessage({ d: data, from: this.id, to: o.to }); return true; }\n  close() { this.ch.close(); }\n}\nconst zip = async (s) => { const cs = new CompressionStream('deflate-raw'); const w = cs.writable.getWriter(); w.write(new TextEncoder().encode(s)); w.close(); const b = new Uint8Array(await new Response(cs.readable).arrayBuffer()); return btoa(String.fromCharCode(...b)); };\nconst unzip = async (b64) => { const bin = Uint8Array.from(atob(b64.trim()), (c) => c.charCodeAt(0)); const ds = new DecompressionStream('deflate-raw'); const w = ds.writable.getWriter(); w.write(bin); w.close(); return new TextDecoder().decode(await new Response(ds.readable).arrayBuffer()); };\nconst waitIce = (pc) => new Promise((res) => { if (pc.iceGatheringState === 'complete') return res(); const t = setTimeout(res, 4000); pc.addEventListener('icegatheringstatechange', () => { if (pc.iceGatheringState === 'complete') { clearTimeout(t); res(); } }); });\n/** Serverless WebRTC: a Gate Pass (offer) goes to the friend, who returns a Reply Slip (answer). */\nexport class RtcTransport extends Transport {\n  constructor(id, iceServers) { super(); this.id = id; this.ice = iceServers ?? [{ urls: 'stun:stun.l.google.com:19302' }]; this.peers = new Map(); this.opening = null; }\n  wire(pc, ch, peerId) { ch.onmessage = (e) => { const m = JSON.parse(e.data); this.emit(m, peerId); }; ch.onopen = () => { this.onopen?.(peerId); }; ch.onclose = () => { this.peers.delete(peerId); this.onclose?.(peerId); }; this.peers.set(peerId, { pc, ch }); }\n  async makeGatePass(peerId) { const pc = new RTCPeerConnection({ iceServers: this.ice }); const ch = pc.createDataChannel('gate', { ordered: true }); this.wire(pc, ch, peerId); await pc.setLocalDescription(await pc.createOffer()); await waitIce(pc); return zip(JSON.stringify(pc.localDescription)); }\n  async acceptGatePass(code, hostId) { const pc = new RTCPeerConnection({ iceServers: this.ice }); pc.ondatachannel = (e) => this.wire(pc, e.channel, hostId); await pc.setRemoteDescription(JSON.parse(await unzip(code))); await pc.setLocalDescription(await pc.createAnswer()); await waitIce(pc); return zip(JSON.stringify(pc.localDescription)); }\n  async acceptReply(code, peerId) { await this.peers.get(peerId).pc.setRemoteDescription(JSON.parse(await unzip(code))); }\n  send(data, o = {}) { if (!this.budget.ok(Date.now())) return false; const s = JSON.stringify(data); if (s.length > 16384) return false; for (const [id, p] of this.peers) { if (o.to != null && o.to !== id) continue; if (p.ch.readyState === 'open') p.ch.send(s); } return true; }\n  close() { for (const p of this.peers.values()) p.pc.close(); this.peers.clear(); }\n}\nE\ncat > src/net/round.js <<'E'\n// AI Hub session: \"The Bean Bazaar\". Five minutes on a small green; the host's copy runs the world.\nimport { Engine, THREE, buildModel, toonMaterial, PALETTE, applySky, skyAt, WaterSurface, WAVES_CALM, loadPack, MODEL_LIBRARY, setLookLayer } from '../engine.js';\nimport { Place } from '../world/place.js';\nimport { TerrainView } from '../world/terrainMesh.js';\nimport { HubTransport } from './transport.js';\nimport { Actor } from '../actors/actor.js';\nimport { critterDef } from '../art/critter.js';\nimport { Controls } from '../ui/input.js';\nimport { UI, panel, promptRow, drawGlyph } from '../ui/kit.js';\nimport { drawText, textWidth } from '../ui/font.js';\nimport { G } from '../state.js';\nimport { CAST } from '../data/cast.js';\nimport { SONGS } from '../audio/composer.js';\nimport { SFX_DEFS } from '../audio/sfx.js';\nimport { itemDef } from '../art/models.js';\nimport { ITEMS } from '../data/items.js';\nimport '../art/textures.js';\nconst ROWS = (() => { const W = 32, H = 24; const g = Array.from({ length: H }, () => Array(W).fill('.')); const rect = (a, b, c, d, ch) => { for (let z = b; z <= d; z++) for (let x = a; x <= c; x++) g[z][x] = ch; }; rect(0, 0, 31, 0, '#'); rect(0, 23, 31, 23, '#'); rect(0, 0, 0, 23, '#'); rect(31, 0, 31, 23, '#'); rect(2, 16, 9, 21, 'o'); rect(24, 1, 26, 22, 'w'); rect(24, 11, 26, 13, 'b'); rect(12, 10, 19, 14, 'P'); return g.map((r) => r.join('')); })();\nconst STALL = [16, 11]; const SIZE = 5; const SEATS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700']; const ROUND_MS = 5 * 60000;\nconst ORDERS = [['dorrit', 'pear', 'Dorrit wants a pear'], ['tavi', 'bug', 'Tavi wants a butterfly'], ['bartleby', 'fish', 'Bartleby would prefer a fish'], ['yolanda', 'fossil', 'Yolanda wants a fossil, hon'], ['rocco', 'fish', 'Rocco needs fish. For protein']];\nconst VALUE = { pear: 100, flower: 80, bug: 200, fish: 300, goldfish: 3000, fossil: 600, goldpear: 800 };\nconst AWARDS = [['Most Fish Apologised To', (s) => s.fish], ['Tree Botherer of the Year', (s) => s.pears], ['Bug Whisperer', (s) => s.bugs], ['Bean Counter, Honorary', (s) => s.sold], ['Friend to Moles', (s) => s.fossils], ['Sash Bumper', (s) => s.bumps]];\nclass RoundGame {\n  name = 'Silly Folk: The Bean Bazaar'; target = new THREE.Vector3(16, 1, 12);\n  constructor(hub) { this.hub = hub; this.info = hub; }\n  async setup(ctx) {\n    this.ctx = ctx; G.ctx = ctx; const hub = this.hub; UI.ctrl = this.ctrl = new Controls(ctx); UI.clear(); await loadPack('packs/kenney-furniture.json', { into: MODEL_LIBRARY }).catch(() => {});\n    for (const [k, d] of Object.entries(SFX_DEFS)) ctx.audio.register(k, d);\n    if (!localStorageHasAudio()) ctx.audio.setVolume('music', 0.1);\n    applySky(ctx.engine, skyAt(11));\n    this.net = new HubTransport(hub); this.isHost = hub.isHost; this.me = hub.me; this.server = !!hub.server; this.place = new Place('fair', ROWS);\n    const g = (this.g = new THREE.Group()); ctx.scene.add(g); const t = new TerrainView(this.place, g); t.season = 1; t.buildAll();\n    const water = new WaterSurface({ size: [60, 50], at: [16, -0.35, 12], segments: [60, 50], waves: WAVES_CALM, deep: PALETTE.blue, shallow: PALETTE.sky, foam: PALETTE.white, foamAt: 0.6 }); g.add(water); this.water = water;\n    const under = new THREE.Mesh(new THREE.PlaneGeometry(90, 80).rotateX(-Math.PI / 2), toonMaterial(PALETTE.teal)); under.position.set(16, -0.1, 12); g.add(under);\n    const stall = buildModel('market-stall', { palette: { cloth: 'red' } }).object; stall.position.set(STALL[0], 0, STALL[1]); g.add(stall); this.place.rects.push({ x0: STALL[0] - 1.3, z0: STALL[1] - 0.8, x1: STALL[0] + 1.3, z1: STALL[1] + 0.8 });\n    const br = buildModel('sf-bridge', {}).object; br.position.set(25, 0, 12); br.rotation.y = 0; g.add(br);\n    // World: trees, cracks, flowers, bugs. Same on every copy from the hub's seed.\n    const rng = hub.rng('world'); const pick = (a, b) => a + rng() * (b - a);\n    this.trees = Array.from({ length: 8 }, (_, i) => ({ i, x: 4 + (i % 4) * 4.5 + pick(-0.4, 0.4), z: 3 + Math.floor(i / 4) * 4.5 + pick(-0.4, 0.4), fruit: 2, rich: false, cool: 0 }));\n    for (const tr of this.trees) { const m = buildModel('pear-tree', { palette: { leaf: 'green', leaf2: 'lime' } }).object; m.position.set(tr.x, 0, tr.z); g.add(m); tr.m = m; this.place.circles.push({ x: tr.x, z: tr.z, r: 0.45 }); const fmat = toonMaterial(PALETTE.lime); tr.fm = []; for (let k = 0; k < 3; k++) { const f = new THREE.Mesh(new THREE.SphereGeometry(0.17, 6, 5), fmat); f.position.set(Math.cos(k * 2.1), 1.8, Math.sin(k * 2.1) + 0.35); m.add(f); tr.fm.push(f); } }\n    this.cracks = Array.from({ length: 6 }, (_, i) => ({ i, x: Math.floor(pick(12, 22)) + 0.5, z: Math.floor(pick(16, 22)) + 0.5, alive: true })); this.crackM = this.cracks.map((c) => { const m = buildModel('sf-crack', {}).object; m.position.set(c.x, 0.01, c.z); g.add(m); return m; });\n    this.flowers = Array.from({ length: 6 }, (_, i) => ({ i, x: 28 + pick(0, 2.4), z: 2 + i * 3.4, alive: true })); this.flowerM = this.flowers.map((c, i) => { const m = buildModel('fl-tulip', { palette: { petal: ['red', 'sand', 'plum'][i % 3] } }).object; m.position.set(c.x, 0, c.z); g.add(m); return m; });\n    this.bugs = Array.from({ length: 5 }, (_, i) => ({ i, ax: pick(13, 22), az: pick(3, 9), x: 0, z: 0, alive: true })); this.bugM = this.bugs.map((b) => { const m = buildModel(itemDef(ITEMS.cabbagefly), {}).object; g.add(m); return m; });\n    this.fishSpot = { x: 5.5, z: 18.5, gold: false }; this.shadow = new THREE.Mesh(new THREE.SphereGeometry(0.6, 6, 4), toonMaterial(PALETTE.night)); this.shadow.scale.set(1, 0.05, 1.5); this.shadow.position.set(5.5, -0.27, 18.5); g.add(this.shadow);\n    this.mayor = new Actor(critterDef({ id: 'round-mayor', ...CAST.trundle.look }), { seed: 2 }); this.mayor.addTo(g); this.mayor.play('MayorSlide'); this.mayorX = 11;\n    this.orderers = {}; this.state = { players: {}, order: null, orderT: 12, bell: null, ended: false, time: 0 }; this.avatars = new Map(); this.seat = {};\n    (hub.players ?? []).forEach((p, i) => this.addPlayer(p.id, p.name, p.color ?? SEATS[i % 4], i));\n    this.net.on('message', (d, f) => this.onMsg(d, f));\n    hub.on('leave', ({ id }) => this.removePlayer(id)); hub.on('time-up', () => { if (this.isHost) this.finish(); }); hub.on('end', () => this.onEnd()); hub.on('card', (c) => { this.card = c; }); hub.on('start', () => { this.started = true; this.startAt = true; ctx.audio.playMusic(SONGS.round, 'round'); });\n    ctx.audio.playMusic(SONGS.card, 'card'); this.touchSpectator = navigator.maxTouchPoints > 0 && !matchMedia('(any-pointer: fine)').matches && !navigator.getGamepads?.()[0];\n    this.key = (e) => { if (this.ended) return; if (this.started) return; if (e.key === 'Enter') hub.answer('ready'); if (e.key === 't' || e.key === 'T') hub.answer('more'); }; window.addEventListener('keydown', this.key);\n    this.tap = (e) => { if (this.started || this.ended) return; const y = e.clientY / innerHeight; if (y > 0.8) hub.answer(e.clientX / innerWidth < 0.5 ? 'ready' : 'more'); }; window.addEventListener('pointerdown', this.tap);\n  }\n  ready() { this.hub.ready(); window.__ROUND__ = this; }\n  addPlayer(id, name, color, i) { if (this.state.players[id]) return; const sp = [14 + (i % 2) * 4, 15 + Math.floor(i / 2) * 1.5]; this.state.players[id] = { id, x: sp[0], z: sp[1], f: 0, a: 0, pockets: [], banked: 0, stats: { fish: 0, pears: 0, bugs: 0, sold: 0, fossils: 0, bumps: 0 }, fishing: null, bumpT: 0 }; const a = new Actor(critterDef({ id: 'round-p' + id, species: 'person', c1: 'sand', c2: 'white', shirt: 'white', trousers: 'navy', shoes: 'ink', hair: id % 8, hairColor: ['orange', 'ink', 'plum', 'sand'][id % 4], eyes: id % 6 }), { seed: id * 3 }); a.addTo(this.g); const col = toonMaterial(new THREE.Color(color).getHex()); const wh = new THREE.Color(PALETTE.white).getHex(); a.obj.traverse((m) => { if (m.isMesh && m.material?.color?.getHex?.() === wh && ['Torso', 'ArmR', 'ArmL'].includes(m.parent?.name)) m.material = col; }); this.avatars.set(id, { a, name, color, x: sp[0], z: sp[1], tx: sp[0], tz: sp[1], f: 0, hist: [] }); a.place(sp[0], 0, sp[1]); this.seat[id] = i; }\n  removePlayer(id) { const v = this.avatars.get(id); if (v) { v.a.removeFrom(); this.avatars.delete(id); } delete this.state.players[id]; }\n  onMsg(d, from) {\n    if (d.t === 'me' && this.isHost) { const p = this.state.players[from]; if (p) { p.x = d.x; p.z = d.z; p.f = d.f; p.a = d.a; } }\n    else if (d.t === 'do' && this.isHost) this.act(from);\n    else if (d.t === 'snap' && !this.isHost) { this.state.time = d.time; this.mayorX = d.mx; this.fishSpot = { x: d.fx, z: d.fz, gold: d.gold }; d.p.forEach(([id, x, z, f, a, banked, carried]) => { const v = this.avatars.get(id); if (!v) return; v.hist.push({ t: performance.now(), x, z, f, a }); if (v.hist.length > 6) v.hist.shift(); const st = this.state.players[id]; if (st) { st.banked = banked; st.carried = carried; if (id !== this.me) { st.x = x; st.z = z; } } }); }\n    else if (d.t === 'ev' && !this.isHost) this.applyEv(d);\n  }\n  applyEv(d) { if (d.tree) { const tr = this.trees[d.tree[0]]; tr.fruit = d.tree[1]; tr.rich = d.tree[2]; } if (d.crack != null) this.cracks[d.crack].alive = false; if (d.flower != null) this.flowers[d.flower].alive = false; if (d.bug) { this.bugs[d.bug[0]].alive = d.bug[1]; } if (d.order !== undefined) this.state.order = d.order; if (d.bell) this.announce(d.bell); if (d.say && d.say[0] === this.me) { this.toast = d.say[1]; this.toastT = 2.4; this.ctx.audio.play(d.say[2] ?? 'pickup'); } if (d.pockets && d.pockets[0] === this.me) { const st = this.state.players[this.me]; if (st) st.pockets = d.pockets[1]; } if (d.fishing && d.fishing[0] === this.me) { this.fishingLocal = d.fishing[1]; } }\n  announce(text) { this.bellText = text; this.bellT = 4; this.ctx.audio.play('reveal'); }\n  send(ev) { this.net.send({ t: 'ev', ...ev }); this.applyLocal(ev); }\n  applyLocal(ev) { if (ev.say && ev.say[0] === this.me) { this.toast = ev.say[1]; this.toastT = 2.4; this.ctx.audio.play(ev.say[2] ?? 'pickup'); } if (ev.bell) this.announce(ev.bell); if (ev.fishing && ev.fishing[0] === this.me) this.fishingLocal = ev.fishing[1]; }\n  /** Host: the one verb. Contextual on what's nearest. */\n  act(id) {\n    const p = this.state.players[id]; if (!p || this.state.ended || this.hub.time() < 0) return; const near = (x, z, r) => (p.x - x) ** 2 + (p.z - z) ** 2 < r * r; const say = (s, snd) => ({ say: [id, s, snd] });\n    if (p.fishing) { if (p.fishing.stage === 'bite') { const it = this.fishSpot.gold ? 'goldfish' : 'fish'; p.fishing = null; if (this.addPocket(p, it, id)) { p.stats.fish++; this.send({ ...say(it === 'goldfish' ? 'The golden fish!' : 'You caught a fish. Sorry, fish.', 'splash'), fishing: [id, null] }); if (it === 'goldfish') { this.fishSpot.gold = false; } } } else { p.fishing = null; this.send({ ...say('Too soon. It has told the others.', 'flee'), fishing: [id, null] }); } return; }\n    if (near(STALL[0], STALL[1] + 1, 2.4) && p.pockets.length) { let sum = 0; const o = this.state.order; for (const it of p.pockets) { let v = VALUE[it]; if (o && (o.want === it || (o.want === 'fish' && it === 'goldfish'))) { v *= 2; this.state.order = null; this.state.orderT = 15; this.send({ order: null }); } sum += v; } p.banked += sum; p.stats.sold += sum; p.pockets = []; this.net.send({ t: 'ev', pockets: [id, []] }); this.send(say(`Sold! +${sum} beans`, 'reveal')); return; }\n    if (p.pockets.length >= SIZE) { this.send(say('Your pockets are full. Sell at the stall!', 'uiNo')); return; }\n    const mayorHit = near(this.mayorX, 8.4, 1.4); if (mayorHit && p.bumpT <= 0) { p.bumpT = 30; p.banked += 150; p.stats.bumps++; this.send(say('The Mayor tips his sash. +150 beans', 'plume')); return; }\n    for (const b of this.bugs) if (b.alive && near(b.x, b.z, 1.8)) { b.alive = false; b.back = 20; p.stats.bugs++; this.addPocket(p, 'bug', id); this.send({ bug: [b.i, false], ...say('Swing! Got a butterfly.', 'netHit') }); return; }\n    for (const tr of this.trees) if (near(tr.x, tr.z, 1.5)) { if (tr.fruit > 0) { tr.fruit--; tr.cool = 18; p.stats.pears++; this.addPocket(p, tr.rich ? 'goldpear' : 'pear', id); if (tr.fruit === 0) tr.rich = false; this.send({ tree: [tr.i, tr.fruit, tr.rich], ...say('Shake! A pear falls on you.', 'shake') }); } else this.send(say('Nothing left. It looks at you.', 'shake')); return; }\n    for (const c of this.cracks) if (c.alive && near(c.x, c.z, 1.3)) { c.alive = false; p.stats.fossils++; this.addPocket(p, 'fossil', id); this.send({ crack: c.i, ...say('Dig! A fossil, or a very confident potato.', 'dig') }); return; }\n    for (const f of this.flowers) if (f.alive && near(f.x, f.z, 1.2)) { f.alive = false; this.addPocket(p, 'flower', id); this.send({ flower: f.i, ...say('Picked. It will die, but pretty.', 'pickup') }); return; }\n    const facing = [p.x + Math.sin(p.f) * 2, p.z + Math.cos(p.f) * 2]; if (this.place.isWater(facing[0], facing[1]) || this.place.isWater(p.x, p.z + 1.6) || this.place.isWater(p.x + 1.6, p.z)) { p.fishing = { stage: 'wait', t: 1 + Math.random() * 2 }; this.send({ ...say('Cast…', 'cast'), fishing: [id, 'wait'] }); return; }\n    this.send(say('Nothing here. Try a tree, a crack, the water or the stall.', 'uiNo'));\n  }\n  addPocket(p, it, id) { if (p.pockets.length >= SIZE) { this.send({ say: [id, 'Your pockets are full!', 'uiNo'] }); return false; } p.pockets.push(it); this.net.send({ t: 'ev', pockets: [id, p.pockets.slice()] }); return true; }\n  hostFixed(dt) {\n    const s = this.state, t = this.hub.time(); if (t < 0 || s.ended) return; s.time = t;\n    for (const p of Object.values(s.players)) { p.bumpT = Math.max(0, p.bumpT - dt); if (p.fishing) { p.fishing.t -= dt; if (p.fishing.stage === 'wait' && p.fishing.t <= 0) { p.fishing = { stage: 'bite', t: 0.9 }; this.send({ say: [p.id, 'Bite! Press now!', 'bite'], fishing: [p.id, 'bite'] }); } else if (p.fishing.stage === 'bite' && p.fishing.t <= 0) { p.fishing = null; this.send({ say: [p.id, 'It got away.', 'flee'], fishing: [p.id, null] }); } } }\n    for (const tr of this.trees) if (tr.fruit < 2) { tr.cool -= dt; if (tr.cool <= 0) { tr.fruit++; tr.cool = 18; this.send({ tree: [tr.i, tr.fruit, tr.rich] }); } }\n    for (const b of this.bugs) if (!b.alive) { b.back -= dt; if (b.back <= 0) { b.alive = true; this.send({ bug: [b.i, true] }); } }\n    s.orderT -= dt; if (!s.order && s.orderT <= 0) { const rng = this.hub.rng('order' + Math.floor(t / 1000)); const o = ORDERS[Math.floor(rng() * ORDERS.length)]; s.order = { who: o[0], want: o[1], text: `${o[2]}: double beans!` }; s.orderT = 25; this.send({ order: s.order }); }\n    if (s.order && s.orderT <= 0) { s.order = null; s.orderT = 10; this.send({ order: null }); }\n    const moments = [[60000, 'gold'], [150000, 'rich'], [240000, 'gold']]; s.bellI = s.bellI ?? 0; if (s.bellI < moments.length && t >= moments[s.bellI][0]) { const m = moments[s.bellI][1]; s.bellI++; if (m === 'gold') { this.fishSpot.gold = true; this.send({ bell: 'The bell rings! A golden fish in the pond!' }); } else { const tr = this.trees[Math.floor(this.hub.rng('rich')() * this.trees.length)]; tr.rich = true; tr.fruit = 2; this.send({ tree: [tr.i, 2, true], bell: 'The bell rings! A rich tree in the orchard!' }); } }\n    this.mayorX = 11 + (t / ROUND_MS) * 10; const bellAt = Math.min(ROUND_MS, (this.hub.limitMs ?? ROUND_MS) - 5000); if (t >= bellAt) this.finish();\n    this.fishSpot.x = 5.5 + Math.sin(t / 2000) * 2; this.fishSpot.z = 18.5 + Math.cos(t / 3000) * 1.6;\n    this.snapT = (this.snapT ?? 0) - dt; if (this.snapT <= 0) { this.snapT = 0.1; this.net.send({ t: 'snap', time: Math.round(t), mx: +this.mayorX.toFixed(2), fx: +this.fishSpot.x.toFixed(1), fz: +this.fishSpot.z.toFixed(1), gold: this.fishSpot.gold, p: Object.values(s.players).map((p) => [p.id, +p.x.toFixed(2), +p.z.toFixed(2), +p.f.toFixed(2), p.a, p.banked, p.pockets.length]) }, { reliable: false }); }\n  }\n  finish() { const s = this.state; if (s.ended || !this.isHost) return; s.ended = true; const players = Object.values(s.players).filter((p) => this.hub.players.some((q) => q.id === p.id)); const scoreOf = (p) => p.banked + Math.floor(p.pockets.reduce((a, it) => a + VALUE[it], 0) / 2); const scores = {}; const stats = {}; for (const p of players) { scores[p.id] = scoreOf(p); stats[p.id] = { Sold: p.stats.sold, Fish: p.stats.fish, Pears: p.stats.pears }; } const groups = new Map(); for (const p of players) { const k = scores[p.id]; if (!groups.has(k)) groups.set(k, []); groups.get(k).push(p.id); } const standings = [...groups.keys()].sort((a, b) => b - a).map((k) => groups.get(k)); const awards = []; for (const [title, f] of AWARDS) { let best = null, bv = 0; for (const p of players) { const v = f(p.stats); if (v > bv) { bv = v; best = p; } } if (best && awards.length < 3 && !awards.some((a) => a.id === best.id)) awards.push({ id: best.id, title, detail: `${bv}` }); } this.hub.finish({ standings, scores, stats, awards }); }\n  onEnd() { this.ended = true; this.state.ended = true; this.ctx.audio.stopMusic(); this.ctx.audio.stopLoops(); window.removeEventListener('keydown', this.key); window.removeEventListener('pointerdown', this.tap); }\n  fixedUpdate(ctx, dt) {\n    if (this.isHost) this.hostFixed(dt);\n    if (this.server || this.ended || this.touchSpectator) return; const t = this.hub.time(); const me = this.state.players[this.me]; if (!me || t < 0) return;\n    const ax = ctx.input.moveAxis(); const m = Math.min(1, Math.hypot(ax.x, ax.y)); this.moving = false; if (m > 0.1) { const b = ctx.engine.camera.groundBasis(); const fx = b.right.x * ax.x + b.forward.x * ax.y, fz = b.right.z * ax.x + b.forward.z * ax.y, l = Math.hypot(fx, fz) || 1; const sp = (ctx.input.isDown('ShiftLeft', 'PadCircle') ? 6 : 4.2) * dt; const [nx, nz] = this.place.move(me.x, me.z, (fx / l) * sp, (fz / l) * sp, 0.3); me.x = nx; me.z = nz; me.f = Math.atan2(fx, fz); this.moving = true; }\n    me.a = this.moving ? 1 : 0;\n    if (!this.isHost) { this.meT = (this.meT ?? 0) - dt; if (this.meT <= 0) { this.meT = 0.1; this.net.send({ t: 'me', x: +me.x.toFixed(2), z: +me.z.toFixed(2), f: +me.f.toFixed(2), a: me.a }, { reliable: false }); } }\n  }\n  update(ctx, dt) {\n    const c = this.ctrl, t = this.hub.time(); c.begin(dt); const h = ctx.hud; this.water.update(ctx.time);\n    if (!this.started && !this.ended) { if (c.input.wasPressed('PadCross')) this.hub.answer('ready'); if (c.input.wasPressed('PadTriangle')) this.hub.answer('more'); }\n    const pressed = !c.input.isDown('PadCreate') && (c.input.wasPressed('PadCross') || c.input.wasPressed('KeyE') || c.input.wasPressed('Enter') || c.input.wasPressed('Space'));\n    if (this.started && t >= 0 && pressed && !this.server && !this.ended && !this.touchSpectator) { if (this.isHost) this.act(this.me); else this.net.send({ t: 'do' }); const me = this.avatars.get(this.me); me?.a.play('PickUp', { then: 'Idle', restart: true }); }\n    const now = performance.now() - 120;\n    for (const [id, v] of this.avatars) { const st = this.state.players[id]; if (!st) continue; let x = st.x, z = st.z, f = st.f, a = st.a; if (!this.isHost && id !== this.me) { const hs = v.hist; if (hs.length >= 2) { let A = hs[0], B = hs[hs.length - 1]; for (let i = 0; i < hs.length - 1; i++) if (hs[i].t <= now && hs[i + 1].t >= now) { A = hs[i]; B = hs[i + 1]; break; } const k = Math.max(0, Math.min(1, (now - A.t) / Math.max(1, B.t - A.t))); x = A.x + (B.x - A.x) * k; z = A.z + (B.z - A.z) * k; f = B.f; a = B.a; } else if (hs.length) { x = hs[0].x; z = hs[0].z; f = hs[0].f; a = hs[0].a; } } else if (id === this.me && !this.isHost) { const last = v.hist[v.hist.length - 1]; if (last && Math.hypot(last.x - st.x, last.z - st.z) > 3) { st.x = last.x; st.z = last.z; x = st.x; z = st.z; } }\n      if (this.isHost && id !== this.me) { v.x += (x - v.x) * Math.min(1, dt * 12); v.z += (z - v.z) * Math.min(1, dt * 12); x = v.x; z = v.z; } v.a.place(x, this.place.heightAt(x, z), z); v.a.targetFacing = f; if (v.a.onceT <= 0 || a) v.a.play(a ? 'Jog' : 'Idle'); v.a.update(dt); }\n    for (let i = 0; i < this.trees.length; i++) { const tr = this.trees[i]; tr.fm.forEach((m, k) => { m.visible = k < tr.fruit; }); } this.cracks.forEach((c0, i) => { this.crackM[i].visible = c0.alive; }); this.flowers.forEach((f, i) => { this.flowerM[i].visible = f.alive; }); this.bugs.forEach((b, i) => { const ph = ctx.time * 0.7 + i; b.x = b.ax + Math.sin(ph) * 2; b.z = b.az + Math.cos(ph * 1.3) * 2; this.bugM[i].position.set(b.x, 0.8 + Math.sin(ctx.time * 3 + i) * 0.2, b.z); this.bugM[i].visible = b.alive; });\n    this.shadow.position.set(this.fishSpot.x, -0.27, this.fishSpot.z); this.shadow.material = toonMaterial(this.fishSpot.gold ? PALETTE.sand : PALETTE.night); this.mayor.place(this.mayorX, 0, 8.4); this.mayor.targetFacing = Math.PI / 2; this.mayor.update(dt);\n    const meA = this.avatars.get(this.me); const tgt = this.target; if (this.server || !meA) { const a = ctx.time * 0.1; tgt.set(16 + Math.cos(a) * 6, 1, 12 + Math.sin(a) * 4); if (!this.camSet) { this.camSet = true; ctx.engine.setCamera({ preset: 'iso', yaw: 45, pitch: 35, zoom: 0.8, minZoom: 0.8, maxZoom: 0.8 }, { syncUrl: false }); } } else tgt.set(meA.a.root.position.x, 1, meA.a.root.position.z);\n    this.toastT = Math.max(0, (this.toastT ?? 0) - dt); this.bellT = Math.max(0, (this.bellT ?? 0) - dt);\n    h.clear(); this.hudDraw(h, t);\n  }\n  hudDraw(h, t) {\n    const hub = this.hub, ctx = this.ctx; if (!this.started) return this.cardDraw(h); const s = this.state;\n    for (const [id, v] of this.avatars) { const pos = v.a.root.position; const P = pos.clone().setY(pos.y + 1.7).project(ctx.engine.camera.camera); const x = Math.round((P.x + 1) * 240), y = Math.round((1 - P.y) * 135); const w = textWidth(v.name) + 6; h.rect(x - w / 2, y - 9, w, 11, 'ink'); drawText(h, x, y - 7, v.name, { color: new THREE.Color(v.color).getHex(), align: 'center' }); }\n    let sx = 12; for (const [id, v] of this.avatars) { const st = s.players[id]; const b = st?.banked ?? 0; const label = `${v.name}: ${b}`; const w = textWidth(label) + 14; h.rect(sx, 12, w, 14, 'ink'); h.rect(sx, 12, 4, 14, new THREE.Color(v.color).getHex()); drawText(h, sx + 8, 15, label, { color: 'white' }); sx += w + 4; }\n    const left = Math.max(0, Math.ceil((Math.min(ROUND_MS, (hub.limitMs ?? ROUND_MS) - 5000) - Math.max(0, t)) / 1000)); const mm = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`; panel(h, 216, 30, 48, 15); drawText(h, 240, 34, mm, { color: 'navy', align: 'center' });\n    if (t < 0) { const n = Math.ceil(-t / 1000); drawText(h, 240, 100, String(n), { color: 'white', align: 'center', scale: 6, shadow: 'ink' }); }\n    if (s.order) { const w = textWidth(s.order.text) + 12; panel(h, 240 - w / 2, 48, w, 15); drawText(h, 240, 52, s.order.text, { color: 'red', align: 'center' }); }\n    if (this.bellT > 0) { const w = textWidth(this.bellText) + 12; panel(h, 240 - w / 2, 68, w, 15); drawText(h, 240, 72, this.bellText, { color: 'orange', align: 'center' }); }\n    if (this.toastT > 0 && this.toast) { const w = textWidth(this.toast) + 12; panel(h, 240 - w / 2, 214, w, 15); drawText(h, 240, 218, this.toast, { color: 'ink', align: 'center' }); }\n    const me = s.players[this.me]; if (me && !this.server) { const n = me.pockets?.length ?? 0; panel(h, 12, 240, 92, 18); for (let i = 0; i < SIZE; i++) { h.rect(18 + i * 16, 244, 13, 10, i < n ? 'orange' : 'mist'); } promptRow(h, 468, 245, [['confirm', 'Do the thing']], { align: 'right', back: 'ink' }); } if (this.touchSpectator) { panel(h, 110, 236, 260, 18); drawText(h, 240, 241, 'Controller or keyboard required', { color: 'red', align: 'center' }); }\n  }\n  cardDraw(h) { const c = this.card ?? {}; h.rect(0, 0, 480, 270, 'navy'); panel(h, 40, 16, 400, 234); drawText(h, 240, 26, 'The Bean Bazaar', { color: 'navy', align: 'center', scale: 3 }); drawText(h, 240, 56, 'Bank the most beans before the last bell.', { color: 'ink', align: 'center' }); drawText(h, 240, 70, 'Unbanked beans count half. Shake, dig, cast, swing, then sell at the stall.', { color: 'slate', align: 'center' }); let y = 90; for (const [id, v] of this.avatars) { h.rect(70, y, 340, 18, 'white'); h.rect(70, y, 8, 18, new THREE.Color(v.color).getHex()); drawText(h, 84, y + 5, v.name, { color: 'ink' }); drawText(h, 404, y + 5, c.ready?.includes(id) ? 'Ready!' : 'Getting ready', { color: c.ready?.includes(id) ? 'green' : 'slate', align: 'right' }); y += 20; } drawText(h, 240, 180, 'Move: stick or WASD. Do the thing: Cross or E. Run: Circle or Shift.', { color: 'ink', align: 'center' }); const left = c.left == null ? (c.paused ? 'Paused' : c.starting ? 'Starting…' : '') : `${Math.ceil(c.left / 1000)}s`; drawText(h, 240, 196, left, { color: 'red', align: 'center', scale: 2 }); h.rect(70, 218, 150, 20, 'navy'); drawText(h, 145, 224, 'Ready (Enter / Cross)', { color: 'white', align: 'center' }); h.rect(260, 218, 150, 20, c.asked ? 'red' : 'slate'); drawText(h, 335, 224, `More time (T / Triangle)`, { color: 'white', align: 'center' }); }\n  cameraTarget() { return this.target; }\n  status() { return `round t=${Math.round(this.hub.time())}`; }\n}\nconst localStorageHasAudio = () => { try { return !!localStorage.getItem('pixel-engine:audio'); } catch { return false; } };\nexport async function startRound(hub, options) {\n  const info = await hub.connect({ mode: 'shared-world', seats: [1, 4], card: true }); if (!info) return false;\n  try { await Engine.start(new RoundGame(hub), options('medium')); } catch (e) { hub.fail(String(e?.message ?? e)); }\n  return true;\n}\nE\ncat > src/net/visit.js <<'E'\n// Visit mode on its own: Open my gate / Visit a friend. Host's world is authoritative; guests keep only pockets and beans.\nimport { G, bus } from '../state.js';\nimport { UI, panel, menu, promptRow } from '../ui/kit.js';\nimport { drawText, textWidth } from '../ui/font.js';\nimport { Toasts, Script, say } from '../ui/dialogue.js';\nimport { BroadcastTransport, RtcTransport } from './transport.js';\nimport { serialize, deserialize, saveNow, loadSave, hasSave, markPlaying } from '../core/save.js';\nimport { storage } from '../core/storage.js';\nimport { setPlace, Trans } from '../world/places.js';\nimport { Actor } from '../actors/actor.js';\nimport { lookDef } from '../actors/player.js';\nimport { NPC } from '../actors/npcs.js';\nimport { THREE } from '../engine.js';\nimport { LANDMARK, BUILDINGS } from '../world/layout.js';\nimport { removeEnt, addEnt, giveItem, rebuildGrid } from '../core/world.js';\nimport { NEIGHBOURS } from '../data/cast.js';\nimport { ITEMS, EMOTE_CLIP } from '../data/items.js';\nimport { T } from '../dev/tuning.js';\nconst CANNED = ['Hello!', 'Nice town.', 'Is that goose always like that?', 'Look at this!', 'Thanks!', 'Bye!'];\nconst VISITOR_KEY = 'sillyfolk:visitor';\nconst myId = () => { let id = storage.get('sillyfolk:sid'); id = (typeof crypto !== 'undefined' ? crypto.randomUUID?.() : null) ?? String(Date.now() + Math.floor(performance.now())); return id; };\nconst Announce = 'sillyfolk-gates';\nclass Session {\n  constructor(role) { this.role = role; this.id = myId(); this.avatars = new Map(); this.transports = []; this.guests = new Map(); this.group = new THREE.Group(); G.ctx.scene.add(this.group); this.meT = 0; this.snapT = 0; this.entT = 0; this.lastEnts = new Map(); }\n  addTransport(t) { this.transports.push(t); t.on('message', (d, f) => this.onMsg(d, f, t)); }\n  send(d, o = {}) { for (const t of this.transports) t.send(d, o); }\n  avatar(id, look, name) { let v = this.avatars.get(id); if (v) return v; const a = new Actor(lookDef(look, 'g' + id.slice(0, 4))); a.addTo(this.group); a.play('Idle'); v = { a, name, x: 0, z: 0, f: 0, place: 'town', hist: [], bubble: null, bubbleT: 0 }; this.avatars.set(id, v); return v; }\n  dropAvatar(id) { const v = this.avatars.get(id); if (v) { v.a.removeFrom(); this.avatars.delete(id); } }\n  meNow() { const w = G.world; return { t: 'me', x: +w.p.x.toFixed(2), z: +w.p.z.toFixed(2), f: +w.p.facing.toFixed(2), place: w.p.place, a: G.player.speed > 0 ? 1 : 0 }; }\n  update(dt) {\n    const now = performance.now() - 120; const place = G.world.p.place;\n    for (const v of this.avatars.values()) { const hs = v.hist; let x = v.x, z = v.z, f = v.f, a = v.mv; if (hs.length >= 2) { let A = hs[0], B = hs[hs.length - 1]; for (let i = 0; i < hs.length - 1; i++) if (hs[i].t <= now && hs[i + 1].t >= now) { A = hs[i]; B = hs[i + 1]; break; } const k = Math.max(0, Math.min(1, (now - A.t) / Math.max(1, B.t - A.t))); x = A.x + (B.x - A.x) * k; z = A.z + (B.z - A.z) * k; f = B.f; a = B.a; v.x = x; v.z = z; } v.a.visible = v.place === place; if (v.place === place && G.place) { v.a.place(x, G.place.heightAt(x, z), z); v.a.targetFacing = f; if (v.a.onceT <= 0) v.a.play(a ? 'Jog' : 'Idle'); v.a.update(dt); } v.bubbleT = Math.max(0, v.bubbleT - dt); }\n  }\n  drawBubbles(h) { for (const v of this.avatars.values()) { if (!v.a.visible) continue; const pos = v.a.root.position; const [x, y] = G.view.project(pos.x, pos.y + 1.7, pos.z); const nw = textWidth(v.name) + 6; h.rect(x - nw / 2, y - 10, nw, 11, 'ink'); drawText(h, x, y - 8, v.name, { color: 'sand', align: 'center' }); if (v.bubbleT > 0 && v.bubble) { const w = textWidth(v.bubble) + 10; panel(h, x - w / 2, y - 28, w, 15); drawText(h, x, y - 24, v.bubble, { color: 'ink', align: 'center' }); } } }\n  emote(e) { this.send({ t: 'ev', from: this.id, emote: e }); }\n  phrase(i) { this.send({ t: 'ev', from: this.id, phrase: i }); const w = G.world; Toasts.add(`You say: ${CANNED[i]}`); }\n  applyGesture(d) { const v = this.avatars.get(d.from); if (!v) return; if (d.emote) v.a.play(EMOTE_CLIP[d.emote], { then: 'Idle', restart: true }); if (d.phrase != null) { v.bubble = CANNED[d.phrase]; v.bubbleT = 3; } }\n}\nexport class HostSession extends Session {\n  constructor() { super('host'); this.bc = null; this.announceT = 0; }\n  openBroadcast() { this.announcer = new BroadcastChannel(Announce); this.announcer.onmessage = (e) => { if (e.data?.t === 'who') this.announce(); }; const t = new BroadcastTransport('sillyfolk-gate-' + this.id, this.id); this.addTransport(t); this.bc = t; this.announce(); }\n  announce() { this.announcer?.postMessage({ t: 'gate', id: this.id, name: G.world.name, town: G.world.town }); }\n  async openRtc(iceServers) { this.rtc = this.rtc ?? new RtcTransport(this.id, iceServers); if (!this.transports.includes(this.rtc)) this.addTransport(this.rtc); this.rtc.onopen = (peer) => {}; this.pendingPeer = 'peer' + (this.rtc.peers.size + 1); return this.rtc.makeGatePass(this.pendingPeer); }\n  async acceptReply(code) { await this.rtc.acceptReply(code, this.pendingPeer); }\n  onMsg(d, from, t) {\n    if (d.t === 'hello') { if (this.guests.size >= 3) { t.send({ t: 'full' }, { to: from }); return; } this.guests.set(from, { name: d.name, t }); this.avatar(from, d.look, d.name); this.sendTown(from, t); Toasts.add(`${d.name} got off the bus.`, 4); G.world.stats.visitors = (G.world.stats.visitors ?? 0) + 1; bus.emit('visitorJoined', d.name); }\n    else if (d.t === 'me') { const v = this.avatars.get(from); if (v) { v.place = d.place; v.hist.push({ t: performance.now(), x: d.x, z: d.z, f: d.f, a: d.a }); if (v.hist.length > 6) v.hist.shift(); v.x = d.x; v.z = d.z; v.f = d.f; v.mv = d.a; } }\n    else if (d.t === 'do') this.doAction(d, from, t);\n    else if (d.t === 'ev') { this.applyGesture(d); this.send(d); }\n    else if (d.t === 'bye') { this.guests.delete(from); this.dropAvatar(from); Toasts.add('Your visitor went home. The bus never came. They just left.'); this.send({ t: 'gone', id: from }); }\n  }\n  sendTown(to, t) { const w = G.world; const { mail, mailQueue, memory, ...rest } = JSON.parse(serialize(w)); rest.p.pockets = []; rest.p.beans = 0; const text = JSON.stringify(rest); const CH = 12000; const n = Math.ceil(text.length / CH); let i = 0; this.chunkQ = this.chunkQ ?? []; for (; i < n; i++) this.chunkQ.push({ to, t, msg: { t: 'town', i, n, s: text.slice(i * CH, (i + 1) * CH), host: w.name, hostLook: w.p.look, hostId: this.id } }); }\n  doAction(d, from, t) { const w = G.world; const e = d.id ? w.ents[d.id] : null; if (d.a === 'pick' && e && (e.t === 'item' || e.t === 'shell')) { removeEnt(w, e); t.send({ t: 'ev', got: e.it, value: e.value }, { to: from }); } if (d.a === 'shake' && e?.t === 'tree' && e.fruit > 0) { const n = e.fruit; e.fruit = 0; e.regrow = T.fruitRegrow; w.dirty = true; for (let i = 0; i < n; i++) t.send({ t: 'ev', got: 'pear' }, { to: from }); } if (d.a === 'drop' && d.it) { const tx = Math.floor(d.x), tz = Math.floor(d.z); addEnt(w, { t: 'item', it: d.it, x: tx + 0.5, z: tz + 0.5, from: 'guest' }); } }\n  fixed(dt) {\n    this.announceT -= dt; if (this.announceT <= 0) { this.announceT = 2; this.announce(); }\n    if (this.chunkQ?.length) { this.chunkT = (this.chunkT ?? 0) - dt; if (this.chunkT <= 0) { this.chunkT = 0.08; const c = this.chunkQ.shift(); c.t.send(c.msg, { to: c.to }); } }\n    this.snapT -= dt; if (this.snapT <= 0 && this.guests.size) { this.snapT = 0.1; const w = G.world; const others = [...this.avatars.entries()].map(([id, v]) => [id, +v.x.toFixed(2), +v.z.toFixed(2), +v.f.toFixed(2), v.mv ? 1 : 0, v.place]); const npcs = NEIGHBOURS.filter((n) => w.npcs[n].place === 'town').map((n) => { const r = NPC.rt[n]; return [n, +r.x.toFixed(1), +r.z.toFixed(1)]; }); this.send({ t: 'snap', min: Math.floor(w.clock.minute), day: w.clock.day, h: [this.id, +w.p.x.toFixed(2), +w.p.z.toFixed(2), +w.p.facing.toFixed(2), G.player.speed > 0 ? 1 : 0, w.p.place], o: others, n: npcs }, { reliable: false }); }\n    this.entT -= dt; if (this.entT <= 0 && this.guests.size) { this.entT = 1; const w = G.world; const removed = [], added = []; const now = new Map(Object.entries(w.ents).map(([id, e]) => [id, `${e.t}:${e.fruit ?? ''}:${e.age ?? ''}`])); if (this.lastEnts.size) { for (const id of this.lastEnts.keys()) if (!now.has(id)) removed.push(id); for (const [id, sig] of now) if (this.lastEnts.get(id) !== sig) added.push(w.ents[id]); } this.lastEnts = now; if (removed.length || added.length) this.send({ t: 'ents', removed, added: added.slice(0, 30) }); }\n  }\n  close() { this.send({ t: 'hostgone' }); for (const t of this.transports) t.close(); this.announcer?.close(); this.transports = []; for (const id of [...this.avatars.keys()]) this.dropAvatar(id); }\n}\nexport class GuestSession extends Session {\n  constructor() { super('guest'); this.chunks = []; }\n  joinBroadcast(hostId) { const t = new BroadcastTransport('sillyfolk-gate-' + hostId, this.id); this.addTransport(t); this.hostId = hostId; this.hello(); }\n  async joinRtc(code, iceServers) { const t = new RtcTransport(this.id, iceServers); this.addTransport(t); const reply = await t.acceptGatePass(code, 'host'); t.onopen = () => this.hello(); return reply; }\n  hello() { const own = loadVisitor(); this.own = own; this.send({ t: 'hello', name: own.name, look: own.look }); }\n  onMsg(d, from) {\n    if (d.t === 'town') { this.chunks[d.i] = d.s; if (this.chunks.filter(Boolean).length === d.n) this.arrive(JSON.parse(this.chunks.join('')), d); }\n    else if (d.t === 'full') { Toasts.add('That gate is full. Three visitors is a crowd. The goose counted.'); G.visit = null; }\n    else if (d.t === 'snap') { const w = G.world; if (!w.guest) return; w.clock.minute = d.min; if (d.day !== w.clock.day) w.clock.day = d.day; const list = [d.h, ...d.o]; for (const [id, x, z, f, a, place] of list) { if (id === this.id) continue; const v = this.avatars.get(id) ?? this.avatar(id, id === this.hostKey ? this.hostLook : { hair: 2, hairColor: 'ink', eyes: 1, shirt: 's_red' }, id === this.hostKey ? this.hostName : 'A visitor'); v.place = place; v.hist.push({ t: performance.now(), x, z, f, a }); if (v.hist.length > 6) v.hist.shift(); v.x = x; v.z = z; v.f = f; v.mv = a; } for (const [n, x, z] of d.n) { const r = NPC.rt[n]; if (r) { r.x = x; r.z = z; if (w.npcs[n]) w.npcs[n].place = 'town'; r.path = null; } } }\n    else if (d.t === 'ents') { const w = G.world; if (!w.guest) return; for (const id of d.removed) { const e = w.ents[id]; if (e) removeEnt(w, e); } for (const e of d.added) { if (w.ents[e.id]) { Object.assign(w.ents[e.id], e); w.dirty = true; } else { w.ents[e.id] = e; rebuildGrid(w); w.dirty = true; } } }\n    else if (d.t === 'ev') { if (d.got) { if (giveItem(G.world, d.value ? { id: d.got, value: d.value } : { id: d.got })) { G.ctx.audio.play('pickup'); Toasts.add(`Got ${ITEMS[d.got]?.name}.`); this.save(); } } else this.applyGesture(d); }\n    else if (d.t === 'hostgone') { Toasts.add('Your host went to bed. You are sent home with what you carry.'); this.leave(); }\n    else if (d.t === 'gone') this.dropAvatar(d.id);\n  }\n  arrive(snap, m) { const own = this.own; const w = snap; rebuildGrid(w); w.guest = true; w.name = own.name; w.p.pockets = own.pockets.slice(); while (w.p.pockets.length < 15) w.p.pockets.push(null); w.p.beans = own.beans; w.p.look = own.look; w.p.tools = ['net', 'rod', 'can']; w.p.tool = null; w.p.place = 'town'; w.day1 = { done: true }; this.hostKey = m.hostId; this.hostLook = m.hostLook; this.hostName = m.host; G.mode = 'play'; UI.clear(); Trans.go(() => { G.game.useWorld(w); G.view.zoomTarget = T.zoom; G.player.actor.visible = true; G.player.rebuild(); setPlace('town', LANDMARK.busStop[0], LANDMARK.busStop[1] + 1, 0); Toasts.add(`You arrive in ${w.town} by bus. Mind the goose.`, 4); bus.emit('visitArrived'); }, 'fade', 2.4); }\n  fixed(dt) { this.meT -= dt; if (this.meT <= 0 && G.world?.guest) { this.meT = 0.1; this.send(this.meNow(), { reliable: false }); } }\n  save() { const w = G.world; if (!w.guest) return; storage.setJSON(VISITOR_KEY, { name: w.name, look: w.p.look, pockets: w.p.pockets.filter(Boolean), beans: w.p.beans }); }\n  leave() { this.save(); this.send({ t: 'bye' }); const own = storage.getJSON(VISITOR_KEY); const s = loadSave(); if (s && own) { s.p.pockets = [...own.pockets]; while (s.p.pockets.length < 15) s.p.pockets.push(null); s.p.beans = own.beans; saveNow(s, Date.now()); } for (const t of this.transports) t.close(); for (const id of [...this.avatars.keys()]) this.dropAvatar(id); G.visit = null; G.game.toTitle(); bus.emit('visitLeft'); }\n}\nfunction loadVisitor() { const v = storage.getJSON(VISITOR_KEY); const s = loadSave(); if (s) return { name: s.name, look: s.p.look, pockets: s.p.pockets.filter(Boolean), beans: s.p.beans }; if (v) return v; const o = { name: 'Visitor', look: { hair: 1, hairColor: 'plum', eyes: 4, shirt: 's_sky' }, pockets: [], beans: 500 }; return o; }\n// ---- DOM paste box: pixel-styled, needs a keyboard, says so\nfunction pasteBox(title, text, onDone) { const d = document.createElement('div'); d.id = 'sf-paste'; d.style.cssText = 'position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:60vw;background:#f4f4f4;border:6px solid #ffcd75;padding:18px;font:18px monospace;color:#1a1c2c;z-index:9;cursor:auto'; const h = document.createElement('div'); h.textContent = title; const ta = document.createElement('textarea'); ta.style.cssText = 'width:100%;height:22vh;font:14px monospace;margin:10px 0'; ta.value = text ?? ''; const row = document.createElement('div'); const mk = (label, f) => { const b = document.createElement('button'); b.textContent = label; b.style.cssText = 'font:16px monospace;margin-right:10px;padding:8px 14px'; b.onclick = f; row.appendChild(b); return b; }; if (text) mk('Copy', () => { ta.select(); navigator.clipboard?.writeText(ta.value).catch(() => {}); }); mk('OK', () => { d.remove(); onDone?.(ta.value.trim()); }); mk('Cancel', () => { d.remove(); onDone?.(null); }); d.append(h, ta, row); document.body.appendChild(d); ta.focus(); if (text) ta.select(); return d; }\n// ---- Menus\nexport function openVisitMenu() {\n  const m = menu({ id: 'visit', title: 'Visit', w: 330, items: () => [{ label: 'Open my gate', disabled: !hasSave(), value: () => (hasSave() ? '' : 'needs a save'), action: () => openGate() }, { label: 'Visit a friend', action: () => { UI.push(friendMenu()); } }], }); UI.push(m);\n}\nfunction openGate() { UI.clear(); G.game.continueGame(); const s = new HostSession(); s.openBroadcast(); G.visit = wrap(s); setTimeoutFrames(() => { UI.push(gateMenu(s)); }); }\nconst setTimeoutFrames = (f) => Script.run((function* () { yield 1.2; f(); })(), { background: true });\nfunction gateMenu(s) { const m = menu({ id: 'gate', title: 'Your gate is open', sub: 'Friends in other windows of this browser can see it. For another computer, make a Gate Pass.', w: 360, items: [{ label: 'Make a Gate Pass (invite code)', action: async () => { const code = await s.openRtc(); pasteBox('Gate Pass. Send it to your friend. They will send back a Reply Slip. Yes, this is a friend code. Yes, it is 600 characters. (Needs a keyboard.)', code, () => { pasteBox('Paste their Reply Slip here:', '', async (r) => { if (r) { try { await s.acceptReply(r); Toasts.add('They are on the bus.'); } catch { Toasts.add('That is not a Reply Slip. It might be a poem.'); } } }); }); } }, { label: 'Carry on', action: () => UI.pop(m) }] }); return m; }\nfunction friendMenu() { const gates = new Map(); const ch = new BroadcastChannel(Announce); ch.onmessage = (e) => { if (e.data?.t === 'gate') gates.set(e.data.id, e.data); }; ch.postMessage({ t: 'who' }); const m = menu({ id: 'friends', title: 'Visit a friend', w: 360, onBack: () => { ch.close(); UI.pop(m); }, items: () => [...[...gates.values()].slice(0, 4).map((g) => ({ label: `${g.name}, of ${g.town}`, action: () => { ch.close(); const s = new GuestSession(); G.visit = wrap(s); s.joinBroadcast(g.id); Toasts.add('Waiting for the bus…'); } })), { label: 'I have a Gate Pass', action: () => pasteBox('Paste the Gate Pass your friend sent you. (Needs a keyboard.)', '', async (code) => { if (!code) return; ch.close(); const s = new GuestSession(); G.visit = wrap(s); try { const reply = await s.joinRtc(code); pasteBox('Your Reply Slip. Send it back to your friend:', reply, () => {}); } catch { Toasts.add('That is not a Gate Pass.'); G.visit = null; } }) }, { label: gates.size ? 'Looking for more gates…' : 'No open gates in this browser yet…', disabled: true }] }); return m; }\nfunction wrap(s) { return { session: s, hosting: () => s.role === 'host', emote: (e) => s.emote(e), fixed: (dt) => s.fixed(dt), update: (dt) => s.update(dt), bubbles: (h) => s.drawBubbles(h), leave: () => { if (s.role === 'guest') s.leave(); else { s.close(); G.visit = null; } }, phrase: (i) => s.phrase(i), guest: s.role === 'guest', CANNED }; }\nexport { CANNED, wrap, loadVisitor };\nE\ncat >> ../PROGRESS.md <<'E'\nDone: net/transport, net/round (hub), net/visit. Next: wire visit in game.js (G.visitMenu, guest guards), tests/run.mjs suites, fix.\nE\npython3 - <<'E'\np='src/game.js'; s=open(p).read()\ns=s.replace(\"import './art/textures.js';\\nconst touchOnly\",\"import './art/textures.js';\\nimport { openVisitMenu } from './net/visit.js';\\nconst touchOnly\")\ns=s.replace(\"G.rumble = (a, s) => this.rumble(a, s);\",\"G.rumble = (a, s) => this.rumble(a, s); G.visitMenu = () => { if (typeof BroadcastChannel === 'undefined') return Toasts.add('Visiting needs a real browser.'); openVisitMenu(); };\")\ns=s.replace(\"G.saveAndQuit = () => { saveNow(G.world, G.nowMs()); markPlaying(false); UI.clear(); this.toTitle(); };\",\"G.saveAndQuit = () => { if (G.visit) { const v = G.visit; if (v.guest) { UI.clear(); v.leave(); return; } v.leave(); } saveNow(G.world, G.nowMs()); markPlaying(false); UI.clear(); this.toTitle(); };\")\ns=s.replace(\"UI.draw(h); Toasts.draw(h); drawCursor(h, c);\",\"if (G.visit) G.visit.bubbles(h); UI.draw(h); Toasts.draw(h); drawCursor(h, c);\")\ns=s.replace(\"\"\"if (!G.demo && !w.guest) { saveNow(w, G.nowMs()); if (G.time - this.cleanAt > 30) markPlaying(true); }\"\"\",\"\"\"if (!G.demo && !w.guest) { saveNow(w, G.nowMs()); if (G.time - this.cleanAt > 30) markPlaying(true); }\"\"\")\ns=s.replace(\"if (c.pressed('emotes')) { UI.push(emoteWheel()); return; }\",\"if (c.pressed('emotes')) { if (G.visit) { const m = menu({ id: 'phrases', title: 'Say something', w: 280, items: [{ label: 'Emotes…', action: () => { UI.pop(m); UI.push(emoteWheel()); } }, ...G.visit.CANNED.map((t, i) => ({ label: t, action: () => { UI.pop(m); G.visit.phrase(i); } }))] }); UI.push(m); } else UI.push(emoteWheel()); return; }\")\ns=s.replace(\"tick(dt) {\\n    const w = G.world, c = w.clock; if (c.frozen || G.clockFrozen) return;\",\"tick(dt) {\\n    const w = G.world, c = w.clock; if (c.frozen || G.clockFrozen || w.guest) return;\")\ns=s.replace(\"  ready(ctx) { const self = this;\",\"  ready(ctx) { const self = this; bus.emit('engineReady');\")\nopen(p,'w').write(s)\np='src/systems/interact.js'; s=open(p).read()\ns=s.replace(\"export function shakeTree(e) { const w = G.world, p = G.player, v = G.view.ents.get(e.id);\",\"export function shakeTree(e) { const w = G.world, p = G.player, v = G.view.ents.get(e.id); if (w.guest) { G.visit.session.send({ t: 'do', a: 'shake', id: e.id }); p.actor.play('ShakeTree', { then: 'Idle' }); p.busy = 0.5; if (v) v.shake = 0.5; G.ctx.audio.play('shake'); return; }\")\ns=s.replace(\"function pickFlower(e) { const w = G.world; if (!collect\",\"function pickFlower(e) { const w = G.world; if (w.guest) return Toasts.add(\\\"It's not your flower. Your host would notice.\\\"); if (!collect\")\ns=s.replace(\"function pickEnt(e) { const w = G.world; const entry\",\"function pickEnt(e) { const w = G.world; if (w.guest) { G.visit.session.send({ t: 'do', a: 'pick', id: e.id }); pickAnim(); return; } const entry\")\ns=s.replace(\"function pullWeed(e) { const w = G.world; if (!giveItem\",\"function pullWeed(e) { const w = G.world; if (w.guest) return Toasts.add('It is not your weed. It is a very nice weed.'); if (!giveItem\")\ns=s.replace(\"function axe() {\\n  const w = G.world,\",\"function axe() {\\n  if (G.world.guest) return Toasts.add(\\\"You can't fell your host's trees. They've got a goose.\\\");\\n  const w = G.world,\")\ns=s.replace(\"function shovel() {\\n  const w = G.world,\",\"function shovel() {\\n  if (G.world.guest) return Toasts.add('No digging on visits. It is in the terms.');\\n  const w = G.world,\")\ns=s.replace(\"  if (b.id === 'home') { if (w.p.tier === 0)\",\"  if (w.guest && b.id === 'home') return Toasts.add(\\\"It's your host's home. Knock politely, by leaving.\\\");\\n  if (b.id === 'home') { if (w.p.tier === 0)\")\nopen(p,'w').write(s)\np='src/net/visit.js'; s=open(p).read()\nopen(p,'w').write(s)\nE\nnode tools/build.mjs 2>&1 | tail -3","description":"Write hub round, Visit mode and wire them in"}}}
