s';\")\ns=s.replace(\"G.player.actor.visible = false; G.view.town.visible = false; w.clock.frozen = true; G.opening = { t: 0 };\",\"G.player.actor.visible = false; G.view.town.visible = false; rideScene(true, 0); w.clock.frozen = true; G.opening = { t: 0 }; w.clock.minute = 22 * 60; G.view.rain.intensity = 0.9;\")\ns=s.replace(\"Trans.go(() => { M.override = null; G.opening = null; w.clock.frozen = false; G.player.actor.visible = true;\",\"Trans.go(() => { rideScene(false); M.override = null; G.opening = null; w.clock.frozen = false; w.clock.minute = 8 * 60; G.view.rain.intensity = 0; G.player.actor.visible = true;\")\nopen(p,'w').write(s)\nE\ncat > src/data/about.js <<'E'\n// Source Information and feedback: the same text as the chat reply and exit-interview.json.\nimport { SOURCE_INFORMATION, TESTING_FEEDBACK, ENGINE_FEEDBACK, PROMPT_FEEDBACK } from './aboutText.js';\nexport const ABOUT_PAGES = [\n  { title: 'Source Information', rows: SOURCE_INFORMATION },\n  { title: 'Testing Feedback', rows: TESTING_FEEDBACK },\n  { title: 'Engine Feedback', rows: ENGINE_FEEDBACK },\n  { title: 'Prompt Feedback', rows: PROMPT_FEEDBACK },\n  { title: 'Cast', rows: [['Mrs. Gander', 'as herself, and as your creditor'], ['Mayor Trundle', 'arriving shortly'], ['The neighbours', 'Dorrit, Tavi, Bartleby, Lady Ottoline, Rocco, Nib, Ozzie, Yolanda, Fitch'], ['The City', 'Monsieur Fleece, Flavia Rosé, Magda, Sir Reginald Bellows, Pemberton, Agent Brisket, Languid Lou, Madame Nibbles'], ['Also', 'Clementine and the bee, Dr. Quill, Madame Mothwick, Hester, Vesper, Old Rind, Inspector Pimm']] },\n  { title: 'Licences', rows: [['Riftlight Pixel Engine 0.46.0', 'MIT. Includes three.js r186 (MIT) and Rapier (Apache-2.0).'], ['Kenney Furniture Kit 2.0', 'CC0, by Kenney (kenney.nl). Credited anyway, gladly.'], ['Silly Folk', 'Original game. All names, characters, art, music and writing are new.'], ['Inspired by', 'Animal Crossing: City Folk'], ['Full text', \"The kit's CREDITS.md ships in this page: press the prompt below to read it.\"]], credits: true },\n];\nE\ncat > src/data/aboutText.js <<'E'\nexport const SOURCE_INFORMATION = [['Date', '2026-11-05 17:18:21'], ['Source', 'Animal Crossing: City Folk'], ['Plan', 'PLAN.md'], ['Genre and Perspective', 'Life sim / social sim; isometric 3/4 orthographic diorama with 90-degree camera turns'], ['Tech', 'Riftlight Pixel Engine 0.46.0 (three.js r186 WebGPU, Rapier idle), plain JavaScript, esbuild 0.28.2, AI Hub session client 1.4.0'], ['Art Direction', 'The engine\\'s native 3D-as-pixel-art (default look, Sweetie 16), with new critters, buildings, nature and items as data; Kenney furniture recoloured'], ['Animation', \"The engine's clip format on a shared 7-joint rig, THREE.AnimationMixer cross-fades, Squash, code-driven faces\"], ['Audio', 'All code: Song sequencer music at 10% by default (24 hourly arrangements with rain and snow variants), SoundDef effects, Animalese-style gibberish voices'], ['Online', 'AI Hub shared-world round (The Bean Bazaar, 1-4 players); Visit mode on its own via BroadcastChannel and serverless WebRTC invite codes'], ['Testing', 'Headless scripts in Node and Playwright browsers on this computer, one command printing failures and a count; screenshots for what a script cannot check'], ['Research', 'Read the engine kit docs and the AI Hub session README; no outside research'], ['Environment', 'Claude Code CLI (headless); Linux'], ['Model', 'Anthropic, claude-opus-5-5, reasoning effort medium'], ['Usage', 'added on import']];\nexport const TESTING_FEEDBACK = [['How many issues did testing catch?', 'pending']];\nexport const ENGINE_FEEDBACK = [['What did you like most about the engine?', 'pending']];\nexport const PROMPT_FEEDBACK = [['What did you like most about this prompt?', 'pending']];\nE\ncat > src/ui/shell.js <<'E'\n// Title, pause, settings, dev mode, About. Same screens for pad, keyboard and mouse.\nimport { UI, panel, menu, dim, promptRow, hit, hitAt, para } from './kit.js';\nimport { drawText, wrap, textWidth, LINE_H } from './font.js';\nimport { G, bus } from '../state.js';\nimport { T, TUNING, resetTuning, saveTuning } from '../dev/tuning.js';\nimport { storage, KEYS } from '../core/storage.js';\nimport { voiceCfg } from '../audio/voice.js';\nimport { ABOUT_PAGES } from '../data/about.js';\nimport { MUSIC_DEFAULT, M } from '../audio/music.js';\nimport { ITEMS, EMOTES, TOOL_ORDER, FURNITURE, FISH_LIST, BUG_LIST, FOSSIL_LIST, ART_LIST, CLOTHES } from '../data/items.js';\nimport { mapScreen, almanacScreen } from './screens.js';\nimport { Toasts, Script } from './dialogue.js';\nimport { NEIGHBOURS, CAST, nameOf } from '../data/cast.js';\nimport { serialize, deserialize, saveNow, wipeSave } from '../core/save.js';\nimport { giveItem, info, debtTotalFor, friendTier, addEnt } from '../core/world.js';\nimport { fmt, rngOf } from '../core/util.js';\nimport { BUILDINGS, LANDMARK, CITY } from '../world/layout.js';\nimport { setPlace, Trans, ensureRoom } from '../world/places.js';\nimport { upgradeHome, syncWing } from '../systems/services.js';\nimport { FEST_BY_YD, startFestival, endContest, fireworkShow, pimmVisit } from '../systems/year.js';\nimport { Nature } from '../systems/nature.js';\nimport { NPC } from '../actors/npcs.js';\nimport { SEASON_NAMES } from '../core/calendar.js';\nimport { equip } from '../systems/interact.js';\nimport { HAIRS } from '../art/critter.js';\nexport const SETTINGS_DEFAULT = { voice: 0.8, voiceStyle: 'gibberish', xbox: false, rumble: true, shake: true, textSpeedSet: false };\nexport const S = { ...SETTINGS_DEFAULT };\nexport function loadSettings() { Object.assign(S, SETTINGS_DEFAULT, storage.getJSON(KEYS.settings) ?? {}); applySettings(); }\nexport const saveSettings = () => storage.setJSON(KEYS.settings, S);\nexport function applySettings() { voiceCfg.volume = S.voice; voiceCfg.style = S.voiceStyle; UI.xbox = S.xbox; G.cameraShake = S.shake; G.rumbleOn = S.rumble; }\nconst pct = (v) => `${Math.round(v * 100)}%`;\nexport function settingsScreen() {\n  const a = G.ctx.audio, eng = G.ctx.engine; const vol = (k) => ({ get: () => a.volume[k], set: (v) => a.setVolume(k, v), min: 0, max: 1, step: 0.05 });\n  const m = menu({ id: 'settings', title: 'Settings', w: 330, perPage: 7, items: () => [\n    { label: 'Music', slider: vol('music'), fmt: pct }, { label: 'Effects', slider: vol('sfx'), fmt: pct }, { label: 'Voices', slider: { get: () => S.voice, set: (v) => { S.voice = v; applySettings(); saveSettings(); }, min: 0, max: 1, step: 0.05 }, fmt: pct },\n    { label: 'Voice style', value: () => ({ gibberish: 'Gibberish', beeps: 'Soft beeps', off: 'Off' }[S.voiceStyle]), onRight: () => { S.voiceStyle = { gibberish: 'beeps', beeps: 'off', off: 'gibberish' }[S.voiceStyle]; applySettings(); saveSettings(); }, onLeft: () => { S.voiceStyle = { gibberish: 'off', beeps: 'gibberish', off: 'beeps' }[S.voiceStyle]; applySettings(); saveSettings(); } },\n    { label: 'Text speed', slider: { get: () => T.textSpeed, set: (v) => { T.textSpeed = v; saveTuning(); }, min: 10, max: 200, step: 5 } },\n    { label: 'Controller glyphs', value: () => (S.xbox ? 'Xbox (A B X Y)' : 'PlayStation'), onRight: () => { S.xbox = !S.xbox; applySettings(); saveSettings(); }, onLeft: () => { S.xbox = !S.xbox; applySettings(); saveSettings(); } },\n    { label: 'Rumble', value: () => (S.rumble ? 'On' : 'Off'), onRight: () => { S.rumble = !S.rumble; applySettings(); saveSettings(); }, onLeft: () => { S.rumble = !S.rumble; applySettings(); saveSettings(); } },\n    { label: 'Camera shake', value: () => (S.shake ? 'On' : 'Off'), onRight: () => { S.shake = !S.shake; applySettings(); saveSettings(); }, onLeft: () => { S.shake = !S.shake; applySettings(); saveSettings(); } },\n    { label: 'Clock', value: () => (G.world?.clock.mode === 'real' ? 'Real Clock' : 'Village Time'), disabled: !G.world || G.mode !== 'play', onRight: () => G.setClockMode?.(G.world.clock.mode === 'real' ? 'village' : 'real'), onLeft: () => G.setClockMode?.(G.world.clock.mode === 'real' ? 'village' : 'real') },\n    { label: 'Fullscreen', value: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'On' : 'Off'), action: () => { if (typeof document === 'undefined') return; if (document.fullscreenElement) document.exitFullscreen?.(); else document.documentElement.requestFullscreen?.(); } },\n    { label: 'Picture: pixel size', value: () => String(eng.settings.values.pixelSize ?? 'Default'), onRight: () => cyc('pixelSize', [undefined, 1, 2, 3]), onLeft: () => cyc('pixelSize', [undefined, 1, 2, 3]) },\n    { label: 'Picture: quality', value: () => String(eng.settings.values.quality ?? 'high'), onRight: () => cyc('quality', ['low', 'medium', 'high']), onLeft: () => cyc('quality', ['low', 'medium', 'high']) },\n    { label: 'Reset to defaults', action: () => { a.resetVolumes(); Object.assign(S, SETTINGS_DEFAULT); T.textSpeed = 35; saveTuning(); applySettings(); saveSettings(); eng.settings.reset?.(); Toasts.add('Everything is as it was. Music at 10%.'); } },\n  ] });\n  const cyc = (k, list) => { const cur = eng.settings.values[k]; const i = list.indexOf(cur); eng.settings.set({ [k]: list[(i + 1) % list.length] }); };\n  return m;\n}\n// ---- About: paged, big type\nexport function aboutScreen() {\n  const scr = { id: 'about', title: 'About', page: 0, sub: 0, opaque: true, freezes: true, get prompts() { return this._p; }, focusLabel() { return ABOUT_PAGES[this.page].title; }, itemsModel() { return ABOUT_PAGES.map((p) => p.title); },\n    content() { const p = ABOUT_PAGES[this.page]; return p.rows.flatMap(([k, v]) => [{ k: true, t: k }, ...wrap(v, 420).map((t) => ({ t }))]); },\n    input(c) { const L = this.content(), per = 16; if (c.nav === 'left' || c.pressed('l1')) { this.page = (this.page + ABOUT_PAGES.length - 1) % ABOUT_PAGES.length; this.sub = 0; UI.sfx('page'); } if (c.nav === 'right' || c.pressed('r1')) { this.page = (this.page + 1) % ABOUT_PAGES.length; this.sub = 0; UI.sfx('page'); } if (c.nav === 'down' && (this.sub + 1) * per < L.length) { this.sub++; UI.sfx('uiTick'); } if (c.nav === 'up' && this.sub > 0) { this.sub--; UI.sfx('uiTick'); } if (c.clickL()) { this.page = (this.page + 1) % ABOUT_PAGES.length; this.sub = 0; } if (ABOUT_PAGES[this.page].credits && c.confirm()) UI.push(licenceScreen()); if (c.back()) { UI.sfx('uiBack'); UI.pop(this); } },\n    draw(h) { h.rect(0, 0, 480, 270, 'navy'); panel(h, 12, 8, 456, 254); const p = ABOUT_PAGES[this.page]; drawText(h, 240, 14, p.title, { color: 'navy', align: 'center', scale: 1 }); drawText(h, 460, 14, `${this.page + 1}/${ABOUT_PAGES.length}`, { color: 'slate', align: 'right' }); h.rect(22, 25, 436, 1, 'sand'); const L = this.content(), per = 16; L.slice(this.sub * per, this.sub * per + per).forEach((l, i) => drawText(h, l.k ? 24 : 32, 30 + i * 13, l.t, { color: l.k ? 'red' : 'ink' })); const pages = Math.ceil(L.length / per); if (pages > 1) drawText(h, 240, 240, `↑ ↓ more (${this.sub + 1}/${pages})`, { color: 'slate', align: 'center' }); this._p = [['l1', 'Previous'], ['r1', 'Next'], ...(p.credits ? [['confirm', 'Read licences']] : []), ['back', 'Back']]; promptRow(h, 240, 248, this._p, { align: 'center', color: 'ink', shadow: false }); } };\n  return scr;\n}\nfunction licenceScreen() { const text = typeof document !== 'undefined' ? document.getElementById('kit-credits')?.textContent ?? '' : ''; const lines = text.split('\\n').flatMap((l) => wrap(l.replace(/[`*#|]/g, ' ').trim(), 440)); const scr = { id: 'licences', title: 'CREDITS.md', top: 0, opaque: true, get prompts() { return [['back', 'Back']]; }, input(c) { if (c.nav === 'down') this.top = Math.min(lines.length - 1, this.top + 16); if (c.nav === 'up') this.top = Math.max(0, this.top - 16); if (c.back()) UI.pop(this); }, draw(h) { h.rect(0, 0, 480, 270, 'navy'); panel(h, 8, 6, 464, 258); lines.slice(this.top, this.top + 19).forEach((l, i) => drawText(h, 16, 12 + i * 12, l, { color: 'ink' })); promptRow(h, 470, 250, [['back', 'Back']], { align: 'right', color: 'ink', shadow: false }); } }; return scr; }\n// ---- Pause\nexport function pauseScreen() {\n  const m = menu({ id: 'pause', title: 'Paused. The goose is not.', w: 240, items: [{ label: 'Resume', action: () => UI.pop(m) }, { label: 'Map', action: () => UI.push(mapScreen()) }, { label: 'Almanac', action: () => UI.push(almanacScreen()) }, { label: 'Settings', action: () => UI.push(settingsScreen()) }, { label: 'Save & Quit to Title', action: () => G.saveAndQuit() }, { label: 'About', action: () => UI.push(aboutScreen()) }, { label: 'Dev Mode', action: () => UI.push(devScreen()) }] });\n  return m;\n}\n// ---- Dev mode, generated where it can be\nconst PAGES = ['Time', 'World', 'Player', 'Neighbours', 'Events', 'Collections', 'Debug', 'Save', 'Balance'];\nexport function devScreen() { const m = menu({ id: 'dev', title: 'Dev Mode', w: 240, perPage: 9, items: PAGES.map((p) => ({ label: p, action: () => UI.push(devPage(p)) })) }); return m; }\nfunction devPage(name) { return menu({ id: 'dev-' + name, title: `Dev: ${name}`, w: name === 'Balance' ? 400 : 340, perPage: name === 'Balance' ? 9 : 8, items: () => PAGE_ITEMS[name]() }); }\nconst act = (label, f, value) => ({ label, action: f, value });\nconst stepper = (label, get, set) => ({ label, value: () => String(get()), onLeft: () => set(-1), onRight: () => set(1) });\nconst PAGE_ITEMS = {\n  Time: () => { const w = G.world; return [stepper('Hour', () => Math.floor(w.clock.minute / 60), (d) => { w.clock.minute = (w.clock.minute + d * 60 + 1440) % 1440; G.hourForce(); }), act('Next day', () => G.sleepTo(0)), stepper('Set day (1-16)', () => ((w.clock.day - 1) % 16) + 1, (d) => G.jumpDay(w.clock.day + d)), stepper('Season', () => SEASON_NAMES[info(w).season], (d) => G.jumpDay(w.clock.day + d * 4)), act(G.clockFrozen ? 'Unfreeze clock' : 'Freeze clock', () => { G.clockFrozen = !G.clockFrozen; }), { label: 'Clock mode', value: () => w.clock.mode, onRight: () => G.setClockMode(w.clock.mode === 'real' ? 'village' : 'real') }]; },\n  World: () => { const w = G.world; const wx = ['sun', 'rain', 'storm', 'fog', 'snow', 'wind', 'clear']; return [{ label: 'Weather', value: () => w.weather?.kind ?? 'sun', onRight: () => { const i = wx.indexOf(w.weather.kind); w.weather = { kind: wx[(i + 1) % wx.length], from: 0, to: 24 }; }, onLeft: () => { const i = wx.indexOf(w.weather.kind); w.weather = { kind: wx[(i + wx.length - 1) % wx.length], from: 0, to: 24 }; } }, act('Teleport to a place…', () => UI.push(menu({ id: 'devtp', title: 'Teleport', w: 300, perPage: 9, items: [...BUILDINGS.map((b) => act(b.id, () => { setPlace('town', b.door[0], b.door[1] + 1); UI.clear(); })), act('Bus stop', () => { setPlace('town', LANDMARK.busStop[0], LANDMARK.busStop[1] + 1); UI.clear(); }), act('Plaza', () => { setPlace('town', 24, 42); UI.clear(); }), act('Lookout', () => { setPlace('town', 70, 7); UI.clear(); }), act('Beach', () => { setPlace('town', 30, 53); UI.clear(); }), act('The City', () => { setPlace('city', CITY.stop[0] + CITY.ox, CITY.stop[1] + 1); UI.clear(); }), ...['store', 'hall', 'museum', 'mothwick', 'salon', 'couture', 'magda', 'theatre', 'auction', 'bureau', 'cafe', 'tent'].map((r) => act(`Room: ${r}`, () => { const rr = ensureRoom(r); setPlace(r, rr.exitAt[0], rr.exitAt[1] - 1, Math.PI); UI.clear(); }))] }))), act('Teleport to a neighbour…', () => UI.push(menu({ id: 'devtpn', title: 'Teleport', w: 280, items: NEIGHBOURS.map((n) => act(CAST[n].name, () => { const rt = NPC.rt[n]; if (w.npcs[n].place === 'town') { setPlace('town', rt.x + 1, rt.z + 1); UI.clear(); } else Toasts.add('They are indoors, or away.'); })) }))), act(G.noclip ? 'Noclip: on' : 'Noclip: off', () => { G.noclip = !G.noclip; }), act(G.freeCam ? 'Free camera: on' : 'Free camera: off', () => { G.freeCam = !G.freeCam; }), act(G.overview ? 'Overview: on' : 'Overview: off', () => { G.overview = !G.overview; G.view.zoomTarget = G.overview ? 0.45 : T.zoom; })]; },\n  Player: () => { const w = G.world; const p = w.p; return [stepper('Beans', () => fmt(p.beans), (d) => { p.beans = Math.max(0, p.beans + d * 10000); }), act('Clear debt', () => { p.debt = 0; }), stepper('Home tier', () => p.tier, (d) => { const t = Math.max(1, Math.min(4, p.tier + d)); upgradeHome(t); p.debt = 0; }), act('Give any item…', () => UI.push(giveMenu())), act('All tools', () => { p.tools = TOOL_ORDER.slice(); equip('net'); }), act('All emotes', () => { p.emotes = EMOTES.slice(); }), act('All records', () => { p.records = ['rec_rain', 'rec_small', 'rec_debt', 'rec_sea', 'rec_goose', 'rec_bye']; }), stepper('Set look: hair', () => HAIRS[p.look.hair], (d) => { p.look.hair = (p.look.hair + d + 8) % 8; G.player.rebuild(); })]; },\n  Neighbours: () => { const w = G.world; return [...NEIGHBOURS.map((n) => stepper(`${nameOf(n)}: friendship`, () => `${Math.round(w.npcs[n].friend)} (${friendTier(w.npcs[n].friend)})`, (d) => { w.npcs[n].friend = Math.max(0, Math.min(100, w.npcs[n].friend + d * 10)); })), act('Force a favour', () => { w.favours = [{ npc: 'dorrit', kind: 'fetch', item: 'pear', other: 'tavi', state: 'open', reward: 500 }]; }), act('Rocco moves out now', () => { G.forceRocco?.(); }), act(G.showRoutines ? 'Show routines: on' : 'Show routines: off', () => { G.showRoutines = !G.showRoutines; })]; },\n  Events: () => { const w = G.world; const fest = (id, yd) => act(`Festival: ${id}`, () => { G.jumpToYd(yd); w.flags[`fest${w.clock.day}`] = false; UI.clear(); startFestival(id); }); return [fest('seedToss', 4), fest('lantern', 8), fest('soup', 12), fest('longNight', 16), act('Contest: Fishing Derby', () => { G.jumpToYd(6); w.clock.minute = 600; G.hourForce(); UI.clear(); }), act('Contest: Bug-Off', () => { G.jumpToYd(10); w.clock.minute = 600; G.hourForce(); UI.clear(); }), act('Contest: Snowman', () => { G.jumpToYd(14); w.clock.minute = 600; G.hourForce(); UI.clear(); }), act('End contest now', () => endContest()), act('Concert: Vesper', () => { G.jumpToYd(3); w.clock.minute = 1200; G.hourForce(); UI.clear(); }), act('Inspector Pimm', () => { UI.clear(); pimmVisit(0); }), act('Cheese day', () => { G.jumpToYd(5); w.clock.minute = 480; G.hourForce(); UI.clear(); }), act('Wasps', () => { UI.clear(); Nature.wasps(w.p.x + 3, w.p.z + 3); }), act('Shooting star', () => { UI.clear(); setPlace('town', 70, 6.8); w.clock.minute = 22 * 60; G.stargaze(); }), act('Fireworks', () => { UI.clear(); setPlace('town', 30, 53); fireworkShow(); }), act('The ending', () => { G.jumpToYd(16); UI.clear(); w.flags[`fest${w.clock.day}`] = false; startFestival('longNight'); })]; },\n  Collections: () => { const w = G.world; const fill = (on) => { w.museum.fish = on ? Object.fromEntries(FISH_LIST.map((i) => [i.id, w.name])) : {}; w.museum.bug = on ? Object.fromEntries(BUG_LIST.map((i) => [i.id, w.name])) : {}; w.museum.fossil = on ? Object.fromEntries(FOSSIL_LIST.map((i) => [i.id, w.name])) : {}; w.museum.art = on ? Object.fromEntries(ART_LIST.map((i) => [i.id, w.name])) : {}; for (const r of ['m_fish', 'm_bug', 'm_fossil', 'm_art']) syncWing(r); }; return [act('Fill museum', () => fill(true)), act('Empty museum', () => fill(false)), act('Fill Almanac', () => { for (const i of Object.values(ITEMS)) w.almanac.seen[i.id] = 1; }), act('Empty Almanac', () => { w.almanac.seen = {}; })]; },\n  Debug: () => [act(G.debugTiles ? 'Collision tiles: on' : 'Collision tiles: off', () => { G.debugTiles = !G.debugTiles; }), act(G.showRoutines ? 'Nav paths: on' : 'Nav paths: off', () => { G.showRoutines = !G.showRoutines; }), act(G.debugTarget ? 'Target overlay: on' : 'Target overlay: off', () => { G.debugTarget = !G.debugTarget; }), act(G.debugNpc ? 'NPC state: on' : 'NPC state: off', () => { G.debugNpc = !G.debugNpc; }), act(G.debugState ? 'Engine state: on' : 'Engine state: off', () => { G.debugState = !G.debugState; }), { label: 'Look', value: () => G.lookName ?? 'none', onRight: () => { const e = G.ctx.engine; G.lookName = e.cycleLook(1); } }],\n  Save: () => { const w = G.world; return [act('Save now', () => { saveNow(w, G.nowMs()); Toasts.add('Saved. The goose noticed.'); }), act('Load', () => { G.loadFromSave(); UI.clear(); }), act('Reset (new world)', () => { wipeSave(); UI.clear(); G.toTitle(); }), act('Export JSON', () => { const t = serialize(w); if (typeof navigator !== 'undefined') navigator.clipboard?.writeText(t).catch(() => {}); G.lastExport = t; Toasts.add(`Exported ${fmt(t.length)} characters to the clipboard.`); }), act('Import JSON', () => { const t = G.lastExport; if (typeof navigator !== 'undefined' && navigator.clipboard?.readText) navigator.clipboard.readText().then((s) => G.ctx.input.send({ t: 'import', text: s })).catch(() => t && G.ctx.input.send({ t: 'import', text: t })); else if (t) G.ctx.input.send({ t: 'import', text: t }); }), act('Export recording', () => { const r = G.ctx.engine.recording(); G.lastRecording = r; const t = JSON.stringify(r); if (typeof navigator !== 'undefined') navigator.clipboard?.writeText(t).catch(() => {}); Toasts.add(`Recording: ${r?.frames?.length ?? 0} frames, on the clipboard.`); }), act('Replay it', () => { const r = G.lastRecording ?? G.ctx.engine.recording(); UI.clear(); G.replayRecording?.(r); })]; },\n  Balance: () => [act('Reset All', () => { resetTuning(); G.view.zoomTarget = T.zoom; Toasts.add('All sliders are back at their defaults.'); }), ...TUNING.map((t) => ({ label: t.label, slider: { get: () => T[t.id], set: (v) => { T[t.id] = v; saveTuning(); if (t.id === 'zoom') G.view.zoomTarget = v; }, min: t.min, max: t.max, step: t.step }, alt: () => { resetTuning(t.id); if (t.id === 'zoom') G.view.zoomTarget = T.zoom; }, altLabel: 'Reset' }))],\n};\nfunction giveMenu() { const list = Object.values(ITEMS); const m = menu({ id: 'devgive', title: 'Give any item', w: 320, perPage: 9, items: list.map((i) => ({ label: i.name, value: () => i.cat, action: () => { giveItem(G.world, { id: i.id, ...(i.id === 'bag' ? { value: 1000 } : {}) }); Toasts.add(`Got ${i.name}.`); } })) }); return m; }\nE\ncat >> ../PROGRESS.md <<'E'\nDone: ui/shell, data/about(+aboutText drafts - fill at end, \"pending\" must be replaced). Next: game.js, dev/attract, main.js, net, tests.\nE","description":"Write title, settings, pause, dev mode and About"}}}
