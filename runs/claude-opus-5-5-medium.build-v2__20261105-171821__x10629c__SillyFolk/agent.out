.06, 2.7, [0, 0.2, 0], 'orange'), box(0.86, 1.6, 0.08, [0, 0.8, 1.52], 'orange'), box(0.6, 0.6, 0.06, [1.1, 1.2, 1.52], 'cyan'), box(0.5, 0.08, 0.5, [-1.1, 1.95, 1.1], 'plum', { rot: [0, 30, 0] })]\",\"[box(3.5, 0.14, 3.1, [0, 0.07, 0], 'slate'), box(3.1, 0.06, 2.7, [0, 0.17, 0], 'orange'), box(0.16, 1.9, 3, [-1.62, 0.95, 0], 'sand'), box(0.16, 1.9, 3, [1.62, 0.95, 0], 'sand'), box(3.4, 1.9, 0.16, [0, 0.95, -1.42], 'sand'), box(1.26, 1.9, 0.16, [-1.07, 0.95, 1.42], 'sand'), box(1.26, 1.9, 0.16, [1.07, 0.95, 1.42], 'sand'), box(0.88, 0.3, 0.16, [0, 1.75, 1.42], 'sand'), box(0.86, 1.6, 0.08, [0, 0.8, 1.48], 'orange'), box(0.6, 0.6, 0.06, [1.1, 1.2, 1.52], 'cyan'), box(0.7, 0.5, 0.5, [-0.8, 0.45, -0.6], 'plum'), box(0.3, 0.3, 0.3, [0.7, 0.35, -0.8], 'mist')]\")\np='tests/play/playthrough.mjs'\nsub(p,\"// ---- save round trip and determinism\",\"\"\"// ---- Life: rain fills puddles, neighbours carry umbrellas and fish, the bus arrives, Nib's tail swings\n{ town(30, 30); G.jumpToYd(info(w()).storyYd === 2 ? 3 : 2); b.settle(); town(30, 30); w().weather = { kind: 'rain', from: 0, to: 24 }; w().clock.minute = 600; const n = NPC.rt.nib; w().npcs.nib.place = 'town'; n.indoorLocal = false; n.x = 31; n.z = 30; n.path = null; n.wait = 1e4; n.moving = false; n.pause = 1e4; b.step(90); check('puddles fill in rain', G.view.wetness > 0 && G.view.puddles.some((m) => m.visible), String(G.view.wetness)); check('umbrellas out', n.holding === 'umb', String(n.holding)); const a = NPC.actors.nib; check('spring tail hangs off Nib', a.tail && a.tailMeshes.length === 7); const p0 = a.tail.points[3].slice(); a.root.position.x += 1; b.step(4); const sw = Math.hypot(a.tail.points[3][0] - p0[0] - 1, a.tail.points[3][2] - p0[2]); check('tail lags and swings', sw > 0.01, String(sw)); w().weather = { kind: 'sun', from: 0, to: 24 }; b.step(30); n.pause = 0; n.x = 37; n.z = 30; n.path = [[37, 0, 30]]; n.moving = true; n.wait = 0; b.step(6); check('neighbour fishes at the river', n.act === 'Reel' && n