ate(\"window.__GAME__.UI.clear()\"); pg.mouse.move(100,100); S(pg,2); pg.mouse.move(120,120); S(pg,3); rects=pg.evaluate(\"window.__GAME__.game.iconRects\")\n    ok('mouse icons shown',[r['id'] for r in rects]==['pockets','map','almanac','emotes'],rects)\n    for r in rects:\n        pg.mouse.move((r['x']+4)*2,(r['y']+6)*2); S(pg,3); pg.mouse.down(); S(pg,2); pg.mouse.up(); S(pg,3); ok('click opens '+r['id'],M(pg)['screen']==r['id'],M(pg)); pg.evaluate(\"window.__GAME__.UI.clear()\"); S(pg,3)\n    pg.evaluate(\"window.__GAME__.G.ctrl.mouseVisible=false\"); key(pg,'Escape')\n''')\np='src/game.js'\nsub(p,\"    G.chimeS = chimeScreen;\",\"    G.settingsS = settingsScreen; G.chimeS = chimeScreen;\")\n# visit: host leaves; full gate; deliberate idle race\np='tests/browser/visit_suite.py'\nsub(p,\"    # Host leaving sends guests home\\n    h.evaluate(\\\"window.__GAME__.G.visit.leave()\\\"); g.close(); h.close(); ctx.close()\\n\",\"\"\"    # Three guests is the limit\n    h.evaluate(\"(()=>{const s=window.__GAME__.G.visit.session;window.__full=[];const t={send:(m)=>{window.__full.push(m.t);return true}};s.guests.set('a',{}).set('b',{}).set('c',{});s.onMsg({t:'hello',name:'D',look:{hair:0,eyes:0,shirt:'s_red'}},'d',t);s.guests.clear();})()\"); ok('fourth visitor is refused',h.evaluate(\"window.__full\")==['full'],h.evaluate(\"window.__full\"))\n    # Host leaving sends guests home, keeping what they carry\n    g.keyboard.press('KeyK'); g.wait_for_timeout(600); g.evaluate(\"window.__GAME__.G.visitMenu()\"); g.wait_for_timeout(500); g.keyboard.press('ArrowDown'); g.wait_for_timeout(400); g.keyboard.press('Enter'); ok('gate listed again',wait(g,\"window.__GAME__.ui.model().items.some(x=>x.includes('Gateville'))\",20000)); g.wait_for_timeout(300); g.keyboard.press('Enter'); ok('guest back',wait(g,\"window.__GAME__.G.world.guest===true\",45000)); g.wait_for_timeout(1500); ok('guest carries over visits',g.evaluate(\"window.__GAME__.G.world.p.beans\")==4321,g.evaluate(\"window.__