{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjvgknvgZzb3D9FQFvk","type":"message","role":"assistant","content":[{"type":"text","text":"World and rooms are done. Next is the writing bible's dialogue banks, about 750 lines, since the neighbours are the point of the game."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10191,"cache_read_input_tokens":282570,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10191},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f147b5a-afdb-41c5-bbfc-62264f8c7cee","uuid":"895884f6-e955-4b78-a4d4-ea4da14d7fb9","timestamp":"2026-11-06T00:38:39.388Z","request_id":"req_011CgkjvgWQkqGpu9P8XrkYp"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjvgknvgZzb3D9FQFvk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Vrrg4FbGmEDrAvTK6dvpeR","name":"Bash","input":{"command":"cat > src/data/cast.js <<'E'\n// Everyone with a name: how they look (critter generator options) and how they sound.\nconst V = (arch, pitch, speed = 1, lilt = 1) => ({ arch, pitch, speed, lilt });\nexport const CAST = {\n  dorrit: { name: 'Dorrit', type: 'hearth', tic: 'mmhm', look: { species: 'wombat', c1: 'orange', c2: 'sand', shirt: 'red', trousers: 'orange', shoes: 'plum' }, voice: V(1, -5, 0.9) },\n  tavi: { name: 'Tavi', type: 'sunshine', tic: \"isn't it?!\", look: { species: 'quokka', c1: 'sand', c2: 'white', shirt: 'lime', trousers: 'sand', shoes: 'orange' }, voice: V(0, 6, 1.2, 1.4) },\n  bartleby: { name: 'Bartleby', type: 'grouch', tic: \"I'd prefer not.\", look: { species: 'moose', c1: 'plum', c2: 'orange', shirt: 'slate', trousers: 'plum', shoes: 'ink' }, voice: V(2, -9, 0.75, 0.5) },\n  ottoline: { name: 'Lady Ottoline', short: 'Ottoline', type: 'diva', tic: 'darling dear', look: { species: 'platypus', c1: 'orange', c2: 'sand', shirt: 'plum', trousers: 'orange', shoes: 'sand' }, voice: V(3, 3, 0.95, 1.5) },\n  rocco: { name: 'Rocco', type: 'gogetter', tic: \"let's roll!\", look: { species: 'armadillo', c1: 'mist', c2: 'white', shirt: 'red', trousers: 'slate', shoes: 'white' }, voice: V(4, 0, 1.25, 1.1) },\n  nib: { name: 'Nib', type: 'dreamer', tic: '…or so the moon says', look: { species: 'lemur', c1: 'mist', c2: 'white', shirt: 'navy', trousers: 'mist', shoes: 'ink' }, voice: V(5, 4, 0.85, 1.3) },\n  ozzie: { name: 'Ozzie', type: 'schemer', tic: \"You didn't hear it from me.\", look: { species: 'possum', c1: 'slate', c2: 'white', shirt: 'ink', trousers: 'slate', shoes: 'ink' }, voice: V(2, 1, 1.15, 0.8) },\n  yolanda: { name: 'Yolanda', type: 'auntie', tic: 'hon', look: { species: 'yak', c1: 'orange', c2: 'sand', c3: 'orange', shirt: 'blue', trousers: 'plum', shoes: 'ink' }, voice: V(1, -3, 1, 1.2) },\n  fitch: { name: 'Fitch', type: 'hustler', tic: 'no refunds', look: { species: 'ferret', c1: 'sand', c2: 'white', shirt: 'teal', trousers: 'navy', shoes: 'ink' }, voice: V(4, 5, 1.35, 0.9) },\n  gander: { name: 'Mrs. Gander', type: 'host', look: { species: 'goose', c1: 'white', c2: 'white', shirt: 'navy', trousers: 'white', shoes: 'orange' }, voice: V(3, 1, 1, 0.7), honk: true },\n  clementine: { name: 'Clementine', type: 'host', look: { species: 'capybara', c1: 'orange', c2: 'sand', shirt: 'teal', trousers: 'orange', shoes: 'plum' }, voice: V(1, -6, 0.8, 0.4) },\n  trundle: { name: 'Mayor Trundle', type: 'host', look: { species: 'snail', c1: 'lime', c2: 'white', shirt: 'lime', trousers: 'lime' }, voice: V(5, -7, 0.45, 0.5) },\n  quill: { name: 'Dr. Quill', type: 'host', look: { species: 'pangolin', c1: 'orange', c2: 'sand', shirt: 'white', trousers: 'orange', shoes: 'plum' }, voice: V(0, 3, 1.15, 1.5) },\n  mothwick: { name: 'Madame Mothwick', short: 'Mothwick', type: 'host', look: { species: 'moth', c1: 'mist', c2: 'white', shirt: 'plum', trousers: 'plum', shoes: 'ink' }, voice: V(3, 2, 0.95, 1.6) },\n  hester: { name: 'Hester', type: 'host', look: { species: 'llama', c1: 'sand', c2: 'white', shirt: 'navy', trousers: 'navy', shoes: 'ink' }, voice: V(5, -2, 0.95, 1.2) },\n  vesper: { name: 'Vesper', type: 'host', look: { species: 'bat', c1: 'plum', c2: 'sand', shirt: 'ink', trousers: 'plum', shoes: 'ink' }, voice: V(5, 5, 0.9, 1.4) },\n  rind: { name: 'Old Rind', type: 'host', look: { species: 'stoat', c1: 'orange', c2: 'white', shirt: 'slate', trousers: 'orange', shoes: 'ink' }, voice: V(2, -1, 0.8, 0.5) },\n  pimm: { name: 'Inspector Pimm', short: 'Pimm', type: 'host', look: { species: 'crab', c1: 'red', c2: 'orange', shirt: 'red', trousers: 'red', shoes: 'red' }, voice: V(2, 3, 1.3, 0.3) },\n  fleece: { name: 'Monsieur Fleece', short: 'Fleece', type: 'host', look: { species: 'alpaca', c1: 'white', c2: 'white', c3: 'plum', shirt: 'ink', trousers: 'ink', shoes: 'ink' }, voice: V(3, 0, 1.05, 1.5) },\n  flavia: { name: 'Flavia Rosé', short: 'Flavia', type: 'host', look: { species: 'flamingo', c1: 'red', c2: 'white', shirt: 'red', trousers: 'red', shoes: 'sand' }, voice: V(3, 4, 0.9, 1.6) },\n  magda: { name: 'Magda', type: 'host', look: { species: 'magpie', c1: 'ink', c2: 'white', shirt: 'white', trousers: 'ink', shoes: 'ink' }, voice: V(2, 4, 1.1, 0.9) },\n  bellows: { name: 'Sir Reginald Bellows', short: 'Bellows', type: 'host', look: { species: 'hippo', c1: 'plum', c2: 'mist', shirt: 'navy', trousers: 'plum', shoes: 'ink' }, voice: V(1, -10, 0.8, 1.6) },\n  pemberton: { name: 'Pemberton', type: 'host', look: { species: 'dormouse', c1: 'sand', c2: 'white', shirt: 'teal', trousers: 'sand', shoes: 'ink' }, voice: V(0, 7, 2, 0.6) },\n  brisket: { name: 'Agent Brisket', short: 'Brisket', type: 'host', look: { species: 'badger', c1: 'white', c2: 'white', shirt: 'navy', trousers: 'navy', shoes: 'ink' }, voice: V(2, -5, 1, 0.3) },\n  lou: { name: 'Languid Lou', short: 'Lou', type: 'host', look: { species: 'sloth', c1: 'plum', c2: 'sand', shirt: 'orange', trousers: 'plum', shoes: 'plum' }, voice: V(1, -8, 0.4, 0.4) },\n  nibbles: { name: 'Madame Nibbles', short: 'Nibbles', type: 'host', look: { species: 'goat', c1: 'mist', c2: 'white', shirt: 'plum', trousers: 'mist', shoes: 'ink' }, voice: V(5, 1, 0.9, 1.3) },\n  you: { name: 'You', type: 'host', look: {}, voice: V(0, 0, 1, 1) },\n  gran: { name: 'Gran', type: 'host', look: {}, voice: V(1, 4, 1, 1) },\n  narrator: { name: '', type: 'host', look: {}, voice: V(5, 0, 1, 1), silent: true },\n};\nexport const NEIGHBOURS = ['dorrit', 'tavi', 'bartleby', 'ottoline', 'rocco', 'nib', 'ozzie', 'yolanda', 'fitch'];\nexport const STAFF_ROOM = { gander: 'store', clementine: 'hall', quill: 'museum', mothwick: 'mothwick', fleece: 'salon', flavia: 'couture', magda: 'magda', bellows: 'theatre', pemberton: 'auction', brisket: 'bureau', lou: 'cafe', nibbles: 'tent' };\nexport const nameOf = (id) => CAST[id]?.short ?? CAST[id]?.name ?? id;\nexport const LOVES = { dorrit: ['soup', 'food', 'fruit', 'mushroom', 'cosy'], tavi: ['flower', 'fruit', 'fish', 'bug', 'shell', 'loud', 'plain', 'clean'], bartleby: ['plain', 'wool', 'pine'], ottoline: ['fancy', 'shell', 'pearl', 'art'], rocco: ['fish', 'food', 'loud', 'practical'], nib: ['bug', 'evening', 'flower'], ozzie: ['cheese', 'city', 'junk'], yolanda: ['wool', 'cosy', 'flower'], fitch: ['bag', 'fancy', 'art', 'cheese'] };\nexport const HATES = { dorrit: ['loud'], tavi: [], bartleby: ['loud', 'fancy'], ottoline: ['junk', 'boot', 'practical'], rocco: ['cosy'], nib: ['loud', 'practical'], ozzie: ['clean'], yolanda: ['fancy'], fitch: ['junk'] };\nE\ncat > src/data/lines.js <<'E'\n// The writing. Warm, deadpan, gently absurd. `|` is a beat; *word* is emphasis; tags: {player} {town} {item} {neighbour} {catch} {tic}.\nexport const TYPE_LINES = {\n  hearth: {\n    greet: [\"You look peaky, mmhm. Have you eaten? That wasn't a question.\", \"Oh, {player}. Sit down. There's no chair, but sit down.\", \"I made too much. I always make too much, mmhm. It's a whole personality.\", \"There you are. I've been keeping something warm for you. It's me. I'm warm.\", \"Mind the pot. Mind the other pot. Mmhm. That's the good pot.\", \"Good to see you, dear. You've got a face like cold gravy.\", \"I was just saying to the stew, mmhm, I wonder how {player} is.\", \"Don't tell me you had a cold breakfast. I can smell it on you.\", \"You're thinner than Tuesday. Everyone's thinner than Tuesday.\", \"If you've come for the recipe, it's butter. It's always been butter, mmhm.\", \"Sit. Eat. Then you can tell me what's wrong. Then eat again.\"],\n    rain: [\"Rain's good for soup, mmhm. Don't ask me how. It just knows.\", \"Wet out. Come in. You're not in, I know, but come in, in spirit.\", \"Listen to that. That's the sky doing the washing-up.\"],\n    snow: [\"Snow's only rain that's had a nice sit-down, mmhm.\", \"Cold enough to set a stock. Lovely.\"],\n    morning: [\"Morning. Porridge is on. It's been on since Thursday.\", \"Up early, mmhm. Good. The pots have been asking after you.\"],\n    night: [\"It's late. Go home, eat something. In that order, or the other order.\", \"All the good soup's asleep by now, mmhm.\"],\n    spring: [\"Everything's sprouting. I've started eating it.\", \"Spring onions are in. So is spring. Coincidence, mmhm.\"],\n    summer: [\"Too hot for soup. I'm making it anyway. Principles.\", \"Cold soup is just a drink that gave up, mmhm.\"],\n    autumn: [\"Mushrooms are up in the woods. Most of them won't kill you.\", \"Now *this* is soup weather. It's always been soup weather, but now it's right.\"],\n    winter: [\"Keep your feet warm, mmhm. Your feet are where you keep your feelings.\", \"I've knitted a lid for the big pot. Don't tell Yolanda it's better than hers.\"],\n    absent: [\"Where've you been? There's nine portions of you in the freezer.\", \"You went away. I kept cooking for you. It's fine. I ate it. Mmhm.\"],\n    hungry: [\"Have you got anything I could put in a pot? Not you, dear. Not yet.\", \"I'm one ingredient short, mmhm. It's always one. It's never the same one.\"],\n    love: [\"Oh, you shouldn't have. Now I have to feed you. I was going to anyway.\", \"That's going straight in the pot. It's a compliment. Mmhm.\"],\n    meh: [\"Well. It's edible, or it isn't. We'll find out together, mmhm.\", \"I'll find a pot for it. I find a pot for everything.\"],\n    hate: [\"Ooh. That's loud. Could you take it outside? It's already outside. Further, then.\", \"Not in my kitchen, dear. Not in anyone's, mmhm.\"],\n    favour: [\"Be a dear, mmhm, and fetch me {item}? I've got both hands in a stew.\", \"I need {item}, and I need it before this thing boils over.\"],\n    thanks: [\"There's a good one. Here. It's beans, not soup. Don't look so surprised.\", \"Mmhm. You'll do. Have some beans. Have some soup. Have a sit.\"],\n    letter: [\"Dear {player}, I sent soup but it leaked. This is the part that didn't. Eat more. Dorrit.\", \"{player}, I heard you were thin. Stop it. Here. Love, Dorrit.\"],\n  },\n  sunshine: {\n    greet: [\"Hi hi hi! It's you! It's still you, isn't it?!\", \"I smiled at a rock today and I think it's going really well, isn't it?!\", \"You look great! You look like a person! That's so hard to do, isn't it?!\", \"I waved at Bartleby. He didn't wave back, so I waved for him. We're close!\", \"Oh my gosh, {player}! We've met before! What are the odds?!\", \"It's a beautiful day to be standing near you, isn't it?!\", \"I counted all my friends and it's everyone! Even the ducks!\", \"Did you know the sky goes all the way up? I checked! It's so committed!\", \"I was happy, and then you came over, and now I'm also happy!\", \"Guess what! Nothing! But guess anyway, isn't it fun?!\", \"I love your whole situation! All of it! Whatever it is!\"],\n    rain: [\"The sky's giving everyone a little wash, isn't it?!\", \"I'm damp! You're damp! We have so much in common!\", \"Rain is just clouds being generous!\"],\n    snow: [\"It's snowing! It's so quiet! It's so *loud* how quiet it is, isn't it?!\", \"I caught one on my tongue. It tasted like my tongue!\"],\n    morning: [\"Good morning! It's my favourite time of day, and so is the next one!\", \"The sun's up! I'd like to thank it personally!\"],\n    night: [\"It's dark! I can't see anything! This is great, isn't it?!\", \"Stars! So many! They all showed up!\"],\n    spring: [\"Everything's a baby! The trees are babies! Look at their little leaves!\", \"Petals on everything! I've got one in my mouth! It's fine!\"],\n    summer: [\"It's so hot, isn't it?! I've gone slightly see-through!\", \"The bugs are singing! They're not very good! I love them!\"],\n    autumn: [\"The leaves are all falling and they look so brave, isn't it?!\", \"Autumn's just trees doing a big finish!\"],\n    winter: [\"My nose is cold! I didn't even know I had this much nose!\", \"Everything's asleep! Shhh! SHHHH! Sorry!\"],\n    absent: [\"You're back! I knew you'd come back! I told a stone and everything!\", \"I missed you so much I waved at your house. It's a good house!\"],\n    hungry: [\"I could eat! I could also not! Both are so nice, isn't it?!\", \"My tummy's talking! It says hi!\"],\n    love: [\"FOR ME?! Nobody's ever given me anything, today!\", \"I love it! What is it? I still love it!\"],\n    meh: [\"Oh wow! It's a thing! I've always wanted a thing!\", \"Thank you! I'm going to keep it next to my other thing!\"],\n    hate: [\"I love it! I love everything! It's really worrying, isn't it?!\"],\n    favour: [\"Could you find me {item}? I told it I'd see it soon, and I don't want to lie!\", \"I need {item}! I don't know why! Isn't that exciting?!\"],\n    thanks: [\"You did it! You're the best one! I'll tell the rock!\", \"Yay! Yay for you! Here's some beans! They're happy to see you too!\"],\n    letter: [\"DEAR {player}! HI! That's the whole letter! Love, Tavi!\", \"{player}! I saw a cloud shaped like a cloud! I thought of you! Tavi!\"],\n  },\n  grouch: {\n    greet: [\"You're standing in my good spot. No, there isn't another one. They're all my good spot. I'd prefer not.\", \"Oh. It's you. I was enjoying that.\", \"No. Whatever it is. I'd prefer not.\", \"That Tavi waved at me again. I've started leaving earlier.\", \"You've got laundry on your… no, that's me. Leave it.\", \"I had a thought this morning. It left. I respect that.\", \"Must we? I suppose we must. I'd prefer not.\", \"Say what you came to say. Shorter than that.\", \"You're the fourth person this week to perceive me.\", \"I'm not lonely. I've got a chair.\", \"If this is about the shirt on my antlers, it's mine now.\"],\n    rain: [\"Rain. At last, something that doesn't talk.\", \"Everyone's indoors. Best day of the year.\"],\n    snow: [\"Snow. It muffles people. I'd like more.\", \"Quiet out. Don't spoil it.\"],\n    morning: [\"It's morning. I'd prefer not.\", \"Too early for faces.\"],\n    night: [\"It's late. Even I've stopped complaining. Nearly.\", \"Nighttime. Nobody waves at night.\"],\n    spring: [\"Blossom. It gets in the good chair.\", \"Spring. Everything's so *eager*.\"],\n    summer: [\"Hot. Loud. Cicadas. I'd prefer not.\", \"Summer's just outdoors with the volume up.\"],\n    autumn: [\"Autumn's all right. Don't tell anyone.\", \"Things are dying back. Very restful.\"],\n    winter: [\"Pine smells best in the cold. That's all I have to say. Go on, then.\", \"Winter. Finally, everyone's quiet and a bit sad.\"],\n    absent: [\"You were gone. It was very peaceful. I noticed, is what I'm saying.\", \"Oh, you're back. I wasn't counting. It was nine days.\"],\n    hungry: [\"Dorrit keeps leaving soup at my door. It's very good. I'm furious.\", \"I could eat. I'd prefer not to tell anyone.\"],\n    love: [\"…Hm. It's not terrible. Don't make it a thing.\", \"I'll put this somewhere nobody'll see it. Somewhere I can look at it.\"],\n    meh: [\"What am I meant to do with this? Fine. Leave it.\", \"A gift. How exhausting.\"],\n    hate: [\"No. Take it back. I'd prefer not. I'd prefer so strongly not.\", \"It's *loud*. How is it loud? It's not even moving.\"],\n    favour: [\"You could get me {item}. Or you could not. I'd prefer you did, and that we never spoke of it.\", \"I need {item}. I'm not asking. I'm sighing near you.\"],\n    thanks: [\"Fine. Good. Here. Stop looking at me.\", \"That'll do. Take your beans. We're done being pleasant.\"],\n    letter: [\"{player}. Received your letter. Regrettably. Bartleby.\", \"No. Bartleby. (P.S. The thing you did was fine.)\"],\n  },\n  diva: {\n    greet: [\"I am technically the Duchess of this river, darling dear. Yes, that one. No, don't touch it.\", \"Ah, {player}. You may approach. Not that close.\", \"Stand up straight, darling dear. You're representing me by proximity.\", \"This? Oh, this is just my second-best tiara. It's also my only tiara.\", \"That Yolanda's wearing the scarf again. *The* scarf. I shan't discuss it. Ask me about it.\", \"I do so adore a commoner who knows when to stop talking.\", \"Mud is not what I live in, darling dear. Mud is what I *reside upon*.\", \"One's ancestors built this pond. With their faces.\", \"How refreshing, to meet someone with no expectations.\", \"I had pearls once. I've lost them in a very expensive way.\", \"You've a lovely little walk. Like a lovely little duck in trouble.\"],\n    rain: [\"The rain is doing wonders for my estate, darling dear.\", \"A lady never gets wet. She gets *dewy*.\"],\n    snow: [\"The snow is frightfully common, falling on just anyone.\", \"White was my colour first, darling dear.\"],\n    morning: [\"I don't do mornings, darling dear. They do me.\", \"Why are you awake? Whom does it serve?\"],\n    night: [\"Evening, darling dear. The moon and I have an arrangement.\", \"I look my best in poor lighting, and so do you.\"],\n    spring: [\"The blossom has copied my look, darling dear. I've written to it.\", \"Spring is so *obvious*.\"],\n    summer: [\"Summer is for the lower orders and me.\", \"I shall be at the river, being gazed at.\"],\n    autumn: [\"Autumn has such excellent colours for someone who's dying.\", \"Rust is back this season, darling dear. I never left it.\"],\n    winter: [\"Furs, darling dear! I'm already wearing mine. It's attached.\", \"The river's frozen. My lands are simply unavailable.\"],\n    absent: [\"You left without my permission, darling dear. I've had you portrayed unflatteringly.\", \"Ah. You've returned, and with that face. How brave.\"],\n    hungry: [\"I require something on a small plate, darling dear. Very small. Very far from Dorrit.\", \"A duchess never hungers. She *receives*.\"],\n    love: [\"At last, a gift that understands me. Darling dear, you may live.\", \"How exquisite. Whoever you stole it from has taste.\"],\n    meh: [\"How… sincere. I shall have it placed behind something.\", \"Thank you, darling dear. It will be remembered as having happened.\"],\n    hate: [\"Take it away. Burn the cart it came in. I don't care if there wasn't a cart.\", \"Is this meant to be funny? Was *I* meant to be funny?\"],\n    favour: [\"You might bring me {item}, darling dear. It would be an honour for you.\", \"I find myself without {item}. Correct this, and do it gracefully.\"],\n    thanks: [\"Adequate! Oh, don't blush. Here, a small fortune. Well. Small.\", \"You've pleased me, darling dear. It won't happen again.\"],\n    letter: [\"To {player}, of no fixed importance. You may write again. L.O.\", \"Darling dear. I read your note aloud to the river. It flowed away. Ottoline.\"],\n  },\n  gogetter: {\n    greet: [\"I rolled here! From over there! That's thirty metres of pure cardio, let's roll!\", \"Feel this shell! No, go on! That's discipline!\", \"You look like someone who skipped arms! Don't worry! Everyone's skipping something!\", \"I awarded myself a trophy this morning! For waking up! Let's roll!\", \"Nib did four press-ups yesterday! I did the rest of them!\", \"Stairs are a scam, {player}! Slopes! Think slopes!\", \"Protein! Have you had any?! You can't see it, but I'm having some now!\", \"I've been up since five! I've also been down since five! Reps!\", \"Every day's a chance to be slightly rounder!\", \"You're looking strong! Your left half! Let's work on it!\", \"No pain, no pain! I've never understood the saying! Let's roll!\"],\n    rain: [\"Rain's just free resistance training! Let's roll!\", \"Wet roads! That's speed! That's *dangerous* speed!\"],\n    snow: [\"I rolled through a snowdrift and came out a snowball! New personal best!\", \"Cold's good for the plates! Let's roll!\"],\n    morning: [\"Morning! Second breakfast is in ten! Get some miles in!\", \"The early bird gets the gains, {player}!\"],\n    night: [\"Night training! Can't see the finish line, so it can't stop me!\", \"Rest day's for the weak! I'm resting! Very hard!\"],\n    spring: [\"Spring! New season, new me, same me, stronger!\", \"Time to roll off that winter shell!\"],\n    summer: [\"Summer body! It's the same as my other body! Peak condition!\", \"Hot! Sweat's just your armour leaking! Let's roll!\"],\n    autumn: [\"Leaf piles! Great for landing! Bad for the leaves!\", \"Rolling season! Everything's downhill if you commit!\"],\n    winter: [\"Winter bulk! Eat everything! Then eat the plate! For iron!\", \"Ice! Zero friction! I've never been so free!\"],\n    absent: [\"Where've you been?! I trained your spot in your absence!\", \"You took days off! From what?! From what I do! Let's roll!\"],\n    hungry: [\"Got any fish? Fish is protein! I've had eleven! Let's roll!\", \"I'm in a calorie deficit of about four minutes!\"],\n    love: [\"YES! That's the stuff! That's going straight in the shell!\", \"Now THAT'S a gift with biceps! Let's roll!\"],\n    meh: [\"Great! Could you lift it, though? Try lifting it! I'll lift it!\", \"Thanks! I'll curl it!\"],\n    hate: [\"Is it cosy? I can't be cosy, {player}! Cosy is where they get you!\"],\n    favour: [\"Sprint and get me {item}! I'd do it myself, but it's leg day, and also arm day!\", \"Find me {item}! Fast! Timer's running! There's no timer! Let's roll!\"],\n    thanks: [\"New record! I don't know for what! Here, beans! Carbs!\", \"You came through! Good form! Terrible posture, good form!\"],\n    letter: [\"{player}! Did you do your rolls today?! Rocco.\", \"TRAINING TIP: don't stop! Rocco. (P.S. Nib's fine. Nib's lying down.)\"],\n  },\n  dreamer: {\n    greet: [\"I wrote you a poem. It's about your hat. It ends badly, or so the moon says.\", \"Did you ever think we're all just someone's loose paper? …or so the moon says.\", \"I was looking at a beetle and it looked back and now we've both changed.\", \"Hello, {player}. You arrived before you got here. I saw it in my tea.\", \"Rocco made me run. I saw my own ghost. It looked rested.\", \"Everything's connected. Mostly by string, in Ozzie's house.\", \"Your shadow's nice. Tell it I said so. It won't tell you.\", \"I've been awake since the concept of Tuesday.\", \"If a bug falls in the woods, I'm usually there. Writing it down.\", \"I had a dream you owed the sea money. …or so the moon says.\", \"Shh. No, nothing. I just like saying shh.\"],\n    rain: [\"Each drop is a very small attempt, …or so the moon says.\", \"The rain knows your name. It's not interested.\"],\n    snow: [\"Snow's the sky's handwriting. It's illegible.\", \"Every snowflake's different, and none of them have written back.\"],\n    morning: [\"Oh, it's morning? I'd only just finished last night.\", \"The sun's up and it's being very forward about it.\"],\n    night: [\"Look up. No, further. There. That's the Overdue Library Book.\", \"Night's when the moon gets a word in.\"],\n    spring: [\"Blossom falls because it trusts the ground, …or so the moon says.\", \"The bugs are back. They've brought their little questions.\"],\n    summer: [\"Fireflies. Each one's a tiny bad idea, briefly.\", \"It's too hot to be a person. I've been trying being a lemur.\"],\n    autumn: [\"The leaves let go. I wrote them a note. It's on the ground now too.\", \"Autumn makes me want to return a book I've never borrowed.\"],\n    winter: [\"The snow has covered up all my mistakes, …or so the moon says.\", \"It's so cold the stars are ringing. You can't hear it. That's the sad part.\"],\n    absent: [\"You were gone. I looked for you at the bottom of a cup.\", \"I wrote your absence down. It's a very long poem. There's nothing in it.\"],\n    hungry: [\"I think I forgot to eat in about March.\", \"Does soup count as a thought? Dorrit says yes.\"],\n    love: [\"Oh. Oh, this is for the book. It's all for the book.\", \"It's as if you'd read my mind. Please don't. There's a lot of moths.\"],\n    meh: [\"Mm. It has a certain thing-ness. I'll think about it for a year.\", \"Thank you. It'll go near the other unexplained objects.\"],\n    hate: [\"It's making a noise only I can hear. It's saying your name.\", \"No alarms, please. Is it an alarm? Everything's an alarm, if you listen.\"],\n    favour: [\"I need {item} for a poem. Or a poem for {item}. Either way, it's important, or so the moon says.\", \"Could you bring me {item}? I saw it in a dream, looking at me, with expectations.\"],\n    thanks: [\"The moon says thank you. I'd add something, but I've lost my pencil. Beans?\", \"It's perfect. It's all I'll ever need, until about four o'clock.\"],\n    letter: [\"{player}. The stars are out again. You were right. I'm not sure about what. Nib.\", \"A short poem: Hat. / Hat, why? / Hat. Your friend, Nib.\"],\n  },\n  schemer: {\n    greet: [\"Have you ever *seen* Mrs. Gander eat? No. Neither has anyone. You didn't hear it from me.\", \"Keep walking. Don't look at me. …Okay, now you can look.\", \"Who sent you? …Nobody? That's exactly what they'd send.\", \"The bus only comes when you're at the stop. Think about that. You didn't hear it from me.\", \"Eight thousand beans. For a shack. Who *are* the beans, {player}? Where do they go?\", \"I've got it all on the corkboard. It's mostly string now, but it's strong string.\", \"If I fall over, I'm not dead. If I fall over and you hear a whistle, run.\", \"That capybara's bee isn't a bee. Too well-informed.\", \"I had a box. Now I've got two boxes. That's how it starts.\", \"You seem trustworthy. That's what worries me.\", \"Never eat the cheese. Unless you want to. It's not poison. Yet. You didn't hear it from me.\"],\n    rain: [\"Rain's good cover. Who's watching? Nobody. *Exactly.*\", \"Why does it only rain on the ground? You didn't hear it from me.\"],\n    snow: [\"Footprints. Everywhere. Whoever did this wants us to know they walk.\", \"Snow's a cover-up. Literally. Look at it.\"],\n    morning: [\"Up early. So am I. Coincidence? I'm always up. I sleep in the day. Don't tell the day.\", \"Morning shift's just arrived at the goose's. Two of them. Same goose.\"],\n    night: [\"Nights are when the ledger gets updated. I've heard the scratching.\", \"Keep your voice down. Why are you talking? You weren't. Good.\"],\n    spring: [\"Blossom's a nice way of saying 'nobody look at the trees'.\", \"New flowers. Who ordered them? Check the invoice.\"],\n    summer: [\"The cicadas are a signal. Seventeen years, and then all at once. You tell me.\", \"Lanterns on the river. All going one way. Hmm.\"],\n    autumn: [\"Mushrooms in a ring. You don't get that by accident. You didn't hear it from me.\", \"Trees dropping evidence all over the place.\"],\n    winter: [\"The goose doesn't migrate. Ask yourself why she's got no need to.\", \"Whoever invented snowmen has a lot of explaining to do.\"],\n    absent: [\"You vanished for a while. I've put a pin in you. Literally. Corkboard.\", \"You're back. Say the code. Fine, there's no code. That's what they'd want you to think.\"],\n    hungry: [\"Got any cheese? Don't say it out loud.\", \"I eat in the dark. It's nobody's business what. It's cheese.\"],\n    love: [\"Yes. Good. Nobody saw you give me this. Nobody can know I like it.\", \"This'll go straight in the box. The *other* box.\"],\n    meh: [\"Interesting. Who gave you this to give me? …Yeah. Sure.\", \"I'll need to run some tests. I'll lick it.\"],\n    hate: [\"Clean. Too clean. Get it away from me. It's got no fingerprints.\", \"This is a wire, isn't it. *Hello, Mrs. Gander.*\"],\n    favour: [\"Bring me {item}. Don't ask questions. It's for the board. You didn't hear it from me.\", \"I need {item}. And then you were never here.\"],\n    thanks: [\"Good. Here's your cut. Small unmarked beans.\", \"You've done well. Burn this conversation.\"],\n    letter: [\"TIP: the goose has a second ledger. Burn this. — A Friend (Ozzie)\", \"{player}. They know. I don't know what. Do you? Write back in code. Ozzie.\"],\n  },\n  auntie: {\n    greet: [\"Hon, I knitted you a thing. Not sure what it is yet. Give it time, hon.\", \"Oh, you've got a nice face. Who did that to it? I'm joking, hon. Come here.\", \"You didn't hear this from me, hon, but you heard it from me.\", \"Ottoline's been saying things about my scarf. I've knitted a response.\", \"Have you got somebody? No? I know a very nice badger, hon.\", \"You're not wearing a vest. I can tell by how you're standing, hon.\", \"I was just talking about you, hon. All good. Mostly good. Sit down.\", \"That Bartleby. All that gloom, and a lovely pair of shoulders.\", \"Look at this wool, hon. It was on me this morning.\", \"I've made you a jumper. It has three arms. In case.\", \"Who's that you were talking to? And what did they say about me, hon?\"],\n    rain: [\"Wet wool, hon. That's the smell of love. And sheep. And me.\", \"Rain! Get in here. You'll catch something and I'll have to hear about it.\"],\n    snow: [\"Finally, a good excuse for the big scarf. Not *that* scarf, hon.\", \"I told you it'd snow. Nobody told me first. I'm very hurt.\"],\n    morning: [\"Early, hon! That's when you hear all the best news.\", \"Morning! Tell me everything. Start with what you've heard.\"],\n    night: [\"You should be in bed, hon. Who with, though? Only asking.\", \"Late, isn't it? I saw who else is up. I'll tell you. Sit down.\"],\n    spring: [\"Everyone's pairing off, hon. Even the pigeons. I've got a list.\", \"Time to shed, hon. I've got enough here for three cardigans.\"],\n    summer: [\"I'm too warm, hon. It's all me. There's a lot of me.\", \"Hot, isn't it? I've knitted a fan. It doesn't work, hon.\"],\n    autumn: [\"Now it's knitting weather. It's always knitting weather. But now people agree.\", \"All the gossip falls in autumn, hon. You just have to rake it.\"],\n    winter: [\"At last, hon. Everyone wants what I've got. It's me. I'm a jumper.\", \"Come here, you're cold. No, closer. You'll suffocate a bit, it's fine.\"],\n    absent: [\"Where've you been, hon? Everyone's been asking. It's only me that's been asking.\", \"You went off, and I had nobody to tell things to! I told Dorrit. She gave me soup.\"],\n    hungry: [\"I could murder a bun, hon. Not a real murder. I'd hear about it.\", \"Dorrit's feeding the whole town, hon, and who's feeding Dorrit? Dorrit.\"],\n    love: [\"Oh, hon. Oh, come here. Now I've got to knit you something.\", \"Now *that's* thoughtful. I'll tell everyone. I've already told everyone.\"],\n    meh: [\"Well, it's the thought that counts, hon. I'm thinking it was a thought.\", \"Isn't that nice. I'll put it with the other nice things in the shed.\"],\n    hate: [\"Hmm. Fancy, isn't it? Who are you trying to impress, hon? It wasn't me.\", \"Well. It's a look. Somebody's going to be told about this, hon.\"],\n    favour: [\"Be a love and find me {item}, hon. It's not for me. It's for a person. I can't say. It's me.\", \"I need {item}, hon. There's a story. Bring it and I'll tell you the story.\"],\n    thanks: [\"Oh, you are good, hon. I'll tell everyone. Here, beans. Don't tell anyone.\", \"That's lovely. I'll knit you something. No, it's fine, you don't get a say.\"],\n    letter: [\"Hon. I heard you got up to something. Write and tell me what. Love, Yolanda.\", \"Enclosed: a sock, hon. Other one when you visit. Y.\"],\n  },\n  hustler: {\n    greet: [\"Psst. Friend. You look like a person with beans. No refunds.\", \"Fitch. Fitch's Fine Everything. It's all in the boxes. Don't open the boxes.\", \"Nice house the last guy left, huh? I got it for a very reasonable story.\", \"You want a deal? I got a deal. It's a surprise. No refunds.\", \"Questions? No questions. That's the first thing I tell the customers.\", \"Moved in this morning, already have three debts. New personal best.\", \"Buy one, get one. That's all I'm saying. No refunds.\", \"You didn't see any ducks here. There are no ducks. Keep moving.\", \"I knew a guy. He's me. Great guy.\", \"Every box is a mystery, and the mystery is what's in the box, and it's soup.\", \"I like you. That's going to cost you.\"],\n    rain: [\"Rain! Umbrellas, half off. The other half's still up there somewhere.\", \"Damp's bad for the boxes. Everything must go. No refunds.\"],\n    snow: [\"Snow! I've got a whole shipment. Don't ask where I keep it.\", \"You want some of this snow? Slightly used.\"],\n    morning: [\"Early! Good! Early birds pay full price.\", \"Open since dawn, friend. Open is a strong word.\"],\n    night: [\"Late-night prices. They're the same, but I look at you differently.\", \"Nothing happens after dark, friend, if anyone asks.\"],\n    spring: [\"Spring sale! I found all these flowers. They were in the ground.\", \"New season, new stock, same boxes.\"],\n    summer: [\"Hot deals. The boxes are also hot. Don't touch the boxes.\", \"Sunscreen? It's mustard. It works for some.\"],\n    autumn: [\"Got my own leaves in, friend. Premium. Barely fallen.\", \"Fresh mushrooms! Fresh is a strong word.\"],\n    winter: [\"Hand warmers! They're my hands. Five beans a minute.\", \"Winter's when you can really sell a coat. Whose coat? No questions.\"],\n    absent: [\"You disappeared! A customer! I've kept your place in the queue. It's five hundred beans.\", \"Back, huh? I've been storing your stuff. I don't have your stuff. Storage is still owed.\"],\n    hungry: [\"Lunch is whatever's in box four. I've made my peace.\", \"You got food? I'll buy it. I'll sell it back.\"],\n    love: [\"Now we're talking. What's this worth? Don't tell me. I'll tell you.\", \"Oh, this I can move. I mean, I'll treasure it. No refunds.\"],\n    meh: [\"Sure, sure. It'll go in a box. Everything goes in a box.\", \"I can get four beans for this. From you, later.\"],\n    hate: [\"Junk? You're giving me junk? That's my line of work, friend.\", \"No market for it. Trust me. I tried to sell a market once.\"],\n    favour: [\"Get me {item}, friend. No questions. Mostly mine, but also yours.\", \"I got a buyer for {item}. I don't have {item}. See where you come in?\"],\n    thanks: [\"Pleasure doing business. Here's your cut. Count it later. Further away.\", \"You're all right. Here. No refunds. Those are the beans. They're non-refundable.\"],\n    letter: [\"DEAR VALUED CUSTOMER. You've won a box. Come and buy it. Fitch.\", \"{player}. Friend. Please stop asking what's in the boxes. Fitch.\"],\n  },\n};\nexport const UNIQUE = {\n  dorrit: [\"I fed the Mayor a bowl of soup in spring. He finished it this morning, mmhm.\", \"My mother had a pot. Her mother had the same pot. It's still not clean.\", \"Don't you tell Rocco, but I've been putting lard in his protein.\", \"I've never once tasted my own soup, mmhm. I'm afraid I'd stop.\", \"I set a place for Bartleby. He won't come. I set it anyway. It's for the place.\", \"It's Tuesday's. Tuesday was a good day for soup, mmhm.\", \"Pots are just bowls that believe in themselves.\", \"When I'm gone, bury me in stock. Not in the ground. Just in stock.\", \"Ottoline's never paid for a meal. I've never asked. We're both very proud of it.\", \"I can hear when a thing wants salt. It's a very lonely gift, mmhm.\", \"You've got your grandmother's appetite, I can tell. I've never met her. It's in the shoulders.\", \"That goose came in once and looked at my ledger. I don't have a ledger. She left me one.\"],\n  tavi: [\"I keep waving at Bartleby! One day he'll wave back, and I'll have to lie down!\", \"I have seventy-one best friends and one of them's a door!\", \"My house is yellow because I asked it what it wanted to be!\", \"People say I smile too much. It's just how my face is arranged! I'm actually very tired!\", \"I found a beetle on its back, and we talked for an hour, isn't it?!\", \"Do you think Mrs. Gander's happy? I sent her a card! She sent me an invoice! She's so thoughtful!\", \"I tried being sad once. I was so good at it!\", \"I named all the clouds! They've all left!\", \"When Rocco leaves I'm going to wave so hard, isn't it?!\", \"Sometimes I wake up at night and I'm still smiling, and it's a bit frightening!\", \"I love this town! I love the other towns! I haven't met them! I love them!\", \"Nib says everything ends! I said wow, even the good bits?! Nib said especially! Isn't that something?!\"],\n  bartleby: [\"That chair is a good chair. It has never once asked how I am.\", \"I've had this laundry on my antlers for six years. I don't know whose it is. I've grown to depend on it.\", \"Moose are solitary by nature. I read that somewhere quiet.\", \"I saw Tavi wave at a tree yesterday. The tree looked better for it. I'd prefer not to discuss it.\", \"Rocco's leaving, I hear. Good. Quiet. Good. …Good.\", \"I asked to be moved to a quieter town. This is the quieter town.\", \"Dorrit's soup. I've been leaving the bowls clean on her step. Never tell her it's me.\", \"I judged a snowman once. I said it was a snowman. They gave me a sash.\", \"I'd prefer not to be in the Mayor's way. He's been in mine since spring.\", \"Some people find pine smell soothing. I just find it's the only thing that doesn't want anything.\", \"I do know how to smile. I've seen it done.\", \"I had a good day once. I'm still recovering.\"],\n  ottoline: [\"The scarf was *mine*, darling dear. Ask anyone. Ask the moths. Yolanda stole it with her eyes.\", \"This rug has been in my family for nine generations, and six of them were moths.\", \"I once dined with an actual viscount. He was a pigeon, but one doesn't like to quibble.\", \"I have fallen, darling dear, but I have fallen *downstream*.\", \"My father was a very great platypus. He had a bill *this* big. I'm told it's rude to discuss.\", \"I lay eggs, you know. I don't discuss it. I merely let it be known.\", \"Do you know what's in a tiara? Tin. I've made my peace, and it's made of tin.\", \"They say I live in mud. I say the mud has never had it so good.\", \"The river's in my name. I've seen the paperwork. I drew it myself.\", \"Madame Mothwick ate my good hem. I forgave her publicly, which is far worse.\", \"I don't need friends, darling dear. Although, what time are you free?\", \"Mrs. Gander extended me credit in 1962. It's the only thing in this town older than I'm admitting to.\"],\n  rocco: [\"I've been the village champion nine years running! I also run the competition!\", \"This trophy's for Best Rocco! Tough field! Just me, but I was on form!\", \"Nib can do almost one sit-up now! Almost! That's a whole person's worth of almost!\", \"Stairs! Don't get me started! I got started once! I'm still at the bottom!\", \"I rolled to the lighthouse and back before breakfast! Then I rolled to breakfast!\", \"My mum said I could be anything! I'm a ball!\", \"I've thought about moving on, y'know. See some bigger hills. Let's roll, eventually.\", \"Bartleby's got great traps! Shoulders, I mean! He never lets me use them!\", \"If you stop rolling, you start thinking! And I tried that! No thanks!\", \"Dorrit's soup has really been working for me lately! Very dense!\", \"What's the point of being armoured if you never get hit by anything? I've been hit by a lot of trees!\", \"You know the secret to happiness? Me neither! Keep moving!\"],\n  nib: [\"The Overdue Library Book's rising early this year. Somebody's going to get fined.\", \"I don't have a home so much as a place where my paper's collected.\", \"Rocco made me do a press-up and I saw the whole of time. It was mostly floor.\", \"I've got a telescope. Mostly I look at the wrong end. It's more honest.\", \"The moon has never told me anything. I do all the talking. I just think it sounds better attributed.\", \"My tail's got seven rings. If you count from the other end it's still seven. I find that upsetting.\", \"I keep a list of everything I've ever lost. I've lost the list.\", \"Bugs are just thoughts with legs, and they've got somewhere to be.\", \"I've written you a poem. It's on one of these pages. It's about the time you waved.\", \"When I'm alone, I read to the alarm clock so it knows it's loved. Then I bury it.\", \"All the stars are dead, you know. They've just got very good post.\", \"If you wish on a shooting star, the star doesn't know. But the wish does.\"],\n  ozzie: [\"Mrs. Gander. Eight thousand beans. Goose. Beans. *Goose beans.* Think about it.\", \"I played dead for three days once. Nobody came. That's how I knew.\", \"That's not my house. That's where I keep the house I'm pretending is mine.\", \"Every town's got a Mrs. Gander. I've been to two. Same ledger. Same waistcoat.\", \"See this string? It connects the Mayor to the ribbon to the bee. I don't know why yet. It's a really good string.\", \"The bus driver sings. About *you*. How does she know? Exactly.\", \"I bought a cheese once. It's still out there. It's still appreciating.\", \"If anyone asks, I'm a different possum. There are hundreds of us. There aren't.\", \"The bell rings every hour. You know who else rings every hour? No. Nobody does. Suspicious.\", \"You ever noticed nobody here has a last name except when they owe money?\", \"Trust no one. Except me. No, not me either. Good. You're learning.\", \"I've seen the Museum's basement. It's got a very small second Museum in it. You didn't hear it from me.\"],\n  yolanda: [\"That scarf was a gift from my late Nan, hon, and if Ottoline says different she can knit her own face.\", \"I've knitted a cover for the television, hon. And for the telephone. And the other telephone.\", \"I knew your Gran, hon. Not personally. But I've read all her letters. You leave them out.\", \"I've got four sisters. They're all me, hon, but thinner.\", \"My hair does its own thing, hon. Last week it went to the shops.\", \"I know who's been leaving Dorrit's bowls clean, hon. I'm not saying. It's the moose.\", \"Nobody tells me anything! That's why I have to find out everything!\", \"Secrets are just gossip that hasn't met the right person, hon.\", \"If you ever want to know what you did, come and ask me, hon.\", \"Keep your ears warm. It's how the news gets in.\", \"I'm not nosy, hon. My nose is just the first bit of me to arrive.\", \"I'll miss Rocco, hon. All that rolling. You could set your clock by the dents.\"],\n  fitch: [\"This used to be the armadillo's house. I found a trophy behind the fridge. It's for sale. No refunds.\", \"Where'd I come from? Good question. Next question.\", \"I sold Clementine's bee a bigger drawer. Tough negotiator. Very direct.\", \"I have a licence for all this. It's in a box. It might be in the box.\", \"The goose and I have an understanding. I understand I should leave town by spring.\", \"I could get you a Moatosaur. A whole one. Bit of a smell. Don't ask.\", \"I'd give you my card, but it's someone else's.\", \"See, friend, what you owe is a number. And I love numbers. I've got several of my own.\", \"I've retired four times. Only once from the same town.\", \"You think I enjoy this? …I do. No refunds.\", \"Is that a Reply Slip? I don't know what that is. I'd pay a lot for one.\", \"People ask why I don't unpack. Friend, I've never once unpacked. It's a lifestyle, and it's very portable.\"],\n};\nexport const GOSSIP = [\n  \"{n1} told me {n2} snores in a minor key. I asked what key. She knew.\", \"Did you see {n1} at the store? Bought one spoon. *One.* Who's that for?\", \"{n1} and {n2} had words by the river. Short words, mostly. A lot of 'well'.\", \"I hear {n1} has been practising a smile in the window. It isn't going well.\", \"{n1} says the Mayor moved a whole foot yesterday. {n2} says that's a lie, and it was a slime trail.\", \"Somebody's been leaving soup bowls clean on Dorrit's step. {n1} thinks it's {n2}. I think it's love.\", \"{n1} owes {n2} a pie. It's been eleven years. It's a very big pie now.\", \"They say {n1} cried at the Museum. It was the fossils. She said it was the dust. It wasn't the dust.\", \"{n1} has taken up the accordion. Just holding it, so far.\", \"{n2} said a thing about {n1}'s hat, and {n1} heard, and now the hat's gone.\", \"Don't tell {n1}, but {n2} is planning a surprise for them. It's a bill.\", \"{n1} was seen buying a very big fish and pretending to have caught it.\", \"I saw {n1} on the bench, staring at the sea. For an hour. Then the sea looked away.\", \"{n1} says the bee gave her a look. {n2} says the bee gave *everyone* a look.\", \"{n1} tried one of Old Rind's cheeses. We've opened the windows.\", \"{n1} and {n2} aren't speaking. They've been waving, very coldly.\", \"{n1} claims to have seen a shooting star. {n2} claims it was {n1}'s own hair. There's been an inquiry.\", \"Heard {n1} tried to pay Mrs. Gander in compliments. She wrote them down and charged interest.\", \"{n1} has been talking to the Old Pear. It hasn't said anything back, and {n1} says that's fair.\", \"If you see {n1}, don't mention the ladder. If you see {n2}, *do* mention the ladder.\", \"{n1} wrote a letter to the sea. It got a reply. Nobody's seen it.\", \"{n1} has started wearing two left shoes for what they're calling 'reasons'.\", \"They do say {n1} once beat {n2} at cards. {n2} still hasn't put them down.\", \"{n1} has been feeding the pigeons. {n2} says it's the other way about.\", \"{n1} is telling everyone they're fine. Everyone. Very loudly. From the roof.\", \"Word is {n1} sold a chair to {n2}, then sat on it. It's a legal matter now.\", \"{n1} went to the City. Came back with a new walk. {n2} says it won't last, and it's already wearing off.\", \"{n1} has been asking about you. I said you were lovely. I lied, a bit. It's nice to have secrets.\", \"Someone's been at {n1}'s flowers. {n2} has been very quiet and very pollen-y.\", \"{n1} says she's over it. There's a knitted effigy says otherwise.\", \"{n1} has a theory about {n2}. It's got string in it now.\", \"The thing about {n1}, right, is you never know, is the thing. {n2} knows, but she's not saying.\",\n];\nexport const GANDER = {\n  greet: [\"No rush on the payment, dear. I've simply noted the time you didn't pay, and I'll be noting it again tomorrow.\", \"HONK. Pardon me. That was my indoor voice.\", \"Good morning. Or rather, it was a good morning, until the figures came in.\", \"Ah. My favourite debtor. Don't tell the others. They're also my favourite.\", \"You've come to pay, or you've come to browse. I shall bill you for whichever is more.\", \"Interest, dear? Oh, no. I charge no interest. I find you quite interesting enough.\", \"Wipe your feet. I'll add it to your account regardless.\", \"Every bean has a name, dear, and yours are all called Mrs. Gander.\", \"One does hope you're well. A healthy debtor is such a joy.\", \"I've looked over your ledger. I've looked over it twice. I shall look over it as long as we both shall live.\", \"That's a lovely outfit. Did you pay for it? Ah. I remember now. You didn't.\", \"HONK. Oh, excuse me. I've just seen your balance.\", \"I never forget a face, or a sum. I've forgotten your face.\", \"Don't mind me. I'm merely standing here. In a professional capacity. Near you.\", \"Yes, the waistcoat is new. No, it's not paid for by you. Not knowingly.\"],\n  pay: [\"Noted. In ink. You may breathe out.\", \"How punctual. How unlike you. I shall have it looked into.\", \"There. That's that off. The rest remains on, as it were.\", \"Lovely. Do come back. You will come back. It's in the terms.\"],\n  paidTier: [\"Paid in full! How thrilling. I've taken the liberty of having your house enlarged. You now owe me for that.\", \"All settled. Isn't it wonderful to be free? I've extended the terms on your freedom.\"],\n  final: [\"Paid. All of it. I… I don't know what to say. It's… it's a very nice… | HONK. Forget I said anything. Here. A deed. Gold edge. Get out of my shop. Come back tomorrow.\"],\n  buy: [\"An excellent choice. I'll say that to everybody. I say it now to you.\", \"Sold. Do try to keep it out of the rain. It's in the small print.\", \"Mind you don't drop it. I shan't be replacing it. I shan't even look.\", \"Would you like a bag? Of course not. There are no bags. There never were.\"],\n  sell: [\"I'll give you {item}'s worth, and not a bean more. I've counted.\", \"Hm. It's worth what it's worth. It's worth less now you've touched it.\", \"I can take that off your hands. Your hands look relieved.\", \"I'll give you this for it. It's a robbery. Yours, by me.\"],\n  gift: [\"A gift from a neighbour, is it? Well. I won't tell. I have, however, told.\", \"Selling a gift. Oh, how very practical. I shall let them know you were practical.\"],\n  closed: [\"We are closed, dear. Your debt, however, is open all night.\"],\n  hibernate: [\"Hibernating, are we? On *my* time? I'll keep your interest warm for you, dear. Sleep tight. I'll be noting it.\"],\n  misc: [\"I've never lost a bean. I once mislaid one. It came back with its friends.\", \"My late husband used to say, 'Whatever you say, dear.' I had that put on his invoice.\", \"The store's hours are posted. So is everything else. By me.\", \"The sign says Gander's. It always has. The sign is older than the building. Don't look into it.\"],\n};\nexport const HOSTS = {\n  clementine: [\"Your letter's stamped. A bee has been living in the stamp drawer. We've agreed to share.\", \"One moment. I'll just consult the bee. …She says it's fine.\", \"Everything's fine. It's always fine. Hurricanes are fine. I've checked.\", \"Would you like to make a deposit? Nobody's rushing. Nobody's ever rushed in here. We had a man rush once. He's still filling in the form.\", \"The Bean Jar pays half a percent. We are very interested.\", \"Lost and Found's in the corner. So far we've mostly found things. It's going very well.\", \"The bee likes you. Don't take it personally. She's like that with most pollen.\", \"Town rating? I can tell you. It'll be honest. You'll be fine. I'll be fine regardless.\", \"I have been behind this counter for thirty years. Before that, I was behind a different one. I prefer it here.\", \"Mail goes out in the morning and comes in at nine. That's the system. The bee designed it.\", \"I've seen a lot of people in a hurry. They all ended up here, in the queue, behind nobody.\", \"You seem stressed. Have a seat. There aren't any. It's all right. It's nice standing.\", \"Would you like to order from the catalogue? It's one card at a time. There's no rush at all, ever.\", \"The Mayor's sapling is coming on. So's the Mayor. Slightly.\", \"The Chime? Write what you like. It's been nothing but one note since the Mayor's cousin. We all liked it fine.\"],\n  trundle: [\"I declare this… ribbon… cut. Has anyone… seen… the ribbon? It was here… in March.\", \"Good… morning. Or… is it? I… began saying that… yesterday.\", \"I'm… on my way… to something. Very important. I can… almost see it.\", \"Vote for… Trundle. It's a… little late. The election… was in spring. Of… another year.\", \"A mayor must… move… with the people. The people… have moved on. I'll catch up.\", \"I've been… crossing this plaza… since before… you came. Don't… wait up.\", \"A shovel? Have mine… I was… going to dig… something. I forget… what.\", \"Please… don't… help. I must do this… alone. Also… you're standing… on my foot. All of it.\", \"Great… things… are coming… to this town. They… have passed me.\", \"My shell… is a family… home. It's… been a hard market.\", \"Mrs. Gander… holds the note… on the town hall. And the town. And… a bit… of me.\", \"When I… reach… that ribbon… you'll see… a *real*… speech.\", \"It's… important… to pace… yourself.\", \"Oh… is that… the sun? Already? Well… I'll have… another go.\", \"The ribbon… was blue. Or it… was a very long… time ago.\"],\n  quill: [\"Is it a fossil? It's a fossil! Or a very confident potato! Either way, it goes in the hall!\", \"Oh! A fish! Or a very wet boot! Hold it closer. Closer. That's my eye.\", \"Wonderful! I can't see it at all! Tell me what it looks like, and then I'll tell you what it is!\", \"I've catalogued it as a lamp. It may be a beetle. We'll know more when it moves.\", \"My glasses? I'm wearing them? Well then. That explains the state of the gallery.\", \"Science, my friend, is only being wrong with a label on it!\", \"I'm so happy! I'm going to roll! Don't mind me! I'm— I've rolled! Could somebody—\", \"The Moatosaur had a very small brain. We've got it in a jar. It might be a walnut.\", \"The Regretodon died of embarrassment, or a rock. Those are my two theories.\", \"Do mind the Aquarium. I've labelled it the Gallery. Nobody's complained. The fish look very well hung.\", \"Thank you, thank you! Your name goes on the plaque. Spell it for me. No, don't. It's already engraved.\", \"This painting's a masterpiece! Or a very flat cat!\", \"Everything here has been donated by somebody. Most of them meant to.\", \"I rolled into a ball at my own wedding. Lovely day, I'm told.\", \"It's not that I can't see the plaque. I just like to be surprised.\"],\n  mothwick: [\"Ahh, the *fabric*! Forgive me. I nibbled. I nibble when I'm nervous. I am always nervous.\", \"You have the shoulders of a coat-hanger. It is a compliment. I adore coat-hangers.\", \"This hem! It was whole when I woke. Who could have done this? I could have done this.\", \"Fashion is pain, darling, and pain is delicious, especially in wool.\", \"Try the blue. No! Not the blue! Oh, too late, you have seen the blue.\", \"I had a lamp once. We were very happy. I don't wish to speak of it.\", \"Pattern, you say? Sixteen squares by sixteen. It is all anyone needs. It is all I can chew.\", \"Ottoline's rug? I never touched it. I *visited* it. Often. With my mouth.\", \"Everything in this shop has a small hole in it. We call that *provenance*.\", \"You must draw yourself something. Then I shall sew it. Then I shall try very hard not to eat it.\", \"I can dress you for anything. Not for this, though. Nobody's ready for this.\", \"Your outfit has a kind of courage. Your outfit should see someone about it.\", \"One does not *wear* a hat, darling. One submits.\", \"Oh, this? It is my little scarf. It was a big scarf. It was a *very* good breakfast.\", \"Mothwick's is open! Mothwick is not ready! Come in! Go away! Come in!\"],\n  fleece: [\"Sit! Sit! Let Fleece look upon this… *situation* on your head.\", \"Hair is the only thing on you that grows without asking. Respect it.\", \"Do not move. I will know. The hair will tell me.\", \"Who cut this last? No, do not tell me. I will only have to go and see them.\", \"Mine? Oh, this is natural. It is also insured. It is also *armed*.\", \"One piece of gossip per cut, this is the rule. So: {gossip}\", \"The tips, they are dry. So is your manner. I can only fix one.\", \"You want it short? You want it long? You want it *true*. I can see it.\", \"They say the Mayor had hair. They say it left him. He is still walking after it.\", \"Voilà. You are welcome. You may cry, it is good for the conditioner.\", \"I have cut the hair of dukes. One duke. He was a sheep. It was a very busy day.\", \"It's not a salon, it's a confessional with scissors.\", \"Do you know what I hear, in this chair? Everything. Do you know what I repeat? Also everything.\", \"Colour? Darling, your colour is 'recently frightened'. We can work with it.\", \"Do not touch it for one week. If it rains, go home. If it rains at home, God help you.\"],\n  flavia: [\"Darling. Stand in better lighting. No. Further. Keep going.\", \"I can't see you, darling. There's a rope. It's velvet. It's mostly a feeling.\", \"Today's theme is: {theme}. Try to have understood that.\", \"I stand on one leg because the other one is for looking at.\", \"Is that a shirt? Who told you it was a shirt?\", \"Pink is not a colour. It's a warning. I am a warning.\", \"Couture is what happens when nobody says no. I've made sure nobody says no.\", \"Hm. Hm. Hmm. That's three hms. You've never had three.\", \"Turn around. Slowly. No, you've lost me. Turn back.\", \"The look is… *a* look. It's looking at me. Make it stop.\", \"One plume. It's a very small plume. Treasure it.\", \"Five plumes! I'm so moved I'm almost standing on both feet.\", \"You may come past the rope when you've earned it. It's a metaphor. It's also a rope.\", \"Everything on the rail costs more than your house. I've seen your house.\", \"Don't thank me. Don't speak. Don't exhale near the silk.\"],\n  magda: [\"One hundred percent genuine, and only forty percent stolen.\", \"That one? That's an original. I watched it being made. Fresh this morning.\", \"Lovely, innit? Look at the brushwork. Don't look *too* close at the brushwork.\", \"Shiny thing? No. No shiny things in here, Officer. Oh, it's you.\", \"Whichever one you like, I've got another in the back. Also the original.\", \"I don't do refunds. I do apologies. They're extra.\", \"It's night. It's an alley. What did you expect, a receipt?\", \"You look like someone who appreciates art, and doesn't look closely at it.\", \"Compare it with your catalogue if you like. It's your eyes against mine, and I've got two very quick eyes.\", \"That's the Mona Llama. There's nine in the world. There's four in here.\", \"I'd like you to know, I'm a very honest magpie. I'd like *you* to know that. Don't tell anyone else.\", \"What's that behind me? A curtain. What's behind the curtain? A shorter curtain.\", \"I found that spoon. I'd say it's mine. Whose spoon is it, then? See?\", \"No touching. No breathing on it. It's still wet. I mean, it's very old.\", \"I got a good eye, me. It's in that jar.\"],\n  bellows: [\"Friends! Countrymen! Whoever you are! Lend me your… that's a nice hat. Lend me that.\", \"I once played a tree in Vienna. The tree received a better review.\", \"The theatre! Where else may a hippopotamus die so beautifully, eight times a week?\", \"A short sketch this evening. Do laugh at the end. You will know the end because I will stop.\", \"Art is suffering. I've suffered through all my own art.\", \"My Hamlet was described as 'large'. I've had that printed on the posters.\", \"Watch closely. You may learn something. It's how to laugh, and it's frankly overdue.\", \"I never forget a line. I sometimes forget which play.\", \"I shall need complete silence, followed by uproar.\", \"When I was young, I was told I had great presence. It's because I was standing in the way.\", \"I've never had stage fright. The stage has had me.\", \"Ah, a discerning patron! Or just someone seeking shelter! Either way!\", \"They say the show must go on. It's been on since Tuesday. I have asked them to stop saying that.\", \"One bow, or two? Five. It's a five-bow crowd. It's a crowd of you.\", \"Exit, pursued by my agent.\"],\n  pemberton: [\"Lot-one-going-going-oh-it's-you-do-sit-down-do-not-wave-you've-just-bid.\", \"Yes-yes-welcome-three-lots-today-hidden-limits-open-paddles-no-sudden-movements.\", \"I-speak-quickly-because-time-is-beans-and-beans-are-beans.\", \"Do-you-have-something-to-consign-leave-it-with-me-result-by-post-commission-is-modest-and-mine.\", \"That-gentleman-at-the-back-is-a-coat-stop-bidding-against-him.\", \"Going-once-going-twice-gone-to-the-otter-in-the-damp-hat.\", \"It's-a-fine-piece-very-old-or-new-I-haven't-looked.\", \"My-mother-sold-me-at-auction-she-got-a-very-good-price-we're-very-close.\", \"Paddle-up-paddle-down-that's-all-there-is-to-life.\", \"Sleep? Yes-I-sleep-every-winter-for-four-months-it's-the-only-way-to-catch-up.\", \"If-you-scratch-your-nose-you-own-a-chair.\", \"Sold-sold-sold-oh-sorry-I-was-dreaming.\", \"No-returns-no-regrets-some-regrets-mostly-regrets.\", \"We've-a-lovely-lot-of-lots-today-the-lots-are-lovely.\", \"One-moment-while-I-catch-my-breath-there-I-caught-it-sold-it.\"],\n  brisket: [\"Brisket. Better Burrows Bureau. I've seen your home. We need to talk about your chairs.\", \"Too many chairs. Who are you expecting?\", \"Item: one lamp, unrelated to any seat. Why does it hate the seat?\", \"The Bureau does not have feelings. The Bureau has a form for feelings.\", \"Your floor is doing a lot. Your walls are doing the opposite. Have they spoken?\", \"We rate on Show Day nights. You won't see us. We've been in your cupboard.\", \"Four matching pieces is a set. Three is an accident. Two is a cry for help.\", \"Something growing, a lamp by a seat, a rug under a table. These are not rules. They're the law.\", \"Clutter isn't a style. I've checked. It's on the list of things that aren't.\", \"Grade S? I've given one. She cried. So did the house.\", \"Music makes a home, the form says. I'm told I enjoyed it.\", \"Do you know what your home says about you? It says 'help'. In a very nice font.\", \"I don't judge, I grade. Judging would imply I cared how you felt about it.\", \"The Bureau thanks you for your cooperation. Your cooperation has been noted, and it's a C.\", \"I've lived in the same burrow forty years. Nobody's rated it. Nobody'd dare.\"],\n  lou: [\"…Hi.\", \"…Coffee?\", \"…Yeah.\", \"…Mm.\", \"…Blend… one… two… three…\", \"…Slow… day…\", \"…It's… fine…\", \"…You… rushed… here…\", \"…Sit…\", \"…Nice…\", \"…Tuesday…?\", \"…Foam…\", \"…Later…\", \"…Ah…\", \"…Good… one…\"],\n  nibbles: [\"I see a tall stranger. He's holding… (chew) …that part's gone now. Good luck, though.\", \"Sit, sit. Cut the cards. Don't cut them too small, I've only just had lunch.\", \"The Tower! A very bad— (chew) —mmph. Delicious. Forget about the Tower.\", \"The stars say… I ate the stars. They were on the card.\", \"Your future holds a great journey, or a great gravy. I've smudged it.\", \"I've been reading the cards for forty years. Eating them for forty-one.\", \"Beware of… hm. It's the corner. It's always the corner that's nicest.\", \"Your fortune's in your hand. Oh! May I? …That was your receipt.\", \"The Hanged Man means change. The Fool means you. They're both a bit chewy.\", \"You will meet someone. They'll be fine. I had most of the rest.\", \"Love's in your future, or lava. I'd stay flexible.\", \"I see water. I see fish. I see— (chew) —mm. Lot of salt in that one.\", \"Cards don't lie. They don't anything, once I'm done with them.\", \"That's the reading. If you want the other half, it'll be out by Thursday.\", \"Don't look at me like that. It's a very old and very digestive art.\"],\n  hester: [\"End of the line? Nobody gets off there on purpose.\", \"Fare's listening. Sit where you like. They're all the same seat.\", \"Hold on. It's a bumpy road, and I've written a song about it.\", \"I only drive the bus. I sing because nobody can stop me.\", \"City's ahead. Don't touch anything, and if you do, I'd like to hear about it.\", \"Home again, then. It'll have noticed.\", \"Twenty-two years on this route, and the road's never once said thank you.\", \"You look like you've got something on your mind. I'll put it in a verse.\", \"That's a nice thing you did with your face.\", \"My mother was a llama, and her mother, and we've all been very firm about it.\", \"Mind the step. There's no step. Mind it anyway.\", \"The bus doesn't run to a schedule. It runs to a tune.\", \"I've got a verse about you already. It rhymes with 'debt'.\", \"Next stop, whatever's next.\", \"Not a word about my hat, and I'll say nothing about your whole situation.\"],\n  vesper: [\"Sit anywhere, friend. I'd offer you a chair, but I'm using the ceiling.\", \"I hang like this because that's how the notes fall out.\", \"What's your mood? I've got six. They're all a bit like this one.\", \"I learned accordion upside down. Now the right way up I can only play regrets.\", \"That one's about the bus. They're all about the bus.\", \"Don't clap. Just sway. It keeps me from swaying alone.\", \"The record's yours. Put it on when the house is too quiet to be funny.\", \"I only play on Show Days. The rest of the week, I'm a lamp.\", \"Everybody's got a song. Yours has a lot of owing in it.\", \"Lean in, friend. I don't play loud. I play near.\", \"I had a bigger accordion. It's in a very sad song now.\", \"Some nights it's just me and the moths, and the moths want requests.\", \"Don't look at my feet. Yes, I know. I know where they are.\", \"You came back. That's nice. Most songs don't get that.\", \"This next one's in a major key. I'm so sorry.\"],\n  rind: [\"Psst. Wheel of cheese? It only goes up. Mostly. Until it goes off.\", \"It's not gambling if it's dairy.\", \"Buy now. Sell by Friday. If it's Saturday, I don't know you.\", \"Word on the board is it's rising. Could be falling. Could be wobbling. It's cheese.\", \"I've seen fortunes made in cheese. I've seen them run off in the night, smelling terrible.\", \"See the goose. She'll buy it. Don't tell her where you got it. She knows.\", \"Every Market Day morning, right here. If you see me any other day, you don't.\", \"You want the sharp or the mature? It's the same cheese. It's just seen some things.\", \"Fresh as you like. Fresh as *it* likes.\", \"Hold your nerve, friend. Hold your nose, later.\", \"My grandfather started with one wheel. He's in that one. Not for sale.\", \"That smell? That's the market correcting.\", \"A cheese held is a cheese earned. A cheese held too long is a cheese that knows your name.\", \"Heh. You've got the look. A hungry, rind-y look.\", \"Sold. You didn't get it from me. There's nothing here. There's never been a stoat.\"],\n  pimm: [\n    \"Pimm. Department of Continuity. You left. No bed. No goodbye. Do you know what that does to a Tuesday?\",\n    \"We've noticed a gap in the record. You were here, and then you weren't. Do you think time just *does* that for free?\",\n    \"Pimm again. You've done it again. The cabinet has been rattling. I live in the cabinet. I'm the one rattling. | Do you have any idea how much paperwork there is in *nothing happening*? Please. Use the bed. Or Save and Quit. It's on the menu. I've seen it.\",\n    \"Pimm. It's me. I've stopped writing it down. | I have a very small filing cabinet and a very long list, and you're the only one on it. Everything was saved, you know. Nothing was ever lost. I just… | I just like to be told. That's all. Goodnight.\",\n    \"Filing… *scuttle scuttle*… Continuity is a very lonely department.\",\n    \"It's all in the cabinet. It's all saved. That isn't the point. That has never been the point.\",\n    \"Do not touch the second drawer. I live in the second drawer.\",\n    \"I'm a hermit crab. This was the only thing in my size that had a lock.\",\n    \"A day has a beginning, a middle and a bed. You'd know that if you'd gone on the course.\",\n    \"Don't apologise to me. Apologise to the Tuesday.\",\n    \"When you switch something off, *somebody* has to go round afterwards and put everything away.\",\n    \"Have you any notion how many Tuesdays I've had to refile?\",\n    \"I'd shake your hand, but I've only got claws, and you've only got a lot to answer for.\",\n    \"This has been noted. That's all it's been. But it's been very thoroughly noted.\",\n    \"Sleep well. Or don't. But *say*.\",\n  ],\n};\nexport const BALLAD = {\n  verses: [\"♪ Oh, you fished up a {catch} and you sold it for {price}, / and you'd do it, you'd do it, you'd do it again… ♪\", \"♪ There's a goose with a ledger who knows what you owe, / and it's {debt} beans now, and it's going real slow… ♪\", \"♪ You chased down a {bug} with your net in the sun, / and you held it up high like the thing you had won… ♪\", \"♪ You gave {neighbour} a {item}, oh you meant it so well, / and {neighbour} said thanks, and then went to sell… ♪\", \"♪ Oh, {player} rode in on a rainy old bus, / said, 'What town is this?' I said, 'It's one of us'… ♪\", \"♪ You sold it, you sold it, the thing that they knit, / and the whole of {town} knows, and it's knitting of it… ♪\", \"♪ Oh, you dug a big hole and you stood there a while, / found a {fossil} in there and you gave it a smile… ♪\", \"♪ There's a snail with a sash who is crossing the square, / he'll be cutting that ribbon if the ribbon's still there… ♪\", \"♪ Oh, {neighbour} was talking and {neighbour} was sad, / and you nodded and nodded, it wasn't too bad… ♪\", \"♪ You've got {pockets} things in your pockets today, / and not one of them's asked you to carry it that way… ♪\", \"♪ It's {season} back home and the {tree} are all bare, / or they're not, it's a song, I've no idea, I'm not there… ♪\", \"♪ You left in a hurry, you left in a rush, / you left {town} behind with a very slight blush… ♪\", \"♪ Oh, the fare is a song, and the song is a fare, / and the road goes on forward, and I'm always there… ♪\", \"♪ You owe and you owe and you owe, don't you know, / but the bus doesn't care, and the bus has to go… ♪\", \"♪ I knew someone like you, they got off at the sea, / they wrote me one letter, and that letter was me… ♪\", \"♪ There's a shack and a bed, there's a roof, more or less, / and a goose at your door in a nice waistcoat dress… ♪\", \"♪ You bought a new {item}, you wore it to town, / and the whole of {town} turned the corners back down… ♪\", \"♪ Your hair's a fine thing, it's a thing you could keep, / or there's somebody in town who'll give it a sweep… ♪\", \"♪ {neighbour} had a thing that they meant to say, / and they said it to a fish, and the fish swam away… ♪\", \"♪ Oh, you tried and you tried and you pulled up a weed, / and that's all that a person will ever much need… ♪\"],\n  chorus: [\"♪ So ride, ride, ride, on a bus to the end, / where the road's got a bend, and the bend's got a friend… ♪\", \"♪ And it's la-da-da-dum, and it's on we go, / to wherever it is, and I'd rather not know… ♪\", \"♪ Oh, the wheels go round, and they've gone round before, / and there's nothing to see, and I'm seeing some more… ♪\"],\n};\nexport const BEDTIME = [\"…Can't it wait? It's the middle of the night. I'm asleep. This is me, asleep.\", \"Who's that? No. Go home. Come back when it's a reasonable hour. Or don't.\", \"Mmph. I'm not in. I'm a recording of someone who isn't in.\", \"It's dark. Go to bed. You can knock tomorrow. You can also not.\"];\nexport const LETTER_REPLY = { name: \"You used my name! Nobody uses my name! I've kept that bit.\", short: \"You wrote '{snip}'. I framed it.\", long: \"That was a lot of letter. I read it to the end. I've had a lie-down.\", gift: \"And a gift! I'm keeping it. I've told everyone. Well, one person.\", none: \"Thanks for writing. Nobody writes. Well, people do, but not to me. Well, you did.\" };\nexport const GRAN_LETTERS = [\"Dear {player}. I hear you've got a house. I had a house. I'm sure yours is fine. Enclosed, some fruit, since nobody else is feeding you. Gran.\", \"{player}. Your cousin wrote to me. Twice. I'm only mentioning it. This fruit is from a very nice tree you've never visited. Gran.\", \"Dear {player}. It's cold here. Don't worry about me. Nobody has. Here's something inexplicable I found in the shed. Love, Gran.\", \"{player}. I told Doris you were doing well. She laughed. Doris is dead now, but it stung. Eat this. Gran.\"];\nexport const FESTIVAL_LINES = {\n  seedToss: [\"Fling your seeds at the chalk rings! Everybody! For ninety seconds! It's tradition, since last year!\", \"Whoever sows most, wins nothing! It's the principle!\"],\n  lantern: [\"Pick a colour, write a wish, and set it down on the river at the north bridge.\", \"They all drift to the sea. Nobody knows what the sea does with them. It's never said thank you.\"],\n  soup: [\"Bring three things. Fish, fruit, mushroom. Or a boot. We've had boot years. They were good years, mmhm.\", \"Everybody tastes. Everybody talks. It's not really about the soup.\"],\n  longNight: [\"The sun's gone at four. Carry the lights round, door to door. Everyone gets a string, and everyone gets you.\", \"At midnight, the Old Pear lights up, and the Bell plays your tune. Yes, yours. Sorry.\"],\n};\nexport const COUNT_LINES = () => { let n = 0; const walk = (o) => { if (Array.isArray(o)) { for (const x of o) typeof x === 'string' ? n++ : walk(x); } else if (o && typeof o === 'object') for (const v of Object.values(o)) { if (typeof v === 'string') n++; else walk(v); } }; walk(TYPE_LINES); walk(UNIQUE); walk(GOSSIP); walk(GANDER); walk(HOSTS); walk(BALLAD); walk(BEDTIME); walk(LETTER_REPLY); walk(GRAN_LETTERS); walk(FESTIVAL_LINES); return n; };\nE\nnode -e \"import('./src/data/lines.js').then(m=>{console.log(m.COUNT_LINES())})\"; cat >> ../PROGRESS.md <<'E'\nDone: data/cast, data/lines (writing). Next: state.js + systems + game.js.\nE","description":"Write cast and dialogue banks"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10191,"cache_read_input_tokens":282570,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10191},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f147b5a-afdb-41c5-bbfc-62264f8c7cee","uuid":"dce70b7c-afbf-49ff-af86-2fcd46354df5","timestamp":"2026-11-06T00:44:28.444Z","request_id":"req_011CgkjvgWQkqGpu9P8XrkYp","wire_tool_inputs":{"toolu_01Vrrg4FbGmEDrAvTK6dvpeR":{"command":"cat > src/data/cast.js <<'E'\n// Everyone with a name: how they look (critter generator options) and how they sound.\nconst V = (arch, pitch, speed = 1, lilt = 1) => ({ arch, pitch, speed, lilt });\nexport const CAST = {\n  dorrit: { name: 'Dorrit', type: 'hearth', tic: 'mmhm', look: { species: 'wombat', c1: 'orange', c2: 'sand', shirt: 'red', trousers: 'orange', shoes: 'plum' }, voice: V(1, -5, 0.9) },\n  tavi: { name: 'Tavi', type: 'sunshine', tic: \"isn't it?!\", look: { species: 'quokka', c1: 'sand', c2: 'white', shirt: 'lime', trousers: 'sand', shoes: 'orange' }, voice: V(0, 6, 1.2, 1.4) },\n  bartleby: { name: 'Bartleby', type: 'grouch', tic: \"I'd prefer not.\", look: { species: 'moose', c1: 'plum', c2: 'orange', shirt: 'slate', trousers: 'plum', shoes: 'ink' }, voice: V(2, -9, 0.75, 0.5) },\n  ottoline: { name: 'Lady Ottoline', short: 'Ottoline', type: 'diva', tic: 'darling dear', look: { species: 'platypus', c1: 'orange', c2: 'sand', shirt: 'plum', trousers: 'orange', shoes: 'sand' }, voice: V(3, 3, 0.95, 1.5) },\n  rocco: { name: 'Rocco', type: 'gogetter', tic: \"let's roll!\", look: { species: 'armadillo', c1: 'mist', c2: 'white', shirt: 'red', trousers: 'slate', shoes: 'white' }, voice: V(4, 0, 1.25, 1.1) },\n  nib: { name: 'Nib', type: 'dreamer', tic: '…or so the moon says', look: { species: 'lemur', c1: 'mist', c2: 'white', shirt: 'navy', trousers: 'mist', shoes: 'ink' }, voice: V(5, 4, 0.85, 1.3) },\n  ozzie: { name: 'Ozzie', type: 'schemer', tic: \"You didn't hear it from me.\", look: { species: 'possum', c1: 'slate', c2: 'white', shirt: 'ink', trousers: 'slate', shoes: 'ink' }, voice: V(2, 1, 1.15, 0.8) },\n  yolanda: { name: 'Yolanda', type: 'auntie', tic: 'hon', look: { species: 'yak', c1: 'orange', c2: 'sand', c3: 'orange', shirt: 'blue', trousers: 'plum', shoes: 'ink' }, voice: V(1, -3, 1, 1.2) },\n  fitch: { name: 'Fitch', type: 'hustler', tic: 'no refunds', look: { species: 'ferret', c1: 'sand', c2: 'white', shirt: 'teal', trousers: 'navy', shoes: 'ink' }, voice: V(4, 5, 1.35, 0.9) },\n  gander: { name: 'Mrs. Gander', type: 'host', look: { species: 'goose', c1: 'white', c2: 'white', shirt: 'navy', trousers: 'white', shoes: 'orange' }, voice: V(3, 1, 1, 0.7), honk: true },\n  clementine: { name: 'Clementine', type: 'host', look: { species: 'capybara', c1: 'orange', c2: 'sand', shirt: 'teal', trousers: 'orange', shoes: 'plum' }, voice: V(1, -6, 0.8, 0.4) },\n  trundle: { name: 'Mayor Trundle', type: 'host', look: { species: 'snail', c1: 'lime', c2: 'white', shirt: 'lime', trousers: 'lime' }, voice: V(5, -7, 0.45, 0.5) },\n  quill: { name: 'Dr. Quill', type: 'host', look: { species: 'pangolin', c1: 'orange', c2: 'sand', shirt: 'white', trousers: 'orange', shoes: 'plum' }, voice: V(0, 3, 1.15, 1.5) },\n  mothwick: { name: 'Madame Mothwick', short: 'Mothwick', type: 'host', look: { species: 'moth', c1: 'mist', c2: 'white', shirt: 'plum', trousers: 'plum', shoes: 'ink' }, voice: V(3, 2, 0.95, 1.6) },\n  hester: { name: 'Hester', type: 'host', look: { species: 'llama', c1: 'sand', c2: 'white', shirt: 'navy', trousers: 'navy', shoes: 'ink' }, voice: V(5, -2, 0.95, 1.2) },\n  vesper: { name: 'Vesper', type: 'host', look: { species: 'bat', c1: 'plum', c2: 'sand', shirt: 'ink', trousers: 'plum', shoes: 'ink' }, voice: V(5, 5, 0.9, 1.4) },\n  rind: { name: 'Old Rind', type: 'host', look: { species: 'stoat', c1: 'orange', c2: 'white', shirt: 'slate', trousers: 'orange', shoes: 'ink' }, voice: V(2, -1, 0.8, 0.5) },\n  pimm: { name: 'Inspector Pimm', short: 'Pimm', type: 'host', look: { species: 'crab', c1: 'red', c2: 'orange', shirt: 'red', trousers: 'red', shoes: 'red' }, voice: V(2, 3, 1.3, 0.3) },\n  fleece: { name: 'Monsieur Fleece', short: 'Fleece', type: 'host', look: { species: 'alpaca', c1: 'white', c2: 'white', c3: 'plum', shirt: 'ink', trousers: 'ink', shoes: 'ink' }, voice: V(3, 0, 1.05, 1.5) },\n  flavia: { name: 'Flavia Rosé', short: 'Flavia', type: 'host', look: { species: 'flamingo', c1: 'red', c2: 'white', shirt: 'red', trousers: 'red', shoes: 'sand' }, voice: V(3, 4, 0.9, 1.6) },\n  magda: { name: 'Magda', type: 'host', look: { species: 'magpie', c1: 'ink', c2: 'white', shirt: 'white', trousers: 'ink', shoes: 'ink' }, voice: V(2, 4, 1.1, 0.9) },\n  bellows: { name: 'Sir Reginald Bellows', short: 'Bellows', type: 'host', look: { species: 'hippo', c1: 'plum', c2: 'mist', shirt: 'navy', trousers: 'plum', shoes: 'ink' }, voice: V(1, -10, 0.8, 1.6) },\n  pemberton: { name: 'Pemberton', type: 'host', look: { species: 'dormouse', c1: 'sand', c2: 'white', shirt: 'teal', trousers: 'sand', shoes: 'ink' }, voice: V(0, 7, 2, 0.6) },\n  brisket: { name: 'Agent Brisket', short: 'Brisket', type: 'host', look: { species: 'badger', c1: 'white', c2: 'white', shirt: 'navy', trousers: 'navy', shoes: 'ink' }, voice: V(2, -5, 1, 0.3) },\n  lou: { name: 'Languid Lou', short: 'Lou', type: 'host', look: { species: 'sloth', c1: 'plum', c2: 'sand', shirt: 'orange', trousers: 'plum', shoes: 'plum' }, voice: V(1, -8, 0.4, 0.4) },\n  nibbles: { name: 'Madame Nibbles', short: 'Nibbles', type: 'host', look: { species: 'goat', c1: 'mist', c2: 'white', shirt: 'plum', trousers: 'mist', shoes: 'ink' }, voice: V(5, 1, 0.9, 1.3) },\n  you: { name: 'You', type: 'host', look: {}, voice: V(0, 0, 1, 1) },\n  gran: { name: 'Gran', type: 'host', look: {}, voice: V(1, 4, 1, 1) },\n  narrator: { name: '', type: 'host', look: {}, voice: V(5, 0, 1, 1), silent: true },\n};\nexport const NEIGHBOURS = ['dorrit', 'tavi', 'bartleby', 'ottoline', 'rocco', 'nib', 'ozzie', 'yolanda', 'fitch'];\nexport const STAFF_ROOM = { gander: 'store', clementine: 'hall', quill: 'museum', mothwick: 'mothwick', fleece: 'salon', flavia: 'couture', magda: 'magda', bellows: 'theatre', pemberton: 'auction', brisket: 'bureau', lou: 'cafe', nibbles: 'tent' };\nexport const nameOf = (id) => CAST[id]?.short ?? CAST[id]?.name ?? id;\nexport const LOVES = { dorrit: ['soup', 'food', 'fruit', 'mushroom', 'cosy'], tavi: ['flower', 'fruit', 'fish', 'bug', 'shell', 'loud', 'plain', 'clean'], bartleby: ['plain', 'wool', 'pine'], ottoline: ['fancy', 'shell', 'pearl', 'art'], rocco: ['fish', 'food', 'loud', 'practical'], nib: ['bug', 'evening', 'flower'], ozzie: ['cheese', 'city', 'junk'], yolanda: ['wool', 'cosy', 'flower'], fitch: ['bag', 'fancy', 'art', 'cheese'] };\nexport const HATES = { dorrit: ['loud'], tavi: [], bartleby: ['loud', 'fancy'], ottoline: ['junk', 'boot', 'practical'], rocco: ['cosy'], nib: ['loud', 'practical'], ozzie: ['clean'], yolanda: ['fancy'], fitch: ['junk'] };\nE\ncat > src/data/lines.js <<'E'\n// The writing. Warm, deadpan, gently absurd. `|` is a beat; *word* is emphasis; tags: {player} {town} {item} {neighbour} {catch} {tic}.\nexport const TYPE_LINES = {\n  hearth: {\n    greet: [\"You look peaky, mmhm. Have you eaten? That wasn't a question.\", \"Oh, {player}. Sit down. There's no chair, but sit down.\", \"I made too much. I always make too much, mmhm. It's a whole personality.\", \"There you are. I've been keeping something warm for you. It's me. I'm warm.\", \"Mind the pot. Mind the other pot. Mmhm. That's the good pot.\", \"Good to see you, dear. You've got a face like cold gravy.\", \"I was just saying to the stew, mmhm, I wonder how {player} is.\", \"Don't tell me you had a cold breakfast. I can smell it on you.\", \"You're thinner than Tuesday. Everyone's thinner than Tuesday.\", \"If you've come for the recipe, it's butter. It's always been butter, mmhm.\", \"Sit. Eat. Then you can tell me what's wrong. Then eat again.\"],\n    rain: [\"Rain's good for soup, mmhm. Don't ask me how. It just knows.\", \"Wet out. Come in. You're not in, I know, but come in, in spirit.\", \"Listen to that. That's the sky doing the washing-up.\"],\n    snow: [\"Snow's only rain that's had a nice sit-down, mmhm.\", \"Cold enough to set a stock. Lovely.\"],\n    morning: [\"Morning. Porridge is on. It's been on since Thursday.\", \"Up early, mmhm. Good. The pots have been asking after you.\"],\n    night: [\"It's late. Go home, eat something. In that order, or the other order.\", \"All the good soup's asleep by now, mmhm.\"],\n    spring: [\"Everything's sprouting. I've started eating it.\", \"Spring onions are in. So is spring. Coincidence, mmhm.\"],\n    summer: [\"Too hot for soup. I'm making it anyway. Principles.\", \"Cold soup is just a drink that gave up, mmhm.\"],\n    autumn: [\"Mushrooms are up in the woods. Most of them won't kill you.\", \"Now *this* is soup weather. It's always been soup weather, but now it's right.\"],\n    winter: [\"Keep your feet warm, mmhm. Your feet are where you keep your feelings.\", \"I've knitted a lid for the big pot. Don't tell Yolanda it's better than hers.\"],\n    absent: [\"Where've you been? There's nine portions of you in the freezer.\", \"You went away. I kept cooking for you. It's fine. I ate it. Mmhm.\"],\n    hungry: [\"Have you got anything I could put in a pot? Not you, dear. Not yet.\", \"I'm one ingredient short, mmhm. It's always one. It's never the same one.\"],\n    love: [\"Oh, you shouldn't have. Now I have to feed you. I was going to anyway.\", \"That's going straight in the pot. It's a compliment. Mmhm.\"],\n    meh: [\"Well. It's edible, or it isn't. We'll find out together, mmhm.\", \"I'll find a pot for it. I find a pot for everything.\"],\n    hate: [\"Ooh. That's loud. Could you take it outside? It's already outside. Further, then.\", \"Not in my kitchen, dear. Not in anyone's, mmhm.\"],\n    favour: [\"Be a dear, mmhm, and fetch me {item}? I've got both hands in a stew.\", \"I need {item}, and I need it before this thing boils over.\"],\n    thanks: [\"There's a good one. Here. It's beans, not soup. Don't look so surprised.\", \"Mmhm. You'll do. Have some beans. Have some soup. Have a sit.\"],\n    letter: [\"Dear {player}, I sent soup but it leaked. This is the part that didn't. Eat more. Dorrit.\", \"{player}, I heard you were thin. Stop it. Here. Love, Dorrit.\"],\n  },\n  sunshine: {\n    greet: [\"Hi hi hi! It's you! It's still you, isn't it?!\", \"I smiled at a rock today and I think it's going really well, isn't it?!\", \"You look great! You look like a person! That's so hard to do, isn't it?!\", \"I waved at Bartleby. He didn't wave back, so I waved for him. We're close!\", \"Oh my gosh, {player}! We've met before! What are the odds?!\", \"It's a beautiful day to be standing near you, isn't it?!\", \"I counted all my friends and it's everyone! Even the ducks!\", \"Did you know the sky goes all the way up? I checked! It's so committed!\", \"I was happy, and then you came over, and now I'm also happy!\", \"Guess what! Nothing! But guess anyway, isn't it fun?!\", \"I love your whole situation! All of it! Whatever it is!\"],\n    rain: [\"The sky's giving everyone a little wash, isn't it?!\", \"I'm damp! You're damp! We have so much in common!\", \"Rain is just clouds being generous!\"],\n    snow: [\"It's snowing! It's so quiet! It's so *loud* how quiet it is, isn't it?!\", \"I caught one on my tongue. It tasted like my tongue!\"],\n    morning: [\"Good morning! It's my favourite time of day, and so is the next one!\", \"The sun's up! I'd like to thank it personally!\"],\n    night: [\"It's dark! I can't see anything! This is great, isn't it?!\", \"Stars! So many! They all showed up!\"],\n    spring: [\"Everything's a baby! The trees are babies! Look at their little leaves!\", \"Petals on everything! I've got one in my mouth! It's fine!\"],\n    summer: [\"It's so hot, isn't it?! I've gone slightly see-through!\", \"The bugs are singing! They're not very good! I love them!\"],\n    autumn: [\"The leaves are all falling and they look so brave, isn't it?!\", \"Autumn's just trees doing a big finish!\"],\n    winter: [\"My nose is cold! I didn't even know I had this much nose!\", \"Everything's asleep! Shhh! SHHHH! Sorry!\"],\n    absent: [\"You're back! I knew you'd come back! I told a stone and everything!\", \"I missed you so much I waved at your house. It's a good house!\"],\n    hungry: [\"I could eat! I could also not! Both are so nice, isn't it?!\", \"My tummy's talking! It says hi!\"],\n    love: [\"FOR ME?! Nobody's ever given me anything, today!\", \"I love it! What is it? I still love it!\"],\n    meh: [\"Oh wow! It's a thing! I've always wanted a thing!\", \"Thank you! I'm going to keep it next to my other thing!\"],\n    hate: [\"I love it! I love everything! It's really worrying, isn't it?!\"],\n    favour: [\"Could you find me {item}? I told it I'd see it soon, and I don't want to lie!\", \"I need {item}! I don't know why! Isn't that exciting?!\"],\n    thanks: [\"You did it! You're the best one! I'll tell the rock!\", \"Yay! Yay for you! Here's some beans! They're happy to see you too!\"],\n    letter: [\"DEAR {player}! HI! That's the whole letter! Love, Tavi!\", \"{player}! I saw a cloud shaped like a cloud! I thought of you! Tavi!\"],\n  },\n  grouch: {\n    greet: [\"You're standing in my good spot. No, there isn't another one. They're all my good spot. I'd prefer not.\", \"Oh. It's you. I was enjoying that.\", \"No. Whatever it is. I'd prefer not.\", \"That Tavi waved at me again. I've started leaving earlier.\", \"You've got laundry on your… no, that's me. Leave it.\", \"I had a thought this morning. It left. I respect that.\", \"Must we? I suppose we must. I'd prefer not.\", \"Say what you came to say. Shorter than that.\", \"You're the fourth person this week to perceive me.\", \"I'm not lonely. I've got a chair.\", \"If this is about the shirt on my antlers, it's mine now.\"],\n    rain: [\"Rain. At last, something that doesn't talk.\", \"Everyone's indoors. Best day of the year.\"],\n    snow: [\"Snow. It muffles people. I'd like more.\", \"Quiet out. Don't spoil it.\"],\n    morning: [\"It's morning. I'd prefer not.\", \"Too early for faces.\"],\n    night: [\"It's late. Even I've stopped complaining. Nearly.\", \"Nighttime. Nobody waves at night.\"],\n    spring: [\"Blossom. It gets in the good chair.\", \"Spring. Everything's so *eager*.\"],\n    summer: [\"Hot. Loud. Cicadas. I'd prefer not.\", \"Summer's just outdoors with the volume up.\"],\n    autumn: [\"Autumn's all right. Don't tell anyone.\", \"Things are dying back. Very restful.\"],\n    winter: [\"Pine smells best in the cold. That's all I have to say. Go on, then.\", \"Winter. Finally, everyone's quiet and a bit sad.\"],\n    absent: [\"You were gone. It was very peaceful. I noticed, is what I'm saying.\", \"Oh, you're back. I wasn't counting. It was nine days.\"],\n    hungry: [\"Dorrit keeps leaving soup at my door. It's very good. I'm furious.\", \"I could eat. I'd prefer not to tell anyone.\"],\n    love: [\"…Hm. It's not terrible. Don't make it a thing.\", \"I'll put this somewhere nobody'll see it. Somewhere I can look at it.\"],\n    meh: [\"What am I meant to do with this? Fine. Leave it.\", \"A gift. How exhausting.\"],\n    hate: [\"No. Take it back. I'd prefer not. I'd prefer so strongly not.\", \"It's *loud*. How is it loud? It's not even moving.\"],\n    favour: [\"You could get me {item}. Or you could not. I'd prefer you did, and that we never spoke of it.\", \"I need {item}. I'm not asking. I'm sighing near you.\"],\n    thanks: [\"Fine. Good. Here. Stop looking at me.\", \"That'll do. Take your beans. We're done being pleasant.\"],\n    letter: [\"{player}. Received your letter. Regrettably. Bartleby.\", \"No. Bartleby. (P.S. The thing you did was fine.)\"],\n  },\n  diva: {\n    greet: [\"I am technically the Duchess of this river, darling dear. Yes, that one. No, don't touch it.\", \"Ah, {player}. You may approach. Not that close.\", \"Stand up straight, darling dear. You're representing me by proximity.\", \"This? Oh, this is just my second-best tiara. It's also my only tiara.\", \"That Yolanda's wearing the scarf again. *The* scarf. I shan't discuss it. Ask me about it.\", \"I do so adore a commoner who knows when to stop talking.\", \"Mud is not what I live in, darling dear. Mud is what I *reside upon*.\", \"One's ancestors built this pond. With their faces.\", \"How refreshing, to meet someone with no expectations.\", \"I had pearls once. I've lost them in a very expensive way.\", \"You've a lovely little walk. Like a lovely little duck in trouble.\"],\n    rain: [\"The rain is doing wonders for my estate, darling dear.\", \"A lady never gets wet. She gets *dewy*.\"],\n    snow: [\"The snow is frightfully common, falling on just anyone.\", \"White was my colour first, darling dear.\"],\n    morning: [\"I don't do mornings, darling dear. They do me.\", \"Why are you awake? Whom does it serve?\"],\n    night: [\"Evening, darling dear. The moon and I have an arrangement.\", \"I look my best in poor lighting, and so do you.\"],\n    spring: [\"The blossom has copied my look, darling dear. I've written to it.\", \"Spring is so *obvious*.\"],\n    summer: [\"Summer is for the lower orders and me.\", \"I shall be at the river, being gazed at.\"],\n    autumn: [\"Autumn has such excellent colours for someone who's dying.\", \"Rust is back this season, darling dear. I never left it.\"],\n    winter: [\"Furs, darling dear! I'm already wearing mine. It's attached.\", \"The river's frozen. My lands are simply unavailable.\"],\n    absent: [\"You left without my permission, darling dear. I've had you portrayed unflatteringly.\", \"Ah. You've returned, and with that face. How brave.\"],\n    hungry: [\"I require something on a small plate, darling dear. Very small. Very far from Dorrit.\", \"A duchess never hungers. She *receives*.\"],\n    love: [\"At last, a gift that understands me. Darling dear, you may live.\", \"How exquisite. Whoever you stole it from has taste.\"],\n    meh: [\"How… sincere. I shall have it placed behind something.\", \"Thank you, darling dear. It will be remembered as having happened.\"],\n    hate: [\"Take it away. Burn the cart it came in. I don't care if there wasn't a cart.\", \"Is this meant to be funny? Was *I* meant to be funny?\"],\n    favour: [\"You might bring me {item}, darling dear. It would be an honour for you.\", \"I find myself without {item}. Correct this, and do it gracefully.\"],\n    thanks: [\"Adequate! Oh, don't blush. Here, a small fortune. Well. Small.\", \"You've pleased me, darling dear. It won't happen again.\"],\n    letter: [\"To {player}, of no fixed importance. You may write again. L.O.\", \"Darling dear. I read your note aloud to the river. It flowed away. Ottoline.\"],\n  },\n  gogetter: {\n    greet: [\"I rolled here! From over there! That's thirty metres of pure cardio, let's roll!\", \"Feel this shell! No, go on! That's discipline!\", \"You look like someone who skipped arms! Don't worry! Everyone's skipping something!\", \"I awarded myself a trophy this morning! For waking up! Let's roll!\", \"Nib did four press-ups yesterday! I did the rest of them!\", \"Stairs are a scam, {player}! Slopes! Think slopes!\", \"Protein! Have you had any?! You can't see it, but I'm having some now!\", \"I've been up since five! I've also been down since five! Reps!\", \"Every day's a chance to be slightly rounder!\", \"You're looking strong! Your left half! Let's work on it!\", \"No pain, no pain! I've never understood the saying! Let's roll!\"],\n    rain: [\"Rain's just free resistance training! Let's roll!\", \"Wet roads! That's speed! That's *dangerous* speed!\"],\n    snow: [\"I rolled through a snowdrift and came out a snowball! New personal best!\", \"Cold's good for the plates! Let's roll!\"],\n    morning: [\"Morning! Second breakfast is in ten! Get some miles in!\", \"The early bird gets the gains, {player}!\"],\n    night: [\"Night training! Can't see the finish line, so it can't stop me!\", \"Rest day's for the weak! I'm resting! Very hard!\"],\n    spring: [\"Spring! New season, new me, same me, stronger!\", \"Time to roll off that winter shell!\"],\n    summer: [\"Summer body! It's the same as my other body! Peak condition!\", \"Hot! Sweat's just your armour leaking! Let's roll!\"],\n    autumn: [\"Leaf piles! Great for landing! Bad for the leaves!\", \"Rolling season! Everything's downhill if you commit!\"],\n    winter: [\"Winter bulk! Eat everything! Then eat the plate! For iron!\", \"Ice! Zero friction! I've never been so free!\"],\n    absent: [\"Where've you been?! I trained your spot in your absence!\", \"You took days off! From what?! From what I do! Let's roll!\"],\n    hungry: [\"Got any fish? Fish is protein! I've had eleven! Let's roll!\", \"I'm in a calorie deficit of about four minutes!\"],\n    love: [\"YES! That's the stuff! That's going straight in the shell!\", \"Now THAT'S a gift with biceps! Let's roll!\"],\n    meh: [\"Great! Could you lift it, though? Try lifting it! I'll lift it!\", \"Thanks! I'll curl it!\"],\n    hate: [\"Is it cosy? I can't be cosy, {player}! Cosy is where they get you!\"],\n    favour: [\"Sprint and get me {item}! I'd do it myself, but it's leg day, and also arm day!\", \"Find me {item}! Fast! Timer's running! There's no timer! Let's roll!\"],\n    thanks: [\"New record! I don't know for what! Here, beans! Carbs!\", \"You came through! Good form! Terrible posture, good form!\"],\n    letter: [\"{player}! Did you do your rolls today?! Rocco.\", \"TRAINING TIP: don't stop! Rocco. (P.S. Nib's fine. Nib's lying down.)\"],\n  },\n  dreamer: {\n    greet: [\"I wrote you a poem. It's about your hat. It ends badly, or so the moon says.\", \"Did you ever think we're all just someone's loose paper? …or so the moon says.\", \"I was looking at a beetle and it looked back and now we've both changed.\", \"Hello, {player}. You arrived before you got here. I saw it in my tea.\", \"Rocco made me run. I saw my own ghost. It looked rested.\", \"Everything's connected. Mostly by string, in Ozzie's house.\", \"Your shadow's nice. Tell it I said so. It won't tell you.\", \"I've been awake since the concept of Tuesday.\", \"If a bug falls in the woods, I'm usually there. Writing it down.\", \"I had a dream you owed the sea money. …or so the moon says.\", \"Shh. No, nothing. I just like saying shh.\"],\n    rain: [\"Each drop is a very small attempt, …or so the moon says.\", \"The rain knows your name. It's not interested.\"],\n    snow: [\"Snow's the sky's handwriting. It's illegible.\", \"Every snowflake's different, and none of them have written back.\"],\n    morning: [\"Oh, it's morning? I'd only just finished last night.\", \"The sun's up and it's being very forward about it.\"],\n    night: [\"Look up. No, further. There. That's the Overdue Library Book.\", \"Night's when the moon gets a word in.\"],\n    spring: [\"Blossom falls because it trusts the ground, …or so the moon says.\", \"The bugs are back. They've brought their little questions.\"],\n    summer: [\"Fireflies. Each one's a tiny bad idea, briefly.\", \"It's too hot to be a person. I've been trying being a lemur.\"],\n    autumn: [\"The leaves let go. I wrote them a note. It's on the ground now too.\", \"Autumn makes me want to return a book I've never borrowed.\"],\n    winter: [\"The snow has covered up all my mistakes, …or so the moon says.\", \"It's so cold the stars are ringing. You can't hear it. That's the sad part.\"],\n    absent: [\"You were gone. I looked for you at the bottom of a cup.\", \"I wrote your absence down. It's a very long poem. There's nothing in it.\"],\n    hungry: [\"I think I forgot to eat in about March.\", \"Does soup count as a thought? Dorrit says yes.\"],\n    love: [\"Oh. Oh, this is for the book. It's all for the book.\", \"It's as if you'd read my mind. Please don't. There's a lot of moths.\"],\n    meh: [\"Mm. It has a certain thing-ness. I'll think about it for a year.\", \"Thank you. It'll go near the other unexplained objects.\"],\n    hate: [\"It's making a noise only I can hear. It's saying your name.\", \"No alarms, please. Is it an alarm? Everything's an alarm, if you listen.\"],\n    favour: [\"I need {item} for a poem. Or a poem for {item}. Either way, it's important, or so the moon says.\", \"Could you bring me {item}? I saw it in a dream, looking at me, with expectations.\"],\n    thanks: [\"The moon says thank you. I'd add something, but I've lost my pencil. Beans?\", \"It's perfect. It's all I'll ever need, until about four o'clock.\"],\n    letter: [\"{player}. The stars are out again. You were right. I'm not sure about what. Nib.\", \"A short poem: Hat. / Hat, why? / Hat. Your friend, Nib.\"],\n  },\n  schemer: {\n    greet: [\"Have you ever *seen* Mrs. Gander eat? No. Neither has anyone. You didn't hear it from me.\", \"Keep walking. Don't look at me. …Okay, now you can look.\", \"Who sent you? …Nobody? That's exactly what they'd send.\", \"The bus only comes when you're at the stop. Think about that. You didn't hear it from me.\", \"Eight thousand beans. For a shack. Who *are* the beans, {player}? Where do they go?\", \"I've got it all on the corkboard. It's mostly string now, but it's strong string.\", \"If I fall over, I'm not dead. If I fall over and you hear a whistle, run.\", \"That capybara's bee isn't a bee. Too well-informed.\", \"I had a box. Now I've got two boxes. That's how it starts.\", \"You seem trustworthy. That's what worries me.\", \"Never eat the cheese. Unless you want to. It's not poison. Yet. You didn't hear it from me.\"],\n    rain: [\"Rain's good cover. Who's watching? Nobody. *Exactly.*\", \"Why does it only rain on the ground? You didn't hear it from me.\"],\n    snow: [\"Footprints. Everywhere. Whoever did this wants us to know they walk.\", \"Snow's a cover-up. Literally. Look at it.\"],\n    morning: [\"Up early. So am I. Coincidence? I'm always up. I sleep in the day. Don't tell the day.\", \"Morning shift's just arrived at the goose's. Two of them. Same goose.\"],\n    night: [\"Nights are when the ledger gets updated. I've heard the scratching.\", \"Keep your voice down. Why are you talking? You weren't. Good.\"],\n    spring: [\"Blossom's a nice way of saying 'nobody look at the trees'.\", \"New flowers. Who ordered them? Check the invoice.\"],\n    summer: [\"The cicadas are a signal. Seventeen years, and then all at once. You tell me.\", \"Lanterns on the river. All going one way. Hmm.\"],\n    autumn: [\"Mushrooms in a ring. You don't get that by accident. You didn't hear it from me.\", \"Trees dropping evidence all over the place.\"],\n    winter: [\"The goose doesn't migrate. Ask yourself why she's got no need to.\", \"Whoever invented snowmen has a lot of explaining to do.\"],\n    absent: [\"You vanished for a while. I've put a pin in you. Literally. Corkboard.\", \"You're back. Say the code. Fine, there's no code. That's what they'd want you to think.\"],\n    hungry: [\"Got any cheese? Don't say it out loud.\", \"I eat in the dark. It's nobody's business what. It's cheese.\"],\n    love: [\"Yes. Good. Nobody saw you give me this. Nobody can know I like it.\", \"This'll go straight in the box. The *other* box.\"],\n    meh: [\"Interesting. Who gave you this to give me? …Yeah. Sure.\", \"I'll need to run some tests. I'll lick it.\"],\n    hate: [\"Clean. Too clean. Get it away from me. It's got no fingerprints.\", \"This is a wire, isn't it. *Hello, Mrs. Gander.*\"],\n    favour: [\"Bring me {item}. Don't ask questions. It's for the board. You didn't hear it from me.\", \"I need {item}. And then you were never here.\"],\n    thanks: [\"Good. Here's your cut. Small unmarked beans.\", \"You've done well. Burn this conversation.\"],\n    letter: [\"TIP: the goose has a second ledger. Burn this. — A Friend (Ozzie)\", \"{player}. They know. I don't know what. Do you? Write back in code. Ozzie.\"],\n  },\n  auntie: {\n    greet: [\"Hon, I knitted you a thing. Not sure what it is yet. Give it time, hon.\", \"Oh, you've got a nice face. Who did that to it? I'm joking, hon. Come here.\", \"You didn't hear this from me, hon, but you heard it from me.\", \"Ottoline's been saying things about my scarf. I've knitted a response.\", \"Have you got somebody? No? I know a very nice badger, hon.\", \"You're not wearing a vest. I can tell by how you're standing, hon.\", \"I was just talking about you, hon. All good. Mostly good. Sit down.\", \"That Bartleby. All that gloom, and a lovely pair of shoulders.\", \"Look at this wool, hon. It was on me this morning.\", \"I've made you a jumper. It has three arms. In case.\", \"Who's that you were talking to? And what did they say about me, hon?\"],\n    rain: [\"Wet wool, hon. That's the smell of love. And sheep. And me.\", \"Rain! Get in here. You'll catch something and I'll have to hear about it.\"],\n    snow: [\"Finally, a good excuse for the big scarf. Not *that* scarf, hon.\", \"I told you it'd snow. Nobody told me first. I'm very hurt.\"],\n    morning: [\"Early, hon! That's when you hear all the best news.\", \"Morning! Tell me everything. Start with what you've heard.\"],\n    night: [\"You should be in bed, hon. Who with, though? Only asking.\", \"Late, isn't it? I saw who else is up. I'll tell you. Sit down.\"],\n    spring: [\"Everyone's pairing off, hon. Even the pigeons. I've got a list.\", \"Time to shed, hon. I've got enough here for three cardigans.\"],\n    summer: [\"I'm too warm, hon. It's all me. There's a lot of me.\", \"Hot, isn't it? I've knitted a fan. It doesn't work, hon.\"],\n    autumn: [\"Now it's knitting weather. It's always knitting weather. But now people agree.\", \"All the gossip falls in autumn, hon. You just have to rake it.\"],\n    winter: [\"At last, hon. Everyone wants what I've got. It's me. I'm a jumper.\", \"Come here, you're cold. No, closer. You'll suffocate a bit, it's fine.\"],\n    absent: [\"Where've you been, hon? Everyone's been asking. It's only me that's been asking.\", \"You went off, and I had nobody to tell things to! I told Dorrit. She gave me soup.\"],\n    hungry: [\"I could murder a bun, hon. Not a real murder. I'd hear about it.\", \"Dorrit's feeding the whole town, hon, and who's feeding Dorrit? Dorrit.\"],\n    love: [\"Oh, hon. Oh, come here. Now I've got to knit you something.\", \"Now *that's* thoughtful. I'll tell everyone. I've already told everyone.\"],\n    meh: [\"Well, it's the thought that counts, hon. I'm thinking it was a thought.\", \"Isn't that nice. I'll put it with the other nice things in the shed.\"],\n    hate: [\"Hmm. Fancy, isn't it? Who are you trying to impress, hon? It wasn't me.\", \"Well. It's a look. Somebody's going to be told about this, hon.\"],\n    favour: [\"Be a love and find me {item}, hon. It's not for me. It's for a person. I can't say. It's me.\", \"I need {item}, hon. There's a story. Bring it and I'll tell you the story.\"],\n    thanks: [\"Oh, you are good, hon. I'll tell everyone. Here, beans. Don't tell anyone.\", \"That's lovely. I'll knit you something. No, it's fine, you don't get a say.\"],\n    letter: [\"Hon. I heard you got up to something. Write and tell me what. Love, Yolanda.\", \"Enclosed: a sock, hon. Other one when you visit. Y.\"],\n  },\n  hustler: {\n    greet: [\"Psst. Friend. You look like a person with beans. No refunds.\", \"Fitch. Fitch's Fine Everything. It's all in the boxes. Don't open the boxes.\", \"Nice house the last guy left, huh? I got it for a very reasonable story.\", \"You want a deal? I got a deal. It's a surprise. No refunds.\", \"Questions? No questions. That's the first thing I tell the customers.\", \"Moved in this morning, already have three debts. New personal best.\", \"Buy one, get one. That's all I'm saying. No refunds.\", \"You didn't see any ducks here. There are no ducks. Keep moving.\", \"I knew a guy. He's me. Great guy.\", \"Every box is a mystery, and the mystery is what's in the box, and it's soup.\", \"I like you. That's going to cost you.\"],\n    rain: [\"Rain! Umbrellas, half off. The other half's still up there somewhere.\", \"Damp's bad for the boxes. Everything must go. No refunds.\"],\n    snow: [\"Snow! I've got a whole shipment. Don't ask where I keep it.\", \"You want some of this snow? Slightly used.\"],\n    morning: [\"Early! Good! Early birds pay full price.\", \"Open since dawn, friend. Open is a strong word.\"],\n    night: [\"Late-night prices. They're the same, but I look at you differently.\", \"Nothing happens after dark, friend, if anyone asks.\"],\n    spring: [\"Spring sale! I found all these flowers. They were in the ground.\", \"New season, new stock, same boxes.\"],\n    summer: [\"Hot deals. The boxes are also hot. Don't touch the boxes.\", \"Sunscreen? It's mustard. It works for some.\"],\n    autumn: [\"Got my own leaves in, friend. Premium. Barely fallen.\", \"Fresh mushrooms! Fresh is a strong word.\"],\n    winter: [\"Hand warmers! They're my hands. Five beans a minute.\", \"Winter's when you can really sell a coat. Whose coat? No questions.\"],\n    absent: [\"You disappeared! A customer! I've kept your place in the queue. It's five hundred beans.\", \"Back, huh? I've been storing your stuff. I don't have your stuff. Storage is still owed.\"],\n    hungry: [\"Lunch is whatever's in box four. I've made my peace.\", \"You got food? I'll buy it. I'll sell it back.\"],\n    love: [\"Now we're talking. What's this worth? Don't tell me. I'll tell you.\", \"Oh, this I can move. I mean, I'll treasure it. No refunds.\"],\n    meh: [\"Sure, sure. It'll go in a box. Everything goes in a box.\", \"I can get four beans for this. From you, later.\"],\n    hate: [\"Junk? You're giving me junk? That's my line of work, friend.\", \"No market for it. Trust me. I tried to sell a market once.\"],\n    favour: [\"Get me {item}, friend. No questions. Mostly mine, but also yours.\", \"I got a buyer for {item}. I don't have {item}. See where you come in?\"],\n    thanks: [\"Pleasure doing business. Here's your cut. Count it later. Further away.\", \"You're all right. Here. No refunds. Those are the beans. They're non-refundable.\"],\n    letter: [\"DEAR VALUED CUSTOMER. You've won a box. Come and buy it. Fitch.\", \"{player}. Friend. Please stop asking what's in the boxes. Fitch.\"],\n  },\n};\nexport const UNIQUE = {\n  dorrit: [\"I fed the Mayor a bowl of soup in spring. He finished it this morning, mmhm.\", \"My mother had a pot. Her mother had the same pot. It's still not clean.\", \"Don't you tell Rocco, but I've been putting lard in his protein.\", \"I've never once tasted my own soup, mmhm. I'm afraid I'd stop.\", \"I set a place for Bartleby. He won't come. I set it anyway. It's for the place.\", \"It's Tuesday's. Tuesday was a good day for soup, mmhm.\", \"Pots are just bowls that believe in themselves.\", \"When I'm gone, bury me in stock. Not in the ground. Just in stock.\", \"Ottoline's never paid for a meal. I've never asked. We're both very proud of it.\", \"I can hear when a thing wants salt. It's a very lonely gift, mmhm.\", \"You've got your grandmother's appetite, I can tell. I've never met her. It's in the shoulders.\", \"That goose came in once and looked at my ledger. I don't have a ledger. She left me one.\"],\n  tavi: [\"I keep waving at Bartleby! One day he'll wave back, and I'll have to lie down!\", \"I have seventy-one best friends and one of them's a door!\", \"My house is yellow because I asked it what it wanted to be!\", \"People say I smile too much. It's just how my face is arranged! I'm actually very tired!\", \"I found a beetle on its back, and we talked for an hour, isn't it?!\", \"Do you think Mrs. Gander's happy? I sent her a card! She sent me an invoice! She's so thoughtful!\", \"I tried being sad once. I was so good at it!\", \"I named all the clouds! They've all left!\", \"When Rocco leaves I'm going to wave so hard, isn't it?!\", \"Sometimes I wake up at night and I'm still smiling, and it's a bit frightening!\", \"I love this town! I love the other towns! I haven't met them! I love them!\", \"Nib says everything ends! I said wow, even the good bits?! Nib said especially! Isn't that something?!\"],\n  bartleby: [\"That chair is a good chair. It has never once asked how I am.\", \"I've had this laundry on my antlers for six years. I don't know whose it is. I've grown to depend on it.\", \"Moose are solitary by nature. I read that somewhere quiet.\", \"I saw Tavi wave at a tree yesterday. The tree looked better for it. I'd prefer not to discuss it.\", \"Rocco's leaving, I hear. Good. Quiet. Good. …Good.\", \"I asked to be moved to a quieter town. This is the quieter town.\", \"Dorrit's soup. I've been leaving the bowls clean on her step. Never tell her it's me.\", \"I judged a snowman once. I said it was a snowman. They gave me a sash.\", \"I'd prefer not to be in the Mayor's way. He's been in mine since spring.\", \"Some people find pine smell soothing. I just find it's the only thing that doesn't want anything.\", \"I do know how to smile. I've seen it done.\", \"I had a good day once. I'm still recovering.\"],\n  ottoline: [\"The scarf was *mine*, darling dear. Ask anyone. Ask the moths. Yolanda stole it with her eyes.\", \"This rug has been in my family for nine generations, and six of them were moths.\", \"I once dined with an actual viscount. He was a pigeon, but one doesn't like to quibble.\", \"I have fallen, darling dear, but I have fallen *downstream*.\", \"My father was a very great platypus. He had a bill *this* big. I'm told it's rude to discuss.\", \"I lay eggs, you know. I don't discuss it. I merely let it be known.\", \"Do you know what's in a tiara? Tin. I've made my peace, and it's made of tin.\", \"They say I live in mud. I say the mud has never had it so good.\", \"The river's in my name. I've seen the paperwork. I drew it myself.\", \"Madame Mothwick ate my good hem. I forgave her publicly, which is far worse.\", \"I don't need friends, darling dear. Although, what time are you free?\", \"Mrs. Gander extended me credit in 1962. It's the only thing in this town older than I'm admitting to.\"],\n  rocco: [\"I've been the village champion nine years running! I also run the competition!\", \"This trophy's for Best Rocco! Tough field! Just me, but I was on form!\", \"Nib can do almost one sit-up now! Almost! That's a whole person's worth of almost!\", \"Stairs! Don't get me started! I got started once! I'm still at the bottom!\", \"I rolled to the lighthouse and back before breakfast! Then I rolled to breakfast!\", \"My mum said I could be anything! I'm a ball!\", \"I've thought about moving on, y'know. See some bigger hills. Let's roll, eventually.\", \"Bartleby's got great traps! Shoulders, I mean! He never lets me use them!\", \"If you stop rolling, you start thinking! And I tried that! No thanks!\", \"Dorrit's soup has really been working for me lately! Very dense!\", \"What's the point of being armoured if you never get hit by anything? I've been hit by a lot of trees!\", \"You know the secret to happiness? Me neither! Keep moving!\"],\n  nib: [\"The Overdue Library Book's rising early this year. Somebody's going to get fined.\", \"I don't have a home so much as a place where my paper's collected.\", \"Rocco made me do a press-up and I saw the whole of time. It was mostly floor.\", \"I've got a telescope. Mostly I look at the wrong end. It's more honest.\", \"The moon has never told me anything. I do all the talking. I just think it sounds better attributed.\", \"My tail's got seven rings. If you count from the other end it's still seven. I find that upsetting.\", \"I keep a list of everything I've ever lost. I've lost the list.\", \"Bugs are just thoughts with legs, and they've got somewhere to be.\", \"I've written you a poem. It's on one of these pages. It's about the time you waved.\", \"When I'm alone, I read to the alarm clock so it knows it's loved. Then I bury it.\", \"All the stars are dead, you know. They've just got very good post.\", \"If you wish on a shooting star, the star doesn't know. But the wish does.\"],\n  ozzie: [\"Mrs. Gander. Eight thousand beans. Goose. Beans. *Goose beans.* Think about it.\", \"I played dead for three days once. Nobody came. That's how I knew.\", \"That's not my house. That's where I keep the house I'm pretending is mine.\", \"Every town's got a Mrs. Gander. I've been to two. Same ledger. Same waistcoat.\", \"See this string? It connects the Mayor to the ribbon to the bee. I don't know why yet. It's a really good string.\", \"The bus driver sings. About *you*. How does she know? Exactly.\", \"I bought a cheese once. It's still out there. It's still appreciating.\", \"If anyone asks, I'm a different possum. There are hundreds of us. There aren't.\", \"The bell rings every hour. You know who else rings every hour? No. Nobody does. Suspicious.\", \"You ever noticed nobody here has a last name except when they owe money?\", \"Trust no one. Except me. No, not me either. Good. You're learning.\", \"I've seen the Museum's basement. It's got a very small second Museum in it. You didn't hear it from me.\"],\n  yolanda: [\"That scarf was a gift from my late Nan, hon, and if Ottoline says different she can knit her own face.\", \"I've knitted a cover for the television, hon. And for the telephone. And the other telephone.\", \"I knew your Gran, hon. Not personally. But I've read all her letters. You leave them out.\", \"I've got four sisters. They're all me, hon, but thinner.\", \"My hair does its own thing, hon. Last week it went to the shops.\", \"I know who's been leaving Dorrit's bowls clean, hon. I'm not saying. It's the moose.\", \"Nobody tells me anything! That's why I have to find out everything!\", \"Secrets are just gossip that hasn't met the right person, hon.\", \"If you ever want to know what you did, come and ask me, hon.\", \"Keep your ears warm. It's how the news gets in.\", \"I'm not nosy, hon. My nose is just the first bit of me to arrive.\", \"I'll miss Rocco, hon. All that rolling. You could set your clock by the dents.\"],\n  fitch: [\"This used to be the armadillo's house. I found a trophy behind the fridge. It's for sale. No refunds.\", \"Where'd I come from? Good question. Next question.\", \"I sold Clementine's bee a bigger drawer. Tough negotiator. Very direct.\", \"I have a licence for all this. It's in a box. It might be in the box.\", \"The goose and I have an understanding. I understand I should leave town by spring.\", \"I could get you a Moatosaur. A whole one. Bit of a smell. Don't ask.\", \"I'd give you my card, but it's someone else's.\", \"See, friend, what you owe is a number. And I love numbers. I've got several of my own.\", \"I've retired four times. Only once from the same town.\", \"You think I enjoy this? …I do. No refunds.\", \"Is that a Reply Slip? I don't know what that is. I'd pay a lot for one.\", \"People ask why I don't unpack. Friend, I've never once unpacked. It's a lifestyle, and it's very portable.\"],\n};\nexport const GOSSIP = [\n  \"{n1} told me {n2} snores in a minor key. I asked what key. She knew.\", \"Did you see {n1} at the store? Bought one spoon. *One.* Who's that for?\", \"{n1} and {n2} had words by the river. Short words, mostly. A lot of 'well'.\", \"I hear {n1} has been practising a smile in the window. It isn't going well.\", \"{n1} says the Mayor moved a whole foot yesterday. {n2} says that's a lie, and it was a slime trail.\", \"Somebody's been leaving soup bowls clean on Dorrit's step. {n1} thinks it's {n2}. I think it's love.\", \"{n1} owes {n2} a pie. It's been eleven years. It's a very big pie now.\", \"They say {n1} cried at the Museum. It was the fossils. She said it was the dust. It wasn't the dust.\", \"{n1} has taken up the accordion. Just holding it, so far.\", \"{n2} said a thing about {n1}'s hat, and {n1} heard, and now the hat's gone.\", \"Don't tell {n1}, but {n2} is planning a surprise for them. It's a bill.\", \"{n1} was seen buying a very big fish and pretending to have caught it.\", \"I saw {n1} on the bench, staring at the sea. For an hour. Then the sea looked away.\", \"{n1} says the bee gave her a look. {n2} says the bee gave *everyone* a look.\", \"{n1} tried one of Old Rind's cheeses. We've opened the windows.\", \"{n1} and {n2} aren't speaking. They've been waving, very coldly.\", \"{n1} claims to have seen a shooting star. {n2} claims it was {n1}'s own hair. There's been an inquiry.\", \"Heard {n1} tried to pay Mrs. Gander in compliments. She wrote them down and charged interest.\", \"{n1} has been talking to the Old Pear. It hasn't said anything back, and {n1} says that's fair.\", \"If you see {n1}, don't mention the ladder. If you see {n2}, *do* mention the ladder.\", \"{n1} wrote a letter to the sea. It got a reply. Nobody's seen it.\", \"{n1} has started wearing two left shoes for what they're calling 'reasons'.\", \"They do say {n1} once beat {n2} at cards. {n2} still hasn't put them down.\", \"{n1} has been feeding the pigeons. {n2} says it's the other way about.\", \"{n1} is telling everyone they're fine. Everyone. Very loudly. From the roof.\", \"Word is {n1} sold a chair to {n2}, then sat on it. It's a legal matter now.\", \"{n1} went to the City. Came back with a new walk. {n2} says it won't last, and it's already wearing off.\", \"{n1} has been asking about you. I said you were lovely. I lied, a bit. It's nice to have secrets.\", \"Someone's been at {n1}'s flowers. {n2} has been very quiet and very pollen-y.\", \"{n1} says she's over it. There's a knitted effigy says otherwise.\", \"{n1} has a theory about {n2}. It's got string in it now.\", \"The thing about {n1}, right, is you never know, is the thing. {n2} knows, but she's not saying.\",\n];\nexport const GANDER = {\n  greet: [\"No rush on the payment, dear. I've simply noted the time you didn't pay, and I'll be noting it again tomorrow.\", \"HONK. Pardon me. That was my indoor voice.\", \"Good morning. Or rather, it was a good morning, until the figures came in.\", \"Ah. My favourite debtor. Don't tell the others. They're also my favourite.\", \"You've come to pay, or you've come to browse. I shall bill you for whichever is more.\", \"Interest, dear? Oh, no. I charge no interest. I find you quite interesting enough.\", \"Wipe your feet. I'll add it to your account regardless.\", \"Every bean has a name, dear, and yours are all called Mrs. Gander.\", \"One does hope you're well. A healthy debtor is such a joy.\", \"I've looked over your ledger. I've looked over it twice. I shall look over it as long as we both shall live.\", \"That's a lovely outfit. Did you pay for it? Ah. I remember now. You didn't.\", \"HONK. Oh, excuse me. I've just seen your balance.\", \"I never forget a face, or a sum. I've forgotten your face.\", \"Don't mind me. I'm merely standing here. In a professional capacity. Near you.\", \"Yes, the waistcoat is new. No, it's not paid for by you. Not knowingly.\"],\n  pay: [\"Noted. In ink. You may breathe out.\", \"How punctual. How unlike you. I shall have it looked into.\", \"There. That's that off. The rest remains on, as it were.\", \"Lovely. Do come back. You will come back. It's in the terms.\"],\n  paidTier: [\"Paid in full! How thrilling. I've taken the liberty of having your house enlarged. You now owe me for that.\", \"All settled. Isn't it wonderful to be free? I've extended the terms on your freedom.\"],\n  final: [\"Paid. All of it. I… I don't know what to say. It's… it's a very nice… | HONK. Forget I said anything. Here. A deed. Gold edge. Get out of my shop. Come back tomorrow.\"],\n  buy: [\"An excellent choice. I'll say that to everybody. I say it now to you.\", \"Sold. Do try to keep it out of the rain. It's in the small print.\", \"Mind you don't drop it. I shan't be replacing it. I shan't even look.\", \"Would you like a bag? Of course not. There are no bags. There never were.\"],\n  sell: [\"I'll give you {item}'s worth, and not a bean more. I've counted.\", \"Hm. It's worth what it's worth. It's worth less now you've touched it.\", \"I can take that off your hands. Your hands look relieved.\", \"I'll give you this for it. It's a robbery. Yours, by me.\"],\n  gift: [\"A gift from a neighbour, is it? Well. I won't tell. I have, however, told.\", \"Selling a gift. Oh, how very practical. I shall let them know you were practical.\"],\n  closed: [\"We are closed, dear. Your debt, however, is open all night.\"],\n  hibernate: [\"Hibernating, are we? On *my* time? I'll keep your interest warm for you, dear. Sleep tight. I'll be noting it.\"],\n  misc: [\"I've never lost a bean. I once mislaid one. It came back with its friends.\", \"My late husband used to say, 'Whatever you say, dear.' I had that put on his invoice.\", \"The store's hours are posted. So is everything else. By me.\", \"The sign says Gander's. It always has. The sign is older than the building. Don't look into it.\"],\n};\nexport const HOSTS = {\n  clementine: [\"Your letter's stamped. A bee has been living in the stamp drawer. We've agreed to share.\", \"One moment. I'll just consult the bee. …She says it's fine.\", \"Everything's fine. It's always fine. Hurricanes are fine. I've checked.\", \"Would you like to make a deposit? Nobody's rushing. Nobody's ever rushed in here. We had a man rush once. He's still filling in the form.\", \"The Bean Jar pays half a percent. We are very interested.\", \"Lost and Found's in the corner. So far we've mostly found things. It's going very well.\", \"The bee likes you. Don't take it personally. She's like that with most pollen.\", \"Town rating? I can tell you. It'll be honest. You'll be fine. I'll be fine regardless.\", \"I have been behind this counter for thirty years. Before that, I was behind a different one. I prefer it here.\", \"Mail goes out in the morning and comes in at nine. That's the system. The bee designed it.\", \"I've seen a lot of people in a hurry. They all ended up here, in the queue, behind nobody.\", \"You seem stressed. Have a seat. There aren't any. It's all right. It's nice standing.\", \"Would you like to order from the catalogue? It's one card at a time. There's no rush at all, ever.\", \"The Mayor's sapling is coming on. So's the Mayor. Slightly.\", \"The Chime? Write what you like. It's been nothing but one note since the Mayor's cousin. We all liked it fine.\"],\n  trundle: [\"I declare this… ribbon… cut. Has anyone… seen… the ribbon? It was here… in March.\", \"Good… morning. Or… is it? I… began saying that… yesterday.\", \"I'm… on my way… to something. Very important. I can… almost see it.\", \"Vote for… Trundle. It's a… little late. The election… was in spring. Of… another year.\", \"A mayor must… move… with the people. The people… have moved on. I'll catch up.\", \"I've been… crossing this plaza… since before… you came. Don't… wait up.\", \"A shovel? Have mine… I was… going to dig… something. I forget… what.\", \"Please… don't… help. I must do this… alone. Also… you're standing… on my foot. All of it.\", \"Great… things… are coming… to this town. They… have passed me.\", \"My shell… is a family… home. It's… been a hard market.\", \"Mrs. Gander… holds the note… on the town hall. And the town. And… a bit… of me.\", \"When I… reach… that ribbon… you'll see… a *real*… speech.\", \"It's… important… to pace… yourself.\", \"Oh… is that… the sun? Already? Well… I'll have… another go.\", \"The ribbon… was blue. Or it… was a very long… time ago.\"],\n  quill: [\"Is it a fossil? It's a fossil! Or a very confident potato! Either way, it goes in the hall!\", \"Oh! A fish! Or a very wet boot! Hold it closer. Closer. That's my eye.\", \"Wonderful! I can't see it at all! Tell me what it looks like, and then I'll tell you what it is!\", \"I've catalogued it as a lamp. It may be a beetle. We'll know more when it moves.\", \"My glasses? I'm wearing them? Well then. That explains the state of the gallery.\", \"Science, my friend, is only being wrong with a label on it!\", \"I'm so happy! I'm going to roll! Don't mind me! I'm— I've rolled! Could somebody—\", \"The Moatosaur had a very small brain. We've got it in a jar. It might be a walnut.\", \"The Regretodon died of embarrassment, or a rock. Those are my two theories.\", \"Do mind the Aquarium. I've labelled it the Gallery. Nobody's complained. The fish look very well hung.\", \"Thank you, thank you! Your name goes on the plaque. Spell it for me. No, don't. It's already engraved.\", \"This painting's a masterpiece! Or a very flat cat!\", \"Everything here has been donated by somebody. Most of them meant to.\", \"I rolled into a ball at my own wedding. Lovely day, I'm told.\", \"It's not that I can't see the plaque. I just like to be surprised.\"],\n  mothwick: [\"Ahh, the *fabric*! Forgive me. I nibbled. I nibble when I'm nervous. I am always nervous.\", \"You have the shoulders of a coat-hanger. It is a compliment. I adore coat-hangers.\", \"This hem! It was whole when I woke. Who could have done this? I could have done this.\", \"Fashion is pain, darling, and pain is delicious, especially in wool.\", \"Try the blue. No! Not the blue! Oh, too late, you have seen the blue.\", \"I had a lamp once. We were very happy. I don't wish to speak of it.\", \"Pattern, you say? Sixteen squares by sixteen. It is all anyone needs. It is all I can chew.\", \"Ottoline's rug? I never touched it. I *visited* it. Often. With my mouth.\", \"Everything in this shop has a small hole in it. We call that *provenance*.\", \"You must draw yourself something. Then I shall sew it. Then I shall try very hard not to eat it.\", \"I can dress you for anything. Not for this, though. Nobody's ready for this.\", \"Your outfit has a kind of courage. Your outfit should see someone about it.\", \"One does not *wear* a hat, darling. One submits.\", \"Oh, this? It is my little scarf. It was a big scarf. It was a *very* good breakfast.\", \"Mothwick's is open! Mothwick is not ready! Come in! Go away! Come in!\"],\n  fleece: [\"Sit! Sit! Let Fleece look upon this… *situation* on your head.\", \"Hair is the only thing on you that grows without asking. Respect it.\", \"Do not move. I will know. The hair will tell me.\", \"Who cut this last? No, do not tell me. I will only have to go and see them.\", \"Mine? Oh, this is natural. It is also insured. It is also *armed*.\", \"One piece of gossip per cut, this is the rule. So: {gossip}\", \"The tips, they are dry. So is your manner. I can only fix one.\", \"You want it short? You want it long? You want it *true*. I can see it.\", \"They say the Mayor had hair. They say it left him. He is still walking after it.\", \"Voilà. You are welcome. You may cry, it is good for the conditioner.\", \"I have cut the hair of dukes. One duke. He was a sheep. It was a very busy day.\", \"It's not a salon, it's a confessional with scissors.\", \"Do you know what I hear, in this chair? Everything. Do you know what I repeat? Also everything.\", \"Colour? Darling, your colour is 'recently frightened'. We can work with it.\", \"Do not touch it for one week. If it rains, go home. If it rains at home, God help you.\"],\n  flavia: [\"Darling. Stand in better lighting. No. Further. Keep going.\", \"I can't see you, darling. There's a rope. It's velvet. It's mostly a feeling.\", \"Today's theme is: {theme}. Try to have understood that.\", \"I stand on one leg because the other one is for looking at.\", \"Is that a shirt? Who told you it was a shirt?\", \"Pink is not a colour. It's a warning. I am a warning.\", \"Couture is what happens when nobody says no. I've made sure nobody says no.\", \"Hm. Hm. Hmm. That's three hms. You've never had three.\", \"Turn around. Slowly. No, you've lost me. Turn back.\", \"The look is… *a* look. It's looking at me. Make it stop.\", \"One plume. It's a very small plume. Treasure it.\", \"Five plumes! I'm so moved I'm almost standing on both feet.\", \"You may come past the rope when you've earned it. It's a metaphor. It's also a rope.\", \"Everything on the rail costs more than your house. I've seen your house.\", \"Don't thank me. Don't speak. Don't exhale near the silk.\"],\n  magda: [\"One hundred percent genuine, and only forty percent stolen.\", \"That one? That's an original. I watched it being made. Fresh this morning.\", \"Lovely, innit? Look at the brushwork. Don't look *too* close at the brushwork.\", \"Shiny thing? No. No shiny things in here, Officer. Oh, it's you.\", \"Whichever one you like, I've got another in the back. Also the original.\", \"I don't do refunds. I do apologies. They're extra.\", \"It's night. It's an alley. What did you expect, a receipt?\", \"You look like someone who appreciates art, and doesn't look closely at it.\", \"Compare it with your catalogue if you like. It's your eyes against mine, and I've got two very quick eyes.\", \"That's the Mona Llama. There's nine in the world. There's four in here.\", \"I'd like you to know, I'm a very honest magpie. I'd like *you* to know that. Don't tell anyone else.\", \"What's that behind me? A curtain. What's behind the curtain? A shorter curtain.\", \"I found that spoon. I'd say it's mine. Whose spoon is it, then? See?\", \"No touching. No breathing on it. It's still wet. I mean, it's very old.\", \"I got a good eye, me. It's in that jar.\"],\n  bellows: [\"Friends! Countrymen! Whoever you are! Lend me your… that's a nice hat. Lend me that.\", \"I once played a tree in Vienna. The tree received a better review.\", \"The theatre! Where else may a hippopotamus die so beautifully, eight times a week?\", \"A short sketch this evening. Do laugh at the end. You will know the end because I will stop.\", \"Art is suffering. I've suffered through all my own art.\", \"My Hamlet was described as 'large'. I've had that printed on the posters.\", \"Watch closely. You may learn something. It's how to laugh, and it's frankly overdue.\", \"I never forget a line. I sometimes forget which play.\", \"I shall need complete silence, followed by uproar.\", \"When I was young, I was told I had great presence. It's because I was standing in the way.\", \"I've never had stage fright. The stage has had me.\", \"Ah, a discerning patron! Or just someone seeking shelter! Either way!\", \"They say the show must go on. It's been on since Tuesday. I have asked them to stop saying that.\", \"One bow, or two? Five. It's a five-bow crowd. It's a crowd of you.\", \"Exit, pursued by my agent.\"],\n  pemberton: [\"Lot-one-going-going-oh-it's-you-do-sit-down-do-not-wave-you've-just-bid.\", \"Yes-yes-welcome-three-lots-today-hidden-limits-open-paddles-no-sudden-movements.\", \"I-speak-quickly-because-time-is-beans-and-beans-are-beans.\", \"Do-you-have-something-to-consign-leave-it-with-me-result-by-post-commission-is-modest-and-mine.\", \"That-gentleman-at-the-back-is-a-coat-stop-bidding-against-him.\", \"Going-once-going-twice-gone-to-the-otter-in-the-damp-hat.\", \"It's-a-fine-piece-very-old-or-new-I-haven't-looked.\", \"My-mother-sold-me-at-auction-she-got-a-very-good-price-we're-very-close.\", \"Paddle-up-paddle-down-that's-all-there-is-to-life.\", \"Sleep? Yes-I-sleep-every-winter-for-four-months-it's-the-only-way-to-catch-up.\", \"If-you-scratch-your-nose-you-own-a-chair.\", \"Sold-sold-sold-oh-sorry-I-was-dreaming.\", \"No-returns-no-regrets-some-regrets-mostly-regrets.\", \"We've-a-lovely-lot-of-lots-today-the-lots-are-lovely.\", \"One-moment-while-I-catch-my-breath-there-I-caught-it-sold-it.\"],\n  brisket: [\"Brisket. Better Burrows Bureau. I've seen your home. We need to talk about your chairs.\", \"Too many chairs. Who are you expecting?\", \"Item: one lamp, unrelated to any seat. Why does it hate the seat?\", \"The Bureau does not have feelings. The Bureau has a form for feelings.\", \"Your floor is doing a lot. Your walls are doing the opposite. Have they spoken?\", \"We rate on Show Day nights. You won't see us. We've been in your cupboard.\", \"Four matching pieces is a set. Three is an accident. Two is a cry for help.\", \"Something growing, a lamp by a seat, a rug under a table. These are not rules. They're the law.\", \"Clutter isn't a style. I've checked. It's on the list of things that aren't.\", \"Grade S? I've given one. She cried. So did the house.\", \"Music makes a home, the form says. I'm told I enjoyed it.\", \"Do you know what your home says about you? It says 'help'. In a very nice font.\", \"I don't judge, I grade. Judging would imply I cared how you felt about it.\", \"The Bureau thanks you for your cooperation. Your cooperation has been noted, and it's a C.\", \"I've lived in the same burrow forty years. Nobody's rated it. Nobody'd dare.\"],\n  lou: [\"…Hi.\", \"…Coffee?\", \"…Yeah.\", \"…Mm.\", \"…Blend… one… two… three…\", \"…Slow… day…\", \"…It's… fine…\", \"…You… rushed… here…\", \"…Sit…\", \"…Nice…\", \"…Tuesday…?\", \"…Foam…\", \"…Later…\", \"…Ah…\", \"…Good… one…\"],\n  nibbles: [\"I see a tall stranger. He's holding… (chew) …that part's gone now. Good luck, though.\", \"Sit, sit. Cut the cards. Don't cut them too small, I've only just had lunch.\", \"The Tower! A very bad— (chew) —mmph. Delicious. Forget about the Tower.\", \"The stars say… I ate the stars. They were on the card.\", \"Your future holds a great journey, or a great gravy. I've smudged it.\", \"I've been reading the cards for forty years. Eating them for forty-one.\", \"Beware of… hm. It's the corner. It's always the corner that's nicest.\", \"Your fortune's in your hand. Oh! May I? …That was your receipt.\", \"The Hanged Man means change. The Fool means you. They're both a bit chewy.\", \"You will meet someone. They'll be fine. I had most of the rest.\", \"Love's in your future, or lava. I'd stay flexible.\", \"I see water. I see fish. I see— (chew) —mm. Lot of salt in that one.\", \"Cards don't lie. They don't anything, once I'm done with them.\", \"That's the reading. If you want the other half, it'll be out by Thursday.\", \"Don't look at me like that. It's a very old and very digestive art.\"],\n  hester: [\"End of the line? Nobody gets off there on purpose.\", \"Fare's listening. Sit where you like. They're all the same seat.\", \"Hold on. It's a bumpy road, and I've written a song about it.\", \"I only drive the bus. I sing because nobody can stop me.\", \"City's ahead. Don't touch anything, and if you do, I'd like to hear about it.\", \"Home again, then. It'll have noticed.\", \"Twenty-two years on this route, and the road's never once said thank you.\", \"You look like you've got something on your mind. I'll put it in a verse.\", \"That's a nice thing you did with your face.\", \"My mother was a llama, and her mother, and we've all been very firm about it.\", \"Mind the step. There's no step. Mind it anyway.\", \"The bus doesn't run to a schedule. It runs to a tune.\", \"I've got a verse about you already. It rhymes with 'debt'.\", \"Next stop, whatever's next.\", \"Not a word about my hat, and I'll say nothing about your whole situation.\"],\n  vesper: [\"Sit anywhere, friend. I'd offer you a chair, but I'm using the ceiling.\", \"I hang like this because that's how the notes fall out.\", \"What's your mood? I've got six. They're all a bit like this one.\", \"I learned accordion upside down. Now the right way up I can only play regrets.\", \"That one's about the bus. They're all about the bus.\", \"Don't clap. Just sway. It keeps me from swaying alone.\", \"The record's yours. Put it on when the house is too quiet to be funny.\", \"I only play on Show Days. The rest of the week, I'm a lamp.\", \"Everybody's got a song. Yours has a lot of owing in it.\", \"Lean in, friend. I don't play loud. I play near.\", \"I had a bigger accordion. It's in a very sad song now.\", \"Some nights it's just me and the moths, and the moths want requests.\", \"Don't look at my feet. Yes, I know. I know where they are.\", \"You came back. That's nice. Most songs don't get that.\", \"This next one's in a major key. I'm so sorry.\"],\n  rind: [\"Psst. Wheel of cheese? It only goes up. Mostly. Until it goes off.\", \"It's not gambling if it's dairy.\", \"Buy now. Sell by Friday. If it's Saturday, I don't know you.\", \"Word on the board is it's rising. Could be falling. Could be wobbling. It's cheese.\", \"I've seen fortunes made in cheese. I've seen them run off in the night, smelling terrible.\", \"See the goose. She'll buy it. Don't tell her where you got it. She knows.\", \"Every Market Day morning, right here. If you see me any other day, you don't.\", \"You want the sharp or the mature? It's the same cheese. It's just seen some things.\", \"Fresh as you like. Fresh as *it* likes.\", \"Hold your nerve, friend. Hold your nose, later.\", \"My grandfather started with one wheel. He's in that one. Not for sale.\", \"That smell? That's the market correcting.\", \"A cheese held is a cheese earned. A cheese held too long is a cheese that knows your name.\", \"Heh. You've got the look. A hungry, rind-y look.\", \"Sold. You didn't get it from me. There's nothing here. There's never been a stoat.\"],\n  pimm: [\n    \"Pimm. Department of Continuity. You left. No bed. No goodbye. Do you know what that does to a Tuesday?\",\n    \"We've noticed a gap in the record. You were here, and then you weren't. Do you think time just *does* that for free?\",\n    \"Pimm again. You've done it again. The cabinet has been rattling. I live in the cabinet. I'm the one rattling. | Do you have any idea how much paperwork there is in *nothing happening*? Please. Use the bed. Or Save and Quit. It's on the menu. I've seen it.\",\n    \"Pimm. It's me. I've stopped writing it down. | I have a very small filing cabinet and a very long list, and you're the only one on it. Everything was saved, you know. Nothing was ever lost. I just… | I just like to be told. That's all. Goodnight.\",\n    \"Filing… *scuttle scuttle*… Continuity is a very lonely department.\",\n    \"It's all in the cabinet. It's all saved. That isn't the point. That has never been the point.\",\n    \"Do not touch the second drawer. I live in the second drawer.\",\n    \"I'm a hermit crab. This was the only thing in my size that had a lock.\",\n    \"A day has a beginning, a middle and a bed. You'd know that if you'd gone on the course.\",\n    \"Don't apologise to me. Apologise to the Tuesday.\",\n    \"When you switch something off, *somebody* has to go round afterwards and put everything away.\",\n    \"Have you any notion how many Tuesdays I've had to refile?\",\n    \"I'd shake your hand, but I've only got claws, and you've only got a lot to answer for.\",\n    \"This has been noted. That's all it's been. But it's been very thoroughly noted.\",\n    \"Sleep well. Or don't. But *say*.\",\n  ],\n};\nexport const BALLAD = {\n  verses: [\"♪ Oh, you fished up a {catch} and you sold it for {price}, / and you'd do it, you'd do it, you'd do it again… ♪\", \"♪ There's a goose with a ledger who knows what you owe, / and it's {debt} beans now, and it's going real slow… ♪\", \"♪ You chased down a {bug} with your net in the sun, / and you held it up high like the thing you had won… ♪\", \"♪ You gave {neighbour} a {item}, oh you meant it so well, / and {neighbour} said thanks, and then went to sell… ♪\", \"♪ Oh, {player} rode in on a rainy old bus, / said, 'What town is this?' I said, 'It's one of us'… ♪\", \"♪ You sold it, you sold it, the thing that they knit, / and the whole of {town} knows, and it's knitting of it… ♪\", \"♪ Oh, you dug a big hole and you stood there a while, / found a {fossil} in there and you gave it a smile… ♪\", \"♪ There's a snail with a sash who is crossing the square, / he'll be cutting that ribbon if the ribbon's still there… ♪\", \"♪ Oh, {neighbour} was talking and {neighbour} was sad, / and you nodded and nodded, it wasn't too bad… ♪\", \"♪ You've got {pockets} things in your pockets today, / and not one of them's asked you to carry it that way… ♪\", \"♪ It's {season} back home and the {tree} are all bare, / or they're not, it's a song, I've no idea, I'm not there… ♪\", \"♪ You left in a hurry, you left in a rush, / you left {town} behind with a very slight blush… ♪\", \"♪ Oh, the fare is a song, and the song is a fare, / and the road goes on forward, and I'm always there… ♪\", \"♪ You owe and you owe and you owe, don't you know, / but the bus doesn't care, and the bus has to go… ♪\", \"♪ I knew someone like you, they got off at the sea, / they wrote me one letter, and that letter was me… ♪\", \"♪ There's a shack and a bed, there's a roof, more or less, / and a goose at your door in a nice waistcoat dress… ♪\", \"♪ You bought a new {item}, you wore it to town, / and the whole of {town} turned the corners back down… ♪\", \"♪ Your hair's a fine thing, it's a thing you could keep, / or there's somebody in town who'll give it a sweep… ♪\", \"♪ {neighbour} had a thing that they meant to say, / and they said it to a fish, and the fish swam away… ♪\", \"♪ Oh, you tried and you tried and you pulled up a weed, / and that's all that a person will ever much need… ♪\"],\n  chorus: [\"♪ So ride, ride, ride, on a bus to the end, / where the road's got a bend, and the bend's got a friend… ♪\", \"♪ And it's la-da-da-dum, and it's on we go, / to wherever it is, and I'd rather not know… ♪\", \"♪ Oh, the wheels go round, and they've gone round before, / and there's nothing to see, and I'm seeing some more… ♪\"],\n};\nexport const BEDTIME = [\"…Can't it wait? It's the middle of the night. I'm asleep. This is me, asleep.\", \"Who's that? No. Go home. Come back when it's a reasonable hour. Or don't.\", \"Mmph. I'm not in. I'm a recording of someone who isn't in.\", \"It's dark. Go to bed. You can knock tomorrow. You can also not.\"];\nexport const LETTER_REPLY = { name: \"You used my name! Nobody uses my name! I've kept that bit.\", short: \"You wrote '{snip}'. I framed it.\", long: \"That was a lot of letter. I read it to the end. I've had a lie-down.\", gift: \"And a gift! I'm keeping it. I've told everyone. Well, one person.\", none: \"Thanks for writing. Nobody writes. Well, people do, but not to me. Well, you did.\" };\nexport const GRAN_LETTERS = [\"Dear {player}. I hear you've got a house. I had a house. I'm sure yours is fine. Enclosed, some fruit, since nobody else is feeding you. Gran.\", \"{player}. Your cousin wrote to me. Twice. I'm only mentioning it. This fruit is from a very nice tree you've never visited. Gran.\", \"Dear {player}. It's cold here. Don't worry about me. Nobody has. Here's something inexplicable I found in the shed. Love, Gran.\", \"{player}. I told Doris you were doing well. She laughed. Doris is dead now, but it stung. Eat this. Gran.\"];\nexport const FESTIVAL_LINES = {\n  seedToss: [\"Fling your seeds at the chalk rings! Everybody! For ninety seconds! It's tradition, since last year!\", \"Whoever sows most, wins nothing! It's the principle!\"],\n  lantern: [\"Pick a colour, write a wish, and set it down on the river at the north bridge.\", \"They all drift to the sea. Nobody knows what the sea does with them. It's never said thank you.\"],\n  soup: [\"Bring three things. Fish, fruit, mushroom. Or a boot. We've had boot years. They were good years, mmhm.\", \"Everybody tastes. Everybody talks. It's not really about the soup.\"],\n  longNight: [\"The sun's gone at four. Carry the lights round, door to door. Everyone gets a string, and everyone gets you.\", \"At midnight, the Old Pear lights up, and the Bell plays your tune. Yes, yours. Sorry.\"],\n};\nexport const COUNT_LINES = () => { let n = 0; const walk = (o) => { if (Array.isArray(o)) { for (const x of o) typeof x === 'string' ? n++ : walk(x); } else if (o && typeof o === 'object') for (const v of Object.values(o)) { if (typeof v === 'string') n++; else walk(v); } }; walk(TYPE_LINES); walk(UNIQUE); walk(GOSSIP); walk(GANDER); walk(HOSTS); walk(BALLAD); walk(BEDTIME); walk(LETTER_REPLY); walk(GRAN_LETTERS); walk(FESTIVAL_LINES); return n; };\nE\nnode -e \"import('./src/data/lines.js').then(m=>{console.log(m.COUNT_LINES())})\"; cat >> ../PROGRESS.md <<'E'\nDone: data/cast, data/lines (writing). Next: state.js + systems + game.js.\nE","description":"Write cast and dialogue banks"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vrrg4FbGmEDrAvTK6dvpeR","type":"tool_result","content":"849","is_error":false}]},"parent_tool_use_id":null,"session_id":"3f147b5a-afdb-41c5-bbfc-62264f8c7cee","uuid":"83a4ac3e-de69-445a-a093-eafd766e242f","timestamp":"2026-11-06T00:44:28.548Z","tool_use_result":{"stdout":"849","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Vrrg4FbGmEDrAvTK6dvpeR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
