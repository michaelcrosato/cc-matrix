 * 0.65, 0], 'green'), ...Array.from({ length: 1 + i * 2 }, (_, k) => ball(0.4, 0.14, 0.26, [k % 2 ? 0.2 : -0.2, 0.4 + k * 0.5, 0], 'lime')), ...(i === 2 ? [ball(0.34, 0.34, 0.34, [0.3, 2.6, 0], 'orange'), ball(0.34, 0.34, 0.34, [-0.3, 2.2, 0], 'orange'), ball(0.34, 0.34, 0.34, [0, 3, 0.2], 'orange')] : [])]));\nexport const rockDef = M('sf-rock', 'A rock', ['nature'], [{ lump: [1.1, 0.8, 1], at: [0, 0.4, 0], seed: 5, c: 'slate' }, { lump: [0.4, 0.3, 0.4], at: [0.2, 0.75, 0.1], seed: 2, c: 'mist' }]);\nconst flower = (id, parts) => model({ id, about: 'Flower ' + id, tags: ['flower'], palette: { stem: 'green', petal: 'red', eye: 'sand' }, parts: [cyl(0.05, 0.35, 0.05, [0, 0.17, 0], 'stem', { seg: 4 }), box(0.22, 0.05, 0.1, [0.08, 0.1, 0], 'stem', { rot: [0, 0, 30] }), ...parts] });\nexport const flowers = { tulip: flower('fl-tulip', [cone(0.3, 0.24, 0.3, [0, 0.44, 0], 'petal', { rot: [180, 0, 0], seg: 5 })]), daisy: flower('fl-daisy', [cyl(0.34, 0.05, 0.34, [0, 0.38, 0], 'petal', { seg: 6 }), cyl(0.14, 0.07, 0.14, [0, 0.4, 0], 'eye')]), cosmos: flower('fl-cosmos', [ball(0.2, 0.1, 0.2, [0.1, 0.38, 0], 'petal'), ball(0.2, 0.1, 0.2, [-0.1, 0.38, 0], 'petal'), ball(0.2, 0.1, 0.2, [0, 0.38, 0.1], 'petal'), ball(0.2, 0.1, 0.2, [0, 0.38, -0.1], 'petal'), ball(0.1, 0.08, 0.1, [0, 0.42, 0], 'eye')]), bluebell: flower('fl-bluebell', [ball(0.18, 0.2, 0.18, [0.06, 0.35, 0], 'petal'), ball(0.14, 0.16, 0.14, [-0.08, 0.28, 0.03], 'petal'), ball(0.12, 0.13, 0.12, [0.0, 0.46, 0.03], 'petal')]) };\nexport const weed = M('sf-weed', 'A weed', ['nature'], [cone(0.14, 0.34, 0.08, [-0.12, 0.17, 0], 'green', { rot: [0, 0, 18] }), cone(0.14, 0.42, 0.08, [0.02, 0.21, 0], 'lime'), cone(0.14, 0.32, 0.08, [0.14, 0.16, 0.04], 'green', { rot: [0, 0, -18] })]);\nexport const crackDef = M('sf-crack', 'A star-shaped crack in the ground', ['nature'], [box(0.5, 0.03, 0.08, [0, 0.02, 0], 'ink', { rot: [0, 30, 0] }), box(0.5, 0.03, 0.08, [0, 0.02, 0], 'ink', { rot: [0, 90, 0] }), box(0.5, 0.03, 0.08, [0,