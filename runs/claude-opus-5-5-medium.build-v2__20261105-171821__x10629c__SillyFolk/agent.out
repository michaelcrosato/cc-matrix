..kaaaaaak..', '..kkkkkkkk..'],\n  fruit: ['......k.....', '.....k......', '.....aa.....', '....aaaa....', '....aaaa....', '...aaaaaa...', '...aaaaab...', '....abbb....'], mushroom: ['...aaaaaa...', '..aawaawaa..', '.aaaaaaaaaa.', '.awaawaaawa.', '....wwww....', '....wwww....', '....wwww....'], medicine: ['....kkkk....', '....wwww....', '...waaaaw...', '...waaaaw...', '...wwwwww...', '...wwwwww...', '...wwwwww...'], cheese: ['.....aaaaaa.', '...aaaaaaaa.', '.aaaaaaaaaa.', 'aakaaaakaaa.', 'aaaaakaaaaa.', 'aakaaaaakaa.', 'aaaaaaaaaaa.', 'bbbbbbbbbbb.'], bag: ['.....kk.....', '....aaaa....', '...aaaaaa...', '..aaaakaaa..', '..aaakkkaa..', '..aaaakaaa..', '..aaaaaaaa..', '...bbbbbb...'], parcel: ['.aaaakkaaaa.', '.aaaakkaaaa.', '.kkkkkkkkkk.', '.aaaakkaaaa.', '.aaaakkaaaa.', '.bbbbbbbbbb.'], letter: ['............', '.wwwwwwwwww.', '.wkwwwwwwkw.', '.wwkwwwwkww.', '.wwwkkkkwww.', '.wwwwwwwwww.', '.wwwwwwwwww.'], record: ['...kkkkkk...', '..kkkkkkkk..', '.kkkaaaakkk.', '.kkkawwakkk.', '.kkkawwakkk.', '.kkkaaaakkk.', '..kkkkkkkk..', '...kkkkkk...'], boot: ['..aaaaa.....', '..aaaaa.....', '..aaaaa.....', '..aaaaa.....', '..aaaaaaaa..', '..aaaaaaaaa.', '..kkkkkkkkk.'], ball: ['...aaaaaa...', '..aaaaaaaa..', '.aaaaaaaaab.', '.aaaaaaaaab.', '.aaaaaaabbb.', '..abbbbbbb..', '...bbbbb....'],\n  mapPin: ['..aaaa..', '.aaaaaa.', '.aawwaa.', '.aawwaa.', '.aaaaaa.', '..aaaa..', '...aa...', '...aa...'],\n};\nconst SHADE = { red: 'plum', orange: 'red', sand: 'orange', lime: 'green', green: 'teal', teal: 'navy', navy: 'night', blue: 'navy', sky: 'blue', cyan: 'teal', white: 'mist', mist: 'slate', slate: 'night', night: 'ink', plum: 'night', ink: 'night' };\nexport function iconRows(name) { return R[name] ?? R.box; }\nexport function iconColors(color = 'sand', c2) { return { a: color, b: c2 ?? SHADE[color] ?? 'slate', k: 'ink', w: 'white', g: 'green' }; }\nexport function iconFor(it) {\n  if (!it) return 'box';\n  switch (it.cat) {\n    case 'fish': return { L: 'fishL', XL: 'fishL' }[it.shadow] ?? (it.id === 'crawfish' ? 'crab' : 'fish');\n    case 'bug': return { fly: 'bugFly', ball: 'bugBall', long: 'bugLong', beetle: 'beetle' }[it.shape];\n    case 'fossil': case 'fossilunk': return it.cat === 'fossil' && it.set ? 'bone' : 'rockf';\n    case 'art': return 'painting'; case 'shell': return it.id === 'drift_wood' ? 'stick' : 'shell';\n    case 'shirt': return 'shirt'; case 'hat': return 'hat'; case 'glasses': return 'glasses'; case 'umbrella': return 'umbrella';\n    case 'wall': return 'wall'; case 'floor': return 'floor'; case 'tool': return it.id === 'can' ? 'can' : it.id === 'sling' ? 'sling' : it.id;\n    case 'flower': return 'flower'; case 'seed': return it.id === 'sapling' ? 'sapling' : 'seed'; case 'fruit': return 'fruit'; case 'food': return 'mushroom'; case 'med': return 'medicine'; case 'cheese': return 'cheese'; case 'bag': return 'bag'; case 'quest': return 'parcel'; case 'paper': return 'letter'; case 'record': return 'record';\n    case 'junk': return it.id === 'weed' ? 'weed' : it.id === 'boot' ? 'boot' : 'ball';\n    case 'furn': { const f = it.fn; if (f === 'seat') return 'chair'; if (f === 'bed') return 'bed'; if (f === 'lamp') return 'lamp'; if (f === 'tv') return 'tv'; if (f === 'rug') return 'rug'; if (f === 'plant') return 'plant'; if (f === 'stereo') return 'record'; if (/trophy|medal/.test(it.id)) return 'trophy'; if (/shelf/.test(it.id)) return 'shelf'; if (/table|desk/.test(it.id)) return 'table'; return 'box'; }\n    default: return 'box';\n  }\n}\nconst FURN_COLOR = (it) => { const p = it.palette ?? {}; return p.carpet ?? p.wood ?? 'sand'; };\nexport const iconColor = (it) => (it.cat === 'furn' ? (/trophy|medal/.test(it.id) ? 'sand' : FURN_COLOR(it)) : it.cat === 'wall' || it.cat === 'floor' ? it.a : it.cat === 'glasses' ? 'sky' : it.color ?? 'sand');\nexport const iconColor2 = (it) => (it.cat === 'wall' || it.cat === 'floor' ? it.b : undefined);\n/** Draw an item icon scaled up. */\nexport function drawIcon(h, x, y, it, scale = 2) { const rows = iconRows(iconFor(it)); h.sprite(x, y + Math.round((12 - rows.length) * scale / 2), rows, iconColors(iconColor(it), iconColor2(it)), { shadow: false, scale }); }\nE\nnode -e \"import('./src/data/items.js').then(m=>{const c={};for(const i of Object.values(m.ITEMS))c[i.cat]=(c[i.cat]||0)+1;console.log(c)})\"; cat >> ../PROGRESS.md <<'E'\nPlan of modules: see PLAN §21. Done so far: core/util,storage,calendar; dev/tuning; ui/font,input,kit,icons; art/critter; actors/clips,actor; data/items; tools/build.mjs\nE","description":"Write item data and icons"}}}
