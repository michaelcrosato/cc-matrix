6), A('R', -60), L('R', -20), L('L', -20))], [18, {}]]),\n  once('Give', 24, [[0, {}], [8, pose(T(10), A('R', -80), A('L', -80))], [18, pose(T(10), A('R', -80), A('L', -80))], [24, {}]]),\n  loop('NetReady', 30, [[0, pose(T(-4, -28), A('R', -130, 16), A('L', -40, 10))], [15, pose(P(-0.02), T(-4, -30), A('R', -134, 16), A('L', -40, 10))]]),\n  once('NetSweep', 14, [[0, pose(T(-4, -30), A('R', -140, 16)), 'inBack'], [3, pose(T(-8, -44), A('R', -150, 20))], [7, pose(T(16, 44), A('R', -70, 34), A('L', -30, 30))], [14, {}]], { fast: true }),\n  once('Cast', 20, [[0, {}, 'inBack'], [5, pose(T(-14), A('R', -170, 4))], [10, pose(T(14), A('R', -70), H(4))], [20, pose(T(4), A('R', -72))]], { fast: true }),\n  loop('Reel', 12, [[0, pose(T(-6), A('R', -72), A('L', -60))], [6, pose(T(-10), A('R', -80), A('L', -66))]]),\n  once('Dig', 30, [[0, {}, 'inBack'], [8, pose(T(10), A('R', -30), A('L', -30))], [14, pose(P(-0.08), T(40), A('R', -70), A('L', -66))], [22, pose(T(-14), A('R', -120), A('L', -110))], [30, {}]], { fast: true }),\n  once('Chop', 24, [[0, {}, 'inBack'], [7, pose(T(-14, -36), A('R', -168, 10), A('L', -140, 10))], [13, pose(T(12, 34), A('R', -82, 8), A('L', -80, 8))], [18, pose(T(10, 28), A('R', -82, 8), A('L', -80, 8))], [24, {}]], { fast: true }),\n  once('Water', 34, [[0, {}], [8, pose(T(8), A('R', -74))], [14, pose(T(10), A('R', -60))], [20, pose(T(10), A('R', -74))], [26, pose(T(10), A('R', -60))], [34, {}]]),\n  loop('ShakeTree', 10, [[0, pose(P(0, 0, 0, 5), T(10), A('R', -110, 12), A('L', -110, 12))], [5, pose(P(-0.03, 0, 0, -5), T(4), A('R', -96, 12), A('L', -96, 12))]]),\n  once('Slingshot', 26, [[0, {}], [8, pose(T(-10, -10), H(-16), A('R', -124), A('L', -128))], [14, pose(T(-12, -14), H(-18), A('R', -96, 10), A('L', -130))], [18, pose(T(-6), H(-18), A('R', -128, 10), A('L', -130))], [26, {}]], { fast: true }),\n  gait('PushSnow', 24, 0, 24, 0.02, 20, 2),\n  loop('Eat', 16, [[0, pose(A('R', -140), H(-4))], [8, pose(A('R', -130), H(6))]]),\n  loop('Hum', 40, [[0, pose(P(0, 0, 0, 4), H(0, 0, 8))], [20, pose(P(0, 0, 0, -4), H(0, 0, -8))]]),\n  loop('Sway', 48, [[0, pose(P(0, 0, 0, 7), H(0, 0, 5), A('R', -6, 14), A('L', -6, 8))], [24, pose(P(0, 0, 0, -7), H(0, 0, -5), A('R', -6, 8), A('L', -6, 14))]]),\n  once('Sting', 22, [[0, {}], [3, pose(P(0.12, 0, 0, 0, [0.9, 1.14, 0.9]), H(-16), A('R', -150, 12), A('L', -150, 12))], [10, pose(H(14, 18), A('R', -140, 8), A('L', -140, 8))], [22, {}]], { fast: true }),\n  once('Slip', 24, [[0, {}], [6, pz(0, 0.1, 0, -40)], [14, pz(0, -0.14, 0, -70)], [24, {}]], { fast: true }),\n  loop('MayorSlide', 60, [[0, P(0, 0, 0, 0, [1, 1, 1])], [30, P(0, 0, 0, 0, [0.96, 1, 1.05])]]),\n  loop('VesperHang', 40, [[0, pose(pz(0, 0, 0, 180), A('R', -120, 10), A('L', -110, 10), H(0, 0, 4))], [20, pose(pz(0, 0.02, 0, 180, 0, 8), A('R', -112, 10), A('L', -120, 10), H(0, 0, -4))]]),\n  gait('PimmScuttle', 10, 30, 30, 0.04, 0, 3),\n  loop('RoccoRoll', 16, [[0, pose(pz(0, 0.08, 0, 0), T(60), H(30), A('R', -90), A('L', -90), L('R', -90), L('L', -90))], [8, pose(pz(0, 0.08, 0, 180), T(60), H(30), A('R', -90), A('L', -90), L('R', -90), L('L', -90))], [16, pose(pz(0, 0.08, 0, 360), T(60), H(30), A('R', -90), A('L', -90), L('R', -90), L('L', -90))]].slice(0, 2), { fast: true }),\n  loop('QuillBall', 12, [[0, pose(pz(0, -0.06, 0, 0), T(70), H(50), A('R', -110), A('L', -110), L('R', -110), L('L', -110))], [6, pose(pz(0, -0.02, 0, 0), T(76), H(50), A('R', -112), A('L', -112), L('R', -110), L('L', -110))]]),\n];\nE\ncat > src/actors/actor.js <<'E'\n// A character on screen: the model, its mixer, cross-faded clips, blink, talk mouth, facing, squash, held things.\nimport { buildModel, compileClips, ContactShadow, setLookLayer, Squash, THREE } from '../engine.js';\nimport { RIG, critterDef } from '../art/critter.js';\nimport { CLIP_DEFS } from './clips.js';\nimport { angleDelta } from '../core/util.js';\nlet CLIPS = null; const byName = new Map();\nexport const clipNames = () => CLIP_DEFS.map((c) => c.name);\nexport class Actor {\n  constructor(def, o = {}) {\n    this.root = new THREE.Group();\n    this.scale = o.scale ?? 1;\n    this.shadow = o.shadow === false ? null : new ContactShadow(0.42 * this.scale);\n    this.rebuild(def);\n    this.facing = o.facing ?? 0; this.targetFacing = this.facing;\n    this.squash = new Squash(); this.blinkT = 1.5 + (o.seed ?? 0) % 3; this.blink = 0; this.talking = 0; this.smile = 0; this.mood = null;\n    this.current = null; this.curName = null; this.onceBack = null; this.stateT = 0;\n  }\n  rebuild(def) {\n    const old = this.obj; const held = this.heldObj; this.def = def;\n    const build = buildModel(def, {});\n    this.obj = build.object; setLookLayer(this.obj, 'actors');\n    this.obj.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = false; } });\n    if (old) { this.root.remove(old); this.mixer?.stopAllAction(); }\n    this.root.add(this.obj); this.root.scale.setScalar(this.scale);\n    if (!CLIPS) { CLIPS = compileClips(CLIP_DEFS, RIG, this.obj); for (const c of CLIPS) byName.set(c.name, c); }\n    this.mixer = new THREE.AnimationMixer(this.obj); this.actions = new Map();\n    this.eyes = this.obj.getObjectByName('Eyes'); this.mouth = this.obj.getObjectByName('Mouth'); this.head = this.obj.getObjectByName('Head'); this.armR = this.obj.getObjectByName('ArmR'); this.torso = this.obj.getObjectByName('Torso');\n    if (this.curName) { const n = this.curName; this.curName = null; this.play(n, { fade: 0 }); } else this.play('Idle', { fade: 0 });\n    if (held) { this.heldObj = null; this.hold(held); }\n  }\n  action(name) { let a = this.actions.get(name); if (!a) { const c = byName.get(name); if (!c) return null; a = this.mixer.clipAction(c); this.actions.set(name, a); } return a; }\n  /** Plays a clip. Clips that aren't loops play once and return to `then` (default the locomotion clip last asked for). */\n  play(name, o = {}) {\n    if (this.curName === name && !o.restart) return;\n    const a = this.action(name); if (!a) return;\n    const isLoop = CLIP_DEFS.find((c) => c.name === name)?.loop;\n    a.reset(); a.setLoop(isLoop ? THREE.LoopRepeat : THREE.LoopOnce, Infinity); a.clampWhenFinished = !isLoop; a.timeScale = o.speed ?? 1; a.enabled = true; a.setEffectiveWeight(1); a.play();\n    const fade = o.fade ?? 0.12;\n    if (this.current && this.current !== a) { if (fade > 0) this.current.crossFadeTo(a, fade, false); else this.current.stop(); }\n    this.current = a; this.curName = name; this.onceT = isLoop ? 0 : a.getClip().duration; this.then = o.then ?? (isLoop ? null : o.hold ? null : 'Idle');\n  }\n  faceTo(x, z) { const p = this.root.position; this.targetFacing = Math.atan2(x - p.x, z - p.z); }\n  place(x, y, z) { this.root.position.set(x, y, z); }\n  hold(obj) { this.drop(); if (!obj || !this.armR) return; this.heldObj = obj; obj.position.set(0, -0.26, 0.02); this.armR.add(obj); }\n  drop() { if (this.heldObj) { this.heldObj.parent?.remove(this.heldObj); this.heldObj = null; } }\n  update(dt) {\n    this.mixer.update(dt);\n    if (this.onceT > 0) { this.onceT -= dt; if (this.onceT <= 0 && this.then) { const t = this.then; this.then = null; this.play(t); } }\n    this.facing += angleDelta(this.facing, this.targetFacing) * Math.min(1, dt * 14);\n    this.obj.rotation.y = this.facing;\n    this.squash.update(dt); const [sx, sy] = this.squash.scale(); this.obj.scale.set(sx, sy, sx);\n    this.blinkT -= dt; if (this.blinkT <= 0) { this.blinkT = 2 + ((this.blinkT * 977) % 1 + 1) % 1 * 4; this.blink = 0.12; }\n    this.blink = Math.max(0, this.blink - dt);\n    if (this.eyes) this.eyes.scale.y = this.curName === 'Sleep' || this.curName === 'PlayDead' ? 0.15 : this.blink > 0 ? 0.15 : this.puffy ? 1.7 : 1;\n    if (this.eyes && this.puffy) this.eyes.scale.x = 1.3; else if (this.eyes) this.eyes.scale.x = 1;\n    if (this.mouth) { if (this.talking > 0) { this.talking = Math.max(0, this.talking - dt); this.mouth.scale.y = 3.2; } else this.mouth.scale.y = this.mood === 'queasy' ? 2 : 1; this.mouth.scale.x = this.mood === 'queasy' ? 1.6 : 1; }\n    if (this.shadow) this.shadow.place(this.root.position.x, this.root.position.y, this.root.position.z, 0);\n  }\n  addTo(group) { group.add(this.root); if (this.shadow) group.add(this.shadow); }\n  removeFrom() { this.root.parent?.remove(this.root); this.shadow?.parent?.remove(this.shadow); }\n  set visible(v) { this.root.visible = v; if (this.shadow) this.shadow.visible = v; }\n  get visible() { return this.root.visible; }\n}\nexport const actorFrom = (o, a) => new Actor(critterDef(o), a);\nE\ncat > /tmp/sf-t.mjs 2>/dev/null <<'E'\nE\nrm -f /tmp/sf-t.mjs; mkdir -p tests/tmp; cat > tests/tmp/t1.mjs <<'E'\nimport { validateClip, Engine, buildModel, checkModel } from '../../src/engine.js';\nimport { CLIP_DEFS } from '../../src/actors/clips.js';\nimport { RIG, critterDef, SPECIES } from '../../src/art/critter.js';\nfor (const c of CLIP_DEFS) { const p = validateClip(c, RIG); if (p.length) console.log(c.name, p); }\nfor (const s of Object.keys(SPECIES)) { const d = critterDef({ id: 'x' + s, species: s, c1: 'sand', hair: s === 'person' ? 2 : null, hat: null }); const r = checkModel(d, {}); if (r.problems.length) console.log(s, r.problems.slice(0, 3)); const b = buildModel(d, {}); }\nconsole.log('ok', CLIP_DEFS.length);\nE\nnode tests/tmp/t1.mjs 2>&1 | tail -20","description":"Write critter generator, clips and actor; validate"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17078,"cache_read_input_tokens":181800,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17078},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f147b5a-afdb-41c5-bbfc-62264f8c7cee","uuid":"b9959b87-e343-40ef-bc35-16870ff4b1e2","timestamp":"2026-11-06T00:29:25.468Z","request_id":"req_011Cgkj1YL4eLGQh89BybvCZ","wire_tool_inputs":{"toolu_018SgVaToPHE7gfzfaQEPFyv":{"command":"cat > src/art/critter.js <<'E'\n// The critter generator: every neighbour, host, pedestrian and the player come from one function.\n// All share one skeleton (seven joints at the same rest positions), so one compiled clip set drives everyone.\nimport { model } from '../engine.js';\nexport const P16 = Object.fromEntries('ink plum red orange sand lime green teal navy blue sky cyan white mist slate night'.split(' ').map((c) => [c, c]));\nexport const RIG = { joints: ['Pelvis', 'Torso', 'Head', 'ArmR', 'ArmL', 'LegR', 'LegL'], root: 'Pelvis', mirror: { ArmR: 'ArmL', ArmL: 'ArmR', LegR: 'LegL', LegL: 'LegR' }, soles: [], trace: [], limits: {}, fps: 30 };\nconst HEAD_Y = 0.36;\nconst ball = (w, h, d, at, c, extra) => ({ ball: [w, h, d], at, c, ...extra });\nconst box = (w, h, d, at, c, extra) => ({ box: [w, h, d], at, c, ...extra });\nconst cyl = (w, h, d, at, c, extra) => ({ cyl: [w, h, d], at, c, ...extra });\nconst cone = (w, h, d, at, c, extra) => ({ cone: [w, h, d], at, c, ...extra });\nconst mx = (...parts) => ({ mirror: parts, axis: 'x' });\nconst y = (v) => HEAD_Y + v;\n\nexport const EAR = {\n  none: () => [],\n  round: (c, i) => [mx(ball(0.26, 0.26, 0.12, [0.32, y(0.34), 0], c), ball(0.14, 0.14, 0.04, [0.32, y(0.34), 0.06], i))],\n  small: (c) => [mx(ball(0.15, 0.15, 0.1, [0.33, y(0.3), 0], c))],\n  tall: (c, i) => [mx(ball(0.14, 0.38, 0.1, [0.25, y(0.5), 0], c), ball(0.07, 0.24, 0.03, [0.25, y(0.5), 0.05], i))],\n  floppy: (c) => [mx(ball(0.14, 0.34, 0.12, [0.42, y(0.08), 0], c))],\n  side: (c) => [mx(ball(0.32, 0.14, 0.1, [0.48, y(0.2), 0], c))],\n  point: (c) => [mx(cone(0.2, 0.3, 0.12, [0.26, y(0.46), 0], c))],\n};\n/** Species: head shape, ears, muzzle, extras (added to the head), back (added to the torso), root (added to the pelvis). */\nexport const SPECIES = {\n  person: (s) => ({ head: [0.8, 0.76, 0.76], ears: 'small', muzzle: [] }),\n  wombat: (s) => ({ head: [0.9, 0.74, 0.8], ears: 'small', muzzle: [box(0.46, 0.24, 0.2, [0, y(-0.1), 0.36], s.c2), box(0.22, 0.1, 0.06, [0, y(-0.02), 0.46], 'ink')], stocky: true }),\n  quokka: (s) => ({ head: [0.78, 0.76, 0.74], ears: 'round', muzzle: [ball(0.3, 0.2, 0.16, [0, y(-0.12), 0.36], s.c2), box(0.1, 0.06, 0.05, [0, y(-0.06), 0.44], 'ink')], tail: [cone(0.14, 0.4, 0.14, [0, 0.0, -0.24], s.c1, { rot: [-120, 0, 0] })] }),\n  moose: (s) => ({ head: [0.66, 0.72, 0.72], ears: 'point', muzzle: [box(0.42, 0.34, 0.34, [0, y(-0.18), 0.36], s.c2), box(0.08, 0.06, 0.04, [0.1, y(-0.12), 0.54], 'ink'), box(0.08, 0.06, 0.04, [-0.1, y(-0.12), 0.54], 'ink')], extra: [mx(box(0.5, 0.08, 0.14, [0.44, y(0.42), 0], 'sand', { rot: [0, 0, 22] }), box(0.08, 0.3, 0.1, [0.62, y(0.62), 0], 'sand'), box(0.08, 0.22, 0.1, [0.44, y(0.6), 0], 'sand'), box(0.08, 0.26, 0.1, [0.78, y(0.58), 0], 'sand')), box(0.3, 0.22, 0.04, [0.62, y(0.42), 0.06], 'white'), box(0.2, 0.16, 0.04, [-0.56, y(0.44), 0.06], 'sky')] }),\n  platypus: (s) => ({ head: [0.76, 0.7, 0.72], ears: 'none', muzzle: [box(0.54, 0.1, 0.44, [0, y(-0.1), 0.48], 'orange'), box(0.2, 0.04, 0.05, [0, y(-0.05), 0.6], 'ink')], extra: [cone(0.26, 0.16, 0.26, [0, y(0.42), 0], 'sky'), box(0.42, 0.06, 0.26, [0, y(0.35), 0], 'sand')], tail: [box(0.46, 0.08, 0.56, [0, -0.15, -0.42], 'orange')], neck: 'white' }),\n  armadillo: (s) => ({ head: [0.62, 0.62, 0.72], ears: 'tall', muzzle: [ball(0.26, 0.2, 0.3, [0, y(-0.14), 0.36], s.c2)], back: [ball(0.68, 0.62, 0.58, [0, 0.12, -0.08], 'slate'), box(0.68, 0.06, 0.5, [0, 0.27, -0.1], 'night'), box(0.7, 0.06, 0.52, [0, 0.1, -0.1], 'night'), box(0.68, 0.06, 0.5, [0, -0.06, -0.1], 'night')] }),\n  lemur: (s) => ({ head: [0.72, 0.72, 0.68], ears: 'point', muzzle: [ball(0.24, 0.16, 0.2, [0, y(-0.14), 0.34], 'ink')], eyeRing: 'white', tail: [...[0, 1, 2, 3, 4, 5].map((i) => cyl(0.14, 0.2, 0.14, [0, 0.0 + i * 0.2, -0.3 - (i < 2 ? i * 0.05 : 0.08)], i % 2 ? 'ink' : 'white', { seg: 6 }))] }),\n  