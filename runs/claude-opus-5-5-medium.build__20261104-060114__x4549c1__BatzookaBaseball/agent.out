hip }); text(g, s ? 'HOME' : 'AWAY', x + cw / 2, y + 4, '#a8a8c8', { align: 'center' });\")\ns=s.replace(\"if (TS.rigs[id]) try { TS.rigs[id].draw(g, x + 55, y + 74, E.VIEWS.side); }\",\"if (TS.rigs[id]) try { TS.rigs[id].draw(g, Math.round(x + cw / 2), y + 74, E.VIEWS.side); }\")\ns=s.replace(\"text(g, T.name, x + 55, y + 80, '#ffffff', { align: 'center', scale: 1 });\",\"text(g, T.name, x + cw / 2, y + 80, '#ffffff', { align: 'center', scale: 1 });\")\ns=s.replace(\"text(g, 'POW ' + '★'.repeat(T.stars[0]) + '  SPD ' + '★'.repeat(T.stars[1]), x + 55, y + 92, '#ffe680', { align: 'center' });\\n        text(g, 'PIT ' + '★'.repeat(T.stars[2]), x + 55, y + 101, '#ffe680', { align: 'center' });\",\n            \"text(g, 'POW ' + '★'.repeat(T.stars[0]), x + cw / 2, y + 90, '#ffe680', { align: 'center' }); text(g, 'SPD ' + '★'.repeat(T.stars[1]), x + cw / 2, y + 99, '#ffe680', { align: 'center' });\\n        text(g, 'PIT ' + '★'.repeat(T.stars[2]), x + cw / 2, y + 108, '#ffe680', { align: 'center' });\")\ns=s.replace(\"text(g, ps.length < 4 ? 'More players: press START on a free pad, or 2 on the keyboard. P2-P4: ←/→ picks a side.' : 'Four players in!', W / 2, 176, '#c8c8d8', { align: 'center' });\",\n            \"para(g, ps.length < 4 ? 'More players: START on a free pad, or 2 on the keyboard. P2-P4: ←/→ picks a side.' : 'Four players in!', W / 2 - 150, 176, 300, '#c8c8d8');\")\ns=s.replace(\"const y = 152;\\n        E.ui.box(g, x, y, 24, 18\",\"const y = 154;\\n        E.ui.box(g, x, y, 24, 18\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"const x = sd === 0\" src/34-menus.js | cut -c1-120; node tools/build.mjs >/dev/null && TMPDIR=$PWD/.tmp timeout 120 node tools/shot.mjs ../BatzookaBaseball-Baseball-claude-opus-5-5-medium-20261104-060114.html#match --steps \"wait:6000 shot:p1 wait:900 shot:p2 wait:700 shot:p3 wait:2500 shot:p4\" 2>&1 | tail -3","description":"Apply UI fixes; screenshot an at-bat from deep link","timeout":180000},"caller":{"type":"direct"}}],"container":null