.mode } : null, lastContact: M && M.lastContact, cam: M && M.cam,\n      meters: M ? M.teams.map(t => Math.round(t.meter)) : null, device: game.input.lastDevice, glyphs: game.input.glyphs, touchOnly: BZ.touchOnly, errors: game.errors.length,\n      attract: BZ.attract ? { on: game.sceneName === 'attract', segment: BZ.attract.seg } : null, dev: BZ.dev ? { open: BZ.dev.open, tab: BZ.dev.tab } : null, hub: BZ.hub ? { phase: BZ.hub.phase, score: BZ.hub.score } : null };\n  },\n  BZ, tune: TUNE, resetTune: BZ.resetTune, events: BZ.bus.log,\n  match: o => newMatch(o), M: () => M,\n  force(o) { M.force = Object.assign(M.force || {}, o); if (o.rhubarb) M.forceRhubarb = true; },\n  warp: (scene, data) => game.go(scene, data, { fade: 0 }),\n  step(dt) { try { matchUpdate(dt); } catch (e) { game.fail('step', e); throw e; } }\n};\nfunction bootGame() {\n  detectTouch();\n  game.start({ scenes: SCENES, scene: HEADLESS ? 'boot' : 'boot', boot: HEADLESS ? false : { title: 'BATZOOKA BASEBALL', steps: [['Building the ballparks', () => { for (const id of PARK_ORDER) parkKit(id); }], ['Tuning the organ', () => {}]] } });\n}\nif (!SCENES.boot) SCENES.boot = { enter() { game.go(BZ.firstScene ? BZ.firstScene() : 'title', null, { fade: 0 }); }, update() {} };\nbootGame();\nBZ.M_ = () => M;\nif (typeof window !== 'undefined') window.BZ = BZ;\n","userModified":false},"tool_result_meta":[{"id":"toolu_018nLtMrXvRssGZJHvidAhqN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
