g, W, H);\\n\")\ns=s.replace(\"function hudTick(dt) {\",\"function hudTick(dt) { radioTick(dt);\")\ns=s.replace(\"const human = !autoPit() && autoBat(), p = human ? defense().pitcher : batterNow(), x = SAFE, y = H - SAFE - 40 - (game.players.length > 2 ? 14 : 0), w = 150;\",\"const human = !autoPit() && autoBat(), p = human ? defense().pitcher : batterNow(), x = SAFE, y = H - SAFE - 58 - (game.players.length > 2 ? 16 : 0), w = 150;\")\ns=s.replace(\"    if (solo) promptRow(g, I, items, W / 2 + 60, y, 'center');\",\"    if (solo) promptRow(g, I, items, W / 2, y, 'center');\")\ns=s.replace(\"else { if (ps.length > 1) text(g, I.name || 'P' + (i + 1), i % 2 ? W - SAFE : SAFE + 156, y - 10, I.color || '#fff', { align: i % 2 ? 'right' : 'left' }); promptRow(g, I, items, i % 2 ? W - SAFE : SAFE + 156, y, i % 2 ? 'right' : 'left'); }\",\n            \"else { text(g, I.name || 'P' + (i + 1), i % 2 ? W - SAFE : SAFE, y - 10, I.color || '#fff', { align: i % 2 ? 'right' : 'left' }); promptRow(g, I, items.slice(0, 3), i % 2 ? W - SAFE : SAFE, y, i % 2 ? 'right' : 'left'); }\")\nopen(p,'w').write(s)\np='src/21-draw.js'; s=open(p).read()\ns=s.replace(\"      if (i % 6 === 3 && p0[2] > .12) E.font.text(g, String(feet(rOf(a.x, a.y))), (p0[0] + p1[0]) / 2, (p0[1] + p3[1]) / 2 - 3, '#ffffff', { align: 'center', outline: false });\\n\",\"\")\nopen(p,'w').write(s)\nfor f in ['src/34-menus.js','src/31-derby.js','src/35-attract.js']:\n    t=open(f).read(); t=t.replace(\"commonTick(dt); if (talk) talk.update(dt);\",\"commonTick(dt); radioTick(dt);\").replace(\"if (talk) talk.draw(r);\",\"\").replace(\"if (talk) talk.close();\",\"RADIO.who = null;\")\n    open(f,'w').write(t)\nEOF\ngrep -n \"talk\\b\\|talk\\.\" src/*.js | grep -v \"^src/23-talk.js\" | grep -v \"STORY.talk\\|^src/32\" | head; grep -n \"talk\" src/32-training.js | head","description":"Replace match radio with a custom top-center box; layout fixes"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequenc