{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,125p' src/scene.js && sed -n '75,120p' src/app.js && tail -35 tests/run.py\"","aggregated_output":"import { mergeGeometries } from \"three/addons/utils/BufferGeometryUtils.js\";\nimport * as T from \"three/webgpu\";\n\nexport const C = {\n\tink: 0x192b39,\n\tpaper: 0xfff2cd,\n\tblue: 0x196b9a,\n\taqua: 0x6bd9cf,\n\torange: 0xf07745,\n\tgold: 0xffcc48,\n\tred: 0xd95748,\n};\nconst V = new T.Vector3();\nexport class Stage {\n\tconstructor(container) {\n\t\tthis.container = container;\n\t\tthis.bombs = new Map();\n\t\tthis.players = [];\n\t\tthis.ghosts = new Map();\n\t\tthis.fx = [];\n\t\tthis.mixers = [];\n\t\tthis.time = 0;\n\t\tthis.cameraOffset = -4.3;\n\t\tthis.targetOffset = -4.3;\n\t\tthis.shake = 0;\n\t\tthis.hitboxes = false;\n\t\tthis.debugMeshes = [];\n\t}\n\tasync init() {\n\t\tthis.renderer = new T.WebGPURenderer({\n\t\t\tantialias: true,\n\t\t\talpha: false,\n\t\t\tpowerPreference: \"high-performance\",\n\t\t\tforceWebGL:\n\t\t\t\tnew URLSearchParams(location.search).get(\"renderer\") === \"webgl\",\n\t\t});\n\t\tthis.renderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n\t\tthis.renderer.setSize(innerWidth, innerHeight);\n\t\tthis.renderer.setClearColor(0xf6ce68);\n\t\tthis.renderer.outputColorSpace = T.SRGBColorSpace;\n\t\tthis.renderer.toneMapping = T.ACESFilmicToneMapping;\n\t\tthis.renderer.toneMappingExposure = 1.04;\n\t\tthis.container.appendChild(this.renderer.domElement);\n\t\tthis.renderer.domElement.setAttribute(\n\t\t\t\"aria-label\",\n\t\t\t\"Cel-shaded rooftop bomb-catching game\",\n\t\t);\n\t\tawait this.renderer.init();\n\t\tthis.backend = this.renderer.backend.isWebGPUBackend\n\t\t\t? \"WebGPU\"\n\t\t\t: \"WebGL 2 compatibility\";\n\t\tthis.scene = new T.Scene();\n\t\tthis.scene.fog = new T.Fog(0xf4d78d, 46, 80);\n\t\tthis.camera = new T.OrthographicCamera(-14, 14, 8.5, -8.5, 0.1, 120);\n\t\tthis.resize();\n\t\tthis.scene.add