{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/scene.js');s=p.read_text();s=s.replace('  async screenshotReady(){await this.renderer.compileAsync(this.scene,this.camera);}', '''  async verifyFrame(){\n    const target=new T.RenderTarget(64,64,{format:T.RGBAFormat,type:T.UnsignedByteType,depthBuffer:true});\n    this.renderer.setRenderTarget(target);this.renderer.render(this.scene,this.camera);this.renderer.setRenderTarget(null);\n    const pixels=await this.renderer.readRenderTargetPixelsAsync(target,0,0,64,64);\n    let min=255,max=0,total=0;const colors=new Set();for(let i=0;i<pixels.length;i+=4){const v=pixels[i]+pixels[i+1]+pixels[i+2];min=Math.min(min,v/3);max=Math.max(max,v/3);total+=v;colors.add(pixels[i]+','+pixels[i+1]+','+pixels[i+2]);}target.dispose();return {min,max,colors:colors.size,total};\n  }\n  async screenshotReady(){await this.renderer.compileAsync(this.scene,this.camera);}''');p.write_text(s)\np=Path('src/app.js');s=p.read_text().replace(\\\"if(this.net.roundActive)this.net.result(data.score,data.stats);\\\",\\\"if(this.net.roundActive)this.net.result(data.score,data.stats);\\\")\n# Make the developer tools mark the run before any tool is used, including the fast finish.\ns=s.replace(\\\"if(this.net.active)return;this.devTab??='tools';\\\", \\\"if(this.net.active)return;this.game.unranked=true;this.devTab??='tools';\\\")\np.write_text(s)\nPY\ncp /usr/share/doc/fonts-lato/copyright assets/Lato-OFL.txt\ncp node_modules/three/LICENSE assets/Three-MIT.txt\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('build.mjs');s=p.read_text().replace(\\\"const filename=\\\", \\\"const licenses=await Promise.all(['Lato-OFL.txt','Three-MIT.txt'].map(f=>fs.readFile(path.join(root,'assets',f),'utf8')));\\\\nhtml=html.replace('</body>',()=>\"'`<!--'\"\\\\\\\\nBundled dependency notices\\\\\\\\n\"'${licenses.join('\"'\\\\\\\\n\\\\\\\\n')}\\\\\\\\nRapier: C