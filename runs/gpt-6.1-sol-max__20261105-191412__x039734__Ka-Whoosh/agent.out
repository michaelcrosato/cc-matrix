{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/run.py');s=p.read_text().replace('import traceback','import subprocess\\\\nimport re\\\\nimport contextlib\\\\nimport urllib.parse')\ns=s.replace('with sync_playwright() as p:', '''@contextlib.contextmanager\ndef static_server():\n    log = (ART/'server.log').open('w')\n    proc = subprocess.Popen([sys.executable, '-u', '-m', 'http.server', '0', '--bind', '127.0.0.1', '--directory', str(ROOT.parent)], cwd=ROOT, stdout=subprocess.PIPE, stderr=log, text=True)\n    try:\n        line = proc.stdout.readline()\n        match = re.search(r'port (\\\\\\\\d+)', line)\n        if not match:\n            raise RuntimeError('Static server did not announce its OS-assigned port')\n        yield 'http://127.0.0.1:' + match.group(1)\n    finally:\n        proc.terminate()\n        proc.wait(timeout=5)\n        log.close()\n\nwith static_server() as base, sync_playwright() as p:''')\ns=s.replace(\\\"page.screenshot(path=str(ART/'title.png'))\\\", \\\"\\\"\\\"check('WebGPU offscreen pixel readback', lambda: page.evaluate('''async()=>{const r=await __KA_WHOOSH__.stage.verifyFrame();return r.colors>30&&r.max-r.min>40;}'''))\n        page.screenshot(path=str(ART/'title.png'))\\\"\\\"\\\")\ns=s.replace(\\\"check('gold miss preserves tubs',\\\", \\\"\\\"\\\"def perfect_and_gold():\n            return page.evaluate('''()=>{const t=__KA_WHOOSH__,g=t.game;g.start({seed:12});g.charge=0;const normal=g.spawn('normal',0,3);g.catch(normal,0);const normalScore=g.score;const gold=g.spawn('gold',0,3);g.catch(gold,0);return normalScore===20&&g.score===80&&g.stats.perfect===2&&g.stats.gold===1&&g.charge===35;}''')\n        check('perfect and gold bonuses', perfect_and_gold)\n        def coop():\n            return page.evaluate('''()=>{const t=__KA_WHOOSH__,g=t.game;g.start({mode:'coop',seed:1981});g.phase='playing';g.spawn('normal',-3,4);g.spawn('normal',3,4);const s=t.advance(.7);return s.stats.caught===2&&s.players.length===2&&s.players.every(p=>p.buckets===3);}''')\n        check('couch co-op sensor catches', coop)\n        def restored():\n            return page.evaluate('''()=>{const g=__KA_WHOOSH__.game;g.start({seed:8});g.players[0].buckets=1;g.charge=0;g.restore();return g.players[0].buckets===2&&g.charge===25;}''')\n        check('shift clear restores a tub and charge', restored)\n        def deterministic():\n            return page.evaluate('''()=>{const t=__KA_WHOOSH__,g=t.game;g.start({seed:88});const a=t.advance(10,{auto:true});g.start({seed:88});const b=t.advance(10,{auto:true});return a.score===b.score&&a.spawned===b.spawned&&a.players[0].x===b.players[0].x;}''')\n        check('identical-seed delivery stream', deterministic)\n        check('gold miss preserves tubs',\\\"\\\"\\\")\ns=s.replace(\\\"    context.close()\\\\n    browser.close()\\\", '''    context.close()\n\n    # Real touch events on a landscape phone profile; no physical touch hardware needed.\n    touch_context=browser.new_context(viewport={'width':844,'height':390},device_scale_factor=1,is_mobile=True,has_touch=True)\n    touch=touch_context.new_page()\n    touch.goto(GAME.as_uri(),wait_until='load',timeout=120000)\n    touch.wait_for_function('window.__gameReady||window.__gameError',timeout=120000)\n    def touch_controls():\n        touch.locator('[data-action=\\\"solo\\\"]').tap()\n        cdp=touch_context.new_cdp_session(touch)\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':530,'y':220,'id':1}]})\n        touch.wait_for_timeout(250)\n        expect(touch.evaluate('__KA_WHOOSH__.game.players[0].x>0&&__KA_WHOOSH__.game.assist'), 'Touch did not move or assist')\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':530,'y':220,'id':1},{'x':650,'y':220,'id':2}]})\n        touch.wait_for_timeout(80)\n        expect(touch.evaluate('__KA_WHOOSH__.game.stats.douses===1'), 'Second touch did not douse')\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n        return True\n    check('touch drag, assist and second-finger douse',touch_controls)\n    def touch_menu():\n        touch.locator('#pause-button').tap()\n        expect(touch.evaluate(\\\"__KA_WHOOSH__.app.screen==='pause'\\\"),'Touch menu not opened')\n        touch.locator('[data-action=\\\"resume\\\"]').tap()\n        return expect(touch.evaluate('__KA_WHOOSH__.app.screen===null'),'Touch menu did not resume')\n    check('touch pause and resume',touch_menu)\n    touch_context.close()\n\n    # Standalone online mode uses an actual peer data channel between two pages.\n    rtc_context=browser.new_context(viewport={'width':1000,'height':700})\n    host=rtc_context.new_page(); guest=rtc_context.new_page()\n    for rp in [host,guest]:\n        rp.goto(base+'/'+GAME.name,wait_until='load',timeout=120000)\n        rp.wait_for_function('window.__gameReady||window.__gameError',timeout=120000)\n        expect(rp.title().startswith('Ka-Whoosh\"'!'\"'),'Static server returned another game')\n        rp.evaluate('__KA_WHOOSH__.app.showOnline()')\n    def rtc_pair():\n        host.locator('[data-action=\\\"create-invite\\\"]').click()\n        host.wait_for_function('document.getElementById(\\\"outgoing-code\\\").value.startsWith(\\\"WHOOSH1.\\\")',timeout=15000)\n        offer=host.locator('#outgoing-code').input_value()\n        guest.locator('#incoming-code').fill(offer)\n        guest.locator('[data-action=\\\"accept-code\\\"]').click()\n        guest.wait_for_function('document.getElementById(\\\"outgoing-code\\\").value.startsWith(\\\"WHOOSH1.\\\")',timeout=15000)\n        reply=guest.locator('#outgoing-code').input_value()\n        host.locator('#incoming-code').fill(reply)\n        host.locator('[data-action=\\\"accept-code\\\"]').click()\n        host.wait_for_function('__KA_WHOOSH__.network.connected',timeout=15000)\n        guest.wait_for_function('__KA_WHOOSH__.network.connected',timeout=15000)\n        return True\n    check('standalone WebRTC invite and reply UI',rtc_pair)\n    def rtc_race():\n        host.locator('[data-action=\\\"race-start\\\"]').click()\n        host.wait_for_function('__KA_WHOOSH__.network.roundActive',timeout=10000)\n        guest.wait_for_function('__KA_WHOOSH__.network.roundActive',timeout=10000)\n        expect(host.evaluate('__KA_WHOOSH__.game.seed')==guest.evaluate('__KA_WHOOSH__.game.seed'),'Rivals had different seeds')\n        host.wait_for_function('__KA_WHOOSH__.network.peers.size===1',timeout=5000)\n        guest.wait_for_function('__KA_WHOOSH__.network.peers.size===1',timeout=5000)\n        return expect(host.evaluate('__KA_WHOOSH__.stage.ghosts.size===1') and guest.evaluate('__KA_WHOOSH__.stage.ghosts.size===1'),'Rival tubs not visible')\n    check('standalone synchronized race and ghosts',rtc_race)\n    def rtc_results():\n        host.evaluate('__KA_WHOOSH__.game.score=1200;__KA_WHOOSH__.game.finish(false)')\n        guest.evaluate('__KA_WHOOSH__.game.score=900;__KA_WHOOSH__.game.finish(false)')\n        host.wait_for_function('__KA_WHOOSH__.network.rivalResult?.score===900',timeout=5000)\n        guest.wait_for_function('__KA_WHOOSH__.network.rivalResult?.score===1200',timeout=5000)\n        return expect('rooftop crown' in host.locator('#screen').inner_text(),'Remote result not shown')\n    check('standalone race results round trip',rtc_results)\n    def rtc_close():\n        host.locator('[data-action=\\\"leave-online\\\"]').click()\n        return expect(host.evaluate('__KA_WHOOSH__.network.pc===null&&\"'!__KA_WHOOSH__.network.active'\"'),'Peer connection leaked')\n    check('standalone disconnect cleans up',rtc_close)\n    rtc_context.close()\n\n    # The requested, unmodified AI Hub harness performs its full protocol checks.\n    for players,scenario,network in [(2,'standard',False),(4,'standard',True),(4,'host-leave',True)]:\n        hc=browser.new_context(viewport={'width':1280,'height':900})\n        hp=hc.new_page()\n        def hub_check():\n            params={'game':'../'+GAME.name,'players':str(players),'scenario':scenario,'auto':'1','play':'4000'}\n            if network: params.update(latency='150',jitter='50',loss='5')\n            url=base+'/'+ROOT.name+'/harness.html?'+urllib.parse.urlencode(params)\n            hp.goto(url,wait_until='load',timeout=120000)\n            hp.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=90000)\n            report=hp.evaluate('window.__hubCheck')\n            (ART/f'hub-{players}-{scenario}.json').write_text(json.dumps(report,indent=2))\n            return expect(report['pass'],json.dumps([c for c in report['checks'] if not c['pass']]))\n        check(f'AI Hub {players} players / {scenario}'+(' / 150ms, jitter, 5% loss' if network else ''),hub_check)\n        hc.close()\n\n    # Compatibility backend screenshots are for art/layout review; WebGPU is tested above.\n    vc=browser.new_context(viewport={'width':1920,'height':1080})\n    vp=vc.new_page()\n    vp.goto(GAME.as_uri()+'?renderer=webgl',wait_until='load',timeout=120000)\n    vp.wait_for_function('window.__gameReady||window.__gameError',timeout=120000)\n    vp.wait_for_timeout(700)\n    vp.screenshot(path=str(ART/'title-tv.png'))\n    def compatibility():\n        expect(vp.evaluate(\\\"__KA_WHOOSH__.stage.backend==='WebGL 2 compatibility'\\\"),'Wrong compatibility backend')\n        vp.evaluate(\\\"\\\"\\\"()=>{const t=__KA_WHOOSH__;t.app.start('solo');t.game.effects=true;t.game.auto=true;t.game.jumpWave(4);t.game.phase='playing';t.app.hideAnnounce();t.game.bomberX=3.1;t.game.players[0].x=-2;for(const [x,y,k]of [[3.1,9.6,'normal'],[1.7,7.2,'gold'],[-.6,5.2,'rush'],[-2,3.8,'normal']])t.game.spawn(k,x,y);t.stage.burst(-2,3.2,'water',50);}\\\"\\\"\\\")\n        vp.wait_for_timeout(350)\n        vp.screenshot(path=str(ART/'gameplay-tv.png'))\n        return vp.evaluate('async()=>{const r=await __KA_WHOOSH__.stage.verifyFrame();return r.colors>30;}')\n    check('WebGL compatibility rendering',compatibility)\n    vp.evaluate('__KA_WHOOSH__.app.pause()')\n    vp.screenshot(path=str(ART/'pause-tv.png'))\n    vp.evaluate('__KA_WHOOSH__.app.showAbout()')\n    vp.screenshot(path=str(ART/'about-tv.png'))\n    vc.close()\n    browser.close()\n\n    # WebKit is a useful stand-in for Safari, with the WebGL compatibility backend.\n    wb=p.webkit.launch(headless=True)\n    wc=wb.new_context(viewport={'width':390,'height':844},is_mobile=True,has_touch=True,device_scale_factor=1)\n    wp=wc.new_page()\n    def webkit():\n        wp.goto(GAME.as_uri(),wait_until='load',timeout=120000)\n        wp.wait_for_function('window.__gameReady||window.__gameError',timeout=120000)\n        return expect(wp.evaluate('\"'!!window.__gameReady'\"'),wp.evaluate('window.__gameError||\\\"WebKit not ready\\\"'))\n    check('WebKit portrait compatibility',webkit)\n    if wp.evaluate('\"'!!window.__gameReady'\"'):\n        wp.screenshot(path=str(ART/'title-portrait.png'))\n        def portrait():\n            wp.locator('[data-action=\\\"solo\\\"]').tap()\n            wp.wait_for_timeout(150)\n            return expect(wp.evaluate('__KA_WHOOSH__.app.screen===null'),'Portrait touch could not start')\n        check('portrait touch menu',portrait)\n    wc.close();wb.close()\n    check('exit interview parses with exact schema',lambda: expect(set(json.loads((ROOT.parent/'exit-interview.json').read_text()))=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'},'Exit interview schema mismatch'))''')\np.write_text(s)\nPY\nnpm --silent run build\nnpm --silent test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
