st\"\n            ),\n            \"Touch did not move or assist\",\n        )\n        cdp.send(\n            \"Input.dispatchTouchEvent\",\n            {\n                \"type\": \"touchStart\",\n                \"touchPoints\": [\n                    {\"x\": 530, \"y\": 220, \"id\": 1},\n                    {\"x\": 650, \"y\": 220, \"id\": 2},\n                ],\n            },\n        )\n        touch.wait_for_timeout(80)\n        expect(\n            touch.evaluate(\"__KA_WHOOSH__.game.stats.douses===1\"),\n            \"Second touch did not douse\",\n        )\n        cdp.send(\"Input.dispatchTouchEvent\", {\"type\": \"touchEnd\", \"touchPoints\": []})\n        return True\n\n    check(\"touch drag, assist and second-finger douse\", touch_controls)\n\n    def touch_menu():\n        touch.locator(\"#pause-button\").tap()\n        expect(\n            touch.evaluate(\"__KA_WHOOSH__.app.screen==='pause'\"),\n            \"Touch menu not opened\",\n        )\n        touch.locator('[data-action=\"resume\"]').tap()\n        return expect(\n            touch.evaluate(\"__KA_WHOOSH__.app.screen===null\"),\n            \"Touch menu did not resume\",\n        )\n\n    check(\"touch pause and resume\", touch_menu)\n    touch_context.close()\n    browser.close()\n    browser = p.chromium.launch(\n        headless=True,\n        args=[\n            \"--enable-unsafe-webgpu\",\n            \"--enable-features=Vulkan\",\n            \"--use-webgpu-adapter=swiftshader\",\n            \"--use-angle=swiftshader\",\n            \"--no-sandbox\",\n            \"--autoplay-policy=no-user-gesture-required\",\n        ],\n    )\n73:    browser = p.chromium.launch(\n91:    page.wait_for_function(\"window.__gameReady || window.__gameError\", timeout=120000)\n126:            browser.close()\n385:    browser.close()\n386:    browser = p.chromium.launch(\n407:    touch.wait_for_function(\"window.__gameReady||window.__gameError\", timeout=120000)\n457:    browser.close()\n458:    browser = p.chromium.launch(\n476:        rp.wait_for_function(\"window.__gameReady||window.__gameError\", timeout=120000)\n482:    def rtc_pair():\n565:    browser.close()\n573:        browser = p.chromium.launch(\n622:        browser.close()\n625:    browser = p.chromium.launch(\n631:    vp.wait_for_function(\"window.__gameReady||window.__gameError\", timeout=120000)\n655:    browser.close()\n669:        wp.wait_for_function(\"window.__gameReady||window.__gameError\", timeout=120000)\n\t\t});\n\t\trenderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n\t\trenderer.setSize(innerWidth, innerHeight);\n\t\trenderer.setClearColor(0xf6ce68);\n\t\trenderer.outputColorSpace = T.SRGBColorSpace;\n\t\trenderer.toneMapping = T.ACESFilmicToneMapping;\n\t\trenderer.toneMappingExposure = 1.04;\n\t\trenderer.domElement.setAttribute(\n\t\t\t\"aria-label\",\n\t\t\t\"Cel-shaded rooftop bomb-catching game\",\n\t\t);\n\t\trenderer.onDeviceLost = (info) => {\n\t\t\trenderer._isDeviceLost = true;\n\t\t\tthis.deviceLoss = info.message || info.reason || \"unknown\";\n\t\t\tif (!this.disposed) this.useCompatibility().catch(() => {});\n\t\t};\n\t\tawait renderer.init();\n\t\treturn renderer;\n\t}\n\tuseCompatibility() {\n\t\tif (this.recoveryPromise) return this.recoveryPromise;\n\t\tif (this.disposed || this.backend === \"WebGL 2 compatibility\")\n\t\t\treturn Promise.resolve();\n\t\tthis.recovering = true;\n\t\tthis.recoveryPromise = this.rebuildRenderer().finally(() => {\n\t\t\tthis.recovering = false;\n\t\t\tthis.recoveryPromise = null;\n\t\t});\n\t\treturn this.recoveryPromise;\n\t}\n\tasync rebuildRenderer() {\n\t\tconst old = this.renderer;\n\t\tif (old) old.setAnimationLoop(null);\n\t\tconst replacement = await this.withDeadline(\n\t\t\tthis.createRenderer(true),\n\t\t\t8000,\n\t\t);\n\t\tthis.renderer = replacement;\n\t\tthis.backend = \"WebGL 2 compatibility\";\n\t\tthis.container.replaceChildren(replacement.domElement);\n\t\tthis.buildScene();\n\t\tawait this.withDeadline(\n\t\t\treplacement.compileAsync(this.scene, this.camera),\n\t\t\t8000,\n\t\t);\n\t\tif (this.loop) replacement.setAnimationLoop(this.loop);\n\t}\n\tasync withDeadline(promise, ms) {\n\t\tlet timer;\n\t\ttry {\n\t\t\treturn await Promise.race([\n\t\t\t\tpromise,\n\t\t\t\tnew Promise((_, reject) => {\n\t\t\t\t\ttimer = setTimeout(\n\t\t\t\t\t\t() => reject(new Error(\"Graphics device did not respond\")),\n\t\t\t\t\t\tms,\n\t\t\t\t\t);\n\t\t\t\t}),\n\t\t\t]);\n\t\t} finally {\n\t\t\tclearTimeout(timer);\n\t\t}\n\t}\n\tsetLoop(callback) {\n\t\tthis.loop = callback;\n\t\tthis.renderer.setAnimationLoop(callback);\n\t}\n\tdispose() {\n\t\tthis.disposed = true;\n\t\tthis.loop = null;\n\t\ttry {\n 384609       01:40 sh -c /home/micha/.local/share/pipx/venvs/playwright/bin/python tests/run.py\n 384610       01:40 /home/micha/.local/share/pipx/venvs/playwright/bin/python tests/run.py\n 389513       00:00 /bin/bash -lc sed -n '385,468p' tests/run.py && rg -n 'browser.close|browser =|def rtc_pair|ready.*timeout' tests/run.py && sed -n '35,105p' src/scene.js && python3 - <<'PY' from pathlib import Path import subprocess,os for line in subprocess.check_output(['ps','-u',str(os.getuid()),'-o','pid=,etime=,args='],text=True).splitlines():  a=line.strip().split(None,2)  try:   if len(a)==3 and 'tests/run.py' in a[2] and Path(f'/proc/{a[0]}/cwd').resolve()==Path.cwd():print(line)  except FileNotFoundError:pass PY\n","exit_code":0,"status":"completed"}}
