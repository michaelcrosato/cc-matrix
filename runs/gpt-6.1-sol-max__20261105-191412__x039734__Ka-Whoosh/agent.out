{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > src/app.js <<'EOF'\nimport {Stage,C} from './scene.js';\nimport {Game,DEFAULTS,WAVES} from './game.js';\nimport {Sound} from './audio.js';\nimport {Input} from './input.js';\nimport {Network} from './network.js';\nimport INFO from '../metadata.json';\n\nconst \"'$=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"'\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst button=(text,action,primary=false,extra='')=>\"'`<button class=\"action${primary?'\"' primary':''}\\\" data-action=\\\"\"'${action}\" ${extra}>${text}<span class=\"menu-arrow\">↗</span></button>`;\nconst glyph=(text,pad=false)=>`<span class=\"glyph${pad?'\"' pad':''}\\\">\"'${text}</span>`;\nconst QUESTIONS={testing:['\"'How many issues did testing catch?','How many were critical or game breaking?','Most helpful test?','Least helpful test?'],engine:['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important thing you built yourself?','Hardest part of using the engine?','What did you change in the engine, and why?','One thing you would change?'],prompt:['What did you like most about this prompt?','What was confusing?','What was hardest?','What would you change?']};\n\nclass App {\n  constructor(){\n    this.sound=new Sound();this.screen=null;this.previousScreen='title';this.aboutTab='source';this.devTab='tools';this.attract=false;this.lastActivity=performance.now();this.lastFrame=0;this.nextHud=0;this.announceTimer=0;this.toastTimer=0;this.ready=false;this.settingsParent='title';this.settings={music:.1,effects:.65,voice:.55,glyphs:'playstation',difficulty:'arcade',reduceMotion:false,aimAssist:false,lowFlash:false};this.records=[];\n    try{const s=JSON.parse(localStorage.getItem('ka-whoosh-settings')||'null');if(s)Object.assign(this.settings,s);this.records=JSON.parse(localStorage.getItem('ka-whoosh-records')||'[]');if(\"'!Array.isArray(this.records))this.records=[];}catch{}\n    this.net=new Network({\n      waiting:()=>this.waiting(),countdown:t=>this.hubCountdown(t),start:seed=>this.networkStart(seed),\n      timeUp:()=>{if(this.game&&!this.net.reported)this.game.finish(false,'\"'time-up');},\n      end:()=>{if(this.game)this.game.phase='ended';this.sound.stop();this.hideAnnounce();this.showHubEnd();},\n      ghost:(id,p)=>{if(this.stage&&this.game)this.stage.updateGhost(id,{...p,visible:p.stage===this.game.wave},p.color);this.renderRivals();},\n      removeGhost:id=>{this.stage?.removeGhost(id);this.renderRivals();},\n      status:t=>{if(\"'$('\"'online-status'))\"'$('\"'online-status').textContent=t;},\n      connected:host=>{if(\"'$('\"'start-race'))\"'$('\"'start-race').hidden=\"'!host;},\n      rivalResult:()=>{if(this.screen==='\"'results')this.showResults(this.lastResult);},\n      disconnect:()=>this.toast('Rival disconnected. Your shift continues.'),\n    });\n  }\n  async init(){\n    await document.fonts.ready;await Promise.all([document.fonts.load('900 32px Display'),document.fonts.load('400 20px Body')]);\n    this.stage=new Stage(\"'$('\"'world'));await this.stage.init();this.game=new Game(this.stage,this.sound,(event,data)=>this.gameEvent(event,data));await this.game.init();this.game.assist=this.settings.aimAssist;this.input=new Input(this);this.applySettings();this.bind();\n    this.stage.playerState([{x:0,buckets:3}],1.85);await this.stage.screenshotReady();\n    this.ready=true;this.lastActivity=performance.now();\"'$('\"'loading').hidden=true;\n    if(this.net.kind==='hub')this.waiting();else this.showTitle();\n    this.stage.renderer.setAnimationLoop(t=>this.frame(t));await this.net.ready();\n    window.__KA_WHOOSH__={app:this,game:this.game,stage:this.stage,sound:this.sound,network:this.net,info:INFO,ready:true,\n      snapshot:()=>this.game.snapshot(),\n      advance:(seconds,{auto=false,effects=false}={})=>{const oldAuto=this.game.auto,oldEffects=this.game.effects;this.game.auto=auto;this.game.effects=effects;for(let i=0;i<Math.ceil(seconds*120);i++){if(['won','lost','ended'].includes(this.game.phase))break;this.game.step(1/120,[]);}this.game.auto=oldAuto;this.game.effects=oldEffects;this.updateHud();return this.game.snapshot();},\n    };window.__gameReady=true;\n  }\n  bind(){\n    \"'$('\"'screen').addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b&&\"'!b.disabled){this.activity();this.sound.unlock();this.sound.play('\"'click');this.action(b.dataset.action,b);}});\n    \"'$('\"'screen').addEventListener('input',e=>this.slider(e.target));\n    \"'$('\"'pause-button').onclick=()=>this.pause();\"'$('\"'douse-button').onclick=()=>this.douse();\n    document.addEventListener('visibilitychange',()=>{if(document.hidden&&this.game&&this.game.phase\"'!=='\"'idle'&&\"'!this.net.roundActive&&!this.attract&&!this.screen)this.pause();});\n  }\n  activity(){\n    this.lastActivity=performance.now();\n    if(!this.net.ended){this.sound.resume();this.sound.unlock();}\n    if(this.attract){this.exitAttract();return true;}return false;\n  }\n  applySettings(){\n    this.sound.musicVolume=Math.max(0,Math.min(1,Number(this.settings.music)));this.sound.effectsVolume=Number(this.settings.effects);this.sound.voiceVolume=Number(this.settings.voice);this.sound.volumes();\n    document.body.classList.toggle('\"'reduce-motion',this.settings.reduceMotion);document.body.classList.toggle('low-flash',this.settings.lowFlash);\n    if(this.game){this.game.assist=this.settings.aimAssist||this.input?.last==='touch';this.game.difficulty=this.settings.difficulty;this.game.applyTune();}\n    try{localStorage.setItem('ka-whoosh-settings',JSON.stringify(this.settings));}catch{}this.prompts();\n  }\n  panel(content,wide=false){return \"'`<div class=\"shade\"><section class=\"panel${wide?'\"' wide':''}\\\" role=\\\"dialog\\\" aria-modal=\\\"true\\\">\"'${content}</section></div>`;}\n  setScreen(name,html){this.screen=name;$('\"'screen').innerHTML=html;this.input?.clear();this.prompts();queueMicrotask(()=>{const first=this.input?.elements()[0];first?.focus({preventScroll:true});});}\n  clearScreen(){this.screen=null;\"'$('\"'screen').innerHTML='';this.input?.clear();}\n  showTitle(){\n    if(this.net.kind==='hub')return;\n    this.game.phase='idle';this.game.clear();this.attract=false;\"'$('\"'attract-label').hidden=true;\"'$('\"'hud').hidden=true;\"'$('\"'pause-button').hidden=false;this.hideAnnounce();this.stage.targetOffset=-4.3;this.stage.setPlayers(1);this.stage.playerState([{x:0,buckets:3}],1.85);this.sound.resume();this.lastActivity=performance.now();\n    const best=this.records.length?Math.max(...this.records.map(r=>r.score)):0;\n    this.setScreen('title',\"'`<section class=\"title-screen\"><div class=\"eyebrow\">Rooftop water brigade · Est. 1981</div><h1 class=\"title-logo\" aria-label=\"Ka-Whoosh!\"><span>KA–</span><span class=\"whoosh\">WHOOSH!</span></h1><p class=\"title-description\"><b>A little panic. A lot of splash.</b><br>Catch trouble before it hits the roof.</p><nav class=\"title-nav\" aria-label=\"Main menu\">${button('\"'Start a solo shift','solo',true)}\"'${button('\"'Two at the tubs <small>couch co-op</small>','coop')}\"'${button('\"'Race a friend <small>online</small>','online')}</nav><nav class=\\\"minor-nav\\\"> <button class=\\\"text-button\\\" data-action=\\\"howto\\\">How to play</button><button class=\\\"text-button\\\" data-action=\\\"settings\\\">Settings</button><button class=\\\"text-button\\\" data-action=\\\"about\\\">About</button></nav><div class=\\\"edition\\\"><span class=\\\"stamp\\\">SIX SHIFTS. THREE TUBS. NO EXCUSES.</span><button class=\\\"text-button\\\" data-action=\\\"records\\\" style=\\\"font-size:inherit\\\">BEST \"'${best.toLocaleString()} ↗</button></div><div class=\"hero-label\">THE ROOFTOP IS<br>COUNTING ON YOU.<span>Water beats dynamite. Usually.</span></div></section>`);\n  }\n  start(mode='\"'solo',attract=false){\n    this.clearScreen();this.attract=attract;this.game.assist=this.settings.aimAssist||this.input?.last==='touch';this.game.difficulty=this.settings.difficulty;\n    const a=new Uint32Array(1);crypto.getRandomValues(a);this.game.start({mode,seed:attract?1981:a[0],attract});\n    \"'$('\"'hud').hidden=false;\"'$('\"'pause-button').hidden=attract;\"'$('\"'attract-label').hidden=\"'!attract;this.sound.resume();this.updateHud();\n  }\n  startAttract(){\n    this.attractReturn=this.screen||'\"'title';this.start('solo',true);this.toastTimer=0;\"'$('\"'toast').hidden=true;\n  }\n  exitAttract(){\n    this.game.clear();this.game.phase='idle';this.attract=false;\"'$('\"'attract-label').hidden=true;\"'$('\"'hud').hidden=true;this.hideAnnounce();this.stage.targetOffset=-4.3;this.stage.setPlayers(1);this.stage.playerState([{x:0,buckets:3}],1.85);\n    const where=this.attractReturn||'title';if(where==='settings')this.showSettings();else if(where==='about')this.showAbout();else if(where==='howto')this.showHowto();else if(where==='records')this.showRecords();else this.showTitle();this.lastActivity=performance.now();\n  }\n  pause(){\n    if(this.attract){this.exitAttract();return;}\n    if(this.net.ended||this.game.phase==='idle'||this.screen)return;\n    this.hideAnnounce(false);this.setScreen('pause',this.panel(\"'`<div class=\"eyebrow\">${this.net.roundActive?'\"'THE RACE KEEPS RUNNING':'WATER BREAK'}</div><h1>Catch your breath.</h1><p class=\\\"intro\\\">\"'${this.net.roundActive?'\"'Your rivals are still catching. Jump back in when you’re ready.':'Even dynamite can wait a moment.'}</p><nav class=\\\"panel-nav\\\">\"'${button('\"'Back to the roof','resume',true)}\"'${button('\"'Settings','settings')}\"'${!this.net.active?button('\"'Dev workshop','dev'):''}\"'${!this.net.active?button('\"'End this shift','title'):''}</nav>\"'`));\n  }\n  resume(){this.clearScreen();this.sound.resume();if(this.announceTimer>0)$('\"'announcement').hidden=false;}\n  back(){\n    if(this.net.ended)return;\n    if(this.screen==='pause')this.resume();else if(this.screen==='dev')this.pauseFromChild();else if(this.screen==='settings'){if(this.settingsParent==='pause')this.pauseFromChild();else this.showTitle();}\n    else if(this.screen==='about'||this.screen==='howto'||this.screen==='records'||this.screen==='online'){if(this.screen==='online'&&\"'!this.net.roundActive)this.net.disconnect();this.showTitle();}\n    else if(this.screen==='\"'results'){if(this.net.kind==='hub')return;if(this.net.kind==='rtc'&&this.net.connected)this.showOnline();else this.showTitle();}\n  }\n  pauseFromChild(){this.clearScreen();this.pause();}\n  douse(){if(this.screen||this.attract||this.net.ended)return;this.game.douse();this.updateHud();}\n  gameEvent(event,data={}){\n    if(event==='wave'){this.announce(\"'`SHIFT ${String(data.index+1).padStart(2,'\"'0')} / 06\"'`,data.name,data.tip,3);}\n    if(event==='\"'go')this.hideAnnounce();\n    if(event==='clear'){this.announce(data.perfect?'NOT A DROP WASTED':'ROOFTOP STILL STANDING','Shift complete\"'!'\"','One tub restored · Douse topped up',2.8);if(this.game.effects)this.stage.burst(0,6,'gold',50);}\n    if(event==='finish'){\n      if(data.attract){this.attractRestart=performance.now()+2500;this.announce('ON THE HOUSE','Rooftop saved\"'!'\"','Another round of trouble in a moment…',2.5);return;}\n      if(this.net.roundActive)this.net.result(data.score,data.stats);\n      if(\"'!this.net.active&&!data.unranked){this.records.push({score:data.score,won:data.won,caught:data.stats.caught,date:new Date().toISOString().slice(0,10),difficulty:this.game.difficulty});this.records.sort((a,b)=>b.score-a.score);this.records=this.records.slice(0,5);try{localStorage.setItem('\"'ka-whoosh-records',JSON.stringify(this.records));}catch{}}\n      this.hideAnnounce();this.lastResult=data;this.showResults(data);\n    }\n  }\n  showResults(data){\n    if(\"'!data)return;const s=data.stats,accuracy=s.caught+s.misses?Math.round(s.caught/(s.caught+s.misses)*100):0;\n    const rival=this.net.rivalResult;let networkLine='\"'';if(this.net.kind==='rtc')networkLine=\"'`<p class=\"online-status\">${rival?`Rival: ${rival.score.toLocaleString()} · ${data.score>rival.score?'\"'You take the rooftop crown\"'!'\"':data.score===rival.score?'A perfectly soggy tie.':'Your rival takes this one.'}\"'`:'\"'Waiting for your rival to finish…'}</p>\"'`;\n    const actions=this.net.kind==='\"'hub'?'<p class=\\\"small\\\">Result sent. The Hub will take it from here.</p>':this.net.kind==='rtc'&&this.net.connected?\"'`${this.net.host?button('\"'Race again','race-start',true):'<p class=\\\"small\\\">Your friend can start another race.</p>'}\"'${button('\"'Leave race','leave-online')}\"'`:`${button('\"'Another shift','replay',true)}\"'${button('\"'Back to the rooftop','title')}\"'`;\n    this.setScreen('\"'results',this.panel(\"'`<div class=\"eyebrow\">${data.won?'\"'THE ALL-CLEAR':'SHIFT ENDED'}\"'${data.unranked?'\"' · DEV SHIFT':''}</div><h1>\"'${data.won?'\"'Well, that was close.':'A spectacular splash.'}</h1><p class=\\\"intro\\\">\"'${data.won?'\"'Six shifts. One very soggy bandit. Nice work.':data.reason==='time-up'?'Time’s up\"'! Every splash still counts.'\"':'The tubs are gone. The nerve is still there.'}</p><div class=\\\"hud-caption\\\">FINAL SCORE</div><div class=\\\"final-score\\\">\"'${data.score.toLocaleString()}</div><div class=\"rating\">${data.won?'\"'CERTIFIED ROOFTOP HERO':s.caught>40?'WATER BRIGADE MATERIAL':'EVERY GREAT CATCH STARTS WITH A MISS'}</div><div class=\\\"stats-grid\\\"><div class=\\\"stat\\\"><b>\"'${s.caught}</b><span>bombs caught</span></div><div class=\"stat\"><b>${s.bestCombo}</b><span>best streak</span></div><div class=\"stat\"><b>${accuracy}%</b><span>catch rate</span></div><div class=\"stat\"><b>${s.perfect}</b><span>perfect catches</span></div><div class=\"stat\"><b>${s.gold}</b><span>golden catches</span></div><div class=\"stat\"><b>${s.stages}/6</b><span>shifts cleared</span></div></div>${networkLine}<nav class=\"panel-nav\">${actions}</nav>`));\n  }\n  showHowto(){\n    this.setScreen('\"'howto',this.panel(\"'`<div class=\"eyebrow\">A QUICK BRIEFING</div><h1>Keep your cool.<br>And your water.</h1><div class=\"instructions\"><div class=\"instruction\"><span class=\"number\">01</span><div><h3>Catch the trouble</h3><p>Slide the tubs under every bomb. A miss costs one tub. Lose all three and your shift is over.</p></div></div><div class=\"instruction\"><span class=\"number\">02</span><div><h3>Make it perfect</h3><p>Center catches score double. Every ten catches builds your multiplier, all the way to ×5.</p></div></div><div class=\"instruction\"><span class=\"number\">03</span><div><h3>When in doubt, douse</h3><p>A full meter floods every bomb away. Catches recharge it. Gold bombs add bonus points and extra water.</p></div></div><div class=\"instruction\"><span class=\"number\">04</span><div><h3>Six shifts of mischief</h3><p>Wind, paired deliveries and fast red bombs. Every cleared shift restores one tub. In co-op, share the lane and the score.</p></div></div></div><div id=\"howto-controls\" class=\"control-table\"></div><p class=\"small\">Couch co-op: P1 uses A/D + Space or controller 1. P2 uses ←/→ + Enter or controller 2. On touch, drag anywhere to move; a second finger douses. Touch adds a little catch assistance.</p><div class=\"back-row\">${button('\"'Got it','back',true)}<span class=\\\"small\\\">Gold is a bonus. Missing it won’t cost a tub.</span></div>\"'`,true));this.prompts();\n  }\n  settingsRows(){\n    const range=(key,label,val)=>`<div class=\"setting-row\"><label for=\"setting-${key}\">${label}</label><div class=\"range-group\"><input id=\"setting-${key}\" data-setting=\"${key}\" aria-label=\"${label}\" type=\"range\" min=\"0\" max=\"100\" step=\"5\" value=\"${Math.round(val*100)}\"><output class=\"range-value\">${Math.round(val*100)}%</output></div></div>`;\n    const toggle=(key,label,val,on='\"'On',off='Off')=>\"'`<div class=\"setting-row\"><label>${label}</label><button data-action=\"setting:${key}\" data-cycle=\"1\">${val?on:off}</button></div>`;\n    return range('\"'music','Music',this.settings.music)+range('effects','Sound effects',this.settings.effects)+range('voice','Gibberish voices',this.settings.voice)+\"'`<div class=\"setting-row\"><label>Controller glyphs</label><button data-action=\"glyphs\" data-cycle=\"1\">${this.settings.glyphs==='\"'playstation'?'PlayStation':'Xbox'}</button></div><div class=\\\"setting-row\\\"><label>Shift difficulty<small>Applies to local shifts. Online uses Arcade.</small></label><button data-action=\\\"difficulty\\\" data-cycle=\\\"1\\\">\"'${this.settings.difficulty[0].toUpperCase()+this.settings.difficulty.slice(1)}</button></div>`+toggle('\"'aimAssist','Wider catch assist',this.settings.aimAssist)+toggle('reduceMotion','Reduce motion',this.settings.reduceMotion)+toggle('lowFlash','Quieter effects',this.settings.lowFlash);\n  }\n  showSettings(){this.setScreen('settings',this.panel(\"'`<div class=\"eyebrow\">MAKE YOURSELF AT HOME</div><h1>Fine-tune the splash.</h1>${this.settingsRows()}<div class=\"back-row\">${button('\"'All set','back',true)}<button class=\\\"text-button\\\" data-action=\\\"fullscreen\\\">\"'${document.fullscreenElement?'\"'Exit fullscreen':'Fullscreen ↗'}</button></div>\"'`));}\n  showRecords(){\n    this.setScreen('\"'records',this.panel(\"'`<div class=\"eyebrow\">THE BRIGADE NOTICEBOARD</div><h1>Local legends.</h1>${this.records.length?`<ol class=\"record-list\">${this.records.map((r,i)=>`<li><span>${String(i+1).padStart(2,'\"'0')} · \"'${r.won?'\"'Rooftop hero':'Water brigade'}<small>\"'${esc(r.date)} · ${esc(r.difficulty)} · ${r.caught} caught</small></span><strong>${r.score.toLocaleString()}</strong></li>`).join('\"'')}</ol>\"'`:'\"'<p class=\\\"intro\\\">The noticeboard is dry. Your first shift will fix that.</p>'}<p class=\\\"small\\\">Your five best local shifts live on this device. Developer shifts stay off the board.</p><div class=\\\"back-row\\\">\"'${button('\"'Back','back',true)}</div>\"'`));\n  }\n  showAbout(){\n    const tabs=[['\"'source','Source info'],['testing','Testing'],['engine','Engine'],['prompt','Prompt'],['credits','Credits']];let content='';\n    if(this.aboutTab==='source'){content='<dl>'+Object.entries(INFO.sourceInformation).map(([k,v])=>\"'`<dt>${esc(k[0].toUpperCase()+k.slice(1))}</dt><dd>${esc(v)}</dd>`).join('\"'')+'</dl>';}\n    else if(this.aboutTab==='credits'){content='<p><b>Ka-Whoosh\"'!</b><br>An original game inspired by the mischievous, quick-reflex spirit of Kaboom! (1981).</p><p>Design, procedural art, programming, animation and synthesized audio: OpenAI gpt-6.1-sol through Codex CLI.</p><p>Three.js r180 — MIT license.<br>Rapier 0.19.3 — Apache 2.0 license.<br>AI Hub session client 1.4.0 — Michael Crosato.<br>Lato fonts — Łukasz Dziedzic, SIL Open Font License 1.1.</p><p>Every sound is generated in code. No recorded music, samples or speech. Kaboom! and Activision belong to their respective owners. This is an independent homage.</p>'\"';}\n    else {const values=INFO[this.aboutTab+'Feedback'];content='<ol class=\\\"feedback\\\">'+QUESTIONS[this.aboutTab].map((q,i)=>\"'`<li><b>${esc(q)}</b><p>${esc(values[i])}</p></li>`).join('\"'')+'</ol>';}\n    this.setScreen('about',this.panel(\"'`<div class=\"eyebrow\">THE SMALL PRINT, BUT BIGGER</div><h1>Behind the splash.</h1><nav class=\"tabs\">${tabs.map(([k,v])=>`<button class=\"${this.aboutTab===k?'\"'active':''}\\\" data-action=\\\"about:\"'${k}\">${v}</button>`).join('\"'')}</nav><div class=\\\"about-body\\\" tabindex=\\\"0\\\">\"'${content}</div><div class=\"back-row\">${button('\"'Back','back',true)}<span class=\\\"small\\\">A little panic. A lot of code.</span></div>\"'`,true));\n  }\n  showOnline(){\n    this.game.phase='\"'idle';this.game.clear();\"'$('\"'hud').hidden=true;this.stage.targetOffset=-4.3;\n    this.setScreen('online',this.panel(\"'`<div class=\"eyebrow\">A FRIENDLY SPLASH-OFF</div><h1>Two roofs. One rivalry.</h1><p class=\"network-intro\">Both players catch the same deliveries. See your rival’s tubs; chase the higher score. On AI Hub, races connect automatically for up to four players.</p><div id=\"online-status\" class=\"online-status\">${esc(this.net.connectionStatus)}</div><div class=\"inline-actions\">${button('\"'Create an invite','create-invite',true)}\"'${button('\"'Use pasted code','accept-code')}</div><label class=\\\"code-label\\\" for=\\\"incoming-code\\\">Paste an invite or reply here</label><textarea id=\\\"incoming-code\\\" class=\\\"code-area\\\" spellcheck=\\\"false\\\" placeholder=\\\"WHOOSH1.…\\\" aria-label=\\\"Connection code to use\\\">\"'${esc(this.incomingCode||'\"'')}</textarea><div class=\\\"code-label\\\"><label for=\\\"outgoing-code\\\">Your invite / reply</label><button data-action=\\\"copy-code\\\">Copy</button></div><textarea id=\\\"outgoing-code\\\" class=\\\"code-area\\\" readonly aria-label=\\\"Your connection code\\\">\"'${esc(this.outgoingCode||'\"'')}</textarea><button id=\\\"start-race\\\" class=\\\"action primary\\\" data-action=\\\"race-start\\\" style=\\\"width:100%;margin-top:18px\\\" \"'${this.net.connected&&this.net.host?'\"'':'hidden'}>Start the race<span>↗</span></button><p class=\\\"small\\\">Host sends an invite → friend pastes it and sends a reply → host pastes the reply. Both games must stay open. Direct connections use STUN; restrictive networks may need AI Hub.</p><div class=\\\"back-row\\\">\"'${button('\"'Back','back')}<span class=\\\"small\\\">No account. No game server.</span></div>\"'`,true));\n  }\n  showDev(){\n    if(this.net.active)return;this.devTab??='\"'tools';let content='';\n    if(this.devTab==='tools')content=\"'`<div class=\"tool-grid\">${button('\"'Invulnerable: '+(this.game.invulnerable?'ON':'OFF'),'dev:invulnerable',false,\"'`class=\"action${this.game.invulnerable?'\"' on':''}\\\"\"'`)}${button('\"'Auto-catch: '+(this.game.auto?'ON':'OFF'),'dev:auto')}\"'${button('\"'Physics overlay: '+(this.game.hitboxes?'ON':'OFF'),'dev:hitboxes')}\"'${button('\"'Restore all tubs','dev:heal')}\"'${button('\"'Fill douse meter','dev:charge')}\"'${button('\"'Spawn a bomb','dev:bomb')}\"'${button('\"'Spawn gold','dev:gold')}\"'${button('\"'Finish this shift','dev:win')}</div><div class=\\\"eyebrow\\\">JUMP TO A SHIFT</div><div class=\\\"wave-picker\\\">\"'${WAVES.map((_,i)=>`<button data-action=\"wave:${i}\">${i+1}</button>`).join('\"'')}</div><p class=\\\"small\\\">Developer changes mark the shift unranked. Resume to see changes. Physics overlay shows sensor bounds and live simulation counts.</p>\"'`;\n    else {const sliders=[['\"'fall','Fall speed',.4,2,.05],['rate','Drop frequency',.4,2,.05],['width','Tub width',1,3,.05],['speed','Move speed',8,30,1],['gravity','Gravity',1,12,.25],['recharge','Douse / catch',1,20,1],['timeScale','Simulation speed',.25,2,.05]];content=\"'`<div class=\"tune-grid\">${sliders.map(([k,l,min,max,step])=>`<div class=\"setting-row\"><label for=\"tune-${k}\">${l}</label><div class=\"range-group\"><input id=\"tune-${k}\" data-tune=\"${k}\" aria-label=\"${l}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${this.game.tune[k]}\"><output class=\"range-value\">${this.game.tune[k].toFixed(2)}</output></div></div>`).join('\"'')}</div><p class=\\\"small\\\">Changes are live and apply to every new delivery. Restore defaults to return to the original balance.</p>\"'`;}\n    this.setScreen('\"'dev',this.panel(\"'`<div class=\"eyebrow\">THE DEV WORKSHOP · UNRANKED</div><h1>Turn the taps.</h1><nav class=\"tabs\"><button data-action=\"dev-tab:tools\" class=\"${this.devTab==='\"'tools'?'active':''}\\\">Testing tools</button><button data-action=\\\"dev-tab:tuning\\\" class=\\\"\"'${this.devTab==='\"'tuning'?'active':''}\\\">Balance sliders</button></nav>\"'${content}<div class=\"back-row\">${button('\"'Back to pause','back',true)}<button class=\\\"text-button\\\" data-action=\\\"dev:reset\\\">Reset defaults</button></div>\"'`,true));\n  }\n  slider(el){\n    this.activity();if(el.dataset.setting){const k=el.dataset.setting;this.settings[k]=Number(el.value)/100;el.nextElementSibling.textContent=el.value+'\"'%';this.applySettings();}\n    if(el.dataset.tune){const k=el.dataset.tune;this.game.tune[k]=Number(el.value);el.nextElementSibling.textContent=Number(el.value).toFixed(2);this.game.unranked=true;this.game.applyTune();}\n  }\n  async action(action,el){\n    if(this.net.ended)return;\n    if(action==='solo')this.start('solo');else if(action==='coop')this.start('coop');else if(action==='replay')this.start(this.game.mode);\n    else if(action==='title'){this.net.disconnect();this.showTitle();}else if(action==='resume')this.resume();else if(action==='back')this.back();\n    else if(action==='howto')this.showHowto();else if(action==='settings'){this.settingsParent=this.screen==='pause'?'pause':'title';this.showSettings();}\n    else if(action==='about'){this.aboutTab='source';this.showAbout();}else if(action.startsWith('about:')){this.aboutTab=action.slice(6);this.showAbout();}\n    else if(action==='records')this.showRecords();else if(action==='online')this.showOnline();else if(action==='fullscreen')this.fullscreen();\n    else if(action==='glyphs'){this.settings.glyphs=this.settings.glyphs==='playstation'?'xbox':'playstation';this.applySettings();el.textContent=this.settings.glyphs==='playstation'?'PlayStation':'Xbox';}\n    else if(action==='difficulty'){const ds=['chill','arcade','wild'];this.settings.difficulty=ds[(ds.indexOf(this.settings.difficulty)+1)%3];this.applySettings();el.textContent=this.settings.difficulty[0].toUpperCase()+this.settings.difficulty.slice(1);}\n    else if(action.startsWith('setting:')){const k=action.slice(8);this.settings[k]=\"'!this.settings[k];this.applySettings();el.textContent=this.settings[k]?'\"'On':'Off';}\n    else if(action==='dev')this.showDev();else if(action.startsWith('dev-tab:')){this.devTab=action.slice(8);this.showDev();}\n    else if(action.startsWith('wave:')){this.game.jumpWave(Number(action.slice(5)));this.resume();}\n    else if(action.startsWith('dev:'))this.devAction(action.slice(4));\n    else if(action==='create-invite'||action==='accept-code'){\n      el.disabled=true;try{let code;if(action==='create-invite')code=await this.net.createOffer();else{this.incomingCode=\"'$('\"'incoming-code').value;code=await this.net.accept(this.incomingCode);}if(code){this.outgoingCode=code;if(\"'$('\"'outgoing-code'))\"'$('\"'outgoing-code').value=code;}}catch(e){this.net.setStatus(e.message);}finally{el.disabled=false;}\n    }else if(action==='copy-code'){const code=\"'$('\"'outgoing-code').value;if(\"'!code){this.net.setStatus('\"'Create an invite or accept a code first.');return;}try{await navigator.clipboard.writeText(code);this.toast('Connection code copied.');}catch{\"'$('\"'outgoing-code').focus();\"'$('\"'outgoing-code').select();this.net.setStatus('Code selected. Copy it with your device’s copy command.');}}\n    else if(action==='race-start')this.net.beginRace();else if(action==='leave-online'){this.net.disconnect();this.showTitle();}\n  }\n  devAction(k){\n    this.game.unranked=true;\n    if(['invulnerable','auto','hitboxes'].includes(k))this.game[k]=\"'!this.game[k];\n    if(k==='\"'heal'){for(const p of this.game.players){p.buckets=3;this.game.syncSensors(p);}}\n    if(k==='charge')this.game.charge=100;\n    if(k==='bomb'||k==='gold')this.game.spawn(k==='gold'?'gold':'normal',this.game.players[0].x,6);\n    if(k==='win'){this.game.finish(true);return;}\n    if(k==='reset'){Object.assign(this.game.tune,DEFAULTS);this.game.invulnerable=false;this.game.auto=false;this.game.hitboxes=false;this.game.applyTune();this.toast('Original balance restored.');}\n    this.showDev();\n  }\n  async fullscreen(){try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen();}catch{this.toast('Fullscreen is unavailable in this browser.');}}\n  waiting(){\n    this.hideAnnounce();this.setScreen('waiting',this.panel('<div class=\\\"eyebrow\\\">THE BRIGADE IS LINING UP</div><h1>Ready on the roof.</h1><p id=\\\"waiting-copy\\\" class=\\\"intro\\\">The next shift starts together.</p><p class=\\\"small\\\">Move with left stick, A/D, mouse or a drag. Douse with Cross / A, Space, click or a second touch.</p>'));if(\"'$('\"'hud'))\"'$('\"'hud').hidden=true;\n  }\n  hubCountdown(t){if(this.screen\"'!=='\"'waiting')return;const e=\"'$('\"'waiting-copy');if(e)e.textContent=Number.isFinite(t)?\"'`First delivery in ${Math.max(1,Math.ceil(-t/1000))}…`:'\"'Waiting for the brigade…';}\n  networkStart(seed){\n    this.clearScreen();this.game.invulnerable=false;this.game.auto=false;this.game.hitboxes=false;Object.assign(this.game.tune,DEFAULTS);this.game.assist=this.settings.aimAssist||this.input?.last==='touch';\n    this.game.start({mode:'race',seed,difficulty:'arcade'});this.attract=false;\"'$('\"'attract-label').hidden=true;\"'$('\"'hud').hidden=false;\"'$('\"'pause-button').hidden=false;this.sound.resume();this.updateHud();\n  }\n  showHubEnd(){this.setScreen('hub-ended',this.panel('<div class=\\\"eyebrow\\\">SHIFT COMPLETE</div><h1>That’s a wrap.</h1><p class=\\\"intro\\\">Your rooftop report is with the Hub.</p>'));}\n  renderRivals(){\n    const parent=\"'$('\"'net-scores');if(\"'!parent)return;parent.replaceChildren();\n    for(const [id,p]of this.net.peers){const row=document.createElement('\"'div');row.className='rival';row.style.borderLeft='6px solid '+p.color;const name=document.createElement('span');name.textContent=p.name;const score=document.createElement('b');score.textContent=p.score.toLocaleString();row.append(name,score);parent.append(row);if(this.stage&&this.game)this.stage.updateGhost(id,{...p,visible:p.stage===this.game.wave},p.color);}\n  }\n  prompts(){\n    const type=this.input?.last||'keyboard',pad=type==='pad',xbox=this.settings.glyphs==='xbox';\n    const move=pad?glyph('L',true):type==='touch'?'DRAG':glyph('A')+' '+glyph('D');\n    const douse=pad?glyph(xbox?'A':'×',true):type==='touch'?'2ND TOUCH':type==='mouse'?glyph('CLICK'):glyph('SPACE');\n    if(\"'$('\"'control-hint'))\"'$('\"'control-hint').innerHTML=\"'`<span class=\"hint-group\">${move} MOVE</span><span class=\"hint-group\">${douse} DOUSE</span><span class=\"hint-group\">${pad?glyph('\"'☰'):glyph('ESC')} MENU</span>\"'`;\n    if($('\"'douse-label'))\"'$('\"'douse-label').innerHTML='DOUSE '+douse;\n    if(\"'$('\"'howto-controls'))\"'$('\"'howto-controls').innerHTML=\"'`<span><b>MOVE</b> ${move}${type==='\"'mouse'?' / mouse':''}</span><span><b>DOUSE</b> \"'${douse}</span><span><b>MENU</b> ${pad?glyph('\"'☰'):glyph('ESC')}</span>\"'`;\n  }\n  announce(over,title,sub,seconds){$('\"'announce-over').textContent=over;\"'$('\"'announce-title').textContent=title;\"'$('\"'announce-sub').textContent=sub;\"'$('\"'announcement').hidden=false;this.announceTimer=seconds;}\n  hideAnnounce(reset=true){\"'$('\"'announcement').hidden=true;if(reset)this.announceTimer=0;}\n  toast(message){\"'$('\"'toast').textContent=message;\"'$('\"'toast').hidden=false;this.toastTimer=3;}\n  updateHud(){\n    const g=this.game;if(\"'!g)return;$('\"'score').textContent=String(Math.round(g.score)).padStart(6,'0');\"'$('\"'best').textContent=Math.max(0,...this.records.map(r=>r.score)).toLocaleString();\n    \"'$('\"'wave-number').textContent=\"'`SHIFT ${String((g.wave||0)+1).padStart(2,'\"'0')} / 06\"'`;$('\"'wave-name').textContent=WAVES[g.wave||0].name;\"'$('\"'wave-pips').innerHTML=WAVES.map((_,i)=>\"'`<i class=\"${i<=(g.wave||0)?'\"'on':''}\\\"></i>\"'`).join('\"'');\n    \"'$('\"'douse-fill').style.width=g.charge+'%';\"'$('\"'douse-button').classList.toggle('ready',g.charge>=99.9);\"'$('\"'douse-tip').textContent=g.charge>=99.9?'A little rain, right when you need it.':Math.round(g.charge)+'% · Catches refill the meter.';\n    \"'$('\"'combo').innerHTML=\"'`<b>×${g.multiplier||1}</b> MULTIPLIER<small>${g.combo?g.combo+'\"' in a row · Keep it flowing.':'Center the catch. Stack the score.'}</small>\"'`;\n    $('\"'dev-indicator').hidden=\"'!g.unranked;$('\"'debug-state').hidden=\"'!g.hitboxes;\n    if(g.hitboxes)$('\"'debug-state').textContent=\"'`RAPIER ${g.version}'\"\\\\n\"'${this.stage.backend}'\"\\\\nBodies: \"'${g.world.bodies.len()}  Bombs: ${g.bombs.length}'\"\\\\nSensors: \"'${g.players.reduce((s,p)=>s+p.buckets,0)}  Step: 1/120 s'\"\\\\nSeed: \"'${g.seed}  Time: ${g.elapsed.toFixed(1)} s`;\n  }\n  updateHitboxes(){\n    if(!this.hitboxGroup){this.hitboxGroup=document.createElement('\"'canvas');this.hitboxGroup.style='position:fixed;inset:0;pointer-events:none;z-index:3';document.body.append(this.hitboxGroup);}\n    this.hitboxGroup.hidden=\"'!this.game.hitboxes||$('\"'hud').hidden;if(this.hitboxGroup.hidden)return;\n    const can=this.hitboxGroup;can.width=innerWidth;can.height=innerHeight;const c=can.getContext('2d');c.strokeStyle='#f07848';c.lineWidth=3;c.setLineDash([7,4]);\n    const project=(x,y)=>{const v=this.stage.camera.position.clone();v.set(x,y,.45).project(this.stage.camera);return [(v.x+1)*innerWidth/2,(1-v.y)*innerHeight/2];};\n    for(const p of this.game.players)for(let j=0;j<p.buckets;j++){const a=project(p.x-this.game.effectiveWidth()/2,1.36+j*.82+.11),b=project(p.x+this.game.effectiveWidth()/2,1.36+j*.82-.11);c.strokeRect(a[0],a[1],b[0]-a[0],b[1]-a[1]);}\n    for(const b of this.game.bombs){const p=project(b.x,b.y),q=project(b.x+.29,b.y);c.beginPath();c.arc(p[0],p[1],Math.abs(q[0]-p[0]),0,Math.PI*2);c.stroke();}\n  }\n  frame(t){\n    if(\"'!this.ready)return;const dt=Math.min(.06,this.lastFrame?(t-this.lastFrame)/1000:1/60);this.lastFrame=t;this.input.poll(t);\n    this.net.update(t,this.game.snapshot());\n    const runs=!this.screen||this.attract||this.net.roundActive;\n    if(runs){this.game.update(dt,this.screen?[{},{}]:this.input.controls());if(this.announceTimer>0){this.announceTimer-=dt;if(this.announceTimer<=0)this.hideAnnounce();}}\n    if(this.game.players.length&&this.game.phase!=='\"'idle'){this.stage.playerState(this.game.players,this.game.effectiveWidth());this.stage.updateBombs(this.game.bombs);}\n    this.stage.render(dt,{bomberX:this.game.phase==='idle'?Math.sin(t*.0005)*.3:this.game.bomberX,running:this.game.phase==='playing',reduceMotion:this.settings.reduceMotion,held:this.game.grace===0});\n    if(t>=this.nextHud){this.nextHud=t+100;this.updateHud();this.updateHitboxes();}\n    this.sound.update();if(this.toastTimer>0){this.toastTimer-=dt;if(this.toastTimer<=0)\"'$('\"'toast').hidden=true;}\n    if(this.attractRestart&&t>=this.attractRestart){this.attractRestart=0;if(this.attract)this.start('solo',true);}\n    if(\"'!this.attract&&!this.net.active&&!this.net.pc&&['\"'title','howto','settings','about','records','online'].includes(this.screen)&&t-this.lastActivity>=10000)this.startAttract();\n    if(this.net.kind==='rtc'&&this.net.startAt&&\"'$('\"'waiting-copy'))\"'$('\"'waiting-copy').textContent=\"'`First delivery in ${Math.max(1,Math.ceil((this.net.startAt-Date.now())/1000))}…`;\n  }\n}\nconst app=new App();\napp.init().catch(e=>{console.error(e);window.__gameError=String(e.stack||e);if(window.AIHub?.active)window.AIHub.fail('\"'Ka-Whoosh could not initialize: '+e.message);\"'$('\"'loading').innerHTML='<div class=\\\"error-panel\\\"><h1>The tubs hit a snag.</h1><p>Use a browser with WebGPU or WebGL 2 enabled, then reload this file.</p><p id=\\\"error-detail\\\"></p></div>';\"'$('\"'error-detail').textContent=e.message;});\nEOF\ncat > build.mjs <<'EOF'\nimport {build} from 'esbuild';\nimport fs from 'node:fs/promises';\nimport path from 'node:path';\nconst root=path.dirname(new URL(import.meta.url).pathname);\nconst result=await build({entryPoints:[path.join(root,'src/app.js')],bundle:true,write:false,format:'esm',target:'es2022',minify:true,legalComments:'inline',logLevel:'silent'});\nlet html=await fs.readFile(path.join(root,'src/template.html'),'utf8');\nconst client=await fs.readFile(path.join(root,'vendor/hub-session.js'),'utf8');\nlet css=await fs.readFile(path.join(root,'src/style.css'),'utf8');\nfor(const [tag,file]of [['DISPLAY','display'],['BODY','body']])css=css.replace(\"'`__${tag}_FONT__`,'\"'data:font/ttf;base64,'+(await fs.readFile(path.join(root,\"'`assets/${file}.ttf`))).toString('\"'base64'));\nhtml=html.replace('<\"'!-- HUB_CLIENT -->'\"',()=>\"'`<script>${client}</script>`).replace('\"'/* STYLES */',()=>css).replace('/* BUNDLE */',()=>result.outputFiles[0].text.replace(/<\\\\/script/gi,'<\\\\\\\\/script'));\nconst filename='Ka-Whoosh-Kaboom-gpt-6.1-sol-max-20261105-191412.html';\nawait fs.writeFile(path.join(root,'..',filename),html);\nawait fs.copyFile(path.join(root,'metadata.json'),path.join(root,'..','exit-interview.json'));\nfor(const name of ['harness.html','bridge.js','round.js'])await fs.copyFile(path.join(root,'vendor','hub-'+name),path.join(root,name));\nconsole.log(\"'`Built ${filename} (${(Buffer.byteLength(html)/1024/1024).toFixed(2)} MiB, self-contained)`);\nEOF\nnpm run build'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > src/app.js <<'EOF'\nimport {Stage,C} from './scene.js';\nimport {Game,DEFAULTS,WAVES} from './game.js';\nimport {Sound} from './audio.js';\nimport {Input} from './input.js';\nimport {Network} from './network.js';\nimport INFO from '../metadata.json';\n\nconst \"'$=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"'\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst button=(text,action,primary=false,extra='')=>\"'`<button class=\"action${primary?'\"' primary':''}\\\" data-action=\\\"\"'${action}\" ${extra}>${text}<span class=\"menu-arrow\">↗</span></button>`;\nconst glyph=(text,pad=false)=>`<span class=\"glyph${pad?'\"' pad':''}\\\">\"'${text}</span>`;\nconst QUESTIONS={testing:['\"'How many issues did testing catch?','How many were critical or game breaking?','Most helpful test?','Least helpful test?'],engine:['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important thing you built yourself?','Hardest part of using the engine?','What did you change in the engine, and why?','One thing you would change?'],prompt:['What did you like most about this prompt?','What was confusing?','What was hardest?','What would you change?']};\n\nclass App {\n  constructor(){\n    this.sound=new Sound();this.screen=null;this.previousScreen='title';this.aboutTab='source';this.devTab='tools';this.attract=false;this.lastActivity=performance.now();this.lastFrame=0;this.nextHud=0;this.announceTimer=0;this.toastTimer=0;this.ready=false;this.settingsParent='title';this.settings={music:.1,effects:.65,voice:.55,glyphs:'playstation',difficulty:'arcade',reduceMotion:false,aimAssist:false,lowFlash:false};this.records=[];\n    try{const s=JSON.parse(localStorage.getItem('ka-whoosh-settings')||'null');if(s)Object.assign(this.settings,s);this.records=JSON.parse(localStorage.getItem('ka-whoosh-records')||'[]');if(\"'!Array.isArray(this.records))this.records=[];}catch{}\n    this.net=new Network({\n      waiting:()=>this.waiting(),countdown:t=>this.hubCountdown(t),start:seed=>this.networkStart(seed),\n      timeUp:()=>{if(this.game&&!this.net.reported)this.game.finish(false,'\"'time-up');},\n      end:()=>{if(this.game)this.game.phase='ended';this.sound.stop();this.hideAnnounce();this.showHubEnd();},\n      ghost:(id,p)=>{if(this.stage&&this.game)this.stage.updateGhost(id,{...p,visible:p.stage===this.game.wave},p.color);this.renderRivals();},\n      removeGhost:id=>{this.stage?.removeGhost(id);this.renderRivals();},\n      status:t=>{if(\"'$('\"'online-status'))\"'$('\"'online-status').textContent=t;},\n      connected:host=>{if(\"'$('\"'start-race'))\"'$('\"'start-race').hidden=\"'!host;},\n      rivalResult:()=>{if(this.screen==='\"'results')this.showResults(this.lastResult);},\n      disconnect:()=>this.toast('Rival disconnected. Your shift continues.'),\n    });\n  }\n  async init(){\n    await document.fonts.ready;await Promise.all([document.fonts.load('900 32px Display'),document.fonts.load('400 20px Body')]);\n    this.stage=new Stage(\"'$('\"'world'));await this.stage.init();this.game=new Game(this.stage,this.sound,(event,data)=>this.gameEvent(event,data));await this.game.init();this.game.assist=this.settings.aimAssist;this.input=new Input(this);this.applySettings();this.bind();\n    this.stage.playerState([{x:0,buckets:3}],1.85);await this.stage.screenshotReady();\n    this.ready=true;this.lastActivity=performance.now();\"'$('\"'loading').hidden=true;\n    if(this.net.kind==='hub')this.waiting();else this.showTitle();\n    this.stage.renderer.setAnimationLoop(t=>this.frame(t));await this.net.ready();\n    window.__KA_WHOOSH__={app:this,game:this.game,stage:this.stage,sound:this.sound,network:this.net,info:INFO,ready:true,\n      snapshot:()=>this.game.snapshot(),\n      advance:(seconds,{auto=false,effects=false}={})=>{const oldAuto=this.game.auto,oldEffects=this.game.effects;this.game.auto=auto;this.game.effects=effects;for(let i=0;i<Math.ceil(seconds*120);i++){if(['won','lost','ended'].includes(this.game.phase))break;this.game.step(1/120,[]);}this.game.auto=oldAuto;this.game.effects=oldEffects;this.updateHud();return this.game.snapshot();},\n    };window.__gameReady=true;\n  }\n  bind(){\n    \"'$('\"'screen').addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b&&\"'!b.disabled){this.activity();this.sound.unlock();this.sound.play('\"'click');this.action(b.dataset.action,b);}});\n    \"'$('\"'screen').addEventListener('input',e=>this.slider(e.target));\n    \"'$('\"'pause-button').onclick=()=>this.pause();\"'$('\"'douse-button').onclick=()=>this.douse();\n    document.addEventListener('visibilitychange',()=>{if(document.hidden&&this.game&&this.game.phase\"'!=='\"'idle'&&\"'!this.net.roundActive&&!this.attract&&!this.screen)this.pause();});\n  }\n  activity(){\n    this.lastActivity=performance.now();\n    if(!this.net.ended){this.sound.resume();this.sound.unlock();}\n    if(this.attract){this.exitAttract();return true;}return false;\n  }\n  applySettings(){\n    this.sound.musicVolume=Math.max(0,Math.min(1,Number(this.settings.music)));this.sound.effectsVolume=Number(this.settings.effects);this.sound.voiceVolume=Number(this.settings.voice);this.sound.volumes();\n    document.body.classList.toggle('\"'reduce-motion',this.settings.reduceMotion);document.body.classList.toggle('low-flash',this.settings.lowFlash);\n    if(this.game){this.game.assist=this.settings.aimAssist||this.input?.last==='touch';this.game.difficulty=this.settings.difficulty;this.game.applyTune();}\n    try{localStorage.setItem('ka-whoosh-settings',JSON.stringify(this.settings));}catch{}this.prompts();\n  }\n  panel(content,wide=false){return \"'`<div class=\"shade\"><section class=\"panel${wide?'\"' wide':''}\\\" role=\\\"dialog\\\" aria-modal=\\\"true\\\">\"'${content}</section></div>`;}\n  setScreen(name,html){this.screen=name;$('\"'screen').innerHTML=html;this.input?.clear();this.prompts();queueMicrotask(()=>{const first=this.input?.elements()[0];first?.focus({preventScroll:true});});}\n  clearScreen(){this.screen=null;\"'$('\"'screen').innerHTML='';this.input?.clear();}\n  showTitle(){\n    if(this.net.kind==='hub')return;\n    this.game.phase='idle';this.game.clear();this.attract=false;\"'$('\"'attract-label').hidden=true;\"'$('\"'hud').hidden=true;\"'$('\"'pause-button').hidden=false;this.hideAnnounce();this.stage.targetOffset=-4.3;this.stage.setPlayers(1);this.stage.playerState([{x:0,buckets:3}],1.85);this.sound.resume();this.lastActivity=performance.now();\n    const best=this.records.length?Math.max(...this.records.map(r=>r.score)):0;\n    this.setScreen('title',\"'`<section class=\"title-screen\"><div class=\"eyebrow\">Rooftop water brigade · Est. 1981</div><h1 class=\"title-logo\" aria-label=\"Ka-Whoosh!\"><span>KA–</span><span class=\"whoosh\">WHOOSH!</span></h1><p class=\"title-description\"><b>A little panic. A lot of splash.</b><br>Catch trouble before it hits the roof.</p><nav class=\"title-nav\" aria-label=\"Main menu\">${button('\"'Start a solo shift','solo',true)}\"'${button('\"'Two at the tubs <small>couch co-op</small>','coop')}\"'${button('\"'Race a friend <small>online</small>','online')}</nav><nav class=\\\"minor-nav\\\"> <button class=\\\"text-button\\\" data-action=\\\"howto\\\">How to play</button><button class=\\\"text-button\\\" data-action=\\\"settings\\\">Settings</button><button class=\\\"text-button\\\" data-action=\\\"about\\\">About</button></nav><div class=\\\"edition\\\"><span class=\\\"stamp\\\">SIX SHIFTS. THREE TUBS. NO EXCUSES.</span><button class=\\\"text-button\\\" data-action=\\\"records\\\" style=\\\"font-size:inherit\\\">BEST \"'${best.toLocaleString()} ↗</button></div><div class=\"hero-label\">THE ROOFTOP IS<br>COUNTING ON YOU.<span>Water beats dynamite. Usually.</span></div></section>`);\n  }\n  start(mode='\"'solo',attract=false){\n    this.clearScreen();this.attract=attract;this.game.assist=this.settings.aimAssist||this.input?.last==='touch';this.game.difficulty=this.settings.difficulty;\n    const a=new Uint32Array(1);crypto.getRandomValues(a);this.game.start({mode,seed:attract?1981:a[0],attract});\n    \"'$('\"'hud').hidden=false;\"'$('\"'pause-button').hidden=attract;\"'$('\"'attract-label').hidden=\"'!attract;this.sound.resume();this.updateHud();\n  }\n  startAttract(){\n    this.attractReturn=this.screen||'\"'title';this.start('solo',true);this.toastTimer=0;\"'$('\"'toast').hidden=true;\n  }\n  exitAttract(){\n    this.game.clear();this.game.phase='idle';this.attract=false;\"'$('\"'attract-label').hidden=true;\"'$('\"'hud').hidden=true;this.hideAnnounce();this.stage.targetOffset=-4.3;this.stage.setPlayers(1);this.stage.playerState([{x:0,buckets:3}],1.85);\n    const where=this.attractReturn||'title';if(where==='settings')this.showSettings();else if(where==='about')this.showAbout();else if(where==='howto')this.showHowto();else if(where==='records')this.showRecords();else this.showTitle();this.lastActivity=performance.now();\n  }\n  pause(){\n    if(this.attract){this.exitAttract();return;}\n    if(this.net.ended||this.game.phase==='idle'||this.screen)return;\n    this.hideAnnounce(false);this.setScreen('pause',this.panel(\"'`<div class=\"eyebrow\">${this.net.roundActive?'\"'THE RACE KEEPS RUNNING':'WATER BREAK'}</div><h1>Catch your breath.</h1><p class=\\\"intro\\\">\"'${this.net.roundActive?'\"'Your rivals are still catching. Jump back in when you’re ready.':'Even dynamite can wait a moment.'}</p><nav class=\\\"panel-nav\\\">\"'${button('\"'Back to the roof','resume',true)}\"'${button('\"'Settings','settings')}\"'${!this.net.active?button('\"'Dev workshop','dev'):''}\"'${!this.net.active?button('\"'End this shift','title'):''}</nav>\"'`));\n  }\n  resume(){this.clearScreen();this.sound.resume();if(this.announceTimer>0)$('\"'announcement').hidden=false;}\n  back(){\n    if(this.net.ended)return;\n    if(this.screen==='pause')this.resume();else if(this.screen==='dev')this.pauseFromChild();else if(this.screen==='settings'){if(this.settingsParent==='pause')this.pauseFromChild();else this.showTitle();}\n    else if(this.screen==='about'||this.screen==='howto'||this.screen==='records'||this.screen==='online'){if(this.screen==='online'&&\"'!this.net.roundActive)this.net.disconnect();this.showTitle();}\n    else if(this.screen==='\"'results'){if(this.net.kind==='hub')return;if(this.net.kind==='rtc'&&this.net.connected)this.showOnline();else this.showTitle();}\n  }\n  pauseFromChild(){this.clearScreen();this.pause();}\n  douse(){if(this.screen||this.attract||this.net.ended)return;this.game.douse();this.updateHud();}\n  gameEvent(event,data={}){\n    if(event==='wave'){this.announce(\"'`SHIFT ${String(data.index+1).padStart(2,'\"'0')} / 06\"'`,data.name,data.tip,3);}\n    if(event==='\"'go')this.hideAnnounce();\n    if(event==='clear'){this.announce(data.perfect?'NOT A DROP WASTED':'ROOFTOP STILL STANDING','Shift complete\"'!'\"','One tub restored · Douse topped up',2.8);if(this.game.effects)this.stage.burst(0,6,'gold',50);}\n    if(event==='finish'){\n      if(data.attract){this.attractRestart=performance.now()+2500;this.announce('ON THE HOUSE','Rooftop saved\"'!'\"','Another round of trouble in a moment…',2.5);return;}\n      if(this.net.roundActive)this.net.result(data.score,data.stats);\n      if(\"'!this.net.active&&!data.unranked){this.records.push({score:data.score,won:data.won,caught:data.stats.caught,date:new Date().toISOString().slice(0,10),difficulty:this.game.difficulty});this.records.sort((a,b)=>b.score-a.score);this.records=this.records.slice(0,5);try{localStorage.setItem('\"'ka-whoosh-records',JSON.stringify(this.records));}catch{}}\n      this.hideAnnounce();this.lastResult=data;this.showResults(data);\n    }\n  }\n  showResults(data){\n    if(\"'!data)return;const s=data.stats,accuracy=s.caught+s.misses?Math.round(s.caught/(s.caught+s.misses)*100):0;\n    const rival=this.net.rivalResult;let networkLine='\"'';if(this.net.kind==='rtc')networkLine=\"'`<p class=\"online-status\">${rival?`Rival: ${rival.score.toLocaleString()} · ${data.score>rival.score?'\"'You take the rooftop crown\"'!'\"':data.score===rival.score?'A perfectly soggy tie.':'Your rival takes this one.'}\"'`:'\"'Waiting for your rival to finish…'}</p>\"'`;\n    const actions=this.net.kind==='\"'hub'?'<p class=\\\"small\\\">Result sent. The Hub will take it from here.</p>':this.net.kind==='rtc'&&this.net.connected?\"'`${this.net.host?button('\"'Race again','race-start',true):'<p class=\\\"small\\\">Your friend can start another race.</p>'}\"'${button('\"'Leave race','leave-online')}\"'`:`${button('\"'Another shift','replay',true)}\"'${button('\"'Back to the rooftop','title')}\"'`;\n    this.setScreen('\"'results',this.panel(\"'`<div class=\"eyebrow\">${data.won?'\"'THE ALL-CLEAR':'SHIFT ENDED'}\"'${data.unranked?'\"' · DEV SHIFT':''}</div><h1>\"'${data.won?'\"'Well, that was close.':'A spectacular splash.'}</h1><p class=\\\"intro\\\">\"'${data.won?'\"'Six shifts. One very soggy bandit. Nice work.':data.reason==='time-up'?'Time’s up\"'! Every splash still counts.'\"':'The tubs are gone. The nerve is still there.'}</p><div class=\\\"hud-caption\\\">FINAL SCORE</div><div class=\\\"final-score\\\">\"'${data.score.toLocaleString()}</div><div class=\"rating\">${data.won?'\"'CERTIFIED ROOFTOP HERO':s.caught>40?'WATER BRIGADE MATERIAL':'EVERY GREAT CATCH STARTS WITH A MISS'}</div><div class=\\\"stats-grid\\\"><div class=\\\"stat\\\"><b>\"'${s.caught}</b><span>bombs caught</span></div><div class=\"stat\"><b>${s.bestCombo}</b><span>best streak</span></div><div class=\"stat\"><b>${accuracy}%</b><span>catch rate</span></div><div class=\"stat\"><b>${s.perfect}</b><span>perfect catches</span></div><div class=\"stat\"><b>${s.gold}</b><span>golden catches</span></div><div class=\"stat\"><b>${s.stages}/6</b><span>shifts cleared</span></div></div>${networkLine}<nav class=\"panel-nav\">${actions}</nav>`));\n  }\n  showHowto(){\n    this.setScreen('\"'howto',this.panel(\"'`<div class=\"eyebrow\">A QUICK BRIEFING</div><h1>Keep your cool.<br>And your water.</h1><div class=\"instructions\"><div class=\"instruction\"><span class=\"number\">01</span><div><h3>Catch the trouble</h3><p>Slide the tubs under every bomb. A miss costs one tub. Lose all three and your shift is over.</p></div></div><div class=\"instruction\"><span class=\"number\">02</span><div><h3>Make it perfect</h3><p>Center catches score double. Every ten catches builds your multiplier, all the way to ×5.</p></div></div><div class=\"instruction\"><span class=\"number\">03</span><div><h3>When in doubt, douse</h3><p>A full meter floods every bomb away. Catches recharge it. Gold bombs add bonus points and extra water.</p></div></div><div class=\"instruction\"><span class=\"number\">04</span><div><h3>Six shifts of mischief</h3><p>Wind, paired deliveries and fast red bombs. Every cleared shift restores one tub. In co-op, share the lane and the score.</p></div></div></div><div id=\"howto-controls\" class=\"control-table\"></div><p class=\"small\">Couch co-op: P1 uses A/D + Space or controller 1. P2 uses ←/→ + Enter or controller 2. On touch, drag anywhere to move; a second finger douses. Touch adds a little catch assistance.</p><div class=\"back-row\">${button('\"'Got it','back',true)}<span class=\\\"small\\\">Gold is a bonus. Missing it won’t cost a tub.</span></div>\"'`,true));this.prompts();\n  }\n  settingsRows(){\n    const range=(key,label,val)=>`<div class=\"setting-row\"><label for=\"setting-${key}\">${label}</label><div class=\"range-group\"><input id=\"setting-${key}\" data-setting=\"${key}\" aria-label=\"${label}\" type=\"range\" min=\"0\" max=\"100\" step=\"5\" value=\"${Math.round(val*100)}\"><output class=\"range-value\">${Math.round(val*100)}%</output></div></div>`;\n    const toggle=(key,label,val,on='\"'On',off='Off')=>\"'`<div class=\"setting-row\"><label>${label}</label><button data-action=\"setting:${key}\" data-cycle=\"1\">${val?on:off}</button></div>`;\n    return range('\"'music','Music',this.settings.music)+range('effects','Sound effects',this.settings.effects)+range('voice','Gibberish voices',this.settings.voice)+\"'`<div class=\"setting-row\"><label>Controller glyphs</label><button data-action=\"glyphs\" data-cycle=\"1\">${this.settings.glyphs==='\"'playstation'?'PlayStation':'Xbox'}</button></div><div class=\\\"setting-row\\\"><label>Shift difficulty<small>Applies to local shifts. Online uses Arcade.</small></label><button data-action=\\\"difficulty\\\" data-cycle=\\\"1\\\">\"'${this.settings.difficulty[0].toUpperCase()+this.settings.difficulty.slice(1)}</button></div>`+toggle('\"'aimAssist','Wider catch assist',this.settings.aimAssist)+toggle('reduceMotion','Reduce motion',this.settings.reduceMotion)+toggle('lowFlash','Quieter effects',this.settings.lowFlash);\n  }\n  showSettings(){this.setScreen('settings',this.panel(\"'`<div class=\"eyebrow\">MAKE YOURSELF AT HOME</div><h1>Fine-tune the splash.</h1>${this.settingsRows()}<div class=\"back-row\">${button('\"'All set','back',true)}<button class=\\\"text-button\\\" data-action=\\\"fullscreen\\\">\"'${document.fullscreenElement?'\"'Exit fullscreen':'Fullscreen ↗'}</button></div>\"'`));}\n  showRecords(){\n    this.setScreen('\"'records',this.panel(\"'`<div class=\"eyebrow\">THE BRIGADE NOTICEBOARD</div><h1>Local legends.</h1>${this.records.length?`<ol class=\"record-list\">${this.records.map((r,i)=>`<li><span>${String(i+1).padStart(2,'\"'0')} · \"'${r.won?'\"'Rooftop hero':'Water brigade'}<small>\"'${esc(r.date)} · ${esc(r.difficulty)} · ${r.caught} caught</small></span><strong>${r.score.toLocaleString()}</strong></li>`).join('\"'')}</ol>\"'`:'\"'<p class=\\\"intro\\\">The noticeboard is dry. Your first shift will fix that.</p>'}<p class=\\\"small\\\">Your five best local shifts live on this device. Developer shifts stay off the board.</p><div class=\\\"back-row\\\">\"'${button('\"'Back','back',true)}</div>\"'`));\n  }\n  showAbout(){\n    const tabs=[['\"'source','Source info'],['testing','Testing'],['engine','Engine'],['prompt','Prompt'],['credits','Credits']];let content='';\n    if(this.aboutTab==='source'){content='<dl>'+Object.entries(INFO.sourceInformation).map(([k,v])=>\"'`<dt>${esc(k[0].toUpperCase()+k.slice(1))}</dt><dd>${esc(v)}</dd>`).join('\"'')+'</dl>';}\n    else if(this.aboutTab==='credits'){content='<p><b>Ka-Whoosh\"'!</b><br>An original game inspired by the mischievous, quick-reflex spirit of Kaboom! (1981).</p><p>Design, procedural art, programming, animation and synthesized audio: OpenAI gpt-6.1-sol through Codex CLI.</p><p>Three.js r180 — MIT license.<br>Rapier 0.19.3 — Apache 2.0 license.<br>AI Hub session client 1.4.0 — Michael Crosato.<br>Lato fonts — Łukasz Dziedzic, SIL Open Font License 1.1.</p><p>Every sound is generated in code. No recorded music, samples or speech. Kaboom! and Activision belong to their respective owners. This is an independent homage.</p>'\"';}\n    else {const values=INFO[this.aboutTab+'Feedback'];content='<ol class=\\\"feedback\\\">'+QUESTIONS[this.aboutTab].map((q,i)=>\"'`<li><b>${esc(q)}</b><p>${esc(values[i])}</p></li>`).join('\"'')+'</ol>';}\n    this.setScreen('about',this.panel(\"'`<div class=\"eyebrow\">THE SMALL PRINT, BUT BIGGER</div><h1>Behind the splash.</h1><nav class=\"tabs\">${tabs.map(([k,v])=>`<button class=\"${this.aboutTab===k?'\"'active':''}\\\" data-action=\\\"about:\"'${k}\">${v}</button>`).join('\"'')}</nav><div class=\\\"about-body\\\" tabindex=\\\"0\\\">\"'${content}</div><div class=\"back-row\">${button('\"'Back','back',true)}<span class=\\\"small\\\">A little panic. A lot of code.</span></div>\"'`,true));\n  }\n  showOnline(){\n    this.game.phase='\"'idle';this.game.clear();\"'$('\"'hud').hidden=true;this.stage.targetOffset=-4.3;\n    this.setScreen('online',this.panel(\"'`<div class=\"eyebrow\">A FRIENDLY SPLASH-OFF</div><h1>Two roofs. One rivalry.</h1><p class=\"network-intro\">Both players catch the same deliveries. See your rival’s tubs; chase the higher score. On AI Hub, races connect automatically for up to four players.</p><div id=\"online-status\" class=\"online-status\">${esc(this.net.connectionStatus)}</div><div class=\"inline-actions\">${button('\"'Create an invite','create-invite',true)}\"'${button('\"'Use pasted code','accept-code')}</div><label class=\\\"code-label\\\" for=\\\"incoming-code\\\">Paste an invite or reply here</label><textarea id=\\\"incoming-code\\\" class=\\\"code-area\\\" spellcheck=\\\"false\\\" placeholder=\\\"WHOOSH1.…\\\" aria-label=\\\"Connection code to use\\\">\"'${esc(this.incomingCode||'\"'')}</textarea><div class=\\\"code-label\\\"><label for=\\\"outgoing-code\\\">Your invite / reply</label><button data-action=\\\"copy-code\\\">Copy</button></div><textarea id=\\\"outgoing-code\\\" class=\\\"code-area\\\" readonly aria-label=\\\"Your connection code\\\">\"'${esc(this.outgoingCode||'\"'')}</textarea><button id=\\\"start-race\\\" class=\\\"action primary\\\" data-action=\\\"race-start\\\" style=\\\"width:100%;margin-top:18px\\\" \"'${this.net.connected&&this.net.host?'\"'':'hidden'}>Start the race<span>↗</span></button><p class=\\\"small\\\">Host sends an invite → friend pastes it and sends a reply → host pastes the reply. Both games must stay open. Direct connections use STUN; restrictive networks may need AI Hub.</p><div class=\\\"back-row\\\">\"'${button('\"'Back','back')}<span class=\\\"small\\\">No account. No game server.</span></div>\"'`,true));\n  }\n  showDev(){\n    if(this.net.active)return;this.devTab??='\"'tools';let content='';\n    if(this.devTab==='tools')content=\"'`<div class=\"tool-grid\">${button('\"'Invulnerable: '+(this.game.invulnerable?'ON':'OFF'),'dev:invulnerable',false,\"'`class=\"action${this.game.invulnerable?'\"' on':''}\\\"\"'`)}${button('\"'Auto-catch: '+(this.game.auto?'ON':'OFF'),'dev:auto')}\"'${button('\"'Physics overlay: '+(this.game.hitboxes?'ON':'OFF'),'dev:hitboxes')}\"'${button('\"'Restore all tubs','dev:heal')}\"'${button('\"'Fill douse meter','dev:charge')}\"'${button('\"'Spawn a bomb','dev:bomb')}\"'${button('\"'Spawn gold','dev:gold')}\"'${button('\"'Finish this shift','dev:win')}</div><div class=\\\"eyebrow\\\">JUMP TO A SHIFT</div><div class=\\\"wave-picker\\\">\"'${WAVES.map((_,i)=>`<button data-action=\"wave:${i}\">${i+1}</button>`).join('\"'')}</div><p class=\\\"small\\\">Developer changes mark the shift unranked. Resume to see changes. Physics overlay shows sensor bounds and live simulation counts.</p>\"'`;\n    else {const sliders=[['\"'fall','Fall speed',.4,2,.05],['rate','Drop frequency',.4,2,.05],['width','Tub width',1,3,.05],['speed','Move speed',8,30,1],['gravity','Gravity',1,12,.25],['recharge','Douse / catch',1,20,1],['timeScale','Simulation speed',.25,2,.05]];content=\"'`<div class=\"tune-grid\">${sliders.map(([k,l,min,max,step])=>`<div class=\"setting-row\"><label for=\"tune-${k}\">${l}</label><div class=\"range-group\"><input id=\"tune-${k}\" data-tune=\"${k}\" aria-label=\"${l}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${this.game.tune[k]}\"><output class=\"range-value\">${this.game.tune[k].toFixed(2)}</output></div></div>`).join('\"'')}</div><p class=\\\"small\\\">Changes are live and apply to every new delivery. Restore defaults to return to the original balance.</p>\"'`;}\n    this.setScreen('\"'dev',this.panel(\"'`<div class=\"eyebrow\">THE DEV WORKSHOP · UNRANKED</div><h1>Turn the taps.</h1><nav class=\"tabs\"><button data-action=\"dev-tab:tools\" class=\"${this.devTab==='\"'tools'?'active':''}\\\">Testing tools</button><button data-action=\\\"dev-tab:tuning\\\" class=\\\"\"'${this.devTab==='\"'tuning'?'active':''}\\\">Balance sliders</button></nav>\"'${content}<div class=\"back-row\">${button('\"'Back to pause','back',true)}<button class=\\\"text-button\\\" data-action=\\\"dev:reset\\\">Reset defaults</button></div>\"'`,true));\n  }\n  slider(el){\n    this.activity();if(el.dataset.setting){const k=el.dataset.setting;this.settings[k]=Number(el.value)/100;el.nextElementSibling.textContent=el.value+'\"'%';this.applySettings();}\n    if(el.dataset.tune){const k=el.dataset.tune;this.game.tune[k]=Number(el.value);el.nextElementSibling.textContent=Number(el.value).toFixed(2);this.game.unranked=true;this.game.applyTune();}\n  }\n  async action(action,el){\n    if(this.net.ended)return;\n    if(action==='solo')this.start('solo');else if(action==='coop')this.start('coop');else if(action==='replay')this.start(this.game.mode);\n    else if(action==='title'){this.net.disconnect();this.showTitle();}else if(action==='resume')this.resume();else if(action==='back')this.back();\n    else if(action==='howto')this.showHowto();else if(action==='settings'){this.settingsParent=this.screen==='pause'?'pause':'title';this.showSettings();}\n    else if(action==='about'){this.aboutTab='source';this.showAbout();}else if(action.startsWith('about:')){this.aboutTab=action.slice(6);this.showAbout();}\n    else if(action==='records')this.showRecords();else if(action==='online')this.showOnline();else if(action==='fullscreen')this.fullscreen();\n    else if(action==='glyphs'){this.settings.glyphs=this.settings.glyphs==='playstation'?'xbox':'playstation';this.applySettings();el.textContent=this.settings.glyphs==='playstation'?'PlayStation':'Xbox';}\n    else if(action==='difficulty'){const ds=['chill','arcade','wild'];this.settings.difficulty=ds[(ds.indexOf(this.settings.difficulty)+1)%3];this.applySettings();el.textContent=this.settings.difficulty[0].toUpperCase()+this.settings.difficulty.slice(1);}\n    else if(action.startsWith('setting:')){const k=action.slice(8);this.settings[k]=\"'!this.settings[k];this.applySettings();el.textContent=this.settings[k]?'\"'On':'Off';}\n    else if(action==='dev')this.showDev();else if(action.startsWith('dev-tab:')){this.devTab=action.slice(8);this.showDev();}\n    else if(action.startsWith('wave:')){this.game.jumpWave(Number(action.slice(5)));this.resume();}\n    else if(action.startsWith('dev:'))this.devAction(action.slice(4));\n    else if(action==='create-invite'||action==='accept-code'){\n      el.disabled=true;try{let code;if(action==='create-invite')code=await this.net.createOffer();else{this.incomingCode=\"'$('\"'incoming-code').value;code=await this.net.accept(this.incomingCode);}if(code){this.outgoingCode=code;if(\"'$('\"'outgoing-code'))\"'$('\"'outgoing-code').value=code;}}catch(e){this.net.setStatus(e.message);}finally{el.disabled=false;}\n    }else if(action==='copy-code'){const code=\"'$('\"'outgoing-code').value;if(\"'!code){this.net.setStatus('\"'Create an invite or accept a code first.');return;}try{await navigator.clipboard.writeText(code);this.toast('Connection code copied.');}catch{\"'$('\"'outgoing-code').focus();\"'$('\"'outgoing-code').select();this.net.setStatus('Code selected. Copy it with your device’s copy command.');}}\n    else if(action==='race-start')this.net.beginRace();else if(action==='leave-online'){this.net.disconnect();this.showTitle();}\n  }\n  devAction(k){\n    this.game.unranked=true;\n    if(['invulnerable','auto','hitboxes'].includes(k))this.game[k]=\"'!this.game[k];\n    if(k==='\"'heal'){for(const p of this.game.players){p.buckets=3;this.game.syncSensors(p);}}\n    if(k==='charge')this.game.charge=100;\n    if(k==='bomb'||k==='gold')this.game.spawn(k==='gold'?'gold':'normal',this.game.players[0].x,6);\n    if(k==='win'){this.game.finish(true);return;}\n    if(k==='reset'){Object.assign(this.game.tune,DEFAULTS);this.game.invulnerable=false;this.game.auto=false;this.game.hitboxes=false;this.game.applyTune();this.toast('Original balance restored.');}\n    this.showDev();\n  }\n  async fullscreen(){try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen();}catch{this.toast('Fullscreen is unavailable in this browser.');}}\n  waiting(){\n    this.hideAnnounce();this.setScreen('waiting',this.panel('<div class=\\\"eyebrow\\\">THE BRIGADE IS LINING UP</div><h1>Ready on the roof.</h1><p id=\\\"waiting-copy\\\" class=\\\"intro\\\">The next shift starts together.</p><p class=\\\"small\\\">Move with left stick, A/D, mouse or a drag. Douse with Cross / A, Space, click or a second touch.</p>'));if(\"'$('\"'hud'))\"'$('\"'hud').hidden=true;\n  }\n  hubCountdown(t){if(this.screen\"'!=='\"'waiting')return;const e=\"'$('\"'waiting-copy');if(e)e.textContent=Number.isFinite(t)?\"'`First delivery in ${Math.max(1,Math.ceil(-t/1000))}…`:'\"'Waiting for the brigade…';}\n  networkStart(seed){\n    this.clearScreen();this.game.invulnerable=false;this.game.auto=false;this.game.hitboxes=false;Object.assign(this.game.tune,DEFAULTS);this.game.assist=this.settings.aimAssist||this.input?.last==='touch';\n    this.game.start({mode:'race',seed,difficulty:'arcade'});this.attract=false;\"'$('\"'attract-label').hidden=true;\"'$('\"'hud').hidden=false;\"'$('\"'pause-button').hidden=false;this.sound.resume();this.updateHud();\n  }\n  showHubEnd(){this.setScreen('hub-ended',this.panel('<div class=\\\"eyebrow\\\">SHIFT COMPLETE</div><h1>That’s a wrap.</h1><p class=\\\"intro\\\">Your rooftop report is with the Hub.</p>'));}\n  renderRivals(){\n    const parent=\"'$('\"'net-scores');if(\"'!parent)return;parent.replaceChildren();\n    for(const [id,p]of this.net.peers){const row=document.createElement('\"'div');row.className='rival';row.style.borderLeft='6px solid '+p.color;const name=document.createElement('span');name.textContent=p.name;const score=document.createElement('b');score.textContent=p.score.toLocaleString();row.append(name,score);parent.append(row);if(this.stage&&this.game)this.stage.updateGhost(id,{...p,visible:p.stage===this.game.wave},p.color);}\n  }\n  prompts(){\n    const type=this.input?.last||'keyboard',pad=type==='pad',xbox=this.settings.glyphs==='xbox';\n    const move=pad?glyph('L',true):type==='touch'?'DRAG':glyph('A')+' '+glyph('D');\n    const douse=pad?glyph(xbox?'A':'×',true):type==='touch'?'2ND TOUCH':type==='mouse'?glyph('CLICK'):glyph('SPACE');\n    if(\"'$('\"'control-hint'))\"'$('\"'control-hint').innerHTML=\"'`<span class=\"hint-group\">${move} MOVE</span><span class=\"hint-group\">${douse} DOUSE</span><span class=\"hint-group\">${pad?glyph('\"'☰'):glyph('ESC')} MENU</span>\"'`;\n    if($('\"'douse-label'))\"'$('\"'douse-label').innerHTML='DOUSE '+douse;\n    if(\"'$('\"'howto-controls'))\"'$('\"'howto-controls').innerHTML=\"'`<span><b>MOVE</b> ${move}${type==='\"'mouse'?' / mouse':''}</span><span><b>DOUSE</b> \"'${douse}</span><span><b>MENU</b> ${pad?glyph('\"'☰'):glyph('ESC')}</span>\"'`;\n  }\n  announce(over,title,sub,seconds){$('\"'announce-over').textContent=over;\"'$('\"'announce-title').textContent=title;\"'$('\"'announce-sub').textContent=sub;\"'$('\"'announcement').hidden=false;this.announceTimer=seconds;}\n  hideAnnounce(reset=true){\"'$('\"'announcement').hidden=true;if(reset)this.announceTimer=0;}\n  toast(message){\"'$('\"'toast').textContent=message;\"'$('\"'toast').hidden=false;this.toastTimer=3;}\n  updateHud(){\n    const g=this.game;if(\"'!g)return;$('\"'score').textContent=String(Math.round(g.score)).padStart(6,'0');\"'$('\"'best').textContent=Math.max(0,...this.records.map(r=>r.score)).toLocaleString();\n    \"'$('\"'wave-number').textContent=\"'`SHIFT ${String((g.wave||0)+1).padStart(2,'\"'0')} / 06\"'`;$('\"'wave-name').textContent=WAVES[g.wave||0].name;\"'$('\"'wave-pips').innerHTML=WAVES.map((_,i)=>\"'`<i class=\"${i<=(g.wave||0)?'\"'on':''}\\\"></i>\"'`).join('\"'');\n    \"'$('\"'douse-fill').style.width=g.charge+'%';\"'$('\"'douse-button').classList.toggle('ready',g.charge>=99.9);\"'$('\"'douse-tip').textContent=g.charge>=99.9?'A little rain, right when you need it.':Math.round(g.charge)+'% · Catches refill the meter.';\n    \"'$('\"'combo').innerHTML=\"'`<b>×${g.multiplier||1}</b> MULTIPLIER<small>${g.combo?g.combo+'\"' in a row · Keep it flowing.':'Center the catch. Stack the score.'}</small>\"'`;\n    $('\"'dev-indicator').hidden=\"'!g.unranked;$('\"'debug-state').hidden=\"'!g.hitboxes;\n    if(g.hitboxes)$('\"'debug-state').textContent=\"'`RAPIER ${g.version}'\"\\\\n\"'${this.stage.backend}'\"\\\\nBodies: \"'${g.world.bodies.len()}  Bombs: ${g.bombs.length}'\"\\\\nSensors: \"'${g.players.reduce((s,p)=>s+p.buckets,0)}  Step: 1/120 s'\"\\\\nSeed: \"'${g.seed}  Time: ${g.elapsed.toFixed(1)} s`;\n  }\n  updateHitboxes(){\n    if(!this.hitboxGroup){this.hitboxGroup=document.createElement('\"'canvas');this.hitboxGroup.style='position:fixed;inset:0;pointer-events:none;z-index:3';document.body.append(this.hitboxGroup);}\n    this.hitboxGroup.hidden=\"'!this.game.hitboxes||$('\"'hud').hidden;if(this.hitboxGroup.hidden)return;\n    const can=this.hitboxGroup;can.width=innerWidth;can.height=innerHeight;const c=can.getContext('2d');c.strokeStyle='#f07848';c.lineWidth=3;c.setLineDash([7,4]);\n    const project=(x,y)=>{const v=this.stage.camera.position.clone();v.set(x,y,.45).project(this.stage.camera);return [(v.x+1)*innerWidth/2,(1-v.y)*innerHeight/2];};\n    for(const p of this.game.players)for(let j=0;j<p.buckets;j++){const a=project(p.x-this.game.effectiveWidth()/2,1.36+j*.82+.11),b=project(p.x+this.game.effectiveWidth()/2,1.36+j*.82-.11);c.strokeRect(a[0],a[1],b[0]-a[0],b[1]-a[1]);}\n    for(const b of this.game.bombs){const p=project(b.x,b.y),q=project(b.x+.29,b.y);c.beginPath();c.arc(p[0],p[1],Math.abs(q[0]-p[0]),0,Math.PI*2);c.stroke();}\n  }\n  frame(t){\n    if(\"'!this.ready)return;const dt=Math.min(.06,this.lastFrame?(t-this.lastFrame)/1000:1/60);this.lastFrame=t;this.input.poll(t);\n    this.net.update(t,this.game.snapshot());\n    const runs=!this.screen||this.attract||this.net.roundActive;\n    if(runs){this.game.update(dt,this.screen?[{},{}]:this.input.controls());if(this.announceTimer>0){this.announceTimer-=dt;if(this.announceTimer<=0)this.hideAnnounce();}}\n    if(this.game.players.length&&this.game.phase!=='\"'idle'){this.stage.playerState(this.game.players,this.game.effectiveWidth());this.stage.updateBombs(this.game.bombs);}\n    this.stage.render(dt,{bomberX:this.game.phase==='idle'?Math.sin(t*.0005)*.3:this.game.bomberX,running:this.game.phase==='playing',reduceMotion:this.settings.reduceMotion,held:this.game.grace===0});\n    if(t>=this.nextHud){this.nextHud=t+100;this.updateHud();this.updateHitboxes();}\n    this.sound.update();if(this.toastTimer>0){this.toastTimer-=dt;if(this.toastTimer<=0)\"'$('\"'toast').hidden=true;}\n    if(this.attractRestart&&t>=this.attractRestart){this.attractRestart=0;if(this.attract)this.start('solo',true);}\n    if(\"'!this.attract&&!this.net.active&&!this.net.pc&&['\"'title','howto','settings','about','records','online'].includes(this.screen)&&t-this.lastActivity>=10000)this.startAttract();\n    if(this.net.kind==='rtc'&&this.net.startAt&&\"'$('\"'waiting-copy'))\"'$('\"'waiting-copy').textContent=\"'`First delivery in ${Math.max(1,Math.ceil((this.net.startAt-Date.now())/1000))}…`;\n  }\n}\nconst app=new App();\napp.init().catch(e=>{console.error(e);window.__gameError=String(e.stack||e);if(window.AIHub?.active)window.AIHub.fail('\"'Ka-Whoosh could not initialize: '+e.message);\"'$('\"'loading').innerHTML='<div class=\\\"error-panel\\\"><h1>The tubs hit a snag.</h1><p>Use a browser with WebGPU or WebGL 2 enabled, then reload this file.</p><p id=\\\"error-detail\\\"></p></div>';\"'$('\"'error-detail').textContent=e.message;});\nEOF\ncat > build.mjs <<'EOF'\nimport {build} from 'esbuild';\nimport fs from 'node:fs/promises';\nimport path from 'node:path';\nconst root=path.dirname(new URL(import.meta.url).pathname);\nconst result=await build({entryPoints:[path.join(root,'src/app.js')],bundle:true,write:false,format:'esm',target:'es2022',minify:true,legalComments:'inline',logLevel:'silent'});\nlet html=await fs.readFile(path.join(root,'src/template.html'),'utf8');\nconst client=await fs.readFile(path.join(root,'vendor/hub-session.js'),'utf8');\nlet css=await fs.readFile(path.join(root,'src/style.css'),'utf8');\nfor(const [tag,file]of [['DISPLAY','display'],['BODY','body']])css=css.replace(\"'`__${tag}_FONT__`,'\"'data:font/ttf;base64,'+(await fs.readFile(path.join(root,\"'`assets/${file}.ttf`))).toString('\"'base64'));\nhtml=html.replace('<\"'!-- HUB_CLIENT -->'\"',()=>\"'`<script>${client}</script>`).replace('\"'/* STYLES */',()=>css).replace('/* BUNDLE */',()=>result.outputFiles[0].text.replace(/<\\\\/script/gi,'<\\\\\\\\/script'));\nconst filename='Ka-Whoosh-Kaboom-gpt-6.1-sol-max-20261105-191412.html';\nawait fs.writeFile(path.join(root,'..',filename),html);\nawait fs.copyFile(path.join(root,'metadata.json'),path.join(root,'..','exit-interview.json'));\nfor(const name of ['harness.html','bridge.js','round.js'])await fs.copyFile(path.join(root,'vendor','hub-'+name),path.join(root,name));\nconsole.log(\"'`Built ${filename} (${(Buffer.byteLength(html)/1024/1024).toFixed(2)} MiB, self-contained)`);\nEOF\nnpm run build'","aggregated_output":"npm notice run ka-whoosh@1.0.0 build\nnpm notice run node build.mjs\nBuilt Ka-Whoosh-Kaboom-gpt-6.1-sol-max-20261105-191412.html (4.68 MiB, self-contained)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"agent_message","text":"The build now produces one self-contained HTML file, including the engine, physics, and fonts. The menus, controls, attract mode, dev workshop, and network paths are wired up. I’m starting browser verification now, beginning with rendering and a scripted six-round playthrough.\n"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > tests/run.py <<'EOF'\n\\\"\\\"\\\"Run from the game folder: npm test. Only failures and a final count are printed.\\\"\\\"\\\"\nimport json\nimport pathlib\nimport sys\nimport traceback\nfrom playwright.sync_api import sync_playwright\n\nROOT = pathlib.Path(__file__).resolve().parents[1]\nGAME = ROOT.parent / 'Ka-Whoosh-Kaboom-gpt-6.1-sol-max-20261105-191412.html'\nART = ROOT / 'tests' / 'artifacts'\nART.mkdir(exist_ok=True)\nresults = []\nissues = []\n\ndef check(name, fn):\n    try:\n        out = fn()\n        if out is False:\n            raise AssertionError('returned false')\n        results.append({'name': name, 'pass': True, 'detail': out})\n    except Exception as exc:\n        detail = str(exc)\n        print(f'FAIL {name}: {detail}', flush=True)\n        results.append({'name': name, 'pass': False, 'detail': detail})\n        issues.append(name)\n\n\ndef expect(value, message):\n    if not value:\n        raise AssertionError(message)\n    return True\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True, args=[\n        '--enable-unsafe-webgpu', '--enable-features=Vulkan',\n        '--use-webgpu-adapter=swiftshader', '--no-sandbox',\n        '--autoplay-policy=no-user-gesture-required',\n    ])\n    context = browser.new_context(viewport={'width': 1440, 'height': 900})\n    context.add_init_script(\\\"\\\"\\\"window.__testPad=null;\n      Object.defineProperty(navigator,'getGamepads',{value:()=>window.__testPad?[window.__testPad]:[]});\\\"\\\"\\\")\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda e: errors.append(str(e)))\n    page.goto(GAME.as_uri(), wait_until='load', timeout=120000)\n    page.wait_for_function('window.__gameReady || window.__gameError', timeout=120000)\n    check('engine initialization', lambda: expect(page.evaluate('\"'!!window.__gameReady'\"'), page.evaluate('window.__gameError||\\\"not ready\\\"')))\n    if page.evaluate('\"'!!window.__gameReady'\"'):\n        check('WebGPU and pinned Rapier', lambda: page.evaluate(\\\"__KA_WHOOSH__.stage.backend==='WebGPU' && __KA_WHOOSH__.game.version==='0.19.3'\\\"))\n        check('self-contained fonts', lambda: page.evaluate(\\\"document.fonts.check('900 24px Display')&&document.fonts.check('400 20px Body')\\\"))\n        page.screenshot(path=str(ART/'title.png'))\n        check('keyboard starts solo', lambda: (page.keyboard.press('Enter'), expect(page.evaluate(\\\"__KA_WHOOSH__.game.phase==='intro'&&__KA_WHOOSH__.app.screen===null\\\"), 'Enter did not start'))[-1])\n        def movement():\n            page.keyboard.down('KeyD')\n            page.wait_for_timeout(250)\n            page.keyboard.up('KeyD')\n            return expect(page.evaluate('__KA_WHOOSH__.game.players[0].x>1'), 'Keyboard did not move tubs')\n        check('keyboard movement', movement)\n        check('physics catches and scoring', lambda: page.evaluate(\\\"\\\"\\\"()=>{const t=__KA_WHOOSH__;t.game.effects=false;t.game.start({seed:1981});const s=t.advance(22,{auto:true});return s.stats.caught>=10&&s.score>0&&s.players[0].buckets>0;}\\\"\\\"\\\"))\n        page.screenshot(path=str(ART/'gameplay.png'))\n        def full_shift():\n            state = page.evaluate(\\\"\\\"\\\"()=>{const t=__KA_WHOOSH__;t.game.start({seed:1981});return t.advance(240,{auto:true});}\\\"\\\"\\\")\n            (ART/'full-shift.json').write_text(json.dumps(state, indent=2))\n            return expect(state['phase']=='won' and state['stats']['stages']==6 and state['stats']['gold']>0 and state['stats']['caught']>150, json.dumps(state))\n        check('complete six-shift physics playthrough', full_shift)\n        check('results show all six shifts', lambda: page.locator('#screen').inner_text().find('6/6')>=0)\n        def douse():\n            return page.evaluate(\\\"\\\"\\\"()=>{const t=__KA_WHOOSH__,g=t.game;g.start({seed:12});g.phase='playing';g.spawn('normal',0,8);g.spawn('normal',1,7);const before=g.score;let a=g.douse();return a&&g.bombs.length===0&&g.charge===0&&g.stats.doused===2&&g.score>before&&\"'!g.douse();}\"\"\")\n        check('\"'douse clears bombs and consumes meter', douse)\n        def losses():\n            return page.evaluate(\\\"\\\"\\\"()=>{const t=__KA_WHOOSH__,g=t.game;g.start({seed:42});g.phase='playing';for(let i=0;i<3;i++){g.grace=0;let b=g.spawn('normal',8,.6);g.miss(b);}return g.phase==='lost'&&g.players[0].buckets===0&&g.stats.misses===3;}\\\"\\\"\\\")\n        check('three misses end the shift', losses)\n        check('gold miss preserves tubs', lambda: page.evaluate(\\\"\\\"\\\"()=>{const g=__KA_WHOOSH__.game;g.start({seed:12});let b=g.spawn('gold',8,.6);g.miss(b);return g.players[0].buckets===3&&g.stats.misses===0;}\\\"\\\"\\\"))\n        def pause_dev():\n            page.evaluate(\\\"__KA_WHOOSH__.app.start('solo')\\\")\n            page.keyboard.press('Escape')\n            before=page.evaluate('__KA_WHOOSH__.game.clock')\n            page.wait_for_timeout(250)\n            expect(abs(page.evaluate('__KA_WHOOSH__.game.clock')-before)<.001, 'Paused simulation advanced')\n            page.locator('[data-action=\\\"dev\\\"]').click()\n            page.locator('[data-action=\\\"dev-tab:tuning\\\"]').click()\n            page.locator('#tune-width').fill('2.5')\n            expect(page.evaluate('__KA_WHOOSH__.game.tune.width===2.5&&__KA_WHOOSH__.game.unranked'), 'Slider not live')\n            page.locator('[data-action=\\\"dev:reset\\\"]').click()\n            return expect(page.evaluate('__KA_WHOOSH__.game.tune.width===1.85'), 'Defaults not restored')\n        check('pause and live developer tuning', pause_dev)\n        def settings():\n            page.evaluate('__KA_WHOOSH__.app.showTitle()')\n            page.locator('[data-action=\\\"settings\\\"]').click()\n            expect(page.evaluate('__KA_WHOOSH__.settings===undefined && __KA_WHOOSH__.sound.musicVolume===.1'), 'Music default is not 10%')\n            page.locator('[data-action=\\\"glyphs\\\"]').click()\n            return expect(page.locator('[data-action=\\\"glyphs\\\"]').inner_text()=='Xbox', 'Glyph switch failed')\n        check('music defaults and glyph setting', settings)\n        def gamepad():\n            page.evaluate(\\\"\\\"\\\"()=>{__KA_WHOOSH__.app.showTitle();window.__testPad={id:'Test standard pad',index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))};__testPad.buttons[0]={pressed:true,value:1};}\\\"\\\"\\\")\n            page.wait_for_timeout(150)\n            page.evaluate('__testPad.buttons[0]={pressed:false,value:0};__testPad.axes[0]=1')\n            page.wait_for_timeout(250)\n            expect(page.evaluate('__KA_WHOOSH__.game.players[0].x>1'), 'Pad stick did not move')\n            expect(page.evaluate(\\\"__KA_WHOOSH__.app.input.last==='pad'\\\"), 'Pad glyph source missing')\n            page.evaluate('__testPad.axes[0]=0;__testPad.buttons[9]={pressed:true,value:1}')\n            page.wait_for_timeout(150)\n            expect(page.evaluate(\\\"__KA_WHOOSH__.app.screen==='pause'\\\"), 'Options did not pause')\n            page.evaluate('window.__testPad=null')\n            return True\n        check('emulated standard gamepad controls', gamepad)\n        def attract():\n            page.evaluate('__KA_WHOOSH__.app.showTitle();__KA_WHOOSH__.app.lastActivity=performance.now()-10050')\n            page.wait_for_function('__KA_WHOOSH__.app.attract', timeout=5000)\n            expect(page.evaluate('__KA_WHOOSH__.game.attract'), 'Attract not AI controlled')\n            page.keyboard.press('Space')\n            return expect(page.evaluate(\\\"\"'!__KA_WHOOSH__.app.attract&&__KA_WHOOSH__.app.screen==='\"'title'\\\"), 'Input did not exit attract')\n        check('ten-second attract and input exit', attract)\n        def audio():\n            page.locator('[data-action=\\\"solo\\\"]').click()\n            page.evaluate('__KA_WHOOSH__.sound.play(\\\"douse\\\");__KA_WHOOSH__.sound.babble(true)')\n            page.wait_for_timeout(80)\n            return expect(page.evaluate('__KA_WHOOSH__.sound.level()>0.0001'), 'Web Audio output was silent')\n        check('synthesized audio produces signal', audio)\n        check('no uncaught browser errors', lambda: expect(not errors, '; '.join(errors)))\n    context.close()\n    browser.close()\n\n(ART/'results.json').write_text(json.dumps(results, indent=2, default=str))\nprint(f'{len(results)-len(issues)}/{len(results)} checks passed; {len(issues)} failures.', flush=True)\nsys.exit(1 if issues else 0)\nEOF\nnpm test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
