{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"cat > src/style.css <<'EOF'\n@font-face{font-family:Display;src:url('__DISPLAY_FONT__') format('truetype');font-weight:900;font-display:swap}@font-face{font-family:Body;src:url('__BODY_FONT__') format('truetype');font-weight:400;font-display:swap}\n:root{--ink:#192b39;--paper:#fff2cd;--yellow:#ffd05a;--blue:#17678e;--aqua:#8de3d2;--orange:#f07848;--line:3px solid var(--ink);font-family:Body,Arial,sans-serif;color:var(--ink);background:#f6ce68;font-synthesis:none}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;touch-action:none;user-select:none}button,input,textarea{font:inherit}button{color:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}button:disabled{cursor:wait;opacity:.45}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:4px solid var(--orange);outline-offset:4px}button:focus{scroll-margin:20px}a{color:var(--blue)}[hidden]{display:none\"'!important}#world,#world canvas{position:absolute;inset:0;width:100%;height:100%;display:block}#paper{position:fixed;inset:0;pointer-events:none;opacity:.065;z-index:2;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='\"'0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23000' filter='url(%23n)' opacity='.5' d='M0 0h180v180H0z'/%3E%3C/svg%3E\\\");mix-blend-mode:multiply}#ui{position:fixed;inset:0;z-index:4;pointer-events:none}#ui button,#ui input,#ui textarea,#ui a{pointer-events:auto}#screen{position:absolute;inset:0;pointer-events:none}#screen>*{pointer-events:auto}.title-screen{height:100%;width:100%;position:relative;padding:5vh 5.6vw;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;isolation:isolate}.title-screen:before{content:'';position:absolute;z-index:-1;inset:0 46% 0 0;background:linear-gradient(90deg,#f8d66f 0%,#f8d66ff2 76%,#f8d66f00 100%);pointer-events:none}.eyebrow{font-family:Display,sans-serif;font-size:clamp(14px,1.25vw,22px);letter-spacing:.13em;text-transform:uppercase;display:flex;align-items:center;gap:12px}.eyebrow:before{content:'';display:inline-block;width:27px;height:4px;background:currentColor}.title-logo{font-family:Display,sans-serif;font-size:clamp(68px,8vw,146px);font-weight:900;letter-spacing:-.07em;line-height:.79;margin:3.5vh 0 2.5vh;transform:rotate(-3deg);text-shadow:3px 4px 0 var(--paper)}.title-logo span{display:block}.title-logo .whoosh{color:var(--blue);-webkit-text-stroke:1px var(--ink);text-shadow:4px 5px 0 var(--paper)}.title-description{font-size:clamp(18px,1.55vw,27px);line-height:1.35;max-width:380px;margin:1vh 0 2.5vh}.title-description b{font-family:Display}.title-nav{display:flex;flex-direction:column;align-items:stretch;gap:10px;min-width:330px;width:29vw;max-width:440px}.action{border:var(--line);border-radius:3px;background:var(--paper);padding:15px 22px;min-height:60px;text-align:left;font-family:Display,sans-serif;font-size:clamp(19px,1.55vw,26px);box-shadow:4px 4px 0 var(--ink);display:flex;align-items:center;justify-content:space-between;gap:18px;transition:transform .12s,background .12s,box-shadow .12s}.action.primary{background:var(--blue);color:var(--paper)}.action:hover,.action:focus,.action.focus{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink);background:var(--aqua);color:var(--ink);outline:none}.action.primary:hover,.action.primary:focus{background:var(--ink);color:var(--paper)}.action:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}.action small{font-family:Body;font-size:.65em;opacity:.8}.menu-arrow{font-family:Body;font-size:28px;line-height:1}.minor-nav{display:flex;gap:24px;margin-top:20px}.text-button{border:0;background:transparent;font-family:Display;font-size:clamp(16px,1.3vw,22px);padding:7px 0;border-bottom:2px solid transparent}.te