{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/game.js');s=p.read_text().replace(\\\"if(b.wind)b.body.addForce({x:b.wind*.02,y:0,z:0},true);\\\",\\\"if(b.wind){b.body.resetForces(true);b.body.addForce({x:b.wind*.02,y:0,z:0},true);}\\\")\np.write_text(s)\np=Path('src/scene.js');s=p.read_text().replace(\\\"new T.WebGPURenderer({antialias:true,alpha:false,powerPreference:'high-performance'})\\\",\\\"new T.WebGPURenderer({antialias:true,alpha:false,powerPreference:'high-performance',forceWebGL:new URLSearchParams(location.search).get('renderer')==='webgl'})\\\")\np.write_text(s)\nPY\nnpm run build\ncat > tests/visual.py <<'EOF'\nfrom pathlib import Path\nimport json\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parents[1]\nurl=(root.parent/'Ka-Whoosh-Kaboom-gpt-6.1-sol-max-20261105-191412.html').as_uri()\nwith sync_playwright() as p:\n b=p.chromium.launch(args=['--no-sandbox','--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--use-angle=swiftshader'])\n page=b.new_page(viewport={'width':1440,'height':900})\n errors=[]\n page.on('console',lambda msg:errors.append(msg.text) if msg.type=='error' else None)\n page.on('pageerror',lambda msg:errors.append(str(msg)))\n page.goto(url+'?renderer=webgl')\n page.wait_for_function('window.__gameReady||window.__gameError',timeout=120000)\n page.wait_for_timeout(1500)\n page.screenshot(path=str(root/'tests/artifacts/title-webgl.png'))\n result=page.evaluate('''()=>{const t=__KA_WHOOSH__;return {error:window.__gameError,backend:t.stage.backend,info:t.stage.renderer.info.render,sceneChildren:t.stage.scene.children.length,camera:t.stage.camera.position.toArray()}}''')\n page.evaluate(\\\"__KA_WHOOSH__.app.start('solo');__KA_WHOOSH__.game.auto=true;__KA_WHOOSH__.game.jumpWave(3)\\\")\n page.wait_for_timeout(4500)\n page.screenshot(path=str(root/'tests/artifacts/play-webgl.png'))\n (root/'tests/artifacts/visual-state.json').write_text(json.dumps({'result':result,'errors':errors},indent=2))\n b.close()\nprint('Visual inspection captures saved.')\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/visual.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
