/work/MadMenAtLarge-MadMen-claude-haiku-5-5-medium-20261102-191849 && cat > /tmp/smoke.mjs <<'EOF'\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\nconst root = process.argv[2];\nconst ctx = { console, Math };\nctx.window = ctx;\nvm.createContext(ctx);\nfor (const f of ['vendor/my-3d2dge.js', 'src/credits.js', 'src/logic.js', 'src/game.js']) {\n  try { vm.runInContext(readFileSync(root + '/' + f, 'utf8'), ctx, { filename: f }); }\n  catch (e) { console.log('LOAD FAIL', f, e.stack.split('\\n').slice(0, 4).join(' | ')); process.exit(1); }\n}\nconst E = ctx.My3D2dge, game = E.current;\nconsole.log('scene', game.sceneName, 'errors', game.errors.length);\ngame.advance(0.5);\nconsole.log(JSON.stringify(game.debug.snapshot()));\ngame.input.tap('confirm'); game.advance(0.5);\nconsole.log('after confirm', JSON.stringify(game.debug.snapshot()));\nconsole.log('errors', game.errors.map(e => e.message || e).slice(0, 5));\nEOF\nnode /tmp/smoke.mjs \"$PWD\"","description":"Headless smoke test of engine and game boot"}},"wire_ingest_context":{"toolu_01FCoBe4ZbmDhxXkVrnhiAEH":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191849__xe8b2f0/work/MadMenAtLarge-MadMen-claude-haiku-5-5-medium-20261102-191849"}}}
