{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' net.js\"","aggregated_output":"/** Grit Bros multiplayer. AI Hub Session Protocol v1; same-origin room transport outside the hub. */\nconst STILL = Object.freeze({ x: 0, jump: false, action: false, drop: false });\nconst safeInput = (input = {}) => ({\n  x: Math.max(-1, Math.min(1, Number(input.x) || 0)),\n  jump: !!input.jump,\n  action: !!input.action,\n  drop: !!input.drop,\n});\nconst roomCode = () => Array.from(crypto.getRandomValues(new Uint8Array(6)), n => 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[n % 32]).join('');\n\nexport class GritNet {\n  constructor(callbacks = {}) {\n    this.callbacks = callbacks;\n    this.hub = null;\n    this.isHost = true;\n    this.server = false;\n    this.me = 0;\n    this.players = [{ id: 0, name: 'Pip', color: '#ffb23f' }];\n    this.started = false;\n    this.ended = false;\n    this.reported = false;\n    this.channel = null;\n    this.code = '';\n    this.peer = '';\n    this.token = roomCode() + roomCode();\n    this.remoteInput = { ...STILL };\n    this.remoteAt = 0;\n    this.inputById = new Map();\n    this.inputPacketById = new Map();\n    this.inputAtById = new Map();\n    this.packet = 0;\n    this.lastPacket = -1;\n    this.elapsed = 0;\n    this.pending = { ...STILL };\n    this.lastReceive = 0;\n    this.unsub = [];\n  }\n\n  get active() { return !!this.hub || !!this.channel; }\n  get connected() { return !!this.hub || !!this.peer; }\n  get count() { return this.hub ? this.players.length : this.peer ? 2 : 1; }\n  get canPlay() { return !this.ended && (!this.hub || (this.started && this.hub.time() >= 0)); }\n  get countdown() { return this.hub ? Math.max(0, Math.ceil(-this.hub.time() / 1000)) : 0; }\n\n  async connect() {\n    const client = globalThis.AIHub;\n    if (!client?.active) return null;\n    const info = await client.connect({ mode: 'shared-world', seats: [1, 2] });\n    if (!info) return null;\n    this.hub = client;\n    this.isHost = !!info.isHost;\n    this.server = !!info.server;\n    this.me = info.me;\n    this.players = info.players.slice();\n    this.unsub.push(client.on('start', () => {\n      this.started = true;\n      this.callbacks.onStart?.(this.info());\n    }));\n    this.unsub.push(client.on('message', (data, from) => this.receive(data, from)));\n    this.unsub.push(client.on('leave', ({ id, reason }) => {\n      this.players = this.players.filter(player => player.id !== id);\n      this.remoteInput = { ...STILL };\n      this.inputById.delete(id);\n      this.callbacks.onLeave?.(id, reason);\n    }));\n    this.unsub.push(client.on('time-up', () => {\n      if (this.isHost) this.finish(this.callbacks.getResult?.() || { score: 0, won: false });\n    }));\n    this.unsub.push(client.on('end', ({ reason }) => {\n      this.ended = true;\n      this.remoteInput = { ...STILL };\n      this.callbacks.onEnd?.(reason);\n    }));\n    return info;\n  }\n\n  info() {\n    return { isHost: this.isHost, server: this.server, me: this.me, players: this.players.slice(), count: this.count, hub: !!this.hub, code: this.code };\n  }\n\n  ready() { this.hub?.ready(); }\n  fail(message) { this.hub?.fail(message); }\n\n  /** Call every rendered frame. Host receives true only after the synchronized start. */\n  tick(dt, localInput = STILL, snapshotProvider) {\n    if (this.ended) return false;\n    if (!this.active) return true;\n    this.elapsed += Math.min(0.25, Math.max(0, dt));\n    const input = safeInput(localInput);\n    this.pending.x = input.x;\n    this.pending.jump ||= input.jump;\n    this.pending.action ||= input.action;\n    this.pending.drop ||= input.drop;\n    if (this.elapsed >= 1 / 15 && (!this.hub || this.started)) {\n      this.elapsed = 0;\n      if (this.isHost) {\n        const state = typeof snapshotProvider === 'function' ? snapshotProvider() : snapshotProvider;\n        if (state !== undefined) this.send({ t: 's', n: this.packet++, state });\n      } else {\n        this.send({ t: 'i', n: this.packet++, input: this.pending });\n      }\n      this.pending = { ...STILL, x: input.x };\n    }\n    if (this.remoteAt && performance.now() - this.remoteAt > 1200) this.remoteInput = { ...STILL };\n    for (const [id, at] of this.inputAtById) if (performance.now() - at > 1200) this.inputById.delete(id);\n    return this.isHost && this.canPlay;\n  }\n\n  /** Host's seat-ordered controls. localSecond is used for native same-screen co-op outside a network room. */\n  inputs(localInput = STILL, localSecond = STILL) {\n    if (this.hub) {\n      const result = [ { ...STILL }, { ...STILL } ];\n      for (const player of this.players) {\n        if (player.id < 0 || player.id > 1) continue;\n        result[player.id] = player.id === this.me && !this.server ? safeInput(localInput) : { ...(this.inputById.get(player.id) || STILL) };\n      }\n      return result;\n    }\n    return this.channel ? [safeInput(localInput), { ...this.remoteInput }] : [safeInput(localInput), safeInput(localSecond)];\n  }\n\n  send(data) {\n    if (this.ended) return false;\n    if (this.hub) return this.hub.send(data, this.isHost ? { reliable: false } : { to: this.hub.host, reliable: false });\n    if (this.channel && this.peer) {\n      this.channel.postMessage({ ...data, sender: this.token, to: this.peer });\n      return true;\n    }\n    return false;\n  }\n\n  receive(data, from) {\n    if (this.ended || !data || typeof data !== 'object') return;\n    if (this.isHost && data.t === 'i') {\n      if (this.hub && !this.players.some(player => player.id === from && player.id !== this.me)) return;\n      const previous = this.inputPacketById.get(from) ?? -1;\n      if (!(Number.isFinite(data.n) && data.n > previous)) return;\n      this.inputPacketById.set(from, data.n);\n      this.remoteAt = performance.now();\n      this.remoteInput = safeInput(data.input);\n      this.inputById.set(from, this.remoteInput);\n      this.inputAtById.set(from, this.remoteAt);\n    } else if (!this.isHost && data.t === 's') {\n      if (this.hub && from !== this.hub.host) return;\n      if (!(Number.isFinite(data.n) && data.n > this.lastPacket)) return;\n      this.lastPacket = data.n;\n      this.lastReceive = performance.now();\n      this.callbacks.onSnapshot?.(data.state);\n    }\n  }\n\n  /** Team result: every player ties. The host alone reports to AI Hub. */\n  finish({ score = 0, won = false, stats = {} } = {}) {\n    if (this.reported || this.ended || !this.isHost) return;\n    this.reported = true;\n    if (this.hub) {\n      const ids = this.players.map(player => player.id);\n      this.hub.finish({\n        standings: [ids],\n        scores: Object.fromEntries(ids.map(id => [id, Number(score) || 0])),\n","exit_code":0,"status":"completed"}}
