{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,210p' test-scene.py; sed -n '1,130p' test-hub.py; sed -n '1,80p' input.js\"","aggregated_output":"import http.server,threading,pathlib,sys\nfrom playwright.sync_api import sync_playwright\nroot=pathlib.Path(__file__).parent\nclass Handler(http.server.SimpleHTTPRequestHandler):\n def __init__(self,*args,**kw):super().__init__(*args,directory=str(root),**kw)\n def log_message(self,*args):pass\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),Handler);threading.Thread(target=server.serve_forever,daemon=True).start()\nerrors=[];checks=0\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n for backend in ['gpu','gl']:\n  page=b.new_page(viewport={'width':1600,'height':1000});page.on('pageerror',lambda e:errors.append(str(e)))\n  try:\n   page.goto(f'http://127.0.0.1:{server.server_port}/scene-smoke.html?{backend}');page.wait_for_function('window.ready',timeout=60000);page.wait_for_timeout(1000)\n   info=page.evaluate('s.stats()');assert info['nativeAnimationMixers']==6,info;assert info['backend']==('WebGPU' if backend=='gpu' else 'WebGL2'),info;checks+=1\n   if backend=='gl':page.screenshot(path=str(root/'scene-smoke.png'))\n   assert page.evaluate('(()=>{s.render({players:[],enemies:[],coins:[],phase:4,powCharges:0},.05);return s.stats().enemies===0})()');checks+=1\n  except Exception as e:errors.append(f'{backend}: {e}')\n  page.close()\n b.close()\nserver.shutdown()\nfor e in errors:print('FAIL',e)\nprint(f'{checks}/4 scene checks passed')\nsys.exit(bool(errors))\n\"\"\"Run the upstream AI Hub checks against the packaged game (one browser, OS-selected port).\"\"\"\n\nimport functools\nimport http.server\nimport pathlib\nimport sys\nimport threading\nimport urllib.parse\n\nfrom playwright.sync_api import Error as PlaywrightError\nfrom playwright.sync_api import sync_playwright\n\nROOT = pathlib.Path(__file__).resolve().parent\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef run_checks(browser, origin, html_name):\n    failures = []\n    count = 0\n    page = browser.new_page(viewport={\"width\": 1280, \"height\": 900})\n    try:\n        for scenario in [\"standard\", \"server\", \"host-leave\"]:\n            query = urllib.parse.urlencode(\n                {\n                    \"game\": \"../../\" + html_name,\n                    \"players\": \"2\",\n                    \"auto\": \"1\",\n                    \"scenario\": scenario,\n                    \"latency\": \"150\",\n                    \"jitter\": \"50\",\n                    \"loss\": \"5\",\n                    \"play\": \"4000\",\n                    \"limit\": \"20\",\n                }\n            )\n            page.goto(\n                origin + \"/\" + ROOT.name + \"/hub/harness.html?\" + query,\n                wait_until=\"domcontentloaded\",\n            )\n            page.wait_for_function(\n                \"document.body.dataset.complete === 'true'\", timeout=120000\n            )\n            result = page.evaluate(\"window.__hubCheck\")\n            count += len(result[\"checks\"])\n            for check in result[\"checks\"]:\n                if not check[\"pass\"]:\n                    failures.append(\n                        f\"AI Hub {scenario}: {check['name']}: {check.get('detail', '')}\"\n                    )\n    finally:\n        page.close()\n    return count, failures\n\n\ndef main():\n    files = list(\n        ROOT.parent.glob(\n            \"Grit-Bros-Mario-Bros-1983-gpt-6.1-sol-ultra-20261105-220753.html\"\n        )\n    )\n    html = (\n        pathlib.Path(sys.argv[1]).resolve()\n        if len(sys.argv) > 1\n        else files[0]\n        if files\n        else None\n    )\n    if html is None or not html.is_file():\n        print(\"FAIL AI Hub: packaged HTML is missing\")\n        print(\"1 AI Hub check, 1 failure\")\n        return 1\n    handler = functools.partial(QuietHandler, directory=str(ROOT.parent))\n    server = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    failures = []\n    count = 0\n    try:\n        with sync_playwright() as playwright:\n            browser = playwright.chromium.launch(\n                headless=True,\n                args=[\n                    \"--enable-unsafe-webgpu\",\n                    \"--enable-features=Vulkan\",\n                    \"--use-webgpu-adapter=swiftshader\",\n                ],\n            )\n            try:\n                count, failures = run_checks(\n                    browser, f\"http://127.0.0.1:{server.server_port}\", html.name\n                )\n            finally:\n                browser.close()\n    except (PlaywrightError, OSError) as error:\n        count += 1\n        failures.append(str(error))\n    finally:\n        server.shutdown()\n        server.server_close()\n        thread.join(timeout=2)\n    for failure in failures:\n        print(\"FAIL \" + failure)\n    print(f\"{count} AI Hub checks, {len(failures)} failures\")\n    return 1 if failures else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n// Keyboard, standard gamepads, and invisible multitouch controls share one state.\nconst gameplayMode = mode => mode === 'play' || mode === 'playing' || mode === 'game' || mode === 'attract';\nconst emptyPlayer = () => ({ x: 0, jump: false, action: false, jumpPressed: false, actionPressed: false });\nconst deadzone = value => Math.abs(value || 0) < 0.18 ? 0 : Math.sign(value) * Math.min(1, (Math.abs(value) - 0.18) / 0.82);\nconst editable = target => target?.matches?.('input,textarea,select,[contenteditable=\"true\"]');\n\nexport class Input {\n  constructor({ onActivity = () => {}, onPause = () => {}, onMenu = () => {}, onJoin = () => {} } = {}) {\n    this.onActivity = onActivity; this.onPause = onPause; this.onMenu = onMenu; this.onJoin = onJoin;\n    this.mode = 'menu';\n    this.lastType = 'keyboard';\n    this.glyphStyle = 'ps';\n    this.localCoop = false;\n    this.isTouch = Boolean(globalThis.matchMedia?.('(pointer: coarse)').matches || navigator.maxTouchPoints > 0);\n    this.keys = new Set();\n    this.pads = [emptyPlayer(), emptyPlayer()];\n    this.players = [emptyPlayer(), emptyPlayer()];\n    this.previousPlayers = [emptyPlayer(), emptyPlayer()];\n    this.padPrevious = new Map();\n    this.touchPoints = new Map();\n    this.touchAction = false;\n    this.menuRepeat = { direction: '', next: 0 };\n    this.keyboardRepeat = new Map();\n    this.listeners = [];\n    this._listen(window, 'keydown', event => this._keyDown(event));\n    this._listen(window, 'keyup', event => {\n      this.keys.delete(event.code);\n      this.keyboardRepeat.delete(event.code);\n    });\n    this._listen(window, 'blur', () => this.clear());\n    this._listen(document, 'visibilitychange', () => { if (document.hidden) this.clear(); });\n    this._listen(window, 'pointerdown', event => this._pointerDown(event), { passive: false });\n    this._listen(window, 'pointermove', event => this._pointerMove(event), { passive: false });\n    this._listen(window, 'pointerup', event => this._pointerUp(event), { passive: false });\n    this._listen(window, 'pointercancel', event => this._pointerUp(event), { passive: false });\n    this._listen(window, 'gamepadconnected', () => { this._activity('gamepad'); });\n    this._syncTouchUI();\n  }\n\n  _listen(target, type, handler, options) {\n    target.addEventListener(type, handler, options);\n    this.listeners.push(() => target.removeEventListener(type, handler, options));\n  }\n\n  _activity(type) {\n    this.lastType = type;\n    if (type === 'touch') this.isTouch = true;\n    this._syncTouchUI();\n    this.onActivity(type);\n  }\n\n  _syncTouchUI() {\n    const controls = document.getElementById('touch-controls');\n    if (controls) {\n      controls.classList.toggle('active', this.isTouch && gameplayMode(this.mode));\n      controls.dataset.input = this.lastType;\n    }\n    document.documentElement.dataset.input = this.lastType;\n  }\n\n  _keyDown(event) {\n    if (editable(event.target)) {\n      if (event.code === 'Escape') { event.target.blur?.(); this._activity('keyboard'); this.onMenu('back'); }\n      return;\n    }\n    const controlled = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Space', 'KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyX', 'KeyJ', 'KeyL', 'KeyI', 'KeyO', 'Enter', 'Escape', 'KeyP'];\n    if (!controlled.includes(event.code)) { if (!event.repeat) this._activity('keyboard'); return; }\n    event.preventDefault();\n    this.keys.add(event.code);\n    if (!event.repeat) this._activity('keyboard');\n    if (event.code === 'Escape' || event.code === 'KeyP') {\n      if (!event.repeat) {\n        if (gameplayMode(this.mode)) this.onPause();\n        else this.onMenu('back');\n      }\n      return;\n    }\n    if (gameplayMode(this.mode)) {\n      if (event.code === 'Enter' && !event.repeat && !this.localCoop) this.onJoin();\n      return;\n","exit_code":0,"status":"completed"}}
