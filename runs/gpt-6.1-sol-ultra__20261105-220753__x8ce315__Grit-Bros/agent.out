 for(let i=0;i<count;i++){\n      const a=i/count*Math.PI*2+Math.random()*.5,s=type==='pow'?7:3+Math.random()*3;\n      const m=new THREE.Mesh(ballGeo,mat(type==='coin'?0xffd16d:c,true));m.position.set(x,y,1.2+Math.random()*.25);m.scale.setScalar(.6+Math.random());scene.add(m);particles.push({mesh:m,life:.4+Math.random()*.4,max:.8,vx:Math.cos(a)*s,vy:Math.sin(a)*s+2});\n    }\n  }\n  function removePest(a){\n    scene.remove(a.root);scene.remove(a.status);a.mixer.stopAllAction();const geometries=new Set();a.root.traverse(o=>{if(o.geometry)geometries.add(o.geometry);});a.status.traverse(o=>{if(o.geometry)geometries.add(o.geometry);});for(const g of geometries)g.dispose();\n  }\n  let t=0,steamClock=0;\n  function resize(){\n    const w=canvas.clientWidth||innerWidth,h=canvas.clientHeight||innerHeight;renderer.setSize(w,h,false);\n    const aspect=w/h,halfH=9.35,halfW=Math.max(13.4,halfH*aspect),height=Math.max(halfH,13.4/aspect);\n    camera.left=-halfW;camera.right=halfW;camera.top=height;camera.bottom=-height;camera.updateProjectionMatrix();\n  }\n  resize();\n  function render(state={},dt=1/60){\n    t+=dt;steamClock+=dt;\n    frost.visible=state.phase===4;\n    const shake=state.shake||0;camera.position.x=(Math.random()-.5)*shake*.22;camera.position.y=8.2+(Math.random()-.5)*shake*.18;camera.lookAt(0,8.2,0);\n    for(const p of platformMeshes)if(p.kick){p.kick=Math.max(0,p.kick-dt);p.group.position.y=p.y+Math.sin(p.kick/.21*Math.PI)*.18;}\n    const liveP=new Set();\n    for(const p of state.players||[]){\n      liveP.add(p.id);let a=actors.get(p.id);if(!a){a=worker(p.id);actors.set(p.id,a);}\n      a.root.visible=p.active!==false&&!p.dead&&!(p.hurt>0&&Math.floor(t*16)%2===0);\n      a.root.position.set(p.x,p.y,.35);a.root.rotation.y=(p.face||1)*.22;\n      const mode=!p.grounded?'jump':Math.abs(p.vx||0)>.1?'run':'idle';\n      for(const [name,act] of Object.entries(a.actions))act.setEffectiveWeight(name===mode?1:0);\n      a.actions.run.setEffectiveTimeScale(Math.max(.7,Math.abs(p.vx||0)/4));a.mixer.update(dt);\n    }\n    for(const [id,a]of actors)if(!liveP.has(id))a.root.visible=false;\n    const liveE=new Set();\n    for(const e of state.enemies||[]){\n      liveE.add(e.id);let a=bugs.get(e.id);if(!a||a.type!==e.type){if(a)removePest(a);a=pest(e.type);bugs.set(e.id,a);}\n      a.root.visible=true;a.root.position.set(e.x,e.y,.2);a.root.rotation.z=e.flipped?Math.PI+Math.sin(t*14)*.09:0;\n      a.root.rotation.y=(e.vx||0)>0?.1:-.1;a.mixer.update(dt*(e.flipped?.4:e.angry?1.7:1));\n      if(e.type==='fly')a.rig.rotation.z=Math.sin(t*13)*.08;\n      a.root.scale.setScalar((e.type==='boss'?1.9:1)*(e.tell>0?1+Math.sin(t*30)*.05:1));\n      a.status.visible=!!e.flipped;a.status.position.set(e.x,e.y+(e.type==='boss'?1.25:.8),.9);\n      a.stars.forEach((m,i)=>{const angle=t*4+i*Math.PI*2/3;m.position.set(Math.cos(angle)*.55,Math.sin(angle)*.13,Math.sin(angle)*.1);m.rotation.z=-angle;});\n    }\n    for(const[id,a]of bugs)if(!liveE.has(id)){removePest(a);bugs.delete(id);}\n    const liveC=new Set();\n    for(const c of state.coins||[]){liveC.add(c.id);let m=coinMeshes.get(c.id);if(!m){m=new THREE.Group();scene.add(m);const disc=cylinder(.25,.1,0xf6c86b,m);disc.rotation.x=Math.PI/2;const center=ball(.14,0xffe6a4,m,0,0,.07,1,1,.15);coinMeshes.set(c.id,m);}m.position.set(c.x,c.y+Math.sin(t*4+c.id)*.1,.4);m.rotation.y=t*2.7;}\n    for(const[id,m]of coinMeshes)if(!liveC.has(id)){scene.remove(m);coinMeshes.delete(id);}\n    pow.visible=state.powCharges!==0;pow.rotation.z=Math.sin(t*2)*.025;\n    if(steamClock>.25){steamClock=0;for(const port of steamPorts){const m=new THREE.Mesh(new THREE.SphereGeometry(.13,6,4),new THREE.MeshBasicMaterial({color:0xa0c0b7,transparent:true,opacity:.22,depthWrite:false}));m.position.set(port.x,port.y,-1.2);scene.add(m);particles.push({mesh:m,life:1.5,max:1.5,vx:(Math.random()-.5)*.3,vy:.5,steam:true});}}\n    for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.life-=dt;if(p.life<=0){scene.remove(p.mesh);if(p.mesh.material.transparent)p.mesh.material.dispose();if(p.ring||p.steam)p.mesh.geometry.dispose();particles.splice(i,1);continue;}p.mesh.position.x+=p.vx*dt;p.mesh.position.y+=p.vy*dt;if(!p.steam)p.vy-=dt*8;if(p.ring)p.mesh.scale.setScalar(1+(1-p.life/p.max)*13);if(p.steam)p.mesh.scale.addScalar(dt*.5);if(p.mesh.material.transparent)p.mesh.material.opacity=(p.steam?.22:1)*Math.min(1,p.life/p.max*2);}\n    renderer.render(scene,camera);\n  }\n  function dispose(){renderer.dispose();scene.traverse(o=>{o.geometry?.dispose();});for(const m of materials.values())m.dispose();ink.dispose();}\n  return {render,resize,effect,dispose,renderer,camera,scene,stats:()=>({backend:renderer.backend?.isWebGPUBackend?'WebGPU':'WebGL2',actors:actors.size,enemies:bugs.size,particles:particles.length,nativeAnimationMixers:actors.size+bugs.size})};\n}\n","exit_code":0,"status":"completed"}}
