{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,110p' audio.js; sed -n '95,215p' input.js; sed -n '1,80p' test-browser-input.py; sed -n '1,90p' test-audio.py; sed -n '1,110p' test-input.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,110p' audio.js; sed -n '95,215p' input.js; sed -n '1,80p' test-browser-input.py; sed -n '1,90p' test-audio.py; sed -n '1,110p' test-input.py\"","aggregated_output":"// Grit Bros — all sound is synthesized. No audio assets or network requests.\nconst midi = n => 440 * 2 ** ((n - 69) / 12);\nconst clamp = (n, lo, hi) => Math.min(hi, Math.max(lo, Number(n) || 0));\nconst noiseBuffers = new WeakMap();\n\nfunction noiseBuffer(ctx) {\n  if (noiseBuffers.has(ctx)) return noiseBuffers.get(ctx);\n  const buffer = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate);\n  const d = buffer.getChannelData(0);\n  let seed = 17321;\n  for (let i = 0; i < d.length; i++) {\n    seed = (1664525 * seed + 1013904223) >>> 0;\n    d[i] = (seed / 4294967296) * 2 - 1;\n  }\n  noiseBuffers.set(ctx, buffer);\n  return buffer;\n}\n\nfunction note(ctx, out, frequency, at, duration, amplitude = 0.15, type = 'triangle', endFrequency = frequency, filterHz = 5500, track = null) {\n  if (!Number.isFinite(frequency) || frequency <= 0) return;\n  const osc = ctx.createOscillator();\n  const gain = ctx.createGain();\n  const filter = ctx.createBiquadFilter();\n  osc.type = type;\n  osc.frequency.setValueAtTime(Math.max(20, frequency), at);\n  if (endFrequency !== frequency) osc.frequency.exponentialRampToValueAtTime(Math.max(20, endFrequency), at + duration * 0.8);\n  filter.type = 'lowpass';\n  filter.frequency.setValueAtTime(filterHz, at);\n  filter.Q.value = 0.65;\n  gain.gain.setValueAtTime(0.0001, at);\n  gain.gain.linearRampToValueAtTime(amplitude, at + Math.min(0.008, duration * 0.1));\n  gain.gain.exponentialRampToValueAtTime(Math.max(0.0001, amplitude * 0.5), at + duration * 0.2);\n  gain.gain.exponentialRampToValueAtTime(0.0001, at + duration);\n  osc.connect(filter).connect(gain).connect(out);\n  osc.start(at);\n  osc.stop(at + duration + 0.02);\n  if (track) track.add(osc);\n  osc.onended = () => { osc.disconnect(); filter.disconnect(); gain.disconnect(); track?.delete(osc); };\n}\n\nfunction percussion(ctx, out, at, kind = 'hat', amplitude = 0.12, track = null) {\n  if (kind === 'kick') {\n    note(ctx, out, 150, at, 0.16, amplitude * 1.8, 'sine', 42, 700, track);\n    return;\n  }\n  const source = ctx.createBufferSource();\n  source.buffer = noiseBuffer(ctx);\n  const filter = ctx.createBiquadFilter();\n  filter.type = kind === 'snare' ? 'bandpass' : 'highpass';\n  filter.frequency.value = kind === 'snare' ? 1700 : 6500;\n  filter.Q.value = kind === 'snare' ? 0.65 : 0.6;\n  const env = ctx.createGain();\n  const duration = kind === 'snare' ? 0.13 : 0.047;\n  env.gain.setValueAtTime(amplitude, at);\n  env.gain.exponentialRampToValueAtTime(0.0001, at + duration);\n  source.connect(filter).connect(env).connect(out);\n  source.start(at, (at * 0.137) % 0.7);\n  source.stop(at + duration + 0.01);\n  if (track) track.add(source);\n  source.onended = () => { source.disconnect(); filter.disconnect(); env.disconnect(); track?.delete(source); };\n  if (kind === 'snare') note(ctx, out, 180, at, 0.06, amplitude * 0.25, 'triangle', 90, 1200, track);\n}\n\n// Eight-bar original melody: short brass notes, walking bass, and swung hats.\nconst melody = [\n  76, 0, 79, 81, 0, 79, 76, 0, 74, 76, 0, 72, 0, 0, 67, 0,\n  74, 0, 77, 79, 0, 77, 74, 0, 72, 74, 0, 71, 0, 0, 67, 0,\n  72, 0, 76, 79, 0, 81, 79, 76, 74, 0, 72, 71, 69, 0, 67, 0,\n  71, 0, 74, 77, 0, 76, 74, 0, 72, 0, 0, 79, 0, 0, 0, 0,\n  79, 0, 84, 83, 0, 81, 79, 0, 76, 0, 79, 76, 74, 0, 72, 0,\n  77, 0, 81, 79, 0, 77, 74, 0, 72, 0, 74, 71, 67, 0, 0, 0,\n  72, 76, 0, 79, 81, 0, 79, 0, 77, 76, 74, 72, 71, 0, 67, 0,\n  72, 0, 76, 79, 0, 76, 74, 0, 72, 0, 0, 67, 72, 0, 0, 0\n];\nconst roots = [48, 50, 45, 43, 48, 53, 50, 43];\nconst bassWalk = [0, 7, 12, 9, 0, 4, 7, 11];\nconst EIGHTH = 60 / 142 / 2;\n\nfunction musicStep(ctx, out, step, time, track = null) {\n  const bar = Math.floor(step / 16) % 8;\n  const sub = step % 16;\n  const root = roots[bar];\n  const n = melody[step % melody.length];\n  if (n) {\n    note(ctx, out, midi(n), time, EIGHTH * 0.73, 0.19, 'square', midi(n), 2300, track);\n    note(ctx, out, midi(n - 12), time + 0.004, EIGHTH * 0.56, 0.075, 'triangle', midi(n - 12), 3200, track);\n  }\n  if (sub % 2 === 0) {\n    const b = root + bassWalk[Math.floor(sub / 2)];\n    note(ctx, out, midi(b - 12), time, EIGHTH * 1.2, 0.34, 'triangle', midi(b - 12) * 0.996, 1100, track);\n  }\n  if (sub % 4 === 2) {\n    const third = bar === 1 || bar === 2 || bar === 6 ? 3 : 4;\n    for (const interval of [0, third, 7]) note(ctx, out, midi(root + 12 + interval), time, 0.07, 0.043, 'sawtooth', midi(root + 12 + interval), 1700, track);\n  }\n  percussion(ctx, out, time, 'hat', sub % 2 ? 0.055 : 0.075, track);\n  if (sub % 4 === 0) percussion(ctx, out, time, sub % 8 === 0 ? 'kick' : 'snare', 0.14, track);\n  if (sub === 15 && bar % 2 === 1) percussion(ctx, out, time, 'snare', 0.06, track);\n}\n\nfunction syllables(ctx, out, at, mood = 'hello', track = null) {\n  const phrases = {\n    hello: [0, 5, 9, 7, 12], clear: [0, 4, 7, 12, 9, 12], win: [0, 7, 12, 16, 12, 19],\n    hurt: [7, 3, -3], lose: [7, 3, 0, -5], pow: [0, 0, 12, 7], kick: [0, 7, 4]\n  };\n  const phrase = phrases[mood] || phrases.hello;\n  const vowels = [[730, 1090], [330, 2300], [280, 900], [570, 840], [450, 1850]];\n  phrase.forEach((pitch, i) => {\n    const t = at + i * 0.078;\n    const dur = i === phrase.length - 1 ? 0.13 : 0.065;\n    const now = performance.now();\n    const previous = this.keyboardRepeat.get(event.code) || -1000;\n    if (!event.repeat || now - previous >= 150) {\n      this.keyboardRepeat.set(event.code, now);\n      this.onMenu(action);\n    }\n  }\n\n  _pointerDown(event) {\n    if (event.pointerType !== 'touch') {\n      this._activity('mouse');\n      return;\n    }\n    this._activity('touch');\n    const target = event.target;\n    const menu = target.closest?.('#touch-menu');\n    const thump = target.closest?.('#touch-thump');\n    if (menu) {\n      event.preventDefault();\n      this.onPause();\n      return;\n    }\n    if (!gameplayMode(this.mode)) return;\n    // Let menu buttons, developer sliders, and dialogs retain their normal behavior.\n    if (!thump && target.closest?.('button,input,select,textarea,[role=\"dialog\"]')) return;\n    event.preventDefault();\n    const role = thump ? 'action' : event.clientX < window.innerWidth * 0.5 ? 'move' : 'jump';\n    this.touchPoints.set(event.pointerId, { role, startX: event.clientX, x: event.clientX, y: event.clientY });\n    // A quick tap can start and end between animation frames. Keep its action\n    // until the next input sample, while holds continue through touchPoints.\n    if (role === 'jump') this.pending[0].jump = true;\n    if (role === 'action') this.pending[0].action = true;\n    try { target.setPointerCapture?.(event.pointerId); } catch {}\n    if (thump) this.touchAction = true;\n  }\n\n  _pointerMove(event) {\n    if (event.pointerType !== 'touch') {\n      // Browser-generated touch mouse events do not steal touch prompts.\n      if (event.pointerType === 'mouse' && (Math.abs(event.movementX) + Math.abs(event.movementY) > 1)) this._activity('mouse');\n      return;\n    }\n    const point = this.touchPoints.get(event.pointerId);\n    if (!point) return;\n    event.preventDefault();\n    point.x = event.clientX; point.y = event.clientY;\n  }\n\n  _pointerUp(event) {\n    const point = this.touchPoints.get(event.pointerId);\n    if (!point) return;\n    event.preventDefault();\n    this.touchPoints.delete(event.pointerId);\n    this.touchAction = [...this.touchPoints.values()].some(p => p.role === 'action');\n  }\n\n  setMode(mode) {\n    if (this.mode !== mode) {\n      this.menuRepeat = { direction: '', next: 0 };\n      this.touchPoints.clear(); this.touchAction = false;\n    }\n    this.mode = mode;\n    this._syncTouchUI();\n  }\n  setLocalCoop(value) { this.localCoop = Boolean(value); }\n  setGlyphStyle(style) { this.glyphStyle = style === 'xbox' ? 'xbox' : 'ps'; }\n  get glyphs() { return this.glyphStyle; }\n  set glyphs(value) { this.setGlyphStyle(value); }\n\n  update() {\n    this.pads = [emptyPlayer(), emptyPlayer()];\n    let gamepads = [];\n    try { gamepads = Array.from(navigator.getGamepads?.() || []).filter(p => p && p.connected !== false).slice(0, 2); } catch {}\n    const now = performance.now();\n    let menuDirection = '';\n    gamepads.forEach((pad, slot) => {\n      const buttons = Array.from(pad.buttons || [], b => Boolean(typeof b === 'number' ? b > 0.5 : b?.pressed || b?.value > 0.5));\n      const axes = Array.from(pad.axes || []);\n      const old = this.padPrevious.get(pad.index ?? slot) || { buttons: [], axes: [] };\n      const pressed = i => buttons[i] && !old.buttons[i];\n      const changedButton = buttons.some((b, i) => b && !old.buttons[i]);\n      const changedAxis = axes.some((a, i) => Math.abs(a) > 0.25 && Math.abs(a - (old.axes[i] || 0)) > 0.08);\n      if (changedButton || changedAxis) this._activity('gamepad');\n      let x = deadzone(axes[0] || 0);\n      if (buttons[14]) x = -1;\n      if (buttons[15]) x = 1;\n      this.pads[slot] = { x, jump: Boolean(buttons[0]), action: Boolean(buttons[2]), jumpPressed: pressed(0), actionPressed: pressed(2) };\n      if (pressed(9)) {\n        if (gameplayMode(this.mode)) this.onPause();\n        else this.onMenu('back');\n      }\n      if (slot === 1 && !this.localCoop && pressed(0)) this.onJoin();\n      if (!gameplayMode(this.mode) && slot === 0) {\n        if (pressed(0)) this.onMenu('confirm');\n        if (pressed(1)) this.onMenu('back');\n        const y = deadzone(axes[1] || 0);\n        menuDirection = buttons[12] || y < -0.5 ? 'up' : buttons[13] || y > 0.5 ? 'down' : x < -0.5 ? 'left' : x > 0.5 ? 'right' : '';\n      }\n      this.padPrevious.set(pad.index ?? slot, { buttons, axes });\n    });\n    if (!gameplayMode(this.mode) && menuDirection) {\n      if (this.menuRepeat.direction !== menuDirection) {\n        this.onMenu(menuDirection); this.menuRepeat = { direction: menuDirection, next: now + 340 };\n      } else if (now >= this.menuRepeat.next) {\n        this.onMenu(menuDirection); this.menuRepeat.next = now + 155;\n      }\n    } else this.menuRepeat = { direction: '', next: 0 };\n    const key = code => this.keys.has(code);\n    const kx1 = Number(key('KeyD') || key('ArrowRight')) - Number(key('KeyA') || key('ArrowLeft'));\n    const kx2 = Number(key('KeyL')) - Number(key('KeyJ'));\n    let touchX = 0, touchJump = false;\n    for (const point of this.touchPoints.values()) {\n      if (point.role === 'move') touchX = Math.max(-1, Math.min(1, (point.x - point.startX) / Math.max(32, Math.min(70, window.innerWidth * 0.09))));\n      if (point.role === 'jump') touchJump = true;\n    }\n    const p1 = {\n      x: touchX || kx1 || this.pads[0].x,\n      jump: key('Space') || key('KeyW') || key('ArrowUp') || this.pads[0].jump || touchJump || this.pending[0].jump,\n      action: key('KeyE') || key('KeyX') || this.pads[0].action || this.touchAction || this.pending[0].action\n    };\n    const p2 = this.localCoop ? {\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nroot = Path(__file__).parent\nhtml = root.parent / (root.name + '.html')\nchecks = 0\nfailures = []\nerrors = []\ndef check(condition, message):\n    global checks\n    checks += 1\n    if not condition: failures.append(message)\ndef mode(page, target):\n    page.wait_for_function('(target) => window.Grit?.mode === target', arg=target, timeout=15000)\ndef pad_button(page, index, pressed=True):\n    page.evaluate('(args) => { const [index,pressed]=args; padList[0].buttons[index]={pressed,value:pressed?1:0}; }', [index, pressed])\n    page.wait_for_timeout(80)\ndef press_pad(page,index):\n    pad_button(page,index,True); pad_button(page,index,False)\n\nwith sync_playwright() as p:\n    browser=p.chromium.launch(headless=True,args=['--no-sandbox','--autoplay-policy=no-user-gesture-required','--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n    context=browser.new_context(viewport={'width':1100,'height':700})\n    page=context.new_page()\n    page.on('pageerror',lambda error:errors.append('desktop: '+str(error)))\n    page.add_init_script('''window.padList=[]; Object.defineProperty(navigator,'getGamepads',{value:()=>window.padList});''')\n    page.goto(html.as_uri()+'?visual-qa=1')\n    page.wait_for_function('window.Grit',timeout=60000)\n    check(page.title().startswith('Grit Bros'), 'Final HTML title did not identify the game')\n    check(page.evaluate('Grit.mode')=='title', 'Final HTML did not reach title screen')\n    check(page.evaluate('Grit.audio.musicVolume')==0.1, 'Default music volume is not 10%')\n    page.keyboard.press('Enter');mode(page,'play')\n    check(page.evaluate('Grit.state.players[0].active'), 'Keyboard start did not activate P1')\n    page.evaluate('Grit.settings.invincible=true')\n    start_x=page.evaluate('Grit.state.players[0].x')\n    page.keyboard.down('d');page.wait_for_timeout(220);page.keyboard.up('d')\n    check(page.evaluate('Grit.state.players[0].x')>start_x+0.2,'Keyboard movement did not move P1')\n    page.keyboard.press('Escape');mode(page,'pause')\n    check(page.locator('.panel h1').inner_text()=='TAKE FIVE.','Keyboard pause panel missing')\n    page.keyboard.press('ArrowDown');page.keyboard.press('ArrowDown');page.keyboard.press('ArrowDown');page.keyboard.press('Enter');mode(page,'dev')\n    check(page.locator('[data-setting=\"speed\"]').count()==1,'Pause menu could not navigate to dev workshop')\n    speed=page.evaluate('Grit.settings.speed')\n    page.keyboard.press('ArrowRight')\n    check(page.evaluate('Grit.settings.speed')>speed,'Dev speed slider did not apply live')\n    page.keyboard.press('ArrowDown')\n    check(page.locator('[data-setting=\"jump\"]').evaluate('(el)=>el.classList.contains(\"selected\")'),'Keyboard failed to focus jump slider')\n    page.keyboard.press('ArrowDown')\n    check(page.locator('[data-setting=\"gravity\"]').evaluate('(el)=>el.classList.contains(\"selected\")'),'Keyboard Up/Down gets trapped in focused range sliders')\n    page.keyboard.press('Escape');mode(page,'pause');page.keyboard.press('Escape');mode(page,'play')\n    check(page.evaluate('Grit.mode')=='play','Keyboard could not resume from dev workshop')\n    offline=page.evaluate('() => Grit.audio.testOffline()')\n    check(offline['invalidSamples']==0 and offline['rms']>0.005 and offline['peak']<1,'Bundled procedural audio failed finite/audible/unclipped validation')\n    check(page.evaluate('Grit.audio.ctx.state')=='running','Audio context did not unlock through keyboard start')\n    page.evaluate('''() => { Grit.showTitle(); window.padList=[{index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))}]; }''')\n    page.wait_for_timeout(80)\n    press_pad(page,13)\n    check(page.locator('[data-action=\"coop\"]').evaluate('(el)=>el.classList.contains(\"selected\")'),'Standard controller could not navigate title menu')\n    press_pad(page,0);mode(page,'play')\n    check(page.evaluate('Grit.state.players.filter(p=>p.active).length')==2,'Controller confirmation did not start couch co-op')\n    page.evaluate('Grit.settings.invincible=true')\n    page.evaluate('padList[0].axes[0]=-1');page.wait_for_timeout(120)\n    check(page.evaluate('Grit.input.getPlayers()[0].x')==-1,'Controller left stick did not reach game input')\n    check(page.evaluate('Grit.input.lastType')=='gamepad','Controller prompts did not follow actual input')\n    page.evaluate('padList[0].axes[0]=0')\n    press_pad(page,9);mode(page,'pause')\n    check(page.evaluate('Grit.mode')=='pause','Controller Options did not pause')\n    press_pad(page,0);mode(page,'play')\n    check(page.evaluate('Grit.mode')=='play','Controller Cross did not resume')\n    check(not errors,'Bundled desktop browser emitted JavaScript errors: '+'; '.join(errors))\n    context.close()\n    phone=browser.new_context(viewport={'width':390,'height':844},is_mobile=True,has_touch=True,device_scale_factor=1)\n    page=phone.new_page();page.on('pageerror',lambda error:errors.append('phone: '+str(error)))\n    page.goto(html.as_uri()+'?visual-qa=1');page.wait_for_function('window.Grit',timeout=60000)\n    page.locator('[data-action=\"solo\"]').tap();mode(page,'play')\n    check(page.evaluate('Grit.input.isTouch && Grit.input.lastType===\"touch\"'),'Phone did not identify touchscreen input')\n    check(page.evaluate('document.body.classList.contains(\"touch\")'),'Touch menu tap incorrectly restored dense desktop UI')\n    check(page.locator('#touch-menu').is_visible(),'Phone touch pause button is missing')\n    page.locator('#touch-menu').tap();mode(page,'pause')\n    check(page.evaluate('Grit.mode')=='pause','Phone pause button failed')\n    page.locator('[data-action=\"resume\"]').tap();mode(page,'play')\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nfailures = []\nchecks = 0\n\ndef check(condition, message):\n    global checks\n    checks += 1\n    if not condition:\n        failures.append(message)\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True, args=['--no-sandbox', '--autoplay-policy=no-user-gesture-required'])\n    page = browser.new_page()\n    page.goto('about:blank')\n    source = Path(__file__).with_name('audio.js').read_text().replace('export class AudioEngine', 'class AudioEngine')\n    page.add_script_tag(content=source + '\\nwindow.synth = new AudioEngine();')\n    result = page.evaluate('async () => { const unlocked = await synth.unlock(); synth.update(0.1, \"play\"); for (const s of [\"jump\",\"bump\",\"kick\",\"coin\",\"hurt\",\"clear\",\"pow\",\"win\",\"lose\",\"select\"]) synth.play(s); synth.speak(\"hello\"); return {unlocked,diag:synth.getDiagnostics(),offline:await synth.testOffline()}; }')\n    d = result['diag']; o = result['offline']\n    check(result['unlocked'], 'AudioContext failed to unlock')\n    check(d['musicVolume'] == 0.1, 'Music default is not 10%')\n    check(d['musicActive'] and d['notes'] > 0, 'Music transport failed to start')\n    check(all(d['events'].get(s, 0) == 1 for s in ['jump','bump','kick','coin','hurt','clear','pow','win','lose','select','voice']), 'SFX or voice dispatch failed')\n    check(o['supported'] and o['invalidSamples'] == 0, 'Offline synthesis emitted invalid samples')\n    check(o['rms'] > 0.005 and o['peak'] > 0.1, 'Synthesized output is silent or unexpectedly quiet')\n    check(o['peak'] < 1 and o['channels'] == 2, 'Offline output clips or has wrong channel count')\n    paused = page.evaluate('() => { synth.update(0.1,\"pause\"); return synth.getDiagnostics(); }')\n    check(not paused['musicActive'], 'Pause did not stop music scheduling')\n    resumed = page.evaluate('() => { synth.update(0.1,\"play\"); synth.setMusicVolume(0.4); synth.setSfxVolume(0.3); synth.setMuted(true); return synth.getDiagnostics(); }')\n    check(resumed['musicActive'] and resumed['musicVolume'] == 0.4 and resumed['sfxVolume'] == 0.3 and resumed['muted'], 'Volume or mute setters failed')\n    page.evaluate('() => synth.dispose()')\n    browser.close()\n\nfor failure in failures:\n    print('FAIL: ' + failure)\nprint(f'{checks} audio checks, {len(failures)} failures')\nraise SystemExit(bool(failures))\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nchecks = 0\nfailures = []\ndef check(condition, message):\n    global checks\n    checks += 1\n    if not condition:\n        failures.append(message)\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True, args=['--no-sandbox'])\n    context = browser.new_context(has_touch=True, is_mobile=True, viewport={'width': 900, 'height': 600})\n    page = context.new_page()\n    page.set_content('<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><div id=\"touch-controls\"><button id=\"touch-menu\">Menu</button><button id=\"touch-thump\">Thump</button></div><input id=\"range\" type=\"range\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"><input id=\"text\" type=\"text\">')\n    page.evaluate('''() => { window.padList=[]; Object.defineProperty(navigator,'getGamepads',{value:()=>window.padList}); window.activity=[]; window.menu=[]; window.pauses=0; window.joins=0; }''')\n    source = Path(__file__).with_name('input.js').read_text().replace('export class Input', 'class Input')\n    page.add_script_tag(content=source + '\\nwindow.input = new Input({onActivity:t=>activity.push(t),onMenu:a=>menu.push(a),onPause:()=>pauses++,onJoin:()=>joins++});')\n    page.evaluate('() => input.setMode(\"play\")')\n    page.keyboard.down('d'); page.keyboard.down('Space'); page.keyboard.down('e')\n    state = page.evaluate('() => { input.update(); return input.getPlayers(); }')\n    check(state[0]['x'] == 1 and state[0]['jump'] and state[0]['action'], 'P1 keyboard movement/jump/action failed')\n    check(state[0]['jumpPressed'] and state[0]['actionPressed'], 'Keyboard press edges failed')\n    state = page.evaluate('() => { input.update(); return input.getPlayers(); }')\n    check(not state[0]['jumpPressed'] and not state[0]['actionPressed'], 'Held keyboard incorrectly repeats press edges')\n    page.keyboard.up('d'); page.keyboard.up('Space'); page.keyboard.up('e')\n    check(page.evaluate('() => { input.update(); return input.getPlayers()[0].x; }') == 0, 'Keyboard release did not clear movement')\n    page.evaluate('() => input.setLocalCoop(true)')\n    page.keyboard.down('j'); page.keyboard.down('i'); page.keyboard.down('o')\n    state = page.evaluate('() => { input.update(); return input.getPlayers()[1]; }')\n    check(state['x'] == -1 and state['jump'] and state['action'], 'P2 keyboard controls failed')\n    page.keyboard.up('j'); page.keyboard.up('i'); page.keyboard.up('o')\n    page.keyboard.press('Escape')\n    check(page.evaluate('() => pauses') == 1, 'Keyboard pause failed')\n    page.evaluate('() => { input.setMode(\"menu\"); menu.length=0; }')\n    page.keyboard.press('ArrowDown'); page.keyboard.press('Enter'); page.keyboard.press('Escape')\n    check(page.evaluate('() => menu') == ['down','confirm','back'], 'Keyboard menu controls failed')\n    page.evaluate('() => { menu.length=0; document.getElementById(\"range\").focus(); }')\n    page.keyboard.press('ArrowDown'); page.keyboard.press('ArrowUp'); page.keyboard.press('ArrowRight')\n    check(page.evaluate('() => menu') == ['down','up','right'], 'Focused range slider trapped keyboard navigation')\n    check(page.locator('#range').input_value() == '0.5', 'Slider received duplicate native arrow adjustment')\n    page.locator('#text').focus(); page.keyboard.type('room')\n    check(page.locator('#text').input_value() == 'room', 'Text inputs lost native keyboard typing')\n    page.locator('#text').evaluate('(el)=>el.blur()')\n    page.evaluate('''() => { window.makePad=(index=0)=>({index,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))}); padList=[makePad()]; input.setMode('play'); input.update(); padList[0].axes[0]=0.8; padList[0].buttons[0]={pressed:true,value:1}; padList[0].buttons[2]={pressed:true,value:1}; input.update(); }''')\n    state = page.evaluate('() => input.getPlayers()[0]')\n    check(state['x'] > 0.7 and state['jump'] and state['action'], 'Standard gamepad controls failed')\n    check(page.evaluate('() => input.lastType') == 'gamepad', 'Gamepad did not change prompts on input')\n    page.evaluate('() => input._activity(\"mouse\")')\n    page.evaluate('() => input.update()')\n    check(page.evaluate('() => input.lastType') == 'mouse', 'Held gamepad stole mouse prompts')\n    page.evaluate('() => { input.setGlyphStyle(\"xbox\"); input.lastType=\"gamepad\"; }')\n    check(page.evaluate('() => input.getPrompt(\"jump\")') == 'A', 'Xbox glyph option failed')\n    page.evaluate('() => input.setGlyphStyle(\"ps\")')\n    check(page.evaluate('() => input.getPrompt(\"action\")') == '□', 'PlayStation glyph option failed')\n    page.evaluate('() => { padList[0].buttons[9]={pressed:true,value:1}; input.update(); input.update(); }')\n    check(page.evaluate('() => pauses') == 2, 'Gamepad pause did not respect press edges')\n    page.evaluate('() => { input.setLocalCoop(false); padList.push(makePad(1)); input.update(); padList[1].buttons[0]={pressed:true,value:1}; input.update(); input.update(); }')\n    check(page.evaluate('() => joins') == 1, 'Second gamepad join did not respect press edges')\n    page.evaluate('() => { input.setMode(\"menu\"); menu.length=0; padList=[makePad()]; input.update(); padList[0].buttons[13]={pressed:true,value:1}; input.update(); for(let i=0;i<15;i++)input.update(); }')\n    check(page.evaluate('() => menu') == ['down'], 'Held gamepad menu navigation repeated too quickly')\n    page.evaluate('''() => { padList=[]; input.clear(); input.setMode('play'); window.touch=(type,id,x,y,target=document.body)=>target.dispatchEvent(new PointerEvent(type,{pointerId:id,pointerType:'touch',clientX:x,clientY:y,bubbles:true,cancelable:true})); touch('pointerdown',1,100,400); touch('pointermove',1,170,400); touch('pointerdown',2,750,400); input.update(); }''')\n    state = page.evaluate('() => input.getPlayers()[0]')\n    check(state['x'] == 1 and state['jump'], 'Multitouch movement and jump failed')\n    check(page.evaluate('() => input.lastType') == 'touch', 'Touch did not change prompts')\n    page.evaluate('() => { touch(\"pointerup\",1,170,400); touch(\"pointerup\",2,750,400); touch(\"pointerdown\",3,30,20,document.getElementById(\"touch-thump\")); input.update(); }')\n    state = page.evaluate('() => input.getPlayers()[0]')\n    check(state['action'] and not state['jump'] and state['x'] == 0, 'Contextual touch thump or touch release failed')\n    page.evaluate('() => { touch(\"pointerup\",3,30,20); input.clear(); input.update(); }')\n    check(page.evaluate('() => input.getPlayers().every(p=>!p.x&&!p.jump&&!p.action)') == True, 'Clearing input left a held control')\n    page.evaluate('''() => { touch('pointerdown',4,30,20,document.getElementById('touch-thump')); touch('pointerup',4,30,20); touch('pointerdown',5,750,400); touch('pointerup',5,750,400); input.update(); }''')\n    check(page.evaluate('() => input.getPlayers()[0].action && input.getPlayers()[0].jump'), 'Fast touch taps were lost between input samples')\n    check(page.evaluate('() => { input.update(); return !input.getPlayers()[0].action && !input.getPlayers()[0].jump; }'), 'Fast touch tap latch persisted after one sample')\n    page.keyboard.press('Space'); page.keyboard.press('e')\n    check(page.evaluate('() => { input.update(); return input.getPlayers()[0].action && input.getPlayers()[0].jump; }'), 'Fast keyboard presses were lost between input samples')\n    page.evaluate('() => input.dispose()')\n    context.close(); browser.close()\n\nfor failure in failures: print('FAIL: ' + failure)\nprint(f'{checks} input checks, {len(failures)} failures')\nraise SystemExit(bool(failures))\n","exit_code":0,"status":"completed"}}
