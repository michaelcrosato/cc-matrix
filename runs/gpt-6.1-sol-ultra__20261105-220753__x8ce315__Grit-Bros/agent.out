mmonjs\",\n  \"dependencies\": {\n    \"@dimforge/rapier2d-compat\": \"0.19.3\",\n    \"esbuild\": \"0.25.12\",\n    \"three\": \"0.180.0\"\n  }\n}\nimport RAPIER from '@dimforge/rapier2d-compat';\nimport { readFile } from 'node:fs/promises';\nconst source = (await readFile(new URL('./game.js', import.meta.url), 'utf8')).replace(\"import RAPIER from '@dimforge/rapier2d-compat';\", 'const RAPIER=globalThis.__testRapier;');\nglobalThis.__testRapier = RAPIER;\nconst { Game, initPhysics, SHIFTS } = await import('data:text/javascript;base64,' + Buffer.from(source).toString('base64'));\nconst originalWarn = console.warn;\nconsole.warn = (...args) => { if (!String(args[0]).includes('deprecated parameters')) originalWarn(...args); };\nawait initPhysics();\nconsole.warn = originalWarn;\nconst failures = [];\nlet count = 0;\nconst check = (pass, name) => { count++; if (!pass) failures.push(name); };\nconst near = (a, b, tolerance = .2) => Math.abs(a - b) < tolerance;\nconst worlds = [];\nconst fresh = (events = []) => { const game = new Game((type, data) => events.push({ type, data })); game.phaseDelay = 999; worlds.push(game); return game; };\nconst frames = (game, n, input = {}) => { for (let i = 0; i < n; i++) game.step(1 / 60, [input]); };\nconst move = fresh();\nframes(move, 60);\ncheck(near(move.players[0].y, .59) && move.players[0].grounded, 'Rapier player settles on floor');\nconst startX = move.players[0].x;\nframes(move, 60, { x: 1 });\ncheck(move.players[0].x > startX + 5.5 && near(move.players[0].vx, move.settings.speed), 'controller axis drives horizontal movement');\nmove.teleport(move.players[0], 0, .7);frames(move, 10);\nlet apex = 0;\nfor (let i = 0; i < 85; i++) { move.step(1 / 60, [{ jump: true }]); apex = Math.max(apex, move.players[0].y); }\ncheck(apex > 5.3 && apex < 6.5, 'held jump reaches upper platform height');\nframes(move, 40, { jump: true });\ncheck(move.players[0].y < .8, 'holding jump does not auto-repeat');\nframes(move, 1, { jump: false });frames(move, 6, { jump: true });\ncheck(move.players[0].vy > 10, 'jump re-arms on release');\nmove.teleport(move.players[0], 12.45, .8);frames(move, 4, { x: 1 });\ncheck(move.players[0].x < -11, 'screen wraps at right edge');\nconst events = [], bump = fresh(events);\nconst pest = bump.spawn('beetle', -6, 4.7);\nbump.teleport(bump.players[0], -6, .7);frames(bump, 30);\nframes(bump, 30, { jump: true });\ncheck(bump.stats.bumps >= 1 && pest.flipped && events.some(e => e.type === 'bump'), 'actual underside collision flips beetle');\ncheck(bump.stats.hits === 0, 'platform protects player from pest above');\nbump.teleport(bump.players[0], pest.x, pest.y);frames(bump, 1);\ncheck(!bump.enemies.includes(pest) && bump.stats.kicks === 1 && bump.score >= 150, 'touching flipped pest kicks and scores');\ncheck(bump.coins.length === 1, 'kick releases a brass token');\nconst token = bump.coins[0];frames(bump, 17);bump.teleport(bump.players[0], token.x, token.y);frames(bump, 1);\ncheck(bump.stats.coins === 1 && bump.score >= 250, 'physical token pickup scores');\nconst armor = fresh();\nconst crab = armor.spawn('crab', -6, 4.7);frames(armor, 30);\narmor.bump(crab.x, 4);\ncheck(!crab.flipped && crab.hp === 1 && crab.angry, 'first crab bump cracks shell and enrages');\narmor.bump(crab.x, 4);\ncheck(crab.flipped && crab.hp === 0, 'second crab bump flips');\narmor.settings.stunTime = .1;crab.stun = .1;frames(armor, 10);\ncheck(!crab.flipped && crab.hp === 2 && crab.angry, 'unkicked pest recovers and gets faster');\nconst boss = armor.spawn('boss', 7, 13.5);frames(armor, 30);\nfor (let i = 0; i < 2; i++) armor.bump(boss.x, 12);\ncheck(!boss.flipped && boss.hp === 1 && armor.stats.bossHits === 2, 'boss armor takes two hits');\narmor.bump(boss.x, 12);\ncheck(boss.flipped && armor.stats.bossHits === 3, 'third boss bump exposes final kick');\narmor.kick(boss, armor.players[0]);\ncheck(!armor.enemies.includes(boss) && armor.score >= 2500, 'boss kick awards big score');\nconst power = fresh();\nconst floorPest = power.spawn('beetle', 7, .7);frames(power, 30);\ncheck(power.pow() && floorPest.flipped && power.powCharges === 1, 'POW flips grounded pests and consumes charge');\ncheck(!power.pow() && power.powCharges === 1, 'POW cooldown blocks repeat');\nframes(power, 40);\ncheck(power.pow() && power.powCharges === 0 && !power.pow(), 'POW charges exhaust');\nconst danger = fresh();frames(danger, 125);\nconst p = danger.players[0];danger.hurt(p);\ncheck(danger.lives === 4 && danger.stats.hits === 1 && p.hurt > 0, 'damage removes shared life');\ndanger.hurt(p);check(danger.lives === 4, 'damage invulnerability prevents double hit');\np.hurt = 0;danger.settings.invincible = true;danger.hurt(p);check(danger.lives === 4, 'developer invincibility works');\ndanger.settings.invincible = false;danger.lives = 1;danger.hurt(p);check(danger.ended && !danger.won, 'last life ends run');\nconst frozenTime = danger.time;frames(danger, 20, { x: 1 });check(danger.time === frozenTime, 'ended game freezes simulation');\nconst bonus = fresh();bonus.enterPhase(3);\ncheck(bonus.coins.length === 18 && bonus.coins.every(c => c.static), 'bonus shift places all 18 tokens');\nfor (const coin of [...bonus.coins]) bonus.collect(coin);\nframes(bonus, 125);\n      a.position.set(s*.38,.13,0);rig.add(a);box(.18,.35,.22,suit,a,0,-.15,0);ball(.13,palette.cream,a,0,-.36,.01,1,.95,1);\n      l.position.set(s*.2,-.34,0);rig.add(l);box(.22,.27,.24,0x34475e,l,0,-.12,0);box(.28,.17,.39,0x172b39,l,0,-.27,.08);\n    }\n    const mixer=new THREE.AnimationMixer(rig);\n    const run=new THREE.AnimationClip('run',.48,[\n      new THREE.NumberKeyframeTrack('legL.rotation[z]',[0,.12,.24,.36,.48],[.55,0,-.55,0,.55]),\n      new THREE.NumberKeyframeTrack('legR.rotation[z]',[0,.12,.24,.36,.48],[-.55,0,.55,0,-.55]),\n      new THREE.NumberKeyframeTrack('armL.rotation[z]',[0,.24,.48],[-.4,.4,-.4]),\n      new THREE.NumberKeyframeTrack('armR.rotation[z]',[0,.24,.48],[.4,-.4,.4]),\n      new THREE.NumberKeyframeTrac