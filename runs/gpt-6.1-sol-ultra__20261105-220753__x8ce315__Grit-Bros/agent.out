{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,110p' scene.js\"","aggregated_output":"import * as THREE from 'three/webgpu';\nimport {color, normalWorld, vec3} from 'three/tsl';\n\n// Every shape, ink stroke and piece of set dressing is built here from geometry.\nexport async function createScene(canvas) {\n  const renderer = new THREE.WebGPURenderer({canvas,antialias:true,alpha:false});\n  renderer.setPixelRatio(Math.min(devicePixelRatio || 1,2));\n  renderer.setClearColor(0x101f2b,1);\n  await renderer.init();\n  const scene = new THREE.Scene();\n  scene.background = new THREE.Color(0x101f2b);\n  const camera = new THREE.OrthographicCamera(-17.4,17.4,18.1,-1.5,.1,100);\n  camera.position.set(0,8.3,45); camera.lookAt(0,8.3,0);\n  const ink = new THREE.MeshBasicMaterial({color:0x07121b,side:THREE.BackSide});\n  const palette = {ink:0x07121b,wall:0x203745,stone:0x294653,cream:0xf5d99b,teal:0x309c99,copper:0xc57749,orange:0xe89542,red:0xe65d47,blue:0x517a9e,mint:0x9ad5b0,purple:0x8e75ab,white:0xfff3cc};\n  const materials = new Map();\n  function mat(hex,flat=false){\n    const key=hex+':'+flat; if(materials.has(key))return materials.get(key);\n    const m=new THREE.MeshBasicNodeMaterial();\n    const band=normalWorld.dot(vec3(-.45,.7,.8).normalize()).max(0).mul(3).floor().div(3).mul(.40).add(.60);\n    m.colorNode=flat?color(hex):color(hex).mul(band);\n    materials.set(key,m);return m;\n  }\n  const stage=new THREE.Group();scene.add(stage);\n  function shape(geo,hex,parent,x=0,y=0,z=0,outline=true){\n    const mesh=new THREE.Mesh(geo,mat(hex));mesh.position.set(x,y,z);parent.add(mesh);\n    if(outline){const hull=new THREE.Mesh(geo,ink);hull.scale.setScalar(1.035);mesh.add(hull);}\n    return mesh;\n  }\n  function box(w,h,d,c,p,x=0,y=0,z=0,o=true){return shape(new THREE.BoxGeometry(w,h,d),c,p,x,y,z,o);}\n  function ball(r,c,p,x=0,y=0,z=0,sx=1,sy=1,sz=1,o=true){const s=shape(new THREE.SphereGeometry(r,12,8),c,p,x,y,z,o);s.scale.set(sx,sy,sz);return s;}\n  function cylinder(r,h,c,p,x=0,y=0,z=0,o=true){return shape(new THREE.CylinderGeometry(r,r,h,16),c,p,x,y,z,o);}\n  function line(points,r,c,p){const curve=new THREE.CatmullRomCurve3(points.map(a=>new THREE.Vector3(...a)));return shape(new THREE.TubeGeometry(curve,Math.max(8,points.length*8),r,8,false),c,p);}\n  function label(text,w,h,x,y,z,opts={}){\n    const c=document.createElement('canvas');c.width=1024;c.height=Math.ceil(1024*h/w);const ctx=c.getContext('2d');\n    ctx.fillStyle=opts.bg||'#142e3b';ctx.fillRect(0,0,c.width,c.height);\n    ctx.strokeStyle=opts.border||'#c6a676';ctx.lineWidth=10;ctx.strokeRect(10,10,c.width-20,c.height-20);\n    ctx.fillStyle=opts.fg||'#f3dba7';ctx.textAlign='center';ctx.textBaseline='middle';ctx.font=`900 ${Math.floor(c.height*.58)}px Arial`;ctx.fillText(text,c.width/2,c.height*.52,c.width*.9);\n    const tex=new THREE.CanvasTexture(c);tex.colorSpace=THREE.SRGBColorSpace;\n    const m=new THREE.MeshBasicMaterial({map:tex,transparent:false});const mesh=new THREE.Mesh(new THREE.PlaneGeometry(w,h),m);mesh.position.set(x,y,z);stage.add(mesh);return mesh;\n  }\n  // Brickwork is deliberately irregular, with bevel-like mortar and ink strokes.\n  box(42,23,.6,0x152d3b,stage,0,8,-3.3,false);\n  for(let row=0;row<10;row++){\n    for(let col=0;col<13;col++){\n      const x=-19+col*3.15+(row%2?1.55:0),y=-1+row*2.05;\n      box(3.02,1.92,.13,[0x203b49,0x24414e,0x1d3745,0x284451][(row*7+col*3)%4],stage,x,y,-2.9,false);\n      if((row*3+col)%7===0)line([[x-.9,y-.4,-2.79],[x-.4,y-.1,-2.79],[x-.2,y+.6,-2.79]],.018,0x132f3e,stage);\n    }\n  }\n  // Concentric brick alcove and central enamel sign.\n  for(let i=0;i<11;i++){\n    const a=Math.PI*.13+i/10*Math.PI*.74;\n    const b=box(1.25,.75,.25,0x355663,stage,Math.cos(a)*5.4,9.5+Math.sin(a)*5,-2.5);b.rotation.z=a-Math.PI/2;\n  }\n  box(6.5,1.7,.4,0x0e2633,stage,0,13.5,-2.4);\n  label('GRIT WORKS',6.1,1.35,0,13.5,-2.15,{bg:'#153440',fg:'#edd49e'});\n  label('NIGHT SHIFT  •  EST. 1983',5.8,.56,0,12.25,-2.1,{bg:'#152d3b',border:'#345c67',fg:'#739793'});\n  // Heavy side plumbing, flanges, valves, and ceramic lamps.\n  const steamPorts=[];\n  function pipePath(points,r,c){return line(points,r,c,stage);}\n  for(const s of [-1,1]){\n    pipePath([[s*14.4,-1,-1.8],[s*14.4,5,-1.8],[s*15.3,7,-1.8],[s*15.3,14.1,-1.8],[s*12.2,15.2,-1.8]],.48,palette.copper);\n    pipePath([[s*12.5,13.6,-.4],[s*12.5,14.75,-.4],[s*10.6,14.75,-.4],[s*10.6,13.4,-.4]],.77,palette.teal);\n    const lip=cylinder(.91,.3,palette.teal,stage,s*10.6,13.35,-.4);lip.rotation.x=0;\n    cylinder(.72,.018,0x071820,stage,s*10.6,13.175,-.4);\n    for(const y of [1.7,5,9.8,13]){\n      const f=cylinder(.66,.19,palette.cream,stage,s*(y>6?15.3:14.4),y,-1.8);\n      for(let i=0;i<4;i++){ball(.075,0x5d4535,stage,f.position.x+Math.cos(i*Math.PI/2)*.55,y+.13,-1.8+Math.sin(i*Math.PI/2)*.55);}\n    }\n    const v=new THREE.Group();v.position.set(s*14.4,7.2,-.9);stage.add(v);\n    const tor=shape(new THREE.TorusGeometry(.64,.095,8,16),palette.red,v);\n    for(let j=0;j<3;j++){const spoke=box(1.15,.08,.1,palette.red,v);spoke.rotation.z=j*Math.PI/3;}\n    ball(.16,palette.cream,v,0,0,.08);\n    // Hooded lights.\n    box(.12,.9,.18,0x627879,stage,s*5.9,10.2,-2.3);\n    const lamp=shape(new THREE.ConeGeometry(.65,.4,12),palette.cream,stage,s*5.9,10.65,-1.65);\n    ball(.29,0xffdc83,stage,s*5.9,10.45,-1.5,1,.6,1,false);\n    const halo=new THREE.Mesh(new THREE.CircleGeometry(1.05,32),new THREE.MeshBasicMaterial({color:0xe5ac47,transparent:true,opacity:.055,depthWrite:false}));halo.position.set(s*5.9,10.45,-2.35);stage.add(halo);\n    steamPorts.push({x:s*14.4,y:2.5});\n    label(s<0?'01 / INTAKE':'02 / RETURN',3.7,.6,s*9.1,1.4,-2.4,{bg:'#203b49',fg:'#8ca9a6',border:'#35515a'});\n  }\n  // Main deck and hand-forged platform assemblies.\n  const platformMeshes=[];\n  const platforms=[{x:0,y:0,w:25},{x:-7.5,y:4,w:9},{x:7.5,y:4,w:9},{x:0,y:8,w:15},{x:-8,y:12,w:8},{x:8,y:12,w:8}];\n  for(let i=0;i<platforms.length;i++){\n    const p=platforms[i],g=new THREE.Group();g.position.set(p.x,p.y,0);stage.add(g);platformMeshes.push({group:g,...p});\n    box(p.w,.52,1.6,i%2?0x37938e:0xbf7250,g,0,-.31,-.02);\n    box(p.w+.08,.14,1.68,0xf2d493,g,0,-.065,0);\n    box(p.w,.12,.12,0xffe8b5,g,0,-.07,.84,false);\n    box(p.w-.1,.1,.1,0x173341,g,0,-.51,.82,false);\n    for(let x=-p.w/2+.55;x<p.w/2;x+=1.3){\n      ball(.075,palette.cream,g,x,-.31,.83,1,1,.5);\n      if(i>0){const br=box(.085,.48,.45,0x16333f,g,x,-.72,-.15);br.rotation.z=(x>0?1:-1)*.55;}\n    }\n    for(const x of [-p.w/2+.22,p.w/2-.22]){\n      box(.42,.64,1.75,0x203845,g,x,-.33,0);\n      box(.22,.13,1.8,palette.cream,g,x,-.065,0);\n    }\n  }\n  // Wet floor glints and drain slots make the stage feel lived in.\n  for(let i=0;i<12;i++){\n    const x=-11+i*2;\n    box(.8,.045,.02,0x3e6b77,stage,x,-.9,.85,false);\n    for(let j=0;j<3;j++)box(.06,.25,.02,0x071821,stage,x-.2+j*.2,-.28,.86,false);\n  }\n  for(const [x,y] of [[-10.2,6.5],[9.7,9.7],[2.5,3.3],[-3.7,15.9]]){\n    line([[x,y,-2.45],[x+.12,y-.5,-2.45],[x+.05,y-1.2,-2.45]],.04,0x417067,stage);\n    ball(.1,0x6f9d7f,stage,x+.05,y-1.25,-2.4,.5,1.6,.5,false);\n  }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,75p' hub/session.js; sed -n '1,120p' hub/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,75p' hub/session.js; sed -n '1,120p' hub/README.md\"","aggregated_output":"/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n    var api = {\n      getItem: function (k) {\n        k = String(k);\n        return k in data ? data[k] : null;\n      },\n      setItem: function (k, v) {\n        data[String(k)] = String(v);\n      },\n      removeItem: function (k) {\n        delete data[String(k)];\n      },\n      clear: function () {\n        for (var k in data) delete data[k];\n      },\n      key: function (i) {\n        var keys = Object.keys(data);\n        return i >= 0 && i < keys.length ? keys[i] : null;\n      },\n    };\n    if (typeof Proxy !== 'function') return api;\n    return new Proxy(api, {\n      get: function (t, k) {\n        if (k === 'length') return Object.keys(data).length;\n        if (typeof k === 'symbol' || k in t) return t[k];\n        return k in data ? data[k] : undefined;\n      },\n      set: function (t, k, v) {\n        if (typeof k !== 'symbol') data[k] = String(v);\n        return true;\n      },\n      has: function (t, k) {\n# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card, longer if one asks for more time: what\n   the game is, how to win, the controls. The card is the hub's, from the\n   game's tags, or the game's own (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n","exit_code":0,"status":"completed"}}
