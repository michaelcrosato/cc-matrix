orEach(remove => remove()); this.listeners = []; }\n}\n169:    this.musicVolume = 0.1;\n183:  async unlock() {\n203:      this.music.gain.value = this.musicActive ? this.musicVolume : 0;\n211:  update(_dt = 0, mode = this.mode) {\n219:        this.music.gain.setTargetAtTime(active ? this.musicVolume : 0, t, 0.035);\n253:    this.musicVolume = clamp(value, 0, 1);\n254:    if (this.ctx) this.music.gain.setTargetAtTime(this.musicActive ? this.musicVolume : 0, this.ctx.currentTime, 0.03);\n271:    return { state: this.ctx?.state || 'locked', musicVolume: this.musicVolume, sfxVolume: this.sfxVolume,\n280:    music.gain.value = this.musicVolume; sfx.gain.value = this.sfxVolume; master.gain.value = 0.72;\n297:      peak, invalidSamples: invalid, nonzeroSamples: nonzero, musicVolume: this.musicVolume };\n    if (!AC) return false;\n    if (!this.ctx) {\n      this.ctx = new AC({ latencyHint: 'interactive' });\n      this.master = this.ctx.createGain();\n      this.music = this.ctx.createGain();\n      this.sfx = this.ctx.createGain();\n      this.compressor = this.ctx.createDynamicsCompressor();\n      this.compressor.threshold.value = -14;\n      this.compressor.knee.value = 14;\n      this.compressor.ratio.value = 4;\n      this.compressor.attack.value = 0.003;\n      this.compressor.release.value = 0.15;\n      this.analyser = this.ctx.createAnalyser();\n      this.analyser.fftSize = 1024;\n      this.meterData = new Float32Array(this.analyser.fftSize);\n      this.music.connect(this.master); this.sfx.connect(this.master);\n      this.master.connect(this.compressor).connect(this.analyser).connect(this.ctx.destination);\n      this.master.gain.value = this.muted ? 0 : 0.72;\n      this.music.gain.value = this.musicActive ? this.musicVolume : 0;\n      this.sfx.gain.value = this.sfxVolume;\n      this.nextNote = this.ctx.currentTime + 0.035;\n    }\n    if (this.ctx.state === 'suspended') await this.ctx.resume();\n    return this.ctx.state === 'running';\n  }\n\n  update(_dt = 0, mode = this.mode) {\n    this.mode = mode;\n    const active = !['title', 'menu', 'pause', 'paused', 'settings', 'about', 'credits', 'gameover', 'win', 'victory'].includes(mode);\n    if (active !== this.musicActive) {\n      this.musicActive = active;\n      if (this.ctx) {\n        const t = this.ctx.currentTime;\n        this.music.gain.cancelScheduledValues(t);\n        this.music.gain.setTargetAtTime(active ? this.musicVolume : 0, t, 0.035);\n        if (active) this.nextNote = t + 0.025;\n        else {\n          for (const source of this.activeMusic) { try { source.stop(t + 0.07); } catch {} }\n        }\n      }\n    }\n    if (!this.ctx || this.ctx.state !== 'running' || !active || this.muted) return;\n    const t = this.ctx.currentTime;\n    if (this.nextNote < t - 0.1) this.nextNote = t + 0.015;\n    let safety = 0;\n    while (this.nextNote < t + 0.14 && safety++ < 8) {\n      musicStep(this.ctx, this.music, this.step, this.nextNote, this.activeMusic);\n      // A 57:43 swing gives the boiler room a little shuffle.\n      this.nextNote += EIGHTH * (this.step % 2 === 0 ? 1.14 : 0.86);\n      this.step++; this.noteCount++;\n    }\n  }\n\n  play(name) {\n    this.events[name] = (this.events[name] || 0) + 1;\n    if (!this.ctx || this.ctx.state !== 'running' || this.muted) return;\n    effect(this.ctx, this.sfx, name, this.ctx.currentTime + 0.005, this.activeEffects);\n  }\n\n  speak(mood = 'hello') {\n    if (!this.ctx || this.ctx.state !== 'running' || this.muted) return;\n    if (this.ctx.currentTime - this.lastVoice < 0.7) return;\n    this.lastVoice = this.ctx.currentTime;\n    this.events.voice = (this.events.voice || 0) + 1;\n    syllables(this.ctx, this.sfx, this.ctx.currentTime + 0.015, mood, this.activeEffects);\n  }\n\n  setMusicVolume(value) {\n    this.musicVolume = clamp(value, 0, 1);\n    if (this.ctx) this.music.gain.setTargetAtTime(this.musicActive ? this.musicVolume : 0, this.ctx.currentTime, 0.03);\n  }\n  setSfxVolume(value) {\n    this.sfxVolume = clamp(value, 0, 1);\n    if (this.ctx) this.sfx.gain.setTargetAtTime(this.sfxVolume, this.ctx.currentTime, 0.03);\n  }\n  setMuted(value) {\n","exit_code":0,"status":"completed"}}
