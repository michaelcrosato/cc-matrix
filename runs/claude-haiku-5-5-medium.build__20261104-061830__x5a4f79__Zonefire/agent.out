ms.push({ label: 'CONTROLS', on: () => game.menu('controls') });\n  items.push({ label: 'HOW TO PLAY', on: () => { S.pauseOpen = false; S.howBack = S.court; game.go('howto', { from: 'pause' }, { fade: .2 }); } });\n  items.push({ label: 'RESTART GAME', on: () => { S.pauseOpen = false; game.go('court', { court: S.court, humans: S.lastHumans, qLen: S.match ? S.match.qLen : 120, mode: S.match ? S.match.mode : 'exhibition' }, { fade: .2 }); } });\n  if (!HUB) items.push({ label: 'DEV MODE', on: () => { S.pauseOpen = false; devOpen(); } });\n  items.push({ label: 'QUIT TO TITLE', on: () => { S.pauseOpen = false; game.go('title', null, { fade: .2 }); } });\n  return items;\n};\nconst pauseStep = dt => {\n  if (!S.pauseList) S.pauseList = new FocusList([], { x: 0, y: 0, gap: 40, w: 340, onBack: () => { S.pauseOpen = false; } });\n  S.pauseList.setItems(pauseItemsZ());\n  if (game.players.some(I => I && I.pressed('pause') || I && I.pressed('cancel'))) { S.pauseOpen = false; return; }\n  S.pauseList.nav(dt);\n};\nconst pauseDraw = r => {\n  const L = S.pauseList; if (!L) return;\n  r.overlay(g => {\n    px.rect(g, 0, 0, r.W, r.H, '#05040acc');\n    panel(g, r.W * .32, r.H * .2, r.W * .36, r.H * .6, { border: C.accent, alpha: .97 });\n    E.font.title(g, 'PAUSED', r.W / 2, r.H * .24, { align: 'center', scale: 3, colors: ['#fffbe8', '#ffe08a'], depth: 2 });\n  });\n  const boxes = L.draw(r, { x: r.W * .36, y: r.H * .34, gap: Math.max(34, r.H * .07), w: r.W * .28, scale: 2 });\n  L.pointer(r, boxes);\n  promptBar(r, [['{confirm}', 'SELECT'], ['{cancel}', 'RESUME']]);\n};\n/** the pause items for a match:\"\"\")])\nprint('ok')\nEOF\nnode tools/build.mjs | tail -1 && node tests/run.mjs --quick | tail -1","description":"Build our own pause menu in the UI kit that freezes the match while open"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":2064,"cache_read_input_token