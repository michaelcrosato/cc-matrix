{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cghxkcrd8SGwKqVjzNPop","type":"message","role":"assistant","content":[{"type":"text","text":"The turbo step is clean and the quick tests pass. Next are the actions: the shot model from plan §6.7 with the decided outcome and perfect-release timing, passes that arrive at chest height, catches and loose-ball pickups."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1422,"cache_read_input_tokens":249122,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1422},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0432b045-5008-4207-9914-efcb595d2dad","uuid":"cd74a70d-ba52-4045-bbda-591c053d3036","timestamp":"2026-11-04T13:25:16.387Z","request_id":"req_011CghxkcYWLeq89y9svGBDM"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cghxkcrd8SGwKqVjzNPop","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Uq4DmMWViQ8TrQhFapAAQ2","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830/src/33-actions.js","content":"/* ---- ACTIONS (plan §6.7, §6.9, §6.11): the shot model (decided at release, flown after), passes that arrive at a\n * teammate's chest, catches, pickups of loose balls and the inbound. Every chance is one formula: no hidden rolls. ---- */\nconst ATTACK = [1, 0];                       // side 0 (HOME) attacks rim 1 (the right end); side 1 attacks rim 0\nconst attackRim = side => ATTACK[side];\nconst defendRim = side => 1 - ATTACK[side];\nconst ballReach = { h: 10, z: 59 };          // a catch: horizontal reach, and the height of standing hands (plan §6.11)\n\n/** the distance from a point to a rim, in the same flat plane (world units) */\nconst rimDist = (x, y, rim) => Math.hypot(x - RIMW[rim].x, y - RIMW[rim].y);\n/** the base chance by distance (§6.7): dist in court units */\nconst baseChance = d => {\n  if (d <= 40) return .85;\n  if (d <= 80) return lerp(.85, .70, (d - 40) / 40);\n  if (d <= 136) return lerp(.70, .45, (d - 80) / 56);\n  if (d <= 200) return lerp(.38, .30, (d - 136) / 64);\n  if (d <= 320) return lerp(.30, .08, (d - 200) / 120);\n  return .03;\n};\n/** the nearest defender between the shooter and the rim, for the contest (§6.7) */\nconst contestOf = (p, rim) => {\n  let best = null, bd = 1e9;\n  for (const q of S.players) {\n    if (q.side === p.side || !q.onCourt) continue;\n    const d = Math.hypot(q.body.x - p.body.x, q.body.y - p.body.y);\n    if (d < bd) { bd = d; best = q; }\n  }\n  if (!best) return { mult: 1, who: null };\n  const between = (best.body.x - p.body.x) * (RIMW[rim].x - p.body.x) > 0;\n  const airborne = best.body.z > 8 || best.state === 'block';\n  if (between && bd < 30 && airborne) return { mult: 1 - tune('contestPenalty'), who: best };\n  if (bd < 30) return { mult: .8, who: best };\n  if (bd < 50) return { mult: .92, who: best };\n  return { mult: 1, who: best };\n};\n\n/** the decided chance of a jump shot (§6.7): every factor is a formula, and the result is clamped to [0.02, 0.97] */\nconst shotChance = (p, rim, release, o = {}) => {\n  const d = rimDist(p.body.x, p.body.y, rim), three = d > 136;\n  const factor = three ? .70 + .06 * rate(p, 'deep') : .78 + .045 * rate(p, 'splash');\n  let rel = 1;\n  const window = tune('perfectWindow') * (p.laser > 0 ? 2 : 1);\n  if (Math.abs(release) <= window / 2) rel = 1 + tune('perfectBonus');\n  else if (Math.abs(release) <= window) rel = 1;\n  else rel = 1 - tune('badReleasePenalty');\n  const c = contestOf(p, rim);\n  const wind = (S.twist.wind || 0), sideways = Math.abs(p.body.vy) > 150 && Math.abs(p.body.vy) > Math.abs(p.body.vx) ? .9 : 1;\n  const windM = 1 - .35 * Math.abs(wind) * d / 320;\n  let bonus = 0;\n  if (p.nova) bonus += tune('novaShotBonus');\n  if (p.laser > 0) bonus += .30;\n  if (o.comeback) bonus += o.comeback;\n  const k = (three ? tune('threeSkill') : tune('shotSkill')) * juiceFactor(p);\n  let v = baseChance(d) * factor * rel * c.mult * k * (p.turboOn ? 1.05 : 1) * sideways * windM + bonus;\n  if (o.extra) v += o.extra;\n  return { p: clamp(v, .02, .97), three, d, contest: c.who };\n};\n\n/** the points of a shot (§6.6 Scoring): 2 inside the arc, 3 beyond it, decided by where the shooter left the floor */\nconst shotPoints = (p, rim) => rimDist(p.body.x, p.body.y, rim) > 136 ? 3 : 2;\n\n/** a shot: decided at release, flown after (§6.7). from: the shooter; release: seconds from the top of its jump (negative\n * early); the aim (made or missed) and the target spot follow the decision */\nconst releaseShot = (p, release, kind = 'jump') => {\n  const rim = attackRim(p.side), comeback = comebackOf(p.side);\n  const dec = shotChance(p, rim, release, { comeback });\n  const made = S.rng() < dec.p;\n  const from = { x: p.body.x + Math.cos(p.face) * 6, y: p.body.y + Math.sin(p.face) * 6, z: p.body.z + 46 };\n  const R = RIMW[rim];\n  let target;\n  if (made) {\n    const rattle = S.rng() < .25;\n    target = { x: R.x + (rattle ? (S.rng() - .5) * 6 : (S.rng() - .5) * 1.5), y: R.y + (rattle ? (S.rng() - .5) * 6 : (S.rng() - .5) * 1.5), z: R.z - 2 };\n  } else {\n    const off = (S.rng() < .5 ? -1 : 1) * (10.5 + S.rng() * 2.5), ang = S.rng();\n    if (ang < .15 && dec.d > 136) target = { x: R.x + (rim ? -1 : 1) * 40, y: R.y + off, z: R.z + 8 };   // an airball, far off\n    else if (ang < .35) target = { x: R.x + (rim ? -1 : 1) * 8 + 0, y: R.y + off * .5, z: 84 };          // the glass\n    else target = { x: R.x + (rim ? 1 : -1) * (10.5 + S.rng() * 2.5) * .9, y: R.y + off, z: R.z + 2 };   // the front rim\n  }\n  const apex = Math.max(from.z, R.z) + clamp(18 + dec.d * .10, 18, 60) * tune('shotArc');\n  const v = ballFlight(from, target, apex);\n  const rec = { shooter: p.slot, made, p: dec.p, points: shotPoints(p, rim), three: dec.three, perfect: Math.abs(release) <= tune('perfectWindow') / 2, release, kind, dist: dec.d, contest: dec.contest ? dec.contest.slot : null, rim, t: S.match.clock };\n  p.shot = { rec };\n  ballRelease(S.ball, from, v, 'shot', rec);\n  S.ball.owner = null; p.hasBall = false;\n  S.match.shotsInFlight = (S.match.shotsInFlight || 0) + 1;\n  p.stats.fga++; if (rec.three) p.stats.tpa++;\n  emit('shotStart', { slot: p.slot, shooter: p.id, p: dec.p, three: rec.three, perfect: rec.perfect, dist: dec.d, side: p.side, kind });\n  emit('release', { slot: p.slot, shooter: p.id, perfect: rec.perfect, three: rec.three, release });\n  return rec;\n};\n\n/** the comeback assist (§8): a team trailing by 4 or more from Q2 on gets a chance bonus; Tournament mode turns it off */\nconst comebackOf = side => {\n  const m = S.match, lvl = setting('comeback'), k = { Off: 0, Low: .2, Normal: .35 }[lvl] ?? tune('comeback');\n  if (!m || k <= 0 || m.quarter < 2 || S.cheats.tournament) return 0;\n  const d = m.score[1 - side] - m.score[side];\n  return d >= 4 ? k * Math.min(d, 15) / 15 * .12 : 0;\n};\n\n/** a pass to a teammate (§6.9): the ball flies at the receiver's chest, led by its velocity; speed by DIME */\nconst passBall = (p, to) => {\n  const b = S.ball, m = to || teammateOf(p);\n  if (!m) return null;\n  const from = { x: p.body.x + Math.cos(p.face) * 8, y: p.body.y + Math.sin(p.face) * 8, z: p.body.z + 30 };\n  const sp = (180 + 12 * rate(p, 'dime')) * 1.6;\n  const d = Math.hypot(m.body.x - from.x, m.body.y - from.y);\n  const t = Math.max(.1, d / sp), lead = Math.min(t, .8);\n  const tx = m.body.x + m.body.vx * lead * .6, ty = m.body.y + m.body.vy * lead * .6, tz = m.body.z + 30;\n  const v = { vx: (tx - from.x) / t, vy: (ty - from.y) / t, vz: (tz - from.z + .5 * tune('ballGravity') * t * t) / t };\n  ballRelease(b, from, v, 'pass', null);\n  b.to = m.slot; b.from = p.slot; b.passT = S.match.clock;\n  p.cool.pass = .2; p.stats.ast += 0;\n  p.hasBall = false; b.owner = null;\n  emit('pass', { slot: p.slot, to: m.slot, side: p.side, dist: d });\n  return m;\n};\n/** the teammate a pass goes to: the one ahead or open (never the player itself) */\nconst teammateOf = p => S.players.find(q => q.side === p.side && q !== p && q.onCourt) || null;\n\n/** a player takes the ball: it is in his hands from now (held), and the other team's stealing ends */\nconst takeBall = (p, how = 'catch') => {\n  const b = S.ball;\n  if (b.owner === p) return;\n  if (b.owner) { b.owner.hasBall = false; }\n  b.owner = p; p.hasBall = true; b.state = b.state === 'inbound' ? 'inbound' : 'held';\n  b.shot = null; b.scored = [false, false]; b.roll = 0;\n  b.lastTouch = p.slot;\n  if (S.match.shotsInFlight) S.match.shotsInFlight = 0;\n  if (how === 'catch' || how === 'rebound') { if (S.match.possessionAt !== p.side) newPossession(p.side); }\n  emit(how === 'rebound' ? 'rebound' : 'catch', { slot: p.slot, side: p.side, how });\n  if (how === 'rebound') p.stats.reb++;\n  return p;\n};\n\n/** the ball goes loose: nobody holds it; the next player to reach it takes it */\nconst releaseLoose = (b, spd = 0) => { if (b.owner) { b.owner.hasBall = false; b.owner = null; } b.state = b.state === 'held' || b.state === 'dribble' ? 'loose' : b.state; b.lastTouch = null; };\n\n/** pick up loose balls and balls in flight the player reaches (a catch: §6.11, a pass's receiver, a rebound in the air) */\nconst reachBall = p => {\n  const b = S.ball;\n  if (!p.onCourt || b.owner || p.cool.steal > 0 && false) return false;\n  if (b.state === 'dead' || b.state === 'inbound') return false;\n  const d = Math.hypot(b.x - p.body.x, b.y - p.body.y);\n  const air = b.z >= p.body.z - 4 && b.z <= p.body.z + 59 + 14;\n  if (d < 11 && air && (b.state === 'loose' || b.state === 'pass' && b.to === p.slot || b.state === 'shot')) {\n    if (b.state === 'shot' && !(p.body.z > 6 && b.vz < 0)) return false;\n    if (b.state === 'pass' && b.to !== p.slot) return false;\n    const how = b.state === 'shot' ? 'rebound' : b.state === 'pass' ? 'catch' : 'loose';\n    if (b.state === 'shot') { shotOver(b, p); }\n    takeBall(p, how === 'loose' ? 'catch' : how);\n    if (b.state === 'pass') b.to = null;\n    return true;\n  }\n  return false;\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1422,"cache_read_input_tokens":249122,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1422},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0432b045-5008-4207-9914-efcb595d2dad","uuid":"d116290c-5b04-4211-a4a9-2ee247aceb9e","timestamp":"2026-11-04T13:25:33.003Z","request_id":"req_011CghxkcYWLeq89y9svGBDM","wire_tool_inputs":{"toolu_01Uq4DmMWViQ8TrQhFapAAQ2":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830/src/33-actions.js","content":"/* ---- ACTIONS (plan §6.7, §6.9, §6.11): the shot model (decided at release, flown after), passes that arrive at a\n * teammate's chest, catches, pickups of loose balls and the inbound. Every chance is one formula: no hidden rolls. ---- */\nconst ATTACK = [1, 0];                       // side 0 (HOME) attacks rim 1 (the right end); side 1 attacks rim 0\nconst attackRim = side => ATTACK[side];\nconst defendRim = side => 1 - ATTACK[side];\nconst ballReach = { h: 10, z: 59 };          // a catch: horizontal reach, and the height of standing hands (plan §6.11)\n\n/** the distance from a point to a rim, in the same flat plane (world units) */\nconst rimDist = (x, y, rim) => Math.hypot(x - RIMW[rim].x, y - RIMW[rim].y);\n/** the base chance by distance (§6.7): dist in court units */\nconst baseChance = d => {\n  if (d <= 40) return .85;\n  if (d <= 80) return lerp(.85, .70, (d - 40) / 40);\n  if (d <= 136) return lerp(.70, .45, (d - 80) / 56);\n  if (d <= 200) return lerp(.38, .30, (d - 136) / 64);\n  if (d <= 320) return lerp(.30, .08, (d - 200) / 120);\n  return .03;\n};\n/** the nearest defender between the shooter and the rim, for the contest (§6.7) */\nconst contestOf = (p, rim) => {\n  let best = null, bd = 1e9;\n  for (const q of S.players) {\n    if (q.side === p.side || !q.onCourt) continue;\n    const d = Math.hypot(q.body.x - p.body.x, q.body.y - p.body.y);\n    if (d < bd) { bd = d; best = q; }\n  }\n  if (!best) return { mult: 1, who: null };\n  const between = (best.body.x - p.body.x) * (RIMW[rim].x - p.body.x) > 0;\n  const airborne = best.body.z > 8 || best.state === 'block';\n  if (between && bd < 30 && airborne) return { mult: 1 - tune('contestPenalty'), who: best };\n  if (bd < 30) return { mult: .8, who: best };\n  if (bd < 50) return { mult: .92, who: best };\n  return { mult: 1, who: best };\n};\n\n/** the decided chance of a jump shot (§6.7): every factor is a formula, and the result is clamped to [0.02, 0.97] */\nconst shotChance = (p, rim, release, o = {}) => {\n  const d = rimDist(p.body.x, p.body.y, rim), three = d > 136;\n  const factor = three ? .70 + .06 * rate(p, 'deep') : .78 + .045 * rate(p, 'splash');\n  let rel = 1;\n  const window = tune('perfectWindow') * (p.laser > 0 ? 2 : 1);\n  if (Math.abs(release) <= window / 2) rel = 1 + tune('perfectBonus');\n  else if (Math.abs(release) <= window) rel = 1;\n  else rel = 1 - tune('badReleasePenalty');\n  const c = contestOf(p, rim);\n  const wind = (S.twist.wind || 0), sideways = Math.abs(p.body.vy) > 150 && Math.abs(p.body.vy) > Math.abs(p.body.vx) ? .9 : 1;\n  const windM = 1 - .35 * Math.abs(wind) * d / 320;\n  let bonus = 0;\n  if (p.nova) bonus += tune('novaShotBonus');\n  if (p.laser > 0) bonus += .30;\n  if (o.comeback) bonus += o.comeback;\n  const k = (three ? tune('threeSkill') : tune('shotSkill')) * juiceFactor(p);\n  let v = baseChance(d) * factor * rel * c.mult * k * (p.turboOn ? 1.05 : 1) * sideways * windM + bonus;\n  if (o.extra) v += o.extra;\n  return { p: clamp(v, .02, .97), three, d, contest: c.who };\n};\n\n/** the points of a shot (§6.6 Scoring): 2 inside the arc, 3 beyond it, decided by where the shooter left the floor */\nconst shotPoints = (p, rim) => rimDist(p.body.x, p.body.y, rim) > 136 ? 3 : 2;\n\n/** a shot: decided at release, flown after (§6.7). from: the shooter; release: seconds from the top of its jump (negative\n * early); the aim (made or missed) and the target spot follow the decision */\nconst releaseShot = (p, release, kind = 'jump') => {\n  const rim = attackRim(p.side), comeback = comebackOf(p.side);\n  const dec = shotChance(p, rim, release, { comeback });\n  const made = S.rng() < dec.p;\n  const from = { x: p.body.x + Math.cos(p.face) * 6, y: p.body.y + Math.sin(p.face) * 6, z: p.body.z + 46 };\n  const R = RIMW[rim];\n  let target;\n  if (made) {\n    const rattle = S.rng() < .25;\n    target = { x: R.x + (rattle ? (S.rng() - .5) * 6 : (S.rng() - .5) * 1.5), y: R.y + (rattle ? (S.rng() - .5) * 6 : (S.rng() - .5) * 1.5), z: R.z - 2 };\n  } else {\n    const off = (S.rng() < .5 ? -1 : 1) * (10.5 + S.rng() * 2.5), ang = S.rng();\n    if (ang < .15 && dec.d > 136) target = { x: R.x + (rim ? -1 : 1) * 40, y: R.y + off, z: R.z + 8 };   // an airball, far off\n    else if (ang < .35) target = { x: R.x + (rim ? -1 : 1) * 8 + 0, y: R.y + off * .5, z: 84 };          // the glass\n    else target = { x: R.x + (rim ? 1 : -1) * (10.5 + S.rng() * 2.5) * .9, y: R.y + off, z: R.z + 2 };   // the front rim\n  }\n  const apex = Math.max(from.z, R.z) + clamp(18 + dec.d * .10, 18, 60) * tune('shotArc');\n  const v = ballFlight(from, target, apex);\n  const rec = { shooter: p.slot, made, p: dec.p, points: shotPoints(p, rim), three: dec.three, perfect: Math.abs(release) <= tune('perfectWindow') / 2, release, kind, dist: dec.d, contest: dec.contest ? dec.contest.slot : null, rim, t: S.match.clock };\n  p.shot = { rec };\n  ballRelease(S.ball, from, v, 'shot', rec);\n  S.ball.owner = null; p.hasBall = false;\n  S.match.shotsInFlight = (S.match.shotsInFlight || 0) + 1;\n  p.stats.fga++; if (rec.three) p.stats.tpa++;\n  emit('shotStart', { slot: p.slot, shooter: p.id, p: dec.p, three: rec.three, perfect: rec.perfect, dist: dec.d, side: p.side, kind });\n  emit('release', { slot: p.slot, shooter: p.id, perfect: rec.perfect, three: rec.three, release });\n  return rec;\n};\n\n/** the comeback assist (§8): a team trailing by 4 or more from Q2 on gets a chance bonus; Tournament mode turns it off */\nconst comebackOf = side => {\n  const m = S.match, lvl = setting('comeback'), k = { Off: 0, Low: .2, Normal: .35 }[lvl] ?? tune('comeback');\n  if (!m || k <= 0 || m.quarter < 2 || S.cheats.tournament) return 0;\n  const d = m.score[1 - side] - m.score[side];\n  return d >= 4 ? k * Math.min(d, 15) / 15 * .12 : 0;\n};\n\n/** a pass to a teammate (§6.9): the ball flies at the receiver's chest, led by its velocity; speed by DIME */\nconst passBall = (p, to) => {\n  const b = S.ball, m = to || teammateOf(p);\n  if (!m) return null;\n  const from = { x: p.body.x + Math.cos(p.face) * 8, y: p.body.y + Math.sin(p.face) * 8, z: p.body.z + 30 };\n  const sp = (180 + 12 * rate(p, 'dime')) * 1.6;\n  const d = Math.hypot(m.body.x - from.x, m.body.y - from.y);\n  const t = Math.max(.1, d / sp), lead = Math.min(t, .8);\n  const tx = m.body.x + m.body.vx * lead * .6, ty = m.body.y + m.body.vy * lead * .6, tz = m.body.z + 30;\n  const v = { vx: (tx - from.x) / t, vy: (ty - from.y) / t, vz: (tz - from.z + .5 * tune('ballGravity') * t * t) / t };\n  ballRelease(b, from, v, 'pass', null);\n  b.to = m.slot; b.from = p.slot; b.passT = S.match.clock;\n  p.cool.pass = .2; p.stats.ast += 0;\n  p.hasBall = false; b.owner = null;\n  emit('pass', { slot: p.slot, to: m.slot, side: p.side, dist: d });\n  return m;\n};\n/** the teammate a pass goes to: the one ahead or open (never the player itself) */\nconst teammateOf = p => S.players.find(q => q.side === p.side && q !== p && q.onCourt) || null;\n\n/** a player takes the ball: it is in his hands from now (held), and the other team's stealing ends */\nconst takeBall = (p, how = 'catch') => {\n  const b = S.ball;\n  if (b.owner === p) return;\n  if (b.owner) { b.owner.hasBall = false; }\n  b.owner = p; p.hasBall = true; b.state = b.state === 'inbound' ? 'inbound' : 'held';\n  b.shot = null; b.scored = [false, false]; b.roll = 0;\n  b.lastTouch = p.slot;\n  if (S.match.shotsInFlight) S.match.shotsInFlight = 0;\n  if (how === 'catch' || how === 'rebound') { if (S.match.possessionAt !== p.side) newPossession(p.side); }\n  emit(how === 'rebound' ? 'rebound' : 'catch', { slot: p.slot, side: p.side, how });\n  if (how === 'rebound') p.stats.reb++;\n  return p;\n};\n\n/** the ball goes loose: nobody holds it; the next player to reach it takes it */\nconst releaseLoose = (b, spd = 0) => { if (b.owner) { b.owner.hasBall = false; b.owner = null; } b.state = b.state === 'held' || b.state === 'dribble' ? 'loose' : b.state; b.lastTouch = null; };\n\n/** pick up loose balls and balls in flight the player reaches (a catch: §6.11, a pass's receiver, a rebound in the air) */\nconst reachBall = p => {\n  const b = S.ball;\n  if (!p.onCourt || b.owner || p.cool.steal > 0 && false) return false;\n  if (b.state === 'dead' || b.state === 'inbound') return false;\n  const d = Math.hypot(b.x - p.body.x, b.y - p.body.y);\n  const air = b.z >= p.body.z - 4 && b.z <= p.body.z + 59 + 14;\n  if (d < 11 && air && (b.state === 'loose' || b.state === 'pass' && b.to === p.slot || b.state === 'shot')) {\n    if (b.state === 'shot' && !(p.body.z > 6 && b.vz < 0)) return false;\n    if (b.state === 'pass' && b.to !== p.slot) return false;\n    const how = b.state === 'shot' ? 'rebound' : b.state === 'pass' ? 'catch' : 'loose';\n    if (b.state === 'shot') { shotOver(b, p); }\n    takeBall(p, how === 'loose' ? 'catch' : how);\n    if (b.state === 'pass') b.to = null;\n    return true;\n  }\n  return false;\n};\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uq4DmMWViQ8TrQhFapAAQ2","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830/src/33-actions.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"0432b045-5008-4207-9914-efcb595d2dad","uuid":"92ae7fc7-e19f-4b57-a3a9-553ffc77291f","timestamp":"2026-11-04T13:25:33.020Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830/src/33-actions.js","content":"/* ---- ACTIONS (plan §6.7, §6.9, §6.11): the shot model (decided at release, flown after), passes that arrive at a\n * teammate's chest, catches, pickups of loose balls and the inbound. Every chance is one formula: no hidden rolls. ---- */\nconst ATTACK = [1, 0];                       // side 0 (HOME) attacks rim 1 (the right end); side 1 attacks rim 0\nconst attackRim = side => ATTACK[side];\nconst defendRim = side => 1 - ATTACK[side];\nconst ballReach = { h: 10, z: 59 };          // a catch: horizontal reach, and the height of standing hands (plan §6.11)\n\n/** the distance from a point to a rim, in the same flat plane (world units) */\nconst rimDist = (x, y, rim) => Math.hypot(x - RIMW[rim].x, y - RIMW[rim].y);\n/** the base chance by distance (§6.7): dist in court units */\nconst baseChance = d => {\n  if (d <= 40) return .85;\n  if (d <= 80) return lerp(.85, .70, (d - 40) / 40);\n  if (d <= 136) return lerp(.70, .45, (d - 80) / 56);\n  if (d <= 200) return lerp(.38, .30, (d - 136) / 64);\n  if (d <= 320) return lerp(.30, .08, (d - 200) / 120);\n  return .03;\n};\n/** the nearest defender between the shooter and the rim, for the contest (§6.7) */\nconst contestOf = (p, rim) => {\n  let best = null, bd = 1e9;\n  for (const q of S.players) {\n    if (q.side === p.side || !q.onCourt) continue;\n    const d = Math.hypot(q.body.x - p.body.x, q.body.y - p.body.y);\n    if (d < bd) { bd = d; best = q; }\n  }\n  if (!best) return { mult: 1, who: null };\n  const between = (best.body.x - p.body.x) * (RIMW[rim].x - p.body.x) > 0;\n  const airborne = best.body.z > 8 || best.state === 'block';\n  if (between && bd < 30 && airborne) return { mult: 1 - tune('contestPenalty'), who: best };\n  if (bd < 30) return { mult: .8, who: best };\n  if (bd < 50) return { mult: .92, who: best };\n  return { mult: 1, who: best };\n};\n\n/** the decided chance of a jump shot (§6.7): every factor is a formula, and the result is clamped to [0.02, 0.97] */\nconst shotChance = (p, rim, release, o = {}) => {\n  const d = rimDist(p.body.x, p.body.y, rim), three = d > 136;\n  const factor = three ? .70 + .06 * rate(p, 'deep') : .78 + .045 * rate(p, 'splash');\n  let rel = 1;\n  const window = tune('perfectWindow') * (p.laser > 0 ? 2 : 1);\n  if (Math.abs(release) <= window / 2) rel = 1 + tune('perfectBonus');\n  else if (Math.abs(release) <= window) rel = 1;\n  else rel = 1 - tune('badReleasePenalty');\n  const c = contestOf(p, rim);\n  const wind = (S.twist.wind || 0), sideways = Math.abs(p.body.vy) > 150 && Math.abs(p.body.vy) > Math.abs(p.body.vx) ? .9 : 1;\n  const windM = 1 - .35 * Math.abs(wind) * d / 320;\n  let bonus = 0;\n  if (p.nova) bonus += tune('novaShotBonus');\n  if (p.laser > 0) bonus += .30;\n  if (o.comeback) bonus += o.comeback;\n  const k = (three ? tune('threeSkill') : tune('shotSkill')) * juiceFactor(p);\n  let v = baseChance(d) * factor * rel * c.mult * k * (p.turboOn ? 1.05 : 1) * sideways * windM + bonus;\n  if (o.extra) v += o.extra;\n  return { p: clamp(v, .02, .97), three, d, contest: c.who };\n};\n\n/** the points of a shot (§6.6 Scoring): 2 inside the arc, 3 beyond it, decided by where the shooter left the floor */\nconst shotPoints = (p, rim) => rimDist(p.body.x, p.body.y, rim) > 136 ? 3 : 2;\n\n/** a shot: decided at release, flown after (§6.7). from: the shooter; release: seconds from the top of its jump (negative\n * early); the aim (made or missed) and the target spot follow the decision */\nconst releaseShot = (p, release, kind = 'jump') => {\n  const rim = attackRim(p.side), comeback = comebackOf(p.side);\n  const dec = shotChance(p, rim, release, { comeback });\n  const made = S.rng() < dec.p;\n  const from = { x: p.body.x + Math.cos(p.face) * 6, y: p.body.y + Math.sin(p.face) * 6, z: p.body.z + 46 };\n  const R = RIMW[rim];\n  let target;\n  if (made) {\n    const rattle = S.rng() < .25;\n    target = { x: R.x + (rattle ? (S.rng() - .5) * 6 : (S.rng() - .5) * 1.5), y: R.y + (rattle ? (S.rng() - .5) * 6 : (S.rng() - .5) * 1.5), z: R.z - 2 };\n  } else {\n    const off = (S.rng() < .5 ? -1 : 1) * (10.5 + S.rng() * 2.5), ang = S.rng();\n    if (ang < .15 && dec.d > 136) target = { x: R.x + (rim ? -1 : 1) * 40, y: R.y + off, z: R.z + 8 };   // an airball, far off\n    else if (ang < .35) target = { x: R.x + (rim ? -1 : 1) * 8 + 0, y: R.y + off * .5, z: 84 };          // the glass\n    else target = { x: R.x + (rim ? 1 : -1) * (10.5 + S.rng() * 2.5) * .9, y: R.y + off, z: R.z + 2 };   // the front rim\n  }\n  const apex = Math.max(from.z, R.z) + clamp(18 + dec.d * .10, 18, 60) * tune('shotArc');\n  const v = ballFlight(from, target, apex);\n  const rec = { shooter: p.slot, made, p: dec.p, points: shotPoints(p, rim), three: dec.three, perfect: Math.abs(release) <= tune('perfectWindow') / 2, release, kind, dist: dec.d, contest: dec.contest ? dec.contest.slot : null, rim, t: S.match.clock };\n  p.shot = { rec };\n  ballRelease(S.ball, from, v, 'shot', rec);\n  S.ball.owner = null; p.hasBall = false;\n  S.match.shotsInFlight = (S.match.shotsInFlight || 0) + 1;\n  p.stats.fga++; if (rec.three) p.stats.tpa++;\n  emit('shotStart', { slot: p.slot, shooter: p.id, p: dec.p, three: rec.three, perfect: rec.perfect, dist: dec.d, side: p.side, kind });\n  emit('release', { slot: p.slot, shooter: p.id, perfect: rec.perfect, three: rec.three, release });\n  return rec;\n};\n\n/** the comeback assist (§8): a team trailing by 4 or more from Q2 on gets a chance bonus; Tournament mode turns it off */\nconst comebackOf = side => {\n  const m = S.match, lvl = setting('comeback'), k = { Off: 0, Low: .2, Normal: .35 }[lvl] ?? tune('comeback');\n  if (!m || k <= 0 || m.quarter < 2 || S.cheats.tournament) return 0;\n  const d = m.score[1 - side] - m.score[side];\n  return d >= 4 ? k * Math.min(d, 15) / 15 * .12 : 0;\n};\n\n/** a pass to a teammate (§6.9): the ball flies at the receiver's chest, led by its velocity; speed by DIME */\nconst passBall = (p, to) => {\n  const b = S.ball, m = to || teammateOf(p);\n  if (!m) return null;\n  const from = { x: p.body.x + Math.cos(p.face) * 8, y: p.body.y + Math.sin(p.face) * 8, z: p.body.z + 30 };\n  const sp = (180 + 12 * rate(p, 'dime')) * 1.6;\n  const d = Math.hypot(m.body.x - from.x, m.body.y - from.y);\n  const t = Math.max(.1, d / sp), lead = Math.min(t, .8);\n  const tx = m.body.x + m.body.vx * lead * .6, ty = m.body.y + m.body.vy * lead * .6, tz = m.body.z + 30;\n  const v = { vx: (tx - from.x) / t, vy: (ty - from.y) / t, vz: (tz - from.z + .5 * tune('ballGravity') * t * t) / t };\n  ballRelease(b, from, v, 'pass', null);\n  b.to = m.slot; b.from = p.slot; b.passT = S.match.clock;\n  p.cool.pass = .2; p.stats.ast += 0;\n  p.hasBall = false; b.owner = null;\n  emit('pass', { slot: p.slot, to: m.slot, side: p.side, dist: d });\n  return m;\n};\n/** the teammate a pass goes to: the one ahead or open (never the player itself) */\nconst teammateOf = p => S.players.find(q => q.side === p.side && q !== p && q.onCourt) || null;\n\n/** a player takes the ball: it is in his hands from now (held), and the other team's stealing ends */\nconst takeBall = (p, how = 'catch') => {\n  const b = S.ball;\n  if (b.owner === p) return;\n  if (b.owner) { b.owner.hasBall = false; }\n  b.owner = p; p.hasBall = true; b.state = b.state === 'inbound' ? 'inbound' : 'held';\n  b.shot = null; b.scored = [false, false]; b.roll = 0;\n  b.lastTouch = p.slot;\n  if (S.match.shotsInFlight) S.match.shotsInFlight = 0;\n  if (how === 'catch' || how === 'rebound') { if (S.match.possessionAt !== p.side) newPossession(p.side); }\n  emit(how === 'rebound' ? 'rebound' : 'catch', { slot: p.slot, side: p.side, how });\n  if (how === 'rebound') p.stats.reb++;\n  return p;\n};\n\n/** the ball goes loose: nobody holds it; the next player to reach it takes it */\nconst releaseLoose = (b, spd = 0) => { if (b.owner) { b.owner.hasBall = false; b.owner = null; } b.state = b.state === 'held' || b.state === 'dribble' ? 'loose' : b.state; b.lastTouch = null; };\n\n/** pick up loose balls and balls in flight the player reaches (a catch: §6.11, a pass's receiver, a rebound in the air) */\nconst reachBall = p => {\n  const b = S.ball;\n  if (!p.onCourt || b.owner || p.cool.steal > 0 && false) return false;\n  if (b.state === 'dead' || b.state === 'inbound') return false;\n  const d = Math.hypot(b.x - p.body.x, b.y - p.body.y);\n  const air = b.z >= p.body.z - 4 && b.z <= p.body.z + 59 + 14;\n  if (d < 11 && air && (b.state === 'loose' || b.state === 'pass' && b.to === p.slot || b.state === 'shot')) {\n    if (b.state === 'shot' && !(p.body.z > 6 && b.vz < 0)) return false;\n    if (b.state === 'pass' && b.to !== p.slot) return false;\n    const how = b.state === 'shot' ? 'rebound' : b.state === 'pass' ? 'catch' : 'loose';\n    if (b.state === 'shot') { shotOver(b, p); }\n    takeBall(p, how === 'loose' ? 'catch' : how);\n    if (b.state === 'pass') b.to = null;\n    return true;\n  }\n  return false;\n};\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Uq4DmMWViQ8TrQhFapAAQ2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
