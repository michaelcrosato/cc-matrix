nconst scenes = {};\nconst pauseItems = () => [];\nscenes.title = {\n  view: BROADCAST, input: KEYS, res: 'ps1', expand: true,\n  update(dt) { if (game.input.anyPressed()) game.debug.note = 'press'; },\n  draw(r) { r.sky(['#05040a', '#1d1240', '#3a1a5a']); r.text('BASKETBLAM', r.W / 2, r.H / 2, '#ffffff', { align: 'center', scale: 3 }); }\n};\ngame.debug = { snapshot: () => ({ scene: game.sceneName, ready: true }) };\nwindow.__bb = { S, game, TUNING, emit, on, debug: game.debug };\ngame.start({ scenes, scene: 'title' });\n"}}}
