src/42-screens.js', [\n(\"    if (S.lineupDone[0]) { S.setup.lineup = [S.lineupSel[0], S.lineupSel[1]]; game.go('rules', null, { fade: .2 }); }\",\n \"    if (S.lineupDone[0]) { S.setup.lineup = [S.lineupSel[0], S.lineupSel[1]]; S.lineupSel && (S.setup.lineupPick = true); if (S.mode === 'tour') return tourAfterLineup(); game.go('rules', null, { fade: .2 }); }\"),\n(\"    const items = [{ label: 'REMATCH', on: () => { const d = S.results.rematch; if (d) game.go('court', d, { fade: .2 }); else game.go('rules', null); } }, { label: 'NEW TEAMS', on: () => game.go('teams', null, { fade: .2 }) }, { label: 'MAIN MENU', on: () => game.go('menu', null, { fade: .2 }) }];\",\n \"    if (S.mode === 'tour') {\\n      const won = (S.results.match.score[0] > S.results.match.score[1]), margin = Math.abs(S.results.match.score[0] - S.results.match.score[1]);\\n      S.resultsList.setItems([{ label: 'CONTINUE', on: () => { if (won) { tourResult(true, margin); tourNextAfterWin(); } else { tourResult(false, 0); game.go('loss', null, { fade: .2 }); } } }]);\\n      S.resultsList.nav(dt);\\n      return;\\n    }\\n    const items = [{ label: 'REMATCH', on: () => { const d = S.results.rematch; if (d) game.go('court', d, { fade: .2 }); else game.go('rules', null); } }, { label: 'NEW TEAMS', on: () => game.go('teams', null, { fade: .2 }) }, { label: 'MAIN MENU', on: () => game.go('menu', null, { fade: .2 }) }];\"),\n])\nprint('ok')\nEOF\nnode tools/build.mjs | tail -1","description":"Clean the tour file and wire the lineup and results into the tour flow"}},"wire_ingest_context":{"toolu_018vpCdVkB24qAn7TJudjgrj":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830"}}}
