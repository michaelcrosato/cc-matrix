 4 + (R() - .5) * 4, y: rim.y + edge * (R() < .5 ? 1 : 0), z: rim.z + 3, make: false };\"\"\"\nnew=\"\"\"    // (a point just outside the ring, on the court side and across it: the ball meets the front of the rim)\n    const along = (side ? -1 : 1) * (10.5 + R() * 2.5), across = (R() < .5 ? -1 : 1) * (R() * 6);\n    const target = { x: rim.x + along, y: rim.y + across, z: rim.z + 2, make: false };\"\"\"\nassert old in s\ns=s.replace(old,new); open(p,'w').write(s)\nEOF\nnode tests/run.mjs physics","description":"Fix miss targets in the physics test and rerun"}},"wire_ingest_context":{"toolu_01TXky3V2wZwhL8TiQcA641j":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830"}}}
