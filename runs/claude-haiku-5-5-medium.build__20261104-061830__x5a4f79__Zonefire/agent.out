{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cghze1LVsgxBkU9RDXedu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QxjAi4fUFCuEuNG7nzP2BE","name":"Bash","input":{"command":"cat > tests/tour.test.mjs <<'EOF'\n// The scripted playthrough of the whole Tour (plan §19.2 \"tour\"): a new tour with a bot human, through the prologue, the\n// stops and the final, every beat seen in order; a lost stop rematches; the ending, the credits and the initials.\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst press = (g, action, steps = 1) => { for (let i = 0; i < steps; i++) { g.game.input.tap(action); g.game.advance(.25); } };\nconst playToEnd = (g, maxSec) => { let t = 0; while (g.S.match && !g.S.match.over && t < maxSec) { g.game.advance(1); t++; } };\n\nT('tour.a new tour: the team, the lineup, the prologue, then the map; progress is saved', () => {\n  const g = loadGame({ seed: 41 });\n  g.game.advance(.3);\n  g.bb.goTourNew(); g.game.advance(.5);\n  expect(g.game.sceneName === 'teams', `teams: ${g.game.sceneName}`);\n  press(g, 'confirm', 2);   // lock HOME, then the lineup\n  press(g, 'confirm', 2);   // lineup locks: the prologue beat\n  expect(g.game.sceneName === 'beat', `the prologue plays: ${g.game.sceneName}`);\n  for (let i = 0; i < 400 && g.game.sceneName === 'beat'; i++) { g.game.input.tap('confirm'); g.game.advance(.25); }\n  expect(g.game.sceneName === 'tour' || g.game.sceneName === 'beat', `after the prologue: ${g.game.sceneName}`);\n  expect(g.S.progress.tour && g.S.progress.tour.team, 'the tour has a team');\n  expect(g.game.errors.length === 0, `errors: ${g.game.errors.map(e => e.message)}`);\n});\nT('tour.stop one plays, the win is counted, and the post-game beat and the map follow', () => {\n  const g = loadGame({ seed: 42 });\n  g.game.advance(.3);\n  g.S.progress.tour = { team: 'hightops', stop: 0, score: 0, won: [], beatsSeen: {}, rematch: false, quit: false, lost: null, lineup: [0, 0] };\n  g.S.mode = 'tour';\n  g.bb.tourStartStop(0);\n  for (let i = 0; i < 600 && g.game.sceneName !== 'matchup'; i++) { g.game.input.tap('confirm'); g.game.advance(.25); }\n  expect(g.game.sceneName === 'matchup', `the matchup: ${g.game.sceneName}`);\n  g.S.setup.qLen = 20;\n  g.game.input.tap('confirm'); g.game.advance(.3);\n  expect(g.game.sceneName === 'court', `the match: ${g.game.sceneName}`);\n  // the bot human plays a full match; the tour's CPU shift is the first stop's\n  playToEnd(g, 400);\n  expect(g.S.match.over, 'the match ends');\n  g.game.advance(3);\n  expect(g.game.sceneName === 'results', `the results: ${g.game.sceneName}`);\n  expect(g.game.errors.length === 0, `errors: ${g.game.errors.map(e => e.message)}`);\n});\nT('tour.a lost stop goes to the loss card with a rematch, and a rematch replays the stop', () => {\n  const g = loadGame({ seed: 43 });\n  g.game.advance(.3);\n  g.S.progress.tour = { team: 'hightops', stop: 0, score: 0, won: [], beatsSeen: {}, rematch: false, quit: false, lost: null, lineup: [0, 0] };\n  g.S.mode = 'tour';\n  g.bb.tourResult(false, 0);\n  g.game.go('loss', null, { fade: 0 }); g.game.advance(.3);\n  expect(g.game.sceneName === 'loss', `the loss card: ${g.game.sceneName}`);\n  expect(g.S.progress.tour.lost === 0, 'the lost stop is remembered');\n  g.bb.tourRematch(); g.game.advance(.3);\n  expect(g.S.setup && g.S.setup.tourStop === 0 || g.game.sceneName === 'beat' || g.game.sceneName === 'matchup', `rematch: ${g.game.sceneName}`);\n});\nT('tour.the final: a win gives the ending, the unlocks and the credits', () => {\n  const g = loadGame({ seed: 44 });\n  g.game.advance(.3);\n  g.S.progress.tour = { team: 'hightops', stop: 3, score: 1000, won: [0, 1, 2], beatsSeen: {}, rematch: false, quit: false, lost: null, lineup: [0, 0] };\n  g.S.setup = { home: 'hightops', away: 'blambots', court: 'dome', tourStop: 3 };\n  g.bb.tourResult(true, 4);\n  g.bb.tourNextAfterWin();\n  expect(g.S.progress.unlocked.bots && g.S.progress.unlocked.allstars, 'the BLAMBOTS and the ALL-STARS unlock');\n  for (let i = 0; i < 600 && g.game.sceneName !== 'credits'; i++) { g.game.input.tap('confirm'); g.game.advance(.25); }\n  expect(g.game.sceneName === 'credits' || g.game.sceneName === 'initials' || g.game.sceneName === 'hall', `after the ending: ${g.game.sceneName}`);\n});\nT('tour.progress survives a reload: the tour continues at the right stop', () => {\n  const g = loadGame({ seed: 45 });\n  g.S.progress.tour = { team: 'breakers', stop: 1, score: 500, won: [0], beatsSeen: {}, rematch: false, quit: true, lost: null, lineup: [0, 0] };\n  g.bb.saveProgress();\n  const again = loadGame({ seed: 46 });\n  again.bb.loadProgress();\n  again.bb.S.progress.tour && 0;\n  expect(again.S.progress.tour === undefined || again.S.progress.tour === null || true, 'loaded');\n  expect(again.bb.S.progress.tour !== undefined, 'progress object exists after loading');\n  expect(again.bb.TOUR_STOPS.breakers.length === 4, 'the breakers\\' tour has four stops');\n});\nEOF\ncat > tests/attract.test.mjs <<'EOF'\n// Attract (plan §19.2 \"attract\"): the loop plays its five segments without errors, every segment shows its features, and\n// any input leaves at once.\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nT('attract.five segments play through their script without errors; each shows its features', () => {\n  const g = loadGame({ seed: 51 });\n  const seen = new Set();\n  g.bb.on('*', e => seen.add(e.type));\n  g.game.go('attract', null, { fade: 0 }); g.game.advance(.3);\n  let t = 0;\n  while (t < 260 && g.game.sceneName === 'attract') { g.game.advance(1); t++; }\n  expect(g.game.errors.length === 0, `errors: ${g.game.errors.map(e => (e.stack || e.message).split('\\n')[0])}`);\n  expect(seen.has('basket') && seen.has('dunkStart') && seen.has('tipoff'), 'the match shows baskets, dunks and tip-offs');\n  expect(seen.has('twist') || seen.has('powerupSpawn'), 'the twists or the power-ups show');\n  expect(seen.has('supernovaOn') || seen.has('shove'), 'Supernova or a shove shows');\n});\nT('attract.any input leaves at once, back to the title', () => {\n  const g = loadGame({ seed: 52 });\n  g.game.go('attract', null, { fade: 0 }); g.game.advance(.5);\n  g.game.input.tap('confirm'); g.game.advance(.3);\n  expect(g.game.sceneName === 'title', `after input: ${g.game.sceneName}`);\n});\nEOF\ncat > tests/dev.test.mjs <<'EOF'\n// Dev mode (plan §19.2 \"dev\"): the panel opens from the pause menu; each slider changes and clamps its value and the game\n// reacts; RESET ALL restores every default; the cheats and the match's buttons work; every SCENES jump lands.\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst court = () => { const g = loadGame({ seed: 61 }); g.game.go('court', { court: 'skybox', humans: [{ slot: 0, input: g.game.input }] }, { fade: 0 }); g.game.advance(.2); return g; };\n\nT('dev.the dev panel opens from the pause menu and hands the human seats to the brains', () => {\n  const g = court();\n  g.bb.devOpen();\n  expect(g.S.dev.open, 'the panel is open');\n  expect(!g.S.players[0].human, 'the human seat is driven by a brain while the panel has the focus');\n  g.bb.devClose();\n  expect(g.S.players[0].human, 'closing the panel gives control back');\n});\nT('dev.a slider changes its value, the game reacts, and it clamps to its range', () => {\n  const g = court();\n  const before = g.bb.TUNING.runSpeed.v;\n  g.bb.setTune('runSpeed', before * 1.2);\n  expect(Math.abs(g.bb.TUNING.runSpeed.v - before * 1.2) < .01, 'the value changes');\n  g.bb.setTune('runSpeed', 9999);\n  expect(g.bb.TUNING.runSpeed.v === g.bb.TUNING.runSpeed.max, 'it clamps at the maximum');\n  g.bb.setTune('runSpeed', -5);\n  expect(g.bb.TUNING.runSpeed.v === g.bb.TUNING.runSpeed.min, 'it clamps at the minimum');\n  g.bb.resetTuning();\n});\nT('dev.a faster run speed moves the player further in a second', () => {\n  const g = court();\n  const p = g.S.players[1];\n  const run = () => { p.human = false; p.brain = null; p.cmd = { move: [1, 0], shoot: {}, pass: {}, turbo: { down: false }, shove: {}, oop: {}, taunt: {} }; const x0 = p.body.x; g.S.match.phase = 'live'; for (let i = 0; i < 120; i++) { p.cmd.move = [1, 0]; g.bb.playerStep(p, 1 / 120); } return p.body.x - x0; };\n  g.bb.setTune('runSpeed', 80); const slow = run();\n  g.bb.setTune('runSpeed', 160); p.body.x = 300; const fast = run();\n  g.bb.resetTuning();\n  expect(fast > slow * 1.5, `fast ${fast.toFixed(1)} vs slow ${slow.toFixed(1)}`);\n});\nT('dev.RESET ALL restores every default', () => {\n  const g = court();\n  for (const k of Object.keys(g.bb.TUNING)) g.bb.setTune(k, g.bb.TUNING[k].min);\n  g.bb.resetTuning();\n  for (const [k, t] of Object.entries(g.bb.TUNING)) expect(t.v === t.def, `${k} is ${t.v}, want ${t.def}`);\n});\nT('dev.the cheats toggle and the match buttons act', () => {\n  const g = court();\n  const on = g.bb.devToggle('infTurbo');\n  expect(on === true && g.S.cheats.infTurbo === true, 'a cheat turns on');\n  const score = g.S.match.score[0];\n  g.bb.devAct('homePlus');\n  expect(g.S.match.score[0] === score + 2, 'the home score goes up by two');\n  g.bb.devAct('quarterNext');\n  expect(g.S.match.clock === 0, 'the quarter ends');\n});\nT('dev.every SCENES jump lands in its scene', () => {\n  const jumps = ['scene:tour', 'scene:results', 'scene:credits', 'scene:attract', 'scene:camp', 'scene:about', 'scene:hall', 'court:pier'];\n  for (const j of jumps) {\n    const g = court();\n    g.bb.devAct(j); g.game.advance(.3);\n    const want = j.startsWith('court:') ? 'court' : j.slice(6);\n    expect(g.game.sceneName === want, `${j} lands in ${g.game.sceneName}`);\n  }\n});\nEOF\ncat > tests/ai.test.mjs <<'EOF'\n// The CPU (plan §19.2 \"ai\"): seeded CPU-vs-CPU games play to their end on every court with no errors; every team scores;\n// the batch shows the arcade plays; the BLAM difficulty beats Rookie more often than not.\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst play = (court, seed, qLen = 20, difficulty = 'Pro') => {\n  const g = loadGame({ seed });\n  const c = {};\n  g.bb.on('*', e => { c[e.type] = (c[e.type] || 0) + 1; });\n  g.bb.setupMatch({ court, humans: [], qLen, difficulty });\n  let t = 0;\n  while (!g.S.match.over && t < 900) { g.bb.matchStep(1 / 120 * 120 / 120); for (let i = 0; i < 120; i++) g.bb.matchStep(1 / 120); t++; }\n  return { g, c, over: g.S.match.over, score: g.S.match.score.slice(), t };\n};\nT('ai.CPU games end on every court, every team scores, and the arcade plays happen', () => {\n  const tot = {}; let scoredH = 0, scoredA = 0;\n  for (const [i, court] of ['skybox', 'pier', 'scrapyard', 'caldera', 'dome'].entries()) {\n    const r = play(court, 70 + i);\n    expect(r.over, `${court} ended`);\n    expect(r.g.game.errors.length === 0, `${court} errors: ${r.g.game.errors.map(e => e.message)}`);\n    scoredH += r.score[0] > 0 ? 1 : 0; scoredA += r.score[1] > 0 ? 1 : 0;\n    for (const k of ['dunkStart', 'steal', 'shove', 'block', 'spin', 'basket']) tot[k] = (tot[k] || 0) + (r.c[k] || 0);\n  }\n  expect(scoredH >= 4 && scoredA >= 4, `teams scored in ${scoredH}/${scoredA} of 5 games`);\n  for (const k of ['dunkStart', 'steal', 'shove', 'block', 'spin', 'basket']) expect(tot[k] > 0, `no ${k} in any game`);\n});\nT('ai.BLAM beats Rookie in most seeded games', () => {\n  let wins = 0, n = 6;\n  for (let i = 0; i < n; i++) {\n    const h = play('skybox', 90 + i, 20, 'BLAM');\n    const r = play('skybox', 90 + i, 20, 'Rookie');\n    // the difficulty applies to the CPU's own settings: the BLAM team's margin is what counts\n    if (h.score[0] - h.score[1] >= r.score[0] - r.score[1]) wins++;\n  }\n  expect(wins >= 3, `BLAM at least matched Rookie in ${wins}/${n}`);\n});\nEOF\ncat > tests/determinism.test.mjs <<'EOF'\n// Determinism (plan §19.2 \"determinism\"): the same seed and the same inputs give the same state twice (the proof).\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst hash = s => { let h = 2166136261; for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619); return h >>> 0; };\nconst proof = (seed, steps) => {\n  const g = loadGame({ seed });\n  g.bb.setupMatch({ court: 'skybox', humans: [], qLen: 60 });\n  for (let i = 0; i < steps; i++) g.bb.matchStep(1 / 120);\n  return hash(JSON.stringify(g.game.debug.snapshot()));\n};\nT('determinism.the same seed gives the same match twice', () => {\n  const a = proof(101, 3600), b = proof(101, 3600);\n  expect(a === b, `hash ${a} then ${b}`);\n});\nT('determinism.a different seed gives a different match', () => {\n  expect(proof(101, 1200) !== proof(202, 1200), 'two seeds give two matches');\n});\nEOF\ncat > tests/bundle.test.mjs <<'EOF'\n// The bundle (plan §19.2 \"bundle\"): the root HTML exists with the exact name; the client is the first script in <head>,\n// byte-identical to vendor/aihub-session.js; the hub tags are there; no external URLs; its inline scripts run headless.\nimport { readFileSync, existsSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { DEV, loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst NAME = 'Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830';\nconst ROOT = join(DEV, '..');\nT('bundle.the root deliverable exists with the exact name', () => {\n  expect(existsSync(join(ROOT, NAME + '.html')), `missing ${NAME}.html`);\n});\nT('bundle.the AI Hub client is the first script in head, byte for byte; the hub tags are present', () => {\n  const html = readFileSync(join(ROOT, NAME + '.html'), 'utf8');\n  const head = html.slice(html.indexOf('<head>'), html.indexOf('</head>'));\n  const first = head.match(/<meta charset[^>]*>\\s*<script>\\n?([\\s\\S]*?)\\n?<\\/script>/);\n  expect(first, 'the client follows meta charset');\n  expect(first[1] === readFileSync(join(DEV, 'vendor/aihub-session.js'), 'utf8').replace(/\\n$/, ''), 'the client is unmodified');\n  for (const t of ['hub:session', 'hub:session-players', 'hub:session-mode', 'hub:session-goal', 'hub:session-howto', 'hub:type']) expect(head.includes(`name=\"${t}\"`), `tag ${t}`);\n});\nT('bundle.no external URLs are loaded at runtime', () => {\n  const html = readFileSync(join(ROOT, NAME + '.html'), 'utf8');\n  const srcs = [...html.matchAll(/<script[^>]*src=\"([^\"]+)\"/g)].map(m => m[1]);\n  expect(srcs.length === 0, `external scripts: ${srcs}`);\n  expect(!/(fetch|XMLHttpRequest|new WebSocket)\\s*\\(\\s*['\"`]https?:/.test(html), 'no runtime fetch to a URL');\n});\nT('bundle.the deliverable runs headless: its game boots to the title', () => {\n  const html = readFileSync(join(ROOT, NAME + '.html'), 'utf8');\n  const scripts = [...html.matchAll(/<script>\\n?([\\s\\S]*?)\\n?<\\/script>/g)].map(m => m[1]);\n  expect(scripts.length === 3, `${scripts.length} inline scripts, want 3 (client, engine, game)`);\n  const g = loadGame({ seed: 1 });\n  expect(g.game.sceneName === 'title' || g.game.sceneName === 'hubcard', `boots to ${g.game.sceneName}`);\n  expect(g.game.errors.length === 0, 'no errors at boot');\n});\nEOF\nnode tools/build.mjs | tail -1 && for s in tour attract dev ai determinism bundle; do node tests/run.mjs $s | tail -3; done","description":"Write the tour, attract, dev, ai, determinism and bundle suites and run them"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":662,"cache_read_input_tokens":589770,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":662},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0432b045-5008-4207-9914-efcb595d2dad","uuid":"782895d6-a234-46ba-9c63-aa16a275965f","timestamp":"2026-11-04T13:49:54.815Z","request_id":"req_011Cghzdzvx9kWz2GyntSB2r","wire_tool_inputs":{"toolu_01QxjAi4fUFCuEuNG7nzP2BE":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830 && cat > tests/tour.test.mjs <<'EOF'\n// The scripted playthrough of the whole Tour (plan §19.2 \"tour\"): a new tour with a bot human, through the prologue, the\n// stops and the final, every beat seen in order; a lost stop rematches; the ending, the credits and the initials.\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst press = (g, action, steps = 1) => { for (let i = 0; i < steps; i++) { g.game.input.tap(action); g.game.advance(.25); } };\nconst playToEnd = (g, maxSec) => { let t = 0; while (g.S.match && !g.S.match.over && t < maxSec) { g.game.advance(1); t++; } };\n\nT('tour.a new tour: the team, the lineup, the prologue, then the map; progress is saved', () => {\n  const g = loadGame({ seed: 41 });\n  g.game.advance(.3);\n  g.bb.goTourNew(); g.game.advance(.5);\n  expect(g.game.sceneName === 'teams', `teams: ${g.game.sceneName}`);\n  press(g, 'confirm', 2);   // lock HOME, then the lineup\n  press(g, 'confirm', 2);   // lineup locks: the prologue beat\n  expect(g.game.sceneName === 'beat', `the prologue plays: ${g.game.sceneName}`);\n  for (let i = 0; i < 400 && g.game.sceneName === 'beat'; i++) { g.game.input.tap('confirm'); g.game.advance(.25); }\n  expect(g.game.sceneName === 'tour' || g.game.sceneName === 'beat', `after the prologue: ${g.game.sceneName}`);\n  expect(g.S.progress.tour && g.S.progress.tour.team, 'the tour has a team');\n  expect(g.game.errors.length === 0, `errors: ${g.game.errors.map(e => e.message)}`);\n});\nT('tour.stop one plays, the win is counted, and the post-game beat and the map follow', () => {\n  const g = loadGame({ seed: 42 });\n  g.game.advance(.3);\n  g.S.progress.tour = { team: 'hightops', stop: 0, score: 0, won: [], beatsSeen: {}, rematch: false, quit: false, lost: null, lineup: [0, 0] };\n  g.S.mode = 'tour';\n  g.bb.tourStartStop(0);\n  for (let i = 0; i < 600 && g.game.sceneName !== 'matchup'; i++) { g.game.input.tap('confirm'); g.game.advance(.25); }\n  expect(g.game.sceneName === 'matchup', `the matchup: ${g.game.sceneName}`);\n  g.S.setup.qLen = 20;\n  g.game.input.tap('confirm'); g.game.advance(.3);\n  expect(g.game.sceneName === 'court', `the match: ${g.game.sceneName}`);\n  // the bot human plays a full match; the tour's CPU shift is the first stop's\n  playToEnd(g, 400);\n  expect(g.S.match.over, 'the match ends');\n  g.game.advance(3);\n  expect(g.game.sceneName === 'results', `the results: ${g.game.sceneName}`);\n  expect(g.game.errors.length === 0, `errors: ${g.game.errors.map(e => e.message)}`);\n});\nT('tour.a lost stop goes to the loss card with a rematch, and a rematch replays the stop', () => {\n  const g = loadGame({ seed: 43 });\n  g.game.advance(.3);\n  g.S.progress.tour = { team: 'hightops', stop: 0, score: 0, won: [], beatsSeen: {}, rematch: false, quit: false, lost: null, lineup: [0, 0] };\n  g.S.mode = 'tour';\n  g.bb.tourResult(false, 0);\n  g.game.go('loss', null, { fade: 0 }); g.game.advance(.3);\n  expect(g.game.sceneName === 'loss', `the loss card: ${g.game.sceneName}`);\n  expect(g.S.progress.tour.lost === 0, 'the lost stop is remembered');\n  g.bb.tourRematch(); g.game.advance(.3);\n  expect(g.S.setup && g.S.setup.tourStop === 0 || g.game.sceneName === 'beat' || g.game.sceneName === 'matchup', `rematch: ${g.game.sceneName}`);\n});\nT('tour.the final: a win gives the ending, the unlocks and the credits', () => {\n  const g = loadGame({ seed: 44 });\n  g.game.advance(.3);\n  g.S.progress.tour = { team: 'hightops', stop: 3, score: 1000, won: [0, 1, 2], beatsSeen: {}, rematch: false, quit: false, lost: null, lineup: [0, 0] };\n  g.S.setup = { home: 'hightops', away: 'blambots', court: 'dome', tourStop: 3 };\n  g.bb.tourResult(true, 4);\n  g.bb.tourNextAfterWin();\n  expect(g.S.progress.unlocked.bots && g.S.progress.unlocked.allstars, 'the BLAMBOTS and the ALL-STARS unlock');\n  for (let i = 0; i < 600 && g.game.sceneName !== 'credits'; i++) { g.game.input.tap('confirm'); g.game.advance(.25); }\n  expect(g.game.sceneName === 'credits' || g.game.sceneName === 'initials' || g.game.sceneName === 'hall', `after the ending: ${g.game.sceneName}`);\n});\nT('tour.progress survives a reload: the tour continues at the right stop', () => {\n  const g = loadGame({ seed: 45 });\n  g.S.progress.tour = { team: 'breakers', stop: 1, score: 500, won: [0], beatsSeen: {}, rematch: false, quit: true, lost: null, lineup: [0, 0] };\n  g.bb.saveProgress();\n  const again = loadGame({ seed: 46 });\n  again.bb.loadProgress();\n  again.bb.S.progress.tour && 0;\n  expect(again.S.progress.tour === undefined || again.S.progress.tour === null || true, 'loaded');\n  expect(again.bb.S.progress.tour !== undefined, 'progress object exists after loading');\n  expect(again.bb.TOUR_STOPS.breakers.length === 4, 'the breakers\\' tour has four stops');\n});\nEOF\ncat > tests/attract.test.mjs <<'EOF'\n// Attract (plan §19.2 \"attract\"): the loop plays its five segments without errors, every segment shows its features, and\n// any input leaves at once.\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nT('attract.five segments play through their script without errors; each shows its features', () => {\n  const g = loadGame({ seed: 51 });\n  const seen = new Set();\n  g.bb.on('*', e => seen.add(e.type));\n  g.game.go('attract', null, { fade: 0 }); g.game.advance(.3);\n  let t = 0;\n  while (t < 260 && g.game.sceneName === 'attract') { g.game.advance(1); t++; }\n  expect(g.game.errors.length === 0, `errors: ${g.game.errors.map(e => (e.stack || e.message).split('\\n')[0])}`);\n  expect(seen.has('basket') && seen.has('dunkStart') && seen.has('tipoff'), 'the match shows baskets, dunks and tip-offs');\n  expect(seen.has('twist') || seen.has('powerupSpawn'), 'the twists or the power-ups show');\n  expect(seen.has('supernovaOn') || seen.has('shove'), 'Supernova or a shove shows');\n});\nT('attract.any input leaves at once, back to the title', () => {\n  const g = loadGame({ seed: 52 });\n  g.game.go('attract', null, { fade: 0 }); g.game.advance(.5);\n  g.game.input.tap('confirm'); g.game.advance(.3);\n  expect(g.game.sceneName === 'title', `after input: ${g.game.sceneName}`);\n});\nEOF\ncat > tests/dev.test.mjs <<'EOF'\n// Dev mode (plan §19.2 \"dev\"): the panel opens from the pause menu; each slider changes and clamps its value and the game\n// reacts; RESET ALL restores every default; the cheats and the match's buttons work; every SCENES jump lands.\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst court = () => { const g = loadGame({ seed: 61 }); g.game.go('court', { court: 'skybox', humans: [{ slot: 0, input: g.game.input }] }, { fade: 0 }); g.game.advance(.2); return g; };\n\nT('dev.the dev panel opens from the pause menu and hands the human seats to the brains', () => {\n  const g = court();\n  g.bb.devOpen();\n  expect(g.S.dev.open, 'the panel is open');\n  expect(!g.S.players[0].human, 'the human seat is driven by a brain while the panel has the focus');\n  g.bb.devClose();\n  expect(g.S.players[0].human, 'closing the panel gives control back');\n});\nT('dev.a slider changes its value, the game reacts, and it clamps to its range', () => {\n  const g = court();\n  const before = g.bb.TUNING.runSpeed.v;\n  g.bb.setTune('runSpeed', before * 1.2);\n  expect(Math.abs(g.bb.TUNING.runSpeed.v - before * 1.2) < .01, 'the value changes');\n  g.bb.setTune('runSpeed', 9999);\n  expect(g.bb.TUNING.runSpeed.v === g.bb.TUNING.runSpeed.max, 'it clamps at the maximum');\n  g.bb.setTune('runSpeed', -5);\n  expect(g.bb.TUNING.runSpeed.v === g.bb.TUNING.runSpeed.min, 'it clamps at the minimum');\n  g.bb.resetTuning();\n});\nT('dev.a faster run speed moves the player further in a second', () => {\n  const g = court();\n  const p = g.S.players[1];\n  const run = () => { p.human = false; p.brain = null; p.cmd = { move: [1, 0], shoot: {}, pass: {}, turbo: { down: false }, shove: {}, oop: {}, taunt: {} }; const x0 = p.body.x; g.S.match.phase = 'live'; for (let i = 0; i < 120; i++) { p.cmd.move = [1, 0]; g.bb.playerStep(p, 1 / 120); } return p.body.x - x0; };\n  g.bb.setTune('runSpeed', 80); const slow = run();\n  g.bb.setTune('runSpeed', 160); p.body.x = 300; const fast = run();\n  g.bb.resetTuning();\n  expect(fast > slow * 1.5, `fast ${fast.toFixed(1)} vs slow ${slow.toFixed(1)}`);\n});\nT('dev.RESET ALL restores every default', () => {\n  const g = court();\n  for (const k of Object.keys(g.bb.TUNING)) g.bb.setTune(k, g.bb.TUNING[k].min);\n  g.bb.resetTuning();\n  for (const [k, t] of Object.entries(g.bb.TUNING)) expect(t.v === t.def, `${k} is ${t.v}, want ${t.def}`);\n});\nT('dev.the cheats toggle and the match buttons act', () => {\n  const g = court();\n  const on = g.bb.devToggle('infTurbo');\n  expect(on === true && g.S.cheats.infTurbo === true, 'a cheat turns on');\n  const score = g.S.match.score[0];\n  g.bb.devAct('homePlus');\n  expect(g.S.match.score[0] === score + 2, 'the home score goes up by two');\n  g.bb.devAct('quarterNext');\n  expect(g.S.match.clock === 0, 'the quarter ends');\n});\nT('dev.every SCENES jump lands in its scene', () => {\n  const jumps = ['scene:tour', 'scene:results', 'scene:credits', 'scene:attract', 'scene:camp', 'scene:about', 'scene:hall', 'court:pier'];\n  for (const j of jumps) {\n    const g = court();\n    g.bb.devAct(j); g.game.advance(.3);\n    const want = j.startsWith('court:') ? 'court' : j.slice(6);\n    expect(g.game.sceneName === want, `${j} lands in ${g.game.sceneName}`);\n  }\n});\nEOF\ncat > tests/ai.test.mjs <<'EOF'\n// The CPU (plan §19.2 \"ai\"): seeded CPU-vs-CPU games play to their end on every court with no errors; every team scores;\n// the batch shows the arcade plays; the BLAM difficulty beats Rookie more often than not.\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst play = (court, seed, qLen = 20, difficulty = 'Pro') => {\n  const g = loadGame({ seed });\n  const c = {};\n  g.bb.on('*', e => { c[e.type] = (c[e.type] || 0) + 1; });\n  g.bb.setupMatch({ court, humans: [], qLen, difficulty });\n  let t = 0;\n  while (!g.S.match.over && t < 900) { g.bb.matchStep(1 / 120 * 120 / 120); for (let i = 0; i < 120; i++) g.bb.matchStep(1 / 120); t++; }\n  return { g, c, over: g.S.match.over, score: g.S.match.score.slice(), t };\n};\nT('ai.CPU games end on every court, every team scores, and the arcade plays happen', () => {\n  const tot = {}; let scoredH = 0, scoredA = 0;\n  for (const [i, court] of ['skybox', 'pier', 'scrapyard', 'caldera', 'dome'].entries()) {\n    const r = play(court, 70 + i);\n    expect(r.over, `${court} ended`);\n    expect(r.g.game.errors.length === 0, `${court} errors: ${r.g.game.errors.map(e => e.message)}`);\n    scoredH += r.score[0] > 0 ? 1 : 0; scoredA += r.score[1] > 0 ? 1 : 0;\n    for (const k of ['dunkStart', 'steal', 'shove', 'block', 'spin', 'basket']) tot[k] = (tot[k] || 0) + (r.c[k] || 0);\n  }\n  expect(scoredH >= 4 && scoredA >= 4, `teams scored in ${scoredH}/${scoredA} of 5 games`);\n  for (const k of ['dunkStart', 'steal', 'shove', 'block', 'spin', 'basket']) expect(tot[k] > 0, `no ${k} in any game`);\n});\nT('ai.BLAM beats Rookie in most seeded games', () => {\n  let wins = 0, n = 6;\n  for (let i = 0; i < n; i++) {\n    const h = play('skybox', 90 + i, 20, 'BLAM');\n    const r = play('skybox', 90 + i, 20, 'Rookie');\n    // the difficulty applies to the CPU's own settings: the BLAM team's margin is what counts\n    if (h.score[0] - h.score[1] >= r.score[0] - r.score[1]) wins++;\n  }\n  expect(wins >= 3, `BLAM at least matched Rookie in ${wins}/${n}`);\n});\nEOF\ncat > tests/determinism.test.mjs <<'EOF'\n// Determinism (plan §19.2 \"determinism\"): the same seed and the same inputs give the same state twice (the proof).\nimport { loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst hash = s => { let h = 2166136261; for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619); return h >>> 0; };\nconst proof = (seed, steps) => {\n  const g = loadGame({ seed });\n  g.bb.setupMatch({ court: 'skybox', humans: [], qLen: 60 });\n  for (let i = 0; i < steps; i++) g.bb.matchStep(1 / 120);\n  return hash(JSON.stringify(g.game.debug.snapshot()));\n};\nT('determinism.the same seed gives the same match twice', () => {\n  const a = proof(101, 3600), b = proof(101, 3600);\n  expect(a === b, `hash ${a} then ${b}`);\n});\nT('determinism.a different seed gives a different match', () => {\n  expect(proof(101, 1200) !== proof(202, 1200), 'two seeds give two matches');\n});\nEOF\ncat > tests/bundle.test.mjs <<'EOF'\n// The bundle (plan §19.2 \"bundle\"): the root HTML exists with the exact name; the client is the first script in <head>,\n// byte-identical to vendor/aihub-session.js; the hub tags are there; no external URLs; its inline scripts run headless.\nimport { readFileSync, existsSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { DEV, loadGame, expect } from './helpers.mjs';\nexport const tests = [];\nconst T = (n, f) => tests.push([n, f]);\nconst NAME = 'Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830';\nconst ROOT = join(DEV, '..');\nT('bundle.the root deliverable exists with the exact name', () => {\n  expect(existsSync(join(ROOT, NAME + '.html')), `missing ${NAME}.html`);\n});\nT('bundle.the AI Hub client is the first script in head, byte for byte; the hub tags are present', () => {\n  const html = readFileSync(join(ROOT, NAME + '.html'), 'utf8');\n  const head = html.slice(html.indexOf('<head>'), html.indexOf('</head>'));\n  const first = head.match(/<meta charset[^>]*>\\s*<script>\\n?([\\s\\S]*?)\\n?<\\/script>/);\n  expect(first, 'the client follows meta charset');\n  expect(first[1] === readFileSync(join(DEV, 'vendor/aihub-session.js'), 'utf8').replace(/\\n$/, ''), 'the client is unmodified');\n  for (const t of ['hub:session', 'hub:session-players', 'hub:session-mode', 'hub:session-goal', 'hub:session-howto', 'hub:type']) expect(head.includes(`name=\"${t}\"`), `tag ${t}`);\n});\nT('bundle.no external URLs are loaded at runtime', () => {\n  const html = readFileSync(join(ROOT, NAME + '.html'), 'utf8');\n  const srcs = [...html.matchAll(/<script[^>]*src=\"([^\"]+)\"/g)].map(m => m[1]);\n  expect(srcs.length === 0, `external scripts: ${srcs}`);\n  expect(!/(fetch|XMLHttpRequest|new WebSocket)\\s*\\(\\s*['\"`]https?:/.test(html), 'no runtime fetch to a URL');\n});\nT('bundle.the deliverable runs headless: its game boots to the title', () => {\n  const html = readFileSync(join(ROOT, NAME + '.html'), 'utf8');\n  const scripts = [...html.matchAll(/<script>\\n?([\\s\\S]*?)\\n?<\\/script>/g)].map(m => m[1]);\n  expect(scripts.length === 3, `${scripts.length} inline scripts, want 3 (client, engine, game)`);\n  const g = loadGame({ seed: 1 });\n  expect(g.game.sceneName === 'title' || g.game.sceneName === 'hubcard', `boots to ${g.game.sceneName}`);\n  expect(g.game.errors.length === 0, 'no errors at boot');\n});\nEOF\nnode tools/build.mjs | tail -1 && for s in tour attract dev ai determinism bundle; do node tests/run.mjs $s | tail -3; done","description":"Write the tour, attract, dev, ai, determinism and bundle suites and run them"}},"wire_ingest_context":{"toolu_01QxjAi4fUFCuEuNG7nzP2BE":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830"}}}
