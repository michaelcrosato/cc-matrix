 => { const k = Math.floor(lx / 48) % 2 ? 1 : 0, g = 1 + (k ? .06 : -.02) + n * .08 + m * .06; const c = rgbOf(base); return [c[0] * g, c[1] * g, c[2] * g]; }\n});\n\nconst COURTS = {};\nconst courtDef = (id, d) => { COURTS[id] = Object.assign({ id }, d); return COURTS[id]; };\n\ncourtDef('skybox', {\n  name: 'THE SKYBOX', home: 'hightops', song: 'skybox', dribble: 'dribble_asphalt', twist: 'jackpot',\n  floor: COURT_FLOOR('#1c1a2e', '#14122a', '#2de2ff', '#ff3ca6', '#2de2ff'),\n  logoMask: logoAt(LOGO_SNEAKER, 320, 144, 4, { w: [255, 255, 255], '.': null }),\n  stand: { low: '#2a2440', mid: '#312a4c', high: '#3a3258', back: '#1d1836', top: '#4a4068' },\n  outside: '#0c0a18', ambient: .45, sky: ['#07061a', '#1d1240', '#3a1a5a'], stars: 60, moon: { x: .82, y: .18, r: 10, color: '#f4e8ff' },\n  crowd: ['#ff3ca6', '#2de2ff', '#1a1a1a', '#ffd23a'], skin: ['#e0b090', '#a87050', '#6a4028', '#f0c8a8'],\n  lights: [[52, 0, 150, 180, .9, '#fff0d0'], [588, 0, 150, 180, .9, '#fff0d0'], [52, 288, 150, 180, .9, '#fff0d0'], [588, 288, 150, 180, .9, '#fff0d0']]\n});\n\n/* ---- THE HOOPS (plan §9.3): the glass is a panel turned 30 degrees toward the camera, so its face reads; the rim is two\n * halves queued at different depths; the net hangs as ten strands with springy knots; the stanchion is a pole behind the\n * board. All in world units (the ring centre, the board plane), drawn through r.w(). ---- */\nconst hoopNet = [];\nfor (let i = 0; i < 10; i++) hoopNet.push(i / 10 * TAU);\nconst HOOP_STATE = [{ bend: 0, bendV: 0, knot: hoopNet.map(() => [0, 0, 0]) }, { bend: 0, bendV: 0, knot: hoopNet.map(() => [0, 0, 0]) }];\n\n/** a hoop's rim point at angle a on the ring (z 80), in world units, with its bend */\nconst rimPoint = (side, a, zOff = 0) => {\n  const rm = RIMW[side], st = HOOP_STATE[side];\n  const x = rm.x + Math.cos(a) * RIM_R, y = rm.y + Math.sin(a) * RIM_R;\n  return [x, y, rm.z - Math.max(0, Math.sin(a) < 0 ? 0 : 0) - st.bend * Math.max(0, Math.cos(a)) * (side ? -1 : 1) * 0 + zOff - st.bend * Math.max(0, Math.cos(a - (side ? PI : 0))) * .5];\n};\n/** the hoop's springs: a hit bends the front of the ring down, the spring brings it back; the knots are pushed by the ball */\nconst stepHoops = (dt, tune2 = 1) => {\n  for (const side of [0, 1]) {\n    const st = HOOP_STATE[side];\n    st.bendV += (-st.bend * 220 - st.bendV * 10) * dt; st.bend += st.bendV * dt;\n    st.bend = clamp(st.bend, -4, 4);\n    for (let k = 0; k < hoopNet.length; k++) {\n      const kn = st.knot[k]; kn[0] += -kn[0] * 30 * dt; kn[1] += -kn[1] * 30 * dt; kn[2] *= Math.exp(-6 * dt);\n    }\n  }\n};\n/** the ball pushes the net's knots: a swish ripples the strands it passes through */\nconst pushHoopNet = (side, x, y, z, strength) => {\n  const rm = RIMW[side], st = HOOP_STATE[side], dx = x - rm.x, dy = y - rm.y, d = Math.hypot(dx, dy);\n  if (d > 9) return;\n  const a = Math.atan2(dy, dx), k = Math.round(((a + TAU) % TAU) / TAU * hoopNet.length) % hoopNet.length;\n  st.knot[k][2] -= strength; st.knot[k][0] += Math.cos(a) * strength * .4; st.knot[k][1] += Math.sin(a) * strength * .4;\n};\non('goal', ev => { pushHoopNet(ev.rim, ev.x, ev.y, ev.z, 12); });\non('rim', ev => { const side = ev.rim; if (side === undefined) return; HOOP_STATE[side].bendV += (ev.speed || 80) * .02; });\n\n/** the rim's ring: points on the circle at z 80, as a front (y greater: nearer the camera) or back half; drawn in r.w space */\nconst drawRimHalf = (r, g, side, front) => {\n  const rm = RIMW[side], col = '#ff7a2a', hi = '#ffb060';\n  let prev = null;\n  for (let i = 0; i <= 16; i++) {\n    const a = i / 16 * TAU, sinA = Math.sin(a);\n    if (front ? sinA < 0 : sinA >= 0) { prev = null; continue; }\n    const p = rimPoint(side, a);\n    const q = r.w(p[0], p[1], p[2]);\n    if (prev) px.line(g, prev[0], prev[1], q[0], q[1], col, 2);\n    if (front) px.dot(g, q[0], q[1] - 1, hi);\n    prev = q;\n  }\n};\n/** the net: ten strands from the ring to a lower ring (radius 5.5, z 66) with a knot in the middle and zig-zag links */\nconst drawHoopNet = (r, g, side, front) => {\n  const rm = RIMW[side], st = HOOP_STATE[side];\n  for (let k = 0; k < hoopNet.length; k++) {\n    const a = hoopNet[k], sinA = Math.sin(a);\n    if (front ? sinA < 0 : sinA >= 0) continue;\n    const top = rimPoint(side, a), bot = [rm.x + Math.cos(a) * 5.5, rm.y + Math.sin(a) * 5.5, 66];\n    const kn = st.knot[k];\n    const mid = [lerp(top[0], bot[0], .5) + kn[0], lerp(top[1], bot[1], .5) + kn[1], lerp(top[2], bot[2], .5) + kn[2]];\n    const a2 = r.w(top[0], top[1], top[2]), m2 = r.w(mid[0], mid[1], mid[2]), b2 = r.w(bot[0], bot[1], bot[2]);\n    px.line(g, a2[0], a2[1], m2[0], m2[1], '#f4f4f8', 1);\n    px.line(g, m2[0], m2[1], b2[0], b2[1], '#f4f4f8', 1);\n  }\n};\n/** a hoop, all of it: the stanchion behind the board, the glass, the rim and the net (back halves behind the ball, front\n * halves in front of it) */\nconst drawHoop = (r, side) => {\n  const rm = RIMW[side], s = side ? -1 : 1, bx = BOARD_PLANE[side];\n  // the stanchion: a pole behind the board and an arm up to it\n  r.queue(bx - 8 * s * -1, rm.y, 0, g => {\n    const p0 = r.w(bx - 8 * s * -1, rm.y, 0), p1 = r.w(bx - 8 * s * -1, rm.y, 72), a1 = r.w(bx, rm.y, 74);\n    px.line(g, p0[0], p0[1], p1[0], p1[1], '#8a8c98', 3);\n    px.line(g, p1[0], p1[1], a1[0], a1[1], '#b8bcc8', 2);\n  }, { bias: -2 });\n  // the glass: a panel turned toward the camera (the board's face: a parallelogram, z 72..100)\n  const h = 24, dir = [-.5 * s, .866], e0 = [bx, rm.y - h * dir[1] * (side ? -1 : 1) * 0 + (side ? -h * .866 : h * .866) * 0];\n  const c = [bx, rm.y], ee = [c[0] - 12 * s * -1, c[1] + 20.8], fe = [c[0] + 12 * s * -1, c[1] - 20.8];\n  r.queue(bx, rm.y, 86, g => {\n    const q = [ee, fe].map(p => [p[0], p[1]]);\n    const pts = [r.w(q[0][0], q[0][1], 100), r.w(q[1][0], q[1][1], 100), r.w(q[1][0], q[1][1], 72), r.w(q[0][0], q[0][1], 72)];\n    const poly = pts.map(p => [p[0], p[1]]);\n    px.blend(g, .28, 'screen', () => px.poly(g, poly, '#a8e8ff'));\n    px.line(g, poly[0][0], poly[0][1], poly[1][0], poly[1][1], '#ffffff', 1);\n    px.line(g, poly[1][0], poly[1][1], poly[2][0], poly[2][1], '#ffffff', 1);\n    px.line(g, poly[2][0], poly[2][1], poly[3][0], poly[3][1], '#ffffff', 1);\n    px.line(g, poly[3][0], poly[3][1], poly[0][0], poly[0][1], '#ffffff', 1);\n    // the shooter's square, orange, on the glass\n    const sq = [[0, 0, 0], [0, 0, 0]];\n    const sqc = [c[0], c[1]];\n    const a = r.w(bx, rm.y - 6, 92), b = r.w(bx, rm.y + 6, 92), c1 = r.w(bx, rm.y + 6, 82), d1 = r.w(bx, rm.y - 6, 82);\n    px.line(g, a[0], a[1], b[0], b[1], '#ff7a2a', 1);\n    px.line(g, b[0], b[1], c1[0], c1[1], '#ff7a2a', 1);\n    px.line(g, c1[0], c1[1], d1[0], d1[1], '#ff7a2a', 1);\n    px.line(g, d1[0], d1[1], a[0], a[1], '#ff7a2a', 1);\n  }, { bias: -1 });\n  r.queue(rm.x, rm.y - 6, rm.z, g => { drawRimHalf(r, g, side, false); drawHoopNet(r, g, side, false); }, { bias: -3 });\n  r.queue(rm.x, rm.y + 6, rm.z, g => { drawRimHalf(r, g, side, true); drawHoopNet(r, g, side, true); }, { bias: 3 });\n};\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01XuNS4cpFJX8qgAReumgq7W","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
