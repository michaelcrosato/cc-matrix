ut;\n};\nconst crowdSpr = {};\nconst crowdSprite = (shirt, skin) => {\n  const key = shirt + skin; if (crowdSpr[key]) return crowdSpr[key];\n  return (crowdSpr[key] = E.sprite(['.hhh.', 'hhhhh', 'shhhs', '.sss.', 'bbbbb', 'bbbbb', 'b.b.b'], { h: '#2a1a14', s: skin, b: shirt }));\n};\n/** the crowd: each figure's bob comes from the time and its phase; the home side's misses slump, dunks jump (later) */\nconst drawCrowd = (r, court) => {\n  if (!S.crowd) S.crowd = buildCrowd(court);\n  const t = game.time || 0;\n  for (const f of S.crowd) {\n    const bob = Math.round(Math.sin(t * 3 + f.ph) * 1);\n    r.sprite(f.x, f.y, f.z, crowdSprite(f.shirt, f.skin), { anchor: 'bottom' });\n  }\n};\n\n/** the whole court in one draw: the sky, the floor, the stands and walls, the hoops, the crowd, the players and the ball */\nconst drawCourt = (r, court) => {\n  r.sky(court.sky);\n  S.map.drawFloor(r);\n  S.map.queueWalls(r);\n  drawHoop(r, 0); drawHoop(r, 1);\n  drawCrowd(r, court);\n  for (const p of S.players) {\n    if (!p.onCourt) continue;\n    r.shadow(p.body.x, p.body.y, 7, .5, '#0c0818', 0);\n    r.actor(p.body.x, p.body.y, p.body.z, (g, ox, oy) => p.rig.draw(g, ox, oy, r.view));\n  }\n  const b = S.ball;\n  r.shadow(b.x, b.y, 4.5, .45, '#0c0818', 0);\n  r.sprite(b.x, b.y, b.z, ballSprite(b), { anchor: 'center' });\n};\nEOF\npython3 - <<'EOF'\np='src/21-court-draw.js'; s=open(p).read()\ns=s.replace(\"\"\"const BALL_FRAMES = [\n  ['...ooooo...', '..oOOOOOo..', '.oOOooOOOo.', 'oOOoOOoOOoo', 'oOOOOOOOOOo'].length ? null : null\n];\n\"\"\",\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/90-start.js <<'EOF'\n/* ---- START: the scene table, the deep links and the debug handle ---- */\nconst scenes = {};\nconst pauseItems = () => [];\nconst courtCamera = { zoom: [.8, 1.4], start: 1 };\nscenes.court = {\n  view: BROADCAST, input: KEYS, res: 'ps1', expand: true, pausable: true, camera: courtCamera,\n  enter(d) { d = d || {}; setupMatch({ court: d.court || 'skybox', humans: d.humans || [{ slot: 0, input: game.input }], qLen: d.qLen, mode: 'exhibition' }); L.enabled = true; L.ambient = (COURTS[S.court] || {}).ambient || .5; },\n  update(dt) { matchStep(dt); cameraStep(dt); },\n  draw(r) { drawCourt(r, S.courtDef); }\n};\nscenes.title = {\n  view: BROADCAST, input: KEYS, res: 'ps1', expand: true,\n  draw(r) { r.sky(['#05040a', '#1d1240', '#3a1a5a']); r.text('BASKETBLAM', r.W / 2, r.H / 2, '#ffffff', { align: 'center', scale: 3 }); }\n};\ngame.debug = { snapshot: () => ({ scene: game.sceneName, phase: S.match && S.match.phase, clock: S.match && +S.match.clock.toFixed(2), score: S.match && S.match.score.slice() }) };\nwindow.__bb = { S, game, TUNING, emit, on, debug: game.debug, phys: { newBall, ballPlace, ballStep, ballRelease, ballFlight, ballSubstep, RIMW, OX, OY }, setupMatch, matchStep };\ngame.start({ scenes, scene: 'title' });\nEOF\nnode tools/build.mjs && cat > .smoke.mjs <<'EOF'\nimport { loadGame } from './tests/helpers.mjs';\nconst { game, bb, S } = loadGame({ seed: 5 });\ngame.go('court', {}, { fade: 0 });\ngame.advance(.1);\nconsole.log('scene', game.sceneName, 'errors', game.errors.map(e => e.message));\ngame.advance(30);\nconsole.log('after 30s', JSON.stringify(bb.game.debug.snapshot()), 'errors', game.errors.map(e => e.message).slice(0,3));\nEOF\nnode .smoke.mjs; rm -f .smoke.mjs","description":"Write court drawing, match scene, rebuild and smoke-run a match"}},"wire_ingest_context":{"toolu_012tMuPnhzkKi7KHMTxrXpRT":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830"}}}
