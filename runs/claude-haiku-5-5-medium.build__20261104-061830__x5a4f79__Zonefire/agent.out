ck.pass === true));\n      expect(pass, `the harness: ${await page.evaluate(() => JSON.stringify(window.__hubCheck || {}).slice(0, 300))}`);\n      expect(errs.length === 0, `page errors: ${errs.slice(0, 2).join(' | ')}`);\n    } finally { await browser.close(); p.kill('SIGTERM'); }\n  }, { browser: true, slow: true });\n}\nEOF\nnode tests/run.mjs browser 2>&1 | tail -5","description":"Write the browser and hub suites and run the browser suite"}},"wire_ingest_context":{"toolu_01CLLaaaWgiLC9LfSmSzjRie":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-061830__x5a4f79/work/Basketblam-Basketball-claude-haiku-5-5-medium-20261104-061830"}}}
