{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjDqZYahnWcvPd7nXSmK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01P98E6AwAUjCjkRDBKJHeHf","name":"Bash","input":{"command":"cat > game/audio.js <<'EOF'\n// All sound is written here. Hold music in a very clean building. Music defaults to 10% and is never compensated for.\nconst A = game.audio;\nG.sfx = (name, o) => { try { return A.sfx(name, o); } catch (e) { return null; } };\nconst bar = (s, n = 1) => Array(n).fill(s).join(' | ');\nG.SONGS = {\n  studio: { bpm: 78, steps: 4, name: 'Please Hold Your Posture', tracks: [\n    { wave: 'sine', vol: .28, gate: .9, name: 'lead', notes: bar('E5 - - - G5 - A5 - | G5 - - - E5 - D5 - | C5 - - - E5 - G5 - | A5 - G5 - E5 - - -', 2) },\n    { wave: 'triangle', vol: .26, name: 'bass', notes: bar('C3 - - - G3 - - - | A2 - - - E3 - - - | F2 - - - C3 - - - | G2 - - - D3 - - -', 2) },\n    { wave: 'pulse12', vol: .07, notes: bar('C4 E4 G4 E4 C4 E4 G4 E4 | A3 C4 E4 C4 A3 C4 E4 C4 | F3 A3 C4 A3 F3 A3 C4 A3 | G3 B3 D4 B3 G3 B3 D4 B3', 2) } ] },\n  morning: { bpm: 92, steps: 4, name: 'A Light Breakfast', tracks: [\n    { wave: 'triangle', vol: .24, notes: bar('G5 . E5 . C5 . E5 . | F5 . D5 . B4 . D5 . | E5 . C5 . A4 . C5 . | D5 - - - . . . .', 2) },\n    { wave: 'sine', vol: .28, notes: bar('C3 . . . G3 . . . | G2 . . . D3 . . . | A2 . . . E3 . . . | F2 . G2 . C3 . . .', 2) },\n    { wave: 'drums', vol: .1, notes: bar('h . . . h . . . | h . . . h . . .', 4) } ] },\n  dusk: { bpm: 66, steps: 4, name: 'The Institute Thanks You For Today', tracks: [\n    { wave: 'sine', vol: .28, notes: bar('A4 - - - C5 - - - | E5 - - - D5 - C5 - | G4 - - - B4 - - - | D5 - - - C5 - B4 -', 2) },\n    { wave: 'triangle', vol: .24, notes: bar('A2 - - - E3 - - - | F2 - - - C3 - - - | C3 - - - G3 - - - | G2 - - - D3 - - -', 2) } ] },\n  yoga: { bpm: 60, steps: 4, name: 'Pad For Holding Still', tracks: [\n    { wave: 'sine', vol: .3, notes: bar('C4 - - - - - - - | E4 - - - - - - - | D4 - - - - - - - | G3 - - - - - - -', 2) },\n    { wave: 'sine', vol: .18, notes: bar('G4 - - - - - - - | B4 - - - - - - - | A4 - - - - - - - | D4 - - - - - - -', 2) },\n    { wave: 'triangle', vol: .08, notes: bar('. . C6 . . . G5 . | . . E6 . . . B5 . | . . D6 . . . A5 . | . . G5 . . . D5 .', 2) } ] },\n  iron: { bpm: 96, steps: 4, name: 'Light Resistance', tracks: [\n    { wave: 'pulse', vol: .12, notes: bar('A3 . A3 . C4 . E4 . | G3 . G3 . B3 . D4 . | F3 . F3 . A3 . C4 . | E3 . G#3 . B3 . E4 .', 2) },\n    { wave: 'triangle', vol: .28, notes: bar('A2 . . . A2 . . . | G2 . . . G2 . . . | F2 . . . F2 . . . | E2 . . . E2 . . .', 2) },\n    { wave: 'drums', vol: .2, notes: bar('k . h . s . h . | k . h . s . h .', 4) } ] },\n  step1: { bpm: 100, steps: 4, loop: false, name: 'Step A: Up, And Down Again', tracks: [\n    { wave: 'triangle', vol: .3, notes: bar('C3 . C3 . G3 . C3 . | F2 . F2 . C3 . F2 . | G2 . G2 . D3 . G2 . | C3 . E3 . G3 . E3 .', 6) },\n    { wave: 'sine', vol: .26, notes: bar('E5 . G5 . C6 . G5 . | F5 . A5 . C6 . A5 . | D5 . G5 . B5 . G5 . | E5 . - . G5 . . .', 6) },\n    { wave: 'drums', vol: .2, notes: bar('k . h . s . h . | k . h . s . h .', 12) } ] },\n  step2: { bpm: 120, steps: 4, loop: false, name: 'Step B: With Enthusiasm', tracks: [\n    { wave: 'triangle', vol: .3, notes: bar('A2 . A3 . A2 . A3 . | F2 . F3 . F2 . F3 . | C3 . C4 . C3 . C4 . | G2 . G3 . G2 . G3 .', 8) },\n    { wave: 'pulse', vol: .11, notes: bar('E5 . A5 . C6 . A5 . | F5 . A5 . C6 . F5 . | G5 . C6 . E6 . C6 . | G5 . B5 . D6 . B5 .', 8) },\n    { wave: 'drums', vol: .22, notes: bar('k h h h s h h h | k h k h s h h h', 16) } ] },\n  jog: { bpm: 90, steps: 4, name: 'Coast Road, Moderate Pace', tracks: [\n    { wave: 'triangle', vol: .24, notes: bar('D5 . F#5 . A5 . F#5 . | E5 . G5 . B5 . G5 . | F#5 . A5 . D6 . A5 . | E5 - - - . . . .', 2) },\n    { wave: 'sine', vol: .28, notes: bar('D3 . D3 . A3 . D3 . | E3 . E3 . B3 . E3 . | D3 . D3 . A3 . D3 . | A2 . A2 . E3 . A2 .', 2) },\n    { wave: 'drums', vol: .15, notes: bar('k . h . k . h . | k . h . k . h .', 4) } ] },\n  ski: { bpm: 126, steps: 4, name: 'Mount Posture, Downhill', tracks: [\n    { wave: 'pulse', vol: .12, notes: bar('E5 G5 B5 G5 E5 G5 B5 G5 | C5 E5 G5 E5 C5 E5 G5 E5 | D5 F#5 A5 F#5 D5 F#5 A5 F#5 | B4 D5 F#5 D5 B4 D5 F#5 D5', 2) },\n    { wave: 'triangle', vol: .3, notes: bar('E2 . E3 . E2 . E3 . | C2 . C3 . C2 . C3 . | D2 . D3 . D2 . D3 . | B1 . B2 . B1 . B2 .', 2) },\n    { wave: 'drums', vol: .2, notes: bar('k . h . s . h h | k . h k s . h .', 4) } ] },\n  tray: { bpm: 84, steps: 4, name: 'Olive Lounge', tracks: [\n    { wave: 'sine', vol: .28, notes: bar('D5 - F5 . A5 - G5 . | F5 - - - D5 . . . | C5 - E5 . G5 - F5 . | E5 - - - C5 . . .', 2) },\n    { wave: 'triangle', vol: .26, notes: bar('D3 . A3 . D3 . A3 . | G2 . D3 . G2 . D3 . | C3 . G3 . C3 . G3 . | A2 . E3 . A2 . E3 .', 2) },\n    { wave: 'drums', vol: .08, notes: bar('h . h h . h . . | h . h h . h . .', 4) } ] },\n  laundry: { bpm: 104, steps: 4, name: 'Pizzicato For A Clothesline', tracks: [\n    { wave: 'triangle', vol: .3, gate: .25, notes: bar('G4 . B4 . D5 . B4 . | A4 . C5 . E5 . C5 . | F#4 . A4 . D5 . A4 . | G4 . . . D4 . . .', 2) },\n    { wave: 'sine', vol: .26, gate: .35, notes: bar('G2 . . . D3 . . . | A2 . . . E3 . . . | D3 . . . A2 . . . | G2 . D3 . G2 . . .', 2) } ] },\n  festival: { bpm: 112, steps: 4, name: 'The Gentle Games: A Fanfare, Quietly', tracks: [\n    { wave: 'pulse', vol: .13, notes: bar('C5 . C5 E5 G5 - E5 . | F5 . F5 A5 C6 - A5 . | G5 . G5 B5 D6 - B5 . | C6 - G5 - E5 - C5 .', 2) },\n    { wave: 'triangle', vol: .28, notes: bar('C3 . G3 . C3 . G3 . | F2 . C3 . F2 . C3 . | G2 . D3 . G2 . D3 . | C3 . G2 . C3 . . .', 2) },\n    { wave: 'drums', vol: .2, notes: bar('k . h . s . h . | k k h . s . h h', 4) } ] },\n  ending: { bpm: 58, steps: 4, name: 'That Is The Whole Job', tracks: [\n    { wave: 'sine', vol: .3, notes: bar('E5 - - - D5 - C5 - | A4 - - - - - G4 - | F4 - A4 - C5 - F5 - | E5 - - - - - - -', 2) + ' | ' + bar('E5 - G5 - E5 - D5 - | C5 - - - A4 - - - | B4 - D5 - G5 - F5 - | E5 - - - - - - -') },\n    { wave: 'triangle', vol: .24, notes: bar('A2 - E3 - C4 - E3 - | F2 - C3 - A3 - C3 - | D3 - A3 - F3 - A3 - | E3 - B3 - G#3 - B3 -', 3) } ] },\n  star1: { bpm: 150, steps: 4, loop: false, tracks: [{ wave: 'sine', vol: .5, notes: 'C5 E5 G5 - - .' }] },\n  star2: { bpm: 150, steps: 4, loop: false, tracks: [{ wave: 'sine', vol: .5, notes: 'C5 E5 G5 C6 - - .' }, { wave: 'triangle', vol: .3, notes: 'C4 . G4 . C5 - .' }] },\n  star3: { bpm: 170, steps: 4, loop: false, tracks: [{ wave: 'sine', vol: .5, notes: 'C5 E5 G5 C6 E6 G6 - - - .' }, { wave: 'triangle', vol: .3, notes: 'C4 . G4 . C5 . E5 - - .' }] },\n  unlock: { bpm: 140, steps: 4, loop: false, tracks: [{ wave: 'triangle', vol: .5, notes: 'G4 C5 E5 G5 - .' }] },\n  dayDone: { bpm: 90, steps: 4, loop: false, tracks: [{ wave: 'sine', vol: .5, notes: 'G5 - E5 - C5 - - - .' }, { wave: 'triangle', vol: .3, notes: 'C4 - - - C3 - - - .' }] }\n};\nG.music = (name, o) => { if (G.silent) return; const s = G.SONGS[name]; if (A._whyfit === name && !(o && o.restart)) return; A._whyfit = name; A.music(s, Object.assign({ fade: .6 }, o || {})); };\nG.stopMusic = () => { A._whyfit = null; A.stopMusic(.3); };\nG.sting = n => { try { A.sting(G.SONGS[n], { at: 'now' }); } catch (e) {} };\n\nconst defs = {\n  boop: [{ wave: 'sine', freq: 660, dur: .09, vol: .4 }, { wave: 'sine', freq: 990, dur: .12, vol: .4, delay: .1 }],\n  tareHop: { wave: 'sine', freq: 520, to: 780, dur: .08, vol: .25 },\n  creak: { wave: 'saw', freq: 90, to: 140, dur: .22, vol: .14, vib: [14, .08] },\n  chime: { wave: 'sine', freq: 880, dur: .3, vol: .22 },\n  stumble: { wave: 'triangle', freq: 300, to: 70, dur: .3, vol: .4 },\n  clink: { wave: 'triangle', freq: 1760, to: 2100, dur: .07, vol: .35 },\n  gull: { wave: 'saw', freq: 1200, to: 700, dur: .24, vol: .12, vib: [24, .1] },\n  flurry: { wave: 'noise', freq: 2600, dur: .28, vol: .16 },\n  flick: { wave: 'noise', freq: 4000, dur: .07, vol: .12 },\n  whirr: { wave: 'triangle', freq: 300, to: 360, dur: .1, vol: .14 },\n  carve: { wave: 'noise', freq: 1800, dur: .14, vol: .14 },\n  trayClink: { wave: 'triangle', freq: 2300, dur: .04, vol: .18 },\n  plop: { wave: 'sine', freq: 520, to: 180, dur: .13, vol: .4 },\n  rope: { wave: 'saw', freq: 140, to: 110, dur: .25, vol: .1, vib: [9, .1] },\n  stamp: { wave: 'noise', freq: 400, dur: .12, vol: .45 },\n  tick: { wave: 'sine', freq: 1100, dur: .035, vol: .14 },\n  pick: [{ wave: 'sine', freq: 740, dur: .06, vol: .25 }, { wave: 'sine', freq: 1110, dur: .09, vol: .25, delay: .06 }],\n  beat: { wave: 'sine', freq: 1500, dur: .03, vol: .32 },\n  beatUp: { wave: 'sine', freq: 2000, dur: .035, vol: .4 },\n  whoosh: { wave: 'noise', freq: 900, to: 300, dur: .35, vol: .14 },\n  firework: { wave: 'noise', freq: 1200, to: 200, dur: .3, vol: .12 },\n  blender: { wave: 'saw', freq: 240, to: 280, dur: .6, vol: .1, vib: [30, .12] },\n  goose: { wave: 'saw', freq: 340, to: 260, dur: .22, vol: .2, vib: [20, .05] },\n  sock: { wave: 'noise', freq: 2000, dur: .2, vol: .1 },\n  splash: { wave: 'noise', freq: 800, to: 300, dur: .3, vol: .2 }\n};\nfor (const k in defs) A.define(k, defs[k]);\n\n// Voices: Animalese-style gibberish, a sound per letter, on the voice bus.\nconst VOICES = { TARE: { base: 620, speed: 1.3, wave: 'sine', vib: 8 }, BIRCH: { base: 105, speed: .75, wave: 'triangle', vib: 0 }, ALDER: { base: 240, speed: 1.05, wave: 'sine', vib: 2 } };\nconst lf = 'abcdefghijklmnopqrstuvwxyz', vowels = 'aeiou';\nG.babble = (name, ch, o = {}) => {\n  const ctx = (o.ctx || A.ctx); if (!ctx) return false;\n  const c = String(ch).toLowerCase(), idx = lf.indexOf(c); if (idx < 0 && !/[0-9]/.test(c)) return false;\n  const key = String(name || 'TARE').toUpperCase(); let V = VOICES[key];\n  if (!V) { for (const id in G.CAST) if (G.CAST[id].name.toUpperCase() === key) V = G.CAST[id].voice; }\n  V = V || VOICES.TARE;\n  const vowel = vowels.includes(c), n = idx < 0 ? 6 : idx, f = V.base * Math.pow(2, ((n * 7) % 12 - 5) / 18), dur = (vowel ? .09 : .06) / (V.speed || 1), t = ctx.currentTime + (o.at || 0);\n  const os = ctx.createOscillator(), fl = ctx.createBiquadFilter(), g = ctx.createGain();\n  os.type = V.wave || 'sine'; os.frequency.setValueAtTime(f, t); os.frequency.linearRampToValueAtTime(f * (vowel ? .96 : 1.06), t + dur);\n  if (V.vib) { const lfo = ctx.createOscillator(), lg = ctx.createGain(); lfo.frequency.value = 22; lg.gain.value = V.vib; lfo.connect(lg); lg.connect(os.frequency); lfo.start(t); lfo.stop(t + dur); }\n  fl.type = 'bandpass'; fl.frequency.value = vowel ? f * 2.2 : f * 3.4; fl.Q.value = vowel ? 1.2 : 2.4;\n  g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(.34, t + .008); g.gain.exponentialRampToValueAtTime(.001, t + dur);\n  os.connect(fl); fl.connect(g); g.connect(o.dest || A.bus('voice')); os.start(t); os.stop(t + dur + .01);\n  return true;\n};\n// exercise grunts use the same voice\nG.grunt = (name = 'TARE') => { G.babble(name, 'u'); };\n// the Stork's second tier: a stereo tone, pan = lean x, pitch = lean y, on the sfx bus\nG.BalanceTone = class {\n  constructor() { this.os = null; }\n  start() { const c = A.ctx; if (!c || this.os) return; this.os = c.createOscillator(); this.g = c.createGain(); this.pan = c.createStereoPanner ? c.createStereoPanner() : null; this.os.type = 'sine'; this.g.gain.value = 0; this.os.connect(this.g); if (this.pan) { this.g.connect(this.pan); this.pan.connect(A.bus('sfx')); } else this.g.connect(A.bus('sfx')); this.os.start(); }\n  set(x, y, near) { if (!A.ctx) return; if (!this.os) this.start(); if (!this.os) return; const t = A.ctx.currentTime; this.os.frequency.setTargetAtTime(330 * Math.pow(2, y * .9), t, .03); this.g.gain.setTargetAtTime(.04 + .12 * near, t, .05); if (this.pan) this.pan.pan.setTargetAtTime(clamp(x * 1.2, -1, 1), t, .03); }\n  stop() { if (this.os) { try { this.os.stop(); } catch (e) {} this.os.disconnect(); this.g.disconnect(); if (this.pan) this.pan.disconnect(); this.os = null; } }\n};\nEOF\ncat > game/ui.js <<'EOF'\n// Canvas UI: bright and round. Pills on every screen, one prompt helper, the Plate, stars, the Card and Results.\nconst INK = '#20404c', ACC = '#2cc6e6', ACCD = '#14a8c8', PAPER = '#f6fafa', MUT = '#5f7f8a', MINT = '#bfeee0', CORAL = '#ff7a59';\nG.COL = { INK, ACC, ACCD, PAPER, MUT, MINT, CORAL };\nG.round = (g, x, y, w, h, c, rad) => { x = Math.round(x); y = Math.round(y); w = Math.round(w); h = Math.round(h); const R = Math.min(rad === undefined ? Math.floor(h / 2) : rad, Math.floor(h / 2), Math.floor(w / 2));\n  px.rect(g, x + R, y, w - R * 2, h, c); px.rect(g, x, y + R, w, h - R * 2, c);\n  for (const [a, b] of [[x + R, y + R], [x + w - R - 1, y + R], [x + R, y + h - R - 1], [x + w - R - 1, y + h - R - 1]]) px.disc(g, a, b, R, c); };\nG.panel = (g, x, y, w, h, o = {}) => { G.round(g, x + 1, y + 2, w, h, o.shadow || '#b9cfd6', o.rad === undefined ? 8 : o.rad); G.round(g, x, y, w, h, o.c || '#ffffff', o.rad === undefined ? 8 : o.rad); };\nG.text = (g, s, x, y, c = INK, o = {}) => E.font.text(g, s, Math.round(x), Math.round(y), c, Object.assign({ outline: false }, o));\nG.wrapText = (g, s, x, y, w, c = INK, o = {}) => { const lines = E.font.wrap(s, w, o), lh = E.font.lineHeight(o) + (o.gap === undefined ? 2 : o.gap); lines.forEach((l, i) => G.text(g, l, x, y + i * lh, c, o)); return lines.length * lh; };\n\nG.Pills = class {\n  constructor(items, o = {}) { this.items = items; this.o = Object.assign({ dir: 'v', scale: 1, pad: 12, gap: 4, h: 18 }, o); this.i = o.start || 0; this.mt = -1; this.grow = items.map(() => 0); while (this.items[this.i] && this.items[this.i].disabled && this.i < items.length - 1) this.i++; this.t = 0; }\n  widths() { const o = this.o; return this.items.map(it => o.w || (E.font.width(it.label, { scale: o.scale }) + o.pad * 2 + (it.sub ? 0 : 0))); }\n  rect(i) {\n    const o = this.o, W = G.game.W, H = G.game.H, ws = this.widths(), h = o.h * o.scale;\n    if (o.dir === 'h') { const total = ws.reduce((a, b) => a + b + o.gap, -o.gap), ax = typeof o.x === 'function' ? o.x(W, H, total) : (o.x === undefined ? (W - total) / 2 : o.x), ay = typeof o.y === 'function' ? o.y(W, H) : (o.y === undefined ? H - h - 22 : o.y); let x = ax; for (let k = 0; k < i; k++) x += ws[k] + o.gap; return [x, ay, ws[i], h]; }\n    const mw = Math.max(...ws), total = this.items.length * (h + o.gap) - o.gap, ax = typeof o.x === 'function' ? o.x(W, H, mw) : (o.x === undefined ? (W - mw) / 2 : o.x), ay = typeof o.y === 'function' ? o.y(W, H, total) : (o.y === undefined ? (H - total) / 2 : o.y);\n    return [ax, ay + i * (h + o.gap), mw, h];\n  }\n  hit(p) { for (let i = 0; i < this.items.length; i++) { const [x, y, w, h] = this.rect(i); if (p[0] >= x && p[0] < x + w && p[1] >= y && p[1] < y + h) return i; } return -1; }\n  move(d) { let n = this.i; for (let k = 0; k < this.items.length; k++) { n = (n + d + this.items.length) % this.items.length; if (!this.items[n].disabled) break; } if (n !== this.i) { this.i = n; G.sfx('tick'); } }\n  pick() { const it = this.items[this.i]; if (!it || it.disabled) { G.sfx('cancel', { vol: .2 }); return; } G.sfx('pick'); if (it.on) it.on(it, this.i); if (this.o.onPick) this.o.onPick(it, this.i); }\n  update(dt, I = G.game.input) {\n    this.t += dt; const o = this.o, back = o.dir === 'h' ? 'left' : 'up', fwd = o.dir === 'h' ? 'right' : 'down';\n    if (I.repeat(back, .35, .14)) this.move(-1); if (I.repeat(fwd, .35, .14)) this.move(1);\n    if (o.cross) { if (I.repeat(o.dir === 'h' ? 'up' : 'left', .35, .14)) this.move(-1); if (I.repeat(o.dir === 'h' ? 'down' : 'right', .35, .14)) this.move(1); }\n    const M = I.mouse, p = I.pointer && I.pointer();\n    if (M && p && M.t !== this.mt) { this.mt = M.t; const h = this.hit(p); if (h >= 0 && !this.items[h].disabled && h !== this.i) { this.i = h; G.sfx('tick'); } }\n    const c = I.clicked && I.clicked();\n    if (c) { const h = this.hit(c); if (h >= 0) { this.i = h; this.pick(); return; } }\n    if (I.pressed('confirm')) { this.pick(); return; }\n    if (I.pressed('cancel') && o.onBack) { G.sfx('cancel', { vol: .2 }); o.onBack(); }\n    this.grow = this.grow.map((v, i) => v + ((i === this.i ? 1 : 0) - v) * Math.min(1, dt * 14));\n  }\n  draw(g) {\n    const o = this.o;\n    this.items.forEach((it, i) => { const [x, y, w, h] = this.rect(i), k = Math.round((this.grow[i] || 0) * 2), f = i === this.i;\n      G.round(g, x - k + 1, y - k + 2, w + k * 2, h + k * 2, '#9db8c1'); G.round(g, x - k, y - k, w + k * 2, h + k * 2, it.disabled ? '#dfe7ea' : f ? ACC : '#ffffff');\n      const c = it.disabled ? '#90a4ac' : f ? '#ffffff' : INK, ly = y + Math.round((h - 7 * o.scale) / 2);\n      G.text(g, it.label, x + w / 2, ly, c, { align: 'center', scale: o.scale });\n      if (it.mark) G.text(g, it.mark, x + w - 11, ly, f ? '#fff' : ACCD, {});\n      if (it.check) px.rect(g, x + 5, ly + 2, 3, 3, f ? '#fff' : ACC); });\n  }\n};\n\n// Prompts: only here, showing what the player used last.\nconst CONFIRM = { confirm: 'Enter / Click', cancel: 'Esc / Right click', pause: 'Esc' };\nG.promptLabel = (a, I = G.game.input) => {\n  if (G.source(I) === 'pad' || I.lastDevice === 'gamepad') return I.label(a, 'gamepad');\n  if (CONFIRM[a]) return CONFIRM[a];\n  const k = I.label(a, 'keyboard'), m = I.label(a, 'mouse'); return m && m !== k && /click|wheel|button/i.test(m) ? k + ' / ' + m : k;\n};\nG.leanLabel = (I = G.game.input) => ({ pad: 'Left stick', keys: 'WASD', mouse: 'Move the mouse' })[G.source(I)];\nG.prompt = (r, list, o = {}) => r.overlay(g => { // list: [[action or special, verb]]\n  let x = r.W - 8; const y = (o.y === undefined ? r.H - 15 : o.y);\n  for (let n = list.length - 1; n >= 0; n--) { const [a, v] = list[n], lab = a === 'lean' ? G.leanLabel() : G.promptLabel(a), s = lab + '  ' + v, w = E.font.width(s) + 10; x -= w; G.round(g, x + 1, y + 1, w, 12, '#9db8c1'); G.round(g, x, y, w, 12, '#ffffff'); G.text(g, lab, x + 5, y + 3, ACCD); G.text(g, v, x + 5 + E.font.width(lab + '  '), y + 3, INK); x -= 4; }\n});\n\n// The Plate: the game's signature. A white disc, the ring, the dot, a fading trail.\nG.drawPlate = (g, bal, x, y, R = 26, o = {}) => {\n  const wob = bal.lean > .75; px.disc(g, x + 1, y + 2, R + 1, '#9db8c1'); px.disc(g, x, y, R, '#ffffff'); px.disc(g, x, y, R - 2, wob ? '#ffeee8' : '#f2f8fa');\n  px.rect(g, x - R + 3, y, R * 2 - 6, 1, '#dbe7ea'); px.rect(g, x, y - R + 3, 1, R * 2 - 6, '#dbe7ea');\n  const rx = x + bal.ringX * R, ry = y - bal.ringY * R, rr = Math.max(3, bal.R * R), inR = bal.inRing;\n  const N = 28; for (let i = 0; i < N; i++) { const a = i / N * 6.283; if (!inR && i % 2) continue; px.rect(g, rx + Math.cos(a) * rr, ry + Math.sin(a) * rr, inR ? 2 : 1, inR ? 2 : 1, inR ? '#37cfa6' : ACCD); }\n  if (inR) { for (let i = 0; i < N; i++) { const a = i / N * 6.283 + (o.t || 0); px.rect(g, rx + Math.cos(a) * (rr + 1), ry + Math.sin(a) * (rr + 1), 1, 1, MINT); } }\n  const t = bal.trail, n = t.length / 2; for (let i = 0; i < n; i++) { const a = i / n; if (a < .2) continue; const c = E.mix('#f2f8fa', CORAL, a * .8); px.rect(g, x + t[i * 2] * R, y - t[i * 2 + 1] * R, 2, 2, c); }\n  const dx = x + bal.px * R, dy = y - bal.py * R; px.disc(g, dx, dy, 3, bal.stumbleT > 0 ? '#e0553a' : CORAL); px.disc(g, dx - 1, dy - 1, 1, '#ffd2c4');\n};\n\nG.starSprite = (g, x, y, on, s = 1, k = 1) => { const R = 6 * s * k, c = on ? '#f5c84b' : '#dbe6ea', d = on ? '#c99a1e' : '#b7c7cd', pts = (rr, ro) => { const o = []; for (let i = 0; i < 10; i++) { const a = -Math.PI / 2 + i * Math.PI / 5, q = i % 2 ? rr * .45 : rr; o.push([x + Math.cos(a) * q, y + Math.sin(a) * q + ro]); } return o; }; px.poly(g, pts(R, 1), d); px.poly(g, pts(R, 0), c); };\nG.starsFor = (def, pct) => { const s = def.stars, D = G.DEV; return pct >= s[2] * D.star3 ? 3 : pct >= s[1] * D.star2 ? 2 : pct >= s[0] * D.star1 ? 1 : 0; };\n\n// a one-line HUD strip for an activity\nG.hudTop = (g, r, left, right) => { if (left) { const w = E.font.width(left) + 12; G.round(g, 8, 8, w, 14, 'rgba(255,255,255,.92)'); G.text(g, left, 14, 12); } if (right) { const w = E.font.width(right) + 12, cx = r.W / 2 - w / 2; G.round(g, cx, 8, w, 14, '#ffffff'); G.text(g, right, cx + 6, 12); } };\nG.fmtT = s => { s = Math.max(0, Math.ceil(s)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };\n\n// Dialog ----------------------------------------------------------------------------------------------------------\nG.talk = new E.Dialog(game, { bg: ['#ffffff', '#eaf6f8'], border: '#2cc6e6', color: '#20404c', nameColor: '#14a8c8', voice: (ch, i, t) => { G.babble(t.name, ch); } });\nG.talk.shadow = null;\nG.speaker = who => {\n  if (who === 'tare') return { name: 'TARE', portrait: G.tarePortrait('neutral'), portraitSize: 32 };\n  if (who === 'birch' || who === 'alder') { G.iRigs = G.iRigs || {}; const rig = G.iRigs[who] = G.iRigs[who] || (() => { const q = G.instructorRig(who, 1.2); q.update(1 / 60, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: Math.PI / 2 }); return q; })(); return { name: who.toUpperCase(), portrait: rig, portraitSize: 32 }; }\n  if (G.CAST[who]) { G.rRigs = G.rRigs || {}; const rig = G.rRigs[who] = G.rRigs[who] || (() => { const q = G.regularRig(who, 1.2); q.update(1 / 60, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: Math.PI / 2 }); return q; })(); return { name: G.CAST[who].name.toUpperCase(), portrait: rig, portraitSize: 32 }; }\n  return { name: String(who).toUpperCase() };\n};\nG.say = (who, lines, o = {}) => { G.talkFace = o.face || null; G.talk.say(Array.isArray(lines) ? lines : [lines], Object.assign(G.speaker(who), o)); };\nG.chat = (who, line, secs = 3.2) => { if (G.silentChat) return; G.talkFace = null; G.talk.say(line, Object.assign(G.speaker(who), { auto: secs, modal: false, place: 'top' })); };\nG.coach = () => (G.state && G.state.instructor) || 'alder';\nG.coachLine = key => { const c = G.coach(), b = G.LINES[c][key]; return Array.isArray(b) ? G.pick(b) : b; };\n// a filled template line\nG.fill = (s, vars) => s.replace(/\\{(\\w+)\\}/g, (_, k) => vars[k]);\n\n// member card -----------------------------------------------------------------------------------------------------\nG.drawCard = (g, r, x, y, w, h, st, focused, o = {}) => {\n  G.panel(g, x, y, w, h, { c: focused ? '#eafaff' : '#ffffff', shadow: focused ? ACC : '#b9cfd6' });\n  if (!st) { G.text(g, o.empty || 'New Member', x + w / 2, y + h / 2 - 3, ACCD, { align: 'center' }); return; }\n  if (o.rig) { o.rig.drawPortrait(g, x + 6, y + 6, 34, { zoom: 2.4, bg: '#d8f3fb' }); }\n  G.text(g, st.name, x + 46, y + 8); G.text(g, 'Spine Age', x + 46, y + 22, MUT); G.text(g, String(st.age), x + 46 + E.font.width('Spine Age '), y + 22, CORAL); G.text(g, st.finished ? 'Stay complete' : 'Day ' + st.day, x + 46, y + 34, MUT);\n};\nEOF\n","description":"Write audio and UI modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12331,"cache_read_input_tokens":190224,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12331},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6a88ba50-da75-48c3-bde0-396ebfab72e9","uuid":"0bf696f7-e853-417d-88d4-56f39b095501","timestamp":"2026-11-05T05:25:31.791Z","request_id":"req_011CgjDqZHh6fJ5LxyrwyTv1","wire_tool_inputs":{"toolu_01P98E6AwAUjCjkRDBKJHeHf":{"command":"cat > game/audio.js <<'EOF'\n// All sound is written here. Hold music in a very clean building. Music defaults to 10% and is never compensated for.\nconst A = game.audio;\nG.sfx = (name, o) => { try { return A.sfx(name, o); } catch (e) { return null; } };\nconst bar = (s, n = 1) => Array(n).fill(s).join(' | ');\nG.SONGS = {\n  studio: { bpm: 78, steps: 4, name: 'Please Hold Your Posture', tracks: [\n    { wave: 'sine', vol: .28, gate: .9, name: 'lead', notes: bar('E5 - - - G5 - A5 - | G5 - - - E5 - D5 - | C5 - - - E5 - G5 - | A5 - G5 - E5 - - -', 2) },\n    { wave: 'triangle', vol: .26, name: 'bass', notes: bar('C3 - - - G3 - - - | A2 - - - E3 - - - | F2 - - - C3 - - - | G2 - - - D3 - - -', 2) },\n    { wave: 'pulse12', vol: .07, notes: bar('C4 E4 G4 E4 C4 E4 G4 E4 | A3 C4 E4 C4 A3 C4 E4 C4 | F3 A3 C4 A3 F3 A3 C4 A3 | G3 B3 D4 B3 G3 B3 D4 B3', 2) } ] },\n  morning: { bpm: 92, steps: 4, name: 'A Light Breakfast', tracks: [\n    { wave: 'triangle', vol: .24, notes: bar('G5 . E5 . C5 . E5 . | F5 . D5 . B4 . D5 . | E5 . C5 . A4 . C5 . | D5 - - - . . . .', 2) },\n    { wave: 'sine', vol: .28, notes: bar('C3 . . . G3 . . . | G2 . . . D3 . . . | A2 . . . E3 . . . | F2 . G2 . C3 . . .', 2) },\n    { wave: 'drums', vol: .1, notes: bar('h . . . h . . . | h . . . h . . .', 4) } ] },\n  dusk: { bpm: 66, steps: 4, name: 'The Institute Thanks You For Today', tracks: [\n    { wave: 'sine', vol: .28, notes: bar('A4 - - - C5 - - - | E5 - - - D5 - C5 - | G4 - - - B4 - - - | D5 - - - C5 - B4 -', 2) },\n    { wave: 'triangle', vol: .24, notes: bar('A2 - - - E3 - - - | F2 - - - C3 - - - | C3 - - - G3 - - - | G2 - - - D3 - - -', 2) } ] },\n  yoga: { bpm: 60, steps: 4, name: 'Pad For Holding Still', tracks: [\n    { wave: 'sine', vol: .3, notes: bar('C4 - - - - - - - | E4 - - - - - - - | D4 - - - - - - - | G3 - - - - - - -', 2) },\n    { wave: 'sine', vol: .18, notes: bar('G4 - - - - - - - | B4 - - - - - - - | A4 - - - - - - - | D4 - - - - - - -', 2) },\n    { wave: 'triangle', vol: .08, notes: bar('. . C6 . . . G5 . | . . E6 . . . B5 . | . . D6 . . . A5 . | . . G5 . . . D5 .', 2) } ] },\n  iron: { bpm: 96, steps: 4, name: 'Light Resistance', tracks: [\n    { wave: 'pulse', vol: .12, notes: bar('A3 . A3 . C4 . E4 . | G3 . G3 . B3 . D4 . | F3 . F3 . A3 . C4 . | E3 . G#3 . B3 . E4 .', 2) },\n    { wave: 'triangle', vol: .28, notes: bar('A2 . . . A2 . . . | G2 . . . G2 . . . | F2 . . . F2 . . . | E2 . . . E2 . . .', 2) },\n    { wave: 'drums', vol: .2, notes: bar('k . h . s . h . | k . h . s . h .', 4) } ] },\n  step1: { bpm: 100, steps: 4, loop: false, name: 'Step A: Up, And Down Again', tracks: [\n    { wave: 'triangle', vol: .3, notes: bar('C3 . C3 . G3 . C3 . | F2 . F2 . C3 . F2 . | G2 . G2 . D3 . G2 . | C3 . E3 . G3 . E3 .', 6) },\n    { wave: 'sine', vol: .26, notes: bar('E5 . G5 . C6 . G5 . | F5 . A5 . C6 . A5 . | D5 . G5 . B5 . G5 . | E5 . - . G5 . . .', 6) },\n    { wave: 'drums', vol: .2, notes: bar('k . h . s . h . | k . h . s . h .', 12) } ] },\n  step2: { bpm: 120, steps: 4, loop: false, name: 'Step B: With Enthusiasm', tracks: [\n    { wave: 'triangle', vol: .3, notes: bar('A2 . A3 . A2 . A3 . | F2 . F3 . F2 . F3 . | C3 . C4 . C3 . C4 . | G2 . G3 . G2 . G3 .', 8) },\n    { wave: 'pulse', vol: .11, notes: bar('E5 . A5 . C6 . A5 . | F5 . A5 . C6 . F5 . | G5 . C6 . E6 . C6 . | G5 . B5 . D6 . B5 .', 8) },\n    { wave: 'drums', vol: .22, notes: bar('k h h h s h h h | k h k h s h h h', 16) } ] },\n  jog: { bpm: 90, steps: 4, name: 'Coast Road, Moderate Pace', tracks: [\n    { wave: 'triangle', vol: .24, notes: bar('D5 . F#5 . A5 . F#5 . | E5 . G5 . B5 . G5 . | F#5 . A5 . D6 . A5 . | E5 - - - . . . .', 2) },\n    { wave: 'sine', vol: .28, notes: bar('D3 . D3 . A3 . D3 . | E3 . E3 . B3 . E3 . | D3 . D3 . A3 . D3 . | A2 . A2 . E3 . A2 .', 2) },\n    { wave: 'drums', vol: .15, notes: bar('k . h . k . h . | k . h . k . h .', 4) } ] },\n  ski: { bpm: 126, steps: 4, name: 'Mount Posture, Downhill', tracks: [\n    { wave: 'pulse', vol: .12, notes: bar('E5 G5 B5 G5 E5 G5 B5 G5 | C5 E5 G5 E5 C5 E5 G5 E5 | D5 F#5 A5 F#5 D5 F#5 A5 F#5 | B4 D5 F#5 D5 B4 D5 F#5 D5', 2) },\n    { wave: 'triangle', vol: .3, notes: bar('E2 . E3 . E2 . E3 . | C2 . C3 . C2 . C3 . | D2 . D3 . D2 . D3 . | B1 . B2 . B1 . B2 .', 2) },\n    { wave: 'drums', vol: .2, notes: bar('k . h . s . h h | k . h k s . h .', 4) } ] },\n  tray: { bpm: 84, steps: 4, name: 'Olive Lounge', tracks: [\n    { wave: 'sine', vol: .28, notes: bar('D5 - F5 . A5 - G5 . | F5 - - - D5 . . . | C5 - E5 . G5 - F5 . | E5 - - - C5 . . .', 2) },\n    { wave: 'triangle', vol: .26, notes: bar('D3 . A3 . D3 . A3 . | G2 . D3 . G2 . D3 . | C3 . G3 . C3 . G3 . | A2 . E3 . A2 . E3 .', 2) },\n    { wave: 'drums', vol: .08, notes: bar('h . h h . h . . | h . h h . h . .', 4) } ] },\n  laundry: { bpm: 104, steps: 4, name: 'Pizzicato For A Clothesline', tracks: [\n    { wave: 'triangle', vol: .3, gate: .25, notes: bar('G4 . B4 . D5 . B4 . | A4 . C5 . E5 . C5 . | F#4 . A4 . D5 . A4 . | G4 . . . D4 . . .', 2) },\n    { wave: 'sine', vol: .26, gate: .35, notes: bar('G2 . . . D3 . . . | A2 . . . E3 . . . | D3 . . . A2 . . . | G2 . D3 . G2 . . .', 2) } ] },\n  festival: { bpm: 112, steps: 4, name: 'The Gentle Games: A Fanfare, Quietly', tracks: [\n    { wave: 'pulse', vol: .13, notes: bar('C5 . C5 E5 G5 - E5 . | F5 . F5 A5 C6 - A5 . | G5 . G5 B5 D6 - B5 . | C6 - G5 - E5 - C5 .', 2) },\n    { wave: 'triangle', vol: .28, notes: bar('C3 . G3 . C3 . G3 . | F2 . C3 . F2 . C3 . | G2 . D3 . G2 . D3 . | C3 . G2 . C3 . . .', 2) },\n    { wave: 'drums', vol: .2, notes: bar('k . h . s . h . | k k h . s . h h', 4) } ] },\n  ending: { bpm: 58, steps: 4, name: 'That Is The Whole Job', tracks: [\n    { wave: 'sine', vol: .3, notes: bar('E5 - - - D5 - C5 - | A4 - - - - - G4 - | F4 - A4 - C5 - F5 - | E5 - - - - - - -', 2) + ' | ' + bar('E5 - G5 - E5 - D5 - | C5 - - - A4 - - - | B4 - D5 - G5 - F5 - | E5 - - - - - - -') },\n    { wave: 'triangle', vol: .24, notes: bar('A2 - E3 - C4 - E3 - | F2 - C3 - A3 - C3 - | D3 - A3 - F3 - A3 - | E3 - B3 - G#3 - B3 -', 3) } ] },\n  star1: { bpm: 150, steps: 4, loop: false, tracks: [{ wave: 'sine', vol: .5, notes: 'C5 E5 G5 - - .' }] },\n  star2: { bpm: 150, steps: 4, loop: false, tracks: [{ wave: 'sine', vol: .5, notes: 'C5 E5 G5 C6 - - .' }, { wave: 'triangle', vol: .3, notes: 'C4 . G4 . C5 - .' }] },\n  star3: { bpm: 170, steps: 4, loop: false, tracks: [{ wave: 'sine', vol: .5, notes: 'C5 E5 G5 C6 E6 G6 - - - .' }, { wave: 'triangle', vol: .3, notes: 'C4 . G4 . C5 . E5 - - .' }] },\n  unlock: { bpm: 140, steps: 4, loop: false, tracks: [{ wave: 'triangle', vol: .5, notes: 'G4 C5 E5 G5 - .' }] },\n  dayDone: { bpm: 90, steps: 4, loop: false, tracks: [{ wave: 'sine', vol: .5, notes: 'G5 - E5 - C5 - - - .' }, { wave: 'triangle', vol: .3, notes: 'C4 - - - C3 - - - .' }] }\n};\nG.music = (name, o) => { if (G.silent) return; const s = G.SONGS[name]; if (A._whyfit === name && !(o && o.restart)) return; A._whyfit = name; A.music(s, Object.assign({ fade: .6 }, o || {})); };\nG.stopMusic = () => { A._whyfit = null; A.stopMusic(.3); };\nG.sting = n => { try { A.sting(G.SONGS[n], { at: 'now' }); } catch (e) {} };\n\nconst defs = {\n  boop: [{ wave: 'sine', freq: 660, dur: .09, vol: .4 }, { wave: 'sine', freq: 990, dur: .12, vol: .4, delay: .1 }],\n  tareHop: { wave: 'sine', freq: 520, to: 780, dur: .08, vol: .25 },\n  creak: { wave: 'saw', freq: 90, to: 140, dur: .22, vol: .14, vib: [14, .08] },\n  chime: { wave: 'sine', freq: 880, dur: .3, vol: .22 },\n  stumble: { wave: 'triangle', freq: 300, to: 70, dur: .3, vol: .4 },\n  clink: { wave: 'triangle', freq: 1760, to: 2100, dur: .07, vol: .35 },\n  gull: { wave: 'saw', freq: 1200, to: 700, dur: .24, vol: .12, vib: [24, .1] },\n  flurry: { wave: 'noise', freq: 2600, dur: .28, vol: .16 },\n  flick: { wave: 'noise', freq: 4000, dur: .07, vol: .12 },\n  whirr: { wave: 'triangle', freq: 300, to: 360, dur: .1, vol: .14 },\n  carve: { wave: 'noise', freq: 1800, dur: .14, vol: .14 },\n  trayClink: { wave: 'triangle', freq: 2300, dur: .04, vol: .18 },\n  plop: { wave: 'sine', freq: 520, to: 180, dur: .13, vol: .4 },\n  rope: { wave: 'saw', freq: 140, to: 110, dur: .25, vol: .1, vib: [9, .1] },\n  stamp: { wave: 'noise', freq: 400, dur: .12, vol: .45 },\n  tick: { wave: 'sine', freq: 1100, dur: .035, vol: .14 },\n  pick: [{ wave: 'sine', freq: 740, dur: .06, vol: .25 }, { wave: 'sine', freq: 1110, dur: .09, vol: .25, delay: .06 }],\n  beat: { wave: 'sine', freq: 1500, dur: .03, vol: .32 },\n  beatUp: { wave: 'sine', freq: 2000, dur: .035, vol: .4 },\n  whoosh: { wave: 'noise', freq: 900, to: 300, dur: .35, vol: .14 },\n  firework: { wave: 'noise', freq: 1200, to: 200, dur: .3, vol: .12 },\n  blender: { wave: 'saw', freq: 240, to: 280, dur: .6, vol: .1, vib: [30, .12] },\n  goose: { wave: 'saw', freq: 340, to: 260, dur: .22, vol: .2, vib: [20, .05] },\n  sock: { wave: 'noise', freq: 2000, dur: .2, vol: .1 },\n  splash: { wave: 'noise', freq: 800, to: 300, dur: .3, vol: .2 }\n};\nfor (const k in defs) A.define(k, defs[k]);\n\n// Voices: Animalese-style gibberish, a sound per letter, on the voice bus.\nconst VOICES = { TARE: { base: 620, speed: 1.3, wave: 'sine', vib: 8 }, BIRCH: { base: 105, speed: .75, wave: 'triangle', vib: 0 }, ALDER: { base: 240, speed: 1.05, wave: 'sine', vib: 2 } };\nconst lf = 'abcdefghijklmnopqrstuvwxyz', vowels = 'aeiou';\nG.babble = (name, ch, o = {}) => {\n  const ctx = (o.ctx || A.ctx); if (!ctx) return false;\n  const c = String(ch).toLowerCase(), idx = lf.indexOf(c); if (idx < 0 && !/[0-9]/.test(c)) return false;\n  const key = String(name || 'TARE').toUpperCase(); let V = VOICES[key];\n  if (!V) { for (const id in G.CAST) if (G.CAST[id].name.toUpperCase() === key) V = G.CAST[id].voice; }\n  V = V || VOICES.TARE;\n  const vowel = vowels.includes(c), n = idx < 0 ? 6 : idx, f = V.base * Math.pow(2, ((n * 7) % 12 - 5) / 18), dur = (vowel ? .09 : .06) / (V.speed || 1), t = ctx.currentTime + (o.at || 0);\n  const os = ctx.createOscillator(), fl = ctx.createBiquadFilter(), g = ctx.createGain();\n  os.type = V.wave || 'sine'; os.frequency.setValueAtTime(f, t); os.frequency.linearRampToValueAtTime(f * (vowel ? .96 : 1.06), t + dur);\n  if (V.vib) { const lfo = ctx.createOscillator(), lg = ctx.createGain(); lfo.frequency.value = 22; lg.gain.value = V.vib; lfo.connect(lg); lg.connect(os.frequency); lfo.start(t); lfo.stop(t + dur); }\n  fl.type = 'bandpass'; fl.frequency.value = vowel ? f * 2.2 : f * 3.4; fl.Q.value = vowel ? 1.2 : 2.4;\n  g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(.34, t + .008); g.gain.exponentialRampToValueAtTime(.001, t + dur);\n  os.connect(fl); fl.connect(g); g.connect(o.dest || A.bus('voice')); os.start(t); os.stop(t + dur + .01);\n  return true;\n};\n// exercise grunts use the same voice\nG.grunt = (name = 'TARE') => { G.babble(name, 'u'); };\n// the Stork's second tier: a stereo tone, pan = lean x, pitch = lean y, on the sfx bus\nG.BalanceTone = class {\n  constructor() { this.os = null; }\n  start() { const c = A.ctx; if (!c || this.os) return; this.os = c.createOscillator(); this.g = c.createGain(); this.pan = c.createStereoPanner ? c.createStereoPanner() : null; this.os.type = 'sine'; this.g.gain.value = 0; this.os.connect(this.g); if (this.pan) { this.g.connect(this.pan); this.pan.connect(A.bus('sfx')); } else this.g.connect(A.bus('sfx')); this.os.start(); }\n  set(x, y, near) { if (!A.ctx) return; if (!this.os) this.start(); if (!this.os) return; const t = A.ctx.currentTime; this.os.frequency.setTargetAtTime(330 * Math.pow(2, y * .9), t, .03); this.g.gain.setTargetAtTime(.04 + .12 * near, t, .05); if (this.pan) this.pan.pan.setTargetAtTime(clamp(x * 1.2, -1, 1), t, .03); }\n  stop() { if (this.os) { try { this.os.stop(); } catch (e) {} this.os.disconnect(); this.g.disconnect(); if (this.pan) this.pan.disconnect(); this.os = null; } }\n};\nEOF\ncat > game/ui.js <<'EOF'\n// Canvas UI: bright and round. Pills on every screen, one prompt helper, the Plate, stars, the Card and Results.\nconst INK = '#20404c', ACC = '#2cc6e6', ACCD = '#14a8c8', PAPER = '#f6fafa', MUT = '#5f7f8a', MINT = '#bfeee0', CORAL = '#ff7a59';\nG.COL = { INK, ACC, ACCD, PAPER, MUT, MINT, CORAL };\nG.round = (g, x, y, w, h, c, rad) => { x = Math.round(x); y = Math.round(y); w = Math.round(w); h = Math.round(h); const R = Math.min(rad === undefined ? Math.floor(h / 2) : rad, Math.floor(h / 2), Math.floor(w / 2));\n  px.rect(g, x + R, y, w - R * 2, h, c); px.rect(g, x, y + R, w, h - R * 2, c);\n  for (const [a, b] of [[x + R, y + R], [x + w - R - 1, y + R], [x + R, y + h - R - 1], [x + w - R - 1, y + h - R - 1]]) px.disc(g, a, b, R, c); };\nG.panel = (g, x, y, w, h, o = {}) => { G.round(g, x + 1, y + 2, w, h, o.shadow || '#b9cfd6', o.rad === undefined ? 8 : o.rad); G.round(g, x, y, w, h, o.c || '#ffffff', o.rad === undefined ? 8 : o.rad); };\nG.text = (g, s, x, y, c = INK, o = {}) => E.font.text(g, s, Math.round(x), Math.round(y), c, Object.assign({ outline: false }, o));\nG.wrapText = (g, s, x, y, w, c = INK, o = {}) => { const lines = E.font.wrap(s, w, o), lh = E.font.lineHeight(o) + (o.gap === undefined ? 2 : o.gap); lines.forEach((l, i) => G.text(g, l, x, y + i * lh, c, o)); return lines.length * lh; };\n\nG.Pills = class {\n  constructor(items, o = {}) { this.items = items; this.o = Object.assign({ dir: 'v', scale: 1, pad: 12, gap: 4, h: 18 }, o); this.i = o.start || 0; this.mt = -1; this.grow = items.map(() => 0); while (this.items[this.i] && this.items[this.i].disabled && this.i < items.length - 1) this.i++; this.t = 0; }\n  widths() { const o = this.o; return this.items.map(it => o.w || (E.font.width(it.label, { scale: o.scale }) + o.pad * 2 + (it.sub ? 0 : 0))); }\n  rect(i) {\n    const o = this.o, W = G.game.W, H = G.game.H, ws = this.widths(), h = o.h * o.scale;\n    if (o.dir === 'h') { const total = ws.reduce((a, b) => a + b + o.gap, -o.gap), ax = typeof o.x === 'function' ? o.x(W, H, total) : (o.x === undefined ? (W - total) / 2 : o.x), ay = typeof o.y === 'function' ? o.y(W, H) : (o.y === undefined ? H - h - 22 : o.y); let x = ax; for (let k = 0; k < i; k++) x += ws[k] + o.gap; return [x, ay, ws[i], h]; }\n    const mw = Math.max(...ws), total = this.items.length * (h + o.gap) - o.gap, ax = typeof o.x === 'function' ? o.x(W, H, mw) : (o.x === undefined ? (W - mw) / 2 : o.x), ay = typeof o.y === 'function' ? o.y(W, H, total) : (o.y === undefined ? (H - total) / 2 : o.y);\n    return [ax, ay + i * (h + o.gap), mw, h];\n  }\n  hit(p) { for (let i = 0; i < this.items.length; i++) { const [x, y, w, h] = this.rect(i); if (p[0] >= x && p[0] < x + w && p[1] >= y && p[1] < y + h) return i; } return -1; }\n  move(d) { let n = this.i; for (let k = 0; k < this.items.length; k++) { n = (n + d + this.items.length) % this.items.length; if (!this.items[n].disabled) break; } if (n !== this.i) { this.i = n; G.sfx('tick'); } }\n  pick() { const it = this.items[this.i]; if (!it || it.disabled) { G.sfx('cancel', { vol: .2 }); return; } G.sfx('pick'); if (it.on) it.on(it, this.i); if (this.o.onPick) this.o.onPick(it, this.i); }\n  update(dt, I = G.game.input) {\n    this.t += dt; const o = this.o, back = o.dir === 'h' ? 'left' : 'up', fwd = o.dir === 'h' ? 'right' : 'down';\n    if (I.repeat(back, .35, .14)) this.move(-1); if (I.repeat(fwd, .35, .14)) this.move(1);\n    if (o.cross) { if (I.repeat(o.dir === 'h' ? 'up' : 'left', .35, .14)) this.move(-1); if (I.repeat(o.dir === 'h' ? 'down' : 'right', .35, .14)) this.move(1); }\n    const M = I.mouse, p = I.pointer && I.pointer();\n    if (M && p && M.t !== this.mt) { this.mt = M.t; const h = this.hit(p); if (h >= 0 && !this.items[h].disabled && h !== this.i) { this.i = h; G.sfx('tick'); } }\n    const c = I.clicked && I.clicked();\n    if (c) { const h = this.hit(c); if (h >= 0) { this.i = h; this.pick(); return; } }\n    if (I.pressed('confirm')) { this.pick(); return; }\n    if (I.pressed('cancel') && o.onBack) { G.sfx('cancel', { vol: .2 }); o.onBack(); }\n    this.grow = this.grow.map((v, i) => v + ((i === this.i ? 1 : 0) - v) * Math.min(1, dt * 14));\n  }\n  draw(g) {\n    const o = this.o;\n    this.items.forEach((it, i) => { const [x, y, w, h] = this.rect(i), k = Math.round((this.grow[i] || 0) * 2), f = i === this.i;\n      G.round(g, x - k + 1, y - k + 2, w + k * 2, h + k * 2, '#9db8c1'); G.round(g, x - k, y - k, w + k * 2, h + k * 2, it.disabled ? '#dfe7ea' : f ? ACC : '#ffffff');\n      const c = it.disabled ? '#90a4ac' : f ? '#ffffff' : INK, ly = y + Math.round((h - 7 * o.scale) / 2);\n      G.text(g, it.label, x + w / 2, ly, c, { align: 'center', scale: o.scale });\n      if (it.mark) G.text(g, it.mark, x + w - 11, ly, f ? '#fff' : ACCD, {});\n      if (it.check) px.rect(g, x + 5, ly + 2, 3, 3, f ? '#fff' : ACC); });\n  }\n};\n\n// Prompts: only here, showing what the player used last.\nconst CONFIRM = { confirm: 'Enter / Click', cancel: 'Esc / Right click', pause: 'Esc' };\nG.promptLabel = (a, I = G.game.input) => {\n  if (G.source(I) === 'pad' || I.lastDevice === 'gamepad') return I.label(a, 'gamepad');\n  if (CONFIRM[a]) return CONFIRM[a];\n  const k = I.label(a, 'keyboard'), m = I.label(a, 'mouse'); return m && m !== k && /click|wheel|button/i.test(m) ? k + ' / ' + m : k;\n};\nG.leanLabel = (I = G.game.input) => ({ pad: 'Left stick', keys: 'WASD', mouse: 'Move the mouse' })[G.source(I)];\nG.prompt = (r, list, o = {}) => r.overlay(g => { // list: [[action or special, verb]]\n  let x = r.W - 8; const y = (o.y === undefined ? r.H - 15 : o.y);\n  for (let n = list.length - 1; n >= 0; n--) { const [a, v] = list[n], lab = a === 'lean' ? G.leanLabel() : G.promptLabel(a), s = lab + '  ' + v, w = E.font.width(s) + 10; x -= w; G.round(g, x + 1, y + 1, w, 12, '#9db8c1'); G.round(g, x, y, w, 12, '#ffffff'); G.text(g, lab, x + 5, y + 3, ACCD); G.text(g, v, x + 5 + E.font.width(lab + '  '), y + 3, INK); x -= 4; }\n});\n\n// The Plate: the game's signature. A white disc, the ring, the dot, a fading trail.\nG.drawPlate = (g, bal, x, y, R = 26, o = {}) => {\n  const wob = bal.lean > .75; px.disc(g, x + 1, y + 2, R + 1, '#9db8c1'); px.disc(g, x, y, R, '#ffffff'); px.disc(g, x, y, R - 2, wob ? '#ffeee8' : '#f2f8fa');\n  px.rect(g, x - R + 3, y, R * 2 - 6, 1, '#dbe7ea'); px.rect(g, x, y - R + 3, 1, R * 2 - 6, '#dbe7ea');\n  const rx = x + bal.ringX * R, ry = y - bal.ringY * R, rr = Math.max(3, bal.R * R), inR = bal.inRing;\n  const N = 28; for (let i = 0; i < N; i++) { const a = i / N * 6.283; if (!inR && i % 2) continue; px.rect(g, rx + Math.cos(a) * rr, ry + Math.sin(a) * rr, inR ? 2 : 1, inR ? 2 : 1, inR ? '#37cfa6' : ACCD); }\n  if (inR) { for (let i = 0; i < N; i++) { const a = i / N * 6.283 + (o.t || 0); px.rect(g, rx + Math.cos(a) * (rr + 1), ry + Math.sin(a) * (rr + 1), 1, 1, MINT); } }\n  const t = bal.trail, n = t.length / 2; for (let i = 0; i < n; i++) { const a = i / n; if (a < .2) continue; const c = E.mix('#f2f8fa', CORAL, a * .8); px.rect(g, x + t[i * 2] * R, y - t[i * 2 + 1] * R, 2, 2, c); }\n  const dx = x + bal.px * R, dy = y - bal.py * R; px.disc(g, dx, dy, 3, bal.stumbleT > 0 ? '#e0553a' : CORAL); px.disc(g, dx - 1, dy - 1, 1, '#ffd2c4');\n};\n\nG.starSprite = (g, x, y, on, s = 1, k = 1) => { const R = 6 * s * k, c = on ? '#f5c84b' : '#dbe6ea', d = on ? '#c99a1e' : '#b7c7cd', pts = (rr, ro) => { const o = []; for (let i = 0; i < 10; i++) { const a = -Math.PI / 2 + i * Math.PI / 5, q = i % 2 ? rr * .45 : rr; o.push([x + Math.cos(a) * q, y + Math.sin(a) * q + ro]); } return o; }; px.poly(g, pts(R, 1), d); px.poly(g, pts(R, 0), c); };\nG.starsFor = (def, pct) => { const s = def.stars, D = G.DEV; return pct >= s[2] * D.star3 ? 3 : pct >= s[1] * D.star2 ? 2 : pct >= s[0] * D.star1 ? 1 : 0; };\n\n// a one-line HUD strip for an activity\nG.hudTop = (g, r, left, right) => { if (left) { const w = E.font.width(left) + 12; G.round(g, 8, 8, w, 14, 'rgba(255,255,255,.92)'); G.text(g, left, 14, 12); } if (right) { const w = E.font.width(right) + 12, cx = r.W / 2 - w / 2; G.round(g, cx, 8, w, 14, '#ffffff'); G.text(g, right, cx + 6, 12); } };\nG.fmtT = s => { s = Math.max(0, Math.ceil(s)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };\n\n// Dialog ----------------------------------------------------------------------------------------------------------\nG.talk = new E.Dialog(game, { bg: ['#ffffff', '#eaf6f8'], border: '#2cc6e6', color: '#20404c', nameColor: '#14a8c8', voice: (ch, i, t) => { G.babble(t.name, ch); } });\nG.talk.shadow = null;\nG.speaker = who => {\n  if (who === 'tare') return { name: 'TARE', portrait: G.tarePortrait('neutral'), portraitSize: 32 };\n  if (who === 'birch' || who === 'alder') { G.iRigs = G.iRigs || {}; const rig = G.iRigs[who] = G.iRigs[who] || (() => { const q = G.instructorRig(who, 1.2); q.update(1 / 60, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: Math.PI / 2 }); return q; })(); return { name: who.toUpperCase(), portrait: rig, portraitSize: 32 }; }\n  if (G.CAST[who]) { G.rRigs = G.rRigs || {}; const rig = G.rRigs[who] = G.rRigs[who] || (() => { const q = G.regularRig(who, 1.2); q.update(1 / 60, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: Math.PI / 2 }); return q; })(); return { name: G.CAST[who].name.toUpperCase(), portrait: rig, portraitSize: 32 }; }\n  return { name: String(who).toUpperCase() };\n};\nG.say = (who, lines, o = {}) => { G.talkFace = o.face || null; G.talk.say(Array.isArray(lines) ? lines : [lines], Object.assign(G.speaker(who), o)); };\nG.chat = (who, line, secs = 3.2) => { if (G.silentChat) return; G.talkFace = null; G.talk.say(line, Object.assign(G.speaker(who), { auto: secs, modal: false, place: 'top' })); };\nG.coach = () => (G.state && G.state.instructor) || 'alder';\nG.coachLine = key => { const c = G.coach(), b = G.LINES[c][key]; return Array.isArray(b) ? G.pick(b) : b; };\n// a filled template line\nG.fill = (s, vars) => s.replace(/\\{(\\w+)\\}/g, (_, k) => vars[k]);\n\n// member card -----------------------------------------------------------------------------------------------------\nG.drawCard = (g, r, x, y, w, h, st, focused, o = {}) => {\n  G.panel(g, x, y, w, h, { c: focused ? '#eafaff' : '#ffffff', shadow: focused ? ACC : '#b9cfd6' });\n  if (!st) { G.text(g, o.empty || 'New Member', x + w / 2, y + h / 2 - 3, ACCD, { align: 'center' }); return; }\n  if (o.rig) { o.rig.drawPortrait(g, x + 6, y + 6, 34, { zoom: 2.4, bg: '#d8f3fb' }); }\n  G.text(g, st.name, x + 46, y + 8); G.text(g, 'Spine Age', x + 46, y + 22, MUT); G.text(g, String(st.age), x + 46 + E.font.width('Spine Age '), y + 22, CORAL); G.text(g, st.finished ? 'Stay complete' : 'Day ' + st.day, x + 46, y + 34, MUT);\n};\nEOF\n","description":"Write audio and UI modules"}}}
