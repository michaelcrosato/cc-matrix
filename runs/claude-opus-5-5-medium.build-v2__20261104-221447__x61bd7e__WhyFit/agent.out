| slot.size, {});\")\nopen(p,'w').write(s)\np='game/scenes/round.js';s=open(p).read()\ns=s.replace(\"rig: G.lookToRig(look, mine.size, {}) }]\",\"rig: G.lookToRig(look, G.acts[id].rigSize || mine.size, {}) }]\")\nopen(p,'w').write(s)\np='game/scenes/attract.js';s=open(p).read()\ns=s.replace(\"{ jog: 1.6, slalom: 1.2, laundry: 1.3 }[it.id]\",\"G.acts[it.id].rigSize\")\nopen(p,'w').write(s)\nEOF\nnode build.mjs\nSHOT='G.ensureMember();const g=G.game;'\npython3 tests/shot.py tests/shots \"body=#act/stork/0|G.state.ages=[71,66];G.game.go(\\\"bodycheck\\\",undefined,{fade:0})\" \"age=#act/stork/0|(()=>{G.state.ages=[71,66,60];G.state.best.stork={0:{pct:.9,stars:3}};G.state.best.squat={0:{pct:.7,stars:2}};G.game.go(\\\"bodycheck\\\",{},{fade:0});setTimeout(()=>{const s=G.game.scene;s.toAge()},500)})()\" \"evening=#act/stork/0|G.state.ages=[71,66];G.game.go(\\\"evening\\\",undefined,{fade:0})\" \"ending=#act/stork/0|G.game.go(\\\"ending\\\",undefined,{fade:0})\" \"about=|G.game.go(\\\"about\\\",undefined,{fade:0})\" \"dev=#act/stork/0|(()=>{G.Dev.open()})()\" \"attract=|G.Attract.start()\" \"duel=#act/stork/0|(()=>{G.game.go(\\\"act_candle\\\",{mode:\\\"games\\\",duel:true,festival:true,seed:3,skipCard:true,slots:[{x:-56,y:0,size:1.9}],onDone(){}},{fade:0})})()\" \"member=|G.game.go(\\\"member\\\",{mode:\\\"new\\\"},{fade:0})\" \"class=|G.game.go(\\\"classroom\\\",undefined,{fade:0})\" 2>&1 | tail -11; cd tests/shots; magick body.png age.png +append -resize 1600x r1.png; magick evening.png ending.png +append -resize 1600x r2.png; magick about.png dev.png +append -resize 1600x r3.png; magick r1.png r2.png r3.png -append m3.png; magick attract.png duel.png +append -resize 1600x r1.png; magick member.png class.png +append -resize 1600x r2.png; magick r1.png r2.png -append m4.png; cd ../..","description":"Apply polish and screenshot the non-activity scenes","timeout":200000}}}
