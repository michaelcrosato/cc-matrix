{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FJs6MeSak95pouR2eerXDg","type":"tool_result","content":"cactus-medium-a,cactus-medium-b,pot-large,bench,bed-double-a,lantern-glass {\"shapes\":[\"whyfit:cactus-medium-a\",\"whyfit:cactus-medium-b\",\"whyfit:pot-large\",\"whyfit:bench\",\"whyfit:bed-double-a\",\"whyfit:lantern-glass\"],\"materials\":[\"whyfit:clay-c\",\"whyfit:clay-b\",\"whyfit:shrub\",\"whyfit:shrub-d\",\"whyfit:shrub-e\",\"whyfit:shrub-b\",\"whyfit:shrub-c\",\"whyfit:needles\",\"whyfit:shrub-","is_error":false}]},"parent_tool_use_id":null,"session_id":"6a88ba50-da75-48c3-bde0-396ebfab72e9","uuid":"f7800a34-b737-4cee-88b3-17296a4ea42c","timestamp":"2026-11-05T05:31:53.103Z","tool_use_result":{"stdout":"cactus-medium-a,cactus-medium-b,pot-large,bench,bed-double-a,lantern-glass {\"shapes\":[\"whyfit:cactus-medium-a\",\"whyfit:cactus-medium-b\",\"whyfit:pot-large\",\"whyfit:bench\",\"whyfit:bed-double-a\",\"whyfit:lantern-glass\"],\"materials\":[\"whyfit:clay-c\",\"whyfit:clay-b\",\"whyfit:shrub\",\"whyfit:shrub-d\",\"whyfit:shrub-e\",\"whyfit:shrub-b\",\"whyfit:shrub-c\",\"whyfit:needles\",\"whyfit:shrub-","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FJs6MeSak95pouR2eerXDg","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjEW4jZF4VLUKgZxBWhB","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24878,"cache_read_input_tokens":240552,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24878},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6a88ba50-da75-48c3-bde0-396ebfab72e9","uuid":"3e10d641-f2c1-4de6-aaa5-a72b2d1b105c","timestamp":"2026-11-05T05:31:54.313Z","request_id":"req_011CgjEW4SwPfJTbZokPHQFu","thinking_duration_ms":242,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjEW4jZF4VLUKgZxBWhB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KYB53TMBaJJRKP1vdYrwFM","name":"Bash","input":{"command":"cat > game/activities/jog.js <<'EOF'\n// Coastal Jog: alternate your steps to set a cadence, stay in Marisol's zone, weave round pigeons, grab water. A lap of the coast road.\nconst jogSprite = { pigeon: { w: 90 }, jogger: { w: 180 }, cup: { w: 80 } };\nG.activity({ id: 'jog', family: 'jog', discipline: 'Cardio', name: 'Coastal Jog', tierName: 'A Narrower Zone', hub: true, noRig: false, coachKey: 'cardio', song: 'jog', noDemoLine: false,\n  says: \"Alternate your steps to keep Marisol's pace. Lean to steer. You may not sprint for long. Your side will say so.\",\n  controls: (src, lean, L) => [[L('paceL') + ', ' + L('paceR'), 'Left, right, left, right'], [lean, 'Steer']],\n  prompts: () => [['paceL', 'Left'], ['paceR', 'Right'], ['lean', 'Steer']],\n  setup(ctx) { const T = ctx.T, J = G.JOG, SEG = 200, road = ctx.road = new E.Road({ segment: SEG, lanes: 2, draw: 150, fog: null, colors: { road: ['#c9b48e', '#c2ac86'], grass: ['#7cc47e', '#6fba74'], rumble: ['#f6fafa', '#2cc6e6'], lane: '#efe3c8' }, sky: new E.Backdrop({ sky: ['#8fd3f4', '#d8f3fb'], layers: [{ kind: 'clouds', color: '#ffffff', y: .2, height: 22, parallax: .15, fill: false }, { kind: 'sea', color: '#49b6c9', y: .92, height: 30, parallax: 0 }] }) });\n    for (const [n, o] of J.road) road.add(n, o); ctx.lap = road.length; const R = E.rng(ctx.seed + 9);\n    const sprite = { draw(g, sx, sy, sc) { G.jogTree(g, sx, sy, sc); }, w: 300 }, bung = { draw(g, sx, sy, sc) { G.jogBungalow(g, sx, sy, sc); }, w: 900 }, bench = { draw(g, sx, sy, sc) { G.jogLou(g, sx, sy, sc); }, w: 500 }, pier = { draw(g, sx, sy, sc) { G.jogPier(g, sx, sy, sc); }, w: 1200 };\n    for (let z = 1000; z < ctx.lap - 1000; z += 900) { const side = R() < .5 ? -1 : 1; road.place(z, side * (1.6 + R() * 1.2), sprite); if (R() < .16) road.place(z + 300, -side * 2.6, bung); }\n    road.place(ctx.lap * .25, -1.55, bench); road.place(ctx.lap * .6, 2.6, pier); road.place(ctx.lap * .62, 2.6, pier);\n    ctx.items = []; const mul = T.obstacles;\n    for (let i = 0; i < J.cups; i++) ctx.items.push({ kind: 'cup', z: ctx.lap * (.05 + i / J.cups * .92), x: (R() - .5) * 1.4 });\n    for (let i = 0; i < J.pigeons * mul; i++) ctx.items.push({ kind: 'pigeon', z: ctx.lap * (.05 + R() * .92), x: (R() - .5) * 1.6 });\n    for (let i = 0; i < J.joggers * mul; i++) ctx.items.push({ kind: 'jogger', z: ctx.lap * (.05 + R() * .92), x: (R() - .5) * 1.6, v: 700, rig: null });\n    ctx.items.sort((a, b) => a.z - b.z); ctx.cupsTotal = J.cups; ctx.h = 900; ctx.ahead = road.ahead(ctx.h);\n    const c = ctx.local; c.s = { z: 0, x: 0, cad: 0, lastStep: -1, lastSide: 0, zone: 0, total: 0, cups: 0, stitch: 0, over: 0, hit: 0, turn: 0, bT: 0, steps: 0 }; c.bal = new G.Balance(G.SETS.plain, E.rng(ctx.seed + 1), { noFall: true, noGentle: true, stumbleAt: 9 }); ctx.time = 0; },\n  botFill(ctx, c, skill, dt) { const s = c.s, cfg = { poor: [2.4, .55, .5], average: [3, .2, .25], good: [3, .07, .1], expert: [3.05, .03, .04] }[skill]; s.bT -= dt; c.intent.paceL = c.intent.paceR = false; const R = s.R || (s.R = E.rng(ctx.seed + 44)); if (s.bT <= 0) { s.bT = 1 / (cfg[0] + (R() - .5) * cfg[1]); if (s.lastSide >= 0) c.intent.paceL = true; else c.intent.paceR = true; }\n    const pz = s.z, ahead = ctx.items.filter(q => !q.gone && q.z > pz && q.z < pz + 2400).slice(0, 4); let want = 0; for (const q of ahead) { if (q.kind === 'cup') { want = q.x; break; } } for (const q of ahead) if (q.kind !== 'cup' && Math.abs(q.x - want) < .3) want = q.x + (want >= q.x ? .45 : -.45); want += Math.sin(ctx.t * 1.2) * cfg[2]; c.intent.ux = clamp((want - s.x) * 1.8 + road_(ctx, s), -1, 1); c.intent.uy = 0; },\n  update(dt, ctx) { const c = ctx.local, s = c.s, i = c.intent, T = ctx.T, BD = G.DEV.jogBand, band = [T.band[0] * (2 - BD), T.band[1] * BD]; s.band = band;\n    c.bal.step(dt, i.ux, 0);\n    const stepped = (i.paceL && s.lastSide >= 0) ? -1 : (i.paceR && s.lastSide <= 0) ? 1 : 0;\n    if (stepped) { const gap = ctx.t - s.lastStep; if (s.lastStep >= 0 && gap > 0) { const r = 1 / gap; s.cad = s.cad * .55 + Math.min(8, r) * .45; } s.lastStep = ctx.t; s.lastSide = stepped; s.steps++; if (c.local) G.sfx('step', { vol: .12 }); }\n    if (ctx.t - s.lastStep > .5) s.cad = Math.max(0, s.cad - dt * 3);\n    if (s.cad > 4.2) s.over += dt; else s.over = Math.max(0, s.over - dt); if (s.over >= 2 && s.stitch <= 0) { s.stitch = 3; s.over = 0; ctx.say('tare', G.LINES.stitch, 3); G.sfx('stumble'); }\n    if (s.stitch > 0) s.stitch -= dt; if (s.hit > 0) s.hit -= dt;\n    const cad = s.stitch > 0 ? Math.min(s.cad, 1.5) : s.cad, v = s.hit > 0 ? 0 : cad * 476 * G.DEV.jogSpeed; s.v = v; const pz = s.z; s.z += v * dt;\n    s.total += dt; if (cad >= band[0] && cad <= band[1] && s.stitch <= 0) s.zone += dt;\n    const bend = ctx.road.curveAt(s.z); s.x += (c.bal.px * 1.25 - bend * (v / 1500) * .22) * dt; s.x = clamp(s.x, -1.15, 1.15); s.turn += bend * v * dt * .004;\n    for (const q of ctx.items) { if (q.gone) continue; if (q.v) q.mz = (q.mz || 0) + q.v * dt; const iz = q.z + (q.mz || 0); if (iz <= pz) continue; if (iz > s.z) continue; const hw = q.kind === 'cup' ? .28 : .17; if (Math.abs(q.x - s.x) < hw) { q.gone = true; if (q.kind === 'cup') { s.cups++; G.sfx('clink'); G.sfx('plop', { vol: .2 }); } else if (!ctx.cheat) { s.hit = .9; G.sfx(q.kind === 'pigeon' ? 'flurry' : 'stumble'); game.shake(1); } } else if (q.kind === 'pigeon') q.flown = 1.2; else q.mz = q.mz; }\n    if (s.z >= ctx.lap) ctx.done = true; if (ctx.t >= 105) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const c = ctx.local, s = c.s, rig = c.rig; s.run = (s.run || 0) + dt * Math.max(.0, (s.cad || 0)) * .28; rig.wob = [c.bal.px * .25, 0]; rig.body = null; rig.mocap = s.cad > .2 ? G.lib.sample(G.clip('Run_Loop'), s.run % G.clip('Run_Loop').dur) : G.sampleLoop('Idle_Subtle', ctx.time); G.place(rig, dt, 0, 0, 0, -Math.PI / 2); },\n  result(ctx, c) { const s = c.s, zone = s.total ? s.zone / Math.max(s.total, 30) : 0, cups = s.cups / ctx.cupsTotal; return { pct: (s.z >= ctx.lap || ctx.limit ? 1 : Math.min(1, s.z / ctx.lap)) * (.7 * zone + .3 * cups), detail: 'In the zone ' + Math.round(zone * 100) + '%. Cups ' + s.cups + ' of ' + ctx.cupsTotal + '.' }; },\n  draw(r, ctx) { const s = ctx.local.s, cz = Math.max(0, s.z - ctx.ahead); const cars = []; for (const q of ctx.items) { if (q.gone) continue; const iz = q.z + (q.mz || 0), d = iz - cz; if (d < 0 || d > 22000) continue; cars.push({ z: iz, x: q.x, w: jogSprite[q.kind].w, draw: (g, sx, sy, sc) => G.jogItem(g, q, sx, sy, sc) }); } const gh = G.jogGhosts ? G.jogGhosts(ctx) : []; ctx.road.draw(r, { z: cz, x: s.x, h: ctx.h, turn: s.turn, cars: cars.concat(gh) });\n    const rig = ctx.local.rig; r.overlay(g => { const by = r.H - 14, hob = s.hit > 0 ? 5 : 0; px.ell(g, r.W / 2, by + 1, 16, 4, '#5c6a55'); rig.draw(g, r.W / 2, by + hob, r.view); G.drawExtras(g, rig, r.W / 2, by + hob, r); }); },\n  hud(g, r, ctx) { const s = ctx.local.s, band = s.band || ctx.T.band; G.hudTop(g, r, 'Cups ' + s.cups, Math.round(Math.min(1, s.z / ctx.lap) * 100) + '% of the lap'); const x = 12, y = 34, w = 16, h = r.H - 80, hi = 5.2, v = Math.min(1, (s.cad || 0) / hi); G.round(g, x, y, w, h, '#ffffff', 6); const a = y + h - band[1] / hi * h, b = y + h - band[0] / hi * h; px.rect(g, x + 3, a, w - 6, b - a, '#bfeee0'); const sa = y + h - 4.2 / hi * h; px.rect(g, x + 3, y + 3, w - 6, Math.max(0, sa - y - 3), '#ffd9c8'); px.rect(g, x + 1, y + h - v * h - 1, w - 2, 3, s.stitch > 0 ? '#e0553a' : G.COL.INK); const label = s.stitch > 0 ? 'Stitch' : (s.cad || 0) > band[1] ? 'Too fast' : (s.cad || 0) < band[0] ? 'Too slow' : 'Marisol approves'; G.text(g, label, x + w + 6, y + h - 10, s.stitch > 0 ? '#e0553a' : '#fff', { shadow: '#20404c' }); },\n  ghost(ctx) { const s = ctx.local.s; return { p: s.z, w: [s.x, s.cad || 0], s: Math.round(Math.min(1, s.zone / Math.max(ctx.t, 1)) * 1000) }; }\n});\nconst road_ = (ctx, s) => ctx.road.curveAt(s.z) * .12;\nG.jogTree = (g, x, y, k) => { const w = 300 * k, h = 760 * k; px.rect(g, x - w * .08, y - h * .5, w * .16, h * .5, '#8a6a42'); px.ell(g, x, y - h * .72, w * .5, h * .3, '#3d9a60'); px.ell(g, x - w * .1, y - h * .8, w * .3, h * .18, '#55b878'); };\nG.jogBungalow = (g, x, y, k) => { const w = 900 * k, h = 500 * k; px.rect(g, x - w / 2, y - h, w, h, '#f6efe0'); px.poly(g, [[x - w * .6, y - h], [x + w * .6, y - h], [x, y - h * 1.6]], '#e0553a'); px.rect(g, x - w * .1, y - h * .6, w * .2, h * .6, '#2cc6e6'); };\nG.jogLou = (g, x, y, k) => { const w = 500 * k, h = 200 * k; px.rect(g, x - w / 2, y - h, w, h * .3, '#8a6a42'); px.rect(g, x - w * .45, y - h * .7, w * .1, h * .7, '#6a4a30'); px.rect(g, x + w * .35, y - h * .7, w * .1, h * .7, '#6a4a30'); px.rect(g, x - w * .3, y - h * 1.3, w * .55, h * .35, '#90a4a8'); px.disc(g, x + w * .32, y - h * 1.2, h * .22, '#e8c8a8'); };\nG.jogPier = (g, x, y, k) => { const w = 1200 * k, h = 300 * k; px.rect(g, x - w / 2, y - h, w, h * .18, '#b08f64'); for (let i = 0; i < 5; i++) px.rect(g, x - w / 2 + i * w / 4 - w * .02, y - h, w * .04, h, '#8a6a42'); };\nG.jogItem = (g, q, x, y, k) => {\n  if (q.kind === 'cup') { const w = 80 * k, h = 110 * k; px.rect(g, x - w / 2, y - h, w, h, '#ffffff'); px.rect(g, x - w / 2 + 1, y - h + 1, w - 2, Math.max(1, h * .3), '#2cc6e6'); px.ell(g, x, y + 1, w, w * .2, 'rgba(60,70,60,.25)'); }\n  else if (q.kind === 'pigeon') { const w = 70 * k, bob = Math.abs(Math.sin(G.game.real * 7 + q.z)) * 8 * k; px.ell(g, x, y - w * .5 - bob, w * .6, w * .4, '#8e99a8'); px.disc(g, x + w * .45, y - w * .9 - bob, w * .22, '#68727f'); px.rect(g, x + w * .6, y - w * .9 - bob, w * .15, Math.max(1, w * .08), '#d0602a'); }\n  else { const w = 150 * k, h = 460 * k, sw = Math.sin(G.game.real * 9 + q.z) * w * .14; const col = ['#c79be8', '#7bd389', '#f5c84b', '#5a7fe0'][Math.floor(q.z) % 4]; px.rect(g, x - w * .25 + sw, y - h * .35, w * .2, h * .35, '#20404c'); px.rect(g, x + w * .05 - sw, y - h * .35, w * .2, h * .35, '#20404c'); px.rect(g, x - w * .32, y - h * .8, w * .64, h * .47, col); px.disc(g, x, y - h * .92, w * .28, '#f0c8a0'); }\n};\nEOF\ncat > game/activities/slalom.js <<'EOF'\n// Mount Posture Slalom: lean left and right to steer, forward to tuck, back to brake. Gates, snowmen, pines, regret.\nconst SNOW = (x, y) => { const n = (Math.sin(x * .13) + Math.cos(y * .09) + Math.sin((x + y) * .05)) * 3; const line = ((x >> 3) & 15) === 0 && ((y >> 2) & 3) === 0 ? -8 : 0; const v = 240 + n + line; return [v - 6, v, 255]; };\nconst SNOWMAN = (g, sx, sy, k) => { const R = 6 * k; px.disc(g, sx, sy - R, R, '#f8fbff'); px.disc(g, sx, sy - R * 2.5, R * .7, '#ffffff'); px.rect(g, sx - 1 * k, sy - R * 2.8, Math.max(1, k), Math.max(1, k), '#20404c'); px.rect(g, sx + 1.5 * k, sy - R * 2.8, Math.max(1, k), Math.max(1, k), '#20404c'); px.rect(g, sx, sy - R * 2.5, 3 * k, Math.max(1, k), '#ff7a59'); };\nconst PINE = (g, sx, sy, k) => { const h = 34 * k, w = 12 * k; px.rect(g, sx - k, sy - 6 * k, 2 * k, 6 * k, '#6a4a30'); px.poly(g, [[sx - w, sy - 6 * k], [sx + w, sy - 6 * k], [sx, sy - h * .7]], '#2f7d58'); px.poly(g, [[sx - w * .8, sy - h * .45], [sx + w * .8, sy - h * .45], [sx, sy - h]], '#3d9a70'); px.poly(g, [[sx - w * .4, sy - h * .75], [sx + w * .4, sy - h * .75], [sx, sy - h]], '#e8f6ff'); };\nconst FLAG = (g, sx, sy, k, c, left) => { px.rect(g, sx, sy - 20 * k, Math.max(1, 1.2 * k), 20 * k, '#20404c'); px.poly(g, [[sx, sy - 20 * k], [sx + (left ? -9 : 9) * k, sy - 16 * k], [sx, sy - 12 * k]], c); };\nG.activity({ id: 'slalom', family: 'slalom', discipline: 'Balance', name: 'Mount Posture Slalom', tierName: 'Fog', hub: true, coachKey: 'games', song: 'ski', \n  says: 'Lean left and right to steer. Lean forward to tuck, back to brake. Go through the gates. You may not go round. It costs three seconds.',\n  controls: (src, lean) => [[lean, 'Steer, tuck, brake']],\n  prompts: () => [['lean', 'Steer, tuck, brake']],\n  setup(ctx) { const T = ctx.T, C = ctx.course = ctx.short ? G.COURSES.short : G.COURSES[T.course]; const s = ctx.local.s = { x: 0, y: 0, v: T.speed * .3, tumble: 0, misses: 0, passed: 0, angle: 0, tucking: 0, next: 0, time: 0, carve: 0, down: 0 };\n    ctx.gates = C.gates.map((x, i) => ({ x, y: -(i + 1) * C.spacing, hit: null })); ctx.end = -(C.gates.length + .6) * C.spacing; const R = E.rng(ctx.seed + 21); ctx.obst = []; for (let i = 0; i < C.obstacles; i++) { const gi = Math.floor(R() * (C.gates.length - 1)), y = ctx.gates[gi].y - C.spacing * (.35 + R() * .3), mid = (ctx.gates[gi].x + ctx.gates[gi + 1].x) / 2, side = R() < .5 ? -1 : 1, x = clamp(mid + side * (55 + R() * 70), -170, 170); ctx.obst.push({ x, y, kind: R() < .5 ? 'snowman' : 'pine' }); }\n    ctx.trees = []; for (let y = 0; y > ctx.end - 800; y -= 200) { ctx.trees.push({ x: -205 - R() * 90, y: y - R() * 90 }); ctx.trees.push({ x: 205 + R() * 90, y: y - R() * 90 }); }\n    ctx.m7 = new E.Mode7({ floor: SNOW, size: [512, 512], wrap: true, sky: ['#7fc8ee', '#e8f6ff'], far: 2200, fog: T.course === 'slalom2' && !ctx.short ? { color: '#eaf4f8', near: 350, far: 900 } : { color: '#dff2fb', near: 1200, far: 2200 } });\n    ctx.m7.cam = { x: 0, y: 60, h: 38, angle: -Math.PI / 2, pitch: 12, fov: 70 }; ctx.c = ctx.local; ctx.c.bal = new G.Balance(G.SETS.plain, E.rng(ctx.seed + 2), { noFall: true, noGentle: true, stumbleAt: 9 }); ctx.time = 0; ctx.camA = -Math.PI / 2; G.setWeather(ctx);\n    ctx.c.rig.body = null; },\n  enterView(ctx) { game.weather = { kind: 'snow', amount: .6, wind: .1 }; },\n  botFill(ctx, c, skill, dt) { const s = c.s, cfg = { poor: [38, .55, 0, .34], average: [22, .4, .1, .16], good: [11, .1, .6, .07], expert: [5, .04, .95, .03] }[skill], R = s.R || (s.R = E.rng(ctx.seed + 8)); const g = ctx.gates[s.next]; if (!g) { c.intent.ux = 0; c.intent.uy = .6; return; } if (g !== s.bg) { s.bg = g; s.err = (R() - .5) * 2 * cfg[0]; s.tuckOn = R() < cfg[2]; s.skip = R() < cfg[3] * .4; }\n    let want = g.x + s.err; if (s.skip) want = s.x; for (const o of ctx.obst) { const d = s.y - o.y; if (d > 0 && d < 240 && Math.abs(o.x - want * .4 - s.x * .6) < 24) want = o.x + (s.x > o.x ? 42 : -42); } const dx = want - s.x; c.intent.ux = clamp(dx / 55 + Math.sin(ctx.t * 2) * cfg[1] * .25, -1, 1); c.intent.uy = s.tuckOn && Math.abs(dx) < 50 ? .7 : 0; },\n  update(dt, ctx) { const c = ctx.local, s = c.s, T = ctx.T, i = c.intent, D = G.DEV; c.bal.step(dt, i.ux, i.uy); const lx = c.bal.px, ly = c.bal.py; s.time += dt;\n    if (s.tumble > 0) { s.tumble -= dt; s.v = Math.max(0, s.v - dt * 500); s.tucking = 0; }\n    else { const mul = ly > .3 ? 1.35 : ly < -.3 ? .6 : 1; s.tucking = ly > .3 ? 1 : 0; const want = T.speed * D.slalomSpeed * mul * (ctx.short ? 1.0 : 1); s.v += (want - s.v) * Math.min(1, dt * 2.2); const turn = 170 * D.slalomTurn * (ly > .3 ? .8 : 1); s.vx = lx * turn; s.x += s.vx * dt; s.x = clamp(s.x, -196, 196); if (Math.abs(lx) > .4) { s.carve -= dt; if (s.carve <= 0) { s.carve = .2; G.sfx('carve', { vol: .15 + Math.abs(lx) * .15, pan: lx }); game.particles && game.particles.add && 0; } } }\n    const py = s.y; s.y -= s.v * dt;\n    const g = ctx.gates[s.next]; if (g && s.y <= g.y) { const w = ctx.course.width; if (Math.abs(s.x - g.x) <= w) { g.hit = 'pass'; s.passed++; G.sfx('chime', { vol: .25, pitch: 1 + s.passed * .02 }); } else { g.hit = 'miss'; s.misses++; G.sfx('cancel', { vol: .3 }); s.flash = 1; ctx.say && 0; } s.next++; }\n    if (s.tumble <= 0 && !ctx.cheat) for (const o of ctx.obst) { if (py > o.y && s.y <= o.y && Math.abs(o.x - s.x) < 11) { s.tumble = 1.2; s.hits = (s.hits || 0) + 1; G.sfx('stumble'); game.shake(2); if (c.input && c.input.rumble) c.input.rumble(.8, .3); } }\n    if (s.flash > 0) s.flash -= dt; s.angle += ((-Math.PI / 2 + lx * .14) - (ctx.camA || 0)) * 0; ctx.camA += ((-Math.PI / 2 + lx * .12) - ctx.camA) * Math.min(1, dt * 4); ctx.m7.chase({ x: s.x, y: s.y, angle: ctx.camA }, { back: 60, h: 36 }); if (s.y <= ctx.end) { s.finished = true; ctx.done = true; } if (ctx.t > ctx.course.worst + 25) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const c = ctx.local, s = c.s, rig = c.rig, lx = c.bal.px; rig.wob = [lx * .7, Math.max(0, c.bal.py) * .4]; rig.mocap = s.tumble > 0 ? G.sampleLoop('Get_Up_From_Back', 1.2 - s.tumble) : null; rig.body = null; const st = { x: s.x, y: s.y, z: 0, vx: 0, vy: 0, facing: -Math.PI / 2 - (rig.spin || 0), pose: 'crouch' }; rig.update(dt, st); rig.px = s.x; rig.py = s.y; },\n  time(ctx, s) { return s.time + s.misses * 3; },\n  result(ctx, c) { const s = c.s, tm = this.time(ctx, s), C = ctx.course; const done = s.finished ? 1 : (s.passed + s.misses) / ctx.gates.length; return { pct: clamp((C.worst - tm) / (C.worst - C.par), 0, 1) * done, detail: 'Time ' + tm.toFixed(1) + ' s. Gates missed: ' + s.misses + '. ' + G.pick(G.LINES.raceTimes) }; },\n  draw(r, ctx) { const m7 = ctx.m7, s = ctx.local.s, st = s.y; m7.draw && 0; for (const q of ctx.trees) if (q.y < st + 120 && q.y > st - 1800) m7.add(q.x, q.y, 0, (g, sx, sy, k) => PINE(g, sx, sy, k * 1.5)); for (const o of ctx.obst) if (o.y < st + 100 && o.y > st - 1800) m7.add(o.x, o.y, 0, (g, sx, sy, k) => (o.kind === 'snowman' ? SNOWMAN : PINE)(g, sx, sy, k)); ctx.gates.forEach((q, i) => { if (q.y < st + 120 && q.y > st - 1800) { const w = ctx.course.width, c = q.hit === 'miss' ? '#a0a8ae' : i % 2 ? '#e0553a' : '#2c7ee6'; m7.add(q.x - w, q.y, 0, (g, sx, sy, k) => FLAG(g, sx, sy, k * 1.5, c, true)); m7.add(q.x + w, q.y, 0, (g, sx, sy, k) => FLAG(g, sx, sy, k * 1.5, c, false)); } });\n    const rig = ctx.local.rig; m7.rig(rig, s.x, s.y, 0); m7.add(s.x, s.y, 0, (g, sx, sy, k) => { const w = 9 * k, a = ctx.local.bal.px * 3 * k; px.rect(g, sx - w + a * .3, sy, w * .8, Math.max(1, k), '#20404c'); px.rect(g, sx + w * .2 + a * .3, sy, w * .8, Math.max(1, k), '#20404c'); }); if (G.drawGhosts7) G.drawGhosts7(m7, ctx); m7.draw(r); },\n  hud(g, r, ctx) { const s = ctx.local.s; G.hudTop(g, r, 'Gate ' + Math.min(s.next + 1, ctx.gates.length) + ' of ' + ctx.gates.length, this.time(ctx, s).toFixed(1) + ' s'); if (s.flash > 0) G.text(g, '+3 seconds', r.W / 2, 34, '#e0553a', { align: 'center', scale: 2, shadow: '#fff' }); if (s.tucking) G.text(g, 'Tuck', r.W / 2, r.H - 30, G.COL.ACCD, { align: 'center', shadow: '#fff' }); const x0 = 14, y0 = r.H - 40, W = 60; px.rect(g, x0, y0, W, 2, '#ffffff'); px.disc(g, x0 + clamp(s.y / ctx.end, 0, 1) * W, y0 + 1, 3, G.COL.CORAL); },\n  ghost(ctx) { const s = ctx.local.s; return { p: s.y, w: [s.x, 0], s: Math.round((s.passed || 0) / ctx.gates.length * 1000) }; }\n});\nG.setWeather = ctx => { if (!game.headless) game.weather = { kind: 'snow', amount: .6, wind: .1 }; };\nEOF\ncat > game/activities/tray.js <<'EOF'\n// Tray Service: lean tilts a tea tray. Olives roll. Glasses are sensors. Dennis cannot say why.\nconst CELL = 12, TILT = 16;\nG.TRAY_VIEW = new E.View('tray', 'Tray', 0, 55, 1.15, 1);\nG.activity({ id: 'tray', family: 'tray', discipline: 'Balance', name: 'Tray Service', tierName: 'A Heavier Tray', view: G.TRAY_VIEW, coachKey: 'games', song: 'tray',\n  says: 'Tilt the tray. Roll the olives into the glasses. You may not use your fingers. Dennis has asked.',\n  controls: (src, lean) => [[lean, 'Tilt the tray']],\n  prompts: () => [['lean', 'Tilt']],\n  setup(ctx) { const c = ctx.local; c.s = { in: 0 }; ctx.dur = ctx.limit || ctx.T.dur; ctx.idx = 0; ctx.total = ctx.T.trays.reduce((a, i) => a + G.TRAYS[i].rows.join('').split('o').length - 1, 0); c.bal = new G.Balance(G.SETS.plain, E.rng(ctx.seed + 4), { noFall: true, noGentle: true, stumbleAt: 9 }); this.load(ctx, 0); ctx.time = 0; ctx.dennis = G.regularRig('dennis', 1.7); },\n  load(ctx, i) { const data = G.TRAYS[ctx.T.trays[i]], w = data.rows[0].length, h = data.rows.length; ctx.w = w * CELL; ctx.h = h * CELL; ctx.ox = -ctx.w / 2; ctx.oy = -ctx.h / 2; ctx.tname = data.name; const world = ctx.world = new E.Physics({ gravity: [0, 0], sleep: false, on: { enter: (sen, b) => { if (sen.data && sen.data.glass && b.data && b.data.olive && !b.off) { b.off = true; ctx.world.remove(b); ctx.olives = ctx.olives.filter(o => o !== b); ctx.local.s.in++; sen.data.fill++; G.sfx('plop'); if (ctx.local.input && ctx.local.input.rumble) ctx.local.input.rumble(.3, .1); } }, hit: (a, b) => { const s = Math.hypot(a.vx - b.vx, a.vy - b.vy); if (s > 50 && ctx.ct <= 0) { ctx.ct = .08; G.sfx('trayClink', { vol: Math.min(.35, s / 300) }); } } } }); ctx.ct = 0; ctx.olives = []; ctx.glasses = []; ctx.bumpers = []; ctx.walls = []; ctx.gecko = null;\n    data.rows.forEach((row, ry) => [...row].forEach((ch, cx) => { const x = ctx.ox + cx * CELL + 6, y = ctx.oy + ry * CELL + 6; if (ch === '#') { world.box(x, y, CELL, CELL, { type: 'static', bounce: .2, friction: .2 }); ctx.walls.push([x, y]); } else if (ch === 'o') { const o = world.circle(x, y, 4.2, { bounce: .3, friction: .1, damping: .3, data: { olive: true }, density: .02 }); ctx.olives.push(o); } else if (ch === 'U') { const q = world.circle(x, y, 6, { type: 'static', sensor: true, data: { glass: true, fill: 0 } }); ctx.glasses.push(q); } else if (ch === 'B') { const q = world.bumper(x, y, 7, { kick: 90 }); ctx.bumpers.push(q); } else if (ch === 'G') { ctx.gecko = { b: world.box(x, y, 16, 7, { type: 'kinematic', bounce: .4 }), a: x, dir: 1, t: 0, y }; } })); },\n  botFill(ctx, c, skill, dt) { const cfg = { poor: [.9, .6, .5], average: [1.5, .25, .9], good: [2, .1, 1.25], expert: [2.4, .03, 1.5] }[skill], o = ctx.olives[0]; if (!o) { c.intent.ux = c.intent.uy = 0; return; } let bo = o, bq = null, bd = 1e9; const midW = ctx.walls.filter(w => Math.abs(w[0]) < ctx.w / 2 - 14 && Math.abs(w[1]) < ctx.h / 2 - 14); const side = (a, b) => midW.some(w => { const steps = 8; for (let t = 1; t < steps; t++) { const x = a.x + (b.x - a.x) * t / steps, y = a.y + (b.y - a.y) * t / steps; if (Math.abs(x - w[0]) < 8 && Math.abs(y - w[1]) < 8) return true; } return false; }); for (const q of ctx.olives) for (const g of ctx.glasses) { const d = Math.hypot(q.x - g.x, q.y - g.y) + (side(q, g) ? 400 : 0); if (d < bd) { bd = d; bo = q; bq = g; } } if (!bq) return; const wig = cfg[1] * Math.sin(ctx.t * 2.1), dx = bq.x - bo.x, dy = bq.y - bo.y, dd = Math.hypot(dx, dy) || 1, sp = Math.min(cfg[2] * 40, dd * 1.2), vx = dx / dd * sp - bo.vx, vy = dy / dd * sp - bo.vy; c.intent.ux = clamp(vx * .03 * cfg[0] + wig, -1, 1); c.intent.uy = clamp(-(vy * .03 * cfg[0]) + wig * .7, -1, 1); },\n  update(dt, ctx) { const c = ctx.local, D = G.DEV, Gv = D.trayG * ctx.T.G; c.bal.step(dt, c.intent.ux, c.intent.uy); const w = ctx.world; w.gravity = [c.bal.px * Gv, -c.bal.py * Gv]; w.wake(); ctx.ct -= dt; if (ctx.gecko) { const q = ctx.gecko; q.t += dt; const nx = q.a + Math.sin(q.t * .55) * 72; q.b.moveTo(nx, q.y, 0, 60, 2); } for (const o of ctx.olives) { o.friction = D.trayFric * .25; } w.step(dt);\n    if (!ctx.olives.length) { if (ctx.idx + 1 < ctx.T.trays.length) { ctx.idx++; this.load(ctx, ctx.idx); ctx.say('dennis', 'Olive?', 2); } else ctx.done = true; } if (ctx.t >= ctx.dur) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; ctx.dennis.mocap = G.sampleLoop('Idle_Subtle', ctx.time); G.place(ctx.dennis, dt, 0, 0, 0, 1.5); },\n  result(ctx, c) { const left = Math.max(0, ctx.dur - ctx.t) / ctx.dur; return { pct: c.s.in / ctx.total * (.8 + .2 * left), detail: 'Olives in: ' + c.s.in + ' of ' + ctx.total + '. Dennis nodded at the glasses, not at you.' }; },\n  enterView() { game.focus(0, 0, 0); },\n  draw(r, ctx) { const g = r.ctx, b = ctx.local.bal, tz = (x, y) => -(x * b.px - y * b.py) / (ctx.w / 2) * TILT * -1; game.focus(0, 6, 0); G.band(g, 0, 0, r.W, r.H, '#f7ecd8', '#e3cfa8', 6); for (let i = 0; i < 12; i++) px.rect(g, i * r.W / 12, 0, 1, r.H, '#ecdcbc');\n    // Dennis, the bar and the blender beyond the tray\n    const P3 = (x, y, z = 0) => { const q = r.w(x, y, tz(x, y) + z); return [q[0], q[1]]; }, W = ctx.w / 2 + 8, H = ctx.h / 2 + 8; px.rect(g, 0, 0, r.W, 42, '#dff0f4'); px.rect(g, 0, 40, r.W, 3, '#b9cbd2'); G.PROPS.blender(g, r.W * .8, 40); G.PROPS.fern(g, r.W * .1, 40, game.real);\n    px.poly(g, [P3(-W, -H, -5), P3(W, -H, -5), P3(W, H, -5), P3(-W, H, -5)], '#8a6a42'); px.poly(g, [P3(-W, -H), P3(W, -H), P3(W, H), P3(-W, H)], '#f6fafa'); const in2 = 5; px.poly(g, [P3(-W + in2, -H + in2), P3(W - in2, -H + in2), P3(W - in2, H - in2), P3(-W + in2, H - in2)], '#e8f4f6');\n    for (const q of ctx.walls) { const s = 6; const a = P3(q[0] - s, q[1] - s, 5), bb = P3(q[0] + s, q[1] - s, 5), c2 = P3(q[0] + s, q[1] + s, 5), d = P3(q[0] - s, q[1] + s, 5), e = P3(q[0] - s, q[1] + s), f2 = P3(q[0] + s, q[1] + s); px.poly(g, [d, c2, f2, e], '#c6a374'); px.poly(g, [a, bb, c2, d], '#e0c79c'); }\n    for (const q of ctx.bumpers) { const c0 = P3(q.x, q.y, 2); px.ell(g, c0[0], c0[1], 9, 6, '#e85d8a'); px.ell(g, c0[0], c0[1] - 2, 7, 4, '#ffb0c8'); }\n    for (const q of ctx.glasses) { const c0 = P3(q.x, q.y); px.ell(g, c0[0], c0[1], 8, 5, '#9fc6d0'); px.ell(g, c0[0], c0[1], 6, 4, '#f0fbff'); px.ell(g, c0[0], c0[1] + 1, 4, 2, '#d0f0f8'); px.line(g, c0[0], c0[1], c0[0] + 7, c0[1] - 8, '#8a6a42'); for (let n = 0; n < q.data.fill; n++) px.disc(g, c0[0] - 2 + n * 2, c0[1], 2, '#7a9a3a'); }\n    if (ctx.gecko) { const q = ctx.gecko.b, c0 = P3(q.x, q.y, 2), dir = Math.cos(ctx.gecko.t * .55) > 0 ? 1 : -1; px.ell(g, c0[0], c0[1], 9, 4, '#7bd389'); px.disc(g, c0[0] + dir * 9, c0[1] - 1, 3, '#55b878'); px.rect(g, c0[0] + dir * 10, c0[1] - 2, 1, 1, '#20404c'); px.line(g, c0[0] - dir * 9, c0[1], c0[0] - dir * 15, c0[1] + Math.sin(game.real * 5) * 2, '#55b878'); for (const l of [-5, 5]) { const st = Math.sin(game.real * 8 + l); px.rect(g, c0[0] + l, c0[1] + 3 + st, 2, 2, '#55b878'); px.rect(g, c0[0] + l, c0[1] - 4 - st, 2, 2, '#55b878'); } }\n    for (const o of ctx.olives) { const c0 = P3(o.x, o.y, 3); px.ell(g, c0[0] + 1, P3(o.x, o.y)[1] + 1, 5, 2, '#b8c8cc'); px.disc(g, c0[0], c0[1], 5, '#5e7a2a'); px.disc(g, c0[0], c0[1], 4, '#86a83e'); px.rect(g, c0[0] - 2, c0[1] - 2, 2, 1, '#c8e07a'); px.rect(g, c0[0] + 1, c0[1] + 1, 2, 2, '#e0553a'); } },\n  hud(g, r, ctx) { G.hudTop(g, r, ctx.tname + ': ' + ctx.local.s.in + ' of ' + ctx.total, G.fmtT(ctx.dur - ctx.t)); const R = 18, x = r.W - 30, y = r.H - 44; G.drawPlate(g, ctx.local.bal, x, y, R, { t: game.real }); }\n});\nEOF\ncat > game/activities/laundry.js <<'EOF'\n// Laundry Line: walk a clothesline between bungalows. x only. Effort is walking; going faster is harder. Gusts come with a sock in front.\nconst ROPE_Z = 58, POSTH = 72;\nG.activity({ id: 'laundry', family: 'laundry', discipline: 'Balance', name: 'Laundry Line', tierName: 'A Windier Day', view: 'side', coachKey: 'games', song: 'laundry',\n  says: 'Walk the line. Effort sets your pace, and faster is harder. Jump the pegs. You may not walk on the laundry. The sign is very clear.',\n  controls: (src, lean, L) => [[L('breath'), src === 'pad' ? 'Pace, analog' : 'Hold to walk'], [lean.replace('WASD', 'A D'), 'Lean left and right'], [L('jump'), 'Jump the pegs']],\n  prompts: (ctx) => [['breath', 'Walk'], ['lean', 'Lean'], ['jump', 'Jump']],\n  setup(ctx) { const T = ctx.T, c = ctx.local, R = ctx.R = E.rng(ctx.seed + 31); c.s = { x: 8, z: ROPE_Z, vz: 0, air: false, v: 0, falls: 0, time: 0, fall: 0, lastPost: 8, gust: null, gustT: T.gustEvery, tele: 0, dir: 1, fx: 0, walk: 0 }; c.bal = new G.Balance(Object.assign({}, G.SETS[T.set]), E.rng(ctx.seed + 6), { xOnly: true, noFall: ctx.cheat }); c.bal.onFall = () => { this.fall(ctx); };\n    ctx.posts = [8]; let x = 8; for (const s of T.spans) { x += s; ctx.posts.push(x); } ctx.len = x; ctx.pins = []; for (let i = 0; i < T.pins; i++) { const u = (i + .5) / T.pins; ctx.pins.push({ x: 30 + u * (ctx.len - 50) + (R() - .5) * 12 }); } ctx.laundry = []; for (let i = 0; i * 26 < ctx.len; i++) ctx.laundry.push({ x: 14 + i * 26 + R() * 8, k: Math.floor(R() * 4), c: G.pick(['#f6fafa', '#2cc6e6', '#ff7a59', '#f5c84b', '#c79be8'], R) }); ctx.time = 0; c.rig.wob = [0, 0]; },\n  fall(ctx) { const s = ctx.local.s; s.fall = 1.3; s.falls++; s.time += 3; ctx.say && Math.random() < .4 && ctx.say('tare', G.line('fall'), 2.5); G.sfx('stumble'); },\n  botFill(ctx, c, skill, dt) { G.leanBotFill(ctx, c, dt); const s = c.s, cfg = { poor: .55, average: .6, good: .72, expert: .85 }[skill]; c.intent.effort = cfg; c.intent.breath = cfg; c.intent.jump = false; const v = s.v || 8, tol = { poor: .3, average: .55, good: .9, expert: 1 }[skill], R = s.R || (s.R = E.rng(ctx.seed + 15)); for (const p of ctx.pins) { if (p.tried) continue; const d = p.x - s.x; if (d > 0 && d < v * .16 + 1.5) { p.tried = true; if (R() < tol + .05) c.intent.jump = true; } } },\n  update(dt, ctx) { const c = ctx.local, s = c.s, T = ctx.T, i = c.intent, b = c.bal; s.time += dt; if (ctx.t > 130) { ctx.done = true; return; }\n    if (s.fall > 0) { s.fall -= dt; s.z = Math.max(4, s.z - dt * 60); if (s.fall <= 0) { s.x = s.lastPost; s.z = ROPE_Z; b.px = b.py = b.vx = b.vy = 0; b.stumbleT = 0; s.v = 0; for (const p of ctx.pins) p.tried = false; G.sfx('boop', { vol: .2 }); } return; }\n    s.gustT -= dt; if (!s.gust && s.gustT <= 0) { s.gustT = T.gustEvery; s.gust = { t: 1.4, dir: ctx.R() < .5 ? -1 : 1 }; G.sfx('sock'); }\n    let fx = 0; if (s.gust) { s.gust.t -= dt; if (s.gust.t < .6) fx = s.gust.dir * 9 * G.DEV.gust; if (s.gust.t <= 0) { s.gust = null; G.sfx('whoosh', { vol: .3 }); } }\n    const eff = clamp(i.effort, 0, 1), speedW = T.speed * eff * 2; s.v += (speedW - s.v) * Math.min(1, dt * 5); const stair = (eff > .6 ? (eff - .6) / .4 : 0) * 4;\n    if (s.air) { s.vz -= 520 * dt; s.z += s.vz * dt; b.frozen = true; if (s.z <= ROPE_Z) { s.z = ROPE_Z; s.air = false; b.frozen = false; G.sfx('rope', { vol: .5 }); } } else if (i.jump) { s.air = true; s.vz = 150; G.sfx('jump', { vol: .3 }); }\n    b.step(dt, i.ux, 0, { fx, s: stair * G.DEV.ropeS }); s.x += s.v * dt; if (s.v > 2) { s.walk += s.v * dt; s.rp = (s.rp || 0) - dt; if (s.rp <= 0) { s.rp = .6; G.sfx('rope', { vol: .2 + b.lean * .4 }); } }\n    for (const p of ctx.posts) if (s.x >= p && s.lastPost < p) { s.lastPost = p; G.sfx('chime', { vol: .25 }); }\n    if (!s.air && !ctx.cheat) for (const p of ctx.pins) { if (Math.abs(p.x - s.x) < 1.2 && !p.bumped) { p.bumped = true; b.vx += (b.px >= 0 ? 1 : -1) * 1.1; game.after(.8, () => { p.bumped = false; }); G.sfx('tick', { vol: .4 }); } }\n    if (s.x >= ctx.len) { s.finished = true; ctx.done = true; } },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const c = ctx.local, s = c.s, rig = c.rig, b = c.bal; rig.wob = [0, 0]; rig.lean = 0; const tilt = b.px * .55; rig.body = null; if (s.fall > 0) { rig.mocap = G.sampleLoop('Dizzy', ctx.time); } else if (s.v > 1) { rig.mocap = null; } else rig.mocap = G.sampleLoop('Idle_Subtle', ctx.time);\n    const prev = rig.solvePose; rig.tilt_ = tilt; rig.update(dt, { x: s.x, y: 0, z: s.z, vx: s.v, vy: 0, facing: 0, air: s.air }); rig.wob = [tilt, 0]; rig.px = s.x; rig.py = 0; rig.pz = s.z; game.focus(s.x + 30, 0, 40); },\n  result(ctx, c) { const s = c.s, T = ctx.T, frac = Math.min(1, s.x / ctx.len), score = clamp((T.worst - s.time) / (T.worst - T.par), 0, 1); return { pct: (s.finished ? score : frac * .2) - .02 * s.falls, detail: 'Time ' + s.time.toFixed(0) + ' s. Falls: ' + s.falls + '. The laundry is fine.' }; },\n  draw(r, ctx) { const g = r.ctx, s = ctx.local.s, t = game.real; G.band(g, 0, 0, r.W, r.H * .7, G.PAL.sky1, G.PAL.sky2, 8); G.band(g, 0, r.H * .7, r.W, r.H * .3, '#7cc47e', '#5eae68', 4); const gy = r.w(s.x, 0, 0)[1]; if (gy < r.H) px.rect(g, 0, gy, r.W, r.H - gy, '#6fba74');\n    for (let i = 0; i < 6; i++) { const bx = ((i * 90 - s.x * .3) % (r.W + 120) + r.W + 120) % (r.W + 120) - 60; px.rect(g, bx, gy - 26, 44, 26, '#f6efe0'); px.poly(g, [[bx - 4, gy - 26], [bx + 48, gy - 26], [bx + 22, gy - 42]], '#e0553a'); px.rect(g, bx + 17, gy - 16, 10, 16, '#2cc6e6'); }\n    const W = (x, z) => r.w(x, 0, z), a = W(ctx.posts[0] - 40, ROPE_Z), b = W(ctx.len + 40, ROPE_Z); px.line(g, a[0], a[1], b[0], b[1], '#8a7a60', 1); for (const p of ctx.posts) { const q = W(p, 0), q2 = W(p, POSTH); px.rect(g, q[0] - 2, q2[1], 5, q[1] - q2[1], '#8a6a42'); px.rect(g, q2[0] - 6, q2[1] + 8, 13, 2, '#8a6a42'); r.ctx && 0; const hx = W(p, 0); px.rect(g, hx[0] + 6, hx[1] - 14, 16, 14, '#c9a56e'); px.rect(g, hx[0] + 7, hx[1] - 15, 14, 3, '#f6fafa'); }\n    for (const q of ctx.laundry) { const o = W(q.x, ROPE_Z), sw = Math.sin(t * 2 + q.x) * 2; if (q.k === 0) { px.rect(g, o[0] - 5 + sw, o[1], 11, 12, q.c); px.rect(g, o[0] - 8 + sw, o[1], 3, 5, q.c); px.rect(g, o[0] + 6 + sw, o[1], 3, 5, q.c); } else if (q.k === 1) { px.rect(g, o[0] - 2 + sw, o[1], 4, 12, q.c); px.rect(g, o[0] - 2 + sw, o[1] + 10, 7, 3, q.c); } else { px.rect(g, o[0] - 8 + sw, o[1], 16, 9, q.c); } }\n    for (const q of ctx.pins) { const o = W(q.x, ROPE_Z); px.rect(g, o[0] - 2, o[1] - 7, 3, 8, '#b8905f'); px.rect(g, o[0] + 1, o[1] - 7, 1, 8, '#8a6a42'); }\n    const k = W(ctx.posts[0] + 6, 0); G.panel(g, k[0] - 40 + 30, k[1] - 40, 118, 28, { rad: 3 }); G.wrapText(g, 'Please do not walk on the laundry line.', k[0] - 6, k[1] - 37, 110, G.COL.INK, { gap: 0 });\n    if (s.gust) { const dir = s.gust.dir; for (let i = 0; i < 12; i++) { const yy = 20 + i * 15, xx = ((t * 180 * dir + i * 53) % r.W + r.W) % r.W; px.rect(g, xx, yy, 18, 1, '#ffffff'); } const sx = dir > 0 ? (1.4 - s.gust.t) * r.W * .8 : r.W - (1.4 - s.gust.t) * r.W * .8; px.rect(g, sx, 50, 5, 11, '#ff7a59'); px.rect(g, sx, 58, 8, 3, '#ff7a59'); }\n    G.actor(r, ctx.local.rig, { shadow: 0 }); },\n  hud(g, r, ctx) { const s = ctx.local.s, b = ctx.local.bal; G.hudTop(g, r, 'Falls ' + s.falls, s.time.toFixed(0) + ' s'); const W = 70, x = r.W / 2, y = r.H - 18; G.round(g, x - W - 6, y - 6, W * 2 + 12, 13, '#ffffff'); const R = b.R * W; px.rect(g, x - R, y - 2, R * 2, 5, '#bfeee0'); px.rect(g, x - W, y, W * 2, 1, '#c8dde2'); px.disc(g, x + clamp(b.px, -1, 1) * W, y, 3, G.COL.CORAL); const prog = clamp(s.x / ctx.len, 0, 1); px.rect(g, 12, 26, 70, 2, '#ffffff'); px.disc(g, 12 + prog * 70, 27, 3, G.COL.CORAL); if (s.gust && s.gust.t >= .6) G.text(g, s.gust.dir > 0 ? 'A sock, going right' : 'A sock, going left', r.W / 2, 28, G.COL.INK, { align: 'center', shadow: '#fff' }); }\n});\nEOF\n","description":"Write jog, slalom, tray and laundry activities"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24878,"cache_read_input_tokens":240552,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24878},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6a88ba50-da75-48c3-bde0-396ebfab72e9","uuid":"8aed35c1-288e-49fb-9d1e-e3e5b2f7aa6f","timestamp":"2026-11-05T05:34:31.908Z","request_id":"req_011CgjEW4SwPfJTbZokPHQFu","wire_tool_inputs":{"toolu_01KYB53TMBaJJRKP1vdYrwFM":{"command":"cat > game/activities/jog.js <<'EOF'\n// Coastal Jog: alternate your steps to set a cadence, stay in Marisol's zone, weave round pigeons, grab water. A lap of the coast road.\nconst jogSprite = { pigeon: { w: 90 }, jogger: { w: 180 }, cup: { w: 80 } };\nG.activity({ id: 'jog', family: 'jog', discipline: 'Cardio', name: 'Coastal Jog', tierName: 'A Narrower Zone', hub: true, noRig: false, coachKey: 'cardio', song: 'jog', noDemoLine: false,\n  says: \"Alternate your steps to keep Marisol's pace. Lean to steer. You may not sprint for long. Your side will say so.\",\n  controls: (src, lean, L) => [[L('paceL') + ', ' + L('paceR'), 'Left, right, left, right'], [lean, 'Steer']],\n  prompts: () => [['paceL', 'Left'], ['paceR', 'Right'], ['lean', 'Steer']],\n  setup(ctx) { const T = ctx.T, J = G.JOG, SEG = 200, road = ctx.road = new E.Road({ segment: SEG, lanes: 2, draw: 150, fog: null, colors: { road: ['#c9b48e', '#c2ac86'], grass: ['#7cc47e', '#6fba74'], rumble: ['#f6fafa', '#2cc6e6'], lane: '#efe3c8' }, sky: new E.Backdrop({ sky: ['#8fd3f4', '#d8f3fb'], layers: [{ kind: 'clouds', color: '#ffffff', y: .2, height: 22, parallax: .15, fill: false }, { kind: 'sea', color: '#49b6c9', y: .92, height: 30, parallax: 0 }] }) });\n    for (const [n, o] of J.road) road.add(n, o); ctx.lap = road.length; const R = E.rng(ctx.seed + 9);\n    const sprite = { draw(g, sx, sy, sc) { G.jogTree(g, sx, sy, sc); }, w: 300 }, bung = { draw(g, sx, sy, sc) { G.jogBungalow(g, sx, sy, sc); }, w: 900 }, bench = { draw(g, sx, sy, sc) { G.jogLou(g, sx, sy, sc); }, w: 500 }, pier = { draw(g, sx, sy, sc) { G.jogPier(g, sx, sy, sc); }, w: 1200 };\n    for (let z = 1000; z < ctx.lap - 1000; z += 900) { const side = R() < .5 ? -1 : 1; road.place(z, side * (1.6 + R() * 1.2), sprite); if (R() < .16) road.place(z + 300, -side * 2.6, bung); }\n    road.place(ctx.lap * .25, -1.55, bench); road.place(ctx.lap * .6, 2.6, pier); road.place(ctx.lap * .62, 2.6, pier);\n    ctx.items = []; const mul = T.obstacles;\n    for (let i = 0; i < J.cups; i++) ctx.items.push({ kind: 'cup', z: ctx.lap * (.05 + i / J.cups * .92), x: (R() - .5) * 1.4 });\n    for (let i = 0; i < J.pigeons * mul; i++) ctx.items.push({ kind: 'pigeon', z: ctx.lap * (.05 + R() * .92), x: (R() - .5) * 1.6 });\n    for (let i = 0; i < J.joggers * mul; i++) ctx.items.push({ kind: 'jogger', z: ctx.lap * (.05 + R() * .92), x: (R() - .5) * 1.6, v: 700, rig: null });\n    ctx.items.sort((a, b) => a.z - b.z); ctx.cupsTotal = J.cups; ctx.h = 900; ctx.ahead = road.ahead(ctx.h);\n    const c = ctx.local; c.s = { z: 0, x: 0, cad: 0, lastStep: -1, lastSide: 0, zone: 0, total: 0, cups: 0, stitch: 0, over: 0, hit: 0, turn: 0, bT: 0, steps: 0 }; c.bal = new G.Balance(G.SETS.plain, E.rng(ctx.seed + 1), { noFall: true, noGentle: true, stumbleAt: 9 }); ctx.time = 0; },\n  botFill(ctx, c, skill, dt) { const s = c.s, cfg = { poor: [2.4, .55, .5], average: [3, .2, .25], good: [3, .07, .1], expert: [3.05, .03, .04] }[skill]; s.bT -= dt; c.intent.paceL = c.intent.paceR = false; const R = s.R || (s.R = E.rng(ctx.seed + 44)); if (s.bT <= 0) { s.bT = 1 / (cfg[0] + (R() - .5) * cfg[1]); if (s.lastSide >= 0) c.intent.paceL = true; else c.intent.paceR = true; }\n    const pz = s.z, ahead = ctx.items.filter(q => !q.gone && q.z > pz && q.z < pz + 2400).slice(0, 4); let want = 0; for (const q of ahead) { if (q.kind === 'cup') { want = q.x; break; } } for (const q of ahead) if (q.kind !== 'cup' && Math.abs(q.x - want) < .3) want = q.x + (want >= q.x ? .45 : -.45); want += Math.sin(ctx.t * 1.2) * cfg[2]; c.intent.ux = clamp((want - s.x) * 1.8 + road_(ctx, s), -1, 1); c.intent.uy = 0; },\n  update(dt, ctx) { const c = ctx.local, s = c.s, i = c.intent, T = ctx.T, BD = G.DEV.jogBand, band = [T.band[0] * (2 - BD), T.band[1] * BD]; s.band = band;\n    c.bal.step(dt, i.ux, 0);\n    const stepped = (i.paceL && s.lastSide >= 0) ? -1 : (i.paceR && s.lastSide <= 0) ? 1 : 0;\n    if (stepped) { const gap = ctx.t - s.lastStep; if (s.lastStep >= 0 && gap > 0) { const r = 1 / gap; s.cad = s.cad * .55 + Math.min(8, r) * .45; } s.lastStep = ctx.t; s.lastSide = stepped; s.steps++; if (c.local) G.sfx('step', { vol: .12 }); }\n    if (ctx.t - s.lastStep > .5) s.cad = Math.max(0, s.cad - dt * 3);\n    if (s.cad > 4.2) s.over += dt; else s.over = Math.max(0, s.over - dt); if (s.over >= 2 && s.stitch <= 0) { s.stitch = 3; s.over = 0; ctx.say('tare', G.LINES.stitch, 3); G.sfx('stumble'); }\n    if (s.stitch > 0) s.stitch -= dt; if (s.hit > 0) s.hit -= dt;\n    const cad = s.stitch > 0 ? Math.min(s.cad, 1.5) : s.cad, v = s.hit > 0 ? 0 : cad * 476 * G.DEV.jogSpeed; s.v = v; const pz = s.z; s.z += v * dt;\n    s.total += dt; if (cad >= band[0] && cad <= band[1] && s.stitch <= 0) s.zone += dt;\n    const bend = ctx.road.curveAt(s.z); s.x += (c.bal.px * 1.25 - bend * (v / 1500) * .22) * dt; s.x = clamp(s.x, -1.15, 1.15); s.turn += bend * v * dt * .004;\n    for (const q of ctx.items) { if (q.gone) continue; if (q.v) q.mz = (q.mz || 0) + q.v * dt; const iz = q.z + (q.mz || 0); if (iz <= pz) continue; if (iz > s.z) continue; const hw = q.kind === 'cup' ? .28 : .17; if (Math.abs(q.x - s.x) < hw) { q.gone = true; if (q.kind === 'cup') { s.cups++; G.sfx('clink'); G.sfx('plop', { vol: .2 }); } else if (!ctx.cheat) { s.hit = .9; G.sfx(q.kind === 'pigeon' ? 'flurry' : 'stumble'); game.shake(1); } } else if (q.kind === 'pigeon') q.flown = 1.2; else q.mz = q.mz; }\n    if (s.z >= ctx.lap) ctx.done = true; if (ctx.t >= 105) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const c = ctx.local, s = c.s, rig = c.rig; s.run = (s.run || 0) + dt * Math.max(.0, (s.cad || 0)) * .28; rig.wob = [c.bal.px * .25, 0]; rig.body = null; rig.mocap = s.cad > .2 ? G.lib.sample(G.clip('Run_Loop'), s.run % G.clip('Run_Loop').dur) : G.sampleLoop('Idle_Subtle', ctx.time); G.place(rig, dt, 0, 0, 0, -Math.PI / 2); },\n  result(ctx, c) { const s = c.s, zone = s.total ? s.zone / Math.max(s.total, 30) : 0, cups = s.cups / ctx.cupsTotal; return { pct: (s.z >= ctx.lap || ctx.limit ? 1 : Math.min(1, s.z / ctx.lap)) * (.7 * zone + .3 * cups), detail: 'In the zone ' + Math.round(zone * 100) + '%. Cups ' + s.cups + ' of ' + ctx.cupsTotal + '.' }; },\n  draw(r, ctx) { const s = ctx.local.s, cz = Math.max(0, s.z - ctx.ahead); const cars = []; for (const q of ctx.items) { if (q.gone) continue; const iz = q.z + (q.mz || 0), d = iz - cz; if (d < 0 || d > 22000) continue; cars.push({ z: iz, x: q.x, w: jogSprite[q.kind].w, draw: (g, sx, sy, sc) => G.jogItem(g, q, sx, sy, sc) }); } const gh = G.jogGhosts ? G.jogGhosts(ctx) : []; ctx.road.draw(r, { z: cz, x: s.x, h: ctx.h, turn: s.turn, cars: cars.concat(gh) });\n    const rig = ctx.local.rig; r.overlay(g => { const by = r.H - 14, hob = s.hit > 0 ? 5 : 0; px.ell(g, r.W / 2, by + 1, 16, 4, '#5c6a55'); rig.draw(g, r.W / 2, by + hob, r.view); G.drawExtras(g, rig, r.W / 2, by + hob, r); }); },\n  hud(g, r, ctx) { const s = ctx.local.s, band = s.band || ctx.T.band; G.hudTop(g, r, 'Cups ' + s.cups, Math.round(Math.min(1, s.z / ctx.lap) * 100) + '% of the lap'); const x = 12, y = 34, w = 16, h = r.H - 80, hi = 5.2, v = Math.min(1, (s.cad || 0) / hi); G.round(g, x, y, w, h, '#ffffff', 6); const a = y + h - band[1] / hi * h, b = y + h - band[0] / hi * h; px.rect(g, x + 3, a, w - 6, b - a, '#bfeee0'); const sa = y + h - 4.2 / hi * h; px.rect(g, x + 3, y + 3, w - 6, Math.max(0, sa - y - 3), '#ffd9c8'); px.rect(g, x + 1, y + h - v * h - 1, w - 2, 3, s.stitch > 0 ? '#e0553a' : G.COL.INK); const label = s.stitch > 0 ? 'Stitch' : (s.cad || 0) > band[1] ? 'Too fast' : (s.cad || 0) < band[0] ? 'Too slow' : 'Marisol approves'; G.text(g, label, x + w + 6, y + h - 10, s.stitch > 0 ? '#e0553a' : '#fff', { shadow: '#20404c' }); },\n  ghost(ctx) { const s = ctx.local.s; return { p: s.z, w: [s.x, s.cad || 0], s: Math.round(Math.min(1, s.zone / Math.max(ctx.t, 1)) * 1000) }; }\n});\nconst road_ = (ctx, s) => ctx.road.curveAt(s.z) * .12;\nG.jogTree = (g, x, y, k) => { const w = 300 * k, h = 760 * k; px.rect(g, x - w * .08, y - h * .5, w * .16, h * .5, '#8a6a42'); px.ell(g, x, y - h * .72, w * .5, h * .3, '#3d9a60'); px.ell(g, x - w * .1, y - h * .8, w * .3, h * .18, '#55b878'); };\nG.jogBungalow = (g, x, y, k) => { const w = 900 * k, h = 500 * k; px.rect(g, x - w / 2, y - h, w, h, '#f6efe0'); px.poly(g, [[x - w * .6, y - h], [x + w * .6, y - h], [x, y - h * 1.6]], '#e0553a'); px.rect(g, x - w * .1, y - h * .6, w * .2, h * .6, '#2cc6e6'); };\nG.jogLou = (g, x, y, k) => { const w = 500 * k, h = 200 * k; px.rect(g, x - w / 2, y - h, w, h * .3, '#8a6a42'); px.rect(g, x - w * .45, y - h * .7, w * .1, h * .7, '#6a4a30'); px.rect(g, x + w * .35, y - h * .7, w * .1, h * .7, '#6a4a30'); px.rect(g, x - w * .3, y - h * 1.3, w * .55, h * .35, '#90a4a8'); px.disc(g, x + w * .32, y - h * 1.2, h * .22, '#e8c8a8'); };\nG.jogPier = (g, x, y, k) => { const w = 1200 * k, h = 300 * k; px.rect(g, x - w / 2, y - h, w, h * .18, '#b08f64'); for (let i = 0; i < 5; i++) px.rect(g, x - w / 2 + i * w / 4 - w * .02, y - h, w * .04, h, '#8a6a42'); };\nG.jogItem = (g, q, x, y, k) => {\n  if (q.kind === 'cup') { const w = 80 * k, h = 110 * k; px.rect(g, x - w / 2, y - h, w, h, '#ffffff'); px.rect(g, x - w / 2 + 1, y - h + 1, w - 2, Math.max(1, h * .3), '#2cc6e6'); px.ell(g, x, y + 1, w, w * .2, 'rgba(60,70,60,.25)'); }\n  else if (q.kind === 'pigeon') { const w = 70 * k, bob = Math.abs(Math.sin(G.game.real * 7 + q.z)) * 8 * k; px.ell(g, x, y - w * .5 - bob, w * .6, w * .4, '#8e99a8'); px.disc(g, x + w * .45, y - w * .9 - bob, w * .22, '#68727f'); px.rect(g, x + w * .6, y - w * .9 - bob, w * .15, Math.max(1, w * .08), '#d0602a'); }\n  else { const w = 150 * k, h = 460 * k, sw = Math.sin(G.game.real * 9 + q.z) * w * .14; const col = ['#c79be8', '#7bd389', '#f5c84b', '#5a7fe0'][Math.floor(q.z) % 4]; px.rect(g, x - w * .25 + sw, y - h * .35, w * .2, h * .35, '#20404c'); px.rect(g, x + w * .05 - sw, y - h * .35, w * .2, h * .35, '#20404c'); px.rect(g, x - w * .32, y - h * .8, w * .64, h * .47, col); px.disc(g, x, y - h * .92, w * .28, '#f0c8a0'); }\n};\nEOF\ncat > game/activities/slalom.js <<'EOF'\n// Mount Posture Slalom: lean left and right to steer, forward to tuck, back to brake. Gates, snowmen, pines, regret.\nconst SNOW = (x, y) => { const n = (Math.sin(x * .13) + Math.cos(y * .09) + Math.sin((x + y) * .05)) * 3; const line = ((x >> 3) & 15) === 0 && ((y >> 2) & 3) === 0 ? -8 : 0; const v = 240 + n + line; return [v - 6, v, 255]; };\nconst SNOWMAN = (g, sx, sy, k) => { const R = 6 * k; px.disc(g, sx, sy - R, R, '#f8fbff'); px.disc(g, sx, sy - R * 2.5, R * .7, '#ffffff'); px.rect(g, sx - 1 * k, sy - R * 2.8, Math.max(1, k), Math.max(1, k), '#20404c'); px.rect(g, sx + 1.5 * k, sy - R * 2.8, Math.max(1, k), Math.max(1, k), '#20404c'); px.rect(g, sx, sy - R * 2.5, 3 * k, Math.max(1, k), '#ff7a59'); };\nconst PINE = (g, sx, sy, k) => { const h = 34 * k, w = 12 * k; px.rect(g, sx - k, sy - 6 * k, 2 * k, 6 * k, '#6a4a30'); px.poly(g, [[sx - w, sy - 6 * k], [sx + w, sy - 6 * k], [sx, sy - h * .7]], '#2f7d58'); px.poly(g, [[sx - w * .8, sy - h * .45], [sx + w * .8, sy - h * .45], [sx, sy - h]], '#3d9a70'); px.poly(g, [[sx - w * .4, sy - h * .75], [sx + w * .4, sy - h * .75], [sx, sy - h]], '#e8f6ff'); };\nconst FLAG = (g, sx, sy, k, c, left) => { px.rect(g, sx, sy - 20 * k, Math.max(1, 1.2 * k), 20 * k, '#20404c'); px.poly(g, [[sx, sy - 20 * k], [sx + (left ? -9 : 9) * k, sy - 16 * k], [sx, sy - 12 * k]], c); };\nG.activity({ id: 'slalom', family: 'slalom', discipline: 'Balance', name: 'Mount Posture Slalom', tierName: 'Fog', hub: true, coachKey: 'games', song: 'ski', \n  says: 'Lean left and right to steer. Lean forward to tuck, back to brake. Go through the gates. You may not go round. It costs three seconds.',\n  controls: (src, lean) => [[lean, 'Steer, tuck, brake']],\n  prompts: () => [['lean', 'Steer, tuck, brake']],\n  setup(ctx) { const T = ctx.T, C = ctx.course = ctx.short ? G.COURSES.short : G.COURSES[T.course]; const s = ctx.local.s = { x: 0, y: 0, v: T.speed * .3, tumble: 0, misses: 0, passed: 0, angle: 0, tucking: 0, next: 0, time: 0, carve: 0, down: 0 };\n    ctx.gates = C.gates.map((x, i) => ({ x, y: -(i + 1) * C.spacing, hit: null })); ctx.end = -(C.gates.length + .6) * C.spacing; const R = E.rng(ctx.seed + 21); ctx.obst = []; for (let i = 0; i < C.obstacles; i++) { const gi = Math.floor(R() * (C.gates.length - 1)), y = ctx.gates[gi].y - C.spacing * (.35 + R() * .3), mid = (ctx.gates[gi].x + ctx.gates[gi + 1].x) / 2, side = R() < .5 ? -1 : 1, x = clamp(mid + side * (55 + R() * 70), -170, 170); ctx.obst.push({ x, y, kind: R() < .5 ? 'snowman' : 'pine' }); }\n    ctx.trees = []; for (let y = 0; y > ctx.end - 800; y -= 200) { ctx.trees.push({ x: -205 - R() * 90, y: y - R() * 90 }); ctx.trees.push({ x: 205 + R() * 90, y: y - R() * 90 }); }\n    ctx.m7 = new E.Mode7({ floor: SNOW, size: [512, 512], wrap: true, sky: ['#7fc8ee', '#e8f6ff'], far: 2200, fog: T.course === 'slalom2' && !ctx.short ? { color: '#eaf4f8', near: 350, far: 900 } : { color: '#dff2fb', near: 1200, far: 2200 } });\n    ctx.m7.cam = { x: 0, y: 60, h: 38, angle: -Math.PI / 2, pitch: 12, fov: 70 }; ctx.c = ctx.local; ctx.c.bal = new G.Balance(G.SETS.plain, E.rng(ctx.seed + 2), { noFall: true, noGentle: true, stumbleAt: 9 }); ctx.time = 0; ctx.camA = -Math.PI / 2; G.setWeather(ctx);\n    ctx.c.rig.body = null; },\n  enterView(ctx) { game.weather = { kind: 'snow', amount: .6, wind: .1 }; },\n  botFill(ctx, c, skill, dt) { const s = c.s, cfg = { poor: [38, .55, 0, .34], average: [22, .4, .1, .16], good: [11, .1, .6, .07], expert: [5, .04, .95, .03] }[skill], R = s.R || (s.R = E.rng(ctx.seed + 8)); const g = ctx.gates[s.next]; if (!g) { c.intent.ux = 0; c.intent.uy = .6; return; } if (g !== s.bg) { s.bg = g; s.err = (R() - .5) * 2 * cfg[0]; s.tuckOn = R() < cfg[2]; s.skip = R() < cfg[3] * .4; }\n    let want = g.x + s.err; if (s.skip) want = s.x; for (const o of ctx.obst) { const d = s.y - o.y; if (d > 0 && d < 240 && Math.abs(o.x - want * .4 - s.x * .6) < 24) want = o.x + (s.x > o.x ? 42 : -42); } const dx = want - s.x; c.intent.ux = clamp(dx / 55 + Math.sin(ctx.t * 2) * cfg[1] * .25, -1, 1); c.intent.uy = s.tuckOn && Math.abs(dx) < 50 ? .7 : 0; },\n  update(dt, ctx) { const c = ctx.local, s = c.s, T = ctx.T, i = c.intent, D = G.DEV; c.bal.step(dt, i.ux, i.uy); const lx = c.bal.px, ly = c.bal.py; s.time += dt;\n    if (s.tumble > 0) { s.tumble -= dt; s.v = Math.max(0, s.v - dt * 500); s.tucking = 0; }\n    else { const mul = ly > .3 ? 1.35 : ly < -.3 ? .6 : 1; s.tucking = ly > .3 ? 1 : 0; const want = T.speed * D.slalomSpeed * mul * (ctx.short ? 1.0 : 1); s.v += (want - s.v) * Math.min(1, dt * 2.2); const turn = 170 * D.slalomTurn * (ly > .3 ? .8 : 1); s.vx = lx * turn; s.x += s.vx * dt; s.x = clamp(s.x, -196, 196); if (Math.abs(lx) > .4) { s.carve -= dt; if (s.carve <= 0) { s.carve = .2; G.sfx('carve', { vol: .15 + Math.abs(lx) * .15, pan: lx }); game.particles && game.particles.add && 0; } } }\n    const py = s.y; s.y -= s.v * dt;\n    const g = ctx.gates[s.next]; if (g && s.y <= g.y) { const w = ctx.course.width; if (Math.abs(s.x - g.x) <= w) { g.hit = 'pass'; s.passed++; G.sfx('chime', { vol: .25, pitch: 1 + s.passed * .02 }); } else { g.hit = 'miss'; s.misses++; G.sfx('cancel', { vol: .3 }); s.flash = 1; ctx.say && 0; } s.next++; }\n    if (s.tumble <= 0 && !ctx.cheat) for (const o of ctx.obst) { if (py > o.y && s.y <= o.y && Math.abs(o.x - s.x) < 11) { s.tumble = 1.2; s.hits = (s.hits || 0) + 1; G.sfx('stumble'); game.shake(2); if (c.input && c.input.rumble) c.input.rumble(.8, .3); } }\n    if (s.flash > 0) s.flash -= dt; s.angle += ((-Math.PI / 2 + lx * .14) - (ctx.camA || 0)) * 0; ctx.camA += ((-Math.PI / 2 + lx * .12) - ctx.camA) * Math.min(1, dt * 4); ctx.m7.chase({ x: s.x, y: s.y, angle: ctx.camA }, { back: 60, h: 36 }); if (s.y <= ctx.end) { s.finished = true; ctx.done = true; } if (ctx.t > ctx.course.worst + 25) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const c = ctx.local, s = c.s, rig = c.rig, lx = c.bal.px; rig.wob = [lx * .7, Math.max(0, c.bal.py) * .4]; rig.mocap = s.tumble > 0 ? G.sampleLoop('Get_Up_From_Back', 1.2 - s.tumble) : null; rig.body = null; const st = { x: s.x, y: s.y, z: 0, vx: 0, vy: 0, facing: -Math.PI / 2 - (rig.spin || 0), pose: 'crouch' }; rig.update(dt, st); rig.px = s.x; rig.py = s.y; },\n  time(ctx, s) { return s.time + s.misses * 3; },\n  result(ctx, c) { const s = c.s, tm = this.time(ctx, s), C = ctx.course; const done = s.finished ? 1 : (s.passed + s.misses) / ctx.gates.length; return { pct: clamp((C.worst - tm) / (C.worst - C.par), 0, 1) * done, detail: 'Time ' + tm.toFixed(1) + ' s. Gates missed: ' + s.misses + '. ' + G.pick(G.LINES.raceTimes) }; },\n  draw(r, ctx) { const m7 = ctx.m7, s = ctx.local.s, st = s.y; m7.draw && 0; for (const q of ctx.trees) if (q.y < st + 120 && q.y > st - 1800) m7.add(q.x, q.y, 0, (g, sx, sy, k) => PINE(g, sx, sy, k * 1.5)); for (const o of ctx.obst) if (o.y < st + 100 && o.y > st - 1800) m7.add(o.x, o.y, 0, (g, sx, sy, k) => (o.kind === 'snowman' ? SNOWMAN : PINE)(g, sx, sy, k)); ctx.gates.forEach((q, i) => { if (q.y < st + 120 && q.y > st - 1800) { const w = ctx.course.width, c = q.hit === 'miss' ? '#a0a8ae' : i % 2 ? '#e0553a' : '#2c7ee6'; m7.add(q.x - w, q.y, 0, (g, sx, sy, k) => FLAG(g, sx, sy, k * 1.5, c, true)); m7.add(q.x + w, q.y, 0, (g, sx, sy, k) => FLAG(g, sx, sy, k * 1.5, c, false)); } });\n    const rig = ctx.local.rig; m7.rig(rig, s.x, s.y, 0); m7.add(s.x, s.y, 0, (g, sx, sy, k) => { const w = 9 * k, a = ctx.local.bal.px * 3 * k; px.rect(g, sx - w + a * .3, sy, w * .8, Math.max(1, k), '#20404c'); px.rect(g, sx + w * .2 + a * .3, sy, w * .8, Math.max(1, k), '#20404c'); }); if (G.drawGhosts7) G.drawGhosts7(m7, ctx); m7.draw(r); },\n  hud(g, r, ctx) { const s = ctx.local.s; G.hudTop(g, r, 'Gate ' + Math.min(s.next + 1, ctx.gates.length) + ' of ' + ctx.gates.length, this.time(ctx, s).toFixed(1) + ' s'); if (s.flash > 0) G.text(g, '+3 seconds', r.W / 2, 34, '#e0553a', { align: 'center', scale: 2, shadow: '#fff' }); if (s.tucking) G.text(g, 'Tuck', r.W / 2, r.H - 30, G.COL.ACCD, { align: 'center', shadow: '#fff' }); const x0 = 14, y0 = r.H - 40, W = 60; px.rect(g, x0, y0, W, 2, '#ffffff'); px.disc(g, x0 + clamp(s.y / ctx.end, 0, 1) * W, y0 + 1, 3, G.COL.CORAL); },\n  ghost(ctx) { const s = ctx.local.s; return { p: s.y, w: [s.x, 0], s: Math.round((s.passed || 0) / ctx.gates.length * 1000) }; }\n});\nG.setWeather = ctx => { if (!game.headless) game.weather = { kind: 'snow', amount: .6, wind: .1 }; };\nEOF\ncat > game/activities/tray.js <<'EOF'\n// Tray Service: lean tilts a tea tray. Olives roll. Glasses are sensors. Dennis cannot say why.\nconst CELL = 12, TILT = 16;\nG.TRAY_VIEW = new E.View('tray', 'Tray', 0, 55, 1.15, 1);\nG.activity({ id: 'tray', family: 'tray', discipline: 'Balance', name: 'Tray Service', tierName: 'A Heavier Tray', view: G.TRAY_VIEW, coachKey: 'games', song: 'tray',\n  says: 'Tilt the tray. Roll the olives into the glasses. You may not use your fingers. Dennis has asked.',\n  controls: (src, lean) => [[lean, 'Tilt the tray']],\n  prompts: () => [['lean', 'Tilt']],\n  setup(ctx) { const c = ctx.local; c.s = { in: 0 }; ctx.dur = ctx.limit || ctx.T.dur; ctx.idx = 0; ctx.total = ctx.T.trays.reduce((a, i) => a + G.TRAYS[i].rows.join('').split('o').length - 1, 0); c.bal = new G.Balance(G.SETS.plain, E.rng(ctx.seed + 4), { noFall: true, noGentle: true, stumbleAt: 9 }); this.load(ctx, 0); ctx.time = 0; ctx.dennis = G.regularRig('dennis', 1.7); },\n  load(ctx, i) { const data = G.TRAYS[ctx.T.trays[i]], w = data.rows[0].length, h = data.rows.length; ctx.w = w * CELL; ctx.h = h * CELL; ctx.ox = -ctx.w / 2; ctx.oy = -ctx.h / 2; ctx.tname = data.name; const world = ctx.world = new E.Physics({ gravity: [0, 0], sleep: false, on: { enter: (sen, b) => { if (sen.data && sen.data.glass && b.data && b.data.olive && !b.off) { b.off = true; ctx.world.remove(b); ctx.olives = ctx.olives.filter(o => o !== b); ctx.local.s.in++; sen.data.fill++; G.sfx('plop'); if (ctx.local.input && ctx.local.input.rumble) ctx.local.input.rumble(.3, .1); } }, hit: (a, b) => { const s = Math.hypot(a.vx - b.vx, a.vy - b.vy); if (s > 50 && ctx.ct <= 0) { ctx.ct = .08; G.sfx('trayClink', { vol: Math.min(.35, s / 300) }); } } } }); ctx.ct = 0; ctx.olives = []; ctx.glasses = []; ctx.bumpers = []; ctx.walls = []; ctx.gecko = null;\n    data.rows.forEach((row, ry) => [...row].forEach((ch, cx) => { const x = ctx.ox + cx * CELL + 6, y = ctx.oy + ry * CELL + 6; if (ch === '#') { world.box(x, y, CELL, CELL, { type: 'static', bounce: .2, friction: .2 }); ctx.walls.push([x, y]); } else if (ch === 'o') { const o = world.circle(x, y, 4.2, { bounce: .3, friction: .1, damping: .3, data: { olive: true }, density: .02 }); ctx.olives.push(o); } else if (ch === 'U') { const q = world.circle(x, y, 6, { type: 'static', sensor: true, data: { glass: true, fill: 0 } }); ctx.glasses.push(q); } else if (ch === 'B') { const q = world.bumper(x, y, 7, { kick: 90 }); ctx.bumpers.push(q); } else if (ch === 'G') { ctx.gecko = { b: world.box(x, y, 16, 7, { type: 'kinematic', bounce: .4 }), a: x, dir: 1, t: 0, y }; } })); },\n  botFill(ctx, c, skill, dt) { const cfg = { poor: [.9, .6, .5], average: [1.5, .25, .9], good: [2, .1, 1.25], expert: [2.4, .03, 1.5] }[skill], o = ctx.olives[0]; if (!o) { c.intent.ux = c.intent.uy = 0; return; } let bo = o, bq = null, bd = 1e9; const midW = ctx.walls.filter(w => Math.abs(w[0]) < ctx.w / 2 - 14 && Math.abs(w[1]) < ctx.h / 2 - 14); const side = (a, b) => midW.some(w => { const steps = 8; for (let t = 1; t < steps; t++) { const x = a.x + (b.x - a.x) * t / steps, y = a.y + (b.y - a.y) * t / steps; if (Math.abs(x - w[0]) < 8 && Math.abs(y - w[1]) < 8) return true; } return false; }); for (const q of ctx.olives) for (const g of ctx.glasses) { const d = Math.hypot(q.x - g.x, q.y - g.y) + (side(q, g) ? 400 : 0); if (d < bd) { bd = d; bo = q; bq = g; } } if (!bq) return; const wig = cfg[1] * Math.sin(ctx.t * 2.1), dx = bq.x - bo.x, dy = bq.y - bo.y, dd = Math.hypot(dx, dy) || 1, sp = Math.min(cfg[2] * 40, dd * 1.2), vx = dx / dd * sp - bo.vx, vy = dy / dd * sp - bo.vy; c.intent.ux = clamp(vx * .03 * cfg[0] + wig, -1, 1); c.intent.uy = clamp(-(vy * .03 * cfg[0]) + wig * .7, -1, 1); },\n  update(dt, ctx) { const c = ctx.local, D = G.DEV, Gv = D.trayG * ctx.T.G; c.bal.step(dt, c.intent.ux, c.intent.uy); const w = ctx.world; w.gravity = [c.bal.px * Gv, -c.bal.py * Gv]; w.wake(); ctx.ct -= dt; if (ctx.gecko) { const q = ctx.gecko; q.t += dt; const nx = q.a + Math.sin(q.t * .55) * 72; q.b.moveTo(nx, q.y, 0, 60, 2); } for (const o of ctx.olives) { o.friction = D.trayFric * .25; } w.step(dt);\n    if (!ctx.olives.length) { if (ctx.idx + 1 < ctx.T.trays.length) { ctx.idx++; this.load(ctx, ctx.idx); ctx.say('dennis', 'Olive?', 2); } else ctx.done = true; } if (ctx.t >= ctx.dur) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; ctx.dennis.mocap = G.sampleLoop('Idle_Subtle', ctx.time); G.place(ctx.dennis, dt, 0, 0, 0, 1.5); },\n  result(ctx, c) { const left = Math.max(0, ctx.dur - ctx.t) / ctx.dur; return { pct: c.s.in / ctx.total * (.8 + .2 * left), detail: 'Olives in: ' + c.s.in + ' of ' + ctx.total + '. Dennis nodded at the glasses, not at you.' }; },\n  enterView() { game.focus(0, 0, 0); },\n  draw(r, ctx) { const g = r.ctx, b = ctx.local.bal, tz = (x, y) => -(x * b.px - y * b.py) / (ctx.w / 2) * TILT * -1; game.focus(0, 6, 0); G.band(g, 0, 0, r.W, r.H, '#f7ecd8', '#e3cfa8', 6); for (let i = 0; i < 12; i++) px.rect(g, i * r.W / 12, 0, 1, r.H, '#ecdcbc');\n    // Dennis, the bar and the blender beyond the tray\n    const P3 = (x, y, z = 0) => { const q = r.w(x, y, tz(x, y) + z); return [q[0], q[1]]; }, W = ctx.w / 2 + 8, H = ctx.h / 2 + 8; px.rect(g, 0, 0, r.W, 42, '#dff0f4'); px.rect(g, 0, 40, r.W, 3, '#b9cbd2'); G.PROPS.blender(g, r.W * .8, 40); G.PROPS.fern(g, r.W * .1, 40, game.real);\n    px.poly(g, [P3(-W, -H, -5), P3(W, -H, -5), P3(W, H, -5), P3(-W, H, -5)], '#8a6a42'); px.poly(g, [P3(-W, -H), P3(W, -H), P3(W, H), P3(-W, H)], '#f6fafa'); const in2 = 5; px.poly(g, [P3(-W + in2, -H + in2), P3(W - in2, -H + in2), P3(W - in2, H - in2), P3(-W + in2, H - in2)], '#e8f4f6');\n    for (const q of ctx.walls) { const s = 6; const a = P3(q[0] - s, q[1] - s, 5), bb = P3(q[0] + s, q[1] - s, 5), c2 = P3(q[0] + s, q[1] + s, 5), d = P3(q[0] - s, q[1] + s, 5), e = P3(q[0] - s, q[1] + s), f2 = P3(q[0] + s, q[1] + s); px.poly(g, [d, c2, f2, e], '#c6a374'); px.poly(g, [a, bb, c2, d], '#e0c79c'); }\n    for (const q of ctx.bumpers) { const c0 = P3(q.x, q.y, 2); px.ell(g, c0[0], c0[1], 9, 6, '#e85d8a'); px.ell(g, c0[0], c0[1] - 2, 7, 4, '#ffb0c8'); }\n    for (const q of ctx.glasses) { const c0 = P3(q.x, q.y); px.ell(g, c0[0], c0[1], 8, 5, '#9fc6d0'); px.ell(g, c0[0], c0[1], 6, 4, '#f0fbff'); px.ell(g, c0[0], c0[1] + 1, 4, 2, '#d0f0f8'); px.line(g, c0[0], c0[1], c0[0] + 7, c0[1] - 8, '#8a6a42'); for (let n = 0; n < q.data.fill; n++) px.disc(g, c0[0] - 2 + n * 2, c0[1], 2, '#7a9a3a'); }\n    if (ctx.gecko) { const q = ctx.gecko.b, c0 = P3(q.x, q.y, 2), dir = Math.cos(ctx.gecko.t * .55) > 0 ? 1 : -1; px.ell(g, c0[0], c0[1], 9, 4, '#7bd389'); px.disc(g, c0[0] + dir * 9, c0[1] - 1, 3, '#55b878'); px.rect(g, c0[0] + dir * 10, c0[1] - 2, 1, 1, '#20404c'); px.line(g, c0[0] - dir * 9, c0[1], c0[0] - dir * 15, c0[1] + Math.sin(game.real * 5) * 2, '#55b878'); for (const l of [-5, 5]) { const st = Math.sin(game.real * 8 + l); px.rect(g, c0[0] + l, c0[1] + 3 + st, 2, 2, '#55b878'); px.rect(g, c0[0] + l, c0[1] - 4 - st, 2, 2, '#55b878'); } }\n    for (const o of ctx.olives) { const c0 = P3(o.x, o.y, 3); px.ell(g, c0[0] + 1, P3(o.x, o.y)[1] + 1, 5, 2, '#b8c8cc'); px.disc(g, c0[0], c0[1], 5, '#5e7a2a'); px.disc(g, c0[0], c0[1], 4, '#86a83e'); px.rect(g, c0[0] - 2, c0[1] - 2, 2, 1, '#c8e07a'); px.rect(g, c0[0] + 1, c0[1] + 1, 2, 2, '#e0553a'); } },\n  hud(g, r, ctx) { G.hudTop(g, r, ctx.tname + ': ' + ctx.local.s.in + ' of ' + ctx.total, G.fmtT(ctx.dur - ctx.t)); const R = 18, x = r.W - 30, y = r.H - 44; G.drawPlate(g, ctx.local.bal, x, y, R, { t: game.real }); }\n});\nEOF\ncat > game/activities/laundry.js <<'EOF'\n// Laundry Line: walk a clothesline between bungalows. x only. Effort is walking; going faster is harder. Gusts come with a sock in front.\nconst ROPE_Z = 58, POSTH = 72;\nG.activity({ id: 'laundry', family: 'laundry', discipline: 'Balance', name: 'Laundry Line', tierName: 'A Windier Day', view: 'side', coachKey: 'games', song: 'laundry',\n  says: 'Walk the line. Effort sets your pace, and faster is harder. Jump the pegs. You may not walk on the laundry. The sign is very clear.',\n  controls: (src, lean, L) => [[L('breath'), src === 'pad' ? 'Pace, analog' : 'Hold to walk'], [lean.replace('WASD', 'A D'), 'Lean left and right'], [L('jump'), 'Jump the pegs']],\n  prompts: (ctx) => [['breath', 'Walk'], ['lean', 'Lean'], ['jump', 'Jump']],\n  setup(ctx) { const T = ctx.T, c = ctx.local, R = ctx.R = E.rng(ctx.seed + 31); c.s = { x: 8, z: ROPE_Z, vz: 0, air: false, v: 0, falls: 0, time: 0, fall: 0, lastPost: 8, gust: null, gustT: T.gustEvery, tele: 0, dir: 1, fx: 0, walk: 0 }; c.bal = new G.Balance(Object.assign({}, G.SETS[T.set]), E.rng(ctx.seed + 6), { xOnly: true, noFall: ctx.cheat }); c.bal.onFall = () => { this.fall(ctx); };\n    ctx.posts = [8]; let x = 8; for (const s of T.spans) { x += s; ctx.posts.push(x); } ctx.len = x; ctx.pins = []; for (let i = 0; i < T.pins; i++) { const u = (i + .5) / T.pins; ctx.pins.push({ x: 30 + u * (ctx.len - 50) + (R() - .5) * 12 }); } ctx.laundry = []; for (let i = 0; i * 26 < ctx.len; i++) ctx.laundry.push({ x: 14 + i * 26 + R() * 8, k: Math.floor(R() * 4), c: G.pick(['#f6fafa', '#2cc6e6', '#ff7a59', '#f5c84b', '#c79be8'], R) }); ctx.time = 0; c.rig.wob = [0, 0]; },\n  fall(ctx) { const s = ctx.local.s; s.fall = 1.3; s.falls++; s.time += 3; ctx.say && Math.random() < .4 && ctx.say('tare', G.line('fall'), 2.5); G.sfx('stumble'); },\n  botFill(ctx, c, skill, dt) { G.leanBotFill(ctx, c, dt); const s = c.s, cfg = { poor: .55, average: .6, good: .72, expert: .85 }[skill]; c.intent.effort = cfg; c.intent.breath = cfg; c.intent.jump = false; const v = s.v || 8, tol = { poor: .3, average: .55, good: .9, expert: 1 }[skill], R = s.R || (s.R = E.rng(ctx.seed + 15)); for (const p of ctx.pins) { if (p.tried) continue; const d = p.x - s.x; if (d > 0 && d < v * .16 + 1.5) { p.tried = true; if (R() < tol + .05) c.intent.jump = true; } } },\n  update(dt, ctx) { const c = ctx.local, s = c.s, T = ctx.T, i = c.intent, b = c.bal; s.time += dt; if (ctx.t > 130) { ctx.done = true; return; }\n    if (s.fall > 0) { s.fall -= dt; s.z = Math.max(4, s.z - dt * 60); if (s.fall <= 0) { s.x = s.lastPost; s.z = ROPE_Z; b.px = b.py = b.vx = b.vy = 0; b.stumbleT = 0; s.v = 0; for (const p of ctx.pins) p.tried = false; G.sfx('boop', { vol: .2 }); } return; }\n    s.gustT -= dt; if (!s.gust && s.gustT <= 0) { s.gustT = T.gustEvery; s.gust = { t: 1.4, dir: ctx.R() < .5 ? -1 : 1 }; G.sfx('sock'); }\n    let fx = 0; if (s.gust) { s.gust.t -= dt; if (s.gust.t < .6) fx = s.gust.dir * 9 * G.DEV.gust; if (s.gust.t <= 0) { s.gust = null; G.sfx('whoosh', { vol: .3 }); } }\n    const eff = clamp(i.effort, 0, 1), speedW = T.speed * eff * 2; s.v += (speedW - s.v) * Math.min(1, dt * 5); const stair = (eff > .6 ? (eff - .6) / .4 : 0) * 4;\n    if (s.air) { s.vz -= 520 * dt; s.z += s.vz * dt; b.frozen = true; if (s.z <= ROPE_Z) { s.z = ROPE_Z; s.air = false; b.frozen = false; G.sfx('rope', { vol: .5 }); } } else if (i.jump) { s.air = true; s.vz = 150; G.sfx('jump', { vol: .3 }); }\n    b.step(dt, i.ux, 0, { fx, s: stair * G.DEV.ropeS }); s.x += s.v * dt; if (s.v > 2) { s.walk += s.v * dt; s.rp = (s.rp || 0) - dt; if (s.rp <= 0) { s.rp = .6; G.sfx('rope', { vol: .2 + b.lean * .4 }); } }\n    for (const p of ctx.posts) if (s.x >= p && s.lastPost < p) { s.lastPost = p; G.sfx('chime', { vol: .25 }); }\n    if (!s.air && !ctx.cheat) for (const p of ctx.pins) { if (Math.abs(p.x - s.x) < 1.2 && !p.bumped) { p.bumped = true; b.vx += (b.px >= 0 ? 1 : -1) * 1.1; game.after(.8, () => { p.bumped = false; }); G.sfx('tick', { vol: .4 }); } }\n    if (s.x >= ctx.len) { s.finished = true; ctx.done = true; } },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const c = ctx.local, s = c.s, rig = c.rig, b = c.bal; rig.wob = [0, 0]; rig.lean = 0; const tilt = b.px * .55; rig.body = null; if (s.fall > 0) { rig.mocap = G.sampleLoop('Dizzy', ctx.time); } else if (s.v > 1) { rig.mocap = null; } else rig.mocap = G.sampleLoop('Idle_Subtle', ctx.time);\n    const prev = rig.solvePose; rig.tilt_ = tilt; rig.update(dt, { x: s.x, y: 0, z: s.z, vx: s.v, vy: 0, facing: 0, air: s.air }); rig.wob = [tilt, 0]; rig.px = s.x; rig.py = 0; rig.pz = s.z; game.focus(s.x + 30, 0, 40); },\n  result(ctx, c) { const s = c.s, T = ctx.T, frac = Math.min(1, s.x / ctx.len), score = clamp((T.worst - s.time) / (T.worst - T.par), 0, 1); return { pct: (s.finished ? score : frac * .2) - .02 * s.falls, detail: 'Time ' + s.time.toFixed(0) + ' s. Falls: ' + s.falls + '. The laundry is fine.' }; },\n  draw(r, ctx) { const g = r.ctx, s = ctx.local.s, t = game.real; G.band(g, 0, 0, r.W, r.H * .7, G.PAL.sky1, G.PAL.sky2, 8); G.band(g, 0, r.H * .7, r.W, r.H * .3, '#7cc47e', '#5eae68', 4); const gy = r.w(s.x, 0, 0)[1]; if (gy < r.H) px.rect(g, 0, gy, r.W, r.H - gy, '#6fba74');\n    for (let i = 0; i < 6; i++) { const bx = ((i * 90 - s.x * .3) % (r.W + 120) + r.W + 120) % (r.W + 120) - 60; px.rect(g, bx, gy - 26, 44, 26, '#f6efe0'); px.poly(g, [[bx - 4, gy - 26], [bx + 48, gy - 26], [bx + 22, gy - 42]], '#e0553a'); px.rect(g, bx + 17, gy - 16, 10, 16, '#2cc6e6'); }\n    const W = (x, z) => r.w(x, 0, z), a = W(ctx.posts[0] - 40, ROPE_Z), b = W(ctx.len + 40, ROPE_Z); px.line(g, a[0], a[1], b[0], b[1], '#8a7a60', 1); for (const p of ctx.posts) { const q = W(p, 0), q2 = W(p, POSTH); px.rect(g, q[0] - 2, q2[1], 5, q[1] - q2[1], '#8a6a42'); px.rect(g, q2[0] - 6, q2[1] + 8, 13, 2, '#8a6a42'); r.ctx && 0; const hx = W(p, 0); px.rect(g, hx[0] + 6, hx[1] - 14, 16, 14, '#c9a56e'); px.rect(g, hx[0] + 7, hx[1] - 15, 14, 3, '#f6fafa'); }\n    for (const q of ctx.laundry) { const o = W(q.x, ROPE_Z), sw = Math.sin(t * 2 + q.x) * 2; if (q.k === 0) { px.rect(g, o[0] - 5 + sw, o[1], 11, 12, q.c); px.rect(g, o[0] - 8 + sw, o[1], 3, 5, q.c); px.rect(g, o[0] + 6 + sw, o[1], 3, 5, q.c); } else if (q.k === 1) { px.rect(g, o[0] - 2 + sw, o[1], 4, 12, q.c); px.rect(g, o[0] - 2 + sw, o[1] + 10, 7, 3, q.c); } else { px.rect(g, o[0] - 8 + sw, o[1], 16, 9, q.c); } }\n    for (const q of ctx.pins) { const o = W(q.x, ROPE_Z); px.rect(g, o[0] - 2, o[1] - 7, 3, 8, '#b8905f'); px.rect(g, o[0] + 1, o[1] - 7, 1, 8, '#8a6a42'); }\n    const k = W(ctx.posts[0] + 6, 0); G.panel(g, k[0] - 40 + 30, k[1] - 40, 118, 28, { rad: 3 }); G.wrapText(g, 'Please do not walk on the laundry line.', k[0] - 6, k[1] - 37, 110, G.COL.INK, { gap: 0 });\n    if (s.gust) { const dir = s.gust.dir; for (let i = 0; i < 12; i++) { const yy = 20 + i * 15, xx = ((t * 180 * dir + i * 53) % r.W + r.W) % r.W; px.rect(g, xx, yy, 18, 1, '#ffffff'); } const sx = dir > 0 ? (1.4 - s.gust.t) * r.W * .8 : r.W - (1.4 - s.gust.t) * r.W * .8; px.rect(g, sx, 50, 5, 11, '#ff7a59'); px.rect(g, sx, 58, 8, 3, '#ff7a59'); }\n    G.actor(r, ctx.local.rig, { shadow: 0 }); },\n  hud(g, r, ctx) { const s = ctx.local.s, b = ctx.local.bal; G.hudTop(g, r, 'Falls ' + s.falls, s.time.toFixed(0) + ' s'); const W = 70, x = r.W / 2, y = r.H - 18; G.round(g, x - W - 6, y - 6, W * 2 + 12, 13, '#ffffff'); const R = b.R * W; px.rect(g, x - R, y - 2, R * 2, 5, '#bfeee0'); px.rect(g, x - W, y, W * 2, 1, '#c8dde2'); px.disc(g, x + clamp(b.px, -1, 1) * W, y, 3, G.COL.CORAL); const prog = clamp(s.x / ctx.len, 0, 1); px.rect(g, 12, 26, 70, 2, '#ffffff'); px.disc(g, 12 + prog * 70, 27, 3, G.COL.CORAL); if (s.gust && s.gust.t >= .6) G.text(g, s.gust.dir > 0 ? 'A sock, going right' : 'A sock, going left', r.W / 2, 28, G.COL.INK, { align: 'center', shadow: '#fff' }); }\n});\nEOF\n","description":"Write jog, slalom, tray and laundry activities"}}}
