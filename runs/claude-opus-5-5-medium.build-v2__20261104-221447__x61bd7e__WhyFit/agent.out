ce(.5); const c2 = game.scene.ctx.contestants[1]; ok(c2.input === p2 && !c2.bot, 'P2 plays with its own input'); p2.tap('right'); game.advance(1 / 120); game.advance(1 / 120); ok(true, ''); const seen = c2.intent.press.length === 4; ok(seen, 'P2 lanes read'); errs(env, 'half keyboard'); }\\n  { const env = load({ draw: true }), { G, game } = env; G.ensureMember(); game.go('act_stork', { mode: 'free' }, { fade: 0 }); game.advance(.1); G.Dev.open(); G.Dev.openPose(); const got = []; env.ctx.console.log = m => got.push(String(m)); const P = G.Dev.posing; const c0 = P.clip; game.input.tap('devD'); game.advance(.05); ok(G.Dev.posing.clip !== c0, 'Pose Viewer picks a clip'); game.input.hold('devR'); game.advance(.3); game.input.hold('devR', false); ok(G.Dev.posing.t > 0, 'Pose Viewer scrubs'); game.input.tap('devA'); game.advance(.05); ok(got.some(l => /clip: '.*a: .*tgt:/.test(l)), 'Pose Viewer prints a row: ' + got); errs(env, 'pose viewer'); }\")\nopen(p,'w').write(s)\np='tests/browser.mjs';s=open(p).read()\ns=s.replace(\"    // hover in the HTML menus\",\"\"\"    // Eyes Closed: no Plate, and its own tone on the sfx bus\n    const tone = await pg.evaluate(async () => { G.game.go('act_stork', { mode: 'free', tier: 1, seed: 4 }, { fade: 0 }); await new Promise(r => setTimeout(r, 500)); const s = G.game.scene; s.phase = 'play'; s.t = 0; const A = G.game.audio; if (A.ctx.state !== 'running') await A.ctx.resume(); await new Promise(r => setTimeout(r, 600)); const an = A.ctx.createAnalyser(); an.fftSize = 2048; A.bus('sfx').connect(an); const d = new Float32Array(2048); let peak = 0; for (let i = 0; i < 15; i++) { await new Promise(r => setTimeout(r, 40)); an.getFloatTimeDomainData(d); for (const v of d) peak = Math.max(peak, Math.abs(v)); } return { peak, eyes: !!s.ctx.T.eyesClosed, on: !!(s.ctx.tone && s.ctx.tone.os) }; }); ok(tone.eyes && tone.on && tone.peak > 0, 'Eyes Closed balance tone sounds: ' + JSON.stringify(tone));\n    // hover in the HTML menus\"\"\")\nopen(p,