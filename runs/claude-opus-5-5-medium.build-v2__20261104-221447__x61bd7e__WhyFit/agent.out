        pg.wait_for_timeout(2500)\n        pg.screenshot(path=f'{out}/{name}.png')\n        print(name, pg.evaluate('G.game.sceneName'), pg.evaluate('G.game.errors.map(e=>e.message).slice(0,3)'), msgs[:3])\n        pg.close()\n    b.close()\nEOF\nnode build.mjs && python3 tests/shot.py tests/shots title= stork='#act/stork/0|(()=>{const s=G.game.scene;s.phase=\"play\";G.Dev.applyBot()})()' stork_card='#act/stork/0' island='#day/2' 2>&1 | tail -6","description":"Write hub test and screenshot tool; take first screenshots","timeout":120000}}}
