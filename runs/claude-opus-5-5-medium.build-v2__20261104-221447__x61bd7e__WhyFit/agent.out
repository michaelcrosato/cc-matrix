{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjE1xbveH43a71sqsNqr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YYJHqJsVLBXjCS5abS1PPw","name":"Bash","input":{"command":"cd engine && node tools/asset-set.mjs src/assets/sets/kaykit-furniture-bits.js src/assets/sets/kenney-nature.js src/assets/sets/kenney-holiday.js src/assets/sets/kenney-graveyard.js --ids kaykit-furniture-bits:cactus-medium-a,kaykit-furniture-bits:cactus-medium-b,kenney-nature:pot-large,kenney-holiday:bench,kaykit-furniture-bits:bed-double-a,kenney-graveyard:lantern-glass --name whyfit --out ../vendor/whyfit-props.js --credit \"Kenney and KayKit (CC0)\" 2>&1 | tail -2; ls -la ../vendor/whyfit-props.js; head -c 300 ../vendor/whyfit-props.js; cd ..; sed -n 1,10p engine/docs/ASSETS.md | cut -c1-200\ncat > game/rooms.js <<'EOF'\n// Rooms: painted first in draw, on r.ctx, bright and clean. In the brawler view +y comes toward the camera.\nG.band = (g, x, y, w, h, c1, c2, n = 6) => { const step = h / n; for (let i = 0; i < n; i++) px.rect(g, x, Math.round(y + i * step), w, Math.ceil(step) + 1, E.mix(c1, c2, n > 1 ? i / (n - 1) : 0)); };\nG.PAL = { white: '#f6fafa', wall: '#dfe9ea', sky1: '#8fd3f4', sky2: '#d8f3fb', sea1: '#49b6c9', sea2: '#2f97ad', floor1: '#ecd9bd', floor2: '#d9bd96' };\nconst P = G.PAL;\nG.floorPoly = (r, g, pts, c) => px.poly(g, pts.map(p => { const q = r.w(p[0], p[1], p[2] || 0); return [q[0], q[1]]; }), c);\nG.mat = (r, x, y, c = '#bfeee0', w = 22, h = 14, o = {}) => { const g = r.ctx; G.floorPoly(r, g, [[x - w, y - h], [x + w, y - h], [x + w, y + h], [x - w, y + h]], E.mix(c, '#20404c', .18)); G.floorPoly(r, g, [[x - w + 1, y - h + 1], [x + w - 1, y - h + 1], [x + w - 1, y + h - 1], [x - w + 1, y + h - 1]], c); if (o.glow) { const k = .5 + .5 * Math.sin(G.game.real * 3); G.floorPoly(r, g, [[x - w + 3, y - h + 3], [x + w - 3, y - h + 3], [x + w - 3, y + h - 3], [x - w + 3, y + h - 3]], E.mix(c, '#ffffff', .25 + k * .35)); } for (let i = -3; i <= 3; i++) G.floorPoly(r, g, [[x - w + 2, y + i * h / 4], [x + w - 2, y + i * h / 4], [x + w - 2, y + i * h / 4 + .6], [x - w + 2, y + i * h / 4 + .6]], E.mix(c, '#ffffff', .4)); };\nconst seaAndSky = (r, g, top, h, t) => { G.band(g, 0, top, r.W, h * .62, P.sky1, P.sky2, 8); const sy = top + h * .62; G.band(g, 0, sy, r.W, h * .38, P.sea1, P.sea2, 5);\n  for (let i = 0; i < 16; i++) { const x = ((i * 67 + t * (4 + i % 3)) % (r.W + 20)) - 10, y = sy + 3 + (i * 13) % Math.max(4, h * .34); px.rect(g, x, y, 5 + i % 4 * 2, 1, '#bfeaf2'); }\n  for (let i = 0; i < 4; i++) { const x = ((i * 137 + t * 2) % (r.W + 60)) - 30, y = top + 8 + i * 9; px.ell(g, x, y, 16 + i * 3, 3, '#ffffff'); px.ell(g, x + 8, y - 2, 9, 2, '#f4fbfd'); } };\nconst planks = (r, g, c1, c2, y0 = -44, y1 = 90, n = 11) => { for (let i = 0; i < n; i++) { const a = y0 + (y1 - y0) * i / n, b = y0 + (y1 - y0) * (i + 1) / n; const pa = r.w(0, a, 0)[1], pb = r.w(0, b, 0)[1]; px.rect(g, 0, Math.round(pa), r.W, Math.ceil(pb - pa) + 1, E.mix(c1, c2, i / n)); px.rect(g, 0, Math.round(pb), r.W, 1, E.mix(c2, '#7c6a50', .35)); } const bot = r.w(0, y1, 0)[1]; if (bot < r.H) px.rect(g, 0, bot, r.W, r.H - bot + 1, c2); };\nconst boards = (r, g, c = '#c9ad85') => { for (let i = -12; i <= 12; i++) { const a = r.w(i * 24, -44, 0), b = r.w(i * 24, 90, 0); px.line(g, a[0], a[1], b[0], b[1], c); } };\nconst bunting = (r, g, y, colors = ['#ff7a59', '#2cc6e6', '#f5c84b', '#7bd389'], t = 0) => { const n = Math.ceil(r.W / 14); for (let i = 0; i < n; i++) { const x = i * 14 + 4, sag = Math.sin(i / n * Math.PI * 3) * 4; px.poly(g, [[x, y + sag], [x + 10, y + sag], [x + 5, y + sag + 8 + Math.sin(t * 3 + i) * .6]], colors[i % colors.length]); } px.rect(g, 0, y, r.W, 1, '#8aa4ad'); };\nG.ROOMS = {\n  studio(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb, P.white, P.wall, 5);\n    const w = Math.round(r.W * .72), x = (r.W - w) >> 1, h = Math.round(wb * .78), y = 8; px.rect(g, x - 3, y - 3, w + 6, h + 6, '#b9cbd2'); px.rect(g, x - 2, y - 2, w + 4, h + 4, '#ffffff'); const c = g; seaAndSkyClip(r, c, x, y, w, h, t); for (let i = 1; i < 3; i++) px.rect(g, x + w * i / 3, y, 2, h, '#ffffff'); px.rect(g, 0, wb - 3, r.W, 3, '#c8dde2');\n    planks(r, g, P.floor1, P.floor2); boards(r, g); },\n  deck(r, t, o = {}) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; seaAndSky(r, g, 0, wb + 6, t); px.rect(g, 0, wb - 6, r.W, 2, '#f4f8f8'); for (let i = 0; i <= 18; i++) px.rect(g, i * r.W / 18, wb - 6, 2, 10, '#eaf0f0'); planks(r, g, '#e3c79c', '#c6a374'); boards(r, g, '#b39268');\n    for (let i = 0; i < 5; i++) { const x = 18 + i * 6, y = 10, sw = Math.sin(t * 1.4 + i) * 2; px.line(g, x, 2, x + sw, y + i * 3, '#9fb3bb'); px.rect(g, x + sw - 1, y + i * 3, 3, 6, '#cfe6ee'); } },\n  iron(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb, '#fbfdfd', P.wall, 5); const mw = Math.round(r.W * .55), mx = (r.W - mw) >> 1, mh = Math.round(wb * .72); px.rect(g, mx - 2, 8, mw + 4, mh + 4, '#b9cbd2'); G.band(g, mx, 10, mw, mh, '#e4f2f5', '#cfe4e9', 4); for (let i = 0; i < 4; i++) px.line(g, mx + 10 + i * 40, 10 + mh - 2, mx + 36 + i * 40, 12, '#f0fafb');\n    px.rect(g, 0, wb - 3, r.W, 3, '#c8dde2'); G.band(g, 0, wb, r.W, r.H - wb, '#f0f4f4', '#d6e0e2', 6); for (let i = -10; i <= 10; i++) { const a = r.w(i * 28, -44, 0), b = r.w(i * 28, 90, 0); px.line(g, a[0], a[1], b[0], b[1], '#dbe5e7'); }\n    const sign = G.LINES.iron[Math.floor((G.state ? G.state.day : 1) - 1) % 4]; G.panel(g, 8, 10, Math.max(60, Math.min(mx - 14, 72)), 30, { rad: 3 }); G.wrapText(g, sign, 11, 13, Math.max(54, Math.min(mx - 20, 66)), G.COL.INK, { gap: 0 }); },\n  pier(r, t, o = {}) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; seaAndSky(r, g, 0, wb + 6, t); planks(r, g, '#d7b98d', '#b08f64'); boards(r, g, '#94754e'); px.rect(g, 0, wb - 4, r.W, 3, '#b08f64'); for (let i = 0; i <= 12; i++) px.rect(g, i * r.W / 12, wb - 12, 3, 12, '#9a7a52'); bunting(r, g, 10, undefined, t); },\n  reception(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb, P.white, P.wall, 5); px.rect(g, r.W * .08 - 2, 10, r.W * .34 + 4, wb * .7 + 4, '#b9cbd2'); seaAndSkyClip(r, g, r.W * .08, 12, r.W * .34, wb * .7, t); px.rect(g, 0, wb - 3, r.W, 3, '#c8dde2'); planks(r, g, '#f1e4d0', '#dcc7a9'); boards(r, g, '#cdb897');\n    G.panel(g, r.W * .55, 14, r.W * .32, 34, { rad: 3 }); G.wrapText(g, 'Gently, Or Not At All', r.W * .55 + 6, 22, r.W * .32 - 12, G.COL.ACCD, { gap: 1 }); },\n  bungalow(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb, '#f5e9d6', '#e6d3b4', 5); const wx = r.W * .62; px.rect(g, wx - 2, 8, r.W * .28 + 4, wb * .62 + 4, '#b89c72'); G.band(g, wx, 10, r.W * .28, wb * .62, '#3b4a78', '#e88a5a', 6); px.rect(g, 0, wb - 3, r.W, 3, '#b89c72'); planks(r, g, '#d9bd96', '#b89c72'); },\n  raft(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb * .75, '#3a3a78', '#f08a5a', 8); G.band(g, 0, wb * .75, r.W, wb * .35, '#f0a060', '#e8c080', 3); const sx = r.W * .7, sy = wb * .92; px.disc(g, sx, sy, 16, '#ffd890'); G.band(g, 0, wb, r.W, r.H - wb, '#2a6a86', '#144a66', 7); for (let i = 0; i < 22; i++) { const x = ((i * 53 + t * 5) % (r.W + 20)) - 10, y = wb + 4 + (i * 17) % Math.max(4, r.H - wb - 8); px.rect(g, x, y, 6 + (i % 4) * 2, 1, i % 3 ? '#3e8aa8' : '#f0a060'); }\n    const pts = [[-110, -24], [110, -24], [118, 34], [-118, 34]]; G.floorPoly(r, g, pts.map(p => [p[0], p[1], -2]), '#6a4a30'); G.floorPoly(r, g, pts, '#b08a5a'); for (let i = -5; i <= 5; i++) { const a = r.w(i * 21, -24, 0), b = r.w(i * 22, 34, 0); px.line(g, a[0], a[1], b[0], b[1], '#8a6a42'); } },\n  festival(r, t) { G.ROOMS.pier(r, t); bunting(r, r.ctx, 24, ['#e85d8a', '#f5c84b', '#2cc6e6'], t + 1); }\n};\nconst seaAndSkyClip = (r, g, x, y, w, h, t) => { x = Math.round(x); y = Math.round(y); w = Math.round(w); h = Math.round(h); G.band(g, x, y, w, h * .62, P.sky1, P.sky2, 6); G.band(g, x, y + h * .62, w, h * .38, P.sea1, P.sea2, 4); for (let i = 0; i < 9; i++) { const lx = x + ((i * 47 + t * 3) % w), ly = y + h * .62 + 2 + (i * 9) % Math.max(2, h * .32); px.rect(g, lx, ly, Math.min(5, x + w - lx), 1, '#bfeaf2'); } };\nG.lightFor = (kind) => { const L = game.lights; if (kind === 'morning') { L.enabled = true; L.ambient = .92; } else if (kind === 'dusk') { L.enabled = true; L.ambient = .62; } else L.enabled = false; };\n// small things the rooms are dressed with, all hand-drawn in place\nG.PROPS = {\n  dumbbell(g, x, y) { px.rect(g, x - 3, y - 1, 6, 1, '#7a8b92'); px.rect(g, x - 5, y - 2, 2, 3, '#4a5a62'); px.rect(g, x + 3, y - 2, 2, 3, '#4a5a62'); },\n  cooler(g, x, y) { px.rect(g, x - 5, y - 18, 10, 18, '#f4f8f8'); px.rect(g, x - 4, y - 28, 8, 10, '#a8dcec'); px.rect(g, x - 2, y - 12, 4, 2, '#2cc6e6'); },\n  fern(g, x, y, t = 0) { for (let i = -3; i <= 3; i++) { const sw = Math.sin(t * 1.2 + i) * 1; px.line(g, x, y, x + i * 3 + sw, y - 10 + Math.abs(i), i % 2 ? '#3d9a60' : '#55b878'); } px.rect(g, x - 4, y - 1, 8, 4, '#c9764a'); },\n  candle(g, x, y, flame, t = 0) { px.rect(g, x - 2, y - 8, 4, 8, '#fbf3df'); px.rect(g, x - 3, y, 6, 1, '#d8c8a0'); if (flame > 0) { const f = 2 + flame * 5, w = Math.sin(t * 9) * .8; px.poly(g, [[x - 2 - flame, y - 9], [x + 2 + flame, y - 9], [x + w, y - 9 - f * 1.6]], '#f5a742'); px.poly(g, [[x - 1, y - 9], [x + 1, y - 9], [x + w, y - 9 - f]], '#ffe58a'); } else px.rect(g, x, y - 10, 1, 2, '#555'); },\n  blender(g, x, y) { px.rect(g, x - 5, y - 6, 10, 6, '#556070'); px.rect(g, x - 4, y - 17, 8, 11, '#c8ecd8'); px.rect(g, x - 5, y - 18, 10, 2, '#556070'); }\n};\nEOF\ncat > game/scenes/session.js <<'EOF'\n// A session: Card -> instructor demonstrates -> Breathe in, 3 2 1 -> play -> stars -> Again or Done. Every activity is one\n// registry entry and becomes its own pausable scene here. Class, Attract, The Gentle Games and the hub round use the same scene.\nG.slots = n => n <= 1 ? [{ x: 0, y: 0, size: 2.1 }] : n === 2 ? [{ x: -44, y: 0, size: 1.9 }, { x: 44, y: 0, size: 1.9 }] : [{ x: -96, y: 0, size: 1.5 }, { x: -32, y: 0, size: 1.5 }, { x: 32, y: 0, size: 1.5 }, { x: 96, y: 0, size: 1.5 }].slice(0, 4);\nG.makeCtx = (def, data) => {\n  const tier = data.tier || 0, T = def.tiers[tier], seed = data.seed !== undefined ? data.seed : Math.floor(G.rng() * 1e9), rng = E.rng(seed);\n  const mode = data.mode || 'free', ctx = { def, id: def.id, tier, T, mode, classMode: mode === 'class', rng, seed, t: 0, done: false, cheat: !!data.cheat, short: !!data.short, festival: !!data.festival, guided: !!data.guided, data, limit: data.limit || null, duel: !!data.duel, contestants: [], local: null, ghosts: data.ghosts || null };\n  const list = data.contestants || [{ name: G.state ? G.state.name : 'You', input: game.input, color: G.COL.CORAL, local: true, bot: data.bot || null, rig: data.rig || null }];\n  const n = Math.max(list.length, data.mats || 0), slots = data.slots || G.slots(ctx.ghosts ? Math.max(n, 2) : n);\n  ctx.contestants = list.map((c, i) => { const slot = slots[i] || slots[0];\n    const o = { i, name: c.name, color: c.color, local: !!c.local, input: c.input || null, player1: c.input === game.input, bot: c.bot || null, forScore: c.forScore !== false, intent: G.newIntent(), score: 0, pct: 0, s: {}, slot, x: slot.x, y: slot.y };\n    if (c.rig) o.rig = c.rig; else if (G.state && c.local && !def.noRig) o.rig = G.memberRig(slot.size); else if (!def.noRig) o.rig = G.lookToRig({ hair: 'short', skin: i % 6, top: i % 8, bottom: i % 4 }, slot.size, {});\n    if (o.bot) o.lean = new G.LeanBot(o.bot, E.rng(seed + 11 + i * 7));\n    return o; });\n  ctx.local = ctx.contestants.find(c => c.local) || ctx.contestants[0];\n  if (G.TOOLS.bot && ctx.local && !ctx.local.bot) { ctx.local.bot = G.TOOLS.bot; ctx.local.lean = new G.LeanBot(G.TOOLS.bot, E.rng(seed + 3)); ctx.toolBot = true; }\n  ctx.say = (who, line, secs) => { if (ctx.mode === 'round') return; G.chat(who, line, secs); };\n  ctx.finish = () => { ctx.done = true; };\n  ctx.coachId = data.coach || G.coach();\n  return ctx;\n};\n// local effects of the Lean: the chime that climbs, the creak near the edge, the rumble\nG.leanFx = (c, ctx, dt) => { const b = c.bal; if (!b || !c.local) return; const s = c.s;\n  s.chT = (s.chT || 0) - dt; if (b.inRing && b.streak > 1.2 && s.chT <= 0) { s.chT = 1.4; G.sfx('chime', { vol: .18, pitch: 1 + Math.min(1, b.streak / 16) }); }\n  s.crT = (s.crT || 0) - dt; const e = b.lean; if (e > .72 && s.crT <= 0) { s.crT = .55; G.sfx('creak', { vol: .3 + (e - .72) }); if (c.input && c.input.rumble) c.input.rumble(.2 + (e - .7) * 1.2, .15); }\n  if (b.stumbleT > 0 && !s.st) { s.st = true; G.sfx('stumble'); if (c.input && c.input.rumble) c.input.rumble(.7, .35); if (ctx.mode !== 'attract' && ctx.mode !== 'round' && G.rng() < .35) G.chat('tare', G.line('fall')); } if (b.stumbleT <= 0) s.st = false; };\nG.playStep = (ctx, dt) => { const def = ctx.def;\n  for (const c of ctx.contestants) { if (c.bot) { if (def.botFill) def.botFill(ctx, c, c.bot, dt); } else if (c.input) G.fillDevice(c, ctx, dt); }\n  def.update(dt, ctx); for (const c of ctx.contestants) G.leanFx(c, ctx, dt);\n  ctx.t += dt; if (ctx.limit && ctx.t >= ctx.limit) ctx.done = true; };\nG.resultOf = (ctx, c) => { const def = ctx.def, res = def.result(ctx, c), pct = clamp(res.pct, 0, 1); c.pct = pct; c.score = Math.round(pct * 1000); c.stars = G.starsFor(def, pct); c.detail = res.detail || ''; return c; };\nG.record = (ctx, c) => { const st = G.state; if (!st) return { minutes: 0, unlocked: [] }; const id = ctx.id, b = st.best[id] = st.best[id] || {}, k = ctx.tier, prev = b[k]; if (!prev || c.pct > prev.pct) b[k] = { pct: c.pct, stars: c.stars }; st.played[id] = true;\n  const before = G.unlockedItems(st).length, suggested = st.suggestion === id, m = 2 * (1 + .25 * c.stars) * (suggested ? 1.5 : 1) * G.DEV.minutes; st.minutes = Math.round((st.minutes + m) * 10) / 10; st.age = st.day === 3 && !st.finished ? st.heldAge : G.computeAge(st); if (c.stars >= 2 && st.day === 2) st.flags.nod = true; return { minutes: m, suggested, unlocked: G.unlockedItems(st).slice(before) }; };\nG.activity = def => {\n  Object.assign(def, G.ACTDATA[def.id] || {}); G.acts[def.id] = def; G.actOrder.push(def.id);\n  const scene = { pausable: true, view: def.view || 'brawler', camera: { zoom: false }, phase: 'card',\n    enter(data) { data = data || {}; this.data = data; G.talk.close(); const ctx = this.ctx = G.makeCtx(def, data); this.t = 0; this.resT = 0; this.pills = null; this.line = null;\n      def.setup(ctx); if (def.animate) def.animate(1 / 120, ctx);\n      const mode = ctx.mode; this.phase = data.skipCard || mode === 'class' ? 'count' : mode === 'attract' || mode === 'round' ? 'play' : 'card';\n      if (this.phase === 'card') this.makeCardPills(); G.music(def.song || (ctx.T && ctx.T.song) || 'studio', ctx.T && ctx.T.song ? { restart: false } : undefined);\n      if (data.again) this.phase = 'count'; if (this.phase === 'count') this.countIn(); G.lastAct = { name: 'act_' + def.id, data };\n      G.lightFor(ctx.duel ? 'dusk' : def.light || null); if (def.enterView) def.enterView(ctx); },\n    exit() { const ctx = this.ctx; if (def.cleanup) def.cleanup(ctx); G.lightFor(null); game.input.stopRumble && game.input.stopRumble(); G.setHand(false); },\n    countIn() { this.t = 0; if (this.ctx.mode !== 'class') G.sfx('boop', { vol: .2 }); },\n    makeCardPills() { const items = [{ label: 'Begin', on: () => { this.phase = 'demo'; this.t = 0; G.talk.close(); const line = G.coachLine(def.coachKey || 'hold'); if (!def.noDemoLine) G.chat(G.coach(), line, 3); } }];\n      const st = G.state, ctx = this.ctx; if (ctx.mode !== 'games' && st && def.tiers[1] && (ctx.tier === 1 || G.tier2Open(st, def.id))) items.push({ label: ctx.tier === 1 ? 'Back to the first tier' : 'Harder: ' + (def.tierName || 'Second tier'), on: () => { game.go(this.name, Object.assign({}, this.data, { tier: ctx.tier === 1 ? 0 : 1 }), { fade: 0 }); } });\n      if (ctx.mode !== 'games') items.push({ label: 'Not now', on: () => this.leave(true) });\n      this.pills = new G.Pills(items, { dir: 'h', onBack: ctx.mode === 'games' ? null : () => this.leave(true) }); },\n    leave(skip) { const ctx = this.ctx, st = G.state; G.talk.close();\n      if (this.data.onDone) { this.data.onDone(ctx.local, skip); return; }\n      if (!skip && ctx.mode === 'story' && st) { st.session++; st.lastActivity = def.id; G.save(); }\n      game.go(ctx.mode === 'free' && this.data.from ? this.data.from : 'island'); },\n    update(dt) { const ctx = this.ctx; this.t += dt; if (G.talk.update(dt)) return;\n      if (this.phase === 'card') { if (this.pills) this.pills.update(dt); if (def.animate) def.animate(dt, ctx); return; }\n      if (this.phase === 'demo') { if (def.animate) def.animate(dt, ctx); if (this.t > 3 || game.input.pressed('confirm')) { this.phase = 'count'; this.countIn(); } return; }\n      if (this.phase === 'count') { if (def.animate) def.animate(dt, ctx); if (Math.floor(this.t) !== Math.floor(this.t - dt) && this.t < 3 && this.t > 0) G.sfx('tick', { vol: .4 }); if (this.t >= 3) { this.phase = 'play'; this.t = 0; G.sfx('boop', { vol: .3 }); if (def.begin) def.begin(ctx); } return; }\n      if (this.phase === 'play') { G.setHand(G.source(game.input) === 'mouse'); G.playStep(ctx, dt); if (def.animate) def.animate(dt, ctx); if (ctx.done) this.finish(); return; }\n      if (this.phase === 'results') { this.resT += dt; if (def.animate) def.animate(dt, ctx); this.tickResults(dt); if (this.pills && this.resT > 1.2) this.pills.update(dt); } },\n    finish() { const ctx = this.ctx; G.setHand(false); for (const c of ctx.contestants) G.resultOf(ctx, c); if (def.stop) def.stop(ctx);\n      if (ctx.mode === 'attract') { G.Attract.next(); return; }\n      if (ctx.mode === 'round') return;\n      if (ctx.mode === 'class') { this.data.onDone(ctx); return; }\n      const c = ctx.local; this.phase = 'results'; this.resT = 0; this.reward = G.record(ctx, c); G.stars = c.stars; this.coins = []; this.coinT = 0; this.stampT = 0; this.stamped = 0; G.save(); G.stopMusic();\n      const leave = { label: 'Done', on: () => this.leave(false) }, again = { label: 'Again', on: () => game.go(this.name, Object.assign({}, this.data, { again: true, tier: ctx.tier }), { fade: 0 }) };\n      this.pills = new G.Pills(ctx.mode === 'games' ? [leave] : [again, leave], { dir: 'h', start: ctx.mode === 'games' ? 0 : 1 });\n      G.talk.say(G.line('star' + c.stars), Object.assign(G.speaker('tare'), { auto: 4.5, modal: false, place: 'top' }));\n      if (def.onResults) def.onResults(ctx, c); },\n    tickResults(dt) { const c = this.ctx.local; this.stampT += dt; if (this.stamped < c.stars && this.stampT > .35 + this.stamped * .35) { this.stamped++; G.sfx('stamp'); G.sting('star' + this.stamped); game.shake(1); } if (this.stampT > .4 + c.stars * .35 && !this.spawned) { this.spawned = true; const n = Math.ceil(this.reward.minutes); for (let i = 0; i < n; i++) this.coins.push({ t: -i * .14, x: 0 }); }\n      for (const k of this.coins) { const b = k.t; k.t += dt; if (b < .7 && k.t >= .7) { G.sfx('clink', { vol: .4, pitch: 1 + Math.random() * .1 }); this.gulp = 1; } } this.gulp = Math.max(0, (this.gulp || 0) - dt * 5);\n      if (this.spawned && !this.announced && this.coins.every(k => k.t > .8)) { this.announced = true; if (this.reward.unlocked.length) { G.sting('unlock'); const u = this.reward.unlocked[0]; G.talk.say(G.LINES.unlock[u.id], Object.assign(G.speaker('tare'), { auto: 4, modal: false, place: 'top' })); } else if (G.rng() < .4) G.talk.say(G.line('gerald'), Object.assign(G.speaker('tare'), { auto: 4, modal: false, place: 'top' })); } },\n    draw(r) { const ctx = this.ctx; def.draw(r, ctx); r.overlay(g => { if (this.phase === 'play' || this.phase === 'count' || this.phase === 'demo') { if (def.hud) def.hud(g, r, ctx); } if (ctx.festival) G.drawFestivalBanner(g, r); });\n      if (this.phase === 'card') r.overlay(g => { G.drawActCard(g, r, ctx); this.pills.draw(g); });\n      if (this.phase === 'count') r.overlay(g => { const n = 3 - Math.floor(this.t); G.text(g, 'Breathe in', r.W / 2, r.H * .28, G.COL.INK, { align: 'center', scale: 2 }); G.text(g, String(Math.max(1, n)), r.W / 2, r.H * .28 + 22, G.COL.ACCD, { align: 'center', scale: 3 }); });\n      if (this.phase === 'demo') r.overlay(g => G.text(g, def.name, r.W / 2, 26, G.COL.INK, { align: 'center', scale: 2 }));\n      if (this.phase === 'results') r.overlay(g => { G.drawResults(g, r, ctx, this); this.pills.draw(g); });\n      if (this.phase === 'play' && def.prompts) G.prompt(r, def.prompts(ctx));\n      if (this.phase === 'card' || this.phase === 'results') G.prompt(r, [['confirm', 'Choose']], { y: 6 });\n      G.talk.draw(r); if (this.phase === 'play') G.drawHand(r); } };\n  scene.name = 'act_' + def.id; def.scene = scene; G.scene(scene.name, scene); return def;\n};\nG.drawFestivalBanner = (g, r) => { const s = 'The Gentle Games', w = E.font.width(s) + 12; G.round(g, r.W - w - 118, 8, w, 14, '#f5c84b'); G.text(g, s, r.W - w - 112, 12, G.COL.INK); };\nG.deviceText = (ctx, lines) => { const src = G.source(game.input); return lines[src] || lines.keys; };\nG.drawActCard = (g, r, ctx) => { const def = ctx.def, w = Math.min(r.W - 60, 320), h = 128, x = (r.W - w) >> 1, y = Math.max(16, (r.H - h - 30) >> 1) - 8, st = G.state;\n  G.panel(g, x, y, w, h); G.text(g, def.name + (ctx.tier ? ': ' + (def.tierName || 'Second tier') : ''), x + 12, y + 9, G.COL.INK, { scale: 2 }); G.text(g, def.discipline, x + w - 12, y + 12, G.COL.ACCD, { align: 'right' });\n  let yy = y + 30; yy += G.wrapText(g, ctx.tier && def.tierSays ? def.tierSays : def.says, x + 12, yy, w - 24, G.COL.INK) + 4;\n  for (const row of G.controlsFor(def)) { const lab = row[0], wl = E.font.width(lab) + 8; G.round(g, x + 12, yy - 2, wl, 11, G.COL.ACC); G.text(g, lab, x + 16, yy, '#fff'); G.text(g, row[1], x + 16 + wl, yy, G.COL.INK); yy += 13; }\n  const sx = x + 16, sy = y + h - 12; const stars = def.stars; for (let i = 0; i < 3; i++) { const cx = sx + i * 58; G.starSprite(g, cx, sy, st && G.bestStars(st, def.id) > i, 1); G.text(g, Math.round(stars[i] * 100) + '%', cx + 9, sy - 3, G.COL.MUT); }\n  const b = st && st.best[def.id] && st.best[def.id][ctx.tier]; G.text(g, b ? 'Best ' + Math.round(b.pct * 100) + '%' : 'Not yet tried', x + w - 12, sy - 3, G.COL.CORAL, { align: 'right' }); };\nG.controlsFor = def => { const src = G.source(game.input), lean = G.leanLabel(); return def.controls(src, lean, a => G.promptLabel(a)); };\nG.drawResults = (g, r, ctx, sc) => { const c = ctx.local, w = Math.min(r.W - 70, 300), h = 104, x = (r.W - w) >> 1, y = Math.max(44, (r.H - h - 30) >> 1) - 4; G.panel(g, x, y, w, h);\n  G.text(g, ctx.def.name, x + 12, y + 9, G.COL.INK, {}); G.text(g, Math.round(c.pct * 100) + '%', x + w - 12, y + 7, G.COL.CORAL, { align: 'right', scale: 2 });\n  for (let i = 0; i < 3; i++) { const on = i < sc.stamped, k = on && sc.stamped === i + 1 ? 1 + Math.max(0, .5 - (sc.stampT - (.35 + i * .35)) * 2) : 1; G.starSprite(g, x + 30 + i * 34, y + 38, on, 2, k); }\n  G.wrapText(g, c.detail, x + 12, y + 60, w - 90, G.COL.MUT); const gx = x + w - 40, gy = y + h - 12; G.drawGeraldAt(g, gx, gy, 1.2, G.state && G.state.minutes >= 30, sc.gulp || 0);\n  for (const k of sc.coins) if (k.t > 0 && k.t < .75) { const u = k.t / .7, cx = x + w * .45 + (gx - x - w * .45) * u, cy = y + 70 + (gy - 28 - y - 70) * u - Math.sin(u * Math.PI) * 26; px.disc(g, cx, cy, 3, '#f5c84b'); px.rect(g, cx - 1, cy - 1, 1, 1, '#fff2c0'); }\n  const m = sc.reward; G.text(g, '+' + (Math.round(m.minutes * 10) / 10) + ' min' + (m.suggested ? ' (Suggested)' : ''), x + 12, y + h - 13, G.COL.ACCD); };\n// with a mouse: hide the OS cursor over the canvas during activities and draw a small soft hand instead\nG.setHand = on => { G.handOn = on; if (typeof document === 'undefined' || !document.getElementById) return; const c = document.getElementById('screen'); if (c && c.style) c.style.cursor = on ? 'none' : ''; };\nG.drawHand = r => { if (!G.handOn) return; const p = game.input.pointer && game.input.pointer(); if (!p) return; r.overlay(g => { px.disc(g, p[0], p[1], 3, '#ffd9c8'); px.disc(g, p[0] - 1, p[1] - 1, 1, '#ffffff'); for (let i = -1; i <= 1; i++) px.rect(g, p[0] + i * 2, p[1] - 5, 1, 2, '#ffd9c8'); }); };\nG.restartSession = () => { if (G.lastAct && game.sceneName === G.lastAct.name && !G.inSession) { game.resume(); game.go(G.lastAct.name, Object.assign({}, G.lastAct.data, { again: true }), { fade: 0 }); } else game.resume(); };\nEOF\ncat > game/activities/hold.js <<'EOF'\n// Stork Stand and Sun Flow: hold the dot in the ring. Sun Flow adds the breath.\nconst setFor = T => G.SETS[T.set];\nG.setupBal = (ctx, c, set, o = {}) => { c.bal = new G.Balance(set, E.rng(ctx.seed + 100 + c.i * 13), Object.assign({ noFall: ctx.cheat }, o)); };\n// every lean-based bot: correct toward the ring\nG.leanBotFill = (ctx, c, dt) => { const b = c.bal, [ux, uy] = c.lean.step(dt, b.px - b.ringX, b.py - b.ringY, b.vx, b.vy); c.intent.ux = ux; c.intent.uy = uy; };\nconst rigStep = (rig, dt, x, y, tgt, wob, pose, extra) => { rig.wob = wob; rig.mocap = pose; rig.body = null; G.place(rig, dt, x, y, 0, tgt, extra); };\nG.balPose = (c, poseName, t) => { const b = c.bal; if (b.stumbleT > 0) return G.sampleLoop('Dizzy', t * 1.2); const base = G.samplePose(poseName, t); if (b.lean > .7) { const k = Math.min(1, (b.lean - .7) * 3), hop = G.sampleLoop('Hop_One_Foot_Loop', t); return G.lib.blend(base, hop, k * .6); } return base; };\nconst drawPlates = (g, r, ctx, o = {}) => { const n = ctx.contestants.length; for (const c of ctx.contestants) { if (!c.bal) continue; const big = n === 1, R = big ? 26 : 15, p = r.w(c.x, c.y, 0), x = big ? r.W / 2 : p[0], y = big ? r.H - 34 : r.H - 20; if (!o.hide) G.drawPlate(g, c.bal, x, y, R, { t: game.real }); if (!big) { G.text(g, c.name, x, y - R - 9, c.color || G.COL.INK, { align: 'center' }); } } };\nG.drawPlates = drawPlates;\nconst coachPos = () => ({ x: -86, y: -6 });\nG.drawCoach = (r, ctx, pose, t, tgt = 1.2) => { if (ctx.contestants.length > 2 || !ctx.coachRig) return; G.actor(r, ctx.coachRig); };\nG.makeCoach = ctx => { if (ctx.contestants.length > 2) return; ctx.coachRig = G.instructorRig(ctx.coachId, 1.8); };\n\nG.activity({ id: 'stork', family: 'hold', discipline: 'Stillness', name: 'Stork Stand', tierName: 'Eyes Closed', class: true, hub: true, coachKey: 'hold', song: 'yoga',\n  says: 'Stand on one leg. Keep the dot in the ring. You may not sit down. The gull will not help.',\n  tierSays: 'The Plate is gone. Balance by the tilt, the tone and the rumble. Please do not actually close your eyes.',\n  controls: (src, lean) => [[lean, 'Lean into the ring']],\n  prompts: () => [['lean', 'Lean']],\n  setup(ctx) { const T = ctx.T; ctx.dur = ctx.short ? 28 : (ctx.limit || T.dur); ctx.ringT = T.ringMove; ctx.gullT = T.gull.every; ctx.gull = null; ctx.time = 0; if (T.eyesClosed && !game.headless) ctx.tone = new G.BalanceTone();\n    for (const c of ctx.contestants) { G.setupBal(ctx, c, setFor(T)); c.bal.onFall = () => { c.s.fellT = 1; }; } G.makeCoach(ctx); ctx.gullBlob = G.Blobs.gull();\n    if (ctx.guided) ctx.say(G.coach(), 'First, lean. Move the dot into the ring.', 5); },\n  botFill(ctx, c, skill, dt) { G.leanBotFill(ctx, c, dt); },\n  update(dt, ctx) { const T = ctx.T; ctx.ringT -= dt;\n    if (ctx.ringT <= 0) { ctx.ringT += T.ringMove; const a = ctx.rng() * 6.283, d = T.ringR * (.5 + ctx.rng() * .5); ctx.rx = Math.cos(a) * d; ctx.ry = Math.sin(a) * d; for (const c of ctx.contestants) { c.bal.ringX = ctx.rx; c.bal.ringY = ctx.ry; } if (ctx.guided && ctx.t < 16) ctx.say(G.coach(), 'Good. Now hold. That is all a stork does.', 4); }\n    ctx.gullT -= dt; if (!ctx.gull && ctx.gullT <= 0) { ctx.gull = { t: T.gull.stay, side: ctx.rng() < .5 ? -1 : 1 }; G.sfx('gull'); if (ctx.guided && ctx.t < 20) ctx.say(G.coach(), 'A gull. It weighs more than it looks. Recover by leaning away.', 4); }\n    if (ctx.gull) { ctx.gull.t -= dt; if (ctx.gull.t <= 0) { for (const c of ctx.contestants) c.bal.vx += -ctx.gull.side * .35; ctx.gullT = T.gull.every; ctx.gull = null; G.sfx('flurry'); } }\n    for (const c of ctx.contestants) c.bal.step(dt, c.intent.ux, c.intent.uy, { fx: ctx.gull ? ctx.gull.side * T.gull.f : 0 });\n    if (ctx.tone) { const b = ctx.local.bal; ctx.tone.set(b.px, b.py, clamp(b.lean, 0, 1)); if (b.lean > .55 && ctx.local.input && ctx.local.input.rumble) { ctx.rumT = (ctx.rumT || 0) - dt; if (ctx.rumT <= 0) { ctx.rumT = .25; ctx.local.input.rumble(.2 + b.lean * .5, .2); } } }\n    if (ctx.t >= ctx.dur) ctx.done = true; },\n  stop(ctx) { if (ctx.tone) ctx.tone.stop(); }, cleanup(ctx) { if (ctx.tone) ctx.tone.stop(); },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; for (const c of ctx.contestants) { rigStep(c.rig, dt, c.x, c.y, 1.57, [c.bal.px, c.bal.py], G.balPose(c, 'stork', ctx.time)); } if (ctx.coachRig) { ctx.coachRig.mocap = G.samplePose('stork', ctx.time + 2); G.place(ctx.coachRig, dt, -92, -14, 0, 1.2); } ctx.gullBlob.update(dt, { flap: ctx.gull ? 0 : 1 }); },\n  result(ctx, c) { const b = c.bal; return { pct: b.steadiness - .05 * b.falls, detail: 'Steady ' + Math.round(b.steadiness * 100) + '%. Falls: ' + b.falls + '.' }; },\n  draw(r, ctx) { G.ROOMS[ctx.festival ? 'festival' : 'deck'](r, game.real); for (const c of ctx.contestants) G.mat(r, c.x, c.y + 4, ctx.contestants.length > 1 ? E.mix(c.color || '#bfeee0', '#ffffff', .5) : '#bfeee0', 26 * c.slot.size / 2.1, 14);\n    r.shape('whyfit:cactus-medium-a', 118, -30, 0); r.shape('whyfit:pot-large', -128, -24, 0); G.drawCoach(r, ctx); for (const c of ctx.contestants) G.actor(r, c.rig, { shadow: 7 });\n    if (ctx.gull) { const c = ctx.contestants[0], x = c.x + ctx.gull.side * 12 * c.slot.size / 2, z = 28 * c.slot.size / 2.1 + 8; r.actor(x, c.y, z, (g, ox, oy) => ctx.gullBlob.draw(g, ox, oy, r.view)); }\n    G.drawGhosts(r, ctx); if (ctx.T.eyesClosed) r.overlay(g => px.blend(g, .45, 'multiply', () => px.rect(g, 0, 0, r.W, r.H, '#30405a'))); },\n  hud(g, r, ctx) { G.hudTop(g, r, null, G.fmtT(ctx.dur - ctx.t)); drawPlates(g, r, ctx, { hide: ctx.T.eyesClosed }); },\n  ghost(ctx) { const b = ctx.local.bal; return { l: [b.px, b.py], s: Math.round(Math.max(0, b.steadiness - .05 * b.falls) * 1000) }; } });\n\nG.activity({ id: 'flow', family: 'hold', discipline: 'Stillness', name: 'Sun Flow', tierName: 'The Long Flow', coachKey: 'breathe', song: 'yoga',\n  says: 'Five poses, two breaths each. Stay in the ring and breathe with the circle. You may not skip the breathing.',\n  controls: (src, lean, L) => [[lean, 'Stay in the ring'], [L('breath'), 'Breathe in as the circle grows']],\n  prompts: () => [['lean', 'Lean'], ['breath', 'Breathe']],\n  setup(ctx) { const T = ctx.T; ctx.dur = ctx.limit || T.poses.length * T.breaths * T.cycle; ctx.time = 0; ctx.guide = 0; for (const c of ctx.contestants) { G.setupBal(ctx, c, setFor(T)); c.s.match = 0; c.s.total = 0; } G.makeCoach(ctx); },\n  poseAt(ctx, t) { const T = ctx.T, len = T.breaths * T.cycle, i = Math.min(T.poses.length - 1, Math.floor(t / len)), u = t - i * len; return { i, u, a: T.poses[i], b: T.poses[Math.min(i + 1, T.poses.length - 1)], k: u > len - .6 ? (u - (len - .6)) / .6 : 0 }; },\n  botFill(ctx, c, skill, dt) { G.leanBotFill(ctx, c, dt); const lag = { poor: .9, average: .35, good: .15, expert: .05 }[skill] || 0; const u = Math.max(0, ctx.t - lag) % ctx.T.cycle; const gl = u < ctx.T.cycle / 2 ? u / (ctx.T.cycle / 2) : 1 - (u - ctx.T.cycle / 2) / (ctx.T.cycle / 2); c.intent.breath = clamp(gl, 0, 1); },\n  update(dt, ctx) { const T = ctx.T, u = ctx.t % T.cycle; ctx.guide = u < T.cycle / 2 ? u / (T.cycle / 2) : 1 - (u - T.cycle / 2) / (T.cycle / 2);\n    for (const c of ctx.contestants) { c.bal.step(dt, c.intent.ux, c.intent.uy); c.s.total += dt; if (Math.abs(c.intent.breath - ctx.guide) <= .25) c.s.match += dt; }\n    if (ctx.t >= ctx.dur) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const q = this.poseAt(ctx, ctx.t), Pa = G.POSES[q.a], Pb = G.POSES[q.b]; ctx.poseName = Pa.name;\n    const pose = t => q.k > 0 ? G.lib.blend(G.samplePose(q.a, t), G.samplePose(q.b, t), q.k) : G.samplePose(q.a, t), tgt = Pa.tgt + (Pb.tgt - Pa.tgt) * q.k;\n    for (const c of ctx.contestants) { rigStep(c.rig, dt, c.x, c.y, tgt, [c.bal.px, c.bal.py], c.bal.stumbleT > 0 ? G.sampleLoop('Dizzy', ctx.time) : pose(ctx.time)); }\n    if (ctx.coachRig) { ctx.coachRig.mocap = pose(ctx.time + 1); G.place(ctx.coachRig, dt, -92, -14, 0, tgt); } },\n  result(ctx, c) { const st = c.bal.steadiness, br = c.s.total ? c.s.match / c.s.total : 0; return { pct: .6 * st + .4 * br - .03 * c.bal.falls, detail: 'Steady ' + Math.round(st * 100) + '%. Breath ' + Math.round(br * 100) + '%.' }; },\n  draw(r, ctx) { G.ROOMS.deck(r, game.real); G.mat(r, 0, 4, '#bfeee0', 30, 14); G.mat(r, -92, -10, '#ffe2b8', 24, 11); r.shape('whyfit:cactus-medium-b', 120, -30, 0); r.shape('whyfit:pot-large', 150, -26, 0); G.drawCoach(r, ctx); for (const c of ctx.contestants) G.actor(r, c.rig, { shadow: 7 }); },\n  hud(g, r, ctx) { G.hudTop(g, r, ctx.poseName, G.fmtT(ctx.dur - ctx.t)); drawPlates(g, r, ctx); const c = ctx.local, x = r.W - 54, y = r.H - 54, gr = 8 + ctx.guide * 26, br = 8 + c.intent.breath * 26; px.disc(g, x, y, 36, '#ffffff'); for (let i = 0; i < 40; i++) { const a = i / 40 * 6.283; px.rect(g, x + Math.cos(a) * gr, y + Math.sin(a) * gr, 2, 2, G.COL.ACC); } px.disc(g, x, y, br, Math.abs(c.intent.breath - ctx.guide) <= .25 ? '#bfeee0' : '#ffd9c8'); G.text(g, u4(ctx) ? 'In' : 'Out', x, y - 3, G.COL.INK, { align: 'center' }); } });\nconst u4 = ctx => (ctx.t % ctx.T.cycle) < ctx.T.cycle / 2;\nEOF\n","description":"Cut the props set; write rooms, session scene, hold activities"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16463,"cache_read_input_tokens":202555,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16463},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6a88ba50-da75-48c3-bde0-396ebfab72e9","uuid":"bf7823e6-ac44-4e27-bf2d-9ba98bf66bb1","timestamp":"2026-11-05T05:28:23.195Z","request_id":"req_011CgjE1xJpc76999CLHJbXv","wire_tool_inputs":{"toolu_01YYJHqJsVLBXjCS5abS1PPw":{"command":"cd engine && node tools/asset-set.mjs src/assets/sets/kaykit-furniture-bits.js src/assets/sets/kenney-nature.js src/assets/sets/kenney-holiday.js src/assets/sets/kenney-graveyard.js --ids kaykit-furniture-bits:cactus-medium-a,kaykit-furniture-bits:cactus-medium-b,kenney-nature:pot-large,kenney-holiday:bench,kaykit-furniture-bits:bed-double-a,kenney-graveyard:lantern-glass --name whyfit --out ../vendor/whyfit-props.js --credit \"Kenney and KayKit (CC0)\" 2>&1 | tail -2; ls -la ../vendor/whyfit-props.js; head -c 300 ../vendor/whyfit-props.js; cd ..; sed -n 1,10p engine/docs/ASSETS.md | cut -c1-200\ncat > game/rooms.js <<'EOF'\n// Rooms: painted first in draw, on r.ctx, bright and clean. In the brawler view +y comes toward the camera.\nG.band = (g, x, y, w, h, c1, c2, n = 6) => { const step = h / n; for (let i = 0; i < n; i++) px.rect(g, x, Math.round(y + i * step), w, Math.ceil(step) + 1, E.mix(c1, c2, n > 1 ? i / (n - 1) : 0)); };\nG.PAL = { white: '#f6fafa', wall: '#dfe9ea', sky1: '#8fd3f4', sky2: '#d8f3fb', sea1: '#49b6c9', sea2: '#2f97ad', floor1: '#ecd9bd', floor2: '#d9bd96' };\nconst P = G.PAL;\nG.floorPoly = (r, g, pts, c) => px.poly(g, pts.map(p => { const q = r.w(p[0], p[1], p[2] || 0); return [q[0], q[1]]; }), c);\nG.mat = (r, x, y, c = '#bfeee0', w = 22, h = 14, o = {}) => { const g = r.ctx; G.floorPoly(r, g, [[x - w, y - h], [x + w, y - h], [x + w, y + h], [x - w, y + h]], E.mix(c, '#20404c', .18)); G.floorPoly(r, g, [[x - w + 1, y - h + 1], [x + w - 1, y - h + 1], [x + w - 1, y + h - 1], [x - w + 1, y + h - 1]], c); if (o.glow) { const k = .5 + .5 * Math.sin(G.game.real * 3); G.floorPoly(r, g, [[x - w + 3, y - h + 3], [x + w - 3, y - h + 3], [x + w - 3, y + h - 3], [x - w + 3, y + h - 3]], E.mix(c, '#ffffff', .25 + k * .35)); } for (let i = -3; i <= 3; i++) G.floorPoly(r, g, [[x - w + 2, y + i * h / 4], [x + w - 2, y + i * h / 4], [x + w - 2, y + i * h / 4 + .6], [x - w + 2, y + i * h / 4 + .6]], E.mix(c, '#ffffff', .4)); };\nconst seaAndSky = (r, g, top, h, t) => { G.band(g, 0, top, r.W, h * .62, P.sky1, P.sky2, 8); const sy = top + h * .62; G.band(g, 0, sy, r.W, h * .38, P.sea1, P.sea2, 5);\n  for (let i = 0; i < 16; i++) { const x = ((i * 67 + t * (4 + i % 3)) % (r.W + 20)) - 10, y = sy + 3 + (i * 13) % Math.max(4, h * .34); px.rect(g, x, y, 5 + i % 4 * 2, 1, '#bfeaf2'); }\n  for (let i = 0; i < 4; i++) { const x = ((i * 137 + t * 2) % (r.W + 60)) - 30, y = top + 8 + i * 9; px.ell(g, x, y, 16 + i * 3, 3, '#ffffff'); px.ell(g, x + 8, y - 2, 9, 2, '#f4fbfd'); } };\nconst planks = (r, g, c1, c2, y0 = -44, y1 = 90, n = 11) => { for (let i = 0; i < n; i++) { const a = y0 + (y1 - y0) * i / n, b = y0 + (y1 - y0) * (i + 1) / n; const pa = r.w(0, a, 0)[1], pb = r.w(0, b, 0)[1]; px.rect(g, 0, Math.round(pa), r.W, Math.ceil(pb - pa) + 1, E.mix(c1, c2, i / n)); px.rect(g, 0, Math.round(pb), r.W, 1, E.mix(c2, '#7c6a50', .35)); } const bot = r.w(0, y1, 0)[1]; if (bot < r.H) px.rect(g, 0, bot, r.W, r.H - bot + 1, c2); };\nconst boards = (r, g, c = '#c9ad85') => { for (let i = -12; i <= 12; i++) { const a = r.w(i * 24, -44, 0), b = r.w(i * 24, 90, 0); px.line(g, a[0], a[1], b[0], b[1], c); } };\nconst bunting = (r, g, y, colors = ['#ff7a59', '#2cc6e6', '#f5c84b', '#7bd389'], t = 0) => { const n = Math.ceil(r.W / 14); for (let i = 0; i < n; i++) { const x = i * 14 + 4, sag = Math.sin(i / n * Math.PI * 3) * 4; px.poly(g, [[x, y + sag], [x + 10, y + sag], [x + 5, y + sag + 8 + Math.sin(t * 3 + i) * .6]], colors[i % colors.length]); } px.rect(g, 0, y, r.W, 1, '#8aa4ad'); };\nG.ROOMS = {\n  studio(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb, P.white, P.wall, 5);\n    const w = Math.round(r.W * .72), x = (r.W - w) >> 1, h = Math.round(wb * .78), y = 8; px.rect(g, x - 3, y - 3, w + 6, h + 6, '#b9cbd2'); px.rect(g, x - 2, y - 2, w + 4, h + 4, '#ffffff'); const c = g; seaAndSkyClip(r, c, x, y, w, h, t); for (let i = 1; i < 3; i++) px.rect(g, x + w * i / 3, y, 2, h, '#ffffff'); px.rect(g, 0, wb - 3, r.W, 3, '#c8dde2');\n    planks(r, g, P.floor1, P.floor2); boards(r, g); },\n  deck(r, t, o = {}) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; seaAndSky(r, g, 0, wb + 6, t); px.rect(g, 0, wb - 6, r.W, 2, '#f4f8f8'); for (let i = 0; i <= 18; i++) px.rect(g, i * r.W / 18, wb - 6, 2, 10, '#eaf0f0'); planks(r, g, '#e3c79c', '#c6a374'); boards(r, g, '#b39268');\n    for (let i = 0; i < 5; i++) { const x = 18 + i * 6, y = 10, sw = Math.sin(t * 1.4 + i) * 2; px.line(g, x, 2, x + sw, y + i * 3, '#9fb3bb'); px.rect(g, x + sw - 1, y + i * 3, 3, 6, '#cfe6ee'); } },\n  iron(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb, '#fbfdfd', P.wall, 5); const mw = Math.round(r.W * .55), mx = (r.W - mw) >> 1, mh = Math.round(wb * .72); px.rect(g, mx - 2, 8, mw + 4, mh + 4, '#b9cbd2'); G.band(g, mx, 10, mw, mh, '#e4f2f5', '#cfe4e9', 4); for (let i = 0; i < 4; i++) px.line(g, mx + 10 + i * 40, 10 + mh - 2, mx + 36 + i * 40, 12, '#f0fafb');\n    px.rect(g, 0, wb - 3, r.W, 3, '#c8dde2'); G.band(g, 0, wb, r.W, r.H - wb, '#f0f4f4', '#d6e0e2', 6); for (let i = -10; i <= 10; i++) { const a = r.w(i * 28, -44, 0), b = r.w(i * 28, 90, 0); px.line(g, a[0], a[1], b[0], b[1], '#dbe5e7'); }\n    const sign = G.LINES.iron[Math.floor((G.state ? G.state.day : 1) - 1) % 4]; G.panel(g, 8, 10, Math.max(60, Math.min(mx - 14, 72)), 30, { rad: 3 }); G.wrapText(g, sign, 11, 13, Math.max(54, Math.min(mx - 20, 66)), G.COL.INK, { gap: 0 }); },\n  pier(r, t, o = {}) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; seaAndSky(r, g, 0, wb + 6, t); planks(r, g, '#d7b98d', '#b08f64'); boards(r, g, '#94754e'); px.rect(g, 0, wb - 4, r.W, 3, '#b08f64'); for (let i = 0; i <= 12; i++) px.rect(g, i * r.W / 12, wb - 12, 3, 12, '#9a7a52'); bunting(r, g, 10, undefined, t); },\n  reception(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb, P.white, P.wall, 5); px.rect(g, r.W * .08 - 2, 10, r.W * .34 + 4, wb * .7 + 4, '#b9cbd2'); seaAndSkyClip(r, g, r.W * .08, 12, r.W * .34, wb * .7, t); px.rect(g, 0, wb - 3, r.W, 3, '#c8dde2'); planks(r, g, '#f1e4d0', '#dcc7a9'); boards(r, g, '#cdb897');\n    G.panel(g, r.W * .55, 14, r.W * .32, 34, { rad: 3 }); G.wrapText(g, 'Gently, Or Not At All', r.W * .55 + 6, 22, r.W * .32 - 12, G.COL.ACCD, { gap: 1 }); },\n  bungalow(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb, '#f5e9d6', '#e6d3b4', 5); const wx = r.W * .62; px.rect(g, wx - 2, 8, r.W * .28 + 4, wb * .62 + 4, '#b89c72'); G.band(g, wx, 10, r.W * .28, wb * .62, '#3b4a78', '#e88a5a', 6); px.rect(g, 0, wb - 3, r.W, 3, '#b89c72'); planks(r, g, '#d9bd96', '#b89c72'); },\n  raft(r, t) { const g = r.ctx, wb = r.w(0, -44, 0)[1]; G.band(g, 0, 0, r.W, wb * .75, '#3a3a78', '#f08a5a', 8); G.band(g, 0, wb * .75, r.W, wb * .35, '#f0a060', '#e8c080', 3); const sx = r.W * .7, sy = wb * .92; px.disc(g, sx, sy, 16, '#ffd890'); G.band(g, 0, wb, r.W, r.H - wb, '#2a6a86', '#144a66', 7); for (let i = 0; i < 22; i++) { const x = ((i * 53 + t * 5) % (r.W + 20)) - 10, y = wb + 4 + (i * 17) % Math.max(4, r.H - wb - 8); px.rect(g, x, y, 6 + (i % 4) * 2, 1, i % 3 ? '#3e8aa8' : '#f0a060'); }\n    const pts = [[-110, -24], [110, -24], [118, 34], [-118, 34]]; G.floorPoly(r, g, pts.map(p => [p[0], p[1], -2]), '#6a4a30'); G.floorPoly(r, g, pts, '#b08a5a'); for (let i = -5; i <= 5; i++) { const a = r.w(i * 21, -24, 0), b = r.w(i * 22, 34, 0); px.line(g, a[0], a[1], b[0], b[1], '#8a6a42'); } },\n  festival(r, t) { G.ROOMS.pier(r, t); bunting(r, r.ctx, 24, ['#e85d8a', '#f5c84b', '#2cc6e6'], t + 1); }\n};\nconst seaAndSkyClip = (r, g, x, y, w, h, t) => { x = Math.round(x); y = Math.round(y); w = Math.round(w); h = Math.round(h); G.band(g, x, y, w, h * .62, P.sky1, P.sky2, 6); G.band(g, x, y + h * .62, w, h * .38, P.sea1, P.sea2, 4); for (let i = 0; i < 9; i++) { const lx = x + ((i * 47 + t * 3) % w), ly = y + h * .62 + 2 + (i * 9) % Math.max(2, h * .32); px.rect(g, lx, ly, Math.min(5, x + w - lx), 1, '#bfeaf2'); } };\nG.lightFor = (kind) => { const L = game.lights; if (kind === 'morning') { L.enabled = true; L.ambient = .92; } else if (kind === 'dusk') { L.enabled = true; L.ambient = .62; } else L.enabled = false; };\n// small things the rooms are dressed with, all hand-drawn in place\nG.PROPS = {\n  dumbbell(g, x, y) { px.rect(g, x - 3, y - 1, 6, 1, '#7a8b92'); px.rect(g, x - 5, y - 2, 2, 3, '#4a5a62'); px.rect(g, x + 3, y - 2, 2, 3, '#4a5a62'); },\n  cooler(g, x, y) { px.rect(g, x - 5, y - 18, 10, 18, '#f4f8f8'); px.rect(g, x - 4, y - 28, 8, 10, '#a8dcec'); px.rect(g, x - 2, y - 12, 4, 2, '#2cc6e6'); },\n  fern(g, x, y, t = 0) { for (let i = -3; i <= 3; i++) { const sw = Math.sin(t * 1.2 + i) * 1; px.line(g, x, y, x + i * 3 + sw, y - 10 + Math.abs(i), i % 2 ? '#3d9a60' : '#55b878'); } px.rect(g, x - 4, y - 1, 8, 4, '#c9764a'); },\n  candle(g, x, y, flame, t = 0) { px.rect(g, x - 2, y - 8, 4, 8, '#fbf3df'); px.rect(g, x - 3, y, 6, 1, '#d8c8a0'); if (flame > 0) { const f = 2 + flame * 5, w = Math.sin(t * 9) * .8; px.poly(g, [[x - 2 - flame, y - 9], [x + 2 + flame, y - 9], [x + w, y - 9 - f * 1.6]], '#f5a742'); px.poly(g, [[x - 1, y - 9], [x + 1, y - 9], [x + w, y - 9 - f]], '#ffe58a'); } else px.rect(g, x, y - 10, 1, 2, '#555'); },\n  blender(g, x, y) { px.rect(g, x - 5, y - 6, 10, 6, '#556070'); px.rect(g, x - 4, y - 17, 8, 11, '#c8ecd8'); px.rect(g, x - 5, y - 18, 10, 2, '#556070'); }\n};\nEOF\ncat > game/scenes/session.js <<'EOF'\n// A session: Card -> instructor demonstrates -> Breathe in, 3 2 1 -> play -> stars -> Again or Done. Every activity is one\n// registry entry and becomes its own pausable scene here. Class, Attract, The Gentle Games and the hub round use the same scene.\nG.slots = n => n <= 1 ? [{ x: 0, y: 0, size: 2.1 }] : n === 2 ? [{ x: -44, y: 0, size: 1.9 }, { x: 44, y: 0, size: 1.9 }] : [{ x: -96, y: 0, size: 1.5 }, { x: -32, y: 0, size: 1.5 }, { x: 32, y: 0, size: 1.5 }, { x: 96, y: 0, size: 1.5 }].slice(0, 4);\nG.makeCtx = (def, data) => {\n  const tier = data.tier || 0, T = def.tiers[tier], seed = data.seed !== undefined ? data.seed : Math.floor(G.rng() * 1e9), rng = E.rng(seed);\n  const mode = data.mode || 'free', ctx = { def, id: def.id, tier, T, mode, classMode: mode === 'class', rng, seed, t: 0, done: false, cheat: !!data.cheat, short: !!data.short, festival: !!data.festival, guided: !!data.guided, data, limit: data.limit || null, duel: !!data.duel, contestants: [], local: null, ghosts: data.ghosts || null };\n  const list = data.contestants || [{ name: G.state ? G.state.name : 'You', input: game.input, color: G.COL.CORAL, local: true, bot: data.bot || null, rig: data.rig || null }];\n  const n = Math.max(list.length, data.mats || 0), slots = data.slots || G.slots(ctx.ghosts ? Math.max(n, 2) : n);\n  ctx.contestants = list.map((c, i) => { const slot = slots[i] || slots[0];\n    const o = { i, name: c.name, color: c.color, local: !!c.local, input: c.input || null, player1: c.input === game.input, bot: c.bot || null, forScore: c.forScore !== false, intent: G.newIntent(), score: 0, pct: 0, s: {}, slot, x: slot.x, y: slot.y };\n    if (c.rig) o.rig = c.rig; else if (G.state && c.local && !def.noRig) o.rig = G.memberRig(slot.size); else if (!def.noRig) o.rig = G.lookToRig({ hair: 'short', skin: i % 6, top: i % 8, bottom: i % 4 }, slot.size, {});\n    if (o.bot) o.lean = new G.LeanBot(o.bot, E.rng(seed + 11 + i * 7));\n    return o; });\n  ctx.local = ctx.contestants.find(c => c.local) || ctx.contestants[0];\n  if (G.TOOLS.bot && ctx.local && !ctx.local.bot) { ctx.local.bot = G.TOOLS.bot; ctx.local.lean = new G.LeanBot(G.TOOLS.bot, E.rng(seed + 3)); ctx.toolBot = true; }\n  ctx.say = (who, line, secs) => { if (ctx.mode === 'round') return; G.chat(who, line, secs); };\n  ctx.finish = () => { ctx.done = true; };\n  ctx.coachId = data.coach || G.coach();\n  return ctx;\n};\n// local effects of the Lean: the chime that climbs, the creak near the edge, the rumble\nG.leanFx = (c, ctx, dt) => { const b = c.bal; if (!b || !c.local) return; const s = c.s;\n  s.chT = (s.chT || 0) - dt; if (b.inRing && b.streak > 1.2 && s.chT <= 0) { s.chT = 1.4; G.sfx('chime', { vol: .18, pitch: 1 + Math.min(1, b.streak / 16) }); }\n  s.crT = (s.crT || 0) - dt; const e = b.lean; if (e > .72 && s.crT <= 0) { s.crT = .55; G.sfx('creak', { vol: .3 + (e - .72) }); if (c.input && c.input.rumble) c.input.rumble(.2 + (e - .7) * 1.2, .15); }\n  if (b.stumbleT > 0 && !s.st) { s.st = true; G.sfx('stumble'); if (c.input && c.input.rumble) c.input.rumble(.7, .35); if (ctx.mode !== 'attract' && ctx.mode !== 'round' && G.rng() < .35) G.chat('tare', G.line('fall')); } if (b.stumbleT <= 0) s.st = false; };\nG.playStep = (ctx, dt) => { const def = ctx.def;\n  for (const c of ctx.contestants) { if (c.bot) { if (def.botFill) def.botFill(ctx, c, c.bot, dt); } else if (c.input) G.fillDevice(c, ctx, dt); }\n  def.update(dt, ctx); for (const c of ctx.contestants) G.leanFx(c, ctx, dt);\n  ctx.t += dt; if (ctx.limit && ctx.t >= ctx.limit) ctx.done = true; };\nG.resultOf = (ctx, c) => { const def = ctx.def, res = def.result(ctx, c), pct = clamp(res.pct, 0, 1); c.pct = pct; c.score = Math.round(pct * 1000); c.stars = G.starsFor(def, pct); c.detail = res.detail || ''; return c; };\nG.record = (ctx, c) => { const st = G.state; if (!st) return { minutes: 0, unlocked: [] }; const id = ctx.id, b = st.best[id] = st.best[id] || {}, k = ctx.tier, prev = b[k]; if (!prev || c.pct > prev.pct) b[k] = { pct: c.pct, stars: c.stars }; st.played[id] = true;\n  const before = G.unlockedItems(st).length, suggested = st.suggestion === id, m = 2 * (1 + .25 * c.stars) * (suggested ? 1.5 : 1) * G.DEV.minutes; st.minutes = Math.round((st.minutes + m) * 10) / 10; st.age = st.day === 3 && !st.finished ? st.heldAge : G.computeAge(st); if (c.stars >= 2 && st.day === 2) st.flags.nod = true; return { minutes: m, suggested, unlocked: G.unlockedItems(st).slice(before) }; };\nG.activity = def => {\n  Object.assign(def, G.ACTDATA[def.id] || {}); G.acts[def.id] = def; G.actOrder.push(def.id);\n  const scene = { pausable: true, view: def.view || 'brawler', camera: { zoom: false }, phase: 'card',\n    enter(data) { data = data || {}; this.data = data; G.talk.close(); const ctx = this.ctx = G.makeCtx(def, data); this.t = 0; this.resT = 0; this.pills = null; this.line = null;\n      def.setup(ctx); if (def.animate) def.animate(1 / 120, ctx);\n      const mode = ctx.mode; this.phase = data.skipCard || mode === 'class' ? 'count' : mode === 'attract' || mode === 'round' ? 'play' : 'card';\n      if (this.phase === 'card') this.makeCardPills(); G.music(def.song || (ctx.T && ctx.T.song) || 'studio', ctx.T && ctx.T.song ? { restart: false } : undefined);\n      if (data.again) this.phase = 'count'; if (this.phase === 'count') this.countIn(); G.lastAct = { name: 'act_' + def.id, data };\n      G.lightFor(ctx.duel ? 'dusk' : def.light || null); if (def.enterView) def.enterView(ctx); },\n    exit() { const ctx = this.ctx; if (def.cleanup) def.cleanup(ctx); G.lightFor(null); game.input.stopRumble && game.input.stopRumble(); G.setHand(false); },\n    countIn() { this.t = 0; if (this.ctx.mode !== 'class') G.sfx('boop', { vol: .2 }); },\n    makeCardPills() { const items = [{ label: 'Begin', on: () => { this.phase = 'demo'; this.t = 0; G.talk.close(); const line = G.coachLine(def.coachKey || 'hold'); if (!def.noDemoLine) G.chat(G.coach(), line, 3); } }];\n      const st = G.state, ctx = this.ctx; if (ctx.mode !== 'games' && st && def.tiers[1] && (ctx.tier === 1 || G.tier2Open(st, def.id))) items.push({ label: ctx.tier === 1 ? 'Back to the first tier' : 'Harder: ' + (def.tierName || 'Second tier'), on: () => { game.go(this.name, Object.assign({}, this.data, { tier: ctx.tier === 1 ? 0 : 1 }), { fade: 0 }); } });\n      if (ctx.mode !== 'games') items.push({ label: 'Not now', on: () => this.leave(true) });\n      this.pills = new G.Pills(items, { dir: 'h', onBack: ctx.mode === 'games' ? null : () => this.leave(true) }); },\n    leave(skip) { const ctx = this.ctx, st = G.state; G.talk.close();\n      if (this.data.onDone) { this.data.onDone(ctx.local, skip); return; }\n      if (!skip && ctx.mode === 'story' && st) { st.session++; st.lastActivity = def.id; G.save(); }\n      game.go(ctx.mode === 'free' && this.data.from ? this.data.from : 'island'); },\n    update(dt) { const ctx = this.ctx; this.t += dt; if (G.talk.update(dt)) return;\n      if (this.phase === 'card') { if (this.pills) this.pills.update(dt); if (def.animate) def.animate(dt, ctx); return; }\n      if (this.phase === 'demo') { if (def.animate) def.animate(dt, ctx); if (this.t > 3 || game.input.pressed('confirm')) { this.phase = 'count'; this.countIn(); } return; }\n      if (this.phase === 'count') { if (def.animate) def.animate(dt, ctx); if (Math.floor(this.t) !== Math.floor(this.t - dt) && this.t < 3 && this.t > 0) G.sfx('tick', { vol: .4 }); if (this.t >= 3) { this.phase = 'play'; this.t = 0; G.sfx('boop', { vol: .3 }); if (def.begin) def.begin(ctx); } return; }\n      if (this.phase === 'play') { G.setHand(G.source(game.input) === 'mouse'); G.playStep(ctx, dt); if (def.animate) def.animate(dt, ctx); if (ctx.done) this.finish(); return; }\n      if (this.phase === 'results') { this.resT += dt; if (def.animate) def.animate(dt, ctx); this.tickResults(dt); if (this.pills && this.resT > 1.2) this.pills.update(dt); } },\n    finish() { const ctx = this.ctx; G.setHand(false); for (const c of ctx.contestants) G.resultOf(ctx, c); if (def.stop) def.stop(ctx);\n      if (ctx.mode === 'attract') { G.Attract.next(); return; }\n      if (ctx.mode === 'round') return;\n      if (ctx.mode === 'class') { this.data.onDone(ctx); return; }\n      const c = ctx.local; this.phase = 'results'; this.resT = 0; this.reward = G.record(ctx, c); G.stars = c.stars; this.coins = []; this.coinT = 0; this.stampT = 0; this.stamped = 0; G.save(); G.stopMusic();\n      const leave = { label: 'Done', on: () => this.leave(false) }, again = { label: 'Again', on: () => game.go(this.name, Object.assign({}, this.data, { again: true, tier: ctx.tier }), { fade: 0 }) };\n      this.pills = new G.Pills(ctx.mode === 'games' ? [leave] : [again, leave], { dir: 'h', start: ctx.mode === 'games' ? 0 : 1 });\n      G.talk.say(G.line('star' + c.stars), Object.assign(G.speaker('tare'), { auto: 4.5, modal: false, place: 'top' }));\n      if (def.onResults) def.onResults(ctx, c); },\n    tickResults(dt) { const c = this.ctx.local; this.stampT += dt; if (this.stamped < c.stars && this.stampT > .35 + this.stamped * .35) { this.stamped++; G.sfx('stamp'); G.sting('star' + this.stamped); game.shake(1); } if (this.stampT > .4 + c.stars * .35 && !this.spawned) { this.spawned = true; const n = Math.ceil(this.reward.minutes); for (let i = 0; i < n; i++) this.coins.push({ t: -i * .14, x: 0 }); }\n      for (const k of this.coins) { const b = k.t; k.t += dt; if (b < .7 && k.t >= .7) { G.sfx('clink', { vol: .4, pitch: 1 + Math.random() * .1 }); this.gulp = 1; } } this.gulp = Math.max(0, (this.gulp || 0) - dt * 5);\n      if (this.spawned && !this.announced && this.coins.every(k => k.t > .8)) { this.announced = true; if (this.reward.unlocked.length) { G.sting('unlock'); const u = this.reward.unlocked[0]; G.talk.say(G.LINES.unlock[u.id], Object.assign(G.speaker('tare'), { auto: 4, modal: false, place: 'top' })); } else if (G.rng() < .4) G.talk.say(G.line('gerald'), Object.assign(G.speaker('tare'), { auto: 4, modal: false, place: 'top' })); } },\n    draw(r) { const ctx = this.ctx; def.draw(r, ctx); r.overlay(g => { if (this.phase === 'play' || this.phase === 'count' || this.phase === 'demo') { if (def.hud) def.hud(g, r, ctx); } if (ctx.festival) G.drawFestivalBanner(g, r); });\n      if (this.phase === 'card') r.overlay(g => { G.drawActCard(g, r, ctx); this.pills.draw(g); });\n      if (this.phase === 'count') r.overlay(g => { const n = 3 - Math.floor(this.t); G.text(g, 'Breathe in', r.W / 2, r.H * .28, G.COL.INK, { align: 'center', scale: 2 }); G.text(g, String(Math.max(1, n)), r.W / 2, r.H * .28 + 22, G.COL.ACCD, { align: 'center', scale: 3 }); });\n      if (this.phase === 'demo') r.overlay(g => G.text(g, def.name, r.W / 2, 26, G.COL.INK, { align: 'center', scale: 2 }));\n      if (this.phase === 'results') r.overlay(g => { G.drawResults(g, r, ctx, this); this.pills.draw(g); });\n      if (this.phase === 'play' && def.prompts) G.prompt(r, def.prompts(ctx));\n      if (this.phase === 'card' || this.phase === 'results') G.prompt(r, [['confirm', 'Choose']], { y: 6 });\n      G.talk.draw(r); if (this.phase === 'play') G.drawHand(r); } };\n  scene.name = 'act_' + def.id; def.scene = scene; G.scene(scene.name, scene); return def;\n};\nG.drawFestivalBanner = (g, r) => { const s = 'The Gentle Games', w = E.font.width(s) + 12; G.round(g, r.W - w - 118, 8, w, 14, '#f5c84b'); G.text(g, s, r.W - w - 112, 12, G.COL.INK); };\nG.deviceText = (ctx, lines) => { const src = G.source(game.input); return lines[src] || lines.keys; };\nG.drawActCard = (g, r, ctx) => { const def = ctx.def, w = Math.min(r.W - 60, 320), h = 128, x = (r.W - w) >> 1, y = Math.max(16, (r.H - h - 30) >> 1) - 8, st = G.state;\n  G.panel(g, x, y, w, h); G.text(g, def.name + (ctx.tier ? ': ' + (def.tierName || 'Second tier') : ''), x + 12, y + 9, G.COL.INK, { scale: 2 }); G.text(g, def.discipline, x + w - 12, y + 12, G.COL.ACCD, { align: 'right' });\n  let yy = y + 30; yy += G.wrapText(g, ctx.tier && def.tierSays ? def.tierSays : def.says, x + 12, yy, w - 24, G.COL.INK) + 4;\n  for (const row of G.controlsFor(def)) { const lab = row[0], wl = E.font.width(lab) + 8; G.round(g, x + 12, yy - 2, wl, 11, G.COL.ACC); G.text(g, lab, x + 16, yy, '#fff'); G.text(g, row[1], x + 16 + wl, yy, G.COL.INK); yy += 13; }\n  const sx = x + 16, sy = y + h - 12; const stars = def.stars; for (let i = 0; i < 3; i++) { const cx = sx + i * 58; G.starSprite(g, cx, sy, st && G.bestStars(st, def.id) > i, 1); G.text(g, Math.round(stars[i] * 100) + '%', cx + 9, sy - 3, G.COL.MUT); }\n  const b = st && st.best[def.id] && st.best[def.id][ctx.tier]; G.text(g, b ? 'Best ' + Math.round(b.pct * 100) + '%' : 'Not yet tried', x + w - 12, sy - 3, G.COL.CORAL, { align: 'right' }); };\nG.controlsFor = def => { const src = G.source(game.input), lean = G.leanLabel(); return def.controls(src, lean, a => G.promptLabel(a)); };\nG.drawResults = (g, r, ctx, sc) => { const c = ctx.local, w = Math.min(r.W - 70, 300), h = 104, x = (r.W - w) >> 1, y = Math.max(44, (r.H - h - 30) >> 1) - 4; G.panel(g, x, y, w, h);\n  G.text(g, ctx.def.name, x + 12, y + 9, G.COL.INK, {}); G.text(g, Math.round(c.pct * 100) + '%', x + w - 12, y + 7, G.COL.CORAL, { align: 'right', scale: 2 });\n  for (let i = 0; i < 3; i++) { const on = i < sc.stamped, k = on && sc.stamped === i + 1 ? 1 + Math.max(0, .5 - (sc.stampT - (.35 + i * .35)) * 2) : 1; G.starSprite(g, x + 30 + i * 34, y + 38, on, 2, k); }\n  G.wrapText(g, c.detail, x + 12, y + 60, w - 90, G.COL.MUT); const gx = x + w - 40, gy = y + h - 12; G.drawGeraldAt(g, gx, gy, 1.2, G.state && G.state.minutes >= 30, sc.gulp || 0);\n  for (const k of sc.coins) if (k.t > 0 && k.t < .75) { const u = k.t / .7, cx = x + w * .45 + (gx - x - w * .45) * u, cy = y + 70 + (gy - 28 - y - 70) * u - Math.sin(u * Math.PI) * 26; px.disc(g, cx, cy, 3, '#f5c84b'); px.rect(g, cx - 1, cy - 1, 1, 1, '#fff2c0'); }\n  const m = sc.reward; G.text(g, '+' + (Math.round(m.minutes * 10) / 10) + ' min' + (m.suggested ? ' (Suggested)' : ''), x + 12, y + h - 13, G.COL.ACCD); };\n// with a mouse: hide the OS cursor over the canvas during activities and draw a small soft hand instead\nG.setHand = on => { G.handOn = on; if (typeof document === 'undefined' || !document.getElementById) return; const c = document.getElementById('screen'); if (c && c.style) c.style.cursor = on ? 'none' : ''; };\nG.drawHand = r => { if (!G.handOn) return; const p = game.input.pointer && game.input.pointer(); if (!p) return; r.overlay(g => { px.disc(g, p[0], p[1], 3, '#ffd9c8'); px.disc(g, p[0] - 1, p[1] - 1, 1, '#ffffff'); for (let i = -1; i <= 1; i++) px.rect(g, p[0] + i * 2, p[1] - 5, 1, 2, '#ffd9c8'); }); };\nG.restartSession = () => { if (G.lastAct && game.sceneName === G.lastAct.name && !G.inSession) { game.resume(); game.go(G.lastAct.name, Object.assign({}, G.lastAct.data, { again: true }), { fade: 0 }); } else game.resume(); };\nEOF\ncat > game/activities/hold.js <<'EOF'\n// Stork Stand and Sun Flow: hold the dot in the ring. Sun Flow adds the breath.\nconst setFor = T => G.SETS[T.set];\nG.setupBal = (ctx, c, set, o = {}) => { c.bal = new G.Balance(set, E.rng(ctx.seed + 100 + c.i * 13), Object.assign({ noFall: ctx.cheat }, o)); };\n// every lean-based bot: correct toward the ring\nG.leanBotFill = (ctx, c, dt) => { const b = c.bal, [ux, uy] = c.lean.step(dt, b.px - b.ringX, b.py - b.ringY, b.vx, b.vy); c.intent.ux = ux; c.intent.uy = uy; };\nconst rigStep = (rig, dt, x, y, tgt, wob, pose, extra) => { rig.wob = wob; rig.mocap = pose; rig.body = null; G.place(rig, dt, x, y, 0, tgt, extra); };\nG.balPose = (c, poseName, t) => { const b = c.bal; if (b.stumbleT > 0) return G.sampleLoop('Dizzy', t * 1.2); const base = G.samplePose(poseName, t); if (b.lean > .7) { const k = Math.min(1, (b.lean - .7) * 3), hop = G.sampleLoop('Hop_One_Foot_Loop', t); return G.lib.blend(base, hop, k * .6); } return base; };\nconst drawPlates = (g, r, ctx, o = {}) => { const n = ctx.contestants.length; for (const c of ctx.contestants) { if (!c.bal) continue; const big = n === 1, R = big ? 26 : 15, p = r.w(c.x, c.y, 0), x = big ? r.W / 2 : p[0], y = big ? r.H - 34 : r.H - 20; if (!o.hide) G.drawPlate(g, c.bal, x, y, R, { t: game.real }); if (!big) { G.text(g, c.name, x, y - R - 9, c.color || G.COL.INK, { align: 'center' }); } } };\nG.drawPlates = drawPlates;\nconst coachPos = () => ({ x: -86, y: -6 });\nG.drawCoach = (r, ctx, pose, t, tgt = 1.2) => { if (ctx.contestants.length > 2 || !ctx.coachRig) return; G.actor(r, ctx.coachRig); };\nG.makeCoach = ctx => { if (ctx.contestants.length > 2) return; ctx.coachRig = G.instructorRig(ctx.coachId, 1.8); };\n\nG.activity({ id: 'stork', family: 'hold', discipline: 'Stillness', name: 'Stork Stand', tierName: 'Eyes Closed', class: true, hub: true, coachKey: 'hold', song: 'yoga',\n  says: 'Stand on one leg. Keep the dot in the ring. You may not sit down. The gull will not help.',\n  tierSays: 'The Plate is gone. Balance by the tilt, the tone and the rumble. Please do not actually close your eyes.',\n  controls: (src, lean) => [[lean, 'Lean into the ring']],\n  prompts: () => [['lean', 'Lean']],\n  setup(ctx) { const T = ctx.T; ctx.dur = ctx.short ? 28 : (ctx.limit || T.dur); ctx.ringT = T.ringMove; ctx.gullT = T.gull.every; ctx.gull = null; ctx.time = 0; if (T.eyesClosed && !game.headless) ctx.tone = new G.BalanceTone();\n    for (const c of ctx.contestants) { G.setupBal(ctx, c, setFor(T)); c.bal.onFall = () => { c.s.fellT = 1; }; } G.makeCoach(ctx); ctx.gullBlob = G.Blobs.gull();\n    if (ctx.guided) ctx.say(G.coach(), 'First, lean. Move the dot into the ring.', 5); },\n  botFill(ctx, c, skill, dt) { G.leanBotFill(ctx, c, dt); },\n  update(dt, ctx) { const T = ctx.T; ctx.ringT -= dt;\n    if (ctx.ringT <= 0) { ctx.ringT += T.ringMove; const a = ctx.rng() * 6.283, d = T.ringR * (.5 + ctx.rng() * .5); ctx.rx = Math.cos(a) * d; ctx.ry = Math.sin(a) * d; for (const c of ctx.contestants) { c.bal.ringX = ctx.rx; c.bal.ringY = ctx.ry; } if (ctx.guided && ctx.t < 16) ctx.say(G.coach(), 'Good. Now hold. That is all a stork does.', 4); }\n    ctx.gullT -= dt; if (!ctx.gull && ctx.gullT <= 0) { ctx.gull = { t: T.gull.stay, side: ctx.rng() < .5 ? -1 : 1 }; G.sfx('gull'); if (ctx.guided && ctx.t < 20) ctx.say(G.coach(), 'A gull. It weighs more than it looks. Recover by leaning away.', 4); }\n    if (ctx.gull) { ctx.gull.t -= dt; if (ctx.gull.t <= 0) { for (const c of ctx.contestants) c.bal.vx += -ctx.gull.side * .35; ctx.gullT = T.gull.every; ctx.gull = null; G.sfx('flurry'); } }\n    for (const c of ctx.contestants) c.bal.step(dt, c.intent.ux, c.intent.uy, { fx: ctx.gull ? ctx.gull.side * T.gull.f : 0 });\n    if (ctx.tone) { const b = ctx.local.bal; ctx.tone.set(b.px, b.py, clamp(b.lean, 0, 1)); if (b.lean > .55 && ctx.local.input && ctx.local.input.rumble) { ctx.rumT = (ctx.rumT || 0) - dt; if (ctx.rumT <= 0) { ctx.rumT = .25; ctx.local.input.rumble(.2 + b.lean * .5, .2); } } }\n    if (ctx.t >= ctx.dur) ctx.done = true; },\n  stop(ctx) { if (ctx.tone) ctx.tone.stop(); }, cleanup(ctx) { if (ctx.tone) ctx.tone.stop(); },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; for (const c of ctx.contestants) { rigStep(c.rig, dt, c.x, c.y, 1.57, [c.bal.px, c.bal.py], G.balPose(c, 'stork', ctx.time)); } if (ctx.coachRig) { ctx.coachRig.mocap = G.samplePose('stork', ctx.time + 2); G.place(ctx.coachRig, dt, -92, -14, 0, 1.2); } ctx.gullBlob.update(dt, { flap: ctx.gull ? 0 : 1 }); },\n  result(ctx, c) { const b = c.bal; return { pct: b.steadiness - .05 * b.falls, detail: 'Steady ' + Math.round(b.steadiness * 100) + '%. Falls: ' + b.falls + '.' }; },\n  draw(r, ctx) { G.ROOMS[ctx.festival ? 'festival' : 'deck'](r, game.real); for (const c of ctx.contestants) G.mat(r, c.x, c.y + 4, ctx.contestants.length > 1 ? E.mix(c.color || '#bfeee0', '#ffffff', .5) : '#bfeee0', 26 * c.slot.size / 2.1, 14);\n    r.shape('whyfit:cactus-medium-a', 118, -30, 0); r.shape('whyfit:pot-large', -128, -24, 0); G.drawCoach(r, ctx); for (const c of ctx.contestants) G.actor(r, c.rig, { shadow: 7 });\n    if (ctx.gull) { const c = ctx.contestants[0], x = c.x + ctx.gull.side * 12 * c.slot.size / 2, z = 28 * c.slot.size / 2.1 + 8; r.actor(x, c.y, z, (g, ox, oy) => ctx.gullBlob.draw(g, ox, oy, r.view)); }\n    G.drawGhosts(r, ctx); if (ctx.T.eyesClosed) r.overlay(g => px.blend(g, .45, 'multiply', () => px.rect(g, 0, 0, r.W, r.H, '#30405a'))); },\n  hud(g, r, ctx) { G.hudTop(g, r, null, G.fmtT(ctx.dur - ctx.t)); drawPlates(g, r, ctx, { hide: ctx.T.eyesClosed }); },\n  ghost(ctx) { const b = ctx.local.bal; return { l: [b.px, b.py], s: Math.round(Math.max(0, b.steadiness - .05 * b.falls) * 1000) }; } });\n\nG.activity({ id: 'flow', family: 'hold', discipline: 'Stillness', name: 'Sun Flow', tierName: 'The Long Flow', coachKey: 'breathe', song: 'yoga',\n  says: 'Five poses, two breaths each. Stay in the ring and breathe with the circle. You may not skip the breathing.',\n  controls: (src, lean, L) => [[lean, 'Stay in the ring'], [L('breath'), 'Breathe in as the circle grows']],\n  prompts: () => [['lean', 'Lean'], ['breath', 'Breathe']],\n  setup(ctx) { const T = ctx.T; ctx.dur = ctx.limit || T.poses.length * T.breaths * T.cycle; ctx.time = 0; ctx.guide = 0; for (const c of ctx.contestants) { G.setupBal(ctx, c, setFor(T)); c.s.match = 0; c.s.total = 0; } G.makeCoach(ctx); },\n  poseAt(ctx, t) { const T = ctx.T, len = T.breaths * T.cycle, i = Math.min(T.poses.length - 1, Math.floor(t / len)), u = t - i * len; return { i, u, a: T.poses[i], b: T.poses[Math.min(i + 1, T.poses.length - 1)], k: u > len - .6 ? (u - (len - .6)) / .6 : 0 }; },\n  botFill(ctx, c, skill, dt) { G.leanBotFill(ctx, c, dt); const lag = { poor: .9, average: .35, good: .15, expert: .05 }[skill] || 0; const u = Math.max(0, ctx.t - lag) % ctx.T.cycle; const gl = u < ctx.T.cycle / 2 ? u / (ctx.T.cycle / 2) : 1 - (u - ctx.T.cycle / 2) / (ctx.T.cycle / 2); c.intent.breath = clamp(gl, 0, 1); },\n  update(dt, ctx) { const T = ctx.T, u = ctx.t % T.cycle; ctx.guide = u < T.cycle / 2 ? u / (T.cycle / 2) : 1 - (u - T.cycle / 2) / (T.cycle / 2);\n    for (const c of ctx.contestants) { c.bal.step(dt, c.intent.ux, c.intent.uy); c.s.total += dt; if (Math.abs(c.intent.breath - ctx.guide) <= .25) c.s.match += dt; }\n    if (ctx.t >= ctx.dur) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const q = this.poseAt(ctx, ctx.t), Pa = G.POSES[q.a], Pb = G.POSES[q.b]; ctx.poseName = Pa.name;\n    const pose = t => q.k > 0 ? G.lib.blend(G.samplePose(q.a, t), G.samplePose(q.b, t), q.k) : G.samplePose(q.a, t), tgt = Pa.tgt + (Pb.tgt - Pa.tgt) * q.k;\n    for (const c of ctx.contestants) { rigStep(c.rig, dt, c.x, c.y, tgt, [c.bal.px, c.bal.py], c.bal.stumbleT > 0 ? G.sampleLoop('Dizzy', ctx.time) : pose(ctx.time)); }\n    if (ctx.coachRig) { ctx.coachRig.mocap = pose(ctx.time + 1); G.place(ctx.coachRig, dt, -92, -14, 0, tgt); } },\n  result(ctx, c) { const st = c.bal.steadiness, br = c.s.total ? c.s.match / c.s.total : 0; return { pct: .6 * st + .4 * br - .03 * c.bal.falls, detail: 'Steady ' + Math.round(st * 100) + '%. Breath ' + Math.round(br * 100) + '%.' }; },\n  draw(r, ctx) { G.ROOMS.deck(r, game.real); G.mat(r, 0, 4, '#bfeee0', 30, 14); G.mat(r, -92, -10, '#ffe2b8', 24, 11); r.shape('whyfit:cactus-medium-b', 120, -30, 0); r.shape('whyfit:pot-large', 150, -26, 0); G.drawCoach(r, ctx); for (const c of ctx.contestants) G.actor(r, c.rig, { shadow: 7 }); },\n  hud(g, r, ctx) { G.hudTop(g, r, ctx.poseName, G.fmtT(ctx.dur - ctx.t)); drawPlates(g, r, ctx); const c = ctx.local, x = r.W - 54, y = r.H - 54, gr = 8 + ctx.guide * 26, br = 8 + c.intent.breath * 26; px.disc(g, x, y, 36, '#ffffff'); for (let i = 0; i < 40; i++) { const a = i / 40 * 6.283; px.rect(g, x + Math.cos(a) * gr, y + Math.sin(a) * gr, 2, 2, G.COL.ACC); } px.disc(g, x, y, br, Math.abs(c.intent.breath - ctx.guide) <= .25 ? '#bfeee0' : '#ffd9c8'); G.text(g, u4(ctx) ? 'In' : 'Out', x, y - 3, G.COL.INK, { align: 'center' }); } });\nconst u4 = ctx => (ctx.t % ctx.T.cycle) < ctx.T.cycle / 2;\nEOF\n","description":"Cut the props set; write rooms, session scene, hold activities"}}}
