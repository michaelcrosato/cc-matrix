{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjDYHYvPW3onkv9QbXME","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q3RB23EcvaFz2BvcuJWM4e","name":"Bash","input":{"command":"mkdir -p game/data game/activities game/scenes tests\ncat > game/core.js <<'EOF'\n// Why Fit: the shared namespace, the game object, the input map, the live balance values, member state and saves.\nconst E = My3D2dge, { px, clamp, lerp } = E;\nconst G = window.G = window.G || {};\nG.TITLE = 'WHY FIT';\nG.acts = {}; G.actOrder = []; G.scenes = {};\nG.inSession = !!(window.AIHub && AIHub.active);\n\nconst D = E.Input.DEFAULT;\nG.INPUT = {\n  up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\n  confirm: D.confirm, cancel: [...D.cancel, 'Mouse2'],\n  breath: ['Space', 'Mouse0', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Mouse0', 'Pad4'], catchR: ['KeyE', 'Mouse2', 'Pad5'],\n  jump: ['Space', 'Mouse2', 'Pad0'], interact: ['KeyE', 'Enter', 'Pad0'], more: ['Tab', 'KeyM', 'Pad3'], retry: ['KeyR', 'Pad2'],\n  paceL: ['KeyJ', 'Mouse0', 'Pad6'], paceR: ['KeyK', 'Mouse2', 'Pad7'],\n  stepL: ['KeyA', 'ArrowLeft', 'Mouse0', 'Pad14', 'PadAxisLeft'], stepR: ['KeyD', 'ArrowRight', 'Mouse2', 'Pad15', 'PadAxisRight'],\n  stepU: ['KeyW', 'ArrowUp', 'WheelUp', 'Pad12', 'PadAxisUp'], stepD: ['KeyS', 'ArrowDown', 'WheelDown', 'Pad13', 'PadAxisDown'],\n  devU: ['ArrowUp', 'Pad12'], devD: ['ArrowDown', 'Pad13'], devL: ['ArrowLeft', 'Pad14'], devR: ['ArrowRight', 'Pad15'],\n  devCL: ['PageDown', 'Pad4'], devCR: ['PageUp', 'Pad5'], devA: ['Enter', 'Pad0'], devB: ['Backspace', 'Pad1']\n};\n// half a keyboard runs out of keys with the full map, so Class plays with the moves, the menu actions and three buttons\nG.CLASS_INPUT = { up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause, confirm: D.confirm, cancel: D.cancel,\n  breath: ['Space', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Pad4'], catchR: ['KeyE', 'Pad5'],\n  devU: G.INPUT.devU, devD: G.INPUT.devD, devL: G.INPUT.devL, devR: G.INPUT.devR, devCL: G.INPUT.devCL, devCR: G.INPUT.devCR, devA: G.INPUT.devA, devB: G.INPUT.devB };\n\n// DEV: every live slider. Multipliers are 1 by default so each activity keeps its own numbers in game/data.\nG.DEV_DEFAULTS = { k: 1, c: 1, s: 1, A: 1, nf: 1, ring: 1, push: 1, stumble: 1, mouseReach: .33, nudge: 2.2,\n  star1: 1, star2: 1, star3: 1, repTol: 1, rhythmWin: 1, fatigue: 1,\n  hoopBand: 1, jogBand: 1, jogSpeed: 1,\n  slalomSpeed: 1, slalomTurn: 1, trayG: 420, trayFric: .4, ropeS: 1, gust: 1,\n  timeScale: 1, minutes: 1 };\nG.DEV = Object.assign({}, G.DEV_DEFAULTS);\nG.TOOLS = { noStumble: false, bot: null, trace: false, frozen: false, step: 0 };\n\nconst SETTINGS = [\n  { key: 'music', value: .1 }, { key: 'glyphs', value: 'playstation' },\n  { key: 'voice', label: 'Voices', type: 'slider', min: 0, max: 1, step: .05, value: .8, group: 'Sound', apply(g, v) { g.audio.voiceVolume = v; } },\n  { key: 'gentle', label: 'Gentle Mode', value: false, help: 'A wider ring and a calmer body. Tare will not tell anyone.' },\n  { key: 'breathMode', label: 'Breath', options: ['Hold', 'Toggle'], value: 'Hold', help: 'Hold the button to breathe in, or press it once for each breath.' },\n  { key: 'tips', label: \"Tare's Tips\", value: true, help: 'Tare offers a tip each morning. You may decline. Tare will notice.' }\n];\nconst game = G.game = new E.Game({ canvas: 'screen', id: 'whyfit', res: 'ps1', expand: true, touch: 'never', input: G.INPUT, view: 'brawler',\n  autoPause: !G.inSession, live: G.inSession, fullscreen: G.inSession ? false : 'button', camera: { zoom: false },\n  menu: { quit: G.inSession ? false : 'title', settings: SETTINGS,\n    items: G.inSession ? [] : [['Restart Session', () => G.restartSession()], ['Dev Mode', () => G.Dev.open()]],\n    controls: { confirm: 'Confirm', cancel: 'Back', up: 'Lean forward', down: 'Lean back', left: 'Lean left', right: 'Lean right',\n      breath: 'Breath and effort', catchL: 'Catch left', catchR: 'Catch right', jump: 'Jump', interact: 'Talk or use', paceL: 'Left step', paceR: 'Right step',\n      more: false, retry: false, stepL: false, stepR: false, stepU: false, stepD: false, devU: false, devD: false, devL: false, devR: false, devCL: false, devCR: false, devA: false, devB: false } } });\n\nif (game.shell === null && !game.headless) new E.Shell(game, { theme: { ink: '#20404c', paper: '#f7fbfb', accent: '#14a8c8', muted: '#5f7f8a', danger: '#e0553a', line: '#c8dde2', font: 'system-ui, sans-serif', titleFont: 'system-ui, sans-serif' } });\nif (typeof document !== 'undefined' && document.addEventListener) document.addEventListener('pointerover', e => {\n  const b = e.target.closest && e.target.closest('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)');\n  if (b && e.pointerType === 'mouse') b.focus({ preventScroll: true }); });\n\nG.rng = E.rng(20261104);\nG.pick = (list, rng = G.rng) => list[Math.floor(rng() * list.length) % list.length];\n// a line from a bank that does not repeat until the bank is used up (kept in the member, so a second playthrough still surprises)\nG.line = (key, rng = G.rng) => {\n  const bank = G.LINES[key]; if (!bank) { game.fail('line', new Error('no line ' + key)); return '...'; }\n  if (typeof bank === 'string') return bank;\n  const st = G.state || {}; const seen = st.seen = st.seen || {}; const left = bank.map((_, i) => i).filter(i => !(seen[key] || []).includes(i));\n  if (!left.length) seen[key] = [];\n  const pool = left.length ? left : bank.map((_, i) => i), i = pool[Math.floor(rng() * pool.length) % pool.length];\n  (seen[key] = seen[key] || []).push(i); return bank[i];\n};\n\n// Member state ---------------------------------------------------------------------------------------------------\nG.newMember = (name, look) => ({ name, look, instructor: null, day: 1, session: 0, minutes: 0, best: {}, ages: [], age: 71, heldAge: 71, seen: {}, wear: { top: null, hat: null },\n  pauses: 0, lastSeen: Date.now(), flags: {}, suggestion: null, finalAge: null, duelWon: false, finished: false, sessionsDone: 0, played: {} });\nG.state = null; G.slot = 0;\nG.bestStars = (st, id) => { const b = st.best[id]; if (!b) return 0; return Math.max(...Object.values(b).map(x => x.stars)); };\nG.discScore = (st, d) => { const ids = G.actOrder.filter(i => G.acts[i].discipline === d); return ids.reduce((a, i) => a + G.bestStars(st, i) * 33.3, 0) / (ids.length || 1); };\nG.DISCIPLINES = ['Stillness', 'Strength', 'Cardio', 'Balance'];\nG.computeAge = st => { const O = G.DISCIPLINES.reduce((a, d) => a + G.discScore(st, d), 0) / 4; return Math.min(71, Math.round(78 - .58 * O)) - (st.duelWon ? 1 : 0); };\n// on the plateau the number that matters stays where it was; the next morning it catches up all at once\nG.morningAge = st => { const real = G.computeAge(st); return st.day === 3 ? (st.ages.length ? st.ages[st.ages.length - 1] : real) : real; };\nG.unlockedItems = st => G.UNLOCKS.filter(u => st.minutes >= u.at);\nG.dayInfo = st => G.DAYS[Math.min(st.day, G.DAYS.length) - 1];\nG.isUnlocked = (st, id) => { if (st.finished || st.day > 5) return true; let ok = false; G.DAYS.forEach((d, i) => { if (i < st.day && d.unlocks.includes(id)) ok = true; }); return ok; };\nG.tier2Open = (st, id) => (st.finished || st.day >= 4) && G.bestStars(st, id) >= 2;\nG.sessionsLeft = st => Math.max(0, 3 - st.session);\n\nG.saves = game.saves;\ngame.saves.write = () => ({ data: JSON.parse(JSON.stringify(G.state)), place: 'Day ' + G.state.day, level: G.state.age });\ngame.saves.read = s => { G.state = s.data; };\nG.save = () => { if (G.noSave || !G.state || G.inSession) return; game.saves.save(G.slot); };\nG.members = () => { const out = []; for (let i = 0; i < 3; i++) { const s = game.saves.get(i); out.push(s && !s.damaged && !s.newer && s.data && s.data.look ? s : null); } return out; };\nG.loadMember = slot => { const s = game.saves.load(slot); if (s) G.slot = slot; return !!s; };\n\n// Which device leans: the pad if it was used last; otherwise the mouse if it moved more recently than a key went down.\nG.keyT = -1;\ngame.hook('input', () => { const I = game.input; if (I.held && [...I.held].some(c => c.startsWith('Key') || c.startsWith('Arrow') || c === 'Space' || c.startsWith('Act:'))) G.keyT = I.clock; });\nG.source = (I = game.input) => { if (I.lastDevice === 'gamepad') return 'pad'; if (I === game.input && I.mouse && I.mouse.active !== false && I.mouse.t > G.keyT && I.pointer && I.pointer()) return 'mouse'; return 'keys'; };\n\n// Scenes: every scene goes through here, so Dev Mode, the idle timer and the demo chip are the same everywhere.\nG.scene = (name, def) => {\n  const u = def.update || (() => {}), d = def.draw || (() => {});\n  def.update = function (dt) { if (G.Dev && G.Dev.blocks()) return; u.call(def, dt); };\n  def.draw = function (r) { d.call(def, r); if (G.Attract) G.Attract.draw(r); if (G.Dev) G.Dev.draw(r); };\n  G.scenes[name] = def; return def;\n};\nEOF\ncat > game/balance.js <<'EOF'\n// The Lean: one centre of balance chased by a target. Every activity reads the same model and the same intent object.\nG.noise = (rng, f) => { const ph = [rng() * 6.28, rng() * 6.28, rng() * 6.28]; return t => (Math.sin(t * f + ph[0]) + .6 * Math.sin(t * f * 1.73 + ph[1]) + .35 * Math.sin(t * f * 2.61 + ph[2])) / 1.3; };\n\nG.Balance = class {\n  constructor(set, rng, o = {}) {\n    this.set = set; this.rng = rng; this.o = o; this.px = 0; this.py = 0; this.vx = 0; this.vy = 0; this.t = 0;\n    this.nx = G.noise(rng, 1); this.ny = G.noise(rng, 1); this.ringX = 0; this.ringY = 0;\n    this.inside = 0; this.total = 0; this.falls = 0; this.stumbleT = 0; this.streak = 0; this.trail = []; this.fx = 0; this.fy = 0; this.pushT = set.push ? set.push[1] : 0; this.onFall = null; this.xOnly = !!o.xOnly;\n    this.nphaseT = 0; this.frozen = false;\n  }\n  get gentle() { return !this.o.noGentle && G.game.settings && G.game.settings.gentle; }\n  get R() { return this.set.R * G.DEV.ring * (this.gentle ? 1.25 : 1) * (this.o.ringMul || 1); }\n  get inRing() { return Math.hypot(this.px - this.ringX, this.py - this.ringY) <= this.R; }\n  get steadiness() { return this.total > 0 ? this.inside / this.total : 0; }\n  get lean() { return Math.hypot(this.px, this.py); }\n  step(dt, ux, uy, ef = {}) {\n    const S = this.set, D = G.DEV, gm = this.gentle ? .7 : 1;\n    this.t += dt;\n    if (this.frozen) return;\n    if (this.stumbleT > 0) { this.stumbleT -= dt; const e = Math.min(1, dt * 4); this.px -= this.px * e; this.py -= this.py * e; this.vx = this.vy = 0; this.total += dt; this.pushTrail(dt); return; }\n    const k = S.k * D.k * (ef.k || 1), c = S.c * D.c, s = S.s * D.s * gm + (ef.s || 0), A = S.A * D.A * gm * (ef.A || 1), f = (S.nf || 1) * D.nf;\n    const sx = S.sx !== undefined ? S.sx * D.s * gm : s, sy = S.sy !== undefined ? S.sy * D.s * gm : s;\n    if (S.push) { this.pushT -= dt; if (this.pushT <= 0) { this.pushT += S.push[1]; const a = this.rng() * 6.283, v = S.push[0] * D.push; this.vx += Math.cos(a) * v; this.vy += Math.sin(a) * v; } }\n    const ax = k * (ux - this.px) - c * this.vx + sx * this.px + A * this.nx(this.t * f) + (ef.fx || 0);\n    const ay = k * (uy - this.py) - c * this.vy + sy * this.py + A * this.ny(this.t * f) + (ef.fy || 0);\n    this.vx += ax * dt; this.vy += ay * dt; this.px += this.vx * dt; this.py += this.vy * dt;\n    if (this.xOnly) { this.py = 0; this.vy = 0; }\n    this.total += dt; if (this.inRing) { this.inside += dt; this.streak += dt; } else this.streak = 0;\n    this.pushTrail(dt);\n    const lim = D.stumble * (this.o.stumbleAt || 1), l = this.lean;\n    if (l >= lim) {\n      if (this.o.noFall || G.TOOLS.noStumble) { this.px *= lim / l * .99; this.py *= lim / l * .99; this.vx *= .5; this.vy *= .5; }\n      else { this.falls++; this.stumbleT = 1; this.streak = 0; if (this.onFall) this.onFall(); }\n    }\n  }\n  pushTrail(dt) { this.nphaseT += dt; if (this.nphaseT > .04) { this.nphaseT = 0; this.trail.push(this.px, this.py); if (this.trail.length > 50) this.trail.splice(0, 2); } }\n};\n\n// Bots share the model: they react to where the body was tau seconds ago.\nG.BOTS = { poor: { tau: .34, gain: 1.1, damp: .22, noise: .16 }, average: { tau: .25, gain: 1.4, damp: .30, noise: .08 }, good: { tau: .18, gain: 1.8, damp: .36, noise: .04 }, expert: { tau: .14, gain: 2.2, damp: .42, noise: .02 } };\nG.LeanBot = class {\n  constructor(skill, rng) { this.b = G.BOTS[skill]; this.skill = skill; this.q = []; this.ux = 0; this.uy = 0; this.t = 0; this.nx = G.noise(rng, 1.3); this.ny = G.noise(rng, 1.1); }\n  // ex, ey: the error to correct (where the body is, relative to where it wants to be); vx, vy: its speed\n  step(dt, ex, ey, vx, vy) {\n    this.t += dt; this.q.push(this.t, ex, ey, vx, vy);\n    while (this.q.length > 5 && this.q[5] <= this.t - this.b.tau) this.q.splice(0, 5);\n    const b = this.b, tx = -b.gain * this.q[1] - b.damp * this.q[3] + b.noise * this.nx(this.t), ty = -b.gain * this.q[2] - b.damp * this.q[4] + b.noise * this.ny(this.t), e = Math.min(1, dt * 16);\n    this.ux += (tx - this.ux) * e; this.uy += (ty - this.uy) * e;\n    const l = Math.hypot(this.ux, this.uy); if (l > 1) { this.ux /= l; this.uy /= l; }\n    return [this.ux, this.uy];\n  }\n};\n\n// Intent: activities read this, never a device. Devices, bots and attract all fill the same object.\nG.newIntent = () => ({ ux: 0, uy: 0, breath: 0, breathOn: false, catchL: false, catchR: false, paceL: false, paceR: false, jump: false, effort: 0, press: [false, false, false, false], touched: false, source: 'keys' });\nG.fillDevice = (c, ctx, dt) => {\n  const I = c.input, i = c.intent, src = i.source = c.player1 ? G.source(I) : (I.lastDevice === 'gamepad' ? 'pad' : 'keys'), D = G.DEV;\n  const prevx = i.ux, prevy = i.uy;\n  if (src === 'pad') { const m = I.padMove || [0, 0]; i.ux = m[0]; i.uy = -m[1]; }\n  else if (src === 'mouse') { const p = I.pointer(), H = G.game.H || 240, W = G.game.W || 320; if (p && !(G.Dev && G.Dev.isOpen && p[0] < W / 3)) { i.ux = (p[0] - W / 2) / (H * D.mouseReach); i.uy = -(p[1] - H / 2) / (H * D.mouseReach); } }\n  else {\n    let mx = 0, my = 0;\n    if (G.Dev && G.Dev.isOpen && c.player1) { const h = I.held; mx = (h.has('KeyD') ? 1 : 0) - (h.has('KeyA') ? 1 : 0); my = (h.has('KeyS') ? 1 : 0) - (h.has('KeyW') ? 1 : 0); }\n    else { const m = I.move(); mx = m[0]; my = m[1]; }\n    if (ctx.def.kbDirect) { i.ux = mx; i.uy = -my; }\n    else if (mx || my) { const r = D.nudge * dt; i.ux += mx * r; i.uy -= my * r; }\n    else { const l = Math.hypot(i.ux, i.uy), d = .5 * dt; if (l <= d) { i.ux = 0; i.uy = 0; } else { i.ux -= i.ux / l * d; i.uy -= i.uy / l * d; } }\n  }\n  const l = Math.hypot(i.ux, i.uy); if (l > 1) { i.ux /= l; i.uy /= l; }\n  if (Math.abs(i.ux - prevx) + Math.abs(i.uy - prevy) > 1e-6 && src !== 'keys' || I.move()[0] || I.move()[1]) i.touched = true;\n  // breath: analog triggers read through, digital ramps over four seconds\n  const bv = I.value('breath'), analog = src === 'pad' && bv > 0 && bv < 1;\n  const G2 = G.game.settings; let held = bv > .02;\n  if (G2 && G2.breathMode === 'Toggle' && src !== 'pad') { if (I.pressed('breath')) i.breathOn = !i.breathOn; held = i.breathOn; }\n  if (analog) i.breath = bv; else i.breath = clamp(i.breath + (held ? 1 : -1) * dt / 4, 0, 1);\n  i.effort = src === 'pad' ? bv : (bv > .02 ? .6 : 0);\n  if (I.map && I.map.catchL) { i.catchL = I.pressed('catchL'); i.catchR = I.pressed('catchR'); }\n  if (I.map && I.map.paceL) { i.paceL = I.pressed('paceL'); i.paceR = I.pressed('paceR'); }\n  i.jump = I.map && I.map.jump ? I.pressed('jump') : false;\n  const lanes = (ctx.classMode || !I.map.stepL) ? ['left', 'down', 'up', 'right'] : ['stepL', 'stepD', 'stepU', 'stepR'];\n  for (let n = 0; n < 4; n++) i.press[n] = I.pressed(lanes[n]);\n};\nEOF\ncat > game/rigs.js <<'EOF'\n// Rigs: real mocap on Humanoids, a hand-posed layer for moves with no clip, a wobble about the feet; Tare, Gerald, the cast.\nG.lib = Mocap.load(window.MOCAP.FITCLIPS);\nconst V3 = E.V3, add = V3.add;\nfunction setBody(rig, b) {\n  const o = rig.o, J = rig.J, hipC = b.hip;\n  J.hipC = hipC; J.hipL = add(hipC, [0, -o.hipHalf, 0]); J.hipR = add(hipC, [0, o.hipHalf, 0]);\n  for (const s of [-1, 1]) { const hip = s > 0 ? J.hipR : J.hipL, foot = s > 0 ? b.footR : b.footL,\n      [kn, f2] = E.ik3(hip, foot, o.legUpper, o.legLower, b.knee ? b.knee(s) : [1, s * .3, .1]);\n    J[s > 0 ? 'kneeR' : 'kneeL'] = kn; J[s > 0 ? 'footR' : 'footL'] = f2; }\n  const dir = V3.norm(b.chest || [0, 0, 1]), shC = add(hipC, V3.mul(dir, o.torso)); J.shC = shC;\n  J.shL = add(shC, [0, -o.shoulderHalf, 0]); J.shR = add(shC, [0, o.shoulderHalf, 0]);\n  J.head = add(shC, V3.mul(V3.norm([dir[0], dir[1], dir[2] + .4]), o.neck + o.headR));\n  for (const s of [-1, 1]) { const sh = s > 0 ? J.shR : J.shL, hand = s > 0 ? b.handR(shC, sh) : b.handL(shC, sh),\n      [el, h2] = E.ik3(sh, hand, o.armUpper, o.armLower, [-1, s * .7, -.2]);\n    J[s > 0 ? 'elbowR' : 'elbowL'] = el; J[s > 0 ? 'handR' : 'handL'] = h2; }\n}\nG.moves = {\n  sideLunge: u => rig => { const o = rig.o, a = Math.abs(u), w = o.footSpread + 5.4;\n    return { hip: [0, u * 3.8, o.hipZ - a * o.hipZ * .4], footL: [.5, -w, 0], footR: [.5, w, 0], knee: s => [1, s * .7, .1],\n      chest: [.28 * a, -u * .1, 1], handL: c => add(c, [4, -.6, -2.6]), handR: c => add(c, [4, .6, -2.6]) }; },\n  hula: ph => rig => { const o = rig.o, hx = Math.cos(ph) * 2.1, hy = Math.sin(ph) * 2.1;\n    return { hip: [hx, hy, o.hipZ - .5], footL: [.3, -o.footSpread - 1, 0], footR: [.3, o.footSpread + 1, 0], chest: [-hx * .22, -hy * .22, 1],\n      handL: (c, sh) => add(sh, [.4, -6, 1.6 + Math.sin(ph) * .6]), handR: (c, sh) => add(sh, [.4, 6, 1.6 - Math.sin(ph) * .6]) }; },\n  stepUp: (k, zb = 5) => rig => { const o = rig.o;\n    return { hip: [.2 + k * 1.2, k * 1.6, o.hipZ + k * zb * .7], footL: [k > .5 ? 3 : -1, -o.footSpread, k > .85 ? zb : 0], footR: [3, o.footSpread, zb * Math.min(1, k * 2)],\n      chest: [.1, 0, 1], handL: (c, sh) => add(sh, [1 + k * 3, -1.2, -3 + k * 2]), handR: (c, sh) => add(sh, [3 - k * 3, 1.2, -1 - k * 2]) }; },\n  // the rope: walking with the arms held out, driven by the rig's own walk under this\n  armsOut: t => rig => null\n};\nG.makeRig = opts => {\n  const rig = new E.Humanoid(Object.assign({ weapon: null }, opts));\n  Mocap.drive(rig, G.lib);\n  const base = rig.solvePose;\n  rig.wob = [0, 0]; rig.body = null;\n  rig.solvePose = function () {\n    base.call(this);\n    if (this.body) { const b = this.body(this); if (b) setBody(this, b); }\n    const ax = this.wob[0], ay = this.wob[1]; if (!ax && !ay) return;\n    const J = this.J, a = ax * .45, b = ay * .3, ca = Math.cos(a), sa = Math.sin(a), cb = Math.cos(b), sb = Math.sin(b);\n    for (const k in J) { if (k === 'bladeDir' || !J[k]) continue; const p = J[k];\n      const r2 = p[1] * ca + p[2] * sa, z2 = -p[1] * sa + p[2] * ca, f2 = p[0] * cb + z2 * sb, z3 = -p[0] * sb + z2 * cb;\n      p[0] = f2; p[1] = r2; p[2] = Math.max(z3, 0); }\n  };\n  return rig;\n};\n// poses: the table of clips and windows lives in game/data/poses.js\nG.clip = n => G.lib.clip(n);\nG.poseT = (name, time) => { const P = G.POSES[name], a = P.a, b = P.b; return a + (b - a) * .3 * (.5 + .5 * Math.sin(time * .7)); };\nG.samplePose = (name, time, out) => { const P = G.POSES[name]; return G.lib.sample(G.clip(P.clip), G.poseT(name, time), out); };\nG.loopT = (clip, t) => { const c = G.clip(clip); return c.dur > 0 ? t % c.dur : 0; };\nG.sampleLoop = (clip, t) => G.lib.sample(G.clip(clip), G.loopT(clip, t));\n// drive a rig for one step. tgt: facing; a clip turns the rig by its own heading, so aim with tgt minus that turn\nG.place = (rig, dt, x, y, z, tgt, extra) => {\n  rig.update(dt, Object.assign({ x, y, z: z || 0, vx: 0, vy: 0, facing: tgt - (rig.spin || 0) }, extra || {}));\n  rig.px = x; rig.py = y; rig.pz = z || 0;\n};\n\nconst WOOD = { birch: ['#d9b68a', '#b8905f', '#7c5a35'], alder: ['#ecd3ac', '#d0ae80', '#94744a'] };\nG.instructorRig = (who, size = 2.1) => {\n  const w = WOOD[who], c = w[0], s = w[1];\n  const rig = G.makeRig({ size, build: 'heroic', limbW: 1.5, torsoW: 2.5, hair: who === 'alder' ? 'ponytail' : 'bald', sleeves: 'none', outfit: 'shirt',\n    colors: { skin: c, hair: s, cloth: c, coat: c, pants: s, boot: s, belt: s, trim: s, glove: c, eye: '#5a3a1a', iris: '#5a3a1a' } });\n  rig.wood = w; return rig;\n};\nE.Humanoid.hat('sunhat', w => { /* drawn with the rig's hat helpers; see G.drawAccessories for its brim */ });\nG.lookToRig = (look, size = 2.1, wear = {}) => {\n  const SK = G.LOOKS.skins, TO = G.LOOKS.tops, BO = G.LOOKS.bottoms;\n  const o = { size, build: 'chibi', hair: look.hair, outfit: 'shirt', sleeves: 'short',\n    colors: { skin: SK[look.skin], hair: look.hairColor || '#4a3428', cloth: TO[look.top], coat: TO[look.top], pants: BO[look.bottom], boot: '#f4f4f0', belt: BO[look.bottom], trim: '#ffffff', glove: SK[look.skin], eye: '#20202a' } };\n  if (wear.headband) o.hat = { style: 'band', color: '#2cc6e6' };\n  const rig = G.makeRig(o); rig.wear = wear; rig.look = look; return rig;\n};\nG.memberRig = (size = 2.1) => { const st = G.state; return G.lookToRig(st.look, size, G.wearOf(st)); };\nG.wearOf = st => { const w = {}; for (const u of G.unlockedItems(st)) w[u.id] = !(st.wear && st.wear[u.id] === false); return w; };\nG.regularRig = (id, size = 1.9) => { const R = G.CAST[id]; return G.makeRig(Object.assign({ size, build: 'chibi', sleeves: 'short', outfit: 'shirt' }, R.rig, { colors: Object.assign({ boot: '#e8e8e8' }, R.rig.colors) })); };\n\n// after rig.draw, in the same r.actor: mannequin ball joints, and what the member has unlocked\nconst JOINTS = ['kneeL', 'kneeR', 'elbowL', 'elbowR', 'shL', 'shR'];\nG.drawExtras = (g, rig, ox, oy, r) => {\n  const v = rig.lastView || r.view;\n  if (rig.wood) for (const k of JOINTS) { if (!rig.J || !rig.J[k]) continue; const w = rig.worldOffset(rig.J[k]), p = v.p(w[0], w[1], w[2]);\n    const R = rig.o.size >= 1.8 ? 3 : 2; px.disc(g, ox + p[0], oy + p[1], R, rig.wood[2]); px.disc(g, ox + p[0], oy + p[1], R - 1, rig.wood[1]); }\n  if (rig.wear && rig.J && rig.J.head) {\n    const hw = rig.worldOffset(rig.J.head), hp = v.p(hw[0], hw[1], hw[2]), hx = ox + hp[0], hy = oy + hp[1], R = Math.round(rig.o.headR * (rig.o.size || 1) * 1.5);\n    if (rig.wear.sunhat || rig.wear.spareHat) { const c = rig.wear.spareHat ? '#c7a7e8' : '#f3dfa0', d = rig.wear.spareHat ? '#a584cc' : '#d8bf78';\n      px.ell(g, hx, hy - R * .75, R * 1.9, Math.max(2, R * .45), d); px.ell(g, hx, hy - R * .85, R * 1.8, Math.max(2, R * .38), c); px.disc(g, hx, hy - R * 1.1, R * .8, c); }\n    if (rig.wear.towel && rig.J.shC) { const s = rig.worldOffset(rig.J.shC), p = v.p(s[0], s[1], s[2]);\n      px.rect(g, ox + p[0] - 5, oy + p[1] - 2, 10, 3, '#f8f8f4'); px.rect(g, ox + p[0] - 5, oy + p[1], 3, 7, '#f8f8f4'); px.rect(g, ox + p[0] + 2, oy + p[1], 3, 5, '#dfeef0'); }\n  }\n};\nG.actor = (r, rig, o = {}) => {\n  r.shadow(rig.px, rig.py, (o.shadow || 8), .3);\n  r.actor(rig.px, rig.py, rig.pz || 0, (g, ox, oy) => { rig.draw(g, ox, oy, r.view); G.drawExtras(g, rig, ox, oy, r); }, o);\n};\n\n// Tare ------------------------------------------------------------------------------------------------------------\n// A white slab with footprints, a small dial, short legs, cyan LED eyes on the front edge and eight faces.\nG.FACES = { neutral: 1, happy: 1, worried: 1, smug: 1, shocked: 1, sad: 1, asleep: 1, judging: 1 };\nG.drawTareAt = (g, cx, by, s = 1, face = 'neutral', sq = 0, wearTie = false, time = 0) => {\n  const W = Math.round(17 * s * (1 + sq * .35)), H = Math.max(3, Math.round(6 * s * (1 - sq * .5))), top = Math.round(4 * s * (1 - sq * .5)), L = Math.max(1, Math.round(2 * s));\n  const yb = by - L; // legs\n  px.rect(g, cx - W + 2, yb, Math.max(2, 2 * s), L, '#9fb3bb'); px.rect(g, cx + W - 2 - Math.max(2, 2 * s), yb, Math.max(2, 2 * s), L, '#9fb3bb');\n  // the top surface, then the front edge\n  px.poly(g, [[cx - W + 2 * s, yb - H - top], [cx + W - 2 * s, yb - H - top], [cx + W, yb - H], [cx - W, yb - H]], '#ffffff');\n  px.rect(g, cx - W, yb - H, W * 2, H, '#e6eff2'); px.rect(g, cx - W, yb - 1, W * 2, 1, '#b9cbd2');\n  // footprints and dial\n  const fy = yb - H - top * .55;\n  px.ell(g, cx - W * .42, fy, 3 * s, 1.2 * s, '#d4e3e8'); px.ell(g, cx + W * .42, fy, 3 * s, 1.2 * s, '#d4e3e8');\n  px.ell(g, cx, fy, 2 * s, 1 * s, '#bcd9e2'); px.rect(g, cx, fy - 1 * s, 1, 1 * s, '#e0553a');\n  // face on the front edge\n  const ey = yb - H * .55, ex = W * .42, C = '#20c8ec', D2 = '#0a7f9a', e = Math.max(1, Math.round(s));\n  const eye = (x, kind) => {\n    if (kind === 'dot') px.rect(g, x - e, ey - e, e * 2, e * 2, C);\n    else if (kind === 'wide') px.rect(g, x - e, ey - e * 2, e * 2, e * 3, C);\n    else if (kind === 'line') px.rect(g, x - e * 2, ey, e * 4, e, C);\n    else if (kind === 'up') { px.rect(g, x - e * 2, ey, e, e, C); px.rect(g, x - e, ey - e, e * 2, e, C); px.rect(g, x + e, ey, e, e, C); }\n    else if (kind === 'down') { px.rect(g, x - e * 2, ey - e, e, e, C); px.rect(g, x - e, ey, e * 2, e, C); px.rect(g, x + e, ey - e, e, e, C); }\n  };\n  const blink = Math.sin(time * 1.3) > .985;\n  const F = { neutral: ['dot', 'dot'], happy: ['up', 'up'], worried: ['down', 'dot'], smug: ['line', 'up'], shocked: ['wide', 'wide'], sad: ['down', 'down'], asleep: ['line', 'line'], judging: ['line', 'dot'] }[face] || ['dot', 'dot'];\n  eye(cx - ex, blink ? 'line' : F[0]); eye(cx + ex, blink ? 'line' : F[1]);\n  if (face === 'happy') px.rect(g, cx - e * 2, ey + e, e * 4, e, D2);\n  if (face === 'sad' || face === 'worried') px.rect(g, cx - e, ey + e, e * 2, e, D2);\n  if (face === 'shocked') px.rect(g, cx - e, ey, e * 2, e * 2, D2);\n  if (wearTie) { const ty = yb - H - top * .1; px.poly(g, [[cx, ty], [cx - 3 * s, ty - 1.6 * s], [cx - 3 * s, ty + 1.6 * s]], '#e0553a'); px.poly(g, [[cx, ty], [cx + 3 * s, ty - 1.6 * s], [cx + 3 * s, ty + 1.6 * s]], '#e0553a'); }\n};\nG.tarePortrait = (face = 'neutral') => (g, x, y, size) => { px.rect(g, x, y, size, size, '#d8f3fb'); G.drawTareAt(g, x + size / 2, y + size - 8, size / 24, G.talkFace || face, 0, false, G.game.real); };\nG.Tare = class {\n  constructor(x, y, o = {}) { this.x = x; this.y = y; this.z = 0; this.vz = 0; this.sq = 0; this.sv = 0; this.face = o.face || 'neutral'; this.s = o.s || 1; this.hopT = 1 + Math.random(); this.onGround = true; this.auto = o.auto !== false; }\n  hop(v = 70) { if (this.z <= 0) { this.vz = v; this.sv = -5; G.sfx('tareHop', { vol: .25 }); } }\n  update(dt) {\n    if (this.auto) { this.hopT -= dt; if (this.hopT <= 0) { this.hopT = 1.2 + Math.random() * 2; this.hop(); } }\n    this.vz -= 300 * dt; this.z += this.vz * dt; if (this.z <= 0) { if (this.vz < -30) this.sv = 6; this.z = 0; this.vz = 0; }\n    this.sv += (-this.sq * 90 - this.sv * 10) * dt; this.sq += this.sv * dt;\n  }\n  draw(r, o = {}) {\n    r.shadow(this.x, this.y, 14 * this.s, .3);\n    r.queue(this.x, this.y, this.z, g => { const p = r.w(this.x, this.y, this.z); G.drawTareAt(g, p[0], p[1], this.s, this.face, this.sq, G.state && G.state.minutes >= 20, G.game.real); }, o);\n  }\n};\n\n// Gerald: a ceramic hippo with a coin slot. He swallows minutes. Sometimes he has a friend.\nG.drawGeraldAt = (g, x, y, s = 1, friend = false, gulp = 0) => {\n  const c = '#9fb8d0', d = '#7d97b4', l = '#c3d6e6', W = 14 * s, H = 9 * s + gulp * s;\n  const one = (x, y, s, W, H) => {\n    px.ell(g, x, y - H, W, H, c); px.ell(g, x - W * .3, y - H * 1.35, W * .45, H * .45, l);\n    px.ell(g, x + W * .85, y - H * .9, W * .55, H * .72, c); px.ell(g, x + W * 1.05, y - H * .68, W * .36, H * .38, l);\n    px.rect(g, x + W * .95, y - H * .72, 1, 1, d); px.rect(g, x + W * 1.2, y - H * .72, 1, 1, d);\n    px.disc(g, x + W * .75, y - H * 1.45, Math.max(1, 1.6 * s), '#ffffff'); px.rect(g, x + W * .75, y - H * 1.45, 1, 1, '#20404c');\n    px.disc(g, x + W * .55, y - H * 1.65, Math.max(1, 1.6 * s), d);\n    for (const lx of [-W * .7, -W * .25, W * .25, W * .6]) px.rect(g, x + lx, y - 3 * s, 4 * s, 3 * s, d);\n    px.rect(g, x - W * .3, y - H * 2 + 1, 6 * s, Math.max(1, s), '#20404c');\n  };\n  one(x, y, s, W, H);\n  if (friend) one(x - W * 1.6, y, s * .55, W * .55, H * .55);\n};\n\n// Regulars' walking helper for the island and backgrounds\nG.Blobs = { gull: () => new E.Blob({ R: 3, wings: true, colors: { dk: '#b9c7cf', base: '#f4f7f8', lt: '#ffffff', spec: '#ffffff', eye: '#20303a', pupil: '#20303a' } }), pigeon: () => new E.Blob({ R: 3, wings: true, feet: true, colors: { dk: '#68727f', base: '#8e99a8', lt: '#b6bfcb', spec: '#ffffff', eye: '#d0602a', pupil: '#20303a' } }) };\nEOF\nsed -i \"s/^  \\/\\/ the rope: walking with the arms held out, driven by the rig's own walk under this\\n//\" game/rigs.js\npython3 - <<'EOF'\nimport re\np='game/rigs.js';s=open(p).read()\ns=s.replace(\"  // the rope: walking with the arms held out, driven by the rig's own walk under this\\n  armsOut: t => rig => null\\n\",\"\")\ns=s.replace(\"  stepUp: (k, zb = 5) =>\",\"  stepUp: (k, zb = 5) =>\")\ns=s.replace(\"\"\"E.Humanoid.hat('sunhat', w => { /* drawn with the rig's hat helpers; see G.drawAccessories for its brim */ });\\n\"\"\",\"\")\nopen(p,'w').write(s)\nEOF","description":"Write core, balance model and rigs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4893,"cache_read_input_tokens":169791,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4893},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6a88ba50-da75-48c3-bde0-396ebfab72e9","uuid":"b0aa0be2-c840-48e2-a8f1-028c77ceefb9","timestamp":"2026-11-05T05:21:14.966Z","request_id":"req_011CgjDYHEqB8n2ynyhtZ19U","wire_tool_inputs":{"toolu_01Q3RB23EcvaFz2BvcuJWM4e":{"command":"mkdir -p game/data game/activities game/scenes tests\ncat > game/core.js <<'EOF'\n// Why Fit: the shared namespace, the game object, the input map, the live balance values, member state and saves.\nconst E = My3D2dge, { px, clamp, lerp } = E;\nconst G = window.G = window.G || {};\nG.TITLE = 'WHY FIT';\nG.acts = {}; G.actOrder = []; G.scenes = {};\nG.inSession = !!(window.AIHub && AIHub.active);\n\nconst D = E.Input.DEFAULT;\nG.INPUT = {\n  up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\n  confirm: D.confirm, cancel: [...D.cancel, 'Mouse2'],\n  breath: ['Space', 'Mouse0', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Mouse0', 'Pad4'], catchR: ['KeyE', 'Mouse2', 'Pad5'],\n  jump: ['Space', 'Mouse2', 'Pad0'], interact: ['KeyE', 'Enter', 'Pad0'], more: ['Tab', 'KeyM', 'Pad3'], retry: ['KeyR', 'Pad2'],\n  paceL: ['KeyJ', 'Mouse0', 'Pad6'], paceR: ['KeyK', 'Mouse2', 'Pad7'],\n  stepL: ['KeyA', 'ArrowLeft', 'Mouse0', 'Pad14', 'PadAxisLeft'], stepR: ['KeyD', 'ArrowRight', 'Mouse2', 'Pad15', 'PadAxisRight'],\n  stepU: ['KeyW', 'ArrowUp', 'WheelUp', 'Pad12', 'PadAxisUp'], stepD: ['KeyS', 'ArrowDown', 'WheelDown', 'Pad13', 'PadAxisDown'],\n  devU: ['ArrowUp', 'Pad12'], devD: ['ArrowDown', 'Pad13'], devL: ['ArrowLeft', 'Pad14'], devR: ['ArrowRight', 'Pad15'],\n  devCL: ['PageDown', 'Pad4'], devCR: ['PageUp', 'Pad5'], devA: ['Enter', 'Pad0'], devB: ['Backspace', 'Pad1']\n};\n// half a keyboard runs out of keys with the full map, so Class plays with the moves, the menu actions and three buttons\nG.CLASS_INPUT = { up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause, confirm: D.confirm, cancel: D.cancel,\n  breath: ['Space', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Pad4'], catchR: ['KeyE', 'Pad5'],\n  devU: G.INPUT.devU, devD: G.INPUT.devD, devL: G.INPUT.devL, devR: G.INPUT.devR, devCL: G.INPUT.devCL, devCR: G.INPUT.devCR, devA: G.INPUT.devA, devB: G.INPUT.devB };\n\n// DEV: every live slider. Multipliers are 1 by default so each activity keeps its own numbers in game/data.\nG.DEV_DEFAULTS = { k: 1, c: 1, s: 1, A: 1, nf: 1, ring: 1, push: 1, stumble: 1, mouseReach: .33, nudge: 2.2,\n  star1: 1, star2: 1, star3: 1, repTol: 1, rhythmWin: 1, fatigue: 1,\n  hoopBand: 1, jogBand: 1, jogSpeed: 1,\n  slalomSpeed: 1, slalomTurn: 1, trayG: 420, trayFric: .4, ropeS: 1, gust: 1,\n  timeScale: 1, minutes: 1 };\nG.DEV = Object.assign({}, G.DEV_DEFAULTS);\nG.TOOLS = { noStumble: false, bot: null, trace: false, frozen: false, step: 0 };\n\nconst SETTINGS = [\n  { key: 'music', value: .1 }, { key: 'glyphs', value: 'playstation' },\n  { key: 'voice', label: 'Voices', type: 'slider', min: 0, max: 1, step: .05, value: .8, group: 'Sound', apply(g, v) { g.audio.voiceVolume = v; } },\n  { key: 'gentle', label: 'Gentle Mode', value: false, help: 'A wider ring and a calmer body. Tare will not tell anyone.' },\n  { key: 'breathMode', label: 'Breath', options: ['Hold', 'Toggle'], value: 'Hold', help: 'Hold the button to breathe in, or press it once for each breath.' },\n  { key: 'tips', label: \"Tare's Tips\", value: true, help: 'Tare offers a tip each morning. You may decline. Tare will notice.' }\n];\nconst game = G.game = new E.Game({ canvas: 'screen', id: 'whyfit', res: 'ps1', expand: true, touch: 'never', input: G.INPUT, view: 'brawler',\n  autoPause: !G.inSession, live: G.inSession, fullscreen: G.inSession ? false : 'button', camera: { zoom: false },\n  menu: { quit: G.inSession ? false : 'title', settings: SETTINGS,\n    items: G.inSession ? [] : [['Restart Session', () => G.restartSession()], ['Dev Mode', () => G.Dev.open()]],\n    controls: { confirm: 'Confirm', cancel: 'Back', up: 'Lean forward', down: 'Lean back', left: 'Lean left', right: 'Lean right',\n      breath: 'Breath and effort', catchL: 'Catch left', catchR: 'Catch right', jump: 'Jump', interact: 'Talk or use', paceL: 'Left step', paceR: 'Right step',\n      more: false, retry: false, stepL: false, stepR: false, stepU: false, stepD: false, devU: false, devD: false, devL: false, devR: false, devCL: false, devCR: false, devA: false, devB: false } } });\n\nif (game.shell === null && !game.headless) new E.Shell(game, { theme: { ink: '#20404c', paper: '#f7fbfb', accent: '#14a8c8', muted: '#5f7f8a', danger: '#e0553a', line: '#c8dde2', font: 'system-ui, sans-serif', titleFont: 'system-ui, sans-serif' } });\nif (typeof document !== 'undefined' && document.addEventListener) document.addEventListener('pointerover', e => {\n  const b = e.target.closest && e.target.closest('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)');\n  if (b && e.pointerType === 'mouse') b.focus({ preventScroll: true }); });\n\nG.rng = E.rng(20261104);\nG.pick = (list, rng = G.rng) => list[Math.floor(rng() * list.length) % list.length];\n// a line from a bank that does not repeat until the bank is used up (kept in the member, so a second playthrough still surprises)\nG.line = (key, rng = G.rng) => {\n  const bank = G.LINES[key]; if (!bank) { game.fail('line', new Error('no line ' + key)); return '...'; }\n  if (typeof bank === 'string') return bank;\n  const st = G.state || {}; const seen = st.seen = st.seen || {}; const left = bank.map((_, i) => i).filter(i => !(seen[key] || []).includes(i));\n  if (!left.length) seen[key] = [];\n  const pool = left.length ? left : bank.map((_, i) => i), i = pool[Math.floor(rng() * pool.length) % pool.length];\n  (seen[key] = seen[key] || []).push(i); return bank[i];\n};\n\n// Member state ---------------------------------------------------------------------------------------------------\nG.newMember = (name, look) => ({ name, look, instructor: null, day: 1, session: 0, minutes: 0, best: {}, ages: [], age: 71, heldAge: 71, seen: {}, wear: { top: null, hat: null },\n  pauses: 0, lastSeen: Date.now(), flags: {}, suggestion: null, finalAge: null, duelWon: false, finished: false, sessionsDone: 0, played: {} });\nG.state = null; G.slot = 0;\nG.bestStars = (st, id) => { const b = st.best[id]; if (!b) return 0; return Math.max(...Object.values(b).map(x => x.stars)); };\nG.discScore = (st, d) => { const ids = G.actOrder.filter(i => G.acts[i].discipline === d); return ids.reduce((a, i) => a + G.bestStars(st, i) * 33.3, 0) / (ids.length || 1); };\nG.DISCIPLINES = ['Stillness', 'Strength', 'Cardio', 'Balance'];\nG.computeAge = st => { const O = G.DISCIPLINES.reduce((a, d) => a + G.discScore(st, d), 0) / 4; return Math.min(71, Math.round(78 - .58 * O)) - (st.duelWon ? 1 : 0); };\n// on the plateau the number that matters stays where it was; the next morning it catches up all at once\nG.morningAge = st => { const real = G.computeAge(st); return st.day === 3 ? (st.ages.length ? st.ages[st.ages.length - 1] : real) : real; };\nG.unlockedItems = st => G.UNLOCKS.filter(u => st.minutes >= u.at);\nG.dayInfo = st => G.DAYS[Math.min(st.day, G.DAYS.length) - 1];\nG.isUnlocked = (st, id) => { if (st.finished || st.day > 5) return true; let ok = false; G.DAYS.forEach((d, i) => { if (i < st.day && d.unlocks.includes(id)) ok = true; }); return ok; };\nG.tier2Open = (st, id) => (st.finished || st.day >= 4) && G.bestStars(st, id) >= 2;\nG.sessionsLeft = st => Math.max(0, 3 - st.session);\n\nG.saves = game.saves;\ngame.saves.write = () => ({ data: JSON.parse(JSON.stringify(G.state)), place: 'Day ' + G.state.day, level: G.state.age });\ngame.saves.read = s => { G.state = s.data; };\nG.save = () => { if (G.noSave || !G.state || G.inSession) return; game.saves.save(G.slot); };\nG.members = () => { const out = []; for (let i = 0; i < 3; i++) { const s = game.saves.get(i); out.push(s && !s.damaged && !s.newer && s.data && s.data.look ? s : null); } return out; };\nG.loadMember = slot => { const s = game.saves.load(slot); if (s) G.slot = slot; return !!s; };\n\n// Which device leans: the pad if it was used last; otherwise the mouse if it moved more recently than a key went down.\nG.keyT = -1;\ngame.hook('input', () => { const I = game.input; if (I.held && [...I.held].some(c => c.startsWith('Key') || c.startsWith('Arrow') || c === 'Space' || c.startsWith('Act:'))) G.keyT = I.clock; });\nG.source = (I = game.input) => { if (I.lastDevice === 'gamepad') return 'pad'; if (I === game.input && I.mouse && I.mouse.active !== false && I.mouse.t > G.keyT && I.pointer && I.pointer()) return 'mouse'; return 'keys'; };\n\n// Scenes: every scene goes through here, so Dev Mode, the idle timer and the demo chip are the same everywhere.\nG.scene = (name, def) => {\n  const u = def.update || (() => {}), d = def.draw || (() => {});\n  def.update = function (dt) { if (G.Dev && G.Dev.blocks()) return; u.call(def, dt); };\n  def.draw = function (r) { d.call(def, r); if (G.Attract) G.Attract.draw(r); if (G.Dev) G.Dev.draw(r); };\n  G.scenes[name] = def; return def;\n};\nEOF\ncat > game/balance.js <<'EOF'\n// The Lean: one centre of balance chased by a target. Every activity reads the same model and the same intent object.\nG.noise = (rng, f) => { const ph = [rng() * 6.28, rng() * 6.28, rng() * 6.28]; return t => (Math.sin(t * f + ph[0]) + .6 * Math.sin(t * f * 1.73 + ph[1]) + .35 * Math.sin(t * f * 2.61 + ph[2])) / 1.3; };\n\nG.Balance = class {\n  constructor(set, rng, o = {}) {\n    this.set = set; this.rng = rng; this.o = o; this.px = 0; this.py = 0; this.vx = 0; this.vy = 0; this.t = 0;\n    this.nx = G.noise(rng, 1); this.ny = G.noise(rng, 1); this.ringX = 0; this.ringY = 0;\n    this.inside = 0; this.total = 0; this.falls = 0; this.stumbleT = 0; this.streak = 0; this.trail = []; this.fx = 0; this.fy = 0; this.pushT = set.push ? set.push[1] : 0; this.onFall = null; this.xOnly = !!o.xOnly;\n    this.nphaseT = 0; this.frozen = false;\n  }\n  get gentle() { return !this.o.noGentle && G.game.settings && G.game.settings.gentle; }\n  get R() { return this.set.R * G.DEV.ring * (this.gentle ? 1.25 : 1) * (this.o.ringMul || 1); }\n  get inRing() { return Math.hypot(this.px - this.ringX, this.py - this.ringY) <= this.R; }\n  get steadiness() { return this.total > 0 ? this.inside / this.total : 0; }\n  get lean() { return Math.hypot(this.px, this.py); }\n  step(dt, ux, uy, ef = {}) {\n    const S = this.set, D = G.DEV, gm = this.gentle ? .7 : 1;\n    this.t += dt;\n    if (this.frozen) return;\n    if (this.stumbleT > 0) { this.stumbleT -= dt; const e = Math.min(1, dt * 4); this.px -= this.px * e; this.py -= this.py * e; this.vx = this.vy = 0; this.total += dt; this.pushTrail(dt); return; }\n    const k = S.k * D.k * (ef.k || 1), c = S.c * D.c, s = S.s * D.s * gm + (ef.s || 0), A = S.A * D.A * gm * (ef.A || 1), f = (S.nf || 1) * D.nf;\n    const sx = S.sx !== undefined ? S.sx * D.s * gm : s, sy = S.sy !== undefined ? S.sy * D.s * gm : s;\n    if (S.push) { this.pushT -= dt; if (this.pushT <= 0) { this.pushT += S.push[1]; const a = this.rng() * 6.283, v = S.push[0] * D.push; this.vx += Math.cos(a) * v; this.vy += Math.sin(a) * v; } }\n    const ax = k * (ux - this.px) - c * this.vx + sx * this.px + A * this.nx(this.t * f) + (ef.fx || 0);\n    const ay = k * (uy - this.py) - c * this.vy + sy * this.py + A * this.ny(this.t * f) + (ef.fy || 0);\n    this.vx += ax * dt; this.vy += ay * dt; this.px += this.vx * dt; this.py += this.vy * dt;\n    if (this.xOnly) { this.py = 0; this.vy = 0; }\n    this.total += dt; if (this.inRing) { this.inside += dt; this.streak += dt; } else this.streak = 0;\n    this.pushTrail(dt);\n    const lim = D.stumble * (this.o.stumbleAt || 1), l = this.lean;\n    if (l >= lim) {\n      if (this.o.noFall || G.TOOLS.noStumble) { this.px *= lim / l * .99; this.py *= lim / l * .99; this.vx *= .5; this.vy *= .5; }\n      else { this.falls++; this.stumbleT = 1; this.streak = 0; if (this.onFall) this.onFall(); }\n    }\n  }\n  pushTrail(dt) { this.nphaseT += dt; if (this.nphaseT > .04) { this.nphaseT = 0; this.trail.push(this.px, this.py); if (this.trail.length > 50) this.trail.splice(0, 2); } }\n};\n\n// Bots share the model: they react to where the body was tau seconds ago.\nG.BOTS = { poor: { tau: .34, gain: 1.1, damp: .22, noise: .16 }, average: { tau: .25, gain: 1.4, damp: .30, noise: .08 }, good: { tau: .18, gain: 1.8, damp: .36, noise: .04 }, expert: { tau: .14, gain: 2.2, damp: .42, noise: .02 } };\nG.LeanBot = class {\n  constructor(skill, rng) { this.b = G.BOTS[skill]; this.skill = skill; this.q = []; this.ux = 0; this.uy = 0; this.t = 0; this.nx = G.noise(rng, 1.3); this.ny = G.noise(rng, 1.1); }\n  // ex, ey: the error to correct (where the body is, relative to where it wants to be); vx, vy: its speed\n  step(dt, ex, ey, vx, vy) {\n    this.t += dt; this.q.push(this.t, ex, ey, vx, vy);\n    while (this.q.length > 5 && this.q[5] <= this.t - this.b.tau) this.q.splice(0, 5);\n    const b = this.b, tx = -b.gain * this.q[1] - b.damp * this.q[3] + b.noise * this.nx(this.t), ty = -b.gain * this.q[2] - b.damp * this.q[4] + b.noise * this.ny(this.t), e = Math.min(1, dt * 16);\n    this.ux += (tx - this.ux) * e; this.uy += (ty - this.uy) * e;\n    const l = Math.hypot(this.ux, this.uy); if (l > 1) { this.ux /= l; this.uy /= l; }\n    return [this.ux, this.uy];\n  }\n};\n\n// Intent: activities read this, never a device. Devices, bots and attract all fill the same object.\nG.newIntent = () => ({ ux: 0, uy: 0, breath: 0, breathOn: false, catchL: false, catchR: false, paceL: false, paceR: false, jump: false, effort: 0, press: [false, false, false, false], touched: false, source: 'keys' });\nG.fillDevice = (c, ctx, dt) => {\n  const I = c.input, i = c.intent, src = i.source = c.player1 ? G.source(I) : (I.lastDevice === 'gamepad' ? 'pad' : 'keys'), D = G.DEV;\n  const prevx = i.ux, prevy = i.uy;\n  if (src === 'pad') { const m = I.padMove || [0, 0]; i.ux = m[0]; i.uy = -m[1]; }\n  else if (src === 'mouse') { const p = I.pointer(), H = G.game.H || 240, W = G.game.W || 320; if (p && !(G.Dev && G.Dev.isOpen && p[0] < W / 3)) { i.ux = (p[0] - W / 2) / (H * D.mouseReach); i.uy = -(p[1] - H / 2) / (H * D.mouseReach); } }\n  else {\n    let mx = 0, my = 0;\n    if (G.Dev && G.Dev.isOpen && c.player1) { const h = I.held; mx = (h.has('KeyD') ? 1 : 0) - (h.has('KeyA') ? 1 : 0); my = (h.has('KeyS') ? 1 : 0) - (h.has('KeyW') ? 1 : 0); }\n    else { const m = I.move(); mx = m[0]; my = m[1]; }\n    if (ctx.def.kbDirect) { i.ux = mx; i.uy = -my; }\n    else if (mx || my) { const r = D.nudge * dt; i.ux += mx * r; i.uy -= my * r; }\n    else { const l = Math.hypot(i.ux, i.uy), d = .5 * dt; if (l <= d) { i.ux = 0; i.uy = 0; } else { i.ux -= i.ux / l * d; i.uy -= i.uy / l * d; } }\n  }\n  const l = Math.hypot(i.ux, i.uy); if (l > 1) { i.ux /= l; i.uy /= l; }\n  if (Math.abs(i.ux - prevx) + Math.abs(i.uy - prevy) > 1e-6 && src !== 'keys' || I.move()[0] || I.move()[1]) i.touched = true;\n  // breath: analog triggers read through, digital ramps over four seconds\n  const bv = I.value('breath'), analog = src === 'pad' && bv > 0 && bv < 1;\n  const G2 = G.game.settings; let held = bv > .02;\n  if (G2 && G2.breathMode === 'Toggle' && src !== 'pad') { if (I.pressed('breath')) i.breathOn = !i.breathOn; held = i.breathOn; }\n  if (analog) i.breath = bv; else i.breath = clamp(i.breath + (held ? 1 : -1) * dt / 4, 0, 1);\n  i.effort = src === 'pad' ? bv : (bv > .02 ? .6 : 0);\n  if (I.map && I.map.catchL) { i.catchL = I.pressed('catchL'); i.catchR = I.pressed('catchR'); }\n  if (I.map && I.map.paceL) { i.paceL = I.pressed('paceL'); i.paceR = I.pressed('paceR'); }\n  i.jump = I.map && I.map.jump ? I.pressed('jump') : false;\n  const lanes = (ctx.classMode || !I.map.stepL) ? ['left', 'down', 'up', 'right'] : ['stepL', 'stepD', 'stepU', 'stepR'];\n  for (let n = 0; n < 4; n++) i.press[n] = I.pressed(lanes[n]);\n};\nEOF\ncat > game/rigs.js <<'EOF'\n// Rigs: real mocap on Humanoids, a hand-posed layer for moves with no clip, a wobble about the feet; Tare, Gerald, the cast.\nG.lib = Mocap.load(window.MOCAP.FITCLIPS);\nconst V3 = E.V3, add = V3.add;\nfunction setBody(rig, b) {\n  const o = rig.o, J = rig.J, hipC = b.hip;\n  J.hipC = hipC; J.hipL = add(hipC, [0, -o.hipHalf, 0]); J.hipR = add(hipC, [0, o.hipHalf, 0]);\n  for (const s of [-1, 1]) { const hip = s > 0 ? J.hipR : J.hipL, foot = s > 0 ? b.footR : b.footL,\n      [kn, f2] = E.ik3(hip, foot, o.legUpper, o.legLower, b.knee ? b.knee(s) : [1, s * .3, .1]);\n    J[s > 0 ? 'kneeR' : 'kneeL'] = kn; J[s > 0 ? 'footR' : 'footL'] = f2; }\n  const dir = V3.norm(b.chest || [0, 0, 1]), shC = add(hipC, V3.mul(dir, o.torso)); J.shC = shC;\n  J.shL = add(shC, [0, -o.shoulderHalf, 0]); J.shR = add(shC, [0, o.shoulderHalf, 0]);\n  J.head = add(shC, V3.mul(V3.norm([dir[0], dir[1], dir[2] + .4]), o.neck + o.headR));\n  for (const s of [-1, 1]) { const sh = s > 0 ? J.shR : J.shL, hand = s > 0 ? b.handR(shC, sh) : b.handL(shC, sh),\n      [el, h2] = E.ik3(sh, hand, o.armUpper, o.armLower, [-1, s * .7, -.2]);\n    J[s > 0 ? 'elbowR' : 'elbowL'] = el; J[s > 0 ? 'handR' : 'handL'] = h2; }\n}\nG.moves = {\n  sideLunge: u => rig => { const o = rig.o, a = Math.abs(u), w = o.footSpread + 5.4;\n    return { hip: [0, u * 3.8, o.hipZ - a * o.hipZ * .4], footL: [.5, -w, 0], footR: [.5, w, 0], knee: s => [1, s * .7, .1],\n      chest: [.28 * a, -u * .1, 1], handL: c => add(c, [4, -.6, -2.6]), handR: c => add(c, [4, .6, -2.6]) }; },\n  hula: ph => rig => { const o = rig.o, hx = Math.cos(ph) * 2.1, hy = Math.sin(ph) * 2.1;\n    return { hip: [hx, hy, o.hipZ - .5], footL: [.3, -o.footSpread - 1, 0], footR: [.3, o.footSpread + 1, 0], chest: [-hx * .22, -hy * .22, 1],\n      handL: (c, sh) => add(sh, [.4, -6, 1.6 + Math.sin(ph) * .6]), handR: (c, sh) => add(sh, [.4, 6, 1.6 - Math.sin(ph) * .6]) }; },\n  stepUp: (k, zb = 5) => rig => { const o = rig.o;\n    return { hip: [.2 + k * 1.2, k * 1.6, o.hipZ + k * zb * .7], footL: [k > .5 ? 3 : -1, -o.footSpread, k > .85 ? zb : 0], footR: [3, o.footSpread, zb * Math.min(1, k * 2)],\n      chest: [.1, 0, 1], handL: (c, sh) => add(sh, [1 + k * 3, -1.2, -3 + k * 2]), handR: (c, sh) => add(sh, [3 - k * 3, 1.2, -1 - k * 2]) }; },\n  // the rope: walking with the arms held out, driven by the rig's own walk under this\n  armsOut: t => rig => null\n};\nG.makeRig = opts => {\n  const rig = new E.Humanoid(Object.assign({ weapon: null }, opts));\n  Mocap.drive(rig, G.lib);\n  const base = rig.solvePose;\n  rig.wob = [0, 0]; rig.body = null;\n  rig.solvePose = function () {\n    base.call(this);\n    if (this.body) { const b = this.body(this); if (b) setBody(this, b); }\n    const ax = this.wob[0], ay = this.wob[1]; if (!ax && !ay) return;\n    const J = this.J, a = ax * .45, b = ay * .3, ca = Math.cos(a), sa = Math.sin(a), cb = Math.cos(b), sb = Math.sin(b);\n    for (const k in J) { if (k === 'bladeDir' || !J[k]) continue; const p = J[k];\n      const r2 = p[1] * ca + p[2] * sa, z2 = -p[1] * sa + p[2] * ca, f2 = p[0] * cb + z2 * sb, z3 = -p[0] * sb + z2 * cb;\n      p[0] = f2; p[1] = r2; p[2] = Math.max(z3, 0); }\n  };\n  return rig;\n};\n// poses: the table of clips and windows lives in game/data/poses.js\nG.clip = n => G.lib.clip(n);\nG.poseT = (name, time) => { const P = G.POSES[name], a = P.a, b = P.b; return a + (b - a) * .3 * (.5 + .5 * Math.sin(time * .7)); };\nG.samplePose = (name, time, out) => { const P = G.POSES[name]; return G.lib.sample(G.clip(P.clip), G.poseT(name, time), out); };\nG.loopT = (clip, t) => { const c = G.clip(clip); return c.dur > 0 ? t % c.dur : 0; };\nG.sampleLoop = (clip, t) => G.lib.sample(G.clip(clip), G.loopT(clip, t));\n// drive a rig for one step. tgt: facing; a clip turns the rig by its own heading, so aim with tgt minus that turn\nG.place = (rig, dt, x, y, z, tgt, extra) => {\n  rig.update(dt, Object.assign({ x, y, z: z || 0, vx: 0, vy: 0, facing: tgt - (rig.spin || 0) }, extra || {}));\n  rig.px = x; rig.py = y; rig.pz = z || 0;\n};\n\nconst WOOD = { birch: ['#d9b68a', '#b8905f', '#7c5a35'], alder: ['#ecd3ac', '#d0ae80', '#94744a'] };\nG.instructorRig = (who, size = 2.1) => {\n  const w = WOOD[who], c = w[0], s = w[1];\n  const rig = G.makeRig({ size, build: 'heroic', limbW: 1.5, torsoW: 2.5, hair: who === 'alder' ? 'ponytail' : 'bald', sleeves: 'none', outfit: 'shirt',\n    colors: { skin: c, hair: s, cloth: c, coat: c, pants: s, boot: s, belt: s, trim: s, glove: c, eye: '#5a3a1a', iris: '#5a3a1a' } });\n  rig.wood = w; return rig;\n};\nE.Humanoid.hat('sunhat', w => { /* drawn with the rig's hat helpers; see G.drawAccessories for its brim */ });\nG.lookToRig = (look, size = 2.1, wear = {}) => {\n  const SK = G.LOOKS.skins, TO = G.LOOKS.tops, BO = G.LOOKS.bottoms;\n  const o = { size, build: 'chibi', hair: look.hair, outfit: 'shirt', sleeves: 'short',\n    colors: { skin: SK[look.skin], hair: look.hairColor || '#4a3428', cloth: TO[look.top], coat: TO[look.top], pants: BO[look.bottom], boot: '#f4f4f0', belt: BO[look.bottom], trim: '#ffffff', glove: SK[look.skin], eye: '#20202a' } };\n  if (wear.headband) o.hat = { style: 'band', color: '#2cc6e6' };\n  const rig = G.makeRig(o); rig.wear = wear; rig.look = look; return rig;\n};\nG.memberRig = (size = 2.1) => { const st = G.state; return G.lookToRig(st.look, size, G.wearOf(st)); };\nG.wearOf = st => { const w = {}; for (const u of G.unlockedItems(st)) w[u.id] = !(st.wear && st.wear[u.id] === false); return w; };\nG.regularRig = (id, size = 1.9) => { const R = G.CAST[id]; return G.makeRig(Object.assign({ size, build: 'chibi', sleeves: 'short', outfit: 'shirt' }, R.rig, { colors: Object.assign({ boot: '#e8e8e8' }, R.rig.colors) })); };\n\n// after rig.draw, in the same r.actor: mannequin ball joints, and what the member has unlocked\nconst JOINTS = ['kneeL', 'kneeR', 'elbowL', 'elbowR', 'shL', 'shR'];\nG.drawExtras = (g, rig, ox, oy, r) => {\n  const v = rig.lastView || r.view;\n  if (rig.wood) for (const k of JOINTS) { if (!rig.J || !rig.J[k]) continue; const w = rig.worldOffset(rig.J[k]), p = v.p(w[0], w[1], w[2]);\n    const R = rig.o.size >= 1.8 ? 3 : 2; px.disc(g, ox + p[0], oy + p[1], R, rig.wood[2]); px.disc(g, ox + p[0], oy + p[1], R - 1, rig.wood[1]); }\n  if (rig.wear && rig.J && rig.J.head) {\n    const hw = rig.worldOffset(rig.J.head), hp = v.p(hw[0], hw[1], hw[2]), hx = ox + hp[0], hy = oy + hp[1], R = Math.round(rig.o.headR * (rig.o.size || 1) * 1.5);\n    if (rig.wear.sunhat || rig.wear.spareHat) { const c = rig.wear.spareHat ? '#c7a7e8' : '#f3dfa0', d = rig.wear.spareHat ? '#a584cc' : '#d8bf78';\n      px.ell(g, hx, hy - R * .75, R * 1.9, Math.max(2, R * .45), d); px.ell(g, hx, hy - R * .85, R * 1.8, Math.max(2, R * .38), c); px.disc(g, hx, hy - R * 1.1, R * .8, c); }\n    if (rig.wear.towel && rig.J.shC) { const s = rig.worldOffset(rig.J.shC), p = v.p(s[0], s[1], s[2]);\n      px.rect(g, ox + p[0] - 5, oy + p[1] - 2, 10, 3, '#f8f8f4'); px.rect(g, ox + p[0] - 5, oy + p[1], 3, 7, '#f8f8f4'); px.rect(g, ox + p[0] + 2, oy + p[1], 3, 5, '#dfeef0'); }\n  }\n};\nG.actor = (r, rig, o = {}) => {\n  r.shadow(rig.px, rig.py, (o.shadow || 8), .3);\n  r.actor(rig.px, rig.py, rig.pz || 0, (g, ox, oy) => { rig.draw(g, ox, oy, r.view); G.drawExtras(g, rig, ox, oy, r); }, o);\n};\n\n// Tare ------------------------------------------------------------------------------------------------------------\n// A white slab with footprints, a small dial, short legs, cyan LED eyes on the front edge and eight faces.\nG.FACES = { neutral: 1, happy: 1, worried: 1, smug: 1, shocked: 1, sad: 1, asleep: 1, judging: 1 };\nG.drawTareAt = (g, cx, by, s = 1, face = 'neutral', sq = 0, wearTie = false, time = 0) => {\n  const W = Math.round(17 * s * (1 + sq * .35)), H = Math.max(3, Math.round(6 * s * (1 - sq * .5))), top = Math.round(4 * s * (1 - sq * .5)), L = Math.max(1, Math.round(2 * s));\n  const yb = by - L; // legs\n  px.rect(g, cx - W + 2, yb, Math.max(2, 2 * s), L, '#9fb3bb'); px.rect(g, cx + W - 2 - Math.max(2, 2 * s), yb, Math.max(2, 2 * s), L, '#9fb3bb');\n  // the top surface, then the front edge\n  px.poly(g, [[cx - W + 2 * s, yb - H - top], [cx + W - 2 * s, yb - H - top], [cx + W, yb - H], [cx - W, yb - H]], '#ffffff');\n  px.rect(g, cx - W, yb - H, W * 2, H, '#e6eff2'); px.rect(g, cx - W, yb - 1, W * 2, 1, '#b9cbd2');\n  // footprints and dial\n  const fy = yb - H - top * .55;\n  px.ell(g, cx - W * .42, fy, 3 * s, 1.2 * s, '#d4e3e8'); px.ell(g, cx + W * .42, fy, 3 * s, 1.2 * s, '#d4e3e8');\n  px.ell(g, cx, fy, 2 * s, 1 * s, '#bcd9e2'); px.rect(g, cx, fy - 1 * s, 1, 1 * s, '#e0553a');\n  // face on the front edge\n  const ey = yb - H * .55, ex = W * .42, C = '#20c8ec', D2 = '#0a7f9a', e = Math.max(1, Math.round(s));\n  const eye = (x, kind) => {\n    if (kind === 'dot') px.rect(g, x - e, ey - e, e * 2, e * 2, C);\n    else if (kind === 'wide') px.rect(g, x - e, ey - e * 2, e * 2, e * 3, C);\n    else if (kind === 'line') px.rect(g, x - e * 2, ey, e * 4, e, C);\n    else if (kind === 'up') { px.rect(g, x - e * 2, ey, e, e, C); px.rect(g, x - e, ey - e, e * 2, e, C); px.rect(g, x + e, ey, e, e, C); }\n    else if (kind === 'down') { px.rect(g, x - e * 2, ey - e, e, e, C); px.rect(g, x - e, ey, e * 2, e, C); px.rect(g, x + e, ey - e, e, e, C); }\n  };\n  const blink = Math.sin(time * 1.3) > .985;\n  const F = { neutral: ['dot', 'dot'], happy: ['up', 'up'], worried: ['down', 'dot'], smug: ['line', 'up'], shocked: ['wide', 'wide'], sad: ['down', 'down'], asleep: ['line', 'line'], judging: ['line', 'dot'] }[face] || ['dot', 'dot'];\n  eye(cx - ex, blink ? 'line' : F[0]); eye(cx + ex, blink ? 'line' : F[1]);\n  if (face === 'happy') px.rect(g, cx - e * 2, ey + e, e * 4, e, D2);\n  if (face === 'sad' || face === 'worried') px.rect(g, cx - e, ey + e, e * 2, e, D2);\n  if (face === 'shocked') px.rect(g, cx - e, ey, e * 2, e * 2, D2);\n  if (wearTie) { const ty = yb - H - top * .1; px.poly(g, [[cx, ty], [cx - 3 * s, ty - 1.6 * s], [cx - 3 * s, ty + 1.6 * s]], '#e0553a'); px.poly(g, [[cx, ty], [cx + 3 * s, ty - 1.6 * s], [cx + 3 * s, ty + 1.6 * s]], '#e0553a'); }\n};\nG.tarePortrait = (face = 'neutral') => (g, x, y, size) => { px.rect(g, x, y, size, size, '#d8f3fb'); G.drawTareAt(g, x + size / 2, y + size - 8, size / 24, G.talkFace || face, 0, false, G.game.real); };\nG.Tare = class {\n  constructor(x, y, o = {}) { this.x = x; this.y = y; this.z = 0; this.vz = 0; this.sq = 0; this.sv = 0; this.face = o.face || 'neutral'; this.s = o.s || 1; this.hopT = 1 + Math.random(); this.onGround = true; this.auto = o.auto !== false; }\n  hop(v = 70) { if (this.z <= 0) { this.vz = v; this.sv = -5; G.sfx('tareHop', { vol: .25 }); } }\n  update(dt) {\n    if (this.auto) { this.hopT -= dt; if (this.hopT <= 0) { this.hopT = 1.2 + Math.random() * 2; this.hop(); } }\n    this.vz -= 300 * dt; this.z += this.vz * dt; if (this.z <= 0) { if (this.vz < -30) this.sv = 6; this.z = 0; this.vz = 0; }\n    this.sv += (-this.sq * 90 - this.sv * 10) * dt; this.sq += this.sv * dt;\n  }\n  draw(r, o = {}) {\n    r.shadow(this.x, this.y, 14 * this.s, .3);\n    r.queue(this.x, this.y, this.z, g => { const p = r.w(this.x, this.y, this.z); G.drawTareAt(g, p[0], p[1], this.s, this.face, this.sq, G.state && G.state.minutes >= 20, G.game.real); }, o);\n  }\n};\n\n// Gerald: a ceramic hippo with a coin slot. He swallows minutes. Sometimes he has a friend.\nG.drawGeraldAt = (g, x, y, s = 1, friend = false, gulp = 0) => {\n  const c = '#9fb8d0', d = '#7d97b4', l = '#c3d6e6', W = 14 * s, H = 9 * s + gulp * s;\n  const one = (x, y, s, W, H) => {\n    px.ell(g, x, y - H, W, H, c); px.ell(g, x - W * .3, y - H * 1.35, W * .45, H * .45, l);\n    px.ell(g, x + W * .85, y - H * .9, W * .55, H * .72, c); px.ell(g, x + W * 1.05, y - H * .68, W * .36, H * .38, l);\n    px.rect(g, x + W * .95, y - H * .72, 1, 1, d); px.rect(g, x + W * 1.2, y - H * .72, 1, 1, d);\n    px.disc(g, x + W * .75, y - H * 1.45, Math.max(1, 1.6 * s), '#ffffff'); px.rect(g, x + W * .75, y - H * 1.45, 1, 1, '#20404c');\n    px.disc(g, x + W * .55, y - H * 1.65, Math.max(1, 1.6 * s), d);\n    for (const lx of [-W * .7, -W * .25, W * .25, W * .6]) px.rect(g, x + lx, y - 3 * s, 4 * s, 3 * s, d);\n    px.rect(g, x - W * .3, y - H * 2 + 1, 6 * s, Math.max(1, s), '#20404c');\n  };\n  one(x, y, s, W, H);\n  if (friend) one(x - W * 1.6, y, s * .55, W * .55, H * .55);\n};\n\n// Regulars' walking helper for the island and backgrounds\nG.Blobs = { gull: () => new E.Blob({ R: 3, wings: true, colors: { dk: '#b9c7cf', base: '#f4f7f8', lt: '#ffffff', spec: '#ffffff', eye: '#20303a', pupil: '#20303a' } }), pigeon: () => new E.Blob({ R: 3, wings: true, feet: true, colors: { dk: '#68727f', base: '#8e99a8', lt: '#b6bfcb', spec: '#ffffff', eye: '#d0602a', pupil: '#20303a' } }) };\nEOF\nsed -i \"s/^  \\/\\/ the rope: walking with the arms held out, driven by the rig's own walk under this\\n//\" game/rigs.js\npython3 - <<'EOF'\nimport re\np='game/rigs.js';s=open(p).read()\ns=s.replace(\"  // the rope: walking with the arms held out, driven by the rig's own walk under this\\n  armsOut: t => rig => null\\n\",\"\")\ns=s.replace(\"  stepUp: (k, zb = 5) =>\",\"  stepUp: (k, zb = 5) =>\")\ns=s.replace(\"\"\"E.Humanoid.hat('sunhat', w => { /* drawn with the rig's hat helpers; see G.drawAccessories for its brim */ });\\n\"\"\",\"\")\nopen(p,'w').write(s)\nEOF","description":"Write core, balance model and rigs"}}}
