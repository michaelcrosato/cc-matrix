{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjFqzAegzwYRhkancVh4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RWbW56cGFUwYPiJyx4CwFH","name":"Bash","input":{"command":"rm tests/t2.mjs\ncat > tests/run.mjs <<'EOF'\n// The one test command: node tests/run.mjs [rules|browser|hub|all]. Prints only failures and one final line.\nimport { load, playAct } from './lib.mjs';\nimport { readFileSync, readdirSync, statSync } from 'node:fs';\nlet pass = 0, fail = 0; const ok = (c, m) => { if (c) pass++; else { fail++; console.log('FAIL ' + m); } };\nconst want = process.argv[2] || 'all';\nconst errs = (env, where) => { ok(!env.game.errors.length && !env.errs.length, where + ' errors: ' + env.game.errors.map(e => e.where + ': ' + e.message).slice(0, 3).join(' | ') + ' ' + env.errs.slice(0, 2).join(' | ')); };\n\n// A scripted player. pol: 'bot name' or null (passive). It uses real taps, teleporting only to walk on the island.\nfunction playthrough(env, skill) {\n  const { G, game } = env; G.silent = false; game.go('title', undefined, { fade: 0 }); game.advance(.1);\n  const seen = {}, log = { scenes: seen, ages: {}, unlockedSeen: 0, days: [] }; let steps = 0; const I = game.input;\n  const pump = n => { for (let i = 0; i < n; i++) { game.advance(.1); } };\n  G.TOOLS.bot = skill;\n  while (steps++ < 40000) {\n    const sc = game.sceneName, S = game.scene; seen[sc] = true; const st = G.state;\n    if (sc === 'title') { const it = S.pills.items.findIndex(x => x.label === 'New Member'); S.pills.i = it; I.tap('confirm'); pump(1); continue; }\n    if (sc === 'member') { if (S.mode === 'new') { S.pills.i = 5; I.tap('confirm'); pump(1); } else { I.tap('confirm'); pump(1); } continue; }\n    if (sc === 'island') { if (st.finished) break; if (G.talk.open) { I.tap('confirm'); pump(1); continue; } if (st.flags.recal === undefined && st.day === 4) {}\n      log.ages[st.day] = st.age; if (!log.days.includes(st.day)) log.days.push(st.day);\n      if (G.sessionsLeft(st) > 0) { const un = G.MATS.filter(m => G.isUnlocked(st, m.id) && !st.played[m.id]); const m = un[0] || G.MATS.filter(m => G.isUnlocked(st, m.id))[0]; const x = m.c[0] * 16 + 8, y = m.c[1] * 16 + 8; S.hero.x = x; S.hero.y = y; game.advance(.05); I.tap('interact'); pump(2); continue; }\n      S.hero.x = S.bed[0]; S.hero.y = S.bed[1]; game.advance(.05); I.tap('interact'); pump(3); continue; }\n    I.tap('confirm'); pump(1);\n    if (sc.startsWith('act_') && S.phase === 'play') { S.ctx.local.bot = skill; if (skill && !S.ctx.local.lean) { S.ctx.local.lean = new (G.LeanBot)(skill, env.E.rng(3)); G.Dev.applyBot && 0; } game.advance(1); }\n    if (sc === 'ending' && S.step === 1) { pump(3); }\n  }\n  G.TOOLS.bot = null; log.steps = steps; return log;\n}\nfunction rules() {\n  // Lean bands\n  { const env = load(), { G, E } = env, TBL = { body: [50, 76, 99, 100], flow: [53, 78, 99, 100], stork1: [20, 30, 68, 95], stork2: [22, 15, 29, 54], candle: [14, 59, 95, 100], rope: [35, 31, 39, 79] };\n    for (const set in TBL) { ['pass', 'poor', 'average', 'good'].forEach((sk, si) => { let sum = 0; for (let s = 1; s <= 12; s++) { const b = new G.Balance(G.SETS[set], E.rng(s * 101), { noGentle: true }), bot = sk === 'pass' ? null : new G.LeanBot(sk, E.rng(s * 7)); for (let i = 0; i < 45 * 120; i++) { const u = bot ? bot.step(1 / 120, b.px, b.py, b.vx, b.vy) : [0, 0]; b.step(1 / 120, u[0], u[1]); } sum += b.steadiness * 100; } const m = sum / 12; ok(Math.abs(m - TBL[set][si]) <= 15, 'lean band ' + set + ' ' + sk + ' ' + m.toFixed(0) + ' vs ' + TBL[set][si]); }); } }\n  // Every activity, every tier\n  { const env = load({ draw: false }), { G } = env; for (const id of G.actOrder) for (const tier of [0, 1]) { const d = G.acts[id], s1 = d.stars[0], s2 = d.stars[1]; const avg = sk => { let a = 0; for (let s = 1; s <= 3; s++) { const r = playAct(env, id, tier, sk, s * 31); a += r.pct; ok(r.ctx.done, id + ' ' + tier + ' ' + sk + ' finished in time'); } return a / 3; };\n      const p = avg(null); ok(p < s1, id + ' t' + tier + ' passive under 1 star: ' + p.toFixed(2));\n      if (tier === 0) { const a = avg('average'), g = avg('good'); ok(a >= s1, id + ' average 1 star: ' + a.toFixed(2)); ok(g >= s2, id + ' good 2 stars: ' + g.toFixed(2)); }\n      else { const g = avg('good'), x = avg('expert'); ok(g >= s1, id + ' t2 good 1 star: ' + g.toFixed(2)); ok(x >= s2, id + ' t2 expert 2 stars: ' + x.toFixed(2)); } } errs(env, 'activities'); }\n  // Full playthrough, drawn\n  { const env = load({ draw: true }), { G, game } = env, L = playthrough(env, 'good'), st = G.state; ok(st && st.finished, 'good playthrough reaches the ending, at ' + game.sceneName + ' day ' + (st && st.day)); ok(G.actOrder.every(i => st.played[i]), 'all 12 played: missing ' + G.actOrder.filter(i => !st.played[i])); for (const s of ['title', 'member', 'arrival', 'bodycheck', 'island', 'evening', 'recal', 'games', 'ending']) ok(L.scenes[s], 'scene visited ' + s);\n    ok(st.ages[2] === st.ages[1], 'Day 3 plateau holds: ' + st.ages.join(',')); ok(st.ages[3] < st.ages[2], 'Day 4 catches up: ' + st.ages.join(',')); ok(st.age < 71, 'Spine Age falls: ' + st.age); ok(st.minutes >= 30, 'all unlocks arrive: ' + st.minutes); ok(G.unlockedItems(st).length === 6, 'six unlocks'); ok(st.day >= 5, 'day 5 reached'); errs(env, 'playthrough'); \n    ok(G.tier2Open(st, 'stork') || G.bestStars(st, 'stork') < 2, 'tier 2 opens'); game.go('freeplay', undefined, { fade: 0 }); game.advance(.1); ok(game.sceneName === 'freeplay', 'Free Play opens'); }\n  { const env = load({ draw: false }), { G } = env, L = playthrough(env, null); ok(G.state && G.state.finished, 'passive playthrough reaches the ending: at ' + env.game.sceneName + ' day ' + (G.state && G.state.day)); ok(G.state.age === 71 || G.state.age >= 60, 'passive age stays high: ' + G.state.age); errs(env, 'passive'); }\n  // Saves\n  { const env = load(), { G, game, E } = env; const a = G.state = G.newMember('A', { hair: 'short', skin: 0, top: 0, bottom: 0 }); G.slot = 0; a.minutes = 7; G.save(); const b = G.state = G.newMember('B', { hair: 'bald', skin: 1, top: 1, bottom: 1 }); G.slot = 1; b.minutes = 9; G.save(); const c = G.state = G.newMember('C', { hair: 'long', skin: 2, top: 2, bottom: 2 }); G.slot = 2; c.day = 4; G.save(); G.state = null; G.loadMember(1); ok(G.state.name === 'B' && G.state.minutes === 9, 'save reload'); G.loadMember(0); ok(G.state.name === 'A', 'members separate'); ok(G.members().every(Boolean), 'three members'); E.store.set && 0; let threw = false; try { const k = Object.keys(E.store._mem || {}); G.members(); game.saves.get(9); } catch (e) { threw = true; } ok(!threw, 'damaged save no crash'); G.ensureMember(); }\n  // Same seed, same input\n  { const hash = () => { const env = load(); const r = playAct(env, 'stork', 0, 'good', 77); return r.ctx.local.bal.px.toFixed(9) + r.pct; }; ok(hash() === hash(), 'same seed same result'); const h2 = () => { const env = load(), r = playAct(env, 'tray', 0, 'good', 5); return r.ctx.world.hash() + ':' + r.pct; }; ok(h2() === h2(), 'tray same'); }\n  // Attract\n  { const env = load({ draw: true }), { G, game } = env; const k = G.state; game.go('title', undefined, { fade: 0 }); game.advance(9.9); ok(!G.Attract.on, 'attract not at 9.9'); game.advance(.3); ok(G.Attract.on, 'attract at 10'); const before = JSON.stringify(game.saves.list()); const vis = new Set(); for (let t = 0; t < 300 && vis.size < 17; t += 1) { game.advance(1); vis.add(G.Attract.i); ok(true, ''); } ok(vis.size >= 17, 'visits playlist: ' + vis.size); ok(G.Attract.on, 'still looping'); game.input.tap('confirm'); game.advance(.1); ok(!G.Attract.on, 'input exits'); game.advance(.4); ok(game.sceneName === 'title', 'back at title: ' + game.sceneName); ok(JSON.stringify(game.saves.list()) === before, 'attract changes no save'); ok(G.state === k, 'attract restores state'); errs(env, 'attract'); }\n  // Dev\n  { const env = load({ draw: true }), { G, game } = env; G.ensureMember(); game.go('act_stork', { mode: 'free' }, { fade: 0 }); game.advance(.1); G.Dev.open(); ok(G.Dev.isOpen, 'dev opens'); for (const row of G.Dev.rows) if (row.k) { const v = G.DEV[row.k]; G.Dev.adjust(row, 1); if (v === row.max) G.Dev.adjust(row, -1); ok(G.DEV[row.k] !== G.DEV_DEFAULTS[row.k] || v !== G.DEV_DEFAULTS[row.k], 'slider ' + row.k); } const rs = G.Dev.rows.find(r => r.label === 'Reset to defaults'); rs.act(); ok(JSON.stringify(G.DEV) === JSON.stringify(G.DEV_DEFAULTS), 'reset restores'); const n = 40; const J = G.Dev.rows.find(r => r.label === 'Jump'); for (let i = 0; i < 60; i++) { J.act(); game.advance(.05); if (game.sceneName === 'title') { G.ensureMember(); } J.adj(1); if (game.errors.length) break; } ok(!game.errors.length, 'every jump loads: ' + game.errors.map(e => e.scene + ' ' + e.message).slice(0, 2)); G.Dev.close(); game.go('act_stork', { mode: 'free' }, { fade: 0 }); game.advance(.1); const S = game.scene; S.phase = 'play'; G.Dev.open(); G.Dev.star = 2; G.Dev.finishNow(); ok(S.phase === 'results' && S.ctx.local.stars === 2, 'finish now'); G.Dev.openPose(); game.advance(.1); G.Dev.close(); errs(env, 'dev'); }\n  // Class\n  { const env = load({ draw: true }), { G, game } = env; game.go('classroom', undefined, { fade: 0 }); game.advance(.1); game.addPlayer({ pad: 1 }); game.addPlayer({ pad: 2 }); game.addPlayer({ pad: 3 }); ok(game.players.length === 4, '4 players'); game.advance(.1); game.scene.pills.i = 1; game.input.tap('confirm'); game.advance(.2); ok(game.sceneName === 'act_stork', 'class starts: ' + game.sceneName); const ctx = game.scene.ctx; ok(ctx.contestants.length === 4 && ctx.limit === 35, '4 contestants'); for (let i = 0; i < 80 && game.sceneName === 'act_stork'; i++) game.advance(.5); ok(game.sceneName === 'roundscores', 'scores: ' + game.sceneName); game.input.tap('confirm'); game.advance(.2); ok(game.sceneName === 'podium', 'podium: ' + game.sceneName); for (let i = 0; i < 40 && !game.scene.pills; i++) { game.input.tap('confirm'); game.advance(.1); } ok(game.scene.pills && game.scene.order.length === 4, 'podium titles'); for (const id of ['candle', 'squat', 'step', 'hoop']) { G.classRun = { list: [id], i: 0, totals: [0, 0, 0, 0] }; G.classNext(); game.advance(.1); for (let i = 0; i < 90 && game.sceneName.startsWith('act_'); i++) game.advance(.5); ok(game.sceneName === 'roundscores', 'class ' + id + ' ends: ' + game.sceneName); } errs(env, 'class'); }\n  // Hub logic with a fake AIHub\n  { const mk = () => { let time = -Infinity; const h = { active: true, sent: [], results: [], progressN: 0, handlers: {}, connect: async () => ({ me: 0, players: [{ id: 0, name: 'A', color: '#e8443a' }, { id: 1, name: 'B', color: '#3b82f6' }], limitMs: 200000, seed: 3 }), ready() { h.isReady = true; }, answer(a) { h.ans = a; }, time: () => time, on(ev, f) { h.handlers[ev] = f; return () => {}; }, send(d) { h.sent.push(d); return true; }, progress() { h.progressN++; }, result(r) { h.results.push(r); }, rng: l => { let x = 7; for (const c of l) x = x * 31 + c.charCodeAt(0); let s = x; return () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; }; }, setT(v) { time = v; } }; return h; };\n    const run = async () => { const hub = mk(), env = load({ draw: true, AIHub: hub }), { G, game } = env; await new Promise(r => setTimeout(r, 5)); ok(hub.isReady, 'hub ready without key press'); ok(game.sceneName === 'round', 'opens into round'); game.input.tap('confirm'); game.advance(.05); ok(hub.ans === 'ready', 'card confirm answers ready'); hub.setT(-2000); game.advance(.05); let t = 0; const seen = []; while (t < 152000) { t += 250; hub.setT(t); game.advance(.25); if (!seen.includes(game.sceneName)) seen.push(game.sceneName); if (t === 10000) hub.handlers.message({ t: 'g', a: 0, l: [.1, .1], p: 0, s: 100 }, 1); } ok(seen.length >= 3, 'three events: ' + seen); ok(hub.results.length === 1, 'reports once: ' + hub.results.length); ok(hub.sent.length > 20, 'ghost data sent: ' + hub.sent.length); ok(hub.progressN > 10, 'progress'); hub.handlers['time-up']({ graceMs: 1000 }); ok(hub.results.length === 1, 'time-up reports once'); hub.handlers.end({ reason: 'finished' }); ok(G.Round.over, 'end stops'); errs(env, 'hub logic ' + seen); return G.Round.deal.join(); };\n    return Promise.all([run(), run()]).then(([a, b]) => { ok(a === b, 'same seed same deal'); lint(); }); }\n}\nfunction lint() {\n  const env = load(), { G, E } = env, L = G.LINES; for (const [k, d] of Object.entries(G.ACTDATA)) { ok(G.acts[k], 'activity ' + k); for (const T of d.tiers) { if (T.set) ok(G.SETS[T.set], 'set ' + T.set); if (T.poses) for (const p of T.poses) ok(G.POSES[p], 'pose ' + p); if (T.chart) ok(G.CHARTS[T.chart], 'chart ' + T.chart); if (T.song) ok(G.SONGS[T.song], 'song ' + T.song); if (T.course) ok(G.COURSES[T.course], 'course ' + T.course); if (T.trays) for (const i of T.trays) ok(G.TRAYS[i], 'tray ' + i); } }\n  for (const c of G.CLIPS) ok(G.lib.clip(c), 'clip ' + c); for (const p of Object.values(G.POSES)) ok(G.lib.clip(p.clip), 'pose clip ' + p.clip); for (const d of G.DAYS) for (const u of d.unlocks) ok(G.acts[u], 'day unlock ' + u); for (const u of G.UNLOCKS) ok(L.unlock[u.id], 'unlock line ' + u.id); for (const m of G.MATS) { ok(G.acts[m.id], 'mat ' + m.id); ok(G.ISLAND_ROWS[m.c[1]][m.c[0]] !== '~' && G.ISLAND_ROWS[m.c[1]][m.c[0]] !== 'R', 'mat on land ' + m.id); } for (const n of G.NPCS) ok(G.CAST[n.id] && G.CAST_LINES[n.id], 'cast ' + n.id);\n  let count = 0; const countL = v => { if (typeof v === 'string') count++; else if (Array.isArray(v)) v.forEach(countL); else if (v && typeof v === 'object') Object.values(v).forEach(countL); }; countL(L); countL(G.CAST_LINES); ok(count >= 150, 'at least 150 lines: ' + count);\n  const walk = d => readdirSync(d).flatMap(f => { const p = d + '/' + f; return statSync(p).isDirectory() ? walk(p) : [p]; }); for (const f of walk(new URL('../game', import.meta.url).pathname)) { const s = readFileSync(f, 'utf8'); ok(!/\\bTODO\\b|FIXME|placeholder|lorem/i.test(s), 'no stubs in ' + f); }\n  const wii = walk(new URL('../game', import.meta.url).pathname).filter(f => /\\bWii\\b|Mii\\b|Balance Board/.test(readFileSync(f, 'utf8'))); ok(!wii.length, 'no source names in game text: ' + wii);\n}\nconst done = () => { console.log(`${pass} passed, ${fail} failed`); process.exit(fail ? 1 : 0); };\n(async () => { if (want === 'rules' || want === 'all') await rules(); if (want === 'browser' || want === 'all') { const m = await import('./browser.mjs'); await m.run(ok); } if (want === 'hub' || want === 'all') { const m = await import('./hub.mjs'); await m.run(ok); } done(); })().catch(e => { console.log('FAIL crash ' + (e.stack || e)); fail++; done(); });\nEOF\ntime timeout 500 node tests/run.mjs rules 2>&1 | cut -c1-240 | tail -40","description":"Write the one test command and run the rules group","timeout":520000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3149,"cache_read_input_tokens":350827,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3149},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6a88ba50-da75-48c3-bde0-396ebfab72e9","uuid":"8062ecc8-a3b1-408e-9fe5-4196c6222f57","timestamp":"2026-11-05T05:50:26.099Z","request_id":"req_011CgjFqyvWWtJA4wjz5x97o","wire_tool_inputs":{"toolu_01RWbW56cGFUwYPiJyx4CwFH":{"command":"rm tests/t2.mjs\ncat > tests/run.mjs <<'EOF'\n// The one test command: node tests/run.mjs [rules|browser|hub|all]. Prints only failures and one final line.\nimport { load, playAct } from './lib.mjs';\nimport { readFileSync, readdirSync, statSync } from 'node:fs';\nlet pass = 0, fail = 0; const ok = (c, m) => { if (c) pass++; else { fail++; console.log('FAIL ' + m); } };\nconst want = process.argv[2] || 'all';\nconst errs = (env, where) => { ok(!env.game.errors.length && !env.errs.length, where + ' errors: ' + env.game.errors.map(e => e.where + ': ' + e.message).slice(0, 3).join(' | ') + ' ' + env.errs.slice(0, 2).join(' | ')); };\n\n// A scripted player. pol: 'bot name' or null (passive). It uses real taps, teleporting only to walk on the island.\nfunction playthrough(env, skill) {\n  const { G, game } = env; G.silent = false; game.go('title', undefined, { fade: 0 }); game.advance(.1);\n  const seen = {}, log = { scenes: seen, ages: {}, unlockedSeen: 0, days: [] }; let steps = 0; const I = game.input;\n  const pump = n => { for (let i = 0; i < n; i++) { game.advance(.1); } };\n  G.TOOLS.bot = skill;\n  while (steps++ < 40000) {\n    const sc = game.sceneName, S = game.scene; seen[sc] = true; const st = G.state;\n    if (sc === 'title') { const it = S.pills.items.findIndex(x => x.label === 'New Member'); S.pills.i = it; I.tap('confirm'); pump(1); continue; }\n    if (sc === 'member') { if (S.mode === 'new') { S.pills.i = 5; I.tap('confirm'); pump(1); } else { I.tap('confirm'); pump(1); } continue; }\n    if (sc === 'island') { if (st.finished) break; if (G.talk.open) { I.tap('confirm'); pump(1); continue; } if (st.flags.recal === undefined && st.day === 4) {}\n      log.ages[st.day] = st.age; if (!log.days.includes(st.day)) log.days.push(st.day);\n      if (G.sessionsLeft(st) > 0) { const un = G.MATS.filter(m => G.isUnlocked(st, m.id) && !st.played[m.id]); const m = un[0] || G.MATS.filter(m => G.isUnlocked(st, m.id))[0]; const x = m.c[0] * 16 + 8, y = m.c[1] * 16 + 8; S.hero.x = x; S.hero.y = y; game.advance(.05); I.tap('interact'); pump(2); continue; }\n      S.hero.x = S.bed[0]; S.hero.y = S.bed[1]; game.advance(.05); I.tap('interact'); pump(3); continue; }\n    I.tap('confirm'); pump(1);\n    if (sc.startsWith('act_') && S.phase === 'play') { S.ctx.local.bot = skill; if (skill && !S.ctx.local.lean) { S.ctx.local.lean = new (G.LeanBot)(skill, env.E.rng(3)); G.Dev.applyBot && 0; } game.advance(1); }\n    if (sc === 'ending' && S.step === 1) { pump(3); }\n  }\n  G.TOOLS.bot = null; log.steps = steps; return log;\n}\nfunction rules() {\n  // Lean bands\n  { const env = load(), { G, E } = env, TBL = { body: [50, 76, 99, 100], flow: [53, 78, 99, 100], stork1: [20, 30, 68, 95], stork2: [22, 15, 29, 54], candle: [14, 59, 95, 100], rope: [35, 31, 39, 79] };\n    for (const set in TBL) { ['pass', 'poor', 'average', 'good'].forEach((sk, si) => { let sum = 0; for (let s = 1; s <= 12; s++) { const b = new G.Balance(G.SETS[set], E.rng(s * 101), { noGentle: true }), bot = sk === 'pass' ? null : new G.LeanBot(sk, E.rng(s * 7)); for (let i = 0; i < 45 * 120; i++) { const u = bot ? bot.step(1 / 120, b.px, b.py, b.vx, b.vy) : [0, 0]; b.step(1 / 120, u[0], u[1]); } sum += b.steadiness * 100; } const m = sum / 12; ok(Math.abs(m - TBL[set][si]) <= 15, 'lean band ' + set + ' ' + sk + ' ' + m.toFixed(0) + ' vs ' + TBL[set][si]); }); } }\n  // Every activity, every tier\n  { const env = load({ draw: false }), { G } = env; for (const id of G.actOrder) for (const tier of [0, 1]) { const d = G.acts[id], s1 = d.stars[0], s2 = d.stars[1]; const avg = sk => { let a = 0; for (let s = 1; s <= 3; s++) { const r = playAct(env, id, tier, sk, s * 31); a += r.pct; ok(r.ctx.done, id + ' ' + tier + ' ' + sk + ' finished in time'); } return a / 3; };\n      const p = avg(null); ok(p < s1, id + ' t' + tier + ' passive under 1 star: ' + p.toFixed(2));\n      if (tier === 0) { const a = avg('average'), g = avg('good'); ok(a >= s1, id + ' average 1 star: ' + a.toFixed(2)); ok(g >= s2, id + ' good 2 stars: ' + g.toFixed(2)); }\n      else { const g = avg('good'), x = avg('expert'); ok(g >= s1, id + ' t2 good 1 star: ' + g.toFixed(2)); ok(x >= s2, id + ' t2 expert 2 stars: ' + x.toFixed(2)); } } errs(env, 'activities'); }\n  // Full playthrough, drawn\n  { const env = load({ draw: true }), { G, game } = env, L = playthrough(env, 'good'), st = G.state; ok(st && st.finished, 'good playthrough reaches the ending, at ' + game.sceneName + ' day ' + (st && st.day)); ok(G.actOrder.every(i => st.played[i]), 'all 12 played: missing ' + G.actOrder.filter(i => !st.played[i])); for (const s of ['title', 'member', 'arrival', 'bodycheck', 'island', 'evening', 'recal', 'games', 'ending']) ok(L.scenes[s], 'scene visited ' + s);\n    ok(st.ages[2] === st.ages[1], 'Day 3 plateau holds: ' + st.ages.join(',')); ok(st.ages[3] < st.ages[2], 'Day 4 catches up: ' + st.ages.join(',')); ok(st.age < 71, 'Spine Age falls: ' + st.age); ok(st.minutes >= 30, 'all unlocks arrive: ' + st.minutes); ok(G.unlockedItems(st).length === 6, 'six unlocks'); ok(st.day >= 5, 'day 5 reached'); errs(env, 'playthrough'); \n    ok(G.tier2Open(st, 'stork') || G.bestStars(st, 'stork') < 2, 'tier 2 opens'); game.go('freeplay', undefined, { fade: 0 }); game.advance(.1); ok(game.sceneName === 'freeplay', 'Free Play opens'); }\n  { const env = load({ draw: false }), { G } = env, L = playthrough(env, null); ok(G.state && G.state.finished, 'passive playthrough reaches the ending: at ' + env.game.sceneName + ' day ' + (G.state && G.state.day)); ok(G.state.age === 71 || G.state.age >= 60, 'passive age stays high: ' + G.state.age); errs(env, 'passive'); }\n  // Saves\n  { const env = load(), { G, game, E } = env; const a = G.state = G.newMember('A', { hair: 'short', skin: 0, top: 0, bottom: 0 }); G.slot = 0; a.minutes = 7; G.save(); const b = G.state = G.newMember('B', { hair: 'bald', skin: 1, top: 1, bottom: 1 }); G.slot = 1; b.minutes = 9; G.save(); const c = G.state = G.newMember('C', { hair: 'long', skin: 2, top: 2, bottom: 2 }); G.slot = 2; c.day = 4; G.save(); G.state = null; G.loadMember(1); ok(G.state.name === 'B' && G.state.minutes === 9, 'save reload'); G.loadMember(0); ok(G.state.name === 'A', 'members separate'); ok(G.members().every(Boolean), 'three members'); E.store.set && 0; let threw = false; try { const k = Object.keys(E.store._mem || {}); G.members(); game.saves.get(9); } catch (e) { threw = true; } ok(!threw, 'damaged save no crash'); G.ensureMember(); }\n  // Same seed, same input\n  { const hash = () => { const env = load(); const r = playAct(env, 'stork', 0, 'good', 77); return r.ctx.local.bal.px.toFixed(9) + r.pct; }; ok(hash() === hash(), 'same seed same result'); const h2 = () => { const env = load(), r = playAct(env, 'tray', 0, 'good', 5); return r.ctx.world.hash() + ':' + r.pct; }; ok(h2() === h2(), 'tray same'); }\n  // Attract\n  { const env = load({ draw: true }), { G, game } = env; const k = G.state; game.go('title', undefined, { fade: 0 }); game.advance(9.9); ok(!G.Attract.on, 'attract not at 9.9'); game.advance(.3); ok(G.Attract.on, 'attract at 10'); const before = JSON.stringify(game.saves.list()); const vis = new Set(); for (let t = 0; t < 300 && vis.size < 17; t += 1) { game.advance(1); vis.add(G.Attract.i); ok(true, ''); } ok(vis.size >= 17, 'visits playlist: ' + vis.size); ok(G.Attract.on, 'still looping'); game.input.tap('confirm'); game.advance(.1); ok(!G.Attract.on, 'input exits'); game.advance(.4); ok(game.sceneName === 'title', 'back at title: ' + game.sceneName); ok(JSON.stringify(game.saves.list()) === before, 'attract changes no save'); ok(G.state === k, 'attract restores state'); errs(env, 'attract'); }\n  // Dev\n  { const env = load({ draw: true }), { G, game } = env; G.ensureMember(); game.go('act_stork', { mode: 'free' }, { fade: 0 }); game.advance(.1); G.Dev.open(); ok(G.Dev.isOpen, 'dev opens'); for (const row of G.Dev.rows) if (row.k) { const v = G.DEV[row.k]; G.Dev.adjust(row, 1); if (v === row.max) G.Dev.adjust(row, -1); ok(G.DEV[row.k] !== G.DEV_DEFAULTS[row.k] || v !== G.DEV_DEFAULTS[row.k], 'slider ' + row.k); } const rs = G.Dev.rows.find(r => r.label === 'Reset to defaults'); rs.act(); ok(JSON.stringify(G.DEV) === JSON.stringify(G.DEV_DEFAULTS), 'reset restores'); const n = 40; const J = G.Dev.rows.find(r => r.label === 'Jump'); for (let i = 0; i < 60; i++) { J.act(); game.advance(.05); if (game.sceneName === 'title') { G.ensureMember(); } J.adj(1); if (game.errors.length) break; } ok(!game.errors.length, 'every jump loads: ' + game.errors.map(e => e.scene + ' ' + e.message).slice(0, 2)); G.Dev.close(); game.go('act_stork', { mode: 'free' }, { fade: 0 }); game.advance(.1); const S = game.scene; S.phase = 'play'; G.Dev.open(); G.Dev.star = 2; G.Dev.finishNow(); ok(S.phase === 'results' && S.ctx.local.stars === 2, 'finish now'); G.Dev.openPose(); game.advance(.1); G.Dev.close(); errs(env, 'dev'); }\n  // Class\n  { const env = load({ draw: true }), { G, game } = env; game.go('classroom', undefined, { fade: 0 }); game.advance(.1); game.addPlayer({ pad: 1 }); game.addPlayer({ pad: 2 }); game.addPlayer({ pad: 3 }); ok(game.players.length === 4, '4 players'); game.advance(.1); game.scene.pills.i = 1; game.input.tap('confirm'); game.advance(.2); ok(game.sceneName === 'act_stork', 'class starts: ' + game.sceneName); const ctx = game.scene.ctx; ok(ctx.contestants.length === 4 && ctx.limit === 35, '4 contestants'); for (let i = 0; i < 80 && game.sceneName === 'act_stork'; i++) game.advance(.5); ok(game.sceneName === 'roundscores', 'scores: ' + game.sceneName); game.input.tap('confirm'); game.advance(.2); ok(game.sceneName === 'podium', 'podium: ' + game.sceneName); for (let i = 0; i < 40 && !game.scene.pills; i++) { game.input.tap('confirm'); game.advance(.1); } ok(game.scene.pills && game.scene.order.length === 4, 'podium titles'); for (const id of ['candle', 'squat', 'step', 'hoop']) { G.classRun = { list: [id], i: 0, totals: [0, 0, 0, 0] }; G.classNext(); game.advance(.1); for (let i = 0; i < 90 && game.sceneName.startsWith('act_'); i++) game.advance(.5); ok(game.sceneName === 'roundscores', 'class ' + id + ' ends: ' + game.sceneName); } errs(env, 'class'); }\n  // Hub logic with a fake AIHub\n  { const mk = () => { let time = -Infinity; const h = { active: true, sent: [], results: [], progressN: 0, handlers: {}, connect: async () => ({ me: 0, players: [{ id: 0, name: 'A', color: '#e8443a' }, { id: 1, name: 'B', color: '#3b82f6' }], limitMs: 200000, seed: 3 }), ready() { h.isReady = true; }, answer(a) { h.ans = a; }, time: () => time, on(ev, f) { h.handlers[ev] = f; return () => {}; }, send(d) { h.sent.push(d); return true; }, progress() { h.progressN++; }, result(r) { h.results.push(r); }, rng: l => { let x = 7; for (const c of l) x = x * 31 + c.charCodeAt(0); let s = x; return () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; }; }, setT(v) { time = v; } }; return h; };\n    const run = async () => { const hub = mk(), env = load({ draw: true, AIHub: hub }), { G, game } = env; await new Promise(r => setTimeout(r, 5)); ok(hub.isReady, 'hub ready without key press'); ok(game.sceneName === 'round', 'opens into round'); game.input.tap('confirm'); game.advance(.05); ok(hub.ans === 'ready', 'card confirm answers ready'); hub.setT(-2000); game.advance(.05); let t = 0; const seen = []; while (t < 152000) { t += 250; hub.setT(t); game.advance(.25); if (!seen.includes(game.sceneName)) seen.push(game.sceneName); if (t === 10000) hub.handlers.message({ t: 'g', a: 0, l: [.1, .1], p: 0, s: 100 }, 1); } ok(seen.length >= 3, 'three events: ' + seen); ok(hub.results.length === 1, 'reports once: ' + hub.results.length); ok(hub.sent.length > 20, 'ghost data sent: ' + hub.sent.length); ok(hub.progressN > 10, 'progress'); hub.handlers['time-up']({ graceMs: 1000 }); ok(hub.results.length === 1, 'time-up reports once'); hub.handlers.end({ reason: 'finished' }); ok(G.Round.over, 'end stops'); errs(env, 'hub logic ' + seen); return G.Round.deal.join(); };\n    return Promise.all([run(), run()]).then(([a, b]) => { ok(a === b, 'same seed same deal'); lint(); }); }\n}\nfunction lint() {\n  const env = load(), { G, E } = env, L = G.LINES; for (const [k, d] of Object.entries(G.ACTDATA)) { ok(G.acts[k], 'activity ' + k); for (const T of d.tiers) { if (T.set) ok(G.SETS[T.set], 'set ' + T.set); if (T.poses) for (const p of T.poses) ok(G.POSES[p], 'pose ' + p); if (T.chart) ok(G.CHARTS[T.chart], 'chart ' + T.chart); if (T.song) ok(G.SONGS[T.song], 'song ' + T.song); if (T.course) ok(G.COURSES[T.course], 'course ' + T.course); if (T.trays) for (const i of T.trays) ok(G.TRAYS[i], 'tray ' + i); } }\n  for (const c of G.CLIPS) ok(G.lib.clip(c), 'clip ' + c); for (const p of Object.values(G.POSES)) ok(G.lib.clip(p.clip), 'pose clip ' + p.clip); for (const d of G.DAYS) for (const u of d.unlocks) ok(G.acts[u], 'day unlock ' + u); for (const u of G.UNLOCKS) ok(L.unlock[u.id], 'unlock line ' + u.id); for (const m of G.MATS) { ok(G.acts[m.id], 'mat ' + m.id); ok(G.ISLAND_ROWS[m.c[1]][m.c[0]] !== '~' && G.ISLAND_ROWS[m.c[1]][m.c[0]] !== 'R', 'mat on land ' + m.id); } for (const n of G.NPCS) ok(G.CAST[n.id] && G.CAST_LINES[n.id], 'cast ' + n.id);\n  let count = 0; const countL = v => { if (typeof v === 'string') count++; else if (Array.isArray(v)) v.forEach(countL); else if (v && typeof v === 'object') Object.values(v).forEach(countL); }; countL(L); countL(G.CAST_LINES); ok(count >= 150, 'at least 150 lines: ' + count);\n  const walk = d => readdirSync(d).flatMap(f => { const p = d + '/' + f; return statSync(p).isDirectory() ? walk(p) : [p]; }); for (const f of walk(new URL('../game', import.meta.url).pathname)) { const s = readFileSync(f, 'utf8'); ok(!/\\bTODO\\b|FIXME|placeholder|lorem/i.test(s), 'no stubs in ' + f); }\n  const wii = walk(new URL('../game', import.meta.url).pathname).filter(f => /\\bWii\\b|Mii\\b|Balance Board/.test(readFileSync(f, 'utf8'))); ok(!wii.length, 'no source names in game text: ' + wii);\n}\nconst done = () => { console.log(`${pass} passed, ${fail} failed`); process.exit(fail ? 1 : 0); };\n(async () => { if (want === 'rules' || want === 'all') await rules(); if (want === 'browser' || want === 'all') { const m = await import('./browser.mjs'); await m.run(ok); } if (want === 'hub' || want === 'all') { const m = await import('./hub.mjs'); await m.run(ok); } done(); })().catch(e => { console.log('FAIL crash ' + (e.stack || e)); fail++; done(); });\nEOF\ntime timeout 500 node tests/run.mjs rules 2>&1 | cut -c1-240 | tail -40","description":"Write the one test command and run the rules group","timeout":520000}}}
