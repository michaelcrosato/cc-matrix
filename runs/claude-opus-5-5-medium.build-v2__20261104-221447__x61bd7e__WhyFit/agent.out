ms.push({ label: 'Free Play', disabled: fin === undefined, on: () => { G.loadMember(fin); game.go('freeplay'); } }, { label: 'Settings', on: () => game.menu('settings') }, { label: 'About', on: () => game.go('about') });\n    this.pills = new G.Pills(items, { x: (W, H, mw) => W - mw - 26, y: (W, H, t) => Math.max(66, (H - t) / 2 + 22), w: 96 }); },\n  update(dt) { this.t += dt; G.talk.update(dt); this.tare.update(dt); this.tare.face = Math.sin(this.t * .5) > .6 ? 'smug' : 'happy'; game.focus(0, 0, 18); this.pills.update(dt); },\n  draw(r) { G.ROOMS.studio(r, game.real); G.mat(r, 0, 4, '#bfeee0', 34, 16); this.tare.draw(r); r.shape('whyfit:cactus-medium-a', -110, -30, 0); r.shape('whyfit:pot-large', 112, -30, 0);\n    r.overlay(g => { logo(g, r, r.W * .36, 22, 4); G.text(g, 'A five-day stay. You know why.', r.W * .36, 58, G.COL.INK, { align: 'center', shadow: '#ffffff' }); this.pills.draw(g); });\n    G.talk.draw(r); G.prompt(r, [['confirm', 'Choose']]); } });\nG.resumeMember = () => { const st = G.state; G.lightFor(null); if (!st.instructor) game.go('arrival'); else if (!st.flags.checked) game.go('bodycheck'); else if (st.flags.gamesAt !== undefined && !st.finished) game.go('games', { i: st.flags.gamesAt }); else game.go('island'); };\n\nG.scene('member', { topLevel: true, view: 'brawler', camera: { zoom: false },\n  enter(d) { G.talk.close(); this.mode = 'pick'; this.look = { hair: 'short', skin: 1, top: 0, bottom: 0 }; this.nameI = Math.floor(G.rng() * G.LOOKS.names.length); this.slot = 0; this.buildPick(); if (d && d.mode === 'new') { this.slot = 0; this.buildNew(); } game.focus(0, 0, 18); },\n  buildPick() { this.mode = 'pick'; const ms = this.ms = G.members(); this.rigs = ms.map(s => { if (!s) return null; const q = G.lookToRig(s.data.look, 1.2, {}); q.update(1 / 60, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: Math.PI / 2 }); return q; });\n    this.pills = new G.Pills([0, 1, 2].map(i => ({ label: ms[i] ? ' ' : 'New Member', on: () => { this.slot = i; if (ms[i]) { G.loadMember(i); G.resumeMember(); } else this.buildNew(); } })), { w: Math.min(250, game.W - 40), h: 48, gap: 6, y: (W, H, t) => (H - t) / 2 + 6, onBack: () => game.go('title') }); },\n  rebuildRig() { this.rig = G.lookToRig(this.look, 2.1, {}); },\n  buildNew() { this.mode = 'new'; this.rebuildRig(); const L = G.LOOKS, cy = (k, list, d = 1) => { const i = list.indexOf(this.look[k]), v = list[(i + d + list.length) % list.length]; this.look[k] = v; this.rebuildRig(); this.refresh(); }, cn = (k, n, d = 1) => { this.look[k] = (this.look[k] + d + n) % n; this.rebuildRig(); this.refresh(); };\n    this.rows = [{ k: 'hair', cyc: d => cy('hair', L.hair, d) }, { k: 'skin', cyc: d => cn('skin', L.skins.length, d) }, { k: 'top', cyc: d => cn('top', L.tops.length, d) }, { k: 'bottom', cyc: d => cn('bottom', L.bottoms.length, d) }, { k: 'name', cyc: d => { this.nameI = (this.nameI + d + L.names.length) % L.names.length; this.refresh(); } }, { k: 'done' }];\n    this.pills = new G.Pills(this.rows.map(q => ({ label: '', on: () => { if (q.k === 'done') this.create(); else q.cyc(1); } })), { x: (W) => W * .5, w: 150, y: (W, H, t) => Math.max(28, (H - t) / 2), onBack: () => this.buildPick() }); this.refresh(); },\n  refresh() { const L = G.LOOKS, lab = { hair: 'Hair: ' + L.hairNames[L.hair.indexOf(this.look.hair)], skin: 'Skin: ' + (this.look.skin + 1), top: 'Top: ' + (this.look.top + 1), bottom: 'Bottom: ' + (this.look.bottom + 1), name: L.names[this.nameI] + '  (reroll)', done: 'This is me' }; this.pills.items.forEach((it, i) => { it.label = lab[this.rows[i].k]; }); },\n  create() { G.state = G.newMember(G.LOOKS.names[this.nameI], Object.assign({}, this.look)); G.slot = this.slot; G.save(); game.go('arrival'); },\n  update(dt) { G.talk.update(dt); this.pills.update(dt); const I = game.input; if (this.mode === 'new') { if (this.rig) { this.rig.mocap = G.sampleLoop('Idle_Subtle', game.real); G.place(this.rig, dt, -60, 4, 0, 1.3); } const row = this.rows[this.pills.i]; if (row && row.cyc) { if (I.repeat('left', .35, .16)) row.cyc(-1); if (I.repeat('right', .35, .16)) row.cyc(1); } } else if (this.confirm) { /* handled by the pills it swaps in */ } else if (I.pressed('retry') && this.ms[this.pills.i]) { const i = this.pills.i; this.mode = 'erase'; this.pills = new G.Pills([{ label: 'Keep ' + this.ms[i].data.name, on: () => this.buildPick() }, { label: 'Erase this member', on: () => { game.saves.erase(i); this.buildPick(); } }], { w: 170, onBack: () => this.buildPick() }); } },\n  draw(r) { G.ROOMS.studio(r, game.real); r.overlay(g => { G.text(g, this.mode === 'new' ? 'New Member' : this.mode === 'erase' ? 'Are you sure? Tare will remember.' : 'Member Cards', r.W / 2, 8, G.COL.INK, { align: 'center', scale: this.mode === 'erase' ? 1 : 2, shadow: '#fff' }); });\n    if (this.mode === 'new') { G.mat(r, -60, 8, '#bfeee0', 30, 14); G.actor(r, this.rig); }\n    r.overlay(g => { this.pills.draw(g); if (this.mode === 'pick') this.ms.forEach((s, i) => { if (!s) return; const [x, y, w, h] = this.pills.rect(i); G.drawCard(g, r, x, y, w, h, s.data, i === this.pills.i, { rig: this.rigs[i] }); }); });\n    G.prompt(r, this.mode === 'new' ? [['left', 'Change'], ['confirm', 'Choose'], ['cancel', 'Back']] : this.mode === 'pick' ? [['confirm', 'Choose'], ['retry', 'Erase'], ['cancel', 'Back']] : [['confirm', 'Choose']]); } });\n\nG.scene('arrival', { view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() { this.step = 0; this.t = 0; this.cardR = G.line('arrival'); this.pills = new G.Pills([{ label: 'Open the card', on: () => { this.step = 1; this.pills = null; this.pick(); } }], { y: (W, H, t) => H - t - 28 }); this.birch = G.instructorRig('birch', 2); this.alder = G.instructorRig('alder', 2); this.tare = new G.Tare(0, 26, { s: 1.4 }); G.music('morning'); game.focus(0, 0, 18); },\n  pick() { G.say('tare', [G.LINES.arrivalMotto, G.LINES.instructorPick], { onDone: () => { const say = who => { G.say(who, G.LINES[who].hello, { onDone: () => { G.state.instructor = who; G.save(); game.go('bodycheck'); } }); }; this.pills = new G.Pills([{ label: 'Birch', on: () => { this.pills = null; say('birch'); } }, { label: 'Alder', on: () => { this.pills = null; say('alder'); } }], { dir: 'h', y: (W, H) => H - 46, gap: 40 }); } }); },\n  update(dt) { this.t += dt; this.tare.update(dt); this.birch.mocap = G.sampleLoop('Greeting', this.t * .6); G.place(this.birch, dt, -56, 0, 0, 1.3); this.alder.mocap = G.sampleLoop('Wave_Hello', this.t * .6); G.place(this.alder, dt, 56, 0, 0, 1.8); game.focus(0, 0, 18); if (G.talk.update(dt)) return; if (this.pills) this.pills.update(dt); },\n  draw(r) { G.ROOMS.reception(r, game.real); if (this.step === 1) { G.mat(r, -56, 4, '#ffe2b8'); G.mat(r, 56, 4, '#ffefcf'); G.actor(r, this.birch); G.actor(r, this.alder); this.tare.draw(r); } r.overlay(g => { if (this.step === 0) { const w = Math.min(r.W - 70, 300), x = (r.W - w) >> 1, y = 44; G.panel(g, x, y, w, 90, { c: '#fffdf4' }); G.wrapText(g, this.cardR, x + 14, y + 14, w - 28, G.COL.INK); } if (this.pills) this.pills.draw(g); }); G.talk.draw(r); if (this.pills) G.prompt(r, [['confirm', 'Choose']]); } });\n\n// About: paged, big text, from the exit interview, so the screen, the file and the reply cannot disagree.\nG.scene('about', { topLevel: true, view: 'brawler', camera: { zoom: false },\n  enter() { const A0 = G.ABOUT || {}, si = A0.sourceInformation || {}; const labels = [['date', 'Date'], ['source', 'Source'], ['plan', 'Plan'], ['genre', 'Genre'], ['perspective', 'Perspective'], ['tech', 'Tech'], ['artDirection', 'Art Direction'], ['animation', 'Animation'], ['audio', 'Audio'], ['online', 'Online'], ['testing', 'Testing'], ['research', 'Research'], ['environment', 'Environment'], ['model', 'Model'], ['usage', 'Usage']];\n    const qa = (title, qs, as) => qs.map((q, i) => ({ title, q, a: (as || [])[i] || 'unknown' }));\n    this.src = [...labels.map(([k, l]) => ({ title: 'Source Information', q: l, a: si[k] || 'unknown' })), ...qa('Testing Feedback', ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'], A0.testingFeedback), ...qa('Engine Feedback', ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why?', 'If you could change one thing about the engine, what would it be?'], A0.engineFeedback), ...qa('Prompt Feedback', ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'], A0.promptFeedback),\n      { title: 'Credits', q: 'Engine', a: 'my-3D2dge v' + (E.version || '0.89.0') + ', github.com/michaelcrosato/my-3d2dge' }, { title: 'Credits', q: 'Motion', a: 'Mesh2Motion and Quaternius (CC0). CMU Graphics Lab Motion Capture Database (free for all uses).' }, { title: 'Credits', q: 'Props', a: 'Kenney and KayKit, from the engine asset store (CC0).' }, { title: 'Credits', q: 'Everything else', a: 'Written in code for this game: the music, the sounds, the voices, Tare and Gerald. Gerald has asked for no further credit.' }];\n    this.i = 0; this.layout(); this.pills = new G.Pills([{ label: 'Previous', on: () => { this.i = Math.max(0, this.i - 1); } }, { label: 'Next', on: () => { this.i = Math.min(this.pages.length - 1, this.i + 1); } }, { label: 'Back', on: () => game.go('title') }], { dir: 'h', start: 1, onBack: () => game.go('title'), y: (W, H) => H - 40 }); G.lightFor(null); },\n  layout() { const W = Math.min((game.W || 427) - 60, 340), maxH = (game.H || 240) - 96; this.pages = []; let cur = null, h = 0; for (const e of this.src) { const lines = E.font.wrap(e.a, W - 20).length, eh = 12 + lines * 10 + 6; if (!cur || cur.title !== e.title || h + eh > maxH) { cur = { title: e.title, rows: [] }; this.pages.push(cur); h = 0; } cur.rows.push(e); h += eh; } },\n  update(dt) { this.pills.update(dt); const I = game.input; game.focus(0, 0, 18); },\n  draw(r) { G.ROOMS.studio(r, game.real); const pg = this.pages[this.i]; r.overlay(g => { const w = Math.min(r.W - 60, 340), x = (r.W - w) >> 1, y = 10, h = r.H - 58; G.panel(g, x, y, w, h); G.text(g, pg.title, x + 10, y + 6, G.COL.ACCD); G.text(g, (this.i + 1) + ' of ' + this.pages.length, x + w - 10, y + 6, G.COL.MUT, { align: 'right' }); let yy = y + 20; for (const e of pg.rows) { G.text(g, e.q, x + 10, yy, G.COL.INK); yy += 11; yy += G.wrapText(g, e.a, x + 10, yy, w - 20, G.COL.MUT, { gap: 2 }) + 5; } this.pills.draw(g); }); G.prompt(r, [['confirm', 'Choose']], { y: 6 }); } });\n\n// Free Play: a discipline, then an activity, then the tier on its own Card.\nG.scene('freeplay', { view: 'brawler', camera: { zoom: false }, topLevel: true,\n  enter() { this.showDisc(); G.music('morning'); game.focus(0, 0, 18); },\n  showDisc() { this.head = 'Free Play'; const st = G.state; this.pills = new G.Pills([...G.DISCIPLINES.map(d => ({ label: d, on: () => this.showAct(d) })), { label: 'Back', on: () => this.goBack() }], { w: 130, onBack: () => this.goBack() }); },\n  goBack() { game.go(G.state && G.state.instructor && !G.devFree ? 'title' : 'title'); },\n  showAct(d) { this.head = d; this.pills = new G.Pills([...G.actOrder.filter(i => G.acts[i].discipline === d).map(i => ({ label: G.acts[i].name, on: () => game.go('act_' + i, { mode: 'free', from: 'freeplay' }) })), { label: 'Back', on: () => this.showDisc() }], { w: 170, onBack: () => this.showDisc() }); },\n  update(dt) { this.pills.update(dt); },\n  draw(r) { G.ROOMS.studio(r, game.real); r.overlay(g => { G.text(g, this.head, r.W / 2, 14, G.COL.INK, { align: 'center', scale: 2, shadow: '#fff' }); this.pills.draw(g); }); G.prompt(r, [['confirm', 'Choose'], ['cancel', 'Back']]); } });\nEOF\ncat > game/scenes/bodycheck.js <<'EOF'\n// The morning weigh-in: step on, be still, lean, a Silly Question, ducks, the number that matters. About 50 seconds.\nG.drawAge = (g, r, st, x, y) => { const age = st.age; G.text(g, 'Spine Age', x, y, G.COL.MUT); G.text(g, String(age), x, y + 11, G.COL.CORAL, { scale: 3 });\n  const pts = st.ages.slice(-8), gx = x + 58, gy = y + 8, gw = 92, gh = 26; px.rect(g, gx, gy + gh, gw, 1, '#c8dde2'); pts.forEach((a, i) => { const q = gx + (pts.length > 1 ? i / (pts.length - 1) * (gw - 6) : 0) + 3, v = gy + clamp((a - 19) / 52, 0, 1) * gh; if (i) { const a2 = pts[i - 1], q2 = gx + (i - 1) / (pts.length - 1) * (gw - 6) + 3, v2 = gy + clamp((a2 - 19) / 52, 0, 1) * gh; px.line(g, q2, v2, q, v, G.COL.ACC); } px.disc(g, q, v, 2, G.COL.CORAL); });\n  const fx = x + gw + 86, fy = y + 22; G.DISCIPLINES.forEach((d, i) => { const a = i / 4 * 6.283 - 2.356, v = G.discScore(st, d) / 100, R = 4 + v * 12; px.disc(g, fx + Math.cos(a) * R * .85, fy + Math.sin(a) * R * .85, 3 + v * 6, ['#c79be8', '#ff7a59', '#2cc6e6', '#7bd389'][i]); }); px.disc(g, fx, fy, 3, '#f5c84b'); };\nG.pickSuggestion = st => { const ok = G.actOrder.filter(i => G.isUnlocked(st, i)), fresh = ok.filter(i => !st.played[i]); const list = fresh.length ? fresh : ok; return list.length ? G.pick(list) : null; };\nG.scene('bodycheck', { view: 'brawler', camera: { zoom: false }, pausable: true, topLevel: false,\n  enter(d) { d = d || {}; this.d = d; const st = G.state; this.demo = !!d.demo; this.short = st.day === 5; this.rig = G.memberRig(2); this.tare = new G.Tare(0, 2, { s: 2.2, auto: false }); this.t = 0; this.phase = 'arrive'; this.rig.mocap = null; this.x = -90; this.z = 0; this.onTare = false; const R = E.rng(st.day * 977 + G.slot); this.bal = new G.Balance(G.SETS.body, R, { noFall: true, noGentle: true, stumbleAt: 4 }); this.intent = G.newIntent(); this.ctxS = { def: {}, classMode: false }; this.c = { input: game.input, player1: true, intent: this.intent }; this.bot = new G.LeanBot('good', R); this.steadT = 0; this.leanI = 0; this.holdT = 0; this.score = 0; G.music('studio'); game.focus(0, 0, 18); G.lightFor('morning');\n    G.talk.close(); this.line(st.ages.length ? (Date.now() - st.lastSeen > 2 * 864e5 ? G.fill(G.LINES.absence, { n: Math.floor((Date.now() - st.lastSeen) / 864e5) }) : G.line(G.rng() < .5 ? 'feet' : 'return')) : G.LINES.feet[0]); st.lastSeen = Date.now(); },\n  line(s, o) { if (this.demo) { G.chat('tare', s, 2.2); return; } G.chat('tare', s, (o && o.secs) || 3); },\n  update(dt) { this.t += dt; const st = G.state, I = game.input; G.talk.update(dt); this.tare.update(dt); game.focus(0, 0, 18);\n    const fill = () => { if (this.demo) { const [ux, uy] = this.bot.step(dt, this.bal.px - this.bal.ringX, this.bal.py - this.bal.ringY, this.bal.vx, this.bal.vy); this.intent.ux = ux; this.intent.uy = uy; } else G.fillDevice(this.c, this.ctxS, dt); };\n    const P = this.phase;\n    if (P === 'arrive') { this.x = Math.min(0, this.x + dt * 70); if (this.x >= 0 && !this.onTare) { this.onTare = true; this.tare.sv = -8; G.sfx('boop'); this.z = 12; this.t = 0; this.tare.face = 'happy'; this.phase = 'wait'; } }\n    else if (P === 'wait') { if (this.t > (this.demo ? .6 : 1.4)) { this.phase = 'still'; this.t = 0; this.line(G.line('still')); this.tare.face = 'judging'; } }\n    else if (P === 'still') { fill(); this.bal.step(dt, this.intent.ux, this.intent.uy); if (this.bal.inRing) this.steadT += dt; if (this.t >= 5) { this.score = this.steadT / 5; this.phase = 'lean'; this.t = 0; this.bal.ringX = .5; this.bal.ringY = 0; this.line(G.line('lean')); this.tare.face = 'neutral'; } }\n    else if (P === 'lean') { fill(); this.bal.step(dt, this.intent.ux, this.intent.uy); if (this.bal.inRing) this.holdT += dt; const nd = this.t > 7 || this.holdT >= 1; if (nd) { this.t = 0; this.holdT = 0; this.leanI++; G.sfx('chime', { vol: .25, pitch: 1 + this.leanI * .12 }); const Q = [[0, .5], [-.5, 0], [0, -.5]][this.leanI - 1]; if (Q) { this.bal.ringX = Q[0]; this.bal.ringY = Q[1]; } else this.toQuestion(); } }\n    else if (P === 'question') { if (this.pills) this.pills.update(dt); if (this.demo && this.t > 1.5) this.pills.pick(); }\n    else if (P === 'reading') { if (this.t > 3 || (!this.demo && this.t > .6 && I.pressed('confirm'))) this.toAge(); }\n    else if (P === 'age') { if (this.demo ? this.t > 2.5 : (this.t > 1 && I.pressed('confirm'))) this.toDone(); else if (!this.demo) { const c = I.clicked && I.clicked(); if (c && this.t > 1) this.toDone(); } }\n    const anim = this.rig; if (P === 'still' || P === 'lean') { anim.wob = [this.bal.px, this.bal.py]; anim.mocap = G.sampleLoop('Idle_Subtle', this.t); } else { anim.wob = [0, 0]; anim.mocap = P === 'arrive' ? null : G.sampleLoop('Idle_Subtle', this.t); } G.place(anim, dt, this.x, 2, this.z, P === 'arrive' ? 0 : 1.57, P === 'arrive' ? { vx: 60 } : {}); },\n  toQuestion() { this.phase = 'question'; this.t = 0; const q = this.q = G.line('q'); this.pills = new G.Pills(q.a.map(a => ({ label: a, on: () => { this.line(G.line('questionReply')); this.phase = 'reading'; this.t = 0; this.pills = null; this.ducks = (9 + G.rng() * 4).toFixed(1); this.line(G.fill(G.line('ducks'), { n: this.ducks }), { secs: 3 }); this.tare.face = 'neutral'; } })), { dir: 'h', y: (W, H) => H - 52 }); },\n  toAge() { const st = G.state, prev = st.ages.length ? st.ages[st.ages.length - 1] : null; const shown = G.morningAge(st); st.ages.push(shown); st.age = shown; st.heldAge = shown; this.phase = 'age'; this.t = 0; let s; if (st.day === 3) s = G.LINES.plateau; else if (st.day === 4) s = G.fill(G.LINES.catchup, { n: shown }); else if (prev !== null && shown < prev) s = G.fill(G.line('ageDown'), { n: shown }); else s = G.fill(G.line('ageSame'), { n: shown }); this.line(s, { secs: 4.5 }); this.tare.face = shown < (prev || 72) ? 'happy' : 'neutral'; G.sfx('stamp'); st.suggestion = st.day >= 5 && !st.finished ? null : G.pickSuggestion(st); st.flags.checked = true; G.save(); },\n  toDone() { const st = G.state, sug = st.suggestion; if (this.demo) { G.Attract.next(); return; } const tips = game.settings.tips ? [G.line('tips')] : []; const lines = [...tips]; if (sug) lines.push(G.fill(G.line('suggest'), { a: G.acts[sug].name })); if (st.day === 2) lines.push(); this.phase = 'leaving'; const go = () => this.after(); if (lines.length) G.say('tare', lines, { onDone: go }); else go(); },\n  after() { const st = G.state; if (st.finished) return game.go('island'); if (st.day === 1 && st.session === 0) return game.go('act_stork', { mode: 'story', guided: true, skipCard: false }); if (st.day === 4 && !st.flags.recal) return game.go('recal'); if (st.day === 5) { st.flags.gamesAt = 0; G.save(); return game.go('games', { i: 0 }); } game.go('island'); },\n  draw(r) { const st = G.state; G.ROOMS.reception(r, game.real); G.mat(r, 0, 6, '#bfeee0', 44, 20); r.shape('whyfit:cactus-medium-b', 130, -30, 0); this.tare.draw(r, { bias: -5 }); G.actor(r, this.rig, { shadow: 6 });\n    r.overlay(g => { const P = this.phase; if (P === 'still' || P === 'lean') { G.drawPlate(g, this.bal, r.W / 2, r.H - 34, 26, { t: game.real }); G.text(g, P === 'still' ? 'Stillness Test: ' + G.fmtT(5 - this.t) : 'Lean Test: ' + (this.leanI + 1) + ' of 4', r.W / 2, r.H - 74, G.COL.INK, { align: 'center', shadow: '#fff' }); G.prompt; }\n      if (P === 'question') { const w = Math.min(r.W - 60, 300), x = (r.W - w) >> 1, y = r.H - 96; G.panel(g, x, y, w, 34); G.text(g, this.q.q, r.W / 2, y + 13, G.COL.INK, { align: 'center' }); this.pills.draw(g); }\n      if (P === 'reading') { const w = 180, x = (r.W - w) >> 1, y = 62; G.panel(g, x, y, w, 40); G.text(g, this.ducks, x + w / 2 - 14, y + 8, G.COL.ACCD, { align: 'center', scale: 3 }); G.text(g, 'ducks', x + w / 2 + 30, y + 16, G.COL.INK); }\n      if (P === 'age') { const w = Math.min(r.W - 60, 262), x = (r.W - w) >> 1, y = 56; G.panel(g, x, y, w, 60); G.drawAge(g, r, st, x + 10, y + 8); }\n      G.text(g, 'Day ' + st.day + ': ' + (G.dayInfo(st) ? G.dayInfo(st).name : 'Free Play'), 8, r.H - 14, G.COL.MUT); });\n    G.talk.draw(r); const P = this.phase; if (P === 'still' || P === 'lean') G.prompt(r, [['lean', 'Lean']]); else if (P === 'question' || P === 'age' || P === 'reading') G.prompt(r, [['confirm', 'Next']]); } });\n// Tare's Day: a 30-second scene. Somebody has to weigh Tare.\nG.scene('recal', { view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() { this.t = 0; this.tare = new G.Tare(0, 2, { s: 1, auto: false, face: 'worried' }); this.tare.z = 22; this.step = 0; this.rig = G.memberRig(2); G.music('dusk'); game.focus(0, 0, 18); G.say('tare', [G.LINES.day4, G.LINES.recal1], { onDone: () => { this.step = 1; } }); },\n  update(dt) { this.t += dt; if (G.talk.update(dt)) return; game.focus(0, 0, 18); this.rig.mocap = G.sampleLoop('Idle_Subtle', this.t); G.place(this.rig, dt, -60, 6, 0, .2); if (this.step === 1 && game.input.pressed('confirm') || (this.step === 1 && game.input.clicked && game.input.clicked())) { this.step = 2; G.sfx('boop'); G.say('tare', [G.LINES.recal2, G.LINES.recal3], { onDone: () => { G.state.flags.recal = true; G.save(); game.go('island'); } }); } this.tare.face = this.step >= 2 ? 'sad' : 'worried'; },\n  draw(r) { G.ROOMS.reception(r, game.real); const g = r.ctx, w = r.w(0, 2, 0), cx = w[0], by = w[1]; r.queue(0, 0, 0, g2 => { px.rect(g2, cx - 44, by - 22, 88, 22, '#7a8b92'); px.rect(g2, cx - 42, by - 28, 84, 6, '#b9cbd2'); px.disc(g2, cx, by - 60, 28, '#6a7b82'); px.disc(g2, cx, by - 60, 25, '#ffffff'); for (let i = 0; i < 12; i++) { const a = i / 12 * 6.283; px.rect(g2, cx + Math.cos(a) * 22, by - 60 + Math.sin(a) * 22, 1, 1, '#20404c'); } const a = this.step >= 2 ? -1.2 : -2.1 + Math.sin(this.t * 4) * .1; px.line(g2, cx, by - 60, cx + Math.cos(a) * 20, by - 60 + Math.sin(a) * 20, '#e0553a'); px.rect(g2, cx - 2, by - 32, 4, 5, '#6a7b82'); G.drawTareAt(g2, cx, by - 28, 1, this.tare.face, 0, G.state.minutes >= 20, game.real); }); G.actor(r, this.rig); G.talk.draw(r); if (this.step === 1) G.prompt(r, [['confirm', 'Read the dial']]); } });\nEOF\ncat > game/scenes/island.js <<'EOF'\n// Lumbar Island: the hub. A small TileMap you can cross in five seconds. No enemies, no timer. Time passes only by doing sessions.\nconst CW = 44, CH = 26;\nconst buildRows = () => { const R = Array.from({ length: CH }, () => Array(CW).fill('~')), fill = (x0, y0, x1, y1, c) => { for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) if (R[y] && R[y][x] !== undefined) R[y][x] = c; };\n  fill(4, 2, 39, 20, ','); fill(2, 4, 41, 18, ','); fill(6, 21, 34, 22, '.'); fill(3, 18, 30, 20, '.'); fill(3, 2, 12, 6, '^'); fill(24, 2, 39, 6, '='); fill(30, 17, 41, 23, '='); fill(24, 21, 30, 22, '=');\n  fill(16, 4, 23, 5, 'R'); fill(32, 8, 40, 9, 'R'); fill(4, 9, 11, 10, 'R'); fill(19, 11, 24, 12, 'R'); return R.map(a => a.join('')); };\nG.ISLAND_ROWS = buildRows();\nconst cell = (cx, cy) => [cx * 16 + 8, cy * 16 + 8];\nG.MATS = [ { id: 'stork', c: [27, 4] }, { id: 'flow', c: [32, 4] }, { id: 'candle', c: [37, 4] }, { id: 'squat', c: [33, 12] }, { id: 'pushup', c: [36, 12] }, { id: 'lunge', c: [39, 12] }, { id: 'step', c: [33, 19] }, { id: 'hoop', c: [38, 19] }, { id: 'jog', c: [36, 22] }, { id: 'tray', c: [9, 17] }, { id: 'laundry', c: [13, 15] }, { id: 'slalom', c: [6, 5] } ];\nG.NPCS = [ { id: 'gertrude', c: [28, 7] }, { id: 'dennis', c: [21, 14] }, { id: 'marisol', c: [25, 16], loop: 60 }, { id: 'kevin', c: [31, 14] }, { id: 'okafor', c: [31, 18] }, { id: 'lou', c: [18, 20], sleep: true }, { id: 'twins', c: [12, 12] } ];\nconst floorColor = (x, y, tag) => { const n = (Math.sin(x * .31) + Math.cos(y * .27) + Math.sin((x + y) * .13)) * 4; if (tag === 'sea') { const w = ((x + y * 2) >> 3) % 7 === 0 ? 10 : 0; return [73 + n + w, 182 + n + w, 201 + n]; } if (tag === 'grass') return [132 + n, 200 + n, 130 + n]; if (tag === 'sand') return [240 + n, 222 + n, 176 + n]; if (tag === 'board') { const pl = (y >> 3) & 1, seam = (y & 7) === 0 ? -26 : 0; return [214 + pl * 6 + seam, 180 + pl * 6 + seam, 132 + seam]; } if (tag === 'snow') return [244 + n, 250 + n, 255]; return [200, 200, 200]; };\nG.scene('island', { view: 'threequarter', pausable: true, camera: { zoom: false }, propSize: 1.2,\n  enter(d) { d = d || {}; G.talk.close(); const st = G.state; this.demo = !!d.demo; if (!this.map) { this.map = new E.TileMap({ rows: G.ISLAND_ROWS, legend: { '~': { floor: 'sea', block: true }, ',': { floor: 'grass' }, '.': { floor: 'sand' }, '=': { floor: 'board' }, '^': { floor: 'snow' }, R: { tile: 1 } }, types: { 1: { h: 32, top: '#f6fafa', side: '#e6eff2', face: 'plaster', roof: 'tiles' } }, floorTex: (x, y, tag) => floorColor(x, y, tag), outside: '#49b6c9', ao: 3 }); this.flow = new E.FlowField(this.map); }\n    game.cam.bounds = v => this.map.bounds(v); const sp = cell(20, 8); this.hero = new E.Body({ x: sp[0], y: sp[1], r: 5 }); this.hero.facing = 1.57; this.rig = G.memberRig(1.2); this.tare = new G.Tare(sp[0] - 18, sp[1] - 18, { s: .8, auto: false }); this.goal = null; this.near = null; this.idle = 0; this.wardrobe = null; this.time = 0; this.npcs = G.NPCS.map(n => { const p = cell(n.c[0], n.c[1]); return { def: n, x: p[0], y: p[1], hx: p[0], hy: p[1], rig: G.regularRig(n.id, 1.1), a: G.rng() * 6.28, n: 0, f: 1.57 }; }); this.gerald = cell(8, 12); this.bed = cell(6, 12); this.rail = cell(10, 12); game.follow(this.hero, { z: 10 });\n    this.sessLight(); this.waypts = this.demo ? [cell(27, 7), cell(33, 11), cell(33, 17), cell(13, 16), cell(20, 8)] : null; this.wi = 0; G.music(st.session >= 3 ? 'dusk' : 'morning');\n    if (!this.demo) { if (st.day === 2 && st.flags.nod && !st.flags.nodSaid) { st.flags.nodSaid = true; G.chat('tare', G.LINES.day2nod, 4); } if (st.session >= 3 && !st.flags.finishedFree) G.chat('tare', G.line('noSessions'), 3.5); } },\n  sessLight() { const s = G.state.session; G.lightFor(s === 0 ? 'morning' : s >= 3 ? 'dusk' : null); },\n  exit() { game.follow(null); game.cam.bounds = null; G.lightFor(null); },\n  spots() { const st = G.state, list = []; for (const m of G.MATS) { const [x, y] = cell(m.c[0], m.c[1]); list.push({ kind: 'mat', x, y, id: m.id, verb: G.acts[m.id].name, m }); } for (const n of this.npcs) list.push({ kind: 'npc', x: n.x, y: n.y, id: n.def.id, verb: 'Talk to ' + G.CAST[n.def.id].name, n }); list.push({ kind: 'bed', x: this.bed[0], y: this.bed[1], verb: 'Go to bed' }, { kind: 'rail', x: this.rail[0], y: this.rail[1], verb: 'The rail' }, { kind: 'gerald', x: this.gerald[0], y: this.gerald[1], verb: 'Look at Gerald' }, { kind: 'tare', x: this.tare.x, y: this.tare.y, verb: 'Talk to Tare', id: 'tare' }); return list; },\n  use(s) { const st = G.state; this.goal = null; G.talk.close(); game.input.consumeAll();\n    if (s.kind === 'mat') { if (!G.isUnlocked(st, s.id)) { G.say('tare', G.line('locked')); return; } if (G.sessionsLeft(st) <= 0 && !st.finished) { G.say('tare', G.line('noSessions')); return; } game.go('act_' + s.id, { mode: st.finished ? 'free' : 'story', from: 'island' }, { fade: 'iris', seconds: .3 }); }\n    else if (s.kind === 'npc') { const k = s.id, lines = G.CAST_LINES[k]; st.flags['t_' + k] = ((st.flags['t_' + k] || 0) + 1); G.say(k, lines[(st.flags['t_' + k] - 1) % lines.length]); }\n    else if (s.kind === 'tare') { const lines = G.CAST_LINES.tare; st.flags.t_tare = (st.flags.t_tare || 0) + 1; G.say('tare', lines[(st.flags.t_tare - 1) % lines.length]); }\n    else if (s.kind === 'gerald') { G.say('tare', G.line('gerald')); }\n    else if (s.kind === 'bed') { const go = () => game.go('evening'); if (G.sessionsLeft(st) > 0 && !st.finished) G.say('tare', G.line('earlyBed'), { choices: ['Sleep anyway', 'Not yet'], onChoice: i => { if (i === 0) go(); } }); else go(); }\n    else if (s.kind === 'rail') { this.openRail(); } },\n  openRail() { const st = G.state, have = G.unlockedItems(st).filter(u => ['towel', 'headband', 'sunhat', 'spareHat'].includes(u.id)); if (!have.length) { G.say('tare', 'The rail is empty. It is a very clean rail. Earn minutes for Gerald.'); return; } const label = u => u.name + ': ' + (st.wear[u.id] === false ? 'off' : 'on'); const items = have.map(u => { const it = { label: label(u), on: () => { st.wear[u.id] = st.wear[u.id] === false; it.label = label(u); this.rig = G.memberRig(1.2); G.save(); } }; return it; }); items.push({ label: 'Close', on: () => { this.wardrobe = null; game.input.consumeAll(); } }); this.wardrobe = new G.Pills(items, { w: 180, onBack: () => { this.wardrobe = null; } }); },\n  update(dt) { const st = G.state, I = game.input, h = this.hero; this.time += dt; if (G.talk.update(dt)) { this.anim(dt, 0, 0); return; } if (this.wardrobe) { this.wardrobe.update(dt); this.anim(dt, 0, 0); return; }\n    let mx = 0, my = 0;\n    if (this.demo) { const w = this.waypts[this.wi]; if (w) { const dx = w[0] - h.x, dy = w[1] - h.y, d = Math.hypot(dx, dy); if (d < 12) { this.wi = (this.wi + 1) % this.waypts.length; } else { this.flow.update(w[0], w[1]); const dr = this.flow.dir(h.x, h.y, w[0], w[1]); mx = dr[0]; my = dr[1]; } } }\n    else { const m = I.move(); if (m[0] || m[1]) { const dr = game.view.screenDirToGround(m[0], m[1]); mx = dr[0]; my = dr[1]; this.goal = null; this.idle = 0; }\n      const c = I.clicked && I.clicked(); if (c) { const hit = this.hover && this.hover.spot; const q = hit || null; const gr = game.mouseGround && game.mouseGround(); if (q) { this.goal = { x: q.x, y: q.y, spot: q }; } else if (gr) this.goal = { x: gr[0], y: gr[1] }; }\n      if (this.goal) { const dx = this.goal.x - h.x, dy = this.goal.y - h.y; if (Math.hypot(dx, dy) < (this.goal.spot ? 14 : 5)) { const q = this.goal.spot; this.goal = null; if (q) { this.use(q); return; } } else { this.flow.update(this.goal.x, this.goal.y); const dr = this.flow.dir(h.x, h.y, this.goal.x, this.goal.y); mx = dr[0]; my = dr[1]; } } }\n    const sp = 130; h.vx = mx * sp; h.vy = my * sp; h.update(dt, this.map); if (mx || my) h.facing = Math.atan2(my, mx); this.anim(dt, mx, my);\n    // nearest thing and hover\n    const spots = this.spots(); let best = null, bd = 18; for (const q of spots) { const d = Math.hypot(q.x - h.x, q.y - h.y); if (d < bd) { bd = d; best = q; } } this.near = best;\n    const p = I.pointer && I.pointer(); this.hover = null; if (p && game.r && game.r.pick) { const q = game.r.pick(p[0], p[1]); const hit = q && (q.kindSpot ? q : null); if (hit) this.hover = { spot: hit.kindSpot }; } if (p && !this.hover && game.mouseGround) { const gr = game.mouseGround(); if (gr) { let b2 = null, bd2 = 14; for (const q of spots) { const d = Math.hypot(q.x - gr[0], q.y - gr[1]); if (d < bd2) { bd2 = d; b2 = q; } } if (b2 && G.source(I) === 'mouse') this.hover = { spot: b2 }; } }\n    if (!this.demo && I.pressed('interact') && best) { this.use(best); return; }\n    this.idle += dt; if (!this.demo && this.idle > 25) { this.idle = -40; G.chat('tare', G.line('idle'), 3.5); } },\n  anim(dt, mx, my) { const h = this.hero, r = this.rig; r.mocap = null; r.body = null; r.update(dt, { x: h.x, y: h.y, z: 0, vx: h.vx || 0, vy: h.vy || 0, facing: h.facing }); r.px = h.x; r.py = h.y; r.pz = 0; if (!mx && !my) { h.vx = h.vy = 0; }\n    const t = this.tare, dx = h.x - t.x, dy = h.y - t.y, d = Math.hypot(dx, dy); t.update(dt); if (d > 28) { if (t.z <= 0) t.hop(55); const sp2 = 150; t.x += dx / d * sp2 * dt; t.y += dy / d * sp2 * dt; } t.face = this.near && this.near.kind === 'bed' ? 'sad' : 'neutral';\n    for (const n of this.npcs) { n.a += dt * .3; const rad = n.def.sleep ? 0 : (n.def.loop || 12); const tx = n.hx + Math.cos(n.a) * rad, ty = n.hy + Math.sin(n.a * .8) * rad * .7, vx = (tx - n.x) * 2, vy = (ty - n.y) * 2; n.x += vx * dt; n.y += vy * dt; if (Math.abs(vx) + Math.abs(vy) > 3) n.f = Math.atan2(vy, vx); n.rig.mocap = n.def.sleep ? G.sampleLoop('Sleeping', this.time) : null; n.rig.update(dt, { x: n.x, y: n.y, z: 0, vx, vy, facing: n.def.sleep ? 1.57 - (n.rig.spin || 0) : n.f }); n.rig.px = n.x; n.rig.py = n.y; n.rig.pz = 0; } },\n  draw(r) { const st = G.state; this.map.drawFloor(r); this.map.queueWalls(r); const sug = st.suggestion;\n    for (const m of G.MATS) { const [x, y] = cell(m.c[0], m.c[1]), open = G.isUnlocked(st, m.id), near = this.near && this.near.id === m.id || (this.hover && this.hover.spot.id === m.id); const col = !open ? '#c8d0d4' : near ? '#fff2a8' : { Stillness: '#e6dcff', Strength: '#ffd2c4', Cardio: '#bfeee0', Balance: '#c4e8fa' }[G.acts[m.id].discipline]; r.decal(() => { const g = r.ctx; G.floorPoly(r, g, [[x - 11, y - 8], [x + 11, y - 8], [x + 11, y + 8], [x - 11, y + 8]], E.mix(col, '#20404c', .25)); G.floorPoly(r, g, [[x - 9, y - 6], [x + 9, y - 6], [x + 9, y + 6], [x - 9, y + 6]], col); }); if (open && sug === m.id) r.queue(x, y, 14 + Math.sin(game.real * 3) * 2, g => { const p = r.w(x, y, 16 + Math.sin(game.real * 3) * 2); G.starSprite(g, p[0], p[1], true, 1); }, { emissive: true }); }\n    for (const n of this.npcs) G.actor(r, n.rig, { shadow: 5, pick: { kindSpot: { kind: 'npc', x: n.x, y: n.y, id: n.def.id, verb: 'Talk' , n } } });\n    G.actor(r, this.rig, { shadow: 6 }); this.tare.draw(r);\n    r.shape('whyfit:bed-double-a', this.bed[0], this.bed[1], 0, { facing: 0 }); r.queue(this.rail[0], this.rail[1], 0, g => { const p = r.w(this.rail[0], this.rail[1], 0); px.rect(g, p[0] - 12, p[1] - 22, 2, 22, '#8a6a42'); px.rect(g, p[0] + 10, p[1] - 22, 2, 22, '#8a6a42'); px.rect(g, p[0] - 12, p[1] - 22, 24, 2, '#b08a5a'); let i = 0; for (const u of G.unlockedItems(st)) { px.rect(g, p[0] - 9 + i * 5, p[1] - 20, 4, 11, ['#f8f8f4', '#2cc6e6', '#f3dfa0', '#e0553a', '#c7a7e8', '#9fb8d0'][i % 6]); i++; } });\n    r.queue(this.gerald[0], this.gerald[1], 0, g => { const p = r.w(this.gerald[0], this.gerald[1], 0); G.drawGeraldAt(g, p[0], p[1], .9, st.minutes >= 30); });\n    r.shape('sign', 170, 24, 0); r.shape('whyfit:bench', cell(18, 20)[0], cell(18, 20)[1] - 6, 0); r.shape('whyfit:cactus-medium-a', cell(24, 8)[0], cell(24, 8)[1], 0); r.shape('whyfit:cactus-medium-b', cell(13, 8)[0], cell(13, 8)[1], 0); r.prop('pine', cell(4, 5)[0], cell(4, 5)[1], 0); r.prop('pine', cell(9, 3)[0], cell(9, 3)[1], 0); r.prop('palm', cell(5, 17)[0], cell(5, 17)[1], 0); r.prop('palm', cell(28, 20)[0], cell(28, 20)[1], 0); r.prop('palm', cell(30, 15)[0], cell(30, 15)[1], 0);\n    if (st.session >= 3) { for (const c of [[20, 9], [8, 11], [34, 15]]) { const [x, y] = cell(c[0], c[1]); r.prop('streetlamp', x, y, 0, { light: true }); } }\n    const blender = cell(23, 14); r.queue(blender[0], blender[1], 0, g => { const p = r.w(blender[0], blender[1], 0); G.PROPS.blender(g, p[0], p[1]); });\n    r.overlay(g => { G.round(g, 8, 8, 86, 14, '#ffffff'); G.text(g, 'Day ' + st.day, 14, 12); for (let i = 0; i < 3; i++) { px.disc(g, 56 + i * 12, 15, 4, i < st.session ? G.COL.ACC : '#dbe6ea'); } const ca = game.cornerArea && game.cornerArea(), x1 = (ca ? ca.x0 : r.W) - 8, s1 = 'Age ' + st.age, s2 = Math.floor(st.minutes) + ' min', w = E.font.width(s1) + E.font.width(s2) + 36; G.round(g, x1 - w, 8, w, 14, '#ffffff'); G.text(g, s1, x1 - w + 6, 12, G.COL.CORAL); G.drawGeraldAt(g, x1 - E.font.width(s2) - 16, 21, .32); G.text(g, s2, x1 - E.font.width(s2) - 5, 12); if (this.wardrobe) { G.text(g, 'The Rail', r.W / 2, 30, G.COL.INK, { align: 'center', scale: 2, shadow: '#fff' }); this.wardrobe.draw(g); } const h = this.hover && this.hover.spot; if (h && !this.wardrobe) { const lab = h.verb || 'Go'; G.text(g, lab, r.W / 2, 26, G.COL.INK, { align: 'center', shadow: '#fff' }); } });\n    G.talk.draw(r); if (!this.wardrobe && !G.talk.open && this.near) G.prompt(r, [['interact', this.near.verb]]); else if (this.wardrobe) G.prompt(r, [['confirm', 'Choose'], ['cancel', 'Close']]); } });\n\nG.scene('evening', { view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() { const st = G.state; this.t = 0; this.rig = G.memberRig(2); G.music('dusk'); G.lightFor('dusk'); G.sting('dayDone'); this.pills = new G.Pills([{ label: 'Sleep', on: () => this.sleep() }], { y: (W, H) => H - 44 }); game.focus(0, 0, 18); G.say('tare', [G.line('night')]); },\n  sleep() { const st = G.state; st.day++; st.session = 0; st.pauses = 0; st.flags.checked = false; st.flags.nodSaid = false; G.lightFor(null); G.save(); game.go('bodycheck', undefined, { fade: 'white', seconds: .5 }); },\n  update(dt) { this.t += dt; game.focus(0, 0, 18); if (G.talk.update(dt)) { this.anim(dt); return; } this.anim(dt); this.pills.update(dt); },\n  anim(dt) { this.rig.mocap = G.sampleLoop('Sleeping', this.t); G.place(this.rig, dt, -40, 0, 8, 1.57); },\n  draw(r) { const st = G.state; G.ROOMS.bungalow(r, game.real); r.shape('whyfit:bed-double-a', -40, 0, 0, { facing: 1.57 }); G.actor(r, this.rig); r.queue(90, 6, 0, g => { const p = r.w(90, 6, 0); G.drawGeraldAt(g, p[0], p[1], 1.4, st.minutes >= 30); }); game.lights.add(90, 0, 34, 80, .9, { color: '#ffc070' });\n    r.overlay(g => { const w = Math.min(r.W - 60, 262), x = (r.W - w) >> 1, y = 30; G.panel(g, x, y, w, 60); G.drawAge(g, r, st, x + 10, y + 8); G.text(g, 'Gerald holds ' + Math.floor(st.minutes) + ' minutes', r.W / 2, y + 66, '#ffffff', { align: 'center', shadow: '#20404c' }); this.pills.draw(g); }); G.talk.draw(r); G.prompt(r, [['confirm', 'Sleep']]); } });\nEOF\ncat > game/scenes/games.js <<'EOF'\n// Day 5: one continuous festival, then the duel, then the truth about the card.\nG.GAMES = [ { id: 'stork', line: 'games1', o: { short: true } }, { id: 'step', line: 'games2', o: { short: true } }, { id: 'slalom', line: 'games2', o: { short: true } }, { id: 'candle', line: 'games3', o: { duel: true, slots: [{ x: -56, y: 0, size: 1.9 }] } } ];\nG.scene('games', { view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter(d) { this.i = d && d.i || 0; const st = G.state; if (this.i >= G.GAMES.length) { game.go('ending', undefined, { fade: 'white', seconds: .6 }); return; } st.flags.gamesAt = this.i; G.save(); const e = G.GAMES[this.i]; this.crowd = []; G.music('festival'); this.t = 0; game.focus(0, 0, 18); this.go = () => game.go('act_' + e.id, Object.assign({ mode: 'games', festival: true, onDone: () => game.go('games', { i: this.i + 1 }) }, e.o), { fade: 'iris', seconds: .4 }); const name = e.o.duel ? 'The Grand Stillness' : G.acts[e.id].name; this.name = name; this.pills = null; G.say('tare', [G.LINES[e.line], name + '.'], { onDone: () => { this.pills = new G.Pills([{ label: 'Step up', on: this.go }], { y: (W, H) => H - 44 }); } }); },\n  update(dt) { this.t += dt; game.focus(0, 0, 18); if (G.talk.update(dt)) return; if (this.pills) this.pills.update(dt); },\n  draw(r) { G.ROOMS.festival(r, game.real); for (let i = 0; i < 14; i++) { const x = -190 + i * 29, hop = Math.abs(Math.sin(game.real * 4 + i)) * 2; r.queue(x, -30, 0, g => { const p = r.w(x, -30, 0); px.rect(g, p[0] - 3, p[1] - 13 - hop, 6, 13, ['#c79be8', '#2cc6e6', '#f5c84b', '#7bd389', '#ff7a59'][i % 5]); px.disc(g, p[0], p[1] - 16 - hop, 3, ['#ffdfc4', '#d8a878', '#8e6240'][i % 3]); }); }\n    r.overlay(g => { G.drawLogo(g, r, r.W / 2, 34, 2); G.text(g, 'The Gentle Games', r.W / 2, 60, G.COL.INK, { align: 'center', shadow: '#fff' }); G.text(g, 'Next: ' + this.name, r.W / 2, 74, G.COL.ACCD, { align: 'center', scale: 2, shadow: '#fff' }); if (this.pills) this.pills.draw(g); }); G.talk.draw(r); if (this.pills) G.prompt(r, [['confirm', 'Step up']]); } });\nG.scene('ending', { view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() { const st = G.state; st.finalAge = G.computeAge(st); st.age = st.finalAge; st.ages.push(st.finalAge); st.finished = true; delete st.flags.gamesAt; G.save(); this.step = 0; this.t = 0; this.tare = new G.Tare(0, 4, { s: 2.2, auto: false, face: 'worried' }); this.rig = G.memberRig(2); this.x = 0; this.z = 12; G.music('ending'); game.focus(0, 0, 18); const a = st.finalAge, extra = a <= 24 ? 'endGood' : a <= 45 ? 'endMid' : 'endBad'; if (a <= 24) st.flags.hat = true; G.say('tare', [G.LINES.end1, G.LINES.end2, G.LINES.end3, G.LINES.end4, G.LINES[extra]], { onDone: () => { this.step = 1; this.t = 0; G.save(); } }); this.credits = ['WHY FIT', '', 'A stay at the Institute for Gentle Improvement', '', 'Tare, as Tare', 'Gerald, as a hippo', 'Birch and Alder, as wood', 'Gertrude, since Thursday', 'Dennis, Marisol, Young Kevin', 'Mr. Okafor, Lou, The Twins (unrelated)', '', 'Motion: Mesh2Motion, Quaternius, CMU', 'Engine: my-3D2dge', '', 'Your Spine Age: ' + a, '', 'Thank you for standing.', G.LINES.freeplay]; },\n  update(dt) { this.t += dt; game.focus(0, 0, 18); this.tare.update(dt); if (G.talk.update(dt)) { this.anim(dt); return; } this.anim(dt); if (this.step === 1) { this.z = Math.max(0, this.z - dt * 30); this.x += dt * 26; this.tare.face = 'sad'; if ((this.t > 2 && (game.input.pressed('confirm') || (game.input.clicked && game.input.clicked()))) || this.t > 34) { this.step = 2; game.go('island'); } } },\n  anim(dt) { const walking = this.step === 1; this.rig.mocap = walking ? null : G.sampleLoop('Idle_Subtle', this.t); G.place(this.rig, dt, this.x, 4, this.z, walking ? 0 : 1.57, walking ? { vx: 26 } : {}); },\n  draw(r) { G.ROOMS.raft && G.ROOMS.studio(r, game.real); G.mat(r, 0, 6, '#bfeee0', 44, 20); this.tare.draw(r, { bias: -5 }); G.actor(r, this.rig, { shadow: 6 }); if (this.step === 1) r.overlay(g => { const top = r.H - this.t * 18; this.credits.forEach((s, i) => { const y = top + i * 14; if (y > -10 && y < r.H) G.wrapText(g, s, 16, y, r.W * .55, G.COL.INK, { shadow: '#fff', gap: 0 }); }); }); G.talk.draw(r); if (this.step === 1) G.prompt(r, [['confirm', 'Go on']]); } });\nEOF\ncat > game/scenes/class.js <<'EOF'\n// Class: 2 to 4 people on one screen. Everybody gets a mat. Empty mats hold Regulars, for life, not for score.\nconst CLASS_ACTS = ['stork', 'candle', 'squat', 'step', 'hoop'];\nconst FILL = ['gertrude', 'kevin', 'twins', 'marisol'];\nG.classRun = null;\nG.classContestants = () => { const list = []; game.players.forEach((p, i) => { list.push({ name: p.name || 'P' + (i + 1), input: p, color: E.PLAYER_COLORS[i], local: i === 0, rig: G.lookToRig({ hair: G.LOOKS.hair[i % 5], skin: (i * 2) % 6, top: [7, 0, 2, 3][i], bottom: i % 4 }, 1.5, {}) }); }); for (let i = list.length; i < 4; i++) { const id = FILL[i]; list.push({ name: G.CAST[id].name, color: '#8fa6ae', rig: G.regularRig(id, 1.5), bot: 'average', forScore: false }); } return list; };\nG.scene('classroom', { topLevel: true, input: G.CLASS_INPUT, view: 'brawler', camera: { zoom: false },\n  enter() { G.talk.close(); game.allowJoin({ max: 4, onJoin: () => { G.sfx('boop'); G.chat('tare', G.line('classIntro'), 2.5); this.rebuild(); } }); this.build(); G.music('morning'); game.focus(0, 0, 18); this.t = 0; },\n  exit() {},\n  build() { const start = list => { G.classRun = { list, i: 0, totals: game.players.map(() => 0) }; G.classNext(); }; const items = [{ label: 'Surprise me (3 rounds)', on: () => { const p = CLASS_ACTS.slice(); for (let i = p.length - 1; i > 0; i--) { const j = Math.floor(G.rng() * (i + 1)); [p[i], p[j]] = [p[j], p[i]]; } start(p.slice(0, 3)); } }, ...CLASS_ACTS.map(id => ({ label: G.acts[id].name, on: () => start([id]) })) ]; this.pills = new G.Pills(items.slice(0, 6), { w: 150, x: (W, H, mw) => W - mw - 16, y: (W, H, t) => Math.max(28, (H - t) / 2 + 4), h: 16, gap: 3, onBack: () => { game.allowJoin(false); while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]); game.go('title'); } }); this.rebuild(); },\n  rebuild() { this.rigs = G.classContestants().map(c => c); this.rigs.forEach((c, i) => { c.x = -96 + i * 56; }); },\n  update(dt) { this.t += dt; G.talk.update(dt); game.focus(-40, 0, 18); this.pills.update(dt); this.rigs.forEach((c, i) => { c.rig.mocap = G.sampleLoop(c.bot ? 'Idle_Subtle' : 'Waiting_Loop', this.t + i); G.place(c.rig, dt, c.x, 0, 0, 1.57); }); },\n  draw(r) { G.ROOMS.studio(r, game.real); this.rigs.forEach(c => { G.mat(r, c.x, 4, c.bot ? '#dfe7ea' : E.mix(c.color, '#ffffff', .5), 22, 12); G.actor(r, c.rig); });\n    r.overlay(g => { G.text(g, 'Class', 16, 8, G.COL.INK, { scale: 2, shadow: '#fff' }); this.rigs.forEach(c => { const p = r.w(c.x, 0, 0); G.text(g, c.name, p[0], p[1] + 16, c.bot ? G.COL.MUT : c.color, { align: 'center', shadow: '#fff' }); }); const n = game.players.length; if (n < 4) G.text(g, 'Join: Start on a free controller, or 2 on the keyboard', 16, 28, G.COL.INK, { shadow: '#fff' }); this.pills.draw(g); }); G.talk.draw(r); G.prompt(r, [['confirm', 'Begin'], ['cancel', 'Back']]); } });\nG.classNext = () => { const R = G.classRun; if (R.i >= R.list.length) { game.go('podium'); return; } const id = R.list[R.i], contestants = G.classContestants(); game.go('act_' + id, { mode: 'class', limit: 35, contestants, slots: G.slots(4), onDone: ctx => { ctx.contestants.forEach((c, i) => { if (c.forScore) R.totals[i] += c.score; }); R.last = { id, scores: ctx.contestants.filter(c => c.forScore).map(c => ({ name: c.name, score: c.score })) }; R.i++; game.go('roundscores'); } }); };\nG.scene('roundscores', { input: G.CLASS_INPUT, view: 'brawler', camera: { zoom: false },\n  enter() { const R = G.classRun; this.R = R; G.stopMusic(); this.pills = new G.Pills([{ label: R.i < R.list.length ? 'Next round' : 'The results', on: () => G.classNext() }], { y: (W, H) => H - 44 }); game.focus(0, 0, 18); },\n  update(dt) { this.pills.update(dt); },\n  draw(r) { G.ROOMS.studio(r, game.real); r.overlay(g => { const L = this.R.last, w = 220, x = (r.W - w) >> 1; G.panel(g, x, 30, w, 24 + L.scores.length * 16); G.text(g, G.acts[L.id].name, x + 12, 37); L.scores.forEach((s, i) => { G.text(g, s.name, x + 12, 54 + i * 16, E.PLAYER_COLORS[i]); G.text(g, String(s.score), x + w - 12, 54 + i * 16, G.COL.INK, { align: 'right' }); }); this.pills.draw(g); }); G.prompt(r, [['confirm', 'Next']]); } });\nG.classTitles = ['Most Still', 'Best Wobble', 'Participated', 'Also Participated'];\nG.scene('podium', { input: G.CLASS_INPUT, view: 'brawler', camera: { zoom: false },\n  enter() { const R = G.classRun, cs = G.classContestants().filter(c => c.forScore !== false); this.order = cs.map((c, i) => ({ c, total: R.totals[i] })).sort((a, b) => b.total - a.total); this.order.forEach((o, i) => { o.x = [0, -70, 70, 130][i]; o.z = [26, 16, 8, 0][i]; o.title = G.classTitles[i]; }); this.t = 0; G.music('festival'); G.sting('star3'); G.say('tare', [G.fill(G.line('classWin'), { n: this.order[0].c.name }), G.LINES.classEnd], { onDone: () => { this.pills = new G.Pills([{ label: 'Another class', on: () => game.go('classroom') }, { label: 'Back to the title', on: () => { game.allowJoin(false); while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]); game.go('title'); } }], { dir: 'h', y: (W, H) => H - 44 }); } }); game.focus(0, 0, 18); },\n  update(dt) { this.t += dt; if (G.talk.update(dt)) { this.anim(dt); return; } this.anim(dt); if (this.pills) this.pills.update(dt); },\n  anim(dt) { this.order.forEach((o, i) => { o.c.rig.mocap = G.sampleLoop(i === 0 ? 'Victory' : i === 1 ? 'Cheering_Two_Hands' : 'Idle_Subtle', this.t); G.place(o.c.rig, dt, o.x, 0, o.z, 1.57); }); },\n  draw(r) { G.ROOMS.studio(r, game.real); this.order.forEach((o, i) => { if (o.z > 0) r.queue(o.x, 0, 0, g => { const p = r.w(o.x, 0, 0), h = Math.round(o.z * 1.5); px.rect(g, p[0] - 24, p[1] - h, 48, h, '#f6fafa'); px.rect(g, p[0] - 24, p[1] - h, 48, 2, G.COL.ACC); }, { bias: -8 }); G.actor(r, o.c.rig); }); r.overlay(g => { this.order.forEach(o => { const p = r.w(o.x, 0, 0); G.text(g, o.title, p[0], p[1] + 8, G.COL.INK, { align: 'center', shadow: '#fff' }); G.text(g, o.c.name + ': ' + o.total, p[0], p[1] + 19, o.c.color, { align: 'center', shadow: '#fff' }); }); if (this.pills) this.pills.draw(g); }); G.talk.draw(r); if (this.pills) G.prompt(r, [['confirm', 'Choose']], { y: 6 }); } });\nEOF\ncat > game/scenes/round.js <<'EOF'\n// Morning Class: the AI Hub round. Everyone plays the same three events on their own copy, in lockstep, with others as ghosts.\nG.Round = { info: null, card: null, ghosts: {}, idx: -1, total: 0, reported: false, over: false, lastSend: 0, lastProg: 0, scores: {}, sub: 'card', cur: 0 };\nconst RD = G.Round;\nRD.INTRO = 5000; RD.PLAY = 40000; RD.OUT = 5000;\nRD.setup = info => { RD.info = info; const r = AIHub.rng('deal'), a = list => list[Math.floor(r() * list.length) % list.length]; RD.deal = [a(['stork', 'candle', 'squat', 'pushup']), a(['step', 'hoop']), a(['slalom', 'jog'])]; const total = RD.INTRO + RD.PLAY + RD.OUT, lim = info.limitMs ? (info.limitMs - 3000) / 3 : total; if (lim < total) { const k = lim / total; RD.INTRO *= k; RD.PLAY *= k; RD.OUT *= k; } RD.len = RD.INTRO + RD.PLAY + RD.OUT; for (const p of info.players) RD.scores[p.id] = 0; RD.seat = info.players.findIndex(p => p.id === info.me); };\nRD.go = idx => { const id = RD.deal[idx], me = RD.info.players[RD.seat >= 0 ? RD.seat : 0], rng = AIHub.rng('e' + idx), seed = Math.floor(rng() * 1e9), slots = G.slots(Math.max(2, RD.info.players.length)), mine = slots[RD.seat >= 0 ? RD.seat : 0]; RD.idx = idx; RD.done = false; RD.begun = false; RD.ghostRigs = {};\n  const look = { hair: G.LOOKS.hair[RD.seat % 5], skin: (RD.seat * 2 + 1) % 6, top: RD.seat % 8, bottom: RD.seat % 4 };\n  game.go('act_' + id, { mode: 'round', seed, limit: RD.PLAY / 1000, short: id === 'slalom', slots: [mine].concat(slots), ghosts: RD.ghosts, contestants: [{ name: me.name, color: me.color, local: true, input: game.input, rig: G.lookToRig(look, mine.size, {}) }], coach: 'alder' }, { fade: 0 }); };\nRD.report = () => { if (RD.reported || !window.AIHub) return; RD.reported = true; const s = Math.round(RD.total); AIHub.result({ score: s, stats: { Steadiness: Math.round(s / 30) + '%' }, awards: s > 2000 ? [{ title: 'Most Still', detail: 'Tare noticed.' }] : [{ title: 'Participated', detail: 'It has been written down.' }] }); };\n// runs inside an activity scene in round mode: all timing from the hub's clock\nRD.step = (scene, dt) => { const ctx = scene.ctx, def = ctx.def, t = AIHub.time() - RD.idx * RD.len, inPlay = t >= RD.INTRO && t < RD.INTRO + RD.PLAY; RD.sub = t < RD.INTRO ? 'intro' : inPlay ? 'play' : 'out'; RD.left = RD.sub === 'intro' ? RD.INTRO - t : RD.sub === 'play' ? RD.INTRO + RD.PLAY - t : RD.len - t;\n  if (inPlay && !RD.over) { if (!RD.begun) { RD.begun = true; if (def.begin) def.begin(ctx); ctx.t = 0; } if (!ctx.done) { ctx.t = (t - RD.INTRO) / 1000; G.playStep(ctx, dt); } }\n  else if (RD.sub === 'out' && !RD.done) { RD.done = true; if (RD.begun) { const c = ctx.local; G.resultOf(ctx, c); RD.total += c.score; RD.scores[RD.info.me] = RD.total; if (def.stop) def.stop(ctx); } if (RD.idx === RD.deal.length - 1) RD.report(); }\n  if (def.animate) def.animate(dt, ctx); RD.animGhosts(dt, ctx); };\nRD.tick = dt => { if (!RD.info || RD.over) return; const t = AIHub.time(); if (t === -Infinity) return; if (t >= 0) { const idx = Math.min(RD.deal.length - 1, Math.floor(t / RD.len)); if (idx !== RD.idx && t < RD.len * RD.deal.length) RD.go(idx);\n    const sc = game.scene, ctx = sc && sc.ctx; const now = game.real; if (ctx && RD.idx === idx && now - RD.lastSend >= .1 && ctx.def.ghost && ctx.local && RD.begun) { RD.lastSend = now; const g = ctx.def.ghost(ctx); AIHub.send({ t: 'g', a: RD.idx, l: g.l, p: g.p, w: g.w, s: g.s }, { reliable: false }); RD.cur = g.s || 0; }\n    if (now - RD.lastProg >= 1) { RD.lastProg = now; const score = Math.round(RD.total + (RD.done ? 0 : (RD.cur || 0))); AIHub.progress({ score, label: score + ' pts' }); } } };\nRD.animGhosts = (dt, ctx) => { for (const id in RD.ghosts) { const st = RD.ghosts[id]; if (st.a !== RD.idx) continue; const seat = RD.info.players.findIndex(p => String(p.id) === String(id)); if (seat < 0) continue; let rig = RD.ghostRigs[id]; const slot = (ctx.data.slots || [])[seat + 1] || { x: 0, y: 0, size: 1.5 }; if (!rig) { rig = RD.ghostRigs[id] = G.lookToRig({ hair: G.LOOKS.hair[seat % 5], skin: (seat * 2 + 1) % 6, top: seat % 8, bottom: seat % 4 }, ctx.def.view === 'brawler' || !ctx.def.view ? slot.size : 1.2, {}); } if (ctx.id === 'slalom' || ctx.id === 'jog') continue; const def = ctx.def; let tgt = 1.57; rig.wob = st.l ? [st.l[0], st.l[1]] : [0, 0]; if (def.ghostPose) tgt = def.ghostPose(rig, st, dt); else if (ctx.id === 'candle') rig.mocap = G.sampleLoop('Meditate', game.real * .4); else rig.mocap = G.samplePose('stork', game.real); G.place(rig, dt, slot.x, slot.y, 0, tgt); rig.slot = slot; } };\nG.drawGhosts = (r, ctx) => { if (ctx.mode !== 'round') return; for (const id in RD.ghostRigs) { const rig = RD.ghostRigs[id], st = RD.ghosts[id], p = RD.info.players.find(q => String(q.id) === String(id)); if (!st || !p || st.a !== RD.idx || !rig.slot) continue; G.actor(r, rig, { alpha: .5, shadow: 5 }); r.overlay(g => { const q = r.w(rig.px, rig.py, 0); G.text(g, p.name, q[0], q[1] + 6, p.color, { align: 'center', shadow: '#fff' }); }); } };\nG.drawGhosts7 = (m7, ctx) => { if (ctx.mode !== 'round') return; for (const id in RD.ghosts) { const st = RD.ghosts[id], p = RD.info.players.find(q => String(q.id) === String(id)); if (!p || st.a !== RD.idx || st.p === undefined || !st.w) continue; m7.add(st.w[0], st.p, 0, (g, sx, sy, k) => { const c = p.color; px.blend(g, .5, 'normal', () => { px.rect(g, sx - 3 * k, sy - 14 * k, 6 * k, 10 * k, c); px.disc(g, sx, sy - 17 * k, 3 * k, '#f0c8a0'); px.rect(g, sx - 3 * k, sy - 4 * k, 6 * k, 4 * k, '#20404c'); }); G.text(g, p.name, sx, sy - 28 * k, c, { align: 'center', shadow: '#fff' }); }); } };\nG.jogGhosts = ctx => { if (ctx.mode !== 'round') return []; const out = []; for (const id in RD.ghosts) { const st = RD.ghosts[id], p = RD.info.players.find(q => String(q.id) === String(id)); if (!p || st.a !== RD.idx || st.p === undefined || !st.w) continue; out.push({ z: st.p + ctx.ahead, x: st.w[0], w: 150, draw: (g, sx, sy, k) => { const w = 150 * k, h = 460 * k; px.blend(g, .5, 'normal', () => { px.rect(g, sx - w * .32, sy - h * .8, w * .64, h * .47, p.color); px.rect(g, sx - w * .25, sy - h * .35, w * .5, h * .35, '#20404c'); px.disc(g, sx, sy - h * .92, w * .28, '#f0c8a0'); }); G.text(g, p.name, sx, sy - h * 1.1, p.color, { align: 'center', shadow: '#fff' }); } }); } return out; };\nRD.overlay = (g, r, ctx) => { const def = ctx.def, s = Math.max(0, Math.ceil(RD.left / 1000)); if (RD.sub === 'intro') { const w = Math.min(r.W - 60, 280), x = (r.W - w) >> 1, y = 34; G.panel(g, x, y, w, 72); G.text(g, def.name, x + w / 2, y + 8, G.COL.INK, { align: 'center', scale: 2 }); G.wrapText(g, def.says, x + 12, y + 28, w - 24, G.COL.MUT); G.text(g, 'Event ' + (RD.idx + 1) + ' of 3. Begins in ' + s, x + w / 2, y + 60, G.COL.ACCD, { align: 'center' }); }\n  else if (RD.sub === 'play') { const w = 34; G.round(g, r.W - 150, 8, w, 14, '#ffffff'); G.text(g, s + 's', r.W - 133, 12, G.COL.ACCD, { align: 'center' }); }\n  else { const P = RD.info.players, w = Math.min(r.W - 80, 240), x = (r.W - w) >> 1, y = 40; G.panel(g, x, y, w, 24 + P.length * 14); G.text(g, RD.idx === 2 ? 'Morning Class is over' : 'After event ' + (RD.idx + 1), x + w / 2, y + 7, G.COL.INK, { align: 'center' }); const sc = P.map(p => ({ p, v: p.id === RD.info.me ? RD.total : (RD.scores[p.id] || 0) })).sort((a, b) => b.v - a.v); sc.forEach((e, i) => { G.text(g, e.p.name, x + 12, y + 22 + i * 14, e.p.color); G.text(g, String(Math.round(e.v)), x + w - 12, y + 22 + i * 14, G.COL.INK, { align: 'right' }); }); } };\nRD.howto = () => ({ pad: 'Left stick leans. R2 breathes. L1 and R1 catch.', keys: 'WASD leans. Space breathes. Q and E catch.', mouse: 'Move the mouse to lean. Click to breathe.' })[G.source(game.input)];\nG.scene('round', { view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() { this.t = 0; this.tare = new G.Tare(0, 26, { s: 1.6 }); this.rigs = null; this.card = { left: null, ready: [], asking: 0 }; G.music('studio'); game.focus(0, 0, 18); },\n  update(dt) { this.t += dt; this.tare.update(dt); game.focus(0, 0, 18); const I = game.input, info = RD.info; if (!info) return; if (!this.rigs) { const sl = G.slots(Math.max(2, info.players.length)); this.rigs = info.players.map((p, i) => { const q = G.lookToRig({ hair: G.LOOKS.hair[i % 5], skin: (i * 2 + 1) % 6, top: i % 8, bottom: i % 4 }, sl[i].size, {}); q.x = sl[i].x; return q; }); this.btns = [{ id: 'ready', label: 'Ready' }, { id: 'more', label: 'More time' }]; } this.rigs.forEach((q, i) => { q.mocap = G.sampleLoop('Idle_Subtle', this.t + i); G.place(q, dt, q.x, 0, 0, 1.57); });\n    if (RD.over || AIHub.time() !== -Infinity) return; if (I.pressed('confirm') || I.pressed('start')) AIHub.answer('ready'); if (I.pressed('more')) AIHub.answer('more'); const c = I.clicked && I.clicked(); if (c) { const W = game.W, H = game.H; if (c[1] > H - 36 && c[1] < H - 14) { if (c[0] < W / 2) AIHub.answer('ready'); else AIHub.answer('more'); } } },\n  draw(r) { G.ROOMS.studio(r, game.real); const info = RD.info; if (this.rigs) this.rigs.forEach(q => { G.mat(r, q.x, 4, '#bfeee0', 24, 13); G.actor(r, q); }); this.tare.draw(r);\n    r.overlay(g => { G.drawLogo(g, r, r.W / 2, 8, 3); if (!info) return; const t = AIHub.time(), cd = RD.card || {}; if (t !== -Infinity && t < 0) { G.text(g, String(Math.ceil(-t / 1000)), r.W / 2, r.H * .4, G.COL.ACCD, { align: 'center', scale: 4, shadow: '#fff' }); return; } G.text(g, 'Morning Class. Stay steadiest over 3 exercises. Most points wins.', r.W / 2, 42, G.COL.INK, { align: 'center', shadow: '#fff' }); info.players.forEach((p, i) => { const q = this.rigs ? r.w(this.rigs[i].x, 0, 0) : [r.W / 2, r.H / 2], rd = (cd.ready || []).includes(p.id); G.text(g, p.name, q[0], q[1] + 16, p.color, { align: 'center', shadow: '#fff' }); if (rd) G.text(g, '✓', q[0], q[1] + 27, '#17a57e', { align: 'center', shadow: '#fff' }); }); G.text(g, RD.howto(), r.W / 2, r.H - 52, G.COL.INK, { align: 'center', shadow: '#fff' }); const left = cd.paused ? 'Waiting for more time' : cd.starting ? 'Starting' : cd.left != null ? Math.ceil(cd.left / 1000) + ' seconds left' : ''; G.text(g, left + (cd.asked ? '  (you asked for more time)' : cd.asking ? '  (someone asked for more time)' : ''), r.W / 2, r.H - 42, G.COL.MUT, { align: 'center', shadow: '#fff' }); const w = 84, y = r.H - 32; G.round(g, r.W / 2 - w - 4, y, w, 16, G.COL.ACC); G.text(g, G.promptLabel('confirm').split(' /')[0] + ' Ready', r.W / 2 - w / 2 - 4, y + 5, '#fff', { align: 'center' }); G.round(g, r.W / 2 + 4, y, w, 16, '#ffffff'); G.text(g, G.promptLabel('more').split(' /')[0] + ' More time', r.W / 2 + w / 2 + 4, y + 5, G.COL.INK, { align: 'center' }); }); } });\n// the session wrapper\nG.connectHub = async () => { const info = await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }); if (!info) { game.go('title'); return; } RD.setup(info); AIHub.on('card', c => { RD.card = c; }); AIHub.on('start', () => {}); AIHub.on('message', (d, from) => { if (d && d.t === 'g') { RD.ghosts[from] = d; if (typeof d.s === 'number' && from !== info.me) RD.scores[from] = d.s * (d.a + 1); } }); AIHub.on('leave', ({ id }) => { delete RD.ghosts[id]; if (RD.ghostRigs) delete RD.ghostRigs[id]; }); AIHub.on('time-up', () => RD.report()); AIHub.on('end', () => { RD.over = true; game.audio.stopMusic(); game.audio.mute(true); game.input.clear(); }); game.hook('input', dt => RD.tick(dt)); await game.booted; AIHub.ready(); };\nEOF\ncat > game/scenes/attract.js <<'EOF'\n// Attract Mode: nobody is here, so Tare shows the empty room around. Real scenes, the expert bot, cheats allowed, no saves touched.\nconst DEMO_LIST = [{ k: 'island' }, { k: 'body' }, ...['stork', 'flow', 'candle', 'squat', 'pushup', 'lunge', 'step', 'hoop', 'jog', 'slalom', 'tray', 'laundry'].map(id => ({ k: 'act', id })), { k: 'class' }, { k: 'results' }, { k: 'duel' }];\nG.Attract = { on: false, idle: 0, i: 0, visited: {}, lastM: -1,\n  start() { if (this.on) return; this.on = true; this.saved = G.state; this.savedSlot = G.slot; G.noSave = true; G.state = G.newMember('Nobody', { hair: 'ponytail', skin: 2, top: 1, bottom: 0 }); G.state.instructor = 'alder'; G.state.day = 3; G.state.ages = [71, 66, 60]; G.state.minutes = 31; G.state.age = 58; G.state.flags.checked = true; G.silentChat = false; this.i = 0; this.visited = {}; this.lineT = 2; this.subtitle = G.LINES.attractIn; this.subT = 4; this.run(); },\n  stop() { if (!this.on) return; this.on = false; G.noSave = false; G.state = this.saved; G.slot = this.savedSlot; G.talk.close(); this.idle = 0; game.input.consumeAll(); game.timeScale = 1; G.Dev.applyTime(); game.go('title', { back: true }, { fade: .15 }); },\n  next() { if (!this.on) return; this.i = (this.i + 1) % DEMO_LIST.length; this.run(); },\n  run() { const it = DEMO_LIST[this.i], star = id => G.regularRig(id, 2.1); this.visited[it.k + (it.id || '')] = true; G.talk.close(); this.t = 0; this.limit = 15; const loc = (rig) => [{ name: 'Nobody', local: true, bot: 'expert', rig, color: G.COL.CORAL }];\n    if (it.k === 'island') game.go('island', { demo: true }, { fade: .2 });\n    else if (it.k === 'body') game.go('bodycheck', { demo: true }, { fade: .2 });\n    else if (it.k === 'act') { const needs = { jog: 1.6, slalom: 1.2, laundry: 1.3 }[it.id] || 2.1; game.go('act_' + it.id, { mode: 'attract', limit: 15, cheat: true, contestants: loc(G.regularRig(['marisol', 'kevin', 'okafor', 'twins', 'gertrude'][this.i % 5], needs)), coach: this.i % 2 ? 'birch' : 'alder' }, { fade: .2 }); }\n    else if (it.k === 'class') game.go('act_stork', { mode: 'attract', limit: 15, cheat: true, slots: G.slots(4), contestants: ['gertrude', 'kevin', 'twins', 'marisol'].map((id, i) => ({ name: G.CAST[id].name, color: E.PLAYER_COLORS[i], local: i === 0, bot: 'expert', rig: G.regularRig(id, 1.5) })) }, { fade: .2 });\n    else if (it.k === 'results') game.go('demoresults', {}, { fade: .2 });\n    else if (it.k === 'duel') game.go('act_candle', { mode: 'attract', limit: 15, cheat: true, duel: true, seed: 5, slots: [{ x: -56, y: 0, size: 1.9 }], contestants: loc(G.regularRig('kevin', 1.9)), demoT: 62 }, { fade: .2 }); },\n  input(dt) { const I = game.input, sc = game.scene; const moved = I.mouse && I.mouse.t !== this.lastM; if (I.mouse) this.lastM = I.mouse.t; const stick = I.padMove && Math.hypot(I.padMove[0], I.padMove[1]) > .2, any = I.anyPressed() || stick || moved || (I.held && I.held.size > 0);\n    if (this.on) { if (any) { this.stop(); return; } if (!game.paused) { this.t += dt; this.lineT -= dt; if (this.lineT <= 0) { this.lineT = 6; this.subtitle = G.line('attract'); this.subT = 4; } this.subT -= dt; if ((game.sceneName === 'island' || game.sceneName === 'demoresults' || game.sceneName === 'bodycheck') && this.t > this.limit) this.next(); } return; }\n    if (any || game.paused || !sc || !sc.topLevel || G.inSession || (G.Dev && G.Dev.isOpen)) { this.idle = 0; return; } this.idle += dt; if (this.idle >= 10) { this.idle = 0; this.start(); } },\n  draw(r) { if (!this.on) return; r.overlay(g => { G.round(g, 8, r.H - 22, 40, 14, G.COL.CORAL); G.text(g, 'DEMO', 28, r.H - 19, '#fff', { align: 'center' }); G.drawLogo(g, r, 52 + 36, r.H - 24, 1); const s = G.source(game.input) === 'pad' || game.input.lastDevice === 'gamepad' ? 'Press any button' : 'Press any key'; const w = E.font.width(s) + 14; G.round(g, r.W - w - 8, r.H - 22, w, 14, '#ffffff'); G.text(g, s, r.W - w - 1, r.H - 19, G.COL.INK); if (this.subT > 0) { const t = this.subtitle, tw = E.font.width(t) + 16; G.round(g, (r.W - tw) >> 1, r.H - 44, tw, 16, '#ffffff'); G.text(g, t, r.W / 2, r.H - 40, G.COL.ACCD, { align: 'center' }); } }); } };\ngame.hook('input', dt => G.Attract.input(dt));\nG.scene('demoresults', { view: 'brawler', camera: { zoom: false },\n  enter() { this.t = 0; this.stamped = 0; this.stampT = 0; this.coins = []; this.reward = { minutes: 6, suggested: true }; this.ctx = { def: { name: 'Stork Stand' }, local: { pct: .94, stars: 3, detail: 'Steady 94%. Falls: 0.' } }; game.focus(0, 0, 18); G.music('morning'); },\n  update(dt) { this.t += dt; this.stampT += dt; if (this.stamped < 3 && this.stampT > .35 + this.stamped * .35) { this.stamped++; G.sfx('stamp'); G.sting('star' + this.stamped); } if (this.stampT > 1.5 && !this.coins.length) for (let i = 0; i < 6; i++) this.coins.push({ t: -i * .18 }); for (const k of this.coins) { const b = k.t; k.t += dt; if (b < .7 && k.t >= .7) { G.sfx('clink', { vol: .4 }); this.gulp = 1; } } this.gulp = Math.max(0, (this.gulp || 0) - dt * 5); if (this.t > 7) G.Attract.next(); },\n  draw(r) { G.ROOMS.studio(r, game.real); r.overlay(g => G.drawResults(g, r, this.ctx, this)); } });\nEOF\ncat > game/dev.js <<'EOF'\n// Dev Mode: reachable from the pause menu, in every scene, on every device. It docks on the left third while the game keeps running.\nconst pct = v => Math.round(v * 100) + '%';\nconst SLIDERS = [ ['Lean'], ['k', 'Response k', .3, 2, .05], ['c', 'Damping c', .3, 2, .05], ['s', 'Instability s', 0, 2, .05], ['A', 'Tremble A', 0, 3, .05], ['nf', 'Tremble speed', .3, 3, .05], ['ring', 'Ring scale', .5, 2, .05], ['push', 'Push strength', 0, 3, .05], ['stumble', 'Stumble at', .6, 2, .05], ['mouseReach', 'Mouse reach', .15, .6, .01], ['nudge', 'Nudge rate', .8, 4, .1],\n  ['Scoring'], ['star1', '1 star needs', .5, 1.5, .05], ['star2', '2 stars need', .5, 1.5, .05], ['star3', '3 stars need', .5, 1.5, .05], ['repTol', 'Rep tolerance', .5, 3, .05], ['rhythmWin', 'Rhythm windows', .5, 2, .05], ['fatigue', 'Fatigue', 0, 2, .05],\n  ['Cardio'], ['hoopBand', 'Hoop band', .6, 1.6, .05], ['jogBand', 'Jog band', .7, 1.4, .05], ['jogSpeed', 'Jog speed', .5, 2, .05],\n  ['Games'], ['slalomSpeed', 'Slalom speed', .5, 2, .05], ['slalomTurn', 'Slalom turn', .5, 2, .05], ['trayG', 'Tray gravity', 100, 900, 20], ['trayFric', 'Tray friction', 0, 1, .05], ['ropeS', 'Rope instability', 0, 3, .05], ['gust', 'Gust strength', 0, 3, .05],\n  ['World'], ['minutes', 'Minutes multiplier', 0, 5, .25] ];\nconst TIMES = [0, .25, .5, 1, 2], JUMPS = () => [...G.actOrder.flatMap(id => [['act_' + id, { mode: G.state ? 'free' : 'free', from: 'island' }, G.acts[id].name], ['act_' + id, { mode: 'free', tier: 1, from: 'island' }, G.acts[id].name + ' (2)']]), ...[1, 2, 3, 4, 5].map(d => ['day', d, 'Day ' + d]), ['title', null, 'Title'], ['island', null, 'Island'], ['bodycheck', null, 'Body Check'], ['evening', null, 'Evening'], ['recal', null, \"Tare's Day\"], ['games', { i: 0 }, 'Gentle Games'], ['act_candle', { mode: 'games', duel: true, festival: true, slots: [{ x: -56, y: 0, size: 1.9 }], onDone: () => game.go('ending') }, 'Grand Stillness'], ['ending', null, 'Ending'], ['about', null, 'About'], ['classroom', null, 'Class'], ['freeplay', null, 'Free Play']];\nG.ensureMember = () => { if (!G.state) { G.state = G.newMember('Gentle Doug', { hair: 'short', skin: 1, top: 0, bottom: 0 }); G.state.instructor = 'alder'; G.state.flags.checked = true; G.state.ages = [71]; } return G.state; };\nG.Dev = { isOpen: false, i: 1, top: 0, frozen: false, jump: 0, star: 3, bot: 0, posing: null, rows: null,\n  blocks() { if (!G.TOOLS.frozen) return false; if (G.TOOLS.step > 0) { G.TOOLS.step--; return false; } return true; },\n  applyTime() { game.timeScale = G.DEV.timeScale; },\n  build() { const rows = []; for (const s of SLIDERS) { if (s.length === 1) { rows.push({ head: s[0] }); continue; } const [k, label, min, max, step] = s; rows.push({ k, label, min, max, step }); }\n    rows.push({ label: 'Time scale', get: () => G.DEV.timeScale + 'x', adj: d => { const n = TIMES.indexOf(G.DEV.timeScale); G.DEV.timeScale = TIMES[clamp((n < 0 ? 3 : n) + d, 0, 4)]; this.applyTime(); } }, { label: 'Reset to defaults', act: () => { Object.assign(G.DEV, G.DEV_DEFAULTS); this.applyTime(); game.note('Defaults restored', 1); } });\n    rows.push({ head: 'Tools' }, { label: 'Jump', get: () => JUMPS()[this.jump][2], adj: d => { const n = JUMPS().length; this.jump = (this.jump + d + n) % n; }, act: () => this.doJump(JUMPS()[this.jump]) }, { label: 'Finish now', get: () => this.star + ' stars', adj: d => { this.star = clamp(this.star + d, 0, 3); }, act: () => this.finishNow() }, { label: 'Unlock all', act: () => { const st = G.ensureMember(); st.day = Math.max(st.day, 4); st.minutes = Math.max(st.minutes, 30); for (const id of G.actOrder) { st.best[id] = st.best[id] || { 0: { pct: .7, stars: 2 } }; } G.save(); game.note('Unlocked', 1); } }, { label: '+10 minutes', act: () => { const st = G.ensureMember(); st.minutes += 10; G.save(); } }, { label: 'Set Spine Age', get: () => (G.state ? G.state.age : '-'), adj: d => { const st = G.ensureMember(); st.age = clamp(st.age + d, 19, 71); } }, { label: 'Reset this member', act: () => { if (G.state) { const s = G.state; G.state = G.newMember(s.name, s.look); G.state.instructor = s.instructor; G.state.flags.checked = true; G.save(); game.note('Member reset', 1); } } }, { label: 'No stumbles', get: () => G.TOOLS.noStumble ? 'on' : 'off', act: () => { G.TOOLS.noStumble = !G.TOOLS.noStumble; } }, { label: 'Bot plays', get: () => G.TOOLS.bot || 'off', adj: d => { const L = [null, 'poor', 'average', 'good', 'expert']; this.bot = (this.bot + d + 5) % 5; G.TOOLS.bot = L[this.bot]; this.applyBot(); }, act: () => { this.bot = (this.bot + 1) % 5; G.TOOLS.bot = [null, 'poor', 'average', 'good', 'expert'][this.bot]; this.applyBot(); } }, { label: 'Plate trace', get: () => G.TOOLS.trace ? 'on' : 'off', act: () => { G.TOOLS.trace = !G.TOOLS.trace; } }, { label: 'Freeze', get: () => G.TOOLS.frozen ? 'on' : 'off', act: () => { G.TOOLS.frozen = !G.TOOLS.frozen; } }, { label: 'Frame step', act: () => { G.TOOLS.frozen = true; G.TOOLS.step = 1; } }, { label: 'Force attract', act: () => { this.close(); G.Attract.start(); } }, { label: 'Pose Viewer', act: () => this.openPose() }, { label: 'Log snapshot', act: () => { console.log(JSON.stringify(game.debug.snapshot())); game.note('Logged', 1); } }, { label: 'Close', act: () => this.close() }); this.rows = rows; },\n  applyBot() { const sc = game.scene, ctx = sc && sc.ctx; if (!ctx || !ctx.local) return; const c = ctx.local; c.bot = G.TOOLS.bot; c.lean = c.bot ? new G.LeanBot(c.bot, E.rng(ctx.seed + 3)) : null; if (c.bot && ctx.id === 'step' && c.rh && c.rh.started) { const spb = 60 / ctx.T.bpm / 4; c.s.plan = c.rh.notes.filter(n => !n.j).map(n => ({ lane: n.lane, step: n.step })); c.s.pi = 0; } },\n  open() { if (G.inSession) return; if (!this.rows) this.build(); game.resume(); this.isOpen = true; this.i = 1; this.top = 0; },\n  close() { this.isOpen = false; this.posing = null; game.input.consumeAll(); },\n  doJump(j) { const sc = j[0]; this.isOpen = true; G.ensureMember(); if (sc === 'day') { const st = G.state; st.day = j[1]; st.session = 0; st.flags.checked = true; st.ages = st.ages.length ? st.ages : [G.computeAge(st)]; game.go('island'); return; } game.go(sc, j[1] || undefined, { fade: 0 }); },\n  finishNow() { const sc = game.scene, ctx = sc && sc.ctx; if (!ctx || !sc.finish || sc.phase !== 'play') { game.note('Start an activity first', 1); return; } const d = ctx.def, want = this.star === 0 ? 0 : d.stars[this.star - 1] + .001, orig = d.result; ctx.forced = want; const self = d; d.result = function (cx, c) { d.result = orig; return { pct: want, detail: 'Finished from Dev Mode.' }; }; sc.finish(); },\n  openPose() { this.posing = { clip: 0, t: 0, rig: G.lookToRig({ hair: 'short', skin: 1, top: 1, bottom: 0 }, 1.5, {}) }; },\n  val(row) { return row.k ? (G.DEV[row.k]) : null; },\n  adjust(row, d, coarse) { if (row.k) { const st = row.step * (coarse ? 5 : 1); G.DEV[row.k] = clamp(Math.round((G.DEV[row.k] + d * st) / row.step) * row.step, row.min, row.max); G.DEV[row.k] = Math.round(G.DEV[row.k] * 1000) / 1000; } else if (row.adj) row.adj(d); },\n  input(dt) { if (!this.isOpen || game.paused) return; const I = game.input; for (const a of ['confirm', 'cancel', 'jump', 'interact']) I.suppress && I.suppress(a); const rp = a => I.repeat(a, .3, .06);\n    if (this.posing) { const P = this.posing, list = G.CLIPS; if (rp('devU')) P.clip = (P.clip + list.length - 1) % list.length; if (rp('devD')) P.clip = (P.clip + 1) % list.length; const c = G.clip(list[P.clip]); if (I.down('devL')) P.t = Math.max(0, P.t - dt); if (I.down('devR')) P.t = Math.min(c.dur, P.t + dt); P.rig.mocap = G.lib.sample(c, P.t); G.place(P.rig, dt, 0, 0, 0, 1.57); if (I.pressed('devA')) { const row = \"myPose: { name: 'My Pose', clip: '\" + list[P.clip] + \"', a: \" + P.t.toFixed(1) + \", b: \" + Math.min(c.dur, P.t + 1).toFixed(1) + \", tgt: 1.57 },\"; console.log(row); game.note('Row printed to the console', 1.5); } if (I.pressed('devB')) this.posing = null; return; }\n    const rows = this.rows, step = d => { let n = this.i; for (let k = 0; k < rows.length; k++) { n = (n + d + rows.length) % rows.length; if (!rows[n].head) break; } this.i = n; }; if (rp('devU')) step(-1); if (rp('devD')) step(1); const row = rows[this.i]; if (rp('devL')) this.adjust(row, -1, false); if (rp('devR')) this.adjust(row, 1, false); if (rp('devCL')) this.adjust(row, -1, true); if (rp('devCR')) this.adjust(row, 1, true); if (I.pressed('devA') && row.act) row.act(); if (I.pressed('devB')) this.close();\n    const p = I.pointer && I.pointer(), W3 = (game.W || 427) / 3; if (p && p[0] < W3) { I.suppressCode && I.suppressCode('Mouse0'); const n = Math.floor((p[1] - 22) / 12) + this.top; if (rows[n] && !rows[n].head && I.mouse.t !== this.lastM) { this.i = n; this.lastM = I.mouse.t; } const r2 = rows[this.i]; if (I.held && I.held.has('Mouse0') && r2.k) { const x0 = W3 * .52, x1 = W3 - 8, u = clamp((p[0] - x0) / (x1 - x0), 0, 1); G.DEV[r2.k] = Math.round((r2.min + (r2.max - r2.min) * u) / r2.step) * r2.step; G.DEV[r2.k] = Math.round(G.DEV[r2.k] * 1000) / 1000; } const c = I.clicked && I.clicked(); if (c && c[0] < W3 && r2.act) r2.act(); } },\n  draw(r) { if (this.posing) { const P = this.posing; r.overlay(g => { const W = r.W / 3; px.rect(g, 0, 0, W, r.H, '#f6fafa'); G.text(g, 'Pose Viewer', 8, 6, G.COL.ACCD); G.text(g, G.CLIPS[P.clip], 8, 20); G.text(g, 't ' + P.t.toFixed(2) + ' of ' + G.clip(G.CLIPS[P.clip]).dur.toFixed(2), 8, 32, G.COL.MUT); P.rig.draw(g, W / 2, r.H - 50, r.view); G.text(g, 'Up, down: clip', 8, r.H - 42, G.COL.MUT); G.text(g, 'Left, right: scrub', 8, r.H - 31, G.COL.MUT); G.text(g, 'Confirm: print row', 8, r.H - 20, G.COL.MUT); G.text(g, 'Back: close', 8, r.H - 9, G.COL.MUT); }); return; }\n    if (G.TOOLS.trace) { const sc = game.scene, ctx = sc && sc.ctx, b = ctx && ctx.local && ctx.local.bal; if (b) r.overlay(g => { G.drawPlate(g, b, r.W - 44, 60, 30, { t: game.real }); G.text(g, b.px.toFixed(2) + ' ' + b.py.toFixed(2) + ' ' + Math.round(b.steadiness * 100) + '% ' + b.falls, r.W - 8, 94, G.COL.INK, { align: 'right', shadow: '#fff' }); }); }\n    if (!this.isOpen) return; const rows = this.rows; r.overlay(g => { const W = Math.floor(r.W / 3); px.blend(g, .94, 'normal', () => px.rect(g, 0, 0, W, r.H, '#f6fafa')); px.rect(g, W, 0, 1, r.H, G.COL.ACC); G.text(g, 'Dev Mode', 8, 6, G.COL.ACCD); const vis = Math.floor((r.H - 24) / 12); if (this.i < this.top) this.top = this.i - 1; if (this.i >= this.top + vis) this.top = this.i - vis + 1; this.top = Math.max(0, this.top); for (let n = 0; n < vis; n++) { const q = rows[n + this.top]; if (!q) break; const y = 22 + n * 12, f = n + this.top === this.i; if (q.head) { G.text(g, q.head, 8, y + 2, G.COL.ACCD); px.rect(g, 8, y + 10, W - 16, 1, '#c8dde2'); continue; } if (f) G.round(g, 3, y - 1, W - 6, 11, G.COL.ACC, 3); const c = f ? '#fff' : G.COL.INK; if (q.k) { const d = G.DEV_DEFAULTS[q.k], v = G.DEV[q.k], x0 = Math.floor(W * .52), x1 = W - 8, u = (v - q.min) / (q.max - q.min), ud = (d - q.min) / (q.max - q.min); G.text(g, q.label, 8, y + 1, c); px.rect(g, x0, y + 4, x1 - x0, 1, f ? '#fff' : '#9db8c1'); px.rect(g, x0 + ud * (x1 - x0), y + 2, 1, 5, '#e0553a'); px.disc(g, x0 + u * (x1 - x0), y + 4, 2, f ? '#fff' : G.COL.ACC); } else { G.text(g, q.label, 8, y + 1, c); if (q.get) G.text(g, String(q.get()), W - 6, y + 1, c, { align: 'right' }); } } const cur = rows[this.i]; if (cur && cur.k) { const s = 'now ' + G.DEV[cur.k] + ', default ' + G.DEV_DEFAULTS[cur.k]; G.text(g, s, W + 6, 8, G.COL.INK, { shadow: '#fff' }); } }); } };\ngame.hook('input', dt => G.Dev.input(dt));\n// counting pauses, because Tare does\nlet wasPaused = false; game.hook('input', () => { const p = game.paused; if (p && !wasPaused && G.state && !G.Attract.on && !G.inSession) { G.state.pauses = (G.state.pauses || 0) + 1; } if (!p && wasPaused && G.state && !G.Attract.on && !G.inSession && game.scene && game.scene.pausable && !G.talk.open) { const n = G.state.pauses; if (n === 3) G.chat('tare', G.LINES.pause3, 3.5); else if (n > 3 && n % 3 === 0) G.chat('tare', G.line('pauseN'), 3); } wasPaused = p; });\nEOF\ncat > game/main.js <<'EOF'\n// Starting everything: assets, the debug handle, deep links (#hub, #act/stork/1, #day/3, #ending), boot, the hub wrapper.\nE.addAssets(window.ASSETS.whyfit);\ngame.debug = { snapshot() { const sc = game.scene || {}, ctx = sc.ctx, st = G.state, c = ctx && ctx.local; return { scene: game.sceneName, phase: sc.phase, activity: ctx && ctx.id, tier: ctx && ctx.tier, day: st && st.day, session: st && st.session, pct: c && c.pct, stars: c && c.stars, minutes: st && st.minutes, spineAge: st && st.age, lean: c && c.bal ? [c.bal.px, c.bal.py] : null, source: G.source(game.input), attract: G.Attract.on, music: game.settings.music }; } };\nconst link = () => { const h = (typeof location !== 'undefined' && location.hash || '').slice(1), p = h.split('/'); if (p[0] === 'act' && G.acts[p[1]]) { G.ensureMember(); return ['act_' + p[1], { mode: 'free', tier: +p[2] || 0, from: 'island' }]; } if (p[0] === 'day') { const st = G.ensureMember(); st.day = +p[1] || 1; return ['island']; } if (p[0] === 'hub') { G.ensureMember(); return ['island']; } if (p[0] === 'ending') { G.ensureMember(); return ['ending']; } if (G.scenes[p[0]]) { G.ensureMember(); return [p[0]]; } return ['title']; };\nconst first = G.inSession ? ['round'] : link();\ngame.start({ scenes: G.scenes, scene: first[0], data: first[1], boot: { title: 'WHY FIT', steps: [['Zeroing the scale', () => {}], ['Sanding the instructors', () => {}], ['Counting the ducks', () => {}], ['Telling the hippo', () => {}]], messages: ['Zeroing the scale', 'Sanding the instructors', 'Counting the ducks', 'Telling the hippo'], accent: '#2cc6e6' } });\nif (first[1] && !G.inSession) game.go(first[0], first[1], { fade: 0 });\nif (G.inSession) G.connectHub();\nEOF\npython3 - <<'EOF'\nimport re\np='game/scenes/session.js';s=open(p).read()\ns=s.replace(\"if (data.again) this.phase = 'count'; if (this.phase === 'count') this.countIn();\",\"if (data.again) this.phase = 'count'; if (this.phase === 'count') this.countIn(); if (this.phase === 'play' && mode !== 'round' && def.begin) def.begin(ctx); this.pausable = mode !== 'attract';\")\ns=s.replace(\"if (this.phase === 'play') { G.setHand(\",\"if (ctx.mode === 'round') { G.Round.step(this, dt); return; } if (this.phase === 'play') { G.setHand(\")\ns=s.replace(\"if (ctx.festival) G.drawFestivalBanner(g, r); });\",\"if (ctx.festival) G.drawFestivalBanner(g, r); if (ctx.mode === 'round') G.Round.overlay(g, r, ctx); });\")\ns=s.replace(\"pitch: 1 + Math.random() * .1\",\"pitch: 1 + G.rng() * .1\")\nopen(p,'w').write(s)\np='game/rigs.js';s=open(p).read()\ns=s.replace(\"this.hopT = 1 + Math.random();\",\"this.hopT = 1 + G.rng();\").replace(\"this.hopT = 1.2 + Math.random() * 2;\",\"this.hopT = 1.2 + G.rng() * 2;\")\nopen(p,'w').write(s)\np='game/activities/laundry.js';s=open(p).read()\ns=s.replace(\"ctx.say && Math.random() < .4 && ctx.say(\",\"G.rng() < .4 && ctx.say(\")\nopen(p,'w').write(s)\np='game/activities/candle.js';s=open(p).read()\ns=s.replace(\"stop(ctx) { if (ctx.duel) { ctx.won = ctx.her <= .001 && !ctx.local.s.out; } },\",\"stop(ctx) { if (ctx.duel) { ctx.won = ctx.her <= .001 && !ctx.local.s.out; } },\\n  onResults(ctx) { if (ctx.duel && G.state) { if (ctx.won) { G.state.duelWon = true; G.state.age = G.computeAge(G.state); } ctx.say('gertrude', ctx.won ? G.LINES.duelWin : G.LINES.duelLose, 5); G.save(); } },\")\ns=s.replace(\"ctx.dur = ctx.duel ? 90 : (ctx.limit || T.dur);\",\"ctx.dur = ctx.duel && !ctx.limit ? 90 : (ctx.limit || T.dur); if (ctx.data.demoT) ctx.t = 0;\")\ns=s.replace(\"if (ctx.duel) { const c = ctx.local; c.x = -56; c.rig.px = -56; } \",\"\")\nopen(p,'w').write(s)\np='game/ui.js';s=open(p).read()\ns=s.replace(\"const c = I.clicked && I.clicked();\\n    if (c) {\",\"const c = I.clicked && I.clicked();\\n    if (c && !(G.Dev && G.Dev.isOpen && c[0] < G.game.W / 3)) {\")\nopen(p,'w').write(s)\nEOF\ncat > build.mjs <<'EOF'\n// The one build command: node build.mjs [out.html]. Inlines everything; writes tests/hub/game.html too.\nimport { readFileSync, writeFileSync, existsSync, copyFileSync } from 'node:fs';\nconst out = process.argv[2] || '../WhyFit-WiiFit-claude-opus-5-5-medium-20261104-221447.html';\nexport const GAME_FILES = ['core.js', 'data/lines.js', 'data/poses.js', 'data/activities.js', 'data/charts.js', 'data/courses.js', 'data/trays.js', 'data/days.js', 'data/unlocks.js', 'balance.js', 'rigs.js', 'audio.js', 'ui.js', 'rooms.js', 'scenes/session.js', 'activities/hold.js', 'activities/candle.js', 'activities/rep.js', 'activities/step.js', 'activities/hoop.js', 'activities/jog.js', 'activities/slalom.js', 'activities/tray.js', 'activities/laundry.js', 'scenes/title.js', 'scenes/bodycheck.js', 'scenes/island.js', 'scenes/games.js', 'scenes/class.js', 'scenes/round.js', 'scenes/attract.js', 'dev.js', 'main.js'];\nexport const VENDOR = ['engine/my-3d2dge.js', 'vendor/readable.js', 'vendor/mocap.js', 'vendor/fitclips.js', 'vendor/whyfit-props.js'];\nconst safe = s => s.replace(/<\\/script/gi, '<\\\\/script');\nconst CSS = `html,body{margin:0;height:100%;background:#d8f3fb;overflow:hidden}#screen{width:100%;height:100%;display:block;image-rendering:pixelated;touch-action:none}\n@media (min-height:700px){.esh-mod{zoom:1.5}} @media (min-height:1000px){.esh-mod{zoom:2}}\n.esh button:focus,.esh input:focus{outline:3px solid var(--accent);outline-offset:2px}\n[data-sys=need]{background:rgba(5,3,12,.35)!important;align-items:flex-end!important}`;\nconst BOOT = `<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#f6fafa;color:#20404c;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#14a8c8;font-size:16px;letter-spacing:.08em\">WHY FIT</b><span>Zeroing the scale</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#20404c14\"><span style=\"display:block;width:30%;height:100%;background:#2cc6e6;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>`;\nconst iv = existsSync('../exit-interview.json') ? readFileSync('../exit-interview.json', 'utf8') : '{}';\nconst parts = [...VENDOR.map(f => readFileSync(f, 'utf8')), `window.G = { ABOUT: ${iv} };`, ...GAME_FILES.map(f => readFileSync('game/' + f, 'utf8'))];\nconst html = `<!doctype html><html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<script>${safe(readFileSync('vendor/session.js', 'utf8'))}</script>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Why Fit — a five-day stay, gently</title>\n<meta name=\"description\" content=\"A gentle, deadpan comedy about a five-day stay at a wellness retreat, where one skill, your balance, drives twelve short activities, coached by a needy talking scale.\">\n<meta name=\"theme-color\" content=\"#2cc6e6\">\n<meta name=\"hub:type\" content=\"Game\"><meta name=\"hub:players\" content=\"1–4\"><meta name=\"hub:source\" content=\"Wii Fit\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"Stay steadiest over 3 exercises; most points wins\">\n<meta name=\"hub:session-howto\" content=\"Lean: left stick, WASD or mouse. Breathe: R2, Space or click\">\n<style>${CSS}</style></head><body>\n${BOOT}\n<canvas id=\"screen\"></canvas>\n${parts.map(p => `<script>${safe(p)}</script>`).join('\\n')}\n</body></html>`;\nif (process.argv[1].endsWith('build.mjs')) { writeFileSync(out, html); copyFileSync(out, 'tests/hub/game.html'); console.log('built ' + out + ' ' + Math.round(html.length / 1024) + ' KB'); }\nEOF\nsed -i \"s/^const G = window.G = window.G || {};/const G = window.G = window.G || {};/\" game/core.js\nnode build.mjs 2>&1 | tail -2; grep -n \"scene, data\\|hooks.data\\|o.data\" engine/my-3d2dge.js | head -3 | cut -c1-200","description":"Write remaining scenes, dev panel, main and build script"}}}
