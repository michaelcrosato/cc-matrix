{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjEEbqPNw568MpfQbAyW","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":21534,"cache_read_input_tokens":219018,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":21534},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6a88ba50-da75-48c3-bde0-396ebfab72e9","uuid":"db73af39-e7a9-49e8-a627-c81f9f676b56","timestamp":"2026-11-05T05:29:35.732Z","request_id":"req_011CgjEEbQLCqa23XgTVXjW7","thinking_duration_ms":71445,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjEEbqPNw568MpfQbAyW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FJs6MeSak95pouR2eerXDg","name":"Bash","input":{"command":"cat > game/activities/candle.js <<'EOF'\n// Quiet Candle, and the Grand Stillness duel. The flame reacts to the speed of the dot, not where it is.\nconst DUEL_BITS = [{ at: 10, id: 'gull', f: 3.5 }, { at: 25, id: 'blender', f: 4 }, { at: 40, id: 'conga', f: 4.5 }, { at: 55, id: 'fireworks', f: 4 }, { at: 68, id: 'tare', f: 4.5 }, { at: 80, id: 'goose', f: 5 }];\nG.activity({ id: 'candle', family: 'candle', discipline: 'Stillness', name: 'Quiet Candle', tierName: 'With Company', class: true, hub: true, coachKey: 'hold', song: 'yoga',\n  says: 'Sit. Keep the dot in the ring and move it slowly. Fast corrections hurt the flame. Thoughts will come. You may not leave.',\n  controls: (src, lean) => [[lean, 'Correct gently']],\n  prompts: () => [['lean', 'Correct gently']],\n  setup(ctx) { const T = ctx.T; ctx.dur = ctx.duel ? 90 : (ctx.limit || T.dur); ctx.thT = ctx.duel ? 99 : 4; ctx.thoughts = []; ctx.time = 0; ctx.her = 1; ctx.bits = ctx.duel ? DUEL_BITS.map(b => Object.assign({}, b)) : (T.extra ? T.extra.map((id, i) => ({ at: 15 + i * 22, id, f: 4 })) : []); ctx.show = {};\n    for (const c of ctx.contestants) { G.setupBal(ctx, c, G.SETS.candle); c.s.flame = 1; c.s.sum = 0; c.s.n = 0; c.s.relit = false; c.s.out = false; c.s.pen = 0; c.bal.onFall = () => { c.s.flame -= .3; }; }\n    if (ctx.duel) { ctx.gert = G.regularRig('gertrude', 1.9); ctx.gert.wear = G.CAST.gertrude.wear; ctx.gullB = G.Blobs.gull(); ctx.goose = G.Blobs.pigeon(); } ctx.fires = []; },\n  botFill(ctx, c, skill, dt) { G.leanBotFill(ctx, c, dt); },\n  addThought(ctx, text, f) { const a = ctx.rng() * 6.283; ctx.thoughts.push({ text, x: Math.cos(a), y: Math.sin(a), t: 2.5, f, age: 0, a }); },\n  update(dt, ctx) { const T = ctx.T, loc = ctx.local; ctx.thT -= dt;\n    if (ctx.thT <= 0) { ctx.thT += T.thoughtEvery; this.addThought(ctx, G.pick(G.LINES.thoughts, ctx.rng), lerp(T.thoughtF[0], T.thoughtF[1], ctx.rng())); }\n    for (const b of ctx.bits) if (!b.done && ctx.t >= b.at) { b.done = true; ctx.show[b.id] = 6; this.addThought(ctx, G.LINES.duelBits[b.id], b.f); G.sfx(b.id === 'gull' ? 'gull' : b.id === 'blender' ? 'blender' : b.id === 'goose' ? 'goose' : b.id === 'fireworks' ? 'firework' : 'tick'); if (b.id === 'fireworks') { game.flash('#ffe0a0', .2, .4); for (let i = 0; i < 5; i++) ctx.fires.push({ x: ctx.rng(), y: ctx.rng() * .4, t: i * .5, c: G.pick(['#ff7a59', '#f5c84b', '#2cc6e6', '#e85d8a'], ctx.rng) }); } if (b.id === 'tare') { for (let i = 0; i < 6; i++) game.after(i * .32, () => G.babble('TARE', 'a')); } }\n    for (const k in ctx.show) ctx.show[k] -= dt;\n    let fx = 0, fy = 0; for (const th of ctx.thoughts) { th.age += dt; th.t -= dt; if (th.t > 0) { fx += th.x * th.f; fy += th.y * th.f; } } ctx.thoughts = ctx.thoughts.filter(t => t.age < 4);\n    if (loc && !loc.bot && !ctx.warned && ctx.t >= 20 && !loc.intent.touched && !ctx.duel) { ctx.warned = true; ctx.say('tare', G.line('candleUntouched'), 5); }\n    let alive = false;\n    for (const c of ctx.contestants) { const s = c.s, b = c.bal; if (s.out) continue; alive = true; b.step(dt, c.intent.ux, c.intent.uy, { fx, fy });\n      const sp = Math.hypot(b.vx, b.vy); if (sp > .55) { s.flame -= .4 * dt; if (c.local) { s.fl = (s.fl || 0) - dt; if (s.fl <= 0) { s.fl = .3; G.sfx('flick'); } } } if (b.inRing) s.flame = Math.min(1, s.flame + .12 * dt); if (!b.inRing && b.lean > .6) s.flame -= .05 * dt;\n      s.sum += Math.max(0, s.flame); s.n++;\n      if (s.flame <= 0) { if (!s.relit && !ctx.cheat) { s.relit = true; s.flame = .5; s.pen = .15; G.sfx('stamp', { vol: .2 }); if (c.local) ctx.say('tare', 'I relit it. Please do not tell the candle.', 3); } else if (ctx.cheat) s.flame = .6; else { s.out = true; s.flame = 0; } } }\n    if (ctx.duel && ctx.t > 75 && loc.s.flame > .5) ctx.her = Math.max(0, ctx.her - dt / 12);\n    if (!alive || ctx.t >= ctx.dur) ctx.done = true; },\n  stop(ctx) { if (ctx.duel) { ctx.won = ctx.her <= .001 && !ctx.local.s.out; } },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; for (const c of ctx.contestants) { c.rig.wob = [c.bal.px * .6, c.bal.py * .6]; c.rig.mocap = c.bal.stumbleT > 0 ? G.sampleLoop('Dizzy', ctx.time) : G.sampleLoop('Meditate', ctx.time * .4); G.place(c.rig, dt, c.x, c.y, 0, 1.57); }\n    if (ctx.gert) { ctx.gert.mocap = G.sampleLoop('Meditate', ctx.time * .3); G.place(ctx.gert, dt, 66, -4, 0, 1.3); ctx.gullB.update(dt, { flap: 1 }); ctx.goose.update(dt, { flap: 0, walk: 1 }); } },\n  result(ctx, c) { const s = c.s, st = c.bal.steadiness, mf = s.n ? s.sum / s.n : 0; return { pct: .6 * st + .4 * mf - s.pen, detail: ctx.duel ? (ctx.won ? 'Her candle went out. She did not seem surprised.' : 'Her candle is still lit. It has been lit since Thursday.') : 'Steady ' + Math.round(st * 100) + '%. Mean flame ' + Math.round(mf * 100) + '%.' }; },\n  draw(r, ctx) { const t = game.real; if (ctx.duel) { G.ROOMS.raft(r, t); r.shape('whyfit:lantern-glass', -100, -18, 0); r.shape('whyfit:lantern-glass', 104, -18, 0); r.shape('whyfit:lantern-glass', -106, 26, 0); r.shape('whyfit:lantern-glass', 110, 26, 0); game.lights.add(-100, -18, 18, 70, .8, { color: '#ffc070' }); game.lights.add(104, -18, 18, 70, .8, { color: '#ffc070' }); } else { G.ROOMS.deck(r, t); G.PROPS.fern(r.ctx, r.W * .14, r.w(0, -30, 0)[1], t); G.PROPS.fern(r.ctx, r.W * .86, r.w(0, -30, 0)[1], t); }\n    const cand = (x, y, fl) => { r.queue(x, y + 22, 0, g => { const p = r.w(x, y + 22, 0); G.PROPS.candle(g, p[0], p[1], Math.max(0, fl), game.real); }, { emissive: true }); if (fl > 0) game.lights.add(x, y + 22, 12, 34 + fl * 26, .7, { color: '#ffc070' }); };\n    if (ctx.duel) { const c = ctx.local; c.x = -56; c.rig.px = -56; } for (const c of ctx.contestants) { if (!ctx.duel) G.mat(r, c.x, c.y + 4, '#e6dcff', 26 * c.slot.size / 2.1, 14); cand(c.x, c.y, c.s.flame); G.actor(r, c.rig, { shadow: 8 }); }\n    if (ctx.gert) { cand(66, -4, ctx.her); G.actor(r, ctx.gert); const sh = ctx.show;\n      if (sh.gull > 0) r.actor(-20, 6, 8, (g, ox, oy) => ctx.gullB.draw(g, ox, oy, r.view));\n      if (sh.goose > 0) r.actor(30 - (6 - sh.goose) * 6, 22, 0, (g, ox, oy) => ctx.goose.draw(g, ox, oy, r.view));\n      if (sh.blender > 0) r.queue(-120, -10, 0, g => { const p = r.w(-120, -10, 0); G.PROPS.blender(g, p[0] + Math.sin(game.real * 40), p[1]); });\n      if (sh.conga > 0) for (let i = 0; i < 5; i++) { r.queue(-100 + (6 - sh.conga) * 30 + i * -16, -20, 0, g => { const x = -100 + (6 - sh.conga) * 30 + i * -16, p = r.w(x, -20, 0), hop = Math.abs(Math.sin(game.real * 6 + i)) * 3; px.rect(g, p[0] - 3, p[1] - 14 - hop, 6, 14, ['#ff7a59', '#2cc6e6', '#f5c84b', '#7bd389', '#c79be8'][i]); px.disc(g, p[0], p[1] - 17 - hop, 3, '#f0c8a0'); }); } }\n    r.overlay(g => { for (const f of ctx.fires) { const u = (ctx.t - (ctx.fireBase || 55)) - f.t; if (u > 0 && u < 1.2) for (let i = 0; i < 10; i++) { const a = i / 10 * 6.283, d = u * 26; px.rect(g, f.x * r.W + Math.cos(a) * d, 8 + f.y * r.H * .5 + Math.sin(a) * d, 2, 2, f.c); } } });\n    G.drawGhosts(r, ctx); },\n  hud(g, r, ctx) { G.hudTop(g, r, null, G.fmtT(ctx.dur - ctx.t)); G.drawPlates(g, r, ctx);\n    if (ctx.contestants.length === 1) { const f = Math.max(0, ctx.local.s.flame), x = 12, w = 72, y = r.H - 30; G.round(g, x, y, w + 6, 10, '#ffffff'); if (f > .02) px.rect(g, x + 3, y + 3, w * f, 4, f > .4 ? '#f5a742' : '#e0553a'); G.text(g, 'Flame', x + 3, y - 10, G.COL.INK); if (ctx.duel) { const y2 = y - 24; G.round(g, x, y2, w + 6, 10, '#ffffff'); if (ctx.her > .02) px.rect(g, x + 3, y2 + 3, w * ctx.her, 4, '#c79be8'); G.text(g, 'Gertrude', x + 3, y2 - 10, '#fff'); } }\n    for (const th of ctx.thoughts) { const fade = th.age < .3 ? th.age / .3 : th.age > 3.5 ? (4 - th.age) / .5 : 1; if (fade <= .2) continue; const w = Math.min(170, E.font.width(th.text) + 16), lines = E.font.wrap(th.text, w - 12), h = lines.length * 10 + 8, cx = r.W / 2 + th.x * r.W * .3, cy = 62 - th.y * 24 - th.age * 2; G.round(g, cx - w / 2 + 1, cy + 1, w, h, '#b9cfd6', 6); G.round(g, cx - w / 2, cy, w, h, '#ffffff', 6); lines.forEach((l, i) => G.text(g, l, cx, cy + 4 + i * 10, G.COL.INK, { align: 'center' })); px.disc(g, cx, cy + h + 3, 2, '#ffffff'); } },\n  ghost(ctx) { const b = ctx.local.bal; return { l: [b.px, b.py], s: Math.round(Math.max(0, .6 * b.steadiness + .4 * (ctx.local.s.n ? ctx.local.s.sum / ctx.local.s.n : 0) - ctx.local.s.pen) * 1000) }; } });\nEOF\ncat > game/activities/rep.js <<'EOF'\n// The Rail: one code path, three data rows. Your lean IS the body: holding the stick halfway holds you halfway.\nconst REP_LABEL = v => v >= .8 ? 'Perfect' : v >= .4 ? 'Good' : 'Late';\nconst beadAt = (T, u) => { const a = T.down, b = T.hold, c = T.up; if (u < a) return u / a; if (u < a + b) return 1; return Math.max(0, 1 - (u - a - b) / c); };\nconst repDef = (id, name, says, sayT, extra) => G.activity(Object.assign({ id, family: 'rep', discipline: 'Strength', name, tierName: 'Slow Down, Quick Up', coachKey: 'strength', song: 'iron', says, tierSays: sayT,\n  controls: (src, lean) => [[lean, extra.side ? 'Your lean is your lunge' : 'Your lean is your depth']],\n  prompts: () => [['lean', extra.side ? 'Lean left and right' : 'Pull back to go down']],\n  setup(ctx) { const T = ctx.T; ctx.reps = T.reps; ctx.len = T.down + T.hold + T.up; ctx.rep = 0; ctx.u = 0; ctx.bead = 0; ctx.time = 0; ctx.bonus = false; ctx.flash = null;\n    for (const c of ctx.contestants) { G.setupBal(ctx, c, G.SETS[extra.side ? 'repSide' : 'rep'], { stumbleAt: 9, noFall: true, noGentle: true }); c.s.scores = []; c.s.err = 0; c.s.n = 0; c.s.form = 0; c.s.fn = 0; c.s.mark = null; c.s.markT = 0; c.depth = 0; }\n    G.makeCoach(ctx); ctx.prop = G.rng; },\n  sideOf: (ctx, rep) => rep % 2 ? -1 : 1,\n  botFill(ctx, c, skill, dt) { const T = ctx.T, lead = { poor: -.34, average: -.16, good: -.04, expert: .02 }[skill] || 0, amp = { poor: .34, average: .1, good: .03, expert: .01 }[skill] || 0;\n    c.s.bt = (c.s.bt || 0) + dt; const u = ctx.u + lead + .14; let n = ctx.rep; let uu = u; if (uu >= ctx.len) { uu -= ctx.len; n++; } else if (uu < 0) { uu += ctx.len; n--; } const bd = beadAt(T, uu), wig = amp * Math.sin(c.s.bt * 2.3 + c.i) + amp * .6 * Math.sin(c.s.bt * 4.1), f = c.bal;\n    if (extra.side) { c.intent.ux = clamp((n % 2 ? -1 : 1) * bd + wig, -1, 1); c.intent.uy = clamp(-f.py * 1.4 - f.vy * .3, -1, 1); } else { c.intent.uy = clamp(-bd + wig, -1, 1); c.intent.ux = clamp(-f.px * 1.4 - f.vx * .3, -1, 1); } },\n  update(dt, ctx) { const T = ctx.T; ctx.u += dt; const fat = ctx.rep >= ctx.reps * .6 ? Math.min(1, (ctx.rep - ctx.reps * .6) / (ctx.reps * .4 + .01) + .3) * G.DEV.fatigue : 0;\n    ctx.fat = fat; ctx.bead = beadAt(T, ctx.u); const sgn = extra.side ? this.sideOf(ctx, ctx.rep) : 1;\n    for (const c of ctx.contestants) { const b = c.bal; b.step(dt, c.intent.ux, c.intent.uy, { A: 1 + fat * 3, k: 1 - fat * .22 }); c.depth = extra.side ? clamp(b.px * sgn, -1, 1) : clamp(-b.py, 0, 1); const e = Math.abs(c.depth - ctx.bead); c.s.err += e * dt; c.s.n += dt; const fo = Math.abs(extra.side ? b.py : b.px); c.s.form += fo * dt; c.s.fn += dt; if (c.s.markT > 0) c.s.markT -= dt; }\n    if (ctx.u >= ctx.len) { const tol = G.DEV.repTol; for (const c of ctx.contestants) { const m = c.s.err / (c.s.n || 1), v = clamp(1 - (m - .08 * tol) / (.27 * tol), 0, 1); c.s.scores.push(v); c.s.err = 0; c.s.n = 0; c.s.mark = REP_LABEL(v); c.s.markT = 1; if (c.local) { G.sfx(v >= .8 ? 'chime' : 'tick', { vol: .35, pitch: 1 + ctx.rep * .03 }); if (v >= .8 && c.input && c.input.rumble) c.input.rumble(.15, .08); G.grunt(G.coach().toUpperCase()); } }\n      ctx.rep++; ctx.u -= ctx.len;\n      if (ctx.rep >= ctx.reps) { const c = ctx.local, mean = c.s.scores.reduce((a, b) => a + b, 0) / c.s.scores.length; if (!ctx.bonus && mean > .8 && ctx.contestants.length === 1 && !ctx.limit && !ctx.short) { ctx.bonus = true; ctx.reps += 2; ctx.say(G.coach(), G.LINES.twoMore, 3); } else ctx.done = true; } }\n  },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const D = G.ACTDATA[id], shake = (ctx.fat || 0) * .03;\n    for (const c of ctx.contestants) { const rig = c.rig, b = c.bal, depth = Math.max(0, c.depth || 0); rig.wob = [(extra.side ? b.py : b.px) * .55 + Math.sin(ctx.time * 42 + c.i) * shake, Math.sin(ctx.time * 37) * shake];\n      if (extra.side) { rig.mocap = null; const sgn = (ctx.rep || 0) % 2 ? -1 : 1; rig.body = G.moves.sideLunge(clamp(b.px, -1, 1)); G.place(rig, dt, c.x, c.y, 0, D.tgt); }\n      else { rig.body = null; const clip = G.clip(D.clip), t1 = D.t1 !== undefined ? D.t1 : clip.dur * D.t1Frac; rig.mocap = G.lib.sample(clip, lerp(D.t0, t1, depth)); G.place(rig, dt, c.x, c.y, 0, D.tgt); } }\n    if (ctx.coachRig) { const r2 = ctx.coachRig; if (extra.side) { r2.mocap = null; r2.body = G.moves.sideLunge(ctx.bead * ((ctx.rep || 0) % 2 ? -1 : 1)); } else { r2.body = null; const clip = G.clip(D.clip), t1 = D.t1 !== undefined ? D.t1 : clip.dur * D.t1Frac; r2.mocap = G.lib.sample(clip, lerp(D.t0, t1, ctx.bead)); } G.place(r2, dt, -98, -14, 0, D.tgt); } },\n  result(ctx, c) { const sc = c.s.scores, mean = sc.length ? sc.reduce((a, b) => a + b, 0) / Math.max(sc.length, ctx.limit || ctx.short ? sc.length : ctx.T.reps) : 0, form = c.s.fn ? c.s.form / c.s.fn : 0, pen = Math.min(.3, form * .6); return { pct: mean * (1 - pen), detail: sc.length + ' reps. Form ' + Math.round((1 - pen) * 100) + '%.' + (ctx.bonus ? ' Two more were added.' : '') }; },\n  draw(r, ctx) { G.ROOMS.iron(r, game.real); const g = r.ctx; const base = r.w(0, -38, 0); G.PROPS.cooler(g, r.W * .9, base[1] + 8); for (let i = 0; i < 4; i++) G.PROPS.dumbbell(g, r.W * .1 + i * 12, base[1] + 6 + (i % 2) * 2); for (const c of ctx.contestants) G.mat(r, c.x, c.y + 4, '#d7ecf4', 30 * c.slot.size / 2.1, 14); G.mat(r, -98, -10, '#ffe2b8', 24, 10); G.drawCoach(r, ctx); for (const c of ctx.contestants) G.actor(r, c.rig, { shadow: 8 }); G.drawGhosts(r, ctx); },\n  hud(g, r, ctx) { G.hudTop(g, r, 'Rep ' + Math.min(ctx.rep + 1, ctx.reps) + ' of ' + ctx.reps, null); const one = ctx.contestants.length === 1;\n    for (const c of ctx.contestants) { const q = r.w(c.x, c.y, 0), bx = one ? q[0] + 64 : q[0] + 22, top = one ? 70 : r.H - 104, h = one ? r.H - 130 : 60;\n      if (extra.side) { const w = 170, x0 = r.W / 2, y0 = r.H - 54, sgn = this.sideOf(ctx, ctx.rep); G.round(g, x0 - w / 2 - 4, y0 - 4, w + 8, 9, '#ffffff'); px.rect(g, x0 - w / 2, y0, w, 1, '#c8dde2'); px.disc(g, x0 + ctx.bead * sgn * w / 2, y0, 5, G.COL.ACC); px.disc(g, x0 + c.bal.px * w / 2, y0, 3, G.COL.CORAL); }\n      else { G.round(g, bx - 5, top - 4, 10, h + 8, '#ffffff', 4); px.rect(g, bx, top, 1, h, '#c8dde2'); px.disc(g, bx, top + ctx.bead * h, one ? 5 : 3, G.COL.ACC); px.disc(g, bx, top + (c.depth || 0) * h, one ? 3 : 2, G.COL.CORAL); }\n      if (c.s.markT > 0) G.text(g, c.s.mark, q[0], q[1] - (one ? 76 : 58) - (1 - c.s.markT) * 8, c.s.mark === 'Perfect' ? '#17a57e' : c.s.mark === 'Good' ? G.COL.ACCD : '#e0553a', { align: 'center', scale: one ? 2 : 1, shadow: '#fff' }); }\n    if (!one) G.drawPlates(g, r, ctx); else { const c = ctx.local, x = 12, y = r.H - 16, form = Math.abs(extra.side ? c.bal.py : c.bal.px); G.text(g, form > .25 ? 'Your form is drifting' : 'Form: good', x, y, form > .25 ? '#e0553a' : G.COL.INK); } },\n  ghost(ctx) { const c = ctx.local, sc = c.s.scores; return { l: [c.bal.px, c.bal.py], p: c.depth || 0, s: Math.round((sc.length ? sc.reduce((a, b) => a + b, 0) / sc.length : 0) * 1000) }; },\n  ghostPose(rig, st, dt) { const D = G.ACTDATA[id]; if (extra.side) { rig.mocap = null; rig.body = G.moves.sideLunge(st.l ? st.l[0] : 0); } else { rig.body = null; const clip = G.clip(D.clip), t1 = D.t1 !== undefined ? D.t1 : clip.dur * D.t1Frac; rig.mocap = G.lib.sample(clip, lerp(D.t0, t1, st.p || 0)); } return D.tgt; }\n}, extra));\nrepDef('squat', 'Squat Rail', 'A bead rides the rail. Your lean is your squat, so match it. You may hold halfway. You may not skip the bottom.', 'Three seconds down, a hold, one second up. Please do not thank us.', { class: true, hub: true });\nrepDef('pushup', 'Push-Up', 'Your lean is your push-up. Pull back to go low. The bead sets the tempo. The floor sets the rest.', 'Three seconds down, a hold, one second up. The floor remains interested.', { hub: true });\nrepDef('lunge', 'Side Lunge', 'Lean left and right with the bead. Your lean is your lunge. You may not lunge forward. That is a different room.', 'Three seconds out, a hold, one second back. Both sides, please.', { side: true });\nEOF\ncat > game/activities/step.js <<'EOF'\n// Step Class: E.Rhythm on a chart. Music is 10%, so the beat never depends on it: a click on the sfx bus, a count in gibberish.\nconst STEP_COUNT = ['one', 'tu', 'tri', 'for'];\nG.activity({ id: 'step', family: 'step', discipline: 'Cardio', name: 'Step Class', tierName: 'All Four Arrows', class: true, hub: true, coachKey: 'cardio', song: 'morning',\n  says: 'Press with each arrow as it reaches the line. Your step is your press. You may not step early. The class will know.',\n  tierSays: 'All four arrows at a brisker pace. Everybody behind you can see your feet.',\n  controls: (src, lean, L) => src === 'pad' ? [['D-pad or stick', 'Step with the arrows']] : src === 'mouse' ? [['Buttons', 'Left and right'], ['Wheel', 'Up and down']] : [['Arrows or WASD', 'Step with the arrows']],\n  prompts: (ctx) => [[ctx.tier ? 'stepU' : 'stepL', 'Step']],\n  setup(ctx) { const T = ctx.T, chart = ctx.short ? G.CHARTS.short : G.CHARTS[T.chart], parts = chart.order.split(/\\s+/).length, spb = 16; const base = G.SONGS[T.song]; ctx.song = Object.assign({}, base, { loop: false, len: parts * spb }); ctx.dur = ctx.limit || (parts * spb) / 4 / T.bpm * 60;\n    const w = G.DEV.rhythmWin, windows = { perfect: 45 * w, great: 90 * w, good: 135 * w };\n    for (const c of ctx.contestants) { c.rh = new E.Rhythm(game, { song: ctx.song, chart, lanes: ['_a', '_b', '_c', '_d'], windows, life: 1, lead: 1.6 }); c.rh.on.fail = null; c.s.k = 0; c.s.tk = 0; c.s.side = 0; }\n    ctx.time = 0; ctx.beat = 0; G.makeCoach(ctx); ctx.regs = []; if (ctx.contestants.length === 1) for (const id of ['marisol', 'kevin', 'twins']) ctx.regs.push({ rig: G.regularRig(id, 1.5), k: 0, x: { marisol: -40, kevin: 44, twins: 118 }[id] }); },\n  begin(ctx) { let first = true; for (const c of ctx.contestants) { if (first) { c.rh.start(); first = false; } else { c.rh.reset(); c.rh.started = true; } c.rh.life = 1; } G.__stepBeat = game.audio.onBeat(b => { ctx.beat = b; G.sfx(b % 4 === 0 ? 'beatUp' : 'beat'); if (ctx.mode !== 'round') { const w = STEP_COUNT[b % 4]; for (let i = 0; i < w.length; i++) G.babble(ctx.coachId, w[i], { at: i * .05 }); } for (const q of ctx.regs) q.tk = 1; if (ctx.coachRig) ctx.coachK = 1; });\n    for (const c of ctx.contestants) if (c.bot) { const sk = { poor: [105, .22], average: [60, .06], good: [34, .015], expert: [14, 0] }[c.bot], R = E.rng(ctx.seed + c.i * 5 + 77); const spb = 60 / ctx.T.bpm / 4; c.s.plan = c.rh.notes.map(n => { let d = 0; for (let i = 0; i < 3; i++) d += R() - .5; const miss = R() < sk[1]; return { lane: n.lane, step: n.step + (d * sk[0] * 1.2 / 1000) / spb, miss }; }).filter(q => !q.miss); c.s.pi = 0; } },\n  stop() { if (G.__stepBeat) { G.__stepBeat.cancel(); G.__stepBeat = null; } },\n  cleanup(ctx) { this.stop(ctx); },\n  botFill(ctx, c) { const p = game.audio.pos.step; c.intent.press = [false, false, false, false]; while (c.s.plan && c.s.pi < c.s.plan.length && c.s.plan[c.s.pi].step <= p) { c.intent.press[c.s.plan[c.s.pi].lane] = true; c.s.pi++; } },\n  update(dt, ctx) { for (const c of ctx.contestants) { const rh = c.rh; rh.life = 1; for (let l = 0; l < 4; l++) if (c.intent.press[l]) { const hit = rh.hit(l); c.s.tk = 1; c.s.side = l; if (c.local && hit) { G.sfx('tick', { vol: .25, pitch: 1.4 }); if (c.input && c.input.rumble) c.input.rumble(.12, .05); } } rh.update(); }\n    if (ctx.contestants[0].rh.done || ctx.t >= ctx.dur + .5) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const up = (o, key) => { o[key] = Math.max(0, (o[key] || 0) - dt * 2.2); return Math.sin(Math.min(1, o[key]) * Math.PI); };\n    for (const c of ctx.contestants) { const k = up(c.s, 'tk'); c.rig.mocap = null; c.rig.wob = [0, 0]; c.rig.body = k > .03 ? G.moves.stepUp(k) : null; G.place(c.rig, dt, c.x, c.y, 0, 1.4, k > .03 ? {} : {}); }\n    for (const q of ctx.regs) { const k = up(q, 'tk'); q.rig.mocap = null; q.rig.body = k > .03 ? G.moves.stepUp(k) : null; G.place(q.rig, dt, q.x, -26, 0, 1.4); }\n    if (ctx.coachRig) { const k = up(ctx, 'coachK'); ctx.coachRig.mocap = null; ctx.coachRig.body = k > .03 ? G.moves.stepUp(k) : null; G.place(ctx.coachRig, dt, -100, -22, 0, 1.4); } },\n  result(ctx, c) { const rh = c.rh, tot = rh.notes.filter(n => n.j && n.j !== 'call').length || 1, acc = rh.counts.perfect + rh.counts.great * .7 + rh.counts.good * .4, all = ctx.limit ? tot : rh.total; return { pct: acc / (all || 1), detail: 'Perfect ' + rh.counts.perfect + ', good ' + (rh.counts.great + rh.counts.good) + ', missed ' + rh.counts.miss + '.' }; },\n  draw(r, ctx) { G.ROOMS[ctx.festival ? 'festival' : 'pier'](r, game.real); const bench = (x, y, s = 1) => r.queue(x, y, 0, g => { const a = r.w(x, y, 0); px.rect(g, a[0] - 14 * s, a[1] - 6 * s, 28 * s, 3 * s, '#e0553a'); px.rect(g, a[0] - 14 * s, a[1] - 3 * s, 28 * s, 3 * s, '#20404c'); px.rect(g, a[0] - 12 * s, a[1], 4 * s, 2 * s, '#20404c'); px.rect(g, a[0] + 8 * s, a[1], 4 * s, 2 * s, '#20404c'); }, { bias: -4 });\n    for (const c of ctx.contestants) bench(c.x, c.y, c.slot.size / 1.5); for (const q of ctx.regs) { bench(q.x, -26); G.actor(r, q.rig, { shadow: 5 }); } if (ctx.coachRig) { bench(-100, -22, 1.2); G.actor(r, ctx.coachRig); } for (const c of ctx.contestants) G.actor(r, c.rig, { shadow: 7 }); G.drawGhosts(r, ctx);\n    if (ctx.festival) { for (let i = 0; i < 9; i++) { const x = -150 + i * 38, hop = Math.abs(Math.sin(game.real * 5 + i)) * 2; r.queue(x, -40, 0, g => { const p = r.w(x, -40, 0); px.rect(g, p[0] - 2, p[1] - 10 - hop, 4, 10, ['#c79be8', '#2cc6e6', '#f5c84b', '#7bd389'][i % 4]); px.disc(g, p[0], p[1] - 12 - hop, 2, '#f0c8a0'); }); } } },\n  hud(g, r, ctx) { const n = ctx.contestants.length, one = n === 1; ctx.contestants.forEach(c => { const q = r.w(c.x, c.y, 0), hx = one ? r.W / 2 + 96 : q[0]; if (c.rh.started) c.rh.draw(r, { x: hx, y: one ? r.H - 40 : r.H - 16, dir: 'down', len: one ? r.H - 90 : 90, gap: one ? 26 : 12, size: one ? 10 : 6, arrows: true }); if (!one) G.text(g, c.name, q[0], r.H - 112, c.color || G.COL.INK, { align: 'center' }); const j = c.rh.last; if (one && j && game.time - j.t < .5) G.text(g, j.j[0].toUpperCase() + j.j.slice(1), hx, 40, j.j === 'miss' ? '#e0553a' : '#17a57e', { align: 'center', scale: 2, shadow: '#fff' }); });\n    G.hudTop(g, r, one ? 'Combo ' + ctx.local.rh.combo : null, G.fmtT(ctx.dur - ctx.t)); },\n  ghost(ctx) { const c = ctx.local, rh = c.rh; return { p: c.s.tk || 0, s: Math.round((rh.counts.perfect + rh.counts.great * .7 + rh.counts.good * .4) / (rh.total || 1) * 1000) }; },\n  ghostPose(rig, st) { const k = Math.sin(Math.min(1, st.p || 0) * Math.PI); rig.mocap = null; rig.body = k > .03 ? G.moves.stepUp(k) : null; return 1.4; }\n});\nEOF\ncat > game/activities/hoop.js <<'EOF'\n// Hoop Hips: circle the lean to spin the hoop. Regulars throw more. More hoops score faster and want a little more speed.\nconst HOOP_C = ['#ff7a59', '#2cc6e6', '#f5c84b', '#7bd389', '#c79be8', '#e85d8a', '#5a7fe0'];\nG.activity({ id: 'hoop', family: 'hoop', discipline: 'Cardio', name: 'Hoop Hips', tierName: 'Faster Friends', class: true, hub: true, kbDirect: true, coachKey: 'cardio', song: 'jog',\n  says: 'Circle your lean to spin the hoop. Keep it just right. Catch more as they come. You may not use your hands. You will want to.',\n  controls: (src, lean, L) => [[src === 'keys' ? 'W D S A' : lean, src === 'keys' ? 'Tap round in a circle' : 'Circle it'], [L('catchL'), 'Catch left'], [L('catchR'), 'Catch right']],\n  prompts: () => [['lean', 'Circle'], ['catchL', 'Catch L'], ['catchR', 'Catch R']],\n  setup(ctx) { const T = ctx.T; ctx.dur = ctx.limit || T.dur; ctx.tossT = 2.5; ctx.tosses = []; ctx.time = 0; ctx.half = false; ctx.okafor = ctx.contestants.length === 1 ? G.regularRig('okafor', 1.6) : null; ctx.thrower = ctx.contestants.length === 1 ? G.regularRig('marisol', 1.5) : null;\n    let best = 0, h = 1, t = 0, nt = 2.5; for (; t < ctx.dur; t += .1) { if (t >= nt) { nt += T.tossEvery; h = Math.min(6, h + 1); } best += (1 + .5 * (h - 1)) * .1; } ctx.best = best;\n    for (const c of ctx.contestants) { c.s = { hoops: 1, ang: 0, w: 0, phase: 0, score: 0, out: 0, dirSum: 0, lastA: null, inBand: false, stackT: 0, dirUsed: 0, wr: 0 }; c.bal = new G.Balance(G.SETS.plain, E.rng(ctx.seed + c.i), { noFall: true, noGentle: true }); } },\n  band(ctx, c) { const T = ctx.T, s = c.s, kb = c.intent.source === 'keys' && !c.bot ? .6 : 1, B = G.DEV.hoopBand, add = T.perHoop * (s.hoops - 1); return [T.band[0] * kb * (2 - B) + add * kb, T.band[1] * kb * B + add * kb]; },\n  botFill(ctx, c, skill, dt) { const s = c.s, cfg = { poor: [6.5, 1.1, .45, .35], average: [8.6, .6, .8, .2], good: [9.6, .3, .95, .1], expert: [10.2, .15, 1, .05] }[skill]; c.s.bphase = (c.s.bphase || 0) + (cfg[0] + s.hoops * .22 + Math.sin(ctx.t * 1.1 + c.i) * cfg[1]) * dt * (ctx.half ? -1 : 1); c.intent.ux = Math.cos(c.s.bphase) * .95; c.intent.uy = Math.sin(c.s.bphase) * .95; c.intent.catchL = false; c.intent.catchR = false;\n    for (const q of ctx.tosses) if (!q.done[c.i] && !q.tried[c.i] && Math.abs(ctx.t - q.at) < cfg[3]) { q.tried[c.i] = true; if ((c.s.R || (c.s.R = E.rng(ctx.seed + 3 + c.i)))() < cfg[2]) { if (q.side < 0) c.intent.catchL = true; else c.intent.catchR = true; } } },\n  update(dt, ctx) { const T = ctx.T; ctx.tossT -= dt;\n    if (ctx.tossT <= 0) { ctx.tossT += T.tossEvery; ctx.tosses.push({ at: ctx.t + 1.4, from: ctx.t, side: ctx.rng() < .5 ? -1 : 1, c: G.pick(HOOP_C, ctx.rng), done: {}, tried: {} }); G.sfx('whoosh', { vol: .4 }); }\n    if (!ctx.half && ctx.t >= ctx.dur / 2) { ctx.half = true; ctx.say(G.coach(), G.LINES.otherWay, 2.5); G.sfx('boop', { vol: .3 }); }\n    for (const c of ctx.contestants) { const s = c.s, i = c.intent, l = Math.hypot(i.ux, i.uy); c.bal.step(dt, i.ux, i.uy);\n      if (l > .55) { const a = Math.atan2(i.uy, i.ux); if (s.lastA !== null) { let d = a - s.lastA; while (d > Math.PI) d -= 6.283; while (d < -Math.PI) d += 6.283; s.dirSum += d; s.wr = d / dt; } else s.wr = 0; s.lastA = a; } else { s.lastA = null; s.wr = 0; }\n      const e = Math.min(1, dt / .32); s.w += (s.wr - s.w) * e; s.phase += s.w * dt;\n      const sp = Math.abs(s.w), B = this.band(ctx, c), dirOk = !ctx.half || !s.firstDir || Math.sign(s.w) === -s.firstDir || sp < .1; if (!ctx.half && !s.firstDir && Math.abs(s.dirSum) > 6) s.firstDir = Math.sign(s.dirSum);\n      s.state = sp < B[0] ? 'slow' : sp > B[1] ? 'eager' : 'good'; s.inBand = s.state === 'good' && dirOk;\n      if (s.inBand) { s.score += (1 + .5 * (s.hoops - 1)) * dt; s.out = 0; } else { s.out += dt; if (s.out >= 1.5 && s.hoops > 1) { s.hoops--; s.out = 0; s.drop = 1; if (c.local) G.sfx('stumble', { vol: .3 }); } }\n      for (const q of ctx.tosses) { if (q.done[c.i]) continue; const press = q.side < 0 ? i.catchL : i.catchR; if (press && Math.abs(ctx.t - q.at) <= .25) { q.done[c.i] = true; if (s.hoops < 6) s.hoops++; if (c.local) { G.sfx('clink'); G.sfx('chime', { vol: .2 }); } } else if (ctx.t - q.at > .25) q.done[c.i] = 'miss'; }\n      if (c.local && s.inBand) { s.wh = (s.wh || 0) - dt; if (s.wh <= 0) { s.wh = .22; G.sfx('whirr', { vol: .15 + s.hoops * .03, pitch: .7 + sp * .07 }); } } }\n    ctx.tosses = ctx.tosses.filter(q => ctx.t - q.at < 1); if (ctx.t >= ctx.dur) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; for (const c of ctx.contestants) { c.rig.mocap = null; c.rig.wob = [0, 0]; const ph = c.s.phase, on = Math.abs(c.s.w) > .5; c.rig.body = G.moves.hula(on ? ph : ctx.time * 1.2); G.place(c.rig, dt, c.x, c.y, 0, 1.57); }\n    if (ctx.okafor) { const cheer = ctx.local.s.inBand; ctx.okafor.mocap = G.sampleLoop(cheer ? 'Cheering_Two_Hands' : 'Idle_Subtle', ctx.time); G.place(ctx.okafor, dt, -118, -18, 0, 1.2); ctx.thrower.mocap = G.sampleLoop('Waiting_Loop', ctx.time); G.place(ctx.thrower, dt, 118, -18, 0, 1.9); } },\n  result(ctx, c) { return { pct: c.s.score / ctx.best, detail: 'Most hoops at once: ' + (c.s.maxH = Math.max(c.s.maxH || 1, c.s.hoops)) + '.' }; },\n  draw(r, ctx) { G.ROOMS.pier(r, game.real); for (const c of ctx.contestants) G.mat(r, c.x, c.y + 4, '#ffe2b8', 28 * c.slot.size / 2.1, 14); if (ctx.okafor) { r.shape('whyfit:kenney-holiday-bench', 0, -40, 0); G.actor(r, ctx.okafor); G.actor(r, ctx.thrower); }\n    for (const c of ctx.contestants) { const sz = c.slot.size / 2.1, s = c.s, hz = 12 * c.slot.size, phase = s.phase;\n      const ring = (frontHalf, idx) => { const col = HOOP_C[idx % HOOP_C.length], R = 16 * sz, zz = hz + idx * 1.6 * sz, ofx = Math.cos(phase + idx * .4) * 2.5 * sz, ofy = Math.sin(phase + idx * .4) * 1.2 * sz; const seg = 24; r.queue(c.x, c.y, zz, g => { const O = r.w(c.x + ofx, c.y + ofy, zz); for (let k = 0; k < seg; k++) { const a = k / seg * 6.283, front = Math.sin(a) > 0; if (front !== frontHalf) continue; px.rect(g, O[0] + Math.cos(a) * R * 1.5, O[1] + Math.sin(a) * R * .42, 2, 2, col); } }, { bias: frontHalf ? 6 : -6 }); };\n      for (let h = 0; h < s.hoops; h++) { ring(false, h); ring(true, h); } G.actor(r, c.rig, { shadow: 7 }); }\n    for (const q of ctx.tosses) { if (Object.keys(q.done).length >= ctx.contestants.length && ctx.t > q.at) continue; const c = ctx.contestants[0], u = clamp((ctx.t - q.from) / (q.at - q.from), 0, 1.15), x0 = q.side * 150, x = lerp(x0, c.x, u), z = 16 + Math.sin(Math.min(1, u) * Math.PI) * 60; r.queue(x, c.y - 1, z, g => { const O = r.w(x, c.y - 1, z); for (let k = 0; k < 20; k++) { const a = k / 20 * 6.283; px.rect(g, O[0] + Math.cos(a) * 12, O[1] + Math.sin(a) * 5, 2, 2, q.c); } }); }\n    G.drawGhosts(r, ctx); },\n  hud(g, r, ctx) { const one = ctx.contestants.length === 1; G.hudTop(g, r, one ? 'Hoops ' + ctx.local.s.hoops : null, G.fmtT(ctx.dur - ctx.t));\n    for (const c of ctx.contestants) { const q = r.w(c.x, c.y, 0), cx = one ? r.W / 2 : q[0], y = r.H - (one ? 26 : 22), w = one ? 150 : 60; const B = this.band(ctx, c), hi = B[1] * 1.5, v = Math.min(1, Math.abs(c.s.w) / hi); G.round(g, cx - w / 2 - 3, y - 3, w + 6, 12, '#ffffff'); const a = cx - w / 2 + B[0] / hi * w, b = cx - w / 2 + B[1] / hi * w; px.rect(g, a, y, b - a, 6, '#bfeee0'); px.rect(g, cx - w / 2 + v * w - 1, y - 2, 3, 10, c.s.state === 'good' ? '#17a57e' : '#e0553a'); if (one) G.text(g, c.s.state === 'good' ? 'Just right' : c.s.state === 'slow' ? 'Too slow' : 'Too eager', cx, y - 14, c.s.state === 'good' ? '#17a57e' : G.COL.INK, { align: 'center', scale: 2, shadow: '#fff' }); else G.text(g, c.name, cx, y - 14, c.color || G.COL.INK, { align: 'center' }); }\n    if (one) for (const q of ctx.tosses) { if (q.done[ctx.local.i] || Math.abs(ctx.t - q.at) > .6) continue; const near = Math.abs(ctx.t - q.at) <= .25; G.text(g, q.side < 0 ? '< Catch' : 'Catch >', r.W / 2 + q.side * 80, r.H * .36, near ? '#17a57e' : G.COL.MUT, { align: 'center', scale: 2, shadow: '#fff' }); } },\n  ghost(ctx) { const s = ctx.local.s; return { p: s.phase, w: [s.w, s.hoops], s: Math.round(s.score / ctx.best * 1000) }; },\n  ghostPose(rig, st) { rig.mocap = null; rig.body = G.moves.hula(st.p || 0); return 1.57; }\n});\nEOF\nsed -i \"s/r.shape('whyfit:kenney-holiday-bench', 0, -40, 0)/r.shape('whyfit:bench', 0, -40, 0)/\" game/activities/hoop.js\ngrep -o '\"[a-z-]*\":{' vendor/whyfit-props.js | head -0; node -e \"\nconst vm=require('vm'),fs=require('fs');const c={console,addEventListener(){},location:{hash:''}};c.window=c;vm.createContext(c);\nvm.runInContext(fs.readFileSync('engine/my-3d2dge.js','utf8'),c);vm.runInContext(fs.readFileSync('vendor/whyfit-props.js','utf8'),c);\nvm.runInContext('console.log(Object.keys(ASSETS.whyfit.shapes).join(\\\",\\\"),JSON.stringify(My3D2dge.addAssets(ASSETS.whyfit)).slice(0,300))',c)\"","description":"Write candle, rep, step and hoop activities; inspect prop ids"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":21534,"cache_read_input_tokens":219018,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":21534},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6a88ba50-da75-48c3-bde0-396ebfab72e9","uuid":"709254b8-3161-4178-bccf-de1675fee66a","timestamp":"2026-11-05T05:31:53.021Z","request_id":"req_011CgjEEbQLCqa23XgTVXjW7","wire_tool_inputs":{"toolu_01FJs6MeSak95pouR2eerXDg":{"command":"cat > game/activities/candle.js <<'EOF'\n// Quiet Candle, and the Grand Stillness duel. The flame reacts to the speed of the dot, not where it is.\nconst DUEL_BITS = [{ at: 10, id: 'gull', f: 3.5 }, { at: 25, id: 'blender', f: 4 }, { at: 40, id: 'conga', f: 4.5 }, { at: 55, id: 'fireworks', f: 4 }, { at: 68, id: 'tare', f: 4.5 }, { at: 80, id: 'goose', f: 5 }];\nG.activity({ id: 'candle', family: 'candle', discipline: 'Stillness', name: 'Quiet Candle', tierName: 'With Company', class: true, hub: true, coachKey: 'hold', song: 'yoga',\n  says: 'Sit. Keep the dot in the ring and move it slowly. Fast corrections hurt the flame. Thoughts will come. You may not leave.',\n  controls: (src, lean) => [[lean, 'Correct gently']],\n  prompts: () => [['lean', 'Correct gently']],\n  setup(ctx) { const T = ctx.T; ctx.dur = ctx.duel ? 90 : (ctx.limit || T.dur); ctx.thT = ctx.duel ? 99 : 4; ctx.thoughts = []; ctx.time = 0; ctx.her = 1; ctx.bits = ctx.duel ? DUEL_BITS.map(b => Object.assign({}, b)) : (T.extra ? T.extra.map((id, i) => ({ at: 15 + i * 22, id, f: 4 })) : []); ctx.show = {};\n    for (const c of ctx.contestants) { G.setupBal(ctx, c, G.SETS.candle); c.s.flame = 1; c.s.sum = 0; c.s.n = 0; c.s.relit = false; c.s.out = false; c.s.pen = 0; c.bal.onFall = () => { c.s.flame -= .3; }; }\n    if (ctx.duel) { ctx.gert = G.regularRig('gertrude', 1.9); ctx.gert.wear = G.CAST.gertrude.wear; ctx.gullB = G.Blobs.gull(); ctx.goose = G.Blobs.pigeon(); } ctx.fires = []; },\n  botFill(ctx, c, skill, dt) { G.leanBotFill(ctx, c, dt); },\n  addThought(ctx, text, f) { const a = ctx.rng() * 6.283; ctx.thoughts.push({ text, x: Math.cos(a), y: Math.sin(a), t: 2.5, f, age: 0, a }); },\n  update(dt, ctx) { const T = ctx.T, loc = ctx.local; ctx.thT -= dt;\n    if (ctx.thT <= 0) { ctx.thT += T.thoughtEvery; this.addThought(ctx, G.pick(G.LINES.thoughts, ctx.rng), lerp(T.thoughtF[0], T.thoughtF[1], ctx.rng())); }\n    for (const b of ctx.bits) if (!b.done && ctx.t >= b.at) { b.done = true; ctx.show[b.id] = 6; this.addThought(ctx, G.LINES.duelBits[b.id], b.f); G.sfx(b.id === 'gull' ? 'gull' : b.id === 'blender' ? 'blender' : b.id === 'goose' ? 'goose' : b.id === 'fireworks' ? 'firework' : 'tick'); if (b.id === 'fireworks') { game.flash('#ffe0a0', .2, .4); for (let i = 0; i < 5; i++) ctx.fires.push({ x: ctx.rng(), y: ctx.rng() * .4, t: i * .5, c: G.pick(['#ff7a59', '#f5c84b', '#2cc6e6', '#e85d8a'], ctx.rng) }); } if (b.id === 'tare') { for (let i = 0; i < 6; i++) game.after(i * .32, () => G.babble('TARE', 'a')); } }\n    for (const k in ctx.show) ctx.show[k] -= dt;\n    let fx = 0, fy = 0; for (const th of ctx.thoughts) { th.age += dt; th.t -= dt; if (th.t > 0) { fx += th.x * th.f; fy += th.y * th.f; } } ctx.thoughts = ctx.thoughts.filter(t => t.age < 4);\n    if (loc && !loc.bot && !ctx.warned && ctx.t >= 20 && !loc.intent.touched && !ctx.duel) { ctx.warned = true; ctx.say('tare', G.line('candleUntouched'), 5); }\n    let alive = false;\n    for (const c of ctx.contestants) { const s = c.s, b = c.bal; if (s.out) continue; alive = true; b.step(dt, c.intent.ux, c.intent.uy, { fx, fy });\n      const sp = Math.hypot(b.vx, b.vy); if (sp > .55) { s.flame -= .4 * dt; if (c.local) { s.fl = (s.fl || 0) - dt; if (s.fl <= 0) { s.fl = .3; G.sfx('flick'); } } } if (b.inRing) s.flame = Math.min(1, s.flame + .12 * dt); if (!b.inRing && b.lean > .6) s.flame -= .05 * dt;\n      s.sum += Math.max(0, s.flame); s.n++;\n      if (s.flame <= 0) { if (!s.relit && !ctx.cheat) { s.relit = true; s.flame = .5; s.pen = .15; G.sfx('stamp', { vol: .2 }); if (c.local) ctx.say('tare', 'I relit it. Please do not tell the candle.', 3); } else if (ctx.cheat) s.flame = .6; else { s.out = true; s.flame = 0; } } }\n    if (ctx.duel && ctx.t > 75 && loc.s.flame > .5) ctx.her = Math.max(0, ctx.her - dt / 12);\n    if (!alive || ctx.t >= ctx.dur) ctx.done = true; },\n  stop(ctx) { if (ctx.duel) { ctx.won = ctx.her <= .001 && !ctx.local.s.out; } },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; for (const c of ctx.contestants) { c.rig.wob = [c.bal.px * .6, c.bal.py * .6]; c.rig.mocap = c.bal.stumbleT > 0 ? G.sampleLoop('Dizzy', ctx.time) : G.sampleLoop('Meditate', ctx.time * .4); G.place(c.rig, dt, c.x, c.y, 0, 1.57); }\n    if (ctx.gert) { ctx.gert.mocap = G.sampleLoop('Meditate', ctx.time * .3); G.place(ctx.gert, dt, 66, -4, 0, 1.3); ctx.gullB.update(dt, { flap: 1 }); ctx.goose.update(dt, { flap: 0, walk: 1 }); } },\n  result(ctx, c) { const s = c.s, st = c.bal.steadiness, mf = s.n ? s.sum / s.n : 0; return { pct: .6 * st + .4 * mf - s.pen, detail: ctx.duel ? (ctx.won ? 'Her candle went out. She did not seem surprised.' : 'Her candle is still lit. It has been lit since Thursday.') : 'Steady ' + Math.round(st * 100) + '%. Mean flame ' + Math.round(mf * 100) + '%.' }; },\n  draw(r, ctx) { const t = game.real; if (ctx.duel) { G.ROOMS.raft(r, t); r.shape('whyfit:lantern-glass', -100, -18, 0); r.shape('whyfit:lantern-glass', 104, -18, 0); r.shape('whyfit:lantern-glass', -106, 26, 0); r.shape('whyfit:lantern-glass', 110, 26, 0); game.lights.add(-100, -18, 18, 70, .8, { color: '#ffc070' }); game.lights.add(104, -18, 18, 70, .8, { color: '#ffc070' }); } else { G.ROOMS.deck(r, t); G.PROPS.fern(r.ctx, r.W * .14, r.w(0, -30, 0)[1], t); G.PROPS.fern(r.ctx, r.W * .86, r.w(0, -30, 0)[1], t); }\n    const cand = (x, y, fl) => { r.queue(x, y + 22, 0, g => { const p = r.w(x, y + 22, 0); G.PROPS.candle(g, p[0], p[1], Math.max(0, fl), game.real); }, { emissive: true }); if (fl > 0) game.lights.add(x, y + 22, 12, 34 + fl * 26, .7, { color: '#ffc070' }); };\n    if (ctx.duel) { const c = ctx.local; c.x = -56; c.rig.px = -56; } for (const c of ctx.contestants) { if (!ctx.duel) G.mat(r, c.x, c.y + 4, '#e6dcff', 26 * c.slot.size / 2.1, 14); cand(c.x, c.y, c.s.flame); G.actor(r, c.rig, { shadow: 8 }); }\n    if (ctx.gert) { cand(66, -4, ctx.her); G.actor(r, ctx.gert); const sh = ctx.show;\n      if (sh.gull > 0) r.actor(-20, 6, 8, (g, ox, oy) => ctx.gullB.draw(g, ox, oy, r.view));\n      if (sh.goose > 0) r.actor(30 - (6 - sh.goose) * 6, 22, 0, (g, ox, oy) => ctx.goose.draw(g, ox, oy, r.view));\n      if (sh.blender > 0) r.queue(-120, -10, 0, g => { const p = r.w(-120, -10, 0); G.PROPS.blender(g, p[0] + Math.sin(game.real * 40), p[1]); });\n      if (sh.conga > 0) for (let i = 0; i < 5; i++) { r.queue(-100 + (6 - sh.conga) * 30 + i * -16, -20, 0, g => { const x = -100 + (6 - sh.conga) * 30 + i * -16, p = r.w(x, -20, 0), hop = Math.abs(Math.sin(game.real * 6 + i)) * 3; px.rect(g, p[0] - 3, p[1] - 14 - hop, 6, 14, ['#ff7a59', '#2cc6e6', '#f5c84b', '#7bd389', '#c79be8'][i]); px.disc(g, p[0], p[1] - 17 - hop, 3, '#f0c8a0'); }); } }\n    r.overlay(g => { for (const f of ctx.fires) { const u = (ctx.t - (ctx.fireBase || 55)) - f.t; if (u > 0 && u < 1.2) for (let i = 0; i < 10; i++) { const a = i / 10 * 6.283, d = u * 26; px.rect(g, f.x * r.W + Math.cos(a) * d, 8 + f.y * r.H * .5 + Math.sin(a) * d, 2, 2, f.c); } } });\n    G.drawGhosts(r, ctx); },\n  hud(g, r, ctx) { G.hudTop(g, r, null, G.fmtT(ctx.dur - ctx.t)); G.drawPlates(g, r, ctx);\n    if (ctx.contestants.length === 1) { const f = Math.max(0, ctx.local.s.flame), x = 12, w = 72, y = r.H - 30; G.round(g, x, y, w + 6, 10, '#ffffff'); if (f > .02) px.rect(g, x + 3, y + 3, w * f, 4, f > .4 ? '#f5a742' : '#e0553a'); G.text(g, 'Flame', x + 3, y - 10, G.COL.INK); if (ctx.duel) { const y2 = y - 24; G.round(g, x, y2, w + 6, 10, '#ffffff'); if (ctx.her > .02) px.rect(g, x + 3, y2 + 3, w * ctx.her, 4, '#c79be8'); G.text(g, 'Gertrude', x + 3, y2 - 10, '#fff'); } }\n    for (const th of ctx.thoughts) { const fade = th.age < .3 ? th.age / .3 : th.age > 3.5 ? (4 - th.age) / .5 : 1; if (fade <= .2) continue; const w = Math.min(170, E.font.width(th.text) + 16), lines = E.font.wrap(th.text, w - 12), h = lines.length * 10 + 8, cx = r.W / 2 + th.x * r.W * .3, cy = 62 - th.y * 24 - th.age * 2; G.round(g, cx - w / 2 + 1, cy + 1, w, h, '#b9cfd6', 6); G.round(g, cx - w / 2, cy, w, h, '#ffffff', 6); lines.forEach((l, i) => G.text(g, l, cx, cy + 4 + i * 10, G.COL.INK, { align: 'center' })); px.disc(g, cx, cy + h + 3, 2, '#ffffff'); } },\n  ghost(ctx) { const b = ctx.local.bal; return { l: [b.px, b.py], s: Math.round(Math.max(0, .6 * b.steadiness + .4 * (ctx.local.s.n ? ctx.local.s.sum / ctx.local.s.n : 0) - ctx.local.s.pen) * 1000) }; } });\nEOF\ncat > game/activities/rep.js <<'EOF'\n// The Rail: one code path, three data rows. Your lean IS the body: holding the stick halfway holds you halfway.\nconst REP_LABEL = v => v >= .8 ? 'Perfect' : v >= .4 ? 'Good' : 'Late';\nconst beadAt = (T, u) => { const a = T.down, b = T.hold, c = T.up; if (u < a) return u / a; if (u < a + b) return 1; return Math.max(0, 1 - (u - a - b) / c); };\nconst repDef = (id, name, says, sayT, extra) => G.activity(Object.assign({ id, family: 'rep', discipline: 'Strength', name, tierName: 'Slow Down, Quick Up', coachKey: 'strength', song: 'iron', says, tierSays: sayT,\n  controls: (src, lean) => [[lean, extra.side ? 'Your lean is your lunge' : 'Your lean is your depth']],\n  prompts: () => [['lean', extra.side ? 'Lean left and right' : 'Pull back to go down']],\n  setup(ctx) { const T = ctx.T; ctx.reps = T.reps; ctx.len = T.down + T.hold + T.up; ctx.rep = 0; ctx.u = 0; ctx.bead = 0; ctx.time = 0; ctx.bonus = false; ctx.flash = null;\n    for (const c of ctx.contestants) { G.setupBal(ctx, c, G.SETS[extra.side ? 'repSide' : 'rep'], { stumbleAt: 9, noFall: true, noGentle: true }); c.s.scores = []; c.s.err = 0; c.s.n = 0; c.s.form = 0; c.s.fn = 0; c.s.mark = null; c.s.markT = 0; c.depth = 0; }\n    G.makeCoach(ctx); ctx.prop = G.rng; },\n  sideOf: (ctx, rep) => rep % 2 ? -1 : 1,\n  botFill(ctx, c, skill, dt) { const T = ctx.T, lead = { poor: -.34, average: -.16, good: -.04, expert: .02 }[skill] || 0, amp = { poor: .34, average: .1, good: .03, expert: .01 }[skill] || 0;\n    c.s.bt = (c.s.bt || 0) + dt; const u = ctx.u + lead + .14; let n = ctx.rep; let uu = u; if (uu >= ctx.len) { uu -= ctx.len; n++; } else if (uu < 0) { uu += ctx.len; n--; } const bd = beadAt(T, uu), wig = amp * Math.sin(c.s.bt * 2.3 + c.i) + amp * .6 * Math.sin(c.s.bt * 4.1), f = c.bal;\n    if (extra.side) { c.intent.ux = clamp((n % 2 ? -1 : 1) * bd + wig, -1, 1); c.intent.uy = clamp(-f.py * 1.4 - f.vy * .3, -1, 1); } else { c.intent.uy = clamp(-bd + wig, -1, 1); c.intent.ux = clamp(-f.px * 1.4 - f.vx * .3, -1, 1); } },\n  update(dt, ctx) { const T = ctx.T; ctx.u += dt; const fat = ctx.rep >= ctx.reps * .6 ? Math.min(1, (ctx.rep - ctx.reps * .6) / (ctx.reps * .4 + .01) + .3) * G.DEV.fatigue : 0;\n    ctx.fat = fat; ctx.bead = beadAt(T, ctx.u); const sgn = extra.side ? this.sideOf(ctx, ctx.rep) : 1;\n    for (const c of ctx.contestants) { const b = c.bal; b.step(dt, c.intent.ux, c.intent.uy, { A: 1 + fat * 3, k: 1 - fat * .22 }); c.depth = extra.side ? clamp(b.px * sgn, -1, 1) : clamp(-b.py, 0, 1); const e = Math.abs(c.depth - ctx.bead); c.s.err += e * dt; c.s.n += dt; const fo = Math.abs(extra.side ? b.py : b.px); c.s.form += fo * dt; c.s.fn += dt; if (c.s.markT > 0) c.s.markT -= dt; }\n    if (ctx.u >= ctx.len) { const tol = G.DEV.repTol; for (const c of ctx.contestants) { const m = c.s.err / (c.s.n || 1), v = clamp(1 - (m - .08 * tol) / (.27 * tol), 0, 1); c.s.scores.push(v); c.s.err = 0; c.s.n = 0; c.s.mark = REP_LABEL(v); c.s.markT = 1; if (c.local) { G.sfx(v >= .8 ? 'chime' : 'tick', { vol: .35, pitch: 1 + ctx.rep * .03 }); if (v >= .8 && c.input && c.input.rumble) c.input.rumble(.15, .08); G.grunt(G.coach().toUpperCase()); } }\n      ctx.rep++; ctx.u -= ctx.len;\n      if (ctx.rep >= ctx.reps) { const c = ctx.local, mean = c.s.scores.reduce((a, b) => a + b, 0) / c.s.scores.length; if (!ctx.bonus && mean > .8 && ctx.contestants.length === 1 && !ctx.limit && !ctx.short) { ctx.bonus = true; ctx.reps += 2; ctx.say(G.coach(), G.LINES.twoMore, 3); } else ctx.done = true; } }\n  },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const D = G.ACTDATA[id], shake = (ctx.fat || 0) * .03;\n    for (const c of ctx.contestants) { const rig = c.rig, b = c.bal, depth = Math.max(0, c.depth || 0); rig.wob = [(extra.side ? b.py : b.px) * .55 + Math.sin(ctx.time * 42 + c.i) * shake, Math.sin(ctx.time * 37) * shake];\n      if (extra.side) { rig.mocap = null; const sgn = (ctx.rep || 0) % 2 ? -1 : 1; rig.body = G.moves.sideLunge(clamp(b.px, -1, 1)); G.place(rig, dt, c.x, c.y, 0, D.tgt); }\n      else { rig.body = null; const clip = G.clip(D.clip), t1 = D.t1 !== undefined ? D.t1 : clip.dur * D.t1Frac; rig.mocap = G.lib.sample(clip, lerp(D.t0, t1, depth)); G.place(rig, dt, c.x, c.y, 0, D.tgt); } }\n    if (ctx.coachRig) { const r2 = ctx.coachRig; if (extra.side) { r2.mocap = null; r2.body = G.moves.sideLunge(ctx.bead * ((ctx.rep || 0) % 2 ? -1 : 1)); } else { r2.body = null; const clip = G.clip(D.clip), t1 = D.t1 !== undefined ? D.t1 : clip.dur * D.t1Frac; r2.mocap = G.lib.sample(clip, lerp(D.t0, t1, ctx.bead)); } G.place(r2, dt, -98, -14, 0, D.tgt); } },\n  result(ctx, c) { const sc = c.s.scores, mean = sc.length ? sc.reduce((a, b) => a + b, 0) / Math.max(sc.length, ctx.limit || ctx.short ? sc.length : ctx.T.reps) : 0, form = c.s.fn ? c.s.form / c.s.fn : 0, pen = Math.min(.3, form * .6); return { pct: mean * (1 - pen), detail: sc.length + ' reps. Form ' + Math.round((1 - pen) * 100) + '%.' + (ctx.bonus ? ' Two more were added.' : '') }; },\n  draw(r, ctx) { G.ROOMS.iron(r, game.real); const g = r.ctx; const base = r.w(0, -38, 0); G.PROPS.cooler(g, r.W * .9, base[1] + 8); for (let i = 0; i < 4; i++) G.PROPS.dumbbell(g, r.W * .1 + i * 12, base[1] + 6 + (i % 2) * 2); for (const c of ctx.contestants) G.mat(r, c.x, c.y + 4, '#d7ecf4', 30 * c.slot.size / 2.1, 14); G.mat(r, -98, -10, '#ffe2b8', 24, 10); G.drawCoach(r, ctx); for (const c of ctx.contestants) G.actor(r, c.rig, { shadow: 8 }); G.drawGhosts(r, ctx); },\n  hud(g, r, ctx) { G.hudTop(g, r, 'Rep ' + Math.min(ctx.rep + 1, ctx.reps) + ' of ' + ctx.reps, null); const one = ctx.contestants.length === 1;\n    for (const c of ctx.contestants) { const q = r.w(c.x, c.y, 0), bx = one ? q[0] + 64 : q[0] + 22, top = one ? 70 : r.H - 104, h = one ? r.H - 130 : 60;\n      if (extra.side) { const w = 170, x0 = r.W / 2, y0 = r.H - 54, sgn = this.sideOf(ctx, ctx.rep); G.round(g, x0 - w / 2 - 4, y0 - 4, w + 8, 9, '#ffffff'); px.rect(g, x0 - w / 2, y0, w, 1, '#c8dde2'); px.disc(g, x0 + ctx.bead * sgn * w / 2, y0, 5, G.COL.ACC); px.disc(g, x0 + c.bal.px * w / 2, y0, 3, G.COL.CORAL); }\n      else { G.round(g, bx - 5, top - 4, 10, h + 8, '#ffffff', 4); px.rect(g, bx, top, 1, h, '#c8dde2'); px.disc(g, bx, top + ctx.bead * h, one ? 5 : 3, G.COL.ACC); px.disc(g, bx, top + (c.depth || 0) * h, one ? 3 : 2, G.COL.CORAL); }\n      if (c.s.markT > 0) G.text(g, c.s.mark, q[0], q[1] - (one ? 76 : 58) - (1 - c.s.markT) * 8, c.s.mark === 'Perfect' ? '#17a57e' : c.s.mark === 'Good' ? G.COL.ACCD : '#e0553a', { align: 'center', scale: one ? 2 : 1, shadow: '#fff' }); }\n    if (!one) G.drawPlates(g, r, ctx); else { const c = ctx.local, x = 12, y = r.H - 16, form = Math.abs(extra.side ? c.bal.py : c.bal.px); G.text(g, form > .25 ? 'Your form is drifting' : 'Form: good', x, y, form > .25 ? '#e0553a' : G.COL.INK); } },\n  ghost(ctx) { const c = ctx.local, sc = c.s.scores; return { l: [c.bal.px, c.bal.py], p: c.depth || 0, s: Math.round((sc.length ? sc.reduce((a, b) => a + b, 0) / sc.length : 0) * 1000) }; },\n  ghostPose(rig, st, dt) { const D = G.ACTDATA[id]; if (extra.side) { rig.mocap = null; rig.body = G.moves.sideLunge(st.l ? st.l[0] : 0); } else { rig.body = null; const clip = G.clip(D.clip), t1 = D.t1 !== undefined ? D.t1 : clip.dur * D.t1Frac; rig.mocap = G.lib.sample(clip, lerp(D.t0, t1, st.p || 0)); } return D.tgt; }\n}, extra));\nrepDef('squat', 'Squat Rail', 'A bead rides the rail. Your lean is your squat, so match it. You may hold halfway. You may not skip the bottom.', 'Three seconds down, a hold, one second up. Please do not thank us.', { class: true, hub: true });\nrepDef('pushup', 'Push-Up', 'Your lean is your push-up. Pull back to go low. The bead sets the tempo. The floor sets the rest.', 'Three seconds down, a hold, one second up. The floor remains interested.', { hub: true });\nrepDef('lunge', 'Side Lunge', 'Lean left and right with the bead. Your lean is your lunge. You may not lunge forward. That is a different room.', 'Three seconds out, a hold, one second back. Both sides, please.', { side: true });\nEOF\ncat > game/activities/step.js <<'EOF'\n// Step Class: E.Rhythm on a chart. Music is 10%, so the beat never depends on it: a click on the sfx bus, a count in gibberish.\nconst STEP_COUNT = ['one', 'tu', 'tri', 'for'];\nG.activity({ id: 'step', family: 'step', discipline: 'Cardio', name: 'Step Class', tierName: 'All Four Arrows', class: true, hub: true, coachKey: 'cardio', song: 'morning',\n  says: 'Press with each arrow as it reaches the line. Your step is your press. You may not step early. The class will know.',\n  tierSays: 'All four arrows at a brisker pace. Everybody behind you can see your feet.',\n  controls: (src, lean, L) => src === 'pad' ? [['D-pad or stick', 'Step with the arrows']] : src === 'mouse' ? [['Buttons', 'Left and right'], ['Wheel', 'Up and down']] : [['Arrows or WASD', 'Step with the arrows']],\n  prompts: (ctx) => [[ctx.tier ? 'stepU' : 'stepL', 'Step']],\n  setup(ctx) { const T = ctx.T, chart = ctx.short ? G.CHARTS.short : G.CHARTS[T.chart], parts = chart.order.split(/\\s+/).length, spb = 16; const base = G.SONGS[T.song]; ctx.song = Object.assign({}, base, { loop: false, len: parts * spb }); ctx.dur = ctx.limit || (parts * spb) / 4 / T.bpm * 60;\n    const w = G.DEV.rhythmWin, windows = { perfect: 45 * w, great: 90 * w, good: 135 * w };\n    for (const c of ctx.contestants) { c.rh = new E.Rhythm(game, { song: ctx.song, chart, lanes: ['_a', '_b', '_c', '_d'], windows, life: 1, lead: 1.6 }); c.rh.on.fail = null; c.s.k = 0; c.s.tk = 0; c.s.side = 0; }\n    ctx.time = 0; ctx.beat = 0; G.makeCoach(ctx); ctx.regs = []; if (ctx.contestants.length === 1) for (const id of ['marisol', 'kevin', 'twins']) ctx.regs.push({ rig: G.regularRig(id, 1.5), k: 0, x: { marisol: -40, kevin: 44, twins: 118 }[id] }); },\n  begin(ctx) { let first = true; for (const c of ctx.contestants) { if (first) { c.rh.start(); first = false; } else { c.rh.reset(); c.rh.started = true; } c.rh.life = 1; } G.__stepBeat = game.audio.onBeat(b => { ctx.beat = b; G.sfx(b % 4 === 0 ? 'beatUp' : 'beat'); if (ctx.mode !== 'round') { const w = STEP_COUNT[b % 4]; for (let i = 0; i < w.length; i++) G.babble(ctx.coachId, w[i], { at: i * .05 }); } for (const q of ctx.regs) q.tk = 1; if (ctx.coachRig) ctx.coachK = 1; });\n    for (const c of ctx.contestants) if (c.bot) { const sk = { poor: [105, .22], average: [60, .06], good: [34, .015], expert: [14, 0] }[c.bot], R = E.rng(ctx.seed + c.i * 5 + 77); const spb = 60 / ctx.T.bpm / 4; c.s.plan = c.rh.notes.map(n => { let d = 0; for (let i = 0; i < 3; i++) d += R() - .5; const miss = R() < sk[1]; return { lane: n.lane, step: n.step + (d * sk[0] * 1.2 / 1000) / spb, miss }; }).filter(q => !q.miss); c.s.pi = 0; } },\n  stop() { if (G.__stepBeat) { G.__stepBeat.cancel(); G.__stepBeat = null; } },\n  cleanup(ctx) { this.stop(ctx); },\n  botFill(ctx, c) { const p = game.audio.pos.step; c.intent.press = [false, false, false, false]; while (c.s.plan && c.s.pi < c.s.plan.length && c.s.plan[c.s.pi].step <= p) { c.intent.press[c.s.plan[c.s.pi].lane] = true; c.s.pi++; } },\n  update(dt, ctx) { for (const c of ctx.contestants) { const rh = c.rh; rh.life = 1; for (let l = 0; l < 4; l++) if (c.intent.press[l]) { const hit = rh.hit(l); c.s.tk = 1; c.s.side = l; if (c.local && hit) { G.sfx('tick', { vol: .25, pitch: 1.4 }); if (c.input && c.input.rumble) c.input.rumble(.12, .05); } } rh.update(); }\n    if (ctx.contestants[0].rh.done || ctx.t >= ctx.dur + .5) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; const up = (o, key) => { o[key] = Math.max(0, (o[key] || 0) - dt * 2.2); return Math.sin(Math.min(1, o[key]) * Math.PI); };\n    for (const c of ctx.contestants) { const k = up(c.s, 'tk'); c.rig.mocap = null; c.rig.wob = [0, 0]; c.rig.body = k > .03 ? G.moves.stepUp(k) : null; G.place(c.rig, dt, c.x, c.y, 0, 1.4, k > .03 ? {} : {}); }\n    for (const q of ctx.regs) { const k = up(q, 'tk'); q.rig.mocap = null; q.rig.body = k > .03 ? G.moves.stepUp(k) : null; G.place(q.rig, dt, q.x, -26, 0, 1.4); }\n    if (ctx.coachRig) { const k = up(ctx, 'coachK'); ctx.coachRig.mocap = null; ctx.coachRig.body = k > .03 ? G.moves.stepUp(k) : null; G.place(ctx.coachRig, dt, -100, -22, 0, 1.4); } },\n  result(ctx, c) { const rh = c.rh, tot = rh.notes.filter(n => n.j && n.j !== 'call').length || 1, acc = rh.counts.perfect + rh.counts.great * .7 + rh.counts.good * .4, all = ctx.limit ? tot : rh.total; return { pct: acc / (all || 1), detail: 'Perfect ' + rh.counts.perfect + ', good ' + (rh.counts.great + rh.counts.good) + ', missed ' + rh.counts.miss + '.' }; },\n  draw(r, ctx) { G.ROOMS[ctx.festival ? 'festival' : 'pier'](r, game.real); const bench = (x, y, s = 1) => r.queue(x, y, 0, g => { const a = r.w(x, y, 0); px.rect(g, a[0] - 14 * s, a[1] - 6 * s, 28 * s, 3 * s, '#e0553a'); px.rect(g, a[0] - 14 * s, a[1] - 3 * s, 28 * s, 3 * s, '#20404c'); px.rect(g, a[0] - 12 * s, a[1], 4 * s, 2 * s, '#20404c'); px.rect(g, a[0] + 8 * s, a[1], 4 * s, 2 * s, '#20404c'); }, { bias: -4 });\n    for (const c of ctx.contestants) bench(c.x, c.y, c.slot.size / 1.5); for (const q of ctx.regs) { bench(q.x, -26); G.actor(r, q.rig, { shadow: 5 }); } if (ctx.coachRig) { bench(-100, -22, 1.2); G.actor(r, ctx.coachRig); } for (const c of ctx.contestants) G.actor(r, c.rig, { shadow: 7 }); G.drawGhosts(r, ctx);\n    if (ctx.festival) { for (let i = 0; i < 9; i++) { const x = -150 + i * 38, hop = Math.abs(Math.sin(game.real * 5 + i)) * 2; r.queue(x, -40, 0, g => { const p = r.w(x, -40, 0); px.rect(g, p[0] - 2, p[1] - 10 - hop, 4, 10, ['#c79be8', '#2cc6e6', '#f5c84b', '#7bd389'][i % 4]); px.disc(g, p[0], p[1] - 12 - hop, 2, '#f0c8a0'); }); } } },\n  hud(g, r, ctx) { const n = ctx.contestants.length, one = n === 1; ctx.contestants.forEach(c => { const q = r.w(c.x, c.y, 0), hx = one ? r.W / 2 + 96 : q[0]; if (c.rh.started) c.rh.draw(r, { x: hx, y: one ? r.H - 40 : r.H - 16, dir: 'down', len: one ? r.H - 90 : 90, gap: one ? 26 : 12, size: one ? 10 : 6, arrows: true }); if (!one) G.text(g, c.name, q[0], r.H - 112, c.color || G.COL.INK, { align: 'center' }); const j = c.rh.last; if (one && j && game.time - j.t < .5) G.text(g, j.j[0].toUpperCase() + j.j.slice(1), hx, 40, j.j === 'miss' ? '#e0553a' : '#17a57e', { align: 'center', scale: 2, shadow: '#fff' }); });\n    G.hudTop(g, r, one ? 'Combo ' + ctx.local.rh.combo : null, G.fmtT(ctx.dur - ctx.t)); },\n  ghost(ctx) { const c = ctx.local, rh = c.rh; return { p: c.s.tk || 0, s: Math.round((rh.counts.perfect + rh.counts.great * .7 + rh.counts.good * .4) / (rh.total || 1) * 1000) }; },\n  ghostPose(rig, st) { const k = Math.sin(Math.min(1, st.p || 0) * Math.PI); rig.mocap = null; rig.body = k > .03 ? G.moves.stepUp(k) : null; return 1.4; }\n});\nEOF\ncat > game/activities/hoop.js <<'EOF'\n// Hoop Hips: circle the lean to spin the hoop. Regulars throw more. More hoops score faster and want a little more speed.\nconst HOOP_C = ['#ff7a59', '#2cc6e6', '#f5c84b', '#7bd389', '#c79be8', '#e85d8a', '#5a7fe0'];\nG.activity({ id: 'hoop', family: 'hoop', discipline: 'Cardio', name: 'Hoop Hips', tierName: 'Faster Friends', class: true, hub: true, kbDirect: true, coachKey: 'cardio', song: 'jog',\n  says: 'Circle your lean to spin the hoop. Keep it just right. Catch more as they come. You may not use your hands. You will want to.',\n  controls: (src, lean, L) => [[src === 'keys' ? 'W D S A' : lean, src === 'keys' ? 'Tap round in a circle' : 'Circle it'], [L('catchL'), 'Catch left'], [L('catchR'), 'Catch right']],\n  prompts: () => [['lean', 'Circle'], ['catchL', 'Catch L'], ['catchR', 'Catch R']],\n  setup(ctx) { const T = ctx.T; ctx.dur = ctx.limit || T.dur; ctx.tossT = 2.5; ctx.tosses = []; ctx.time = 0; ctx.half = false; ctx.okafor = ctx.contestants.length === 1 ? G.regularRig('okafor', 1.6) : null; ctx.thrower = ctx.contestants.length === 1 ? G.regularRig('marisol', 1.5) : null;\n    let best = 0, h = 1, t = 0, nt = 2.5; for (; t < ctx.dur; t += .1) { if (t >= nt) { nt += T.tossEvery; h = Math.min(6, h + 1); } best += (1 + .5 * (h - 1)) * .1; } ctx.best = best;\n    for (const c of ctx.contestants) { c.s = { hoops: 1, ang: 0, w: 0, phase: 0, score: 0, out: 0, dirSum: 0, lastA: null, inBand: false, stackT: 0, dirUsed: 0, wr: 0 }; c.bal = new G.Balance(G.SETS.plain, E.rng(ctx.seed + c.i), { noFall: true, noGentle: true }); } },\n  band(ctx, c) { const T = ctx.T, s = c.s, kb = c.intent.source === 'keys' && !c.bot ? .6 : 1, B = G.DEV.hoopBand, add = T.perHoop * (s.hoops - 1); return [T.band[0] * kb * (2 - B) + add * kb, T.band[1] * kb * B + add * kb]; },\n  botFill(ctx, c, skill, dt) { const s = c.s, cfg = { poor: [6.5, 1.1, .45, .35], average: [8.6, .6, .8, .2], good: [9.6, .3, .95, .1], expert: [10.2, .15, 1, .05] }[skill]; c.s.bphase = (c.s.bphase || 0) + (cfg[0] + s.hoops * .22 + Math.sin(ctx.t * 1.1 + c.i) * cfg[1]) * dt * (ctx.half ? -1 : 1); c.intent.ux = Math.cos(c.s.bphase) * .95; c.intent.uy = Math.sin(c.s.bphase) * .95; c.intent.catchL = false; c.intent.catchR = false;\n    for (const q of ctx.tosses) if (!q.done[c.i] && !q.tried[c.i] && Math.abs(ctx.t - q.at) < cfg[3]) { q.tried[c.i] = true; if ((c.s.R || (c.s.R = E.rng(ctx.seed + 3 + c.i)))() < cfg[2]) { if (q.side < 0) c.intent.catchL = true; else c.intent.catchR = true; } } },\n  update(dt, ctx) { const T = ctx.T; ctx.tossT -= dt;\n    if (ctx.tossT <= 0) { ctx.tossT += T.tossEvery; ctx.tosses.push({ at: ctx.t + 1.4, from: ctx.t, side: ctx.rng() < .5 ? -1 : 1, c: G.pick(HOOP_C, ctx.rng), done: {}, tried: {} }); G.sfx('whoosh', { vol: .4 }); }\n    if (!ctx.half && ctx.t >= ctx.dur / 2) { ctx.half = true; ctx.say(G.coach(), G.LINES.otherWay, 2.5); G.sfx('boop', { vol: .3 }); }\n    for (const c of ctx.contestants) { const s = c.s, i = c.intent, l = Math.hypot(i.ux, i.uy); c.bal.step(dt, i.ux, i.uy);\n      if (l > .55) { const a = Math.atan2(i.uy, i.ux); if (s.lastA !== null) { let d = a - s.lastA; while (d > Math.PI) d -= 6.283; while (d < -Math.PI) d += 6.283; s.dirSum += d; s.wr = d / dt; } else s.wr = 0; s.lastA = a; } else { s.lastA = null; s.wr = 0; }\n      const e = Math.min(1, dt / .32); s.w += (s.wr - s.w) * e; s.phase += s.w * dt;\n      const sp = Math.abs(s.w), B = this.band(ctx, c), dirOk = !ctx.half || !s.firstDir || Math.sign(s.w) === -s.firstDir || sp < .1; if (!ctx.half && !s.firstDir && Math.abs(s.dirSum) > 6) s.firstDir = Math.sign(s.dirSum);\n      s.state = sp < B[0] ? 'slow' : sp > B[1] ? 'eager' : 'good'; s.inBand = s.state === 'good' && dirOk;\n      if (s.inBand) { s.score += (1 + .5 * (s.hoops - 1)) * dt; s.out = 0; } else { s.out += dt; if (s.out >= 1.5 && s.hoops > 1) { s.hoops--; s.out = 0; s.drop = 1; if (c.local) G.sfx('stumble', { vol: .3 }); } }\n      for (const q of ctx.tosses) { if (q.done[c.i]) continue; const press = q.side < 0 ? i.catchL : i.catchR; if (press && Math.abs(ctx.t - q.at) <= .25) { q.done[c.i] = true; if (s.hoops < 6) s.hoops++; if (c.local) { G.sfx('clink'); G.sfx('chime', { vol: .2 }); } } else if (ctx.t - q.at > .25) q.done[c.i] = 'miss'; }\n      if (c.local && s.inBand) { s.wh = (s.wh || 0) - dt; if (s.wh <= 0) { s.wh = .22; G.sfx('whirr', { vol: .15 + s.hoops * .03, pitch: .7 + sp * .07 }); } } }\n    ctx.tosses = ctx.tosses.filter(q => ctx.t - q.at < 1); if (ctx.t >= ctx.dur) ctx.done = true; },\n  animate(dt, ctx) { ctx.time = (ctx.time || 0) + dt; for (const c of ctx.contestants) { c.rig.mocap = null; c.rig.wob = [0, 0]; const ph = c.s.phase, on = Math.abs(c.s.w) > .5; c.rig.body = G.moves.hula(on ? ph : ctx.time * 1.2); G.place(c.rig, dt, c.x, c.y, 0, 1.57); }\n    if (ctx.okafor) { const cheer = ctx.local.s.inBand; ctx.okafor.mocap = G.sampleLoop(cheer ? 'Cheering_Two_Hands' : 'Idle_Subtle', ctx.time); G.place(ctx.okafor, dt, -118, -18, 0, 1.2); ctx.thrower.mocap = G.sampleLoop('Waiting_Loop', ctx.time); G.place(ctx.thrower, dt, 118, -18, 0, 1.9); } },\n  result(ctx, c) { return { pct: c.s.score / ctx.best, detail: 'Most hoops at once: ' + (c.s.maxH = Math.max(c.s.maxH || 1, c.s.hoops)) + '.' }; },\n  draw(r, ctx) { G.ROOMS.pier(r, game.real); for (const c of ctx.contestants) G.mat(r, c.x, c.y + 4, '#ffe2b8', 28 * c.slot.size / 2.1, 14); if (ctx.okafor) { r.shape('whyfit:kenney-holiday-bench', 0, -40, 0); G.actor(r, ctx.okafor); G.actor(r, ctx.thrower); }\n    for (const c of ctx.contestants) { const sz = c.slot.size / 2.1, s = c.s, hz = 12 * c.slot.size, phase = s.phase;\n      const ring = (frontHalf, idx) => { const col = HOOP_C[idx % HOOP_C.length], R = 16 * sz, zz = hz + idx * 1.6 * sz, ofx = Math.cos(phase + idx * .4) * 2.5 * sz, ofy = Math.sin(phase + idx * .4) * 1.2 * sz; const seg = 24; r.queue(c.x, c.y, zz, g => { const O = r.w(c.x + ofx, c.y + ofy, zz); for (let k = 0; k < seg; k++) { const a = k / seg * 6.283, front = Math.sin(a) > 0; if (front !== frontHalf) continue; px.rect(g, O[0] + Math.cos(a) * R * 1.5, O[1] + Math.sin(a) * R * .42, 2, 2, col); } }, { bias: frontHalf ? 6 : -6 }); };\n      for (let h = 0; h < s.hoops; h++) { ring(false, h); ring(true, h); } G.actor(r, c.rig, { shadow: 7 }); }\n    for (const q of ctx.tosses) { if (Object.keys(q.done).length >= ctx.contestants.length && ctx.t > q.at) continue; const c = ctx.contestants[0], u = clamp((ctx.t - q.from) / (q.at - q.from), 0, 1.15), x0 = q.side * 150, x = lerp(x0, c.x, u), z = 16 + Math.sin(Math.min(1, u) * Math.PI) * 60; r.queue(x, c.y - 1, z, g => { const O = r.w(x, c.y - 1, z); for (let k = 0; k < 20; k++) { const a = k / 20 * 6.283; px.rect(g, O[0] + Math.cos(a) * 12, O[1] + Math.sin(a) * 5, 2, 2, q.c); } }); }\n    G.drawGhosts(r, ctx); },\n  hud(g, r, ctx) { const one = ctx.contestants.length === 1; G.hudTop(g, r, one ? 'Hoops ' + ctx.local.s.hoops : null, G.fmtT(ctx.dur - ctx.t));\n    for (const c of ctx.contestants) { const q = r.w(c.x, c.y, 0), cx = one ? r.W / 2 : q[0], y = r.H - (one ? 26 : 22), w = one ? 150 : 60; const B = this.band(ctx, c), hi = B[1] * 1.5, v = Math.min(1, Math.abs(c.s.w) / hi); G.round(g, cx - w / 2 - 3, y - 3, w + 6, 12, '#ffffff'); const a = cx - w / 2 + B[0] / hi * w, b = cx - w / 2 + B[1] / hi * w; px.rect(g, a, y, b - a, 6, '#bfeee0'); px.rect(g, cx - w / 2 + v * w - 1, y - 2, 3, 10, c.s.state === 'good' ? '#17a57e' : '#e0553a'); if (one) G.text(g, c.s.state === 'good' ? 'Just right' : c.s.state === 'slow' ? 'Too slow' : 'Too eager', cx, y - 14, c.s.state === 'good' ? '#17a57e' : G.COL.INK, { align: 'center', scale: 2, shadow: '#fff' }); else G.text(g, c.name, cx, y - 14, c.color || G.COL.INK, { align: 'center' }); }\n    if (one) for (const q of ctx.tosses) { if (q.done[ctx.local.i] || Math.abs(ctx.t - q.at) > .6) continue; const near = Math.abs(ctx.t - q.at) <= .25; G.text(g, q.side < 0 ? '< Catch' : 'Catch >', r.W / 2 + q.side * 80, r.H * .36, near ? '#17a57e' : G.COL.MUT, { align: 'center', scale: 2, shadow: '#fff' }); } },\n  ghost(ctx) { const s = ctx.local.s; return { p: s.phase, w: [s.w, s.hoops], s: Math.round(s.score / ctx.best * 1000) }; },\n  ghostPose(rig, st) { rig.mocap = null; rig.body = G.moves.hula(st.p || 0); return 1.57; }\n});\nEOF\nsed -i \"s/r.shape('whyfit:kenney-holiday-bench', 0, -40, 0)/r.shape('whyfit:bench', 0, -40, 0)/\" game/activities/hoop.js\ngrep -o '\"[a-z-]*\":{' vendor/whyfit-props.js | head -0; node -e \"\nconst vm=require('vm'),fs=require('fs');const c={console,addEventListener(){},location:{hash:''}};c.window=c;vm.createContext(c);\nvm.runInContext(fs.readFileSync('engine/my-3d2dge.js','utf8'),c);vm.runInContext(fs.readFileSync('vendor/whyfit-props.js','utf8'),c);\nvm.runInContext('console.log(Object.keys(ASSETS.whyfit.shapes).join(\\\",\\\"),JSON.stringify(My3D2dge.addAssets(ASSETS.whyfit)).slice(0,300))',c)\"","description":"Write candle, rep, step and hoop activities; inspect prop ids"}}}
