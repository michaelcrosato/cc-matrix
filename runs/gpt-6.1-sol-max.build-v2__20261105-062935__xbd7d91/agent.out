{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"sed -n '20,63p' engine/crates/pav_core/src/props/mod.rs && sed -n '198,280p' engine/crates/pav_render/src/shaders/scene.wgsl && sed -n '980,995p' engine/crates/pav_core/src/clips.rs && rg -n 'pub fn.*ik|fn.*limb' engine/crates/pav_core/src/puppet.rs engine/crates/pav_core/src/ik.rs && tail -105 notes/check-core.log\"","aggregated_output":"use glam::{Quat, Vec3};\nuse serde::{Deserialize, Deserializer, Serialize};\nuse serde_json::Value;\n\nuse crate::color::Color;\nuse crate::issue::{self, Issue};\nuse crate::shape::{Look, Shape, Visual};\n\npub use compile::{CompiledProp, DEFAULT_ROLES, ResolvedPart};\npub use doc::Doc;\npub use family::{Params, apply_params, canonical_placed, patched, resolve_parts, resolve_placed, split_preset};\npub use patch::MAX_OPS;\npub use patch::v2::{OPS as OPS2, Patched, patch as patch_document};\n/// Format 2's field tables, legend and field guide.\npub use read::v2 as format2;\npub use read::{DOCUMENT_FIELDS, LOOKS, OPS, PART_FIELDS, SHAPES, check, migrate, schema, strict_value};\n/// Reader helpers the material reader shares, so both word their errors alike.\npub(crate) use read::{amount, color_fix, is_color, look_hint, number, wrong_type};\npub use store::{Tier, canonical, disk_root, editable, leaf};\npub use table::PropDefTable;\n/// The material writer shares the canonical layout of inline materials.\npub(crate) use write::{MaterialText, material_entries};\n\npub const MAX_PARTS: usize = 256;\nconst MAX_SIZE: f32 = 1_000.0;\nconst MAX_POSITION: f32 = 10_000.0;\nconst MIN_SIZE: f32 = 0.001;\n\npub const LEGEND: &str = \"Parts have stable lowercase names. Metres: x right, y up, z forward \\\n(+z is the object's front). The origin is the placement point, normally on the floor. pos is a \\\npart's centre. yaw, pitch and roll are degrees applied Y, then X, then Z, as room objects do: \\\n+yaw turns +z toward +x, +pitch tips +z down. Box half values are half extents. Cylinder and \\\ncapsule axes are local y; cylinder height is 2*half_height, capsule total height \\\n2*(half_height+radius). Colors are sRGB #rrggbb. look is flat, cel, lit, unlit, or cutout; \\\ncutout draws ordinary props flat. emissive adds glow. solid selects parts used by the \\\ninstance's collider. A set operation merges part fields and replaces shape as a complete \\\nobject. A batch is accepted or rejected as a whole.\";\n\n/// Local axis-aligned bounds after the requested uniform scale.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Bounds {\n    pub min: Vec3,\n    pub max: Vec3,\n}\n    }\n    return -g.forward.xyz;\n}\n\nfn quantize(x: f32, bands: f32) -> f32 {\n    // Hard-edged bands with a hair of smoothing to avoid shimmering.\n    let s = x * bands;\n    let f = floor(s);\n    return (f + smoothstep(0.45, 0.55, s - f)) / bands;\n}\n\n// `pbr`: a material's roughness and metallic; x < 0 keeps the legacy shading exactly.\nfn shade(p: vec3<f32>, n: vec3<f32>, albedo: vec3<f32>, emissive: f32, style: u32, flags: u32, pbr: vec2<f32>) -> vec3<f32> {\n    if (style == 3u) {\n        return apply_fog(p, albedo * max(1.0, 1.0 + emissive));\n    }\n    var sh = 1.0;\n    if ((flags & FLAG_NO_RECEIVE_SHADOW) == 0u) {\n        sh = shadow_factor(p, n);\n    }\n    let l = -g.sun_dir.xyz;\n    let ndl = dot(n, l);\n    let v = view_dir(p);\n    let hemi = mix(g.ground_color.rgb, g.sky_color.rgb, n.y * 0.5 + 0.5);\n    var col: vec3<f32>;\n    if (style == 0u) {\n        col = albedo * mix(g.style.x, 1.0, sh);\n    } else if (style == 1u) {\n        let lit = quantize(clamp(ndl, 0.0, 1.0) * sh, max(g.style.y - 1.0, 1.0));\n        let direct = step(0.02, ndl) * sh;\n        let amount = select(lit, direct, g.style.y <= 2.0);\n        let rim = step(0.72, 1.0 - max(dot(n, v), 0.0)) * g.style.z * (0.4 + 0.6 * amount);\n        col = albedo * (hemi + g.sun_color.rgb * amount) + albedo * rim;\n        if (pbr.x >= 0.0 && pbr.y > 0.0) {\n            // Metals in cel: a hard highlight band, tighter when smoother.\n            let hh = normalize(l + v);\n            let hl = step(mix(0.995, 0.93, pbr.x), dot(n, hh)) * sh;\n            col += g.sun_color.rgb * hl * pbr.y * mix(albedo, vec3<f32>(1.0), 0.5);\n        }\n    } else {\n        let dl = max(ndl, 0.0) * sh;\n        let h = normalize(l + v);\n        if (pbr.x < 0.0) {\n            let spec = pow(max(dot(n, h), 0.0), 40.0) * g.style.w * sh;\n            col = albedo * (hemi + g.sun_color.rgb * dl) + g.sun_color.rgb * spec;\n        } else {\n            let spec = pow(max(dot(n, h), 0.0), mix(80.0, 6.0, pbr.x)) * g.style.w * sh * (1.2 - pbr.x);\n            let tint = mix(vec3<f32>(1.0), albedo, pbr.y);\n            col = albedo * (1.0 - 0.6 * pbr.y) * (hemi + g.sun_color.rgb * dl) + g.sun_color.rgb * spec * tint;\n        }\n    }\n    let count = u32(g.params.y);\n    for (var i = 0u; i < count; i++) {\n        let pl = point_lights[i];\n        let d = pl.pos_radius.xyz - p;\n        let dist = length(d);\n        let r = pl.pos_radius.w;\n        if (dist < r) {\n            let ld = d / max(dist, 1e-4);\n            var att = pow(clamp(1.0 - dist / r, 0.0, 1.0), 2.0);\n            if (pl.color.w > 0.5 && (flags & FLAG_NO_RECEIVE_SHADOW) == 0u) {\n                att *= point_shadow_factor(u32(pl.color.w - 0.5), pl.pos_radius.xyz, p, n);\n            }\n            var k = max(dot(n, ld), 0.0) * att;\n            if (style == 0u) {\n                k = att;\n            } else if (style == 1u) {\n                k = quantize(k, 3.0);\n            }\n            col += albedo * pl.color.rgb * k;\n        }\n    }\n    col = col + albedo * emissive;\n    return apply_fog(p, col);\n}\n\nfn apply_fog(p: vec3<f32>, col: vec3<f32>) -> vec3<f32> {\n    if (g.fog.w < 0.5) {\n        return col;\n    }\n    let d = length(p.xz - g.fog2.xy);\n    return mix(col, g.fog.rgb, smoothstep(g.fog2.z, g.fog2.w, d));\n}\n    let id = find(name).unwrap_or(0);\n    map.insert(name.to_string(), id);\n    id\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn standing() -> Key {\n        Key {\n            hips: [0.0, 0.0, 100.0],\n            arm_l: [0.0, 0.0, -100.0, 10.0, 0.0],\n            arm_r: [0.0, 0.0, -100.0, 10.0, 0.0],\n            leg_l: [0.0, 0.0, -100.0, 5.0, 0.0],\n            leg_r: [0.0, 0.0, -100.0, 5.0, 0.0],\nrg: engine/crates/pav_core/src/ik.rs: No such file or directory (os error 2)\n","exit_code":2,"status":"failed"}}
