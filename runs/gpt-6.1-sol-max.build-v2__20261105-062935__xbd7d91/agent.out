], \"legR\":[-31,14,-94,9,-42], \"footL\":[5,8,0], \"footR\":[4,32,0]},\n  {\"t\":0.167,\n   \"hips\":[-11,-1,94], \"body\":[13,1,-1], \"chest\":[0,24,-2], \"head\":[-12,14,-1],\n   \"shL\":[7,-2], \"shR\":[-6,-3], \"armL\":[40,27,-88,45,21], \"armR\":[37,13,-92,69,-5],\n   \"legL\":[18,20,-96,33,5], \"legR\":[-20,13,-97,30,-36], \"footL\":[-1,8,0], \"footR\":[0,30,0]},\n  {\"t\":0.3,\n   \"hips\":[-12,-1,92], \"body\":[13,12,-4], \"chest\":[1,30,-3], \"head\":[-12,7,-1],\n   \"shL\":[6,-3], \"shR\":[-5,-3], \"armL\":[51,34,-79,42,38], \"armR\":[40,11,-91,72,-5],\n   \"legL\":[38,25,-89,46,5], \"legR\":[-1,8,-100,41,-38], \"footL\":[-12,8,0], \"footR\":[-9,26,0]},\n  {\"t\":0.433,\n   \"hips\":[-14,-1,90], \"body\":[14,21,-7], \"chest\":[1,36,-4], \"head\":[-12,2,-1],\n   \"shL\":[6,-3], \"shR\":[-6,-2], \"armL\":[69,33,-64,40,40], \"armR\":[36,14,-92,69,-3],\n   \"legL\":[54,30,-79,54,5], \"legR\":[16,3,-99,50,-38], \"footL\":[-22,8,0], \"footR\":[-16,24,-1]},\n  {\"t\":0.5,\n   \"hips\":[-15,-1,90], \"body\":[15,25,-7], \"chest\":[2,37,-7], \"head\":[-12,-1,0],\n   \"shL\":[6,-2], \"shR\":[-6,-3], \"armL\":[83,33,-44,45,37], \"armR\":[33,13,-93,66,-4],\n   \"legL\":[60,31,-74,54,5], \"legR\":[24,3,-97,52,-37], \"footL\":[-26,9,0], \"footR\":[-20,24,-2]},\n  {\"t\":0.567,\n   \"hips\":[-15,-1,90], \"body\":[15,26,-8], \"chest\":[2,38,-6], \"head\":[-13,-1,0],\n   \"shL\":[6,-2], \"shR\":[-6,-2], \"armL\":[94,34,-9,61,47], \"armR\":[30,15,-94,61,-2],\n   \"legL\":[61,32,-72,55,4], \"legR\":[26,2,-97,52,-37], \"footL\":[-27,9,0], \"footR\":[-20,23,-2]},\n  {\"t\":0.6,\n   \"hips\":[-15,-1,90], \"body\":[15,25,-8], \"chest\":[2,39,-6], \"head\":[-13,-2,-1],\n   \"shL\":[6,-3], \"shR\":[-6,-3], \"armL\":[94,32,10,71,50], \"armR\":[30,15,-94,61,-1],\n   \"legL\":[60,32,-73,55,4], \"legR\":[24,2,-97,52,-37], \"footL\":[-26,9,0], \"footR\":[-19,23,-2]},\n127:pub struct Clip {\n156:pub struct ClipSet {\n182:    pub fn parse(text: &str) -> Result<Self, String> {\n226:    pub fn text(&self) -> String {\n257:    pub fn text(&self) -> String {\n287:    pub fn to_text(&self) -> String {\n323:    pub fn key_at(&self, t: f32) -> Key {\n330:    pub fn key_at_clamped(&self, t: f32) -> Key {\n350:    pub fn travels(&self) -> bool {\n364:pub fn lerp_key(a: &Key, b: &Key, u: f32) -> Key {\n385:pub fn mirror(k: &Key) -> Key {\n412:pub fn euler(a: [f32; 3]) -> Quat {\n473:pub fn hip_height(def: &PuppetDef) -> f32 {\n480:pub fn walk_rate(def: &PuppetDef, id: u32, ground_speed: f32) -> f32 {\n486:pub fn pace(def: &PuppetDef, id: u32) -> Option<f32> {\n491:pub fn walk_pace(def: &PuppetDef) -> Option<f32> {\n503:pub fn run_over_walk(def: &PuppetDef, walk: u32, run: u32, ground_speed: f32, running: bool) -> bool {\n515:pub fn strike_time(id: u32) -> Option<f32> {\n557:pub fn attack_clip(def: &PuppetDef, skill: &str, combo: u32) -> Option<(u32, f32)> {\n567:pub fn is_attack(def: &PuppetDef, id: u32) -> bool {\n574:pub fn death_clip(def: &PuppetDef) -> Option<(u32, f32, f32)> {\n585:pub fn missing(def: &PuppetDef) -> Vec<String> {\n591:pub fn skel(def: &PuppetDef, k: &Key, travel: bool) -> Skel {\n678:pub fn lowest(def: &PuppetDef, sk: &Skel) -> f32 {\n695:pub fn blend(def: &PuppetDef, a: &Skel, b: &Skel, w: f32, upper: bool) -> Skel {\n753:pub fn pose_of(def: &PuppetDef, id: u32, t: f32, flags: u8) -> Option<Skel> {\n762:pub fn over(def: &PuppetDef, st: &PuppetState, base: Skel) -> Skel {\n779:pub fn clip_id(set: &str, clip: &str) -> u32 {\n790:pub struct ClipLib {\n798:    pub fn replacing_set(&self, set: ClipSet) -> Result<Self, String> {\n818:    pub fn add(&mut self, set: ClipSet) -> Result<(), String> {\n834:    pub fn get(&self, id: u32) -> Option<&Clip> {\n840:    pub fn name_of(&self, id: u32) -> Option<String> {\n846:    pub fn find(&self, name: &str) -> Option<u32> {\n862:    pub fn len(&self) -> usize {\n866:    pub fn is_empty(&self) -> bool {\n884:pub fn library() -> Arc<ClipLib> {\n894:pub fn reload() -> Result<(usize, usize), String> {\n905:pub fn replace_set(set: ClipSet) -> Result<(), String> {\n927:pub fn load_folder(sub: &str) -> Result<(usize, usize), String> {\n959:pub fn with<R>(id: u32, f: impl FnOnce(&Clip) -> R) -> Option<R> {\n967:pub fn find(name: &str) -> Option<u32> {\n974:pub fn find_cached(name: &str) -> u32 {\n384:    pub fn spawn_npc(\n                pos: center,\n                rot: Quat::IDENTITY,\n                body_kind: BodyKind::Kinematic,\n                body: Some(b),\n                visual: None,\n                prop: None,\n                behavior: Behavior::None,\n                character: Some(Box::new(ch)),\n                bomb: None,\n                lifetime: None,\n                region: None,\n                material: Default::default(),\n                hazard: None,\n                soft: None,\n                joints: Vec::new(),\n                ai: None,\n                vehicle: None,\n                health: None,\n            },\n        );\n        id\n    }\n\n    /// Creates a non-player character with its own look and (optionally) a brain.\n    pub fn spawn_npc(\n        &mut self,\n        name: &str,\n        feet: Vec3,\n        facing: f32,\n        def: PuppetDef,\n        ai: Option<crate::ai::Ai>,\n        region: Option<crate::statics::RegionKey>,\n    ) -> EntityId {\n        let id = self.spawn_character(name, feet);\n        if let Some(e) = self.state.entities.get_mut(id) {\n            e.region = region;\n            e.ai = ai.map(Box::new);\n            if let Some(ch) = &mut e.character {\n                ch.facing = facing;\n                ch.anim.facing = facing;\n                ch.puppet = Some(std::sync::Arc::new(def));\n            }\n        }\n        id\n    }\n\n    /// A character's kinematic capsule (when it is created or wakes up).\n    pub(crate) fn character_body(&mut self, id: EntityId, center: Vec3, posture: character::Posture) -> RigidBodyHandle {\n        let body = RigidBodyBuilder::kinematic_position_based().translation(center);\n        let collider =\n            ColliderBuilder::capsule_y(posture.half_height() as Real, RADIUS as Real).friction(0.0).user_data(entity_tag(id.0));\n        self.state.physics.insert(body, collider).0\n    }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"sed -n '75,182p' engine/crates/pav_core/src/clips.rs && rg -n 'pub struct Skel|pub struct Pose|pub enum Bone|pub .*arm|pub .*hand|pub .*shoulder' engine/crates/pav_core/src/puppet.rs | head -70 && sed -n '1,90p' engine/assets/props/lib/core/barrel.json && cat engine/crates/pav_core/src/props/store.rs | head -90 && rg -n 'kaykit|game' engine/crates/pav_core/build.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"sed -n '75,182p' engine/crates/pav_core/src/clips.rs && rg -n 'pub struct Skel|pub struct Pose|pub enum Bone|pub .*arm|pub .*hand|pub .*shoulder' engine/crates/pav_core/src/puppet.rs | head -70 && sed -n '1,90p' engine/assets/props/lib/core/barrel.json && cat engine/crates/pav_core/src/props/store.rs | head -90 && rg -n 'kaykit|game' engine/crates/pav_core/build.rs\"","aggregated_output":"}\n\n/// One key pose (see `LEGEND`).\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct Key {\n    pub t: f32,\n    pub hips: [f32; 3],\n    pub body: [f32; 3],\n    pub chest: [f32; 3],\n    pub head: [f32; 3],\n    #[serde(rename = \"shL\", default, skip_serializing_if = \"Option::is_none\")]\n    pub sh_l: Option<[f32; 2]>,\n    #[serde(rename = \"shR\", default, skip_serializing_if = \"Option::is_none\")]\n    pub sh_r: Option<[f32; 2]>,\n    #[serde(rename = \"armL\", deserialize_with = \"limb\")]\n    pub arm_l: [f32; 5],\n    #[serde(rename = \"armR\", deserialize_with = \"limb\")]\n    pub arm_r: [f32; 5],\n    #[serde(rename = \"legL\", deserialize_with = \"limb\")]\n    pub leg_l: [f32; 5],\n    #[serde(rename = \"legR\", deserialize_with = \"limb\")]\n    pub leg_r: [f32; 5],\n    #[serde(rename = \"footL\", default, skip_serializing_if = \"Option::is_none\")]\n    pub foot_l: Option<[f32; 3]>,\n    #[serde(rename = \"footR\", default, skip_serializing_if = \"Option::is_none\")]\n    pub foot_r: Option<[f32; 3]>,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub blade: Option<[f32; 3]>,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub root: Option<[f32; 2]>,\n}\n\n/// The legend every set file carries: what each number in a key pose means.\npub const LEGEND: &[&str] = &[\n    \"Readable key poses (the my-3D2dge format). Times in seconds; every other number is a whole number. Rig frame: forward, right, up.\",\n    \"L and R are the figure's own sides. Directions are percentages and need not add up: [100, 0, 0] and [50, 0, 0] agree.\",\n    \"hips   [forward, right, up]   the pelvis, in percent of standing hip height (100 = standing, 55 = sitting on a chair)\",\n    \"body   [turn, lean, tilt]     the pelvis, degrees: turn + = toward the right, lean + = forward, tilt + = toward the right\",\n    \"chest  [turn, lean, tilt]     the chest, relative to the pelvis; head [turn, lean, tilt] relative to the chest\",\n    \"shL shR    [reach, shrug]     degrees the shoulder swings forward (into a punch or an aim) and up, from rest\",\n    \"armL armR  [forward, out, up, bend, twist]  which way the arm points from the shoulder to the fist, in chest space (out + = away from the body on that side; [0, 0, -100] hangs down, [100, 0, 0] punches ahead); bend = elbow bend in degrees (0 = straight); twist = degrees the elbow swings round the arm from its natural direction (back and down)\",\n    \"legL legR  [forward, out, up, bend, twist]  hip to ankle in pelvis space; bend: the knee; twist: from pointing forward\",\n    \"footL footR [down, out, toes]   degrees the foot points down from standing, turns outward, and the toes bend up\",\n    \"blade  [forward, right, up]   (sword clips) the direction of a blade held in the right fist, in chest space\",\n    \"root   [forward, right]       (clips that travel) how far the whole body has moved, in percent of standing hip height\",\n    \"speed  (a clip's header: loops that walk or run in place) how fast the capture travelled, percent of standing hip height a second\",\n];\n\n/// One clip.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct Clip {\n    /// Its name within the set (filled in from the set's key when absent).\n    #[serde(default)]\n    pub clip: String,\n    /// Which of the set's sources it came from.\n    #[serde(default, skip_serializing_if = \"String::is_empty\")]\n    pub src: String,\n    /// What it was cut from: the source's own clip name, or a capture database's take.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub orig: Option<String>,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub take: Option<String>,\n    pub dur: f32,\n    #[serde(rename = \"loop\", default)]\n    pub looping: bool,\n    /// A loop that walks or runs in place: how fast its capture travelled, in percent of\n    /// standing hip height a second (`walk_rate` matches it to a character's ground speed).\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub speed: Option<f32>,\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub tags: Vec<String>,\n    #[serde(default, skip_serializing_if = \"String::is_empty\")]\n    pub desc: String,\n    pub keys: Vec<Key>,\n}\n\n/// A set: clips from one source family, with their credits.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct ClipSet {\n    pub set: String,\n    #[serde(default)]\n    pub title: String,\n    #[serde(default)]\n    pub format: u32,\n    #[serde(default)]\n    pub credit: String,\n    #[serde(default)]\n    pub legend: Vec<String>,\n    #[serde(default)]\n    pub fps: f32,\n    /// The libraries the clips came from: label, origin, license, url, and the body they were\n    /// measured on (`rest`, which this engine doesn't need: clips fit any body).\n    #[serde(default)]\n    pub sources: BTreeMap<String, serde_json::Value>,\n    /// Each clip's average and worst body-point error against its capture (mm).\n    #[serde(default)]\n    pub fit: BTreeMap<String, [f32; 2]>,\n    pub clips: BTreeMap<String, Clip>,\n}\n\nimpl ClipSet {\n    /// Parses a set file (`//` comment lines are allowed and skipped). Only format 1 is read: a\n    /// file that names another format, or a field this reader does not know, is refused, since\n    /// reading it as format 1 would drop what it says (format 2.0's `handL`, `spine`, `yaw`…).\n    pub fn parse(text: &str) -> Result<Self, String> {\n36:    pub enum OffhandKind {\n56:    pub offhand: OffhandKind,\n57:    pub offhand_color: String,\n104:    pub armor_color: String,\n160:    pub shoulder_width: f32,\n162:    pub arm_length: f32,\n173:    pub arm_swing: f32,\n1004:pub struct Skel {\n1018:    pub shoulder: [Vec3; 2],\n1020:    pub hand: [Vec3; 2],\n{\"format\":2,\"name\":\"barrel\",\"unit\":\"cm\",\n\"description\":\"An oak barrel of upright staves bound by four iron hoops, closed by a plank lid.\",\n\"tags\":[\"barrel\",\"wood\",\"storage\",\"cargo\",\"tavern\",\"dungeon\"],\n\"category\":\"container\",\n\"materials\":{\n\"brass\":{\"color\":\"#b08d3c\",\"roughness\":0.4,\"metallic\":0.7},\n\"iron\":\"MAT/wrought_iron\",\n\"lid\":\"MAT/oak_planks\",\n\"staves\":{\"base\":\"MAT/barrel_staves\",\"map\":\"axis\"}},\n\"parts\":{\n\"body\":{\"type\":\"lathe\",\"profile\":[[25,0],[27.3,10],[29.2,25],[30,45],[29.2,65],[27.3,80],[25,90]],\"segments\":16,\"mat\":\"staves\"},\n\"bung\":{\"type\":\"cylinder\",\"radius\":3,\"height\":2,\"pos\":[10,89.5,6],\"color\":\"#5a3a22\",\"chance\":0.6},\n\"hoop_low\":{\"type\":\"tube\",\"radius\":27.4,\"thickness\":1.6,\"height\":5,\"pos\":[0,6.5,0],\"mat\":\"iron\"},\n\"hoop_mid\":{\"type\":\"tube\",\"radius\":29.6,\"thickness\":1.6,\"height\":4,\"pos\":[0,22,0],\"mat\":\"iron\"},\n\"hoop_rim\":{\"type\":\"tube\",\"radius\":27.4,\"thickness\":1.6,\"height\":5,\"pos\":[0,83.5,0],\"mat\":\"iron\"},\n\"hoop_top\":{\"type\":\"tube\",\"radius\":29.6,\"thickness\":1.6,\"height\":4,\"pos\":[0,68,0],\"mat\":\"iron\"},\n\"lid\":{\"type\":\"cylinder\",\"radius\":24.6,\"height\":3,\"pos\":[0,87.5,0],\"mat\":\"lid\",\"color\":\"#9a6a3e\"}},\n\"params\":{\n\"bands\":{\"choices\":[\"iron\",\"brass\"],\"set\":{\"hoop_low.mat\":[\"iron\",\"brass\"],\"hoop_mid.mat\":[\"iron\",\"brass\"],\"hoop_rim.mat\":[\"iron\",\"brass\"],\"hoop_top.mat\":[\"iron\",\"brass\"]}}},\n\"presets\":{\n\"brass\":{\"bands\":\"brass\"}}}\n//! Where assets live (docs/ASSET_SYSTEM_PLAN.md §9.1).\n//!\n//! Names: `BUILTIN/<leaf>` (the templates), `WORKSHOP/<leaf>` and `WORKSHOP_LOCAL/<leaf>`\n//! (saved edits), `LIB/<pack>/<leaf>` (library packs: read-only, copy one to change it). A bare\n//! leaf is a workshop asset. Tiers: embedded in every build, the browser's included (the\n//! templates and `LIB/core`), disk (other packs under `lib/`: native builds read them on first\n//! use), local (`local/`, git-ignored: packs and workshop copies whose sources' licences forbid\n//! sharing them) and the workshop.\n\nuse std::path::{Path, PathBuf};\n\ninclude!(concat!(env!(\"OUT_DIR\"), \"/asset_data.rs\"));\n\n/// The embedded library pack.\npub const CORE: &str = \"core\";\n\n/// Where an asset is kept, and so which builds have it.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]\npub enum Tier {\n    /// In every build, the browser's included: the templates and `LIB/core`.\n    Embedded,\n    /// Committed packs under `assets/props/lib/`, read on first use by native builds.\n    Disk,\n    /// On this machine only (git-ignored): packs under `assets/props/local/`, `WORKSHOP_LOCAL`.\n    Local,\n    /// Saved edits, `WORKSHOP/` (native).\n    Workshop,\n}\n\nimpl Tier {\n    pub const NAMES: &'static [&'static str] = &[\"embedded\", \"disk\", \"local\", \"workshop\"];\n    const ALL: [Tier; 4] = [Tier::Embedded, Tier::Disk, Tier::Local, Tier::Workshop];\n\n    pub fn name(self) -> &'static str {\n        Self::NAMES[self as usize]\n    }\n\n    pub fn parse(text: &str) -> Option<Self> {\n        Self::NAMES.iter().position(|name| *name == text).map(|index| Self::ALL[index])\n    }\n}\n\nconst NAMES: &str = \"asset names are BUILTIN/name, WORKSHOP/name, WORKSHOP_LOCAL/name or LIB/pack/name\";\n\n/// Normalize a name: a bare leaf is a workshop asset; set prefixes are read in any case; packs\n/// and leaves are lowercase.\npub fn canonical(name: &str) -> Result<String, String> {\n    let segments: Vec<&str> = name.split('/').collect();\n    let (set, leaf) = match segments.as_slice() {\n        [leaf] => (\"WORKSHOP\".to_owned(), *leaf),\n        [set, leaf] => match set.to_ascii_uppercase().as_str() {\n            set @ (\"BUILTIN\" | \"WORKSHOP\" | \"WORKSHOP_LOCAL\") => (set.to_owned(), *leaf),\n            \"LIB\" => return Err(format!(\"LIB names a pack too: LIB/pack/name, e.g. LIB/core/{}\", leaf.to_ascii_lowercase())),\n            _ => return Err(NAMES.into()),\n        },\n        [set, pack, leaf] if set.eq_ignore_ascii_case(\"LIB\") => {\n            let pack = pack.to_ascii_lowercase();\n            validate_pack(&pack)?;\n            (format!(\"LIB/{pack}\"), *leaf)\n        }\n        _ => return Err(NAMES.into()),\n    };\n    let leaf = leaf.to_ascii_lowercase();\n    super::validate_name(&leaf)?;\n    Ok(format!(\"{set}/{leaf}\"))\n}\n\n/// A pack name: a lowercase letter, then up to 31 lowercase letters, digits or _. `workshop` is\n/// taken by `WORKSHOP_LOCAL`'s folder and `templates` by `assets reindex=templates`.\npub fn validate_pack(pack: &str) -> Result<(), String> {\n    let mut bytes = pack.bytes();\n    let ok = pack.len() <= 32\n        && bytes.next().is_some_and(|c| c.is_ascii_lowercase())\n        && bytes.all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == b'_');\n    if !ok {\n        return Err(format!(\"pack \\\"{pack}\\\": use a lowercase letter, then up to 31 lowercase letters, digits or _\"));\n    }\n    if pack == \"workshop\" {\n        return Err(\"pack \\\"workshop\\\" is reserved (local/workshop holds WORKSHOP_LOCAL)\".into());\n    }\n    if pack == \"templates\" {\n        return Err(\"pack \\\"templates\\\" is reserved (assets reindex=templates indexes BUILTIN)\".into());\n    }\n    Ok(())\n}\n\n/// The last segment of a name: the asset's own `name`.\npub fn leaf(name: &str) -> &str {\n    name.rsplit('/').next().unwrap_or(name)\n}\n2:// file is enough for it to ship; likewise game data, animation data and the embedded assets.\n7:    for data in [\"rooms\", \"game\", \"anim\"] {\n28:    // Game data (Shardfall): every .toml under /game, keyed by its path relative to /game\n30:    let game = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../../game\");\n31:    println!(\"cargo:rerun-if-changed={}\", game.display());\n33:    collect(&game, &mut files);\n35:    let out = std::path::Path::new(&std::env::var(\"OUT_DIR\").unwrap()).join(\"game_data.rs\");\n40:        let rel = p.strip_prefix(&game).unwrap().with_extension(\"\");\n102:    // game.\n105:    for folder in [\"templates\", \"lib/core\", \"lib/kaykit_adventurers\"] {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/merc/actions.rs <<'RS'\nuse glam::{Vec2,Vec3};\nuse crate::{Sim,SimEvent};\nuse super::{*,act,data::{distance,flat},weapons::jam_chance};\nimpl Merc{\n pub fn command(&mut self,sim:&mut Sim,a:u32,events:&mut Vec<SimEvent>){if a==0{return;}if self.finished&&self.session{return;}if a==act::ACTIVITY{return;}if a==act::START{self.start(self.merc);self.sync_player(sim);return;}if a==act::PAUSE{if self.screen==\\\"playing\\\"||self.screen==\\\"ending_defend\\\"{self.parent=self.screen.clone();self.open(if self.session{\\\"session_settings\\\"}else{\\\"pause\\\"});}else{self.open(\\\"playing\\\");}return;}\n if a&0xf0000000==act::SLIDER {let i=((a>>16)&255) as usize;let q=(a&65535) as f32/65535.;let mut pars=crate::params::list(&mut sim.config.merc);if let Some(p)=pars.get_mut(i){if let crate::params::ParamKind::Float{min,max}=p.kind{let _=crate::params::set(&mut sim.config.merc,&p.path,crate::params::ParamValue::Float((min+(max-min)*q) as f64));}}self.tuning=sim.config.merc.clone();return;}\n if a>=act::WAYPLACE&&a<act::WAYPLACE+100{let i=(a-act::WAYPLACE) as usize;if let Some(p)=self.data.world.place.get(i){self.waypoint=Some(p.pos());self.map_cursor=flat(p.pos());self.flag(\\\"waypoint_set\\\");}return;}\n if a>=act::BUY&&a<act::BUY+100 {self.buy((a-act::BUY) as usize);return;}\n if a>=act::TELEPORT&&a<act::TELEPORT+100&&\"'!self.session{let i=(a-act::TELEPORT) as usize;if let Some(p)=self.data.world.place.get(i){self.pos=p.pos()+Vec3::new(0.,0.,30.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z)+0.1;self.riding=None;self.sync_player(sim);}return;}\n if a>=act::STORY&&a<act::STORY+11&&!self.session {self.contract=(a-act::STORY) as usize;self.goal=0;self.contract_active=true;self.goal_time=0.;self.open(\"playing\");return;}\n if a>=act::SELECT&&a<act::SELECT+100{self.focus=(a-act::SELECT) as usize;self.select(sim,events);return;}\n if self.screen!=\"playing\"&&self.screen!=\"ending_defend\"&&self.screen!=\"card\" {self.menu_input(sim,a,events);return;}\n match a{\n act::BACK=>{if self.map_up{self.map_up=false;}else{self.parent=\"playing\".into();self.open(if self.session{\"session_settings\"}else{\"pause\"});}},\n act::MAP=>{self.map_up=!self.map_up;self.monocular=false;self.tracker=false;if self.map_up{self.flag(\"map_raised\");self.map_cursor=flat(self.pos);}},\n act::MONOCULAR=>{self.monocular=!self.monocular;self.map_up=false;self.tracker=false;self.tag_timer=0.;},\n act::TRACKER=>{self.tracker=!self.tracker;self.map_up=false;self.monocular=false;},\n act::NEXT_GUN=>{self.active=(self.active+1)%self.guns.len();self.map_up=false;self.monocular=false;self.tracker=false;self.ammo_time=3.;self.action=Some(Action{kind:\"draw\".into(),left:0.35,duration:0.35,param:0});},\n act::CROUCH=>{self.stance=if self.stance==1{0}else{1};},act::PRONE=>{self.stance=if self.stance==2{0}else{2};},\n act::RELOAD=>{if let Some(ac)=&mut self.action{if ac.kind==\"jam\"&&ac.left/ac.duration<0.6&&ac.left/ac.duration>0.3{ac.left*=0.6;self.sound(3);}return;}let g=&self.guns[self.active];let dur=if g.jammed{1.8}else{if g.ammo>=self.data.weapons[g.def].mag||g.reserve<=0{return;}match g.def{1=>3.6,7=>3.2,10=>4.2,11|13=>3.,_=>2.1}};self.action=Some(Action{kind:if g.jammed{\"jam\"}else{\"reload\"}.into(),left:dur,duration:dur,param:0});self.ammo_time=dur+3.;self.sound(2);},\n act::HEAL=>{if self.action.is_some(){return;}if self.health<20.{self.action=Some(Action{kind:format!(\"wound_{}\",self.wound),left:4.,duration:4.,param:self.wound as i32});self.sound(6);}else if self.syrettes>0&&self.health<100.{self.syrettes-=1;self.action=Some(Action{kind:\"syrette\".into(),left:1.5,duration:1.5,param:0});self.sound(5);}},\n act::PILL=>{if self.pills>0&&self.action.is_none(){self.pills-=1;self.action=Some(Action{kind:\"pills\".into(),left:2.5,duration:2.5,param:0});self.sound(7);}},\n act::THROW=>{if self.action.is_some()||self.safe_town(){return;}let frag=self.throw_frag;let n=if frag{&mut self.grenades}else{&mut self.molotov};if *n<=0{return;}*n-=1;self.action=Some(Action{kind:\"throw\".into(),left:0.65,duration:0.65,param:frag as i32});},\n act::MELEE=>{if self.action.is_some()||self.safe_town(){return;}self.action=Some(Action{kind:\"machete\".into(),left:0.5,duration:0.5,param:0});let p=self.eye_pos();let f=self.forward();let target=self.soldiers.iter().enumerate().filter(|(_,n)|n.hp>0.&&distance(n.pos,self.pos)<2.5&&(n.pos+Vec3::Y-p).normalize_or_zero().dot(f)>0.2).map(|(i,_)|i).next();if let Some(i)=target{let stealth=self.soldiers[i].state<2;self.hit_soldier(sim,i,if stealth{200.}else{70.},events);if stealth{self.flag(\"stealth_kill\");}}self.fire.cut.insert(fire::Fire::key(flat(self.pos+f*2.)),0.);self.sound(8);},\n act::INTERACT=>self.interact(sim,events),act::SEAT=>{if self.riding.is_some(){self.seat=1-self.seat;}},act::CAMERA=>{if self.riding.is_some(){self.chase=!self.chase;}else{self.command(sim,act::MELEE,events);}},\n act::PATCH=>self.companion_choice(false),act::OVERDOSE=>{self.action=Some(Action{kind:\"overdose\".into(),left:2.,duration:2.,param:0});},\n act::WAYPOINT=>{self.waypoint=Some(Vec3::new(self.map_cursor.x,0.,self.map_cursor.y));self.flag(\"waypoint_set\");},\n act::CARD=>{self.parent=\"playing\".into();self.open(\"contract\");},act::BURN=>self.choose_ending(1),act::READ=>self.choose_ending(2),act::CHAIR=>self.choose_ending(3),_=>{}}\n }\n pub fn damage(&mut self,amount:f32,cause:u8){if self.cheats.god||self.attracting||self.death||self.rescue_time>0.{return;}self.health=(self.health-amount).max(0.);self.wound=cause;self.damage_time=3.;if self.health<=0.{if self.session{self.rescue_time=45.;}else if let Some(c)=self.companions.iter_mut().find(|c|c.alive&&c.recruited&&!c.rescue){c.rescue=true;self.rescue_time=6.;self.action=None;}else{self.death=true;self.open(\"death\");}}}\n pub fn action_tick(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>){if let Some(a)=&mut self.action{a.left-=dt;if a.left>0.{return;}}else{return;}let a=self.action.take().unwrap();match a.kind.as_str(){\"jam\"=>{self.guns[self.active].jammed=false;self.flag(\"jam_cleared\");self.sound(3);},\"reload\"=>{let gun=&mut self.guns[self.active];let take=(self.data.weapons[gun.def].mag-gun.ammo).min(gun.reserve);gun.ammo+=take;gun.reserve-=take;self.sound(3);},\"pills\"=>{self.fever_state=0;self.fever_timer=self.tuning.fever_interval*0.9f32.powi(self.fever_attacks as i32);self.flag(\"pill_taken\");},\"syrette\"=>{self.health=(self.health+self.tuning.syrette_heal).min(100.);self.damage_time=3.;self.flag(\"syrette\");},\"repair\"=>{if let Some(i)=(a.param>=0).then_some(a.param as usize){if let Some(v)=self.vehicles.get_mut(i){v.hp=70.;v.fuse=-1.;self.flag(\"repair_done\");}}},\"throw\"=>{let mut p=self.pos+self.forward()*18.;p.y=terrain::height(&self.data,p.x,p.z);if a.param==1{self.explode(sim,p,6.,150.,events);self.fire.ignite(&self.data,flat(p),2.);self.flag(\"fire_frag\");}else{self.fire.ignite(&self.data,flat(p),4.);self.flag(\"fire_molotov\");}self.sound(9);},\"overdose\"=>self.companion_choice(true),k if k.starts_with(\"wound_\")=>{self.health=40.;self.damage_time=3.;self.flag(&format!(\"wound_{}\",a.param));},_=>{}}}\n pub fn shoot(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){if let Some(i)=self.riding{if self.seat==0{return;}if self.vehicles[i].kind==0||self.vehicles[i].kind==3{self.flag(\"mounted_gun_fired\");}}\n let wi=self.guns[self.active].def;let def=self.data.weapons[wi].clone();let gun=&mut self.guns[self.active];if gun.cooldown>0.||gun.jammed||gun.broken{return;}if gun.ammo<=0{gun.cooldown=0.25;self.sound(1);self.ammo_time=3.;return;}\n if !self.cheats.jams&&sim.state.rng.f32()<jam_chance(gun.condition)*self.tuning.jam{gun.jammed=true;gun.cooldown=0.2;self.sound(1);self.ammo_time=5.;return;}\n if !self.cheats.jams&&gun.condition<self.tuning.break_threshold&&sim.state.rng.f32()<0.03{gun.broken=true;self.action=Some(Action{kind:\"break\".into(),left:1.,duration:1.,param:0});self.active=(self.active+1)%3;self.flag(\"weapon_broke\");self.sound(10);return;}\n if !self.cheats.ammo{gun.ammo-=1;}gun.condition=(gun.condition-def.wear*self.tuning.wear*if self.reliability.contains(&wi){0.7}else{1.}).max(0.);gun.cooldown=60./def.rpm;let condition=gun.condition;\n self.flash=0.06;self.recoil+=if self.aiming{0.009}else{0.022};self.pitch=(self.pitch+self.recoil).min(1.48);self.sound(20+(wi%5) as u8);self.ammo_time=if self.guns[self.active].ammo<6{2.}else{self.ammo_time};\n let spread=(if self.aiming{0.0015}else{0.009})*(1.+(1.-condition/100.)*0.8)*if self.fever_state==2{3.}else{1.};let mut dir=self.forward()+Vec3::new(sim.state.rng.range(-spread,spread),sim.state.rng.range(-spread,spread),sim.state.rng.range(-spread,spread));dir=dir.normalize();let origin=self.eye_pos();let reach=def.range.max(80.);let wall=crate::projectile::static_hit(&sim.state.physics,origin,dir,reach,None).unwrap_or(reach);let mut best=(wall,None,1.);\n for (i,n) in self.soldiers.iter().enumerate(){if n.hp<=0.{continue;}let center=n.pos+Vec3::Y*0.95;let t=(center-origin).dot(dir);if t<0.||t>best.0{continue;}let hit=origin+dir*t-Vec3::Y*(0.000035*(t-150.).max(0.).powi(2));let dy=hit.y-n.pos.y;let radius=if dy>1.42{0.22}else{0.38};if flat(hit-center).length()<radius&&dy>0.12&&dy<1.88{best=(t,Some(i),if dy>1.42{3.}else if dy<0.6{0.6}else{1.});}}\n let end=origin+dir*best.0;let mut object_hit=None;for (i,o) in self.objects.iter().enumerate(){let t=(o.pos+Vec3::Y-origin).dot(dir);if !o.exploded&&t>0.&&t<best.0&&(o.pos+Vec3::Y-(origin+dir*t)).length()<if o.kind==1{3.}else{0.7}{object_hit=Some(i);best.0=t;}}\n if self.session&&!self.host {self.traces_push(origin,end,false);return;}\n if let Some(i)=object_hit{self.objects[i].hp-=def.damage;if self.objects[i].hp<=0. {self.objects[i].fuse=0.;}}else if let Some(i)=best.1{if wi==9{self.soldiers[i].poison=3.;self.flag(\"dart_hit\");}else{self.hit_soldier(sim,i,def.damage*best.2*self.tuning.player_damage,events);}self.hit_time=0.18;}\n if def.igniter>0{self.fire.ignite(&self.data,flat(end),if wi==12{2.5}else{4.});self.flag(match def.igniter{1=>\"fire_flare\",2=>\"fire_rocket\",3=>\"fire_flamer\",_=>\"fire_mortar\"});if def.igniter==2||def.igniter==4{self.explode(sim,end,if def.igniter==4{8.}else{6.},def.damage,events);}}\n for v in &mut self.vehicles{let t=(v.pos+Vec3::Y-origin).dot(dir);if !v.exploded&&t>0.&&t<wall&&(v.pos+Vec3::Y-(origin+dir*t)).length()<1.8{v.hp-=def.damage*0.35/self.tuning.vehicle_toughness;}}\n self.traces_push(origin,end,best.1.is_some());self.noise(origin,def.noise);\n if self.contract==1&&!self.coverage.contains(\"first_jam\"){self.guns[self.active].jammed=true;self.flag(\"first_jam\");}\n }\n pub fn traces_push(&mut self,a:Vec3,z:Vec3,hit:bool){self.net_trace(a,z,hit);}\n pub fn hit_soldier(&mut self,sim:&mut Sim,i:usize,damage:f32,events:&mut Vec<SimEvent>){if self.soldiers[i].hp<=0.{return;}self.soldiers[i].hp-=damage;let pos=self.soldiers[i].pos;events.push(SimEvent::Hit{pos:pos+Vec3::Y,strength:0.5,target:None});if self.soldiers[i].hp<=0.{self.kills+=1;self.team_score+=10;self.soldiers[i].state=5;if self.soldiers[i].poison>0.{self.flag(\"dart_kill\");}if let Some(id)=self.soldiers[i].entity.take(){sim.despawn(id);}events.push(SimEvent::Slain{pos,size:0.8});if self.soldiers[i].role==4{self.explode(sim,pos,4.,70.,events);}if self.contract==1&&self.kills==3&&!self.coverage.contains(\"player_rescued\"){self.damage(200.,0);}}else{self.soldiers[i].state=2;self.soldiers[i].detection=1.;}}\n pub fn explode(&mut self,sim:&mut Sim,p:Vec3,r:f32,damage:f32,events:&mut Vec<SimEvent>){events.push(SimEvent::Explosion{pos:p+Vec3::Y,radius:r});self.sound(30);self.fire.ignite(&self.data,flat(p),r*0.6);self.flag(\"fire_explosion\");let targets:Vec<_>=self.soldiers.iter().enumerate().filter(|(_,n)|n.hp>0.&&distance(n.pos,p)<r).map(|(i,_)|i).collect();for i in targets{self.hit_soldier(sim,i,damage,events);}if distance(self.pos,p)<r{self.damage(damage*0.25,1);}for o in &mut self.objects{if !o.exploded&&distance(o.pos,p)<r*1.6{o.hp-=damage;if o.hp<=0.{o.fuse=0.25;}}}for v in &mut self.vehicles{if !v.exploded&&distance(v.pos,p)<r*1.6{v.hp-=damage*0.3/self.tuning.vehicle_toughness;}}}\n pub fn noise(&mut self,p:Vec3,r:f32){for n in &mut self.soldiers{if n.hp>0.&&distance(n.pos,p)<r&&n.state<2{n.state=1;n.timer=10.;}}for a in &mut self.animals{if distance(a.pos,p)<r{a.fleeing=8.;}}if self.animals.iter().any(|a|a.fleeing>0.){self.flag(\"animals_fled\");}}\n pub fn tag(&mut self,dt:f32){let origin=self.eye_pos();let f=self.forward();let target=self.soldiers.iter().enumerate().filter(|(_,n)|n.hp>0.&&(n.pos+Vec3::Y-origin).normalize_or_zero().dot(f)>0.995).map(|(i,_)|i).next();if self.tag_target==target{self.tag_timer+=dt;}else{self.tag_timer=0.;self.tag_target=target;}if self.tag_timer>0.5{if let Some(i)=target{self.soldiers[i].tagged=true;self.flag(\"monocular_tag\");}}}\n pub fn tracker_rate(&self)->f32{let dist=self.caches.iter().filter(|c|!c.found).map(|c|distance(c.pos,self.pos)).fold(1000.,f32::min);if dist>60.{0.}else{1./(0.12+(dist/60.).powi(2)*1.5)}}\n pub fn prompt(&self)->Option<String>{if self.riding.is_some(){return Some(\"Leave vehicle · change seat\".into());}if self.companions.iter().any(|c|c.alive&&c.down>0.&&distance(c.pos,self.pos)<5.){return Some(\"Help companion\".into());}if self.vehicles.iter().any(|v|!v.exploded&&distance(v.pos,self.pos)<5.5){return Some(\"Drive / hold at hood to repair\".into());}if self.caches.iter().any(|c|!c.found&&distance(c.pos,self.pos)<4.){return Some(\"Open diamond case\".into());}let p=self.data.world.place.iter().min_by(|a,b|distance(a.pos(),self.pos).total_cmp(&distance(b.pos(),self.pos)))?;if distance(p.pos(),self.pos)<if p.kind==2{75.}else{27.}{Some(p.name.clone())}else{None}}\n pub fn interact(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){if let Some(i)=self.riding.take(){self.pos=self.vehicles[i].pos+Vec3::new(3.,0.,0.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.sync_player(sim);return;}\n if self.session{if let Some(p)=self.peers.iter_mut().find(|p|p.present&&p.hp<=0.&&distance(p.pos,self.pos)<5.){if self.syrettes>0{self.syrettes-=1;p.hp=50.;p.down=0.;self.team_score+=25;self.flag(\"player_rescued\");return;}}}\n if self.companions.iter().any(|c|c.alive&&c.down>0.&&distance(c.pos,self.pos)<5.){self.open(\"companion\");return;}\n if let Some(i)=self.caches.iter().position(|c|!c.found&&distance(c.pos,self.pos)<4.){self.caches[i].found=true;self.diamonds+=self.caches[i].value;if self.tracker{self.flag(\"cache_tracker\");}self.sound(32);self.note(format!(\"+{} diamonds\",self.caches[i].value));return;}\n if self.interact_goal(sim,events){return;}\n if let Some(i)=self.vehicles.iter().position(|v|!v.exploded&&distance(v.pos,self.pos)<5.5){if self.vehicles[i].hp<70.{self.action=Some(Action{kind:\"repair\".into(),left:if self.upgrades.contains(&2){3.6}else{6.},duration:6.,param:i as i32});self.sound(11);}else{self.riding=Some(i);self.seat=0;self.map_up=false;self.pos=self.vehicles[i].pos;self.flag(if self.vehicles[i].kind==3{\"boat_driven\"}else{\"technical_driven\"});}return;}\n if let Some(i)=self.soldiers.iter().position(|n|n.hp<=0.&&distance(n.pos,self.pos)<3.5){self.guns[1]=self.soldiers[i].gun.clone();self.guns[1].ammo=30;self.guns[1].reserve+=60;self.active=1;self.note(\"A used rifle. Its previous owner cannot recommend it.\");return;}\n let p=self.data.world.place.iter().min_by(|a,b|distance(a.pos(),self.pos).total_cmp(&distance(b.pos(),self.pos))).cloned();if let Some(p)=p{if distance(p.pos(),self.pos)>80.{return;}match p.kind{2=>{self.open(\"town\");},3=>{let clear=self.soldiers.iter().all(|n|n.group!=self.data.world.place.iter().position(|q|q.id==p.id).unwrap()||n.hp<=0.);if clear{if let Some(post)=self.posts.iter_mut().find(|a|a.place==p.id){post.claimed=true;}self.flag(\"safe_house_claimed\");self.open(\"safehouse\");}else{self.note(\"The bed is occupied. Clear the guards.\");}},5=>{self.pills=3;self.say(\"Sister Perpetua\",self.s(\"clinic\").to_string());self.open(\"clinic\");},8=>self.open(\"bus\"),_=>{self.collect_tape(&p.id);}}}}\n pub fn companion_choice(&mut self,mercy:bool){if let Some(c)=self.companions.iter_mut().find(|c|c.alive&&c.down>0.&&distance(c.pos,self.pos)<6.){if mercy||c.mortal{c.alive=false;c.down=0.;self.flag(\"companion_overdosed\");self.flag(\"companion_died\");self.say(\"Companion\",self.s(\"mercy\").to_string());}else if self.syrettes>0{self.syrettes-=1;c.down=0.;c.trust+=2;self.flag(\"companion_patched\");self.say(\"Companion\",\"Put it on the account.\");}self.goal_flag=true;self.open(\"playing\");}}\n pub fn buy(&mut self,index:usize){let cost=if index<14{if self.owned.contains(&index){return;}[5,5,4,5,8,10,8,8,12,10,12,12,14,12][index]}else{[6,6,6,8,10,5,7,7][(index-14).min(7)]};let cost=cost+(self.infamy/5).min(3);if self.diamonds<cost{self.note(self.s(\"no_money\").to_string());return;}self.diamonds-=cost;self.flag(\"diamonds_spent\");if index<14{self.owned.insert(index);let slot=self.data.weapons[index].slot;self.guns[slot]=Gun::new(index,&self.data.weapons[index],100.);self.flag(\"weapon_bought\");}else{match index{14=>{self.reliability.insert(self.guns[self.active].def);},15=>{self.accuracy.insert(self.guns[self.active].def);},16..=19=>{self.upgrades.insert(index-16);},_=>self.pills+=3}}self.goal_flag=true;self.sound(32);self.note(\"Paid in diamonds. Take a fresh crate at any locker.\");}\n pub fn collect_tape(&mut self,place:&str){if let Some(i)=self.data.tapes.iter().position(|t|t.place==place){self.tapes.insert(i);self.playing_tape=Some(i);self.tape_line=0;self.tape_timer=0.;self.flag(\"tape_played\");}}\n pub fn tape_tick(&mut self,dt:f32){if let Some(i)=self.playing_tape{self.tape_timer-=dt;if self.tape_timer<=0.{let t=self.data.tapes[i].clone();if let Some(line)=t.lines.get(self.tape_line){self.say(if self.tape_line%2==0{\"The Chandler\"}else{\"Thandiwe Moyo\"},line.clone());self.tape_line+=1;self.tape_timer=5.5;}else{self.playing_tape=None;}}}}\n}\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/merc/actions.rs <<'RS'\nuse glam::{Vec2,Vec3};\nuse crate::{Sim,SimEvent};\nuse super::{*,act,data::{distance,flat},weapons::jam_chance};\nimpl Merc{\n pub fn command(&mut self,sim:&mut Sim,a:u32,events:&mut Vec<SimEvent>){if a==0{return;}if self.finished&&self.session{return;}if a==act::ACTIVITY{return;}if a==act::START{self.start(self.merc);self.sync_player(sim);return;}if a==act::PAUSE{if self.screen==\\\"playing\\\"||self.screen==\\\"ending_defend\\\"{self.parent=self.screen.clone();self.open(if self.session{\\\"session_settings\\\"}else{\\\"pause\\\"});}else{self.open(\\\"playing\\\");}return;}\n if a&0xf0000000==act::SLIDER {let i=((a>>16)&255) as usize;let q=(a&65535) as f32/65535.;let mut pars=crate::params::list(&mut sim.config.merc);if let Some(p)=pars.get_mut(i){if let crate::params::ParamKind::Float{min,max}=p.kind{let _=crate::params::set(&mut sim.config.merc,&p.path,crate::params::ParamValue::Float((min+(max-min)*q) as f64));}}self.tuning=sim.config.merc.clone();return;}\n if a>=act::WAYPLACE&&a<act::WAYPLACE+100{let i=(a-act::WAYPLACE) as usize;if let Some(p)=self.data.world.place.get(i){self.waypoint=Some(p.pos());self.map_cursor=flat(p.pos());self.flag(\\\"waypoint_set\\\");}return;}\n if a>=act::BUY&&a<act::BUY+100 {self.buy((a-act::BUY) as usize);return;}\n if a>=act::TELEPORT&&a<act::TELEPORT+100&&\"'!self.session{let i=(a-act::TELEPORT) as usize;if let Some(p)=self.data.world.place.get(i){self.pos=p.pos()+Vec3::new(0.,0.,30.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z)+0.1;self.riding=None;self.sync_player(sim);}return;}\n if a>=act::STORY&&a<act::STORY+11&&!self.session {self.contract=(a-act::STORY) as usize;self.goal=0;self.contract_active=true;self.goal_time=0.;self.open(\"playing\");return;}\n if a>=act::SELECT&&a<act::SELECT+100{self.focus=(a-act::SELECT) as usize;self.select(sim,events);return;}\n if self.screen!=\"playing\"&&self.screen!=\"ending_defend\"&&self.screen!=\"card\" {self.menu_input(sim,a,events);return;}\n match a{\n act::BACK=>{if self.map_up{self.map_up=false;}else{self.parent=\"playing\".into();self.open(if self.session{\"session_settings\"}else{\"pause\"});}},\n act::MAP=>{self.map_up=!self.map_up;self.monocular=false;self.tracker=false;if self.map_up{self.flag(\"map_raised\");self.map_cursor=flat(self.pos);}},\n act::MONOCULAR=>{self.monocular=!self.monocular;self.map_up=false;self.tracker=false;self.tag_timer=0.;},\n act::TRACKER=>{self.tracker=!self.tracker;self.map_up=false;self.monocular=false;},\n act::NEXT_GUN=>{self.active=(self.active+1)%self.guns.len();self.map_up=false;self.monocular=false;self.tracker=false;self.ammo_time=3.;self.action=Some(Action{kind:\"draw\".into(),left:0.35,duration:0.35,param:0});},\n act::CROUCH=>{self.stance=if self.stance==1{0}else{1};},act::PRONE=>{self.stance=if self.stance==2{0}else{2};},\n act::RELOAD=>{if let Some(ac)=&mut self.action{if ac.kind==\"jam\"&&ac.left/ac.duration<0.6&&ac.left/ac.duration>0.3{ac.left*=0.6;self.sound(3);}return;}let g=&self.guns[self.active];let dur=if g.jammed{1.8}else{if g.ammo>=self.data.weapons[g.def].mag||g.reserve<=0{return;}match g.def{1=>3.6,7=>3.2,10=>4.2,11|13=>3.,_=>2.1}};self.action=Some(Action{kind:if g.jammed{\"jam\"}else{\"reload\"}.into(),left:dur,duration:dur,param:0});self.ammo_time=dur+3.;self.sound(2);},\n act::HEAL=>{if self.action.is_some(){return;}if self.health<20.{self.action=Some(Action{kind:format!(\"wound_{}\",self.wound),left:4.,duration:4.,param:self.wound as i32});self.sound(6);}else if self.syrettes>0&&self.health<100.{self.syrettes-=1;self.action=Some(Action{kind:\"syrette\".into(),left:1.5,duration:1.5,param:0});self.sound(5);}},\n act::PILL=>{if self.pills>0&&self.action.is_none(){self.pills-=1;self.action=Some(Action{kind:\"pills\".into(),left:2.5,duration:2.5,param:0});self.sound(7);}},\n act::THROW=>{if self.action.is_some()||self.safe_town(){return;}let frag=self.throw_frag;let n=if frag{&mut self.grenades}else{&mut self.molotov};if *n<=0{return;}*n-=1;self.action=Some(Action{kind:\"throw\".into(),left:0.65,duration:0.65,param:frag as i32});},\n act::MELEE=>{if self.action.is_some()||self.safe_town(){return;}self.action=Some(Action{kind:\"machete\".into(),left:0.5,duration:0.5,param:0});let p=self.eye_pos();let f=self.forward();let target=self.soldiers.iter().enumerate().filter(|(_,n)|n.hp>0.&&distance(n.pos,self.pos)<2.5&&(n.pos+Vec3::Y-p).normalize_or_zero().dot(f)>0.2).map(|(i,_)|i).next();if let Some(i)=target{let stealth=self.soldiers[i].state<2;self.hit_soldier(sim,i,if stealth{200.}else{70.},events);if stealth{self.flag(\"stealth_kill\");}}self.fire.cut.insert(fire::Fire::key(flat(self.pos+f*2.)),0.);self.sound(8);},\n act::INTERACT=>self.interact(sim,events),act::SEAT=>{if self.riding.is_some(){self.seat=1-self.seat;}},act::CAMERA=>{if self.riding.is_some(){self.chase=!self.chase;}else{self.command(sim,act::MELEE,events);}},\n act::PATCH=>self.companion_choice(false),act::OVERDOSE=>{self.action=Some(Action{kind:\"overdose\".into(),left:2.,duration:2.,param:0});},\n act::WAYPOINT=>{self.waypoint=Some(Vec3::new(self.map_cursor.x,0.,self.map_cursor.y));self.flag(\"waypoint_set\");},\n act::CARD=>{self.parent=\"playing\".into();self.open(\"contract\");},act::BURN=>self.choose_ending(1),act::READ=>self.choose_ending(2),act::CHAIR=>self.choose_ending(3),_=>{}}\n }\n pub fn damage(&mut self,amount:f32,cause:u8){if self.cheats.god||self.attracting||self.death||self.rescue_time>0.{return;}self.health=(self.health-amount).max(0.);self.wound=cause;self.damage_time=3.;if self.health<=0.{if self.session{self.rescue_time=45.;}else if let Some(c)=self.companions.iter_mut().find(|c|c.alive&&c.recruited&&!c.rescue){c.rescue=true;self.rescue_time=6.;self.action=None;}else{self.death=true;self.open(\"death\");}}}\n pub fn action_tick(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>){if let Some(a)=&mut self.action{a.left-=dt;if a.left>0.{return;}}else{return;}let a=self.action.take().unwrap();match a.kind.as_str(){\"jam\"=>{self.guns[self.active].jammed=false;self.flag(\"jam_cleared\");self.sound(3);},\"reload\"=>{let gun=&mut self.guns[self.active];let take=(self.data.weapons[gun.def].mag-gun.ammo).min(gun.reserve);gun.ammo+=take;gun.reserve-=take;self.sound(3);},\"pills\"=>{self.fever_state=0;self.fever_timer=self.tuning.fever_interval*0.9f32.powi(self.fever_attacks as i32);self.flag(\"pill_taken\");},\"syrette\"=>{self.health=(self.health+self.tuning.syrette_heal).min(100.);self.damage_time=3.;self.flag(\"syrette\");},\"repair\"=>{if let Some(i)=(a.param>=0).then_some(a.param as usize){if let Some(v)=self.vehicles.get_mut(i){v.hp=70.;v.fuse=-1.;self.flag(\"repair_done\");}}},\"throw\"=>{let mut p=self.pos+self.forward()*18.;p.y=terrain::height(&self.data,p.x,p.z);if a.param==1{self.explode(sim,p,6.,150.,events);self.fire.ignite(&self.data,flat(p),2.);self.flag(\"fire_frag\");}else{self.fire.ignite(&self.data,flat(p),4.);self.flag(\"fire_molotov\");}self.sound(9);},\"overdose\"=>self.companion_choice(true),k if k.starts_with(\"wound_\")=>{self.health=40.;self.damage_time=3.;self.flag(&format!(\"wound_{}\",a.param));},_=>{}}}\n pub fn shoot(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){if let Some(i)=self.riding{if self.seat==0{return;}if self.vehicles[i].kind==0||self.vehicles[i].kind==3{self.flag(\"mounted_gun_fired\");}}\n let wi=self.guns[self.active].def;let def=self.data.weapons[wi].clone();let gun=&mut self.guns[self.active];if gun.cooldown>0.||gun.jammed||gun.broken{return;}if gun.ammo<=0{gun.cooldown=0.25;self.sound(1);self.ammo_time=3.;return;}\n if !self.cheats.jams&&sim.state.rng.f32()<jam_chance(gun.condition)*self.tuning.jam{gun.jammed=true;gun.cooldown=0.2;self.sound(1);self.ammo_time=5.;return;}\n if !self.cheats.jams&&gun.condition<self.tuning.break_threshold&&sim.state.rng.f32()<0.03{gun.broken=true;self.action=Some(Action{kind:\"break\".into(),left:1.,duration:1.,param:0});self.active=(self.active+1)%3;self.flag(\"weapon_broke\");self.sound(10);return;}\n if !self.cheats.ammo{gun.ammo-=1;}gun.condition=(gun.condition-def.wear*self.tuning.wear*if self.reliability.contains(&wi){0.7}else{1.}).max(0.);gun.cooldown=60./def.rpm;let condition=gun.condition;\n self.flash=0.06;self.recoil+=if self.aiming{0.009}else{0.022};self.pitch=(self.pitch+self.recoil).min(1.48);self.sound(20+(wi%5) as u8);self.ammo_time=if self.guns[self.active].ammo<6{2.}else{self.ammo_time};\n let spread=(if self.aiming{0.0015}else{0.009})*(1.+(1.-condition/100.)*0.8)*if self.fever_state==2{3.}else{1.};let mut dir=self.forward()+Vec3::new(sim.state.rng.range(-spread,spread),sim.state.rng.range(-spread,spread),sim.state.rng.range(-spread,spread));dir=dir.normalize();let origin=self.eye_pos();let reach=def.range.max(80.);let wall=crate::projectile::static_hit(&sim.state.physics,origin,dir,reach,None).unwrap_or(reach);let mut best=(wall,None,1.);\n for (i,n) in self.soldiers.iter().enumerate(){if n.hp<=0.{continue;}let center=n.pos+Vec3::Y*0.95;let t=(center-origin).dot(dir);if t<0.||t>best.0{continue;}let hit=origin+dir*t-Vec3::Y*(0.000035*(t-150.).max(0.).powi(2));let dy=hit.y-n.pos.y;let radius=if dy>1.42{0.22}else{0.38};if flat(hit-center).length()<radius&&dy>0.12&&dy<1.88{best=(t,Some(i),if dy>1.42{3.}else if dy<0.6{0.6}else{1.});}}\n let end=origin+dir*best.0;let mut object_hit=None;for (i,o) in self.objects.iter().enumerate(){let t=(o.pos+Vec3::Y-origin).dot(dir);if !o.exploded&&t>0.&&t<best.0&&(o.pos+Vec3::Y-(origin+dir*t)).length()<if o.kind==1{3.}else{0.7}{object_hit=Some(i);best.0=t;}}\n if self.session&&!self.host {self.traces_push(origin,end,false);return;}\n if let Some(i)=object_hit{self.objects[i].hp-=def.damage;if self.objects[i].hp<=0. {self.objects[i].fuse=0.;}}else if let Some(i)=best.1{if wi==9{self.soldiers[i].poison=3.;self.flag(\"dart_hit\");}else{self.hit_soldier(sim,i,def.damage*best.2*self.tuning.player_damage,events);}self.hit_time=0.18;}\n if def.igniter>0{self.fire.ignite(&self.data,flat(end),if wi==12{2.5}else{4.});self.flag(match def.igniter{1=>\"fire_flare\",2=>\"fire_rocket\",3=>\"fire_flamer\",_=>\"fire_mortar\"});if def.igniter==2||def.igniter==4{self.explode(sim,end,if def.igniter==4{8.}else{6.},def.damage,events);}}\n for v in &mut self.vehicles{let t=(v.pos+Vec3::Y-origin).dot(dir);if !v.exploded&&t>0.&&t<wall&&(v.pos+Vec3::Y-(origin+dir*t)).length()<1.8{v.hp-=def.damage*0.35/self.tuning.vehicle_toughness;}}\n self.traces_push(origin,end,best.1.is_some());self.noise(origin,def.noise);\n if self.contract==1&&!self.coverage.contains(\"first_jam\"){self.guns[self.active].jammed=true;self.flag(\"first_jam\");}\n }\n pub fn traces_push(&mut self,a:Vec3,z:Vec3,hit:bool){self.net_trace(a,z,hit);}\n pub fn hit_soldier(&mut self,sim:&mut Sim,i:usize,damage:f32,events:&mut Vec<SimEvent>){if self.soldiers[i].hp<=0.{return;}self.soldiers[i].hp-=damage;let pos=self.soldiers[i].pos;events.push(SimEvent::Hit{pos:pos+Vec3::Y,strength:0.5,target:None});if self.soldiers[i].hp<=0.{self.kills+=1;self.team_score+=10;self.soldiers[i].state=5;if self.soldiers[i].poison>0.{self.flag(\"dart_kill\");}if let Some(id)=self.soldiers[i].entity.take(){sim.despawn(id);}events.push(SimEvent::Slain{pos,size:0.8});if self.soldiers[i].role==4{self.explode(sim,pos,4.,70.,events);}if self.contract==1&&self.kills==3&&!self.coverage.contains(\"player_rescued\"){self.damage(200.,0);}}else{self.soldiers[i].state=2;self.soldiers[i].detection=1.;}}\n pub fn explode(&mut self,sim:&mut Sim,p:Vec3,r:f32,damage:f32,events:&mut Vec<SimEvent>){events.push(SimEvent::Explosion{pos:p+Vec3::Y,radius:r});self.sound(30);self.fire.ignite(&self.data,flat(p),r*0.6);self.flag(\"fire_explosion\");let targets:Vec<_>=self.soldiers.iter().enumerate().filter(|(_,n)|n.hp>0.&&distance(n.pos,p)<r).map(|(i,_)|i).collect();for i in targets{self.hit_soldier(sim,i,damage,events);}if distance(self.pos,p)<r{self.damage(damage*0.25,1);}for o in &mut self.objects{if !o.exploded&&distance(o.pos,p)<r*1.6{o.hp-=damage;if o.hp<=0.{o.fuse=0.25;}}}for v in &mut self.vehicles{if !v.exploded&&distance(v.pos,p)<r*1.6{v.hp-=damage*0.3/self.tuning.vehicle_toughness;}}}\n pub fn noise(&mut self,p:Vec3,r:f32){for n in &mut self.soldiers{if n.hp>0.&&distance(n.pos,p)<r&&n.state<2{n.state=1;n.timer=10.;}}for a in &mut self.animals{if distance(a.pos,p)<r{a.fleeing=8.;}}if self.animals.iter().any(|a|a.fleeing>0.){self.flag(\"animals_fled\");}}\n pub fn tag(&mut self,dt:f32){let origin=self.eye_pos();let f=self.forward();let target=self.soldiers.iter().enumerate().filter(|(_,n)|n.hp>0.&&(n.pos+Vec3::Y-origin).normalize_or_zero().dot(f)>0.995).map(|(i,_)|i).next();if self.tag_target==target{self.tag_timer+=dt;}else{self.tag_timer=0.;self.tag_target=target;}if self.tag_timer>0.5{if let Some(i)=target{self.soldiers[i].tagged=true;self.flag(\"monocular_tag\");}}}\n pub fn tracker_rate(&self)->f32{let dist=self.caches.iter().filter(|c|!c.found).map(|c|distance(c.pos,self.pos)).fold(1000.,f32::min);if dist>60.{0.}else{1./(0.12+(dist/60.).powi(2)*1.5)}}\n pub fn prompt(&self)->Option<String>{if self.riding.is_some(){return Some(\"Leave vehicle · change seat\".into());}if self.companions.iter().any(|c|c.alive&&c.down>0.&&distance(c.pos,self.pos)<5.){return Some(\"Help companion\".into());}if self.vehicles.iter().any(|v|!v.exploded&&distance(v.pos,self.pos)<5.5){return Some(\"Drive / hold at hood to repair\".into());}if self.caches.iter().any(|c|!c.found&&distance(c.pos,self.pos)<4.){return Some(\"Open diamond case\".into());}let p=self.data.world.place.iter().min_by(|a,b|distance(a.pos(),self.pos).total_cmp(&distance(b.pos(),self.pos)))?;if distance(p.pos(),self.pos)<if p.kind==2{75.}else{27.}{Some(p.name.clone())}else{None}}\n pub fn interact(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){if let Some(i)=self.riding.take(){self.pos=self.vehicles[i].pos+Vec3::new(3.,0.,0.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.sync_player(sim);return;}\n if self.session{if let Some(p)=self.peers.iter_mut().find(|p|p.present&&p.hp<=0.&&distance(p.pos,self.pos)<5.){if self.syrettes>0{self.syrettes-=1;p.hp=50.;p.down=0.;self.team_score+=25;self.flag(\"player_rescued\");return;}}}\n if self.companions.iter().any(|c|c.alive&&c.down>0.&&distance(c.pos,self.pos)<5.){self.open(\"companion\");return;}\n if let Some(i)=self.caches.iter().position(|c|!c.found&&distance(c.pos,self.pos)<4.){self.caches[i].found=true;self.diamonds+=self.caches[i].value;if self.tracker{self.flag(\"cache_tracker\");}self.sound(32);self.note(format!(\"+{} diamonds\",self.caches[i].value));return;}\n if self.interact_goal(sim,events){return;}\n if let Some(i)=self.vehicles.iter().position(|v|!v.exploded&&distance(v.pos,self.pos)<5.5){if self.vehicles[i].hp<70.{self.action=Some(Action{kind:\"repair\".into(),left:if self.upgrades.contains(&2){3.6}else{6.},duration:6.,param:i as i32});self.sound(11);}else{self.riding=Some(i);self.seat=0;self.map_up=false;self.pos=self.vehicles[i].pos;self.flag(if self.vehicles[i].kind==3{\"boat_driven\"}else{\"technical_driven\"});}return;}\n if let Some(i)=self.soldiers.iter().position(|n|n.hp<=0.&&distance(n.pos,self.pos)<3.5){self.guns[1]=self.soldiers[i].gun.clone();self.guns[1].ammo=30;self.guns[1].reserve+=60;self.active=1;self.note(\"A used rifle. Its previous owner cannot recommend it.\");return;}\n let p=self.data.world.place.iter().min_by(|a,b|distance(a.pos(),self.pos).total_cmp(&distance(b.pos(),self.pos))).cloned();if let Some(p)=p{if distance(p.pos(),self.pos)>80.{return;}match p.kind{2=>{self.open(\"town\");},3=>{let clear=self.soldiers.iter().all(|n|n.group!=self.data.world.place.iter().position(|q|q.id==p.id).unwrap()||n.hp<=0.);if clear{if let Some(post)=self.posts.iter_mut().find(|a|a.place==p.id){post.claimed=true;}self.flag(\"safe_house_claimed\");self.open(\"safehouse\");}else{self.note(\"The bed is occupied. Clear the guards.\");}},5=>{self.pills=3;self.say(\"Sister Perpetua\",self.s(\"clinic\").to_string());self.open(\"clinic\");},8=>self.open(\"bus\"),_=>{self.collect_tape(&p.id);}}}}\n pub fn companion_choice(&mut self,mercy:bool){if let Some(c)=self.companions.iter_mut().find(|c|c.alive&&c.down>0.&&distance(c.pos,self.pos)<6.){if mercy||c.mortal{c.alive=false;c.down=0.;self.flag(\"companion_overdosed\");self.flag(\"companion_died\");self.say(\"Companion\",self.s(\"mercy\").to_string());}else if self.syrettes>0{self.syrettes-=1;c.down=0.;c.trust+=2;self.flag(\"companion_patched\");self.say(\"Companion\",\"Put it on the account.\");}self.goal_flag=true;self.open(\"playing\");}}\n pub fn buy(&mut self,index:usize){let cost=if index<14{if self.owned.contains(&index){return;}[5,5,4,5,8,10,8,8,12,10,12,12,14,12][index]}else{[6,6,6,8,10,5,7,7][(index-14).min(7)]};let cost=cost+(self.infamy/5).min(3);if self.diamonds<cost{self.note(self.s(\"no_money\").to_string());return;}self.diamonds-=cost;self.flag(\"diamonds_spent\");if index<14{self.owned.insert(index);let slot=self.data.weapons[index].slot;self.guns[slot]=Gun::new(index,&self.data.weapons[index],100.);self.flag(\"weapon_bought\");}else{match index{14=>{self.reliability.insert(self.guns[self.active].def);},15=>{self.accuracy.insert(self.guns[self.active].def);},16..=19=>{self.upgrades.insert(index-16);},_=>self.pills+=3}}self.goal_flag=true;self.sound(32);self.note(\"Paid in diamonds. Take a fresh crate at any locker.\");}\n pub fn collect_tape(&mut self,place:&str){if let Some(i)=self.data.tapes.iter().position(|t|t.place==place){self.tapes.insert(i);self.playing_tape=Some(i);self.tape_line=0;self.tape_timer=0.;self.flag(\"tape_played\");}}\n pub fn tape_tick(&mut self,dt:f32){if let Some(i)=self.playing_tape{self.tape_timer-=dt;if self.tape_timer<=0.{let t=self.data.tapes[i].clone();if let Some(line)=t.lines.get(self.tape_line){self.say(if self.tape_line%2==0{\"The Chandler\"}else{\"Thandiwe Moyo\"},line.clone());self.tape_line+=1;self.tape_timer=5.5;}else{self.playing_tape=None;}}}}\n}\nRS'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/merc/ai.rs <<'RS'\nuse std::collections::BTreeMap;\nuse glam::{Vec2,Vec3};\nuse crate::{Sim,InputFrame,SimEvent,entity::EntityId,input::buttons as b,puppet::{PuppetDef,BodyPlan}};\nuse super::{*,data::{distance,flat,toward},weapons::jam_chance};\npub fn detection_rate(distance:f32,posture:u8,grass:f32,hour:f32,sprinting:bool,still:bool,camo:bool,lit:bool)->f32{let stance=match posture{1=>0.6,2=>0.3,_=>1.};let cover=if grass>0.5{if posture>0{0.35}else{0.6}}else{1.};let night=if \"'!(6.0..19.0).contains(&hour){0.45}else{1.};let light=if lit{1.5}else{night};(1.-distance/140.).max(0.).powi(2)*stance*cover*light*if sprinting{1.3}else if still{0.5}else{1.}*if camo{0.7}else{1.}}\nimpl Merc{\n pub fn ai(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>,out:&mut BTreeMap<EntityId,InputFrame>){let mut attackers=0;let mut pending_damage=Vec::new();let mut dead=Vec::new();let data=self.data.clone();let night=!(6.0..19.0).contains(&self.hour);let player=self.pos;let mut bark=None;let mut flags=Vec::new();let group_living:Vec<usize>=(0..data.world.place.len()).map(|g|self.soldiers.iter().filter(|n|n.group==g&&n.hp>0.).count()).collect();let mut radio=Vec::new();\n for (ni,n) in self.soldiers.iter_mut().enumerate(){if n.hp<=0.{continue;}let dist=distance(n.pos,player);let near=dist<150.;if near&&n.entity.is_none(){let mut def=PuppetDef::preset(BodyPlan::Biped);def.look.skin_color=\"#644530\".into();def.look.armor_color=if n.faction==0{\"#59603c\"}else{\"#82674f\"}.into();let id=sim.spawn_npc(\"soldier\",n.pos,n.yaw,def,None,None);n.entity=Some(id);}if !near{if let Some(id)=n.entity.take(){sim.despawn(id);}continue;}\n n.timer=(n.timer-dt).max(0.);n.cooldown=(n.cooldown-dt).max(0.);if n.poison>0.{n.poison-=dt;if n.poison<=0.{dead.push((ni,true));continue;}}\n let burning=self.fire.at(flat(n.pos))==1;if burning{n.burning=3.;}if n.burning>0.{n.burning-=dt;n.hp-=dt*16.;n.state=4;flags.push(\"enemy_panicked\");if n.hp<=0.{dead.push((ni,false));continue;}if sim.state.rng.f32()<dt*0.8{self.fire.ignite(&data,flat(n.pos),0.1);}}\n let f=Vec2::new(n.yaw.sin(),-n.yaw.cos());let dir=toward(n.pos,player);let visible=!self.cheats.invisible&&dist<130.&&f.dot(dir)>-0.5&&!self.safe_town_at(player)&&!self.fire.smoke(flat(n.pos),flat(player))&&!crate::projectile::static_blocked(&sim.state.physics,n.pos+Vec3::Y*1.4,(player+Vec3::Y*1.3-n.pos-Vec3::Y*1.4).normalize_or_zero(),(player+Vec3::Y*1.3-n.pos-Vec3::Y*1.4).length(),None);\n if visible{n.detection=(n.detection+dt*self.tuning.detection*detection_rate(dist,self.stance,terrain::grass(&data,flat(player)),self.hour,self.speed>5.5,self.speed<0.3,self.upgrades.contains(&3),self.fire.at(flat(player))==1)*1.25).min(1.);}else{n.detection=(n.detection-dt*0.1).max(0.);}\n if n.detection>=1.&&n.state<2{n.state=2;n.timer=20.;radio.push(n.pos);bark=Some(\"There. Past the grass.\");}else if n.detection>0.2&&n.state==0{n.state=1;n.timer=8.;}\n if n.state==2&&!visible&&n.timer<=0.{n.state=3;n.timer=20.;}else if n.state==3&&n.timer<=0.{n.state=0;n.detection=0.;}\n let low_morale=group_living[n.group]<=2||burning;let mut input=InputFrame::default();let cover=Vec2::new((ni as f32*2.3).cos(),(ni as f32*2.3).sin());\n match n.state {4=>{input.move_dir=-self.wind+cover*0.4;},2=>{n.yaw=dir.x.atan2(-dir.y);if low_morale{input.move_dir=-dir;flags.push(\"morale_broken\");}else if ni%3==0{input.move_dir=Vec2::new(-dir.y,dir.x)*0.6;flags.push(\"flanker\");}else if dist<12.{input.move_dir=-dir*0.4;}else if dist>45.{input.move_dir=dir*0.45;}else{input.held|=b::CROUCH;}\n if n.gun.jammed{if n.timer<=0.{n.gun.jammed=false;n.timer=20.;}else{flags.push(\"enemy_jam_seen\");}}else if visible&&n.cooldown<=0.&&attackers<4 {attackers+=1;if sim.state.rng.f32()<jam_chance(n.gun.condition)*self.tuning.jam{n.gun.jammed=true;n.timer=2.;bark=Some(\"Not now. Work the bolt.\");flags.push(\"enemy_jam_seen\");}else{n.gun.condition=(n.gun.condition-0.14*self.tuning.wear).max(5.);n.cooldown=if n.role==2{2.2}else{0.85+sim.state.rng.f32()};let chance=self.tuning.enemy_accuracy*(1.-dist/200.).max(0.15)*if self.speed>4.{0.45}else{1.}*if night{0.8}else{1.};if sim.state.rng.f32()<chance{pending_damage.push(if n.role==2{18.}else if n.role==3&&self.riding.is_some(){24.}else{8.});}events.push(SimEvent::Shot{pos:n.pos+Vec3::Y*1.4});}}},1|3=>{input.move_dir=dir*0.3;if n.timer<=0.{n.state=0;}},_=>{let target=n.home+Vec3::new((self.time*0.07+ni as f32).sin()*5.,0.,(self.time*0.07+ni as f32).cos()*5.);input.move_dir=toward(n.pos,target)*0.25;}}\n if terrain::water(&data,flat(n.pos)+input.move_dir*3.){input.move_dir=Vec2::new(-input.move_dir.y,input.move_dir.x);}if self.fire.at(flat(n.pos)+input.move_dir*4.)==1{input.move_dir=-self.wind;}\n if let Some(id)=n.entity{out.insert(id,input);}\n }\n for p in radio{for n in &mut self.soldiers{if n.hp>0.&&n.state<2&&distance(n.pos,p)<80.{n.state=2;n.detection=1.;n.timer=20.;}}}\n for amount in pending_damage{self.damage(amount*self.tuning.enemy_damage,0);}for (i,poison) in dead{self.soldiers[i].hp=1.;if poison{self.flag(\"dart_kill\");}self.hit_soldier(sim,i,500.,events);}for flag in flags{self.flag(flag);}if let Some(line)=bark{if self.subtitle_time<=0.{self.say(\"Soldier\",line);}}\n }\n pub fn safe_town_at(&self,p:Vec3)->bool{self.ceasefire&&distance(p,self.data.place(\"town\").pos())<76.}\n pub fn drive(&mut self,sim:&mut Sim,input:&InputFrame,dt:f32,events:&mut Vec<SimEvent>){let Some(i)=self.riding else{return;};let v=&mut self.vehicles[i];if v.exploded{self.riding=None;return;}let throttle=if input.axes!=Vec2::ZERO{input.axes.x-input.axes.y}else{-input.move_dir.y*self.yaw.cos()+input.move_dir.x*self.yaw.sin()};let steer=if input.axes!=Vec2::ZERO{input.move_dir.x}else{input.move_dir.x*self.yaw.cos()+input.move_dir.y*self.yaw.sin()};v.steer=steer;let max=if v.kind==3{16.}else if v.kind==2{18.}else if v.kind==1{30.}else{25.}*self.tuning.vehicle_speed*if v.hp<40.{0.6}else{1.};if self.seat==0{v.speed+=(throttle*max-v.speed)*dt*1.4;if input.down(b::JUMP){v.speed*=(-dt*8.).exp();}v.yaw+=(steer*v.speed*0.035).clamp(-1.5,1.5)*dt;}else{v.speed*=(-dt*1.5).exp();}\n let forward=Vec3::new(v.yaw.sin(),0.,-v.yaw.cos());let next=v.pos+forward*v.speed*dt;if v.kind==3{if terrain::water(&self.data,flat(next)){v.pos=next;v.pos.y=0.25+(self.time*2.).sin()*0.06;}else{v.speed=0.;}}else{if terrain::water(&self.data,flat(next)){v.speed*=0.5;v.hp-=dt;}else{v.pos=next;v.pos.y=terrain::height(&self.data,next.x,next.z);let slope=terrain::height(&self.data,next.x+forward.x*2.,next.z+forward.z*2.)-terrain::height(&self.data,next.x-forward.x*2.,next.z-forward.z*2.);v.pitch+=((-slope/4.).atan()-v.pitch)*(dt*6.).min(1.);v.roll+=(-steer*v.speed*0.006-v.roll)*(dt*5.).min(1.);}}\n self.pos=v.pos;self.pos.y+=0.65;self.speed=v.speed.abs();if self.map_up{self.flag(\"map_driving\");}if input.down(b::PRIMARY)&&self.seat==1{events.push(SimEvent::Shot{pos:self.pos+Vec3::Y*2.});}self.sync_player(sim);}\n pub fn survival(&mut self,sim:&mut Sim,dt:f32,_events:&mut Vec<SimEvent>){if self.health>0.&&self.health<100.&&self.health>=20.{let top=(self.health/20.).ceil()*20.;self.health=(self.health+dt*0.35).min(top);}\n if !self.cheats.fever{self.fever_timer-=dt;if self.fever_state==0&&self.fever_timer<=40.{self.fever_state=1;self.flag(\"fever_warned\");self.say(\"Field note\",self.s(\"fever_warn\").to_string());}if self.fever_timer<=0.&&self.fever_state==1{self.fever_state=2;self.fever_timer=-0.01;self.fever_attacks+=1;}if self.fever_state==2&&self.fever_timer<=-60.{self.fever_state=0;self.fever_timer=self.tuning.fever_interval*0.9f32.powi(self.fever_attacks as i32);self.health=50.;self.diamonds=(self.diamonds as f32*0.8).floor() as i32;self.hour=(self.hour+6.).rem_euclid(24.);let nearest=self.data.world.place.iter().filter(|p|p.kind==3).min_by(|a,b|distance(a.pos(),self.pos).total_cmp(&distance(b.pos(),self.pos))).unwrap();self.pos=nearest.pos()+Vec3::new(0.,0.,20.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.sync_player(sim);self.flag(\"blackout\");self.say(\"Field note\",self.s(\"blackout\").to_string());}}\n if self.rescue_time>0.{self.rescue_time-=dt;if self.session{if self.rescue_time<=0.{if self.team_lives>0{self.team_lives-=1;self.health=50.;self.pos=self.data.place(\"depot\").pos()+Vec3::new(-65.,0.,70.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.sync_player(sim);}else{self.finished=true;self.won=false;}}}else{self.pos-=Vec3::new(self.wind.x,0.,self.wind.y)*dt*2.;self.sync_player(sim);if self.rescue_time<=0.{self.health=50.;self.active=0;self.flag(\"player_rescued\");self.say(\"Companion\",self.s(\"rescue\").to_string());}}}\n let mut dead=false;for c in &mut self.companions{if c.alive&&c.down>0.{c.down-=dt;if c.down<=0.{c.alive=false;dead=true;}}}if dead{self.flag(\"companion_died\");self.say(\"Radio\",\"No reply. The stool will stay empty.\");}\n if self.tracker{let rate=self.tracker_rate();if rate>0.&&(self.time*rate).floor() as i32!=((self.time-dt)*rate).floor() as i32{self.sound(33);}}\n if let Some(w)=self.waypoint{if distance(w,self.pos)<20.{self.flag(\"gps_followed\");}}\n if self.wind_speed>6.{self.flag(\"wind_rag\");}\n }\n pub fn world_tick(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>){self.hour=(self.hour+dt/60.*self.tuning.clock_speed).rem_euclid(24.);self.world_hours+=dt/60.*self.tuning.clock_speed;self.wind_timer-=dt;if self.wind_timer<=0.{self.wind_timer=sim.state.rng.range(180.,360.);let angle=sim.state.rng.range(-0.6,0.6);self.wind=Vec2::from_angle(self.wind.y.atan2(self.wind.x)+angle);self.wind_speed=sim.state.rng.range(2.,12.);}\n self.weather_time-=dt;if self.weather_time<=0.{self.weather=(self.weather+1)%3;self.weather_time=if self.weather==2{90.}else{sim.state.rng.range(180.,360.)};if self.weather==2{self.sound(34);self.fire.ignite(&self.data,flat(self.pos)+Vec2::new(80.,60.),2.);self.flag(\"fire_lightning\");}}\n if !self.session||self.host{let prior=self.fire.burning();self.fire.step(&self.data,&mut sim.state.rng,&self.tuning,self.wind,self.wind_speed,self.weather==2,dt);if self.weather==2&&prior>0{self.flag(\"rain_extinguished\");}if self.fire.total>=500{self.flag(\"big_fire\");}\n let burning=self.fire.at(flat(self.pos))==1;if burning{self.burning=3.;}if terrain::water(&self.data,flat(self.pos)){self.burning=0.;self.guns[self.active].condition=(self.guns[self.active].condition-dt*0.08).max(0.);}if self.burning>0.{self.burning-=dt;self.damage(self.tuning.burn_damage*dt,2);}\n let mut exploding=Vec::new();for (i,o) in self.objects.iter_mut().enumerate(){if o.exploded{continue;}if self.fire.at(flat(o.pos))==1&&o.fuse<0.{o.fuse=if o.kind==1{3.}else{1.5};}if o.fuse>=0.{o.fuse-=dt;if o.fuse<=0.{o.exploded=true;exploding.push((i,o.pos));}}}for (_,p) in exploding{self.explode(sim,p,8.,160.,events);self.flag(\"explosion_chain\");}\n let mut vexp=Vec::new();for v in &mut self.vehicles{if v.exploded{continue;}if self.fire.at(flat(v.pos))==1{v.hp-=dt*5.;}if v.hp<15.&&v.fuse<0.{v.fuse=8.;}if v.fuse>=0.{v.fuse-=dt;if v.fuse<=0.{v.exploded=true;vexp.push(v.pos);}}}for p in vexp{self.explode(sim,p,7.,180.,events);self.flag(\"fire_vehicle\");}\n let mut post_flags=Vec::new();for post in &mut self.posts{let pi=self.data.world.place.iter().position(|p|p.id==post.place).unwrap();let p=self.data.world.place[pi].pos();let living=self.soldiers.iter().any(|n|n.group==pi&&n.hp>0.);if !living&&!post.cleared{post.cleared=true;post.cleared_at=self.world_hours;post_flags.push(\"post_cleared\");}if post.cleared&&self.world_hours-post.cleared_at>self.tuning.reman_hours&&!post.safe&&distance(p,self.pos)>200.{post.cleared=false;for n in self.soldiers.iter_mut().filter(|n|n.group==pi){n.hp=80.;n.pos=n.home;n.state=0;n.detection=0.;}post_flags.push(\"post_remanned\");}}for flag in post_flags{self.flag(flag);}}\n for a in &mut self.animals{if self.fire.at(flat(a.pos))==1{a.fleeing=8.;}if a.fleeing>0.{a.fleeing-=dt;let dir=toward(self.pos,a.pos);a.pos+=Vec3::new(dir.x,0.,dir.y)*dt*8.;a.yaw=dir.x.atan2(-dir.y);a.pos.y=terrain::height(&self.data,a.pos.x,a.pos.z);}}\n }\n pub fn attract(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>){let duration:f32=self.data.attract.iter().map(|s|s.seconds).sum();self.attract_time+=dt;if self.attract_time>=duration{self.attract_time-=duration;self.attract_loops+=1;}let mut t=self.attract_time;let mut si=0;for (i,s) in self.data.attract.iter().enumerate(){if t<s.seconds{si=i;break;}t-=s.seconds;}let s=self.data.attract[si].clone();if self.attract_segment!=si{self.attract_segment=si;self.pos=self.data.place(&s.place).pos()+Vec3::new(0.,0.,55.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.hour=s.hour;self.health=100.;self.aiming=false;self.map_up=false;self.action=None;self.riding=None;self.yaw=0.;self.pitch=0.;if s.action==\"fire\"{self.fire.ignite(&self.data,flat(self.data.place(\"depot\").pos())-Vec2::splat(20.),6.);}if s.action==\"heal\"{self.action=Some(Action{kind:\"wound_0\".into(),left:4.,duration:4.,param:0});}if s.action==\"map\"{self.map_up=true;}if s.action==\"rescue\"{self.rescue_time=6.;}if s.action==\"jam\"{self.guns[self.active].jammed=true;}}\n self.pos.x+=dt*0.8;self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.yaw=(t*0.02).sin()*0.4;self.view_time+=dt;self.fire.step(&self.data,&mut sim.state.rng,&self.tuning,self.wind,8.,false,dt);if s.action==\"jam\"&&t>4.{self.guns[self.active].jammed=false;}if s.action==\"drive\"||s.action==\"boat\"{self.pos.z-=dt*4.;}self.sync_player(sim);let _=events;}\n}\nRS\ncat > engine/crates/pav_core/src/games/merc/campaign.rs <<'\"'RS'\nuse glam::{Vec2,Vec3};\nuse crate::{Sim,SimEvent};\nuse super::{*,data::{distance,flat}};\nimpl Merc{\n pub fn current_goal(&self)->Option<data::GoalDef>{if self.contract>=self.data.contracts.len(){return None;}self.data.contracts[self.contract].goal.get(self.goal).cloned()}\n pub fn goal_pos(&self)->Vec3{self.current_goal().map(|g|self.data.place(&g.place).pos()).unwrap_or(self.pos)}\n pub fn accept_contract(&mut self){self.contract_active=true;self.goal=0;self.goal_time=0.;self.goal_flag=false;self.save_serial+=1;let c=self.data.contracts[self.contract].clone();self.say(&c.giver,c.brief.replace('\\\\n',\\\" \\\"));self.open(\\\"playing\\\");if self.contract==3{self.owned.insert(9);self.guns[1]=Gun::new(9,&self.data.weapons[9],100.);}if self.contract==6{self.owned.insert(8);self.guns[1]=Gun::new(8,&self.data.weapons[8],100.);}if self.contract==7{self.owned.insert(12);self.guns[2]=Gun::new(12,&self.data.weapons[12],100.);}if self.contract==5{self.better_way=true;self.flag(\\\"better_way_taken\\\");}}\n pub fn contract_tick(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>){if self.session {self.round_time+=dt;let destroyed=self.objects.iter().filter(|o|o.place==\\\"depot\\\"&&o.kind==1&&o.exploded).count();if destroyed==3&&self.ledger_carrier>=0 {let exit=self.data.place(\\\"depot\\\").pos()+Vec3::new(0.,0.,500.);let me=self.local_id==255||self.health<=0.||distance(self.pos,exit)<30.;let peers=self.peers.iter().filter(|p|p.present&&p.hp>0.).all(|p|distance(p.pos,exit)<30.);if me&&peers{self.finished=true;self.won=true;self.team_score+=100;}}if self.round_time>600.{self.finished=true;self.won=false;}return;}\n if self.ending>0 {self.ending_time+=dt;if self.ending==2{if (self.ending_time/12.).floor() as i32\"'!=((self.ending_time-dt)/12.).floor() as i32 {let p=self.pos+Vec3::new(24.,0.,-24.);self.spawn_enemy(sim,p,(self.ending_time as u8/12)%5);self.fire.ignite(&self.data,flat(p),3.);}if self.ending_time>=180.{self.end_interview();}}else if self.ending_time>14.{self.end_interview();}return;}\n if !self.contract_active{return;}let Some(goal)=self.current_goal() else{return;};let p=self.data.place(&goal.place).pos();let near=distance(self.pos,p)<if goal.kind==\"target\"{450.}else{30.};self.goal_time+=dt;\n let success=match goal.kind.as_str(){\"reach\"=>near,\"pills\"=>self.coverage.contains(\"pill_taken\"),\"clear\"=>self.posts.iter().any(|q|q.place==goal.place&&q.cleared),\"claim\"=>self.posts.iter().any(|q|q.place==goal.place&&q.claimed),\"shop\"=>self.coverage.contains(\"weapon_bought\"),\"tanks\"=>self.objects.iter().filter(|o|o.place==goal.place&&o.kind==1&&o.exploded).count()>=3,\"escape\"=>near,\"night\"=>self.coverage.contains(\"sleep_used\")&&!(5.0..20.0).contains(&self.hour),\"tag\"=>self.soldiers.iter().any(|n|n.target&&n.tagged),\"target\"=>self.soldiers.iter().any(|n|n.target&&n.hp<=0.),\"companion\"=>self.goal_flag||self.companions.iter().any(|c|!c.alive),_=>self.goal_flag};\n if self.contract==0&&self.goal==1&&near&&self.fever_state==0&&!self.coverage.contains(\"pill_taken\"){self.fever_timer=35.;self.note(\"The bar door is close. So is the fever.\");}\n if success{self.advance_goal(sim,events);}\n }\n pub fn advance_goal(&mut self,_sim:&mut Sim,_events:&mut Vec<SimEvent>){self.goal+=1;self.goal_time=0.;self.goal_flag=false;let c=self.data.contracts[self.contract].clone();if self.goal>=c.goal.len(){self.complete.insert(self.contract);self.flag(&format!(\"contract_{}\",c.id));let pay=(c.pay as f32*self.tuning.contract_pay).round() as i32;self.diamonds+=pay;if matches!(self.contract,2|6){self.income[0]+=pay;}else{self.income[1]+=pay;}self.infamy+=1;self.contract_active=false;self.save_serial+=1;self.note(format!(\"{} · +{} diamonds. {}\",c.name,pay,self.s(\"mission_end\")));if self.contract==0{self.pills=3;self.health=100.;self.collect_tape(\"bar\");}if self.contract==1{for c in &mut self.companions{c.recruited=c.alive;}}if self.contract==4{self.pills=5;}if self.contract==6{self.ceasefire=false;self.flag(\"ceasefire_ended\");self.say(\"Thandiwe Moyo\",self.s(\"ceasefire\").to_string());}if self.contract==8{self.town_burned=true;self.flag(\"town_burned\");}if self.contract<10{self.contract+=1;}if self.contract==8{self.hour=22.;let p=self.data.place(\"town\").pos();self.fire.ignite(&self.data,flat(p)+Vec2::new(35.,25.),8.);}if self.contract==10{self.open(\"ending_choice\");}else{self.parent=\"playing\".into();self.open(\"contract\");}}}\n pub fn interact_goal(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>)->bool{if self.session {let depot=self.data.place(\"depot\").pos();if distance(self.pos,depot)<25.&&self.objects.iter().filter(|o|o.place==\"depot\"&&o.exploded).count()>=3{if self.ledger_carrier<0{self.ledger_carrier=self.local_id as i32;self.team_score+=100;self.note(\"Ledger taken. Reach the extraction boat, 500 m south.\");}else if self.ledger_carrier==self.local_id as i32{self.ledger_carrier=-1;}return true;}return false;}\n if !self.contract_active{return false;}let Some(goal)=self.current_goal()else{return false;};let p=self.data.place(&goal.place).pos();if distance(self.pos,p)>30.{return false;}match goal.kind.as_str(){\"sabotage\"=>{self.goal_flag=true;self.flag(\"night_contract\");self.collect_tape(\"mission\");self.fire.ignite(&self.data,flat(p)+Vec2::new(7.,0.),2.);self.note(\"Pump governor removed. Water has changed owners.\");},\"cargo\"=>{self.goal_flag=true;let v=self.vehicles.iter().position(|v|v.kind==2).unwrap_or(0);self.vehicles[v].pos=self.pos+Vec3::new(4.,0.,0.);self.vehicles[v].hp=100.;self.note(\"Medicine loaded. Truck keys on the dash.\");},\"deliver\"=>{if !self.coverage.contains(\"repair_done\"){if let Some(i)=self.riding{self.vehicles[i].hp=28.;self.riding=None;}self.note(\"The engine has stopped. Repair it at the hood.\");return true;}self.goal_flag=true;self.pills=5;self.collect_tape(\"mission\");},\"convoy\"=>{let enemies=self.soldiers.iter().any(|n|n.hp>0.&&distance(n.pos,p)<35.);if enemies{self.note(\"The manifest is under armed supervision.\");return true;}self.goal_flag=true;if self.contract==5{if let Some(c)=self.companions.iter_mut().find(|c|c.alive&&c.recruited){c.pos=self.pos+Vec3::new(8.,0.,4.);c.down=self.tuning.rescue_window;c.mortal=self.trouble_count%2==1;self.trouble_count+=1;}self.say(\"Companion\",self.s(\"companion_down\").to_string());}},\"manifest\"=>{self.goal_flag=true;self.collect_tape(\"works\");self.note(\"The same stencils. The same signature.\");},\"evacuate\"=>{self.open(\"evacuate\");},\"ledger\"=>{self.goal_flag=true;self.collect_tape(\"works\");self.say(\"The Chandler\",self.s(\"ledger\").to_string());},_=>return false};let _=(sim,events);true}\n pub fn choose_ending(&mut self,n:u8){self.ending=n;self.ending_time=0.;self.flag(match n{1=>\"ending_burn\",2=>\"ending_read\",_=>\"ending_chair\"});self.contract_active=false;if n==1{self.fire.ignite(&self.data,flat(self.data.place(\"works\").pos()),12.);self.say(\"Field note\",self.s(\"ending_burn\").to_string());}else if n==2{self.say(\"Thandiwe Moyo\",self.s(\"ending_read\").to_string());}else{self.say(\"Radio\",self.s(\"ending_chair\").to_string());}self.open(if n==2{\"ending_defend\"}else{\"playing\"});}\n pub fn end_interview(&mut self){self.outcome=Outcome::Won;self.complete.insert(10);self.flag(\"contract_D2\");let merc=self.s(&format!(\"dossier_{}\",self.merc)).split('\"'|').next().unwrap_or(\\\"\\\").to_string();let lost=self.companions.iter().filter(|c|\"'!c.alive).count();let paid=if self.income[0]>self.income[1]{\"the Council\"}else{\"the Hand\"};self.say(\"Your voice\",format!(\"{merc}. {lost} companions lost. Most of the money came from {paid}. Moyo: Would you do it again? You leave the tape running.\"));self.open(\"ending\");self.save_serial+=1;}\n pub fn spawn_enemy(&mut self,_sim:&mut Sim,mut p:Vec3,role:u8){p.y=terrain::height(&self.data,p.x,p.z);self.soldiers.push(Soldier{pos:p,home:p,yaw:0.,hp:80.,role,faction:role%2,group:18,detection:1.,state:2,timer:20.,cooldown:2.,gun:Gun::new(4,&self.data.weapons[4],35.),entity:None,tagged:false,poison:0.,burning:0.,target:false});}\n}\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/merc/ai.rs <<'RS'\nuse std::collections::BTreeMap;\nuse glam::{Vec2,Vec3};\nuse crate::{Sim,InputFrame,SimEvent,entity::EntityId,input::buttons as b,puppet::{PuppetDef,BodyPlan}};\nuse super::{*,data::{distance,flat,toward},weapons::jam_chance};\npub fn detection_rate(distance:f32,posture:u8,grass:f32,hour:f32,sprinting:bool,still:bool,camo:bool,lit:bool)->f32{let stance=match posture{1=>0.6,2=>0.3,_=>1.};let cover=if grass>0.5{if posture>0{0.35}else{0.6}}else{1.};let night=if \"'!(6.0..19.0).contains(&hour){0.45}else{1.};let light=if lit{1.5}else{night};(1.-distance/140.).max(0.).powi(2)*stance*cover*light*if sprinting{1.3}else if still{0.5}else{1.}*if camo{0.7}else{1.}}\nimpl Merc{\n pub fn ai(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>,out:&mut BTreeMap<EntityId,InputFrame>){let mut attackers=0;let mut pending_damage=Vec::new();let mut dead=Vec::new();let data=self.data.clone();let night=!(6.0..19.0).contains(&self.hour);let player=self.pos;let mut bark=None;let mut flags=Vec::new();let group_living:Vec<usize>=(0..data.world.place.len()).map(|g|self.soldiers.iter().filter(|n|n.group==g&&n.hp>0.).count()).collect();let mut radio=Vec::new();\n for (ni,n) in self.soldiers.iter_mut().enumerate(){if n.hp<=0.{continue;}let dist=distance(n.pos,player);let near=dist<150.;if near&&n.entity.is_none(){let mut def=PuppetDef::preset(BodyPlan::Biped);def.look.skin_color=\"#644530\".into();def.look.armor_color=if n.faction==0{\"#59603c\"}else{\"#82674f\"}.into();let id=sim.spawn_npc(\"soldier\",n.pos,n.yaw,def,None,None);n.entity=Some(id);}if !near{if let Some(id)=n.entity.take(){sim.despawn(id);}continue;}\n n.timer=(n.timer-dt).max(0.);n.cooldown=(n.cooldown-dt).max(0.);if n.poison>0.{n.poison-=dt;if n.poison<=0.{dead.push((ni,true));continue;}}\n let burning=self.fire.at(flat(n.pos))==1;if burning{n.burning=3.;}if n.burning>0.{n.burning-=dt;n.hp-=dt*16.;n.state=4;flags.push(\"enemy_panicked\");if n.hp<=0.{dead.push((ni,false));continue;}if sim.state.rng.f32()<dt*0.8{self.fire.ignite(&data,flat(n.pos),0.1);}}\n let f=Vec2::new(n.yaw.sin(),-n.yaw.cos());let dir=toward(n.pos,player);let visible=!self.cheats.invisible&&dist<130.&&f.dot(dir)>-0.5&&!self.safe_town_at(player)&&!self.fire.smoke(flat(n.pos),flat(player))&&!crate::projectile::static_blocked(&sim.state.physics,n.pos+Vec3::Y*1.4,(player+Vec3::Y*1.3-n.pos-Vec3::Y*1.4).normalize_or_zero(),(player+Vec3::Y*1.3-n.pos-Vec3::Y*1.4).length(),None);\n if visible{n.detection=(n.detection+dt*self.tuning.detection*detection_rate(dist,self.stance,terrain::grass(&data,flat(player)),self.hour,self.speed>5.5,self.speed<0.3,self.upgrades.contains(&3),self.fire.at(flat(player))==1)*1.25).min(1.);}else{n.detection=(n.detection-dt*0.1).max(0.);}\n if n.detection>=1.&&n.state<2{n.state=2;n.timer=20.;radio.push(n.pos);bark=Some(\"There. Past the grass.\");}else if n.detection>0.2&&n.state==0{n.state=1;n.timer=8.;}\n if n.state==2&&!visible&&n.timer<=0.{n.state=3;n.timer=20.;}else if n.state==3&&n.timer<=0.{n.state=0;n.detection=0.;}\n let low_morale=group_living[n.group]<=2||burning;let mut input=InputFrame::default();let cover=Vec2::new((ni as f32*2.3).cos(),(ni as f32*2.3).sin());\n match n.state {4=>{input.move_dir=-self.wind+cover*0.4;},2=>{n.yaw=dir.x.atan2(-dir.y);if low_morale{input.move_dir=-dir;flags.push(\"morale_broken\");}else if ni%3==0{input.move_dir=Vec2::new(-dir.y,dir.x)*0.6;flags.push(\"flanker\");}else if dist<12.{input.move_dir=-dir*0.4;}else if dist>45.{input.move_dir=dir*0.45;}else{input.held|=b::CROUCH;}\n if n.gun.jammed{if n.timer<=0.{n.gun.jammed=false;n.timer=20.;}else{flags.push(\"enemy_jam_seen\");}}else if visible&&n.cooldown<=0.&&attackers<4 {attackers+=1;if sim.state.rng.f32()<jam_chance(n.gun.condition)*self.tuning.jam{n.gun.jammed=true;n.timer=2.;bark=Some(\"Not now. Work the bolt.\");flags.push(\"enemy_jam_seen\");}else{n.gun.condition=(n.gun.condition-0.14*self.tuning.wear).max(5.);n.cooldown=if n.role==2{2.2}else{0.85+sim.state.rng.f32()};let chance=self.tuning.enemy_accuracy*(1.-dist/200.).max(0.15)*if self.speed>4.{0.45}else{1.}*if night{0.8}else{1.};if sim.state.rng.f32()<chance{pending_damage.push(if n.role==2{18.}else if n.role==3&&self.riding.is_some(){24.}else{8.});}events.push(SimEvent::Shot{pos:n.pos+Vec3::Y*1.4});}}},1|3=>{input.move_dir=dir*0.3;if n.timer<=0.{n.state=0;}},_=>{let target=n.home+Vec3::new((self.time*0.07+ni as f32).sin()*5.,0.,(self.time*0.07+ni as f32).cos()*5.);input.move_dir=toward(n.pos,target)*0.25;}}\n if terrain::water(&data,flat(n.pos)+input.move_dir*3.){input.move_dir=Vec2::new(-input.move_dir.y,input.move_dir.x);}if self.fire.at(flat(n.pos)+input.move_dir*4.)==1{input.move_dir=-self.wind;}\n if let Some(id)=n.entity{out.insert(id,input);}\n }\n for p in radio{for n in &mut self.soldiers{if n.hp>0.&&n.state<2&&distance(n.pos,p)<80.{n.state=2;n.detection=1.;n.timer=20.;}}}\n for amount in pending_damage{self.damage(amount*self.tuning.enemy_damage,0);}for (i,poison) in dead{self.soldiers[i].hp=1.;if poison{self.flag(\"dart_kill\");}self.hit_soldier(sim,i,500.,events);}for flag in flags{self.flag(flag);}if let Some(line)=bark{if self.subtitle_time<=0.{self.say(\"Soldier\",line);}}\n }\n pub fn safe_town_at(&self,p:Vec3)->bool{self.ceasefire&&distance(p,self.data.place(\"town\").pos())<76.}\n pub fn drive(&mut self,sim:&mut Sim,input:&InputFrame,dt:f32,events:&mut Vec<SimEvent>){let Some(i)=self.riding else{return;};let v=&mut self.vehicles[i];if v.exploded{self.riding=None;return;}let throttle=if input.axes!=Vec2::ZERO{input.axes.x-input.axes.y}else{-input.move_dir.y*self.yaw.cos()+input.move_dir.x*self.yaw.sin()};let steer=if input.axes!=Vec2::ZERO{input.move_dir.x}else{input.move_dir.x*self.yaw.cos()+input.move_dir.y*self.yaw.sin()};v.steer=steer;let max=if v.kind==3{16.}else if v.kind==2{18.}else if v.kind==1{30.}else{25.}*self.tuning.vehicle_speed*if v.hp<40.{0.6}else{1.};if self.seat==0{v.speed+=(throttle*max-v.speed)*dt*1.4;if input.down(b::JUMP){v.speed*=(-dt*8.).exp();}v.yaw+=(steer*v.speed*0.035).clamp(-1.5,1.5)*dt;}else{v.speed*=(-dt*1.5).exp();}\n let forward=Vec3::new(v.yaw.sin(),0.,-v.yaw.cos());let next=v.pos+forward*v.speed*dt;if v.kind==3{if terrain::water(&self.data,flat(next)){v.pos=next;v.pos.y=0.25+(self.time*2.).sin()*0.06;}else{v.speed=0.;}}else{if terrain::water(&self.data,flat(next)){v.speed*=0.5;v.hp-=dt;}else{v.pos=next;v.pos.y=terrain::height(&self.data,next.x,next.z);let slope=terrain::height(&self.data,next.x+forward.x*2.,next.z+forward.z*2.)-terrain::height(&self.data,next.x-forward.x*2.,next.z-forward.z*2.);v.pitch+=((-slope/4.).atan()-v.pitch)*(dt*6.).min(1.);v.roll+=(-steer*v.speed*0.006-v.roll)*(dt*5.).min(1.);}}\n self.pos=v.pos;self.pos.y+=0.65;self.speed=v.speed.abs();if self.map_up{self.flag(\"map_driving\");}if input.down(b::PRIMARY)&&self.seat==1{events.push(SimEvent::Shot{pos:self.pos+Vec3::Y*2.});}self.sync_player(sim);}\n pub fn survival(&mut self,sim:&mut Sim,dt:f32,_events:&mut Vec<SimEvent>){if self.health>0.&&self.health<100.&&self.health>=20.{let top=(self.health/20.).ceil()*20.;self.health=(self.health+dt*0.35).min(top);}\n if !self.cheats.fever{self.fever_timer-=dt;if self.fever_state==0&&self.fever_timer<=40.{self.fever_state=1;self.flag(\"fever_warned\");self.say(\"Field note\",self.s(\"fever_warn\").to_string());}if self.fever_timer<=0.&&self.fever_state==1{self.fever_state=2;self.fever_timer=-0.01;self.fever_attacks+=1;}if self.fever_state==2&&self.fever_timer<=-60.{self.fever_state=0;self.fever_timer=self.tuning.fever_interval*0.9f32.powi(self.fever_attacks as i32);self.health=50.;self.diamonds=(self.diamonds as f32*0.8).floor() as i32;self.hour=(self.hour+6.).rem_euclid(24.);let nearest=self.data.world.place.iter().filter(|p|p.kind==3).min_by(|a,b|distance(a.pos(),self.pos).total_cmp(&distance(b.pos(),self.pos))).unwrap();self.pos=nearest.pos()+Vec3::new(0.,0.,20.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.sync_player(sim);self.flag(\"blackout\");self.say(\"Field note\",self.s(\"blackout\").to_string());}}\n if self.rescue_time>0.{self.rescue_time-=dt;if self.session{if self.rescue_time<=0.{if self.team_lives>0{self.team_lives-=1;self.health=50.;self.pos=self.data.place(\"depot\").pos()+Vec3::new(-65.,0.,70.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.sync_player(sim);}else{self.finished=true;self.won=false;}}}else{self.pos-=Vec3::new(self.wind.x,0.,self.wind.y)*dt*2.;self.sync_player(sim);if self.rescue_time<=0.{self.health=50.;self.active=0;self.flag(\"player_rescued\");self.say(\"Companion\",self.s(\"rescue\").to_string());}}}\n let mut dead=false;for c in &mut self.companions{if c.alive&&c.down>0.{c.down-=dt;if c.down<=0.{c.alive=false;dead=true;}}}if dead{self.flag(\"companion_died\");self.say(\"Radio\",\"No reply. The stool will stay empty.\");}\n if self.tracker{let rate=self.tracker_rate();if rate>0.&&(self.time*rate).floor() as i32!=((self.time-dt)*rate).floor() as i32{self.sound(33);}}\n if let Some(w)=self.waypoint{if distance(w,self.pos)<20.{self.flag(\"gps_followed\");}}\n if self.wind_speed>6.{self.flag(\"wind_rag\");}\n }\n pub fn world_tick(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>){self.hour=(self.hour+dt/60.*self.tuning.clock_speed).rem_euclid(24.);self.world_hours+=dt/60.*self.tuning.clock_speed;self.wind_timer-=dt;if self.wind_timer<=0.{self.wind_timer=sim.state.rng.range(180.,360.);let angle=sim.state.rng.range(-0.6,0.6);self.wind=Vec2::from_angle(self.wind.y.atan2(self.wind.x)+angle);self.wind_speed=sim.state.rng.range(2.,12.);}\n self.weather_time-=dt;if self.weather_time<=0.{self.weather=(self.weather+1)%3;self.weather_time=if self.weather==2{90.}else{sim.state.rng.range(180.,360.)};if self.weather==2{self.sound(34);self.fire.ignite(&self.data,flat(self.pos)+Vec2::new(80.,60.),2.);self.flag(\"fire_lightning\");}}\n if !self.session||self.host{let prior=self.fire.burning();self.fire.step(&self.data,&mut sim.state.rng,&self.tuning,self.wind,self.wind_speed,self.weather==2,dt);if self.weather==2&&prior>0{self.flag(\"rain_extinguished\");}if self.fire.total>=500{self.flag(\"big_fire\");}\n let burning=self.fire.at(flat(self.pos))==1;if burning{self.burning=3.;}if terrain::water(&self.data,flat(self.pos)){self.burning=0.;self.guns[self.active].condition=(self.guns[self.active].condition-dt*0.08).max(0.);}if self.burning>0.{self.burning-=dt;self.damage(self.tuning.burn_damage*dt,2);}\n let mut exploding=Vec::new();for (i,o) in self.objects.iter_mut().enumerate(){if o.exploded{continue;}if self.fire.at(flat(o.pos))==1&&o.fuse<0.{o.fuse=if o.kind==1{3.}else{1.5};}if o.fuse>=0.{o.fuse-=dt;if o.fuse<=0.{o.exploded=true;exploding.push((i,o.pos));}}}for (_,p) in exploding{self.explode(sim,p,8.,160.,events);self.flag(\"explosion_chain\");}\n let mut vexp=Vec::new();for v in &mut self.vehicles{if v.exploded{continue;}if self.fire.at(flat(v.pos))==1{v.hp-=dt*5.;}if v.hp<15.&&v.fuse<0.{v.fuse=8.;}if v.fuse>=0.{v.fuse-=dt;if v.fuse<=0.{v.exploded=true;vexp.push(v.pos);}}}for p in vexp{self.explode(sim,p,7.,180.,events);self.flag(\"fire_vehicle\");}\n let mut post_flags=Vec::new();for post in &mut self.posts{let pi=self.data.world.place.iter().position(|p|p.id==post.place).unwrap();let p=self.data.world.place[pi].pos();let living=self.soldiers.iter().any(|n|n.group==pi&&n.hp>0.);if !living&&!post.cleared{post.cleared=true;post.cleared_at=self.world_hours;post_flags.push(\"post_cleared\");}if post.cleared&&self.world_hours-post.cleared_at>self.tuning.reman_hours&&!post.safe&&distance(p,self.pos)>200.{post.cleared=false;for n in self.soldiers.iter_mut().filter(|n|n.group==pi){n.hp=80.;n.pos=n.home;n.state=0;n.detection=0.;}post_flags.push(\"post_remanned\");}}for flag in post_flags{self.flag(flag);}}\n for a in &mut self.animals{if self.fire.at(flat(a.pos))==1{a.fleeing=8.;}if a.fleeing>0.{a.fleeing-=dt;let dir=toward(self.pos,a.pos);a.pos+=Vec3::new(dir.x,0.,dir.y)*dt*8.;a.yaw=dir.x.atan2(-dir.y);a.pos.y=terrain::height(&self.data,a.pos.x,a.pos.z);}}\n }\n pub fn attract(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>){let duration:f32=self.data.attract.iter().map(|s|s.seconds).sum();self.attract_time+=dt;if self.attract_time>=duration{self.attract_time-=duration;self.attract_loops+=1;}let mut t=self.attract_time;let mut si=0;for (i,s) in self.data.attract.iter().enumerate(){if t<s.seconds{si=i;break;}t-=s.seconds;}let s=self.data.attract[si].clone();if self.attract_segment!=si{self.attract_segment=si;self.pos=self.data.place(&s.place).pos()+Vec3::new(0.,0.,55.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.hour=s.hour;self.health=100.;self.aiming=false;self.map_up=false;self.action=None;self.riding=None;self.yaw=0.;self.pitch=0.;if s.action==\"fire\"{self.fire.ignite(&self.data,flat(self.data.place(\"depot\").pos())-Vec2::splat(20.),6.);}if s.action==\"heal\"{self.action=Some(Action{kind:\"wound_0\".into(),left:4.,duration:4.,param:0});}if s.action==\"map\"{self.map_up=true;}if s.action==\"rescue\"{self.rescue_time=6.;}if s.action==\"jam\"{self.guns[self.active].jammed=true;}}\n self.pos.x+=dt*0.8;self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.yaw=(t*0.02).sin()*0.4;self.view_time+=dt;self.fire.step(&self.data,&mut sim.state.rng,&self.tuning,self.wind,8.,false,dt);if s.action==\"jam\"&&t>4.{self.guns[self.active].jammed=false;}if s.action==\"drive\"||s.action==\"boat\"{self.pos.z-=dt*4.;}self.sync_player(sim);let _=events;}\n}\nRS\ncat > engine/crates/pav_core/src/games/merc/campaign.rs <<'\"'RS'\nuse glam::{Vec2,Vec3};\nuse crate::{Sim,SimEvent};\nuse super::{*,data::{distance,flat}};\nimpl Merc{\n pub fn current_goal(&self)->Option<data::GoalDef>{if self.contract>=self.data.contracts.len(){return None;}self.data.contracts[self.contract].goal.get(self.goal).cloned()}\n pub fn goal_pos(&self)->Vec3{self.current_goal().map(|g|self.data.place(&g.place).pos()).unwrap_or(self.pos)}\n pub fn accept_contract(&mut self){self.contract_active=true;self.goal=0;self.goal_time=0.;self.goal_flag=false;self.save_serial+=1;let c=self.data.contracts[self.contract].clone();self.say(&c.giver,c.brief.replace('\\\\n',\\\" \\\"));self.open(\\\"playing\\\");if self.contract==3{self.owned.insert(9);self.guns[1]=Gun::new(9,&self.data.weapons[9],100.);}if self.contract==6{self.owned.insert(8);self.guns[1]=Gun::new(8,&self.data.weapons[8],100.);}if self.contract==7{self.owned.insert(12);self.guns[2]=Gun::new(12,&self.data.weapons[12],100.);}if self.contract==5{self.better_way=true;self.flag(\\\"better_way_taken\\\");}}\n pub fn contract_tick(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>){if self.session {self.round_time+=dt;let destroyed=self.objects.iter().filter(|o|o.place==\\\"depot\\\"&&o.kind==1&&o.exploded).count();if destroyed==3&&self.ledger_carrier>=0 {let exit=self.data.place(\\\"depot\\\").pos()+Vec3::new(0.,0.,500.);let me=self.local_id==255||self.health<=0.||distance(self.pos,exit)<30.;let peers=self.peers.iter().filter(|p|p.present&&p.hp>0.).all(|p|distance(p.pos,exit)<30.);if me&&peers{self.finished=true;self.won=true;self.team_score+=100;}}if self.round_time>600.{self.finished=true;self.won=false;}return;}\n if self.ending>0 {self.ending_time+=dt;if self.ending==2{if (self.ending_time/12.).floor() as i32\"'!=((self.ending_time-dt)/12.).floor() as i32 {let p=self.pos+Vec3::new(24.,0.,-24.);self.spawn_enemy(sim,p,(self.ending_time as u8/12)%5);self.fire.ignite(&self.data,flat(p),3.);}if self.ending_time>=180.{self.end_interview();}}else if self.ending_time>14.{self.end_interview();}return;}\n if !self.contract_active{return;}let Some(goal)=self.current_goal() else{return;};let p=self.data.place(&goal.place).pos();let near=distance(self.pos,p)<if goal.kind==\"target\"{450.}else{30.};self.goal_time+=dt;\n let success=match goal.kind.as_str(){\"reach\"=>near,\"pills\"=>self.coverage.contains(\"pill_taken\"),\"clear\"=>self.posts.iter().any(|q|q.place==goal.place&&q.cleared),\"claim\"=>self.posts.iter().any(|q|q.place==goal.place&&q.claimed),\"shop\"=>self.coverage.contains(\"weapon_bought\"),\"tanks\"=>self.objects.iter().filter(|o|o.place==goal.place&&o.kind==1&&o.exploded).count()>=3,\"escape\"=>near,\"night\"=>self.coverage.contains(\"sleep_used\")&&!(5.0..20.0).contains(&self.hour),\"tag\"=>self.soldiers.iter().any(|n|n.target&&n.tagged),\"target\"=>self.soldiers.iter().any(|n|n.target&&n.hp<=0.),\"companion\"=>self.goal_flag||self.companions.iter().any(|c|!c.alive),_=>self.goal_flag};\n if self.contract==0&&self.goal==1&&near&&self.fever_state==0&&!self.coverage.contains(\"pill_taken\"){self.fever_timer=35.;self.note(\"The bar door is close. So is the fever.\");}\n if success{self.advance_goal(sim,events);}\n }\n pub fn advance_goal(&mut self,_sim:&mut Sim,_events:&mut Vec<SimEvent>){self.goal+=1;self.goal_time=0.;self.goal_flag=false;let c=self.data.contracts[self.contract].clone();if self.goal>=c.goal.len(){self.complete.insert(self.contract);self.flag(&format!(\"contract_{}\",c.id));let pay=(c.pay as f32*self.tuning.contract_pay).round() as i32;self.diamonds+=pay;if matches!(self.contract,2|6){self.income[0]+=pay;}else{self.income[1]+=pay;}self.infamy+=1;self.contract_active=false;self.save_serial+=1;self.note(format!(\"{} · +{} diamonds. {}\",c.name,pay,self.s(\"mission_end\")));if self.contract==0{self.pills=3;self.health=100.;self.collect_tape(\"bar\");}if self.contract==1{for c in &mut self.companions{c.recruited=c.alive;}}if self.contract==4{self.pills=5;}if self.contract==6{self.ceasefire=false;self.flag(\"ceasefire_ended\");self.say(\"Thandiwe Moyo\",self.s(\"ceasefire\").to_string());}if self.contract==8{self.town_burned=true;self.flag(\"town_burned\");}if self.contract<10{self.contract+=1;}if self.contract==8{self.hour=22.;let p=self.data.place(\"town\").pos();self.fire.ignite(&self.data,flat(p)+Vec2::new(35.,25.),8.);}if self.contract==10{self.open(\"ending_choice\");}else{self.parent=\"playing\".into();self.open(\"contract\");}}}\n pub fn interact_goal(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>)->bool{if self.session {let depot=self.data.place(\"depot\").pos();if distance(self.pos,depot)<25.&&self.objects.iter().filter(|o|o.place==\"depot\"&&o.exploded).count()>=3{if self.ledger_carrier<0{self.ledger_carrier=self.local_id as i32;self.team_score+=100;self.note(\"Ledger taken. Reach the extraction boat, 500 m south.\");}else if self.ledger_carrier==self.local_id as i32{self.ledger_carrier=-1;}return true;}return false;}\n if !self.contract_active{return false;}let Some(goal)=self.current_goal()else{return false;};let p=self.data.place(&goal.place).pos();if distance(self.pos,p)>30.{return false;}match goal.kind.as_str(){\"sabotage\"=>{self.goal_flag=true;self.flag(\"night_contract\");self.collect_tape(\"mission\");self.fire.ignite(&self.data,flat(p)+Vec2::new(7.,0.),2.);self.note(\"Pump governor removed. Water has changed owners.\");},\"cargo\"=>{self.goal_flag=true;let v=self.vehicles.iter().position(|v|v.kind==2).unwrap_or(0);self.vehicles[v].pos=self.pos+Vec3::new(4.,0.,0.);self.vehicles[v].hp=100.;self.note(\"Medicine loaded. Truck keys on the dash.\");},\"deliver\"=>{if !self.coverage.contains(\"repair_done\"){if let Some(i)=self.riding{self.vehicles[i].hp=28.;self.riding=None;}self.note(\"The engine has stopped. Repair it at the hood.\");return true;}self.goal_flag=true;self.pills=5;self.collect_tape(\"mission\");},\"convoy\"=>{let enemies=self.soldiers.iter().any(|n|n.hp>0.&&distance(n.pos,p)<35.);if enemies{self.note(\"The manifest is under armed supervision.\");return true;}self.goal_flag=true;if self.contract==5{if let Some(c)=self.companions.iter_mut().find(|c|c.alive&&c.recruited){c.pos=self.pos+Vec3::new(8.,0.,4.);c.down=self.tuning.rescue_window;c.mortal=self.trouble_count%2==1;self.trouble_count+=1;}self.say(\"Companion\",self.s(\"companion_down\").to_string());}},\"manifest\"=>{self.goal_flag=true;self.collect_tape(\"works\");self.note(\"The same stencils. The same signature.\");},\"evacuate\"=>{self.open(\"evacuate\");},\"ledger\"=>{self.goal_flag=true;self.collect_tape(\"works\");self.say(\"The Chandler\",self.s(\"ledger\").to_string());},_=>return false};let _=(sim,events);true}\n pub fn choose_ending(&mut self,n:u8){self.ending=n;self.ending_time=0.;self.flag(match n{1=>\"ending_burn\",2=>\"ending_read\",_=>\"ending_chair\"});self.contract_active=false;if n==1{self.fire.ignite(&self.data,flat(self.data.place(\"works\").pos()),12.);self.say(\"Field note\",self.s(\"ending_burn\").to_string());}else if n==2{self.say(\"Thandiwe Moyo\",self.s(\"ending_read\").to_string());}else{self.say(\"Radio\",self.s(\"ending_chair\").to_string());}self.open(if n==2{\"ending_defend\"}else{\"playing\"});}\n pub fn end_interview(&mut self){self.outcome=Outcome::Won;self.complete.insert(10);self.flag(\"contract_D2\");let merc=self.s(&format!(\"dossier_{}\",self.merc)).split('\"'|').next().unwrap_or(\\\"\\\").to_string();let lost=self.companions.iter().filter(|c|\"'!c.alive).count();let paid=if self.income[0]>self.income[1]{\"the Council\"}else{\"the Hand\"};self.say(\"Your voice\",format!(\"{merc}. {lost} companions lost. Most of the money came from {paid}. Moyo: Would you do it again? You leave the tape running.\"));self.open(\"ending\");self.save_serial+=1;}\n pub fn spawn_enemy(&mut self,_sim:&mut Sim,mut p:Vec3,role:u8){p.y=terrain::height(&self.data,p.x,p.z);self.soldiers.push(Soldier{pos:p,home:p,yaw:0.,hp:80.,role,faction:role%2,group:18,detection:1.,state:2,timer:20.,cooldown:2.,gun:Gun::new(4,&self.data.weapons[4],35.),entity:None,tagged:false,poison:0.,burning:0.,target:false});}\n}\nRS'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/merc/menus.rs <<'RS'\nuse crate::{Sim,SimEvent};\nuse super::{*,act};\n#[derive(Clone,Debug,Serialize,Deserialize)]pub struct Row{pub name:String,pub detail:String,pub value:Option<[f32;3]>}\nimpl Row{fn text(s:impl Into<String>)->Self{Self{name:s.into(),detail:String::new(),value:None}}fn toggle(s:&str,b:bool)->Self{Self{name:s.into(),detail:if b{\\\"On\\\"}else{\\\"Off\\\"}.into(),value:None}}fn slider(s:&str,v:f32,a:f32,z:f32)->Self{Self{name:s.into(),detail:format\"'!(\"{v:.2}\"),value:Some([v,a,z])}}}\nimpl Merc{\n pub fn rows(&self)->Vec<Row>{let labels=|l:&[&str]|l.iter().map(|s|Row::text(self.s(s))).collect::<Vec<_>>();let page=self.page*6;match self.screen.as_str(){\n \"title\"=>labels(&[\"continue\",\"new\",\"multiplayer\",\"settings\",\"about\"]),\"difficulty\"=>labels(&[\"Easy\",\"Normal\",\"Hard\"]),\"dossier\"=>(0..4).map(|i|{let text=self.s(&format!(\"dossier_{i}\"));let (name,detail)=text.split_once('\"'|').unwrap();Row{name:name.into(),detail:detail.into(),value:None}}).collect(),\n \\\"pause\\\"=>labels(&[\\\"resume\\\",\\\"settings\\\",\\\"controls\\\",\\\"dev\\\",\\\"quit\\\"]),\\\"quit\\\"=>labels(&[\\\"Return to title\\\",\\\"resume\\\"]),\\\"death\\\"=>labels(&[\\\"Reload autosave\\\",\\\"Return to title\\\"]),\\\"ending\\\"=>labels(&[\\\"end_return\\\",\\\"about\\\"]),\\\"ending_choice\\\"=>labels(&[\\\"burn_choice\\\",\\\"read_choice\\\",\\\"chair_choice\\\"]),\n \\\"contract\\\"=>labels(&[if self.contract_active{\\\"resume\\\"}else{\\\"accept\\\"},\\\"decline\\\"]),\\\"town\\\"=>labels(&[\\\"contract\\\",\\\"shop_title\\\",\\\"companion\\\",\\\"tape\\\",\\\"bus\\\",\\\"clinic\\\"]),\\\"safehouse\\\"=>labels(&[\\\"sleep\\\",\\\"inventory\\\",\\\"Resupply\\\",\\\"Manual saves\\\",\\\"tape\\\"]),\\\"sleep\\\"=>labels(&[\\\"Dawn · 06:00\\\",\\\"Noon · 12:00\\\",\\\"Dusk · 18:00\\\",\\\"Midnight · 00:00\\\"]),\n \\\"saves\\\"=>(0..6).map(|i|Row::text(format\"'!(\"{} {}\",if i<3{\"Save slot\"}else{\"Load slot\"},i%3+1))).collect(),\n \"shop\"=>{let names:Vec<_>=self.data.weapons.iter().map(|w|w.name.clone()).chain([\"Reliability\",\"Accuracy\",\"Ammo pouch\",\"Syrette bandolier\",\"Vehicle kit\",\"Camo suit\",\"Quinine · 3 pills\",\"Quinine reserve\"].iter().map(|s|s.to_string())).collect();names.iter().enumerate().skip(page).take(6).map(|(i,n)|Row{name:n.clone(),detail:if i<14&&self.owned.contains(&i){\"Licensed · fresh at every locker\".into()}else{format!(\"{} diamonds\",if i<14{[5,5,4,5,8,10,8,8,12,10,12,12,14,12][i]}else{[6,6,6,8,10,5,7,7][i-14]})},value:None}).collect()},\n \"locker\"=>self.owned.iter().skip(page).take(6).map(|i|Row{name:self.data.weapons[*i].name.clone(),detail:\"Fresh crate · New\".into(),value:None}).collect(),\n \"bus\"=>[\"town\",\"junction\",\"bus_mission\"].iter().map(|id|Row::text(self.data.place(id).name.clone())).collect(),\"clinic\"=>labels(&[\"Medicine errand · 3 diamonds\",\"Refill quinine · 5 diamonds\",\"back\"]),\n \"companion\"=>labels(&[\"patch\",\"overdose\"]),\"evacuate\"=>labels(&[\"Save Papa Lazare\",\"Save Mr. Desai\"]),\"tapes\"=>self.tapes.iter().skip(page).take(6).map(|i|Row::text(self.data.tapes[*i].name.clone())).collect(),\"recruit\"=>self.companions.iter().map(|c|Row{name:self.s(&format!(\"dossier_{}\",c.merc)).split('\"'|').next().unwrap_or(\\\"\\\").into(),detail:if \"'!c.alive{\"Empty stool\"}else if c.recruited{\"With you\"}else{\"Available\"}.into(),value:None}).collect(),\n \"settings\"|\"session_settings\"=>{let s=&self.settings;match self.page%4{0=>vec![Row::slider(\"Master\",s.master,0.,1.),Row::slider(\"Music\",s.music,0.,1.),Row::slider(\"Sound effects\",s.sfx,0.,1.),Row::slider(\"Voices\",s.voices,0.,1.)],1=>vec![Row{name:\"Prompt symbols\".into(),detail:if s.xbox{\"Xbox\"}else{\"PlayStation\"}.into(),value:None},Row::toggle(\"Invert Y\",s.invert),Row::slider(\"Stick sensitivity\",s.stick,40.,240.),Row::slider(\"Mouse sensitivity\",s.mouse,0.02,0.4),Row::toggle(\"Aim assist\",s.aim_assist),Row::toggle(\"Toggle crouch\",s.toggle_crouch)],2=>vec![Row::toggle(\"Fullscreen\",s.fullscreen),Row::slider(\"Field of view\",s.fov,55.,100.),Row::slider(\"Brightness\",s.brightness,0.5,1.5),Row::slider(\"Head bob\",s.bob,0.,1.)],_=>vec![Row::slider(\"Subtitle size\",s.subtitles,0.8,1.4),Row::slider(\"Reduce camera motion\",1.-s.motion,0.,1.),Row::toggle(\"Assist markers\",s.markers),Row::toggle(\"Standard HUD\",s.standard)]}},\n \"controls\"|\"about\"=>Vec::new(),\"multiplayer\"=>labels(&[\"solo\",\"invite\"]),\"local_lobby\"=>labels(&[\"create\",\"join\",\"start\"]),\"invite\"=>labels(&[\"Create offer\",\"Create answer\",\"Connect answer\",\"Copy code\",\"back\"]),\n \"dev\"=>labels(&[\"dev_cheats\",\"dev_teleport\",\"dev_story\",\"dev_give\",\"dev_world\",\"dev_balance\"]),\n \"dev_cheats\"=>{let c=&self.cheats;[Row::toggle(\"God mode\",c.god),Row::toggle(\"Infinite ammo\",c.ammo),Row::toggle(\"No jams\",c.jams),Row::toggle(\"No fever\",c.fever),Row::toggle(\"Noclip\",c.noclip),Row::toggle(\"Invisible to AI\",c.invisible),Row::toggle(\"AI state\",c.ai),Row::toggle(\"Fire grid\",c.fire),Row::toggle(\"Navigation\",c.nav),Row::toggle(\"FPS and tick stats\",c.stats)].into_iter().skip(page).take(6).collect()},\n \"dev_teleport\"=>self.data.world.place.iter().skip(page).take(6).map(|p|Row::text(p.name.clone())).collect(),\"dev_story\"=>self.data.contracts.iter().skip(page).take(6).map(|p|Row::text(p.name.clone())).collect(),\n \"dev_give\"=>[\"Rifle squad\",\"Flame trooper\",\"Technical\",\"River boat\",\"Fresh weapon\",\"Rusted weapon\",\"10 diamonds\",\"5 pills\",\"5 syrettes\",\"Kill nearby\"].iter().skip(page).take(6).map(|s|Row::text(*s)).collect(),\n \"dev_world\"=>[Row::slider(\"Time of day\",self.hour,0.,24.),Row::slider(\"Wind speed\",self.wind_speed,0.,12.),Row::slider(\"Wind direction\",self.wind.y.atan2(self.wind.x),-3.14,3.14),Row::text(\"Cycle weather\"),Row::text(\"Ignite at sight\"),Row::text(\"Extinguish all\"),Row::text(\"Regrow the country\"),Row::text(self.s(\"reset\"))].into_iter().skip(page).take(6).collect(),\n \"dev_balance\"=>{let mut tuning=self.tuning.clone();let mut r=crate::params::list(&mut tuning).into_iter().map(|p|{if let crate::params::ParamKind::Float{min,max}=p.kind{Row::slider(&p.help,p.value.as_f64().unwrap_or(0.) as f32,min,max)}else{Row::text(p.help)}}).collect::<Vec<_>>();r.push(Row::text(self.s(\"reset\")));r.into_iter().skip(page).take(6).collect()},_=>Vec::new()}}\n pub fn page_count(&self)->usize{match self.screen.as_str(){\"shop\"=>4,\"locker\"=>self.owned.len().div_ceil(6).max(1),\"tapes\"=>self.tapes.len().div_ceil(6).max(1),\"settings\"|\"session_settings\"=>4,\"about\"=>self.data.about.len(),\"controls\"=>3,\"dev_cheats\"|\"dev_give\"|\"dev_story\"=>2,\"dev_teleport\"=>4,\"dev_world\"=>2,\"dev_balance\"=>4,_=>1}}\n pub fn menu_input(&mut self,sim:&mut Sim,a:u32,events:&mut Vec<SimEvent>){let n=self.rows().len();match a{act::UP=>{if n>0{self.focus=(self.focus+n-1)%n;}self.sound(0);},act::DOWN=>{if n>0{self.focus=(self.focus+1)%n;}self.sound(0);},act::PREV|act::NEXT=>{let pages=self.page_count();self.page=if a==act::NEXT{(self.page+1)%pages}else{(self.page+pages-1)%pages};self.focus=0;self.sound(0);},act::LEFT|act::RIGHT=>{let sign=if a==act::LEFT{-1.}else{1.};if self.screen==\"settings\"||self.screen==\"session_settings\"{self.adjust_setting(sign);}else if self.screen==\"dev_balance\"{let i=self.page*6+self.focus;let mut ps=crate::params::list(&mut sim.config.merc);if let Some(p)=ps.get_mut(i){if let crate::params::ParamKind::Float{min,max}=p.kind{let val=(p.value.as_f64().unwrap() as f32+sign*(max-min)/40.).clamp(min,max);let _=crate::params::set(&mut sim.config.merc,&p.path,crate::params::ParamValue::Float(val as f64));self.tuning=sim.config.merc.clone();}}}else if self.screen==\"dev_world\"{self.adjust_world(sign);}else{self.menu_input(sim,if a==act::LEFT{act::PREV}else{act::NEXT},events);}},act::CONFIRM=>self.select(sim,events),act::BACK=>{let s=match self.screen.as_str(){\"settings\"|\"controls\"|\"about\"=>self.parent.clone(),\"session_settings\"=>\"playing\".into(),\"dev_cheats\"|\"dev_teleport\"|\"dev_story\"|\"dev_give\"|\"dev_world\"|\"dev_balance\"=>\"dev\".into(),\"dev\"=>\"pause\".into(),\"difficulty\"|\"dossier\"|\"multiplayer\"=>\"title\".into(),\"shop\"|\"recruit\"|\"tapes\"|\"clinic\"|\"bus\"=>\"playing\".into(),_=>\"playing\".into()};self.open(&s);},_=>{}}}\n pub fn select(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){let i=self.focus;let page=self.page;let screen=self.screen.clone();self.sound(0);match screen.as_str(){\n \"title\"=>match i{0=>{self.load_slot=0;},1=>self.open(\"difficulty\"),2=>self.open(\"multiplayer\"),3=>{self.parent=\"title\".into();self.open(\"settings\");},4=>{self.parent=\"title\".into();self.open(\"about\");},_=>{}},\n \"difficulty\"=>{self.difficulty=i as u8;sim.config.merc=Tuning::default();match i{0=>{sim.config.merc.enemy_damage=0.65;sim.config.merc.enemy_accuracy=0.18;sim.config.merc.wear=0.7;sim.config.merc.fever_interval=1200.;},2=>{sim.config.merc.enemy_damage=1.4;sim.config.merc.enemy_accuracy=0.4;sim.config.merc.wear=1.4;sim.config.merc.fever_interval=720.;},_=>{}}self.open(\"dossier\");},\"dossier\"=>{self.start(i);self.sync_player(sim);},\n \"pause\"=>match i{0=>self.open(\"playing\"),1=>{self.parent=\"pause\".into();self.open(\"settings\");},2=>{self.parent=\"pause\".into();self.open(\"controls\");},3=>self.open(\"dev\"),4=>self.open(\"quit\"),_=>{}},\"quit\"=>{self.open(if i==0{\"title\"}else{\"playing\"});},\n \"death\"=>{if i==0{self.load_slot=0;}else{self.open(\"title\");}},\"ending\"=>{self.parent=\"ending\".into();self.open(if i==0{\"title\"}else{\"about\"});},\"ending_choice\"=>self.choose_ending((i+1) as u8),\n \"settings\"|\"session_settings\"=>self.adjust_setting(1.),\"contract\"=>{if i==0&&!self.contract_active{self.accept_contract();}else{self.open(\"playing\");}},\n \"town\"=>self.open([\"contract\",\"shop\",\"recruit\",\"tapes\",\"bus\",\"clinic\"][i.min(5)]),\n \"safehouse\"=>match i{0=>self.open(\"sleep\"),1=>self.open(\"locker\"),2=>{for gun in &mut self.guns{gun.reserve=self.data.weapons[gun.def].reserve*if self.upgrades.contains(&0){2}else{1};}self.syrettes=if self.upgrades.contains(&1){5}else{3};self.molotov=4;self.grenades=4;self.note(\"Crates open. The bill arrives later.\");},3=>self.open(\"saves\"),4=>self.open(\"tapes\"),_=>{}},\n \"sleep\"=>{self.hour=[6.,12.,18.,0.][i%4];self.world_hours+=8.;self.health=100.;self.stamina=12.;self.fever_timer=self.tuning.fever_interval;self.wind=glam::Vec2::from_angle(self.world_hours*0.3);self.wind_speed=5.+self.hour.sin().abs()*5.;for c in &mut self.companions{c.rescue=false;}self.flag(\"sleep_used\");self.save_serial+=1;self.open(\"playing\");},\n \"saves\"=>{if i<3{self.save_slot=i as i32+1;self.save_serial+=1;self.note(format!(\"Saved in slot {}.\",i+1));}else{self.load_slot=(i-2) as i32;}},\"shop\"=>self.buy(page*6+i),\"locker\"=>{if let Some(w)=self.owned.iter().nth(page*6+i).copied(){let slot=self.data.weapons[w].slot;self.guns[slot]=Gun::new(w,&self.data.weapons[w],100.);self.active=slot;self.flag(\"locker_used\");self.note(\"Fresh steel. Enjoy the interval.\");}},\n \"bus\"=>{if self.diamonds>=1{self.diamonds-=1;let p=self.data.place([\"town\",\"junction\",\"bus_mission\"][i%3]).pos();self.pos=p+glam::Vec3::new(0.,0.,25.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.riding=None;self.hour=(self.hour+2.).rem_euclid(24.);self.world_hours+=2.;self.flag(\"bus_taken\");self.flag(\"diamonds_spent\");self.sync_player(sim);self.open(\"playing\");}else{self.note(self.s(\"no_money\").to_string());}},\n \"clinic\"=>{if i==0{if self.diamonds>=3{self.diamonds-=3;self.pills+=3;self.infamy+=1;self.note(\"Medicine delivered to the annex. Quinine received.\");}}else if i==1&&self.diamonds>=5{self.diamonds-=5;self.pills+=3;}else if i==2{self.open(\"playing\");}},\n \"recruit\"=>{if let Some(c)=self.companions.get_mut(i){if c.alive{c.recruited=true;c.trust+=1;self.say(\"Companion\",self.s(\"recruit\").to_string());}}},\"tapes\"=>{if let Some(t)=self.tapes.iter().nth(page*6+i).copied(){self.playing_tape=Some(t);self.tape_line=0;self.tape_timer=0.;self.flag(\"tape_played\");self.open(\"playing\");}},\n \"companion\"=>{self.open(\"playing\");self.command(sim,if i==0{act::PATCH}else{act::OVERDOSE},events);},\"evacuate\"=>{self.saved_person=i as u8+1;self.goal_flag=true;self.open(\"playing\");self.say(if i==0{\"Papa Lazare\"}else{\"Mr. Desai\"},\"I will remember this. That is not a promise of repayment.\");},\n \"multiplayer\"=>self.open(if i==0{\"local_lobby\"}else{\"invite\"}),\"local_lobby\"|\"invite\"=>{self.net_ui=i as i32+if screen==\"invite\"{10}else{1};},\n \"dev\"=>self.open([\"dev_cheats\",\"dev_teleport\",\"dev_story\",\"dev_give\",\"dev_world\",\"dev_balance\"][i.min(5)]),\n \"dev_cheats\"=>{let c=&mut self.cheats;let v=match page*6+i{0=>&mut c.god,1=>&mut c.ammo,2=>&mut c.jams,3=>&mut c.fever,4=>&mut c.noclip,5=>&mut c.invisible,6=>&mut c.ai,7=>&mut c.fire,8=>&mut c.nav,_=>&mut c.stats};*v=!*v;},\n \"dev_teleport\"=>self.command(sim,act::TELEPORT+(page*6+i) as u32,events),\"dev_story\"=>self.command(sim,act::STORY+(page*6+i) as u32,events),\n \"dev_give\"=>match page*6+i{0=>{for r in 0..5{self.spawn_enemy(sim,self.pos+glam::Vec3::new(12.+r as f32*3.,0.,-20.),r);}},1=>self.spawn_enemy(sim,self.pos+glam::Vec3::new(10.,0.,-15.),4),2|3=>{let mut v=self.vehicles[0].clone();v.pos=self.pos+glam::Vec3::new(6.,0.,0.);v.kind=if i==3{3}else{0};v.hp=100.;v.exploded=false;self.vehicles.push(v);},4=>self.guns[self.active].condition=100.,5=>self.guns[self.active].condition=5.,6=>self.diamonds+=10,7=>self.pills+=5,8=>self.syrettes+=5,_=>{let ids:Vec<_>=self.soldiers.iter().enumerate().filter(|(_,n)|n.hp>0.&&data::distance(n.pos,self.pos)<100.).map(|(i,_)|i).collect();for i in ids{self.hit_soldier(sim,i,1000.,events);}}},\n \"dev_world\"=>match page*6+i{0..=2=>self.adjust_world(1.),3=>{self.weather=(self.weather+1)%3;self.weather_time=90.;},4=>{self.fire.ignite(&self.data,data::flat(self.pos+self.forward()*12.),5.);},5=>{for c in self.fire.cells.values_mut(){c.state=2;c.time=0.;}},6=>self.fire=fire::Fire::default(),_=>{sim.config.merc=Tuning::default();self.tuning=Tuning::default();}},\n \"dev_balance\"=>{if page*6+i>=23{sim.config.merc=Tuning::default();self.tuning=Tuning::default();}else{self.menu_input(sim,act::RIGHT,events);}},_=>{}}\n }\n pub fn adjust_setting(&mut self,sign:f32){let f=self.focus;let s=&mut self.settings;match self.page%4{0=>{let v=match f{0=>&mut s.master,1=>&mut s.music,2=>&mut s.sfx,_=>&mut s.voices};*v=(*v+sign*0.05).clamp(0.,1.);},1=>match f{0=>s.xbox=!s.xbox,1=>s.invert=!s.invert,2=>s.stick=(s.stick+sign*10.).clamp(40.,240.),3=>s.mouse=(s.mouse+sign*0.01).clamp(0.02,0.4),4=>s.aim_assist=!s.aim_assist,_=>s.toggle_crouch=!s.toggle_crouch},2=>match f{0=>s.fullscreen=!s.fullscreen,1=>s.fov=(s.fov+sign*5.).clamp(55.,100.),2=>s.brightness=(s.brightness+sign*0.05).clamp(0.5,1.5),_=>s.bob=(s.bob+sign*0.1).clamp(0.,1.)},_=>match f{0=>s.subtitles=(s.subtitles+sign*0.1).clamp(0.8,1.4),1=>s.motion=(s.motion-sign*0.1).clamp(0.,1.),2=>s.markers=!s.markers,_=>s.standard=!s.standard}}}\n fn adjust_world(&mut self,sign:f32){match self.page*6+self.focus{0=>self.hour=(self.hour+sign).rem_euclid(24.),1=>self.wind_speed=(self.wind_speed+sign).clamp(0.,12.),2=>self.wind=glam::Vec2::from_angle(self.wind.y.atan2(self.wind.x)+sign*0.2),_=>{}}}\n}\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/merc/menus.rs <<'RS'\nuse crate::{Sim,SimEvent};\nuse super::{*,act};\n#[derive(Clone,Debug,Serialize,Deserialize)]pub struct Row{pub name:String,pub detail:String,pub value:Option<[f32;3]>}\nimpl Row{fn text(s:impl Into<String>)->Self{Self{name:s.into(),detail:String::new(),value:None}}fn toggle(s:&str,b:bool)->Self{Self{name:s.into(),detail:if b{\\\"On\\\"}else{\\\"Off\\\"}.into(),value:None}}fn slider(s:&str,v:f32,a:f32,z:f32)->Self{Self{name:s.into(),detail:format\"'!(\"{v:.2}\"),value:Some([v,a,z])}}}\nimpl Merc{\n pub fn rows(&self)->Vec<Row>{let labels=|l:&[&str]|l.iter().map(|s|Row::text(self.s(s))).collect::<Vec<_>>();let page=self.page*6;match self.screen.as_str(){\n \"title\"=>labels(&[\"continue\",\"new\",\"multiplayer\",\"settings\",\"about\"]),\"difficulty\"=>labels(&[\"Easy\",\"Normal\",\"Hard\"]),\"dossier\"=>(0..4).map(|i|{let text=self.s(&format!(\"dossier_{i}\"));let (name,detail)=text.split_once('\"'|').unwrap();Row{name:name.into(),detail:detail.into(),value:None}}).collect(),\n \\\"pause\\\"=>labels(&[\\\"resume\\\",\\\"settings\\\",\\\"controls\\\",\\\"dev\\\",\\\"quit\\\"]),\\\"quit\\\"=>labels(&[\\\"Return to title\\\",\\\"resume\\\"]),\\\"death\\\"=>labels(&[\\\"Reload autosave\\\",\\\"Return to title\\\"]),\\\"ending\\\"=>labels(&[\\\"end_return\\\",\\\"about\\\"]),\\\"ending_choice\\\"=>labels(&[\\\"burn_choice\\\",\\\"read_choice\\\",\\\"chair_choice\\\"]),\n \\\"contract\\\"=>labels(&[if self.contract_active{\\\"resume\\\"}else{\\\"accept\\\"},\\\"decline\\\"]),\\\"town\\\"=>labels(&[\\\"contract\\\",\\\"shop_title\\\",\\\"companion\\\",\\\"tape\\\",\\\"bus\\\",\\\"clinic\\\"]),\\\"safehouse\\\"=>labels(&[\\\"sleep\\\",\\\"inventory\\\",\\\"Resupply\\\",\\\"Manual saves\\\",\\\"tape\\\"]),\\\"sleep\\\"=>labels(&[\\\"Dawn · 06:00\\\",\\\"Noon · 12:00\\\",\\\"Dusk · 18:00\\\",\\\"Midnight · 00:00\\\"]),\n \\\"saves\\\"=>(0..6).map(|i|Row::text(format\"'!(\"{} {}\",if i<3{\"Save slot\"}else{\"Load slot\"},i%3+1))).collect(),\n \"shop\"=>{let names:Vec<_>=self.data.weapons.iter().map(|w|w.name.clone()).chain([\"Reliability\",\"Accuracy\",\"Ammo pouch\",\"Syrette bandolier\",\"Vehicle kit\",\"Camo suit\",\"Quinine · 3 pills\",\"Quinine reserve\"].iter().map(|s|s.to_string())).collect();names.iter().enumerate().skip(page).take(6).map(|(i,n)|Row{name:n.clone(),detail:if i<14&&self.owned.contains(&i){\"Licensed · fresh at every locker\".into()}else{format!(\"{} diamonds\",if i<14{[5,5,4,5,8,10,8,8,12,10,12,12,14,12][i]}else{[6,6,6,8,10,5,7,7][i-14]})},value:None}).collect()},\n \"locker\"=>self.owned.iter().skip(page).take(6).map(|i|Row{name:self.data.weapons[*i].name.clone(),detail:\"Fresh crate · New\".into(),value:None}).collect(),\n \"bus\"=>[\"town\",\"junction\",\"bus_mission\"].iter().map(|id|Row::text(self.data.place(id).name.clone())).collect(),\"clinic\"=>labels(&[\"Medicine errand · 3 diamonds\",\"Refill quinine · 5 diamonds\",\"back\"]),\n \"companion\"=>labels(&[\"patch\",\"overdose\"]),\"evacuate\"=>labels(&[\"Save Papa Lazare\",\"Save Mr. Desai\"]),\"tapes\"=>self.tapes.iter().skip(page).take(6).map(|i|Row::text(self.data.tapes[*i].name.clone())).collect(),\"recruit\"=>self.companions.iter().map(|c|Row{name:self.s(&format!(\"dossier_{}\",c.merc)).split('\"'|').next().unwrap_or(\\\"\\\").into(),detail:if \"'!c.alive{\"Empty stool\"}else if c.recruited{\"With you\"}else{\"Available\"}.into(),value:None}).collect(),\n \"settings\"|\"session_settings\"=>{let s=&self.settings;match self.page%4{0=>vec![Row::slider(\"Master\",s.master,0.,1.),Row::slider(\"Music\",s.music,0.,1.),Row::slider(\"Sound effects\",s.sfx,0.,1.),Row::slider(\"Voices\",s.voices,0.,1.)],1=>vec![Row{name:\"Prompt symbols\".into(),detail:if s.xbox{\"Xbox\"}else{\"PlayStation\"}.into(),value:None},Row::toggle(\"Invert Y\",s.invert),Row::slider(\"Stick sensitivity\",s.stick,40.,240.),Row::slider(\"Mouse sensitivity\",s.mouse,0.02,0.4),Row::toggle(\"Aim assist\",s.aim_assist),Row::toggle(\"Toggle crouch\",s.toggle_crouch)],2=>vec![Row::toggle(\"Fullscreen\",s.fullscreen),Row::slider(\"Field of view\",s.fov,55.,100.),Row::slider(\"Brightness\",s.brightness,0.5,1.5),Row::slider(\"Head bob\",s.bob,0.,1.)],_=>vec![Row::slider(\"Subtitle size\",s.subtitles,0.8,1.4),Row::slider(\"Reduce camera motion\",1.-s.motion,0.,1.),Row::toggle(\"Assist markers\",s.markers),Row::toggle(\"Standard HUD\",s.standard)]}},\n \"controls\"|\"about\"=>Vec::new(),\"multiplayer\"=>labels(&[\"solo\",\"invite\"]),\"local_lobby\"=>labels(&[\"create\",\"join\",\"start\"]),\"invite\"=>labels(&[\"Create offer\",\"Create answer\",\"Connect answer\",\"Copy code\",\"back\"]),\n \"dev\"=>labels(&[\"dev_cheats\",\"dev_teleport\",\"dev_story\",\"dev_give\",\"dev_world\",\"dev_balance\"]),\n \"dev_cheats\"=>{let c=&self.cheats;[Row::toggle(\"God mode\",c.god),Row::toggle(\"Infinite ammo\",c.ammo),Row::toggle(\"No jams\",c.jams),Row::toggle(\"No fever\",c.fever),Row::toggle(\"Noclip\",c.noclip),Row::toggle(\"Invisible to AI\",c.invisible),Row::toggle(\"AI state\",c.ai),Row::toggle(\"Fire grid\",c.fire),Row::toggle(\"Navigation\",c.nav),Row::toggle(\"FPS and tick stats\",c.stats)].into_iter().skip(page).take(6).collect()},\n \"dev_teleport\"=>self.data.world.place.iter().skip(page).take(6).map(|p|Row::text(p.name.clone())).collect(),\"dev_story\"=>self.data.contracts.iter().skip(page).take(6).map(|p|Row::text(p.name.clone())).collect(),\n \"dev_give\"=>[\"Rifle squad\",\"Flame trooper\",\"Technical\",\"River boat\",\"Fresh weapon\",\"Rusted weapon\",\"10 diamonds\",\"5 pills\",\"5 syrettes\",\"Kill nearby\"].iter().skip(page).take(6).map(|s|Row::text(*s)).collect(),\n \"dev_world\"=>[Row::slider(\"Time of day\",self.hour,0.,24.),Row::slider(\"Wind speed\",self.wind_speed,0.,12.),Row::slider(\"Wind direction\",self.wind.y.atan2(self.wind.x),-3.14,3.14),Row::text(\"Cycle weather\"),Row::text(\"Ignite at sight\"),Row::text(\"Extinguish all\"),Row::text(\"Regrow the country\"),Row::text(self.s(\"reset\"))].into_iter().skip(page).take(6).collect(),\n \"dev_balance\"=>{let mut tuning=self.tuning.clone();let mut r=crate::params::list(&mut tuning).into_iter().map(|p|{if let crate::params::ParamKind::Float{min,max}=p.kind{Row::slider(&p.help,p.value.as_f64().unwrap_or(0.) as f32,min,max)}else{Row::text(p.help)}}).collect::<Vec<_>>();r.push(Row::text(self.s(\"reset\")));r.into_iter().skip(page).take(6).collect()},_=>Vec::new()}}\n pub fn page_count(&self)->usize{match self.screen.as_str(){\"shop\"=>4,\"locker\"=>self.owned.len().div_ceil(6).max(1),\"tapes\"=>self.tapes.len().div_ceil(6).max(1),\"settings\"|\"session_settings\"=>4,\"about\"=>self.data.about.len(),\"controls\"=>3,\"dev_cheats\"|\"dev_give\"|\"dev_story\"=>2,\"dev_teleport\"=>4,\"dev_world\"=>2,\"dev_balance\"=>4,_=>1}}\n pub fn menu_input(&mut self,sim:&mut Sim,a:u32,events:&mut Vec<SimEvent>){let n=self.rows().len();match a{act::UP=>{if n>0{self.focus=(self.focus+n-1)%n;}self.sound(0);},act::DOWN=>{if n>0{self.focus=(self.focus+1)%n;}self.sound(0);},act::PREV|act::NEXT=>{let pages=self.page_count();self.page=if a==act::NEXT{(self.page+1)%pages}else{(self.page+pages-1)%pages};self.focus=0;self.sound(0);},act::LEFT|act::RIGHT=>{let sign=if a==act::LEFT{-1.}else{1.};if self.screen==\"settings\"||self.screen==\"session_settings\"{self.adjust_setting(sign);}else if self.screen==\"dev_balance\"{let i=self.page*6+self.focus;let mut ps=crate::params::list(&mut sim.config.merc);if let Some(p)=ps.get_mut(i){if let crate::params::ParamKind::Float{min,max}=p.kind{let val=(p.value.as_f64().unwrap() as f32+sign*(max-min)/40.).clamp(min,max);let _=crate::params::set(&mut sim.config.merc,&p.path,crate::params::ParamValue::Float(val as f64));self.tuning=sim.config.merc.clone();}}}else if self.screen==\"dev_world\"{self.adjust_world(sign);}else{self.menu_input(sim,if a==act::LEFT{act::PREV}else{act::NEXT},events);}},act::CONFIRM=>self.select(sim,events),act::BACK=>{let s=match self.screen.as_str(){\"settings\"|\"controls\"|\"about\"=>self.parent.clone(),\"session_settings\"=>\"playing\".into(),\"dev_cheats\"|\"dev_teleport\"|\"dev_story\"|\"dev_give\"|\"dev_world\"|\"dev_balance\"=>\"dev\".into(),\"dev\"=>\"pause\".into(),\"difficulty\"|\"dossier\"|\"multiplayer\"=>\"title\".into(),\"shop\"|\"recruit\"|\"tapes\"|\"clinic\"|\"bus\"=>\"playing\".into(),_=>\"playing\".into()};self.open(&s);},_=>{}}}\n pub fn select(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){let i=self.focus;let page=self.page;let screen=self.screen.clone();self.sound(0);match screen.as_str(){\n \"title\"=>match i{0=>{self.load_slot=0;},1=>self.open(\"difficulty\"),2=>self.open(\"multiplayer\"),3=>{self.parent=\"title\".into();self.open(\"settings\");},4=>{self.parent=\"title\".into();self.open(\"about\");},_=>{}},\n \"difficulty\"=>{self.difficulty=i as u8;sim.config.merc=Tuning::default();match i{0=>{sim.config.merc.enemy_damage=0.65;sim.config.merc.enemy_accuracy=0.18;sim.config.merc.wear=0.7;sim.config.merc.fever_interval=1200.;},2=>{sim.config.merc.enemy_damage=1.4;sim.config.merc.enemy_accuracy=0.4;sim.config.merc.wear=1.4;sim.config.merc.fever_interval=720.;},_=>{}}self.open(\"dossier\");},\"dossier\"=>{self.start(i);self.sync_player(sim);},\n \"pause\"=>match i{0=>self.open(\"playing\"),1=>{self.parent=\"pause\".into();self.open(\"settings\");},2=>{self.parent=\"pause\".into();self.open(\"controls\");},3=>self.open(\"dev\"),4=>self.open(\"quit\"),_=>{}},\"quit\"=>{self.open(if i==0{\"title\"}else{\"playing\"});},\n \"death\"=>{if i==0{self.load_slot=0;}else{self.open(\"title\");}},\"ending\"=>{self.parent=\"ending\".into();self.open(if i==0{\"title\"}else{\"about\"});},\"ending_choice\"=>self.choose_ending((i+1) as u8),\n \"settings\"|\"session_settings\"=>self.adjust_setting(1.),\"contract\"=>{if i==0&&!self.contract_active{self.accept_contract();}else{self.open(\"playing\");}},\n \"town\"=>self.open([\"contract\",\"shop\",\"recruit\",\"tapes\",\"bus\",\"clinic\"][i.min(5)]),\n \"safehouse\"=>match i{0=>self.open(\"sleep\"),1=>self.open(\"locker\"),2=>{for gun in &mut self.guns{gun.reserve=self.data.weapons[gun.def].reserve*if self.upgrades.contains(&0){2}else{1};}self.syrettes=if self.upgrades.contains(&1){5}else{3};self.molotov=4;self.grenades=4;self.note(\"Crates open. The bill arrives later.\");},3=>self.open(\"saves\"),4=>self.open(\"tapes\"),_=>{}},\n \"sleep\"=>{self.hour=[6.,12.,18.,0.][i%4];self.world_hours+=8.;self.health=100.;self.stamina=12.;self.fever_timer=self.tuning.fever_interval;self.wind=glam::Vec2::from_angle(self.world_hours*0.3);self.wind_speed=5.+self.hour.sin().abs()*5.;for c in &mut self.companions{c.rescue=false;}self.flag(\"sleep_used\");self.save_serial+=1;self.open(\"playing\");},\n \"saves\"=>{if i<3{self.save_slot=i as i32+1;self.save_serial+=1;self.note(format!(\"Saved in slot {}.\",i+1));}else{self.load_slot=(i-2) as i32;}},\"shop\"=>self.buy(page*6+i),\"locker\"=>{if let Some(w)=self.owned.iter().nth(page*6+i).copied(){let slot=self.data.weapons[w].slot;self.guns[slot]=Gun::new(w,&self.data.weapons[w],100.);self.active=slot;self.flag(\"locker_used\");self.note(\"Fresh steel. Enjoy the interval.\");}},\n \"bus\"=>{if self.diamonds>=1{self.diamonds-=1;let p=self.data.place([\"town\",\"junction\",\"bus_mission\"][i%3]).pos();self.pos=p+glam::Vec3::new(0.,0.,25.);self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z);self.riding=None;self.hour=(self.hour+2.).rem_euclid(24.);self.world_hours+=2.;self.flag(\"bus_taken\");self.flag(\"diamonds_spent\");self.sync_player(sim);self.open(\"playing\");}else{self.note(self.s(\"no_money\").to_string());}},\n \"clinic\"=>{if i==0{if self.diamonds>=3{self.diamonds-=3;self.pills+=3;self.infamy+=1;self.note(\"Medicine delivered to the annex. Quinine received.\");}}else if i==1&&self.diamonds>=5{self.diamonds-=5;self.pills+=3;}else if i==2{self.open(\"playing\");}},\n \"recruit\"=>{if let Some(c)=self.companions.get_mut(i){if c.alive{c.recruited=true;c.trust+=1;self.say(\"Companion\",self.s(\"recruit\").to_string());}}},\"tapes\"=>{if let Some(t)=self.tapes.iter().nth(page*6+i).copied(){self.playing_tape=Some(t);self.tape_line=0;self.tape_timer=0.;self.flag(\"tape_played\");self.open(\"playing\");}},\n \"companion\"=>{self.open(\"playing\");self.command(sim,if i==0{act::PATCH}else{act::OVERDOSE},events);},\"evacuate\"=>{self.saved_person=i as u8+1;self.goal_flag=true;self.open(\"playing\");self.say(if i==0{\"Papa Lazare\"}else{\"Mr. Desai\"},\"I will remember this. That is not a promise of repayment.\");},\n \"multiplayer\"=>self.open(if i==0{\"local_lobby\"}else{\"invite\"}),\"local_lobby\"|\"invite\"=>{self.net_ui=i as i32+if screen==\"invite\"{10}else{1};},\n \"dev\"=>self.open([\"dev_cheats\",\"dev_teleport\",\"dev_story\",\"dev_give\",\"dev_world\",\"dev_balance\"][i.min(5)]),\n \"dev_cheats\"=>{let c=&mut self.cheats;let v=match page*6+i{0=>&mut c.god,1=>&mut c.ammo,2=>&mut c.jams,3=>&mut c.fever,4=>&mut c.noclip,5=>&mut c.invisible,6=>&mut c.ai,7=>&mut c.fire,8=>&mut c.nav,_=>&mut c.stats};*v=!*v;},\n \"dev_teleport\"=>self.command(sim,act::TELEPORT+(page*6+i) as u32,events),\"dev_story\"=>self.command(sim,act::STORY+(page*6+i) as u32,events),\n \"dev_give\"=>match page*6+i{0=>{for r in 0..5{self.spawn_enemy(sim,self.pos+glam::Vec3::new(12.+r as f32*3.,0.,-20.),r);}},1=>self.spawn_enemy(sim,self.pos+glam::Vec3::new(10.,0.,-15.),4),2|3=>{let mut v=self.vehicles[0].clone();v.pos=self.pos+glam::Vec3::new(6.,0.,0.);v.kind=if i==3{3}else{0};v.hp=100.;v.exploded=false;self.vehicles.push(v);},4=>self.guns[self.active].condition=100.,5=>self.guns[self.active].condition=5.,6=>self.diamonds+=10,7=>self.pills+=5,8=>self.syrettes+=5,_=>{let ids:Vec<_>=self.soldiers.iter().enumerate().filter(|(_,n)|n.hp>0.&&data::distance(n.pos,self.pos)<100.).map(|(i,_)|i).collect();for i in ids{self.hit_soldier(sim,i,1000.,events);}}},\n \"dev_world\"=>match page*6+i{0..=2=>self.adjust_world(1.),3=>{self.weather=(self.weather+1)%3;self.weather_time=90.;},4=>{self.fire.ignite(&self.data,data::flat(self.pos+self.forward()*12.),5.);},5=>{for c in self.fire.cells.values_mut(){c.state=2;c.time=0.;}},6=>self.fire=fire::Fire::default(),_=>{sim.config.merc=Tuning::default();self.tuning=Tuning::default();}},\n \"dev_balance\"=>{if page*6+i>=23{sim.config.merc=Tuning::default();self.tuning=Tuning::default();}else{self.menu_input(sim,act::RIGHT,events);}},_=>{}}\n }\n pub fn adjust_setting(&mut self,sign:f32){let f=self.focus;let s=&mut self.settings;match self.page%4{0=>{let v=match f{0=>&mut s.master,1=>&mut s.music,2=>&mut s.sfx,_=>&mut s.voices};*v=(*v+sign*0.05).clamp(0.,1.);},1=>match f{0=>s.xbox=!s.xbox,1=>s.invert=!s.invert,2=>s.stick=(s.stick+sign*10.).clamp(40.,240.),3=>s.mouse=(s.mouse+sign*0.01).clamp(0.02,0.4),4=>s.aim_assist=!s.aim_assist,_=>s.toggle_crouch=!s.toggle_crouch},2=>match f{0=>s.fullscreen=!s.fullscreen,1=>s.fov=(s.fov+sign*5.).clamp(55.,100.),2=>s.brightness=(s.brightness+sign*0.05).clamp(0.5,1.5),_=>s.bob=(s.bob+sign*0.1).clamp(0.,1.)},_=>match f{0=>s.subtitles=(s.subtitles+sign*0.1).clamp(0.8,1.4),1=>s.motion=(s.motion-sign*0.1).clamp(0.,1.),2=>s.markers=!s.markers,_=>s.standard=!s.standard}}}\n fn adjust_world(&mut self,sign:f32){match self.page*6+self.focus{0=>self.hour=(self.hour+sign).rem_euclid(24.),1=>self.wind_speed=(self.wind_speed+sign).clamp(0.,12.),2=>self.wind=glam::Vec2::from_angle(self.wind.y.atan2(self.wind.x)+sign*0.2),_=>{}}}\n}\nRS'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/merc/net.rs <<'RS'\n//\"'! Transport-neutral, bounded JSON packets. The shell supplies Hub, local tabs, or WebRTC.\nuse serde::{Serialize,Deserialize};\nuse glam::Vec3;\nuse crate::{Sim,SimEvent};\nuse super::*;\n#[derive(Clone,Debug,Serialize,Deserialize)]pub struct Shot{pub origin:Vec3,pub direction:Vec3,pub weapon:usize,pub action:u32}\n#[derive(Clone,Debug,Serialize,Deserialize)]#[serde(tag=\"k\")]pub enum Packet{\n #[serde(rename=\"p\")]Pose{id:u8,p:[i32;3],y:i16,t:i16,h:i16,seat:i16,actions:Vec<Shot>},\n #[serde(rename=\"s\")]Snapshot{tick:u64,n:Vec<[i32;7]>,v:Vec<[i32;7]>,p:Vec<[i32;7]>,score:i32,ledger:i32,lives:i32,time:i32,done:bool,won:bool},\n #[serde(rename=\"f\")]Delta{version:u32,c:Vec<[i32;4]>,objects:Vec<usize>},\n}\nfn quant(v:Vec3)->[i32;3]{[(v.x*100.).round() as i32,(v.y*100.).round() as i32,(v.z*100.).round() as i32]}\nfn unquant(v:[i32;3])->Vec3{Vec3::new(v[0] as f32,v[1] as f32,v[2] as f32)/100.}\nimpl Merc{\n pub fn net_trace(&mut self,a:Vec3,z:Vec3,hit:bool){self.traces.push(Trace{a,z,hit,life:0.16});if self.session&&!self.host{self.net_actions.push(Shot{origin:a,direction:(z-a).normalize_or_zero(),weapon:self.guns[self.active].def,action:0});}}\n pub fn pose_packet(&mut self)->Packet{Packet::Pose{id:self.local_id,p:quant(self.pos),y:self.yaw.to_degrees() as i16,t:self.pitch.to_degrees() as i16,h:self.health as i16,seat:self.riding.map(|i|i as i16).unwrap_or(-1),actions:std::mem::take(&mut self.net_actions)}}\n pub fn snapshot_packet(&self,tick:u64)->Packet{let mut n:Vec<_>=self.soldiers.iter().enumerate().filter(|(_,n)|distance(n.pos,self.pos)<180.||self.peers.iter().any(|p|p.present&&distance(p.pos,n.pos)<180.)).collect();n.sort_by(|a,b|distance(a.1.pos,self.pos).total_cmp(&distance(b.1.pos,self.pos)));let n=n.into_iter().take(8).map(|(i,n)|{let p=quant(n.pos);[i as i32,p[0],p[1],p[2],n.yaw.to_degrees() as i32,n.hp as i32,n.state as i32]}).collect();let v=self.vehicles.iter().enumerate().filter(|(_,v)|distance(v.pos,self.pos)<160.).take(3).map(|(i,v)|{let p=quant(v.pos);[i as i32,p[0],p[1],p[2],v.yaw.to_degrees() as i32,v.hp as i32,v.exploded as i32]}).collect();let mut p:Vec<_>=self.peers.iter().filter(|p|p.present).map(|p|{let q=quant(p.pos);[p.id as i32,q[0],q[1],q[2],p.yaw.to_degrees() as i32,p.hp as i32,p.seat]}).collect();if self.local_id!=255{let q=quant(self.pos);p.push([self.local_id as i32,q[0],q[1],q[2],self.yaw.to_degrees() as i32,self.health as i32,self.riding.map(|i|i as i32).unwrap_or(-1)]);}Packet::Snapshot{tick,n,v,p,score:self.team_score,ledger:self.ledger_carrier,lives:self.team_lives,time:(self.round_time*100.) as i32,done:self.finished,won:self.won}}\n pub fn delta_packet(&self,part:usize)->Packet{let c=self.fire.cells.iter().skip(part*350).take(350).map(|(&(x,z),c)|[x,z,c.state as i32,(c.time*4.) as i32]).collect();Packet::Delta{version:self.fire.version,c,objects:self.objects.iter().enumerate().filter(|(_,o)|o.exploded).map(|(i,_)|i).collect()}}\n pub fn receive(&mut self,sim:&mut Sim,from:u8,packet:Packet,events:&mut Vec<SimEvent>){if self.finished{return;}match packet{\n Packet::Pose{id,p,y,t,h,seat,actions} if self.host&&id==from=>{let pos=unquant(p);if !pos.is_finite(){return;}if let Some(peer)=self.peers.iter_mut().find(|peer|peer.id==id){peer.pos=pos;peer.yaw=(y as f32).to_radians();peer.pitch=(t as f32).to_radians();peer.hp=h as f32;peer.seat=seat as i32;}else{self.peers.push(Peer{id,pos,yaw:(y as f32).to_radians(),pitch:(t as f32).to_radians(),hp:h as f32,down:0.,seat:seat as i32,present:true,kills:0,rescues:0,jams:0});}\n for s in actions.into_iter().take(10){if s.origin.distance(pos)>5.||s.weapon>=self.data.weapons.len(){continue;}let saved=(self.pos,self.yaw,self.pitch,self.active,self.guns.clone(),self.health);self.pos=pos;self.yaw=s.direction.x.atan2(-s.direction.z);self.pitch=s.direction.y.clamp(-1.,1.).asin();let d=&self.data.weapons[s.weapon];self.active=d.slot;self.guns[self.active]=Gun::new(s.weapon,d,100.);if s.action==act::INTERACT{self.interact_goal(sim,events);}else if s.action==act::THROW{self.fire.ignite(&self.data,flat(pos+s.direction*18.),4.);}else{self.shoot(sim,events);}self.pos=saved.0;self.yaw=saved.1;self.pitch=saved.2;self.active=saved.3;self.guns=saved.4;self.health=saved.5;}\n },\n Packet::Snapshot{tick:_,n,v,p,score,ledger,lives,time,done,won} if !self.host=>{for a in n{if let Some(n)=self.soldiers.get_mut(a[0] as usize){n.pos=unquant([a[1],a[2],a[3]]);n.yaw=(a[4] as f32).to_radians();n.hp=a[5] as f32;n.state=a[6] as u8;}}for a in v{if let Some(v)=self.vehicles.get_mut(a[0] as usize){v.pos=unquant([a[1],a[2],a[3]]);v.yaw=(a[4] as f32).to_radians();v.hp=a[5] as f32;v.exploded=a[6]!=0;}}for a in p{let id=a[0] as u8;if id==self.local_id {continue;}let pos=unquant([a[1],a[2],a[3]]);if let Some(peer)=self.peers.iter_mut().find(|p|p.id==id){peer.pos=pos;peer.yaw=(a[4] as f32).to_radians();peer.hp=a[5] as f32;peer.seat=a[6];}else{self.peers.push(Peer{id,pos,yaw:(a[4] as f32).to_radians(),pitch:0.,hp:a[5] as f32,down:0.,seat:a[6],present:true,kills:0,rescues:0,jams:0});}}self.team_score=score;self.ledger_carrier=ledger;self.team_lives=lives;self.round_time=time as f32/100.;self.finished=done;self.won=won;},\n Packet::Delta{version,c,objects} if !self.host=>{for a in c{if a[2]==1||a[2]==2{self.fire.cells.insert((a[0],a[1]),fire::Cell{state:a[2] as u8,time:a[3] as f32/4.});}}self.fire.version=version;for i in objects{if let Some(o)=self.objects.get_mut(i){o.exploded=true;}}},_=>{}}}\n pub fn leave(&mut self,id:u8){if let Some(p)=self.peers.iter_mut().find(|p|p.id==id){p.present=false;}if self.ledger_carrier==id as i32{self.ledger_carrier=-1;}}\n}\nRS\ncat > engine/crates/pav_core/src/games/merc/bot.rs <<'\"'RS'\nuse glam::{Vec2,Vec3};\nuse crate::{InputFrame,Sim,input::buttons as b};\nuse super::{*,act,data::{distance,flat,toward}};\nfn angle_diff(a:f32,b:f32)->f32{(a-b+std::f32::consts::PI).rem_euclid(std::f32::consts::TAU)-std::f32::consts::PI}\nimpl Merc{\n pub fn bot_input(&self,sim:&Sim)->InputFrame{let mut i=InputFrame::default();if self.screen==\\\"title\\\"{i.act=act::START;return i;}if self.screen==\\\"ending_choice\\\"{i.act=act::BURN+(self.seed%3) as u32;return i;}if self.screen==\\\"contract\\\"{i.act=act::CONFIRM;return i;}if self.screen==\\\"death\\\"{return i;}if self.screen==\\\"shop\\\"{i.act=act::BUY+2;return i;}if self.screen==\\\"companion\\\"{i.act=if self.seed%3==0{act::PATCH}else{act::OVERDOSE};return i;}if self.screen==\\\"evacuate\\\"{i.act=act::CONFIRM;return i;}if self.screen\"'!=\"playing\"&&self.screen!=\"ending_defend\"{i.act=act::BACK;return i;}\n if self.action.is_some(){return i;}if self.health<35.&&self.rescue_time<=0.{i.act=act::HEAL;return i;}if self.fever_state>0&&self.pills>0 {i.act=act::PILL;return i;}if self.rescue_time>0.{return i;}\n if self.guns[self.active].jammed||self.guns[self.active].ammo==0&&self.guns[self.active].reserve>0{i.act=act::RELOAD;return i;}\n if self.guns[self.active].broken||self.guns[self.active].ammo==0&&self.guns[self.active].reserve==0{i.act=act::NEXT_GUN;return i;}\n let enemy=self.soldiers.iter().enumerate().filter(|(_,n)|n.hp>0.&&distance(n.pos,self.pos)<75.).filter(|(_,n)|!crate::projectile::static_blocked(&sim.state.physics,self.eye_pos(),(n.pos+Vec3::Y*1.56-self.eye_pos()).normalize_or_zero(),(n.pos+Vec3::Y*1.56-self.eye_pos()).length(),None)).min_by(|a,b|distance(a.1.pos,self.pos).total_cmp(&distance(b.1.pos,self.pos)));\n if let Some((_,n))=enemy{if !self.safe_town(){if self.riding.is_some(){i.act=act::INTERACT;return i;}if self.map_up{i.act=act::MAP;return i;}let d=(n.pos+Vec3::Y*1.55-self.eye_pos()).normalize();i.look=Vec2::new(angle_diff(d.x.atan2(-d.z),self.yaw),self.pitch-d.y.asin());i.held=b::SECONDARY|b::PRIMARY;if self.monocular{i.act=act::MONOCULAR;}if self.guns[self.active].def==11||self.guns[self.active].def==12{ i.act=act::NEXT_GUN;}return i;}}\n let goal=self.current_goal();if self.ending==2 {i.move_dir=Vec2::new((self.time*0.8).sin(),(self.time*0.8).cos())*0.4;return i;}if self.ending>0{return i;}let Some(goal)=goal else{return i;};let mut target=self.data.place(&goal.place).pos();let dist=distance(target,self.pos);\n if goal.kind==\"pills\"{if !self.coverage.contains(\"map_raised\"){i.act=act::MAP;return i;}i.act=act::PILL;return i;}\n if goal.kind==\"claim\"&&dist<26.{i.act=act::INTERACT;return i;}\n if goal.kind==\"shop\"&&dist<70.{i.act=act::BUY+2;return i;}\n if goal.kind==\"night\"{if dist<25.{i.act=act::INTERACT;return i;}}\n if goal.kind==\"tag\"{if let Some(n)=self.soldiers.iter().find(|n|n.target&&n.hp>0.){if distance(n.pos,self.pos)<180.{let d=(n.pos+Vec3::Y*1.4-self.eye_pos()).normalize();i.look=Vec2::new(angle_diff(d.x.atan2(-d.z),self.yaw),self.pitch-d.y.asin());if !self.monocular{i.act=act::MONOCULAR;}return i;}}}\n if goal.kind==\"tanks\" {if let Some(o)=self.objects.iter().find(|o|o.place==goal.place&&o.kind==1&&!o.exploded){target=o.pos;if distance(target,self.pos)<60.{if self.riding.is_some(){i.act=act::INTERACT;return i;}if self.map_up{i.act=act::MAP;return i;}let d=(target+Vec3::Y*1.5-self.eye_pos()).normalize();i.look=Vec2::new(angle_diff(d.x.atan2(-d.z),self.yaw),self.pitch-d.y.asin());i.held=b::PRIMARY|b::SECONDARY;if self.active!=2{i.act=act::NEXT_GUN;}return i;}}}\n if goal.kind==\"companion\"{if let Some(c)=self.companions.iter().find(|c|c.alive&&c.down>0.){target=c.pos;if distance(target,self.pos)<5.{i.act=if self.seed%3==0{act::PATCH}else{act::OVERDOSE};return i;}}}\n if [\"sabotage\",\"cargo\",\"deliver\",\"convoy\",\"manifest\",\"evacuate\",\"ledger\"].contains(&goal.kind.as_str())&&dist<25.{if self.riding.is_some(){i.act=act::INTERACT;return i;}i.act=act::INTERACT;return i;}\n if self.screen==\"safehouse\"&&goal.kind==\"night\"{i.act=act::SELECT;return i;}\n let rz=terrain::river_z(&self.data,self.pos.x);let target_rz=terrain::river_z(&self.data,target.x);if (self.pos.z-rz).signum()!=(target.z-target_rz).signum() {let before=Vec3::new(40.,0.,if self.pos.z>rz{145.}else{-45.});let after=Vec3::new(40.,0.,if self.pos.z>rz{-45.}else{145.});if distance(self.pos,before)>12.&&(self.pos.x-40.).abs()>6.{target=before;}else{target=after;}}\n let dir=toward(self.pos,target);if let Some(vi)=self.riding {let v=&self.vehicles[vi];let err=angle_diff(dir.x.atan2(-dir.y),v.yaw);i.move_dir=Vec2::new((err*2.).clamp(-1.,1.),0.);i.axes=Vec2::new(if err.abs()>1.{0.25}else{1.},0.);if distance(self.pos,target)<18.{i.act=act::INTERACT;}return i;}\n i.move_dir=dir;i.held=b::SPRINT;let desired=dir.x.atan2(-dir.y);i.look=Vec2::new(angle_diff(desired,self.yaw),self.pitch);if self.map_up&&self.coverage.contains(\"map_raised\"){i.act=act::MAP;}if self.time<2.&&!self.map_up{i.act=act::MAP;}i\n }\n}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/src/games/merc/mod.rs');s=p.read_text().replace('pub round_started:bool,','pub round_started:bool,').replace('pub session:bool,pub host:bool,','pub traces:Vec<Trace>,pub net_actions:Vec<net::Shot>,pub net_ui:i32,pub session:bool,pub host:bool,');s=s.replace('session:false,host:true,','traces:Vec::new(),net_actions:Vec::new(),net_ui:0,session:false,host:true,');s=s.replace('RegionKey::Terrain','RegionKey::Chunk');s=s.replace('self.view_time+=dt;','self.view_time+=dt;for t in &mut self.traces{t.life-=dt;}self.traces.retain(|t|t.life>0.);',1);p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/data.rs');s=p.read_text().replace('#[derive(Clone, Debug)]\\\\npub struct Data','#[derive(Clone, Debug, Serialize, Deserialize)] pub struct AboutPage {pub title:String,pub lines:Vec<String>}\\\\n#[derive(Clone, Debug)]\\\\npub struct Data');s=s.replace('pub attract:Vec<Segment>}','pub attract:Vec<Segment>,pub about:Vec<AboutPage>}');s=s.replace('#[derive(Deserialize)]struct A','#[derive(Deserialize)]struct P{page:Vec<AboutPage>}\\\\n #[derive(Deserialize)]struct A');s=s.replace('expect(\\\"attract\\\").segment})','expect(\\\"attract\\\").segment,about:toml::from_str::<P>(&read\"'!(\"about.toml\")).expect(\"about\").page})'\"');p.write_text(s)\nPath('engine/game/merc/about.toml').write_text('[[page]]\\\\ntitle = \\\"Source Information\\\"\\\\nlines = [\\\"Source: Far Cry 2\\\", \\\"Plan: PLAN.md\\\", \\\"Usage: added on import\\\"]\\\\n')\np=Path('engine/crates/pav_core/src/games/merc/fire.rs');s=p.read_text().replace('pub cells:BTreeMap','#[serde(with=\\\"cells_json\\\")]pub cells:BTreeMap').replace('pub cut:BTreeMap','#[serde(with=\\\"cuts_json\\\")]pub cut:BTreeMap');s+='''\\\\nmod cells_json{use super::*;pub fn serialize<S:serde::Serializer>(v:&BTreeMap<(i32,i32),Cell>,s:S)->Result<S::Ok,S::Error>{v.iter().collect::<Vec<_>>().serialize(s)}pub fn deserialize<'de,D:serde::Deserializer<'de>>(d:D)->Result<BTreeMap<(i32,i32),Cell>,D::Error>{Ok(Vec::<((i32,i32),Cell)>::deserialize(d)?.into_iter().collect())}}\\\\nmod cuts_json{use super::*;pub fn serialize<S:serde::Serializer>(v:&BTreeMap<(i32,i32),f32>,s:S)->Result<S::Ok,S::Error>{v.iter().collect::<Vec<_>>().serialize(s)}pub fn deserialize<'de,D:serde::Deserializer<'de>>(d:D)->Result<BTreeMap<(i32,i32),f32>,D::Error>{Ok(Vec::<((i32,i32),f32)>::deserialize(d)?.into_iter().collect())}}\\\\n''';p.write_text(s)\nPY\nCARGO_BUILD_JOBS=10 cargo check --manifest-path engine/Cargo.toml -p pav_core > notes/check-core.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
