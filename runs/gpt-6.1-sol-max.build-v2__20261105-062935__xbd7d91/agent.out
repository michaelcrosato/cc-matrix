{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"sed -n '22,45p' engine/crates/pav_core/src/props/compile.rs && sed -n '79,111p' engine/crates/pav_core/src/puppet.rs && head -45 engine/crates/pav_core/src/shape.rs && sed -n '150,185p' engine/crates/pav_ui/src/headless.rs && rg -n '\\\\.frame\\\\(' engine/crates/pav_tools/src/render_tools.rs | head -12\"","aggregated_output":"/// Parts after copies, mirrors and references.\npub const MAX_PARTS: usize = 1_024;\n/// Distinct generated meshes per asset.\npub const MAX_MESHES: usize = 64;\n/// Shapes in one prop's physics compound.\npub const MAX_COLLIDERS: usize = 256;\n/// References inside references.\npub const MAX_REF_DEPTH: u8 = 3;\n/// Spheres and capsules (signed distance fields) before `sdf_heavy`.\nconst SDF_HEAVY: usize = 64;\n/// Parts this close count as touching (`floating`).\nconst JOIN: f32 = 0.005;\n\n/// Theme colour roles when no palette is given: neutral stone and a warm light.\npub const DEFAULT_ROLES: &[(&str, &str)] = &[\n    (\"$floor\", \"#7a7268\"),\n    (\"$floor2\", \"#6f675e\"),\n    (\"$wall\", \"#9a948a\"),\n    (\"$pillar\", \"#a89f92\"),\n    (\"$accent\", \"#c8a24a\"),\n    (\"$light\", \"#ffc870\"),\n];\n\n/// A prop's resolved parts and what they carry, in metres in the asset's frame.\nchoice_enum! {\n    /// Helmet shapes (Shardfall armour).\n    #[derive(Default)]\n    pub enum HelmKind {\n        #[default]\n        None => \"none\",\n        Cap => \"cap\",\n        Helm => \"helm\",\n        Great => \"great\",\n        Crown => \"crown\",\n        Horned => \"horned\",\n        Halo => \"halo\",\n        /// A cloth hood with a drape down the back (townsfolk).\n        Hood => \"hood\",\n    }\n}\n\n/// Worn armour's look: helmet, shoulder plates, cape, gloves, belt buckle.\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct GearLook {\n    pub helm: HelmKind,\n    pub helm_color: String,\n    /// Shoulder plates (0 = none, 1 = full size) and their colour.\n    pub pauldrons: f32,\n    pub armor_color: String,\n    /// Cape (0 = none) and its colour.\n    pub cape: f32,\n    pub cape_color: String,\n    /// Glove and belt colours (\"\" = none).\n    pub gloves: String,\n    pub belt: String,\n    /// Enchanted shine on the helmet.\n//! Shapes shared by physics colliders and visuals, and the visual description of objects.\n\nuse glam::Vec3;\nuse rapier::prelude::*;\nuse serde::{Deserialize, Serialize};\n\nuse crate::choice_enum;\nuse crate::color::Color;\n\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(tag = \"type\", rename_all = \"snake_case\")]\npub enum Shape {\n    Box {\n        half: Vec3,\n    },\n    RoundedBox {\n        half: Vec3,\n        radius: f32,\n    },\n    Sphere {\n        radius: f32,\n    },\n    /// Along local Y; total height = 2 * (half_height + radius).\n    Capsule {\n        half_height: f32,\n        radius: f32,\n    },\n    Cylinder {\n        half_height: f32,\n        radius: f32,\n    },\n}\n\nimpl Shape {\n    pub fn collider(&self) -> ColliderBuilder {\n        match *self {\n            Shape::Box { half } => ColliderBuilder::cuboid(half.x as Real, half.y as Real, half.z as Real),\n            Shape::RoundedBox { half, radius } => {\n                let r = radius.min(half.min_element() * 0.99);\n                ColliderBuilder::round_cuboid((half.x - r) as Real, (half.y - r) as Real, (half.z - r) as Real, r as Real)\n            }\n            Shape::Sphere { radius } => ColliderBuilder::ball(radius as Real),\n            Shape::Capsule { half_height, radius } => ColliderBuilder::capsule_y(half_height as Real, radius as Real),\n            Shape::Cylinder { half_height, radius } => ColliderBuilder::cylinder(half_height as Real, radius as Real),\n        }\n                    events.push(egui::Event::PointerButton {\n                        pos: p,\n                        button: egui::PointerButton::Primary,\n                        pressed,\n                        modifiers: Default::default(),\n                    });\n                }\n            }\n            let raw = egui::RawInput {\n                screen_rect: Some(screen),\n                time: Some(pass as f64 / 60.0),\n                predicted_dt: 1.0 / 60.0,\n                events,\n                ..Default::default()\n            };\n            self.touch.swipes.begin_frame();\n            let last = pass + 1 == PASSES + input.click.is_some() as usize;\n            let out = ctx.run_ui(raw, |ui| {\n                let root = ui.layer_id();\n                let ctx = ui.ctx().clone();\n                if let Some(g) = game {\n                    let proj = Projector { vp, size: screen.size() };\n                    hud(&ctx, g, &proj, self.device, self.game.map, &mut self.touch.swipes);\n                    let given = self.game.ui(&ctx, g, &proj);\n                    if pass == PASSES {\n                        commands = given;\n                    }\n                }\n                crate::game_lines(&ctx, hud_lines);\n                if touch && game.is_some() {\n                    let map_hidden = self.touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n                    let points = game.and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n                    let covered = self.game.any_open();\n                    self.touch.draw(&ctx, &View { game, auto_attack: true, map_hidden, points, covered });\n                }\n                if last {\nrg: engine/crates/pav_tools/src/render_tools.rs: IO error for operation on engine/crates/pav_tools/src/render_tools.rs: No such file or directory (os error 2)\n","exit_code":0,"status":"completed"}}
