{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' crates/pav_app/src/uiinput.rs && sed -n '1,120p' crates/pav_render/src/mesh.rs && sed -n '1,180p' crates/pav_view/src/assets.rs && sed -n '1,130p' crates/pav_core/src/params.rs && sed -n '44,110p' crates/pav_core/src/sim.rs && sed -n '2120,2220p' crates/pav_app/src/app.rs && sed -n '300,415p' crates/pav_app/src/app.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' crates/pav_app/src/uiinput.rs && sed -n '1,120p' crates/pav_render/src/mesh.rs && sed -n '1,180p' crates/pav_view/src/assets.rs && sed -n '1,130p' crates/pav_core/src/params.rs && sed -n '44,110p' crates/pav_core/src/sim.rs && sed -n '2120,2220p' crates/pav_app/src/app.rs && sed -n '300,415p' crates/pav_app/src/app.rs\"","aggregated_output":"//! Window events -> egui input. Natively this is egui-winit; in the browser (where egui-winit\n//! does not build) a small adapter covers what the panels use: pointer, wheel, keys and text.\n\nuse winit::event::WindowEvent;\nuse winit::window::Window;\n\n#[cfg(not(target_arch = \"wasm32\"))]\npub struct UiInput(egui_winit::State);\n\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl UiInput {\n    pub fn new(ctx: &egui::Context, window: &Window, max_texture: usize) -> Self {\n        Self(egui_winit::State::new(\n            ctx.clone(),\n            egui::ViewportId::ROOT,\n            window,\n            Some(window.scale_factor() as f32),\n            None,\n            Some(max_texture),\n        ))\n    }\n\n    /// Feeds an event to egui; true when egui used it (the game should ignore it).\n    pub fn on_window_event(&mut self, window: &Window, event: &WindowEvent) -> bool {\n        self.0.on_window_event(window, event).consumed\n    }\n\n    pub fn take(&mut self, window: &Window) -> egui::RawInput {\n        self.0.take_egui_input(window)\n    }\n\n    pub fn platform_output(&mut self, window: &Window, out: egui::PlatformOutput) {\n        self.0.handle_platform_output(window, out);\n    }\n}\n\n#[cfg(target_arch = \"wasm32\")]\npub struct UiInput {\n    ctx: egui::Context,\n    raw: egui::RawInput,\n    pointer: egui::Pos2,\n    modifiers: egui::Modifiers,\n    start: web_time::Instant,\n    max_texture: usize,\n    cursor: egui::CursorIcon,\n    /// The finger that is egui's pointer (the first one down).\n    touch_pointer: Option<u64>,\n}\n\n#[cfg(target_arch = \"wasm32\")]\nimpl UiInput {\n    pub fn new(ctx: &egui::Context, _window: &Window, max_texture: usize) -> Self {\n        Self {\n            ctx: ctx.clone(),\n            raw: egui::RawInput::default(),\n            pointer: egui::Pos2::ZERO,\n            modifiers: egui::Modifiers::default(),\n            start: web_time::Instant::now(),\n            max_texture,\n            cursor: egui::CursorIcon::Default,\n            touch_pointer: None,\n        }\n    }\n\n    fn ppp(&self, window: &Window) -> f32 {\n        self.ctx.zoom_factor() * window.scale_factor() as f32\n    }\n\n    pub fn on_window_event(&mut self, window: &Window, event: &WindowEvent) -> bool {\n        use egui::Event;\n        use winit::event::{MouseButton, MouseScrollDelta};\n        let ppp = self.ppp(window);\n        let over_ui = |c: &egui::Context| c.egui_wants_pointer_input() || c.is_pointer_over_egui();\n        let ev = &mut self.raw.events;\n        match event {\n            WindowEvent::CursorMoved { position, .. } => {\n                self.pointer = egui::pos2(position.x as f32 / ppp, position.y as f32 / ppp);\n                ev.push(Event::PointerMoved(self.pointer));\n                over_ui(&self.ctx)\n            }\n            WindowEvent::CursorLeft { .. } => {\n                ev.push(Event::PointerGone);\n                false\n            }\n            WindowEvent::MouseInput { state, button, .. } => {\n                let button = match button {\n                    MouseButton::Left => egui::PointerButton::Primary,\n                    MouseButton::Right => egui::PointerButton::Secondary,\n                    MouseButton::Middle => egui::PointerButton::Middle,\n                    MouseButton::Back => egui::PointerButton::Extra1,\n                    MouseButton::Forward => egui::PointerButton::Extra2,\n                    MouseButton::Other(_) => return false,\n                };\n                ev.push(Event::PointerButton {\n                    pos: self.pointer,\n                    button,\n                    pressed: state.is_pressed(),\n                    modifiers: self.modifiers,\n                });\n                over_ui(&self.ctx)\n            }\n            WindowEvent::MouseWheel { delta, .. } => {\n                let (unit, delta) = match delta {\n                    MouseScrollDelta::LineDelta(x, y) => (egui::MouseWheelUnit::Line, egui::vec2(*x, *y)),\n                    MouseScrollDelta::PixelDelta(p) => (egui::MouseWheelUnit::Point, egui::vec2(p.x as f32, p.y as f32) / ppp),\n                };\n                ev.push(Event::MouseWheel { unit, delta, phase: egui::TouchPhase::Move, modifiers: self.modifiers });\n                over_ui(&self.ctx)\n            }\n            WindowEvent::ModifiersChanged(m) => {\n                let s = m.state();\n                self.modifiers = egui::Modifiers {\n                    alt: s.alt_key(),\n                    ctrl: s.control_key(),\n                    shift: s.shift_key(),\n                    mac_cmd: false,\n                    command: s.control_key(),\n                };\n                false\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                use winit::keyboard::Key as K;\n                let pressed = event.state.is_pressed();\n                let key = match &event.logical_key {\n                    K::Named(n) => egui::Key::from_name(&format!(\"{n:?}\")),\n                    K::Character(c) => egui::Key::from_name(c.as_str()),\n                    _ => None,\n                };\n                if let Some(key) = key {\n                    ev.push(Event::Key { key, physical_key: None, pressed, repeat: event.repeat, modifiers: self.modifiers });\n                }\n                if pressed && !self.modifiers.ctrl {\n                    if let Some(t) = &event.text {\n                        let t: String = t.chars().filter(|c| !c.is_control()).collect();\n                        if !t.is_empty() {\n                            ev.push(Event::Text(t));\n                        }\n                    }\n                }\n                self.ctx.egui_wants_keyboard_input()\n            }\n            WindowEvent::Touch(t) => {\n                // Like egui-winit: every finger as a touch (pinches), the first also as the pointer.\n                use winit::event::TouchPhase as P;\n                let pos = egui::pos2(t.location.x as f32 / ppp, t.location.y as f32 / ppp);\n                let phase = match t.phase {\n                    P::Started => egui::TouchPhase::Start,\n                    P::Moved => egui::TouchPhase::Move,\n                    P::Ended => egui::TouchPhase::End,\n                    P::Cancelled => egui::TouchPhase::Cancel,\n                };\n                ev.push(Event::Touch {\n                    device_id: egui::TouchDeviceId(0),\n                    id: egui::TouchId::from(t.id),\n                    phase,\n                    pos,\n                    force: None,\n                });\n                if self.touch_pointer.is_none_or(|id| id == t.id) {\n                    let button = |pressed| Event::PointerButton {\n                        pos,\n                        button: egui::PointerButton::Primary,\n                        pressed,\n                        modifiers: egui::Modifiers::default(),\n                    };\n                    match t.phase {\n                        P::Started => {\n                            self.touch_pointer = Some(t.id);\n                            self.pointer = pos;\n                            ev.push(Event::PointerMoved(pos));\n                            ev.push(button(true));\n                        }\n                        P::Moved => {\n                            self.pointer = pos;\n                            ev.push(Event::PointerMoved(pos));\n                        }\n                        P::Ended => {\n                            self.touch_pointer = None;\n                            ev.push(button(false));\n                            ev.push(Event::PointerGone);\n                        }\n                        P::Cancelled => {\n                            self.touch_pointer = None;\n                            ev.push(Event::PointerGone);\n                        }\n                    }\n                }\n                true\n            }\n            WindowEvent::Focused(f) => {\n                ev.push(Event::WindowFocused(*f));\n                self.raw.focused = *f;\n                false\n            }\n            _ => false,\n        }\n    }\n\n    pub fn take(&mut self, window: &Window) -> egui::RawInput {\n        let ppp = self.ppp(window);\n        let size = window.inner_size();\n        let points = egui::vec2(size.width as f32, size.height as f32) / ppp;\n        self.raw.time = Some(self.start.elapsed().as_secs_f64());\n        self.raw.screen_rect = (points.x > 0.0 && points.y > 0.0).then(|| egui::Rect::from_min_size(egui::Pos2::ZERO, points));\n        self.raw.viewport_id = egui::ViewportId::ROOT;\n        self.raw.viewports.entry(egui::ViewportId::ROOT).or_default().native_pixels_per_point =\n            Some(window.scale_factor() as f32);\n        self.raw.max_texture_side = Some(self.max_texture);\n        self.raw.take()\n    }\n\n    pub fn platform_output(&mut self, window: &Window, out: egui::PlatformOutput) {\n        use egui::CursorIcon as E;\n        use winit::window::CursorIcon as W;\n        if out.cursor_icon != self.cursor {\n            self.cursor = out.cursor_icon;\n            window.set_cursor(match out.cursor_icon {\n                E::PointingHand => W::Pointer,\n                E::Text => W::Text,\n                E::Grab => W::Grab,\n                E::Grabbing => W::Grabbing,\n                E::ResizeHorizontal | E::ResizeColumn => W::EwResize,\n                E::ResizeVertical | E::ResizeRow => W::NsResize,\n                E::NotAllowed => W::NotAllowed,\n                _ => W::Default,\n            });\n        }\n    }\n}\n//! Procedural mesh generation. Every built-in mesh fits the unit cube [-0.5, 0.5]^3\n//! so an instance's scale equals its size. Winding is counter-clockwise when seen from outside.\n\nuse bytemuck::{Pod, Zeroable};\nuse glam::Vec3;\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default, Pod, Zeroable)]\npub struct Vertex {\n    pub pos: [f32; 3],\n    pub normal: [f32; 3],\n    pub uv: [f32; 2],\n    /// Multiplied with the instance colour (white for built-in meshes).\n    pub color: [f32; 4],\n}\n\n#[derive(Clone, Debug, Default)]\npub struct MeshData {\n    pub vertices: Vec<Vertex>,\n    pub indices: Vec<u32>,\n}\n\n/// Identifies a mesh. Built-ins and rounded boxes are generated on demand by the renderer;\n/// `Custom` meshes must be uploaded with `Renderer::upsert_mesh` first.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]\npub enum MeshKey {\n    Cube,\n    Sphere,\n    Cylinder,\n    Cone,\n    Plane,\n    /// A tuft of grass: seven tapered, curving blades in the unit box (two-sided).\n    Tuft,\n    /// Rounded box with absolute half extents and corner radius, in millimetres.\n    RoundedBox {\n        half_mm: [u32; 3],\n        radius_mm: u32,\n    },\n    Custom(u64),\n}\n\nimpl MeshKey {\n    pub fn rounded_box(half: Vec3, radius: f32) -> Self {\n        let mm = |v: f32| (v.max(0.0) * 1000.0).round() as u32;\n        MeshKey::RoundedBox { half_mm: [mm(half.x), mm(half.y), mm(half.z)], radius_mm: mm(radius) }\n    }\n\n    pub fn generate(&self) -> Option<MeshData> {\n        Some(match *self {\n            MeshKey::Cube => MeshData::cube(),\n            MeshKey::Sphere => MeshData::sphere(32, 16),\n            MeshKey::Cylinder => MeshData::cylinder(32),\n            MeshKey::Cone => MeshData::cone(32),\n            MeshKey::Plane => MeshData::plane(),\n            MeshKey::Tuft => MeshData::tuft(),\n            MeshKey::RoundedBox { half_mm, radius_mm } => {\n                let h = Vec3::new(half_mm[0] as f32, half_mm[1] as f32, half_mm[2] as f32) / 1000.0;\n                MeshData::rounded_box(h, radius_mm as f32 / 1000.0, 4)\n            }\n            MeshKey::Custom(_) => return None,\n        })\n    }\n}\n\n/// Tangent frame (u, v) for a face with normal n, such that cross(u, v) == n.\nfn face_frame(n: Vec3) -> (Vec3, Vec3) {\n    let v = if n.y.abs() > 0.5 { Vec3::Z * n.y.signum() } else { Vec3::Y };\n    let u = v.cross(n);\n    (u, v)\n}\n\nconst FACES: [Vec3; 6] = [Vec3::X, Vec3::NEG_X, Vec3::Y, Vec3::NEG_Y, Vec3::Z, Vec3::NEG_Z];\n\nimpl MeshData {\n    fn push(&mut self, pos: Vec3, normal: Vec3, uv: [f32; 2]) -> u32 {\n        self.vertices.push(Vertex { pos: pos.to_array(), normal: normal.to_array(), uv, color: [1.0; 4] });\n        (self.vertices.len() - 1) as u32\n    }\n\n    /// Adds a quad; corners must be counter-clockwise seen from the side `normal` points to.\n    pub fn push_quad(&mut self, p: [Vec3; 4], normal: Vec3) {\n        let uvs = [[0.0, 1.0], [1.0, 1.0], [1.0, 0.0], [0.0, 0.0]];\n        let i0 = self.push(p[0], normal, uvs[0]);\n        for k in 1..4 {\n            self.push(p[k], normal, uvs[k]);\n        }\n        self.indices.extend_from_slice(&[i0, i0 + 1, i0 + 2, i0, i0 + 2, i0 + 3]);\n    }\n\n    pub fn cube() -> Self {\n        let mut m = MeshData::default();\n        for n in FACES {\n            let (u, v) = face_frame(n);\n            let c = n * 0.5;\n            m.push_quad([c - u * 0.5 - v * 0.5, c + u * 0.5 - v * 0.5, c + u * 0.5 + v * 0.5, c - u * 0.5 + v * 0.5], n);\n        }\n        m\n    }\n\n    /// Unit plane in XZ facing +Y.\n    pub fn plane() -> Self {\n        let mut m = MeshData::default();\n        let (u, v) = face_frame(Vec3::Y);\n        m.push_quad([-u * 0.5 - v * 0.5, u * 0.5 - v * 0.5, u * 0.5 + v * 0.5, -u * 0.5 + v * 0.5], Vec3::Y);\n        m\n    }\n\n    pub fn sphere(segments: u32, rings: u32) -> Self {\n        let mut m = MeshData::default();\n        for i in 0..=rings {\n            let theta = std::f32::consts::PI * i as f32 / rings as f32;\n            for j in 0..=segments {\n                let phi = std::f32::consts::TAU * j as f32 / segments as f32;\n                let n = Vec3::new(theta.sin() * phi.cos(), theta.cos(), theta.sin() * phi.sin());\n                m.push(n * 0.5, n, [j as f32 / segments as f32, i as f32 / rings as f32]);\n            }\n        }\n        let row = segments + 1;\n        for i in 0..rings {\n            for j in 0..segments {\n//! Library assets drawn from game code. A game that keeps its own state (units, shots, scenery\n//! it moves itself) draws an asset each frame with one call, `emit_asset`, the way the view\n//! draws placed props: the same parts, generated meshes, glow and lights.\n//!\n//! ```ignore\n//! // In the game's view, while building the frame's scene (as `arpg.rs` draws Shardfall):\n//! for unit in &game.units {\n//!     let at = Placement::at(unit.pos).yaw(unit.heading).id(unit.id);\n//!     pav_view::assets::emit_asset(scene, \"BUILTIN/crate\", at, unit.id % 8, &palette)?;\n//! }\n//! ```\n\nuse std::cell::RefCell;\nuse std::collections::BTreeMap;\nuse std::sync::{Arc, Mutex};\n\nuse glam::{Quat, Vec3};\nuse pav_core::fxdef::LightDef;\nuse pav_core::prop_instance::{validate_roles, validate_scale};\nuse pav_core::shape::Visual;\nuse pav_core::{Color, EntityId, RenderObject, Shape, props};\nuse pav_render::Scene;\nuse pav_render::scene::MeshKey;\n\nuse pav_core::material::Library;\n\nuse crate::build::{GeneratedMeshes, StyleOverride, Surfaces, emit_prim, part_color, role_hex};\nuse crate::materials::{self, MaterialTable};\n\n/// Colours for the theme roles an asset's parts name (`\"$wall\"` → `\"#5a6b7c\"`). Roles left out\n/// take `props::DEFAULT_ROLES`; an empty palette draws the asset as authored.\npub type Palette = BTreeMap<String, String>;\n\n/// Where an asset is drawn: its origin (the floor under it, as authored) in the world, its\n/// turn, a uniform scale, and the id of the thing it draws.\n#[derive(Clone, Copy, Debug, PartialEq)]\npub struct Placement {\n    pub pos: Vec3,\n    pub rot: Quat,\n    pub scale: f32,\n    /// The thing's id: its outline group (`id + 2`, as an entity's) and its lights' flicker\n    /// phase. Give each unit its own, so outlines separate units that overlap.\n    pub id: u32,\n}\n\nimpl Placement {\n    /// At `pos`, unturned, full size, id 0.\n    pub fn at(pos: Vec3) -> Self {\n        Self { pos, rot: Quat::IDENTITY, scale: 1.0, id: 0 }\n    }\n\n    /// Turned `degrees` about +y: +yaw turns the asset's front (+z) toward +x, as room objects.\n    pub fn yaw(self, degrees: f32) -> Self {\n        Self { rot: Quat::from_rotation_y(degrees.to_radians()), ..self }\n    }\n\n    pub fn rot(self, rot: Quat) -> Self {\n        Self { rot, ..self }\n    }\n\n    pub fn scale(self, scale: f32) -> Self {\n        Self { scale, ..self }\n    }\n\n    pub fn id(self, id: u32) -> Self {\n        Self { id, ..self }\n    }\n}\n\n/// The frame the view is building: its whole-scene style and its material table. Drawn assets\n/// take both, as placed copies do.\n#[derive(Clone)]\nstruct Frame {\n    style: StyleOverride,\n    materials: Arc<Mutex<MaterialTable>>,\n}\n\nthread_local! {\n    static FRAME: RefCell<Option<Frame>> = const { RefCell::new(None) };\n}\n\n/// Sets the frame `emit_asset` draws into until it drops (the view, while it builds a frame).\npub(crate) struct FrameScope(Option<Frame>);\n\nimpl FrameScope {\n    pub(crate) fn new(style: StyleOverride, materials: Arc<Mutex<MaterialTable>>) -> Self {\n        Self(FRAME.replace(Some(Frame { style, materials })))\n    }\n}\n\nimpl Drop for FrameScope {\n    fn drop(&mut self) {\n        FRAME.set(self.0.take());\n    }\n}\n\n/// Generated meshes kept across calls and frames (they depend only on the shape).\nstatic MESHES: Mutex<Option<GeneratedMeshes>> = Mutex::new(None);\n/// Meshes kept before the cache starts over.\nconst KEEP: usize = 1024;\n\n/// Draws the asset `name` (`LIB/core/barrel`, `BUILTIN/crate`, `WORKSHOP/tank`; a family's\n/// preset as `LIB/core/fence:low`) into `scene`\n/// for this frame at `at`: its parts, their glow and its lights, as a placed copy draws them.\n/// `seed` picks the variant (`chance`, `jitter`, `pick`; 0 as authored; each asset keeps 64\n/// seeds compiled, so use a few, e.g. `id % 8`). `palette` colours its `$roles`. Particles\n/// (`fx`) need a placed prop. Call it while the view builds the frame's scene, so filters aimed\n/// at objects and a whole-scene style reach it. Errors: an unknown name (with the nearest one), a bad scale, position\n/// or palette.\npub fn emit_asset(scene: &mut Scene, name: &str, at: Placement, seed: u32, palette: &Palette) -> Result<(), String> {\n    let (asset, def, params) = props::resolve_placed(name, &props::Params::new())?;\n    validate_scale(at.scale)?;\n    if !at.pos.is_finite() || !at.rot.is_finite() || at.rot.length_squared() < 1e-6 {\n        return Err(format!(\"{name}: placement needs a finite pos and rotation\"));\n    }\n    validate_roles(palette)?;\n    // A turn that drifted from unit length (accumulated in game code) is renormalised.\n    let rot = if (at.rot.length_squared() - 1.0).abs() > 1e-4 { at.rot.normalize() } else { at.rot };\n    let parts = def.variant_with(&params, seed);\n    let o = object(at.id, at.pos, rot);\n    draw_parts(scene, &asset, &parts, &|_| Some(o.clone()), at.scale, palette, None);\n    for (i, light) in parts.lights.iter().enumerate() {\n        let def = LightDef {\n            color: role_hex(&light.color, palette).to_owned(),\n            radius: light.radius * at.scale,\n            intensity: light.intensity,\n            flicker: light.flicker,\n            pulse: light.pulse,\n            shadows: light.shadows,\n            offset: Vec3::ZERO,\n        };\n        let pos = at.pos + rot * (light.pos * at.scale);\n        scene.point_lights.push(crate::fx::light(&def, pos, scene.time, at.id as f32 * 1.7 + i as f32));\n    }\n    Ok(())\n}\n\n/// A stand-in object at `pos`, turned `rot`, for drawing parts with `emit_prim`.\nfn object(id: u32, pos: Vec3, rot: Quat) -> RenderObject {\n    RenderObject {\n        id: EntityId(id),\n        pos,\n        rot,\n        visual: Visual::new(Shape::Sphere { radius: 0.0 }, Color::WHITE),\n        prop: None,\n        puppet: None,\n        pulse: -1.0,\n        soft: None,\n        vehicle: None,\n        cone: None,\n        scenery: false,\n    }\n}\n\n/// Draws the visible parts of `parts` (asset `asset`), each placed by the object `place` gives\n/// for its index (None: not drawn), in the frame's style and material table. `wash` lerps every\n/// colour toward a tint (a hit flash).\nfn draw_parts(\n    scene: &mut Scene,\n    asset: &str,\n    parts: &pav_core::props::CompiledProp,\n    place: &dyn Fn(usize) -> Option<RenderObject>,\n    scale: f32,\n    palette: &Palette,\n    wash: Option<(Vec3, f32)>,\n) {\n    let mut cache = MESHES.lock().unwrap_or_else(|poisoned| poisoned.into_inner());\n    let meshes = cache.get_or_insert_with(GeneratedMeshes::default);\n    if meshes.built.len() > KEEP {\n        meshes.built.clear();\n    }\n    // A generated mesh goes into the scene once, however many things draw it.\n    meshes.sent = scene\n        .custom_meshes\n        .iter()\n        .filter_map(|(key, _)| match key {\n            MeshKey::Custom(key) => Some(*key),\n            _ => None,\n        })\n        .collect();\n//! Live-tunable parameters. Any struct implementing `Tunable` exposes its fields through a\n//! visitor, which powers the tuning panel, agent get/set by path, and preset files, with no\n//! string lookups in game code (values stay plain struct fields).\n\nuse std::collections::BTreeMap;\n\nuse serde::{Deserialize, Serialize};\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(untagged)]\npub enum ParamValue {\n    Bool(bool),\n    Int(i64),\n    Float(f64),\n    Text(String),\n}\n\nimpl ParamValue {\n    pub fn as_f64(&self) -> Option<f64> {\n        match self {\n            ParamValue::Float(f) => Some(*f),\n            ParamValue::Int(i) => Some(*i as f64),\n            ParamValue::Bool(b) => Some(*b as i64 as f64),\n            ParamValue::Text(t) => t.parse().ok(),\n        }\n    }\n    pub fn as_bool(&self) -> Option<bool> {\n        match self {\n            ParamValue::Bool(b) => Some(*b),\n            ParamValue::Int(i) => Some(*i != 0),\n            ParamValue::Float(f) => Some(*f != 0.0),\n            ParamValue::Text(t) => match t.as_str() {\n                \"true\" | \"on\" | \"yes\" | \"1\" => Some(true),\n                \"false\" | \"off\" | \"no\" | \"0\" => Some(false),\n                _ => None,\n            },\n        }\n    }\n    pub fn from_json(v: &serde_json::Value) -> Option<Self> {\n        serde_json::from_value(v.clone()).ok()\n    }\n    pub fn to_json(&self) -> serde_json::Value {\n        serde_json::to_value(self).unwrap_or(serde_json::Value::Null)\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize)]\npub enum ParamKind {\n    Float { min: f32, max: f32 },\n    Int { min: i32, max: i32 },\n    Bool,\n    Choice { options: Vec<String> },\n}\n\n#[derive(Clone, Debug, Serialize)]\npub struct ParamInfo {\n    pub path: String,\n    pub kind: ParamKind,\n    pub value: ParamValue,\n    pub help: String,\n}\n\n/// Visits every tunable field. Implementations decide what to do (draw UI, get, set, ...).\npub trait ParamVisitor {\n    fn float(&mut self, name: &str, v: &mut f32, min: f32, max: f32, help: &str);\n    fn int(&mut self, name: &str, v: &mut i32, min: i32, max: i32, help: &str);\n    fn bool(&mut self, name: &str, v: &mut bool, help: &str);\n    fn choice(&mut self, name: &str, v: &mut usize, options: &[&str], help: &str);\n    /// Called around nested groups. Return false from `enter` to skip the group.\n    fn enter(&mut self, name: &str) -> bool;\n    fn exit(&mut self);\n}\n\npub trait Tunable {\n    fn visit(&mut self, v: &mut dyn ParamVisitor);\n}\n\n/// Visits `t` as a nested group called `name`.\npub fn nested(v: &mut dyn ParamVisitor, name: &str, t: &mut dyn Tunable) {\n    if v.enter(name) {\n        t.visit(v);\n        v.exit();\n    }\n}\n\n/// Enums usable with `ParamVisitor::choice`.\npub trait ChoiceParam: Sized + Copy {\n    const NAMES: &'static [&'static str];\n    fn to_index(self) -> usize;\n    fn from_index(i: usize) -> Self;\n    fn name(self) -> &'static str {\n        Self::NAMES[self.to_index()]\n    }\n    fn visit_choice(&mut self, v: &mut dyn ParamVisitor, name: &str, help: &str) {\n        let mut i = self.to_index();\n        v.choice(name, &mut i, Self::NAMES, help);\n        *self = Self::from_index(i.min(Self::NAMES.len() - 1));\n    }\n}\n\n/// Declares a C-like enum as a `ChoiceParam` with snake_case display names.\n#[macro_export]\nmacro_rules! choice_enum {\n    ($(#[$m:meta])* $vis:vis enum $name:ident { $($(#[$vm:meta])* $var:ident => $label:literal),+ $(,)? }) => {\n        $(#[$m])*\n        #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, serde::Serialize, serde::Deserialize)]\n        #[serde(rename_all = \"snake_case\")]\n        $vis enum $name { $($(#[$vm])* $var),+ }\n        impl $crate::params::ChoiceParam for $name {\n            const NAMES: &'static [&'static str] = &[$($label),+];\n            fn to_index(self) -> usize { self as usize }\n            fn from_index(i: usize) -> Self {\n                const ALL: &[$name] = &[$($name::$var),+];\n                ALL[i.min(ALL.len() - 1)]\n            }\n        }\n    };\n}\n\nstruct PathTracker {\n    stack: Vec<String>,\n}\n\nimpl PathTracker {\n    fn path(&self, name: &str) -> String {\n        if self.stack.is_empty() { name.to_string() } else { format!(\"{}.{}\", self.stack.join(\".\"), name) }\n    }\n}\n\n/// Lists every parameter with its current value.\npub struct SimConfig {\n    pub tick_rate: TickRate,\n    /// World gravity for physics props (m/s², positive = down).\n    pub gravity: f32,\n    /// How far back rewind can go (seconds).\n    pub history_seconds: f32,\n    pub movement: MovementParams,\n    pub bombs: BombParams,\n    pub puppet: PuppetDef,\n    pub terrain: TerrainParams,\n    /// Shardfall difficulty multipliers.\n    pub difficulty: crate::arpg::Difficulty,\n    /// Performers: tempo and mirroring of their clips and moves.\n    pub anim: crate::clips::AnimParams,\n}\n\nimpl Default for SimConfig {\n    fn default() -> Self {\n        Self {\n            tick_rate: TickRate::Hz60,\n            gravity: 9.81,\n            history_seconds: 30.0,\n            movement: MovementParams::default(),\n            bombs: BombParams::default(),\n            puppet: PuppetDef::default(),\n            terrain: TerrainParams::default(),\n            difficulty: crate::arpg::Difficulty::default(),\n            anim: crate::clips::AnimParams::default(),\n        }\n    }\n}\n\n/// Only the simulation-level fields (groups are visited by `visit_groups`).\nimpl Tunable for SimConfig {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        self.tick_rate.visit_choice(v, \"tick_rate\", \"Simulation ticks per second\");\n        v.float(\"gravity\", &mut self.gravity, 0.0, 40.0, \"Gravity for physics props (m/s²)\");\n        v.float(\"history_seconds\", &mut self.history_seconds, 0.0, 300.0, \"Rewind window (s); 0 disables\");\n    }\n}\n\nimpl SimConfig {\n    /// Visits every simulation tunable as top-level groups: sim, movement, bombs, puppet, world,\n    /// difficulty, anim.\n    pub fn visit_groups(&mut self, v: &mut dyn ParamVisitor) {\n        nested(v, \"sim\", self);\n        nested(v, \"movement\", &mut self.movement);\n        nested(v, \"bombs\", &mut self.bombs);\n        nested(v, \"puppet\", &mut self.puppet);\n        nested(v, \"world\", &mut self.terrain);\n        nested(v, \"difficulty\", &mut self.difficulty);\n        nested(v, \"anim\", &mut self.anim);\n    }\n}\n\n/// Everything that changes during play. Cloning it is a snapshot.\n#[derive(Clone, Serialize, Deserialize)]\npub struct SimState {\n    /// The prop definitions placed copies use, each once. Declared first: a restore reads it\n    /// before the entities that name its keys.\n    #[serde(default, skip_serializing_if = \"crate::props::PropDefTable::is_empty\")]\n    pub prop_defs: crate::props::PropDefTable,\n    pub tick: u64,\n    pub seed: u64,\n    pub rng: Rng,\n    pub physics: PhysicsState,\n    pub entities: Entities,\n        if self.init_started || self.fatal.is_some() {\n            return;\n        }\n        self.init_started = true;\n        if let Err(e) = self.init(el) {\n            self.fail(el, e);\n        }\n    }\n\n    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {\n            self.on_touch(t, &event);\n            return;\n        }\n        let consumed = match (&mut self.egui_state, &self.gfx) {\n            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n            _ => false,\n        };\n        match event {\n            WindowEvent::CloseRequested => {\n                if let Some(host) = &self.host {\n                    host.exec(|sim| crate::save::save_from(sim));\n                }\n                self.look_ui.save_if_dirty(true);\n                el.exit()\n            }\n            WindowEvent::Focused(false) => {\n                self.input.clear();\n                self.touch.clear();\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n            }\n            WindowEvent::RedrawRequested => {\n                self.frame();\n                if self.quit {\n                    el.exit();\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    let system = matches!(\n                        code,\n                        KeyCode::Escape\n                            | KeyCode::F1\n                            | KeyCode::F2\n                            | KeyCode::F3\n                            | KeyCode::F4\n                            | KeyCode::F5\n                            | KeyCode::F6\n                            | KeyCode::F7\n                            | KeyCode::F8\n                            | KeyCode::F9\n                            | KeyCode::F10\n                            | KeyCode::F11\n                            | KeyCode::F12\n                    );\n                    if event.state == ElementState::Pressed && !event.repeat && (system || !consumed) {\n                        self.handle_key(code);\n                        if !system && !consumed {\n                            self.latency.press();\n                        }\n                    }\n                    if !consumed || event.state == ElementState::Released {\n                        self.input.key(code, event.state);\n                    }\n                }\n            }\n            WindowEvent::MouseWheel { delta, .. } if !consumed => {\n                let lines = match delta {\n                    MouseScrollDelta::LineDelta(_, y) => y,\n                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n                };\n                self.rig.params.distance = (self.rig.params.distance * 0.9f32.powf(lines)).clamp(2.0, 120.0);\n            }\n            WindowEvent::MouseInput { state, button, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if state == ElementState::Pressed && button == MouseButton::Left && !consumed {\n                    self.latency.press();\n                }\n                // In the game the right button is a skill; the middle button turns the camera.\n                let turn = if self.input.game && self.studio_mode == StudioMode::World {\n                    MouseButton::Middle\n                } else {\n                    MouseButton::Right\n                };\n                if button == turn {\n                    self.mouse.right_down = state == ElementState::Pressed && !consumed;\n                } else if !consumed || state == ElementState::Released {\n                    self.input.mouse_button(button, state);\n                }\n            }\n            WindowEvent::CursorMoved { position, .. } => {\n                let p = Vec2::new(position.x as f32, position.y as f32);\n                if self.mouse.right_down {\n                    let d = p - self.mouse.pos;\n        app\n    }\n\n    /// A finger on the screen: the touch layer decides whether it is the stick, a control, a\n    /// swipe or egui's (and then egui gets the event).\n    fn on_touch(&mut self, t: &winit::event::Touch, event: &WindowEvent) {\n        #[cfg(target_arch = \"wasm32\")]\n        self.resume_audio();\n        let Some(g) = &self.gfx else { return };\n        let ppp = self.egui_ctx.zoom_factor() * g.window.scale_factor() as f32;\n        let pos = egui::pos2(t.location.x as f32 / ppp, t.location.y as f32 / ppp);\n        self.input.last_device = Device::Touch;\n        self.touch_screen = true;\n        use winit::event::TouchPhase as P;\n        let to_egui = match t.phase {\n            P::Started => {\n                // (The root layer is everywhere; only windows and labels over the game count.)\n                let under = self.egui_ctx.layer_id_at(pos).filter(|l| *l != egui::LayerId::background()).map(|l| l.order);\n                self.touch.down(t.id, pos, under)\n            }\n            P::Moved => self.touch.moved(t.id, pos),\n            P::Ended => self.touch.up(t.id, pos, false),\n            P::Cancelled => self.touch.up(t.id, pos, true),\n        };\n        if to_egui {\n            if let (Some(st), Some(g)) = (&mut self.egui_state, &self.gfx) {\n                st.on_window_event(&g.window, event);\n            }\n        }\n    }\n\n    /// A tap on the open game closes what is open over it, one thing at a time.\n    fn close_on_tap(&mut self) {\n        if self.menu_open {\n            self.set_menu(false);\n        } else if self.game_ui.any_open() {\n            self.game_ui.close_all();\n        } else if self.game_ui.map {\n            self.game_ui.map = false;\n        } else if self.look_ui.open {\n            self.look_ui.open = false;\n            self.look_ui.save_if_dirty(true);\n        } else if self.guide.station || self.guide.field {\n            self.guide.station = false;\n            self.guide.field = false;\n        } else if self.hud.teleport_open {\n            self.hud.teleport_open = false;\n        } else if self.hud.card_visible() {\n            self.hud.hide_card();\n        }\n    }\n\n    fn init(&mut self, el: &ActiveEventLoop) -> Result<()> {\n        let s = self.settings.clone();\n        let window = stage(\"window\", || {\n            let mut attrs = Window::default_attributes().with_title(\"Shardfall\");\n            #[cfg(not(target_arch = \"wasm32\"))]\n            {\n                attrs = attrs.with_inner_size(winit::dpi::LogicalSize::new(s.width, s.height));\n            }\n            // In the browser the window is a canvas filling the page (sized by the page's CSS).\n            #[cfg(target_arch = \"wasm32\")]\n            {\n                use winit::platform::web::WindowAttributesExtWebSys;\n                attrs = attrs.with_append(true);\n            }\n            if s.fullscreen {\n                attrs = attrs.with_fullscreen(Some(Fullscreen::Borderless(None)));\n            }\n            let w = Arc::new(el.create_window(attrs)?);\n            let sz = w.inner_size();\n            let d = format!(\"{}x{} px, scale {:.2}\", sz.width, sz.height, w.scale_factor());\n            Ok((w, d))\n        })?;\n        let backend = BackendChoice::parse(&s.backend)\n            .ok_or_else(|| anyhow!(\"unknown backend '{}' in settings (use vulkan or dx12)\", s.backend))?;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        {\n            let gfx = Gfx::new(window, backend, s.vsync)?;\n            self.finish_init(gfx)\n        }\n        // The browser hands out the GPU asynchronously: `about_to_wait` finishes the start.\n        #[cfg(target_arch = \"wasm32\")]\n        {\n            let slot = std::rc::Rc::new(std::cell::RefCell::new(None));\n            let fill = slot.clone();\n            wasm_bindgen_futures::spawn_local(async move {\n                *fill.borrow_mut() = Some(Gfx::create(window, backend, s.vsync).await);\n            });\n            self.pending_gfx = Some(slot);\n            Ok(())\n        }\n    }\n\n    /// The rest of the start, once graphics exist.\n    fn finish_init(&mut self, gfx: Gfx) -> Result<()> {\n        let s = self.settings.clone();\n        let window = gfx.window.clone();\n        let egui_state = stage(\"ui\", || {\n            let st = UiInput::new(&self.egui_ctx, &window, gfx.device.limits().max_texture_dimension_2d as usize);\n            Ok((st, String::new()))\n        })?;\n        self.audio = stage(\"audio\", || match pav_audio::AudioOut::start() {\n            Ok(a) => {\n                let d = format!(\"{} @ {} Hz\", a.device, a.sample_rate);\n                Ok((Some(a), d))\n            }\n            Err(e) => Ok((None, format!(\"no sound ({e}); continuing silently\"))),\n        })?;\n        // Rooms can name saved objects. Load the library before constructing the scene, and\n        // the workshop materials before the objects that wear them.\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = pav_tools::material_tools::initialize_authored() {\n            self.asset_ui.report(Err(format!(\"Could not load saved materials: {error:#}\")));\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'CARGO_BUILD_JOBS=10 cargo build --locked -p pav_tools --bin pav > ../notes/build-native.log 2>&1'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"mkdir -p tools tests notes engine/game/merc/stamps engine/crates/pav_core/src/games/merc engine/crates/pav_view/src/merc engine/crates/pav_ui/src/tenfoot && cat > notes/feedback.md <<'EOF'\n# Running feedback\n\nIssues caught: 0. Critical: 0.\n\nEngine source reads: games/mod.rs, starter.rs and input.rs to extend the game hook and inputs; camera.rs because it lacks a first-person path; frame.rs/sim.rs to publish typed state; build.rs/assets.rs to connect the custom game view to primitive rendering; gfx.rs, app.rs, uiinput.rs and main.rs to build a dedicated shell without Pavilion debug overlays; physics.rs/statics.rs/terrain.rs to add smooth terrain and raycasts. MAKE_A_GAME documents the missing game camera and custom menus but implementing them requires internals.\n\nResearch: supplied plan; official Pavilion source, START_HERE and MAKE_A_GAME; official AI Hub protocol and harness. No third-party creative assets.\nEOF\ncat > tools/bootstrap.py <<'PY'\nfrom pathlib import Path\nimport json\np=Path('engine/game/merc')\nstrings={'title':'A Fair Cry','tagline':'EVERY BULLET HAS A BUYER.','country':'REPUBLIC OF KWELARA','season':'THE LAST DRY SEASON','continue':'Continue','new':'New contract','multiplayer':'Multiplayer','settings':'Settings','about':'About / Credits','resume':'Resume','controls':'Controls','dev':'Dev mode','quit':'Return to title','back':'Back','accept':'Accept contract','decline':'Not yet','ready':'Ready','touch':'Controller or keyboard required','press':'Press any button','loading':'Preparing the dry season…','death':'Nobody will ask what happened. That is what the money was for.','save':'Sleep saves your progress. The country keeps its receipts.','border':'Past here, there is only more of the same.','bar':'Ceasefire means they only shoot you past the town limits. We have a sign.','shop':'Everything here is new, or has been described as new.','clinic':'God does not pay for quinine. You will.','rescue':'Keep breathing. We can settle the account later.','companion_down':'Best plan I ever had went wrong too. This wasn’t even that plan.','mercy':'Do it properly. You still owe me eleven diamonds.','ending_burn':'The ledger burns. Paper is the only thing here that stays dead.','ending_read':'For three minutes, every name has a witness. Then the radio goes quiet.','ending_chair':'The next order comes in. You answer it.','ledger':'Every buyer. Both employers. Your firm. He paid for his own killer.','town_choice':'Two men. One way out. Choose who gets to owe you.','patch':'Patch up · 1 syrette','overdose':'Overdose · hold to confirm','dossier_0':'Ada Okoro|Ex-army medic. Calm. Counts what you owe her.','dossier_1':'Tomek Wrona|Ex-sapper. Jokes when things are worst.','dossier_2':'Rafael Quintero|Tracker. Superstitious about nothing.','dossier_3':'Mirela Dragan|Sharpshooter. Says very little.','prologue':'Bakker: The crates are for both sides. So is the receipt.','fever_warn':'The ringing returns. Find your pills.','blackout':'Someone carried you. They took a fee.','ceasefire':'The ceasefire has ended. The sign was cheaper than peace.','mission_end':'Paid in full. Nothing settled.','no_money':'Credit is a matter for churches. Bring diamonds.','treatment_0':'Pulling the bullet','treatment_1':'Removing the fragment','treatment_2':'Cooling and binding the burn','treatment_3':'Setting the finger','treatment_4':'Tightening the tourniquet','treatment_5':'Cauterising the graze','treat':'Treat wound','reload':'Reloading','jam':'JAMMED · work the bolt','pill':'Taking quinine','syrette':'Using a syrette','repair':'Repairing the engine','map':'FIELD MAP','map_hint':'Choose a place. The GPS will do the arithmetic.','no_save':'No previous contract on record.','contract':'CURRENT CONTRACT','wind':'WIND','health':'HEALTH','ammo':'ROUNDS','inventory':'FIELD LOCKER','sleep':'SLEEP UNTIL','shop_title':'DESAI’S CATALOGUE','pause':'ON THE RECORD','dev_title':'FIELD TOOLS','standing':'Standing','crouch':'Crouched','prone':'Prone','session_title':'CONTRACT RUN','session_goal':'Burn three tanks. Take the ledger. Leave together.','solo':'This computer','invite':'Invite code','create':'Create a room','join':'Join a room','start':'Start contract','map_lower':'Lower map','town_safe':'CEASEFIRE ZONE · WEAPON HOLSTERED','objective_done':'OBJECTIVE COMPLETE','extract':'EXTRACTED','failed':'CONTRACT VOID','ready_help':'Enter / Cross: ready · Triangle: more','more':'Destroy three fuel tanks, collect the office ledger, and get every living merc to the river boat. Friends can drag and patch a downed merc.','settings_sound':'Sound','settings_control':'Controls','settings_picture':'Picture','settings_access':'Access','dev_cheats':'Cheats','dev_teleport':'Teleport','dev_story':'Story','dev_give':'Spawn / Give','dev_world':'World','dev_balance':'Balance','reset':'Reset to defaults','next_page':'Next page','previous_page':'Previous page','save_slot':'Save in manual slot','load_slot':'Load manual slot','bus':'MINIBUS · 1 diamond','tape':'PLAY CASSETTE','companion':'COMPANIONS','offer':'A better way: take the service track. More money. More people to disappoint.','recruit':'Come along. Payment on survival.','rally':'Mercs wait for nobody. Except on the card.','ending_question':'What will you do with the ledger?','burn_choice':'Burn it','read_choice':'Read it on air','chair_choice':'Take the chair','ending_tape':'FINAL INTERVIEW','end_return':'Return to title','help_foot':'WASD move · Mouse look · LMB fire · RMB aim\\\\nR reload / clear jam · E interact · Q next weapon\\\\nG throw · V machete · M map · B monocular\\\\nH treat · P pills · T tracker · Tab contract\\\\nC crouch · Z prone · Shift sprint · Space vault','help_vehicle':'W / S throttle and reverse · A / D steer\\\\nE leave / repair at hood · F gunner seat\\\\nV camera · L horn · M map · Space handbrake','help_pad':'Left stick move · Right stick look\\\\nR2 fire · L2 aim · Square interact / reload\\\\nTriangle weapon · L1 throw · R1 machete\\\\nUp treat · Down pills · Left map · Right tracker\\\\nCross jump · Circle crouch · L3 sprint · R3 monocular','hud_tip':'Follow the road north. Raise the map with M or D-pad left.','tape_hint':'The cassette keeps playing while you walk.','defend':'HOLD THE MAST','rewind':'No revisions. Only receipts.'}\ndef toml_table(d): return '\\\\n'.join(f'{k} = {json.dumps(v,ensure_ascii=False)}' for k,v in d.items())+'\\\\n'\n(p/'strings.toml').write_text(toml_table(strings))\nweapons=[('pistol',0,'Service Nine',12,60,300,22,40,.1,120,0),('revolver',0,'Old Six',6,30,120,48,50,.05,140,0),('flare',0,'Flare pistol',1,8,40,10,60,.5,60,1),('sawnoff',0,'Sawn-off',2,24,120,96,12,.3,150,0),('ar',1,'Forty-Seven',30,180,600,26,120,.14,160,0),('battle',1,'Battle rifle',20,100,450,38,180,.12,180,0),('smg',1,'Folding SMG',30,180,800,16,50,.16,110,0),('shotgun',1,'Pump gun',6,36,70,90,18,.25,150,0),('sniper',1,'Bolt rifle',5,40,40,110,400,.35,300,0),('dart',1,'Dart rifle',1,12,40,110,80,.2,8,0),('lmg',2,'Belt-fed gun',100,300,700,28,140,.08,200,0),('rpg',2,'Rocket tube',1,6,15,300,150,1.2,260,2),('flamer',2,'Flamethrower',100,300,600,3,14,.05,40,3),('mortar',2,'Hand mortar',1,8,20,200,200,1,200,4)]\n(p/'weapons.toml').write_text('\\\\n'.join('[[weapon]]\\\\n'+toml_table(dict(zip(['id','slot','name','mag','reserve','rpm','damage','range','wear','noise','igniter'],w))) for w in weapons))\nplaces=[('airstrip','Cargo airstrip',-120,900,0),('gp1','Kilo 38',-40,640,1),('town','Kilometre 40',0,380,2),('sh1','Pump House',170,470,3),('bridge','Luvande Bridge',40,40,4),('gp2','South bridge post',40,110,1),('gp3','North bridge post',40,-30,1),('mission','Mission Ste-Odile',720,420,5),('ferry','Ferry landing',640,170,4),('sh3','Boat Shed',830,255,3),('pump','Pump station',-420,-30,6),('depot','Ombe Flats depot',-520,-520,7),('junction','Flats junction',20,-420,8),('gp4','Flats road post',60,-460,1),('sh2','Ranger’s Lodge',-260,-700,3),('gp5','Ridge road post',360,-520,1),('hotel','Hotel Splendide',620,-640,9),('gp6','Quarry road post',-420,480,1),('works','Cement Works',-760,620,10),('bus_mission','Mission road',380,400,8)]\n(p/'world.toml').write_text('size = 2048\\\\nriver = [[-1024,180],[-820,220],[-560,60],[-200,-40],[120,40],[420,90],[760,260],[1024,120]]\\\\nroads = [[0,1],[1,2],[2,3],[2,5],[5,4],[4,6],[6,12],[12,13],[12,11],[11,14],[13,15],[15,16],[2,17],[17,18],[2,19],[19,7],[7,8],[8,9],[6,10]]\\\\n\\\\n'+'\\\\n'.join('[[place]]\\\\n'+toml_table(dict(zip(['id','name','x','z','kind'],q))) for q in places))\ncontracts=[('A0','Landing Fees','Bakker',0,'The crates are marked for both sides.\\\\nFollow the road to Kilometre 40.\\\\nPapa Lazare has a room. You have a fever.',0,[('reach','town',30),('pills','town',1)]),('A1','On the House','Papa Lazare',8,'Clear Kilo 38.\\\\nClaim the Pump House beyond it.\\\\nCome back breathing. Drinks cost extra.',1,[('clear','gp1',0),('claim','sh1',0),('shop','town',0)]),('B1','Dry Season','Colonel Tshala',12,'Burn the depot at Ombe.\\\\nThree fuel tanks. Leave the paperwork to us.\\\\nIf anyone asks, it was the dry season.',2,[('tanks','depot',3),('escape','junction',40)]),('B2','Water Rights','Josephine Ruvuma',10,'The Council controls the pumps.\\\\nGo by river. Go after dark.\\\\nLeave them to reconsider ownership.',3,[('night','sh3',0),('sabotage','pump',0)]),('B3','Papers','Sister Perpetua',9,'Medicine. Not ammunition.\\\\nTake the truck to the mission.\\\\nThe men at the roadblock cannot read.',4,[('cargo','town',0),('deliver','mission',0)]),('B4','A Better Way','Your companion',14,'A convoy has a service track.\\\\nYour companion knows it.\\\\nKnowledge is not the same as a good idea.',5,[('convoy','gp6',0),('companion','gp6',0)]),('C1','Inspection','Colonel Tshala',12,'The negotiator at the hotel has become an obstacle.\\\\nObserve from the ridge.\\\\nMake the necessary administrative adjustment.',6,[('tag','hotel',0),('target','hotel',0)]),('C2','Receipts','Josephine Ruvuma',15,'The arms convoy is on the quarry road.\\\\nTake its manifest.\\\\nYou have seen these stencils before.',7,[('convoy','airstrip',0),('manifest','airstrip',0)]),('C3','The Town Burns','Thandiwe Moyo',0,'The ceasefire is ash.\\\\nLazare and Desai are trapped.\\\\nThere is time for one.',8,[('evacuate','town',0)]),('D1','Last Order','The Chandler',0,'The ledger is at the Cement Works.\\\\nBoth armies want it.\\\\nYour name is in it too.',9,[('ledger','works',0)]),('D2','The Interview','Yourself',0,'He bought his own ending.\\\\nYou may yet choose yours.',10,[('ending','works',0)])]\n(p/'contracts.toml').write_text('\\\\n'.join('[[contract]]\\\\n'+toml_table(dict(zip(['id','name','giver','pay','brief','index'],c[:6])))+''.join('[[contract.goal]]\\\\n'+toml_table(dict(zip(['kind','place','value'],g))) for g in c[6]) for c in contracts))\ntapes=[('bar','Rope and tallow',['A chandler sells what a ship needs.','Rope. Tallow. Lamp oil.','Nobody ever blamed the rope.','Moyo: A rifle is not rope.','No. Rope lasts longer.','Moyo: Who paid for this shipment?','Ask me who did not.','The list is shorter.']),('mission','The cost of water',['Moyo: They closed the clinic road.','An administrative decision.','Moyo: People died on the other road.','Every road has a price.','Mine happens to be printed.','Moyo: Does that help you sleep?','Nothing helps me sleep.','I have bought rather a lot of nights.']),('depot','The interview',['Moyo: He asked me to note he is not a monster.','I have noted it.','The Chandler: Accuracy matters.','Moyo: So does ammunition.','You sell both sides the same promise.','I sell them the means to disagree.','Moyo: And the bill?','Always itemised.']),('hotel','A finite resource',['You call the war a fire.','A fire stops when nothing remains.','This war has suppliers.','Moyo: You could stop supplying it.','Another man would find my chair.','Moyo: That is your answer?','It is my excuse.','You asked for accuracy.']),('works','The ledger',['Every name. Every account.','The junta. The schoolteacher.','The firm that sent you.','I hired my own replacement.','Moyo: Or your killer.','The invoice does not distinguish.','There is a radio upstairs.','You might finally say something.']),('town','The empty stool',['Moyo: The bar is gone.','The chairs were already empty.','Moyo: You supplied the shells.','Yes.','Moyo: Do not improve that sentence.','I was not going to.','There are names in the ash.','Try to keep one.'])]\n(p/'tapes.toml').write_text('\\\\n'.join('[[tape]]\\\\n'+toml_table({'place':q[0],'name':q[1],'lines':q[2]}) for q in tapes))\n(p/'attract.toml').write_text('\\\\n'.join('[[segment]]\\\\n'+toml_table({'name':n,'seconds':18,'place':q,'hour':h,'action':a}) for n,q,h,a in [('Dawn on the plain','depot',6,'fly'),('The road has owners','gp1',17,'drive'),('A second-hand rifle','gp4',16,'jam'),('The dry season','depot',18,'fire'),('What the money buys','sh1',15,'heal'),('An outstanding debt','gp6',18,'rescue'),('Choose your road','bridge',17,'map'),('River passage','ferry',19,'boat'),('Water rights','pump',0,'stealth'),('A sign at the town limits','town',17,'town')]))\n(p/'barks.toml').write_text(toml_table({'jam':['Not now.','This rifle has opinions.'],'fire':['Upwind\"'!'\"','The grass is moving\"'!'\"'],'search':['He was here.','Check the ditch.'],'combat':['Left side\"'!'\"','Keep him there.'],'morale':['Leave it\"'!'\"','No contract covers this.']}))\nPY\npython3 tools/bootstrap.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"mkdir -p tools tests notes engine/game/merc/stamps engine/crates/pav_core/src/games/merc engine/crates/pav_view/src/merc engine/crates/pav_ui/src/tenfoot && cat > notes/feedback.md <<'EOF'\n# Running feedback\n\nIssues caught: 0. Critical: 0.\n\nEngine source reads: games/mod.rs, starter.rs and input.rs to extend the game hook and inputs; camera.rs because it lacks a first-person path; frame.rs/sim.rs to publish typed state; build.rs/assets.rs to connect the custom game view to primitive rendering; gfx.rs, app.rs, uiinput.rs and main.rs to build a dedicated shell without Pavilion debug overlays; physics.rs/statics.rs/terrain.rs to add smooth terrain and raycasts. MAKE_A_GAME documents the missing game camera and custom menus but implementing them requires internals.\n\nResearch: supplied plan; official Pavilion source, START_HERE and MAKE_A_GAME; official AI Hub protocol and harness. No third-party creative assets.\nEOF\ncat > tools/bootstrap.py <<'PY'\nfrom pathlib import Path\nimport json\np=Path('engine/game/merc')\nstrings={'title':'A Fair Cry','tagline':'EVERY BULLET HAS A BUYER.','country':'REPUBLIC OF KWELARA','season':'THE LAST DRY SEASON','continue':'Continue','new':'New contract','multiplayer':'Multiplayer','settings':'Settings','about':'About / Credits','resume':'Resume','controls':'Controls','dev':'Dev mode','quit':'Return to title','back':'Back','accept':'Accept contract','decline':'Not yet','ready':'Ready','touch':'Controller or keyboard required','press':'Press any button','loading':'Preparing the dry season…','death':'Nobody will ask what happened. That is what the money was for.','save':'Sleep saves your progress. The country keeps its receipts.','border':'Past here, there is only more of the same.','bar':'Ceasefire means they only shoot you past the town limits. We have a sign.','shop':'Everything here is new, or has been described as new.','clinic':'God does not pay for quinine. You will.','rescue':'Keep breathing. We can settle the account later.','companion_down':'Best plan I ever had went wrong too. This wasn’t even that plan.','mercy':'Do it properly. You still owe me eleven diamonds.','ending_burn':'The ledger burns. Paper is the only thing here that stays dead.','ending_read':'For three minutes, every name has a witness. Then the radio goes quiet.','ending_chair':'The next order comes in. You answer it.','ledger':'Every buyer. Both employers. Your firm. He paid for his own killer.','town_choice':'Two men. One way out. Choose who gets to owe you.','patch':'Patch up · 1 syrette','overdose':'Overdose · hold to confirm','dossier_0':'Ada Okoro|Ex-army medic. Calm. Counts what you owe her.','dossier_1':'Tomek Wrona|Ex-sapper. Jokes when things are worst.','dossier_2':'Rafael Quintero|Tracker. Superstitious about nothing.','dossier_3':'Mirela Dragan|Sharpshooter. Says very little.','prologue':'Bakker: The crates are for both sides. So is the receipt.','fever_warn':'The ringing returns. Find your pills.','blackout':'Someone carried you. They took a fee.','ceasefire':'The ceasefire has ended. The sign was cheaper than peace.','mission_end':'Paid in full. Nothing settled.','no_money':'Credit is a matter for churches. Bring diamonds.','treatment_0':'Pulling the bullet','treatment_1':'Removing the fragment','treatment_2':'Cooling and binding the burn','treatment_3':'Setting the finger','treatment_4':'Tightening the tourniquet','treatment_5':'Cauterising the graze','treat':'Treat wound','reload':'Reloading','jam':'JAMMED · work the bolt','pill':'Taking quinine','syrette':'Using a syrette','repair':'Repairing the engine','map':'FIELD MAP','map_hint':'Choose a place. The GPS will do the arithmetic.','no_save':'No previous contract on record.','contract':'CURRENT CONTRACT','wind':'WIND','health':'HEALTH','ammo':'ROUNDS','inventory':'FIELD LOCKER','sleep':'SLEEP UNTIL','shop_title':'DESAI’S CATALOGUE','pause':'ON THE RECORD','dev_title':'FIELD TOOLS','standing':'Standing','crouch':'Crouched','prone':'Prone','session_title':'CONTRACT RUN','session_goal':'Burn three tanks. Take the ledger. Leave together.','solo':'This computer','invite':'Invite code','create':'Create a room','join':'Join a room','start':'Start contract','map_lower':'Lower map','town_safe':'CEASEFIRE ZONE · WEAPON HOLSTERED','objective_done':'OBJECTIVE COMPLETE','extract':'EXTRACTED','failed':'CONTRACT VOID','ready_help':'Enter / Cross: ready · Triangle: more','more':'Destroy three fuel tanks, collect the office ledger, and get every living merc to the river boat. Friends can drag and patch a downed merc.','settings_sound':'Sound','settings_control':'Controls','settings_picture':'Picture','settings_access':'Access','dev_cheats':'Cheats','dev_teleport':'Teleport','dev_story':'Story','dev_give':'Spawn / Give','dev_world':'World','dev_balance':'Balance','reset':'Reset to defaults','next_page':'Next page','previous_page':'Previous page','save_slot':'Save in manual slot','load_slot':'Load manual slot','bus':'MINIBUS · 1 diamond','tape':'PLAY CASSETTE','companion':'COMPANIONS','offer':'A better way: take the service track. More money. More people to disappoint.','recruit':'Come along. Payment on survival.','rally':'Mercs wait for nobody. Except on the card.','ending_question':'What will you do with the ledger?','burn_choice':'Burn it','read_choice':'Read it on air','chair_choice':'Take the chair','ending_tape':'FINAL INTERVIEW','end_return':'Return to title','help_foot':'WASD move · Mouse look · LMB fire · RMB aim\\\\nR reload / clear jam · E interact · Q next weapon\\\\nG throw · V machete · M map · B monocular\\\\nH treat · P pills · T tracker · Tab contract\\\\nC crouch · Z prone · Shift sprint · Space vault','help_vehicle':'W / S throttle and reverse · A / D steer\\\\nE leave / repair at hood · F gunner seat\\\\nV camera · L horn · M map · Space handbrake','help_pad':'Left stick move · Right stick look\\\\nR2 fire · L2 aim · Square interact / reload\\\\nTriangle weapon · L1 throw · R1 machete\\\\nUp treat · Down pills · Left map · Right tracker\\\\nCross jump · Circle crouch · L3 sprint · R3 monocular','hud_tip':'Follow the road north. Raise the map with M or D-pad left.','tape_hint':'The cassette keeps playing while you walk.','defend':'HOLD THE MAST','rewind':'No revisions. Only receipts.'}\ndef toml_table(d): return '\\\\n'.join(f'{k} = {json.dumps(v,ensure_ascii=False)}' for k,v in d.items())+'\\\\n'\n(p/'strings.toml').write_text(toml_table(strings))\nweapons=[('pistol',0,'Service Nine',12,60,300,22,40,.1,120,0),('revolver',0,'Old Six',6,30,120,48,50,.05,140,0),('flare',0,'Flare pistol',1,8,40,10,60,.5,60,1),('sawnoff',0,'Sawn-off',2,24,120,96,12,.3,150,0),('ar',1,'Forty-Seven',30,180,600,26,120,.14,160,0),('battle',1,'Battle rifle',20,100,450,38,180,.12,180,0),('smg',1,'Folding SMG',30,180,800,16,50,.16,110,0),('shotgun',1,'Pump gun',6,36,70,90,18,.25,150,0),('sniper',1,'Bolt rifle',5,40,40,110,400,.35,300,0),('dart',1,'Dart rifle',1,12,40,110,80,.2,8,0),('lmg',2,'Belt-fed gun',100,300,700,28,140,.08,200,0),('rpg',2,'Rocket tube',1,6,15,300,150,1.2,260,2),('flamer',2,'Flamethrower',100,300,600,3,14,.05,40,3),('mortar',2,'Hand mortar',1,8,20,200,200,1,200,4)]\n(p/'weapons.toml').write_text('\\\\n'.join('[[weapon]]\\\\n'+toml_table(dict(zip(['id','slot','name','mag','reserve','rpm','damage','range','wear','noise','igniter'],w))) for w in weapons))\nplaces=[('airstrip','Cargo airstrip',-120,900,0),('gp1','Kilo 38',-40,640,1),('town','Kilometre 40',0,380,2),('sh1','Pump House',170,470,3),('bridge','Luvande Bridge',40,40,4),('gp2','South bridge post',40,110,1),('gp3','North bridge post',40,-30,1),('mission','Mission Ste-Odile',720,420,5),('ferry','Ferry landing',640,170,4),('sh3','Boat Shed',830,255,3),('pump','Pump station',-420,-30,6),('depot','Ombe Flats depot',-520,-520,7),('junction','Flats junction',20,-420,8),('gp4','Flats road post',60,-460,1),('sh2','Ranger’s Lodge',-260,-700,3),('gp5','Ridge road post',360,-520,1),('hotel','Hotel Splendide',620,-640,9),('gp6','Quarry road post',-420,480,1),('works','Cement Works',-760,620,10),('bus_mission','Mission road',380,400,8)]\n(p/'world.toml').write_text('size = 2048\\\\nriver = [[-1024,180],[-820,220],[-560,60],[-200,-40],[120,40],[420,90],[760,260],[1024,120]]\\\\nroads = [[0,1],[1,2],[2,3],[2,5],[5,4],[4,6],[6,12],[12,13],[12,11],[11,14],[13,15],[15,16],[2,17],[17,18],[2,19],[19,7],[7,8],[8,9],[6,10]]\\\\n\\\\n'+'\\\\n'.join('[[place]]\\\\n'+toml_table(dict(zip(['id','name','x','z','kind'],q))) for q in places))\ncontracts=[('A0','Landing Fees','Bakker',0,'The crates are marked for both sides.\\\\nFollow the road to Kilometre 40.\\\\nPapa Lazare has a room. You have a fever.',0,[('reach','town',30),('pills','town',1)]),('A1','On the House','Papa Lazare',8,'Clear Kilo 38.\\\\nClaim the Pump House beyond it.\\\\nCome back breathing. Drinks cost extra.',1,[('clear','gp1',0),('claim','sh1',0),('shop','town',0)]),('B1','Dry Season','Colonel Tshala',12,'Burn the depot at Ombe.\\\\nThree fuel tanks. Leave the paperwork to us.\\\\nIf anyone asks, it was the dry season.',2,[('tanks','depot',3),('escape','junction',40)]),('B2','Water Rights','Josephine Ruvuma',10,'The Council controls the pumps.\\\\nGo by river. Go after dark.\\\\nLeave them to reconsider ownership.',3,[('night','sh3',0),('sabotage','pump',0)]),('B3','Papers','Sister Perpetua',9,'Medicine. Not ammunition.\\\\nTake the truck to the mission.\\\\nThe men at the roadblock cannot read.',4,[('cargo','town',0),('deliver','mission',0)]),('B4','A Better Way','Your companion',14,'A convoy has a service track.\\\\nYour companion knows it.\\\\nKnowledge is not the same as a good idea.',5,[('convoy','gp6',0),('companion','gp6',0)]),('C1','Inspection','Colonel Tshala',12,'The negotiator at the hotel has become an obstacle.\\\\nObserve from the ridge.\\\\nMake the necessary administrative adjustment.',6,[('tag','hotel',0),('target','hotel',0)]),('C2','Receipts','Josephine Ruvuma',15,'The arms convoy is on the quarry road.\\\\nTake its manifest.\\\\nYou have seen these stencils before.',7,[('convoy','airstrip',0),('manifest','airstrip',0)]),('C3','The Town Burns','Thandiwe Moyo',0,'The ceasefire is ash.\\\\nLazare and Desai are trapped.\\\\nThere is time for one.',8,[('evacuate','town',0)]),('D1','Last Order','The Chandler',0,'The ledger is at the Cement Works.\\\\nBoth armies want it.\\\\nYour name is in it too.',9,[('ledger','works',0)]),('D2','The Interview','Yourself',0,'He bought his own ending.\\\\nYou may yet choose yours.',10,[('ending','works',0)])]\n(p/'contracts.toml').write_text('\\\\n'.join('[[contract]]\\\\n'+toml_table(dict(zip(['id','name','giver','pay','brief','index'],c[:6])))+''.join('[[contract.goal]]\\\\n'+toml_table(dict(zip(['kind','place','value'],g))) for g in c[6]) for c in contracts))\ntapes=[('bar','Rope and tallow',['A chandler sells what a ship needs.','Rope. Tallow. Lamp oil.','Nobody ever blamed the rope.','Moyo: A rifle is not rope.','No. Rope lasts longer.','Moyo: Who paid for this shipment?','Ask me who did not.','The list is shorter.']),('mission','The cost of water',['Moyo: They closed the clinic road.','An administrative decision.','Moyo: People died on the other road.','Every road has a price.','Mine happens to be printed.','Moyo: Does that help you sleep?','Nothing helps me sleep.','I have bought rather a lot of nights.']),('depot','The interview',['Moyo: He asked me to note he is not a monster.','I have noted it.','The Chandler: Accuracy matters.','Moyo: So does ammunition.','You sell both sides the same promise.','I sell them the means to disagree.','Moyo: And the bill?','Always itemised.']),('hotel','A finite resource',['You call the war a fire.','A fire stops when nothing remains.','This war has suppliers.','Moyo: You could stop supplying it.','Another man would find my chair.','Moyo: That is your answer?','It is my excuse.','You asked for accuracy.']),('works','The ledger',['Every name. Every account.','The junta. The schoolteacher.','The firm that sent you.','I hired my own replacement.','Moyo: Or your killer.','The invoice does not distinguish.','There is a radio upstairs.','You might finally say something.']),('town','The empty stool',['Moyo: The bar is gone.','The chairs were already empty.','Moyo: You supplied the shells.','Yes.','Moyo: Do not improve that sentence.','I was not going to.','There are names in the ash.','Try to keep one.'])]\n(p/'tapes.toml').write_text('\\\\n'.join('[[tape]]\\\\n'+toml_table({'place':q[0],'name':q[1],'lines':q[2]}) for q in tapes))\n(p/'attract.toml').write_text('\\\\n'.join('[[segment]]\\\\n'+toml_table({'name':n,'seconds':18,'place':q,'hour':h,'action':a}) for n,q,h,a in [('Dawn on the plain','depot',6,'fly'),('The road has owners','gp1',17,'drive'),('A second-hand rifle','gp4',16,'jam'),('The dry season','depot',18,'fire'),('What the money buys','sh1',15,'heal'),('An outstanding debt','gp6',18,'rescue'),('Choose your road','bridge',17,'map'),('River passage','ferry',19,'boat'),('Water rights','pump',0,'stealth'),('A sign at the town limits','town',17,'town')]))\n(p/'barks.toml').write_text(toml_table({'jam':['Not now.','This rifle has opinions.'],'fire':['Upwind\"'!'\"','The grass is moving\"'!'\"'],'search':['He was here.','Check the ditch.'],'combat':['Left side\"'!'\"','Keep him there.'],'morale':['Leave it\"'!'\"','No contract covers this.']}))\nPY\npython3 tools/bootstrap.py\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"agent_message","text":"The game’s data files now contain the weapons, locations, contracts, tapes, and attract sequence. I’m building the rules in Rust and the controller-friendly screens in egui. Keeping objectives in data will let the bot exercise the same campaign the player uses.\n"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/merc/data.rs <<'RS'\nuse std::{collections::BTreeMap, sync::{Arc, OnceLock}};\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse crate::params::{ParamVisitor, Tunable};\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct WeaponDef { pub id:String, pub slot:usize, pub name:String, pub mag:i32, pub reserve:i32, pub rpm:f32, pub damage:f32, pub range:f32, pub wear:f32, pub noise:f32, pub igniter:u8 }\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Place { pub id:String, pub name:String, pub x:f32, pub z:f32, pub kind:u8 }\nimpl Place {pub fn pos(&self)->Vec3 {Vec3::new(self.x,0.,self.z)} }\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct GoalDef {pub kind:String,pub place:String,pub value:f32}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Contract {pub id:String,pub name:String,pub giver:String,pub brief:String,pub pay:i32,pub index:usize,pub goal:Vec<GoalDef>}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Tape {pub place:String,pub name:String,pub lines:Vec<String>}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Segment {pub name:String,pub seconds:f32,pub place:String,pub hour:f32,pub action:String}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct World {pub size:f32,pub river:Vec<[f32;2]>,pub roads:Vec<[usize;2]>,pub place:Vec<Place>}\n#[derive(Clone, Debug)]\npub struct Data {pub strings:BTreeMap<String,String>,pub weapons:Vec<WeaponDef>,pub world:World,pub contracts:Vec<Contract>,pub tapes:Vec<Tape>,pub attract:Vec<Segment>}\nmacro_rules\"'! read {($name:literal)=>{{let baked=include_str!(concat!(\"../../../../../game/merc/\",$name));#[cfg(not(target_arch=\"wasm32\"))] let text=std::fs::read_to_string(concat!(\"game/merc/\",$name)).unwrap_or_else(|_|baked.into());#[cfg(target_arch=\"wasm32\")] let text=baked.to_string();text}};}\npub fn data()->Arc<Data>{static D:OnceLock<Arc<Data>>=OnceLock::new();D.get_or_init(||{\n #[derive(Deserialize)]struct W{weapon:Vec<WeaponDef>}\n #[derive(Deserialize)]struct C{contract:Vec<Contract>}\n #[derive(Deserialize)]struct T{tape:Vec<Tape>}\n #[derive(Deserialize)]struct A{segment:Vec<Segment>}\n Arc::new(Data{strings:toml::from_str(&read!(\"strings.toml\")).expect(\"strings\"),weapons:toml::from_str::<W>(&read!(\"weapons.toml\")).expect(\"weapons\").weapon,world:toml::from_str(&read!(\"world.toml\")).expect(\"world\"),contracts:toml::from_str::<C>(&read!(\"contracts.toml\")).expect(\"contracts\").contract,tapes:toml::from_str::<T>(&read!(\"tapes.toml\")).expect(\"tapes\").tape,attract:toml::from_str::<A>(&read!(\"attract.toml\")).expect(\"attract\").segment})}).clone()}\nimpl Data {pub fn s(&self,k:&str)->&str{self.strings.get(k).map(String::as_str).unwrap_or(k)} pub fn place(&self,k:&str)->&Place{self.world.place.iter().find(|p|p.id==k).expect(\"known place\")}}\n\n#[derive(Clone,Debug,PartialEq,Serialize,Deserialize)]\n#[serde(default)]\npub struct Tuning {pub enemy_accuracy:f32,pub enemy_damage:f32,pub player_damage:f32,pub detection:f32,pub enemy_count:f32,pub wear:f32,pub jam:f32,pub break_threshold:f32,pub spread_rate:f32,pub burn_time:f32,pub wind_strength:f32,pub burn_damage:f32,pub fever_interval:f32,pub fever_severity:f32,pub syrette_heal:f32,pub rescue_window:f32,pub vehicle_speed:f32,pub vehicle_toughness:f32,pub contract_pay:f32,pub reman_hours:f32,pub player_speed:f32,pub clock_speed:f32,pub time_scale:f32}\nimpl Default for Tuning {fn default()->Self{Self{enemy_accuracy:0.28,enemy_damage:1.,player_damage:1.,detection:1.,enemy_count:1.,wear:1.,jam:1.,break_threshold:8.,spread_rate:0.64,burn_time:8.,wind_strength:1.,burn_damage:20.,fever_interval:900.,fever_severity:1.,syrette_heal:60.,rescue_window:45.,vehicle_speed:1.,vehicle_toughness:1.,contract_pay:1.,reman_hours:24.,player_speed:1.,clock_speed:1.,time_scale:1.}}}\nimpl Tunable for Tuning {fn visit(&mut self,v:&mut dyn ParamVisitor){\n macro_rules! f {($n:ident,$min:expr,$max:expr,$h:literal)=>{v.float(stringify!($n),&mut self.$n,$min,$max,$h);};}\n f!(enemy_accuracy,0.,1.,\"Enemy accuracy\");f!(enemy_damage,0.,4.,\"Enemy damage\");f!(player_damage,0.1,5.,\"Player damage\");f!(detection,0.05,5.,\"Detection rate\");f!(enemy_count,0.5,2.,\"Enemy count\");f!(wear,0.,5.,\"Weapon wear\");f!(jam,0.,5.,\"Jam chance\");f!(break_threshold,0.,25.,\"Weapon break threshold\");f!(spread_rate,0.,2.,\"Fire spread rate\");f!(burn_time,2.,40.,\"Grass burn seconds\");f!(wind_strength,0.,3.,\"Wind strength\");f!(burn_damage,0.,60.,\"Burn damage per second\");f!(fever_interval,60.,1800.,\"Fever interval\");f!(fever_severity,0.,2.,\"Fever severity\");f!(syrette_heal,20.,100.,\"Syrette healing\");f!(rescue_window,10.,120.,\"Companion rescue window\");f!(vehicle_speed,0.25,3.,\"Vehicle speed\");f!(vehicle_toughness,0.25,4.,\"Vehicle toughness\");f!(contract_pay,0.25,3.,\"Contract pay\");f!(reman_hours,1.,72.,\"Post re-man hours\");f!(player_speed,0.5,3.,\"Player speed\");f!(clock_speed,0.1,10.,\"Game hours per minute\");f!(time_scale,0.1,8.,\"Time scale\");}}\npub fn flat(p:Vec3)->Vec2{Vec2::new(p.x,p.z)}\npub fn distance(a:Vec3,b:Vec3)->f32{flat(a-b).length()}\npub fn toward(a:Vec3,b:Vec3)->Vec2{flat(b-a).normalize_or_zero()}\nRS\ncat > engine/crates/pav_core/src/games/merc/terrain.rs <<'\"'RS'\nuse glam::{Vec2,Vec3};\nuse crate::{color::Color,terrain::TerrainPatch};\nuse super::data::{Data,flat};\npub fn hash(x:i32,z:i32,seed:u64)->f32 {let mut h=(x as u64).wrapping_mul(374761393)\"'^(z as u64).wrapping_mul(668265263)''^seed;h=(h''^(h>>13)).wrapping_mul(1274126177);((h''^(h>>16))&65535) as f32/65535.}\npub fn segment(p:Vec2,a:Vec2,b:Vec2)->f32{let d=b-a;(p-a-d*((p-a).dot(d)/d.length_squared().max(0.001)).clamp(0.,1.)).length()}\npub fn river_z(d:&Data,x:f32)->f32{let r=&d.world.river;for w in r.windows(2){if x>=w[0][0]&&x<=w[1][0]{let t=(x-w[0][0])/(w[1][0]-w[0][0]);return w[0][1]+(w[1][1]-w[0][1])*t;}}180.}\npub fn water(d:&Data,p:Vec2)->bool{(p.y-river_z(d,p.x)).abs()<14.&& !((p.x-40.).abs()<7.&&(p.y-40.).abs()<130.)}\npub fn road(d:&Data,p:Vec2)->f32{d.world.roads.iter().map(|r|segment(p,flat(d.world.place[r[0]].pos()),flat(d.world.place[r[1]].pos()))).fold(f32::MAX,f32::min)}\nfn base(x:f32,z:f32)->f32{3.+(x*0.008).sin()*3.+(z*0.011).cos()*2.+((x+z)*0.019).sin()*1.2+32.*(-((x-600.).powi(2)+(z+620.).powi(2))/180000.).exp()}\npub fn height(d:&Data,x:f32,z:f32)->f32{let p=Vec2::new(x,z);let mut h=base(x,z);let rz=river_z(d,x);let rd=(z-rz).abs();if rd<28.{h=h.min(-2.+(rd/28.).powi(2)*8.);}if (x-40.).abs()<7.&&(z-40.).abs()<130.{h=4.;}for q in &d.world.place{let dist=p.distance(Vec2::new(q.x,q.z));if dist<45.{let t=((dist-24.)/21.).clamp(0.,1.);h=base(q.x,q.z)+(h-base(q.x,q.z))*t;}}h}\npub fn fuel(d:&Data,x:i32,z:i32)->f32{let p=Vec2::new(x as f32*2.+1.,z as f32*2.+1.);if water(d,p)||road(d,p)<3.3||p.abs().max_element()>1020.{0.}else{1.+hash(x,z,4)*0.4}}\npub fn grass(d:&Data,p:Vec2)->f32{if road(d,p)<4.||water(d,p){0.}else{0.55+0.45*(p.x*0.07+p.y*0.03).sin().abs()}}\npub fn color(d:&Data,x:f32,z:f32)->Color{let p=Vec2::new(x,z);if road(d,p)<3.8{Color::hex(\"#a4552f\")}else if (z-river_z(d,x)).abs()<35.{Color::hex(\"#6e7840\")}else {let c=Color::hex(\"#b99b58\");let b=0.84+hash(x as i32/3,z as i32/3,17)*0.3;Color([c.0[0]*b,c.0[1]*b,c.0[2]*b])}}\npub fn patch(d:&Data,cx:i32,cz:i32,step:usize)->TerrainPatch{let mut m=TerrainPatch::default();m.cx=cx;m.cz=cz;m.min=Vec3::new(cx as f32*32.,-10.,cz as f32*32.);m.max=m.min+Vec3::new(32.,80.,32.);let n=32/step;for z in 0..=n{for x in 0..=n{let wx=cx as f32*32.+(x*step) as f32;let wz=cz as f32*32.+(z*step) as f32;let h=height(d,wx,wz);m.positions.push([wx,h,wz]);let normal=Vec3::new(height(d,wx-0.5,wz)-height(d,wx+0.5,wz),1.,height(d,wx,wz-0.5)-height(d,wx,wz+0.5)).normalize();m.normals.push(normal.to_array());m.colors.push(color(d,wx,wz).0);}}for z in 0..n{for x in 0..n{let i=(z*(n+1)+x) as u32;let row=(n+1) as u32;m.indices.extend([i,i+row,i+1,i+1,i+row,i+row+1]);}}m}\nRS\ncat > engine/crates/pav_core/src/games/merc/fire.rs <<'\"'RS'\nuse std::collections::BTreeMap;\nuse glam::Vec2;\nuse serde::{Serialize,Deserialize};\nuse crate::rng::Rng;\nuse super::{data::{Data,Tuning},terrain};\n#[derive(Clone,Debug,Serialize,Deserialize)]pub struct Cell{pub state:u8,pub time:f32}\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]pub struct Fire {pub cells:BTreeMap<(i32,i32),Cell>,pub accum:f32,pub total:u32,pub version:u32,pub cut:BTreeMap<(i32,i32),f32>}\nimpl Fire {\n pub fn key(p:Vec2)->(i32,i32){((p.x/2.).floor() as i32,(p.y/2.).floor() as i32)}\n pub fn at(&self,p:Vec2)->u8{self.cells.get(&Self::key(p)).map_or(0,|c|c.state)}\n pub fn ignite(&mut self,d:&Data,p:Vec2,r:f32){let (x,z)=Self::key(p);let n=(r/2.).ceil() as i32;for dz in -n..=n{for dx in -n..=n{if (dx*dx+dz*dz) as f32>(r/2.).powi(2)+0.5{continue;}self.light(d,(x+dx,z+dz));}}}\n fn light(&mut self,d:&Data,k:(i32,i32)){if terrain::fuel(d,k.0,k.1)>0.&& \"'!self.cells.contains_key(&k)&& !self.cut.contains_key(&k){self.cells.insert(k,Cell{state:1,time:0.});self.total+=1;self.version+=1;}}\n pub fn step(&mut self,d:&Data,rng:&mut Rng,t:&Tuning,wind:Vec2,speed:f32,rain:bool,dt:f32){self.accum+=dt;if self.accum<0.25{return;}let dt=self.accum;self.accum=0.;if rain{for c in self.cells.values_mut(){if c.state==1{c.state=2;c.time=0.;}}self.version+=1;return;}let mut ignite=Vec::new();let mut expired=Vec::new();for (&(x,z),c) in &mut self.cells{c.time+=dt;if c.state==2{if c.time>2880.{expired.push((x,z));}continue;}if c.time>t.burn_time*(0.8+terrain::hash(x,z,3)*0.4){c.state=2;c.time=0.;self.version+=1;continue;}for dz in -1..=1{for dx in -1..=1{if dx==0&&dz==0{continue;}let dir=Vec2::new(dx as f32,dz as f32).normalize();let factor=(0.24*dir.dot(wind)*speed*t.wind_strength).exp();let slope=(terrain::height(d,(x+dx) as f32*2.,(z+dz) as f32*2.)-terrain::height(d,x as f32*2.,z as f32*2.)).clamp(-2.,2.);let chance=t.spread_rate*factor*(1.+slope*0.12)*dt/(dx*dx+dz*dz) as f32;if rng.f32()<chance{ignite.push((x+dx,z+dz));}}}if speed>8.&&rng.f32()<0.015{let n=rng.range(3.,7.);ignite.push((x+(wind.x*n).round() as i32,z+(wind.y*n).round() as i32));}}for k in expired{self.cells.remove(&k);self.version+=1;}for k in ignite{self.light(d,k);}self.cut.retain(|_,time|{*time+=dt;*time<2880.});}\n pub fn burning(&self)->usize{self.cells.values().filter(|c|c.state==1).count()}\n pub fn smoke(&self,a:Vec2,b:Vec2)->bool{let dist=a.distance(b);let n=(dist/3.).ceil().max(1.) as usize;(0..=n).filter(|i|self.at(a.lerp(b,*i as f32/n as f32))==1).count()>3}\n}\nRS\ncat > engine/crates/pav_core/src/games/merc/weapons.rs <<'\"'RS'\nuse serde::{Serialize,Deserialize};\nuse super::data::WeaponDef;\n#[derive(Clone,Debug,Serialize,Deserialize)]pub struct Gun{pub def:usize,pub ammo:i32,pub reserve:i32,pub condition:f32,pub jammed:bool,pub broken:bool,pub cooldown:f32}\nimpl Gun{pub fn new(i:usize,d:&WeaponDef,c:f32)->Self{Self{def:i,ammo:d.mag,reserve:d.reserve,condition:c,jammed:false,broken:false,cooldown:0.}}pub fn word(&self)->&'static str{match self.condition as i32{71..=100=>\\\"New\\\",51..=70=>\\\"Used\\\",31..=50=>\\\"Worn\\\",9..=30=>\\\"Rusted\\\",_=>\\\"Dying\\\"}}}\npub fn jam_chance(c:f32)->f32 {if c>=70.{0.}else{0.22*((70.-c)/70.).powi(2)}}\npub fn zone(mult:f32,damage:f32)->f32{damage*mult}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/merc/data.rs <<'RS'\nuse std::{collections::BTreeMap, sync::{Arc, OnceLock}};\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse crate::params::{ParamVisitor, Tunable};\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct WeaponDef { pub id:String, pub slot:usize, pub name:String, pub mag:i32, pub reserve:i32, pub rpm:f32, pub damage:f32, pub range:f32, pub wear:f32, pub noise:f32, pub igniter:u8 }\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Place { pub id:String, pub name:String, pub x:f32, pub z:f32, pub kind:u8 }\nimpl Place {pub fn pos(&self)->Vec3 {Vec3::new(self.x,0.,self.z)} }\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct GoalDef {pub kind:String,pub place:String,pub value:f32}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Contract {pub id:String,pub name:String,pub giver:String,pub brief:String,pub pay:i32,pub index:usize,pub goal:Vec<GoalDef>}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Tape {pub place:String,pub name:String,pub lines:Vec<String>}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Segment {pub name:String,pub seconds:f32,pub place:String,pub hour:f32,pub action:String}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct World {pub size:f32,pub river:Vec<[f32;2]>,pub roads:Vec<[usize;2]>,pub place:Vec<Place>}\n#[derive(Clone, Debug)]\npub struct Data {pub strings:BTreeMap<String,String>,pub weapons:Vec<WeaponDef>,pub world:World,pub contracts:Vec<Contract>,pub tapes:Vec<Tape>,pub attract:Vec<Segment>}\nmacro_rules\"'! read {($name:literal)=>{{let baked=include_str!(concat!(\"../../../../../game/merc/\",$name));#[cfg(not(target_arch=\"wasm32\"))] let text=std::fs::read_to_string(concat!(\"game/merc/\",$name)).unwrap_or_else(|_|baked.into());#[cfg(target_arch=\"wasm32\")] let text=baked.to_string();text}};}\npub fn data()->Arc<Data>{static D:OnceLock<Arc<Data>>=OnceLock::new();D.get_or_init(||{\n #[derive(Deserialize)]struct W{weapon:Vec<WeaponDef>}\n #[derive(Deserialize)]struct C{contract:Vec<Contract>}\n #[derive(Deserialize)]struct T{tape:Vec<Tape>}\n #[derive(Deserialize)]struct A{segment:Vec<Segment>}\n Arc::new(Data{strings:toml::from_str(&read!(\"strings.toml\")).expect(\"strings\"),weapons:toml::from_str::<W>(&read!(\"weapons.toml\")).expect(\"weapons\").weapon,world:toml::from_str(&read!(\"world.toml\")).expect(\"world\"),contracts:toml::from_str::<C>(&read!(\"contracts.toml\")).expect(\"contracts\").contract,tapes:toml::from_str::<T>(&read!(\"tapes.toml\")).expect(\"tapes\").tape,attract:toml::from_str::<A>(&read!(\"attract.toml\")).expect(\"attract\").segment})}).clone()}\nimpl Data {pub fn s(&self,k:&str)->&str{self.strings.get(k).map(String::as_str).unwrap_or(k)} pub fn place(&self,k:&str)->&Place{self.world.place.iter().find(|p|p.id==k).expect(\"known place\")}}\n\n#[derive(Clone,Debug,PartialEq,Serialize,Deserialize)]\n#[serde(default)]\npub struct Tuning {pub enemy_accuracy:f32,pub enemy_damage:f32,pub player_damage:f32,pub detection:f32,pub enemy_count:f32,pub wear:f32,pub jam:f32,pub break_threshold:f32,pub spread_rate:f32,pub burn_time:f32,pub wind_strength:f32,pub burn_damage:f32,pub fever_interval:f32,pub fever_severity:f32,pub syrette_heal:f32,pub rescue_window:f32,pub vehicle_speed:f32,pub vehicle_toughness:f32,pub contract_pay:f32,pub reman_hours:f32,pub player_speed:f32,pub clock_speed:f32,pub time_scale:f32}\nimpl Default for Tuning {fn default()->Self{Self{enemy_accuracy:0.28,enemy_damage:1.,player_damage:1.,detection:1.,enemy_count:1.,wear:1.,jam:1.,break_threshold:8.,spread_rate:0.64,burn_time:8.,wind_strength:1.,burn_damage:20.,fever_interval:900.,fever_severity:1.,syrette_heal:60.,rescue_window:45.,vehicle_speed:1.,vehicle_toughness:1.,contract_pay:1.,reman_hours:24.,player_speed:1.,clock_speed:1.,time_scale:1.}}}\nimpl Tunable for Tuning {fn visit(&mut self,v:&mut dyn ParamVisitor){\n macro_rules! f {($n:ident,$min:expr,$max:expr,$h:literal)=>{v.float(stringify!($n),&mut self.$n,$min,$max,$h);};}\n f!(enemy_accuracy,0.,1.,\"Enemy accuracy\");f!(enemy_damage,0.,4.,\"Enemy damage\");f!(player_damage,0.1,5.,\"Player damage\");f!(detection,0.05,5.,\"Detection rate\");f!(enemy_count,0.5,2.,\"Enemy count\");f!(wear,0.,5.,\"Weapon wear\");f!(jam,0.,5.,\"Jam chance\");f!(break_threshold,0.,25.,\"Weapon break threshold\");f!(spread_rate,0.,2.,\"Fire spread rate\");f!(burn_time,2.,40.,\"Grass burn seconds\");f!(wind_strength,0.,3.,\"Wind strength\");f!(burn_damage,0.,60.,\"Burn damage per second\");f!(fever_interval,60.,1800.,\"Fever interval\");f!(fever_severity,0.,2.,\"Fever severity\");f!(syrette_heal,20.,100.,\"Syrette healing\");f!(rescue_window,10.,120.,\"Companion rescue window\");f!(vehicle_speed,0.25,3.,\"Vehicle speed\");f!(vehicle_toughness,0.25,4.,\"Vehicle toughness\");f!(contract_pay,0.25,3.,\"Contract pay\");f!(reman_hours,1.,72.,\"Post re-man hours\");f!(player_speed,0.5,3.,\"Player speed\");f!(clock_speed,0.1,10.,\"Game hours per minute\");f!(time_scale,0.1,8.,\"Time scale\");}}\npub fn flat(p:Vec3)->Vec2{Vec2::new(p.x,p.z)}\npub fn distance(a:Vec3,b:Vec3)->f32{flat(a-b).length()}\npub fn toward(a:Vec3,b:Vec3)->Vec2{flat(b-a).normalize_or_zero()}\nRS\ncat > engine/crates/pav_core/src/games/merc/terrain.rs <<'\"'RS'\nuse glam::{Vec2,Vec3};\nuse crate::{color::Color,terrain::TerrainPatch};\nuse super::data::{Data,flat};\npub fn hash(x:i32,z:i32,seed:u64)->f32 {let mut h=(x as u64).wrapping_mul(374761393)\"'^(z as u64).wrapping_mul(668265263)''^seed;h=(h''^(h>>13)).wrapping_mul(1274126177);((h''^(h>>16))&65535) as f32/65535.}\npub fn segment(p:Vec2,a:Vec2,b:Vec2)->f32{let d=b-a;(p-a-d*((p-a).dot(d)/d.length_squared().max(0.001)).clamp(0.,1.)).length()}\npub fn river_z(d:&Data,x:f32)->f32{let r=&d.world.river;for w in r.windows(2){if x>=w[0][0]&&x<=w[1][0]{let t=(x-w[0][0])/(w[1][0]-w[0][0]);return w[0][1]+(w[1][1]-w[0][1])*t;}}180.}\npub fn water(d:&Data,p:Vec2)->bool{(p.y-river_z(d,p.x)).abs()<14.&& !((p.x-40.).abs()<7.&&(p.y-40.).abs()<130.)}\npub fn road(d:&Data,p:Vec2)->f32{d.world.roads.iter().map(|r|segment(p,flat(d.world.place[r[0]].pos()),flat(d.world.place[r[1]].pos()))).fold(f32::MAX,f32::min)}\nfn base(x:f32,z:f32)->f32{3.+(x*0.008).sin()*3.+(z*0.011).cos()*2.+((x+z)*0.019).sin()*1.2+32.*(-((x-600.).powi(2)+(z+620.).powi(2))/180000.).exp()}\npub fn height(d:&Data,x:f32,z:f32)->f32{let p=Vec2::new(x,z);let mut h=base(x,z);let rz=river_z(d,x);let rd=(z-rz).abs();if rd<28.{h=h.min(-2.+(rd/28.).powi(2)*8.);}if (x-40.).abs()<7.&&(z-40.).abs()<130.{h=4.;}for q in &d.world.place{let dist=p.distance(Vec2::new(q.x,q.z));if dist<45.{let t=((dist-24.)/21.).clamp(0.,1.);h=base(q.x,q.z)+(h-base(q.x,q.z))*t;}}h}\npub fn fuel(d:&Data,x:i32,z:i32)->f32{let p=Vec2::new(x as f32*2.+1.,z as f32*2.+1.);if water(d,p)||road(d,p)<3.3||p.abs().max_element()>1020.{0.}else{1.+hash(x,z,4)*0.4}}\npub fn grass(d:&Data,p:Vec2)->f32{if road(d,p)<4.||water(d,p){0.}else{0.55+0.45*(p.x*0.07+p.y*0.03).sin().abs()}}\npub fn color(d:&Data,x:f32,z:f32)->Color{let p=Vec2::new(x,z);if road(d,p)<3.8{Color::hex(\"#a4552f\")}else if (z-river_z(d,x)).abs()<35.{Color::hex(\"#6e7840\")}else {let c=Color::hex(\"#b99b58\");let b=0.84+hash(x as i32/3,z as i32/3,17)*0.3;Color([c.0[0]*b,c.0[1]*b,c.0[2]*b])}}\npub fn patch(d:&Data,cx:i32,cz:i32,step:usize)->TerrainPatch{let mut m=TerrainPatch::default();m.cx=cx;m.cz=cz;m.min=Vec3::new(cx as f32*32.,-10.,cz as f32*32.);m.max=m.min+Vec3::new(32.,80.,32.);let n=32/step;for z in 0..=n{for x in 0..=n{let wx=cx as f32*32.+(x*step) as f32;let wz=cz as f32*32.+(z*step) as f32;let h=height(d,wx,wz);m.positions.push([wx,h,wz]);let normal=Vec3::new(height(d,wx-0.5,wz)-height(d,wx+0.5,wz),1.,height(d,wx,wz-0.5)-height(d,wx,wz+0.5)).normalize();m.normals.push(normal.to_array());m.colors.push(color(d,wx,wz).0);}}for z in 0..n{for x in 0..n{let i=(z*(n+1)+x) as u32;let row=(n+1) as u32;m.indices.extend([i,i+row,i+1,i+1,i+row,i+row+1]);}}m}\nRS\ncat > engine/crates/pav_core/src/games/merc/fire.rs <<'\"'RS'\nuse std::collections::BTreeMap;\nuse glam::Vec2;\nuse serde::{Serialize,Deserialize};\nuse crate::rng::Rng;\nuse super::{data::{Data,Tuning},terrain};\n#[derive(Clone,Debug,Serialize,Deserialize)]pub struct Cell{pub state:u8,pub time:f32}\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]pub struct Fire {pub cells:BTreeMap<(i32,i32),Cell>,pub accum:f32,pub total:u32,pub version:u32,pub cut:BTreeMap<(i32,i32),f32>}\nimpl Fire {\n pub fn key(p:Vec2)->(i32,i32){((p.x/2.).floor() as i32,(p.y/2.).floor() as i32)}\n pub fn at(&self,p:Vec2)->u8{self.cells.get(&Self::key(p)).map_or(0,|c|c.state)}\n pub fn ignite(&mut self,d:&Data,p:Vec2,r:f32){let (x,z)=Self::key(p);let n=(r/2.).ceil() as i32;for dz in -n..=n{for dx in -n..=n{if (dx*dx+dz*dz) as f32>(r/2.).powi(2)+0.5{continue;}self.light(d,(x+dx,z+dz));}}}\n fn light(&mut self,d:&Data,k:(i32,i32)){if terrain::fuel(d,k.0,k.1)>0.&& \"'!self.cells.contains_key(&k)&& !self.cut.contains_key(&k){self.cells.insert(k,Cell{state:1,time:0.});self.total+=1;self.version+=1;}}\n pub fn step(&mut self,d:&Data,rng:&mut Rng,t:&Tuning,wind:Vec2,speed:f32,rain:bool,dt:f32){self.accum+=dt;if self.accum<0.25{return;}let dt=self.accum;self.accum=0.;if rain{for c in self.cells.values_mut(){if c.state==1{c.state=2;c.time=0.;}}self.version+=1;return;}let mut ignite=Vec::new();let mut expired=Vec::new();for (&(x,z),c) in &mut self.cells{c.time+=dt;if c.state==2{if c.time>2880.{expired.push((x,z));}continue;}if c.time>t.burn_time*(0.8+terrain::hash(x,z,3)*0.4){c.state=2;c.time=0.;self.version+=1;continue;}for dz in -1..=1{for dx in -1..=1{if dx==0&&dz==0{continue;}let dir=Vec2::new(dx as f32,dz as f32).normalize();let factor=(0.24*dir.dot(wind)*speed*t.wind_strength).exp();let slope=(terrain::height(d,(x+dx) as f32*2.,(z+dz) as f32*2.)-terrain::height(d,x as f32*2.,z as f32*2.)).clamp(-2.,2.);let chance=t.spread_rate*factor*(1.+slope*0.12)*dt/(dx*dx+dz*dz) as f32;if rng.f32()<chance{ignite.push((x+dx,z+dz));}}}if speed>8.&&rng.f32()<0.015{let n=rng.range(3.,7.);ignite.push((x+(wind.x*n).round() as i32,z+(wind.y*n).round() as i32));}}for k in expired{self.cells.remove(&k);self.version+=1;}for k in ignite{self.light(d,k);}self.cut.retain(|_,time|{*time+=dt;*time<2880.});}\n pub fn burning(&self)->usize{self.cells.values().filter(|c|c.state==1).count()}\n pub fn smoke(&self,a:Vec2,b:Vec2)->bool{let dist=a.distance(b);let n=(dist/3.).ceil().max(1.) as usize;(0..=n).filter(|i|self.at(a.lerp(b,*i as f32/n as f32))==1).count()>3}\n}\nRS\ncat > engine/crates/pav_core/src/games/merc/weapons.rs <<'\"'RS'\nuse serde::{Serialize,Deserialize};\nuse super::data::WeaponDef;\n#[derive(Clone,Debug,Serialize,Deserialize)]pub struct Gun{pub def:usize,pub ammo:i32,pub reserve:i32,pub condition:f32,pub jammed:bool,pub broken:bool,pub cooldown:f32}\nimpl Gun{pub fn new(i:usize,d:&WeaponDef,c:f32)->Self{Self{def:i,ammo:d.mag,reserve:d.reserve,condition:c,jammed:false,broken:false,cooldown:0.}}pub fn word(&self)->&'static str{match self.condition as i32{71..=100=>\\\"New\\\",51..=70=>\\\"Used\\\",31..=50=>\\\"Worn\\\",9..=30=>\\\"Rusted\\\",_=>\\\"Dying\\\"}}}\npub fn jam_chance(c:f32)->f32 {if c>=70.{0.}else{0.22*((70.-c)/70.).powi(2)}}\npub fn zone(mult:f32,damage:f32)->f32{damage*mult}\nRS\"","aggregated_output":"","exit_code":0,"status":"completed"}}
