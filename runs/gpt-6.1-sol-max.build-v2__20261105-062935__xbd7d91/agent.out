put.buttons();\n        // Touch: the stick, the buttons and auto-attack.\n        let touch_game = curr.game.as_deref().filter(|_| game_input).map(|g| (g, feet, facing));\n        let rig = &self.rig;\n        let intent = self.touch.intent(touch_game, |v| rig.relative_move(v), self.prefs.auto_attack);\n        if game_input {\n            held |= intent.held;\n            pressed |= intent.pressed;\n        }\n        if pressed & pav_core::input::buttons::INTERACT != 0 {\n            if let Some(g) = &curr.game {\n                if let Some(c) = self.game_ui.interact(g) {\n                    host.shared.command(c);\n                }\n            }\n        }\n        if pressed != 0 && self.input.last_device == Device::Gamepad {\n            // Gamepad presses are timed from when they were polled (gilrs queues them).\n            self.latency.press();\n        }\n        let room_id = self.hud.current.as_ref().map(|r| r.id);\n        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n        if left_tap && !self.editor.on && game_input {\n            pressed |= pav_core::input::buttons::PRIMARY;\n        }\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + Send + 'static) {\n        let _ = self.tx.send(Cmd::Run(Box::new(f)));\n    }\n\n    /// Runs `f` on the simulation thread and waits for its result.\n    pub fn query<R: Send + 'static>(&self, f: impl FnOnce(&mut Sim) -> R + Send + 'static) -> Option<R> {\n        let (rtx, rrx) = std::sync::mpsc::channel();\n        self.exec(move |sim| {\n            let _ = rtx.send(f(sim));\n        });\n        rrx.recv_timeout(Duration::from_secs(5)).ok()\n    }\n\n    /// Advances the simulation (the thread does this by itself natively).\n    pub fn pump(&self) {}\n}\n\n#[cfg(target_arch = \"wasm32\")]\nimpl SimHost {\n    pub fn start(mut sim: Sim) -> Self {\n        let shared = shared_for(&mut sim);\n        Self { sim: std::cell::RefCell::new(sim), clock: std::cell::RefCell::new(Clock::new()), shared }\n    }\n\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + 'static) {\n        let mut sim = self.sim.borrow_mut();\n        f(&mut sim);\n        let dt = sim.dt();\n        publish(&mut sim, &self.shared, dt, Instant::now());\n    }\n","exit_code":0,"status":"completed"}}
