{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_view/src/merc/mod.rs <<'RS'\n//\"'! The first-person world uses Pavilion'\"'s primitives, capsule puppets, native key poses and IK.\nuse std::{collections::BTreeMap,sync::Arc};\nuse glam::{Mat4,Quat,Vec2,Vec3};\nuse pav_core::{games::merc::{Merc,data::{distance,flat},terrain},puppet::{PuppetDef,BodyPlan},rig::{Chain,ChainKind},clips};\nuse pav_render::{Scene,mesh::{MeshData,Vertex},scene::{MeshKey,MeshInstance,SdfInstance,Style,flags,PointLight},text::{Text3d,Anchor}};\nuse crate::{CameraRig,camera::FpCam,assets::{emit_asset,Placement}};\nfn c(h:&str)->Vec3{pav_render::scene::hex(h).unwrap()}\nfn part(scene:&mut Scene,key:MeshKey,pos:Vec3,size:Vec3,rot:Quat,color:Vec3,fl:u32,em:f32){scene.meshes.push(MeshInstance{mesh:key,transform:Mat4::from_scale_rotation_translation(size,rot,pos),color,style:if fl&flags::NO_FOG\"'!=0&&em>0.{Style::Unlit}else{Style::Cel},emissive:em,flags:fl,group:if fl&flags::OBJECT!=0{60001}else{1},material:0,ext:Vec3::ZERO});}\nfn line(scene:&mut Scene,a:Vec3,b:Vec3,r:f32,color:Vec3,fl:u32){let d=b-a;part(scene,MeshKey::Cylinder,(a+b)*0.5,Vec3::new(r*2.,d.length(),r*2.),Quat::from_rotation_arc(Vec3::Y,d.normalize_or_zero()),color,fl,0.);}\nfn asset(scene:&mut Scene,name:&str,p:Vec3,q:Quat,scale:f32,id:u32){let _=emit_asset(scene,&format!(\"LIB/merc/{name}\"),Placement::at(p).rot(q).scale(scale).id(id),0,&BTreeMap::new());}\n#[derive(Default)]pub struct MercView{coarse:Option<Arc<MeshData>>,rag:Option<Chain>,last:f32}\npub fn rig(g:&Merc,base:&CameraRig)->CameraRig{let mut rig=base.clone();let mut eye=g.eye_pos();let mut yaw=g.yaw;let mut pitch=g.pitch;let mut fov=if g.monocular{18.}else if g.aiming{55.}else{g.settings.fov};let mut roll=0.;\n let shell=!matches!(g.screen.as_str(),\"playing\"|\"ending_defend\"|\"companion\"|\"evacuate\")&&!g.attracting&&!g.session;\n if shell {let d=&g.data;eye=Vec3::new(-104.,terrain::height(d,-104.,745.)+7.,745.);yaw=-0.22;pitch=-0.05;fov=65.;}\n if g.attracting {if g.attract_segment==0||g.attract_segment==3||g.attract_segment==9{eye+=Vec3::new(15.,9.,5.);pitch=-0.18;}}\n if let Some(i)=g.riding {if let Some(v)=g.vehicles.get(i){if g.chase{eye=v.pos-Vec3::new(v.yaw.sin(),0.,-v.yaw.cos())*7.+Vec3::Y*3.;yaw=v.yaw;pitch=-0.12;}else{eye=v.pos+Quat::from_rotation_y(-v.yaw)*Vec3::new(-0.42,1.85,-0.5);if g.seat==1{eye=v.pos+Vec3::Y*2.8;}roll=v.roll*0.3;}}}\n if g.rescue_time>0.{eye=g.pos+Vec3::Y*0.4;pitch=0.7;roll=(g.view_time*5.).sin()*0.06;}\n if g.fever_state==2{roll+=(g.view_time*1.8).sin()*0.05*g.settings.motion;fov+=(g.view_time*2.).sin()*3.*g.settings.motion;}\n if g.speed>0.2&&!shell&&g.riding.is_none(){eye.y+=(g.view_time*9.).sin()*0.025*g.settings.bob;}\n rig.fp=Some(FpCam{eye,yaw,pitch,roll,fov,near:0.06,far:3000.});rig.target=eye+rig.forward()*40.;rig}\nimpl MercView{\n pub fn draw(&mut self,scene:&mut Scene,g:&Merc,rig:&CameraRig){let dt=(g.view_time-self.last).clamp(0.001,0.05);self.last=g.view_time;let eye=scene.camera.eye;let day=(g.hour-6.)/12.*std::f32::consts::PI;let sun_h=day.sin();let night=sun_h<0.;let dusk=sun_h.abs()<0.3;\n let zen=if night{c(\"#101b2a\")}else if dusk{c(\"#6a758a\")}else{c(\"#9dbbd0\")};let horizon=if night{c(\"#313a42\")}else if dusk{c(\"#e8b37c\")}else{c(\"#e8d3ad\")};scene.clear_color=horizon;scene.fog=pav_render::scene::Fog{enabled:true,center:eye,start:140.,end:720.,color:horizon};scene.sun.direction=Vec3::new(-0.65,-sun_h.abs().max(0.10),-0.4).normalize();scene.sun.color=if night{Vec3::new(0.16,0.23,0.32)}else{Vec3::new(1.05,0.83,0.56)};scene.sun.shadow_radius=110.;scene.sun.shadow_center=eye+rig.forward()*36.;scene.ambient.sky=if night{Vec3::new(0.16,0.20,0.27)}else{Vec3::new(0.60,0.58,0.48)};scene.ambient.ground=if night{Vec3::new(0.10,0.12,0.14)}else{Vec3::new(0.34,0.30,0.22)};scene.style.cel_bands=3.;scene.style.rim=0.06;scene.cutaway=Default::default();scene.post.outline_part=pav_render::scene::Part::Objects;scene.post.outline_px=1.3;scene.post.bloom=0.35;scene.post.haze=if night{0.03}else{0.14};scene.post.haze_height=12.;scene.post.haze_base=0.;scene.post.shafts=0.5;scene.post.saturation=0.90;scene.filter.temperature=0.10;scene.filter.contrast=1.08;scene.filter.vignette=0.18;scene.filter.grain=0.025;scene.filter.brightness=g.settings.brightness;scene.wind.direction=g.wind;scene.wind.strength=g.wind_speed*0.11;scene.wind.gusts=0.7;scene.wind.pusher=g.pos;scene.wind.push_radius=1.;\n if g.health<20.{scene.post.saturation=0.35;scene.filter.vignette=0.4;}if g.fever_state>0{scene.filter.temperature+=0.08;scene.filter.chroma=g.settings.motion*0.4;}\n // Vertex-coloured dome: a visible horizon, without the engine fog erasing it.\n let mut sky=MeshData::default();let rings=12;let seg=48;for j in 0..=rings{let t=j as f32/rings as f32;let a=t*std::f32::consts::FRAC_PI_2;for i in 0..=seg{let b=i as f32/seg as f32*std::f32::consts::TAU;let p=eye+Vec3::new(b.cos()*a.cos(),a.sin()-0.04,b.sin()*a.cos())*1800.;let col=horizon.lerp(zen,t.powf(0.45));sky.vertices.push(Vertex{pos:p.to_array(),normal:[0.,-1.,0.],uv:[0.,0.],color:[col.x,col.y,col.z,1.]});}}for j in 0..rings{for i in 0..seg{let n=(j*(seg+1)+i) as u32;let row=(seg+1) as u32;sky.indices.extend([n,n+1,n+row,n+1,n+row+1,n+row]);}}scene.dynamic.push(pav_render::scene::DynamicMesh{data:sky,color:Vec3::ONE,emissive:1.,style:Style::Unlit,flags:flags::NO_FOG|flags::NO_SHADOW|flags::TWO_SIDED,group:0,material:0});\n let sun=eye+Vec3::new(-0.7,sun_h.abs().max(0.05),-0.45).normalize()*1500.;part(scene,MeshKey::Sphere,sun,Vec3::splat(if night{25.}else{38.}),Quat::IDENTITY,if night{c(\"#c6d4d2\")}else{c(\"#ffe2a0\")},flags::NO_FOG|flags::NO_SHADOW,2.);\n if night{for i in 0..90{let x=terrain::hash(i,4,11)*2.-1.;let y=terrain::hash(i,5,11);let z=terrain::hash(i,6,11)*2.-1.;part(scene,MeshKey::Sphere,eye+Vec3::new(x,y,z).normalize()*1700.,Vec3::splat(1.6),Quat::IDENTITY,c(\"#b4bdc7\"),flags::NO_FOG|flags::NO_SHADOW,1.);}}\n for i in 0..20{let angle=i as f32*0.314;let p=Vec3::new(angle.cos()*1350.,30.,angle.sin()*1350.);part(scene,MeshKey::Cone,p,Vec3::new(370.,170.+(i%4) as f32*35.,260.),Quat::IDENTITY,horizon*0.53,flags::NO_FOG,0.);}\n if self.coarse.is_none(){let mut mesh=MeshData::default();for z in 0..=128{for x in 0..=128{let wx=x as f32*16.-1024.;let wz=z as f32*16.-1024.;let col=terrain::color(&g.data,wx,wz).0;mesh.vertices.push(Vertex{pos:[wx,terrain::height(&g.data,wx,wz)-0.25,wz],normal:[0.,1.,0.],uv:[0.,0.],color:[col[0],col[1],col[2],1.]});}}for z in 0..128{for x in 0..128{let n=(z*129+x) as u32;mesh.indices.extend([n,n+129,n+1,n+1,n+129,n+130]);}}self.coarse=Some(Arc::new(mesh));}\n scene.custom_meshes.push((MeshKey::Custom(0x7fff001),self.coarse.as_ref().unwrap().clone()));part(scene,MeshKey::Custom(0x7fff001),Vec3::ZERO,Vec3::ONE,Quat::IDENTITY,Vec3::ONE,0,0.);\n // River ribbons follow the carved channel.\n for w in g.data.world.river.windows(2){let a=Vec3::new(w[0][0],0.,w[0][1]);let b=Vec3::new(w[1][0],0.,w[1][1]);let delta=b-a;part(scene,MeshKey::Cube,(a+b)*0.5,Vec3::new(27.,0.12,delta.length()+4.),Quat::from_rotation_y(delta.x.atan2(delta.z)),c(\"#3d6a6a\"),flags::NO_SHADOW,0.1);}\n // Vegetation is derived from the same terrain function that gives stealth cover.\n let cx=(eye.x/18.).floor() as i32;let cz=(eye.z/18.).floor() as i32;for z in cz-19..=cz+19{for x in cx-19..=cx+19{let h=terrain::hash(x,z,g.seed);if h<0.31{let wx=x as f32*18.+terrain::hash(x,z,4)*12.;let wz=z as f32*18.+terrain::hash(x,z,5)*12.;let p=Vec3::new(wx,terrain::height(&g.data,wx,wz),wz);if terrain::road(&g.data,flat(p))>8.&&!terrain::water(&g.data,flat(p))&&g.fire.at(flat(p))!=2{asset(scene,if h<0.025{\"baobab\"}else{\"acacia\"},p,Quat::from_rotation_y(h*20.),0.65+h*1.8,(x*199+z*37).unsigned_abs()+2000);}}}}\n let gx=(eye.x/2.).floor() as i32;let gz=(eye.z/2.).floor() as i32;for z in gz-32..=gz+32{for x in gx-32..=gx+32{let wx=x as f32*2.+terrain::hash(x,z,3)*1.8;let wz=z as f32*2.+terrain::hash(x,z,5)*1.8;let p=Vec3::new(wx,terrain::height(&g.data,wx,wz),wz);let d=distance(p,eye);if d>66.||terrain::grass(&g.data,flat(p))<0.5||g.fire.at(flat(p))==2{continue;}let h=0.6+terrain::hash(x,z,6)*0.7;let color=c(\"#c9a24b\")*(0.75+terrain::hash(x,z,8)*0.5);part(scene,MeshKey::Tuft,p+Vec3::Y*h*0.48,Vec3::new(1.7,h,1.7),Quat::from_rotation_y(terrain::hash(x,z,9)*6.),color,flags::GRASS|flags::TWO_SIDED,0.);}}\n self.compounds(scene,g);\n for (i,o) in g.objects.iter().enumerate(){if distance(o.pos,eye)<500.{asset(scene,if o.kind==1{\"tank\"}else{\"fuel_drum\"},o.pos,Quat::IDENTITY,1.,3000+i as u32);if o.exploded{part(scene,MeshKey::Sphere,o.pos+Vec3::Y*3.,Vec3::new(5.,7.,5.),Quat::IDENTITY,c(\"#292b29\"),flags::NO_SHADOW,0.);}}}\n for (i,v) in g.vehicles.iter().enumerate(){if distance(v.pos,eye)<350.{let q=Quat::from_rotation_y(-v.yaw)*Quat::from_rotation_x(v.pitch)*Quat::from_rotation_z(v.roll);asset(scene,[\"technical\",\"jeep\",\"truck\",\"boat\"][v.kind as usize],v.pos,q,1.,4000+i as u32);if v.hp<70.{let color=if v.hp<40.{c(\"#30352f\")}else{c(\"#aaa898\")};for k in 0..3{let t=(g.view_time*0.5+k as f32*0.3).fract();part(scene,MeshKey::Sphere,v.pos+Vec3::new(0.,1.6+t*3.,-1.5),Vec3::splat(0.4+t),Quat::IDENTITY,color,flags::NO_SHADOW,0.);}}if night{scene.point_lights.push(PointLight{position:v.pos+Vec3::new(0.,1.2,-3.),color:Vec3::new(2.,1.6,0.7),radius:25.,shadows:false});}}}\n for cache in &g.caches{if !cache.found&&distance(cache.pos,eye)<60.{part(scene,MeshKey::Cube,cache.pos+Vec3::Y*0.25,Vec3::new(0.8,0.4,0.5),Quat::IDENTITY,c(\"#66694d\"),flags::OBJECT,0.);}}\n for (i,n) in g.soldiers.iter().enumerate(){if n.hp<=0.&&distance(n.pos,eye)<95.{part(scene,MeshKey::Cube,n.pos+Vec3::Y*0.2,Vec3::new(0.5,0.3,1.5),Quat::from_rotation_y(n.yaw),c(\"#59603c\"),flags::OBJECT,0.);}else if n.hp>0.&&distance(n.pos,eye)<170.{asset(scene,\"ar\",n.pos+Vec3::Y*1.15,Quat::from_rotation_y(-n.yaw),0.9,6000+i as u32);}}\n for (i,a) in g.animals.iter().enumerate(){if distance(a.pos,eye)<220.{self.animal(scene,a.pos,a.yaw,g.view_time+a.pos.x,a.kind,i as u32);}}\n for p in &g.peers{if p.present&&p.id!=g.local_id{let color=[\"#e8443a\",\"#3b82f6\",\"#22c55e\",\"#f5b700\"][p.id as usize%4];let mut s=SdfInstance::capsule(p.pos+Vec3::Y*.4,p.pos+Vec3::Y*1.35,.26,c(color));s.flags|=flags::OBJECT;scene.sdfs.push(s);asset(scene,\"ar\",p.pos+Vec3::Y*1.2,Quat::from_rotation_y(-p.yaw),1.,8000+p.id as u32);}}\n self.fire(scene,g);\n for t in &g.traces{line(scene,t.a,t.z,0.015,c(\"#ffd48a\"),flags::NO_SHADOW|flags::OBJECT);}\n if g.weather==2{for i in 0..160 {let x=eye.x+(terrain::hash(i,0,5)-0.5)*50.;let z=eye.z+(terrain::hash(i,1,5)-0.5)*50.;let y=eye.y+((g.view_time*-16.+i as f32*.37).rem_euclid(20.))-3.;line(scene,Vec3::new(x,y,z),Vec3::new(x-0.12,y+1.,z-0.1),0.012,c(\"#a7b7b0\"),flags::NO_SHADOW);}}\n let playable=matches!(g.screen.as_str(),\"playing\"|\"ending_defend\"|\"companion\")||g.attracting;\n if playable&&!g.chase&&!g.safe_town(){self.viewmodel(scene,g,rig,dt);}\n if g.screen==\"shop\"||g.screen==\"locker\" {let index=if g.screen==\"shop\"{g.page*6+g.focus}else{g.owned.iter().nth(g.page*6+g.focus).copied().unwrap_or(4)};if let Some(w)=g.data.weapons.get(index){let p=eye+rig.forward()*3.+rig.ground_axes().1*1.4;asset(scene,&w.id,p,Quat::from_rotation_y(g.view_time*0.3),2.,9000);}}\n }\n fn compounds(&self,scene:&mut Scene,g:&Merc){for (i,p) in g.data.world.place.iter().enumerate(){let pos=Vec3::new(p.x,terrain::height(&g.data,p.x,p.z),p.z);if distance(pos,scene.camera.eye)>750.{continue;}let main=match p.kind{2=>\"bar\",3=>\"tin_shack\",5=>\"church\",6=>\"tin_shack\",7=>\"tin_shack\",9=>\"hotel\",10=>\"silo\",_=>\"hut\"};asset(scene,main,pos+Vec3::new(-13.,0.,-5.),Quat::IDENTITY,if p.kind==9{2.8}else{1.},10000+i as u32);asset(scene,\"sign\",pos+Vec3::new(0.,0.,22.),Quat::IDENTITY,1.,12000+i as u32);\n if p.kind==1||p.kind==7{asset(scene,\"watchtower\",pos+Vec3::new(18.,0.,-9.),Quat::IDENTITY,1.,13000+i as u32);for k in 0..5{asset(scene,\"sandbag\",pos+Vec3::new(k as f32*3.-6.,0.,12.),Quat::IDENTITY,1.,14000+(i*5+k) as u32);}}\n if p.kind==2{for k in 0..7{let x=pos.x-40.+(k%3) as f32*27.;let z=pos.z-35.+(k/3) as f32*35.;asset(scene,if k==1{\"bar\"}else{\"tin_shack\"},Vec3::new(x,terrain::height(&g.data,x,z),z),Quat::IDENTITY,1.,15000+k as u32);}let text=if g.ceasefire{\"CEASEFIRE\"}else{\"THE SIGN REMAINS\"};scene.texts.push(Text3d{text:text.into(),origin:pos+Vec3::new(0.,2.5,21.9),right:Vec3::X,up:Vec3::Y,size:0.34,color:c(\"#352f25\"),anchor:Anchor::Center,flags:0,weight:0.});}\n if p.kind==10{for k in 0..4{asset(scene,\"silo\",pos+Vec3::new(k as f32*13.-20.,0.,-25.),Quat::IDENTITY,1.,16000+k);}asset(scene,\"mast\",pos+Vec3::new(12.,0.,-8.),Quat::IDENTITY,1.,16010);}\n if p.kind==8{asset(scene,\"truck\",pos+Vec3::new(12.,0.,10.),Quat::IDENTITY,1.,17000+i as u32);}\n if p.kind==4&&p.id==\"bridge\"{part(scene,MeshKey::Cube,Vec3::new(40.,3.6,40.),Vec3::new(12.,0.7,210.),Quat::IDENTITY,c(\"#8f8a70\"),0,0.);}\n if distance(pos,scene.camera.eye)<60.{scene.texts.push(Text3d{text:p.name.to_uppercase(),origin:pos+Vec3::new(0.,3.5,21.9),right:Vec3::X,up:Vec3::Y,size:.28,color:c(\"#ddcca0\"),anchor:Anchor::Center,flags:0,weight:0.});}\n }}\n fn animal(&self,scene:&mut Scene,p:Vec3,yaw:f32,t:f32,kind:u8,i:u32){let q=Quat::from_rotation_y(yaw);let col=if kind==0{c(\"#c9bba0\")}else{c(\"#9e7442\")};let mut body=SdfInstance::capsule(p+q*Vec3::new(0.,1.,-.5),p+q*Vec3::new(0.,1.,.5),.32,col);body.group=20000+i;scene.sdfs.push(body);for k in 0..4{let x=if k%2==0{-0.22}else{.22};let z=if k<2{-.45}else{.45};let a=p+q*Vec3::new(x,1.,z);let b=p+q*Vec3::new(x,.08,z+(t*8.+k as f32).sin()*.09);line(scene,a,b,.07,col,0);}line(scene,p+q*Vec3::new(0.,1.,-.5),p+q*Vec3::new(0.,1.7,-.85),.14,col,0);if kind==0{for k in 0..7{part(scene,MeshKey::Cube,p+q*Vec3::new(0.,1.01,-.5+k as f32*.16),Vec3::new(.65,.49,.035),q,c(\"#393c33\"),0,0.);}}}\n fn fire(&self,scene:&mut Scene,g:&Merc){let eye=scene.camera.eye;let mut cells:Vec<_>=g.fire.cells.iter().filter(|(&(x,z),_)|Vec2::new(x as f32*2.,z as f32*2.).distance(flat(eye))<210.).collect();cells.sort_by(|a,b|{let pos=|k:&(i32,i32)|Vec2::new(k.0 as f32*2.,k.1 as f32*2.).distance_squared(flat(eye));pos(a.0).total_cmp(&pos(b.0))});let mut lights=0;for (&(x,z),cell) in cells{let wx=x as f32*2.+1.;let wz=z as f32*2.+1.;let h=terrain::height(&g.data,wx,wz);let p=Vec3::new(wx,h+.05,wz);part(scene,MeshKey::Plane,p,Vec3::new(2.,1.,2.),Quat::IDENTITY,c(\"#2a2420\"),flags::NO_SHADOW,0.);if cell.state==1{let flicker=(g.view_time*13.+x as f32*3.1+z as f32).sin()*.3+1.;part(scene,MeshKey::Cone,p+Vec3::Y*flicker,Vec3::new(1.8,2.8*flicker,1.8),Quat::from_rotation_z(-g.wind.x*.15),c(\"#df661f\"),flags::NO_SHADOW|flags::OBJECT,2.);part(scene,MeshKey::Cone,p+Vec3::Y*.5,Vec3::new(1.,1.6,1.),Quat::IDENTITY,c(\"#ffcc54\"),flags::NO_SHADOW|flags::OBJECT,3.);if x%3==0&&z%3==0{for j in 0..4{let t=(g.view_time*.2+j as f32*.25).fract();let smoke=p+Vec3::new(g.wind.x*t*7.,2.+t*16.,g.wind.y*t*7.);part(scene,MeshKey::Sphere,smoke,Vec3::splat(2.+t*4.),Quat::IDENTITY,c(\"#46493e\"),flags::NO_SHADOW,0.);}}if lights<32&&x%3==0{scene.point_lights.push(PointLight{position:p+Vec3::Y*1.5,color:Vec3::new(2.,.8,.15)*flicker,radius:12.,shadows:lights<2});lights+=1;}}}}\n fn viewmodel(&mut self,scene:&mut Scene,g:&Merc,rig:&CameraRig,dt:f32){let eye=scene.camera.eye;let f=rig.fp.as_ref().unwrap();let q=Quat::from_rotation_y(-f.yaw)*Quat::from_rotation_x(f.pitch);let offset=if g.aiming{Vec3::new(0.,-.10,-.46)}else{Vec3::new(.24,-.24,-.50)};let sway=Vec3::new((g.view_time*1.5).sin()*.003,(g.view_time*2.).sin()*.003,0.)+if g.fever_state>0{Vec3::new((g.view_time*19.).sin()*.006,0.,0.)}else{Vec3::ZERO};let recoil=Vec3::new(0.,0.,g.flash*1.2);let mut root=eye+q*(offset+sway+recoil);let mut rot=q;let gun=&g.guns[g.active];let def=&g.data.weapons[gun.def];let action=g.action.as_ref();if let Some(a)=action{let p=1.-a.left/a.duration;if a.kind==\"reload\"||a.kind==\"jam\"{rot=q*Quat::from_rotation_z((p*std::f32::consts::PI).sin()*-.35);root+=q*Vec3::new(0.,-.10*(p*std::f32::consts::PI).sin(),0.);}else if a.kind.starts_with(\"wound\")||a.kind==\"pills\"||a.kind==\"syrette\"||a.kind==\"repair\"||a.kind==\"overdose\"{root+=q*Vec3::new(0.,-.45,0.);}}\n let mut left=root+rot*Vec3::new(-.01,.02,-.34);let right=root+rot*Vec3::new(0.,-.02,0.);\n if g.map_up{self.map(scene,g,eye,q);asset(scene,\"gps\",eye+q*Vec3::new(.37,-.26,-.65),q,.8,60010);left=eye+q*Vec3::new(-.35,-.25,-.65);}else if g.monocular{asset(scene,\"monocular\",eye+q*Vec3::new(.12,-.07,-.3),q,1.,60011);}else if g.tracker{asset(scene,\"tracker\",eye+q*Vec3::new(.21,-.2,-.55),q,1.2,60012);}else if g.playing_tape.is_some(){asset(scene,\"recorder\",eye+q*Vec3::new(-.18,-.28,-.65),q,1.,60013);asset(scene,&def.id,root,rot,1.,60001);}else{let start=scene.meshes.len();let sd=scene.sdfs.len();asset(scene,&def.id,root,rot,1.,60001);let rust=(1.-gun.condition/100.)*.6;for m in &mut scene.meshes[start..]{m.flags|=flags::NO_SHADOW|flags::NO_FOG|flags::NO_RECEIVE_SHADOW|flags::OBJECT;m.color=m.color.lerp(c(\"#8c5231\"),rust);m.emissive=.12;}for s in &mut scene.sdfs[sd..]{s.flags|=flags::NO_SHADOW|flags::NO_FOG|flags::NO_RECEIVE_SHADOW|flags::OBJECT;s.color=s.color.lerp(c(\"#8c5231\"),rust);s.emissive=.12;}\n let muzzle=root+rot*Vec3::new(0.,.10,-.64);if g.flash>0.{part(scene,MeshKey::Sphere,muzzle,Vec3::new(.14,.14,.24),rot,c(\"#ffe3a2\"),flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT,4.);scene.point_lights.push(PointLight{position:muzzle,color:Vec3::new(5.,3.,1.),radius:5.,shadows:false});}\n let root_rag=muzzle+rot*Vec3::new(.025,-.035,.10);let rest=Vec3::new(g.wind.x,-.22,g.wind.y).normalize();let reset=self.rag.as_ref().is_none_or(|r|r.pts[0].distance(root_rag)>1.);if reset{self.rag=Some(Chain::new(ChainKind::Tail,root_rag,rest,.28,9));}let chain=self.rag.as_mut().unwrap();chain.step(root_rag,rest+q*Vec3::X*(g.view_time*22.).sin()*.15,.18,1.5,-1000.,dt);let mut cloth=MeshData::default();for w in chain.pts.windows(2){let width=q*Vec3::Y*.023;cloth.push_quad([w[0]-width,w[0]+width,w[1]+width,w[1]-width],q*Vec3::X);}scene.dynamic.push(pav_render::scene::DynamicMesh{data:cloth,color:c(\"#b8342a\"),emissive:.12,style:Style::Cel,flags:flags::TWO_SIDED|flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT,group:60020,material:0});}\n // Native key-pose skeleton supplies the shoulders and elbows; IK pins hands to each prop.\n let pd=PuppetDef::preset(BodyPlan::Biped);let clip=action.map(|a|a.kind.as_str()).unwrap_or(\"idle\");let name=format!(\"MERC_FP/{clip}\");let id=clips::find_cached(&name);let t=action.map_or(g.view_time,|a|a.duration-a.left);let mut sk=clips::pose_of(&pd,id,t,0).unwrap_or_else(||clips::skel(&pd,&clips::Key{hips:[0.,0.,100.],arm_l:[100.,0.,0.,50.,0.],arm_r:[100.,0.,0.,50.,0.],leg_l:[0.,0.,-100.,0.,0.],leg_r:[0.,0.,-100.,0.,0.],..Default::default()},false));sk.transform(q,eye-q*sk.head);\n let mut hands=[left,right];if let Some(a)=action{let progress=1.-a.left/a.duration;let s=(progress*std::f32::consts::PI).sin();if a.kind==\"reload\"||a.kind==\"jam\"{hands[0]=root+rot*Vec3::new(-.10,-.12*s,-.15);}else if a.kind.starts_with(\"wound\")||a.kind==\"syrette\"||a.kind==\"pills\"||a.kind==\"repair\"||a.kind==\"overdose\"{hands=[eye+q*Vec3::new(-.17,-.22,-.56),eye+q*Vec3::new(.08,-.20+s*.1,-.52)];let tool=if a.kind.starts_with(\"wound\"){[\"pliers\",\"knife\",\"pills\",\"pliers\",\"knife\",\"lighter\"][a.param as usize%6]}else if a.kind==\"pills\"{\"pills\"}else if a.kind==\"repair\"{\"wrench\"}else{\"syrette\"};asset(scene,tool,hands[1],q*Quat::from_rotation_z(s),1.,60030);}}\n for (i,hand) in hands.iter().enumerate(){let sh=eye+q*Vec3::new(if i==0{-.22}else{.25},-.25,.06);let (el,ha)=pav_core::puppet::ik(sh,*hand,.32,.34,q*Vec3::new(if i==0{-.5}else{.5},-.7,.2));let mut a=SdfInstance::capsule(sh,el,.085,c(\"#616448\"));a.flags=flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT|flags::NO_RECEIVE_SHADOW;a.emissive=.12;a.group=60040+i as u32;scene.sdfs.push(a);let mut a=SdfInstance::capsule(el,ha,.055,c(\"#946a4a\"));a.flags=flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT|flags::NO_RECEIVE_SHADOW;a.emissive=.12;a.group=60042+i as u32;scene.sdfs.push(a);part(scene,MeshKey::Sphere,ha,Vec3::new(.10,.085,.14),q,c(\"#4b4d39\"),flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT,.12);}\n }\n fn map(&self,scene:&mut Scene,g:&Merc,eye:Vec3,q:Quat){let root=eye+q*Vec3::new(-.12,-.17,-.82);let qr=q*Quat::from_rotation_x(-.12);let mut mesh=MeshData::default();let pos=|x:f32,z:f32|root+qr*Vec3::new(x*.72,z*.63,0.);for z in 0..=128{for x in 0..=128{let wx=x as f32/128.*2048.-1024.;let wz=z as f32/128.*2048.-1024.;let col=if terrain::water(&g.data,Vec2::new(wx,wz)){c(\"#749992\")}else{c(\"#d3c398\")};let p=pos(x as f32/128.-.5,.5-z as f32/128.);mesh.vertices.push(Vertex{pos:p.to_array(),normal:(qr*Vec3::Z).to_array(),uv:[0.,0.],color:[col.x,col.y,col.z,1.]});}}for z in 0..128{for x in 0..128{let i=(z*129+x) as u32;mesh.indices.extend([i,i+1,i+129,i+1,i+130,i+129]);}}scene.dynamic.push(pav_render::scene::DynamicMesh{data:mesh,color:Vec3::ONE,emissive:.2,style:Style::Unlit,flags:flags::NO_SHADOW|flags::NO_FOG|flags::TWO_SIDED|flags::OBJECT,group:60100,material:0});let point=|p:Vec3|pos(p.x/2048.,-p.z/2048.)+qr*Vec3::Z*.001;for road in &g.data.world.roads{line(scene,point(g.data.world.place[road[0]].pos()),point(g.data.world.place[road[1]].pos()),.001,c(\"#94683c\"),flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT);}for p in &g.data.world.place{let cp=point(p.pos());part(scene,MeshKey::Sphere,cp,Vec3::splat(.004),qr,c(\"#6b452e\"),flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT,0.);if p.kind!=1{scene.texts.push(Text3d{text:p.name.clone(),origin:cp+qr*Vec3::Y*.008,right:qr*Vec3::X,up:qr*Vec3::Y,size:.010,color:c(\"#423c2c\"),anchor:Anchor::Center,flags:flags::NO_FOG,weight:0.});}}let here=point(g.pos);part(scene,MeshKey::Sphere,here,Vec3::splat(.009),qr,c(\"#b8342a\"),flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT,0.);if let Some(w)=g.waypoint{let a=point(w);line(scene,a-qr*Vec3::X*.006,a+qr*Vec3::X*.006,.0015,c(\"#b8342a\"),flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT);line(scene,a-qr*Vec3::Y*.006,a+qr*Vec3::Y*.006,.0015,c(\"#b8342a\"),flags::NO_SHADOW|flags::NO_FOG|flags::OBJECT);}}\n}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\n# Rust requires leading zeros on fractions.\nimport re\np=Path('engine/crates/pav_view/src/merc/mod.rs');s=p.read_text();s=re.sub(r'(?<\"'!['\"\\\\w.])\\\\.(\\\\d)',r'0.\\\\1',s);p.write_text(s)\np=Path('engine/crates/pav_core/src/sim.rs');s=p.read_text().replace('            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),','            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\\\\n            merc:self.state.play.as_ref().and_then(|g|g.get::<crate::games::merc::Merc>()).map(|g|std::sync::Arc::new(g.clone())),');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/menus.rs');s=p.read_text().replace('let text=self.s(&format\"'!(\"dossier_{i}\"));'\"','let key=format\"'!(\"dossier_{i}\");let text=self.s(&key);'\"');p.write_text(s)\np=Path('engine/crates/pav_core/src/rig.rs');s=p.read_text().replace('    fn new(kind: ChainKind','    pub fn new(kind: ChainKind').replace('    fn step(&mut self, root:','    pub fn step(&mut self, root:');p.write_text(s)\np=Path('engine/crates/pav_view/src/lib.rs');s=p.read_text().replace('pub mod look;','pub mod look;\\\\npub mod merc;');p.write_text(s)\np=Path('engine/crates/pav_view/src/build.rs');s=p.read_text().replace('pub struct ViewBuilder {','pub struct ViewBuilder {\\\\n    merc:crate::merc::MercView,');s=s.replace('        let alpha =\\\\n','        let merc_rig=curr.merc.as_ref().map(|g|crate::merc::rig(g,rig));\\\\n        let rig=merc_rig.as_ref().unwrap_or(rig);\\\\n        let alpha =\\\\n',1);s=s.replace('        for o in interpolate(prev, curr, alpha) {','        for o in interpolate(prev, curr, alpha) {\\\\n            if curr.merc.is_some() && Some(o.id)==curr.player {continue;}');s=s.replace('        lock(&self.materials).attach(&mut scene);','        if let Some(g)=&curr.merc{self.merc.draw(&mut scene,g,rig);}\\\\n        lock(&self.materials).attach(&mut scene);');p.write_text(s)\nPY\nCARGO_BUILD_JOBS=10 cargo check --manifest-path engine/Cargo.toml -p pav_view > notes/check-view.log 2>&1\"","aggregated_output":"","exit_code":101,"status":"failed"}}
