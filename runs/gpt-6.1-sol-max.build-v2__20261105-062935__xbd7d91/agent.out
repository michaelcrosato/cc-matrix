c::new(),vehicles:Vec::new(),riding:None,seat:0,chase:false,companions:(1..4).map(|i|Companion{merc:i,alive:true,recruited:false,trust:0,rescue:false,down:0.,pos:Vec3::ZERO,mortal:false}).collect(),posts:Vec::new(),caches:Vec::new(),animals:Vec::new(),contract:0,goal:0,contract_active:true,complete:BTreeSet::new(),goal_time:0.,goal_flag:false,better_way:false,trouble_count:0,infamy:0,ceasefire:true,town_burned:false,saved_person:0,ending:0,ending_time:0.,income:[0,0],kills:0,tapes:BTreeSet::new(),playing_tape:None,tape_line:0,tape_timer:0.,subtitle:String::new(),speaker:String::new(),subtitle_time:0.,voice_serial:0,sound_serial:0,sound_kind:0,save_serial:0,save_slot:-1,load_slot:-1,toast:String::new(),toast_time:0.,time:0.,idle:0.,attracting:false,attract_time:0.,attract_segment:usize::MAX,attract_loops:0,coverage:BTreeSet::new(),outcome:Outcome::Playing,seed,session:false,host:true,local_id:0,peers:Vec::new(),round_started:false,round_time:0.,team_lives:6,ledger_carrier:-1,team_score:0,finished:false,won:false,streamed:None};g.populate();g}\n pub fn s(&self,k:&str)->&str{self.data.s(k)}\n pub fn flag(&mut self,k:&str){self.coverage.insert(k.into());}\n pub fn say(&mut self,speaker:&str,line:impl Into<String>){self.speaker=speaker.into();self.subtitle=line.into();self.subtitle_time=6.;self.voice_serial+=1;}\n pub fn note(&mut self,line:impl Into<String>){self.toast=line.into();self.toast_time=4.;}\n pub fn sound(&mut self,k:u8){self.sound_kind=k;self.sound_serial+=1;}\n pub fn forward(&self)->Vec3{Vec3::new(self.yaw.sin()*self.pitch.cos(),self.pitch.sin(),-self.yaw.cos()*self.pitch.cos())}\n pub fn eye_pos(&self)->Vec3{self.pos+Vec3::Y*self.eye}\n pub fn safe_town(&self)->bool{self.ceasefire&&distance(self.pos,self.data.place(\"town\").pos())<76.}\n pub fn open(&mut self,s:&str){self.screen=s.into();self.focus=0;self.page=0;self.idle=0.;}\n pub fn start(&mut self,merc:usize){self.merc=merc;self.companions=(0..4).filter(|i|*i!=merc).map(|i|Companion{merc:i,alive:true,recruited:false,trust:0,rescue:false,down:0.,pos:self.pos,mortal:false}).collect();self.companions[0].recruited=true;self.screen=\"playing\".into();self.hour=21.;self.world_hours=21.;self.say(\"Bakker\",self.s(\"prologue\").to_string());self.save_serial+=1;}\n fn populate(&mut self){let d=self.data.clone();for (pi,p) in d.world.place.iter().enumerate(){if p.kind==1||p.kind==3||p.kind==6||p.kind==7||p.kind==9||p.kind==10{self.posts.push(Post{place:p.id.clone(),cleared:false,cleared_at:0.,safe:p.kind==3,claimed:false});let n=if p.kind==3{3}else if p.kind>=7{7}else{5};for i in 0..n {let a=i as f32*2.399;let r=9.+(i%3) as f32*5.;let x=p.x+a.cos()*r;let z=p.z+a.sin()*r;let pos=Vec3::new(x,terrain::height(&d,x,z)+0.05,z);self.soldiers.push(Soldier{pos,home:pos,yaw:a,hp:80.,role:(i%5) as u8,faction:(pi%2) as u8,group:pi,detection:0.,state:0,timer:0.,cooldown:1.+i as f32*.2,gun:Gun::new(4,&d.weapons[4],25.+terrain::hash(i,pi as i32,self.seed)*35.),entity:None,tagged:false,poison:0.,burning:0.,target:p.kind==9&&i==0});}for i in 0..3{let x=p.x-12.+i as f32*12.;let z=p.z-9.;self.objects.push(Object{pos:Vec3::new(x,terrain::height(&d,x,z),z),kind:if p.kind==7{1}else{0},hp:if p.kind==7{150.}else{45.},fuse:-1.,exploded:false,place:p.id.clone()});}}\n if [0,1,2,3,7,9,11,12,14,17].contains(&pi){let x=p.x+14.;let z=p.z+23.;self.vehicles.push(Vehicle{pos:Vec3::new(x,terrain::height(&d,x,z),z),yaw:0.,pitch:0.,roll:0.,speed:0.,steer:0.,hp:100.,kind:if pi==0{2}else if pi%3==0{1}else{0},fuse:-1.,exploded:false,npc:false,path:0});}}\n for i in 0..2{let x=640.+i as f32*160.;let z=terrain::river_z(&d,x);self.vehicles.push(Vehicle{pos:Vec3::new(x,0.2,z),yaw:1.57,pitch:0.,roll:0.,speed:0.,steer:0.,hp:100.,kind:3,fuse:-1.,exploded:false,npc:false,path:0});}\n for i in 0..12 {let p=&d.world.place[(i*7+3)%d.world.place.len()];let x=p.x+22.+(i%3) as f32*8.;let z=p.z+32.;self.caches.push(Cache{pos:Vec3::new(x,terrain::height(&d,x,z),z),found:false,value:1+(i%3) as i32});}\n for i in 0..18{let x=-300.+i as f32*28.;let z=710.-(i%4) as f32*80.;self.animals.push(Wildlife{pos:Vec3::new(x,terrain::height(&d,x,z),z),yaw:i as f32,fleeing:0.,kind:(i%3==0) as u8});}}\n pub fn stream(&mut self,sim:&mut Sim){let c=((self.pos.x/32.).floor() as i32,(self.pos.z/32.).floor() as i32);if self.streamed==Some(c){return;}let keys:Vec<_>=sim.state.statics.chunks.keys().copied().collect();for k in keys{if let crate::statics::RegionKey::Terrain(x,z)=k{if (x-c.0).abs()>3||(z-c.1).abs()>3{sim.state.statics.remove_region(&mut sim.state.physics,k);}}}for dz in -3..=3{for dx in -3..=3{let key=crate::statics::RegionKey::Terrain(c.0+dx,c.1+dz);if !sim.state.statics.chunks.contains_key(&key){let patch=Arc::new(terrain::patch(&self.data,c.0+dx,c.1+dz,1));sim.state.statics.set_terrain(&mut sim.state.physics,key,patch);}}}self.streamed=Some(c);}\n pub fn sync_player(&self,sim:&mut Sim){if let Some(id)=sim.state.player{sim.set_position(id,self.pos);}}\n}\npub fn build(sim:&mut Sim,rest:Option<&str>)->anyhow::Result<()>{sim.config.history_seconds=0.;sim.config.movement.model=crate::character::MovementModel::Momentum;sim.config.movement.max_speed=4.6;sim.config.movement.gravity=18.;sim.config.movement.jump_height=1.;sim.config.movement.ledge_grab=true;sim.config.movement.crouch_mult=0.55;sim.config.movement.crawl_mult=0.28;let mut g=Merc::new(sim.state.seed);if rest==Some(\"play\"){g.start(0);}if rest==Some(\"session\"){g.session=true;g.screen=\"card\".into();g.pos=g.data.place(\"depot\").pos()+Vec3::new(-65.,0.,70.);g.pos.y=terrain::height(&g.data,g.pos.x,g.pos.z);g.hour=18.;}g.stream(sim);sim.state.spawn=g.pos;sim.spawn_player();sim.state.focus=g.pos;sim.state.play=Some(GameBox::new(g));Ok(())}\nimpl Game for Merc{\n const KEY:&'\"'static str=\\\"merc\\\";\n fn pre(&mut self,sim:&mut Sim,input:&InputFrame,dt:f32,events:&mut Vec<SimEvent>)->BTreeMap<EntityId,InputFrame>{self.tuning=sim.config.merc.clone();let mut out=BTreeMap::new();let mut i=*input;self.flash=(self.flash-dt).max(0.);self.recoil*=(-dt*14.).exp();self.hit_time=(self.hit_time-dt).max(0.);self.damage_time=(self.damage_time-dt).max(0.);self.ammo_time=(self.ammo_time-dt).max(0.);self.toast_time=(self.toast_time-dt).max(0.);self.subtitle_time=(self.subtitle_time-dt).max(0.);self.view_time+=dt;\n let activity=input.act\"'!=0||input.move_dir.length_squared()>0.01||input.look.length_squared()>0.000001||input.pressed!=0;\n if activity{self.idle=0.;if self.attracting{self.attracting=false;self.attract_segment=usize::MAX;self.open(\"title\");self.pos=Vec3::new(-120.,terrain::height(&self.data,-120.,900.),900.);self.sync_player(sim);i=InputFrame::default();}else{self.command(sim,input.act,events);}}\n if self.screen!=\"playing\"&&self.screen!=\"ending_defend\"&&self.screen!=\"card\"&&!self.session {self.idle+=dt;if self.idle>=10.||self.touch_only{self.attracting=true;self.attract(sim,dt,events);}if let Some(id)=sim.state.player{out.insert(id,InputFrame::default());}return out;}\n if self.session&&(!self.round_started||self.finished){if let Some(id)=sim.state.player{out.insert(id,InputFrame::default());}return out;}\n let dt=dt*self.tuning.time_scale;self.time+=dt;self.yaw=(self.yaw+i.look.x).rem_euclid(std::f32::consts::TAU);self.pitch=(self.pitch-i.look.y).clamp(-1.48,1.48);self.aiming=i.down(b::SECONDARY)&&!self.map_up;let h=match self.stance{1=>1.02,2=>0.42,_=>1.58};self.eye+=(h-self.eye)*(dt*12.).min(1.);\n if input.just(b::CROUCH){self.stance=if self.stance==1{0}else{1};}if input.just(b::CRAWL){self.stance=if self.stance==2{0}else{2};}\n for (bit,a) in [(b::RELOAD,act::RELOAD),(b::INTERACT,act::INTERACT),(b::NEXT_GUN,act::NEXT_GUN),(b::THROW,act::THROW),(b::MELEE,act::MELEE),(b::MAP,act::MAP),(b::MONOCULAR,act::MONOCULAR),(b::HEAL,act::HEAL),(b::PILLS,act::PILL),(b::TRACKER,act::TRACKER),(b::SEAT,act::SEAT),(b::CAMERA,act::CAMERA)]{if input.just(bit){self.command(sim,a,events);}}\n if self.stance==1{i.held|=b::CROUCH;}if self.stance==2{i.held|=b::CRAWL;}i.held&=!(b::USE|b::PRIMARY|b::INTERACT|b::SECONDARY);i.pressed&=b::JUMP;\n let sprint=input.down(b::SPRINT)&&self.stamina>0.&&self.ledger_carrier!=self.local_id as i32;if sprint&&input.move_dir.length()>0.1{self.stamina=(self.stamina-dt).max(0.);}else{self.stamina=(self.stamina+dt*0.7).min(12.);}let slow=if self.fever_state==2{0.75}else{1.};sim.config.movement.max_speed=(if sprint{7.}else if self.aiming{3.}else{4.6})*self.tuning.player_speed*slow;\n if self.riding.is_some(){self.drive(sim,input,dt,events);i.move_dir=Vec2::ZERO;}else if self.rescue_time>0.||self.death{ i.move_dir=Vec2::ZERO;}else if self.cheats.noclip{self.pos+=Vec3::new(i.move_dir.x,input.vertical,i.move_dir.y)*dt*12.;self.sync_player(sim);i.move_dir=Vec2::ZERO;}\n for gun in &mut self.guns{gun.cooldown=(gun.cooldown-dt).max(0.);}\n self.action_tick(sim,dt,events);\n if input.down(b::PRIMARY)&&self.action.is_none()&&!self.safe_town()&&!self.map_up&&!self.monocular&&!self.tracker&&!self.death&&self.rescue_time<=0. {self.shoot(sim,events);}\n if self.monocular{self.tag(dt);}\n if let Some(id)=sim.state.player{out.insert(id,i);}\n if !self.session||self.host{self.ai(sim,dt,events,&mut out);}self.survival(sim,dt,events);self.world_tick(sim,dt,events);self.contract_tick(sim,dt,events);self.tape_tick(dt);\n out}\n fn post(&mut self,sim:&mut Sim,dt:f32,events:&mut Vec<SimEvent>){if !self.attracting&&(self.screen==\"playing\"||self.screen==\"ending_defend\"||self.session&&self.round_started)&&self.riding.is_none()&&!self.cheats.noclip{if let Some(pos)=sim.state.player.and_then(|id|sim.feet(id)){self.speed=distance(pos,self.pos)/dt;self.pos=pos;}}\n if self.pos.x.abs()>1010.||self.pos.z.abs()>1010.{self.pos.x=self.pos.x.clamp(-1000.,1000.);self.pos.z=self.pos.z.clamp(-1000.,1000.);self.note(self.s(\"border\").to_string());self.sync_player(sim);}\n if self.pos.y<terrain::height(&self.data,self.pos.x,self.pos.z)-3.{self.pos.y=terrain::height(&self.data,self.pos.x,self.pos.z)+0.1;self.sync_player(sim);}\n for n in &mut self.soldiers{if let Some(id)=n.entity{if let Some(p)=sim.feet(id){n.pos=p;}}}\n if self.screen==\"playing\" {for e in events.iter(){if let SimEvent::Land{speed,..}=e{if *speed>6.{self.damage((speed-6.)*4.,3);}}}}\n self.stream(sim);sim.state.focus=self.pos;\n }\n fn hud(&self,_sim:&Sim)->Vec<String>{Vec::new()}\n fn status(&self,_sim:&Sim)->serde_json::Value{json!({\"title\":self.s(\"title\"),\"screen\":self.screen,\"focus\":self.focus,\"page\":self.page,\"pos\":self.pos,\"yaw\":self.yaw,\"pitch\":self.pitch,\"health\":self.health,\"stamina\":self.stamina,\"stance\":self.stance,\"eye\":self.eye,\"time\":self.time,\"hour\":self.hour,\"wind\":[self.wind.x,self.wind.y,self.wind_speed],\"fire\":{\"burning\":self.fire.burning(),\"total\":self.fire.total,\"version\":self.fire.version},\"contract\":self.contract,\"goal\":self.goal,\"goalData\":self.current_goal(),\"complete\":self.complete,\"ceasefire\":self.ceasefire,\"ending\":self.ending,\"outcome\":self.outcome,\"fever\":self.fever_state,\"feverTimer\":self.fever_timer,\"pills\":self.pills,\"syrettes\":self.syrettes,\"diamonds\":self.diamonds,\"gun\":self.guns[self.active],\"guns\":self.guns,\"map\":self.map_up,\"waypoint\":self.waypoint,\"monocular\":self.monocular,\"tracker\":self.tracker,\"riding\":self.riding,\"seat\":self.seat,\"companions\":self.companions,\"coverage\":self.coverage,\"audio\":{\"master\":self.settings.master,\"music\":self.settings.music,\"sfx\":self.settings.sfx,\"voices\":self.settings.voices},\"settings\":self.settings,\"tuning\":self.tuning,\"cheats\":self.cheats,\"attract\":self.attracting,\"attractSegment\":self.attract_segment,\"attractLoops\":self.attract_loops,\"saveSerial\":self.save_serial,\"session\":self.session,\"host\":self.host,\"started\":self.round_started,\"finished\":self.finished,\"won\":self.won,\"score\":self.team_score,\"ledger\":self.ledger_carrier,\"roundTime\":self.round_time,\"peers\":self.peers,\"enemiesAlive\":self.soldiers.iter().filter(|n|n.hp>0.).count(),\"voiceSerial\":self.voice_serial,\"subtitle\":self.subtitle,\"soundSerial\":self.sound_serial})}\n fn outcome(&self)->Outcome{self.outcome}\n fn bot(&self,sim:&Sim)->InputFrame{self.bot_input(sim)}\n}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/src/input.rs');s=p.read_text();s=s.replace('    pub const NAMES:', '''    pub const RELOAD:u32=1<<15; pub const NEXT_GUN:u32=1<<16; pub const THROW:u32=1<<17; pub const MELEE:u32=1<<18; pub const MAP:u32=1<<19; pub const MONOCULAR:u32=1<<20; pub const HEAL:u32=1<<21; pub const PILLS:u32=1<<22; pub const TRACKER:u32=1<<23; pub const SEAT:u32=1<<24; pub const CAMERA:u32=1<<25;\n    pub const NAMES:''');s=s.replace('    pub cmd: Option<crate::arpg::GameCmd>,','''    pub cmd: Option<crate::arpg::GameCmd>,\n    #[serde(default)] pub look: Vec2,\n    #[serde(default)] pub axes: Vec2,\n    #[serde(default)] pub act:u32,''');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/mod.rs');s=p.read_text().replace('pub mod starter;','pub mod starter;\\\\npub mod merc;');s=s.replace('&[entry::<starter::Starter>','&[entry::<merc::Merc>(\\\"First-person survival in the last dry season.\\\", merc::build), entry::<starter::Starter>');p.write_text(s)\np=Path('engine/crates/pav_core/src/sim.rs');s=p.read_text().replace('    pub anim: crate::clips::AnimParams,','    pub anim: crate::clips::AnimParams,\\\\n    pub merc: crate::games::merc::data::Tuning,').replace('            anim: crate::clips::AnimParams::default(),','            anim: crate::clips::AnimParams::default(),\\\\n            merc: Default::default(),');s=s.replace('        nested(v, \\\"anim\\\", &mut self.anim);','        nested(v, \\\"anim\\\", &mut self.anim);\\\\n        nested(v,\\\"merc\\\",&mut self.merc);');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,76p' engine/crates/pav_core/src/statics.rs && sed -n '1,190p' hub/lib/hub/README.md && sed -n '190,390p' hub/lib/hub/README.md && cat engine/anim/starter.json 2>/dev/null; ls engine/anim | head -10; rg -n 'fn cast_ray|cast_ray\\\\(' engine/crates/pav_core/src | head -15; sed -n '412,475p' engine/crates/pav_core/src/sim.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,76p' engine/crates/pav_core/src/statics.rs && sed -n '1,190p' hub/lib/hub/README.md && sed -n '190,390p' hub/lib/hub/README.md && cat engine/anim/starter.json 2>/dev/null; ls engine/anim | head -10; rg -n 'fn cast_ray|cast_ray\\\\(' engine/crates/pav_core/src | head -15; sed -n '412,475p' engine/crates/pav_core/src/sim.rs\"","aggregated_output":"//! Static geometry, grouped into regions: terrain chunks, rooms and the pavilion hub. A region\n//! is the unit of streaming: it can be active (colliders in the physics world) or dormant\n//! (kept in memory with all changes, colliders removed).\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse glam::{IVec2, Quat, Vec3};\nuse rapier::prelude::*;\nuse serde::{Deserialize, Serialize};\n\nuse crate::color::Color;\nuse crate::physics::{PhysicsState, TAG_BLOCK};\nuse crate::props::{Bounds, CompiledProp};\nuse crate::shape::{Look, Shape, Sway};\nuse crate::terrain::TerrainPatch;\nuse crate::zones::{Label, Zone};\n\n/// Terrain chunk edge length in metres.\npub const CHUNK_SIZE: f32 = 32.0;\n\npub mod block_flags {\n    /// Can be destroyed by explosions.\n    pub const DESTRUCTIBLE: u32 = 1;\n    /// Climbable surface (ladders).\n    pub const LADDER: u32 = 2;\n    /// No collision (decoration).\n    pub const GHOST: u32 = 4;\n    /// Rendered with rounded edges.\n    pub const ROUNDED: u32 = 8;\n    /// About to crumble (drawn cracked).\n    pub const CRACKED: u32 = 16;\n    /// Crumbles only under the player (monsters fall into holes but don't make them).\n    pub const PLAYER_CRUMBLE: u32 = 32;\n}\n\n/// Which region static content belongs to.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]\npub enum RegionKey {\n    /// Procedural terrain chunk at chunk coordinates.\n    Chunk(i32, i32),\n    /// A showcase room (index into the world's room list).\n    Room(u16),\n    /// The pavilion hub: plaza and corridors.\n    Hub,\n}\n\nimpl RegionKey {\n    pub fn chunk_of(p: Vec3) -> Self {\n        RegionKey::Chunk((p.x / CHUNK_SIZE).floor() as i32, (p.z / CHUNK_SIZE).floor() as i32)\n    }\n    fn pack(self) -> (u128, u128, u128) {\n        match self {\n            RegionKey::Chunk(x, z) => (0, x as u32 as u128, z as u32 as u128),\n            RegionKey::Room(id) => (1, id as u128, 0),\n            RegionKey::Hub => (2, 0, 0),\n        }\n    }\n    fn unpack(kind: u128, a: u128, b: u128) -> Option<Self> {\n        match kind {\n            0 => Some(RegionKey::Chunk(a as u32 as i32, b as u32 as i32)),\n            1 => Some(RegionKey::Room(a as u16)),\n            2 => Some(RegionKey::Hub),\n            _ => None,\n        }\n    }\n}\n\n/// Compatibility alias: terrain chunk coordinates.\npub type ChunkKey = RegionKey;\n\npub fn chunk_origin(x: i32, z: i32) -> Vec3 {\n    Vec3::new(x as f32 * CHUNK_SIZE, 0.0, z as f32 * CHUNK_SIZE)\n}\n\npub fn chunk_ivec(p: Vec3) -> IVec2 {\n# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card: what the game is, how to win, the\n   controls. The card is the hub's, from the game's tags, or the game's own\n   (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\nBefore every round the players get 10 to 30 seconds to learn what comes\nnext and say when they are ready. By default the hub shows its own card over\nthe game. A game can make the card its own, as part of the game:\n\n```js\nAIHub.connect({ mode, seats, card: true });\n```\n\nThe hub's card then steps aside when the game calls `ready()`, and the game's\nscreen is the card until `start`. How it looks and sounds is the game's: its\ntitle, its music, its world, the players lining up. Introduce the game the way\nit deserves.\n\nWhile it is on, the card shows:\n\n- the game's name;\n- the players, each in their colour, and which of them are ready;\n- how to win the round;\n- the controls this player will use;\n- the time left, from the `card` event.\n\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\non the card:\n\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\n  `AIHub.answer('ready')`.\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\n\nNothing done on the card changes the round. It has no menus, settings or\nchoices, and play begins only at `start`. In parallel and ghost it draws no\nnumbers from `Math.random`, which would change the round's start: use\n`AIHub.rng('card')`.\n\n`card` arrives whenever it changes, and every second while the countdown runs:\n\n| Field | |\n|---|---|\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\n| `paused` | `true` while most players asked for more time |\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\n| `ready` | the ids of the players who are ready |\n| `asking` | how many players asked for more time (never who) |\n| `asked` | `true` when this player asked for more time |\n\n### The start\n\n`start` arrives when the round starts. Play begins three seconds later, when\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\n`start`.\n\n### Reporting\n\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n  standing during the round. `score` is a number, higher is ahead; `label` is\n  text for the hub's scoreboard. The hub takes the latest about once a second.\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\n  ghost, once, when the player's round is over. `time` is milliseconds of\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\n  by the host only:\n  - `standings`: arrays of player ids, best first; players in the same array\n    tie. It lists every player still in the round once; anyone left out is\n    placed last.\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\n  - `won` (optional): `true` or `false` when the round is a team result.\n\n### Time-up and the end\n\n- The hub may call time while the round is still going. On `time-up`, the\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\n  `finish()` from the host in a shared world. A shared world with no\n  `finish()` by then is void.\n- `end` is the last message of a round. After it, the game takes no input and\n  sends nothing, and its sound stops. The hub shows its results over the\n  game, then removes it.\n\n| `end` reason | |\n|---|---|\n| `finished` | the round counted; `standings` is the final order |\n| `void` | it didn't count (no result, a fatal error, skipped) |\n| `host-left` | the host of a shared world left |\n| `sat-out` | this player missed the ready deadline |\n| `session-ended` | the session closed |\n\n### Leaving\n\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\n- A parallel or ghost round goes on whoever leaves, the host included.\n- A shared-world round is void when its host leaves, isn't ready, or has its\n  tab hidden for more than 20 seconds.\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\n  of a shared world it voids the round; from any other copy it counts as\n  that player leaving.\n\n### Scoring\n\n- Parallel and ghost: players with a `time` rank first, lowest first; then\n  the rest by `score`. A player with no result is ranked by their last\n  progress.\n- Shared world: the host's `standings`. With `won`, the results show a team\n  result instead of medals.\n- Each player gets one point for every player they beat.\n\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\nresults:\n\n- in `result()`: `stats` is `{ name: value }` and `awards` is\n  `[{ title, detail }]`, for this player;\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\n  `[{ id, title, detail }]`, for each player.\n\nPlaces and points come only from the standings, `time` and `score`.\n\n---\n\n## Sending data between copies\n\n### Parallel\n\nThe copies send nothing to each other. `send()` is not used.\n\n### Ghost\n\nEach copy sends its own player's position and what the player is doing to\nthe other copies with `send()`. Each copy shows the other players' characters\nonly while they are in the same area of the game as its own player, and those\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\n\n### Shared world\n\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\n  host what their own player does, and show the world the host sends them.\n- The hub can run the host's copy with no player of its own: `AIHub.server`\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\n  the world in that case too, with no local player, camera or input.\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\n  every copy.\n\n### `send()` and `message`\n\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n  to the one player `to`. It returns `false` when the message is dropped.\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n  sender's player id. A copy never receives its own messages. Messages sent\n  before another copy has loaded are queued for it.\n- `data` is JSON, at most 16 KB.\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\npython3 -m http.server 8000\n```\n\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\nThe hub's own test also runs ghost and shared-world games with\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\n`&scenario=host-leave`, and shared worlds once more with\n`&players=2&scenario=server`.\n\nThe checklist fills in as it runs. **A game passes when\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\n`\"true\"` at the end. It checks:\n\n- the tags, `connect()`, `ready()` with no key press, and the start;\n- with the game's own card, that Enter answers Ready;\n- parallel and ghost: `Math.random` the same on every copy, and progress from\n  every copy; parallel sends nothing, ghost sends;\n- shared world: traffic both ways, and a round hosted by a copy with no\n  player of its own;\n- a player leaving, the host leaving, time-up, a valid result, and every copy\n  told the round ended;\n- no protocol problems, errors, dialogs, popups or sockets.\n\n**New round**, **Time up**, **Remove player** and **Hide host tab** run the\ncases by hand; clicking a player's frame gives it the keyboard and mouse.\n`&limit=` sets the round's length in seconds and `&seed=` fixes the seed. The\ngame is served from the harness's own origin.\n\nIn the AI Hub repository, `node scripts/hub-check.mjs <game>` runs the same\nchecks with Playwright, then opens the game outside a session to see it still\nruns there.\n\n---\n\n## Reference\n\n### Tags\n\n| Tag | |\n|---|---|\n| `hub:session` | `1`: this protocol |\n| `hub:session-players` | `MIN-MAX`: the number of players the game takes in a session |\n| `hub:session-mode` | `parallel`, `ghost` or `shared-world` |\n| `hub:session-goal` | how to win, shown on the hub's card |\n| `hub:session-howto` | the controls, shown on the hub's card |\n| `hub:session-minutes` | optional: how many minutes a round takes |\n| `hub:webgpu` | optional: `required` when the game cannot run without WebGPU |\n\n### API\n\n| | |\n|---|---|\n| `AIHub.active` | `true` in a session, from the first line |\n| `AIHub.connect({ mode, seats, card? })` | → `Promise<info \\| null>`; `null`: no hub. `card: true`: the game shows its own card |\n| `AIHub.ready()` | once, when the round can start |\n| `AIHub.answer('ready' \\| 'more')` | on the game's own card, before `start` |\n| `AIHub.time()` | milliseconds since play began: negative in the countdown, `-Infinity` before `start` |\n| `AIHub.on(event, fn)` | returns a function that removes the handler |\n| `AIHub.progress({ score, label })` | parallel and ghost |\n| `AIHub.result({ time \\| score, stats?, awards? })` | parallel and ghost, once |\n| `AIHub.finish({ standings, scores?, won?, stats?, awards? })` | shared world, the host, once |\n| `AIHub.send(data, { to, reliable })` | ghost and shared world |\n| `AIHub.rng(label)` | a generator of numbers in `[0, 1)`, the same on every copy, one stream per label |\n| `AIHub.seeded` | `true` when the client seeded `Math.random` |\n| `AIHub.fail(message)` | the game cannot run in this browser |\n\n`AIHub.probe()` and `AIHub.inspect()` exist for older games; the hub does not\n100style\ncatalogs\ncmu\ncmu.json\nmesh2motion.json\nmoves.toml\nquaternius.json\nstyle100.json\nengine/crates/pav_core/src/destruct.rs:71:                qp.cast_ray(&Ray::new(f + Vec3::Y * 0.05, Vec3::NEG_Y), 0.25, true).map(|(h, _)| h)\nengine/crates/pav_core/src/projectile.rs:160:    qp.cast_ray(&ray, len as Real, true).is_some()\nengine/crates/pav_core/src/projectile.rs:176:    qp.cast_ray(&Ray::new(from, dir), len as Real, true).map(|(_, t)| t as f32)\nengine/crates/pav_core/src/stealth.rs:69:                    && qp.cast_ray(&Ray::new(eye + dir * start, dir), (dist - start - 0.2).max(0.0) as Real, true).is_some()\nengine/crates/pav_core/src/stealth.rs:118:                let len = qp.cast_ray(&Ray::new(eye, d), *range as Real, true).map(|(_, t)| t as f32).unwrap_or(*range);\nengine/crates/pav_core/src/character.rs:458:    if qp.cast_ray(&Ray::new(head, dir), (reach + 0.35) as Real, true).is_some() {\nengine/crates/pav_core/src/character.rs:1045:        let hit = st.physics.query_filtered(filter).cast_ray(&ray, (height * 0.5 + 0.15) as Real, true);\nengine/crates/pav_core/src/character.rs:1244:            qp.cast_ray(&Ray::new(Vec3::new(p.x, feet_now.y + 0.6, p.z), Vec3::NEG_Y), 1.4, true)\n    }\n\n    /// Spawns the player at the scene's spawn point and makes the camera follow it.\n    pub fn spawn_player(&mut self) -> EntityId {\n        let id = self.spawn_character(\"player\", self.state.spawn);\n        self.state.player = Some(id);\n        id\n    }\n\n    /// Where an entity stands: a character's feet (its `pos` is the capsule's centre), else\n    /// its position.\n    pub fn feet(&self, id: EntityId) -> Option<Vec3> {\n        let e = self.state.entities.get(id)?;\n        Some(match &e.character {\n            Some(c) => e.pos - Vec3::Y * c.height() * 0.5,\n            None => e.pos,\n        })\n    }\n\n    pub fn player(&self) -> Option<&Entity> {\n        self.state.player.and_then(|id| self.state.entities.get(id))\n    }\n\n    pub fn despawn(&mut self, id: EntityId) -> bool {\n        match self.state.entities.map.remove(&id) {\n            Some(e) => {\n                if e.prop.is_some() {\n                    self.invalidate_prop_navigation();\n                }\n                if let Some(b) = e.body {\n                    self.state.physics.remove_body(b);\n                }\n                if let Some(h) = e.soft.and_then(|s| s.handle) {\n                    self.state.physics.remove_soft(h);\n                }\n                if self.state.player == Some(id) {\n                    self.state.player = None;\n                }\n                true\n            }\n            None => false,\n        }\n    }\n\n    /// Moves an entity (teleport), resetting its velocity. For characters `pos` is the feet.\n    pub fn set_position(&mut self, id: EntityId, pos: Vec3) -> bool {\n        let Some(e) = self.state.entities.map.get_mut(&id) else { return false };\n        let center = match &mut e.character {\n            Some(ch) => {\n                ch.vel = Vec3::ZERO;\n                ch.impulse = Vec3::ZERO;\n                ch.stun = 0.0;\n                ch.roll = 0.0;\n                ch.hang = None;\n                ch.grid_target = None;\n                ch.climbing = None;\n                pos + Vec3::Y * (ch.height() * 0.5 + character::PLACE_LIFT)\n            }\n            None => pos,\n        };\n        e.pos = center;\n        if self.state.player == Some(id) {\n            self.state.focus = center;\n        }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"sed -n '135,185p' engine/crates/pav_core/src/projectile.rs && sed -n '380,435p' hub/lib/hub/README.md && head -65 engine/anim/quaternius.json && rg -n 'fn.*clip|pub fn|pub struct.*Clip|events' engine/crates/pav_core/src/clips.rs | head -45 && rg -n 'pub fn spawn_npc' engine/crates/pav_core/src/sim.rs && sed -n '360,412p' engine/crates/pav_core/src/sim.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"sed -n '135,185p' engine/crates/pav_core/src/projectile.rs && sed -n '380,435p' hub/lib/hub/README.md && head -65 engine/anim/quaternius.json && rg -n 'fn.*clip|pub fn|pub struct.*Clip|events' engine/crates/pav_core/src/clips.rs | head -45 && rg -n 'pub fn spawn_npc' engine/crates/pav_core/src/sim.rs && sed -n '360,412p' engine/crates/pav_core/src/sim.rs\"","aggregated_output":"                out.impacts += 1;\n                return false;\n            }\n            p.pos = next;\n            true\n        });\n        out\n    }\n}\n\n/// Ray test against fixed geometry (static blocks, terrain, fixed bodies) only, ignoring the\n/// shooter's own body (a turret).\npub fn static_blocked(\n    physics: &crate::physics::PhysicsState,\n    from: Vec3,\n    dir: Vec3,\n    len: f32,\n    ignore: Option<RigidBodyHandle>,\n) -> bool {\n    let mut filter = QueryFilter::only_fixed().exclude_sensors();\n    if let Some(b) = ignore {\n        filter = filter.exclude_rigid_body(b);\n    }\n    let qp = physics.query_filtered(filter);\n    let ray = Ray::new(from, dir);\n    qp.cast_ray(&ray, len as Real, true).is_some()\n}\n\n/// Distance along `dir` to fixed geometry within `len`, if any.\npub fn static_hit(\n    physics: &crate::physics::PhysicsState,\n    from: Vec3,\n    dir: Vec3,\n    len: f32,\n    ignore: Option<RigidBodyHandle>,\n) -> Option<f32> {\n    let mut filter = QueryFilter::only_fixed().exclude_sensors();\n    if let Some(b) = ignore {\n        filter = filter.exclude_rigid_body(b);\n    }\n    let qp = physics.query_filtered(filter);\n    qp.cast_ray(&Ray::new(from, dir), len as Real, true).map(|(_, t)| t as f32)\n}\n| `AIHub.time()` | milliseconds since play began: negative in the countdown, `-Infinity` before `start` |\n| `AIHub.on(event, fn)` | returns a function that removes the handler |\n| `AIHub.progress({ score, label })` | parallel and ghost |\n| `AIHub.result({ time \\| score, stats?, awards? })` | parallel and ghost, once |\n| `AIHub.finish({ standings, scores?, won?, stats?, awards? })` | shared world, the host, once |\n| `AIHub.send(data, { to, reliable })` | ghost and shared world |\n| `AIHub.rng(label)` | a generator of numbers in `[0, 1)`, the same on every copy, one stream per label |\n| `AIHub.seeded` | `true` when the client seeded `Math.random` |\n| `AIHub.fail(message)` | the game cannot run in this browser |\n\n`AIHub.probe()` and `AIHub.inspect()` exist for older games; the hub does not\nread them.\n\n| Event | Arguments |\n|---|---|\n| `card` | `{ left, paused, starting, ready, asking, asked }`, with the game's own card |\n| `start` | `{ in }`: milliseconds until play begins |\n| `message` | `data, from` |\n| `leave` | `{ id, reason }` |\n| `time-up` | `{ graceMs }` |\n| `end` | `{ reason, standings }` |\n\nEvents that arrive before a handler is attached are kept, and delivered in\norder when the first handler is attached. Fields and events a newer hub adds\nreach the game through the client unchanged.\n\n### Versions\n\nThis is protocol **1**, client **1.4.0**. Changes within version 1 only add:\ngames on older clients keep working. A change that would break a game becomes\nprotocol 2, with its own `hub:session` value.\n{\n\"set\": \"QUATERNIUS\",\n\"title\": \"QUATERNIUS\",\n\"format\": 1,\n\"credit\": \"Universal Animation Library 1 and 2 by Quaternius (quaternius.com), CC0 1.0 (public domain).\",\n\"legend\": [\n  \"Readable key poses (the my-3D2dge format). Times in seconds; every other number is a whole number. Rig frame: forward, right, up.\",\n  \"L and R are the figure's own sides. Directions are percentages and need not add up: [100, 0, 0] and [50, 0, 0] agree.\",\n  \"hips   [forward, right, up]   the pelvis, in percent of standing hip height (100 = standing, 55 = sitting on a chair)\",\n  \"body   [turn, lean, tilt]     the pelvis, degrees: turn + = toward the right, lean + = forward, tilt + = toward the right\",\n  \"chest  [turn, lean, tilt]     the chest, relative to the pelvis; head [turn, lean, tilt] relative to the chest\",\n  \"shL shR    [reach, shrug]     degrees the shoulder swings forward (into a punch or an aim) and up, from rest\",\n  \"armL armR  [forward, out, up, bend, twist]  which way the arm points from the shoulder to the fist, in chest space (out + = away from the body on that side; [0, 0, -100] hangs down, [100, 0, 0] punches ahead); bend = elbow bend in degrees (0 = straight); twist = degrees the elbow swings round the arm from its natural direction (back and down)\",\n  \"legL legR  [forward, out, up, bend, twist]  hip to ankle in pelvis space; bend: the knee; twist: from pointing forward\",\n  \"footL footR [down, out, toes]   degrees the foot points down from standing, turns outward, and the toes bend up\",\n  \"blade  [forward, right, up]   (sword clips) the direction of a blade held in the right fist, in chest space\",\n  \"root   [forward, right]       (clips that travel) how far the whole body has moved, in percent of standing hip height\",\n  \"speed  (a clip's header: loops that walk or run in place) how fast the capture travelled, percent of standing hip height a second\"\n],\n\"fps\": 30,\n\"sources\": {\n  \"UAL1\": {\"file\":\"UAL1_Standard.glb\",\"label\":\"Quaternius Universal Animation Library 1\",\"license\":\"CC0 1.0\",\"origin\":\"Universal Animation Library by Quaternius: the free Standard edition, version 2 (June 2026), as Quaternius exports it for Unreal and Godot: UAL1_Standard.glb, its clips in place, and UAL1_Standard_RM.glb, the same clips with root motion (clips that travel are kept from it as <clip>_RM; loops take their speed from it)\",\"rest\":{\"Cr\":[[0.99948,0,0.03239],[0,1,0],[-0.03239,0,0.99948]],\"H0\":916.7,\"Hr\":[[0.99947,0,-0.03252],[0,1,0],[0.03252,0,0.99947]],\"Pr\":[[1,0,0],[0,1,0],[0,0,1]],\"ab\":173.3,\"abPitch\":30.71,\"ankleZ\":103.7,\"bt\":78.9,\"btPitch\":0,\"clav\":{\"L\":[80.9,-18.8,-32.3],\"R\":[80.9,18.8,-32.3]},\"cv\":{\"L\":[-137.3,-173.1,-12.7],\"R\":[-137.3,173.1,-12.7]},\"faceH\":[119.9,0,3.9],\"fist\":163.93,\"fore\":272.64,\"hip\":{\"L\":[51.5,-89,15.4],\"R\":[51.5,89,15.4]},\"hipZ\":932.1,\"knuck\":121.71,\"neckSeg\":[15.6,0,81.1],\"neckW\":0.45,\"shin\":429.48,\"spine\":[[34.5,0,133.8],[15.2,0,123.1],[-4.5,0,141.2],[-5.6,0,172.8]],\"spineW\":[0,0,0.5,1],\"thigh\":400.31,\"topH\":[0,0,256],\"up\":274.44},\"rig\":\"unreal\",\"url\":\"https://quaternius.com/packs/universalanimationlibrary.html\"},\n  \"UAL2\": {\"file\":\"UAL2_Standard.glb\",\"label\":\"Quaternius Universal Animation Library 2\",\"license\":\"CC0 1.0\",\"origin\":\"Universal Animation Library 2 by Quaternius: the free Standard edition, version 2 (June 2026), as Quaternius exports it for Unreal and Godot: UAL2_Standard.glb, its clips in place, and UAL2_Standard_RM.glb, the same clips with root motion (clips that travel are kept from it as <clip>_RM; loops take their speed from it)\",\"rest\":{\"Cr\":[[0.99948,0,0.03239],[0,1,0],[-0.03239,0,0.99948]],\"H0\":916.7,\"Hr\":[[0.99947,0,-0.03252],[0,1,0],[0.03252,0,0.99947]],\"Pr\":[[1,0,0],[0,1,0],[0,0,1]],\"ab\":173.3,\"abPitch\":30.71,\"ankleZ\":103.7,\"bt\":78.9,\"btPitch\":0,\"clav\":{\"L\":[80.9,-18.8,-32.3],\"R\":[80.9,18.8,-32.3]},\"cv\":{\"L\":[-137.3,-173.1,-12.7],\"R\":[-137.3,173.1,-12.7]},\"faceH\":[119.9,0,3.9],\"fist\":163.93,\"fore\":272.64,\"hip\":{\"L\":[51.5,-89,15.4],\"R\":[51.5,89,15.4]},\"hipZ\":932.1,\"knuck\":121.71,\"neckSeg\":[15.6,0,81.1],\"neckW\":0.6,\"shin\":429.48,\"spine\":[[34.5,0,133.8],[15.2,0,123.1],[-4.5,0,141.2],[-5.6,0,172.8]],\"spineW\":[0,0,0.55,1],\"thigh\":400.31,\"topH\":[0,0,256],\"up\":274.44},\"rig\":\"unreal\",\"url\":\"https://quaternius.com/packs/universalanimationlibrary2.html\"}\n},\n\"fit\": {\"A_TPose\": [3,6], \"Chest_Open\": [15,82], \"ClimbUp_1m\": [20,118], \"ClimbUp_1m_RM\": [21,117], \"Consume\": [14,66], \"Crouch_Fwd_Loop\": [11,53], \"Crouch_Idle_Loop