{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nhub=Path('hub');keep=['session.js','harness.html','bridge.js','round.js','README.md']\nfor n in keep:shutil.copyfile(hub/'lib/hub'/n,hub/n)\nfor p in list(hub.iterdir()):\n if p.name in keep:continue\n if p.is_dir():shutil.rmtree(p)\n else:p.unlink()\np=Path('tools/page.py');s=p.read_text().replace(\\\"hub/lib/hub/session.js\\\",\\\"hub/session.js\\\");p.write_text(s)\np=Path('engine/crates/pav_audio/src/merc.rs');s=p.read_text().replace('let fire=g.fire.cells','let fire_count=g.fire.cells').replace('if fire>0{','if fire_count>0{').replace('(fire as f32/100.)','(fire_count as f32/100.)');p.write_text(s)\np=Path('engine/scripts/build-web.sh');s=p.read_text().replace('bindgen=\"'$(mktemp -d)'\"','mkdir -p target/pack-tmp\\\\n\\\\tbindgen=\"'$(mktemp -d target/pack-tmp/bindgen.XXXXXX)'\"');p.write_text(s)\nPY\nCARGO_BUILD_JOBS=10 cargo build --manifest-path engine/Cargo.toml -p pav_tools --bin pav > notes/build-native.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
