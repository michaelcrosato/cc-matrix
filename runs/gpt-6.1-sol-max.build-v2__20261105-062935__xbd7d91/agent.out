{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/src/games/merc/mod.rs');s=p.read_text();s=s.replace('sim.state.statics.set_terrain(&mut sim.state.physics,key,patch);','''sim.state.statics.set_terrain(&mut sim.state.physics,key,patch);\n for ix in 0..4 {let x=(c.0+dx) as f32*32.+ix as f32*8.;let rz=terrain::river_z(&self.data,x+4.);let z0=(c.1+dz) as f32*32.;let z1=z0+32.;let lo=(rz-13.).max(z0);let hi=(rz+13.).min(z1);if hi>lo&& \"'!((x-40.).abs()<10.) {let zone:crate::zones::Zone=serde_json::from_value(serde_json::json!({\"min\":[x,-9.,lo],\"max\":[x+8.,0.2,hi],\"kind\":\"water\",\"color\":\"#3d6a6a\"})).unwrap();sim.state.statics.add_zone_to(key,zone);}}\n'\"''');s=s.replace('if input.down(b::PRIMARY)&&self.action','let swimming=sim.player().and_then(|p|p.character.as_ref()).is_some_and(|c|c.swimming);\\\\n if input.down(b::PRIMARY)&&\"'!swimming&&self.action'\"');p.write_text(s)\nPY\ncat > tools/stamps.py <<'PY'\nfrom pathlib import Path\nfor name in ['bar','shop','clinic','safehouse','hotel','works']:\n s=f'''name = \\\"{name.title()} compound\\\"\nabout = \\\"An open-front compound with shelter, cover and field services.\\\"\nentrance = {{at=[6,8],facing=\\\"south\\\"}}\n[layout]\norigin=[0.0,0.0,0.0]\n[[layout.layer]]\ny=0\nmap='''+\\\"'''\\\"+'''\n#############\n#...........#\n#..c.....c..#\n#...........#\n#....b......#\n#...........#\n#..c.....c..#\n#...........#\n#####...#####\n'''+\\\"'''\\\"+'''\n[layout.legend.'.']\nblocks=[{y0=-0.2,y1=0,color=\\\"#8b7959\\\"}]\n[layout.legend.'#']\nblocks=[{y0=-0.2,y1=0,color=\\\"#8b7959\\\"},{y0=0,y1=3,color=\\\"#c0a57b\\\"}]\n[layout.legend.'c']\nmarker=\\\"cover\\\"\nblocks=[{y0=-0.2,y1=0,color=\\\"#8b7959\\\"},{y0=0,y1=0.8,color=\\\"#9c8b65\\\"}]\n[layout.legend.'b']\nmarker=\\\"bed\\\"\nblocks=[{y0=-0.2,y1=0,color=\\\"#8b7959\\\"}]\n'''\n Path('engine/game/merc/stamps/'+name+'.toml').write_text(s)\nPY\npython3 tools/stamps.py\ncat > engine/crates/pav_core/src/games/merc/structures.rs <<'RS'\n//\"'! Compound solids mirror the authored open-front assets, so bullets and movement agree.\nuse crate::Sim;\nuse glam::Vec3;\nuse super::{Merc,terrain};\npub fn build(sim:&mut Sim,g:&Merc){for p in &g.data.world.place{let h=terrain::height(&g.data,p.x,p.z);let x=p.x-13.;let z=p.z-5.;let scale=if p.kind==9{2.8}else{1.};let w=if matches!(p.kind,2|5|9){10.}else{7.}*scale;let depth=if p.kind==9{8.5}else{6.}*scale;\n let mut wall=|cx:f32,cy:f32,cz:f32,sx:f32,sy:f32,sz:f32|{sim.state.physics.insert_static(rapier::prelude::ColliderBuilder::cuboid(sx*.5,sy*.5,sz*.5).translation(Vec3::new(cx,cy,cz)));};\n for (cx,cz,sx,sz) in [(x,z-depth*.5,w,.25),(x-w*.5,z,.25,depth),(x+w*.5,z,.25,depth),(x-w*.35,z+depth*.5,w*.3,.25),(x+w*.35,z+depth*.5,w*.3,.25)]{wall(cx,h+1.6*scale,cz,sx,3.2*scale,sz);}\n wall(x,h+3.35*scale,z,w+1.,.2,depth+.8);\n if p.id==\"bridge\"{wall(40.,3.5,40.,12.,1.,210.);}\n}}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\nimport re\np=Path('engine/crates/pav_core/src/games/merc/structures.rs');s=p.read_text();s=re.sub(r'(?<\"'!['\"\\\\w.)\\\\]])\\\\.(\\\\d)',r'0.\\\\1',s);p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/mod.rs');s=p.read_text().replace('pub mod bot;','pub mod bot;\\\\npub mod structures;');s=s.replace('g.stream(sim);sim.state.spawn=g.pos;','g.stream(sim);structures::build(sim,&g);sim.state.spawn=g.pos;');p.write_text(s)\nPY\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('PROGRESS.md');s=p.read_text();s+='''\\\\n## Second implementation checkpoint\\\\n- View added: first-person CameraRig path; typed RenderFrame.merc; NO_FOG render flag; smooth terrain, sky dome/time-of-day, grass/acacias/river, compounds, fire/smoke, new primitive gun/vehicle/environment props, held map/GPS, native pose arms with IK, real Verlet sight rag.\\\\n- UI: pav_ui/tenfoot painter kit with native stencil font (OFL); full title/settings/dev/pause/story/shop/locker/ending screens. Headless tool capture uses the same UI.\\\\n- Shell: dedicated MercApp + Driver (pav_app/merc_shell.rs), fixed tick, JS input via externs, saves, test hooks, sessions/server.\\\\n- Audio: native synth expanded with Pluck; music/SFX/voice buses and original code-generated cues in pav_audio/merc.rs.\\\\n- Web: web/bridge.js input/Hub/BC/WebRTC; tools/page.py builds engine/web/index.html with byte-identical first session client. Hub clone reduced to required protocol files (was 5.3GB).\\\\n- Build: tools/build-game.sh; wasm dist first build running, notes/build-web.log (session 39178). Native pav rebuild session 68229; tests rebuild session 66299. Other build/check sessions may already have exited.\\\\n- First sim suite found 2 issues (1 critical): unsupported socket names -> gun assets absent; excessive fire propagation -> oversized snapshots. Added socket vocabulary and reduced spread_rate to .16. 13 other tests passed. Feedback log updated.\\\\n- Just added water zones and compound physics; not yet compiled/verified.\\\\n- Next: finish compile, capture title/gameplay; run native suite and campaign bot (ignored test for now); fix behavior, fill browser/hub/audio tests and full coverage; package, final feedback/exit interview, process cleanup.\\\\n''';p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
