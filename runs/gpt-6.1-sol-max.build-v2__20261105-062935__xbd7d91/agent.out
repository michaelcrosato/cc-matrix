{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"sed -n '580,676p' engine/crates/pav_audio/src/lib.rs && sed -n '167,191p' engine/crates/pav_audio/src/lib.rs && tail -100 notes/check-ui.log && sed -n '1,45p' engine/crates/pav_app/src/boot.rs && sed -n '1,50p' engine/scripts/pack_single_html.py\"","aggregated_output":"enum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}\n\n/// Live output through the default sound device.\npub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}\n\nimpl AudioOut {\n    pub fn start() -> anyhow::Result<Self> {\n        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n        let host = cpal::default_host();\n        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n        let supported = device.default_output_config()?;\n        let format = supported.sample_format();\n        let config: cpal::StreamConfig = supported.config();\n        let rate = config.sample_rate as u32;\n        let channels = config.channels as usize;\n        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        let (pan, gain) = match event_pos(ev) {\n            Some(p) => {\n                let d = p - l.pos;\n                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n            }\n            None => (0.0, 1.0),\n        };\n        for (patch, delay) in sounds_for(ev) {\n            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n        }\n    }\n\n    pub fn set_master(&self, v: f32) {\n        let _ = self.tx.send(Cmd::Master(v));\n    }\n\n    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n    /// so the browser build calls this on the first input.\n    pub fn resume(&self) {\n        use cpal::traits::StreamTrait;\n        let _ = self._stream.play();\n    }\n}\n\nfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\nwhere\n    T: cpal::SizedSample + cpal::FromSample<f32>,\n{\n    use cpal::traits::DeviceTrait;\n    let mut mixer = Mixer::new(config.sample_rate as f32);\n    let mut buf: Vec<f32> = Vec::new();\n    let stream = device.build_output_stream::<T, _, _>(\n        config,\n        move |data: &mut [T], _| {\n            while let Ok(c) = rx.try_recv() {\n                match c {\n                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                }\n            }\n            let frames = data.len() / channels.max(1);\n            buf.resize(frames * 2, 0.0);\n            mixer.render(&mut buf);\n            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n                for (c, s) in frame.iter_mut().enumerate() {\n                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n                }\n            }\n        },\n        |e| log::warn!(\"audio stream error: {e}\"),\n        None,\n    )?;\n    Ok(stream)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn explosion_is_loud_then_silent() {\n            gain_r: a.sin() * gain,\n        });\n    }\n\n    /// Renders into an interleaved stereo buffer (overwrites).\n    pub fn render(&mut self, out: &mut [f32]) {\n        let dt = 1.0 / self.sample_rate;\n        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }\n            // Soft clip.\n            let m = self.master;\n            frame[0] = (l * m).tanh();\n            if frame.len() > 1 {\n                frame[1] = (r * m).tanh();\n            }\n        }\n        self.voices.retain(|v| !v.done());\n    }\n\n    pub fn active(&self) -> usize {\n   Compiling thiserror v2.0.21\n    Checking smallvec v1.16.2\n    Checking log v0.4.34\n    Checking polycool v0.4.0\n    Checking font-types v0.12.5\n    Checking color v0.3.3\n    Checking euclid v0.22.14\n    Checking linebender_resource_handle v0.1.1\n   Compiling version_check v0.9.5\n    Checking either v1.18.0\n   Compiling unicode-general-category v1.1.0\n    Checking fearless_simd v0.4.1\n    Checking parking_lot_core v0.9.12\n    Checking kurbo v0.13.1\n    Checking rstar v0.13.0\n    Checking parking_lot v0.12.5\n    Checking read-fonts v0.41.0\n    Checking guillotiere v0.7.0\n    Checking ena v0.14.4\n    Checking emath v0.36.2\n    Checking unicode-segmentation v1.13.3\n    Checking nohash-hasher v0.2.0\n    Checking self_cell v1.3.0\n    Checking rustc-hash v2.1.3\n    Checking uuid v1.26.1\n    Checking type-map v0.5.1\n    Checking itertools v0.15.0\n    Checking ecolor v0.36.2\n    Checking accesskit v0.24.1\n    Checking web-time v1.1.0\n    Checking naga-types v30.0.1\n    Checking gpu-allocator v0.28.0\n    Checking parry3d v0.31.1\n    Checking peniko v0.6.1\n   Compiling ahash v0.8.12\n    Checking naga v30.0.1\n    Checking wgpu-types v30.0.1\n    Checking vello_common v0.1.0\n    Checking vello_cpu v0.1.0\n    Checking rapier3d v0.36.0\n    Checking harfrust v0.12.0\n    Checking skrifa v0.44.0\n    Checking wgpu-naga-bridge v30.0.1\n    Checking wgpu-hal v30.0.1\n    Checking epaint v0.36.2\n    Checking wgpu-core-deps-windows-linux-android v30.0.1\n    Checking wgpu-core v30.0.1\n    Checking egui v0.36.2\n//! Boot diagnostics and logging. Every startup stage is numbered and timed, and goes to the\n//! terminal, the log file and the on-screen overlay. The logger also keeps recent lines for\n//! the in-game console.\n\nuse std::collections::VecDeque;\nuse std::fs::File;\nuse std::io::Write;\nuse std::path::PathBuf;\nuse std::sync::{Mutex, OnceLock};\n\nuse web_time::Instant;\n\nuse anyhow::Result;\n\n#[derive(Clone, Debug)]\npub enum StageStatus {\n    Ok,\n    Failed(String),\n}\n\n#[derive(Clone, Debug)]\npub struct Stage {\n    pub num: u32,\n    pub name: String,\n    pub detail: String,\n    pub ms: f64,\n    pub status: StageStatus,\n}\n\npub struct Diagnostics {\n    pub start: Instant,\n    pub log_path: PathBuf,\n    file: Mutex<Option<File>>,\n    pub stages: Mutex<Vec<Stage>>,\n    pub recent: Mutex<VecDeque<(log::Level, String)>>,\n    level: log::LevelFilter,\n}\n\nstatic DIAG: OnceLock<Diagnostics> = OnceLock::new();\n\npub fn diag() -> &'static Diagnostics {\n    DIAG.get().expect(\"diagnostics not initialised\")\n}\n\n/// Directory next to the executable (falls back to the working directory).\n#!/usr/bin/env python3\n\"\"\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\n\nusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\n           [--theme-color C] [--scene NAME] [--out PATH]\n\nBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\n--single-file makes it and runs this. The page is web/index.html with the options written into\nits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\ngiven), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\nloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\ninline module script. The loader shows a progress line, bakes in --scene (used when the address\nnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\nURLs are needed. Out: target/web/<title>.html.\n\"\"\"\nimport argparse\nimport base64\nimport gzip\nimport html\nimport json\nimport pathlib\nimport re\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nPAGE = ROOT / \"web\" / \"index.html\"\n\n# Runs while the page parses, before index.html's module script.\nLOADER = \"\"\"\n(() => {\n  const msg = document.getElementById('msg');\n  // The start scene baked in at build time, unless the address names a room or a scene.\n  const scene = __SCENE__, query = new URLSearchParams(location.search);\n  if (scene && !query.get('room') && !query.get('scene')) {\n    query.set('scene', scene);\n    try { history.replaceState(history.state, '', '?' + query + location.hash); }\n    catch (error) { console.warn('Could not put the start scene in the address:', error); }\n  }\n  const line = document.createElement('div');\n  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\n  msg.style.flexDirection = 'column';\n  msg.style.gap = '8px';\n  msg.replaceChildren(`Loading ${document.title}…`, line);\n  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\n  // The JS glue is the module script at the end of the page: it hands over its init function.\n  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\n  window.loadGame = async () => {\n    line.textContent = 'Unpacking…';\n    await paint();\n    // The gzipped wasm's base64 block leaves the page once read, to free its text.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc 'CARGO_BUILD_JOBS=10 cargo check --manifest-path engine/Cargo.toml -p pav_ui -p pav_view > notes/check-ui.log 2>&1'","aggregated_output":"","exit_code":101,"status":"failed"}}
{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_audio/src/merc.rs <<'RS'\n//\"'! Original generative score, field patches and vowel blips, shared by live and offline output.\nuse crate::{Patch,Wave,Mixer};\nuse pav_core::games::merc::Merc;\n#[derive(Clone,Copy,Debug)]pub enum Bus{Music,Sfx,Voice}\n#[derive(Clone,Debug)]pub struct Cue{pub patch:Patch,pub bus:Bus,pub pan:f32,pub gain:f32,pub delay:f32}\nimpl Cue{fn new(patch:Patch,bus:Bus,gain:f32,delay:f32)->Self{Self{patch,bus,pan:0.,gain,delay}}}\npub fn weapon(family:u8)->Vec<Cue>{let mut n=Patch::new(Wave::Noise,80.+family as f32*70.);n.decay=0.06+family as f32*0.018;n.release=0.1;n.cutoff=4200.-family as f32*500.;n.cutoff_end=300.;n.volume=.4;let mut b=Patch::new(Wave::Sine,95.-family as f32*7.);b.freq_end=35.;b.glide=.1;b.decay=.14;b.release=.03;b.volume=.5;vec![Cue::new(n,Bus::Sfx,1.,0.),Cue::new(b,Bus::Sfx,1.,0.)]}\npub fn voice(speaker:&str,text:&str,tape:bool)->Vec<Cue>{let h=speaker.bytes().fold(0u32,|a,b|a.wrapping_mul(31).wrapping_add(b as u32));let base=135.+(h%110) as f32;let mut cues=Vec::new();for (i,ch) in text.chars().filter(|c|c.is_alphabetic()).step_by(3).take(24).enumerate(){let code=ch as u32;let mut p=Patch::new(Wave::Saw,base*(1.+((code%7) as f32-3.)*.045));p.freq_end=p.freq*if i%3==0{1.12}else{.92};p.glide=.08;p.attack=.012;p.decay=.03;p.sustain=.4;p.hold=.025;p.release=.03;p.volume=.18;p.cutoff=if tape{1300.}else{700.+(code%5) as f32*400.};p.cutoff_end=500.;cues.push(Cue::new(p,Bus::Voice,1.,i as f32*.075));}cues}\npub fn effect(kind:u8)->Vec<Cue>{if (20..25).contains(&kind){return weapon(kind-20);}let mut p=Patch::new(if matches!(kind,0|1|3|33){Wave::Sine}else{Wave::Noise},match kind{0=>750.,1=>190.,3=>520.,33=>950.,_=>110.});p.decay=if kind==30{.65}else{.08};p.release=if kind==30{.5}else{.06};p.cutoff=if kind==30{600.}else{2200.};p.cutoff_end=120.;p.volume=if kind==0{.08}else{.28};if kind==30{p.freq=45.;p.freq_end=18.;}vec![Cue::new(p,Bus::Sfx,1.,0.)]}\n#[derive(Default)]pub struct Score{pub clock:f32,pub beat:u64,pub voice_serial:u32,pub sound_serial:u32,pub since_step:f32}\nimpl Score{pub fn update(&mut self,g:&Merc,dt:f32)->Vec<Cue>{let mut out=Vec::new();if g.finished{return out;}self.clock-=dt;if self.clock<=0.{self.clock+=.4;self.beat+=1;let combat=g.soldiers.iter().any(|n|n.state==2&&n.hp>0.&&pav_core::games::merc::data::distance(n.pos,g.pos)<80.);let notes=[0,7,10,3,7,0,5,10,12,7,3,5];let n=notes[self.beat as usize%notes.len()];let mut p=Patch::new(Wave::Pluck,110.*2f32.powf(n as f32/12.));p.decay=.8;p.release=.2;p.volume=.35;p.cutoff=3000.;out.push(Cue::new(p,Bus::Music,1.,0.));if self.beat%4==0{let mut drum=Patch::new(Wave::Sine,85.);drum.freq_end=28.;drum.glide=.09;drum.decay=.15;drum.volume=.25;out.push(Cue::new(drum,Bus::Music,1.,0.));}if combat{let mut guitar=Patch::new(Wave::Saw,55.*2f32.powf(n as f32/12.));guitar.decay=.3;guitar.volume=.1;guitar.cutoff=500.;out.push(Cue::new(guitar,Bus::Music,1.,0.));}\n let mut wind=Patch::new(Wave::Noise,100.);wind.attack=.06;wind.decay=.4;wind.release=.15;wind.volume=.06*(g.wind_speed/12.);wind.cutoff=500.;wind.cutoff_end=300.;out.push(Cue::new(wind,Bus::Sfx,1.,0.));let fire=g.fire.cells.iter().filter(|&(&(x,z),c)|c.state==1&&glam::Vec2::new(x as f32*2.,z as f32*2.).distance(pav_core::games::merc::data::flat(g.pos))<50.).count();if fire>0{let mut fire=Patch::new(Wave::Noise,50.);fire.attack=.01;fire.decay=.35;fire.release=.15;fire.volume=(fire as f32/100.).sqrt().min(1.)*.28;fire.cutoff=1200.;fire.cutoff_end=800.;out.push(Cue::new(fire,Bus::Sfx,1.,0.));}if let Some(i)=g.riding{let v=&g.vehicles[i];let mut engine=Patch::new(Wave::Saw,30.+v.speed.abs()*3.);engine.decay=.4;engine.release=.1;engine.volume=.13;engine.cutoff=350.;out.push(Cue::new(engine,Bus::Sfx,1.,0.));}if g.health<20.{let mut heart=Patch::new(Wave::Sine,48.);heart.decay=.15;heart.volume=.20;out.push(Cue::new(heart,Bus::Sfx,1.,0.));}if g.fever_state>0{let mut ring=Patch::new(Wave::Sine,2800.);ring.decay=.4;ring.volume=.025;out.push(Cue::new(ring,Bus::Sfx,1.,0.));}}\n if g.sound_serial!=self.sound_serial{self.sound_serial=g.sound_serial;out.extend(effect(g.sound_kind));}if g.voice_serial!=self.voice_serial{self.voice_serial=g.voice_serial;out.extend(voice(&g.speaker,&g.subtitle,g.playing_tape.is_some()));}\n self.since_step+=dt;if g.speed>1.&&self.since_step>0.5 {self.since_step=0.;let mut step=Patch::new(Wave::Noise,100.);step.decay=.04;step.release=.03;step.volume=.1;step.cutoff=850.;out.push(Cue::new(step,Bus::Sfx,1.,0.));}out}}\npub fn gain(g:&Merc,b:Bus)->f32{match b{Bus::Music=>g.settings.music*if g.subtitle_time>0.{.45}else{1.},Bus::Sfx=>g.settings.sfx,Bus::Voice=>g.settings.voices}}\npub fn render(cues:&[Cue],seconds:f32,bus_gain:f32)->Vec<f32>{let mut m=Mixer::new(24000.);m.master=.8;for c in cues{m.play(c.patch,c.pan,c.gain*bus_gain,c.delay);}let mut out=vec![0.;(seconds*24000.) as usize*2];m.render(&mut out);out}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\nimport re\np=Path('engine/crates/pav_audio/src/merc.rs');s=p.read_text();s=re.sub(r'(?<\"'!['\"\\\\w.)\\\\]])\\\\.(\\\\d)',r'0.\\\\1',s);p.write_text(s)\np=Path('engine/crates/pav_audio/src/lib.rs');s=p.read_text().replace('use std::sync::mpsc','pub mod merc;\\\\n\\\\nuse std::sync::mpsc',1).replace('    Noise,','    Noise,\\\\n    Pluck,',1).replace('    gain_l: f32,','    pluck:Vec<f32>,\\\\n    pluck_i:usize,\\\\n    gain_l: f32,',1).replace('            Wave::Noise => {','            Wave::Pluck=>{let i=self.pluck_i;let j=(i+1)%self.pluck.len();let s=self.pluck[i];self.pluck[i]=(s+self.pluck[j])*0.497;self.pluck_i=j;s},\\\\n            Wave::Noise => {',1).replace('            gain_l: a.cos() * gain,','            pluck:(0..(self.sample_rate/p.freq.max(20.)).max(2.) as usize).map(|i|{let n=(self.seed.wrapping_add(i as u32*19661))\"'^(i as u32).wrapping_mul(736939);(n as f32/u32::MAX as f32)*2.-1.}).collect(),'\"\\\\n            pluck_i:0,\\\\n            gain_l: a.cos() * gain,',1).replace('    pub fn set_master(&self, v: f32) {','    pub fn play_patch(&self,p:Patch,pan:f32,gain:f32,delay:f32){let _=self.tx.send(Cmd::Play(p,pan,gain,delay));}\\\\n\\\\n    pub fn set_master(&self, v: f32) {',1);p.write_text(s)\np=Path('engine/crates/pav_view/src/merc/mod.rs');s=p.read_text().replace('filter(|(&(x,z),_)|','filter(|&(&(x,z),_)|');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
