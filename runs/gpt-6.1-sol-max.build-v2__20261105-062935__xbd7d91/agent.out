en=isMenu()||\"'!!document.pointerLockElement||device===1;},\n    send(s,reliable,to){if(ended)return;const d=JSON.parse(s);if(AIHub.active){AIHub.send(d,{reliable,to:to<0?undefined:to});}else if(transport==='\"'bc')broadcast({kind:'message',data:d,from:local.id});else if(transport==='rtc'){for(const peer of local.rtc){const channel=reliable?peer.reliable:peer.fast;if(channel?.readyState==='open')channel.send(JSON.stringify({kind:'message',data:d,from:local.id}));}}},\n    loaded(){if(AIHub.active)AIHub.ready();},save(slot,s){if(AIHub.active)return;try{localStorage.setItem('fair-contract-v1-'+slot,s);}catch(_){}} ,load(slot){if(AIHub.active)return '';try{return localStorage.getItem('fair-contract-v1-'+slot)||'';}catch(_){return '';}},\n    finish(s){finish(JSON.parse(s));},failed(s){AIHub.fail(s);document.getElementById('support').hidden=false;document.getElementById('support-message').textContent=s;},\n    networkUi(n){if(AIHub.active)return;networkUi(n);}\n  };\n  let channel=null;\n  function broadcast(data){if(channel)channel.postMessage({...data,room:local.room});}\n  function setupBC(host){transport='bc';local.host=host;local.id=host?0:1;if(channel)channel.close();channel=new BroadcastChannel(local.room);channel.onmessage=e=>{const d=e.data;if(d.kind==='hello'&&local.host){const existing=local.players.find(p=>p.token=[REDACTED_SECRET] id=existing?.id??Math.min(3,local.players.length);if(\"'!existing)local.players.push({id,token:[REDACTED_SECRET]'\"'welcome',token:[REDACTED_SECRET] if(d.kind==='welcome'&&\"'!local.host&&d.token=[REDACTED_SECRET] if(d.kind==='\"'start'){startLocal(d);}else if(d.kind==='message'){events.push(d);}else if(d.kind==='end')endLocal(d.result);};local.token=[REDACTED_SECRET]\"'!host)broadcast({kind:'\"'hello',token:[REDACTED_SECRET]\n  function updateLobby(){const el=document.getElementById('network-status');el.textContent=\"'`${local.host?'\"'HOST':'JOINED'} · MERC \"'${local.id+1} · ${local.players.length||1}/4 connected`;el.hidden=fa