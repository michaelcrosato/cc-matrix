nd=18.;}vec![Cue::new(p,Bus::Sfx,1.,0.)]}\n#[derive(Default)]pub struct Score{pub clock:f32,pub beat:u64,pub voice_serial:u32,pub sound_serial:u32,pub since_step:f32}\nimpl Score{pub fn update(&mut self,g:&Merc,dt:f32)->Vec<Cue>{let mut out=Vec::new();if g.finished{return out;}self.clock-=dt;if self.clock<=0.{self.clock+=.4;self.beat+=1;let combat=g.soldiers.iter().any(|n|n.state==2&&n.hp>0.&&pav_core::games::merc::data::distance(n.pos,g.pos)<80.);let notes=[0,7,10,3,7,0,5,10,12,7,3,5];let n=notes[self.beat as usize%notes.len()];let mut p=Patch::new(Wave::Pluck,110.*2f32.powf(n as f32/12.));p.decay=.8;p.release=.2;p.volume=.35;p.cutoff=3000.;out.push(Cue::new(p,Bus::Music,1.,0.));if self.beat%4==0{let mut drum=Patch::new(Wave::Sine,85.);drum.freq_end=28.;drum.glide=.09;drum.decay=.15;drum.volume=.25;out.push(Cue::new(drum,Bus::Music,1.,0.));}if combat{let mut guitar=Patch::new(Wave::Saw,55.*2f32.powf(n as f32/12.));guitar.decay=.3;guitar.volume=.1;guitar.cutoff=500.;out.push(Cue::new(guitar,Bus::Music,1.,0.));}\n let mut wind=Patch::new(Wave::Noise,100.);wind.attack=.06;wind.decay=.4;wind.release=.15;wind.volume=.06*(g.wind_speed/12.);wind.cutoff=500.;wind.cutoff_end=300.;out.push(Cue::new(wind,Bus::Sfx,1.,0.));let fire=g.fire.cells.iter().filter(|&(&(x,z),c)|c.state==1&&glam::Vec2::new(x as f32*2.,z as f32*2.).distance(pav_core::games::merc::data::flat(g.pos))<50.).count();if fire>0{let mut fire=Patch::new(Wave::Noise,50.);fire.attack=.01;fire.decay=.35;fire.release=.15;fire.volume=(fire as f32/100.).sqrt().min(1.)*.28;fire.cutoff=1200.;fire.cutoff_end=800.;out.push(Cue::new(fire,Bus::Sfx,1.,0.));}if let Some(i)=g.riding{let v=&g.vehicles[i];let mut engine=Patch::new(Wave::Saw,30.+v.speed.abs()*3.);engine.decay=.4;engine.release=.1;engine.volume=.13;engine.cutoff=350.;out.push(Cue::new(engine,Bus::Sfx,1.,0.));}if g.health<20.{let mut heart=Patch::new(Wave::Sine,48.);heart.decay=.15;heart.volume=.20;out.push(Cue::new(heart,Bus::Sfx,1.,0.));}if g.fever_state>0{let mut ring=Patch::new(Wave::Sine,2800.);ring.decay=.4;ring.volume=.025;out.push(Cue::new(ring,Bus::Sfx,1.,0.));}}\n if g.sound_serial!=self.sound_serial{self.sound_serial=g.sound_serial;out.extend(effect(g.sound_kind));}if g.voice_serial!=self.voice_serial{self.voice_serial=g.voice_serial;out.extend(voice(&g.speaker,&g.subtitle,g.playing_tape.is_some()));}\n self.since_step+=dt;if g.speed>1.&&self.since_step>0.5 {self.since_step=0.;let mut step=Patch::new(Wave::Noise,100.);step.decay=.04;step.release=.03;step.volume=.1;step.cutoff=850.;out.push(Cue::new(step,Bus::Sfx,1.,0.));}out}}\npub fn gain(g:&Merc,b:Bus)->f32{match b{Bus::Music=>g.settings.music*if g.subtitle_time>0.{.45}else{1.},Bus::Sfx=>g.settings.sfx,Bus::Voice=>g.settings.voices}}\npub fn render(cues:&[Cue],seconds:f32,bus_gain:f32)->Vec<f32>{let mut m=Mixer::new(24000.);m.master=.8;for c in cues{m.play(c.patch,c.pan,c.gain*bus_gain,c.delay);}let mut out=vec![0.;(seconds*24000.) as usize*2];m.render(&mut out);out}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\nimport re\np=Path('engine/crates/pav_audio/src/merc.rs');s=p.read_text();s=re.sub(r'(?<\"'!['\"\\\\w.)\\\\]])\\\\.(\\\\d)',r'0.\\\\1',s);p.write_text(s)\np=Path('engine/crates/pav_audio/src/lib.rs');s=p.read_text().replace('use std::sync::mpsc','pub mod merc;\\\\n\\\\nuse std::sync::mpsc',1).replace('    Noise,','    Noise,\\\\n    Pluck,',1).replace('    gain_l: f32,','    pluck:Vec<f32>,\\\\n    pluck_i:usize,\\\\n    gain_l: f32,',1).replace('            Wave::Noise => {','            Wave::Pluck=>{let i=self.pluck_i;let j=(i+1)%self.pluck.len();let s=self.pluck[i];self.pluck[i]=(s+self.pluck[j])*0.497;self.pluck_i=j;s},\\\\n            Wave::Noise => {',1).replace('            gain_l: a.cos() * gain,','            pluck:(0..(self.sample_rate/p.freq.max(20.)).max(2.) as usize).map(|i|{let n=(self.seed.wrapping_add(i as u32*19661))\"'^(i as u32).wrapping_mul(736939);(n as f32/u32::MAX as f32)*2.-1.}).collect(),'\"\\\\n            pluck_i:0,\\\\n            gain_l: a.cos() * gain,',1).replace('    pub fn set_master(&self, v: f32) {','    pub fn play_patch(&self,p:Patch,pan:f32,gain:f32,delay:f32){let _=self.tx.send(Cmd::Play(p,pan,gain,delay));}\\\\n\\\\n    pub fn set_master(&self, v: f32) {',1);p.write_text(s)\np=Path('engine/crates/pav_view/src/merc/mod.rs');s=p.read_text().replace('filter(|(&(x,z),_)|','filter(|&(&(x,z),_)|');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_app/src/merc_shell.rs <<'RS'\n//\"'! The game shell has no Pavilion overlays. It owns fixed-step input, saves and transport I/O.\nuse std::{cell::RefCell,rc::Rc,sync::Arc,collections::{BTreeSet,VecDeque}};\nuse anyhow::Result;\nuse glam::{Vec2,Vec3};\nuse pav_core::{Sim,InputFrame,games::{Game,GameBox,merc::{Merc,act,net::Packet}},input::buttons as b};\nuse pav_view::{ViewBuilder,ViewSettings,CameraRig};\nuse winit::{application::ApplicationHandler,event_loop::{EventLoop,ActiveEventLoop,ControlFlow},event::{WindowEvent,DeviceEvent,ElementState,MouseButton},keyboard::{KeyCode,PhysicalKey},window::{Window,WindowId}};\nuse web_time::Instant;\nuse crate::{gfx::Gfx,uiinput::UiInput,settings::Settings};\n#[cfg(target_arch=\"wasm32\")]\nuse wasm_bindgen::prelude::*;\n#[cfg(target_arch=\"wasm32\")]\n#[wasm_bindgen]\nextern \"C\"{\n #[wasm_bindgen(js_namespace=gameBridge,js_name=config)]fn bridge_config()->String;\n #[wasm_bindgen(js_namespace=gameBridge,js_name=poll)]fn bridge_poll()->String;\n #[wasm_bindgen(js_namespace=gameBridge,js_name=publish)]fn bridge_publish(s:&str);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=send)]fn bridge_send(s:&str,reliable:bool,to:i32);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=loaded)]fn bridge_loaded();\n #[wasm_bindgen(js_namespace=gameBridge,js_name=save)]fn bridge_save(slot:i32,s:&str);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=load)]fn bridge_load(slot:i32)->String;\n #[wasm_bindgen(js_namespace=gameBridge,js_name=finish)]fn bridge_finish(s:&str);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=networkUi)]fn bridge_network_ui(n:i32);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=failed)]fn bridge_failed(s:&str);\n}\nfn game(sim:&Sim)->&Merc{sim.state.play.as_ref().unwrap().get::<Merc>().unwrap()}\nfn game_mut(sim:&mut Sim)->&mut Merc{sim.state.play.as_mut().unwrap().get_mut::<Merc>().unwrap()}\n#[derive(Default)]struct NativeInput{keys:BTreeSet<KeyCode>,held:u32,pressed:u32,look:Vec2,acts:VecDeque<u32>}\npub struct Driver{pub sim:Sim,last:Instant,accum:f64,native:NativeInput,pub nodraw:bool,pub server:bool,pub ended:bool,network_at:f64,delta_at:f64,delta_part:usize,finish_sent:bool,saved_serial:u32,audio:Option<pav_audio::AudioOut>,score:pav_audio::merc::Score,pub rects:Vec<[f32;4]>,pub ui_action:u32,pub ui_hover:Option<usize>,test:bool,bot:bool,drawn:u64}\nimpl Driver{\n fn new(settings:&Settings)->Result<Self>{#[cfg(target_arch=\"wasm32\")]let config:serde_json::Value=serde_json::from_str(&bridge_config()).unwrap_or_default();#[cfg(not(target_arch=\"wasm32\"))]let config=serde_json::json!({});let info=&config[\"info\"];let session=info.is_object();let seed=info[\"seed\"].as_u64().unwrap_or(settings.seed);let mut sim=Sim::new(if session{\"merc/session\"}else{\"merc\"},seed)?;let server=info[\"server\"].as_bool().unwrap_or(false);if session{let g=game_mut(&mut sim);g.session=true;g.host=info[\"isHost\"].as_bool().unwrap_or(false);g.local_id=if server{255}else{info[\"me\"].as_u64().unwrap_or(0) as u8};g.peers=info[\"players\"].as_array().into_iter().flatten().filter_map(|p|p[\"id\"].as_u64()).filter(|id|*id as u8!=g.local_id).map(|id|pav_core::games::merc::Peer{id:id as u8,pos:g.pos+Vec3::new(id as f32*2.,0.,0.),yaw:0.,pitch:0.,hp:100.,down:0.,seat:-1,present:true,kills:0,rescues:0,jams:0}).collect();}game_mut(&mut sim).touch_only=config[\"touch\"].as_bool().unwrap_or(false);#[cfg(target_arch=\"wasm32\")]bridge_loaded();Ok(Self{sim,last:Instant::now(),accum:0.,native:NativeInput::default(),nodraw:config[\"nodraw\"].as_bool().unwrap_or(false),server,ended:false,network_at:0.,delta_at:0.,delta_part:0,finish_sent:false,saved_serial:0,audio:None,score:Default::default(),rects:Vec::new(),ui_action:0,ui_hover:None,test:config[\"test\"].as_bool().unwrap_or(false),bot:false,drawn:0})}\n fn tick(&mut self){let now=Instant::now();let elapsed=now.duration_since(self.last).as_secs_f64().min(2.);self.last=now;self.accum+=elapsed;\n #[cfg(target_arch=\"wasm32\")]let input:serde_json::Value=serde_json::from_str(&bridge_poll()).unwrap_or_default();#[cfg(not(target_arch=\"wasm32\"))]let input=serde_json::json!({});\n if self.ended{return;}\n #[cfg(target_arch=\"wasm32\")]self.events(&input);\n let g=game(&self.sim);let mut frame=InputFrame::default();if cfg!(target_arch=\"wasm32\"){frame.held=input[\"held\"].as_u64().unwrap_or(0) as u32;frame.pressed=input[\"pressed\"].as_u64().unwrap_or(0) as u32;let vec=|k:&str|Vec2::new(input[k][0].as_f64().unwrap_or(0.) as f32,input[k][1].as_f64().unwrap_or(0.) as f32);let mv=vec(\"move\");frame.move_dir=Vec2::new(g.yaw.cos()*mv.x+g.yaw.sin()*mv.y,g.yaw.sin()*mv.x-g.yaw.cos()*mv.y);if g.riding.is_some(){frame.move_dir=Vec2::new(mv.x,0.);frame.axes=Vec2::new(input[\"throttle\"].as_f64().unwrap_or(mv.y.max(0.) as f64) as f32,input[\"brake\"].as_f64().unwrap_or((-mv.y).max(0.) as f64) as f32);}let mouse=vec(\"look\");let stick=vec(\"stick\");frame.look=mouse*g.settings.mouse.to_radians()+stick*g.settings.stick.to_radians()*elapsed as f32;if g.settings.invert{frame.look.y*=-1.;}frame.act=input[\"act\"].as_u64().unwrap_or(0) as u32;}else{let k=|key|self.native.keys.contains(&key) as i32 as f32;let mv=Vec2::new(k(KeyCode::KeyD)-k(KeyCode::KeyA),k(KeyCode::KeyW)-k(KeyCode::KeyS)).clamp_length_max(1.);frame.move_dir=Vec2::new(g.yaw.cos()*mv.x+g.yaw.sin()*mv.y,g.yaw.sin()*mv.x-g.yaw.cos()*mv.y);frame.held=self.native.held;frame.pressed=std::mem::take(&mut self.native.pressed);frame.look=std::mem::take(&mut self.native.look)*g.settings.mouse.to_radians();frame.act=self.native.acts.pop_front().unwrap_or(0);}\n if self.ui_action!=0{frame.act=std::mem::take(&mut self.ui_action);}if let Some(h)=self.ui_hover.take(){game_mut(&mut self.sim).focus=h;}\n if self.test {if let Some(commands)=input[\"test\"].as_array(){for c in commands{self.test_command(c);}}}\n let steps=((self.accum*60.).floor() as usize).min(180);if steps==0{return;}for n in 0..steps{let mut i=frame;if n>0{i.pressed=0;i.look=Vec2::ZERO;i.act=0;}if self.bot{i=self.sim.bot_input();}if self.server{i=InputFrame::default();}self.sim.step(&i);self.accum=(self.accum-1./60.).max(0.);}\n let mut play=self.sim.state.play.take().unwrap();let g=play.get_mut::<Merc>().unwrap();\n if let Some(d)=input[\"device\"].as_u64(){g.device=d as u8;}if input[\"keyboard\"].as_bool().unwrap_or(false){g.touch_only=false;}\n if g.load_slot>=0&&!g.session {let slot=g.load_slot;g.load_slot=-1;#[cfg(target_arch=\"wasm32\")]let text=bridge_load(slot);#[cfg(not(target_arch=\"wasm32\"))]let text=std::fs::read_to_string(format!(\"../notes/save-{slot}.json\")).unwrap_or_default();match serde_json::from_str::<Merc>(&text){Ok(mut loaded)=>{loaded.screen=\"playing\".into();loaded.streamed=None;loaded.load_slot=-1;loaded.save_slot=-1;loaded.pos.y=pav_core::games::merc::terrain::height(&loaded.data,loaded.pos.x,loaded.pos.z)+0.1;for n in &mut loaded.soldiers{n.entity=None;}for n in &g.soldiers{if let Some(id)=n.entity{self.sim.despawn(id);}}*g=loaded;g.sync_player(&mut self.sim);},Err(_)=>g.note(g.s(\"no_save\").to_string())}}\n if g.save_serial!=self.saved_serial&&!g.session&&!g.attracting{self.saved_serial=g.save_serial;let text=serde_json::to_string(g).unwrap_or_default();#[cfg(target_arch=\"wasm32\")] {bridge_save(0,&text);if g.save_slot>0{bridge_save(g.save_slot,&text);}}#[cfg(not(target_arch=\"wasm32\"))]{let _=std::fs::write(\"../notes/save-0.json\",&text);if g.save_slot>0{let _=std::fs::write(format!(\"../notes/save-{}.json\",g.save_slot),&text);}}g.save_slot=-1;}\n if !self.server{if input[\"gesture\"].as_bool().unwrap_or(false)&&self.audio.is_none(){self.audio=pav_audio::AudioOut::start().ok();}if let Some(audio)=&self.audio{audio.resume();audio.set_master(if self.ended{0.}else{g.settings.master});for c in self.score.update(g,elapsed as f32){audio.play_patch(c.patch,c.pan,c.gain*pav_audio::merc::gain(g,c.bus),c.delay);}}}\n #[cfg(target_arch=\"wasm32\")] {if g.net_ui>0{bridge_network_ui(g.net_ui);g.net_ui=0;}if g.session&&g.round_started&&!self.ended&&!g.finished{self.network_at+=elapsed;self.delta_at+=elapsed;if self.network_at>=0.1{self.network_at=0.;let packet=if g.host{g.snapshot_packet(self.sim.state.tick)}else{g.pose_packet()};bridge_send(&serde_json::to_string(&packet).unwrap(),!g.host,-1);}if g.host&&self.delta_at>=0.2{self.delta_at=0.;let packet=g.delta_packet(self.delta_part);self.delta_part=(self.delta_part+1)%(g.fire.cells.len().div_ceil(350).max(1));bridge_send(&serde_json::to_string(&packet).unwrap(),true,-1);}}if g.finished&&g.host&&!self.finish_sent{self.finish_sent=true;bridge_finish(&serde_json::json!({\"won\":g.won,\"score\":g.team_score,\"kills\":g.kills,\"cells\":g.fire.total,\"jams\":g.coverage.contains(\"jam_cleared\") as i32,\"rescues\":g.coverage.contains(\"player_rescued\") as i32}).to_string());}}\n self.sim.state.play=Some(play);#[cfg(target_arch=\"wasm32\")] {let g=game(&self.sim);let status=g.status(&self.sim);bridge_publish(&serde_json::json!({\"status\":status.to_string(),\"ui\":serde_json::json!({\"screen\":g.screen,\"rows\":g.rows(),\"rects\":self.rects,\"focus\":g.focus,\"page\":g.page,\"device\":g.device,\"xbox\":g.settings.xbox,\"drawn\":self.drawn}).to_string(),\"screen\":g.screen,\"map\":g.map_up,\"voiceSerial\":g.voice_serial,\"subtitle\":g.subtitle,\"soundSerial\":g.sound_serial,\"touch\":g.touch_only}).to_string());}\n }\n #[cfg(target_arch=\"wasm32\")]\n fn events(&mut self,input:&serde_json::Value){if let Some(es)=input[\"events\"].as_array(){for e in es{let kind=e[\"kind\"].as_str().unwrap_or(\"\");if kind==\"message\"{if let Ok(packet)=serde_json::from_value::<Packet>(e[\"data\"].clone()){let mut p=self.sim.state.play.take().unwrap();let g=p.get_mut::<Merc>().unwrap();g.receive(&mut self.sim,e[\"from\"].as_u64().unwrap_or(0) as u8,packet,&mut Vec::new());self.sim.state.play=Some(p);}}else{let g=game_mut(&mut self.sim);match kind{\"start\"=>{g.round_started=true;g.screen=\"playing\".into();g.round_time=0.;},\"leave\"=>g.leave(e[\"id\"].as_u64().unwrap_or(0) as u8),\"time-up\"=>{g.finished=true;g.won=false;},\"end\"=>{self.ended=true;g.finished=true;if let Some(a)=&self.audio{a.set_master(0.);}},\"standalone\"=>{g.session=true;g.host=e[\"host\"].as_bool().unwrap_or(false);g.local_id=e[\"id\"].as_u64().unwrap_or(0) as u8;g.screen=\"card\".into();g.pos=g.data.place(\"depot\").pos()+Vec3::new(-65.+g.local_id as f32*2.,0.,70.);g.pos.y=pav_core::games::merc::terrain::height(&g.data,g.pos.x,g.pos.z);},_=>{}}}}}}\n fn test_command(&mut self,c:&serde_json::Value){let name=c[\"op\"].as_str().unwrap_or(\"\");if name==\"step\"{self.accum+=c[\"seconds\"].as_f64().unwrap_or(0.).min(200.);}else if name==\"bot\"{self.bot=c[\"value\"].as_bool().unwrap_or(true);}else if name==\"act\"{self.ui_action=c[\"value\"].as_u64().unwrap_or(0) as u32;}else if name==\"set\"{let g=game_mut(&mut self.sim);match c[\"key\"].as_str().unwrap_or(\"\"){\"health\"=>g.health=c[\"value\"].as_f64().unwrap_or(100.) as f32,\"fever_timer\"=>g.fever_timer=c[\"value\"].as_f64().unwrap_or(50.) as f32,\"diamonds\"=>g.diamonds=c[\"value\"].as_i64().unwrap_or(0) as i32,\"hour\"=>g.hour=c[\"value\"].as_f64().unwrap_or(12.) as f32,\"condition\"=>g.guns[g.active].condition=c[\"value\"].as_f64().unwrap_or(100.) as f32,\"idle\"=>g.idle=c[\"value\"].as_f64().unwrap_or(0.) as f32,\"weather\"=>g.weather=c[\"value\"].as_u64().unwrap_or(0) as u8,_=>{}}}else if name==\"net_start\"{let g=game_mut(&mut self.sim);g.session=true;g.round_started=true;g.screen=\"playing\".into();}else if name==\"ignite\"{let g=game_mut(&mut self.sim);g.fire.ignite(&g.data,pav_core::games::merc::data::flat(g.pos)+Vec2::splat(12.),5.);} }\n}\npub fn run(settings:Settings)->Result<()>{let driver=Rc::new(RefCell::new(Driver::new(&settings)?));#[cfg(target_arch=\"wasm32\")] {let d=driver.clone();let tick=Closure::<dyn FnMut()>::new(move||{if let Ok(mut d)=d.try_borrow_mut(){d.tick();}});let w=web_sys::window().unwrap();js_sys::Reflect::set(&w,&JsValue::from_str(\"mercPump\"),tick.as_ref())?;tick.forget();if driver.borrow().server{return Ok(());}}\n let event_loop=EventLoop::new()?;event_loop.set_control_flow(ControlFlow::Poll);let app=MercApp{driver,gfx:None,pending:None,ctx:egui::Context::default(),ui:None,builder:ViewBuilder::new(),started:false};#[cfg(target_arch=\"wasm32\")] {use winit::platform::web::EventLoopExtWebSys;event_loop.spawn_app(app);}#[cfg(not(target_arch=\"wasm32\"))]{let mut app=app;event_loop.run_app(&mut app)?;}Ok(())}\nstruct MercApp{driver:Rc<RefCell<Driver>>,gfx:Option<Gfx>,pending:Option<Rc<RefCell<Option<Result<Gfx>>>>>,ctx:egui::Context,ui:Option<UiInput>,builder:ViewBuilder,started:bool}\nimpl MercApp{\n fn finish_init(&mut self,gfx:Gfx){pav_ui::tenfoot::fonts(&self.ctx);self.ui=Some(UiInput::new(&self.ctx,&gfx.window,gfx.device.limits().max_texture_dimension_2d as usize));self.gfx=Some(gfx);}\n fn draw(&mut self){let Some(gfx)=&mut self.gfx else{return;};let mut d=self.driver.borrow_mut();d.tick();let mut frame=d.sim.frame();let (w,h)=gfx.size();if w==0||h==0{return;}let g=game(&d.sim).clone();let mut scene=if d.nodraw{pav_render::Scene::default()}else{self.builder.build(&frame,&frame,1.,&CameraRig::default(),w as f32/h as f32,&ViewSettings::default(),frame.focus)};\n if d.nodraw{scene.post.bloom=0.;scene.post.outlines=false;}let scale=(h as f32/1080.).max(0.25);self.ctx.set_zoom_factor(1.);let raw=self.ui.as_mut().unwrap().take(&gfx.window);let mut action=0;let mut hover=None;let mut rects=Vec::new();let output=self.ctx.run_ui(raw,|ui|{let r=pav_ui::tenfoot::draw(ui,&g);action=r.action;hover=r.hover;rects=r.rows;});let _=scale;d.ui_action=if action!=0{action}else{d.ui_action};d.ui_hover=hover;d.rects=rects;let ppp=output.pixels_per_point;let prims=self.ctx.tessellate(output.shapes,ppp);let mut textures=output.textures_delta;self.ui.as_mut().unwrap().platform_output(&gfx.window,output.platform_output);if gfx.draw(&scene,Some((&prims,&mut textures,ppp))){d.drawn+=1;}let _=&mut frame;\n }\n}\nimpl ApplicationHandler for MercApp{\n fn resumed(&mut self,el:&ActiveEventLoop){if self.started{return;}self.started=true;let mut attrs=Window::default_attributes().with_title(pav_core::games::merc::data::data().s(\"title\")).with_inner_size(winit::dpi::LogicalSize::new(1600.,900.));#[cfg(target_arch=\"wasm32\")] {use winit::platform::web::WindowAttributesExtWebSys;attrs=attrs.with_append(true);}let window=match el.create_window(attrs){Ok(w)=>Arc::new(w),Err(e)=>{log::error!(\"window: {e}\");return;}};\n #[cfg(not(target_arch=\"wasm32\"))]match Gfx::new(window,pav_render::gpu::BackendChoice::Vulkan,true){Ok(g)=>self.finish_init(g),Err(e)=>log::error!(\"graphics: {e}\")}\n #[cfg(target_arch=\"wasm32\")] {let slot=Rc::new(RefCell::new(None));let fill=slot.clone();wasm_bindgen_futures::spawn_local(async move{*fill.borrow_mut()=Some(Gfx::create(window,pav_render::gpu::BackendChoice::Vulkan,true).await);});self.pending=Some(slot);}}\n fn about_to_wait(&mut self,_el:&ActiveEventLoop){let ready=self.pending.as_ref().and_then(|p|p.borrow_mut().take());if let Some(result)=ready {match result{Ok(g)=>self.finish_init(g),Err(e)=>{#[cfg(target_arch=\"wasm32\")]bridge_failed(&format!(\"WebGPU could not start: {e}\"));log::error!(\"{e}\");}}self.pending=None;}self.driver.borrow_mut().tick();if let Some(g)=&self.gfx{g.window.request_redraw();}}\n fn window_event(&mut self,el:&ActiveEventLoop,_id:WindowId,event:WindowEvent){if let (Some(ui),Some(g))=(&mut self.ui,&self.gfx){ui.on_window_event(&g.window,&event);}match event{WindowEvent::CloseRequested=>el.exit(),WindowEvent::Resized(s)=>{if let Some(g)=&mut self.gfx{g.resize(s.width,s.height);}},WindowEvent::RedrawRequested=>self.draw(),_=>{}}\n #[cfg(not(target_arch=\"wasm32\"))] {let mut d=self.driver.borrow_mut();let shell=game(&d.sim).screen!=\"playing\";match &event{WindowEvent::KeyboardInput{event,..}=>{if let PhysicalKey::Code(k)=event.physical_key{let pressed=event.state==ElementState::Pressed;if pressed{d.native.keys.insert(k);}else{d.native.keys.remove(&k);}if pressed&&!event.repeat{let a=key_action(k,shell);if a>0{d.native.acts.push_back(a);}}let bit=key_bit(k);if pressed{d.native.held|=bit;d.native.pressed|=bit;}else{d.native.held&=!bit;}}},WindowEvent::MouseInput{state,button,..}=>{let bit=if *button==MouseButton::Left{b::PRIMARY}else if *button==MouseButton::Right{b::SECONDARY}else{0};if state.is_pressed(){d.native.held|=bit;d.native.pressed|=bit;}else{d.native.held&=!bit;}},_=>{}}}}\n fn device_event(&mut self,_el:&ActiveEventLoop,_id:winit::event::DeviceId,event:DeviceEvent){if let DeviceEvent::MouseMotion{delta}=event{#[cfg(not(target_arch=\"wasm32\"))]{self.driver.borrow_mut().native.look+=Vec2::new(delta.0 as f32,delta.1 as f32);}let _=delta;}}\n}\n#[cfg(not(target_arch=\"wasm32\"))]fn key_bit(k:KeyCode)->u32{match k{KeyCode::ShiftLeft=>b::SPRINT,KeyCode::Space=>b::JUMP,_=>0}}\n#[cfg(not(target_arch=\"wasm32\"))]fn key_action(k:KeyCode,shell:bool)->u32{if k==KeyCode::Escape{return act::PAUSE;}if shell{return match k{KeyCode::ArrowUp|KeyCode::KeyW=>act::UP,KeyCode::ArrowDown|KeyCode::KeyS=>act::DOWN,KeyCode::ArrowLeft=>act::LEFT,KeyCode::ArrowRight=>act::RIGHT,KeyCode::Enter|KeyCode::Space=>act::CONFIRM,KeyCode::KeyQ=>act::PREV,KeyCode::KeyE=>act::NEXT,_=>0};}match k{KeyCode::KeyE=>act::INTERACT,KeyCode::KeyR=>act::RELOAD,KeyCode::KeyQ=>act::NEXT_GUN,KeyCode::KeyG=>act::THROW,KeyCode::KeyV=>act::MELEE,KeyCode::KeyM=>act::MAP,KeyCode::KeyH=>act::HEAL,KeyCode::KeyP=>act::PILL,KeyCode::KeyT=>act::TRACKER,KeyCode::KeyB=>act::MONOCULAR,KeyCode::KeyC=>act::CROUCH,KeyCode::KeyZ=>act::PRONE,KeyCode::Tab=>act::CARD,KeyCode::KeyF=>act::SEAT,_=>0}}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_app/src/main.rs');s=p.read_text().replace('mod look_ui;','mod look_ui;\\\\nmod merc_shell;');s=s.replace('app::run(settings)','if settings.scene.starts_with(\\\"merc\\\"){merc_shell::run(settings)}else{app::run(settings)}');p.write_text(s)\np=Path('engine/crates/pav_app/Cargo.toml');s=p.read_text().replace('wasm-bindgen.workspace = true','wasm-bindgen.workspace = true\\\\njs-sys = \\\"0.3\\\"');p.write_text(s)\nPY\nCARGO_BUILD_JOBS=10 cargo check --manifest-path engine/Cargo.toml -p pav_app > notes/check-app.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_app/src/merc_shell.rs <<'RS'\n//\"'! The game shell has no Pavilion overlays. It owns fixed-step input, saves and transport I/O.\nuse std::{cell::RefCell,rc::Rc,sync::Arc,collections::{BTreeSet,VecDeque}};\nuse anyhow::Result;\nuse glam::{Vec2,Vec3};\nuse pav_core::{Sim,InputFrame,games::{Game,GameBox,merc::{Merc,act,net::Packet}},input::buttons as b};\nuse pav_view::{ViewBuilder,ViewSettings,CameraRig};\nuse winit::{application::ApplicationHandler,event_loop::{EventLoop,ActiveEventLoop,ControlFlow},event::{WindowEvent,DeviceEvent,ElementState,MouseButton},keyboard::{KeyCode,PhysicalKey},window::{Window,WindowId}};\nuse web_time::Instant;\nuse crate::{gfx::Gfx,uiinput::UiInput,settings::Settings};\n#[cfg(target_arch=\"wasm32\")]\nuse wasm_bindgen::prelude::*;\n#[cfg(target_arch=\"wasm32\")]\n#[wasm_bindgen]\nextern \"C\"{\n #[wasm_bindgen(js_namespace=gameBridge,js_name=config)]fn bridge_config()->String;\n #[wasm_bindgen(js_namespace=gameBridge,js_name=poll)]fn bridge_poll()->String;\n #[wasm_bindgen(js_namespace=gameBridge,js_name=publish)]fn bridge_publish(s:&str);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=send)]fn bridge_send(s:&str,reliable:bool,to:i32);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=loaded)]fn bridge_loaded();\n #[wasm_bindgen(js_namespace=gameBridge,js_name=save)]fn bridge_save(slot:i32,s:&str);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=load)]fn bridge_load(slot:i32)->String;\n #[wasm_bindgen(js_namespace=gameBridge,js_name=finish)]fn bridge_finish(s:&str);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=networkUi)]fn bridge_network_ui(n:i32);\n #[wasm_bindgen(js_namespace=gameBridge,js_name=failed)]fn bridge_failed(s:&str);\n}\nfn game(sim:&Sim)->&Merc{sim.state.play.as_ref().unwrap().get::<Merc>().unwrap()}\nfn game_mut(sim:&mut Sim)->&mut Merc{sim.state.play.as_mut().unwrap().get_mut::<Merc>().unwrap()}\n#[derive(Default)]struct NativeInput{keys:BTreeSet<KeyCode>,held:u32,pressed:u32,look:Vec2,acts:VecDeque<u32>}\npub struct Driver{pub sim:Sim,last:Instant,accum:f64,native:NativeInput,pub nodraw:bool,pub server:bool,pub ended:bool,network_at:f64,delta_at:f64,delta_part:usize,finish_sent:bool,saved_serial:u32,audio:Option<pav_audio::AudioOut>,score:pav_audio::merc::Score,pub rects:Vec<[f32;4]>,pub ui_action:u32,pub ui_hover:Option<usize>,test:bool,bot:bool,drawn:u64}\nimpl Driver{\n fn new(settings:&Settings)->Result<Self>{#[cfg(target_arch=\"wasm32\")]let config:serde_json::Value=serde_json::from_str(&bridge_config()).unwrap_or_default();#[cfg(not(target_arch=\"wasm32\"))]let config=serde_json::json!({});let info=&config[\"info\"];let session=info.is_object();let seed=info[\"seed\"].as_u64().unwrap_or(settings.seed);let mut sim=Sim::new(if session{\"merc/session\"}else{\"merc\"},seed)?;let server=info[\"server\"].as_bool().unwrap_or(false);if session{let g=game_mut(&mut sim);g.session=true;g.host=info[\"isHost\"].as_bool().unwrap_or(false);g.local_id=if server{255}else{info[\"me\"].as_u64().unwrap_or(0) as u8};g.peers=info[\"players\"].as_array().into_iter().flatten().filter_map(|p|p[\"id\"].as_u64()).filter(|id|*id as u8!=g.local_id).map(|id|pav_core::games::merc::Peer{id:id as u8,pos:g.pos+Vec3::new(id as f32*2.,0.,0.),yaw:0.,pitch:0.,hp:100.,down:0.,seat:-1,present:true,kills:0,rescues:0,jams:0}).collect();}game_mut(&mut sim).touch_only=config[\"touch\"].as_bool().unwrap_or(false);#[cfg(target_arch=\"wasm32\")]bridge_loaded();Ok(Self{sim,last:Instant::now(),accum:0.,native:NativeInput::default(),nodraw:config[\"nodraw\"].as_bool().unwrap_or(false),server,ended:false,network_at:0.,delta_at:0.,delta_part:0,finish_sent:false,saved_serial:0,audio:None,score:Default::default(),rects:Vec::new(),ui_action:0,ui_hover:None,test:config[\"test\"].as_bool().unwrap_or(false),bot:false,drawn:0})}\n fn tick(&mut self){let now=Instant::now();let elapsed=now.duration_since(self.last).as_secs_f64().min(2.);self.last=now;self.accum+=elapsed;\n #[cfg(target_arch=\"wasm32\")]let input:serde_json::Value=serde_json::from_str(&bridge_poll()).unwrap_or_default();#[cfg(not(target_arch=\"wasm32\"))]let input=serde_json::json!({});\n if self.ended{return;}\n #[cfg(target_arch=\"wasm32\")]self.events(&input);\n let g=game(&self.sim);let mut frame=InputFrame::default();if cfg!(target_arch=\"wasm32\"){frame.held=input[\"held\"].as_u64().unwrap_or(0) as u32;frame.pressed=input[\"pressed\"].as_u64().unwrap_or(0) as u32;let vec=|k:&str|Vec2::new(input[k][0].as_f64().unwrap_or(0.) as f32,input[k][1].as_f64().unwrap_or(0.) as f32);let mv=vec(\"move\");frame.move_dir=Vec2::new(g.yaw.cos()*mv.x+g.yaw.sin()*mv.y,g.yaw.sin()*mv.x-g.yaw.cos()*mv.y);if g.riding.is_some(){frame.move_dir=Vec2::new(mv.x,0.);frame.axes=Vec2::new(input[\"throttle\"].as_f64().unwrap_or(mv.y.max(0.) as f64) as f32,input[\"brake\"].as_f64().unwrap_or((-mv.y).max(0.) as f64) as f32);}let mouse=vec(\"look\");let stick=vec(\"stick\");frame.look=mouse*g.settings.mouse.to_radians()+stick*g.settings.stick.to_radians()*elapsed as f32;if g.settings.invert{frame.look.y*=-1.;}frame.act=input[\"act\"].as_u64().unwrap_or(0) as u32;}else{let k=|key|self.native.keys.contains(&key) as i32 as f32;let mv=Vec2::new(k(KeyCode::KeyD)-k(KeyCode::KeyA),k(KeyCode::KeyW)-k(KeyCode::KeyS)).clamp_length_max(1.);frame.move_dir=Vec2::new(g.yaw.cos()*mv.x+g.yaw.sin()*mv.y,g.yaw.sin()*mv.x-g.yaw.cos()*mv.y);frame.held=self.native.held;frame.pressed=std::mem::take(&mut self.native.pressed);frame.look=std::mem::take(&mut self.native.look)*g.settings.mouse.to_radians();frame.act=self.native.acts.pop_front().unwrap_or(0);}\n if self.ui_action!=0{frame.act=std::mem::take(&mut self.ui_action);}if let Some(h)=self.ui_hover.take(){game_mut(&mut self.sim).focus=h;}\n if self.test {if let Some(commands)=input[\"test\"].as_array(){for c in commands{self.test_command(c);}}}\n let steps=((self.accum*60.).floor() as usize).min(180);if steps==0{return;}for n in 0..steps{let mut i=frame;if n>0{i.pressed=0;i.look=Vec2::ZERO;i.act=0;}if self.bot{i=self.sim.bot_input();}if self.server{i=InputFrame::default();}self.sim.step(&i);self.accum=(self.accum-1./60.).max(0.);}\n let mut play=self.sim.state.play.take().unwrap();let g=play.get_mut::<Merc>().unwrap();\n if let Some(d)=input[\"device\"].as_u64(){g.device=d as u8;}if input[\"keyboard\"].as_bool().unwrap_or(false){g.touch_only=false;}\n if g.load_slot>=0&&!g.session {let slot=g.load_slot;g.load_slot=-1;#[cfg(target_arch=\"wasm32\")]let text=bridge_load(slot);#[cfg(not(target_arch=\"wasm32\"))]let text=std::fs::read_to_string(format!(\"../notes/save-{slot}.json\")).unwrap_or_default();match serde_json::from_str::<Merc>(&text){Ok(mut loaded)=>{loaded.screen=\"playing\".into();loaded.streamed=None;loaded.load_slot=-1;loaded.save_slot=-1;loaded.pos.y=pav_core::games::merc::terrain::height(&loaded.data,loaded.pos.x,loaded.pos.z)+0.1;for n in &mut loaded.soldiers{n.entity=None;}for n in &g.soldiers{if let Some(id)=n.entity{self.sim.despawn(id);}}*g=loaded;g.sync_player(&mut self.sim);},Err(_)=>g.note(g.s(\"no_save\").to_string())}}\n if g.save_serial!=self.saved_serial&&!g.session&&!g.attracting{self.saved_serial=g.save_serial;let text=serde_json::to_string(g).unwrap_or_default();#[cfg(target_arch=\"wasm32\")] {bridge_save(0,&text);if g.save_slot>0{bridge_save(g.save_slot,&text);}}#[cfg(not(target_arch=\"wasm32\"))]{let _=std::fs::write(\"../notes/save-0.json\",&text);if g.save_slot>0{let _=std::fs::write(format!(\"../notes/save-{}.json\",g.save_slot),&text);}}g.save_slot=-1;}\n if !self.server{if input[\"gesture\"].as_bool().unwrap_or(false)&&self.audio.is_none(){self.audio=pav_audio::AudioOut::start().ok();}if let Some(audio)=&self.audio{audio.resume();audio.set_master(if self.ended{0.}else{g.settings.master});for c in self.score.update(g,elapsed as f32){audio.play_patch(c.patch,c.pan,c.gain*pav_audio::merc::gain(g,c.bus),c.delay);}}}\n #[cfg(target_arch=\"wasm32\")] {if g.net_ui>0{bridge_network_ui(g.net_ui);g.net_ui=0;}if g.session&&g.round_started&&!self.ended&&!g.finished{self.network_at+=elapsed;self.delta_at+=elapsed;if self.network_at>=0.1{self.network_at=0.;let packet=if g.host{g.snapshot_packet(self.sim.state.tick)}else{g.pose_packet()};bridge_send(&serde_json::to_string(&packet).unwrap(),!g.host,-1);}if g.host&&self.delta_at>=0.2{self.delta_at=0.;let packet=g.delta_packet(self.delta_part);self.delta_part=(self.delta_part+1)%(g.fire.cells.len().div_ceil(350).max(1));bridge_send(&serde_json::to_string(&packet).unwrap(),true,-1);}}if g.finished&&g.host&&!self.finish_sent{self.finish_sent=true;bridge_finish(&serde_json::json!({\"won\":g.won,\"score\":g.team_score,\"kills\":g.kills,\"cells\":g.fire.total,\"jams\":g.coverage.contains(\"jam_cleared\") as i32,\"rescues\":g.coverage.contains(\"player_rescued\") as i32}).to_string());}}\n self.sim.state.play=Some(play);#[cfg(target_arch=\"wasm32\")] {let g=game(&self.sim);let status=g.status(&self.sim);bridge_publish(&serde_json::json!({\"status\":status.to_string(),\"ui\":serde_json::json!({\"screen\":g.screen,\"rows\":g.rows(),\"rects\":self.rects,\"focus\":g.focus,\"page\":g.page,\"device\":g.device,\"xbox\":g.settings.xbox,\"drawn\":self.drawn}).to_string(),\"screen\":g.screen,\"map\":g.map_up,\"voiceSerial\":g.voice_serial,\"subtitle\":g.subtitle,\"soundSerial\":g.sound_serial,\"touch\":g.touch_only}).to_string());}\n }\n #[cfg(target_arch=\"wasm32\")]\n fn events(&mut self,input:&serde_json::Value){if let Some(es)=input[\"events\"].as_array(){for e in es{let kind=e[\"kind\"].as_str().unwrap_or(\"\");if kind==\"message\"{if let Ok(packet)=serde_json::from_value::<Packet>(e[\"data\"].clone()){let mut p=self.sim.state.play.take().unwrap();let g=p.get_mut::<Merc>().unwrap();g.receive(&mut self.sim,e[\"from\"].as_u64().unwrap_or(0) as u8,packet,&mut Vec::new());self.sim.state.play=Some(p);}}else{let g=game_mut(&mut self.sim);match kind{\"start\"=>{g.round_started=true;g.screen=\"playing\".into();g.round_time=0.;},\"leave\"=>g.leave(e[\"id\"].as_u64().unwrap_or(0) as u8),\"time-up\"=>{g.finished=true;g.won=false;},\"end\"=>{self.ended=true;g.finished=true;if let Some(a)=&self.audio{a.set_master(0.);}},\"standalone\"=>{g.session=true;g.host=e[\"host\"].as_bool().unwrap_or(false);g.local_id=e[\"id\"].as_u64().unwrap_or(0) as u8;g.screen=\"card\".into();g.pos=g.data.place(\"depot\").pos()+Vec3::new(-65.+g.local_id as f32*2.,0.,70.);g.pos.y=pav_core::games::merc::terrain::height(&g.data,g.pos.x,g.pos.z);},_=>{}}}}}}\n fn test_command(&mut self,c:&serde_json::Value){let name=c[\"op\"].as_str().unwrap_or(\"\");if name==\"step\"{self.accum+=c[\"seconds\"].as_f64().unwrap_or(0.).min(200.);}else if name==\"bot\"{self.bot=c[\"value\"].as_bool().unwrap_or(true);}else if name==\"act\"{self.ui_action=c[\"value\"].as_u64().unwrap_or(0) as u32;}else if name==\"set\"{let g=game_mut(&mut self.sim);match c[\"key\"].as_str().unwrap_or(\"\"){\"health\"=>g.health=c[\"value\"].as_f64().unwrap_or(100.) as f32,\"fever_timer\"=>g.fever_timer=c[\"value\"].as_f64().unwrap_or(50.) as f32,\"diamonds\"=>g.diamonds=c[\"value\"].as_i64().unwrap_or(0) as i32,\"hour\"=>g.hour=c[\"value\"].as_f64().unwrap_or(12.) as f32,\"condition\"=>g.guns[g.active].condition=c[\"value\"].as_f64().unwrap_or(100.) as f32,\"idle\"=>g.idle=c[\"value\"].as_f64().unwrap_or(0.) as f32,\"weather\"=>g.weather=c[\"value\"].as_u64().unwrap_or(0) as u8,_=>{}}}else if name==\"net_start\"{let g=game_mut(&mut self.sim);g.session=true;g.round_started=true;g.screen=\"playing\".into();}else if name==\"ignite\"{let g=game_mut(&mut self.sim);g.fire.ignite(&g.data,pav_core::games::merc::data::flat(g.pos)+Vec2::splat(12.),5.);} }\n}\npub fn run(settings:Settings)->Result<()>{let driver=Rc::new(RefCell::new(Driver::new(&settings)?));#[cfg(target_arch=\"wasm32\")] {let d=driver.clone();let tick=Closure::<dyn FnMut()>::new(move||{if let Ok(mut d)=d.try_borrow_mut(){d.tick();}});let w=web_sys::window().unwrap();js_sys::Reflect::set(&w,&JsValue::from_str(\"mercPump\"),tick.as_ref())?;tick.forget();if driver.borrow().server{return Ok(());}}\n let event_loop=EventLoop::new()?;event_loop.set_control_flow(ControlFlow::Poll);let app=MercApp{driver,gfx:None,pending:None,ctx:egui::Context::default(),ui:None,builder:ViewBuilder::new(),started:false};#[cfg(target_arch=\"wasm32\")] {use winit::platform::web::EventLoopExtWebSys;event_loop.spawn_app(app);}#[cfg(not(target_arch=\"wasm32\"))]{let mut app=app;event_loop.run_app(&mut app)?;}Ok(())}\nstruct MercApp{driver:Rc<RefCell<Driver>>,gfx:Option<Gfx>,pending:Option<Rc<RefCell<Option<Result<Gfx>>>>>,ctx:egui::Context,ui:Option<UiInput>,builder:ViewBuilder,started:bool}\nimpl MercApp{\n fn finish_init(&mut self,gfx:Gfx){pav_ui::tenfoot::fonts(&self.ctx);self.ui=Some(UiInput::new(&self.ctx,&gfx.window,gfx.device.limits().max_texture_dimension_2d as usize));self.gfx=Some(gfx);}\n fn draw(&mut self){let Some(gfx)=&mut self.gfx else{return;};let mut d=self.driver.borrow_mut();d.tick();let mut frame=d.sim.frame();let (w,h)=gfx.size();if w==0||h==0{return;}let g=game(&d.sim).clone();let mut scene=if d.nodraw{pav_render::Scene::default()}else{self.builder.build(&frame,&frame,1.,&CameraRig::default(),w as f32/h as f32,&ViewSettings::default(),frame.focus)};\n if d.nodraw{scene.post.bloom=0.;scene.post.outlines=false;}let scale=(h as f32/1080.).max(0.25);self.ctx.set_zoom_factor(1.);let raw=self.ui.as_mut().unwrap().take(&gfx.window);let mut action=0;let mut hover=None;let mut rects=Vec::new();let output=self.ctx.run_ui(raw,|ui|{let r=pav_ui::tenfoot::draw(ui,&g);action=r.action;hover=r.hover;rects=r.rows;});let _=scale;d.ui_action=if action!=0{action}else{d.ui_action};d.ui_hover=hover;d.rects=rects;let ppp=output.pixels_per_point;let prims=self.ctx.tessellate(output.shapes,ppp);let mut textures=output.textures_delta;self.ui.as_mut().unwrap().platform_output(&gfx.window,output.platform_output);if gfx.draw(&scene,Some((&prims,&mut textures,ppp))){d.drawn+=1;}let _=&mut frame;\n }\n}\nimpl ApplicationHandler for MercApp{\n fn resumed(&mut self,el:&ActiveEventLoop){if self.started{return;}self.started=true;let mut attrs=Window::default_attributes().with_title(pav_core::games::merc::data::data().s(\"title\")).with_inner_size(winit::dpi::LogicalSize::new(1600.,900.));#[cfg(target_arch=\"wasm32\")] {use winit::platform::web::WindowAttributesExtWebSys;attrs=attrs.with_append(true);}let window=match el.create_window(attrs){Ok(w)=>Arc::new(w),Err(e)=>{log::error!(\"window: {e}\");return;}};\n #[cfg(not(target_arch=\"wasm32\"))]match Gfx::new(window,pav_render::gpu::BackendChoice::Vulkan,true){Ok(g)=>self.finish_init(g),Err(e)=>log::error!(\"graphics: {e}\")}\n #[cfg(target_arch=\"wasm32\")] {let slot=Rc::new(RefCell::new(None));let fill=slot.clone();wasm_bindgen_futures::spawn_local(async move{*fill.borrow_mut()=Some(Gfx::create(window,pav_render::gpu::BackendChoice::Vulkan,true).await);});self.pending=Some(slot);}}\n fn about_to_wait(&mut self,_el:&ActiveEventLoop){let ready=self.pending.as_ref().and_then(|p|p.borrow_mut().take());if let Some(result)=ready {match result{Ok(g)=>self.finish_init(g),Err(e)=>{#[cfg(target_arch=\"wasm32\")]bridge_failed(&format!(\"WebGPU could not start: {e}\"));log::error!(\"{e}\");}}self.pending=None;}self.driver.borrow_mut().tick();if let Some(g)=&self.gfx{g.window.request_redraw();}}\n fn window_event(&mut self,el:&ActiveEventLoop,_id:WindowId,event:WindowEvent){if let (Some(ui),Some(g))=(&mut self.ui,&self.gfx){ui.on_window_event(&g.window,&event);}match event{WindowEvent::CloseRequested=>el.exit(),WindowEvent::Resized(s)=>{if let Some(g)=&mut self.gfx{g.resize(s.width,s.height);}},WindowEvent::RedrawRequested=>self.draw(),_=>{}}\n #[cfg(not(target_arch=\"wasm32\"))] {let mut d=self.driver.borrow_mut();let shell=game(&d.sim).screen!=\"playing\";match &event{WindowEvent::KeyboardInput{event,..}=>{if let PhysicalKey::Code(k)=event.physical_key{let pressed=event.state==ElementState::Pressed;if pressed{d.native.keys.insert(k);}else{d.native.keys.remove(&k);}if pressed&&!event.repeat{let a=key_action(k,shell);if a>0{d.native.acts.push_back(a);}}let bit=key_bit(k);if pressed{d.native.held|=bit;d.native.pressed|=bit;}else{d.native.held&=!bit;}}},WindowEvent::MouseInput{state,button,..}=>{let bit=if *button==MouseButton::Left{b::PRIMARY}else if *button==MouseButton::Right{b::SECONDARY}else{0};if state.is_pressed(){d.native.held|=bit;d.native.pressed|=bit;}else{d.native.held&=!bit;}},_=>{}}}}\n fn device_event(&mut self,_el:&ActiveEventLoop,_id:winit::event::DeviceId,event:DeviceEvent){if let DeviceEvent::MouseMotion{delta}=event{#[cfg(not(target_arch=\"wasm32\"))]{self.driver.borrow_mut().native.look+=Vec2::new(delta.0 as f32,delta.1 as f32);}let _=delta;}}\n}\n#[cfg(not(target_arch=\"wasm32\"))]fn key_bit(k:KeyCode)->u32{match k{KeyCode::ShiftLeft=>b::SPRINT,KeyCode::Space=>b::JUMP,_=>0}}\n#[cfg(not(target_arch=\"wasm32\"))]fn key_action(k:KeyCode,shell:bool)->u32{if k==KeyCode::Escape{return act::PAUSE;}if shell{return match k{KeyCode::ArrowUp|KeyCode::KeyW=>act::UP,KeyCode::ArrowDown|KeyCode::KeyS=>act::DOWN,KeyCode::ArrowLeft=>act::LEFT,KeyCode::ArrowRight=>act::RIGHT,KeyCode::Enter|KeyCode::Space=>act::CONFIRM,KeyCode::KeyQ=>act::PREV,KeyCode::KeyE=>act::NEXT,_=>0};}match k{KeyCode::KeyE=>act::INTERACT,KeyCode::KeyR=>act::RELOAD,KeyCode::KeyQ=>act::NEXT_GUN,KeyCode::KeyG=>act::THROW,KeyCode::KeyV=>act::MELEE,KeyCode::KeyM=>act::MAP,KeyCode::KeyH=>act::HEAL,KeyCode::KeyP=>act::PILL,KeyCode::KeyT=>act::TRACKER,KeyCode::KeyB=>act::MONOCULAR,KeyCode::KeyC=>act::CROUCH,KeyCode::KeyZ=>act::PRONE,KeyCode::Tab=>act::CARD,KeyCode::KeyF=>act::SEAT,_=>0}}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_app/src/main.rs');s=p.read_text().replace('mod look_ui;','mod look_ui;\\\\nmod merc_shell;');s=s.replace('app::run(settings)','if settings.scene.starts_with(\\\"merc\\\"){merc_shell::run(settings)}else{app::run(settings)}');p.write_text(s)\np=Path('engine/crates/pav_app/Cargo.toml');s=p.read_text().replace('wasm-bindgen.workspace = true','wasm-bindgen.workspace = true\\\\njs-sys = \\\"0.3\\\"');p.write_text(s)\nPY\nCARGO_BUILD_JOBS=10 cargo check --manifest-path engine/Cargo.toml -p pav_app > notes/check-app.log 2>&1\"","aggregated_output":"","exit_code":101,"status":"failed"}}
{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"mkdir -p web\ncat > web/bridge.js <<'JS'\n(() => {\n  'use strict';\n  const A={up:1,down:2,left:3,right:4,confirm:5,back:6,prev:7,next:8,pause:9,activity:10,start:11,interact:12,pill:13,heal:14,reload:15,map:16,mono:17,tracker:18,gun:19,throw:20,melee:21,crouch:22,prone:23,card:24,seat:25,camera:26};\n  const B={jump:1,sprint:32,fire:64,aim:128};\n  const query=new URLSearchParams(location.search), test=query.get('test')==='1';\n  const keys=new Set(),acts=[],events=[],look=[0,0],contexts=[];\n  let state={screen:'title',map:false}, info=null, device=0, gesture=false, keyboard=false, held=0, pressed=0, ended=false, started=false, pendingStart=false, lastPad=[], menuAxis=0, axisAt=0, readySent=false, cardState={}, transport=null, netUI=0;\n  let local={host:false,id:0,players:[],seed:314159,room:'kwelara-contract-v1',running:false,peers:new Map(),pending:new Map(),rtc:[]};\n  const nativeRandom=Math.random;\n  const tone=window.AudioContext||window.webkitAudioContext;\n  if(tone){const Wrapped=class extends tone {constructor(...args){super(...args);contexts.push(this);}};window.AudioContext=Wrapped;if(window.webkitAudioContext)window.webkitAudioContext=Wrapped;}\n  function isMenu(){return \"'!['\"'playing','ending_defend'].includes(state.screen)&&state.screen\"'!=='\"'card';}\n  function wake(){gesture=true;if(state.attract)acts.push(A.activity);}\n  function keyAction(code){if(code==='Escape')return state.map?A.map:(isMenu()?A.back:A.pause);if(isMenu())return ({ArrowUp:A.up,KeyW:A.up,ArrowDown:A.down,KeyS:A.down,ArrowLeft:A.left,KeyA:A.left,ArrowRight:A.right,KeyD:A.right,Enter:A.confirm,Space:A.confirm,KeyQ:A.prev,KeyE:A.next})[code]||A.activity;\n    return ({KeyE:A.interact,KeyR:A.reload,KeyQ:A.gun,KeyG:A.throw,KeyV:state.riding\"'!==null?A.camera:A.melee,KeyM:A.map,KeyB:A.mono,KeyH:A.heal,KeyP:A.pill,KeyT:A.tracker,KeyC:A.crouch,ControlLeft:A.crouch,KeyZ:A.prone,Tab:A.card,KeyF:A.seat,Digit1:4101,Digit2:4102,Digit3:4103})[code]||0;}\n  addEventListener('\"'keydown',e=>{if(e.target instanceof HTMLTextAreaElement||e.target instanceof HTMLInputElement)return;if(['Tab','Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code))e.preventDefault();wake();keyboard=true;device=0;keys.add(e.code);if(e.repeat)return;\n    if(info&&\"'!started&&e.code==='\"'Enter'){AIHub.answer('ready');return;}if(info&&\"'!started&&e.code==='\"'KeyY'){AIHub.answer('more');return;}if(ended)return;const a=keyAction(e.code);if(a)acts.push(a);if(e.code==='Space'){pressed|=B.jump;}},true);\n  addEventListener('keyup',e=>keys.delete(e.code),true);\n  addEventListener('blur',()=>{keys.clear();held=0;});\n  addEventListener('pointermove',e=>{device=0;if(e.movementX||e.movementY){if(state.attract)acts.push(A.activity);if(document.pointerLockElement){look[0]+=e.movementX;look[1]+=e.movementY;}}});\n  addEventListener('mousemove',e=>{if(e.isTrusted)return;if(document.pointerLockElement){look[0]+=e.movementX;look[1]+=e.movementY;}});\n  addEventListener('contextmenu',e=>e.preventDefault());\n  async function lock(){if(isMenu()||state.map||ended)return;const c=document.querySelector('canvas');if(\"'!c)return;try{await c.requestPointerLock({unadjustedMovement:true});}catch(_){try{await c.requestPointerLock();}catch(_){document.getElementById('\"'resume-lock').hidden=false;}}}\n  addEventListener('mousedown',e=>{if(e.target.tagName\"'!=='\"'CANVAS')return;wake();device=0;if(ended)return;if(info&&\"'!started){AIHub.answer(e.button===0?'\"'ready':'more');return;}if(\"'!isMenu()){if(state.map){if(e.button===0){const x=e.clientX/innerWidth,y=e.clientY/innerHeight;const place=nearestMap(x,y);acts.push(2000+place);}else if(e.button===2)acts.push(A.map);return;}lock();if(e.button===0){held|=B.fire;pressed|=B.fire;}if(e.button===2)held|=B.aim;}});\n  addEventListener('\"'mouseup',e=>{if(e.button===0)held&=~B.fire;if(e.button===2)held&=~B.aim;});\n  addEventListener('wheel',e=>{if(isMenu())acts.push(e.deltaY>0?A.next:A.prev);else if(\"'!state.map)acts.push(A.gun);e.preventDefault();},{passive:false});\n  let hadLock=false;\n  addEventListener('\"'pointerlockchange',()=>{const locked=\"'!!document.pointerLockElement;if(hadLock&&!locked&&!isMenu())acts.push(A.pause);hadLock=locked;document.getElementById('\"'resume-lock').hidden=locked||isMenu();});\n  document.addEventListener('click',e=>{if(e.target.id==='resume-lock'){acts.push(A.pause);document.getElementById('resume-lock').hidden=true;setTimeout(lock,100);}});\n  const places=[[-120,900],[-40,640],[0,380],[170,470],[40,40],[40,110],[40,-30],[720,420],[640,170],[830,255],[-420,-30],[-520,-520],[20,-420],[60,-460],[-260,-700],[360,-520],[620,-640],[-420,480],[-760,620],[380,400]];\n  function nearestMap(x,y){const wx=((x-.23)/.45-.5)*2048,wz=((y-.25)/.54-.5)*2048;let best=0,dist=Infinity;places.forEach((p,i)=>{const d=(p[0]-wx)**2+(p[1]-wz)**2;if(d<dist){dist=d;best=i;}});return best;}\n  function padInput(){const pad=Array.from(navigator.getGamepads?.()||[]).find(p=>p?.connected);if(\"'!pad){lastPad=[];return {move:[0,0],stick:[0,0],throttle:0,brake:0,connected:false};}const buttons=pad.buttons.map(b=>typeof b==='\"'number'?b:b.value||Number(b.pressed));const fresh=i=>buttons[i]>.5&&\"'!(lastPad[i]>.5);const dead=x=>Math.abs(x)<.15?0:Math.sign(x)*((Math.abs(x)-.15)/.85)**1.6;const move=[dead(pad.axes[0]||0),-dead(pad.axes[1]||0)],stick=[dead(pad.axes[2]||0),dead(pad.axes[3]||0)];const activity=move.some(x=>Math.abs(x)>.1)||stick.some(x=>Math.abs(x)>.1)||buttons.some(x=>x>.1);if(activity){device=1;gesture=true;keyboard=true;if(state.attract)acts.push(A.activity);}if(!started&&info){if(fresh(0))AIHub.answer('\"'ready');if(fresh(3))AIHub.answer('more');}else if(\"'!ended){if(isMenu()){const axis=move[1]>.5?A.up:move[1]<-.5?A.down:move[0]<-.5?A.left:move[0]>.5?A.right:0;if(axis&&(axis!==menuAxis||performance.now()-axisAt>180)){acts.push(axis);axisAt=performance.now();}menuAxis=axis;for(const [n,a] of [[0,A.confirm],[1,A.back],[4,A.prev],[5,A.next],[12,A.up],[13,A.down],[14,A.left],[15,A.right]])if(fresh(n))acts.push(a);}else{for(const [n,a] of [[1,A.crouch],[2,state.prompt?A.interact:A.reload],[3,A.gun],[4,A.throw],[5,A.melee],[8,A.card],[11,A.mono],[12,A.heal],[13,A.pill],[14,A.map],[15,A.tracker]])if(fresh(n))acts.push(a);if(fresh(0))pressed|=B.jump;}if(fresh(9)&&buttons[8]<.5)acts.push(isMenu()?A.back:A.pause);}lastPad=buttons;return {move,stick,throttle:buttons[7]||0,brake:buttons[6]||0,connected:true,fire:buttons[7]>.2,aim:buttons[6]>.2,sprint:buttons[10]>.2};}\n  function finish(result){if(ended||!info||!info.isHost||readySent)return;readySent=true;const ids=info.players.filter(p=>!p.left).map(p=>p.id),scores={},stats={};ids.forEach(id=>{scores[id]=result.score||0;stats[id]={kills:result.kills||0,rescues:result.rescues||0,jams:result.jams||0,'\"'cells ignited':result.cells||0};});const data={standings:[ids],scores,won:\"'!!result.won,stats,awards:ids.map((id,i)=>({id,title:['\"'Arsonist','Field Medic','Rust Bucket','Last Out'][i%4],detail:'The country keeps the receipt.'}))};if(AIHub.active)AIHub.finish(data);else{broadcast({kind:'end',result:data});endLocal(data);}}\n  function endLocal(data){local.running=false;events.push({kind:'end',reason:'finished'});document.getElementById('local-results').hidden=false;document.getElementById('result-text').textContent=data.won?'CONTRACT COMPLETE':'CONTRACT CLOSED';}\n  window.hubConnection=AIHub.connect({mode:'shared-world',seats:[1,4],card:true}).then(data=>{if(\"'!data)return null;info=data;AIHub.on('\"'card',e=>{cardState=e;document.getElementById('card-clock').textContent=e.left===null?'WAITING FOR MERCS':\"'`${Math.ceil(e.left/1000)} seconds · Enter ready · Y more time`;});AIHub.on('\"'start',()=>{pendingStart=true;});AIHub.on('message',(data,from)=>events.push({kind:'message',data,from}));AIHub.on('leave',e=>{events.push({kind:'leave',id:e.id});const p=info.players.find(p=>p.id==