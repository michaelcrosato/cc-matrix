{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"sed -n '140,190p' engine/crates/pav_core/src/puppet.rs && rg -n 'pub skin|pub shirt|pub pants|pub torso|pub gear' engine/crates/pav_core/src/puppet.rs && rg -n 'headless.*frame|\\\\.ui.frame|\\\\.headless.frame' engine/crates/pav_tools/src | head -20\"","aggregated_output":"        #[default]\n        Biped => \"biped\",\n        Spider => \"spider\",\n        Lizard => \"lizard\",\n        Beetle => \"beetle\",\n        Blob => \"blob\",\n        /// Four legs under a raised body, a head on a neck: hounds, wolves, boars, the town dog.\n        Quadruped => \"quadruped\",\n    }\n}\n\n/// Proportions, colours and animation settings. Everything is a slider.\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct PuppetDef {\n    pub scale: f32,\n    pub head_radius: f32,\n    pub torso_length: f32,\n    pub torso_radius: f32,\n    pub hip_width: f32,\n    pub shoulder_width: f32,\n    pub leg_length: f32,\n    pub arm_length: f32,\n    pub limb_radius: f32,\n    pub skin: String,\n    pub shirt: String,\n    pub pants: String,\n    pub shoes: String,\n    pub eyes: String,\n    pub look: Look,\n    /// Metres travelled per full walk cycle (two steps).\n    pub stride: f32,\n    pub step_height: f32,\n    pub arm_swing: f32,\n    pub bob: f32,\n    pub lean: f32,\n    pub squash: f32,\n    /// Stepped animation: 0 = smooth, 12 = \"on twos\" at 24 fps, etc.\n    pub anim_fps: f32,\n    /// Tilt the eyes toward the camera so they stay visible from above (0..1).\n    pub eyes_to_camera: f32,\n    /// Lean the whole body toward the camera (0..1): a 2D \"cheat\" for high camera angles.\n    pub face_camera: f32,\n    /// Skeleton: biped, or a creature with planted feet (spider, lizard, beetle) or a blob.\n    pub body: BodyPlan,\n    /// Leg pairs of creatures (0 = the body plan's usual number).\n    pub legs: i32,\n    /// Creature body length (m).\n    pub body_length: f32,\n    /// Tail length (m, 0 = none); swings with secondary motion.\n    pub tail_length: f32,\n157:    pub torso_length: f32,\n158:    pub torso_radius: f32,\n164:    pub skin: String,\n165:    pub shirt: String,\n166:    pub pants: String,\n202:    pub gear: GearLook,\nengine/crates/pav_tools/src/session.rs:365:        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));\nengine/crates/pav_tools/src/session.rs:392:        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"cat > tools/assets.py <<'PY'\nfrom pathlib import Path\nimport json,math\nroot=Path('engine/assets/props/lib/merc');root.mkdir(parents=True,exist_ok=True)\ndef box(size,pos,color='#44413a',**kw):return dict(type='rounded_box',size=size,radius=min(size)*.12,pos=pos,color=color,**kw)\ndef cyl(r,h,pos,color='#44413a',**kw):return dict(type='cylinder',radius=r,height=h,pos=pos,color=color,**kw)\ndef asset(name,parts,sockets=None):\n d=dict(format=2,name=name,unit='cm',description=name.replace('_',' ').capitalize()+' assembled from named primitive parts for the last dry season.',tags=['merc',name],parts=parts)\n if sockets:d['sockets']={k:{'pos':v} for k,v in sockets.items()}\n (root/(name+'.json')).write_text(json.dumps(d,indent=2)+'\\\\n')\nweapons=['pistol','revolver','flare','sawnoff','ar','battle','smg','shotgun','sniper','dart','lmg','rpg','flamer','mortar']\nfor i,name in enumerate(weapons):\n short=i<4;length=28 if short else 78\n parts={'receiver':box([6,8,20 if short else 33],[0,5,-12],'#454a46'),'grip':box([5,13,7],[0,-3,0],'#5c4836',pitch=-18),'barrel':cyl(1.5,12 if short else 42,[0,7,-length*.65],'#303733',pitch=90),'front_sight':box([.8,3,1.2],[0,11,-length*.85],'#222a28'),'sight_left':box([.8,2,1],[1.7,10,-length*.85],'#5b635d'),'sight_right':box([.8,2,1],[-1.7,10,-length*.85],'#5b635d'),'rear_sight':box([4,1.5,1.5],[0,10,-8],'#252e2b'),'trigger_guard':box([4,6,1],[0,-1,-8],'#242b28'),'bolt':box([2,2,6],[4,6,-13],'#92928a'),'pin':cyl(.7,7,[0,6,-2],'#9c9e8f',roll=90)}\n if not short:\n  parts.update(stock=box([5,12,25],[0,2,20],'#6e432c',pitch=-7),fore=box([6,7,22],[0,4,-38],'#955b37'),mag=box([5,22,8],[0,-9,-17],'#404640',pitch=-12),band=box([6.8,4,3],[0,4,-35],'#b4a682'))\n if i in [8,9]:parts['scope']=cyl(2.6,30,[0,16,-21],'#262f2c',pitch=90);parts['scope_glass']=cyl(2.2,.4,[0,16,-36.2],'#7eac9b',pitch=90)\n if i in [11,13]:\n  parts={'tube':cyl(7,95,[0,6,-28],'#62694b',pitch=90),'grip':box([5,15,7],[0,-8,0],'#493e2d'),'sight':box([2,9,5],[0,16,-15],'#353f35'),'ring':cyl(8,6,[0,6,12],'#3a4336',pitch=90),'nose':cyl(5,20,[0,6,-80],'#777d50',pitch=90)}\n if i==12:parts['tank']=cyl(9,34,[8,-5,12],'#a78742');parts['nozzle']=cyl(4,20,[0,7,-62],'#353a31',pitch=90)\n if i==10:parts['belt_box']=box([18,16,19],[7,-6,-10],'#7a704d');parts['bipod']=box([2,22,2],[5,-4,-57],'#414c41',roll=20)\n asset(name,parts,{'grip':[0,-2,0],'fore':[-1,2,-34 if not short else -7],'mag':[0,-16,-17],'muzzle':[0,7,-length]})\nasset('syrette',{'body':cyl(1,10,[0,0,0],'#d7c99e'),'plunger':box([4,1,2],[0,6,0],'#d4ba79'),'needle':cyl(.15,5,[0,-7,0],'#deded0')})\nasset('pills',{'bottle':cyl(3,10,[0,0,0],'#745433'),'label':box([5.5,4,1],[0,0,-2.6],'#e6d4a0'),'cap':cyl(3.2,2,[0,6,0],'#ded6b9')})\nfor name in ['gps','tracker','recorder','monocular','pliers','knife','wrench','lighter']:\n if name=='monocular':parts={'body':cyl(4,20,[0,0,-8],'#3c463a',pitch=90),'glass':cyl(3.2,.5,[0,0,-18],'#7a9f9b',pitch=90)}\n elif name in ['pliers','wrench','knife']:parts={'handle':box([3,20,3],[0,0,0],'#8b5e39'),'head':box([6,12,1],[0,14,0],'#b7b8a4')}\n elif name=='lighter':parts={'body':box([4,7,2],[0,0,0],'#ad9d6a'),'top':box([4,2,2],[0,4,0],'#bfc1af')}\n else:parts={'body':box([12,20,4],[0,0,0],'#454c39'),'screen':box([9,10,.5],[0,2,-2.3],'#98ae70',emissive=.3),'dial':cyl(1,1,[3,-6,-2.7],'#272b24',pitch=90),'antenna':cyl(.3,13,[4,16,0],'#c1b79a')}\n asset(name,parts)\nasset('acacia',{'trunk':cyl(22,450,[0,225,0],'#5b4932'),'branch_l':cyl(12,280,[-95,420,0],'#5b4932',roll=-48),'branch_r':cyl(10,300,[95,440,25],'#5b4932',roll=55),'canopy':box([850,120,620],[0,580,0],'#747443'),'leaf_l':box([450,90,450],[-290,555,20],'#737943'),'leaf_r':box([430,85,390],[290,570,65],'#85894b')})\nasset('baobab',{'trunk':cyl(160,900,[0,450,0],'#84654a'),'branch_l':cyl(45,500,[-180,900,0],'#84654a',roll=-40),'branch_r':cyl(40,500,[180,930,0],'#84654a',roll=40),'leaves':box([600,140,450],[0,1200,0],'#73723d')})\nasset('thorn',{'branches':box([160,70,140],[0,35,0],'#7d7743'),'twig':cyl(4,130,[0,65,0],'#725c3b',roll=35)})\nasset('boulder',{'rock':box([390,210,280],[0,105,0],'#8b7b6a',roll=8),'rock_top':box([230,150,200],[60,230,0],'#9d8d77',roll=-11)})\nasset('termite',{'mound':dict(type='cone',radius=90,height=250,pos=[0,125,0],color='#a66e40')})\nasset('sandbag',{'bags':box([300,70,85],[0,35,0],'#a79c77'),'row':box([280,45,85],[8,85,0],'#b7a778')})\nasset('fuel_drum',{'drum':cyl(36,110,[0,55,0],'#8a4932'),'band_1':cyl(38,6,[0,25,0],'#4c4032'),'band_2':cyl(38,6,[0,80,0],'#4c4032'),'cap':cyl(5,3,[14,112,0],'#c4ac73')})\nasset('tank',{'body':cyl(260,550,[0,275,0],'#b9ad8c'),'rim':cyl(270,25,[0,560,0],'#6b6b56'),'band':cyl(263,30,[0,230,0],'#7b5541'),'pipe':cyl(15,550,[220,220,0],'#5f624f',roll=90),'ladder':box([40,500,12],[-255,240,0],'#494d41')})\nfor name,c in [('tin_shack','#bcb18d'),('hut','#b99863'),('hotel','#cfbd90'),('church','#d0bca0'),('bar','#bca47a')]:\n w=1000 if name in ['hotel','bar','church'] else 700;depth=850 if name=='hotel' else 600\n parts={'wall_back':box([w,320,25],[0,160,-depth/2],c),'wall_left':box([25,320,depth],[-w/2,160,0],c),'wall_right':box([25,320,depth],[w/2,160,0],c),'front_left':box([w*.3,320,25],[-w*.35,160,depth/2],c),'front_right':box([w*.3,320,25],[w*.35,160,depth/2],c),'roof':box([w+100,25,depth+90],[0,340,0],'#6c6653'),'lintel':box([w*.4,60,25],[0,290,depth/2],c),'step':box([w*.5,18,120],[0,9,depth/2+45],'#8e7b59')}\n if name=='bar':parts.update(counter=box([400,110,80],[-200,55,-180],'#604532'),shelf=box([400,180,30],[-200,210,-280],'#5c4830'))\n if name=='hotel':parts['upper']=box([w,350,20],[0,490,-depth/2],'#b4a27d');parts['balcony']=box([w,20,200],[0,350,depth/2],'#a18e6b')\n if name=='church':parts['cross_v']=box([18,190,18],[0,450,depth/2],'#615c41');parts['cross_h']=box([95,18,18],[0,480,depth/2],'#615c41')\n asset(name,parts)\nasset('watchtower',{'leg_l':box([25,650,25],[-150,325,0],'#726147'),'leg_r':box([25,650,25],[150,325,0],'#726147'),'platform':box([420,30,360],[0,600,0],'#8b7958'),'roof':box([480,25,400],[0,850,0],'#6a6b54'),'post_l':box([15,250,15],[-185,725,130],'#726147'),'post_r':box([15,250,15],[185,725,130],'#726147')})\nasset('silo',{'concrete':cyl(500,1900,[0,950,0],'#a79c83'),'top':cyl(520,70,[0,1900,0],'#787a68'),'stain':box([180,1400,20],[150,1000,-490],'#8b866c')})\nasset('mast',{'spine':box([40,3200,40],[0,1600,0],'#6a6b58'),'cross_low':box([800,30,30],[0,1900,0],'#6a6b58'),'cross_high':box([500,30,30],[0,2700,0],'#6a6b58'),'light':dict(type='sphere',radius=25,pos=[0,3220,0],color='#df502b',emissive=2)})\nasset('sign',{'post':box([12,260,12],[0,130,0],'#5c4d32'),'board':box([240,85,10],[0,240,0],'#d4c397'),'stripe':box([220,10,12],[0,215,-1],'#9b3c29')})\nfor name,kind in [('technical',0),('jeep',1),('truck',2),('boat',3)]:\n if kind==3:parts={'hull':box([220,55,650],[0,30,0],'#6b7254'),'rail_l':box([15,80,650],[-110,70,0],'#656849'),'rail_r':box([15,80,650],[110,70,0],'#656849'),'bench':box([200,20,50],[0,85,100],'#9f8f61'),'engine':box([80,110,50],[0,10,330],'#3b4940'),'gun':cyl(6,110,[0,160,-150],'#303c32',pitch=90)}\n else:\n  length=650 if kind==2 else 470\n  parts={'chassis':box([190,45,length],[0,80,0],'#4e5141'),'hood':box([185,65,140],[0,130,-length/2+70],'#8a8557'),'cab_back':box([190,160,20],[0,160,15],'#7b7950'),'roof':box([205,15,160],[0,240,-65],'#777b55'),'pillar_l':box([10,100,10],[-90,190,-140],'#777b55'),'pillar_r':box([10,100,10],[90,190,-140],'#777b55'),'dash':box([180,40,30],[0,155,-125],'#444d3b'),'seat':box([160,50,70],[0,120,-10],'#514c35'),'bed':box([185,30,length/2-20],[0,110,length/4],'#867e4f'),'tail':box([190,80,15],[0,140,length/2],'#867e4f'),'bed_l':box([12,70,length/2],[-90,135,length/4],'#867e4f'),'bed_r':box([12,70,length/2],[90,135,length/4],'#867e4f'),'grill':box([150,40,5],[0,105,-length/2-2],'#333f35')}\n  for side in [-1,1]:\n   for z in [-length*.32,length*.32]:parts[f'wheel_{side}_{int(z)}']=cyl(43,28,[side*103,45,z],'#292d28',roll=90)\n   parts[f'lamp_{side}']=box([26,22,8],[side*70,132,-length/2-3],'#e5d4a0',emissive=.3)\n  if kind==0:parts['gun_pole']=cyl(6,130,[0,180,100],'#3b4738');parts['gun_receiver']=box([20,20,65],[0,250,70],'#384035');parts['gun_barrel']=cyl(4,130,[0,250,-20],'#303b32',pitch=90)\n asset(name,parts,{'driver':[-40,150,-50],'gunner':[0,200,100],'hood':[0,160,-170]})\n# Native pose clips. The view samples these keys and pins hands to weapon sockets with the engine IK.\nbase=dict(hips=[0,0,100],body=[0,0,0],chest=[0,0,0],head=[0,0,0],armL=[95,12,-25,55,0],armR=[65,12,-60,75,0],legL=[0,0,-100,5,0],legR=[0,0,-100,5,0])\nnames=['idle','sprint','draw','holster','reload','reload_belt','reload_shell','reload_break','reload_rocket','jam','bolt_slap','throw','machete','backstab','syrette','wound_0','wound_1','wound_2','wound_3','wound_4','wound_5','pills','map','monocular','tracker','recorder','wheel','repair','overdose','pickup','break','dragged','stand']\nclips={}\nfor index,name in enumerate(names):\n dur=4 if name.startswith('wound') else 2.1 if name in ['reload','pills'] else 1\n keys=[]\n for t in [0,.25,.5,.75,1]:\n  k=base.copy();k['t']=t*dur\n  phase=math.sin(t*math.pi)\n  k['armL']=[int(95-55*phase),int(12+20*phase),int(-25+40*phase),int(55+40*phase),int((index%5-2)*12*phase)]\n  k['armR']=[int(65+20*phase),12,int(-60+45*phase),int(75+20*phase),0]\n  keys.append(k)\n clips[name]=dict(dur=dur,loop=name in ['idle','sprint','wheel'],desc='Original first-person '+name.replace('_',' ')+' pose sequence.',keys=keys)\nPath('engine/anim/merc_fp.json').write_text(json.dumps(dict(set='MERC_FP',title='Field actions',format=1,credit='Original key poses, CC0-1.0.',fps=30,clips=clips),indent=2)+'\\\\n')\nclips2={}\nq=json.loads(Path('engine/anim/quaternius.json').read_text());s=json.loads(Path('engine/anim/style100.json').read_text())\nfor n in ['Pistol_Aim_Neutral','Pistol_Shoot','Pistol_Reload','Crouch_Fwd_Loop','Death01','Sitting_Idle_Loop','Walk_Carry_Loop','OverhandThrow']:\n c=q['clips'][n].copy();c['src']='';clips2[n.lower()]=c\nfor n in ['panic','burning','drag','prone','fire']:\n c=clips['sprint' if n=='panic' else 'dragged' if n=='drag' else 'idle'].copy();clips2[n]=c\nPath('engine/anim/merc_npc.json').write_text(json.dumps(dict(set='MERC_NPC',title='Field soldiers',format=1,credit='Original poses plus Quaternius Universal Animation Library, CC0-1.0.',fps=30,clips=clips2),indent=2)+'\\\\n')\n# Procedural materials.\nfor name,color in [('rust_tin','#8b5c3b'),('laterite','#a4552f'),('stained_concrete','#a79c83'),('thatch','#a08a4e'),('burnt_wood','#2a2420'),('painted_steel','#62694b')]:\n d=dict(format=1,name=name,unit='cm',description=name.replace('_',' '),tags=['merc'],color=color,roughness=.8,layers=[dict(type='noise',size=15,cover=.3,shade=.7)])\n Path('engine/assets/materials/'+name+'.json').write_text(json.dumps(d)+'\\\\n')\nPY\npython3 tools/assets.py\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/build.rs');s=p.read_text().replace('\\\"lib/kaykit_adventurers\\\"]','\\\"lib/kaykit_adventurers\\\", \\\"lib/merc\\\"]');p.write_text(s)\np=Path('engine/crates/pav_core/src/props/store.rs');s=p.read_text().replace('&[\\\"kaykit_adventurers\\\"]','&[\\\"kaykit_adventurers\\\", \\\"merc\\\"]');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/ai.rs');s=p.read_text().replace('def.look.skin_color','def.skin').replace('def.look.armor_color','def.shirt');s=s.replace('let player=self.pos;','let player=self.pos;let safe_town=self.safe_town_at(player);').replace('\"'!self.safe_town_at(player)'\"','\"'!safe_town'\"');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/data.rs');s=p.read_text().replace('pub fn s(&self,k:&str)->&str','pub fn s<\\\\'a>(&\\\\'a self,k:&\\\\'a str)->&\\\\'a str');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/mod.rs');s=p.read_text().replace('pub fn s(&self,k:&str)->&str','pub fn s<\\\\'a>(&\\\\'a self,k:&\\\\'a str)->&\\\\'a str');p.write_text(s)\np=Path('engine/crates/pav_core/src/puppet.rs');s=p.read_text().replace('pub(crate) fn ik','pub fn ik');p.write_text(s)\np=Path('engine/crates/pav_render/src/scene.rs');s=p.read_text().replace('    pub const GRASS: u32 = 256;','    pub const GRASS: u32 = 256;\\\\n    pub const NO_FOG:u32=512;');p.write_text(s)\np=Path('engine/crates/pav_render/src/shaders/scene.wgsl');s=p.read_text().replace('return apply_fog(p, albedo * max(1.0, 1.0 + emissive));','if ((flags & 512u) \"'!= 0u) { return albedo * max(1.0, 1.0 + emissive); }'\"\\\\n        return apply_fog(p, albedo * max(1.0, 1.0 + emissive));').replace('    return apply_fog(p, col);','    if ((flags & 512u) \"'!= 0u) { return col; }'\"\\\\n    return apply_fog(p, col);');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"cat > tools/assets.py <<'PY'\nfrom pathlib import Path\nimport json,math\nroot=Path('engine/assets/props/lib/merc');root.mkdir(parents=True,exist_ok=True)\ndef box(size,pos,color='#44413a',**kw):return dict(type='rounded_box',size=size,radius=min(size)*.12,pos=pos,color=color,**kw)\ndef cyl(r,h,pos,color='#44413a',**kw):return dict(type='cylinder',radius=r,height=h,pos=pos,color=color,**kw)\ndef asset(name,parts,sockets=None):\n d=dict(format=2,name=name,unit='cm',description=name.replace('_',' ').capitalize()+' assembled from named primitive parts for the last dry season.',tags=['merc',name],parts=parts)\n if sockets:d['sockets']={k:{'pos':v} for k,v in sockets.items()}\n (root/(name+'.json')).write_text(json.dumps(d,indent=2)+'\\\\n')\nweapons=['pistol','revolver','flare','sawnoff','ar','battle','smg','shotgun','sniper','dart','lmg','rpg','flamer','mortar']\nfor i,name in enumerate(weapons):\n short=i<4;length=28 if short else 78\n parts={'receiver':box([6,8,20 if short else 33],[0,5,-12],'#454a46'),'grip':box([5,13,7],[0,-3,0],'#5c4836',pitch=-18),'barrel':cyl(1.5,12 if short else 42,[0,7,-length*.65],'#303733',pitch=90),'front_sight':box([.8,3,1.2],[0,11,-length*.85],'#222a28'),'sight_left':box([.8,2,1],[1.7,10,-length*.85],'#5b635d'),'sight_right':box([.8,2,1],[-1.7,10,-length*.85],'#5b635d'),'rear_sight':box([4,1.5,1.5],[0,10,-8],'#252e2b'),'trigger_guard':box([4,6,1],[0,-1,-8],'#242b28'),'bolt':box([2,2,6],[4,6,-13],'#92928a'),'pin':cyl(.7,7,[0,6,-2],'#9c9e8f',roll=90)}\n if not short:\n  parts.update(stock=box([5,12,25],[0,2,20],'#6e432c',pitch=-7),fore=box([6,7,22],[0,4,-38],'#955b37'),mag=box([5,22,8],[0,-9,-17],'#404640',pitch=-12),band=box([6.8,4,3],[0,4,-35],'#b4a682'))\n if i in [8,9]:parts['scope']=cyl(2.6,30,[0,16,-21],'#262f2c',pitch=90);parts['scope_glass']=cyl(2.2,.4,[0,16,-36.2],'#7eac9b',pitch=90)\n if i in [11,13]:\n  parts={'tube':cyl(7,95,[0,6,-28],'#62694b',pitch=90),'grip':box([5,15,7],[0,-8,0],'#493e2d'),'sight':box([2,9,5],[0,16,-15],'#353f35'),'ring':cyl(8,6,[0,6,12],'#3a4336',pitch=90),'nose':cyl(5,20,[0,6,-80],'#777d50',pitch=90)}\n if i==12:parts['tank']=cyl(9,34,[8,-5,12],'#a78742');parts['nozzle']=cyl(4,20,[0,7,-62],'#353a31',pitch=90)\n if i==10:parts['belt_box']=box([18,16,19],[7,-6,-10],'#7a704d');parts['bipod']=box([2,22,2],[5,-4,-57],'#414c41',roll=20)\n asset(name,parts,{'grip':[0,-2,0],'fore':[-1,2,-34 if not short else -7],'mag':[0,-16,-17],'muzzle':[0,7,-length]})\nasset('syrette',{'body':cyl(1,10,[0,0,0],'#d7c99e'),'plunger':box([4,1,2],[0,6,0],'#d4ba79'),'needle':cyl(.15,5,[0,-7,0],'#deded0')})\nasset('pills',{'bottle':cyl(3,10,[0,0,0],'#745433'),'label':box([5.5,4,1],[0,0,-2.6],'#e6d4a0'),'cap':cyl(3.2,2,[0,6,0],'#ded6b9')})\nfor name in ['gps','tracker','recorder','monocular','pliers','knife','wrench','lighter']:\n if name=='monocular':parts={'body':cyl(4,20,[0,0,-8],'#3c463a',pitch=90),'glass':cyl(3.2,.5,[0,0,-18],'#7a9f9b',pitch=90)}\n elif name in ['pliers','wrench','knife']:parts={'handle':box([3,20,3],[0,0,0],'#8b5e39'),'head':box([6,12,1],[0,14,0],'#b7b8a4')}\n elif name=='lighter':parts={'body':box([4,7,2],[0,0,0],'#ad9d6a'),'top':box([4,2,2],[0,4,0],'#bfc1af')}\n else:parts={'body':box([12,20,4],[0,0,0],'#454c39'),'screen':box([9,10,.5],[0,2,-2.3],'#98ae70',emissive=.3),'dial':cyl(1,1,[3,-6,-2.7],'#272b24',pitch=90),'antenna':cyl(.3,13,[4,16,0],'#c1b79a')}\n asset(name,parts)\nasset('acacia',{'trunk':cyl(22,450,[0,225,0],'#5b4932'),'branch_l':cyl(12,280,[-95,420,0],'#5b4932',roll=-48),'branch_r':cyl(10,300,[95,440,25],'#5b4932',roll=55),'canopy':box([850,120,620],[0,580,0],'#747443'),'leaf_l':box([450,90,450],[-290,555,20],'#737943'),'leaf_r':box([430,85,390],[290,570,65],'#85894b')})\nasset('baobab',{'trunk':cyl(160,900,[0,450,0],'#84654a'),'branch_l':cyl(45,500,[-180,900,0],'#84654a',roll=-40),'branch_r':cyl(40,500,[180,930,0],'#84654a',roll=40),'leaves':box([600,140,450],[0,1200,0],'#73723d')})\nasset('thorn',{'branches':box([160,70,140],[0,35,0],'#7d7743'),'twig':cyl(4,130,[0,65,0],'#725c3b',roll=35)})\nasset('boulder',{'rock':box([390,210,280],[0,105,0],'#8b7b6a',roll=8),'rock_top':box([230,150,200],[60,230,0],'#9d8d77',roll=-11)})\nasset('termite',{'mound':dict(type='cone',radius=90,height=250,pos=[0,125,0],color='#a66e40')})\nasset('sandbag',{'bags':box([300,70,85],[0,35,0],'#a79c77'),'row':box([280,45,85],[8,85,0],'#b7a778')})\nasset('fuel_drum',{'drum':cyl(36,110,[0,55,0],'#8a4932'),'band_1':cyl(38,6,[0,25,0],'#4c4032'),'band_2':cyl(38,6,[0,80,0],'#4c4032'),'cap':cyl(5,3,[14,112,0],'#c4ac73')})\nasset('tank',{'body':cyl(260,550,[0,275,0],'#b9ad8c'),'rim':cyl(270,25,[0,560,0],'#6b6b56'),'band':cyl(263,30,[0,230,0],'#7b5541'),'pipe':cyl(15,550,[220,220,0],'#5f624f',roll=90),'ladder':box([40,500,12],[-255,240,0],'#494d41')})\nfor name,c in [('tin_shack','#bcb18d'),('hut','#b99863'),('hotel','#cfbd90'),('church','#d0bca0'),('bar','#bca47a')]:\n w=1000 if name in ['hotel','bar','church'] else 700;depth=850 if name=='hotel' else 600\n parts={'wall_back':box([w,320,25],[0,160,-depth/2],c),'wall_left':box([25,320,depth],[-w/2,160,0],c),'wall_right':box([25,320,depth],[w/2,160,0],c),'front_left':box([w*.3,320,25],[-w*.35,160,depth/2],c),'front_right':box([w*.3,320,25],[w*.35,160,depth/2],c),'roof':box([w+100,25,depth+90],[0,340,0],'#6c6653'),'lintel':box([w*.4,60,25],[0,290,depth/2],c),'step':box([w*.5,18,120],[0,9,depth/2+45],'#8e7b59')}\n if name=='bar':parts.update(counter=box([400,110,80],[-200,55,-180],'#604532'),shelf=box([400,180,30],[-200,210,-280],'#5c4830'))\n if name=='hotel':parts['upper']=box([w,350,20],[0,490,-depth/2],'#b4a27d');parts['balcony']=box([w,20,200],[0,350,depth/2],'#a18e6b')\n if name=='church':parts['cross_v']=box([18,190,18],[0,450,depth/2],'#615c41');parts['cross_h']=box([95,18,18],[0,480,depth/2],'#615c41')\n asset(name,parts)\nasset('watchtower',{'leg_l':box([25,650,25],[-150,325,0],'#726147'),'leg_r':box([25,650,25],[150,325,0],'#726147'),'platform':box([420,30,360],[0,600,0],'#8b7958'),'roof':box([480,25,400],[0,850,0],'#6a6b54'),'post_l':box([15,250,15],[-185,725,130],'#726147'),'post_r':box([15,250,15],[185,725,130],'#726147')})\nasset('silo',{'concrete':cyl(500,1900,[0,950,0],'#a79c83'),'top':cyl(520,70,[0,1900,0],'#787a68'),'stain':box([180,1400,20],[150,1000,-490],'#8b866c')})\nasset('mast',{'spine':box([40,3200,40],[0,1600,0],'#6a6b58'),'cross_low':box([800,30,30],[0,1900,0],'#6a6b58'),'cross_high':box([500,30,30],[0,2700,0],'#6a6b58'),'light':dict(type='sphere',radius=25,pos=[0,3220,0],color='#df502b',emissive=2)})\nasset('sign',{'post':box([12,260,12],[0,130,0],'#5c4d32'),'board':box([240,85,10],[0,240,0],'#d4c397'),'stripe':box([220,10,12],[0,215,-1],'#9b3c29')})\nfor name,kind in [('technical',0),('jeep',1),('truck',2),('boat',3)]:\n if kind==3:parts={'hull':box([220,55,650],[0,30,0],'#6b7254'),'rail_l':box([15,80,650],[-110,70,0],'#656849'),'rail_r':box([15,80,650],[110,70,0],'#656849'),'bench':box([200,20,50],[0,85,100],'#9f8f61'),'engine':box([80,110,50],[0,10,330],'#3b4940'),'gun':cyl(6,110,[0,160,-150],'#303c32',pitch=90)}\n else:\n  length=650 if kind==2 else 470\n  parts={'chassis':box([190,45,length],[0,80,0],'#4e5141'),'hood':box([185,65,140],[0,130,-length/2+70],'#8a8557'),'cab_back':box([190,160,20],[0,160,15],'#7b7950'),'roof':box([205,15,160],[0,240,-65],'#777b55'),'pillar_l':box([10,100,10],[-90,190,-140],'#777b55'),'pillar_r':box([10,100,10],[90,190,-140],'#777b55'),'dash':box([180,40,30],[0,155,-125],'#444d3b'),'seat':box([160,50,70],[0,120,-10],'#514c35'),'bed':box([185,30,length/2-20],[0,110,length/4],'#867e4f'),'tail':box([190,80,15],[0,140,length/2],'#867e4f'),'bed_l':box([12,70,length/2],[-90,135,length/4],'#867e4f'),'bed_r':box([12,70,length/2],[90,135,length/4],'#867e4f'),'grill':box([150,40,5],[0,105,-length/2-2],'#333f35')}\n  for side in [-1,1]:\n   for z in [-length*.32,length*.32]:parts[f'wheel_{side}_{int(z)}']=cyl(43,28,[side*103,45,z],'#292d28',roll=90)\n   parts[f'lamp_{side}']=box([26,22,8],[side*70,132,-length/2-3],'#e5d4a0',emissive=.3)\n  if kind==0:parts['gun_pole']=cyl(6,130,[0,180,100],'#3b4738');parts['gun_receiver']=box([20,20,65],[0,250,70],'#384035');parts['gun_barrel']=cyl(4,130,[0,250,-20],'#303b32',pitch=90)\n asset(name,parts,{'driver':[-40,150,-50],'gunner':[0,200,100],'hood':[0,160,-170]})\n# Native pose clips. The view samples these keys and pins hands to weapon sockets with the engine IK.\nbase=dict(hips=[0,0,100],body=[0,0,0],chest=[0,0,0],head=[0,0,0],armL=[95,12,-25,55,0],armR=[65,12,-60,75,0],legL=[0,0,-100,5,0],legR=[0,0,-100,5,0])\nnames=['idle','sprint','draw','holster','reload','reload_belt','reload_shell','reload_break','reload_rocket','jam','bolt_slap','throw','machete','backstab','syrette','wound_0','wound_1','wound_2','wound_3','wound_4','wound_5','pills','map','monocular','tracker','recorder','wheel','repair','overdose','pickup','break','dragged','stand']\nclips={}\nfor index,name in enumerate(names):\n dur=4 if name.startswith('wound') else 2.1 if name in ['reload','pills'] else 1\n keys=[]\n for t in [0,.25,.5,.75,1]:\n  k=base.copy();k['t']=t*dur\n  phase=math.sin(t*math.pi)\n  k['armL']=[int(95-55*phase),int(12+20*phase),int(-25+40*phase),int(55+40*phase),int((index%5-2)*12*phase)]\n  k['armR']=[int(65+20*phase),12,int(-60+45*phase),int(75+20*phase),0]\n  keys.append(k)\n clips[name]=dict(dur=dur,loop=name in ['idle','sprint','wheel'],desc='Original first-person '+name.replace('_',' ')+' pose sequence.',keys=keys)\nPath('engine/anim/merc_fp.json').write_text(json.dumps(dict(set='MERC_FP',title='Field actions',format=1,credit='Original key poses, CC0-1.0.',fps=30,clips=clips),indent=2)+'\\\\n')\nclips2={}\nq=json.loads(Path('engine/anim/quaternius.json').read_text());s=json.loads(Path('engine/anim/style100.json').read_text())\nfor n in ['Pistol_Aim_Neutral','Pistol_Shoot','Pistol_Reload','Crouch_Fwd_Loop','Death01','Sitting_Idle_Loop','Walk_Carry_Loop','OverhandThrow']:\n c=q['clips'][n].copy();c['src']='';clips2[n.lower()]=c\nfor n in ['panic','burning','drag','prone','fire']:\n c=clips['sprint' if n=='panic' else 'dragged' if n=='drag' else 'idle'].copy();clips2[n]=c\nPath('engine/anim/merc_npc.json').write_text(json.dumps(dict(set='MERC_NPC',title='Field soldiers',format=1,credit='Original poses plus Quaternius Universal Animation Library, CC0-1.0.',fps=30,clips=clips2),indent=2)+'\\\\n')\n# Procedural materials.\nfor name,color in [('rust_tin','#8b5c3b'),('laterite','#a4552f'),('stained_concrete','#a79c83'),('thatch','#a08a4e'),('burnt_wood','#2a2420'),('painted_steel','#62694b')]:\n d=dict(format=1,name=name,unit='cm',description=name.replace('_',' '),tags=['merc'],color=color,roughness=.8,layers=[dict(type='noise',size=15,cover=.3,shade=.7)])\n Path('engine/assets/materials/'+name+'.json').write_text(json.dumps(d)+'\\\\n')\nPY\npython3 tools/assets.py\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/build.rs');s=p.read_text().replace('\\\"lib/kaykit_adventurers\\\"]','\\\"lib/kaykit_adventurers\\\", \\\"lib/merc\\\"]');p.write_text(s)\np=Path('engine/crates/pav_core/src/props/store.rs');s=p.read_text().replace('&[\\\"kaykit_adventurers\\\"]','&[\\\"kaykit_adventurers\\\", \\\"merc\\\"]');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/ai.rs');s=p.read_text().replace('def.look.skin_color','def.skin').replace('def.look.armor_color','def.shirt');s=s.replace('let player=self.pos;','let player=self.pos;let safe_town=self.safe_town_at(player);').replace('\"'!self.safe_town_at(player)'\"','\"'!safe_town'\"');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/data.rs');s=p.read_text().replace('pub fn s(&self,k:&str)->&str','pub fn s<\\\\'a>(&\\\\'a self,k:&\\\\'a str)->&\\\\'a str');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/mod.rs');s=p.read_text().replace('pub fn s(&self,k:&str)->&str','pub fn s<\\\\'a>(&\\\\'a self,k:&\\\\'a str)->&\\\\'a str');p.write_text(s)\np=Path('engine/crates/pav_core/src/puppet.rs');s=p.read_text().replace('pub(crate) fn ik','pub fn ik');p.write_text(s)\np=Path('engine/crates/pav_render/src/scene.rs');s=p.read_text().replace('    pub const GRASS: u32 = 256;','    pub const GRASS: u32 = 256;\\\\n    pub const NO_FOG:u32=512;');p.write_text(s)\np=Path('engine/crates/pav_render/src/shaders/scene.wgsl');s=p.read_text().replace('return apply_fog(p, albedo * max(1.0, 1.0 + emissive));','if ((flags & 512u) \"'!= 0u) { return albedo * max(1.0, 1.0 + emissive); }'\"\\\\n        return apply_fog(p, albedo * max(1.0, 1.0 + emissive));').replace('    return apply_fog(p, col);','    if ((flags & 512u) \"'!= 0u) { return col; }'\"\\\\n    return apply_fog(p, col);');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"sed -n '1300,1360p' engine/crates/pav_view/src/build.rs && sed -n '1,140p' engine/crates/pav_render/src/text.rs && sed -n '565,587p' engine/crates/pav_render/src/scene.rs && sed -n '310,405p' engine/crates/pav_render/src/scene.rs && rg -n 'RenderFrame \\\\{' engine/crates | head -25 && sed -n '347,373p' engine/crates/pav_tools/src/session.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"sed -n '1300,1360p' engine/crates/pav_view/src/build.rs && sed -n '1,140p' engine/crates/pav_render/src/text.rs && sed -n '565,587p' engine/crates/pav_render/src/scene.rs && sed -n '310,405p' engine/crates/pav_render/src/scene.rs && rg -n 'RenderFrame \\\\{' engine/crates | head -25 && sed -n '347,373p' engine/crates/pav_tools/src/session.rs\"","aggregated_output":"                    // Fit the text along the zone's long side (about 0.58 em per letter).\n                    let fit = 0.92 * w.max(d) / (0.58 * text.chars().count().max(1) as f32);\n                    (w.min(d) * 0.32).clamp(0.35, 0.7).min(fit).max(0.2)\n                });\n                let label = Label {\n                    text,\n                    pos: z.floor_center() + Vec3::Y * 0.035,\n                    size,\n                    color: if lum > 0.45 { Color::hex(\"#1d1f24\") } else { Color::hex(\"#f6f3ea\") },\n                    mode: LabelMode::Floor,\n                    facing: Default::default(),\n                };\n                emit_label(&mut scene.texts, &label, rig);\n            }\n            let c = &self.static_cache[key];\n            scene.meshes.extend_from_slice(&c.meshes);\n            scene.sdfs.extend_from_slice(&c.sdfs);\n            scene.point_lights.extend_from_slice(&c.lights);\n            for (mesh, data) in &c.custom {\n                if self.generated.sent.insert(*mesh) {\n                    scene.custom_meshes.push((MeshKey::Custom(*mesh), data.clone()));\n                }\n            }\n            for (def, pos, phase) in &c.prop_lights {\n                scene.point_lights.push(crate::fx::light(def, *pos, time, *phase));\n            }\n            if let Some((mk, data)) = &c.terrain {\n                scene.custom_meshes.push((*mk, data.clone()));\n                scene.meshes.push(MeshInstance {\n                    mesh: *mk,\n                    transform: Mat4::IDENTITY,\n                    color: Vec3::ONE,\n                    emissive: 0.0,\n                    style: style_of(Look::Cel, settings.style),\n                    flags: rs::flags::CUT_VERTEX,\n                    group: 1,\n                    material: 0,\n                    ext: Vec3::ZERO,\n                });\n            }\n        }\n        // Water catches up on longer gaps too (tools render a frame now and then).\n        self.water_surfaces(&mut scene, curr, settings, since.min(0.5), to_sun);\n        // Everything so far is the environment; objects come next.\n        let env_end = (scene.meshes.len(), scene.sdfs.len(), scene.dynamic.len());\n        scene.fog = rs::Fog {\n            enabled: settings.fog,\n            center: rig.target,\n            start: settings.fog_start,\n            end: settings.fog_end,\n            color: scene.clear_color,\n        };\n\n        // Dynamic objects.\n        let cam_fwd = scene.camera.forward;\n        let now = self.now as f32;\n        let mut live = Vec::new();\n        let mut puppets = Vec::new();\n        let mut scenery = Vec::new();\n        for o in interpolate(prev, curr, alpha) {\n            let v = &o.visual;\n//! In-world text: glyphs from a font are turned into a signed-distance-field atlas once at\n//! startup, so letters stay crisp at any distance or zoom. Layout happens on the CPU; each\n//! glyph is one instanced quad.\n\nuse std::collections::HashMap;\n\nuse ab_glyph::{Font, FontRef, Glyph, PxScale, point};\nuse glam::Vec3;\n\n/// Pixels per em in the atlas.\nconst EM_PX: f32 = 56.0;\n/// Distance-field spread (pixels each side of the edge).\nconst SPREAD: f32 = 7.0;\npub const ATLAS_W: u32 = 1024;\n\n#[derive(Clone, Copy, Debug, Default)]\npub struct GlyphInfo {\n    /// Atlas rectangle (0..1).\n    pub uv: [f32; 4],\n    /// Quad offset from the pen position and size, in em units (y up).\n    pub offset: [f32; 2],\n    pub size: [f32; 2],\n    pub advance: f32,\n}\n\npub struct FontAtlas {\n    pub width: u32,\n    pub height: u32,\n    /// R8 distance field (0.5 = edge, > 0.5 inside).\n    pub pixels: Vec<u8>,\n    pub glyphs: HashMap<char, GlyphInfo>,\n    /// Ascent/descent in em units.\n    pub ascent: f32,\n    pub descent: f32,\n}\n\n/// 1D squared distance transform (Felzenszwalb & Huttenlocher).\nfn edt_1d(f: &[f32], d: &mut [f32], v: &mut [usize], z: &mut [f32]) {\n    let n = f.len();\n    let mut k = 0usize;\n    v[0] = 0;\n    z[0] = f32::NEG_INFINITY;\n    z[1] = f32::INFINITY;\n    for q in 1..n {\n        let s = loop {\n            let p = v[k];\n            let s = ((f[q] + (q * q) as f32) - (f[p] + (p * p) as f32)) / (2.0 * (q as f32 - p as f32));\n            if s <= z[k] && k > 0 {\n                k -= 1;\n            } else {\n                break s;\n            }\n        };\n        k += 1;\n        v[k] = q;\n        z[k] = s;\n        z[k + 1] = f32::INFINITY;\n    }\n    k = 0;\n    for (q, dq) in d.iter_mut().enumerate().take(n) {\n        while z[k + 1] < q as f32 {\n            k += 1;\n        }\n        let p = v[k];\n        *dq = (q as f32 - p as f32).powi(2) + f[p];\n    }\n}\n\n/// Euclidean distance from each pixel to the nearest `true` pixel.\nfn edt(mask: &[bool], w: usize, h: usize) -> Vec<f32> {\n    const INF: f32 = 1e10;\n    let mut grid: Vec<f32> = mask.iter().map(|m| if *m { 0.0 } else { INF }).collect();\n    let n = w.max(h);\n    let (mut f, mut d, mut v, mut z) = (vec![0.0; n], vec![0.0; n], vec![0usize; n], vec![0.0; n + 1]);\n    for x in 0..w {\n        for y in 0..h {\n            f[y] = grid[y * w + x];\n        }\n        edt_1d(&f[..h], &mut d[..h], &mut v, &mut z);\n        for y in 0..h {\n            grid[y * w + x] = d[y];\n        }\n    }\n    for y in 0..h {\n        f[..w].copy_from_slice(&grid[y * w..(y + 1) * w]);\n        edt_1d(&f[..w], &mut d[..w], &mut v, &mut z);\n        for x in 0..w {\n            grid[y * w + x] = d[x].sqrt();\n        }\n    }\n    grid\n}\n\nimpl FontAtlas {\n    /// Builds the atlas for printable ASCII plus a few symbols.\n    pub fn new() -> Self {\n        let font = FontRef::try_from_slice(epaint_default_fonts::UBUNTU_LIGHT).expect(\"built-in font\");\n        let upem = font.units_per_em().unwrap_or(1000.0);\n        // PxScale is the font's ascent-descent height in pixels; convert from em.\n        let height_unscaled = font.height_unscaled();\n        let scale = PxScale::from(EM_PX * height_unscaled / upem);\n        let px_per_unit = EM_PX / upem;\n        let pad = SPREAD.ceil() as i32 + 1;\n        let chars: Vec<char> = (32u8..127).map(|c| c as char).chain(\"°×→←↑↓·—–…±²³½éü\".chars()).collect();\n\n        let mut pixels = vec![0u8; (ATLAS_W * 512) as usize];\n        let mut height = 512u32;\n        let (mut cx, mut cy, mut row_h) = (0i32, 0i32, 0i32);\n        let mut glyphs = HashMap::new();\n        for ch in chars {\n            let id = font.glyph_id(ch);\n            if id.0 == 0 && ch != ' ' {\n                continue; // not in the font: layout falls back to '?'\n            }\n            let advance = font.h_advance_unscaled(id) * px_per_unit / EM_PX;\n            let glyph: Glyph = id.with_scale_and_position(scale, point(0.0, 0.0));\n            let Some(outline) = font.outline_glyph(glyph) else {\n                glyphs.insert(ch, GlyphInfo { advance, ..Default::default() });\n                continue;\n            };\n            let b = outline.px_bounds();\n            let (gw, gh) = (b.width().ceil() as i32, b.height().ceil() as i32);\n            let (w, h) = (gw + 2 * pad, gh + 2 * pad);\n            let mut cov = vec![0.0f32; (w * h) as usize];\n            outline.draw(|x, y, c| {\n                let (x, y) = (x as i32 + pad, y as i32 + pad);\n                if x < w && y < h {\n                    cov[(y * w + x) as usize] = c;\n                }\n            });\n            let inside: Vec<bool> = cov.iter().map(|c| *c >= 0.5).collect();\n            let outside: Vec<bool> = inside.iter().map(|i| !i).collect();\n            let d_in = edt(&inside, w as usize, h as usize);\n            let d_out = edt(&outside, w as usize, h as usize);\n            if cx + w > ATLAS_W as i32 {\n                cx = 0;\n                cy += row_h;\n                row_h = 0;\n            }\n            while (cy + h) as u32 > height {\n\n/// Distance fog around a centre point (usually the camera target), blending into `color`.\n#[derive(Clone, Copy, Debug)]\npub struct Fog {\n    pub enabled: bool,\n    pub center: Vec3,\n    /// Horizontal distance where fog starts / is complete (m).\n    pub start: f32,\n    pub end: f32,\n    /// Linear RGB (usually the sky colour).\n    pub color: Vec3,\n}\n\nimpl Default for Fog {\n    fn default() -> Self {\n        Self { enabled: false, center: Vec3::ZERO, start: 60.0, end: 90.0, color: Vec3::ONE }\n    }\n}\n\n/// Camera helpers that remove geometry hiding the player.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Cutaway {\n    /// Point of interest (usually the player's head).\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct StyleSettings {\n    /// Brightness of shadowed areas in the flat style (0..1).\n    pub flat_shadow: f32,\n    /// Number of light bands in the cel style.\n    pub cel_bands: f32,\n    pub rim: f32,\n    pub specular: f32,\n}\n\nimpl Default for StyleSettings {\n    fn default() -> Self {\n        Self { flat_shadow: 0.62, cel_bands: 2.0, rim: 0.25, specular: 0.35 }\n    }\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct PostSettings {\n    pub outlines: bool,\n    /// Outline thickness in pixels.\n    pub outline_px: f32,\n    /// Relative depth jump that counts as an edge.\n    pub outline_depth: f32,\n    /// Normal dot product below which a crease counts as an edge.\n    pub outline_normal: f32,\n    /// Outline = pixel color * darken (when `outline_color` is None).\n    pub outline_darken: f32,\n    pub outline_color: Option<Vec3>,\n    pub exposure: f32,\n    pub tonemap: Tonemap,\n    pub saturation: f32,\n    /// Bloom strength (0 = off) and the HDR brightness where glow starts.\n    pub bloom: f32,\n    pub bloom_threshold: f32,\n    /// Screen distortion (shockwaves, haze) on/off.\n    pub distortion: bool,\n    /// Screen-space global illumination: bounce light and ambient occlusion (0 = off).\n    pub gi: f32,\n    /// Which part of the scene gets outlines.\n    pub outline_part: Part,\n    /// Hazy air (volumetric light): density at the haze's base height (0 = off), the height\n    /// (m) over which it thins out and the base height itself; sunlight scattered toward the\n    /// camera where the sun's shadow map lets it through (light shafts), how strongly that\n    /// light scatters forward (0 = evenly .. 0.9 = mostly toward the sun) and lamp halos (point\n    /// lights glowing in the air, 0 = off).\n    pub haze: f32,\n    pub haze_height: f32,\n    pub haze_base: f32,\n    pub shafts: f32,\n    pub shafts_forward: f32,\n    pub halos: f32,\n}\n\nimpl Default for PostSettings {\n    fn default() -> Self {\n        Self {\n            outlines: true,\n            outline_px: 1.0,\n            outline_depth: 0.02,\n            outline_normal: 0.6,\n            outline_darken: 0.35,\n            outline_color: None,\n            exposure: 1.0,\n            tonemap: Tonemap::SoftKnee,\n            saturation: 1.0,\n            bloom: 0.35,\n            bloom_threshold: 1.2,\n            distortion: true,\n            gi: 0.0,\n            outline_part: Part::All,\n            haze: 0.0,\n            haze_height: 4.0,\n            haze_base: 0.0,\n            shafts: 1.0,\n            shafts_forward: 0.5,\n            halos: 0.0,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DistortKind {\n    /// Shockwave ring pushing outward (`progress` 0..1 = ring radius / fade).\n    Ring = 0,\n    /// Heat haze wobble.\n    Haze = 1,\n    /// Magnifying lens (negative strength shrinks).\n    Lens = 2,\n    /// Rings travelling outward.\n    Ripple = 3,\n}\n\n/// A screen distortion source, drawn as a camera-facing disc.\n#[derive(Clone, Copy, Debug)]\nengine/crates/pav_core/src/animation_preview.rs:287:    pub(crate) fn frame(&self, config: Arc<SimConfig>, dt: f32, ticket: u64) -> RenderFrame {\nengine/crates/pav_core/src/animation_preview.rs:311:        RenderFrame {\nengine/crates/pav_core/src/frame.rs:272:pub struct RenderFrame {\nengine/crates/pav_core/src/creature_preview.rs:272:    pub(crate) fn frame(&self, config: Arc<SimConfig>, dt: f32, ticket: u64) -> RenderFrame {\nengine/crates/pav_core/src/creature_preview.rs:296:pub(crate) fn empty_frame(config: Arc<SimConfig>, dt: f32, ticket: u64) -> RenderFrame {\nengine/crates/pav_core/src/creature_preview.rs:297:    RenderFrame {\nengine/crates/pav_core/src/prop_preview.rs:239:    pub(crate) fn frame(&self, config: Arc<SimConfig>, dt: f32, ticket: u64) -> RenderFrame {\nengine/crates/pav_core/src/prop_preview.rs:250:    ) -> RenderFrame {\nengine/crates/pav_core/src/prop_preview.rs:279:        RenderFrame {\nengine/crates/pav_core/src/prop_preview.rs:312:) -> RenderFrame {\nengine/crates/pav_core/src/prop_preview.rs:452:impl RenderFrame {\nengine/crates/pav_core/src/sim.rs:944:    pub fn frame(&mut self) -> RenderFrame {\nengine/crates/pav_core/src/sim.rs:991:        RenderFrame {\n        &mut self,\n        width: u32,\n        height: u32,\n        input: pav_ui::headless::Input,\n    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build