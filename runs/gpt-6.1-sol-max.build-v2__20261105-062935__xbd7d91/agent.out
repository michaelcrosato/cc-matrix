v class=\"buttons\"><button data-net=\"10\">Create offer</button><button data-net=\"11\">Create answer</button><button data-net=\"12\">Connect answer</button><button data-net=\"3\">Start contract</button></div><label>Paste received code<textarea id=\"code-input\" aria-label=\"Received invite code\"></textarea></label><label>Your code<textarea id=\"code-output\" readonly aria-label=\"Your invite code\"></textarea></label><div class=\"buttons\"><button data-net=\"13\">Copy code</button><button id=\"close-network\">Close</button></div></div>\n<div id=\"local-results\" hidden><h2 id=\"result-text\"></h2><p>The country keeps the receipt.</p><button id=\"local-return\">Return to title</button></div>\n<script>'\"'''+glue+'''</script>\n<script type=\\\"module\\\">\nconst msg=document.getElementById('msg');document.getElementById('fallback-title').textContent=document.title;\ndocument.getElementById('fallback-settings').onclick=()=>{const el=document.getElementById('fallback-controls');el.hidden=\"'!el.hidden;};\nif(!navigator.gpu){msg.hidden=true;document.getElementById('\"'support').hidden=false;document.getElementById('support-message').textContent='WebGPU is required. Open this file in a recent Chrome or Edge with hardware acceleration enabled.';document.getElementById('touch-message').hidden=\"'!matchMedia('\"'(pointer:coarse)').matches;AIHub.fail('WebGPU is required');}\nelse{await window.hubConnection;try{if(window.loadGame)await window.loadGame();else await(await import('./shardfall.js')).default();}catch(e){window.gameBridge.failed(String(e));}}\n</script></body></html>'''\np.write_text(html)\nPY\npython3 tools/page.py\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_app/src/merc_shell.rs');s=p.read_text().replace('\\\"touch\\\":g.touch_only}).to_string()','\\\"touch\\\":g.touch_only,\\\"attract\\\":g.attracting,\\\"prompt\\\":g.prompt().is_some()}).to_string()');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/merc/actions.rs');s=p.read_text().replace('match a{\\\\n act::BACK','if (4101..=4103).contains(&a){self.active=(a-4101) as usize;return;}\\\\n match a{\\\\n act::BACK');p.write_text(s)\nPY\nCARGO_BUILD_JOBS=10 cargo check --manifest-path engine/Cargo.toml -p pav_app --target wasm32-unknown-unknown > notes/check-wasm.log 2>&1\"","aggregated_output":"","exit_code":101,"status":"failed"}}
{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/tests/merc.rs <<'RS'\nuse pav_core::{Sim,InputFrame,games::{Game,Outcome,merc::{Merc,act,data::{data,flat,Tuning},terrain,fire::Fire,weapons::{Gun,jam_chance},ai::detection_rate}}};\nuse glam::{Vec2,Vec3};\nfn g(s:&Sim)->&Merc{s.play().unwrap().get::<Merc>().unwrap()}\nfn gm(s:&mut Sim)->&mut Merc{s.state.play.as_mut().unwrap().get_mut::<Merc>().unwrap()}\nfn action(s:&mut Sim,a:u32){s.step(&InputFrame{act:a,..Default::default()});}\nfn rules(s:&mut Sim,f:impl FnOnce(&mut Merc,&mut Sim)){let mut p=s.state.play.take().unwrap();f(p.get_mut::<Merc>().unwrap(),s);s.state.play=Some(p);}\n#[test]fn boots_deterministic_snapshot_and_replay(){for seed in [1,9,91]{let mut a=Sim::new(\\\"merc/play\\\",seed).unwrap();let mut b=Sim::new(\\\"merc/play\\\",seed).unwrap();for _ in 0..90{let f=InputFrame{look:Vec2::new(.01,0.),move_dir:Vec2::new(.3,-.8),..Default::default()};a.step(&f);b.step(&f);}assert_eq\"'!(a.state_hash(),b.state_hash());let mut bytes=Vec::new();ciborium::into_writer(&a.snapshot(),&mut bytes).unwrap();let snapshot=ciborium::from_reader(bytes.as_slice()).unwrap();b.restore(snapshot);assert_eq!(a.state_hash(),b.state_hash());}}\n#[test]fn all_data_props_and_native_clips_resolve(){let d=data();assert_eq!(d.weapons.len(),14);assert_eq!(d.contracts.len(),11);assert_eq!(d.attract.len(),10);assert_eq!(d.tapes.len(),6);for w in &d.weapons{pav_core::props::resolve_ref(&format!(\"LIB/merc/{}\",w.id)).unwrap();}for n in [\"acacia\",\"baobab\",\"tank\",\"technical\",\"boat\",\"silo\",\"bar\",\"gps\",\"syrette\"]{pav_core::props::resolve_ref(&format!(\"LIB/merc/{n}\")).unwrap();}for n in [\"idle\",\"jam\",\"wound_0\",\"wound_5\",\"pills\",\"repair\",\"dragged\"]{assert!(pav_core::clips::find(&format!(\"MERC_FP/{n}\")).is_some(),\"{n}\");}}\n#[test]fn look_clamps_and_stance_changes(){let mut s=Sim::new(\"merc/play\",3).unwrap();s.step(&InputFrame{look:Vec2::new(9.,-9.),..Default::default()});assert!(g(&s).pitch<=1.48);action(&mut s,act::PRONE);for _ in 0..30{s.step(&InputFrame::default());}assert_eq!(g(&s).stance,2);assert!(g(&s).eye<.5);}\n#[test]fn jams_follow_condition_probability(){assert_eq!(jam_chance(75.),0.);let mut r=pav_core::rng::Rng::new(42);let n=(0..5000).filter(|_|r.f32()<jam_chance(35.)).count();assert!((200..350).contains(&n),\"{n}\");}\n#[test]fn jam_clear_reload_wear_and_treatment(){let mut s=Sim::new(\"merc/play\",1).unwrap();gm(&mut s).guns[1].jammed=true;action(&mut s,act::RELOAD);for _ in 0..130{s.step(&InputFrame::default());}assert!(!g(&s).guns[1].jammed);assert!(g(&s).coverage.contains(\"jam_cleared\"));for cause in 0..6{gm(&mut s).health=10.;gm(&mut s).wound=cause;action(&mut s,act::HEAL);for _ in 0..250{s.step(&InputFrame::default());}assert!(g(&s).health>=40.);assert!(g(&s).coverage.contains(&format!(\"wound_{cause}\")));}}\n#[test]fn fire_is_sparse_directional_and_rain_extinguishes(){let d=data();let mut f=Fire::default();let p=Vec2::new(-690.,-400.);f.ignite(&d,p,1.);let mut r=pav_core::rng::Rng::new(9);let t=Tuning::default();for _ in 0..240{f.step(&d,&mut r,&t,Vec2::X,8.,false,.25);}let down=f.cells.keys().map(|k|k.0 as f32*2.-p.x).fold(0.,f32::max);let up=f.cells.keys().map(|k|p.x-k.0 as f32*2.).fold(0.,f32::max);assert!(down>=up*3.,\"down={down} up={up} cells={}\",f.total);assert!(f.total>500,\"{}\",f.total);assert!(serde_json::to_string(&f).unwrap().len()<2_000_000);f.step(&d,&mut r,&t,Vec2::X,8.,true,.25);assert_eq!(f.burning(),0);let old=f.total;f.ignite(&d,p,1.);assert_eq!(f.total,old);}\n#[test]fn water_road_and_firebreak_have_no_fuel(){let d=data();assert!(terrain::water(&d,Vec2::new(640.,terrain::river_z(&d,640.))));assert_eq!(terrain::fuel(&d,320,(terrain::river_z(&d,640.)/2.) as i32),0.);let mut f=Fire::default();let p=Vec2::new(-690.,-400.);f.cut.insert(Fire::key(p),0.);f.ignite(&d,p,.1);assert!(f.cells.is_empty());}\n#[test]fn night_grass_prone_is_harder_to_see(){let hidden=detection_rate(30.,1,1.,0.,false,true,true,false);let exposed=detection_rate(30.,0,0.,12.,true,false,false,false);assert!(exposed>hidden*8.,\"{exposed} vs {hidden}\");}\n#[test]fn fever_warns_pills_treat_blackout_charges_fee(){let mut s=Sim::new(\"merc/play\",5).unwrap();gm(&mut s).fever_timer=40.;s.step(&InputFrame::default());assert_eq!(g(&s).fever_state,1);action(&mut s,act::PILL);for _ in 0..160{s.step(&InputFrame::default());}assert_eq!(g(&s).fever_state,0);gm(&mut s).diamonds=10;gm(&mut s).fever_state=2;gm(&mut s).fever_timer=-59.99;s.step(&InputFrame::default());assert!(g(&s).coverage.contains(\"blackout\"));assert_eq!(g(&s).diamonds,8);assert_eq!(g(&s).health,50.);}\n#[test]fn companion_rescue_patch_and_permadeath(){let mut s=Sim::new(\"merc/play\",9).unwrap();gm(&mut s).damage(150.,0);assert!(g(&s).rescue_time>0.);for _ in 0..370{s.step(&InputFrame::default());}assert!(g(&s).health>=50.);assert!(g(&s).coverage.contains(\"player_rescued\"));let pos=g(&s).pos;gm(&mut s).companions[0].down=45.;gm(&mut s).companions[0].pos=pos;action(&mut s,act::PATCH);assert!(g(&s).companions[0].alive);assert_eq!(g(&s).companions[0].down,0.);gm(&mut s).companions[0].down=45.;gm(&mut s).companion_choice(true);assert!(!g(&s).companions[0].alive);let copy:Merc=serde_json::from_str(&serde_json::to_string(g(&s)).unwrap()).unwrap();assert!(!copy.companions[0].alive);}\n#[test]fn buying_is_atomic_and_fresh_crates_are_reliable(){let mut s=Sim::new(\"merc/play\",1).unwrap();gm(&mut s).diamonds=0;let inv=g(&s).owned.clone();action(&mut s,act::BUY+8);assert_eq!(g(&s).owned,inv);gm(&mut s).diamonds=20;action(&mut s,act::BUY+8);assert!(g(&s).owned.contains(&8));assert_eq!(g(&s).guns[1].condition,100.);assert!(g(&s).diamonds<20);}\n#[test]fn save_restores_every_persistent_system(){let mut s=Sim::new(\"merc/play\",9).unwrap();rules(&mut s,|g,_|{g.fire.ignite(&g.data,Vec2::new(-690.,-400.),4.);g.diamonds=17;g.hour=3.;g.infamy=4;g.guns[1].condition=21.;g.posts[0].cleared=true;g.coverage.insert(\"check\".into());});let text=serde_json::to_string(g(&s)).unwrap();let copy:Merc=serde_json::from_str(&text).unwrap();assert_eq!(copy.diamonds,17);assert_eq!(copy.guns[1].condition,21.);assert_eq!(copy.fire.cells.len(),g(&s).fire.cells.len());assert!(copy.posts[0].cleared);}\n#[test]fn menu_navigation_density_and_live_parameters(){let mut s=Sim::new(\"merc\",9).unwrap();action(&mut s,act::UP);assert_eq!(g(&s).focus,4);action(&mut s,act::DOWN);assert_eq!(g(&s).focus,0);for screen in [\"title\",\"pause\",\"settings\",\"shop\",\"dev\",\"dev_cheats\",\"dev_teleport\",\"dev_story\",\"dev_give\",\"dev_world\",\"dev_balance\"]{gm(&mut s).open(screen);for page in 0..g(&s).page_count(){gm(&mut s).page=page;assert!(g(&s).rows().len()<=7,\"{screen} {page}\");}}gm(&mut s).open(\"dev_balance\");let old=s.config.merc.enemy_accuracy;action(&mut s,act::RIGHT);assert!(s.config.merc.enemy_accuracy>old);}\n#[test]fn idle_attract_loops_without_saving(){let mut s=Sim::new(\"merc\",1).unwrap();rules(&mut s,|g,sim|{g.idle=9.9;assert!(!g.attracting);g.attracting=true;let save=g.save_serial;let mut seen=std::collections::BTreeSet::new();for _ in 0..930{g.attract(sim,1.,&mut Vec::new());seen.insert(g.attract_segment);}assert!(g.attract_loops>=5);assert_eq!(seen.len(),10);assert_eq!(g.save_serial,save);});}\n#[test]fn packets_are_bounded_and_replicate_fire(){let mut host=Sim::new(\"merc/session\",19).unwrap();let mut client=Sim::new(\"merc/session\",19).unwrap();gm(&mut host).host=true;gm(&mut client).host=false;let p=g(&host).pos;rules(&mut host,|g,_|{g.fire.ignite(&g.data,flat(p)+Vec2::splat(12.),5.);});let packet=g(&host).snapshot_packet(1);assert!(serde_json::to_string(&packet).unwrap().len()<1200);let delta=g(&host).delta_packet(0);rules(&mut client,|g,s|g.receive(s,0,delta,&mut Vec::new()));assert_eq!(g(&host).fire.cells.len(),g(&client).fire.cells.len());}\n#[test]#[ignore]fn campaign_bot_reaches_all_endings(){for seed in [1,2,3]{let mut s=Sim::new(\"merc/play\",seed).unwrap();let mut last=(usize::MAX,usize::MAX);for tick in 0..650000{let f=s.bot_input();s.step(&f);let now=(g(&s).contract,g(&s).goal);if now!=last{eprintln!(\"seed={seed} tick={tick} contract={:?} hp={} pos={:?}\",now,g(&s).health,g(&s).pos);last=now;}if s.outcome()!=Outcome::Playing{break;}if tick%30000==29999{eprintln!(\"tick={tick} screen={} pos={:?} hp={} goal={:?}\",g(&s).screen,g(&s).pos,g(&s).health,g(&s).current_goal());}}assert_eq!(s.outcome(),Outcome::Won,\"{}\",g(&s).status(&s));}}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\nimport re\np=Path('engine/crates/pav_core/tests/merc.rs');s=p.read_text();s=re.sub(r'(?<\"'!['\"\\\\w.)\\\\]])\\\\.(\\\\d)',r'0.\\\\1',s);p.write_text(s)\np=Path('engine/crates/pav_ui/src/headless.rs');s=p.read_text().replace('    pub device: Device,','    pub device: Device,\\\\n    pub merc:Option<std::sync::Arc<pav_core::games::merc::Merc>>,');s=s.replace('        let ctx = egui::Context::default();','        let ctx = egui::Context::default();\\\\n        if self.merc.is_some(){crate::tenfoot::fonts(&ctx);}');s=s.replace('                crate::game_lines(&ctx, hud_lines);','                crate::game_lines(&ctx, hud_lines);\\\\n                if let Some(g)=&self.merc{crate::tenfoot::draw(ui,g);}');p.write_text(s)\np=Path('engine/crates/pav_tools/src/session.rs');s=p.read_text().replace('let drawn = has_ui(&frame).then','self.ui.merc=frame.merc.clone();\\\\n        let drawn = has_ui(&frame).then');s=s.replace('        Some(self.ui.frame(frame.game','        self.ui.merc=frame.merc.clone();\\\\n        Some(self.ui.frame(frame.game');s=s.replace('    frame.game.is_some() || \"'!frame.hud.lines.is_empty()'\"','    frame.merc.is_some() || frame.game.is_some() || \"'!frame.hud.lines.is_empty()'\"');p.write_text(s)\nPY\nCARGO_BUILD_JOBS=10 cargo test --manifest-path engine/Cargo.toml -p pav_core --test merc -- --test-threads=2 > notes/test-sim.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
