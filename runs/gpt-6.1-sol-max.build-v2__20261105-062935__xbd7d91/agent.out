&mut PhysicsState, r: BlockRef) -> Option<Block> {\ncrates/pav_core/src/statics.rs:645:    pub fn deactivate(&mut self, physics: &mut PhysicsState, key: RegionKey) -> bool {\ncrates/pav_core/src/statics.rs:655:    pub fn activate(&mut self, physics: &mut PhysicsState, key: RegionKey) -> bool {\ncrates/pav_core/src/statics.rs:681:    pub fn remove_region(&mut self, physics: &mut PhysicsState, key: RegionKey) {\ncrates/pav_core/src/statics.rs:688:    pub fn is_active(&self, key: RegionKey) -> bool {\ncrates/pav_core/src/statics.rs:693:    pub fn regions_in(&self, min: Vec3, max: Vec3) -> impl Iterator<Item = (&RegionKey, &Arc<StaticChunk>)> {\ncrates/pav_core/src/statics.rs:698:    pub fn ladders_near(&self, p: Vec3) -> impl Iterator<Item = &Ladder> {\ncrates/pav_core/src/statics.rs:704:    pub fn blocks_in_sphere(&self, center: Vec3, radius: f32) -> Vec<BlockRef> {\ncrates/pav_core/src/statics.rs:717:    pub fn iter_alive(&self) -> impl Iterator<Item = (BlockRef, &Block)> {\ncrates/pav_core/src/statics.rs:723:    pub fn block_count(&self) -> usize {\ncrates/pav_core/src/props/mod.rs:60:pub struct Bounds {\ncrates/pav_core/src/props/mod.rs:66:    pub fn center(&self) -> Vec3 {\ncrates/pav_core/src/props/mod.rs:70:    pub fn size(&self) -> Vec3 {\ncrates/pav_core/src/props/mod.rs:74:    pub fn union(self, other: Self) -> Self {\ncrates/pav_core/src/props/mod.rs:80:    pub fn size_cm(&self) -> String {\ncrates/pav_core/src/props/mod.rs:93:pub struct PropPart {\ncrates/pav_core/src/props/mod.rs:160:    pub fn rotation(&self) -> Quat {\ncrates/pav_core/src/props/mod.rs:165:    pub fn visual(&self, scale: f32) -> Visual {\ncrates/pav_core/src/props/mod.rs:183:    pub fn hull(&self, scale: f32) -> Vec<Vec3> {\ncrates/pav_core/src/props/mod.rs:219:    pub fn bounds(&self, scale: f32) -> Bounds {\ncrates/pav_core/src/props/mod.rs:241:    pub fn validate(&self) -> Result<(), String> {\ncrates/pav_core/src/props/mod.rs:293:pub struct PropAsset {\ncrates/pav_core/src/props/mod.r