{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_ui/src/tenfoot/mod.rs <<'RS'\n//\"'! A painter-based television UI. Navigation lives in the deterministic game model.\nuse egui::{Color32 as C,FontId,FontFamily,Align2,Pos2,Rect,Vec2,Stroke,Sense};\nuse pav_core::games::merc::{Merc,act,data::distance};\n#[derive(Default,Clone,Copy)]pub struct MenuInput{pub up:bool,pub down:bool,pub left:bool,pub right:bool,pub confirm:bool,pub back:bool,pub tab:i32,pub pointer:Option<[f32;2]>,pub click:bool}\nimpl MenuInput{pub fn action(self)->u32{if self.up{act::UP}else if self.down{act::DOWN}else if self.left{act::LEFT}else if self.right{act::RIGHT}else if self.confirm{act::CONFIRM}else if self.back{act::BACK}else if self.tab>0{act::NEXT}else if self.tab<0{act::PREV}else{0}}}\nconst PAPER:C=C::from_rgb(236,222,185);const MUTED:C=C::from_rgb(174,164,139);const GOLD:C=C::from_rgb(216,165,80);const INK:C=C::from_rgb(30,32,27);const RED:C=C::from_rgb(179,62,39);\npub fn fonts(ctx:&egui::Context){let mut f=egui::FontDefinitions::default();f.font_data.insert(\"stencil\".into(),egui::FontData::from_static(include_bytes!(\"../../../../assets/fonts/StardosStencil-Bold.ttf\")).into());f.families.insert(FontFamily::Name(\"stencil\".into()),vec![\"stencil\".into()]);ctx.set_fonts(f);}\nfn font(n:f32,stencil:bool)->FontId{FontId::new(n,if stencil{FontFamily::Name(\"stencil\".into())}else{FontFamily::Proportional})}\nfn text(p:&egui::Painter,pos:Pos2,anchor:Align2,s:impl Into<String>,size:f32,color:C,stencil:bool){p.text(pos,anchor,s.into(),font(size,stencil),color);}\nfn glyph(p:&egui::Painter,pos:Pos2,name:&str,scale:f32,xbox:bool){let r=17.*scale;let st=Stroke::new(2.*scale,PAPER);match name{\"cross\" if !xbox=>{p.circle_stroke(pos,r,st);p.line_segment([pos+Vec2::splat(-7.*scale),pos+Vec2::splat(7.*scale)],st);p.line_segment([pos+Vec2::new(7.,-7.)*scale,pos+Vec2::new(-7.,7.)*scale],st);},\"circle\" if !xbox=>{p.circle_stroke(pos,r,st);p.circle_stroke(pos,8.*scale,st);},\"square\" if !xbox=>{p.circle_stroke(pos,r,st);p.rect_stroke(Rect::from_center_size(pos,Vec2::splat(14.*scale)),0.,st,egui::StrokeKind::Inside);},_=>{let s=match(name,xbox){(\"cross\",true)=>\"A\",(\"circle\",true)=>\"B\",(\"square\",true)=>\"X\",(\"triangle\",true)=>\"Y\",_=>name};p.rect_stroke(Rect::from_center_size(pos,Vec2::new((s.len() as f32*12.+14.).max(32.),34.)*scale),3.,st,egui::StrokeKind::Inside);text(p,pos,Align2::CENTER_CENTER,s,22.*scale,PAPER,false);}}}\nfn prompt(p:&egui::Painter,pos:Pos2,key:&str,pad:&str,label:&str,g:&Merc,s:f32){glyph(p,pos,if g.device==1{pad}else{key},s,g.settings.xbox);text(p,pos+Vec2::new(28.*s,0.),Align2::LEFT_CENTER,label,28.*s,PAPER,false);}\n#[derive(Default)]pub struct DrawResult{pub action:u32,pub hover:Option<usize>,pub rows:Vec<[f32;4]>}\npub fn draw(ui:&mut egui::Ui,g:&Merc)->DrawResult{let mut out=DrawResult::default();let ctx=ui.ctx().clone();let screen=ctx.content_rect();let scale=(screen.height()/1080.).max(0.25);let w=screen.width()/scale;let h=1080.;let safe=w*.05;let p=ui.painter().clone();let point=|x:f32,y:f32|Pos2::new(screen.left()+x*scale,screen.top()+y*scale);let rect=|x:f32,y:f32,ww:f32,hh:f32|Rect::from_min_size(point(x,y),Vec2::new(ww,hh)*scale);\n // Thin film border and registration marks.\n for (x,y,dx,dy) in [(safe,54.,1.,1.),(w-safe,54.,-1.,1.),(safe,1026.,1.,-1.),(w-safe,1026.,-1.,-1.)]{p.line_segment([point(x,y),point(x+dx*18.,y)],Stroke::new(scale,PAPER.gamma_multiply(.45)));p.line_segment([point(x,y),point(x,y+dy*18.)],Stroke::new(scale,PAPER.gamma_multiply(.45)));}\n let playing=matches!(g.screen.as_str(),\"playing\"|\"ending_defend\")&&!g.attracting;\n if playing{hud(ui,g,&p,screen,scale);return out;}\n if g.screen==\"card\"{p.rect_filled(rect(0.,0.,w,h),0.,C::from_black_alpha(90));text(&p,point(safe,95.),Align2::LEFT_TOP,g.s(\"title\").to_uppercase(),100.*scale,PAPER,true);text(&p,point(safe,240.),Align2::LEFT_TOP,g.s(\"session_title\"),40.*scale,GOLD,true);text(&p,point(safe,320.),Align2::LEFT_TOP,g.s(\"session_goal\"),32.*scale,PAPER,false);text(&p,point(safe,425.),Align2::LEFT_TOP,g.s(\"help_pad\"),28.*scale,PAPER,false);for (i,peer) in g.peers.iter().enumerate(){text(&p,point(w-safe-400.,360.+i as f32*65.),Align2::LEFT_TOP,format!(\"MERC {}  ·  {}\",peer.id+1,if peer.present{\"Ready on the card\"}else{\"Waiting\"}),30.*scale,GOLD,false);}text(&p,point(safe,920.),Align2::LEFT_TOP,g.s(\"ready_help\"),30.*scale,PAPER,false);return out;}\n if g.attracting {text(&p,point(safe,85.),Align2::LEFT_TOP,g.s(\"title\").to_uppercase(),84.*scale,PAPER,true);if let Some(seg)=g.data.attract.get(g.attract_segment){text(&p,point(safe,190.),Align2::LEFT_TOP,seg.name.to_uppercase(),28.*scale,GOLD,false);}text(&p,point(w*.5,955.),Align2::CENTER_CENTER,if g.touch_only{g.s(\"touch\")}else{g.s(\"press\")},36.*scale,PAPER.gamma_multiply(.7+.3*(g.view_time*2.).sin().abs()),false);if g.touch_only{let r=rect(w*.5-140.,985.,280.,65.);let res=ui.interact(r,egui::Id::new(\"touch_settings\"),Sense::click());p.rect_filled(r,2.,INK);text(&p,r.center(),Align2::CENTER_CENTER,g.s(\"settings\"),30.*scale,PAPER,false);if res.clicked(){out.action=act::SELECT+3;}}return out;}\n let title=g.screen==\"title\";\n // A warm black gradient keeps type readable while the world remains present.\n let panel_w=if title{w*.60}else{w*.72};let mut mesh=egui::Mesh::default();let x0=screen.left();let x1=screen.left()+panel_w*scale;let a=C::from_rgba_premultiplied(14,18,14,235);let z=C::from_rgba_premultiplied(10,14,11,25);for (pos,color) in [(Pos2::new(x0,screen.top()),a),(Pos2::new(x1,screen.top()),z),(Pos2::new(x1,screen.bottom()),z),(Pos2::new(x0,screen.bottom()),a)]{mesh.colored_vertex(pos,color);}mesh.add_triangle(0,1,2);mesh.add_triangle(0,2,3);p.add(egui::Shape::mesh(mesh));\n let start_y;if title{let title=g.s(\"title\").to_uppercase();let title=title.rsplit_once('\"' ').map(|(a,b)|format\"'!(\"{a}'\"\\\\n{b}\\\")).unwrap_or(title);text(&p,point(safe,120.),Align2::LEFT_TOP,\\\"CONTRACTOR’S COPY     /     01\\\",28.*scale,GOLD,false);text(&p,point(safe-5.,193.),Align2::LEFT_TOP,title,138.*scale,PAPER,true);text(&p,point(safe,490.),Align2::LEFT_TOP,g.s(\\\"tagline\\\"),28.*scale,MUTED,false);p.line_segment([point(safe,550.),point(safe+120.,550.)],Stroke::new(3.*scale,RED));start_y=590.;\n text(&p,point(w-safe,88.),Align2::RIGHT_TOP,g.s(\\\"country\\\"),28.*scale,PAPER,false);text(&p,point(w-safe,132.),Align2::RIGHT_TOP,g.s(\\\"season\\\"),24.*scale,MUTED,false);if w>1400.{p.line_segment([point(w-safe-410.,822.),point(w-safe,822.)],Stroke::new(scale,GOLD));text(&p,point(w-safe-410.,852.),Align2::LEFT_TOP,\\\"01 / LANDING FEES\\\",28.*scale,GOLD,false);text(&p,point(w-safe-410.,905.),Align2::LEFT_TOP,\\\"The crates are for both sides.\\\\nSo is the receipt.\\\",30.*scale,PAPER,false);}}\n else{let heading=match g.screen.as_str(){\\\"difficulty\\\"=>\\\"TERMS OF EMPLOYMENT\\\",\\\"dossier\\\"=>\\\"SELECT YOUR DOSSIER\\\",\\\"pause\\\"=>g.s(\\\"pause\\\"),\\\"contract\\\"=>g.s(\\\"contract\\\"),\\\"shop\\\"=>g.s(\\\"shop_title\\\"),\\\"locker\\\"=>g.s(\\\"inventory\\\"),\\\"safehouse\\\"=>\\\"SAFE HOUSE\\\",\\\"dev\\\"=>g.s(\\\"dev_title\\\"),\\\"about\\\"=>\\\"ON THE RECORD\\\",\\\"settings\\\"|\\\"session_settings\\\"=>\\\"SETTINGS\\\",\\\"ending_choice\\\"=>\\\"LAST ORDER\\\",\\\"ending\\\"=>g.s(\\\"ending_tape\\\"),\\\"death\\\"=>\\\"CONTRACT CLOSED\\\",_=>&g.screen};text(&p,point(safe,100.),Align2::LEFT_TOP,heading.to_uppercase().replace('_',\\\" \\\"),64.*scale,PAPER,true);p.line_segment([point(safe,205.),point(safe+130.,205.)],Stroke::new(3.*scale,RED));start_y=310.;}\n let rows=g.rows();let content_w=(w*.56).min(980.);let row_h=if title{68.}else{91.};let mut ry=start_y;\n if g.screen==\\\"contract\\\"{let c=&g.data.contracts[g.contract];text(&p,point(safe,260.),Align2::LEFT_TOP,format\"'!(\"{} / {}\",c.id,c.name),40.*scale,GOLD,false);text(&p,point(safe,337.),Align2::LEFT_TOP,&c.giver,30.*scale,MUTED,false);text(&p,point(safe,407.),Align2::LEFT_TOP,&c.brief,34.*scale,PAPER,false);text(&p,point(safe,637.),Align2::LEFT_TOP,format!(\"Payment: {} diamonds\",c.pay),30.*scale,GOLD,false);ry=760.;}\n if g.screen==\"ending_choice\"{text(&p,point(safe,270.),Align2::LEFT_TOP,g.s(\"ledger\"),30.*scale,MUTED,false);ry=460.;}\n if g.screen==\"ending\"||g.screen==\"death\"||g.screen==\"quit\"{let t=if g.screen==\"ending\"{g.subtitle.as_str()}else if g.screen==\"death\"{g.s(\"death\")}else{\"Your last autosave was made at a bed or a contract change.\"};let gal=p.layout(t.into(),font(34.*scale,false),PAPER,content_w*scale);p.galley(point(safe,300.),gal,PAPER);ry=720.;}\n if g.screen==\"settings\"||g.screen==\"session_settings\"{text(&p,point(safe,245.),Align2::LEFT_TOP,[\"01  /  SOUND\",\"02  /  CONTROLS\",\"03  /  PICTURE\",\"04  /  ACCESS\"][g.page%4],30.*scale,GOLD,false);}\n if g.screen==\"shop\"{text(&p,point(w-safe,240.),Align2::RIGHT_TOP,format!(\"{} DIAMONDS\",g.diamonds),32.*scale,GOLD,false);}\n if g.screen==\"about\"{if let Some(page)=g.data.about.get(g.page){text(&p,point(safe,260.),Align2::LEFT_TOP,&page.title,36.*scale,GOLD,false);let mut y=345.;for l in &page.lines{let gal=p.layout(l.clone(),font(29.*scale,false),PAPER,(w-safe*2.).min(1550.)*scale);let hh=gal.size().y/scale;p.galley(point(safe,y),gal,PAPER);y+=hh+22.;}}}\n if g.screen==\"controls\"{text(&p,point(safe,270.),Align2::LEFT_TOP,if g.page==0{g.s(\"help_foot\")}else if g.page==1{g.s(\"help_vehicle\")}else{g.s(\"help_pad\")},36.*scale,PAPER,false);}\n for (i,row) in rows.iter().enumerate(){let r=rect(safe-18.,ry+i as f32*row_h,content_w,row_h-6.);out.rows.push([r.left(),r.top(),r.right(),r.bottom()]);let res=ui.interact(r,egui::Id::new((\"merc_row\",&g.screen,g.page,i)),Sense::click_and_drag());if res.hovered()&&ctx.input(|i|i.pointer.delta().length_sq()>0.){out.hover=Some(i);}let selected=g.focus==i;if selected{p.rect_filled(r,0.,C::from_rgba_premultiplied(205,157,76,32));p.rect_filled(Rect::from_min_size(r.left_top(),Vec2::new(4.*scale,r.height())),0.,GOLD);}let col=if selected{PAPER}else{MUTED};text(&p,r.left_top()+Vec2::new(22.,if row.detail.is_empty(){row_h*.5-3.}else{25.})*scale,Align2::LEFT_CENTER,&row.name,if title{40.}else{35.}*scale,col,false);if !row.detail.is_empty(){text(&p,r.left_top()+Vec2::new(22.,64.)*scale,Align2::LEFT_CENTER,&row.detail,26.*scale,if selected{GOLD}else{MUTED},false);}if let Some([v,a,z])=row.value{let rr=Rect::from_min_size(r.right_center()-Vec2::new(290.,2.)*scale,Vec2::new(250.,4.)*scale);p.rect_filled(rr,0.,MUTED.gamma_multiply(.3));p.rect_filled(Rect::from_min_size(rr.left_top(),Vec2::new(rr.width()*((v-a)/(z-a)).clamp(0.,1.),rr.height())),0.,GOLD);p.circle_filled(Pos2::new(rr.left()+rr.width()*((v-a)/(z-a)).clamp(0.,1.),rr.center().y),7.*scale,PAPER);\n if res.dragged()&&g.screen==\"dev_balance\"{if let Some(pos)=res.interact_pointer_pos(){let q=((pos.x-rr.left())/rr.width()).clamp(0.,1.);out.action=act::SLIDER|(((g.page*6+i) as u32)<<16)|(q*65535.) as u32;}}}\n if res.clicked(){out.action=act::SELECT+i as u32;}}\n if g.page_count()>1 {let label=format!(\"{:02} / {:02}\",g.page+1,g.page_count());text(&p,point(w-safe,990.),Align2::RIGHT_CENTER,label,28.*scale,MUTED,false);for (j,ar) in [\"‹\",\"›\"].iter().enumerate(){let r=rect(w-safe-260.+j as f32*64.,958.,56.,65.);let res=ui.interact(r,egui::Id::new((\"page\",j)),Sense::click());text(&p,r.center(),Align2::CENTER_CENTER,*ar,50.*scale,PAPER,false);if res.clicked(){out.action=if j==0{act::PREV}else{act::NEXT};}}}\n if title{prompt(&p,point(safe,995.),\"Enter\",\"cross\",\"Select\",g,scale);}else{let r=rect(safe-15.,960.,150.,64.);let res=ui.interact(r,egui::Id::new(\"back\"),Sense::click());prompt(&p,point(safe+7.,992.),\"Esc\",\"circle\",\"Back\",g,scale);if res.clicked(){out.action=act::BACK;}if g.page_count()>1{prompt(&p,point(safe+250.,992.),\"Q / E\",\"L1 / R1\",\"Pages\",g,scale);}}\n if g.toast_time>0.{text(&p,point(w*.5,915.),Align2::CENTER_CENTER,&g.toast,28.*scale,GOLD,false);}\n out}\nfn hud(ui:&mut egui::Ui,g:&Merc,p:&egui::Painter,screen:Rect,s:f32){let w=screen.width()/s;let safe=w*.05;let at=|x:f32,y:f32|screen.left_top()+Vec2::new(x,y)*s;let weapon=&g.data.weapons[g.guns[g.active].def];let c=&g.data.contracts[g.contract.min(10)];text(p,at(safe,70.),Align2::LEFT_TOP,format!(\"{} / {}\",c.id,c.name.to_uppercase()),28.*s,GOLD,false);let goal=if g.session{let n=g.objects.iter().filter(|o|o.place==\"depot\"&&o.exploded).count();if n<3{format!(\"Destroy fuel tanks · {n}/3\")}else if g.ledger_carrier<0{\"Take the office ledger\".into()}else{\"Reach the river boat · 500 m south\".into()}}else{g.current_goal().map(|q|format!(\"{} · {}\",q.kind.to_uppercase(),g.data.place(&q.place).name)).unwrap_or_default()};text(p,at(safe,116.),Align2::LEFT_TOP,goal,30.*s,PAPER,false);\n if g.settings.standard {let deg=g.yaw.to_degrees();text(p,at(w*.5,65.),Align2::CENTER_TOP,format!(\"N     {:03.0}°     E\",deg),28.*s,PAPER,false);}\n if !g.map_up&&!g.monocular&&!g.safe_town(){p.circle_filled(at(w*.5,540.),2.*s,PAPER.gamma_multiply(.8));if g.hit_time>0.{for (dx,dy) in [(-1.,-1.),(1.,1.),(-1.,1.),(1.,-1.)]{p.line_segment([at(w*.5+dx*8.,540.+dy*8.),at(w*.5+dx*14.,540.+dy*14.)],Stroke::new(2.*s,GOLD));}}}\n if g.safe_town(){text(p,at(w*.5,865.),Align2::CENTER_CENTER,g.s(\"town_safe\"),28.*s,GOLD,false);}\n if g.health<20. {let a=(40.+(g.view_time*6.).sin()*20.) as u8;p.rect_stroke(screen.shrink(6.*s),0.,Stroke::new(18.*s,C::from_rgba_unmultiplied(140,30,15,a)),egui::StrokeKind::Inside);}\n if g.settings.standard||g.damage_time>0.||g.health<20.{for i in 0..5{let r=Rect::from_min_size(at(safe+i as f32*47.,980.),Vec2::new(39.,9.)*s);p.rect_filled(r,0.,if g.health>i as f32*20.{PAPER}else{PAPER.gamma_multiply(.15)});}text(p,at(safe,940.),Align2::LEFT_CENTER,format!(\"{} SYRETTES  /  {} PILLS\",g.syrettes,g.pills),24.*s,MUTED,false);}\n if g.settings.standard||g.ammo_time>0.||g.guns[g.active].ammo<6{let gun=&g.guns[g.active];text(p,at(w-safe,940.),Align2::RIGHT_CENTER,format!(\"{:02} / {}\",gun.ammo,gun.reserve),48.*s,PAPER,true);text(p,at(w-safe,990.),Align2::RIGHT_CENTER,&weapon.name,26.*s,MUTED,false);}\n if g.guns[g.active].jammed{prompt(p,at(w*.5-180.,880.),\"R\",\"square\",g.s(\"jam\"),g,s);}\n if let Some(a)=&g.action{let label=if a.kind.starts_with(\"wound\"){g.s(&format!(\"treatment_{}\",a.param)).to_string()}else{a.kind.to_uppercase()};text(p,at(w*.5,805.),Align2::CENTER_CENTER,label,28.*s,PAPER,false);let r=Rect::from_min_size(at(w*.5-130.,840.),Vec2::new(260.,4.)*s);p.rect_filled(r,0.,MUTED.gamma_multiply(.3));p.rect_filled(Rect::from_min_size(r.left_top(),Vec2::new(r.width()*(1.-a.left/a.duration),r.height())),0.,GOLD);}\n if let Some(prompt_s)=g.prompt(){prompt(p,at(w*.5-170.,945.),\"E\",\"square\",&prompt_s,g,s);}\n if g.monocular{let center=at(w*.5,540.);p.circle_stroke(center,370.*s,Stroke::new(40.*s,INK));p.line_segment([center-Vec2::new(0.,35.)*s,center+Vec2::new(0.,35.)*s],Stroke::new(s,PAPER));p.line_segment([center-Vec2::new(35.,0.)*s,center+Vec2::new(35.,0.)*s],Stroke::new(s,PAPER));let label=if let Some(i)=g.tag_target{let n=&g.soldiers[i];format!(\"{} m · {} · {}\",distance(n.pos,g.pos).round(),[\"Rifleman\",\"Machine-gunner\",\"Sniper\",\"Rocket man\",\"Flame trooper\"][n.role as usize],n.gun.word())}else{format!(\"5×  ·  Wind {:.0} m/s\",g.wind_speed)};text(p,at(w*.5,760.),Align2::CENTER_CENTER,label,28.*s,PAPER,false);}\n if g.map_up{let r=Rect::from_min_max(at(w*.23,270.),at(w*.68,855.));let res=ui.interact(r,egui::Id::new(\"map_paper\"),Sense::click());if let Some(pos)=res.hover_pos(){let uv=(pos-r.min)/r.size();let wp=glam::Vec2::new((uv.x-.5)*2048.,(uv.y-.5)*2048.);if let Some(place)=g.data.world.place.iter().min_by(|a,b|a.pos().truncate().distance(wp).total_cmp(&b.pos().truncate().distance(wp))){text(p,at(w*.5,880.),Align2::CENTER_CENTER,&place.name,30.*s,PAPER,false);}}text(p,at(w*.5,220.),Align2::CENTER_CENTER,g.s(\"map_hint\"),28.*s,PAPER,false);if let Some(way)=g.waypoint{text(p,at(w*.76,735.),Align2::CENTER_CENTER,format!(\"GPS'\"\\\\n{:.0} m\\\",distance(way,g.pos)),32.*s,GOLD,false);}}\n if g.tracker{text(p,at(w*.5,810.),Align2::CENTER_CENTER,if g.tracker_rate()>0.{\\\"SIGNAL · follow the faster pulse\\\"}else{\\\"NO SIGNAL · within 60 m of a cache\\\"},28.*s,GOLD,false);}\n if g.ending==2{text(p,at(w*.5,180.),Align2::CENTER_CENTER,format\"'!(\"HOLD THE MAST  {:03.0}\",(180.-g.ending_time).max(0.)),42.*s,GOLD,true);}\n if g.fever_state>0{prompt(p,at(w-safe-260.,190.),\"P\",\"Down\",\"Take quinine\",g,s);}\n if g.subtitle_time>0.{let line=format!(\"{}'\"\\\\n{}\\\",g.speaker.to_uppercase(),g.subtitle);let gal=p.layout(line,font(30.*s*g.settings.subtitles,false),PAPER,(w*.68).min(1200.)*s);let top=at(w*.5,1020.)-Vec2::new(gal.size().x*.5,gal.size().y);p.rect_filled(Rect::from_min_size(top-Vec2::splat(12.*s),gal.size()+Vec2::splat(24.*s)),2.,C::from_black_alpha(180));p.galley(top,gal,PAPER);}\n if g.toast_time>0.{text(p,at(w*.5,265.),Align2::CENTER_CENTER,&g.toast,28.*s,GOLD,false);}\n if g.cheats.stats{text(p,at(w-safe,65.),Align2::RIGHT_TOP,format\"'!(\"FIELD TOOLS · t {:.1}'\"\\\\n{} active fire cells\\\",g.time,g.fire.burning()),28.*s,GOLD,false);}\n}\nRS\npython3 - <<'PY'\nfrom pathlib import Path\nimport re\np=Path('engine/crates/pav_ui/src/tenfoot/mod.rs');s=p.read_text();s=re.sub(r'(?<\"'!['\"\\\\w.)\\\\]])\\\\.(\\\\d)',r'0.\\\\1',s);p.write_text(s)\np=Path('engine/crates/pav_ui/src/lib.rs');s=p.read_text().replace('pub mod touch;','pub mod touch;\\\\npub mod tenfoot;');p.write_text(s)\np=Path('engine/crates/pav_view/src/merc/mod.rs');s=p.read_text().replace(')0.0;',').0;').replace('()0.1','().1');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_ui/src/tenfoot/mod.rs <<'RS'\n//\"'! A painter-based television UI. Navigation lives in the deterministic game model.\nuse egui::{Color32 as C,FontId,FontFamily,Align2,Pos2,Rect,Vec2,Stroke,Sense};\nuse pav_core::games::merc::{Merc,act,data::distance};\n#[derive(Default,Clone,Copy)]pub struct MenuInput{pub up:bool,pub down:bool,pub left:bool,pub right:bool,pub confirm:bool,pub back:bool,pub tab:i32,pub pointer:Option<[f32;2]>,pub click:bool}\nimpl MenuInput{pub fn action(self)->u32{if self.up{act::UP}else if self.down{act::DOWN}else if self.left{act::LEFT}else if self.right{act::RIGHT}else if self.confirm{act::CONFIRM}else if self.back{act::BACK}else if self.tab>0{act::NEXT}else if self.tab<0{act::PREV}else{0}}}\nconst PAPER:C=C::from_rgb(236,222,185);const MUTED:C=C::from_rgb(174,164,139);const GOLD:C=C::from_rgb(216,165,80);const INK:C=C::from_rgb(30,32,27);const RED:C=C::from_rgb(179,62,39);\npub fn fonts(ctx:&egui::Context){let mut f=egui::FontDefinitions::default();f.font_data.insert(\"stencil\".into(),egui::FontData::from_static(include_bytes!(\"../../../../assets/fonts/StardosStencil-Bold.ttf\")).into());f.families.insert(FontFamily::Name(\"stencil\".into()),vec![\"stencil\".into()]);ctx.set_fonts(f);}\nfn font(n:f32,stencil:bool)->FontId{FontId::new(n,if stencil{FontFamily::Name(\"stencil\".into())}else{FontFamily::Proportional})}\nfn text(p:&egui::Painter,pos:Pos2,anchor:Align2,s:impl Into<String>,size:f32,color:C,stencil:bool){p.text(pos,anchor,s.into(),font(size,stencil),color);}\nfn glyph(p:&egui::Painter,pos:Pos2,name:&str,scale:f32,xbox:bool){let r=17.*scale;let st=Stroke::new(2.*scale,PAPER);match name{\"cross\" if !xbox=>{p.circle_stroke(pos,r,st);p.line_segment([pos+Vec2::splat(-7.*scale),pos+Vec2::splat(7.*scale)],st);p.line_segment([pos+Vec2::new(7.,-7.)*scale,pos+Vec2::new(-7.,7.)*scale],st);},\"circle\" if !xbox=>{p.circle_stroke(pos,r,st);p.circle_stroke(pos,8.*scale,st);},\"square\" if !xbox=>{p.circle_stroke(pos,r,st);p.rect_stroke(Rect::from_center_size(pos,Vec2::splat(14.*scale)),0.,st,egui::StrokeKind::Inside);},_=>{let s=match(name,xbox){(\"cross\",true)=>\"A\",(\"circle\",true)=>\"B\",(\"square\",true)=>\"X\",(\"triangle\",true)=>\"Y\",_=>name};p.rect_stroke(Rect::from_center_size(pos,Vec2::new((s.len() as f32*12.+14.).max(32.),34.)*scale),3.,st,egui::StrokeKind::Inside);text(p,pos,Align2::CENTER_CENTER,s,22.*scale,PAPER,false);}}}\nfn prompt(p:&egui::Painter,pos:Pos2,key:&str,pad:&str,label:&str,g:&Merc,s:f32){glyph(p,pos,if g.device==1{pad}else{key},s,g.settings.xbox);text(p,pos+Vec2::new(28.*s,0.),Align2::LEFT_CENTER,label,28.*s,PAPER,false);}\n#[derive(Default)]pub struct DrawResult{pub action:u32,pub hover:Option<usize>,pub rows:Vec<[f32;4]>}\npub fn draw(ui:&mut egui::Ui,g:&Merc)->DrawResult{let mut out=DrawResult::default();let ctx=ui.ctx().clone();let screen=ctx.content_rect();let scale=(screen.height()/1080.).max(0.25);let w=screen.width()/scale;let h=1080.;let safe=w*.05;let p=ui.painter().clone();let point=|x:f32,y:f32|Pos2::new(screen.left()+x*scale,screen.top()+y*scale);let rect=|x:f32,y:f32,ww:f32,hh:f32|Rect::from_min_size(point(x,y),Vec2::new(ww,hh)*scale);\n // Thin film border and registration marks.\n for (x,y,dx,dy) in [(safe,54.,1.,1.),(w-safe,54.,-1.,1.),(safe,1026.,1.,-1.),(w-safe,1026.,-1.,-1.)]{p.line_segment([point(x,y),point(x+dx*18.,y)],Stroke::new(scale,PAPER.gamma_multiply(.45)));p.line_segment([point(x,y),point(x,y+dy*18.)],Stroke::new(scale,PAPER.gamma_multiply(.45)));}\n let playing=matches!(g.screen.as_str(),\"playing\"|\"ending_defend\")&&!g.attracting;\n if playing{hud(ui,g,&p,screen,scale);return out;}\n if g.screen==\"card\"{p.rect_filled(rect(0.,0.,w,h),0.,C::from_black_alpha(90));text(&p,point(safe,95.),Align2::LEFT_TOP,g.s(\"title\").to_uppercase(),100.*scale,PAPER,true);text(&p,point(safe,240.),Align2::LEFT_TOP,g.s(\"session_title\"),40.*scale,GOLD,true);text(&p,point(safe,320.),Align2::LEFT_TOP,g.s(\"session_goal\"),32.*scale,PAPER,false);text(&p,point(safe,425.),Align2::LEFT_TOP,g.s(\"help_pad\"),28.*scale,PAPER,false);for (i,peer) in g.peers.iter().enumerate(){text(&p,point(w-safe-400.,360.+i as f32*65.),Align2::LEFT_TOP,format!(\"MERC {}  ·  {}\",peer.id+1,if peer.present{\"Ready on the card\"}else{\"Waiting\"}),30.*scale,GOLD,false);}text(&p,point(safe,920.),Align2::LEFT_TOP,g.s(\"ready_help\"),30.*scale,PAPER,false);return out;}\n if g.attracting {text(&p,point(safe,85.),Align2::LEFT_TOP,g.s(\"title\").to_uppercase(),84.*scale,PAPER,true);if let Some(seg)=g.data.attract.get(g.attract_segment){text(&p,point(safe,190.),Align2::LEFT_TOP,seg.name.to_uppercase(),28.*scale,GOLD,false);}text(&p,point(w*.5,955.),Align2::CENTER_CENTER,if g.touch_only{g.s(\"touch\")}else{g.s(\"press\")},36.*scale,PAPER.gamma_multiply(.7+.3*(g.view_time*2.).sin().abs()),false);if g.touch_only{let r=rect(w*.5-140.,985.,280.,65.);let res=ui.interact(r,egui::Id::new(\"touch_settings\"),Sense::click());p.rect_filled(r,2.,INK);text(&p,r.center(),Align2::CENTER_CENTER,g.s(\"settings\"),30.*scale,PAPER,false);if res.clicked(){out.action=act::SELECT+3;}}return out;}\n let title=g.screen==\"title\";\n // A warm black gradient keeps type readable while the world remains present.\n let panel_w=if title{w*.60}else{w*.72};let mut mesh=egui::Mesh::default();let x0=screen.left();let x1=screen.left()+panel_w*scale;let a=C::from_rgba_premultiplied(14,18,14,235);let z=C::from_rgba_premultiplied(10,14,11,25);for (pos,color) in [(Pos2::new(x0,screen.top()),a),(Pos2::new(x1,screen.top()),z),(Pos2::new(x1,screen.bottom()),z),(Pos2::new(x0,screen.bottom()),a)]{mesh.colored_vertex(pos,color);}mesh.add_triangle(0,1,2);mesh.add_triangle(0,2,3);p.add(egui::Shape::mesh(mesh));\n let start_y;if title{let title=g.s(\"title\").to_uppercase();let title=title.rsplit_once('\"' ').map(|(a,b)|format\"'!(\"{a}'\"\\\\n{b}\\\")).unwrap_or(title);text(&p,point(safe,120.),Align2::LEFT_TOP,\\\"CONTRACTOR’S COPY     /     01\\\",28.*scale,GOLD,false);text(&p,point(safe-5.,193.),Align2::LEFT_TOP,title,138.*scale,PAPER,true);text(&p,point(safe,490.),Align2::LEFT_TOP,g.s(\\\"tagline\\\"),28.*scale,MUTED,false);p.line_segment([point(safe,550.),point(safe+120.,550.)],Stroke::new(3.*scale,RED));start_y=590.;\n text(&p,point(w-safe,88.),Align2::RIGHT_TOP,g.s(\\\"country\\\"),28.*scale,PAPER,false);text(&p,point(w-safe,132.),Align2::RIGHT_TOP,g.s(\\\"season\\\"),24.*scale,MUTED,false);if w>1400.{p.line_segment([point(w-safe-410.,822.),point(w-safe,822.)],Stroke::new(scale,GOLD));text(&p,point(w-safe-410.,852.),Align2::LEFT_TOP,\\\"01 / LANDING FEES\\\",28.*scale,GOLD,false);text(&p,point(w-safe-410.,905.),Align2::LEFT_TOP,\\\"The crates are for both sides.\\\\nSo is the receipt.\\\",30.*scale,PAPER,false);}}\n else{let heading=match g.screen.as_str(){\\\"difficulty\\\"=>\\\"TERMS OF EMPLOYMENT\\\",\\\"dossier\\\"=>\\\"SELECT YOUR DOSSIER\\\",\\\"pause\\\"=>g.s(\\\"pause\\\"),\\\"contract\\\"=>g.s(\\\"contract\\\"),\\\"shop\\\"=>g.s(\\\"shop_title\\\"),\\\"locker\\\"=>g.s(\\\"inventory\\\"),\\\"safehouse\\\"=>\\\"SAFE HOUSE\\\",\\\"dev\\\"=>g.s(\\\"dev_title\\\"),\\\"about\\\"=>\\\"ON THE RECORD\\\",\\\"settings\\\"|\\\"session_settings\\\"=>\\\"SETTINGS\\\",\\\"ending_choice\\\"=>\\\"LAST ORDER\\\",\\\"ending\\\"=>g.s(\\\"ending_tape\\\"),\\\"death\\\"=>\\\"CONTRACT CLOSED\\\",_=>&g.screen};text(&p,point(safe,100.),Align2::LEFT_TOP,heading.to_uppercase().replace('_',\\\" \\\"),64.*scale,PAPER,true);p.line_segment([point(safe,205.),point(safe+130.,205.)],Stroke::new(3.*scale,RED));start_y=310.;}\n let rows=g.rows();let content_w=(w*.56).min(980.);let row_h=if title{68.}else{91.};let mut ry=start_y;\n if g.screen==\\\"contract\\\"{let c=&g.data.contracts[g.contract];text(&p,point(safe,260.),Align2::LEFT_TOP,format\"'!(\"{} / {}\",c.id,c.name),40.*scale,GOLD,false);text(&p,point(safe,337.),Align2::LEFT_TOP,&c.giver,30.*scale,MUTED,false);text(&p,point(safe,407.),Align2::LEFT_TOP,&c.brief,34.*scale,PAPER,false);text(&p,point(safe,637.),Align2::LEFT_TOP,format!(\"Payment: {} diamonds\",c.pay),30.*scale,GOLD,false);ry=760.;}\n if g.screen==\"ending_choice\"{text(&p,point(safe,270.),Align2::LEFT_TOP,g.s(\"ledger\"),30.*scale,MUTED,false);ry=460.;}\n if g.screen==\"ending\"||g.screen==\"death\"||g.screen==\"quit\"{let t=if g.screen==\"ending\"{g.subtitle.as_str()}else if g.screen==\"death\"{g.s(\"death\")}else{\"Your last autosave was made at a bed or a contract change.\"};let gal=p.layout(t.into(),font(34.*scale,false),PAPER,content_w*scale);p.galley(point(safe,300.),gal,PAPER);ry=720.;}\n if g.screen==\"settings\"||g.screen==\"session_settings\"{text(&p,point(safe,245.),Align2::LEFT_TOP,[\"01  /  SOUND\",\"02  /  CONTROLS\",\"03  /  PICTURE\",\"04  /  ACCESS\"][g.page%4],30.*scale,GOLD,false);}\n if g.screen==\"shop\"{text(&p,point(w-safe,240.),Align2::RIGHT_TOP,format!(\"{} DIAMONDS\",g.diamonds),32.*scale,GOLD,false);}\n if g.screen==\"about\"{if let Some(page)=g.data.about.get(g.page){text(&p,point(safe,260.),Align2::LEFT_TOP,&page.title,36.*scale,GOLD,false);let mut y=345.;for l in &page.lines{let gal=p.layout(l.clone(),font(29.*scale,false),PAPER,(w-safe*2.).min(1550.)*scale);let hh=gal.size().y/scale;p.galley(point(safe,y),gal,PAPER);y+=hh+22.;}}}\n if g.screen==\"controls\"{text(&p,point(safe,270.),Align2::LEFT_TOP,if g.page==0{g.s(\"help_foot\")}else if g.page==1{g.s(\"help_vehicle\")}else{g.s(\"help_pad\")},36.*scale,PAPER,false);}\n for (i,row) in rows.iter().enumerate(){let r=rect(safe-18.,ry+i as f32*row_h,content_w,row_h-6.);out.rows.push([r.left(),r.top(),r.right(),r.bottom()]);let res=ui.interact(r,egui::Id::new((\"merc_row\",&g.screen,g.page,i)),Sense::click_and_drag());if res.hovered()&&ctx.input(|i|i.pointer.delta().length_sq()>0.){out.hover=Some(i);}let selected=g.focus==i;if selected{p.rect_filled(r,0.,C::from_rgba_premultiplied(205,157,76,32));p.rect_filled(Rect::from_min_size(r.left_top(),Vec2::new(4.*scale,r.height())),0.,GOLD);}let col=if selected{PAPER}else{MUTED};text(&p,r.left_top()+Vec2::new(22.,if row.detail.is_empty(){row_h*.5-3.}else{25.})*scale,Align2::LEFT_CENTER,&row.name,if title{40.}else{35.}*scale,col,false);if !row.detail.is_empty(){text(&p,r.left_top()+Vec2::new(22.,64.)*scale,Align2::LEFT_CENTER,&row.detail,26.*scale,if selected{GOLD}else{MUTED},false);}if let Some([v,a,z])=row.value{let rr=Rect::from_min_size(r.right_center()-Vec2::new(290.,2.)*scale,Vec2::new(250.,4.)*scale);p.rect_filled(rr,0.,MUTED.gamma_multiply(.3));p.rect_filled(Rect::from_min_size(rr.left_top(),Vec2::new(rr.width()*((v-a)/(z-a)).clamp(0.,1.),rr.height())),0.,GOLD);p.circle_filled(Pos2::new(rr.left()+rr.width()*((v-a)/(z-a)).clamp(0.,1.),rr.center().y),7.*scale,PAPER);\n if res.dragged()&&g.screen==\"dev_balance\"{if let Some(pos)=res.interact_pointer_pos(){let q=((pos.x-rr.left())/rr.width()).clamp(0.,1.);out.action=act::SLIDER|(((g.page*6+i) as u32)<<16)|(q*65535.) as u32;}}}\n if res.clicked(){out.action=act::SELECT+i as u32;}}\n if g.page_count()>1 {let label=format!(\"{:02} / {:02}\",g.page+1,g.page_count());text(&p,point(w-safe,990.),Align2::RIGHT_CENTER,label,28.*scale,MUTED,false);for (j,ar) in [\"‹\",\"›\"].iter().enumerate(){let r=rect(w-safe-260.+j as f32*64.,958.,56.,65.);let res=ui.interact(r,egui::Id::new((\"page\",j)),Sense::click());text(&p,r.center(),Align2::CENTER_CENTER,*ar,50.*scale,PAPER,false);if res.clicked(){out.action=if j==0{act::PREV}else{act::NEXT};}}}\n if title{prompt(&p,point(safe,995.),\"Enter\",\"cross\",\"Select\",g,scale);}else{let r=rect(safe-15.,960.,150.,64.);let res=ui.interact(r,egui::Id::new(\"back\"),Sense::click());prompt(&p,point(safe+7.,992.),\"Esc\",\"circle\",\"Back\",g,scale);if res.clicked(){out.action=act::BACK;}if g.page_count()>1{prompt(&p,point(safe+250.,992.),\"Q / E\",\"L1 / R1\",\"Pages\",g,scale);}}\n if g.toast_time>0.{text(&p,point(w*.5,915.),Align2::CENTER_CENTER,&g.toast,28.*scale,GOLD,false);}\n out}\nfn hud(ui:&mut egui::Ui,g:&Merc,p:&egui::Painter,screen:Rect,s:f32){let w=screen.width()/s;let safe=w*.05;let at=|x:f32,y:f32|screen.left_top()+Vec2::new(x,y)*s;let weapon=&g.data.weapons[g.guns[g.active].def];let c=&g.data.contracts[g.contract.min(10)];text(p,at(safe,70.),Align2::LEFT_TOP,format!(\"{} / {}\",c.id,c.name.to_uppercase()),28.*s,GOLD,false);let goal=if g.session{let n=g.objects.iter().filter(|o|o.place==\"depot\"&&o.exploded).count();if n<3{format!(\"Destroy fuel tanks · {n}/3\")}else if g.ledger_carrier<0{\"Take the office ledger\".into()}else{\"Reach the river boat · 500 m south\".into()}}else{g.current_goal().map(|q|format!(\"{} · {}\",q.kind.to_uppercase(),g.data.place(&q.place).name)).unwrap_or_default()};text(p,at(safe,116.),Align2::LEFT_TOP,goal,30.*s,PAPER,false);\n if g.settings.standard {let deg=g.yaw.to_degrees();text(p,at(w*.5,65.),Align2::CENTER_TOP,format!(\"N     {:03.0}°     E\",deg),28.*s,PAPER,false);}\n if !g.map_up&&!g.monocular&&!g.safe_town(){p.circle_filled(at(w*.5,540.),2.*s,PAPER.gamma_multiply(.8));if g.hit_time>0.{for (dx,dy) in [(-1.,-1.),(1.,1.),(-1.,1.),(1.,-1.)]{p.line_segment([at(w*.5+dx*8.,540.+dy*8.),at(w*.5+dx*14.,540.+dy*14.)],Stroke::new(2.*s,GOLD));}}}\n if g.safe_town(){text(p,at(w*.5,865.),Align2::CENTER_CENTER,g.s(\"town_safe\"),28.*s,GOLD,false);}\n if g.health<20. {let a=(40.+(g.view_time*6.).sin()*20.) as u8;p.rect_stroke(screen.shrink(6.*s),0.,Stroke::new(18.*s,C::from_rgba_unmultiplied(140,30,15,a)),egui::StrokeKind::Inside);}\n if g.settings.standard||g.damage_time>0.||g.health<20.{for i in 0..5{let r=Rect::from_min_size(at(safe+i as f32*47.,980.),Vec2::new(39.,9.)*s);p.rect_filled(r,0.,if g.health>i as f32*20.{PAPER}else{PAPER.gamma_multiply(.15)});}text(p,at(safe,940.),Align2::LEFT_CENTER,format!(\"{} SYRETTES  /  {} PILLS\",g.syrettes,g.pills),24.*s,MUTED,false);}\n if g.settings.standard||g.ammo_time>0.||g.guns[g.active].ammo<6{let gun=&g.guns[g.active];text(p,at(w-safe,940.),Align2::RIGHT_CENTER,format!(\"{:02} / {}\",gun.ammo,gun.reserve),48.*s,PAPER,true);text(p,at(w-safe,990.),Align2::RIGHT_CENTER,&weapon.name,26.*s,MUTED,false);}\n if g.guns[g.active].jammed{prompt(p,at(w*.5-180.,880.),\"R\",\"square\",g.s(\"jam\"),g,s);}\n if let Some(a)=&g.action{let label=if a.kind.starts_with(\"wound\"){g.s(&format!(\"treatment_{}\",a.param)).to_string()}else{a.kind.to_uppercase()};text(p,at(w*.5,805.),Align2::CENTER_CENTER,label,28.*s,PAPER,false);let r=Rect::from_min_size(at(w*.5-130.,840.),Vec2::new(260.,4.)*s);p.rect_filled(r,0.,MUTED.gamma_multiply(.3));p.rect_filled(Rect::from_min_size(r.left_top(),Vec2::new(r.width()*(1.-a.left/a.duration),r.height())),0.,GOLD);}\n if let Some(prompt_s)=g.prompt(){prompt(p,at(w*.5-170.,945.),\"E\",\"square\",&prompt_s,g,s);}\n if g.monocular{let center=at(w*.5,540.);p.circle_stroke(center,370.*s,Stroke::new(40.*s,INK));p.line_segment([center-Vec2::new(0.,35.)*s,center+Vec2::new(0.,35.)*s],Stroke::new(s,PAPER));p.line_segment([center-Vec2::new(35.,0.)*s,center+Vec2::new(35.,0.)*s],Stroke::new(s,PAPER));let label=if let Some(i)=g.tag_target{let n=&g.soldiers[i];format!(\"{} m · {} · {}\",distance(n.pos,g.pos).round(),[\"Rifleman\",\"Machine-gunner\",\"Sniper\",\"Rocket man\",\"Flame trooper\"][n.role as usize],n.gun.word())}else{format!(\"5×  ·  Wind {:.0} m/s\",g.wind_speed)};text(p,at(w*.5,760.),Align2::CENTER_CENTER,label,28.*s,PAPER,false);}\n if g.map_up{let r=Rect::from_min_max(at(w*.23,270.),at(w*.68,855.));let res=ui.interact(r,egui::Id::new(\"map_paper\"),Sense::click());if let Some(pos)=res.hover_pos(){let uv=(pos-r.min)/r.size();let wp=glam::Vec2::new((uv.x-.5)*2048.,(uv.y-.5)*2048.);if let Some(place)=g.data.world.place.iter().min_by(|a,b|a.pos().truncate().distance(wp).total_cmp(&b.pos().truncate().distance(wp))){text(p,at(w*.5,880.),Align2::CENTER_CENTER,&place.name,30.*s,PAPER,false);}}text(p,at(w*.5,220.),Align2::CENTER_CENTER,g.s(\"map_hint\"),28.*s,PAPER,false);if let Some(way)=g.waypoint{text(p,at(w*.76,735.),Align2::CENTER_CENTER,format!(\"GPS'\"\\\\n{:.0} m\\\",distance(way,g.pos)),32.*s,GOLD,false);}}\n if g.tracker{text(p,at(w*.5,810.),Align2::CENTER_CENTER,if g.tracker_rate()>0.{\\\"SIGNAL · follow the faster pulse\\\"}else{\\\"NO SIGNAL · within 60 m of a cache\\\"},28.*s,GOLD,false);}\n if g.ending==2{text(p,at(w*.5,180.),Align2::CENTER_CENTER,format\"'!(\"HOLD THE MAST  {:03.0}\",(180.-g.ending_time).max(0.)),42.*s,GOLD,true);}\n if g.fever_state>0{prompt(p,at(w-safe-260.,190.),\"P\",\"Down\",\"Take quinine\",g,s);}\n if g.subtitle_time>0.{let line=format!(\"{}'\"\\\\n{}\\\",g.speaker.to_uppercase(),g.subtitle);let gal=p.layout(line,font(30.*s*g.settings.subtitles,false),PAPER,(w*.68).min(1200.)*s);let top=at(w*.5,1020.)-Vec2::new(gal.size().x*.5,gal.size().y);p.rect_filled(Rect::from_min_size(top-Vec2::splat(12.*s),gal.size()+Vec2::splat(24.*s)),2.,C::from_black_alpha(180));p.galley(top,gal,PAPER);}\n if g.toast_time>0.{text(p,at(w*.5,265.),Align2::CENTER_CENTER,&g.toast,28.*s,GOLD,false);}\n if g.cheats.stats{text(p,at(w-safe,65.),Align2::RIGHT_TOP,format\"'!(\"FIELD TOOLS · t {:.1}'\"\\\\n{} active fire cells\\\",g.time,g.fire.burning()),28.*s,GOLD,false);}\n}\nRS\npython3 - <<'PY'\nfrom pathlib import Path\nimport re\np=Path('engine/crates/pav_ui/src/tenfoot/mod.rs');s=p.read_text();s=re.sub(r'(?<\"'!['\"\\\\w.)\\\\]])\\\\.(\\\\d)',r'0.\\\\1',s);p.write_text(s)\np=Path('engine/crates/pav_ui/src/lib.rs');s=p.read_text().replace('pub mod touch;','pub mod touch;\\\\npub mod tenfoot;');p.write_text(s)\np=Path('engine/crates/pav_view/src/merc/mod.rs');s=p.read_text().replace(')0.0;',').0;').replace('()0.1','().1');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
