{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_tools/src/merc_tools.rs <<'RS'\nuse anyhow::{Result,anyhow};\nuse serde_json::json;\nuse pav_core::{InputFrame,games::{Game,merc::{Merc,fire::Fire,terrain,data::flat}}};\nuse crate::{session::Session,tools::{Args,Output,get_u64,get_str,vec_arg}};\npub fn command(s:&mut Session,a:&Args)->Result<Output>{let act=get_u64(a,\\\"act\\\",0)? as u32;let n=get_u64(a,\\\"ticks\\\",1)?;for i in 0..n{s.sim.step(&InputFrame{act:if i==0{act}else{0},..Default::default()});}let g=s.sim.play().and_then(|p|p.get::<Merc>()).ok_or_else(||anyhow\"'!(\"load scene=merc first\"))?;Ok(Output::Json(g.status(&s.sim)))}\npub fn fire(s:&mut Session,a:&Args)->Result<Output>{let mut play=s.sim.state.play.take().ok_or_else(||anyhow!(\"load scene=merc first\"))?;let g=play.get_mut::<Merc>().ok_or_else(||anyhow!(\"not a merc scene\"))?;match get_str(a,\"action\").unwrap_or(\"report\"){\"start\"=>{let p=vec_arg(a,\"pos\")?.map(|p|glam::Vec2::new(p[0],p[1])).unwrap_or(flat(g.pos)+glam::Vec2::splat(12.));g.fire.ignite(&g.data,p,4.);},\"step\"=>{let n=get_u64(a,\"ticks\",240)?;for _ in 0..n{g.fire.step(&g.data,&mut s.sim.state.rng,&g.tuning,g.wind,g.wind_speed,g.weather==2,0.25);}},\"extinguish\"=>{for c in g.fire.cells.values_mut(){c.state=2;}},\"regrow\"=>g.fire=Fire::default(),_=>{}}let result=json!({\"burning\":g.fire.burning(),\"total\":g.fire.total,\"version\":g.fire.version});s.sim.state.play=Some(play);Ok(Output::Json(result))}\npub fn mapshot(s:&mut Session,a:&Args)->Result<Output>{let d=pav_core::games::merc::data::data();let size=768u32;let mut px=vec![0u8;(size*size*4) as usize];for z in 0..size{for x in 0..size{let wx=x as f32/size as f32*2048.-1024.;let wz=z as f32/size as f32*2048.-1024.;let cc=if terrain::water(&d,glam::Vec2::new(wx,wz)){[61,106,106]}else if terrain::road(&d,glam::Vec2::new(wx,wz))<4.{[164,85,47]}else{let h=terrain::height(&d,wx,wz);[(173.+h) as u8,(151.+h) as u8,91]};let i=((z*size+x)*4) as usize;px[i..i+4].copy_from_slice(&[cc[0],cc[1],cc[2],255]);}}for p in &d.world.place{let x=((p.x+1024.)/2048.*size as f32) as i32;let z=((p.z+1024.)/2048.*size as f32) as i32;for dx in -3..=3{for dz in -3..=3{let i=(((z+dz).clamp(0,size as i32-1) as u32*size+(x+dx).clamp(0,size as i32-1) as u32)*4) as usize;px[i..i+4].copy_from_slice(&[40,40,30,255]);}}}let png=pav_render::capture::encode_png(size,size,&px)?;let path=std::path::PathBuf::from(get_str(a,\"out\").unwrap_or(\"../notes/map.png\"));std::fs::write(&path,&png)?;let _=s;Ok(Output::Image{png,path:Some(path),meta:json!({\"places\":d.world.place,\"metres\":2048})})}\nRS\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_tools/src/lib.rs');s=p.read_text();s+='\\\\npub mod merc_tools;\\\\n';p.write_text(s)\np=Path('engine/crates/pav_tools/src/tools.rs');s=p.read_text().replace('            cmd: None,','            cmd: None,\\\\n            ..Default::default()');s=s.replace('pub static TOOLS: &[Tool] = &[','''pub static TOOLS: &[Tool] = &[\nTool{name:\\\"merc_cmd\\\",help:\\\"Perform a deterministic game action; reports survival and campaign state.\\\",args:&[arg(\\\"act\\\",\\\"integer\\\",\\\"Action code\\\"),arg(\\\"ticks\\\",\\\"integer\\\",\\\"Ticks after action\\\")],run:crate::merc_tools::command},\nTool{name:\\\"fire\\\",help:\\\"Ignite, advance, extinguish or report the sparse fire.\\\",args:&[arg(\\\"action\\\",\\\"string\\\",\\\"start, step, extinguish, regrow, report\\\"),arg(\\\"pos\\\",\\\"array\\\",\\\"World x,z\\\"),arg(\\\"ticks\\\",\\\"integer\\\",\\\"Quarter-second steps\\\")],run:crate::merc_tools::fire},\nTool{name:\\\"mapshot\\\",help:\\\"Render the country, river, roads and places from game data.\\\",args:&[arg(\\\"out\\\",\\\"string\\\",\\\"PNG path\\\")],run:crate::merc_tools::mapshot},''');p.write_text(s)\np=Path('engine/crates/pav_app/src/merc_shell.rs');s=p.read_text().replace('match event{WindowEvent::CloseRequested',