ent(h, t) {\n  const W = WORLD, map = W.map;\n  const B = h.bot || (h.bot = { t: -1, goal: null, flow: new E.FlowField(map) });\n  if (t - B.t > .5 || !B.goal) {\n    B.t = t;\n    let goal = null, best = Infinity;\n    const want = (x, y, d) => { if (d < best) { best = d; goal = { x, y }; } };\n    if (h.hp < 350) for (const it of W.items) if (it.alive && (it.ch === 'f' || it.ch === 'b' || it.ch === 'j')) want(it.x, it.y, Math.hypot(it.x - h.body.x, it.y - h.body.y) * .6);\n    for (const g of W.gens) if (g.alive) want(g.x, g.y, Math.hypot(g.x - h.body.x, g.y - h.body.y) * 1.1);\n    for (const it of W.items) if (it.alive && !it.def.shootable) want(it.x, it.y, Math.hypot(it.x - h.body.x, it.y - h.body.y) * .9);\n    if (!goal || best > 400 || W.floorClock > 40) goal = { x: (W.F.stairs[0] + .5) * T, y: (W.F.stairs[1] + .5) * T };\n    B.goal = goal; B.flow.update(goal.x, goal.y);\n  }\n  const dir = B.flow.dir(h.body.x, h.body.y, B.goal.x, B.goal.y);\n  const dd = Math.hypot(B.goal.x - h.body.x, B.goal.y - h.body.y);\n  let target = null, td = 150;\n  for (const m of W.monsters) if (m.alive) { const d = Math.hypot(m.x - h.body.x, m.y - h.body.y); if (d < td) { td = d; target = m; } }\n  for (const g of W.gens) if (g.alive) { const d = Math.hypot(g.x - h.body.x, g.y - h.body.y); if (d < td) { td = d; target = g; } }\n  const aim = target ? Math.atan2(target.y - h.body.y, target.x - h.body.x) : null;\n  const near = dd < 6;\n  return {\n    move: near && !target ? [0, 0] : dir,\n    aim,\n    fire: !!target,\n    magic: W.monsters.filter(m => m.alive).length >= 12 && (h.flasks > 0 || CHEATS.infinite || W.attract),\n    plant: false\n  };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01TkkN9wHT9WjpMqT6cVg2Y3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
