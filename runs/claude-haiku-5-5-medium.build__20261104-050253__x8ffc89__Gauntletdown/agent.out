UT: TREASURE, KILLS, STAIRS. DON\\'T STARVE.', r.W / 2, r.H * .6, '#fff4c8', { align: 'center', shadow: '#000' });\n    r.text('MOVE ' + game.input.label('left') + game.input.label('up') + game.input.label('down') + game.input.label('right') + '   FIRE ' + game.input.label('fire') + '   MAGIC ' + game.input.label('magic'), r.W / 2, r.H * .72, '#e8e0ff', { align: 'center', shadow: '#000' });\n    r.text('[' + game.input.label('confirm') + '] READY   [' + game.input.label('magic') + '] MORE TIME', r.W / 2, r.H - 16, '#ffd36a', { align: 'center', shadow: '#000' });\n  }\n};\n\n// The round over: the standings from the hub, and this player's score.\nconst roundover = {\n  pausable: false,\n  enter() { this.t = 0; },\n  update(dt) { this.t += dt; },\n  draw(r) {\n    r.sky(['#06050e', '#2a1a20']);\n    r.overlay(g => E.font.title(g, 'ROUND OVER', r.W / 2, Math.round(r.H * .2), { scale: 3, align: 'center' }));\n    const me = WORLD.heroes[0];\n    r.text(me ? me.name + '  SCORE ' + heroScore(me) : '', r.W / 2, r.H * .5, '#ffe08a', { align: 'center', scale: 2, shadow: '#000' });\n    if (ROUND.standings) ROUND.standings.forEach((ids, place) => r.text((place + 1) + '. ' + ids.map(id => (HUB.players[id] || { name: '?' }).name).join(' = '), r.W / 2, r.H * .66 + place * 11, '#e8e0ff', { align: 'center', shadow: '#000' }));\n    if (ROUND.reason && ROUND.reason !== 'finished') r.text('ENDED: ' + String(ROUND.reason).toUpperCase(), r.W / 2, r.H - 16, '#8a80a8', { align: 'center', shadow: '#000' });\n  }\n};\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01XDQGXBELvqx9ckED2fgJ2R","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
