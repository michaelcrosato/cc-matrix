{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014wta5V5wpo7AHKzQccBd24","type":"tool_result","content":"const card = {\n  pausable: false,\n  enter(d) {\n    d = d || {};\n    IDLE = 0; this.index = d.index || 0; this.t = 0; this.first = !!d.first;\n    if (this.index < FLOORS.length) loadFloor(this.index);\n    WORLD.attract = false;\n    game.audio.music(E.songs.adventure);\n    game.lights.enabled = false;\n    const key = 'floor_' + (this.index + 1);\n    WORLD.caption = null;\n    say(this.first ? 'start' : key, null, true);\n  },\n  update(dt) {\n    this.t += dt;\n    const go = PRESSING('confirm') || PRESSING('fire') || this.t > 6;\n    if (go && this.t > .6) {\n      const W = WORLD;\n      if (this.index >= FLOORS.length) { game.go('ending', null, { fade: 'black' }); return; }\n      game.go('play', { index: this.index }, { fade: 'iris', at: W.heroes.find(h => !h.down) });\n    }\n  },\n  draw(r) {\n    const F = FLOORS[this.index];\n    r.sky(['#06050e', '#2a1a20', '#4a2a20']);\n    r.overlay(g => E.font.title(g, 'FLOOR ' + (this.index + 1), r.W / 2, Math.round(r.H * .22), { scale: 3, align: 'center' }));\n    r.text(F.name.toUpperCase(), r.W / 2, r.H * .52, '#ffe08a', { align: 'center', scale: 2, shadow: '#000' });\n    r.text(F.realm.toUpperCase(), r.W / 2, r.H * .64, '#c8b8e0', { align: 'center', shadow: '#000' });\n    if (WORLD.caption) r.text(WORLD.caption, r.W / 2, r.H * .76, '#fff4c8', { align: 'center', shadow: '#000' });\n    if (this.index > 0) WORLD.heroes.forEach((h, i) => r.text(h.name + '  SCORE ' + h.score + '  KILLS ' + h.kills + '  TREASURE ' + (h.treasure || 0), r.W / 2, r.H * .86 + i * 11, h.color, { align: 'center', shadow: '#000' }));\n    r.text('[' + game.input.label('confirm') + '] GO', r.W / 2, r.H - 12, '#8a80a8', { align: 'center', shadow: '#000' });\n  }\n};","is_error":false}]},"parent_tool_use_id":null,"session_id":"a6e08c15-1510-4ccd-89c0-2fe447fbc059","uuid":"62ea852d-c25e-4234-912c-fcbb453afddc"