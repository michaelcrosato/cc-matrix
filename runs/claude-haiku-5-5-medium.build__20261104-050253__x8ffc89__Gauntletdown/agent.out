.pressed('pause'))) { openPause(); return; }\"),\n(\"    if (W.over && !W.gameOverGone) {\\n      W.gameOverGone = true;\\n      game.go('gameover', null, { fade: 'black' });\",\n \"    if (W.over && !W.gameOverGone) {\\n      W.gameOverGone = true;\\n      if (SESSION) { reportResult('over'); game.go('roundover', null, { fade: 'black' }); return; }\\n      game.go('gameover', null, { fade: 'black' });\"),\n(\"  draw(r) {\\n    drawWorld(r);\\n    drawHud(r);\\n    if (OV) drawOverlay(r);\\n  }\",\n \"  draw(r) {\\n    if (SESSION && !(AIHub.time() >= 0)) {\\n      drawWorld(r);\\n      const t = AIHub.time();\\n      r.text(isFinite(t) ? String(Math.max(1, Math.ceil(-t))) : 'READY', r.W / 2, r.H / 2 - 20, '#ffe08a', { align: 'center', scale: 3, shadow: '#000' });\\n      return;\\n    }\\n    drawWorld(r);\\n    drawHud(r);\\n    if (SESSION) drawGhosts(r);\\n    if (OV) drawOverlay(r);\\n  }\"),\n])\npatch('50-draw.js', [(\"  if (CHEATS.god || CHEATS.infinite || CHEATS.freeze || CHEATS.noGen || TUNE_CHANGED()) r.text('DEV'\", \"  if (SESSION) r.text('ROUND', r.W - 6, 40, '#ffe08a', { align: 'right', shadow: '#000' });\\n  if (CHEATS.god || CHEATS.infinite || CHEATS.freeze || CHEATS.noGen || TUNE_CHANGED()) r.text('DEV'\")])\nprint('ok')\nEOF\npython3 - \"$D\" <<'EOF'\nimport sys\nD=sys.argv[1]\np=D+'/build.mjs'; s=open(p).read()\ns=s.replace(\"const runDir = resolve(here, '..');\", \"const runDir = resolve(here, '..');\\n\")\ns=s.replace(\"const gameJs = `(() => {\", \"// The AI Hub client goes first, byte for byte, and must match the hub's copy.\\nconst session = readFileSync(join(here, 'hub', 'session.js'), 'utf8');\\nif (!session.startsWith('/*! aihub-session')) throw new Error('hub/session.js does not look like the AI Hub client');\\nconst gameJs = `(() => {\")\ns=s.replace(\"const html = `<!doctype html><html lang=\\\"en\\\"><head>\\n<meta charset=\\\"utf-8\\\">\\n\", \"const html = `<!doctype html><html lang=\\\"en\\\"><head>\\n<meta charset=\\\"utf-8\\\">\\