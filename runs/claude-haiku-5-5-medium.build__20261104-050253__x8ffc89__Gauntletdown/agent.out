, sy, 10, 40, .6, { color: '#9a88e0' });\",\n \"  if (W.F.stairs[0] >= 0) {\\n    const sx = (W.F.stairs[0] + .5) * T, sy = (W.F.stairs[1] + .5) * T;\\n    r.sprite(sx, sy, 0, SPR.stairs, { anchor: 'center' });\\n    game.lights.add(sx, sy, 10, 40, .6, { color: '#9a88e0' });\\n  }\"),\n(\"  r.text('FLOOR ' + (W.floor + 1) + ' - ' + FLOORS[W.floor].name.toUpperCase(), r.W / 2, 4, '#f0e8ff', { align: 'center', shadow: '#000' });\\n  if (W.F && W.floorClock > 0) {\\n    const left = Math.max(0, Math.ceil(WORLD.F.def.par - W.floorClock));\",\n \"  r.text(STAGE_LABEL(W.stage).toUpperCase() + ' - ' + W.stage.name.toUpperCase(), r.W / 2, 4, '#f0e8ff', { align: 'center', shadow: '#000' });\\n  if (W.F && W.floorClock > 0 && W.stage.par) {\\n    const left = Math.max(0, Math.ceil(W.stage.par - W.floorClock));\"),\n])\npatch('99-start.js', [\n(\"    scene: game.sceneName, floor: WORLD.floor + 1,\", \"    scene: game.sceneName, stage: WORLD.index, floor: WORLD.index + 1,\"),\n(\"  warp: n => { loadFloor(n); },\", \"  warp: n => { loadStage(n); },\"),\n(\"  validate: () => FLOORS.map((_, i) => !!makeFloor(i))\", \"  validate: () => STAGES.map((s, i) => s.kind === 'floor' || s.kind === 'treasure' ? !!makeFloor(i) : true)\"),\n])\nEOF\ngrep -n \"ATTRACT_STAGES\" *.js | head -3","description":"Move the card, HUD, attract and debug handle onto the stage model"}},"wire_ingest_context":{"toolu_01NbmDY138MmLYgPAir5nrAL":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050253__x8ffc89/work/Gauntletdown-Gauntlet-claude-haiku-5-5-medium-20261104-050253/game/src"}}}
