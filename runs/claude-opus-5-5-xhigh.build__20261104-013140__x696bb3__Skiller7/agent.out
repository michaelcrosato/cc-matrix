* S7 PATCH: the weapons _s7Weapon draws */","+const S7_WEAPONS = { revolver: 1, pistol: 1, rifle: 1, shotgun: 1, poles: 1, alphorn: 1, launcher: 1 };"," class Humanoid {","   /** new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a","    *  character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each"]},{"oldStart":3957,"oldLines":7,"newStart":3973,"newLines":7,"lines":["     if (typeof this.o.hair === 'string' || !this.o.hair) this.o.hair = { style: this.o.hair || 'short' };","     /** hairPts: the long hair's simulated points (null until it has some) */","     this._hairPts = null;","-    if (this.o.weapon && !['sword', 'gun', 'staff'].includes(this.o.weapon)) { warn('weapon:' + this.o.weapon, 'Humanoid weapon \"' + this.o.weapon + '\" is not built in (sword, gun, staff or null); drawing a sword'); this.o.weapon = 'sword'; }","+    if (this.o.weapon && !['sword', 'gun', 'staff', 'revolver', 'pistol', 'rifle', 'shotgun', 'poles', 'alphorn', 'launcher'].includes(this.o.weapon))   /* S7 PATCH: Skiller7's weapons */ { warn('weapon:' + this.o.weapon, 'Humanoid weapon \"' + this.o.weapon + '\" is not built in (sword, gun, staff or null); drawing a sword'); this.o.weapon = 'sword'; }","     if (typeof this.o.hat === 'string') this.o.hat = { style: this.o.hat };","     /** C: its colors (skin, hair, cloth, pants, boot, belt, cape, capeIn, metal, hilt, eye, ...), the defaults with","      *  o.colors over them; change one and it shows at the next draw */"]},{"oldStart":4008,"oldLines":7,"newStart":4024,"newLines":7,"lines":["   /** world position of a hand ('R' holds the weapon): spawn bullets, sparks or thrown things here */","   hand(which = 'R') { const w = this._w(this.J['hand' + which] || this.J.handR); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }","   /** world position of the weapon tip (sword tip, gun muzzle, staff orb) */","-  tip() { const J = this.J, L = this.o.weapon === 'gun' ? 5 : this.o.weapon === 'staff' ? 10 : this.o.bladeLen, w = this._w(V3.add(J.handR, V3.mul(J.bladeDir, L))); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }","+  tip() { const J = this.J, L = ['gun', 'revolver', 'pistol', 'poles'].includes(this.o.weapon) ? 5 : ['rifle', 'shotgun', 'launcher', 'alphorn'].includes(this.o.weapon) ? 11 : this.o.weapon === 'gun' ? 5 : this.o.weapon === 'staff' ? 10 : this.o.bladeLen, w = this._w(V3.add(J.handR, V3.mul(J.bladeDir, L))); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }","   /** where a point in the rig's own frame ([forward, right, up]; a joint such as rig.J.head, or one offset from it)","    *  sits, in world units from the rig's feet: add rig.x, y, z for the world point, or project it to draw at a joint */","   worldOffset(p) { return this._w(p); }"]},{"oldStart":4390,"oldLines":6,"newStart":4406,"newLines":7,"lines":["       limb(ank, foot, 1.15 * u * lw, 1.05 * u * lw, C.boot, far, .002);","       limb(foot, toe, 1.0 * u * lw, .85 * u * lw, C.boot, far, .003);","     }","+    if (o.skis && this.state && this.state.skis) this._s7Skis(ops, g, Sp, J, u);   /* S7 PATCH: skis under the boots */","     // ---- outfit below the belt: tunic / robe / coat ----","     const out = o.outfit, hz = Math.max(J.hipL[2], J.hipR[2]) + .9;","     if (out === 'tunic' || out === 'robe' || out === 'coat') {"]},{"oldStart":4501,"oldLines":9,"newStart":4518,"newLines":11,"lines":["       if (o.hat) this._hat(g, Sp, J, r, H);","       // face: eyes (with a catch-light when big enough), brows and a mouth, on the side facing the camera","       const big = o.face && o.face.eyes === 'big', eh = Math.max(1, Math.round(u * (big ? 1.4 : 1.05))), ew = u > 2.6 || (big && u > 1.8) ? 2 : 1;","-      for (const sd of [-1, 1]) {","+      const s7Visor = o.hat && o.hat.style === 'racehelmet';   /* S7 PATCH: a full visor hides the face */","+      if (!s7Visor) for (const sd of [-1, 1]) {","         const E2 = Sp(