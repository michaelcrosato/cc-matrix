ght: 'press' },\n  /** the ballroom while the band plays: from the dance floor, the hero in the foreground, the stage beyond */\n  camera(sim, h) { if (!sim.boss || sim.boss.id !== 'band' || sim.aim.on || sim.camOverride) return null; return sim.cam._aim([h.x + 1.4 * M, h.y + 5 * M, h.z + 2.4 * M], [46.5 * M, 26.6 * M, 1.6 * M], 58); }\n});\"\"\"\nassert old in s; s=s.replace(old,new)\nopen(p,'w').write(s)\np='src/88-echorun.js'; s=open(p).read()\ns=s.replace(\"        UI.text(g, S7.fmtTime(E1.time()), r.W / 2, S.y0, '#ffffff', { align: 'center', scale: 3 });\\n        UI.text(g, E1.metres() + ' M DOWN · +' + E1.pen + ' S · CRITS ' + E1.crits, r.W / 2, S.y0 + 26, MUTED, { align: 'center' });\",\n            \"        UI.text(g, S7.fmtTime(E1.time()), r.W / 2, S.y0 + 38, '#ffffff', { align: 'center', scale: 3 });\\n        UI.text(g, E1.metres() + ' M DOWN · +' + E1.pen + ' S · CRITS ' + E1.crits, r.W / 2, S.y0 + 62, MUTED, { align: 'center' });\")\ns=s.replace(\"      S7.ghosts = [];\\n      audio && audio.music('echorun');\",\"      S7.ghosts = []; hud.areaT = 9; hud._area = '01C';\\n      audio && audio.music('echorun');\")\nopen(p,'w').write(s)\np='src/95-scenes.js'; s=open(p).read()\ns=s.replace(\"  toastMsg(text) { this.msgs.push({ text, t: 0 }); },\",\"  toastMsg(text) { this.msgs.push({ text, at: typeof performance !== 'undefined' ? performance.now() : 0, t: 0 }); },\")\ns=s.replace(\"for (const m of this.msgs) { m.t += 1 / 60;\",\"for (const m of this.msgs) { m.t = typeof performance !== 'undefined' ? (performance.now() - m.at) / 1000 : m.t + 1 / 60;\")\nopen(p,'w').write(s)\nEOF\nnode tools/build.mjs >/dev/null && node tmp/look5.mjs 2>&1 | tail -3; cd tests/out/look && sheet() { out=$1; shift; ffmpeg -loglevel error -y $(for f in \"$@\"; do echo -i $f; done) -filter_complex \"$(i=0; for f in \"$@\"; do echo -n \"[$i:v]scale=640:360[v$i];\"; i=$((i+1)); done; for j in $(seq 0 $(($#-1))); do echo -n \"[v$j]\"; done; echo -n \"xstack=inputs=$#:layout=0_0|w0_0|