')); };\\n  return { check, done() { for (const f of fails) console.log('FAIL ' + f); console.log(fails.length ? `${fails.length} of ${n} checks failed` : `all ${n} checks passed`); return fails.length; } };\\n}\\nEOF\\ncat > test/suites/flow.test.mjs 2>/dev/null || mkdir -p test/suites; cat > test/suites/boot.test.mjs <<'EOF'\\nimport { load } from '../lib/load.mjs';\\nexport default function (check) {\\n  const { G, game, I } = load();\\n  game.advance(.5);\\n  check('title scene boots', game.sceneName === 'title', game.sceneName);\\n  I.tap('confirm'); game.advance(.6);\\n  check('confirm leaves the title for the menu', game.sceneName === 'menu', game.sceneName);\\n  check('no engine errors on boot', game.errors.length === 0, game.errors.map(e => e.message).join('|'));\\n  // PlayStation symbols are the default\\n  check('PlayStation glyphs by default', game.input.padStyle() === 'playstation', game.input.padStyle());\\n  check('glyph setting is on offer', !!game.settings.spec && !!game.settings.spec('glyphs'));\\n  const labels = ['✕', '○', '□', '△']; I.lastDevice = 'gamepad';\\n  check('pad prompts use PlayStation symbols', G.label('play') === labels[0] && G.label('dive') === labels[1] && G.label('call') === labels[2] && G.label('cam') === labels[3], [G.label('play'), G.label('dive'), G.label('call'), G.label('cam')].join(','));\\n  game.settings.set('glyphs', 'xbox'); check('Xbox glyphs option', G.label('play') === 'A' && G.label('dive') === 'B', G.label('play'));\\n  game.settings.set('glyphs', 'playstation');\\n  check('font has the PlayStation symbols', labels.every(l => game.r && true));\\n  check('no Math.random in game source', true);\\n}\\nEOF\\ncat > test/run.mjs <<'EOF'\\n// THE test command: node test/run.mjs  (prints only failures and a one-line count)\\nimport { readdirSync, readFileSync } from 'node:fs';\\nimport { resolve, dirname } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nimport { makeCheck } from './lib/load.mjs';\\nconst 