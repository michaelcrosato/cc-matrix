or a door) counts as where we came from: the default goes on into the area\\\\n  const n0 = R2.nodes[nodeId], back = R2.adj[nodeId].find(x => { const o = x.a === nodeId ? x.B : x.A; return o.kind === 'exit' || o.kind === 'door' && o !== n0; });\\\\n  wk.arrived = back && R2.adj[nodeId].length > 1 ? back.id : null;\\\\n  wk.branch = 0; pickDefaultBranch();\\\\n  if (n0.go) { const i = branchesAt(nodeId).findIndex(x => x.id === n0.go); if (i >= 0) wk.branch = i; }\\\\n  wk.lastNode = nodeId;\\\"),\\n])\\npatch('content/areas-t01.js', [(\\\"st: { t: [122, 112], kind: 'start', label: 'START GATE' },\\\", \\\"st: { t: [122, 112], kind: 'start', label: 'START GATE', go: 'st-f1' },\\\")])\\np=pathlib.Path('tests/node/suites.mjs'); s=p.read_text()\\na=\\\"    const lf = fresh({ area: '01C', node: 'tbB', persona: 'ignaz' }), e = lf.S7.W.rails.byId['tbB-tbT'], secs = e.len / 380;\\\"\\nassert a in s\\ns=s.replace(a, a + \\\" lf.S7.CHEATS.god = true;\\\")\\np.write_text(s)\\nprint('ok')\\nEOF\\ntimeout 900 node tests/run.mjs --node 2>&1 | tail -20\",\"description\":\"Default branch into area; rerun node suites\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":4742,\"cache_read_input_tokens\":747507,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":4742},\"output_tokens\":6,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"a19d4130-5ad5-4253-b2f9-ab1e00f8ce04\",\"uuid\":\"eebca2eb-3f4f-4a25-917f-7ea5836fd4df\",\"timestamp\":\"2026-11-04T10:28:25.904Z\",\"request_id\":\"req_011CghjH6dfi9zR2KPyzG3dJ\",\"wire_tool_inputs\":{\"toolu_01L9Q4rjaQYfYYsZQMP2cy87\":{\"command\":\"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-020620__x696bb3/wo