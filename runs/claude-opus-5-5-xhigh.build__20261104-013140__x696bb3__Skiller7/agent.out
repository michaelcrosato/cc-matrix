 } catch (e) { /* gone */ } R.bossActors.delete(k); }","+    // echoes: the other skiers (Echo Run), translucent, with a scarf in their colour","+    R.ghostActors = R.ghostActors || new Map();","+    const gseen = new Set();","+    for (const gh of S7.ghosts || []) {","+      gseen.add(gh.id);","+      let X = R.ghostActors.get(gh.id);","+      if (!X) { const rig = new E.Humanoid(Object.assign({}, S7.PERSONAS.dagny.rig, { colors: Object.assign({}, S7.PERSONAS.dagny.rig.colors, { cloth: gh.color, pants: gh.color }) })); const a = w.mob({ x: gh.x, y: gh.y, z: gh.z, rig, pose: false, fly: true }); a.setSolid(false); X = { a, rig, px: gh.x, py: gh.y }; R.ghostActors.set(gh.id, X); }","+      X.a.place(gh.x, gh.y, gh.z); X.a.facing = gh.yaw; X.a.fade = .45; X.a.visible = true;","+      X.rig.state = X.rig.state || {}; X.rig.state.skis = true;","+      X.rig.update(dt, { x: gh.x, y: gh.y, z: gh.z, vx: 0, vy: 0, facing: gh.yaw, pose: 'crouch', point: !!gh.aim, lean: .3 });","+    }","+    for (const [k, X] of R.ghostActors) if (!gseen.has(k)) { try { w.remove(X.a); } catch (e) { /* gone */ } R.ghostActors.delete(k); }","     if (S7.stepExtra) S7.stepExtra(R, this, dt);","     // effects","     for (const f of this.fx) f.t += dt;"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-013140__x696bb3/work/Skiller7-Killer7-claude-opus-5-5-xhigh-20261104-013140/src/20-sim.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-013140__x696bb3/work/Skiller7-Killer7-claude-opus-5-5-xhigh-20261104-013140/src/40-meta.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-013140__x696bb3/work/Skiller7-Killer7-claude-opus-5-5-xhigh-20261104-013140/src/85-bot.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-013140__x696bb3/work/Skiller7-Killer7-claude-opus-5-5-xhigh-20261104-013140/src/86-attract.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-0