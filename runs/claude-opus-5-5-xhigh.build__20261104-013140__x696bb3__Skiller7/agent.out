ce(old,new)\nopen(p,'w').write(s)\np='src/88-echorun.js'; s=open(p).read()\ns=s.replace(\"  echoSetup() {\\n    this.st = this.freshState('piste');\",\"  echoSetup() {\\n    this.resetTransient();\\n    this.st = this.freshState('piste');\")\nopen(p,'w').write(s)\np='src/95-scenes.js'; s=open(p).read()\ns=s.replace(\"Sim.prototype.titleBackdrop = function () {\\n  this.st = this.freshState('piste'); this.o.noClock = true;\\n  this.beats = []; this.talk = null; this.card = null; this.cutscene = false; this.letterbox = 0; this.prompt = null; this.mode = 'rail';\",\"Sim.prototype.titleBackdrop = function () {\\n  this.resetTransient();\\n  this.st = this.freshState('piste'); this.o.noClock = true;\")\n# rank badges: drawn shapes instead of glyphs\nold=\"\"\"        UI.title(g, res.rank.icon, r.W / 2, S.y0 + 22, Math.round(2 + 3 * k), { colors: res.rank.id === 'blue' ? ['#6aa0ff', '#2a6ad8', '#1a4aa8'] : res.rank.id === 'green' ? ['#6ae08a', '#2aa04a', '#1a7030'] : ['#3a3a40', '#101014', '#000000'], outline: '#f4f1ea' });\"\"\"\nnew=\"\"\"        S7.drawRank(g, res.rank.id, r.W / 2, S.y0 + 44, 10 + 12 * k);\"\"\"\nassert old in s; s=s.replace(old,new)\ns=s.replace(\"/** the title's backdrop:\",\"/** a rank badge: one or two black diamonds, a blue square, a green circle (white-edged, readable on any ground) */\\nS7.drawRank = (g, id, x, y, r) => {\\n  const dia = (cx, c) => { UI.diamond(g, cx, y, r + 2, '#f4f1ea', true); UI.diamond(g, cx, y, r, c, true); };\\n  if (id === 'dblack') { dia(x - r * .9, '#101014'); dia(x + r * .9, '#101014'); }\\n  else if (id === 'black') dia(x, '#101014');\\n  else if (id === 'blue') { UI.rect(g, x - r - 2, y - r - 2, 2 * r + 4, 2 * r + 4, '#f4f1ea'); UI.rect(g, x - r, y - r, 2 * r, 2 * r, '#2a6ad8'); }\\n  else { E.px.disc(g, x, y, r + 2, '#f4f1ea'); E.px.disc(g, x, y, r, '#2aa04a'); }\\n};\\n/** the title's backdrop:\")\nopen(p,'w').write(s)\np='src/33-bosses.js'; s=open(p).read()\nold=\"      B.h = { x: n.x + 1.1 * M, y: n.y, z: n.z };\