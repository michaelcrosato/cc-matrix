ncilled 7', tags: 'room7', mats: { w: 'whitepaint', g: '#c8d8e8 glaze', s: '#d81e2a none' }, lights: [[0, 6, 26, '#ffd8a0', 26]],","       parts: [['box', 'w', [0, 0, 0], [22, 2, 40]], ['box', 'g', [0, 1.2, 20], [12, 1, 14]], ['box', 's', [1, 1.8, 30], [6, .5, 1.5]], ['box', 's', [3, 1.8, 24], [1.5, .5, 12], { rot: [0, 25, 0] }]] },","     'room-service-cart': { about: 'a room-service cart with a cloche', tags: 'hotel', mats: { c: 'linen', s: 'steel' }, parts: [['box', 'c', [0, 0, 12], [22, 14, 2]], ['mirror', 'xy', ['box', 's', [10, 6, 0], [1.5, 1.5, 12]]], ['ball', 's', [0, 0, 14], 6, { sz: .7 }]] },","-    'sconce': { about: 'a wall sconce', tags: 'hotel', mats: { b: 'brass', g: { color: '#ffe8b0', glow: 1 } }, parts: [['box', 'b', [0, 0, 0], [2, 4, 8]], ['cyl', 'g', [2, 0, 6], 2, 4, { r2: 3 }]] },","+    'sconce': { about: 'a wall sconce', tags: 'hotel', mats: { b: 'brass', g: 'glowwarm' }, parts: [['box', 'b', [0, 0, 0], [2, 4, 8]], ['cyl', 'g', [2, 0, 6], 2, 4, { r2: 3 }]] },","     'service-bell-big': { about: 'a giant service bell on a bracket', tags: 'hotel', mats: { b: 'gilt', i: 'iron' }, parts: [['box', 'i', [0, 0, 40], [30, 3, 3]], ['lathe', 'b', [0, 0, 6], [[0, 0], [14, 0], [13, 4], [10, 14], [6, 22], [0, 26]]], ['cyl', 'i', [0, 0, 32], 1.5, 8]] },","     /* ---- the village ---- */","     'chalet-roof': { about: 'a pitched roof heavy with snow', tags: 'village', mats: { s: 'roofsnow', w: 'shingle', t: 'darkwood' }, params: { w: 64, d: 64 },"]},{"oldStart":55,"oldLines":14,"newStart":55,"newLines":14,"lines":["     'lift-hut': { about: 'a lift station hut', tags: 'village', mats: { w: 'chalet', s: 'roofsnow', m: 'steelp' }, parts: [['box', 'w', [0, 0, 0], [60, 40, 40]], ['box', 's', [0, 0, 40], [66, 46, 6]], ['cyl', 'm', [0, -26, 0], 3, 70], ['box', 'm', [0, -26, 70], [40, 4, 4]]] },","     'turnstile': { about: 'a steel turnstile', tags: 'village', mats: { m: 'steelp', y: '#f0c020 none' }, parts: [['box', 'm', [0, 0, 0], [6, 14, 18]], ['ring', 3, 6, ['box', 'y', [0, 0, 14], [12, 1.5, 1.5]]]] },","     'piste-pole': { about: 'an orange piste pole', tags: 'mountain', mats: { o: 'orange', b: 'blackp' }, parts: [['cyl', 'o', [0, 0, 0], 1.2, 30], ['cyl', 'b', [0, 0, 22], 1.3, 4]] },","-    'floodlight': { about: 'a floodlight mast', tags: 'mountain', mats: { m: 'steelp', l: { color: '#fff8e0', glow: 1 } }, lights: [[0, 6, 110, '#fff4d0', 300]], parts: [['cyl', 'm', [0, 0, 0], 3, 110], ['box', 'm', [0, 4, 110], [24, 4, 12]], ['row', 3, [7, 0, 0], ['box', 'l', [0, 6.5, 112], [5, 1, 6]]]] },","+    'floodlight': { about: 'a floodlight mast', tags: 'mountain', mats: { m: 'steelp', l: 'glowwhite' }, lights: [[0, 6, 110, '#fff4d0', 300]], parts: [['cyl', 'm', [0, 0, 0], 3, 110], ['box', 'm', [0, 4, 110], [24, 4, 12]], ['row', 3, [7, 0, 0], ['box', 'l', [0, 6.5, 112], [5, 1, 6]]]] },","     'snow-cannon': { about: 'a snow cannon on a tripod', tags: 'mountain', mats: { m: 'steelp', y: '#f0c020 metal' }, parts: [['ring', 3, 6, ['box', 'm', [0, 0, 0], [2, 2, 20], { rot: [0, 15, 0] }]], ['cyl', 'y', [0, 0, 20], 9, 16, { r2: 6 }]] },","     'net': { about: 'an orange safety net', tags: 'mountain', mats: { o: 'orange', m: 'steelp' }, parts: [['mirror', 'x', ['cyl', 'm', [24, 0, 0], 1, 24]], ['box', 'o', [0, 0, 4], [48, 1, 16]]] },","     'shelter-hut': { about: 'an avalanche shelter hut, half buried', tags: 'mountain', mats: { w: 'chalet', s: 'roofsnow', r: 'cabin' }, parts: [['box', 'w', [0, 0, 0], [70, 50, 36]], ['prism', 's', [0, 0, 36], [[-40, 0], [40, 0], [0, 26]], 56, { axis: 'y' }], ['box', 'r', [0, 25.5, 4], [16, 1, 26]], ['rock', 'snowm', [-30, -20, 0], 24, { sz: .6 }]] },","     'pylon': { about: 'a cable-car pylon of steel lattice', tags: 'mountain', mats: { m: 'steelp', i: '#c8f0ff glaze' }, parts: [['mirror', 'xy', ['box', 'm', [10, 10, 0], [3, 3, 240], { rot: [0, -2, 0] }]], ['row', 6, [0, 0, 40], ['box', 'm', [0, 0, 20], [24, 24, 2]]], ['box', 'm', [0, 0, 240], [60, 12, 8]]] },","     'cornice': { about: 'a heavy snow overhang on a ridge', tags: 'mountain', mats: { s: 'snowm', r: 'rock' }, parts: [['rock', 'r', [0, 0, 0], 40, { sz: .7, seed: 3 }], ['ball', 's', [10, 18, 30], 34, { sz: .55 }], ['ball', 's', [-16, 22, 28], 24, { sz: .5 }]] },","     'serac': { about: 'a tower of blue ice', tags: 'archive', mats: { i: 'glacier' }, parts: [['box', 'i', [0, 0, 0], [26, 20, 70], { rot: 8 }], ['box', 'i', [14, 6, 0], [16, 16, 52], { rot: -10 }], ['cone', 'i', [-6, 0, 70], 12, 18]] },","-    'crystal-cluster': { about: 'a cluster of humming ice crystals', tags: 'archive', mats: { c: { color: '#8ae8ff', pattern: 'glaze', glow: .4 } }, parts: [['cone', 'c', [0, 0, 0], 8, 46], ['cone', 'c', [10, 4, 0], 6, 34, { rot: [0, 18, 0] }], ['cone', 'c', [-9, -3, 0], 6, 30, { rot: [0, -20, 0] }], ['cone', 'c', [3, -9, 0], 5, 24, { rot: [18, 0, 0] }]] },","+    'crystal-cluster': { about: 'a cluster of humming ice crystals', tags: 'archive', mats: { c: 'crystalc' }, parts: [['cone', 'c', [0, 0, 0], 8, 46], ['cone', 'c', [10, 4, 0], 6, 34, { rot: [0, 18, 0] }], ['cone', 'c', [-9, -3, 0], 6, 30, { rot: [0, -20, 0] }], ['cone', 'c', [3, -9, 0], 5, 24, { rot: [18, 0, 0] }]] },","     'deposit-box': { about: 'a numbered deposit box door in the ice', tags: 'archive', mats: { m: 'steelp', i: 'ice2', b: 'brass' }, parts: [['box', 'i', [0, 0, 0], [30, 4, 40]], ['box', 'm', [0, 2, 6], [22, 2, 26]], ['cyl', 'b', [0, 3.5, 19], 4, 1, { seg: 10 }]] },","     'lectern': { about: 'a lectern with a frozen ledger', tags: 'archive', mats: { w: 'darkwood', i: 'ice2', p: 'ivory' }, parts: [['box', 'w', [0, 0, 0], [12, 10, 20]], ['box', 'w', [0, 0, 20], [16, 12, 2], { rot: [14, 0, 0] }], ['box', 'p', [0, 0, 23], [14, 10, 2], { rot: [14, 0, 0] }], ['box', 'i', [0, 0, 24], [16, 12, 4], { rot: [14, 0, 0] }]] },","     'pavilion': { about: 'a glass signing pavilion', tags: 'summit', mats: { g: 'glass', m: 'steelp', f: 'feather' }, parts: [['cyl', 'm', [0, 0, 0], 70, 4, { seg: 8 }], ['ring', 8, 64, ['box', 'm', [0, 0, 4], [3, 3, 60]]], ['ring', 8, 62, ['box', 'g', [0, 0, 4], [46, 1, 56]]], ['cyl', 'g', [0, 0, 64], 72, 4, { seg: 8, r2: 20 }]] },"]},{"oldStart":70,"oldLines":7,"newStart":70,"newLines":7,"lines":["     'slalom-gate': { about: 'a slalom gate of two flags', tags: 'summit', mats: { r: '#d81e2a cloth', b: '#2a5ac8 cloth', m: 'steelp' }, parts: [['mirror', 'x', ['cyl', 'm', [24, 0, 0], 1, 30]], ['box', 'r', [-18, 0, 20], [10, 1, 8]], ['box', 'b', [18, 0, 20], [10, 1, 8]]] },","     'chair-station': { about: 'an old chairlift station', tags: 'summit', mats: { w: 'chalet', m: 'steelp', s: 'roofsnow' }, parts: [['box', 'w', [0, 0, 0], [70, 40, 30]], ['box', 's', [0, 0, 30], [76, 46, 6]], ['cyl', 'm', [0, 30, 0], 26, 4, { seg: 12 }], ['cyl', 'm', [0, 30, 4], 3, 60]] },","     'conference-table': { about: 'a long conference table with chairs', tags: 'palais', mats: { w: 'darkwood', c: 'leather' }, parts: [['box', 'w', [0, 0, 12], [80, 24, 3]], ['mirror', 'xy', ['box', 'w', [36, 9, 0], [3, 3, 12]]], ['row', 5, [16, 0, 0], ['box', 'c', [0, 18, 0], [10, 8, 16]]], ['row', 5, [16, 0, 0], ['box', 'c', [0, -18, 0], [10, 8, 16]]]] },","-    'security-arch': { about: 'a metal-detector arch', tags: 'palais', mats: { m: 'steelp', r: { color: '#d81e2a', glow: 1 } }, parts: [['mirror', 'x', ['box', 'm', [14, 0, 0], [4, 8, 40]]], ['box', 'm', [0, 0, 40], [32, 8, 4]], ['box', 'r', [0, 4.5, 41], [4, 1, 2]]] },","+    'security-arch': { about: 'a metal-detector arch', tags: 'palais', mats: { m: 'steelp', r: 'glowred' }, parts: [['mirror', 'x', ['box', 'm', [14, 0, 0], [4, 8, 40]]], ['box', 'm', [0, 0, 40], [32, 8, 4]], ['box', 'r', [0, 4.5, 41], [4, 1, 2]]] },","     'mirror-panel': { about: 'an ornate gilt mirror panel', tags: 'palais', mats: { f: 'gilt', m: '#c8e0f0 glaze' }, parts: [['box', 'f', [0, 0, 0], [40, 4, 60]], ['box', 'm', [0, 2.5, 5], [32, 1, 48]], ['ball', 'f', [0, 2, 60], 6, { sz: .6 }]] },","     'pinboard': { about: 'a press pinboard of clippings', tags: 'palais', mats: { c: '#8a