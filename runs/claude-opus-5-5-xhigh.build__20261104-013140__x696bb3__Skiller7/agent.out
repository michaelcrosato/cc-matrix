utModal || m instanceof DifficultyModal ? 0 : 0));\",\"\")\nopen(p,'w').write(s)\n# Dev Mode: Backspace resets the focused value; only Escape / ○ close it\np='src/84-dev.js'; s=open(p).read()\nold=\"    if (nv.back) { if (this.page === 2 && this.warp.area) { this.warp.area = null; this.i = 0; return null; } S7.sfx('back'); return 'close'; }\"\nnew=\"    if (nv.back && !I.pressed('reset1')) { if (this.page === 2 && this.warp.area) { this.warp.area = null; this.i = 0; return null; } S7.sfx('back'); return 'close'; }\"\nassert old in s; s=s.replace(old,new)\nopen(p,'w').write(s)\nEOF\ngrep -n \"S7.Input.reset()\" src/*.js | head; node tools/build.mjs >/dev/null && cat > tmp/click.mjs <<'EOF'\nimport { launch, open, fileURL } from '../tests/lib/browser.mjs';\nconst b = await launch();\nconst { page, errors } = await open(b, fileURL('../Skiller7-Killer7-claude-opus-5-5-xhigh-20261104-013140.html') + '?backend=webgl');\nawait page.waitForFunction(() => window.S7 && S7.started && S7.pres && S7.sceneName(S7.game) === 'title', null, { timeout: 40000 });\nawait page.evaluate(() => { S7.newGame('piste'); }); await page.waitForTimeout(500);\nawait page.evaluate(() => { const s = S7.sim; s.skipCutscene(); s.warp('00A', 'j1'); for (const k of Object.keys(S7.TUTORIALS)) s.st.tut[k] = 2; s.tutorial = null; window.__clicks = []; const I = S7.game.input, f = I.clicked.bind(I); I.clicked = () => { const c = f(); if (c) window.__clicks.push(c); return c; }; });\nawait page.waitForTimeout(1500);\nconst mk = await page.evaluate(() => { const m = S7.hud.markers.filter(x => x.kind === 'branch'); const J = S7.sim.junction; const c = S7.game.screen.canvas.getBoundingClientRect(); const k = m.find(x => x.i !== J.i) || m[0]; return k ? { i: k.i, x: c.left + k.x * c.width / S7.game.W, y: c.top + k.y * c.height / S7.game.H, mx: k.x, my: k.y, was: J.i, W: S7.game.W, cw: c.width } : null; });\nconsole.log(JSON.stringify(mk));\nawait page.mouse.move(mk.x, mk.y); await page.waitForTimeout(400);\nawa