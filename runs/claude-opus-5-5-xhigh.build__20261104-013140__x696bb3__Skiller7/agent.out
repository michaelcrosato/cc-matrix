waitForTimeout(1800); await shot('lawine'); await page.keyboard.up('KeyW');\n// the gondola\nawait page.evaluate(() => { const s = S7.sim; s.st.persona = 'ignaz'; s.st.flags.powerBack = 0; s.warp('01D', 'gs'); S7.hud.areaT = 9; });\nawait page.waitForTimeout(4000); await shot('gondola');\nawait page.evaluate(() => { const s = S7.sim; s.warp('01D', 'mid'); s.gondola = s.gondola || {}; s.gondola.swing = 1; S7.hud.areaT = 9; });\nawait page.waitForTimeout(2000); await shot('powercut');\n// results\nawait page.evaluate(() => { const s = S7.sim; S7.CHEAT.god = false; s.warp('00C', 's1'); s.boss = null; s.st.results[0].kills = 30; s.st.results[0].crits = 21; s.st.results[0].time = 600; s.finishTarget(0); });\nawait page.waitForTimeout(2500); await shot('results');\n// echo run\nawait page.evaluate(() => { S7.game.go('echorun', {}); });\nawait page.waitForTimeout(5000); await page.keyboard.down('KeyW'); await page.waitForTimeout(2500); await shot('echorun'); await page.keyboard.up('KeyW');\nconsole.log(errors.slice(0, 6).join('\\n'));\nawait b.close();\nEOF\nnode tmp/look5.mjs 2>&1 | tail -6; cd tests/out/look && sheet() { out=$1; shift; ffmpeg -loglevel error -y $(for f in \"$@\"; do echo -i $f; done) -filter_complex \"$(i=0; for f in \"$@\"; do echo -n \"[$i:v]scale=640:360[v$i];\"; i=$((i+1)); done; for j in $(seq 0 $(($#-1))); do echo -n \"[v$j]\"; done; echo -n \"xstack=inputs=$#:layout=0_0|w0_0|0_h0|w0_h0[o]\")\" -map \"[o]\" $out; }; sheet s11.png p-grau.png p-band.png p-avalaugh.png p-slalom.png && sheet s12.png p-interview.png p-lawine.png p-gondola.png p-powercut.png && sheet s13.png p-results.png p-echorun.png p-grau.png p-band.png","description":"Screenshot the set pieces and screens","timeout":300000}},"wire_ingest_context":{"toolu_01FQyzn2b7Sm12RSPfcxr6fP":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-013140__x696bb3/work/Skiller7-Killer7-claude-opus-5-5-xhigh-20261104-013140"}}}
