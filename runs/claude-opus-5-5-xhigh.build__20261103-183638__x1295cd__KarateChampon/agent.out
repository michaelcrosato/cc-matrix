g === w._psig) return null; const first = w._psig === undefined; w._psig = sig; return first ? null : p; };\")\nopen(p,'w').write(s)\np='src/54-versus.js'; s=open(p).read()\ns=s.replace(\"if (input.pad === null || input.keys === 'right') this._splitKeys();\",\"if (input.half === 'right') this._splitKeys();\")\ns=s.replace(\"_splitKeys() { const P = KC.game.players, kb = P.filter(I => I.keys === 'right');\",\"_splitKeys() { const P = KC.game.players, kb = P.filter(I => I.half === 'right');\")\ns=s.replace(\"(I.keys === 'right' ? 'KEYS (RIGHT)'\",\"(I.half === 'right' ? 'KEYS (RIGHT)'\")\ns=s.replace(\"const p = I0.pointer(), c = I0.clicked(); if (this.cells) for (const [i, x, y, w, h] of this.cells) { if (p && I0.mouse.t !== this._mt && p[0] >= x\",\"const p = KC.moved(I0, this), c = I0.clicked(); if (this.cells) for (const [i, x, y, w, h] of this.cells) { if (p && p[0] >= x\")\ns=s.replace(\"    this._mt = I0.mouse.t;\\n\",\"\")\nopen(p,'w').write(s)\np='tests/versus.test.mjs'; s=open(p).read()\ns=s.replace(\"game.players.length === 2 && game.players[1].keys === 'right'\",\"game.players.length === 2 && game.players[1].half === 'right'\")\nopen(p,'w').write(s)\np='src/51-front.js'; s=open(p).read()\na=\"D.ex++; if (D.kind === 'hantei') b.clock = Math.min(b.clock, 6); }\"\nb=\"D.ex++; if (D.kind === 'hantei') { b.clock = Math.min(b.clock, 6); const m = Math.max(...b.points); b.points = [m, m]; } }\"\nassert s.count(a)==1; s=s.replace(a,b); open(p,'w').write(s)\nEOF\ngrep -n \"keys === 'right'\" src/*.js; node tests/run.mjs --only versus,attract,ui 2>&1 | tail -8","description":"Pointer-moved hover helper, half-keyboard fix, tied hantei","timeout":600000}}}
