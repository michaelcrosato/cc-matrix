 B], seed: 1, rules: { pointsToWin: 99, clock: 99 } }), used = new Set();\n    const ai = [new KC.KarateAI({ fid: 'taro', seed: 1, showcase: true }), new KC.KarateAI({ fid: 'mei', seed: 2, showcase: true })];\n    b.bus.on('start', d => used.add(d.tech));\n    for (let n = 0; n < 120 * 200 && b.phase !== 'over'; n++) { A.control(ai[0].intent(A, B, 1 / 120)); B.control(ai[1].intent(B, A, 1 / 120)); b.update(1 / 120); if (KC.SCORING.every(id => used.has(id))) break; }\n    const miss = KC.SCORING.filter(id => !used.has(id)); t.check('the showcase throws all 15 techniques', miss.length === 0, miss.join(',')); }\n};\nEOF\ncat > tests/bonus.test.mjs <<'EOF'\n// bonus stages and drills: boards (power to boards, PERFECT, too much), pots (a fixed sequence; the right height breaks;\n// a boulder must be dodged; a bowl caught; PERFECT), the bull (each valid technique stops it; others trample); drills\nimport { fresh, steps } from './lib/util.mjs';\nexport default async t => {\n  // BOARDS\n  { const { KC, game } = fresh(); game.go('bonus', { id: 'boards', variant: { n: 5 } }); steps(game, 300); const sc = game.scene;\n    t.check('boards: play after the banner', sc.state === 'play', sc.state);\n    const I = game.input; I.hold('tDown'); let peak = 0; for (let i = 0; i < 400 && sc.ki < 99; i++) { steps(game, 1); peak = Math.max(peak, sc.ki); } steps(game, 30); t.check('boards: holding past 100 is TOO MUCH (back to 60)', sc.ki < 100 && sc.msg === KC.TEXT.tooMuch, sc.ki.toFixed(0) + ' ' + sc.msg);\n    for (let i = 0; i < 400 && sc.gauge() < 96; i++) steps(game, 1); I.hold('tDown', false); steps(game, 200);\n    t.check('boards: a full breath is PERFECT (all 5 and 2000)', sc.broken === 5 && sc.points === 5 * 200 + 2000, sc.broken + ' ' + sc.points + ' power ' + sc.power); }\n  { const { KC, game } = fresh(); game.go('bonus', { id: 'boards', variant: { n: 10, mat: 'ice' } }); steps(game, 300); const sc = game.scene, I = game.input; I.hold('tDown'); for (let i = 0; i < 400 && sc.g