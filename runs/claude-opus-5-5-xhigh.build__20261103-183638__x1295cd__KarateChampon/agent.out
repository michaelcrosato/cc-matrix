ns.push([k % 3, (k / 3) | 0, 1]); }   // 3x5 bit strings\n    out[ch] = { w, runs };\n  }\n  void h; return out;\n};\nconst FONTS = {\n  normal: { glyphs: parseFont(G57), h: 7, desc: 2, gap: 1, space: 3, upper: false },\n  tiny: { glyphs: parseFont(GLYPHS), h: 5, desc: 0, gap: 2, space: 3, upper: true, mono: 3 }\n};\n/**\n * Pixel fonts. 'normal' (default) is a 5x7 proportional font with lower case; 'tiny' is the 3x5 upper-case font.\n * text(g, str, x, y, color, opts) where opts is an outline color, false, or\n *   { font: 'normal' | 'tiny', outline: '#0b0814' | false, shadow: '#000' (1 px drop shadow), gradient: ['#fff', '#8ad'] (top to bottom),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KTJCnSgkn8ozYCz1M1Myns","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
