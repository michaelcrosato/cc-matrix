nput.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\n  q.use(_pPreset(this, q));\n  if (!this.settings.spec('playerBindings')) this.settings.define({ key: 'playerBindings', group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { for (const p of g.players.slice(1)) p.bindings = (v || {})[p.player] || {}; } });\n  q.bindings = (this.settings.playerBindings || {})[n] || {};\n  q._onBindings = b => this.settings.set('playerBindings', Object.assign({}, this.settings.playerBindings, { [n]: b }));\n  P.push(q); _pClaim(this);\n  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\n  this.note(q.name + ' JOINED', 1.5); this.audio.sfx('confirm');\n  return q;\n};\n/** a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it */\nGame.prototype.removePlayer = function (p) {\n  const P = this.players, i = typeof p === 'number' ? p - 1 : P.indexOf(p); if (i < 1 || i >= P.length) return;\n  P.splice(i, 1); P.forEach((q, k) => { q.player = k + 1; q.name = 'P' + (k + 1); q.color = E.PLAYER_COLORS[k]; });\n  const I = P[0]; if (I.half && !P.some(q => q !== I && q.half)) { I.half = null; I.use(I._full || I.preset); I._full = null; }\n  repeat(a, delay = .3, rate = .08) {\n    if (this.pressed(a)) return true;\n    if (!this.down(a) || this._pt[a] === undefined) return false;\n    const t = this.clock - this._pt[a]; if (t < delay) return false;\n    const k = Math.floor((t - delay) / rate); if (k !== this._rk[a]) { this._rk[a] = k; return true; }\n    return false;\n  }\n  /** was it pressed within the last `win` seconds and not yet consumed? (input buffering) */\n  buffered(a, win = .15) { if (!this.map[a]) this._check(a); const t = this._pt[a]; return !this._suppressed.has(a) && t !== undefined && !this._used[a] && this.clock - t <= win; }\n  reset(group) {\n    for (const k of this.keys(group)) { if (k === 'fullscreen') conti