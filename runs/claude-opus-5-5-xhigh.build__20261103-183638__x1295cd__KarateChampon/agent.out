nrise',\\\"\\\"\\\",\\\"\\\"\\\"  op6: {\\n    id: 'op6', n: 6, name: 'LAST FLIGHT OUT', card: 'THE CARGO PLANE IS ON THE STRIP. GET THEM ABOARD', time: 'sunrise', pre: 'takeoff',\\\"\\\"\\\"),\\n(\\\"\\\"\\\"  op1: {\\n    id: 'op1', n: 1, name: 'RADIO HILL', card: 'DESTROY THE ENEMY RADIO STATION', time: 'dawn',\\\"\\\"\\\",\\\"\\\"\\\"  op1: {\\n    id: 'op1', n: 1, name: 'RADIO HILL', card: 'DESTROY THE ENEMY RADIO STATION', time: 'dawn', pre: 'briefing',\\\"\\\"\\\"),\\n(\\\"\\\"\\\"      } else if (g.mode === 'crate') {\\\"\\\"\\\",\\\"\\\"\\\"      } else if (g.mode === 'drop') {\\n        // paratroopers come down from the cargo plane in a group, behind the fight\\n        const n = count(), sx = cam(d);\\n        const sp = [];\\n        for (let i = 0; i < n; i++) sp.push({ type: g.type, x: sx + pick(-120, 120), z: pick(g.z[0], g.z[1]), wave: true });\\n        add(d, { spawn: sp });\\n      } else if (g.mode === 'crate') {\\\"\\\"\\\"),\\n])\\n# scenes: cutscenes with a follow-on, briefing/takeoff cuts, awards, animalese\\nedit('src/40-scenes.js', [\\n(\\\"\\\"\\\"  kennel: ['THE KENNEL IS QUIET.\\\"\\\"\\\",\\\"\\\"\\\"  briefing: ['GENERAL KRAGG HAS SEIZED THE BRIMSTONE COAST. FIVE WORKERS ARE IN HIS HANDS.', 'NO ARMY WILL GO IN. THE PACK IS GOING IN. FOUR WOLVES, SIX OPERATIONS.', 'FIRST: THE RADIO HILL. KILL THE TRANSMITTER BEFORE HE TALKS TO HIS FRIENDS.'],\\n  takeoff: ['THE WORKERS ARE ALL ABOARD THE CARGO PLANE. THE GUNSHIP IS ON THE TAIL.', 'THE PILOT HAS ONE RUNWAY AND ONE CHANCE. SHOOT WHAT IS SHOOTABLE.', 'WHEELS UP IN THE STORM. HOLD ON.'],\\n  kennel: ['THE KENNEL IS QUIET.\\\"\\\"\\\"),\\n(\\\"\\\"\\\"const title = {\\n  enter() {\\\"\\\"\\\",\\\"\\\"\\\"const title = {\\n  enter() {\\\"\\\"\\\"),\\n(\\\"\\\"\\\"    if (pick === 0 && !touchOnly()) { newRun(); game.go('card', { op: 'op1' }); }\\\"\\\"\\\",\\\"\\\"\\\"    if (pick === 0 && !touchOnly()) { newRun(); game.go('cut', { id: 'briefing', next: 'card', nextData: { op: 'op1' } }); }\\