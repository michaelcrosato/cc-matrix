{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PXdWf6P3uBGQqETTkKt1yP","type":"tool_result","content":"// A smaller asset set from bigger ones: the entries a game adopts, with the whole chain of shapes they place (['use', id])\n// and every material those use, and the records of the downloads they came from, so the cut set draws on its own. It reads\n// and writes set files only (src/assets/sets/*.js); no source files are needed.\n// Usage: node tools/asset-set.mjs src/assets/sets/kenney-furniture.js [more sets ...] --ids table,chair,kenney-survival:barrel\n//          --name tavern --out src/assets/sets/tavern.js [--credit \"...\"]\n// An id found in more than one set is picked as set:id. A core id (E.SHAPES, E.MATERIALS) needs no copy and stays as it is.\nimport { resolve } from 'node:path';\nimport { engine, readSet, writeSet, tok, js } from './asset-lib.mjs';\n\nconst args = process.argv.slice(2), opt = n => { const i = args.indexOf('--' + n); return i >= 0 ? args[i + 1] : undefined; };\nconst files = args.filter((a, i) => !a.startsWith('--') && !(args[i - 1] || '').startsWith('--'));\nif (!files.length || !opt('ids') || !opt('name') || !opt('out')) { console.error('Usage: node tools/asset-set.mjs a.js [b.js ...] --ids a,set:b --name name --out out.js [--credit \"...\"]'); process.exit(2); }\nconst E = engine(), sets = files.map(f => readSet(resolve(f))), out = { set: opt('name'), credit: '', sources: {}, materials: {}, shapes: {}, sprites: {} }, from = new Map();\nconst fail = m => { console.error(m); process.exit(1); };\n/** the set an id is in: set:id, or the one set that has it */\nconst find = (want, kind) => {\n  const [sn, id] = want.includes(':') ? want.split(':') : [null, want], hits = sets.filter(S => (!sn || S.set === sn) && S[kind] && S[kind][id]);\n  if (hits.length > 1) fail(id + ' is in ' + hits.map(S => S.set).join(' and ') + ': pick one as set:' + id);\n  return hits[0] ? [hits[0], id] : [null, id];\n};\nconst take = (S, kind, id) => {\n  const k = kind + ':' + id; if (from.has(k)) { if (from.get(k) !== S.set) fail('a ' + kind.slice(0, -1) + ' ' + id + ' comes from both ' + from.get(k) + ' and ' + S.set + ': cut one of them'); return false; }\n  const e = S[kind][id]; from.set(k, S.set); out[kind][id] = e;\n  if (e && e.src) { if (!S.sources[e.src]) fail(S.set + ' ' + id + ': its download ' + e.src + ' is not on record'); out.sources[e.src] = S.sources[e.src]; }\n  return true;\nkenney-pirate:boat-row-large       shape     604 tok  white rowboat with orange seats and two oars  [vehicle boat pirate beach dock]\nkenney-pirate:tool-paddle          shape     103 tok  wooden boat paddle with a wide blade  [tool boat pirate beach]\nkenney-tiny-battle:tile-0103       sprite    168 tok  grey transport boat on blue water  [vehicle unit ship battle]\nkenney-tiny-battle:tile-0121       sprite    176 tok  green transport boat on blue water  [vehicle unit ship battle]\nkenney-tiny-battle:tile-0139       sprite    176 tok  blue transport boat on blue water  [vehicle unit ship battle]\nkenney-tiny-battle:tile-0157       sprite    175 tok  red transport boat on blue water  [vehicle unit ship battle]\nkenney-tiny-battle:tile-0175       sprite    176 tok  orange transport boat on blue water  [vehicle unit ship battle]\n7 of 7 matches; --show <id> prints an entry to copy\nkenney-fantasy-town:stall          shape     136 tok  plain wooden market table on four legs  [furniture market town]\nkenney-fantasy-town:stall-bench    shape     101 tok  long low wooden bench, solid plank ends  [furniture market town]\nkenney-fantasy-town:stall-red      shape     621 tok  market stall table under a red cloth canopy  [furniture market town]\nkenney-food:skewer-vegetables      shape     213 tok  wooden skewer of meat and vegetables  [food grill market stall]\nkenney-food:taco                   shape     126 tok  taco, tan shell, green lettuce  [food fastfood market stall]\nkenney-pirate:cannon               shape     180 tok  dark iron cannon on a red wooden block carriage  [weapon cannon pirate ship castle]\nkenney-pirate:cannon-ball          shape      69 tok  round black iron cannonball  [item weapon pirate ship]\nkenney-pirate:cannon-mobile        shape     480 tok  dark iron cannon on a red wheeled carriage  [weapon cannon pirate ship castle]\n3 of 3 matches; --show <id> prints an entry to copy\nkaykit-restaurant-bits:food-stew   shape     323 tok  white bowl of orange stew  [food meal restaurant tavern]\nkenney-food:bowl                   shape     106 tok  empty white ceramic bowl  [container dish kitchen tavern]\nkenney-food:bowl-soup              shape     207 tok  white bowl of cream soup, orange vegetable bits  [food bowl kitchen tavern]\nkenney-food:mortar                 shape      82 tok  squat grey mortar bowl, thick rim  [tool bowl kitchen alchemy]\nkenney-food:salad                  shape     235 tok  brown bowl of green salad, red tomatoes  [food bowl kitchen dining]\nkenney-graveyard:detail-bowl       shape      94 tok  small tan offering bowl on a foot  [item graveyard altar]\nkenney-graveyard:hay-bale          shape      68 tok  rectangular golden hay bale  [farm graveyard barn]\nkenney-graveyard:hay-bale-bundled  shape     110 tok  golden hay bale tied with two red bands  [farm graveyard barn]\n2 of 2 matches; --show <id> prints an entry to copy\nkenney-graveyard:lantern-candle    shape     303 tok  small green iron lantern with a candle inside  [light graveyard]\nkenney-graveyard:lantern-glass     shape     180 tok  small green iron lantern, glowing yellow glass  [light graveyard]\nkenney-graveyard:pumpkin-carved    shape     227 tok  carved jack-o'-lantern, glowing yellow face  [decoration light graveyard halloween]\nkenney-graveyard:pumpkin-tall-carved shape     231 tok  tall carved jack-o'-lantern, glowing yellow face  [decoration light graveyard halloween]\nkaykit-halloween-bits:pumpkin-yellow-jackolantern shape     527 tok  golden yellow pumpkin