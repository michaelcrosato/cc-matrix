 y: -50, z: 0, facing: PI / 2, pose:\", \"KC.poseStep(rig, 1 / 60, { seiza: cheer > .3 ? 0 : 1 }); rig.update(1 / 60, { x: wx, y: -50, z: 0, facing: wx < 200 ? .5 : PI - .5, pose:\"),\n (\"const key = 'seiza' + i, wx = -110 + i * 72;\", \"const key = 'seiza' + i, wx = -40 + i * 60;\"),\n # the stadium scoreboard lower; the shop's sign after the lanterns\n (\"const sx = PX(r, 200, .7); px.rect(g, sx - 60, fy - 175, 120, 40, '#101018'); px.rect(g, sx - 58, fy - 173, 116, 36, '#1a1a28');\\n      E.font.text(g, \\\"CHAMPON CUP '84\\\", sx, fy - 170, '#ffd040', { align: 'center', outline: false }); const sc = KC.scene && KC.scene.bout ? KC.scene.bout.points : [0, 0];\\n      E.font.text(g, 'WHITE ' + sc[0] + '   RED ' + sc[1], sx, fy - 156, '#ff7a5a', { align: 'center', outline: false });\\n      px.blend(g, .25, 'add', () => px.rect(g, sx - 60, fy - 175, 120, 40, '#ffb040'));\",\n  \"const sx = PX(r, 200, .7), sy = Math.max(34, fy - 146); px.rect(g, sx - 60, sy, 120, 34, '#101018'); px.rect(g, sx - 58, sy + 2, 116, 30, '#1a1a28');\\n      E.font.text(g, \\\"CHAMPON CUP '84\\\", sx, sy + 4, '#ffd040', { align: 'center', outline: false }); const sc = KC.scene && KC.scene.bout ? KC.scene.bout.points : [0, 0];\\n      E.font.text(g, 'WHITE ' + sc[0] + '   RED ' + sc[1], sx, sy + 18, '#ff7a5a', { align: 'center', outline: false });\\n      px.blend(g, .25, 'add', () => px.rect(g, sx - 60, sy, 120, 34, '#ffb040'));\"),\n]\nfor a,b in R:\n    assert s.count(a)==1, a[:90]\n    s=s.replace(a,b)\n# market: move the lantern rows before the shop so the sign is on top\na=\"\"\"      // CHAMPON-TEI: a shop front, a noren curtain with a bowl, steam\"\"\"\ni=s.index(a); j=s.index(\"      for (let row = 0; row < 2; row++) { const y0 = 26 + row * 26;\")\nk=s.index(\"\\n\", j)\nlant=s[j:k+1]\ns=s[:j]+s[k+1:]\ns=s.replace(a, lant+a)\nopen(p,'w').write(s)\np='src/11-poses.js'; s=open(p).read()\na=\"\"\"  const w = rig.worldOffset([rig.J.head[0] + rig.o.headR * .55, 0, rig.J.head[2] - rig.o.headR * .75]), p = r.w(rig.x + w[0], rig.y + w[1], rig.z + w[2]), s = rig.o.size * r.view.scale;\n  const x = Math.round(p[0]), y = Math.round(p[1]), bw\"\"\"\nb=\"\"\"  const w = rig.worldOffset([rig.J.head[0] + rig.o.headR * .55, 0, rig.J.head[2] - rig.o.headR * .75]), p = r.w(rig.x + w[0], rig.y + w[1], rig.z + w[2]), o = r.w(rig.x, rig.y, rig.z), s = rig.o.size * r.view.scale;\n  const x = Math.round(p[0] - o[0] + (ox || 0)), y = Math.round(p[1] - o[1] + (oy || 0)), bw\"\"\"\nassert s.count(a)==1; s=s.replace(a,b)\ns=s.replace(\"KC.drawBeard = (g, rig, r, color) => {\", \"KC.drawBeard = (g, rig, r, color, ox, oy) => {\")\nopen(p,'w').write(s)\nimport glob\nfor p in glob.glob('src/*.js'):\n    s=open(p).read(); n=s.count('KC.drawBeard(g, rig, r, rig.kcBeard)')+s.count('KC.drawBeard(g, c.rig, r, c.rig.kcBeard)')\n    s=s.replace('KC.drawBeard(g, rig, r, rig.kcBeard)','KC.drawBeard(g, rig, r, rig.kcBeard, ox, oy)').replace('KC.drawBeard(g, c.rig, r, c.rig.kcBeard)','KC.drawBeard(g, c.rig, r, c.rig.kcBeard, ox, oy)')\n    open(p,'w').write(s)\np='src/51-front.js'; s=open(p).read()\ns=s.replace(\"\"\"        E.font.text(g, E.versionLabel ? E.versionLabel() + ' - KARATE CHAMPON ' + KC.VERSION : KC.VERSION, Math.round(W / 2), H - 12, '#6a6488', { align: 'center', outline: false, font: 'tiny' });\n        E.font.text(g, '© 2026 AN ORIGINAL GAME INSPIRED BY KARATE CHAMP (1984)', Math.round(W / 2), H - 22, '#8a80a8', { align: 'center', outline: false, font: 'tiny' });\"\"\",\n\"\"\"        E.font.text(g, (E.versionLabel ? E.versionLabel() : 'v' + E.version) + ' - KARATE CHAMPON ' + KC.VERSION, Math.round(W / 2), H - 12, '#6a6488', { align: 'center', outline: false });\n        E.font.text(g, 'AN ORIGINAL GAME INSPIRED BY KARATE CHAMP (1984)', Math.round(W / 2), H - 23, '#8a80a8', { align: 'center', outline: false });\"\"\")\nopen(p,'w').write(s)\nprint('ok')\nEOF\nnode tools/build.mjs --quiet && node tests/shots.mjs title fight/dojo/kamaboko fight/bamboo/kikurage fight/st