     if (i === 2) { KC.A.sfx(game, 'menuOk'); const st = KC.DATA.stages[this.stageIds[this.stageI]]; return game.go('fight', KC.versusData(this.chosen, this.p2 === 'cpu' ? KC.DATA.opponentOrder[0] : 'negi', st)); }","+      const ids = this.ids;","+      if (i === 0) { this.p1 = (this.p1 + 1) % ids.length; }","+      if (i === 1) { if (this.mode === 'keys') { this.mode = 'cpu'; } else { this.p2 = (this.p2 + 1) % ids.length; if (this.p2 === this.p1) this.p2 = (this.p2 + 1) % ids.length; } }","+      if (i === 2) { const order = ['cpu', 'keys', 'kach']; this.mode = order[(order.indexOf(this.mode) + 1) % 3]; this.seats = this.seats === 4 ? 3 : 4; if (this.mode !== 'kach') this.seats = 2; }","       if (i === 3) this.stageI = (this.stageI + 1) % this.stageIds.length;","-      if (i === 4) return game.go('title');","-    },","-    update(d) {","-      this.menu.update(d);","-      if (this.menu.items) this.menu.items[3] = 'STAGE: ' + KC.DATA.stages[this.stageIds[this.stageI]].name;","-      if (game.input.pressed('confirm') || game.input.pressed('cancel')) { /* menu handles */ }","+      if (i === 4) {","+        KC.A.sfx(game, 'menuOk');","+        const st = KC.DATA.stages[this.stageIds[this.stageI]].id;","+        if (this.mode === 'kach') return game.go('kach', { seats: this.seats, stage: st, roster: [ids[this.p1]].concat(this.others()) });","+        return game.go('fight', Object.assign(KC.versusData(ids[this.p1], ids[this.p2], KC.DATA.stages[st], this.mode === 'keys' ? 'keys' : 'cpu'), {}));","+      }","+      if (i === 5) return game.go('title');","+      this.rebuild();","     },","+    others() { const ids = this.ids; const out = []; for (let k = 1; k < this.seats; k++) out.push(ids[(this.p2 + k - 1) % ids.length]); return out; },","+    update(d) { this.menu.update(d); },","     draw(r) {","       r.sky(['#101828', '#2a2a40', '#4a3a40']);","       r.overlay(g => {","         E.font.title(g, 'VERSUS', r.W / 2, 14, { scale: 3, colors: ['#fffbe8', '#ffe08a'], depth: 2, depthColor: '#5a2a10', align: 'center', outline: '#0b0814' });","-        // the picker: the playable roster in a grid, with the locks","-        KC.DATA.playableIds.forEach((id, i) => {","-          const x = 20 + (i % 5) * 62, y = 210 - 0 + Math.floor(i / 5) * 36;","-          const locked = !KC.unlocked(id) && id !== 'taro';","-          E.ui.box(g, x, y, 56, 30, { bg: locked ? ['#1a1a20', '#0a0a10'] : ['#3a2a4a', '#1a1028'], border: this.chosen === id ? '#ffd060' : '#4a3a5a' });","-          E.font.text(g, locked ? '?' : KC.DATA.roster[id].short, x + 28, y + 10, locked ? '#5a5a6a' : '#fff6d0', { align: 'center', outline: '#0b0814', font: 'tiny' });","+        this.ids.forEach((id, i) => {","+          const x = 20 + (i % 5) * 62, y = 230 + Math.floor(i / 5) * 36;","+          const on = i === this.p1 || i === this.p2;","+          E.ui.box(g, x, y, 56, 30, { bg: ['#3a2a4a', '#1a1028'], border: on ? '#ffd060' : '#4a3a5a' });","+          E.font.text(g, KC.DATA.roster[id].short, x + 28, y + 10, '#fff6d0', { align: 'center', outline: '#0b0814', font: 'tiny' });","         });","       });","       this.menu.draw(r);","     }","   };","-  KC.versusData = (w, r, st) => ({ mode: 'versus', w, r, stage: st.id, roundsToWin: 2, pointsToWin: KC.TUNE.pointsToWin, cpuW: false, cpuR: true, p2: 'cpu' });","+  KC.versusData = (w, r, st, p2) => ({ mode: 'versus', w, r, stage: st.id, roundsToWin: 2, pointsToWin: KC.TUNE.pointsToWin, cpuW: false, cpuR: p2 !== 'keys', p2: p2 || 'cpu' });"," ","   // ------------------------------------------------ the dojo: lessons and free spar (7.5), and the move list (8.6)","   S.dojo = {"]},{"oldStart":16746,"oldLines":7,"newStart":16761,"newLines":7,"lines":["     rigs: { w: KC.View.rigFor(wId, 'w'), r: KC.View.rigFor(rId, 'r') },","     judge: KC.View.rigFor('genkotsu', 'w', '#1d2b52'),","     aiW: new KC.KarateAI(w, seed + 11, { level: lvl(wId) }), aiR: new KC.KarateAI(r, seed + 23, { level: lvl(rId) }),","-    prevW: {}, prevR: {}, 