","   // the evasions and the block (no points)"]},{"oldStart":16086,"oldLines":7,"newStart":16086,"newLines":12,"lines":["   // how far a technique carries the body toward the foe (a lunge's step, a jump kick's flight)","   travel(t) { return t.air ? t.air.travel : t.flip ? t.flip.travel : t.travel || 0; }","   /** the gap band at the moment of contact (the start band less the distance the technique travels) */","-  contactBand(t) { const s = this.F.stats.reach * KC.TUNE.reachScale, tr = Math.max(0, this.travel(t)); return [Math.max(0, t.reach[0] - tr) * s, Math.max(4, t.reach[1] - tr) * s]; }","+  contactBand(t) {","+    const s = this.F.stats.reach * KC.TUNE.reachScale;","+    let tr = Math.max(0, this.travel(t));","+    if (t.air) { const airSteps = 2 * KC.TUNE.jump / KC.TUNE.gravity / STEP, f = this.frames(t); tr *= Math.min(1, (f[0] + f[1]) / airSteps); }   // a jump kick's flight: what it has flown by the end of its strike","+    return [Math.max(0, t.reach[0] * s - tr), Math.max(4, t.reach[1] * s - tr)];","+  }","   /** the body's profile now, for the height rules: stand, crouch, roll, air, flip, or null (can't be hit) */","   profile() {","     if (this.st === 'down' || this.st === 'rise' || this.st === 'script' || this.inv > 0) return null;"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183638__x1295cd/work/KarateChampon-KarateChamp1984-claude-opus-5-5-xhigh-20261103-183638/build/game.js","hunks":[{"oldStart":86,"oldLines":8,"newStart":86,"newLines":8,"lines":["   TECH('turnBackKick', 'TURN BACK KICK', 'USHIRO-MAWASHI', ['f', 'b'], 'mid', [17, 5, 26], [12, 40], [500, 1000], { travel: 12, spin: 1, kiai: 'heavy', move: { rel: true, kick: true, a0: 0, a1: 0, z0: .7, z1: 1, reach: 7.6, lean: -.3 } }),","   TECH('backRound', 'BACK ROUND KICK', 'URA-MAWASHI', ['b', 'u'], 'high', [15, 5, 23], [8, 34], [500, 1000], { spin: 1, kiai: 'heavy', move: { rel: true, kick: true, a0: 1.6, a1: -.4, z0: 1.1, z1: 1.6, reach: 7.5, twist: