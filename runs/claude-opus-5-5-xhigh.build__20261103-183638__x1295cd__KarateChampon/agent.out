        if (this.st === 'tech' && (t.id === 'jump' || t.flip)) { this.st = 'land'; this.k = 0; this.tech = null; this.emit('land', {}); }\"\"\",\"\"\"        if (this.st === 'tech' && (t.id === 'jump' || t.flip)) { this.landK = t.flip ? 24 : 10; this.st = 'land'; this.k = 0; this.tech = null; this.emit('land', {}); }\"\"\")\nrep(\"\"\"  script(pose, walkTo, speed = 1) { if (this.st === 'down' && walkTo !== null && walkTo !== undefined) { this.st = 'rise'; this.k = 0; } this.pose = pose || null; this.walkTo = walkTo === undefined ? null : walkTo; this.walkSpeed = speed; if (this.st !== 'rise') { if (this.st !== 'script') this.k = 0; this.st = 'script'; } this.tech = null; this.ctlOn = false; this.hold = false; }\"\"\",\"\"\"  script(pose, walkTo, speed = 1) {\n    this.scripted = true; this.stay = false; this.pose = pose || null; this.walkTo = walkTo === undefined ? null : walkTo; this.walkSpeed = speed; this.ctlOn = false; this.hold = false; this.buf = null;\n    if (this.st === 'down') { this.st = 'rise'; this.k = 0; }\n    else if (this.st !== 'rise' && this.st !== 'script') { this.st = 'script'; this.k = 0; this.tech = null; this.vx = 0; }\n  }\"\"\")\nrep(\"\"\"  release(foe) { this.st = 'idle';\"\"\",\"\"\"  release(foe) { this.scripted = false; this.stay = false; this.st = 'idle';\"\"\")\nrep(\"\"\"    this.st = kind === 'down' ? 'down' : 'hurt'; this.k = 0; this.tech = null; this.hold = false; this.buf = null;\"\"\",\"\"\"    this.st = kind === 'down' ? 'down' : 'hurt'; this.k = 0; this.tech = null; this.hold = false; this.buf = null; this.stay = true;\"\"\")\nrep(\"\"\"  recoil() { this.resolved = true; this.blockedBy = true; this.extra += 20; this.vx = -this.face * 14 / .12; this._recoilT = 14; }\"\"\",\"\"\"  recoil() { this.resolved = true; this.blockedBy = true; this.extra += 20; if (!this.airborne) this.vx = -this.face * 159; }\"\"\")\nrep(\"\"\"      if (t.flip) { if (this.airborne) { const air0 = 2 * t.flip.vz / KC.TUNE.gravity, ft = clamp(1 - (this.z