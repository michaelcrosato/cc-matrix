all.length ? ': ' + [...new Set(all)].slice(0, 4).join(' | ') : ''));\n  await p.close();\n}\nawait b.close(); process.exit(bad ? 1 : 0);\nEOF\ncd tests && ln -sf ../engine/node_modules node_modules; cd .. && export TMPDIR=$PWD/.tmp && node tests/shots.mjs 2>&1 | tail -20","description":"Screenshot the bundle at many deep links and report errors","timeout":300000}}}
