o.pads) { ctx.__pad = { index: 0, id: 'Wireless Controller (STANDARD GAMEPAD Vendor: 054c Product: 0ce6)', connected: true, axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0 })), mapping: 'standard' }; ctx.navigator = Object.assign(ctx.navigator || {}, { getGamepads: () => [ctx.__pad] }); }\"\"\"\nassert s.count(a)==1; s=s.replace(a,b); open(p,'w').write(s)\nprint('ok')\nEOF\nnode tests/run.mjs --only data,input,technique,bout 2>&1 | tail -8","description":"Fix the air-technique contact band, test EC1 via a stub pad","timeout":300000}}}
