KC.KarateAI(K.b, seed + 5, { level: KC.DATA.roster[K.ids[bSeat]].ai.level });","+    K.rigs = { w: KC.View.rigFor(K.ids[aSeat], 'w'), r: KC.View.rigFor(K.ids[bSeat], 'r') };","+    K.bout.on('point', (p) => { K.popup = { t: 1.2, text: (p.full ? 'FULL' : 'HALF') + ' · ' + KC.DATA.techniques[p.tech].name + ' ' + p.pts, color: p.full ? '#ffe070' : '#ffffff' }; });","+    K.bout.on('aiuchi', () => { K.popup = { t: 1, text: 'AIUCHI! NO POINT', color: '#ffffff' }; });","+  };","+  const boutEnd = () => {","+    const side = K.bout.matchOver;","+    const winSeat = side === 0 ? K.aSeat : K.bSeat, loseSeat = side === 0 ? K.bSeat : K.aSeat;","+    K.wins[winSeat]++;","+    K.queue = [winSeat].concat(K.queue.slice(2), [loseSeat]);","+    K.bout = null;","+    if (K.wins[winSeat] >= 5) { K.over = true; K.champion = winSeat; return; }","+    K.nextAt = K.t + 2.5;","+  };","+  S.kach = {","+    pausable: false,","+    enter(data) {","+      K.seats = data.seats || 2; K.ids = data.roster.slice(0, K.seats); K.stage = KC.DATA.stages[data.stage] || KC.DATA.stages.dojo;","+      K.queue = K.ids.map((_, i) => i); K.wins = K.ids.map(() => 0); K.boutN = 0; K.over = false; K.t = 0; K.champion = null; K.nextAt = 0;","+      K.prev = {};","+      boutStart(); KC.A.music(game, K.stage.music);","+    },","+    update(d) {","+      K.t += d; game.focus(200, 0, 30);","+      if (K.over) { if (game.input.pressed('confirm')) return game.go('title'); return; }","+      if (!K.bout) { if (K.t >= K.nextAt) boutStart(); return; }","+      const dirA = K.a.x < K.b.x ? 1 : -1, dirB = -dirA;","+      const iA = K.aiA ? K.aiA.intent(K.b, d) : KC.readControl(game.input, dirA, K.prev);","+      const iB = K.aiB ? K.aiB.intent(K.a, d) : { posture: 'n', tech: null };","+      K.bout.step(d, { a: () => iA, b: () => iB });","+      KC.stepPoses({ w: K.a, r: K.b, rigs: K.rigs }, d);","+      if (K.popup && K.popup.t > 0) K.popup.t -= d;","+      if (K.bout.phase === 'matchEnd' && K.bout.phaseT > K.bout.phaseLen - 0.01) boutEnd();","+    },","+    draw(r) {","+      KC.View.drawStage(r, K.stage, game.time);","+      if (K.bout) {","+        KC.View.drawFighters(r, [K.a, K.b], { w: K.rigs.w, r: K.rigs.r });","+        KC.View.hud(r, K.bout, { popup: K.popup ? Object.assign({ x: r.W / 2, y: r.H * 0.6 }, K.popup) : null });","+      }","+      r.overlay(g => {","+        E.ui.box(g, 6, r.H - 30, r.W - 12, 24, { bg: ['#1a1428', '#0e0a18'], border: '#c8a060' });","+        const parts = K.queue.map(seat => (seat === 0 ? 'YOU' : 'CPU ' + KC.DATA.roster[K.ids[seat]].short) + ' ' + K.wins[seat]);","+        E.font.text(g, 'KACHINUKI  ' + parts.join('  -  '), 12, r.H - 24, '#fff6d0', { outline: '#0b0814' });","+        if (K.over) E.font.title(g, (K.champion === 0 ? 'YOU ARE CHAMP' : 'CPU ' + KC.DATA.roster[K.ids[K.champion]].short + ' WINS') + '!', r.W / 2, r.H * 0.4, { scale: 2, colors: ['#fffbe8', '#ffe08a'], align: 'center', outline: '#0b0814' });","+        if (K.over) E.font.text(g, 'CROSS: TITLE', r.W / 2, r.H * 0.55, '#fff6d0', { align: 'center', outline: '#0b0814' });","+      });","+    }","+  };","+};","+"," // ---- src/70-dev.js"," // ---------------------------------------------------------------- dev mode (14): live sliders over KC.TUNE, toggles, warps, reset"," KC.DEV_SLIDERS = ["]},{"oldStart":17586,"oldLines":6,"newStart":17668,"newLines":7,"lines":[" KC.makeBonus(game, KC.S);"," KC.makeDev(game, KC.S);"," KC.makeOnline(game, KC.S);","+KC.makeKach(game, KC.S);"," // the ladder's VS card for story matches and the fight's retry data"," const wrapFight = KC.S.fight;"," KC.S.fight.enter = function (data) {"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184315__x1295cd/work/KarateChampon-KarateChamp1984-claude-haiku-5-5-medium-20261103-184315/build/game.js","hunks":[{"oldStart":1332,"oldLines":43,"newStart":1332,"newLines":58,"lines":["     }","   };"," ","-  // ------------------------------------------------ the versus setup 