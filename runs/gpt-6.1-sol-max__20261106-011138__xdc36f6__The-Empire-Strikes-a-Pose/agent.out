{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/art.js');s=p.read_text().replace(\\\"g.computeVertexNormals();return g;}\\\",\\\"for(let i=0;i<g.index.array.length;i+=3){const a=g.index.array[i];g.index.array[i]=g.index.array[i+2];g.index.array[i+2]=a;}g.computeVertexNormals();return g;}\\\");p.write_text(s)\np=Path('src/game.js');s=p.read_text().replace(\\\"this.manual=false;this.completed\\\", \\\"this.manual=new URLSearchParams(location.search).has('manual');this.completed\\\")\ns=s.replace(\\\"this.spawnRaider(0,-45,0);\\\", \\\"if(\"'!active){const ws=this.entities.filter(e=>e.type==='\"'walker');ws[0].pos.set(70,0,20);ws[1].pos.set(110,0,-90);for(const w of ws){w.mesh.position.copy(w.pos);w.body.setTranslation(w.pos,true);}}this.spawnRaider(0,-45,0);\\\")\np.write_text(s)\np=Path('src/style.css');s=p.read_text();s+='\\\\n#actionHints{background:rgba(11,30,43,.85);padding:.65rem .9rem;border-bottom:2px solid rgba(244,238,219,.7)}#reticle{box-shadow:0 0 0 1px rgba(15,39,52,.75)}#reticle i,#reticle b{box-shadow:0 0 1px 1px rgba(15,39,52,.5)}\\\\n';p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
