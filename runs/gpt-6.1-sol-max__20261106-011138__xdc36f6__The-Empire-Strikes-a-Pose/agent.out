k.pos.x,this.ark.pos.z,'#e7d6a0',4,true);for(const p of this.net.peers.values())if(p.stage===this.stage)dot(p.x,p.z,p.color||'#86e6e3',3);ctx.rotate(-this.player.yaw);ctx.fillStyle='#f4efdc';ctx.beginPath();ctx.moveTo(0,8);ctx.lineTo(-4,-5);ctx.lineTo(0,-3);ctx.lineTo(4,-5);ctx.closePath();ctx.fill();ctx.restore();}\n flash(no,text){\"'$('\"'chapterFlash').innerHTML='<small>FLIGHT COMIC / CHAPTER '+no+'</small>'+text;this.flashUntil=this.time+4;}\n setRadio(name,text,duration=5){\"'$('\"'radioName').textContent=name;\"'$('\"'radioText').textContent=text;this.radioUntil=this.time+duration;this.sound.voice(text);}\n toast(text){\"'$('\"'toast').textContent=text;\"'$('\"'toast').classList.add('visible');clearTimeout(this.toastTimer);this.toastTimer=setTimeout(()=>\"'$('\"'toast').classList.remove('visible'),2800);}\n resize(){if(\"'!this.renderer)return;this.camera.aspect=innerWidth/innerHeight;this.camera.updateProjectionMatrix();this.renderer.setSize(innerWidth,innerHeight);}\n snapshot(){return {ready:this.ready,title:GAME_META.aiHub.name,mode:this.mode,screen:this.screen,stage:this.stage,score:this.score,time:this.time,hp:this.player?.hp,arkHp:this.ark?.hp,heat:this.heat,overheated:this.overheated,pos:this.player?{x:this.player.pos.x,y:this.player.pos.y,z:this.player.pos.z}:null,yaw:this.player?.yaw,kills:this.kills,topples:this.topples,remaining:this.entities.filter(e=>!e.dead).map(e=>({type:e.type,hp:e.hp,x:e.pos.x,z:e.pos.z})),tether:this.tether?{wraps:this.tether.angleDone/(Math.PI*2),tension:this.tether.tension}:null,escort:this.escortProgress,won:this.won,completed:this.completed,backend:this.backend,physics:this.physicsVersion,animations:this.mixers.length,stats:this.stats,lastInput:this.lastInput,net:{active:this.net.active,sent:this.net.sent,received:this.net.received,peers:this.net.peers.size,ended:this.net.ended},music:this.settings.music};}\n publishAPI(){const api={snapshot:()=>this.snapshot(),audioProbe:()=>this.sound.offlineProbe(),audioLevel:()=>this.sound.level()};if(this.testMode)Object.assign(api,{game:this,pauseClock:()=>{this.manual=true;},run:(seconds,ai=false,controls=null)=>{this.manual=true;this.autopilot=ai;let n=Math.round(seconds*60);while(n-->0)this.tick(1/60,controls);this.cameraUpdate(.2);this.updateHUD();return this.snapshot();},render:async()=>{this.cameraUpdate(1);await this.renderer.renderAsync(this.scene,this.camera);},resumeClock:()=>{this.manual=false;this.lastFrame=performance.now();}});window.__POSE__=api;}\n}\nconst game=new Game();game.init().catch(error=>{console.error(error);feedback.textContent='\"'The flight systems could not start: '+error.message;const p=document.createElement('p');p.textContent='Open this file in a current Chrome, Edge, or Safari browser. WebGPU is preferred; WebGL 2 is supported.';feedback.after(p);window.__POSE__={snapshot:()=>({ready:false,error:String(error)})};if(window.AIHub.active)window.AIHub.fail(String(error));});\nexport {DEFAULTS,settingsDefault};\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > src/network.js <<'EOF'\nexport class WingLink {\n constructor(){this.hub=window.AIHub;this.active=false;this.info=null;this.peers=new Map();this.id=crypto.randomUUID().slice(0,8);this.room='frostline-07';this.bc=null;this.pc=null;this.dc=null;this.timer=0;this.reportTimer=0;this.sent=0;this.received=0;this.resultSent=false;this.started=false;this.ended=false;this.status='Solo flight';this.handlers={};}\n async init(){if(this.hub.active){this.info=await this.hub.connect({mode:'ghost',seats:[1,4]});this.active=\"'!!this.info;if(this.active){this.id=this.info.me;this.status='\"'AI HUB · '+this.info.players.length+' PILOTS';this.hub.on('start',()=>{this.started=true;this.handlers.start?.();});this.hub.on('message',(data,from)=>{if(this.ended)return;if(data?.type==='wing'&&typeof data.x==='number'){const p=this.info.players.find(p=>p.id===from);this.receive({...data,id:from,name:p?.name||'Wing',color:p?.color||'#86e6e3'});}});this.hub.on('leave',({id})=>{this.peers.delete(id);this.handlers.leave?.(id);});this.hub.on('time-up',()=>this.handlers.timeup?.());this.hub.on('end',()=>{this.ended=true;this.handlers.end?.();});return;}}this.joinLocal(this.room);}\n ready(){if(this.active)this.hub.ready();}\n joinLocal(room){if(this.active)return;this.bc?.close();this.peers.clear();this.room=String(room||'frostline-07').replace(/[\"'^a-zA-Z0-9_-]/g,'\"'').slice(0,30)||'frostline-07';try{this.bc=new BroadcastChannel('pose-wing-'+this.room);this.bc.onmessage=e=>{if(e.data?.type==='wing'&&e.data.id\"'!==this.id)this.receive(e.data);};this.status='\"'LOCAL WING · '+this.room;}catch{this.status='Direct link available';}}\n receive(data){if(\"'!Number.isFinite(data.x)||!Number.isFinite(data.z))return;data.seen=performance.now();this.peers.set(data.id,data);this.received++;}\n tick(state,dt){if(this.ended)return;this.timer+=dt;this.reportTimer+=dt;if(this.active&&!this.started)return;if(this.timer>=.1){this.timer=0;const d={type:'\"'wing',id:this.id,name:'Wing '+this.id.slice?.(0,3),color:'#86e6e3',x:+state.x.toFixed(2),y:+state.y.toFixed(2),z:+state.z.toFixed(2),yaw:+state.yaw.toFixed(3),stage:state.stage,score:state.score,fire:state.fire,live:state.live};if(this.active)this.hub.send(d,{reliable:false});else{this.bc?.postMessage(d);if(this.dc?.readyState==='open')this.dc.send(JSON.stringify(d));}this.sent++;}if(this.active&&this.reportTimer>=1){this.reportTimer=0;this.hub.progress({score:state.score,label:['Scouts','Walkers','Evacuation'][state.stage]||'Sortie'});}for(const [id,p]of this.peers){if(performance.now()-p.seen>8000)this.peers.delete(id);}}\n finish(score,stats){if(this.active&&\"'!this.resultSent&&!this.ended){this.resultSent=true;this.hub.result({score,stats});}}\n newRun(){if(!this.active)this.resultSent=false;}\n bindChannel(dc){this.dc=dc;dc.onopen=()=>{this.status='\"'DIRECT WING · CONNECTED';this.handlers.status?.(this.status);};dc.onclose=()=>{this.status='DIRECT WING · DISCONNECTED';this.handlers.status?.(this.status);};dc.onmessage=e=>{try{const d=JSON.parse(e.data);if(d.type==='wing')this.receive({...d,id:'direct',name:'Direct wing',color:'#ef9b60'});}catch{}};}\n createPC(){this.pc?.close();const pc=new RTCPeerConnection({iceServers:[]});this.pc=pc;pc.ondatachannel=e=>this.bindChannel(e.channel);pc.onconnectionstatechange=()=>{if(pc.connectionState==='failed'){this.status='Link failed. Create a new invite; this network may block direct connections.';this.handlers.status?.(this.status);}};return pc;}\n async gather(pc){if(pc.iceGatheringState==='complete')return;await new Promise(resolve=>{let done=false;const timer=setTimeout(()=>{if(\"'!done){done=true;resolve();}},4000);pc.addEventListener('\"'icegatheringstatechange',()=>{if(pc.iceGatheringState==='complete'&&\"'!done){done=true;clearTimeout(timer);resolve();}});});}\n encode(d){return btoa(JSON.stringify({v:1,type:d.type,sdp:d.sdp}));}\n decode(code){try{const d=JSON.parse(atob(code.trim()));if(d.v!==1||!['\"'offer','answer'].includes(d.type)||typeof d.sdp\"'!=='\"'string')throw Error();return {type:d.type,sdp:d.sdp};}catch{throw Error('That connection code is incomplete. Paste the full code.');}}\n async invite(){if(this.active)throw Error('AI Hub manages this wing.');const pc=this.createPC();this.bindChannel(pc.createDataChannel('frostline-wing',{ordered:false,maxRetransmits:0}));await pc.setLocalDescription(await pc.createOffer());await this.gather(pc);return this.encode(pc.localDescription);}\n async accept(code){if(this.active)throw Error('AI Hub manages this wing.');const desc=this.decode(code);if(desc.type==='answer'){if(\"'!this.pc||this.pc.signalingState!=='\"'have-local-offer')throw Error('Create an invite before accepting an answer.');await this.pc.setRemoteDescription(desc);return null;}const pc=this.createPC();await pc.setRemoteDescription(desc);await pc.setLocalDescription(await pc.createAnswer());await this.gather(pc);return this.encode(pc.localDescription);}\n close(){this.bc?.close();this.dc?.close();this.pc?.close();}\n}\nEOF\ncat > src/game.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {landscape,snow,skimmer,raider,walker,shuttle,repairBuoy,shadow,piece,toppleAnimation,comicBurst} from './art.js';\nimport {Sound} from './audio.js';\nimport {WingLink} from './network.js';\nimport {Interface} from './ui.js';\nconst \"'$=id=>document.getElementById(id);\nconst clamp=(x,a,b)=>Math.max(a,Math.min(b,x));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst angle=(a,b)=>Math.atan2(Math.sin(a-b),Math.cos(a-b));\nconst v3=(x=0,y=0,z=0)=>new T.Vector3(x,y,z);\nconst DEFAULTS={speed:32,turn:1.8,laserDamage:1,enemyDamage:1,pressure:1,wraps:2,timeScale:1};\nconst settingsDefault={music:.1,sfx:.7,voice:.55,glyphs:'\"'ps',camera:'chase',aimAssist:true,shake:true,sensitivity:1};\nconst feedback=document.querySelector('#loadStatus');\nclass Game{\n constructor(){this.ready=false;this.mode='loading';this.screen='title';this.backScreen='title';this.time=0;this.stage=0;this.score=0;this.kills=0;this.topples=0;this.shots=0;this.hits=0;this.rescues=0;this.runTime=0;this.lastInput='keyboard';this.idle=0;this.keys=new Set();this.mouse={x:0,y:0,down:false,active:false};this.touch={pointers:new Map(),turn:0,throttle:0,aimX:0,aimY:0,fire:false};this.controls={turn:0,throttle:0,boost:false,fire:false,cable:false,brake:false};this.padPrev=[];this.padMenuRepeat=0;this.entities=[];this.projectiles=[];this.particles=[];this.bursts=[];this.debris=[];this.mixers=[];this.cache=[];this.ghosts=new Map();this.colliders=new Map();this.radioUntil=0;this.flashUntil=0;this.damageFlash=0;this.uiClock=0;this.fireCooldown=0;this.overheated=false;this.heat=0;this.tether=null;this.cableCooldown=0;this.selected=null;this.autopilot=false;this.invincible=false;this.debugPhysics=false;this.testMode=new URLSearchParams(location.search).has('test');this.manual=false;this.completed=false;this.ended=false;this.settings={...settingsDefault};this.balance={...DEFAULTS};this.best=0;try{const s=JSON.parse(localStorage.getItem('pose.settings'));if(s)Object.assign(this.settings,s);this.best=Number(localStorage.getItem('pose.best'))||0;}catch{}this.sound=new Sound(this.settings);this.net=new WingLink();this.ui=new Interface(this);this.stats={cableSnaps:0,boostSeconds:0,repairs:0,damageTaken:0,physicsHits:0};this.lastFrame=performance.now();this.cameraTarget=v3();this.currentSpeed=0;this.tactical=false;}\n async init(){await this.net.init();feedback.textContent='Building the ice and ink…';await RAPIER.init();this.physicsVersion=RAPIER.version();this.scene=new T.Scene();this.scene.background=new T.Color(0xa9c7cc);this.scene.fog=new T.Fog(0xb8cfd0,230,850);this.camera=new T.PerspectiveCamera(56,innerWidth/innerHeight,.2,1800);this.renderer=new T.WebGPURenderer({canvas:\"'$('\"'scene'),antialias:true,alpha:false,powerPreference:'high-performance'});this.renderer.setPixelRatio(Math.min(devicePixelRatio,2));this.renderer.setSize(innerWidth,innerHeight);this.renderer.shadowMap.enabled=true;this.renderer.shadowMap.type=T.PCFSoftShadowMap;this.renderer.toneMapping=T.ACESFilmicToneMapping;this.renderer.toneMappingExposure=1.23;await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'WebGPU':'WebGL 2 fallback';const hemi=new T.HemisphereLight(0xe9eed5,0x52768b,2.1);this.scene.add(hemi);const sun=new T.DirectionalLight(0xffdfad,3.1);sun.position.set(-150,250,120);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);Object.assign(sun.shadow.camera,{left:-260,right:260,top:300,bottom:-300,near:1,far:800});sun.shadow.bias=-.001;sun.shadow.normalBias=.3;this.scene.add(sun);const fill=new T.DirectionalLight(0x7bbed5,1.1);fill.position.set(150,75,-100);this.scene.add(fill);this.land=landscape(this.scene);this.snow=snow(this.scene);this.dynamicGroup=new T.Group();this.scene.add(this.dynamicGroup);this.physicsDebug=new T.LineSegments(new T.BufferGeometry(),new T.LineBasicMaterial({vertexColors:true,depthTest:false}));this.physicsDebug.frustumCulled=false;this.physicsDebug.visible=false;this.scene.add(this.physicsDebug);this.setupInput();this.resetWorld(false);this.net.handlers={start:()=>{this.begin(false,true);},timeup:()=>{this.endRun(false,'The flight window has closed.',true);},end:()=>{this.ended=true;this.mode='ended';this.ui.hide();\"'$('\"'hud').hidden=true;this.sound.update(0,false,true);},leave:id=>this.toast('A wing echo has left the sector.'),status:()=>this.ui.updateNetStatus()};this.ready=true;if(this.net.active){this.mode='hubwait';this.ui.hide();\"'$('\"'hud').hidden=false;this.setRadio('CONTROL / FLIGHT OPS','Stand by. Your flight window opens on the shared clock.',100);this.net.ready();}else{this.mode='title';this.ui.show('title');}this.renderer.setAnimationLoop(t=>this.frame(t));this.publishAPI();window.addEventListener('resize',()=>this.resize());this.resize();}\n resetWorld(active=true){if(this.world)this.world.free();this.world=new RAPIER.World({x:0,y:-24,z:0});this.world.timestep=1/60;this.colliders.clear();this.dynamicGroup.clear();this.mixers.length=0;this.entities=[];this.projectiles=[];this.particles=[];this.bursts=[];this.debris=[];this.cache=[];for(const g of this.ghosts.values())this.scene.remove(g.mesh);this.ghosts.clear();this.world.createCollider(RAPIER.ColliderDesc.cuboid(950,1,950).setTranslation(0,-1,0));this.time=0;this.stage=0;this.score=0;this.kills=0;this.topples=0;this.shots=0;this.hits=0;this.runTime=0;this.heat=0;this.fireCooldown=0;this.overheated=false;this.tether=null;this.selected=null;this.cableCooldown=0;this.completed=false;this.ended=false;this.escortStarted=false;this.aceSpawned=false;this.escortProgress=0;this.stats={cableSnaps:0,boostSeconds:0,repairs:0,damageTaken:0,physicsHits:0};this.net.newRun();const ship=skimmer(this.mixers);this.dynamicGroup.add(ship);const sh=shadow(this.dynamicGroup);this.player={mesh:ship,shadow:sh,pos:v3(0,9,100),yaw:Math.PI,hp:100,speed:0,bank:0,invuln:0};ship.position.copy(this.player.pos);this.player.body=this.world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0,9,100));this.player.collider=this.world.createCollider(RAPIER.ColliderDesc.ball(2.2),this.player.body);this.colliders.set(this.player.collider.handle,{type:'player',entity:this.player});this.ark={mesh:shuttle(this.mixers),pos:v3(0,8,160),hp:180,body:null};this.dynamicGroup.add(this.ark.mesh);this.ark.mesh.position.copy(this.ark.pos);this.ark.mesh.rotation.y=Math.PI;this.ark.body=this.world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0,8,160));this.ark.collider=this.world.createCollider(RAPIER.ColliderDesc.cuboid(9,4,14),this.ark.body);this.colliders.set(this.ark.collider.handle,{type:'ark',entity:this.ark});this.ark.shadow=shadow(this.dynamicGroup,2);for(const [i,p] of [[0,[-36,-42]],[1,[67,-114]]])this.spawnWalker(p[0],p[1],i);this.spawnRaider(0,-45,0);this.spawnRaider(-73,-75,1);this.spawnRaider(7