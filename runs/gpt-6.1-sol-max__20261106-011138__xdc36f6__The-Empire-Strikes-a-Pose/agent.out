{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/game.js');s=p.read_text();start=s.index(' shootPlayer(){');end=s.index('\\\\n hitEnemy(',start)\nmethod=''' shootPlayer(){\n  if(this.fireCooldown>0||this.overheated)return;\n  const p=this.player,target=this.selected&&\"'!this.selected.dead?this.selected:this.closestTarget();\n  let aim=v3(Math.sin(p.yaw),.02,Math.cos(p.yaw)),aimPoint=null;\n  const aiming=this.mouse.active||Math.abs(this.mouse.x)+Math.abs(this.mouse.y)>.08;\n  if(target){\n   const targetPoint=target.pos.clone();targetPoint.y=target.type==='\"'walker'?17:target.pos.y;\n   const toward=targetPoint.clone().sub(p.pos),diff=Math.abs(angle(Math.atan2(toward.x,toward.z),p.yaw));\n   const assist=this.settings.aimAssist||this.lastInput==='touch'||this.mode==='attract'||this.autopilot;\n   const projected=targetPoint.clone().project(this.camera),nearReticle=Math.hypot(projected.x-this.mouse.x,projected.y-this.mouse.y)<.25;\n   if(assist&&diff<.9&&(\"'!aiming||nearReticle||this.mode==='\"'attract'||this.autopilot)){\n    aimPoint=targetPoint.addScaledVector(target.velocity||v3(),toward.length()/240);\n    aim=aimPoint.clone().sub(p.pos).normalize();\n   }\n  }\n  if(\"'!aimPoint&&aiming){const ray=new T.Raycaster();ray.setFromCamera(new T.Vector2(this.mouse.x,this.mouse.y),this.camera);aimPoint=ray.ray.at(300,v3());aim=aimPoint.clone().sub(p.pos).normalize();}\n  if(!aimPoint)aimPoint=p.pos.clone().addScaledVector(aim,250);\n  const right=v3(Math.cos(p.yaw),0,-Math.sin(p.yaw));\n  for(const sign of [-1,1]){const muzzle=p.pos.clone().addScaledVector(right,sign*3.8).addScaledVector(aim,4);this.shoot(muzzle,aimPoint.clone().sub(muzzle),false,p);}\n  this.fireCooldown=.19;this.heat+=7.5;if(this.heat>=100){this.overheated=true;this.toast('\"'Cannons hot. Ease off to cool.');}\n }'''\ns=s[:start]+method+s[end:]\ns=s.replace(\\\"maxHp:ace?18:4,yaw:0,dead:false\\\", \\\"maxHp:ace?18:4,velocity:v3(),yaw:0,dead:false\\\")\ns=s.replace(\\\"if(dist>5){e.pos.x+=Math.sin(e.yaw)*speed*dt;e.pos.z+=Math.cos(e.yaw)*speed*dt;}\\\", \\\"if(dist>5){e.velocity.set(Math.sin(e.yaw)*speed,0,Math.cos(e.yaw)*speed);e.pos.addScaledVector(e.velocity,dt);}else e.velocity.set(0,0,0);\\\")\ns=s.replace(\\\"pilot(c){if(this.completed)return c;\\\", \\\"pilot(c){if(this.completed)return c;if(this.heat>84)this.aiCooling=true;if(this.heat<28)this.aiCooling=false;\\\")\ns=s.replace(\\\"c.fire=target.type\"'!=='\"'walker'&&Math.abs(diff)<.75;\\\", \\\"c.fire=target.type\"'!=='\"'walker'&&Math.abs(diff)<.75&&\"'!this.aiCooling;\")\ns=s.replace(\"this.completed=false;this.won=false;this.ended=false;this.escortStarted\", \"this.completed=false;this.won=false;this.aiCooling=false;this.ended=false;this.escortStarted\")\np.write_text(s)\n# Add the complete license texts to the single-file distribution and its credits.\nthree=Path('\"'node_modules/three/LICENSE').read_text();apache=Path('/usr/share/common-licenses/Apache-2.0').read_text()\nPath('THIRD-PARTY-LICENSES.txt').write_text('THREE.JS R180 / MIT\\\\n\\\\n'+three+'\\\\n\\\\nRAPIER 0.19.3 / DIMFORGE / APACHE-2.0\\\\n\\\\n'+apache)\np=Path('src/template.html');s=p.read_text().replace('window.GAME_META=/*METADATA*/;','window.GAME_META=/*METADATA*/;window.GAME_LICENSES=/*LICENSES*/;');p.write_text(s)\np=Path('build.mjs');s=p.read_text().replace(\\\"const css = await readFile('src/style.css','utf8');\\\",\\\"const css = await readFile('src/style.css','utf8');\\\\nconst licenses = await readFile('THIRD-PARTY-LICENSES.txt','utf8');\\\")\ns=s.replace(\\\".replace('/*GAME_CODE*/',()=>js)\\\",\\\".replace('/*LICENSES*/',()=>JSON.stringify(licenses).replaceAll('<','\\\\\\\\\\\\\\\\u003c')).replace('/*GAME_CODE*/',()=>js)\\\");p.write_text(s)\np=Path('src/ui.js');s=p.read_text();s=s.replace(\\\"+this.button('back','Back','', 'primary'));}\\\\n network()\\\", \\\"+this.button('licenses','Library licenses')+this.button('back','Back','', 'primary'));}\\\\n network()\\\")\ns=s.replace(\\\"screen==='about'?this.about():this.network()\\\", \\\"screen==='about'?this.about():screen==='licenses'?this.wrap('THIRD-PARTY SOFTWARE','Library licenses','<pre class=\\\\\\\\\\\\\\\"licenses\\\\\\\\\\\\\\\">'+escape(window.GAME_LICENSES)+'</pre>'+this.button('about','Back to credits','', 'primary')):this.network()\\\")\ns=s.replace(\\\"case'network':case'dev':\\\", \\\"case'network':case'dev':case'licenses':\\\")\np.write_text(s)\np=Path('src/style.css');s=p.read_text()+'.licenses{white-space:pre-wrap;font: .65rem/1.6 monospace;color:#c3d7da;user-select:text}\\\\n';p.write_text(s)\nPY\nnpm run build\nnpm test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
