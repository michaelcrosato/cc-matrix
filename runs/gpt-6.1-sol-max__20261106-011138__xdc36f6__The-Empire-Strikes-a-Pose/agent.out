e().addScaledVector(f,-48).add(v3(0,27,0));look=p.pos.clone().addScaledVector(f,35);}}\\\")\ns=s.replace('\\\\nexport {DEFAULTS,settingsDefault};','')\np.write_text(s)\np=Path('src/ui.js');s=p.read_text().replace(\\\"import {DEFAULTS,settingsDefault} from './game.js';\\\",\\\"import {DEFAULTS,settingsDefault} from './mission.js';\\\");p.write_text(s)\np=Path('test.py');s=p.read_text().replace(\\\"__POSE__.run(3,false,{turn:0,throttle:0,boost:false,fire:true\\\", \\\"__POSE__.run(4.2,false,{turn:0,throttle:0,boost:false,fire:true\\\")\ns=s.replace(\\\"snapshot().tether.wraps') > .1\\\", \\\"snapshot().tether.wraps') > .05\\\")\ns=s.replace(\\\"        js(page, '__POSE__.run(125,true)')\\\\n        check('Attract showcases all mission mechanics', js(page, '__POSE__.snapshot().completed && __POSE__.snapshot().topples===2'))\\\", \\\"        attract = []\\\\n        for _ in range(35):\\\\n            state = js(page, '__POSE__.run(10,true)')\\\\n            attract.append(state)\\\\n            if state['completed']:\\\\n                break\\\\n        (ART / 'attract.json').write_text(json.dumps(attract, indent=2))\\\\n        check('Attract showcases all mission mechanics', state['completed'] and state['topples'] == 2, state)\\\")\ns=s.replace(\\\"check('Attract loops to a fresh sortie', js(page, '__POSE__.snapshot().mode') == 'attract' and js(page, '__POSE__.snapshot().time') < 6)\\\",\\\"check('Attract loops to a fresh sortie', js(page, '__POSE__.snapshot().mode') == 'attract' and js(page, '__POSE__.snapshot().time') < 6, js(page, '__POSE__.snapshot()'))\\\")\ns=s.replace(\\\"check('Any input exits attract without starting a run', js(page, '__POSE__.snapshot().mode') == 'title')\\\", \\\"check('Any input exits attract without starting a run', js(page, '__POSE__.snapshot().mode') == 'title', js(page, '__POSE__.snapshot()'))\\\")\ns=s.replace(\\\"check('No external runtime asset requests'\\\", \\\"check('Hub client embedded unmodified', (HERE / 'session.js').read_text() in html)\\\\ncheck('No external runtime asset requests'\\\")\np.write_text(s)\nPY\nrg --files node_modules/three node_modules/@dimforge/rapier3d-compat -g '*LICENSE*' -g '*license*'\nnpm run build\nnpm test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
