{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat >> src/style.css <<'EOF'\nbody.touch .mission-badge strong{font-size:14px}body.touch .mission-badge>span:first-child{font-size:9px}body.touch .score-badge strong{font-size:21px}body.touch .flight-status{min-width:175px}body.touch .status-line>span{font-size:10px;min-width:62px}body.touch .status-line b{font-size:14px}body.touch #radio p{font-size:14px}body.touch #radio>span{font-size:9px}body.touch #touchAction{font-size:14px}body.touch #cableMeter>span{font-size:12px}body.touch #cableMeter small{font-size:9px;line-height:1.4}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\nimport json\np=Path('test.py');s=p.read_text();needle=\\\"        mobile_context.close()\\\\n        # Hub's official\\\"\ns=s.replace(needle,\\\"\\\"\\\"        mobile.set_viewport_size({'width':390,'height':844})\n        js(mobile, \\\\\\\"__POSE__.game.ui.action('title');__POSE__.render()\\\\\\\")\n        title_box = mobile.get_by_role('button', name='Launch sortie').bounding_box()\n        check('Portrait phone menu keeps launch in the viewport', title_box is not None and title_box['y'] >= 0 and title_box['y']+title_box['height'] <= 844)\n        mobile.screenshot(path=str(ART / 'phone-title.png'))\n        mobile_context.close()\n        tablet_options = dict(p.devices['iPad (gen 7)'])\n        tablet_options['device_scale_factor'] = 1\n        tablet_context = browser.new_context(**tablet_options)\n        tablet = tablet_context.new_page()\n        load(tablet, url + '?test=1&manual=1')\n        tablet.get_by_role('button', name='Launch sortie').tap()\n        check('Tablet device profile launches with native touch prompts', js(tablet, '__POSE__.snapshot().mode') == 'playing' and js(tablet, '__POSE__.snapshot().lastInput') == 'touch')\n        tablet_context.close()\n        # Hub's official\\\"\\\"\\\")\np.write_text(s)\np=Path('../exit-interview.json');d=json.loads(p.read_text());d