ilot=false;this.invincible=false;this.ui.hide();\"'$('\"'hud').hidden=false;\"'$('\"'attractBadge').hidden=\"'!attract;this.player.mesh.visible=true;this.flash('\"'01','THE COLD OPEN');this.setRadio('ROOK / FLIGHT LEAD','Three scouts on the approach. Take them out before they find the refuge.',7);this.net.started=true;this.updateHUD();}\n endRun(won,reason='',timeup=false){if(this.completed||this.ended)return;this.completed=true;this.won=won;if(won){this.rescues=38;this.score+=2000+Math.round(this.ark.hp/180*800)+Math.round(this.player.hp*3);this.sound.ping();}if(this.mode==='attract'){this.attractEnd=this.time+4;return;}this.net.finish(this.score,this.getStats());this.keys.clear();this.mouse.down=false;if(\"'!this.net.active){if(this.score>this.best){this.best=this.score;try{localStorage.setItem('\"'pose.best',String(this.best));}catch{}}this.mode='result';this.resultReason=reason|| (won?'Thirty-eight people will see another sunrise.':'The cold front held the last word.');this.ui.show('result');}else{this.mode='hubresult';this.setRadio('CONTROL / FLIGHT OPS',won?'Transport away. Your sortie is on the board.':'Flight window closed. Your sortie is on the board.',100);}}\n getStats(){return {Scouts:this.kills,Walkers:this.topples,'Hull left':Math.round(this.player.hp),'Ark left':Math.round(this.ark.hp/1.8),'Flight seconds':Math.round(this.runTime),'Accuracy %':this.shots?Math.round(this.hits/this.shots*100):0};}\n saveSettings(){try{localStorage.setItem('pose.settings',JSON.stringify(this.settings));}catch{}this.sound.volumes();}\n noteInput(kind){if(this.ended)return;this.idle=0;if(this.mode==='attract'){this.mode='title';\"'$('\"'attractBadge').hidden=true;\"'$('\"'hud').hidden=true;this.resetWorld(false);this.ui.show('title');this.lastInput=kind;this.ignoreInputUntil=performance.now()+220;return true;}if(this.lastInput\"'!==kind){this.lastInput=kind;document.body.classList.toggle('\"'touch',kind==='touch');this.ui.refreshHints();}return false;}\n setupInput(){windo