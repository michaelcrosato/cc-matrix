n !!S.ended || today.some((e) => e.id === 'longstand');\n    default: return false;\n  }\n}\nEOF\ncat > src/data/questions.js <<'EOF'\n// Morning questions. Three answers each; they change only the remark, and Ounce files them.\nexport const QUESTIONS = [\n  { q: 'When you stand up, what sound do you make?', a: ['Oof.', 'Hnng.', 'I have become the sound.'] },\n  { q: 'Have you ever apologised to a chair?', a: ['Yes.', 'Not yet.', 'It started it.'] },\n  { q: 'How many stairs is too many?', a: ['One.', 'All of them.', 'Depends who\\'s watching.'] },\n  { q: 'How do you feel about your ankles?', a: ['Fine.', 'We don\\'t speak.', 'Which ones?'] },\n  { q: 'What is your relationship with the floor?', a: ['Distant.', 'Improving.', 'It\\'s complicated.'] },\n  { q: 'If your knees could talk, what would they say?', a: ['Please.', 'Why.', 'Nothing. They\\'ve given up.'] },\n  { q: 'Are you happy?', a: ['Yes.', 'No.', 'Is this graded?'], day7: true },\n];\nexport const questionFor = (day) => (day >= 7 ? 6 : (day - 1) % 6);\nEOF\ncat > src/data/unlocks.js <<'EOF'\n// Sweat Jar milestones. Each unlocks a Locker Room item and a remark.\nexport const MILESTONES = [\n  { at: 10, kind: 'headband', value: 'sky', name: 'Second headband', remark: 'Ten drips. A second headband. The first one is jealous.' },\n  { at: 25, kind: 'cape', value: 'towel', name: 'Towel cape', remark: 'Twenty-five. A towel cape. It does nothing. It does it well.' },\n  { at: 45, kind: 'badge', value: 'confidence', name: 'Confidence: no visible effect', remark: 'Forty-five. A badge: Confidence. No visible effect. I checked.' },\n  { at: 70, kind: 'shoe', value: 'sand', name: 'Gold-ish shoes', remark: 'Seventy. Shoes the colour of effort.' },\n  { at: 100, kind: 'top', value: 'red', name: 'Red top', remark: 'One hundred. A red top. Blame the Jar, not me.' },\n  { at: 135, kind: 'hair', value: 'sand', name: 'Sunny hair', remark: 'One thirty-five. Your hair has opinions now. Sunny ones.' },\n  { at: 175, kind: 'bottom', value: 'plum', name: 'Plum bottoms', remark: 'One seventy-five. The Jar is full. It wishes to be photographed.' },\n];\nexport const JAR_MAX = 175;\nexport const unlockedAt = (drips) => MILESTONES.filter((m) => drips >= m.at);\nexport const isUnlocked = (drips, kind, value) => !MILESTONES.some((m) => m.kind === kind && m.value === value) || drips >= MILESTONES.find((m) => m.kind === kind && m.value === value).at;\nEOF\ncat > src/data/classmates.js <<'EOF'\n// Classmates and their records: Dennis (low), June (mid-high), Marguerite (high), from each activity's thresholds.\nimport { ACTIVITIES } from './activities.js';\nexport const CLASSMATES = [\n  { id: 'dennis', name: 'Dennis', mul: 0.55, skill: 'sloppy', look: 'dennis' },\n  { id: 'june', name: 'June', mul: 1.0, skill: 'good', look: 'june' },\n  { id: 'marguerite', name: 'Marguerite', mul: 1.18, skill: 'expert', look: 'marguerite' },\n];\nexport function classmateScore(cm, actId) {\n  const a = ACTIVITIES[actId]; if (!a) return 0;\n  if (a.special) return { dennis: 640, june: 820, marguerite: 930 }[cm.id];\n  const top = a.stars[2];\n  return Math.round({ dennis: top * 0.42, june: a.stars[1] * 1.08, marguerite: top * 1.12 }[cm.id]);\n}\nexport const recordsFor = (actId) => CLASSMATES.map((c) => ({ id: c.id, name: c.name, score: classmateScore(c, actId) }));\nEOF\ncat > src/data/charts.js <<'EOF'\n// Step Class charts: strings per bar, eight cells a bar (half-beats). L = left foot, R = right foot, . = rest.\nexport const STEP_BPM = 104;\nconst A = 'L.R.L.R.', B = 'L.R.LR..', C = 'L.R.L...', D = 'LRLRLRLR', E = 'L...R...', F = 'L.R...L.', G = 'R.L.R.L.', H = 'L.RRL.R.';\nexport const SECTIONS = [\n  { name: 'intro', bars: [E, E, E, A] },\n  { name: 'verse', bars: [A, A, B, A, A, F, B, C] },\n  { name: 'chorus', bars: [D, A, D, B, D, A, D, H] },\n  { name: 'breakdown', bars: [E, A, E, G] },\n  { name: 'final', bars: [D, D, H, A, D, D, H, D] },\n];\nexport const CHART = SECTIONS.flatMap((s) => s.bars);\nexport const BARS = CHART.length; // 32\nexport const barLen = (bpm = STEP_BPM) => (4 * 60) / bpm;\n/** Notes: { t (s from song start), foot: 'L'|'R' }. */\nexport function notes(chart = CHART, bpm = STEP_BPM) {\n  const out = [], bl = barLen(bpm);\n  chart.forEach((bar, b) => [...bar].forEach((ch, i) => { if (ch === 'L' || ch === 'R') out.push({ t: b * bl + (i / 8) * bl, foot: ch, bar: b }); }));\n  return out;\n}\nexport const songLength = (bpm = STEP_BPM) => BARS * barLen(bpm);\nEOF\ncat > src/data/boards.js <<'EOF'\n// Vitamin Tray boards: '#' wall, '.' floor, 'o' vitamin start, 'g' gap in the rail (a drop), R/B/Y cups.\nexport const CELL = 0.4;\nexport const BOARDS = [\n  { name: 'First tray', colors: ['R', 'B'], rows: [\n    '############', '#R........B#', '#..........#', '#...oooo...#', '#...oooo...#', '#..........#', '#..........#', '############'] },\n  { name: 'Second tray', colors: ['R', 'B', 'Y'], rows: [\n    '############', '#R...##...B#', '#....##....#', '#...oooo...#', '#...oooo...#', '#....##....#', '#Y...##....#', '############'] },\n  { name: 'Third tray', colors: ['R', 'B', 'Y'], rows: [\n    '######gg####', '#R........B#', '#....##....#', 'g...oooo...g', '#...oooo...#', '#....##....#', '#Y.........#', '######gg####'] },\n];\nexport const boardDims = (b) => ({ w: b.rows[0].length, h: b.rows.length });\nEOF\ncat > src/data/medley.js <<'EOF'\n// The Medley: three events in fixed windows, 55 s each with 10 s between (shortened in tests). Picks come from a seeded stream.\nexport const EVENTS = [\n  { id: 'still', title: 'Stillness', pool: ['tree', 'heron', 'warrior', 'chair'] },\n  { id: 'beat', title: 'Beat', pool: ['squat', 'hoop', 'step'] },\n  { id: 'lean', title: 'Balance-lean', pool: ['header'] },\n];\nexport const EVENT_SECS = 55, GAP_SECS = 10;\nexport const MEDLEY_TOTAL = EVENTS.length * EVENT_SECS + (EVENTS.length - 1) * GAP_SECS; // 185 s\nexport function picks(rand) { return EVENTS.map((e) => e.pool[Math.floor(rand() * e.pool.length) % e.pool.length]); }\nexport const AWARDS = [\n  ['Stillest', 'Spent the longest inside the circle.'], ['Most Apologetic', 'Left the circle and said sorry anyway.'], ['Best Reps', 'Counted every rep and some others.'],\n  ['Biggest Wobble', 'Moved the most, with feeling.'], ['Most Consistent', 'Did the same thing three times.'],\n];\nexport const MEDALS = ['Gold', 'Silver', 'Bronze', 'Participation'];\nEOF\nnode -e \"import('./src/data/charts.js').then(m=>console.log(m.BARS, m.notes().length, m.songLength().toFixed(1)))\"; echo \"- data/*.js written (activities, poses, reps, lines(196), week, questions, unlocks, classmates, charts, boards, medley, about(provisional feedback! finalize at end)). world.js, avatar.js, app.js, base.js, settings/pause/about screens written. NEXT: scenes (front, hub, activities...), index.js registry, build, tests\" >> PROGRESS.md"}},"wire_ingest_context":{"toolu_01MBsmdrvKvzNTqsQmD6fhSZ":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-012138__x6981e3/work/WhyFit-WiiFit-claude-sonnet-5-5-medium-20261105-012138"}}}
