{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjTgyHhsjm2xxrwdyUdX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019ajmTtZd28Wtozm3KCZobD","name":"Bash","input":{"command":"\ncat > src/ui/font.js <<'EOF'\n// Mixed-case text on top of the capitals-only engine font. Lowercase goes through hud.sprite on a 6 px grid.\nconst H = {\na:'00 00 0e 01 0f 11 0f 00 00', b:'10 10 1e 11 11 11 1e 00 00', c:'00 00 0e 11 10 11 0e 00 00', d:'01 01 0f 11 11 11 0f 00 00',\ne:'00 00 0e 11 1f 10 0e 00 00', f:'06 09 08 1c 08 08 08 00 00', g:'00 00 0f 11 11 11 0f 01 0e', h:'10 10 1e 11 11 11 11 00 00',\ni:'04 00 0c 04 04 04 0e 00 00', j:'02 00 06 02 02 02 02 12 0c', k:'10 10 12 14 18 14 12 00 00', l:'0c 04 04 04 04 04 0e 00 00',\nm:'00 00 1a 15 15 15 15 00 00', n:'00 00 1e 11 11 11 11 00 00', o:'00 00 0e 11 11 11 0e 00 00', p:'00 00 1e 11 11 11 1e 10 10',\nq:'00 00 0f 11 11 11 0f 01 01', r:'00 00 16 19 10 10 10 00 00', s:'00 00 0f 10 0e 01 1e 00 00', t:'08 08 1c 08 08 09 06 00 00',\nu:'00 00 11 11 11 13 0d 00 00', v:'00 00 11 11 11 0a 04 00 00', w:'00 00 11 11 15 15 0a 00 00', x:'00 00 11 0a 04 0a 11 00 00',\ny:'00 00 11 11 11 11 0f 01 0e', z:'00 00 1f 02 04 08 1f 00 00' };\nexport const GLYPHS = Object.fromEntries(Object.entries(H).map(([k, v]) => [k, v.split(' ').map((h) => parseInt(h, 16).toString(2).padStart(5, '0').replace(/0/g, '.').replace(/1/g, 'o'))]));\nconst UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .,:;!?\\'\"-+=/()[]%_<>#*@&|~^$';\nexport const SUPPORTED = new Set([...UPPER, ...Object.keys(GLYPHS)]);\nexport const hasGlyph = (ch) => SUPPORTED.has(ch);\nexport function clean(text) { let o = ''; for (const ch of String(text)) o += SUPPORTED.has(ch) ? ch : (ch === '\\n' ? '\\n' : '?'); return o; }\nexport const widthOf = (text, scale = 1) => text.length * 6 * scale;\nexport function say(hud, x, y, text, { color = 'white', shadow = 'ink', scale = 1, anchor = 'tl' } = {}) {\n  text = clean(text);\n  if (anchor === 'c') x -= Math.floor(widthOf(text, scale) / 2) - 1; else if (anchor === 'r') x -= widthOf(text, scale) - scale;\n  for (const ch of text) {\n    const g = GLYPHS[ch];\n    if (g) hud.sprite(x, y, g, { o: color }, { scale, shadow });\n    else if (ch !== ' ') hud.text(x, y, ch, { color, shadow, scale });\n    x += 6 * scale;\n  }\n  return x;\n}\n/** Word-wrap to a pixel width; returns lines. */\nexport function wrap(text, maxW, scale = 1) {\n  const per = Math.max(1, Math.floor(maxW / (6 * scale)));\n  const lines = [];\n  for (const para of clean(text).split('\\n')) {\n    let cur = '';\n    for (const w of para.split(' ')) {\n      if (!cur) cur = w; else if ((cur + ' ' + w).length <= per) cur += ' ' + w; else { lines.push(cur); cur = w; }\n    }\n    lines.push(cur);\n  }\n  return lines;\n}\nexport function sayWrapped(hud, x, y, text, maxW, opts = {}) {\n  const sc = opts.scale ?? 1, ls = opts.lineGap ?? (9 * sc);\n  const lines = wrap(text, maxW, sc);\n  lines.forEach((l, i) => say(hud, x, y + i * ls, l, opts));\n  return lines.length * ls;\n}\nEOF\ncat > src/art/glyphs.js <<'EOF'\n// Button glyph sprites, drawn by code: PlayStation shapes, Xbox letters, keycaps, a mouse.\nimport { say, widthOf } from '../ui/font.js';\nconst SYM = {\n  cross: ['o.....o', '.o...o.', '..o.o..', '...o...', '..o.o..', '.o...o.', 'o.....o'],\n  circle: ['..ooo..', '.o...o.', 'o.....o', 'o.....o', 'o.....o', '.o...o.', '..ooo..'],\n  square: ['ooooooo', 'o.....o', 'o.....o', 'o.....o', 'o.....o', 'o.....o', 'ooooooo'],\n  triangle: ['...o...', '..o.o..', '..o.o..', '.o...o.', '.o...o.', 'ooooooo', '.......'],\n};\nconst disc = (r) => { const rows = []; for (let y = -r; y <= r; y++) { let s = ''; for (let x = -r; x <= r; x++) s += x * x + y * y <= r * r + r * 0.6 ? 'b' : '.'; rows.push(s); } return rows; };\nconst DISC = disc(6);\nconst PS_COL = { cross: 'blue', circle: 'red', square: 'plum', triangle: 'green' };\nconst XB_COL = { A: 'green', B: 'red', X: 'blue', Y: 'sand' };\nexport function drawDisc(hud, x, y, body, label, symbol, symColor = 'white') {\n  hud.sprite(x, y, DISC, { b: body, '.': 'ink' }, { shadow: false });\n  hud.sprite(x, y, DISC.map((r) => r.replace(/b/g, 'b')), { b: body }, { shadow: false });\n  if (symbol) hud.sprite(x + 3, y + 3, SYM[symbol], { o: symColor }, { shadow: false });\n  else if (label) say(hud, x + 3, y + 3, label, { color: symColor, shadow: false });\n  return 13;\n}\nfunction cap(hud, x, y, label, color = 'mist', ink = 'ink') {\n  const w = Math.max(11, widthOf(label) + 5);\n  hud.rect(x, y + 1, w, 12, 'ink'); hud.rect(x + 1, y, w - 2, 12, color);\n  say(hud, x + 3, y + 2, label, { color: ink, shadow: false });\n  return w;\n}\nfunction pill(hud, x, y, label, hi = false) {\n  const w = widthOf(label) + 5;\n  hud.rect(x, y + 2, w, 9, 'ink'); hud.rect(x + 1, y + 1, w - 2, 10, hi ? 'sky' : 'slate');\n  say(hud, x + 3, y + 2, label, { color: 'white', shadow: false });\n  return w;\n}\nconst MOUSE = ['.ooooooo.', 'ollolrrro', 'ollolrrro', 'ollolrrro', 'olllolrro'.replace('o', 'o'), 'ooooooooo', 'ommmmmmmo', 'ommmmmmmo', '.ooooooo.'];\nfunction mouse(hud, x, y, btn) {\n  const rows = ['.ooooooo.', 'o...o...o', 'o...o...o', 'o...o...o', 'ooooooooo', 'o.......o', 'o.......o', '.o.....o.', '..ooooo..'];\n  hud.sprite(x, y, rows, { o: 'mist' }, { shadow: false });\n  if (btn === 'left') hud.rect(x + 1, y + 1, 3, 3, 'orange');\n  if (btn === 'right') hud.rect(x + 5, y + 1, 3, 3, 'orange');\n  return 11;\n}\n/** Draw one glyph by device set: 'ps' | 'xbox' | 'kb' | 'mouse'. name: cross|circle|square|triangle|L1|R1|L2|R2|options|stick|dpad|key:<label>|mouse:left|mouse:right|mouse */\nexport function glyph(hud, set, name, x, y) {\n  if (name.startsWith('key:')) return cap(hud, x, y, name.slice(4));\n  if (name.startsWith('mouse')) return mouse(hud, x, y, name.split(':')[1]);\n  if (set === 'ps' || set === 'xbox') {\n    const xb = set === 'xbox';\n    const map = { cross: 'A', circle: 'B', square: 'X', triangle: 'Y' };\n    if (map[name]) return xb ? drawDisc(hud, x, y, XB_COL[map[name]], map[name], null, 'ink') : drawDisc(hud, x, y, 'mist', null, name, PS_COL[name]);\n    if (name === 'options') return xb ? pill(hud, x, y, 'MENU') : pill(hud, x, y, 'OPTIONS');\n    if (name === 'stick') return drawDisc(hud, x, y, 'slate', 'LS', null, 'white');\n    if (name === 'dpad') return pill(hud, x, y, 'D-PAD');\n    const L = { L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT' };\n    return pill(hud, x, y, xb ? L[name] ?? name : name, true);\n  }\n  return cap(hud, x, y, name);\n}\nexport const GLYPH_MAP = {\n  confirm: { pad: 'cross', kb: 'key:Enter', mouse: 'mouse:left' },\n  back: { pad: 'circle', kb: 'key:Esc', mouse: 'mouse:right' },\n  pause: { pad: 'options', kb: 'key:Esc', mouse: 'key:Esc' },\n  tabs: { pad: 'L1', kb: 'key:Q', mouse: 'mouse' },\n  tabsR: { pad: 'R1', kb: 'key:E', mouse: 'mouse' },\n  move: { pad: 'stick', kb: 'key:WASD', mouse: 'mouse' },\n  lean: { pad: 'stick', kb: 'key:WASD', mouse: 'mouse' },\n  breath: { pad: 'R2', kb: 'key:Space', mouse: 'mouse:left' },\n  footL: { pad: 'L1', kb: 'key:F', mouse: 'mouse:left' },\n  footR: { pad: 'R1', kb: 'key:J', mouse: 'mouse:right' },\n  jump: { pad: 'cross', kb: 'key:Space', mouse: 'mouse:left' },\n  wave: { pad: 'triangle', kb: 'key:V', mouse: 'key:V' },\n  sit: { pad: 'square', kb: 'key:B', mouse: 'key:B' },\n  ready: { pad: 'cross', kb: 'key:Enter', mouse: 'mouse:left' },\n  more: { pad: 'triangle', kb: 'key:M', mouse: 'key:M' },\n  select: { pad: 'stick', kb: 'key:Arrows', mouse: 'mouse' },\n};\n/** Draw \"[glyph] verb\" prompts in a row; returns end x. set: 'ps'|'xbox'|'kb'|'mouse'. */\nexport function promptRow(hud, set, items, x, y, opts = {}) {\n  const dev = set === 'ps' || set === 'xbox' ? 'pad' : set;\n  for (const [act, verb] of items) {\n    const g = GLYPH_MAP[act]?.[dev] ?? act;\n    x += glyph(hud, set, g, x, y) + 3;\n    x = say(hud, x, y + 3, verb, { color: opts.color ?? 'white' }) + 9;\n  }\n  return x;\n}\nexport function promptWidth(set, items) {\n  const dev = set === 'ps' || set === 'xbox' ? 'pad' : set;\n  let w = 0;\n  for (const [act, verb] of items) {\n    const g = GLYPH_MAP[act]?.[dev] ?? act;\n    const gw = g.startsWith('key:') ? Math.max(11, widthOf(g.slice(4)) + 5) : g.startsWith('mouse') ? 11 : (set === 'ps' || set === 'xbox') && /^(cross|circle|square|triangle|stick)$/.test(g) ? 13 : widthOf(set === 'xbox' ? ({ L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', options: 'MENU' }[g] ?? g) : g.toUpperCase()) + 5;\n    w += gw + 3 + widthOf(verb) + 9;\n  }\n  return w;\n}\nEOF\necho done"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":333,"cache_read_input_tokens":147385,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":333},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d022da92-c114-4f47-a8f5-ca68c59e3f52","uuid":"63497b3f-c028-4126-b19e-545fe270c17a","timestamp":"2026-11-05T08:25:25.008Z","request_id":"req_011CgjTgy35SBxm9R4beMiQe","wire_tool_inputs":{"toolu_019ajmTtZd28Wtozm3KCZobD":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-012138__x6981e3/work/WhyFit-WiiFit-claude-sonnet-5-5-medium-20261105-012138 && \ncat > src/ui/font.js <<'EOF'\n// Mixed-case text on top of the capitals-only engine font. Lowercase goes through hud.sprite on a 6 px grid.\nconst H = {\na:'00 00 0e 01 0f 11 0f 00 00', b:'10 10 1e 11 11 11 1e 00 00', c:'00 00 0e 11 10 11 0e 00 00', d:'01 01 0f 11 11 11 0f 00 00',\ne:'00 00 0e 11 1f 10 0e 00 00', f:'06 09 08 1c 08 08 08 00 00', g:'00 00 0f 11 11 11 0f 01 0e', h:'10 10 1e 11 11 11 11 00 00',\ni:'04 00 0c 04 04 04 0e 00 00', j:'02 00 06 02 02 02 02 12 0c', k:'10 10 12 14 18 14 12 00 00', l:'0c 04 04 04 04 04 0e 00 00',\nm:'00 00 1a 15 15 15 15 00 00', n:'00 00 1e 11 11 11 11 00 00', o:'00 00 0e 11 11 11 0e 00 00', p:'00 00 1e 11 11 11 1e 10 10',\nq:'00 00 0f 11 11 11 0f 01 01', r:'00 00 16 19 10 10 10 00 00', s:'00 00 0f 10 0e 01 1e 00 00', t:'08 08 1c 08 08 09 06 00 00',\nu:'00 00 11 11 11 13 0d 00 00', v:'00 00 11 11 11 0a 04 00 00', w:'00 00 11 11 15 15 0a 00 00', x:'00 00 11 0a 04 0a 11 00 00',\ny:'00 00 11 11 11 11 0f 01 0e', z:'00 00 1f 02 04 08 1f 00 00' };\nexport const GLYPHS = Object.fromEntries(Object.entries(H).map(([k, v]) => [k, v.split(' ').map((h) => parseInt(h, 16).toString(2).padStart(5, '0').replace(/0/g, '.').replace(/1/g, 'o'))]));\nconst UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .,:;!?\\'\"-+=/()[]%_<>#*@&|~^$';\nexport const SUPPORTED = new Set([...UPPER, ...Object.keys(GLYPHS)]);\nexport const hasGlyph = (ch) => SUPPORTED.has(ch);\nexport function clean(text) { let o = ''; for (const ch of String(text)) o += SUPPORTED.has(ch) ? ch : (ch === '\\n' ? '\\n' : '?'); return o; }\nexport const widthOf = (text, scale = 1) => text.length * 6 * scale;\nexport function say(hud, x, y, text, { color = 'white', shadow = 'ink', scale = 1, anchor = 'tl' } = {}) {\n  text = clean(text);\n  if (anchor === 'c') x -= Math.floor(widthOf(text, scale) / 2) - 1; else if (anchor === 'r') x -= widthOf(text, scale) - scale;\n  for (const ch of text) {\n    const g = GLYPHS[ch];\n    if (g) hud.sprite(x, y, g, { o: color }, { scale, shadow });\n    else if (ch !== ' ') hud.text(x, y, ch, { color, shadow, scale });\n    x += 6 * scale;\n  }\n  return x;\n}\n/** Word-wrap to a pixel width; returns lines. */\nexport function wrap(text, maxW, scale = 1) {\n  const per = Math.max(1, Math.floor(maxW / (6 * scale)));\n  const lines = [];\n  for (const para of clean(text).split('\\n')) {\n    let cur = '';\n    for (const w of para.split(' ')) {\n      if (!cur) cur = w; else if ((cur + ' ' + w).length <= per) cur += ' ' + w; else { lines.push(cur); cur = w; }\n    }\n    lines.push(cur);\n  }\n  return lines;\n}\nexport function sayWrapped(hud, x, y, text, maxW, opts = {}) {\n  const sc = opts.scale ?? 1, ls = opts.lineGap ?? (9 * sc);\n  const lines = wrap(text, maxW, sc);\n  lines.forEach((l, i) => say(hud, x, y + i * ls, l, opts));\n  return lines.length * ls;\n}\nEOF\ncat > src/art/glyphs.js <<'EOF'\n// Button glyph sprites, drawn by code: PlayStation shapes, Xbox letters, keycaps, a mouse.\nimport { say, widthOf } from '../ui/font.js';\nconst SYM = {\n  cross: ['o.....o', '.o...o.', '..o.o..', '...o...', '..o.o..', '.o...o.', 'o.....o'],\n  circle: ['..ooo..', '.o...o.', 'o.....o', 'o.....o', 'o.....o', '.o...o.', '..ooo..'],\n  square: ['ooooooo', 'o.....o', 'o.....o', 'o.....o', 'o.....o', 'o.....o', 'ooooooo'],\n  triangle: ['...o...', '..o.o..', '..o.o..', '.o...o.', '.o...o.', 'ooooooo', '.......'],\n};\nconst disc = (r) => { const rows = []; for (let y = -r; y <= r; y++) { let s = ''; for (let x = -r; x <= r; x++) s += x * x + y * y <= r * r + r * 0.6 ? 'b' : '.'; rows.push(s); } return rows; };\nconst DISC = disc(6);\nconst PS_COL = { cross: 'blue', circle: 'red', square: 'plum', triangle: 'green' };\nconst XB_COL = { A: 'green', B: 'red', X: 'blue', Y: 'sand' };\nexport function drawDisc(hud, x, y, body, label, symbol, symColor = 'white') {\n  hud.sprite(x, y, DISC, { b: body, '.': 'ink' }, { shadow: false });\n  hud.sprite(x, y, DISC.map((r) => r.replace(/b/g, 'b')), { b: body }, { shadow: false });\n  if (symbol) hud.sprite(x + 3, y + 3, SYM[symbol], { o: symColor }, { shadow: false });\n  else if (label) say(hud, x + 3, y + 3, label, { color: symColor, shadow: false });\n  return 13;\n}\nfunction cap(hud, x, y, label, color = 'mist', ink = 'ink') {\n  const w = Math.max(11, widthOf(label) + 5);\n  hud.rect(x, y + 1, w, 12, 'ink'); hud.rect(x + 1, y, w - 2, 12, color);\n  say(hud, x + 3, y + 2, label, { color: ink, shadow: false });\n  return w;\n}\nfunction pill(hud, x, y, label, hi = false) {\n  const w = widthOf(label) + 5;\n  hud.rect(x, y + 2, w, 9, 'ink'); hud.rect(x + 1, y + 1, w - 2, 10, hi ? 'sky' : 'slate');\n  say(hud, x + 3, y + 2, label, { color: 'white', shadow: false });\n  return w;\n}\nconst MOUSE = ['.ooooooo.', 'ollolrrro', 'ollolrrro', 'ollolrrro', 'olllolrro'.replace('o', 'o'), 'ooooooooo', 'ommmmmmmo', 'ommmmmmmo', '.ooooooo.'];\nfunction mouse(hud, x, y, btn) {\n  const rows = ['.ooooooo.', 'o...o...o', 'o...o...o', 'o...o...o', 'ooooooooo', 'o.......o', 'o.......o', '.o.....o.', '..ooooo..'];\n  hud.sprite(x, y, rows, { o: 'mist' }, { shadow: false });\n  if (btn === 'left') hud.rect(x + 1, y + 1, 3, 3, 'orange');\n  if (btn === 'right') hud.rect(x + 5, y + 1, 3, 3, 'orange');\n  return 11;\n}\n/** Draw one glyph by device set: 'ps' | 'xbox' | 'kb' | 'mouse'. name: cross|circle|square|triangle|L1|R1|L2|R2|options|stick|dpad|key:<label>|mouse:left|mouse:right|mouse */\nexport function glyph(hud, set, name, x, y) {\n  if (name.startsWith('key:')) return cap(hud, x, y, name.slice(4));\n  if (name.startsWith('mouse')) return mouse(hud, x, y, name.split(':')[1]);\n  if (set === 'ps' || set === 'xbox') {\n    const xb = set === 'xbox';\n    const map = { cross: 'A', circle: 'B', square: 'X', triangle: 'Y' };\n    if (map[name]) return xb ? drawDisc(hud, x, y, XB_COL[map[name]], map[name], null, 'ink') : drawDisc(hud, x, y, 'mist', null, name, PS_COL[name]);\n    if (name === 'options') return xb ? pill(hud, x, y, 'MENU') : pill(hud, x, y, 'OPTIONS');\n    if (name === 'stick') return drawDisc(hud, x, y, 'slate', 'LS', null, 'white');\n    if (name === 'dpad') return pill(hud, x, y, 'D-PAD');\n    const L = { L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT' };\n    return pill(hud, x, y, xb ? L[name] ?? name : name, true);\n  }\n  return cap(hud, x, y, name);\n}\nexport const GLYPH_MAP = {\n  confirm: { pad: 'cross', kb: 'key:Enter', mouse: 'mouse:left' },\n  back: { pad: 'circle', kb: 'key:Esc', mouse: 'mouse:right' },\n  pause: { pad: 'options', kb: 'key:Esc', mouse: 'key:Esc' },\n  tabs: { pad: 'L1', kb: 'key:Q', mouse: 'mouse' },\n  tabsR: { pad: 'R1', kb: 'key:E', mouse: 'mouse' },\n  move: { pad: 'stick', kb: 'key:WASD', mouse: 'mouse' },\n  lean: { pad: 'stick', kb: 'key:WASD', mouse: 'mouse' },\n  breath: { pad: 'R2', kb: 'key:Space', mouse: 'mouse:left' },\n  footL: { pad: 'L1', kb: 'key:F', mouse: 'mouse:left' },\n  footR: { pad: 'R1', kb: 'key:J', mouse: 'mouse:right' },\n  jump: { pad: 'cross', kb: 'key:Space', mouse: 'mouse:left' },\n  wave: { pad: 'triangle', kb: 'key:V', mouse: 'key:V' },\n  sit: { pad: 'square', kb: 'key:B', mouse: 'key:B' },\n  ready: { pad: 'cross', kb: 'key:Enter', mouse: 'mouse:left' },\n  more: { pad: 'triangle', kb: 'key:M', mouse: 'key:M' },\n  select: { pad: 'stick', kb: 'key:Arrows', mouse: 'mouse' },\n};\n/** Draw \"[glyph] verb\" prompts in a row; returns end x. set: 'ps'|'xbox'|'kb'|'mouse'. */\nexport function promptRow(hud, set, items, x, y, opts = {}) {\n  const dev = set === 'ps' || set === 'xbox' ? 'pad' : set;\n  for (const [act, verb] of items) {\n    const g = GLYPH_MAP[act]?.[dev] ?? act;\n    x += glyph(hud, set, g, x, y) + 3;\n    x = say(hud, x, y + 3, verb, { color: opts.color ?? 'white' }) + 9;\n  }\n  return x;\n}\nexport function promptWidth(set, items) {\n  const dev = set === 'ps' || set === 'xbox' ? 'pad' : set;\n  let w = 0;\n  for (const [act, verb] of items) {\n    const g = GLYPH_MAP[act]?.[dev] ?? act;\n    const gw = g.startsWith('key:') ? Math.max(11, widthOf(g.slice(4)) + 5) : g.startsWith('mouse') ? 11 : (set === 'ps' || set === 'xbox') && /^(cross|circle|square|triangle|stick)$/.test(g) ? 13 : widthOf(set === 'xbox' ? ({ L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', options: 'MENU' }[g] ?? g) : g.toUpperCase()) + 5;\n    w += gw + 3 + widthOf(verb) + 9;\n  }\n  return w;\n}\nEOF\necho done"}},"wire_ingest_context":{"toolu_019ajmTtZd28Wtozm3KCZobD":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-012138__x6981e3/work/WhyFit-WiiFit-claude-sonnet-5-5-med