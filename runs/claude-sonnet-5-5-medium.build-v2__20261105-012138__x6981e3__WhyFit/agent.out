 offset', 'stepOffset', -200, 200, 5, (v) => v + ' ms'),\n      ], { w: 300, rowH: 18, name: 'settings-a', y: 52, ...opt }),\n      new Menu([\n        { label: 'Gentle Mode', kind: 'toggle', get: () => s.gentle, set: set('gentle'), hint: 'Rings are larger. Noise is smaller. Ounce is the same.' },\n        { label: 'Reduce flashes', kind: 'toggle', get: () => s.reduceFlashes, set: set('reduceFlashes') },\n        { label: 'Look', kind: 'choice', options: ['Default', 'Storybook', 'Arcade', 'Handheld'], get: () => s.look, set: set('look') },\n        { label: 'Pixel size', kind: 'choice', options: ['Auto', '1', '2', '3'], get: () => s.pixelSize, set: set('pixelSize') },\n        { label: 'Fullscreen', kind: 'toggle', get: () => !!(typeof document !== 'undefined' && document.fullscreenElement), set: (v) => { try { if (v) document.documentElement.requestFullscreen?.(); else document.exitFullscreen?.(); } catch { /* */ } app.setSetting('fullscreen', v); } },\n        { label: 'Reset to defaults', onSelect: () => { app.resetSettings(); app.sfx('back'); } },\n      ], { w: 300, rowH: 18, name: 'settings-b', y: 52, hint: true, ...opt }),\n    ];\n  }\n  update(nav) {\n    this.tabs.update(nav);\n    this.menus[this.tabs.i].update(nav);\n    if (nav.back || nav.rclick || nav.pause) { this.app.sfx('back'); this.scene.pop(); this.onDone?.(); }\n  }\n  draw(hud) {\n    say(hud, hud.width / 2, 12, 'Settings', { anchor: 'c', scale: 3, color: 'white', shadow: 'navy' });\n    this.tabs.draw(hud, Math.floor((hud.width - 300) / 2), 36, 300);\n    const m = this.menus[this.tabs.i]; m.o.x = Math.floor((hud.width - 300) / 2);\n    m.draw(hud);\n    drawPrompts(this.app, hud, [['tabs', 'Tab'], ['select', 'Change'], ['back', 'Back']]);\n  }\n}\nEOF\ncat > src/ui/screens/pause.js <<'EOF'\n// Pause menu. engine.timeScale = 0 freezes physics, fixedUpdate and game time; update still runs.\nimport { Menu } from '../widgets.js';\nimport { SettingsScreen } from './settings.js';\nimport { drawPrompts } from '../prompts.js';\nimport { say, sayWrapped } from '../font.js';\nimport { panel } from '../widgets.js';\n\nexport class HowToPlay {\n  id = 'howto'; blocks = true; pauses = true;\n  constructor(app, text) { this.app = app; this.text = text; }\n  update(nav) { if (nav.back || nav.confirm || nav.click || nav.rclick || nav.pause) { this.app.sfx('back'); this.scene.pop(); } }\n  draw(hud) {\n    const w = 300, x = (hud.width - w) / 2, y = 40;\n    panel(hud, x, y, w, 150);\n    say(hud, x + 10, y + 8, 'How to play', { color: 'teal', shadow: false, scale: 2 });\n    sayWrapped(hud, x + 10, y + 32, this.text, w - 20, { color: 'ink', shadow: false, lineGap: 11 });\n    drawPrompts(this.app, hud, [['back', 'Back']]);\n  }\n}\nexport class PauseMenu {\n  id = 'pause'; blocks = true; pauses = true;\n  constructor(app, { restart = null, island = null, dev = null, howto = '' } = {}) {\n    this.app = app;\n    const inSession = !!app.session;\n    const items = [{ label: 'Resume', onSelect: () => this.scene.pop() }];\n    if (!inSession) {\n      if (restart) items.push({ label: 'Restart activity', onSelect: () => { this.scene.pop(); restart(); } });\n      if (island) items.push({ label: 'Back to the island', onSelect: () => { this.scene.pop(); island(); } });\n      items.push({ label: 'How to play', onSelect: () => this.scene.push(new HowToPlay(app, howto)) });\n    }\n    items.push({ label: 'Settings', onSelect: () => this.scene.push(new SettingsScreen(app)) });\n    if (!inSession) {\n      items.push({ label: 'About and Credits', onSelect: () => dev?.about?.() });\n      items.push({ label: 'Dev Tools', onSelect: () => dev?.open?.() });\n    }\n    this.menu = new Menu(items, { w: 200, rowH: 17, title: 'Paused', name: 'pause', onMove: () => app.sfx('move', { volume: 0.4 }), onChange: () => app.sfx('confirm', { volume: 0.5 }) });\n  }\n  update(nav) { this.menu.update(nav); if (nav.pause || nav.back || nav.rclick) { this.app.sfx('back'); this.scene.pop(); } }\n  draw(hud) { this.menu.draw(hud); drawPrompts(this.app, hud, [['confirm', 'Select'], ['back', 'Resume']]); }\n}\nEOF\necho ok"}},"wire_ingest_context":{"toolu_01Da9vasbVXFPVYNVbLu3nyG":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-012138__x6981e3/work/WhyFit-WiiFit-claude-sonnet-5-5-medium-20261105-012138"}}}
