he is still.',\n      autoplay: 'AUTOPLAY  -  press any key to take control',\n      sold: 'SOLD'\n    },\n\n    results: {\n      title: 'SHIFT COMPLETE',\n      cash: 'Cash earned',\n      purity: 'Batch purity',\n      heat: 'Peak heat',\n      time: 'Time',\n      back: 'Press confirm for the title'\n    }\n  };\n\n  root.HB = HB;\n})(typeof globalThis !== 'undefined' ? globalThis : this);\n"}}}
