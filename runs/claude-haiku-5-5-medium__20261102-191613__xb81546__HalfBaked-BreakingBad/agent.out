ge(i, b)) pressed = true;\n    }\n    return pressed;\n  }\n\n  function gamepadEdge(index, button) {\"\"\")\nrep(\"\"\"  function attractExit() {\n    if (game.input.anyPressed()) {\"\"\",\"\"\"  function attractExit() {\n    if (anyInputSince()) {\"\"\")\nrep(\"\"\"    if (game.input.anyPressed()) idle = 0; else idle += dt;\"\"\",\"\"\"    if (anyInputSince()) idle = 0; else idle += dt;\"\"\")\nrep(\"\"\"      if (game.input.anyPressed()) return game.go('title', {});\"\"\",\"\"\"      if (anyInputSince()) return game.go('title', {});\"\"\")\nrep(\"\"\"  function startAttract() {\n    S = freshShift(777);\"\"\",\"\"\"  function startAttract() {\n    anyInputSince(); // forget the input that came before: only new input leaves the attract run\n    S = freshShift(777);\"\"\")\nopen(p,'w').write(s)\nprint('ok')\nEOF\nnode --check src/game.js && echo OK && grep -n \"anyPressed\" src/game.js","description":"Use any-key/click/pad detection for attract exit and idle timer"}},"wire_ingest_context":{"toolu_01YDoNgY6vfh68pFiz4A2bUr":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191613__xb81546/work/HalfBaked-BreakingBad-claude-haiku-5-5-medium-20261102-191613"}}}
