> ({ spec: _moveSpecs[name] || (_moveSpecs[name] = Object.assign({ name, wind: .06, active: .1, recover: .18 }, E.MOVES[name] || E.MOVES.slash)), phase, u });","is_error":false}]},"parent_tool_use_id":null,"session_id":"28d8cdd1-64ac-4caf-98dc-e01333dcd3b0","uuid":"09f3973e-fd83-433a-b4ab-6d04bb7b80db","timestamp":"2026-11-04T12:16:16.977Z","tool_use_result":{"stdout":"overhead {\"rel\":true,\"plane\":\"side\",\"a0\":2.4,\"a1\":-1.25,\"reach\":7,\"wind\":0.16,\"active\":0.09,\"recover\":0.26,\"lunge\":2,\"crouch\":0.35,\"lean\":0.4}\nspin {\"rel\":true,\"a0\":1.3,\"a1\":1.3,\"spin\":true,\"z0\":-6,\"z1\":-6,\"reach\":8,\"wind\":0.09,\"active\":0.3,\"recover\":0.18,\"lunge\":0,\"lean\":0.1}\nthrust {\"rel\":true,\"a0\":0.12,\"a1\":0,\"z0\":-5,\"z1\":-4,\"r0\":3,\"r1\":10,\"wind\":0.11,\"active\":0.07,\"recover\":0.22,\"lunge\":3,\"lean\":0.5}\nbash {\"rel\":true,\"hand\":\"both\",\"plane\":\"side\",\"a0\":1,\"a1\":-0.35,\"reach\":5,\"wind\":0.12,\"active\":0.07,\"recover\":0.24,\"lunge\":3,\"hop\":1.2,\"crouch\":0.45,\"lean\":0.55,\"blade\":0}\njab {\"rel\":true,\"hand\":\"L\",\"a0\":0.05,\"a1\":0,\"z0\":-1,\"z1\":-0.5,\"r0\":3,\"r1\":8.6,\"wind\":0.035,\"active\":0.06,\"recover\":0.13,\"lunge\":0.9,\"lean\":0.22,\"blade\":0}\ncross {\"rel\":true,\"a0\":0.25,\"a1\":0,\"z0\":-1,\"z1\":-0.5,\"r0\":2.5,\"r1\":8.8,\"wind\":0.06,\"active\":0.07,\"recover\":0.17,\"lunge\":1.8,\"lean\":0.38,\"twist\":1.8,\"blade\":0}\nthrow {\"rel\":true,\"plane\":\"side\",\"a0\":2.5,\"a1\":-0.25,\"reach\":7.5,\"wind\":0.16,\"active\":0.08,\"recover\":0.24,\"lunge\":1.8,\"lean\":0.45,\"blade\":0}\ncast {\"rel\":true,\"hand\":\"both\",\"plane\":\"side\",\"a0\":1.4,\"a1\":0.1,\"reach\":8,\"wind\":0.22,\"active\":0.12,\"recover\":0.32,\"lunge\":0.6,\"lean\":0.15,\"blade\":0}\n{\"spec\":{\"name\":\"throw\",\"wind\":0.16,\"active\":0.08,\"recover\":0.24,\"rel\":true,\"plane\":\"side\",\"a0\":2.5,\"a1\":-0.25,\"reach\":7.5,\"lunge\":1.8,\"lean\":0.45,\"blade\":0},\"phase\":\"active\",\"u\":0.5}\n