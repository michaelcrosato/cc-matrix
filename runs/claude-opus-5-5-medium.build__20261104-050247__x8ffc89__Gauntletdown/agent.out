lace(\"\"\"    const pts = 25 * Math.max(1, Math.ceil(genMaxHp(g.rank) / (4 * TUNE.generatorHp)));\n    if (by && by.pi !== undefined) { addScore(by, 25 * 3 > pts ? pts : pts, g); by.stats.gens++; }\"\"\",\"\"\"    const pts = 25 * (g.rank0 || 1);\n    if (by && by.pi !== undefined) { addScore(by, pts, g); by.stats.gens++; }\"\"\")\ns=s.replace(\"  for (const g of w.gens) g.hp = genMaxHp(g.rank);\",\"  for (const g of w.gens) { g.hp = genMaxHp(g.rank); g.rank0 = g.rank; }\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"rank0\" 21-world.js","description":"Fix generator score to use starting rank"}}}
