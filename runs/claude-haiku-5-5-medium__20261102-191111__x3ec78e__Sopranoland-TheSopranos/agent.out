stol line\n{\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5);\n  for (let i = 0; i < 300 && (snap().talk || snap().conv); i++) { if (snap().talk) { game.input.tap('confirm'); game.advance(.4); } else game.advance(.2); }\n  dbg.chapter(4); const yard = dbg.world().map.center(37, 30); dbg.teleport(yard[0], yard[1]); run(game, .5);\n  for (let i = 0; i < 300 && (snap().talk || snap().conv); i++) { if (snap().talk) { game.input.tap('confirm'); game.advance(.4); } else game.advance(.2); }\n  const w = dbg.world(), hero = w.hero;\n  const f2 = w.foes.find(f => !f.dead && f.kind === 'crew');\n  f2.x = hero.x + 70; f2.y = hero.y; f2.vx = f2.vy = 0; f2.alert = 0; f2.hp = 60; hero.facing = 0;\n  console.log('hero', hero.x, hero.y, 'foe', f2.x, f2.y, 'ammo', snap().ammo, 'talk', snap().talk, 'conv', snap().conv);\n  game.input.tap('use'); run(game, .1);\n  console.log('after 0.1: shots', w.shots.list.map(b => [Math.round(b.x), Math.round(b.y), b.team, b.dmg]), 'ammo', snap().ammo);\n  for (let k = 0; k < 6; k++) { run(game, .1); console.log(' t', k, 'shots', w.shots.list.map(b => [Math.round(b.x), Math.round(b.y)]), 'foe hp', f2.hp, 'others', w.foes.filter(f=>!f.dead).map(f=>[Math.round(f.x),Math.round(f.y),f.hp]).slice(0,5)); }\n  console.log('errors', game.errors.map(e => e.message));\n}\nEOF\nnode /tmp/exp/trace2.mjs 2>&1 | head -60","description":"Trace Big Lou choices and pistol shot path"}}}
