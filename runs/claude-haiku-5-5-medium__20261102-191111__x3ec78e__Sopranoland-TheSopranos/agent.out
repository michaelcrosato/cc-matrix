{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCBVHQQzcmYTAwsksjq","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14893,"cache_read_input_tokens":172167,"cache_creation":{"ephemeral_5m_input_tokens":14893,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ceb3ee4-d05b-48df-8167-856a2d7758be","uuid":"8d8f098b-2c66-4a88-bacd-890632266087","timestamp":"2026-11-03T02:19:25.915Z","request_id":"req_011CgfCBUvZhrysTD8E8hQKG","thinking_duration_ms":20331,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCBVHQQzcmYTAwsksjq","type":"message","role":"assistant","content":[{"type":"text","text":"The world module has several problems: a leftover ternary in `hurtHero`, a misread stress formula, a non-existent `victory` sound, and Vashti's NPC placed inside a wall. Stick inversion also doesn't reach the Mover, which reads `move()` on its own. I'll rewrite the module cleanly rather than patch it piece by piece."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14893,"cache_read_input_tokens":172167,"cache_creation":{"ephemeral_5m_input_tokens":14893,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ceb3ee4-d05b-48df-8167-856a2d7758be","uuid":"f4b1bc21-337e-49ba-afcb-4b52d5717ff9","timestamp":"2026-11-03T02:19:26.494Z","request_id":"req_011CgfCBUvZhrysTD8E8hQKG"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCBVHQQzcmYTAwsksjq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SFia3G8u8yiUrDyLB8gDKP","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191111__x3ec78e/work/Sopranoland-TheSopranos-claude-haiku-5-5-medium-20261102-191111/src/game/04-world.js","content":"// ---------------------------------------------------------------------------------------------\n// 04 · WORLD — the town and the story's rules: the hero's walk, bat, pistol and dodge; the\n// people and their fights; the pickups; the chapters and the interactions. The world is built\n// once a run starts. A death rebuilds the chapter's fights at its checkpoint. Input comes from\n// game.input or, in the attract mode, from the AI pad (08); the hub's ghosts are drawn by 09.\n// ---------------------------------------------------------------------------------------------\nconst SPR = {\n  duck: E.sprite(['..yy....', '.yYYy...', 'yYYYYyy.', 'yYYYYYYy', '.yyyyyy.', '..yyyy..'], { y: '#f2d24a', Y: '#fff2a0' }, 2),\n  cannoli: E.sprite(['..ww..', '.wWWw.', 'wWsWWw', '.wWWw.', '..ww..'], { w: '#e8c890', W: '#f6e6c0', s: '#b07840' }, 2),\n  ammo: E.sprite(['.bb.', 'bBBb', 'bBBb', '.bb.'], { b: '#8a6a2a', B: '#d8a84a' }, 2),\n};\n\nlet W = null;   // the live world (map, hero, people, pickups, flags). Set by buildWorld().\n\nconst clamp = (v, a, b) => Math.max(a, Math.min(b, v));\nconst angleDiff = (a, b) => Math.abs(Math.atan2(Math.sin(a - b), Math.cos(a - b)));\nconst centerOf = cell => W.map.center(cell[0], cell[1]);\nconst sfx = (name, o) => game.audio.sfx(name, o);\n\nfunction buildWorld() {\n  const floorTex = (x, y, tag) => tag === 'grass' ? E.tex.grass(x, y)\n    : tag === 'road' || tag === 'yard' ? E.tex.dirt(x, y)\n    : tag === 'water' ? E.tex.water(x, y) : E.tex.flagstone(x, y);\n  const map = new E.TileMap({ rows: buildTownRows(), legend: TOWN_LEGEND, types: TOWN_TYPES, floorTex });\n  for (const [id, x, y, o] of DRESS) map.solid(id, x * 16 + 8, y * 16 + 8, 0, o);\n  W = {\n    map, flow: new E.FlowField(map), flowT: 0,\n    hero: null, heroRig: makeHeroRig(), shots: new E.Bullets(game, { plane: 'ground', max: 240, sparks: true }),\n    foes: [], boss: null, combo: null, shotCool: 0, panicT: 0, yardOn: false, feds: 0, fedT: 4,\n    toast: null, toastT: 0, ctl: game.input, aim: null, frozen: false,\n    npcs: {}, ducks: [], cannoli: [], ammo: [], civs: [],\n  };\n  W.hero = makeHero(centerOf(START_CELL));\n  W.hero.iframes = 0;\n  // the people who talk: each has a rig and a place. Vashti is in the session room, not on the street.\n  for (const k of Object.keys(NPC_DEFS)) {\n    if (k === 'vashti') continue;\n    const d = NPC_DEFS[k], p = centerOf(d.cell);\n    W.npcs[k] = { key: k, def: d, x: p.x, y: p.y, rig: makeNPCRig(d) };\n  }\n  W.ducks = DUCKS.map(c => Object.assign(centerOf(c), { taken: false }));\n  W.cannoli = CANNOLI.map(c => Object.assign(centerOf(c), { taken: false }));\n  W.ammo = AMMO.map(c => Object.assign(centerOf(c), { taken: false }));\n  for (const c of CIVILIANS) { const p = centerOf(c); W.civs.push(new Foe('civ', LOOKS.civ, p)); }\n  W.foes.push(...W.civs);\n  W.combo = newCombo();\n  return W;\n}\nfunction newCombo() { return new E.Combo(['backslash', 'overhead', 'thrust'], { window: .4 }); }\n\n// The hero's own controls: the stick through the player's inversions, the buttons from game.input.\nconst PLAYER_MOVE = Object.create(game.input, { move: { value: () => stickMove(game.input) } });\n\n// Put the hero at the chapter's checkpoint, and the chapter's fights back in place.\nfunction setChapter(n, o = {}) {\n  S.chapter = n;\n  const p = centerOf(CHECKPOINT[n]);\n  Object.assign(W.hero, { x: p.x, y: p.y, vx: 0, vy: 0, z: 0, onGround: true, wall: null, action: null });\n  W.hero.lastSafe = { x: p.x, y: p.y, z: 0 };\n  W.foes = W.civs.slice();\n  W.boss = null; W.yardOn = false; W.feds = 0; W.fedT = 4;\n  W.combo = newCombo();\n  if (n === 5) S.heat = Math.max(S.heat, 80);\n  if (!o.quiet) toast(CHAPTERS[n].title + '  ·  ' + CHAPTERS[n].goal);\n}\nfunction toast(text) { W.toast = text; W.toastT = 4.5; }\n\nfunction spawnFoe(kind, look, cell, o = {}) {\n  const f = new Foe(kind, look, centerOf(cell), o);\n  W.foes.push(f);\n  return f;\n}\nfunction spawnYard() {\n  spawnFoe('crew', LOOKS.benny, [36, 28], { name: 'BENNY' });\n  spawnFoe('crew', LOOKS.richie, [39, 33], { name: 'RICHIE' });\n  spawnFoe('crew', LOOKS.frankie, [35, 34], { name: 'FRANKIE' });\n  W.boss = spawnFoe('boss', LOOKS.gus, [38, 30], { name: 'GUS' });\n  W.yardOn = true;\n}\nfunction spawnFed() {\n  const west = Math.random() < .5;\n  const f = spawnFoe('fed', LOOKS.fed, west ? [1, 19] : [58, 20], { name: 'AGENT' });\n  f.alert = 4; W.feds++;\n  return f;\n}\n\n// ---- the hero's life -------------------------------------------------------------------------\nfunction hurtHero(n) {\n  const hero = W.hero;\n  if (hero.iframes > 0 || S.done) return;\n  const guard = !!W.ctl.down('block');\n  const dmg = n * (guard ? .3 : 1);\n  S.hp = Math.max(0, S.hp - dmg);\n  S.stress = Math.min(100, S.stress + n * .4);\n  hero.iframes = .5;\n  game.shake(3 + n / 4);\n  game.hitFx(hero.x, hero.y, hero.z + 18, { power: .6, damage: Math.round(dmg), sound: guard ? 'select' : 'hurt' });\n  if (S.hp <= 0) heroDown();\n}\n\nfunction heroDown() {\n  S.deaths++;\n  S.stress = Math.min(100, S.stress + 20);\n  S.hp = 70;\n  setChapter(S.chapter, { quiet: true });\n  game.flash('#000000', .4, .8);\n  startConv('downed', null);\n}\n\nfunction hurtFoe(f, n, how) {\n  if (f.dead) return;\n  f.takeHit(n, W.hero);\n  E.knockback(W.hero, f, how === 'shot' ? 40 : 90);\n  game.hitFx(f.x, f.y, f.z + 18, { power: how === 'shot' ? .8 : 1, damage: Math.round(n), sound: how === 'shot' ? 'hit' : 'punch' });\n  if (f.kind === 'civ') {\n    S.heat = Math.min(100, S.heat + 12);\n    for (const o of W.civs) o.flee = 6;\n    sfx('hurt');\n  }\n  if (f.boss && !f.phase2 && f.hp < f.maxHp / 2) { f.phase2 = true; toast('GUS IS MAD NOW'); }\n  if (f.dead) {\n    if (f.kind !== 'civ') S.kills++;\n    sfx('die');\n    if (f.kind === 'fed') W.feds = Math.max(0, W.feds - 1);\n    if (f.boss) bossDown();\n  }\n}\n\nfunction bossDown() {\n  if (S.bossDown) return;\n  S.bossDown = true;\n  toast('GUS IS DOWN. THE FEDS ARE COMING.');\n  if (S.chapter === 4) {\n    setChapter(5, { quiet: true });\n    toast(CHAPTERS[5].title + '  ·  ' + CHAPTERS[5].goal);\n    startConv('feds', null);\n  }\n}\n\n// a Fed that sees the hero makes the heat rise\nfunction spotted(f, dt) {\n  if (f.kind === 'fed') S.heat = Math.min(100, S.heat + 6 * dt);\n}\nfunction anyFedSees() { return W.foes.some(f => !f.dead && f.kind === 'fed' && f.alert > 0); }\n\n// ---- the step --------------------------------------------------------------------------------\n// ctl: the buttons to read (game.input, or the AI pad). walk: the Mover's controls (PLAYER_MOVE, or the AI's intent).\nfunction worldStep(dt, ctl, walk) {\n  W.ctl = ctl;\n  const hero = W.hero, map = W.map;\n  S.playTime += dt;\n  if (W.toastT > 0) { W.toastT -= dt; if (W.toastT <= 0) W.toast = null; }\n  hero.iframes = Math.max(0, hero.iframes - dt);\n  const frozen = W.frozen;\n  // walking, jumping and climbing: the Mover keeps out of the walls and up the small ledges\n  if (!frozen) {\n    hero.update(dt, map, walk);\n    if (walk === PLAYER_MOVE && ctl.pressed('dodge')) hero.dodge();\n  }\n  // the bat: a combo, one press a swing, hitting each foe once a swing\n  const combo = W.combo;\n  if (!frozen && W.panicT <= 0 && ctl.pressed('attack') && !combo.busy) combo.press();\n  if (combo.busy) {\n    combo.update(dt);\n    combo.hits(W.foes.filter(f => !f.dead), f => E.inArc(hero, hero.facing, f, 24, 1.25, 22), f => hurtFoe(f, 16, 'melee'));\n  }\n  // the pistol: where the mouse points, or else the nearest foe in front\n  W.shotCool = Math.max(0, W.shotCool - dt);\n  if (!frozen && W.panicT <= 0 && ctl.pressed('use') && W.shotCool <= 0 && S.ammo > 0) fire();\n  W.shots.update(dt, map);\n  W.shots.hit(W.foes.filter(f => !f.dead), (b, f) => hurtFoe(f, b.dmg, 'shot'), 'player');\n  W.shots.hit([hero], () => hurtHero(18), 'enemy');\n  // the people\n  for (const f of W.foes) {\n    if (f.dead && f.dieT > 3) continue;\n    if (frozen) { f.rig.update(dt, f.rigState(f.dead ? 'die' : null)); continue; }\n    f.step(dt, { hero, map, flow: W.flow, shots: W.shots, world: WORLD });\n  }\n  W.foes = W.foes.filter(f => !(f.dead && f.dieT > 3));\n  W.flowT -= dt;\n  if (W.flowT <= 0) { W.flow.update(hero.x, hero.y); W.flowT = .3; }\n  for (const k of Object.keys(W.npcs)) {\n    const n = W.npcs[k];\n    n.rig.update(dt, { x: n.x, y: n.y, z: 0, vx: 0, vy: 0, facing: Math.atan2(hero.y - n.y, hero.x - n.x) });\n  }\n  // pickups: a cannoli heals and calms; shells; a duck in the pool (a side collection)\n  for (const p of W.cannoli) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.hp = Math.min(100, S.hp + 25); S.stress = Math.max(0, S.stress - 10); S.cannoli++; sfx('pickup'); toast('A CANNOLI. ONE FOR THE ROAD.'); }\n  for (const p of W.ammo) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.ammo += 8; sfx('pickup'); toast('+8 SHELLS'); }\n  for (const p of W.ducks) if (!p.taken && E.dist(hero, p) < 16) { p.taken = true; S.ducks++; sfx('coin'); toast('A DUCK. THE POOL IS OPEN.'); }\n  chapterStep(dt);\n  if (!frozen && !talk.open && ctl.pressed('interact')) {\n    const it = nearestInteractable();\n    if (it) it.use();\n  }\n  // the stress: a hot Fed raises it, a quiet street lowers it. At 100 it is a panic attack.\n  S.stress = clamp(S.stress + (S.heat > 50 ? 1.2 : -1.2) * dt, 0, 100);\n  if (S.stress >= 100 && W.panicT <= 0) { W.panicT = 3; S.stress = 100; toast('PANIC. BREATHE.'); sfx('cancel'); }\n  if (W.panicT > 0) { W.panicT -= dt; if (W.panicT <= 0) { W.panicT = 0; S.stress = 60; } }\n  S.heat = Math.max(0, S.heat - (anyFedSees() ? 0 : 2.5) * dt);\n  // the look: the rigs take their pose from the bodies and the blows\n  const extra = combo.busy ? { attack: combo.state } : {};\n  if (ctl.down('block')) extra.pose = 'guard';\n  W.heroRig.update(dt, hero.rigState(extra));\n  // where the mouse points on the ground, when it's the device in use (the pistol's aim)\n  W.aim = null;\n  if (game.input.lastDevice === 'mouse') W.aim = game.mouseGround ? game.mouseGround() : null;\n  hubTick(dt);\n}\n\nfunction fire() {\n  const hero = W.hero;\n  let ang = hero.facing;\n  if (W.aim) ang = Math.atan2(W.aim[1] - hero.y, W.aim[0] - hero.x);\n  else {\n    let best = null, bd = 170;\n    for (const f of W.foes) {\n      if (f.dead || f.kind === 'civ') continue;\n      const d = E.dist(hero, f), a = Math.atan2(f.y - hero.y, f.x - hero.x);\n      if (d < bd && angleDiff(a, hero.facing) < .8) { best = f; bd = d; }\n    }\n    if (best) ang = Math.atan2(best.y - hero.y, best.x - hero.x);\n  }\n  W.shots.fire({ x: hero.x + Math.cos(ang) * 6, y: hero.y + Math.sin(ang) * 6, z: hero.z + 14, vx: Math.cos(ang) * 320, vy: Math.sin(ang) * 320, vz: 0, r: 2, team: 'player', color: '#ffd36a', life: 1, dmg: 30, core: true });\n  hero.facing = ang;\n  S.ammo--; W.shotCool = .32;\n  sfx('shoot');\n  game.shake(1.5);\n}\n\n// ---- the things the hero can use -------------------------------------------------------------\nfunction interactables() {\n  const out = [];\n  const add = (id, cell, label, use, r = 24) => { const p = centerOf(cell); out.push({ id, x: p.x, y: p.y, label, use, r }); };\n  if (S.chapter === 1) {\n    if (!S.got.ricci) add('ricci', NPC_DEFS.ricci.cell, 'Sal Ricci', () => collect('ricci', 800));\n    if (!S.got.dorothy) add('dorothy', NPC_DEFS.dorothy.cell, 'Dorothy', () => collect('dorothy', 450));\n    if (!S.got.tina) add('tina', NPC_DEFS.tina.cell, 'Tina', () => collect('tina', 1500));\n  }\n  if (S.chapter === 2) add('lou', NPC_DEFS.lou.cell, 'Big Lou', () => startConv('lou', () => { S.lou = true; setChapter(3); }));\n  if (S.chapter === 3) add('vashti', [27, 23], 'Dr. Vashti’s door', () => game.go('session', { from: 'play' }));\n  if (S.chapter === 5 && !S.done) add('home', [8, 13], 'Ma’s house', () => startConv('home', () => finish()), 26);\n  return out;\n}\nfunction nearestInteractable() {\n  let best = null, bd = Infinity;\n  for (const it of interactables()) { const d = Math.hypot(it.x - W.hero.x, it.y - W.hero.y); if (d < it.r && d < bd) { best = it; bd = d; } }\n  return best;\n}\nfunction collect(key, cash) {\n  S.got[key] = true; S.cash += cash;\n  sfx('coin');\n  toast('+$' + cash + ' from ' + SPEAKER_NAMES[key]);\n  startConv(key, () => {\n    if (S.got.ricci && S.got.dorothy && S.got.tina) { setChapter(2); }\n  });\n}\n\n// ---- the chapters ----------------------------------------------------------------------------\nfunction chapterStep(dt) {\n  const hero = W.hero;\n  if (S.chapter === 4 && !S.bossDown && !W.yardOn && zoneAt(hero.x, hero.y) === 'yard') {\n    spawnYard();\n    startConv('gus', null);\n    toast('THE YARD  ·  PUT GUS DOWN');\n  }\n  if (S.chapter === 5 && !S.done) {\n    W.fedT -= dt;\n    const alive = W.foes.filter(f => f.kind === 'fed' && !f.dead).length;\n    if (W.fedT <= 0 && alive < (S.heat > 60 ? 5 : 3)) { spawnFed(); W.fedT = 5; }\n  }\n  if (S.chapter === 4 && W.boss && W.boss.dead) bossDown();\n}\n\nfunction finish() {\n  if (S.done) return;\n  S.done = true;\n  sfx('powerup');\n  if (HUB) {\n    HUB.result({ time: Math.max(1, Math.round(HUB.time())), stats: { deaths: S.deaths, kills: S.kills, cash: S.cash }, awards: awardsFor() });\n    toast('ROUND COMPLETE. WAITING ON THE OTHERS.');\n    W.frozen = true;\n  } else {\n    game.go('end', { won: true });\n  }\n}\nfunction awardsFor() {\n  const out = [];\n  if (S.deaths === 0) out.push({ title: 'Never went down', detail: 'Finished without a death.' });\n  if (S.ducks >= DUCKS.length) out.push({ title: 'Ducks in the pool', detail: 'Found all the ducks.' });\n  return out;\n}\n// The run's progress as one number (the hub's scoreboard, and the time-up result)\nfunction scoreNow() { return S.cash + S.respect * 100 + S.kills * 50 + S.ducks * 200 + (S.chapter - 1) * 500; }\n\n// ---- drawing ----------------------------------------------------------------------------------\nfunction drawWorld(r) {\n  const hero = W.hero, map = W.map;\n  map.drawFloor(r);\n  for (const p of W.ducks) if (!p.taken) r.sprite(p.x, p.y, 4 + Math.sin(game.time * 2 + p.x) * .6, SPR.duck, { anchor: 'bottom' });\n  for (const [name, cx, cy, o] of PROPS) r.prop(name, cx * 16 + 8, cy * 16 + 8, 0, Object.assign({ size: 1.2 }, o));\n  for (const [id, cx, cy, o] of DRESS) r.shape(id, cx * 16 + 8, cy * 16 + 8, 0, o);\n  map.queueWalls(r);\n  for (const p of W.cannoli) if (!p.taken) { r.sprite(p.x, p.y, 8 + Math.sin(game.time * 3) * 1.2, SPR.cannoli, { glow: .3 }); game.lights.add(p.x, p.y, 10, 22, .4, { color: '#ffd9a0' }); }\n  for (const p of W.ammo) if (!p.taken) r.sprite(p.x, p.y, 6, SPR.ammo, { glow: .2 });\n  const near = nearestInteractable();\n  for (const k of Object.keys(W.npcs)) {\n    const n = W.npcs[k];\n    r.shadow(n.x, n.y, 5, .35, undefined, 0);\n    r.actor(n.x, n.y, 0, (g, ox, oy) => n.rig.draw(g, ox, oy, r.view));\n    r.textAt(n.x, n.y, 44, SPEAKER_NAMES[k], near && near.id === k ? '#ffe08a' : '#e8e0f0', { outline: true });\n  }\n  for (const f of W.foes) {\n    if (f.dead && f.dieT > 2.5) continue;\n    const alpha = f.dead ? clamp(1 - (f.dieT - 2.5) * 2, 0, 1) : 1;\n    r.shadow(f.x, f.y, 5, .35, undefined, 0);\n    r.actor(f.x, f.y, f.z, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ff5050' : false, alpha });\n    if (!f.dead && f.kind !== 'civ' && (f.alert > 0 || f.boss)) r.textAt(f.x, f.y, 46, f.name, f.boss ? '#ffb040' : '#e8e0f0', { outline: true });\n  }\n  r.shadow(hero.x, hero.y, 6, .4, undefined, 0);\n  r.actor(hero.x, hero.y, hero.z, (g, ox, oy) => W.heroRig.draw(g, ox, oy, r.view), { flash: hero.iframes > .3 ? '#ff5050' : false, flashMix: .4 });\n  W.shots.draw(r);\n  drawGhosts(r);\n  if (S.chapter === 5 && !S.done) { const h = centerOf([8, 13]); game.lights.add(h.x, h.y, 16, 36, .6, { color: '#ffd090' }); }\n  if (near && !S.done) game.lights.add(near.x, near.y, 14, 26, .5, { color: '#ffe08a' });\n}\n\n// the world's callbacks for the people (their hits and sounds)\nconst WORLD = {\n  hurtHero: (n, from) => hurtHero(n, from),\n  spotted: (f, dt) => spotted(f, dt),\n  sfx: (name) => sfx(name),\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14893,"cache_read_input_tokens":172167,"cache_creation":{"ephemeral_5m_input_tokens":14893,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ceb3ee4-d05b-48df-8167-856a2d7758be","uuid":"e47cd4b8-9bbb-4749-9946-0ac7f03321ca","timestamp":"2026-11-03T02:19:50.456Z","request_id":"req_011CgfCBUvZhrysTD8E8hQKG","wire_tool_inputs":{"toolu_01SFia3G8u8yiUrDyLB8gDKP":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191111__x3ec78e/work/Sopranoland-TheSopranos-claude-haiku-5-5-medium-20261102-191111/src/game/04-world.js","content":"// ---------------------------------------------------------------------------------------------\n// 04 · WORLD — the town and the story's rules: the hero's walk, bat, pistol and dodge; the\n// people and their fights; the pickups; the chapters and the interactions. The world is built\n// once a run starts. A death rebuilds the chapter's fights at its checkpoint. Input comes from\n// game.input or, in the attract mode, from the AI pad (08); the hub's ghosts are drawn by 09.\n// ---------------------------------------------------------------------------------------------\nconst SPR = {\n  duck: E.sprite(['..yy....', '.yYYy...', 'yYYYYyy.', 'yYYYYYYy', '.yyyyyy.', '..yyyy..'], { y: '#f2d24a', Y: '#fff2a0' }, 2),\n  cannoli: E.sprite(['..ww..', '.wWWw.', 'wWsWWw', '.wWWw.', '..ww..'], { w: '#e8c890', W: '#f6e6c0', s: '#b07840' }, 2),\n  ammo: E.sprite(['.bb.', 'bBBb', 'bBBb', '.bb.'], { b: '#8a6a2a', B: '#d8a84a' }, 2),\n};\n\nlet W = null;   // the live world (map, hero, people, pickups, flags). Set by buildWorld().\n\nconst clamp = (v, a, b) => Math.max(a, Math.min(b, v));\nconst angleDiff = (a, b) => Math.abs(Math.atan2(Math.sin(a - b), Math.cos(a - b)));\nconst centerOf = cell => W.map.center(cell[0], cell[1]);\nconst sfx = (name, o) => game.audio.sfx(name, o);\n\nfunction buildWorld() {\n  const floorTex = (x, y, tag) => tag === 'grass' ? E.tex.grass(x, y)\n    : tag === 'road' || tag === 'yard' ? E.tex.dirt(x, y)\n    : tag === 'water' ? E.tex.water(x, y) : E.tex.flagstone(x, y);\n  const map = new E.TileMap({ rows: buildTownRows(), legend: TOWN_LEGEND, types: TOWN_TYPES, floorTex });\n  for (const [id, x, y, o] of DRESS) map.solid(id, x * 16 + 8, y * 16 + 8, 0, o);\n  W = {\n    map, flow: new E.FlowField(map), flowT: 0,\n    hero: null, heroRig: makeHeroRig(), shots: new E.Bullets(game, { plane: 'ground', max: 240, sparks: true }),\n    foes: [], boss: null, combo: null, shotCool: 0, panicT: 0, yardOn: false, feds: 0, fedT: 4,\n    toast: null, toastT: 0, ctl: game.input, aim: null, frozen: false,\n    npcs: {}, ducks: [], cannoli: [], ammo: [], civs: [],\n  };\n  W.hero = makeHero(centerOf(START_CELL));\n  W.hero.iframes = 0;\n  // the people who talk: each has a rig and a place. Vashti is in the session room, not on the street.\n  for (const k of Object.keys(NPC_DEFS)) {\n    if (k === 'vashti') continue;\n    const d = NPC_DEFS[k], p = centerOf(d.cell);\n    W.npcs[k] = { key: k, def: d, x: p.x, y: p.y, rig: makeNPCRig(d) };\n  }\n  W.ducks = DUCKS.map(c => Object.assign(centerOf(c), { taken: false }));\n  W.cannoli = CANNOLI.map(c => Object.assign(centerOf(c), { taken: false }));\n  W.ammo = AMMO.map(c => Object.assign(centerOf(c), { taken: false }));\n  for (const c of CIVILIANS) { const p = centerOf(c); W.civs.push(new Foe('civ', LOOKS.civ, p)); }\n  W.foes.push(...W.civs);\n  W.combo = newCombo();\n  return W;\n}\nfunction newCombo() { return new E.Combo(['backslash', 'overhead', 'thrust'], { window: .4 }); }\n\n// The hero's own controls: the stick through the player's inversions, the buttons from game.input.\nconst PLAYER_MOVE = Object.create(game.input, { move: { value: () => stickMove(game.input) } });\n\n// Put the hero at the chapter's checkpoint, and the chapter's fights back in place.\nfunction setChapter(n, o = {}) {\n  S.chapter = n;\n  const p = centerOf(CHECKPOINT[n]);\n  Object.assign(W.hero, { x: p.x, y: p.y, vx: 0, vy: 0, z: 0, onGround: true, wall: null, action: null });\n  W.hero.lastSafe = { x: p.x, y: p.y, z: 0 };\n  W.foes = W.civs.slice();\n  W.boss = null; W.yardOn = false; W.feds = 0; W.fedT = 4;\n  W.combo = newCombo();\n  if (n === 5) S.heat = Math.max(S.heat, 80);\n  if (!o.quiet) toast(CHAPTERS[n].title + '  ·  ' + CHAPTERS[n].goal);\n}\nfunction toast(text) { W.toast = text; W.toastT = 4.5; }\n\nfunction spawnFoe(kind, look, cell, o = {}) {\n  const f = new Foe(kind, look, centerOf(cell), o);\n  W.foes.push(f);\n  return f;\n}\nfunction spawnYard() {\n  spawnFoe('crew', LOOKS.benny, [36, 28], { name: 'BENNY' });\n  spawnFoe('crew', LOOKS.richie, [39, 33], { name: 'RICHIE' });\n  spawnFoe('crew', LOOKS.frankie, [35, 34], { name: 'FRANKIE' });\n  W.boss = spawnFoe('boss', LOOKS.gus, [38, 30], { name: 'GUS' });\n  W.yardOn = true;\n}\nfunction spawnFed() {\n  const west = Math.random() < .5;\n  const f = spawnFoe('fed', LOOKS.fed, west ? [1, 19] : [58, 20], { name: 'AGENT' });\n  f.alert = 4; W.feds++;\n  return f;\n}\n\n// ---- the hero's life -------------------------------------------------------------------------\nfunction hurtHero(n) {\n  const hero = W.hero;\n  if (hero.iframes > 0 || S.done) return;\n  const guard = !!W.ctl.down('block');\n  const dmg = n * (guard ? .3 : 1);\n  S.hp = Math.max(0, S.hp - dmg);\n  S.stress = Math.min(100, S.stress + n * .4);\n  hero.iframes = .5;\n  game.shake(3 + n / 4);\n  game.hitFx(hero.x, hero.y, hero.z + 18, { power: .6, damage: Math.round(dmg), sound: guard ? 'select' : 'hurt' });\n  if (S.hp <= 0) heroDown();\n}\n\nfunction heroDown() {\n  S.deaths++;\n  S.stress = Math.min(100, S.stress + 20);\n  S.hp = 70;\n  setChapter(S.chapter, { quiet: true });\n  game.flash('#000000', .4, .8);\n  startConv('downed', null);\n}\n\nfunction hurtFoe(f, n, how) {\n  if (f.dead) return;\n  f.takeHit(n, W.hero);\n  E.knockback(W.hero, f, how === 'shot' ? 40 : 90);\n  game.hitFx(f.x, f.y, f.z + 18, { power: how === 'shot' ? .8 : 1, damage: Math.round(n), sound: how === 'shot' ? 'hit' : 'punch' });\n  if (f.kind === 'civ') {\n    S.heat = Math.min(100, S.heat + 12);\n    for (const o of W.civs) o.flee = 6;\n    sfx('hurt');\n  }\n  if (f.boss && !f.phase2 && f.hp < f.maxHp / 2) { f.phase2 = true; toast('GUS IS MAD NOW'); }\n  if (f.dead) {\n    if (f.kind !== 'civ') S.kills++;\n    sfx('die');\n    if (f.kind === 'fed') W.feds = Math.max(0, W.feds - 1);\n    if (f.boss) bossDown();\n  }\n}\n\nfunction bossDown() {\n  if (S.bossDown) return;\n  S.bossDown = true;\n  toast('GUS IS DOWN. THE FEDS ARE COMING.');\n  if (S.chapter === 4) {\n    setChapter(5, { quiet: true });\n    toast(CHAPTERS[5].title + '  ·  ' + CHAPTERS[5].goal);\n    startConv('feds', null);\n  }\n}\n\n// a Fed that sees the hero makes the heat rise\nfunction spotted(f, dt) {\n  if (f.kind === 'fed') S.heat = Math.min(100, S.heat + 6 * dt);\n}\nfunction anyFedSees() { return W.foes.some(f => !f.dead && f.kind === 'fed' && f.alert > 0); }\n\n// ---- the step --------------------------------------------------------------------------------\n// ctl: the buttons to read (game.input, or the AI pad). walk: the Mover's controls (PLAYER_MOVE, or the AI's intent).\nfunction worldStep(dt, ctl, walk) {\n  W.ctl = ctl;\n  const hero = W.hero, map = W.map;\n  S.playTime += dt;\n  if (W.toastT > 0) { W.toastT -= dt; if (W.toastT <= 0) W.toast = null; }\n  hero.iframes = Math.max(0, hero.iframes - dt);\n  const frozen = W.frozen;\n  // walking, jumping and climbing: the Mover keeps out of the walls and up the small ledges\n  if (!frozen) {\n    hero.update(dt, map, walk);\n    if (walk === PLAYER_MOVE && ctl.pressed('dodge')) hero.dodge();\n  }\n  // the bat: a combo, one press a swing, hitting each foe once a swing\n  const combo = W.combo;\n  if (!frozen && W.panicT <= 0 && ctl.pressed('attack') && !combo.busy) combo.press();\n  if (combo.busy) {\n    combo.update(dt);\n    combo.hits(W.foes.filter(f => !f.dead), f => E.inArc(hero, hero.facing, f, 24, 1.25, 22), f => hurtFoe(f, 16, 'melee'));\n  }\n  // the pistol: where the mouse points, or else the nearest foe in front\n  W.shotCool = Math.max(0, W.shotCool - dt);\n  if (!frozen && W.panicT <= 0 && ctl.pressed('use') && W.shotCool <= 0 && S.ammo > 0) fire();\n  W.shots.update(dt, map);\n  W.shots.hit(W.foes.filter(f => !f.dead), (b, f) => hurtFoe(f, b.dmg, 'shot'), 'player');\n  W.shots.hit([hero], () => hurtHero(18), 'enemy');\n  // the people\n  for (const f of W.foes) {\n    if (f.dead && f.dieT > 3) continue;\n    if (frozen) { f.rig.update(dt, f.rigState(f.dead ? 'die' : null)); continue; }\n    f.step(dt, { hero, map, flow: W.flow, shots: W.shots, world: WORLD });\n  }\n  W.foes = W.foes.filter(f => !(f.dead && f.dieT > 3));\n  W.flowT -= dt;\n  if (W.flowT <= 0) { W.flow.update(hero.x, hero.y); W.flowT = .3; }\n  for (const k of Object.keys(W.npcs)) {\n    const n = W.npcs[k];\n    n.rig.update(dt, { x: n.x, y: n.y, z: 0, vx: 0, vy: 0, facing: Math.atan2(hero.y - n.y, hero.x - n.x) });\n  }\n  // pickups: a cannoli heals and calms; shells; a duck in the pool (a side collection)\n  for (const p of W.cannoli) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.hp = Math.min(100, S.hp + 25); S.stress = Math.max(0, S.stress - 10); S.cannoli++; sfx('pickup'); toast('A CANNOLI. ONE FOR THE ROAD.'); }\n  for (const p of W.ammo) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.ammo += 8; sfx('pickup'); toast('+8 SHELLS'); }\n  for (const p of W.ducks) if (!p.taken && E.dist(hero, p) < 16) { p.taken = true; S.ducks++; sfx('coin'); toast('A DUCK. THE POOL IS OPEN.'); }\n  chapterStep(dt);\n  if (!frozen && !talk.open && ctl.pressed('interact')) {\n    const it = nearestInteractable();\n    if (it) it.use();\n  }\n  // the stress: a hot Fed raises it, a quiet street lowers it. At 100 it is a panic attack.\n  S.stress = clamp(S.stress + (S.heat > 50 ? 1.2 : -1.2) * dt, 0, 100);\n  if (S.stress >= 100 && W.panicT <= 0) { W.panicT = 3; S.stress = 100; toast('PANIC. BREATHE.'); sfx('cancel'); }\n  if (W.panicT > 0) { W.panicT -= dt; if (W.panicT <= 0) { W.panicT = 0; S.stress = 60; } }\n  S.heat = Math.max(0, S.heat - (anyFedSees() ? 0 : 2.5) * dt);\n  // the look: the rigs take their pose from the bodies and the blows\n  const extra = combo.busy ? { attack: combo.state } : {};\n  if (ctl.down('block')) extra.pose = 'guard';\n  W.heroRig.update(dt, hero.rigState(extra));\n  // where the mouse points on the ground, when it's the device in use (the pistol's aim)\n  W.aim = null;\n  if (game.input.lastDevice === 'mouse') W.aim = game.mouseGround ? game.mouseGround() : null;\n  hubTick(dt);\n}\n\nfunction fire() {\n  const hero = W.hero;\n  let ang = hero.facing;\n  if (W.aim) ang = Math.atan2(W.aim[1] - hero.y, W.aim[0] - hero.x);\n  else {\n    let best = null, bd = 170;\n    for (const f of W.foes) {\n      if (f.dead || f.kind === 'civ') continue;\n      const d = E.dist(hero, f), a = Math.atan2(f.y - hero.y, f.x - hero.x);\n      if (d < bd && angleDiff(a, hero.facing) < .8) { best = f; bd = d; }\n    }\n    if (best) ang = Math.atan2(best.y - hero.y, best.x - hero.x);\n  }\n  W.shots.fire({ x: hero.x + Math.cos(ang) * 6, y: hero.y + Math.sin(ang) * 6, z: hero.z + 14, vx: Math.cos(ang) * 320, vy: Math.sin(ang) * 320, vz: 0, r: 2, team: 'player', color: '#ffd36a', life: 1, dmg: 30, core: true });\n  hero.facing = ang;\n  S.ammo--; W.shotCool = .32;\n  sfx('shoot');\n  game.shake(1.5);\n}\n\n// ---- the things the hero can use -------------------------------------------------------------\nfunction interactables() {\n  const out = [];\n  const add = (id, cell, label, use, r = 24) => { const p = centerOf(cell); out.push({ id, x: p.x, y: p.y, label, use, r }); };\n  if (S.chapter === 1) {\n    if (!S.got.ricci) add('ricci', NPC_DEFS.ricci.cell, 'Sal Ricci', () => collect('ricci', 800));\n    if (!S.got.dorothy) add('dorothy', NPC_DEFS.dorothy.cell, 'Dorothy', () => collect('dorothy', 450));\n    if (!S.got.tina) add('tina', NPC_DEFS.tina.cell, 'Tina', () => collect('tina', 1500));\n  }\n  if (S.chapter === 2) add('lou', NPC_DEFS.lou.cell, 'Big Lou', () => startConv('lou', () => { S.lou = true; setChapter(3); }));\n  if (S.chapter === 3) add('vashti', [27, 23], 'Dr. Vashti’s door', () => game.go('session', { from: 'play' }));\n  if (S.chapter === 5 && !S.done) add('home', [8, 13], 'Ma’s house', () => startConv('home', () => finish()), 26);\n  return out;\n}\nfunction nearestInteractable() {\n  let best = null, bd = Infinity;\n  for (const it of interactables()) { const d = Math.hypot(it.x - W.hero.x, it.y - W.hero.y); if (d < it.r && d < bd) { best = it; bd = d; } }\n  return best;\n}\nfunction collect(key, cash) {\n  S.got[key] = true; S.cash += cash;\n  sfx('coin');\n  toast('+$' + cash + ' from ' + SPEAKER_NAMES[key]);\n  startConv(key, () => {\n    if (S.got.ricci && S.got.dorothy && S.got.tina) { setChapter(2); }\n  });\n}\n\n// ---- the chapters ----------------------------------------------------------------------------\nfunction chapterStep(dt) {\n  const hero = W.hero;\n  if (S.chapter === 4 && !S.bossDown && !W.yardOn && zoneAt(hero.x, hero.y) === 'yard') {\n    spawnYard();\n    startConv('gus', null);\n    toast('THE YARD  ·  PUT GUS DOWN');\n  }\n  if (S.chapter === 5 && !S.done) {\n    W.fedT -= dt;\n    const alive = W.foes.filter(f => f.kind === 'fed' && !f.dead).length;\n    if (W.fedT <= 0 && alive < (S.heat > 60 ? 5 : 3)) { spawnFed(); W.fedT = 5; }\n  }\n  if (S.chapter === 4 && W.boss && W.boss.dead) bossDown();\n}\n\nfunction finish() {\n  if (S.done) return;\n  S.done = true;\n  sfx('powerup');\n  if (HUB) {\n    HUB.result({ time: Math.max(1, Math.round(HUB.time())), stats: { deaths: S.deaths, kills: S.kills, cash: S.cash }, awards: awardsFor() });\n    toast('ROUND COMPLETE. WAITING ON THE OTHERS.');\n    W.frozen = true;\n  } else {\n    game.go('end', { won: true });\n  }\n}\nfunction awardsFor() {\n  const out = [];\n  if (S.deaths === 0) out.push({ title: 'Never went down', detail: 'Finished without a death.' });\n  if (S.ducks >= DUCKS.length) out.push({ title: 'Ducks in the pool', detail: 'Found all the ducks.' });\n  return out;\n}\n// The run's progress as one number (the hub's scoreboard, and the time-up result)\nfunction scoreNow() { return S.cash + S.respect * 100 + S.kills * 50 + S.ducks * 200 + (S.chapter - 1) * 500; }\n\n// ---- drawing ----------------------------------------------------------------------------------\nfunction drawWorld(r) {\n  const hero = W.hero, map = W.map;\n  map.drawFloor(r);\n  for (const p of W.ducks) if (!p.taken) r.sprite(p.x, p.y, 4 + Math.sin(game.time * 2 + p.x) * .6, SPR.duck, { anchor: 'bottom' });\n  for (const [name, cx, cy, o] of PROPS) r.prop(name, cx * 16 + 8, cy * 16 + 8, 0, Object.assign({ size: 1.2 }, o));\n  for (const [id, cx, cy, o] of DRESS) r.shape(id, cx * 16 + 8, cy * 16 + 8, 0, o);\n  map.queueWalls(r);\n  for (const p of W.cannoli) if (!p.taken) { r.sprite(p.x, p.y, 8 + Math.sin(game.time * 3) * 1.2, SPR.cannoli, { glow: .3 }); game.lights.add(p.x, p.y, 10, 22, .4, { color: '#ffd9a0' }); }\n  for (const p of W.ammo) if (!p.taken) r.sprite(p.x, p.y, 6, SPR.ammo, { glow: .2 });\n  const near = nearestInteractable();\n  for (const k of Object.keys(W.npcs)) {\n    const n = W.npcs[k];\n    r.shadow(n.x, n.y, 5, .35, undefined, 0);\n    r.actor(n.x, n.y, 0, (g, ox, oy) => n.rig.draw(g, ox, oy, r.view));\n    r.textAt(n.x, n.y, 44, SPEAKER_NAMES[k], near && near.id === k ? '#ffe08a' : '#e8e0f0', { outline: true });\n  }\n  for (const f of W.foes) {\n    if (f.dead && f.dieT > 2.5) continue;\n    const alpha = f.dead ? clamp(1 - (f.dieT - 2.5) * 2, 0, 1) : 1;\n    r.shadow(f.x, f.y, 5, .35, undefined, 0);\n    r.actor(f.x, f.y, f.z, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ff5050' : false, alpha });\n    if (!f.dead && f.kind !== 'civ' && (f.alert > 0 || f.boss)) r.textAt(f.x, f.y, 46, f.name, f.boss ? '#ffb040' : '#e8e0f0', { outline: true });\n  }\n  r.shadow(hero.x, hero.y, 6, .4, undefined, 0);\n  r.actor(hero.x, hero.y, hero.z, (g, ox, oy) => W.heroRig.draw(g, ox, oy, r.view), { flash: hero.iframes > .3 ? '#ff5050' : false, flashMix: .4 });\n  W.shots.draw(r);\n  drawGhosts(r);\n  if (S.chapter === 5 && !S.done) { const h = centerOf([8, 13]); game.lights.add(h.x, h.y, 16, 36, .6, { color: '#ffd090' }); }\n  if (near && !S.done) game.lights.add(near.x, near.y, 14, 26, .5, { color: '#ffe08a' });\n}\n\n// the world's callbacks for the people (their hits and sounds)\nconst WORLD = {\n  hurtHero: (n, from) => hurtHero(n, from),\n  spotted: (f, dt) => spotted(f, dt),\n  sfx: (name) => sfx(name),\n};\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SFia3G8u8yiUrDyLB8gDKP","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191111__x3ec78e/work/Sopranoland-TheSopranos-claude-haiku-5-5-medium-20261102-191111/src/game/04-world.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2ceb3ee4-d05b-48df-8167-856a2d7758be","uuid":"f0fda193-0d06-46ce-a850-a37187e4ded2","timestamp":"2026-11-03T02:19:50.477Z","tool_use_result":{"type":"update","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191111__x3ec78e/work/Sopranoland-TheSopranos-claude-haiku-5-5-medium-20261102-191111/src/game/04-world.js","content":"// ---------------------------------------------------------------------------------------------\n// 04 · WORLD — the town and the story's rules: the hero's walk, bat, pistol and dodge; the\n// people and their fights; the pickups; the chapters and the interactions. The world is built\n// once a run starts. A death rebuilds the chapter's fights at its checkpoint. Input comes from\n// game.input or, in the attract mode, from the AI pad (08); the hub's ghosts are drawn by 09.\n// ---------------------------------------------------------------------------------------------\nconst SPR = {\n  duck: E.sprite(['..yy....', '.yYYy...', 'yYYYYyy.', 'yYYYYYYy', '.yyyyyy.', '..yyyy..'], { y: '#f2d24a', Y: '#fff2a0' }, 2),\n  cannoli: E.sprite(['..ww..', '.wWWw.', 'wWsWWw', '.wWWw.', '..ww..'], { w: '#e8c890', W: '#f6e6c0', s: '#b07840' }, 2),\n  ammo: E.sprite(['.bb.', 'bBBb', 'bBBb', '.bb.'], { b: '#8a6a2a', B: '#d8a84a' }, 2),\n};\n\nlet W = null;   // the live world (map, hero, people, pickups, flags). Set by buildWorld().\n\nconst clamp = (v, a, b) => Math.max(a, Math.min(b, v));\nconst angleDiff = (a, b) => Math.abs(Math.atan2(Math.sin(a - b), Math.cos(a - b)));\nconst centerOf = cell => W.map.center(cell[0], cell[1]);\nconst sfx = (name, o) => game.audio.sfx(name, o);\n\nfunction buildWorld() {\n  const floorTex = (x, y, tag) => tag === 'grass' ? E.tex.grass(x, y)\n    : tag === 'road' || tag === 'yard' ? E.tex.dirt(x, y)\n    : tag === 'water' ? E.tex.water(x, y) : E.tex.flagstone(x, y);\n  const map = new E.TileMap({ rows: buildTownRows(), legend: TOWN_LEGEND, types: TOWN_TYPES, floorTex });\n  for (const [id, x, y, o] of DRESS) map.solid(id, x * 16 + 8, y * 16 + 8, 0, o);\n  W = {\n    map, flow: new E.FlowField(map), flowT: 0,\n    hero: null, heroRig: makeHeroRig(), shots: new E.Bullets(game, { plane: 'ground', max: 240, sparks: true }),\n    foes: [], boss: null, combo: null, shotCool: 0, panicT: 0, yardOn: false, feds: 0, fedT: 4,\n    toast: null, toastT: 0, ctl: game.input, aim: null, frozen: false,\n    npcs: {}, ducks: [], cannoli: [], ammo: [], civs: [],\n  };\n  W.hero = makeHero(centerOf(START_CELL));\n  W.hero.iframes = 0;\n  // the people who talk: each has a rig and a place. Vashti is in the session room, not on the street.\n  for (const k of Object.keys(NPC_DEFS)) {\n    if (k === 'vashti') continue;\n    const d = NPC_DEFS[k], p = centerOf(d.cell);\n    W.npcs[k] = { key: k, def: d, x: p.x, y: p.y, rig: makeNPCRig(d) };\n  }\n  W.ducks = DUCKS.map(c => Object.assign(centerOf(c), { taken: false }));\n  W.cannoli = CANNOLI.map(c => Object.assign(centerOf(c), { taken: false }));\n  W.ammo = AMMO.map(c => Object.assign(centerOf(c), { taken: false }));\n  for (const c of CIVILIANS) { const p = centerOf(c); W.civs.push(new Foe('civ', LOOKS.civ, p)); }\n  W.foes.push(...W.civs);\n  W.combo = newCombo();\n  return W;\n}\nfunction newCombo() { return new E.Combo(['backslash', 'overhead', 'thrust'], { window: .4 }); }\n\n// The hero's own controls: the stick through the player's inversions, the buttons from game.input.\nconst PLAYER_MOVE = Object.create(game.input, { move: { value: () => stickMove(game.input) } });\n\n// Put the hero at the chapter's checkpoint, and the chapter's fights back in place.\nfunction setChapter(n, o = {}) {\n  S.chapter = n;\n  const p = centerOf(CHECKPOINT[n]);\n  Object.assign(W.hero, { x: p.x, y: p.y, vx: 0, vy: 0, z: 0, onGround: true, wall: null, action: null });\n  W.hero.lastSafe = { x: p.x, y: p.y, z: 0 };\n  W.foes = W.civs.slice();\n  W.boss = null; W.yardOn = false; W.feds = 0; W.fedT = 4;\n  W.combo = newCombo();\n  if (n === 5) S.heat = Math.max(S.heat, 80);\n  if (!o.quiet) toast(CHAPTERS[n].title + '  ·  ' + CHAPTERS[n].goal);\n}\nfunction toast(text) { W.toast = text; W.toastT = 4.5; }\n\nfunction spawnFoe(kind, look, cell, o = {}) {\n  const f = new Foe(kind, look, centerOf(cell), o);\n  W.foes.push(f);\n  return f;\n}\nfunction spawnYard() {\n  spawnFoe('crew', LOOKS.benny, [36, 28], { name: 'BENNY' });\n  spawnFoe('crew', LOOKS.richie, [39, 33], { name: 'RICHIE' });\n  spawnFoe('crew', LOOKS.frankie, [35, 34], { name: 'FRANKIE' });\n  W.boss = spawnFoe('boss', LOOKS.gus, [38, 30], { name: 'GUS' });\n  W.yardOn = true;\n}\nfunction spawnFed() {\n  const west = Math.random() < .5;\n  const f = spawnFoe('fed', LOOKS.fed, west ? [1, 19] : [58, 20], { name: 'AGENT' });\n  f.alert = 4; W.feds++;\n  return f;\n}\n\n// ---- the hero's life -------------------------------------------------------------------------\nfunction hurtHero(n) {\n  const hero = W.hero;\n  if (hero.iframes > 0 || S.done) return;\n  const guard = !!W.ctl.down('block');\n  const dmg = n * (guard ? .3 : 1);\n  S.hp = Math.max(0, S.hp - dmg);\n  S.stress = Math.min(100, S.stress + n * .4);\n  hero.iframes = .5;\n  game.shake(3 + n / 4);\n  game.hitFx(hero.x, hero.y, hero.z + 18, { power: .6, damage: Math.round(dmg), sound: guard ? 'select' : 'hurt' });\n  if (S.hp <= 0) heroDown();\n}\n\nfunction heroDown() {\n  S.deaths++;\n  S.stress = Math.min(100, S.stress + 20);\n  S.hp = 70;\n  setChapter(S.chapter, { quiet: true });\n  game.flash('#000000', .4, .8);\n  startConv('downed', null);\n}\n\nfunction hurtFoe(f, n, how) {\n  if (f.dead) return;\n  f.takeHit(n, W.hero);\n  E.knockback(W.hero, f, how === 'shot' ? 40 : 90);\n  game.hitFx(f.x, f.y, f.z + 18, { power: how === 'shot' ? .8 : 1, damage: Math.round(n), sound: how === 'shot' ? 'hit' : 'punch' });\n  if (f.kind === 'civ') {\n    S.heat = Math.min(100, S.heat + 12);\n    for (const o of W.civs) o.flee = 6;\n    sfx('hurt');\n  }\n  if (f.boss && !f.phase2 && f.hp < f.maxHp / 2) { f.phase2 = true; toast('GUS IS MAD NOW'); }\n  if (f.dead) {\n    if (f.kind !== 'civ') S.kills++;\n    sfx('die');\n    if (f.kind === 'fed') W.feds = Math.max(0, W.feds - 1);\n    if (f.boss) bossDown();\n  }\n}\n\nfunction bossDown() {\n  if (S.bossDown) return;\n  S.bossDown = true;\n  toast('GUS IS DOWN. THE FEDS ARE COMING.');\n  if (S.chapter === 4) {\n    setChapter(5, { quiet: true });\n    toast(CHAPTERS[5].title + '  ·  ' + CHAPTERS[5].goal);\n    startConv('feds', null);\n  }\n}\n\n// a Fed that sees the hero makes the heat rise\nfunction spotted(f, dt) {\n  if (f.kind === 'fed') S.heat = Math.min(100, S.heat + 6 * dt);\n}\nfunction anyFedSees() { return W.foes.some(f => !f.dead && f.kind === 'fed' && f.alert > 0); }\n\n// ---- the step --------------------------------------------------------------------------------\n// ctl: the buttons to read (game.input, or the AI pad). walk: the Mover's controls (PLAYER_MOVE, or the AI's intent).\nfunction worldStep(dt, ctl, walk) {\n  W.ctl = ctl;\n  const hero = W.hero, map = W.map;\n  S.playTime += dt;\n  if (W.toastT > 0) { W.toastT -= dt; if (W.toastT <= 0) W.toast = null; }\n  hero.iframes = Math.max(0, hero.iframes - dt);\n  const frozen = W.frozen;\n  // walking, jumping and climbing: the Mover keeps out of the walls and up the small ledges\n  if (!frozen) {\n    hero.update(dt, map, walk);\n    if (walk === PLAYER_MOVE && ctl.pressed('dodge')) hero.dodge();\n  }\n  // the bat: a combo, one press a swing, hitting each foe once a swing\n  const combo = W.combo;\n  if (!frozen && W.panicT <= 0 && ctl.pressed('attack') && !combo.busy) combo.press();\n  if (combo.busy) {\n    combo.update(dt);\n    combo.hits(W.foes.filter(f => !f.dead), f => E.inArc(hero, hero.facing, f, 24, 1.25, 22), f => hurtFoe(f, 16, 'melee'));\n  }\n  // the pistol: where the mouse points, or else the nearest foe in front\n  W.shotCool = Math.max(0, W.shotCool - dt);\n  if (!frozen && W.panicT <= 0 && ctl.pressed('use') && W.shotCool <= 0 && S.ammo > 0) fire();\n  W.shots.update(dt, map);\n  W.shots.hit(W.foes.filter(f => !f.dead), (b, f) => hurtFoe(f, b.dmg, 'shot'), 'player');\n  W.shots.hit([hero], () => hurtHero(18), 'enemy');\n  // the people\n  for (const f of W.foes) {\n    if (f.dead && f.dieT > 3) continue;\n    if (frozen) { f.rig.update(dt, f.rigState(f.dead ? 'die' : null)); continue; }\n    f.step(dt, { hero, map, flow: W.flow, shots: W.shots, world: WORLD });\n  }\n  W.foes = W.foes.filter(f => !(f.dead && f.dieT > 3));\n  W.flowT -= dt;\n  if (W.flowT <= 0) { W.flow.update(hero.x, hero.y); W.flowT = .3; }\n  for (const k of Object.keys(W.npcs)) {\n    const n = W.npcs[k];\n    n.rig.update(dt, { x: n.x, y: n.y, z: 0, vx: 0, vy: 0, facing: Math.atan2(hero.y - n.y, hero.x - n.x) });\n  }\n  // pickups: a cannoli heals and calms; shells; a duck in the pool (a side collection)\n  for (const p of W.cannoli) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.hp = Math.min(100, S.hp + 25); S.stress = Math.max(0, S.stress - 10); S.cannoli++; sfx('pickup'); toast('A CANNOLI. ONE FOR THE ROAD.'); }\n  for (const p of W.ammo) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.ammo += 8; sfx('pickup'); toast('+8 SHELLS'); }\n  for (const p of W.ducks) if (!p.taken && E.dist(hero, p) < 16) { p.taken = true; S.ducks++; sfx('coin'); toast('A DUCK. THE POOL IS OPEN.'); }\n  chapterStep(dt);\n  if (!frozen && !talk.open && ctl.pressed('interact')) {\n    const it = nearestInteractable();\n    if (it) it.use();\n  }\n  // the stress: a hot Fed raises it, a quiet street lowers it. At 100 it is a panic attack.\n  S.stress = clamp(S.stress + (S.heat > 50 ? 1.2 : -1.2) * dt, 0, 100);\n  if (S.stress >= 100 && W.panicT <= 0) { W.panicT = 3; S.stress = 100; toast('PANIC. BREATHE.'); sfx('cancel'); }\n  if (W.panicT > 0) { W.panicT -= dt; if (W.panicT <= 0) { W.panicT = 0; S.stress = 60; } }\n  S.heat = Math.max(0, S.heat - (anyFedSees() ? 0 : 2.5) * dt);\n  // the look: the rigs take their pose from the bodies and the blows\n  const extra = combo.busy ? { attack: combo.state } : {};\n  if (ctl.down('block')) extra.pose = 'guard';\n  W.heroRig.update(dt, hero.rigState(extra));\n  // where the mouse points on the ground, when it's the device in use (the pistol's aim)\n  W.aim = null;\n  if (game.input.lastDevice === 'mouse') W.aim = game.mouseGround ? game.mouseGround() : null;\n  hubTick(dt);\n}\n\nfunction fire() {\n  const hero = W.hero;\n  let ang = hero.facing;\n  if (W.aim) ang = Math.atan2(W.aim[1] - hero.y, W.aim[0] - hero.x);\n  else {\n    let best = null, bd = 170;\n    for (const f of W.foes) {\n      if (f.dead || f.kind === 'civ') continue;\n      const d = E.dist(hero, f), a = Math.atan2(f.y - hero.y, f.x - hero.x);\n      if (d < bd && angleDiff(a, hero.facing) < .8) { best = f; bd = d; }\n    }\n    if (best) ang = Math.atan2(best.y - hero.y, best.x - hero.x);\n  }\n  W.shots.fire({ x: hero.x + Math.cos(ang) * 6, y: hero.y + Math.sin(ang) * 6, z: hero.z + 14, vx: Math.cos(ang) * 320, vy: Math.sin(ang) * 320, vz: 0, r: 2, team: 'player', color: '#ffd36a', life: 1, dmg: 30, core: true });\n  hero.facing = ang;\n  S.ammo--; W.shotCool = .32;\n  sfx('shoot');\n  game.shake(1.5);\n}\n\n// ---- the things the hero can use -------------------------------------------------------------\nfunction interactables() {\n  const out = [];\n  const add = (id, cell, label, use, r = 24) => { const p = centerOf(cell); out.push({ id, x: p.x, y: p.y, label, use, r }); };\n  if (S.chapter === 1) {\n    if (!S.got.ricci) add('ricci', NPC_DEFS.ricci.cell, 'Sal Ricci', () => collect('ricci', 800));\n    if (!S.got.dorothy) add('dorothy', NPC_DEFS.dorothy.cell, 'Dorothy', () => collect('dorothy', 450));\n    if (!S.got.tina) add('tina', NPC_DEFS.tina.cell, 'Tina', () => collect('tina', 1500));\n  }\n  if (S.chapter === 2) add('lou', NPC_DEFS.lou.cell, 'Big Lou', () => startConv('lou', () => { S.lou = true; setChapter(3); }));\n  if (S.chapter === 3) add('vashti', [27, 23], 'Dr. Vashti’s door', () => game.go('session', { from: 'play' }));\n  if (S.chapter === 5 && !S.done) add('home', [8, 13], 'Ma’s house', () => startConv('home', () => finish()), 26);\n  return out;\n}\nfunction nearestInteractable() {\n  let best = null, bd = Infinity;\n  for (const it of interactables()) { const d = Math.hypot(it.x - W.hero.x, it.y - W.hero.y); if (d < it.r && d < bd) { best = it; bd = d; } }\n  return best;\n}\nfunction collect(key, cash) {\n  S.got[key] = true; S.cash += cash;\n  sfx('coin');\n  toast('+$' + cash + ' from ' + SPEAKER_NAMES[key]);\n  startConv(key, () => {\n    if (S.got.ricci && S.got.dorothy && S.got.tina) { setChapter(2); }\n  });\n}\n\n// ---- the chapters ----------------------------------------------------------------------------\nfunction chapterStep(dt) {\n  const hero = W.hero;\n  if (S.chapter === 4 && !S.bossDown && !W.yardOn && zoneAt(hero.x, hero.y) === 'yard') {\n    spawnYard();\n    startConv('gus', null);\n    toast('THE YARD  ·  PUT GUS DOWN');\n  }\n  if (S.chapter === 5 && !S.done) {\n    W.fedT -= dt;\n    const alive = W.foes.filter(f => f.kind === 'fed' && !f.dead).length;\n    if (W.fedT <= 0 && alive < (S.heat > 60 ? 5 : 3)) { spawnFed(); W.fedT = 5; }\n  }\n  if (S.chapter === 4 && W.boss && W.boss.dead) bossDown();\n}\n\nfunction finish() {\n  if (S.done) return;\n  S.done = true;\n  sfx('powerup');\n  if (HUB) {\n    HUB.result({ time: Math.max(1, Math.round(HUB.time())), stats: { deaths: S.deaths, kills: S.kills, cash: S.cash }, awards: awardsFor() });\n    toast('ROUND COMPLETE. WAITING ON THE OTHERS.');\n    W.frozen = true;\n  } else {\n    game.go('end', { won: true });\n  }\n}\nfunction awardsFor() {\n  const out = [];\n  if (S.deaths === 0) out.push({ title: 'Never went down', detail: 'Finished without a death.' });\n  if (S.ducks >= DUCKS.length) out.push({ title: 'Ducks in the pool', detail: 'Found all the ducks.' });\n  return out;\n}\n// The run's progress as one number (the hub's scoreboard, and the time-up result)\nfunction scoreNow() { return S.cash + S.respect * 100 + S.kills * 50 + S.ducks * 200 + (S.chapter - 1) * 500; }\n\n// ---- drawing ----------------------------------------------------------------------------------\nfunction drawWorld(r) {\n  const hero = W.hero, map = W.map;\n  map.drawFloor(r);\n  for (const p of W.ducks) if (!p.taken) r.sprite(p.x, p.y, 4 + Math.sin(game.time * 2 + p.x) * .6, SPR.duck, { anchor: 'bottom' });\n  for (const [name, cx, cy, o] of PROPS) r.prop(name, cx * 16 + 8, cy * 16 + 8, 0, Object.assign({ size: 1.2 }, o));\n  for (const [id, cx, cy, o] of DRESS) r.shape(id, cx * 16 + 8, cy * 16 + 8, 0, o);\n  map.queueWalls(r);\n  for (const p of W.cannoli) if (!p.taken) { r.sprite(p.x, p.y, 8 + Math.sin(game.time * 3) * 1.2, SPR.cannoli, { glow: .3 }); game.lights.add(p.x, p.y, 10, 22, .4, { color: '#ffd9a0' }); }\n  for (const p of W.ammo) if (!p.taken) r.sprite(p.x, p.y, 6, SPR.ammo, { glow: .2 });\n  const near = nearestInteractable();\n  for (const k of Object.keys(W.npcs)) {\n    const n = W.npcs[k];\n    r.shadow(n.x, n.y, 5, .35, undefined, 0);\n    r.actor(n.x, n.y, 0, (g, ox, oy) => n.rig.draw(g, ox, oy, r.view));\n    r.textAt(n.x, n.y, 44, SPEAKER_NAMES[k], near && near.id === k ? '#ffe08a' : '#e8e0f0', { outline: true });\n  }\n  for (const f of W.foes) {\n    if (f.dead && f.dieT > 2.5) continue;\n    const alpha = f.dead ? clamp(1 - (f.dieT - 2.5) * 2, 0, 1) : 1;\n    r.shadow(f.x, f.y, 5, .35, undefined, 0);\n    r.actor(f.x, f.y, f.z, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ff5050' : false, alpha });\n    if (!f.dead && f.kind !== 'civ' && (f.alert > 0 || f.boss)) r.textAt(f.x, f.y, 46, f.name, f.boss ? '#ffb040' : '#e8e0f0', { outline: true });\n  }\n  r.shadow(hero.x, hero.y, 6, .4, undefined, 0);\n  r.actor(hero.x, hero.y, hero.z, (g, ox, oy) => W.heroRig.draw(g, ox, oy, r.view), { flash: hero.iframes > .3 ? '#ff5050' : false, flashMix: .4 });\n  W.shots.draw(r);\n  drawGhosts(r);\n  if (S.chapter === 5 && !S.done) { const h = centerOf([8, 13]); game.lights.add(h.x, h.y, 16, 36, .6, { color: '#ffd090' }); }\n  if (near && !S.done) game.lights.add(near.x, near.y, 14, 26, .5, { color: '#ffe08a' });\n}\n\n// the world's callbacks for the people (their hits and sounds)\nconst WORLD = {\n  hurtHero: (n, from) => hurtHero(n, from),\n  spotted: (f, dt) => spotted(f, dt),\n  sfx: (name) => sfx(name),\n};\n","structuredPatch":[{"oldStart":1,"oldLines":69,"newStart":1,"newLines":72,"lines":[" // ---------------------------------------------------------------------------------------------","-// 04 · WORLD — the town and the story's rules: the hero's controls and combat, the people, the","-// pickups and the chapters. The world is built once a run starts; a death rebuilds the","-// chapter's fights at its checkpoint. Input comes from game.input or, in the attract mode, from AI.","+// 04 · WORLD — the town and the story's rules: the hero's walk, bat, pistol and dodge; the","+// people and their fights; the pickups; the chapters and the interactions. The world is built","+// once a run starts. A death rebuilds the chapter's fights at its checkpoint. Input comes from","+// game.input or, in the attract mode, from the AI pad (08); the hub's ghosts are drawn by 09."," // ---------------------------------------------------------------------------------------------"," const SPR = {","   duck: E.sprite(['..yy....', '.yYYy...', 'yYYYYyy.', 'yYYYYYYy', '.yyyyyy.', '..yyyy..'], { y: '#f2d24a', Y: '#fff2a0' }, 2),","   cannoli: E.sprite(['..ww..', '.wWWw.', 'wWsWWw', '.wWWw.', '..ww..'], { w: '#e8c890', W: '#f6e6c0', s: '#b07840' }, 2),","   ammo: E.sprite(['.bb.', 'bBBb', 'bBBb', '.bb.'], { b: '#8a6a2a', B: '#d8a84a' }, 2),","-  envelope: E.sprite(['wwwwww', 'wWWWWw', 'wWwWWw', 'wwwwww'], { w: '#c8c0a0', W: '#f4ecc8' }, 2),"," };"," ","-let W = null;   // the live world: map, hero, foes, pickups and the rest. Set by buildWorld().","+let W = null;   // the live world (map, hero, people, pickups, flags). Set by buildWorld()."," ","-function centerOf(cell) { return W.map.center(cell[0], cell[1]); }","-function groundZ(x, y) { return 0; }","+const clamp = (v, a, b) => Math.max(a, Math.min(b, v));","+const angleDiff = (a, b) => Math.abs(Math.atan2(Math.sin(a - b), Math.cos(a - b)));","+const centerOf = cell => W.map.center(cell[0], cell[1]);","+const sfx = (name, o) => game.audio.sfx(name, o);"," "," function buildWorld() {","   const floorTex = (x, y, tag) => tag === 'grass' ? E.tex.grass(x, y)","-    : tag === 'road' ? E.tex.dirt(x, y)","-    : tag === 'yard' ? E.tex.dirt(x, y)","+    : tag === 'road' || tag === 'yard' ? E.tex.dirt(x, y)","     : tag === 'water' ? E.tex.water(x, y) : E.tex.flagstone(x, y);","   const map = new E.TileMap({ rows: buildTownRows(), legend: TOWN_LEGEND, types: TOWN_TYPES, floorTex });","   for (const [id, x, y, o] of DRESS) map.solid(id, x * 16 + 8, y * 16 + 8, 0, o);","   W = {","     map, flow: new E.FlowField(map), flowT: 0,","-    shots: new E.Bullets(game, { plane: 'ground', max: 240, sparks: true }),","-    foes: [], npcs: {}, ducks: [], cannoli: [], ammo: [],","-    combo: new E.Combo(['backslash', 'overhead', 'thrust'], { window: .4 }),","-    shotCool: 0, aim: null, yardOn: false, feds: 0, fedT: 4, toast: null, toastT: 0,","-    ctl: game.input, roundOver: false, sawHome: false, frozen: 0,","+    hero: null, heroRig: makeHeroRig(), shots: new E.Bullets(game, { plane: 'ground', max: 240, sparks: true }),","+    foes: [], boss: null, combo: null, shotCool: 0, panicT: 0, yardOn: false, feds: 0, fedT: 4,","+    toast: null, toastT: 0, ctl: game.input, aim: null, frozen: false,","+    npcs: {}, ducks: [], cannoli: [], ammo: [], civs: [],","   };","   W.hero = makeHero(centerOf(START_CELL));","-  W.heroRig = makeHeroRig();","-  W.npcRigs = {};","+  W.hero.iframes = 0;","+  // the people who talk: each has a rig and a place. Vashti is in the session room, not on the street.","   for (const k of Object.keys(NPC_DEFS)) {","+    if (k === 'vashti') continue;","     const d = NPC_DEFS[k], p = centerOf(d.cell);","-    W.npcs[k] = { key: k, def: d, x: p.x, y: p.y, z: 0, rig: makeNPCRig(d) };","+    W.npcs[k] = { key: k, def: d, x: p.x, y: p.y, rig: makeNPCRig(d) };","   }","-  W.ducks = DUCKS.map(c => { const p = centerOf(c); return { x: p.x, y: p.y, taken: false }; });","-  W.cannoli = CANNOLI.map(c => { const p = centerOf(c); return { x: p.x, y: p.y, taken: false }; });","-  W.ammo = AMMO.map(c => { const p = centerOf(c); return { x: p.x, y: p.y, taken: false }; });","-  W.civs = CIVILIANS.map(c => { const p = centerOf(c); return new Foe('civ', LOOKS.civ, { x: p.x, y: p.y }); });","+  W.ducks = DUCKS.map(c => Object.assign(centerOf(c), { taken: false }));","+  W.cannoli = CANNOLI.map(c => Object.assign(centerOf(c), { taken: false }));","+  W.ammo = AMMO.map(c => Object.assign(centerOf(c), { taken: false }));","+  for (const c of CIVILIANS) { const p = centerOf(c); W.civs.push(new Foe('civ', LOOKS.civ, p)); }","   W.foes.push(...W.civs);","-  W.props = PROPS;","+  W.combo = newCombo();","   return W;"," }","+function newCombo() { return new E.Combo(['backslash', 'overhead', 'thrust'], { window: .4 }); }"," ","-// Put the hero at the chapter's checkpoint, with its fights back in place (a death, a load, a new chapter).","+// The hero's own controls: the stick through the player's inversions, the buttons from game.input.","+const PLAYER_MOVE = Object.create(game.input, { move: { value: () => stickMove(game.input) } });","+","+// Put the hero at the chapter's checkpoint, and the chapter's fights back in place."," function setChapter(n, o = {}) {","   S.chapter = n;","   const p = centerOf(CHECKPOINT[n]);","-  W.hero.x = p.x; W.hero.y = p.y; W.hero.vx = W.hero.vy = 0; W.hero.z = 0; W.hero.onGround = true;","+  Object.assign(W.hero, { x: p.x, y: p.y, vx: 0, vy: 0, z: 0, onGround: true, wall: null, action: null });","   W.hero.lastSafe = { x: p.x, y: p.y, z: 0 };","-  W.foes = W.foes.filter(f => f.kind === 'civ');","-  W.yardOn = false; W.feds = 0; W.fedT = 4;","-  W.combo = new E.Combo(['backslash', 'overhead', 'thrust'], { window: .4 });","-  if (n === 5) { S.heat = Math.max(S.heat, 80); }","+  W.foes = W.civs.slice();","+  W.boss = null; W.yardOn = false; W.feds = 0; W.fedT = 4;","+  W.combo = newCombo();","+  if (n === 5) S.heat = Math.max(S.heat, 80);","   if (!o.quiet) toast(CHAPTERS[n].title + '  ·  ' + CHAPTERS[n].goal);"," }","+function toast(text) { W.toast = text; W.toastT = 4.5; }"," ","-function toast(text) { W.toast = text; W.toastT = 4; }","-"," function spawnFoe(kind, look, cell, o = {}) {","-  const p = centerOf(cell);","-  const f = new Foe(kind, look, p, o);","+  const f = new Foe(kind, look, centerOf(cell), o);","   W.foes.push(f);","   return f;"," }"]},{"oldStart":82,"oldLines":12,"newStart":85,"newLines":10,"lines":[" }"," "," // ---- the hero's life -------------------------------------------------------------------------","-function sfx(name, o) { game.audio.sfx(name, o); }","-","-function hurtHero(n, from) {","+function hurtHero(n) {","   const hero = W.hero;","   if (hero.iframes > 0 || S.done) return;","-  const guard = W.ctl.down('block') && hero.rigState ? true : false;","+  const guard = !!W.ctl.down('block');","   const dmg = n * (guard ? .3 : 1);","   S.hp = Math.max(0, S.hp - dmg);","   S.stress = Math.min(100, S.stress + n * .4);"]},{"oldStart":101,"oldLines":11,"newStart":102,"newLines":9,"lines":["   S.deaths++;","   S.stress = Math.min(100, S.stress + 20);","   S.hp = 70;","-  W.yardOn = false;","   setChapter(S.chapter, { quiet: true });","-  if (S.chapter === 5) { S.heat = Math.max(S.heat, 60); }","-  startConv('downed', null, { quiet: true });","   game.flash('#000000', .4, .8);","+  startConv('downed', null);"," }"," "," function hurtFoe(f, n, how) {"]},{"oldStart":115,"oldLines":105,"newStart":114,"newLines":100,"lines":["   game.hitFx(f.x, f.y, f.z + 18, { power: how === 'shot' ? .8 : 1, damage: Math.round(n), sound: how === 'shot' ? 'hit' : 'punch' });","   if (f.kind === 'civ') {","     S.heat = Math.min(100, S.heat + 12);","-    for (const o of W.foes) if (o.kind === 'civ') o.flee = 6;","+    for (const o of W.civs) o.flee = 6;","     sfx('hurt');","   }","+  if (f.boss && !f.phase2 && f.hp < f.maxHp / 2) { f.phase2 = true; toast('GUS IS MAD NOW'); }","   if (f.dead) {","     if (f.kind !== 'civ') S.kills++;","     sfx('die');","-    if (f.boss) bossDown();","     if (f.kind === 'fed') W.feds = Math.max(0, W.feds - 1);","-    f.hurtT = 0;","+    if (f.boss) bossDown();","   }","-  if (f.boss && !f.phase2 && f.hp < f.maxHp / 2) { f.phase2 = true; toast('GUS IS MAD NOW'); }"," }"," "," function bossDown() {","+  if (S.bossDown) return;","   S.bossDown = true;","-  S.got.boss = true;","   toast('GUS IS DOWN. THE FEDS ARE COMING.');","   if (S.chapter === 4) {","-    setChapterQuiet(5);","-    startConv('feds', null, { quiet: true });","+    setChapter(5, { quiet: true });","+    toast(CHAPTERS[5].title + '  ·  ' + CHAPTERS[5].goal);","+    startConv('feds', null);","   }"," }","-function setChapterQuiet(n) { setChapter(n, { quiet: true }); toast(CHAPTERS[n].title + '  ·  ' + CHAPTERS[n].goal); }"," ","-// A Fed that sees the hero makes the heat rise; the heat is what the stress meter reads.","+// a Fed that sees the hero makes the heat rise"," function spotted(f, dt) {","   if (f.kind === 'fed') S.heat = Math.min(100, S.heat + 6 * dt);"," }","+function anyFedSees() { return W.foes.some(f => !f.dead && f.kind === 'fed' && f.alert > 0); }"," "," // ---- the step --------------------------------------------------------------------------------","-// ctl: the controls to read (game.input, or the attract mode's AI). intent: the walk for the Mover.","-function worldStep(dt, ctl, intent) {","+// ctl: the buttons to read (game.input, or the AI pad). walk: the Mover's controls (PLAYER_MOVE, or the AI's intent).","+function worldStep(dt, ctl, walk) {","   W.ctl = ctl;","   const hero = W.hero, map = W.map;","   S.playTime += dt;","   if (W.toastT > 0) { W.toastT -= dt; if (W.toastT <= 0) W.toast = null; }","-  hero.iframes = Math.max(0, (hero.iframes || 0) - dt);","-  const [mx, my] = intent ? [0, 0] : stickMove(ctl);","-  // walking and jumping: the Mover does the rest (climbs small ledges, keeps out of the walls)","-  if (!W.frozen) {","-    hero.update(dt, map, intent || ctl);","-    if (ctl.pressed && ctl.pressed('dodge') && !intent) hero.dodge();","+  hero.iframes = Math.max(0, hero.iframes - dt);","+  const frozen = W.frozen;","+  // walking, jumping and climbing: the Mover keeps out of the walls and up the small ledges","+  if (!frozen) {","+    hero.update(dt, map, walk);","+    if (walk === PLAYER_MOVE && ctl.pressed('dodge')) hero.dodge();","   }","-  // the attack: the bat's combo, one press a swing","+  // the bat: a combo, one press a swing, hitting each foe once a swing","   const combo = W.combo;","-  if (!W.frozen && ctl.pressed('attack') && !combo.busy) combo.press();","+  if (!frozen && W.panicT <= 0 && ctl.pressed('attack') && !combo.busy) combo.press();","   if (combo.busy) {","     combo.update(dt);","-    combo.hits(W.foes.filter(f => !f.dead && f.kind !== 'civ' || (f.kind === 'civ' && !f.dead)), f => E.inArc(hero, hero.facing, f, 24, 1.25, 22), f => hurtFoe(f, 16, 'melee'));","+    combo.hits(W.foes.filter(f => !f.dead), f => E.inArc(hero, hero.facing, f, 24, 1.25, 22), f => hurtFoe(f, 16, 'melee'));","   }","-  // the pistol: the mouse aims where it points; otherwise the nearest foe in front","+  // the pistol: where the mouse points, or else the nearest foe in front","   W.shotCool = Math.max(0, W.shotCool - dt);","-  if (!W.frozen && ctl.pressed('use') && W.shotCool <= 0 && S.ammo > 0) fire(ctl);","+  if (!frozen && W.panicT <= 0 && ctl.pressed('use') && W.shotCool <= 0 && S.ammo > 0) fire();","   W.shots.update(dt, map);","   W.shots.hit(W.foes.filter(f => !f.dead), (b, f) => hurtFoe(f, b.dmg, 'shot'), 'player');","-  W.shots.hit([hero], (b) => hurtHero(b.dmg, null), 'enemy');","+  W.shots.hit([hero], () => hurtHero(18), 'enemy');","   // the people","   for (const f of W.foes) {","     if (f.dead && f.dieT > 3) continue;","-    f.step(dt, { hero, map, flow: W.flow, shots: W.shots, world: WORLD_API });","+    if (frozen) { f.rig.update(dt, f.rigState(f.dead ? 'die' : null)); continue; }","+    f.step(dt, { hero, map, flow: W.flow, shots: W.shots, world: WORLD });","   }","-  W.foes = W.foes.filter(f => !(f.dead && f.dieT > 3 && f.kind !== 'civ') && !(f.kind === 'civ' && f.dead && f.dieT > 3));","+  W.foes = W.foes.filter(f => !(f.dead && f.dieT > 3));","   W.flowT -= dt;","   if (W.flowT <= 0) { W.flow.update(hero.x, hero.y); W.flowT = .3; }","   for (const k of Object.keys(W.npcs)) {","     const n = W.npcs[k];","-    const face = Math.atan2(hero.y - n.y, hero.x - n.x);","-    n.rig.update(dt, { x: n.x, y: n.y, z: 0, vx: 0, vy: 0, facing: face, stance: undefined });","+    n.rig.update(dt, { x: n.x, y: n.y, z: 0, vx: 0, vy: 0, facing: Math.atan2(hero.y - n.y, hero.x - n.x) });","   }","-  // pickups","-  for (const p of W.cannoli) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.hp = Math.min(100, S.hp + 25); S.stress = Math.max(0, S.stress - 10); S.cannoli++; sfx('pickup'); toast('CANNOLI. ONE FOR THE ROAD.'); }","+  // pickups: a cannoli heals and calms; shells; a duck in the pool (a side collection)","+  for (const p of W.cannoli) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.hp = Math.min(100, S.hp + 25); S.stress = Math.max(0, S.stress - 10); S.cannoli++; sfx('pickup'); toast('A CANNOLI. ONE FOR THE ROAD.'); }","   for (const p of W.ammo) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.ammo += 8; sfx('pickup'); toast('+8 SHELLS'); }","   for (const p of W.ducks) if (!p.taken && E.dist(hero, p) < 16) { p.taken = true; S.ducks++; sfx('coin'); toast('A DUCK. THE POOL IS OPEN.'); }","-  // the chapters, and the interactions","   chapterStep(dt);","-  if (!W.frozen && ctl.pressed('interact')) {","-    const hit = nearestInteractable();","-    if (hit) hit.use();","+  if (!frozen && !talk.open && ctl.pressed('interact')) {","+    const it = nearestInteractable();","+    if (it) it.use();","   }","-  // the stress: a rising heat and a fight both build it; a rest lowers it. At 100 it's a panic attack.","-  const threat = S.heat > 50 ? 1.2 : 0;","-  S.stress = clamp(S.stress + threat * dt - 1.2 * dt * (threat ? 0 : 1), 0, 100);","-  if (S.stress >= 100 && !W.panicT) { W.panicT = 3; toast('PANIC. BREATHE.'); sfx('cancel'); }","+  // the stress: a hot Fed raises it, a quiet street lowers it. At 100 it is a panic attack.","+  S.stress = clamp(S.stress + (S.heat > 50 ? 1.2 : -1.2) * dt, 0, 100);","+  if (S.stress >= 100 && W.panicT <= 0) { W.panicT = 3; S.stress = 100; toast('PANIC. BREATHE.'); sfx('cancel'); }","   if (W.panicT > 0) { W.panicT -= dt; if (W.panicT <= 0) { W.panicT = 0; S.stress = 60; } }","-  S.heat = Math.max(0, S.heat - (anySeen() ? 0 : 2.5) * dt);","-  // the look: the hero's rig from its motion and its blows","-  const rigExtra = combo.busy ? { attack: combo.state } : {};","-  if (ctl.down('block')) rigExtra.pose = 'guard';","-  W.heroRig.update(dt, hero.rigState(rigExtra));","-  // the camera's aim is the mouse's on the ground when it was used last","+  S.heat = Math.max(0, S.heat - (anyFedSees() ? 0 : 2.5) * dt);","+  // the look: the rigs take their pose from the bodies and the blows","+  const extra = combo.busy ? { attack: combo.state } : {};","+  if (ctl.down('block')) extra.pose = 'guard';","+  W.heroRig.update(dt, hero.rigState(extra));","+  // where the mouse points on the ground, when it's the device in use (the pistol's aim)","   W.aim = null;","-  if (game.input.lastDevice === 'mouse') { const m = game.mouseGround && game.mouseGround(); if (m) W.aim = m; }","-  // sending the hub what it needs: the hero's place (ghosts), and the progress","+  if (game.input.lastDevice === 'mouse') W.aim = game.mouseGround ? game.mouseGround() : null;","   hubTick(dt);"," }"," ","-function anySeen() { return W.foes.some(f => !f.dead && f.kind === 'fed' && f.alert > 0); }","-","-function fire(ctl) {","+function fire() {","   const hero = W.hero;","   let ang = hero.facing;","   if (W.aim) ang = Math.atan2(W.aim[1] - hero.y, W.aim[0] - hero.x);"]},{"oldStart":221,"oldLines":8,"newStart":215,"newLines":8,"lines":["     let best = null, bd = 170;","     for (const f of W.foes) {","       if (f.dead || f.kind === 'civ') continue;","-      const d = E.dist(hero, f);","-      if (d < bd && Math.abs(E.angDiff ? E.angDiff(Math.atan2(f.y - hero.y, f.x - hero.x), hero.facing) : 0) < .8) { best = f; bd = d; }","+      const d = E.dist(hero, f), a = Math.atan2(f.y - hero.y, f.x - hero.x);","+      if (d < bd && angleDiff(a, hero.facing) < .8) { best = f; bd = d; }","     }","     if (best) ang = Math.atan2(best.y - hero.y, best.x - hero.x);","   }"]},{"oldStart":231,"oldLines":10,"newStart":225,"newLines":9,"lines":["   S.ammo--; W.shotCool = .32;","   sfx('shoot');","   game.shake(1.5);","-  W.heroRig.update(0, {});"," }"," ","-// ---- the places the hero can use (their interactions) ----------------------------------------","+// ---- the things the hero can use -------------------------------------------------------------"," function interactables() {","   const out = [];","   const add = (id, cell, label, use, r = 24) => { const p = centerOf(cell); out.push({ id, x: p.x, y: p.y, label, use, r }); };"]},{"oldStart":244,"oldLines":8,"newStart":237,"newLines":8,"lines":["     if (!S.got.tina) add('tina', NPC_DEFS.tina.cell, 'Tina', () => collect('tina', 1500));","   }","   if (S.chapter === 2) add('lou', NPC_DEFS.lou.cell, 'Big Lou', () => startConv('lou', () => { S.lou = true; setChapter(3); }));","-  if (S.chapter === 3) add('vashti', [27, 23], 'Dr. Vashti’s door', () => { game.go('session', { from: 'play' }); });","-  if (S.chapter === 5 || S.done) add('home', [8, 13], 'Ma’s house', () => { if (!S.done) finish(); }, 26);","+  if (S.chapter === 3) add('vashti', [27, 23], 'Dr. Vashti’s door', () => game.go('session', { from: 'play' }));","+  if (S.chapter === 5 && !S.done) add('home', [8, 13], 'Ma’s house', () => startConv('home', () => finish()), 26);","   return out;"," }"," function nearestInteractable() {"]},{"oldStart":253,"oldLines":55,"newStart":246,"newLines":50,"lines":["   for (const it of interactables()) { const d = Math.hypot(it.x - W.hero.x, it.y - W.hero.y); if (d < it.r && d < bd) { best = it; bd = d; } }","   return best;"," }","-function collect(key, cash, extra) {","-  S.got[key] = true; S.cash += cash; sfx('coin');","+function collect(key, cash) {","+  S.got[key] = true; S.cash += cash;","+  sfx('coin');","+  toast('+$' + cash + ' from ' + SPEAKER_NAMES[key]);","   startConv(key, () => {","     if (S.got.ricci && S.got.dorothy && S.got.tina) { setChapter(2); }","   });","-  toast('+$' + cash + '  ·  ' + SPEAKER_NAMES[key === 'ricci' ? 'ricci' : key] );"," }"," "," // ---- the chapters ----------------------------------------------------------------------------"," function chapterStep(dt) {","   const hero = W.hero;","-  const in4 = zoneAt(hero.x, hero.y) === 'yard';","-  if (S.chapter === 4 && !S.bossDown && in4 && !W.yardOn) {","+  if (S.chapter === 4 && !S.bossDown && !W.yardOn && zoneAt(hero.x, hero.y) === 'yard') {","     spawnYard();","-    startConv('gus', null, { quiet: true });","-    toast('THE YARD · PUT GUS DOWN');","+    startConv('gus', null);","+    toast('THE YARD  ·  PUT GUS DOWN');","   }","   if (S.chapter === 5 && !S.done) {","     W.fedT -= dt;","     const alive = W.foes.filter(f => f.kind === 'fed' && !f.dead).length;","     if (W.fedT <= 0 && alive < (S.heat > 60 ? 5 : 3)) { spawnFed(); W.fedT = 5; }","   }","-  if (S.chapter === 4 && W.boss && W.boss.dead && !S.bossDown) bossDown();","+  if (S.chapter === 4 && W.boss && W.boss.dead) bossDown();"," }"," ","-// The Mover's ground, for when the hero leaves the map. A hard edge of the map is a hedge, so this is a safety.","-function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }","-"," function finish() {","+  if (S.done) return;","   S.done = true;","-  W.roundOver = true;","-  sfx('victory');","+  sfx('powerup');","   if (HUB) {","     HUB.result({ time: Math.max(1, Math.round(HUB.time())), stats: { deaths: S.deaths, kills: S.kills, cash: S.cash }, awards: awardsFor() });","-    toast('ROUND COMPLETE. WAITING FOR THE OTHERS.');","-    W.frozen = 1;","+    toast('ROUND COMPLETE. WAITING ON THE OTHERS.');","+    W.frozen = true;","   } else {","     game.go('end', { won: true });","   }"," }","-"," function awardsFor() {","   const out = [];","   if (S.deaths === 0) out.push({ title: 'Never went down', detail: 'Finished without a death.' });","   if (S.ducks >= DUCKS.length) out.push({ title: 'Ducks in the pool', detail: 'Found all the ducks.' });","   return out;"," }","-","-// What the hub's time-up and results read: the progress of the run, as a number","+// The run's progress as one number (the hub's scoreboard, and the time-up result)"," function scoreNow() { return S.cash + S.respect * 100 + S.kills * 50 + S.ducks * 200 + (S.chapter - 1) * 500; }"," "," // ---- drawing ----------------------------------------------------------------------------------"]},{"oldStart":314,"oldLines":29,"newStart":302,"newLines":31,"lines":["   map.queueWalls(r);","   for (const p of W.cannoli) if (!p.taken) { r.sprite(p.x, p.y, 8 + Math.sin(game.time * 3) * 1.2, SPR.cannoli, { glow: .3 }); game.lights.add(p.x, p.y, 10, 22, .4, { color: '#ffd9a0' }); }","   for (const p of W.ammo) if (!p.taken) r.sprite(p.x, p.y, 6, SPR.ammo, { glow: .2 });","-  // the names over the people; who's talking is the talk box's","+  const near = nearestInteractable();","   for (const k of Object.keys(W.npcs)) {","     const n = W.npcs[k];","     r.shadow(n.x, n.y, 5, .35, undefined, 0);","     r.actor(n.x, n.y, 0, (g, ox, oy) => n.rig.draw(g, ox, oy, r.view));","+    r.textAt(n.x, n.y, 44, SPEAKER_NAMES[k], near && near.id === k ? '#ffe08a' : '#e8e0f0', { outline: true });","   }","-  const near = nearestInteractable();","-  for (const it of interactables()) if (it.id !== 'home' || S.chapter === 5) {","-    const npc = W.npcs[it.id];","-    if (npc) r.textAt(npc.x, npc.y, 44, SPEAKER_NAMES[it.id] || it.label, near && near.id === it.id ? '#ffe08a' : '#e8e0f0', { outline: true });","-  }","   for (const f of W.foes) {","     if (f.dead && f.dieT > 2.5) continue;","     const alpha = f.dead ? clamp(1 - (f.dieT - 2.5) * 2, 0, 1) : 1;","     r.shadow(f.x, f.y, 5, .35, undefined, 0);","-    r.actor(f.x, f.y, f.z, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ff5050' : false, alpha, hides: false });","+    r.actor(f.x, f.y, f.z, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ff5050' : false, alpha });","     if (!f.dead && f.kind !== 'civ' && (f.alert > 0 || f.boss)) r.textAt(f.x, f.y, 46, f.name, f.boss ? '#ffb040' : '#e8e0f0', { outline: true });","   }","   r.shadow(hero.x, hero.y, 6, .4, undefined, 0);","   r.actor(hero.x, hero.y, hero.z, (g, ox, oy) => W.heroRig.draw(g, ox, oy, r.view), { flash: hero.iframes > .3 ? '#ff5050' : false, flashMix: .4 });","   W.shots.draw(r);","   drawGhosts(r);","-  if (W.aim && game.input.lastDevice === 'mouse') r.groundRing && r.groundRing(W.aim[0], W.aim[1], 6, '#ffd36a', .6);","-  if (!S.done && near) game.lights.add(near.x, near.y, 14, 26, .5, { color: '#ffe08a' });","   if (S.chapter === 5 && !S.done) { const h = centerOf([8, 13]); game.lights.add(h.x, h.y, 16, 36, .6, { color: '#ffd090' }); }","+  if (near && !S.done) game.lights.add(near.x, near.y, 14, 26, .5, { color: '#ffe08a' });"," }","+","+// the world's callbacks for the people (their hits and sounds)","+const WORLD = {","+  hurtHero: (n, from) => hurtHero(n, from),","+  spotted: (f, dt) => spotted(f, dt),","+  sfx: (name) => sfx(name),","+};"]}],"originalFile":"// ---------------------------------------------------------------------------------------------\n// 04 · WORLD — the town and the story's rules: the hero's controls and combat, the people, the\n// pickups and the chapters. The world is built once a run starts; a death rebuilds the\n// chapter's fights at its checkpoint. Input comes from game.input or, in the attract mode, from AI.\n// ---------------------------------------------------------------------------------------------\nconst SPR = {\n  duck: E.sprite(['..yy....', '.yYYy...', 'yYYYYyy.', 'yYYYYYYy', '.yyyyyy.', '..yyyy..'], { y: '#f2d24a', Y: '#fff2a0' }, 2),\n  cannoli: E.sprite(['..ww..', '.wWWw.', 'wWsWWw', '.wWWw.', '..ww..'], { w: '#e8c890', W: '#f6e6c0', s: '#b07840' }, 2),\n  ammo: E.sprite(['.bb.', 'bBBb', 'bBBb', '.bb.'], { b: '#8a6a2a', B: '#d8a84a' }, 2),\n  envelope: E.sprite(['wwwwww', 'wWWWWw', 'wWwWWw', 'wwwwww'], { w: '#c8c0a0', W: '#f4ecc8' }, 2),\n};\n\nlet W = null;   // the live world: map, hero, foes, pickups and the rest. Set by buildWorld().\n\nfunction centerOf(cell) { return W.map.center(cell[0], cell[1]); }\nfunction groundZ(x, y) { return 0; }\n\nfunction buildWorld() {\n  const floorTex = (x, y, tag) => tag === 'grass' ? E.tex.grass(x, y)\n    : tag === 'road' ? E.tex.dirt(x, y)\n    : tag === 'yard' ? E.tex.dirt(x, y)\n    : tag === 'water' ? E.tex.water(x, y) : E.tex.flagstone(x, y);\n  const map = new E.TileMap({ rows: buildTownRows(), legend: TOWN_LEGEND, types: TOWN_TYPES, floorTex });\n  for (const [id, x, y, o] of DRESS) map.solid(id, x * 16 + 8, y * 16 + 8, 0, o);\n  W = {\n    map, flow: new E.FlowField(map), flowT: 0,\n    shots: new E.Bullets(game, { plane: 'ground', max: 240, sparks: true }),\n    foes: [], npcs: {}, ducks: [], cannoli: [], ammo: [],\n    combo: new E.Combo(['backslash', 'overhead', 'thrust'], { window: .4 }),\n    shotCool: 0, aim: null, yardOn: false, feds: 0, fedT: 4, toast: null, toastT: 0,\n    ctl: game.input, roundOver: false, sawHome: false, frozen: 0,\n  };\n  W.hero = makeHero(centerOf(START_CELL));\n  W.heroRig = makeHeroRig();\n  W.npcRigs = {};\n  for (const k of Object.keys(NPC_DEFS)) {\n    const d = NPC_DEFS[k], p = centerOf(d.cell);\n    W.npcs[k] = { key: k, def: d, x: p.x, y: p.y, z: 0, rig: makeNPCRig(d) };\n  }\n  W.ducks = DUCKS.map(c => { const p = centerOf(c); return { x: p.x, y: p.y, taken: false }; });\n  W.cannoli = CANNOLI.map(c => { const p = centerOf(c); return { x: p.x, y: p.y, taken: false }; });\n  W.ammo = AMMO.map(c => { const p = centerOf(c); return { x: p.x, y: p.y, taken: false }; });\n  W.civs = CIVILIANS.map(c => { const p = centerOf(c); return new Foe('civ', LOOKS.civ, { x: p.x, y: p.y }); });\n  W.foes.push(...W.civs);\n  W.props = PROPS;\n  return W;\n}\n\n// Put the hero at the chapter's checkpoint, with its fights back in place (a death, a load, a new chapter).\nfunction setChapter(n, o = {}) {\n  S.chapter = n;\n  const p = centerOf(CHECKPOINT[n]);\n  W.hero.x = p.x; W.hero.y = p.y; W.hero.vx = W.hero.vy = 0; W.hero.z = 0; W.hero.onGround = true;\n  W.hero.lastSafe = { x: p.x, y: p.y, z: 0 };\n  W.foes = W.foes.filter(f => f.kind === 'civ');\n  W.yardOn = false; W.feds = 0; W.fedT = 4;\n  W.combo = new E.Combo(['backslash', 'overhead', 'thrust'], { window: .4 });\n  if (n === 5) { S.heat = Math.max(S.heat, 80); }\n  if (!o.quiet) toast(CHAPTERS[n].title + '  ·  ' + CHAPTERS[n].goal);\n}\n\nfunction toast(text) { W.toast = text; W.toastT = 4; }\n\nfunction spawnFoe(kind, look, cell, o = {}) {\n  const p = centerOf(cell);\n  const f = new Foe(kind, look, p, o);\n  W.foes.push(f);\n  return f;\n}\nfunction spawnYard() {\n  spawnFoe('crew', LOOKS.benny, [36, 28], { name: 'BENNY' });\n  spawnFoe('crew', LOOKS.richie, [39, 33], { name: 'RICHIE' });\n  spawnFoe('crew', LOOKS.frankie, [35, 34], { name: 'FRANKIE' });\n  W.boss = spawnFoe('boss', LOOKS.gus, [38, 30], { name: 'GUS' });\n  W.yardOn = true;\n}\nfunction spawnFed() {\n  const west = Math.random() < .5;\n  const f = spawnFoe('fed', LOOKS.fed, west ? [1, 19] : [58, 20], { name: 'AGENT' });\n  f.alert = 4; W.feds++;\n  return f;\n}\n\n// ---- the hero's life -------------------------------------------------------------------------\nfunction sfx(name, o) { game.audio.sfx(name, o); }\n\nfunction hurtHero(n, from) {\n  const hero = W.hero;\n  if (hero.iframes > 0 || S.done) return;\n  const guard = W.ctl.down('block') && hero.rigState ? true : false;\n  const dmg = n * (guard ? .3 : 1);\n  S.hp = Math.max(0, S.hp - dmg);\n  S.stress = Math.min(100, S.stress + n * .4);\n  hero.iframes = .5;\n  game.shake(3 + n / 4);\n  game.hitFx(hero.x, hero.y, hero.z + 18, { power: .6, damage: Math.round(dmg), sound: guard ? 'select' : 'hurt' });\n  if (S.hp <= 0) heroDown();\n}\n\nfunction heroDown() {\n  S.deaths++;\n  S.stress = Math.min(100, S.stress + 20);\n  S.hp = 70;\n  W.yardOn = false;\n  setChapter(S.chapter, { quiet: true });\n  if (S.chapter === 5) { S.heat = Math.max(S.heat, 60); }\n  startConv('downed', null, { quiet: true });\n  game.flash('#000000', .4, .8);\n}\n\nfunction hurtFoe(f, n, how) {\n  if (f.dead) return;\n  f.takeHit(n, W.hero);\n  E.knockback(W.hero, f, how === 'shot' ? 40 : 90);\n  game.hitFx(f.x, f.y, f.z + 18, { power: how === 'shot' ? .8 : 1, damage: Math.round(n), sound: how === 'shot' ? 'hit' : 'punch' });\n  if (f.kind === 'civ') {\n    S.heat = Math.min(100, S.heat + 12);\n    for (const o of W.foes) if (o.kind === 'civ') o.flee = 6;\n    sfx('hurt');\n  }\n  if (f.dead) {\n    if (f.kind !== 'civ') S.kills++;\n    sfx('die');\n    if (f.boss) bossDown();\n    if (f.kind === 'fed') W.feds = Math.max(0, W.feds - 1);\n    f.hurtT = 0;\n  }\n  if (f.boss && !f.phase2 && f.hp < f.maxHp / 2) { f.phase2 = true; toast('GUS IS MAD NOW'); }\n}\n\nfunction bossDown() {\n  S.bossDown = true;\n  S.got.boss = true;\n  toast('GUS IS DOWN. THE FEDS ARE COMING.');\n  if (S.chapter === 4) {\n    setChapterQuiet(5);\n    startConv('feds', null, { quiet: true });\n  }\n}\nfunction setChapterQuiet(n) { setChapter(n, { quiet: true }); toast(CHAPTERS[n].title + '  ·  ' + CHAPTERS[n].goal); }\n\n// A Fed that sees the hero makes the heat rise; the heat is what the stress meter reads.\nfunction spotted(f, dt) {\n  if (f.kind === 'fed') S.heat = Math.min(100, S.heat + 6 * dt);\n}\n\n// ---- the step --------------------------------------------------------------------------------\n// ctl: the controls to read (game.input, or the attract mode's AI). intent: the walk for the Mover.\nfunction worldStep(dt, ctl, intent) {\n  W.ctl = ctl;\n  const hero = W.hero, map = W.map;\n  S.playTime += dt;\n  if (W.toastT > 0) { W.toastT -= dt; if (W.toastT <= 0) W.toast = null; }\n  hero.iframes = Math.max(0, (hero.iframes || 0) - dt);\n  const [mx, my] = intent ? [0, 0] : stickMove(ctl);\n  // walking and jumping: the Mover does the rest (climbs small ledges, keeps out of the walls)\n  if (!W.frozen) {\n    hero.update(dt, map, intent || ctl);\n    if (ctl.pressed && ctl.pressed('dodge') && !intent) hero.dodge();\n  }\n  // the attack: the bat's combo, one press a swing\n  const combo = W.combo;\n  if (!W.frozen && ctl.pressed('attack') && !combo.busy) combo.press();\n  if (combo.busy) {\n    combo.update(dt);\n    combo.hits(W.foes.filter(f => !f.dead && f.kind !== 'civ' || (f.kind === 'civ' && !f.dead)), f => E.inArc(hero, hero.facing, f, 24, 1.25, 22), f => hurtFoe(f, 16, 'melee'));\n  }\n  // the pistol: the mouse aims where it points; otherwise the nearest foe in front\n  W.shotCool = Math.max(0, W.shotCool - dt);\n  if (!W.frozen && ctl.pressed('use') && W.shotCool <= 0 && S.ammo > 0) fire(ctl);\n  W.shots.update(dt, map);\n  W.shots.hit(W.foes.filter(f => !f.dead), (b, f) => hurtFoe(f, b.dmg, 'shot'), 'player');\n  W.shots.hit([hero], (b) => hurtHero(b.dmg, null), 'enemy');\n  // the people\n  for (const f of W.foes) {\n    if (f.dead && f.dieT > 3) continue;\n    f.step(dt, { hero, map, flow: W.flow, shots: W.shots, world: WORLD_API });\n  }\n  W.foes = W.foes.filter(f => !(f.dead && f.dieT > 3 && f.kind !== 'civ') && !(f.kind === 'civ' && f.dead && f.dieT > 3));\n  W.flowT -= dt;\n  if (W.flowT <= 0) { W.flow.update(hero.x, hero.y); W.flowT = .3; }\n  for (const k of Object.keys(W.npcs)) {\n    const n = W.npcs[k];\n    const face = Math.atan2(hero.y - n.y, hero.x - n.x);\n    n.rig.update(dt, { x: n.x, y: n.y, z: 0, vx: 0, vy: 0, facing: face, stance: undefined });\n  }\n  // pickups\n  for (const p of W.cannoli) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.hp = Math.min(100, S.hp + 25); S.stress = Math.max(0, S.stress - 10); S.cannoli++; sfx('pickup'); toast('CANNOLI. ONE FOR THE ROAD.'); }\n  for (const p of W.ammo) if (!p.taken && E.dist(hero, p) < 14) { p.taken = true; S.ammo += 8; sfx('pickup'); toast('+8 SHELLS'); }\n  for (const p of W.ducks) if (!p.taken && E.dist(hero, p) < 16) { p.taken = true; S.ducks++; sfx('coin'); toast('A DUCK. THE POOL IS OPEN.'); }\n  // the chapters, and the interactions\n  chapterStep(dt);\n  if (!W.frozen && ctl.pressed('interact')) {\n    const hit = nearestInteractable();\n    if (hit) hit.use();\n  }\n  // the stress: a rising heat and a fight both build it; a rest lowers it. At 100 it's a panic attack.\n  const threat = S.heat > 50 ? 1.2 : 0;\n  S.stress = clamp(S.stress + threat * dt - 1.2 * dt * (threat ? 0 : 1), 0, 100);\n  if (S.stress >= 100 && !W.panicT) { W.panicT = 3; toast('PANIC. BREATHE.'); sfx('cancel'); }\n  if (W.panicT > 0) { W.panicT -= dt; if (W.panicT <= 0) { W.panicT = 0; S.stress = 60; } }\n  S.heat = Math.max(0, S.heat - (anySeen() ? 0 : 2.5) * dt);\n  // the look: the hero's rig from its motion and its blows\n  const rigExtra = combo.busy ? { attack: combo.state } : {};\n  if (ctl.down('block')) rigExtra.pose = 'guard';\n  W.heroRig.update(dt, hero.rigState(rigExtra));\n  // the camera's aim is the mouse's on the ground when it was used last\n  W.aim = null;\n  if (game.input.lastDevice === 'mouse') { const m = game.mouseGround && game.mouseGround(); if (m) W.aim = m; }\n  // sending the hub what it needs: the hero's place (ghosts), and the progress\n  hubTick(dt);\n}\n\nfunction anySeen() { return W.foes.some(f => !f.dead && f.kind === 'fed' && f.alert > 0); }\n\nfunction fire(ctl) {\n  const hero = W.hero;\n  let ang = hero.facing;\n  if (W.aim) ang = Math.atan2(W.aim[1] - hero.y, W.aim[0] - hero.x);\n  else {\n    let best = null, bd = 170;\n    for (const f of W.foes) {\n      if (f.dead || f.kind === 'civ') continue;\n      const d = E.dist(hero, f);\n      if (d < bd && Math.abs(E.angDiff ? E.angDiff(Math.atan2(f.y - hero.y, f.x - hero.x), hero.facing) : 0) < .8) { best = f; bd = d; }\n    }\n    if (best) ang = Math.atan2(best.y - hero.y, best.x - hero.x);\n  }\n  W.shots.fire({ x: hero.x + Math.cos(ang) * 6, y: hero.y + Math.sin(ang) * 6, z: hero.z + 14, vx: Math.cos(ang) * 320, vy: Math.sin(ang) * 320, vz: 0, r: 2, team: 'player', color: '#ffd36a', life: 1, dmg: 30, core: true });\n  hero.facing = ang;\n  S.ammo--; W.shotCool = .32;\n  sfx('shoot');\n  game.shake(1.5);\n  W.heroRig.update(0, {});\n}\n\n// ---- the places the hero can use (their interactions) ----------------------------------------\nfunction interactables() {\n  const out = [];\n  const add = (id, cell, label, use, r = 24) => { const p = centerOf(cell); out.push({ id, x: p.x, y: p.y, label, use, r }); };\n  if (S.chapter === 1) {\n    if (!S.got.ricci) add('ricci', NPC_DEFS.ricci.cell, 'Sal Ricci', () => collect('ricci', 800));\n    if (!S.got.dorothy) add('dorothy', NPC_DEFS.dorothy.cell, 'Dorothy', () => collect('dorothy', 450));\n    if (!S.got.tina) add('tina', NPC_DEFS.tina.cell, 'Tina', () => collect('tina', 1500));\n  }\n  if (S.chapter === 2) add('lou', NPC_DEFS.lou.cell, 'Big Lou', () => startConv('lou', () => { S.lou = true; setChapter(3); }));\n  if (S.chapter === 3) add('vashti', [27, 23], 'Dr. Vashti’s door', () => { game.go('session', { from: 'play' }); });\n  if (S.chapter === 5 || S.done) add('home', [8, 13], 'Ma’s house', () => { if (!S.done) finish(); }, 26);\n  return out;\n}\nfunction nearestInteractable() {\n  let best = null, bd = Infinity;\n  for (const it of interactables()) { const d = Math.hypot(it.x - W.hero.x, it.y - W.hero.y); if (d < it.r && d < bd) { best = it; bd = d; } }\n  return best;\n}\nfunction collect(key, cash, extra) {\n  S.got[key] = true; S.cash += cash; sfx('coin');\n  startConv(key, () => {\n    if (S.got.ricci && S.got.dorothy && S.got.tina) { setChapter(2); }\n  });\n  toast('+$' + cash + '  ·  ' + SPEAKER_NAMES[key === 'ricci' ? 'ricci' : key] );\n}\n\n// ---- the chapters ----------------------------------------------------------------------------\nfunction chapterStep(dt) {\n  const hero = W.hero;\n  const in4 = zoneAt(hero.x, hero.y) === 'yard';\n  if (S.chapter === 4 && !S.bossDown && in4 && !W.yardOn) {\n    spawnYard();\n    startConv('gus', null, { quiet: true });\n    toast('THE YARD · PUT GUS DOWN');\n  }\n  if (S.chapter === 5 && !S.done) {\n    W.fedT -= dt;\n    const alive = W.foes.filter(f => f.kind === 'fed' && !f.dead).length;\n    if (W.fedT <= 0 && alive < (S.heat > 60 ? 5 : 3)) { spawnFed(); W.fedT = 5; }\n  }\n  if (S.chapter === 4 && W.boss && W.boss.dead && !S.bossDown) bossDown();\n}\n\n// The Mover's ground, for when the hero leaves the map. A hard edge of the map is a hedge, so this is a safety.\nfunction clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\n\nfunction finish() {\n  S.done = true;\n  W.roundOver = true;\n  sfx('victory');\n  if (HUB) {\n    HUB.result({ time: Math.max(1, Math.round(HUB.time())), stats: { deaths: S.deaths, kills: S.kills, cash: S.cash }, awards: awardsFor() });\n    toast('ROUND COMPLETE. WAITING FOR THE OTHERS.');\n    W.frozen = 1;\n  } else {\n    game.go('end', { won: true });\n  }\n}\n\nfunction awardsFor() {\n  const out = [];\n  if (S.deaths === 0) out.push({ title: 'Never went down', detail: 'Finished without a death.' });\n  if (S.ducks >= DUCKS.length) out.push({ title: 'Ducks in the pool', detail: 'Found all the ducks.' });\n  return out;\n}\n\n// What the hub's time-up and results read: the progress of the run, as a number\nfunction scoreNow() { return S.cash + S.respect * 100 + S.kills * 50 + S.ducks * 200 + (S.chapter - 1) * 500; }\n\n// ---- drawing ----------------------------------------------------------------------------------\nfunction drawWorld(r) {\n  const hero = W.hero, map = W.map;\n  map.drawFloor(r);\n  for (const p of W.ducks) if (!p.taken) r.sprite(p.x, p.y, 4 + Math.sin(game.time * 2 + p.x) * .6, SPR.duck, { anchor: 'bottom' });\n  for (const [name, cx, cy, o] of PROPS) r.prop(name, cx * 16 + 8, cy * 16 + 8, 0, Object.assign({ size: 1.2 }, o));\n  for (const [id, cx, cy, o] of DRESS) r.shape(id, cx * 16 + 8, cy * 16 + 8, 0, o);\n  map.queueWalls(r);\n  for (const p of W.cannoli) if (!p.taken) { r.sprite(p.x, p.y, 8 + Math.sin(game.time * 3) * 1.2, SPR.cannoli, { glow: .3 }); game.lights.add(p.x, p.y, 10, 22, .4, { color: '#ffd9a0' }); }\n  for (const p of W.ammo) if (!p.taken) r.sprite(p.x, p.y, 6, SPR.ammo, { glow: .2 });\n  // the names over the people; who's talking is the talk box's\n  for (const k of Object.keys(W.npcs)) {\n    const n = W.npcs[k];\n    r.shadow(n.x, n.y, 5, .35, undefined, 0);\n    r.actor(n.x, n.y, 0, (g, ox, oy) => n.rig.draw(g, ox, oy, r.view));\n  }\n  const near = nearestInteractable();\n  for (const it of interactables()) if (it.id !== 'home' || S.chapter === 5) {\n    const npc = W.npcs[it.id];\n    if (npc) r.textAt(npc.x, npc.y, 44, SPEAKER_NAMES[it.id] || it.label, near && near.id === it.id ? '#ffe08a' : '#e8e0f0', { outline: true });\n  }\n  for (const f of W.foes) {\n    if (f.dead && f.dieT > 2.5) continue;\n    const alpha = f.dead ? clamp(1 - (f.dieT - 2.5) * 2, 0, 1) : 1;\n    r.shadow(f.x, f.y, 5, .35, undefined, 0);\n    r.actor(f.x, f.y, f.z, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ff5050' : false, alpha, hides: false });\n    if (!f.dead && f.kind !== 'civ' && (f.alert > 0 || f.boss)) r.textAt(f.x, f.y, 46, f.name, f.boss ? '#ffb040' : '#e8e0f0', { outline: true });\n  }\n  r.shadow(hero.x, hero.y, 6, .4, undefined, 0);\n  r.actor(hero.x, hero.y, hero.z, (g, ox, oy) => W.heroRig.draw(g, ox, oy, r.view), { flash: hero.iframes > .3 ? '#ff5050' : false, flashMix: .4 });\n  W.shots.draw(r);\n  drawGhosts(r);\n  if (W.aim && game.input.lastDevice === 'mouse') r.groundRing && r.groundRing(W.aim[0], W.aim[1], 6, '#ffd36a', .6);\n  if (!S.done && near) game.lights.add(near.x, near.y, 14, 26, .5, { color: '#ffe08a' });\n  if (S.chapter === 5 && !S.done) { const h = centerOf([8, 13]); game.lights.add(h.x, h.y, 16, 36, .6, { color: '#ffd090' }); }\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_01SFia3G8u8yiUrDyLB8gDKP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
