rom = d.from || \\x27title\\x27; about.page = 0; about.scroll = 0; playSong(\\x27final\\x27); },\\n  update(dt) {\\n    const I = game.input, n = aboutPages().length;\\n    if (I.pressed(\\x27cancel\\x27) || (I.pressed(\\x27confirm\\x27) && about.page === n - 1)) { game.go(about.from === \\x27end\\x27 ? \\x27end\\x27 : \\x27title\\x27); return; }\\n    if (I.pressed(\\x27right\\x27) || I.pressed(\\x27confirm\\x27)) { about.page = (about.page + 1) % n; about.scroll = 0; }\\n    if (I.pressed(\\x27left\\x27)) { about.page = (about.page + n - 1) % n; about.scroll = 0; }\\n    if (I.down(\\x27down\\x27)) about.scroll += 60 * dt;\\n    if (I.down(\\x27up\\x27)) about.scroll = Math.max(0, about.scroll - 60 * dt);\\n  },\"],\n  [\"    const pages = aboutPages(), p = pages[this.page];\", \"    const pages = aboutPages(), p = pages[about.page];\"],\n  [\"      let y = 36 - this.scroll;\", \"      let y = 36 - about.scroll;\"],\n  [\"      E.font.text(g, (this.page + 1) + \\x27 / \\x27\", \"      E.font.text(g, (about.page + 1) + \\x27 / \\x27\"],\n  [\"const aboutScene = {\", \"const about = { from: \\x27title\\x27, page: 0, scroll: 0 };\\nconst aboutScene = {\"],\n  [\"  enter(d = {}) { this.won = !!d.won; playSong(\\x27final\\x27); },\", \"  enter(d = {}) { playSong(\\x27final\\x27); },\"],\n]);\npatch(\"01-data.js\", [\n  [\"const SPEAKER_NAMES\", \"const SPEAKER_NAMES\"],\n]);\nconsole.log(\"patched\");\n' && node -e '\nconst fs=require(\"fs\");const f=\"01-data.js\";let s=fs.readFileSync(f,\"utf8\");\nconst anchor=\"  home: { start: \\x27a\\x27\";\nif(s.split(anchor).length!==2) throw new Error(\"anchor\");\ns=s.replace(anchor, \"  downed: { start: \\x27a\\x27, nodes: {\\n    a: { who: \\x27nobody\\x27, text: [\\x27You went down. Ma sent a car. You’re going to be fine.\\x27, \\x27Probably.\\x27], next: null },\\n  } },\\n\"+anchor);\nfs.writeFileSync(f,s);console.log(\"downed added\");'","description":"Apply targeted fixes to game modules"},"caller":{"type":"direct"}}],