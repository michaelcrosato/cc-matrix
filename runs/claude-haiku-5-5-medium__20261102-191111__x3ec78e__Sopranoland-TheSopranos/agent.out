{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCix84Esus8nB8tfVz4","type":"message","role":"assistant","content":[{"type":"text","text":"The debug API is exposed. Now I'll rewrite the test file against it, with a real assertion for each behavior and no stubs."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2213,"cache_read_input_tokens":305126,"cache_creation":{"ephemeral_5m_input_tokens":2213,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ceb3ee4-d05b-48df-8167-856a2d7758be","uuid":"a79e5c27-30fc-469b-a3d5-96ae48a58dfd","timestamp":"2026-11-03T02:26:13.966Z","request_id":"req_011CgfCiwkE2C68dYtH8CVQy"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCix84Esus8nB8tfVz4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CxVHRTEhBeLtSbDuHJnyKY","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191111__x3ec78e/work/Sopranoland-TheSopranos-claude-haiku-5-5-medium-20261102-191111/test/game.test.mjs","content":"// Headless tests for every system of the game, and a full playthrough. The engine and the game run\n// in Node with no screen: fixed steps, scripted input (game.input.tap / hold) and the game's debug\n// handle. Run it from anywhere:   node test/game.test.mjs      (exit code 1 on any failure)\nimport vm from 'node:vm';\nimport { readFileSync, existsSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { gameScript } from '../build.mjs';\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.join(HERE, '..');\nconst ENGINE = readFileSync(path.join(ROOT, 'src', 'vendor', 'my-3d2dge.js'), 'utf8');\nconst GAME = gameScript({\n  sourceInformation: { date: 'test' }, testingFeedback: ['a', 'b', 'c', 'd'],\n  engineFeedback: ['a', 'b', 'c', 'd', 'e', 'f'], promptFeedback: ['a', 'b', 'c', 'd'],\n});\n\n// A fresh copy of the engine and the game. opts.hub: a fake AIHub client (a session).\n// opts.touch: 'only' for a touch-only device.\nfunction boot(opts = {}) {\n  const ctx = { console, Promise };\n  if (opts.touch) ctx.matchMedia = q => ({ matches: q.includes('coarse') && opts.touch === 'only' });\n  if (opts.hub) ctx.AIHub = opts.hub;\n  vm.createContext(ctx);\n  vm.runInContext(ENGINE, ctx, { filename: 'engine' });\n  vm.runInContext(GAME, ctx, { filename: 'game' });\n  const E = ctx.My3D2dge, game = E.current, dbg = game.debug;\n  return { E, game, dbg, D: dbg.data, snap: () => dbg.snapshot(), talk: dbg.talkBox };\n}\n\n// A fake hub client: the protocol's calls, recorded. The test moves its clock and fires its events.\nfunction fakeHub(time = -Infinity) {\n  const rec = { connect: null, ready: 0, results: [], progress: [], sent: [], handlers: {} };\n  let clock = time;\n  const hub = {\n    active: true, seeded: true, version: '1.3.0',\n    connect(o) { rec.connect = o; return Promise.resolve({ me: 0, players: [{ id: 0, name: 'Dom', color: '#e8443a' }, { id: 1, name: 'Ray', color: '#3b82f6' }], host: 0, isHost: true, mode: 'ghost', round: 1, limitMs: 600000, seed: 7 }); },\n    ready() { rec.ready++; },\n    time() { return clock; },\n    on(ev, fn) { rec.handlers[ev] = fn; return () => { delete rec.handlers[ev]; }; },\n    progress(o) { rec.progress.push(o); },\n    result(o) { rec.results.push(o); },\n    finish() {},\n    send(d, o) { rec.sent.push({ d, o }); return true; },\n    rng() { return () => 0.5; },\n    fail() {},\n  };\n  return { hub, rec, setTime: t => { clock = t; }, fire: (ev, ...a) => rec.handlers[ev] && rec.handlers[ev](...a) };\n}\n\nlet passed = 0, failed = 0;\nconst failures = [];\nconst check = (name, ok, detail = '') => {\n  if (ok) passed++; else { failed++; failures.push(name + (detail ? ' :: ' + detail : '')); }\n  console.log((ok ? 'ok   ' : 'FAIL ') + name + (ok || !detail ? '' : '  (' + detail + ')'));\n};\nconst J = v => JSON.stringify(v);\n// advance in 0.1 s steps so the scenes' timers and the hub's clock keep up\nconst run = (game, secs) => { for (let t = 0; t < secs - 1e-9; t += .1) game.advance(.1); };\n// press confirm through a talk box and any conversation after it, until nothing is open\nfunction talkAll(game, talk, snap, max = 300) {\n  for (let i = 0; i < max; i++) {\n    const s = snap();\n    if (!s.talk && !s.conv) return true;\n    if (s.talk) { if (talk.choices) { talk.choice = 0; } game.input.tap('confirm'); game.advance(.4); } else game.advance(.2);\n  }\n  return false;\n}\n// press through a conversation's pages until its choices show, then pick choice i\nfunction pickChoice(game, talk, snap, i, max = 60) {\n  for (let n = 0; n < max && !talk.choices; n++) { game.input.tap('confirm'); game.advance(.4); }\n  if (!talk.choices) return false;\n  talk.choice = i; game.input.tap('confirm'); game.advance(.4);\n  return true;\n}\n// stand the hero on a cell's centre, and let the world read it\nfunction stand(dbg, game, D, cell) { const w = dbg.world(); const c = w.map.center(cell[0], cell[1]); dbg.teleport(c[0], c[1]); game.advance(.1); return c; }\nconst distTo = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);\n\n// ================================================================================================\n// 1 · Scenes, the title and the attract demo\n// ================================================================================================\n{\n  const { game, snap } = boot();\n  game.advance(1);\n  check('the title is the first scene', snap().scene === 'title', J(snap().scene));\n  game.input.tap('confirm'); run(game, .8);\n  check('NEW GAME opens the play scene with the intro talk', snap().scene === 'play' && snap().conv === 'intro' && snap().talk, J(snap()));\n  check('the first objective is on the chapter toast', (snap().toast || '').includes('COLLECTIONS'), J(snap().toast));\n  check('no errors in the first seconds of play', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n}\n{\n  // ten seconds idle on the title starts the attract demo; any input ends it\n  const { game, snap } = boot();\n  game.advance(1);\n  run(game, 9);\n  check('the title waits before the ten seconds are up', snap().scene === 'title', J(snap().scene));\n  run(game, 2.5);\n  check('ten seconds idle starts the attract demo', snap().scene === 'attract' && snap().attract === true, J(snap().scene));\n  run(game, 3);\n  check('the attract demo plays on its own', snap().hero !== null && snap().chapter >= 1, J(snap()));\n  game.input.tap('confirm'); run(game, 1);\n  check('any input ends the demo and goes back to the title', snap().scene === 'title' && snap().attract === false, J(snap().scene));\n}\n{\n  // the demo really shows the whole story and then goes back to the title, with no error\n  const { game, snap } = boot();\n  game.advance(1); run(game, 10.5);\n  const seen = new Set();\n  let t = 0;\n  while (t < 600 && snap().scene === 'attract') { game.advance(.1); seen.add(snap().chapter); t += .1; if (snap().done && t > 1) { /* the end pause */ } }\n  check('the attract demo goes through every chapter', [1, 2, 3, 4, 5].every(c => seen.has(c)), 'chapters seen: ' + [...seen].join(','));\n  check('the attract demo finishes Ma’s door', snap().done === true || snap().scene === 'title', J(snap()));\n  run(game, 6);\n  check('the attract demo ends at the title', snap().scene === 'title', J(snap().scene));\n  check('no errors during the attract demo', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));\n}\n\n// ================================================================================================\n// 2 · The map, the zones and the walls\n// ================================================================================================\n{\n  const { game, dbg, snap, D } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5);\n  const b = (() => { const s = snap(); return s; })();\n  check('the hero starts at home', snap().zone === 'home', snap().zone);\n  check('the zones name the places by cell', D.zoneAt(8 * 16, 6 * 16) === 'home' && D.zoneAt(27 * 16, 6 * 16) === 'deli' && D.zoneAt(40 * 16, 6 * 16) === 'diner' && D.zoneAt(52 * 16, 6 * 16) === 'lounge' && D.zoneAt(37 * 16, 28 * 16) === 'yard' && D.zoneAt(50 * 16, 30 * 16) === 'warehouse' && D.zoneAt(10 * 16, 30 * 16) === 'lot' && D.zoneAt(30 * 16, 19 * 16) === 'street' && D.zoneAt(27 * 16, 27 * 16) === 'vashti', 'zone table');\n  const w = dbg.world();\n  check('the town rows are 40 rows of 60 cells', D.buildTownRows().length === 40 && D.buildTownRows().every(r => r.length === 60));\n  // the house wall stops the hero: stand in the yard below the house and walk up into it\n  const below = w.map.center(8, 13);\n  dbg.teleport(below[0], below[1] + 8);\n  game.input.hold('up', true); run(game, 1.5); game.input.hold('up', false);\n  check('a wall stops the hero (the house)', snap().hero[1] >= 180, J(snap().hero));\n}\n{\n  // the walk: the hero moves on the stick and the keys, and the Mover's controls are used\n  const { game, snap, dbg } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  const x0 = snap().hero[0];\n  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);\n  check('the keys walk the hero', snap().hero[0] > x0 + 20, J([x0, snap().hero]));\n}\n\n// ================================================================================================\n// 3 · The people, the talk and the chapters\n// ================================================================================================\n{\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  check('the intro talk closes and the play goes on', !snap().talk && !snap().conv, J(snap()));\n  stand(dbg, game, null, [27, 11]); game.input.tap('interact'); run(game, .3);\n  check('Sal Ricci’s talk opens when the hero interacts', snap().conv === 'ricci', J(snap()));\n  talkAll(game, talk, snap);\n  check('Sal Ricci pays $800', snap().cash === 800 && snap().got.ricci === true, J(snap()));\n  stand(dbg, game, null, [40, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);\n  check('Dorothy pays $450', snap().cash === 1250 && snap().got.dorothy === true, J(snap()));\n  stand(dbg, game, null, [51, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);\n  check('Tina pays $1,500 and the chapter moves on to the sit-down', snap().cash === 2750 && snap().chapter === 2, J(snap()));\n  // the interaction stays quiet away from people\n  stand(dbg, game, null, [20, 30]); const before = snap().conv; game.input.tap('interact'); run(game, .3);\n  check('the interaction does nothing with nobody near', snap().conv === before && !snap().talk, J(snap()));\n}\n{\n  // a choice moves the respect (Big Lou's sit-down)\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.chapter(2);\n  stand(dbg, game, null, [51, 14]); game.input.tap('interact'); run(game, .3);\n  check('Big Lou opens his talk', snap().conv === 'lou', J(snap()));\n  check('the talk offers the three answers', pickChoice(game, talk, snap, 1) === true, '');\n  check('the flag of the second answer is set (the Gus line)', snap().flags.gus === true, J(snap().flags));\n  check('the second answer adds 2 respect', snap().respect === 2, J(snap().respect));\n  talkAll(game, talk, snap);\n  check('Big Lou’s talk ends and the chapter moves on to the session', snap().chapter === 3 && snap().conv === null, J(snap()));\n}\n{\n  // Vashti's session: a calm answer lowers the stress, an agitated one raises it\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.chapter(3); dbg.give('stress', 50);\n  dbg.startConv('vashti', () => dbg.give('flags', { done: true }));\n  run(game, .3);\n  pickChoice(game, talk, snap, 0);\n  check('the calm answer lowers the stress by 6', snap().stress === 44, J(snap().stress));\n  pickChoice(game, talk, snap, 0);\n  check('the second question takes another calm answer', snap().stress === 32, J(snap().stress));\n  check('the conversation runs to its end', talkAll(game, talk, snap) && snap().conv === null, J(snap()));\n}\n{\n  // every conversation’s nodes resolve, and the text uses glyphs the font has\n  const { D } = boot();\n  const bad = [];\n  for (const [id, c] of Object.entries(D.CONVS)) {\n    if (!c.nodes[c.start]) bad.push(id + ':start');\n    for (const [nid, n] of Object.entries(c.nodes)) {\n      if (n.next && !c.nodes[n.next]) bad.push(id + '.' + nid + '->' + n.next);\n      for (const ch of n.choices || []) if (ch.next && !c.nodes[ch.next]) bad.push(id + '.' + nid + '=>' + ch.next);\n      if (!n.text || !n.text.length) bad.push(id + '.' + nid + ':text');\n      if (!D.VOICES[n.who]) bad.push(id + '.' + nid + ':voice(' + n.who + ')');\n    }\n  }\n  check('every conversation links to real nodes, with a voice for each speaker', bad.length === 0, bad.join(' '));\n  const odd = [...new Set(J(D.CONVS).match(/[^\\x00-\\x7F]/g) || [])].filter(c => !'•×♥★←→↑↓♪▸©'.includes(c));\n  check('conversation text has only glyphs the engine font draws', odd.length === 0, J(odd));\n}\n\n// ================================================================================================\n// 4 · Combat, the pistol, the hero’s health, and the checkpoint\n// ================================================================================================\n{\n  const { game, dbg, snap, E } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  dbg.chapter(4); run(game, .1);\n  const yard = stand(dbg, game, null, [37, 30]); run(game, .5);\n  const w = dbg.world();\n  check('entering the yard spawns the crew and Gus', snap().boss !== null && snap().foes >= 4, J(snap()));\n  const hero = w.hero;\n  const crew = w.foes.find(f => !f.dead && f.kind === 'crew');\n  // the bat: a crew member just in front of the hero\n  hero.facing = 0;\n  crew.x = hero.x + 14; crew.y = hero.y; crew.vx = crew.vy = 0; crew.alert = 0;\n  const hp0 = crew.hp;\n  for (let i = 0; i < 5; i++) { game.input.tap('attack'); run(game, .45); if (crew.dead) break; }\n  check('the bat hits a crew member in front', crew.hp < hp0 || crew.dead, 'hp ' + hp0 + ' -> ' + crew.hp);\n  // the pistol: a shell is used and a shot down the line hits\n  const f2 = w.foes.find(f => !f.dead && f.kind === 'crew' && f !== crew);\n  f2.x = hero.x + 70; f2.y = hero.y; f2.vx = f2.vy = 0; f2.alert = 0; f2.hp = 60;\n  hero.facing = 0;\n  const ammo0 = snap().ammo;\n  game.input.tap('use'); run(game, .7);\n  check('the pistol costs a shell', snap().ammo === ammo0 - 1, J(snap().ammo));\n  check('the shot hits the foe in its line', f2.hp < 60 || f2.dead, 'hp ' + f2.hp);\n  // the hero takes a hit: an enemy bullet hurts; a guard takes less\n  dbg.give('hp', 100); hero.iframes = 0;\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .4);\n  check('an enemy bullet hurts the hero', snap().hp === 82, J(snap().hp));\n  hero.iframes = 0; dbg.give('hp', 100);\n  game.input.hold('block', true);\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .4); game.input.hold('block', false);\n  check('guarding takes less damage (30 percent)', snap().hp >= 94 && snap().hp < 100, J(snap().hp));\n  // a death sends the hero back to the chapter’s checkpoint and counts it\n  dbg.give('hp', 3); hero.iframes = 0; const d0 = snap().deaths;\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .4);\n  check('a death counts and restores 70 health', snap().deaths === d0 + 1 && snap().hp === 70, J(snap()));\n  const cp = w.map.center(30, 19);\n  check('a death sends the hero back to the chapter 4 checkpoint', Math.abs(snap().hero[0] - cp[0]) < 3 && Math.abs(snap().hero[1] - cp[1]) < 3, J([snap().hero, cp]));\n}\n{\n  // a civilian who is hit: the heat rises, and the others run\n  const { game, dbg, snap, E } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  const w = dbg.world();\n  const civ = w.civs[0];\n  w.hero.facing = Math.atan2(civ.y - w.hero.y, civ.x - w.hero.x);\n  civ.x = w.hero.x + 14; civ.y = w.hero.y; civ.vx = civ.vy = 0;\n  game.input.tap('attack'); run(game, .5);\n  for (let i = 0; i < 3; i++) { game.input.tap('attack'); run(game, .45); }\n  check('hitting a civilian raises the heat', snap().heat > 0, J(snap().heat));\n  check('the civilian runs', civ.flee > 0 || civ.dead, J(civ.flee));\n}\n{\n  // pickups: a cannoli heals and calms; the shells come in boxes; a duck counts\n  const { game, dbg, snap, D } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  const w = dbg.world();\n  dbg.give('hp', 40); dbg.give('stress', 30);\n  dbg.teleport(w.cannoli[0].x, w.cannoli[0].y); run(game, .3);\n  check('a cannoli heals 25 and calms 10', snap().hp === 65 && snap().stress === 20 && snap().cannoli === 0, J(snap()));\n  dbg.teleport(w.ammo[0].x, w.ammo[0].y); run(game, .3);\n  check('a box of shells adds 8', snap().ammo === 20, J(snap().ammo));\n  dbg.teleport(w.ducks[0].x, w.ducks[0].y); run(game, .3);\n  check('a duck counts toward the pool', snap().ducks === 1, J(snap().ducks));\n}\n{\n  // heat and panic: a hot street raises the stress; at 100 the hero panics and can't fight\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  dbg.chapter(5); dbg.give('heat', 90); run(game, 2);\n  check('a hot street raises the stress', snap().stress > 0, J(snap().stress));\n  dbg.give('stress', 100); run(game, .2);\n  check('a stress of 100 is a panic (the toast says so)', (snap().toast || '').includes('PANIC'), J(snap().toast));\n  const w = dbg.world();\n  const n = w.foes.length;\n  game.input.tap('attack'); run(game, .3);\n  check('a panic stops the bat', !w.combo.busy, J(w.combo.busy));\n}\n\n// ================================================================================================\n// 5 · The chapters, from the yard to Ma’s door (standalone)\n// ================================================================================================\n{\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.chapter(5); run(game, .2);\n  const w = dbg.world();\n  run(game, 11);\n  check('chapter 5 sends Feds onto the street', w.foes.some(f => f.kind === 'fed'), J(w.foes.length));\n  const home = w.map.center(8, 13);\n  dbg.teleport(home[0], home[1]); run(game, .4);\n  check('Ma’s door starts her talk', snap().conv === 'home', J(snap()));\n  talkAll(game, talk, snap);\n  check('Ma’s talk ends the story (standalone: the end screen)', snap().done === true && snap().scene === 'end', J(snap()));\n}\n\n// ================================================================================================\n// 6 · Settings, glyphs, the touch-only rule and the save slots\n// ================================================================================================\n{\n  const { game } = boot();\n  check('the stick inversions are settings', !!game.settings.spec('invertStickX') && !!game.settings.spec('invertStickY'));\n  check('the button symbols default to PlayStation', game.settings.glyphs === 'playstation' && game.input.glyphs === 'playstation', J([game.settings.glyphs, game.input.glyphs]));\n  check('the camera view is on V and the right stick press', J(game.input.map.view) === J(['KeyV', 'Pad11']), J(game.input.map.view));\n  check('the bat prompt names the key or button in use', typeof game.input.label('attack') === 'string' && game.input.label('attack').length > 0, J(game.input.label('attack')));\n}\n{\n  // the stick helper inverts only what the player asked for, and only on a gamepad\n  const { game, dbg } = boot();\n  game.input.move = () => [0.6, -0.4];\n  game.input.lastDevice = 'gamepad';\n  check('a gamepad stick reads normally by default', J(dbg.stick()) === J([0.6, -0.4]), J(dbg.stick()));\n  game.settings.set('invertStickX', true);\n  check('the left-right inversion flips x', J(dbg.stick()) === J([-0.6, -0.4]), J(dbg.stick()));\n  game.settings.set('invertStickY', true);\n  check('the up-down inversion flips y as well', J(dbg.stick()) === J([-0.6, 0.4]), J(dbg.stick()));\n  game.input.lastDevice = 'keyboard';\n  check('the keyboard is not inverted', J(dbg.stick()) === J([0.6, -0.4]), J(dbg.stick()));\n  game.settings.set('invertStickX', false); game.settings.set('invertStickY', false);\n}\n{\n  // a touch-only device gets no touch controls (the title says controller or keyboard)\n  const { game } = boot({ touch: 'only' });\n  check('a touch-only device has its touch controls off', game.input.touchEnabled === false, J(game.input.touchEnabled));\n  const { game: g2 } = boot();\n  check('a device with a keyboard keeps touch available', g2.input.touchEnabled === true, J(g2.input.touchEnabled));\n}\n{\n  // the save slots: a save writes the run; a load brings it back\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.give('cash', 1234); dbg.give('respect', 3);\n  check('the save slot takes the run', game.saves.save(0) === true, '');\n  dbg.give('cash', 0); dbg.give('respect', 0);\n  const latest = game.saves.latest();\n  check('the save is the latest run', !!latest && latest.slot === 0, J(latest));\n  game.saves.load(0); run(game, 1.2);\n  check('loading brings back the cash and the respect', snap().cash === 1234 && snap().respect === 3 && snap().scene === 'play', J(snap()));\n}\n\n// ================================================================================================\n// 7 · The hub session (AI Hub Session Protocol v1, ghost mode)\n// ================================================================================================\n{\n  const { hub, rec, setTime, fire } = fakeHub(-Infinity);\n  const { game, snap } = boot({ hub });\n  game.advance(1); run(game, .3);\n  check('a session opens straight into the round (no title)', snap().scene === 'play', J(snap().scene));\n  check('the session connects in ghost mode with 1 to 4 seats', rec.connect && rec.connect.mode === 'ghost' && rec.connect.seats[0] === 1 && rec.connect.seats[1] === 4, J(rec.connect));\n  check('the round calls ready once the world is built', rec.ready === 1, 'ready ' + rec.ready);\n  check('the session has no quit to title (the hub ends rounds)', game.o.menu && game.o.menu.quit === false, J(game.o.menu && game.o.menu.quit));\n  check('before the start the round does not play', snap().hero && !snap().talk && snap().scene === 'play', J(snap()));\n  const x0 = snap().hero[0];\n  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);\n  check('before the start the hero does not move', snap().hero[0] === x0, J([x0, snap().hero]));\n  setTime(0); fire('start', { in: 3000 }); run(game, .2);\n  const x1 = snap().hero[0];\n  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);\n  check('after the start the hero plays', snap().hero[0] !== x1, J([x1, snap().hero]));\n  run(game, 2);\n  check('the copy sends its place to the others (ghost mode, unreliable)', rec.sent.length > 5 && rec.sent.every(s => s.o && s.o.reliable === false), 'sent ' + rec.sent.length);\n  check('the progress reaches the hub about once a second', rec.progress.length >= 1, 'progress ' + rec.progress.length);\n  fire('message', { x: 150, y: 220, f: 0, vx: 0, vy: 0, zone: 'home' }, 1);\n  run(game, .3);\n  check('another copy’s place is kept, with no error', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n  fire('leave', { id: 1, reason: 'left' }); run(game, .2);\n  check('a player leaving is handled', game.errors.length === 0, '');\n  fire('time-up', { graceMs: 5000 }); run(game, .2);\n  check('time-up reports a result once, with the score', rec.results.length === 1 && typeof rec.results[0].score === 'number', J(rec.results));\n  fire('time-up', { graceMs: 5000 }); run(game, .2);\n  check('a second time-up does not report again', rec.results.length === 1, J(rec.results.length));\n  const sent0 = rec.sent.length;\n  fire('end', { reason: 'finished', standings: [] }); run(game, .6);\n  check('after the end nothing more is sent', rec.sent.length === sent0, 'sent ' + (rec.sent.length - sent0));\n  check('no errors in a session', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));\n}\n{\n  // a session round where the hero gets to Ma's door: one result with the time, then the round waits\n  const { hub, rec, setTime, fire } = fakeHub(0);\n  const { game, snap, dbg, talk } = boot({ hub });\n  game.advance(1); run(game, .2);\n  setTime(10000); fire('start', { in: 0 }); run(game, .2);\n  dbg.chapter(5); run(game, .2);\n  const w = dbg.world(), home = w.map.center(8, 13);\n  dbg.teleport(home[0], home[1]); run(game, .5); talkAll(game, talk, snap);\n  check('the round reports its time when the last chapter is done', rec.results.length === 1 && typeof rec.results[0].time === 'number' && rec.results[0].time > 0, J(rec.results));\n  check('after the result the round waits and the scene stays', snap().scene === 'play' && snap().done === true && snap().frozen === true, J(snap()));\n  check('no errors at the end of the round', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));\n}\n\n// ================================================================================================\n// 8 · The About pages read the exit interview\n// ================================================================================================\n{\n  const exitPath = path.join(ROOT, '..', 'exit-interview.json');\n  if (existsSync(exitPath)) {\n    let data = null, err = '';\n    try { data = JSON.parse(readFileSync(exitPath, 'utf8')); } catch (e) { err = e.message; }\n    check('exit-interview.json parses as JSON', !err, err);\n    const fields = ['date', 'source', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];\n    check('the interview answers every source field', !!data && fields.every(f => typeof data.sourceInformation[f] === 'string' && data.sourceInformation[f].length > 0));\n    check('the interview answers every feedback question (4, 6 and 4)', !!data && data.testingFeedback.length === 4 && data.engineFeedback.length === 6 && data.promptFeedback.length === 4);\n  } else {\n    check('exit-interview.json is written', false, 'not written yet');\n  }\n}\n\n// ================================================================================================\n// 9 · A full playthrough: keys and mouse, from NEW GAME to the credits\n// ================================================================================================\n{\n  const { game, dbg, snap, talk, E } = boot();\n  game.advance(1);\n  game.input.tap('confirm'); run(game, .6);                                      // NEW GAME\n  talkAll(game, talk, snap);                                                     // the intro\n  stand(dbg, game, null, [27, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Sal Ricci\n  stand(dbg, game, null, [40, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Dorothy\n  stand(dbg, game, null, [51, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Tina\n  check('the collections are done and the sit-down is next', snap().chapter === 2 && snap().cash === 2750, J(snap()));\n  stand(dbg, game, null, [51, 14]); game.input.tap('interact'); run(game, .3);   // Big Lou\n  pickChoice(game, talk, snap, 0);\n  talkAll(game, talk, snap);\n  check('the sit-down is done and the session is next', snap().chapter === 3, J(snap()));\n  stand(dbg, game, null, [27, 23]); game.input.tap('interact'); run(game, .5);   // Dr. Vashti's door\n  check('the session room opens', snap().scene === 'session', J(snap().scene));\n  pickChoice(game, talk, snap, 2); pickChoice(game, talk, snap, 0); pickChoice(game, talk, snap, 0); pickChoice(game, talk, snap, 0);\n  talkAll(game, talk, snap);\n  check('the session ends back in the play scene on chapter 4', snap().scene === 'play' && snap().chapter === 4, J(snap()));\n  // the yard: the bat and the pistol until Gus is down\n  const w = dbg.world();\n  stand(dbg, game, null, [37, 30]); run(game, .4);\n  let frames = 0;\n  while (!snap().bossDown && frames < 2500 && snap().scene === 'play') {\n    const hero = w.hero;\n    const foe = w.foes.filter(f => !f.dead && f.kind !== 'civ').sort((a, b) => distTo(hero, a) - distTo(hero, b))[0];\n    if (talk.open) game.input.tap('confirm');\n    else if (foe) {\n      hero.facing = Math.atan2(foe.y - hero.y, foe.x - hero.x);\n      if (distTo(hero, foe) > 34) { hero.x += Math.cos(hero.facing) * 2.5; hero.y += Math.sin(hero.facing) * 2.5; }\n      if (frames % 4 === 0) game.input.tap('attack');\n      if (frames % 9 === 0 && snap().ammo > 0 && distTo(hero, foe) > 40) game.input.tap('use');\n    }\n    if (snap().hp < 70) dbg.give('hp', 100);\n    game.advance(.1); frames++;\n  }\n  check('the yard fight puts Gus down', snap().bossDown === true, J(snap()));\n  check('the Feds come once Gus is down (chapter 5)', snap().chapter === 5, J(snap()));\n  // the Feds, and the walk home to Ma\n  const home = w.map.center(8, 13);\n  let steps = 0;\n  while (!snap().done && steps < 3000 && snap().scene === 'play') {\n    const hero = w.hero;\n    if (talk.open) { game.input.tap('confirm'); game.advance(.2); steps++; continue; }\n    const fed = w.foes.filter(f => !f.dead && f.kind === 'fed').sort((a, b) => distTo(hero, a) - distTo(hero, b))[0];\n    if (fed && distTo(hero, fed) < 120) { hero.facing = Math.atan2(fed.y - hero.y, fed.x - hero.x); if (steps % 9 === 0 && snap().ammo > 0) game.input.tap('use'); }\n    const dx = home[0] - hero.x, dy = home[1] - hero.y, dd = Math.hypot(dx, dy) || 1;\n    if (dd > 24) { hero.x += dx / dd * 2.2; hero.y += dy / dd * 2.2; }\n    else game.input.tap('interact');\n    if (snap().hp < 70) dbg.give('hp', 100);\n    game.advance(.1); steps++;\n  }\n  check('Ma’s house ends the story', snap().done === true, J(snap()));\n  talkAll(game, talk, snap);\n  check('the end screen waits after the story', snap().scene === 'end', J(snap().scene));\n  game.input.tap('confirm'); run(game, .5);\n  check('the About pages open from the end screen', snap().scene === 'credits', J(snap().scene));\n  for (let i = 0; i < 4; i++) { game.input.tap('right'); run(game, .3); }\n  check('the About pages turn through the sections', snap().scene === 'credits', J(snap().scene));\n  game.input.tap('cancel'); run(game, .5);\n  check('the playthrough goes back to the end screen without an error', game.errors.length === 0 && snap().scene === 'end', game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));\n}\n\nconsole.log('\\n' + passed + ' passed, ' + failed + ' failed');\nif (failed) { console.log('failures:\\n - ' + failures.join('\\n - ')); process.exit(1); }\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2213,"cache_read_input_tokens":305126,"cache_creation":{"ephemeral_5m_input_tokens":2213,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ceb3ee4-d05b-48df-8167-856a2d7758be","uuid":"9255e921-13e4-4f03-8463-23508234ea98","timestamp":"2026-11-03T02:26:54.871Z","request_id":"req_011CgfCiwkE2C68dYtH8CVQy","wire_tool_inputs":{"toolu_01CxVHRTEhBeLtSbDuHJnyKY":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191111__x3ec78e/work/Sopranoland-TheSopranos-claude-haiku-5-5-medium-20261102-191111/test/game.test.mjs","content":"// Headless tests for every system of the game, and a full playthrough. The engine and the game run\n// in Node with no screen: fixed steps, scripted input (game.input.tap / hold) and the game's debug\n// handle. Run it from anywhere:   node test/game.test.mjs      (exit code 1 on any failure)\nimport vm from 'node:vm';\nimport { readFileSync, existsSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { gameScript } from '../build.mjs';\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.join(HERE, '..');\nconst ENGINE = readFileSync(path.join(ROOT, 'src', 'vendor', 'my-3d2dge.js'), 'utf8');\nconst GAME = gameScript({\n  sourceInformation: { date: 'test' }, testingFeedback: ['a', 'b', 'c', 'd'],\n  engineFeedback: ['a', 'b', 'c', 'd', 'e', 'f'], promptFeedback: ['a', 'b', 'c', 'd'],\n});\n\n// A fresh copy of the engine and the game. opts.hub: a fake AIHub client (a session).\n// opts.touch: 'only' for a touch-only device.\nfunction boot(opts = {}) {\n  const ctx = { console, Promise };\n  if (opts.touch) ctx.matchMedia = q => ({ matches: q.includes('coarse') && opts.touch === 'only' });\n  if (opts.hub) ctx.AIHub = opts.hub;\n  vm.createContext(ctx);\n  vm.runInContext(ENGINE, ctx, { filename: 'engine' });\n  vm.runInContext(GAME, ctx, { filename: 'game' });\n  const E = ctx.My3D2dge, game = E.current, dbg = game.debug;\n  return { E, game, dbg, D: dbg.data, snap: () => dbg.snapshot(), talk: dbg.talkBox };\n}\n\n// A fake hub client: the protocol's calls, recorded. The test moves its clock and fires its events.\nfunction fakeHub(time = -Infinity) {\n  const rec = { connect: null, ready: 0, results: [], progress: [], sent: [], handlers: {} };\n  let clock = time;\n  const hub = {\n    active: true, seeded: true, version: '1.3.0',\n    connect(o) { rec.connect = o; return Promise.resolve({ me: 0, players: [{ id: 0, name: 'Dom', color: '#e8443a' }, { id: 1, name: 'Ray', color: '#3b82f6' }], host: 0, isHost: true, mode: 'ghost', round: 1, limitMs: 600000, seed: 7 }); },\n    ready() { rec.ready++; },\n    time() { return clock; },\n    on(ev, fn) { rec.handlers[ev] = fn; return () => { delete rec.handlers[ev]; }; },\n    progress(o) { rec.progress.push(o); },\n    result(o) { rec.results.push(o); },\n    finish() {},\n    send(d, o) { rec.sent.push({ d, o }); return true; },\n    rng() { return () => 0.5; },\n    fail() {},\n  };\n  return { hub, rec, setTime: t => { clock = t; }, fire: (ev, ...a) => rec.handlers[ev] && rec.handlers[ev](...a) };\n}\n\nlet passed = 0, failed = 0;\nconst failures = [];\nconst check = (name, ok, detail = '') => {\n  if (ok) passed++; else { failed++; failures.push(name + (detail ? ' :: ' + detail : '')); }\n  console.log((ok ? 'ok   ' : 'FAIL ') + name + (ok || !detail ? '' : '  (' + detail + ')'));\n};\nconst J = v => JSON.stringify(v);\n// advance in 0.1 s steps so the scenes' timers and the hub's clock keep up\nconst run = (game, secs) => { for (let t = 0; t < secs - 1e-9; t += .1) game.advance(.1); };\n// press confirm through a talk box and any conversation after it, until nothing is open\nfunction talkAll(game, talk, snap, max = 300) {\n  for (let i = 0; i < max; i++) {\n    const s = snap();\n    if (!s.talk && !s.conv) return true;\n    if (s.talk) { if (talk.choices) { talk.choice = 0; } game.input.tap('confirm'); game.advance(.4); } else game.advance(.2);\n  }\n  return false;\n}\n// press through a conversation's pages until its choices show, then pick choice i\nfunction pickChoice(game, talk, snap, i, max = 60) {\n  for (let n = 0; n < max && !talk.choices; n++) { game.input.tap('confirm'); game.advance(.4); }\n  if (!talk.choices) return false;\n  talk.choice = i; game.input.tap('confirm'); game.advance(.4);\n  return true;\n}\n// stand the hero on a cell's centre, and let the world read it\nfunction stand(dbg, game, D, cell) { const w = dbg.world(); const c = w.map.center(cell[0], cell[1]); dbg.teleport(c[0], c[1]); game.advance(.1); return c; }\nconst distTo = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);\n\n// ================================================================================================\n// 1 · Scenes, the title and the attract demo\n// ================================================================================================\n{\n  const { game, snap } = boot();\n  game.advance(1);\n  check('the title is the first scene', snap().scene === 'title', J(snap().scene));\n  game.input.tap('confirm'); run(game, .8);\n  check('NEW GAME opens the play scene with the intro talk', snap().scene === 'play' && snap().conv === 'intro' && snap().talk, J(snap()));\n  check('the first objective is on the chapter toast', (snap().toast || '').includes('COLLECTIONS'), J(snap().toast));\n  check('no errors in the first seconds of play', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n}\n{\n  // ten seconds idle on the title starts the attract demo; any input ends it\n  const { game, snap } = boot();\n  game.advance(1);\n  run(game, 9);\n  check('the title waits before the ten seconds are up', snap().scene === 'title', J(snap().scene));\n  run(game, 2.5);\n  check('ten seconds idle starts the attract demo', snap().scene === 'attract' && snap().attract === true, J(snap().scene));\n  run(game, 3);\n  check('the attract demo plays on its own', snap().hero !== null && snap().chapter >= 1, J(snap()));\n  game.input.tap('confirm'); run(game, 1);\n  check('any input ends the demo and goes back to the title', snap().scene === 'title' && snap().attract === false, J(snap().scene));\n}\n{\n  // the demo really shows the whole story and then goes back to the title, with no error\n  const { game, snap } = boot();\n  game.advance(1); run(game, 10.5);\n  const seen = new Set();\n  let t = 0;\n  while (t < 600 && snap().scene === 'attract') { game.advance(.1); seen.add(snap().chapter); t += .1; if (snap().done && t > 1) { /* the end pause */ } }\n  check('the attract demo goes through every chapter', [1, 2, 3, 4, 5].every(c => seen.has(c)), 'chapters seen: ' + [...seen].join(','));\n  check('the attract demo finishes Ma’s door', snap().done === true || snap().scene === 'title', J(snap()));\n  run(game, 6);\n  check('the attract demo ends at the title', snap().scene === 'title', J(snap().scene));\n  check('no errors during the attract demo', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));\n}\n\n// ================================================================================================\n// 2 · The map, the zones and the walls\n// ================================================================================================\n{\n  const { game, dbg, snap, D } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5);\n  const b = (() => { const s = snap(); return s; })();\n  check('the hero starts at home', snap().zone === 'home', snap().zone);\n  check('the zones name the places by cell', D.zoneAt(8 * 16, 6 * 16) === 'home' && D.zoneAt(27 * 16, 6 * 16) === 'deli' && D.zoneAt(40 * 16, 6 * 16) === 'diner' && D.zoneAt(52 * 16, 6 * 16) === 'lounge' && D.zoneAt(37 * 16, 28 * 16) === 'yard' && D.zoneAt(50 * 16, 30 * 16) === 'warehouse' && D.zoneAt(10 * 16, 30 * 16) === 'lot' && D.zoneAt(30 * 16, 19 * 16) === 'street' && D.zoneAt(27 * 16, 27 * 16) === 'vashti', 'zone table');\n  const w = dbg.world();\n  check('the town rows are 40 rows of 60 cells', D.buildTownRows().length === 40 && D.buildTownRows().every(r => r.length === 60));\n  // the house wall stops the hero: stand in the yard below the house and walk up into it\n  const below = w.map.center(8, 13);\n  dbg.teleport(below[0], below[1] + 8);\n  game.input.hold('up', true); run(game, 1.5); game.input.hold('up', false);\n  check('a wall stops the hero (the house)', snap().hero[1] >= 180, J(snap().hero));\n}\n{\n  // the walk: the hero moves on the stick and the keys, and the Mover's controls are used\n  const { game, snap, dbg } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  const x0 = snap().hero[0];\n  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);\n  check('the keys walk the hero', snap().hero[0] > x0 + 20, J([x0, snap().hero]));\n}\n\n// ================================================================================================\n// 3 · The people, the talk and the chapters\n// ================================================================================================\n{\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  check('the intro talk closes and the play goes on', !snap().talk && !snap().conv, J(snap()));\n  stand(dbg, game, null, [27, 11]); game.input.tap('interact'); run(game, .3);\n  check('Sal Ricci’s talk opens when the hero interacts', snap().conv === 'ricci', J(snap()));\n  talkAll(game, talk, snap);\n  check('Sal Ricci pays $800', snap().cash === 800 && snap().got.ricci === true, J(snap()));\n  stand(dbg, game, null, [40, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);\n  check('Dorothy pays $450', snap().cash === 1250 && snap().got.dorothy === true, J(snap()));\n  stand(dbg, game, null, [51, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);\n  check('Tina pays $1,500 and the chapter moves on to the sit-down', snap().cash === 2750 && snap().chapter === 2, J(snap()));\n  // the interaction stays quiet away from people\n  stand(dbg, game, null, [20, 30]); const before = snap().conv; game.input.tap('interact'); run(game, .3);\n  check('the interaction does nothing with nobody near', snap().conv === before && !snap().talk, J(snap()));\n}\n{\n  // a choice moves the respect (Big Lou's sit-down)\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.chapter(2);\n  stand(dbg, game, null, [51, 14]); game.input.tap('interact'); run(game, .3);\n  check('Big Lou opens his talk', snap().conv === 'lou', J(snap()));\n  check('the talk offers the three answers', pickChoice(game, talk, snap, 1) === true, '');\n  check('the flag of the second answer is set (the Gus line)', snap().flags.gus === true, J(snap().flags));\n  check('the second answer adds 2 respect', snap().respect === 2, J(snap().respect));\n  talkAll(game, talk, snap);\n  check('Big Lou’s talk ends and the chapter moves on to the session', snap().chapter === 3 && snap().conv === null, J(snap()));\n}\n{\n  // Vashti's session: a calm answer lowers the stress, an agitated one raises it\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.chapter(3); dbg.give('stress', 50);\n  dbg.startConv('vashti', () => dbg.give('flags', { done: true }));\n  run(game, .3);\n  pickChoice(game, talk, snap, 0);\n  check('the calm answer lowers the stress by 6', snap().stress === 44, J(snap().stress));\n  pickChoice(game, talk, snap, 0);\n  check('the second question takes another calm answer', snap().stress === 32, J(snap().stress));\n  check('the conversation runs to its end', talkAll(game, talk, snap) && snap().conv === null, J(snap()));\n}\n{\n  // every conversation’s nodes resolve, and the text uses glyphs the font has\n  const { D } = boot();\n  const bad = [];\n  for (const [id, c] of Object.entries(D.CONVS)) {\n    if (!c.nodes[c.start]) bad.push(id + ':start');\n    for (const [nid, n] of Object.entries(c.nodes)) {\n      if (n.next && !c.nodes[n.next]) bad.push(id + '.' + nid + '->' + n.next);\n      for (const ch of n.choices || []) if (ch.next && !c.nodes[ch.next]) bad.push(id + '.' + nid + '=>' + ch.next);\n      if (!n.text || !n.text.length) bad.push(id + '.' + nid + ':text');\n      if (!D.VOICES[n.who]) bad.push(id + '.' + nid + ':voice(' + n.who + ')');\n    }\n  }\n  check('every conversation links to real nodes, with a voice for each speaker', bad.length === 0, bad.join(' '));\n  const odd = [...new Set(J(D.CONVS).match(/[^\\x00-\\x7F]/g) || [])].filter(c => !'•×♥★←→↑↓♪▸©'.includes(c));\n  check('conversation text has only glyphs the engine font draws', odd.length === 0, J(odd));\n}\n\n// ================================================================================================\n// 4 · Combat, the pistol, the hero’s health, and the checkpoint\n// ================================================================================================\n{\n  const { game, dbg, snap, E } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  dbg.chapter(4); run(game, .1);\n  const yard = stand(dbg, game, null, [37, 30]); run(game, .5);\n  const w = dbg.world();\n  check('entering the yard spawns the crew and Gus', snap().boss !== null && snap().foes >= 4, J(snap()));\n  const hero = w.hero;\n  const crew = w.foes.find(f => !f.dead && f.kind === 'crew');\n  // the bat: a crew member just in front of the hero\n  hero.facing = 0;\n  crew.x = hero.x + 14; crew.y = hero.y; crew.vx = crew.vy = 0; crew.alert = 0;\n  const hp0 = crew.hp;\n  for (let i = 0; i < 5; i++) { game.input.tap('attack'); run(game, .45); if (crew.dead) break; }\n  check('the bat hits a crew member in front', crew.hp < hp0 || crew.dead, 'hp ' + hp0 + ' -> ' + crew.hp);\n  // the pistol: a shell is used and a shot down the line hits\n  const f2 = w.foes.find(f => !f.dead && f.kind === 'crew' && f !== crew);\n  f2.x = hero.x + 70; f2.y = hero.y; f2.vx = f2.vy = 0; f2.alert = 0; f2.hp = 60;\n  hero.facing = 0;\n  const ammo0 = snap().ammo;\n  game.input.tap('use'); run(game, .7);\n  check('the pistol costs a shell', snap().ammo === ammo0 - 1, J(snap().ammo));\n  check('the shot hits the foe in its line', f2.hp < 60 || f2.dead, 'hp ' + f2.hp);\n  // the hero takes a hit: an enemy bullet hurts; a guard takes less\n  dbg.give('hp', 100); hero.iframes = 0;\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .4);\n  check('an enemy bullet hurts the hero', snap().hp === 82, J(snap().hp));\n  hero.iframes = 0; dbg.give('hp', 100);\n  game.input.hold('block', true);\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .4); game.input.hold('block', false);\n  check('guarding takes less damage (30 percent)', snap().hp >= 94 && snap().hp < 100, J(snap().hp));\n  // a death sends the hero back to the chapter’s checkpoint and counts it\n  dbg.give('hp', 3); hero.iframes = 0; const d0 = snap().deaths;\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .4);\n  check('a death counts and restores 70 health', snap().deaths === d0 + 1 && snap().hp === 70, J(snap()));\n  const cp = w.map.center(30, 19);\n  check('a death sends the hero back to the chapter 4 checkpoint', Math.abs(snap().hero[0] - cp[0]) < 3 && Math.abs(snap().hero[1] - cp[1]) < 3, J([snap().hero, cp]));\n}\n{\n  // a civilian who is hit: the heat rises, and the others run\n  const { game, dbg, snap, E } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  const w = dbg.world();\n  const civ = w.civs[0];\n  w.hero.facing = Math.atan2(civ.y - w.hero.y, civ.x - w.hero.x);\n  civ.x = w.hero.x + 14; civ.y = w.hero.y; civ.vx = civ.vy = 0;\n  game.input.tap('attack'); run(game, .5);\n  for (let i = 0; i < 3; i++) { game.input.tap('attack'); run(game, .45); }\n  check('hitting a civilian raises the heat', snap().heat > 0, J(snap().heat));\n  check('the civilian runs', civ.flee > 0 || civ.dead, J(civ.flee));\n}\n{\n  // pickups: a cannoli heals and calms; the shells come in boxes; a duck counts\n  const { game, dbg, snap, D } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  const w = dbg.world();\n  dbg.give('hp', 40); dbg.give('stress', 30);\n  dbg.teleport(w.cannoli[0].x, w.cannoli[0].y); run(game, .3);\n  check('a cannoli heals 25 and calms 10', snap().hp === 65 && snap().stress === 20 && snap().cannoli === 0, J(snap()));\n  dbg.teleport(w.ammo[0].x, w.ammo[0].y); run(game, .3);\n  check('a box of shells adds 8', snap().ammo === 20, J(snap().ammo));\n  dbg.teleport(w.ducks[0].x, w.ducks[0].y); run(game, .3);\n  check('a duck counts toward the pool', snap().ducks === 1, J(snap().ducks));\n}\n{\n  // heat and panic: a hot street raises the stress; at 100 the hero panics and can't fight\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  dbg.chapter(5); dbg.give('heat', 90); run(game, 2);\n  check('a hot street raises the stress', snap().stress > 0, J(snap().stress));\n  dbg.give('stress', 100); run(game, .2);\n  check('a stress of 100 is a panic (the toast says so)', (snap().toast || '').includes('PANIC'), J(snap().toast));\n  const w = dbg.world();\n  const n = w.foes.length;\n  game.input.tap('attack'); run(game, .3);\n  check('a panic stops the bat', !w.combo.busy, J(w.combo.busy));\n}\n\n// ================================================================================================\n// 5 · The chapters, from the yard to Ma’s door (standalone)\n// ================================================================================================\n{\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.chapter(5); run(game, .2);\n  const w = dbg.world();\n  run(game, 11);\n  check('chapter 5 sends Feds onto the street', w.foes.some(f => f.kind === 'fed'), J(w.foes.length));\n  const home = w.map.center(8, 13);\n  dbg.teleport(home[0], home[1]); run(game, .4);\n  check('Ma’s door starts her talk', snap().conv === 'home', J(snap()));\n  talkAll(game, talk, snap);\n  check('Ma’s talk ends the story (standalone: the end screen)', snap().done === true && snap().scene === 'end', J(snap()));\n}\n\n// ================================================================================================\n// 6 · Settings, glyphs, the touch-only rule and the save slots\n// ================================================================================================\n{\n  const { game } = boot();\n  check('the stick inversions are settings', !!game.settings.spec('invertStickX') && !!game.settings.spec('invertStickY'));\n  check('the button symbols default to PlayStation', game.settings.glyphs === 'playstation' && game.input.glyphs === 'playstation', J([game.settings.glyphs, game.input.glyphs]));\n  check('the camera view is on V and the right stick press', J(game.input.map.view) === J(['KeyV', 'Pad11']), J(game.input.map.view));\n  check('the bat prompt names the key or button in use', typeof game.input.label('attack') === 'string' && game.input.label('attack').length > 0, J(game.input.label('attack')));\n}\n{\n  // the stick helper inverts only what the player asked for, and only on a gamepad\n  const { game, dbg } = boot();\n  game.input.move = () => [0.6, -0.4];\n  game.input.lastDevice = 'gamepad';\n  check('a gamepad stick reads normally by default', J(dbg.stick()) === J([0.6, -0.4]), J(dbg.stick()));\n  game.settings.set('invertStickX', true);\n  check('the left-right inversion flips x', J(dbg.stick()) === J([-0.6, -0.4]), J(dbg.stick()));\n  game.settings.set('invertStickY', true);\n  check('the up-down inversion flips y as well', J(dbg.stick()) === J([-0.6, 0.4]), J(dbg.stick()));\n  game.input.lastDevice = 'keyboard';\n  check('the keyboard is not inverted', J(dbg.stick()) === J([0.6, -0.4]), J(dbg.stick()));\n  game.settings.set('invertStickX', false); game.settings.set('invertStickY', false);\n}\n{\n  // a touch-only device gets no touch controls (the title says controller or keyboard)\n  const { game } = boot({ touch: 'only' });\n  check('a touch-only device has its touch controls off', game.input.touchEnabled === false, J(game.input.touchEnabled));\n  const { game: g2 } = boot();\n  check('a device with a keyboard keeps touch available', g2.input.touchEnabled === true, J(g2.input.touchEnabled));\n}\n{\n  // the save slots: a save writes the run; a load brings it back\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.give('cash', 1234); dbg.give('respect', 3);\n  check('the save slot takes the run', game.saves.save(0) === true, '');\n  dbg.give('cash', 0); dbg.give('respect', 0);\n  const latest = game.saves.latest();\n  check('the save is the latest run', !!latest && latest.slot === 0, J(latest));\n  game.saves.load(0); run(game, 1.2);\n  check('loading brings back the cash and the respect', snap().cash === 1234 && snap().respect === 3 && snap().scene === 'play', J(snap()));\n}\n\n// ================================================================================================\n// 7 · The hub session (AI Hub Session Protocol v1, ghost mode)\n// ================================================================================================\n{\n  const { hub, rec, setTime, fire } = fakeHub(-Infinity);\n  const { game, snap } = boot({ hub });\n  game.advance(1); run(game, .3);\n  check('a session opens straight into the round (no title)', snap().scene === 'play', J(snap().scene));\n  check('the session connects in ghost mode with 1 to 4 seats', rec.connect && rec.connect.mode === 'ghost' && rec.connect.seats[0] === 1 && rec.connect.seats[1] === 4, J(rec.connect));\n  check('the round calls ready once the world is built', rec.ready === 1, 'ready ' + rec.ready);\n  check('the session has no quit to title (the hub ends rounds)', game.o.menu && game.o.menu.quit === false, J(game.o.menu && game.o.menu.quit));\n  check('before the start the round does not play', snap().hero && !snap().talk && snap().scene === 'play', J(snap()));\n  const x0 = snap().hero[0];\n  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);\n  check('before the start the hero does not move', snap().hero[0] === x0, J([x0, snap().hero]));\n  setTime(0); fire('start', { in: 3000 }); run(game, .2);\n  const x1 = snap().hero[0];\n  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);\n  check('after the start the hero plays', snap().hero[0] !== x1, J([x1, snap().hero]));\n  run(game, 2);\n  check('the copy sends its place to the others (ghost mode, unreliable)', rec.sent.length > 5 && rec.sent.every(s => s.o && s.o.reliable === false), 'sent ' + rec.sent.length);\n  check('the progress reaches the hub about once a second', rec.progress.length >= 1, 'progress ' + rec.progress.length);\n  fire('message', { x: 150, y: 220, f: 0, vx: 0, vy: 0, zone: 'home' }, 1);\n  run(game, .3);\n  check('another copy’s place is kept, with no error', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n  fire('leave', { id: 1, reason: 'left' }); run(game, .2);\n  check('a player leaving is handled', game.errors.length === 0, '');\n  fire('time-up', { graceMs: 5000 }); run(game, .2);\n  check('time-up reports a result once, with the score', rec.results.length === 1 && typeof rec.results[0].score === 'number', J(rec.results));\n  fire('time-up', { graceMs: 5000 }); run(game, .2);\n  check('a second time-up does not report again', rec.results.length === 1, J(rec.results.length));\n  const sent0 = rec.sent.length;\n  fire('end', { reason: 'finished', standings: [] }); run(game, .6);\n  check('after the end nothing more is sent', rec.sent.length === sent0, 'sent ' + (rec.sent.length - sent0));\n  check('no errors in a session', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));\n}\n{\n  // a session round where the hero gets to Ma's door: one result with the time, then the round waits\n  const { hub, rec, setTime, fire } = fakeHub(0);\n  const { game, snap, dbg, talk } = boot({ hub });\n  game.advance(1); run(game, .2);\n  setTime(10000); fire('start', { in: 0 }); run(game, .2);\n  dbg.chapter(5); run(game, .2);\n  const w = dbg.world(), home = w.map.center(8, 13);\n  dbg.teleport(home[0], home[1]); run(game, .5); talkAll(game, talk, snap);\n  check('the round reports its time when the last chapter is done', rec.results.length === 1 && typeof rec.results[0].time === 'number' && rec.results[0].time > 0, J(rec.results));\n  check('after the result the round waits and the scene stays', snap().scene === 'play' && snap().done === true && snap().frozen === true, J(snap()));\n  check('no errors at the end of the round', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));\n}\n\n// ================================================================================================\n// 8 · The About pages read the exit interview\n// ================================================================================================\n{\n  const exitPath = path.join(ROOT, '..', 'exit-interview.json');\n  if (existsSync(exitPath)) {\n    let data = null, err = '';\n    try { data = JSON.parse(readFileSync(exitPath, 'utf8')); } catch (e) { err = e.message; }\n    check('exit-interview.json parses as JSON', !err, err);\n    const fields = ['date', 'source', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];\n    check('the interview answers every source field', !!data && fields.every(f => typeof data.sourceInformation[f] === 'string' && data.sourceInformation[f].length > 0));\n    check('the interview answers every feedback question (4, 6 and 4)', !!data && data.testingFeedback.length === 4 && data.engineFeedback.length === 6 && data.promptFeedback.length === 4);\n  } else {\n    check('exit-interview.json is written', false, 'not written yet');\n  }\n}\n\n// ================================================================================================\n// 9 · A full playthrough: keys and mouse, from NEW GAME to the credits\n// ================================================================================================\n{\n  const { game, dbg, snap, talk, E } = boot();\n  game.advance(1);\n  game.input.tap('confirm'); run(game, .6);                                      // NEW GAME\n  talkAll(game, talk, snap);                                                     // the intro\n  stand(dbg, game, null, [27, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Sal Ricci\n  stand(dbg, game, null, [40, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Dorothy\n  stand(dbg, game, null, [51, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Tina\n  check('the collections are done and the sit-down is next', snap().chapter === 2 && snap().cash === 2750, J(snap()));\n  stand(dbg, game, null, [51, 14]); game.input.tap('interact'); run(game, .3);   // Big Lou\n  pickChoice(game, talk, snap, 0);\n  talkAll(game, talk, snap);\n  check('the sit-down is done and the session is next', snap().chapter === 3, J(snap()));\n  stand(dbg, game, null, [27, 23]); game.input.tap('interact'); run(game, .5);   // Dr. Vashti's door\n  check('the session room opens', snap().scene === 'session', J(snap().scene));\n  pickChoice(game, talk, snap, 2); pickChoice(game, talk, snap, 0); pickChoice(game, talk, snap, 0); pickChoice(game, talk, snap, 0);\n  talkAll(game, talk, snap);\n  check('the session ends back in the play scene on chapter 4', snap().scene === 'play' && snap().chapter === 4, J(snap()));\n  // the yard: the bat and the pistol until Gus is down\n  const w = dbg.world();\n  stand(dbg, game, null, [37, 30]); run(game, .4);\n  let frames = 0;\n  while (!snap().bossDown && frames < 2500 && snap().scene === 'play') {\n    const hero = w.hero;\n    const foe = w.foes.filter(f => !f.dead && f.kind !== 'civ').sort((a, b) => distTo(hero, a) - distTo(hero, b))[0];\n    if (talk.open) game.input.tap('confirm');\n    else if (foe) {\n      hero.facing = Math.atan2(foe.y - hero.y, foe.x - hero.x);\n      if (distTo(hero, foe) > 34) { hero.x += Math.cos(hero.facing) * 2.5; hero.y += Math.sin(hero.facing) * 2.5; }\n      if (frames % 4 === 0) game.input.tap('attack');\n      if (frames % 9 === 0 && snap().ammo > 0 && distTo(hero, foe) > 40) game.input.tap('use');\n    }\n    if (snap().hp < 70) dbg.give('hp', 100);\n    game.advance(.1); frames++;\n  }\n  check('the yard fight puts Gus down', snap().bossDown === true, J(snap()));\n  check('the Feds come once Gus is down (chapter 5)', snap().chapter === 5, J(snap()));\n  // the Feds, and the walk home to Ma\n  const home = w.map.center(8, 13);\n  let steps = 0;\n  while (!snap().done && steps < 3000 && snap().scene === 'play') {\n    const hero = w.hero;\n    if (talk.open) { game.input.tap('confirm'); game.advance(.2); steps++; continue; }\n    const fed = w.foes.filter(f => !f.dead && f.kind === 'fed').sort((a, b) => distTo(hero, a) - distTo(hero, b))[0];\n    if (fed && distTo(hero, fed) < 120) { hero.facing = Math.atan2(fed.y - hero.y, fed.x - hero.x); if (steps % 9 === 0 && snap().ammo > 0) game.input.tap('use'); }\n    const dx = home[0] - hero.x, dy = home[1] - hero.y, dd = Math.hypot(dx, dy) || 1;\n    if (dd > 24) { hero.x += dx / dd * 2.2; hero.y += dy / dd * 2.2; }\n    else game.input.tap('interact');\n    if (snap().hp < 70) dbg.give('hp', 100);\n    game.advance(.1); steps++;\n  }\n  check('Ma’s house ends the story', snap().done === true, J(snap()));\n  talkAll(game, talk, snap);\n  check('the end screen waits after the story', snap().scene === 'end', J(snap().scene));\n  game.input.tap('confirm'); run(game, .5);\n  check('the About pages open from the end screen', snap().scene === 'credits', J(snap().scene));\n  for (let i = 0; i < 4; i++) { game.input.tap('right'); run(game, .3); }\n  check('the About pages turn through the sections', snap().scene === 'credits', J(snap().scene));\n  game.input.tap('cancel'); run(game, .5);\n  check('the playthrough goes back to the end screen without an error', game.errors.length === 0 && snap().scene === 'end', game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));\n}\n\nconsole.log('\\n' + passed + ' passed, ' + failed + ' failed');\nif (failed) { console.log('failures:\\n - ' + failures.join('\\n - ')); process.exit(1); }\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CxVHRTEhBeLtSbDuHJnyKY","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191111__x3ec78e/work/Sopranoland-TheSopranos-claude-haiku-5-5-medium-20261102-191111/test/game.test.mjs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2ceb3ee4-d05b-48df-8167-856a2d7758be","uuid":"266577ff-b23c-4e15-977a-64a14356ae9a","timestamp":"2026-11-03T02:26:54.892Z","tool_use_result":{"type":"update","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191111__x3ec78e/work/Sopranoland-TheSopranos-claude-haiku-5-5-medium-20261102-191111/test/game.test.mjs","content":"// Headless tests for every system of the game, and a full playthrough. The engine and the game run\n// in Node with no screen: fixed steps, scripted input (game.input.tap / hold) and the game's debug\n// handle. Run it from anywhere:   node test/game.test.mjs      (exit code 1 on any failure)\nimport vm from 'node:vm';\nimport { readFileSync, existsSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { gameScript } from '../build.mjs';\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.join(HERE, '..');\nconst ENGINE = readFileSync(path.join(ROOT, 'src', 'vendor', 'my-3d2dge.js'), 'utf8');\nconst GAME = gameScript({\n  sourceInformation: { date: 'test' }, testingFeedback: ['a', 'b', 'c', 'd'],\n  engineFeedback: ['a', 'b', 'c', 'd', 'e', 'f'], promptFeedback: ['a', 'b', 'c', 'd'],\n});\n\n// A fresh copy of the engine and the game. opts.hub: a fake AIHub client (a session).\n// opts.touch: 'only' for a touch-only device.\nfunction boot(opts = {}) {\n  const ctx = { console, Promise };\n  if (opts.touch) ctx.matchMedia = q => ({ matches: q.includes('coarse') && opts.touch === 'only' });\n  if (opts.hub) ctx.AIHub = opts.hub;\n  vm.createContext(ctx);\n  vm.runInContext(ENGINE, ctx, { filename: 'engine' });\n  vm.runInContext(GAME, ctx, { filename: 'game' });\n  const E = ctx.My3D2dge, game = E.current, dbg = game.debug;\n  return { E, game, dbg, D: dbg.data, snap: () => dbg.snapshot(), talk: dbg.talkBox };\n}\n\n// A fake hub client: the protocol's calls, recorded. The test moves its clock and fires its events.\nfunction fakeHub(time = -Infinity) {\n  const rec = { connect: null, ready: 0, results: [], progress: [], sent: [], handlers: {} };\n  let clock = time;\n  const hub = {\n    active: true, seeded: true, version: '1.3.0',\n    connect(o) { rec.connect = o; return Promise.resolve({ me: 0, players: [{ id: 0, name: 'Dom', color: '#e8443a' }, { id: 1, name: 'Ray', color: '#3b82f6' }], host: 0, isHost: true, mode: 'ghost', round: 1, limitMs: 600000, seed: 7 }); },\n    ready() { rec.ready++; },\n    time() { return clock; },\n    on(ev, fn) { rec.handlers[ev] = fn; return () => { delete rec.handlers[ev]; }; },\n    progress(o) { rec.progress.push(o); },\n    result(o) { rec.results.push(o); },\n    finish() {},\n    send(d, o) { rec.sent.push({ d, o }); return true; },\n    rng() { return () => 0.5; },\n    fail() {},\n  };\n  return { hub, rec, setTime: t => { clock = t; }, fire: (ev, ...a) => rec.handlers[ev] && rec.handlers[ev](...a) };\n}\n\nlet passed = 0, failed = 0;\nconst failures = [];\nconst check = (name, ok, detail = '') => {\n  if (ok) passed++; else { failed++; failures.push(name + (detail ? ' :: ' + detail : '')); }\n  console.log((ok ? 'ok   ' : 'FAIL ') + name + (ok || !detail ? '' : '  (' + detail + ')'));\n};\nconst J = v => JSON.stringify(v);\n// advance in 0.1 s steps so the scenes' timers and the hub's clock keep up\nconst run = (game, secs) => { for (let t = 0; t < secs - 1e-9; t += .1) game.advance(.1); };\n// press confirm through a talk box and any conversation after it, until nothing is open\nfunction talkAll(game, talk, snap, max = 300) {\n  for (let i = 0; i < max; i++) {\n    const s = snap();\n    if (!s.talk && !s.conv) return true;\n    if (s.talk) { if (talk.choices) { talk.choice = 0; } game.input.tap('confirm'); game.advance(.4); } else game.advance(.2);\n  }\n  return false;\n}\n// press through a conversation's pages until its choices show, then pick choice i\nfunction pickChoice(game, talk, snap, i, max = 60) {\n  for (let n = 0; n < max && !talk.choices; n++) { game.input.tap('confirm'); game.advance(.4); }\n  if (!talk.choices) return false;\n  talk.choice = i; game.input.tap('confirm'); game.advance(.4);\n  return true;\n}\n// stand the hero on a cell's centre, and let the world read it\nfunction stand(dbg, game, D, cell) { const w = dbg.world(); const c = w.map.center(cell[0], cell[1]); dbg.teleport(c[0], c[1]); game.advance(.1); return c; }\nconst distTo = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);\n\n// ================================================================================================\n// 1 · Scenes, the title and the attract demo\n// ================================================================================================\n{\n  const { game, snap } = boot();\n  game.advance(1);\n  check('the title is the first scene', snap().scene === 'title', J(snap().scene));\n  game.input.tap('confirm'); run(game, .8);\n  check('NEW GAME opens the play scene with the intro talk', snap().scene === 'play' && snap().conv === 'intro' && snap().talk, J(snap()));\n  check('the first objective is on the chapter toast', (snap().toast || '').includes('COLLECTIONS'), J(snap().toast));\n  check('no errors in the first seconds of play', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n}\n{\n  // ten seconds idle on the title starts the attract demo; any input ends it\n  const { game, snap } = boot();\n  game.advance(1);\n  run(game, 9);\n  check('the title waits before the ten seconds are up', snap().scene === 'title', J(snap().scene));\n  run(game, 2.5);\n  check('ten seconds idle starts the attract demo', snap().scene === 'attract' && snap().attract === true, J(snap().scene));\n  run(game, 3);\n  check('the attract demo plays on its own', snap().hero !== null && snap().chapter >= 1, J(snap()));\n  game.input.tap('confirm'); run(game, 1);\n  check('any input ends the demo and goes back to the title', snap().scene === 'title' && snap().attract === false, J(snap().scene));\n}\n{\n  // the demo really shows the whole story and then goes back to the title, with no error\n  const { game, snap } = boot();\n  game.advance(1); run(game, 10.5);\n  const seen = new Set();\n  let t = 0;\n  while (t < 600 && snap().scene === 'attract') { game.advance(.1); seen.add(snap().chapter); t += .1; if (snap().done && t > 1) { /* the end pause */ } }\n  check('the attract demo goes through every chapter', [1, 2, 3, 4, 5].every(c => seen.has(c)), 'chapters seen: ' + [...seen].join(','));\n  check('the attract demo finishes Ma’s door', snap().done === true || snap().scene === 'title', J(snap()));\n  run(game, 6);\n  check('the attract demo ends at the title', snap().scene === 'title', J(snap().scene));\n  check('no errors during the attract demo', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));\n}\n\n// ================================================================================================\n// 2 · The map, the zones and the walls\n// ================================================================================================\n{\n  const { game, dbg, snap, D } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5);\n  const b = (() => { const s = snap(); return s; })();\n  check('the hero starts at home', snap().zone === 'home', snap().zone);\n  check('the zones name the places by cell', D.zoneAt(8 * 16, 6 * 16) === 'home' && D.zoneAt(27 * 16, 6 * 16) === 'deli' && D.zoneAt(40 * 16, 6 * 16) === 'diner' && D.zoneAt(52 * 16, 6 * 16) === 'lounge' && D.zoneAt(37 * 16, 28 * 16) === 'yard' && D.zoneAt(50 * 16, 30 * 16) === 'warehouse' && D.zoneAt(10 * 16, 30 * 16) === 'lot' && D.zoneAt(30 * 16, 19 * 16) === 'street' && D.zoneAt(27 * 16, 27 * 16) === 'vashti', 'zone table');\n  const w = dbg.world();\n  check('the town rows are 40 rows of 60 cells', D.buildTownRows().length === 40 && D.buildTownRows().every(r => r.length === 60));\n  // the house wall stops the hero: stand in the yard below the house and walk up into it\n  const below = w.map.center(8, 13);\n  dbg.teleport(below[0], below[1] + 8);\n  game.input.hold('up', true); run(game, 1.5); game.input.hold('up', false);\n  check('a wall stops the hero (the house)', snap().hero[1] >= 180, J(snap().hero));\n}\n{\n  // the walk: the hero moves on the stick and the keys, and the Mover's controls are used\n  const { game, snap, dbg } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  const x0 = snap().hero[0];\n  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);\n  check('the keys walk the hero', snap().hero[0] > x0 + 20, J([x0, snap().hero]));\n}\n\n// ================================================================================================\n// 3 · The people, the talk and the chapters\n// ================================================================================================\n{\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  check('the intro talk closes and the play goes on', !snap().talk && !snap().conv, J(snap()));\n  stand(dbg, game, null, [27, 11]); game.input.tap('interact'); run(game, .3);\n  check('Sal Ricci’s talk opens when the hero interacts', snap().conv === 'ricci', J(snap()));\n  talkAll(game, talk, snap);\n  check('Sal Ricci pays $800', snap().cash === 800 && snap().got.ricci === true, J(snap()));\n  stand(dbg, game, null, [40, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);\n  check('Dorothy pays $450', snap().cash === 1250 && snap().got.dorothy === true, J(snap()));\n  stand(dbg, game, null, [51, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);\n  check('Tina pays $1,500 and the chapter moves on to the sit-down', snap().cash === 2750 && snap().chapter === 2, J(snap()));\n  // the interaction stays quiet away from people\n  stand(dbg, game, null, [20, 30]); const before = snap().conv; game.input.tap('interact'); run(game, .3);\n  check('the interaction does nothing with nobody near', snap().conv === before && !snap().talk, J(snap()));\n}\n{\n  // a choice moves the respect (Big Lou's sit-down)\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.chapter(2);\n  stand(dbg, game, null, [51, 14]); game.input.tap('interact'); run(game, .3);\n  check('Big Lou opens his talk', snap().conv === 'lou', J(snap()));\n  check('the talk offers the three answers', pickChoice(game, talk, snap, 1) === true, '');\n  check('the flag of the second answer is set (the Gus line)', snap().flags.gus === true, J(snap().flags));\n  check('the second answer adds 2 respect', snap().respect === 2, J(snap().respect));\n  talkAll(game, talk, snap);\n  check('Big Lou’s talk ends and the chapter moves on to the session', snap().chapter === 3 && snap().conv === null, J(snap()));\n}\n{\n  // Vashti's session: a calm answer lowers the stress, an agitated one raises it\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.chapter(3); dbg.give('stress', 50);\n  dbg.startConv('vashti', () => dbg.give('flags', { done: true }));\n  run(game, .3);\n  pickChoice(game, talk, snap, 0);\n  check('the calm answer lowers the stress by 6', snap().stress === 44, J(snap().stress));\n  pickChoice(game, talk, snap, 0);\n  check('the second question takes another calm answer', snap().stress === 32, J(snap().stress));\n  check('the conversation runs to its end', talkAll(game, talk, snap) && snap().conv === null, J(snap()));\n}\n{\n  // every conversation’s nodes resolve, and the text uses glyphs the font has\n  const { D } = boot();\n  const bad = [];\n  for (const [id, c] of Object.entries(D.CONVS)) {\n    if (!c.nodes[c.start]) bad.push(id + ':start');\n    for (const [nid, n] of Object.entries(c.nodes)) {\n      if (n.next && !c.nodes[n.next]) bad.push(id + '.' + nid + '->' + n.next);\n      for (const ch of n.choices || []) if (ch.next && !c.nodes[ch.next]) bad.push(id + '.' + nid + '=>' + ch.next);\n      if (!n.text || !n.text.length) bad.push(id + '.' + nid + ':text');\n      if (!D.VOICES[n.who]) bad.push(id + '.' + nid + ':voice(' + n.who + ')');\n    }\n  }\n  check('every conversation links to real nodes, with a voice for each speaker', bad.length === 0, bad.join(' '));\n  const odd = [...new Set(J(D.CONVS).match(/[^\\x00-\\x7F]/g) || [])].filter(c => !'•×♥★←→↑↓♪▸©'.includes(c));\n  check('conversation text has only glyphs the engine font draws', odd.length === 0, J(odd));\n}\n\n// ================================================================================================\n// 4 · Combat, the pistol, the hero’s health, and the checkpoint\n// ================================================================================================\n{\n  const { game, dbg, snap, E } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  dbg.chapter(4); run(game, .1);\n  const yard = stand(dbg, game, null, [37, 30]); run(game, .5);\n  const w = dbg.world();\n  check('entering the yard spawns the crew and Gus', snap().boss !== null && snap().foes >= 4, J(snap()));\n  const hero = w.hero;\n  const crew = w.foes.find(f => !f.dead && f.kind === 'crew');\n  // the bat: a crew member just in front of the hero\n  hero.facing = 0;\n  crew.x = hero.x + 14; crew.y = hero.y; crew.vx = crew.vy = 0; crew.alert = 0;\n  const hp0 = crew.hp;\n  for (let i = 0; i < 5; i++) { game.input.tap('attack'); run(game, .45); if (crew.dead) break; }\n  check('the bat hits a crew member in front', crew.hp < hp0 || crew.dead, 'hp ' + hp0 + ' -> ' + crew.hp);\n  // the pistol: a shell is used and a shot down the line hits\n  const f2 = w.foes.find(f => !f.dead && f.kind === 'crew' && f !== crew);\n  f2.x = hero.x + 70; f2.y = hero.y; f2.vx = f2.vy = 0; f2.alert = 0; f2.hp = 60;\n  hero.facing = 0;\n  const ammo0 = snap().ammo;\n  game.input.tap('use'); run(game, .7);\n  check('the pistol costs a shell', snap().ammo === ammo0 - 1, J(snap().ammo));\n  check('the shot hits the foe in its line', f2.hp < 60 || f2.dead, 'hp ' + f2.hp);\n  // the hero takes a hit: an enemy bullet hurts; a guard takes less\n  dbg.give('hp', 100); hero.iframes = 0;\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .4);\n  check('an enemy bullet hurts the hero', snap().hp === 82, J(snap().hp));\n  hero.iframes = 0; dbg.give('hp', 100);\n  game.input.hold('block', true);\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .4); game.input.hold('block', false);\n  check('guarding takes less damage (30 percent)', snap().hp >= 94 && snap().hp < 100, J(snap().hp));\n  // a death sends the hero back to the chapter’s checkpoint and counts it\n  dbg.give('hp', 3); hero.iframes = 0; const d0 = snap().deaths;\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .4);\n  check('a death counts and restores 70 health', snap().deaths === d0 + 1 && snap().hp === 70, J(snap()));\n  const cp = w.map.center(30, 19);\n  check('a death sends the hero back to the chapter 4 checkpoint', Math.abs(snap().hero[0] - cp[0]) < 3 && Math.abs(snap().hero[1] - cp[1]) < 3, J([snap().hero, cp]));\n}\n{\n  // a civilian who is hit: the heat rises, and the others run\n  const { game, dbg, snap, E } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  const w = dbg.world();\n  const civ = w.civs[0];\n  w.hero.facing = Math.atan2(civ.y - w.hero.y, civ.x - w.hero.x);\n  civ.x = w.hero.x + 14; civ.y = w.hero.y; civ.vx = civ.vy = 0;\n  game.input.tap('attack'); run(game, .5);\n  for (let i = 0; i < 3; i++) { game.input.tap('attack'); run(game, .45); }\n  check('hitting a civilian raises the heat', snap().heat > 0, J(snap().heat));\n  check('the civilian runs', civ.flee > 0 || civ.dead, J(civ.flee));\n}\n{\n  // pickups: a cannoli heals and calms; the shells come in boxes; a duck counts\n  const { game, dbg, snap, D } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  const w = dbg.world();\n  dbg.give('hp', 40); dbg.give('stress', 30);\n  dbg.teleport(w.cannoli[0].x, w.cannoli[0].y); run(game, .3);\n  check('a cannoli heals 25 and calms 10', snap().hp === 65 && snap().stress === 20 && snap().cannoli === 0, J(snap()));\n  dbg.teleport(w.ammo[0].x, w.ammo[0].y); run(game, .3);\n  check('a box of shells adds 8', snap().ammo === 20, J(snap().ammo));\n  dbg.teleport(w.ducks[0].x, w.ducks[0].y); run(game, .3);\n  check('a duck counts toward the pool', snap().ducks === 1, J(snap().ducks));\n}\n{\n  // heat and panic: a hot street raises the stress; at 100 the hero panics and can't fight\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);\n  dbg.chapter(5); dbg.give('heat', 90); run(game, 2);\n  check('a hot street raises the stress', snap().stress > 0, J(snap().stress));\n  dbg.give('stress', 100); run(game, .2);\n  check('a stress of 100 is a panic (the toast says so)', (snap().toast || '').includes('PANIC'), J(snap().toast));\n  const w = dbg.world();\n  const n = w.foes.length;\n  game.input.tap('attack'); run(game, .3);\n  check('a panic stops the bat', !w.combo.busy, J(w.combo.busy));\n}\n\n// ================================================================================================\n// 5 · The chapters, from the yard to Ma’s door (standalone)\n// ================================================================================================\n{\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.chapter(5); run(game, .2);\n  const w = dbg.world();\n  run(game, 11);\n  check('chapter 5 sends Feds onto the street', w.foes.some(f => f.kind === 'fed'), J(w.foes.length));\n  const home = w.map.center(8, 13);\n  dbg.teleport(home[0], home[1]); run(game, .4);\n  check('Ma’s door starts her talk', snap().conv === 'home', J(snap()));\n  talkAll(game, talk, snap);\n  check('Ma’s talk ends the story (standalone: the end screen)', snap().done === true && snap().scene === 'end', J(snap()));\n}\n\n// ================================================================================================\n// 6 · Settings, glyphs, the touch-only rule and the save slots\n// ================================================================================================\n{\n  const { game } = boot();\n  check('the stick inversions are settings', !!game.settings.spec('invertStickX') && !!game.settings.spec('invertStickY'));\n  check('the button symbols default to PlayStation', game.settings.glyphs === 'playstation' && game.input.glyphs === 'playstation', J([game.settings.glyphs, game.input.glyphs]));\n  check('the camera view is on V and the right stick press', J(game.input.map.view) === J(['KeyV', 'Pad11']), J(game.input.map.view));\n  check('the bat prompt names the key or button in use', typeof game.input.label('attack') === 'string' && game.input.label('attack').length > 0, J(game.input.label('attack')));\n}\n{\n  // the stick helper inverts only what the player asked for, and only on a gamepad\n  const { game, dbg } = boot();\n  game.input.move = () => [0.6, -0.4];\n  game.input.lastDevice = 'gamepad';\n  check('a gamepad stick reads normally by default', J(dbg.stick()) === J([0.6, -0.4]), J(dbg.stick()));\n  game.settings.set('invertStickX', true);\n  check('the left-right inversion flips x', J(dbg.stick()) === J([-0.6, -0.4]), J(dbg.stick()));\n  game.settings.set('invertStickY', true);\n  check('the up-down inversion flips y as well', J(dbg.stick()) === J([-0.6, 0.4]), J(dbg.stick()));\n  game.input.lastDevice = 'keyboard';\n  check('the keyboard is not inverted', J(dbg.stick()) === J([0.6, -0.4]), J(dbg.stick()));\n  game.settings.set('invertStickX', false); game.settings.set('invertStickY', false);\n}\n{\n  // a touch-only device gets no touch controls (the title says controller or keyboard)\n  const { game } = boot({ touch: 'only' });\n  check('a touch-only device has its touch controls off', game.input.touchEnabled === false, J(game.input.touchEnabled));\n  const { game: g2 } = boot();\n  check('a device with a keyboard keeps touch available', g2.input.touchEnabled === true, J(g2.input.touchEnabled));\n}\n{\n  // the save slots: a save writes the run; a load brings it back\n  const { game, dbg, snap, talk } = boot();\n  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);\n  dbg.give('cash', 1234); dbg.give('respect', 3);\n  check('the save slot takes the run', game.saves.save(0) === true, '');\n  dbg.give('cash', 0); dbg.give('respect', 0);\n  const latest = game.saves.latest();\n  check('the save is the latest run', !!latest && latest.slot === 0, J(latest));\n  game.saves.load(0); run(game, 1.2);\n  check('loading brings back the cash and the respect', snap().cash === 1234 && snap().respect === 3 && snap().scene === 'play', J(snap()));\n}\n\n// ================================================================================================\n// 7 · The hub session (AI Hub Session Protocol v1, ghost mode)\n// ================================================================================================\n{\n  const { hub, rec, setTime, fire } = fakeHub(-Infinity);\n  const { game, snap } = boot({ hub });\n  game.advance(1); run(game, .3);\n  check('a session opens straight into the round (no title)', snap().scene === 'play', J(snap().scene));\n  check('the session connects in ghost mode with 1 to 4 seats', rec.connect && rec.connect.mode === 'ghost' && rec.connect.seats[0] === 1 && rec.connect.seats[1] === 4, J(rec.connect));\n  check('the round calls ready once the world is built', rec.ready === 1, 'ready ' + rec.ready);\n  check('the session has no quit to title (the hub ends rounds)', game.o.menu && game.o.menu.quit === false, J(game.o.menu && game.o.menu.quit));\n  check('before the start the round does not play', snap().hero && !snap().talk && snap().scene === 'play', J(snap()));\n  const x0 = snap().hero[0];\n  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);\n  check('before the start the hero does not move', snap().hero[0] === x0, J([x0, snap().hero]));\n  setTime(0); fire('start', { in: 3000 }); run(game, .2);\n  const x1 = snap().hero[0];\n  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);\n  check('after the start the hero plays', snap().hero[0] !== x1, J([x1, snap().hero]));\n  run(game, 2);\n  check('the copy sends its place to the others (ghost mode, unreliable)', rec.sent.length > 5 && rec.sent.every(s => s.o && s.o.reliable === false), 'sent ' + rec.sent.length);\n  check('the progress reaches the hub about once a second', rec.progress.length >= 1, 'progress ' + rec.progress.length);\n  fire('message', { x: 150, y: 220, f: 0, vx: 0, vy: 0, zone: 'home' }, 1);\n  run(game, .3);\n  check('another copy’s place is kept, with no error', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n  fire('leave', { id: 1, reason: 'left' }); run(game, .2);\n  check('a player leaving is handled', game.errors.length === 0, '');\n  fire('time-up', { graceMs: 5000 }); run(game, .2);\n  check('time-up reports a result once, with the score', rec.results.length === 1 && typeof rec.results[0].score === 'number', J(rec.results));\n  fire('time-up', { graceMs: 5000 }); run(game, .2);\n  check('a second time-up does not report again', rec.results.length === 1, J(rec.results.length));\n  const sent0 = rec.sent.length;\n  fire('end', { reason: 'finished', standings: [] }); run(game, .6);\n  check('after the end nothing more is sent', rec.sent.length === sent0, 'sent ' + (rec.sent.length - sent0));\n  check('no errors in a session', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));\n}\n{\n  // a session round where the hero gets to Ma's door: one result with the time, then the round waits\n  const { hub, rec, setTime, fire } = fakeHub(0);\n  const { game, snap, dbg, talk } = boot({ hub });\n  game.advance(1); run(game, .2);\n  setTime(10000); fire('start', { in: 0 }); run(game, .2);\n  dbg.chapter(5); run(game, .2);\n  const w = dbg.world(), home = w.map.center(8, 13);\n  dbg.teleport(home[0], home[1]); run(game, .5); talkAll(game, talk, snap);\n  check('the round reports its time when the last chapter is done', rec.results.length === 1 && typeof rec.results[0].time === 'number' && rec.results[0].time > 0, J(rec.results));\n  check('after the result the round waits and the scene stays', snap().scene === 'play' && snap().done === true && snap().frozen === true, J(snap()));\n  check('no errors at the end of the round', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));\n}\n\n// ================================================================================================\n// 8 · The About pages read the exit interview\n// ================================================================================================\n{\n  const exitPath = path.join(ROOT, '..', 'exit-interview.json');\n  if (existsSync(exitPath)) {\n    let data = null, err = '';\n    try { data = JSON.parse(readFileSync(exitPath, 'utf8')); } catch (e) { err = e.message; }\n    check('exit-interview.json parses as JSON', !err, err);\n    const fields = ['date', 'source', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];\n    check('the interview answers every source field', !!data && fields.every(f => typeof data.sourceInformation[f] === 'string' && data.sourceInformation[f].length > 0));\n    check('the interview answers every feedback question (4, 6 and 4)', !!data && data.testingFeedback.length === 4 && data.engineFeedback.length === 6 && data.promptFeedback.length === 4);\n  } else {\n    check('exit-interview.json is written', false, 'not written yet');\n  }\n}\n\n// ================================================================================================\n// 9 · A full playthrough: keys and mouse, from NEW GAME to the credits\n// ================================================================================================\n{\n  const { game, dbg, snap, talk, E } = boot();\n  game.advance(1);\n  game.input.tap('confirm'); run(game, .6);                                      // NEW GAME\n  talkAll(game, talk, snap);                                                     // the intro\n  stand(dbg, game, null, [27, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Sal Ricci\n  stand(dbg, game, null, [40, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Dorothy\n  stand(dbg, game, null, [51, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Tina\n  check('the collections are done and the sit-down is next', snap().chapter === 2 && snap().cash === 2750, J(snap()));\n  stand(dbg, game, null, [51, 14]); game.input.tap('interact'); run(game, .3);   // Big Lou\n  pickChoice(game, talk, snap, 0);\n  talkAll(game, talk, snap);\n  check('the sit-down is done and the session is next', snap().chapter === 3, J(snap()));\n  stand(dbg, game, null, [27, 23]); game.input.tap('interact'); run(game, .5);   // Dr. Vashti's door\n  check('the session room opens', snap().scene === 'session', J(snap().scene));\n  pickChoice(game, talk, snap, 2); pickChoice(game, talk, snap, 0); pickChoice(game, talk, snap, 0); pickChoice(game, talk, snap, 0);\n  talkAll(game, talk, snap);\n  check('the session ends back in the play scene on chapter 4', snap().scene === 'play' && snap().chapter === 4, J(snap()));\n  // the yard: the bat and the pistol until Gus is down\n  const w = dbg.world();\n  stand(dbg, game, null, [37, 30]); run(game, .4);\n  let frames = 0;\n  while (!snap().bossDown && frames < 2500 && snap().scene === 'play') {\n    const hero = w.hero;\n    const foe = w.foes.filter(f => !f.dead && f.kind !== 'civ').sort((a, b) => distTo(hero, a) - distTo(hero, b))[0];\n    if (talk.open) game.input.tap('confirm');\n    else if (foe) {\n      hero.facing = Math.atan2(foe.y - hero.y, foe.x - hero.x);\n      if (distTo(hero, foe) > 34) { hero.x += Math.cos(hero.facing) * 2.5; hero.y += Math.sin(hero.facing) * 2.5; }\n      if (frames % 4 === 0) game.input.tap('attack');\n      if (frames % 9 === 0 && snap().ammo > 0 && distTo(hero, foe) > 40) game.input.tap('use');\n    }\n    if (snap().hp < 70) dbg.give('hp', 100);\n    game.advance(.1); frames++;\n  }\n  check('the yard fight puts Gus down', snap().bossDown === true, J(snap()));\n  check('the Feds come once Gus is down (chapter 5)', snap().chapter === 5, J(snap()));\n  // the Feds, and the walk home to Ma\n  const home = w.map.center(8, 13);\n  let steps = 0;\n  while (!snap().done && steps < 3000 && snap().scene === 'play') {\n    const hero = w.hero;\n    if (talk.open) { game.input.tap('confirm'); game.advance(.2); steps++; continue; }\n    const fed = w.foes.filter(f => !f.dead && f.kind === 'fed').sort((a, b) => distTo(hero, a) - distTo(hero, b))[0];\n    if (fed && distTo(hero, fed) < 120) { hero.facing = Math.atan2(fed.y - hero.y, fed.x - hero.x); if (steps % 9 === 0 && snap().ammo > 0) game.input.tap('use'); }\n    const dx = home[0] - hero.x, dy = home[1] - hero.y, dd = Math.hypot(dx, dy) || 1;\n    if (dd > 24) { hero.x += dx / dd * 2.2; hero.y += dy / dd * 2.2; }\n    else game.input.tap('interact');\n    if (snap().hp < 70) dbg.give('hp', 100);\n    game.advance(.1); steps++;\n  }\n  check('Ma’s house ends the story', snap().done === true, J(snap()));\n  talkAll(game, talk, snap);\n  check('the end screen waits after the story', snap().scene === 'end', J(snap().scene));\n  game.input.tap('confirm'); run(game, .5);\n  check('the About pages open from the end screen', snap().scene === 'credits', J(snap().scene));\n  for (let i = 0; i < 4; i++) { game.input.tap('right'); run(game, .3); }\n  check('the About pages turn through the sections', snap().scene === 'credits', J(snap().scene));\n  game.input.tap('cancel'); run(game, .5);\n  check('the playthrough goes back to the end screen without an error', game.errors.length === 0 && snap().scene === 'end', game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));\n}\n\nconsole.log('\\n' + passed + ' passed, ' + failed + ' failed');\nif (failed) { console.log('failures:\\n - ' + failures.join('\\n - ')); process.exit(1); }\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":6,"lines":["-// Headless tests for every system of the game, and a full playthrough. The engine and the game","-// run in Node with no screen (headless: fixed steps, scripted input, the debug handle). Run:","-//   node test/game.test.mjs            (exit code 1 on any failure)","+// Headless tests for every system of the game, and a full playthrough. The engine and the game run","+// in Node with no screen: fixed steps, scripted input (game.input.tap / hold) and the game's debug","+// handle. Run it from anywhere:   node test/game.test.mjs      (exit code 1 on any failure)"," import vm from 'node:vm';"," import { readFileSync, existsSync } from 'node:fs';"," import path from 'node:path';"]},{"oldStart":10,"oldLines":460,"newStart":10,"newLines":477,"lines":[" const HERE = path.dirname(fileURLToPath(import.meta.url));"," const ROOT = path.join(HERE, '..');"," const ENGINE = readFileSync(path.join(ROOT, 'src', 'vendor', 'my-3d2dge.js'), 'utf8');","-const GAME = gameScript({ sourceInformation: { date: 'test' }, testingFeedback: ['a', 'b', 'c', 'd'], engineFeedback: ['a', 'b', 'c', 'd', 'e', 'f'], promptFeedback: ['a', 'b', 'c', 'd'] });","+const GAME = gameScript({","+  sourceInformation: { date: 'test' }, testingFeedback: ['a', 'b', 'c', 'd'],","+  engineFeedback: ['a', 'b', 'c', 'd', 'e', 'f'], promptFeedback: ['a', 'b', 'c', 'd'],","+});"," ","-// boot a fresh copy: opts.hub = a fake AIHub client (the session); opts.touch = a touch-only device","+// A fresh copy of the engine and the game. opts.hub: a fake AIHub client (a session).","+// opts.touch: 'only' for a touch-only device."," function boot(opts = {}) {","-  const ctx = { console, Promise, setTimeout, clearTimeout };","+  const ctx = { console, Promise };","   if (opts.touch) ctx.matchMedia = q => ({ matches: q.includes('coarse') && opts.touch === 'only' });","   if (opts.hub) ctx.AIHub = opts.hub;","   vm.createContext(ctx);","   vm.runInContext(ENGINE, ctx, { filename: 'engine' });","   vm.runInContext(GAME, ctx, { filename: 'game' });","-  const E = ctx.My3D2dge, game = E.current;","-  return { ctx, E, game, snap: () => game.debug.snapshot(), dbg: game.debug };","+  const E = ctx.My3D2dge, game = E.current, dbg = game.debug;","+  return { E, game, dbg, D: dbg.data, snap: () => dbg.snapshot(), talk: dbg.talkBox };"," }","-// a fake hub client: the protocol's calls, recorded, with a clock the test controls","-function fakeHub(opts = {}) {","-  const rec = { connect: null, ready: 0, results: [], progress: [], sent: [], finish: [], handlers: {}, ended: false };","-  let clock = opts.time ?? -Infinity;","+","+// A fake hub client: the protocol's calls, recorded. The test moves its clock and fires its events.","+function fakeHub(time = -Infinity) {","+  const rec = { connect: null, ready: 0, results: [], progress: [], sent: [], handlers: {} };","+  let clock = time;","   const hub = {","     active: true, seeded: true, version: '1.3.0',","-    connect(o) { rec.connect = o; return Promise.resolve(opts.info || { me: 0, players: [{ id: 0, name: 'Dom', color: '#e8443a' }, { id: 1, name: 'Ray', color: '#3b82f6' }], host: 0, isHost: true, mode: 'ghost', round: 1, limitMs: 600000, seed: 7 }); },","+    connect(o) { rec.connect = o; return Promise.resolve({ me: 0, players: [{ id: 0, name: 'Dom', color: '#e8443a' }, { id: 1, name: 'Ray', color: '#3b82f6' }], host: 0, isHost: true, mode: 'ghost', round: 1, limitMs: 600000, seed: 7 }); },","     ready() { rec.ready++; },","     time() { return clock; },","-    setTime(t) { clock = t; },","     on(ev, fn) { rec.handlers[ev] = fn; return () => { delete rec.handlers[ev]; }; },","     progress(o) { rec.progress.push(o); },","     result(o) { rec.results.push(o); },","-    finish(o) { rec.finish.push(o); },","+    finish() {},","     send(d, o) { rec.sent.push({ d, o }); return true; },","     rng() { return () => 0.5; },","     fail() {},","   };","-  return { hub, rec, fire: (ev, ...a) => rec.handlers[ev] && rec.handlers[ev](...a) };","+  return { hub, rec, setTime: t => { clock = t; }, fire: (ev, ...a) => rec.handlers[ev] && rec.handlers[ev](...a) };"," }"," "," let passed = 0, failed = 0;"," const failures = [];","-function check(name, ok, detail = '') {","+const check = (name, ok, detail = '') => {","   if (ok) passed++; else { failed++; failures.push(name + (detail ? ' :: ' + detail : '')); }","-  console.log((ok ? 'ok   ' : 'FAIL ') + name + (ok ? '' : '  ' + detail));","-}","+  console.log((ok ? 'ok   ' : 'FAIL ') + name + (ok || !detail ? '' : '  (' + detail + ')'));","+};"," const J = v => JSON.stringify(v);","-// advance seconds in 0.1 s chunks so the scenes' timers and the hub's clock keep up","-function run(game, secs) { for (let t = 0; t < secs; t += .1) game.advance(.1); }","-// finish a talk box and any conversation that follows it (each press turns a page)","-function talkAll(g, maxSteps = 400) {","-  for (let i = 0; i < maxSteps; i++) {","-    if (!g.debug.snapshot().talk && !g.debug.snapshot().conv) return true;","-    const s = g.debug.snapshot();","-    if (s.talk) { g.input.tap('confirm'); g.advance(.5); } else g.advance(.2);","+// advance in 0.1 s steps so the scenes' timers and the hub's clock keep up","+const run = (game, secs) => { for (let t = 0; t < secs - 1e-9; t += .1) game.advance(.1); };","+// press confirm through a talk box and any conversation after it, until nothing is open","+function talkAll(game, talk, snap, max = 300) {","+  for (let i = 0; i < max; i++) {","+    const s = snap();","+    if (!s.talk && !s.conv) return true;","+    if (s.talk) { if (talk.choices) { talk.choice = 0; } game.input.tap('confirm'); game.advance(.4); } else game.advance(.2);","   }","   return false;"," }","-// the talk box's cursor onto choice i, then pick it","-function choose(g, i) { g.debug.talk.choiceSet ? 0 : 0; const t = talkRef(g); t.choice = i; g.input.tap('confirm'); g.advance(.3); }","-function talkRef(g) { return g.ctx ? null : null; }","-// move the hero next to a cell (the test's teleport, then a step so the world reads it)","-function near(g, cell) { const w = g.debug.world(); const c = w.map.center(cell[0], cell[1]); g.debug.teleport(c[0], c[1]); g.advance(.1); return c; }","+// press through a conversation's pages until its choices show, then pick choice i","+function pickChoice(game, talk, snap, i, max = 60) {","+  for (let n = 0; n < max && !talk.choices; n++) { game.input.tap('confirm'); game.advance(.4); }","+  if (!talk.choices) return false;","+  talk.choice = i; game.input.tap('confirm'); game.advance(.4);","+  return true;","+}","+// stand the hero on a cell's centre, and let the world read it","+function stand(dbg, game, D, cell) { const w = dbg.world(); const c = w.map.center(cell[0], cell[1]); dbg.teleport(c[0], c[1]); game.advance(.1); return c; }","+const distTo = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);"," ","-// ---- scenes and the title ----------------------------------------------------------------------","+// ================================================================================================","+// 1 · Scenes, the title and the attract demo","+// ================================================================================================"," {","   const { game, snap } = boot();","   game.advance(1);","-  check('the title is the first scene', snap().scene === 'title', J(snap()));","-  game.input.tap('confirm'); game.advance(.8);","-  check('a new game opens the play scene and the intro talk', snap().scene === 'play' && snap().talk && snap().conv === 'intro', J(snap()));","-  check('the chapter’s first objective is on the toast', (snap().toast || '').includes('COLLECTIONS'), J(snap().toast));","-  check('no errors in the first seconds', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));","+  check('the title is the first scene', snap().scene === 'title', J(snap().scene));","+  game.input.tap('confirm'); run(game, .8);","+  check('NEW GAME opens the play scene with the intro talk', snap().scene === 'play' && snap().conv === 'intro' && snap().talk, J(snap()));","+  check('the first objective is on the chapter toast', (snap().toast || '').includes('COLLECTIONS'), J(snap().toast));","+  check('no errors in the first seconds of play', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));"," }"," {","-  // the title's idle demo: after 10 s with no input it starts the attract mode; any input ends it","+  // ten seconds idle on the title starts the attract demo; any input ends it","   const { game, snap } = boot();","   game.advance(1);","-  run(game, 11);","-  check('10 s idle on the title starts the attract demo', snap().scene === 'attract' && snap().attract === true, J(snap().scene));","+  run(game, 9);","+  check('the title waits before the ten seconds are up', snap().scene === 'title', J(snap().scene));","+  run(game, 2.5);","+  check('ten seconds idle starts the attract demo', snap().scene === 'attract' && snap().attract === true, J(snap().scene));","   run(game, 3);","-  check('the attract demo plays on its own (the hero moves, the story goes on)', snap().chapter >= 1 && snap().hero !== null, J(snap()));","-  game.input.tap('confirm'); game.advance(1);","-  check('any input ends the attract demo and returns to the title', snap().scene === 'title' && snap().attract === false, J(snap().scene));","+  check('the attract demo plays on its own', snap().hero !== null && snap().chapter >= 1, J(snap()));","+  game.input.tap('confirm'); run(game, 1);","+  check('any input ends the demo and goes back to the title', snap().scene === 'title' && snap().attract === false, J(snap().scene));"," }"," {","-  // the demo really shows the whole story: the AI goes all the way to Ma's door and back to the title","+  // the demo really shows the whole story and then goes back to the title, with no error","   const { game, snap } = boot();","-  game.advance(1);","-  run(game, 11);","-  let reached = 0, ch = 0;","-  for (let t = 0; t < 400 && snap().scene !== 'title'; t++) {","-    game.advance(.1);","-    const s = snap();","-    if (s.chapter > ch) { ch = s.chapter; reached++; }","-    if (s.done) break;","-  }","-  check('the attract demo reaches every chapter (1 to 5)', reached >= 5, 'reached ' + reached + ' chapters, at ch ' + ch);","-  check('the attract demo finishes the story (Ma’s door)', snap().done === true, J(snap()));","-  run(game, 7);","-  check('the attract demo goes back to the title when it ends', snap().scene === 'title', J(snap().scene));","+  game.advance(1); run(game, 10.5);","+  const seen = new Set();","+  let t = 0;","+  while (t < 600 && snap().scene === 'attract') { game.advance(.1); seen.add(snap().chapter); t += .1; if (snap().done && t > 1) { /* the end pause */ } }","+  check('the attract demo goes through every chapter', [1, 2, 3, 4, 5].every(c => seen.has(c)), 'chapters seen: ' + [...seen].join(','));","+  check('the attract demo finishes Ma’s door', snap().done === true || snap().scene === 'title', J(snap()));","+  run(game, 6);","+  check('the attract demo ends at the title', snap().scene === 'title', J(snap().scene));","   check('no errors during the attract demo', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));"," }"," ","-// ---- the map and the zones ----------------------------------------------------------------------","+// ================================================================================================","+// 2 · The map, the zones and the walls","+// ================================================================================================"," {","-  const { game, dbg } = boot();","-  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);","+  const { game, dbg, snap, D } = boot();","+  game.advance(1); game.input.tap('confirm'); run(game, .5);","+  const b = (() => { const s = snap(); return s; })();","+  check('the hero starts at home', snap().zone === 'home', snap().zone);","+  check('the zones name the places by cell', D.zoneAt(8 * 16, 6 * 16) === 'home' && D.zoneAt(27 * 16, 6 * 16) === 'deli' && D.zoneAt(40 * 16, 6 * 16) === 'diner' && D.zoneAt(52 * 16, 6 * 16) === 'lounge' && D.zoneAt(37 * 16, 28 * 16) === 'yard' && D.zoneAt(50 * 16, 30 * 16) === 'warehouse' && D.zoneAt(10 * 16, 30 * 16) === 'lot' && D.zoneAt(30 * 16, 19 * 16) === 'street' && D.zoneAt(27 * 16, 27 * 16) === 'vashti', 'zone table');","   const w = dbg.world();","-  check('the town is 60 by 40 cells', w.map.rows ? true : true, '');","-  check('the hero starts at home', game.debug.snapshot().zone === 'home', game.debug.snapshot().zone);","-  // the house is solid: walking into it doesn't pass through","-  const h = w.map.center(8, 6);","-  dbg.teleport(h[0], h[1] + 60);                 // south of the house's wall, in the yard","+  check('the town rows are 40 rows of 60 cells', D.buildTownRows().length === 40 && D.buildTownRows().every(r => r.length === 60));","+  // the house wall stops the hero: stand in the yard below the house and walk up into it","+  const below = w.map.center(8, 13);","+  dbg.teleport(below[0], below[1] + 8);","   game.input.hold('up', true); run(game, 1.5); game.input.hold('up', false);","-  check('walls stop the hero (the house)', game.debug.snapshot().hero[1] > 100, J(game.debug.snapshot().hero));","-  // the zones name the places","-  check('the zone names are found by cell', ['home', 'deli', 'diner', 'lounge', 'vashti', 'yard', 'warehouse', 'lot', 'street'].every(z => z), '');","-  const near1 = w.map.center(25, 9); check('a cell in Ricci’s is in the deli zone', (() => { const cx = 25, cy = 9; return require_zone(cx, cy); })() === 'deli', '');","-  check('the pool is a block (no walking in it)', !w.map.walkable || true, '');","+  check('a wall stops the hero (the house)', snap().hero[1] >= 180, J(snap().hero));"," }","-function require_zone(cx, cy) { return ZONE_TEST(cx * 16 + 8, cy * 16 + 8); }","-let ZONE_TEST = () => null;"," {","-  // zone lookup from the same table the game uses (ZONES are in the game, read through the debug handle)","-  const { game, dbg, ctx } = boot();","-  ZONE_TEST = (x, y) => ctx.zoneAt ? ctx.zoneAt(x, y) : null;","-  game.advance(1);","-  check('the zone lookup gives the deli for Ricci’s front room', game.debug.snapshot().zone === 'home' || true, '');","+  // the walk: the hero moves on the stick and the keys, and the Mover's controls are used","+  const { game, snap, dbg } = boot();","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);","+  const x0 = snap().hero[0];","+  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);","+  check('the keys walk the hero', snap().hero[0] > x0 + 20, J([x0, snap().hero]));"," }"," ","-// ---- the people, the talk and the chapters ------------------------------------------------------","+// ================================================================================================","+// 3 · The people, the talk and the chapters","+// ================================================================================================"," {","-  const { game, dbg, snap } = boot();","-  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);","-  // collecting from the three shops, one at a time","-  near(game, [27, 11]); game.input.tap('interact'); game.advance(.2);","-  check('the interaction at Ricci opens his talk', snap().conv === 'ricci' || snap().talk, J(snap()));","-  talkAll(game);","-  check('Ricci pays $800', snap().cash === 800 && snap().got.ricci, J(snap()));","-  near(game, [40, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);","-  check('Dorothy pays $450', snap().cash === 1250 && snap().got.dorothy, J(snap()));","-  near(game, [51, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);","-  check('Tina pays $1,500 and the chapter moves to the sit-down', snap().cash === 2750 && snap().chapter === 2, J(snap()));","-  // Big Lou's sit-down with a choice that moves the respect","-  near(game, [51, 14]); game.input.tap('interact'); game.advance(.2);","-  check('Big Lou’s talk opens', snap().conv === 'lou' || snap().talk, J(snap()));","-  talkAll(game, 40);","-  check('the lounge talk has its choices', !!dbg.world() && true, '');","+  const { game, dbg, snap, talk } = boot();","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);","+  check('the intro talk closes and the play goes on', !snap().talk && !snap().conv, J(snap()));","+  stand(dbg, game, null, [27, 11]); game.input.tap('interact'); run(game, .3);","+  check('Sal Ricci’s talk opens when the hero interacts', snap().conv === 'ricci', J(snap()));","+  talkAll(game, talk, snap);","+  check('Sal Ricci pays $800', snap().cash === 800 && snap().got.ricci === true, J(snap()));","+  stand(dbg, game, null, [40, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);","+  check('Dorothy pays $450', snap().cash === 1250 && snap().got.dorothy === true, J(snap()));","+  stand(dbg, game, null, [51, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);","+  check('Tina pays $1,500 and the chapter moves on to the sit-down', snap().cash === 2750 && snap().chapter === 2, J(snap()));","+  // the interaction stays quiet away from people","+  stand(dbg, game, null, [20, 30]); const before = snap().conv; game.input.tap('interact'); run(game, .3);","+  check('the interaction does nothing with nobody near', snap().conv === before && !snap().talk, J(snap()));"," }"," {","-  // the choices move the stress and the respect (a conversation driven through its choices)","-  const { game, dbg, snap } = boot();","-  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);","+  // a choice moves the respect (Big Lou's sit-down)","+  const { game, dbg, snap, talk } = boot();","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);","   dbg.chapter(2);","-  near(game, [51, 14]); game.input.tap('interact'); game.advance(.2);","-  let guard = 0;","-  while (snap().talk && guard++ < 40) {","-    if (game.debug.talk.conv && snap().talk) { /* pages */ }","-    game.input.tap('confirm'); game.advance(.4);","-    if (snap().talk && snap().conv === 'lou') break;","-  }","-  // the lounge talk's first page with choices: pick the gus line (respect +2, flag)","-  if (snap().talk) { const tr = game.debug.talk; }","-  check('Big Lou talks and the conversation is running', snap().conv === 'lou' || snap().talk, J(snap()));","+  stand(dbg, game, null, [51, 14]); game.input.tap('interact'); run(game, .3);","+  check('Big Lou opens his talk', snap().conv === 'lou', J(snap()));","+  check('the talk offers the three answers', pickChoice(game, talk, snap, 1) === true, '');","+  check('the flag of the second answer is set (the Gus line)', snap().flags.gus === true, J(snap().flags));","+  check('the second answer adds 2 respect', snap().respect === 2, J(snap().respect));","+  talkAll(game, talk, snap);","+  check('Big Lou’s talk ends and the chapter moves on to the session', snap().chapter === 3 && snap().conv === null, J(snap()));"," }","-","-// ---- the story's conversations, from the data -----------------------------------------------------"," {","-  // every conversation: its nodes resolve (next, choices) and no node is missing","-  const { ctx } = boot();","-  const CONVS = ctx.CONVS;","-  let bad = [];","-  for (const [id, c] of Object.entries(CONVS)) {","+  // Vashti's session: a calm answer lowers the stress, an agitated one raises it","+  const { game, dbg, snap, talk } = boot();","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);","+  dbg.chapter(3); dbg.give('stress', 50);","+  dbg.startConv('vashti', () => dbg.give('flags', { done: true }));","+  run(game, .3);","+  pickChoice(game, talk, snap, 0);","+  check('the calm answer lowers the stress by 6', snap().stress === 44, J(snap().stress));","+  pickChoice(game, talk, snap, 0);","+  check('the second question takes another calm answer', snap().stress === 32, J(snap().stress));","+  check('the conversation runs to its end', talkAll(game, talk, snap) && snap().conv === null, J(snap()));","+}","+{","+  // every conversation’s nodes resolve, and the text uses glyphs the font has","+  const { D } = boot();","+  const bad = [];","+  for (const [id, c] of Object.entries(D.CONVS)) {","     if (!c.nodes[c.start]) bad.push(id + ':start');","     for (const [nid, n] of Object.entries(c.nodes)) {","       if (n.next && !c.nodes[n.next]) bad.push(id + '.' + nid + '->' + n.next);","       for (const ch of n.choices || []) if (ch.next && !c.nodes[ch.next]) bad.push(id + '.' + nid + '=>' + ch.next);","       if (!n.text || !n.text.length) bad.push(id + '.' + nid + ':text');","+      if (!D.VOICES[n.who]) bad.push(id + '.' + nid + ':voice(' + n.who + ')');","     }","   }","-  check('every conversation’s nodes link to real nodes', bad.length === 0, bad.join(' '));","-  const TEXT = JSON.stringify(CONVS);","-  const bad2 = TEXT.match(/[^\\x00-\\x7F]/g);","-  check('conversation text uses only glyphs the font has', !bad2 || [...new Set(bad2)].every(c => '•×♥★←→↑↓♪▸©'.includes(c)), J(bad2 && [...new Set(bad2)]));","-  check('every speaker has a voice', Object.keys(CONVS).every(id => Object.values(CONVS[id].nodes).every(n => !n.who || ctx.VOICES[n.who] || n.who === 'nobody')), '');","+  check('every conversation links to real nodes, with a voice for each speaker', bad.length === 0, bad.join(' '));","+  const odd = [...new Set(J(D.CONVS).match(/[^\\x00-\\x7F]/g) || [])].filter(c => !'•×♥★←→↑↓♪▸©'.includes(c));","+  check('conversation text has only glyphs the engine font draws', odd.length === 0, J(odd));"," }"," ","-// ---- the talk runner: choices, effects and chaining, driven directly -----------------------------","+// ================================================================================================","+// 4 · Combat, the pistol, the hero’s health, and the checkpoint","+// ================================================================================================"," {","-  const { game, dbg, snap, ctx } = boot();","-  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);","-  // Vashti's session: a choice that calms (stress -6) and one that agitates (stress +6)","-  dbg.give('stress', 50);","-  dbg.talk.startConv('vashti', () => { ctx.__vashtiDone = true; });","-  run(game, .5);","-  check('a conversation opens its first node in the talk box', snap().talk && snap().conv === 'vashti', J(snap()));","-  // the first node has three choices: move the cursor to the first and press","-  const talkObj = game.debug.talk; // (the handle's conversation)","-  let pages = 0;","-  while (snap().talk && !(talkBox(game).choices)) { game.input.tap('confirm'); game.advance(.4); if (++pages > 30) break; }","-  check('the first node offers choices', !!talkBox(game).choices && talkBox(game).choices.length === 3, J(talkBox(game).choices));","-  talkBox(game).choice = 0; game.input.tap('confirm'); game.advance(.4);","-  check('choosing the calming answer lowers the stress', snap().stress < 50, J(snap().stress));","-  check('the conversation moves on to the next node', snap().conv === 'vashti', J(snap()));","-  talkAll(game);","-  check('the conversation runs to its end and calls its end', ctx.__vashtiDone === true, J(snap()));","-}","-function talkBox(g) { return g.ctx ? null : g.__talk || g.debug.talk.box || boxOf(g); }","-function boxOf(g) { return g.__box; }","-","-// ---- combat, pickups and the stress -------------------------------------------------------------","-{","   const { game, dbg, snap, E } = boot();","-  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);","-  dbg.chapter(4); game.advance(.1);","-  // a crew member in front of the hero, and a bat swing: the foe takes the hit","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);","+  dbg.chapter(4); run(game, .1);","+  const yard = stand(dbg, game, null, [37, 30]); run(game, .5);","   const w = dbg.world();","+  check('entering the yard spawns the crew and Gus', snap().boss !== null && snap().foes >= 4, J(snap()));","   const hero = w.hero;","-  const foe = w.foes.find(f => f.kind === 'civ');","-  const crew = (function () {","-    const f = new E.Body({ x: 0, y: 0, r: 5 });","-    return f;","-  })();","-  // use the game's own spawn: the yard's crew is spawned when the hero enters the yard","-  const yard = w.map.center(37, 30); dbg.teleport(yard[0], yard[1]); run(game, .4);","-  check('entering the yard spawns the crew and Gus', snap().boss && snap().boss[0] > 0 && snap().foes >= 3, J(snap()));","-  const target = w.foes.find(f => !f.dead && f.kind === 'crew');","-  const hp0 = target.hp;","-  target.x = hero.x + 14; target.y = hero.y; target.vx = target.vy = 0;","+  const crew = w.foes.find(f => !f.dead && f.kind === 'crew');","+  // the bat: a crew member just in front of the hero","   hero.facing = 0;","-  for (let i = 0; i < 4; i++) { game.input.tap('attack'); run(game, .5); }","-  check('the bat hits a crew member in front', target.hp < hp0 || target.dead, 'hp ' + hp0 + ' -> ' + target.hp);","-  // the pistol: a shot costs a shell and hits what's in its line","+  crew.x = hero.x + 14; crew.y = hero.y; crew.vx = crew.vy = 0; crew.alert = 0;","+  const hp0 = crew.hp;","+  for (let i = 0; i < 5; i++) { game.input.tap('attack'); run(game, .45); if (crew.dead) break; }","+  check('the bat hits a crew member in front', crew.hp < hp0 || crew.dead, 'hp ' + hp0 + ' -> ' + crew.hp);","+  // the pistol: a shell is used and a shot down the line hits","+  const f2 = w.foes.find(f => !f.dead && f.kind === 'crew' && f !== crew);","+  f2.x = hero.x + 70; f2.y = hero.y; f2.vx = f2.vy = 0; f2.alert = 0; f2.hp = 60;","+  hero.facing = 0;","   const ammo0 = snap().ammo;","-  target.hp = 60; target.dead = false; target.x = hero.x + 60; target.y = hero.y; target.vx = target.vy = 0;","-  game.input.tap('use'); run(game, .6);","-  check('the pistol uses a shell', snap().ammo === ammo0 - 1, J(snap().ammo));","-  check('a shot down the line hits the foe', target.hp < 60 || target.dead, 'hp ' + target.hp);","-  // a fight can hurt the hero: an enemy bullet takes hearts, and a guard takes fewer","-  const hp1 = snap().hp;","-  dbg.give('hp', 100);","-  w.hero.iframes = 0;","-  w.hero.iframes = 0; // (a clear hit)","-  game.debug.world().ctl && 0;","-  const b = { dmg: 18 };","-  // hurtHero is the world's; drive it through a real shot that reaches the hero","+  game.input.tap('use'); run(game, .7);","+  check('the pistol costs a shell', snap().ammo === ammo0 - 1, J(snap().ammo));","+  check('the shot hits the foe in its line', f2.hp < 60 || f2.dead, 'hp ' + f2.hp);","+  // the hero takes a hit: an enemy bullet hurts; a guard takes less","+  dbg.give('hp', 100); hero.iframes = 0;","   w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });","-  run(game, .5);","-  check('an enemy bullet hurts the hero', snap().hp < 100, J(snap().hp));","-  // a death sends the hero back to the chapter's checkpoint and counts it","-  dbg.give('hp', 3); w.hero.iframes = 0;","+  run(game, .4);","+  check('an enemy bullet hurts the hero', snap().hp === 82, J(snap().hp));","+  hero.iframes = 0; dbg.give('hp', 100);","+  game.input.hold('block', true);","   w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });","-  run(game, .5);","-  check('a death counts and goes back to the checkpoint', snap().deaths >= 1 && snap().hp === 70, J(snap()));","-  check('the hero is at the chapter’s checkpoint after a death', (snap().zone === 'yard' || snap().zone === 'street'), snap().zone);","+  run(game, .4); game.input.hold('block', false);","+  check('guarding takes less damage (30 percent)', snap().hp >= 94 && snap().hp < 100, J(snap().hp));","+  // a death sends the hero back to the chapter’s checkpoint and counts it","+  dbg.give('hp', 3); hero.iframes = 0; const d0 = snap().deaths;","+  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });","+  run(game, .4);","+  check('a death counts and restores 70 health', snap().deaths === d0 + 1 && snap().hp === 70, J(snap()));","+  const cp = w.map.center(30, 19);","+  check('a death sends the hero back to the chapter 4 checkpoint', Math.abs(snap().hero[0] - cp[0]) < 3 && Math.abs(snap().hero[1] - cp[1]) < 3, J([snap().hero, cp]));"," }"," {","-  // pickups: a cannoli heals and calms, shells come in boxes, the ducks count","-  const { game, dbg, snap } = boot();","-  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);","-  dbg.give('hp', 40); dbg.give('stress', 30);","+  // a civilian who is hit: the heat rises, and the others run","+  const { game, dbg, snap, E } = boot();","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);","   const w = dbg.world();","-  const c = w.cannoli[0]; dbg.teleport(c.x, c.y); run(game, .3);","-  check('a cannoli heals 25 and takes 10 off the stress', snap().hp === 65 && snap().stress === 20 && snap().cannoli === 0 || snap().hp === 65, J(snap()));","-  const a = w.ammo[0]; dbg.teleport(a.x, a.y); run(game, .3);","+  const civ = w.civs[0];","+  w.hero.facing = Math.atan2(civ.y - w.hero.y, civ.x - w.hero.x);","+  civ.x = w.hero.x + 14; civ.y = w.hero.y; civ.vx = civ.vy = 0;","+  game.input.tap('attack'); run(game, .5);","+  for (let i = 0; i < 3; i++) { game.input.tap('attack'); run(game, .45); }","+  check('hitting a civilian raises the heat', snap().heat > 0, J(snap().heat));","+  check('the civilian runs', civ.flee > 0 || civ.dead, J(civ.flee));","+}","+{","+  // pickups: a cannoli heals and calms; the shells come in boxes; a duck counts","+  const { game, dbg, snap, D } = boot();","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);","+  const w = dbg.world();","+  dbg.give('hp', 40); dbg.give('stress', 30);","+  dbg.teleport(w.cannoli[0].x, w.cannoli[0].y); run(game, .3);","+  check('a cannoli heals 25 and calms 10', snap().hp === 65 && snap().stress === 20 && snap().cannoli === 0, J(snap()));","+  dbg.teleport(w.ammo[0].x, w.ammo[0].y); run(game, .3);","   check('a box of shells adds 8', snap().ammo === 20, J(snap().ammo));","-  const d = w.ducks[0]; dbg.teleport(d.x, d.y); run(game, .3);","-  check('a duck counts for the pool', snap().ducks === 1, J(snap().ducks));","+  dbg.teleport(w.ducks[0].x, w.ducks[0].y); run(game, .3);","+  check('a duck counts toward the pool', snap().ducks === 1, J(snap().ducks));"," }"," {","-  // heat and stress: a hot Fed raises the stress; at 100 it is a panic and the bat stops","+  // heat and panic: a hot street raises the stress; at 100 the hero panics and can't fight","   const { game, dbg, snap } = boot();","-  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);","-  dbg.chapter(5);","-  dbg.give('heat', 90); run(game, 2);","-  check('high heat raises the stress', snap().stress > 0, J(snap().stress));","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, game.debug.talkBox, snap);","+  dbg.chapter(5); dbg.give('heat', 90); run(game, 2);","+  check('a hot street raises the stress', snap().stress > 0, J(snap().stress));","   dbg.give('stress', 100); run(game, .2);","-  check('a stress of 100 is a panic and it says so', (snap().toast || '').includes('PANIC') || snap().stress === 100, J(snap()));","+  check('a stress of 100 is a panic (the toast says so)', (snap().toast || '').includes('PANIC'), J(snap().toast));","+  const w = dbg.world();","+  const n = w.foes.length;","+  game.input.tap('attack'); run(game, .3);","+  check('a panic stops the bat', !w.combo.busy, J(w.combo.busy));"," }"," ","-// ---- the chapters, through to the end (standalone) -----------------------------------------------","+// ================================================================================================","+// 5 · The chapters, from the yard to Ma’s door (standalone)","+// ================================================================================================"," {","-  const { game, dbg, snap } = boot();","-  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);","+  const { game, dbg, snap, talk } = boot();","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);","   dbg.chapter(5); run(game, .2);","   const w = dbg.world();","-  check('chapter 5 spawns the Feds from the streets', (run(game, 12), w.foes.some(f => f.kind === 'fed')), J(snap()));","+  run(game, 11);","+  check('chapter 5 sends Feds onto the street', w.foes.some(f => f.kind === 'fed'), J(w.foes.length));","   const home = w.map.center(8, 13);","-  dbg.teleport(home[0], home[1]); run(game, .6);","-  check('Ma’s house ends the run', snap().done === true || snap().scene === 'end', J(snap()));","-  talkAll(game);","-  check('the end screen comes after Ma’s talk', snap().scene === 'end' || snap().done, J(snap()));","+  dbg.teleport(home[0], home[1]); run(game, .4);","+  check('Ma’s door starts her talk', snap().conv === 'home', J(snap()));","+  talkAll(game, talk, snap);","+  check('Ma’s talk ends the story (standalone: the end screen)', snap().done === true && snap().scene === 'end', J(snap()));"," }"," ","-// ---- settings, glyphs, the touch-only rule, saves ---------------------------------------------------","+// ================================================================================================","+// 6 · Settings, glyphs, the touch-only rule and the save slots","+// ================================================================================================"," {","-  const { game, E } = boot();","-  check('the settings list has the two stick inversions', game.settings.spec('invertStickX') && game.settings.spec('invertStickY'), '');","-  check('the button symbols default to PlayStation', game.input.glyphs === 'playstation' || game.settings.glyphs === 'playstation', J([game.input.glyphs, game.settings.glyphs]));","-  check('the view key is on V and the right stick press', game.input.map.view && game.input.map.view.includes('KeyV'), J(game.input.map.view));","-  check('the attack prompt uses the input’s label', typeof game.input.label('attack') === 'string', '');","+  const { game } = boot();","+  check('the stick inversions are settings', !!game.settings.spec('invertStickX') && !!game.settings.spec('invertStickY'));","+  check('the button symbols default to PlayStation', game.settings.glyphs === 'playstation' && game.input.glyphs === 'playstation', J([game.settings.glyphs, game.input.glyphs]));","+  check('the camera view is on V and the right stick press', J(game.input.map.view) === J(['KeyV', 'Pad11']), J(game.input.map.view));","+  check('the bat prompt names the key or button in use', typeof game.input.label('attack') === 'string' && game.input.label('attack').length > 0, J(game.input.label('attack')));"," }"," {","-  // an inverted stick: a pad's left-right is flipped only when the player asks for it","-  const { game } = boot();","+  // the stick helper inverts only what the player asked for, and only on a gamepad","+  const { game, dbg } = boot();","+  game.input.move = () => [0.6, -0.4];","   game.input.lastDevice = 'gamepad';","+  check('a gamepad stick reads normally by default', J(dbg.stick()) === J([0.6, -0.4]), J(dbg.stick()));","   game.settings.set('invertStickX', true);","-  const ctx = game.input; // (the stick helper reads the settings and the device)","-  game.settings.set('invertStickX', false);","-  check('the stick’s inversion setting exists and can be set', game.settings.set('invertStickY', true) === true, '');","-  game.settings.set('invertStickY', false);","+  check('the left-right inversion flips x', J(dbg.stick()) === J([-0.6, -0.4]), J(dbg.stick()));","+  game.settings.set('invertStickY', true);","+  check('the up-down inversion flips y as well', J(dbg.stick()) === J([-0.6, 0.4]), J(dbg.stick()));","+  game.input.lastDevice = 'keyboard';","+  check('the keyboard is not inverted', J(dbg.stick()) === J([0.6, -0.4]), J(dbg.stick()));","+  game.settings.set('invertStickX', false); game.settings.set('invertStickY', false);"," }"," {","-  // a touch-only device gets no touch controls, and says so on the title","+  // a touch-only device gets no touch controls (the title says controller or keyboard)","   const { game } = boot({ touch: 'only' });","-  check('a touch-only device has its touch stick off', game.input.touchEnabled === false, J(game.input.touchEnabled));","+  check('a touch-only device has its touch controls off', game.input.touchEnabled === false, J(game.input.touchEnabled));","+  const { game: g2 } = boot();","+  check('a device with a keyboard keeps touch available', g2.input.touchEnabled === true, J(g2.input.touchEnabled));"," }"," {","-  // the save slots: a save writes the run, and a load restores it","-  const { game, dbg, snap } = boot();","-  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);","+  // the save slots: a save writes the run; a load brings it back","+  const { game, dbg, snap, talk } = boot();","+  game.advance(1); game.input.tap('confirm'); run(game, .5); talkAll(game, talk, snap);","   dbg.give('cash', 1234); dbg.give('respect', 3);","-  game.saves.save(0);","+  check('the save slot takes the run', game.saves.save(0) === true, '');","   dbg.give('cash', 0); dbg.give('respect', 0);","   const latest = game.saves.latest();","-  check('a saved run is found as the latest', !!latest && latest.slot === 0, J(latest && latest.slot));","+  check('the save is the latest run', !!latest && latest.slot === 0, J(latest));","   game.saves.load(0); run(game, 1.2);","-  check('loading restores the run’s cash and respect', snap().cash === 1234 && snap().respect === 3 && snap().scene === 'play', J(snap()));","+  check('loading brings back the cash and the respect', snap().cash === 1234 && snap().respect === 3 && snap().scene === 'play', J(snap()));"," }"," ","-// ---- the hub session (AI Hub Session Protocol v1, ghost mode) ----------------------------------------","+// ================================================================================================","+// 7 · The hub session (AI Hub Session Protocol v1, ghost mode)","+// ================================================================================================"," {","-  const { hub, rec, fire } = fakeHub({ time: -Infinity });","-  const { game, snap, dbg } = boot({ hub });","-  game.advance(1);","-  check('a session opens straight into the round, with no title', snap().scene === 'play', J(snap().scene));","+  const { hub, rec, setTime, fire } = fakeHub(-Infinity);","+  const { game, snap } = boot({ hub });","+  game.advance(1); run(game, .3);","+  check('a session opens straight into the round (no title)', snap().scene === 'play', J(snap().scene));","   check('the session connects in ghost mode with 1 to 4 seats', rec.connect && rec.connect.mode === 'ghost' && rec.connect.seats[0] === 1 && rec.connect.seats[1] === 4, J(rec.connect));","-  run(game, .2);","   check('the round calls ready once the world is built', rec.ready === 1, 'ready ' + rec.ready);","-  check('before the start there is no play (the hero stands still)', snap().hero && snap().chapter === 1, J(snap()));","   check('the session has no quit to title (the hub ends rounds)', game.o.menu && game.o.menu.quit === false, J(game.o.menu && game.o.menu.quit));","-  // the start: play begins when the hub's clock reaches 0","-  hub.setTime(0); fire('start', { in: 3000 });","+  check('before the start the round does not play', snap().hero && !snap().talk && snap().scene === 'play', J(snap()));","   const x0 = snap().hero[0];","-  game.input.hold('right', true); run(game, 1); game.input.hold('right', false);","-  check('after the start the hero plays', snap().hero[0] !== x0, J(snap().hero));","-  check('the copy sends its place to the others (ghost mode)', rec.sent.length > 0 && rec.sent.every(s => s.o && s.o.reliable === false), 'sent ' + rec.sent.length);","-  check('the progress reaches the hub about once a second', rec.progress.length >= 0, '');","-  // a remote player's place arrives and is kept","+  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);","+  check('before the start the hero does not move', snap().hero[0] === x0, J([x0, snap().hero]));","+  setTime(0); fire('start', { in: 3000 }); run(game, .2);","+  const x1 = snap().hero[0];","+  game.input.hold('right', true); run(game, .8); game.input.hold('right', false);","+  check('after the start the hero plays', snap().hero[0] !== x1, J([x1, snap().hero]));","+  run(game, 2);","+  check('the copy sends its place to the others (ghost mode, unreliable)', rec.sent.length > 5 && rec.sent.every(s => s.o && s.o.reliable === false), 'sent ' + rec.sent.length);","+  check('the progress reaches the hub about once a second', rec.progress.length >= 1, 'progress ' + rec.progress.length);","   fire('message', { x: 150, y: 220, f: 0, vx: 0, vy: 0, zone: 'home' }, 1);","   run(game, .3);","-  check('a message from another copy is kept as a ghost', game.errors.length === 0, game.errors.map(e => e.message).join(' '));","-  // a leave removes that player","-  fire('leave', { id: 1, reason: 'left' }); run(game, .1);","-  check('a leave is handled', game.errors.length === 0, '');","-  // time-up: the result is reported with the score, once","+  check('another copy’s place is kept, with no error', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));","+  fire('leave', { id: 1, reason: 'left' }); run(game, .2);","+  check('a player leaving is handled', game.errors.length === 0, '');","   fire('time-up', { graceMs: 5000 }); run(game, .2);","-  check('time-up reports a result once', rec.results.length === 1 && rec.results[0].score !== undefined, J(rec.results));","+  check('time-up reports a result once, with the score', rec.results.length === 1 && typeof rec.results[0].score === 'number', J(rec.results));","   fire('time-up', { graceMs: 5000 }); run(game, .2);","-  check('a second time-up does not report again', rec.results.length === 1, J(rec.results));","-  // the end: no input and no sound after it","-  fire('end', { reason: 'finished', standings: [] }); run(game, .3);","-  check('the end stops the round (nothing more is sent)', true, '');","+  check('a second time-up does not report again', rec.results.length === 1, J(rec.results.length));","+  const sent0 = rec.sent.length;","+  fire('end', { reason: 'finished', standings: [] }); run(game, .6);","+  check('after the end nothing more is sent', rec.sent.length === sent0, 'sent ' + (rec.sent.length - sent0));","   check('no errors in a session', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));"," }"," {","-  // a session's full round: Ma's door reports the time once, and the copy waits for the end","-  const { hub, rec, fire } = fakeHub({ time: 0 });","-  const { game, snap, dbg } = boot({ hub });","+  // a session round where the hero gets to Ma's door: one result with the time, then the round waits","+  const { hub, rec, setTime, fire } = fakeHub(0);","+  const { game, snap, dbg, talk } = boot({ hub });","   game.advance(1); run(game, .2);","-  hub.setTime(10000); fire('start', { in: 0 }); run(game, .2);","+  setTime(10000); fire('start', { in: 0 }); run(game, .2);","   dbg.chapter(5); run(game, .2);","-  const w = dbg.world(); const home = w.map.center(8, 13);","-  dbg.teleport(home[0], home[1]); run(game, .8); talkAll(game);","+  const w = dbg.world(), home = w.map.center(8, 13);","+  dbg.teleport(home[0], home[1]); run(game, .5); talkAll(game, talk, snap);","   check('the round reports its time when the last chapter is done', rec.results.length === 1 && typeof rec.results[0].time === 'number' && rec.results[0].time > 0, J(rec.results));","-  check('after the result the round waits (frozen) and the scene doesn’t end', snap().scene === 'play' && snap().done, J(snap()));","-  check('no errors at the end of a session round', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));","+  check('after the result the round waits and the scene stays', snap().scene === 'play' && snap().done === true && snap().frozen === true, J(snap()));","+  check('no errors at the end of the round', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));"," }"," ","-// ---- the About pages read the exit interview ------------------------------------------------------","+// ================================================================================================","+// 8 · The About pages read the exit interview","+// ================================================================================================"," {","   const exitPath = path.join(ROOT, '..', 'exit-interview.json');","   if (existsSync(exitPath)) {","-    let data = null, err = null;","+    let data = null, err = '';","     try { data = JSON.parse(readFileSync(exitPath, 'utf8')); } catch (e) { err = e.message; }","-    check('exit-interview.json parses as JSON', !err, err || '');","+    check('exit-interview.json parses as JSON', !err, err);","     const fields = ['date', 'source', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];","-    check('the interview answers every source field', data && fields.every(f => typeof data.sourceInformation[f] === 'string' && data.sourceInformation[f].length > 0), '');","-    check('the feedback sections are filled', data && data.testingFeedback.length === 4 && data.engineFeedback.length === 6 && data.promptFeedback.length === 4, '');","+    check('the interview answers every source field', !!data && fields.every(f => typeof data.sourceInformation[f] === 'string' && data.sourceInformation[f].length > 0));","+    check('the interview answers every feedback question (4, 6 and 4)', !!data && data.testingFeedback.length === 4 && data.engineFeedback.length === 6 && data.promptFeedback.length === 4);","   } else {","-    check('exit-interview.json exists (written at the end)', false, 'not written yet');","+    check('exit-interview.json is written', false, 'not written yet');","   }"," }"," ","-// ---- a full playthrough: keys and mouse only, from the title to the credits -----------------------","+// ================================================================================================","+// 9 · A full playthrough: keys and mouse, from NEW GAME to the credits","+// ================================================================================================"," {","-  const { game, dbg, snap } = boot();","+  const { game, dbg, snap, talk, E } = boot();","   game.advance(1);","-  game.input.tap('confirm'); game.advance(.6);          // NEW GAME","-  talkAll(game);                                         // the intro","-  near(game, [27, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);     // Sal Ricci","-  near(game, [40, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);     // Dorothy","-  near(game, [51, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);     // Tina; chapter 2","-  check('the playthrough reaches the sit-down', snap().chapter === 2, J(snap()));","-  near(game, [51, 14]); game.input.tap('interact'); game.advance(.2);                    // Big Lou","-  const box = (() => { let g = 0; while (snap().talk && snap().conv === 'lou' && g++ < 60) { if (game.debug.snapshot().talk) { game.input.tap('confirm'); game.advance(.4); } } return true; })();","-  check('Big Lou’s sit-down ends and the session is next', snap().chapter === 3, J(snap()));","-  // Dr. Vashti's door: the session room, with the choices and the stress","-  near(game, [27, 23]); game.input.tap('interact'); game.advance(.4);","-  check('the session room opens at Dr. Vashti’s', snap().scene === 'session', J(snap().scene));","-  talkAll(game);","-  check('the session ends with the chapter 4 and the play scene back', snap().scene === 'play' && snap().chapter === 4, J(snap()));","-  // the yard: the fight, with the bat and the pistol, until Gus is down","+  game.input.tap('confirm'); run(game, .6);                                      // NEW GAME","+  talkAll(game, talk, snap);                                                     // the intro","+  stand(dbg, game, null, [27, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Sal Ricci","+  stand(dbg, game, null, [40, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Dorothy","+  stand(dbg, game, null, [51, 11]); game.input.tap('interact'); run(game, .3); talkAll(game, talk, snap);   // Tina","+  check('the collections are done and the sit-down is next', snap().chapter === 2 && snap().cash === 2750, J(snap()));","+  stand(dbg, game, null, [51, 14]); game.input.tap('interact'); run(game, .3);   // Big Lou","+  pickChoice(game, talk, snap, 0);","+  talkAll(game, talk, snap);","+  check('the sit-down is done and the session is next', snap().chapter === 3, J(snap()));","+  stand(dbg, game, null, [27, 23]); game.input.tap('interact'); run(game, .5);   // Dr. Vashti's door","+  check('the session room opens', snap().scene === 'session', J(snap().scene));","+  pickChoice(game, talk, snap, 2); pickChoice(game, talk, snap, 0); pickChoice(game, talk, snap, 0); pickChoice(game, talk, snap, 0);","+  talkAll(game, talk, snap);","+  check('the session ends back in the play scene on chapter 4', snap().scene === 'play' && snap().chapter === 4, J(snap()));","+  // the yard: the bat and the pistol until Gus is down","   const w = dbg.world();","-  const yard = w.map.center(37, 30); dbg.teleport(yard[0], yard[1]); run(game, .4);","+  stand(dbg, game, null, [37, 30]); run(game, .4);","   let frames = 0;","-  while (!snap().bossDown && frames < 1500 && snap().scene === 'play') {","-    const s = snap();","+  while (!snap().bossDown && frames < 2500 && snap().scene === 'play') {","     const hero = w.hero;","-    const foe = w.foes.find(f => !f.dead && f.kind !== 'civ');","-    if (foe) { hero.facing = Math.atan2(foe.y - hero.y, foe.x - hero.x); }","-    if (!talkBoxOpen(game)) {","-      if (s.ammo > 0 && frames % 10 === 0) game.input.tap('use');","+    const foe = w.foes.filter(f => !f.dead && f.kind !== 'civ').sort((a, b) => distTo(hero, a) - distTo(hero, b))[0];","+    if (talk.open) game.input.tap('confirm');","+    else if (foe) {","+      hero.facing = Math.atan2(foe.y - hero.y, foe.x - hero.x);","+      if (distTo(hero, foe) > 34) { hero.x += Math.cos(hero.facing) * 2.5; hero.y += Math.sin(hero.facing) * 2.5; }","       if (frames % 4 === 0) game.input.tap('attack');","-    } else { game.input.tap('confirm'); }","-    game.advance(.1);","-    if (frames % 40 === 0 && foe && E_dist(hero, foe) > 30) { hero.x = foe.x - 20; hero.y = foe.y; }","-    frames++;","-    if (snap().hp < 60) dbg.give('hp', 100);","+      if (frames % 9 === 0 && snap().ammo > 0 && distTo(hero, foe) > 40) game.input.tap('use');","+    }","+    if (snap().hp < 70) dbg.give('hp', 100);","+    game.advance(.1); frames++;","   }","   check('the yard fight puts Gus down', snap().bossDown === true, J(snap()));","   check('the Feds come once Gus is down (chapter 5)', snap().chapter === 5, J(snap()));","-  // the Feds, and the way home","-  run(game, 6);","+  // the Feds, and the walk home to Ma","   const home = w.map.center(8, 13);","   let steps = 0;","-  while (!snap().done && steps < 2500 && snap().scene === 'play') {","+  while (!snap().done && steps < 3000 && snap().scene === 'play') {","     const hero = w.hero;","-    const fedNear = w.foes.find(f => !f.dead && f.kind === 'fed' && E_dist(hero, f) < 60);","-    if (fedNear) { hero.facing = Math.atan2(fedNear.y - hero.y, fedNear.x - hero.x); if (snap().ammo > 0 && steps % 8 === 0) game.input.tap('use'); }","-    if (talkBoxOpen(game)) game.input.tap('confirm');","+    if (talk.open) { game.input.tap('confirm'); game.advance(.2); steps++; continue; }","+    const fed = w.foes.filter(f => !f.dead && f.kind === 'fed').sort((a, b) => distTo(hero, a) - distTo(hero, b))[0];","+    if (fed && distTo(hero, fed) < 120) { hero.facing = Math.atan2(fed.y - hero.y, fed.x - hero.x); if (steps % 9 === 0 && snap().ammo > 0) game.input.tap('use'); }","     const dx = home[0] - hero.x, dy = home[1] - hero.y, dd = Math.hypot(dx, dy) || 1;","-    if (dd > 22) { hero.x += dx / dd * 2.2; hero.y += dy / dd * 2.2; }","-    if (dd < 26 && !talkBoxOpen(game)) game.input.tap('interact');","-    dbg.give('hp', Math.max(snap().hp, 60));","+    if (dd > 24) { hero.x += dx / dd * 2.2; hero.y += dy / dd * 2.2; }","+    else game.input.tap('interact');","+    if (snap().hp < 70) dbg.give('hp', 100);","     game.advance(.1); steps++;","   }","   check('Ma’s house ends the story', snap().done === true, J(snap()));","-  talkAll(game);","-  check('the end screen waits for the player after the story', snap().scene === 'end', J(snap().scene));","-  game.input.tap('confirm'); game.advance(.5);","+  talkAll(game, talk, snap);","+  check('the end screen waits after the story', snap().scene === 'end', J(snap().scene));","+  game.input.tap('confirm'); run(game, .5);","   check('the About pages open from the end screen', snap().scene === 'credits', J(snap().scene));","-  for (let i = 0; i < 4; i++) { game.input.tap('right'); game.advance(.3); }","-  check('the About pages turn to the feedback', snap().scene === 'credits', J(snap().scene));","-  game.input.tap('cancel'); game.advance(.5);","-  check('the playthrough leaves the About pages without an error', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));","+  for (let i = 0; i < 4; i++) { game.input.tap('right'); run(game, .3); }","+  check('the About pages turn through the sections', snap().scene === 'credits', J(snap().scene));","+  game.input.tap('cancel'); run(game, .5);","+  check('the playthrough goes back to the end screen without an error', game.errors.length === 0 && snap().scene === 'end', game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));"," }","-function talkBoxOpen(g) { return g.debug.snapshot().talk; }","-function E_dist(a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }"," "," console.log('\\n' + passed + ' passed, ' + failed + ' failed');"," if (failed) { console.log('failures:\\n - ' + failures.join('\\n - ')); process.exit(1); }"]}],"originalFile":"// Headless tests for every system of the game, and a full playthrough. The engine and the game\n// run in Node with no screen (headless: fixed steps, scripted input, the debug handle). Run:\n//   node test/game.test.mjs            (exit code 1 on any failure)\nimport vm from 'node:vm';\nimport { readFileSync, existsSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { gameScript } from '../build.mjs';\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.join(HERE, '..');\nconst ENGINE = readFileSync(path.join(ROOT, 'src', 'vendor', 'my-3d2dge.js'), 'utf8');\nconst GAME = gameScript({ sourceInformation: { date: 'test' }, testingFeedback: ['a', 'b', 'c', 'd'], engineFeedback: ['a', 'b', 'c', 'd', 'e', 'f'], promptFeedback: ['a', 'b', 'c', 'd'] });\n\n// boot a fresh copy: opts.hub = a fake AIHub client (the session); opts.touch = a touch-only device\nfunction boot(opts = {}) {\n  const ctx = { console, Promise, setTimeout, clearTimeout };\n  if (opts.touch) ctx.matchMedia = q => ({ matches: q.includes('coarse') && opts.touch === 'only' });\n  if (opts.hub) ctx.AIHub = opts.hub;\n  vm.createContext(ctx);\n  vm.runInContext(ENGINE, ctx, { filename: 'engine' });\n  vm.runInContext(GAME, ctx, { filename: 'game' });\n  const E = ctx.My3D2dge, game = E.current;\n  return { ctx, E, game, snap: () => game.debug.snapshot(), dbg: game.debug };\n}\n// a fake hub client: the protocol's calls, recorded, with a clock the test controls\nfunction fakeHub(opts = {}) {\n  const rec = { connect: null, ready: 0, results: [], progress: [], sent: [], finish: [], handlers: {}, ended: false };\n  let clock = opts.time ?? -Infinity;\n  const hub = {\n    active: true, seeded: true, version: '1.3.0',\n    connect(o) { rec.connect = o; return Promise.resolve(opts.info || { me: 0, players: [{ id: 0, name: 'Dom', color: '#e8443a' }, { id: 1, name: 'Ray', color: '#3b82f6' }], host: 0, isHost: true, mode: 'ghost', round: 1, limitMs: 600000, seed: 7 }); },\n    ready() { rec.ready++; },\n    time() { return clock; },\n    setTime(t) { clock = t; },\n    on(ev, fn) { rec.handlers[ev] = fn; return () => { delete rec.handlers[ev]; }; },\n    progress(o) { rec.progress.push(o); },\n    result(o) { rec.results.push(o); },\n    finish(o) { rec.finish.push(o); },\n    send(d, o) { rec.sent.push({ d, o }); return true; },\n    rng() { return () => 0.5; },\n    fail() {},\n  };\n  return { hub, rec, fire: (ev, ...a) => rec.handlers[ev] && rec.handlers[ev](...a) };\n}\n\nlet passed = 0, failed = 0;\nconst failures = [];\nfunction check(name, ok, detail = '') {\n  if (ok) passed++; else { failed++; failures.push(name + (detail ? ' :: ' + detail : '')); }\n  console.log((ok ? 'ok   ' : 'FAIL ') + name + (ok ? '' : '  ' + detail));\n}\nconst J = v => JSON.stringify(v);\n// advance seconds in 0.1 s chunks so the scenes' timers and the hub's clock keep up\nfunction run(game, secs) { for (let t = 0; t < secs; t += .1) game.advance(.1); }\n// finish a talk box and any conversation that follows it (each press turns a page)\nfunction talkAll(g, maxSteps = 400) {\n  for (let i = 0; i < maxSteps; i++) {\n    if (!g.debug.snapshot().talk && !g.debug.snapshot().conv) return true;\n    const s = g.debug.snapshot();\n    if (s.talk) { g.input.tap('confirm'); g.advance(.5); } else g.advance(.2);\n  }\n  return false;\n}\n// the talk box's cursor onto choice i, then pick it\nfunction choose(g, i) { g.debug.talk.choiceSet ? 0 : 0; const t = talkRef(g); t.choice = i; g.input.tap('confirm'); g.advance(.3); }\nfunction talkRef(g) { return g.ctx ? null : null; }\n// move the hero next to a cell (the test's teleport, then a step so the world reads it)\nfunction near(g, cell) { const w = g.debug.world(); const c = w.map.center(cell[0], cell[1]); g.debug.teleport(c[0], c[1]); g.advance(.1); return c; }\n\n// ---- scenes and the title ----------------------------------------------------------------------\n{\n  const { game, snap } = boot();\n  game.advance(1);\n  check('the title is the first scene', snap().scene === 'title', J(snap()));\n  game.input.tap('confirm'); game.advance(.8);\n  check('a new game opens the play scene and the intro talk', snap().scene === 'play' && snap().talk && snap().conv === 'intro', J(snap()));\n  check('the chapter’s first objective is on the toast', (snap().toast || '').includes('COLLECTIONS'), J(snap().toast));\n  check('no errors in the first seconds', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n}\n{\n  // the title's idle demo: after 10 s with no input it starts the attract mode; any input ends it\n  const { game, snap } = boot();\n  game.advance(1);\n  run(game, 11);\n  check('10 s idle on the title starts the attract demo', snap().scene === 'attract' && snap().attract === true, J(snap().scene));\n  run(game, 3);\n  check('the attract demo plays on its own (the hero moves, the story goes on)', snap().chapter >= 1 && snap().hero !== null, J(snap()));\n  game.input.tap('confirm'); game.advance(1);\n  check('any input ends the attract demo and returns to the title', snap().scene === 'title' && snap().attract === false, J(snap().scene));\n}\n{\n  // the demo really shows the whole story: the AI goes all the way to Ma's door and back to the title\n  const { game, snap } = boot();\n  game.advance(1);\n  run(game, 11);\n  let reached = 0, ch = 0;\n  for (let t = 0; t < 400 && snap().scene !== 'title'; t++) {\n    game.advance(.1);\n    const s = snap();\n    if (s.chapter > ch) { ch = s.chapter; reached++; }\n    if (s.done) break;\n  }\n  check('the attract demo reaches every chapter (1 to 5)', reached >= 5, 'reached ' + reached + ' chapters, at ch ' + ch);\n  check('the attract demo finishes the story (Ma’s door)', snap().done === true, J(snap()));\n  run(game, 7);\n  check('the attract demo goes back to the title when it ends', snap().scene === 'title', J(snap().scene));\n  check('no errors during the attract demo', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));\n}\n\n// ---- the map and the zones ----------------------------------------------------------------------\n{\n  const { game, dbg } = boot();\n  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);\n  const w = dbg.world();\n  check('the town is 60 by 40 cells', w.map.rows ? true : true, '');\n  check('the hero starts at home', game.debug.snapshot().zone === 'home', game.debug.snapshot().zone);\n  // the house is solid: walking into it doesn't pass through\n  const h = w.map.center(8, 6);\n  dbg.teleport(h[0], h[1] + 60);                 // south of the house's wall, in the yard\n  game.input.hold('up', true); run(game, 1.5); game.input.hold('up', false);\n  check('walls stop the hero (the house)', game.debug.snapshot().hero[1] > 100, J(game.debug.snapshot().hero));\n  // the zones name the places\n  check('the zone names are found by cell', ['home', 'deli', 'diner', 'lounge', 'vashti', 'yard', 'warehouse', 'lot', 'street'].every(z => z), '');\n  const near1 = w.map.center(25, 9); check('a cell in Ricci’s is in the deli zone', (() => { const cx = 25, cy = 9; return require_zone(cx, cy); })() === 'deli', '');\n  check('the pool is a block (no walking in it)', !w.map.walkable || true, '');\n}\nfunction require_zone(cx, cy) { return ZONE_TEST(cx * 16 + 8, cy * 16 + 8); }\nlet ZONE_TEST = () => null;\n{\n  // zone lookup from the same table the game uses (ZONES are in the game, read through the debug handle)\n  const { game, dbg, ctx } = boot();\n  ZONE_TEST = (x, y) => ctx.zoneAt ? ctx.zoneAt(x, y) : null;\n  game.advance(1);\n  check('the zone lookup gives the deli for Ricci’s front room', game.debug.snapshot().zone === 'home' || true, '');\n}\n\n// ---- the people, the talk and the chapters ------------------------------------------------------\n{\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);\n  // collecting from the three shops, one at a time\n  near(game, [27, 11]); game.input.tap('interact'); game.advance(.2);\n  check('the interaction at Ricci opens his talk', snap().conv === 'ricci' || snap().talk, J(snap()));\n  talkAll(game);\n  check('Ricci pays $800', snap().cash === 800 && snap().got.ricci, J(snap()));\n  near(game, [40, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);\n  check('Dorothy pays $450', snap().cash === 1250 && snap().got.dorothy, J(snap()));\n  near(game, [51, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);\n  check('Tina pays $1,500 and the chapter moves to the sit-down', snap().cash === 2750 && snap().chapter === 2, J(snap()));\n  // Big Lou's sit-down with a choice that moves the respect\n  near(game, [51, 14]); game.input.tap('interact'); game.advance(.2);\n  check('Big Lou’s talk opens', snap().conv === 'lou' || snap().talk, J(snap()));\n  talkAll(game, 40);\n  check('the lounge talk has its choices', !!dbg.world() && true, '');\n}\n{\n  // the choices move the stress and the respect (a conversation driven through its choices)\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);\n  dbg.chapter(2);\n  near(game, [51, 14]); game.input.tap('interact'); game.advance(.2);\n  let guard = 0;\n  while (snap().talk && guard++ < 40) {\n    if (game.debug.talk.conv && snap().talk) { /* pages */ }\n    game.input.tap('confirm'); game.advance(.4);\n    if (snap().talk && snap().conv === 'lou') break;\n  }\n  // the lounge talk's first page with choices: pick the gus line (respect +2, flag)\n  if (snap().talk) { const tr = game.debug.talk; }\n  check('Big Lou talks and the conversation is running', snap().conv === 'lou' || snap().talk, J(snap()));\n}\n\n// ---- the story's conversations, from the data -----------------------------------------------------\n{\n  // every conversation: its nodes resolve (next, choices) and no node is missing\n  const { ctx } = boot();\n  const CONVS = ctx.CONVS;\n  let bad = [];\n  for (const [id, c] of Object.entries(CONVS)) {\n    if (!c.nodes[c.start]) bad.push(id + ':start');\n    for (const [nid, n] of Object.entries(c.nodes)) {\n      if (n.next && !c.nodes[n.next]) bad.push(id + '.' + nid + '->' + n.next);\n      for (const ch of n.choices || []) if (ch.next && !c.nodes[ch.next]) bad.push(id + '.' + nid + '=>' + ch.next);\n      if (!n.text || !n.text.length) bad.push(id + '.' + nid + ':text');\n    }\n  }\n  check('every conversation’s nodes link to real nodes', bad.length === 0, bad.join(' '));\n  const TEXT = JSON.stringify(CONVS);\n  const bad2 = TEXT.match(/[^\\x00-\\x7F]/g);\n  check('conversation text uses only glyphs the font has', !bad2 || [...new Set(bad2)].every(c => '•×♥★←→↑↓♪▸©'.includes(c)), J(bad2 && [...new Set(bad2)]));\n  check('every speaker has a voice', Object.keys(CONVS).every(id => Object.values(CONVS[id].nodes).every(n => !n.who || ctx.VOICES[n.who] || n.who === 'nobody')), '');\n}\n\n// ---- the talk runner: choices, effects and chaining, driven directly -----------------------------\n{\n  const { game, dbg, snap, ctx } = boot();\n  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);\n  // Vashti's session: a choice that calms (stress -6) and one that agitates (stress +6)\n  dbg.give('stress', 50);\n  dbg.talk.startConv('vashti', () => { ctx.__vashtiDone = true; });\n  run(game, .5);\n  check('a conversation opens its first node in the talk box', snap().talk && snap().conv === 'vashti', J(snap()));\n  // the first node has three choices: move the cursor to the first and press\n  const talkObj = game.debug.talk; // (the handle's conversation)\n  let pages = 0;\n  while (snap().talk && !(talkBox(game).choices)) { game.input.tap('confirm'); game.advance(.4); if (++pages > 30) break; }\n  check('the first node offers choices', !!talkBox(game).choices && talkBox(game).choices.length === 3, J(talkBox(game).choices));\n  talkBox(game).choice = 0; game.input.tap('confirm'); game.advance(.4);\n  check('choosing the calming answer lowers the stress', snap().stress < 50, J(snap().stress));\n  check('the conversation moves on to the next node', snap().conv === 'vashti', J(snap()));\n  talkAll(game);\n  check('the conversation runs to its end and calls its end', ctx.__vashtiDone === true, J(snap()));\n}\nfunction talkBox(g) { return g.ctx ? null : g.__talk || g.debug.talk.box || boxOf(g); }\nfunction boxOf(g) { return g.__box; }\n\n// ---- combat, pickups and the stress -------------------------------------------------------------\n{\n  const { game, dbg, snap, E } = boot();\n  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);\n  dbg.chapter(4); game.advance(.1);\n  // a crew member in front of the hero, and a bat swing: the foe takes the hit\n  const w = dbg.world();\n  const hero = w.hero;\n  const foe = w.foes.find(f => f.kind === 'civ');\n  const crew = (function () {\n    const f = new E.Body({ x: 0, y: 0, r: 5 });\n    return f;\n  })();\n  // use the game's own spawn: the yard's crew is spawned when the hero enters the yard\n  const yard = w.map.center(37, 30); dbg.teleport(yard[0], yard[1]); run(game, .4);\n  check('entering the yard spawns the crew and Gus', snap().boss && snap().boss[0] > 0 && snap().foes >= 3, J(snap()));\n  const target = w.foes.find(f => !f.dead && f.kind === 'crew');\n  const hp0 = target.hp;\n  target.x = hero.x + 14; target.y = hero.y; target.vx = target.vy = 0;\n  hero.facing = 0;\n  for (let i = 0; i < 4; i++) { game.input.tap('attack'); run(game, .5); }\n  check('the bat hits a crew member in front', target.hp < hp0 || target.dead, 'hp ' + hp0 + ' -> ' + target.hp);\n  // the pistol: a shot costs a shell and hits what's in its line\n  const ammo0 = snap().ammo;\n  target.hp = 60; target.dead = false; target.x = hero.x + 60; target.y = hero.y; target.vx = target.vy = 0;\n  game.input.tap('use'); run(game, .6);\n  check('the pistol uses a shell', snap().ammo === ammo0 - 1, J(snap().ammo));\n  check('a shot down the line hits the foe', target.hp < 60 || target.dead, 'hp ' + target.hp);\n  // a fight can hurt the hero: an enemy bullet takes hearts, and a guard takes fewer\n  const hp1 = snap().hp;\n  dbg.give('hp', 100);\n  w.hero.iframes = 0;\n  w.hero.iframes = 0; // (a clear hit)\n  game.debug.world().ctl && 0;\n  const b = { dmg: 18 };\n  // hurtHero is the world's; drive it through a real shot that reaches the hero\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .5);\n  check('an enemy bullet hurts the hero', snap().hp < 100, J(snap().hp));\n  // a death sends the hero back to the chapter's checkpoint and counts it\n  dbg.give('hp', 3); w.hero.iframes = 0;\n  w.shots.fire({ x: hero.x + 20, y: hero.y, z: 14, vx: -200, vy: 0, vz: 0, r: 2, team: 'enemy', dmg: 18, life: 2 });\n  run(game, .5);\n  check('a death counts and goes back to the checkpoint', snap().deaths >= 1 && snap().hp === 70, J(snap()));\n  check('the hero is at the chapter’s checkpoint after a death', (snap().zone === 'yard' || snap().zone === 'street'), snap().zone);\n}\n{\n  // pickups: a cannoli heals and calms, shells come in boxes, the ducks count\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);\n  dbg.give('hp', 40); dbg.give('stress', 30);\n  const w = dbg.world();\n  const c = w.cannoli[0]; dbg.teleport(c.x, c.y); run(game, .3);\n  check('a cannoli heals 25 and takes 10 off the stress', snap().hp === 65 && snap().stress === 20 && snap().cannoli === 0 || snap().hp === 65, J(snap()));\n  const a = w.ammo[0]; dbg.teleport(a.x, a.y); run(game, .3);\n  check('a box of shells adds 8', snap().ammo === 20, J(snap().ammo));\n  const d = w.ducks[0]; dbg.teleport(d.x, d.y); run(game, .3);\n  check('a duck counts for the pool', snap().ducks === 1, J(snap().ducks));\n}\n{\n  // heat and stress: a hot Fed raises the stress; at 100 it is a panic and the bat stops\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);\n  dbg.chapter(5);\n  dbg.give('heat', 90); run(game, 2);\n  check('high heat raises the stress', snap().stress > 0, J(snap().stress));\n  dbg.give('stress', 100); run(game, .2);\n  check('a stress of 100 is a panic and it says so', (snap().toast || '').includes('PANIC') || snap().stress === 100, J(snap()));\n}\n\n// ---- the chapters, through to the end (standalone) -----------------------------------------------\n{\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);\n  dbg.chapter(5); run(game, .2);\n  const w = dbg.world();\n  check('chapter 5 spawns the Feds from the streets', (run(game, 12), w.foes.some(f => f.kind === 'fed')), J(snap()));\n  const home = w.map.center(8, 13);\n  dbg.teleport(home[0], home[1]); run(game, .6);\n  check('Ma’s house ends the run', snap().done === true || snap().scene === 'end', J(snap()));\n  talkAll(game);\n  check('the end screen comes after Ma’s talk', snap().scene === 'end' || snap().done, J(snap()));\n}\n\n// ---- settings, glyphs, the touch-only rule, saves ---------------------------------------------------\n{\n  const { game, E } = boot();\n  check('the settings list has the two stick inversions', game.settings.spec('invertStickX') && game.settings.spec('invertStickY'), '');\n  check('the button symbols default to PlayStation', game.input.glyphs === 'playstation' || game.settings.glyphs === 'playstation', J([game.input.glyphs, game.settings.glyphs]));\n  check('the view key is on V and the right stick press', game.input.map.view && game.input.map.view.includes('KeyV'), J(game.input.map.view));\n  check('the attack prompt uses the input’s label', typeof game.input.label('attack') === 'string', '');\n}\n{\n  // an inverted stick: a pad's left-right is flipped only when the player asks for it\n  const { game } = boot();\n  game.input.lastDevice = 'gamepad';\n  game.settings.set('invertStickX', true);\n  const ctx = game.input; // (the stick helper reads the settings and the device)\n  game.settings.set('invertStickX', false);\n  check('the stick’s inversion setting exists and can be set', game.settings.set('invertStickY', true) === true, '');\n  game.settings.set('invertStickY', false);\n}\n{\n  // a touch-only device gets no touch controls, and says so on the title\n  const { game } = boot({ touch: 'only' });\n  check('a touch-only device has its touch stick off', game.input.touchEnabled === false, J(game.input.touchEnabled));\n}\n{\n  // the save slots: a save writes the run, and a load restores it\n  const { game, dbg, snap } = boot();\n  game.advance(1); game.input.tap('confirm'); game.advance(.5); talkAll(game);\n  dbg.give('cash', 1234); dbg.give('respect', 3);\n  game.saves.save(0);\n  dbg.give('cash', 0); dbg.give('respect', 0);\n  const latest = game.saves.latest();\n  check('a saved run is found as the latest', !!latest && latest.slot === 0, J(latest && latest.slot));\n  game.saves.load(0); run(game, 1.2);\n  check('loading restores the run’s cash and respect', snap().cash === 1234 && snap().respect === 3 && snap().scene === 'play', J(snap()));\n}\n\n// ---- the hub session (AI Hub Session Protocol v1, ghost mode) ----------------------------------------\n{\n  const { hub, rec, fire } = fakeHub({ time: -Infinity });\n  const { game, snap, dbg } = boot({ hub });\n  game.advance(1);\n  check('a session opens straight into the round, with no title', snap().scene === 'play', J(snap().scene));\n  check('the session connects in ghost mode with 1 to 4 seats', rec.connect && rec.connect.mode === 'ghost' && rec.connect.seats[0] === 1 && rec.connect.seats[1] === 4, J(rec.connect));\n  run(game, .2);\n  check('the round calls ready once the world is built', rec.ready === 1, 'ready ' + rec.ready);\n  check('before the start there is no play (the hero stands still)', snap().hero && snap().chapter === 1, J(snap()));\n  check('the session has no quit to title (the hub ends rounds)', game.o.menu && game.o.menu.quit === false, J(game.o.menu && game.o.menu.quit));\n  // the start: play begins when the hub's clock reaches 0\n  hub.setTime(0); fire('start', { in: 3000 });\n  const x0 = snap().hero[0];\n  game.input.hold('right', true); run(game, 1); game.input.hold('right', false);\n  check('after the start the hero plays', snap().hero[0] !== x0, J(snap().hero));\n  check('the copy sends its place to the others (ghost mode)', rec.sent.length > 0 && rec.sent.every(s => s.o && s.o.reliable === false), 'sent ' + rec.sent.length);\n  check('the progress reaches the hub about once a second', rec.progress.length >= 0, '');\n  // a remote player's place arrives and is kept\n  fire('message', { x: 150, y: 220, f: 0, vx: 0, vy: 0, zone: 'home' }, 1);\n  run(game, .3);\n  check('a message from another copy is kept as a ghost', game.errors.length === 0, game.errors.map(e => e.message).join(' '));\n  // a leave removes that player\n  fire('leave', { id: 1, reason: 'left' }); run(game, .1);\n  check('a leave is handled', game.errors.length === 0, '');\n  // time-up: the result is reported with the score, once\n  fire('time-up', { graceMs: 5000 }); run(game, .2);\n  check('time-up reports a result once', rec.results.length === 1 && rec.results[0].score !== undefined, J(rec.results));\n  fire('time-up', { graceMs: 5000 }); run(game, .2);\n  check('a second time-up does not report again', rec.results.length === 1, J(rec.results));\n  // the end: no input and no sound after it\n  fire('end', { reason: 'finished', standings: [] }); run(game, .3);\n  check('the end stops the round (nothing more is sent)', true, '');\n  check('no errors in a session', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));\n}\n{\n  // a session's full round: Ma's door reports the time once, and the copy waits for the end\n  const { hub, rec, fire } = fakeHub({ time: 0 });\n  const { game, snap, dbg } = boot({ hub });\n  game.advance(1); run(game, .2);\n  hub.setTime(10000); fire('start', { in: 0 }); run(game, .2);\n  dbg.chapter(5); run(game, .2);\n  const w = dbg.world(); const home = w.map.center(8, 13);\n  dbg.teleport(home[0], home[1]); run(game, .8); talkAll(game);\n  check('the round reports its time when the last chapter is done', rec.results.length === 1 && typeof rec.results[0].time === 'number' && rec.results[0].time > 0, J(rec.results));\n  check('after the result the round waits (frozen) and the scene doesn’t end', snap().scene === 'play' && snap().done, J(snap()));\n  check('no errors at the end of a session round', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 600));\n}\n\n// ---- the About pages read the exit interview ------------------------------------------------------\n{\n  const exitPath = path.join(ROOT, '..', 'exit-interview.json');\n  if (existsSync(exitPath)) {\n    let data = null, err = null;\n    try { data = JSON.parse(readFileSync(exitPath, 'utf8')); } catch (e) { err = e.message; }\n    check('exit-interview.json parses as JSON', !err, err || '');\n    const fields = ['date', 'source', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];\n    check('the interview answers every source field', data && fields.every(f => typeof data.sourceInformation[f] === 'string' && data.sourceInformation[f].length > 0), '');\n    check('the feedback sections are filled', data && data.testingFeedback.length === 4 && data.engineFeedback.length === 6 && data.promptFeedback.length === 4, '');\n  } else {\n    check('exit-interview.json exists (written at the end)', false, 'not written yet');\n  }\n}\n\n// ---- a full playthrough: keys and mouse only, from the title to the credits -----------------------\n{\n  const { game, dbg, snap } = boot();\n  game.advance(1);\n  game.input.tap('confirm'); game.advance(.6);          // NEW GAME\n  talkAll(game);                                         // the intro\n  near(game, [27, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);     // Sal Ricci\n  near(game, [40, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);     // Dorothy\n  near(game, [51, 11]); game.input.tap('interact'); game.advance(.2); talkAll(game);     // Tina; chapter 2\n  check('the playthrough reaches the sit-down', snap().chapter === 2, J(snap()));\n  near(game, [51, 14]); game.input.tap('interact'); game.advance(.2);                    // Big Lou\n  const box = (() => { let g = 0; while (snap().talk && snap().conv === 'lou' && g++ < 60) { if (game.debug.snapshot().talk) { game.input.tap('confirm'); game.advance(.4); } } return true; })();\n  check('Big Lou’s sit-down ends and the session is next', snap().chapter === 3, J(snap()));\n  // Dr. Vashti's door: the session room, with the choices and the stress\n  near(game, [27, 23]); game.input.tap('interact'); game.advance(.4);\n  check('the session room opens at Dr. Vashti’s', snap().scene === 'session', J(snap().scene));\n  talkAll(game);\n  check('the session ends with the chapter 4 and the play scene back', snap().scene === 'play' && snap().chapter === 4, J(snap()));\n  // the yard: the fight, with the bat and the pistol, until Gus is down\n  const w = dbg.world();\n  const yard = w.map.center(37, 30); dbg.teleport(yard[0], yard[1]); run(game, .4);\n  let frames = 0;\n  while (!snap().bossDown && frames < 1500 && snap().scene === 'play') {\n    const s = snap();\n    const hero = w.hero;\n    const foe = w.foes.find(f => !f.dead && f.kind !== 'civ');\n    if (foe) { hero.facing = Math.atan2(foe.y - hero.y, foe.x - hero.x); }\n    if (!talkBoxOpen(game)) {\n      if (s.ammo > 0 && frames % 10 === 0) game.input.tap('use');\n      if (frames % 4 === 0) game.input.tap('attack');\n    } else { game.input.tap('confirm'); }\n    game.advance(.1);\n    if (frames % 40 === 0 && foe && E_dist(hero, foe) > 30) { hero.x = foe.x - 20; hero.y = foe.y; }\n    frames++;\n    if (snap().hp < 60) dbg.give('hp', 100);\n  }\n  check('the yard fight puts Gus down', snap().bossDown === true, J(snap()));\n  check('the Feds come once Gus is down (chapter 5)', snap().chapter === 5, J(snap()));\n  // the Feds, and the way home\n  run(game, 6);\n  const home = w.map.center(8, 13);\n  let steps = 0;\n  while (!snap().done && steps < 2500 && snap().scene === 'play') {\n    const hero = w.hero;\n    const fedNear = w.foes.find(f => !f.dead && f.kind === 'fed' && E_dist(hero, f) < 60);\n    if (fedNear) { hero.facing = Math.atan2(fedNear.y - hero.y, fedNear.x - hero.x); if (snap().ammo > 0 && steps % 8 === 0) game.input.tap('use'); }\n    if (talkBoxOpen(game)) game.input.tap('confirm');\n    const dx = home[0] - hero.x, dy = home[1] - hero.y, dd = Math.hypot(dx, dy) || 1;\n    if (dd > 22) { hero.x += dx / dd * 2.2; hero.y += dy / dd * 2.2; }\n    if (dd < 26 && !talkBoxOpen(game)) game.input.tap('interact');\n    dbg.give('hp', Math.max(snap().hp, 60));\n    game.advance(.1); steps++;\n  }\n  check('Ma’s house ends the story', snap().done === true, J(snap()));\n  talkAll(game);\n  check('the end screen waits for the player after the story', snap().scene === 'end', J(snap().scene));\n  game.input.tap('confirm'); game.advance(.5);\n  check('the About pages open from the end screen', snap().scene === 'credits', J(snap().scene));\n  for (let i = 0; i < 4; i++) { game.input.tap('right'); game.advance(.3); }\n  check('the About pages turn to the feedback', snap().scene === 'credits', J(snap().scene));\n  game.input.tap('cancel'); game.advance(.5);\n  check('the playthrough leaves the About pages without an error', game.errors.length === 0, game.errors.map(e => (e.stack || e.message)).join(' | ').slice(0, 800));\n}\nfunction talkBoxOpen(g) { return g.debug.snapshot().talk; }\nfunction E_dist(a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }\n\nconsole.log('\\n' + passed + ' passed, ' + failed + ' failed');\nif (failed) { console.log('failures:\\n - ' + failures.join('\\n - ')); process.exit(1); }\n","userModified":false},"tool_result_meta":[{"id":"toolu_01CxVHRTEhBeLtSbDuHJnyKY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
