k]) return centerOf(NPC_DEFS[k].cell);\n  }\n  if (S.chapter === 2) return centerOf(NPC_DEFS.lou.cell);\n  if (S.chapter === 3) return centerOf([27, 23]);\n  if (S.chapter === 4) return W.boss && !W.boss.dead ? { x: W.boss.x, y: W.boss.y } : centerOf([37, 30]);\n  if (S.chapter === 5) return centerOf([8, 13]);\n  return null;\n}\n\nfunction aiStep(dt) {\n  AI.press = {};\n  const hero = W.hero;\n  S.hp = 100; S.ammo = Math.max(S.ammo, 20); S.stress = Math.min(S.stress, 50);   // the cheats\n  AI.atkT -= dt; AI.useT -= dt; AI.interactT -= dt;\n  // the nearest foe still standing (civilians are left alone)\n  let foe = null, fd = Infinity;\n  for (const f of W.foes) { if (f.dead || f.kind === 'civ') continue; const d = E.dist(hero, f); if (d < fd) { fd = d; foe = f; } }\n  let dir = [0, 0];\n  const engaged = !!foe && fd < 170;\n  if (engaged) {\n    hero.facing = Math.atan2(foe.y - hero.y, foe.x - hero.x);\n    if (fd < 30) {\n      if (AI.atkT <= 0 && !W.combo.busy) { AI.press.attack = true; AI.atkT = .6; }\n    } else dir = [Math.cos(hero.facing), Math.sin(hero.facing)];\n    if (fd >= 40 && AI.useT <= 0 && S.ammo > 0) { AI.press.use = true; AI.useT = .42; }\n  } else {\n    const goal = aiGoal();\n    if (goal && E.dist(hero, goal) > 18) {\n      if (!AI.flow) AI.flow = new E.FlowField(W.map);\n      AI.flowT -= dt;\n      if (AI.flowT <= 0) { AI.flow.update(goal.x, goal.y); AI.flowT = .4; }\n      dir = AI.flow.dir(hero.x, hero.y, goal.x, goal.y);\n    }\n  }\n  // the buttons for the goal: talk to a person, open a door (not in a fight)\n  if (nearestInteractable() && AI.interactT <= 0 && !(engaged && fd < 60)) { AI.press.interact = true; AI.interactT = .9; }\n  // stuck at a corner for a while: hop\n  AI.stuck = Math.hypot(hero.vx || 0, hero.vy || 0) < 4 ? AI.stuck + dt : 0;\n  AI.walk.jumpPressed = AI.stuck > 1.2;\n  if (AI.stuck > 1.2) AI.stuck = 0;\n  AI.walk.move = dir;\n  AI.walk.sprint = true;\n}\n\nconst attractScene = {\n  enter() {\n    ATTRACT = true;\n    S = newState();\n    buildWorld();\n    W.god = true;\n    setChapter(1, { quiet: true });\n    AI.flow = null; AI.endT = 0; AI.talk = 0; AI.stuck = 0;\n    playSong('street');\n  },\n  exit() { ATTRACT = false; },\n  update(dt) {\n    if (game.input.anyPressed()) { game.go('title'); return; }\n    if (S.done) { AI.endT += dt; if (AI.endT > 5) { game.go('title'); return; } }\n    if (talk.open) aiTalk(dt, AI);\n    aiStep(dt);\n    playUpdate(dt, AIPAD, AI.walk);\n  },\n  draw(r) { drawPlayFrame(r); },\n};\n","structuredPatch":[{"oldStart":7,"oldLines":14,"newStart":7,"newLines":14,"lines":[" let ATTRACT = false;"," const AI = {","   press: {}, down: {}, walk: { move: [0, 0], sprint: true, jumpPressed: false },","-  t: 0, talk: 0, flowT: 0, flow: null, fireT: 0, atkT: 0, useT: 0, interactT: 0, stuck: 0, endT: 0,","+  talk: 0, flowT: 0, flow: null, atkT: 0, useT: 0, interactT: 0, stuck: 0, endT: 0,"," };","-// The buttons the AI presses: the same names as game.input's, read the same way by the world.","+// The buttons the AI presses, read by the world the same way as game.input's."," const AIPAD = {","   pressed: a => !!AI.press[a], down: a => !!AI.down[a], buffered: a => !!AI.press[a], consume() {}, label: () => '',","-  move: () => AI.walk.move,"," };"," ","+// Where the AI walks: the chapter's goal (a person, a door, the yard, Ma's door)."," function aiGoal() {","   if (S.done) return null;","   if (S.chapter === 1) {"]},{"oldStart":22,"oldLines":73,"newStart":22,"newLines":63,"lines":["   }","   if (S.chapter === 2) return centerOf(NPC_DEFS.lou.cell);","   if (S.chapter === 3) return centerOf([27, 23]);","-  if (S.chapter === 4) {","-    if (W.boss && !W.boss.dead) return { x: W.boss.x, y: W.boss.y };","-    return centerOf([37, 30]);","-  }","+  if (S.chapter === 4) return W.boss && !W.boss.dead ? { x: W.boss.x, y: W.boss.y } : centerOf([37, 30]);","   if (S.chapter === 5) return centerOf([8, 13]);","   return null;"," }"," "," function aiStep(dt) {","-  AI.press = {}; AI.down = {};","+  AI.press = {};","   const hero = W.hero;","-  // cheats: no death, full shells, a calm head","-  S.hp = 100; S.ammo = Math.max(S.ammo, 20); S.stress = Math.min(S.stress, 50);","-  AI.endT += S.done ? dt : 0;","-  AI.fireT -= dt; AI.atkT -= dt; AI.useT -= dt; AI.interactT -= dt;","-  // the nearest foe that is still standing","+  S.hp = 100; S.ammo = Math.max(S.ammo, 20); S.stress = Math.min(S.stress, 50);   // the cheats","+  AI.atkT -= dt; AI.useT -= dt; AI.interactT -= dt;","+  // the nearest foe still standing (civilians are left alone)","   let foe = null, fd = Infinity;","   for (const f of W.foes) { if (f.dead || f.kind === 'civ') continue; const d = E.dist(hero, f); if (d < fd) { fd = d; foe = f; } }","-  let target = aiGoal();","   let dir = [0, 0];","-  if (foe && fd < 160) {","+  const engaged = !!foe && fd < 170;","+  if (engaged) {","     hero.facing = Math.atan2(foe.y - hero.y, foe.x - hero.x);","-    if (fd < 30) { if (AI.atkT <= 0 && !W.combo.busy) { AI.press.attack = true; AI.atkT = .6; } }","-    else dir = [Math.cos(hero.facing), Math.sin(hero.facing)];","+    if (fd < 30) {","+      if (AI.atkT <= 0 && !W.combo.busy) { AI.press.attack = true; AI.atkT = .6; }","+    } else dir = [Math.cos(hero.facing), Math.sin(hero.facing)];","     if (fd >= 40 && AI.useT <= 0 && S.ammo > 0) { AI.press.use = true; AI.useT = .42; }","-    if (fd < 30) dir = [0, 0];","-  }","-  if (!foe || fd >= 160 || fd >= 30) {","-    if (target && E.dist(hero, target) > 18 && (!foe || fd >= 30)) {","-      AI.flowT -= dt;","+  } else {","+    const goal = aiGoal();","+    if (goal && E.dist(hero, goal) > 18) {","       if (!AI.flow) AI.flow = new E.FlowField(W.map);","-      if (AI.flowT <= 0) { AI.flow.update(target.x, target.y); AI.flowT = .4; }","-      dir = AI.flow.dir(hero.x, hero.y, target.x, target.y);","+      AI.flowT -= dt;","+      if (AI.flowT <= 0) { AI.flow.update(goal.x, goal.y); AI.flowT = .4; }","+      dir = AI.flow.dir(hero.x, hero.y, goal.x, goal.y);","     }","   }","-  // the buttons for the goal: talk to a person, open a door","-  const it = nearestInteractable();","-  if (it && AI.interactT <= 0 && !foe?.kind === false) { /* a foe in the way is fought first */ }","-  if (it && AI.interactT <= 0 && (!foe || fd > 40)) { AI.press.interact = true; AI.interactT = .9; }","-  // not moving for a while (a corner): hop","-  const sp = Math.hypot(hero.vx || 0, hero.vy || 0);","-  AI.stuck = sp < 4 ? AI.stuck + dt : 0;","+  // the buttons for the goal: talk to a person, open a door (not in a fight)","+  if (nearestInteractable() && AI.interactT <= 0 && !(engaged && fd < 60)) { AI.press.interact = true; AI.interactT = .9; }","+  // stuck at a corner for a while: hop","+  AI.stuck = Math.hypot(hero.vx || 0, hero.vy || 0) < 4 ? AI.stuck + dt : 0;","   AI.walk.jumpPressed = AI.stuck > 1.2;","   if (AI.stuck > 1.2) AI.stuck = 0;","   AI.walk.move = dir;","   AI.walk.sprint = true;"," }"," ","-// ---- the scene -------------------------------------------------------------------------------"," const attractScene = {","   enter() {","-    ATTRACT = true; W = null;","+    ATTRACT = true;","     S = newState();","     buildWorld();","     W.god = true;","     setChapter(1, { quiet: true });","-    AI.flow = null; AI.endT = 0; AI.talk = 0;","+    AI.flow = null; AI.endT = 0; AI.talk = 0; AI.stuck = 0;","     playSong('street');","   },","-  exit() { ATTRACT = false; W = W || null; },","+  exit() { ATTRACT = false; },","   update(dt) {","     if (game.input.anyPressed()) { game.go('title'); return; }","-    if (AI.endT > 5) { game.go('title'); return; }","-    if (talk.open) { aiTalk(dt, AI); }","+    if (S.done) { AI.endT += dt; if (AI.endT > 5) { game.go('title'); return; } }","+    if (talk.open) aiTalk(dt, AI);","     aiStep(dt);","     playUpdate(dt, AIPAD, AI.walk);","-    if (!S.done && S.chapter === 5 && W.toast === null && !conv) { /* the feds keep coming */ }","   },","   draw(r) { drawPlayFrame(r); },"," };"]}],"originalFile":"// ---------------------------------------------------------------------------------------------\n// 07 · ATTRACT — the title's idle demo. After 10 s with no input the game plays itself: an AI\n// hero that cheats (no damage, full shells) walks the chapters' goals, fights what's near, picks\n// its own answers in the talk and runs the whole demo round after round. Any input ends it.\n// It only shows the game; it isn't meant to balance it.\n// ---------------------------------------------------------------------------------------------\nlet ATTRACT = false;\nconst AI = {\n  press: {}, down: {}, walk: { move: [0, 0], sprint: true, jumpPressed: false },\n  t: 0, talk: 0, flowT: 0, flow: null, fireT: 0, atkT: 0, useT: 0, interactT: 0, stuck: 0, endT: 0,\n};\n// The buttons the AI presses: the same names as game.input's, read the same way by the world.\nconst AIPAD = {\n  pressed: a => !!AI.press[a], down: a => !!AI.down[a], buffered: a => !!AI.press[a], consume() {}, label: () => '',\n  move: () => AI.walk.move,\n};\n\nfunction aiGoal() {\n  if (S.done) return null;\n  if (S.chapter === 1) {\n    for (const k of ['ricci', 'dorothy', 'tina']) if (!S.got[k]) return centerOf(NPC_DEFS[k].cell);\n  }\n  if (S.chapter === 2) return centerOf(NPC_DEFS.lou.cell);\n  if (S.chapter === 3) return centerOf([27, 23]);\n  if (S.chapter === 4) {\n    if (W.boss && !W.boss.dead) return { x: W.boss.x, y: W.boss.y };\n    return centerOf([37, 30]);\n  }\n  if (S.chapter === 5) return centerOf([8, 13]);\n  return null;\n}\n\nfunction aiStep(dt) {\n  AI.press = {}; AI.down = {};\n  const hero = W.hero;\n  // cheats: no death, full shells, a calm head\n  S.hp = 100; S.ammo = Math.max(S.ammo, 20); S.stress = Math.min(S.stress, 50);\n  AI.endT += S.done ? dt : 0;\n  AI.fireT -= dt; AI.atkT -= dt; AI.useT -= dt; AI.interactT -= dt;\n  // the nearest foe that is still standing\n  let foe = null, fd = Infinity;\n  for (const f of W.foes) { if (f.dead || f.kind === 'civ') continue; const d = E.dist(hero, f); if (d < fd) { fd = d; foe = f; } }\n  let target = aiGoal();\n  let dir = [0, 0];\n  if (foe && fd < 160) {\n    hero.facing = Math.atan2(foe.y - hero.y, foe.x - hero.x);\n    if (fd < 30) { if (AI.atkT <= 0 && !W.combo.busy) { AI.press.attack = true; AI.atkT = .6; } }\n    else dir = [Math.cos(hero.facing), Math.sin(hero.facing)];\n    if (fd >= 40 && AI.useT <= 0 && S.ammo > 0) { AI.press.use = true; AI.useT = .42; }\n    if (fd < 30) dir = [0, 0];\n  }\n  if (!foe || fd >= 160 || fd >= 30) {\n    if (target && E.dist(hero, target) > 18 && (!foe || fd >= 30)) {\n      AI.flowT -= dt;\n      if (!AI.flow) AI.flow = new E.FlowField(W.map);\n      if (AI.flowT <= 0) { AI.flow.update(target.x, target.y); AI.flowT = .4; }\n      dir = AI.flow.dir(hero.x, hero.y, target.x, target.y);\n    }\n  }\n  // the buttons for the goal: talk to a person, open a door\n  const it = nearestInteractable();\n  if (it && AI.interactT <= 0 && !foe?.kind === false) { /* a foe in the way is fought first */ }\n  if (it && AI.interactT <= 0 && (!foe || fd > 40)) { AI.press.interact = true; AI.interactT = .9; }\n  // not moving for a while (a corner): hop\n  const sp = Math.hypot(hero.vx || 0, hero.vy || 0);\n  AI.stuck = sp < 4 ? AI.stuck + dt : 0;\n  AI.walk.jumpPressed = AI.stuck > 1.2;\n  if (AI.stuck > 1.2) AI.stuck = 0;\n  AI.walk.move = dir;\n  AI.walk.sprint = true;\n}\n\n// ---- the scene -------------------------------------------------------------------------------\nconst attractScene = {\n  enter() {\n    ATTRACT = true; W = null;\n    S = newState();\n    buildWorld();\n    W.god = true;\n    setChapter(1, { quiet: true });\n    AI.flow = null; AI.endT = 0; AI.talk = 0;\n    playSong('street');\n  },\n  exit() { ATTRACT = false; W = W || null; },\n  update(dt) {\n    if (game.input.anyPressed()) { game.go('title'); return; }\n    if (AI.endT > 5) { game.go('title'); return; }\n    if (talk.open) { aiTalk(dt, AI); }\n    aiStep(dt);\n    playUpdate(dt, AIPAD, AI.walk);\n    if (!S.done && S.chapter === 5 && W.toast === null && !conv) { /* the feds keep coming */ }\n  },\n  draw(r) { drawPlayFrame(r); },\n};\n","userModified":false},"tool_result_meta":[{"id":"toolu_018SDC8thoLTrdwp1BxT4MdG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
