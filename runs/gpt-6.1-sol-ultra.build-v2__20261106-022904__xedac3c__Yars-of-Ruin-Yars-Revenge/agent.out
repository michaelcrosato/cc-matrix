)c.cells.push({x:lx,y:ly,plate:p.id,material:S.editMaterial});status=(remove?\\'Removed\\':\\'Placed\\')+\\' cell at \\'+x+\\', \\'+y+\\'.\\';draw();}\\n function draw(){if(typeof document===\\'undefined\\')return;const cv=document.getElementById(\\'ruin-editor\\');if(!cv||!content)return;const g=cv.getContext(\\'2d\\');g.fillStyle=\\'#07131d\\';g.fillRect(0,0,960,540);g.fillStyle=\\'#1c3b3b\\';g.fillRect(S.editRefugeX,0,S.editRefugeW,540);g.strokeStyle=\\'#17303a\\';for(let x=0;x<960;x+=20){g.beginPath();g.moveTo(x,0);g.lineTo(x,540);g.stroke();}for(let y=0;y<540;y+=20){g.beginPath();g.moveTo(0,y);g.lineTo(960,y);g.stroke();}for(const cell of content.cells){const p=content.plates.find(p=>String(p.id)===String(cell.plate))||{x:0,y:0};g.fillStyle=cell.material===\\'reflective\\'?\\'#ecc889\\':\\'#7baf9b\\';g.fillRect(cell.x+(p.x||0)-9,cell.y+(p.y||0)-9,18,18);}g.fillStyle=\\'#ef977f\\';g.fillRect(content.core.x-16,content.core.y-16,32,32);g.strokeStyle=\\'#fff9cc\\';g.lineWidth=3;g.strokeRect(S.editX*20-10,S.editY*20-10,20,20);const out=document.getElementById(\\'ruin-editor-status\\');if(out)out.textContent=status;}\\n function attach(){if(!ui.root||!content)return;const box=ui.root.querySelector(\\'.esh-mod\\');if(!box)return;const cv=document.createElement(\\'canvas\\');cv.id=\\'ruin-editor\\';cv.className=\\'ruin-editor\\';cv.width=960;cv.height=540;cv.setAttribute(\\'aria-label\\',\\'Shield layout; click to paint, right click to remove\\');box.insertBefore(cv,box.querySelector(\\'.esh-row\\'));let held=false;cv.oncontextmenu=e=>e.preventDefault();const at=e=>{const r=cv.getBoundingClientRect();const x=Math.round((e.clientX-r.left)/r.width*48)*20,y=Math.round((e.clientY-r.top)/r.height*27)*20;paint(x,y,e.button===2||e.buttons===2);};cv.onpointerdown=e=>{held=true;cv.setPointerCapture(e.pointerId);at(e);};cv.onpointermove=e=>{if(held)at(e);};cv.onpointerup=()=>held=false;cv.onpointercancel=()=>held=false;const st=document.createElement(\\'p\\');st.id=\\'ruin-editor-status\\';st.className=\\'editor-status\\';box.append(st);draw();}\\n function show(reset=false){if(!content||reset){content=RuinSim.exportContent(api.world());S.set(\\'editRefugeX\\',content.refuge.x);S.set(\\'editRefugeW\\',content.refuge.w);const p=content.plates[0];if(p){S.set(\\'editMotion\\',p.amplitude||0);S.set(\\'editPeriod\\',p.period||7);}}ui.show(\\'editor\\',{kicker:\\'Designer workbench · practice only\\',title:\\'Carve another signal\\',text:\\'Select a cell with the sliders and place or remove it. A pointer paints directly. Changes are validated before flight.\\',rows:defs.map(d=>d.key),actions:[[\\'Place cell\\',()=>paint(S.editX*20,S.editY*20)],[\\'Remove cell\\',()=>paint(S.editX*20,S.editY*20,true)],[\\'Preview encounter\\',()=>{const v=check(normalized());if(!v.ok){status=v.errors.join(\\' \\');draw();return;}api.load(v.content);ui.hide();game.resume();}],[\\'JSON import / export\\',jsonScreen],[\\'Save preset\\',()=>{const c=normalized(),v=check(c);if(v.ok){My3D2dge.store.set(\\'ruin:encounter\\',v.content);status=\\'Preset saved on this device.\\';}else status=v.errors.join(\\' \\');draw();}],[\\'Load preset\\',()=>{const c=My3D2dge.store.get(\\'ruin:encounter\\',null),v=check(c);if(v.ok){content=v.content;status=\\'Saved preset loaded.\\';show();}else{status=\\'No valid saved preset. \\'+v.errors.join(\\' \\');draw();}}],[\\'Back\\',()=>ui.back()]]});attach();}\\n function jsonScreen(){let text=JSON.stringify(normalized(),null,2);ui.show(\\'editor-json\\',{kicker:\\'Encounter data · version 1\\',title:\\'Carry the signal\\',text:\\'Export is self contained JSON. Import rejects invalid geometry, missing plate references and unsafe values.\\',actions:[[\\'Import text\\',()=>{const el=ui.root.querySelector(\\'textarea\\');try{const v=check(JSON.parse(el.value));if(!v.ok)throw new Error(v.errors.join(\\' \\'));content=v.content;status=\\'Imported encounter is ready to preview.\\';ui.back();show();}catch(e){const st=ui.root.querySelector(\\'.edi