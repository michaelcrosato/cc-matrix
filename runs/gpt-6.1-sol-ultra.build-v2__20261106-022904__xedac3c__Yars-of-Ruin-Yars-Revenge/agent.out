{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"sed -n '325,375p' Yars-*/src/sim.js && rg -n 'w.attract|attract' Yars-*/src/sim.js\"","aggregated_output":"  function hazardsStep(w, dt) {\n    for (const h of w.hazards) {\n      h.age += dt; h.life -= dt;\n      const ox = h.x, oy = h.y;\n      if (h.kind === 'pursuer') {\n        const target = chooseTarget(w, h.target);\n        let desired = h.angle;\n        if (target) {\n          h.target = target.index;\n          if (isStatic(w, target)) {\n            const side = h.variant ? 1 : -1, orbitX = w.refuge.x + w.refuge.w / 2 + Math.cos(h.age * .85 + h.id) * (w.refuge.w / 2 + 30);\n            const orbitY = wrap(target.y + Math.sin(h.age * .85 + h.id) * 100 * side);\n            desired = Math.atan2(dy(orbitY, h.y), orbitX - h.x);\n          } else desired = Math.atan2(dy(target.y, h.y), target.x - h.x);\n        }\n        h.angle = turn(h.angle, desired, w.tuning.pursuerTurn * dt);\n        const speed = w.tuning.pursuerSpeed * (h.variant ? 1.12 : 1) * (w.sector === 2 ? 1.08 : 1);\n        h.vx = Math.cos(h.angle) * speed; h.vy = Math.sin(h.angle) * speed;\n      }\n      h.x += h.vx * dt; h.y = wrap(h.y + h.vy * dt);\n      if (h.kind === 'pursuer') {\n        if (h.x < 20 || h.x > 940) { h.x = clamp(h.x, 20, 940); h.angle = Math.PI - h.angle; }\n      } else if (h.x < -25 || h.x > 985) h.life = 0;\n      for (const p of w.players) {\n        if (!p.alive || p.departed || isStatic(w, p)) continue;\n        if (sweepCircle(ox, oy, h.x, h.y, p, p.r + h.r)) kill(w, p, h.kind);\n      }\n    }\n    w.hazards = w.hazards.filter(h => h.life > 0);\n  }\n  function refugeStep(w, dt) {\n    const r = w.refuge;\n    if (w.sector !== 2) return;\n    r.cycle += dt;\n    const period = 23, warning = 3.2, start = period - warning;\n    if (r.active && !r.warning && r.cycle >= start) { r.warning = true; event(w, 'refuge-warning', r.x + r.w / 2, 270); say(w, 'THE REFUGE IS FRACTURING — MOVE BEFORE THE BORDERS TURN RED', 3.2); }\n    if (r.active && r.cycle >= period) { r.active = false; r.warning = false; r.outageTimer = w.tuning.refugeOutage; event(w, 'refuge-outage', r.x + r.w / 2, 270); }\n    if (!r.active) { r.outageTimer -= dt; if (r.outageTimer <= 0) { r.active = true; r.cycle = 0; event(w, 'refuge-return', r.x + r.w / 2, 270); } }\n  }\n  function tutorialStep(w) {\n    if (w.sector !== 0) return;\n    const learned = w.learned;\n    const target = learned.cannon || learned.airborne ? 4 : learned.charge ? 3 : learned.bite ? 2 : learned.move && learned.shoot ? 1 : 0;\n    w.tutorial = Math.max(w.tutorial, target);\n  }\n  function applyTuning(w) {\n    for (const [k, value] of Object.entries(w.pendingTuning)) {\n      w.tuning[k] = value;\n      if (k === 'reserveCount') w.reserves = value;\n      if (k === 'chargeThreshold') for (const p of w.players) { p.charge = Math.min(p.charge, value); p.ready = ready(w, p); }\n      if (k === 'biteInterval') for (const p of w.players) p.biteTimer = Math.min(p.biteTimer, value);\n91:      assist: !!options.assist, practice: !!options.practice || !!custom, attract: !!options.attract, tuning, players: Array.from({ length: count }, (_, i) => makePlayer(i, Array.isArray(options.playe [... omitted end of long line]\n118:    if (!p.alive || p.invuln > 0 || p.departed || w.mode !== 'play' || w.dev.invulnerable || w.attract) return false;\n439:      stats: copy(w.stats), tuning: copy(w.tuning), practice: w.practice, assist: w.assist, attract: w.attract, tutorial: w.tutorial, learned: copy(w.learned), message: w.message, errors: copy(w.error [... omitted end of long line]\n550:    if (options.attract && isStatic(w, p)) fire = true;\n","exit_code":0,"status":"completed"}}
