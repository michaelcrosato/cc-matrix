1:/* menu actions shared by every preset. Pad9 = Start, Pad0 = A (bottom), Pad1 = B (right). use() adds 'Act:menu', the\n1284:  start: ['Enter', 'NumpadEnter', 'Pad9'], pause: ['Escape', 'KeyP', 'Pad9'],\n1298:  playstation: ['✕', '○', '□', '△', 'L1', 'R1', 'L2', 'R2', 'Create', 'Options', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'PS'],\n1326:  attack: ['KeyJ', 'Mouse0', 'Pad2'], block: ['KeyK', 'Mouse2', 'Pad4'], dodge: ['KeyL', 'Pad5'], use: ['KeyQ', 'Pad6'], map: ['KeyM', 'Tab', 'Pad8'], ...MENU_KEYS\n2911:    if (ok('res') || ok('expand')) this.screen.setOptions(Object.assign(ok('res') ? { res: s.res } : {}, ok('expand') ? { expand: s.expand } : {}));\n3837:    if (!on || prev || P.length >= J.max || (p.buttons[8] && p.buttons[8].pressed)) continue;   // (Create + Options is the host's)\n6826: *    them. Options: crouch (down crouches into a box half as tall: crawl under a gap), ledge (catch a ledge falling past\n8225: *    Options: chest / door { open: true }, pillar { broken: true }, vines / cobweb / lantern hang ({ anchor: 'top' }).\n12750:    const sc = game.screen, O = game.o;   // (the game's sizing options: setOptions changes them)\n12753:      sc.setOptions({ minW: 1e6, minH: 1e6, maxW: 1e6, maxH: 1e6, portrait: { maxH: 1e6 } }); game.cam.snap = true;\n12754:    } else if (!on && this._res) { const R = this._res; this._res = null; sc.setOptions({ minW: R.minW, minH: R.minH, maxW: R.maxW, maxH: R.maxH, portrait: R.portrait }); game.cam.snap = true; }\n","exit_code":0,"status":"completed"}}
