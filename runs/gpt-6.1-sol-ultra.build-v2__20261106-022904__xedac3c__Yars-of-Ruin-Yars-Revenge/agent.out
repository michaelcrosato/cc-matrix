;},onStep:(w,events)=>{world=w;fx(w,events);},onStart:()=>{menuMode=\\'play\\';lastSector=-1;lastMode=\\'\\';if(game.sceneName)game.go(\\'play\\',null,{fade:0});},onEnd:detail=>{onlineEnded=true;controls.clear();sound.dispose();ui.hide();game.stop();setPlaying(false);tell(detail?.reason===\\'void\\'?\\'The signal has ended.\\':\\'The swarm awaits the next signal.\\',60);},onNotice:text=>tell(text,4)});if(online){world=online.getWorld();game.live=true;game.o.autoPause=false;game.start({scene:\\'play\\',scenes});}else game.start({scene:\\'title\\',scenes});return game;}\\nRuinApp.booted=boot().catch(e=>{game.fail(\\'boot\\',e);throw e;});\\n})();\\n/* GAME END */\\n\\n\\n\\n', 'pad': 0, 'paused': False}\n","exit_code":0,"status":"completed"}}
