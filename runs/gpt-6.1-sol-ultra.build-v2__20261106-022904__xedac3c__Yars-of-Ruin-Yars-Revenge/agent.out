ue: .7, apply: (g, v) => g.audio.setVolume(v) },\n  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n  background: { group: 'Sound', label: 'Sound in the background', type: 'toggle', value: false, help: 'Keep playing sound while the page is hidden' },\n  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\n  motion: { group: 'Comfort', label: 'Reduce motion', type: 'toggle', value: g => !!g.reduceMotion, help: 'No screen shake, shorter flashes, still menus', apply: (g, v) => { g.reduceMotion = !!v; } },\n  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n  bindings: { group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { g.input.bindings = v; } },\n  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { for (const q of g._players || [g.input]) q.deadzone = v; } },\n  invertY: { group: 'Controller', label: 'Invert aim up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertAimY = !!v; } },\n  invertMoveX: { group: 'Controller', label: 'Invert move left and right', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveX = !!v; } },\n  invertMoveY: { group: 'Controller', label: 'Invert move up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveY = !!v; } },\n  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { for (const q of g._players || [g.input]) q.glyphs = v; } },\n  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { for (const q of g._players || [g.input]) q.rumbleScale = v; } },\n  touch: { group: 'Touch', label: 'Touch buttons', type: 'select', value: 'auto', options: [['auto', 'Automatic'], ['on', 'Always'], ['off', 'Hidden']], apply: g => g.input._touchSync() },\n  hand: { group: 'Touch', label: 'Buttons on', type: 'select', value: 'right', options: [['right', 'Right'], ['left', 'Left']], apply: g => g.input._touchSync() },\n  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\n  touchOpacity: { group: 'Touch', label: 'Button opacity', type: 'slider', value: .8, min: .3, max: 1, step: .05, apply: g => g.input._touchSync() }\n};\n/** a value for a setting, checked: the value kept, or undefined when it can't be one */\nfunction settingValue(sp, v) {\n  if (sp.type === 'toggle') return typeof v === 'boolean' ? v : undefined;\n  if (sp.type === 'fullscreen') return v === true || v === false || v === null ? v : undefined;\n  if (sp.type === 'slider') return typeof v === 'number' && isFinite(v) ? clamp(v, sp.min === undefined ? 0 : sp.min, sp.max === undefined ? 1 : sp.max) : undefined;\n  if (sp.type === 'select') return (sp.options || []).some(o => (Array.isArray(o) ? o[0] : o) === v) ? v : undefined;\n  if (sp.type === 'bindings') {\n    if (!v || typeof v !== 'object' || Array.isArray(v)) return undefined;\n    const out = {};\n    for (const a in v) { const b = v[a]; if (!b || typeof b !== 'object') continue; const o = {}; for (const k of ['keys', 'pad']) if (Array.isArray(b[k])) o[k] = b[k].filter(c => typeof c === 'string' && BINDABLE.test(c) && padCode(c) === (k === 'pad')).slice(0, 4); out[a] = o; }\n    return out;\n  }\n  return v === undefined || typeof v === 'function' ? undefined : v;   // a type of the game's own: any JSON value\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport assert from 'node:assert/strict';\nconst read=f=>fs.readFileSync(new URL('../'+f,import.meta.url),'utf8');\nfunction load(draw=true){\n const c={console:{log(){},info(){},warn(){},error(){}},addEventListener(){},location:{hash:''}};c.window=c;vm.createContext(c);\n for(const f of ['vendor/engine/my-3d2dge.js','src/content.js','src/sim.js','src/presentation/render.js','src/presentation/audio.js'])vm.runInContext(read(f),c,{filename:f});\n c.game=new c.My3D2dge.Game({headless:true,draw,res:[960,540],view:'overhead'});c.game.fadeTime=0;c.visuals=c.RuinRender.create(c.game);c.sound=c.RuinAudio.create(c.game);return c;\n}\nexport async function runTests(){\n const results=[];const check=(name,fn)=>{try{fn();results.push({name,pass:true});}catch(e){results.push({name,pass:false,error:e.stack||String(e)});}};\n check('presentation native drawn headless covers every sector and heart pose',()=>{\n  const c=load(),{game,visuals}=c;let w=c.RuinSim.create({players:2});\n  game.start({update(){game.focus(480,270,0);},draw(r){visuals.draw(r,w,{debug:true});}});\n  for(let sector=0;sector<3;sector++){\n   w=c.RuinSim.create({players:2,sector});\n   w.players[0].ready=true;w.players[0].charge=5;w.players[0].biteFlash=.13;w.players[0].y=4;w.players[1].x=570;w.players[1].y=270;\n   w.shots=[{id:1,x:600,y:250,vx:300,vy:100,owner:0}];\n   w.cannons=[{id:2,x:30,y:230,owner:0,warn:.28},{id:3,x:550,y:330,owner:1,vx:-840,reflected:true,returnWarn:.35}];\n   for(const state of ['dock','windup','flight','return','phase-break','defeated']){w.core.state=state;w.core.vx=-100;w.core.vy=40;w.refuge.warning=state==='windup';w.refuge.active=state!=='flight';game.advance(1/30);}\n   for(const type of ['bite','chip','charge','cannon-fire','reflection','core-hit','death','respawn','sector-clear','victory'])visuals.event({id:`${sector}:${type}`,type,x:810,y:270},w);\n   game.advance(1/30);w.mode='victory';game.advance(1/30);\n  }\n  assert.deepEqual(Array.from(game.errors),[]);c.sound.dispose();visuals.dispose();game.dispose();\n });\n check('presentation drawing and confirmed effects never change authoritative state',()=>{\n  const c=load(),{game,visuals}=c,w=c.RuinSim.create({players:2,sector:2,seed:878});w.core.state='windup';\n  const before=JSON.stringify(w);visuals.event({id:'fixed-event',type:'core-hit',x:810,y:270},w);\n  game.start({update(){game.focus(480,270,0);},draw(r){visuals.draw(r,w,{debug:true});}});game.advance(.25);\n  assert.equal(JSON.stringify(w),before);assert.deepEqual(Array.from(game.errors),[]);visuals.dispose();c.sound.dispose();game.dispose();\n });\n check('presentation enabled and disabled retain identical seeded action trace',()=>{\n  function trace(draw){const c=load(draw),{game,visuals}=c,w=c.RuinSim.create({seed:9213});game.start({update(dt){game.focus(480,270,0);c.RuinSim.step(w,[{mx:1,my:.25,ax:1,ay:.1,fire:true,cannon:false}],dt);for(const e of w.events)visuals.event(e,w);},draw(r){visuals.draw(r,w);}});game.advance(1.8);const result=JSON.stringify(c.RuinSim.snapshot(w));assert.deepEqual(Array.from(game.errors),[]);visuals.dispose();c.sound.dispose();game.dispose();return result;}\n  assert.equal(trace(false),trace(true));\n });\n check('presentation duplicate event IDs cannot duplicate an explosion',()=>{\n  const c=load(),w=c.RuinSim.create(),ev={id:888,type:'core-hit',x:810,y:270};c.visuals.event(ev,w);const count=c.visuals.debug().effects;c.visuals.event(ev,w);assert.equal(c.visuals.debug().effects,count);assert(count>100);c.visuals.dispose();assert.equal(c.visuals.debug().effects,0);c.sound.dispose();c.game.dispose();\n });\n check('audio headless mode does not require Web Audio and disposal is idempotent',()=>{\n  const c=load(false),w=c.RuinSim.create();assert.equal(c.sound.unlock(),false);c.sound.update(.1,w);c.sound.event({id:1,type:'cannon-fire'},w);assert.equal(c.sound.debug().active,0);assert.equal(c.game.audio.ctx,null);c.sound.dispose();c.sound.dispose();c.sound.update(.1,w);assert.equal(c.sound.debug().disposed,true);assert.equal(c.sound.debug().active,0);c.visuals.dispose();c.game.dispose();\n });\n return results;\n}\nif(process.argv[1]===new URL(import.meta.url).pathname){const r=await runTests();for(const x of r)if(!x.pass)console.error(x.name+'\\n'+x.error);console.log(`${r.filter(x=>x.pass).length} passed, ${r.filter(x=>!x.pass).length} failed`);process.exitCode=r.some(x=>!x.pass)?1:0;}\n      const { S } = engine(), w = S.create(options); let blocked = false, hadSwirl = false;\n      for (let t = 0; t < 120 * 140 && !['victory', 'defeat'].includes(w.mode); t++) {\n        if (w.mode === 'transition') S.nextSector(w); S.step(w, [S.pilot(w, 0, { attract: !!options.attract })]);\n        blocked ||= w.events.some(e => e.type === 'static-block'); hadSwirl ||= w.events.some(e => e.type === 'swirl-launch');\n      }\n      assert.equal(w.mode, 'victory'); assert.ok(w.stats.biteCount >= 5); assert.ok(w.stats.airborne > 0); assert.ok(hadSwirl);\n      if (options.attract) { assert.ok(blocked); assert.equal(w.dev.infiniteCharge, false); }\n      traces.push({ ...options, outcome: w.mode, seconds: w.time, stats: w.stats });\n    }\n    fs.writeFileSync(new URL('tests/artifacts/mode-replays.json', root), JSON.stringify(traces, null, 2));\n  });\n  return { passed: results.filter(r => r.ok).length, failed: results.filter(r => !r.ok).length, results };\n}\n\nif (process.argv[1] && fileURLToPath(import.meta.url) === fs.realpathSync(process.argv[1])) {\n  const report = await runTests();\n  for (const r of report.results) if (!r.ok) process.stderr.write('FAIL ' + r.name + '\\n' + r.error + '\\n');\n  process.stdout.write(report.passed + ' passed, ' + report.failed + ' failed\\n');\n  process.exitCode = report.failed ? 1 : 0;\n}\n","exit_code":0,"status":"completed"}}
