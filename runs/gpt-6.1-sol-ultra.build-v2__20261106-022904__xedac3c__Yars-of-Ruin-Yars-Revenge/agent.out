t e of world.events||[])if(e.id>eventCursor){events.push(e);eventCursor=e.id;}\\n      // Keep the snapshot event tail bounded by transport, not particle count.\\n      if(events.length>12)events=events.filter(e=>![\\'shoot\\',\\'chip\\',\\'bite\\'].includes(e.type)).slice(-12);\\n      options.onStep?.(world,world.events||[]);\\n      if(world.mode===\\'transition\\'){\\n        transitionAcc+=1/120;if(transitionAcc>=3){sim.nextSector(world);transitionAcc=0;keyframeDue=true;}\\n      }else transitionAcc=0;\\n      if(world.mode===\\'victory\\'||world.mode===\\'defeat\\')adapter.finish(world.mode===\\'victory\\',world.mode);\\n    }\\n    function pulse(){\\n      if(ended)return;const t=clock();let elapsed=Math.max(0,(t-last)/1000);last=t;\\n      // The 20s host-hidden cancellation belongs to the hub. This clock never\\n      // restarts a void round and advances neither before nor during countdown.\\n      if(!started||!finite(now())||now()<0){acc=0;return;}\\n      netAcc+=elapsed;reliableAcc+=elapsed;\\n      if(finishing&&hub.isHost){\\n        const all=ids.filter(id=>validator.states.has(id));\\n        if(all.every(id=>finishing.acks.has(id))||t>=finishing.deadline){reportFinish();return;}\\n        if(netAcc>=.1){netAcc%=.1;snapshot(true);}return;\\n      }\\n      if(hub.isHost){if(elapsed>20){acc=0;return;}acc+=elapsed;while(acc>=1/120&&!ended&&!adapter.finished){simulateOne();acc-=1/120;}options.onWorld?.(world);if(netAcc>=.1&&!ended){netAcc%=.1;snapshot();}}\\n      else if(netAcc>=.1&&!ended){netAcc%=.1;send(localPacket(),pendingCannon>0&&pendingCannon>(current?.ack?.[info.me]||0)||endAck>0,info.host);inputDirty=false;}\\n    }\\n    function receive(packet,from){\\n      if(ended)return;\\n      if(hub.isHost){if(ids.includes(from)){if(finishing&&packet?.endAck===finishing.id)finishing.acks.add(from);validator.accept(packet,from);}return;}\\n      if(from!==info.host||!packet||packet.k!==\\'w\\'||packet.v!==1||!Number.isInteger(packet.n)||packet.n<=l