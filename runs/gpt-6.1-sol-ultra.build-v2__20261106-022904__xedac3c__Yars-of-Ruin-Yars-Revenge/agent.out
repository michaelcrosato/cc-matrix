core?.state)smoothBody(target.core,display.core);\\n      for(const key of [\\'hazards\\',\\'cannons\\'])for(const body of target[key]||[]){const oldBody=display[key]?.find(x=>x.id===body.id);if(oldBody)smoothBody(body,oldBody);if(key===\\'cannons\\'){body.warn=Math.max(0,(body.warn||0)-age);body.returnWarn=Math.max(0,(body.returnWarn||0)-age);}}\\n      display=clone(target);return display;\\n    }\\n    function reportFinish(){if(!finishing||finishing.reported||ended)return;finishing.reported=true;stats.finishCalls++;const active=ids.filter(id=>validator.states.has(id));const scores=Object.fromEntries(active.map(id=>[id,world.score||0]));hub.finish({standings:[active],scores,won:finishing.won,stats:Object.fromEntries(active.map(id=>[id,{Sectors:world.sector+(world.mode===\\'victory\\'?1:0),Score:world.score||0,Outcome:finishing.reason}]))});}\\n    function finish(won,reason){if(ended||adapter.finished||!hub.isHost)return;adapter.finished=true;world.mode=won?\\'victory\\':\\'defeat\\';world.sessionOutcome={won:!!won,reason};finishing={id:sequence+1,won:!!won,reason,deadline:clock()+2000,acks:new Set(info.server?[]:[info.me]),reported:false};snapshot(true);const active=ids.filter(id=>validator.states.has(id));if(active.every(id=>finishing.acks.has(id))||!started)reportFinish();}\\n    function end(detail){if(ended)return;ended=true;adapter.ended=true;input=zero();pendingCannon=0;acc=0;if(timer!==null)(options.clearInterval||root.clearInterval)(timer);timer=null;options.onEnd?.(detail);}\\n    function leave(detail){const index=ids.indexOf(detail.id);validator.leave(detail.id);if(index>=0&&hub.isHost){sim.command(world,\\'leave\\',index);keyframeDue=true;options.onWorld?.(world);}options.onNotice?.(\\'A scout left the signal. The surviving swarm continues.\\');}\\n    adapter={info:{...info,isHost:hub.isHost},localIndex,active:true,ended:false,finished:false,get world(){return world;},setInput,getWorld:()=>world,renderWorld,finish,end,leave,message:receive,pulse,deb