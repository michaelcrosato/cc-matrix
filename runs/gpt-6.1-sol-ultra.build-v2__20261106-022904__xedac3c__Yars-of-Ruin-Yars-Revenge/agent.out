se;color:#a4bebb}.hud-station{font-family:Georgia,serif;font-size:1.22em;font-weight:normal;color:#eff9dc}.hud-values{display:flex;gap:1.8em;align-items:center;padding-right:4em}.hud-score{font-variant-numeric:tabular-nums;letter-spacing:.06em}.hud-lives{font-size:.6em;letter-spacing:.06em;color:#d4e9b5}.hud-charge{position:absolute;bottom:3vh;left:3.2vw;right:3.2vw;display:flex;justify-content:space-between;align-items:flex-end;gap:2em}.hud-scout{background:#06121bdc;padding:.65em .9em;border-left:3px solid #b5f7da;min-width:12em}.hud-scout.p2{border-color:#edbd78}.hud-scout-label{font-size:.56em;letter-spacing:.12em;text-transform:uppercase;margin-bottom:.5em}.charge-pips{display:flex;gap:4px}.charge-pips i{width:1.1em;height:.22em;background:#213e42;border:1px solid #527775}.charge-pips i.on{background:#ceffc6;border-color:#e5ffdf;box-shadow:0 0 10px #aaffb373}.hud-ready{font-size:.56em;letter-spacing:.08em;margin-top:.6em;color:#d0ee9f}.hud-hint{font-size:.54em;letter-spacing:.055em;text-align:right;color:#b3c9c6;max-width:28em;line-height:1.7;padding:.5em 0}.hud-core{display:flex;gap:5px;margin-top:.3em}.hud-core i{width:1.1em;height:.15em;background:#ff987b}.hud-core i.off{background:#3e3839}#caption{position:fixed;z-index:5;left:50%;bottom:16%;transform:translateX(-50%);max-width:75vw;text-align:center;pointer-events:none;font-size:clamp(15px,1.6vw,30px);color:#eafbd0;line-height:1.4;text-shadow:0 2px 5px #000;background:#06121be8;border:1px solid #65867b;padding:.5em 1em}#demo-mark{position:fixed;top:3vh;left:3vw;z-index:15;color:#d9f4b0;font:bold clamp(18px,2vw,34px) monospace;letter-spacing:.2em}#demo-mark span{display:block;font:normal .45em Trebuchet MS,sans-serif;letter-spacing:.04em;margin-top:.5em}#touch-cannon{position:fixed;z-index:8;right:6vw;bottom:18vh;background:#def5aeed;color:#0b211b;border:2px solid #f1ffd7;border-radius:50%;width:90px;height:90px;font:bold 12px Trebuchet MS;box-shadow:0 0 28px #d6ffa42b;touch-action:none}body[data-playing=\"true\"] .esh{pointer-events:none}body[data-playing=\"true\"] .esh-sh,body[data-playing=\"true\"] .esh-nav{pointer-events:auto}@media(max-width:650px){.esh .esh-ttl{padding:20px 7vw;background:linear-gradient(90deg,#041019f0,#041019a0)}.esh .esh-ttl>div{max-width:85vw}.esh .esh-ttl h1{font-size:66px}.esh .esh-ttl .esh-btns{margin:14px 0;gap:6px}.esh .esh-ttl .esh-tags{font-size:9px}#game-hud .hud-values{padding-right:45px;gap:10px}.hud-station{font-size:1em}.hud-charge{bottom:calc(2vh + env(safe-area-inset-bottom));gap:5px}.hud-scout{min-width:0;padding:.5em .6em}.hud-hint{display:none}#caption{max-width:90vw;width:max-content;bottom:25%;font-size:14px}.esh .esh-mod{max-height:85vh}#touch-cannon{bottom:10vh}}@media(orientation:portrait){#game-hud .hud-top{padding-top:12vh}.hud-charge{bottom:10vh}.esh .esh-ttl h1{font-size:64px}.esh .esh-ttl .esh-m{font-size:9px}.esh .esh-ttl p{font-size:13px}#caption{bottom:28%}#demo-mark{top:9vh}#touch-cannon{bottom:18vh}}\n[hidden]{display:none!important}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
