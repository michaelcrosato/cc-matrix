er signal',text:'Select a cell with the sliders and place or remove it. A pointer paints directly. Changes are validated before flight.',rows:defs.map(d=>d.key),actions:[['Place cell',()=>paint(S.editX*20,S.editY*20)],['Remove cell',()=>paint(S.editX*20,S.editY*20,true)],['Preview encounter',()=>{const v=check(normalized());if(\"'!v.ok){status=v.errors.join('\"' ');draw();return;}api.load(v.content);ui.hide();game.resume();}],['JSON import / export',jsonScreen],['Save preset',()=>{const c=normalized(),v=check(c);if(v.ok){My3D2dge.store.set('ruin:encounter',v.content);status='Preset saved on this device.';}else status=v.errors.join(' ');draw();}],['Load preset',()=>{const c=My3D2dge.store.get('ruin:encounter',null),v=check(c);if(v.ok){content=v.content;status='Saved preset loaded.';show();}else{status='No valid saved preset. '+v.errors.join(' ');draw();}}],['Back',()=>ui.back()]]});attach();}\n function jsonScreen(){let text=JSON.stringify(normalized(),null,2);ui.show('editor-json',{kicker:'Encounter data · version 1',title:'Carry the signal',text:'Export is self contained JSON. Import rejects invalid geometry, missing plate references and unsafe values.',actions:[['Import text',()=>{const el=ui.root.querySelector('textarea');try{const v=check(JSON.parse(el.value));if(\"'!v.ok)throw new Error(v.errors.join('\"' '));content=v.content;status='Imported encounter is ready to preview.';ui.back();show();}catch(e){const st=ui.root.querySelector('.editor-status');if(st)st.textContent=e.message;}}],['Download JSON',()=>{const blob=new Blob([ui.root.querySelector('textarea').value],{type:'application/json'}),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='yars-of-ruin-encounter.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);}],['Back',()=>{ui.back();show();}]]});if(ui.root){const box=ui.root.querySelector('.esh-mod'),ta=document.createElement('textarea');ta.className='ruin-json';ta.setAttribute('aria-label','Encounter JSON');ta.value