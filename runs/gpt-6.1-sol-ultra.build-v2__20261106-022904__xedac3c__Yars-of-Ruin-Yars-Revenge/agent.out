{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > Yars-of-Ruin-Yars-Revenge-gpt-6.1-sol-ultra-20261106-022904/tests/browser.py <<'EOF'\nimport json, pathlib, sys, traceback\nfrom playwright.sync_api import sync_playwright\nROOT=pathlib.Path(__file__).resolve().parents[1]\nART=ROOT/'tests/artifacts';ART.mkdir(exist_ok=True)\nURL=(ROOT.parent/(ROOT.name+'.html')).as_uri()\nresults=[]\ndef check(name,fn):\n    try:\n        value=fn()\n        if value is False: raise AssertionError('Assertion returned false')\n        results.append({'name':name,'pass':True})\n    except Exception as e:results.append({'name':name,'pass':False,'error':str(e)})\ndef ev(js):return page.evaluate(js)\ndef advance(n=.05):return ev(f'__game.advance({n}); __game.debug.snapshot()')\ndef boot(p):\n    p.goto(URL);p.wait_for_function('globalThis.RuinApp && __game.sceneName === \\\"title\\\"');p.evaluate('__game.stop()')\nwith sync_playwright() as pw:\n    browser=pw.chromium.launch(headless=True)\n    context=browser.new_context(viewport={'width':1920,'height':1080})\n    page=context.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n    boot(page)\n    check('single-file file:// boot and first-run 10% music',lambda:ev('__game.settings.music === .1 && __game.errors.length===0 && document.title === \\\"Yars of Ruin\\\"'))\n    check('TV title every action visible',lambda:page.get_by_role('button',name='About / Credits',exact=True).evaluate('(e)=>{const r=e.getBoundingClientRect();return r.top>=0&&r.bottom<=innerHeight;}'))\n    page.screenshot(path=str(ART/'title-tv.png'))\n    page.get_by_role('button',name='Begin the siege  →',exact=True).click();page.get_by_role('button',name='Normal',exact=True).click();advance(.1)\n    check('normal campaign starts via actual menu clicks',lambda:ev('__game.sceneName===\\\"play\\\" && RuinApp.world.mode===\\\"play\\\" && \"'!RuinApp.world.assist && !RuinApp.world.practice'\"'))\n    ev('RuinApp.world.players[0].invuln=10')\n    x=ev('RuinApp.world.players[0].x');page.keyboard.down('d');advance(.25);page.keyboard.up('d');advance()\n    check('WASD movement feeds real simulation',lambda:ev('RuinApp.world.players[0].x')>x+30)\n    page.mouse.move(1800,540);advance();page.mouse.down();advance(.2);page.mouse.up();advance()\n    check('mouse aim and held primary fire',lambda:ev('RuinApp.world.stats.shots>0 && RuinApp.world.players[0].ax>.8'))\n    page.keyboard.press('Escape');advance()\n    check('Escape reaches native pause menu',lambda:ev('__game.paused') and page.get_by_role('dialog',name='Fold your wings').count()==1)\n    page.get_by_role('button',name='Developer tools',exact=True).click();\n    check('developer tools marks practice and exposes live tuning',lambda:ev('RuinApp.world.practice') and page.get_by_role('button',name='Live balance sliders',exact=True).count()==1)\n    page.get_by_role('button',name='Live balance sliders',exact=True).click()\n    slider=page.get_by_role('slider',name='Scout speed',exact=True);slider.fill('300');slider.dispatch_event('input');advance()\n    check('live slider applies on fixed step',lambda:ev('RuinApp.world.pendingTuning.scoutSpeed===300 || RuinApp.world.tuning.scoutSpeed===300'))\n    page.get_by_role('button',name='Reset to Defaults',exact=True).click();advance();check('balance reset restores default',lambda:ev('RuinApp.world.pendingTuning.scoutSpeed===RuinContent.defaults.scoutSpeed || RuinApp.world.tuning.scoutSpeed===RuinContent.defaults.scoutSpeed'))\n    page.get_by_role('button',name='Back',exact=True).click()\n    page.get_by_role('button',name='Advance one tick',exact=True).click();tick=ev('RuinApp.world.tick');advance(.01)\n    check('one-tick advance works while paused',lambda:ev('RuinApp.world.tick')==tick+1)\n    page.get_by_role('button',name='Shield-layout editor',exact=True).click();\n    check('controller-operable editor has valid export',lambda:ev('RuinSim.validateContent(RuinApp.ga