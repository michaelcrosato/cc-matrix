{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"rg -n 'advance\\\\(seconds|advance\\\\(s|advance\\\\(' Yars-*/vendor/engine/my-3d2dge.js | head -10 && sed -n '2760,2805p' Yars-*/vendor/engine/my-3d2dge.js && sed -n '202,217p' Yars-*/src/presentation/render.js\"","aggregated_output":"59: * 11. TESTS. new E.Game({ headless: true }) (the default in Node) runs with no screen: game.advance(1) runs 120 fixed\n2319:   *   scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\n2321:   * - loop: false makes a game in a page that runs only by advance()\n2713:   * by advance().\n2838:   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\n2842:  advance(seconds = this.o.step, o = {}) {\n2843:    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n10870:pc.act('pickup', 'key'); game.advance(8);\n11451:for (let s = 0; s < 300 && m.phase !== 'over'; s++) game.advance(1);\n13162:  game.advance(1 / 120); const s = game.audio.pos.step;\n        n++;\n        try { this._frame(); } catch (e) { this.fail('draw', e); try { this.screen._present(); } catch (e2) { /* nothing to show */ } }\n        const st = this.stats, t2 = performance.now(); st.updateMs = t1 - t0; st.renderMs = t2 - t1; st.frameMs = since * 1000; st.steps = steps;\n        // a display at 90 Hz and up that the frames won't fit: every other refresh, back to each once they fit again. Two\n        // signs they won't: a frame's own cost, and refreshes missed between frames drawn at each (the GPU behind, which no\n        // clock here sees: that one holds 3 s, then 6, 12... up to a minute, before each refresh is tried again; 3 s again\n        // after 10 s drawn at each)\n        cost += ((t2 - t0) / 1000 - cost) * .1;\n        if (this.drawEvery === 1) miss += ((since > per * 1.5 ? 1 : 0) - miss) * .05;\n        since = 0;\n        // the player's Frame rate (Settings, Display): Full draws every refresh, 60 every other one at 100 Hz and up (a\n        // game made with pace: false draws every refresh unless the player picked 60)\n        let e = this.drawEvery; const fr = this.settings.frameRate;\n        if (fr === 'full' || (this.o.pace === false && fr !== '60') || per > 1 / 85) e = 1;\n        else if (fr === '60') e = per < 1 / 95 ? 2 : 1;\n        else if (cost > per * .8) e = 2;\n        else if (miss > .2) { if (now - full > 1e4) back = 3; e = 2; miss = 0; hold = now + back * 1000; back = Math.min(60, back * 2); }\n        else if (cost < per * .55 && now >= hold) e = 1;\n        if (e < this.drawEvery) full = now;\n        this.drawEvery = e;\n      }\n      acc += raw; if (acc > .5) { this.fps = Math.round(n / acc); this.hz = Math.round(1 / per); acc = 0; n = 0; }   // real time: a slow device reads slow\n    };\n    this._raf = requestAnimationFrame(frame);\n    return this;\n  }\n  /** run the boot (section 10c), then start: the system's checks on the screen, the game's steps one a frame (or all at\n   *  once, headless or with loop: false), waiting for a step's promise, then the loop under the screen until it has drawn */\n  _boot(hooks) {\n    const o = hooks.boot || {}, h = Object.assign({}, hooks); delete h.boot;\n    this._booting = true; this._bootOpt = o;\n    const live = !this.headless && this.o.loop !== false && hooks.boot !== false && typeof document !== 'undefined';\n    const steps = (Array.isArray(o.steps) ? o.steps : []).filter(Boolean).map(x => Array.isArray(x) ? x : [x.label || 'Getting ready', x.run]);\n    if (hooks.boot === false) { BOOT.played = true; const el = typeof document !== 'undefined' && document.getElementById('e3-boot'); if (el) { el.hidden = true; el.style.display = 'none'; } BOOT.el = null; return this.start(h); }\n    let res; this.booted = new Promise(r => { res = r; });\n    if (live) { BOOT._open(this, o); BOOT._checks(this); }\n    const now = () => typeof performance !== 'undefined' ? performance.now() : 0, t0 = now(), n = steps.length;   // (no clock in a bare Node context)\n    let i = 0;\n    const fail = (label, e) => { this._booting = false; this.bootError = e; this.fail('boot step \"' + label + '\"', e); BOOT.fail('boot step \"' + label + '\"', e); res(this); };\n    const next = () => {\n      if (this.disposed) return;\n      while (i < n) {\n        const [label, fn] = steps[i++], s0 = now();\n        if (live) BOOT._step(i, n, label);\n        let r; try { r = typeof fn === 'function' ? fn(this) : null; } catch (e) { fail(label, e); return; }\n        const ok = () => { if (live) BOOT._line('  ' + (i + '. ').padEnd(4), label + ' · ' + Math.round(now() - s0) + ' ms'); };\n  }});\n }\n function survivors(r,w,T,t){\n  if(w.mode!=='victory')return;\n  r.overlay(g=>{for(let i=0;i<38;i++){const x=480+Math.sin(i*3.31+t*.15)*410,y=270+Math.cos(i*1.73+t*.21)*210,s=.18+hash(i)*.24;px.blend(g,.25+hash(i*47)*.55,'normal',()=>insect(g,x,y,t+i,{index:i%2,ax:-1,ay:.3*Math.sin(t+i),vx:-70,vy:0,ready:true},s));}});\n }\n function draw(r,w,opts={}){\n  if(disposed||!w)return;lastOpts=opts;const T=PAL[w.sector]||PAL[0],t=Number.isFinite(w.time)?w.time:now();\n  if(lastSector!==w.sector){lastSector=w.sector;fx=fx.filter(f=>now()-f.born<f.life);}\n  backdrop(r,w,T,t);refuge(r,w,T,t);station(r,w,T,t);rail(r,w,T,t);shield(r,w,T,t);core(r,w,T,t);bullets(r,w,T,t);threats(r,w,T,t);scouts(r,w,T,t,opts);effects(r,w,T,t,opts);survivors(r,w,T,t);\n  if(opts.debug)r.overlay(g=>{for(const c of w.cells||[])if(c.alive){const[x,y]=r.w(c.x,c.y);px.line(g,x-10,y-10,x+10,y-10,'#ffffff',1);}for(const b of w.cannons||[]){const[x,y]=r.w(b.x,b.y);ring(g,x,y,b.r||7,1,'#ffffff',24);}});\n }\n return{draw,event,dispose(){disposed=true;fx=[];seen.clear();},debug:()=>({effects:fx.length,seen:seen.size,disposed})};\n}\nroot.RuinRender={create,palettes:PAL,insect};\n})();\n","exit_code":0,"status":"completed"}}
