{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"ls Yars-*/tests && cat Yars-*/tests/online.test.mjs | head -65 && tail -35 Yars-*/tests/online.test.mjs && rg -n 'function (step|snapshot|command|pilot|validateContent)|globalThis.RuinSim' Yars-*/src/sim.js\"","aggregated_output":"artifacts\nonline.test.mjs\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport assert from 'node:assert/strict';\nconst source=fs.readFileSync(new URL('../src/online/hub.js',import.meta.url),'utf8');\nfunction load(){const c=vm.createContext({TextEncoder,setInterval,clearInterval,performance});vm.runInContext(source,c);return c.RuinOnline;}\nfunction fixture({server=false,host=true,ids=[0,1]}={}){\n let ms=0,time=-Infinity,callback=null,ended=false;const handlers={},sent=[],outcomes=[];\n const hub={active:true,isHost:host,me:server?99:host?0:1,host:server?99:0,server,players:ids.map(id=>({id,name:'Scout '+id,color:id?'#00f':'#f00'})),seed:123,\n  on(type,fn){(handlers[type]??=[]).push(fn);return ()=>{};},emit(type,...args){for(const fn of handlers[type]||[])fn(...args);},\n  async connect(){return {...this};},rng(){return ()=>.123456;},ready(){this.isReady=true;},time(){return time;},send(data,opts){if(ended)throw Error('send after end');sent.push({data:JSON.parse(JSON.stringify(data)),opts});return this.acceptSends!==false;},finish(result){outcomes.push(result);}};\n const make=()=>({tick:0,time:0,seed:123,sector:0,mode:'play',phase:0,phaseTime:0,reserves:4,score:0,players:ids.map(id=>({id,x:100,y:270,vx:0,vy:0,ax:1,ay:0,alive:true,invuln:0,charge:0})),cells:[{id:1,x:670,y:200,baseX:670,baseY:200,plate:0,material:'normal',size:20,alive:true}],shots:[],cannons:[],hazards:[],core:{x:810,y:270,hp:1,state:'dock'},refuge:{x:355,w:100,active:true},events:[],tuning:{scoutSpeed:250},stats:{},tutorial:0,message:''});\n const sim={create:make,step(w,actions,dt){w.tick++;w.time+=dt;w.phaseTime+=dt;w.events=[];w.players.forEach((p,i)=>{p.x+=(actions[i]?.mx||0)*250*dt;if(actions[i]?.cannon){w.cannons.push({id:w.tick,x:30,y:p.y,owner:i,warn:.28});w.score++;}});},nextSector(w){w.sector++;w.mode='play';},command(w,name,i){if(name==='leave'){w.players[i].departed=true;w.players[i].alive=false;w.players[i].respawn=0;}}};\n const opts={hub,sim,clock:()=>ms,setInterval(fn){callback=fn;return 1;},clearInterval(){callback=null;},onEnd(){ended=true;}};\n return {hub,sim,opts,sent,outcomes,async connect(){return load().connect(opts);},advance(dt=100){ms+=dt;if(Number.isFinite(time))time+=dt;callback?.();},start(countdown=0){time=-countdown;hub.emit('start',{in:countdown});},setTime(t){time=t;},get time(){return time;}};\n}\nexport async function runTests(){\n const results=[];const check=async(name,fn)=>{try{await fn();results.push({name,pass:true});}catch(e){results.push({name,pass:false,error:e.stack||String(e)});}};\n await check('online validator rejects authority forgery, impossible vectors and stale membership',()=>{const o=load(),v=o.createValidator([0],()=>100);const valid=o.encodeInput({mx:1,my:0,ax:1,ay:0,fire:true},1,0,100);assert(v.accept(valid,0));assert(!v.accept({...valid,q:2,a:[999,0,0,0,0]},0));assert(!v.accept({...valid,q:2},9));assert(!v.accept({...valid,q:2,at:-20000},0));assert(!v.accept({k:'grant-charge',q:2,a:[0,0,1,0,0],c:1,at:100},0));});\n await check('online cannon repetition is acknowledged and deduplicated exactly once',()=>{const o=load(),v=o.createValidator([0],()=>0);assert(v.accept(o.encodeInput({},1,1,0),0));assert.equal(v.action(0).cannon,true);assert(v.accept(o.encodeInput({},2,1,0),0));assert.equal(v.action(0).cannon,false);assert.equal(v.ack()[0],1);});\n await check('online stale held input releases automatically',()=>{const o=load();let t=0;const v=o.createValidator([0],()=>t);v.accept(o.encodeInput({mx:1,fire:true},1,0,0),0);t=1000;assert.equal(v.action(0).mx,0);assert.equal(v.action(0).fire,false);});\n await check('online world waits for synchronized start and negative countdown',async()=>{const f=fixture();const a=await f.connect();assert(f.hub.isReady);f.advance(500);assert.equal(a.world.tick,0);f.start(3000);f.advance(100);assert.equal(a.world.tick,0);f.setTime(0);f.advance(100);assert(a.world.tick>0);a.dispose();});\n await check('online host-local actions use authority validation without echo',async()=>{const f=fixture();const a=await f.connect();f.start();a.setInput({mx:1,ax:1});f.advance(100);assert(a.world.players[0].x>100);assert.equal(a.world.players[1].x,100);a.dispose();});\n await check('online server host has no avatar and ticks without rendering',async()=>{const f=fixture({server:true});const a=await f.connect();assert.equal(a.localIndex,-1);assert.equal(a.world.players.length,2);f.start();f.advance(100);assert(a.world.tick>0);a.setInput({mx:1,cannon:true});assert.equal(a.world.players.length,2);f.hub.emit('time-up',{graceMs:1000});assert.equal(f.outcomes.length,1);assert.equal(JSON.stringify(f.outcomes[0].standings),'[[0,1]]');a.dispose();});\n await check('online time-up during transition reports one cooperative result',async()=>{const f=fixture();const a=await f.connect();a.world.mode='transition';f.hub.emit('time-up',{graceMs:1000});f.hub.emit('time-up',{graceMs:1000});assert.equal(f.outcomes.length,1);assert.equal(f.outcomes[0].won,false);a.dispose();});\n await check('online non-host leave removes pending body and standings member',async()=>{const f=fixture();const a=await f.connect();a.world.players[1].respawn=2;f.hub.emit('leave',{id:1});assert(a.world.players[1].departed);assert.equal(a.world.players[1].respawn,0);f.hub.emit('time-up',{});assert.equal(JSON.stringify(f.outcomes[0].standings),'[[0]]');a.dispose();});\n await check('online end stops simulation, sends, action and finish',async()=>{const f=fixture();const a=await f.connect();f.start();f.advance();const tick=a.world.tick,sends=f.sent.length;f.hub.emit('end',{reason:'host-left'});a.setInput({mx:1,cannon:true});f.advance(1000);a.finish(false,'test');assert.equal(a.world.tick,tick);assert.equal(f.sent.length,sends);assert.equal(f.outcomes.length,0);assert(a.ended);});\n await check('online compact state round trip preserves holes and topology',()=>{const o=load(),f=fixture(),w=f.sim.create();w.cells[0].alive=false;const packet=o.pack(w,5,{0:1},[],true);const copy=o.unpack(packet,f.sim,null,{seed:123});assert.equal(copy.cells[0].alive,false);assert.equal(copy.cells[0].x,670);assert.equal(copy.players[0].x,w.players[0].x);assert.equal(packet.n,5);assert(JSON.stringify(packet).length<16384);});\n await check('online client rejects stale and non-host snapshots',async()=>{const f=fixture({host:false}),a=await f.connect();const o=load(),w=f.sim.create();w.tick=50;const packet=o.pack(w,5,{},[],true);f.hub.emit('message',packet,0);assert.equal(a.world.tick,50);w.tick=10;f.hub.emit('message',o.pack(w,4,{},[],true),0);assert.equal(a.world.tick,50);f.hub.emit('message',o.pack(w,6,{},[],true),7);assert.equal(a.world.tick,50);assert.equal(a.debug.rejectedSnapshots,2);a.dispose();});\n await check('online false send retries keyframe and reliable cannon until acknowledged',async()=>{const f=fixture({host:false}),a=await f.connect();f.start();f.hub.acceptSends=false;a.setInput({cannon:true});f.advance(100);f.hub.acceptSends=true;f.advance(100);assert(f.sent.length>=2);assert.equal(f.sent[0].data.c,1);assert.equal(f.sent[1].data.c,1);assert(f.sent[1].opts.reliable);a.dispose();});\n return results;\n}\nif(process.argv[1]===new URL(import.meta.url).pathname){const r=await runTests();for(const x of r)if(!x.pass)console.error(x.name+'\\n'+x.error);console.log(`${r.filter(x=>x.pass).length} passed, ${r.filter(x=>!x.pass).length} failed`);process.exitCode=r.some(x=>!x.pass)?1:0;}\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport assert from 'node:assert/strict';\nconst source=fs.readFileSync(new URL('../src/online/hub.js',import.meta.url),'utf8');\nfunction load(){const c=vm.createContext({TextEncoder,setInterval,clearInterval,performance});vm.runInContext(source,c);return c.RuinOnline;}\nfunction fixture({server=false,host=true,ids=[0,1]}={}){\n let ms=0,time=-Infinity,callback=null,ended=false;const handlers={},sent=[],outcomes=[];\n const hub={active:true,isHost:host,me:server?99:host?0:1,host:server?99:0,server,players:ids.map(id=>({id,name:'Scout '+id,color:id?'#00f':'#f00'})),seed:123,\n  on(type,fn){(handlers[type]??=[]).push(fn);return ()=>{};},emit(type,...args){for(const fn of handlers[type]||[])fn(...args);},\n  async connect(){return {...this};},rng(){return ()=>.123456;},ready(){this.isReady=true;},time(){return time;},send(data,opts){if(ended)throw Error('send after end');sent.push({data:JSON.parse(JSON.stringify(data)),opts});return this.acceptSends!==false;},finish(result){outcomes.push(result);}};\n const make=()=>({tick:0,time:0,seed:123,sector:0,mode:'play',phase:0,phaseTime:0,reserves:4,score:0,players:ids.map(id=>({id,x:100,y:270,vx:0,vy:0,ax:1,ay:0,alive:true,invuln:0,charge:0})),cells:[{id:1,x:670,y:200,baseX:670,baseY:200,plate:0,material:'normal',size:20,alive:true}],shots:[],cannons:[],hazards:[],core:{x:810,y:270,hp:1,state:'dock'},refuge:{x:355,w:100,active:true},events:[],tuning:{scoutSpeed:250},stats:{},tutorial:0,message:''});\n const sim={create:make,step(w,actions,dt){w.tick++;w.time+=dt;w.phaseTime+=dt;w.events=[];w.players.forEach((p,i)=>{p.x+=(actions[i]?.mx||0)*250*dt;if(actions[i]?.cannon){w.cannons.push({id:w.tick,x:30,y:p.y,owner:i,warn:.28});w.score++;}});},nextSector(w){w.sector++;w.mode='play';},command(w,name,i){if(name==='leave'){w.players[i].departed=true;w.players[i].alive=false;w.players[i].respawn=0;}}};\n const opts={hub,sim,clock:()=>ms,setInterval(fn){callback=fn;return 1;},clearInterval(){callback=null;},onEnd(){ended=true;}};\n return {hub,sim,opts,sent,outcomes,async connect(){return load().connect(opts);},advance(dt=100){ms+=dt;if(Number.isFinite(time))time+=dt;callback?.();},start(countdown=0){time=-countdown;hub.emit('start',{in:countdown});},setTime(t){time=t;},get time(){return time;}};\n}\nexport async function runTests(){\n const results=[];const check=async(name,fn)=>{try{await fn();results.push({name,pass:true});}catch(e){results.push({name,pass:false,error:e.stack||String(e)});}};\n await check('online validator rejects authority forgery, impossible vectors and stale membership',()=>{const o=load(),v=o.createValidator([0],()=>100);const valid=o.encodeInput({mx:1,my:0,ax:1,ay:0,fire:true},1,0,100);assert(v.accept(valid,0));assert(!v.accept({...valid,q:2,a:[999,0,0,0,0]},0));assert(!v.accept({...valid,q:2},9));assert(!v.accept({...valid,q:2,at:-20000},0));assert(!v.accept({k:'grant-charge',q:2,a:[0,0,1,0,0],c:1,at:100},0));});\n await check('online cannon repetition is acknowledged and deduplicated exactly once',()=>{const o=load(),v=o.createValidator([0],()=>0);assert(v.accept(o.encodeInput({},1,1,0),0));assert.equal(v.action(0).cannon,true);assert(v.accept(o.encodeInput({},2,1,0),0));assert.equal(v.action(0).cannon,false);assert.equal(v.ack()[0],1);});\n await check('online stale held input releases automatically',()=>{const o=load();let t=0;const v=o.createValidator([0],()=>t);v.accept(o.encodeInput({mx:1,fire:true},1,0,0),0);t=1000;assert.equal(v.action(0).mx,0);assert.equal(v.action(0).fire,false);});\n await check('online world waits for synchronized start and negative countdown',async()=>{const f=fixture();const a=await f.connect();assert(f.hub.isReady);f.advance(500);assert.equal(a.world.tick,0);f.start(3000);f.advance(100);assert.equal(a.world.tick,0);f.setTime(0);f.advance(100);assert(a.world.tick>0);a.dispose();});\n await check('online host-local actions use authority validation without echo',async()=>{const f=fixture();const a=await f.connect();f.start();a.setInput({mx:1,ax:1});f.advance(100);assert(a.world.players[0].x>100);assert.equal(a.world.players[1].x,100);a.dispose();});\n await check('online server host has no avatar and ticks without rendering',async()=>{const f=fixture({server:true});const a=await f.connect();assert.equal(a.localIndex,-1);assert.equal(a.world.players.length,2);f.start();f.advance(100);assert(a.world.tick>0);a.setInput({mx:1,cannon:true});assert.equal(a.world.players.length,2);f.hub.emit('time-up',{graceMs:1000});assert.equal(f.outcomes.length,1);assert.equal(JSON.stringify(f.outcomes[0].standings),'[[0,1]]');a.dispose();});\n await check('online time-up during transition reports one cooperative result',async()=>{const f=fixture();const a=await f.connect();a.world.mode='transition';f.hub.emit('time-up',{graceMs:1000});f.hub.emit('time-up',{graceMs:1000});assert.equal(f.outcomes.length,1);assert.equal(f.outcomes[0].won,false);a.dispose();});\n await check('online non-host leave removes pending body and standings member',async()=>{const f=fixture();const a=await f.connect();a.world.players[1].respawn=2;f.hub.emit('leave',{id:1});assert(a.world.players[1].departed);assert.equal(a.world.players[1].respawn,0);f.hub.emit('time-up',{});assert.equal(JSON.stringify(f.outcomes[0].standings),'[[0]]');a.dispose();});\n await check('online end stops simulation, sends, action and finish',async()=>{const f=fixture();const a=await f.connect();f.start();f.advance();const tick=a.world.tick,sends=f.sent.length;f.hub.emit('end',{reason:'host-left'});a.setInput({mx:1,cannon:true});f.advance(1000);a.finish(false,'test');assert.equal(a.world.tick,tick);assert.equal(f.sent.length,sends);assert.equal(f.outcomes.length,0);assert(a.ended);});\n await check('online compact state round trip preserves holes and topology',()=>{const o=load(),f=fixture(),w=f.sim.create();w.cells[0].alive=false;const packet=o.pack(w,5,{0:1},[],true);const copy=o.unpack(packet,f.sim,null,{seed:123});assert.equal(copy.cells[0].alive,false);assert.equal(copy.cells[0].x,670);assert.equal(copy.players[0].x,w.players[0].x);assert.equal(packet.n,5);assert(JSON.stringify(packet).length<16384);});\n await check('online client rejects stale and non-host snapshots',async()=>{const f=fixture({host:false}),a=await f.connect();const o=load(),w=f.sim.create();w.tick=50;const packet=o.pack(w,5,{},[],true);f.hub.emit('message',packet,0);assert.equal(a.world.tick,50);w.tick=10;f.hub.emit('message',o.pack(w,4,{},[],true),0);assert.equal(a.world.tick,50);f.hub.emit('message',o.pack(w,6,{},[],true),7);assert.equal(a.world.tick,50);assert.equal(a.debug.rejectedSnapshots,2);a.dispose();});\n await check('online false send retries keyframe and reliable cannon until acknowledged',async()=>{const f=fixture({host:false}),a=await f.connect();f.start();f.hub.acceptSends=false;a.setInput({cannon:true});f.advance(100);f.hub.acceptSends=true;f.advance(100);assert(f.sent.length>=2);assert.equal(f.sent[0].data.c,1);assert.equal(f.sent[1].data.c,1);assert(f.sent[1].opts.reliable);a.dispose();});\n return results;\n}\nif(process.argv[1]===new URL(import.meta.url).pathname){const r=await runTests();for(const x of r)if(!x.pass)console.error(x.name+'\\n'+x.error);console.log(`${r.filter(x=>x.pass).length} passed, ${r.filter(x=>!x.pass).length} failed`);process.exitCode=r.some(x=>!x.pass)?1:0;}\n380:  function step(w, actions = [], dt = DT) {\n404:  function command(w, name, value) {\n427:  function snapshot(w) {\n433:  function validateContent(data) {\n471:  function pilot(w, index = 0, options = {}) {\n547:  globalThis.RuinSim = { W, H, DT, create, step, snapshot, nextSector, tune, command, pilot, validateContent, exportContent, cellPosition: (_w, c) => ({ x: c.x, y: c.y }), isStatic, wrappedDy: dy, wra [... omitted end of long line]\n","exit_code":0,"status":"completed"}}
