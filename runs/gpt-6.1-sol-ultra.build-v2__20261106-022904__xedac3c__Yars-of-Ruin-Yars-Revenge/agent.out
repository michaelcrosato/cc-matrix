92:   game.lights.add(p.x,p.y,10,64,p.ready?.5:.3,{color:PLAYER[(p.index||0)%2]});\n193:   if(opts.debug){const[x,y]=r.w(p.x,p.y);ring(r.ctx,x,y,9,1,'#ffffff',24);px.line(r.ctx,x-3,y,x+3,y,'#ffffff');px.line(r.ctx,x,y-3,x,y+3,'#ffffff');}\n209:  if(disposed||!w)return;lastOpts=opts;const T=PAL[w.sector]||PAL[0],t=Number.isFinite(w.time)?w.time:now();\n214: return{draw,event,dispose(){disposed=true;fx=[];seen.clear();},debug:()=>({effects:fx.length,seen:seen.size,disposed})};\n","exit_code":0,"status":"completed"}}
