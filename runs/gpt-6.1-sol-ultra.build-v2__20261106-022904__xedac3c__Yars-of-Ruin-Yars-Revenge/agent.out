ge)+' / '+t}</div></div>\"'`;});H.innerHTML=`<div class=\"hud-top\"><div class=\"hud-sector\"><span class=\"hud-overline\">${world.practice?'\"'PRACTICE · ':world.assist?'ASSIST · ':''}SIGNAL \"'${String(world.sector+1).padStart(2,'\"'0')} / 03</span><span class=\\\"hud-station\\\"></span><div class=\\\"hud-core\\\">\"'${Array.from({length:world.core.maxHp},(_,i)=>`<i class=\"${i<world.core.hp?'\"'':'off'}\\\"></i>\"'`).join('\"'')}</div></div><div class=\\\"hud-values\\\"><div class=\\\"hud-score\\\">\"'${String(world.score).padStart(7,'\"'0')}</div><div class=\\\"hud-lives\\\">RESERVE<br>\"'${'\"'◆ '.repeat(Math.max(0,Math.min(8,world.reserves)))||'EMPTY'}</div></div></div><div class=\\\"hud-charge\\\">\"'${slots.join('\"'')}<div class=\\\"hud-hint\\\">\"'${glyph()?'\"'LEFT STICK':'WASD'} FLY · \"'${controls.label('\"'fire')} SHOOT<br>CONTACT BITES · TOP / BOTTOM WRAP</div></div>\"'`;H.querySelector('\"'.hud-station').textContent=sectorName(world.sector);H.querySelectorAll('.scout-name').forEach((el,i)=>el.textContent=embedded&&online?.info?.players?.[i]?.name||['VESPER','CIRRUS'][i]);}\nfunction tick(dt){game.focus(480,270,0);if(\"'!world)return;applyDev();if(online){world=online.getWorld()||world;if(!onlineEnded)online.setInput(controls.frames({ ...world,players:[world.players[online.localIndex]||world.players[0]]})[0]||zero);}else if(attract){if(world.mode==='\"'transition')SIM.nextSector(world);if(['victory','defeat'].includes(world.mode)){world=SIM.create({players:1,seed:9182,attract:true});lastMode='';}else SIM.step(world,world.players.map((p,i)=>SIM.pilot(world,i,{attract:true})),dt);fx(world);}else if(world.mode==='play'&&\"'!frozen){SIM.step(world,controls.frames(world),dt*speed);fx(world);}modeChanged();sound.update(dt,world,{paused:game.paused||!!ui.screen,silent:onlineEnded});hud();if($('\"'caption')&&game.real>=captionUntil)\"'$('\"'caption').hidden=true;}\nfunction draw(r){if(world)visuals.draw(r,world,{title:game.sceneName==='title',debug:\"'!!world.dev?.collisions||!!world.collisions,reducedFlash:!!game.settings.flashes===false,reducedShake:!game.settings.shake});}\nui=new E.Shell(game,{tv:true,theme:{accent:'\"'#d9f1a6',paper:'#0c1820',ink:'#eff8e6',muted:'#a9bcbc',line:'#3a5557',font:'Trebuchet MS, Arial, sans-serif',titleFont:'Georgia, serif'},screens:{pause:{kicker:'Transmission held',title:'Fold your wings'},help:{title:'How to Play'} }});\nvisuals=RuinRender.create(game);sound=RuinAudio.create(game);\ncontrols=RuinControls.create(game,{onActivity:()=>{idleAt=game.real;if(attract){fromAttract=true;attract=false;game.go('title',null,{fade:0});return true;}return false;},onGesture:()=>sound.unlock(),isPlaying:()=>game.sceneName==='play'&&world?.mode==='play'&&\"'!attract,isBlocked:()=>!!ui.screen||game.paused||onlineEnded,getWorld:()=>world,localIndex:()=>online?.localIndex||0});\neditor=RuinEditor.create(game,ui,{world:()=>world,load:c=>{SIM.command(world,'\"'content',c);lastMode='';lastSector=-1;setPlaying(true);}});\nfor(const [k,r]of Object.entries(C.ranges))game.settings.define({key:'dev_'+k,label:r.label,min:r.min,max:r.max,step:r.step,unit:r.unit,value:C.defaults[k],group:'Controls'});\nfor(const k of ['invulnerable','infiniteCharge','collisions'])game.settings.define({key:'dev_'+k,label:{invulnerable:'Invulnerability',infiniteCharge:'Infinite charge',collisions:'Collision / warning overlay'}[k],value:false,group:'Controls'});\ngame.settings.define({key:'dev_timeScale',label:'Time scale',value:1,min:.1,max:3,step:.1,group:'Controls'});game.settings.define({key:'dev_seed',label:'Seed',value:9182,min:0,max:4294967295,step:1,group:'Controls'});\ngame.settings.onChange=(key,value)=>{if(embedded||\"'!world||!key.startsWith('\"'dev_'))return;const k=key.slice(4);if(k==='timeScale'){speed=value;world.practice=true;}else if(k in C.ranges)queue('tune',[k,value]);else if(['invulnerable','infiniteCharge','collisions'].includes(k))queue(k,value);};\ngame.hook('input',dt=>{controls.update();if(embedded){if(onlineEnded){controls.clear();return;}if(game.paused){game.live=true;}}else if(game.sceneName==='title'&&game.real-idleAt>=10){begin({attract:true,seed:9182});}if(\"'!embedded&&world){applyDev();if(stepCount>0){stepCount--;SIM.step(world,world.players.map(()=>zero),1/120);fx(world);}}if(game.paused)sound.update(dt,world,{paused:true,silent:false});if(ui.screen==='\"'editor')editor.draw();});\nconst scenes={title:{pausable:false,view:'overhead',camera:{zoom:false},enter:title,update(dt){game.focus(480,270,0);if(world)world.time+=dt;sound.update(dt,world,{paused:true,silent:true});},draw},play:{pausable:true,view:'overhead',camera:{zoom:false},enter(){game.focus(480,270,0);ui.hide();setPlaying(true);},update:tick,draw,back(){game.pause();return true;}}};\ngame.debug={snapshot:()=>({scene:game.sceneName,screen:ui.screen,attract,paused:game.paused,online:\"'!!online,ended:onlineEnded,...(world?SIM.snapshot(world):{})}),start:opts=>begin(opts),world:()=>world,runPilot(seconds=1){for(let n=0;n<seconds*120;n++){if(world.mode==='\"'transition')SIM.nextSector(world);SIM.step(world,world.players.map((p,i)=>SIM.pilot(world,i)),1/120);fx(world);}modeChanged();hud();return SIM.snapshot(world);},command:(name,value)=>{if(\"'!embedded)SIM.command(world,name,value);},editor:()=>editor,online:()=>online};\nglobalThis.RuinApp={game,ui,controls,get world(){return world;},get online(){return online;},begin,showTitle,howto,about,dev,dispose(){online?.dispose();sound.dispose();visuals.dispose();game.dispose();},booted:null};\nasync function boot(){online=await RuinOnline.connect({sim:SIM,getInput:()=>zero,onWorld:w=>{world=w;},onStep:(w,events)=>{world=w;fx(w,events);},onStart:()=>{menuMode='\"'play';lastSector=-1;lastMode='';if(game.sceneName)game.go('play',null,{fade:0});},onEnd:detail=>{onlineEnded=true;controls.clear();sound.dispose();ui.hide();setPlaying(false);tell(detail?.reason==='void'?'The signal has ended.':'The swarm awaits the next signal.',60);},onNotice:text=>tell(text,4)});if(online){world=online.getWorld();game.live=true;game.o.autoPause=false;game.start({scene:'play',scenes});}else game.start({scene:'title',scenes});return game;}\nRuinApp.booted=boot().catch(e=>{game.fail('boot',e);throw e;});\n})();\n/* GAME END */\nEOF\ncat > Yars-of-Ruin-Yars-Revenge-gpt-6.1-sol-ultra-20261106-022904/docs/controls.md <<'EOF'\n# Controls and play\n\nOpen the root HTML directly in a browser. No installation or server is needed. From the title choose Begin the siege, Normal or Assist. Three stations require one, two and three siege hits. The last hit must intercept the moving heart. Fly into cells to bite and charge. Shoot a corridor, align your vertical position, call the rail gun, and leave that lane. If every cell is gone, touch the docked green heart to refill.\n\nStandard gamepad: left stick moves, right stick aims, R2 fires, L2 calls the cannon, Options pauses, Cross confirms and Circle returns. Settings / Controls provides PlayStation or Xbox glyphs, deadzones and rebinding. Keyboard: WASD or arrows move, mouse aims, held left click or J fires, right click or Space calls the cannon, Escape pauses. Keyboard-only aiming follows movement. Local two-keyboard fallback: WASD/J/Space and arrows/period/slash. In local co-op, a single pad belongs to P2 and keyboard/mouse to P1; two pads are assigned separately.\n\nTouch: drag on the left half for flight, drag on the right half to aim and fire. A contextual cannon button appears when charged. Touch assists initial evasive motion when calling the cannon. The entire arena remains visible in portrait; landscape gives a larger combat area.\n\nOnline 1–2 player co-op is supplied by AI Hub. Standalone has immediate solo and local co-op, without a matchmaking service. The host simulates both scouts; departing teammates do not strand a round. Session menus leave the online world running.\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_33","type":"agent_message","text":"The simulation, custom insect and fortress art, and procedural audio are implemented. I’m connecting them in the packaged game now. The next checks focus on campaign completion, recovery after a missed final shot, and whether controls and online lifecycle behavior hold up in a browser.\n"}}
