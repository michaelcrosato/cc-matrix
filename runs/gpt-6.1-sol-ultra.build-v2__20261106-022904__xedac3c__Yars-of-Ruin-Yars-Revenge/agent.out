{ return new Encounters(this, zones, o); }\\n  /** the party a save held (party.state()) */\\n  restore(s) {\\n    const members = (s.members || []).map(m => new Member(this, m));\\n    return new Party(this, members, { gold: s.gold, inv: new Inventory(this, s.inv || {}) });\\n  }\\n  /** a hit: { hp, crit } (a\\'s attack, or its magic with kind \\'mag\\', less half b\\'s defense or magic; a tenth either way;\\n   *  a critical hit, physical only, ignores armor; guard halves it) */\\n  damage(a, b, o = {}) {\\n    const mag = o.kind === \\'mag\\', st = (u, k) => typeof u.stat === \\'function\\' ? u.stat(k) : u[k] || 0;\\n    const at = st(a, mag ? \\'mag\\' : \\'atk\\'), df = st(b, mag ? \\'mag\\' : \\'def\\'), crit = !mag && Math.random() < (o.crit === undefined ? .08 : o.crit);\\n    let hp = (crit ? at * 1.5 : at - df / 2) * (o.power || 1) * (.9 + Math.random() * .2);\\n    if (o.guard) hp /= 2;\\n    return { hp: Math.max(1, Math.round(hp)), crit };\\n  }\\n  /** item id\\'s icon: its own sprite, or one for its kind (a flask red for HP, blue for MP) */\\n  icon(id) {\\n    const it = this.item(id); if (!it) return null; if (it.icon) return it.icon;\\n    const k = ICONS[it.kind] ? it.kind : \\'use\\', key = k + (it.mp && !it.heal ? \\':mp\\' : \\'\\');\\n    return this._icons[key] || (this._icons[key] = E.sprite(ICONS[k], { k: \\'#1a1030\\', f: it.mp && !it.heal ? \\'#5aa0ff\\' : \\'#e8384a\\', w: \\'#ffffff\\', g: \\'#e8c860\\', a: \\'#b8c4d8\\' }));\\n  }\\n  /** a window of rows ({ label, note, icon, off }) with a cursor; o: { cursor, title, top (the first row shown), show\\n   *  (rows shown: 8), bg, rowH }. → { x, y, w, h, row(px, py) }: the row index at a screen point, or -1 */\\n  list(g, x, y, w, rows, o = {}) {\\n    const rh = o.rowH || 11, show = Math.min(rows.length, o.show || 8), top = Math.max(0, Math.min(o.top || 0, rows.length - show)), ty = o.title ? 13 : 0, h = Math.max(1, show) * rh + 8 + ty;\\n    E.ui.box(g, x, y, w, h, { bg: o.bg || [\\'#6c8cff\\', \\'#0a0a48\\'] });\\n    if (o.title) { E.font.text(g, o.title, x + 7, y + 5, \\'#ffe08a\\', { outline: false, shadow: \\'#0a0820\\' }); px.rect(g, x + 4, y + 14, w - 8, 1, \\'#a8b8ff\\'); }\\n    for (let k = 0; k < show; k++) {   // (rows taller than the text, a thumb\\'s on a phone: the text in their middle)\\n      const i = top + k, r = rows[i], ry = y + 5 + ty + k * rh + Math.max(0, Math.floor((rh - 11) / 2)), col = r.off ? \\'#7c7aa8\\' : \\'#ffffff\\';\\n      if (r.icon) px.sprite(g, r.icon, x + 12, ry);\\n      E.font.text(g, r.label, x + (r.icon ? 23 : 13), ry, col, { outline: false, shadow: \\'#0a0820\\' });\\n      if (r.note !== undefined && r.note !== null) E.font.text(g, String(r.note), x + w - 7, ry, r.off ? \\'#7c7aa8\\' : \\'#9ad0ff\\', { outline: false, shadow: \\'#0a0820\\', align: \\'right\\' });\\n      if (i === o.cursor) px.poly(g, [[x + 4, ry], [x + 9, ry + 3], [x + 4, ry + 6]], \\'#ffe060\\');\\n    }\\n    if (top > 0) px.poly(g, [[x + w / 2 - 3, y + ty + 4], [x + w / 2 + 3, y + ty + 4], [x + w / 2, y + ty + 1]], \\'#ffe060\\');\\n    if (top + show < rows.length) px.poly(g, [[x + w / 2 - 3, y + h - 4], [x + w / 2 + 3, y + h - 4], [x + w / 2, y + h - 1]], \\'#ffe060\\');\\n    return { x, y, w, h, rowH: rh, top, show, row: (qx, qy) => { const k = Math.floor((qy - y - 5 - ty + (rh > 11 ? 0 : 2)) / rh); return qx >= x && qx < x + w && k >= 0 && k < show ? top + k : -1; },\\n      at: k => [x + w / 2, y + 5 + ty + (k - top + .5) * rh] };   // (a row\\'s middle on screen: a tap\\'s target)\\n  }\\n  /** a member\\'s card: o.portrait (a Humanoid) beside its name, level, HP and MP bars, its stats and effects; → { w, h } */\\n  card(g, x, y, m, o = {}) {\\n    const w = o.w || 150, h = 62, P = o.portrait, tx = x + (P ? 34 : 7), t = (s, a, b, c, al) => E.font.text(g, String(s), a, b, c, { outline: false, shadow: \\'#0a0820\\', align: al });\\n    E.ui.box(g, x, y, w, h, { bg: o.bg || [\\'#6c8cff\\', \\'#0a0a48\\'] });\\n    if (P) P.drawPortrait(g, x + 4, y + 4, 26, { zoom: 2.1, turn: .7, bg: [\\'#3a4aa8\\', \\'#10143a\\'], tint: m.dead ? \\'#808080\\' : undefined });\\n    t(m.name, tx, y + 5, m.dead ? \\'#a08aa8\\' : \\'#ffffff\\'); t(\\'Lv \\' + m.level, x + w - 7, y + 5, \\'#ffe08a\\', \\'right\\');\\n    const bar = (lab, v, mx, by, c) => { E.font.text(g, lab, tx, by, \\'#9ad0ff\\', { font: \\'tiny\\', outline: false }); t(v + \\'/\\' + mx, x + w - 7, by - 2, \\'#ffffff\\', \\'right\\'); E.ui.bar(g, tx + 12, by + 7, x + w - tx - 19, 3, mx ? v / mx : 0, c, { bg: \\'#2a2650\\' }); };\\n    bar(\\'HP\\', m.hp, m.max(\\'hp\\'), y + 17, m.hp < m.max(\\'hp\\') / 4 ? \\'#e8a030\\' : \\'#58d068\\'); bar(\\'MP\\', m.mp, m.max(\\'mp\\'), y + 30, \\'#5aa0ff\\');\\n    [\\'atk\\', \\'def\\', \\'mag\\', \\'spd\\'].forEach((k, i) => E.font.text(g, k.toUpperCase() + \\' \\' + Math.round(m.stat(k)), x + 7 + i * ((w - 14) / 4), y + 46, \\'#c8d0ff\\', { font: \\'tiny\\', outline: false }));\\n    const fx = Object.keys(m.effects); if (fx.length) E.font.text(g, fx.join(\\' \\').toUpperCase(), x + 7, y + 54, (this.status[fx[0]] || {}).color || \\'#ffffff\\', { font: \\'tiny\\', outline: false });\\n    return { w, h };\\n  }\\n}\\nE.RPG = RPG;\\n})(typeof My3D2dge !== \\'undefined\\' ? My3D2dge : undefined);\\n\\n/*!\\nmy-3D2dge module SONGS v0.89.1: the songbook: the kits\\' best songs and more, and jingles, tagged by mood\\nhttps://github.com/michaelcrosato/my-3d2dge (MIT License)\\nLoads after: the full engine or the agent edition. Needs: no other module.\\n\\nOriginal chiptunes in the step sequencer\\'s format (game.audio.music\\'s: { bpm, steps, tracks }), each with a title and\\nits moods, ready to play or to copy and change.\\n- E.Songbook.songs: every song by id; E.Songbook.get(id) -> the song; E.Songbook.find(mood) -> the ids of the songs of\\n  that mood (in the order they are listed); E.Songbook.moods: every mood there is.\\n- Moods: title, field, town, shop, calm, dungeon, battle, boss, race, puzzle, space, horror, stealth, chase, dance,\\n  and the jingles (loop: false): stage clear, game over, one-up, level up, fanfare.\\n- A song\\'s tracks may have a name and on: false (a layer, silent until game.audio.layer(name, 1) brings it in, on the\\n  full engine): \\'shadows\\' sneaks on three tracks and brings in \\'chase\\' and \\'alarm\\' when the guards see you.\\n- A song\\'s len (steps) can run longer than its tracks (they loop on their own lengths within it): the dance songs.\\n\\n```js songs\\nconst E = My3D2dge, battle = E.Songbook.find(\\'battle\\');\\nif (!battle.length || !E.Songbook.get(battle[0]).tracks.length) throw new Error(\\'a battle song\\');\\nif (E.Songbook.get(\\'clear\\').loop !== false || !E.Songbook.moods.includes(\\'stealth\\')) throw new Error(\\'jingles and moods\\');\\nfor (const id in E.Songbook.songs) for (const t of E.Songbook.songs[id].tracks) if (!t.notes.trim()) throw new Error(id);\\n```\\nRules: play one with game.audio.music(E.Songbook.get(id)) (a jingle: audio.sting, over the music, in the full engine); copy a song into\\nyour game to change it; a kit carries this module only when it plays its songs.\\n*/\\n(function (E) {\\n\\'use strict\\';\\nif (!E) throw new Error(\\'my-3D2dge module SONGS: load engine/my-3d2dge.js (or the agent edition) first\\');\\n\\n/* =============================================================================\\n * SONGS  the songbook: songs by id, each with a title and moods; find(mood), get(id)\\n * ========================================================================== */\\nconst S = {\\n  // gathered from the kits (and the core\\'s own, by name)\\n  title: { core: \\'title\\', title: \\'Title\\', mood: [\\'title\\'] },\\n  adventure: { core: \\'adventure\\', title: \\'Adventure\\', mood: [\\'field\\'] },\\n  dungeon: { core: \\'dungeon\\', title: \\'Dungeon\\', mood: [\\'dungeon\\'] },\\n  boss: { core: \\'boss\\', title: \\'Boss\\', mood: [\\'boss\\', \\'battle\\'] },\\n  victory: { core: \\'victory\\', title: \\'Victory\\', mood: [\\'stage clear\\', \\'fanfare\\'] },\\n  road: { title: \\'The Road North\\', mood: [\\'field\\'], bpm: 126, steps: 4, tracks: [\\n    { wave: \\'square\\', vol: .1, notes: \\'G4 - B4 - D5 - - G5 | F#5 - D5 - E5 - D5 - | C5 - E5 - G5 - - E5 | D5 - B4 - A4 - - - | G4 - B4 - D5 - - G5 | A5 - G5 - F#5 - E5 - | D5 - C5 - B4 - A4 - | G4 - - - - - . .\\' },\\n    { wave: \\'triangle\\', vol: .3, notes: \\'G2 . D3 . G2 . D3 . | D2 . A2 . D2 . A2 . | C3 . G3 . C3 . G3 . | D3 . A2 . D3 . A2 . | G2 . D3 . G2 . D3 . | F2 . C3 . D3 . A2 . | C3 . G2 . D3 . A2 . | G2 . D3 . G2 . . .\\' },\\n    { wave: \\'drums\\', vol: .1, notes: \\'k . h . s . h . k k h . s . h h\\' }] },\\n  town: { title: \\'Market Day\\', mood: [\\'town\\'], bpm: 104, steps: 4, tracks: [\\n    { wave: \\'triangle\\', vol: .3, notes: \\'F3 . C4 . A3 . C4 . | C3 . G3 . E3 . G3 . | D3 . A3 . F3 . A3 . | Bb2 . F3 . C3 . E3 .\\' },\\n    { wave: \\'pulse\\', vol: .11, notes: \\'A4 - C5 - F5 - E5 D5 | C5 - - - G4 - - - | D5 - F5 - A5 - G5 F5 | E5 - C5 - D5 - - -\\' },\\n    { wave: \\'drums\\', vol: .06, notes: \\'k . h . . . h . k . h . . . h h\\' }] },\\n  shanty: { title: \\'The Salty Gull\\', mood: [\\'town\\'], bpm: 92, steps: 3, tracks: [\\n    { wave: \\'square\\', vol: .1, notes: \\'D5 - A4 | D5 E5 F5 | E5 - C5 | A4 - - | D5 - A4 | F5 E5 D5 | C5 - E5 | D5 - - | F5 - G5 | A5 - F5 | G5 F5 E5 | C5 - - | D5 - F5 | E5 C5 A4 | D5 C5 E5 | D5 - -\\' },\\n    { wave: \\'triangle\\', vol: .28, notes: \\'D3 A3 A3 | D3 A3 A3 | C3 G3 G3 | A2 E3 E3 | D3 A3 A3 | Bb2 F3 F3 | C3 G3 G3 | D3 A3 A3 | F3 C4 C4 | F3 C4 C4 | C3 G3 G3 | A2 E3 E3 | Bb2 F3 F3 | A2 E3 E3 | A2 E3 C#3 | D3 A3 D3\\' },\\n    { wave: \\'drums\\', vol: .05, notes: \\'k . h | s . h\\' }] },\\n  hymn: { title: \\'The Lamp Is Lit\\', mood: [\\'calm\\'], bpm: 76, steps: 3, tracks: [\\n    { wave: \\'square\\', vol: .1, notes: \\'D5 - F#5 | A5 - - | G5 F#5 E5 | F#5 - - | D5 - E5 | F#5 - A5 | B5 A5 F#5 | A5 - - | D6 - -