ug().pointers.length===0 && __game.errors.length===0'))\n    context.close();browser.close()\n    # Canvas2D path also runs in WebKit (an iPhone stand-in only).\n    browser=pw.webkit.launch(headless=True);context=browser.new_context(viewport={'width':1024,'height':768});page=context.new_page();boot(page)\n    check('WebKit boots the offline artifact without engine errors',lambda:ev('__game.errors.length===0 && __game.sceneName===\\\"title\\\"'))\n    context.close();browser.close()\n(ART/'browser-summary.json').write_text(json.dumps(results,indent=2))\nfor r in results:\n    if not r['pass']:print('FAIL '+r['name']+': '+r.get('error',''))\nprint(json.dumps({'passed':sum(r['pass'] for r in results),'failed':sum(not r['pass'] for r in results)}))\nsys.exit(1 if any(not r['pass'] for r in results) else 0)\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python Yars-of-Ruin-Yars-Revenge-gpt-6.1-sol-ultra-20261106-022904/tests/browser.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
