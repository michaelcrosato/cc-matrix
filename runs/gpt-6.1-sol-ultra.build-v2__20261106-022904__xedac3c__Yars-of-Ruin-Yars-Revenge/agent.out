{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,155p' Yars-*/src/online/hub.js && sed -n '1,100p' Yars-*/src/presentation/audio.js\"","aggregated_output":"/* Yars of Ruin — authoritative AI Hub Protocol 1 adapter. */\n(() => {\n  'use strict';\n  const root = typeof window === 'undefined' ? globalThis : window;\n  const clone = (x) => JSON.parse(JSON.stringify(x));\n  const zero = () => ({mx:0,my:0,ax:1,ay:0,fire:false,cannon:false});\n  const finite = Number.isFinite;\n  const round = (x) => typeof x === 'number' ? Math.round(x * 100) / 100 : x;\n  const small = (v) => Array.isArray(v) ? v.map(small) : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).filter(([k])=>!k.startsWith('_')).map(([k,x])=>[k,small(x)])) : round(v);\n  const columns = {\n    players: ['id','x','y','vx','vy','ax','ay','alive','respawn','invuln','charge','ready','biteFlash','wrapFlash','departed'],\n    shots:['id','x','y','vx','vy','r','life','owner','kind'],\n    hazards:['id','kind','x','y','vx','vy','r','angle','target','life'],\n    cannons:['id','x','y','vx','r','owner','warn','reflected','returnWarn','life']\n  };\n  function packRows(rows, keys) { return (rows||[]).map(row=>keys.map(k=>small(row[k]===undefined?null:row[k]))); }\n  function unpackRows(rows, keys) { return rows.map(row=>Object.fromEntries(keys.map((k,i)=>[k,row[i]]))); }\n  function mask(cells) {\n    let str=''; for(let i=0;i<cells.length;i+=4){let n=0;for(let j=0;j<4;j++)if(cells[i+j]?.alive)n|=1<<j;str+=n.toString(16);}return str;\n  }\n  function offsets(cells) {\n    const out={};for(const c of cells)if(!(String(c.plate) in out))out[c.plate]=[round(c.x-(c.baseX??c.x)),round(c.y-(c.baseY??c.y))];return out;\n  }\n  function pack(world, sequence, ack, events, topology) {\n    const p={k:'w',v:1,n:sequence,t:[world.tick,round(world.time),world.sector,world.mode,world.phase,round(world.phaseTime),world.reserves,world.score],p:packRows(world.players,columns.players),c:small(world.core),r:small(world.refuge),m:mask(world.cells),o:offsets(world.cells),h:packRows(world.hazards,columns.hazards),s:packRows(world.shots,columns.shots),g:packRows(world.cannons,columns.cannons),a:ack,e:small(events||[]),u:small(world.tutorial),z:world.message||''};\n    if(topology)p.b=world.cells.map(c=>[c.id,c.baseX??c.x,c.baseY??c.y,c.plate,c.material,c.size||20]);\n    // A full topology is also a recovery keyframe. Visual particles are reconstructed\n    // from confirmed changes, never sent individually as reliable messages.\n    if(topology)p.f={seed:world.seed,stats:small(world.stats),tuning:small(world.tuning),plates:small(world.plates),contentName:world.contentName};\n    return p;\n  }\n  function unpack(packet, sim, old, options) {\n    let w=old;\n    if(!w||w.sector!==packet.t[2])w=sim.create({players:packet.p.length,seed:options.seed,sector:packet.t[2]});\n    const [tick,time,sector,mode,phase,phaseTime,reserves,score]=packet.t;\n    Object.assign(w,{tick,time,sector,mode,phase,phaseTime,reserves,score,core:clone(packet.c),refuge:clone(packet.r),tutorial:packet.u,message:packet.z,events:clone(packet.e||[])});\n    if(packet.b)w.cells=packet.b.map(c=>({id:c[0],x:c[1],y:c[2],baseX:c[1],baseY:c[2],plate:c[3],material:c[4],size:c[5],alive:true}));\n    w.cells.forEach((c,i)=>{c.alive=!!(parseInt(packet.m[Math.floor(i/4)]||'0',16)&(1<<(i%4)));const offset=packet.o[c.plate]||[0,0];c.x=(c.baseX??c.x)+offset[0];c.y=((c.baseY??c.y)+offset[1]+540)%540;});\n    for(const [key,short] of [['players','p'],['shots','s'],['hazards','h'],['cannons','g']])w[key]=unpackRows(packet[short]||[],columns[key]);\n    if(packet.f)Object.assign(w,clone(packet.f));\n    return w;\n  }\n  function encodeInput(frame, seq, cannon, at) {\n    const q=x=>Math.round(Math.max(-1,Math.min(1,finite(x)?x:0))*127);\n    return {k:'i',q:seq,at:Math.round(at),a:[q(frame.mx),q(frame.my),q(frame.ax??1),q(frame.ay),frame.fire?1:0],c:cannon};\n  }\n  function createValidator(ids, now) {\n    const states=new Map(ids.map(id=>[id,{q:0,c:0,at:-Infinity,input:zero(),edge:false}]));\n    const stats={accepted:0,rejected:0,duplicates:0};\n    function accept(packet,from) {\n      const s=states.get(from);const t=now();\n      if(!s||!packet||packet.k!=='i'||!Number.isInteger(packet.q)||packet.q<=0||packet.q>s.q+10000||!finite(packet.at)||Math.abs(packet.at-t)>8000||!Array.isArray(packet.a)||packet.a.length!==5||!packet.a.slice(0,4).every(x=>Number.isInteger(x)&&x>=-127&&x<=127)||![0,1].includes(packet.a[4])||!Number.isInteger(packet.c)||packet.c<0||packet.c>s.c+64){stats.rejected++;return false;}\n      if(packet.q<=s.q){stats.duplicates++;return false;}\n      const [mx,my,ax,ay,fire]=packet.a;s.q=packet.q;s.at=t;s.input={mx:mx/127,my:my/127,ax:ax/127,ay:ay/127,fire:!!fire,cannon:false};\n      if(packet.c>s.c){s.c=packet.c;s.edge=true;}stats.accepted++;return true;\n    }\n    function action(id){const s=states.get(id);if(!s)return zero();if(now()-s.at>600){s.edge=false;return zero();}const a={...s.input,cannon:s.edge};s.edge=false;return a;}\n    return {accept,action,states,stats,leave:id=>states.delete(id),ack:()=>Object.fromEntries([...states].map(([id,s])=>[id,s.c]))};\n  }\n  async function connect(options={}) {\n    const hub=options.hub||root.AIHub,sim=options.sim||root.RuinSim;\n    if(!hub)return null;\n    let started=false,ended=false,adapter=null;const queued=[];\n    const listen=(type,fn)=>hub.on(type,(...args)=>{if(adapter)fn(...args);else queued.push(()=>fn(...args));});\n    const unsubs=[];\n    unsubs.push(listen('start',()=>{started=true;options.onStart?.(adapter.info);}));\n    unsubs.push(listen('time-up',()=>adapter.finish(false,'time-up')));\n    unsubs.push(listen('end',detail=>adapter.end(detail)));\n    unsubs.push(listen('leave',detail=>adapter.leave(detail)));\n    unsubs.push(listen('message',(data,from)=>adapter.message(data,from)));\n    const info=await hub.connect({mode:'shared-world',seats:[1,2]});\n    if(!info){unsubs.forEach(fn=>fn());return null;}\n    // Cache a labeled stream: asking hub.rng on every use would restart it.\n    const seedStream=hub.rng('ruin-combat');const seed=(seedStream()*4294967296)>>>0;\n    const roster=info.players.slice();const ids=roster.map(p=>p.id);const localIndex=ids.indexOf(info.me);\n    const now=()=>hub.time();const clock=options.clock||(()=>root.performance?.now?.()??Date.now());\n    const validator=createValidator(ids,now);let world=sim.create({players:roster.length,seed});\n    let input=zero(),inputSeq=0,cannonSeq=0,pendingCannon=0,lastCannon=false,inputDirty=true;\n    let sequence=0,lastReceived=0,eventCursor=0,events=[],lastKey='',keyframeDue=true;\n    let last=clock(),acc=0,netAcc=0,reliableAcc=0,transitionAcc=0,timer=null,lastPacketTime=clock();\n    let previous=null,current=null,display=null;\n    const stats={sent:0,dropped:0,received:0,rejectedSnapshots:0,bytes:0,maxBytes:0,fragmented:0,steps:0,finishCalls:0,afterEndSends:0,validator:validator.stats};\n    function decorate(w){w.online=true;w.server=!!info.server;w.players.forEach((p,i)=>{const rp=roster[i];if(rp){p.hubId=rp.id;p.name=rp.name;p.color=rp.color;}});return w;}\n    decorate(world);\n    function send(data,reliable=false,to){if(ended)return false;const bytes=new TextEncoder().encode(JSON.stringify(data)).length;if(bytes>16384){stats.dropped++;options.onNotice?.('Network state exceeded the protocol limit.');return false;}stats.maxBytes=Math.max(stats.maxBytes,bytes);if(!reliable&&bytes>1200)stats.fragmented++;const ok=hub.send(data,{reliable,...(to===undefined?{}:{to})});if(ok){stats.sent++;stats.bytes+=bytes;}else stats.dropped++;return ok;}\n    function snapshot(force=false){const key=[world.sector,world.phase,world.mode,world.cells.length].join(':');const topology=force||keyframeDue||key!==lastKey;const reliable=topology||reliableAcc>=1;const packet=pack(world,++sequence,validator.ack(),events,topology);if(send(packet,reliable)){events=[];lastKey=key;keyframeDue=false;if(reliable)reliableAcc=0;}else{sequence--;if(topology)keyframeDue=true;}}\n    function localPacket(){return encodeInput(input,++inputSeq,pendingCannon,Math.max(0,now()));}\n    function setInput(frame){if(ended||info.server||localIndex<0)return;const next=frame||zero();const edge=!!next.cannon&&!lastCannon;lastCannon=!!next.cannon;if(edge){pendingCannon=++cannonSeq;inputDirty=true;}input={...zero(),...next,cannon:false};if(info.isHost||hub.isHost)validator.accept(localPacket(),info.me);}\n    function simulateOne(){\n      const actions=world.players.map((p,i)=>p.departed?zero():validator.action(ids[i]));\n      sim.step(world,actions,1/120);stats.steps++;\n      for(const e of world.events||[])if(e.id>eventCursor){events.push(e);eventCursor=e.id;}\n      // Keep the snapshot event tail bounded by transport, not particle count.\n      if(events.length>12)events=events.filter(e=>!['shoot','chip','bite'].includes(e.type)).slice(-12);\n      options.onStep?.(world,world.events||[]);\n      if(world.mode==='transition'){\n        transitionAcc+=1/120;if(transitionAcc>=3){sim.nextSector(world);transitionAcc=0;keyframeDue=true;}\n      }else transitionAcc=0;\n      if(world.mode==='victory'||world.mode==='defeat')adapter.finish(world.mode==='victory',world.mode);\n    }\n    function pulse(){\n      if(ended)return;const t=clock();let elapsed=Math.max(0,(t-last)/1000);last=t;\n      // The 20s host-hidden cancellation belongs to the hub. This clock never\n      // restarts a void round and advances neither before nor during countdown.\n      if(!started||!finite(now())||now()<0){acc=0;return;}\n      netAcc+=elapsed;reliableAcc+=elapsed;\n      if(hub.isHost){if(elapsed>20){acc=0;return;}acc+=elapsed;while(acc>=1/120&&!ended){simulateOne();acc-=1/120;}options.onWorld?.(world);if(netAcc>=.1&&!ended){netAcc%=.1;snapshot();}}\n      else if(netAcc>=.1&&!ended){netAcc%=.1;send(localPacket(),pendingCannon>0&&pendingCannon>(current?.ack?.[info.me]||0),info.host);inputDirty=false;}\n    }\n    function receive(packet,from){\n      if(ended)return;\n      if(hub.isHost){if(ids.includes(from))validator.accept(packet,from);return;}\n      if(from!==info.host||!packet||packet.k!=='w'||packet.v!==1||!Number.isInteger(packet.n)||packet.n<=lastReceived||!Array.isArray(packet.t)||packet.t.length<8||!Array.isArray(packet.p)){stats.rejectedSnapshots++;return;}\n      try{\n        lastReceived=packet.n;stats.received++;previous=current;world=decorate(unpack(packet,sim,world,{seed}));current={world:clone(world),at:clock(),ack:packet.a||{}};lastPacketTime=clock();if(!display||previous?.world.sector!==world.sector)display=clone(world);\n        if((packet.a?.[info.me]||0)>=pendingCannon)pendingCannon=0;\n        options.onWorld?.(world);options.onStep?.(world,world.events||[]);\n      }catch(error){stats.rejectedSnapshots++;options.onNotice?.('Recovering shared world…');}\n    }\n    function renderWorld(dt=1/60){\n      if(hub.isHost||!current)return world;\n      if(!display)display=clone(world);\n      const target=clone(current.world);const factor=Math.min(1,Math.max(.08,dt*18));\n      // Prediction affects only the local displayed body. All danger, charge,\n      // shield topology, cannon presses and core damage stay host confirmed.\n      for(let i=0;i<target.players.length;i++){\n        const a=target.players[i],p=display.players[i]||a;const age=Math.min(.15,(clock()-current.at)/1000);let tx=a.x,ty=a.y;\n        if(i===localIndex&&a.alive){tx+=input.mx*(world.tuning?.scoutSpeed||250)*age;ty+=input.my*(world.tuning?.scoutSpeed||250)*age;}\n        let dy=((ty-p.y+810)%540)-270;\n        target.players[i]={...a,x:p.x+(tx-p.x)*factor,y:(p.y+dy*factor+540)%540};\n      }\n      display=clone(target);return display;\n    }\n    function finish(won,reason){if(ended||adapter.finished||!hub.isHost)return;adapter.finished=true;stats.finishCalls++;snapshot(true);const active=ids.filter(id=>validator.states.has(id));const scores=Object.fromEntries(active.map(id=>[id,world.score||0]));hub.finish({standings:[active],scores,won:!!won,stats:Object.fromEntries(active.map(id=>[id,{Sectors:world.sector+(world.mode==='victory'?1:0),Score:world.score||0,Outcome:reason}]))});}\n    function end(detail){if(ended)return;ended=true;adapter.ended=true;input=zero();pendingCannon=0;acc=0;if(timer!==null)(options.clearInterval||root.clearInterval)(timer);timer=null;options.onEnd?.(detail);}\n    function leave(detail){const index=ids.indexOf(detail.id);validator.leave(detail.id);if(index>=0&&hub.isHost){sim.command(world,'leave',index);keyframeDue=true;options.onWorld?.(world);}options.onNotice?.('A scout left the signal. The surviving swarm continues.');}\n    adapter={info:{...info,isHost:hub.isHost},localIndex,active:true,ended:false,finished:false,get world(){return world;},setInput,getWorld:()=>world,renderWorld,finish,end,leave,message:receive,pulse,debug:stats,dispose(){end({reason:'disposed'});unsubs.forEach(fn=>fn());}};\n    for(const fn of queued.splice(0))fn();options.onWorld?.(world);options.onConnected?.(adapter);\n    timer=(options.setInterval||root.setInterval)(pulse,1000/120);\n    if(hub.isHost)snapshot(true);\n    hub.ready();\n    return adapter;\n  }\n  root.RuinOnline={connect,pack,unpack,encodeInput,createValidator};\n})();\n/* Original code-only score, impacts and formant chatter. No recorded audio. */\n(() => {\n'use strict';\nconst root=typeof window!=='undefined'?window:globalThis;\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nfunction createSynth(ctx,buses){\n  const active=new Set();let stopped=false,created=0;\n  let z=0x61f73019;const noise=ctx.createBuffer(1,ctx.sampleRate,ctx.sampleRate),d=noise.getChannelData(0);\n  for(let i=0;i<d.length;i++){z^=z<<13;z^=z>>>17;z^=z<<5;d[i]=((z>>>0)/4294967296)*2-1;}\n  function note(type,freq,to,dur,vol,bus='sfx',delay=0,filter=null){\n    if(stopped||!Number.isFinite(freq)||!Number.isFinite(vol))return;\n    const at=ctx.currentTime+Math.max(0,delay),end=at+Math.max(.025,dur),gain=ctx.createGain();\n    gain.gain.setValueAtTime(0,at);gain.gain.linearRampToValueAtTime(clamp(vol,0,.28),at+.008);gain.gain.exponentialRampToValueAtTime(.00001,end-.008);gain.gain.linearRampToValueAtTime(0,end);\n    let source;\n    if(type==='noise'){source=ctx.createBufferSource();source.buffer=noise;source.loop=true;source.playbackRate.setValueAtTime(clamp(freq/1600,.1,4),at);}\n    else{source=ctx.createOscillator();source.type=type;source.frequency.setValueAtTime(clamp(freq,20,12000),at);if(to)source.frequency.exponentialRampToValueAtTime(clamp(to,20,12000),end);}\n    const nodes=[source,gain];source.connect(gain);let tail=gain;\n    if(filter){const f=ctx.createBiquadFilter();f.type=filter.type||'lowpass';f.frequency.value=filter.freq||1200;f.Q.value=filter.q||.7;tail.connect(f);tail=f;nodes.push(f);}\n    tail.connect(buses[bus]||buses.sfx);active.add(source);created++;\n    source.onended=()=>{active.delete(source);for(const n of nodes)try{n.disconnect();}catch{}};\n    source.start(at);source.stop(end+.012);return source;\n  }\n  function chatter(fortress=false,delay=0){\n    const syllables=fortress?[102,153,94,132,87]:[288,376,260,408,330];\n    syllables.forEach((f,i)=>{const t=delay+i*.085;note('sawtooth',f,f*(i%2?1.18:.84),.066,.022,'voice',t,{type:'bandpass',freq:fortress?640+i*120:1000+i*170,q:4});note('sine',f*2,f*1.8,.062,.012,'voice',t);});\n  }\n  function stop(){stopped=true;for(const s of active){try{s.stop();}catch{}try{s.disconnect();}catch{}}active.clear();}\n  return{note,chatter,stop,active,stats:()=>({active:active.size,created,stopped})};\n}\nfunction create(game){\n  const A=game.audio;let enabled=false,disposed=false,synth=null,gates=null,sequence=0,beatTime=0,sector=-1,prevState='',silent=true;\n  let beat=0;const played=new Set();\n  function unlock(){\n    if(disposed||game.headless)return false;enabled=true;\n    const bus=A.bus('sfx');if(!bus||!A.ctx)return false;\n    if(A.ctx.state==='suspended')A.ctx.resume().catch(()=>{});\n    if(!synth){gates={};for(const name of ['sfx','music','voice']){const g=A.ctx.createGain();g.gain.value=0;g.connect(A.bus(name));gates[name]=g;}synth=createSynth(A.ctx,gates);}\n    return true;\n  }\n  function setSilence(on){if(!gates||silent===on)return;silent=on;const t=A.ctx.currentTime;for(const g of Object.values(gates)){g.gain.cancelScheduledValues(t);g.gain.setTargetAtTime(on?0:1,t,.015);}}\n  function update(dt,w,opts={}){\n    if(disposed)return;\n    if(!enabled&&A.ready)unlock();\n    if(!synth)return;\n    setSilence(!!(opts.paused||opts.silent));if(silent)return;\n    beatTime-=Math.max(0,dt);\n    if(w.sector!==sector){sector=w.sector;beat=0;beatTime=0;}\n    const N=synth.note;\n    if(beatTime<=0){\n      beatTime+=sector===2?.19:sector===1?.23:.27;\n      const roots=[55,61.735,65.406],base=roots[sector]||55;\n      const motif=[0,7,12,3,0,10,7,3,0,7,15,12,10,3,7,-2],st=motif[beat%motif.length];\n      if(beat%4===0){N('triangle',base,base,.93,.095,'music');N('sawtooth',base*1.005,base*.998,.85,.028,'music',0,{freq:330});}\n      N('sine',base*4*Math.pow(2,st/12),0,.35,.047,'music',0,{freq:1800});\n      if(beat%2===0)N('noise',4500,0,.024,.011,'music',0,{type:'highpass',freq:4200});\n      if(sector>0&&beat%4===2)N('sine',90,43,.14,.06,'music');\n      if(w.core&&(w.core.state==='windup'||w.core.state==='flight'))N('triangle',base*8*Math.pow(2,([0,1,7,6][beat%4])/12),0,.12,.018,'music');\n      if(w.players?.some(p=>p.ready||p.charge>=(w.tuning?.chargeThreshold||5)))N('sine',base*16,0,.12,.011,'music',.09);\n      beat++;sequence++;\n    }\n    prevState=w.core?.state||prevState;\n  }\n  function event(ev,w){\n    if(disposed||!synth||silent)return;\n    const key=ev.id===undefined?`${w.tick}:${ev.type}:${ev.player??''}`:ev.id;if(played.has(key))return;played.add(key);if(played.size>1024)played.delete(played.values().next().value);\n    const N=synth.note;\n    switch(ev.type){\n      case 'chip':N('noise',2200,0,.045,.045,'sfx',0,{type:'highpass',freq:1300});N('sine',700,360,.04,.025);break;\n      case 'bite':N('noise',650,0,.065,.07,'sfx',0,{type:'bandpass',freq:820,q:1.6});N('triangle',270,530,.06,.025);break;\n      case 'charge':for(let i=0;i<5;i++)N('sine',392*Math.pow(2,[0,3,7,12,19][i]/12),0,.22,.035,'sfx',i*.055);synth.chatter();break;\n      case 'cannon-warn':N('square',210,440,.19,.032);N('sine',840,1050,.19,.03);break;\n      case 'cannon-fire':N('noise',1100,0,.37,.13,'sfx',0,{freq:1700});N('sine',165,37,.5,.14);N('sawtooth',520,90,.25,.045);break;\n      case 'reflection':for(let i=0;i<3;i++)N('square',1800-i*280,720-i*100,.085,.032,'sfx',i*.085);N('noise',2800,0,.27,.04,'sfx',0,{type:'highpass',freq:1800});break;\n      case 'swirl-warn':N('sawtooth',95,480,.9,.055,'sfx',0,{type:'bandpass',freq:1300,q:3});for(let i=0;i<4;i++)N('sine',580+i*130,0,.11,.027,'sfx',i*.2);synth.chatter(true);break;\n      case 'swirl-launch':N('noise',720,0,.6,.09,'sfx',0,{type:'bandpass',freq:600});N('sawtooth',320,65,.5,.045);break;\n      case 'core-hit':N('noise',900,0,1.1,.18,'sfx',0,{freq:1200});N('sine',80,25,1.4,.16);N('noise',3400,0,.28,.06,'sfx',.08,{type:'highpass',freq:2000});break;\n      case 'sector-clear':for(let i=0;i<5;i++)N('triangle',261.63*Math.pow(2,[0,3,7,12,15][i]/12),0,.5,.05,'sfx',i*.11);synth.chatter();break;\n      case 'death':N('square',430,47,.43,.06);N('noise',1300,0,.28,.07,'sfx',0,{freq:1500});break;\n      case 'respawn':for(let i=0;i<3;i++)N('sine',330+i*220,0,.14,.028,'sfx',i*.08);break;\n      case 'refill':N('triangle',220,880,.31,.05);break;\n      case 'victory':for(let i=0;i<9;i++)N('triangle',261.63*Math.pow(2,[0,7,12,15,19,24,19,15,12][i]/12),0,.7,.045,'sfx',i*.13);synth.chatter();break;\n      case 'refuge-warning':case 'refuge-outage':N('triangle',330,164,.6,.05);N('noise',900,0,.25,.035,'sfx',0,{type:'bandpass',freq:1600});break;\n      case 'static-block':N('noise',3000,0,.04,.025,'sfx',0,{type:'highpass',freq:2600});break;\n      case 'immune':N('sine',980,430,.06,.025);break;\n    }\n  }\n  function dispose(){if(disposed)return;disposed=true;if(synth)synth.stop();if(gates)for(const g of Object.values(gates))try{g.disconnect();}catch{}played.clear();}\n  function suspend(){setSilence(true);}\n  return{unlock,update,event,dispose,suspend,debug:()=>({enabled,disposed,silent,sequence,sector,...(synth?synth.stats():{active:0,created:0,stopped:false}),musicVolume:A.musicVolume,sfxVolume:A.sfxVolume,voiceVolume:A.voiceVolume,muted:A.muted})};\n}\nasync function offlineProof(){\n  const Offline=root.OfflineAudioContext||root.webkitOfflineAudioContext;if(!Offline)return{available:false};\n  const ctx=new Offline(1,48000*2,48000),bus=ctx.createGain();bus.gain.value=.7;bus.connect(ctx.destination);\n  const synth=createSynth(ctx,{sfx:bus,music:bus,voice:bus});\n  synth.note('noise',1000,0,.3,.12,'sfx',0,{freq:1500});synth.note('sine',180,45,.5,.13);synth.note('triangle',220,440,.33,.07,'music',.36);synth.chatter(false,.8);synth.chatter(true,1.25);\n  const result=await ctx.startRendering(),d=result.getChannelData(0);let peak=0,sum=0,tail=0,finite=true;\n  for(let i=0;i<d.length;i++){const x=d[i];if(!Number.isFinite(x))finite=false;peak=Math.max(peak,Math.abs(x));sum+=x*x;if(i>d.length-2000)tail+=x*x;}\n  return{available:true,finite,peak,rms:Math.sqrt(sum/d.length),tailRms:Math.sqrt(tail/2000),samples:d.length};\n}\nroot.RuinAudio={create,offlineProof};\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat Yars-*/src/content.js && sed -n '1,160p' Yars-*/src/sim.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat Yars-*/src/content.js && sed -n '1,160p' Yars-*/src/sim.js\"","aggregated_output":"/* Authored encounter data. Coordinates are the overhead x/y plane; z is decorative. */\n(() => {\n  'use strict';\n  const defaults = {\n    scoutSpeed: 215, biteInterval: 0.15, chargeThreshold: 5, primaryInterval: 0.105,\n    cannonSpeed: 840, cannonWindup: 0.28, pursuerSpeed: 51, pursuerTurn: 2.2,\n    swirlSpeed: 258, swirlTelegraph: 1.2, refugeOutage: 3.4, reserveCount: 3,\n  };\n  const ranges = {\n    scoutSpeed: { label: 'Scout speed', min: 100, max: 360, step: 5, unit: 'u/s' },\n    biteInterval: { label: 'Bite cadence', min: 0.06, max: 0.4, step: 0.01, unit: 's' },\n    chargeThreshold: { label: 'Bites to charge', min: 1, max: 12, step: 1, unit: 'cells' },\n    primaryInterval: { label: 'Primary cadence', min: 0.045, max: 0.3, step: 0.005, unit: 's' },\n    cannonSpeed: { label: 'Siege speed', min: 350, max: 1300, step: 10, unit: 'u/s' },\n    cannonWindup: { label: 'Siege warning', min: 0.15, max: 1.2, step: 0.01, unit: 's' },\n    pursuerSpeed: { label: 'Pursuer speed', min: 15, max: 130, step: 1, unit: 'u/s' },\n    pursuerTurn: { label: 'Pursuer turning', min: 0.3, max: 5, step: 0.1, unit: 'rad/s' },\n    swirlSpeed: { label: 'Swirl speed', min: 120, max: 450, step: 5, unit: 'u/s' },\n    swirlTelegraph: { label: 'Swirl warning', min: 0.7, max: 3, step: 0.1, unit: 's' },\n    refugeOutage: { label: 'Refuge outage', min: 1, max: 7, step: 0.1, unit: 's' },\n    reserveCount: { label: 'Replacement scouts', min: 0, max: 8, step: 1, unit: 'scouts' },\n  };\n  function arch() {\n    const cells = [];\n    for (let row = -7; row <= 7; row++) {\n      for (let col = -8; col <= 3; col++) {\n        const d = Math.hypot(col * 20, row * 20);\n        if (d >= 100 && d <= 162 && col <= 1) cells.push({ x: 810 + col * 20, y: 270 + row * 20, plate: 0, material: 'normal' });\n      }\n    }\n    return cells;\n  }\n  function plates() {\n    const cells = [];\n    for (let row = -7; row <= 7; row++) {\n      for (let col = 0; col < 3; col++) {\n        cells.push({ x: 650 + col * 20, y: 270 + row * 20, plate: 0, material: col === 0 && (row + 7) % 4 === 0 ? 'reflective' : 'normal' });\n        if (Math.abs(row) <= 5) cells.push({ x: 745 + col * 20, y: 270 + row * 20, plate: 1, material: col === 2 && (row + 5) % 4 === 0 ? 'reflective' : 'normal' });\n      }\n    }\n    return cells;\n  }\n  function carapace() {\n    const cells = [];\n    for (let row = -8; row <= 8; row++) {\n      for (let col = -9; col <= 4; col++) {\n        const d = Math.hypot(col * 20, row * 20);\n        if (d >= 115 && d <= 188 && col <= 2) cells.push({ x: 810 + col * 20, y: 270 + row * 20, plate: col < -5 ? 0 : 1, material: ((row + 8) % 5 === 0 && col < -4) ? 'reflective' : 'normal' });\n      }\n    }\n    return cells;\n  }\n  const sectors = [\n    {\n      id: 'cinder-gate', name: 'CINDER GATE', subtitle: 'THE OUTER SHELL',\n      introduction: 'Our home is static. We still hear its wings.',\n      clearLine: 'The first voice falls silent. Beyond it: a second mouth.',\n      palette: { bg: '#07141c', floor: '#102631', shadow: '#050d15', accent: '#50e1bd', shield: '#db704d', core: '#ff526f', light: '#8cf7d4', static: '#53a4b5' },\n      musicRoot: 43, musicTempo: 88, silhouette: 'arch', hp: 1, pursuers: 1,\n      swirlDelay: 14, swirlPeriod: 18, refuge: { x: 355, w: 100 },\n      plates: [{ id: 0, x: 0, y: 0, amplitude: 0, period: 9, phase: 0 }], cells: arch(),\n      core: { x: 810, y: 270, hp: 1 },\n      lessons: ['Move and fire to carve a path.', 'Touch the shell: five bites fill your siege gun.', 'Static hides you from pursuers. It silences both weapons.', 'Align with the heart. Call the rail gun. Leave its lane.'],\n    },\n    {\n      id: 'glass-sepulcher', name: 'GLASS SEPULCHER', subtitle: 'THE MOVING DEFENSE',\n      introduction: 'It has learned to wear mirrors. Break the reflection.',\n      clearLine: 'Behind the glass, the hollow mind is awake.',\n      palette: { bg: '#140e24', floor: '#271e39', shadow: '#0a0914', accent: '#e2b85b', shield: '#9873d1', core: '#ff7768', light: '#efd08a', static: '#a980d4' },\n      musicRoot: 46, musicTempo: 98, silhouette: 'plates', hp: 2, pursuers: 2,\n      swirlDelay: 11, swirlPeriod: 15, refuge: { x: 355, w: 100 },\n      plates: [{ id: 0, x: 0, y: 0, amplitude: 35, period: 10, phase: 0 }, { id: 1, x: 0, y: 0, amplitude: 42, period: 10, phase: Math.PI }], cells: plates(),\n      core: { x: 845, y: 270, hp: 2 },\n      lessons: ['Diamond cells return one siege shot. Watch the amber return lane.', 'The plates move. A breach stays broken.', 'Two heart strikes will silence this station.'],\n    },\n    {\n      id: 'null-regent', name: 'THE NULL REGENT', subtitle: 'THE FORTRESS INTELLIGENCE',\n      introduction: 'Little wings, says the mind. Nothing survives the signal.',\n      clearLine: 'Nothing? Listen.',\n      palette: { bg: '#1b0c19', floor: '#321b2a', shadow: '#0c0810', accent: '#6bd9ed', shield: '#c95270', core: '#ffbe67', light: '#ffbe83', static: '#b96c98' },\n      musicRoot: 39, musicTempo: 108, silhouette: 'crown', hp: 3, pursuers: 2,\n      swirlDelay: 10, swirlPeriod: 13, refuge: { x: 355, w: 100 },\n      plates: [{ id: 0, x: 0, y: 0, amplitude: 17, period: 12, phase: 0 }, { id: 1, x: 0, y: 0, amplitude: 0, period: 12, phase: 0 }], cells: carapace(),\n      core: { x: 810, y: 270, hp: 3 },\n      lessons: ['The refuge will fracture. Its borders warn you first.', 'Strip the shell. Catch the moving heart.', 'The last strike must find it in flight.', 'When it docks, touch the blue heart to refill. Then intercept.'],\n    },\n  ];\n  globalThis.RuinContent = { version: 1, defaults, ranges, sectors, scouts: [{ name: 'RILL', color: '#65f4cb' }, { name: 'VENN', color: '#ffd37f' }] };\n})();\n/* A single authoritative, deterministic overhead simulation. No browser, audio or drawing state. */\n(() => {\n  'use strict';\n  const C = globalThis.RuinContent;\n  const W = 960, H = 540, TAU = Math.PI * 2, DT = 1 / 120;\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\n  const wrap = (v, n = H) => ((v % n) + n) % n;\n  const dy = (a, b) => wrap(a - b + H / 2) - H / 2;\n  const copy = value => JSON.parse(JSON.stringify(value));\n  const finite = (value, fallback = 0) => Number.isFinite(Number(value)) ? Number(value) : fallback;\n  const approach = (v, to, d) => v < to ? Math.min(to, v + d) : Math.max(to, v - d);\n  const dist = (a, b) => Math.hypot(a.x - b.x, dy(a.y, b.y));\n  const turn = (a, b, step) => a + clamp(Math.atan2(Math.sin(b - a), Math.cos(b - a)), -step, step);\n  function rng(w) {\n    let v = w.rngCombat | 0; v ^= v << 13; v ^= v >>> 17; v ^= v << 5;\n    w.rngCombat = v >>> 0; return w.rngCombat / 4294967296;\n  }\n  function event(w, type, x = 480, y = 270, extra = {}) {\n    const ev = { id: ++w.eventId, type, x, y, tick: w.tick, ...extra };\n    w.events.push(ev); w.eventLog.push(ev);\n    if (w.eventLog.length > 64) w.eventLog.shift();\n    return ev;\n  }\n  function say(w, text, seconds = 4) { w.message = text; w.messageTime = seconds; }\n  function mark(w, key) { w.learned[key] = true; }\n  function addScore(w, amount, kind, player) {\n    const points = Math.round(amount * w.chain);\n    w.score += points; w.stats[kind] = (w.stats[kind] || 0) + points;\n    w.chain = Math.min(3, w.chain + 0.08); w.chainTime = 4;\n    if (player != null && w.players[player]) w.players[player].score += points;\n    return points;\n  }\n  function isStatic(w, p) { return w.refuge.active && p.x >= w.refuge.x && p.x <= w.refuge.x + w.refuge.w; }\n  function contentFor(w) { return w.customContent || C.sectors[w.sector]; }\n  function ready(w, p) { return p.charge >= w.tuning.chargeThreshold - 1e-6; }\n  function charge(w, p, amount, refill = false) {\n    const was = ready(w, p);\n    p.charge = Math.min(w.tuning.chargeThreshold, p.charge + amount); p.ready = ready(w, p);\n    if (!was && p.ready) { event(w, 'charge', p.x, p.y, { player: p.index }); mark(w, 'charge'); say(w, 'SIEGE READY — align with the heart. Fire, then leave the lane.', 3); }\n    if (refill) event(w, 'refill', p.x, p.y, { player: p.index });\n  }\n  function removeCell(w, cell, kind, p) {\n    if (!cell.alive) return false;\n    cell.alive = false;\n    const player = p ? p.index : -1;\n    const score = addScore(w, kind === 'bite' ? 45 : kind === 'cannon' ? 4 : 12, kind === 'bite' ? 'bites' : 'breaches', player);\n    event(w, kind === 'bite' ? 'bite' : 'chip', cell.x, cell.y, { player, material: cell.material, score, cell: cell.id });\n    if (kind === 'bite' && p) { charge(w, p, 1); p.biteFlash = 0.15; w.stats.biteCount++; mark(w, 'bite'); }\n    if (kind === 'primary') { w.stats.shotCells++; mark(w, 'shoot'); }\n    return true;\n  }\n  function normalizeAction(a, p) {\n    a = a || {};\n    let mx = clamp(finite(a.mx), -1, 1), my = clamp(finite(a.my), -1, 1), ax = clamp(finite(a.ax, p.ax), -1, 1), ay = clamp(finite(a.ay, p.ay), -1, 1);\n    const m = Math.hypot(mx, my), aim = Math.hypot(ax, ay);\n    if (m > 1) { mx /= m; my /= m; }\n    if (aim > 0.05) { ax /= aim; ay /= aim; } else { ax = p.ax; ay = p.ay; }\n    return { mx, my, ax, ay, fire: a.fire === true, cannon: a.cannon === true };\n  }\n  function makePlayer(index, id) {\n    return { id: id == null ? index + 1 : id, index, x: 130, y: index ? 340 : 210, vx: 0, vy: 0, ax: 1, ay: 0, r: 9, alive: true, departed: false, respawn: 0, invuln: 2.2, charge: 0, ready: false, biteTimer: 0, biteFlash: 0, fireTimer: 0, refillTimer: 0, blockedTimer: 0, wrapFlash: 0, score: 0, deadReason: '' };\n  }\n  function initSector(w, sector, custom = null) {\n    w.sector = clamp(Math.round(sector), 0, 2); w.customContent = custom;\n    const data = contentFor(w);\n    w.sectorTime = 0; w.phase = 0; w.phaseTime = 0; w.mode = 'play'; w.transitionTime = 0;\n    w.cells = data.cells.map((c, i) => ({ id: i, baseX: c.x, baseY: c.y, x: c.x, y: c.y, plate: c.plate || 0, material: c.material || 'normal', alive: true, size: 20 }));\n    w.plates = data.plates.map(p => ({ ...copy(p), dx: 0, dy: 0 }));\n    const dc = data.core || { x: 810, y: 270, hp: data.hp || w.sector + 1 };\n    w.core = { x: dc.x, y: dc.y, dockX: dc.x, dockY: dc.y, hp: dc.hp, maxHp: dc.hp, state: 'dock', timer: data.swirlDelay || 14, phase: 0, angle: 0, r: 28, vx: 0, vy: 0, hitGrace: 0, flightTime: 0, targetX: 0, targetY: 0, launches: 0, needleTimer: 2.8 };\n    w.shots = []; w.hazards = []; w.cannons = [];\n    w.refuge = { x: data.refuge.x, w: data.refuge.w, active: true, warning: false, cycle: 0, outageTimer: 0 };\n    w.tutorial = 0; w.learned = {};\n    for (const p of w.players) {\n      if (p.departed) continue;\n      Object.assign(p, { alive: true, respawn: 0, x: 130, y: p.index ? 340 : 210, vx: 0, vy: 0, charge: 0, ready: false, invuln: 2.4, biteTimer: 0, fireTimer: 0, refillTimer: 0, blockedTimer: 0, biteFlash: 0, wrapFlash: 0 });\n    }\n    for (let i = 0; i < (data.pursuers || 1); i++) spawnPursuer(w, i);\n    say(w, data.introduction || 'A shell of stolen light. A heart behind it.', 4.5);\n    event(w, 'sector-start', w.core.x, w.core.y, { sector: w.sector });\n  }\n  function create(options = {}) {\n    const tuning = { ...C.defaults };\n    if (options.assist) { tuning.swirlTelegraph = 1.9; tuning.pursuerSpeed = 38; tuning.reserveCount = 6; tuning.cannonWindup = 0.4; }\n    if (options.tuning) for (const k of Object.keys(C.ranges)) if (k in options.tuning) tuning[k] = clamp(finite(options.tuning[k], tuning[k]), C.ranges[k].min, C.ranges[k].max);\n    const seed = (finite(options.seed, 1982) >>> 0) || 1982;\n    let custom = null;\n    if (options.content) { const valid = validateContent(options.content); if (valid.ok) custom = valid.content; }\n    const count = Array.isArray(options.players) ? options.players.length : clamp(Math.round(finite(options.players, 1)), 1, 2);\n    const w = { version: 1, W, H, tick: 0, time: 0, seed, rngCombat: seed, eventId: 0, nextId: 1, sector: 0, mode: 'play', phase: 0, phaseTime: 0,\n      assist: !!options.assist, practice: !!options.practice || !!custom, attract: !!options.attract, tuning, players: Array.from({ length: count }, (_, i) => makePlayer(i, Array.isArray(options.players) ? options.players[i] : undefined)),\n      reserves: Math.min(8, tuning.reserveCount + (count - 1)), reserveCap: 8, score: 0, chain: 1, chainTime: 0, events: [], eventLog: [], message: '', messageTime: 0, tutorial: 0, learned: {},\n      stats: { bites: 0, breaches: 0, hearts: 0, ending: 0, biteCount: 0, shotCells: 0, shots: 0, cannonFired: 0, cannonMissed: 0, coreHits: 0, airborne: 0, deaths: 0, cleared: 0, refills: 0 },\n      dev: { invulnerable: false, infiniteCharge: false, collisions: false }, outcomeAwarded: false, pendingTuning: {}, errors: [], customContent: null };\n    initSector(w, finite(options.sector), custom);\n    return w;\n  }\n  function spawnPursuer(w, variant = 0) {\n    const id = w.nextId++;\n    const h = { id, kind: 'pursuer', x: 860 - variant * 55, y: wrap(85 + variant * 345), vx: -w.tuning.pursuerSpeed, vy: 0, r: variant ? 8 : 9, angle: Math.PI, target: variant % Math.max(1, w.players.length), life: 1e6, variant, age: 0 };\n    w.hazards.push(h); return h;\n  }\n  function safeSpawn(w, p) {\n    const candidates = [90, 450, 180, 360, 270, 15, 525];\n    let best = candidates[0], bestD = -1;\n    for (const y of candidates) {\n      let nearest = 1e6;\n      for (const h of w.hazards) nearest = Math.min(nearest, Math.hypot(h.x - 130, dy(h.y, y)));\n      for (const c of w.cannons) if (Math.abs(dy(c.y, y)) < 35) nearest = Math.min(nearest, Math.abs(c.x - 130));\n      if (w.core.state === 'flight' || w.core.state === 'return') nearest = Math.min(nearest, Math.hypot(w.core.x - 130, dy(w.core.y, y)));\n      if (nearest > bestD) { bestD = nearest; best = y; }\n    }\n    p.x = 130; p.y = best; p.vx = p.vy = 0; p.alive = true; p.respawn = 0; p.invuln = 2.4; p.charge = 0; p.ready = false;\n    p.refillTimer = 0; p.fireTimer = 0; p.biteTimer = 0;\n    event(w, 'respawn', p.x, p.y, { player: p.index });\n  }\n  function kill(w, p, reason) {\n    if (!p.alive || p.invuln > 0 || p.departed || w.mode !== 'play' || w.dev.invulnerable || w.attract) return false;\n    p.alive = false; p.charge = 0; p.ready = false; p.vx = p.vy = 0; p.deadReason = reason;\n    w.stats.deaths++; w.chain = 1; w.chainTime = 0;\n    if (w.reserves > 0) { w.reserves--; p.respawn = 1.3; } else p.respawn = 0;\n    event(w, 'death', p.x, p.y, { player: p.index, reason });\n    return true;\n  }\n  function updatePlates(w) {\n    for (const plate of w.plates) {\n      const shift = w.sector === 1 && w.phase > 0 ? Math.PI / 2 : 0;\n      plate.dy = Math.sin(w.sectorTime * TAU / plate.period + plate.phase + shift) * plate.amplitude;\n      plate.dx = 0;\n    }\n    for (const c of w.cells) {\n      const p = w.plates.find(p => p.id === c.plate);\n      c.x = c.baseX + (p ? p.dx : 0); c.y = wrap(c.baseY + (p ? p.dy : 0));\n    }\n  }\n  function cellOverlap(x, y, radius, c) {\n    const half = c.size / 2;\n    const xx = Math.max(Math.abs(x - c.x) - half, 0), yy = Math.max(Math.abs(dy(y, c.y)) - half, 0);\n    return xx * xx + yy * yy <= radius * radius;\n  }\n  function resolveCells(w, p) {\n    for (const c of w.cells) {\n      if (!c.alive || !cellOverlap(p.x, p.y, p.r, c)) continue;\n      const dx = p.x - c.x, ddy = dy(p.y, c.y), limit = c.size / 2 + p.r;\n      const pushX = limit - Math.abs(dx), pushY = limit - Math.abs(ddy);\n      if (pushX < pushY) { p.x += (dx < 0 ? -1 : 1) * Math.max(0, pushX); p.vx = 0; }\n      else { p.y = wrap(p.y + (ddy < 0 ? -1 : 1) * Math.max(0, pushY)); p.vy = 0; }\n    }\n  }\n  function playerStep(w, p, action, dt) {\n    if (p.departed) return;\n    if (!p.alive) { if (p.respawn > 0) { p.respawn -= dt; if (p.respawn <= 0) safeSpawn(w, p); } return; }\n    const a = normalizeAction(action, p), speed = w.tuning.scoutSpeed;\n    p.ax = a.ax; p.ay = a.ay;\n    for (const k of ['invuln', 'biteTimer', 'biteFlash', 'fireTimer', 'refillTimer', 'blockedTimer', 'wrapFlash']) p[k] = Math.max(0, p[k] - dt);\n    if (w.dev.infiniteCharge || w.attract) p.charge = w.tuning.chargeThreshold;\n    p.ready = ready(w, p);\n    p.vx = approach(p.vx, a.mx * speed, dt * (Math.abs(a.mx) > .02 ? 2300 : 3200));\n    p.vy = approach(p.vy, a.my * speed, dt * (Math.abs(a.my) > .02 ? 2300 : 3200));\n    const oldY = p.y;\n","exit_code":0,"status":"completed"}}
