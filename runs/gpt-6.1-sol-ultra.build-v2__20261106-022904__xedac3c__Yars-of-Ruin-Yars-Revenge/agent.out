ector: -1, fireAt: -10, lane: 270, evadeSign: 1, avoidSide: index ? -1 : 1, previousCharge: 0 };\n    function action(w) {\n      const p = w.players[index], core = w.core;\n      if (!p || !p.alive || p.departed || w.mode !== 'play') return zero();\n      if (memory.sector !== w.sector) { memory.sector = w.sector; memory.fireAt = -10; memory.previousCharge = 0; }\n      const speed = w.tuning.scoutSpeed, ready = p.charge >= w.tuning.chargeThreshold;\n      const final = w.sector === 2 && core.hp === 1;\n      let tx = p.x, ty = p.y, fire = true, cannon = false;\n      let aimX = core.x, aimY = core.y;\n      const own = w.cannons.find(c => c.owner === index && c.life > 0);\n      const evade = own || w.time - memory.fireAt < 1.5;\n      const go = (x, y) => { tx = x; ty = wrap(y); };\n      const shotTime = () => w.tuning.cannonWindup + Math.max(0, (core.x - 30 + core.vx * w.tuning.cannonWindup) / (w.tuning.cannonSpeed - core.vx));\n      if (evade) {\n        const lane = own ? own.y : memory.lane;\n        go(p.x > 760 ? 875 : 570, lane + memory.evadeSign * 115);\n      } else if (core.state === 'phase-break') {\n        go(index ? 570 : 610, index ? 405 : 135);\n      } else if (!ready) {\n        if (core.state === 'dock') {\n          go(core.x - 12, core.y);\n          const cells = w.cells.filter(c => c.alive && Math.abs(dy(c.y, core.y)) < 32 && c.x > p.x - 20).sort((a, b) => a.x - b.x);\n          const cell = cells[0];\n          if (cell && p.x < core.x - 45) { go(cell.x, cell.y); aimX = cell.x; aimY = cell.y; fire = false; }\n        } else go(570, index ? 110 : 430);\n      } else if (core.state === 'dock' && !final) {\n        const travel = w.tuning.cannonWindup + (core.x - 30) / w.tuning.cannonSpeed;\n        const targetY = w.sector === 2 && core.hp === 2 ? wrap(core.dockY + Math.sin((w.sectorTime + travel) * .65) * 55) : core.y;\n        const obstruction = w.cells.filter(c => c.alive && c.x < core.x - 30 && Math.abs(dy(c.y, targetY)) < 19).sort((a, b) => a.x - b.x)[0];\n        if (obstruction) { go(obstruction.x - 20, obstruction.y); aimX = obstruction.x; aimY = obstruction.y; }\n        else {\n          go(570, targetY);\n          if (Math.abs(dy(p.y, targetY)) < 15 && p.x > w.refuge.x + w.refuge.w + 15 && core.timer > travel + .15) cannon = true;\n        }\n      } else if (core.state === 'dock') {\n        go(570, core.y + (index ? -90 : 90));\n      } else if (core.state === 'windup' || core.state === 'flight' || core.state === 'return') {\n        let time = shotTime();\n        if (core.state === 'windup') time = Math.max(0, time - core.timer);\n        const targetY = wrap(core.y + core.vy * time);\n        go(570, targetY);\n        const clear = !w.cells.some(c => c.alive && c.x < core.x - 30 && Math.abs(dy(c.y, targetY)) < 18);\n        if (Math.abs(dy(p.y, targetY)) < 16 && p.x > w.refuge.x + w.refuge.w + 15 && clear && core.x > 200 && (core.state !== 'windup' || core.timer < .25)) cannon = true;\n      }\n      // Avoid every active gun lane, including the other scout's locked warning.\n      for (const c of w.cannons) {\n        const crossing = c.vx > 0 ? c.x < p.x + 35 : c.x > p.x - 35;\n        if (crossing && Math.abs(dy(p.y, c.y)) < 65 && c.life > 0) {\n          const side = dy(p.y, c.y) || memory.evadeSign;\n          ty = wrap(c.y + Math.sign(side) * 115);\n","exit_code":0,"status":"completed"}}
