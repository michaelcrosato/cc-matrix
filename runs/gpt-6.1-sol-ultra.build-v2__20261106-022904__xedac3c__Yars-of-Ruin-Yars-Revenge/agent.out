{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > Yars-of-Ruin-Yars-Revenge-gpt-6.1-sol-ultra-20261106-022904/src/main.js <<'EOF'\n/* GAME START — adapted from SHOOTER's overhead x/y scene and fixed-step shell. */\n(() => {\n'use strict';\nconst E=My3D2dge,SIM=RuinSim,C=RuinContent,hasDOM=typeof document\"'!=='\"'undefined';\nconst embedded=typeof AIHub\"'!=='\"'undefined'&&AIHub.active;\nlet world=null,online=null,attract=false,fromAttract=false,ui,controls,editor,visuals,sound,menuMode='title',idleAt=0,lastHUD=-1,lastMode='',lastSector=-1,resultWorld=null,captionUntil=0,captionText='',frozen=false,speed=1,stepCount=0,devQueue=[],onlineEnded=false;\nconst game=new E.Game({canvas:'screen',id:'yars-of-ruin-v1',view:'overhead',views:['overhead'],res:[960,540],expand:false,bg:'#070f18',input:RuinControls.MAP,autoPause:\"'!embedded,fullscreen:embedded?false:'\"'button',live:embedded,draw:true,menu:{quit:embedded?false:'title',controls:{fire:'Primary shot',cannon:'Siege cannon'},items:()=>embedded?[['About / Credits',()=>about()]]:[['How to Play',()=>howto()],['Developer tools',()=>dev()],['About / Credits',()=>about()]],settings:[{key:'music',value:.10},{key:'glyphs',value:'playstation'},{key:'moveAim',label:'Keyboard aim follows movement',value:true,help:'Pointer movement always takes over mouse aim.'},{key:'aimAssist',label:'Controller / touch aim assist',value:true},{key:'stickFire',label:'Right-stick auto fire',value:false}]}});\nglobalThis.__game=game;\ngame.fadeTime=0;game.cam.smooth=0;\nconst report=globalThis.RUIN_REPORT||{};\nconst \"'$=id=>hasDOM?document.getElementById(id):null;\nconst glyph=()=>game.input.lastDevice==='\"'gamepad';\nconst zero={mx:0,my:0,ax:1,ay:0,fire:false,cannon:false};\nconst copy=o=>JSON.parse(JSON.stringify(o));\nconst sectorName=i=>C.sectors[i]?.name||['The Cinder Gate','The Glass Choir','The Last Intelligence'][i];\nfunction tell(text,seconds=3){captionText=String(text||'');captionUntil=game.real+seconds;if(\"'$('\"'caption')){\"'$('\"'caption').textContent=captionText;\"'$('\"'caption').hidden=\"'!text;}}\nfunction fx(w,events=w.events||[]){for(const ev of events){visuals.event(ev,w);sound.event(ev,w);if(ev.type==='\"'death')game.input.rumble(.5,.18);if(['reflected','reflection','refuge-warning','airborne-bonus','refill','core-hit'].includes(ev.type)&&ev.message)tell(ev.message,3);}}\nfunction setPlaying(on){if(hasDOM){document.body.dataset.playing=String(on);\"'$('\"'game-hud').hidden=\"'!on;$('\"'demo-mark').hidden=\"'!attract;}}\nfunction resetInput(){controls&&controls.clear();game.timeScale=1;speed=1;frozen=false;stepCount=0;devQueue=[];}\nfunction title(){if(embedded)return;onlineEnded=false;attract=false;resetInput();sound&&sound.update(0,world,{paused:true,silent:true});world=SIM.create({seed:9182,players:1,attract:true});world.players[0].x=604;world.players[0].y=285;world.players[0].charge=world.tuning.chargeThreshold;world.players[0].ready=true;idleAt=game.real;menuMode='\"'title';lastMode='';setPlaying(false);if(\"'$('\"'caption'))\"'$('\"'caption').hidden=true;showTitle();}\nfunction showTitle(){const high=E.store.get('ruin:record:solo:normal',0);ui.hide();ui.show('title',{kicker:'A signal from the ruined swarm',name:'Yars of Ruin',subtitle:'A tiny living weapon. An enormous last reply.',text:'They made a tomb of our sky.\\\\nBite through the shell. Give the silence teeth.',actions:[['Begin the siege  →',()=>start({})],['Local co-op',localLobby],['Sector practice',practiceMenu],['How to Play',howto],['Settings',()=>ui.show('settings')],['About / Credits',()=>about()]],meta:['3 sectors','1–2 scouts','Siege / survive'],footer:'Normal / Assist in campaign setup · Online co-op when launched by AI Hub'+(high?' · Best '+high.toLocaleString():''),back:()=>{}});}\nfunction start(options={}){if(embedded)return;ui.show('launch',{kicker:options.coop?'Two scouts · one swarm':'One scout · one swarm',title:'Choose your signal',text:'One hit costs a scout. Your replacements are shared. Every defense can be breached.',actions:[['Normal',()=>begin({...options,assist:false})],['Assist',()=>begin({...options,assist:true})],['Back',()=>ui.back()]],sections:[['ASSIST','Longer warnings, gentler pursuit, extra reserves. Every siege mechanic remains. Records are kept separately.']]});}\nfunction localLobby(){ui.show('local',{kicker:'Simultaneous local co-op',title:'Bring another pair of wings',text:'Use two controllers, or keyboard / mouse and one controller. Without controllers: P1 uses WASD + J / Space; P2 uses arrows + . / /. Both scouts link to their own siege gun.',actions:[['Launch two scouts',()=>start({coop:true})],['Back',()=>ui.back()]],sections:[['ONLINE','AI Hub supplies online sessions. Launch this game there with one or two players; the shared campaign starts automatically.']]});}\nfunction practiceMenu(){const unlocked=E.store.get('ruin:unlocked',0);ui.show('practice',{kicker:'Practice · no campaign record',title:'Return to a broken signal',text:'Sectors become available as you discover them during a campaign.',actions:C.sectors.map((s,i)=>({label:String(i+1).padStart(2,'0')+'  '+s.name,disabled:i>unlocked,fn:()=>start({sector:i,practice:true})})).concat([['Back',()=>ui.back()]])});}\nfunction begin(options={}){attract=\"'!!options.attract;resetInput();controls.setCoop(!!options.coop);world=SIM.create({players:options.coop?2:1,seed:options.seed??((Date.now()''^0x59415253)>>>0),assist:!!options.assist,practice:!!options.practice,sector:options.sector||0,attract});lastMode='\"'';lastSector=-1;resultWorld=null;menuMode='play';ui.hide();game.resume();game.go('play',null,{fade:0});setPlaying(true);if(\"'!attract)tell('\"'VESPER: The swarm remembers. Leave no heart beating.',4);sound.unlock();return world;}\nfunction howto(){ui.show('help',{kicker:'Field transmission',title:'Give the silence teeth',sections:[['01 / OPEN A PATH','Hold primary fire to chip shield cells. Fly into a cell to bite it safely. Bites score more and fill your cannon charge. Five bites ready a shot.'],['02 / CALL THE CANNON','Align your scout with the heart. Call the gun on the left rail, then move vertically out of its lane. The enormous projectile can kill either scout. A blocked shot is spent. Diamond cells reflect it once.'],['03 / TRUST THE STATIC, CAREFULLY','The bright band blocks guided pursuer damage, but disables both weapons. It never blocks a Swirl or your cannon. Top and bottom edges connect.'],['04 / BREAK THE HEART','Primary fire cannot hurt the heart. The fortress itself becomes the Swirl. A cannon interception earns a reserve. Brush its green docked heart for renewable charge. The final heart must be shot in flight.']],keys:[[glyph()?'Left stick':'WASD / arrows','Fly'],[glyph()?'Right stick':'Mouse / movement','Aim'],[controls.label('fire'),'Primary shot'],[controls.label('cannon'),'Call siege cannon'],[game.input.label('pause'),'Pause / back']],actions:[['Understood',()=>ui.back()]]});}\nfunction about(page=0){const info=report.sourceInformation||{},pages=[['Source Information',Object.entries(info).map(([k,v])=>[k[0].toUpperCase()+k.slice(1),v])],['Testing Feedback',(report.testingFeedback||[]).map((v,i)=>[['Issues found','Critical issues','Most helpful test','Least helpful test'][i],v])],['Engine Feedback',(report.engineFeedback||[]).map((v,i)=>[['Liked most','Got stuck / guessed wrong','Built ourselves','Hardest part','Engine changes','One improvement'][i],v])],['Prompt Feedback',(report.promptFeedback||[]).map((v,i)=>[['Liked most','Confusing','Hardest task','Suggested change'][i],v])]];ui.show('about'+page,{kicker:'Yars of Ruin · original work, inspired by Atari',title:pages[page][0],sections:pages[page][1],text:page===0?'Original game: Howard Scott Warshaw / Atari, 1982. Code, art, animation and audio in this adaptation are authored for this game. No recorded audio or external art assets.':undefined,actions:[...(page<3?[[pages[page+1][0]+'  →',()=>about(page+1)]]:[]),['Back',()=>ui.back()]]});}\nfunction dev(){if(embedded){ui.show('diagnostics',{title:'Session diagnostics',text:()=>JSON.stringify(online?.debug||{}),actions:[['Back',()=>ui.back()]]});return;}world.practice=true;const T=world.tuning;for(const k of Object.keys(C.ranges)){game.settings.set('dev_'+k,T[k]);}ui.show('dev',{kicker:'Designer tools · this run is practice',title:'Listen inside the signal',text:()=>\"'`Seed ${world.seed} · tick ${world.tick} · sector ${world.sector+1} · phase ${world.phase+1} · ${frozen?'\"'FROZEN':'RUNNING'}\"'`,rows:['\"'dev_invulnerable','dev_infiniteCharge','dev_collisions','dev_timeScale'],actions:[['Live balance sliders',balance],['Encounter / phase selector',encounters],['Shield-layout editor',()=>editor.show(true)],['Freeze / unfreeze',()=>{frozen=\"'!frozen;ui.show('\"'dev',{});}],['Advance one tick',()=>{stepCount++;}],['Restart encounter',()=>{queue('restart');ui.hide();game.resume();}],['Spawn guided threat',()=>{queue('spawnThreat');}],['Seed tools',seedScreen],['Reset to Defaults',()=>{queue('resetTuning');for(const k of Object.keys(C.defaults))if(game.settings.spec('dev_'+k))game.settings.set('dev_'+k,C.defaults[k]);for(const k of ['invulnerable','infiniteCharge','collisions'])game.settings.set('dev_'+k,false);frozen=false;speed=1;game.settings.set('dev_timeScale',1);}],['Back to pause',()=>ui.back()]]});}\nfunction balance(){ui.show('balance',{kicker:'Live tuning · applied on fixed steps',title:'Shape the danger',rows:Object.keys(C.ranges).map(k=>'dev_'+k),actions:[['Reset to Defaults',()=>{queue('resetTuning');for(const k of Object.keys(C.ranges))game.settings.set('dev_'+k,C.defaults[k]);ui.show('balance',{});}],['Back',()=>ui.back()]]});}\nfunction encounters(){ui.show('encounters',{kicker:'Practice selector',title:'Any heart. Any wound.',actions:C.sectors.map((s,i)=>[\"'`${i+1} / ${s.name}`,()=>{queue('\"'sector',i);ui.hide();game.resume();}]).concat([0,1,2].map(p=>['Boss phase '+(p+1),()=>{queue('sector',2);queue('phase'