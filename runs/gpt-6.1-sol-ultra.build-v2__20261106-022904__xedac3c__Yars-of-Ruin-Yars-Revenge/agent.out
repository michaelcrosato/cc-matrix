{"type":"item.started","item":{"id":"item_124","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,pathlib,hashlib\nD=pathlib.Path('.').resolve();A=D/'tests/artifacts';summary=json.loads((A/'test-summary.json').read_text());assert summary['passed']==177 and summary['failed']==0\nf=D.parent/(D.name+'.html');r=json.loads((D.parent/'exit-interview.json').read_text());assert f.read_bytes()==(D/'index.html').read_bytes();assert [len(r[k])for k in ['testingFeedback','engineFeedback','promptFeedback']]==[4,6,4];assert r['sourceInformation']['usage']=='added on import'\nproof=[]\nfor scenario in ['standard','server']:\n data=json.loads((A/f'hub-campaign-{scenario}.json').read_text());host=next(w for w in data['worlds'] if w['host']);s=host['s'];proof.append({'scenario':scenario,'players':len(s['players']),'outcome':s['mode'],'seconds':s['time'],'score':s['score'],'coreHits':s['stats']['coreHits'],'airborne':s['stats']['airborne'],'deaths':s['stats']['deaths'],'maxPacketBytes':host['net']['maxBytes'],'sendDrops':host['net']['dropped']});assert s['mode']=='victory' and s['stats']['coreHits']==6\nresult={'title':r['aiHub']['name'],'passed':177,'failed':0,'html_bytes':f.stat().st_size,'root_and_dev_identical':True,'sha256':hashlib.sha256(f.read_bytes()).hexdigest(),'feedback_counts':[4,6,4],'usage':'added on import','online_campaigns':proof};(A/'delivery.json').write_text(json.dumps(result,indent=2)+'\\\\n')\np=D.parent/'PROGRESS.md';text=p.read_text();a=text.index('## Active final gate');b=text.index('## Ownership',a);text=text[:a]+'''## Final release — complete\n\nFinal single-command verification against the delivered HTML: **177 passed, 0 failed** (\"'`npm test`). Coverage: 35 simulation, 14 online mocks, 5 presentation, 6 sampled-controller, 16 artifact/interview, 58 standalone browser, and 43 Hub checks. All runtime source/tests are frozen after this passing run.\n\nThe final full suite includes actual solo campaign through native transition/results menus, two-player stress campaign at 150 ms latency / 50 ms jitter / 5% loss, and one-player hidden dedicated-server campaign at zero added impairment. Official server stress remains two-player. Final worlds, shield masks, core, reserves, score and tick converge; only host finishes; no simulation/sends after end. See `tests/artifacts/delivery.json` for exact outcomes, counts and artifact SHA-256.\n\nRoot HTML and development index.html are byte-identical. Root exit-interview.json parses with exact 4/6/4 feedback answer counts and Usage `added on import`; the artifact embeds that exact report. Source docs, research, pins, engine patch, authoring preset, tests and evidence are retained. All code/metadata work is complete; only the final user handoff remains.\n\n'\"''' +text[b:];text=text.replace('14 distinct defects found and fixed','15 distinct defects found and fixed').replace('**14 fixed defects, 3 critical**','**15 fixed defects, 3 critical**');p.write_text(text)\np=D/'docs/testing.md';text=p.read_text();release='''## Final release result\n\nThe final packaged HTML passed **177 checks, 0 failures** through \"'`npm test`: 35 simulation, 14 online mocks, 5 presentation, 6 sampled-controller, 16 artifact/interview, 58 standalone browser, and 43 actual Hub checks. Root HTML and development index.html are byte-identical. Exact final hash and online campaign state are recorded in `tests/artifacts/delivery.json`.\n\n'\"''';text=text.replace('## Release checks',release+'## Release checks');text=text.replace('|\\\\n\\\\n|15|','|\\\\n|15|');p.write_text(text)\nprint(json.dumps(result,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
