urn l ? [nx / l, ny / l] : [0, 1];\\n  }\\n  /** a circle in the ground: [nx, ny, depth] (out along the normal by depth clears it), or null */\\n  hit(x, y, r) {\\n    let any = false; const [cc, rr] = this._cell(x, y), R = Math.ceil(r);\\n    for (let dr = -R; dr <= R && !any; dr++) for (let dc = -R; dc <= R; dc++) { if (dc * dc + dr * dr > r * r) continue; const c = cc + dc, row = rr + dr; if (c >= 0 && row >= 0 && c < this.w && row < this.h && this.cells[row * this.w + c]) { any = true; break; } }\\n    if (!any) return null;\\n    const [nx, ny] = this.normal(x, y, r + 1); let d = 0;\\n    for (; d < r * 2; d += .5) { let clear = true; const px = x + nx * d, py = y + ny * d, [c0, r0] = this._cell(px, py); for (let dr = -R; dr <= R && clear; dr++) for (let dc = -R; dc <= R; dc++) { if (dc * dc + dr * dr > r * r) continue; const c = c0 + dc, row = r0 + dr; if (c >= 0 && row >= 0 && c < this.w && row < this.h && this.cells[row * this.w + c]) { clear = false; break; } } if (clear) break; }\\n    return [nx, ny, Math.max(d, .25)];\\n  }\\n  /** the first solid cell on the line from (x0, y0) to (x1, y1): [x, y] (the last air before it), or null */\\n  ray(x0, y0, x1, y1) { const n = Math.ceil(Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0))) || 1; let px = x0, py = y0; for (let i = 0; i <= n; i++) { const x = x0 + (x1 - x0) * i / n, y = y0 + (y1 - y0) * i / n; if (this.solid(x, y)) return [px, py]; px = x; py = y; } return null; }\\n  /** a walker\\'s step: up and down slopes of up to climb, stopped by walls, falling and landing (see the manual) */\\n  walk(b, dt, o = {}) {\\n    const g = o.gravity !== undefined ? o.gravity : 500, climb = o.climb || 5, h = o.h || 10; let landed = 0;\\n    if (b.vx) {\\n      const nx = b.x + b.vx * dt, top = this.ground(nx, b.y + climb + .5);\\n      if (this.solid(nx, b.y + climb + 1) || this.solid(nx, b.y + h)) b.vx = 0;   // a wall taller than a step\\n      else { b.x = nx; if (b.ground) { if (top !== null && top >= b.y - climb) b.y = top; else b.ground = false; } }\\n    }\\n    if (!b.ground) {\\n      b.vy = (b.vy || 0) - g * dt; const ny = b.y + b.vy * dt;\\n      if (b.vy <= 0) { const top = this.ground(b.x, b.y); if (top !== null && top >= ny) { landed = -b.vy; b.y = top; b.vy = 0; b.ground = true; } else b.y = ny; }\\n      else if (this.solid(b.x, ny + h)) b.vy = 0; else b.y = ny;\\n    } else if (!this.solid(b.x, b.y - .5)) { const top = this.ground(b.x, b.y); if (top === null || top < b.y - climb) b.ground = false; else b.y = top; }\\n    return landed;\\n  }\\n  /** a field for the physics module: world.add(land.collider()) */\\n  collider() { return { type: \\'static\\', shape: \\'field\\', test: (x, y, r) => this.hit(x, y, r) }; }\\n  /** draw it as decals under the bodies, in the side view (its y is the engine\\'s z); only changed chunks are redrawn */\\n  draw(r) {\\n    const k = this.chunk, v = r.game.view, s = v.scale, W = r.game.W, H = r.game.H; this.drawn = 0;\\n    for (let cy = 0; cy * k < this.h; cy++) for (let cx = 0; cx * k < this.w; cx++) {\\n      const wx = this.x + cx * k, wy = this.y + this.h - cy * k, [sx, sy] = r.w(wx, 0, wy);\\n      if (sx > W || sy > H || sx + k * s < 0 || sy + k * s * v.zBoost < 0) continue;\\n      const key = cx + \\',\\' + cy; let cv = this._cv.get(key);\\n      if (!cv || this._dirty.has(key)) { cv = this._paint(cx, cy, cv); this._cv.set(key, cv); this._dirty.delete(key); this.drawn++; }\\n      r.decal(g => { const was = g.imageSmoothingEnabled; g.imageSmoothingEnabled = false; g.drawImage(cv, Math.round(sx), Math.round(sy), Math.round(k * s), Math.round(k * s * v.zBoost)); g.imageSmoothingEnabled = was; });\\n    }\\n  }\\n  // one chunk\\'s picture: each cell its material\\'s color, varied a little; the lit top (air above), a dark rim elsewhere\\n  _paint(cx, cy, cv) {\\n    const k = this.chunk; cv = cv || E.mkCanvas(k, k); const g = E.ctx2d(cv), img = g.createImageData(k, k), D = img.data, W = this.w, C = this.cells;\\n    for (let y = 0; y < k; y++) for (let x = 0; x < k; x++) {\\n      const c = cx * k + x, row = cy * k + y, o = (y * k + x) * 4; if (c >= W || row >= this.h) continue;\\n      const id = C[row * W + c]; if (!id) continue;\\n      const M = this.materials[id - 1], P = this._rgb[id - 1], air = (cc, rr) => cc >= 0 && rr >= 0 && cc < W && rr < this.h && !C[rr * W + cc];\\n      let up = 0; for (let d = 1; d <= M.depth; d++) if (air(c, row - d)) { up = d; break; }\\n      const rim = air(c - 1, row) || air(c + 1, row) || air(c, row + 1), n = (hash(c, row) - .5) * 18 + (hash(c >> 2, row >> 2) - .5) * 14;\\n      const base = up ? P.t : rim ? P.e : P.c, l = up === 1 ? 24 : 0;\\n      D[o] = Math.max(0, Math.min(255, base[0] + n + l)); D[o + 1] = Math.max(0, Math.min(255, base[1] + n + l)); D[o + 2] = Math.max(0, Math.min(255, base[2] + n * .7 + l)); D[o + 3] = 255;\\n    }\\n    g.putImageData(img, 0, 0); return cv;\\n  }\\n}\\nE.Terrain = Terrain;\\n})(typeof My3D2dge !== \\'undefined\\' ? My3D2dge : undefined);\\n\\n\\n\\n/* Authored encounter data. Coordinates are the overhead x/y plane; z is decorative. */\\n(() => {\\n  \\'use strict\\';\\n  const defaults = {\\n    scoutSpeed: 215, biteInterval: 0.15, chargeThreshold: 5, primaryInterval: 0.105,\\n    cannonSpeed: 840, cannonWindup: 0.28, pursuerSpeed: 51, pursuerTurn: 2.2,\\n    swirlSpeed: 258, swirlTelegraph: 1.2, refugeOutage: 3.4, reserveCount: 3,\\n  };\\n  const ranges = {\\n    scoutSpeed: { label: \\'Scout speed\\', min: 100, max: 360, step: 5, unit: \\'u/s\\' },\\n    biteInterval: { label: \\'Bite cadence\\', min: 0.06, max: 0.4, step: 0.01, unit: \\'s\\' },\\n    chargeThreshold: { label: \\'Bites to charge\\', min: 1, max: 12, step: 1, unit: \\'cells\\' },\\n    primaryInterval: { label: \\'Primary cadence\\', min: 0.045, max: 0.3, step: 0.005, unit: \\'s\\' },\\n    cannonSpeed: { label: \\'Siege speed\\', min: 350, max: 1300, step: 10, unit: \\'u/s\\' },\\n    cannonWindup: { label: \\'Siege warning\\', min: 0.15, max: 1.2, step: 0.01, unit: \\'s\\' },\\n    pursuerSpeed: { label: \\'Pursuer speed\\', min: 15, max: 130, step: 1, unit: \\'u/s\\' },\\n    pursuerTurn: { label: \\'Pursuer turning\\', min: 0.3, max: 5, step: 0.1, unit: \\'rad/s\\' },\\n    swirlSpeed: { label: \\'Swirl speed\\', min: 120, max: 450, step: 5, unit: \\'u/s\\' },\\n    swirlTelegraph: { label: \\'Swirl warning\\', min: 0.7, max: 3, step: 0.1, unit: \\'s\\' },\\n    refugeOutage: { label: \\'Refuge outage\\', min: 1, max: 7, step: 0.1, unit: \\'s\\' },\\n    reserveCount: { label: \\'Replacement scouts\\', min: 0, max: 8, step: 1, unit: \\'scouts\\' },\\n  };\\n  function arch() {\\n    const cells = [];\\n    for (let row = -7; row <= 7; row++) {\\n      for (let col = -8; col <= 3; col++) {\\n        const d = Math.hypot(col * 20, row * 20);\\n        if (d >= 100 && d <= 162 && col <= 1) cells.push({ x: 810 + col * 20, y: 270 + row * 20, plate: 0, material: \\'normal\\' });\\n      }\\n    }\\n    return cells;\\n  }\\n  function plates() {\\n    const cells = [];\\n    for (let row = -7; row <= 7; row++) {\\n      for (let col = 0; col < 3; col++) {\\n        cells.push({ x: 650 + col * 20, y: 270 + row * 20, plate: 0, material: col === 0 && (row + 7) % 4 === 0 ? \\'reflective\\' : \\'normal\\' });\\n        if (Math.abs(row) <= 5) cells.push({ x: 745 + col * 20, y: 270 + row * 20, plate: 1, material: col === 2 && (row + 5) % 4 === 0 ? \\'reflective\\' : \\'normal\\' });\\n      }\\n    }\\n    return cells;\\n  }\\n  function carapace() {\\n    const cells = [];\\n    for (let row = -8; row <= 8; row++) {\\n      for (let col = -9; col <= 4; col++) {\\n        const d = Math.hypot(col * 20, row * 20);\\n        if (d >= 115 && d <= 188 && col <= 2) cells.push({ x: 810 + col * 20, y: 270 + row * 20, plate: col < -5 ? 0 : 1, material: ((row + 8) % 5 === 0 && col < -4) ? \\'reflective\\' : \\'normal\\' });\\n      }\\n    }\\n    return cells;\\n  }\\n  const sectors = [\\n    {\\n      id: \\'cinder-gate\\', name: \\'CINDER GATE\\', subtitle: \\'THE OUTER SHELL\\',\\n      introduction: \\'Our home is static. We still hear its wings.\\',\\n      clearLine: \\'The first voice falls silent. Beyond it: a second mouth.\\',\\n      palette: { bg: \\'#07141c\\', floor: \\'#102631\\', shadow: \\'#050d15\\', accent: \\'#50e1bd\\', shield: \\'#db704d\\', core: \\'#ff526f\\', light: \\'#8cf7d4\\', static: \\'#53a4b5\\' },\\n      musicRoot: 43, musicTempo: 88, silhouette: \\'arch\\', hp: 1, pursuers: 1,\\n      swirlDelay: 14, swirlPeriod: 18, refuge: { x: 355, w: 100 },\\n      plates: [{ id: 0, x: 0, y: 0, amplitude: 0, period: 9, phase: 0 }], cells: arch(),\\n      core: { x: 810, y: 270, hp: 1 },\\n      lessons: [\\'Move and fire to carve a path.\\', \\'Touch the shell: five bites fill your siege gun.\\', \\'Static hides you from pursuers. It silences both weapons.\\', \\'Align with the heart. Call the rail gun. Leave its lane.\\'],\\n    },\\n    {\\n      id: \\'glass-sepulcher\\', name: \\'GLASS SEPULCHER\\', subtitle: \\'THE MOVING DEFENSE\\',\\n      introduction: \\'It has learned to wear mirrors. Break the reflection.\\',\\n      clearLine: \\'Behind the glass, the hollow mind is awake.\\',\\n      palette: { bg: \\'#140e24\\', floor: \\'#271e39\\', shadow: \\'#0a0914\\', accent: \\'#e2b85b\\', shield: \\'#9873d1\\', core: \\'#ff7768\\', light: \\'#efd08a\\', static: \\'#a980d4\\' },\\n      musicRoot: 46, musicTempo: 98, silhouette: \\'plates\\', hp: 2, pursuers: 2,\\n      swirlDelay: 11, swirlPeriod: 15, refuge: { x: 355, w: 100 },\\n      plates: [{ id: 0, x: 0, y: 0, amplitude: 35, period: 10, phase: 0 }, { id: 1, x: 0, y: 0, amplitude: 42, period: 10, phase: Math.PI }], cells: plates(),\\n      core: { x: 845, y: 270, hp: 2 },\\n      lessons: [\\'Diamond cells return one siege shot. Watch the amber return lane.\\', \\'The plates move. A breach stays broken.\\', \\'Two heart strikes will silence this station.\\'],\\n    },\\n    {\\n      id: \\'null-regent\\', name: \\'THE NULL REGENT\\', subtitle: \\'THE FORTRESS INTELLIGENCE\\',\\n      introduction: \\'Little wings, says the mind. Nothing survives the signal.\\',\\n      clearLine: \\'Nothing? Listen.\\',\\n      palette: { bg: \\'#1b0c19\\', floor: \\'#321b2a\\', shadow: \\'#0c0810\\', accent: \\'#6bd9ed\\', shield: \\'#c95270\\', core: \\'#ffbe67\\', light: \\'#ffbe83\\', static: \\'#b96c98\\' },\\n      musicRoot: 39, musicTempo: 108, silhouette: \\'crown\\', hp: 3, pursuers: 2,\\n      swirlDelay: 10, swirlPeriod: 13, refuge: { x: 355, w: 100 },\\n      plates: [{ id: 0, x: 0, y: 0, amplitude: 17, period: 12, phase: 0 }, { id: 1, x: 0, y: 0, amplitude: 0, period: 12, phase: 0 }], cells: carapace(),\\n      core: { x: 810, y: 270, hp: 3 },\\n      lessons: [\\'The refuge will fracture. Its borders warn you first.\\', \\'Strip the shell. Catch the moving heart.\\', \\'The last strike must find it in flight.\\', \\'When it docks, touch the blue heart to refill. Then intercept.\\'],\\n    },\\n  ];\\n  globalThis.RuinContent = { version: 1, defaults, ranges, sectors, scouts: [{ name: \\'RILL\\', color: \\'#65f4cb\\' }, { name: \\'VENN\\', color: \\'#ffd37f\\' }] };\\n})();\\n\\n\\n\\n/* A single authoritative, deterministic overhead simulation. No browser, audio or drawing state. */\\n(() => {\\n  \\'use strict\\';\\n  const C = globalThis.RuinContent;\\n  const W = 960, H = 540, TAU = Math.PI * 2, DT = 1 / 120;\\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\n  const wrap = (v, n = H) => ((v % n) + n) % n;\\n  const dy = (a, b) => wrap(a - b + H / 2) - H / 2;\\n  const copy = value => JSON.parse(JSON.stringify(value));\\n  const finite = (value, fallback = 0) => Number.isFinite(Number(value)) ? Number(value) : fallback;\\n  const approach = (v, to, d) => v < to ? Math.min(to, v + d) : Math.max(to, v - d);\\n  const dist = (a, b) => Math.hypot(a.x - b.x, dy(a.y, b.y));\\n  const turn = (a, b, step) => a + clamp(Math.atan2(Math.sin(b - a), Math.cos(b - a)), -step, step);\\n  function rng(w) {\\n    let v = w.rngCombat | 0; v ^= v << 13; v ^= v >>> 17; v ^= v << 5;\\n    w.rngCombat = v >>> 0; return w.rngCombat / 4294967296;\\n  }\\n  function event(w, type, x = 480, y = 270, extra = {}) {\\n    const ev = { id: ++w.eventId, type, x, y, tick: w.tick, ...extra };\\n    w.events.push(ev); w.eventLog.push(ev);\\n    if (w.eventLog.length > 64) w.eventLog.shift();\\n    return ev;\\n  }\\n  function say(w, text, seconds = 4) { w.message = text; w.messageTime = seconds; }\\n  function mark(w, key) { w.learned[key] = true; }\\n  function addScore(w, amount, kind, player) {\\n    const points = Math.round(amount * w.chain);\\n    w.score += points; w.stats[kind] = (w.stats[kind] || 0) + points;\\n    w.chain = Math.min(3, w.chain + 0.08); w.chainTime = 4;\\n    if (player != null && w.players[player]) w.players[player].score += points;\\n    return points;\\n  }\\n  function isStatic(w, p) { return w.refuge.active && p.x >= w.refuge.x && p.x <= w.refuge.x + w.refuge.w; }\\n  function contentFor(w) { return w.customContent || C.sectors[w.sector]; }\\n  function ready(w, p) { return p.charge >= w.tuning.chargeThreshold - 1e-6; }\\n  function charge(w, p, amount, refill = false) {\\n    const was = ready(w, p);\\n    p.charge = Math.min(w.tuning.chargeThreshold, p.charge + amount); p.ready = ready(w, p);\\n    if (!was && p.ready) { event(w, \\'charge\\', p.x, p.y, { player: p.index }); mark(w, \\'charge\\'); say(w, \\'SIEGE READY — align with the heart. Fire, then leave the lane.\\', 3); }\\n    if (refill) event(w, \\'refill\\', p.x, p.y, { player: p.index });\\n  }\\n  function removeCell(w, cell, kind, p) {\\n    if (!cell.alive) return false;\\n    cell.alive = false;\\n    const player = p ? p.index : -1;\\n    const score = addScore(w, kind === \\'bite\\' ? 45 : kind === \\'cannon\\' ? 4 : 12, kind === \\'bite\\' ? \\'bites\\' : \\'breaches\\', player);\\n    event(w, kind === \\'bite\\' ? \\'bite\\' : \\'chip\\', cell.x, cell.y, { player, material: cell.material, score, cell: cell.id });\\n    if (kind === \\'bite\\' && p) { charge(w, p, 1); p.biteFlash = 0.15; w.stats.biteCount++; mark(w, \\'bite\\'); }\\n    if (kind === \\'primary\\') { w.stats.shotCells++; mark(w, \\'shoot\\'); }\\n    return true;\\n  }\\n  function normalizeAction(a, p) {\\n    a = a || {};\\n    let mx = clamp(finite(a.mx), -1, 1), my = clamp(finite(a.my), -1, 1), ax = clamp(finite(a.ax, p.ax), -1, 1), ay = clamp(finite(a.ay, p.ay), -1, 1);\\n    const m = Math.hypot(mx, my), aim = Math.hypot(ax, ay);\\n    if (m > 1) { mx /= m; my /= m; }\\n    if (aim > 0.05) { ax /= aim; ay /= aim; } else { ax = p.ax; ay = p.ay; }\\n    return { mx, my, ax, ay, fire: a.fire === true, cannon: a.cannon === true };\\n  }\\n  function makePlayer(index, id) {\\n    return { id: id == null ? index + 1 : id, index, x: 130, y: index ? 340 : 210, vx: 0, vy: 0, ax: 1, ay: 0, r: 9, alive: true, departed: false, respawn: 0, invuln: 2.2, charge: 0, ready: false, biteTimer: 0, biteFlash: 0, fireTimer: 0, refillTimer: 0, blockedTimer: 0, wrapFlash: 0, score: 0, deadReason: \\'\\' };\\n  }\\n  function initSector(w, sector, custom = null) {\\n    w.sector = clamp(Math.round(sector), 0, 2); w.customContent = custom;\\n    const data = contentFor(w);\\n    w.sectorTime = 0; w.phase = 0; w.phaseTime = 0; w.mode = \\'play\\'; w.transitionTime = 0;\\n    w.cells = data.cells.map((c, i) => ({ id: i, baseX: c.x, baseY: c.y, x: c.x, y: c.y, plate: c.plate || 0, material: c.material || \\'normal\\', alive: true, size: 20 }));\\n    w.plates = data.plates.map(p => ({ ...copy(p), dx: 0, dy: 0 }));\\n    const dc = data.core || { x: 810, y: 270, hp: data.hp || w.sector + 1 };\\n    w.core = { x: dc.x, y: dc.y, dockX: dc.x, dockY: dc.y, hp: dc.hp, maxHp: dc.hp, state: \\'dock\\', timer: data.swirlDelay || 14, phase: 0, angle: 0, r: 28, vx: 0, vy: 0, hitGrace: 0, flightTime: 0, targetX: 0, targetY: 0, launches: 0, needleTimer: 2.8 };\\n    w.shots = []; w.hazards = []; w.cannons = [];\\n    w.refuge = { x: data.refuge.x, w: data.refuge.w, active: true, warning: false, cycle: 0, outageTimer: 0 };\\n    w.tutorial = 0; w.learned = {};\\n    for (const p of w.players) {\\n      if (p.departed) continue;\\n      Object.assign(p, { alive: true, respawn: 0, x: 130, y: p.index ? 340 : 210, vx: 0, vy: 0, charge: 0, ready: false, invuln: 2.4, biteTimer: 0, fireTimer: 0, refillTimer: 0, blockedTimer: 0, biteFlash: 0, wrapFlash: 0 });\\n    }\\n    for (let i = 0; i < (data.pursuers || 1); i++) spawnPursuer(w, i);\\n    say(w, data.introduction || \\'A shell of stolen light. A heart behind it.\\', 4.5);\\n    event(w, \\'sector-start\\', w.core.x, w.core.y, { sector: w.sector });\\n  }\\n  function create(options = {}) {\\n    const tuning = { ...C.defaults };\\n    if (options.assist) { tuning.swirlTelegraph = 1.9; tuning.pursuerSpeed = 38; tuning.reserveCount = 6; tuning.cannonWindup = 0.4; }\\n    if (options.tuning) for (const k of Object.keys(C.ranges)) if (k in options.tuning) tuning[k] = clamp(finite(options.tuning[k], tuning[k]), C.ranges[k].min, C.ranges[k].max);\\n    const seed = (finite(options.seed, 1982) >>> 0) || 1982;\\n    let custom = null;\\n    if (options.content) { const valid = validateContent(options.content); if (valid.ok) custom = valid.content; }\\n    const count = Array.isArray(options.players) ? options.players.length : clamp(Math.round(finite(options.players, 1)), 1, 2);\\n    const w = { version: 1, W, H, tick: 0, time: 0, seed, rngCombat: seed, eventId: 0, nextId: 1, sector: 0, mode: \\'play\\', phase: 0, phaseTime: 0,\\n      assist: !!options.assist, practice: !!options.practice || !!custom, attract: !!options.attract, tuning, players: Array.from({ length: count }, (_, i) => makePlayer(i, Array.isArray(options.players) ? options.players[i] : undefined)),\\n      reserves: Math.min(8, tuning.reserveCount + (count - 1)), reserveCap: 8, score: 0, chain: 1, chainTime: 0, events: [], eventLog: [], message: \\'\\', messageTime: 0, tutorial: 0, learned: {},\\n      stats: { bites: 0, breaches: 0, hearts: 0, ending: 0, biteCount: 0, shotCells: 0, shots: 0, cannonFired: 0, cannonMissed: 0, coreHits: 0, airborne: 0, deaths: 0, cleared: 0, refills: 0 },\\n      dev: { invulnerable: false, infiniteCharge: false, collisions: false }, outcomeAwarded: false, pendingTuning: {}, errors: [], customContent: null };\\n    initSector(w, finite(options.sector), custom);\\n    return w;\\n  }\\n  function spawnPursuer(w, variant = 0) {\\n    const id = w.nextId++;\\n    const h = { id, kind: \\'pursuer\\', x: 860 - variant * 55, y: wrap(85 + variant * 345 + (rng(w) - .5) * 24), vx: -w.tuning.pursuerSpeed, vy: 0, r: variant ? 8 : 9, angle: Math.PI + (rng(w) - .5) * .2, target: variant % Math.max(1, w.players.length), life: 1e6, variant, age: 0 };\\n    w.hazards.push(h); return h;\\n  }\\n  function safeSpawn(w, p) {\\n    const candidates = [90, 450, 180, 360, 270, 15, 525];\\n    let best = candidates[0], bestD = -1;\\n    for (const y of candidates) {\\n      let nearest = 1e6;\\n      for (const h of w.hazards) nearest = Math.min(nearest, Math.hypot(h.x - 130, dy(h.y, y)));\\n      for (const c of w.cannons) if (Math.abs(dy(c.y, y)) < 35) nearest = Math.min(nearest, Math.abs(c.x - 130));\\n      if (w.core.state === \\'flight\\' || w.core.state === \\'return\\') nearest = Math.min(nearest, Math.hypot(w.core.x - 130, dy(w.core.y, y)));\\n      if (nearest > bestD) { bestD = nearest; best = y; }\\n    }\\n    p.x = 130; p.y = best; p.vx = p.vy = 0; p.alive = true; p.respawn = 0; p.invuln = 2.4; p.charge = 0; p.ready = false;\\n    p.refillTimer = 0; p.fireTimer = 0; p.biteTimer = 0;\\n    event(w, \\'respawn\\', p.x, p.y, { player: p.index });\\n  }\\n  function kill(w, p, reason) {\\n    if (!p.alive || p.invuln > 0 || p.departed || w.mode !== \\'play\\' || w.dev.invulnerable || w.attract) return false;\\n    p.alive = false; p.charge = 0; p.ready = false; p.vx = p.vy = 0; p.deadReason = reason;\\n    w.stats.deaths++; w.chain = 1; w.chainTime = 0;\\n    if (w.reserves > 0) { w.reserves--; p.respawn = 1.3; } else p.respawn = 0;\\n    event(w, \\'death\\', p.x, p.y, { player: p.index, reason });\\n    return true;\\n  }\\n  function updatePlates(w) {\\n    for (const plate of w.plates) {\\n      const shift = w.sector === 1 && w.phase > 0 ? Math.PI / 2 : 0;\\n      plate.dy = Math.sin(w.sectorTime * TAU / plate.period + plate.phase + shift) * plate.amplitude;\\n      plate.dx = 0;\\n    }\\n    for (const c of w.cells) {\\n      const p = w.plates.find(p => p.id === c.plate);\\n      c.x = c.baseX + (p ? p.dx : 0); c.y = wrap(c.baseY + (p ? p.dy : 0));\\n    }\\n  }\\n  function cellOverlap(x, y, radius, c) {\\n    const half = c.size / 2;\\n    const xx = Math.max(Math.abs(x - c.x) - half, 0), yy = Math.max(Math.abs(dy(y, c.y)) - half, 0);\\n    return xx * xx + yy * yy <= radius * radius;\\n  }\\n  function resolveCells(w, p) {\\n    for (const c of w.cells) {\\n      if (!c.alive || !cellOverlap(p.x, p.y, p.r, c)) continue;\\n      const dx = p.x - c.x, ddy = dy(p.y, c.y), limit = c.size / 2 + p.r;\\n      const pushX = limit - Math.abs(dx), pushY = limit - Math.abs(ddy);\\n      if (pushX < pushY) { p.x += (dx < 0 ? -1 : 1) * Math.max(0, pushX); p.vx = 0; }\\n      else { p.y = wrap(p.y + (ddy < 0 ? -1 : 1) * Math.max(0, pushY)); p.vy = 0; }\\n    }\\n  }\\n  function playerStep(w, p, action, dt) {\\n    if (p.departed) return;\\n    if (!p.alive) { if (p.respawn > 0) { p.respawn -= dt; if (p.respawn <= 0) safeSpawn(w, p); } return; }\\n    const a = normalizeAction(action, p), speed = w.tuning.scoutSpeed;\\n    p.ax = a.ax; p.ay = a.ay;\\n    for (const k of [\\'invuln\\', \\'biteTimer\\', \\'biteFlash\\', \\'fireTimer\\', \\'refillTimer\\', \\'blockedTimer\\', \\'wrapFlash\\']) p[k] = Math.max(0, p[k] - dt);\\n    if (w.dev.infiniteCharge) p.charge = w.tuning.chargeThreshold;\\n    p.ready = ready(w, p);\\n    p.vx = approach(p.vx, a.mx * speed, dt * (Math.abs(a.mx) > .02 ? 2300 : 3200));\\n    p.vy = approach(p.vy, a.my * speed, dt * (Math.abs(a.my) > .02 ? 2300 : 3200));\\n    const oldY = p.y;\\n    p.x = clamp(p.x + p.vx * dt, 35, 930); p.y = wrap(p.y + p.vy * dt);\\n    if (Math.abs(oldY - p.y) > H / 2) { p.wrapFlash = .3; event(w, \\'wrap\\', p.x, p.y, { player: p.index }); }\\n    if (Math.abs(a.mx) + Math.abs(a.my) > .1) mark(w, \\'move\\');\\n    if (p.biteTimer <= 0) {\\n      let nearest = null, best = Infinity;\\n      for (const c of w.cells) if (c.alive && cellOverlap(p.x, p.y, p.r + 3, c)) {\\n        const d = dist(p, c); if (d < best) { best = d; nearest = c; }\\n      }\\n      if (nearest) { removeCell(w, nearest, \\'bite\\', p); p.biteTimer = w.tuning.biteInterval; }\\n    }\\n    resolveCells(w, p);\\n    if (w.core.state === \\'dock\\' && p.refillTimer <= 0 && dist(p, w.core) < p.r + w.core.r + 5) {\\n      if (!ready(w, p)) { charge(w, p, w.tuning.chargeThreshold, true); w.stats.refills++; }\\n      p.refillTimer = 2.5; mark(w, \\'refill\\');\\n    }\\n    const blocked = isStatic(w, p);\\n    p.inStatic = blocked;\\n    if (blocked) mark(w, \\'static\\');\\n    if (blocked && (a.fire || a.cannon)) {\\n      if (p.blockedTimer <= 0) { event(w, \\'static-block\\', p.x, p.y, { player: p.index }); p.blockedTimer = 1.5; say(w, \\'STATIC REFUGE — pursuers cannot hurt you. Your weapons are silent.\\', 2); }\\n    } else {\\n      if (a.fire && p.fireTimer <= 0) {\\n        p.fireTimer = w.tuning.primaryInterval;\\n        w.shots.push({ id: w.nextId++, kind: \\'primary\\', owner: p.index, x: p.x + p.ax * 17, y: wrap(p.y + p.ay * 17), px: p.x, py: p.y, vx: p.ax * 620, vy: p.ay * 620, r: 3, life: 1.8 });\\n        w.stats.shots++; event(w, \\'primary\\', p.x, p.y, { player: p.index });\\n      }\\n      if (a.cannon && ready(w, p)) {\\n        p.charge = 0; p.ready = false;\\n        w.cannons.push({ id: w.nextId++, kind: \\'cannon\\', owner: p.index, x: 30, px: 30, y: p.y, vx: w.tuning.cannonSpeed, r: 7, warn: w.tuning.cannonWindup, reflected: false, returnWarn: 0, life: 4 });\\n        w.stats.cannonFired++; mark(w, \\'cannon\\');\\n        event(w, \\'cannon-warn\\', 30, p.y, { player: p.index }); say(w, \\'SIEGE LOCKED — LEAVE THE LINE\\', 1.4);\\n      }\\n    }\\n  }\\n  function sweepCircle(x0, y0, x1, y1, target, r) {\\n    const vx = x1 - x0, vy = dy(y1, y0), tx = target.x - x0, ty = dy(target.y, y0);\\n    const len = vx * vx + vy * vy;\\n    const t = len > 0 ? clamp((tx * vx + ty * vy) / len, 0, 1) : 0;\\n    return Math.hypot(tx - vx * t, ty - vy * t) <= r;\\n  }\\n  function shotsStep(w, dt) {\\n    for (const s of w.shots) {\\n      if (s.life <= 0) continue;\\n      s.px = s.x; s.py = s.y; s.x += s.vx * dt; s.y = wrap(s.y + s.vy * dt); s.life -= dt;\\n      if (s.x < 0 || s.x > W) { s.life = 0; continue; }\\n      for (const c of w.cells) if (c.alive && cellOverlap(s.x, s.y, s.r, c)) { removeCell(w, c, \\'primary\\', w.players[s.owner]); s.life = 0; break; }\\n      if (s.life > 0 && w.core.hp > 0 && sweepCircle(s.px, s.py, s.x, s.y, w.core, w.core.r + s.r)) {\\n        s.life = 0;\\n        if (w.tick % 5 === 0) event(w, \\'immune\\', s.x, s.y, { player: s.owner });\\n      }\\n    }\\n    w.shots = w.shots.filter(s => s.life > 0);\\n  }\\n  function coreHit(w, cannon) {\\n    const core = w.core;\\n    if (core.hp <= 0 || core.hitGrace > 0 || w.mode !== \\'play\\' || core.state === \\'phase-break\\') return false;\\n    const airborne = core.state === \\'flight\\' || core.state === \\'return\\';\\n    if (w.sector === 2 && core.hp === 1 && !airborne) {\\n      event(w, \\'immune\\', core.x, core.y, { player: cannon.owner, finalDock: true }); say(w, \\'THE LAST HEART MUST BE STRUCK IN FLIGHT. Touch it here to refill.\\', 3.5); return false;\\n    }\\n    core.hp--; w.phase++; core.phase = w.phase; w.phaseTime = 0; core.hitGrace = 1.6;\\n    w.stats.coreHits++;\\n    const points = addScore(w, airborne ? 3000 : 1500, \\'hearts\\', cannon.owner);\\n    if (airborne) { w.stats.airborne++; w.reserves = Math.min(w.reserveCap, w.reserves + 1); mark(w, \\'airborne\\'); say(w, \\'AIRBORNE INTERCEPT — +1 REPLACEMENT SCOUT\\', 3.2); }\\n    event(w, \\'core-hit\\', core.x, core.y, { player: cannon.owner, airborne, score: points, hp: core.hp });\\n    if (core.hp <= 0) {\\n      core.state = \\'defeated\\'; w.stats.cleared++; w.reserves = Math.min(w.reserveCap, w.reserves + 1); w.transitionTime = 0;\\n      for (const p of w.players) if (!p.departed && !p.alive) { p.alive = true; p.respawn = 0; p.invuln = 2.4; p.x = 130; p.y = p.index ? 340 : 210; p.charge = 0; }\\n      for (const c of w.cells) c.alive = false;\\n      w.shots = []; w.hazards = [];\\n      addScore(w, 800, \\'hearts\\', cannon.owner); event(w, \\'sector-clear\\', core.x, core.y, { sector: w.sector });\\n      if (w.sector === 2) {\\n        w.mode = \\'victory\\'; if (!w.outcomeAwarded) { w.outcomeAwarded = true; w.score += 5000; w.stats.ending = 5000; event(w, \\'victory\\', core.x, core.y); }\\n        say(w, \\'THE SIGNAL BREAKS. The swarm answers. We are still here.\\', 99);\\n      } else { w.mode = \\'transition\\'; say(w, C.sectors[w.sector].clearLine, 99); }\\n    } else {\\n      core.state = \\'phase-break\\'; core.timer = 1.5; core.vx = core.vy = 0;\\n      const n = w.sector === 2 && core.hp === 1 ? 1 : .33;\\n      for (const c of w.cells) if (c.alive && (n === 1 || (c.id + w.phase) % 3 === 0)) { c.alive = false; event(w, \\'chip\\', c.x, c.y, { material: c.material, phaseBreak: true }); }\\n      if (w.sector === 2 && core.hp === 1) say(w, \\'THE LAST HEART TAKES FLIGHT. Docked blue: touch to refill. Amber: intercept.\\', 5);\\n      else if (w.sector === 1) say(w, \\'THE MIRRORS CHANGE. Your breach is still there.\\', 3);\\n      else say(w, \\'THE SHELL IS GONE. Now the heart moves.\\', 3);\\n    }\\n    return true;\\n  }\\n  function cannonsStep(w, dt) {\\n    for (const c of w.cannons) {\\n      if (c.life <= 0) continue;\\n      if (c.warn > 0) { c.warn -= dt; if (c.warn <= 0) event(w, \\'cannon-fire\\', c.x, c.y, { player: c.owner }); continue; }\\n      if (c.returnWarn > 0) { c.returnWarn -= dt; continue; }\\n      c.px = c.x; c.x += c.vx * dt; c.life -= dt;\\n      let hitCell = null;\\n      for (const cell of w.cells) if (cell.alive && cellOverlap(c.x, c.y, c.r, cell)) {\\n        if (!hitCell || (c.vx > 0 ? cell.x < hitCell.x : cell.x > hitCell.x)) hitCell = cell;\\n      }\\n      if (hitCell) {\\n        removeCell(w, hitCell, \\'cannon\\', w.players[c.owner]);\\n        if (hitCell.material === \\'reflective\\' && !c.reflected) {\\n          c.reflected = true; c.vx = -Math.abs(c.vx); c.returnWarn = .45;\\n          event(w, \\'reflection\\', c.x, c.y, { player: c.owner }); say(w, \\'MIRROR RETURN — THE AMBER LINE IS COMING BACK\\', 2.4); mark(w, \\'reflection\\');\\n        } else { c.life = 0; w.stats.cannonMissed++; }\\n      }\\n      if (c.life <= 0 || c.returnWarn > 0) continue;\\n      if (w.core.hp > 0 && sweepCircle(c.px, c.y, c.x, c.y, w.core, c.r + w.core.r)) { coreHit(w, c); c.life = 0; }\\n      if (c.life > 0 && w.mode === \\'play\\') {\\n        for (const p of w.players) if (p.alive && !p.departed && sweepCircle(c.px, c.y, c.x, c.y, p, p.r + c.r)) kill(w, p, \\'siege\\');\\n      }\\n      if (c.x < -35 || c.x > W + 35) { c.life = 0; w.stats.cannonMissed++; }\\n    }\\n    w.cannons = w.cannons.filter(c => c.life > 0);\\n  }\\n  function chooseTarget(w, target = 0) {\\n    const living = w.players.filter(p => p.alive && !p.departed);\\n    return living.find(p => p.index === target) || living[0] || null;\\n  }\\n  function beginWindup(w) {\\n    const core = w.core, target = chooseTarget(w, core.launches % w.players.length);\\n    core.state = \\'windup\\'; core.timer = w.tuning.swirlTelegraph;\\n    core.targetX = target ? target.x : 250; core.targetY = target ? target.y : 270;\\n    const angle = Math.atan2(dy(core.targetY, core.y), core.targetX - core.x);\\n    core.vx = Math.cos(angle) * w.tuning.swirlSpeed; core.vy = Math.sin(angle) * w.tuning.swirlSpeed;\\n    if (core.vx > -70) { core.vx = -w.tuning.swirlSpeed * .9; core.vy = Math.sin(angle) * w.tuning.swirlSpeed * .4; }\\n    event(w, \\'swirl-warn\\', core.x, core.y, { targetX: core.targetX, targetY: core.targetY }); mark(w, \\'swirl\\');\\n    say(w, w.sector === 2 && core.hp === 1 ? \\'LAST HEART — INTERCEPT IN FLIGHT. AIRBORNE HIT: +1 SCOUT.\\' : \\'SWIRL INBOUND — STATIC WILL NOT SAVE YOU. INTERCEPT: +1 SCOUT.\\', 3.2);\\n  }\\n  function coreStep(w, dt) {\\n    const core = w.core, data = contentFor(w);\\n    if (core.hp <= 0) return;\\n    core.hitGrace = Math.max(0, core.hitGrace - dt); core.angle += dt * (core.state === \\'flight\\' ? 18 : core.state === \\'windup\\' ? 10 : 1.8);\\n    core.timer -= dt;\\n    if (core.state === \\'phase-break\\') {\\n      if (core.timer <= 0) { core.state = \\'dock\\'; core.x = core.dockX; core.y = core.dockY; core.timer = w.sector === 2 && core.hp === 1 ? 7 : 9; event(w, \\'dock\\', core.x, core.y); }\\n    } else if (core.state === \\'dock\\') {\\n      core.x = core.dockX;\\n      core.y = wrap(core.dockY + (w.sector === 2 && core.hp === 2 ? Math.sin(w.sectorTime * .65) * 55 : 0));\\n      if (core.timer <= 0) beginWindup(w);\\n      if (w.sector === 2 && core.hp === 2) {\\n        core.needleTimer -= dt;\\n        if (core.needleTimer <= 0) {\\n          core.needleTimer = 3.1;\\n          const target = chooseTarget(w), angle = target ? Math.atan2(dy(target.y, core.y), target.x - core.x) : Math.PI;\\n          for (let i = -1; i <= 1; i++) {\\n            const a = angle + i * .24;\\n            w.hazards.push({ id: w.nextId++, kind: \\'needle\\', x: core.x, y: core.y, vx: Math.cos(a) * 135, vy: Math.sin(a) * 135, angle: a, r: 5, life: 7, target: -1, age: 0 });\\n          }\\n          event(w, \\'needles\\', core.x, core.y);\\n        }\\n      }\\n    } else if (core.state === \\'windup\\') {\\n      if (core.timer <= 0) { core.state = \\'flight\\'; core.timer = 3.0; core.flightTime = 0; core.launches++; event(w, \\'swirl-launch\\', core.x, core.y); }\\n    } else if (core.state === \\'flight\\') {\\n      core.x += core.vx * dt; core.y = wrap(core.y + core.vy * dt); core.flightTime += dt;\\n      if (core.timer <= 0 || core.x < 75) { core.state = \\'return\\'; core.timer = 4; event(w, \\'swirl-return\\', core.x, core.y); }\\n    } else if (core.state === \\'return\\') {\\n      const dx = core.dockX - core.x, ddy = dy(core.dockY, core.y), len = Math.hypot(dx, ddy), speed = Math.max(260, w.tuning.swirlSpeed * 1.15);\\n      if (len <= speed * dt + 3 || core.timer <= 0) {\\n        core.x = core.dockX; core.y = core.dockY; core.state = \\'dock\\'; core.timer = w.sector === 2 && core.hp === 1 ? 7 : data.swirlPeriod || 16;\\n        event(w, \\'dock\\', core.x, core.y); if (w.sector === 2 && core.hp === 1) say(w, \\'HEART DOCKED — touch the blue core for a fresh charge.\\', 4);\\n      } else { core.x += dx / len * speed * dt; core.y = wrap(core.y + ddy / len * speed * dt); }\\n    }\\n    if (core.state === \\'flight\\' || core.state === \\'return\\') {\\n      for (const p of w.players) if (p.alive && !p.departed && dist(p, core) < p.r + core.r - 5) kill(w, p, \\'swirl\\');\\n    }\\n  }\\n  function hazardsStep(w, dt) {\\n    for (const h of w.hazards) {\\n      h.age += dt; h.life -= dt;\\n      const ox = h.x, oy = h.y;\\n      if (h.kind === \\'pursuer\\') {\\n        const target = chooseTarget(w, h.target);\\n        let desired = h.angle;\\n        if (target) {\\n          h.target = target.index;\\n          if (isStatic(w, target)) {\\n            const side = h.variant ? 1 : -1, orbitX = w.refuge.x + w.refuge.w / 2 + Math.cos(h.age * .85 + h.id) * (w.refuge.w / 2 + 30);\\n            const orbitY = wrap(target.y + Math.sin(h.age * .85 + h.id) * 100 * side);\\n            desired = Math.atan2(dy(orbitY, h.y), orbitX - h.x);\\n          } else desired = Math.atan2(dy(target.y, h.y), target.x - h.x);\\n        }\\n        h.angle = turn(h.angle, desired, w.tuning.pursuerTurn * dt);\\n        const speed = w.tuning.pursuerSpeed * (h.variant ? 1.12 : 1) * (w.sector === 2 ? 1.08 : 1);\\n        h.vx = Math.cos(h.angle) * speed; h.vy = Math.sin(h.angle) * speed;\\n      }\\n      h.x += h.vx * dt; h.y = wrap(h.y + h.vy * dt);\\n      if (h.kind === \\'pursuer\\') {\\n        if (h.x < 20 || h.x > 940) { h.x = clamp(h.x, 20, 940); h.angle = Math.PI - h.angle; }\\n      } else if (h.x < -25 || h.x > 985) h.life = 0;\\n      for (const p of w.players) {\\n        if (!p.alive || p.departed || isStatic(w, p)) continue;\\n        if (sweepCircle(ox, oy, h.x, h.y, p, p.r + h.r)) kill(w, p, h.kind);\\n      }\\n    }\\n    w.hazards = w.hazards.filter(h => h.life > 0);\\n  }\\n  function refugeStep(w, dt) {\\n    const r = w.refuge;\\n    if (w.sector !== 2) return;\\n    r.cycle += dt;\\n    const period = 23, warning = 3.2, start = period - warning;\\n    if (r.active && !r.warning && r.cycle >= start) { r.warning = true; event(w, \\'refuge-warning\\', r.x + r.w / 2, 270); say(w, \\'THE REFUGE IS FRACTURING — MOVE BEFORE THE BORDERS TURN RED\\', 3.2); }\\n    if (r.active && r.cycle >= period) { r.active = false; r.warning = false; r.outageTimer = w.tuning.refugeOutage; event(w, \\'refuge-outage\\', r.x + r.w / 2, 270); }\\n    if (!r.active) { r.outageTimer -= dt; if (r.outageTimer <= 0) { r.active = true; r.cycle = 0; event(w, \\'refuge-return\\', r.x + r.w / 2, 270); } }\\n  }\\n  function tutorialStep(w) {\\n    if (w.sector !== 0) return;\\n    const learned = w.learned;\\n    const target = learned.cannon || learned.airborne ? 4 : learned.charge ? 3 : learned.bite ? 2 : learned.move && learned.shoot ? 1 : 0;\\n    w.tutorial = Math.max(w.tutorial, target);\\n  }\\n  function applyTuning(w) {\\n    for (const [k, value] of Object.entries(w.pendingTuning)) {\\n      w.tuning[k] = value;\\n      if (k === \\'reserveCount\\') w.reserves = value;\\n      if (k === \\'chargeThreshold\\') for (const p of w.players) { p.charge = Math.min(p.charge, value); p.ready = ready(w, p); }\\n      if (k === \\'biteInterval\\') for (const p of w.players) p.biteTimer = Math.min(p.biteTimer, value);\\n      if (k === \\'primaryInterval\\') for (const p of w.players) p.fireTimer = Math.min(p.fireTimer, value);\\n    }\\n    w.pendingTuning = {};\\n  }\\n  function step(w, actions = [], dt = DT) {\\n    if (!w || w.mode === \\'defeat\\') return w;\\n    dt = clamp(finite(dt, DT), 0, .05); if (!dt) return w;\\n    w.events = []; applyTuning(w); w.tick++; w.time += dt;\\n    w.messageTime = Math.max(0, w.messageTime - dt);\\n    if (w.mode !== \\'play\\') { w.transitionTime += dt; return w; }\\n    w.sectorTime += dt; w.phaseTime += dt; w.chainTime = Math.max(0, w.chainTime - dt);\\n    if (w.chainTime <= 0) w.chain = approach(w.chain, 1, dt * .5);\\n    updatePlates(w); refugeStep(w, dt);\\n    for (let i = 0; i < w.players.length; i++) playerStep(w, w.players[i], actions[i], dt);\\n    shotsStep(w, dt); coreStep(w, dt); hazardsStep(w, dt); cannonsStep(w, dt);\\n    tutorialStep(w);\\n    if (w.mode === \\'play\\' && !w.players.some(p => !p.departed && (p.alive || p.respawn > 0))) { w.mode = \\'defeat\\'; event(w, \\'defeat\\', 480, 270); say(w, \\'The signal has taken this flight. Another swarm will rise.\\', 99); }\\n    return w;\\n  }\\n  function nextSector(w) {\\n    if (w.mode !== \\'transition\\' || w.sector >= 2) return false;\\n    initSector(w, w.sector + 1); return true;\\n  }\\n  function tune(w, key, value) {\\n    const r = C.ranges[key]; if (!r || !Number.isFinite(Number(value))) return false;\\n    let v = clamp(Number(value), r.min, r.max); if (r.step >= 1) v = Math.round(v);\\n    w.pendingTuning[key] = v; w.practice = true; return true;\\n  }\\n  function command(w, name, value) {\\n    if (name === \\'leave\\') {\\n      const p = w.players[Number(value)]; if (!p || p.departed) return false;\\n      p.departed = true; p.alive = false; p.respawn = 0; p.charge = 0; p.vx = p.vy = 0; return true;\\n    }\\n    w.practice = true;\\n    if (name === \\'invulnerable\\' || name === \\'infiniteCharge\\' || name === \\'collisions\\') { w.dev[name] = !!value; return true; }\\n    if (name === \\'spawnThreat\\') { spawnPursuer(w, w.hazards.filter(h => h.kind === \\'pursuer\\').length % 2); return true; }\\n    if (name === \\'sector\\') { initSector(w, finite(value)); return true; }\\n    if (name === \\'phase\\') {\\n      const phase = clamp(Math.round(finite(value)), 0, w.core.maxHp - 1);\\n      w.core.hp = w.core.maxHp - phase; w.core.phase = w.phase = phase;\\n      w.core.state = \\'dock\\'; w.core.timer = 7; w.core.x = w.core.dockX; w.core.y = w.core.dockY; w.core.hitGrace = 0;\\n      if (w.sector === 2 && w.core.hp === 1) for (const c of w.cells) c.alive = false;\\n      w.shots = []; w.cannons = []; return true;\\n    }\\n    if (name === \\'restart\\') { initSector(w, w.sector, w.customContent); return true; }\\n    if (name === \\'seed\\') { w.seed = (finite(value, 1982) >>> 0) || 1982; w.rngCombat = w.seed; initSector(w, w.sector, w.customContent); return true; }\\n    if (name === \\'reserve\\') { w.reserves = clamp(Math.round(finite(value)), 0, 8); return true; }\\n    if (name === \\'resetTuning\\') { w.tuning = { ...C.defaults, ...(w.assist ? { swirlTelegraph: 1.9, pursuerSpeed: 38, reserveCount: 6, cannonWindup: .4 } : {}) }; w.pendingTuning = {}; return true; }\\n    if (name === \\'content\\') { const v = validateContent(value); if (!v.ok) return false; initSector(w, w.sector, v.content); return true; }\\n    return false;\\n  }\\n  function snapshot(w) {\\n    return { title: \\'Yars of Ruin\\', tick: w.tick, time: +w.time.toFixed(3), seed: w.seed, mode: w.mode, sector: w.sector, sectorName: C.sectors[w.sector].name,\\n      phase: w.phase, core: copy(w.core), players: copy(w.players), reserves: w.reserves, score: w.score, chain: w.chain, cellsAlive: w.cells.filter(c => c.alive).length,\\n      cellCount: w.cells.length, shieldMask: w.cells.map(c => c.alive ? \\'1\\' : \\'0\\').join(\\'\\'), plates: copy(w.plates), refuge: copy(w.refuge), cannons: copy(w.cannons), shots: copy(w.shots), hazards: copy(w.hazards),\\n      stats: copy(w.stats), tuning: copy(w.tuning), practice: w.practice, assist: w.assist, attract: w.attract, tutorial: w.tutorial, learned: copy(w.learned), message: w.message, errors: copy(w.errors) };\\n  }\\n  function validateContent(data) {\\n    const errors = [];\\n    if (!data || typeof data !== \\'object\\' || Array.isArray(data)) return { ok: false, errors: [\\'Encounter must be a JSON object.\\'], content: null };\\n    if (data.version !== 1) errors.push(\\'Encounter version must be 1.\\');\\n    const name = typeof data.name === \\'string\\' ? data.name.slice(0, 60) : \\'\\';\\n    if (!name.trim()) errors.push(\\'A name is required.\\');\\n    const refuge = data.refuge || {};\\n    if (!Number.isFinite(refuge.x) || !Number.isFinite(refuge.w) || refuge.x < 70 || refuge.w < 45 || refuge.w > 220 || refuge.x + refuge.w > 610) errors.push(\\'Refuge x/w must fit between 70 and 610; width 45–220.\\');\\n    const core = data.core || {};\\n    if (!Number.isFinite(core.x) || !Number.isFinite(core.y) || core.x < 630 || core.x > 910 || core.y < 40 || core.y > 500 || !Number.isInteger(core.hp) || core.hp < 1 || core.hp > 3) errors.push(\\'Core needs x 630–910, y 40–500 and integer hp 1–3.\\');\\n    if (!Array.isArray(data.plates) || data.plates.length < 1 || data.plates.length > 4) errors.push(\\'One to four shield plates are required.\\');\\n    const plates = [];\\n    if (Array.isArray(data.plates)) data.plates.slice(0, 4).forEach((p, i) => {\\n      if (!p || !Number.isInteger(p.id) || plates.some(q => q.id === p.id) || !Number.isFinite(p.amplitude) || p.amplitude < 0 || p.amplitude > 90 || !Number.isFinite(p.period) || p.period < 3 || p.period > 40 || !Number.isFinite(p.phase || 0)) errors.push(\\'Plate \\' + (i + 1) + \\' has invalid id, motion amplitude or period.\\');\\n      else plates.push({ id: p.id, x: finite(p.x), y: finite(p.y), amplitude: p.amplitude, period: p.period, phase: p.phase || 0 });\\n    });\\n    if (!Array.isArray(data.cells) || data.cells.length > 600) errors.push(\\'Cells must be an array with at most 600 entries.\\');\\n    const cells = [], seen = new Set();\\n    if (Array.isArray(data.cells)) data.cells.slice(0, 600).forEach((c, i) => {\\n      if (!c || !Number.isFinite(c.x) || !Number.isFinite(c.y) || c.x < 500 || c.x > 930 || c.y < 20 || c.y > 520 || !plates.some(p => p.id === c.plate) || ![\\'normal\\', \\'reflective\\'].includes(c.material)) errors.push(\\'Cell \\' + (i + 1) + \\' has invalid coordinates, plate or material.\\');\\n      else {\\n        const key = c.x + \\',\\' + c.y + \\',\\' + c.plate;\\n        if (seen.has(key)) errors.push(\\'Duplicate cell at \\' + c.x + \\', \\' + c.y + \\'.\\');\\n        else { seen.add(key); cells.push({ x: c.x, y: c.y, plate: c.plate, material: c.material }); }\\n      }\\n    });\\n    const result = { version: 1, name, refuge: { x: refuge.x, w: refuge.w }, core: { x: core.x, y: core.y, hp: core.hp }, plates, cells,\\n      introduction: typeof data.introduction === \\'string\\' ? data.introduction.slice(0, 160) : \\'A new shell. The same stubborn wings.\\',\\n      hp: core.hp, pursuers: clamp(Math.round(finite(data.pursuers, 1)), 1, 3), swirlDelay: clamp(finite(data.swirlDelay, 14), 5, 30), swirlPeriod: clamp(finite(data.swirlPeriod, 16), 7, 35) };\\n    return { ok: errors.length === 0, errors, content: errors.length ? null : result };\\n  }\\n  function exportContent(w) {\\n    const data = contentFor(w);\\n    return { version: 1, name: data.name || \\'CUSTOM ENCOUNTER\\', refuge: { x: w.refuge.x, w: w.refuge.w }, core: { x: w.core.dockX, y: w.core.dockY, hp: w.core.maxHp },\\n      plates: w.plates.map(({ id, x, y, amplitude, period, phase }) => ({ id, x, y, amplitude, period, phase })),\\n      cells: w.cells.map(c => ({ x: c.baseX, y: c.baseY, plate: c.plate, material: c.material })),\\n      pursuers: data.pursuers || 1, swirlDelay: data.swirlDelay || 14, swirlPeriod: data.swirlPeriod || 16 };\\n  }\\n  function pilot(w, index = 0, options = {}) {\\n    /* This controller emits the exact same ordinary actions as a player. No simulation writes. */\\n    const p = w.players[index]; if (!p || !p.alive || p.departed || w.mode !== \\'play\\') return { mx: 0, my: 0, ax: 1, ay: 0, fire: false, cannon: false };\\n    const core = w.core, speed = w.tuning.scoutSpeed;\\n    let tx = p.x, ty = p.y, ax = 1, ay = 0, fire = true, cannon = false;\\n    const final = w.sector === 2 && core.hp === 1;\\n    const cannonOwn = w.cannons.find(c => c.owner === index && !c.reflected && c.life > 0);\\n    const go = (x, y) => { tx = x; ty = wrap(y); };\\n    const aimAt = (x, y) => { const dx = x - p.x, ddy = dy(y, p.y), len = Math.hypot(dx, ddy) || 1; ax = dx / len; ay = ddy / len; };\\n    if (cannonOwn) {\\n      // A real scout must leave its locked lane. Stay well clear until the projectile is spent.\\n      go(p.x > 760 ? 875 : 585, cannonOwn.y + (dy(p.y, cannonOwn.y) < -1 ? -68 : 68));\\n      aimAt(core.x, core.y);\\n    } else if (core.state === \\'phase-break\\') {\\n      go(570, 390); aimAt(core.dockX, core.dockY);\\n    } else if (!ready(w, p)) {\\n      // Start by biting a center corridor. Once the shell there is open, brush the docked heart.\\n      if (core.state === \\'dock\\') {\\n        go(core.x - 9, core.y);\\n        const nearCell = w.cells.filter(c => c.alive && Math.abs(dy(c.y, core.y)) < 28 && c.x > p.x - 25).sort((a, b) => a.x - b.x)[0];\\n        if (nearCell && p.x < core.x - 40) { go(nearCell.x, nearCell.y); fire = false; }\\n        aimAt(core.x, core.y);\\n      } else { go(570, 420); aimAt(core.x, core.y); }\\n    } else if (final) {\\n      if (core.state === \\'dock\\') {\\n        // The final heart is immune while docked. Wait outside the committed route and preserve charge.\\n        go(570, core.dockY + 95); aimAt(core.x, core.y);\\n      } else if (core.state === \\'windup\\') {\\n        const futureTime = Math.max(0, core.timer) + (core.x - 30) / (w.tuning.cannonSpeed - core.vx) + w.tuning.cannonWindup;\\n        const futureY = wrap(core.y + core.vy * Math.max(0, futureTime - core.timer));\\n        go(570, futureY); aimAt(core.x, core.y);\\n        if (Math.abs(dy(p.y, futureY)) < 4 && core.timer < .12) cannon = true;\\n      } else if (core.state === \\'flight\\') {\\n        const hitTime = (core.x - 30 - core.vx * w.tuning.cannonWindup) / (w.tuning.cannonSpeed - core.vx) + w.tuning.cannonWindup;\\n        const targetY = wrap(core.y + core.vy * Math.max(0, hitTime));\\n        go(570, targetY); aimAt(core.x, core.y);\\n        if (Math.abs(dy(p.y, targetY)) < 5 && core.x > 210) cannon = true;\\n      } else { go(570, 410); aimAt(core.x, core.y); }\\n    } else if (core.state === \\'dock\\') {\\n      // Carve a horizontal lane with ordinary fire. Bite nearby cells first, then fire from the right flank.\\n      const travel = w.tuning.cannonWindup + (core.x - 30) / w.tuning.cannonSpeed;\\n      const targetY = w.sector === 2 && core.hp === 2 ? wrap(core.dockY + Math.sin((w.sectorTime + travel) * .65) * 55) : core.y;\\n      const obstruction = w.cells.filter(c => c.alive && Math.abs(dy(c.y, targetY)) < 19 && c.x < core.x - 30).sort((a, b) => a.x - b.x)[0];\\n      if (obstruction) {\\n        go(obstruction.x - 16, obstruction.y);\\n        aimAt(obstruction.x, obstruction.y);\\n        fire = true;\\n      } else {\\n        go(585, targetY); aimAt(core.x, core.y);\\n        if (Math.abs(dy(p.y, targetY)) < 4 && Math.abs(p.vy) < 65 && core.timer > travel + .1) cannon = true;\\n      }\\n    } else if (core.state === \\'windup\\' || core.state === \\'flight\\') {\\n      const time = w.tuning.cannonWindup + Math.max(0, (core.x - 30 - core.vx * w.tuning.cannonWindup) / (w.tuning.cannonSpeed - core.vx));\\n      const targetY = wrap(core.y + core.vy * Math.max(0, time - (core.state === \\'windup\\' ? core.timer : 0)));\\n      go(570, targetY); aimAt(core.x, core.y);\\n      const clear = !w.cells.some(c => c.alive && c.x < core.x && Math.abs(dy(c.y, targetY)) < 18);\\n      if (clear && Math.abs(dy(p.y, targetY)) < 4 && core.state === \\'flight\\' && core.x > 210) cannon = true;\\n    } else { go(570, 410); aimAt(core.x, core.y); }\\n    // Physical danger avoidance: dodge pursuit and the transformed heart, never merely stand in fire.\\n    const danger = w.hazards.filter(h => h.life > 0 && !isStatic(w, p)).map(h => ({ h, d: dist(p, h) })).sort((a, b) => a.d - b.d)[0];\\n    if (danger && danger.d < 90 && !cannon) {\\n      const awayY = dy(p.y, danger.h.y), awayX = p.x - danger.h.x;\\n      if (Math.abs(awayY) > 8) ty = wrap(p.y + Math.sign(awayY) * 100);\\n      else ty = wrap(p.y + (danger.h.vy >= 0 ? -110 : 110));\\n      if (Math.abs(awayX) > 15) tx = clamp(p.x + Math.sign(awayX) * 100, 80, 900);\\n    }\\n    if ((core.state === \\'flight\\' || core.state === \\'return\\') && dist(p, core) < 120 && !cannon) {\\n      ty = wrap(p.y + (dy(p.y, core.y) >= 0 ? 120 : -120));\\n      tx = clamp(p.x + (p.x >= core.x ? 60 : -60), 80, 900);\\n    }\\n    // In the showcase the pilot tries its primary while crossing static so the silent refuge is demonstrated.\\n    if (options.attract && isStatic(w, p)) fire = true;\\n    let mx = clamp((tx - p.x) / Math.max(8, speed * .1), -1, 1), my = clamp(dy(ty, p.y) / Math.max(8, speed * .1), -1, 1);\\n    if (Math.abs(tx - p.x) < 1) mx = 0; if (Math.abs(dy(ty, p.y)) < 1) my = 0;\\n    return { mx, my, ax, ay, fire, cannon };\\n  }\\n  globalThis.RuinSim = { W, H, DT, create, step, snapshot, nextSector, tune, command, pilot, validateContent, exportContent, cellPosition: (_w, c) => ({ x: c.x, y: c.y }), isStatic, wrappedDy: dy, wrap, distance: dist };\\n})();\\n\\n\\n\\n/* Yars of Ruin: authored mathematical insect rigs and siege-station bodies.\\n   All art uses my-3D2dge\\'s shaded pixel primitives, actor queue and lights. */\\n(() => {\\n\\'use strict\\';\\nconst root=typeof window!==\\'undefined\\'?window:globalThis;\\nconst E=root.My3D2dge,px=E.px,TAU=Math.PI*2;\\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),mix=(a,b,t)=>a+(b-a)*t;\\nconst PAL=[\\n {bg:\\'#080f1c\\',nebula:\\'#152e3b\\',back:\\'#172a36\\',deep:\\'#141c28\\',metal:\\'#334954\\',trim:\\'#80b7b6\\',shield:\\'#c38850\\',hot:\\'#ffd899\\',core:\\'#ff7860\\',static:\\'#72d7d5\\',enemy:\\'#fb676f\\'},\\n {bg:\\'#110e21\\',nebula:\\'#322146\\',back:\\'#2d253c\\',deep:\\'#211728\\',metal:\\'#51416a\\',trim:\\'#c8a1d2\\',shield:\\'#c66392\\',hot:\\'#ffc1dc\\',core:\\'#ffb862\\',static:\\'#b4caff\\',enemy:\\'#ff896c\\'},\\n {bg:\\'#0c101b\\',nebula:\\'#23312e\\',back:\\'#263b36\\',deep:\\'#131e24\\',metal:\\'#4f6258\\',trim:\\'#b8c7a2\\',shield:\\'#a6ad59\\',hot:\\'#f1ffc0\\',core:\\'#ee698f\\',static:\\'#8fedc8\\',enemy:\\'#ff7386\\'}\\n];\\nconst PLAYER=[\\'#80f2db\\',\\'#f8bf73\\'];\\nfunction hash(n){n=Math.imul(n^0x9e3779b9,0x85ebca6b);n=Math.imul(n^(n>>>13),0xc2b2ae35);return((n^(n>>>16))>>>0)/4294967296;}\\nfunction ring(g,x,y,rad,width,color,segments=48,offset=0,portion=1){let last=null;for(let i=0;i<=segments*portion;i++){const a=offset+i/segments*TAU,p=[x+Math.cos(a)*rad,y+Math.sin(a)*rad];if(last)px.line(g,...last,...p,color,width);last=p;}}\\nfunction dashedRing(g,x,y,rad,color,rotation=0){for(let i=0;i<12;i++)ring(g,x,y,rad,1,color,60,rotation+i/12*TAU,.045);}\\nfunction transform(x,y,a,s=1){const c=Math.cos(a),d=Math.sin(a);return(u,v)=>[x+(u*c-v*d)*s,y+(u*d+v*c)*s];}\\nfunction plate(g,x,y,w,h,T,bevel=3){px.rect(g,x-w/2,y-h/2,w,h,T.deep);px.poly(g,[[x-w/2,y-h/2],[x+w/2,y-h/2],[x+w/2-bevel,y-h/2+bevel],[x-w/2+bevel,y-h/2+bevel]],T.lt);px.poly(g,[[x-w/2,y-h/2],[x-w/2+bevel,y-h/2+bevel],[x-w/2+bevel,y+h/2-bevel],[x-w/2,y+h/2]],T.base);px.rect(g,x-w/2+bevel,y-h/2+bevel,w-2*bevel,h-2*bevel,T.sh);px.rect(g,x+w/2-bevel,y-h/2+bevel,bevel,h-bevel,T.deep);}\\nfunction insect(g,x,y,t,p,scale=1,ghost=false){\\n const idx=p.index||0,C=E.tones(PLAYER[idx%2]),iv=E.tones(idx?\\'#eed0a0\\':\\'#c9e7d8\\');\\n const a=Math.atan2(p.ay||0,p.ax===undefined?1:p.ax),P=transform(x,y,a,scale),speed=Math.hypot(p.vx||0,p.vy||0),bank=clamp((p.vy||0)/280,-.5,.5);\\n const flap=.55+Math.sin(t*48+idx*2)*.4,flap2=.62+Math.sin(t*48+1.4+idx*2)*.32;\\n const wing=(side,rear)=>{\\n   const f=rear?flap2:flap,span=(rear?18:27)*f*(1+side*bank*.25),u=rear?-10:-1;\\n   const pts=[P(u,side*3),P(u-15,side*(span*.7)),P(u-13,side*(span+4)),P(u+6,side*(span*.8)),P(u+9,side*5)];\\n   px.poly(g,pts,C.deep);px.poly(g,[P(u+1,side*4),P(u-12,side*(span*.7)),P(u-11,side*(span+1)),P(u+4,side*(span*.7)),P(u+7,side*5)],rear?\\'#526e7c\\':\\'#81aaa9\\');\\n   px.line(g,...P(u+1,side*4),...P(u-9,side*(span*.85)),C.lt,1);px.line(g,...P(u-7,side*(span*.7)),...P(u+5,side*(span*.65)),C.sh,1);\\n   if(!rear)px.line(g,...P(u-10,side*(span*.92)),...P(u+2,side*(span*.72)),iv.lt,1);\\n };\\n // Three articulated leg pairs, tucked in flight; two pairs of veined living wings.\\n for(let s=-1;s<=1;s+=2)for(let i=0;i<3;i++){const u=2-i*6,kick=Math.sin(t*11+i+s)*1.2,tip=P(u-6,s*(11+i*.4+kick));px.line(g,...P(u,s*4),...P(u-2,s*9),C.deep,3);px.line(g,...P(u-2,s*9),...tip,C.sh,2);px.dot(g,...tip,C.lt);}\\n wing(-1,true);wing(1,true);wing(-1,false);wing(1,false);\\n // Abdomen segments carry a continuous chitin ramp and engraved bands.\\n for(let i=3;i>=0;i--){const q=P(-6-i*4,0),rr=(6-i*.7);px.disc(g,...q,rr+1,C.deep);px.disc(g,q[0]-.5,q[1]-1,rr,C.sh);px.disc(g,q[0]-1,q[1]-2,rr*.65,C.base);px.line(g,...P(-8-i*4,-rr*.55),...P(-8-i*4,rr*.55),C.lt,1);}\\n const chest=P(1,0);px.disc(g,...chest,8,C.deep);px.disc(g,chest[0]-.8,chest[1]-1,6.5,iv.sh);px.disc(g,chest[0]-2,chest[1]-2,4.6,iv.lt);\\n const ready=!!p.ready;px.poly(g,[P(-1,-3),P(4,-3),P(6,0),P(4,3),P(-1,3),P(-3,0)],ready?\\'#f3fff0\\':C.base);px.line(g,...P(0,-2),...P(3,-2),ready?\\'#ffffff\\':C.hi,1);\\n if(idx){px.poly(g,[P(-4,-3),P(-2,0),P(-4,3),P(-6,0)],\\'#eeab57\\');px.line(g,...P(-14,-3),...P(-12,3),\\'#fbedd0\\',1);}else px.dot(g,...P(-9,0),C.hi);\\n const head=P(10,0);px.disc(g,...head,6.7,C.deep);px.disc(g,head[0]-1,head[1]-1,5.2,C.base);px.line(g,...P(10,-3),...P(13,-2),C.hi,2);px.line(g,...P(10,3),...P(13,2),C.hi,2);\\n const bite=Math.max(0,p.biteFlash||0)*22,open=2+Math.sin(t*57)*bite;\\n for(const s of [-1,1]){px.line(g,...P(14,s*3),...P(19,s*(open+1)),iv.sh,2);px.line(g,...P(19,s*(open+1)),...P(21,s*open),iv.hi,1);px.line(g,...P(10,s*4),...P(14,s*11),C.sh,1);px.line(g,...P(14,s*11),...P(20,s*(12+Math.sin(t*5)*2)),iv.base,1);px.dot(g,...P(20,s*(12+Math.sin(t*5)*2)),C.hi);}\\n if(speed>20&&!ghost)px.line(g,...P(-24,0),...P(-28-speed*.02,0),C.sh,2);\\n}\\nfunction create(game){\\n let fx=[],seen=new Set(),lastSector=-1,lastOpts={},disposed=false;\\n game.lights.enabled=true;game.lights.ambient=.71;\\n const now=()=>Number.isFinite(game.time)?game.time:0;\\n function event(ev,w){\\n  if(disposed)return;const key=ev.id??`${w.tick}:${ev.type}:${ev.player??\\'\\'}`;if(seen.has(key))return;seen.add(key);if(seen.size>2048)seen.delete(seen.values().next().value);\\n  let seed=2166136261;for(const ch of String(key))seed=Math.imul(seed^ch.charCodeAt(0),16777619);\\n  const T=PAL[w.sector]||PAL[0],x=ev.x??w.core.x,y=ev.y??w.core.y;\\n  const colors=ev.type===\\'bite\\'?[PLAYER[ev.player||0],T.hot]:ev.material===\\'reflective\\'?[\\'#d8e4ff\\',\\'#a6a8ff\\']:[T.hot,T.core,T.trim];\\n  let n=0,life=.6,power=45,kind=\\'debris\\';\\n  if(ev.type===\\'bite\\'){n=12;power=48;kind=\\'in\\';life=.35;}\\n  else if(ev.type===\\'chip\\'){n=12;power=75;}\\n  else if(ev.type===\\'charge\\'||ev.type===\\'refill\\'){n=32;power=90;kind=\\'rise\\';life=.7;}\\n  else if(ev.type===\\'core-hit\\'){n=165;power=270;life=1.7;}\\n  else if(ev.type===\\'death\\'){n=40;power=120;life=.9;}\\n  else if(ev.type===\\'cannon-fire\\'){n=32;power=130;life=.5;}\\n  else if(ev.type===\\'reflection\\'){n=26;power=100;life=.65;}\\n  else if(ev.type===\\'respawn\\'){n=30;power=70;kind=\\'in\\';life=.6;}\\n  else if(ev.type===\\'sector-clear\\'||ev.type===\\'victory\\'){n=220;power=370;life=2.4;}\\n  else if(ev.type===\\'immune\\'){n=6;power=55;life=.23;}\\n  for(let i=0;i<n;i++){const a=hash(i*117+seed*3)*TAU,v=(.25+hash(i*19+17))*power;fx.push({x,y,a,v,born:now(),life:life*(.6+hash(i*33+11)*.5),kind,color:colors[i%colors.length],size:1+hash(i*7)*3,spin:hash(i*31)*TAU});}\\n  if([\\'core-hit\\',\\'sector-clear\\',\\'victory\\',\\'cannon-fire\\',\\'reflection\\',\\'charge\\',\\'refill\\',\\'death\\',\\'swirl-launch\\'].includes(ev.type))fx.push({x,y,born:now(),life:ev.type===\\'victory\\'?2.8:ev.type===\\'core-hit\\'?1.4:.65,kind:\\'ring\\',size:ev.type===\\'victory\\'?440:ev.type===\\'core-hit\\'?190:ev.type===\\'cannon-fire\\'?80:60,color:ev.type===\\'reflection\\'?\\'#d6c4ff\\':T.hot});\\n  if([\\'core-hit\\',\\'sector-clear\\',\\'victory\\'].includes(ev.type)&&!lastOpts.reducedShake)game.shake(ev.type===\\'core-hit\\'?5:9);\\n }\\n function backdrop(r,w,T,t){\\n  const g=r.ctx,[ox,oy]=r.w(0,0);\\n  px.rect(g,0,0,r.W+2,r.H+2,T.bg);\\n  // Wide stepped nebula clouds stay behind the machinery, never read as hitboxes.\\n  for(let i=0;i<8;i++)px.blend(g,.1,\\'normal\\',()=>px.ell(g,ox+690+Math.sin(i*1.7)*180,oy+270+Math.cos(i*1.3)*180,270-i*16,110,T.nebula));\\n  for(let i=0;i<185;i++){const sx=hash(i*37+4)*960,sy=hash(i*93+18)*540,v=.25+hash(i*21)*.6;px.blend(g,v,\\'normal\\',()=>{px.rect(g,ox+sx,oy+sy,i%19===0?2:1,i%19===0?2:1,i%7?\\'#6b8a93\\':\\'#bdd4d2\\');if(i%43===0)px.line(g,ox+sx-2,oy+sy,ox+sx+2,oy+sy,T.trim);});}\\n  // Ruined orbital ribs and etched signal routes, all deliberately dark and peripheral.\\n  for(const side of [-1,1]){\\n   const y=side===-1?45:495;\\n   for(let i=0;i<13;i++){const x=64+i*70,h=12+hash(i*19+w.sector)*25;\\n    px.poly(g,[[ox+x-16,oy+y],[ox+x+12,oy+y],[ox+x+25,oy+y+side*h],[ox+x-8,oy+y+side*(h+8)]],T.back);\\n    px.line(g,ox+x-13,oy+y,ox+x+10,oy+y,T.metal,1);px.line(g,ox+x+10,oy+y,ox+x+22,oy+y+side*h,T.deep,3);\\n    for(let q=0;q<3;q++)px.rect(g,ox+x-5+q*5,oy+y+side*(6+q*2),2,2,T.trim);\\n   }\\n   px.line(g,ox+55,oy+y+side*9,ox+940,oy+y+side*9,T.back,1);\\n  }\\n  for(let i=0;i<14;i++){const x=90+hash(i*27)*820,y=80+hash(i*47)*380;px.blend(g,.12,\\'normal\\',()=>{const a=hash(i*11)*TAU;px.line(g,ox+x,oy+y,ox+x+Math.cos(a)*40,oy+y+Math.sin(a)*40,T.trim);px.rect(g,ox+x-2,oy+y-2,4,4,T.trim);});}\\n  // Tiny faraway survivors have winged silhouettes rather than generic stars.\\n  for(let i=0;i<12;i++){const x=85+((i*71+t*4)%820),y=90+hash(i*49)*360;px.blend(g,.2,\\'normal\\',()=>{px.line(g,ox+x-3,oy+y-2,ox+x,oy+y,T.trim);px.line(g,ox+x,oy+y,ox+x+3,oy+y-2,T.trim);px.dot(g,ox+x,oy+y+1,T.trim);});}\\n  // Paired edge markings express vertical wrap in the live arena.\\n  for(let x=115;x<930;x+=110)for(const y of [5,535]){const k=y<20?1:-1;px.poly(g,[[ox+x-5,oy+y+k*4],[ox+x,oy+y],[ox+x+5,oy+y+k*4]],T.metal);px.line(g,ox+x-4,oy+y+k*8,ox+x+4,oy+y+k*8,T.back);}\\n }\\n function refuge(r,w,T,t){\\n  const ref=w.refuge||{x:355,w:100,active:true},g=r.ctx,[x,y]=r.w(ref.x,0),width=ref.w||100,on=ref.active!==false;\\n  px.blend(g,on?.22:.09,\\'normal\\',()=>px.rect(g,x,y,width,540,on?T.static:T.enemy));\\n  for(let i=0;i<135;i++){const xx=x+3+hash(i*13+8)*(width-6),yy=y+((i*137+Math.floor(t*22)*(i%2?1:-1))%540+540)%540,col=i%5===0?\\'#e4fdf3\\':i%3?T.static:T.trim;px.blend(g,on?(i%5?.25:.5):.12,\\'add\\',()=>px.rect(g,xx,yy,3+hash(i*23)*17,1+hash(i*3)*3,col));}\\n  const warning=!!ref.warning;for(const dx of [0,width]){\\n   px.line(g,x+dx,y,x+dx,y+540,on?T.static:\\'#7c3a4d\\',2);\\n   px.line(g,x+dx+(dx?3:-3),y,x+dx+(dx?3:-3),y+540,on?T.back:T.deep,1);\\n   for(let i=0;i<16;i++){const yy=y+((i*37+t*12)%540);px.rect(g,x+dx-2,yy,5,7,warning&&Math.sin(t*8)>0?T.hot:on?T.static:T.enemy);}\\n  }\\n  if(warning||!on){const label=warning?\\'REFUGE FRACTURING\\':\\'STATIC OFFLINE\\';const [cx,cy]=r.w(ref.x+width/2,100);E.font.text(g,label,cx,cy,T.hot,{align:\\'center\\',scale:1,shadow:\\'#080f1c\\',outline:false});}\\n  game.lights.add(ref.x+width*.5,270,1,width*1.4,on?.2:.04,{color:T.static});\\n }\\n function station(r,w,T,t){\\n  const g=r.ctx,c=w.core||{x:810,y:270,dockX:810,dockY:270},[cx,cy]=r.w(c.dockX||810,c.dockY||270),phase=c.phase||0,collapsed=w.mode===\\'victory\\'||w.mode===\\'transition\\';\\n  const M=E.tones(T.metal),R=E.tones(T.trim),radius=138-phase*17;\\n  // Colossal fixed installation: concentric sockets and cable-borne armor petals.\\n  for(let i=0;i<8-phase;i++){\\n   const a=i/(8-phase)*TAU+(w.sector===1?Math.sin(t*.3)*.07:0),P=transform(cx,cy,a),inset=92+Math.sin(t*.5+i)*3;\\n   px.line(g,...P(24,0),...P(inset+28,0),T.deep,18);px.line(g,...P(28,-2),...P(inset+24,-2),T.back,9);px.line(g,...P(40,-4),...P(inset+20,-4),T.metal,2);\\n   for(let k=0;k<4;k++){px.line(g,...P(51+k*14,-6),...P(49+k*14,6),T.deep,2);px.line(g,...P(52+k*14,-6),...P(50+k*14,6),M.base,1);}\\n   const q=P(inset+22,0),Q=transform(q[0],q[1],a);\\n   px.poly(g,[Q(-15,-12),Q(18,-8),Q(25,0),Q(18,8),Q(-15,12),Q(-23,0)],T.deep);\\n   px.poly(g,[Q(-12,-9),Q(17,-6),Q(21,0),Q(17,6),Q(-12,9),Q(-19,0)],M.sh);\\n   px.line(g,...Q(-12,-9),...Q(17,-6),M.lt,1);px.line(g,...Q(17,-6),...Q(21,0),M.base,1);\\n   if(!collapsed)px.line(g,...Q(-8,-1),...Q(11,-1),i%2?T.core:T.hot,1);\\n  }\\n  ring(g,cx,cy,radius,1,T.back,72);ring(g,cx,cy,radius+10,1,T.deep,72);\\n  for(let i=0;i<32;i++){const a=i/32*TAU,x=cx+Math.cos(a)*radius,y=cy+Math.sin(a)*radius;px.line(g,x,y,x+Math.cos(a)*4,y+Math.sin(a)*4,T.metal,1);}\\n  // A dark cruciform docking altar remains distinct from the actual moving heart.\\n  px.poly(g,[[cx-52,cy-45],[cx+52,cy-45],[cx+60,cy+45],[cx-60,cy+45]],T.deep);\\n  for(const s of [-1,1]){plate(g,cx+s*41,cy,16,74,M,3);px.line(g,cx+s*41,cy-20,cx+s*41,cy+20,collapsed?T.deep:R.base,1);}\\n  if(c.state===\\'flight\\'||c.state===\\'windup\\'||c.state===\\'return\\'){dashedRing(g,cx,cy,34,T.static,t*.3);px.disc(g,cx,cy,5,T.back);}\\n  if(!collapsed)game.lights.add(c.dockX||810,c.dockY||270,1,190,.25,{color:T.core});\\n }\\n function shield(r,w,T,t){\\n  const M=E.tones(T.shield),Rf=E.tones(\\'#a6b4d8\\');\\n  for(const cell of w.cells||[]){if(!cell.alive)continue;const size=cell.size||20,reflective=cell.material===\\'reflective\\',C=reflective?Rf:M;\\n   r.actor(cell.x,cell.y,2,(g,x,y)=>{\\n    const h=size/2;px.poly(g,[[x-h+2,y-h],[x+h-2,y-h],[x+h,y-h+2],[x+h,y+h-2],[x+h-2,y+h],[x-h+2,y+h],[x-h,y+h-2],[x-h,y-h+2]],C.deep);\\n    px.rect(g,x-h+2,y-h+2,size-4,size-4,C.base);px.line(g,x-h+3,y-h+2,x+h-3,y-h+2,C.lt,2);px.line(g,x-h+2,y-h+3,x-h+2,y+h-3,C.lt,1);px.line(g,x-h+3,y+h-3,x+h-3,y+h-3,C.sh,2);px.line(g,x+h-3,y-h+3,x+h-3,y+h-3,C.deep,2);\\n    if(reflective){px.poly(g,[[x-4,y-5],[x+5,y-5],[x+2,y+5],[x-6,y+5]],\\'#566084\\');px.line(g,x-3,y+3,x+3,y-3,\\'#f3eaff\\',2);px.dot(g,x+5,y+5,\\'#f3eaff\\');}\\n    else{px.rect(g,x-4,y-4,8,7,C.sh);px.rect(g,x-3,y-3,6,2,C.lt);px.rect(g,x-2,y+1,4,2,C.base);px.dot(g,x-6,y+6,C.hi);}\\n   },{outline:false,rim:false});\\n  }\\n }\\n function core(r,w,T,t){\\n  const c=w.core;if(!c||c.state===\\'defeated\\')return;const flight=c.state===\\'flight\\',wind=c.state===\\'windup\\',returning=c.state===\\'return\\',dock=c.state===\\'dock\\',refillWindow=dock&&((w.sector===2&&c.hp===1)||(w.cells||[]).every(q=>!q.alive)),coreColor=refillWindow?T.static:T.core,radius=(c.r||28),P=E.tones(coreColor),M=E.tones(T.metal),pulse=1+Math.sin(t*(wind?30:3))*.035;\\n  if(flight||returning){const a=Math.atan2(c.vy||0,c.vx||-1);for(let i=6;i>0;i--){const d=i*12,[x,y]=r.w(c.x-Math.cos(a)*d,c.y-Math.sin(a)*d);px.blend(r.ctx,(7-i)*.025,\\'add\\',()=>{ring(r.ctx,x,y,radius*(1-i*.08),2,T.core,24,t*7-i*.3);});}}\\n  if(wind){const [x,y]=r.w(c.x,c.y);dashedRing(r.ctx,x,y,60+Math.sin(t*11)*6,T.hot,-t*2);for(let i=0;i<8;i++){const a=t*1.1+i/8*TAU;px.line(r.ctx,x+Math.cos(a)*68,y+Math.sin(a)*68,x+Math.cos(a)*79,y+Math.sin(a)*79,T.hot,2);}const target=(w.players||[]).find(p=>p.alive);if(target){const dy=E.wrapDiff?E.wrapDiff(c.y,target.y,540):target.y-c.y;const tx=target.x,ty=c.y+dy;for(let i=0;i<1;i++)r.queue(c.x,c.y,0,g=>{const a=r.w(c.x,c.y),b=r.w(tx,ty);px.blend(g,.18,\\'normal\\',()=>px.line(g,...a,...b,T.hot,4));});}}\\n  if(refillWindow){const [x,y]=r.w(c.x,c.y);dashedRing(r.ctx,x,y,48,T.static,t*.3);E.font.text(r.ctx,\\'CONTACT TO REFILL\\',x,y+59,T.static,{scale:1,align:\\'center\\',outline:false,shadow:T.deep});}\\n  r.shadow(c.x,c.y,35,.7,T.deep);\\n  r.actor(c.x,c.y,9,(g,x,y)=>{\\n   if(flight||wind||returning){\\n    const twist=t*(flight?9:wind?4.5:2);for(let i=0;i<4;i++){const a=twist+i/4*TAU,Q=transform(x,y,a),length=flight?44:33+Math.sin(t*12)*6;\\n     px.poly(g,[Q(-3,-6),Q(14,-17),Q(length,-12),Q(length+8,0),Q(15,7),Q(4,4)],P.deep);px.poly(g,[Q(-1,-4),Q(14,-13),Q(length-2,-9),Q(length+3,-1),Q(14,4),Q(4,2)],P.sh);px.poly(g,[Q(6,-5),Q(17,-11),Q(length-4,-8),Q(20,-3)],P.lt);px.line(g,...Q(length-6,-8),...Q(length,-2),P.hi,2);\\n    }\\n   }else{\\n    for(let i=0;i<6;i++){const a=i/6*TAU+t*.04,Q=transform(x,y,a),k=phasePetal(w,c);px.poly(g,[Q(19,-12),Q(37+k,-13),Q(45+k,0),Q(34+k,12),Q(19,11)],M.deep);px.poly(g,[Q(21,-9),Q(35+k,-10),Q(41+k,0),Q(33+k,8),Q(21,8)],M.base);px.line(g,...Q(23,-9),...Q(35+k,-10),M.lt,2);px.line(g,...Q(34+k,-5),...Q(37+k,0),T.hot,1);}\\n   }\\n   const rr=radius*pulse;px.disc(g,x,y,rr+3,P.deep);px.disc(g,x-1,y-2,rr,P.sh);px.disc(g,x-3,y-4,rr*.77,P.base);px.disc(g,x-6,y-7,rr*.55,P.lt);ring(g,x,y,rr*.83,2,P.deep,36);\\n   // Deep black mechanical iris with a faceted living signal suspended inside.\\n   const eye=transform(x,y,t*.2);px.poly(g,[eye(-16,-7),eye(-5,-16),eye(12,-11),eye(17,5),eye(4,15),eye(-13,10)],\\'#121725\\');\\n   const iris=(wind?12:9)+Math.sin(t*6)*1.2;px.disc(g,x,y,iris,P.lt);px.disc(g,x+1,y+1,iris*.66,P.deep);px.rect(g,x-2,y-8,4,16,wind?T.hot:\\'#fff0cf\\');px.rect(g,x-6,y-2,12,4,wind?T.hot:\\'#fff0cf\\');px.dot(g,x-4,y-5,\\'#ffffff\\');\\n   if(c.state===\\'phase-break\\')px.blend(g,.5,\\'add\\',()=>px.disc(g,x,y,rr+8,T.hot));\\n  },{outline:true,rim:true,emissive:true});\\n  game.lights.add(c.x,c.y,12,110,wind?.9:.65,{color:coreColor});\\n }\\n function phasePetal(w,c){return(w.sector===2?Math.max(0,3-c.hp):Math.max(0,c.maxHp-c.hp))*-3;}\\n function rail(r,w,T,t){\\n  const g=r.ctx,M=E.tones(\\'#49616e\\'),[x,y]=r.w(30,0);\\n  px.rect(g,x-12,y,22,540,M.deep);px.rect(g,x-11,y,4,540,M.sh);px.rect(g,x+6,y,3,540,M.base);px.line(g,x-8,y,x-8,y+540,M.lt,1);px.line(g,x+10,y,x+10,y+540,T.deep,3);\\n  for(let i=0;i<33;i++){const yy=i*17;px.rect(g,x-5,y+yy,10,7,T.deep);px.line(g,x-4,y+yy,x+3,y+yy,M.base,1);}\\n  for(const p of w.players||[]){if(!p.alive)continue;const ready=p.ready||p.charge>=(w.tuning?.chargeThreshold||5),C=E.tones(PLAYER[(p.index||0)%2]);\\n   r.actor(30,p.y,3,(g,xx,yy)=>{\\n    plate(g,xx,yy,33,40,M,4);px.rect(g,xx+11,yy-8,22,16,M.deep);px.rect(g,xx+12,yy-7,18,5,C.sh);px.rect(g,xx+12,yy+3,18,4,M.deep);px.line(g,xx+12,yy-8,xx+31,yy-8,M.lt,1);\\n    px.disc(g,xx,yy,10,C.deep);px.disc(g,xx-1,yy-1,7,ready?C.lt:C.sh);px.disc(g,xx-2,yy-2,3,ready?\\'#f4fff3\\':C.base);\\n    for(let i=0;i<5;i++)px.rect(g,xx-10+i*5,yy+15,3,2,i<p.charge?C.lt:M.sh);\\n    if(ready){ring(g,xx,yy,13+Math.sin(t*7),1,C.lt);px.rect(g,xx+30,yy-5,3,10,\\'#f1fff3\\');}\\n   },{outline:false,rim:true});\\n   if(ready){const start=r.w(64,p.y),end=r.w(946,p.y);px.blend(g,.28,\\'normal\\',()=>px.line(g,...start,...end,C.base,1));for(let xx=70;xx<946;xx+=45){const q=r.w(xx,p.y);px.rect(g,q[0],q[1]-1,(p.index||0)?8:3,2,C.lt);}}\\n  }\\n }\\n function bullets(r,w,T,t){\\n  for(const b of w.shots||[]){const [x,y]=r.w(b.x,b.y),speed=Math.hypot(b.vx,b.vy)||1,dx=b.vx/speed,dy=b.vy/speed;px.line(r.ctx,x-dx*12,y-dy*12,x+dx*2,y+dy*2,PLAYER[(b.owner||0)%2],2);px.line(r.ctx,x-dx*4,y-dy*4,x+dx*2,y+dy*2,\\'#e9fff7\\',2);}\\n  for(const b of w.cannons||[]){const C=b.reflected?\\'#e0b7ff\\':PLAYER[(b.owner||0)%2],g=r.ctx,[x,y]=r.w(b.x,b.y);\\n   if(b.warn>0||b.returnWarn>0){const reflected=b.returnWarn>0,[sx,sy]=r.w(reflected?b.x:30,b.y),[ex,ey]=r.w(reflected?30:950,b.y);px.blend(g,.17+.07*Math.sin(t*38),\\'normal\\',()=>px.line(g,sx,sy,ex,ey,C,20));px.line(g,sx,sy,ex,ey,C,2);for(let xx=70;xx<940;xx+=48){const q=r.w(xx,b.y),d=reflected?-1:1;px.line(g,q[0]-d*5,q[1]-5,q[0],q[1],C,2);px.line(g,q[0]-d*5,q[1]+5,q[0],q[1],C,2);}E.font.text(g,reflected?\\'RETURN SHOT\\':\\'LANE LOCKED\\',Math.min(sx+100,780),sy-21,C,{scale:1,outline:false,shadow:T.deep});}\\n   else{const direction=b.vx<0?-1:1;for(let i=0;i<5;i++)px.blend(g,(5-i)*.045,\\'add\\',()=>px.ell(g,x-direction*(12+i*10),y,18+i*4,7-i*.5,C));px.poly(g,[[x-direction*21,y-7],[x+direction*8,y-7],[x+direction*16,y],[x+direction*8,y+7],[x-direction*21,y+7]],C);px.line(g,x-direction*17,y,x+direction*9,y,\\'#ffffff\\',5);px.line(g,x-direction*7,y-3,x+direction*5,y-3,\\'#fbfff2\\',2);game.lights.add(b.x,b.y,8,90,.9,{color:C});}\\n  }\\n }\\n function threats(r,w,T,t){\\n  for(const h of w.hazards||[]){if(h.alive===false)continue;const a=h.angle??Math.atan2(h.vy||0,h.vx||-1),[x,y]=r.w(h.x,h.y),Q=transform(x,y,a);\\n   if(h.kind===\\'needle\\'){px.line(r.ctx,...Q(-17,0),...Q(9,0),T.enemy,3);px.line(r.ctx,...Q(-4,0),...Q(10,0),\\'#fff0d6\\',1);continue;}\\n   for(let i=4;i>0;i--)px.blend(r.ctx,(5-i)*.055,\\'add\\',()=>px.disc(r.ctx,x-Math.cos(a)*i*6,y-Math.sin(a)*i*6,Math.max(1,6-i),T.enemy));\\n   r.actor(h.x,h.y,4,(g,xx,yy)=>{const P=transform(xx,yy,a);px.poly(g,[P(13,0),P(4,-7),P(-7,-9),P(-4,-2),P(-10,0),P(-4,2),P(-7,9),P(4,7)],\\'#3e202d\\');px.poly(g,[P(10,0),P(3,-5),P(-5,-6),P(-2,0),P(-5,6),P(3,5)],T.enemy);px.line(g,...P(-2,0),...P(8,0),\\'#ffe0ba\\',2);px.dot(g,...P(3,-3),\\'#ffffff\\');},{outline:true,emissive:true});\\n  }\\n }\\n function scouts(r,w,T,t,opts){\\n  for(const p of w.players||[]){if(!p.alive){if(p.respawn>0){const [x,y]=r.w(p.x,p.y);dashedRing(r.ctx,x,y,24+Math.sin(t*8)*4,PLAYER[(p.index||0)%2],t);E.font.text(r.ctx,\\'REASSEMBLING\\',x,y+35,PLAYER[(p.index||0)%2],{align:\\'center\\',outline:false,scale:1});}continue;}\\n   r.shadow(p.x,p.y,13,.55,T.deep);\\n   if(p.invuln>0){const[x,y]=r.w(p.x,p.y);dashedRing(r.ctx,x,y,32,PLAYER[(p.index||0)%2],t*2);}\\n   if(p.ready){const[x,y]=r.w(p.x,p.y);px.blend(r.ctx,.17,\\'add\\',()=>px.disc(r.ctx,x,y,26+Math.sin(t*7)*3,PLAYER[(p.index||0)%2]));}\\n   r.actor(p.x,p.y,10,(g,x,y)=>insect(g,x,y,t,p),{outline:true,rim:true,emissive:true,wrap:[960,540]});\\n   if(p.y<35||p.y>505){const ghostY=p.y<35?p.y+540:p.y-540;const[x,y]=r.w(p.x,ghostY);px.blend(r.ctx,.3,\\'normal\\',()=>insect(r.ctx,x,y,t,p,1,true));}\\n   game.lights.add(p.x,p.y,10,64,p.ready?.5:.3,{color:PLAYER[(p.index||0)%2]});\\n   if(opts.debug){const[x,y]=r.w(p.x,p.y);ring(r.ctx,x,y,9,1,\\'#ffffff\\',24);px.line(r.ctx,x-3,y,x+3,y,\\'#ffffff\\');px.line(r.ctx,x,y-3,x,y+3,\\'#ffffff\\');}\\n  }\\n }\\n function effects(r,w,T,t,opts){\\n  const at=now();fx=fx.filter(f=>at-f.born<f.life&&at>=f.born);\\n  r.overlay(g=>{for(const f of fx){const age=at-f.born,u=age/f.life,fade=1-u;let wx=f.x,wy=f.y;\\n   if(f.kind===\\'ring\\'){const[x,y]=r.w(wx,wy);px.blend(g,fade*(opts.reducedFlash?.3:.7),\\'add\\',()=>ring(g,x,y,5+f.size*(1-(1-u)*(1-u)),Math.max(1,5*fade),f.color,72));if(u<.12&&!opts.reducedFlash)px.blend(g,(.12-u)*2,\\'add\\',()=>px.disc(g,x,y,35+f.size*u,f.color));continue;}\\n   const d=f.kind===\\'in\\'?f.v*(1-u)*.4:f.v*age;wx+=Math.cos(f.a)*d;wy+=Math.sin(f.a)*d+(f.kind===\\'rise\\'?-age*45:age*age*12);\\n   const[x,y]=r.w(wx,wy);px.blend(g,fade*.9,\\'normal\\',()=>{if(f.kind===\\'debris\\'){const Q=transform(x,y,f.spin+age*5),s=f.size;px.poly(g,[Q(-s,-s),Q(s+2,-s),Q(s,s),Q(-s,s)],f.color);px.line(g,...Q(-s,-s),...Q(s+2,-s),\\'#fff0c8\\',1);}else{px.rect(g,x,y,Math.max(1,f.size*fade),Math.max(1,f.size*fade),f.color);if(f.kind===\\'rise\\')px.line(g,x,y,x,y+4*fade,f.color,1);}});\\n  }});\\n }\\n function survivors(r,w,T,t){\\n  if(w.mode!==\\'victory\\')return;\\n  r.overlay(g=>{for(let i=0;i<38;i++){const x=480+Math.sin(i*3.31+t*.15)*410,y=270+Math.cos(i*1.73+t*.21)*210,s=.18+hash(i)*.24;px.blend(g,.25+hash(i*47)*.55,\\'normal\\',()=>insect(g,x,y,t+i,{index:i%2,ax:-1,ay:.3*Math.sin(t+i),vx:-70,vy:0,ready:true},s));}});\\n }\\n function draw(r,w,opts={}){\\n  if(disposed||!w)return;lastOpts=opts;const T=PAL[w.sector]||PAL[0],t=Number.isFinite(w.time)?w.time:now();\\n  if(lastSector!==w.sector){lastSector=w.sector;fx=fx.filter(f=>now()-f.born<f.life);}\\n  backdrop(r,w,T,t);refuge(r,w,T,t);station(r,w,T,t);rail(r,w,T,t);shield(r,w,T,t);core(r,w,T,t);bullets(r,w,T,t);threats(r,w,T,t);scouts(r,w,T,t,opts);effects(r,w,T,t,opts);survivors(r,w,T,t);\\n  if(opts.debug)r.overlay(g=>{for(const c of w.cells||[])if(c.alive){const[x,y]=r.w(c.x,c.y);px.line(g,x-10,y-10,x+10,y-10,\\'#ffffff\\',1);}for(const b of w.cannons||[]){const[x,y]=r.w(b.x,b.y);ring(g,x,y,b.r||7,1,\\'#ffffff\\',24);}});\\n }\\n return{draw,event,dispose(){disposed=true;fx=[];seen.clear();},debug:()=>({effects:fx.length,seen:seen.size,disposed})};\\n}\\nroot.RuinRender={create,palettes:PAL,insect};\\n})();\\n\\n\\n\\n/* Original code-only score, impacts and formant chatter. No recorded audio. */\\n(() => {\\n\\'use strict\\';\\nconst root=typeof window!==\\'undefined\\'?window:globalThis;\\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\\nfunction createSynth(ctx,buses){\\n  const active=new Set();let stopped=false,created=0;\\n  let z=0x61f73019;const noise=ctx.createBuffer(1,ctx.sampleRate,ctx.sampleRate),d=noise.getChannelData(0);\\n  for(let i=0;i<d.length;i++){z^=z<<13;z^=z>>>17;z^=z<<5;d[i]=((z>>>0)/4294967296)*2-1;}\\n  function note(type,freq,to,dur,vol,bus=\\'sfx\\',delay=0,filter=null){\\n    if(stopped||!Number.isFinite(freq)||!Number.isFinite(vol))return;\\n    const at=ctx.currentTime+Math.max(0,delay),end=at+Math.max(.025,dur),gain=ctx.createGain();\\n    gain.gain.setValueAtTime(0,at);gain.gain.linearRampToValueAtTime(clamp(vol,0,.28),at+.008);gain.gain.exponentialRampToValueAtTime(.00001,end-.008);gain.gain.linearRampToValueAtTime(0,end);\\n    let source;\\n    if(type===\\'noise\\'){source=ctx.createBufferSource();source.buffer=noise;source.loop=true;source.playbackRate.setValueAtTime(clamp(freq/1600,.1,4),at);}\\n    else{source=ctx.createOscillator();source.type=type;source.frequency.setValueAtTime(clamp(freq,20,12000),at);if(to)source.frequency.exponentialRampToValueAtTime(clamp(to,20,12000),end);}\\n    const nodes=[source,gain];source.connect(gain);let tail=gain;\\n    if(filter){const f=ctx.createBiquadFilter();f.type=filter.type||\\'lowpass\\';f.frequency.value=filter.freq||1200;f.Q.value=filter.q||.7;tail.connect(f);tail=f;nodes.push(f);}\\n    tail.connect(buses[bus]||buses.sfx);active.add(source);created++;\\n    source.onended=()=>{active.delete(source);for(const n of nodes)try{n.disconnect();}catch{}};\\n    source.start(at);source.stop(end+.012);return source;\\n  }\\n  function chatter(fortress=false,delay=0){\\n    const syllables=fortress?[102,153,94,132,87]:[288,376,260,408,330];\\n    syllables.forEach((f,i)=>{const t=delay+i*.085;note(\\'sawtooth\\',f,f*(i%2?1.18:.84),.066,.022,\\'voice\\',t,{type:\\'bandpass\\',freq:fortress?640+i*120:1000+i*170,q:4});note(\\'sine\\',f*2,f*1.8,.062,.012,\\'voice\\',t);});\\n  }\\n  function stop(){stopped=true;for(const s of active){try{s.stop();}catch{}try{s.disconnect();}catch{}}active.clear();}\\n  return{note,chatter,stop,active,stats:()=>({active:active.size,created,stopped})};\\n}\\nfunction create(game){\\n  const A=game.audio;let enabled=false,disposed=false,synth=null,gates=null,sequence=0,beatTime=0,sector=-1,prevState=\\'\\',silent=true;\\n  let beat=0;const played=new Set();\\n  function unlock(){\\n    if(disposed||game.headless)return false;enabled=true;\\n    const bus=A.bus(\\'sfx\\');if(!bus||!A.ctx)return false;\\n    if(A.ctx.state===\\'suspended\\')A.ctx.resume().catch(()=>{});\\n    if(!synth){gates={};for(const name of [\\'sfx\\',\\'music\\',\\'voice\\']){const g=A.ctx.createGain();g.gain.value=0;g.connect(A.bus(name));gates[name]=g;}synth=createSynth(A.ctx,gates);}\\n    return true;\\n  }\\n  function setSilence(on){if(!gates||silent===on)return;silent=on;const t=A.ctx.currentTime;for(const g of Object.values(gates)){g.gain.cancelScheduledValues(t);g.gain.setTargetAtTime(on?0:1,t,.015);}}\\n  function update(dt,w,opts={}){\\n    if(disposed)return;\\n    if(!enabled&&A.ready)unlock();\\n    if(!synth)return;\\n    setSilence(!!(opts.paused||opts.silent));if(silent)return;\\n    beatTime-=Math.max(0,dt);\\n    if(w.sector!==sector){sector=w.sector;beat=0;beatTime=0;}\\n    const N=synth.note;\\n    if(beatTime<=0){\\n      beatTime+=sector===2?.19:sector===1?.23:.27;\\n      const roots=[55,61.735,65.406],base=roots[sector]||55;\\n      const motif=[0,7,12,3,0,10,7,3,0,7,15,12,10,3,7,-2],st=motif[beat%motif.length];\\n      if(beat%4===0){N(\\'triangle\\',base,base,.93,.095,\\'music\\');N(\\'sawtooth\\',base*1.005,base*.998,.85,.028,\\'music\\',0,{freq:330});}\\n      N(\\'sine\\',base*4*Math.pow(2,st/12),0,.35,.047,\\'music\\',0,{freq:1800});\\n      if(beat%2===0)N(\\'noise\\',4500,0,.024,.011,\\'music\\',0,{type:\\'highpass\\',freq:4200});\\n      if(sector>0&&beat%4===2)N(\\'sine\\',90,43,.14,.06,\\'music\\');\\n      if(w.core&&(w.core.state===\\'windup\\'||w.core.state===\\'flight\\'))N(\\'triangle\\',base*8*Math.pow(2,([0,1,7,6][beat%4])/12),0,.12,.018,\\'music\\');\\n      if(w.players?.some(p=>p.ready||p.charge>=(w.tuning?.chargeThreshold||5)))N(\\'sine\\',base*16,0,.12,.011,\\'music\\',.09);\\n      beat++;sequence++;\\n    }\\n    prevState=w.core?.state||prevState;\\n  }\\n  function event(ev,w){\\n    if(disposed||!synth||silent)return;\\n    const key=ev.id===undefined?`${w.tick}:${ev.type}:${ev.player??\\'\\'}`:ev.id;if(played.has(key))return;played.add(key);if(played.size>1024)played.delete(played.values().next().value);\\n    const N=synth.note;\\n    switch(ev.type){\\n      case \\'primary\\':N(\\'triangle\\',970,410,.055,.018);break;\\n      case \\'needles\\':N(\\'sawtooth\\',580,210,.14,.027,\\'sfx\\',0,{freq:1700});break;\\n      case \\'sector-start\\':synth.chatter(w.sector===2);break;\\n      case \\'defeat\\':N(\\'triangle\\',196,37,.9,.06);break;\\n      case \\'chip\\':N(\\'noise\\',2200,0,.045,.045,\\'sfx\\',0,{type:\\'highpass\\',freq:1300});N(\\'sine\\',700,360,.04,.025);break;\\n      case \\'bite\\':N(\\'noise\\',650,0,.065,.07,\\'sfx\\',0,{type:\\'bandpass\\',freq:820,q:1.6});N(\\'triangle\\',270,530,.06,.025);break;\\n      case \\'charge\\':for(let i=0;i<5;i++)N(\\'sine\\',392*Math.pow(2,[0,3,7,12,19][i]/12),0,.22,.035,\\'sfx\\',i*.055);synth.chatter();break;\\n      case \\'cannon-warn\\':N(\\'square\\',210,440,.19,.032);N(\\'sine\\',840,1050,.19,.03);break;\\n      case \\'cannon-fire\\':N(\\'noise\\',1100,0,.37,.13,\\'sfx\\',0,{freq:1700});N(\\'sine\\',165,37,.5,.14);N(\\'sawtooth\\',520,90,.25,.045);break;\\n      case \\'reflection\\':for(let i=0;i<3;i++)N(\\'square\\',1800-i*280,720-i*100,.085,.032,\\'sfx\\',i*.085);N(\\'noise\\',2800,0,.27,.04,\\'sfx\\',0,{type:\\'highpass\\',freq:1800});break;\\n      case \\'swirl-warn\\':N(\\'sawtooth\\',95,480,.9,.055,\\'sfx\\',0,{type:\\'bandpass\\',freq:1300,q:3});for(let i=0;i<4;i++)N(\\'sine\\',580+i*130,0,.11,.027,\\'sfx\\',i*.2);synth.chatter(true);break;\\n      case \\'swirl-launch\\':N(\\'noise\\',720,0,.6,.09,\\'sfx\\',0,{type:\\'bandpass\\',freq:600});N(\\'sawtooth\\',320,65,.5,.045);break;\\n      case \\'core-hit\\':N(\\'noise\\',900,0,1.1,.18,\\'sfx\\',0,{freq:1200});N(\\'sine\\',80,25,1.4,.16);N(\\'noise\\',3400,0,.28,.06,\\'sfx\\',.08,{type:\\'highpass\\',freq:2000});break;\\n      case \\'sector-clear\\':for(let i=0;i<5;i++)N(\\'triangle\\',261.63*Math.pow(2,[0,3,7,12,15][i]/12),0,.5,.05,\\'sfx\\',i*.11);synth.chatter();break;\\n      case \\'death\\':N(\\'square\\',430,47,.43,.06);N(\\'noise\\',1300,0,.28,.07,\\'sfx\\',0,{freq:1500});break;\\n      case \\'respawn\\':for(let i=0;i<3;i++)N(\\'sine\\',330+i*220,0,.14,.028,\\'sfx\\',i*.08);break;\\n      case \\'refill\\':N(\\'triangle\\',220,880,.31,.05);break;\\n      case \\'victory\\':for(let i=0;i<9;i++)N(\\'triangle\\',261.63*Math.pow(2,[0,7,12,15,19,24,19,15,12][i]/12),0,.7,.045,\\'sfx\\',i*.13);synth.chatter();break;\\n      case \\'refuge-warning\\':case \\'refuge-outage\\':N(\\'triangle\\',330,164,.6,.05);N(\\'noise\\',900,0,.25,.035,\\'sfx\\',0,{type:\\'bandpass\\',freq:1600});break;\\n      case \\'static-block\\':N(\\'noise\\',3000,0,.04,.025,\\'sfx\\',0,{type:\\'highpass\\',freq:2600});break;\\n      case \\'immune\\':N(\\'sine\\',980,430,.06,.025);break;\\n    }\\n  }\\n  function dispose(){if(disposed)return;disposed=true;if(synth)synth.stop();if(gates)for(const g of Object.values(gates))try{g.disconnect();}catch{}played.clear();}\\n  function suspend(){setSilence(true);}\\n  return{unlock,update,event,dispose,suspend,debug:()=>({enabled,disposed,silent,sequence,sector,...(synth?synth.stats():{active:0,created:0,stopped:false}),musicVolume:A.musicVolume,sfxVolume:A.sfxVolume,voiceVolume:A.voiceVolume,muted:A.muted})};\\n}\\nasync function offlineProof(){\\n  const Offline=root.OfflineAudioContext||root.webkitOfflineAudioContext;if(!Offline)return{available:false};\\n  const ctx=new Offline(1,48000*2,48000),bus=ctx.createGain();bus.gain.value=.7;bus.connect(ctx.destination);\\n  const synth=createSynth(ctx,{sfx:bus,music:bus,voice:bus});\\n  synth.note(\\'noise\\',1000,0,.3,.12,\\'sfx\\',0,{freq:1500});synth.note(\\'sine\\',180,45,.5,.13);synth.note(\\'triangle\\',220,440,.33,.07,\\'music\\',.36);synth.chatter(false,.8);synth.chatter(true,1.25);\\n  const result=await ctx.startRendering(),d=result.getChannelData(0);let peak=0,sum=0,tail=0,finite=true;\\n  for(let i=0;i<d.length;i++){const x=d[i];if(!Number.isFinite(x))finite=false;peak=Math.max(peak,Math.abs(x));sum+=x*x;if(i>d.length-2000)tail+=x*x;}\\n  retur