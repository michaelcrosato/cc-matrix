{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"sed -n '2838,2855p' Yars-*/vendor/engine/my-3d2dge.js && sed -n '38,67p' Yars-*/src/presentation/render.js\"","aggregated_output":"   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\n   * with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test\n   * that catches what a player would see break). Returns the updates run\n   */\n  advance(seconds = this.o.step, o = {}) {\n    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n    this._acc += Math.max(0, seconds);\n    const n = this._steps(); this.stats.steps = n;\n    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n    return n;\n  }\n  /**\n   * the clock: an exact fixed step. Real time (at most 50 ms a frame, so a stall can't run away) fills an accumulator;\n   * each whole o.step of it (1/120 s) runs one update of o.step * timeScale game seconds (split in two or more when\n   * timeScale > 1, so no step is longer than o.step), and the remainder waits for the next frame (game.alpha = its\n   * fraction of a step). 60 Hz runs two steps a frame, 120 Hz one, 144 Hz one on most frames: the same steps at any rate.\n   * Slow motion makes steps shorter, never fewer. Paused or at timeScale 0 the steps still run (dt 0), so input ticks.\n   * The first frame always updates (with dt 0 when its time is short of a step), so draw never comes before update.\n const head=P(10,0);px.disc(g,...head,6.7,C.deep);px.disc(g,head[0]-1,head[1]-1,5.2,C.base);px.line(g,...P(10,-3),...P(13,-2),C.hi,2);px.line(g,...P(10,3),...P(13,2),C.hi,2);\n const bite=Math.max(0,p.biteFlash||0)*22,open=2+Math.sin(t*57)*bite;\n for(const s of [-1,1]){px.line(g,...P(14,s*3),...P(19,s*(open+1)),iv.sh,2);px.line(g,...P(19,s*(open+1)),...P(21,s*open),iv.hi,1);px.line(g,...P(10,s*4),...P(14,s*11),C.sh,1);px.line(g,...P(14,s*11),...P(20,s*(12+Math.sin(t*5)*2)),iv.base,1);px.dot(g,...P(20,s*(12+Math.sin(t*5)*2)),C.hi);}\n if(speed>20&&!ghost)px.line(g,...P(-24,0),...P(-28-speed*.02,0),C.sh,2);\n}\nfunction create(game){\n let fx=[],seen=new Set(),lastSector=-1,lastOpts={},disposed=false;\n game.lights.enabled=true;game.lights.ambient=.71;\n const now=()=>Number.isFinite(game.time)?game.time:0;\n function event(ev,w){\n  if(disposed)return;const key=ev.id??`${w.tick}:${ev.type}:${ev.player??''}`;if(seen.has(key))return;seen.add(key);if(seen.size>2048)seen.delete(seen.values().next().value);\n  let seed=2166136261;for(const ch of String(key))seed=Math.imul(seed^ch.charCodeAt(0),16777619);\n  const T=PAL[w.sector]||PAL[0],x=ev.x??w.core.x,y=ev.y??w.core.y;\n  const colors=ev.type==='bite'?[PLAYER[ev.player||0],T.hot]:ev.material==='reflective'?['#d8e4ff','#a6a8ff']:[T.hot,T.core,T.trim];\n  let n=0,life=.6,power=45,kind='debris';\n  if(ev.type==='bite'){n=12;power=48;kind='in';life=.35;}\n  else if(ev.type==='chip'){n=12;power=75;}\n  else if(ev.type==='charge'||ev.type==='refill'){n=32;power=90;kind='rise';life=.7;}\n  else if(ev.type==='core-hit'){n=165;power=270;life=1.7;}\n  else if(ev.type==='death'){n=40;power=120;life=.9;}\n  else if(ev.type==='cannon-fire'){n=32;power=130;life=.5;}\n  else if(ev.type==='reflection'){n=26;power=100;life=.65;}\n  else if(ev.type==='respawn'){n=30;power=70;kind='in';life=.6;}\n  else if(ev.type==='sector-clear'||ev.type==='victory'){n=220;power=370;life=2.4;}\n  else if(ev.type==='immune'){n=6;power=55;life=.23;}\n  for(let i=0;i<n;i++){const a=hash(i*117+seed*3)*TAU,v=(.25+hash(i*19+17))*power;fx.push({x,y,a,v,born:now(),life:life*(.6+hash(i*33+11)*.5),kind,color:colors[i%colors.length],size:1+hash(i*7)*3,spin:hash(i*31)*TAU});}\n  if(['core-hit','sector-clear','victory','cannon-fire','reflection','charge','refill','death','swirl-launch'].includes(ev.type))fx.push({x,y,born:now(),life:ev.type==='victory'?2.8:ev.type==='core-hit'?1.4:.65,kind:'ring',size:ev.type==='victory'?440:ev.type==='core-hit'?190:ev.type==='cannon-fire'?80:60,color:ev.type==='reflection'?'#d6c4ff':T.hot});\n  if(['core-hit','sector-clear','victory'].includes(ev.type)&&!lastOpts.reducedShake)game.shake(ev.type==='core-hit'?5:9);\n }\n function backdrop(r,w,T,t){\n","exit_code":0,"status":"completed"}}
