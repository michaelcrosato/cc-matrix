{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"sed -n '547,563p' Yars-*/src/sim.js\"","aggregated_output":"      tx = clamp(p.x + (p.x >= core.x ? 60 : -60), 80, 900);\n    }\n    // In the showcase the pilot tries its primary while crossing static so the silent refuge is demonstrated.\n    if (options.attract && isStatic(w, p)) fire = true;\n    let mx = clamp((tx - p.x) / Math.max(8, speed * .1), -1, 1), my = clamp(dy(ty, p.y) / Math.max(8, speed * .1), -1, 1);\n    if (Math.abs(tx - p.x) < 1) mx = 0; if (Math.abs(dy(ty, p.y)) < 1) my = 0;\n    return { mx, my, ax, ay, fire, cannon };\n  }\n  globalThis.RuinSim = { W, H, DT, create, step, snapshot, nextSector, tune, command, pilot, validateContent, exportContent, cellPosition: (_w, c) => ({ x: c.x, y: c.y }), isStatic, wrappedDy: dy, wrap, distance: dist };\n})();\n","exit_code":0,"status":"completed"}}
