ues; game.script(function* () { ... })\\n *    runs a coroutine in the update step that waits at each yield (seconds, a condition, a tween, other scripts). Both\\n *    pause with the game, stand still in hit-stop, slow with timeScale and end with the scene unless kept (o.keep): the\\n *    same at every refresh rate, as the steps are.\\n * ============================================================================= */\\nconst _jobs = g => g._jobs || (g._jobs = []);\\n// each step: every tween and script made before it, then any script whose wait ended in it (a tween or a script it waits\\n// on finished after it in the list) goes on in the same step\\nHOOKS.step.push((g, dt) => {\\n  const J = g._jobs; g._jobN = (g._jobN || 0) + 1; if (!J || !J.length) return;\\n  const n = J.length; for (let i = 0; i < n; i++) if (!J[i].done) J[i]._step(dt);\\n  for (let k = 0, more = true; more && k < 8; k++) { more = false; for (const j of J) if (!j.done && j._w && j._w(0)) { j._go(); more = true; } }\\n  prune(J, j => j.done);\\n});\\nHOOKS.enter.push(g => { const J = g._jobs; if (J) for (const j of J.slice()) if (!j.keep) j.cancel(); });\\nclass Tween {\\n  /** a tween, made by game.tween: done (it ended, or was cancelled), cancel(); a script can yield it */\\n  constructor(game, target, to, seconds, o = {}) {\\n    /** target: what it moves; to: the values it moves them to; keep: it outlives the scene; done: it ended, or was\\n     *  cancelled */\\n    this.target = target; this.to = to; this.keep = !!o.keep; this.done = false;\\n    this._g = game; this._dur = Math.max(0, +seconds || 0); this._t = -(+o.delay || 0); this._from = null; this._k = 0; this._yoyo = !!o.yoyo; this._onDone = o.onDone || null;\\n    this._left = o.repeat === undefined ? 0 : o.repeat < 0 ? Infinity : o.repeat;\\n    const e = o.ease === undefined ? \\'outQuad\\' : o.ease;\\n    this._ease = typeof e === \\'function\\' ? e : ease[e] || (warn(\\'ease:\\' + e, \\'unknown ease \"\\' + e + \\'\": E.ease has \\' + Object.keys(ease).join(\\', \\')), ease.outQuad);\\n  }\\n  _step(dt) {\\n    if ((this._t += dt) < 0) return;\\n    const D = this._dur, T = this.target;\\n    if (!this._from) { this._from = {}; for (const k in this.to) this._from[k] = +T[k] || 0; }\\n    const end = this._t >= D - 1e-9;   // (the steps\\' rounding: 30 of 1/120 s are a quarter second)\\n    if (end && this._left > 0) { this._left--; this._k++; this._t = D > 0 ? Math.max(0, this._t - D) : 0; }\\n    else if (end) {   // the end: exactly its values (or where it started, a yoyo\\'s odd play)\\n      const back = this._yoyo && this._k % 2; for (const k in this.to) T[k] = back ? this._from[k] : this.to[k];\\n      this.done = true; if (this._onDone) try { this._onDone(T); } catch (e) { this._g.fail(\\'tween onDone\\', e); }\\n      return;\\n    }\\n    const u = D > 0 ? Math.min(1, this._t / D) : 1, v = this._ease(this._yoyo && this._k % 2 ? 1 - u : u);\\n    for (const k in this.to) T[k] = this._from[k] + (this.to[k] - this._from[k]) * v;\\n  }\\n  /** stop it where it is (no onDone) */\\n  cancel() { this.done = true; }\\n}\\n/**\\n * ease target\\'s numbers to new values over seconds of game time: game.tween(door, { y: 40 }, .5, { ease: \\'outBack\\',\\n * delay, repeat (more plays; -1 forever), yoyo (every other play runs back), onDone(target), keep (outlive the scene) }).\\n * ease: a name in E.ease (\\'outQuad\\' by default) or a function of u 0..1. It starts from the values the target has once\\n * its delay is over. Returns the Tween: tween.done, tween.cancel()\\n */\\nGame.prototype.tween = function (target, to, seconds, o) { const t = new Tween(this, target, to, seconds, o); _jobs(this).push(t); return t; };\\n// what a script\\'s yield waits for, as a function of the step\\'s dt that is true once it is over (called with 0 at once)\\nconst _waitFor = (sc, w) => {\\n  if (w == null) { const g = sc._g, s = g._jobN || 0; return () => (g._jobN || 0) > s; }   // yield; : the next step\\n  if (typeof w === \\'number\\') { let left = w; return dt => (left -= dt) <= 1e-9; }\\n  if (w instanceof Tween || w instanceof Script) return () => w.done;\\n  if (typeof w === \\'function\\' && !/Generator/.test(w.constructor && w.constructor.name)) return () => !!w();\\n  if (typeof w === \\'function\\' || typeof w.next === \\'function\\') { const k = new Script(sc._g, w, { keep: sc.keep }); _jobs(sc._g).push(k); sc._kids.push(k); return () => k.done; }\\n  if (typeof w.until === \\'function\\') return () => !!w.until();\\n  const L = Array.isArray(w) ? w : w.all || w.any;\\n  if (L) { const f = L.map(x => _waitFor(sc, x)), got = f.map(() => false), any = !!w.any; return dt => { f.forEach((x, i) => { if (!got[i]) got[i] = x(dt); }); return any ? got.some(Boolean) : got.every(Boolean); }; }\\n  warn(\\'script:yield\\', \\'a script yielded something it cannot wait for (seconds, a condition, a tween, a script, a generator, E.until, E.all, E.any): it waits one step\\');\\n  return _waitFor(sc, null);\\n};\\nclass Script {\\n  /** a script, made by game.script: done (it returned, or was cancelled), value (what it returned), cancel(); another\\n   *  script can yield it */\\n  constructor(game, fn, o = {}) {\\n    /** keep: it outlives the scene; done: it returned, or was cancelled; value: what it returned */\\n    this.keep = !!o.keep; this.done = false; this.value = undefined; this._g = game; this._kids = []; this._w = null;\\n    this._it = typeof fn === \\'function\\' ? fn(game) : fn;\\n    if (!this._it || typeof this._it.next !== \\'function\\') { warn(\\'script\\', \\'game.script needs a generator: game.script(function* () { yield .5; ... })\\'); this.done = true; return; }\\n    this._go();\\n  }\\n  _step(dt) { if (!this._w || this._w(dt)) this._go(); }\\n  // run it to its next yield that has to wait (each one already over runs on at once)\\n  _go() {\\n    for (let n = 0; n < 1e4 && !this.done; n++) {\\n      let r; try { r = this._it.next(); } catch (e) {