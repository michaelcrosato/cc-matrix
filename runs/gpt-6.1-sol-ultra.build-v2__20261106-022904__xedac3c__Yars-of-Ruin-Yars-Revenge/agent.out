d: complete and official conformance\",\n    \"pass\": true,\n    \"detail\": \"[]\"\n\"\"\"Official AI Hub harness against the exact root HTML. Run with installed Playwright Python.\"\"\"\nimport json, pathlib, threading, http.server, functools, sys, time\nfrom playwright.sync_api import sync_playwright\nROOT=pathlib.Path(__file__).resolve().parents[2]\nDEV=pathlib.Path(__file__).resolve().parents[1]\nART=DEV/'tests/artifacts';ART.mkdir(parents=True,exist_ok=True)\nGAME='/'+DEV.name+'.html'\nclass Quiet(http.server.SimpleHTTPRequestHandler):\n def log_message(self,*args):pass\n\ndef run():\n results=[]\n def check(name,yes,detail=''):\n  results.append({'name':name,'pass':bool(yes),'detail':detail})\n handler=functools.partial(Quiet,directory=str(ROOT))\n server=http.server.ThreadingHTTPServer(('127.0.0.1',0),handler)\n threading.Thread(target=server.serve_forever,daemon=True).start()\n base=f'http://127.0.0.1:{server.server_port}'\n try:\n  with sync_playwright() as p:\n   browser=p.chromium.launch(headless=True,args=['--no-sandbox','--autoplay-policy=no-user-gesture-required'])\n   try:\n    for players,scenario in ([] if ('--manual-only' in sys.argv or '--campaign-only' in sys.argv) else [(1,'standard'),(2,'standard'),(2,'host-leave'),(2,'server')]):\n     context=browser.new_context(viewport={'width':1280,'height':860})\n     page=context.new_page();errors=[];warnings=[]\n     page.on('pageerror',lambda e:errors.append(str(e)))\n     page.on('console',lambda m:warnings.append(m.text) if m.text.startswith('[AIHub]') else None)\n     url=base+'/'+DEV.name+f'/vendor/hub/harness.html?game={GAME}&players={players}&latency=150&jitter=50&loss=5&auto=1&scenario={scenario}&play=5000'\n     page.goto(url)\n     try:page.wait_for_selector('body[data-complete=\"true\"]',timeout=90000)\n     except Exception as e:errors.append('Harness completion timeout: '+str(e))\n     report=page.evaluate('window.__hubCheck || null')\n     identity=[];worlds=[]\n     for f in page.frames[1:]:\n      try:\n       identity.append(f.title())\n       state=f.evaluate('({game:!!window.RuinApp,s:window.RuinApp?.game?.debug?.snapshot(),net:window.RuinApp?.online?.debug})')\n       worlds.append(state)\n      except Exception:pass\n     check(f'hub {players} {scenario}: complete and official conformance',report and report.get('pass'),json.dumps([c for c in (report or {}).get('checks',[]) if not c.get('pass')]))\n     check(f'hub {players} {scenario}: actual game identity',bool(identity) and all(x=='Yars of Ruin' for x in identity),str(identity))\n     check(f'hub {players} {scenario}: no page errors or client warnings',not errors and not warnings,str(errors+warnings))\n     check(f'hub {players} {scenario}: actual simulation advances',bool(worlds) and all(x.get('s',{}).get('tick',0)>0 for x in worlds),json.dumps(worlds)[:500])\n     if scenario=='server':\n      check('hub server: host has two player bodies only',any(w.get('net',{}).get('steps',0)>0 and len(w.get('s',{}).get('players',[]))==2 for w in worlds))\n     # No activity after hub end: exact tick and sends remain unchanged.\n     before=worlds\n     page.wait_for_timeout(350)\n     after=[]\n     for f in page.frames[1:]:\n      try:after.append(f.evaluate('({s:window.RuinApp?.game?.debug?.snapshot(),net:window.RuinApp?.online?.debug})'))\n      except Exception:pass\n     check(f'hub {players} {scenario}: no simulation or sends after end',len(before)==len(after) and all(b.get('s',{}).get('tick')==a.get('s',{}).get('tick') and b.get('net',{}).get('sent')==a.get('net',{}).get('sent') for b,a in zip(before,after)))\n     (ART/f'hub-{players}-{scenario}.json').write_text(json.dumps({'report':report,'errors':errors,'warnings':warnings,'worlds':worlds},indent=2))\n     context.close()\n    if '--official-only' not in sys.argv and '--campaign-only' not in sys.argv:\n     for scenario in ['nonhost-leave','visibility']:\n      context=browser.new_context(viewport={'width':1280,'height':860});page=context.new_page();errors=[]\n      page.on('pageerror',lambda e:errors.append(str(e)))\n      page.goto(base+'/'+DEV.name+f'/vendor/hub/harness.html?game={GAME}&players=2&latency=150&jitter=50&loss=5&limit=120')\n      page.wait_for_function(\"document.querySelectorAll('iframe').length===2\")\n      page.wait_for_function(\"[...document.querySelectorAll('iframe')].every(f=>f.contentWindow.RuinApp?.online)\")\n      page.locator('#release').click()\n      page.wait_for_function(\"[...document.querySelectorAll('iframe')].every(f=>f.contentWindow.AIHub.time()>=0)\")\n      page.wait_for_timeout(700)\n      frames=page.frames[1:];host=frames[0]\n      if scenario=='nonhost-leave':\n       old=host.evaluate('RuinApp.world.tick')\n       page.locator('#who').select_option('p1');page.locator('#remove').click()\n       page.wait_for_function(\"document.querySelector('iframe').contentWindow.RuinApp.world.players[1].departed===true\")\n# Progress\n\nSelected title: Yars of Ruin (cryptographic random choice from 50 riffs).\nDevelopment folder: Yars-of-Ruin-Yars-Revenge-gpt-6.1-sol-ultra-20261106-022904/\nFinal artifact: Yars-of-Ruin-Yars-Revenge-gpt-6.1-sol-ultra-20261106-022904.html\n\n## Active work\n- Reading complete plan, engine and hub contracts; importing pinned upstream.\n- Next: agree simulation schema, delegate presentation/audio/online; implement rules and tests.\n\n## Delivery requirements\nSingle root HTML; root exit-interview.json; all development assets inside named folder; npm test quiet suite; research and provenance.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat > Yars-of-Ruin-Yars-Revenge-gpt-6.1-sol-ultra-20261106-022904/tools/test.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport vm from 'node:vm';\nimport {fileURLToPath,pathToFileURL} from 'node:url';\nimport {spawnSync} from 'node:child_process';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..'),art=path.join(root,'tests/artifacts');\nconst group=process.argv.find(s=>s.startsWith('--group='))?.split('=')[1]||'all';\nlet passed=0,failed=0;const evidence=[];\nfunction check(name,ok,error=''){evidence.push({name,pass:\"'!!ok,...(!ok?{error}: {})});if(ok)passed++;else{failed++;console.error('\"'FAIL '+name+(error?'\\\\n'+error:''));}}\nfor(const mod of ['sim','online','presentation'])if(group==='all'||group===mod){try{const t=await import(pathToFileURL(path.join(root,'tests',mod+'.test.mjs')));const raw=await(t.default||t.runTests)();for(const r of Array.isArray(raw)?raw:raw.results)check(r.name,r.ok??r.pass,r.error||'');}catch(e){check(mod+' suite',false,e.stack);}}\nif(group==='all'||group==='artifact'){\n const html=fs.readFileSync(path.join(root,'..',path.basename(root)+'.html'),'utf8');\n const blocks=[...html.matchAll(/<script>([\\\\s\\\\S]*?)<\\\\/script>/gi)].map(m=>m[1]);\n check('artifact session client pristine and first after charset',blocks[0]?.trim()===fs.readFileSync(path.join(root,'vendor/hub/session.js'),'utf8').trim()&&/<meta charset=\\\"utf-8\\\">\\\\s*<script>/.test(html));\n check('artifact declares correct Hub seats and shared-world mode',html.includes('name=\\\"hub:session-players\\\" content=\\\"1-2\\\"')&&html.includes('name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\"'));\n check('artifact has no fetched development scripts or assets',\"'!/<script[''^>]+src=|<img[''^>]+src=|<link[''^>]+href=/i.test(html));\n for(let i=0;i<blocks.length;i++){try{new vm.Script(blocks[i],{filename:'\"'artifact-script-'+i});check('artifact script '+i+' parses completely',true);}catch(e){check('artifact script '+i+' parses completely',false,e.message);}}\n const reportFile=path.join(root,'..','exit-interview.json');\n try{const r=JSON.parse(fs.readFileSync(reportFile,'utf8'));const keys=['date','source','plan','genre','perspective','tech','artDirection','animation','audio','online','testing','research','environment','model','usage'];check('exit interview exact fields and answer counts',keys.every(k=>typeof r.sourceInformation[k]==='string'&&r.sourceInformation[k])&&r.testingFeedback.length===4&&r.engineFeedback.length===6&&r.promptFeedback.length===4&&r.sourceInformation.usage==='added on import'&&r.aiHub.name==='Yars of Ruin'&&r.aiHub.tags.length>=3&&r.aiHub.tags.length<=6);check('artifact embeds exact final interview',blocks.some(b=>b.includes('globalThis.RUIN_REPORT='+JSON.stringify(r))));}catch(e){check('exit interview parses',false,e.message);}\n}\nconst python='/home/micha/.local/share/pipx/venvs/playwright/bin/python';\nfor(const [name,file,args] of [['browser','browser.py',[]],['hub','hub-browser.py',['--campaign']]])if(group==='all'||group===name){\n const result=spawnSync(python,[path.join(root,'tests',file),...args],{cwd:root,encoding:'utf8',maxBuffer:8*1024*1024});\n const lines=(result.stdout||'').trim().split('\\\\n');let report;try{report=JSON.parse(lines.at(-1));}catch{}\n if(report&&Number.isInteger(report.passed)){passed+=report.passed;failed+=report.failed;const failures=lines.slice(0,-1).filter(l=>l.startsWith('FAIL '));for(const f of failures)console.error(f);if(result.stderr)console.error(result.stderr.trim());evidence.push({suite:name,...report});if(result.status&&\"'!report.failed)check(name+'\"' process exits cleanly',false,result.stderr||String(result.status));}\n else check(name+' browser suite completes',false,(result.stdout||'')+(result.stderr||'')+' exit '+result.status);\n}\nfs.mkdirSync(art,{recursive:true});fs.writeFileSync(path.join(art,'test-summary'+(group==='all'?'':'-'+group)+'.json'),JSON.stringify({group,passed,failed,results:evidence},null,2));\nconsole.log(\"'`${passed} passed, ${failed} failed`);process.exitCode=failed?1:0;\nEOF\ncat > PROGRESS.md <<'\"'EOF'\n# Progress — Yars of Ruin\n\n## Delivery\n- Title selected with a cryptographic RNG from 50 silent riffs: **Yars of Ruin**.\n- Dev folder: \"'`Yars-of-Ruin-Yars-Revenge-gpt-6.1-sol-ultra-20261106-022904/`.\n- Root artifact: `Yars-of-Ruin-Yars-Revenge-gpt-6.1-sol-ultra-20261106-022904.html` (self-contained, currently built).\n- Root `exit-interview.json` remains to write with verified final feedback.\n\n## Implemented\n- Pinned native my-3D2dge 0.89.1 at 8ecc2f62353761187bdfe226f327b7ea5d2eb691; pristine AI Hub client1.4.0 at35a1047f2067b2af3de3943f0fe452f39105d869.\n- Complete deterministic three-sector simulation: 1/2/3 strikes, individually destructible and moving shields, reflective cells, contact bites/charge, static damage matrix, physical remote cannon/self-danger, fortress Swirl, renewable final dock, lives/shared reserves, records/practice/Assist.\n- Articulated custom insects, dimensional fortress art, all native pixel primitives/animation/lights, procedural music/SFX/voices; offline audio proof finite/nonzero/clean ending.\n- Native engine Shell title/pause/settings/remapping, keyboard/mouse/gamepad/touch, local co-op, contextual lessons, attract pilot, live sliders, freeze/step, phase selector, seed tools and validated JSON shield editor.\n- AI Hub host-authoritative shared world, independent server simulation, quantized validated controls, cannon acknowledgements/retries, compact snapshots/keyframes, leave/end/time-up guards; outcome acknowledgement patch added after finding final snapshot could arrive after finish.\n- Build command and quiet single test runner written; docs/research and provenance complete.\n\n## Verification so far\n- Simulation35 checks passed, including ordinary-action full Normal campaigns over4seeds, simultaneous co-op, empty-shell final respawn/refill/victory, misses, wrap, reflection, authoring roundtrip actually played.\n- Presentation5 checks passed drawn-headless; online13 mock checks passed.\n- Initial official Hub scenarios1p/2p-loss/host-leave/server all passed. Agent online now running extended nonhost-leave/visibility + ordinary-action full online campaigns.\n- Standalone browser24passed/7failed: controls label assertion needs actual '\"'Stick dead zone'; attract semantic snapshot fields were shadowed by title's cosmetic world.attract; fixed source. Pad fixture following attract needs released input/real consume cooldown; fresh pad fixture verified actual Cross menu/campaign works. Re-run browser after next rebuild.\n- Fixed title/results clipping and delayed outcome overlays2.2seconds to expose collapse. Title visibility now passes.\n\n## Current next steps\n1. Wait online agent /root/online: running extended actual-browser scenarios. Keep artifact stable until they finish; root source has newer diagnostics/voice/menu-neutral fixes pending rebuild.\n2. Integrate safe local join command (simulation added; UI pause action still to add).\n3. Rebuild; re-run standalone browser, fix remaining input issues; extend tests for attract family cancellation, saved audio/settings, co-op and full UI completion.\n4. Write authoring/README, exact exit interview; build final artifact; run \"'`npm test` in dev folder (all suites including actual hub harness campaigns); inspect final play/ending screenshots; update evidence and progress.\n\n## Workspace boundaries\nOnly this work folder; no commits or changes to parent repositories. Browser count max2; online agent has one. Servers use loopback OS-selected ports, stopped by owned PID/thread. All generated files inside dev folder except requested root HTML, PROGRESS and exit interview. Root build-info.json should move inside dev folder before finish.\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
