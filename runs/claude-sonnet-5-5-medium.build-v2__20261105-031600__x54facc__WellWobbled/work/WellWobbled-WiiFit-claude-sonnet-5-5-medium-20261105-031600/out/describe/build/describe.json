    {
      "key": "armLower",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Elbow to wrist.",
      "default": 0.2875
    },
    {
      "key": "ankleHeight",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Sole to ankle joint (new: the old rig stood its foot point on the floor).",
      "default": 0.08
    },
    {
      "key": "footLength",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Heel to toe tip (new).",
      "default": 0.17
    },
    {
      "key": "handLength",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Wrist to fingertip (new).",
      "default": 0.15
    },
    {
      "key": "chestDepth",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Front to back through the chest, for the back socket (new).",
      "default": 0.2
    },
    {
      "key": "lean",
      "type": "number",
      "unit": "rad",
      "description": "Forward lean of the torso in the stance.",
      "default": 0
    },
    {
      "key": "hunch",
      "type": "number",
      "minimum": 0,
      "description": "How far the head and hands slump forward (share).",
      "default": 0
