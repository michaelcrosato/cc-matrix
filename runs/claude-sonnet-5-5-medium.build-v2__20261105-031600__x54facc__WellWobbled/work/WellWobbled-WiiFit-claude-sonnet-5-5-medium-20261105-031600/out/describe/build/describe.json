{
  "kind": "build",
  "description": "Body proportions for the humanoid skeleton, in metres before size (limbs, torso, head, stance, gait).",
  "fields": [
    {
      "key": "size",
      "type": "number",
      "minimum": 0.01,
      "description": "Scale applied to every length of the build.",
      "default": 1
    },
    {
      "key": "legUpper",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Hip joint to knee: the thigh.",
      "default": 0.375
    },
    {
      "key": "legLower",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Knee to sole: the shin plus the ankle height.",
      "default": 0.375
    },
    {
      "key": "hipHeight",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Pelvis height in the relaxed stance, at most legUpper + legLower (the old hipZ).",
      "default": 0.725
    },
    {
      "key": "hipHalf",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Pelvis centre to each hip joint, sideways.",
      "default": 0.11875
    },
    {
      "key": "footSpread",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Pelvis centre to each foot, sideways, in the stance.",
