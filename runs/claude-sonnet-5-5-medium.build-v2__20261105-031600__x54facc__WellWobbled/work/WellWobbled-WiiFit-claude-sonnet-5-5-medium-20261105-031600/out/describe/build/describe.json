    {
      "key": "neck",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Base of the neck to the base of the skull.",
      "default": 0.075
    },
    {
      "key": "headRadius",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "The head's radius; its centre is one radius above the base of the skull.",
      "default": 0.2125
    },
    {
      "key": "armUpper",
      "type": "number",
      "minimum": 0,
      "unit": "m",
      "description": "Shoulder to elbow.",
      "default": 0.2875
