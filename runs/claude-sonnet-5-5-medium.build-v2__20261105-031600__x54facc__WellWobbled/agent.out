on jump(a: string): void { if (a === 'board') return; app.fade(() => { ins.actions.run('game.leave'); if (a === 'group') ins.actions.run('game.round', { players: 1, cpu: true }); else ins.actions.run('game.start', { event: a }); app.setMap('actionMap:balance'); app.setCamera('cam3=stage,mat'); }); }\n  function close(): void { el?.remove(); el = null; }\n  return {\n    open(): void { el = document.createElement('div'); el.className = 'panel dev'; root.appendChild(el); render(); },\n    close, isOpen: () => !!el,\n    tick(state: Record<string, unknown>): void { if (overlay) overlay.textContent = JSON.stringify(state, null, 1); },\n  };\n}\nEOF\necho ok"}},"wire_ingest_context":{"toolu_01Bbj9veXrzi5JhLWfQqJFyV":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-031600__x54facc/work/WellWobbled-WiiFit-claude-sonnet-5-5-medium-20261105-031600"}}}
