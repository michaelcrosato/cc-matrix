ed: 5 }), player: false, yaw, ...look, components\")\nopen(p,'w').write(s)\np='labs/game/scenes/settings.ts'\ns=open(p).read()\ns=s.replace(\"  'game.auto':\",\"  'game.lite': { type: 'boolean', default: false, when: 'scene', description: 'Tests: a flat ground and a bare guest, no dressing or cast, for fast headless runs.' },\\n  'game.auto':\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/scenes/testkit.ts <<'EOF'\n/**\n * @file Test helpers for the sim: a lite island world (flat ground, bare guest), start an activity, play it with a bot\n * until the result, read components. Used by every activity test and the whole-game playthrough. Sim-side (no DOM).\n * @example\n * const r = await playActivity('morning', 'perfect', 1); r.score; // 0-1000\n */\nimport { createHeadless } from '../../../engine/index';\nimport './island';\n\ntype H = Awaited<ReturnType<typeof createHeadless>>;\nexport interface Played { score: number; rank: string; steps: number; done: boolean; h: H; events: Record<string, number> }\nexport const comp = <T = Record<string, unknown>>(h: H, name: string): T[] =>\n  (h.state(name).entities as unknown as Record<string, unknown>[]).map((e) => e[name] as T);\nexport async function lite(seed: number, settings: Record<string, unknown> = {}): Promise<H> {\n  return createHeadless({ scene: 'game:island', seed, settings: { 'game.lite': true, ...settings } });\n}\n/** Plays `id` with bot `kind` (or '' for no input at all) to its results; gives up after `max` steps. */\nexport async function playActivity(id: string, kind: string, seed: number, opts: { short?: boolean; max?: number; settings?: Record<string, unknown>; random?: boolean } = {}): Promise<Played> {\n  const h = await lite(seed, opts.settings);\n  const run = h.actions as unknown as { run(n: string, a?: object): void };\n  run.run('game.start', { event: id, short: !!opts.short });\n  if (kind) run.run('game.bot', { kind });\n  const max = opts.max ?? 60 * 200;\n  let steps = 0; let mode = 'event';\n  while (steps < max) {\n    h.step(30); steps += 30;\n    mode = comp<{ mode: string }>(h, 'flow')[0].mode;\n    if (mode !== 'event') break;\n  }\n  const f = comp<{ score: number; rank: string }>(h, 'flow')[0];\n  return { score: f.score, rank: f.rank, steps, done: mode !== 'event', h, events: {} };\n}\nEOF\nrm labs/game/scenes/probe.test.ts\ncat > labs/game/scenes/events/morning.test.ts <<'EOF'\n/** @file Morning Check: the four players meet the balance targets on 10 seeds; age bounds. */\nimport { describe, expect, it } from 'vitest';\nimport { playActivity } from '../testkit';\nimport { ageOf } from './morning';\n\ndescribe('morning check', () => {\n  it('age formula bounds', () => { expect(ageOf(1, 1.3)).toBe(18); expect(ageOf(0, 1.3)).toBe(82); expect(ageOf(0.5, 1.3)).toBeGreaterThan(18); });\n  it('bots', async () => {\n    const mean: Record<string, number> = {};\n    for (const kind of ['perfect', 'human', 'sloppy', 'idle']) {\n      let sum = 0;\n      for (let seed = 1; seed <= 3; seed++) { const r = await playActivity('morning', kind, seed); expect(r.done).toBe(true); sum += r.score; }\n      mean[kind] = sum / 3;\n    }\n    console.log('MORNING', JSON.stringify(mean));\n    expect(mean.perfect).toBeGreaterThanOrEqual(750);\n  }, 300000);\n});\nEOF\nnpx vitest run labs/game/scenes/events/morning.test.ts 2>&1 | grep -E \"MORNING|Error|FAIL|passed|expected\" | cut -c1-400","uuid":"4d62b4b3-9a6d-41e7-9fde-53388f2981d1","session_id":"e83c655a-6d0a-42b2-ac8e-79c6fd4e6b22"}
