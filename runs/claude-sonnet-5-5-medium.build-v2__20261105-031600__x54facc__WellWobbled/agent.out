ause' && e.input?.pressed('pause')) resume();\",\"    if (screens.current === 'pause' && consumeEdge('pause')) resume();\")\nsub(p,\"if (target) { hud!.prompt(hint('use', target.label, dev, set)); if (eng()?.input?.pressed('use')) target.run(); }\",\"if (target) { hud!.prompt(hint('use', target.label, dev, set)); if (consumeEdge('use')) target.run(); }\")\nsub(p,\"    const e = eng(); if (!e || !hud || !screens) return;\\n    const s = sim(f);\",\"    const e = eng(); if (!e || !hud || !screens) return;\\n    pollPads(); if ((screens.current || '') !== lastScr) { lastScr = screens.current || ''; markScreenChange(); }\\n    const s = sim(f);\")\nsub(p,\"  let page = 0; let aboutPage = 0;\",\"  let lastScr = ''; let page = 0; let aboutPage = 0;\")\np='labs/game/main.ts'\nsub(p,\"import { cleanSearch,\",\"import { installEdges } from './ui/edges';\\nimport { cleanSearch,\")\nsub(p,\"  const app = createApp(\",\"  installEdges();\\n  const app = createApp(\")\nEOF\ngrep -n \"hop\" labs/game/scenes/island.ts | head -3"}},"wire_ingest_context":{"toolu_01Ff6XJ1ZGR7KTpTrH2sumKy":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-031600__x54facc/work/WellWobbled-WiiFit-claude-sonnet-5-5-medium-20261105-031600"}}}
