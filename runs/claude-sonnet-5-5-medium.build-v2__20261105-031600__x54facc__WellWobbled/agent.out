p class=\"small\">Lean: stick, WASD or mouse · Feet: L2 R2, Q E · Breathe: both feet</p><p class=\"small\">${left === null ? 'Waiting…' : Math.ceil(left / 1000) + ' s'} · Enter or Cross: Ready · Triangle or T: More time</p>`;\n  };\n  card.onclick = () => h.answer('ready');\n  addEventListener('keydown', (e) => { if (started) return; if (e.key === 'Enter') h.answer('ready'); else if (e.key === 't' || e.key === 'T') h.answer('more'); });\n  h.on('card', (c: { left: number | null; ready: number[] }) => { left = c.left; readySet = c.ready; drawCard(); });\n  drawCard();\n  h.on('start', () => { started = true; h.progress({ score: 0, label: 'Breathing in' }); h.send({ t: 'g', e: 0, x: 0, y: 0, p: '', s: 0 }, { reliable: false }); });\n  h.on('message', (d: { t: string; e: number; x: number; y: number; s: number }, from: number) => { if (d?.t === 'g') mats[from] = { x: d.x, y: d.y, cls: d.e, score: d.s, alive: 1 }; });\n  h.on('leave', (l: { id: number }) => { if (mats[l.id]) mats[l.id].alive = 0; });\n  h.on('time-up', () => report());\n  h.on('end', () => { over = true; engine.stop?.(); });\n  let go = false;\n  function report(): void { if (resultSent) return; resultSent = true; h.result({ score: lastScore, stats: { 'Wobble Age': String(Math.round(18 + 64 * Math.pow(1 - lastScore / 3000, 1.3))), Classes: '3' }, awards: lastScore > 2000 ? [{ title: 'Unnervingly Still', detail: 'Least Wobbly' }] : [] }); }\n  let lastScore = 0;\n  return {\n    frame(f) {\n      if (over) return;\n      const flow = (f.world.query('flow')[0] as { flow: { mode: string } } | undefined)?.flow; const round = (f.world.query('round')[0] as { round: { on: number; cls: number; total: number[] } } | undefined)?.round;\n      const guest = (f.world.query('cast', 'wobble') as { cast: { who: string }; wobble: { x: number; y: number } }[]).find((e) => e.cast.who === 'guest');\n      if (started && !go && h.time() >= 0) { go = true; card.style.display = 'none'; ins.actions.run('round.go'); }\n      if (!go || !round || !guest) return;\n      lastScore = round.total[0]; const now = performance.now();\n      if (now - lastProg > 1000) { lastProg = now; h.progress({ score: lastScore, label: `Class ${Math.min(3, round.cls + 1)} · ${Math.round(lastScore)}`.slice(0, 24) }); }\n      if (now - lastSend >= 100) { lastSend = now; h.send({ t: 'g', e: round.cls, x: guest.wobble.x, y: guest.wobble.y, p: '', s: lastScore }, { reliable: false }); }\n      const flat: number[] = []; for (const [id, m] of Object.entries(mats)) { const slot = info.players.findIndex((p) => p.id === Number(id)); if (slot >= 0) flat.push(slot, m.x, m.y, m.cls, m.alive); }\n      engine.input?.virtual.axis('game:ghosts', flat as never);\n      if (flow?.mode === 'results' && !resultSent) report();\n    },\n  };\n  void colorOf;\n}\nEOF\ncat > labs/game/main.ts <<'EOF'\n/**\n * @file The page of Well Wobbled (labs/game/index.html): boots the engine on `game:island` (or `game:round` in an AI Hub\n * session), the retreat's look, the stage camera, the action maps and the app (screens, HUD, audio, attract, dev mode).\n * No WebGPU: a plain, friendly page. Touch-only devices get \"Controller or keyboard required\" and a Settings button;\n * attract still runs behind it. Pointer-locked mouse movement and the garden's pointer are sent as custom intents.\n * Page-side: imports only engine/index.ts and the game's own files.\n * @example\n * // open labs/game/index.html (npm run dev) or the built single file\n */\n/// <reference types=\"vite/client\" />\nimport { createEngine, type EngineFrame } from '../../engine';\nimport './art/materials';\nimport './art/looks';\nimport './art/bodies';\nimport './cameras/stage';\nimport './ui/maps';\nimport './ui/theme.css';\nimport './scenes/island';\nimport { createApp } from './ui/app';\nimport { createDev } from './ui/dev';\nimport { SCREENS } from './ui/screens';\nimport { cleanSearch, connectHub, inSession, wireSession } from './hub/session';\n\ndeclare global { interface Window { __game?: Record<string, unknown> } }\nconst search = cleanSearch(new URLSearchParams(location.search));\nif (!search.has('post.look')) search.set('post.look', 'look:retreat');\nconst touchOnly = matchMedia('(hover: none) and (pointer: coarse)').matches;\nlet engine: Awaited<ReturnType<typeof createEngine>> | null = null;\nlet follow: [number, number, number] | undefined;\nconst root = document.createElement('div'); root.id = 'ww'; document.body.appendChild(root);\n\nasync function main(): Promise<void> {\n  if (!('gpu' in navigator)) { root.style.pointerEvents = 'auto'; root.innerHTML = SCREENS.nowebgpu; const m = document.getElementById('msg'); if (m) m.hidden = true; return; }\n  const msg = document.getElementById('msg'); if (msg) msg.textContent = 'Calibrating…';\n  const hub = await connectHub(); const session = !!hub || inSession();\n  if (hub) { search.set('scene', 'game:round'); search.set('seed', String(hub.seed)); }\n  const watchdog = hub ? setTimeout(() => window.AIHub?.ready(), 14000) : 0;\n  const app = createApp({ engine: () => engine, session, touchOnly });\n  let ses: ReturnType<typeof wireSession> | null = null; let dev: ReturnType<typeof createDev> | null = null;\n  let mdx = 0, mdy = 0, ptr: [number, number] = [0, 0]; let seenKey = false;\n  addEventListener('mousemove', (e) => { if (document.pointerLockElement) { mdx += e.movementX; mdy += e.movementY; } ptr = [(e.clientX / innerWidth - 0.5) * 2, (e.clientY / innerHeight - 0.5) * 2]; app.anyInput(); });\n  for (const t of ['keydown', 'pointerdown', 'wheel']) addEventListener(t, () => { if (t === 'keydown') seenKey = true; app.anyInput(); }, { capture: true });\n  let padSig = '';\n  engine = await createEngine({\n    canvas: document.querySelector<HTMLCanvasElement>('#view')!, scenes: ['game:island', 'game:round'], search: `?${search}`, store: app.store,\n    modal: () => app.modal() as boolean,\n    cameraInput: () => ({ follow }),\n    onFrame: (f: EngineFrame) => {\n      const g = (f.world.query('cast', 'actor') as unknown as { cast: { who: string }; actor: { x: number; y: number; z: number } }[]).find((e) => e.cast.who === 'guest');\n      const scr = app.screenName; follow = g && (scr === 'play' || scr === 'attract' || scr === 'pause') ? [g.actor.x, g.actor.y, g.actor.z] : [0, 6, 0];\n      // a pad press or stick move counts as input (leaves attract, restarts the idle timer)\n      const pads = navigator.getGamepads?.() ?? []; let sig = '';\n      for (const p of pads) if (p) sig += p.buttons.map((b) => (b.pressed ? 1 : 0)).join('') + p.axes.map((a) => (Math.abs(a) > 0.4 ? 1 : 0)).join('');\n      if (sig !== padSig) { if (sig.includes('1')) app.anyInput(); padSig = sig; }\n      const ins = engine?.inspector; const sens = app.settings.mouse * (app.settings.invertLook ? -1 : 1);\n      engine?.input?.virtual.axis('game:mouse', [mdx * sens, mdy * sens] as never); mdx = mdy = 0;\n      engine?.input?.virtual.axis('game:pointer', (app.screenName === 'play' && ins ? ptr : [0, 0]) as never);\n      app.frame(f); ses?.frame(f as never); void dev;\n      window.__game = { screen: app.screenName, attract: app.attract, device: app.lastDevice, glyphs: app.settings.glyphs, music: app.audio?.volume('music'), effects: app.audio?.volume('effects'), day: app.save.day, session, seenKey };\n    },\n  });\n  if (hub) { clearTimeout(watchdog); window.AIHub?.ready(); }\n  if (msg) msg.hidden = true;\n  if (!engine.ready) { if (hub) window.AIHub?.fail('WebGPU required'); return; }\n  app.mount(root, engine);\n  if (hub) { ses = wireSession(engine, hub, root); engine.input?.use('actionMap:balance'); }\n  else { dev = createDev(root, app, engine); app.setOpenDev(() => { dev?.open(); }); }\n}\ndeclare global { interface Window { AIHub?: { ready(): void; fail(m: string): void } } }\nvoid main();\nEOF\npython3 - <<'EOF'\nimport re\np='labs/game/index.html'\ns=open(p).read()\ns=s.replace('<link rel=\"stylesheet\" href=\"../../engine/ui/touch.css\" />\\n','')\ns=s.replace('<title>The starter game: my-3dge</title>','<title>Well Wobbled</title>')\ns=re.sub(r'<!--.*?-->\\s*','',s,flags=re.S)\ns=s.replace('background: #15171c;','background: #F7FAFC;').replace('color: #c9ccd4;','color: #3A4A55;').replace('<div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading…</div>','<div id=\"msg\" role=\"status\" aria-live=\"polite\">Calibrating…</div>')\nopen(p,'w').write(s)\nEOF\ngit rm -q --cached labs/game/bot.ts 2>/dev/null; rm -f labs/game/bot.ts labs/game/best.ts labs/game/best.test.ts labs/game/scenes/play.ts labs/game/scenes/play.test.ts labs/game/cast/player.ts labs/game/replays/bot.replay.json; ls labs/game labs/game/replays; npm run typecheck 2>&1 | grep -E \"labs/game\" | cut -c1-260 | head -40","uuid":"fb579555-f5b8-46eb-abc4-8389596ccaf9","session_id":"e83c655a-6d0a-42b2-ac8e-79c6fd4e6b22"}
