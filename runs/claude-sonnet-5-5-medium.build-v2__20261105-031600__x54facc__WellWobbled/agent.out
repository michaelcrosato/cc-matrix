../../../engine';\",\"import type { Engine } from '../../../engine';\\nimport { insOf } from '../ui/ins';\")\nsub('labs/game/ui/app.ts',\"const act = (name: string, args?: object) => eng()?.inspector?.actions.run(name, args);\",\"const act = (name: string, args?: object) => { const e = eng(); if (e) insOf(e).actions.run(name, args); };\")\nsub('labs/game/ui/app.ts',\"import { lineOf } from './speech';\",\"import { lineOf } from './speech';\\nimport { insOf } from './ins';\")\nsub('labs/game/ui/app.ts',\"function setCamera(code: string): void { try { eng()?.inspector?.camera.set(code, { blend: true } as never); } catch { /* cameras are presentation */ } }\",\"function setCamera(code: string): void { try { const e = eng(); if (e) insOf(e).camera.set(code, { blend: true }); } catch { /* cameras are presentation */ } }\")\nsub('labs/game/ui/app.ts',\"hudFor(s.run.id, s.run, w, 3)\",\"hudFor(s.run!.id, s.run as never, w, 3)\")\nsub('labs/game/ui/screens.ts',\"  constructor(private root: HTMLElement, private input: Input, private ctx: ScreenCtx) {}\",\"  private root: HTMLElement;\\n  private input: Input;\\n  private ctx: ScreenCtx;\\n  constructor(root: HTMLElement, input: Input, ctx: ScreenCtx) { this.root = root; this.input = input; this.ctx = ctx; }\")\nEOF\nsed -i \"s/eng()?.inspector?.pause()/(eng() \\&\\& insOf(eng()!).pause())/; s/eng()?.inspector?.resume()/(eng() \\&\\& insOf(eng()!).resume())/; s/eng()?.inspector?.set('game.assist', settings.steady ? 1 : 0)/(eng() \\&\\& insOf(eng()!).set('game.assist', settings.steady ? 1 : 0))/\" labs/game/ui/app.ts\nsed -i \"s/e?.inspector?.set('game.auto', true); e?.inspector?.set('game.noTopple', true);/if (e) { insOf(e).set('game.auto', true); insOf(e).set('game.noTopple', true); }/; s/e?.inspector?.set('game.auto', false); e?.inspector?.set('game.noTopple', false);/if (e) { insOf(e).set('game.auto', false); insOf(e).set('game.noTopple', false); }/\" labs/game/ui/app.ts\nnpm run typecheck 2>&1 | grep -E \"labs/game\" | cu