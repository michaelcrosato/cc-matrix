ay from `a` to `b` (see the file comment).\n196:- `Camera` (interface from [`engine/gfx/cameras/pose.ts`](../engine/gfx/cameras/pose.ts)): A camera: its state, stepped once per rendered frame, and its pose.\n197:- `CAMERA_SETTINGS` (const from [`engine/gfx/cameras/rig.ts`](../engine/gfx/cameras/rig.ts)): The view settings the rig reads, declared on the shared registry.","is_error":false}]},"parent_tool_use_id":null,"session_id":"e83c655a-6d0a-42b2-ac8e-79c6fd4e6b22","uuid":"1ad16079-596e-40a2-b111-4acc59b25287","timestamp":"2026-11-05T11:26:37.233Z","tool_use_result":{"stdout":"labs/box/sounds/page.ts:124:/** Makes the box's sound: `audio` to play into (a page's `createAudio()` by default), published unless `publish` is false. */\nlabs/box/sounds/page.ts:126:  const audio = options.audio ?? createAudio();\n121-  /** Stops listening and closes the context it made. */\n122-  close(): Promise<void>;\n123-}\n124-\n125-/** Makes a page's sound (see the file comment). */\n126:export function createAudio(options: AudioOptions = {}): Audio {\n127-  const registry = options.registry ?? sharedRegistry;\n128-  const out = options.log ?? sharedLog;\n129-  sfxKind(registry);\n130-  songKind(registry);\n131-  /** `id` once it names a song or an effect; else throws `CORE_NO_ENTRY` naming the closest effects. */\n132-  const checkSound = (id: string) => (registry.has('song', id) ? id : getSfx(id, registry).id);\n133-  const footsteps = options.footsteps ?? {};\n134-  const pool = createVoicePool<RuntimeSound>(options.limits);\n135-  const buffers = new Map<string, AudioBuffer>();\n136-  const turns = new Map<string, number>();\n137-  const bindings = new Map<string, string>();\n138-  const volumes = { ...BUS_VOLUMES };\n67:export interface AudioOptions {\n68-  /** The context to play into (an `OfflineAudioContext` in a test); one is made on the first gesture by default. */\n69-  context?: BaseAudioContext;\n70-  /** Where gestures arrive (`window`). */\n71-  window?: GestureTarget;