'effects', 'voices', 'glyphs', 'mouse', 'rumble', 'steady', 'cpu', 'reduced', 'invert', 'fullscreen'].indexOf(id) % 6);\n  }\n  // ---- per frame ------------------------------------------------------------------------------------------------\n  function sim(frame: EngineFrame): { flow: Rec; guest: Rec | null; run: Rec | null; seat: Rec | null } {\n    const w = frame.world;\n    const flow = (w.query('flow')[0] as Rec | undefined)?.flow ?? {};\n    const g = (w.query('cast', 'wobble', 'act', 'seat') as Rec[]).find((e) => e.cast.who === 'guest') ?? null;\n    return { flow, guest: g, run: g?.act ?? null, seat: g?.seat ?? null };\n  }\n  function events(frame: EngineFrame, s: ReturnType<typeof sim>): void {\n    if (frame.world !== world) { world = frame.world; lastSeq = 0; }\n    for (const r of frame.world.events.trace() as { seq: number; type: string; payload: Rec }[]) {\n      if (r.seq <= lastSeq) continue; lastSeq = r.seq; const p = r.payload ?? {};\n      if (attract && r.type === 'result') continue;\n      switch (r.type) {\n        case 'say': if (!attract || r.payload.who === 'tare') speak(p.who, p.id); break;\n        case 'result': onResult(p as never); break;\n        case 'topple': sfx('creak', 0.7); if (settings.rumble) rumble(0.5); break;\n        case 'splash': sfx(p.big ? 'splashHuge' : 'splashSmall'); break;\n        case 'moved': sfx('ooh', 0.4); hud?.toast('You moved.', 1.6); break;\n        case 'lure': hud?.lure(lineText(p.line)); if (p.kind === 'gull') sfx('gull'); if (p.kind === 'frog') sfx('ribbit'); break;\n        case 'lureEnd': hud?.lure(''); break;\n        case 'beat': sfx(p.grade === 'perfect' ? 'perfect' : 'clap'); if (settings.rumble) rumble(0.2); break;\n        case 'miss': sfx('miss', 0.5); break; case 'rep': sfx('clack'); break; case 'gate': sfx('tick'); break; case 'sink': sfx('sink'); break;\n        case 'lineStep': sfx('rope', 0.5); break; case 'gull': sfx('gull'); break; case 'gustWarn': sfx('whoosh', 0.5); break;\n        case 'storm': sfx('thunder'); sfx('horn', 0.6); break; case 'lurch': sfx('groan'); break; case 'delivered': sfx('ooh'); break; case 'calm': sfx('breathOut'); break;\n        case 'hoopCaught': sfx('whoosh'); break; case 'cards': sfx('ooh'); break; case 'classDone': sfx('stamp'); break;\n        case 'roundDone': { current = 'group'; const t = p.total as number[]; open(SCREENS.results(ctx, 'Group Class', t[0] >= Math.max(...t.slice(0, 4)) ? 'Least Wobbly' : 'Composed', Math.round(t[0]), 3, said++)); break; }\n        default: break;\n      }\n    }\n    void s;\n  }\n  function rumble(strength: number): void {\n    try { const pads = navigator.getGamepads?.() ?? []; for (const p of pads) (p as any)?.vibrationActuator?.playEffect?.('dual-rumble', { duration: 120, strongMagnitude: strength, weakMagnitude: strength }); } catch { /* optional */ } // eslint-disable-line\n  }\n  function frame(f: EngineFrame): void {\n    const e = eng(); if (!e || !hud || !screens) return;\n    const s = sim(f); const dt = f.dt; events(f, s);\n    stageFx.t += dt; lastDevice = device();\n    if (screens.current) screens.update(dt);\n    hud.update(dt);\n    const mode = s.flow.mode ?? 'roam';\n    if (deps.session) { /* the hub scene drives its own card */ }\n    // pause and shortcuts\n    if (!screens.current && !attract && scr === 'play') {\n      if (e.input?.pressed('pause')) openPause();\n      else if (mode === 'roam' && e.input?.pressed('plan')) openProgramme();\n    }\n    if (screens.current === 'pause' && e.input?.pressed('pause')) resume();\n    // HUD\n    const inEvent = mode === 'event' && s.run?.id;\n    if (inEvent && s.guest) {\n      const w = s.guest.wobble; const ex = hudFor(s.run.id, s.run, w, 3);\n      hud.disc({ x: w.x, y: w.y, calm: w.calm, lungs: w.lungs, guide: w.guide, fl: s.seat?.fl ?? 0, fr: s.seat?.fr ?? 0, breath: ex.breath, ring: ex.ring, target: ex.target, guideDot: ex.guideDot, show: ex.disc && !attract });\n      hud.strip(ex.left, ex.right);\n    } else { hud.disc({ x: 0, y: 0, calm: 0, lungs: 0, guide: 0, fl: 0, fr: 0, breath: false, show: false }); hud.strip('', ''); }\n    if (mode !== lastFlowMode) { lastFlowMode = mode; if (mode === 'roam') hud.clear(); }\n    // island prompts\n    if (mode === 'roam' && s.guest && !screens.current && !attract) island(f, s);\n    else if (!inEvent) hud.prompt('');\n    // attract\n    if (!deps.touchOnly || true) idleTick(dt);\n    // tilt: the camera banks\n    const isl = (f.world.query('island')[0] as Rec | undefined)?.island; stageFx.roll = isl ? Math.atan2(isl.tiltX * 0.12, 1) : 0;\n    try { audio?.update(f.camera as never, f.queries ?? undefined); } catch { /* audio is optional */ }\n    ambience(mode, isl?.storm ?? 0);\n  }\n  let amb: { sea?: any; wind?: any; rain?: any } = {}; // eslint-disable-line\n  function ambience(mode: string, storm: number): void {\n    if (!audio || audio.state === 'blocked' as never) return;\n    try {\n      if (!amb.sea) { amb.sea = audio.play('sfx:retreat.seaLoop', { loop: true, vol: 0.5 * settings.effects }); amb.wind = audio.play('sfx:retreat.windLoop', { loop: true, vol: 0.2 * settings.effects }); amb.rain = audio.play('sfx:retreat.rainLoop', { loop: true, vol: 0 }); }\n      amb.rain?.volume(storm * 0.6 * settings.effects); amb.wind?.volume((0.2 + storm * 0.6) * settings.effects);\n    } catch { /* optional */ } void mode;\n  }\n  function island(f: EngineFrame, s: ReturnType<typeof sim>): void {\n    const a = s.guest!.actor; const near = (x: number, z: number, r: number) => Math.hypot(a.x - x, a.z - z) < r;\n    for (const p of f.world.query('pebble') as Rec[]) if (!p.pebble.found && near(p.pebble.x, p.pebble.z, 1.4)) { save.finds.push(p.pebble.no); save.pebbles += 1; persist(); act('game.found', { no: p.pebble.no }); act('game.cairn', { count: save.pebbles, age: save.ages[save.ages.length - 1] ?? 18 }); sfx('clack'); speak('tare', 'tare.pebble'); }\n    let target: { label: string; run: () => void } | null = null; const dev = device(); const set = glyphs();\n    const people: [string, string][] = [['plumb', 'Plumb'], ['tare', 'Tare'], ['gerald', 'Gerald'], ['bex', 'Bex'], ['nan', 'Nan']];\n    for (const c of f.world.query('cast', 'actor') as Rec[]) { const who = c.cast.who; const hit = people.find((p) => p[0] === who); if (hit && near(c.actor.x, c.actor.z, 3.2)) target = { label: `Talk to ${hit[1]}`, run: () => speak(who, `${who}.talk.${1 + (said++ % 4)}`) }; }\n    for (const [id, st] of Object.entries(STATIONS)) {\n      if (near(st.at[0], st.at[1], 5) && id !== 'pier' && id !== 'stone' && id !== 'east') {\n        const list = Object.entries(ACTIVITY_INFO).filter(([k, v]) => v.where === id && !(k === 'tilt') && (freePlay || save.day >= 1) && (k !== 'tilt'));\n        const fit = list.find(([k]) => DAYS[Math.min(save.day, 5) - 1].acts.includes(k) && !save.done.includes(`${save.day}:${k}`)) ?? list[0];\n        if (fit) target = { label: `Play ${fit[1].title}`, run: () => startActivity(fit[0]) };\n      }\n    }\n    if (near(STATIONS.plaza.at[0] + 9, STATIONS.plaza.at[1] - 4, 4)) target = { label: 'Noticeboard', run: openBoard };\n    if (near(STATIONS.huts.at[0], STATIONS.huts.at[1], 6)) target = { label: dayDone() ? 'Sleep' : 'Your hut', run: () => (dayDone() ? (evening(), void 0) : hud?.toast('The day is not done yet. Open the Programme.', 3)) };\n    if (save.day === 5 && dayDone() === false && near(STATIONS.stone.at[0], STATIONS.stone.at[1], 3)) target = null;\n    if (target) { hud!.prompt(hint('use', target.label, dev, set)); if (eng()?.input?.pressed('use')) target.run(); } else hud!.prompt(hint('programme', 'Programme', dev, set));\n    for (const p of f.world.query('plaque') as Rec[]) if (near(p.plaque.x, p.plaque.z, 2.2) && pebbleMsg !== p.plaque.no + 1 && !save.finds.includes(100 + p.plaque.no)) { pebbleMsg = p.plaque.no + 1; save.finds.push(100 + p.plaque.no); persist(); speak('tare', `plaque.${p.plaque.no % 12}`); }\n  }\n  function idleTick(dt: number): void {\n    const front = !!screens?.current && scr !== 'play' && scr !== 'pause' && !attract && !paused;\n    if (attract) return; idle = front ? idle + dt : 0;\n    if (idle > IDLE_S) startAttract();\n  }\n  let bannerEl: HTMLElement | null = null;\n  function startAttract(): void {\n    attract = true; scr = 'attract'; screens?.close(); const e = eng(); e?.inspector?.set('game.auto', true); e?.inspector?.set('game.noTopple', true);\n    act('game.begin', { day: 5, finds: [], pebbles: 0 }); setMap('actionMap:balance'); hud!.clear();\n    bannerEl = document.createElement('div'); bannerEl.className = 'banner'; bannerEl.dataset.attract = '1';\n    bannerEl.innerHTML = `<div class=\"panel\" style=\"display:inline-block\"><h2>Well Wobbled · DEMO</h2><div>${hint('any', 'Press any button', device(), glyphs())}</div></div>`; root?.appendChild(bannerEl);\n  }\n  function stopAttract(): void {\n    if (!attract) return; attract = false; idle = 0; bannerEl?.remove(); bannerEl = null; const e = eng();\n    e?.inspector?.set('game.auto', false); e?.inspector?.set('game.noTopple', false); act('game.leave'); act('game.begin', { day: save.day, finds: save.finds, pebbles: save.pebbles, age: save.ages[save.ages.length - 1] ?? 18 });\n    act('game.go', { station: 'pier' }); setMap('actionMap:menu'); titleScreen();\n  }\n  function anyInput(): void { idle = 0; if (attract) stopAttract(); }\n  return {\n    store, ctx, frame, anyInput, speak, sfx, setCamera, setMap, fade,\n    get save() { return save; }, get settings() { return settings; }, get audio() { return audio; }, get attract() { return attract; }, get lastDevice() { return lastDevice; },\n    get modal() { return () => !!screens?.current || paused; }, get screenName() { return scr; },\n    mount(rootEl: HTMLElement, engine: Engine): void {\n      root = rootEl; hud = createHud(rootEl); screens = new Screens(rootEl, engine.input!, ctx);\n      fadeEl = document.createElement('div'); fadeEl.className = 'fade'; rootEl.appendChild(fadeEl);\n  