layers) { e.cast.seatNo = gi; e.cast.bot = CPU[gi - 1].bot; e.cast.mat = [...matOf(gi)]; placeCast(w, who, matOf(gi)[0], matOf(gi)[2], 0); }\n  }\n  startActivity(w, classId(w), true);\n}\n/** Called each step by the runner when every seat has finished a class: adds up, deals the next or ends. */\nexport function advanceRound(w: W): void {\n  const r = roundOf(w); const flow = w.query('flow')[0].flow; if (!r || !r.on) return;\n  const seats = seatedOf(w).filter((e) => e.cast.seatNo >= 0).sort((a, b) => a.cast.seatNo - b.cast.seatNo);\n  const total = [...r.total]; for (const e of seats) total[e.cast.seatNo] += e.act.score; r.total = total;\n  w.emit('classDone', { cls: r.cls, total });\n  if (r.cls < 2) { r.cls += 1; startActivity(w, classId(w), true); }\n  else { r.on = 0; flow.mode = 'results'; flow.ender = ''; flow.score = Math.round(total[0] / 3); w.emit('roundDone', { total }); for (const e of seats) e.cast.seatNo = -1; }\n}\nexport const roundOn = (w: W): boolean => !!roundOf(w)?.on;\nvoid groundAt;\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/runner.ts'\ns=open(p).read()\ns=s.replace(\"import { placeGuest } from '../cast';\",\"import { placeGuest } from '../cast';\\nimport { advanceRound, roundOn } from '../round';\")\ns=s.replace(\"      if (c.lead) {\\n        const r = rankOf(run.score);\",\"      if (c.lead && !roundOn(w)) {\\n        const r = rankOf(run.score);\")\ns=s.replace(\"  // a class with no guest run (a hub Round) ends when every seat is done\\n  if (flow.mode === 'event' && seatedOf(w).every((e) => !e.act.id || e.act.done === 2)) flow.mode = 'results';\",\"  // a class ends when every seat is done: a round deals the next, a hub round with no guest run ends\\n  if (flow.mode === 'event' && seatedOf(w).every((e) => !e.act.id || e.act.done === 2)) { if (roundOn(w)) advanceRound(w); else flow.mode = 'results'; }\")\nopen(p,'w').write(s)\np='labs/game/scenes/cast.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  for (const c of CAST_TABLE) spawnPer