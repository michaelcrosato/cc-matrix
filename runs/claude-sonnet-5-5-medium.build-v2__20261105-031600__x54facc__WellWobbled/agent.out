120, 0, -120], seed: 7, height: 0.6, scale: 30, ridges: 0.1, octaves: 3,\n  hills: [\n    { at: [0, 0], radius: 118, height: 12 },\n    { at: [0, 0], radius: 30, height: 3 },\n    { at: [-70, -12], radius: 12, height: -4 },\n    { at: [0, -105], radius: 14, height: -3 },\n  ],\n  flats: [flat(STATIONS.plaza, 10), flat(STATIONS.pavilion, 10), flat(STATIONS.annex, 11), flat(STATIONS.terrace, 7), flat(STATIONS.cliff, 8), flat(STATIONS.huts, 8), flat(STATIONS.east, 8), flat(STATIONS.stone, 5), flat(STATIONS.lighthouse, 5), flat(STATIONS.hoop, 7), flat(STATIONS.lagoon, 7), flat(STATIONS.pier, 6)],\n  high: 6, materials: ['material:rsandTerrain', 'material:rsandTerrain', 'material:rlawnTerrain'], surface: 'sand',\n} as never);\n/** Ground height at (x, z), or the sea level where nothing stands. */\nexport function groundAt(x: number, z: number): number {\n  return terrainHeight(getTerrain('terrain:fulcrum'), x, z) ?? SEA_Y;\n}\nEOF\ncat > labs/game/scenes/data/world.test.ts <<'EOF'\n/** @file Prints the terrain's heights at the stations, and checks that the stations are above the sea. */\nimport { expect, it } from 'vitest';\nimport { groundAt, STATIONS } from './world';\nit('stations stand on dry ground', () => {\n  const out: string[] = [];\n  for (const [id, s] of Object.entries(STATIONS)) out.push(`${id}:${groundAt(s.at[0], s.at[1]).toFixed(1)}`);\n  console.log('H', out.join(' '), 'r90', groundAt(90, 0).toFixed(1), 'r70', groundAt(0, 70).toFixed(1), 'r105', groundAt(0, 105).toFixed(1));\n  for (const id of ['plaza', 'pavilion', 'annex', 'terrace', 'huts', 'stone'] as const) expect(groundAt(STATIONS[id].at[0], STATIONS[id].at[1])).toBeGreaterThan(3);\n});\nEOF\nnpx vitest run labs/game/scenes/data/world.test.ts 2>&1 | grep -E \"^H|Error|fail|✓|expected\" | head","timeout":120000}},"wire_ingest_context":{"toolu_01E7k3rAAvY4euaniAdXiNQh":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-031600__x54facc/work/WellWobbled-WiiFit-claude-sonn