2], 1, 0);\n      void id; w.spawn({ ghost: { x: m[0], y: m[1], z: m[2], slot: i, alive: 0 } });\n    }\n    w.systems.add('game.wobble', (ww) => stepSeatsOf(ww as never), { phase: 'ai' });\n    w.systems.add('game.activity', (ww) => activitySystem(ww as never), { phase: 'rules' });\n    w.systems.add('game.ghosts', (ww, it: Intents) => ghosts(ww as never, it), { phase: 'anim' });\n    void groundAt; void paramsOf;\n  },\n  step(w, it) { readSeatFrom(w as never, it); botStep(w as never); },\n  actions: {\n    'round.go': (w) => startRound(w, 1, false),\n    'game.bot': (w, args) => { w.query('flow')[0].flow.bot = String((args as { kind?: string }).kind ?? ''); },\n  },\n});\n/** Poses the ghost actors from the page's messages. */\nfunction ghosts(w: Parameters<typeof setPose>[0], it: Intents): void {\n  const raw = (it as unknown as Record<string, unknown>)['game:ghosts']; const a = Array.isArray(raw) ? (raw as number[]) : [];\n  const by = new Map<number, number[]>(); for (let i = 0; i + 4 < a.length; i += 5) by.set(a[i], a.slice(i, i + 5));\n  for (const e of w.query('cast')) {\n    const m = /^ghost(\\d)$/.exec(e.cast.who); if (!m) continue; const slot = Number(m[1]); const g = by.get(slot);\n    if (g) setPose(w, e.id, '', 0, g[1], g[2]);\n  }\n}\nexport default roundScene;\nEOF\npython3 - <<'EOF'\n# split seat IO out of island.ts into seatio.ts so both scenes share it\np='labs/game/scenes/island.ts'\ns=open(p).read()\na=s.index(\"const val = \")\nb=s.index(\"/** The pilot: the only writer\")\nchunk=s[a:b]\ns=s[:a]+s[b:]\nopen(p,'w').write(s)\nseat='''/**\n * @file Seat input shared by the island and the hub round: the model parameters from the settings, the guest's seat from the\n * step's intents (lean, feet, gentle, act, mouse delta, garden pointer) and the Wobble Model stepping for every seat. Sim-side.\n * @example\n * paramsOf(w).gain; // 14\n */\nimport type { Intents } from '../../../engine/sim-api';\nimport type { W } from './events/types';\nimport { gu