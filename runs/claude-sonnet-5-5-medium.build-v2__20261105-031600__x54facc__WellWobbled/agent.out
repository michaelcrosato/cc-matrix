{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013QPpGiu78gbyfFDnu3hSeX","type":"tool_result","content":"engine/sim/props.ts:152:export function spawnProp<C extends object, E extends EventMap>(\n130-\n131-/** The system `props.readback`: every prop with a body takes its body's pose, in id order. */\n132-function readProps(w: World): void {\n133-  const physics = physicsOf(w);\n134-  for (const { sceneProp } of w.query('sceneProp') as unknown as ScenePropComponents[]) {\n135-    if (sceneProp.body < 0) continue;\n136-    const { position: p, rotation: r } = physics.readBody(sceneProp.body);\n137-    [sceneProp.x, sceneProp.y, sceneProp.z] = [p.x, p.y, p.z];\n138-    sceneProp.q = [r.x, r.y, r.z, r.w];\n139-  }\n140-}\n141-\n142-/**\n143- * Stands a prop in the scene, `spawnProp(w, { prop: 'prop:<id>', at: [x, y, z], yaw })`: its base at `at` (m), turned\n144- * `yaw` about +Y (rad). It makes the prop's body (when it has one; the scene needs `physics: true` then) and an entity\n145- * with the component `sceneProp`, and returns the entity's id. A missing prop id warns and stands a crate (`getProp`).\n146- *\n147- * @example\n148- * // in a scene's setup, with physics: true and its level's bodies added (addLevelBodies(physicsOf(w), level)):\n149- * // const id = spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: Math.PI / 2 }); // on the floor at x 2, z 3\n150- * // labs/box/scenes/hall-props.ts places the hall's props this way, from levelProps and its own spots.\n151- */\n152:export function spawnProp<C extends object, E extends EventMap>(\n153-  world: World<C, E>,\n154-  placement: PropPlacement,\n155-  options: SpawnPropOptions = {},\n156-): number {\n157-  const w = world as unknown as World;\n158-  const entry = getProp(placement.prop);\n159-  const prop = entry.id;\n160-  const spec = propBody({ ...placement, prop }, undefined, options.as);\n161-  const { position, rotation } = spec ?? propPose({ ...placement, prop });\n162-  const body = spec ? physicsOf(w).addBody(spec) : -1;\n163-  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\n164-  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });","is_error":false}]},"parent_tool_use_id":null,"session_id":"e83c655a-6d0a-42b2-ac8e-79c6fd4e6b22","uuid":"a0d0ef02-45c5-4250-b343-011d0a0cdaa3","timestamp":"2026-11-05T10:21:01.938Z","tool_use_result":{"stdout":"engine/sim/props.ts:152:export function spawnProp<C extends object, E extends EventMap>(\n130-\n131-/** The system `props.readback`: every prop with a body takes its body's pose, in id order. */\n132-function readProps(w: World): void {\n133-  const physics = physicsOf(w);\n134-  for (const { sceneProp } of w.query('sceneProp') as unknown as ScenePropComponents[]) {\n135-    if (sceneProp.body < 0) continue;\n136-    const { position: p, rotation: r } = physics.readBody(sceneProp.body);\n137-    [sceneProp.x, sceneProp.y, sceneProp.z] = [p.x, p.y, p.z];\n138-    sceneProp.q = [r.x, r.y, r.z, r.w];\n139-  }\n140-}\n141-\n142-/**\n143- * Stands a prop in the scene, `spawnProp(w, { prop: 'prop:<id>', at: [x, y, z], yaw })`: its base at `at` (m), turned\n144- * `yaw` about +Y (rad). It makes the prop's body (when it has one; the scene needs `physics: true` then) and an entity\n145- * with the component `sceneProp`, and returns the entity's id. A missing prop id warns and stands a crate (`getProp`).\n146- *\n147- * @example\n148- * // in a scene's setup, with physics: true and its level's bodies added (addLevelBodies(physicsOf(w), level)):\n149- * // const id = spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: Math.PI / 2 }); // on the floor at x 2, z 3\n150- * // labs/box/scenes/hall-props.ts places the hall's props this way, from levelProps and its own spots.\n151- */\n152:export function spawnProp<C extends object, E extends EventMap>(\n153-  world: World<C, E>,\n154-  placement: PropPlacement,\n155-  options: SpawnPropOptions = {},\n156-): number {\n157-  const w = world as unknown as World;\n158-  const entry = getProp(placement.prop);\n159-  const prop = entry.id;\n160-  const spec = propBody({ ...placement, prop }, undefined, options.as);\n161-  const { position, rotation } = spec ?? propPose({ ...placement, prop });\n162-  const body = spec ? physicsOf(w).addBody(spec) : -1;\n163-  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\n164-  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013QPpGiu78gbyfFDnu3hSeX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
