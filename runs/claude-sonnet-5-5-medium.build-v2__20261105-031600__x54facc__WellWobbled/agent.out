{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjhZ1XoHWWkW2EHupkLL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SuPWsoKLwtDYznZhvvrwir","name":"Bash","input":{"command":"cat > labs/game/ui/app.ts <<'EOF'\n/**\n * @file The page's game: the flow around the sim. It owns the save and settings, the screens (title, programme, noticeboard,\n * results, evening, pause, settings, About), what the guest can use on the island, the cameras and input maps for each\n * activity, the fades, attract mode and the touch-only rule. The sim does the rules; this sends menu picks as scene\n * actions and reads components and events back. Page-side.\n * @example\n * const app = createApp(deps); app.frame(frameFromEngine);\n */\nimport type { Engine, EngineFrame } from '../../../engine';\nimport { createAudio, type Audio } from '../../../engine';\nimport { ACTIVITY_INFO, DAYS } from '../scenes/data/days';\nimport { STATIONS, groundAt } from '../scenes/data/world';\nimport { ageOf } from '../scenes/events/morning';\nimport { PEBBLE_SITES } from '../scenes/dress';\nimport { say as babble } from '../audio/voice';\nimport '../audio/sound';\nimport { createHud } from './hud';\nimport { hudFor } from './hudfor';\nimport { hint, type Device, type GlyphSet } from './glyphs';\nimport { LINES, lineText } from './lines';\nimport { Screens, SCREENS, type ScreenCtx } from './screens';\nimport { loadSave, loadSettings, writeSave, writeSettings, makeStore } from './store';\nimport { stageFx } from '../cameras/stage';\nimport { lineOf } from './speech';\n\nexport interface Deps { engine: () => Engine | null; session: boolean; touchOnly: boolean }\ntype Rec = Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any\nconst IDLE_S = 10;\nconst CAMERA_OF: Record<string, string> = { morning: 'front', ring: 'mat', pond: 'portrait', poseA: 'mat', poseB: 'mat', poseC: 'mat', poseH: 'mat', reps: 'side', step: 'behind', line: 'line', paddle: 'wide', garden: 'topdown', cliff: 'dive', hoop: 'front', jog: 'wide', tilt: 'tilt' };\n\nexport function createApp(deps: Deps) {\n  const store = makeStore(new URLSearchParams(location.search).has('sandbox') ? 'sandbox' : 'play');\n  let save = loadSave(store); let settings = loadSettings(store);\n  let audio: Audio | null = null; let hud: ReturnType<typeof createHud> | null = null; let screens: Screens | null = null; let root: HTMLElement | null = null;\n  let scr = 'boot'; let world: object | null = null; let lastSeq = 0; let idle = 0; let attract = false; let fadeEl: HTMLElement | null = null;\n  let page = 0; let aboutPage = 0; let current = ''; let lastFlowMode = ''; let said = 0; let pebbleMsg = 0; let freePlay = false; let paused = false; let lastDevice: Device = 'keyboard';\n  const eng = () => deps.engine();\n  const act = (name: string, args?: object) => eng()?.inspector?.actions.run(name, args);\n  const device = (): Device => { const d = eng()?.input?.lastDevice as string | undefined; return d === 'gamepad' ? 'pad' : d === 'mouse' ? 'mouse' : 'keyboard'; };\n  const glyphs = (): GlyphSet => settings.glyphs;\n  const sfx = (id: string, vol = 0.8) => { try { audio?.play(`sfx:retreat.${id}`, { vol: vol * settings.effects } as never); } catch { /* sound is a bonus */ } };\n  const ctx: ScreenCtx = { settings: () => settings, device, set: glyphs, pick: (s, id) => pick(s, id), cancel: (s) => cancel(s) };\n  const persist = () => { writeSave(store, save); writeSettings(store, settings); };\n  const applyAudio = () => { if (!audio) return; audio.volume('music', settings.music); audio.volume('effects', settings.effects); audio.volume('ui', settings.voices); };\n  function setCamera(code: string): void { try { eng()?.inspector?.camera.set(code, { blend: true } as never); } catch { /* cameras are presentation */ } }\n  function fade(then: () => void): void { if (!fadeEl) return then(); fadeEl.classList.add('on'); setTimeout(() => { then(); setTimeout(() => fadeEl?.classList.remove('on'), 60); }, 380); }\n  function speak(who: string, id: string, vars: Record<string, string | number> = {}): void {\n    const text = lineText(id, vars, said++); const sec = babble(audio, who === 'guest' ? 'tare' : who, text, settings.voices); hud?.say(who === 'tare' ? 'Tare' : who[0].toUpperCase() + who.slice(1), text, sec);\n  }\n  const open = (spec: ReturnType<(typeof SCREENS)[keyof typeof SCREENS] & ((...a: any[]) => any)>) => { screens?.open(spec as never); scr = (spec as { id: string }).id; };\n  const closeScreen = () => { screens?.close(); scr = attract ? 'attract' : 'play'; };\n\n  // ---- the flow -------------------------------------------------------------------------------------------------\n  function titleScreen(): void { setCamera('cam3=stage,title'); open(SCREENS.title(ctx, save.started, save.day > 1 || save.finished)); }\n  function begin(free = false): void {\n    freePlay = free; closeScreen(); fade(() => {\n      act('game.begin', { day: free ? 6 : save.day, finds: save.finds, pebbles: save.pebbles, age: save.ages[save.ages.length - 1] ?? 18 });\n      toIsland(!save.started); save.started = true; persist();\n    });\n  }\n  function toIsland(intro: boolean): void {\n    current = ''; act('game.leave'); const st = save.started ? STATIONS.plaza : STATIONS.pier;\n    act('game.go', { station: save.started ? 'plaza' : 'pier' }); void st; setMap('actionMap:roam'); setCamera('cam3=chase'); scr = 'play';\n    if (intro) { speak('tare', 'tare.intro.1'); setTimeout(() => speak('tare', 'tare.intro.2'), 5500); setTimeout(() => speak('tare', 'tare.intro.3'), 11500); }\n    else if (save.day > 1 || save.done.length) speak('tare', 'tare.back');\n  }\n  function setMap(id: string): void { try { eng()?.input?.use(id); } catch { /* maps exist */ } }\n  function startActivity(id: string, round = false): void {\n    if (id === 'board') return openBoard();\n    closeScreen(); fade(() => {\n      current = id === 'group' ? 'group' : id;\n      if (id === 'group') { act('game.round', { players: 1, cpu: settings.cpu }); setMap('actionMap:balance'); setCamera('cam3=stage,mat'); }\n      else { act('game.start', { event: id, short: round }); setMap(id === 'garden' ? 'actionMap:garden' : 'actionMap:balance'); setCamera(id === 'garden' ? 'cam=topdown' : `cam3=stage,${CAMERA_OF[id] ?? 'mat'}`); }\n      stageFx.t = 0; scr = 'play';\n    });\n  }\n  function goStation(where: string, id: string): void { closeScreen(); fade(() => { act('game.leave'); act('game.go', { station: where }); setMap('actionMap:roam'); setCamera('cam3=chase'); scr = 'play'; setTimeout(() => startActivity(id), 350); }); }\n  function openProgramme(): void {\n    const day = DAYS[Math.min(save.day, 5) - 1]; const rows = day.acts.map((a) => ({ label: `${save.done.includes(`${save.day}:${a}`) ? '✓ ' : ''}${a === 'board' ? 'Find the Noticeboard' : ACTIVITY_INFO[a].title}`, id: a }));\n    rows.push({ label: 'Close', id: 'close' }); open(SCREENS.programme(ctx, day.n, day.title, rows.slice(0, 6), 'Pick one. \"Go\" takes you there.'));\n  }\n  function openBoard(): void {\n    const all = Object.keys(ACTIVITY_INFO).filter((a) => a !== 'tilt' || save.day >= 5); const pages = Math.ceil(all.length / 5);\n    page = ((page % pages) + pages) % pages; const slice = all.slice(page * 5, page * 5 + 5);\n    const rows = slice.map((a) => ({ label: `${ACTIVITY_INFO[a].title}${save.bests[a] ? ` · best ${save.bests[a]}` : ''}`, id: a, disabled: save.day < 2 && !save.done.some((d) => d.endsWith(a)) && a !== 'morning' && a !== 'poseA' && a !== 'pond' }));\n    rows.push({ label: 'Close', id: 'close', disabled: false }); open(SCREENS.board(ctx, page, pages, rows, 'Every activity you have met, to play again.'));\n  }\n  function onResult(r: { id: string; score: number; rank: string; pebbles: number }): void {\n    const key = `${save.day}:${r.id}`; if (!save.done.includes(key)) save.done.push(key);\n    save.pebbles += r.pebbles; save.bests[r.id] = Math.max(save.bests[r.id] ?? 0, r.score);\n    if (r.id === 'morning') { const age = ageOf(r.score / 1000, 1.3); save.ages.push(age); save.checkDay = save.day; const prev = save.ages[save.ages.length - 2];\n      speak('tare', prev === undefined ? 'tare.age.first' : age < prev ? 'tare.age.better' : age > prev ? 'tare.age.worse' : 'tare.age.same', { age, prev: prev ?? 0, diff: Math.abs(age - (prev ?? age)) }); }\n    persist(); act('game.cairn', { count: save.pebbles, age: save.ages[save.ages.length - 1] ?? 18 }); sfx('stamp');\n    open(SCREENS.results(ctx, ACTIVITY_INFO[r.id]?.title ?? r.id, r.rank, r.score, r.pebbles, said++));\n  }\n  function evening(): void {\n    const rem = lineText('evening.' + (1 + ((save.day - 1) % 5)), {}, 0); open(SCREENS.evening(ctx, save.day, save.ages, rem));\n  }\n  function sleep(): void {\n    fade(() => {\n      closeScreen(); const last = save.day >= 5;\n      if (last) { save.day = 6; save.finished = true; persist(); act('game.day', { day: 6 }); credits(); return; }\n      save.day += 1; persist(); act('game.day', { day: save.day }); act('game.leave'); act('game.go', { station: 'plaza' }); setMap('actionMap:roam'); setCamera('cam3=chase'); scr = 'play';\n      if (save.day === 4) setTimeout(() => speak('tare', 'tare.rock'), 4000); else speak('tare', 'tare.keep');\n    });\n  }\n  function credits(): void { setCamera('cam3=stage,title'); open(SCREENS.credits(ctx)); }\n  const dayDone = () => DAYS[Math.min(save.day, 5) - 1].acts.filter((a) => a !== 'board').every((a) => save.done.includes(`${save.day}:${a}`));\n\n  function pick(s: string, id: string): void {\n    sfx('tick');\n    if (s === 'title') { if (id === 'begin') begin(false); else if (id === 'free') begin(true); else if (id === 'group') { closeScreen(); fade(() => { act('game.begin', { day: save.day, finds: save.finds, pebbles: save.pebbles }); startActivity('group'); }); } else if (id === 'settings') openSettings('title'); else if (id === 'about') openAbout('title'); }\n    else if (s === 'programme') { if (id === 'close') closeScreen(); else if (id === 'board') openBoard(); else goStation(ACTIVITY_INFO[id].where, id); }\n    else if (s === 'board') { if (id === 'close') closeScreen(); else goStation(ACTIVITY_INFO[id].where, id); }\n    else if (s === 'results') { if (id === 'again') startActivity(current); else { closeScreen(); fade(() => { act('game.leave'); if (current === 'tilt') { save.ages = save.ages; speak('tare', 'tare.tilt.dawn'); credits(); return; } act('game.go', { station: 'plaza' }); setMap('actionMap:roam'); setCamera('cam3=chase'); scr = 'play'; if (dayDone()) hud?.toast('The day is done. Go to your hut to sleep, or open the Programme.', 5); }); } }\n    else if (s === 'evening') sleep();\n    else if (s === 'credits') { closeScreen(); fade(() => { save.finished = true; persist(); toIsland(false); speak('tare', 'tare.free'); }); }\n    else if (s === 'pause') pausePick(id);\n    else if (s === 'more') { if (id === 'controls') openControls(); else if (id === 'dev') openDev(); else if (id === 'about') openAbout('more'); else openPause(); }\n    else if (s === 'settings') settingsPick(id);\n    else if (s.startsWith('sub-')) subPick(s, id);\n    else if (s === 'about') { if (id === 'next') { aboutPage++; open(SCREENS.about(ctx, aboutPage)); } else back(); }\n    else if (s === 'controls') back(); else if (s === 'confirm') { if (id === 'yes') { store.clear(); save = loadSave(store); settings = loadSettings(store); persist(); applyAudio(); } openSettings(origin); }\n    else if (s === 'touch') openSettings('title');\n  }\n  let origin = 'title';\n  function back(): void { if (origin === 'title') titleScreen(); else if (origin === 'more') openMore(); else openPause(); }\n  function cancel(s: string): void {\n    if (s === 'title' || s === 'evening' || s === 'credits' || s === 'results') return;\n    if (s === 'programme' || s === 'board') closeScreen(); else if (s === 'pause') resume(); else if (s === 'more') openPause(); else if (s === 'settings' || s === 'about' || s === 'controls' || s.startsWith('sub-')) { if (s.startsWith('sub-')) openSettings(origin); else back(); } else if (s === 'confirm') openSettings(origin);\n  }\n  function openPause(): void { paused = true; eng()?.inspector?.pause(); open(SCREENS.pause(ctx, current !== '' && current !== 'group' || current === 'group', deps.session)); }\n  function openMore(): void { open(SCREENS.more(ctx, !deps.session)); }\n  function resume(): void { paused = false; closeScreen(); eng()?.inspector?.resume(); }\n  function pausePick(id: string): void {\n    if (id === 'resume') resume();\n    else if (id === 'restart') { resume(); startActivity(current); }\n    else if (id === 'island') { resume(); closeScreen(); fade(() => { act('game.leave'); act('game.go', { station: 'plaza' }); setMap('actionMap:roam'); setCamera('cam3=chase'); current = ''; scr = 'play'; }); }\n    else if (id === 'settings') openSettings('pause'); else if (id === 'more') openMore(); else if (id === 'icons') { settings.glyphs = settings.glyphs === 'ps' ? 'xbox' : 'ps'; persist(); hud?.toast(`Button icons: ${settings.glyphs === 'ps' ? 'PlayStation' : 'Xbox'}`); }\n    else if (id === 'quit') { resume(); fade(() => { act('game.leave'); current = ''; titleScreen(); }); }\n  }\n  function openSettings(from: string): void { origin = from; open(SCREENS.settings(ctx, settings)); }\n  function openAbout(from: string): void { origin = from; aboutPage = 0; open(SCREENS.about(ctx, 0)); }\n  function openControls(): void { origin = 'more'; open(SCREENS.controls(ctx, [{ label: 'Back', id: 'back' }])); }\n  let openDev = () => hud?.toast('Dev Mode is not loaded');\n  const pct = (v: number) => `${Math.round(v * 100)}%`;\n  function settingsPick(id: string): void {\n    if (id === 'back') return back();\n    if (id === 'erase') return open(SCREENS.confirm(ctx, 'Erase Save', 'Everything you have done on the island will be forgotten. The island will not mind.', 'Erase'));\n    const rows = id === 'sound' ? [{ label: `Music ${pct(settings.music)}`, id: 'music' }, { label: `Effects ${pct(settings.effects)}`, id: 'effects' }, { label: `Voices ${pct(settings.voices)}`, id: 'voices' }, { label: 'Back', id: 'back' }]\n      : id === 'play' ? [{ label: `Button icons: ${settings.glyphs === 'ps' ? 'PlayStation' : 'Xbox'}`, id: 'glyphs' }, { label: `Mouse sensitivity ${settings.mouse.toFixed(1)}`, id: 'mouse' }, { label: `Rumble: ${settings.rumble ? 'on' : 'off'}`, id: 'rumble' }, { label: `Steadier Hands: ${settings.steady ? 'on' : 'off'}`, id: 'steady' }, { label: `CPU guests: ${settings.cpu ? 'on' : 'off'}`, id: 'cpu' }, { label: 'Back', id: 'back' }]\n      : [{ label: `Reduced Motion: ${settings.reduced ? 'on' : 'off'}`, id: 'reduced' }, { label: `Invert look: ${settings.invertLook ? 'on' : 'off'}`, id: 'invert' }, { label: 'Fullscreen', id: 'fullscreen' }, { label: 'Back', id: 'back' }];\n    open(SCREENS.group(ctx, id === 'sound' ? 'Sound' : id === 'play' ? 'Play' : 'Display', rows));\n  }\n  function subPick(s: string, id: string): void {\n    const step = (v: number) => (v >= 0.99 ? 0 : Math.round((v + 0.1) * 100) / 100);\n    if (id === 'back') return openSettings(origin);\n    if (id === 'music') settings.music = step(settings.music); else if (id === 'effects') settings.effects = step(settings.effects); else if (id === 'voices') settings.voices = step(settings.voices);\n    else if (id === 'glyphs') settings.glyphs = settings.glyphs === 'ps' ? 'xbox' : 'ps'; else if (id === 'mouse') settings.mouse = settings.mouse >= 3 ? 0.5 : settings.mouse + 0.5;\n    else if (id === 'rumble') settings.rumble = !settings.rumble; else if (id === 'steady') settings.steady = !settings.steady; else if (id === 'cpu') settings.cpu = !settings.cpu;\n    else if (id === 'reduced') settings.reduced = !settings.reduced; else if (id === 'invert') settings.invertLook = !settings.invertLook;\n    else if (id === 'fullscreen') { void document.documentElement.requestFullscreen?.().catch(() => undefined); }\n    persist(); applyAudio(); stageFx.reduced = settings.reduced; eng()?.inspector?.set('game.assist', settings.steady ? 1 : 0);\n    settingsPick(s === 'sub-Sound' ? 'sound' : s === 'sub-Play' ? 'play' : 'display'); screens?.select(['music', 'effects', 'voices', 'glyphs', 'mouse', 'rumble', 'steady', 'cpu', 'reduced', 'invert', 'fullscreen'].indexOf(id) % 6);\n  }\n  // ---- per frame ------------------------------------------------------------------------------------------------\n  function sim(frame: EngineFrame): { flow: Rec; guest: Rec | null; run: Rec | null; seat: Rec | null } {\n    const w = frame.world;\n    const flow = (w.query('flow')[0] as Rec | undefined)?.flow ?? {};\n    const g = (w.query('cast', 'wobble', 'act', 'seat') as Rec[]).find((e) => e.cast.who === 'guest') ?? null;\n    return { flow, guest: g, run: g?.act ?? null, seat: g?.seat ?? null };\n  }\n  function events(frame: EngineFrame, s: ReturnType<typeof sim>): void {\n    if (frame.world !== world) { world = frame.world; lastSeq = 0; }\n    for (const r of frame.world.events.trace() as { seq: number; type: string; payload: Rec }[]) {\n      if (r.seq <= lastSeq) continue; lastSeq = r.seq; const p = r.payload ?? {};\n      if (attract && r.type === 'result') continue;\n      switch (r.type) {\n        case 'say': if (!attract || r.payload.who === 'tare') speak(p.who, p.id); break;\n        case 'result': onResult(p as never); break;\n        case 'topple': sfx('creak', 0.7); if (settings.rumble) rumble(0.5); break;\n        case 'splash': sfx(p.big ? 'splashHuge' : 'splashSmall'); break;\n        case 'moved': sfx('ooh', 0.4); hud?.toast('You moved.', 1.6); break;\n        case 'lure': hud?.lure(lineText(p.line)); if (p.kind === 'gull') sfx('gull'); if (p.kind === 'frog') sfx('ribbit'); break;\n        case 'lureEnd': hud?.lure(''); break;\n        case 'beat': sfx(p.grade === 'perfect' ? 'perfect' : 'clap'); if (settings.rumble) rumble(0.2); break;\n        case 'miss': sfx('miss', 0.5); break; case 'rep': sfx('clack'); break; case 'gate': sfx('tick'); break; case 'sink': sfx('sink'); break;\n        case 'lineStep': sfx('rope', 0.5); break; case 'gull': sfx('gull'); break; case 'gustWarn': sfx('whoosh', 0.5); break;\n        case 'storm': sfx('thunder'); sfx('horn', 0.6); break; case 'lurch': sfx('groan'); break; case 'delivered': sfx('ooh'); break; case 'calm': sfx('breathOut'); break;\n        case 'hoopCaught': sfx('whoosh'); break; case 'cards': sfx('ooh'); break; case 'classDone': sfx('stamp'); break;\n        case 'roundDone': { current = 'group'; const t = p.total as number[]; open(SCREENS.results(ctx, 'Group Class', t[0] >= Math.max(...t.slice(0, 4)) ? 'Least Wobbly' : 'Composed', Math.round(t[0]), 3, said++)); break; }\n        default: break;\n      }\n    }\n    void s;\n  }\n  function rumble(strength: number): void {\n    try { const pads = navigator.getGamepads?.() ?? []; for (const p of pads) (p as any)?.vibrationActuator?.playEffect?.('dual-rumble', { duration: 120, strongMagnitude: strength, weakMagnitude: strength }); } catch { /* optional */ } // eslint-disable-line\n  }\n  function frame(f: EngineFrame): void {\n    const e = eng(); if (!e || !hud || !screens) return;\n    const s = sim(f); const dt = f.dt; events(f, s);\n    stageFx.t += dt; lastDevice = device();\n    if (screens.current) screens.update(dt);\n    hud.update(dt);\n    const mode = s.flow.mode ?? 'roam';\n    if (deps.session) { /* the hub scene drives its own card */ }\n    // pause and shortcuts\n    if (!screens.current && !attract && scr === 'play') {\n      if (e.input?.pressed('pause')) openPause();\n      else if (mode === 'roam' && e.input?.pressed('plan')) openProgramme();\n    }\n    if (screens.current === 'pause' && e.input?.pressed('pause')) resume();\n    // HUD\n    const inEvent = mode === 'event' && s.run?.id;\n    if (inEvent && s.guest) {\n      const w = s.guest.wobble; const ex = hudFor(s.run.id, s.run, w, 3);\n      hud.disc({ x: w.x, y: w.y, calm: w.calm, lungs: w.lungs, guide: w.guide, fl: s.seat?.fl ?? 0, fr: s.seat?.fr ?? 0, breath: ex.breath, ring: ex.ring, target: ex.target, guideDot: ex.guideDot, show: ex.disc && !attract });\n      hud.strip(ex.left, ex.right);\n    } else { hud.disc({ x: 0, y: 0, calm: 0, lungs: 0, guide: 0, fl: 0, fr: 0, breath: false, show: false }); hud.strip('', ''); }\n    if (mode !== lastFlowMode) { lastFlowMode = mode; if (mode === 'roam') hud.clear(); }\n    // island prompts\n    if (mode === 'roam' && s.guest && !screens.current && !attract) island(f, s);\n    else if (!inEvent) hud.prompt('');\n    // attract\n    if (!deps.touchOnly || true) idleTick(dt);\n    // tilt: the camera banks\n    const isl = (f.world.query('island')[0] as Rec | undefined)?.island; stageFx.roll = isl ? Math.atan2(isl.tiltX * 0.12, 1) : 0;\n    try { audio?.update(f.camera as never, f.queries ?? undefined); } catch { /* audio is optional */ }\n    ambience(mode, isl?.storm ?? 0);\n  }\n  let amb: { sea?: any; wind?: any; rain?: any } = {}; // eslint-disable-line\n  function ambience(mode: string, storm: number): void {\n    if (!audio || audio.state === 'blocked' as never) return;\n    try {\n      if (!amb.sea) { amb.sea = audio.play('sfx:retreat.seaLoop', { loop: true, vol: 0.5 * settings.effects }); amb.wind = audio.play('sfx:retreat.windLoop', { loop: true, vol: 0.2 * settings.effects }); amb.rain = audio.play('sfx:retreat.rainLoop', { loop: true, vol: 0 }); }\n      amb.rain?.volume(storm * 0.6 * settings.effects); amb.wind?.volume((0.2 + storm * 0.6) * settings.effects);\n    } catch { /* optional */ } void mode;\n  }\n  function island(f: EngineFrame, s: ReturnType<typeof sim>): void {\n    const a = s.guest!.actor; const near = (x: number, z: number, r: number) => Math.hypot(a.x - x, a.z - z) < r;\n    for (const p of f.world.query('pebble') as Rec[]) if (!p.pebble.found && near(p.pebble.x, p.pebble.z, 1.4)) { save.finds.push(p.pebble.no); save.pebbles += 1; persist(); act('game.found', { no: p.pebble.no }); act('game.cairn', { count: save.pebbles, age: save.ages[save.ages.length - 1] ?? 18 }); sfx('clack'); speak('tare', 'tare.pebble'); }\n    let target: { label: string; run: () => void } | null = null; const dev = device(); const set = glyphs();\n    const people: [string, string][] = [['plumb', 'Plumb'], ['tare', 'Tare'], ['gerald', 'Gerald'], ['bex', 'Bex'], ['nan', 'Nan']];\n    for (const c of f.world.query('cast', 'actor') as Rec[]) { const who = c.cast.who; const hit = people.find((p) => p[0] === who); if (hit && near(c.actor.x, c.actor.z, 3.2)) target = { label: `Talk to ${hit[1]}`, run: () => speak(who, `${who}.talk.${1 + (said++ % 4)}`) }; }\n    for (const [id, st] of Object.entries(STATIONS)) {\n      if (near(st.at[0], st.at[1], 5) && id !== 'pier' && id !== 'stone' && id !== 'east') {\n        const list = Object.entries(ACTIVITY_INFO).filter(([k, v]) => v.where === id && !(k === 'tilt') && (freePlay || save.day >= 1) && (k !== 'tilt'));\n        const fit = list.find(([k]) => DAYS[Math.min(save.day, 5) - 1].acts.includes(k) && !save.done.includes(`${save.day}:${k}`)) ?? list[0];\n        if (fit) target = { label: `Play ${fit[1].title}`, run: () => startActivity(fit[0]) };\n      }\n    }\n    if (near(STATIONS.plaza.at[0] + 9, STATIONS.plaza.at[1] - 4, 4)) target = { label: 'Noticeboard', run: openBoard };\n    if (near(STATIONS.huts.at[0], STATIONS.huts.at[1], 6)) target = { label: dayDone() ? 'Sleep' : 'Your hut', run: () => (dayDone() ? (evening(), void 0) : hud?.toast('The day is not done yet. Open the Programme.', 3)) };\n    if (save.day === 5 && dayDone() === false && near(STATIONS.stone.at[0], STATIONS.stone.at[1], 3)) target = null;\n    if (target) { hud!.prompt(hint('use', target.label, dev, set)); if (eng()?.input?.pressed('use')) target.run(); } else hud!.prompt(hint('programme', 'Programme', dev, set));\n    for (const p of f.world.query('plaque') as Rec[]) if (near(p.plaque.x, p.plaque.z, 2.2) && pebbleMsg !== p.plaque.no + 1 && !save.finds.includes(100 + p.plaque.no)) { pebbleMsg = p.plaque.no + 1; save.finds.push(100 + p.plaque.no); persist(); speak('tare', `plaque.${p.plaque.no % 12}`); }\n  }\n  function idleTick(dt: number): void {\n    const front = !!screens?.current && scr !== 'play' && scr !== 'pause' && !attract && !paused;\n    if (attract) return; idle = front ? idle + dt : 0;\n    if (idle > IDLE_S) startAttract();\n  }\n  let bannerEl: HTMLElement | null = null;\n  function startAttract(): void {\n    attract = true; scr = 'attract'; screens?.close(); const e = eng(); e?.inspector?.set('game.auto', true); e?.inspector?.set('game.noTopple', true);\n    act('game.begin', { day: 5, finds: [], pebbles: 0 }); setMap('actionMap:balance'); hud!.clear();\n    bannerEl = document.createElement('div'); bannerEl.className = 'banner'; bannerEl.dataset.attract = '1';\n    bannerEl.innerHTML = `<div class=\"panel\" style=\"display:inline-block\"><h2>Well Wobbled · DEMO</h2><div>${hint('any', 'Press any button', device(), glyphs())}</div></div>`; root?.appendChild(bannerEl);\n  }\n  function stopAttract(): void {\n    if (!attract) return; attract = false; idle = 0; bannerEl?.remove(); bannerEl = null; const e = eng();\n    e?.inspector?.set('game.auto', false); e?.inspector?.set('game.noTopple', false); act('game.leave'); act('game.begin', { day: save.day, finds: save.finds, pebbles: save.pebbles, age: save.ages[save.ages.length - 1] ?? 18 });\n    act('game.go', { station: 'pier' }); setMap('actionMap:menu'); titleScreen();\n  }\n  function anyInput(): void { idle = 0; if (attract) stopAttract(); }\n  return {\n    store, ctx, frame, anyInput, speak, sfx, setCamera, setMap, fade,\n    get save() { return save; }, get settings() { return settings; }, get audio() { return audio; }, get attract() { return attract; }, get lastDevice() { return lastDevice; },\n    get modal() { return () => !!screens?.current || paused; }, get screenName() { return scr; },\n    mount(rootEl: HTMLElement, engine: Engine): void {\n      root = rootEl; hud = createHud(rootEl); screens = new Screens(rootEl, engine.input!, ctx);\n      fadeEl = document.createElement('div'); fadeEl.className = 'fade'; rootEl.appendChild(fadeEl);\n      audio = createAudio(); audio.volume('music', settings.music); applyAudio(); stageFx.reduced = settings.reduced;\n      try { audio.music('song:retreat.lobby'); } catch { /* optional */ }\n      setMap('actionMap:menu'); if (deps.touchOnly) { open(SCREENS.touch()); scr = 'touch'; } else titleScreen();\n    },\n    setOpenDev(fn: () => void) { openDev = fn; }, openPause, titleScreen, resume, hud: () => hud, lineOf, LINES, groundAt, PEBBLE_SITES,\n  };\n}\nexport type App = ReturnType<typeof createApp>;\nEOF\ncat > labs/game/ui/speech.ts <<'EOF'\n/**\n * @file Small helper: which speaker says a line id (used by the page when the sim names only an id).\n * @example\n * lineOf('plumb.rest'); // 'plumb'\n */\nexport const lineOf = (id: string): string => id.split('.')[0];\nEOF\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2148,"cache_read_input_tokens":407377,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2148},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e83c655a-6d0a-42b2-ac8e-79c6fd4e6b22","uuid":"d963fcf6-9370-4297-aba1-a9020e82a08a","timestamp":"2026-11-05T11:27:46.293Z","request_id":"req_011CgjhZ1ESM1To6XZ4QmN3j","wire_tool_inputs":{"toolu_01SuPWsoKLwtDYznZhvvrwir":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-031600__x54facc/work/WellWobbled-WiiFit-claude-sonnet-5-5-medium-20261105-031600 && cat > labs/game/ui/app.ts <<'EOF'\n/**\n * @file The page's game: the flow around the sim. It owns the save and settings, the screens (title, programme, noticeboard,\n * results, evening, pause, settings, About), what the guest can use on the island, the cameras and input maps for each\n * activity, the fades, attract mode and the touch-only rule. The sim does the rules; this sends menu picks as scene\n * actions and reads components and events back. Page-side.\n * @example\n * const app = createApp(deps); app.frame(frameFromEngine);\n */\nimport type { Engine, EngineFrame } from '../../../engine';\nimport { createAudio, type Audio } from '../../../engine';\nimport { ACTIVITY_INFO, DAYS } from '../scenes/data/days';\nimport { STATIONS, groundAt } from '../scenes/data/world';\nimport { ageOf } from '../scenes/events/morning';\nimport { PEBBLE_SITES } from '../scenes/dress';\nimport { say as babble } from '../audio/voice';\nimport '../audio/sound';\nimport { createHud } from './hud';\nimport { hudFor } from './hudfor';\nimport { hint, type Device, type GlyphSet } from './glyphs';\nimport { LINES, lineText } from './lines';\nimport { Screens, SCREENS, type ScreenCtx } from './screens';\nimport { loadSave, loadSettings, writeSave, writeSettings, makeStore } from './store';\nimport { stageFx } from '../cameras/stage';\nimport { lineOf } from './speech';\n\nexport interface Deps { engine: () => Engine | null; session: boolean; touchOnly: boolean }\ntype Rec = Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any\nconst IDLE_S = 10;\nconst CAMERA_OF: Record<string, string> = { morning: 'front', ring: 'mat', pond: 'portrait', poseA: 'mat', poseB: 'mat', poseC: 'mat', poseH: 'mat', reps: 'side', step: 'behind', line: 'line', paddle: 'wide', garden: 'topdown', cliff: 'dive', hoop: 'front', jog: 'wide', tilt: 'tilt' };\n\nexport function createApp(deps: Deps) {\n  const store = makeStore(new URLSearchParams(location.search).has('sandbox') ? 'sandbox' : 'play');\n  let save = loadSave(store); let settings = loadSettings(store);\n  let audio: Audio | null = null; let hud: ReturnType<typeof createHud> | null = null; let screens: Screens | null = null; let root: HTMLElement | null = null;\n  let scr = 'boot'; let world: object | null = null; let lastSeq = 0; let idle = 0; let attract = false; let fadeEl: HTMLElement | null = null;\n  let page = 0; let aboutPage = 0; let current = ''; let lastFlowMode = ''; let said = 0; let pebbleMsg = 0; let freePlay = false; let paused = false; let lastDevice: Device = 'keyboard';\n  const eng = () => deps.engine();\n  const act = (name: string, args?: object) => eng()?.inspector?.actions.run(name, args);\n  const device = (): Device => { const d = eng()?.input?.lastDevice as string | undefined; return d === 'gamepad' ? 'pad' : d === 'mouse' ? 'mouse' : 'keyboard'; };\n  const glyphs = (): GlyphSet => settings.glyphs;\n  const sfx = (id: string, vol = 0.8) => { try { audio?.play(`sfx:retreat.${id}`, { vol: vol * settings.effects } as never); } catch { /* sound is a bonus */ } };\n  const ctx: ScreenCtx = { settings: () => settings, device, set: glyphs, pick: (s, id) => pick(s, id), cancel: (s) => cancel(s) };\n  const persist = () => { writeSave(store, save); writeSettings(store, settings); };\n  const applyAudio = () => { if (!audio) return; audio.volume('music', settings.music); audio.volume('effects', settings.effects); audio.volume('ui', settings.voices); };\n  function setCamera(code: string): void { try { eng()?.inspector?.camera.set(code, { blend: true } as never); } catch { /* cameras are presentation */ } }\n  function fade(then: () => void): void { if (!fadeEl) return then(); fadeEl.classList.add('on'); setTimeout(() => { then(); setTimeout(() => fadeEl?.classList.remove('on'), 60); }, 380); }\n  function speak(who: string, id: string, vars: Record<string, string | number> = {}): void {\n    const text = lineText(id, vars, said++); const sec = babble(audio, who === 'guest' ? 'tare' : who, text, settings.voices); hud?.say(who === 'tare' ? 'Tare' : who[0].toUpperCase() + who.slice(1), text, sec);\n  }\n  const open = (spec: ReturnType<(typeof SCREENS)[keyof typeof SCREENS] & ((...a: any[]) => any)>) => { screens?.open(spec as never); scr = (spec as { id: string }).id; };\n  const closeScreen = () => { screens?.close(); scr = attract ? 'attract' : 'play'; };\n\n  // ---- the flow -------------------------------------------------------------------------------------------------\n  function titleScreen(): void { setCamera('cam3=stage,title'); open(SCREENS.title(ctx, save.started, save.day > 1 || save.finished)); }\n  function begin(free = false): void {\n    freePlay = free; closeScreen(); fade(() => {\n      act('game.begin', { day: free ? 6 : save.day, finds: save.finds, pebbles: save.pebbles, age: save.ages[save.ages.length - 1] ?? 18 });\n      toIsland(!save.started); save.started = true; persist();\n    });\n  }\n  function toIsland(intro: boolean): void {\n    current = ''; act('game.leave'); const st = save.started ? STATIONS.plaza : STATIONS.pier;\n    act('game.go', { station: save.started ? 'plaza' : 'pier' }); void st; setMap('actionMap:roam'); setCamera('cam3=chase'); scr = 'play';\n    if (intro) { speak('tare', 'tare.intro.1'); setTimeout(() => speak('tare', 'tare.intro.2'), 5500); setTimeout(() => speak('tare', 'tare.intro.3'), 11500); }\n    else if (save.day > 1 || save.done.length) speak('tare', 'tare.back');\n  }\n  function setMap(id: string): void { try { eng()?.input?.use(id); } catch { /* maps exist */ } }\n  function startActivity(id: string, round = false): void {\n    if (id === 'board') return openBoard();\n    closeScreen(); fade(() => {\n      current = id === 'group' ? 'group' : id;\n      if (id === 'group') { act('game.round', { players: 1, cpu: settings.cpu }); setMap('actionMap:balance'); setCamera('cam3=stage,mat'); }\n      else { act('game.start', { event: id, short: round }); setMap(id === 'garden' ? 'actionMap:garden' : 'actionMap:balance'); setCamera(id === 'garden' ? 'cam=topdown' : `cam3=stage,${CAMERA_OF[id] ?? 'mat'}`); }\n      stageFx.t = 0; scr = 'play';\n    });\n  }\n  function goStation(where: string, id: string): void { closeScreen(); fade(() => { act('game.leave'); act('game.go', { station: where }); setMap('actionMap:roam'); setCamera('cam3=chase'); scr = 'play'; setTimeout(() => startActivity(id), 350); }); }\n  function openProgramme(): void {\n    const day = DAYS[Math.min(save.day, 5) - 1]; const rows = day.acts.map((a) => ({ label: `${save.done.includes(`${save.day}:${a}`) ? '✓ ' : ''}${a === 'board' ? 'Find the Noticeboard' : ACTIVITY_INFO[a].title}`, id: a }));\n    rows.push({ label: 'Close', id: 'close' }); open(SCREENS.programme(ctx, day.n, day.title, rows.slice(0, 6), 'Pick one. \"Go\" takes you there.'));\n  }\n  function openBoard(): void {\n    const all = Object.keys(ACTIVITY_INFO).filter((a) => a !== 'tilt' || save.day >= 5); const pages = Math.ceil(all.length / 5);\n    page = ((page % pages) + pages) % pages; const slice = all.slice(page * 5, page * 5 + 5);\n    const rows = slice.map((a) => ({ label: `${ACTIVITY_INFO[a].title}${save.bests[a] ? ` · best ${save.bests[a]}` : ''}`, id: a, disabled: save.day < 2 && !save.done.some((d) => d.endsWith(a)) && a !== 'morning' && a !== 'poseA' && a !== 'pond' }));\n    rows.push({ label: 'Close', id: 'close', disabled: false }); open(SCREENS.board(ctx, page, pages, rows, 'Every activity you have met, to play again.'));\n  }\n  function onResult(r: { id: string; score: number; rank: string; pebbles: number }): void {\n    const key = `${save.day}:${r.id}`; if (!save.done.includes(key)) save.done.push(key);\n    save.pebbles += r.pebbles; save.bests[r.id] = Math.max(save.bests[r.id] ?? 0, r.score);\n    if (r.id === 'morning') { const age = ageOf(r.score / 1000, 1.3); save.ages.push(age); save.checkDay = save.day; const prev = save.ages[save.ages.length - 2];\n      speak('tare', prev === undefined ? 'tare.age.first' : age < prev ? 'tare.age.better' : age > prev ? 'tare.age.worse' : 'tare.age.same', { age, prev: prev ?? 0, diff: Math.abs(age - (prev ?? age)) }); }\n    persist(); act('game.cairn', { count: save.pebbles, age: save.ages[save.ages.length - 1] ?? 18 }); sfx('stamp');\n    open(SCREENS.results(ctx, ACTIVITY_INFO[r.id]?.title ?? r.id, r.rank, r.score, r.pebbles, said++));\n  }\n  function evening(): void {\n    const rem = lineText('evening.' + (1 + ((save.day - 1) % 5)), {}, 0); open(SCREENS.evening(ctx, save.day, save.ages, rem));\n  }\n  function sleep(): void {\n    fade(() => {\n      closeScreen(); const last = save.day >= 5;\n      if (last) { save.day = 6; save.finished = true; persist(); act('game.day', { day: 6 }); credits(); return; }\n      save.day += 1; persist(); act('game.day', { day: save.day }); act('game.leave'); act('game.go', { station: 'plaza' }); setMap('actionMap:roam'); setCamera('cam3=chase'); scr = 'play';\n      if (save.day === 4) setTimeout(() => speak('tare', 'tare.rock'), 4000); else speak('tare', 'tare.keep');\n    });\n  }\n  function credits(): void { setCamera('cam3=stage,title'); open(SCREENS.credits(ctx)); }\n  const dayDone = () => DAYS[Math.min(save.day, 5) - 1].acts.filter((a) => a !== 'board').every((a) => save.done.includes(`${save.day}:${a}`));\n\n  function pick(s: string, id: string): void {\n    sfx('tick');\n    if (s === 'title') { if (id === 'begin') begin(false); else if (id === 'free') begin(true); else if (id === 'group') { closeScreen(); fade(() => { act('game.begin', { day: save.day, finds: save.finds, pebbles: save.pebbles }); startActivity('group'); }); } else if (id === 'settings') openSettings('title'); else if (id === 'about') openAbout('title'); }\n    else if (s === 'programme') { if (id === 'close') closeScreen(); else if (id === 'board') openBoard(); else goStation(ACTIVITY_INFO[id].where, id); }\n    else if (s === 'board') { if (id === 'close') closeScreen(); else goStation(ACTIVITY_INFO[id].where, id); }\n    else if (s === 'results') { if (id === 'again') startActivity(current); else { closeScreen(); fade(() => { act('game.leave'); if (current === 'tilt') { save.ages = save.ages; speak('tare', 'tare.tilt.dawn'); credits(); return; } act('game.go', { station: 'plaza' }); setMap('actionMap:roam'); setCamera('cam3=chase'); scr = 'play'; if (dayDone()) hud?.toast('The day is done. Go to your hut to sleep, or open the Programme.', 5); }); } }\n    else if (s === 'evening') sleep();\n    else if (s === 'credits') { closeScreen(); fade(() => { save.finished = true; persist(); toIsland(false); speak('tare', 'tare.free'); }); }\n    else if (s === 'pause') pausePick(id);\n    else if (s === 'more') { if (id === 'controls') openControls(); else if (id === 'dev') openDev(); else if (id === 'about') openAbout('more'); else openPause(); }\n    else if (s === 'settings') settingsPick(id);\n    else if (s.startsWith('sub-')) subPick(s, id);\n    else if (s === 'about') { if (id === 'next') { aboutPage++; open(SCREENS.about(ctx, aboutPage)); } else back(); }\n    else if (s === 'controls') back(); else if (s === 'confirm') { if (id === 'yes') { store.clear(); save = loadSave(store); settings = loadSettings(store); persist(); applyAudio(); } openSettings(origin); }\n    else if (s === 'touch') openSettings('title');\n  }\n  let origin = 'title';\n  function back(): void { if (origin === 'title') titleScreen(); else if (origin === 'more') openMore(); else openPause(); }\n  function cancel(s: string): void {\n    if (s === 'title' || s === 'evening' || s === 'credits' || s === 'results') return;\n    if (s === 'programme' || s === 'board') closeScreen(); else if (s === 'pause') resume(); else if (s === 'more') openPause(); else if (s === 'settings' || s === 'about' || s === 'controls' || s.startsWith('sub-')) { if (s.startsWith('sub-')) openSettings(origin); else back(); } else if (s === 'confirm') openSettings(origin);\n  }\n  function openPause(): void { paused = true; eng()?.inspector?.pause(); open(SCREENS.pause(ctx, current !== '' && current !== 'group' || current === 'group', deps.session)); }\n  function openMore(): void { open(SCREENS.more(ctx, !deps.session)); }\n  function resume(): void { paused = false; closeScreen(); eng()?.inspector?.resume(); }\n  function pausePick(id: string): void {\n    if (id === 'resume') resume();\n    else if (id === 'restart') { resume(); startActivity(current); }\n    else if (id === 'island') { resume(); closeScreen(); fade(() => { act('game.leave'); act('game.go', { station: 'plaza' }); setMap('actionMap:roam'); setCamera('cam3=chase'); current = ''; scr = 'play'; }); }\n    else if (id === 'settings') openSettings('pause'); else if (id === 'more') openMore(); else if (id === 'icons') { settings.glyphs = settings.glyphs === 'ps' ? 'xbox' : 'ps'; persist(); hud?.toast(`Button icons: ${settings.glyphs === 'ps' ? 'PlayStation' : 'Xbox'}`); }\n    else if (id === 'quit') { resume(); fade(() => { act('game.leave'); current = ''; titleScreen(); }); }\n  }\n  function openSettings(from: string): void { origin = from; open(SCREENS.settings(ctx, settings)); }\n  function openAbout(from: string): void { origin = from; aboutPage = 0; open(SCREENS.about(ctx, 0)); }\n  function openControls(): void { origin = 'more'; open(SCREENS.controls(ctx, [{ label: 'Back', id: 'back' }])); }\n  let openDev = () => hud?.toast('Dev Mode is not loaded');\n  const pct = (v: number) => `${Math.round(v * 100)}%`;\n  function settingsPick(id: string): void {\n    if (id === 'back') return back();\n    if (id === 'erase') return open(SCREENS.confirm(ctx, 'Erase Save', 'Everything you have done on the island will be forgotten. The island will not mind.', 'Erase'));\n    const rows = id === 'sound' ? [{ label: `Music ${pct(settings.music)}`, id: 'music' }, { label: `Effects ${pct(settings.effects)}`, id: 'effects' }, { label: `Voices ${pct(settings.voices)}`, id: 'voices' }, { label: 'Back', id: 'back' }]\n      : id === 'play' ? [{ label: `Button ic