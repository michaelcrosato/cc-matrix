 (a[1] / a[2]) * 1.05) * 1000; run.done = 1; }\n  },\n  bot(c, bot: Bot) { botSeat(bot, c.me.wobble, c.me.seat, 0, 0, 0, 0); },\n};\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/index.ts'\ns=open(p).read()\ns=s.replace(\"import { poseA, poseB, poseC } from './pose';\",\"import { poseA, poseB, poseC, poseH } from './pose';\\nimport { ring } from './ring';\").replace(\"{ morning, poseA, poseB, poseC,\",\"{ morning, poseA, poseB, poseC, poseH, ring,\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"ACTIVITIES\" labs/game/scenes/events/index.ts | tail -1\npython3 - <<'EOF'\np='labs/game/scenes/components.ts'\ns=open(p).read()\ns=s.replace(\"export const MARK =\",\"\"\"export const ROUND = defineComponent('round', {\n  description: 'A class or hub round: which class it is on, the deal, and each seat\\\\'s running total.',\n  fields: { on: int(0, '1 while a round runs.'), cls: int(0, 'Class 0-2.'), deal: int(0, 'Which middle class was dealt.'), total: arr([0, 0, 0, 0], 'Seat totals.'), seats: int(1, 'How many seats play.'), cpu: int(1, '1 when CPU guests fill empty seats.') },\n});\nexport const MARK =\"\"\")\ns=s.replace(\"  mark: { x: number;\",\"  round: { on: number; cls: number; deal: number; total: number[]; seats: number; cpu: number };\\n  mark: { x: number;\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/scenes/round.ts <<'EOF'\n/**\n * @file A Round: three classes dealt from the stream `deal` (same seed, same deal) - Still Ring, then Heron, Hoop or Step, then\n * Still Pond - each in its short form on the pavilion's mats. Used by Group Class on the island (CPU guests Gerald, Bex and\n * Nan fill empty seats) and by the hub's ghost session (`game:round`, only the local seat). Score is the sum, 0-3000. Sim-side.\n * @example\n * CLASS_OF[0]; // 'ring'\n */\nimport { STATIONS, groundAt } from './data/world';\nimport { placeCast, placeGuest } from './cast';\nimport { seatedOf, startActivity } from './events/runner';\nimport type { W } from './events/types';\n\nexport const MIDDLE = ['poseH', 'hoop', 'step'] as const;\nexport const CLASS_OF = ['ring', 'middle', 'pond'] as const;\nconst CPU = [{ who: 'gerald', bot: 'human' }, { who: 'bex', bot: 'perfect' }, { who: 'nan', bot: 'human' }];\nexport const matOf = (i: number): [number, number, number] => [STATIONS.pavilion.at[0] - 4.5 + i * 3, STATIONS.pavilion.y, STATIONS.pavilion.at[1]];\nconst roundOf = (w: W) => w.query('round')[0]?.round;\nexport const classId = (w: W): string => { const r = roundOf(w); if (!r) return ''; return r.cls === 1 ? MIDDLE[r.deal] : CLASS_OF[r.cls]; };\n/** Starts a round: seats take the mats, empty seats go to CPU guests when `cpu`. */\nexport function startRound(w: W, players = 1, cpu = true): void {\n  const r = roundOf(w); if (!r) return;\n  r.on = 1; r.cls = 0; r.deal = w.rng('deal').int(0, 2); r.total = [0, 0, 0, 0]; r.seats = 4; r.cpu = cpu ? 1 : 0;\n  const flow = w.query('flow')[0].flow; flow.ender = 'round';\n  for (const e of seatedOf(w)) {\n    const who = e.cast.who; const gi = who === 'guest' ? 0 : CPU.findIndex((c) => c.who === who) + 1;\n    e.cast.seatNo = -1;\n    if (who === 'guest') { e.cast.seatNo = 0; e.cast.mat = [...matOf(0)]; placeGuest(w, matOf(0), 0); }\n    else if (gi > 0 && cpu && gi >= players) { e.cast.seatNo = gi; e.cast.bot = CPU[gi - 1].bot; e.cast.mat = [...matOf(gi)]; placeCast(w, who, matOf(gi)[0], matOf(gi)[2], 0); }\n  }\n  startActivity(w, classId(w), true);\n}\n/** Called each step by the runner when every seat has finished a class: adds up, deals the next or ends. */\nexport function advanceRound(w: W): void {\n  const r = roundOf(w); const flow = w.query('flow')[0].flow; if (!r || !r.on) return;\n  const seats = seatedOf(w).filter((e) => e.cast.seatNo >= 0).sort((a, b) => a.cast.seatNo - b.cast.seatNo);\n  const total = [...r.total]; for (const e of seats) total[e.cast.seatNo] += e.act.score; r.total = total;\n  w.emit('classDone', { cls: r.cls, total });\n  if (r.cls < 2) { r.cls += 1; startActivity(w, classId(w), true); }\n  else { r.on = 0; flow.mode = 'results'; flow.ender = ''; flow.score = Math.round(total[0] / 3); w.emit('roundDone', { total }); for (const e of seats) e.cast.seatNo = -1; }\n}\nexport const roundOn = (w: W): boolean => !!roundOf(w)?.on;\nvoid groundAt;\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/runner.ts'\ns=open(p).read()\ns=s.replace(\"import { placeGuest } from '../cast';\",\"import { placeGuest } from '../cast';\\nimport { advanceRound, roundOn } from '../round';\")\ns=s.replace(\"      if (c.lead) {\\n        const r = rankOf(run.score);\",\"      if (c.lead && !roundOn(w)) {\\n        const r = rankOf(run.score);\")\ns=s.replace(\"  // a class with no guest run (a hub Round) ends when every seat is done\\n  if (flow.mode === 'event' && seatedOf(w).every((e) => !e.act.id || e.act.done === 2)) flow.mode = 'results';\",\"  // a class ends when every seat is done: a round deals the next, a hub round with no guest run ends\\n  if (flow.mode === 'event' && seatedOf(w).every((e) => !e.act.id || e.act.done === 2)) { if (roundOn(w)) advanceRound(w); else flow.mode = 'results'; }\")\nopen(p,'w').write(s)\np='labs/game/scenes/cast.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  for (const c of CAST_TABLE) spawnPerson(w, c.who, c.body, c.build, c.at[0], c.at[1], c.speed, Math.PI);\"\"\",\"\"\"  for (const c of CAST_TABLE) {\n    const seated = c.who === 'gerald' || c.who === 'bex' || c.who === 'nan';\n    const sw = [0.3, 1.7, 2.9, 1, 1.1, 0.9, 0, 0, 0];\n    spawnPerson(w, c.who, c.body, c.build, c.at[0], c.at[1], c.speed, Math.PI, seated ? { seat: {}, wobble: { sw: sw.map((v, i) => (i < 3 ? v + c.at[0] * 0.1 : v)) }, act: {} } : {});\n  }\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/island.ts'\ns=open(p).read()\ns=s.replace(\"w.spawn({ flow: { mode: 'roam', day: 1 }, island: { tilt: 0.4 } });\",\"w.spawn({ flow: { mode: 'roam', day: 1 }, island: { tilt: 0.4 }, round: {} });\")\ns=s.replace(\"import { ISLAND, FLOW, ACT, CAST, PEBBLE, PLAQUE, GHOST, MARK, type Comps }\",\"import { ISLAND, FLOW, ACT, CAST, PEBBLE, PLAQUE, GHOST, MARK, ROUND, type Comps }\").replace(\"void [ISLAND, FLOW, ACT, CAST, PEBBLE, PLAQUE, GHOST, MARK, SEAT, WOBBLE];\",\"void [ISLAND, FLOW, ACT, CAST, PEBBLE, PLAQUE, GHOST, MARK, ROUND, SEAT, WOBBLE];\")\ns=s.replace(\"    'game.day':\",\"    'game.round': (w, args) => { const a = args as { players?: number; cpu?: boolean }; startRound(w, a.players ?? 1, a.cpu !== false); },\\n    'game.day':\")\ns=s.replace(\"import './settings';\",\"import { startRound } from './round';\\nimport './settings';\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/scenes/events/round.test.ts <<'EOF'\n/** @file A whole Group Class round: guest + three CPU guests play three short classes; same seed gives the same deal and totals. */\nimport { describe, expect, it } from 'vitest';\nimport { comp, lite } from '../testkit';\n\nasync function playRound(seed: number): Promise<{ total: number[]; deal: number; steps: number }> {\n  const h = await lite(seed); const run = h.actions as unknown as { run(n: string, a?: object): void };\n  run.run('game.round', { players: 1, cpu: true }); run.run('game.bot', { kind: 'human' });\n  let steps = 0;\n  while (steps < 60 * 400) { h.step(60); steps += 60; if (comp<{ mode: string }>(h, 'flow')[0].mode !== 'event') break; }\n  const r = comp<{ total: number[]; deal: number; on: number }>(h, 'round')[0];\n  expect(comp<{ mode: string }>(h, 'flow')[0].mode).toBe('results'); expect(r.on).toBe(0);\n  return { total: r.total, deal: r.deal, steps };\n}\ndescribe('round', () => {\n  it('plays three classes to a podium, deterministically', async () => {\n    const a = await playRound(5); const b = await playRound(5);\n    expect(a).toEqual(b); expect(a.total[0]).toBeGreaterThan(300); expect(a.total.every((t) => Number.isFinite(t))).toBe(true);\n  }, 600000);\n});\nEOF\nnpx vitest run labs/game/scenes/events/round.test.ts 2>&1 | grep -E \"Error|FAIL|passed|expected|AssertionError\" | cut -c1-300 | head","uuid":"c397f972-cb23-4d5b-a7d2-a84115ad86e7","session_id":"e83c655a-6d0a-42b2-ac8e-79c6fd4e6b22"}
