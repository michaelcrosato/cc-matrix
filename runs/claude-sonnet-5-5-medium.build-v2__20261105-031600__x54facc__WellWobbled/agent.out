{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjdzBgy8xL99dT4KVTym","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014KZ1Fngvc5MKZrDK4A4SsM","name":"Bash","input":{"command":"cat > labs/game/scenes/data/poses.ts <<'EOF'\n/**\n * @file The eight poses as a data table (seat on the disc, rules, which classes teach them). Add a row to add a pose.\n * @example\n * POSES.heron.foot; // 1: the left foot must be held\n */\nexport interface PoseDef {\n  id: string; clip: string; title: string; seat: readonly [number, number]; seat2?: readonly [number, number];\n  inst: number; sway: number; ring?: number; foot: 0 | 1 | 2 | 3; breathW: number; hold?: number; climb?: number; line: string;\n}\nconst P = (id: string, clip: string, title: string, seat: [number, number], o: Partial<PoseDef> = {}): PoseDef =>\n  ({ id, clip, title, seat, inst: 1, sway: 1, foot: 0, breathW: 0.3, line: `plumb.pose.${id}`, ...o });\nexport const POSES: Record<string, PoseDef> = {\n  nothing: P('nothing', 'Nothing', 'Seated Nothing', [0, 0], { sway: 0.5, breathW: 0.6 }),\n  chair: P('chair', 'Chair', 'The Patient Chair', [0, -0.35], { foot: 3, breathW: 0, climb: 1.2 }),\n  heron: P('heron', 'Heron', 'The Heron', [0, 0], { foot: 1, inst: 1.5 }),\n  archer: P('archer', 'Archer', 'The Archer', [0.35, 0.35], { inst: 1.2 }),\n  comma: P('comma', 'Comma', 'The Sideways Comma', [0.5, 0], { seat2: [-0.5, 0], hold: 8 }),\n  napkin: P('napkin', 'Napkin', 'The Folded Napkin', [0, 0.5]),\n  bridge: P('bridge', 'Bridge', 'The Polite Bridge', [0, 0], { breathW: 0.7 }),\n  lighthouse: P('lighthouse', 'Lighthouse', 'The Lighthouse', [0, 0], { ring: 0.14, sway: 1.2 }),\n};\n/** The three poses of each class. */\nexport const CLASSES: Record<string, string[]> = { poseA: ['nothing', 'chair', 'heron'], poseB: ['archer', 'comma', 'napkin'], poseC: ['bridge', 'lighthouse', 'heron'] };\nEOF\ncat > labs/game/scenes/events/pose.ts <<'EOF'\n/**\n * @file Pose Class (about 2.5 min, three poses): Plumb demonstrates (4 s, skippable), you enter the pose by following a\n * guide dot on the disc (progress scrubs the body into the pose), hold it in the seat ring with the breath, then rest.\n * Three classes (A, B, C) share this module; the pose table is data/poses.ts. Score: 1000 x (inRing x (1 - w) + sync x w)\n * minus 60 per topple, averaged over the class. Sim-side.\n * @example\n * poseA.title; // 'Pose Class A'\n */\nimport { botSeat, type Bot } from '../bot/players';\nimport { CLASSES, POSES, type PoseDef } from '../data/poses';\nimport { actorId, setPose, clearPose } from '../cast';\nimport { clamp, go, say, secs, type Activity, type Ctx } from './types';\n\nconst R = { idx: 1, u: 2, inAll: 3, inRing: 4, syncSum: 5, tops0: 6, sum: 7, held: 8, second: 9, enterT: 10, last: 11 };\nconst defOf = (c: Ctx): PoseDef => POSES[CLASSES[c.run.id][Math.min(2, c.run.a[R.idx])]];\nconst holdSecs = (c: Ctx, d: PoseDef) => (d.hold ? d.hold : c.p('game.pose.hold'));\n/** The guide dot at progress u: from the centre to the seat along a gentle curve. */\nexport function guide(d: PoseDef, u: number): [number, number] {\n  const [sx, sy] = d.seat; const bend = 0.22 * Math.sin(Math.PI * u);\n  return [sx * u - sy * bend, sy * u + sx * bend];\n}\nfunction seatNow(c: Ctx, d: PoseDef): readonly [number, number] {\n  return d.seat2 && c.run.a[R.second] ? d.seat2 : d.seat;\n}\nfunction begin(c: Ctx): void {\n  const d = defOf(c); const a = c.run.a;\n  Object.assign(a, { [R.u]: 0, [R.inAll]: 0, [R.inRing]: 0, [R.syncSum]: 0, [R.held]: 0, [R.second]: 0, [R.enterT]: 0 });\n  a[R.tops0] = c.me.wobble.topples; go(c.run, 'demo');\n  say(c, 'plumb', `plumb.demo.${d.id}`);\n}\nfunction pose(c: Ctx, progress: number): void {\n  const id = actorId(c.w, c.me.cast.who); const d = defOf(c);\n  if (c.lead && id >= 0) setPose(c.w, id, d.clip, progress, c.me.wobble.x, c.me.wobble.y);\n}\nexport const poseClass = (id: 'poseA' | 'poseB' | 'poseC', title: string): Activity => ({\n  id, title, station: 'pavilion', camera: 'mat', map: 'balance', seconds: 150, hasShort: true,\n  setup(c) { c.run.a[R.idx] = 0; c.run.a[R.sum] = 0; begin(c); },\n  step(c) {\n    const { run, me } = c; const a = run.a; a[0] += 1; const b = me.wobble; const d = defOf(c);\n    b.instMul = d.inst; b.swayMul = d.sway * (run.id === 'poseB' && d.id === 'napkin' ? 1 : 1) * (d.climb ? 1 + d.climb * Math.min(1, a[0] / secs(holdSecs(c, d))) : 1);\n    if (run.phase === 'demo') {\n      pose(c, 0);\n      if (a[0] >= secs(4) || (me.seat.act && a[0] > 20)) { go(run, 'enter'); say(c, 'plumb', 'plumb.nowyou'); }\n    } else if (run.phase === 'enter') {\n      const u = a[R.u]; const [gx, gy] = guide(d, u);\n      a[R.enterT] += 1;\n      if (Math.hypot(b.x - gx, b.y - gy) < 0.18) a[R.u] = Math.min(1, u + 1 / secs(3));\n      pose(c, a[R.u]);\n      if (a[R.u] >= 1 || a[0] >= secs(10)) { if (a[R.u] < 1) say(c, 'plumb', 'plumb.start'); a[R.u] = 1; go(run, 'hold'); a[R.held] = 0; }\n    } else if (run.phase === 'hold') {\n      const [sx, sy] = seatNow(c, d); const ring = d.ring ?? c.p('game.pose.ring');\n      const footOk = d.foot === 0 || (d.foot === 1 ? me.seat.fl > 0.5 : d.foot === 2 ? me.seat.fr > 0.5 : me.seat.fl > 0.5 && me.seat.fr > 0.5);\n      a[R.inAll] += 1; a[R.held] += 1;\n      if (b.r > 0.001 && Math.hypot(b.x - sx, b.y - sy) < ring && footOk) a[R.inRing] += 1;\n      a[R.syncSum] += d.foot === 3 ? (footOk ? 1 : 0) : b.sync;\n      pose(c, 1);\n      const total = secs(holdSecs(c, d)) * (c.run.short ? 0.6 : 1);\n      if (d.seat2 && !a[R.second] && a[R.held] >= total) { a[R.second] = 1; a[R.held] = 0; say(c, 'plumb', 'plumb.comma.other'); }\n      else if (a[R.held] >= total) { go(run, 'rest'); say(c, 'plumb', 'plumb.rest'); }\n    } else if (run.phase === 'rest') {\n      pose(c, 0);\n      if (a[0] === 1) {\n        const ringShare = a[R.inRing] / Math.max(1, a[R.inAll]); const sync = a[R.syncSum] / Math.max(1, a[R.inAll]);\n        const s = 1000 * (ringShare * (1 - d.breathW) + sync * d.breathW) - 60 * (b.topples - a[R.tops0]);\n        a[R.sum] += clamp(s, 0, 1000); c.w.emit('pose', { id: d.id, score: Math.round(s) });\n      }\n      if (a[0] >= secs(1.5)) {\n        a[R.idx] += 1;\n        if (a[R.idx] >= 3) { run.score = a[R.sum] / 3; run.done = 1; const id = actorId(c.w, c.me.cast.who); if (id >= 0 && c.lead) clearPose(c.w, id); } else begin(c);\n      }\n    }\n  },\n  bot(c, bot: Bot) {\n    const { run, me } = c; const a = run.a; const d = defOf(c);\n    let px = 0, py = 0, breath = 0, foot = 0;\n    me.seat.act = run.phase === 'demo' && a[0] > 30;\n    if (run.phase === 'enter') [px, py] = guide(d, a[R.u]);\n    if (run.phase === 'hold') { [px, py] = seatNow(c, d); breath = d.foot === 3 ? 0 : 1; foot = d.foot; if (d.foot === 3) foot = 3; if (d.foot === 1 || d.foot === 2) breath = 0; }\n    botSeat(bot, me.wobble, me.seat, px, py, breath, foot);\n  },\n});\nexport const poseA = poseClass('poseA', 'Pose Class A');\nexport const poseB = poseClass('poseB', 'Pose Class B');\nexport const poseC = poseClass('poseC', 'Pose Class C');\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/index.ts'\nopen(p,'w').write('''/**\n * @file The activity registry: every activity module by id. Add a row here to add an activity.\n * @example\n * ACTIVITIES.morning.title; // 'Morning Check'\n */\nimport { morning } from './morning';\nimport { poseA, poseB, poseC } from './pose';\nimport type { Activity } from './types';\n\nexport const ACTIVITIES: Record<string, Activity> = { morning, poseA, poseB, poseC };\n''')\nEOF\ncat > labs/game/scenes/events/suite.ts <<'EOF'\n/**\n * @file The shared activity test: the four players on `seeds` seeds against the balance targets (perfect >= 750,\n * human-like >= 550, sloppy >= 300, idle <= 500 and below human-like), random mashing never throws, scores stay in\n * range with no NaN, and idle finishes on its own. Used by each activity's test file.\n * @example\n * await balanceReport('morning', 3); // { perfect, human, sloppy, idle } means\n */\nimport { expect } from 'vitest';\nimport { comp, playActivity } from '../testkit';\n\nexport async function balanceReport(id: string, seeds: number, short = false): Promise<Record<string, number>> {\n  const mean: Record<string, number> = {};\n  for (const kind of ['perfect', 'human', 'sloppy', 'idle']) {\n    let sum = 0;\n    for (let seed = 1; seed <= seeds; seed++) {\n      const r = await playActivity(id, kind === 'idle' ? 'idle' : kind, seed, { short });\n      expect(r.done, `${id} ${kind} seed ${seed} finishes`).toBe(true);\n      expect(Number.isFinite(r.score) && r.score >= 0 && r.score <= 1000).toBe(true);\n      sum += r.score;\n    }\n    mean[kind] = sum / seeds;\n  }\n  return mean;\n}\nexport function expectTargets(id: string, m: Record<string, number>, strict = true): void {\n  console.log('BAL', id, JSON.stringify(m, (_k, v) => (typeof v === 'number' ? Math.round(v) : v)));\n  if (!strict) return;\n  expect(m.perfect, `${id} perfect`).toBeGreaterThanOrEqual(750);\n  expect(m.human, `${id} human`).toBeGreaterThanOrEqual(550);\n  expect(m.sloppy, `${id} sloppy`).toBeGreaterThanOrEqual(300);\n  expect(m.idle, `${id} idle`).toBeLessThanOrEqual(500);\n  expect(m.idle, `${id} idle < human`).toBeLessThan(m.human);\n}\nexport async function mashSafe(id: string, seed = 3): Promise<void> {\n  const r = await playActivity(id, 'mash', seed);\n  expect(r.done).toBe(true);\n  expect(Number.isFinite(r.score)).toBe(true);\n  const ids = comp<{ ids: number[] }>(r.h, 'act');\n  expect(ids.length).toBeGreaterThan(0);\n}\nEOF\ncat > labs/game/scenes/events/pose.test.ts <<'EOF'\n/** @file Pose Class A, B and C meet the balance targets. */\nimport { describe, it } from 'vitest';\nimport { balanceReport, expectTargets, mashSafe } from './suite';\n\ndescribe('pose classes', () => {\n  for (const id of ['poseA', 'poseB', 'poseC']) {\n    it(id, async () => { expectTargets(id, await balanceReport(id, 3)); await mashSafe(id); }, 600000);\n  }\n});\nEOF\nnpx vitest run labs/game/scenes/events/pose.test.ts 2>&1 | grep -E \"BAL|Error|FAIL|passed|expected|✓|×\" | cut -c1-300","timeout":900000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13903,"cache_read_input_tokens":228874,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13903},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e83c655a-6d0a-42b2-ac8e-79c6fd4e6b22","uuid":"fc67c39a-256b-4392-b80d-3f9e36f23211","timestamp":"2026-11-05T10:40:21.726Z","request_id":"req_011CgjdzBR7CjTbFfaN9d2uA","wire_tool_inputs":{"toolu_014KZ1Fngvc5MKZrDK4A4SsM":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-031600__x54facc/work/WellWobbled-WiiFit-claude-sonnet-5-5-medium-20261105-031600 && cat > labs/game/scenes/data/poses.ts <<'EOF'\n/**\n * @file The eight poses as a data table (seat on the disc, rules, which classes teach them). Add a row to add a pose.\n * @example\n * POSES.heron.foot; // 1: the left foot must be held\n */\nexport interface PoseDef {\n  id: string; clip: string; title: string; seat: readonly [number, number]; seat2?: readonly [number, number];\n  inst: number; sway: number; ring?: number; foot: 0 | 1 | 2 | 3; breathW: number; hold?: number; climb?: number; line: string;\n}\nconst P = (id: string, clip: string, title: string, seat: [number, number], o: Partial<PoseDef> = {}): PoseDef =>\n  ({ id, clip, title, seat, inst: 1, sway: 1, foot: 0, breathW: 0.3, line: `plumb.pose.${id}`, ...o });\nexport const POSES: Record<string, PoseDef> = {\n  nothing: P('nothing', 'Nothing', 'Seated Nothing', [0, 0], { sway: 0.5, breathW: 0.6 }),\n  chair: P('chair', 'Chair', 'The Patient Chair', [0, -0.35], { foot: 3, breathW: 0, climb: 1.2 }),\n  heron: P('heron', 'Heron', 'The Heron', [0, 0], { foot: 1, inst: 1.5 }),\n  archer: P('archer', 'Archer', 'The Archer', [0.35, 0.35], { inst: 1.2 }),\n  comma: P('comma', 'Comma', 'The Sideways Comma', [0.5, 0], { seat2: [-0.5, 0], hold: 8 }),\n  napkin: P('napkin', 'Napkin', 'The Folded Napkin', [0, 0.5]),\n  bridge: P('bridge', 'Bridge', 'The Polite Bridge', [0, 0], { breathW: 0.7 }),\n  lighthouse: P('lighthouse', 'Lighthouse', 'The Lighthouse', [0, 0], { ring: 0.14, sway: 1.2 }),\n};\n/** The three poses of each class. */\nexport const CLASSES: Record<string, string[]> = { poseA: ['nothing', 'chair', 'heron'], poseB: ['archer', 'comma', 'napkin'], poseC: ['bridge', 'lighthouse', 'heron'] };\nEOF\ncat > labs/game/scenes/events/pose.ts <<'EOF'\n/**\n * @file Pose Class (about 2.5 min, three poses): Plumb demonstrates (4 s, skippable), you enter the pose by following a\n * guide dot on the disc (progress scrubs the body into the pose), hold it in the seat ring with the breath, then rest.\n * Three classes (A, B, C) share this module; the pose table is data/poses.ts. Score: 1000 x (inRing x (1 - w) + sync x w)\n * minus 60 per topple, averaged over the class. Sim-side.\n * @example\n * poseA.title; // 'Pose Class A'\n */\nimport { botSeat, type Bot } from '../bot/players';\nimport { CLASSES, POSES, type PoseDef } from '../data/poses';\nimport { actorId, setPose, clearPose } from '../cast';\nimport { clamp, go, say, secs, type Activity, type Ctx } from './types';\n\nconst R = { idx: 1, u: 2, inAll: 3, inRing: 4, syncSum: 5, tops0: 6, sum: 7, held: 8, second: 9, enterT: 10, last: 11 };\nconst defOf = (c: Ctx): PoseDef => POSES[CLASSES[c.run.id][Math.min(2, c.run.a[R.idx])]];\nconst holdSecs = (c: Ctx, d: PoseDef) => (d.hold ? d.hold : c.p('game.pose.hold'));\n/** The guide dot at progress u: from the centre to the seat along a gentle curve. */\nexport function guide(d: PoseDef, u: number): [number, number] {\n  const [sx, sy] = d.seat; const bend = 0.22 * Math.sin(Math.PI * u);\n  return [sx * u - sy * bend, sy * u + sx * bend];\n}\nfunction seatNow(c: Ctx, d: PoseDef): readonly [number, number] {\n  return d.seat2 && c.run.a[R.second] ? d.seat2 : d.seat;\n}\nfunction begin(c: Ctx): void {\n  const d = defOf(c); const a = c.run.a;\n  Object.assign(a, { [R.u]: 0, [R.inAll]: 0, [R.inRing]: 0, [R.syncSum]: 0, [R.held]: 0, [R.second]: 0, [R.enterT]: 0 });\n  a[R.tops0] = c.me.wobble.topples; go(c.run, 'demo');\n  say(c, 'plumb', `plumb.demo.${d.id}`);\n}\nfunction pose(c: Ctx, progress: number): void {\n  const id = actorId(c.w, c.me.cast.who); const d = defOf(c);\n  if (c.lead && id >= 0) setPose(c.w, id, d.clip, progress, c.me.wobble.x, c.me.wobble.y);\n}\nexport const poseClass = (id: 'poseA' | 'poseB' | 'poseC', title: string): Activity => ({\n  id, title, station: 'pavilion', camera: 'mat', map: 'balance', seconds: 150, hasShort: true,\n  setup(c) { c.run.a[R.idx] = 0; c.run.a[R.sum] = 0; begin(c); },\n  step(c) {\n    const { run, me } = c; const a = run.a; a[0] += 1; const b = me.wobble; const d = defOf(c);\n    b.instMul = d.inst; b.swayMul = d.sway * (run.id === 'poseB' && d.id === 'napkin' ? 1 : 1) * (d.climb ? 1 + d.climb * Math.min(1, a[0] / secs(holdSecs(c, d))) : 1);\n    if (run.phase === 'demo') {\n      pose(c, 0);\n      if (a[0] >= secs(4) || (me.seat.act && a[0] > 20)) { go(run, 'enter'); say(c, 'plumb', 'plumb.nowyou'); }\n    } else if (run.phase === 'enter') {\n      const u = a[R.u]; const [gx, gy] = guide(d, u);\n      a[R.enterT] += 1;\n      if (Math.hypot(b.x - gx, b.y - gy) < 0.18) a[R.u] = Math.min(1, u + 1 / secs(3));\n      pose(c, a[R.u]);\n      if (a[R.u] >= 1 || a[0] >= secs(10)) { if (a[R.u] < 1) say(c, 'plumb', 'plumb.start'); a[R.u] = 1; go(run, 'hold'); a[R.held] = 0; }\n    } else if (run.phase === 'hold') {\n      const [sx, sy] = seatNow(c, d); const ring = d.ring ?? c.p('game.pose.ring');\n      const footOk = d.foot === 0 || (d.foot === 1 ? me.seat.fl > 0.5 : d.foot === 2 ? me.seat.fr > 0.5 : me.seat.fl > 0.5 && me.seat.fr > 0.5);\n      a[R.inAll] += 1; a[R.held] += 1;\n      if (b.r > 0.001 && Math.hypot(b.x - sx, b.y - sy) < ring && footOk) a[R.inRing] += 1;\n      a[R.syncSum] += d.foot === 3 ? (footOk ? 1 : 0) : b.sync;\n      pose(c, 1);\n      const total = secs(holdSecs(c, d)) * (c.run.short ? 0.6 : 1);\n      if (d.seat2 && !a[R.second] && a[R.held] >= total) { a[R.second] = 1; a[R.held] = 0; say(c, 'plumb', 'plumb.comma.other'); }\n      else if (a[R.held] >= total) { go(run, 'rest'); say(c, 'plumb', 'plumb.rest'); }\n    } else if (run.phase === 'rest') {\n      pose(c, 0);\n      if (a[0] === 1) {\n        const ringShare = a[R.inRing] / Math.max(1, a[R.inAll]); const sync = a[R.syncSum] / Math.max(1, a[R.inAll]);\n        const s = 1000 * (ringShare * (1 - d.breathW) + sync * d.breathW) - 60 * (b.topples - a[R.tops0]);\n        a[R.sum] += clamp(s, 0, 1000); c.w.emit('pose', { id: d.id, score: Math.round(s) });\n      }\n      if (a[0] >= secs(1.5)) {\n        a[R.idx] += 1;\n        if (a[R.idx] >= 3) { run.score = a[R.sum] / 3; run.done = 1; const id = actorId(c.w, c.me.cast.who); if (id >= 0 && c.lead) clearPose(c.w, id); } else begin(c);\n      }\n    }\n  },\n  bot(c, bot: Bot) {\n    const { run, me } = c; const a = run.a; const d = defOf(c);\n    let px = 0, py = 0, breath = 0, foot = 0;\n    me.seat.act = run.phase === 'demo' && a[0] > 30;\n    if (run.phase === 'enter') [px, py] = guide(d, a[R.u]);\n    if (run.phase === 'hold') { [px, py] = seatNow(c, d); breath = d.foot === 3 ? 0 : 1; foot = d.foot; if (d.foot === 3) foot = 3; if (d.foot === 1 || d.foot === 2) breath = 0; }\n    botSeat(bot, me.wobble, me.seat, px, py, breath, foot);\n  },\n});\nexport const poseA = poseClass('poseA', 'Pose Class A');\nexport const poseB = poseClass('poseB', 'Pose Class B');\nexport const poseC = poseClass('poseC', 'Pose Class C');\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/index.ts'\nopen(p,'w').write('''/**\n * @file The activity registry: every activity module by id. Add a row here to add an activity.\n * @example\n * ACTIVITIES.morning.title; // 'Morning Check'\n */\nimport { morning } from './morning';\nimport { poseA, poseB, poseC } from './pose';\nimport type { Activity } from './types';\n\nexport const ACTIVITIES: Record<string, Activity> = { morning, poseA, poseB, poseC };\n''')\nEOF\ncat > labs/game/scenes/events/suite.ts <<'EOF'\n/**\n * @file The shared activity test: the four players on `seeds` seeds against the balance targets (perfect >= 750,\n * human-like >= 550, sloppy >= 300, idle <= 500 and below human-like), random mashing never throws, scores stay in\n * range with no NaN, and idle finishes on its own. Used by each activity's test file.\n * @example\n * await balanceReport('morning', 3); // { perfect, human, sloppy, idle } means\n */\nimport { expect } from 'vitest';\nimport { comp, playActivity } from '../testkit';\n\nexport async function balanceReport(id: string, seeds: number, short = false): Promise<Record<string, number>> {\n  const mean: Record<string, number> = {};\n  for (const kind of ['perfect', 'human', 'sloppy', 'idle']) {\n    let sum = 0;\n    for (let seed = 1; seed <= seeds; seed++) {\n      const r = await playActivity(id, kind === 'idle' ? 'idle' : kind, seed, { short });\n      expect(r.done, `${id} ${kind} seed ${seed} finishes`).toBe(true);\n      expect(Number.isFinite(r.score) && r.score >= 0 && r.score <= 1000).toBe(true);\n      sum += r.score;\n    }\n    mean[kind] = sum / seeds;\n  }\n  return mean;\n}\nexport function expectTargets(id: string, m: Record<string, number>, strict = true): void {\n  console.log('BAL', id, JSON.stringify(m, (_k, v) => (typeof v === 'number' ? Math.round(v) : v)));\n  if (!strict) return;\n  expect(m.perfect, `${id} perfect`).toBeGreaterThanOrEqual(750);\n  expect(m.human, `${id} human`).toBeGreaterThanOrEqual(550);\n  expect(m.sloppy, `${id} sloppy`).toBeGreaterThanOrEqual(300);\n  expect(m.idle, `${id} idle`).toBeLessThanOrEqual(500);\n  expect(m.idle, `${id} idle < human`).toBeLessThan(m.human);\n}\nexport async function mashSafe(id: string, seed = 3): Promise<void> {\n  const r = await playActivity(id, 'mash', seed);\n  expect(r.done).toBe(true);\n  expect(Number.isFinite(r.score)).toBe(true);\n  const ids = comp<{ ids: number[] }>(r.h, 'act');\n  expect(ids.length).toBeGreaterThan(0);\n}\nEOF\ncat > labs/game/scenes/events/pose.test.ts <<'EOF'\n/** @file Pose Class A, B and C meet the balance targets. */\nimport { describe, it } from 'vitest';\nimport { balanceReport, expectTargets, mashSafe } from './suite';\n\ndescribe('pose classes', () => {\n  for (const id of ['poseA', 'poseB', 'poseC']) {\n    it(id, async () => { expectTargets(id, await balanceReport(id, 3)); await mashSafe(id); }, 600000);\n  }\n});\nEOF\nnpx vitest run labs/game/scenes/events/pose.test.ts 2>&1 | grep -E \"BAL|Error|FAIL|passed|expected|✓|×\" | cut -c1-300","timeout":900000}},"wire_ingest_context":{"toolu_014KZ1Fngvc5MKZrDK4A4SsM":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-031600__x54facc/work/WellWobbled-WiiFit-claude-sonnet-5-5-medium-20261105-031600"}}}
