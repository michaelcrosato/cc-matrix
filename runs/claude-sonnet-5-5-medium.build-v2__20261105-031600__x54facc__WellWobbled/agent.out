harset=\"utf-8\" />', () => `<meta charset=\"utf-8\" />\\n<script>\\n${client}</script>\\n${tags}`));\nEOF\nOUT=../WellWobbled-WiiFit-claude-sonnet-5-5-medium-20261105-031600.html; time node labs/game/tools/onefile.mjs $OUT 2>&1 | tail -15; ls -la $OUT; grep -c \"aihub-session\" $OUT; grep -o \"<meta name=\\\"hub[^>]*>\" $OUT | head -3","timeout":400000}},"wire_ingest_context":{"toolu_01LRDD1kdFqUQrB5wLv7dzTm":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-031600__x54facc/work/WellWobbled-WiiFit-claude-sonnet-5-5-medium-20261105-031600"}}}
