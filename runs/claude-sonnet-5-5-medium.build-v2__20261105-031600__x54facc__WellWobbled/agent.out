{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CYM7CkmUCw1YXZMJ2u3Y7N","type":"tool_result","content":"341: * (`step`, `hash`, `state`, `set`…; `help()` lists them all), minus a renderer. With `view: true` it also builds the\n342- * scene's view, for `scene.dump()` and `camera`. Throws `CORE_NO_ENTRY` for an unknown scene id, `CORE_BAD_SETTING`\n343- * for a bad setting, `SIM_BAD_SEED` for a seed a replay cannot hold, and with a view `APP_NO_LEVEL` for a level not\n344- * registered.\n345- */\n346-export async function createHeadless<C extends object = AnyComponents, E extends EventMap = EventMap>(\n347-  options: HeadlessOptions<C, E>,\n348-): Promise<Headless> {\n349-  return createAppHost(options).inspector;\n350-}\n351-\n352-/** The run behind a headless engine: its session (world, settings, recording) and clock. Tools only. */\n353-export function headlessHost(headless: Headless): InspectorHost {\n354-  const host = hosts.get(headless);\n355-  if (!host) throw codeError('APP_NOT_HEADLESS', { value: typeof headless });\n356-  return host;\n357-}\nimport '../dev/actions'; // registers `__engine.actions` and `__engine.bot`","is_error":false}]},"parent_tool_use_id":null,"session_id":"e83c655a-6d0a-42b2-ac8e-79c6fd4e6b22","uuid":"47441c2d-b1f3-4a9a-8d86-31e06b9b730f","timestamp":"2026-11-05T10:35:59.309Z","tool_use_result":{"stdout":"341: * (`step`, `hash`, `state`, `set`…; `help()` lists them all), minus a renderer. With `view: true` it also builds the\n342- * scene's view, for `scene.dump()` and `camera`. Throws `CORE_NO_ENTRY` for an unknown scene id, `CORE_BAD_SETTING`\n343- * for a bad setting, `SIM_BAD_SEED` for a seed a replay cannot hold, and with a view `APP_NO_LEVEL` for a level not\n344- * registered.\n345- */\n346-export async function createHeadless<C extends object = AnyComponents, E extends EventMap = EventMap>(\n347-  options: HeadlessOptions<C, E>,\n348-): Promise<Headless> {\n349-  return createAppHost(options).inspector;\n350-}\n351-\n352-/** The run behind a headless engine: its session (world, settings, recording) and clock. Tools only. */\n353-export function headlessHost(headless: Headless): InspectorHost {\n354-  const host = hosts.get(headless);\n355-  if (!host) throw codeError('APP_NOT_HEADLESS', { value: typeof headless });\n356-  return host;\n357-}\nimport '../dev/actions'; // registers `__engine.actions` and `__engine.bot`","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01CYM7CkmUCw1YXZMJ2u3Y7N","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
