-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/art/clips.js\",\"matches\":[{\"line_number\":93,\"content\":\"export const CLIPS = [tree, heron, warrior, chair, fold, plank, squat, lunge, press, stepL, stepR];\"},{\"line_number\":95,\"content\":\"export const CLIP_BY_NAME = Object.fromEntries(CLIPS.map((c) => [c.name, c]));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/data/medley.js\",\"matches\":[{\"line_number\":2,\"content\":\"export const MEDLEY_SPAN = 185;\"},{\"line_number\":4,\"content\":\"export function medleyPicks(rand) {\"},{\"line_number\":15,\"content\":\"export function medleyWindow(t) {\"},{\"line_number\":24,\"content\":\"export const EVENT_NAMES = ['Stillness', 'Beat', 'Balance'];\"},{\"line_number\":26,\"content\":\"export function normalise(raw, max) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/data/week.js\",\"matches\":[{\"line_number\":2,\"content\":\"export const DAYS = [\"},{\"line_number\":62,\"content\":\"export function dayInfo(day) {\"},{\"line_number\":75,\"content\":\"export function isUnlocked(def, day, hard) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/tunables.js\",\"matches\":[{\"line_number\":4,\"content\":\"export const TUNABLE_TABS = {\"},{\"line_number\":43,\"content\":\"export function defaultTunables() {\"},{\"line_number\":51,\"content\":\"export const DEFAULT_TUNABLES = defaultTunables();\"},{\"line_number\":53,\"content\":\"export function cloneTunables(src = DEFAULT_TUNABLES) {\"},{\"line_number\":57,\"content\":\"export function tabKeys(name) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x