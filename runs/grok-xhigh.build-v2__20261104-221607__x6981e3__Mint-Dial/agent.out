{\"line_number\":141,\"content\":\"AIHub.connect({ mode, seats, card: true });\"},{\"line_number\":144,\"content\":\"The hub's card then steps aside when the game calls `ready()`, and the game's\"},{\"line_number\":229,\"content\":\"- `AIHub.fail(message)`: the game cannot run in this browser. From the host\"},{\"line_number\":309,\"content\":\"Everything on this page applies only in a session (`AIHub.active`). Outside\"},{\"line_number\":337,\"content\":\"- the tags, `connect()`, `ready()` with no key press, and the start;\"},{\"line_number\":376,\"content\":\"| `AIHub.active` | `true` in a session, from the first line |\"},{\"line_number\":377,\"content\":\"| `AIHub.connect({ mode, seats, card? })` | → `Promise<info \\\\| null>`; `null`: no hub. `card: true`: the game shows its own card |\"},{\"line_number\":378,\"content\":\"| `AIHub.ready()` | once, when the round can start |\"},{\"line_number\":388,\"content\":\"| `AIHub.fail(message)` | the game cannot run in this browser |\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-122ac9a4-4642-4871-900b-3edeca6303b4-52","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,49,54,48,55,95,95,120,54,57,56,49,101,51,47,119,111,114,107,34,62,10,70,111,117,110,100,32,49,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,49,54,48,55,95,95,120,54,57,56,49,101,51,47,119,111,114,107,47,77,105,110,116,32,68,105,97,108,45,87,105,105,32,70,105,116,45,