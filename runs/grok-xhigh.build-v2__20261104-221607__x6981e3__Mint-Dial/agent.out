gh-20261104-221607/GUIDE.md\",\"matches\":[{\"line_number\":64,\"content\":\"| `cameraTarget(ctx)` | every frame | return the `Vector3` the camera follows |\"},{\"line_number\":174,\"content\":\"  cameraTarget() {\"},{\"line_number\":421,\"content\":\"Players zoom with the wheel or + / -. `engine.setCamera(config, { syncUrl: false })` swaps\"},{\"line_number\":673,\"content\":\"  cameraTarget() {\"},{\"line_number\":845,\"content\":\"  cameraTarget() {\"},{\"line_number\":954,\"content\":\"  cameraTarget() {\"},{\"line_number\":996,\"content\":\"   `cameraTarget`): no garbage per frame.\"},{\"line_number\":1018,\"content\":\"| The camera doesn't follow | `cameraTarget` returns nothing before `setup` ends | return a fallback vector (see the quick start) |\"},{\"line_number\":1043,\"content\":\"e.setLook(e.lookPresets.noir); e.setCamera({ preset: 'third' }, { syncUrl: false });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/API.md\",\"matches\":[{\"line_number\":175,\"content\":\"- `setCamera(config: CameraConfig, options: { syncUrl?: boolean } = {}): CameraRig`: Swap the camera preset mid-game (review tool: presets are a per-game choice). The player, physics and the rest of the world are left exactly as they are. `free` and `fixed` without an explicit position start from the view currently on screen. Keeps `?camera=`…\"},{\"line_number\":278,\"content\":\"- `cameraTarget(ctx: GameContext): Vector3`: World position the camera follows.\"},{\"line_number\":279,\"content\":\"- `eyePosition?(ctx: GameContext): Vector3`: First-person eye position (defaults to cameraTarget + 0.7 up).\"},{\"line_number\":285,\"content\":\"- `onCameraChange?(ctx: GameContext): void`: Called after `engine.setCamera()` swapped the camera preset mid-game. The world, physics and player are untouched; adjust anything that depends on the preset (e.g. side-scroller lane lock, hiding the player model in first person).\"},{\"line_number\":573,\"content\":\"reviewing, `engine.setCamera()` swaps presets live without touching the world. `free`\"},{\"line_number\":1092,\"content\":\"- `setCamera(camera: Camera): void`: Point both passes at a different camera (camera preset hot-swap). The pipeline, canvas and all nodes stay the same; only the camera the scene is rendered with changes.\"},{\"line_number\":4384,\"content\":\"- `setCamera(camera: Camera): void`\"},{\"line_number\":5063,\"content\":\"- `setCamera(camera: Camera): void`\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/ASSETS.md\",\"matches\":[{\"line_number\":265,\"content\":\"  cameraTarget() {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/types/engine/camera.d.ts\",\"matches\":[{\"line_number\":6,\"content\":\" * reviewing, `engine.setCamera()` swaps presets live without touching the world. `free`\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/types/engine/render/view.d.ts\",\"matches\":[{\"line_number\":49,\"content\":\"    setCamera(camera: Camera): void;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/types/engine/Engine.d.ts\",\"matches\":[{\"line_number\":89,\"content\":\"    cameraTarget(ctx: GameContext): Vector3;\"},{\"line_number\":90,\"content\":\"    /** First-person eye position (defaults to cameraTarget + 0.7 up). */\"},{\"line_number\":119,\"content\":\"     * Called after `engine.setCamera()` swapped the camera preset mid-game. The world,\"},{\"line_number\":403,\"content\":\"    setCamera(config: CameraConfig, options?: {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/types/engine/render/headlessView.d.ts\",\"matches\":[{\"line_number\":69,\"content\":\"    setCamera(camera: Camera): void;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/types/engine/render/PixelRenderer.d.ts\",\"matches\":[{\"line_number\":172,\"content\":\"    setCamera(camera: Camera): void;\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-23652fa1-ce87-454d-b477-5aa71675a45d-51","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/** Designer data. A new pose or board is a row here, not a new system. */\\n\\nexport const POSES = [\\n  { id: 'tree', name: 'Apologetic Tree', station: 'pavilion', kind: 'still', clip: 'Tree', ring: 0.4, hold: 25, breath: 0, twist: 'none', unlock: 1, easy: true, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'heron', name: 'Startled Heron', station: 'pavilion', kind: 'still', clip: 'Heron', ring: 0.36, hold: 25, breath: 0, twist: 'bias', bias: 0.12, unlock: 1, easy: true, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'warrior', name: 'Reluctant Warrior', station: 'pavilion', kind: 'still', clip: 'Warrior', ring: 0.32, hold: 30, breath: 8, twist: 'ynoise', noise: 1.3, unlock: 2, easy: true, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'chair', name: 'The Chair Nobody Asked For', station: 'pavilion', kind: 'still', clip: 'Chair', ring: 0.3, hold: 30, breath: 8, twist: 'ramp', unlock: 3, easy: false, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'fold', name: 'Tax Season', station: 'pavilion', kind: 'still', clip: 'Fold', ring: 0.28, hold: 30, breath: 6, twist: 'bias', bias: 0.18, unlock: 4, easy: false, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'plank', name: 'Plank Negotiation', station: 'pavilion', kind: 'still', clip: 'Plank', ring: 0.24, hold: 35, breath: 6, twist: 'plank', unlock: 5, easy: false, song: 'still', thresholds: [45, 70, 90] },\\n10→];\\n\\nexport const REPS = [\\n  { id: 'squat', name: 'Squats of Regret', station: 'shed', kind: 'reps', clip: 'SquatRep', reps: 10, tempo: 3.2, axis: 'down', unlock: 1, easy: true, song: 'reps', thresholds: [55, 75, 90] },\\n  { id: 'lunge', name: 'Apology Lunges', station: 'shed', kind: 'reps', clip: 'LungeRep', reps: 10, tempo: 3.2, axis: 'side', unlock: 2, easy: true, song: 'reps', thresholds: [55, 75, 90] },\\n  { id: 'press', name: 'Overhead Mortgage', station: 'shed', kind: 'reps', clip: 'Press', reps: 8, tempo: 3.6, axis: 'up', lag: 1.5, unlock: 4, easy: false, song: 'reps', thresholds: [55, 75, 90] },\\n];\\n\\nexport const GAMES = [\\n  { id: 'hoop', name: 'Hoop Economics', station: 'beach', kind: 'hoop', unlock: 1, easy: true, song: 'hoop', thresholds: [35, 70, 110], play: 60 },\\n20→  { id: 'step', name: 'Step Class', station: 'beach', kind: 'step', unlock: 3, easy: true, song: 'step', thresholds: [55, 75, 90], play: 74 },\\n  { id: 'header', name: 'Coconut Header', station: 'lagoon', kind: 'header', unlock: 2, easy: true, song: 'lagoon', thresholds: [150, 400, 800], play: 60 },\\n  { id: 'slack', name: 'Slackline', station: 'lagoon', kind: 'slack', unlock: 3, easy: true, song: 'lagoon', thresholds: [1, 2, 3], play: 75 },\\n  { id: 'tray', name: 'Vitamin Tray', station: 'lagoon', kind: 'tray', unlock: 4, easy: true, song: 'lagoon', thresholds: [40, 60, 80], play: 60 },\\n  { id: 'jog', name: 'Island Jog', station: 'jog', kind: 'jog', unlock: 5, easy: true, song: 'jog', thresholds: [55, 75, 90], play: 75 },\\n  { id: 'pier', name: 'Pier Jump', station: 'lagoon', kind: 'pier', unlock: 5, easy: true, song: 'lagoon', thresholds: [18, 28, 38], play: 32 },\\n  { id: 'longstand', name: 'The Long Stand', station: 'plaza', kind: 'long', unlock: 7, easy: false, song: 'long', thresholds: [45, 70, 90], play: 90 },\\n];\\n\\nexport const ACTIVITIES = [...POSES, ...REPS, ...GAMES];\\n30→\\nexport const ACTIVITY_BY_ID = Object.fromEntries(ACTIVITIES.map((a) => [a.id, a]));\\n\\nexport const STATIONS = [\\n  { id: 'pavilion', name: 'Pavilion of Holding Still', place: [-11, 3] },\\n  { id: 'shed', name: 'The Rep Shed', place: [11, 3] },\\n  { id: 'beach', name: 'Beat Beach', place: [12, -10] },\\n  { id: 'lagoon', name: 'Lagoon Games', place: [-12, -10] },\\n  { id: 'jog', name: 'Jogging Path', place: [0, 11] },\\n  { id: 'plaza', name: 'The Plaza', place: [0, 3] },\\n40→];\\n\\nexport function activitiesAt(station) {\\n  return ACTIVITIES.filter((a) => a.station === station);\\n}\\n\\n/** Low, mid, high. Expert beats Dennis. Marguerite stays ahead of a sloppy day. */\\nexport const RIVALS = {\\n  dennis: 0.42,\\n  june: 0.78,\\n50→  marguerite: 0.97,\\n};\\n\\nexport function rivalScore(def, who) {\\n  const t = def.thresholds;\\n  const f = RIVALS[who] ?? 0.5;\\n  if (def.kind === 'slack') return who === 'dennis' ? 0 : who === 'june' ? 2 : 3;\\n  return Math.round(t[0] + (t[2] - t[0]) * f);\\n}\\n\",\"content_concise\":\"1→/** Designer data. A new pose or board is a row here, not a new system. */\\n\\nexport const POSES = [\\n  { id: 'tree', name: 'Apologetic Tree', station: 'pavilion', kind: 'still', clip: 'Tree', ring: 0.4, hold: 25, breath: 0, twist: 'none', unlock: 1, easy: true, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'heron', name: 'Startled Heron', station: 'pavilion', kind: 'still', clip: 'Heron', ring: 0.36, hold: 25, breath: 0, twist: 'bias', bias: 0.12, unlock: 1, easy: true, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'warrior', name: 'Reluctant Warrior', station: 'pavilion', kind: 'still', clip: 'Warrior', ring: 0.32, hold: 30, breath: 8, twist: 'ynoise', noise: 1.3, unlock: 2, easy: true, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'chair', name: 'The Chair Nobody Asked For', station: 'pavilion', kind: 'still', clip: 'Chair', ring: 0.3, hold: 30, breath: 8, twist: 'ramp', unlock: 3, easy: false, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'fold', name: 'Tax Season', station: 'pavilion', kind: 'still', clip: 'Fold', ring: 0.28, hold: 30, breath: 6, twist: 'bias', bias: 0.18, unlock: 4, easy: false, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'plank', name: 'Plank Negotiation', station: 'pavilion', kind: 'still', clip: 'Plank', ring: 0.24, hold: 35, breath: 6, twist: 'plank', unlock: 5, easy: false, song: 'still', thresholds: [45, 70, 90] },\\n10→];\\n\\nexport const REPS = [\\n  { id: 'squat', name: 'Squats of Regret', station: 'shed', kind: 'reps', clip: 'SquatRep', reps: 10, tempo: 3.2, axis: 'down', unlock: 1, easy: true, song: 'reps', thresholds: [55, 75, 90] },\\n  { id: 'lunge', name: 'Apology Lunges', station: 'shed', kind: 'reps', clip: 'LungeRep', reps: 10, tempo: 3.2, axis: 'side', unlock: 2, easy: true, song: 'reps', thresholds: [55, 75, 90] },\\n  { id: 'press', name: 'Overhead Mortgage', station: 'shed', kind: 'reps', clip: 'Press', reps: 8, tempo: 3.6, axis: 'up', lag: 1.5, unlock: 4, easy: false, song: 'reps', thresholds: [55, 75, 90] },\\n];\\n\\nexport const GAMES = [\\n  { id: 'hoop', name: 'Hoop Economics', station: 'beach', kind: 'hoop', unlock: 1, easy: true, song: 'hoop', thresholds: [35, 70, 110], play: 60 },\\n20→  { id: 'step', name: 'Step Class', station: 'beach', kind: 'step', unlock: 3, easy: true, song: 'step', thresholds: [55, 75, 90], play: 74 },\\n  { id: 'header', name: 'Coconut Header', station: 'lagoon', kind: 'header', unlock: 2, easy: true, song: 'lagoon', thresholds: [150, 400, 800], play: 60 },\\n  { id: 'slack', name: 'Slackline', station: 'lagoon', kind: 'slack', unlock: 3, easy: true, song: 'lagoon', thresholds: [1, 2, 3], play: 75 },\\n  { id: 'tray', name: 'Vitamin Tray', station: 'lagoon', kind: 'tray', unlock: 4, easy: true, song: 'lagoon', thresholds: [40, 60, 80], play: 60 },\\n  { id: 'jog', name: 'Island Jog', station: 'jog', kind: 'jog', unlock: 5, easy: true, song: 'jog', thresholds: [55, 75, 90], play: 75 },\\n  { id: 'pier', name: 'Pier Jump', station: 'lagoon', kind: 'pier', unlock: 5, easy: true, song: 'lagoon', thresholds: [18, 28, 38], play: 32 },\\n  { id: 'longstand', name: 'The Long Stand', station: 'plaza', kind: 'long', unlock: 7, easy: false, song: 'long', thresholds: [45, 70, 90], play: 90 },\\n];\\n\\nexport const ACTIVITIES = [...POSES, ...REPS, ...GAMES];\\n30→\\nexport const ACTIVITY_BY_ID = Object.fromEntries(ACTIVITIES.map((a) => [a.id, a]));\\n\\nexport const STATIONS = [\\n  { id: 'pavilion', name: 'Pavilion of Holding Still', place: [-11, 3] },\\n  { id: 'shed', name: 'The Rep Shed', place: [11, 3] },\\n  { id: 'beach', name: 'Beat Beach', place: [12, -10] },\\n  { id: 'lagoon', name: 'Lagoon Games', place: [-12, -10] },\\n  { id: 'jog', name: 'Jogging Path', place: [0, 11] },\\n  { id: 'plaza', name: 'The Plaza', place: [0, 3] },\\n40→];\\n\\nexport function activitiesAt(station) {\\n  return ACTIVITIES.filter((a) => a.station === station);\\n}\\n\\n/** Low, mid, high. Expert beats Dennis. Marguerite stays ahead of a sloppy day. */\\nexport const RIVALS = {\\n  dennis: 0.42,\\n  june: 0.78,\\n50→  marguerite: 0.97,\\n};\\n\\nexport function rivalScore(def, who) {\\n  const t = def.thresholds;\\n  const f = RIVALS[who] ?? 0.5;\\n  if (def.kind === 'slack') return who === 'dennis' ? 0 : who === 'june' ? 2 : 3;\\n  return Math.round(t[0] + (t[2] - t[0]) * f);\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/data/activities.js\",\"offset\":null,\"limit\":80,\"raw_output\":\"/** Designer data. A new pose or board is a row here, not a new system. */\\n\\nexport const POSES = [\\n  { id: 'tree', name: 'Apologetic Tree', station: 'pavilion', kind: 'still', clip: 'Tree', ring: 0.4, hold: 25, breath: 0, twist: 'none', unlock: 1, easy: true, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'heron', name: 'Startled Heron', station: 'pavilion', kind: 'still', clip: 'Heron', ring: 0.36, hold: 25, breath: 0, twist: 'bias', bias: 0.12, unlock: 1, easy: true, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'warrior', name: 'Reluctant Warrior', station: 'pavilion', kind: 'still', clip: 'Warrior', ring: 0.32, hold: 30, breath: 8, twist: 'ynoise', noise: 1.3, unlock: 2, easy: true, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'chair', name: 'The Chair Nobody Asked For', station: 'pavilion', kind: 'still', clip: 'Chair', ring: 0.3, hold: 30, breath: 8, twist: 'ramp', unlock: 3, easy: false, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'fold', name: 'Tax Season', station: 'pavilion', kind: 'still', clip: 'Fold', ring: 0.28, hold: 30, breath: 6, twist: 'bias', bias: 0.18, unlock: 4, easy: false, song: 'still', thresholds: [45, 70, 90] },\\n  { id: 'plank', name: 'Plank Negotiation', station: 'pavilion', kind: 'still', clip: 'Plank', ring: 0.24, hold: 35, breath: 6, twist: 'plank', unlock: 5, easy: false, song: 'still', thresholds: [45, 70, 90] },\\n];\\n\\nexport const REPS = [\\n  { id: 'squat', name: 'Squats of Regret', station: 'shed', kind: 'reps', clip: 'SquatRep', reps: 10, tempo: 3.2, axis: 'down', unlock: 1, easy: true, song: 'reps', thresholds: [55, 75, 90] },\\n  { id: 'lunge', name: 'Apology Lunges', station: 'shed', kind: 'reps', clip: 'LungeRep', reps: 10, tempo: 3.2, axis: 'side', unlock: 2, easy: true, song: 'reps', thresholds: [55, 75, 90] },\\n  { id: 'press', name: 'Overhead Mortgage', station: 'shed', kind: 'reps', clip: 'Press', reps: 8, tempo: 3.6, axis: 'up', lag: 1.5, unlock: 4, easy: false, song: 'reps', thresholds: [55, 75, 90] },\\n];\\n\\nexport const GAMES = [\\n  { id: 'hoop', name: 'Hoop Economics', station: 'beach', kind: 'hoop', unlock: 1, easy: true, song: 'hoop', thresholds: [35, 70, 110], play: 60 },\\n  { id: 'step', name: 'Step Class', station: 'beach', kind: 'step', unlock: 3, easy: true, song: 'step', thresholds: [55, 75, 90], play: 74 },\\n  { id: 'header', name: 'Coconut Header', station: 'lagoon', kind: 'header', unlock: 2, easy: true, song: 'lagoon', thresholds: [150, 400, 800], play: 60 },\\n  { id: 'slack', name: 'Slackline', station: 'lagoon', kind: 'slack', unlock: 3, easy: true, song: 'lagoon', thresholds: [1, 2, 3], play: 75 },\\n  { id: 'tray', name: 'Vitamin Tray', station: 'lagoon', kind: 'tray', unlock: 4, easy: true, song: 'lagoon', thresholds: [40, 60, 80], play: 60 },\\n  { id: 'jog', name: 'Island Jog', station: 'jog', kind: 'jog', unlock: 5, easy: true, song: 'jog', thresholds: [55, 75, 90], play: 75 },\\n  { id: 'pier', name: 'Pier Jump', station: 'lagoon', kind: 'pier', unlock: 5, easy: true, song: 'lagoon', thresholds: [18, 28, 38], play: 32 },\\n  { id: 'longstand', name: 'The Long Stand', station: 'plaza', kind: 'long', unlock: 7, easy: false, song: 'long', thresholds: [45, 70, 90], play: 90 },\\n];\\n\\nexport const ACTIVITIES = [...POSES, ...REPS, ...GAMES];\\n\\nexport const ACTIVITY_BY_ID = Object.fromEntries(ACTIVITIES.map((a) => [a.id, a]));\\n\\nexport const STATIONS = [\\n  { id: 'pavilion', name: 'Pavilion of Holding Still', place: [-11, 3] },\\n  { id: 'shed', name: 'The Rep Shed', place: [11, 3] },\\n  { id: 'beach', name: 'Beat Beach', place: [12, -10] },\\n  { id: 'lagoon', name: 'Lagoon Games', place: [-12, -10] },\\n  { id: 'jog', name: 'Jogging Path', place: [0, 11] },\\n  { id: 'plaza', name: 'The Plaza', place: [0, 3] },\\n];\\n\\nexport function activitiesAt(station) {\\n  return ACTIVITIES.filter((a) => a.station === station);\\n}\\n\\n/** Low, mid, high. Expert beats Dennis. Marguerite stays ahead of a sloppy day. */\\nexport const RIVALS = {\\n  dennis: 0.42,\\n  june: 0.78,\\n  marguerite: 0.97,\\n};\\n\\nexport function rivalScore(def, who) {\\n  const t = def.thresholds;\\n  const f = RIVALS[who] ?? 0.5;\\n  if (def.kind === 'slack') return who === 'dennis' ? 0 : who === 'june' ? 2 : 3;\\n  return Math.round(t[0] + (t[2] - t[0]) * f);\\n}\\n\",\"total_lines\":58}}","is_error":f