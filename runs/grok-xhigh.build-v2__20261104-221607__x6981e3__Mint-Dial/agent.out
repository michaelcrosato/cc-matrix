 * (this.def.lag || 1);\\n    if (u3.useRate) {\\n      let rate = u3.rate || 0;\\n      if (this.def.axis === \\\"up\\\") rate = -rate;\\n      const speed = 1 / (0.4 * tempo);\\n45760→      this.r = clamp(this.r + rate * speed * dt2, 0, 1);\\n    } else {\\n      const depth = this.depthOf(u3);\\n      const k3 = Math.min(1, dt2 / lag);\\n      this.r += (depth - this.r) * k3;\\n    }\\n    const amp = (this.T.repFatigue || 0) * (rep / this.total) ** 2;\\n    this.r = clamp(this.r + amp * Math.sin(40 * clock) * dt2 * 8, 0, 1);\\n    if (scoring && uRep < 0.9) {\\n      this.err += Math.abs(this.r - target);\\n45770→      this.n += 1;\\n    }\\n  }\\n  /** Stick down, stick sideways, or stick up. Depth alone is only the downward lean. */\\n  depthOf(u3) {\\n    const axis = this.def.axis || \\\"down\\\";\\n    if (axis === \\\"up\\\") return clamp(u3.y || 0, 0, 1);\\n    if (axis === \\\"side\\\") {\\n      const side = this.rep % 2 === 0 ? 1 : -1;\\n      if (Math.abs(u3.x || 0) > 1e-4) return clamp((u3.x || 0) * side, 0, 1);\\n45780→      return clamp(u3.depth || 0, 0, 1);\\n    }\\n    return clamp(Math.max(u3.depth || 0, -(u3.y || 0)), 0, 1);\\n  }\\n  scoreStars() {\\n    const mean = this.n ? this.err / this.n : 1;\\n    this.score = clamp(1 - 1.6 * mean, 0, 1) * 100;\\n    super.scoreStars();\\n  }\\n};\\n45790→var HoopSim = class extends Sim {\\n  _built() {\\n    this.angle = 0;\\n    this.omega = 0;\\n    this.L = 1;\\n    this.rot = 0;\\n    this.drop = 0;\\n    this.theta = 0;\\n    this.catches = 0;\\n    this.throwT = 6;\",\"content_concise\":\"45720→    return this.def.tempo / (this.T.repTempoScale || 1) * (this.hard ? 0.85 : 1);\\n  }\\n  playFinished() {\\n    return this.playT >= this.total * this.tempo();\\n  }\\n  auto(dt2) {\\n    const tempo = this.tempo();\\n    const uRep = this.playT > 0 ? this.playT % tempo / tempo : 0;\\n    const target = repTarget(uRep);\\n    const slope = repSlope(uRep) / tempo;\\n45730→    const lag = (this.T.repLag 