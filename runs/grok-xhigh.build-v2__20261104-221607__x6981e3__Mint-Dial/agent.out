 hardest part was trusting the frame clock. Game time, the press window, and the hub clock are three different clocks, and only one of them is allowed to move a score.',\\n  'None. pixel-engine.js is the kit file, byte for byte.',\\n  'I would give the music bus a default of silence until the game sets it, so a shared browser profile cannot leave yesterday volume on today game.',\\n];\\n\\nexport const PROMPT_FEEDBACK = [\\n  'The plan named the mechanics, the sentences, and the tests, so the work was building a game rather than inventing one.',\\n  'The cut list in the plan and the instruction to finish everything on this computer disagree. I followed the instruction and shipped the activities the cut list would drop.',\\n  'The hardest piece was the pier jump star line. The same bot that holds a pose will dive off a dock, and the flight begins wherever the dot was left.',\\n  'I would ask for the pause rule in one sentence: timeScale 0, fixedUpdate silent, update still reads keys. The guide and the type comment do not say the same thing.',\\n];\\n\\nexport const AI_HUB = {\\n  name: 'Mint Dial',\\n  tagline: 'Keep the dot in the circle.',\\n  description: 'A week on a small island with a polite scale. Hold still, keep time, and try not to believe the number.',\\n  type: 'Game',\\n  genre: 'Sports',\\n  source: 'Wii Fit',\\n  series: 'Wii Fit',\\n  players: '1–4',\\n  controls: 'Left stick, WASD or mouse: lean. R2, Space or click: breathe. L1/R1, F/J or mouse buttons: step.',\\n  tags: ['pixel art', 'comedy', 'versus', 'arcade', '3d', 'story'],\\n};\\n\\nexport const KIT_CREDITS = 'Kenney (CC0), three.js (MIT), Rapier (Apache-2.0), Sweetie 16.';\\n\\nexport function exitInterview() {\\n  return {\\n    sourceInformation: { ...SOURCE_INFORMATION },\\n    testingFeedback: [...TESTING_FEEDBACK],\\n    engineFeedback: [...ENGINE_FEEDBACK],\\n    promptFeedback: [...PROMPT_FEEDBACK],\\n    aiHub: { ...AI_HUB, tags: [...AI_HUB.tags] },\\n  };\\n}\\n\\n/** Pages for the in-game screen. Built only from the fields above. */\\nexport function aboutPages(creditsText) {\\n  const src = SOURCE_INFORMATION;\\n  const pages = [\\n    { title: 'A note', lines: [MEDICAL] },\\n    {\\n      title: 'Source Information',\\n      lines: [\\n        `Date: ${src.date}`,\\n        `Source: ${src.source}`,\\n        `Plan: ${src.plan}`,\\n        `Genre: ${src.genre}`,\\n        `Perspective: ${src.perspective}`,\\n        `Tech: ${src.tech}`,\\n        `Art Direction: ${src.artDirection}`,\\n        `Animation: ${src.animation}`,\\n        `Audio: ${src.audio}`,\\n        `Online: ${src.online}`,\\n        `Testing: ${src.testing}`,\\n        `Research: ${src.research}`,\\n        `Environment: ${src.environment}`,\\n        `Model: ${src.model}`,\\n        `Usage: ${src.usage}`,\\n      ],\\n    },\\n    { title: 'Testing Feedback', lines: TESTING_FEEDBACK.map((t, i) => `${i + 1}. ${t}`) },\\n    { title: 'Engine Feedback', lines: ENGINE_FEEDBACK.map((t, i) => `${i + 1}. ${t}`) },\\n    { title: 'Prompt Feedback', lines: PROMPT_FEEDBACK.map((t, i) => `${i + 1}. ${t}`) },\\n    { title: 'Kit credits', lines: [KIT_CREDITS, 'Kenney, three.js, Rapier, and Sweetie 16.'] },\\n  ];\\n  const full = String(creditsText || '').split(/\\\\r?\\\\n/);\\n  const size = 8;\\n  for (let i = 0; i < full.length; i += size) {\\n    pages.push({ title: i === 0 ? 'Credits' : 'Credits', lines: full.slice(i, i + size) });\\n  }\\n  return pages;\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa22-c3bd-7423-a5f1-ddadc552f469","uuid":"b95fc56c-e3e7-4dcc-a080-ac65533e8425"}
{"type":"assistant","message":{"id":"msg_124","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Now writing app.js carefully.","signature":"D2iQeAYDvXfNHZ1ISKVmR5lkflhpyucVr2elVMHLbVYZ+eNed0KdwjisBOnJyfWGoCz8DSab39qYZzZPJQewGayYiX4xuw4DhYJe/fpa"},{"type":"tool_use","id":"call-d12c6a40-f3a8-45c4-bf39-1abdf194ee29-77","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/app.js","new_string":"import { TITLE } from './data/title.js';\nimport { ACTIVITIES, ACTIVITY_BY_ID, STATIONS, activitiesAt, rivalScore } from './data/activities.js';\nimport { dayInfo, isUnlocked } from './data/week.js';\nimport { questionFor } from './data/questions.js';\nimport { medleyPicks, medleyWindow, normalise, MEDLEY_SPAN } from './data/medley.js';\nimport { lineText } from './data/lines.js';\nimport { LOOK_CHOICES, PLAYER_LOOK } from './art/avatar.js';\nimport { SONGS, SONG_FOR } from './audio/songs.js';\nimport { dripsFor, milestonesReached, wobbleAge } from './core/score.js';\nimport { Save } from './core/save.js';\nimport { cloneTunables, DEFAULT_TUNABLES, TUNABLE_TABS, tabKeys } from './core/tunables.js';\nimport { Device } from './core/device.js';\nimport { promptFor, glyphKind } from './core/actions.js';\nimport { LocalDriver, PadDriver, GhostDriver } from './core/drivers.js';\nimport { createSim } from './core/sims.js';\nimport { Dot } from './core/dot.js';\nimport { mulberry32, hashString } from './core/rng.js';\n\nconst MENU_IDLE = new Set([\n  'title', 'menu', 'slots', 'name', 'settings', 'about', 'howto', 'dropin',\n  'station', 'ferry', 'join', 'results', 'reveal', 'question', 'report',\n  'locker', 'hall', 'jar', 'credits', 'confession', 'podium',\n]);\nconst PAUSABLE = new Set(['activity', 'weigh', 'island', 'medley']);\nconst PRESS = ['Enter', 'Space', 'PadCross', 'MouseLeft'];\nconst BACK = ['Escape', 'Backspace', 'PadCircle', 'MouseRight'];\nconst DOWN = ['ArrowDown', 'PadDown'];\nconst UP = ['ArrowUp', 'PadUp'];\nconst LEFT = ['ArrowLeft', 'PadLeft'];\nconst RIGHT = ['ArrowRight', 'PadRight'];\nconst ANY = [...PRESS, ...BACK, ...DOWN, ...UP, ...LEFT, ...RIGHT, 'KeyP', 'KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyQ', 'KeyF', 'KeyJ', 'KeyM', 'PadOptions', 'PadTriangle', 'PadL1', 'PadR1'];\nconst ATTRACT = ['tree', 'hoop', 'header', 'step', 'slack', 'tray', 'pier', 'jog', 'squat', 'longstand'];\nconst DEV_TOOLS = [\n  ['day', 'Go to day'],\n  ['jump', 'Jump activity'],\n  ['finish', 'Finish stars'],\n  ['drips', 'Give 50 drips'],\n  ['unlock', 'Unlock all'],\n  ['auto', 'Autopilot'],\n  ['god', 'God mode'],\n  ['time', 'Time scale'],\n  ['overlay', 'Overlay'],\n  ['hud', 'Hide HUD'],\n  ['camera', 'Free camera'],\n  ['line', 'Dialogue line'],\n  ['sound', 'Sound test'],\n  ['anim', 'Anim viewer'],\n  ['wipe', 'Reset save'],\n  ['export', 'Export JSON'],\n];\nconst SCALES = [0.25, 0.5, 1, 2, 3];\nconst SKILLS = [null, 'idle', 'sloppy', 'average', 'good', 'expert'];\nconst LOOKS = ['default', 'storybook', 'arcade', 'handheld'];\n\nfunction emptyToday() {\n  return { plays: 0, ids: [], bestStar: 0, beat: {}, fresh: false };\n}\n\nexport function freshGuest(name = 'Guest') {\n  return {\n    name: String(name || 'Guest').slice(0, 8) || 'Guest',\n    look: { ...PLAYER_LOOK },\n    day: 1,\n    week: 1,\n    drips: 0,\n    totalStars: 0,\n    samples: [],\n    chart: [],\n    confessed: false,\n    ferried: false,\n    records: {},\n    items: [],\n    today: emptyToday(),\n    place: 'pavilion',\n    felt: '',\n    hard: false,\n    unlockAll: false,\n  };\n}\n\nfunction beats(def, score, stars, who) {\n  const rival = rivalScore(def, who);\n  if (def.kind === 'slack') return stars > rival;\n  return score > rival;\n}\n\nexport class App {\n  constructor(opts = {}) {\n    this.title = TITLE;\n    this.save = new Save(opts.storage === undefined ? undefined : opts.storage);\n    const disk = this.save.read();\n    this.tunables = cloneTunables();\n    this.settings = {\n      music: 0.1,\n      sfx: 1,\n      voice: 1,\n      master: 1,\n      glyphs: 'playstation',\n      gentle: false,\n      flashes: false,\n      look: 'default',\n      pixel: 'fine',\n    };\n    if (disk.settings) Object.assign(this.settings, disk.settings);\n    if (!disk.settings) this.settings.music = 0.1;\n    this.session = opts.session || null;\n    this.touchOnly = !!opts.touchOnly;\n    this.mode = this.session ? 'card' : 'title';\n    this.device = new Device();\n    this.local = new LocalDriver();\n    this.driver = null;\n    this.god = false;\n    this.hideHud = false;\n    this.overlay = false;\n    this.focus = 0;\n    this.rows = [];\n    this.idle = 0;\n    this.widgets = [];\n    this.slot = 0;\n    this.guest = null;\n    this.nameBuf = 'Guest';\n    this.drop = false;\n    this.sim = null;\n    this.weigh = null;\n    this.activityId = '';\n    this.station = 'pavilion';\n    this.islandPage = 0;\n    this.returnMode = 'title';\n    this.frozen = false;\n    this.devTab = 0;\n    this.devPage = 0;\n    this.toolPage = 0;\n    this.finishPick = 0;\n    this.timePick = 0;\n    this.skillPick = 0;\n    this.jumpPick = 0;\n    this.soundPick = 0;\n    this.animPick = 0;\n    this.linePick = 0;\n    this.aboutPage = 0;\n    this.creditPage = 0;\n    this.question = null;\n    this.answer = 0;\n    this.lastStars = 0;\n    this.lastScore = 0;\n    this.lastSeconds = 0;\n    this.lastDrips = 0;\n    this.lastPrescription = false;\n    this.spoken = '';\n    this.songPlaying = '';\n    this.attracting = false;\n    this.attractI = 0;\n    this.attractT = 0;\n    this.forkN = 0;\n    this.ctx = null;\n    this.engine = null;\n    this.lanes = [];\n    this.seats = [null, null, null, null];\n    this.prevPad = [false, false, false, false];\n    this.medleyT = 0;\n    this.picks = null;\n    this.hub = null;\n    this.hubLive = false;\n    this.hubEnded = false;\n    this.resultSent = false;\n    this.hubScore = 0;\n    this.card = null;\n    this.leftIds = new Set();\n    this.viewerClip = '';\n    this.dialogue = '';\n    this.exported = '';\n    this.dropRecords = {};\n    this.held = new Set();\n    this.busMusic = 0.1;\n    this.refresh(true);\n  }\n\n  fork(label) {\n    this.forkN += 1;\n    const id = `${label}:${this.forkN}`;\n    if (this.ctx?.random) {\n      const rng = this.ctx.random.fork(id);\n      return () => rng.next();\n    }\n    return mulberry32(hashString(id) || 1);\n  }\n\n  go(mode, arg) {\n    if (mode === 'activity') {\n      this.startActivity(typeof arg === 'string' ? arg : arg?.id);\n      return;\n    }\n    if (mode === 'medley') {\n      this.openMedley(arg || {});\n      return;\n    }\n    this.mode = mode;\n    if (mode === 'title') {\n      this.attracting = false;\n      this.drop = false;\n      this.idle = 0;\n    }\n    if (mode === 'island') this.islandPage = 0;\n    if (mode === 'name') this.focus = 0;\n    this.refresh(mode !== 'dev');\n  }\n\n  setDriver(skill) {\n    this.driver = skill || null;\n    this.skillPick = Math.max(0, SKILLS.indexOf(this.driver));\n    if (this.sim?.setSkill && this.driver) this.sim.setSkill(this.driver);\n  }\n\n  refresh(resetFocus = false) {\n    this.rows = this.rowsFor().slice(0, 8);\n    if (resetFocus) this.focus = 0;\n    if (this.focus >= this.rows.length) this.focus = Math.max(0, this.rows.length - 1);\n  }\n\n  rowsFor() {\n    const g = this.guest;\n    switch (this.mode) {\n      case 'title':\n        return [{ id: 'start', label: 'Start' }];\n      case 'menu':\n        return [\n          { id: 'week', label: 'Week' },\n          { id: 'dropin', label: 'Drop-In' },\n          { id: 'family', label: 'Family Hour' },\n          { id: 'settings', label: 'Settings' },\n          { id: 'about', label: 'About' },\n        ];\n      case 'slots':\n        return [0, 1, 2].map((i) => {\n          const slot = this.save.read().slots[i];\n          return { id: `slot${i}`, label: slot ? `Guest ${i + 1}: ${slot.name}` : `Guest ${i + 1}: empty` };\n        }).concat([{ id: 'back', label: 'Back' }]);\n      case 'name':\n        return [{ id: 'done', label: `Done (${this.nameBuf || 'Guest'})` }];\n      case 'ferry':\n        return [{ id: 'board', label: 'Board' }];\n      case 'question':\n        return (this.question?.answers || []).map((label, i) => ({ id: `a${i}`, label }));\n      case 'reveal':\n        return [{ id: 'onward', label: 'Onward' }];\n      case 'island':\n        return this.islandRows();\n      case 'station':\n        return this.stationRows();\n      case 'results':\n        return [\n          { id: 'retry', label: 'Retry' },\n          { id: 'next', label: 'Next' },\n          { id: 'back', label: 'Island' },\n        ];\n      case 'hammock':\n        return [{ id: 'rest', label: 'Rest' }];\n      case 'report':\n        return [{ id: 'sleep', label: 'Sleep' }];\n      case 'confession':\n        return [{ id: 'onward', label: 'Onward' }];\n      case 'credits':\n        return [{ id: 'onward', label: 'Onward' }];\n      case 'settings':\n        return this.settingsRows();\n      case 'about':\n      case 'howto':\n        return [{ id: 'back', label: 'Back' }];\n      case 'pause':\n        return this.session\n          ? [{ id: 'resume', label: 'Resume' }, { id: 'settings', label: 'Settings' }]\n          : [\n            { id: 'resume', label: 'Resume' },\n            { id: 'restart', label: 'Restart' },\n            { id: 'island', label: 'Island' },\n            { id: 'settings', label: 'Settings' },\n            { id: 'howto', label: 'How to play' },\n            { id: 'about', label: 'About' },\n            { id: 'dev', label: 'Dev Tools' },\n          ];\n      case 'dev':\n        return this.devRows();\n      case 'join':\n        return [\n          { id: 'fill', label: 'Fill with classmates' },\n          { id: 'start', label: 'Start' },\n          { id: 'back', label: 'Back' },\n        ];\n      case 'podium':\n        return [{ id: 'again', label: 'Rematch' }, { id: 'back', label: 'Back' }];\n      case 'locker':\n        return [\n          { id: 'skin', label: `Skin ${g?.look?.skin || ''}` },\n          { id: 'hair', label: `Hair ${g?.look?.hair || ''}` },\n          { id: 'top', label: `Top ${g?.look?.top || ''}` },\n          { id: 'bottom', label: `Bottom ${g?.look?.bottom || ''}` },\n          { id: 'headband', label: `Band ${g?.look?.headband || ''}` },\n          { id: 'back', label: 'Back' },\n        ];\n      case 'hall':\n      case 'jar':\n        return [{ id: 'back', label: 'Back' }];\n      case 'dropin':\n        return [{ id: 'play', label: 'Play' }, { id: 'back', label: 'Back' }];\n      default:\n        return [];\n    }\n  }\n\n  islandRows() {\n    if (this.islandPage === 0) {\n      return [\n        ...STATIONS.map((s) => ({ id: `st-${s.id}`, label: s.name.replace(' of Holding Still', '').replace('The ', '').replace('Jogging Path', 'Jog') })),\n        { id: 'more', label: 'More' },\n      ];\n    }\n    const rows = [\n      { id: 'jar', label: 'Sweat Jar' },\n      { id: 'locker', label: 'Locker' },\n      { id: 'hall', label: 'Hall' },\n      { id: 'hammock', label: 'Hammock' },\n    ];\n    if (this.isOpen(ACTIVITY_BY_ID.longstand)) rows.push({ id: 'longstand', label: 'Long Stand' });\n    rows.push({ id: 'back', label: 'Back' });\n    return rows;\n  }\n\n  stationRows() {\n    const rows = activitiesAt(this.station).filter((a) => this.isOpen(a)).map((a) => ({ id: `act-${a.id}`, label: a.name }));\n    if ((this.guest && (this.guest.day >= 6 || this.guest.unlockAll)) || this.drop) {\n      rows.push({ id: 'hard', label: this.guest?.hard ? 'Hard: on' : 'Hard: off' });\n    }\n    rows.push({ id: 'back', label: 'Back' });\n    return rows.slice(0, 8);\n  }\n\n  settingsRows() {\n    const s = this.settings;\n    if ((this.setPage || 0) === 0) {\n      return [\n        { id: 'music', label: `Music ${Math.round(s.music * 100)}` },\n        { id: 'sfx', label: `SFX ${Math.round(s.sfx * 100)}` },\n        { id: 'voice', label: `Voice ${Math.round(s.voice * 100)}` },\n        { id: 'glyphs', label: s.glyphs === 'xbox' ? 'Glyphs: Xbox' : 'Glyphs: PlayStation' },\n        { id: 'gentle', label: s.gentle ? 'Gentle: on' : 'Gentle: off' },\n        { id: 'more', label: 'More' },\n      ];\n    }\n    return [\n      { id: 'radius', label: `Mouse radius ${this.tunables.mouseLeanRadius}` },\n      { id: 'offset', label: `Step offset ${this.tunables.stepOffsetMs}` },\n      { id: 'flashes', label: s.flashes ? 'Flashes: low' : 'Flashes: on' },\n      { id: 'look', label: `Look ${s.look}` },\n      { id: 'pixel', label: `Pixels ${s.pixel}` },\n      { id: 'full', label: 'Fullscreen' },\n      { id: 'reset', label: 'Reset' },\n      { id: 'back', label: 'Back' },\n    ];\n  }\n\n  devTabName() {\n    return [...Object.keys(TUNABLE_TABS), 'Tools'][this.devTab] || 'Balance';\n  }\n\n  devRows() {\n    const tab = this.devTabName();\n    if (tab === 'Tools') {\n      const start = this.toolPage * 5;\n      const slice = DEV_TOOLS.slice(start, start + 5).map(([id, label]) => ({ id, label: this.toolLabel(id, label) }));\n      const rows = slice;\n      if (start + 5 < DEV_TOOLS.length) rows.push({ id: 'more', label: 'More' });\n      else if (this.toolPage > 0) rows.push({ id: 'prev', label: 'Previous' });\n      rows.push({ id: 'back', label: 'Back' });\n      return rows;\n    }\n    const keys = tabKeys(tab);\n    const start = this.devPage * 5;\n    const rows = keys.slice(start, start + 5).map((key) => ({ id: key, label: `${key} ${this.fmt(this.tunables[key])}` }));\n    if (start + 5 < keys.length) rows.push({ id: 'more', label: 'More' });\n    else if (this.devPage > 0) rows.push({ id: 'prev', label: 'Previous' });\n    rows.push({ id: 'reset-tab', label: 'Reset tab' });\n    rows.push({ id: 'reset-all', label: 'Reset all' });\n    return rows;\n  }\n\n  toolLabel(id, label) {\n    if (id === 'day') return `Day ${this.guest?.day || 1}`;\n    if (id === 'jump') return `Jump ${ACTIVITIES[this.jumpPick]?.name || ''}`;\n    if (id === 'finish') return `Finish ${this.finishPick} stars`;\n    if (id === 'auto') return `Autopilot ${this.driver || 'off'}`;\n    if (id === 'god') return this.god ? 'God: on' : 'God: off';\n    if (id === 'time') return `Time ${this.engine?.timeScale ?? 0}`;\n    if (id === 'overlay') return this.overlay ? 'Overlay: on' : 'Overlay: off';\n    if (id === 'hud') return this.hideHud ? 'HUD: hidden' : 'HUD: shown';\n    if (id === 'anim') return `Anim ${this.viewerClip || 'idle'}`;\n    return label;\n  }\n\n  fmt(n) {\n    const v = Math.round(n * 1000) / 1000;\n    return String(v);\n  }\n\n  isOpen(def) {\n    if (!def) return false;\n    if (this.drop || this.guest?.unlockAll) return true;\n    if (!this.guest) return false;\n    return isUnlocked(def, this.guest.day, false);\n  }\n\n  startActivity(id) {\n    const def = ACTIVITY_BY_ID[id];\n    if (!def) return;\n    const bot = !!this.driver;\n    this.activityId = id;\n    this.sim = createSim(id, {\n      tunables: this.tunables,\n      rand: this.fork(`act-${id}`),\n      botRand: this.fork(`bot-${id}`),\n      skill: this.driver || 'idle',\n      hard: !!this.guest?.hard,\n      gentle: !!this.settings.gentle,\n      god: !!this.god || this.attracting,\n      first: bot ? false : !(this.guest?.records?.[id]?.plays),\n      practice: bot ? false : undefined,\n      skipIntro: bot || this.attracting,\n    });\n    this.mode = 'activity';\n    this.frozen = false;\n    if (this.engine && this.engine.timeScale === 0) this.engine.timeScale = 1;\n    this.refresh(true);\n  }\n\n  startWeigh() {\n    const kind = dayInfo(this.guest?.day || 1).test;\n    const { WeighSim } = weighCtor();\n    this.weigh = new WeighSim(kind, {\n      tunables: this.tunables,\n      rand: this.fork('weigh'),\n      botRand: this.fork('weigh-bot'),\n      skill: this.driver || 'idle',\n    });\n    this.mode = 'weigh';\n    this.sim = null;\n  }\n\n  prescriptionNow() {\n    const g = this.guest;\n    if (!g || this.drop) return false;\n    const goal = dayInfo(g.day).goal;\n    const t = g.today;\n    if (!goal || !t) return false;\n    if (goal.kind === 'pair') return t.ids.includes(goal.id) && t.ids.length >= 2;\n    if (goal.kind === 'stars') return t.bestStar >= goal.n;\n    if (goal.kind === 'fresh') return !!t.fresh;\n    if (goal.kind === 'count') return t.plays >= goal.n;\n    if (goal.kind === 'beat') return !!t.beat?.[goal.who];\n    if (goal.kind === 'id') return t.ids.includes(goal.id);\n    return false;\n  }\n\n  finishActivity() {\n    const sim = this.sim;\n    if (!sim) return;\n    if (!sim.done) sim.finish();\n    const stars = sim.stars | 0;\n    const seconds = sim.seconds || sim.playT || 0;\n    const score = sim.score || 0;\n    const id = sim.def.id;\n    this.lastStars = stars;\n    this.lastScore = score;\n    this.lastSeconds = seconds;\n    const before = this.prescriptionNow();\n    if (this.guest && !this.drop) {\n      const t = this.guest.today;\n      t.plays += 1;\n      if (!t.ids.includes(id)) t.ids.push(id);\n      t.bestStar = Math.max(t.bestStar, stars);\n      const rec = this.guest.records[id] || { bestStars: 0, bestScore: 0, plays: 0 };\n      rec.plays += 1;\n      rec.bestStars = Math.max(rec.bestStars, stars);\n      rec.bestScore = Math.max(rec.bestScore, score);\n      this.guest.records[id] = rec;\n      if (rec.plays === 1) t.fresh = true;\n      for (const who of ['dennis', 'june', 'marguerite']) {\n        if (beats(sim.def, score, stars, who)) t.beat[who] = true;\n      }\n      this.guest.totalStars += stars;\n      const bonus = !before && this.prescriptionNow();\n      const drips = dripsFor(stars, seconds, bonus, this.tunables.dripRate);\n      this.guest.drips += drips;\n      this.lastDrips = drips;\n      this.lastPrescription = bonus;\n      this.guest.items = milestonesReached(this.guest.drips).map((item) => item.id);\n      this.persist();\n    } else {\n      const rec = this.dropRecords[id] || { bestStars: 0, plays: 0 };\n      rec.plays += 1;\n      rec.bestStars = Math.max(rec.bestStars, stars);\n      this.dropRecords[id] = rec;\n      this.lastDrips = 0;\n      this.lastPrescription = false;\n    }\n    this.mode = 'results';\n    this.dialogue = lineText(id, stars, (this.guest?.records?.[id]?.plays || 0) > 1);\n    this.refresh(true);\n  }\n\n  finishWeigh() {\n    const T = this.weigh?.Tscore || 0;\n    if (this.guest && !this.drop) {\n      this.guest.samples.push(T);\n      const trueAge = wobbleAge(this.guest.samples, this.guest.totalStars, this.tunables.ageTrainingWeight);\n      const shown = this.guest.confessed ? trueAge : trueAge + 7;\n      this.guest.chart.push({ day: this.guest.day, t: T, trueAge, shown });\n      this.persist();\n    }\n    this.question = questionFor(this.guest?.day || 1);\n    this.mode = 'question';\n    this.refresh(true);\n  }\n\n  confess() {\n    const g = this.guest;\n    if (!g || g.confessed) return;\n    for (const point of g.chart) point.shown -= 7;\n    g.confessed = true;\n    this.persist();\n  }\n\n  nextDay() {\n    const g = this.guest;\n    if (!g) return;\n    g.day += 1;\n    g.week = g.day >= 8 ? 2 : 1;\n    g.today = emptyToday();\n    this.persist();\n    this.startWeigh();\n  }\n\n  persist() {\n    if (this.session) return;\n    const data = this.save.read();\n    if (this.guest && this.slot != null && !this.drop) data.slots[this.slot] = this.guest;\n    data.settings = { ...this.settings };\n    this.save.write(data);\n  }\n\n  activate(id) {\n    if (this.mode === 'title' && id === 'start') {\n      if (this.touchOnly) return;\n      this.mode = 'menu';\n      this.refresh(true);\n      return;\n    }\n    if (this.mode === 'menu') {\n      if (id === 'week') { this.drop = false; this.mode = 'slots'; }\n      else if (id === 'dropin') { this.drop = true; this.guest = freshGuest('Drop In'); this.guest.unlockAll = true; this.mode = 'island'; }\n      else if (id === 'family') { this.seats = [null, null, null, null]; this.mode = 'join'; }\n      else if (id === 'settings') { this.setPage = 0; this.mode = 'settings'; }\n      else if (id === 'about') { this.aboutPage = 0; this.mode = 'about'; }\n      this.refresh(true);\n      return;\n    }\n    if (this.mode === 'slots') {\n      if (id === 'back') { this.mode = 'menu'; this.refresh(true); return; }\n      const index = Number(id.replace('slot', ''));\n      this.slot = index;\n      const existing = this.save.read().slots[index];\n      if (existing) {\n        this.guest = existing;\n        this.guest.today = this.guest.today || emptyToday();\n        if (!this.guest.ferried) this.mode = 'ferry';\n        else this.startWeigh();\n      } else {\n        this.nameBuf = 'Guest';\n        this.guest = null;\n        this.mode = 'name';\n      }\n      this.refresh(true);\n      return;\n    }\n    if (this.mode === 'name' && id === 'done') {\n      this.guest = freshGuest(this.nameBuf || 'Guest');\n      this.persist();\n      this.mode = 'ferry';\n      this.refresh(true);\n      return;\n    }\n    if (this.mode === 'ferry' && id === 'board') {\n      this.guest.ferried = true;\n      this.persist();\n      this.startWeigh();\n      return;\n    }\n    if (this.mode === 'question' && id.startsWith('a')) {\n      this.answer = Number(id.slice(1));\n      if (this.guest) this.guest.felt = this.question?.remarks?.[this.answer] || '';\n      this.mode = 'reveal';\n      this.refresh(true);\n      return;\n    }\n    if (this.mode === 'reveal') { this.mode = 'island'; this.islandPage = 0; this.refresh(true); return; }\n    if (this.mode === 'island') return this.activateIsland(id);\n    if (this.mode === 'station') return this.activateStation(id);\n    if (this.mode === 'results') {\n      if (id === 'retry') this.startActivity(this.activityId);\n      else if (id === 'next') { this.mode = 'station'; this.refresh(true); }\n      else { this.mode = 'island'; this.refresh(true); }\n      return;\n    }\n    if (this.mode === 'hammock' && id === 'rest') { this.mode = 'report'; this.refresh(true); return; }\n    if (this.mode === 'report' && id === 'sleep') {\n      const playedLong = this.guest?.today?.ids?.includes('longstand');\n      if (this.guest?.day === 7 && playedLong && !this.guest.confessed) {\n        this.mode = 'confession';\n        this.refresh(true);\n      } else this.nextDay();\n      return;\n    }\n    if (this.mode === 'confession') { this.confess(); this.mode = 'credits'; this.refresh(true); return; }\n    if (this.mode === 'credits') { this.nextDay(); return; }\n    if (this.mode === 'settings') return this.activateSettings(id);\n    if ((this.mode === 'about' || this.mode === 'howto' || this.mode === 'hall' || this.mode === 'jar' || this.mode === 'locker') && id === 'back') {\n      this.mode = this.frozen ? 'pause' : 'island';\n      if (this.mode === 'island' && !this.guest) this.mode = 'menu';\n      this.refresh(true);\n      return;\n    }\n    if (this.mode === 'locker') return this.cycleLook(id);\n    if (this.mode === 'pause') return this.activatePause(id);\n    if (this.mode === 'dev') return this.activateDev(id);\n    if (this.mode === 'join') return this.activateJoin(id);\n    if (this.mode === 'podium') {\n      if (id === 'again') this.openMedley({ family: true });\n      else { this.mode = 'menu'; this.refresh(true); }\n      return;\n    }\n    if (this.mode === 'dropin' && id === 'play') { this.mode = 'island'; this.refresh(true); }\n  }\n\n  activateIsland(id) {\n    if (id === 'more') { this.islandPage = 1; this.refresh(true); return; }\n    if (id === 'back') { this.islandPage = 0; this.refresh(true); return; }\n    if (id === 'hammock') { this.mode = 'hammock'; this.refresh(true); return; }\n    if (id === 'jar') { this.mode = 'jar'; this.refresh(true); return; }\n    if (id === 'locker') { this.mode = 'locker'; this.refresh(true); return; }\n    if (id === 'hall') { this.mode = 'hall'; this.refresh(true); return; }\n    if (id === 'longstand') { this.startActivity('longstand'); return; }\n    if (id.startsWith('st-')) {\n      this.station = id.slice(3);\n      this.mode = 'station';\n      this.refresh(true);\n    }\n  }\n\n  activateStation(id) {\n    if (id === 'back') { this.mode = 'island'; this.refresh(true); return; }\n    if (id === 'hard') {\n      if (this.guest) this.guest.hard = !this.guest.hard;\n      this.refresh(false);\n      return;\n    }\n    if (id.startsWith('act-')) this.startActivity(id.slice(4));\n  }\n\n  activateSettings(id) {\n    const s = this.settings;\n    if (id === 'more') { this.setPage = 1; this.refresh(true); return; }\n    if (id === 'back') {\n      this.persist();\n      this.mode = this.frozen ? 'pause' : 'menu';\n      this.refresh(true);\n      return;\n    }\n    if (id === 'glyphs') s.glyphs = s.glyphs === 'xbox' ? 'playstation' : 'xbox';\n    if (id === 'gentle') s.gentle = !s.gentle;\n    if (id === 'flashes') s.flashes = !s.flashes;\n    if (id === 'look') {\n      const i = LOOKS.indexOf(s.look);\n      s.look = LOOKS[(i + 1) % LOOKS.length];\n      this.applyLook();\n    }\n    if (id === 'pixel') {\n      s.pixel = s.pixel === 'chunky' ? 'fine' : 'chunky';\n      try { this.engine?.settings?.set?.({ pixelSize: s.pixel }); } catch { /* headless */ }\n    }\n    if (id === 'full') this.fullscreen();\n    if (id === 'reset') this.resetSettings();\n    this.persist();\n    this.refresh(false);\n  }\n\n  nudgeSetting(id, dir) {\n    const s = this.settings;\n    if (id === 'music') s.music = clamp01(s.music + dir * 0.05);\n    if (id === 'sfx') s.sfx = clamp01(s.sfx + dir * 0.05);\n    if (id === 'voice') s.voice = clamp01(s.voice + dir * 0.05);\n    if (id === 'radius') this.tunables.mouseLeanRadius = clamp(this.tunables.mouseLeanRadius + dir * 2, 20, 160);\n    if (id === 'offset') this.tunables.stepOffsetMs = clamp(this.tunables.stepOffsetMs + dir * 5, -80, 80);\n    this.applyVolumes();\n    this.refresh(false);\n  }\n\n  resetSettings() {\n    this.settings.music = 0.1;\n    this.settings.sfx = 1;\n    this.settings.voice = 1;\n    this.settings.master = 1;\n    this.settings.glyphs = 'playstation';\n    this.settings.gentle = false;\n    this.settings.flashes = false;\n    this.settings.look = 'default';\n    this.settings.pixel = 'fine';\n    this.tunables.mouseLeanRadius = DEFAULT_TUNABLES.mouseLeanRadius;\n    this.tunables.stepOffsetMs = DEFAULT_TUNABLES.stepOffsetMs;\n    this.applyVolumes();\n    this.applyLook();\n  }\n\n  applyVolumes() {\n    const audio = this.engine?.audio;\n    if (!audio?.setVolume) return;\n    audio.setVolume('music', this.settings.music);\n    audio.setVolume('sfx', this.settings.sfx);\n    audio.setVolume('master', this.settings.master ?? 1);\n    this.busMusic = audio.volume?.music ?? this.settings.music;\n  }\n\n  applyLook() {\n    const engine = this.engine;\n    if (!engine) return;\n    const name = this.settings.look;\n    try {\n      if (name === 'default') return;\n      const preset = engine.lookPresets?.[name];\n      if (preset) engine.setLook(preset);\n      else engine.settings?.set?.({ look: name });\n    } catch { /* unknown look name */ }\n  }\n\n  fullscreen() {\n    const el = globalThis.document?.documentElement;\n    try { el?.requestFullscreen?.(); } catch { /* no display */ }\n  }\n\n  cycleLook(id) {\n    if (id === 'back' || !this.guest) return;\n    const choices = LOOK_CHOICES[id];\n    if (!choices) return;\n    const cur = this.guest.look[id];\n    const i = choices.indexOf(cur);\n    this.guest.look[id] = choices[(i + 1) % choices.length];\n    this.refresh(false);\n  }\n\n  openPause() {\n    if (this.mode === 'pause' || this.mode === 'dev') return;\n    this.returnMode = this.mode;\n    this.mode = 'pause';\n    this.frozen = !this.session;\n    if (this.frozen && this.engine) this.engine.timeScale = 0;\n    this.refresh(true);\n  }\n\n  activatePause(id) {\n    if (id === 'resume') {\n      this.mode = this.returnMode || 'title';\n      this.frozen = false;\n      if (this.engine) this.engine.timeScale = 1;\n      this.refresh(true);\n      return;\n    }\n    if (id === 'restart') { this.startActivity(this.activityId); return; }\n    if (id === 'island') {\n      this.frozen = false;\n      if (this.engine) this.engine.timeScale = 1;\n      this.mode = 'island';\n      this.refresh(true);\n      return;\n    }\n    if (id === 'settings') { this.setPage = 0; this.mode = 'settings'; this.refresh(true); return; }\n    if (id === 'howto') { this.mode = 'howto'; this.refresh(true); return; }\n    if (id === 'about') { this.aboutPage = 0; this.mode = 'about'; this.refresh(true); return; }\n    if (id === 'dev' && !this.session) {\n      this.mode = 'dev';\n      this.devTab = 0;\n      this.devPage = 0;\n      if (this.engine && !this.session) this.engine.timeScale = 0;\n      this.refresh(true);\n    }\n  }\n\n  activateDev(id) {\n    if (id === 'more') {\n      if (this.devTabName() === 'Tools') this.toolPage += 1;\n      else this.devPage += 1;\n      this.refresh(true);\n      return;\n    }\n    if (id === 'prev') {\n      if (this.devTabName() === 'Tools') this.toolPage = Math.max(0, this.toolPage - 1);\n      else this.devPage = Math.max(0, this.devPage - 1);\n      this.refresh(true);\n      return;\n    }\n    if (id === 'back') { this.mode = 'pause'; this.refresh(true); return; }\n    if (id === 'reset-tab') { this.resetTab(); return; }\n    if (id === 'reset-all') { this.resetAll(); return; }\n    if (TUNABLE_TABS[this.devTabName()]?.some((row) => row[0] === id)) return;\n    this.runTool(id);\n    this.refresh(false);\n  }\n\n  nudgeTunable(id, dir) {\n    const tab = this.devTabName();\n    const row = (TUNABLE_TABS[tab] || []).find((r) => r[0] === id);\n    if (!row) return;\n    const [, , lo, hi, step] = row;\n    const next = clamp(this.tunables[id] + dir * step, lo, hi);\n    this.tunables[id] = Math.round(next * 1000) / 1000;\n    this.refresh(false);\n  }\n\n  resetTab() {\n    const tab = this.devTabName();\n    for (const key of tabKeys(tab)) this.tunables[key] = DEFAULT_TUNABLES[key];\n    this.refresh(false);\n  }\n\n  resetAll() {\n    for (const key of Object.keys(DEFAULT_TUNABLES)) this.tunables[key] = DEFAULT_TUNABLES[key];\n    this.refresh(false);\n  }\n\n  runTool(id) {\n    if (!this.guest) this.guest = freshGuest('Guest');\n    if (id === 'day') {\n      const day = (this.guest.day % 7) + 1;\n      this.guest.day = day;\n      this.guest.week = 1;\n      this.guest.today = emptyToday();\n    } else if (id === 'jump') {\n      this.jumpPick = (this.jumpPick + 1) % ACTIVITIES.length;\n      this.frozen = false;\n      this.startActivity(ACTIVITIES[this.jumpPick].id);\n    } else if (id === 'finish') {\n      this.finishPick = (this.finishPick + 1) % 4;\n      if (this.sim) {\n        this.sim.done = true;\n        this.sim.stars = this.finishPick;\n        this.sim.score = this.sim.def.thresholds[Math.max(0, this.finishPick - 1)] || 0;\n        this.sim.seconds = Math.max(1, this.sim.playT || 1);\n        this.finishActivity();\n      }\n    } else if (id === 'drips') {\n      this.guest.drips += 50;\n      this.guest.items = milestonesReached(this.guest.drips).map((item) => item.id);\n      this.persist();\n    } else if (id === 'unlock') {\n      this.guest.unlockAll = true;\n    } else if (id === 'auto') {\n      this.skillPick = (this.skillPick + 1) % SKILLS.length;\n      this.setDriver(SKILLS[this.skillPick]);\n    } else if (id === 'god') {\n      this.god = !this.god;\n      if (this.sim) this.sim.god = this.god;\n    } else if (id === 'time') {\n      this.timePick = (this.timePick + 1) % SCALES.length;\n      if (this.engine) this.engine.timeScale = SCALES[this.timePick];\n    } else if (id === 'overlay') {\n      this.overlay = !this.overlay;\n    } else if (id === 'hud') {\n      this.hideHud = !this.hideHud;\n    } else if (id === 'camera') {\n      try { this.engine?.setCamera({ preset: 'free' }, { syncUrl: false }); } catch { /* no rig */ }\n      this.freeCam = true;\n    } else if (id === 'line') {\n      this.linePick = (this.linePick + 1) % 3;\n      this.dialogue = ['Stand.', 'The circle noticed.', 'See you tomorrow. Bring your knees.'][this.linePick];\n      this.spoken = '';\n    } else if (id === 'sound') {\n      this.soundPick = (this.soundPick + 1) % (Object.keys(SONGS).length + 1);\n      const names = Object.keys(SONGS);\n      if (this.soundPick === 0) this.engine?.audio?.play?.('chime');\n      else {\n        const name = names[this.soundPick - 1];\n        this.engine?.audio?.playMusic?.(SONGS[name], name);\n        this.songPlaying = name;\n      }\n    } else if (id === 'anim') {\n      const names = ['Tree', 'Heron', 'SquatRep', 'Press', 'StepL'];\n      this.animPick = (this.animPick + 1) % names.length;\n      this.viewerClip = names[this.animPick];\n    } else if (id === 'wipe') {\n      this.save.clear();\n      this.guest = null;\n      this.slot = 0;\n    } else if (id === 'export') {\n      const changed = {};\n      for (const key of Object.keys(DEFAULT_TUNABLES)) {\n        if (this.tunables[key] !== DEFAULT_TUNABLES[key]) changed[key] = this.tunables[key];\n      }\n      this.exported = JSON.stringify(changed);\n      try { console.log(this.exported); } catch { /* no console */ }\n    }\n  }\n\n  activateJoin(id) {\n    if (id === 'back') { this.mode = 'menu'; this.refresh(true); return; }\n    if (id === 'fill') {\n      const skills = ['sloppy', 'average', 'good', 'expert'];\n      let n = 0;\n      for (let i = 0; i < 4; i++) if (!this.seats[i]) this.seats[i] = { kind: 'bot', skill: skills[n++] || 'average' };\n      this.refresh(false);\n      return;\n    }\n    if (id === 'start') {\n      if (!this.seats.some(Boolean)) return;\n      this.openMedley({ family: true });\n    }\n  }\n\n  claim(seat) {\n    if (seat.kind === 'pad' && this.seats.some((s) => s && s.kind === 'pad' && s.index === seat.index)) return;\n    if (seat.kind === 'key' && this.seats.some((s) => s && s.kind === 'key')) return;\n    const index = this.seats.findIndex((s) => !s);\n    if (index < 0) return;\n    this.seats[index] = seat;\n    this.refresh(false);\n  }\n\n  pollJoin(ctx) {\n    let pads = [];\n    try { pads = globalThis.navigator?.getGamepads?.() || []; } catch { pads = []; }\n    for (let i = 0; i < 4; i++) {\n      const down = !!pads[i]?.buttons?.[0]?.pressed;\n      if (down && !this.prevPad[i]) this.claim({ kind: 'pad', index: i });\n      this.prevPad[i] = down;\n    }\n    if (this.edge(ctx, 'Enter')) this.claim({ kind: 'key' });\n  }\n\n  openMedley(arg = {}) {\n    this.picks = medleyPicks(this.fork('medley'));\n    this.medleyT = 0;\n    this.lanes = [];\n    if (arg.family) {\n      for (const seat of this.seats) if (seat) this.lanes.push(this.makeLane(seat));\n    } else if (arg.bots) {\n      const skills = arg.skills || ['expert', 'good', 'average', 'sloppy'];\n      skills.forEach((skill) => this.lanes.push(this.makeLane({ kind: 'bot', skill })));\n    } else if (arg.hub) {\n      this.lanes.push(this.makeLane({ kind: 'key', skill: 'idle' }));\n    } else {\n      this.lanes.push(this.makeLane({ kind: 'bot', skill: this.driver || 'expert' }));\n    }\n    if (arg.ghost) this.addGhost();\n    this.mode = 'medley';\n    this.hubClock = !!arg.hub;\n    this.refresh(true);\n  }\n\n  makeLane(seat) {\n    const lane = {\n      kind: seat.kind,\n      index: seat.index ?? 0,\n      skill: seat.skill || 'average',\n      driver: seat.kind === 'pad' ? new PadDriver(seat.index) : seat.kind === 'key' ? new LocalDriver() : null,\n      ghost: seat.kind === 'ghost' ? new GhostDriver() : null,\n      simulated: seat.kind !== 'ghost',\n      steps: 0,\n      pos: 0,\n      scores: [0, 0, 0],\n      sim: null,\n      event: -1,\n      dot: seat.kind === 'ghost' ? new Dot(() => 0.5) : null,\n    };\n    return lane;\n  }\n\n  addGhost() {\n    const lane = this.makeLane({ kind: 'ghost' });\n    this.lanes.push(lane);\n    return lane;\n  }\n\n  laneTotal(lane) {\n    return lane.scores.reduce((a, b) => a + b, 0);\n  }\n\n  fixed(ctx, dt) {\n    this.ctx = ctx;\n    if (this.mode === 'activity' && this.sim && !this.sim.done) {\n      this.sim.gentle = !!this.settings.gentle;\n      this.sim.god = !!this.god;\n      const input = this.driver ? this.sim.auto(dt) : this.local.readFrom(ctx, this.device.kind, { x: ctx.hud.width / 2, y: ctx.hud.height / 2 }, this.tunables.mouseLeanRadius, dt);\n      this.sim.step(dt, input);\n      if (this.sim.done) this.finishActivity();\n    } else if (this.mode === 'weigh' && this.weigh && !this.weigh.done) {\n      const input = this.driver ? this.weigh.auto(dt) : this.local.readFrom(ctx, this.device.kind, { x: ctx.hud.width / 2, y: ctx.hud.height / 2 }, this.tunables.mouseLeanRadius, dt);\n      this.weigh.step(dt, input);\n      if (this.weigh.done) this.finishWeigh();\n    } else if (this.mode === 'attract' && this.sim) {\n      this.sim.step(dt, this.sim.auto(dt));\n      this.attractT += dt;\n      if (this.attractT >= 14 || this.sim.done) {\n        this.attractI += 1;\n        this.attractT = 0;\n        this.beginAttract();\n      }\n    } else if (this.mode === 'medley') {\n      this.tickMedley(ctx, dt);\n    }\n  }\n\n  tickMedley(ctx, dt) {\n    if (this.hubClock && this.hub) {\n      const ms = this.hub.time?.() ?? -Infinity;\n      if (!(ms >= 0)) return;\n      this.medleyT = ms / 1000;\n    }\n    const win = medleyWindow(this.medleyT);\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost') {\n        lane.ghost.present(dt);\n        continue;\n      }\n      if (win.phase === 'play') {\n        const id = [this.picks.still, this.picks.beat, this.picks.lean][win.index];\n        if (lane.event !== win.index) {\n          if (lane.event >= 0 && lane.sim) {\n            const max = lane.sim.def.thresholds?.[2] || 1;\n            lane.scores[lane.event] = normalise(lane.sim.score || 0, max);\n          }\n          lane.sim = createSim(id, {\n            tunables: this.tunables,\n            rand: this.fork(`m-${id}`),\n            botRand: this.fork(`mb-${id}`),\n            skill: lane.kind === 'bot' ? lane.skill : (this.driver || 'idle'),\n            skipIntro: true,\n            first: false,\n            practice: false,\n          });\n          lane.event = win.index;\n          lane.dot = lane.sim.dot;\n        }\n        let input;\n        if (lane.kind === 'bot' || (lane.kind !== 'pad' && lane.kind !== 'key' && this.driver)) input = lane.sim.auto(dt);\n        else if (lane.kind === 'bot') input = lane.sim.auto(dt);\n        else if (lane.kind === 'pad') input = lane.driver.read();\n        else if (lane.kind === 'key') input = lane.driver.readFrom(ctx, 'keyboard', { x: ctx.hud.width / 2, y: ctx.hud.height / 2 }, this.tunables.mouseLeanRadius, dt);\n        else input = lane.sim.auto(dt);\n        lane.sim.step(dt, input);\n        lane.steps += 1;\n        lane.pos = lane.sim.dot ? lane.sim.dot.x : (lane.sim.x || 0);\n      }\n    }\n    if (!this.hubClock) this.medleyT += dt;\n    if (this.medleyT >= MEDLEY_SPAN && this.mode === 'medley') this.finishMedley();\n    const player = this.lanes.find((lane) => lane.kind !== 'ghost');\n    this.hubScore = player ? this.laneTotal(player) + (player.sim?.score || 0) : 0;\n  }\n\n  finishMedley() {\n    for (const lane of this.lanes) {\n      if (lane.sim && lane.event >= 0 && lane.kind !== 'ghost') {\n        const max = lane.sim.def.thresholds?.[2] || 1;\n        lane.scores[lane.event] = normalise(lane.sim.score || 0, max);\n      }\n    }\n    this.mode = 'podium';\n    this.refresh(true);\n    if (this.hub) this.hubResult();\n  }\n\n  beginAttract() {\n    const id = ATTRACT[this.attractI % ATTRACT.length];\n    const tunables = { ...this.tunables, ringScale: (this.tunables.ringScale || 1) * 2 };\n    this.sim = createSim(id, {\n      tunables,\n      rand: this.fork(`at-${id}`),\n      botRand: this.fork(`atb-${id}`),\n      skill: 'expert',\n      god: true,\n      skipIntro: true,\n      first: false,\n      practice: false,\n    });\n    this.activityId = id;\n    this.attracting = true;\n    this.mode = 'attract';\n  }\n\n  update(ctx, dt) {\n    this.ctx = ctx;\n    this.engine = ctx.engine;\n    this.device.update(ctx);\n    if (ctx.audio?.volume) this.busMusic = ctx.audio.volume.music;\n    if (this.mode === 'card') this.cardInput(ctx);\n    if (this.mode === 'join') this.pollJoin(ctx);\n    if (this.mode === 'name') this.typeName(ctx);\n    const kind = this.device.kind;\n    if (this.touchOnly && (kind === 'keyboard' || kind === 'pad') && this.anyPressed(ctx)) this.touchOnly = false;\n    if (this.mode === 'attract' && this.anyInput(ctx)) {\n      this.attracting = false;\n      this.sim = null;\n      this.idle = 0;\n      this.mode = 'title';\n      this.refresh(true);\n      this.draw(ctx);\n      return;\n    }\n    const pause = this.edge(ctx, 'KeyP') || (this.edge(ctx, 'PadOptions') && !ctx.input.isDown('PadCreate')) || (this.edge(ctx, 'Escape') && PAUSABLE.has(this.mode));\n    if (pause && PAUSABLE.has(this.mode)) this.openPause();\n    else if (this.rows.length && this.mode !== 'activity' && this.mode !== 'weigh' && this.mode !== 'attract' && this.mode !== 'card') this.menuInput(ctx);\n    if (!this.session && MENU_IDLE.has(this.mode)) {\n      if (this.anyInput(ctx)) this.idle = 0;\n      else this.idle += dt > 0 ? dt : 1 / 60;\n      if (this.idle >= 10) {\n        this.attractI = 0;\n        this.attractT = 0;\n        this.idle = 0;\n        this.beginAttract();\n      }\n    } else if (this.mode !== 'attract') this.idle = 0;\n    if (this.mode === 'dev') {\n      const tab = this.edge(ctx, 'KeyE') || this.edge(ctx, 'PadR1');\n      const prev = this.edge(ctx, 'KeyQ') || this.edge(ctx, 'PadL1');\n      const names = [...Object.keys(TUNABLE_TABS), 'Tools'];\n      if (tab) { this.devTab = (this.devTab + 1) % names.length; this.devPage = 0; this.refresh(true); }\n      if (prev) { this.devTab = (this.devTab + names.length - 1) % names.length; this.devPage = 0; this.refresh(true); }\n    }\n    if (this.mode === 'about' && (this.edge(ctx, 'ArrowRight') || this.edge(ctx, 'PadR1'))) this.aboutPage += 1;\n    if (this.mode === 'about' && (this.edge(ctx, 'ArrowLeft') || this.edge(ctx, 'PadL1'))) this.aboutPage = Math.max(0, this.aboutPage - 1);\n    this.syncSong(ctx);\n    this.syncSpeech(ctx);\n    this.hover(ctx);\n    this.draw(ctx);\n  }\n\n  cardInput(ctx) {\n    const hub = this.hub || globalThis.AIHub;\n    if (!hub?.answer) return;\n    if (this.edge(ctx, 'Enter') || this.edge(ctx, 'PadCross')) hub.answer('ready');\n    if (this.edge(ctx, 'KeyM') || this.edge(ctx, 'PadTriangle')) hub.answer('more');\n  }\n\n  typeName(ctx) {\n    const input = ctx.input;\n    if (this.edge(ctx, 'Backspace')) this.nameBuf = this.nameBuf.slice(0, -1);\n    for (let i = 0; i < 26; i++) {\n      const code = `Key${String.fromCharCode(65 + i)}`;\n      if (input.wasPressed(code) && this.nameBuf.length < 8) this.nameBuf += String.fromCharCode(97 + i);\n    }\n    this.rows = this.rowsFor();\n  }\n\n  menuInput(ctx) {\n    if (!this.rows.length) return;\n    if (this.pressedAny(ctx, DOWN) || (this.mode !== 'island' && this.mode !== 'activity' && this.edge(ctx, 'KeyS'))) {\n      this.focus = (this.focus + 1) % this.rows.length;\n    } else if (this.pressedAny(ctx, UP) || (this.mode !== 'island' && this.edge(ctx, 'KeyW'))) {\n      this.focus = (this.focus + this.rows.length - 1) % this.rows.length;\n    } else if (this.pressedAny(ctx, LEFT)) {\n      this.nudge(-1);\n    } else if (this.pressedAny(ctx, RIGHT)) {\n      this.nudge(1);\n    } else if (this.pressedAny(ctx, PRESS) || (this.mode !== 'name' && this.edge(ctx, 'KeyE'))) {\n      const row = this.rows[this.focus];\n      if (row) this.activate(row.id);\n    } else if (this.pressedAny(ctx, BACK) && this.mode !== 'pause') {\n      this.back();\n    }\n  }\n\n  nudge(dir) {\n    const row = this.rows[this.focus];\n    if (!row) return;\n    if (this.mode === 'dev') this.nudgeTunable(row.id, dir);\n    if (this.mode === 'settings') this.nudgeSetting(row.id, dir);\n    if (this.mode === 'locker') this.cycleLook(row.id);\n  }\n\n  back() {\n    const map = {\n      slots: 'menu', station: 'island', settings: this.frozen ? 'pause' : 'menu',\n      about: this.frozen ? 'pause' : 'menu', howto: 'pause', locker: 'island',\n      hall: 'island', jar: 'island', join: 'menu', name: 'slots', ferry: 'slots',\n      results: 'island', dev: 'pause',\n    };\n    if (map[this.mode]) {\n      this.mode = map[this.mode];\n      this.refresh(true);\n    }\n  }\n\n  hover(ctx) {\n    if (this.device.kind !== 'mouse') return;\n    const p = ctx.input.pointer;\n    if (!p) return;\n    const ax = ((p.x + 1) / 2) * ctx.hud.width;\n    const ay = ((1 - p.y) / 2) * ctx.hud.height;\n    this.widgets.forEach((w, i) => {\n      if (!String(w.id).startsWith('row-')) return;\n      if (ax >= w.x && ax <= w.x + w.w && ay >= w.y && ay <= w.y + w.h) {\n        const id = w.id.slice(4);\n        const index = this.rows.findIndex((row) => row.id === id);\n        if (index >= 0) this.focus = index;\n      }\n    });\n  }\n\n  syncSong(ctx) {\n    let key = 'plaza';\n    if (this.mode === 'activity' || this.mode === 'attract') key = SONG_FOR[ACTIVITY_BY_ID[this.activityId]?.kind] || 'plaza';\n    else if (this.mode === 'report' || this.mode === 'confession') key = 'report';\n    else if (this.mode === 'island') key = 'plaza';\n    else if (this.mode === 'medley') key = 'hoop';\n    if (this.songPlaying === key) return;\n    const song = SONGS[key];\n    if (song && ctx.audio?.playMusic) {\n      ctx.audio.playMusic(song, key);\n      this.songPlaying = key;\n    }\n  }\n\n  syncSpeech(ctx) {\n    let line = '';\n    let speaker = 'ounce';\n    if (this.mode === 'results') { line = this.dialogue; speaker = 'ounce'; }\n    else if (this.mode === 'ferry') { line = 'The ferry is on time. Your knees are a separate matter.'; }\n    else if (this.mode === 'confession') { line = 'I have been adding seven. It felt like kindness. It was not.'; }\n    else if (this.mode === 'reveal' && this.guest?.chart?.length) {\n      const last = this.guest.chart[this.guest.chart.length - 1];\n      line = `Your Wobble Age is ${last.shown}. Is that close?`;\n    } else if (this.mode === 'dev' && this.dialogue) { line = this.dialogue; speaker = 'coach'; }\n    else if (this.mode === 'attract') { line = 'This is a recording. The person in it is doing better than you.'; }\n    if (!line || line === this.spoken) return;\n    this.spoken = line;\n    if ((this.settings.voice ?? 1) <= 0) return;\n    import('./audio/voice.js').then((mod) => mod.speak(ctx, line, speaker)).catch(() => {});\n  }\n\n  edge(ctx, code) {\n    return !!ctx.input.wasPressed(code);\n  }\n\n  pressedAny(ctx, codes) {\n    return codes.some((code) => ctx.input.wasPressed(code));\n  }\n\n  anyPressed(ctx) {\n    return ANY.some((code) => ctx.input.wasPressed(code));\n  }\n\n  anyInput(ctx) {\n    const input = ctx.input;\n    if (Math.hypot(input.mouseDelta?.x || 0, input.mouseDelta?.y || 0) > 2) return true;\n    if (input.wheel) return true;\n    if (Math.hypot(input.padAxis?.x || 0, input.padAxis?.y || 0) > 0.3) return true;\n    return this.anyPressed(ctx);\n  }\n\n  bindHub(hub) {\n    this.hub = hub;\n    this.session = this.session || { hub: true };\n    hub.on?.('card', (card) => { this.card = card; });\n    hub.on?.('start', () => {\n      this.hubLive = true;\n      this.hubScore = 0;\n      this.openMedley({ hub: true });\n      this.hubPulse();\n      if (this._hubTimer) clearInterval(this._hubTimer);\n      this._hubTimer = setInterval(() => this.hubPulse(), 100);\n    });\n    hub.on?.('message', (data, from) => this.ghostMessage(data, from));\n    hub.on?.('leave', (info) => { if (info?.id != null) this.leftIds.add(info.id); });\n    hub.on?.('time-up', () => this.hubResult());\n    hub.on?.('end', () => this.hubStop());\n  }\n\n  ghostMessage(data, from) {\n    if (!data || from == null) return;\n    let lane = this.lanes.find((item) => item.kind === 'ghost' && item.from === from);\n    if (!lane) {\n      lane = this.addGhost();\n      lane.from = from;\n    }\n    lane.ghost.push(data);\n  }\n\n  hubPulse() {\n    if (!this.hubLive || this.hubEnded || !this.hub) return;\n    const lane = this.lanes.find((item) => item.kind !== 'ghost');\n    const score = this.hubScore || 0;\n    const win = medleyWindow(Math.max(0, this.medleyT));\n    try {\n      this.hub.send({ a: win.index || 0, x: lane?.pos || 0, y: 0, c: 0, t: lane?.sim?.playT || 0, s: score }, { reliable: false });\n      this.hub.progress({ score, label: 'Medley' });\n    } catch { /* the round may already be over */ }\n  }\n\n  hubResult() {\n    if (this.resultSent || !this.hub) return;\n    this.resultSent = true;\n    this.hubLive = false;\n    try {\n      this.hub.result({\n        score: this.hubScore || 0,\n        stats: { events: 3 },\n        awards: [{ title: 'Stillest', detail: 'You stayed.' }],\n      });\n    } catch { /* already sent */ }\n  }\n\n  hubStop() {\n    this.hubEnded = true;\n    this.hubLive = false;\n    if (this._hubTimer) clearInterval(this._hubTimer);\n    this._hubTimer = null;\n    try { this.engine?.audio?.stopMusic?.(); } catch { /* quiet */ }\n  }\n\n  widget(id, x, y, w, h) {\n    this.widgets.push({ id, x, y, w, h });\n  }\n\n  status() {\n    if (this.mode === 'activity' && this.sim) {\n      return `activity ${this.activityId} | ${this.sim.phase} | t ${this.sim.playT.toFixed(1)} | score ${Math.round(this.sim.score)}`;\n    }\n    if (this.mode === 'medley') return `medley | t ${this.medleyT.toFixed(1)} | score ${Math.round(this.hubScore || 0)}`;\n    return `${this.mode} | day ${this.guest?.day || 0}`;\n  }\n\n  fingerprint() {\n    const dot = this.sim?.dot || this.weigh?.dot;\n    const x = dot ? dot.x.toFixed(4) : '0';\n    const y = dot ? dot.y.toFixed(4) : '0';\n    return `${this.mode}|${this.guest?.day || 0}|${Math.round(this.sim?.score || 0)}|${x},${y}`;\n  }\n\n  state() {\n    const row = this.rows[this.focus];\n    return {\n      title: this.title,\n      mode: this.mode,\n      focus: this.focus,\n      row: row?.id || '',\n      rows: this.rows.map((r) => r.id),\n      device: this.device.kind,\n      glyphs: this.settings.glyphs,\n      glyph: glyphKind(this.device.kind, this.settings.glyphs),\n      prompt: promptFor(this.device.kind, this.settings.glyphs, this.mode === 'title' ? 'Start' : 'Confirm'),\n      touchOnly: this.touchOnly,\n      touchMessage: this.touchOnly ? 'Controller or keyboard required' : '',\n      music: this.busMusic,\n      day: this.guest?.day || 0,\n      week: this.guest?.week || 0,\n      name: this.guest?.name || '',\n      drips: this.guest?.drips || 0,\n      stars: this.lastStars,\n      score: this.lastScore,\n      seconds: this.lastSeconds,\n      lastDrips: this.lastDrips,\n      lastPrescription: this.lastPrescription,\n      activity: this.activityId,\n      confessed: !!this.guest?.confessed,\n      chart: (this.guest?.chart || []).map((p) => ({ day: p.day, t: p.t, trueAge: p.trueAge, shown: p.shown })),\n      items: this.guest?.items || [],\n      tunables: { ...this.tunables },\n      settings: { ...this.settings },\n      widgets: this.widgets.map((w) => ({ ...w })),\n      overlay: this.overlay,\n      god: this.god,\n      driver: this.driver,\n      attract: this.mode === 'attract',\n      attractId: this.mode === 'attract' ? this.activityId : '',\n      hideHud: this.hideHud,\n      frozen: this.frozen,\n      timeScale: this.engine?.timeScale,\n      session: !!this.session,\n      dialogue: this.dialogue,\n      viewerClip: this.viewerClip,\n      exported: this.exported,\n      freeCam: !!this.freeCam,\n      lanes: this.lanes.map((lane) => ({\n        kind: lane.kind,\n        pos: lane.pos,\n        steps: lane.steps,\n        simulated: lane.simulated,\n        t: lane.dot?.t || 0,\n        scores: lane.scores,\n      })),\n      medleyT: this.medleyT,\n      picks: this.picks,\n      seats: this.seats.map((s) => (s ? s.kind : null)),\n      devTab: this.devTabName(),\n      phase: this.sim?.phase || this.weigh?.kind || '',\n      playT: this.sim?.playT || this.weigh?.t || 0,\n    };\n  }\n\n  draw(ctx) {\n    const hud = ctx.hud;\n    if (!hud?.clear) return;\n    hud.clear();\n    this.widgets = [];\n    if (this.hideHud) {\n      if (hud.visible != null) hud.visible = false;\n      return;\n    }\n    if (hud.visible != null) hud.visible = true;\n    const view = { hud, app: this, w: hud.width, h: hud.height };\n    paint(view);\n  }\n}\n\nfunction clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\nfunction clamp01(v) { return clamp(v, 0, 1); }\n\nfunction weighCtor() {\n  return { WeighSim: createSim.WeighSim || null };\n}\n\nimport { WeighSim } from './core/sims.js';\nimport { say, measureText, wrapText } from './ui/font.js';\nimport { aboutPages, MEDICAL } from './data/about.js';\nimport { CREDITS_TEXT } from './data/creditsText.js';\nimport { TAGLINE } from './data/title.js';\n\nApp.prototype.startWeigh = function startWeigh() {\n  const kind = dayInfo(this.guest?.day || 1).test;\n  this.weigh = new WeighSim(kind, {\n    tunables: this.tunables,\n    rand: this.fork('weigh'),\n    botRand: this.fork('weigh-bot'),\n    skill: this.driver || 'idle',\n  });\n  this.mode = 'weigh';\n  this.sim = null;\n  this.refresh(true);\n};\n\nfunction marginOf(w) { return w < 200 ? 4 : 12; }\n\nfunction paint(view) {\n  const { hud, app, w, h } = view;\n  const m = marginOf(w);\n  const narrow = w < 220;\n  const scale = narrow ? 1 : 2;\n  const titleScale = w < 220 ? 2 : w < 400 ? 3 : 4;\n  let y = m;\n  const head = (text, sc = titleScale, color = 'white') => {\n    y = line(view, 'title', text, y, sc, color);\n  };\n  if (app.mode === 'title' || app.mode === 'attract') {\n    hud.rect(0, 0, w, Math.min(h, 78), 'navy');\n    app.widget('band', 0, 0, w, Math.min(h, 78));\n    head(TITLE, titleScale, 'cyan');\n    y = line(view, 'tag', TAGLINE, y, narrow ? 1 : 2, 'sand');\n    if (app.touchOnly) {\n      for (const part of wrapText('Controller or keyboard required', Math.max(8, Math.floor((w - m * 2) / (6 * (narrow ? 1 : 2)))))) {\n        y = line(view, 'touch', part, y, narrow ? 1 : 2, 'sand');\n      }\n    }\n    if (app.mode === 'attract') y = line(view, 'rec', 'Press any button', y, scale, 'sand');\n  } else if (app.mode === 'card') {\n    head(TITLE, titleScale, 'cyan');\n    y = line(view, 'goal', 'Score the most across three events.', y, 1, 'sand');\n    y = line(view, 'how', 'Stay in the circle.', y, 1, 'white');\n    const players = app.session?.players || app.hub?.players || [];\n    players.slice(0, 4).forEach((p, i) => {\n      y = line(view, `seat-${i}`, `${p.name || 'Guest'}`, y, 1, 'white');\n    });\n    const left = app.card?.left;\n    y = line(view, 'time', left == null ? 'Starting' : `${Math.ceil(left / 1000)}s`, y, scale, 'cyan');\n    y = line(view, 'ready', 'Enter ready', y, 1, 'sand');\n  } else {\n    const title = heading(app);\n    y = line(view, 'head', title, y, scale, 'cyan');\n  }\n  if (app.mode === 'activity' || app.mode === 'weigh' || app.mode === 'attract') {\n    y = line(view, 'phase', phaseLine(app), y, 1, 'sand');\n    drawPips(view, app.mode === 'activity' ? (app.sim?.stars || 0) : 0, m, h - m - 10);\n  }\n  if (app.mode === 'results') {\n    y = line(view, 'act', ACTIVITY_BY_ID[app.activityId]?.name || '', y, 1, 'white');\n    const bits = wrapText(app.dialogue || '', 52).slice(0, 3);\n    bits.forEach((part, i) => { y = line(view, `line-${i}`, part, y, 1, 'sand'); });\n    y = line(view, 'drips', `Drips ${app.lastDrips}`, y, scale, 'cyan');\n    drawPips(view, app.lastStars, m, y);\n    y += 16;\n  }\n  if (app.mode === 'reveal' && app.guest?.chart?.length) {\n    const last = app.guest.chart[app.guest.chart.length - 1];\n    y = line(view, 'age', String(last.shown), y, titleScale, 'white');\n    y = line(view, 'felt', wrapText(app.guest.felt || 'Noted.', 40)[0], y, 1, 'sand');\n  }\n  if (app.mode === 'report' && app.guest) {\n    const last = app.guest.chart[app.guest.chart.length - 1];\n    y = line(view, 'age', last ? String(last.shown) : '--', y, titleScale, 'white');\n    const info = dayInfo(app.guest.day);\n    y = line(view, 'concern', wrapText(`Concern: ${info.concern}`, 40)[0], y, 1, 'sand');\n  }\n  if (app.mode === 'confession') {\n    y = line(view, 'sorry', 'I have been adding seven.', y, 1, 'sand');\n  }\n  if (app.mode === 'hammock') {\n    const guilt = app.guest?.today?.plays ? 'Rest. The day is filed.' : 'The hammock kept the day. The jar did not.';\n    y = line(view, 'guilt', guilt, y, 1, 'sand');\n  }\n  if (app.mode === 'jar' && app.guest) {\n    y = line(view, 'jar-n', String(app.guest.drips), y, titleScale, 'cyan');\n    for (const item of milestonesReached(app.guest.drips).slice(0, 4)) y = line(view, item.id, item.name, y, 1, 'white');\n  }\n  if (app.mode === 'hall' && app.guest) {\n    const last = app.guest.chart[app.guest.chart.length - 1];\n    y = line(view, 'hall-n', last ? String(last.shown) : '--', y, titleScale, 'white');\n  }\n  if (app.mode === 'about') {\n    const pages = aboutPages(CREDITS_TEXT);\n    const page = pages[Math.min(app.aboutPage, pages.length - 1)];\n    y = line(view, 'about-h', page.title, y, scale, 'cyan');\n    page.lines.slice(0, 6).forEach((text, i) => {\n      const bits = wrapText(text, narrow ? 26 : 40).slice(0, 2);\n      bits.forEach((part, j) => { y = line(view, `about-${i}-${j}`, part, y, 1, 'white'); });\n    });\n  }\n  if (app.mode === 'howto') {\n    y = line(view, 'how1', 'Lean to keep the dot in the circle.', y, 1, 'white');\n    y = line(view, 'how2', 'Breathe on the beat. Step on the beat.', y, 1, 'sand');\n  }\n  if (app.mode === 'medley' || app.mode === 'podium') {\n    app.lanes.forEach((lane, i) => {\n      y = line(view, `lane-${i}`, `${lane.kind} ${Math.round(app.laneTotal(lane))}`, y, 1, 'white');\n    });\n  }\n  if (app.mode === 'join') {\n    app.seats.forEach((seat, i) => {\n      y = line(view, `seat-${i}`, seat ? `${i + 1} ${seat.kind}` : `${i + 1} empty`, y, 1, 'sand');\n    });\n  }\n  if (app.overlay) y = line(view, 'overlay', app.status().slice(0, 48), y, 1, 'lime');\n  const rows = app.rows;\n  const rowScale = scale;\n  const rowH = 9 * rowScale + 6;\n  let ry = Math.min(y + 8, h - m - rows.length * rowH);\n  if (ry < m) ry = m;\n  rows.forEach((row, i) => {\n    const mark = i === app.focus ? '> ' : '  ';\n    const text = `${mark}${row.label}`.slice(0, narrow ? 28 : 36);\n    const width = measureText(text, rowScale).width;\n    const x = m;\n    if (ry + rowH <= h) {\n      app.widget(`row-${row.id}`, x, ry, Math.min(width, w - m * 2), 9 * rowScale);\n      say(hud, x, ry, text, { scale: rowScale, color: i === app.focus ? 'sand' : 'white' });\n    }\n    ry += rowH;\n  });\n  const prompt = app.state().prompt;\n  const py = h - m - 9;\n  if (py > 0) {\n    app.widget('prompt', m, py, measureText(prompt, 1).width, 9);\n    say(hud, m, py, prompt, { scale: 1, color: 'mist' });\n  }\n  if (app.mode === 'title') {\n    const medical = wrapText(MEDICAL, narrow ? 26 : 46)[0];\n    say(hud, m, h - m - 20, medical, { scale: 1, color: 'mist' });\n  }\n}\n\nfunction line(view, id, text, y, scale, color) {\n  const { hud, app, w, h } = view;\n  const m = marginOf(w);\n  const shown = String(text || '').slice(0, 52);\n  if (!shown || y > h - 8) return y;\n  const width = measureText(shown, scale).width;\n  let x = Math.max(m, Math.floor((w - width) / 2));\n  if (x + width > w - 2) x = m;\n  app.widget(id, x, y, Math.min(width, w - x), 9 * scale);\n  say(hud, x, y, shown, { scale, color });\n  return y + 9 * scale + 3;\n}\n\nfunction drawPips(view, stars, x, y) {\n  const { hud, app } = view;\n  for (let i = 0; i < 3; i++) {\n    hud.rect(x + i * 10, y, 7, 7, i < stars ? 'sand' : 'slate');\n  }\n  app.widget('stars', x, y, 28, 7);\n}\n\nfunction heading(app) {\n  if (app.mode === 'menu') return 'Mint Dial';\n  if (app.mode === 'weigh') return 'Weigh in';\n  if (app.mode === 'island') return app.guest ? `Day ${app.guest.day}` : 'Island';\n  if (app.mode === 'station') return STATIONS.find((s) => s.id === app.station)?.name?.split(' ').slice(0, 3).join(' ') || 'Station';\n  if (app.mode === 'pause') return 'Paused';\n  if (app.mode === 'dev') return app.devTabName();\n  if (app.mode === 'settings') return 'Settings';\n  if (app.mode === 'name') return 'Your name';\n  if (app.mode === 'ferry') return 'The ferry';\n  if (app.mode === 'question') return 'One question';\n  if (app.mode === 'results') return 'Results';\n  if (app.mode === 'report') return 'Evening';\n  if (app.mode === 'confession') return 'A correction';\n  if (app.mode === 'credits') return 'Credits';\n  if (app.mode === 'join') return 'Family Hour';\n  if (app.mode === 'podium') return 'Podium';\n  if (app.mode === 'locker') return 'Locker';\n  if (app.mode === 'hall') return 'Hall';\n  if (app.mode === 'jar') return 'Sweat jar';\n  if (app.mode === 'hammock') return 'Hammock';\n  if (app.mode === 'about') return 'About';\n  return app.mode;\n}\n\nfunction phaseLine(app) {\n  if (app.mode === 'weigh') return `${app.weigh?.kind || ''} ${Math.floor(app.weigh?.t || 0)}s`;\n  if (!app.sim) return '';\n  return `${app.sim.phase} ${Math.floor(app.sim.playT)}s`;\n}\n\n// The class method above was replaced. Drop the unused helper's throw path.\nvoid weighCtor;\n","old_string":""}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":4374,"output_tokens":19472,"cache_read_input_tokens":181376,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa22-c3bd-7423-a5f1-ddadc552f469","uuid":"aafdd7c7-3cbf-40b3-a5e6-f72dc2b63c99"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-d12c6a40-f3a8-45c4-bf39-1abdf194ee29-77","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"import { TITLE } from './data/title.js';\\nimport { ACTIVITIES, ACTIVITY_BY_ID, STATIONS, activitiesAt, rivalScore } from './data/activities.js';\\nimport { dayInfo, isUnlocked } from './data/week.js';\\nimport { questionFor } from './data/questions.js';\\nimport { medleyPicks, medleyWindow, normalise, MEDLEY_SPAN } from './data/medley.js';\\nimport { lineText } from './data/lines.js';\\nimport { LOOK_CHOICES, PLAYER_LOOK } from './art/avatar.js';\\nimport { SONGS, SONG_FOR } from './audio/songs.js';\\nimport { dripsFor, milestonesReached, wobbleAge } from './core/score.js';\\nimport { Save } from './core/save.js';\\nimport { cloneTunables, DEFAULT_TUNABLES, TUNABLE_TABS, tabKeys } from './core/tunables.js';\\nimport { Device } from './core/device.js';\\nimport { promptFor, glyphKind } from './core/actions.js';\\nimport { LocalDriver, PadDriver, GhostDriver } from './core/drivers.js';\\nimport { createSim } from './core/sims.js';\\nimport { Dot } from './core/dot.js';\\nimport { mulberry32, hashString } from './core/rng.js';\\n\\nconst MENU_IDLE = new Set([\\n  'title', 'menu', 'slots', 'name', 'settings', 'about', 'howto', 'dropin',\\n  'station', 'ferry', 'join', 'results', 'reveal', 'question', 'report',\\n  'locker', 'hall', 'jar', 'credits', 'confession', 'podium',\\n]);\\nconst PAUSABLE = new Set(['activity', 'weigh', 'island', 'medley']);\\nconst PRESS = ['Enter', 'Space', 'PadCross', 'MouseLeft'];\\nconst BACK = ['Escape', 'Backspace', 'PadCircle', 'MouseRight'];\\nconst DOWN = ['ArrowDown', 'PadDown'];\\nconst UP = ['ArrowUp', 'PadUp'];\\nconst LEFT = ['ArrowLeft', 'PadLeft'];\\nconst RIGHT = ['ArrowRight', 'PadRight'];\\nconst ANY = [...PRESS, ...BACK, ...DOWN, ...UP, ...LEFT, ...RIGHT, 'KeyP', 'KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyQ', 'KeyF', 'KeyJ', 'KeyM', 'PadOptions', 'PadTriangle', 'PadL1', 'PadR1'];\\nconst ATTRACT = ['tree', 'hoop', 'header', 'step', 'slack', 'tray', 'pier', 'jog', 'squat', 'longstand'];\\nconst DEV_TOOLS = [\\n  ['day', 'Go to day'],\\n  ['jump', 'Jump activity'],\\n  ['finish', 'Finish stars'],\\n  ['drips', 'Give 50 drips'],\\n  ['unlock', 'Unlock all'],\\n  ['auto', 'Autopilot'],\\n  ['god', 'God mode'],\\n  ['time', 'Time scale'],\\n  ['overlay', 'Overlay'],\\n  ['hud', 'Hide HUD'],\\n  ['camera', 'Free camera'],\\n  ['line', 'Dialogue line'],\\n  ['sound', 'Sound test'],\\n  ['anim', 'Anim viewer'],\\n  ['wipe', 'Reset save'],\\n  ['export', 'Export JSON'],\\n];\\nconst SCALES = [0.25, 0.5, 1, 2, 3];\\nconst SKILLS = [null, 'idle', 'sloppy', 'average', 'good', 'expert'];\\nconst LOOKS = ['default', 'storybook', 'arcade', 'handheld'];\\n\\nfunction emptyToday() {\\n  return { plays: 0, ids: [], bestStar: 0, beat: {}, fresh: false };\\n}\\n\\nexport function freshGuest(name = 'Guest') {\\n  return {\\n    name: String(name || 'Guest').slice(0, 8) || 'Guest',\\n    look: { ...PLAYER_LOOK },\\n    day: 1,\\n    week: 1,\\n    drips: 0,\\n    totalStars: 0,\\n    samples: [],\\n    chart: [],\\n    confessed: false,\\n    ferried: false,\\n    records: {},\\n    items: [],\\n    today: emptyToday(),\\n    place: 'pavilion',\\n    felt: '',\\n    hard: false,\\n    unlockAll: false,\\n  };\\n}\\n\\nfunction beats(def, score, stars, who) {\\n  const rival = rivalScore(def, who);\\n  if (def.kind === 'slack') return stars > rival;\\n  return score > rival;\\n}\\n\\nexport class App {\\n  constructor(opts = {}) {\\n    this.title = TITLE;\\n    this.save = new Save(opts.storage === undefined ? undefined : opts.storage);\\n    const disk = this.save.read();\\n    this.tunables = cloneTunables();\\n    this.settings = {\\n      music: 0.1,\\n      sfx: 1,\\n      voice: 1,\\n      master: 1,\\n      glyphs: 'playstation',\\n      gentle: false,\\n      flashes: false,\\n      look: 'default',\\n      pixel: 'fine',\\n    };\\n    if (disk.settings) Object.assign(this.settings, disk.settings);\\n    if (!disk.settings) this.settings.music = 0.1;\\n    this.session = opts.session || null;\\n    this.touchOnly = !!opts.touchOnly;\\n    this.mode = this.session ? 'card' : 'title';\\n    this.device = new Device();\\n    this.local = new LocalDriver();\\n    this.driver = null;\\n    this.god = false;\\n    this.hideHud = false;\\n    this.overlay = false;\\n    this.focus = 0;\\n    this.rows = [];\\n    this.idle = 0;\\n    this.widgets = [];\\n    this.slot = 0;\\n    this.guest = null;\\n    this.nameBuf = 'Guest';\\n    this.drop = false;\\n    this.sim = null;\\n    this.weigh = null;\\n    this.activityId = '';\\n    this.station = 'pavilion';\\n    this.islandPage = 0;\\n    this.returnMode = 'title';\\n    this.frozen = false;\\n    this.devTab = 0;\\n    this.devPage = 0;\\n    this.toolPage = 0;\\n    this.finishPick = 0;\\n    this.timePick = 0;\\n    this.skillPick = 0;\\n    this.jumpPick = 0;\\n    this.soundPick = 0;\\n    this.animPick = 0;\\n    this.linePick = 0;\\n    this.aboutPage = 0;\\n    this.creditPage = 0;\\n    this.question = null;\\n    this.answer = 0;\\n    this.lastStars = 0;\\n    this.lastScore = 0;\\n    this.lastSeconds = 0;\\n    this.lastDrips = 0;\\n    this.lastPrescription = false;\\n    this.spoken = '';\\n    this.songPlaying = '';\\n    this.attracting = false;\\n    this.attractI = 0;\\n    this.attractT = 0;\\n    this.forkN = 0;\\n    this.ctx = null;\\n    this.engine = null;\\n    this.lanes = [];\\n    this.seats = [null, null, null, null];\\n    this.prevPad = [false, false, false, false];\\n    this.medleyT = 0;\\n    this.picks = null;\\n    this.hub = null;\\n    this.hubLive = false;\\n    this.hubEnded = false;\\n    this.resultSent = false;\\n    this.hubScore = 0;\\n    this.card = null;\\n    this.leftIds = new Set();\\n    this.viewerClip = '';\\n    this.dialogue = '';\\n    this.exported = '';\\n    this.dropRecords = {};\\n    this.held = new Set();\\n    this.busMusic = 0.1;\\n    this.refresh(true);\\n  }\\n\\n  fork(label) {\\n    this.forkN += 1;\\n    const id = `${label}:${this.forkN}`;\\n    if (this.ctx?.random) {\\n      const rng = this.ctx.random.fork(id);\\n      return () => rng.next();\\n    }\\n    return mulberry32(hashString(id) || 1);\\n  }\\n\\n  go(mode, arg) {\\n    if (mode === 'activity') {\\n      this.startActivity(typeof arg === 'string' ? arg : arg?.id);\\n      return;\\n    }\\n    if (mode === 'medley') {\\n      this.openMedley(arg || {});\\n      return;\\n    }\\n    this.mode = mode;\\n    if (mode === 'title') {\\n      this.attracting = false;\\n      this.drop = false;\\n      this.idle = 0;\\n    }\\n    if (mode === 'island') this.islandPage = 0;\\n    if (mode === 'name') this.focus = 0;\\n    this.refresh(mode !== 'dev');\\n  }\\n\\n  setDriver(skill) {\\n    this.driver = skill || null;\\n    this.skillPick = Math.max(0, SKILLS.indexOf(this.driver));\\n    if (this.sim?.setSkill && this.driver) this.sim.setSkill(this.driver);\\n  }\\n\\n  refresh(resetFocus = false) {\\n    this.rows = this.rowsFor().slice(0, 8);\\n    if (resetFocus) this.focus = 0;\\n    if (this.focus >= this.rows.length) this.focus = Math.max(0, this.rows.length - 1);\\n  }\\n\\n  rowsFor() {\\n    const g = this.guest;\\n    switch (this.mode) {\\n      case 'title':\\n        return [{ id: 'start', label: 'Start' }];\\n      case 'menu':\\n        return [\\n          { id: 'week', label: 'Week' },\\n          { id: 'dropin', label: 'Drop-In' },\\n          { id: 'family', label: 'Family Hour' },\\n          { id: 'settings', label: 'Settings' },\\n          { id: 'about', label: 'About' },\\n        ];\\n      case 'slots':\\n        return [0, 1, 2].map((i) => {\\n          const slot = this.save.read().slots[i];\\n          return { id: `slot${i}`, label: slot ? `Guest ${i + 1}: ${slot.name}` : `Guest ${i + 1}: empty` };\\n        }).concat([{ id: 'back', label: 'Back' }]);\\n      case 'name':\\n        return [{ id: 'done', label: `Done (${this.nameBuf || 'Guest'})` }];\\n      case 'ferry':\\n        return [{ id: 'board', label: 'Board' }];\\n      case 'question':\\n        return (this.question?.answers || []).map((label, i) => ({ id: `a${i}`, label }));\\n      case 'reveal':\\n        return [{ id: 'onward', label: 'Onward' }];\\n      case 'island':\\n        return this.islandRows();\\n      case 'station':\\n        return this.stationRows();\\n      case 'results':\\n        return [\\n          { id: 'retry', label: 'Retry' },\\n          { id: 'next', label: 'Next' },\\n          { id: 'back', label: 'Island' },\\n        ];\\n      case 'hammock':\\n        return [{ id: 'rest', label: 'Rest' }];\\n      case 'report':\\n        return [{ id: 'sleep', label: 'Sleep' }];\\n      case 'confession':\\n        return [{ id: 'onward', label: 'Onward' }];\\n      case 'credits':\\n        return [{ id: 'onward', label: 'Onward' }];\\n      case 'settings':\\n        return this.settingsRows();\\n      case 'about':\\n      case 'howto':\\n        return [{ id: 'back', label: 'Back' }];\\n      case 'pause':\\n        return this.session\\n          ? [{ id: 'resume', label: 'Resume' }, { id: 'settings', label: 'Settings' }]\\n          : [\\n            { id: 'resume', label: 'Resume' },\\n            { id: 'restart', label: 'Restart' },\\n            { id: 'island', label: 'Island' },\\n            { id: 'settings', label: 'Settings' },\\n            { id: 'howto', label: 'How to play' },\\n            { id: 'about', label: 'About' },\\n            { id: 'dev', label: 'Dev Tools' },\\n          ];\\n      case 'dev':\\n        return this.devRows();\\n      case 'join':\\n        return [\\n          { id: 'fill', label: 'Fill with classmates' },\\n          { id: 'start', label: 'Start' },\\n          { id: 'back', label: 'Back' },\\n        ];\\n      case 'podium':\\n        return [{ id: 'again', label: 'Rematch' }, { id: 'back', label: 'Back' }];\\n      case 'locker':\\n        return [\\n          { id: 'skin', label: `Skin ${g?.look?.skin || ''}` },\\n          { id: 'hair', label: `Hair ${g?.look?.hair || ''}` },\\n          { id: 'top', label: `Top ${g?.look?.top || ''}` },\\n          { id: 'bottom', label: `Bottom ${g?.look?.bottom || ''}` },\\n          { id: 'headband', label: `Band ${g?.look?.headband || ''}` },\\n          { id: 'back', label: 'Back' },\\n        ];\\n      case 'hall':\\n      case 'jar':\\n        return [{ id: 'back', label: 'Back' }];\\n      case 'dropin':\\n        return [{ id: 'play', label: 'Play' }, { id: 'back', label: 'Back' }];\\n      default:\\n        return [];\\n    }\\n  }\\n\\n  islandRows() {\\n    if (this.islandPage === 0) {\\n      return [\\n        ...STATIONS.map((s) => ({ id: `st-${s.id}`, label: s.name.replace(' of Holding Still', '').replace('The ', '').replace('Jogging Path', 'Jog') })),\\n        { id: 'more', label: 'More' },\\n      ];\\n    }\\n    const rows = [\\n      { id: 'jar', label: 'Sweat Jar' },\\n      { id: 'locker', label: 'Locker' },\\n      { id: 'hall', label: 'Hall' },\\n      { id: 'hammock', label: 'Hammock' },\\n    ];\\n    if (this.isOpen(ACTIVITY_BY_ID.longstand)) rows.push({ id: 'longstand', label: 'Long Stand' });\\n    rows.push({ id: 'back', label: 'Back' });\\n    return rows;\\n  }\\n\\n  stationRows() {\\n    const rows = activitiesAt(this.station).filter((a) => this.isOpen(a)).map((a) => ({ id: `act-${a.id}`, label: a.name }));\\n    if ((this.guest && (this.guest.day >= 6 || this.guest.unlockAll)) || this.drop) {\\n      rows.push({ id: 'hard', label: this.guest?.hard ? 'Hard: on' : 'Hard: off' });\\n    }\\n    rows.push({ id: 'back', label: 'Back' });\\n    return rows.slice(0, 8);\\n  }\\n\\n  settingsRows() {\\n    const s = this.settings;\\n    if ((this.setPage || 0) === 0) {\\n      return [\\n        { id: 'music', label: `Music ${Math.round(s.music * 100)}` },\\n        { id: 'sfx', label: `SFX ${Math.round(s.sfx * 100)}` },\\n        { id: 'voice', label: `Voice ${Math.round(s.voice * 100)}` },\\n        { id: 'glyphs', label: s.glyphs === 'xbox' ? 'Glyphs: Xbox' : 'Glyphs: PlayStation' },\\n        { id: 'gentle', label: s.gentle ? 'Gentle: on' : 'Gentle: off' },\\n        { id: 'more', label: 'More' },\\n      ];\\n    }\\n    return [\\n      { id: 'radius', label: `Mouse radius ${this.tunables.mouseLeanRadius}` },\\n      { id: 'offset', label: `Step offset ${this.tunables.stepOffsetMs}` },\\n      { id: 'flashes', label: s.flashes ? 'Flashes: low' : 'Flashes: on' },\\n      { id: 'look', label: `Look ${s.look}` },\\n      { id: 'pixel', label: `Pixels ${s.pixel}` },\\n      { id: 'full', label: 'Fullscreen' },\\n      { id: 'reset', label: 'Reset' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  }\\n\\n  devTabName() {\\n    return [...Object.keys(TUNABLE_TABS), 'Tools'][this.devTab] || 'Balance';\\n  }\\n\\n  devRows() {\\n    const tab = this.devTabName();\\n    if (tab === 'Tools') {\\n      const start = this.toolPage * 5;\\n      const slice = DEV_TOOLS.slice(start, start + 5).map(([id, label]) => ({ id, label: this.toolLabel(id, label) }));\\n      const rows = slice;\\n      if (start + 5 < DEV_TOOLS.length) rows.push({ id: 'more', label: 'More' });\\n      else if (this.toolPage > 0) rows.push({ id: 'prev', label: 'Previous' });\\n      rows.push({ id: 'back', label: 'Back' });\\n      return rows;\\n    }\\n    const keys = tabKeys(tab);\\n    const start = this.devPage * 5;\\n    const rows = keys.slice(start, start + 5).map((key) => ({ id: key, label: `${key} ${this.fmt(this.tunables[key])}` }));\\n    if (start + 5 < keys.length) rows.push({ id: 'more', label: 'More' });\\n    else if (this.devPage > 0) rows.push({ id: 'prev', label: 'Previous' });\\n    rows.push({ id: 'reset-tab', label: 'Reset tab' });\\n    rows.push({ id: 'reset-all', label: 'Reset all' });\\n    return rows;\\n  }\\n\\n  toolLabel(id, label) {\\n    if (id === 'day') return `Day ${this.guest?.day || 1}`;\\n    if (id === 'jump') return `Jump ${ACTIVITIES[this.jumpPick]?.name || ''}`;\\n    if (id === 'finish') return `Finish ${this.finishPick} stars`;\\n    if (id === 'auto') return `Autopilot ${this.driver || 'off'}`;\\n    if (id === 'god') return this.god ? 'God: on' : 'God: off';\\n    if (id === 'time') return `Time ${this.engine?.timeScale ?? 0}`;\\n    if (id === 'overlay') return this.overlay ? 'Overlay: on' : 'Overlay: off';\\n    if (id === 'hud') return this.hideHud ? 'HUD: hidden' : 'HUD: shown';\\n    if (id === 'anim') return `Anim ${this.viewerClip || 'idle'}`;\\n    return label;\\n  }\\n\\n  fmt(n) {\\n    const v = Math.round(n * 1000) / 1000;\\n    return String(v);\\n  }\\n\\n  isOpen(def) {\\n    if (!def) return false;\\n    if (this.drop || this.guest?.unlockAll) return true;\\n    if (!this.guest) return false;\\n    return isUnlocked(def, this.guest.day, false);\\n  }\\n\\n  startActivity(id) {\\n    const def = ACTIVITY_BY_ID[id];\\n    if (!def) return;\\n    const bot = !!this.driver;\\n    this.activityId = id;\\n    this.sim = createSim(id, {\\n      tunables: this.tunables,\\n      rand: this.fork(`act-${id}`),\\n      botRand: this.fork(`bot-${id}`),\\n      skill: this.driver || 'idle',\\n      hard: !!this.guest?.hard,\\n      gentle: !!this.settings.gentle,\\n      god: !!this.god || this.attracting,\\n      first: bot ? false : !(this.guest?.records?.[id]?.plays),\\n      practice: bot ? false : undefined,\\n      skipIntro: bot || this.attracting,\\n    });\\n    this.mode = 'activity';\\n    this.frozen = false;\\n    if (this.engine && this.engine.timeScale === 0) this.engine.timeScale = 1;\\n    this.refresh(true);\\n  }\\n\\n  startWeigh() {\\n    const kind = dayInfo(this.guest?.day || 1).test;\\n    const { WeighSim } = weighCtor();\\n    this.weigh = new WeighSim(kind, {\\n      tunables: this.tunables,\\n      rand: this.fork('weigh'),\\n      botRand: this.fork('weigh-bot'),\\n      skill: this.driver || 'idle',\\n    });\\n    this.mode = 'weigh';\\n    this.sim = null;\\n  }\\n\\n  prescriptionNow() {\\n    const g = this.guest;\\n    if (!g || this.drop) return false;\\n    const goal = dayInfo(g.day).goal;\\n    const t = g.today;\\n    if (!goal || !t) return false;\\n    if (goal.kind === 'pair') return t.ids.includes(goal.id) && t.ids.length >= 2;\\n    if (goal.kind === 'stars') return t.bestStar >= goal.n;\\n    if (goal.kind === 'fresh') return !!t.fresh;\\n    if (goal.kind === 'count') return t.plays >= goal.n;\\n    if (goal.kind === 'beat') return !!t.beat?.[goal.who];\\n    if (goal.kind === 'id') return t.ids.includes(goal.id);\\n    return false;\\n  }\\n\\n  finishActivity() {\\n    const sim = this.sim;\\n    if (!sim) return;\\n    if (!sim.done) sim.finish();\\n    const stars = sim.stars | 0;\\n    const seconds = sim.seconds || sim.playT || 0;\\n    const score = sim.score || 0;\\n    const id = sim.def.id;\\n    this.lastStars = stars;\\n    this.lastScore = score;\\n    this.lastSeconds = seconds;\\n    const before = this.prescriptionNow();\\n    if (this.guest && !this.drop) {\\n      const t = this.guest.today;\\n      t.plays += 1;\\n      if (!t.ids.includes(id)) t.ids.push(id);\\n      t.bestStar = Math.max(t.bestStar, stars);\\n      const rec = this.guest.records[id] || { bestStars: 0, bestScore: 0, plays: 0 };\\n      rec.plays += 1;\\n      rec.bestStars = Math.max(rec.bestStars, stars);\\n      rec.bestScore = Math.max(rec.bestScore, score);\\n      this.guest.records[id] = rec;\\n      if (rec.plays === 1) t.fresh = true;\\n      for (const who of ['dennis', 'june', 'marguerite']) {\\n        if (beats(sim.def, score, stars, who)) t.beat[who] = true;\\n      }\\n      this.guest.totalStars += stars;\\n      const bonus = !before && this.prescriptionNow();\\n      const drips = dripsFor(stars, seconds, bonus, this.tunables.dripRate);\\n      this.guest.drips += drips;\\n      this.lastDrips = drips;\\n      this.lastPrescription = bonus;\\n      this.guest.items = milestonesReached(this.guest.drips).map((item) => item.id);\\n      this.persist();\\n    } else {\\n      const rec = this.dropRecords[id] || { bestStars: 0, plays: 0 };\\n      rec.plays += 1;\\n      rec.bestStars = Math.max(rec.bestStars, stars);\\n      this.dropRecords[id] = rec;\\n      this.lastDrips = 0;\\n      this.lastPrescription = false;\\n    }\\n    this.mode = 'results';\\n    this.dialogue = lineText(id, stars, (this.guest?.records?.[id]?.plays || 0) > 1);\\n    this.refresh(true);\\n  }\\n\\n  finishWeigh() {\\n    const T = this.weigh?.Tscore || 0;\\n    if (this.guest && !this.drop) {\\n      this.guest.samples.push(T);\\n      const trueAge = wobbleAge(this.guest.samples, this.guest.totalStars, this.tunables.ageTrainingWeight);\\n      const shown = this.guest.confessed ? trueAge : trueAge + 7;\\n      this.guest.chart.push({ day: this.guest.day, t: T, trueAge, shown });\\n      this.persist();\\n    }\\n    this.question = questionFor(this.guest?.day || 1);\\n    this.mode = 'question';\\n    this.refresh(true);\\n  }\\n\\n  confess() {\\n    const g = this.guest;\\n    if (!g || g.confessed) return;\\n    for (const point of g.chart) point.shown -= 7;\\n    g.confessed = true;\\n    this.persist();\\n  }\\n\\n  nextDay() {\\n    const g = this.guest;\\n    if (!g) return;\\n    g.day += 1;\\n    g.week = g.day >= 8 ? 2 : 1;\\n    g.today = emptyToday();\\n    this.persist();\\n    this.startWeigh();\\n  }\\n\\n  persist() {\\n    if (this.session) return;\\n    const data = this.save.read();\\n    if (this.guest && this.slot != null && !this.drop) data.slots[this.slot] = this.guest;\\n    data.settings = { ...this.settings };\\n    this.save.write(data);\\n  }\\n\\n  activate(id) {\\n    if (this.mode === 'title' && id === 'start') {\\n      if (this.touchOnly) return;\\n      this.mode = 'menu';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'menu') {\\n      if (id === 'week') { this.drop = false; this.mode = 'slots'; }\\n      else if (id === 'dropin') { this.drop = true; this.guest = freshGuest('Drop In'); this.guest.unlockAll = true; this.mode = 'island'; }\\n      else if (id === 'family') { this.seats = [null, null, null, null]; this.mode = 'join'; }\\n      else if (id === 'settings') { this.setPage = 0; this.mode = 'settings'; }\\n      else if (id === 'about') { this.aboutPage = 0; this.mode = 'about'; }\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'slots') {\\n      if (id === 'back') { this.mode = 'menu'; this.refresh(true); return; }\\n      const index = Number(id.replace('slot', ''));\\n      this.slot = index;\\n      const existing = this.save.read().slots[index];\\n      if (existing) {\\n        this.guest = existing;\\n        this.guest.today = this.guest.today || emptyToday();\\n        if (!this.guest.ferried) this.mode = 'ferry';\\n        else this.startWeigh();\\n      } else {\\n        this.nameBuf = 'Guest';\\n        this.guest = null;\\n        this.mode = 'name';\\n      }\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'name' && id === 'done') {\\n      this.guest = freshGuest(this.nameBuf || 'Guest');\\n      this.persist();\\n      this.mode = 'ferry';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'ferry' && id === 'board') {\\n      this.guest.ferried = true;\\n      this.persist();\\n      this.startWeigh();\\n      return;\\n    }\\n    if (this.mode === 'question' && id.startsWith('a')) {\\n      this.answer = Number(id.slice(1));\\n      if (this.guest) this.guest.felt = this.question?.remarks?.[this.answer] || '';\\n      this.mode = 'reveal';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'reveal') { this.mode = 'island'; this.islandPage = 0; this.refresh(true); return; }\\n    if (this.mode === 'island') return this.activateIsland(id);\\n    if (this.mode === 'station') return this.activateStation(id);\\n    if (this.mode === 'results') {\\n      if (id === 'retry') this.startActivity(this.activityId);\\n      else if (id === 'next') { this.mode = 'station'; this.refresh(true); }\\n      else { this.mode = 'island'; this.refresh(true); }\\n      return;\\n    }\\n    if (this.mode === 'hammock' && id === 'rest') { this.mode = 'report'; this.refresh(true); return; }\\n    if (this.mode === 'report' && id === 'sleep') {\\n      const playedLong = this.guest?.today?.ids?.includes('longstand');\\n      if (this.guest?.day === 7 && playedLong && !this.guest.confessed) {\\n        this.mode = 'confession';\\n        this.refresh(true);\\n      } else this.nextDay();\\n      return;\\n    }\\n    if (this.mode === 'confession') { this.confess(); this.mode = 'credits'; this.refresh(true); return; }\\n    if (this.mode === 'credits') { this.nextDay(); return; }\\n    if (this.mode === 'settings') return this.activateSettings(id);\\n    if ((this.mode === 'about' || this.mode === 'howto' || this.mode === 'hall' || this.mode === 'jar' || this.mode === 'locker') && id === 'back') {\\n      this.mode = this.frozen ? 'pause' : 'island';\\n      if (this.mode === 'island' && !this.guest) this.mode = 'menu';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'locker') return this.cycleLook(id);\\n    if (this.mode === 'pause') return this.activatePause(id);\\n    if (this.mode === 'dev') return this.activateDev(id);\\n    if (this.mode === 'join') return this.activateJoin(id);\\n    if (this.mode === 'podium') {\\n      if (id === 'again') this.openMedley({ family: true });\\n      else { this.mode = 'menu'; this.refresh(true); }\\n      return;\\n    }\\n    if (this.mode === 'dropin' && id === 'play') { this.mode = 'island'; this.refresh(true); }\\n  }\\n\\n  activateIsland(id) {\\n    if (id === 'more') { this.islandPage = 1; this.refresh(true); return; }\\n    if (id === 'back') { this.islandPage = 0; this.refresh(true); return; }\\n    if (id === 'hammock') { this.mode = 'hammock'; this.refresh(true); return; }\\n    if (id === 'jar') { this.mode = 'jar'; this.refresh(true); return; }\\n    if (id === 'locker') { this.mode = 'locker'; this.refresh(true); return; }\\n    if (id === 'hall') { this.mode = 'hall'; this.refresh(true); return; }\\n    if (id === 'longstand') { this.startActivity('longstand'); return; }\\n    if (id.startsWith('st-')) {\\n      this.station = id.slice(3);\\n      this.mode = 'station';\\n      this.refresh(true);\\n    }\\n  }\\n\\n  activateStation(id) {\\n    if (id === 'back') { this.mode = 'island'; this.refresh(true); return; }\\n    if (id === 'hard') {\\n      if (this.guest) this.guest.hard = !this.guest.hard;\\n      this.refresh(false);\\n      return;\\n    }\\n    if (id.startsWith('act-')) this.startActivity(id.slice(4));\\n  }\\n\\n  activateSettings(id) {\\n    const s = this.settings;\\n    if (id === 'more') { this.setPage = 1; this.refresh(true); return; }\\n    if (id === 'back') {\\n      this.persist();\\n      this.mode = this.frozen ? 'pause' : 'menu';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'glyphs') s.glyphs = s.glyphs === 'xbox' ? 'playstation' : 'xbox';\\n    if (id === 'gentle') s.gentle = !s.gentle;\\n    if (id === 'flashes') s.flashes = !s.flashes;\\n    if (id === 'look') {\\n      const i = LOOKS.indexOf(s.look);\\n      s.look = LOOKS[(i + 1) % LOOKS.length];\\n      this.applyLook();\\n    }\\n    if (id === 'pixel') {\\n      s.pixel = s.pixel === 'chunky' ? 'fine' : 'chunky';\\n      try { this.engine?.settings?.set?.({ pixelSize: s.pixel }); } catch { /* headless */ }\\n    }\\n    if (id === 'full') this.fullscreen();\\n    if (id === 'reset') this.resetSettings();\\n    this.persist();\\n    this.refresh(false);\\n  }\\n\\n  nudgeSetting(id, dir) {\\n    const s = this.settings;\\n    if (id === 'music') s.music = clamp01(s.music + dir * 0.05);\\n    if (id === 'sfx') s.sfx = clamp01(s.sfx + dir * 0.05);\\n    if (id === 'voice') s.voice = clamp01(s.voice + dir * 0.05);\\n    if (id === 'radius') this.tunables.mouseLeanRadius = clamp(this.tunables.mouseLeanRadius + dir * 2, 20, 160);\\n    if (id === 'offset') this.tunables.stepOffsetMs = clamp(this.tunables.stepOffsetMs + dir * 5, -80, 80);\\n    this.applyVolumes();\\n    this.refresh(false);\\n  }\\n\\n  resetSettings() {\\n    this.settings.music = 0.1;\\n    this.settings.sfx = 1;\\n    this.settings.voice = 1;\\n    this.settings.master = 1;\\n    this.settings.glyphs = 'playstation';\\n    this.settings.gentle = false;\\n    this.settings.flashes = false;\\n    this.settings.look = 'default';\\n    this.settings.pixel = 'fine';\\n    this.tunables.mouseLeanRadius = DEFAULT_TUNABLES.mouseLeanRadius;\\n    this.tunables.stepOffsetMs = DEFAULT_TUNABLES.stepOffsetMs;\\n    this.applyVolumes();\\n    this.applyLook();\\n  }\\n\\n  applyVolumes() {\\n    const audio = this.engine?.audio;\\n    if (!audio?.setVolume) return;\\n    audio.setVolume('music', this.settings.music);\\n    audio.setVolume('sfx', this.settings.sfx);\\n    audio.setVolume('master', this.settings.master ?? 1);\\n    this.busMusic = audio.volume?.music ?? this.settings.music;\\n  }\\n\\n  applyLook() {\\n    const engine = this.engine;\\n    if (!engine) return;\\n    const name = this.settings.look;\\n    try {\\n      if (name === 'default') return;\\n      const preset = engine.lookPresets?.[name];\\n      if (preset) engine.setLook(preset);\\n      else engine.settings?.set?.({ look: name });\\n    } catch { /* unknown look name */ }\\n  }\\n\\n  fullscreen() {\\n    const el = globalThis.document?.documentElement;\\n    try { el?.requestFullscreen?.(); } catch { /* no display */ }\\n  }\\n\\n  cycleLook(id) {\\n    if (id === 'back' || !this.guest) return;\\n    const choices = LOOK_CHOICES[id];\\n    if (!choices) return;\\n    const cur = this.guest.look[id];\\n    const i = choices.indexOf(cur);\\n    this.guest.look[id] = choices[(i + 1) % choices.length];\\n    this.refresh(false);\\n  }\\n\\n  openPause() {\\n    if (this.mode === 'pause' || this.mode === 'dev') return;\\n    this.returnMode = this.mode;\\n    this.mode = 'pause';\\n    this.frozen = !this.session;\\n    if (this.frozen && this.engine) this.engine.timeScale = 0;\\n    this.refresh(true);\\n  }\\n\\n  activatePause(id) {\\n    if (id === 'resume') {\\n      this.mode = this.returnMode || 'title';\\n      this.frozen = false;\\n      if (this.engine) this.engine.timeScale = 1;\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'restart') { this.startActivity(this.activityId); return; }\\n    if (id === 'island') {\\n      this.frozen = false;\\n      if (this.engine) this.engine.timeScale = 1;\\n      this.mode = 'island';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'settings') { this.setPage = 0; this.mode = 'settings'; this.refresh(true); return; }\\n    if (id === 'howto') { this.mode = 'howto'; this.refresh(true); return; }\\n    if (id === 'about') { this.aboutPage = 0; this.mode = 'about'; this.refresh(true); return; }\\n    if (id === 'dev' && !this.session) {\\n      this.mode = 'dev';\\n      this.devTab = 0;\\n      this.devPage = 0;\\n      if (this.engine && !this.session) this.engine.timeScale = 0;\\n      this.refresh(true);\\n    }\\n  }\\n\\n  activateDev(id) {\\n    if (id === 'more') {\\n      if (this.devTabName() === 'Tools') this.toolPage += 1;\\n      else this.devPage += 1;\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'prev') {\\n      if (this.devTabName() === 'Tools') this.toolPage = Math.max(0, this.toolPage - 1);\\n      else this.devPage = Math.max(0, this.devPage - 1);\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'back') { this.mode = 'pause'; this.refresh(true); return; }\\n    if (id === 'reset-tab') { this.resetTab(); return; }\\n    if (id === 'reset-all') { this.resetAll(); return; }\\n    if (TUNABLE_TABS[this.devTabName()]?.some((row) => row[0] === id)) return;\\n    this.runTool(id);\\n    this.refresh(false);\\n  }\\n\\n  nudgeTunable(id, dir) {\\n    const tab = this.devTabName();\\n    const row = (TUNABLE_TABS[tab] || []).find((r) => r[0] === id);\\n    if (!row) return;\\n    const [, , lo, hi, step] = row;\\n    const next = clamp(this.tunables[id] + dir * step, lo, hi);\\n    this.tunables[id] = Math.round(next * 1000) / 1000;\\n    this.refresh(false);\\n  }\\n\\n  resetTab() {\\n    const tab = this.devTabName();\\n    for (const key of tabKeys(tab)) this.tunables[key] = DEFAULT_TUNABLES[key];\\n    this.refresh(false);\\n  }\\n\\n  resetAll() {\\n    for (const key of Object.keys(DEFAULT_TUNABLES)) this.tunables[key] = DEFAULT_TUNABLES[key];\\n    this.refresh(false);\\n  }\\n\\n  runTool(id) {\\n    if (!this.guest) this.guest = freshGuest('Guest');\\n    if (id === 'day') {\\n      const day = (this.guest.day % 7) + 1;\\n      this.guest.day = day;\\n      this.guest.week = 1;\\n      this.guest.today = emptyToday();\\n    } else if (id === 'jump') {\\n      this.jumpPick = (this.jumpPick + 1) % ACTIVITIES.length;\\n      this.frozen = false;\\n      this.startActivity(ACTIVITIES[this.jumpPick].id);\\n    } else if (id === 'finish') {\\n      this.finishPick = (this.finishPick + 1) % 4;\\n      if (this.sim) {\\n        this.sim.done = true;\\n        this.sim.stars = this.finishPick;\\n        this.sim.score = this.sim.def.thresholds[Math.max(0, this.finishPick - 1)] || 0;\\n        this.sim.seconds = Math.max(1, this.sim.playT || 1);\\n        this.finishActivity();\\n      }\\n    } else if (id === 'drips') {\\n      this.guest.drips += 50;\\n      this.guest.items = milestonesReached(this.guest.drips).map((item) => item.id);\\n      this.persist();\\n    } else if (id === 'unlock') {\\n      this.guest.unlockAll = true;\\n    } else if (id === 'auto') {\\n      this.skillPick = (this.skillPick + 1) % SKILLS.length;\\n      this.setDriver(SKILLS[this.skillPick]);\\n    } else if (id === 'god') {\\n      this.god = !this.god;\\n      if (this.sim) this.sim.god = this.god;\\n    } else if (id === 'time') {\\n      this.timePick = (this.timePick + 1) % SCALES.length;\\n      if (this.engine) this.engine.timeScale = SCALES[this.timePick];\\n    } else if (id === 'overlay') {\\n      this.overlay = !this.overlay;\\n    } else if (id === 'hud') {\\n      this.hideHud = !this.hideHud;\\n    } else if (id === 'camera') {\\n      try { this.engine?.setCamera({ preset: 'free' }, { syncUrl: false }); } catch { /* no rig */ }\\n      this.freeCam = true;\\n    } else if (id === 'line') {\\n      this.linePick = (this.linePick + 1) % 3;\\n      this.dialogue = ['Stand.', 'The circle noticed.', 'See you tomorrow. Bring your knees.'][this.linePick];\\n      this.spoken = '';\\n    } else if (id === 'sound') {\\n      this.soundPick = (this.soundPick + 1) % (Object.keys(SONGS).length + 1);\\n      const names = Object.keys(SONGS);\\n      if (this.soundPick === 0) this.engine?.audio?.play?.('chime');\\n      else {\\n        const name = names[this.soundPick - 1];\\n        this.engine?.audio?.playMusic?.(SONGS[name], name);\\n        this.songPlaying = name;\\n      }\\n    } else if (id === 'anim') {\\n      const names = ['Tree', 'Heron', 'SquatRep', 'Press', 'StepL'];\\n      this.animPick = (this.animPick + 1) % names.length;\\n      this.viewerClip = names[this.animPick];\\n    } else if (id === 'wipe') {\\n      this.save.clear();\\n      this.guest = null;\\n      this.slot = 0;\\n    } else if (id === 'export') {\\n      const changed = {};\\n      for (const key of Object.keys(DEFAULT_TUNABLES)) {\\n        if (this.tunables[key] !== DEFAULT_TUNABLES[key]) changed[key] = this.tunables[key];\\n      }\\n      this.exported = JSON.stringify(changed);\\n      try { console.log(this.exported); } catch { /* no console */ }\\n    }\\n  }\\n\\n  activateJoin(id) {\\n    if (id === 'back') { this.mode = 'menu'; this.refresh(true); return; }\\n    if (id === 'fill') {\\n      const skills = ['sloppy', 'average', 'good', 'expert'];\\n      let n = 0;\\n      for (let i = 0; i < 4; i++) if (!this.seats[i]) this.seats[i] = { kind: 'bot', skill: skills[n++] || 'average' };\\n      this.refresh(false);\\n      return;\\n    }\\n    if (id === 'start') {\\n      if (!this.seats.some(Boolean)) return;\\n      this.openMedley({ family: true });\\n    }\\n  }\\n\\n  claim(seat) {\\n    if (seat.kind === 'pad' && this.seats.some((s) => s && s.kind === 'pad' && s.index === seat.index)) return;\\n    if (seat.kind === 'key' && this.seats.some((s) => s && s.kind === 'key')) return;\\n    const index = this.seats.findIndex((s) => !s);\\n    if (index < 0) return;\\n    this.seats[index] = seat;\\n    this.refresh(false);\\n  }\\n\\n  pollJoin(ctx) {\\n    let pads = [];\\n    try { pads = globalThis.navigator?.getGamepads?.() || []; } catch { pads = []; }\\n    for (let i = 0; i < 4; i++) {\\n      const down = !!pads[i]?.buttons?.[0]?.pressed;\\n      if (down && !this.prevPad[i]) this.claim({ kind: 'pad', index: i });\\n      this.prevPad[i] = down;\\n    }\\n    if (this.edge(ctx, 'Enter')) this.claim({ kind: 'key' });\\n  }\\n\\n  openMedley(arg = {}) {\\n    this.picks = medleyPicks(this.fork('medley'));\\n    this.medleyT = 0;\\n    this.lanes = [];\\n    if (arg.family) {\\n      for (const seat of this.seats) if (seat) this.lanes.push(this.makeLane(seat));\\n    } else if (arg.bots) {\\n      const skills = arg.skills || ['expert', 'good', 'average', 'sloppy'];\\n      skills.forEach((skill) => this.lanes.push(this.makeLane({ kind: 'bot', skill })));\\n    } else if (arg.hub) {\\n      this.lanes.push(this.makeLane({ kind: 'key', skill: 'idle' }));\\n    } else {\\n      this.lanes.push(this.makeLane({ kind: 'bot', skill: this.driver || 'expert' }));\\n    }\\n    if (arg.ghost) this.addGhost();\\n    this.mode = 'medley';\\n    this.hubClock = !!arg.hub;\\n    this.refresh(true);\\n  }\\n\\n  makeLane(seat) {\\n    const lane = {\\n      kind: seat.kind,\\n      index: seat.index ?? 0,\\n      skill: seat.skill || 'average',\\n      driver: seat.kind === 'pad' ? new PadDriver(seat.index) : seat.kind === 'key' ? new LocalDriver() : null,\\n      ghost: seat.kind === 'ghost' ? new GhostDriver() : null,\\n      simulated: seat.kind !== 'ghost',\\n      steps: 0,\\n      pos: 0,\\n      scores: [0, 0, 0],\\n      sim: null,\\n      event: -1,\\n      dot: seat.kind === 'ghost' ? new Dot(() => 0.5) : null,\\n    };\\n    return lane;\\n  }\\n\\n  addGhost() {\\n    const lane = this.makeLane({ kind: 'ghost' });\\n    this.lanes.push(lane);\\n    return lane;\\n  }\\n\\n  laneTotal(lane) {\\n    return lane.scores.reduce((a, b) => a + b, 0);\\n  }\\n\\n  fixed(ctx, dt) {\\n    this.ctx = ctx;\\n    if (this.mode === 'activity' && this.sim && !this.sim.done) {\\n      this.sim.gentle = !!this.settings.gentle;\\n      this.sim.god = !!this.god;\\n      const input = this.driver ? this.sim.auto(dt) : this.local.readFrom(ctx, this.device.kind, { x: ctx.hud.width / 2, y: ctx.hud.height / 2 }, this.tunables.mouseLeanRadius, dt);\\n      this.sim.step(dt, input);\\n      if (this.sim.done) this.finishActivity();\\n    } else if (this.mode === 'weigh' && this.weigh && !this.weigh.done) {\\n      const input = this.driver ? this.weigh.auto(dt) : this.local.readFrom(ctx, this.device.kind, { x: ctx.hud.width / 2, y: ctx.hud.height / 2 }, this.tunables.mouseLeanRadius, dt);\\n      this.weigh.step(dt, input);\\n      if (this.weigh.done) this.finishWeigh();\\n    } else if (this.mode === 'attract' && this.sim) {\\n      this.sim.step(dt, this.sim.auto(dt));\\n      this.attractT += dt;\\n      if (this.attractT >= 14 || this.sim.done) {\\n        this.attractI += 1;\\n        this.attractT = 0;\\n        this.beginAttract();\\n      }\\n    } else if (this.mode === 'medley') {\\n      this.tickMedley(ctx, dt);\\n    }\\n  }\\n\\n  tickMedley(ctx, dt) {\\n    if (this.hubClock && this.hub) {\\n      const ms = this.hub.time?.() ?? -Infinity;\\n      if (!(ms >= 0)) return;\\n      this.medleyT = ms / 1000;\\n    }\\n    const win = medleyWindow(this.medleyT);\\n    for (const lane of this.lanes) {\\n      if (lane.kind === 'ghost') {\\n        lane.ghost.present(dt);\\n        continue;\\n      }\\n      if (win.phase === 'play') {\\n        const id = [this.picks.still, this.picks.beat, this.picks.lean][win.index];\\n        if (lane.event !== win.index) {\\n          if (lane.event >= 0 && lane.sim) {\\n            const max = lane.sim.def.thresholds?.[2] || 1;\\n            lane.scores[lane.event] = normalise(lane.sim.score || 0, max);\\n          }\\n          lane.sim = createSim(id, {\\n            tunables: this.tunables,\\n            rand: this.fork(`m-${id}`),\\n            botRand: this.fork(`mb-${id}`),\\n            skill: lane.kind === 'bot' ? lane.skill : (this.driver || 'idle'),\\n            skipIntro: true,\\n            first: false,\\n            practice: false,\\n          });\\n          lane.event = win.index;\\n          lane.dot = lane.sim.dot;\\n        }\\n        let input;\\n        if (lane.kind === 'bot' || (lane.kind !== 'pad' && lane.kind !== 'key' && this.driver)) input = lane.sim.auto(dt);\\n        else if (lane.kind === 'bot') input = lane.sim.auto(dt);\\n        else if (lane.kind === 'pad') input = lane.driver.read();\\n        else if (lane.kind === 'key') input = lane.driver.readFrom(ctx, 'keyboard', { x: ctx.hud.width / 2, y: ctx.hud.height / 2 }, this.tunables.mouseLeanRadius, dt);\\n        else input = lane.sim.auto(dt);\\n        lane.sim.step(dt, input);\\n        lane.steps += 1;\\n        lane.pos = lane.sim.dot ? lane.sim.dot.x : (lane.sim.x || 0);\\n      }\\n    }\\n    if (!this.hubClock) this.medleyT += dt;\\n    if (this.medleyT >= MEDLEY_SPAN && this.mode === 'medley') this.finishMedley();\\n    const player = this.lanes.find((lane) => lane.kind !== 'ghost');\\n    this.hubScore = player ? this.laneTotal(player) + (player.sim?.score || 0) : 0;\\n  }\\n\\n  finishMedley() {\\n    for (const lane of this.lanes) {\\n      if (lane.sim && lane.event >= 0 && lane.kind !== 'ghost') {\\n        const max = lane.sim.def.thresholds?.[2] || 1;\\n        lane.scores[lane.event] = normalise(lane.sim.score || 0, max);\\n      }\\n    }\\n    this.mode = 'podium';\\n    this.refresh(true);\\n    if (this.hub) this.hubResult();\\n  }\\n\\n  beginAttract() {\\n    const id = ATTRACT[this.attractI % ATTRACT.length];\\n    const tunables = { ...this.tunables, ringScale: (this.tunables.ringScale || 1) * 2 };\\n    this.sim = createSim(id, {\\n      tunables,\\n      rand: this.fork(`at-${id}`),\\n      botRand: this.fork(`atb-${id}`),\\n      skill: 'expert',\\n      god: true,\\n      skipIntro: true,\\n      first: false,\\n      practice: false,\\n    });\\n    this.activityId = id;\\n    this.attracting = true;\\n    this.mode = 'attract';\\n  }\\n\\n  update(ctx, dt) {\\n    this.ctx = ctx;\\n    this.engine = ctx.engine;\\n    this.device.update(ctx);\\n    if (ctx.audio?.volume) this.busMusic = ctx.audio.volume.music;\\n    if (this.mode === 'card') this.cardInput(ctx);\\n    if (this.mode === 'join') this.pollJoin(ctx);\\n    if (this.mode === 'name') this.typeName(ctx);\\n    const kind = this.device.kind;\\n    if (this.touchOnly && (kind === 'keyboard' || kind === 'pad') && this.anyPressed(ctx)) this.touchOnly = false;\\n    if (this.mode === 'attract' && this.anyInput(ctx)) {\\n      this.attracting = false;\\n      this.sim = null;\\n      this.idle = 0;\\n      this.mode = 'title';\\n      this.refresh(true);\\n      this.draw(ctx);\\n      return;\\n    }\\n    const pause = this.edge(ctx, 'KeyP') || (this.edge(ctx, 'PadOptions') && !ctx.input.isDown('PadCreate')) || (this.edge(ctx, 'Escape') && PAUSABLE.has(this.mode));\\n    if (pause && PAUSABLE.has(this.mode)) this.openPause();\\n    else if (this.rows.length && this.mode !== 'activity' && this.mode !== 'weigh' && this.mode !== 'attract' && this.mode !== 'card') this.menuInput(ctx);\\n    if (!this.session && MENU_IDLE.has(this.mode)) {\\n      if (this.anyInput(ctx)) this.idle = 0;\\n      else this.idle += dt > 0 ? dt : 1 / 60;\\n      if (this.idle >= 10) {\\n        this.attractI = 0;\\n        this.attractT = 0;\\n        this.idle = 0;\\n        this.beginAttract();\\n      }\\n    } else if (this.mode !== 'attract') this.idle = 0;\\n    if (this.mode === 'dev') {\\n      const tab = this.edge(ctx, 'KeyE') || this.edge(ctx, 'PadR1');\\n      const prev = this.edge(ctx, 'KeyQ') || this.edge(ctx, 'PadL1');\\n      const names = [...Object.keys(TUNABLE_TABS), 'Tools'];\\n      if (tab) { this.devTab = (this.devTab + 1) % names.length; this.devPage = 0; this.refresh(true); }\\n      if (prev) { this.devTab = (this.devTab + names.length - 1) % names.length; this.devPage = 0; this.refresh(true); }\\n    }\\n    if (this.mode === 'about' && (this.edge(ctx, 'ArrowRight') || this.edge(ctx, 'PadR1'))) this.aboutPage += 1;\\n    if (this.mode === 'about' && (this.edge(ctx, 'ArrowLeft') || this.edge(ctx, 'PadL1'))) this.aboutPage = Math.max(0, this.aboutPage - 1);\\n    this.syncSong(ctx);\\n    this.syncSpeech(ctx);\\n    this.hover(ctx);\\n    this.draw(ctx);\\n  }\\n\\n  cardInput(ctx) {\\n    const hub = this.hub || globalThis.AIHub;\\n    if (!hub?.answer) return;\\n    if (this.edge(ctx, 'Enter') || this.edge(ctx, 'PadCross')) hub.answer('ready');\\n    if (this.edge(ctx, 'KeyM') || this.edge(ctx, 'PadTriangle')) hub.answer('more');\\n  }\\n\\n  typeName(ctx) {\\n    const input = ctx.input;\\n    if (this.edge(ctx, 'Backspace')) this.nameBuf = this.nameBuf.slice(0, -1);\\n    for (let i = 0; i < 26; i++) {\\n      const code = `Key${String.fromCharCode(65 + i)}`;\\n      if (input.wasPressed(code) && this.nameBuf.length < 8) this.nameBuf += String.fromCharCode(97 + i);\\n    }\\n    this.rows = this.rowsFor();\\n  }\\n\\n  menuInput(ctx) {\\n    if (!this.rows.length) return;\\n    if (this.pressedAny(ctx, DOWN) || (this.mode !== 'island' && this.mode !== 'activity' && this.edge(ctx, 'KeyS'))) {\\n      this.focus = (this.focus + 1) % this.rows.length;\\n    } else if (this.pressedAny(ctx, UP) || (this.mode !== 'island' && this.edge(ctx, 'KeyW'))) {\\n      this.focus = (this.focus + this.rows.length - 1) % this.rows.length;\\n    } else if (this.pressedAny(ctx, LEFT)) {\\n      this.nudge(-1);\\n    } else if (this.pressedAny(ctx, RIGHT)) {\\n      this.nudge(1);\\n    } else if (this.pressedAny(ctx, PRESS) || (this.mode !== 'name' && this.edge(ctx, 'KeyE'))) {\\n      const row = this.rows[this.focus];\\n      if (row) this.activate(row.id);\\n    } else if (this.pressedAny(ctx, BACK) && this.mode !== 'pause') {\\n      this.back();\\n    }\\n  }\\n\\n  nudge(dir) {\\n    const row = this.rows[this.focus];\\n    if (!row) return;\\n    if (this.mode === 'dev') this.nudgeTunable(row.id, dir);\\n    if (this.mode === 'settings') this.nudgeSetting(row.id, dir);\\n    if (this.mode === 'locker') this.cycleLook(row.id);\\n  }\\n\\n  back() {\\n    const map = {\\n      slots: 'menu', station: 'island', settings: this.frozen ? 'pause' : 'menu',\\n      about: this.frozen ? 'pause' : 'menu', howto: 'pause', locker: 'island',\\n      hall: 'island', jar: 'island', join: 'menu', name: 'slots', ferry: 'slots',\\n      results: 'island', dev: 'pause',\\n    };\\n    if (map[this.mode]) {\\n      this.mode = map[this.mode];\\n      this.refresh(true);\\n    }\\n  }\\n\\n  hover(ctx) {\\n    if (this.device.kind !== 'mouse') return;\\n    const p = ctx.input.pointer;\\n    if (!p) return;\\n    const ax = ((p.x + 1) / 2) * ctx.hud.width;\\n    const ay = ((1 - p.y) / 2) * ctx.hud.height;\\n    this.widgets.forEach((w, i) => {\\n      if (!String(w.id).startsWith('row-')) return;\\n      if (ax >= w.x && ax <= w.x + w.w && ay >= w.y && ay <= w.y + w.h) {\\n        const id = w.id.slice(4);\\n        const index = this.rows.findIndex((row) => row.id === id);\\n        if (index >= 0) this.focus = index;\\n      }\\n    });\\n  }\\n\\n  syncSong(ctx) {\\n    let key = 'plaza';\\n    if (this.mode === 'activity' || this.mode === 'attract') key = SONG_FOR[ACTIVITY_BY_ID[this.activityId]?.kind] || 'plaza';\\n    else if (this.mode === 'report' || this.mode === 'confession') key = 'report';\\n    else if (this.mode === 'island') key = 'plaza';\\n    else if (this.mode === 'medley') key = 'hoop';\\n    if (this.songPlaying === key) return;\\n    const song = SONGS[key];\\n    if (song && ctx.audio?.playMusic) {\\n      ctx.audio.playMusic(song, key);\\n      this.songPlaying = key;\\n    }\\n  }\\n\\n  syncSpeech(ctx) {\\n    let line = '';\\n    let speaker = 'ounce';\\n    if (this.mode === 'results') { line = this.dialogue; speaker = 'ounce'; }\\n    else if (this.mode === 'ferry') { line = 'The ferry is on time. Your knees are a separate matter.'; }\\n    else if (this.mode === 'confession') { line = 'I have been adding seven. It felt like kindness. It was not.'; }\\n    else if (this.mode === 'reveal' && this.guest?.chart?.length) {\\n      const last = this.guest.chart[this.guest.chart.length - 1];\\n      line = `Your Wobble Age is ${last.shown}. Is that close?`;\\n    } else if (this.mode === 'dev' && this.dialogue) { line = this.dialogue; speaker = 'coach'; }\\n    else if (this.mode === 'attract') { line = 'This is a recording. The person in it is doing better than you.'; }\\n    if (!line || line === this.spoken) return;\\n    this.spoken = line;\\n    if ((this.settings.voice ?? 1) <= 0) return;\\n    import('./audio/voice.js').then((mod) => mod.speak(ctx, line, speaker)).catch(() => {});\\n  }\\n\\n  edge(ctx, code) {\\n    return !!ctx.input.wasPressed(code);\\n  }\\n\\n  pressedAny(ctx, codes) {\\n    return codes.some((code) => ctx.input.wasPressed(code));\\n  }\\n\\n  anyPressed(ctx) {\\n    return ANY.some((code) => ctx.input.wasPressed(code));\\n  }\\n\\n  anyInput(ctx) {\\n    const input = ctx.input;\\n    if (Math.hypot(input.mouseDelta?.x || 0, input.mouseDelta?.y || 0) > 2) return true;\\n    if (input.wheel) return true;\\n    if (Math.hypot(input.padAxis?.x || 0, input.padAxis?.y || 0) > 0.3) return true;\\n    return this.anyPressed(ctx);\\n  }\\n\\n  bindHub(hub) {\\n    this.hub = hub;\\n    this.session = this.session || { hub: true };\\n    hub.on?.('card', (card) => { this.card = card; });\\n    hub.on?.('start', () => {\\n      this.hubLive = true;\\n      this.hubScore = 0;\\n      this.openMedley({ hub: true });\\n      this.hubPulse();\\n      if (this._hubTimer) clearInterval(this._hubTimer);\\n      this._hubTimer = setInterval(() => this.hubPulse(), 100);\\n    });\\n    hub.on?.('message', (data, from) => this.ghostMessage(data, from));\\n    hub.on?.('leave', (info) => { if (info?.id != null) this.leftIds.add(info.id); });\\n    hub.on?.('time-up', () => this.hubResult());\\n    hub.on?.('end', () => this.hubStop());\\n  }\\n\\n  ghostMessage(data, from) {\\n    if (!data || from == null) return;\\n    let lane = this.lanes.find((item) => item.kind === 'ghost' && item.from === from);\\n    if (!lane) {\\n      lane = this.addGhost();\\n      lane.from = from;\\n    }\\n    lane.ghost.push(data);\\n  }\\n\\n  hubPulse() {\\n    if (!this.hubLive || this.hubEnded || !this.hub) return;\\n    const lane = this.lanes.find((item) => item.kind !== 'ghost');\\n    const score = this.hubScore || 0;\\n    const win = medleyWindow(Math.max(0, this.medleyT));\\n    try {\\n      this.hub.send({ a: win.index || 0, x: lane?.pos || 0, y: 0, c: 0, t: lane?.sim?.playT || 0, s: score }, { reliable: false });\\n      this.hub.progress({ score, label: 'Medley' });\\n    } catch { /* the round may already be over */ }\\n  }\\n\\n  hubResult() {\\n    if (this.resultSent || !this.hub) return;\\n    this.resultSent = true;\\n    this.hubLive = false;\\n    try {\\n      this.hub.result({\\n        score: this.hubScore || 0,\\n        stats: { events: 3 },\\n        awards: [{ title: 'Stillest', detail: 'You stayed.' }],\\n      });\\n    } catch { /* already sent */ }\\n  }\\n\\n  hubStop() {\\n    this.hubEnded = true;\\n    this.hubLive = false;\\n    if (this._hubTimer) clearInterval(this._hubTimer);\\n    this._hubTimer = null;\\n    try { this.engine?.audio?.stopMusic?.(); } catch { /* quiet */ }\\n  }\\n\\n  widget(id, x, y, w, h) {\\n    this.widgets.push({ id, x, y, w, h });\\n  }\\n\\n  status() {\\n    if (this.mode === 'activity' && this.sim) {\\n      return `activity ${this.activityId} | ${this.sim.phase} | t ${this.sim.playT.toFixed(1)} | score ${Math.round(this.sim.score)}`;\\n    }\\n    if (this.mode === 'medley') return `medley | t ${this.medleyT.toFixed(1)} | score ${Math.round(this.hubScore || 0)}`;\\n    return `${this.mode} | day ${this.guest?.day || 0}`;\\n  }\\n\\n  fingerprint() {\\n    const dot = this.sim?.dot || this.weigh?.dot;\\n    const x = dot ? dot.x.toFixed(4) : '0';\\n    const y = dot ? dot.y.toFixed(4) : '0';\\n    return `${this.mode}|${this.guest?.day || 0}|${Math.round(this.sim?.score || 0)}|${x},${y}`;\\n  }\\n\\n  state() {\\n    const row = this.rows[this.focus];\\n    return {\\n      title: this.title,\\n      mode: this.mode,\\n      focus: this.focus,\\n      row: row?.id || '',\\n      rows: this.rows.map((r) => r.id),\\n      device: this.device.kind,\\n      glyphs: this.settings.glyphs,\\n      glyph: glyphKind(this.device.kind, this.settings.glyphs),\\n      prompt: promptFor(this.device.kind, this.settings.glyphs, this.mode === 'title' ? 'Start' : 'Confirm'),\\n      touchOnly: this.touchOnly,\\n      touchMessage: this.touchOnly ? 'Controller or keyboard required' : '',\\n      music: this.busMusic,\\n      day: this.guest?.day || 0,\\n      week: this.guest?.week || 0,\\n      name: this.guest?.name || '',\\n      drips: this.guest?.drips || 0,\\n      stars: this.lastStars,\\n      score: this.lastScore,\\n      seconds: this.lastSeconds,\\n      lastDrips: this.lastDrips,\\n      lastPrescription: this.lastPrescription,\\n      activity: this.activityId,\\n      confessed: !!this.guest?.confessed,\\n      chart: (this.guest?.chart || []).map((p) => ({ day: p.day, t: p.t, trueAge: p.trueAge, shown: p.shown })),\\n      items: this.guest?.items || [],\\n      tunables: { ...this.tunables },\\n      settings: { ...this.settings },\\n      widgets: this.widgets.map((w) => ({ ...w })),\\n      overlay: this.overlay,\\n      god: this.god,\\n      driver: this.driver,\\n      attract: this.mode === 'attract',\\n      attractId: this.mode === 'attract' ? this.activityId : '',\\n      hideHud: this.hideHud,\\n      frozen: this.frozen,\\n      timeScale: this.engine?.timeScale,\\n      session: !!this.session,\\n      dialogue: this.dialogue,\\n      viewerClip: this.viewerClip,\\n      exported: this.exported,\\n      freeCam: !!this.freeCam,\\n      lanes: this.lanes.map((lane) => ({\\n        kind: lane.kind,\\n        pos: lane.pos,\\n        steps: lane.steps,\\n        simulated: lane.simulated,\\n        t: lane.dot?.t || 0,\\n        scores: lane.scores,\\n      })),\\n      medleyT: this.medleyT,\\n      picks: this.picks,\\n      seats: this.seats.map((s) => (s ? s.kind : null)),\\n      devTab: this.devTabName(),\\n      phase: this.sim?.phase || this.weigh?.kind || '',\\n      playT: this.sim?.playT || this.weigh?.t || 0,\\n    };\\n  }\\n\\n  draw(ctx) {\\n    const hud = ctx.hud;\\n    if (!hud?.clear) return;\\n    hud.clear();\\n    this.widgets = [];\\n    if (this.hideHud) {\\n      if (hud.visible != null) hud.visible = false;\\n      return;\\n    }\\n    if (hud.visible != null) hud.visible = true;\\n    const view = { hud, app: this, w: hud.width, h: hud.height };\\n    paint(view);\\n  }\\n}\\n\\nfunction clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\\nfunction clamp01(v) { return clamp(v, 0, 1); }\\n\\nfunction weighCtor() {\\n  return { WeighSim: createSim.WeighSim || null };\\n}\\n\\nimport { WeighSim } from './core/sims.js';\\nimport { say, measureText, wrapText } from './ui/font.js';\\nimport { aboutPages, MEDICAL } from './data/about.js';\\nimport { CREDITS_TEXT } from './data/creditsText.js';\\nimport { TAGLINE } from './data/title.js';\\n\\nApp.prototype.startWeigh = function startWeigh() {\\n  const kind = dayInfo(this.guest?.day || 1).test;\\n  this.weigh = new WeighSim(kind, {\\n    tunables: this.tunables,\\n    rand: this.fork('weigh'),\\n    botRand: this.fork('weigh-bot'),\\n    skill: this.driver || 'idle',\\n  });\\n  this.mode = 'weigh';\\n  this.sim = null;\\n  this.refresh(true);\\n};\\n\\nfunction marginOf(w) { return w < 200 ? 4 : 12; }\\n\\nfunction paint(view) {\\n  const { hud, app, w, h } = view;\\n  const m = marginOf(w);\\n  const narrow = w < 220;\\n  const scale = narrow ? 1 : 2;\\n  const titleScale = w < 220 ? 2 : w < 400 ? 3 : 4;\\n  let y = m;\\n  const head = (text, sc = titleScale, color = 'white') => {\\n    y = line(view, 'title', text, y, sc, color);\\n  };\\n  if (app.mode === 'title' || app.mode === 'attract') {\\n    hud.rect(0, 0, w, Math.min(h, 78), 'navy');\\n    app.widget('band', 0, 0, w, Math.min(h, 78));\\n    head(TITLE, titleScale, 'cyan');\\n    y = line(view, 'tag', TAGLINE, y, narrow ? 1 : 2, 'sand');\\n    if (app.touchOnly) {\\n      for (const part of wrapText('Controller or keyboard required', Math.max(8, Math.floor((w - m * 2) / (6 * (narrow ? 1 : 2)))))) {\\n        y = line(view, 'touch', part, y, narrow ? 1 : 2, 'sand');\\n      }\\n    }\\n    if (app.mode === 'attract') y = line(view, 'rec', 'Press any button', y, scale, 'sand');\\n  } else if (app.mode === 'card') {\\n    head(TITLE, titleScale, 'cyan');\\n    y = line(view, 'goal', 'Score the most across three events.', y, 1, 'sand');\\n    y = line(view, 'how', 'Stay in the circle.', y, 1, 'white');\\n    const players = app.session?.players || app.hub?.players || [];\\n    players.slice(0, 4).forEach((p, i) => {\\n      y = line(view, `seat-${i}`, `${p.name || 'Guest'}`, y, 1, 'white');\\n    });\\n    const left = app.card?.left;\\n    y = line(view, 'time', left == null ? 'Starting' : `${Math.ceil(left / 1000)}s`, y, scale, 'cyan');\\n    y = line(view, 'ready', 'Enter ready', y, 1, 'sand');\\n  } else {\\n    const title = heading(app);\\n    y = line(view, 'head', title, y, scale, 'cyan');\\n  }\\n  if (app.mode === 'activity' || app.mode === 'weigh' || app.mode === 'attract') {\\n    y = line(view, 'phase', phaseLine(app), y, 1, 'sand');\\n    drawPips(view, app.mode === 'activity' ? (app.sim?.stars || 0) : 0, m, h - m - 10);\\n  }\\n  if (app.mode === 'results') {\\n    y = line(view, 'act', ACTIVITY_BY_ID[app.activityId]?.name || '', y, 1, 'white');\\n    const bits = wrapText(app.dialogue || '', 52).slice(0, 3);\\n    bits.forEach((part, i) => { y = line(view, `line-${i}`, part, y, 1, 'sand'); });\\n    y = line(view, 'drips', `Drips ${app.lastDrips}`, y, scale, 'cyan');\\n    drawPips(view, app.lastStars, m, y);\\n    y += 16;\\n  }\\n  if (app.mode === 'reveal' && app.guest?.chart?.length) {\\n    const last = app.guest.chart[app.guest.chart.length - 1];\\n    y = line(view, 'age', String(last.shown), y, titleScale, 'white');\\n    y = line(view, 'felt', wrapText(app.guest.felt || 'Noted.', 40)[0], y, 1, 'sand');\\n  }\\n  if (app.mode === 'report' && app.guest) {\\n    const last = app.guest.chart[app.guest.chart.length - 1];\\n    y = line(view, 'age', last ? String(last.shown) : '--', y, titleScale, 'white');\\n    const info = dayInfo(app.guest.day);\\n    y = line(view, 'concern', wrapText(`Concern: ${info.concern}`, 40)[0], y, 1, 'sand');\\n  }\\n  if (app.mode === 'confession') {\\n    y = line(view, 'sorry', 'I have been adding seven.', y, 1, 'sand');\\n  }\\n  if (app.mode === 'hammock') {\\n    const guilt = app.guest?.today?.plays ? 'Rest. The day is filed.' : 'The hammock kept the day. The jar did not.';\\n    y = line(view, 'guilt', guilt, y, 1, 'sand');\\n  }\\n  if (app.mode === 'jar' && app.guest) {\\n    y = line(view, 'jar-n', String(app.guest.drips), y, titleScale, 'cyan');\\n    for (const item of milestonesReached(app.guest.drips).slice(0, 4)) y = line(view, item.id, item.name, y, 1, 'white');\\n  }\\n  if (app.mode === 'hall' && app.guest) {\\n    const last = app.guest.chart[app.guest.chart.length - 1];\\n    y = line(view, 'hall-n', last ? String(last.shown) : '--', y, titleScale, 'white');\\n  }\\n  if (app.mode === 'about') {\\n    const pages = aboutPages(CREDITS_TEXT);\\n    const page = pages[Math.min(app.aboutPage, pages.length - 1)];\\n    y = line(view, 'about-h', page.title, y, scale, 'cyan');\\n    page.lines.slice(0, 6).forEach((text, i) => {\\n      const bits = wrapText(text, narrow ? 26 : 40).slice(0, 2);\\n      bits.forEach((part, j) => { y = line(view, `about-${i}-${j}`, part, y, 1, 'white'); });\\n    });\\n  }\\n  if (app.mode === 'howto') {\\n    y = line(view, 'how1', 'Lean to keep the dot in the circle.', y, 1, 'white');\\n    y = line(view, 'how2', 'Breathe on the beat. Step on the beat.', y, 1, 'sand');\\n  }\\n  if (app.mode === 'medley' || app.mode === 'podium') {\\n    app.lanes.forEach((lane, i) => {\\n      y = line(view, `lane-${i}`, `${lane.kind} ${Math.round(app.laneTotal(lane))}`, y, 1, 'white');\\n    });\\n  }\\n  if (app.mode === 'join') {\\n    app.seats.forEach((seat, i) => {\\n      y = line(view, `seat-${i}`, seat ? `${i + 1} ${seat.kind}` : `${i + 1} empty`, y, 1, 'sand');\\n    });\\n  }\\n  if (app.overlay) y = line(view, 'overlay', app.status().slice(0, 48), y, 1, 'lime');\\n  const rows = app.rows;\\n  const rowScale = scale;\\n  const rowH = 9 * rowScale + 6;\\n  let ry = Math.min(y + 8, h - m - rows.length * rowH);\\n  if (ry < m) ry = m;\\n  rows.forEach((row, i) => {\\n    const mark = i === app.focus ? '> ' : '  ';\\n    const text = `${mark}${row.label}`.slice(0, narrow ? 28 : 36);\\n    const width = measureText(text, rowScale).width;\\n    const x = m;\\n    if (ry + rowH <= h) {\\n      app.widget(`row-${row.id}`, x, ry, Math.min(width, w - m * 2), 9 * rowScale);\\n      say(hud, x, ry, text, { scale: rowScale, color: i === app.focus ? 'sand' : 'white' });\\n    }\\n    ry += rowH;\\n  });\\n  const prompt = app.state().prompt;\\n  const py = h - m - 9;\\n  if (py > 0) {\\n    app.widget('prompt', m, py, measureText(prompt, 1).width, 9);\\n    say(hud, m, py, prompt, { scale: 1, color: 'mist' });\\n  }\\n  if (app.mode === 'title') {\\n    const medical = wrapText(MEDICAL, narrow ? 26 : 46)[0];\\n    say(hud, m, h - m - 20, medical, { scale: 1, color: 'mist' });\\n  }\\n}\\n\\nfunction line(view, id, text, y, scale, color) {\\n  const { hud, app, w, h } = view;\\n  const m = marginOf(w);\\n  const shown = String(text || '').slice(0, 52);\\n  if (!shown || y > h - 8) return y;\\n  const width = measureText(shown, scale).width;\\n  let x = Math.max(m, Math.floor((w - width) / 2));\\n  if (x + width > w - 2) x = m;\\n  app.widget(id, x, y, Math.min(width, w - x), 9 * scale);\\n  say(hud, x, y, shown, { scale, color });\\n  return y + 9 * scale + 3;\\n}\\n\\nfunction drawPips(view, stars, x, y) {\\n  const { hud, app } = view;\\n  for (let i = 0; i < 3; i++) {\\n    hud.rect(x + i * 10, y, 7, 7, i < stars ? 'sand' : 'slate');\\n  }\\n  app.widget('stars', x, y, 28, 7);\\n}\\n\\nfunction heading(app) {\\n  if (app.mode === 'menu') return 'Mint Dial';\\n  if (app.mode === 'weigh') return 'Weigh in';\\n  if (app.mode === 'island') return app.guest ? `Day ${app.guest.day}` : 'Island';\\n  if (app.mode === 'station') return STATIONS.find((s) => s.id === app.station)?.name?.split(' ').slice(0, 3).join(' ') || 'Station';\\n  if (app.mode === 'pause') return 'Paused';\\n  if (app.mode === 'dev') return app.devTabName();\\n  if (app.mode === 'settings') return 'Settings';\\n  if (app.mode === 'name') return 'Your name';\\n  if (app.mode === 'ferry') return 'The ferry';\\n  if (app.mode === 'question') return 'One question';\\n  if (app.mode === 'results') return 'Results';\\n  if (app.mode === 'report') return 'Evening';\\n  if (app.mode === 'confession') return 'A correction';\\n  if (app.mode === 'credits') return 'Credits';\\n  if (app.mode === 'join') return 'Family Hour';\\n  if (app.mode === 'podium') return 'Podium';\\n  if (app.mode === 'locker') return 'Locker';\\n  if (app.mode === 'hall') return 'Hall';\\n  if (app.mode === 'jar') return 'Sweat jar';\\n  if (app.mode === 'hammock') return 'Hammock';\\n  if (app.mode === 'about') return 'About';\\n  return app.mode;\\n}\\n\\nfunction phaseLine(app) {\\n  if (app.mode === 'weigh') return `${app.weigh?.kind || ''} ${Math.floor(app.weigh?.t || 0)}s`;\\n  if (!app.sim) return '';\\n  return `${app.sim.phase} ${Math.floor(app.sim.playT)}s`;\\n}\\n\\n// The class method above was replaced. Drop the unused helper's throw path.\\nvoid weighCtor;\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/app.js has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/app.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/app.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"import { TITLE } from './data/title.js';\\nimport { ACTIVITIES, ACTIVITY_BY_ID, STATIONS, activitiesAt, rivalScore } from './data/activities.js';\\nimport { dayInfo, isUnlocked } from './data/week.js';\\nimport { questionFor } from './data/questions.js';\\nimport { medleyPicks, medleyWindow, normalise, MEDLEY_SPAN } from './data/medley.js';\\nimport { lineText } from './data/lines.js';\\nimport { LOOK_CHOICES, PLAYER_LOOK } from './art/avatar.js';\\nimport { SONGS, SONG_FOR } from './audio/songs.js';\\nimport { dripsFor, milestonesReached, wobbleAge } from './core/score.js';\\nimport { Save } from './core/save.js';\\nimport { cloneTunables, DEFAULT_TUNABLES, TUNABLE_TABS, tabKeys } from './core/tunables.js';\\nimport { Device } from './core/device.js';\\nimport { promptFor, glyphKind } from './core/actions.js';\\nimport { LocalDriver, PadDriver, GhostDriver } from './core/drivers.js';\\nimport { createSim } from './core/sims.js';\\nimport { Dot } from './core/dot.js';\\nimport { mulberry32, hashString } from './core/rng.js';\\n\\nconst MENU_IDLE = new Set([\\n  'title', 'menu', 'slots', 'name', 'settings', 'about', 'howto', 'dropin',\\n  'station', 'ferry', 'join', 'results', 'reveal', 'question', 'report',\\n  'locker', 'hall', 'jar', 'credits', 'confession', 'podium',\\n]);\\nconst PAUSABLE = new Set(['activity', 'weigh', 'island', 'medley']);\\nconst PRESS = ['Enter', 'Space', 'PadCross', 'MouseLeft'];\\nconst BACK = ['Escape', 'Backspace', 'PadCircle', 'MouseRight'];\\nconst DOWN = ['ArrowDown', 'PadDown'];\\nconst UP = ['ArrowUp', 'PadUp'];\\nconst LEFT = ['ArrowLeft', 'PadLeft'];\\nconst RIGHT = ['ArrowRight', 'PadRight'];\\nconst ANY = [...PRESS, ...BACK, ...DOWN, ...UP, ...LEFT, ...RIGHT, 'KeyP', 'KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyQ', 'KeyF', 'KeyJ', 'KeyM', 'PadOptions', 'PadTriangle', 'PadL1', 'PadR1'];\\nconst ATTRACT = ['tree', 'hoop', 'header', 'step', 'slack', 'tray', 'pier', 'jog', 'squat', 'longstand'];\\nconst DEV_TOOLS = [\\n  ['day', 'Go to day'],\\n  ['jump', 'Jump activity'],\\n  ['finish', 'Finish stars'],\\n  ['drips', 'Give 50 drips'],\\n  ['unlock', 'Unlock all'],\\n  ['auto', 'Autopilot'],\\n  ['god', 'God mode'],\\n  ['time', 'Time scale'],\\n  ['overlay', 'Overlay'],\\n  ['hud', 'Hide HUD'],\\n  ['camera', 'Free camera'],\\n  ['line', 'Dialogue line'],\\n  ['sound', 'Sound test'],\\n  ['anim', 'Anim viewer'],\\n  ['wipe', 'Reset save'],\\n  ['export', 'Export JSON'],\\n];\\nconst SCALES = [0.25, 0.5, 1, 2, 3];\\nconst SKILLS = [null, 'idle', 'sloppy', 'average', 'good', 'expert'];\\nconst LOOKS = ['default', 'storybook', 'arcade', 'handheld'];\\n\\nfunction emptyToday() {\\n  return { plays: 0, ids: [], bestStar: 0, beat: {}, fresh: false };\\n}\\n\\nexport function freshGuest(name = 'Guest') {\\n  return {\\n    name: String(name || 'Guest').slice(0, 8) || 'Guest',\\n    look: { ...PLAYER_LOOK },\\n    day: 1,\\n    week: 1,\\n    drips: 0,\\n    totalStars: 0,\\n    samples: [],\\n    chart: [],\\n    confessed: false,\\n    ferried: false,\\n    records: {},\\n    items: [],\\n    today: emptyToday(),\\n    place: 'pavilion',\\n    felt: '',\\n    hard: false,\\n    unlockAll: false,\\n  };\\n}\\n\\nfunction beats(def, score, stars, who) {\\n  const rival = rivalScore(def, who);\\n  if (def.kind === 'slack') return stars > rival;\\n  return score > rival;\\n}\\n\\nexport class App {\\n  constructor(opts = {}) {\\n    this.title = TITLE;\\n    this.save = new Save(opts.storage === undefined ? undefined : opts.storage);\\n    const disk = this.save.read();\\n    this.tunables = cloneTunables();\\n    this.settings = {\\n      music: 0.1,\\n      sfx: 1,\\n      voice: 1,\\n      master: 1,\\n      glyphs: 'playstation',\\n      gentle: false,\\n      flashes: false,\\n      look: 'default',\\n      pixel: 'fine',\\n    };\\n    if (disk.settings) Object.assign(this.settings, disk.settings);\\n    if (!disk.settings) this.settings.music = 0.1;\\n    this.session = opts.session || null;\\n    this.touchOnly = !!opts.touchOnly;\\n    this.mode = this.session ? 'card' : 'title';\\n    this.device = new Device();\\n    this.local = new LocalDriver();\\n    this.driver = null;\\n    this.god = false;\\n    this.hideHud = false;\\n    this.overlay = false;\\n    this.focus = 0;\\n    this.rows = [];\\n    this.idle = 0;\\n    this.widgets = [];\\n    this.slot = 0;\\n    this.guest = null;\\n    this.nameBuf = 'Guest';\\n    this.drop = false;\\n    this.sim = null;\\n    this.weigh = null;\\n    this.activityId = '';\\n    this.station = 'pavilion';\\n    this.islandPage = 0;\\n    this.returnMode = 'title';\\n    this.frozen = false;\\n    this.devTab = 0;\\n    this.devPage = 0;\\n    this.toolPage = 0;\\n    this.finishPick = 0;\\n    this.timePick = 0;\\n    this.skillPick = 0;\\n    this.jumpPick = 0;\\n    this.soundPick = 0;\\n    this.animPick = 0;\\n    this.linePick = 0;\\n    this.aboutPage = 0;\\n    this.creditPage = 0;\\n    this.question = null;\\n    this.answer = 0;\\n    this.lastStars = 0;\\n    this.lastScore = 0;\\n    this.lastSeconds = 0;\\n    this.lastDrips = 0;\\n    this.lastPrescription = false;\\n    this.spoken = '';\\n    this.songPlaying = '';\\n    this.attracting = false;\\n    this.attractI = 0;\\n    this.attractT = 0;\\n    this.forkN = 0;\\n    this.ctx = null;\\n    this.engine = null;\\n    this.lanes = [];\\n    this.seats = [null, null, null, null];\\n    this.prevPad = [false, false, false, false];\\n    this.medleyT = 0;\\n    this.picks = null;\\n    this.hub = null;\\n    this.hubLive = false;\\n    this.hubEnded = false;\\n    this.resultSent = false;\\n    this.hubScore = 0;\\n    this.card = null;\\n    this.leftIds = new Set();\\n    this.viewerClip = '';\\n    this.dialogue = '';\\n    this.exported = '';\\n    this.dropRecords = {};\\n    this.held = new Set();\\n    this.busMusic = 0.1;\\n    this.refresh(true);\\n  }\\n\\n  fork(label) {\\n    this.forkN += 1;\\n    const id = `${label}:${this.forkN}`;\\n    if (this.ctx?.random) {\\n      const rng = this.ctx.random.fork(id);\\n      return () => rng.next();\\n    }\\n    return mulberry32(hashString(id) || 1);\\n  }\\n\\n  go(mode, arg) {\\n    if (mode === 'activity') {\\n      this.startActivity(typeof arg === 'string' ? arg : arg?.id);\\n      return;\\n    }\\n    if (mode === 'medley') {\\n      this.openMedley(arg || {});\\n      return;\\n    }\\n    this.mode = mode;\\n    if (mode === 'title') {\\n      this.attracting = false;\\n      this.drop = false;\\n      this.idle = 0;\\n    }\\n    if (mode === 'island') this.islandPage = 0;\\n    if (mode === 'name') this.focus = 0;\\n    this.refresh(mode !== 'dev');\\n  }\\n\\n  setDriver(skill) {\\n    this.driver = skill || null;\\n    this.skillPick = Math.max(0, SKILLS.indexOf(this.driver));\\n    if (this.sim?.setSkill && this.driver) this.sim.setSkill(this.driver);\\n  }\\n\\n  refresh(resetFocus = false) {\\n    this.rows = this.rowsFor().slice(0, 8);\\n    if (resetFocus) this.focus = 0;\\n    if (this.focus >= this.rows.length) this.focus = Math.max(0, this.rows.length - 1);\\n  }\\n\\n  rowsFor() {\\n    const g = this.guest;\\n    switch (this.mode) {\\n      case 'title':\\n        return [{ id: 'start', label: 'Start' }];\\n      case 'menu':\\n        return [\\n          { id: 'week', label: 'Week' },\\n          { id: 'dropin', label: 'Drop-In' },\\n          { id: 'family', label: 'Family Hour' },\\n          { id: 'settings', label: 'Settings' },\\n          { id: 'about', label: 'About' },\\n        ];\\n      case 'slots':\\n        return [0, 1, 2].map((i) => {\\n          const slot = this.save.read().slots[i];\\n          return { id: `slot${i}`, label: slot ? `Guest ${i + 1}: ${slot.name}` : `Guest ${i + 1}: empty` };\\n        }).concat([{ id: 'back', label: 'Back' }]);\\n      case 'name':\\n        return [{ id: 'done', label: `Done (${this.nameBuf || 'Guest'})` }];\\n      case 'ferry':\\n        return [{ id: 'board', label: 'Board' }];\\n      case 'question':\\n        return (this.question?.answers || []).map((label, i) => ({ id: `a${i}`, label }));\\n      case 'reveal':\\n        return [{ id: 'onward', label: 'Onward' }];\\n      case 'island':\\n        return this.islandRows();\\n      case 'station':\\n        return this.stationRows();\\n      case 'results':\\n        return [\\n          { id: 'retry', label: 'Retry' },\\n          { id: 'next', label: 'Next' },\\n          { id: 'back', label: 'Island' },\\n        ];\\n      case 'hammock':\\n        return [{ id: 'rest', label: 'Rest' }];\\n      case 'report':\\n        return [{ id: 'sleep', label: 'Sleep' }];\\n      case 'confession':\\n        return [{ id: 'onward', label: 'Onward' }];\\n      case 'credits':\\n        return [{ id: 'onward', label: 'Onward' }];\\n      case 'settings':\\n        return this.settingsRows();\\n      case 'about':\\n      case 'howto':\\n        return [{ id: 'back', label: 'Back' }];\\n      case 'pause':\\n        return this.session\\n          ? [{ id: 'resume', label: 'Resume' }, { id: 'settings', label: 'Settings' }]\\n          : [\\n            { id: 'resume', label: 'Resume' },\\n            { id: 'restart', label: 'Restart' },\\n            { id: 'island', label: 'Island' },\\n            { id: 'settings', label: 'Settings' },\\n            { id: 'howto', label: 'How to play' },\\n            { id: 'about', label: 'About' },\\n            { id: 'dev', label: 'Dev Tools' },\\n          ];\\n      case 'dev':\\n        return this.devRows();\\n      case 'join':\\n        return [\\n          { id: 'fill', label: 'Fill with classmates' },\\n          { id: 'start', label: 'Start' },\\n          { id: 'back', label: 'Back' },\\n        ];\\n      case 'podium':\\n        return [{ id: 'again', label: 'Rematch' }, { id: 'back', label: 'Back' }];\\n      case 'locker':\\n        return [\\n          { id: 'skin', label: `Skin ${g?.look?.skin || ''}` },\\n          { id: 'hair', label: `Hair ${g?.look?.hair || ''}` },\\n          { id: 'top', label: `Top ${g?.look?.top || ''}` },\\n          { id: 'bottom', label: `Bottom ${g?.look?.bottom || ''}` },\\n          { id: 'headband', label: `Band ${g?.look?.headband || ''}` },\\n          { id: 'back', label: 'Back' },\\n        ];\\n      case 'hall':\\n      case 'jar':\\n        return [{ id: 'back', label: 'Back' }];\\n      case 'dropin':\\n        return [{ id: 'play', label: 'Play' }, { id: 'back', label: 'Back' }];\\n      default:\\n        return [];\\n    }\\n  }\\n\\n  islandRows() {\\n    if (this.islandPage === 0) {\\n      return [\\n        ...STATIONS.map((s) => ({ id: `st-${s.id}`, label: s.name.replace(' of Holding Still', '').replace('The ', '').replace('Jogging Path', 'Jog') })),\\n        { id: 'more', label: 'More' },\\n      ];\\n    }\\n    const rows = [\\n      { id: 'jar', label: 'Sweat Jar' },\\n      { id: 'locker', label: 'Locker' },\\n      { id: 'hall', label: 'Hall' },\\n      { id: 'hammock', label: 'Hammock' },\\n    ];\\n    if (this.isOpen(ACTIVITY_BY_ID.longstand)) rows.push({ id: 'longstand', label: 'Long Stand' });\\n    rows.push({ id: 'back', label: 'Back' });\\n    return rows;\\n  }\\n\\n  stationRows() {\\n    const rows = activitiesAt(this.station).filter((a) => this.isOpen(a)).map((a) => ({ id: `act-${a.id}`, label: a.name }));\\n    if ((this.guest && (this.guest.day >= 6 || this.guest.unlockAll)) || this.drop) {\\n      rows.push({ id: 'hard', label: this.guest?.hard ? 'Hard: on' : 'Hard: off' });\\n    }\\n    rows.push({ id: 'back', label: 'Back' });\\n    return rows.slice(0, 8);\\n  }\\n\\n  settingsRows() {\\n    const s = this.settings;\\n    if ((this.setPage || 0) === 0) {\\n      return [\\n        { id: 'music', label: `Music ${Math.round(s.music * 100)}` },\\n        { id: 'sfx', label: `SFX ${Math.round(s.sfx * 100)}` },\\n        { id: 'voice', label: `Voice ${Math.round(s.voice * 100)}` },\\n        { id: 'glyphs', label: s.glyphs === 'xbox' ? 'Glyphs: Xbox' : 'Glyphs: PlayStation' },\\n        { id: 'gentle', label: s.gentle ? 'Gentle: on' : 'Gentle: off' },\\n        { id: 'more', label: 'More' },\\n      ];\\n    }\\n    return [\\n      { id: 'radius', label: `Mouse radius ${this.tunables.mouseLeanRadius}` },\\n      { id: 'offset', label: `Step offset ${this.tunables.stepOffsetMs}` },\\n      { id: 'flashes', label: s.flashes ? 'Flashes: low' : 'Flashes: on' },\\n      { id: 'look', label: `Look ${s.look}` },\\n      { id: 'pixel', label: `Pixels ${s.pixel}` },\\n      { id: 'full', label: 'Fullscreen' },\\n      { id: 'reset', label: 'Reset' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  }\\n\\n  devTabName() {\\n    return [...Object.keys(TUNABLE_TABS), 'Tools'][this.devTab] || 'Balance';\\n  }\\n\\n  devRows() {\\n    const tab = this.devTabName();\\n    if (tab === 'Tools') {\\n      const start = this.toolPage * 5;\\n      const slice = DEV_TOOLS.slice(start, start + 5).map(([id, label]) => ({ id, label: this.toolLabel(id, label) }));\\n      const rows = slice;\\n      if (start + 5 < DEV_TOOLS.length) rows.push({ id: 'more', label: 'More' });\\n      else if (this.toolPage > 0) rows.push({ id: 'prev', label: 'Previous' });\\n      rows.push({ id: 'back', label: 'Back' });\\n      return rows;\\n    }\\n    const keys = tabKeys(tab);\\n    const start = this.devPage * 5;\\n    const rows = keys.slice(start, start + 5).map((key) => ({ id: key, label: `${key} ${this.fmt(this.tunables[key])}` }));\\n    if (start + 5 < keys.length) rows.push({ id: 'more', label: 'More' });\\n    else if (this.devPage > 0) rows.push({ id: 'prev', label: 'Previous' });\\n    rows.push({ id: 'reset-tab', label: 'Reset tab' });\\n    rows.push({ id: 'reset-all', label: 'Reset all' });\\n    return rows;\\n  }\\n\\n  toolLabel(id, label) {\\n    if (id === 'day') return `Day ${this.guest?.day || 1}`;\\n    if (id === 'jump') return `Jump ${ACTIVITIES[this.jumpPick]?.name || ''}`;\\n    if (id === 'finish') return `Finish ${this.finishPick} stars`;\\n    if (id === 'auto') return `Autopilot ${this.driver || 'off'}`;\\n    if (id === 'god') return this.god ? 'God: on' : 'God: off';\\n    if (id === 'time') return `Time ${this.engine?.timeScale ?? 0}`;\\n    if (id === 'overlay') return this.overlay ? 'Overlay: on' : 'Overlay: off';\\n    if (id === 'hud') return this.hideHud ? 'HUD: hidden' : 'HUD: shown';\\n    if (id === 'anim') return `Anim ${this.viewerClip || 'idle'}`;\\n    return label;\\n  }\\n\\n  fmt(n) {\\n    const v = Math.round(n * 1000) / 1000;\\n    return String(v);\\n  }\\n\\n  isOpen(def) {\\n    if (!def) return false;\\n    if (this.drop || this.guest?.unlockAll) return true;\\n    if (!this.guest) return false;\\n    return isUnlocked(def, this.guest.day, false);\\n  }\\n\\n  startActivity(id) {\\n    const def = ACTIVITY_BY_ID[id];\\n    if (!def) return;\\n    const bot = !!this.driver;\\n    this.activityId = id;\\n    this.sim = createSim(id, {\\n      tunables: this.tunables,\\n      rand: this.fork(`act-${id}`),\\n      botRand: this.fork(`bot-${id}`),\\n      skill: this.driver || 'idle',\\n      hard: !!this.guest?.hard,\\n      gentle: !!this.settings.gentle,\\n      god: !!this.god || this.attracting,\\n      first: bot ? false : !(this.guest?.records?.[id]?.plays),\\n      practice: bot ? false : undefined,\\n      skipIntro: bot || this.attracting,\\n    });\\n    this.mode = 'activity';\\n    this.frozen = false;\\n    if (this.engine && this.engine.timeScale === 0) this.engine.timeScale = 1;\\n    this.refresh(true);\\n  }\\n\\n  startWeigh() {\\n    const kind = dayInfo(this.guest?.day || 1).test;\\n    const { WeighSim } = weighCtor();\\n    this.weigh = new WeighSim(kind, {\\n      tunables: this.tunables,\\n      rand: this.fork('weigh'),\\n      botRand: this.fork('weigh-bot'),\\n      skill: this.driver || 'idle',\\n    });\\n    this.mode = 'weigh';\\n    this.sim = null;\\n  }\\n\\n  prescriptionNow() {\\n    const g = this.guest;\\n    if (!g || this.drop) return false;\\n    const goal = dayInfo(g.day).goal;\\n    const t = g.today;\\n    if (!goal || !t) return false;\\n    if (goal.kind === 'pair') return t.ids.includes(goal.id) && t.ids.length >= 2;\\n    if (goal.kind === 'stars') return t.bestStar >= goal.n;\\n    if (goal.kind === 'fresh') return !!t.fresh;\\n    if (goal.kind === 'count') return t.plays >= goal.n;\\n    if (goal.kind === 'beat') return !!t.beat?.[goal.who];\\n    if (goal.kind === 'id') return t.ids.includes(goal.id);\\n    return false;\\n  }\\n\\n  finishActivity() {\\n    const sim = this.sim;\\n    if (!sim) return;\\n    if (!sim.done) sim.finish();\\n    const stars = sim.stars | 0;\\n    const seconds = sim.seconds || sim.playT || 0;\\n    const score = sim.score || 0;\\n    const id = sim.def.id;\\n    this.lastStars = stars;\\n    this.lastScore = score;\\n    this.lastSeconds = seconds;\\n    const before = this.prescriptionNow();\\n    if (this.guest && !this.drop) {\\n      const t = this.guest.today;\\n      t.plays += 1;\\n      if (!t.ids.includes(id)) t.ids.push(id);\\n      t.bestStar = Math.max(t.bestStar, stars);\\n      const rec = this.guest.records[id] || { bestStars: 0, bestScore: 0, plays: 0 };\\n      rec.plays += 1;\\n      rec.bestStars = Math.max(rec.bestStars, stars);\\n      rec.bestScore = Math.max(rec.bestScore, score);\\n      this.guest.records[id] = rec;\\n      if (rec.plays === 1) t.fresh = true;\\n      for (const who of ['dennis', 'june', 'marguerite']) {\\n        if (beats(sim.def, score, stars, who)) t.beat[who] = true;\\n      }\\n      this.guest.totalStars += stars;\\n      const bonus = !before && this.prescriptionNow();\\n      const drips = dripsFor(stars, seconds, bonus, this.tunables.dripRate);\\n      this.guest.drips += drips;\\n      this.lastDrips = drips;\\n      this.lastPrescription = bonus;\\n      this.guest.items = milestonesReached(this.guest.drips).map((item) => item.id);\\n      this.persist();\\n    } else {\\n      const rec = this.dropRecords[id] || { bestStars: 0, plays: 0 };\\n      rec.plays += 1;\\n      rec.bestStars = Math.max(rec.bestStars, stars);\\n      this.dropRecords[id] = rec;\\n      this.lastDrips = 0;\\n      this.lastPrescription = false;\\n    }\\n    this.mode = 'results';\\n    this.dialogue = lineText(id, stars, (this.guest?.records?.[id]?.plays || 0) > 1);\\n    this.refresh(true);\\n  }\\n\\n  finishWeigh() {\\n    const T = this.weigh?.Tscore || 0;\\n    if (this.guest && !this.drop) {\\n      this.guest.samples.push(T);\\n      const trueAge = wobbleAge(this.guest.samples, this.guest.totalStars, this.tunables.ageTrainingWeight);\\n      const shown = this.guest.confessed ? trueAge : trueAge + 7;\\n      this.guest.chart.push({ day: this.guest.day, t: T, trueAge, shown });\\n      this.persist();\\n    }\\n    this.question = questionFor(this.guest?.day || 1);\\n    this.mode = 'question';\\n    this.refresh(true);\\n  }\\n\\n  confess() {\\n    const g = this.guest;\\n    if (!g || g.confessed) return;\\n    for (const point of g.chart) point.shown -= 7;\\n    g.confessed = true;\\n    this.persist();\\n  }\\n\\n  nextDay() {\\n    const g = this.guest;\\n    if (!g) return;\\n    g.day += 1;\\n    g.week = g.day >= 8 ? 2 : 1;\\n    g.today = emptyToday();\\n    this.persist();\\n    this.startWeigh();\\n  }\\n\\n  persist() {\\n    if (this.session) return;\\n    const data = this.save.read();\\n    if (this.guest && this.slot != null && !this.drop) data.slots[this.slot] = this.guest;\\n    data.settings = { ...this.settings };\\n    this.save.write(data);\\n  }\\n\\n  activate(id) {\\n    if (this.mode === 'title' && id === 'start') {\\n      if (this.touchOnly) return;\\n      this.mode = 'menu';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'menu') {\\n      if (id === 'week') { this.drop = false; this.mode = 'slots'; }\\n      else if (id === 'dropin') { this.drop = true; this.guest = freshGuest('Drop In'); this.guest.unlockAll = true; this.mode = 'island'; }\\n      else if (id === 'family') { this.seats = [null, null, null, null]; this.mode = 'join'; }\\n      else if (id === 'settings') { this.setPage = 0; this.mode = 'settings'; }\\n      else if (id === 'about') { this.aboutPage = 0; this.mode = 'about'; }\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'slots') {\\n      if (id === 'back') { this.mode = 'menu'; this.refresh(true); return; }\\n      const index = Number(id.replace('slot', ''));\\n      this.slot = index;\\n      const existing = this.save.read().slots[index];\\n      if (existing) {\\n        this.guest = existing;\\n        this.guest.today = this.guest.today || emptyToday();\\n        if (!this.guest.ferried) this.mode = 'ferry';\\n        else this.startWeigh();\\n      } else {\\n        this.nameBuf = 'Guest';\\n        this.guest = null;\\n        this.mode = 'name';\\n      }\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'name' && id === 'done') {\\n      this.guest = freshGuest(this.nameBuf || 'Guest');\\n      this.persist();\\n      this.mode = 'ferry';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'ferry' && id === 'board') {\\n      this.guest.ferried = true;\\n      this.persist();\\n      this.startWeigh();\\n      return;\\n    }\\n    if (this.mode === 'question' && id.startsWith('a')) {\\n      this.answer = Number(id.slice(1));\\n      if (this.guest) this.guest.felt = this.question?.remarks?.[this.answer] || '';\\n      this.mode = 'reveal';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'reveal') { this.mode = 'island'; this.islandPage = 0; this.refresh(true); return; }\\n    if (this.mode === 'island') return this.activateIsland(id);\\n    if (this.mode === 'station') return this.activateStation(id);\\n    if (this.mode === 'results') {\\n      if (id === 'retry') this.startActivity(this.activityId);\\n      else if (id === 'next') { this.mode = 'station'; this.refresh(true); }\\n      else { this.mode = 'island'; this.refresh(true); }\\n      return;\\n    }\\n    if (this.mode === 'hammock' && id === 'rest') { this.mode = 'report'; this.refresh(true); return; }\\n    if (this.mode === 'report' && id === 'sleep') {\\n      const playedLong = this.guest?.today?.ids?.includes('longstand');\\n      if (this.guest?.day === 7 && playedLong && !this.guest.confessed) {\\n        this.mode = 'confession';\\n        this.refresh(true);\\n      } else this.nextDay();\\n      return;\\n    }\\n    if (this.mode === 'confession') { this.confess(); this.mode = 'credits'; this.refresh(true); return; }\\n    if (this.mode === 'credits') { this.nextDay(); return; }\\n    if (this.mode === 'settings') return this.activateSettings(id);\\n    if ((this.mode === 'about' || this.mode === 'howto' || this.mode === 'hall' || this.mode === 'jar' || this.mode === 'locker') && id === 'back') {\\n      this.mode = this.frozen ? 'pause' : 'island';\\n      if (this.mode === 'island' && !this.guest) this.mode = 'menu';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (this.mode === 'locker') return this.cycleLook(id);\\n    if (this.mode === 'pause') return this.activatePause(id);\\n    if (this.mode === 'dev') return this.activateDev(id);\\n    if (this.mode === 'join') return this.activateJoin(id);\\n    if (this.mode === 'podium') {\\n      if (id === 'again') this.openMedley({ family: true });\\n      else { this.mode = 'menu'; this.refresh(true); }\\n      return;\\n    }\\n    if (this.mode === 'dropin' && id === 'play') { this.mode = 'island'; this.refresh(true); }\\n  }\\n\\n  activateIsland(id) {\\n    if (id === 'more') { this.islandPage = 1; this.refresh(true); return; }\\n    if (id === 'back') { this.islandPage = 0; this.refresh(true); return; }\\n    if (id === 'hammock') { this.mode = 'hammock'; this.refresh(true); return; }\\n    if (id === 'jar') { this.mode = 'jar'; this.refresh(true); return; }\\n    if (id === 'locker') { this.mode = 'locker'; this.refresh(true); return; }\\n    if (id === 'hall') { this.mode = 'hall'; this.refresh(true); return; }\\n    if (id === 'longstand') { this.startActivity('longstand'); return; }\\n    if (id.startsWith('st-')) {\\n      this.station = id.slice(3);\\n      this.mode = 'station';\\n      this.refresh(true);\\n    }\\n  }\\n\\n  activateStation(id) {\\n    if (id === 'back') { this.mode = 'island'; this.refresh(true); return; }\\n    if (id === 'hard') {\\n      if (this.guest) this.guest.hard = !this.guest.hard;\\n      this.refresh(false);\\n      return;\\n    }\\n    if (id.startsWith('act-')) this.startActivity(id.slice(4));\\n  }\\n\\n  activateSettings(id) {\\n    const s = this.settings;\\n    if (id === 'more') { this.setPage = 1; this.refresh(true); return; }\\n    if (id === 'back') {\\n      this.persist();\\n      this.mode = this.frozen ? 'pause' : 'menu';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'glyphs') s.glyphs = s.glyphs === 'xbox' ? 'playstation' : 'xbox';\\n    if (id === 'gentle') s.gentle = !s.gentle;\\n    if (id === 'flashes') s.flashes = !s.flashes;\\n    if (id === 'look') {\\n      const i = LOOKS.indexOf(s.look);\\n      s.look = LOOKS[(i + 1) % LOOKS.length];\\n      this.applyLook();\\n    }\\n    if (id === 'pixel') {\\n      s.pixel = s.pixel === 'chunky' ? 'fine' : 'chunky';\\n      try { this.engine?.settings?.set?.({ pixelSize: s.pixel }); } catch { /* headless */ }\\n    }\\n    if (id === 'full') this.fullscreen();\\n    if (id === 'reset') this.resetSettings();\\n    this.persist();\\n    this.refresh(false);\\n  }\\n\\n  nudgeSetting(id, dir) {\\n    const s = this.settings;\\n    if (id === 'music') s.music = clamp01(s.music + dir * 0.05);\\n    if (id === 'sfx') s.sfx = clamp01(s.sfx + dir * 0.05);\\n    if (id === 'voice') s.voice = clamp01(s.voice + dir * 0.05);\\n    if (id === 'radius') this.tunables.mouseLeanRadius = clamp(this.tunables.mouseLeanRadius + dir * 2, 20, 160);\\n    if (id === 'offset') this.tunables.stepOffsetMs = clamp(this.tunables.stepOffsetMs + dir * 5, -80, 80);\\n    this.applyVolumes();\\n    this.refresh(false);\\n  }\\n\\n  resetSettings() {\\n    this.settings.music = 0.1;\\n    this.settings.sfx = 1;\\n    this.settings.voice = 1;\\n    this.settings.master = 1;\\n    this.settings.glyphs = 'playstation';\\n    this.settings.gentle = false;\\n    this.settings.flashes = false;\\n    this.settings.look = 'default';\\n    this.settings.pixel = 'fine';\\n    this.tunables.mouseLeanRadius = DEFAULT_TUNABLES.mouseLeanRadius;\\n    this.tunables.stepOffsetMs = DEFAULT_TUNABLES.stepOffsetMs;\\n    this.applyVolumes();\\n    this.applyLook();\\n  }\\n\\n  applyVolumes() {\\n    const audio = this.engine?.audio;\\n    if (!audio?.setVolume) return;\\n    audio.setVolume('music', this.settings.music);\\n    audio.setVolume('sfx', this.settings.sfx);\\n    audio.setVolume('master', this.settings.master ?? 1);\\n    this.busMusic = audio.volume?.music ?? this.settings.music;\\n  }\\n\\n  applyLook() {\\n    const engine = this.engine;\\n    if (!engine) return;\\n    const name = this.settings.look;\\n    try {\\n      if (name === 'default') return;\\n      const preset = engine.lookPresets?.[name];\\n      if (preset) engine.setLook(preset);\\n      else engine.settings?.set?.({ look: name });\\n    } catch { /* unknown look name */ }\\n  }\\n\\n  fullscreen() {\\n    const el = globalThis.document?.documentElement;\\n    try { el?.requestFullscreen?.(); } catch { /* no display */ }\\n  }\\n\\n  cycleLook(id) {\\n    if (id === 'back' || !this.guest) return;\\n    const choices = LOOK_CHOICES[id];\\n    if (!choices) return;\\n    const cur = this.guest.look[id];\\n    const i = choices.indexOf(cur);\\n    this.guest.look[id] = choices[(i + 1) % choices.length];\\n    this.refresh(false);\\n  }\\n\\n  openPause() {\\n    if (this.mode === 'pause' || this.mode === 'dev') return;\\n    this.returnMode = this.mode;\\n    this.mode = 'pause';\\n    this.frozen = !this.session;\\n    if (this.frozen && this.engine) this.engine.timeScale = 0;\\n    this.refresh(true);\\n  }\\n\\n  activatePause(id) {\\n    if (id === 'resume') {\\n      this.mode = this.returnMode || 'title';\\n      this.frozen = false;\\n      if (this.engine) this.engine.timeScale = 1;\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'restart') { this.startActivity(this.activityId); return; }\\n    if (id === 'island') {\\n      this.frozen = false;\\n      if (this.engine) this.engine.timeScale = 1;\\n      this.mode = 'island';\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'settings') { this.setPage = 0; this.mode = 'settings'; this.refresh(true); return; }\\n    if (id === 'howto') { this.mode = 'howto'; this.refresh(true); return; }\\n    if (id === 'about') { this.aboutPage = 0; this.mode = 'about'; this.refresh(true); return; }\\n    if (id === 'dev' && !this.session) {\\n      this.mode = 'dev';\\n      this.devTab = 0;\\n      this.devPage = 0;\\n      if (this.engine && !this.session) this.engine.timeScale = 0;\\n      this.refresh(true);\\n    }\\n  }\\n\\n  activateDev(id) {\\n    if (id === 'more') {\\n      if (this.devTabName() === 'Tools') this.toolPage += 1;\\n      else this.devPage += 1;\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'prev') {\\n      if (this.devTabName() === 'Tools') this.toolPage = Math.max(0, this.toolPage - 1);\\n      else this.devPage = Math.max(0, this.devPage - 1);\\n      this.refresh(true);\\n      return;\\n    }\\n    if (id === 'back') { this.mode = 'pause'; this.refresh(true); return; }\\n    if (id === 'reset-tab') { this.resetTab(); return; }\\n    if (id === 'reset-all') { this.resetAll(); return; }\\n    if (TUNABLE_TABS[this.devTabName()]?.some((row) => row[0] === id)) return;\\n    this.runTool(id);\\n    this.refresh(false);\\n  }\\n\\n  nudgeTunable(id, dir) {\\n    const tab = this.devTabName();\\n    const row = (TUNABLE_TABS[tab] || []).find((r) => r[0] === id);\\n    if (!row) return;\\n    const [, , lo, hi, step] = row;\\n    const next = clamp(this.tunables[id] + dir * step, lo, hi);\\n    this.tunables[id] = Math.round(next * 1000) / 1000;\\n    this.refresh(false);\\n  }\\n\\n  resetTab() {\\n    const tab = this.devTabName();\\n    for (const key of tabKeys(tab)) this.tunables[key] = DEFAULT_TUNABLES[key];\\n    this.refresh(false);\\n  }\\n\\n  resetAll() {\\n    for (const key of Object.keys(DEFAULT_TUNABLES)) this.tunables[key] = DEFAULT_TUNABLES[key];\\n    this.refresh(false);\\n  }\\n\\n  runTool(id) {\\n    if (!this.guest) this.guest = freshGuest('Guest');\\n    if (id === 'day') {\\n      const day = (this.guest.day % 7) + 1;\\n      this.guest.day = day;\\n      this.guest.week = 1;\\n      this.guest.today = emptyToday();\\n    } else if (id === 'jump') {\\n      this.jumpPick = (this.jumpPick + 1) % ACTIVITIES.length;\\n      this.frozen = false;\\n      this.startActivity(ACTIVITIES[this.jumpPick].id);\\n    } else if (id === 'finish') {\\n      this.finishPick = (this.finishPick + 1) % 4;\\n      if (this.sim) {\\n        this.sim.done = true;\\n        this.sim.stars = this.finishPick;\\n        this.sim.score = this.sim.def.thresholds[Math.max(0, this.finishPick - 1)] || 0;\\n        this.sim.seconds = Math.max(1, this.sim.playT || 1);\\n        this.finishActivity();\\n      }\\n    } else if (id === 'drips') {\\n      this.guest.drips += 50;\\n      this.guest.items = milestonesReached(this.guest.drips).map((item) => item.id);\\n      this.persist();\\n    } else if (id === 'unlock') {\\n      this.guest.unlockAll = true;\\n    } else if (id === 'auto') {\\n      this.skillPick = (this.skillPick + 1) % SKILLS.length;\\n      this.setDriver(SKILLS[this.skillPick]);\\n    } else if (id === 'god') {\\n      this.god = !this.god;\\n      if (this.sim) this.sim.god = this.god;\\n    } else if (id === 'time') {\\n      this.timePick = (this.timePick + 1) % SCALES.length;\\n      if (this.engine) this.engine.timeScale = SCALES[this.timePick];\\n    } else if (id === 'overlay') {\\n      this.overlay = !this.overlay;\\n    } else if (id === 'hud') {\\n      this.hideHud = !this.hideHud;\\n    } else if (id === 'camera') {\\n      try { this.engine?.setCamera({ preset: 'free' }, { syncUrl: false }); } catch { /* no rig */ }\\n      this.freeCam = true;\\n    } else if (id === 'line') {\\n      this.linePick = (this.linePick + 1) % 3;\\n      this.dialogue = ['Stand.', 'The circle noticed.', 'See you tomorrow. Bring your knees.'][this.linePick];\\n      this.spoken = '';\\n    } else if (id === 'sound') {\\n      this.soundPick = (this.soundPick + 1) % (Object.keys(SONGS).length + 1);\\n      const names = Object.keys(SONGS);\\n      if (this.soundPick === 0) this.engine?.audio?.play?.('chime');\\n      else {\\n        const name = names[this.soundPick - 1];\\n        this.engine?.audio?.playMusic?.(SONGS[name], name);\\n        this.songPlaying = name;\\n      }\\n    } else if (id === 'anim') {\\n      const names = ['Tree', 'Heron', 'SquatRep', 'Press', 'StepL'];\\n      this.animPick = (this.animPick + 1) % names.length;\\n      this.viewerClip = names[this.animPick];\\n    } else if (id === 'wipe') {\\n      this.save.clear();\\n      this.guest = null;\\n      this.slot = 0;\\n    } else if (id === 'export') {\\n      const changed = {};\\n      for (const key of Object.keys(DEFAULT_TUNABLES)) {\\n        if (this.tunables[key] !== DEFAULT_TUNABLES[key]) changed[key] = this.tunables[key];\\n      }\\n      this.exported = JSON.stringify(changed);\\n      try { console.log(this.exported); } catch { /* no console */ }\\n    }\\n  }\\n\\n  activateJoin(id) {\\n    if (id === 'back') { this.mode = 'menu'; this.refresh(true); return; }\\n    if (id === 'fill') {\\n      const skills = ['sloppy', 'average', 'good', 'expert'];\\n      let n = 0;\\n      for (let i = 0; i < 4; i++) if (!this.seats[i]) this.seats[i] = { kind: 'bot', skill: skills[n++] || 'average' };\\n      this.refresh(false);\\n      return;\\n    }\\n    if (id === 'start') {\\n      if (!this.seats.some(Boolean)) return;\\n      this.openMedley({ family: true });\\n    }\\n  }\\n\\n  claim(seat) {\\n    if (seat.kind === 'pad' && this.seats.some((s) => s && s.kind === 'pad' && s.index === seat.index)) return;\\n    if (seat.kind === 'key' && this.seats.some((s) => s && s.kind === 'key')) return;\\n    const index = this.seats.findIndex((s) => !s);\\n    if (index < 0) return;\\n    this.seats[index] = seat;\\n    this.refresh(false);\\n  }\\n\\n  pollJoin(ctx) {\\n    let pads = [];\\n    try { pads = globalThis.navigator?.getGamepads?.() || []; } catch { pads = []; }\\n    for (let i = 0; i < 4; i++) {\\n      const down = !!pads[i]?.buttons?.[0]?.pressed;\\n      if (down && !this.prevPad[i]) this.claim({ kind: 'pad', index: i });\\n      this.prevPad[i] = down;\\n    }\\n    if (this.edge(ctx, 'Enter')) this.claim({ kind: 'key' });\\n  }\\n\\n  openMedley(arg = {}) {\\n    this.picks = medleyPicks(this.fork('medley'));\\n    this.medleyT = 0;\\n    this.lanes = [];\\n    if (arg.family) {\\n      for (const seat of this.seats) if (seat) this.lanes.push(this.makeLane(seat));\\n    } else if (arg.bots) {\\n      const skills = arg.skills || ['expert', 'good', 'average', 'sloppy'];\\n      skills.forEach((skill) => this.lanes.push(this.makeLane({ kind: 'bot', skill })));\\n    } else if (arg.hub) {\\n      this.lanes.push(this.makeLane({ kind: 'key', skill: 'idle' }));\\n    } else {\\n      this.lanes.push(this.makeLane({ kind: 'bot', skill: this.driver || 'expert' }));\\n    }\\n    if (arg.ghost) this.addGhost();\\n    this.mode = 'medley';\\n    this.hubClock = !!arg.hub;\\n    this.refresh(true);\\n  }\\n\\n  makeLane(seat) {\\n    const lane = {\\n      kind: seat.kind,\\n      index: seat.index ?? 0,\\n      skill: seat.skill || 'average',\\n      driver: seat.kind === 'pad' ? new PadDriver(seat.index) : seat.kind === 'key' ? new LocalDriver() : null,\\n      ghost: seat.kind === 'ghost' ? new GhostDriver() : null,\\n      simulated: seat.kind !== 'ghost',\\n      steps: 0,\\n      pos: 0,\\n      scores: [0, 0, 0],\\n      sim: null,\\n      event: -1,\\n      dot: seat.kind === 'ghost' ? new Dot(() => 0.5) : null,\\n    };\\n    return lane;\\n  }\\n\\n  addGhost() {\\n    const lane = this.makeLane({ kind: 'ghost' });\\n    this.lanes.push(lane);\\n    return lane;\\n  }\\n\\n  laneTotal(lane) {\\n    return lane.scores.reduce((a, b) => a + b, 0);\\n  }\\n\\n  fixed(ctx, dt) {\\n    this.ctx = ctx;\\n    if (this.mode === 'activity' && this.sim && !this.sim.done) {\\n      this.sim.gentle = !!this.settings.gentle;\\n      this.sim.god = !!this.god;\\n      const input = this.driver ? this.sim.auto(dt) : this.local.readFrom(ctx, this.device.kind, { x: ctx.hud.width / 2, y: ctx.hud.height / 2 }, this.tunables.mouseLeanRadius, dt);\\n      this.sim.step(dt, input);\\n      if (this.sim.done) this.finishActivity();\\n    } else if (this.mode === 'weigh' && this.weigh && !this.weigh.done) {\\n      const input = this.driver ? this.weigh.auto(dt) : this.local.readFrom(ctx, this.device.kind, { x: ctx.hud.width / 2, y: ctx.hud.height / 2 }, this.tunables.mouseLeanRadius, dt);\\n      this.weigh.step(dt, input);\\n      if (this.weigh.done) this.finishWeigh();\\n    } else if (this.mode === 'attract' && this.sim) {\\n      this.sim.step(dt, this.sim.auto(dt));\\n      this.attractT += dt;\\n      if (this.attractT >= 14 || this.sim.done) {\\n        this.attractI += 1;\\n        this.attractT = 0;\\n        this.beginAttract();\\n      }\\n    } else if (this.mode === 'medley') {\\n      this.tickMedley(ctx, dt);\\n    }\\n  }\\n\\n  tickMedley(ctx, dt) {\\n    if (this.hubClock && this.hub) {\\n      const ms = this.hub.time?.() ?? -Infinity;\\n      if (!(ms >= 0)) return;\\n      this.medleyT = ms / 1000;\\n    }\\n    const win = medleyWindow(this.medleyT);\\n    for (const lane of this.lanes) {\\n      if (lane.kind === 'ghost') {\\n        lane.ghost.present(dt);\\n        continue;\\n      }\\n      if (win.phase === 'play') {\\n        const id = [this.picks.still, this.picks.beat, this.picks.lean][win.index];\\n        if (lane.event !== win.index) {\\n          if (lane.event >= 0 && lane.sim) {\\n            const max = lane.sim.def.thresholds?.[2] || 1;\\n            lane.scores[lane.event] = normalise(lane.sim.score || 0, max);\\n          }\\n          lane.sim = createSim(id, {\\n            tunables: this.tunables,\\n            rand: this.fork(`m-${id}`),\\n            botRand: this.fork(`mb-${id}`),\\n            skill: lane.kind === 'bot' ? lane.skill : (this.driver || 'idle'),\\n            skipIntro: true,\\n            first: false,\\n            practice: false,\\n          });\\n          lane.event = win.index;\\n          lane.dot = lane.sim.dot;\\n        }\\n        let input;\\n        if (lane.kind === 'bot' || (lane.kind !== 'pad' && lane.kind !== 'key' && this.driver)) input = lane.sim.auto(dt);\\n        else if (lane.kind === 'bot') input = lane.sim.auto(dt);\\n        else if (lane.kind === 'pad') input = lane.driver.read();\\n        else if (lane.kind === 'key') input = lane.driver.readFrom(ctx, 'keyboard', { x: ctx.hud.width / 2, y: ctx.hud.height / 2 }, this.tunables.mouseLeanRadius, dt);\\n        else input = lane.sim.auto(dt);\\n        lane.sim.step(dt, input);\\n        lane.steps += 1;\\n        lane.pos = lane.sim.dot ? lane.sim.dot.x : (lane.sim.x || 0);\\n      }\\n    }\\n    if (!this.hubClock) this.medleyT += dt;\\n    if (this.medleyT >= MEDLEY_SPAN && this.mode === 'medley') this.finishMedley();\\n    const player = this.lanes.find((lane) => lane.kind !== 'ghost');\\n    this.hubScore = player ? this.laneTotal(player) + (player.sim?.score || 0) : 0;\\n  }\\n\\n  finishMedley() {\\n    for (const lane of this.lanes) {\\n      if (lane.sim && lane.event >= 0 && lane.kind !== 'ghost') {\\n        const max = lane.sim.def.thresholds?.[2] || 1;\\n        lane.scores[lane.event] = normalise(lane.sim.score || 0, max);\\n      }\\n    }\\n    this.mode = 'podium';\\n    this.refresh(true);\\n    if (this.hub) this.hubResult();\\n  }\\n\\n  beginAttract() {\\n    const id = ATTRACT[this.attractI % ATTRACT.length];\\n    const tunables = { ...this.tunables, ringScale: (this.tunables.ringScale || 1) * 2 };\\n    this.sim = createSim(id, {\\n      tunables,\\n      rand: this.fork(`at-${id}`),\\n      botRand: this.fork(`atb-${id}`),\\n      skill: 'expert',\\n      god: true,\\n      skipIntro: true,\\n      first: false,\\n      practice: false,\\n    });\\n    this.activityId = id;\\n    this.attracting = true;\\n    this.mode = 'attract';\\n  }\\n\\n  update(ctx, dt) {\\n    this.ctx = ctx;\\n    this.engine = ctx.engine;\\n    this.device.update(ctx);\\n    if (ctx.audio?.volume) this.busMusic = ctx.audio.volume.music;\\n    if (this.mode === 'card') this.cardInput(ctx);\\n    if (this.mode === 'join') this.pollJoin(ctx);\\n    if (this.mode === 'name') this.typeName(ctx);\\n    const kind = this.device.kind;\\n    if (this.touchOnly && (kind === 'keyboard' || kind === 'pad') && this.anyPressed(ctx)) this.touchOnly = false;\\n    if (this.mode === 'attract' && this.anyInput(ctx)) {\\n      this.attracting = false;\\n      this.sim = null;\\n      this.idle = 0;\\n      this.mode = 'title';\\n      this.refresh(true);\\n      this.draw(ctx);\\n      return;\\n    }\\n    const pause = this.edge(ctx, 'KeyP') || (this.edge(ctx, 'PadOptions') && !ctx.input.isDown('PadCreate')) || (this.edge(ctx, 'Escape') && PAUSABLE.has(this.mode));\\n    if (pause && PAUSABLE.has(this.mode)) this.openPause();\\n    else if (this.rows.length && this.mode !== 'activity' && this.mode !== 'weigh' && this.mode !== 'attract' && this.mode !== 'card') this.menuInput(ctx);\\n    if (!this.session && MENU_IDLE.has(this.mode)) {\\n      if (this.anyInput(ctx)) this.idle = 0;\\n      else this.idle += dt > 0 ? dt : 1 / 60;\\n      if (this.idle >= 10) {\\n        this.attractI = 0;\\n        this.attractT = 0;\\n        this.idle = 0;\\n        this.beginAttract();\\n      }\\n    } else if (this.mode !== 'attract') this.idle = 0;\\n    if (this.mode === 'dev') {\\n      const tab = this.edge(ctx, 'KeyE') || this.edge(ctx, 'PadR1');\\n      const prev = this.edge(ctx, 'KeyQ') || this.edge(ctx, 'PadL1');\\n      const names = [...Object.keys(TUNABLE_TABS), 'Tools'];\\n      if (tab) { this.devTab = (this.devTab + 1) % names.length; this.devPage = 0; this.refresh(true); }\\n      if (prev) { this.devTab = (this.devTab + names.length - 1) % names.length; this.devPage = 0; this.refresh(true); }\\n    }\\n    if (this.mode === 'about' && (this.edge(ctx, 'ArrowRight') || this.edge(ctx, 'PadR1'))) this.aboutPage += 1;\\n    if (this.mode === 'about' && (this.edge(ctx, 'ArrowLeft') || this.edge(ctx, 'PadL1'))) this.aboutPage = Math.max(0, this.aboutPage - 1);\\n    this.syncSong(ctx);\\n    this.syncSpeech(ctx);\\n    this.hover(ctx);\\n    this.draw(ctx);\\n  }\\n\\n  cardInput(ctx) {\\n    const hub = this.hub || globalThis.AIHub;\\n    if (!hub?.answer) return;\\n    if (this.edge(ctx, 'Enter') || this.edge(ctx, 'PadCross')) hub.answer('ready');\\n    if (this.edge(ctx, 'KeyM') || this.edge(ctx, 'PadTriangle')) hub.answer('more');\\n  }\\n\\n  typeName(ctx) {\\n    const input = ctx.input;\\n    if (this.edge(ctx, 'Backspace')) this.nameBuf = this.nameBuf.slice(0, -1);\\n    for (let i = 0; i < 26; i++) {\\n      const code = `Key${String.fromCharCode(65 + i)}`;\\n      if (input.wasPressed(code) && this.nameBuf.length < 8) this.nameBuf += String.fromCharCode(97 + i);\\n    }\\n    this.rows = this.rowsFor();\\n  }\\n\\n  menuInput(ctx) {\\n    if (!this.rows.length) return;\\n    if (this.pressedAny(ctx, DOWN) || (this.mode !== 'island' && this.mode !== 'activity' && this.edge(ctx, 'KeyS'))) {\\n      this.focus = (this.focus + 1) % this.rows.length;\\n    } else if (this.pressedAny(ctx, UP) || (this.mode !== 'island' && this.edge(ctx, 'KeyW'))) {\\n      this.focus = (this.focus + this.rows.length - 1) % this.rows.length;\\n    } else if (this.pressedAny(ctx, LEFT)) {\\n      this.nudge(-1);\\n    } else if (this.pressedAny(ctx, RIGHT)) {\\n      this.nudge(1);\\n    } else if (this.pressedAny(ctx, PRESS) || (this.mode !== 'name' && this.edge(ctx, 'KeyE'))) {\\n      const row = this.rows[this.focus];\\n      if (row) this.activate(row.id);\\n    } else if (this.pressedAny(ctx, BACK) && this.mode !== 'pause') {\\n      this.back();\\n    }\\n  }\\n\\n  nudge(dir) {\\n    const row = this.rows[this.focus];\\n    if (!row) return;\\n    if (this.mode === 'dev') this.nudgeTunable(row.id, dir);\\n    if (this.mode === 'settings') this.nudgeSetting(row.id, dir);\\n    if (this.mode === 'locker') this.cycleLook(row.id);\\n  }\\n\\n  back() {\\n    const map = {\\n      slots: 'menu', station: 'island', settings: this.frozen ? 'pause' : 'menu',\\n      about: this.frozen ? 'pause' : 'menu', howto: 'pause', locker: 'island',\\n      hall: 'island', jar: 'island', join: 'menu', name: 'slots', ferry: 'slots',\\n      results: 'island', dev: 'pause',\\n    };\\n    if (map[this.mode]) {\\n      this.mode = map[this.mode];\\n      this.refresh(true);\\n    }\\n  }\\n\\n  hover(ctx) {\\n    if (this.device.kind !== 'mouse') return;\\n    const p = ctx.input.pointer;\\n    if (!p) return;\\n    const ax = ((p.x + 1) / 2) * ctx.hud.width;\\n    const ay = ((1 - p.y) / 2) * ctx.hud.height;\\n    this.widgets.forEach((w, i) => {\\n      if (!String(w.id).startsWith('row-')) return;\\n      if (ax >= w.x && ax <= w.x + w.w && ay >= w.y && ay <= w.y + w.h) {\\n        const id = w.id.slice(4);\\n        const index = this.rows.findIndex((row) => row.id === id);\\n        if (index >= 0) this.focus = index;\\n      }\\n    });\\n  }\\n\\n  syncSong(ctx) {\\n    let key = 'plaza';\\n    if (this.mode === 'activity' || this.mode === 'attract') key = SONG_FOR[ACTIVITY_BY_ID[this.activityId]?.kind] || 'plaza';\\n    else if (this.mode === 'report' || this.mode === 'confession') key = 'report';\\n    else if (this.mode === 'island') key = 'plaza';\\n    else if (this.mode === 'medley') key = 'hoop';\\n    if (this.songPlaying === key) return;\\n    const song = SONGS[key];\\n    if (song && ctx.audio?.playMusic) {\\n      ctx.audio.playMusic(song, key);\\n      this.songPlaying = key;\\n    }\\n  }\\n\\n  syncSpeech(ctx) {\\n    let line = '';\\n    let speaker = 'ounce';\\n    if (this.mode === 'results') { line = this.dialogue; speaker = 'ounce'; }\\n    else if (this.mode === 'ferry') { line = 'The ferry is on time. Your knees are a separate matter.'; }\\n    else if (this.mode === 'confession') { line = 'I have been adding seven. It felt like kindness. It was not.'; }\\n    else if (this.mode === 'reveal' && this.guest?.chart?.length) {\\n      const last = this.guest.chart[this.guest.chart.length - 1];\\n      line = `Your Wobble Age is ${last.shown}. Is that close?`;\\n    } else if (this.mode === 'dev' && this.dialogue) { line = this.dialogue; speaker = 'coach'; }\\n    else if (this.mode === 'attract') { line = 'This is a recording. The person in it is doing better than you.'; }\\n    if (!line || line === this.spoken) return;\\n    this.spoken = line;\\n    if ((this.settings.voice ?? 1) <= 0) return;\\n    import('./audio/voice.js').then((mod) => mod.speak(ctx, line, speaker)).catch(() => {});\\n  }\\n\\n  edge(ctx, code) {\\n    return !!ctx.input.wasPressed(code);\\n  }\\n\\n  pressedAny(ctx, codes) {\\n    return codes.some((code) => ctx.input.wasPressed(code));\\n  }\\n\\n  anyPressed(ctx) {\\n    return ANY.some((code) => ctx.input.wasPressed(code));\\n  }\\n\\n  anyInput(ctx) {\\n    const input = ctx.input;\\n    if (Math.hypot(input.mouseDelta?.x || 0, input.mouseDelta?.y || 0) > 2) return true;\\n    if (input.wheel) return true;\\n    if (Math.hypot(input.padAxis?.x || 0, input.padAxis?.y || 0) > 0.3) return true;\\n    return this.anyPressed(ctx);\\n  }\\n\\n  bindHub(hub) {\\n    this.hub = hub;\\n    this.session = this.session || { hub: true };\\n    hub.on?.('card', (card) => { this.card = card; });\\n    hub.on?.('start', () => {\\n      this.hubLive = true;\\n      this.hubScore = 0;\\n      this.openMedley({ hub: true });\\n      this.hubPulse();\\n      if (this._hubTimer) clearInterval(this._hubTimer);\\n      this._hubTimer = setInterval(() => this.hubPulse(), 100);\\n    });\\n    hub.on?.('message', (data, from) => this.ghostMessage(data, from));\\n    hub.on?.('leave', (info) => { if (info?.id != null) this.leftIds.add(info.id); });\\n    hub.on?.('time-up', () => this.hubResult());\\n    hub.on?.('end', () => this.hubStop());\\n  }\\n\\n  ghostMessage(data, from) {\\n    if (!data || from == null) return;\\n    let lane = this.lanes.find((item) => item.kind === 'ghost' && item.from === from);\\n    if (!lane) {\\n      lane = this.addGhost();\\n      lane.from = from;\\n    }\\n    lane.ghost.push(data);\\n  }\\n\\n  hubPulse() {\\n    if (!this.hubLive || this.hubEnded || !this.hub) return;\\n    const lane = this.lanes.find((item) => item.kind !== 'ghost');\\n    const score = this.hubScore || 0;\\n    const win = medleyWindow(Math.max(0, this.medleyT));\\n    try {\\n      this.hub.send({ a: win.index || 0, x: lane?.pos || 0, y: 0, c: 0, t: lane?.sim?.playT || 0, s: score }, { reliable: false });\\n      this.hub.progress({ score, label: 'Medley' });\\n    } catch { /* the round may already be over */ }\\n  }\\n\\n  hubResult() {\\n    if (this.resultSent || !this.hub) return;\\n    this.resultSent = true;\\n    this.hubLive = false;\\n    try {\\n      this.hub.result({\\n        score: this.hubScore || 0,\\n        stats: { events: 3 },\\n        awards: [{ title: 'Stillest', detail: 'You stayed.' }],\\n      });\\n    } catch { /* already sent */ }\\n  }\\n\\n  hubStop() {\\n    this.hubEnded = true;\\n    this.hubLive = false;\\n    if (this._hubTimer) clearInterval(this._hubTimer);\\n    this._hubTimer = null;\\n    try { this.engine?.audio?.stopMusic?.(); } catch { /* quiet */ }\\n  }\\n\\n  widget(id, x, y, w, h) {\\n    this.widgets.push({ id, x, y, w, h });\\n  }\\n\\n  status() {\\n    if (this.mode === 'activity' && this.sim) {\\n      return `activity ${this.activityId} | ${this.sim.phase} | t ${this.sim.playT.toFixed(1)} | score ${Math.round(this.sim.score)}`;\\n    }\\n    if (this.mode === 'medley') return `medley | t ${this.medleyT.toFixed(1)} | score ${Math.round(this.hubScore || 0)}`;\\n    return `${this.mode} | day ${this.guest?.day || 0}`;\\n  }\\n\\n  fingerprint() {\\n    const dot = this.sim?.dot || this.weigh?.dot;\\n    const x = dot ? dot.x.toFixed(4) : '0';\\n    const y = dot ? dot.y.toFixed(4) : '0';\\n    return `${this.mode}|${this.guest?.day || 0}|${Math.round(this.sim?.score || 0)}|${x},${y}`;\\n  }\\n\\n  state() {\\n    const row = this.rows[this.focus];\\n    return {\\n      title: this.title,\\n      mode: this.mode,\\n      focus: this.focus,\\n      row: row?.id || '',\\n      rows: this.rows.map((r) => r.id),\\n      device: this.device.kind,\\n      glyphs: this.settings.glyphs,\\n      glyph: glyphKind(this.device.kind, this.settings.glyphs),\\n      prompt: promptFor(this.device.kind, this.settings.glyphs, this.mode === 'title' ? 'Start' : 'Confirm'),\\n      touchOnly: this.touchOnly,\\n      touchMessage: this.touchOnly ? 'Controller or keyboard required' : '',\\n      music: this.busMusic,\\n      day: this.guest?.day || 0,\\n      week: this.guest?.week || 0,\\n      name: this.guest?.name || '',\\n      drips: this.guest?.drips || 0,\\n      stars: this.lastStars,\\n      score: this.lastScore,\\n      seconds: this.lastSeconds,\\n      lastDrips: this.lastDrips,\\n      lastPrescription: this.lastPrescription,\\n      activity: this.activityId,\\n      confessed: !!this.guest?.confessed,\\n      chart: (this.guest?.chart || []).map((p) => ({ day: p.day, t: p.t, trueAge: p.trueAge, shown: p.shown })),\\n      items: this.guest?.items || [],\\n      tunables: { ...this.tunables },\\n      settings: { ...this.settings },\\n      widgets: this.widgets.map((w) => ({ ...w })),\\n      overlay: this.overlay,\\n      god: this.god,\\n      driver: this.driver,\\n      attract: this.mode === 'attract',\\n      attractId: this.mode === 'attract' ? this.activityId : '',\\n      hideHud: this.hideHud,\\n      frozen: this.frozen,\\n      timeScale: this.engine?.timeScale,\\n      session: !!this.session,\\n      dialogue: this.dialogue,\\n      viewerClip: this.viewerClip,\\n      exported: this.exported,\\n      freeCam: !!this.freeCam,\\n      lanes: this.lanes.map((lane) => ({\\n        kind: lane.kind,\\n        pos: lane.pos,\\n        steps: lane.steps,\\n        simulated: lane.simulated,\\n        t: lane.dot?.t || 0,\\n        scores: lane.scores,\\n      })),\\n      medleyT: this.medleyT,\\n      picks: this.picks,\\n      seats: this.seats.map((s) => (s ? s.kind : null)),\\n      devTab: this.devTabName(),\\n      phase: this.sim?.phase || this.weigh?.kind || '',\\n      playT: this.sim?.playT || this.weigh?.t || 0,\\n    };\\n  }\\n\\n  draw(ctx) {\\n    const hud = ctx.hud;\\n    if (!hud?.clear) return;\\n    hud.clear();\\n    this.widgets = [];\\n    if (this.hideHud) {\\n      if (hud.visible != null) hud.visible = false;\\n      return;\\n    }\\n    if (hud.visible != null) hud.visible = true;\\n    const view = { hud, app: this, w: hud.width, h: hud.height };\\n    paint(view);\\n  }\\n}\\n\\nfunction clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\\nfunction clamp01(v) { return clamp(v, 0, 1); }\\n\\nfunction weighCtor() {\\n  return { WeighSim: createSim.WeighSim || null };\\n}\\n\\nimport { WeighSim } from './core/sims.js';\\nimport { say, measureText, wrapText } from './ui/font.js';\\nimport { aboutPages, MEDICAL } from './data/about.js';\\nimport { CREDITS_TEXT } from './data/creditsText.js';\\nimport { TAGLINE } from './data/title.js';\\n\\nApp.prototype.startWeigh = function startWeigh() {\\n  const kind = dayInfo(this.guest?.day || 1).test;\\n  this.weigh = new WeighSim(kind, {\\n    tunables: this.tunables,\\n    rand: this.fork('weigh'),\\n    botRand: this.fork('weigh-bot'),\\n    skill: this.driver || 'idle',\\n  });\\n  this.mode = 'weigh';\\n  this.sim = null;\\n  this.refresh(true);\\n};\\n\\nfunction marginOf(w) { return w < 200 ? 4 : 12; }\\n\\nfunction paint(view) {\\n  const { hud, app, w, h } = view;\\n  const m = marginOf(w);\\n  const narrow = w < 220;\\n  const scale = narrow ? 1 : 2;\\n  const titleScale = w < 220 ? 2 : w < 400 ? 3 : 4;\\n  let y = m;\\n  const head = (text, sc = titleScale, color = 'white') => {\\n    y = line(view, 'title', text, y, sc, color);\\n  };\\n  if (app.mode === 'title' || app.mode === 'attract') {\\n    hud.rect(0, 0, w, Math.min(h, 78), 'navy');\\n    app.widget('band', 0, 0, w, Math.min(h, 78));\\n    head(TITLE, titleScale, 'cyan');\\n    y = line(view, 'tag', TAGLINE, y, narrow ? 1 : 2, 'sand');\\n    if (app.touchOnly) {\\n      for (const part of wrapText('Controller or keyboard required', Math.max(8, Math.floor((w - m * 2) / (6 * (narrow ? 1 : 2)))))) {\\n        y = line(view, 'touch', part, y, narrow ? 1 : 2, 'sand');\\n      }\\n    }\\n    if (app.mode === 'attract') y = line(view, 'rec', 'Press any button', y, scale, 'sand');\\n  } else if (app.mode === 'card') {\\n    head(TITLE, titleScale, 'cyan');\\n    y = line(view, 'goal', 'Score the most across three events.', y, 1, 'sand');\\n    y = line(view, 'how', 'Stay in the circle.', y, 1, 'white');\\n    const players = app.session?.players || app.hub?.players || [];\\n    players.slice(0, 4).forEach((p, i) => {\\n      y = line(view, `seat-${i}`, `${p.name || 'Guest'}`, y, 1, 'white');\\n    });\\n    const left = app.card?.left;\\n    y = line(view, 'time', left == null ? 'Starting' : `${Math.ceil(left / 1000)}s`, y, scale, 'cyan');\\n    y = line(view, 'ready', 'Enter ready', y, 1, 'sand');\\n  } else {\\n    const title = heading(app);\\n    y = line(view, 'head', title, y, scale, 'cyan');\\n  }\\n  if (app.mode === 'activity' || app.mode === 'weigh' || app.mode === 'attract') {\\n    y = line(view, 'phase', phaseLine(app), y, 1, 'sand');\\n    drawPips(view, app.mode === 'activity' ? (app.sim?.stars || 0) : 0, m, h - m - 10);\\n  }\\n  if (app.mode === 'results') {\\n    y = line(view, 'act', ACTIVITY_BY_ID[app.activityId]?.name || '', y, 1, 'white');\\n    const bits = wrapText(app.dialogue || '', 52).slice(0, 3);\\n    bits.forEach((part, i) => { y = line(view, `line-${i}`, part, y, 1, 'sand'); });\\n    y = line(view, 'drips', `Drips ${app.lastDrips}`, y, scale, 'cyan');\\n    drawPips(view, app.lastStars, m, y);\\n    y += 16;\\n  }\\n  if (app.mode === 'reveal' && app.guest?.chart?.length) {\\n    const last = app.guest.chart[app.guest.chart.length - 1];\\n    y = line(view, 'age', String(last.shown), y, titleScale, 'white');\\n    y = line(view, 'felt', wrapText(app.guest.felt || 'Noted.', 40)[0], y, 1, 'sand');\\n  }\\n  if (app.mode === 'report' && app.guest) {\\n    const last = app.guest.chart[app.guest.chart.length - 1];\\n    y = line(view, 'age', last ? String(last.shown) : '--', y, titleScale, 'white');\\n    const info = dayInfo(app.guest.day);\\n    y = line(view, 'concern', wrapText(`Concern: ${info.concern}`, 40)[0], y, 1, 'sand');\\n  }\\n  if (app.mode === 'confession') {\\n    y = line(view, 'sorry', 'I have been adding seven.', y, 1, 'sand');\\n  }\\n  if (app.mode === 'hammock') {\\n    const guilt = app.guest?.today?.plays ? 'Rest. The day is filed.' : 'The hammock kept the day. The jar did not.';\\n    y = line(view, 'guilt', guilt, y, 1, 'sand');\\n  }\\n  if (app.mode === 'jar' && app.guest) {\\n    y = line(view, 'jar-n', String(app.guest.drips), y, titleScale, 'cyan');\\n    for (const item of milestonesReached(app.guest.drips).slice(0, 4)) y = line(view, item.id, item.name, y, 1, 'white');\\n  }\\n  if (app.mode === 'hall' && app.guest) {\\n    const last = app.guest.chart[app.guest.chart.length - 1];\\n    y = line(view, 'hall-n', last ? String(last.shown) : '--', y, titleScale, 'white');\\n  }\\n  if (app.mode === 'about') {\\n    const pages = aboutPages(CREDITS_TEXT);\\n    const page = pages[Math.min(app.aboutPage, pages.length - 1)];\\n    y = line(view, 'about-h', page.title, y, scale, 'cyan');\\n    page.lines.slice(0, 6).forEach((text, i) => {\\n      const bits = wrapText(text, narrow ? 26 : 40).slice(0, 2);\\n      bits.forEach((part, j) => { y = line(view, `about-${i}-${j}`, part, y, 1, 'white'); });\\n    });\\n  }\\n  if (app.mode === 'howto') {\\n    y = line(view, 'how1', 'Lean to keep the dot in the circle.', y, 1, 'white');\\n    y = line(view, 'how2', 'Breathe on the beat. Step on the beat.', y, 1, 'sand');\\n  }\\n  if (app.mode === 'medley' || app.mode === 'podium') {\\n    app.lanes.forEach((lane, i) => {\\n      y = line(view, `lane-${i}`, `${lane.kind} ${Math.round(app.laneTotal(lane))}`, y, 1, 'white');\\n    });\\n  }\\n  if (app.mode === 'join') {\\n    app.seats.forEach((seat, i) => {\\n      y = line(view, `seat-${i}`, seat ? `${i + 1} ${seat.kind}` : `${i + 1} empty`, y, 1, 'sand');\\n    });\\n  }\\n  if (app.overlay) y = line(view, 'overlay', app.status().slice(0, 48), y, 1, 'lime');\\n  const rows = app.rows;\\n  const rowScale = scale;\\n  const rowH = 9 * rowScale + 6;\\n  let ry = Math.min(y + 8, h - m - rows.length * rowH);\\n  if (ry < m) ry = m;\\n  rows.forEach((row, i) => {\\n    const mark = i === app.focus ? '> ' : '  ';\\n    const text = `${mark}${row.label}`.slice(0, narrow ? 28 : 36);\\n    const width = measureText(text, rowScale).width;\\n    const x = m;\\n    if (ry + rowH <= h) {\\n      app.widget(`row-${row.id}`, x, ry, Math.min(width, w - m * 2), 9 * rowScale);\\n      say(hud, x, ry, text, { scale: rowScale, color: i === app.focus ? 'sand' : 'white' });\\n    }\\n    ry += rowH;\\n  });\\n  const prompt = app.state().prompt;\\n  const py = h - m - 9;\\n  if (py > 0) {\\n    app.widget('prompt', m, py, measureText(prompt, 1).width, 9);\\n    say(hud, m, py, prompt, { scale: 1, color: 'mist' });\\n  }\\n  if (app.mode === 'title') {\\n    const medical = wrapText(MEDICAL, narrow ? 26 : 46)[0];\\n    say(hud, m, h - m - 20, medical, { scale: 1, color: 'mist' });\\n  }\\n}\\n\\nfunction line(view, id, text, y, scale, color) {\\n  const { hud, app, w, h } = view;\\n  const m = marginOf(w);\\n  const shown = String(text || '').slice(0, 52);\\n  if (!shown || y > h - 8) return y;\\n  const width = measureText(shown, scale).width;\\n  let x = Math.max(m, Math.floor((w - width) / 2));\\n  if (x + width > w - 2) x = m;\\n  app.widget(id, x, y, Math.min(width, w - x), 9 * scale);\\n  say(hud, x, y, shown, { scale, color });\\n  return y + 9 * scale + 3;\\n}\\n\\nfunction drawPips(view, stars, x, y) {\\n  const { hud, app } = view;\\n  for (let i = 0; i < 3; i++) {\\n    hud.rect(x + i * 10, y, 7, 7, i < stars ? 'sand' : 'slate');\\n  }\\n  app.widget('stars', x, y, 28, 7);\\n}\\n\\nfunction heading(app) {\\n  if (app.mode === 'menu') return 'Mint Dial';\\n  if (app.mode === 'weigh') return 'Weigh in';\\n  if (app.mode === 'island') return app.guest ? `Day ${app.guest.day}` : 'Island';\\n  if (app.mode === 'station') return STATIONS.find((s) => s.id === app.station)?.name?.split(' ').slice(0, 3).join(' ') || 'Station';\\n  if (app.mode === 'pause') return 'Paused';\\n  if (app.mode === 'dev') return app.devTabName();\\n  if (app.mode === 'settings') return 'Settings';\\n  if (app.mode === 'name') return 'Your name';\\n  if (app.mode === 'ferry') return 'The ferry';\\n  if (app.mode === 'question') return 'One question';\\n  if (app.mode === 'results') return 'Results';\\n  if (app.mode === 'report') return 'Evening';\\n  if (app.mode === 'confession') return 'A correction';\\n  if (app.mode === 'credits') return 'Credits';\\n  if (app.mode === 'join') return 'Family Hour';\\n  if (app.mode === 'podium') return 'Podium';\\n  if (app.mode === 'locker') return 'Locker';\\n  if (app.mode === 'hall') return 'Hall';\\n  if (app.mode === 'jar') return 'Sweat jar';\\n  if (app.mode === 'hammock') return 'Hammock';\\n  if (app.mode === 'about') return 'About';\\n  return app.mode;\\n}\\n\\nfunction phaseLine(app) {\\n  if (app.mode === 'weigh') return `${app.weigh?.kind || ''} ${Math.floor(app.weigh?.t || 0)}s`;\\n  if (!app.sim) return '';\\n  return `${app.sim.phase} ${Math.floor(app.sim.playT)}s`;\\n}\\n\\n// The class method above was replaced. Drop the unused helper's throw path.\\nvoid weighCtor;\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa22-c3bd-7423-a5f1-ddadc552f469","uuid":"fdc11eb8-52ab-42df-803c-a764322b1aea"}
