|| 1);\\n    let depth = 0;\\n    if (this.skill === 'expert' || this.skill === 'good') depth = clamp(target + slope * lag, 0, 1);\\n230→    else if (this.skill === 'average') depth = clamp(target * 0.75, 0, 1);\\n    else if (this.skill === 'sloppy') depth = clamp(target * 0.25 + 0.1, 0, 1);\\n    const side = this.rep % 2 === 0 ? 1 : -1;\\n    return { ...ZERO, depth, x: this.def.axis === 'side' ? side * depth : 0, y: this.def.axis === 'up' ? depth : -depth };\\n  }\\n  onStep(dt, u, scoring) {\\n    const tempo = this.tempo();\\n    if (scoring) this.playT += dt;\\n    const clock = scoring ? this.playT : this.phaseT;\\n    const rep = Math.min(this.total - 1, Math.floor(clock / tempo));\\n240→    if (rep !== this.rep) {\\n      this.rep = rep;\\n      const n = rep + 1;\\n      if (n === this.announced) this.gag = 'Last one.';\\n      else if (n === this.announced + 1) this.gag = 'Last one.';\\n      else if (n === this.announced + 2) {\\n        this.gag = 'I lied. This is the last one.';\\n        this.lied = true;\\n      }\\n    }\\n250→    const uRep = (clock % tempo) / tempo;\\n    const target = repTarget(uRep);\\n    const lag = (this.T.repLag || 0.1) * (this.def.lag || 1);\\n    let depth = u.depth || 0;\\n    if (u.useRate) {\\n      this.r = clamp(this.r + (u.rate || 0) * dt, 0, 1);\\n    } else {\\n      const k = Math.min(1, dt / lag);\\n      this.r += (depth - this.r) * k;\\n    }\\n260→    const amp = (this.T.repFatigue || 0) * (rep / this.total) ** 2;\\n    this.r = clamp(this.r + amp * Math.sin(40 * clock) * dt * 8, 0, 1);\\n    if (scoring && uRep < 0.9) {\\n      this.err += Math.abs(this.r - target);\\n      this.n += 1;\\n    }\\n  }\\n  scoreStars() {\\n    const mean = this.n ? this.err / this.n : 1;\\n    this.score = clamp(1 - 1.6 * mean, 0, 1) * 100;\\n270→    super.scoreStars();\\n  }\\n}\\n\\nexport class HoopSim extends Sim {\\n  _built() {\\n    this.angle = 0;\\n    this.omega = 0;\\n    this.L = 1;\\n    this.rot = 0;\\n280→    this.drop = 0;\\n    this.theta = 0;\\n    this.catches = 0;\\n    this.throwT = 6;\\n    this.throw = null;\\n  }\\n  playFinished() {\\n    return this.playT >= 60;\\n  }\\n  dirAt(t) {\\n290→    if (t < 25) return 1;\\n    if (t < 50) return -1;\\n    return 0;\\n  }\\n  auto(dt) {\\n    if (this.skill === 'idle') return { ...ZERO };\\n    const speed = this.skill === 'expert' || this.skill === 'good' ? 2 : this.skill === 'average' ? 1.15 : 0.35;\\n    const want = this.dirAt(this.playT);\\n    const spin = want === 0 ? 1 : want;\\n    this.theta += spin * speed * Math.PI * 2 * dt;\\n300→    return { ...ZERO, x: Math.cos(this.theta), y: Math.sin(this.theta) };\\n  }\\n  onStep(dt, u, scoring) {\\n    if (scoring) this.playT += dt;\\n    const t = scoring ? this.playT : 0;\\n    if (this.drop > 0) {\\n      this.drop -= dt;\\n      return;\\n    }\\n    const mag = Math.hypot(u.x, u.y);\\n310→    if (mag > 0.5) {\\n      const a = Math.atan2(u.y, u.x);\\n      let d = a - this.angle;\\n      while (d > Math.PI) d -= Math.PI * 2;\\n      while (d < -Math.PI) d += Math.PI * 2;\\n      this.angle = a;\\n      const inst = d / Math.max(dt, 1e-4);\\n      const k = 1 - Math.exp(-dt / 0.25);\\n      this.omega += (inst - this.omega) * k;\\n    } else {\\n320→      this.omega += (0 - this.omega) * Math.min(1, dt / 0.25);\\n    }\\n    const rev = this.omega / (Math.PI * 2);\\n    const want = this.dirAt(t);\\n    const low = this.T.hoopLow ?? 0.9;\\n    const high = (this.T.hoopHigh ?? 2.4) * (this.hard ? 0.9 : 1);\\n    const signOk = want === 0 || rev * want > 0;\\n    const inBand = Math.abs(rev) >= low && Math.abs(rev) <= high && signOk;\\n    const wrong = want !== 0 && rev * want < -0.2;\\n    const lift = this.T.hoopLiftRate ?? 0.35;\\n330→    if (inBand) this.L += lift * dt;\\n    else if (wrong) this.L -= 0.5 * dt;\\n    else this.L -= 0.25 * dt;\\n    this.L = clamp(this.L, 0, 1.4);\\n    if (this.L <= 0) this.drop = 1.5;\\n    if (scoring && inBand) this.rot += Math.abs(rev) * dt;\\n    if (scoring) this.toss(dt, u, t);\\n  }\\n  toss(dt, u, t) {\\n    if (!this.throw && t >= this.throwT) {\\n340→      this.throw = { side: this.rand() < 0.5 ? -1 : 1, age: 0 };\\n      this.throwT += 9;\\n    }\\n    if (!this.throw) return;\\n    this.throw.age += dt;\\n    const left = 1.5 - this.throw.age;\\n    if (left < 0.4 && left > 0 && Math.abs(u.x) > 0.7 && Math.sign(u.x) === this.throw.side) {\\n      this.catches += 1;\\n      this.rot += 0.5;\\n      this.throw = null;\\n350→    } else if (this.throw.age >= 1.5) this.throw = null;\\n  }\\n  scoreStars() {\\n    this.score = this.rot;\\n    super.scoreStars();\\n  }\\n}\\n\\nconst STEP_BAR = 'L.R.L.R.LRL.R.L.R.';\\n\\n360→export class StepSim extends Sim {\\n  _built() {\\n    this.notes = [];\\n    const bpm = 104;\\n    const step = 60 / bpm / 4;\\n    const bars = 32;\\n    let t = 0;\\n    for (let b = 0; b < bars; b++) {\\n      for (const ch of STEP_BAR) {\\n        if (ch === 'L' || ch === 'R') this.notes.push({ t, foot: ch, hit: false });\\n370→        t += step;\\n      }\\n    }\\n    this.playLen = t;\\n    this.p = 0;\\n    this.g = 0;\\n    this.o = 0;\\n    this.miss = 0;\\n    this.prevL = false;\\n    this.prevR = false;\\n380→    this.combo = 0;\\n  }\\n  playFinished() {\\n    return this.playT >= this.playLen + 0.2;\\n  }\\n  auto() {\\n    const win = 0.02;\\n    const late = this.skill === 'sloppy' ? 0.12 : this.skill === 'average' ? 0.08 : this.skill === 'good' ? 0.04 : 0;\\n    let stepL = false;\\n    let stepR = false;\\n390→    if (this.skill !== 'idle') {\\n      for (const n of this.notes) {\\n        if (n.hit) continue;\\n        const when = n.t + late;\\n        if (Math.abs(this.playT - when) <= win) {\\n          if (n.foot === 'L') stepL = true;\\n          else stepR = true;\\n        }\\n      }\\n    }\\n400→    return { ...ZERO, stepL, stepR, edgeL: stepL, edgeR: stepR };\\n  }\\n  onStep(dt, u, scoring) {\\n    if (scoring) this.playT += dt;\\n    const judged = this.playT + (this.T.stepOffsetMs || 0) / 1000;\\n    const scale = (this.T.stepWindow || 1) * (this.hard ? 0.85 : 1);\\n    const P = 0.055 * scale;\\n    const G = 0.1 * scale;\\n    const O = 0.14 * scale;\\n    const edgeL = !!u.stepL && !this.prevL;\\n410→    const edgeR = !!u.stepR && !this.prevR;\\n    this.prevL = !!u.stepL;\\n    this.prevR = !!u.stepR;\\n    if (!scoring) return;\\n    if (edgeL) this.strike('L', judged, P, G, O);\\n    if (edgeR) this.strike('R', judged, P, G, O);\\n    for (const n of this.notes) {\\n      if (!n.hit && judged > n.t + O) {\\n        n.hit = true;\\n        this.miss += 1;\\n420→        this.combo = 0;\\n      }\\n    }\\n  }\\n  strike(foot, judged, P, G, O) {\\n    let best = null;\\n    let bestAbs = 1e9;\\n    for (const n of this.notes) {\\n      if (n.hit || n.foot !== foot) continue;\\n      const ad = Math.abs(judged - n.t);\\n430→      if (ad < bestAbs) {\\n        best = n;\\n        bestAbs = ad;\\n      }\\n    }\\n    if (!best || bestAbs > O) return;\\n    best.hit = true;\\n    if (bestAbs <= P) this.p += 1;\\n    else if (bestAbs <= G) this.g += 1;\\n    else this.o += 1;\\n440→    this.combo += 1;\\n  }\\n  scoreStars() {\\n    const N = this.notes.length || 1;\\n    this.score = (100 * (this.p + 0.7 * this.g + 0.4 * this.o)) / N;\\n    super.scoreStars();\\n  }\\n}\\n\\nexport class HeaderSim extends Sim {\\n450→  _built() {\\n    this.x = 0;\\n    this.objs = [];\\n    this.spawn = 0.4;\\n    this.score = 0;\\n    this.combo = 0;\\n    this.daze = 0;\\n    this.hitR = 0.2;\\n  }\\n  playFinished() {\\n460→    return this.playT >= 60;\\n  }\\n  lane() {\\n    return 2;\\n  }\\n  auto() {\\n    if (this.skill === 'idle') return { ...ZERO };\\n    const soon = this.objs.filter((o) => !o.done).sort((a, b) => a.land - b.land)[0];\\n    if (!soon) return { ...ZERO, x: -this.x * 0.5 };\\n    let tx = soon.x;\\n470→    const dodge = this.skill === 'expert' || this.skill === 'good' || this.skill === 'average';\\n    if (soon.kind === 'flip' && dodge) tx = clamp(soon.x + (soon.x < 0 ? 0.7 : -0.7), -2, 2);\\n    const err = tx - this.x;\\n    const gain = this.skill === 'sloppy' ? 0.25 : 1;\\n    return { ...ZERO, x: clamp(err * 2 * gain, -1, 1) };\\n  }\\n  onStep(dt, u, scoring) {\\n    if (scoring) this.playT += dt;\\n    const t = this.playT;\\n    if (this.daze > 0) this.daze -= dt;\\n480→    const speed = 4.5 * (this.daze > 0 ? 0 : u.x || 0);\\n    this.x = clamp(this.x + speed * dt, -this.lane(), this.lane());\\n    if (!scoring) return;\\n    const span = lerp(1.3, 0.7, clamp(t / 60, 0, 1)) * (this.T.headerInterval || 1) * (this.hard ? 0.8 : 1);\\n    this.spawn -= dt;\\n    if (this.spawn <= 0 && t < 58) {\\n      this.spawn += span;\\n      const roll = this.rand();\\n      const kind = roll < 0.7 ? 'coco' : roll < 0.95 ? 'flip' : 'pine';\\n      const x = (this.rand() * 2 - 1) * 1.85;\\n490→      this.objs.push({ x, kind, land: t + 1.4, done: false });\\n    }\\n    const radius = this.hitR * (this.hard ? 0.85 : 1);\\n    for (const o of this.objs) {\\n      if (o.done || t < o.land) continue;\\n      o.done = true;\\n      const hit = Math.abs(this.x - o.x) < radius;\\n      if (o.kind === 'coco' && hit) {\\n        this.combo += 1;\\n        const tier = this.combo >= 20 ? 4 : this.combo >= 10 ? 3 : this.combo >= 5 ? 2 : 1;\\n500→        this.score += 10 * tier;\\n      } else if (o.kind === 'pine' && hit) {\\n        this.combo += 1;\\n        this.score += 30;\\n      } else if (o.kind === 'flip' && hit) {\\n        this.score -= 10;\\n        this.combo = 0;\\n        this.daze = 0.6;\\n      } else if (o.kind === 'flip' && !hit) {\\n        /* dodged */\",\"content_concise\":\"190→  }\\n}\\n\\nfunction repTarget(u) {\\n  if (u < 0.4) return u / 0.4;\\n  if (u < 0.55) return 1;\\n  if (u < 0.9) return 1 - (u - 0.55) / 0.35;\\n  return 0;\\n}\\nfunction repSlope(u) {\\n200→  if (u < 0.4) return 1 / 0.4;\\n  if (u < 0.55) return 0;\\n  if (u < 0.9) return -1 / 0.35;\\n  return 0;\\n}\\n\\nexport class RepSim extends Sim {\\n  _built() {\\n    this.announced = this.def.reps;\\n    this.total = this.def.reps + 2;\\n210→    this.r = 0;\\n    this.err = 0;\\n    this.n = 0;\\n    this.rep = 0;\\n    this.gag = '';\\n  }\\n  tempo() {\\n    return (this.def.tempo / (this.T.repTempoScale || 1)) * (this.hard ? 0.85 : 1);\\n  }\\n  playFinished() {\\n220→    return this.playT >= this.total * this.tempo();\\n  }\\n  auto(dt) {\\n    const tempo = this.tempo();\\n    const uRep = this.playT > 0 ? (this.playT % tempo) / tempo : 0;\\n    const target = repTarget(uRep);\\n    const slope = repSlope(uRep) / tempo;\\n    const lag = (this.T.repLag || 0.1) * (this.def.lag || 1);\\n    let depth = 0;\\n    if (this.skill === 'expert' || this.skill === 'good') depth = clamp(target + slope * lag, 0, 1);\\n230→    else if (this.skill === 'average') depth = clamp(target * 0.75, 0, 1);\\n    else if (this.skill === 'sloppy') depth = clamp(target * 0.25 + 0.1, 0, 1);\\n    const side = this.rep % 2 === 0 ? 1 : -1;\\n    return { ...ZERO, depth, x: this.def.axis === 'side' ? side * depth : 0, y: this.def.axis === 'up' ? depth : -depth };\\n  }\\n  onStep(dt, u, scoring) {\\n    const tempo = this.tempo();\\n    if (scoring) this.playT += dt;\\n    const clock = scoring ? this.playT : this.phaseT;\\n    const rep = Math.min(this.total - 1, Math.floor(clock / tempo));\\n240→    if (rep !== this.rep) {\\n      this.rep = rep;\\n      const n = rep + 1;\\n      if (n === this.announced) this.gag = 'Last one.';\\n      else if (n === this.announced + 1) this.gag = 'Last one.';\\n      else if (n === this.announced + 2) {\\n        this.gag = 'I lied. This is the last one.';\\n        this.lied = true;\\n      }\\n    }\\n250→    const uRep = (clock % tempo) / tempo;\\n    const target = repTarget(uRep);\\n    const lag = (this.T.repLag || 0.1) * (this.def.lag || 1);\\n    let depth = u.depth || 0;\\n    if (u.useRate) {\\n      this.r = clamp(this.r + (u.rate || 0) * dt, 0, 1);\\n    } else {\\n      const k = Math.min(1, dt / lag);\\n      this.r += (depth - this.r) * k;\\n    }\\n260→    const amp = (this.T.repFatigue || 0) * (rep / this.total) ** 2;\\n    this.r = clamp(this.r + amp * Math.sin(40 * clock) * dt * 8, 0, 1);\\n    if (scoring && uRep < 0.9) {\\n      this.err += Math.abs(this.r - target);\\n      this.n += 1;\\n    }\\n  }\\n  scoreStars() {\\n    const mean = this.n ? this.err / this.n : 1;\\n    this.score = clamp(1 - 1.6 * mean, 0, 1) * 100;\\n270→    super.scoreStars();\\n  }\\n}\\n\\nexport class HoopSim extends Sim {\\n  _built() {\\n    this.angle = 0;\\n    this.omega = 0;\\n    this.L = 1;\\n    this.rot = 0;\\n280→    this.drop = 0;\\n    this.theta = 0;\\n    this.catches = 0;\\n    this.throwT = 6;\\n    this.throw = null;\\n  }\\n  playFinished() {\\n    return this.playT >= 60;\\n  }\\n  dirAt(t) {\\n290→    if (t < 25) return 1;\\n    if (t < 50) return -1;\\n    return 0;\\n  }\\n  auto(dt) {\\n    if (this.skill === 'idle') return { ...ZERO };\\n    const speed = this.skill === 'expert' || this.skill === 'good' ? 2 : this.skill === 'average' ? 1.15 : 0.35;\\n    const want = this.dirAt(this.playT);\\n    const spin = want === 0 ? 1 : want;\\n    this.theta += spin * speed * Math.PI * 2 * dt;\\n300→    return { ...ZERO, x: Math.cos(this.theta), y: Math.sin(this.theta) };\\n  }\\n  onStep(dt, u, scoring) {\\n    if (scoring) this.playT += dt;\\n    const t = scoring ? this.playT : 0;\\n    if (this.drop > 0) {\\n      this.drop -= dt;\\n      return;\\n    }\\n    const mag = Math.hypot(u.x, u.y);\\n310→    if (mag > 0.5) {\\n      const a = Math.atan2(u.y, u.x);\\n      let d = a - this.angle;\\n      while (d > Math.PI) d -= Math.PI * 2;\\n      while (d < -Math.PI) d += Math.PI * 2;\\n      this.angle = a;\\n      const inst = d / Math.max(dt, 1e-4);\\n      const k = 1 - Math.exp(-dt / 0.25);\\n      this.omega += (inst - this.omega) * k;\\n    } else {\\n320→      this.omega += (0 - this.omega) * Math.min(1, dt / 0.25);\\n    }\\n    const rev = this.omega / (Math.PI * 2);\\n    const want = this.dirAt(t);\\n    const low = this.T.hoopLow ?? 0.9;\\n    const high = (this.T.hoopHigh ?? 2.4) * (this.hard ? 0.9 : 1);\\n    const signOk = want === 0 || rev * want > 0;\\n    const inBand = Math.abs(rev) >= low && Math.abs(rev) <= high && signOk;\\n    const wrong = want !== 0 && rev * want < -0.2;\\n    const lift = this.T.hoopLiftRate ?? 0.35;\\n330→    if (inBand) this.L += lift * dt;\\n    else if (wrong) this.L -= 0.5 * dt;\\n    else this.L -= 0.25 * dt;\\n    this.L = clamp(this.L, 0, 1.4);\\n    if (this.L <= 0) this.drop = 1.5;\\n    if (scoring && inBand) this.rot += Math.abs(rev) * dt;\\n    if (scoring) this.toss(dt, u, t);\\n  }\\n  toss(dt, u, t) {\\n    if (!this.throw && t >= this.throwT) {\\n340→      this.throw = { side: this.rand() < 0.5 ? -1 : 1, age: 0 };\\n      this.throwT += 9;\\n    }\\n    if (!this.throw) return;\\n    this.throw.age += dt;\\n    const left = 1.5 - this.throw.age;\\n    if (left < 0.4 && left > 0 && Math.abs(u.x) > 0.7 && Math.sign(u.x) === this.throw.side) {\\n      this.catches += 1;\\n      this.rot += 0.5;\\n      this.throw = null;\\n350→    } else if (this.throw.age >= 1.5) this.throw = null;\\n  }\\n  scoreStars() {\\n    this.score = this.rot;\\n    super.scoreStars();\\n  }\\n}\\n\\nconst STEP_BAR = 'L.R.L.R.LRL.R.L.R.';\\n\\n360→export class StepSim extends Sim {\\n  _built() {\\n    this.notes = [];\\n    const bpm = 104;\\n    const step = 60 / bpm / 4;\\n    const bars = 32;\\n    let t = 0;\\n    for (let b = 0; b < bars; b++) {\\n      for (const ch of STEP_BAR) {\\n        if (ch === 'L' || ch === 'R') this.notes.push({ t, foot: ch, hit: false });\\n370→        t += step;\\n      }\\n    }\\n    this.playLen = t;\\n    this.p = 0;\\n    this.g = 0;\\n    this.o = 0;\\n    this.miss = 0;\\n    this.prevL = false;\\n    this.prevR = false;\\n380→    this.combo = 0;\\n  }\\n  playFinished() {\\n    return this.playT >= this.playLen + 0.2;\\n  }\\n  auto() {\\n    const win = 0.02;\\n    const late = this.skill === 'sloppy' ? 0.12 : this.skill === 'average' ? 0.08 : this.skill === 'good' ? 0.04 : 0;\\n    let stepL = false;\\n    let stepR = false;\\n390→    if (this.skill !== 'idle') {\\n      for (const n of this.notes) {\\n        if (n.hit) continue;\\n        const when = n.t + late;\\n        if (Math.abs(this.playT - when) <= win) {\\n          if (n.foot === 'L') stepL = true;\\n          else stepR = true;\\n        }\\n      }\\n    }\\n400→    return { ...ZERO, stepL, stepR, edgeL: stepL, edgeR: stepR };\\n  }\\n  onStep(dt, u, scoring) {\\n    if (scoring) this.playT += dt;\\n    const judged = this.playT + (this.T.stepOffsetMs || 0) / 1000;\\n    const scale = (this.T.stepWindow || 1) * (this.hard ? 0.85 : 1);\\n    const P = 0.055 * scale;\\n    const G = 0.1 * scale;\\n    const O = 0.14 * scale;\\n    const edgeL = !!u.stepL && !this.prevL;\\n410→    const edgeR = !!u.stepR && !this.prevR;\\n    this.prevL = !!u.stepL;\\n    this.prevR = !!u.stepR;\\n    if (!scoring) return;\\n    if (edgeL) this.strike('L', judged, P, G, O);\\n    if (edgeR) this.strike('R', judged, P, G, O);\\n    for (const n of this.notes) {\\n      if (!n.hit && judged > n.t + O) {\\n        n.hit = true;\\n        this.miss += 1;\\n420→        this.combo = 0;\\n      }\\n    }\\n  }\\n  strike(foot, judged, P, G, O) {\\n    let best = null;\\n    let bestAbs = 1e9;\\n    for (const n of this.notes) {\\n      if (n.hit || n.foot !== foot) continue;\\n      const ad = Math.abs(judged - n.t);\\n430→      if (ad < bestAbs) {\\n        best = n;\\n        bestAbs = ad;\\n      }\\n    }\\n    if (!best || bestAbs > O) return;\\n    best.hit = true;\\n    if (bestAbs <= P) this.p += 1;\\n    else if (bestAbs <= G) this.g += 1;\\n    else this.o += 1;\\n440→    this.combo += 1;\\n  }\\n  scoreStars() {\\n    const N = this.notes.length || 1;\\n    this.score = (100 * (this.p + 0.7 * this.g + 0.4 * this.o)) / N;\\n    super.scoreStars();\\n  }\\n}\\n\\nexport class HeaderSim extends Sim {\\n450→  _built() {\\n    this.x = 0;\\n    this.objs = [];\\n    this.spawn = 0.4;\\n    this.score = 0;\\n    this.combo = 0;\\n    this.daze = 0;\\n    this.hitR = 0.2;\\n  }\\n  playFinished() {\\n460→    return this.playT >= 60;\\n  }\\n  lane() {\\n    return 2;\\n  }\\n  auto() {\\n    if (this.skill === 'idle') return { ...ZERO };\\n    const soon = this.objs.filter((o) => !o.done).sort((a, b) => a.land - b.land)[0];\\n    if (!soon) return { ...ZERO, x: -this.x * 0.5 };\\n    let tx = soon.x;\\n470→    const dodge = this.skill === 'expert' || this.skill === 'good' || this.skill === 'average';\\n    if (soon.kind === 'flip' && dodge) tx = clamp(soon.x + (soon.x < 0 ? 0.7 : -0.7), -2, 2);\\n    const err = tx - this.x;\\n    const gain = this.skill === 'sloppy' ? 0.25 : 1;\\n    return { ...ZERO, x: clamp(err * 2 * gain, -1, 1) };\\n  }\\n  onStep(dt, u, scoring) {\\n    if (scoring) this.playT += dt;\\n    const t = this.playT;\\n    if (this.daze > 0) this.daze -= dt;\\n480→    const speed = 4.5 * (this.daze > 0 ? 0 : u.x || 0);\\n    this.x = clamp(this.x + speed * dt, -this.lane(), this.lane());\\n    if (!scoring) return;\\n    const span = lerp(1.3, 0.7, clamp(t / 60, 0, 1)) * (this.T.headerInterval || 1) * (this.hard ? 0.8 : 1);\\n    this.spawn -= dt;\\n    if (this.spawn <= 0 && t < 58) {\\n      this.spawn += span;\\n      const roll = this.rand();\\n      const kind = roll < 0.7 ? 'coco' : roll < 0.95 ? 'flip' : 'pine';\\n      const x = (this.rand() * 2 - 1) * 1.85;\\n490→      this.objs.push({ x, kind, land: t + 1.4, done: false });\\n    }\\n    const radius = this.hitR * (this.hard ? 0.85 : 1);\\n    for (const o of this.objs) {\\n      if (o.done || t < o.land) continue;\\n      o.done = true;\\n      const hit = Math.abs(this.x - o.x) < radius;\\n      if (o.kind === 'coco' && hit) {\\n        this.combo += 1;\\n        const tier = this.combo >= 20 ? 4 : this.combo >= 10 ? 3 : this.combo >= 5 ? 2 : 1;\\n500→        this.score += 10 * tier;\\n      } else if (o.kind === 'pine' && hit) {\\n        this.combo += 1;\\n        this.score += 30;\\n      } else if (o.kind === 'flip' && hit) {\\n        this.score -= 10;\\n        this.combo = 0;\\n        this.daze = 0.6;\\n      } else if (o.kind === 'flip' && !hit) {\\n        /* dodged */\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/sims.js\",\"offset\":190,\"limit\":320,\"raw_output\":\"  }\\n}\\n\\nfunction repTarget(u) {\\n  if (u < 0.4) return u / 0.4;\\n  if (u < 0.55) return 1;\\n  if (u < 0.9) return 1 - (u - 0.55) / 0.35;\\n  return 0;\\n}\\nfunction repSlope(u) {\\n  if (u < 0.4) return 1 / 0.4;\\n  if (u < 0.55) return 0;\\n  if (u < 0.9) return -1 / 0.35;\\n  return 0;\\n}\\n\\nexport class RepSim extends Sim {\\n  _built() {\\n    this.announced = this.def.reps;\\n    this.total = this.def.reps + 2;\\n    this.r = 0;\\n    this.err = 0;\\n    this.n = 0;\\n    this.rep = 0;\\n    this.gag = '';\\n  }\\n  tempo() {\\n    return (this.def.tempo / (this.T.repTempoScale || 1)) * (this.hard ? 0.85 : 1);\\n  }\\n  playFinished() {\\n    return this.playT >= this.total * this.tempo();\\n  }\\n  auto(dt) {\\n    const tempo = this.tempo();\\n    const uRep = this.playT > 0 ? (this.playT % tempo) / tempo : 0;\\n    const target = repTarget(uRep);\\n    const slope = repSlope(uRep) / tempo;\\n    const lag = (this.T.repLag || 0.1) * (this.def.lag || 1);\\n    let depth = 0;\\n    if (this.skill === 'expert' || this.skill === 'good') depth = clamp(target + slope * lag, 0, 1);\\n    else if (this.skill === 'average') depth = clamp(target * 0.75, 0, 1);\\n    else if (this.skill === 'sloppy') depth = clamp(target * 0.25 + 0.1, 0, 1);\\n    const side = this.rep % 2 === 0 ? 1 : -1;\\n    return {