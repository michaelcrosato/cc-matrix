191,\"content\":\"    const lunge = hold('lunge', right, 0.5);\"},{\"line_number\":192,\"content\":\"    const press = hold('press', up, 0.5);\"},{\"line_number\":195,\"content\":\"    const idle = hold('lunge', read('pad', { x: 0, y: 0 }), 0.5);\"},{\"line_number\":196,\"content\":\"    const pressRight = hold('press', right, 0.5);\"},{\"line_number\":197,\"content\":\"    assert(lunge > 0.5, `lunge r ${lunge}`);\"},{\"line_number\":198,\"content\":\"    assert(press > 0.5, `press r ${press}`);\"},{\"line_number\":202,\"content\":\"    assert(pressRight < 0.08, `press ignored right ${pressRight}`);\"},{\"line_number\":234,\"content\":\"      const report = checkModel(model);\"},{\"line_number\":235,\"content\":\"      assert(report.problems.length === 0, `${model.id || model.name} ${report.problems.join(';')}`);\"},{\"line_number\":250,\"content\":\"        for (const repeat of [false, true]) {\"},{\"line_number\":251,\"content\":\"          const found = linesFor(def.id, stars, repeat);\"},{\"line_number\":252,\"content\":\"          assert(found.length >= 1, `missing ${def.id} ${stars} ${repeat}`);\"},{\"line_number\":259,\"content\":\"    const flat = pages.flatMap((p) => p.lines).join('').replace(/\\\\s+/g, '');\"},{\"line_number\":260,\"content\":\"    const compact = (s) => String(s).replace(/\\\\s+/g, '');\"},{\"line_number\":353,\"content\":\"        const report = analyzeClip(model, HERO_RIG, def, clip);\"},{\"line_number\":354,\"content\":\"        assert(report.problems.length === 0, `${def.name} analyze ${report.problems.join(';')}`);\"},{\"line_number\":583,\"content\":\"      const claim = (index, axis) => {\"},{\"line_number\":586,\"content\":\"          axes: [axis, 0, 0, 0],\"},{\"line_number\":587,\"content\":\"          buttons: [{ pressed: true, value: 1 }, ...Array.from({ length: 15 }, () => ({ pressed: false, value: 0 }))],\"},{\"line_number\":821,\"content\":\"    await test('replay fingerprint', async () => {\"},{\"line_number\":829,\"conten