escription, dripRate = 1) {\"},{\"line_number\":21,\"content\":\"export function wobbleAge(samples, totalStars, weight = 0.5) {\"},{\"line_number\":29,\"content\":\"export const JAR_MILESTONES = [10, 25, 45, 70, 100, 135, 175];\"},{\"line_number\":31,\"content\":\"export const JAR_ITEMS = [\"},{\"line_number\":41,\"content\":\"export function milestonesReached(drips) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/art/avatar.js\",\"matches\":[{\"line_number\":17,\"content\":\"export function dress(root, look) {\"},{\"line_number\":69,\"content\":\"export const PLAYER_LOOK = { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink', headband: 'red' };\"},{\"line_number\":70,\"content\":\"export const COACH_LOOK = { skin: 'sand', top: 'cyan', bottom: 'cyan', shoe: 'white', hair: 'mist', bun: true, long: true, headband: 'white' };\"},{\"line_number\":72,\"content\":\"export const LOOK_CHOICES = {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/device.js\",\"matches\":[{\"line_number\":5,\"content\":\"export class Device {\"},{\"line_number\":21,\"content\":\"export function detectTouchOnly() {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/art/glyphs.js\",\"matches\":[{\"line_number\":2,\"content\":\"export const GLYPH = {\"},{\"line_number\":12,\"content\":\"export const GLYPH_COLOR = {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/actions.js\",\"matches\":[{\"line_number\":2,\"content\":\"export const ACTIONS = {\"},{\"line_number\":17,\"content\":\"export const GAMEPAD_BUTTONS = {\"},{\"line_number\":36,\"content\":\"export function promptFor(kind, glyphs, verb) {\"},{\"line_number\":43,\"content\":\"export function glyphKind(deviceKind, glyphs) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/art/textures.js\",\"matches\":[{\"line_number\":3,\"content\":\"export const clinicTile = textureDef({\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/audio/voice.js\",\"matches\":[{\"line_number\":3,\"content\":\"export const SPEAKERS = {\"},{\"line_number\":46,\"content\":\"export function syllabify(text, speaker = 'ounce') {\"},{\"line_number\":110,\"content\":\"export function renderVoice(audioCtx, destination, syllables, when = 0, speaker = 'ounce') {\"},{\"line_number\":148,\"content\":\"export function speak(ctx, text, speaker = 'ounce') {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/art/models.js\",\"matches\":[{\"line_number\":3,\"content\":\"export const ounce = model({\"},{\"line_number\":51,\"content\":\"export const yogaMat = model({\"},{\"line_number\":63,\"content\":\"export const hoop = model({\"},{\"line_number\":75,\"content\":\"export const coconut = model({\"},{\"line_number\":87,\"content\":\"export const jar = model({\"},{\"line_number\":101,\"content\":\"export const palm = model({\"},{\"line_number\":114,\"content\":\"export const pavilion = model({\"},{\"line_number\":130,\"content\":\"export const pier = model({\"},{\"line_number\":143,\"content\":\"export const kevin = model({\"},{\"line_number\":160,\"content\":\"export const ferry = model({\"},{\"line_number\":173,\"content\":\"export const hammock = model({\"},{\"line_number\":186,\"content\":\"export const vitamin = model({\"},{\"line_number\":195,\"content\":\"export const MODELS = [ounce, yogaMat, hoop, coconut, jar, palm, pavilion, pier, kevin, ferry, hammock, vitamin];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/ui/font.js\",\"matches\":[{\"line_number\":12,\"content\":\"export const GLYPHS = Object.fromEntries(Object.entries(H).map(([k, v]) => [k, v.split(' ').map((h) => parseInt(h, 16).toString(2).padStart(5, '0').replace(/0/g, '.').replace(/1/g, 'o'))]));\"},{\"line_number\":15,\"content\":\"export const HUD_EXTRA = \\\"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.,!?'\\\\\\\": :;-()/+%*\\\";\"},{\"line_number\":17,\"content\":\"export function hasGlyph(ch) {\"},{\"line_number\":23,\"content\":\"export function missingGlyphs(text) {\"},{\"line_number\":29,\"content\":\"export function say(hud, x, y, text, { color = 'white', shadow = 'ink', scale = 1 } = {}) {\"},{\"line_number\":39,\"content\":\"export function measureText(text, scale = 1) {\"},{\"line_number\":44,\"content\":\"export function wrapText(text, cols) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/sims.js\",\"matches\":[{\"line_number\":15,\"content\":\"export class Sim {\"},{\"line_number\":115,\"content\":\"export class StillSim extends Sim {\"},{\"line_number\":206,\"content\":\"export class RepSim extends Sim {\"},{\"line_number\":274,\"content\":\"export class HoopSim extends Sim {\"},{\"line_number\":360,\"content\":\"export class StepSim extends Sim {\"},{\"line_number\":449,\"content\":\"export class HeaderSim extends Sim {\"},{\"line_number\":518,\"content\":\"export class SlackSim extends Sim {\"},{\"line_number\":593,\"content\":\"export const TRAY_BOARDS = [\"},{\"line_number\":623,\"content\":\"export class TraySim extends Sim {\"},{\"line_number\":717,\"content\":\"export class JogSim extends Sim {\"},{\"line_number\":827,\"content\":\"export class PierSim extends Sim {\"},{\"line_number\":932,\"content\":\"export const LONG_EVENTS = [\"},{\"line_number\":947,\"content\":\"export class LongSim extends StillSim {\"},{\"line_number\":991,\"content\":\"export class WeighSim {\"},{\"line_number\":1069,\"content\":\"export function createSim(id, opts) {\"},{\"line_number\":1077,\"content\":\"export function simulate(id, opts) {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-d99c45f6-e148-4b1b-80e7-c4ff01d4753b-7","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"761→## 16. Architecture\\n\\nDownload the kit (the URL is in your brief) and copy the contents of the zip's top-level `pixel-engine/` folder into the dev folder, so `pixel-engine.js`, `check.mjs` and the guides sit at its root. **Never edit `pixel-engine.js`**: record its sha256 in `vendor/pixel-engine.sha256` when you unzip, and a test compares it. Fetch the hub's `session.js`, `harness.html`, `bridge.js`, `round.js` and `README.md` into `vendor/hub/` from `https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/`.\\n\\n```\\npixel-engine.js  check.mjs  GUIDE.md ...        the kit, untouched\\nvendor/hub/                                     hub client and harness, untouched\\nsrc/main.js                                     boot: session check, Engine.start, first scene\\nsrc/app.js                                      App: scene switching, save, settings, tunables, device, debug API\\n770→src/core/      dot.js drivers.js actions.js device.js tunables.js save.js net.js clock.js\\nsrc/ui/        font.js menu.js dialogue.js widgets.js prompts.js screens/*\\nsrc/audio/     voice.js songs.js sfx.js\\nsrc/art/       avatar.js models.js textures.js clips.js glyphs.js portraits.js\\nsrc/data/      title.js activities.js poses.js reps.js charts.js boards.js week.js lines.js\\n               questions.js unlocks.js classmates.js stations.js medley.js about.js\\nsrc/scenes/    base.js boot.js title.js attract.js hub.js weighin.js report.js locker.js records.js jar.js\\n               card.js medley.js join.js ending.js  activity/{base,poses,reps,hoop,step,header,slackline,tray,jog,pier,longstand}.js\\ntools/         build.mjs test.mjs clip-sheet.mjs shot.mjs\\ntests/         headless/*.mjs  browser/*.mjs\\n780→```\\n\\n**Everything a designer would change is plain data in `src/data/`:** poses, exercises, charts, boards, schedules, lines, unlocks, stars. A new pose, chart, board or day needs no code. That is what lets the rest of the game be built out later with normal tools, together with the live sliders and their JSON export.\\n\\n**Engine patterns:**\\n- Start ✔: `Engine.start(new Boot(), withUrlOptions({ container: document.getElementById('app'), aspect: 'fill', touch: false, settings: { button: touchOnly ? 'top-right' : false }, quality: info ? 'medium' : 'high', seed, background: PALETTE.sky, camera }))`.\\n- Each scene is a `Game`, swapped with `engine.loadGame(scene, { camera })`. It frees everything per level; keep persistent state in `App`. Transition: `await screen.cover('iris')`, `await loadGame`, `await screen.reveal('iris')`.\\n- `BaseScene` owns the frame order: `update` → `App.device.update` → overlays (pause, dialogue, dev) take input first → the scene's own update → `hud.clear()` → scene draw → overlays draw. Gameplay goes in `fixedUpdate`, skipped automatically while `timeScale` is 0.\\n- **Rules from the guide that matter here:** gameplay in `fixedUpdate` with `consumePress`; `wasPressed` only in `update`; all randomness from `ctx.random` forks (never `Math.random`); time from `ctx.time` (never `performance.now`); no `new PointLight`. Modules guard `document`, `window`, `navigator` and `localStorage`, so **everything runs in Node** ✔.\\n- **Drivers** (`src/core/drivers.js`): `read(out)` fills `{ x, y, breath, stepL, stepR, confirm }`. `LocalDriver` (engine input and mouse), `PadDriver(index)` (Family Hour), `BotDriver(skill)`, `GhostDriver` (display only). Attract, tests, classmates and online all reuse this one seam.\\n790→- **Debug API**, kept in the shipped game (`globalThis.__GAME__ = App`): `go(id, args)`, `state()` as JSON, `setDriver(skill)`, `tunables`. Give every scene a real `status()` line (`activity hoop | play | t 31.2 | score 412`) and a `fingerprint()` (score, Dot state).\\n\\n---\\n\\n## 17. Verified recipes\\n\\n### Single-file build ✔ (boots on `file://` in about 1.3 s; passes `check.mjs` and the harness)\\n\\n```js\\n// tools/build.mjs (esbuild is on this machine)\\n800→execFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--platform=browser', '--target=esnext', '--charset=utf8', '--outfile=.build/bundle.js', '--log-level=warning'], { stdio: 'inherit' });\\nconst safe = (s) => s.replace(/<\\\\/script/gi, '<\\\\\\\\/script').replace(/<!--/g, '<\\\\\\\\!--');\\nconst html = `<!doctype html>\\n<html lang=\\\"en\\\"><head>\\n<meta charset=\\\"utf-8\\\">\\n<script>${readFileSync('vendor/hub/session.js', 'utf8')}</script>\\n${HUB_METAS}\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\\\">\\n<link rel=\\\"icon\\\" href=\\\"data:,\\\"><title>${TITLE}</title>\\n<style>html, body { margin: 0; height: 100%; background: #0d0b14; } #app { position: fixed; inset: 0; }</style>\\n810→</head><body><div id=\\\"app\\\"></div>\\n<script type=\\\"module\\\">${safe(readFileSync('.build/bundle.js', 'utf8'))}</script>\\n</body></html>`;\\nwriteFileSync(OUTPUT_HTML, html);   // OUTPUT_HTML: the deliverable name your brief gives, in root\\n```\\n\\nThe session client goes in **unmodified**: the hub replaces an unmodified copy with each new version. Nothing is fetched at runtime, so the game needs no CDN. Bundling doesn't count as editing the engine; `pixel-engine.js` itself stays byte-identical. Output is about 5.4 MB.\\n\\n### Browser flags ✔\\n\\n820→**Use all five.** With only the three in the machine notes, `renderer.capture()` failed: `mapAsync ... A valid external Instance reference no longer exists`.\\n\\n```\\n--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-angle=swiftshader --use-webgpu-adapter=swiftshader\\n```\\n\\n### Node Playwright and the kit's check ✔\\n\\n`npm install playwright@1.63.0` in the dev folder. Then `node check.mjs <page> --keys KeyD*30` works on the built html if it's copied into the dev folder.\\n\\n830→### Screenshots ✔\\n\\nThe live loop rejects `capture()`, and a WebGPU canvas may screenshot blank. So step first, and composite the HUD:\\n\\n```js\\nconst e = window.__PIXEL_ENGINE__; e.step(30);          // switches to manual time\\nconst f = await e.renderer.capture();                   // { width, height, pixels }\\nconst c = document.createElement('canvas'); c.width = f.width; c.height = f.height;\\nconst g = c.getContext('2d'); g.putImageData(new ImageData(new Uint8ClampedArray(f.pixels), f.width, f.height), 0, 0);\\ng.imageSmoothingEnabled = false; if (e.hud.canvas?.width) g.drawImage(e.hud.canvas, 0, 0, f.width, f.height);\\n840→return c.toDataURL('image/png');\\n```\\n\\nPut this in `tools/shot.mjs <scene> [--size 1920x1080]`. Use it only for what a script can't judge: composition and legibility. Judge the 10-foot view at 1920×1080.\\n\\n### Gamepad stub ✔\\n\\nAdd as an init script; change the state from the test:\\n\\n```js\\n850→window.__pad = { buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })), axes: [0, 0, 0, 0] };\\nnavigator.getGamepads = () => [{ id: 'Stub', index: 0, connected: true, mapping: 'standard', timestamp: performance.now(), axes: __pad.axes, buttons: __pad.buttons }, null, null, null];\\n```\\n\\nRead inputs through a frame: `moveAxis()` gave (0.8, 0.6) for axes (0.8, -0.6) in-game. Headless, `e.input.setKey('PadCross', true)` works without any stub ✔.\\n\\n### Hub harness ✔\\n\\nCopy the built html (as `game.html`) with `harness.html`, `bridge.js` and `round.js` into a temp folder inside the dev folder. Serve it with `python3 -u -m http.server 0 --bind 127.0.0.1` ✔, reading the port from its first output line and stopping it by its PID. An in-process `node:http` server on `127.0.0.1` and port 0 also works, but it must send `Content-Type: text/javascript` for `.js`, or the harness's module imports fail. Then for each of:\\n\\n860→```\\nharness.html?game=game.html&auto=1&players=1\\nharness.html?game=game.html&auto=1&players=2\\nharness.html?game=game.html&auto=1&players=4&latency=150&jitter=50&loss=5\\nharness.html?game=game.html&auto=1&players=4&latency=150&jitter=50&loss=5&scenario=host-leave\\n```\\n\\nwait for `document.body.dataset.complete === 'true'`, then require `window.__hubCheck.pass`; print failed checks' `name` and `detail`. Each took 10-13 s with a light scene. Keep the card scene light so `ready()` lands inside the 20 s limit even with 4 software-rendered copies. Confirm the served page is yours (its title) before trusting a result. Then open the game outside a session and check it still runs.\\n\\n### Headless facts ✔\\n870→\\n- 600 frames with mixers takes about 80 ms, and boot about 240 ms, so full playthroughs are cheap.\\n- `Engine.headless(game, { camera })`: built-ins load with no asset reader.\\n- `recording()` and `replay()` reproduce the fingerprint across `loadGame`.\\n- `input.setPointer(x, y, true)` drives the mouse.\\n- `ctx.audio` counts plays with no context.\\n\\n---\\n\\n## 18. Testing\\n880→\\n**One command: `node tools/test.mjs`** prints only failures and one count line (`212/212 passed`). `--fast` runs the Node tests only. Rerun only after changing what a test covers. Prefer scripts to screenshots. Don't use subagents or workflows to review, judge or audit. Keep at most two browsers open.\\n\\n**Headless (Node), seconds:**\\n\\n1. **Dot:** idle bot < 20% at ring .30; average 35-65%; good > 80%; expert > 95%.\\n2. **Clips:** `validateClip` empty and `analyzeClip(...).problems` empty for every clip you wrote.\\n3. **Data:** every model (`checkModel`) and texture (`validateTexture`) clean; all ids resolve; `parseSong` on every song; each song passes the level check in §15; every line fits its box; every character of every string has a glyph.\\n4. **Every activity:** idle bot finishes with 0★ and no error; expert bot ≥ 2★ (≥ 3★ on easy ones); sloppy < expert; result written; Drips correct.\\n5. **Full scripted playthrough:** drive the real menus with `setKey` from a fresh save, bots inside activities: new week → all 7 days → every station → goals → unlock schedule → Jar milestones → Long Stand → confession subtracts exactly 7 → credits → Week 2. Assert the state at each step.\\n890→6. **Save:** reload mid-week restores; corrupt JSON falls back safely; no storage works.\\n7. **Pause:** `timeScale` 0, `fixedUpdate` frozen, menu navigable, resume exact.\\n8. **Dev:** every slider changes live behaviour; reset restores defaults; every tool works.\\n9. **Attract:** 10 s idle on title and on a menu starts it; no trigger during play; a full loop runs error-free over all items; any input exits.\\n10. **Determinism:** record an activity, replay it, fingerprints equal.\\n11. **Medley:** 4 bot lanes, scores in range, windows respected; a ghost lane never simulates.\\n12. **Voice:** `syllabify` is stable, the same word gives the same syllables, a question rises.\\n13. **Engine untouched:** `pixel-engine.js` hash equals the kit's.\\n\\n**Browser, on the built html via `file://`:**\\n900→\\n14. Boots on WebGPU with no errors; title visible; **music volume is exactly 0.10** on first run.\\n15. Pad stub: ✕ confirms; prompts show PlayStation glyphs; the Settings option gives Xbox; a key press switches to keycaps; mouse move switches to mouse prompts; hover moves focus; click activates. Record each prompt state in `App.state()` so no picture is needed.\\n16. Phone profile with touch: message showing, ⚙ present, `engine.touch` null, attract runs.\\n17. Family Hour with 2 stub pads plus keyboard: three lanes move independently.\\n18. Audio after a real click: an `AnalyserNode` on the destination reads non-silent for SFX and music; voice in `OfflineAudioContext` has RMS > .02, and Ounce's mean pitch exceeds Coach's.\\n19. No layout overflow at 1920×1080, 1280×720 and 640×360: widgets record their rects, and the test asserts all fit.\\n20. WebKit (iPhone profile) and Firefox have no `navigator.gpu` on this machine ✔, so they can only test failure: the engine's \\\"Failed to start: WebGPU unavailable\\\" message shows ✔ and no page error is thrown. Test the touch-only screen itself in Chromium's phone profile, as in test 16.\\n\\n**Hub:**\\n910→\\n21. The four harness runs from section 17, all `pass`. Each harness frame is a separate copy of the game, which covers the brief's \\\"no second player\\\" note.\\n22. Outside a session: normal boot with `AIHub.active` false.\\n\\n---\\n\\n## 19. Build order\\n\\nFinish each step with its tests green. Keep the game runnable and the deliverable building from step 1 on.\\n\\n920→1. **Skeleton.** Kit and hub files, build script, test runner, boot scene on `file://`, harness passing with a stub round. Takes minutes, because the recipes above are proven.\\n2. **The Dot and the kit.** Dot, drivers, actions, device, tunables; font, menu, dialogue, prompts, glyphs; App, scene switching, save; Settings; pause; dev sliders.\\n3. **One activity, fully.** Holding Still end to end with avatars, Coach, results, voice and music. **Stop and judge the feel here**, since this is the whole game in miniature: check the bot table, then capture a run as frames and confirm the body language reads the Dot.\\n4. **The island and the week.** Hub, Weigh-In, stations, Report, Jar, schedule, saves. Scripted playthrough started.\\n5. **Other activities**, in this order: Hoop, Reps, Header, Step, Slackline, Tray, Pier Jump, Jog.\\n6. **The Medley.** Lanes, Family Hour, session card, ghosts. Harness at full spec.\\n7. **Attract, Dev tools tab, touch-only, Locker Room, Hall of Numbers.**\\n8. **The story and the finish.** Ferry, daily beats, Long Stand, confession, ending; line bank to 120+; all songs; every model and particle.\\n9. **Wrap-up.** About & Credits, exit interview, final tests, one look at each screen at 1920×1080.\\n\\n930→**If you must cut scope,** remove whole activities from the data, in this order: Pier Jump, Vitamin Tray, Island Jog, Overhead Mortgage. Nothing half-built ships, and nothing may look stubbed. **Never cut:** the Dot, Holding Still, Reps, Hoop, Header, Step, Weigh-In, the island, the week, the Long Stand, the Medley, attract, dev mode, Settings, About.\\n\\n---\\n\\n## 20. Finishing\\n\\n**No TODOs, placeholders, stubs or dead menu items.** Every screen works with pad, keyboard and mouse.\\n\\n### About & Credits (paged, not dense; L1/R1 or arrows or click)\\n\\n940→Credits; \\\"This is not medical advice. Ounce is a scale.\\\"; **Source Information** (every field your brief lists; `unknown` for anything you can't confirm; Usage: `added on import`); **Testing Feedback**; **Engine Feedback**; **Prompt Feedback**; the kit's `CREDITS.md`, shipped as the kit asks: a summary page, then the full text in a scrollable view.\\n\\n**Keep one source of truth:** `src/data/about.js` feeds the screen, and `tools/build.mjs` writes the exit-interview file from it, then re-parses it to confirm it is valid JSON. Answer the feedback questions honestly, from your real run, not from this plan.\\n\\nFor Source Information: Source is Wii Fit; Genre and Perspective as in section 1; Tech: Pixel Engine with its version, three.js r186 and Rapier as bundled in it, esbuild for packaging; Art: the engine's native pixel look; Animation: engine `ClipDef`s with `AnimationMixer`; Audio: engine `Song` and `SoundDef` data plus a Web Audio formant voice; Online: AI Hub Session Protocol v1, ghost mode, own card, 1-4 players; Family Hour is local. For Research, describe what you did yourself, and note that the director's plan included engine and hub research and spikes.\\n\\n### Exit-interview `aiHub` block\\n\\nUse the exact shape in your brief. Suggested values:\\n\\n950→- `name`: {TITLE}; `tagline`: yours.\\n- `type`: `Game`; `genre`: `Sports`; `source`: `Wii Fit`; `series`: `Wii Fit`; `players`: `1–4`.\\n- `controls`: `Left stick, WASD or mouse: lean. R2, Space or click: breathe. L1/R1, F/J or mouse buttons: step.`\\n- `tags`: `[\\\"pixel art\\\", \\\"comedy\\\", \\\"versus\\\", \\\"arcade\\\", \\\"3d\\\", \\\"story\\\"]`.\\n\\n### Your final chat reply\\n\\nIt must contain Source Information, Testing Feedback, Engine Feedback and Prompt Feedback, as your brief says.\\n\\n---\\n960→\\n## 21. Brief coverage checklist\\n\\nTick each before you stop.\\n\\n| Brief item | Where |\\n|---|---|\\n| Genre and perspective chosen | §1, §5, §7 |\\n| Title: riff on the source's name, picked as the brief says, by you | top of plan, §16 |\\n| Research: your choice; the director's is here | §4, §17, §20 |\\n970→| Single html named as the brief says, in root | §17 |\\n| Built on the kit; engine unchanged; own systems on top | §16, §17, §18 test 13 |\\n| Art: engine's look as the base, new assets for the source's feel, library for generic props | §13 |\\n| Animation: engine's system as the base, new animations | §14 |\\n| Audio: all in code, gibberish voices, music 10% by default | §15, §18 test 14 |\\n| Online and multiplayer: hub, and on its own | §12 |\\n| Dev subfolder, ports, processes, sharing the machine, `file://` first | top of plan, §17, §18 |\\n| Performance unlimited, no optimisation | §13 |\\n| Effort is yours to spend; an order and a cut list if you need them | §19 |\\n| Machine notes: stand-ins for controller, touch, sound, second player, iPhone, TV | §17, §18 |\\n980→| Headless tests, scripted playthrough, one command, failures and count only, screenshots only where needed, no review subagents | §18 |\",\"content_concise\":\"761→## 16. Architecture\\n\\nDownload the kit (the URL is in your brief) and copy the contents of the zip's top-level `pixel-engine/` folder into the dev folder, so `pixel-engine.js`, `check.mjs` and the guides sit at its root. **Never edit `pixel-engine.js`**: record its sha256 in `vendor/pixel-engine.sha256` when you unzip, and a test compares it. Fetch the hub's `session.js`, `harness.html`, `bridge.js`, `round.js` and `README.md` into `vendor/hub/` from `https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/`.\\n\\n```\\npixel-engine.js  check.mjs  GUIDE.md ...        the kit, untouched\\nvendor/hub/                                     hub client and harness, untouched\\nsrc/main.js                                     boot: session check, Engine.start, first scene\\nsrc/app.js                                      App: scene switching, save, settings, tunables, device, debug API\\n770→src/core/      dot.js drivers.js actions.js device.js tunables.js save.js net.js clock.js\\nsrc/ui/        font.js menu.js dialogue.js widgets.js prompts.js screens/*\\nsrc/audio/     voice.js songs.js sfx.js\\nsrc/art/       avatar.js models.js textures.js clips.js glyphs.js portraits.js\\nsrc/data/      title.js activities.js poses.js reps.js charts.js boards.js week.js lines.js\\n               questions.js unlocks.js classmates.js stations.js medley.js about.js\\nsrc/scenes/    base.js boot.js title.js attract.js hub.js weighin.js report.js locker.js records.js jar.js\\n               card.js medley.js join.js ending.js  activity/{base,poses,reps,hoop,step,header,slackline,tray,jog,pier,longstand}.js\\ntools/         build.mjs test.mjs clip-sheet.mjs shot.mjs\\ntests/         headless/*.mjs  browser/*.mjs\\n780→```\\n\\n**Everything a designer would change is plain data in `src/data/`:** poses, exercises, charts, boards, schedules, lines, unlocks, stars. A new pose, chart, board or day needs no code. That is what lets the rest of the game be built out later with normal tools, together with the live sliders and their JSON export.\\n\\n**Engine patterns:**\\n- Start ✔: `Engine.start(new Boot(), withUrlOptions({ container: document.getElementById('app'), aspect: 'fill', touch: false, settings: { button: touchOnly ? 'top-right' : false }, quality: info ? 'medium' : 'high', seed, background: PALETTE.sky, camera }))`.\\n- Each scene is a `Game`, swapped with `engine.loadGame(scene, { camera })`. It frees everything per level; keep persistent state in `App`. Transition: `await screen.cover('iris')`, `await loadGame`, `await screen.reveal('iris')`.\\n- `BaseScene` owns the frame order: `update` → `App.device.update` → overlays (pause, dialogue, dev) take input first → the scene's own update → `hud.clear()` → scene draw → overlays draw. Gameplay goes in `fixedUpdate`, skipped automatically while `timeScale` is 0.\\n- **Rules from the guide that matter here:** gameplay in `fixedUpdate` with `consumePress`; `wasPressed` only in `update`; all randomness from `ctx.random` forks (never `Math.random`); time from `ctx.time` (never `performance.now`); no `new PointLight`. Modules guard `document`, `window`, `navigator` and `localStorage`, so **everything runs in Node** ✔.\\n- **Drivers** (`src/core/drivers.js`): `read(out)` fills `{ x, y, breath, stepL, stepR, confirm }`. `LocalDriver` (engine input and mouse), `PadDriver(index)` (Family Hour), `BotDriver(skill)`, `GhostDriver` (display only). Attract, tests, classmates and online all reuse this one seam.\\n790→- **Debug API**, kept in the shipped game (`globalThis.__GAME__ = App`): `go(id, args)`, `state()` as JSON, `setDriver(skill)`, `tunables`. Give every scene a real `status()` line (`activity hoop | play | t 31.2 | score 412`) and a `fingerprint()` (score, Dot state).\\n\\n---\\n\\n## 17. Verified recipes\\n\\n### Single-file build ✔ (boots on `file://` in about 1.3 s; passes `check.mjs` and the harness)\\n\\n```js\\n// tools/build.mjs (esbuild is on this machine)\\n800→execFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--platform=browser', '--target=esnext', '--charset=utf8', '--outfile=.build/bundle.js', '--log-level=warning'], { stdio: 'inherit' });\\nconst safe = (s) => s.replace(/<\\\\/script/gi, '<\\\\\\\\/script').replace(/<!--/g, '<\\\\\\\\!--');\\nconst html = `<!doctype html>\\n<html lang=\\\"en\\\"><head>\\n<meta charset=\\\"utf-8\\\">\\n<script>${readFileSync('vendor/hub/session.js', 'utf8')}</script>\\n${HUB_METAS}\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\\\">\\n<link rel=\\\"icon\\\" href=\\\"data:,\\\"><title>${TITLE}</title>\\n<style>html, body { margin: 0; height: 100%; background: #0d0b14; } #app { position: fixed; inset: 0; }</style>\\n810→</head><body><div id=\\\"app\\\"></div>\\n<script type=\\\"module\\\">${safe(readFileSync('.build/bundle.js', 'utf8'))}</script>\\n</body></html>`;\\nwriteFileSync(OUTPUT_HTML, html);   // OUTPUT_HTML: the deliverable name your brief gives, in root\\n```\\n\\nThe session client goes in **unmodified**: the hub replaces an unmodified copy with each new version. Nothing is fetched at runtime, so the game needs no CDN. Bundling doesn't count as editing the engine; `pixel-engine.js` itself stays byte-identical. Output is about 5.4 MB.\\n\\n### Browser flags ✔\\n\\n820→**Use all five.** With only the three in the machine notes, `renderer.capture()` failed: `mapAsync ... A valid external Instance reference no longer exists`.\\n\\n```\\n--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-angle=swiftshader --use-webgpu-adapter=swiftshader\\n```\\n\\n### Node Playwright and the kit's check ✔\\n\\n`npm install playwright@1.63.0` in the dev folder. Then `node check.mjs <page> --keys KeyD*30` works on the built html if it's copied into the dev folder.\\n\\n830→### Screenshots ✔\\n\\nThe live loop rejects `capture()`, and a WebGPU canvas may screenshot blank. So step first, and composite the HUD:\\n\\n```js\\nconst e = window.__PIXEL_ENGINE__; e.step(30);          // switches to manual time\\nconst f = await e.renderer.capture();                   // { width, height, pixels }\\nconst c = document.createElement('canvas'); c.width = f.width; c.height = f.height;\\nconst g = c.getContext('2d'); g.putImageData(new ImageData(new Uint8ClampedArray(f.pixels), f.width, f.height), 0, 0);\\ng.imageSmoothingEnabled = false; if (e.hud.canvas?.width) g.drawImage(e.hud.canvas, 0, 0, f.width, f.height);\\n840→return c.toDataURL('image/png');\\n```\\n\\nPut this in `tools/shot.mjs <scene> [--size 1920x1080]`. Use it only for what a script can't judge: composition and legibility. Judge the 10-foot view at 1920×1080.\\n\\n### Gamepad stub ✔\\n\\nAdd as an init script; change the state from the test:\\n\\n```js\\n850→window.__pad = { buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })), axes: [0, 0, 0, 0] };\\nnavigator.getGamepads = () => [{ id: 'Stub', index: 0, connected: true, mapping: 'standard', timestamp: performance.now(), axes: __pad.axes, buttons: __pad.buttons }, null, null, null];\\n```\\n\\nRead inputs through a frame: `moveAxis()` gave (0.8, 0.6) for axes (0.8, -0.6) in-game. Headless, `e.input.setKey('PadCross', true)` works without any stub ✔.\\n\\n### Hub harness ✔\\n\\nCopy the built html (as `game.html`) with `harness.html`, `bridge.js` and `round.js` into a temp folder inside the dev folder. Serve it with `python3 -u -m http.server 0 --bind 127.0.0.1` ✔, reading the port from its first output line and stopping it by its PID. An in-process `node:http` server on `127.0.0.1` and port 0 also works, but it must send `Content-Type: text/javascript` for `.js`, or the harness's module imports fail. Then for each of:\\n\\n860→```\\nharness.html?game=game.html&auto=1&players=1\\nharness.html?game=game.html&auto=1&players=2\\nharness.html?game=game.html&auto=1&players=4&latency=150&jitter=50&loss=5\\nharness.html?game=game.html&auto=1&players=4&latency=150&jitter=50&loss=5&scenario=host-leave\\n```\\n\\nwait for `document.body.dataset.complete === 'true'`, then require `window.__hubCheck.pass`; print failed checks' `name` and `detail`. Each took 10-13 s with a light scene. Keep the card scene light so `ready()` lands inside the 20 s limit even with 4 software-rendered copies. Confirm the served page is yours (its title) before trusting a result. Then open the game outside a session and check it still runs.\\n\\n### Headless facts ✔\\n870→\\n- 600 frames with mixers takes about 80 ms, and boot about 240 ms, so full playthroughs are cheap.\\n- `Engine.headless(game, { camera })`: built-ins load with no asset reader.\\n- `recording()` and `replay()` reproduce the fingerprint across `loadGame`.\\n- `input.setPointer(x, y, true)` drives the mouse.\\n- `ctx.audio` counts plays with no context.\\n\\n---\\n\\n## 18. Testing\\n880→\\n**One command: `node tools/test.mjs`** prints only failures and one count line (`212/212 passed`). `--fast` runs the Node tests only. Rerun only after changing what a test covers. Prefer scripts to screenshots. Don't use subagents or workflows to review, judge or audit. Keep at most two browsers open.\\n\\n**Headless (Node), seconds:**\\n\\n1. **Dot:** idle bot < 20% at ring .30; average 35-65%; good > 80%; expert > 95%.\\n2. **Clips:** `validateClip` empty and `analyzeClip(...).problems` empty for every clip you wrote.\\n3. **Data:** every model (`checkModel`) and texture (`validateTexture`) clean; all ids resolve; `parseSong` on every song; each song passes the level check in §15; every line fits its box; every character of every string has a glyph.\\n4. **Every activity:** idle bot finishes with 0★ and no error; expert bot ≥ 2★ (≥ 3★ on easy ones); sloppy < expert; result written; Drips correct.\\n5. **Full scripted playthrough:** drive the real menus with `setKey` from a fresh save, bots inside activities: new week → all 7 days → every station → goals → unlock schedule → Jar milestones → Long Stand → confession subtracts exactly 7 → credits → Week 2. Assert the state at each step.\\n890→6. **Save:** reload mid-week restores; corrupt JSON falls back safely; no storage works.\\n7. **Pause:** `timeScale` 0, `fixedUpdate` frozen, menu navigable, resume exact.\\n8. **Dev:** every slider changes live behaviour; reset restores defaults; every tool works.\\n9. **Attract:** 10 s idle on title and on a menu starts it; no trigger during play; a full loop runs error-free over all items; any input exits.\\n10. **Determinism:** record an activity, replay it, fingerprints equal.\\n11. **Medley:** 4 bot lanes, scores in range, windows respected; a ghost lane never simulates.\\n12. **Voice:** `syllabify` is stable, the same word gives the same syllables, a question rises.\\n13. **Engine untouched:** `pixel-engine.js` hash equals the kit's.\\n\\n**Browser, on the built html via `file://`:**\\n900→\\n14. Boots on WebGPU with no errors; title visible; **music volume is exactly 0.10** on first run.\\n15. Pad stub: ✕ confirms; prompts show PlayStation glyphs; the Settings option gives Xbox; a key press switches to keycaps; mouse move switches to mouse prompts; hover moves focus; click activates. Record each prompt state in `App.state()` so no picture is needed.\\n16. Phone profile with touch: message showing, ⚙ present, `engine.touch` null, attract runs.\\n17. Family Hour with 2 stub pads plus keyboard: three lanes move independently.\\n18. Audio after a real click: an `AnalyserNode` on the destination reads non-silent for SFX and music; voice in `OfflineAudioContext` has RMS > .02, and Ounce's mean pitch exceeds Coach's.\\n19. No layout overflow at 1920×1080, 1280×720 and 640×360: widgets record their rects, and the test asserts all fit.\\n20. WebKit (iPhone profile) and Firefox have no `navigator.gpu` on this machine ✔, so they can only test failure: the engine's \\\"Failed to start: WebGPU unavailable\\\" message shows ✔ and no page error is thrown. Test the touch-only screen itself in Chromium's phone profile, as in test 16.\\n\\n**Hub:**\\n910→\\n21. The four harness runs from section 17, all `pass`. Each harness frame is a separate copy of the game, which covers the brief's \\\"no second player\\\" note.\\n22. Outside a session: normal boot with `AIHub.active` false.\\n\\n---\\n\\n## 19. Build order\\n\\nFinish each step with its tests green. Keep the game runnable and the deliverable building from step 1 on.\\n\\n920→1. **Skeleton.** Kit and hub files, build script, test runner, boot scene on `file://`, harness passing with a stub round. Takes minutes, because the recipes above are proven.\\n2. **The Dot and the kit.** Dot, drivers, actions, device, tunables; font, menu, dialogue, prompts, glyphs; App, scene switching, save; Settings; pause; dev sliders.\\n3. **One activity, fully.** Holding Still end to end with avatars, Coach, results, voice and music. **Stop and judge the feel here**, since this is the whole game in miniature: check the bot table, then capture a run as frames and confirm the body language reads the Dot.\\n4. **The island and the week.** Hub, Weigh-In, stations, Report, Jar, schedule, saves. Scripted playthrough started.\\n5. **Other activities**, in this order: Hoop, Reps, Header, Step, Slackline, Tray, Pier Jump, Jog.\\n6. **The Medley.** Lanes, Family Hour, session card, ghosts. Harness at full spec.\\n7. **Attract, Dev tools tab, touch-only, Locker Room, Hall of Numbers.**\\n8. **The story and the finish.** Ferry, daily beats, Long Stand, confession, ending; line bank to 120+; all songs; every model and particle.\\n9. **Wrap-up.** About & Credits, exit interview, final tests, one look at each screen at 1920×1080.\\n\\n930→**If you must cut scope,** remove whole activities from the data, in this order: Pier Jump, Vitamin Tray, Island Jog, Overhead Mortgage. Nothing half-built ships, and nothing may look stubbed. **Never cut:** the Dot, Holding Still, Reps, Hoop, Header, Step, Weigh-In, the island, the week, the Long Stand, the Medley, attract, dev mode, Settings, About.\\n\\n---\\n\\n## 20. Finishing\\n\\n**No TODOs, placeholders, stubs or dead menu items.** Every screen works with pad, keyboard and mouse.\\n\\n### About & Credits (paged, not dense; L1/R1 or arrows or click)\\n\\n940→Credits; \\\"This is not medical advice. Ounce is a scale.\\\"; **Source Information** (every field your brief lists; `unknown` for anything you can't confirm; Usage: `added on import`); **Testing Feedback**; **Engine Feedback**; **Prompt Feedback**; the kit's `CREDITS.md`, shipped as the kit asks: a summary page, then the full text in a scrollable view.\\n\\n**Keep one source of truth:** `src/data/about.js` feeds the screen, and `tools/build.mjs` writes the exit-interview file from it, then re-parses it to confirm it is valid JSON. Answer the feedback questions honestly, from your real run, not from this plan.\\n\\nFor Source Information: Source is Wii Fit; Genre and Perspective as in section 1; Tech: Pixel Engine with its version, three.js r186 and Rapier as bundled in it, esbuild for packaging; Art: the engine's native pixel look; Animation: engine `ClipDef`s with `AnimationMixer`; Audio: engine `Song` and `SoundDef` data plus a Web Audio formant voice; Online: AI Hub Session Protocol v1, ghost mode, own card, 1-4 players; Family Hour is local. For Research, describe what you did yourself, and note that the director's plan included engine and hub research and spikes.\\n\\n### Exit-interview `aiHub` block\\n\\nUse the exact shape in your brief. Suggested values:\\n\\n950→- `name`: {TITLE}; `tagline`: yours.\\n- `type`: `Game`; `genre`: `Sports`; `source`: `Wii Fit`; `series`: `Wii Fit`; `players`: `1–4`.\\n- `controls`: `Left stick, WASD or mouse: lean. R2, Space or click: breathe. L1/R1, F/J or mouse buttons: step.`\\n- `tags`: `[\\\"pixel art\\\", \\\"comedy\\\", \\\"versus\\\", \\\"arcade\\\", \\\"3d\\\", \\\"story\\\"]`.\\n\\n### Your final chat reply\\n\\nIt must contain Source Information, Testing Feedback, Engine Feedback and Prompt Feedback, as your brief says.\\n\\n---\\n960→\\n## 21. Brief coverage checklist\\n\\nTick each before you stop.\\n\\n| Brief item | Where |\\n|---|---|\\n| Genre and perspective chosen | §1, §5, §7 |\\n| Title: riff on the source's name, picked as the brief says, by you | top of plan, §16 |\\n| Research: your choice; the director's is here | §4, §17, §20 |\\n970→| Single html named as the brief says, in root | §17 |\\n| Built on the kit; engine unchanged; own systems on top | §16, §17, §18 test 13 |\\n| Art: engine's look as the base, new assets for the source's feel, library for generic props | §13 |\\n| Animation: engine's system as the base, new animations | §14 |\\n| Audio: all in code, gibberish voices, music 10% by default | §15, §18 test 14 |\\n| Online and multiplayer: hub, and on its own | §12 |\\n| Dev subfolder, ports, processes, sharing the machine, `file://` first | top of plan, §17, §18 |\\n| Performance unlimited, no optimisation | §13 |\\n| Effort is yours to spend; an order and a cut list if you need them | §19 |\\n| Machine notes: stand-ins for controller, touch, sound, second player, iPhone, TV | §17, §18 |\\n980→| Headless tests, scripted playthrough, one command, failures and count only, screenshots only where needed, no review subagents | §18 |\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/PLAN.md\",\"offset\":761,\"limit\":220,\"raw_output\":\"## 16. Architecture\\n\\nDownload the kit (the URL is in your brief) and copy the contents of the zip's top-level `pixel-engine/` folder into the dev folder, so `pixel-engine.js`, `check.mjs` and the guides sit at its root. **Never edit `pixel-engine.js`**: record its sha256 in `vendor/pixel-engine.sha256` when you unzip, and a test compares it. Fetch the hub's `session.js`, `harness.html`, `bridge.js`, `round.js` and `README.md` into `vendor/hub/` from `https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/`.\\n\\n```\\npixel-engine.js  check.mjs  GUIDE.md ...        the kit, untouched\\nvendor/hub/                                     hub client and harness, untouched\\nsrc/main.js                                     boot: session check, Engine.start, first scene\\nsrc/app.js                                      App: scene switching, save, settings, tunables, device, debug API\\nsrc/core/      dot.js drivers.js actions.js device.js tunables.js save.js net.js clock.js\\nsrc/ui/        font.js menu.js dialogue.js widgets.js prompts.js screens/*\\nsrc/audio/     voice.js songs.js sfx.js\\nsrc/art/       avatar.js models.js textures.js clips.js glyphs.js portraits.js\\nsrc/data/      title.js activities.js poses.js reps.js charts.js boards.js week.js lines.js\\n               questions.js unlocks.js classmates.js stations.js medley.js about.js\\nsrc/scenes/    base.js boot.js title.js attract.js hub.js weighin.js report.js locker.js records.js jar.js\\n               card.js medley.js join.js ending.js  activity/{base,poses,reps,hoop,step,header,slackline,tray,jog,pier,longstand}.js\\ntools/         build.mjs test.mjs clip-sheet.mjs shot.mjs\\ntests/         headless/*.mjs  browser/*.mjs\\n```\\n\\n**Everything a designer would change is plain data in `src/data/`:** poses, exercises, charts, boards, schedules, lines, unlocks, stars. A new pose, chart, board or day needs no code. That is what lets the rest of the game be built out later with normal tools, together with the live sliders and their JSON export.\\n\\n**Engine patterns:**\\n- Start ✔: `Engine.start(new Boot(), withUrlOptions({ container: document.getElementById('app'), aspect: 'fill', touch: false, settings: { button: touchOnly ? 'top-right' : false }, quality: info ? 'medium' : 'high', seed, background: PALETTE.sky, camera }))`.\\n- Each scene is a `Game`, swapped with `engine.loadGame(scene, { camera })`. It frees everything per level; keep persistent state in `App`. Transition: `await screen.cover('iris')`, `await loadGame`, `await screen.reveal('iris')`.\\n- `BaseScene` owns the frame order: `update` → `App.device.update` → overlays (pause, dialogue, dev) take input first → the scene's own update → `hud.clear()` → scene draw → overlays draw. Gameplay goes in `fixedUpdate`, skipped automatically while `timeScale` is 0.\\n- **Rules from the guide that matter here:** gameplay in `fixedUpdate` with `consumePress`; `wasPressed` only in `update`; all randomness from `ctx.random` forks (never `Math.random`); time from `ctx.time` (never `performance.now`); no `new PointLight`. Modules guard `document`, `window`, `navigator` and `localStorage`, so **everything runs in Node** ✔.\\n- **Drivers** (`src/core/drivers.js`): `read(out)` fills `{ x, y, breath, stepL, stepR, confirm }`. `LocalDriver` (engine input and mouse), `PadDriver(index)` (Family Hour), `BotDriver(skill)`, `GhostDriver` (display only). Attract, tests, classmates and online all reuse this one seam.\\n- **Debug API**, kept in the shipped game (`globalThis.__GAME__ = App`): `go(id, args)`, `state()` as JSON, `setDriver(skill)`, `tunables`. Give every scene a real `status()` line (`activity hoop | play | t 31.2 | score 412`) and a `fingerprint()` (score, Dot state).\\n\\n---\\n\\n## 17. Verified recipes\\n\\n### Single-file build ✔ (boots on `file://` in about 1.3 s; passes `check.mjs` and the harness)\\n\\n```js\\n// tools/build.mjs (esbuild is on this machine)\\nexecFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--platform=browser', '--target=esnext', '--charset=utf8', '--outfile=.build/bundle.js', '--log-level=warning'], { stdio: 'inherit' });\\nconst safe = (s) => s.replace(/<\\\\/script/gi, '<\\\\\\\\/script').replace(/<!--/g, '<\\\\\\\\!--');\\nconst html = `<!doctype html>\\n<html lang=\\\"en\\\"><head>\\n<meta charset=\\\"utf-8\\\">\\n<script>${readFileSync('vendor/hub/session.js', 'utf8')}</script>\\n${HUB_METAS}\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\\\">\\n<link rel=\\\"icon\\\" href=\\\"data:,\\\"><title>${TITLE}</title>\\n<style>html, body { margin: 0; height: 100%; background: #0d0b14; } #app { position: fixed; inset: 0; }</style>\\n</head><body><div id=\\\"app\\\"></div>\\n<script type=\\\"module\\\">${safe(readFileSync('.build/bundle.js', 'utf8'))}</script>\\n</body></html>`;\\nwriteFileSync(OUTPUT_HTML, html);   // OUTPUT_HTML: the deliverable name your brief gives, in root\\n```\\n\\nThe session client goes in **unmodified**: the hub replaces an unmodified copy with each new version. Nothing is fetched at runtime, so the game needs no CDN. Bundling doesn't count as editing the engine; `pixel-engine.js` itself stays byte-identical. Output is about 5.4 MB.\\n\\n### Browser flags ✔\\n\\n**Use all five.** With only the three in the machine notes, `renderer.capture()` failed: `mapAsync ... A valid external Instance reference no longer exists`.\\n\\n```\\n--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-angle=swiftshader --use-webgpu-adapter=swiftshader\\n```\\n\\n### Node Playwright and the kit's check ✔\\n\\n`npm install playwright@1.63.0` in the dev folder. Then `node check.mjs <page> --keys KeyD*30` works on the built html if it's copied into the dev folder.\\n\\n### Screenshots ✔\\n\\nThe live loop rejects `capture()`, and a WebGPU canvas may screenshot blank. So step first, and composite the HUD:\\n\\n```js\\nconst e = window.__PIXEL_ENGINE__; e.step(30);          // switches to manual time\\nconst f = await e.renderer.capture();                   // { width, height, pixels }\\nconst c = document.createElement('canvas'); c.width = f.width; c.height = f.height;\\nconst g = c.getContext('2d'); g.putImageData(new ImageData(new Uint8ClampedArray(f.pixels), f.width, f.height), 0, 0);\\ng.imageSmoothingEnabled = false; if (e.hud.canvas?.width) g.drawImage(e.hud.canvas, 0, 0, f.width, f.height);\\nreturn c.toDataURL('image/png');\\n```\\n\\nPut this in `tools/shot.mjs <scene> [--size 1920x1080]`. Use it only for what a script can't judge: composition and legibility. Judge the 10-foot view at 1920×1080.\\n\\n### Gamepad stub ✔\\n\\nAdd as an init script; change the state from the test:\\n\\n```js\\nwindow.__pad = { buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })), axes: [0, 0, 0, 0] };\\nnavigator.getGamepads = () => [{ id: 'Stub', index: 0, connected: true, mapping: 'standard', timestamp: performance.now(), axes: __pad.axes, buttons: __pad.buttons }, null, null, null];\\n```\\n\\nRead inputs through a frame: `moveAxis()` gave (0.8, 0.6) for axes (0.8, -0.6) in-game. Headless, `e.input.setKey('PadCross', true)` works without any stub ✔.\\n\\n### Hub harness ✔\\n\\nCopy the built html (as `game.html`) with `harness.html`, `bridge.js` and `round.js` into a temp folder inside the dev folder. Serve it with `python3 -u -m http.server 0 --bind 127.0.0.1` ✔, reading the port from its first output line and stopping it by its PID. An in-process `node:http` server on `127.0.0.1` and port 0 also works, but it must send `Content-Type: text/javascript` for `.js`, or the harness's module imports fail. Then for each of:\\n\\n```\\nharness.html?game=game.html&auto=1&players=1\\nharness.html?game=game.html&auto=1&players=2\\nharness.html?game=game.html&auto=1&players=4&latency=150&jitter=50&loss=5\\nharness.html?game=game.html&auto=1&players=4&latency=150&jitter=50&loss=5&scenario=host-leave\\n```\\n\\nwait for `document.body.dataset.complete === 'true'`, then require `window.__hubCheck.pass`; print failed checks' `name` and `detail`. Each took 10-13 s with a light scene. Keep the card scene light so `ready()` lands inside the 20 s limit even with 4 software-rendered copies. Confirm the served page is yours (its title) before trusting a result. Then open the game outside a session and check it still runs.\\n\\n### Headless facts ✔\\n\\n- 600 frames with mixers takes about 80 ms, and boot about 240 ms, so full playthroughs are cheap.\\n- `Engine.headless(game, { camera })`: built-ins load with no asset reader.\\n- `recording()` and `replay()` reproduce the fingerprint across `loadGame`.\\n- `input.setPointer(x, y, true)` drives the mouse.\\n- `ctx.audio` counts plays with no context.\\n\\n---\\n\\n## 18. Testing\\n\\n**One command: `node tools/test.mjs`** prints only failures and one count line (`212/212 passed`). `--fast` runs the Node tests only. Rerun only after changing what a test covers. Prefer scripts to screenshots. Don't use subagents or workflows to review, judge or audit. Keep at most two browsers open.\\n\\n**Headless (Node), seconds:**\\n\\n1. **Dot:** idle bot < 20% at ring .30; average 35-65%; good > 80%; expert > 95%.\\n2. **Clips:** `validateClip` empty and `analyzeClip(...).problems` empty for every clip you wrote.\\n3. **Data:** every model (`checkModel`) and texture (`validateTexture`) clean; all ids resolve; `parseSong` on every song; each song passes the level check in §15; every line fits its box; every character of every string has a glyph.\\n4. **Every activity:** idle bot finishes with 0★ and no error; expert bot ≥ 2★ (≥ 3★ on easy ones); sloppy < expert; result written; Drips correct.\\n5. **Full scripted playthrough:** drive the real menus with `setKey` from a fresh save, bots inside activities: new week → all 7 days → every station → goals → unlock schedule → Jar milestones → Long Stand → confession subtracts exactly 7 → credits → Week 2. Assert the state at each step.\\n6. **Save:** reload mid-week restores; corrupt JSON falls back safely; no storage works.\\n7. **Pause:** `timeScale` 0, `fixedUpdate` frozen, menu navigable, resume exact.\\n8. **Dev:** every slider changes live behaviour; reset restores defaults; every tool works.\\n9. **Attract:** 10 s idle on title and on a menu starts it; no trigger during play; a full loop runs error-free over all items; any input exits.\\n10. **Determinism:** record an activity, replay it, fingerprints equal.\\n11. **Medley:** 4 bot lanes, scores in range, windows respected; a ghost lane never simulates.\\n12. **Voice:** `syllabify` is stable, the same word gives the same syllables, a question rises.\\n13. **Engine untouched:** `pixel-engine.js` hash equals the kit's.\\n\\n**Browser, on the built html via `file://`:**\\n\\n14. Boots on WebGPU with no errors; title visible; **music volume is exactly 0.10** on first run.\\n15. Pad stub: ✕ confirms; prompts show PlayStation glyphs; the Settings option gives Xbox; a key press switches to keycaps; mouse move switches to mouse prompts; hover moves focus; click activates. Record each prompt state in `App.state()` so no picture is needed.\\n16. Phone profile with touch: message showing, ⚙ present, `engine.touch` null, attract runs.\\n17. Family Hour with 2 stub pads plus keyboard: three lanes move independently.\\n18. Audio after a real click: an `AnalyserNode` on the destination reads non-silent for SFX and music; voice in `OfflineAudioContext` has RMS > .02, and Ounce's mean pitch exceeds Coach's.\\n19. No layout overflow at 1920×1080, 1280×720 and 640×360: widgets record their rects, and the test asserts all fit.\\n20. WebKit (iPhone profile) and Firefox have no `navigator.gpu` on this machine ✔, so they can only test failure: the engine's \\\"Failed to start: WebGPU unavailable\\\" message shows ✔ and no page error is thrown. Test the touch-only screen itself in Chromium's phone profile, as in test 16.\\n\\n**Hub:**\\n\\n21. The four harness runs from section 17, all `pass`. Each harness frame is a separate copy of the game, which covers the brief's \\\"no second player\\\" note.\\n22. Outside a session: normal boot with `AIHub.active` false.\\n\\n---\\n\\n## 19. Build order\\n\\nFinish each step with its tests green. Keep the game runnable and the deliverable building from step 1 on.\\n\\n1. **Skeleton.** Kit and hub files, build script, test runner, boot scene on `file://`, harness passing with a stub round. Takes minutes, because the recipes above are proven.\\n2. **The Dot and the kit.** Dot, drivers, actions, device, tunables; font, menu, dialogue, prompts, glyphs; App, scene switching, save; Settings; pause; dev sliders.\\n3. **One activity, fully.** Holding Still end to end with avatars, Coach, results, voice and music. **Stop and judge the feel here**, since this is the whole game in miniature: check the bot table, then capture a run as frames and confirm the body language reads the Dot.\\n4. **The island and the week.** Hub, Weigh-In, stations, Report, Jar, schedule, saves. Scripted playthrough started.\\n5. **Other activities**, in this order: Hoop, Reps, Header, Step, Slackline, Tray, Pier Jump, Jog.\\n6. **The Medley.** Lanes, Family Hour, session card, ghosts. Harness at full spec.\\n7. **Attract, Dev tools tab, touch-only, Locker Room, Hall of Numbers.**\\n8. **The story and the finish.** Ferry, daily beats, Long Stand, confession, ending; line bank to 120+; all songs; every model and particle.\\n9. **Wrap-up.** About & Credits, exit interview, final tests, one look at each screen at 1920×1080.\\n\\n**If you must cut scope,** remove whole activities from the data, in this order: Pier Jump, Vitamin Tray, Island Jog, Overhead Mortgage. Nothing half-built ships, and nothing may look stubbed. **Never cut:** the Dot, Holding Still, Reps, Hoop, Header, Step, Weigh-In, the island, the week, the Long Stand, the Medley, attract, dev mode, Settings, About.\\n\\n---\\n\\n## 20. Finishing\\n\\n**No TODOs, placeholders, stubs or dead menu items.** Every screen works with pad, keyboard and mouse.\\n\\n### About & Credits (paged, not dense; L1/R1 or arrows or click)\\n\\nCredits; \\\"This is not medical advice. Ounce is a scale.\\\"; **Source Information** (every field your brief lists; `unknown` for anything you can't confirm; Usage: `added on import`); **Testing Feedback**; **Engine Feedback**; **Prompt Feedback**; the kit's `CREDITS.md`, shipped as the kit asks: a summary page, then the full text in a scrollable view.\\n\\n**Keep one source of truth:** `src/data/about.js` feeds the screen, and `tools/build.mjs` writes the exit-interview file from it, then re-parses it to confirm it is valid JSON. Answer the feedback questions honestly, from your real run, not from this plan.\\n\\nFor Source Information: Source is Wii Fit; Genre and Perspective as in section 1; Tech: Pixel Engine with its version, three.js r186 and Rapier as bundled in it, esbuild for packaging; Art: the engine's native pixel look; Animation: engine `ClipDef`s with `AnimationMixer`; Audio: engine `Song` and `SoundDef` data plus a Web Audio formant voice; Online: AI Hub Session Protocol v1, ghost mode, own card, 1-4 players; Family Hour is local. For Research, describe what you did yourself, and note that the director's plan included engine and hub research and spikes.\\n\\n### Exit-interview `aiHub` block\\n\\nUse the exact shape in your brief. Suggested values:\\n\\n- `name`: {TITLE}; `tagline`: yours.\\n- `type`: `Game`; `genre`: `Sports`; `source`: `Wii Fit`; `series`: `Wii Fit`; `players`: `1–4`.\\n- `controls`: `Left stick, WASD or mouse: lean. R2, Space or click: breathe. L1/R1, F/J or mouse buttons: step.`\\n- `tags`: `[\\\"pixel art\\\", \\\"comedy\\\", \\\"versus\\\", \\\"arcade\\\", \\\"3d\\\", \\\"story\\\"]`.\\n\\n### Your final chat reply\\n\\nIt must contain Source Information, Testing Feedback, Engine Feedback and Prompt Feedback, as your brief says.\\n\\n---\\n\\n## 21. Brief coverage checklist\\n\\nTick each before you stop.\\n\\n| Brief item | Where |\\n|---|---|\\n| Genre and perspective chosen | §1, §5, §7 |\\n| Title: riff on the source's name, picked as the brief says, by you | top of plan, §16 |\\n| Research: your choice; the director's is here | §4, §17, §20 |\\n| Single html named as the brief says, in root | §17 |\\n| Built on the kit; engine unchanged; own systems on top | §16, §17, §18 test 13 |\\n| Art: engine's look as the base, new assets for the source's feel, library for generic props | §13 |\\n| Animation: engine's system as the base, new animations | §14 |\\n| Audio: all in code, gibberish voices, music 10% by default | §15, §18 test 14 |\\n| Online and multiplayer: hub, and on its own | §12 |\\n| Dev subfolder, ports, processes, sharing the machine, `file://` first | top of plan, §17, §18 |\\n| Performance unlimited, no optimisation | §13 |\\n| Effort is yours to spend; an order and a cut list if you need them | §19 |\\n| Machine notes: stand-ins for controller, touch, sound, second player, iPhone, TV | §17, §18 |\\n| Headless tests, scripted playthrough, one command, failures and count only, screenshots only where needed, no review subagents | §18 |\\n\",\"total_lines\":992}}","is_error":false},{"type":"tool_result","tool_use_id":"call-d99c45f6-e148-4b1b-80e7-c4ff01d4753b-8","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→SOURCE: Wii Fit\\n\\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\\n\\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\\n\\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\\n\\nResearch: Whether and how much to research is your choice.\\n10→\\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-221607].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\\n\\nTech Stack: Build on https://github.com/michaelcrosato/riftlight/releases/latest/download/pixel-engine.zip, the riftlight engine kit. Keep the engine (pixel-engine.js) as it ships, as its guide says, and add whatever systems, art assets and animations the game needs on top of it. The rest of the tech stack is your choice.\\n\\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\\n\\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\\n\\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\\n20→\\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\\n\\nWorking Environment and deliverable:\\nCreate a subfolder called [GameTitle-SOURCE-grok-4.7-xhigh-20261104-221607] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-221607].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\\n\\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\\n\\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\\n\\n30→Effort: Spend effort however you see fit.\\n\\n## This computer\\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\\n\\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software-rendered, when started with --enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader), Firefox 155.0 (WebGL 2, software-rendered), WebKit 26.6 (WebGL 2) already downloaded. Phone and tablet device profiles are built in.\\n  WebGPU only works on a secure page: file:// or http://127.0.0.1. A WebGPU canvas can come out blank in a headless screenshot, so check the game's state instead.\\n40→  For Node, `npm install playwright@1.63.0` in your folder uses the browsers already downloaded; another version downloads its own.\\n  Playwright runs here with PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 (already set for runs): this OS isn't one it supports by name.\\n- **Tools:** node 24.22.1, npm 11.19.1, python3 3.14.8, pip3 26.2.1, git 2.56.0, gh 2.46.0, curl 8.22.0, wget 1.25.0, jq 1.8.1, ffmpeg 9.0.2, ffprobe 9.0.2, sqlite3 3.53.4, zip 3.0, unzip 6.00, rustc 1.99.0, cargo 1.99.0, go 1.27.1, java 27, lighthouse 13.5.0, shot-scraper 1.12, xvfb-run, magick 7.1.2, esbuild 0.28.2, uv 0.12.23, tsc 7.0.2, wasm-bindgen 0.2.129.\\n- **Rust:** rustup's toolchains 1.96.0, 1.98.1, stable; the wasm32-unknown-unknown target on 1.98.1.\\n- **Not installed:** sox, bun, deno.\\n- **Network:** internet works (github.com, registry.npmjs.org).\\n- **Memory:** earlyoom is on: when memory runs out it ends the biggest browser, so \\\"Target closed\\\", \\\"page crashed\\\" or \\\"browser has been closed\\\" means memory ran out, not a bug in your game. Run fewer browsers at once rather than retrying.\\n\\n### What this computer doesn't have\\n\\n50→No script can check these, so they're written by hand. Test with the stand-ins; anything that needs the real thing is checked as far as it can be here, never required.\\n\\n- **No physical controller.** Emulate one: replace navigator.getGamepads with a stub that returns a pad in the standard mapping (Playwright's add_init_script / addInitScript).\\n- **No touch device.** Use Playwright's phone and tablet profiles, which have touch, and tap with page.touchscreen.\\n- **Nobody to listen.** Check sound by what Web Audio produces: render it with an OfflineAudioContext, or read levels from an AnalyserNode.\\n- **No second player.** Play multiplayer with two browser pages (or contexts) on this computer.\\n- **No real iPhone or iPad.** WebKit with an iPhone profile is the closest; it isn't iOS Safari.\\n- **No TV.** Judge the 10-foot view from screenshots at 1920×1080.\\n\\n### Sharing this computer\\n60→\\n- Other agents run here at the same time. Keep one or two browsers open at once, and close them when you're done.\\n- Keep every file you make inside your own folder, not /tmp or a parent folder: /tmp is shared.\\n- The browsers are already downloaded: don't run `playwright install` or `playwright install-deps`.\\n- The system Python has Playwright and nothing else. For one (Pillow, numpy …), use uv: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` when the script drives a browser too (a newer Playwright can't find the browsers here).\\n\\n## Goal\\n\\nBuild an original game inspired by the source.\\n\\n70→Scope\\n\\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\\n\\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\\n\\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game.\\n\\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\\n\\n80→Narrative tone: Use a writing style similar to the source’s.\\n\\n## UI & UX: 10-Foot Controller-First Philosophy\\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\\n\\nDo not use overly dense, web-style data screens.\\n\\nTouch-only devices: no touch controls; show \\\"Controller or keyboard required\\\" and the settings button. Let the attract mode run.\\n\\n## Done\\n90→No TODOs, placeholders, or stubbed features. The demo is complete.\\n\\n## Source Information\\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \\\"unknown\\\" for anything you can't confirm.\\n- Date: 2026-11-04 22:16:07\\n- Source: the work it's based on\\n- Plan: the file name of the plan you were given to build from, or none\\n- Genre and Perspective: genre and camera perspective used\\n- Tech: stack, libraries/engines, with versions if applicable\\n- Art Direction: style used\\n100→- Animation: system used\\n- Audio: music, sound effects and voice used\\n- Online: network features used, or none\\n- Testing: testing parameters allowed\\n- Research: research done, or none\\n- Environment: Grok CLI (headless); Linux\\n- Model: xAI, grok-4.7, reasoning effort xhigh\\n- Usage: write \\\"added on import\\\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\\n\\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\\\"unknown\\\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\\n110→{\\n  \\\"sourceInformation\\\": {\\\"date\\\": \\\"\\\", \\\"source\\\": \\\"\\\", \\\"plan\\\": \\\"\\\", \\\"genre\\\": \\\"\\\", \\\"perspective\\\": \\\"\\\", \\\"tech\\\": \\\"\\\", \\\"artDirection\\\": \\\"\\\", \\\"animation\\\": \\\"\\\", \\\"audio\\\": \\\"\\\", \\\"online\\\": \\\"\\\", \\\"testing\\\": \\\"\\\", \\\"research\\\": \\\"\\\", \\\"environment\\\": \\\"\\\", \\\"model\\\": \\\"\\\", \\\"usage\\\": \\\"added on import\\\"},\\n  \\\"testingFeedback\\\": [\\\"your answer to each Testing Feedback question, in order\\\"],\\n  \\\"engineFeedback\\\": [\\\"your answer to each Engine Feedback question, in order\\\"],\\n  \\\"promptFeedback\\\": [\\\"your answer to each Prompt Feedback question, in order\\\"],\\n  \\\"aiHub\\\": {\\n    \\\"name\\\": \\\"the game's title, as on its title screen\\\",\\n    \\\"tagline\\\": \\\"a few words to go under the title\\\",\\n    \\\"description\\\": \\\"one or two sentences for the catalogue\\\",\\n    \\\"type\\\": \\\"Game, Tech demo or Tool\\\",\\n120→    \\\"genre\\\": \\\"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\\\",\\n    \\\"source\\\": \\\"the work it's based on, e.g. Moby-Dick\\\",\\n    \\\"series\\\": \\\"its franchise, e.g. Star Fox, or empty\\\",\\n    \\\"players\\\": \\\"how many can play: 1, 1–2 or 1–4\\\",\\n    \\\"controls\\\": \\\"the controls, in one line\\\",\\n    \\\"tags\\\": [\\\"3 to 6 lowercase tags, e.g. 2d, 3d, arcade, story, co-op, versus, first-person, third-person, top-down, side-scrolling, pixel art, low-poly, retro, sci-fi, fantasy, comedy, vehicles, boss fights, exploration\\\"]\\n  }\\n}\\nThe catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\\n\\n130→Testing Feedback\\n\\n- How many issues did testing catch?\\n- How many would be considered critical issues / game breaking?\\n- What was the most helpful test you ran?\\n- What was the least helpful test you ran?\\n\\nEngine Feedback\\n\\n- What did you like most about the engine?\\n140→- Did you get stuck or guess wrong?\\n- What was the most important thing you had to build yourself?\\n- What was the hardest part about using the engine?\\n- What did you change in the engine, and why? (none if nothing)\\n- If you could change one thing about the engine, what would it be?\\n\\nPrompt Feedback\\n\\n- What did you like most about this prompt?\\n- What was confusing?\\n150→- What was the hardest thing to do?\\n- What would you change in this prompt?\\n\",\"content_concise\":\"1→SOURCE: Wii Fit\\n\\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\\n\\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\\n\\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\\n\\nResearch: Whether and how much to research is your choice.\\n10→\\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-221607].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\\n\\nTech Stack: Build on https://github.com/michaelcrosato/riftlight/releases/latest/download/pixel-engine.zip, the riftlight engine kit. Keep the engine (pixel-engine.js) as it ships, as its guide says, and add whatever systems, art assets and animations the game needs on top of it. The rest of the tech stack is your choice.\\n\\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\\n\\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\\n\\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\\n20→\\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\\n\\nWorking Environment and deliverable:\\nCreate a subfolder called [GameTitle-SOURCE-grok-4.7-xhigh-20261104-221607] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-221607].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\\n\\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\\n\\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\\n\\n30→Effort: Spend effort however you see fit.\\n\\n## This computer\\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\\n\\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software