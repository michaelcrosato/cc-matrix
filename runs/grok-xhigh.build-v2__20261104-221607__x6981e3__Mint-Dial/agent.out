dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/audio/voice.js\",\"matches\":[{\"line_number\":90,\"content\":\"function noiseBurst(ctx, destination, when, seconds, volume) {\"},{\"line_number\":102,\"content\":\"  g.gain.setValueAtTime(volume, when);\"},{\"line_number\":103,\"content\":\"  g.gain.exponentialRampToValueAtTime(0.0001, when + seconds);\"},{\"line_number\":105,\"content\":\"  g.connect(destination);\"},{\"line_number\":111,\"content\":\"export function renderVoice(audioCtx, destination, syllables, when = 0, speaker = 'ounce') {\"},{\"line_number\":112,\"content\":\"  if (!audioCtx || !destination || !syllables?.length) return false;\"},{\"line_number\":120,\"content\":\"    g.gain.setValueAtTime(0.0001, t0);\"},{\"line_number\":121,\"content\":\"    g.gain.exponentialRampToValueAtTime(0.4, t0 + 0.006);\"},{\"line_number\":122,\"content\":\"    g.gain.exponentialRampToValueAtTime(0.0001, t0 + Math.max(0.04, syl.dur));\"},{\"line_number\":137,\"content\":\"    g.connect(destination);\"},{\"line_number\":142,\"content\":\"    if (plosive) noiseBurst(audioCtx, destination, t0, 0.008, 0.12);\"},{\"line_number\":143,\"content\":\"    else if (fricative) noiseBurst(audioCtx, destination, t0, 0.04, 0.06);\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-e03118f9-4955-4ca8-a493-816929376a1a-132","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→boot 1 {\\\"title\\\":\\\"Mint Dial\\\",\\\"stateTitle\\\":\\\"Mint Dial\\\",\\\"mode\\\":\\\"title\\\",\\\"music\\\":0.1,\\\"bus\\\":0.1}\\nboot 1 shot 1281x720 span 188.8 title start\\nboot 2 {\\\"title\\\":\\\"Mint Dial\\\",\\\"stateTitle\\\":\\\"Mint Dial\\\",\\\"mode\\\":\\\"title\\\",\\\"music\\\":0.1,\\\"bus\\\":0.1}\\nboot 2 shot 1281x720 span 188.8 title start\\ndrive {\\\"cross\\\":\\\"Cross Confirm\\\",\\\"xbox\\\":\\\"A Confirm\\\",\\\"key\\\":\\\"Enter Confirm\\\",\\\"mouse\\\":\\\"Click Confirm\\\"