6,104,105,115,46,110,111,100,101,46,98,117,105,108,100,40,101,41,59,114,101,116,117,114,110,32,101,46,115,101,116,67,111,110,116,101,120,116,40,116,41,44,110,125,103,101,110,101,114,97,116,101,40,101,44,116,41,123,108,101,116,32,110,61,101,46,97,100,100,67,111,110,116,101,120,116,40,116,104,105,115,46,118,97,108,117,101,41,44,114,61,116,104,105,115,46,110,111,100,101,46,98,117,105,108,100,40,101,44,116,41,59,114,101,116,117,114,110,32,101,46,115,101,116,67,111,110,116,101,120,116,40,110,41,44,114,125,125,44,69,103,61,40,101,61,110,117,108,108,44,116,61,123,125,41,61,62,123,108,101,116,32,110,61,101,59,114,101,116,117,114,110,40,110,61,61,61,110,117,108,108,124,124,110,46,105,115,78,111,100,101,33,61,61,33,48,41,38,38,40,116,61,110,124,124,116,44,110,61,110,117,108,108,41,44,110,101,119,32,84,103,40,110,44,116,41,125,44,68,103,61,101,61,62,69,103,40,101,44,123,117,110,105,102,111,114,109,70,108,111,119,58,33,48,125,41,44,79,103,61,40,101,44,116,41,61,62,69,103,40,101,44,123,110,111,100,101,78,97,109,101,58,116,125,41,59,102,117,110,99,116,105,111,110,32,107,103,40,101,44,116,44,110,61,110,117,108,108,41,123,114,101,116,117,114,110,32,69,103,40,110,44,123,103,101,116,83,104,97,100,111,119,58,40,123,108,105,103,104,116,58,110,44,115,104,32,91,46,46,46,32,116,114,117,110,99,97,116,101,100,32,40,49,48,51,52,32,99,104,97,114,115,32,116,111,116,97,108,41,93,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":200,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/PLAN.md\",\"matches\":[{\"line_number\":54,\"content\":\"| **Coach Plumb** | 81, silver bun, cyan tracksuit, a plumb bob hanging from one wrist. Demonstrates everything without effort. | Low, slow, deadpan. |\"},{\"line_number\":207,\"content\":\"Coach demonstrates on a dais. You hold the pose by keeping the Dot in the ring: settle 4 s (unscored), hold, release 2 s.\"},{\"line_number\":230,\"content\":\"| Overhead Mortgage | Press (new) | stick up = press; `repLag` ×1.5 (heavy) | 8 | 3.6 s |\"},{\"line_number\":232,\"content\":\"- **Target per rep:** 0→1 in 40% of the tempo, hold 15%, 1→0 in 35%, rest 10%. `r` follows the input with lag `repLag` 0.10 s.\"},{\"line_number\":233,\"content\":\"- **Keyboard uses rate control:** S/W move `r` at the target speed, no key holds it. Otherwise keys could only slam between ends.\"},{\"line_number\":397,\"content\":\"- \\\"I'm not angry. Scales don't get angry. We get accurate.\\\"\"},{\"line_number\":530,\"content\":\"| Breath and reps | breathBonus .55, repLag .10, repFatigue .10, repTempoScale 1 |\"},{\"line_number\":911,\"content\":\"21. The four harness runs from section 17, all `pass`. Each harness frame is a separate copy of the game, which covers the brief's \\\"no second player\\\" note.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/game.js\",\"matches\":[{\"line_number\":77,\"content\":\"      this.hero.celebrate();\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/TASK.md\",\"matches\":[{\"line_number\":24,\"content\":\"Create a subfolder called [GameTitle-SOURCE-grok-4.7-xhigh-20261104-221607] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-221607].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\"},{\"line_number\":83,\"content\":\"Design the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\"},{\"line_number\":120,\"content\":\"    \\\"genre\\\": \\\"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\\\",\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/examples/looks.js\",\"matches\":[{\"line_number\":46,\"content\":\"    // Objects on the actors layer: coins and a crate.\"},{\"line_number\":55,\"content\":\"    const crate = new Mesh(new BoxGeometry(1, 1, 1), toonMaterial(palette.orange));\"},{\"line_number\":56,\"content\":\"    crate.position.set(3, 0.5, 2);\"},{\"line_number\":57,\"content\":\"    crate.castShadow = true;\"},{\"line_number\":58,\"content\":\"    setLookLayer(crate, 'actors');\"},{\"line_number\":59,\"content\":\"    scene.add(crate);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/examples/side-scroller.js\",\"matches\":[{\"line_number\":98,\"content\":\"    this.hero.celebrate();\"},{\"line_number\":105,\"content\":\"    if (this.clearedAt !== null) this.input.move.set(0, 0, 0); // level clear: stand still and celebrate\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/examples/top-down.js\",\"matches\":[{\"line_number\":1,\"content\":\"// Lantern Night: walk (WASD / arrows), push both crates onto the glowing pads (walk into a\"},{\"line_number\":2,\"content\":\"// crate to push it), then leave through the gate in the north wall.\"},{\"line_number\":19,\"content\":\"  crates = [];\"},{\"line_number\":29,\"content\":\"    this.sparkle = ctx.random.fork('fireflies'); // drawn per frame (cosmetic): its own stream, so gameplay's never depends on the frame rate\"},{\"line_number\":70,\"content\":\"    // Pads and crates. A crate is a dynamic Rapier body the hero pushes (tag 'pushable').\"},{\"line_number\":85,\"content\":\"      this.crates.push(body);\"},{\"line_number\":112,\"content\":\"    this.hero.celebrate();\"},{\"line_number\":118,\"content\":\"    if (this.escaped) this.input.move.set(0, 0, 0); // the end: stand and celebrate\"},{\"line_number\":126,\"content\":\"    // A pad lights when a crate sits on it; both lit opens the gate.\"},{\"line_number\":128,\"content\":\"      const on = this.crates.some((b) => Math.hypot(b.translation().x - pad.x, b.translation().z - pad.z) < 0.5);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/examples/market.js\",\"matches\":[{\"line_number\":16,\"content\":\"  ['crate', [-1.1, 0, 1.7], { turn: 20 }],\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/tools/browser.mjs\",\"matches\":[{\"line_number\":399,\"content\":\"      const rate = buffer.sampleRate;\"},{\"line_number\":401,\"content\":\"        const w = 2 * Math.PI * freq / rate;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/ASSETS.md\",\"matches\":[{\"line_number\":23,\"content\":\"   crates is a few lines.\"},{\"line_number\":53,\"content\":\"export const crate = model({\"},{\"line_number\":54,\"content\":\"  id: 'crate',\"},{\"line_number\":55,\"content\":\"  about: 'Wooden crate with a frame and diagonal braces', // one line: find() searches it\"},{\"line_number\":74,\"content\":\"  turned about Y), `slab` (an XY outline or SVG path, extruded `depth` along Z), `tube` (points\"},{\"line_number\":144,\"content\":\"- **Colour separates parts:** touching parts take different colours or shades (planks and their\"},{\"line_number\":151,\"content\":\"- **Compose before you create:** `use` a library model before you write a new crate.\"},{\"line_number\":218,\"content\":\"  ['crate', [-1.1, 0, 1.7], { turn: 20 }],\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/audio/voice.js\",\"matches\":[{\"line_number\":4,\"content\":\"  ounce: { f0: 340, rate: 13, formant: 1.25 },\"},{\"line_number\":5,\"content\":\"  coach: { f0: 165, rate: 7.5, formant: 0.9, flat: true },\"},{\"line_number\":6,\"content\":\"  marguerite: { f0: 230, rate: 9, formant: 1, vibrato: true },\"},{\"line_number\":7,\"content\":\"  dennis: { f0: 120, rate: 11, formant: 0.95, lastUp: true },\"},{\"line_number\":8,\"content\":\"  june: { f0: 300, rate: 10, formant: 1.15, flat: true },\"},{\"line_number\":60,\"content\":\"  const base = 1 / spec.rate;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/app.js\",\"matches\":[{\"line_number\":1270,\"content\":\"    else if (this.mode === 'ferry') { line = 'The ferry is on time. Your knees are a separate matter.'; }\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/tunables.js\",\"matches\":[{\"line_number\":17,\"content\":\"    ['repLag', 0.1, 0.02, 0.4, 0.01],\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/drivers.js\",\"matches\":[{\"line_number\":17,\"content\":\"const EMPTY = { x: 0, y: 0, breath: false, stepL: false, stepR: false, confirm: false, depth: 0 };\"},{\"line_number\":103,\"content\":\"    return { x, y, breath, stepL, stepR, confirm, depth: Math.max(0, -y) };\"},{\"line_number\":137,\"content\":\"      depth: Math.max(0, -dz.y),\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/sims.js\",\"matches\":[{\"line_number\":6,\"content\":\"const ZERO = { x: 0, y: 0, breath: false, stepL: false, stepR: false, confirm: false, depth: 0, edgeL: false, edgeR: false };\"},{\"line_number\":227,\"content\":\"    const lag = (this.T.repLag || 0.1) * (this.def.lag || 1);\"},{\"line_number\":228,\"content\":\"    let depth = 0;\"},{\"line_number\":229,\"content\":\"    if (this.skill === 'expert' || this.skill === 'good') depth = clamp(target + slope * lag, 0, 1);\"},{\"line_number\":230,\"content\":\"    else if (this.skill === 'average') depth = clamp(target * 0.75, 0, 1);\"},{\"line_number\":231,\"content\":\"    else if (this.skill === 'sloppy') depth = clamp(target * 0.25 + 0.1, 0, 1);\"},{\"line_number\":233,\"content\":\"    return { ...ZERO, depth, x: this.def.axis === 'side' ? side * depth : 0, y: this.def.axis === 'up' ? depth : -depth };\"},{\"line_number\":252,\"content\":\"    const lag = (this.T.repLag || 0.1) * (this.def.lag || 1);\"},{\"line_number\":253,\"content\":\"    let depth = u.depth || 0;\"},{\"line_number\":254,\"content\":\"    if (u.useRate) {\"},{\"line_number\":255,\"content\":\"      this.r = clamp(this.r + (u.rate || 0) * dt, 0, 1);\"},{\"line_number\":258,\"content\":\"      this.r += (depth - this.r) * k;\"},{\"line_number\":739,\"content\":\"    const rate = this.skill === 'sloppy' ? 1.2 : this.skill === 'average' ? 2.2 : this.skill === 'good' ? target : target;\"},{\"line_number\":741,\"content\":\"    const period = 1 / Math.max(0.5, rate);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/data/creditsText.js\",\"matches\":[{\"line_number\":2,\"content\":\"export const CREDITS_TEXT = \\\"# Credits (Pixel Engine 0.46.0)\\\\n\\\\nWhat this kit carries and where it came from, generated by `npm run bundle` from each built-in model's and texture's `source` (the data the engine repository's `npm run model -- credits` reads) and from the bundled packages' own licence files. Ship this file with a game built on the kit.\\\\n\\\\n## Models and textures\\\\n\\\\n- **The engine's own work**, made in its repository: 151 of the 151 library models (`MODEL_LIBRARY`), 126 of the 126 textures (`TEXTURE_LIBRARY`) and the built-in models (`assets/coin.glb`, `assets/hero.glb`, `assets/tree.glb`). Nothing to credit.\\\\n- **kenney-castle** by Kenney, Creative Commons Zero 1.0 (public domain dedication) (CC0-1.0, credit optional): https://kenney.nl/media/pages/assets/castle-kit/a395102d20-1711543616/kenney_castle-kit.zip. Models: kenney-castle/bridge-draw, kenney-castle/bridge-straight-pillar, kenney-castle/bridge-straight, kenney-castle/door, kenney-castle/flag-banner-long, kenney-c [... truncated (1031 chars total)]\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/data/lines.js\",\"matches\":[{\"line_number\":15,\"content\":\"  \\\"I'm not angry. Scales don't get angry. We get accurate.\\\",\"},{\"line_number\":69,\"content\":\"  ['ounce', 'The ferry is on time. Your knees are a separate matter.'],\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/check.mjs\",\"matches\":[{\"line_number\":18,\"content\":\"//   --sheets models.js,crate,cobbles draw sheets instead of playing a page (ASSETS.md): every\"},{\"line_number\":317,\"content\":\"  if (!items.length) fail('--sheets needs modules (models.js) or library ids (crate), comma-separated');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/vendor/hub/session.js\",\"matches\":[{\"line_number\":11,\"content\":\"  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\"},{\"line_number\":368,\"content\":\"    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\"},{\"line_number\":371,\"content\":\"      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/vendor/hub/bridge.js\",\"matches\":[{\"line_number\":24,\"content\":\"  ratePerS: 20,\"},{\"line_number\":155,\"content\":\"    tokens = Math.min(LIMITS.burst, tokens + ((now - refilled) / 1000) * LIMITS.ratePerS);\"},{\"line_number\":159,\"content\":\"      return issue(`send: over ${LIMITS.ratePerS} messages a second`);\"},{\"line_number\":214,\"content\":\"        toGame({ ...rest, round, limits: { maxBytes: LIMITS.maxBytes, ratePerS: LIMITS.ratePerS, burst: LIMITS.burst } });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/README.md\",\"matches\":[{\"line_number\":33,\"content\":\"the engine's repository instead: `git clone --depth 1 https://github.com/michaelcrosato/riftlight && cd riftlight && npm ci && npm run bundle`\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/CREDITS.md\",\"matches\":[{\"line_number\":3,\"content\":\"What this kit carries and where it came from, generated by `npm run bundle` from each built-in model's and texture's `source` (the data the engine repository's `npm run model -- credits` reads) and from the bundled packages' own licence files. Ship this file with a game built on the kit.\"},{\"line_number\":86,\"content\":\"      not limited to compiled object code, generated documentation,\"},{\"line_number\":118,\"content\":\"      subsequently incorporated within the Work.\"},{\"line_number\":138,\"content\":\"      or a Contribution incorporated within the Work constitutes direct\"},{\"line_number\":168,\"content\":\"          within a display generated by the Derivative Works, if and\"},{\"line_number\":189,\"content\":\"      the terms of any separate license agreement you may have executed\"},{\"line_number\":209,\"content\":\"      unless required by applicable law (such as deliberate and grossly\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/GUIDE.md\",\"matches\":[{\"line_number\":76,\"content\":\"Meshes are interpolated between steps, so motion is smooth at any frame rate. A character\"},{\"line_number\":166,\"content\":\"      this.hero.celebrate();\"},{\"line_number\":218,\"content\":\"quality, frame rate, sound, debug info; saved per game): the ⚙ button opens it, top right\"},{\"line_number\":235,\"content\":\"  add the sources too). Keep anything that moves separate.\"},{\"line_number\":239,\"content\":\"  `physics.world` (see the top-down recipe's crates).\"},{\"line_number\":250,\"content\":\"**Models and textures as data.** Besides GLBs, the kit has a library of models (crates, stalls,\"},{\"line_number\":281,\"content\":\"`hero.jump('Jump')` (bounce, e.g. off an enemy), `hero.celebrate()`, `hero.lookAt = vector`\"},{\"line_number\":308,\"content\":\"Triggers see dynamic and kinematic bodies (the hero, crates), not level geometry. Dynamic\"},{\"line_number\":319,\"content\":\"ctx.physics.conveyor(beltCollider, [2, 0, 0]);               // carries crates and the hero\"},{\"line_number\":331,\"content\":\"Movers are functions of their own clock (same at any frame rate). `hero.stats.crushes` counts a\"},{\"line_number\":386,\"content\":\"const land = new Terrain({ size: [40, 30] }).generate((x, z) => 4 * noise.fbm2(x * 0.05, z * 0.05)); // land.erode(); land.attach(ctx.physics); ctx.scene.add(land.mesh)\"},{\"line_number\":619,\"content\":\"    this.hero.celebrate();\"},{\"line_number\":626,\"content\":\"    if (this.clearedAt !== null) this.input.move.set(0, 0, 0); // level clear: stand still and celebrate\"},{\"line_number\":691,\"content\":\"### Top-down at night: lights, pushable crates, music, custom particles\"},{\"line_number\":694,\"content\":\"// Lantern Night: walk (WASD / arrows), push both crates onto the glowing pads (walk into a\"},{\"line_number\":695,\"content\":\"// crate to push it), then leave through the gate in the north wall.\"},{\"line_number\":712,\"content\":\"  crates = [];\"},{\"line_number\":722,\"content\":\"    this.sparkle = ctx.random.fork('fireflies'); // drawn per frame (cosmetic): its own stream, so gameplay's never depends on the frame rate\"},{\"line_number\":763,\"content\":\"    // Pads and crates. A crate is a dynamic Rapier body the hero pushes (tag 'pushable').\"},{\"line_number\":778,\"content\":\"      this.crates.push(body);\"},{\"line_number\":805,\"content\":\"    this.hero.celebrate();\"},{\"line_number\":811,\"content\":\"    if (this.escaped) this.input.move.set(0, 0, 0); // the end: stand and celebrate\"},{\"line_number\":819,\"content\":\"    // A pad lights when a crate sits on it; both lit opens the gate.\"},{\"line_number\":821,\"content\":\"      const on = this.crates.some((b) => Math.hypot(b.translation().x - pad.x, b.translation().z - pad.z) < 0.5);\"},{\"line_number\":906,\"content\":\"    // Objects on the actors layer: coins and a crate.\"},{\"line_number\":915,\"content\":\"    const crate = new Mesh(new BoxGeometry(1, 1, 1), toonMaterial(palette.orange));\"},{\"line_number\":916,\"content\":\"    crate.position.set(3, 0.5, 2);\"},{\"line_number\":917,\"content\":\"    crate.castShadow = true;\"},{\"line_number\":918,\"content\":\"    setLookLayer(crate, 'actors');\"},{\"line_number\":919,\"content\":\"    scene.add(crate);\"},{\"line_number\":983,\"content\":\"   `setup`, so the frame rate never changes what gameplay draws. Read buttons from `ctx.input`\"},{\"line_number\":1019,\"content\":\"| Slow, low fps | hundreds of separate meshes | `mergeStaticMeshes` the static level; share materials (`toonMaterial` caches) |\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/LIBRARY.md\",\"matches\":[{\"line_number\":3,\"content\":\"Every built-in model (`MODEL_LIBRARY`, 151) and texture (`TEXTURE_LIBRARY`, 126) by family, then every imported pack (575 models, 264 textures in `packs/`), generated from the defs. A model's variants (`rock-large-a` … `-f`) share a row. Search it; don't read it whole.\"},{\"line_number\":20,\"content\":\"| `roof` | 4.7 × 1.73 × 3.73 | width 4 (1.5–10), depth 3 (1.5–8), pitch 40 (15–60) | tile red, tile2 plum, stone mist, wood orange | architecture, roof, stone, wood | Gable roof to sit on walls (y = 0 is the wall top): two pitched slabs of tile courses, stone gable ends, a ridge beam |\"},{\"line_number\":27,\"content\":\"| `balcony` | 2 × 1.98 × 1.04 | width 2 (1–4), depth 1 (0.6–1.5) | wood orange, wood2 red, frame plum | architecture, wood, town, modular | Wooden balcony to hang on a wall at z = 0, its deck 3 m up (a storey of `stone-wall`): boards on joists and knee braces, a baluster railing round three sides; footprint `width` x `depth` m |\"},{\"line_number\":40,\"content\":\"| `crate` | 0.74 × 0.72 × 0.74 |  | wood orange, band red | container, wood | Wooden crate with a frame and diagonal braces |\"},{\"line_number\":48,\"content\":\"| `crate-stack` | 1.55 × 1.44 × 0.79 | count 3 (2–4) | wood orange, wood2 red, band red, band2 plum | container, wood, town, dungeon | Stack of `count` crates (seeded): two on the floor, one across their tops, a smaller one in front; alternate crates darker |\"},{\"line_number\":78,\"content\":\"| `portcullis` | 1.4 × 2.2 × 0.16 | w 1.4 (0.8–3), h 2.2 (1.6–3.2) | bar slate, band night, tip mist | dungeon, iron, door | Iron portcullis for a doorway: slate bars ending in steel spikes, dark cross bands over them, all on the pivot `grate` to raise it; `w` x `h` metres |\"},{\"line_number\":84,\"content\":\"| `pit-grate` | 1.68 × 0.33 × 1.68 | r 0.6 (0.4–1) | stone mist, stone2 slate, hole ink, iron night | dungeon, stone, iron, trap | Pit in the floor like a well head: a low curb of stones in two greys round a black hole, under an iron ring and grate of crossed bars (the pivot `grate`); `r` is the hole's radius |\"},{\"line_number\":176,\"content\":\"| `market-stall` | 3.43 × 2.26 × 1.02 |  | wood orange, cloth red, cloth2 white, top sand | town, market | Market stall with a striped awning, crates and a barrel |\"},{\"line_number\":177,\"content\":\"| `arch` | 2.84 × 1.48 × 0.68 | span 2 (0.8–5), ring 0.42 (0.2–0.8), depth 0.6 (0.2–1.5), blocks 9 (5–15), piers 0 (0–4) | stone mist, stone2 slate, mortar night | stone, building | Stone arch of voussoirs in two shades over dark mortar; `piers` (m) stands it on two coursed stone piers that tall, 0 puts its feet on y = 0 |\"},{\"line_number\":182,\"content\":\"| `produce-crate` | 0.74 × 0.75 × 0.58 |  | wood orange, frame plum, bed night, fruit red, fruit2 lime, fruit3 sand | town, market, food, wood | Market display: an open crate of fruit tipped toward the buyer on a four-legged stand, mostly one kind with a few of another (seeded); map `fruit`, `fruit2`, `fruit3` |\"},{\"line_number\":257,\"content\":\"| `grate` | 16 × 16, tiles | hole ink, depth night, bar slate, lit mist | surface, metal, floor | A grated metal floor: a grid of bars over dark square holes |\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/CHANGELOG.md\",\"matches\":[{\"line_number\":44,\"content\":\"  lab's depth and seed, the door a room was entered by). Recordings keep it (**`Recording.args`**),\"},{\"line_number\":97,\"content\":\"  size, quality, frame rate and debug info, as plain data saved per game (`EngineOptions.settings.key`,\"},{\"line_number\":300,\"content\":\"  generated from the libraries when the kit is built.\"},{\"line_number\":301,\"content\":\"- `CREDITS.md`: where everything the kit carries came from, generated when the kit is built from\"},{\"line_number\":306,\"content\":\"- `check.mjs --sheets models.js,crate,cobbles`: draws a sheet of every ModelDef and TextureDef a\"},{\"line_number\":340,\"content\":\"  `checker-marble`, `hex-tiles`, `mosaic`, `terracotta`, `grate`, `rune-floor`. Roofs:\"},{\"line_number\":359,\"content\":\"  `pressure-plate`, `obelisk`, `rune-stone`, `pillory`, `pit-grate`. Containers: `clay-pot`,\"},{\"line_number\":360,\"content\":\"  `amphora`, `urn`, `basket`, `bucket`, `keg`, `strongbox`, `crate-stack`. Props (tools, loot,\"},{\"line_number\":362,\"content\":\"  `loot-pouch`. Town: `fountain`, `haystack`, `hitching-post`, `produce-crate`, `park-bench`,\"},{\"line_number\":544,\"content\":\"  `size`) and `arch` (voussoirs in two shades over dark mortar; params `span`, `ring`, `depth`,\"},{\"line_number\":549,\"content\":\"- The format's header (src/engine/model/types.ts) says what reads at 480×270: colour separates\"},{\"line_number\":562,\"content\":\"  posts, the market stall's crates clear its legs, and the greatsword's sub-pixel edge stripe is\"},{\"line_number\":580,\"content\":\"  (`ModelCatalog`: barrel, crate, lamp-post, statue, well, market-stall, greatsword);\"},{\"line_number\":669,\"content\":\"    with radius and depth, leaves, tropism, jitter).\"},{\"line_number\":823,\"content\":\"  models and the CSS), with `GUIDE.md` (how to build a game on it), a generated `API.md`,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/API.md\",\"matches\":[{\"line_number\":3,\"content\":\"Every export of `pixel-engine.js` (493 names), generated from the engine's TypeScript at build 2026-11-02 f75d4a6. Signatures are the source declarations; descriptions are their doc comments. Read GUIDE.md first: it says how the pieces fit; come here for exact names and parameters (search this file, don't read it whole).\"},{\"line_number\":149,\"content\":\"- `readonly settings: Settings`: The player's settings: look, pixel art, pixel size, quality, frame rate and debug info (plain data, saved per game), applied over the game's own choices; `open()` shows them in the settings panel (the ⚙ button, `EngineOptions.settings`). Sound is `audio`'s.\"},{\"line_number\":174,\"content\":\"- `get maxFps: number`: Frame cap of the render loop (0 = display rate).\"},{\"line_number\":208,\"content\":\"- `maxFps?: number`: Cap the render loop (simulation keeps its fixed 60 Hz physics step). Default 60, so 120 Hz phones don't run the whole pipeline twice per game frame. 0 = display rate.\"},{\"line_number\":220,\"content\":\"- `settings?: { button?: TouchCorner | boolean; key?: string | false }`: The player's settings (`engine.settings`): look, pixel art, pixel size, quality, frame rate, sound and debug info, in a panel the ⚙ button opens. `button`: its corner (default, or true: 'top-right'; on a mouse it shows while the pointer moves), or false for n…\"},{\"line_number\":235,\"content\":\"should run, and advances the schedule so the long-run rate is `maxFps` even when the\"},{\"line_number\":236,\"content\":\"display rate isn't a multiple of it (90 Hz, 144 Hz) and timestamps jitter.\"},{\"line_number\":272,\"content\":\"- `readonly args?: unknown`: The plain JSON the game was made with, when its name alone can't rebuild it (a lab's depth and seed, the door a room was entered by): kept in its recordings (`Recording.args`), so a tool can make the same game again to replay one (`npm run replay`, src/games.…\"},{\"line_number\":369,\"content\":\"- `fps?: number`: Frame cap: 60, 30, or 0 for the display's own rate.\"},{\"line_number\":370,\"content\":\"- `debugInfo?: boolean`: The debug panel: frame rate, camera, GPU errors and the game's status.\"},{\"line_number\":405,\"content\":\"run well below the frame-rate target.\"},{\"line_number\":590,\"content\":\"- `readonly lockDepth: boolean`: Side-scroller: characters should stay on their depth lane.\"},{\"line_number\":662,\"content\":\"- `readonly lockDepth: boolean`: Side-scroller: characters should stay on their depth lane.\"},{\"line_number\":762,\"content\":\"- `depth: number`: Silhouette / depth-discontinuity outline darkening, 0..1.\"},{\"line_number\":784,\"content\":\"- `depth?(uv: N): N`: Scene depth (0 near … 1 far) at a screen uv, where the stage has one (the cel filter's ink).\"},{\"line_number\":795,\"content\":\"- `readonly sceneOnly?: boolean`: Moves pixels (curves, splits, smears): runs on the whole scene only. A layer's filters run before the layers are composed by depth, so a warp there would no longer line up with the other layer (render/look.ts drops these from layer stacks).\"},{\"line_number\":952,\"content\":\"- `split: boolean`: Two scene passes (actors and environment) composed by depth.\"},{\"line_number\":1044,\"content\":\"- `outline: number`: Silhouette (depth) outline darkening, 0..1.\"},{\"line_number\":1052,\"content\":\"             color + normal + depth) → art-resolution stage: depth/normal edges, output\"},{\"line_number\":1315,\"content\":\"sources are left untouched (don't add them to the scene). Physics is separate: keep\"},{\"line_number\":1327,\"content\":\"Keep in sync with scripts/generate-assets.mjs.\"},{\"line_number\":1685,\"content\":\"- `recycle(y: number, to: (i: number) => readonly [number, number, number]): number`: Bodies that fell below `y` go back up to `to` (a fountain of crates).\"},{\"line_number\":1785,\"content\":\"- `static create(gravity = -24): Promise<Physics>`: Loads Rapier's wasm on first use (a separate, streamed .wasm file), then builds a world.\"},{\"line_number\":1896,\"content\":\"- `readonly depth: number`\"},{\"line_number\":1911,\"content\":\"- `size: readonly [number, number]`: Width and depth of the water (m).\"},{\"line_number\":2195,\"content\":\"- `weight: number`: How hard the character presses the dynamic floor it stands on (a rope bridge sags where it stands, a spring pad sinks), in the physics world's mass units (density × m³: a 1 m crate of density 2 weighs 2), under the world's gravity. 0 (the default): it rides d…\"},{\"line_number\":2213,\"content\":\"- `celebrate(): void`: Celebrate (games call this, e.g. on level complete).\"},{\"line_number\":2219,\"content\":\"- `animationMix(): { name: string; weight: number; time: number; rate: number }[]`: Tooling: every clip currently contributing to the pose, with its blend weight and time (s).\"},{\"line_number\":2555,\"content\":\"- `pitch?: number`: Pitch shift in semitones (playback rate), e.g. a rising combo.\"},{\"line_number\":2584,\"content\":\"A chiptune song as data. Each pattern holds one string per track: space-separated steps,\"},{\"line_number\":2587,\"content\":\"note's pitch is the noise rate: C6 is a snare-ish hiss, C8 a hi-hat tick.\"},{\"line_number\":2599,\"content\":\"- `freq: number`: Start pitch in Hz. For `noise` it is the sample-and-hold rate (higher = hissier).\"},{\"line_number\":2609,\"content\":\"- `vibrato?: { depth: number; rate: number }`: Vibrato depth in semitones and rate in Hz.\"},{\"line_number\":2881,\"content\":\"The 12 beams along the edges of a box of outer size `size` centred on `at`: crates, cages,\"},{\"line_number\":3244,\"content\":\"The densest a moving model passed Gate B at (its sliding crate); denser wasn't measured.\"},{\"line_number\":3535,\"content\":\"`crate-1` … `-3`, `tree-pine-tall-a-detailed` … `-d-detailed` → `kenney-nature/rock-large`,\"},{\"line_number\":3536,\"content\":\"`crate`, `tree-pine-tall-detailed`). An id without one is its own. For models: a sheet's\"},{\"line_number\":3555,\"content\":\"- `speed?: number`: Ground speed (m/s) the clip is authored for at playback rate 1. Locomotion clips set this; metrics then measure foot sliding against it and the runtime can scale playback.\"},{\"line_number\":3566,\"content\":\"velocity spikes, joint limits. Thresholds are deliberately forgiving; `problems` are\"},{\"line_number\":3660,\"content\":\"- `speed: number`: Ground speed the cycle is authored for (m/s at playback rate 1).\"},{\"line_number\":3774,\"content\":\"- `fps: number`: Frame rate of the authoring format.\"},{\"line_number\":3937,\"content\":\"- `trace(): TraceRow[]`: Every node depth-first with this tick's answer: for drawing the tree.\"},{\"line_number\":3988,\"content\":\"- `depth: number`: Branching level (0 = trunk).\"},{\"line_number\":4239,\"content\":\"- `evaporate?: number`: Water lost per step (default 0.02).\"},{\"line_number\":4312,\"content\":\"- `area: readonly [number, number]`: Width (x) and depth (z) of the patch, m.\"},{\"line_number\":4425,\"content\":\"- `depth: number`\"},{\"line_number\":4602,\"content\":\"- `area?: readonly [number, number, number]`: Width, height and depth of the air the drops fall through, around the centre.\"},{\"line_number\":4850,\"content\":\"- `generate(f: (x: number, z: number) => number): this`: Fill the heights from `f(x, z)` (world x, z; metres above the terrain's origin), then redraw.\"},{\"line_number\":4854,\"content\":\"- `attach(physics: Physics): RAPIER.Collider`: Make (or remake, after `generate` / `erode`) the heightfield collider: a fixed body at the terrain's origin. Returns it.\"},{\"line_number\":4887,\"content\":\"- `speed: number`: Playback rate (1: real time, 0.5: slow motion).\"},{\"line_number\":4919,\"content\":\"- `depth: number`\"},{\"line_number\":5075,\"content\":\"- `size: readonly [number, number]`: Width (x) and depth (z) of the surface, m.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/pixel-engine.js\",\"matches\":[{\"line_number\":2,\"content\":\"var e=Object.defineProperty,t=(t,n)=>{let r={};for(var i in t)e(r,i,{get:t[i],enumerable:!0});return n||e(r,Symbol.toStringTag,{value:`Module`}),r},n=`html,body{background:#0d0e16;height:100%;margin:0;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;overflow:hidden}#app{position:fixed;inset:0}canvas[data-engine-canvas]{image-rendering:pixelated;image-rendering:crisp-edges}.debug-ui{z-index:10;color:#f4f4f4;background:#1a1c2cd9;border:2px solid #566c86;min-width:220px;padding:8px 10px;font-size:12px;line-height:1.5;position:absolute;top:8px;left:8px}.debug-ui .row{justify-content:space-between;gap:12px;display:flex}.debug-ui span{color:#94b0c2}.debug-ui b[data-backend=webgpu]{color:#a7f070}.debug-ui .game{color:#ffcd75;margin-top:4px}.debug-ui .buttons{gap:6px;margin:6px 0 4px;display:flex}.debug-ui button{font:inherit;color:#1a1c2c;cursor:pointer;background:#94b0c2;border:0;flex:1;padding:3px 4px}.debug-ui button:hover{background:#f4f4f4}.debug-ui .keys{color:#566c86;fo [... truncated (1031 chars total)]\"},{\"line_number\":6,\"content\":\"}`,jc=class extends Vi{constructor(e){super(),this.isShaderMaterial=!0,this.type=`ShaderMaterial`,this.defines={},this.uniforms={},this.uniformsGroups=[],this.vertexShader=kc,this.fragmentShader=Ac,this.linewidth=1,this.wireframe=!1,this.wireframeLinewidth=1,this.fog=!1,this.lights=!1,this.clipping=!1