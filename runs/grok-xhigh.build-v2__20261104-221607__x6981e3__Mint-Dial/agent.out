,{\"line_number\":504,\"content\":\"      const e = window.__PIXEL_ENGINE__;\"},{\"line_number\":547,\"content\":\"      window.__PIXEL_ENGINE__.setCamera({ preset: p }, { syncUrl: false });\"},{\"line_number\":548,\"content\":\"      window.__PIXEL_ENGINE__.step(20);\"},{\"line_number\":554,\"content\":\"      const e = window.__PIXEL_ENGINE__;\"},{\"line_number\":563,\"content\":\"  report.state = await page.evaluate(() => window.__PIXEL_ENGINE__.state());\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/GUIDE.md\",\"matches\":[{\"line_number\":1025,\"content\":\"The engine is on `window.__PIXEL_ENGINE__` once it runs (also the value `Engine.start` returns).\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/pixel-engine.js\",\"matches\":[{\"line_number\":579,\"content\":\"      </div>`;for(let e of this.root.querySelectorAll(`[data-s]`))this.controls.set(e.dataset.s,e);for(let e of this.root.querySelectorAll(`[data-o]`))this.outputs.set(e.dataset.o,e);let o=e.settings,s=(e,t)=>{let n=this.controls.get(e);n.addEventListener(n instanceof HTMLInputElement&&n.type===`range`?`input`:`change`,()=>{t(n),this.sync()})};s(`look`,e=>o.set({look:e.value||void 0})),s(`pixelArt`,e=>o.set({pixelArt:e.checked})),s(`pixelSize`,e=>o.set({pixelSize:e.value})),s(`quality`,e=>o.set({quality:e.value})),s(`fps`,e=>o.set({fps:kY.includes(Number(e.value))?Number(e.value):void 0})),s(`debugInfo`,e=>o.set({debugInfo:e.checked})),s(`sound`,t=>{e.audio.unlock(),e.audio.setMuted(!t.checked)});for(let[t]of LY)s(t,n=>{e.audio.unlock(),e.audio.setVolume(t,Number(n.value)/100)});let c=(e,t)=>this.root.querySelector(`[data-a=\\\"${e}\\\"]`).addEventListener(`click`,t);c(`close`,()=>o.close()),c(`done`,()=>o.close()),c(`reset`,()=>{o.reset(),e.audio.resetVolumes(),this.sync()}),this.root.addEv [... trunca