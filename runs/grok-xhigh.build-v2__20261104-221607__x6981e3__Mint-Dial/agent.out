ld-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/vendor/hub/harness.html\",\"matches\":[{\"line_number\":379,\"content\":\" * page's origin). Results land in window.__hubCheck, and body[data-complete]\"},{\"line_number\":412,\"content\":\"  window.__hubCheck = report;\"},{\"line_number\":527,\"content\":\"    document.body.dataset.complete = 'true';\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-19718026-e00c-4569-908f-f2294f4ee02e-52","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/** Short sounds, all data. Registered once at boot. */\\nexport const SFX = {\\n  tick: { wave: 'square', freq: 880, decay: 0.04, volume: 0.35 },\\n  chime: { wave: 'triangle', freq: 660, freqEnd: 990, decay: 0.28, volume: 0.4 },\\n  warn: { wave: 'square', freq: 220, freqEnd: 140, decay: 0.2, volume: 0.4 },\\n  rep: { wave: 'square', freq: 440, decay: 0.05, volume: 0.3 },\\n  perfect: { wave: 'triangle', freq: 880, freqEnd: 1320, decay: 0.12, volume: 0.4 },\\n  good: { wave: 'triangle', freq: 660, decay: 0.1, volume: 0.35 },\\n  combo: { wave: 'square', freq: 520, freqEnd: 780, decay: 0.1, volume: 0.35 },\\n10→  bonk: { wave: 'triangle', freq: 180, freqEnd: 70, decay: 0.12, volume: 0.5 },\\n  thwap: { wave: 'noise', freq: 800, decay: 0.08, volume: 0.4 },\\n  whirr: { wave: 'sawtooth', freq: 140, freqEnd: 180, decay: 0.3, volume: 0.25 },\\n  splash: { wave: 'noise', freq: 400, decay: 0.3, volume: 0.45 },\\n  gust: { wave: 'noise', freq: 200, decay: 0.4, volume: 0.35 },\\n  squawk: { wave: 'square', freq: 900, freqEnd: 400, decay: 0.12, volume: 0.4 },\\n  drip: { wave: 'sine', freq: 1200, freqEnd: 600, decay: 0.1, volume: 0.3 },\\n  star: { wave: 'triangle', freq: 523, freqEnd: 1046, decay: 0.2, volume: 0.4 },\\n  move: { wave: 'square', freq: 330, decay: 0.03, volume: 0.25 },\\n  confirm: { wave: 'triangle', freq: 520, freqEnd: 780, decay: 0.08, volume: 0.35 },\\n20→  back: { wave: 'triangle', freq: 400, freqEnd: 220, decay: 0.08, volume: 0.3 },\\n  ow: { wave: 'square', freq: 160, freqEnd: 90, decay: 0.25, volume: 0.45 },\\n};\\n\\nexport function registerSfx(audio) {\\n  if (!audio?.register) return;\\n  for (const [name, def] of Object.entries(SFX)) audio.register(name, def);\\n}\\n\",\"content_concise\":\"1→/** Short sounds, all data. Registered once at boot. */\\nexport const SFX = {\\n  tick: { wave: 'square', freq: 880, decay: 0.04, volume: 0.35 },\\n  chime: { wave: 'triangle', freq: 660, freqEnd: 990, decay: 0.28, volume: 0.4 },\\n  warn: { wave: 'square', freq: 220, freqEnd: 140, decay: 0.2, volume: 0.4 },\\n  rep: { wave: 'square', freq: 440, decay: 0.05, volume: 0.3 },\\n  perfect: { wave: 'triangle', freq: 880, freqEnd: 1320, decay: 0.12, volume: 0.4 },\\n  good: { wave: 'triangle', freq: 660, decay: 0.1, volume: 0.35 },\\n  combo: { wave: 'square', freq: 520, freqEnd: 780, decay: 0.1, volume: 0.35 },\\n10→  bonk: { wave: 'triangle', freq: 180, freqEnd: 70, decay: 0.12, volume: 0.5 },\\n  thwap: { wave: 'noise', freq: 800, decay: 0.08, volume: 0.4 },\\n  whirr: { wave: 'sawtooth', freq: 140, freqEnd: 180, decay: 0.3, volume: 0.25 },\\n  splash: { wave: 'noise', freq: 400, decay: 0.3, volume: 0.45 },\\n  gust: { wave: 'noise', freq: 200, decay: 0.4, volume: 0.35 },\\n  squawk: { wave: 'square', freq: 900, freqEnd: 400, decay: 0.12, volume: 0.4 },\\n  drip: { wave: 'sine', freq: 1200, freqEnd: 600, decay: 0.1, volume: 0.3 },\\n  star: { wave: 'triangle', freq: 523, freqEnd: 1046, decay: 0.2, volume: 0.4 },\\n  move: { wave: 'square', freq: 330, decay: 0.03, volume: 0.25 },\\n  confirm: { wave: 'triangle', freq: 520, freqEnd: 780, decay: 0.08, volume: 0.35 },\\n20→  back: { wave: 'triangle', freq: 400, freqEnd: 220, decay: 0.08, volume: 0.3 },\\n  ow: { wave: 'square', freq: 160, freqEnd: 90, decay: 0.25, volume: 0.45 },\\n};\\n\\nexport function registerSfx(audio) {\\n  if (!audio?.register) return;\\n  for (const [name, def] of Object.entries(SFX)) audio.register(name, def);\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/audio/sfx.js\",\"offset\":null,\"limit\":40,\"raw_output\":\"/** Short sounds, all data. Registered once at boot. */\\nexport const SFX = {\\n  tick: { wave: 'square', freq: 880, decay: 0.04, volume: 0.35 },\\n  chime: { wave: 'triangle', freq: 660, freqEnd: 990, decay: 0.28, volume: 0.4 },\\n  warn: { wave: 'square', freq: 220, freqEnd: 140, decay: 0.2, volume: 0.4 },\\n  rep: { wave: 'square', freq: 440, decay: 0.05, volume: 0.3 },\\n  perfect: { wave: 'triangle', freq: 880, freqEnd: 1320, decay: 0.12, volume: 0.4 },\\n  good: { wave: 'triangle', freq: 660, decay: 0.1, volume: 0.35 },\\n  combo: { wave: 'square', freq: 520, freqEnd: 780, decay: 0.1, volume: 0.35 },\\n  bonk: { wave: 'triangle', freq: 180, freqEnd: 70, decay: 0.12, volume: 0.5 },\\n  thwap: { wave: 'noise', freq: 800, decay: 0.08, volume: 0.4 },\\n  whirr: { wave: 'sawtooth', freq: 140, freqEnd: 180, decay: 0.3, volume: 0.25 },\\n  splash: { wave: 'noise', freq: 400, decay: 0.3, volume: 0.45 },\\n  gust: { wave: 'noise', freq: 200, decay: 0.4, volume: 0.35 },\\n  squawk: { wave: 'square', freq: 900, freqEnd: 400, decay: 0.12, volume: 0.4 },\\n  drip: { wave: 'sine', freq: 1200, freqEnd: 600, decay: 0.1, volume: 0.3 },\\n  star: { wave: 'triangle', freq: 523, freqEnd: 1046, decay: 0.2, volume: 0.4 },\\n  move: { wave: 'square', freq: 330, decay: 0.03, volume: 0.25 },\\n  confirm: { wave: 'triangle', freq: 520, freqEnd: 780, decay: 0.08, volume: 0.35 },\\n  back: { wave: 'triangle', freq: 400, freqEnd: 220, decay: 0.08, volume: 0.3 },\\n  ow: { wave: 'square', freq: 160, freqEnd: 90, decay: 0.25, volume: 0.45 },\\n};\\n\\nexport function registerSfx(audio) {\\n  if (!audio?.register) return;\\n  for (const [name, def] of Object.entries(SFX)) audio.register(name, def);\\n}\\n\",\"total_lines\":27}}","is_error":false},{"type":"tool_result","tool_use_id":"call-19718026-e00c-4569-908f-f2294f4ee02e-53","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import { ACTIVITIES } from './activities.js';\\n\\n/** Samples from the plan. The bank below is extra. */\\nexport const SAMPLES = [\\n  \\\"Hello! I'm Ounce. Please step on me.\\\",\\n  'Ow.',\\n  \\\"That was a joke. I can't feel pain. I can only keep records.\\\",\\n  'How old do you feel? This is not binding.',\\n  'Your Wobble Age is 68. Is that close? No? I am so sorry.',\\n10→  'Thank you. I have written that down.',\\n  'You wobbled 14 times. I only counted the ones you noticed.',\\n  'Your left side is doing very well. I will let your right side know.',\\n  'No change since yesterday. Which is, in a way, consistent.',\\n  'Excellent. Compared to Dennis.',\\n  \\\"I'm not angry. Scales don't get angry. We get accurate.\\\",\\n  'Have you been stretching? Please do not lie. I am very sensitive.',\\n  \\\"Today's concern: your ankles. I have been concerned all night.\\\",\\n  \\\"Good morning. You look rested. I can't see. But you felt rested.\\\",\\n  'Kevin has been with us eleven years. He has never once held a pose.',\\n20→  'This is a recording. The person in it is doing better than you.',\",\"content_concise\":\"1→import { ACTIVITIES } from './activities.js';\\n\\n/** Samples from the plan. The bank below is extra. */\\nexport const SAMPLES = [\\n  \\\"Hello! I'm Ounce. Please step on me.\\\",\\n  'Ow.',\\n  \\\"That was a joke. I can't feel pain. I can only keep records.\\\",\\n  'How old do you feel? This is not binding.',\\n  'Your Wobble Age is 68. Is that close? No? I am so sorry.',\\n10→  'Thank you. I have written that down.',\\n  'You wobbled 14 times. I only counted the ones you noticed.',\\n  'Your left side is doing very well. I will let your right side know.',\\n  'No change since yesterday. Which is, in a way, consistent.',\\n  'Excellent. Compared to Dennis.',\\n  \\\"I'm not angry. Scales don't get angry. We get accurate.\\\",\\n  'Have you been stretching? Please do not lie. I am very sensitive.',\\n  \\\"Today's concern: your ankles. I have been concerned all night.\\\",\\n  \\\"Good morning. You look rested. I can't see. But you felt rested.\\\",\\n  'Kevin has been with us eleven years. He has never once held a pose.',\\n20→  'This is a recording. The person in it is doing better than you.',\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/data/lines.js\",\"offset\":1,\"limit\":20,\"raw_output\":\"import { ACTIVITIES } from './activities.js';\\n\\n/** Samples from the plan. The bank below is extra. */\\nexport const SAMPLES = [\\n  \\\"Hello! I'm Ounce. Please step on me.\\\",\\n  'Ow.',\\n  \\\"That was a joke. I can't feel pain. I can only keep records.\\\",\\n  'How old do you feel? This is not binding.',\\n  'Your Wobble Age is 68. Is that close? No? I am so sorry.',\\n  'Thank you. I have written that down.',\\n  'You wobbled 14 times. I only counted the ones you noticed.',\\n  'Your left side is doing very well. I will let your right side know.',\\n  'No change since yesterday. Which is, in a way, consistent.',\\n  'Excellent. Compared to Dennis.',\\n  \\\"I'm not angry. Scales don't get angry. We get accurate.\\\",\\n  'Have you been stretching? Please do not lie. I am very sensitive.',\\n  \\\"Today's concern: your ankles. I have been concerned all night.\\\",\\n  \\\"Good morning. You look rested. I can't see. But you felt rested.\\\",\\n  'Kevin has been with us eleven years. He has never once held a pose.',\\n  'This is a recording. The person in it is doing better than you.',\\n\",\"total_lines\":117}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa22-c3bd-7423-a5f1-ddadc552f469","uuid":"169cb264-86e9-4054-90b4-6b05a28596cd"}
{"type":"assistant","message":{"id":"msg_182","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"SAMPLES contains characters like apostrophes and exclamation marks.","signature":""},{"type":"tool_use","id":"call-ed059a3d-ec74-4546-b1e0-8a71f29eec65-54","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/vendor/hub/harness.html","offset":360,"limit":180}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":4108,"output_tokens":175,"cache_read_input_tokens":110976,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa22-c3bd-7423-a5f1-ddadc552f469","uuid":"3d63b0fb-d7d8-4cd4-b799-b66d53519351"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-ed059a3d-ec74-4546-b1e0-8a71f29eec65-54","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"360→$('restart').onclick = () => newRound();\\n$('release').onclick = () => releaseRound();\\n$('timeup').onclick = () => current?.coordinator.timeUp();\\n$('remove').onclick = () => {\\n  const cell = current?.cells.find((c) => c.key === $('who').value);\\n  if (cell) removeCell(cell);\\n};\\n$('hide').onclick = () => {\\n  if (!current) return;\\n  current.hidden = !current.hidden;\\n370→  $('hide').setAttribute('aria-pressed', String(current.hidden));\\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\\n};\\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\\n\\n/* ---------------------------------------------------------------------------\\n * ?auto=1 — the conformance run. It presses keys inside each frame with\\n * synthetic events while the round plays (the frames must be served from this\\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\\n380→ * turns \\\"true\\\".\\n * ------------------------------------------------------------------------- */\\n\\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\nasync function until(test, ms) {\\n  const end = performance.now() + ms;\\n  while (performance.now() < end) {\\n    if (test()) return true;\\n    await sleep(50);\\n  }\\n390→  return test();\\n}\\n\\nfunction poke(cell, key) {\\n  const doc = cell.frame.contentDocument;\\n  const win = cell.frame.contentWindow;\\n  if (!doc || !win) return false;\\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\\n400→  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\\n  return true;\\n}\\n\\nasync function conformance() {\\n  const checks = [];\\n  const check = (name, pass, detail = '') => {\\n    checks.push({ name, pass: !!pass, detail });\\n    renderChecks(checks);\\n    return !!pass;\\n410→  };\\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\\n  window.__hubCheck = report;\\n  try {\\n    const state = await newRound();\\n    if (!state) {\\n      check('game named', false, 'pass ?game=<path> of a page on this site');\\n      return;\\n    }\\n    const n = state.n;\\n420→    const m = state.metas;\\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\\n    const seats = String(m?.players ?? '').match(/\\\\d+/g)?.map(Number) ?? [];\\n    const [least, most = least] = seats;\\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\\n\\n    // Every copy: the players, and in a server round the server's copy.\\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\\n430→    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\\n    if (!helloed) return;\\n    const caps = state.coordinator.seats().map((s) => s.caps);\\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\\n      return;\\n    }\\n\\n440→    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\\n    if (caps.some((c) => c?.card)) {\\n      const players = state.cells.filter((c) => !c.server);\\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\\n      for (const cell of players) poke(cell, 'Enter');\\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\\n450→    }\\n    releaseRound(state);\\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\\n    if (!started || state.record) return;\\n\\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\\n    const randomly = async (ms) => {\\n      const end = performance.now() + ms;\\n460→      while (performance.now() < end && !state.record) {\\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\\n        await sleep(150);\\n      }\\n    };\\n    await randomly(Math.min(1500, playMs / 4));\\n\\n    const mode = state.coordinator.mode;\\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\\n470→    const own = SELF_REPORTED.includes(mode);\\n    const legacyRace = own && !seedsRandom(m?.mode);\\n    if (own && !legacyRace) {\\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\\n    }\\n\\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\\n    else if (n >= 3) removeCell(state.cells[n - 1]);\\n    await randomly(playMs / 2);\\n480→    const remaining = state.cells.filter((c) => !c.gone);\\n    if (own) {\\n      if (mode === 'parallel') {\\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      } else {\\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      }\\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\\n490→        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\\n    } else {\\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\\n    }\\n\\n    if (!state.record) state.coordinator.timeUp();\\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\\n    const record = state.record;\\n    if (serverMode) {\\n500→      // The world ran on the server: the players heard it, and only the host may finish a shared world.\\n      const serverCell = state.cells.find((c) => c.server);\\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\\n    }\\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\\n    } else {\\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\\n    }\\n510→    await sleep(300);\\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\\n    const violations = state.cells.flatMap((c) => {\\n      let extra = [];\\n      try {\\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\\n      } catch {}\\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\\n520→    });\\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\\n  } catch (error) {\\n    check('harness ran', false, String(error?.stack || error));\\n  } finally {\\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\\n    report.done = true;\\n    document.body.dataset.complete = 'true';\\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\\n  }\\n530→}\\n\\nfunction renderChecks(checks) {\\n  $('checklist').replaceChildren(\\n    ...checks.map((c) => {\\n      const li = document.createElement('li');\\n      li.className = c.pass ? 'ok' : 'bad';\\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\\n      li.title = c.detail;\\n      return li;\",\"content_concise\":\"360→$('restart').onclick = () => newRound();\\n$('release').onclick = () => releaseRound();\\n$('timeup').onclick = () => current?.coordinator.timeUp();\\n$('remove').onclick = () => {\\n  const cell = current?.cells.find((c) => c.key === $('who').value);\\n  if (cell) removeCell(cell);\\n};\\n$('hide').onclick = () => {\\n  if (!current) return;\\n  current.hidden = !current.hidden;\\n370→  $('hide').setAttribute('aria-pressed', String(current.hidden));\\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\\n};\\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\\n\\n/* ---------------------------------------------------------------------------\\n * ?auto=1 — the conformance run. It presses keys inside each frame with\\n * synthetic events while the round plays (the frames must be served from this\\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\\n380→ * turns \\\"true\\\".\\n * ------------------------------------------------------------------------- */\\n\\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\nasync function until(test, ms) {\\n  const end = performance.now() + ms;\\n  while (performance.now() < end) {\\n    if (test()) return true;\\n    await sleep(50);\\n  }\\n390→  return test();\\n}\\n\\nfunction poke(cell, key) {\\n  const doc = cell.frame.contentDocument;\\n  const win = cell.frame.contentWindow;\\n  if (!doc || !win) return false;\\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\\n400→  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\\n  return true;\\n}\\n\\nasync function conformance() {\\n  const checks = [];\\n  const check = (name, pass, detail = '') => {\\n    checks.push({ name, pass: !!pass, detail });\\n    renderChecks(checks);\\n    return !!pass;\\n410→  };\\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\\n  window.__hubCheck = report;\\n  try {\\n    const state = await newRound();\\n    if (!state) {\\n      check('game named', false, 'pass ?game=<path> of a page on this site');\\n      return;\\n    }\\n    const n = state.n;\\n420→    const m = state.metas;\\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\\n    const seats = String(m?.players ?? '').match(/\\\\d+/g)?.map(Number) ?? [];\\n    const [least, most = least] = seats;\\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\\n    if (m?.minutes != null) check('hub:ses