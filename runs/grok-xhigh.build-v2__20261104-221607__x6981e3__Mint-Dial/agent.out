jar') return 'Sweat jar';\\n  if (app.mode === 'hammock') return 'Hammock';\\n  if (app.mode === 'about') return 'About';\\n  return app.mode;\\n}\\n\\n1640→function phaseLine(app) {\\n  if (app.mode === 'weigh') return `${app.weigh?.kind || ''} ${Math.floor(app.weigh?.t || 0)}s`;\\n  if (!app.sim) return '';\\n  return `${app.sim.phase} ${Math.floor(app.sim.playT)}s`;\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/app.js\",\"offset\":1440,\"limit\":220,\"raw_output\":\"      seats: this.seats.map((s) => (s ? s.kind : null)),\\n      devTab: this.devTabName(),\\n      phase: this.sim?.phase || this.weigh?.kind || '',\\n      playT: this.sim?.playT || this.weigh?.t || 0,\\n    };\\n  }\\n\\n  draw(ctx) {\\n    const hud = ctx.hud;\\n    if (!hud?.clear) return;\\n    hud.clear();\\n    this.widgets = [];\\n    if (this.hideHud) {\\n      if (hud.visible != null) hud.visible = false;\\n      return;\\n    }\\n    if (hud.visible != null) hud.visible = true;\\n    const view = { hud, app: this, w: hud.width, h: hud.height };\\n    paint(view);\\n  }\\n}\\n\\nfunction clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\\nfunction clamp01(v) { return clamp(v, 0, 1); }\\n\\nfunction marginOf(w) { return w < 200 ? 4 : 12; }\\n\\nfunction paint(view) {\\n  const { hud, app, w, h } = view;\\n  const m = marginOf(w);\\n  const narrow = w < 220;\\n  const scale = narrow ? 1 : 2;\\n  const titleScale = w < 220 ? 2 : w < 400 ? 3 : 4;\\n  let y = m;\\n  const head = (text, sc = titleScale, color = 'white') => {\\n    y = line(view, 'title', text, y, sc, color);\\n  };\\n  if (app.mode === 'title' || app.mode === 'attract') {\\n    hud.rect(0, 0, w, Math.min(h, 78), 'navy');\\n    app.widget('band', 0, 0, w, Math.min(h, 78));\\n    head(TITLE, titleScale, 'cyan');\\n    y = line(view, 'tag', TAGLINE, y, narrow ? 1 : 2, 'sand');\\n    if (app.touchOnly) {\\n      for (const part of wrapText('Controller or keyboard required', Math.max(8, Math.floor((w - m * 2) / (6 * (narrow ? 1 : 2)))))) {\\n        y = line(view, 'touch', part, y, narrow ? 1 : 2, 'sand');\\n      }\\n    }\\n    if (app.mode === 'attract') y = line(view, 'rec', 'Press any button', y, scale, 'sand');\\n  } else if (app.mode === 'card') {\\n    head(TITLE, titleScale, 'cyan');\\n    y = line(view, 'goal', 'Score the most across three events.', y, 1, 'sand');\\n    y = line(view, 'how', 'Stay in the circle.', y, 1, 'white');\\n    const players = app.session?.players || app.hub?.players || [];\\n    players.slice(0, 4).forEach((p, i) => {\\n      y = line(view, `seat-${i}`, `${p.name || 'Guest'}`, y, 1, 'white');\\n    });\\n    const left = app.card?.left;\\n    y = line(view, 'time', left == null ? 'Starting' : `${Math.ceil(left / 1000)}s`, y, scale, 'cyan');\\n    y = line(view, 'ready', 'Enter ready', y, 1, 'sand');\\n  } else {\\n    const title = heading(app);\\n    y = line(view, 'head', title, y, scale, 'cyan');\\n  }\\n  if (app.mode === 'activity' || app.mode === 'weigh' || app.mode === 'attract') {\\n    y = line(view, 'phase', phaseLine(app), y, 1, 'sand');\\n    drawPips(view, app.mode === 'activity' ? (app.sim?.stars || 0) : 0, m, h - m - 10);\\n  }\\n  if (app.mode === 'results') {\\n    y = line(view, 'act', ACTIVITY_BY_ID[app.activityId]?.name || '', y, 1, 'white');\\n    const bits = wrapText(app.dialogue || '', 52).slice(0, 3);\\n    bits.forEach((part, i) => { y = line(view, `line-${i}`, part, y, 1, 'sand'); });\\n    y = line(view, 'drips', `Drips ${app.lastDrips}`, y, scale, 'cyan');\\n    drawPips(view, app.lastStars, m, y);\\n    y += 16;\\n  }\\n  if (app.mode === 'reveal' && app.guest?.chart?.length) {\\n    const last = app.guest.chart[app.guest.chart.length - 1];\\n    y = line(view, 'age', String(last.shown), y, titleScale, 'white');\\n    y = line(view, 'felt', wrapText(app.guest.felt || 'Noted.', 40)[0], y, 1, 'sand');\\n  }\\n  if (app.mode === 'report' && app.guest) {\\n    const last = app.guest.chart[app.guest.chart.length - 1];\\n    y = line(view, 'age', last ? String(last.shown) : '--', y, titleScale, 'white');\\n    const info = dayInfo(app.guest.day);\\n    y = line(view, 'concern', wrapText(`Concern: ${info.concern}`, 40)[0], y, 1, 'sand');\\n  }\\n  if (app.mode === 'confession') {\\n    y = line(view, 'sorry', 'I have been adding seven.', y, 1, 'sand');\\n  }\\n  if (app.mode === 'hammock') {\\n    const guilt = app.guest?.today?.plays ? 'Rest. The day is filed.' : 'The hammock kept the day. The jar did not.';\\n    y = line(view, 'guilt', guilt, y, 1, 'sand');\\n  }\\n  if (app.mode === 'jar' && app.guest) {\\n    y = line(view, 'jar-n', String(app.guest.drips), y, titleScale, 'cyan');\\n    for (const item of milestonesReached(app.guest.drips).slice(0, 4)) y = line(view, item.id, item.name, y, 1, 'white');\\n  }\\n  if (app.mode === 'hall' && app.guest) {\\n    const last = app.guest.chart[app.guest.chart.length - 1];\\n    y = line(view, 'hall-n', last ? String(last.shown) : '--', y, titleScale, 'white');\\n  }\\n  if (app.mode === 'about') {\\n    const pages = aboutPages(CREDITS_TEXT);\\n    const page = pages[Math.min(app.aboutPage, pages.length - 1)];\\n    y = line(view, 'about-h', page.title, y, scale, 'cyan');\\n    page.lines.forEach((text, i) => {\\n      const bits = wrapText(text, narrow ? 26 : 40);\\n      bits.forEach((part, j) => { y = line(view, `about-${i}-${j}`, part, y, 1, 'white'); });\\n    });\\n  }\\n  if (app.mode === 'howto') {\\n    y = line(view, 'how1', 'Lean to keep the dot in the circle.', y, 1, 'white');\\n    y = line(view, 'how2', 'Breathe on the beat. Step on the beat.', y, 1, 'sand');\\n  }\\n  if (app.mode === 'medley' || app.mode === 'podium') {\\n    app.lanes.forEach((lane, i) => {\\n      y = line(view, `lane-${i}`, `${lane.kind} ${Math.round(app.laneTotal(lane))}`, y, 1, 'white');\\n    });\\n  }\\n  if (app.mode === 'join') {\\n    app.seats.forEach((seat, i) => {\\n      y = line(view, `seat-${i}`, seat ? `${i + 1} ${seat.kind}` : `${i + 1} empty`, y, 1, 'sand');\\n    });\\n  }\\n  if (app.overlay) y = line(view, 'overlay', app.status().slice(0, 48), y, 1, 'lime');\\n  const rows = app.rows;\\n  const rowScale = scale;\\n  const rowH = 9 * rowScale + 6;\\n  let ry = Math.min(y + 8, h - m - rows.length * rowH);\\n  if (ry < m) ry = m;\\n  rows.forEach((row, i) => {\\n    const text = String(row.label).slice(0, narrow ? 26 : 34);\\n    const width = measureText(text, rowScale).width;\\n    const x = m + 6 * rowScale;\\n    if (ry + rowH <= h) {\\n      if (i === app.focus) hud.rect(m, ry + 2 * rowScale, 4 * rowScale, 5 * rowScale, 'sand');\\n      app.widget(`row-${row.id}`, m, ry, Math.min(width + 6 * rowScale, w - m * 2), 9 * rowScale);\\n      say(hud, x, ry, text, { scale: rowScale, color: i === app.focus ? 'sand' : 'white' });\\n    }\\n    ry += rowH;\\n  });\\n  const prompt = app.state().prompt;\\n  const py = h - m - 9;\\n  if (py > 0 && py + 9 <= h) {\\n    const pw = Math.min(measureText(prompt, 1).width, Math.max(1, w - m));\\n    app.widget('prompt', m, py, pw, 9);\\n    say(hud, m, py, prompt, { scale: 1, color: 'mist' });\\n  }\\n  if (app.mode === 'title') {\\n    const medical = wrapText(MEDICAL, narrow ? 26 : 46)[0];\\n    say(hud, m, h - m - 20, medical, { scale: 1, color: 'mist' });\\n  }\\n}\\n\\nfunction line(view, id, text, y, scale, color) {\\n  const { hud, app, w, h } = view;\\n  const m = marginOf(w);\\n  const shown = String(text || '').slice(0, 52);\\n  if (!shown || y > h - 8) return y;\\n  const width = measureText(shown, scale).width;\\n  let x = Math.max(m, Math.floor((w - width) / 2));\\n  if (x + width > w - 2) x = m;\\n  app.widget(id, x, y, Math.min(width, w - x), 9 * scale);\\n  say(hud, x, y, shown, { scale, color });\\n  return y + 9 * scale + 3;\\n}\\n\\nfunction drawPips(view, stars, x, y) {\\n  const { hud, app } = view;\\n  for (let i = 0; i < 3; i++) {\\n    hud.rect(x + i * 10, y, 7, 7, i < stars ? 'sand' : 'slate');\\n  }\\n  app.widget('stars', x, y, 28, 7);\\n}\\n\\nfunction heading(app) {\\n  if (app.mode === 'menu') return 'Mint Dial';\\n  if (app.mode === 'weigh') return 'Weigh in';\\n  if (app.mode === 'island') return app.guest ? `Day ${app.guest.day}` : 'Island';\\n  if (app.mode === 'station') return STATIONS.find((s) => s.id === app.station)?.name?.split(' ').slice(0, 3).join(' ') || 'Station';\\n  if (app.mode === 'pause') return 'Paused';\\n  if (app.mode === 'dev') return app.devTabName();\\n  if (app.mode === 'settings') return 'Settings';\\n  if (app.mode === 'name') return 'Your name';\\n  if (app.mode === 'ferry') return 'The ferry';\\n  if (app.mode === 'question') return 'One question';\\n  if (app.mode === 'results') return 'Results';\\n  if (app.mode === 'report') return 'Evening';\\n  if (app.mode === 'confession') return 'A correction';\\n  if (app.mode === 'credits') return 'Credits';\\n  if (app.mode === 'join') return 'Family Hour';\\n  if (app.mode === 'podium') return 'Podium';\\n  if (app.mode === 'locker') return 'Locker';\\n  if (app.mode === 'hall') return 'Hall';\\n  if (app.mode === 'jar') return 'Sweat jar';\\n  if (app.mode === 'hammock') return 'Hammock';\\n  if (app.mode === 'about') return 'About';\\n  return app.mode;\\n}\\n\\nfunction phaseLine(app) {\\n  if (app.mode === 'weigh') return `${app.weigh?.kind || ''} ${Math.floor(app.weigh?.t || 0)}s`;\\n  if (!app.sim) return '';\\n  return `${app.sim.phase} ${Math.floor(app.sim.playT)}s`;\\n}\\n\",\"total_lines\":1644}}","is_error":false},{"type":"tool_result","tool_use_id":"call-28df1741-3454-4ed7-893c-78db311f2007-37","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"230→    private liftOff;\\n    /**\\n     * A kinematic body above the head that closes the gap this step, with the feet on the ground:\\n     * crushed (counted once, until it moves away again).\\n     */\\n    private checkCrush;\\n    /**\\n     * Walking into loose dynamic bodies shoves them (the KCC alone treats every body as a wall):\\n     * the point touched is pushed toward the character's horizontal speed, with at most `shove`\\n     * worth of mass.\\n240→     */\\n    private shoveBodies;\\n    private readonly kccHit;\\n    private readonly rideFeet;\\n    private readonly rideAcc;\\n    private readonly rideP;\\n    private readonly rideRel;\\n    private readonly rideQ;\\n    private readonly rideQ2;\\n    /**\\n250→     * How far up the step the capsule is about to run into this move (0: none). A riser just\\n     * ahead at ankle height, with flat ground on top no higher than the autostep height.\\n     */\\n    private riseAhead;\\n    private loseSpeedToWalls;\\n    /** Change collider height, keeping the feet planted. Growing needs headroom unless forced. */\\n    setStance(stance: Stance, force?: boolean): boolean;\\n    /**\\n     * Drive `model` with `clips`. Call again (e.g. on hot reload) to swap the clip set. With\\n     * the model's `rig`, the procedural layers run too: foot placement on the real ground,\\n260→     * leaning into turns, looking ahead, landing squash (docs/ANIMATION.md).\\n     */\\n    attachModel(model: Object3D, clips: readonly AnimationClip[], rig?: RigSpec): void;\\n    /** Tooling: every clip currently contributing to the pose, with its blend weight and time (s). */\\n    animationMix(): {\\n        name: string;\\n        weight: number;\\n        time: number;\\n        rate: number;\\n    }[];\\n270→    /** Tooling: what foot placement did this frame (weight, pelvis drop, per-foot offsets and locks). */\\n    footPlacement(): FootPlacementState | null;\\n    clipDuration(name: string, fallback: number): number;\\n    /** Name of the clip the current state wants (the table's `anim`). */\\n    animationFor(): AnimRequest;\\n    /** Per render frame: orient the model, pick and advance animation, then the procedural layers. */\\n    updateVisual(model: Object3D, dt: number, alpha: number): void;\\n    /**\\n     * With foot placement, the drawn body stands on the ground under its middle, not on the\\n     * capsule: the capsule's round bottom climbs a step before the body gets there and dips\\n280→     * as it rolls off a step's edge. Slopes are followed exactly; a step (the middle crossing\\n     * a riser) eases over (PopGuard), so stairs are a smooth climb and the feet still land on\\n     * each tread (foot placement).\\n     */\\n    private groundRoot;\\n    /** Foot placement on: a state with feet, on the ground (through brief no-ground moments: autosteps, edges). */\\n    private feetIK;\\n    /** The procedural layers' inputs for this frame (numbers in tuning.ts `visual`). */\\n    private proceduralInput;\\n}\\n\",\"content_concise\":\"230→    private liftOff;\\n    /**\\n     * A kinematic body above the head that closes the gap this step, with the feet on the ground:\\n     * crushed (counted once, until it moves away again).\\n     */\\n    private checkCrush;\\n    /**\\n     * Walking into loose dynamic bodies shoves them (the KCC alone treats every body as a wall):\\n     * the point touched is pushed toward the character's horizontal speed, with at most `shove`\\n     * worth of mass.\\n240→     */\\n    private shoveBodies;\\n    private readonly kccHit;\\n    private readonly rideFeet;\\n    private readonly rideAcc;\\n    private readonly rideP;\\n    private readonly rideRel;\\n    private readonly rideQ;\\n    private readonly rideQ2;\\n    /**\\n250→     * How far up the step the capsule is about to run into this move (0: none). A riser just\\n     * ahead at ankle height, with flat ground on top no higher than the autostep height.\\n     */\\n    private riseAhead;\\n    private loseSpeedToWalls;\\n    /** Change collider height, keeping the feet planted. Growing needs headroom unless forced. */\\n    setStance(stance: Stance, force?: boolean): boolean;\\n    /**\\n     * Drive `model` with `clips`. Call again (e.g. on hot reload) to swap the clip set. With\\n     * the model's `rig`, the procedural layers run too: foot placement on the real ground,\\n260→     * leaning into turns, looking ahead, landing squash (docs/ANIMATION.md).\\n     */\\n    attachModel(model: Object3D, clips: readonly AnimationClip[], rig?: RigSpec): void;\\n    /** Tooling: every clip currently contributing to the pose, with its blend weight and time (s). */\\n    animationMix(): {\\n        name: string;\\n        weight: number;\\n        time: number;\\n        rate: number;\\n    }[];\\n270→    /** Tooling: what foot placement did this frame (weight, pelvis drop, per-foot offsets and locks). */\\n    footPlacement(): FootPlacementState | null;\\n    clipDuration(name: string, fallback: number): number;\\n    /** Name of the clip the current state wants (the table's `anim`). */\\n    animationFor(): AnimRequest;\\n    /** Per render frame: orient the model, pick and advance animation, then the procedural layers. */\\n    updateVisual(model: Object3D, dt: number, alpha: number): void;\\n    /**\\n     * With foot placement, the drawn body stands on the ground under its middle, not on the\\n     * capsule: the capsule's round bottom climbs a step before the body gets there and dips\\n280→     * as it rolls off a step's edge. Slopes are followed exactly; a step (the middle crossing\\n     * a riser) eases over (PopGuard), so stairs are a smooth climb and the feet still land on\\n     * each tread (foot placement).\\n     */\\n    private groundRoot;\\n    /** Foot placement on: a state with feet, on the ground (through brief no-ground moments: autosteps, edges). */\\n    private feetIK;\\n    /** The procedural layers' inputs for this frame (numbers in tuning.ts `visual`). */\\n    private proceduralInput;\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/types/engine/character/PlatformerCharacter.d.ts\",\"offset\":230,\"limit\":80,\"raw_output\":\"    private liftOff;\\n    /**\\n     * A kinematic body above the head that closes the gap this step, with the feet on the ground:\\n     * crushed (counted once, until it moves away again).\\n     */\\n    private checkCrush;\\n    /**\\n     * Walking into loose dynamic bodies shoves them (the KCC alone treats every body as a wall):\\n     * the point touched is pushed toward the character's horizontal speed, with at most `shove`\\n     * worth of mass.\\n     */\\n    private shoveBodies;\\n    private readonly kccHit;\\n    private readonly rideFeet;\\n    private readonly rideAcc;\\n    private readonly rideP;\\n    private readonly rideRel;\\n    private readonly rideQ;\\n    private readonly rideQ2;\\n    /**\\n     * How far up the step the capsule is about to run into this move (0: none). A riser just\\n     * ahead at ankle height, with flat ground on top no higher than the autostep height.\\n     */\\n    private riseAhead;\\n    private loseSpeedToWalls;\\n    /** Change collider height, keeping the feet planted. Growing needs headroom unless forced. */\\n    setStance(stance: Stance, force?: boolean): boolean;\\n    /**\\n     * Drive `model` with `clips`. Call again (e.g. on hot reload) to swap the clip set. With\\n     * the model's `rig`, the procedural layers run too: foot placement on the real ground,\\n     * leaning into turns, looking ahead, landing squash (docs/ANIMATION.md).\\n     */\\n    attachModel(model: Object3D, clips: readonly AnimationClip[], rig?: RigSpec): void;\\n    /** Tooling: every clip currently contributing to the pose, with its blend weight and time (s). */\\n    animationMix(): {\\n        name: string;\\n        weight: number;\\n        time: number;\\n        rate: number;\\n    }[];\\n    /** Tooling: what foot placement did this frame (weight, pelvis drop, per-foot offsets and locks). */\\n    footPlacement(): FootPlacementState | null;\\n    clipDuration(name: string, fallback: number): number;\\n    /** Name of the clip the current state wants (the table's `anim`). */\\n    animationFor(): AnimRequest;\\n    /** Per render frame: orient the model, pick and advance animation, then the procedural layers. */\\n    updateVisual(model: Object3D, dt: number, alpha: number): void;\\n    /**\\n     * With foot placement, the drawn body stands on the ground under its middle, not on the\\n     * capsule: the capsule's round bottom climbs a step before the body gets there and dips\\n     * as it rolls off a step's edge. Slopes are followed exactly; a step (the middle crossing\\n     * a riser) eases over (PopGuard), so stairs are a smooth climb and the feet still land on\\n     * each tread (foot placement).\\n     */\\n    private groundRoot;\\n    /** Foot placement on: a state with feet, on the ground (through brief no-ground moments: autosteps, edges). */\\n    private feetIK;\\n    /** The procedural layers' inputs for this frame (numbers in tuning.ts `visual`). */\\n    private proceduralInput;\\n}\\n\",\"total_lines\":289}}","is_error":false},{"type":"tool_result","tool_use_id":"call-28df1741-3454-4ed7-893c-78db311f2007-38","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"460→    engine.input.setKey('ArrowRight', false);\\n    engine.step(1);\\n    return { mode: app.mode, pos: app.lanes.map((lane) => lane.pos), seats: app.state().seats };\\n  });\\n  log(browserLog, `family ${JSON.stringify(lanes)}`);\\n  if (lanes.mode !== 'medley' || lanes.pos.length < 3) bad(`family lanes ${JSON.stringify(lanes)}`);\\n  if (new Set(lanes.pos.map((n) => Number(n).toFixed(3))).size < 3) bad(`family positions ${lanes.pos.join(',')}`);\\n  if (errors.length) bad(`widget page errors ${errors.join(' | ')}`);\\n  await page.close();\\n}\\n470→\\nasync function shots(browser, fileUrl, scratch, browserLog) {\\n  const page = await browser.newPage({ viewport: { width: 1920, height: 1080 } });\\n  await page.goto(fileUrl);\\n  await waitGame(page);\\n  const dir = path.join(scratch, 'shots');\\n  const title = await grab(page);\\n  if (title.url) writePng(path.join(dir, 'title.png'), title.url);\\n  await page.evaluate(() => {\\n    const app = window.__GAME__;\\n480→    const engine = window.__PIXEL_ENGINE__;\\n    app.setDriver('expert');\\n    app.go('activity', 'tree');\\n    engine.step(40);\\n  });\\n  const activity = await grab(page);\\n  if (activity.url) writePng(path.join(dir, 'activity.png'), activity.url);\\n  await page.evaluate(() => {\\n    const app = window.__GAME__;\\n    window.__PIXEL_ENGINE__.step(1);\\n490→    app.go('island');\\n    window.__PIXEL_ENGINE__.step(2);\\n  });\\n  const island = await grab(page);\\n  if (island.url) writePng(path.join(dir, 'island.png'), island.url);\\n  await page.evaluate(() => {\\n    const app = window.__GAME__;\\n    const engine = window.__PIXEL_ENGINE__;\\n    app.setDriver('expert');\\n    app.go('activity', 'hoop');\\n500→    engine.step(5);\\n    engine.input.setKey('KeyP', true);\\n    engine.step(1);\\n    engine.input.setKey('KeyP', false);\\n    engine.step(1);\\n    const tap = (code) => {\\n      engine.input.setKey(code, true);\\n      engine.step(1);\\n      engine.input.setKey(code, false);\\n      engine.step(1);\\n510→    };\\n    let guard = 0;\\n    while (app.state().row !== 'dev' && guard++ < 10) tap('ArrowDown');\\n    tap('Enter');\\n  });\\n  const dev = await grab(page);\\n  if (dev.url) writePng(path.join(dir, 'pause.png'), dev.url);\\n  log(browserLog, `shots title ${title.mode} activity ${activity.mode} island ${island.mode} dev ${dev.mode}`);\\n  await page.close();\\n}\\n520→\\nasync function missingGpu(launcher, name, fileUrl, problems, browserLog) {\\n  let browser;\\n  try {\\n    browser = await launcher.launch({ headless: true });\\n    const errors = [];\\n    const page = await browser.newPage({ viewport: { width: 390, height: 844 } });\\n    page.on('pageerror', (err) => errors.push(String(err)));\\n    await page.goto(fileUrl);\\n    await page.waitForTimeout(2500);\",\"content_concise\":\"460→    engine.input.setKey('ArrowRight', false);\\n    engine.step(1);\\n    return { mode: app.mode, pos: app.lanes.map((lane) => lane.pos), seats: app.state().seats };\\n  });\\n  log(browserLog, `family ${JSON.stringify(lanes)}`);\\n  if (lanes.mode !== 'medley' || lanes.pos.length < 3) bad(`family lanes ${JSON.stringify(lanes)}`);\\n  if (new Set(lanes.pos.map((n) => Number(n).toFixed(3))).size < 3) bad(`family positions ${lanes.pos.join(',')}`);\\n  if (errors.length) bad(`widget page errors ${errors.join(' | ')}`);\\n  await page.close();\\n}\\n470→\\nasync function shots(browser, fileUrl, scratch, browserLog) {\\n  const page = await browser.newPage({ viewport: { width: 1920, height: 1080 } });\\n  await page.goto(fileUrl);\\n  await waitGame(page);\\n  const dir = path.join(scratch, 'shots');\\n  const title = await grab(page);\\n  if (title.url) writePng(path.join(dir, 'title.png'), title.url);\\n  await page.evaluate(() => {\\n    const app = window.__GAME__;\\n480→    const engine = window.__PIXEL_ENGINE__;\\n    app.setDriver('expert');\\n    app.go('activity', 'tree');\\n    engine.step(40);\\n  });\\n  const activity = await grab(page);\\n  if (activity.url) writePng(path.join(dir, 'activity.png'), activity.url);\\n  await page.evaluate(() => {\\n    const app = window.__GAME__;\\n    window.__PIXEL_ENGINE__.step(1);\\n490→    app.go('island');\\n    window.__PIXEL_ENGINE__.step(2);\\n  });\\n  const island = await grab(page);\\n  if (island.url) writePng(path.join(dir, 'island.png'), island.url);\\n  await page.evaluate(() => {\\n    const app = window.__GAME__;\\n    const engine = window.__PIXEL_ENGINE__;\\n    app.setDriver('expert');\\n    app.go('activity', 'hoop');\\n500→    engine.step(5);\\n    engine.input.setKey('KeyP', true);\\n    engine.step(1);\\n    engine.input.setKey('KeyP', false);\\n    engine.step(1);\\n    const tap