al.readFrom(ctx, this.device.kind, dialLayout(ctx.hud.width, ctx.hud.height), this.tunables.mouseLeanRadius, dt);\"},{\"line_number\":1078,\"content\":\"        else if (lane.kind === 'key') input = lane.driver.readFrom(ctx, 'keyboard', dialLayout(ctx.hud.width, ctx.hud.height), this.tunables.mouseLeanRadius, dt);\"},{\"line_number\":1469,\"content\":\"export function dialLayout(w, h) {\"},{\"line_number\":1499,\"content\":\"    const dial = dialLayout(w, h);\"},{\"line_number\":1505,\"content\":\"    ny = line(view, 'head', exerciseName(app), ny, scale, 'cyan');\"},{\"line_number\":1632,\"content\":\"function exerciseName(app) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/art/clips.js\",\"matches\":[{\"line_number\":45,\"content\":\"  name: 'SquatRep',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/data/activities.js\",\"matches\":[{\"line_number\":13,\"content\":\"  { id: 'squat', name: 'Squats of Regret', station: 'shed', kind: 'reps', clip: 'SquatRep', reps: 10, tempo: 3.2, axis: 'down', unlock: 1, easy: true, song: 'reps', thresholds: [55, 75, 90] },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/drivers.js\",\"matches\":[{\"line_number\":108,\"content\":\"    return { x, y, breath, stepL, stepR, confirm, depth: Math.max(0, -y), useRate: keyboard, rate };\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/sims.js\",\"matches\":[{\"line_number\":253,\"content\":\"    if (u.useRate) {\"},{\"line_number\":259,\"content\":\"      const depth = this.depthOf(u);\"},{\"line_number\":271,\"content\":\"  depthOf(u) {\"}]}]}","is_error":false}]},"par