false, stepR: false, confirm: false, depth: 0 };\"},{\"line_number\":104,\"content\":\"    // Keys cannot hold a depth. S moves a rep one way and W the other, at the target speed.\"},{\"line_number\":106,\"content\":\"    const upKey = input.isDown('KeyW') || input.isDown('ArrowUp');\"},{\"line_number\":107,\"content\":\"    const rate = keyboard ? (downKey ? 1 : 0) - (upKey ? 1 : 0) : 0;\"},{\"line_number\":108,\"content\":\"    return { x, y, breath, stepL, stepR, confirm, depth: Math.max(0, -y), useRate: keyboard, rate };\"},{\"line_number\":142,\"content\":\"      depth: Math.max(0, -dz.y),\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa22-c3bd-7423-a5f1-ddadc552f469","uuid":"86a0f1a2-85c8-47ff-b144-1dcbfeffaffe"}
