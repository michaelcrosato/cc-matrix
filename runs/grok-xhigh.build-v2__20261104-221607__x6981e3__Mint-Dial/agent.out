s)}`);\"},{\"line_number\":191,\"content\":\"    const lunge = hold('lunge', right, 0.5);\"},{\"line_number\":192,\"content\":\"    const press = hold('press', up, 0.5);\"},{\"line_number\":195,\"content\":\"    const idle = hold('lunge', read('pad', { x: 0, y: 0 }), 0.5);\"},{\"line_number\":196,\"content\":\"    const pressRight = hold('press', right, 0.5);\"},{\"line_number\":197,\"content\":\"    assert(lunge > 0.5, `lunge r ${lunge}`);\"},{\"line_number\":198,\"content\":\"    assert(press > 0.5, `press r ${press}`);\"},{\"line_number\":202,\"content\":\"    assert(pressRight < 0.08, `press ignored right ${pressRight}`);\"},{\"line_number\":362,\"content\":\"      assert(world.poseName === 'SquatRep', `pose ${world.poseName}`);\"},{\"line_number\":369,\"content\":\"      assert(shown.widgets.some((w) => w.id === 'dial'), 'dial widget');\"},{\"line_number\":371,\"content\":\"      const dial = shown.widgets.find((w) => w.id === 'dial');\"},{\"line_number\":374,\"content\":\"      assert(dial.x >= -1 && dial.y >= -1 && dial.x + dial.w <= hudW + 1 && dial.y + dial.h <= hudH + 1, `dial box ${dial.x},${dial.y} ${dial.w}x${dial.h} hud ${hudW}x${hudH}`);\"},{\"line_number\":503,\"content\":\"      const lineBefore = app.dialogue;\"},{\"line_number\":505,\"content\":\"      assert(app.dialogue && app.dialogue !== lineBefore, 'line');\"},{\"line_number\":587,\"content\":\"          buttons: [{ pressed: true, value: 1 }, ...Array.from({ length: 15 }, () => ({ pressed: false, value: 0 }))],\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa22-c3bd-7423-a5f1-ddadc552f469","uuid":"3e733895-87fe-45a7-b7af-860fc41ea78a"}
