c () => {\"},{\"line_number\":463,\"content\":\"    await test('attract, touch gate, session card', async () => {\"},{\"line_number\":509,\"content\":\"    await test('family hour and medley ghost', async () => {\"},{\"line_number\":564,\"content\":\"    await test('hub clock progress and result', async () => {\"},{\"line_number\":569,\"content\":\"        emit(ev, arg) { (handlers[ev] || []).forEach((fn) => fn(arg)); },\"},{\"line_number\":579,\"content\":\"        hub.emit('start');\"},{\"line_number\":593,\"content\":\"        hub.emit('time-up');\"},{\"line_number\":594,\"content\":\"        hub.emit('time-up');\"},{\"line_number\":596,\"content\":\"        hub.emit('end');\"},{\"line_number\":599,\"content\":\"        hub.emit('end');\"},{\"line_number\":604,\"content\":\"    await test('saves, corrupt storage, scripted week', async () => {\"},{\"line_number\":692,\"content\":\"      visit('plaza');\"},{\"line_number\":693,\"content\":\"      visit('jog');\"},{\"line_number\":754,\"content\":\"    await test('replay fingerprint', async () => {\"},{\"line_number\":770,\"content\":\"    await test('browser, shots, and hub', async () => {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa22-c3bd-7423-a5f1-ddadc552f469","uuid":"4cf41eb2-f516-40ce-b66d-af77ab7b44fd"}
