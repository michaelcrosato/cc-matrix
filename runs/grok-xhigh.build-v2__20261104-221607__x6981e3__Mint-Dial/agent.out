INE__.game;\\n    const state = app.state();\\n    return {\\n      mode: state.mode,\\n      name: state.activityName,\\n      pose: world?.poseName || '',\\n      time: world?.poseTime || 0,\\n      shot: world?.shot || '',\\n      dial: state.widgets.some((w) => w.id === 'dial'),\\n      head: state.widgets.some((w) => w.id === 'head'),\\n    };\\n  });\\n  log(browserLog, `activity pose ${JSON.stringify(pose)}`);\\n  if (pose.name !== 'Squats of Regret') bad(`activity name ${pose.name}`);\\n  if (pose.pose !== 'SquatRep' || pose.time <= 0.05) bad(`activity clip ${pose.pose} ${pose.time}`);\\n  if (!pose.dial || !pose.head) bad(`activity hud dial ${pose.dial} head ${pose.head}`);\\n  if (pose.shot !== 'play') bad(`activity camera ${pose.shot}`);\\n  await page.evaluate(() => {\\n    const app = window.__GAME__;\\n    window.__PIXEL_ENGINE__.step(1);\\n    app.go('island');\\n    window.__PIXEL_ENGINE__.step(2);\\n  });\\n  const island = await grab(page);\\n  if (island.url) writePng(path.join(dir, 'island.png'), island.url);\\n  await page.evaluate(() => {\\n    const app = window.__GAME__;\\n    const engine = window.__PIXEL_ENGINE__;\\n    app.setDriver('expert');\\n    app.go('activity', 'hoop');\\n    engine.step(5);\\n    engine.input.setKey('KeyP', true);\\n    engine.step(1);\\n    engine.input.setKey('KeyP', false);\\n    engine.step(1);\\n    const tap = (code) => {\\n      engine.input.setKey(code, true);\\n      engine.step(1);\\n      engine.input.setKey(code, false);\\n      engine.step(1);\\n    };\\n    let guard = 0;\\n    while (app.state().row !== 'dev' && guard++ < 10) tap('ArrowDown');\\n    tap('Enter');\\n  });\\n  const dev = await grab(page);\\n  if (dev.url) writePng(path.join(dir, 'pause.png'), dev.url);\\n  log(browserLog, `shots title ${title.mode} activity ${activity.mode} island ${island.mode} dev ${dev.mode}`);\\n  await page.close();\\n}\\n\\nasync function missingGpu(launcher, name, fileUrl, problems, browserLog) {\\n  let browser;\\n  try {\\n    browser = await launcher.launch({ headless: true });\\n    const errors = [];\\n    const page = await browser.newPage({ viewport: { width: 390, height: 844 } });\\n    page.on('pageerror', (err) => errors.push(String(err)));\\n    await page.goto(fileUrl);\\n    await page.waitForTimeout(2500);\\n    const text = await page.evaluate(() => document.body ? document.body.innerText : '');\\n    log(browserLog, `${name} ${text.slice(0, 240)} pageerrors ${errors.join(' | ')}`);\\n    if (!text.includes('Failed to start: WebGPU unavailable')) problems.push(`${name} missing WebGPU message`);\\n    if (errors.length) problems.push(`${name} pageerror ${errors.join(' | ')}`);\\n    await page.close();\\n  } catch (err) {\\n    problems.push(`${name} ${err?.message || err}`);\\n  } finally {\\n    if (browser) await browser.close();\\n  }\\n}\\n\",\"total_lines\":559}}","is_error":false},{"type":"tool_result","tool_use_id":"call-6923d22b-da01-4f2d-9d0e-adf19fc07bbd-25","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,49,54,48,55,95,95,120,54,57,56,49,101,51,47,119,111,114,107,34,62,10,70,111,117,110,100,32,50,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,49,54,48,55,95,95,120,54,57,56,49,101,51,47,119,111,114,107,47,77,105,110,116,32,68,105,97,108,45,87,105,105,32,70,105,116,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,49,54,48,55,47,112,105,12