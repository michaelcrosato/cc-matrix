nt\":\"      action.time = Math.min(1, Math.max(0, this.app.sim.r)) * dur;\"},{\"line_number\":266,\"content\":\"    this.poseTime = action.time;\"},{\"line_number\":325,\"content\":\"      ctx.engine.setCamera({ ...CAMERA }, { syncUrl: false });\"},{\"line_number\":332,\"content\":\"    ctx.engine.setCamera({\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/app.js\",\"matches\":[{\"line_number\":173,\"content\":\"    this.viewerClip = '';\"},{\"line_number\":174,\"content\":\"    this.dialogue = '';\"},{\"line_number\":406,\"content\":\"    if (id === 'anim') return `Anim ${this.viewerClip || 'idle'}`;\"},{\"line_number\":518,\"content\":\"    this.dialogue = lineText(id, stars, (this.guest?.records?.[id]?.plays || 0) > 1);\"},{\"line_number\":895,\"content\":\"      try { this.engine?.setCamera({ preset: 'free' }, { syncUrl: false }); } catch { /* no rig */ }\"},{\"line_number\":899,\"content\":\"      this.dialogue = ['Stand.', 'The circle noticed.', 'See you tomorrow. Bring your knees.'][this.linePick];\"},{\"line_number\":913,\"content\":\"      this.viewerClip = names[this.animPick];\"},{\"line_number\":1022,\"content\":\"      const input = this.driver ? this.sim.auto(dt) : this.local.readFrom(ctx, this.device.kind, dialLayout(ctx.hud.width, ctx.hud.height), this.tunables.mouseLeanRadius, dt);\"},{\"line_number\":1026,\"content\":\"      const input = this.driver ? this.weigh.auto(dt) : this.local.readFrom(ctx, this.device.kind, dialLayout(ctx.hud.width, ctx.hud.height), this.tunables.mouseLeanRadius, dt);\"},{\"line_number\":1078,\"content\":\"        else if (lane.kind === 'key') input = lane.driver.readFrom(ctx, 'keyboard', dialLayout(ctx.hud.width, ctx.hud.height), this.tunables.mouseLeanRadius, dt);\"},{\"line_number\":1269,\"content\":\"    if (this.mode === 'results') { line = this.dialogue; speaker = 'ounce'; }\"},{\"line_number\":1275,\"content\":\"    } else if (this.mode === 'dev' && this.dialogue) { line = this.dialogue; speaker = 'coach'; }\"},{\"line_number\":1427,\"content\":\"      dialogue: this.dialogue,\"},{\"line_number\":1428,\"content\":\"      viewerClip: this.viewerClip,\"},{\"line_number\":1468,\"content\":\"/** The balance dial. Centre (W/2, 56) and radius 44 on a full HUD. Lean is measured from this point. */\"},{\"line_number\":1469,\"content\":\"export function dialLayout(w, h) {\"},{\"line_number\":1499,\"content\":\"    const dial = dialLayout(w, h);\"},{\"line_number\":1500,\"content\":\"    drawDial(view, dial);\"},{\"line_number\":1501,\"content\":\"    if (app.sim?.def?.kind === 'reps') drawRepTrack(view, dial);\"},{\"line_number\":1526,\"content\":\"    const bits = wrapText(app.dialogue || '', 52).slice(0, 3);\"},{\"line_number\":1641,\"content\":\"function drawDial(view, dial) {\"},{\"line_number\":1644,\"content\":\"  const ring = Math.max(2, Math.round(dial.radius * 0.08));\"},{\"line_number\":1645,\"content\":\"  ringAt(hud, dial.x, dial.y, dial.radius, ring, 'white', 32);\"},{\"line_number\":1647,\"content\":\"  ringAt(hud, dial.x, dial.y, Math.max(ring + 2, dial.radius * zone), ring, 'sand', 24);\"},{\"line_number\":1648,\"content\":\"  const dx = (dot?.x || 0) * dial.radius;\"},{\"line_number\":1649,\"content\":\"  const dy = (dot?.y || 0) * dial.radius;\"},{\"line_number\":1651,\"content\":\"  hud.rect(dial.x + dx - s / 2, dial.y - dy - s / 2, s, s, 'red');\"},{\"line_number\":1652,\"content\":\"  app.widget('dial', dial.x - dial.radius, dial.y - dial.radius, dial.radius * 2, dial.radius * 2);\"},{\"line_number\":1653,\"content\":\"  app.widget('dot', dial.x + dx - s / 2, dial.y - dy - s / 2, s, s);\"},{\"line_number\":1670,\"content\":\"function drawRepTrack(view, dial) {\"},{\"line_number\":1678,\"content\":\"  const x = Math.min(w - 16, dial.x + dial.radius + 16);\"},{\"line_number\":1679,\"content\":\"  const top = Math.max(8, dial.y - dial.radius);\"},{\"line_number\":1680,\"content\":\"  const height = Math.max(8, Math.min(dial.radius * 2, h - top - 8));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/main.js\",\"matches\":[{\"line_number\":47,\"content\":\"      settings: { button: touchOnly ? 'top-right' : false, key: 'mint-dial' },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/save.js\",\"matches\":[{\"line_number\":2,\"content\":\"export const SAVE_KEY = 'mint-dial-save-v1';\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/core/drivers.js\",\"matches\":[{\"line_number\":71,\"content\":\"   * stick: moveAxis. keys: WASD/arrows. mouse: offset from the dial, a force.\"},{\"line_number\":73,\"content\":\"  readFrom(ctx, device, dial, radius, dt) {\"},{\"line_number\":83,\"content\":\"      const ox = (ax - dial.x) / radius;\"},{\"line_number\":84,\"content\":\"      const oy = (dial.y - ay) / radius;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/data/lines.js\",\"matches\":[{\"line_number\":79,\"content\":\"  ['ounce', 'Kevin sat on me. The dial read 7. We left it there.'],\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/data/week.js\",\"matches\":[{\"line_number\":42,\"content\":\"    beat: 'Kevin sits on the scale. The dial reads 7. Nobody says anything.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-221607__x6981e3/work/Mint Dial-Wii Fit-grok-4.7-xhigh-20261104-221607/src/art/clips.js\",\"matches\":[{\"line_number\":93,\"content\":\"export const CLIPS = [tree, heron, warrior, 