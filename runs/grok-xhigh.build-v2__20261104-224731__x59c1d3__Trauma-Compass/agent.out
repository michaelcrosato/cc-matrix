world: World<C, E>,\\n  placement: PropPlacement,\\n  options: SpawnPropOptions = {},\\n): number {\\n  const w = world as unknown as World;\\n  const entry = getProp(placement.prop);\\n  const prop = entry.id;\\n  const spec = propBody({ ...placement, prop }, undefined, options.as);\\n  const { position, rotation } = spec ?? propPose({ ...placement, prop });\\n  const body = spec ? physicsOf(w).addBody(spec) : -1;\\n  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\\n  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\\n  const [x, y, z] = position;\\n  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\\n  const switchable = options.on !== undefined || options.group !== undefined;\\n  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\\n  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\\n}\\n\\n/** The entity whose prop `body` is (a `sceneProp`'s), or −1: the body-to-entity lookup uses and hits read (WP 13.16). */\\nexport function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\\n  if (body < 0) return -1;\\n  const props = (world as unknown as World).query('sceneProp') as unknown as (ScenePropComponents & { id: number })[];\\n  return props.find((e) => e.sceneProp.body === body)?.id ?? -1;\\n}\\n\\n/** The entity whose body is `body` (a body id; −1 for none): a prop's (`propOfBody`), else an actor's; −1 for neither. */\\nexport function entityOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\\n  const prop = propOfBody(world, body);\\n  if (prop >= 0 || body < 0) return prop;\\n  const actors = (world as unknown as World).query('actor') as unknown as { id: number; actor: { body: number } }[];\\n  return actors.find((e) => e.actor.body === body)?.id ?? -1;\\n}\\n\\n/** Removes a prop: its entity and its body, its component's `body` −1 at once (inside a step the entity stays to its end). Throws `SIM_BAD_ARGUMENT` for an id that is no prop. */ // prettier-ignore\\nexport function removeProp<C extends object, E extends EventMap>(world: World<C, E>, id: number): void {\\n  const w = world as unknown as World;\\n  const data = propOf(w, id, 'removeProp(w, id)');\\n  if (data.body >= 0) physicsOf(w).removeBody(data.body);\\n  data.body = -1; // inside a step its entity stays to the step's end: nothing reads the body it no longer has\\n  w.despawn(id);\\n}\\n\\n/**\\n * Hits the prop `id` from `from` (m): calls its `hit` hook, whose `knock(more)` knocks its body away from `from` with\\n * `strength` under `more` (engine/physics/bodies.ts's `knock`: 4.6875 m/s across, 2.5 m/s up, no twist by default).\\n * Draw `spin` from a sim stream (`w.rng('knock').range(-0.5, 0.5)`). Throws `SIM_BAD_ARGUMENT` for an id that is no prop.\\n\",\"total_lines\":222}}","is_error":false},{"type":"tool_result","tool_use_id":"call-86a0dda8-2676-45aa-a865-ff6110b31a37-34","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"90→    parts: [\\n      { name: 'leaf', geometry: 'geometry:box', params: { width: 0.9, height: 2.05, depth: 0.045 }, material: 'material:planks' }, // prettier-ignore\\n      ...[0.25, 0.95, 1.7].map((y, i) => ({ name: `strap${i + 1}`, geometry: 'geometry:box', params: { width: 0.84, height: 0.06, depth: 0.01 }, material: 'material:iron', position: [0, y, 0.0275] })), // prettier-ignore\\n      { name: 'pull', geometry: 'geometry:ring', params: { innerRadius: 0.035, outerRadius: 0.05, height: 0.012, radialSegments: 12 }, material: 'material:iron', position: [0.34, 1, 0.0225], rotation: [QUARTER, 0, 0] }, // prettier-ignore\\n    ],\\n    body: { type: 'kinematic', shape: 'box', size: [0.9, 2.05, 0.045] },\\n    breaks: { shards: 'splinters' },\\n  },\\n  'prop:table': {\\n    description: 'A trestle table of planks, 1.6 × 0.9 m and 0.75 m high, its top on two slab legs. 30 kg.',\\n100→    parts: [\\n      { name: 'top', geometry: 'geometry:box', params: { width: 1.6, height: 0.05, depth: 0.9 }, material: 'material:planks', position: [0, 0.7, 0] }, // prettier-ignore\\n      { name: 'legWest', geometry: 'geometry:box', params: { width: 0.06, height: 0.7, depth: 0.8 }, material: 'material:planks', position: [-0.7, 0, 0] }, // prettier-ignore\\n      { name: 'legEast', geometry: 'geometry:box', params: { width: 0.06, height: 0.7, depth: 0.8 }, material: 'material:planks', position: [0.7, 0, 0] }, // prettier-ignore\\n    ],\\n    body: { type: 'dynamic', shape: 'box', size: [1.6, 0.75, 0.9], density: 28 },\\n    place: { spawn: 'table' },\\n  },\\n  'prop:bench': {\\n    description: 'A plank bench, 1.4 m long, 0.35 m deep and 0.45 m high, its seat on two slab legs. 15 kg.',\\n110→    parts: [\\n      { name: 'seat', geometry: 'geometry:box', params: { width: 1.4, height: 0.05, depth: 0.35 }, material: 'material:planks', position: [0, 0.4, 0] }, // prettier-ignore\\n      { name: 'legWest', geometry: 'geometry:box', params: { width: 0.05, height: 0.4, depth: 0.3 }, material: 'material:planks', position: [-0.55, 0, 0] }, // prettier-ignore\\n      { name: 'legEast', geometry: 'geometry:box', params: { width: 0.05, height: 0.4, depth: 0.3 }, material: 'material:planks', position: [0.55, 0, 0] }, // prettier-ignore\\n    ],\\n    body: { type: 'dynamic', shape: 'box', size: [1.4, 0.45, 0.35], density: 68 },\\n    place: { spawn: 'bench' },\\n  },\\n  'prop:statue': {\\n    description: 'A stone statue of a robed figure, its arms at its sides, 2.2 m high on its plinth. It never moves.',\\n120→    parts: [\\n      { name: 'plinth', geometry: 'geometry:box', params: { width: 0.8, height: 0.5, depth: 0.8 }, material: 'material:stone' }, // prettier-ignore\\n      { name: 'robe', geometry: 'geometry:frustum', params: { radiusBottom: 0.3, radiusTop: 0.18, hei