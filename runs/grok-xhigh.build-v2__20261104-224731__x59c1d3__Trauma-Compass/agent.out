are long and steps cheap',\"},{\"line_number\":75,\"content\":\"  'time.maxSteps': {\"},{\"line_number\":153,\"content\":\"  /** Whole steps dropped after a stall, beyond `time.maxSteps`. */\"},{\"line_number\":212,\"content\":\"/** How a clock is made. `hz` and `maxSteps` are set on the store; a store over another registry needs TIME_SETTINGS. */\"},{\"line_number\":216,\"content\":\"  /** Sets `time.maxSteps`: the most steps one frame runs. */\"},{\"line_number\":217,\"content\":\"  maxSteps?: number;\"},{\"line_number\":231,\"content\":\"  if (options.maxSteps !== undefined) settings.set('time.maxSteps', options.maxSteps);\"},{\"line_number\":312,\"content\":\"        const maxSteps = get('time.maxSteps');\"},{\"line_number\":313,\"content\":\"        if (steps > maxSteps) [lost, steps] = [steps - maxSteps, maxSteps];\"},{\"line_number\":315,\"content\":\"        if (behind === BEHIND_FRAMES) out.warnOnce('CORE_CLOCK_BEHIND', { frames: BEHIND_FRAMES, maxSteps });\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"e234faa2-4e8a-48fe-950f-590194d06388"}
