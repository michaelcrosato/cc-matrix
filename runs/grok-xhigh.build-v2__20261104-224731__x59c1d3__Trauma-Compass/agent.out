* Ticks left in the green band window bookkeeping. The band itself is a function of the tick. */\\n  shocks: number;\\n}\\n\\n/** The whole operation. */\\nexport interface Op {\\n  id: string;\\n  title: string;\\n290→  seed: number;\\n  difficulty: Difficulty;\\n  tick: number;\\n  /** Field ticks elapsed. */\\n  field: number;\\n  /** Field ticks left on the clock. */\\n  clock: number;\\n  clockMax: number;\\n  slips: number;\\n  slipLimit: number;\\n300→  slipDefault: number;\\n  status: 'playing' | 'won' | 'lost';\\n  fail: string;\\n  phase: number;\\n  phases: PhaseDef[];\\n  sites: { id: string; name: string }[];\\n  patients: Patient[];\\n  seats: Seat[];\\n  targets: Target[];\\n  nextId: number;\\n310→  code: CodeState | null;\\n  balance: Balance;\\n  attract: boolean;\\n  /** Dev Mode: vitals do not fall. */\\n  holdVitals: boolean;\\n  /** Dev Mode: the clock does not fall. */\\n  holdClock: boolean;\\n  /** A radial menu is open on some seat. */\\n  radial: boolean;\\n  simple: boolean;\\n320→  colleague: boolean;\\n  /** What the AI colleague is doing, for the view. */\\n  helper: string;\\n  roll: boolean;\\n  swapOk: boolean;\\n  persona: string;\\n  events: GameEvent[];\\n  injected: boolean;\\n  giftUsed: boolean;\\n  codeCleared: boolean;\\n330→  teach: string;\\n  hint: string;\\n  par: number;\\n  codeAllowed: boolean;\\n  /** Mercy bookkeeping: motes killed, kindness round, exposed ticks, guide motion phase. */\\n  mercyKills: number;\\n  mercyRound: number;\\n  mercyExposed: number;\\n  mercyBindSpawned: boolean;\\n  lastBind: number;\\n340→  bestChain: number;\\n  score: number;\\n}\\n\\n/** A postcard line per rank. */\\nexport interface Postcards {\\n  S: string;\\n  A: string;\\n  B: string;\\n  C: string;\\n350→}\\n\\n/** One story case, or the session case. */\\nexport interface CaseDef {\\n  id: string;\\n  title: string;\\n  surgeon: string;\\n  seconds: number;\\n  gift: 'stillpoint' | 'second' | 'none';\\n  charges: number;\\n360→