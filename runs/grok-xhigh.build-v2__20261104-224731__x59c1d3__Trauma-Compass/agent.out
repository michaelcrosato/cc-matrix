e is open.', kind: 'mercy' });\"},{\"line_number\":204,\"content\":\"    } else if (motes.length < 6 && op.mercyKills < 6) {\"},{\"line_number\":205,\"content\":\"      op.mercyRound += ft;\"},{\"line_number\":206,\"content\":\"      if (op.mercyRound >= 8 * FIELD_SECOND) {\"},{\"line_number\":207,\"content\":\"        op.mercyRound = 0;\"},{\"line_number\":208,\"content\":\"        const angle = op.mercyKills + motes.length;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/world.ts\",\"matches\":[{\"line_number\":10,\"content\":\"const UNIQUE_KIND = new Set(['matron', 'mercy', 'reverie', 'balmNode', 'flap', 'solace']);\"},{\"line_number\":179,\"content\":\"  } else if (target.kind === 'mercy') {\"},{\"line_number\":397,\"content\":\"    mercyKills: 0,\"},{\"line_number\":398,\"content\":\"    mercyRound: 0,\"},{\"line_number\":399,\"content\":\"    mercyExposed: 0,\"},{\"line_number\":400,\"content\":\"    mercyBindSpawned: false,\"},{\"line_number\":509,\"content\":\"  if (phase.onEnter === 'mercy-expose') op.mercyExposed = 1;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/casesLate.ts\",\"matches\":[{\"line_number\":170,\"content\":\"    id: 'case:mercy',\"},{\"line_number\":209,\"content\":\"        'mercy-motes',\"},{\"line_number\":217,\"content\":\"        'mercy-kindness',\"},{\"line_number\":225,\"content\":\"        'mercy-rakes',\"},{\"line_number\":232,\"content\":\"      phase('mercy-kindness-2', 'She does it again.', 'code', [], 'flatline', 'Same band. Same two tries.'),\"},{\"line_number\":234,\"content\":\"        'mercy-rakes-2',\"},{\"line_number\":242,\"content\":\"        'mercy-rites',\"},{\"line_number\":250,\"content\":\"        'mercy-tendrils',\"},{\"line_number\":258,