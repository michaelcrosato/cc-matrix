ch(hand, seat, target.x, target.z, op.balance.cursor);\"},{\"line_number\":229,\"content\":\"  approach(hand, seat, target.x, target.z, op.balance.cursor);\"},{\"line_number\":238,\"content\":\"  approach(hand, seat, target.x + leg * span, target.z, op.balance.cursor);\"},{\"line_number\":245,\"content\":\"  approach(hand, seat, target.x, target.z, op.balance.cursor);\"},{\"line_number\":252,\"content\":\"  approach(hand, seat, target.x, target.z, op.balance.cursor);\"},{\"line_number\":253,\"content\":\"  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < op.balance.gel * 0.75;\"},{\"line_number\":259,\"content\":\"  approach(hand, seat, target.x, target.z, op.balance.cursor);\"},{\"line_number\":266,\"content\":\"  approach(hand, seat, 0, 2.2, op.balance.cursor);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/scenes/tune.ts\",\"matches\":[{\"line_number\":21,\"content\":\"  { setting: 'game.vitalsDrain', key: 'vitalsDrain', min: 0, max: 3, step: 0.05, fallback: 1, label: 'Vitals drain' },\"},{\"line_number\":71,\"content\":\"  { setting: 'game.radialSlow', min: 0.1, max: 1, step: 0.05, fallback: 0.6, label: 'Radial slow' },\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"6a77ca47-dc57-40ce-8525-4fa8528972b8"}
