     'The doses only land while the Gift is up.',\\n      ),\\n      phase('mercy-final', 'Restart the heart.', 'code', [], 'flatline', 'Every paddle. Then we are done.'),\\n650→    ],\\n  },\\n  {\\n    id: 'case:gala-shift',\\n    title: 'The Gala Shift',\\n    surgeon: 'Wren',\\n    seconds: 270,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: false,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/cases.ts\",\"offset\":640,\"limit\":20,\"raw_output\":\"      ),\\n      phase(\\n        'mercy-bind',\\n        'A Gift, then three doses inside it.',\\n        'clear',\\n        [-0.7, 0, 0.7].map((x) => ({ kind: 'binder' as const, x, z: -0.3, doseNeed: 1, tag: 'gift' })),\\n        '',\\n        'The doses only land while the Gift is up.',\\n      ),\\n      phase('mercy-final', 'Restart the heart.', 'code', [], 'flatline', 'Every paddle. Then we are done.'),\\n    ],\\n  },\\n  {\\n    id: 'case:gala-shift',\\n    title: 'The Gala Shift',\\n    surgeon: 'Wren',\\n    seconds: 270,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: false,\\n\",\"total_lines\":741}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"65ba1c9f-c8bf-45e5-a337-e63271d403d4"}
{"type":"assistant","message":{"id":"msg_770","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The first step is splitting case data into two files in cases.ts.\n\ncaseBuild.ts will hold the helper functions. casesEarly.ts will contain the first 340 lines of case objects. casesLate.ts will contain the next 337 lines. cases.ts will keep the concatenation logic and exports.\n\nThe `CASES` export will use a spread of `EARLY` and `LATE` with the existing `readonly CaseDef[]` type. `PhaseDef`, `Spawn`, and `Postcards` must be exported from `caseBuild.ts`. The exact line boundaries for the split still need to be confirmed.\n\nA script will split the case file mechanically to avoid typos. In campaign.ts, items, settingsItems, and devItems will move to campaignMenus.ts. The items function is exported and used by campaign.ts itself, so it needs a re-export wrapper in campaign.ts.\n\ncampaign.ts will import items from campaignMenus.ts and re-export it with `export { items };`. This avoids a duplicate import. campaignMenus.ts will also need to export the Campaign and Item types.\n\nA circular import would occur if campaignMenus.ts imported Campaign and Item from campaign.ts while campaign.ts imported items from campaignMenus.ts. Using `import type` for those types in campaignMenus.ts breaks the cycle, since type-only imports are erased at runtime.\n\nThe split removes about 114 lines from campaign.ts and adds roughly two import lines. The file shrinks to about 517 lines, which is well under the 400 limit. campaignMenus.ts will be around 130 lines, also safely under the cap.\n\nround.js is only 3 lines over the limit. JSDoc comments are unlikely to be tested for line count. The smallest safe cut is removing blank lines that aren't structural. A script will locate all blank line positions.","signature":""},{"type":"tool_use","id":"call-6bf8c597-0ea4-45f6-b8c6-ae7446cdc5de-17","name":"grep","input":{"pattern":"from ['\\\"].*hub/round|require\\(.*round","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731","glob":"*.{js,mjs,ts,html}"}},{"type":"tool_use","id":"call-6bf8c597-0ea4-45f6-b8c6-ae7446cdc5de-18","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/tools/hub/round.js","offset":1,"limit":200}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":2766,"output_tokens":1413,"cache_read_input_tokens":47872,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"7ddbc123-858c-413f-86b3-dea9965a3cdb"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-6bf8c597-0ea4-45f6-b8c6-ae7446cdc5de-17","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,55,51,49,95,95,120,53,57,99,49,100,51,47,119,111,114,107,34,62,10,78,111,32,109,97,116,99,104,101,115,32,102,111,117,110,100,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":1,\"match_count\":0,\"file_matches\":[]}","is_error":false},{"type":"tool_result","tool_use_id":"call-6bf8c597-0ea4-45f6-b8c6-ae7446cdc5de-18","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file round.js — one round of an AI Hub session, run by the hub that coordinates\\n * it (the harness page, or the session host's tab).\\n *\\n * It never touches the network or a frame itself: every message for a game\\n * goes out through `deliver(key, msg)`, and everything the games report comes\\n * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\\n * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\\n * without waiting for one.\\n10→ *\\n * Players are known by `key` (whatever the session calls them); games see\\n * contiguous ids 0..N-1 in slot order.\\n */\\n\\nexport const TIMINGS = Object.freeze({\\n  helloMs: 10_000,\\n  readyMs: 45_000,\\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\\n  loadGraceMs: 20_000,\\n20→  countdownMs: 3_000,\\n  graceMs: 5_000,\\n  hiddenMs: 20_000,\\n  maxRoundMs: 15 * 60_000,\\n});\\n\\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\\n\\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\\n30→\\n/** Each mode's name on screen. */\\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\\n\\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\\n\\n/** The mode a tag or a hello names, older tags included; null for anything else. */\\nexport function modeOf(word) {\\n  const w = String(word ?? '')\\n40→    .trim()\\n    .toLowerCase();\\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\\n}\\n\\n/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\\nexport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\\n\\n/**\\n * Whether a game's round carries the seed in its address, so the client seeds\\n50→ * Math.random and every copy starts the same: read from the game's own tag,\\n * parallel or ghost. A game still tagged race was built for an unseeded start\\n * (ids it makes from Math.random must differ between its copies), so it keeps one.\\n */\\nexport const seedsRandom = (tag) =>\\n  ['parallel', 'ghost'].includes(\\n    String(tag ?? '')\\n      .trim()\\n      .toLowerCase(),\\n  );\\n60→\\nconst REAL_CLOCK = {\\n  now: () => Date.now(),\\n  setTimeout: (fn, ms) => setTimeout(fn, ms),\\n  clearTimeout: (handle) => clearTimeout(handle),\\n};\\n\\n/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\\nexport function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\\n  const typical = Number(minutes);\\n70→  if (!(typical > 0)) return maxRoundMs;\\n  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\\n}\\n\\n/**\\n * Parallel and ghost order: finishers by time, then the rest by score,\\n * then anyone who reported nothing, tied last. Equal times or scores share a\\n * place.\\n */\\nexport function rankResults(results, ids) {\\n80→  const timed = [];\\n  const scored = [];\\n  const silent = [];\\n  for (const id of ids) {\\n    const r = results.get(id);\\n    if (r && Number.isFinite(r.time)) timed.push([id, r.time]);\\n    else if (r && Number.isFinite(r.score)) scored.push([id, r.score]);\\n    else silent.push(id);\\n  }\\n  const groups = (list, order) => {\\n90→    list.sort((a, b) => order * (a[1] - b[1]) || a[0] - b[0]);\\n    const out = [];\\n    for (const [id, value] of list) {\\n      const last = out[out.length - 1];\\n      if (last && last.value === value) last.ids.push(id);\\n      else out.push({ value, ids: [id] });\\n    }\\n    return out.map((g) => g.ids);\\n  };\\n  return [...groups(timed, 1), ...groups(scored, -1), ...(silent.length ? [silent] : [])];\\n100→}\\n\\n/** A time or score as a number: finite, given as a number or as text; NaN for null, '' or true, which Number() would make 0. */\\nconst asNumber = (v) => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '') ? Number(v) : NaN);\\n\\n/** The protocol's limits on a round's highlights (README §10). */\\nexport const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\\n\\n/** One player's stats, trimmed: up to six names, each a finite number or a short text. Null when none survive. */\\nexport function cleanStats(stats) {\\n110→  if (!stats || typeof stats !== 'object' || Array.isArray(stats)) return null;\\n  const out = {};\\n  for (const [name, value] of Object.entries(stats).slice(0, HIGHLIGHTS.stats)) {\\n    const label = String(name).trim().slice(0, HIGHLIGHTS.statName);\\n    if (!label) continue;\\n    if (typeof value === 'number' && Number.isFinite(value)) out[label] = value;\\n    else if (typeof value === 'string' && value.trim()) out[label] = value.trim().slice(0, HIGHLIGHTS.statText);\\n  }\\n  return Object.keys(out).length ? out : null;\\n}\\n120→\\n/**\\n * Awards, trimmed: `{ id, title, detail? }`, at most three a player, for\\n * players of this round. A result's awards are about its own player: `self` is its id.\\n */\\nexport function cleanAwards(awards, ids, self = null) {\\n  if (!Array.isArray(awards)) return [];\\n  const given = new Map();\\n  const out = [];\\n  for (const a of awards) {\\n130→    const id = self ?? a?.id;\\n    const title = String(a?.title ?? '')\\n      .trim()\\n      .slice(0, HIGHLIGHTS.title);\\n    if (!title || !ids.includes(id) || (given.get(id) || 0) >= HIGHLIGHTS.awards) continue;\\n    given.set(id, (given.get(id) || 0) + 1);\\n    const detail = String(a.detail ?? '')\\n      .trim()\\n      .slice(0, HIGHLIGHTS.detail);\\n    out.push(detail ? { id, title, detail } : { id, title });\\n140→  }\\n  return out;\\n}\\n\\n/**\\n * Check a host's standings: groups of ids, best first, every present player\\n * exactly once. Players already gone may be placed or left out; whoever is\\n * left out lands in a last group of their own.\\n */\\nexport function checkStandings(standings, presentIds, allIds) {\\n150→  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\\n  const all = new Set(allIds);\\n  const seen = new Set();\\n  const groups = [];\\n  for (const group of standings) {\\n    const ids = Array.isArray(group) ? group : [group];\\n    const kept = [];\\n    for (const id of ids) {\\n      if (!Number.isInteger(id) || !all.has(id))\\n        return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\\n160→      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\\n      seen.add(id);\\n      kept.push(id);\\n    }\\n    if (kept.length) groups.push(kept);\\n  }\\n  const missing = presentIds.filter((id) => !seen.has(id));\\n  if (missing.length)\\n    return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\\n  const absent = allIds.filter((id) => !seen.has(id));\\n170→  if (absent.length) groups.push(absent);\\n  return { ok: true, standings: groups };\\n}\\n\\n/**\\n * @param {object} o\\n * @param {number} o.round            round number, carried on every message\\n * @param {{key:string, slot:number, name:string}[]} o.players\\n * @param {string} o.hostKey          whose game runs a shared world\\n * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\\n180→ *                                    instead (a server): one more copy after the players, welcomed\\n *                                    with server: true, never ranked; the round is void if it goes\\n * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\\n * @param {number} o.seed\\n * @param {number} o.limitMs\\n * @param {{now:()=>number, setTimeout:Function, clearTimeout:Function}} [o.clock]\\n * @param {(key:string, msg:object) => void} o.deliver\\n * @param {(status:object) => void} [o.onStatus]\\n * @param {(record:object) => void} [o.onEnd]\\n * @param {boolean} [o.gate]          the hub shows a splash and collects the players' ready itself:\\n190→ *                                    games ready up once loaded, and the round starts on release()\\n */\\nexport function createRound({\\n  round,\\n  players,\\n  hostKey,\\n  mode = null,\\n  seed,\\n  limitMs,\\n  clock = REAL_CLOCK,\\n200→  deliver,\",\"content_concise\":\"1→/**\\n * @file round.js — one round of an AI Hub session, run by the hub that coordinates\\n * it (the harness page, or the session host's tab).\\n *\\n * It never touches the network or a frame itself: every message for a game\\n * goes out through `deliver(key, msg)`, and everything the games report comes\\n * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\\n * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\\n * without waiting for one.\\n10→ *\\n * Players are known by `key` (whatever the session calls them); games see\\n * contiguous ids 0..N-1 in slot order.\\n */\\n\\nexport const TIMINGS = Object.freeze({\\n  helloMs: 10_000,\\n  readyMs: 45_000,\\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\\n  loadGraceMs: 20_000,\\n20→  countdownMs: 3_000,\\n  graceMs: 5_000,\\n  hiddenMs: 20_000,\\n  maxRoundMs: 15 * 60_000,\\n});\\n\\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\\n\\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\\n30→\\n/** Each mode's name on screen. */\\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\\n\\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\\n\\n/** The mode a tag or a hello names, older tags included; null for anything else. */\\nexport function modeOf(word) {\\n  const w = String(word ?? '')\\n40→    .trim()\\n    .toLowerCase();\\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\\n}\\n\\n/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\\nexport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\\n\\n/**\\n * Whether a game's round carries the seed in its address, so the client seeds\\n50→ * Math.random and every copy starts the same: read from the game's own tag,\\n * parallel or ghost. A game still tagged race was built for an unseeded start\\n * (ids it makes from Math.random must differ between its copies), so it keeps one.\\n */\\nexport const seedsRandom = (tag) =>\\n  ['parallel', 'ghost'].includes(\\n    String(tag ?? '')\\n      .trim()\\n      .toLowerCase(),\\n  );\\n60→\\nconst REAL_CLOCK = {\\n  now: () => Date.now(),\\n  setTimeout: (fn, ms) => setTimeout(fn, ms),\\n  clearTimeout: (handle) => clearTimeout(handle),\\n};\\n\\n/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\\nexport function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\\n  const typical = Number(minutes);\\n70→  if (!(typical > 0)) return maxRoundMs;\\n  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\\n}\\n\\n/**\\n * Parallel and ghost order: finishers by time, then the rest by score,\\n * then anyone who reported nothing, tied last. Equal times or scores share a\\n * place.\\n */\\nexport function rankResults(results, ids) {\\n80→  const timed = [];\\n  const scored = [];\\n  const silent = [];\\n  for (const id of ids) {\\n    const r = results.get(id);\\n    if (r && Number.isFinite(r.time)) timed.push([id, r.time]);\\n    else if (r && Number.isFinite(r.score)) scored.push([id, r.score]);\\n    else silent.push(id);\\n  }\\n  const groups = (list, order) => {\\n90→    list.sort((a, b) => order * (a[1] - b[1]) || a[0] - b[0]);\\n    const out = [];\\n    for (const [id, value] of list) {\\n      const last = out[out.length - 1];\\n      if (last && last.value === value) last.ids.push(id);\\n      else out.push({ value, ids: [id] });\\n    }\\n    return out.map((g) => g.ids);\\n  };\\n  return [...groups(timed, 1), ...groups(scored, -1), ...(silent.length ? [silent] : [])];\\n100→}\\n\\n/** A time or score as a number: finite, given as a number or as text; NaN for null, '' or true, which Number() would make 0. */\\nconst asNumber = (v) => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '') ? Number(v) : NaN);\\n\\n/** The protocol's limits on a round's highlights (README §10). */\\nexport const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\\n\\n/** One player's stats, trimmed: up to six names, each a finite number or a short text. Null when none survive. */\\nexport function cleanStats(stats) {\\n110→  if (!stats || typeof stats !== 'object' || Array.isArray(stats)) return null;\\n  const out = {};\\n  for (const [name, value] of Object.entries(stats).slice(0, HIGHLIGHTS.stats)) {\\n    const label = String(name).trim().slice(0, HIGHLIGHTS.statName);\\n    if (!label) continue;\\n    if (typeof value === 'number' && Number.isFinite(value)) out[label] = value;\\n    else if (typeof value === 'string' && value.trim()) out[label] = value.trim().slice(0, HIGHLIGHTS.statText);\\n  }\\n  return Object.keys(out).length ? out : null;\\n}\\n120→\\n/**\\n * Awards, trimmed: `{ id, title, detail? }`, at most three a player, for\\n * players of this round. A result's awards are about its own player: `self` is its id.\\n */\\nexport function cleanAwards(awards, ids, self = null) {\\n  if (!Array.isArray(awards)) return [];\\n  const given = new Map();\\n  const out = [];\\n  for (const a of awards) {\\n130→    const id = self ?? a?.id;\\n    const title = String(a?.title ?? '')\\n      .trim()\\n      .slice(0, HIGHLIGHTS.title);\\n    if (!title || !ids.includes(id) || (given.get(id) || 0) >= HIGHLIGHTS.awards) continue;\\n    given.set(id, (given.get(id) || 0) + 1);\\n    const detail = String(a.detail ?? '')\\n      .trim()\\n      .slice(0, HIGHLIGHTS.detail);\\n    out.push(detail ? { id, title, detail } : { id, title });\\n140→  }\\n  return out;\\n}\\n\\n/**\\n * Check a host's standings: groups of ids, best first, every present player\\n * exactly once. Players already gone may be placed or left out; whoever is\\n * left out lands in a last group of their own.\\n */\\nexport function checkStandings(standings, presentIds, allIds) {\\n150→  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\\n  const all = new Set(allIds);\\n  const seen = new Set();\\n  const groups = [];\\n  for (const group of standings) {\\n    const ids = Array.isArray(group) ? group : [group];\\n    const kept = [];\\n    for (const id of ids) {\\n      if (!Number.isInteger(id) || !all.has(id))\\n        return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\\n160→      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\\n      seen.add(id);\\n      kept.push(id);\\n    }\\n    if (kept.length) groups.push(kept);\\n  }\\n  const missing = presentIds.filter((id) => !seen.has(id));\\n  if (missing.length)\\n    return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\\n  const absent = allIds.filter((id) => !seen.has(id));\\n170→  if (absent.length) groups.push(absent);\\n  return { ok: true, standings: groups };\\n}\\n\\n/**\\n * @param {object} o\\n * @param {number} o.round            round number, carried on every message\\n * @param {{key:string, slot:number, name:string}[]} o.players\\n * @param {string} o.hostKey          whose game runs a shared world\\n * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\\n180→ *                                    instead (a server): one more copy after the players, welcomed\\n *                                    with server: true, never ranked; the round is void if it goes\\n * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\\n * @param {number} o.seed\\n * @param {number} o.limitMs\\n * @param {{now:()=>number, setTimeout:Function, clearTimeout:Function}} [o.clock]\\n * @param {(key:string, msg:object) => void} o.deliver\\n * @param {(status:object) => void} [o.onStatus]\\n * @param {(record:object) => void} [o.onEnd]\\n * @param {boolean} [o.gate]          the hub shows a splash and collects the players' ready itself:\\n190→ *                                    games ready up once loaded, and the round starts on release()\\n */\\nexport function createRound({\\n  round,\\n  players,\\n  hostKey,\\n  mode = null,\\n  seed,\\n  limitMs,\\n  clock = REAL_CLOCK,\\n200→  deliver,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/tools/hub/round.js\",\"offset\":1,\"limit\":200,\"raw_output\":\"/**\\n * @file round.js — one round of an AI Hub session, run by the hub that coordinates\\n * it (the harness page, or the session host's tab).\\n *\\n * It never touches the network or a frame itself: every message for a game\\n * goes out through `deliver(key, msg)`, and everything the games report comes\\n * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\\n * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\\n * without waiting for one.\\n *\\n * Players are known by `key` (whatever the session calls them); games see\\n * contiguous ids 0..N-1 in slot order.\\n */\\n\\nexport const TIMINGS = Object.freeze({\\n  helloMs: 10_000,\\n  readyMs: 45_000,\\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\\n  loadGraceMs: 20_000,\\n  countdownMs: 3_000,\\n  graceMs: 5_000,\\n  hiddenMs: 20_000,\\n  maxRoundMs: 15 * 60_000,\\n});\\n\\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\\n\\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\\n\\n/** Each mode's name on screen. */\\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\\n\\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\\n\\n/** The mode a tag or a hello names, older tags included; null for anything else. */\\nexport function modeOf(word) {\\n  const w = String(word ?? '')\\n    .trim()\\n    .toLowerCase();\\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\\n}\\n\\n/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\\nexport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\\n\\n/**\\n * Whether a game's round carries the seed in its address, so the client seeds\\n * Math.random and every copy starts the same: read from the game's own tag,\\n * parallel or ghost. A game still tagged race was built for an unseeded start\\n * (ids it makes from Math.random must differ between its copies), so it keeps one.\\n */\\nexport const seedsRandom = (tag) =>\\n  ['parallel', 'ghost'].includes(\\n    String(tag ?? '')\\n      .trim()\\n      .toLowerCase(),\\n  );\\n\\nconst REAL_CLOCK = {\\n  now: () => Date.now(),\\n  setTimeout: (fn, ms) => setTimeout(fn, ms),\\n  clearTimeout: (handle) => clearTimeout(handle),\\n};\\n\\n/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\\nexport function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\\n  const typical = Number(minutes);\\n  if (!(typical > 0)) return maxRoundMs;\\n  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\\n}\\n\\n/**\\n * Parallel and ghost order: finishers by time, then the rest by score,\\n * then anyone who reported nothing, tied last. Equal times or scores share a\\n * place.\\n */\\nexport function rankResults(results, ids) {\\n  const timed = [];\\n  const scored = [];\\n  const silent = [];\\n  for (const id of ids) {\\n    const r = results.get(id);\\n    if (r && Number.isFinite(r.time)) timed.push([id, r.time]);\\n    else if (r && Number.isFinite(r.score)) scored.push([id, r.score]);\\n    else silent.push(id);\\n  }\\n  const groups = (list, order) => {\\n    list.sort((a, b) => order * (a[1] - b[1]) || a[0] - b[0]);\\n    const out = [];\\n    for (const [id, value] of list) {\\n      const last = out[out.length - 1];\\n      if (last && last.value === value) last.ids.push(id);\\n      else out.push({ value, ids: [id] });\\n    }\\n    return out.map((g) => g.ids);\\n  };\\n  return [...groups(timed, 1), ...groups(scored, -1), ...(silent.length ? [silent] : [])];\\n}\\n\\n/** A time or score as a number: finite, given as a number or as text; NaN for null, '' or true, which Number() would make 0. */\\nconst asNumber = (v) => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '') ? Number(v) : NaN);\\n\\n/** The protocol's limits on a round's highlights (README §10). */\\nexport const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\\n\\n/** One player's stats, trimmed: up to six names, each a finite number or a short text. Null when none survive. */\\nexport function cleanStats(stats) {\\n  if (!stats || typeof stats !== 'object' || Array.isArray(stats)) return null;\\n  const out = {};\\n  for (const [name, value] of Object.entries(stats).slice(0, HIGHLIGHTS.stats)) {\\n    const label = String(name).trim().slice(0, HIGHLIGHTS.statName);\\n    if (!label) continue;\\n    if (typeof value === 'number' && Number.isFinite(value)) out[label] = value;\\n    else if (typeof value === 'string' && value.trim()) out[label] = value.trim().slice(0, HIGHLIGHTS.statText);\\n  }\\n  return Object.keys(out).length ? out : null;\\n}\\n\\n/**\\n * Awards, trimmed: `{ id, title, detail? }`, at most three a player, for\\n * players of this round. A result's awards are about its own player: `self` is its id.\\n */\\nexport function cleanAwards(awards, ids, self = null) {\\n  if (!Array.isArray(awards)) return [];\\n  const given = new Map();\\n  const out = [];\\n  for (const a of awards) {\\n    const id = self ?? a?.id;\\n    const title = String(a?.title ?? '')\\n      .trim()\\n      .slice(0, HIGHLIGHTS.title);\\n    if (!title || !ids.includes(id) || (given.get(id) || 0) >= HIGHLIGHTS.awards) continue;\\n    given.set(id, (given.get(id) || 0) + 1);\\n    const detail = String(a.detail ?? '')\\n      .trim()\\n      .slice(0, HIGHLIGHTS.detail);\\n    out.push(detail ? { id, title, detail } : { id, title });\\n  }\\n  return out;\\n}\\n\\n/**\\n * Check a host's standings: groups of ids, best first, every present player\\n * exactly once. Players already gone may be placed or left out; whoever is\\n * left out lands in a last group of their own.\\n */\\nexport function checkStandings(standings, presentIds, allIds) {\\n  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\\n  const all = new Set(allIds);\\n  const seen = new Set();\\n  const groups = [];\\n  for (const group of standings) {\\n    const ids = Array.isArray(group) ? group : [group];\\n    const kept = [];\\n    for (const id of ids) {\\n      if (!Number.isInteger(id) || !all.has(id))\\n        return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\\n      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\\n      seen.add(id);\\n      kept.push(id);\\n    }\\n    if (kept.length) groups.push(kept);\\n  }\\n  const missing = presentIds.filter((id) => !seen.has(id));\\n  if (missing.length)\\n    return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\\n  const absent = allIds.filter((id) => !seen.has(id));\\n  if (absent.length) groups.push(absent);\\n  return { ok: true, standings: groups };\\n}\\n\\n/**\\n * @param {object} o\\n * @param {number} o.round            round number, carried on every message\\n * @param {{key:string, slot:number, name:string}[]} o.players\\n * @param {string} o.hostKey          whose game runs a shared world\\n * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\\n *                                    instead (a server): one more copy after the players, welcomed\\n *                                    with server: true, never ranked; the round is void if it goes\\n * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\\n * @param {number} o.seed\\n * @param {number} o.limitMs\\n * @param {{now:()=>number, setTimeout:Function, clearTimeout:Function}} [o.clock]\\n * @param {(key:string, msg:object) => void} o.deliver\\n * @param {(status:object) => void} [o.onStatus]\\n * @param {(record:object) => void} [o.onEnd]\\n * @param {boolean} [o.gate]          the hub shows a splash and collects the players' ready itself:\\n *                                    games ready up once loaded, and the round starts on release()\\n */\\nexport function createRound({\\n  round,\\n  players,\\n  hostKey,\\n  mode = null,\\n  seed,\\n  limitMs,\\n  clock = REAL_CLOCK,\\n  deliver,\\n\",\"total_lines\":603}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"434c29f6-a861-4ef3-b87d-c9c81d8ecb26"}
