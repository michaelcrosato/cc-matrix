he look on\\n * itself, as problems (a longer cycle is skipped where it is drawn, engine/gfx/post/combine.ts).\\n */\\nfunction checkLook(entry: LookEntry): string[] {\\n  const { pixel, palette } = entry.filters;\\n  const filters = entry.filters as Record<string, Record<string, unknown>>;\\n  return [\\n    levelsProblem(pixel.levels, 'filters.pixel.levels'),\\n    levelsProblem(palette.levels, 'filters.palette.levels'),\\n    ...colorFields().map(([name, key, empty]) => colorProblem(filters[name][key] as string, `filters.${name}.${key}`, empty)), // prettier-ignore\\n    entry.shells.color ? colorProblem(entry.shells.color, 'shells.color') : 'shells.color is empty: give hex',\\n    ...entry.combine.map((layer, i) =>\\n      layer.look === entry.id ? `combine[${i}] lays ${entry.id} on itself: name another look` : null,\\n    ),\\n  ].filter((problem): problem is string => problem !== null);\\n}\\n\\n/** Declares the kind `look` and the built-in looks and presets on `registry`, unless it has them. */\\nexport function defineLooks(registry: Registry = sharedRegistry): void {\\n  if (!registry.kinds().includes('look')) {\\n    registry.defineKind('look', {\\n      description:\\n        'Looks: a material style plus a filter chain (post-processing), and the sky that lights it, as whole looks or one-filter presets.',\\n      fields: LOOK_FIELDS,\\n      fallback: 'look:clean',\\n      check: (entry) => checkLook(entry as LookEntry),\\n      defineWith:\\n        \\\"defineLook('look:<name>', { description, style, toon, sky, filters: { pixel: { scope, size }, … } })\\\",\\n    });\\n  }\\n  for (const [id, spec] of Object.entries({ ...LOOKS, ...PRESETS, ...STYLE_PRESETS, ...COMBINED_LOOKS })) {\\n    if (!registry.has('look', id)) registry.def('look', id, spec as Record<string, unknown>);\\n  }\\n}\\ndefineLooks();\\n\\n/** Declares a look (`look:<name>`); see `LOOK_FIELDS`. */\\nexport function defineLook(id: string, spec: LookSpec, registry: Registry = sharedRegistry): LookEntry {\\n  return registry.def('look', id, spec as Record<string, unknown>) as LookEntry;\\n}\\n\",\"total_lines\":363}}","is_error":false},{"type":"tool_result","tool_use_id":"call-ee377736-afce-4fb2-a58c-d685f0d4adf3-61","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"140→    description: \\\"How far the variants' pitch spreads either way, as a fraction.\\\",\\n  },\\n  bus: { type: 'string', enum: SFX_BUSES, default: 'effects', description: 'The mixer bus it plays on.' },\\n  loop: {\\n    type: 'number',\\n    default: 0,\\n    minimum: 0,\\n    maximum: 60,\\n    unit: 's',\\n    description: 'The pass a looped play repeats: what sounds past it folds over its start, so the loop has no seam (0: the whole render).', // prettier-ignore\\n150→  },\\n} as const satisfies Schema;\\n\\n/** voice.ts's defaults for the two fields a layer changes on a voice that leaves them out. */\\nconst VOICE_FREQ = 440;\\nconst VOICE_VOL = 0.3;\\n\\n/** Where a layer puts its voices: a start offset, a gain and a pitch ratio. */\\ninterface Placement {\\n  at: number;\\n160→  vol: number;\\n  pitch: number;\\n}\\n\\n/** A sound definition as a list. */\\nconst voiceList = (def: SoundDef): readonly Voice[] => (Array.isArray(def) ? def : [def]) as readonly Voice[];\\n\\n/** The problems of an effect beyond its fields' own: voices `render` refuses, or nothing to play ([] when fine). */\\nexport function sfxProblems(sfx: { voices?: unknown; layers?: readonly unknown[] }): string[] {\\n  if (sfx.voices === undefined) return sfx.layers?.length ? [] : ['it has neither voices nor layers: give either'];\\n170→  try {\\n    normalizeSound(sfx.voices as SoundDef, DEFAULT_RATE);\\n    return [];\\n  } catch (error) {\\n    return [`voices: ${(error as Error).message}`];\\n  }\\n}\\n\\n/** Declares the `sfx` kind on `registry` with the engine's effects, drums and foley (once). */\\nexport function sfxKind(registry: Registry): void {\\n180→  if (registry.kinds().includes('sfx')) return;\\n  registry.defineKind('sfx', {\\n    description: 'A sound effect: voices for the DSP core, layers of other effects, variants and a mixer bus.',\\n    fields: SFX_FIELDS,\\n    defineWith: \\\"defineSfx('<id>', { voices: { wave: …, freq: …, to: …, dur: … } })\\\",\\n    check: (entry) => sfxProblems(entry),\\n  });\\n  for (const [id, spec] of Object.entries({ ...EFFECTS, ...DRUMS, ...FOLEY })) registry.def('sfx', id, { ...spec });\\n}\\nsfxKind(sharedRegistry);\\n190→\\n/**\\n * Defines an effect on `registry` (the shared one by default) and returns it. Throws `CORE_BAD_SPEC` naming each\\n * problem (an unknown field, a value out of range, a voice `render` refuses), `CORE_DUPLICATE_ID` when defined twice.\\n */\\nexport function defineSfx(id: string, spec: SfxSpec, registry: Registry = sharedRegistry): Sfx {\\n  sfxKind(registry);\\n  return registry.def('sfx', id, { ...spec }) as unknown as Sfx;\\n}\\n\\n200→/** The effect `id` of `registry`; a missing id throws `CORE_NO_ENTRY`, naming the closest ids. */\\nexport function getSfx(id: string, registry: Registry = sharedRegistry): Sfx {\\n  sfxKind(registry);\\n  return registry.get('sfx', id) as unknown as Sfx;\\n}\\n\\n/** `voice` started `at` seconds later, its gain times `vol` and every frequency times `pitch`. */\\nfunction place(voice: Voice, { at, vol, pitch }: Placement): Voice {\\n  const out: Voice = { ...voice };\\n  if (at !== 0) out.at = (voice.at ?? 0) + at;\",\"content_concise\":\"140→    description: \\\"How far the variants' pitch spreads either way, as a fraction.\\\",\\n  },\\n  bus: { type: 'string', enum: SFX_BUSES, default: 'effects', description: 'The mixer bus it plays on.' },\\n  loop: {\\n    type: 'number',\\n    default: 0,\\n    minimum: 0,\\n    maximum: 60,\\n    unit: 's',\\n    description: 'The pass a looped play repeats: what sounds past it folds over its start, so the loop has no seam (0: the whole render).', // prettier-ignore\\n150→  },\\n} as const satisfies Schema;\\n\\n/** voice.ts's defaults for the two fields a layer changes on a voice that leaves them out. */\\nconst VOICE_FREQ = 440;\\nconst VOICE_VOL = 0.3;\\n\\n/** Where a layer puts its voices: a start offset, a gain and a pitch ratio. */\\ninterface Placement {\\n  at: number;\\n160→  vol: number;\\n  pitch: number;\\n}\\n\\n/** A sound definition as a list. */\\nconst voiceList = (def: SoundDef): readonly Voice[] => (Array.isArray(def) ? def : [def]) as readonly Voice[];\\n\\n/** The problems of an effect beyond its fields' own: voices `render` refuses, or nothing to play ([] when fine). */\\nexport function sfxProblems(sfx: { voices?: unknown; layers?: readonly unknown[] }): string[] {\\n  if (sfx.voices === undefined) return sfx.layers?.length ? [] : ['it has neither voices nor layers: give either'];\\n170→  try {\\n    normalizeSound(sfx.voices as SoundDef, DEFAULT_RATE);\\n    return [];\\n  } catch (error) {\\n    return [`voices: ${(error as Error).message}`];\\n  }\\n}\\n\\n/** Declares the `sfx` kind on `registry` with the engine's effects, drums and foley (once). */\\nexport function sfxKind(registry: Registry): void {\\n180→  if (registry.kinds().includes('sfx')) return;\\n  registry.defineKind('sfx', {\\n    description: 'A sound effect: voices for the DSP core, layers of other effects, variants and a mixer bus.',\\n    fields: SFX_FIELDS,\\n    defineWith: \\\"defineSfx('<id>', { voices: { wave: …, freq: …, to: …, dur: … } })\\\",\\n    check: (entry) => sfxProblems(entry),\\n  });\\n  for (const [id, spec] of Object.entries({ ...EFFECTS, ...DRUMS, ...FOLEY })) registry.def('sfx', id, { ...spec });\\n}\\nsfxKind(sharedRegistry);\\n190→\\n/**\\n * Defines an effect on `registry` (the shared one by default) and returns it. Throws `CORE_BAD_SPEC` naming each\\n * problem (an unknown field, a value out of range, a voice `render` refuses), `CORE_DUPLICATE_ID` when defined twice.\\n */\\nexport function defineSfx(id: string, spec: SfxSpec, registry: Registry = sharedRegistry): Sfx {\\n  sfxKind(registry);\\n  return registry.def('sfx', id, { ...spec }) as unknown as Sfx;\\n}\\n\\n200→/** The effect `id` of `registry`; a missing id throws `CORE_NO_ENTRY`, naming the closest ids. */\\nexport function getSfx(id: string, registry: Registry = sharedRegistry): Sfx {\\n  sfxKind(registry);\\n  return registry.get('sfx', id) as unknown as Sfx;\\n}\\n\\n/** `voice` started `at` seconds later, its gain times `vol` and every frequency times `pitch`. */\\nfunction place(voice: Voice, { at, vol, pitch }: Placement): Voice {\\n  const out: Voice = { ...voice };\\n  if (at !== 0) out.at = (voice.at ?? 0) + at;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/audio/data/sfx.ts\",\"offset\":140,\"limit\":70,\"raw_output\":\"    description: \\\"How far the variants' pitch spreads either way, as a fraction.\\\",\\n  },\\n  bus: { type: 'string', enum: SFX_BUSES, default: 'effects', description: 'The mixer bus it plays on.' },\\n  loop: {\\n    type: 'number',\\n    default: 0,\\n    minimum: 0,\\n    maximum: 60,\\n    unit: 's',\\n    description: 'The pass a looped play repeats: what sounds past it folds over its start, so the loop has no seam (0: the whole render).', // prettier-ignore\\n  },\\n} as const satisfies Schema;\\n\\n/** voice.ts's defaults for the two fields a layer changes on a voice that leaves them out. */\\nconst VOICE_FREQ = 440;\\nconst VOICE_VOL = 0.3;\\n\\n/** Where a layer puts its voices: a start offset, a gain and a pitch ratio. */\\ninterface Placement {\\n  at: number;\\n  vol: number;\\n  pitch: number;\\n}\\n\\n/** A sound definition as a list. */\\nconst voiceList = (def: SoundDef): readonly Voice[] => (Array.isArray(def) ? def : [def]) as readonly Voice[];\\n\\n/** The problems of an effect beyond its fields' own: voices `render` refuses, or nothing to play ([] when fine). */\\nexport function sfxProblems(sfx: { voices?: unknown; layers?: readonly unknown[] }): string[] {\\n  if (sfx.voices === undefined) return sfx.layers?.length ? [] : ['it has neither voices nor layers: give either'];\\n  try {\\n    normalizeSound(sfx.voices as SoundDef, DEFAULT_RATE);\\n    return [];\\n  } catch (error) {\\n    return [`voices: ${(error as Error).message}`];\\n  }\\n}\\n\\n/** Declares the `sfx` kind on `registry` with the engine's effects, drums and foley (once). */\\nexport function sfxKind(registry: Registry): void {\\n  if (registry.kinds().includes('sfx')) return;\\n  registry.defineKind('sfx', {\\n    description: 'A sound effect: voices for the DSP core, layers of other effects, variants and a mixer bus.',\\n    fields: SFX_FIELDS,\\n    defineWith: \\\"defineSfx('<id>', { voices: { wave: …, freq: …, to: …, dur: … } })\\\",\\n    check: (entry) => sfxProblems(entry),\\n  });\\n  for (const [id, spec] of Object.entries({ ...EFFECTS, ...DRUMS, ...FOLEY })) registry.def('sfx', id, { ...spec });\\n}\\nsfxKind(sharedRegistry);\\n\\n/**\\n * Defines an effect on `registry` (the shared one by default) and returns it. Throws `CORE_BAD_SPEC` naming each\\n * problem (an unknown field, a value out of range, a voice `render` refuses), `CORE_DUPLICATE_ID` when defined twice.\\n */\\nexport function defineSfx(id: string, spec: SfxSpec, registry: Registry = sharedRegistry): Sfx {\\n  sfxKind(registry);\\n  return registry.def('sfx', id, { ...spec }) as unknown as Sfx;\\n}\\n\\n/** The effect `id` of `registry`; a missing id throws `CORE_NO_ENTRY`, naming the closest ids. */\\nexport function getSfx(id: string, registry: Registry = sharedRegistry): Sfx {\\n  sfxKind(registry);\\n  return registry.get('sfx', id) as unknown as Sfx;\\n}\\n\\n/** `voice` started `at` seconds later, its gain times `vol` and every frequency times `pitch`. */\\nfunction place(voice: Voice, { at, vol, pitch }: Placement): Voice {\\n  const out: Voice = { ...voice };\\n  if (at !== 0) out.at = (voice.at ?? 0) + at;\\n\",\"total_lines\":286}}","is_error":false},{"type":"tool_result","tool_use_id":"call-ee377736-afce-4fb2-a58c-d685f0d4adf3-62","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file Action maps and presets (PLAN.md WP 3.3, I-24; doctrine: Common ground): the registry kind `actionMap`, a set\\n * of named actions with the physical codes bound to each (engine/input/codes.ts), as Unity's action maps and Godot's\\n * InputMap hold them; the presets; and the system layer, which no player rebinds.\\n *\\n * An action is a button the sim reads: held actions arrive as the intents' `b`, pressed ones as `p`\\n * (engine/input/intents.ts). The four actions a map names in `move` (forward, back, left, right) are not buttons:\\n * their strengths make the move axes `[right − left, forward − back]`, so keys walk at full speed and a half-pushed\\n * stick at half, and `fromCamera` turns the axes into a world direction. `values` writes an action's analog strength\\n10→ * (a trigger) as a custom intent. `look: true` (first person, the shooter) adds the camera's view direction as `look`,\\n * `aimWith` names the rule that gives the intents' `aim` its point (engine/input/aim.ts: the screen centre's ray, the\\n * pointer's onto the floor, or none; the action `aim`, where a map has one, raises the sights), and `lock: true` takes\\n * the pointer lock on a click so the mouse turns the view (with the cursor free, it points and aims). The actions a\\n * map names in `view` (a camera switch, a view's turn) are the page's: bound and rebound like the others, never\\n * buttons in the intents (`createEngine({ onView })`). A game with several camera modes gives each its own map\\n * (`createEngine({ actionMap })`, WP 13.9).\\n *\\n * The system layer (`SYSTEM_ACTIONS`): pause, and the menu's accept, cancel and directions. It is always active\\n * beside the map, never rebound, and never part of the intents: the app and the UI read it (`input.pressed('pause')`),\\n20→ * so remapping movement never breaks a menu (the lesson of `my-3d2dge:docs/CONTROLS-AUDIT.md`). `RESERVED_CODES` (the\\n * pause buttons, and keys the browser or system keeps) and a map's own `reserved` codes are refused by rebinding.\\n *\\n * Invariants (`CORE_BAD_SPEC` when broken): every code is valid (`isCode`), action names are lower-case words\\n * (`jump`, `skill2`) and none is a system action, `move` names four actions of the map and `view` others, `values` keys\\n * are namespaced custom intents naming actions of the map, and no action binds a reserved code. The presets are registered on the\\n * shared registry when this module loads.\\n *\\n * Carried from `my-3d2dge:engine/my-3d2dge.js:670-693` (`Input.DEFAULT`, `PLATFORMER`, `SHMUP`, `MENU_KEYS`) with 3D\\n * movement, and shardfall's layer that is never rebound (`shardfall:crates/pav_app/src/input.rs:131-161`).\\n30→ *\\n * @example\\n * const map = getActionMap('actionMap:thirdPerson');\\n * map.actions.jump; // ['Space', 'PadSouth']\\n * map.move; // ['forward', 'back', 'left', 'right']\\n * SYSTEM_ACTIONS.pause; // ['Escape', 'PadStart']\\n * listActionMaps().map((entry) => entry.id); // ['actionMap:firstPerson', 'actionMap:platformer', …]\\n * @see engine/input/bindings.test.ts\\n */\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\\n40→import { show, type Schema } from '../core/schema';\\nimport { AIM_RULES, type AimRule } from './aim';\\nimport { isCode } from './codes';\\n\\n/** The system layer: action → codes. Always active, never rebound, never in the intents. */\\nexport const SYSTEM_ACTIONS: Readonly<Record<string, readonly string[]>> = Object.freeze({\\n  pause: ['Escape', 'PadStart'],\\n  uiAccept: ['Enter', 'NumpadEnter', 'Space', 'PadSouth'],\\n  uiCancel: ['Escape', 'Backspace', 'PadEast'],\\n  uiUp: ['ArrowUp', 'PadUp', 'PadLeftStickUp'],\\n50→  uiDown: ['ArrowDown', 'PadDown', 'PadLeftStickDown'],\\n  uiLeft: ['ArrowLeft', 'PadLeft', 'PadLeftStickLeft'],\\n  uiRight: ['ArrowRight', 'PadRight', 'PadLeftStickRight'],\\n});\\n\\n/** Codes no action map binds: the pause buttons, and keys the browser or the system keeps. */\\nexport const RESERVED_CODES: readonly string[] = Object.freeze([\\n  'Escape',\\n  'PadStart',\\n  'PadHome',\\n60→  'F5',\\n  'F11',\\n  'F12',\\n  'MetaLeft',\\n  'MetaRight',\\n]);\\n\\n/** The fields of an `actionMap` entry. */\\nconst ACTION_MAP_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What the map is for, in plain words.' },\\n70→  actions: {\\n    type: 'object',\\n    required: true,\\n    description:\\n      'Action name → the codes bound to it (KeyboardEvent.code, MouseLeft…, PadSouth…, PadLeftStickUp…): held actions are the intents b, pressed ones p.',\\n  },\\n  move: {\\n    type: 'array',\\n    items: { type: 'string' },\\n    default: ['forward', 'back', 'left', 'right'],\\n80→    description: 'The four actions that walk, as forward, back, left, right: their strengths make the move axes.',\",\"content_concise\":\"1→/**\\n * @file Action maps and presets (PLAN.md WP 3.3, I-24; doctrine: Common ground): the registry kind `actionMap`, a set\\n * of named actions with the physical codes bound to each (engine/input/codes.ts), as Unity's action maps and Godot's\\n * InputMap hold them; the presets; and the system layer, which no player rebinds.\\n *\\n * An action is a button the sim reads: held actions arrive as the intents' `b`, pressed ones as `p`\\n * (engine/input/intents.ts). The four actions a map names in `move` (forward, back, left, right) are not buttons:\\n * their strengths make the move axes `[right − left, forward − back]`, so keys walk at full speed and a half-pushed\\n * stick at half, and `fromCamera` turns the axes into a world direction. `values` writes an action's analog strength\\n10→ * (a trigger) as a custom intent. `look: true` (first person, the shooter) adds the camera's view direction as `look`,\\n * `aimWith` names the rule that gives the intents' `aim` its point (engine/input/aim.ts: the screen centre's ray, the\\n * pointer's onto the floor, or none; the action `aim`, where a map has one, raises the sights), and `lock: true` takes\\n * the pointer lock on a click so the mouse turns the view (with the cursor free, it points and aims). The actions a\\n * map names in `view` (a camera switch, a view's turn) are the page's: bound and rebound like the others, never\\n * buttons in the intents (`createEngine({ onView })`). A game with several camera modes gives each its own map\\n * (`createEngine({ actionMap })`, WP 13.9).\\n *\\n * The system layer (`SYSTEM_ACTIONS`): pause, and the menu's accept, cancel and directions. It is always active\\n * beside the map, never rebound, and never part of the intents: the app and the UI read it (`input.pressed('pause')`),\\n20→ * so remapping movement never breaks a menu (the lesson of `my-3d2dge:docs/CONTROLS-AUDIT.md`). `RESERVED_CODES` (the\\n * pause buttons, and keys the browser or system keeps) and a map's own `reserved` codes are refused by rebinding.\\n *\\n * Invariants (`CORE_BAD_SPEC` when broken): every code is valid (`isCode`), action names are lower-case words\\n * (`jump`, `skill2`) and none is a system action, `move` names four actions of the map and `view` others, `values` keys\\n * are namespaced custom intents naming actions of the map, and no action binds a reserved code. The presets are registered on the\\n * shared registry when this module loads.\\n *\\n * Carried from `my-3d2dge:engine/my-3d2dge.js:670-693` (`Input.DEFAULT`, `PLATFORMER`, `SHMUP`, `MENU_KEYS`) with 3D\\n * movement, and shardfall's layer that is never rebound (`shardfall:crates/pav_app/src/input.rs:131-161`).\\n30→ *\\n * @example\\n * const map = getActionMap('actionMap:thirdPerson');\\n * map.actions.jump; // ['Space', 'PadSouth']\\n * map.move; // ['forward', 'back', 'left', 'right']\\n * SYSTEM_ACTIONS.pause; // ['Escape', 'PadStart']\\n * listActionMaps().map((entry) => entry.id); // ['actionMap:firstPerson', 'actionMap:platformer', …]\\n * @see engine/input/bindings.test.ts\\n */\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\\n40→import { show, type Schema } from '../core/schema';\\nimport { AIM_RULES, type AimRule } from './aim';\\nimport { isCode } from './codes';\\n\\n/** The system layer: action → codes. Always active, never rebound, never in the intents. */\\nexport const SYSTEM_ACTIONS: Readonly<Record<string, readonly string[]>> = Object.freeze({\\n  pause: ['Escape', 'PadStart'],\\n  uiAccept: ['Enter', 'NumpadEnter', 'Space', 'PadSouth'],\\n  uiCancel: ['Escape', 'Backspace', 'PadEast'],\\n  uiUp: ['ArrowUp', 'PadUp', 'PadLeftStickUp'],\\n50→  uiDown: ['ArrowDown', 'PadDown', 'PadLeftStickDown'],\\n  uiLeft: ['ArrowLeft', 'PadLeft', 'PadLeftStickLeft'],\\n  uiRight: ['ArrowRight', 'PadRight', 'PadLeftStickRight'],\\n});\\n\\n/** Codes no action map binds: the pause buttons, and keys the browser or the system keeps. */\\nexport const RESERVED_CODES: readonly string[] = Object.freeze([\\n  'Escape',\\n  'PadStart',\\n  'PadHome',\\n60→  'F5',\\n  'F11',\\n  'F12',\\n  'MetaLeft',\\n  'MetaRight',\\n]);\\n\\n/** The fields of an `actionMap` entry. */\\nconst ACTION_MAP_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What the map is for, in plain words.' },\\n70→  actions: {\\n    type: 'object',\\n    required: true,\\n    description:\\n      'Action name → the codes bound to it (KeyboardEvent.code, MouseLeft…, PadSouth…, PadLeftStickUp…): held actions are the intents b, pressed ones p.',\\n  },\\n  move: {\\n    type: 'array',\\n    items: { type: 'string' },\\n    default: ['forward', 'back', 'left', 'right'],\\n80→    description: 'The four actions that walk, as forward, back, left, right: their strengths make the move axes.',\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/input/actionMaps.ts\",\"offset\":1,\"limit\":80,\"raw_output\":\"/**\\n * @file Action maps and presets (PLAN.md WP 3.3, I-24; doctrine: Common ground): the registry kind `actionMap`, a set\\n * of named actions with the physical codes bound to each (engine/input/codes.ts), as Unity's action maps and Godot's\\n * InputMap hold them; the presets; and the system layer, which no player rebinds.\\n *\\n * An action is a button the sim reads: held actions arrive as the intents' `b`, pressed ones as `p`\\n * (engine/input/intents.ts). The four actions a map names in `move` (forward, back, left, right) are not buttons:\\n * their strengths make the move axes `[right − left, forward − back]`, so keys walk at full speed and a half-pushed\\n * stick at half, and `fromCamera` turns the axes into a world direction. `values` writes an action's analog strength\\n * (a trigger) as a custom intent. `look: true` (first person, the shooter) adds the camera's view direction as `look`,\\n * `aimWith` names the rule that gives the intents' `aim` its point (engine/input/aim.ts: the screen centre's ray, the\\n * pointer's onto the floor, or none; the action `aim`, where a map has one, raises the sights), and `lock: true` takes\\n * the pointer lock on a click so the mouse turns the view (with the cursor free, it points and aims). The actions a\\n * map names in `view` (a camera switch, a view's turn) are the page's: bound and rebound like the others, never\\n * buttons in the intents (`createEngine({ onView })`). A game with several camera modes gives each its own map\\n * (`createEngine({ actionMap })`, WP 13.9).\\n *\\n * The system layer (`SYSTEM_ACTIONS`): pause, and the menu's accept, cancel and directions. It is always active\\n * beside the map, never rebound, and never part of the intents: the app and the UI read it (`input.pressed('pause')`),\\n * so remapping movement never breaks a menu (the lesson of `my-3d2dge:docs/CONTROLS-AUDIT.md`). `RESERVED_CODES` (the\\n * pause buttons, and keys the browser or system keeps) and a map's own `reserved` codes are refused by rebinding.\\n *\\n * Invariants (`CORE_BAD_SPEC` when broken): every code is valid (`isCode`), action names are lower-case words\\n * (`jump`, `skill2`) and none is a system action, `move` names four actions of the map and `view` others, `values` keys\\n * are namespaced custom intents naming actions of the map, and no action binds a reserved code. The presets are registered on the\\n * shared registry when this module loads.\\n *\\n * Carried from `my-3d2dge:engine/my-3d2dge.js:670-693` (`Input.DEFAULT`, `PLATFORMER`, `SHMUP`, `MENU_KEYS`) with 3D\\n * movement, and shardfall's layer that is never rebound (`shardfall:crates/pav_app/src/input.rs:131-161`).\\n *\\n * @example\\n * const map = getActionMap('actionMap:thirdPerson');\\n * map.actions.jump; // ['Space', 'PadSouth']\\n * map.move; // ['forward', 'back', 'left', 'right']\\n * SYSTEM_ACTIONS.pause; // ['Escape', 'PadStart']\\n * listActionMaps().map((entry) => entry.id); // ['actionMap:firstPerson', 'actionMap:platformer', …]\\n * @see engine/input/bindings.test.ts\\n */\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\\nimport { show, type Schema } from '../core/schema';\\nimport { AIM_RULES, type AimRule } from './aim';\\nimport { isCode } from './codes';\\n\\n/** The system layer: action → codes. Always active, never rebound, never in the intents. */\\nexport const SYSTEM_ACTIONS: Readonly<Record<string, readonly string[]>> = Object.freeze({\\n  pause: ['Escape', 'PadStart'],\\n  uiAccept: ['Enter', 'NumpadEnter', 'Space', 'PadSouth'],\\n  uiCancel: ['Escape', 'Backspace', 'PadEast'],\\n  uiUp: ['ArrowUp', 'PadUp', 'PadLeftStickUp'],\\n  uiDown: ['ArrowDown', 'PadDown', 'PadLeftStickDown'],\\n  uiLeft: ['ArrowLeft', 'PadLeft', 'PadLeftStickLeft'],\\n  uiRight: ['ArrowRight', 'PadRight', 'PadLeftStickRight'],\\n});\\n\\n/** Codes no action map binds: the pause buttons, and keys the browser or the system keeps. */\\nexport const RESERVED_CODES: readonly string[] = Object.freeze([\\n  'Escape',\\n  'PadStart',\\n  'PadHome',\\n  'F5',\\n  'F11',\\n  'F12',\\n  'MetaLeft',\\n  'MetaRight',\\n]);\\n\\n/** The fields of an `actionMap` entry. */\\nconst ACTION_MAP_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What the map is for, in plain words.' },\\n  actions: {\\n    type: 'object',\\n    required: true,\\n    description:\\n      'Action name → the codes bound to it (KeyboardEvent.code, MouseLeft…, PadSouth…, PadLeftStickUp…): held actions are the intents b, pressed ones p.',\\n  },\\n  move: {\\n    type: 'array',\\n    items: { type: 'string' },\\n    default: ['forward', 'back', 'left', 'right'],\\n    description: 'The four actions that walk, as forward, back, left, right: their strengths make the move axes.',\\n\",\"total_lines\":275}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"fd5b1026-d0e7-417e-aa9c-a8dc6b65b161"}
