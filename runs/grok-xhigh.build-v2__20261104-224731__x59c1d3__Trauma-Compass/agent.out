{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-7ab135f3-504b-47a2-879a-699429b34eac-29","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"120→  laserDamage: number;\\n  /** Field ticks of a strain timer. */\\n  timer: number;\\n  telegraph: number;\\n  spawnBleeders: number;\\n  /** Tag unlocked when a guide finishes. */\\n  unlock: string;\\n  /** Seat id holding this with forceps, or -1. */\\n  holder: number;\\n  /** Grab origin, metres. */\\n130→  ox: number;\\n  oz: number;\\n  optional: boolean;\\n}\\n\\n/** What one surgeon is doing this step. Positions are metres on the sheet. */\\nexport interface Hand {\\n  x: number;\\n  z: number;\\n  tool: number;\\n140→  use: boolean;\\n  drop: boolean;\\n  gift: boolean;\\n  paddle: boolean;\\n  /** Site to switch to, or -1 to stay. */\\n  site: number;\\n  swap: boolean;\\n  hint: boolean;\\n}\\n\\n150→/** One surgeon's cursor, tool, and score. `memo` is bot scratch and is not part of the hash. */\\nexport interface Seat {\\n  id: number;\\n  x: number;\\n  z: number;\\n  site: number;\\n  tool: number;\\n  use: boolean;\\n  prevUse: boolean;\\n  score: number;\\n160→  chain: number;\\n  bestChain: number;\\n  gift: 'stillpoint' | 'second' | 'none';\\n  charges: number;\\n  /** Real-time ticks of gift left. */\\n  giftLeft: number;\\n  giftKind: '' | 'still' | 'pulse';\\n  /** Pulse-lock presses so far. -1 when idle. */\\n  lock: number;\\n  lockBeat: number;\\n170→  lockGood: number;\\n  lockPerfect: number;\\n  syringe: number;\\n  syringeCd: number;\\n  laserHeat: number;\\n  laserCool: number;\\n  /** Ticks of a harmful tool on healthy tissue. */\\n  harm: number;\\n  hold: number;\\n  cutting: number;\\n180→  sutureSide: number;\\n  /** Wound the suture side belongs to, or -1. Not part of the hash. */\\n  stitchId: number;\\n  binderHold: number;\\n  lastGift: number;\\n  px: number;\\n  pz: number;\\n  memo: string;\\n}\\n\\n190→/** One patient's vitals. */\\nexport interface Patient {\\n  id: number;\\n  name: string;\\n  vitals: number;\\n  alive: boolean;\\n  coded: boolean;\\n}\\n\\n/** A phase the case spawns. */\\n200→export interface PhaseDef {\\n  id: string;\\n  hint: string;\\n  until: 'clear' | 'injected' | 'code';\\n  spawn: Spawn[];\\n  onEnter: string;\\n  teach: string;\\n}\\n\\n/** A spawn recipe. Omitted fields use the kind's defaults. */\\n210→export interface Spawn {\\n  kind: Kind;\\n  x: number;\\n  z: number;\\n  x2?: number;\\n  z2?: number;\\n  site?: number;\\n  patient?: number;\\n  volume?: number;\\n  bleed?: number;\\n220→  deep?: boolean;\\n  path?: number[];\\n  loop?: boolean;\\n  hp?: number;\\n  gen?: number;\\n  hidden?: boolean;\\n  tag?: string;\\n  under?: number;\\n  locked?: boolean;\\n  need?: number;\\n230→  burnNeed?: number;\\n  doseNeed?: number;\\n  coverNeed?: number;\\n  radius?: number;\\n  unlock?: string;\\n  spawnBleeders?: number;\\n  optional?: boolean;\\n}\\n\\n/** Something the page should show for one step. */\\n240→export interface GameEvent {\\n  type: string;\\n  text: string;\\n  rating?: Rating;\\n  x?: number;\\n  z?: number;\\n  tool?: string;\\n  kind?: string;\\n  seat?: number;\\n}\\n250→\\n/** Live tuning. Sliders write these; reset restores `SLIDER_DEFAULTS`. */\\nexport interface Balance {\\n  vitalsDrain: number;\\n  bleed: number;\\n  clock: number;\\n  slips: number;\\n  cursor: number;\\n  scalpel: number;\\n  forceps: number;\\n260→  suture: number;\\n  drain: number;\\n  laser: number;\\n  syringe: number;\\n  gel: number;\\n  scanner: number;\\n  giftWindow: number;\\n  giftTime: number;\\n  strainHp: number;\\n  strainSpeed: number;\\n270→  coopHp: number;\\n}\\n\\n/** A flatline, or a finale heart-stop. */\\nexport interface CodeState {\\n  left: number;\\n  tries: number;\\n  patient: number;\\n  /** A mercy shock that the case allows. */\\n  free: boolean;\\n280→  /** Ticks left in the green band window bookkeeping. The band itself 