wUp', 'ArrowDown', 'a', 'd', 'w', 's'];\\n    const randomly = async (ms) => {\\n      const end = performance.now() + ms;\\n      while (performance.now() < end && !state.record) {\\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\\n        await sleep(150);\\n      }\\n    };\\n    await randomly(Math.min(1500, playMs / 4));\\n\\n    const mode = state.coordinator.mode;\\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\\n    const own = SELF_REPORTED.includes(mode);\\n    const legacyRace = own && !seedsRandom(m?.mode);\\n    if (own && !legacyRace) {\\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\\n    }\\n\\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\\n    else if (n >= 3) removeCell(state.cells[n - 1]);\\n    await randomly(playMs / 2);\\n    const remaining = state.cells.filter((c) => !c.gone);\\n    if (own) {\\n      if (mode === 'parallel') {\\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      } else {\\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      }\\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\\n    } else {\\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\\n    }\\n\\n    if (!state.record) state.coordinator.timeUp();\\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\\n    const record = state.record;\\n    if (serverMode) {\\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\\n      const serverCell = state.cells.find((c) => c.server);\\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\\n    }\\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\\n    } else {\\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\\n    }\\n    await sleep(300);\\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\\n    const violations = state.cells.flatMap((c) => {\\n      let extra = [];\\n      try {\\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\\n      } catch {}\\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\\n    });\\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\\n  } catch (error) {\\n    check('harness ran', false, String(error?.stack || error));\\n  } finally {\\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\\n    report.done = true;\\n    document.body.dataset.complete = 'true';\\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\\n  }\\n}\\n\\nfunction renderChecks(checks) {\\n  $('checklist').replaceChildren(\\n    ...checks.map((c) => {\\n      const li = document.createElement('li');\\n      li.className = c.pass ? 'ok' : 'bad';\\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\\n      li.title = c.detail;\\n      return li;\\n\",\"total_lines\":548}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"c09b60d5-90e3-4d88-95e7-c8ab52a179fe"}
{"type":"assistant","message":{"id":"msg_400","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Reviewing harness requirements for the shared-world.\n\nThe boot sequence must connect in shared-world mode with seats [1,4] and card enabled, then call ready() after load. The harness must verify head metas, greetings, protocol 1, seat coverage, auto-ready, card display with Enter-to-ready, seeded randomness, bidirectional traffic, host-leave voiding rounds, and clean error-free execution.","signature":""},{"type":"tool_use","id":"call-03568459-eb8d-47d0-86e4-7b4ce6ea7d92-52","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/boot.ts","offset":180,"limit":160}},{"type":"tool_use","id":"call-03568459-eb8d-47d0-86e4-7b4ce6ea7d92-53","name":"grep","input":{"pattern":"finish|time\\(|on\\('tick'|hash|ready\\(","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/net"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3441,"output_tokens":486,"cache_read_input_tokens":94848,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"60f74466-20c5-43b4-84de-41d3b9b6c0fb"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-03568459-eb8d-47d0-86e4-7b4ce6ea7d92-52","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"180→  gain.connect(ctx.destination);\\n  const indexes = voiceOf(who, text).slice(0, 18);\\n  indexes.forEach((syllable, index) => {\\n    const osc = ctx.createOscillator();\\n    osc.type = 'sawtooth';\\n    osc.frequency.value = 180 + syllable * 28;\\n    osc.connect(gain);\\n    const at = ctx.currentTime + index * 0.08;\\n    osc.start(at);\\n    osc.stop(at + 0.07);\\n190→  });\\n  audio.duck(0.4);\\n}\\n\\n/** Start the game. `info` is null when there is no hub. */\\nexport async function start(info: HubInfo | null, hub: Hub | null): Promise<void> {\\n  if (!navigator.gpu) return;\\n  const canvas = document.querySelector<HTMLCanvasElement>('#view');\\n  const shell = document.querySelector<HTMLElement>('#shell');\\n  if (!canvas || !shell) return;\\n200→  if (info?.server) canvas.hidden = true;\\n  watchPointer(canvas);\\n  const autoplay = new URLSearchParams(location.search).get('game.autoplay') === '1';\\n  const store = createStore({ prefix: 'trauma-compass:', mode: 'play' });\\n  const campaign = createCampaign(info ? createCampaign().progress : loadProgress(store));\\n  if (info) campaign.screen = 'op';\\n  const audio = createAudio();\\n  audio.volume('master', campaign.progress.master / 100);\\n  audio.volume('music', campaign.progress.music / 100);\\n  audio.volume('effects', campaign.progress.effects / 100);\\n210→  const hud = createHud(document.body);\\n  const session: Session | null =\\n    info && hub ? { info, hub, round: null, card: null, playing: false, sample: { ...ZERO }, sent: 0 } : null;\\n  let engine: Engine | null = null;\\n  let page: PageEngine | null = null;\\n  let stamp = '';\\n  let line = '';\\n  let spoken = '';\\n  let song = '';\\n  let sig = '';\\n220→  let touchHold = true;\\n  const mismatches: string[] = [];\\n  const sliderValues = TUNE.map((row) => row.fallback);\\n\\n  const feel = (frame: EngineFrame, input: Input): Feel => ({\\n    speed: Number(frame.setting('game.cursorSpeed') ?? 8),\\n    curve: Number(frame.setting('game.cursorCurve') ?? 2.2),\\n    magnet: Number(frame.setting('game.magnet') ?? 0.55),\\n    precision: input.held('precision'),\\n  });\\n230→\\n  const extra = (): ShellExtra => ({\\n    prompt: page ? usePrompt(engine?.input?.lastDevice ?? 'gamepad', campaign.progress.glyphs === 'xbox') : '',\\n    hash: liveOp() ? (page?.hash() ?? '') : '',\\n    cursor: `${gloveSpots(1)[0]?.x.toFixed(2) ?? 0}, ${gloveSpots(1)[0]?.z.toFixed(2) ?? 0}`,\\n    sliders: TUNE.map((row, index) => ({\\n      setting: row.setting,\\n      label: row.label,\\n      value: sliderValues[index] ?? row.fallback,\\n    })),\\n240→    touch: touchOnly() && touchHold && !session,\\n    card: session?.card ?? null,\\n  });\\n\\n  const drawShell = (): void => {\\n    const next = shellStamp(campaign, extra());\\n    if (next === stamp) return;\\n    stamp = next;\\n    renderShell(shell, campaign, extra());\\n  };\\n250→\\n  const pick = (id: string): void => {\\n    if (session && (id === 'hub-ready' || id === 'hub-more')) {\\n      hub?.answer(id === 'hub-ready' ? 'ready' : 'more');\\n      return;\\n    }\\n    if (session && id !== 'settings') return;\\n    noteInput(campaign);\\n    touchHold = false;\\n    const dev = DEV[id];\\n260→    act(campaign, id);\\n    if (id === 'reset') TUNE.forEach((row, index) => (sliderValues[index] = row.fallback));\\n    if (dev && page) dev(page);\\n    saveProgress(store, campaign, !!session);\\n    stamp = '';\\n  };\\n\\n  shell.addEventListener('click', (event) => {\\n    const target = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-act]');\\n    if (!target?.dataset.act) return;\\n270→    pick(target.dataset.act);\\n  });\\n  shell.addEventListener('pointerover', (event) => {\\n    const target = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-act]');\\n    if (!target) return;\\n    const rows = [...shell.querySelectorAll<HTMLElement>('[data-game=\\\"row\\\"]')];\\n    const index = rows.indexOf(target);\\n    if (index >= 0) campaign.focus = index;\\n  });\\n  shell.addEventListener('input', (event) => {\\n280→    const target = event.target as HTMLInputElement | null;\\n    const setting = target?.dataset.set;\\n    if (!setting || !page || session) return;\\n    const value = Number(target.value);\\n    page.set(setting, value);\\n    const index = TUNE.findIndex((row) => row.setting === setting);\\n    if (index >= 0) sliderValues[index] = value;\\n    const name = TUNE[index]?.label ?? setting;\\n    if (target.parentElement?.firstChild) target.parentElement.firstChild.textContent = `${name} ${value}`;\\n  });\\n290→  addEventListener('keydown', (event) => {\\n    touchHold = false;\\n    if (campaign.screen === 'attract') noteInput(campaign);\\n    if (event.key === 't' || event.key === 'T') session?.hub.answer('more');\\n  });\\n\\n  const compass: Compass = {\\n    campaign,\\n    screen: campaign.screen,\\n    mismatches,\\n300→    audio,\\n    live: liveOp,\\n    gloves: () => gloveSpots(4),\\n  };\\n  (window as unknown as { __compass: Compass }).__compass = compass;\\n\\n  engine = await createEngine({\\n    canvas,\\n    scenes: [main.id, play.id],\\n    levels: {\\n310→      'level:or': { text: OR_TEXT, file: 'labs/game/scenes/room.ts' },\\n      'level:arena': { text: ARENA_TEXT, file: 'labs/game/scenes/play.ts' },\\n    },\\n    search: searchFrom(info, autoplay),\\n    store,\\n    actionMap: SURGEON_MAP,\\n    modal: () => campaign.screen !== 'op' || !!session?.card,\\n    onFrame: (frame) => onFrame(frame, hud),\\n  });\\n  page = engine.inspector as PageEngine | null;\\n320→  const msg = document.querySelector<HTMLElement>('#msg');\\n  if (msg) msg.hidden = true;\\n\\n  if (session && page && hub) {\\n    const enginePage = page;\\n    const wait = async (): Promise<void> => {\\n      while (typeof (window as unknown as { __engine?: { step?: unknown } }).__engine?.step !== 'function') {\\n        await new Promise((resolve) => setTimeout(resolve, 25));\\n      }\\n    };\\n330→    void wait().then(() => {\\n      const roundInfo = info as HubInfo;\\n      enginePage.pause();\\n      enginePage.seed(roundInfo.seed);\\n      enginePage.pause();\\n      hub.ready();\\n      session.round = startRound(hub, roundInfo, enginePage, Math.max(1, roundInfo.players.length));\\n    });\\n    hub.on('card', (data) => {\\n      const card = data as { left?: number | null; ready?: number[]; asked?: boolean };\",\"content_concise\":\"180→  gain.connect(ctx.destination);\\n  const indexes = voiceOf(who, text).slice(0, 18);\\n  indexes.forEach((syllable, index) => {\\n    const osc = ctx.createOscillator();\\n    osc.type = 'sawtooth';\\n    osc.frequency.value = 180 + syllable * 28;\\n    osc.connect(gain);\\n    const at = ctx.currentTime + index * 0.08;\\n    osc.start(at);\\n    osc.stop(at + 0.07);\\n190→  });\\n  audio.duck(0.4);\\n}\\n\\n/** Start the game. `info` is null when there is no hub. */\\nexport async function start(info: HubInfo | null, hub: Hub | null): Promise<void> {\\n  if (!navigator.gpu) return;\\n  const canvas = document.querySelector<HTMLCanvasElement>('#view');\\n  const shell = document.querySelector<HTMLElement>('#shell');\\n  if (!canvas || !shell) return;\\n200→  if (info?.server) canvas.hidden = true;\\n  watchPointer(canvas);\\n  const autoplay = new URLSearchParams(location.search).get('game.autoplay') === '1';\\n  const store = createStore({ prefix: 'trauma-compass:', mode: 'play' });\\n  const campaign = createCampaign(info ? createCampaign().progress : loadProgress(store));\\n  if (info) campaign.screen = 'op';\\n  const audio = createAudio();\\n  audio.volume('master', campaign.progress.master / 100);\\n  audio.volume('music', campaign.progress.music / 100);\\n  audio.volume('effects', campaig