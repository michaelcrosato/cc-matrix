= (i / 6) * Math.PI * 2;\\n    out.push({ kind: 'mote', x: Math.cos(angle) * 1.15, z: Math.sin(angle) * 0.7 });\\n  }\\n  return out;\\n}\\n\\n/** The eight story cases, in order, then the session case. */\\nexport const CASES: readonly CaseDef[] = [\\n\",\"total_lines\":741}}","is_error":false},{"type":"tool_result","tool_use_id":"call-59811545-03f5-46e9-a542-c50d018e65a8-185","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"360→  }\\n  if (id === 'resume') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'unlock') {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.progress.cleared = storyCases().length;\\n    return;\\n370→  }\\n  cycleSetting(c, id);\\n}\\n\\nexport function cancel(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') {\\n    finishScene(c);\\n    return;\\n  }\\n380→  if (c.screen === 'op') {\\n    c.back = 'op';\\n    c.screen = 'pause';\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'pause') {\\n    c.screen = 'op';\\n    return;\\n  }\\n390→  if (c.screen === 'attract') return leaveAttract(c);\\n  if (c.screen === 'credits') {\\n    c.screen = 'title';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.screen = c.back === c.screen ? 'title' : c.back;\\n  if (c.screen === 'pause' || c.screen === 'title') c.focus = 0;\\n}\\n\\n400→export function noteInput(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'attract') leaveAttract(c);\\n}\\n\\nexport function tickFront(c: Campaign, dtMs: number, inSession: boolean): void {\\n  if (inSession) return;\\n  if (c.screen === 'attract') {\\n    c.clipMs -= dtMs;\\n    if (c.clipMs <= 0) {\",\"content_concise\":\"360→  }\\n  if (id === 'resume') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'unlock') {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.progress.cleared = storyCases().length;\\n    return;\\n370→  }\\n  cycleSetting(c, id);\\n}\\n\\nexport function cancel(c: Campaign): void 