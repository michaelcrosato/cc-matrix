ss --force to replace it`, // prettier-ignore\"},{\"line_number\":229,\"content\":\"      `the game added files in the engine's folders: ${own.join(', ')}. Move each into labs/game/ (or delete it), or ${declare}`, // prettier-ignore\"},{\"line_number\":241,\"content\":\"      `the newer engine sets ${clashes.join(', ')} in package.json, where the game has its own: rename the game's (a script), or drop it (a dependency: the engine's pin then serves)`, // prettier-ignore\"},{\"line_number\":324,\"content\":\"      const counts = `${done.replaced.length} engine files changed, ${done.added.length} added, ${done.removed.length} removed`; // prettier-ignore\"},{\"line_number\":325,\"content\":\"      out(`new-game: moved from my-3dge@${done.from.commit.slice(0, 7)} to my-3dge@${done.to.commit.slice(0, 7)}: ${counts}${patches}`); // prettier-ignore\"},{\"line_number\":327,\"content\":\"      if (done.npm.length > 0) out(`package.json: the engine's entries win, so these went or are the engine's again: ${done.npm.join(', ')}; put back what the game needs under a name of its own`); // prettier-ignore\"},{\"line_number\":330,\"content\":\"      if (done.diverged.length > 0) out(`the engine's templates changed for root files the game edited: compare ${done.diverged.map(template).join(', ')} and take what applies`); // prettier-ignore\"},{\"line_number\":331,\"content\":\"      out(`next: ${done.lockfileFits ? 'npm ci' : 'npm install (the game has dependencies of its own)'}, then npm run check && npm test`); // prettier-ignore\"},{\"line_number\":337,\"content\":\"    const extra = `${done.kept.length > 0 ? `; kept your ${done.kept.join(', ')}` : ''}${done.initialized ? '; git init' : ''}`; // prettier-ignore\"},{\"line_number\":338,\"content\":\"    out(`new-game: made the game \\\"${done.name}\\\" in ${where}: the engine at my-3dge@${done.identity.commit.slice(0, 7)} (${done.engineFiles} files, read-only, pinned by ${LOCK_FILE}) and the starter game in labs/game/${extra}`); // prettier-ignore\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/tools/deps.json\",\"matches\":[{\"line_number\":282,\"content\":\"    \\\"prettier\\\": {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/package-lock.json\",\"matches\":[{\"line_number\":27,\"content\":\"        \\\"prettier\\\": \\\"3.9.10\\\",\"},{\"line_number\":10222,\"content\":\"    \\\"node_modules/prettier\\\": {\"},{\"line_number\":10224,\"content\":\"      \\\"resolved\\\": \\\"https://registry.npmjs.org/prettier/-/prettier-3.9.10.tgz\\\",\"},{\"line_number\":10229,\"content\":\"        \\\"prettier\\\": \\\"bin/prettier.cjs\\\"\"},{\"line_number\":10235,\"content\":\"        \\\"url\\\": \\\"https://github.com/prettier/prettier?sponsor=1\\\"\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/.prettierrc.json\",\"matches\":[{\"line_number\":2,\"content\":\"  \\\"printWidth\\\": 120,\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-ff5a6673-69dc-4b66-9f3f-3a54e78522e4-9","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"380→        'Hold the flap. Second Pulse: three beats, then vitals cannot fall.',\\n      ),\\n      phase(\\n        'close',\\n        'Close, even while the deck rolls.',\\n        'clear',\\n        [wound(-1, 0.8), gel(1.2, 0.5)],\\n        '',\\n        'The roll is the ship, not your hands.',\\n      ),\\n390→    ],\\n  },\\n  {\\n    id: 'case:reverie',\\n    title: 'Reverie',\\n    surgeon: 'Wren',\\n    seconds: 360,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: true,\\n400→    swap: true,\\n    roll: false,\\n    code: true,\\n    rule: 'Reverie hides until the scanner. Laser brings it up, then it sinks. Two surgeons can Consult.',\\n    patients: [\\n      {\\n        name: 'Bram Achterberg',\\n        age: 60,\\n        line: 'Chief of surgery. He opened his own collar and showed the graft.',\\n        vitals: 65,\",\"content_concise\":\"380→        'Hold the flap. Second Pulse: three beats, then vitals cannot fall.',\\n      ),\\n      phase(\\n        'close',\\n        'Close, even while the deck rolls.',\\n        'clear',\\n        [wound(-1, 0.8), gel(1.2, 0.5)],\\n        '',\\n        'The roll is the ship, not your hands.',\\n      ),\\n390→    ],\\n  },\\n  {\\n    id: 'case:reverie',\\n    title: 'Reverie',\\n    surgeon: 'Wren',\\n    seconds: 360,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: true,\\n400→    swap: true,\\n    roll: false,\\n    code: true,\\n    rule: 'Reverie hides until the scanner. Laser brings it up, then it sinks. Two surgeons can Consult.',\\n    patients: [\\n      {\\n        name: 'Bram Achterberg',\\n        age: 60,\\n        line: 'Chief of surgery. He opened his own collar and showed the graft.',\\n        vitals: 65,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/cases.ts\",\"offset\":380,\"limit\":30,\"raw_output\":\"        'Hold the flap. Second Pulse: three beats, then vitals cannot fall.',\\n      ),\\n      phase(\\n        'close',\\n        'Close, even while the deck rolls.',\\n        'clear',\\n        [wound(-1, 0.8), gel(1.2, 0.5)],\\n        '',\\n        'The roll is the ship, not your hands.',\\n      ),\\n    ],\\n  },\\n  {\\n    id: 'case:reverie',\\n    title: 'Reverie',\\n    surgeon: 'Wren',\\n    seconds: 360,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: true,\\n    swap: true,\\n    roll: false,\\n    code: true,\\n    rule: 'Reverie hides until the scanner. Laser brings it up, then it sinks. Two surgeons can Consult.',\\n    patients: [\\n      {\\n        name: 'Bram Achterberg',\\n        age: 60,\\n        line: 'Chief of surgery. He opened his own collar and showed the graft.',\\n        vitals: 65,\\n\",\"total_lines\":741}}","is_error":false},{"type":"tool_result","tool_use_id":"call-ff5a6673-69dc-4b66-9f3f-3a54e78522e4-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"700→        'Two tables. A flap, a shard, a Lull.',\\n        'clear',\\n        [\\n          { kind: 'flap', x: -0.3, z: 0.2, site: 0, patient: 0, tag: 'cloth' },\\n          { kind: 'shard', x: 0, z: 0.15, site: 0, patient: 0, tag: 'under:cloth' },\\n          shard(1.2, -0.4, 1, 1),\\n          { kind: 'lull', x: -1.2, z: -0.5, site: 0, patient: 0 },\\n        ],\\n        '',\\n        'Lift, pull, burn, pull the cocoon.',\\n710→      ),\\n      phase(\\n        'film',\\n        'Balm on the right-hand table.',\\n        'clear',\\n        [{ kind: 'balmNode', x: 0.2, z: 0, site: 1, patient: 1 }],\\n        '',\\n        'Two doses. Wait for the film to fade.',\\n      ),\\n      phase(\\n720→        'close',\\n        'Close them both.',\\n        'clear',\\n        [wound(-1, 0.7, 0, 0), wound(0.2, -0.6, 1, 1), gel(1.3, 0.6, 0, 0), gel(1.1, 0.5, 1, 1)],\\n        '',\\n        'Neither one gets to leave unfinished.',\\n      ),\\n    ],\\n  },\\n];\\n730→\\n/** The case with this id, or a thrown error when the board names a case we do not have. */\\nexport function caseById(id: string): CaseDef {\\n  const found = CASES.find((item) => item.id === id);\\n  if (!found) throw new Error(`Unknown case ${id}`);\\n  return found;\\n}\\n\\n/** Story cases, in campaign order. The session case is not one of them. */\\nexport function storyCases(): CaseDef[] {\\n740→  return CASES.filter((item) => item.id !== 'case:gala-shift');\\n}\\n\",\"content_concise\":\"700→        'Two tables. A flap, a shard, a Lull.',\\n        'clear',\\n        [\\n          { kind: 'flap', x: -0.3, z: 0.2, site: 0, patient: 0, tag: 'cloth' },\\n          { kind: 'shard', x: 0, z: 0.15, site: 0, patient: 0, tag: 'under:cloth' },\\n          shard(1.2, -0.4, 1, 1),\\n          { kind: 'lull', x: -1.2, z: -0.5, site: 0, patient: 0 },\\n        ],\\n        '',\\n        'Lift, pull, burn, pull the cocoon.',\\n710→      ),\\n      phase(\\n        'film',\\n        'Balm on the right-hand table.',\\n        'clear',\\n        [{ kind: 'balmNode', x: 0.2, z: 0, site: 1, patient: 1 }],\\n        '',\\n        'Two doses. Wait for the film to fade.',\\n      ),\\n      phase(\\n720→        'close',\\n        'Close them both.',\\n        'clear',\\n        [wound(-1, 0.7, 0, 0), wound(0.2, -0.6, 1, 1), gel(1.3, 0.6, 0, 0), gel(1.1, 0.5, 1, 1)],\\n        '',\\n        'Neither one gets to leave unfinished.',\\n      ),\\n    ],\\n  },\\n];\\n730→\\n/** The case with this id, or a thrown error when the board names a case we do not have. */\\nexport function caseById(id: string): CaseDef {\\n  const found = CASES.find((item) => item.id === id);\\n  if (!found) throw new Error(`Unknown case ${id}`);\\n  return found;\\n}\\n\\n/** Story cases, in campaign order. The session case is not one of them. */\\nexport function storyCases(): CaseDef[] {\\n740→  return CASES.filter((item) => item.id !== 'case:gala-shift');\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/cases.ts\",\"offset\":700,\"limit\":50,\"raw_output\":\"        'Two tables. A flap, a shard, a Lull.',\\n        'clear',\\n        [\\n          { kind: 'flap', x: -0.3, z: 0.2, site: 0, patient: 0, tag: 'cloth' },\\n          { kind: 'shard', x: 0, z: 0.15, site: 0, patient: 0, tag: 'under:cloth' },\\n          shard(1.2, -0.4, 1, 1),\\n          { kind: 'lull', x: -1.2, z: -0.5, site: 0, patient: 0 },\\n        ],\\n        '',\\n        'Lift, pull, burn, pull the cocoon.',\\n      ),\\n      phase(\\n        'film',\\n        'Balm on the right-hand table.',\\n        'clear',\\n        [{ kind: 'balmNode', x: 0.2, z: 0, site: 1, patient: 1 }],\\n        '',\\n        'Two doses. Wait for the film to fade.',\\n      ),\\n      phase(\\n        'close',\\n        'Close them both.',\\n        'clear',\\n        [wound(-1, 0.7, 0, 0), wound(0.2, -0.6, 1, 1), gel(1.3, 0.6, 0, 0), gel(1.1, 0.5, 1, 1)],\\n        '',\\n        'Neither one gets to leave unfinished.',\\n      ),\\n    ],\\n  },\\n];\\n\\n/** The case with this id, or a thrown error when the board names a case we do not have. */\\nexport function caseById(id: string): CaseDef {\\n  const found = CASES.find((item) => item.id === id);\\n  if (!found) throw new Error(`Unknown case ${id}`);\\n  return found;\\n}\\n\\n/** Story cases, in campaign order. The session case is not one of them. */\\nexport function storyCases(): CaseDef[] {\\n  return CASES.filter((item) => item.id !== 'case:gala-shift');\\n}\\n\",\"total_lines\":741}}","is_error":false},{"type":"tool_result","tool_use_id":"call-ff5a6673-69dc-4b66-9f3f-3a54e78522e4-11","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"280→}\\n\\nexport function browse(c: Campaign, dir: number): void {\\n  c.idle = 0;\\n  if (c.screen === 'board') {\\n    const ids = boardIds(c.progress);\\n    c.board = (c.board + dir + ids.length) % ids.length;\\n    return;\\n  }\\n  if (c.screen === 'settings') {\\n290→    c.page = (c.page + dir + 4) % 4;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'handbook') {\\n    const n = handbookCards().length;\\n    c.page = (c.page + dir + n) % n;\\n    return;\\n  }\\n  if (c.screen === 'about' || c.screen === 'credits') {\\n300→    c.page = Math.max(0, c.page + dir);\\n    return;\\n  }\\n  if (c.screen === 'dev') {\\n    c.devTab = (c.devTab + dir + 5) % 5;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'story') c.box = Math.max(0, c.box + dir);\\n}\\n310→\\nexport function accept(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') return advanceStory(c);\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  const row = items(c)[c.focus];\\n  if (!row) return;\\n  act(c, row.id);\\n}\\n\\n320→export function act(c: Campaign, id: string): void {\\n  c.idle = 0;\\n  if (id === 'back') return cancel(c);\\n  if (id === 'new') return startShift(c);\\n  if (id === 'continue') return continueShift(c);\\n  if (id === 'board') return go(c, 'board');\\n  if (id === 'scrub') return go(c, 'scrub');\\n  if (id === 'settings') return go(c, 'settings');\\n  if (id === 'about') return go(c, 'about');\\n  if (id === 'handbook') return go(c, 'handbook');\\n330→  if (id === 'controls') {\\n    go(c, 'settings');\\n    c.page = 1;\\n    return;\\n  }\\n  if (id === 'dev') return go(c, 'dev');\\n  if (id === 'play' && c.screen === 'board') return openBoard(c);\\n  if (id === 'postcards') {\\n    c.tab = c.tab === 0 ? 1 : 0;\\n    return;\\n340→  }\\n  if (id === 'start' && c.screen === 'brief') {\\n    c.boot += 1;\\n    c.keepPhase = false;\\n    c.screen = 'op';\\n    c.record = c.caseIndex >= 0 && c.caseIndex === c.progress.cleared;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'scrub') {\\n    c.progress.seats = Math.max(1, c.claimed.filter(Boolean).length);\\n350→    c.screen = 'title';\\n    return;\\n  }\\n  if (id === 'next' && c.won) return afterWin(c);\\n  if (id === 'retry') return retryCase(c);\\n  if (id === 'phase') {\\n    c.boot += 1;\\n    c.keepPhase = true;\\n    c.screen = 'op';\\n    return;\\n360→  }\\n  if (id === 'resume') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'unlock') {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.progress.cleared = storyCases().length;\\n    return;\\n370→  }\\n  cycleSetting(c, id);\\n}\\n\\nexport function cancel(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') {\\n    finishScene(c);\\n    return;\\n  }\\n380→  if (c.screen === 'op') {\\n    c.back = 'op';\\n    c.screen = 'pause';\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'pause') {\\n    c.screen = 'op';\\n    return;\\n  }\\n390→  if (c.screen === 'attract') return leaveAttract(c);\\n  if (c.screen === 'credits') {\\n    c.screen = 'title';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.screen = c.back === c.screen ? 'title' : c.back;\\n  if (c.screen === 'pause' || c.screen === 'title') c.focus = 0;\\n}\\n\\n400→export function noteInput(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'attract') leaveAttract(c);\\n}\\n\\nexport function tickFront(c: Campaign, dtMs: number, inSession: boolean): void {\\n  if (inSession) return;\\n  if (c.screen === 'attract') {\\n    c.clipMs -= dtMs;\\n    if (c.clipMs <= 0) {\\n410→      c.clip = (c.clip + 1) % ATTRACT.length;\\n      c.clipMs = ATTRACT[c.clip].ms;\\n      if (ATTRACT[c.clip].kind === 'story') c.box = 0;\\n    }\\n    return;\\n  }\\n  if (c.screen === 'story' && c.progress.autoText) {\\n    c.lineMs += dtMs;\\n    if (c.lineMs > 2500) {\\n      c.lineMs = 0;\\n420→      advanceStory(c);\\n    }\\n  }\\n  if (!MENUS.includes(c.screen)) return;\\n  c.idle += dtMs;\\n  if (c.idle >= 10000) enterAttract(c);\\n}\\n\\nexport function finishOp(c: Campaign, won: boolean, score: number, slips: number, fail: string): void {\\n  if (c.screen !== 'op') return;\\n430→  const def = caseById(c.caseId);\\n  c.won = won;\\n  c.fail = won ? '' : fail || 'Called off.';\\n  c.lastScore = score;\\n  if (won) {\\n    const rank = rankFor(score, def.par, slips, c.progress.difficulty);\\n    c.lastRank = rank;\\n    const letter = rank === '★' ? 'S' : (rank as Exclude<Rank, '★'>);\\n    c.postcard = def.patients[0]?.postcards[letter] ?? '';\\n    const prev = c.progress.scores[c.caseIndex];\\n440→    const better = prev === undefined || score > prev;\\n    if (c.caseIndex >= 0 && (c.record || better)) {\\n      c.progress.ranks[c.caseIndex] = rank;\\n      c.progress.scores[c.caseIndex] = score;\\n      c.progress.postcards[c.caseIndex] = c.postcard;\\n    }\\n  }\\n  c.screen = 'debrief';\\n  c.focus = 0;\\n}\\n450→\\nexport function desiredRun(c: Campaign): string {\\n  if (c.screen === 'op') return `op:${c.caseId}`;\\n  if (c.screen === 'attract') {\\n    const clip = ATTRACT[c.clip];\\n    if (clip.kind === 'op') return `op:${clip.id}`;\\n  }\\n  return 'title';\\n}\\n\\n460→export function desiredAttract(c: Campaign): boolean {\\n  return c.screen === 'attract' && ATTRACT[c.clip].kind === 'op';\\n}\\n\\nexport function currentBox(c: Campaign): { who: string; text: string; drama: string; where: string } | null {\\n  const id =\\n    c.screen === 'attract' && ATTRACT[c.clip].kind === 'story'\\n      ? ATTRACT[c.clip].id\\n      : c.screen === 'story'\\n        ? c.storyId\\n470→        : '';\\n  if (!id) return null;\\n  const scene = sceneById(id);\\n  if (!scene) return null;\\n  const box = scene.boxes[Math.min(c.box, scene.boxes.length - 1)];\\n  return { who: box.who, text: box.text, drama: box.drama ?? '', where: scene.where };\\n}\\n\\nexport function handbookPage(c: Campaign): { title: string; body: string; index: number; count: number } {\\n  const cards = handbookCards();\\n480→  const index = ((c.page % cards.length) + cards.length) % cards.length;\\n  return { ...cards[index], index, count: cards.length };\\n}\\n\\nfunction go(c: Campaign, screen: Screen): void {\\n  c.back = c.screen === screen ? c.back : c.screen;\\n  c.screen = screen;\\n  c.focus = 0;\\n  c.page = 0;\\n}\\n490→\\nfunction startShift(c: Campaign): void {\\n  c.progress.cleared = 0;\\n  c.progress.ranks = [];\\n  c.progress.scores = [];\\n  c.progress.postcards = [];\\n  c.record = true;\\n  openCase(c, 0, 'before');\\n}\\n\\n500→function continueShift(c: Campaign): void {\\n  const index = Math.min(c.progress.cleared, storyCases().length - 1);\\n  const leg = c.progress.ranks[index] ? 'after' : 'before';\\n  c.record = true;\\n  openCase(c, index, leg);\\n}\\n\\nfunction openBoard(c: Campaign): void {\\n  const ids = boardIds(c.progress);\\n  const id = ids[c.board] ?? ids[0];\\n510→  if (id === 'case:gala-shift') {\\n    c.caseId = id;\\n    c.caseIndex = -1;\\n    c.record = false;\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  const index = storyCases().findIndex((item) => item.id === id);\\n  const unlocked = c.progress.free || index <= c.progress.cleared;\\n520→  if (!unlocked || index < 0) return;\\n  c.record = index === c.progress.cleared;\\n  c.caseIndex = index;\\n  c.caseId = storyCases()[index].id;\\n  c.screen = 'brief';\\n  c.focus = 0;\\n}\\n\\nfunction openCase(c: Campaign, index: number, leg: 'before' | 'after'): void {\\n  const def = storyCases()[index];\\n530→  if (!def) {\\n    c.screen = 'credits';\\n    return;\\n  }\\n  c.caseIndex = index;\\n  c.caseId = def.id;\\n  c.leg = leg;\\n  c.storyId = leg === 'before' ? def.storyBefore : def.storyAfter;\\n  c.box = 0;\\n  c.lineMs = 0;\\n540→  c.screen = 'story';\\n}\\n\\nfunction advanceStory(c: Campaign): void {\\n  const scene = sceneById(c.storyId);\\n  if (!scene) return;\\n  if (c.box < scene.boxes.length - 1) {\\n    c.box += 1;\\n    return;\\n  }\\n550→  finishScene(c);\\n}\\n\\nfunction finishScene(c: Campaign): void {\\n  if (c.leg === 'before') {\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.progress.cleared = Math.max(c.progress.cleared, c.caseIndex + 1);\\n560→  if (c.progress.cleared >= storyCases().length) {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.screen = 'credits';\\n    c.page = 0;\\n    return;\\n  }\\n  openCase(c, c.progress.cleared, 'before');\\n}\\n\\n570→function afterWin(c: Campaign): void {\\n  if (c.caseIndex < 0) {\\n    c.screen = 'board';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.leg = 'after';\\n  const def = storyCases()[c.caseIndex];\\n  c.storyId = def?.storyAfter ?? 'after-1';\\n  c.box = 0;\\n580→  c.screen = 'story';\\n}\\n\\nfunction retryCase(c: Campaign): void {\\n  c.boot += 1;\\n  c.keepPhase = false;\\n  c.screen = 'op';\\n  c.won = false;\\n}\\n\\n590→function enterAttract(c: Campaign): void {\\n  c.screen = 'attract';\\n  c.clip = 0;\\n  c.clipMs = ATTRACT[0].ms;\\n  c.box = 0;\\n  c.record = false;\\n}\\n\\nfunction leaveAttract(c: Campaign): void {\\n  c.screen = 'title';\\n600→  c.focus = 0;\\n  c.idle = 0;\\n  c.record = true;\\n}\\n\\nfunction cycleSetting(c: Campaign, id: string): void {\\n  const p = c.progress;\\n  const volume = (n: number) => [0, 10, 40, 70, 100][([0, 10, 40, 70, 100].indexOf(n) + 1) % 5] ?? 70;\\n  if (id === 'master') p.master = volume(p.master);\\n  if (id === 'music') p.music = volume(p.music);\\n610→  if (id === 'effects') p.effects = volume(p.effects);\\n  if (id === 'voice') p.voice = volume(p.voice);\\n  if (id === 'glyphs') p.glyphs = p.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n  if (id === 'difficulty') {\\n    const order: Difficulty[] = ['intern', 'resident', 'attending'];\\n    const next = order[(order.indexOf(p.difficulty) + 1) % 3];\\n    if (next === 'attending' && !p.attending && !p.free) return;\\n    p.difficulty = next;\\n  }\\n  if (id === 'simple') p.simple = !p.simple;\\n620→  if (id === 'autoText') p.autoText = !p.autoText;\\n  if (id === 'blood') p.blood = p.blood === 'red' ? 'teal' : p.blood === 'teal' ? 'off' : 'red';\\n  if (id === 'hud') c.hideHud = !c.hideHud;\\n}\\n\\nexport function claimSeat(c: Campaign, index: number): void {\\n  if (index < 0 || index > 3) return;\\n  c.claimed[index] = true;\\n  c.idle = 0;\\n}\\n\",\"content_concise\":\"280→}\\n\\nexport function browse(c: Campaign, dir: number): void {\\n  c.idle = 0;\\n  if (c.screen === 'board') {\\n    const ids = boardIds(c.progress);\\n    c.board = (c.board + dir + ids.length) % ids.length;\\n    return;\\n  }\\n  if (c.screen === 'settings') {\\n290→    c.page = (c.page + dir + 4) % 4;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'handbook') {\\n    const n = handbookCards().length;\\n    c.page = (c.page + dir + n) % n;\\n    return;\\n  }\\n  if (c.screen === 'about' || c.screen === 'credits') {\\n300→    c.page = Math.max(0, c.page + dir);\\n    return;\\n  }\\n  if (c.screen === 'dev') {\\n    c.devTab = (c.devTab + dir + 5) % 5;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'story') c.box = Math.max(0, c.box + dir);\\n}\\n310→\\nexport function accept(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') return advanceStory(c);\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  const row = items(c)[c.focus];\\n  if (!row) return;\\n  act(c, row.id);\\n}\\n\\n320→export function act(c: Campaign, id: string): void {\\n  c.idle = 0;\\n  if (id === 'back') return cancel(c);\\n  if (id === 'new') return startShift(c);\\n  if (id === 'continue') return continueShift(c);\\n  if (id === 'board') return go(c, 'board');\\n  if (id === 'scrub') return go(c, 'scrub');\\n  if (id === 'settings') return go(c, 'settings');\\n  if (id === 'about') return go(c, 'about');\\n  if (id === 'handbook') return go(c, 'handbook');\\n330→  if (id === 'controls') {\\n    go(c, 'settings');\\n    c.page = 1;\\n    return;\\n  }\\n  if (id === 'dev') return go(c, 'dev');\\n  if (id === 'play' && c.screen === 'board') return openBoard(c);\\n  if (id === 'postcards') {\\n    c.tab = c.tab === 0 ? 1 : 0;\\n    return;\\n340→  }\\n  if (id === 'start' && c.screen === 'brief') {\\n    c.boot += 1;\\n    c.keepPhase = false;\\n    c.screen = 'op';\\n    c.record = c.caseIndex >= 0 && c.caseIndex === c.progress.cleared;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'scrub') {\\n    c.progress.seats = Math.max(1, c.claimed.filter(Boolean).length);\\n350→    c.screen = 'title';\\n    return;\\n  }\\n  if (id === 'next' && c.won) return afterWin(c);\\n  if (id === 'retry') return retryCase(c);\\n  if (id === 'phase') {\\n    c.boot += 1;\\n    c.keepPhase = true;\\n    c.screen = 'op';\\n    return;\\n360→  }\\n  if (id === 'resume') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'unlock') {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.progress.cleared = storyCases().length;\\n    return;\\n370→  }\\n  cycleSetting(c, id);\\n}\\n\\nexport function cancel(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') {\\n    finishScene(c);\\n    return;\\n  }\\n380→  if (c.screen === 'op') {\\n    c.back = 'op';\\n    c.screen = 'pause';\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'pause') {\\n    c.screen = 'op';\\n    return;\\n  }\\n390→  if (c.screen === 'attract') return leaveAttract(c);\\n  if (c.screen === 'credits') {\\n    c.screen = 'title';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.screen = c.back === c.screen ? 'title' : c.back;\\n  if (c.screen === 'pause' || c.screen === 'title') c.focus = 0;\\n}\\n\\n400→export function noteInput(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'attract') leaveAttract(c);\\n}\\n\\nexport function tickFront(c: Campaign, dtMs: number, inSession: boolean): void {\\n  if (inSession) return;\\n  if (c.screen === 'attract') {\\n    c.clipMs -= dtMs;\\n    if (c.clipMs <= 0) {\\n410→      c.clip = (c.clip + 1) % ATTRACT.length;\\n      c.clipMs = ATTRACT[c.clip].ms;\\n      if (ATTRACT[c.clip].kind === 'story') c.box = 0;\\n    }\\n    return;\\n  }\\n  if (c.screen === 'story' && c.progress.autoText) {\\n    c.lineMs += dtMs;\\n    if (c.lineMs > 2500) {\\n      c.lineMs = 0;\\n420→      advanceStory(c);\\n    }\\n  }\\n  if (!MENUS.includes(c.screen)) return;\\n  c.idle += dtMs;\\n  if (c.idle >= 10000) enterAttract(c);\\n}\\n\\nexport function finishOp(c: Campaign, won: boolean, score: number, slips: number, fail: string): void {\\n  if (c.screen !== 'op') return;\\n430→  const def = caseById(c.caseId);\\n  c.won = won;\\n  c.fail = won ? '' : fail || 'Called off.';\\n  c.lastScore = score;\\n  if (won) {\\n    const rank = rankFor(score, def.par, slips, c.progress.difficulty);\\n    c.lastRank = rank;\\n    const letter = rank === '★' ? 'S' : (rank as Exclude<Rank, '★'>);\\n    c.postcard = def.patients[0]?.postcards[letter] ?? '';\\n    const prev = c.progress.scores[c.caseIndex];\\n440→    const better = prev === undefined || score > prev;\\n    if (c.caseIndex >= 0 && (c.record || better)) {\\n      c.progress.ranks[c.caseIndex] = rank;\\n      c.progress.scores[c.caseIndex] = score;\\n      c.progress.postcards[c.caseIndex] = c.postcard;\\n    }\\n  }\\n  c.screen = 'debrief';\\n  c.focus = 0;\\n}\\n450→\\nexport function desiredRun(c: Campaign): string {\\n  if (c.screen === 'op') return `op:${c.caseId}`;\\n  if (c.screen === 'attract') {\\n    const clip = ATTRACT[c.clip];\\n    if (clip.kind === 'op') return `op:${clip.id}`;\\n  }\\n  return 'title';\\n}\\n\\n460→export function desiredAttract(c: Campaign): boolean {\\n  return c.screen === 'attract' && ATTRACT[c.clip].kind === 'op';\\n}\\n\\nexport function currentBox(c: Campaign): { who: string; text: string; drama: string; where: string } | null {\\n  const id =\\n    c.screen === 'attract' && ATTRACT[c.clip].kind === 'story'\\n      ? ATTRACT[c.clip].id\\n      : c.screen === 'story'\\n        ? c.storyId\\n470→        : '';\\n  if (!id) return null;\\n  const scene = sceneById(id);\\n  if (!scene) return null;\\n  const box = scene.boxes[Math.min(c.box, scene.boxes.length - 1)];\\n  return { who: box.who, text: box.text, drama: box.drama ?? '', where: scene.where };\\n}\\n\\nexport function handbookPage(c: Campaign): { title: string; body: string; index: number; count: number } {\\n  const cards = handbookCards();\\n480→  const index = ((c.page % cards.length) + cards.length) % cards.length;\\n  return { ...cards[index], index, count: cards.length };\\n}\\n\\nfunction go(c: Campaign, screen: Screen): void {\\n  c.back = c.screen === screen ? c.back : c.screen;\\n  c.screen = screen;\\n  c.focus = 0;\\n  c.page = 0;\\n}\\n490→\\nfunction startShift(c: Campaign): void {\\n  c.progress.cleared = 0;\\n  c.progress.ranks = [];\\n  c.progress.scores = [];\\n  c.progress.postcards = [];\\n  c.record = true;\\n  openCase(c, 0, 'before');\\n}\\n\\n500→function continueShift(c: Campaign): void {\\n  const index = Math.min(c.progress.cleared, storyCases().length - 1);\\n  const leg = c.progress.ranks[index] ? 'after' : 'before';\\n  c.record = true;\\n  openCase(c, index, leg);\\n}\\n\\nfunction openBoard(c: Campaign): void {\\n  const ids = boardIds(c.progress);\\n  const id = ids[c.board] ?? ids[0];\\n510→  if (id === 'case:gala-shift') {\\n    c.caseId = id;\\n    c.caseIndex = -1;\\n    c.record = false;\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  const index = storyCases().findIndex((item) => item.id === id);\\n  const unlocked = c.progress.free || index <= c.progress.cleared;\\n520→  if (!unlocked || index < 0) return;\\n  c.record = index === c.progress.cleared;\\n  c.caseIndex = index;\\n  c.caseId = storyCases()[index].id;\\n  c.screen = 'brief';\\n  c.focus = 0;\\n}\\n\\nfunction openCase(c: Campaign, index: number, leg: 'before' | 'after'): void {\\n  const def = storyCases()[index];\\n530→  if (!def) {\\n    c.screen = 'credits';\\n    return;\\n  }\\n  c.caseIndex = index;\\n  c.caseId = def.id;\\n  c.leg = leg;\\n  c.storyId = leg === 'before' ? def.storyBefore : def.storyAfter;\\n  c.box = 0;\\n  c.lineMs = 0;\\n540→  c.screen = 'story';\\n}\\n\\nfunction advanceStory(c: Campaign): void {\\n  const scene = sceneById(c.storyId);\\n  if (!scene) return;\\n  if (c.box < scene.boxes.length - 1) {\\n    c.box += 1;\\n    return;\\n  }\\n550→  finishScene(c);\\n}\\n\\nfunction finishScene(c: Campaign): void {\\n  if (c.leg === 'before') {\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.progress.cleared = Math.max(c.progress.cleared, c.caseIndex + 1);\\n560→  if (c.progress.cleared >= storyCases().length) {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.screen = 'credits';\\n    c.page = 0;\\n    return;\\n  }\\n  openCase(c, c.progress.cleared, 'before');\\n}\\n\\n570→function afterWin(c: Campaign): void {\\n  if (c.caseIndex < 0) {\\n    c.screen = 'board';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.leg = 'after';\\n  const def = storyCases()[c.caseIndex];\\n  c.storyId = def?.storyAfter ?? 'after-1';\\n  c.box = 0;\\n580→  c.screen = 'story';\\n}\\n\\nfunction retryCase(c: Campaign): void {\\n  c.boot += 1;\\n  c.keepPhase = false;\\n  c.screen = 'op';\\n  c.won = false;\\n}\\n\\n590→function enterAttract(c: Campaign): void {\\n  c.screen = 'attract';\\n  c.clip = 0;\\n  c.clipMs = ATTRACT[0].ms;\\n  c.box = 0;\\n  c.record = false;\\n}\\n\\nfunction leaveAttract(c: Campaign): void {\\n  c.screen = 'title';\\n600→  c.focus = 0;\\n  c.idle = 0;\\n  c.record = true;\\n}\\n\\nfunction cycleSetting(c: Campaign, id: string): void {\\n  const p = c.progress;\\n  const volume = (n: number) => [0, 10, 40, 70, 100][([0, 10, 40, 70, 100].indexOf(n) + 1) % 5] ?? 70;\\n  if (id === 'master') p.master = volume(p.master);\\n  if (id === 'music') p.music = volume(p.music);\\n610→  if (id === 'effects') p.effects = volume(p.effects);\\n  if (id === 'voice') p.voice = volume(p.voice);\\n  if (id === 'glyphs') p.glyphs = p.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n  if (id === 'difficulty') {\\n    const order: Difficulty[] = ['intern', 'resident', 'attending'];\\n    const next = order[(order.indexOf(p.difficulty) + 1) % 3];\\n    if (next === 'attending' && !p.attending && !p.free) return;\\n    p.difficulty = next;\\n  }\\n  if (id === 'simple') p.simple = !p.simple;\\n620→  if (id === 'autoText') p.autoText = !p.autoText;\\n  if (id === 'blood') p.blood = p.blood === 'red' ? 'teal' : p.blood === 'teal' ? 'off' : 'red';\\n  if (id === 'hud') c.hideHud = !c.hideHud;\\n}\\n\\nexport function claimSea