) return inject(op, seat, use, edge);\"},{\"line_number\":392,\"content\":\"function syringe(op: Op, seat: Seat, near: Target | null, use: boolean, edge: boolean): void {\"},{\"line_number\":398,\"content\":\"    if (!applied && edge)\"},{\"line_number\":403,\"content\":\"    if (edge) bark(op, seat, near, refusalLine('syringe', near.kind));\"},{\"line_number\":406,\"content\":\"  inject(op, seat, use, edge);\"},{\"line_number\":410,\"content\":\"function inject(op: Op, seat: Seat, use: boolean, edge: boolean): boolean {\"},{\"line_number\":417,\"content\":\"  if (edge) return true;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/world.ts\",\"matches\":[{\"line_number\":275,\"content\":\"    paddle: false,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/story.ts\",\"matches\":[{\"line_number\":289,\"content\":\"      'WREN: Sorry, Maris. You cannot hear me. Your pledge is not the thing I am here to collect.',\"},{\"line_number\":300,\"content\":\"      'MARIS: I am cancelling the pledge. Spend it on gloves.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/sequencer.ts\",\"matches\":[{\"line_number\":25,\"content\":\"    paddle: false,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/types.ts\",\"matches\":[{\"line_number\":143,\"content\":\"  paddle: boolean;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-202611