6.4, WP 2.7; doctrine: Reproducible): fixed sim steps plus interpolation, once per\"},{\"line_number\":4,\"content\":\" * asks the clock (engine/core/time.ts) how many fixed 1/60 s steps the real time since the last frame holds (at most\"},{\"line_number\":36,\"content\":\"  step(intents: Record<string, unknown>): void;\"},{\"line_number\":37,\"content\":\"  /** Draws the view at the clock's `alpha`; `dt` is the real seconds since the last frame. */\"},{\"line_number\":38,\"content\":\"  draw(frame: { alpha: number; dt: number }): void;\"},{\"line_number\":118,\"content\":\"        for (let k = 0; k < frame.steps; k++) options.step(k === 0 ? first : later);\"},{\"line_number\":121,\"content\":\"      options.draw({ alpha: frame.alpha, dt: frame.elapsed });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/app/damageNumbers.ts\",\"matches\":[{\"line_number\":15,\"content\":\" * // ui.update(camera, dt);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/app/animMember.ts\",\"matches\":[{\"line_number\":26,\"content\":\" * const floor = { type: 'fixed', colliders: [{ shape: { type: 'box', size: [40, 1, 40] }, position: [0, -0.5, 0] }] };\"},{\"line_number\":33,\"content\":\" * engine.step(30, { move: [1, 0] });\"},{\"line_number\":67,\"content\":\"    const made = new AnimatorPool().get(found.id, animator, { dt: world.dt });\"},{\"line_number\":68,\"content\":\"    if (clips) made.use('clips', clipPoolOf(world).get(found.id, clips, made.body.build, world.dt));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/app/store.ts\",\"matches\":[{\"line_number\":19,\"content\":\" * never throwing), the fixed `my3d2dge:` prefix made the store's own.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/app/viewMembers.ts\",\"matches\":[{\"line_number\":76,\"content\":\"        'What to read back (engine/gfx/shot.ts ShotOptions): ids, metrics, thumbnail, marks, pixels (booleans), width and height.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/app/view.ts\",\"matches\":[{\"line_number\":6,\"content\":\" * run: `stepped()` after every sim step reads where the entities are, `frame({ alpha, dt, aspect })` puts every\"},{\"line_number\":37,\"content\":\" * // view.stepped(); // after each sim step; then gfx.frame(view.frame({ alpha, dt, aspect }))\"},{\"line_number\":116,\"content\":\"  dt: number;\"},{\"line_number\":198,\"content\":\"    stage.capture(placed(run, stage.kinds), run.world.dt, queries());\"},{\"line_number\":235,\"content\":\"    if (fresh) rig.step(null);\"},{\"line_number\":249,\"content\":\"    rig.step(doing);\"},{\"line_number\":267,\"content\":\"  /** Steps the camera by `dt` with `input`, then draws the player for a first-person camera: his arms, his body hidden. */\"},{\"line_number\":268,\"content\":\"  const move = (input: CameraInput | undefined, dt: number): CameraPose => {\"},{\"line_number\":272,\"content\":\"    const pose = rig.update({ ...follow(), ...input }, dt);\"},{\"line_number\":275,\"content\":\"    const first = rig.firstShare() > 0.5 ? { pose, dt, aspect, player: doing, effects: rig.effects(), ...lens } : null;\"},{\"line_number\":302,\"content\":\"      stage.capture(placed(run, stage.kinds), run.world.dt, queries());\"},{\"line_number\":327,\"content\":\"      drawn = pair.place(move(frame.input, frame.dt), aspect);\"},{\"line_number\":328,\"content\":\"    