time now, as the cap would: the host pressed \\\"End round\\\". */\\n    timeUp() {\\n      if (phase === 'countdown' || phase === 'playing') timeUp();\\n    },\\n580→    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\\n    progress(id, score) {\\n      const seat = seats[id];\\n      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\\n    },\\n    /** End the round now: the session ended, or the host skipped this game. */\\n    abort(reason = 'skipped') {\\n      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\\n    },\\n    get phase() {\\n590→      return phase;\\n    },\\n    get released() {\\n      return released;\\n    },\\n    get record() {\\n      return record;\\n    },\\n    get mode() {\\n      return mode;\\n600→    },\\n    seats: () => seats.map((s) => ({ ...s, hidden: undefined })),\\n  };\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/tools/hub/round.js\",\"offset\":560,\"limit\":50,\"raw_output\":\"    if (released || phase !== 'loading') return;\\n    released = true;\\n    later(\\n      t.loadGraceMs,\\n      sitOut((s) => !s.ready),\\n    );\\n    status();\\n    settle();\\n  }\\n\\n  startRound();\\n\\n  return {\\n    receive,\\n    leave,\\n    release,\\n    /** Call time now, as the cap would: the host pressed \\\"End round\\\". */\\n    timeUp() {\\n      if (phase === 'countdown' || phase === 'playing') timeUp();\\n    },\\n    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\\n    progress(id, score) {\\n      const seat = seats[id];\\n      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\\n    },\\n    /** End the round now: the session ended, or the host skipped this game. */\\n    abort(reason = 'skipped') {\\n      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\\n    },\\n    get phase() {\\n      return phase;\\n    },\\n    get released() {\\n      return released;\\n    },\\n    get record() {\\n      return record;\\n    },\\n    get mode() {\\n      return mode;\\n    },\\n    seats: () => seats.map((s) => ({ ...s, hidden: undefined })),\\n  };\\n}\\n\",\"total_lines\":603}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"a55f7f00-2f8f-4ded-8fe1-d1973a350830"}
