0,100,45,79,112,105,110,105,111,110,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,52,55,51,49,47,101,110,103,105,110,101,47,119,111,114,108,100,47,112,114,111,112,115,47,108,105,98,114,97,114,121,46,116,115,10,51,48,58,32,42,32,76,73,66,82,65,82,89,95,80,82,79,80,83,91,39,112,114,111,112,58,116,97,98,108,101,39,93,46,98,111,100,121,46,115,105,122,101,59,32,47,47,32,91,49,46,54,44,32,48,46,55,53,44,32,48,46,57,93,10,57,56,58,32,32,39,112,114,111,112,58,116,97,98,108,101,39,58,32,123,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":4,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/world/props/fittings.ts\",\"matches\":[{\"line_number\":20,\"content\":\" * FITTING_PROPS['prop:lamp'].light.tag; // 'lamp'\"},{\"line_number\":41,\"content\":\"  'prop:lamp': {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/world/props/library.ts\",\"matches\":[{\"line_number\":30,\"content\":\" * LIBRARY_PROPS['prop:table'].body.size; // [1.6, 0.75, 0.9]\"},{\"line_number\":98,\"content\":\"  'prop:table': {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-fc3ed7da-bd33-4c00-b1eb-24aa7327f46d-32","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The house's fittings (PLAN.md WP 13.16; docs/PLAYGROUND.md §7.1): the props doors, windows and switches are\\n * made of, as plain `prop` specs the kind registers beside the catalog's and the library's (engine/world/props/\\n * prop.ts). What they do is the sim's: engine/sim/doors.ts swings and slides them, engine/sim/breakables.ts breaks\\n * them, engine/sim/switches.ts turns lamps on and off.\\n *\\n * - **The pane**: a glass pane for a window, 0.5 × 1.2 m, its collider 2 cm thick; health 1, so any hit, shot or\\n *   thrown prop breaks it into glass (`shards: 'glass'`), and the window is open. One a half metre of a window.\\n * - **The switch**: a light switch's plate and rocker for a wall, its plate's foot the origin, facing +Z; no body.\\n10→ * - **The lamp**: a ceiling lamp hanging from its origin, a cord and a glowing shade, lit while its switch is on (the\\n *   shade's part `lit`, so its state shows from above, where the isometric and top-down cameras look from), its light\\n *   tagged `lamp`; no body.\\n * - **The garage door**: a roll-up door of steel panels, 2.6 × 2.2 m; kinematic, it slides up on its switch.\\n *\\n * Invariants: plain data (the kind's fields only), ids `prop:<name>`; sizes in metres; the pane's and the garage\\n * door's bodies stand on their bases, the switch's and the lamp's parts at their mounts.\\n *\\n * @example\\n * FITTING_PROPS['prop:pane'].health; // 1: a hit breaks it\\n20→ * FITTING_PROPS['prop:lamp'].light.tag; // 'lamp'\\n * @see engine/world/props/fittings.test.ts\\n */\\nimport type { PropDefinition } from './prop';\\n\\n/** The house's fittings, by id. */\\nexport const FITTING_PROPS = {\\n  'prop:pane': {\\n    description: 'A glass pane for a window, 0.5 × 1.2 m: a hit, a shot or a thrown prop breaks it into glass.',\\n    parts: [{ name: 'glass', geometry: 'geometry:box', params: { width: 0.5, height: 1.2, depth: 0.01 }, material: 'material:glass' }], // prettier-ignore\\n30→    body: { type: 'fixed', shape: 'box', size: [0.5, 1.2, 0.02] },\\n    health: 1,\\n    breaks: { shards: 'glass' },\\n  },\\n  'prop:switch': {\\n    description: 'A light switch for a wall: a painted plate and its rocker, the plate’s foot its origin, facing +Z.',\\n    parts: [\\n      { name: 'plate', geometry: 'geometry:box', params: { width: 0.08, height: 0.12, depth: 0.012 }, material: 'material:paint', position: [0, 0, 0.006] }, // prettier-ignore\\n      { name: 'rocker', geometry: 'geometry:box', params: { width: 0.025, height: 0.045, depth: 0.012 }, material: 'material:paint', tint: '#d8d2c4', position: [0, 0.0375, 0.018] }, // prettier-ignore\\n    ],\\n40→  },\\n  'prop:lamp': {\\n    description: 'A ceiling lamp hanging from its origin: a cord and a glowing shade, lit while its switch is on.',\\n    parts: [\\n      { name: 'cord', geometry: 'geometry:box', params: { width: 0.012, height: 0.4, depth: 0.012 }, material: 'material:iron', position: [0, -0.4, 0] }, // prettier-ignore\\n      { name: 'shade', geometry: 'geometry:frustum', params: { radiusBottom: 0.2, radiusTop: 0.06, height: 0.16, radialSegments: 12, smooth: true }, material: 'material:glow', tint: '#ffe7c2', position: [0, -0.56, 0], shadow: false, lit: true }, // prettier-ignore\\n    ],\\n    light: { tag: 'lamp', color: '#ffe2b0', intensity: 8, distance: 7, decay: 1, position: [0, -0.55, 0] },\\n  },\\n  'prop:garageDoor': {\\n50→    description: 'A roll-up garage door of steel panels, 2.6 × 2.2 m and 6 cm thick: it slides up on its switch.',\\n    parts: [\\n      { name: 'panels', geometry: 'geometry:box', params: { width: 2.6, height: 2.2, depth: 0.06 }, material: 'material:paint', tint: '#c9cdd2' }, // prettier-ignore\\n      ...[0.55, 1.1, 1.65].map((y, i) => ({ name: `seam${i + 1}`, geometry: 'geometry:box', params: { width: 2.6, height: 0.02, depth: 0.01 }, material: 'material:iron', position: [0, y, 0.035] })), // prettier-ignore\\n    ],\\n    body: { type: 'kinematic', shape: 'box', size: [2.6, 2.2, 0.06] },\\n  },\\n} as const satisfies Record<string, PropDefinition>;\\n\",\"content_concise\":\"1→/**\\n * @file The house's fittings (PLAN.md WP 13.16; docs/PLAYGROUND.md §7.1): the props doors, windows and switches are\\n * made of, as plain `prop` specs the kind registers beside the catalog's and the library's (engine/world/props/\\n * prop.ts). What they do is the sim's: engine/sim/doors.ts swings and slides them, engine/sim/breakables.ts breaks\\n * them, engine/sim/switches.ts turns lamps on and off.\\n *\\n * - **The pane**: a glass pane for a window, 0.5 × 1.2 m, its collider 2 cm thick; health 1, so any hit, shot or\\n *   thrown prop breaks it into glass (`shards: 'glass'`), and the window is open. One a half metre of a window.\\n * - **The switch**: a light switch's plate and rocker for a wall, its plate's foot the origin, facing +Z; no body.\\n10→ * - **The lamp**: a ceiling lamp hanging from its origin, a cord and a glowing shade, lit while its switch is on (the\\n *   shade's part `lit`, so its state shows from above, where the isometric and top-down cameras look from), its light\\n *   tagged `lamp`; no body.\\n * - **The garage door**: a roll-up door of steel panels, 2.6 × 2.2 m; kinematic, it slides up on its switch.\\n *\\n * Invariants: plain data (the kind's fields only), ids `prop:<name>`; sizes in metres; the pane's and the garage\\n * door's bodies stand on their bases, the switch's and the lamp's parts at their mounts.\\n *\\n * @example\\n * FITTING_PROPS['prop:pane'].health; // 1: a hit breaks it\\n20→ * FITTING_PROPS['prop:lamp'].light.tag; // 'lamp'\\n * @see engine/world/props/fittings.test.ts\\n */\\nimport type { PropDefinition } from './prop';\\n\\n/** The house's fittings, by id. */\\nexport const FITTING_PROPS = {\\n  'prop:pane': {\\n    description: 'A glass pane for a window, 0.5 × 1.2 m: a hit, a shot or a thrown prop breaks it into glass.',\\n    parts: [{ name: 'glass', geometry: 'geometry:box', params: { width: 0.5, height: 1.2, depth: 0.01 }, material: 'material:glass' }], // prettier-ignore\\n30→    body: { type: 'fixed', shape: 'box', size: [0.5, 1.2, 0.02] },\\n    health: 1,\\n    breaks: { shards: 'glass' },\\n  },\\n  'prop:switch': {\\n    description: 'A light switch for a wall: a painted plate and its rocker, the plate’s foot its origin, facing +Z.',\\n    parts: [\\n      { name: 'plate', geometry: 'geometry:box', params: { width: 0.08, height: 0.12, depth: 0.012 }, material: 'material:paint', position: [0, 0, 0.006] }, // prettier-ignore\\n      { name: 'rocker', geometry: 'geometry:box', params: { width: 0.025, height: 0.045, depth: 0.012 }, material: 'material:paint', tint: '#d8d2c4', position: [0, 0.0375, 0.018] }, // prettier-ignore\\n    ],\\n40→  },\\n  'prop:lamp': {\\n    description: 'A ceiling lamp hanging from its origin: a cord and a glowing shade, lit while its switch is on.',\\n    parts: [\\n      { name: 'cord', geometry: 'geometry:box', params: { width: 0.012, height: 0.4, depth: 0.012 }, material: 'material:iron', position: [0, -0.4, 0] }, // prettier-ignore\\n      { name: 'shade', geometry: 'geometry:frustum', params: { radiusBottom: 0.2, radiusTop: 0.06, height: 0.16, radialSegments: 12, smooth: true }, material: 'material:glow', tint: '#ffe7c2', position: [0, -0.56, 0], shadow: false, lit: true }, // prettier-ignore\\n    ],\\n    light: { tag: 'lamp', color: '#ffe2b0', intensity: 8, distance: 7, decay: 1, position: [0, -0.55, 0] },\\n  },\\n  'prop:garageDoor': {\\n50→    description: 'A roll-up garage door of steel panels, 2.6 × 2.2 m and 6 cm thick: it slides up on its switch.',\\n    parts: [\\n      { name: 'panels', geometry: 'geometry:box', params: { width: 2.6, height: 2.2, depth: 0.06 }, material: 'material:paint', tint: '#c9cdd2' }, // prettier-ignore\\n      ...[0.55, 1.1, 1.65].map((y, i) => ({ name: `seam${i + 1}`, geometry: 'geometry:box', params: { width: 2.6, height: 0.02, depth: 0.01 }, material: 'material:iron', position: [0, y, 0.035] })), // prettier-ignore\\n    ],\\n    body: { type: 'kinematic', shape: 'box', size: [2.6, 2.2, 0.06] },\\n  },\\n} as const satisfies Record<string, PropDefinition>;\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/world/props/fittings.ts\",\"offset\":null,\"limit\":80,\"raw_output\":\"/**\\n * @file The house's fittings (PLAN.md WP 13.16; docs/PLAYGROUND.md §7.1): the props doors, windows and switches are\\n * made of, as plain `prop` specs the kind registers beside the catalog's and the library's (engine/world/props/\\n * prop.ts). What they do is the sim's: engine/sim/doors.ts swings and slides them, engine/sim/breakables.ts breaks\\n * them, engine/sim/switches.ts turns lamps on and off.\\n *\\n * - **The pane**: a glass pane for a window, 0.5 × 1.2 m, its collider 2 cm thick; health 1, so any hit, shot or\\n *   thrown prop breaks it into glass (`shards: 'glass'`), and the window is open. One a half metre of a window.\\n * - **The switch**: a light switch's plate and rocker for a wall, its plate's foot the origin, facing +Z; no body.\\n * - **The lamp**: a ceiling lamp hanging from its origin, a cord and a glowing shade, lit while its switch is on (the\\n *   shade's part `lit`, so its state shows from above, where the isometric and top-down cameras look from), its light\\n *   tagged `lamp`; no body.\\n * - **The garage door**: a roll-up door of steel panels, 2.6 × 2.2 m; kinematic, it slides up on its switch.\\n *\\n * Invariants: plain data (the kind's fields only), ids `prop:<name>`; sizes in metres; the pane's and the garage\\n * door's bodies stand on their bases, the switch's and the lamp's parts at their mounts.\\n *\\n * @example\\n * FITTING_PROPS['prop:pane'].health; // 1: a hit breaks it\\n * FITTING_PROPS['prop:lamp'].light.tag; // 'lamp'\\n * @see engine/world/props/fittings.test.ts\\n */\\nimport type { PropDefinition } from './prop';\\n\\n/** The house's fittings, by id. */\\nexport const FITTING_PROPS = {\\n  'prop:pane': {\\n    description: 'A glass pane for a window, 0.5 × 1.2 m: a hit, a shot or a thrown prop breaks it into glass.',\\n    parts: [{ name: 'glass', geometry: 'geometry:box', params: { width: 0.5, height: 1.2, depth: 0.01 }, material: 'material:glass' }], // prettier-ignore\\n    body: { type: 'fixed', shape: 'box', size: [0.5, 1.2, 0.02] },\\n    health: 1,\\n    breaks: { shards: 'glass' },\\n  },\\n  'prop:switch': {\\n    description: 'A light switch for a wall: a painted plate and its rocker, the plate’s foot its origin, facing +Z.',\\n    parts: [\\n      { name: 'plate', geometry: 'geometry:box', params: { width: 0.08, height: 0.12, depth: 0.012 }, material: 'material:paint', position: [0, 0, 0.006] }, // prettier-ignore\\n      { name: 'rocker', geometry: 'geometry:box', params: { width: 0.025, height: 0.045, depth: 0.012 }, material: 'material:paint', tint: '#d8d2c4', position: [0, 0.0375, 0.018] }, // prettier-ignore\\n    ],\\n  },\\n  'prop:lamp': {\\n    description: 'A ceiling lamp hanging from its origin: a cord and a glowing shade, lit while its switch is on.',\\n    parts: [\\n      { name: 'cord', geometry: 'geometry:box', params: { width: 0.012, height: 0.4, depth: 0.012 }, material: 'material:iron', position: [0, -0.4, 0] }, // prettier-ignore\\n      { name: 'shade', geometry: 'geometry:frustum', params: { radiusBottom: 0.2, radiusTop: 0.06, height: 0.16, radialSegments: 12, smooth: true }, material: 'material:glow', tint: '#ffe7c2', position: [0, -0.56, 0], shadow: false, lit: true }, // prettier-ignore\\n    ],\\n    light: { tag: 'lamp', color: '#ffe2b0', intensity: 8, distance: 7, decay: 1, position: [0, -0.55, 0] },\\n  },\\n  'prop:garageDoor': {\\n    description: 'A roll-up garage door of steel panels, 2.6 × 2.2 m and 6 cm thick: it slides up on its switch.',\\n    parts: [\\n      { name: 'panels', geometry: 'geometry:box', params: { width: 2.6, height: 2.2, depth: 0.06 }, material: 'material:paint', tint: '#c9cdd2' }, // prettier-ignore\\n      ...[0.55, 1.1, 1.65].map((y, i) => ({ name: `seam${i + 1}`, geometry: 'geometry:box', params: { width: 2.6, height: 0.02, depth: 0.01 }, material: 'material:iron', position: [0, y, 0.035] })), // prettier-ignore\\n    ],\\n    body: { type: 'kinematic', shape: 'box', size: [2.6, 2.2, 0.06] },\\n  },\\n} as const satisfies Record<string, PropDefinition>;\\n\",\"total_lines\":57}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"b989fe15-80a8-4703-87b5-bb717150da0b"}
{"type":"assistant","message":{"id":"msg_171","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The prop:table and prop:lamp properties exist.\n\nI need to define sheet, drape, monitor, and board. The existing prop:table is a small dining table, not an operating table. I will define the four missing props using fixed bodies to prevent physics changes.\n\nAdding physics bodies is acceptable because the test compares two runs of the same code. Dynamic props would interact with the player and reduce determinism, so fixed or none types are preferable.","signature":""},{"type":"tool_use","id":"call-86a0dda8-2676-45aa-a865-ff6110b31a37-33","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/sim/props.ts","offset":120,"limit":80}},{"type":"tool_use","id":"call-86a0dda8-2676-45aa-a865-ff6110b31a37-34","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/world/props/library.ts","offset":90,"limit":40}},{"type":"tool_use","id":"call-86a0dda8-2676-45aa-a865-ff6110b31a37-35","name":"grep","input":{"pattern":"eslint.*sim-api|no-restricted-imports|three","glob":"**/eslint.config.*"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3176,"output_tokens":621,"cache_read_input_tokens":75264,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"8a4cea9a-d124-42e9-b6a6-fc3df5f8c099"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-86a0dda8-2676-45aa-a865-ff6110b31a37-33","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"120→  defineComponent('propLight', { description: \\\"A switchable prop's state (WP 13.16).\\\", fields }, registry);\\n}\\ndefinePropKinds();\\n\\n/** Throws `SIM_BAD_ARGUMENT` for `id` when it is no prop. */\\nfunction propOf(w: World, id: number, where: string): ScenePropComponent {\\n  const data = (w.get(id) as Partial<ScenePropComponents> | undefined)?.sceneProp;\\n  if (!data) throw codeError('SIM_BAD_ARGUMENT', { where, value: String(id), expected: 'a prop’s id (spawnProp)' });\\n  return data;\\n}\\n130→\\n/** The system `props.readback`: every prop with a body takes its body's pose, in id order. */\\nfunction readProps(w: World): void {\\n  const physics = physicsOf(w);\\n  for (const { sceneProp } of w.query('sceneProp') as unknown as ScenePropComponents[]) {\\n    if (sceneProp.body < 0) continue;\\n    const { position: p, rotation: r } = physics.readBody(sceneProp.body);\\n    [sceneProp.x, sceneProp.y, sceneProp.z] = [p.x, p.y, p.z];\\n    sceneProp.q = [r.x, r.y, r.z, r.w];\\n  }\\n140→}\\n\\n/**\\n * Stands a prop in the scene, `spawnProp(w, { prop: 'prop:<id>', at: [x, y, z], yaw })`: its base at `at` (m), turned\\n * `yaw` about +Y (rad). It makes the prop's body (when it has one; the scene needs `physics: true` then) and an entity\\n * with the component `sceneProp`, and returns the entity's id. A missing prop id warns and stands a crate (`getProp`).\\n *\\n * @example\\n * // in a scene's setup, with physics: true and its level's bodies added (addLevelBodies(physicsOf(w), level)):\\n * // const id = spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: Math.PI / 2 }); // on the floor at x 2, z 3\\n150→ * // labs/box/scenes/hall-props.ts places the hall's props this way, from levelProps and its own spots.\\n */\\nexport function spawnProp<C extends object, E extends EventMap>(\\n  world: World<C, E>,\\n  placement: PropPlacement,\\n  options: SpawnPropOptions = {},\\n): number {\\n  const w = world as unknown as World;\\n  const entry = getProp(placement.prop);\\n  const prop = entry.id;\\n160→  const spec = propBody({ ...placement, prop }, undefined, options.as);\\n  const { position, rotation } = spec ?? propPose({ ...placement, prop });\\n  const body = spec ? physicsOf(w).addBody(spec) : -1;\\n  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\\n  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\\n  const [x, y, z] = position;\\n  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\\n  const switchable = options.on !== undefined || options.group !== undefined;\\n  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\\n  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\\n170→}\\n\\n/** The entity whose prop `body` is (a `sceneProp`'s), or −1: the body-to-entity lookup uses and hits read (WP 13.16). */\\nexport function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\\n  if (body < 0) return -1;\\n  const props = (world as unknown as World).query('sceneProp') as unknown as (ScenePropComponents & { id: number })[];\\n  return props.find((e) => e.sceneProp.body === body)?.id ?? -1;\\n}\\n\\n/** The entity whose body is `body` (a body id; −1 for none): a prop's (`propOfBody`), else an actor's; −1 for neither. */\\n180→export function entityOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\\n  const prop = propOfBody(world, body);\\n  if (prop >= 0 || body < 0) return prop;\\n  const actors = (world as unknown as World).query('actor') as unknown as { id: number; actor: { body: number } }[];\\n  return actors.find((e) => e.actor.body === body)?.id ?? -1;\\n}\\n\\n/** Removes a prop: its entity and its body, its component's `body` −1 at once (inside a step the entity stays to its end). Throws `SIM_BAD_ARGUMENT` for an id that is no prop. */ // prettier-ignore\\nexport function removeProp<C extends object, E extends EventMap>(world: World<C, E>, id: number): void {\\n  const w = world as unknown as World;\\n190→  const data = propOf(w, id, 'removeProp(w, id)');\\n  if (data.body >= 0) physicsOf(w).removeBody(data.body);\\n  data.body = -1; // inside a step its entity stays to the step's end: nothing reads the body it no longer has\\n  w.despawn(id);\\n}\\n\\n/**\\n * Hits the prop `id` from `from` (m): calls its `hit` hook, whose `knock(more)` knocks its body away from `from` with\\n * `strength` under `more` (engine/physics/bodies.ts's `knock`: 4.6875 m/s across, 2.5 m/s up, no twist by default).\\n * Draw `spin` from a sim stream (`w.rng('knock').range(-0.5, 0.5)`). Throws `SIM_BAD_ARGUMENT` for an id that is no prop.\",\"content_concise\":\"120→  defineComponent('propLight', { description: \\\"A switchable prop's state (WP 13.16).\\\", fields }, registry);\\n}\\ndefinePropKinds();\\n\\n/** Throws `SIM_BAD_ARGUMENT` for `id` when it is no prop. */\\nfunction propOf(w: World, id: number, where: string): ScenePropComponent {\\n  const data = (w.get(id) as Partial<ScenePropComponents> | undefined)?.sceneProp;\\n  if (!data) throw codeError('SIM_BAD_ARGUMENT', { where, value: String(id), expected: 'a prop’s id (spawnProp)' });\\n  return data;\\n}\\n130→\\n/** The system `props.readback`: every prop with a body takes its body's pose, in id order. */\\nfunction readProps(w: World): void {\\n  const physics = physicsOf(w);\\n  for (const { sceneProp } of w.query('sceneProp') as unknown as ScenePropComponents[]) {\\n    if (sceneProp.body < 0) continue;\\n    const { position: p, rotation: r } = physics.readBody(sceneProp.body);\\n    [sceneProp.x, sceneProp.y, sceneProp.z] = [p.x, p.y, p.z];\\n    sceneProp.q = [r.x, r.y, r.z, r.w];\\n  }\\n140→}\\n\\n/**\\n * Stands a prop in the scene, `spawnProp(w, { prop: 'prop:<id>', at: [x, y, z], yaw })`: its base at `at` (m), turned\\n * `yaw` about +Y (rad). It makes the prop's body (when it has one; the scene needs `physics: true` then) and an entity\\n * with the component `sceneProp`, and returns the entity's id. A missing prop id warns and stands a crate (`getProp`).\\n *\\n * @example\\n * // in a scene's setup, with physics: true and its level's bodies added (addLevelBodies(physicsOf(w), level)):\\n * // const id = spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: Math.PI / 2 }); // on the floor at x 2, z 3\\n150→ * // labs/box/scenes/hall-props.ts places the hall's props this way, from levelProps and its own spots.\\n */\\nexport function spawnProp<C extends object, E extends EventMap>(\\n  world: World<C, E>,\\n  placement: PropPlacement,\\n  options: SpawnPropOptions = {},\\n): number {\\n  const w = world as unknown as World;\\n  const entry = getProp(placement.prop);\\n  const prop = entry.id;\\n160→  const spec = propBody({ ...placement, prop }, undefined, options.as);\\n  const { position, rotation } = spec ?? propPose({ ...placement, prop });\\n  const body = spec ? physicsOf(w).addBody(spec) : -1;\\n  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\\n  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\\n  const [x, y, z] = position;\\n  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\\n  const switchable = options.on !== undefined || options.group !== undefined;\\n  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\\n  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\\n170→}\\n\\n/** The entity whose prop `body` is (a `sceneProp`'s), or −1: the body-to-entity lookup uses and hits read (WP 13.16). */\\nexport function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\\n  if (body < 0) return -1;\\n  const props = (world as unknown as World).query('sceneProp') as unknown as (ScenePropComponents & { id: number })[];\\n  return props.find((e) => e.sceneProp.body === body)?.id ?? -1;\\n}\\n\\n/** The entity whose body is `body` (a body id; −1 for none): a prop's (`propOfBody`), else an actor's; −1 for neither. */\\n180→export function entityOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\\n  const prop = propOfBody(world, body);\\n  if (prop >= 0 || body < 0) return prop;\\n  const actors = (world as unknown as World).query('actor') as unknown as { id: number; actor: { body: number } }[];\\n  return actors.find((e) => e.actor.body === body)?.id ?? -1;\\n}\\n\\n/** Removes a prop: its entity and its body, its component's `body` −1 at once (inside a step the entity stays to its end). Throws `SIM_BAD_ARGUMENT` for an id that is no prop. */ // prettier-ignore\\nexport function removeProp<C extends object, E extends EventMap>(world: World<C, E>, id: number): void {\\n  const w = world as unknown as World;\\n190→  const data = propOf(w, id, 'removeProp(w, id)');\\n  if (data.body >= 0) physicsOf(w).removeBody(data.body);\\n  data.body = -1; // inside a step its entity stays to the step's end: nothing reads the body it no longer has\\n  w.despawn(id);\\n}\\n\\n/**\\n * Hits the prop `id` from `from` (m): calls its `hit` hook, whose `knock(more)` knocks its body away from `from` with\\n * `strength` under `more` (engine/physics/bodies.ts's `knock`: 4.6875 m/s across, 2.5 m/s up, no twist by default).\\n * Draw `spin` from a sim stream (`w.rng('knock').range(-0.5, 0.5)`). Throws `SIM_BAD_ARGUMENT` for an id that is no prop.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh