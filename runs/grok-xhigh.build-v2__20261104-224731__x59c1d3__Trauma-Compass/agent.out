r\":[],\"exit_code\":0,\"match_count\":32,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/scenes/main.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * The chart component carries a snapshot so a capture restores the body exactly. Balance sliders apply only after\"},{\"line_number\":23,\"content\":\"import { adoptOp, jumpPhase, liveOp, openRun, parseSnapshot, snapshot } from './bridge';\"},{\"line_number\":30,\"content\":\"  description: 'The operation on screen: status, the lead vitals, and a snapshot that capture restores.',\"},{\"line_number\":115,\"content\":\"  chart.blob = snapshot(op);\"},{\"line_number\":118,\"content\":\"/** If a restore put an older snapshot back, step that body instead of the one still in memory. */\"},{\"line_number\":123,\"content\":\"  if (entity.chart.blob === snapshot(op)) return;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/scenes/bridge.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file The live operation for the one running scene. The page reads it; the scene writes it. A JSON snapshot on the\"},{\"line_number\":3,\"content\":\" * chart component is what capture and restore put back, so the object here is replaced when the snapshot disagrees.\"},{\"line_number\":17,\"content\":\"/** Replace the live operation. Capture and restore call this with the parsed snapshot. */\"},{\"line_number\":23,\"content\":\" * Make the live operation the chart's snapshot. Call this after a restore and before reading cursors: the module\"},{\"line_number\":31,\"content\":\"  if (live && snapshot(live) === blob) return;\"},{\"line_number\":77,\"content\":\"/** The snapshot the chart stores. */\"},{\"line_number\":78,\"content\":\"export function snapshot(op: Op): string {\"},{\"line_number\":79,\"content\":\"  return JSON.stringify(op);\"},{\"line_number\":82,\"content\":\"/** An operation from a chart snapshot. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/boot.ts\",\"matches\":[{\"line_number\":98,\"content\":\"    const text = JSON.stringify(engine.input.record());\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/data/interview.ts\",\"matches\":[{\"line_number\":44,\"content\":\"    'Yes. The live operation sat in a module, and capture restored only the world, so the next step used the body from before the rewind until the chart snapshot was adopted. A view setting cannot be read from the sim, so the radial-slow slider cannot change the hashed clock.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/tools/hub/bridge.js\",\"matches\":[{\"line_number\":104,\"content\":\"    if (!FROM_GAME.has(msg.type)) return issue(`unknown message type ${JSON.stringify(msg.type)}`);\"},{\"line_number\":128,\"content\":\"          return issue(`answer ${JSON.stringify(msg.answer)} is not ready or more`);\"},{\"line_number\":173,\"content\":\"      text = JSON.stringify(msg.data);\"},{\"line_number\":195,\"content\":\"        return issue(`send: no player ${JSON.stringify(msg.to)} to send to`);\"},{\"line_number\":223,\"content\":\"      const size = JSON.stringify(env.d ?? null).length;\"},{\"line_number\":350,\"content\":\"        const copy = JSON.parse(JSON.stringify(env));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.