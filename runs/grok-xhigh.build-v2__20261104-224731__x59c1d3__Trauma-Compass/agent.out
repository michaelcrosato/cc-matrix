turn; // digital while a held binding waits on it\\n      if (value > 0) values.set(code, value);\\n      else values.delete(code);\\n    },\\n    used(device) {\\n      last = device;\\n    },\\n    bound(code) {\\n      codesOf('');\\n      return table.bound.has(code);\\n    },\\n  };\\n\\n  const pads: GamepadDevice = createGamepadDevice(sink, source, options.deadzone);\\n  const virtual = createVirtualDevice();\\n  const detachKeyboard = win ? attachKeyboard(win, sink) : () => {};\\n  const mouse =\\n    element && win ? attachMouse({ element, target: win, document: doc }, sink, { lookSpeed: 1 }) : undefined; // counts\\n  const touchOptions = { mode: options.touchMode, onTap: options.onTap };\\n  const touch = element && win ? attachTouch({ element, target: win }, sink, touchOptions) : undefined;\\n  const clear = () => {\\n    down.clear();\\n    taps.clear();\\n\",\"total_lines\":390}}","is_error":false},{"type":"tool_result","tool_use_id":"call-16476cd2-ede6-4d17-8146-e0571dba22ee-115","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,55,51,49,95,95,120,53,57,99,49,100,51,47,119,111,114,107,34,62,10,70,111,117,110,100,32,57,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,55,51,49,95,95,120,53,57,99,49,100,51,47,119,111,114,107,47,84,114,97,117,109,97,45,67,111,109,112,97,115,115,45,84,114,97,117,109,97,45,67,101,110,116,101,114,45,83,101,99,111,110,100,45,79,112,105,110,105,111,110,45