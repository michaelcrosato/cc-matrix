ve();\\n  recorded.push(packed);\\n  engine.step(1, { 'game:hands': packed });\\n  hashes.push(hashOp(liveOp()!));\\n}\\nconst ahead = engine.hash();\\nconsole.log('ahead', ahead, 'op', hashes.at(-1), 'tick', liveOp()!.tick);\\n\\nengine.restore(capture);\\nconst after = liveOp();\\nconst chart = engine.state().entities.find((entity) => entity.chart) as { chart?: { blob?: string; hash?: string } } | undefined;\\nconsole.log('after restore live tick', after?.tick, 'chart blob tick', chart?.chart?.blob ? parseSnapshot(chart.chart.blob).tick : 'none');\\nconsole.log('chart blob equals midSnap', chart?.chart?.blob === midSnap);\\n\\n// Path A: stale live hands (the current test)\\nadoptOp(parseSnapshot(midSnap)); // pretend we only adopt inside step, but hands already computed from stale — simulate by NOT adopting until inside... \\n// Actually restore left live at tick 50. Re-set live to the ahead op to simulate the bug, then step with handFromLive which reads stale then reconcile adopts.\\n// We already restored. live is still the tick-50 object because restore doesn't touch the module.\\nconsole.log('module still ahead?', liveOp()?.tick);\\n\\nconst staleHashes: string[] = [];\\nfor (let i = 0; i < 20; i++) {\\n  const packed = handFromLive(); // reads tick 50+ until first step reconciles\\n  engine.step(1, { 'game:hands': packed });\\n  staleHashes.push(hashOp(liveOp()!));\\n}\\nconsole.log('stale path', engine.hash(), 'op', staleHashes[0], 'vs', hashes[0], 'end', staleHashes.at(-1), 'tick', liveOp()?.tick);\\n\\n// Path B: recorded hands from a fresh engine\\nconst engine2 = await createHeadless({\\n  scene: main,\\n  seed: 1,\\n  settings: { 'game.run': 'op:first-cut', 'game.seed': 1 },\\n});\\nfor (let i = 0; i < 30; i++) engine2.step(1, { 'game:hands': recorded[i]! });\\nconst cap2 = engine2.capture();\\nfor (let i = 0; i < 20; i++) engine2.step(1, { 'game:hands': recorded[30 + i]! });\\nconst ahead2 = engine2.hash();\\nengine2.restore(cap2);\\nfor (let i = 0; i < 20; i++) engine2.step(1, { 'game:hands': recorded[30 + i]! });\\nconsole.log('recorded path', engine2.hash(), 'expected', ahead2, 'match', engine2.hash() === ahead2, 'tick', liveOp()?.tick);\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"d1aa7386-2610-472d-bdc0-fa33ddea3482"}
