t\":\"export { listCourses } from './dev/feel/course';\"},{\"line_number\":336,\"content\":\"export { METRICS } from './dev/feel/course';\"},{\"line_number\":340,\"content\":\"export { runCourse } from './dev/feel/run';\"},{\"line_number\":344,\"content\":\"export { createFeelPanel } from './dev/feel/panel';\"},{\"line_number\":348,\"content\":\"export { tunedSpec } from './dev/feel/profile';\"},{\"line_number\":349,\"content\":\"export { profileText } from './dev/feel/profile';\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-a885ffa0-8aee-4322-8cfd-f8356e429b1a-64","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file Looks (PLAN.md WP 7.4, §6.6 kind `look`): a material style (WP 7.2, engine/gfx/materials/styles.ts) plus a\\n * filter chain (engine/gfx/post/filters.ts), as data, and the sky that lights the scene (WP 7.8, a `sky` id,\\n * engine/gfx/sky.ts). A look names what it changes; every filter it leaves out is off, and a style or sky of `''`\\n * keeps the scene's own. The chain draws the look the setting `post.look` names (engine/gfx/post/chain.ts); switching\\n * looks writes uniforms and re-points materials to styles the warm-up has already compiled, so it builds no\\n * pipeline. A look's sky is shown by the pages `createEngine` starts (engine/app/look.ts): the stage's lights give way\\n * to it (engine/gfx/stageSky.ts), which changes the shader key, so a look with another sky warms up before it draws.\\n * WP 13.24 adds the toon style's `shade` and `dither`, what a look asks of the stage (`shells`, outline shells round\\n10→ * its props and bodies, engine/gfx/stageShells.ts; `skyGradient`, the dome as a clean gradient) and its variant for\\n * perspective cameras (`perspective`, a look id whose filters and toon numbers the chain draws there). WP 13.30 adds\\n * what it asks of the whole picture: `resolution`, the mode drawn while `gfx.resolution` is `auto`\\n * (engine/gfx/resolution.ts), and `textures`, every material's maps filtered `smooth` or `pixel`\\n * (engine/gfx/materials/library.ts `filter`); the page's look applies both (engine/app/look.ts), building nothing.\\n *\\n * The entries are seeded from shardfall's tuned presets (`shardfall:crates/pav_view/src/looks.toml`, with\\n * `look.rs:100-353`), keys renamed: its whole looks are here (`look:hd-2d`, `look:game-boy`…), and its one-section\\n * presets are looks of their own, grouped by the filter they set (`look:palette/game-boy`, `look:stylize/oil-paint`,\\n * engine/gfx/post/presets.ts). Its \\\"objects\\\" (characters and objects) is the scope `characters+objects`. Its air and\\n20→ * bounce light came with WP 11.5 (the `air` and `gi` sections, engine/gfx/post/shading.ts): the looks Sunbeams and\\n * Lamplit fog, and their presets. Left out: styles that differ by part and the knobs WP 7.2's styles lack\\n * (`flat_shadow`, `specular`, `exposure`), so four looks keep the scene's style where shardfall styled the parts\\n * apart. One rename for the lesson: \\\"64 colours\\\" posterized to 4 levels, which shifts the hue of dull colours, so it\\n * is `look:palette/512-colours`, at 8. WP 13.31 and 13.32 add Style Lab's presets and looks made by combining them\\n * (engine/gfx/post/presetsMore.ts), and every look's `combine` and `strength` (engine/gfx/post/combine.ts): the looks\\n * it lays on, how much of each and which of its filters, and how much of the whole look shows.\\n *\\n * Invariants: every look's levels are 0 or 8 and more (the kind's check); a missing id falls back to `look:clean`\\n * with a warning naming the closest ids; looks read their fields, never their ids. A game's own look is scaffolded by\\n30→ * `node x new look labs/<lab>/looks/<name>` (tools/templates/look/).\\n *\\n * @example\\n * import { createRegistry } from '../../core/registry';\\n * const registry = createRegistry();\\n * defineLooks(registry);\\n * registry.get('look', 'look:game-boy').filters.palette.palette; // 'gameboy'\\n * registry.list('look').length; // 137\\n * @see engine/gfx/post/looks.test.ts\\n * @see tests/e2e/post.spec.ts\\n40→ */\\nimport { galleryField } from '../../core/gallery';\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\\nimport type { EntryOf, Schema } from '../../core/schema';\\nimport { MATERIAL_STYLES } from '../materials/styles';\\nimport { TOON_LOOK } from '../materials/toon';\\nimport { RESOLUTION_MODES } from '../resolution';\\nimport { TEXTURE_LOOKS } from '../textures/types';\\nimport { COMBINE_FIELD, STRENGTH_FIELD, type CombineLayer } from './combine';\\nimport { colorFields, colorProblem, FILTER_FIELDS, FILTER_NAMES, levelsProblem, type FilterSpec } from './filters';\\n50→import { PRESETS } from './presets';\\nimport { COMBINED_LOOKS, STYLE_PRESETS } from './presetsMore';\\n\\n/** Where a menu lists a look: `look` for a whole look, else the filter it presets, or `shading` for a style. */\\nexport const LOOK_GROUPS = ['look', 'shading', ...FILTER_NAMES] as const;\\n\\n/** The default of every filter: all of them off. */\\nconst OFF = Object.fromEntries(Object.entries(FILTER_FIELDS).map(([name, field]) => [name, field.default]));\\n\\n/** The fields of a `look` entry; see the file comment. */\\n60→export const LOOK_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What it looks like, in plain sentences.' },\\n  group: {\\n    type: 'string',\\n    enum: LOOK_GROUPS,\\n    default: 'look',\\n    description: \\\"Where a menu lists it: 'look' for a whole look, else the filter it presets ('shading' for a style).\\\",\\n  },\\n  style: {\\n    type: 'string',\\n70→    enum: ['', ...MATERIAL_STYLES],\\n    default: '',\\n    description: \\\"The material style everything is drawn in (lambert, toon, flat, pbr); '' keeps the scene's own.\\\",\\n  },\\n  sky: {\\n    type: 'string',\\n    default: '',\\n    description:\\n      \\\"The sky preset that lights the scene (a 'sky' id: sky:hall, the torch-lit hall); '' keeps the scene's own lights.\\\",\\n  },\\n80→  toon: {\\n    type: 'object',\\n    default: { ...TOON_LOOK },\\n    description: \\\"The toon style's bands, rim, shade and dither, used when the style is 'toon'.\\\",\\n    properties: {\\n      bands: { type: 'integer', default: TOON_LOOK.bands, minimum: 2, maximum: 8, description: 'Bands of light.' },\\n      rim: { type: 'number', default: TOON_LOOK.rim, minimum: 0, maximum: 1, description: \\\"The rim light's strength.\\\" },\\n      shade: {\\n        type: 'number',\\n        default: TOON_LOOK.shade,\\n90→        minimum: 0,\\n        maximum: 1,\\n        description: \\\"How far each material's shadows shift in hue (cooler, more saturated) from its colour darkened.\\\",\\n      },\\n      dither: {\\n        type: 'number',\\n        default: TOON_LOOK.dither,\\n        minimum: 0,\\n        maximum: 1,\\n        description:\\n100→          \\\"The share of each band's step mixed by an ordered dither fixed to the world, edges hard; 0 smooths.\\\",\",\"content_concise\":\"1→/**\\n * @file Looks (PLAN.md WP 7.4, §6.6 kind `look`): a material style (WP 7.2, engine/gfx/materials/styles.ts) plus a\\n * filter chain (engine/gfx/post/filters.ts), as data, and the sky that lights the scene (WP 7.8, a `sky` id,\\n * engine/gfx/sky.ts). A look names what it changes; every filter it leaves out is off, and a style or sky of `''`\\n * keeps the scene's own. The chain draws the look the setting `post.look` names (engine/gfx/post/chain.ts); switching\\n * looks writes uniforms and re-points materials to styles the warm-up has already compiled, so it builds no\\n * pipeline. A look's sky is shown by the pages `createEngine` starts (engine/app/look.ts): the stage's lights give way\\n * to it (engine/gfx/stageSky.ts), which changes the shader key, so a look with another sky warms up before it draws.\\n * WP 13.24 adds the toon style's `shade` and `dither`, what a look asks of the stage (`shells`, outline shells round\\n10→ * its props and bodies, engine/gfx/stageShells.ts; `skyGradient`, the dome as a clean gradient) and its variant for\\n * perspective cameras (`perspective`, a look id whose filters and toon numbers the chain draws there). WP 13.30 adds\\n * what it asks of the whole picture: `resolution`, the mode drawn while `gfx.resolution` is `auto`\\n * (engine/gfx/resolution.ts), and `textures`, every material's maps filtered `smooth` or `pixel`\\n * (engine/gfx/materials/library.ts `filter`); the page's look applies both (engine/app/look.ts), building nothing.\\n *\\n * The entries are seeded from shardfall's tuned presets (`shardfall:crates/pav_view/src/looks.toml`, with\\n * `look.rs:100-353`), keys renamed: its whole looks are here (`look:hd-2d`, `look:game-boy`…), and its one-section\\n * presets are looks of their own, grouped by the filter they set (`look:palette/game-boy`, `look:stylize/oil-paint`,\\n * engine/gfx/post/presets.ts). Its \\\"objects\\\" (characters and objects) is the scope `characters+objects`. Its air and\\n20→ * bounce light came with WP 11.5 (the `air` and `gi` sections, engine/gfx/post/shading.ts): the looks Sunbeams and\\n * Lamplit fog, and their presets. Left out: styles that differ by part and the knobs WP 7.2's styles lack\\n * (`flat_shadow`, `specular`, `exposure`), so four looks keep the scene's style where shardfall styled the parts\\n * apart. One rename for the lesson: \\\"64 colours\\\" posterized to 4 levels, which shifts the hue of dull colours, so it\\n * is `look:palette/512-colours`, at 8. WP 13.31 and 13.32 add Style Lab's presets and looks made by combining them\\n * (engine/gfx/post/presetsMore.ts), and every look's `combine` and `strength` (engine/gfx/post/combine.ts): the looks\\n * it lays on, how much of each and which of its filters, and how much of the whole look shows.\\n *\\n * Invariants: every look's levels are 0 or 8 and more (the kind's check); a missing id falls back to `look:clean`\\n * with a warning naming the closest ids; looks read their fields, never their ids. A game's own look is scaffolded by\\n30→ * `node x new look labs/<lab>/looks/<name>` (tools/templates/look/).\\n *\\n * @example\\n * import { createRegistry } from '../../core/registry';\\n * const registry = createRegistry();\\n * defineLooks(registry);\\n * registry.get('look', 'look:game-boy').filters.palette.palette; // 'gameboy'\\n * registry.list('look').length; // 137\\n * @see engine/gfx/post/looks.test.ts\\n * @see tests/e2e/post.spec.ts\\n40→ */\\nimport { galleryField } from '../../core/gallery';\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\\nimport type { EntryOf, Schema } from '../../core/schema';\\nimport { MATERIAL_STYLES } from '../materials/styles';\\nimport { TOON_LOOK } from '../materials/toon';\\nimport { RESOLUTION_MODES } from '../resolution';\\nimport { TEXTURE_LOOKS } from '../textures/types';\\nimport { COMBINE_FIELD, STRENGTH_FIELD, type CombineLayer } from './combine';\\nimport { colorFields, colorProblem, FILTER_FIELDS, FILTER_NAMES, levelsProblem, type FilterSpec } from './filters';\\n50→import { PRESETS } from './presets';\\nimport { COMBINED_LOOKS, STYLE_PRESETS } from './presetsMore';\\n\\n/** Where a menu lists a look: `look` for a whole look, else the filter it presets, or `shading` for a style. */\\nexport const LOOK_GROUPS = ['look', 'shading', ...FILTER_NAMES] as const;\\n\\n/** The default of every filter: all of them off. */\\nconst OFF = Object.fromEntries(Object.entries(FILTER_FIELDS).map(([name, field]) => [name, field.default]));\\n\\n/** The fields of a `look` entry; see the file comment. */\\n60→export const LOOK_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What it looks like, in plain sentences.' },\\n  group: {\\n    type: 'string',\\n    enum: LOOK_GROUPS,\\n    default: 'look',\\n    description: \\\"Where a menu lists it: 'look' for a whole look, else the filter it presets ('shading' for a style).\\\",\\n  },\\n  style: {\\n    type: 'string',\\n70→    enum: ['', ...MATERIAL_STYLES],\\n    default: '',\\n    description: \\\"The material style everything is drawn in (lambert, toon, flat, pbr); '' keeps the scene's own.\\\",\\n  },\\n  sky: {\\n    type: 'string',\\n    default: '',\\n    description:\\n      \\\"The sky preset that lights the scene (a 'sky' id: sky:hall, the torch-lit hall); '' keeps the scene's own lights.\\\",\\n  },\\n80→  toon: {\\n    type: 'object',\\n    default: { ...TOON_LOOK },\\n    description: \\\"The toon style's bands, rim, shade and dither, used when the style is 'toon'.\\\",\\n    properties: {\\n      bands: { type: 'integer', default: TOON_LOOK.bands, minimum: 2, maximum: 8, description: 'Bands of light.' },\\n      rim: { type: 'number', default: TOON_LOOK.rim, minimum: 0, maximum: 1, description: \\\"The rim light's strength.\\\" },\\n      shade: {\\n        type: 'number',\\n        default: TOON_LOOK.shade,\\n90→        minimum: 0,\\n        maximum: 1,\\n        description: \\\"How far each material's shadows shift in hue (cooler, more saturated) from its colour darkened.\\\",\\n      },\\n      dither: {\\n        type: 'number',\\n        default: TOON_LOOK.dither,\\n        minimum: 0,\\n        maximum: 1,\\n        description:\\n100→          \\\"The share of each band's step mixed by an ordered dither fixed to the world, edges hard; 0 smooths.\\\",\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/gfx/post/looks.ts\",\"offset\":1,\"limit\":100,\"raw_output\":\"/**\\n * @file Looks (PLAN.md WP 7.4, §6.6 kind `look`): a material style (WP 7.2, engine/gfx/materials/styles.ts) plus a\\n * filter chain (engine/gfx/post/filters.ts), as data, and the sky that lights the scene (WP 7.8, a `sky` id,\\n * engine/gfx/sky.ts). A look names what it changes; every filter it leaves out is off, and a style or sky of `''`\\n * keeps the scene's own. The chain draws the look the setting `post.look` names (engine/gfx/post/chain.ts); switching\\n * looks writes uniforms and re-points materials to styles the warm-up has already compiled, so it builds no\\n * pipeline. A look's sky is shown by the pages `createEngine` starts (engine/app/look.ts): the stage's lights give way\\n * to it (engine/gfx/stageSky.ts), which changes the shader key, so a look with another sky warms up before it draws.\\n * WP 13.24 adds the toon style's `shade` and `dither`, what a look asks of the stage (`shells`, outline shells round\\n * its props and bodies, engine/gfx/stageShells.ts; `skyGradient`, the dome as a clean gradient) and its variant for\\n * perspective cameras (`perspective`, a look id whose filters and toon numbers the chain draws there). WP 13.30 adds\\n * what it asks of the whole picture: `resolution`, the mode drawn while `gfx.resolution` is `auto`\\n * (engine/gfx/resolution.ts), and `textures`, every material's maps filtered `smooth` or `pixel`\\n * (engine/gfx/materials/library.ts `filter`); the page's look applies both (engine/app/look.ts), building nothing.\\n *\\n * The entries are seeded from shardfall's tuned presets (`shardfall:crates/pav_view/src/looks.toml`, with\\n * `look.rs:100-353`), keys renamed: its whole looks are here (`look:hd-2d`, `look:game-boy`…), and its one-section\\n * presets are looks of their own, grouped by the filter they set (`look:palette/game-boy`, `look:stylize/oil-paint`,\\n * engine/gfx/post/presets.ts). Its \\\"objects\\\" (characters and objects) is the scope `characters+objects`. Its air and\\n * bounce light came with WP 11.5 (the `air` and `gi` sections, engine/gfx/post/shading.ts): the looks Sunbeams and\\n * Lamplit fog, and their presets. Left out: styles that differ by part and the knobs WP 7.2's styles lack\\n * (`flat_shadow`, `specular`, `exposure`), so four looks keep the scene's style where shardfall styled the parts\\n * apart. One rename for the lesson: \\\"64 colours\\\" posterized to 4 levels, which shifts the hue of dull colours, so it\\n * is `look:palette/512-colours`, at 8. WP 13.31 and 13.32 add Style Lab's presets and looks made by combining them\\n * (engine/gfx/post/presetsMore.ts), and every look's `combine` and `strength` (engine/gfx/post/combine.ts): the looks\\n * it lays on, how much of each and which of its filters, and how much of the whole look shows.\\n *\\n * Invariants: every look's levels are 0 or 8 and more (the kind's check); a missing id falls back to `look:clean`\\n * with a warning naming the closest ids; looks read their fields, never their ids. A game's own look is scaffolded by\\n * `node x new look labs/<lab>/looks/<name>` (tools/templates/look/).\\n *\\n * @example\\n * import { createRegistry } from '../../core/registry';\\n * const registry = createRegistry();\\n * defineLooks(registry);\\n * registry.get('look', 'look:game-boy').filters.palette.palette; // 'gameboy'\\n * registry.list('look').length; // 137\\n * @see engine/gfx/post/looks.test.ts\\n * @see tests/e2e/post.spec.ts\\n */\\nimport { galleryField } from '../../core/gallery';\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\\nimport type { EntryOf, Schema } from '../../core/schema';\\nimport { MATERIAL_STYLES } from '../materials/styles';\\nimport { TOON_LOOK } from '../materials/toon';\\nimport { RESOLUTION_MODES } from '../resolution';\\nimport { TEXTURE_LOOKS } from '../textures/types';\\nimport { COMBINE_FIELD, STRENGTH_FIELD, type CombineLayer } from './combine';\\nimport { colorFields, colorProblem, FILTER_FIELDS, FILTER_NAMES, levelsProblem, type FilterSpec } from './filters';\\nimport { PRESETS } from './presets';\\nimport { COMBINED_LOOKS, STYLE_PRESETS } from './presetsMore';\\n\\n/** Where a menu lists a look: `look` for a whole look, else the filter it presets, or `shading` for a style. */\\nexport const LOOK_GROUPS = ['look', 'shading', ...FILTER_NAMES] as const;\\n\\n/** The default of every filter: all of them off. */\\nconst OFF = Object.fromEntries(Object.entries(FILTER_FIELDS).map(([name, field]) => [name, field.default]));\\n\\n/** The fields of a `look` entry; see the file comment. */\\nexport const LOOK_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What it looks like, in plain sentences.' },\\n  group: {\\n    type: 'string',\\n    enum: LOOK_GROUPS,\\n    default: 'look',\\n    description: \\\"Where a menu lists it: 'look' for a whole look, else the filter it presets ('shading' for a style).\\\",\\n  },\\n  style: {\\n    type: 'string',\\n    enum: ['', ...MATERIAL_STYLES],\\n    default: '',\\n    description: \\\"The material style everything is drawn in (lambert, toon, flat, pbr); '' keeps the scene's own.\\\",\\n  },\\n  sky: {\\n    type: 'string',\\n    default: '',\\n    description:\\n      \\\"The sky preset that lights the scene (a 'sky' id: sky:hall, the torch-lit hall); '' keeps the scene's own lights.\\\",\\n  },\\n  toon: {\\n    type: 'object',\\n    default: { ...TOON_LOOK },\\n    description: \\\"The toon style's bands, rim, shade and dither, used when the style is 'toon'.\\\",\\n    properties: {\\n      bands: { type: 'integer', default: TOON_LOOK.bands, minimum: 2, maximum: 8, description: 'Bands of light.' },\\n      rim: { type: 'number', default: TOON_LOOK.rim, minimum: 0, maximum: 1, description: \\\"The rim light's strength.\\\" },\\n      shade: {\\n        type: 'number',\\n        default: TOON_LOOK.shade,\\n        minimum: 0,\\n        maximum: 1,\\n        description: \\\"How far each material's shadows shift in hue (cooler, more saturated) from its colour darkened.\\\",\\n      },\\n      dither: {\\n        type: 'number',\\n        default: TOON_LOOK.dither,\\n        minimum: 0,\\n        maximum: 1,\\n        description:\\n          \\\"The share of each band's step mixed by an ordered dither fixed to the world, edges hard; 0 smooths.\\\",\\n\",\"total_lines\":363}}","is_error":false},{"type":"tool_result","tool_use_id":"call-a885ffa0-8aee-4322-8cfd-f8356e429b1a-65","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"180→    } else if (track.wave !== 'drums' && token !== REST && token !== HOLD) {\\n      try {\\n        noteFreq(token);\\n      } catch {\\n        problems.push(`\\\"${token}\\\" at step ${step} is not a note: write C4, F#3 or Bb2, - to hold, . for a rest`);\\n      }\\n    }\\n    if (token !== HOLD) previous = token;\\n    step++;\\n  }\\n190→  return problems;\\n}\\n\\n/** A track's note voice, without its pitch, start and length. */\\nfunction noteVoice(track: Song['tracks'][number]): Voice {\\n  const voice: Voice = { wave: track.wave as Voice['wave'], vol: track.vol, hold: true, attack: track.attack };\\n  if (track.vib !== undefined) voice.vib = track.vib;\\n  return voice;\\n}\\n\\n200→/**\\n * The problems of a song beyond its fields' own ([] when fine): tokens, bar lines, track lengths against the bar\\n * and the song, a voice `render` refuses, a kit token that is not one word, and a pass past the DSP's length limit.\\n */\\nexport function songProblems(song: Pick<Song, 'bpm' | 'steps' | 'beats' | 'tracks' | 'kit'>): string[] {\\n  const problems: string[] = [];\\n  const { barSteps: bar, steps: length, seconds } = songTiming(song);\\n  for (const token of Object.keys(song.kit)) {\\n    if (!/^[^\\\\s.|-]\\\\S*$/.test(token)) problems.push(`kit token \\\"${token}\\\" must be one word, not . - or |`);\\n  }\\n210→  if (!song.tracks.length) problems.push('it has no tracks');\\n  song.tracks.forEach((track, i) => {\\n    const where = `tracks[${i}]`;\\n    const steps = tokensOf(track.notes).length;\\n    if (!steps) problems.push(`${where} has no steps`);\\n    for (const problem of tokenProblems(track, song.kit, bar)) problems.push(`${where}: ${problem}`);\\n    if (steps && steps % bar && bar % steps) {\\n      problems.push(`${where} is ${steps} steps long: a track fills whole bars or divides one (a bar is ${bar} steps)`);\\n    } else if (steps && length % steps) {\\n      problems.push(`${where} is ${steps} steps long, which does not divide the song's ${length}`);\\n220→    }\\n    if (track.wave !== 'drums') {\\n      try {\\n        normalizeSound(noteVoice(track), DEFAULT_RATE);\\n      } catch (error) {\\n        problems.push(`${where}: ${(error as Error).message}`);\\n      }\\n    }\\n  });\\n  if (length && length % bar) problems.push(`the song is ${length} steps long, not whole bars of ${bar} steps`);\\n230→  if (seconds > MAX_SECONDS) problems.push(`one pass lasts ${seconds} s, past the ${MAX_SECONDS} s limit`);\\n  return problems;\\n}\\n\\n/** Declares the `song` kind on `registry` with the engine's songs (once). */\\nexport function songKind(registry: Registry): void {\\n  if (registry.kinds().includes('song')) return;\\n  registry.defineKind('song', {\\n    description: 'A looping tune in tracker notation: tempo, bars and tracks of notes or drum tokens.',\\n    fields: SONG_FIELDS,\\n240→    defineWith: \\\"defineSong('<id>', { bpm: …, tracks: [{ wave: …, notes: 'C4 - E4 - …' }] })\\\",\\n    check: (entry) => songProblems(entry as unknown as Song),\\n  });\\n  for (const [id, spec] of Object.entries(SONGS)) registry.def('song', id, { ...spec });\\n}\\nsongKind(sharedRegistry);\\n\\n/**\\n * Defines a song on `registry` (the shared one by default) and returns it. Throws `CORE_BAD_SPEC` naming each problem\\n * (a token that is not a note, a track that does not fit the bar, a value out of range), `CORE_DUPLICATE_ID` when\\n250→ * defined twice.\\n */\\nexport function defineSong(id: string, spec: SongSpec, registry: Registry = sharedRegistry): Song {\\n  songKind(registry);\\n  return registry.def('song', id, { ...spec }) as unknown as Song;\\n}\\n\\n/** The song `id` of `registry`; a missing id throws `CORE_NO_ENTRY`, naming the closest ids. */\\nexport function getSong(id: string, registry: Registry = sharedRegistry): Song {\\n  songKind(registry);\",\"content_concise\":\"180→    } else if (track.wave !== 'drums' && token !== REST && token !== HOLD) {\\n      try {\\n        noteFreq(token);\\n      } catch {\\n        problems.push(`\\\"${token}\\\" at step ${step} is not a note: write C4, F#3 or Bb2, - to hold, . for a rest`);\\n      }\\n    }\\n    if (token !== HOLD) previous = token;\\n    step++;\\n  }\\n190→  return problems;\\n}\\n\\n/** A track's note voice, without its pitch, start and length. */\\nfunction noteVoice(track: Song['tracks'][number]): Voice {\\n  const voice: Voice = { wave: track.wave as Voice['wave'], vol: track.vol, hold: true, attack: track.attack };\\n  if (track.vib !== undefined) voice.vib = track.vib;\\n  return voice;\\n}\\n\\n200→/**\\n * The problems of a song beyond its fields' own ([] when fine): tokens, bar lines, track lengths against the bar\\n * and the song, a voice `render` refuses, a kit token that is not one word, and a pass past the DSP's length limit.\\n */\\nexport function songProblems(song: Pick<Song, 'bpm' | 'steps' | 'beats' | 'tracks' | 'kit'>): string[] {\\n  const problems: string[] = [];\\n  const { barSteps: bar, steps: length, seconds } = songTiming(song);\\n  for (const token of Object.keys(song.kit)) {\\n    if (!/^[^\\\\s.|-]\\\\S*$/.test(token)) problems.push(`kit token \\\"${token}\\\" must be one word, not . - or |`);\\n  }\\n210→  if (!song.tracks.length) problems.push('it has no tracks');\\n  song.tracks.forEach((track, i) => {\\n    const where = `tracks[${i}]`;\\n    const steps = tokensOf(track.notes).length;\\n    if (!steps) problems.push(`${where} has no steps`);\\n    for (const problem of tokenProblems(track, song.kit, bar)) problems.push(`${where}: ${problem}`);\\n    if (steps && steps % bar && bar % steps) {\\n      problems.push(`${where} is ${steps} steps long: a track fills whole bars or divides one (a bar is ${bar} st