, 'laser', 'syringe', 'gel', 'scanner'] as const;\"},{\"line_number\":11,\"content\":\"export type Tool = (typeof TOOLS)[number];\"},{\"line_number\":14,\"content\":\"export const KINDS = [\"},{\"line_number\":41,\"content\":\"export type Kind = (typeof KINDS)[number];\"},{\"line_number\":44,\"content\":\"export type Effect =\"},{\"line_number\":61,\"content\":\"export type Difficulty = 'intern' | 'resident' | 'attending';\"},{\"line_number\":64,\"content\":\"export type Rating = 'TEXTBOOK' | 'CLEAN' | 'ROUGH' | 'SLIP';\"},{\"line_number\":67,\"content\":\"export type Rank = 'C' | 'B' | 'A' | 'S' | '★';\"},{\"line_number\":70,\"content\":\"export interface Target {\"},{\"line_number\":136,\"content\":\"export interface Hand {\"},{\"line_number\":153,\"content\":\"export interface Seat {\"},{\"line_number\":193,\"content\":\"export interface Patient {\"},{\"line_number\":202,\"content\":\"export interface PhaseDef {\"},{\"line_number\":212,\"content\":\"export interface Spawn {\"},{\"line_number\":242,\"content\":\"export interface GameEvent {\"},{\"line_number\":254,\"content\":\"export interface Balance {\"},{\"line_number\":276,\"content\":\"export interface CodeState {\"},{\"line_number\":287,\"content\":\"export interface Op {\"},{\"line_number\":345,\"content\":\"export interface Postcards {\"},{\"line_number\":353,\"content\":\"export interface CaseDef {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/story.ts\",\"matches\":[{\"line_number\":5,\"content\":\"export interface Box {\"},{\"line_number\":13,\"content\":\"export interface Scene {\"},{\"line_number\":34,\"content\":\"export const SCENES: readonly Scene[] = [\"},{\"line_number\":394,\"content\":\"export function sceneById(id: string): Scene | undefined {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compas