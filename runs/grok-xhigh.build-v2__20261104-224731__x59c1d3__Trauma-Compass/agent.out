cription: 'Calm under the lamp, while the work is ordinary.',\\n  bpm: 100,\\n  tracks: [\\n    { wave: 'triangle', vol: 0.14, notes: bar + ' | D4 - F4 - | E4 - C4 -' },\\n    { wave: 'sine', vol: 0.07, notes: 'C3 - G3 - | A3 - G3 - | F3 - A3 - | G3 - E3 -' },\\n  ],\\n});\\n\\ndefineSong('song:strain', {\\n  description: 'Something on the sheet is no longer tissue.',\\n  bpm: 128,\\n  tracks: [\\n    { wave: 'saw', vol: 0.1, notes: 'E4 - G4 - | Bb4 - G4 - | E4 - A4 - | Bb4 - G4 -' },\\n    { wave: 'triangle', vol: 0.12, notes: 'E3 - - - | E3 - - - | F3 - - - | E3 - - -' },\\n  ],\\n});\\n\\ndefineSong('song:mercy', {\\n  description: 'The last case, slow and wide.',\\n  bpm: 72,\\n  tracks: [\\n    { wave: 'sine', vol: 0.14, notes: 'G4 - - - | B4 - - - | D5 - - - | B4 - - -' },\\n    { wave: 'triangle', vol: 0.1, notes: 'G3 - D4 - | G3 - D4 - | A3 - E4 - | G3 - D4 -' },\\n  ],\\n});\\n\\ndefineSong('song:story', {\\n  description: 'Between operations, in the corridor.',\\n  bpm: 84,\\n  tracks: [{ wave: 'triangle', vol: 0.12, notes: 'F4 - A4 - | C5 - A4 - | G4 - Bb4 - | A4 - F4 -' }],\\n});\\n\\ndefineSong('song:jingle', {\\n  description: 'The sponsor spot on the gala television. Short, bright, and a little too pleased.',\\n  bpm: 150,\\n  tracks: [{ wave: 'square', vol: 0.1, notes: 'C5 E5 G5 C6 | E5 - G5 -' }],\\n});\\n\\ndefineSong('song:win', {\\n  description: 'The operation holds.',\\n  bpm: 120,\\n  tracks: [{ wave: 'triangle', vol: 0.16, notes: 'C4 E4 G4 C5 | E5 - - -' }],\\n});\\n\\ndefineSong('song:lose', {\\n  description: 'Called off.',\\n  bpm: 70,\\n  tracks: [{ wave: 'saw', vol: 0.08, notes: 'E4 - C4 - | A3 - - -' }],\\n});\",\"old_line\":17,\"new_string\":\"defineSfx('sfx:menu', { voices: { wave: 'square', freq: 660, to: 880, dur: 0.04, vol: 0.12 }, bus: 'ui' });\\n\\n/** One bar is four steps. Every track below fills whole bars. */\\nconst SONG = { steps: 1, beats: 4 } as const;\\n\\ndefineSong('song:title', {\\n  description: 'The harbour at night, under the title.',\\n  bpm: 92,\\n  ...SONG,\\n  tracks: [\\n    { wave: 'triangle', vol: 0.16, notes: 'A3 - C4 - | E4 - C4 - | A3 - D4 - | E4 - C4 -' },\\n    { wave: 'sine', vol: 0.08, notes: 'A2 - - - | A2 - - - | F2 - - - | A2 - - -' },\\n  ],\\n});\\n\\ndefineSong('song:or', {\\n  description: 'Calm under the lamp, while the work is ordinary.',\\n  bpm: 100,\\n  ...SONG,\\n  tracks: [\\n    { wave: 'triangle', vol: 0.14, notes: 'C4 - E4 - | G4 - E4 - | D4 - F4 - | E4 - C4 -' },\\n    { wave: 'sine', vol: 0.07, notes: 'C3 - G3 - | A3 - G3 - | F3 - A3 - | G3 - E3 -' },\\n  ],\\n});\\n\\ndefineSong('song:strain', {\\n  description: 'Something on the sheet is no longer tissue.',\\n  bpm: 128,\\n  ...SONG,\\n  tracks: [\\n    { wave: 'saw', vol: 0.1, notes: 'E4 - G4 - | Bb4 - G4 - | E4 - A4 - | Bb4 - G4 -' },\\n    { wave: 'triangle', vol: 0.12, notes: 'E3 - - - | E3 - - - | F3 - - - | E3 - - -' },\\n  ],\\n});\\n\\ndefineSong('song:mercy', {\\n  description: 'The last case, slow and wide.',\\n  bpm: 72,\\n  ...SONG,\\n  tracks: [\\n    { wave: 'sine', vol: 0.14, notes: 'G4 - - - | B4 - - - | D5 - - - | B4 - - -' },\\n    { wave: 'triangle', vol: 0.1, notes: 'G3 - D4 - | G3 - D4 - | A3 - E4 - | G3 - D4 -' },\\n  ],\\n});\\n\\ndefineSong('song:story', {\\n  description: 'Between operations, in the corridor.',\\n  bpm: 84,\\n  ...SONG,\\n  tracks: [{ wave: 'triangle', vol: 0.12, notes: 'F4 - A4 - | C5 - A4 - | G4 - Bb4 - | A4 - F4 -' }],\\n});\\n\\ndefineSong('song:jingle', {\\n  description: 'The sponsor spot on the gala television. Short, bright, and a little too pleased.',\\n  bpm: 150,\\n  ...SONG,\\n  tracks: [{ wave: 'square', vol: 0.1, notes: 'C5 E5 G5 C6 | E5 - G5 -' }],\\n});\\n\\ndefineSong('song:win', {\\n  description: 'The operation holds.',\\n  bpm: 120,\\n  ...SONG,\\n  tracks: [{ wave: 'triangle', vol: 0.16, notes: 'C4 E4 G4 C5 | E5 - - -' }],\\n});\\n\\ndefineSong('song:lose', {\\n  description: 'Called off.',\\n  bpm: 70,\\n  ...SONG,\\n  tracks: [{ wave: 'saw', vol: 0.08, notes: 'E4 - C4 - | A3 - - -' }],\\n});\",\"new_line\":17,\"context_before\":\"defineSfx('sfx:beep', { voices: { wave: 'square', freq: 880, dur: 0.06, vol: 0.12 } });\\ndefineSfx('sfx:alarm', { voices: { wave: 'saw', freq: 440, to: 660, dur: 0.3, vol: 0.2 } });\\ndefineSfx('sfx:rank', { voices: { wave: 'triangle', freq: 523, arp: [0, 4, 7, 12], step: 0.07, dur: 0.4, vol: 0.22 } });\\n\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"232b52d8-644d-4c0b-a2f8-b51130fecf68"}
{"type":"assistant","message":{"id":"msg_212","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The jingle spans 8 steps.\n\nWin jingle also spans 8 steps. Bb4 is valid. Next up: campaign.ts, audio mix, input map, and progress tracking.\n\nCampaign.ts will contain accept, move, browse, cancel, noteInput, tickIdle, finishOp, and startShift. Attract clips will be managed by setting a clip index and a remaining duration. The page will watch for clip changes to restart the run.\n\nA `runOf` helper will map each screen to its simulation run and phase flags. Title, board, settings, handbook, about, scrub, pause, credits, debrief, and brief all use the title run. Story uses the title run for visual display but handles dialogue separately. Operations map to `op:${id}` and attract clips are flagged with an `attract` boolean.\n\nThe page compares the desired run to the last applied one and calls inspector.set with a seed. Two helpers, `desiredRun` and `desiredAttract`, will compute the target run and attract flag from the campaign state. Operation screens map to `op:${id}` after stripping the `case:` prefix. Attract clips that reference operations map to the same `op:${id}` format.\n\n`finishOp` returns early when the campaign is in attract mode. It then fetches the case definition and sets a failure message if the operation was lost.\n\n`finishOp` transitions to the debrief screen after a loss. After a win it computes the rank, stores the score and postcard, and marks the case as won. On debrief accept, a new record is saved only if the case index equals `cleared`, preventing duplicate entries during free replays.\n\nThe debrief logic now always stores the rank, score, and postcard at the case index when the player wins and `c.record` is true. The `cleared` counter only increments after the story after scene, so exiting to the board before that point leaves the counter unchanged and allows a replay of the before story.\n\nA `pendingAfter` flag is unnecessary. The rank will be stored immediately on win, but `cleared` will only increment after the story after scene ends. Continue will check whether the rank at the current cleared index is already set; if so, it proceeds to that case's after story, otherwise to its before story.\n\nThe continue logic now branches on whether the current cleared case already has a stored rank. If it does, it loads the after story; otherwise it loads the before story and sets the case ID and index. Once the after story ends, the cleared counter increments and the campaign either unlocks free mode and shows credits or proceeds to the next before story.\n\nFree Surgery will be unlocked after the story walk. The board will gain a ninth card that lets the player replay any case without saving ranks. When free mode is active, every case becomes playable from the board and a banner indicates Free Surgery is open. Attending difficulty will be added to settings.\n\nScrub seats will be stored on `progress.seats`. A test file is planned alongside the campaign code. The dev screen belongs to the campaign module so tests can switch tabs. Settings rows will be defined as data. `noteInput` will exit attract mode and reset idle time when returning to title. `tick` skips updates during sessions. It decrements attract clip timers and advances clips when they expire. On menu screens it accumulates idle time and enters attract after ten seconds of inactivity.","signature":""},{"type":"tool_use","id":"call-80be7d5e-cc2f-4d31-a13b-078ac2b0c30f-142","name":"write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.ts","content":"/**\n * @file The shift, with no DOM. Title, story, briefing, operation, debrief, and the menus around them.\n * The page draws whatever this says and starts the run it names.\n */\nimport { storyCases } from '../op/cases';\nimport { caseById } from '../op/cases';\nimport { rankFor } from '../op/ratings';\nimport { sceneById } from '../op/story';\nimport { handbookCards } from '../op/table';\nimport type { Difficulty, Rank } from '../op/types';\n\n/** Where the player is. */\nexport type Screen =\n  | 'title'\n  | 'board'\n  | 'story'\n  | 'brief'\n  | 'op'\n  | 'debrief'\n  | 'pause'\n  | 'settings'\n  | 'handbook'\n  | 'about'\n  | 'scrub'\n  | 'credits'\n  | 'attract'\n  | 'dev';\n\n/** What a finished night remembers. Dev runs and the attract loop do not write it. */\nexport interface Progress {\n  cleared: number;\n  ranks: string[];\n  scores: number[];\n  postcards: string[];\n  free: boolean;\n  attending: boolean;\n  difficulty: Difficulty;\n  simple: boolean;\n  glyphs: 'playstation' | 'xbox';\n  blood: 'red' | 'teal' | 'off';\n  master: number;\n  music: number;\n  effects: number;\n  voice: number;\n  autoText: boolean;\n  seats: number;\n}\n\n/** One attract clip. Times add up to about three minutes. */\nexport interface Clip {\n  kind: 'logo' | 'op' | 'story' | 'cards';\n  id: string;\n  ms: number;\n}\n\n/** The kiosk loop. */\nexport const ATTRACT: readonly Clip[] = [\n  { kind: 'logo', id: '', ms: 6000 },\n  { kind: 'op', id: 'case:first-cut', ms: 24000 },\n  { kind: 'op', id: 'case:crosstalk', ms: 24000 },\n  { kind: 'story', id: 'after-2', ms: 18000 },\n  { kind: 'op', id: 'case:struck-off', ms: 24000 },\n  { kind: 'op', id: 'case:reverie', ms: 24000 },\n  { kind: 'op', id: 'case:gala-night', ms: 24000 },\n  { kind: 'op', id: 'case:mercy', ms: 26000 },\n  { kind: 'cards', id: '', ms: 16000 },\n];\n\n/** A menu row. */\nexport interface Item {\n  id: string;\n  label: string;\n}\n\n/** The whole front end. */\nexport interface Campaign {\n  screen: Screen;\n  back: Screen;\n  progress: Progress;\n  focus: number;\n  caseId: string;\n  caseIndex: number;\n  storyId: string;\n  leg: 'before' | 'after';\n  box: number;\n  board: number;\n  tab: number;\n  page: number;\n  clip: number;\n  clipMs: number;\n  idle: number;\n  lineMs: number;\n  record: boolean;\n  won: boolean;\n  fail: string;\n  lastRank: string;\n  lastScore: number;\n  postcard: string;\n  devTab: number;\n  hideHud: boolean;\n  claimed: boolean[];\n}\n\nconst MENUS: readonly Screen[] = ['title', 'board', 'settings', 'handbook', 'about', 'scrub'];\n\n/** A new night, nothing cleared. */\nexport function blankProgress(): Progress {\n  return {\n    cleared: 0,\n    ranks: [],\n    scores: [],\n    postcards: [],\n    free: false,\n    attending: false,\n    difficulty: 'resident',\n    simple: false,\n    glyphs: 'playstation',\n    blood: 'red',\n    master: 70,\n    music: 10,\n    effects: 100,\n    voice: 100,\n    autoText: false,\n    seats: 1,\n  };\n}\n\n/** The title, over a blank or a loaded night. */\nexport function createCampaign(progress: Progress = blankProgress()): Campaign {\n  return {\n    screen: 'title',\n    back: 'title',\n    progress,\n    focus: 0,\n    caseId: 'case:first-cut',\n    caseIndex: 0,\n    storyId: 'before-1',\n    leg: 'before',\n    box: 0,\n    board: 0,\n    tab: 0,\n    page: 0,\n    clip: 0,\n    clipMs: ATTRACT[0].ms,\n    idle: 0,\n    lineMs: 0,\n    record: true,\n    won: false,\n    fail: '',\n    lastRank: '',\n    lastScore: 0,\n    postcard: '',\n    devTab: 0,\n    hideHud: false,\n    claimed: [true, false, false, false],\n  };\n}\n\n/** Story cases plus Free Surgery once the night is over. */\nexport function boardIds(progress: Progress): string[] {\n  const ids = storyCases().map((item) => item.id);\n  if (progress.free) ids.push('case:first-cut');\n  return ids;\n}\n\n/** Rows for the screen the player is on. */\nexport function items(c: Campaign): Item[] {\n  if (c.screen === 'title') {\n    const rows: Item[] = [];\n    if (c.progress.cleared > 0 && c.progress.cleared < storyCases().length) rows.push({ id: 'continue', label: 'Continue' });\n    rows.push({ id: 'new', label: 'New Shift' }, { id: 'board', label: 'The Board' }, { id: 'scrub', label: 'Scrub In' });\n    rows.push({ id: 'settings', label: 'Settings' }, { id: 'about', label: 'About' });\n    return rows;\n  }\n  if (c.screen === 'board') return [{ id: 'play', label: 'Open case' }, { id: 'postcards', label: 'Postcards' }, { id: 'back', label: 'Back' }];\n  if (c.screen === 'brief') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\n  if (c.screen === 'debrief') {\n    return c.won\n      ? [{ id: 'next', label: 'Continue' }]\n      : [{ id: 'retry', label: 'Retry case' }, { id: 'board', label: 'The Board' }];\n  }\n  if (c.screen === 'pause') {\n    return [\n      { id: 'resume', label: 'Resume' },\n      { id: 'phase', label: 'Retry phase' },\n      { id: 'retry', label: 'Retry case' },\n      { id: 'handbook', label: 'Handbook' },\n      { id: 'settings', label: 'Settings' },\n      { id: 'controls', label: 'Controls' },\n      { id: 'dev', label: 'Dev Mode' },\n      { id: 'board', label: 'Quit to Board' },\n    ];\n  }\n  if (c.screen === 'settings') return settingsItems(c);\n  if (c.screen === 'handbook') return [{ id: 'back', label: 'Back' }];\n  if (c.screen === 'about' || c.screen === 'credits') return [{ id: 'back', label: c.screen === 'credits' ? 'Title' : 'Back' }];\n  if (c.screen === 'scrub') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\n  if (c.screen === 'dev') return devItems(c);\n  return [];\n}\n\n/** Settings rows for the open page. */\nfunction settingsItems(c: Campaign): Item[] {\n  const p = c.progress;\n  const pages = [\n    [\n      { id: 'master', label: `Master ${p.master}` },\n      { id: 'music', label: `Music ${p.music}` },\n      { id: 'effects', label: `Effects ${p.effects}` },\n      { id: 'voice', label: `Voice ${p.voice}` },\n    ],\n    [\n      { id: 'glyphs', label: `Glyphs ${p.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'}` },\n      { id: 'back', label: 'Back' },\n    ],\n    [\n      { id: 'difficulty', label: `Difficulty ${p.difficulty}` },\n      { id: 'simple', label: `Simple Gift ${p.simple ? 'on' : 'off'}` },\n      { id: 'autoText', label: `Auto text ${p.autoText ? 'on' : 'off'}` },\n    ],\n    [{ id: 'blood', label: `Blood ${p.blood}` }],\n  ];\n  return [...pages[c.page]!, { id: 'back', label: 'Back' }];\n}\n\n/** Dev Mode rows for the open tab. */\nfunction devItems(c: Campaign): Item[] {\n  const tabs = ['Play', 'Balance', 'View', 'Author', 'Data'];\n  if (c.devTab === 1) return [{ id: 'reset', label: 'Reset sliders' }, { id: 'back', label: 'Back' }];\n  if (c.devTab === 2) return [{ id: 'hud', label: c.hideHud ? 'Show HUD' : 'Hide HUD' }, { id: 'fly', label: 'Free camera' }, { id: 'back', label: 'Back' }];\n  if (c.devTab === 4) return [{ id: 'copy', label: 'Copy replay' }, { id: 'back', label: 'Back' }];\n  if (c.devTab === 3) return [{ id: 'back', label: 'Back' }];\n  return [\n    { id: 'win', label: 'Win phase' },\n    { id: 'fail', label: 'Fail phase' },\n    { id: 'heal', label: 'Restore vitals' },\n    { id: 'freezeVitals', label: 'Freeze vitals' },\n    { id: 'freezeClock', label: 'Freeze clock' },\n    { id: 'gift', label: 'Infinite Gift' },\n    { id: 'oneHit', label: 'One-hit strains' },\n    { id: 'spawn', label: 'Spawn a Lull' },\n    { id: 'unlock', label: 'Unlock the board' },\n    { id: 'auto', label: 'Autoplay' },\n    { id: 'step', label: 'Frame step' },\n    { id: 'slow', label: 'Quarter speed' },\n    { id: 'fast', label: 'Four times' },\n    { id: 'tab', label: `Tab ${tabs[c.devTab]}` },\n    { id: 'back', label: 'Back' },\n  ];\n}\n\n/** Move the highlight. */\nexport function move(c: Campaign, dir: number): void {\n  const rows = items(c);\n  if (!rows.length) return;\n  c.focus = (c.focus + dir + rows.length) % rows.length;\n  c.idle = 0;\n}\n\n/** Browse a card, a page, or a dev tab. */\nexport function browse(c: Campaign, dir: number): void {\n  c.idle = 0;\n  if (c.screen === 'board') {\n    const ids = boardIds(c.progress);\n    c.board = (c.board + dir + ids.length) % ids.length;\n    return;\n  }\n  if (c.screen === 'settings') {\n    c.page = (c.page + dir + 4) % 4;\n    c.focus = 0;\n    return;\n  }\n  if (c.screen === 'handbook') {\n    const n = handbookCards().length;\n    c.page = (c.page + dir + n) % n;\n    return;\n  }\n  if (c.screen === 'about' || c.screen === 'credits') {\n    c.page = Math.max(0, c.page + dir);\n    return;\n  }\n  if (c.screen === 'dev') {\n    c.devTab = (c.devTab + dir + 5) % 5;\n    c.focus = 0;\n    return;\n  }\n  if (c.screen === 'story') c.box = Math.max(0, c.box + dir);\n}\n\n/** Activate the highlighted row, or advance a story box. */\nexport function accept(c: Campaign): void {\n  c.idle = 0;\n  if (c.screen === 'story') return advanceStory(c);\n  if (c.screen === 'attract') return leaveAttract(c);\n  const row = items(c)[c.focus];\n  if (!row) return;\n  act(c, row.id);\n}\n\n/** Activate a row by id. A click uses this. */\nexport function act(c: Campaign, id: string): void {\n  c.idle = 0;\n  if (id === 'back') return cancel(c);\n  if (id === 'new') return startShift(c);\n  if (id === 'continue') return continueShift(c);\n  if (id === 'board') return go(c, 'board');\n  if (id === 'scrub') return go(c, 'scrub');\n  if (id === 'settings') return go(c, 'settings');\n  if (id === 'about') return go(c, 'about');\n  if (id === 'handbook') return go(c, 'handbook');\n  if (id === 'controls') {\n    go(c, 'settings');\n    c.page = 1;\n    return;\n  }\n  if (id === 'dev') return go(c, 'dev');\n  if (id === 'play' && c.screen === 'board') return openBoard(c);\n  if (id === 'postcards') {\n    c.tab = c.tab === 0 ? 1 : 0;\n    return;\n  }\n  if (id === 'start' && c.screen === 'brief') {\n    c.screen = 'op';\n    c.record = c.caseIndex === c.progress.cleared;\n    return;\n  }\n  if (id === 'start' && c.screen === 'scrub') {\n    c.progress.seats = Math.max(1, c.claimed.filter(Boolean).length);\n    c.screen = 'title';\n    return;\n  }\n  if (id === 'next' && c.won) return afterWin(c);\n  if (id === 'retry') return retryCase(c);\n  if (id === 'phase') {\n    c.screen = 'op';\n    return;\n  }\n  if (id === 'resume') {\n    c.screen = 'op';\n    return;\n  }\n  if (id === 'unlock') {\n    c.progress.free = true;\n    c.progress.attending = true;\n    c.progress.cleared = storyCases().length;\n    return;\n  }\n  cycleSetting(c, id);\n}\n\n/** Circle, or Escape on a menu. */\nexport function cancel(c: Campaign): void {\n  c.idle = 0;\n  if (c.screen === 'story') {\n    finishScene(c);\n    return;\n  }\n  if (c.screen === 'op') {\n    c.back = 'op';\n    c.screen = 'pause';\n    c.focus = 0;\n    return;\n  }\n  if (c.screen === 'pause') {\n    c.screen = 'op';\n    return;\n  }\n  if (c.screen === 'attract') return leaveAttract(c);\n  if (c.screen === 'credits') {\n    c.screen = 'title';\n    c.focus = 0;\n    return;\n  }\n  c.screen = c.back === c.screen ? 'title' : c.back;\n  if (c.screen === 'pause' || c.screen === 'title') c.focus = 0;\n}\n\n/** Any real input. Attract ends. The idle clock starts over. */\nexport function noteInput(c: Campaign): void {\n  c.idle = 0;\n  if (c.screen === 'attract') leaveAttract(c);\n}\n\n/** Milliseconds since the last input. Menus become the kiosk. A session never does. */\nexport function tickFront(c: Campaign, dtMs: number, inSession: boolean): void {\n  if (inSession) return;\n  if (c.screen === 'attract') {\n    c.clipMs -= dtMs;\n    if (c.clipMs <= 0) {\n      c.clip = (c.clip + 1) % ATTRACT.length;\n      c.clipMs = ATTRACT[c.clip].ms;\n      if (ATTRACT[c.clip].kind === 'story') c.box = 0;\n    }\n    return;\n  }\n  if (c.screen === 'story' && c.progress.autoText) {\n    c.lineMs += dtMs;\n    if (c.lineMs > 2500) {\n      c.lineMs = 0;\n      advanceStory(c);\n    }\n  }\n  if (!MENUS.includes(c.screen)) return;\n  c.idle += dtMs;\n  if (c.idle >= 10000) enterAttract(c);\n}\n\n/** The operation ended. Attract ignores the rank. A recorded win waits for the scene after it. */\nexport function finishOp(c: Campaign, won: boolean, score: number, slips: number, fail: string): void {\n  if (c.screen !== 'op') return;\n  const def = caseById(c.caseId);\n  c.won = won;\n  c.fail = won ? '' : fail || 'Called off.';\n  c.lastScore = score;\n  if (won) {\n    const rank = rankFor(score, def.par, slips, c.progress.difficulty);\n    c.lastRank = rank;\n    const letter = rank === '★' ? 'S' : (rank as Exclude<Rank, '★'>);\n    c.postcard = def.patients[0]?.postcards[letter] ?? '';\n    if (c.record) {\n      c.progress.ranks[c.caseIndex] = rank;\n      c.progress.scores[c.caseIndex] = score;\n      c.progress.postcards[c.caseIndex] = c.postcard;\n    }\n  }\n  c.screen = 'debrief';\n  c.focus = 0;\n}\n\n/** The run the scene should be showing. */\nexport function desiredRun(c: Campaign): string {\n  if (c.screen === 'op') return `op:${c.caseId}`;\n  if (c.screen === 'attract') {\n    const clip = ATTRACT[c.clip];\n    if (clip.kind === 'op') return `op:${clip.id}`;\n  }\n  return 'title';\n}\n\n/** True while the kiosk is inside an operation. */\nexport function desiredAttract(c: Campaign): boolean {\n  return c.screen === 'attract' && ATTRACT[c.clip].kind === 'op';\n}\n\n/** The story box on screen, if this screen has one. */\nexport function currentBox(c: Campaign): { who: string; text: string; drama: string; where: string } | null {\n  const id = c.screen === 'attract' && ATTRACT[c.clip].kind === 'story' ? ATTRACT[c.clip].id : c.screen === 'story' ? c.storyId : '';\n  if (!id) return null;\n  const scene = sceneById(id);\n  if (!scene) return null;\n  const box = scene.boxes[Math.min(c.box, scene.boxes.length - 1)];\n  return { who: box.who, text: box.text, drama: box.drama ?? '', where: scene.where };\n}\n\n/** Handbook card on the open page. */\nexport function handbookPage(c: Campaign): { title: string; body: string; index: number; count: number } {\n  const cards = handbookCards();\n  const index = ((c.page % cards.length) + cards.length) % cards.length;\n  return { ...cards[index], index, count: cards.length };\n}\n\nfunction go(c: Campaign, screen: Screen): void {\n  c.back = c.screen === screen ? c.back : c.screen;\n  c.screen = screen;\n  c.focus = 0;\n  c.page = 0;\n}\n\nfunction startShift(c: Campaign): void {\n  c.progress.cleared = 0;\n  c.progress.ranks = [];\n  c.progress.scores = [];\n  c.progress.postcards = [];\n  c.record = true;\n  openCase(c, 0, 'before');\n}\n\nfunction continueShift(c: Campaign): void {\n  const index = Math.min(c.progress.cleared, storyCases().length - 1);\n  const leg = c.progress.ranks[index] ? 'after' : 'before';\n  c.record = true;\n  openCase(c, index, leg);\n}\n\nfunction openBoard(c: Campaign): void {\n  const ids = boardIds(c.progress);\n  const id = ids[c.board] ?? ids[0];\n  const index = storyCases().findIndex((item) => item.id === id);\n  const unlocked = c.progress.free || index <= c.progress.cleared;\n  if (!unlocked || index < 0) return;\n  c.record = index === c.progress.cleared;\n  c.caseIndex = index;\n  c.caseId = storyCases()[index].id;\n  c.screen = 'brief';\n  c.focus = 0;\n}\n\nfunction openCase(c: Campaign, index: number, leg: 'before' | 'after'): void {\n  const def = storyCases()[index];\n  if (!def) {\n    c.screen = 'credits';\n    return;\n  }\n  c.caseIndex = index;\n  c.caseId = def.id;\n  c.leg = leg;\n  c.storyId = leg === 'before' ? def.storyBefore : def.storyAfter;\n  c.box = 0;\n  c.lineMs = 0;\n  c.screen = 'story';\n}\n\nfunction advanceStory(c: Campaign): void {\n  const scene = sceneById(c.storyId);\n  if (!scene) return;\n  if (c.box < scene.boxes.length - 1) {\n    c.box += 1;\n    return;\n  }\n  finishScene(c);\n}\n\nfunction finishScene(c: Campaign): void {\n  if (c.leg === 'before') {\n    c.screen = 'brief';\n    c.focus = 0;\n    return;\n  }\n  c.progress.cleared = Math.max(c.progress.cleared, c.caseIndex + 1);\n  if (c.progress.cleared >= storyCases().length) {\n    c.progress.free = true;\n    c.progress.attending = true;\n    c.screen = 'credits';\n    c.page = 0;\n    return;\n  }\n  openCase(c, c.progress.cleared, 'before');\n}\n\nfunction afterWin(c: Campaign): void {\n  c.leg = 'after';\n  const def = storyCases()[c.caseIndex];\n  c.storyId = def?.storyAfter ?? 'after-1';\n  c.box = 0;\n  c.screen = 'story';\n}\n\nfunction retryCase(c: Campaign): void {\n  c.screen = 'op';\n  c.won = false;\n}\n\nfunction enterAttract(c: Campaign): void {\n  c.screen = 'attract';\n  c.clip = 0;\n  c.clipMs = ATTRACT[0].ms;\n  c.box = 0;\n  c.record = false;\n}\n\nfunction leaveAttract(c: Campaign): void {\n  c.screen = 'title';\n  c.focus = 0;\n  c.idle = 0;\n  c.record = true;\n}\n\nfunction cycleSetting(c: Campaign, id: string): void {\n  const p = c.progress;\n  const volume = (n: number) => [0, 10, 40, 70, 100][([0, 10, 40, 70, 100].indexOf(n) + 1) % 5] ?? 70;\n  if (id === 'master') p.master = volume(p.master);\n  if (id === 'music') p.music = volume(p.music);\n  if (id === 'effects') p.effects = volume(p.effects);\n  if (id === 'voice') p.voice = volume(p.voice);\n  if (id === 'glyphs') p.glyphs = p.glyphs === 'playstation' ? 'xbox' : 'playstation';\n  if (id === 'difficulty') {\n    const order: Difficulty[] = ['intern', 'resident', 'attending'];\n    const next = order[(order.indexOf(p.difficulty) + 1) % 3];\n    if (next === 'attending' && !p.attending && !p.free) return;\n    p.difficulty = next;\n  }\n  if (id === 'simple') p.simple = !p.simple;\n  if (id === 'autoText') p.autoText = !p.autoText;\n  if (id === 'blood') p.blood = p.blood === 'red' ? 'teal' : p.blood === 'teal' ? 'off' : 'red';\n  if (id === 'hud') c.hideHud = !c.hideHud;\n}\n\n/** Claim a scrub seat. The keyboard claims the first. */\nexport function claimSeat(c: Campaign, index: number): void {\n  if (index < 0 || index > 3) return;\n  c.claimed[index] = true;\n  c.idle = 0;\n}\n"}},{"type":"tool_use","id":"call-80be7d5e-cc2f-4d31-a13b-078ac2b0c30f-143","name":"write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.test.ts","content":"/**\n * @file The shift with no browser: a new night reaches a briefing, a win reaches the next scene, and ten quiet\n * seconds on the title become the kiosk.\n */\nimport { describe, expect, it } from 'vitest';\nimport { ATTRACT, accept, act, createCampaign, desiredRun, finishOp, items, tickFront } from './campaign';\n\ndescribe('campaign', () => {\n  it('walks a new shift as far as the first briefing', () => {\n    const campaign = createCampaign();\n    act(campaign, 'new');\n    expect(campaign.screen).toBe('story');\n    expect(campaign.storyId).toBe('before-1');\n    for (let i = 0; i < 40; i++) accept(campaign);\n    expect(campaign.screen).toBe('brief');\n    accept(campaign);\n    expect(campaign.screen).toBe('op');\n    expect(desiredRun(campaign)).toBe('op:case:first-cut');\n  });\n\n  it('records a win and then the scene after the case', () => {\n    const campaign = createCampaign();\n    act(campaign, 'new');\n    for (let i = 0; i < 40; i++) accept(campaign);\n    finishOp(campaign, true, 16815, 0, '');\n    expect(campaign.screen).toBe('debrief');\n    expect(campaign.lastRank).toBe('S');\n    expect(campaign.progress.ranks[0]).toBe('S');\n    accept(campaign);\n    expect(campaign.screen).toBe('story');\n    expect(campaign.storyId).toBe('after-1');\n  });\n\n  it('starts the kiosk after ten seconds on the title and leaves it on a press', () => {\n    const campaign = createCampaign();\n    tickFront(campaign, 9999, false);\n    expect(campaign.screen).toBe('title');\n    tickFront(campaign, 2, false);\n    expect(campaign.screen).toBe('attract');\n    expect(ATTRACT.reduce((sum, clip) => sum + clip.ms, 0)).toBeGreaterThan(170000);\n    const before = items(campaign);\n    expect(before).toEqual([]);\n    accept(campaign);\n    expect(campaign.screen).toBe('title');\n  });\n});\n"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3298,"output_tokens":8429,"cache_read_input_tokens":198144,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"bbde79c7-1b59-415e-8734-609cb8911b71"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-80be7d5e-cc2f-4d31-a13b-078ac2b0c30f-142","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"/**\\n * @file The shift, with no DOM. Title, story, briefing, operation, debrief, and the menus around them.\\n * The page draws whatever this says and starts the run it names.\\n */\\nimport { storyCases } from '../op/cases';\\nimport { caseById } from '../op/cases';\\nimport { rankFor } from '../op/ratings';\\nimport { sceneById } from '../op/story';\\nimport { handbookCards } from '../op/table';\\nimport type { Difficulty, Rank } from '../op/types';\\n\\n/** Where the player is. */\\nexport type Screen =\\n  | 'title'\\n  | 'board'\\n  | 'story'\\n  | 'brief'\\n  | 'op'\\n  | 'debrief'\\n  | 'pause'\\n  | 'settings'\\n  | 'handbook'\\n  | 'about'\\n  | 'scrub'\\n  | 'credits'\\n  | 'attract'\\n  | 'dev';\\n\\n/** What a finished night remembers. Dev runs and the attract loop do not write it. */\\nexport interface Progress {\\n  cleared: number;\\n  ranks: string[];\\n  scores: number[];\\n  postcards: string[];\\n  free: boolean;\\n  attending: boolean;\\n  difficulty: Difficulty;\\n  simple: boolean;\\n  glyphs: 'playstation' | 'xbox';\\n  blood: 'red' | 'teal' | 'off';\\n  master: number;\\n  music: number;\\n  effects: number;\\n  voice: number;\\n  autoText: boolean;\\n  seats: number;\\n}\\n\\n/** One attract clip. Times add up to about three minutes. */\\nexport interface Clip {\\n  kind: 'logo' | 'op' | 'story' | 'cards';\\n  id: string;\\n  ms: number;\\n}\\n\\n/** The kiosk loop. */\\nexport const ATTRACT: readonly Clip[] = [\\n  { kind: 'logo', id: '', ms: 6000 },\\n  { kind: 'op', id: 'case:first-cut', ms: 24000 },\\n  { kind: 'op', id: 'case:crosstalk', ms: 24000 },\\n  { kind: 'story', id: 'after-2', ms: 18000 },\\n  { kind: 'op', id: 'case:struck-off', ms: 24000 },\\n  { kind: 'op', id: 'case:reverie', ms: 24000 },\\n  { kind: 'op', id: 'case:gala-night', ms: 24000 },\\n  { kind: 'op', id: 'case:mercy', ms: 26000 },\\n  { kind: 'cards', id: '', ms: 16000 },\\n];\\n\\n/** A menu row. */\\nexport interface Item {\\n  id: string;\\n  label: string;\\n}\\n\\n/** The whole front end. */\\nexport interface Campaign {\\n  screen: Screen;\\n  back: Screen;\\n  progress: Progress;\\n  focus: number;\\n  caseId: string;\\n  caseIndex: number;\\n  storyId: string;\\n  leg: 'before' | 'after';\\n  box: number;\\n  board: number;\\n  tab: number;\\n  page: number;\\n  clip: number;\\n  clipMs: number;\\n  idle: number;\\n  lineMs: number;\\n  record: boolean;\\n  won: boolean;\\n  fail: string;\\n  lastRank: string;\\n  lastScore: number;\\n  postcard: string;\\n  devTab: number;\\n  hideHud: boolean;\\n  claimed: boolean[];\\n}\\n\\nconst MENUS: readonly Screen[] = ['title', 'board', 'settings', 'handbook', 'about', 'scrub'];\\n\\n/** A new night, nothing cleared. */\\nexport function blankProgress(): Progress {\\n  return {\\n    cleared: 0,\\n    ranks: [],\\n    scores: [],\\n    postcards: [],\\n    free: false,\\n    attending: false,\\n    difficulty: 'resident',\\n    simple: false,\\n    glyphs: 'playstation',\\n    blood: 'red',\\n    master: 70,\\n    music: 10,\\n    effects: 100,\\n    voice: 100,\\n    autoText: false,\\n    seats: 1,\\n  };\\n}\\n\\n/** The title, over a blank or a loaded night. */\\nexport function createCampaign(progress: Progress = blankProgress()): Campaign {\\n  return {\\n    screen: 'title',\\n    back: 'title',\\n    progress,\\n    focus: 0,\\n    caseId: 'case:first-cut',\\n    caseIndex: 0,\\n    storyId: 'before-1',\\n    leg: 'before',\\n    box: 0,\\n    board: 0,\\n    tab: 0,\\n    page: 0,\\n    clip: 0,\\n    clipMs: ATTRACT[0].ms,\\n    idle: 0,\\n    lineMs: 0,\\n    record: true,\\n    won: false,\\n    fail: '',\\n    lastRank: '',\\n    lastScore: 0,\\n    postcard: '',\\n    devTab: 0,\\n    hideHud: false,\\n    claimed: [true, false, false, false],\\n  };\\n}\\n\\n/** Story cases plus Free Surgery once the night is over. */\\nexport function boardIds(progress: Progress): string[] {\\n  const ids = storyCases().map((item) => item.id);\\n  if (progress.free) ids.push('case:first-cut');\\n  return ids;\\n}\\n\\n/** Rows for the screen the player is on. */\\nexport function items(c: Campaign): Item[] {\\n  if (c.screen === 'title') {\\n    const rows: Item[] = [];\\n    if (c.progress.cleared > 0 && c.progress.cleared < storyCases().length) rows.push({ id: 'continue', label: 'Continue' });\\n    rows.push({ id: 'new', label: 'New Shift' }, { id: 'board', label: 'The Board' }, { id: 'scrub', label: 'Scrub In' });\\n    rows.push({ id: 'settings', label: 'Settings' }, { id: 'about', label: 'About' });\\n    return rows;\\n  }\\n  if (c.screen === 'board') return [{ id: 'play', label: 'Open case' }, { id: 'postcards', label: 'Postcards' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'brief') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'debrief') {\\n    return c.won\\n      ? [{ id: 'next', label: 'Continue' }]\\n      : [{ id: 'retry', label: 'Retry case' }, { id: 'board', label: 'The Board' }];\\n  }\\n  if (c.screen === 'pause') {\\n    return [\\n      { id: 'resume', label: 'Resume' },\\n      { id: 'phase', label: 'Retry phase' },\\n      { id: 'retry', label: 'Retry case' },\\n      { id: 'handbook', label: 'Handbook' },\\n      { id: 'settings', label: 'Settings' },\\n      { id: 'controls', label: 'Controls' },\\n      { id: 'dev', label: 'Dev Mode' },\\n      { id: 'board', label: 'Quit to Board' },\\n    ];\\n  }\\n  if (c.screen === 'settings') return settingsItems(c);\\n  if (c.screen === 'handbook') return [{ id: 'back', label: 'Back' }];\\n  if (c.screen === 'about' || c.screen === 'credits') return [{ id: 'back', label: c.screen === 'credits' ? 'Title' : 'Back' }];\\n  if (c.screen === 'scrub') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'dev') return devItems(c);\\n  return [];\\n}\\n\\n/** Settings rows for the open page. */\\nfunction settingsItems(c: Campaign): Item[] {\\n  const p = c.progress;\\n  const pages = [\\n    [\\n      { id: 'master', label: `Master ${p.master}` },\\n      { id: 'music', label: `Music ${p.music}` },\\n      { id: 'effects', label: `Effects ${p.effects}` },\\n      { id: 'voice', label: `Voice ${p.voice}` },\\n    ],\\n    [\\n      { id: 'glyphs', label: `Glyphs ${p.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'}` },\\n      { id: 'back', label: 'Back' },\\n    ],\\n    [\\n      { id: 'difficulty', label: `Difficulty ${p.difficulty}` },\\n      { id: 'simple', label: `Simple Gift ${p.simple ? 'on' : 'off'}` },\\n      { id: 'autoText', label: `Auto text ${p.autoText ? 'on' : 'off'}` },\\n    ],\\n    [{ id: 'blood', label: `Blood ${p.blood}` }],\\n  ];\\n  return [...pages[c.page]!, { id: 'back', label: 'Back' }];\\n}\\n\\n/** Dev Mode rows for the open tab. */\\nfunction devItems(c: Campaign): Item[] {\\n  const tabs = ['Play', 'Balance', 'View', 'Author', 'Data'];\\n  if (c.devTab === 1) return [{ id: 'reset', label: 'Reset sliders' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 2) return [{ id: 'hud', label: c.hideHud ? 'Show HUD' : 'Hide HUD' }, { id: 'fly', label: 'Free camera' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 4) return [{ id: 'copy', label: 'Copy replay' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 3) return [{ id: 'back', label: 'Back' }];\\n  return [\\n    { id: 'win', label: 'Win phase' },\\n    { id: 'fail', label: 'Fail phase' },\\n    { id: 'heal', label: 'Restore vitals' },\\n    { id: 'freezeVitals', label: 'Freeze vitals' },\\n    { id: 'freezeClock', label: 'Freeze clock' },\\n    { id: 'gift', label: 'Infinite Gift' },\\n    { id: 'oneHit', label: 'One-hit strains' },\\n    { id: 'spawn', label: 'Spawn a Lull' },\\n    { id: 'unlock', label: 'Unlock the board' },\\n    { id: 'auto', label: 'Autoplay' },\\n    { id: 'step', label: 'Frame step' },\\n    { id: 'slow', label: 'Quarter speed' },\\n    { id: 'fast', label: 'Four times' },\\n    { id: 'tab', label: `Tab ${tabs[c.devTab]}` },\\n    { id: 'back', label: 'Back' },\\n  ];\\n}\\n\\n/** Move the highlight. */\\nexport function move(c: Campaign, dir: number): void {\\n  const rows = items(c);\\n  if (!rows.length) return;\\n  c.focus = (c.focus + dir + rows.length) % rows.length;\\n  c.idle = 0;\\n}\\n\\n/** Browse a card, a page, or a dev tab. */\\nexport function browse(c: Campaign, dir: number): void {\\n  c.idle = 0;\\n  if (c.screen === 'board') {\\n    const ids = boardIds(c.progress);\\n    c.board = (c.board + dir + ids.length) % ids.length;\\n    return;\\n  }\\n  if (c.screen === 'settings') {\\n    c.page = (c.page + dir + 4) % 4;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'handbook') {\\n    const n = handbookCards().length;\\n    c.page = (c.page + dir + n) % n;\\n    return;\\n  }\\n  if (c.screen === 'about' || c.screen === 'credits') {\\n    c.page = Math.max(0, c.page + dir);\\n    return;\\n  }\\n  if (c.screen === 'dev') {\\n    c.devTab = (c.devTab + dir + 5) % 5;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'story') c.box = Math.max(0, c.box + dir);\\n}\\n\\n/** Activate the highlighted row, or advance a story box. */\\nexport function accept(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') return advanceStory(c);\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  const row = items(c)[c.focus];\\n  if (!row) return;\\n  act(c, row.id);\\n}\\n\\n/** Activate a row by id. A click uses this. */\\nexport function act(c: Campaign, id: string): void {\\n  c.idle = 0;\\n  if (id === 'back') return cancel(c);\\n  if (id === 'new') return startShift(c);\\n  if (id === 'continue') return continueShift(c);\\n  if (id === 'board') return go(c, 'board');\\n  if (id === 'scrub') return go(c, 'scrub');\\n  if (id === 'settings') return go(c, 'settings');\\n  if (id === 'about') return go(c, 'about');\\n  if (id === 'handbook') return go(c, 'handbook');\\n  if (id === 'controls') {\\n    go(c, 'settings');\\n    c.page = 1;\\n    return;\\n  }\\n  if (id === 'dev') return go(c, 'dev');\\n  if (id === 'play' && c.screen === 'board') return openBoard(c);\\n  if (id === 'postcards') {\\n    c.tab = c.tab === 0 ? 1 : 0;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'brief') {\\n    c.screen = 'op';\\n    c.record = c.caseIndex === c.progress.cleared;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'scrub') {\\n    c.progress.seats = Math.max(1, c.claimed.filter(Boolean).length);\\n    c.screen = 'title';\\n    return;\\n  }\\n  if (id === 'next' && c.won) return afterWin(c);\\n  if (id === 'retry') return retryCase(c);\\n  if (id === 'phase') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'resume') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'unlock') {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.progress.cleared = storyCases().length;\\n    return;\\n  }\\n  cycleSetting(c, id);\\n}\\n\\n/** Circle, or Escape on a menu. */\\nexport function cancel(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') {\\n    finishScene(c);\\n    return;\\n  }\\n  if (c.screen === 'op') {\\n    c.back = 'op';\\n    c.screen = 'pause';\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'pause') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  if (c.screen === 'credits') {\\n    c.screen = 'title';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.screen = c.back === c.screen ? 'title' : c.back;\\n  if (c.screen === 'pause' || c.screen === 'title') c.focus = 0;\\n}\\n\\n/** Any real input. Attract ends. The idle clock starts over. */\\nexport function noteInput(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'attract') leaveAttract(c);\\n}\\n\\n/** Milliseconds since the last input. Menus become the kiosk. A session never does. */\\nexport function tickFront(c: Campaign, dtMs: number, inSession: boolean): void {\\n  if (inSession) return;\\n  if (c.screen === 'attract') {\\n    c.clipMs -= dtMs;\\n    if (c.clipMs <= 0) {\\n      c.clip = (c.clip + 1) % ATTRACT.length;\\n      c.clipMs = ATTRACT[c.clip].ms;\\n      if (ATTRACT[c.clip].kind === 'story') c.box = 0;\\n    }\\n    return;\\n  }\\n  if (c.screen === 'story' && c.progress.autoText) {\\n    c.lineMs += dtMs;\\n    if (c.lineMs > 2500) {\\n      c.lineMs = 0;\\n      advanceStory(c);\\n    }\\n  }\\n  if (!MENUS.includes(c.screen)) return;\\n  c.idle += dtMs;\\n  if (c.idle >= 10000) enterAttract(c);\\n}\\n\\n/** The operation ended. Attract ignores the rank. A recorded win waits for the scene after it. */\\nexport function finishOp(c: Campaign, won: boolean, score: number, slips: number, fail: string): void {\\n  if (c.screen !== 'op') return;\\n  const def = caseById(c.caseId);\\n  c.won = won;\\n  c.fail = won ? '' : fail || 'Called off.';\\n  c.lastScore = score;\\n  if (won) {\\n    const rank = rankFor(score, def.par, slips, c.progress.difficulty);\\n    c.lastRank = rank;\\n    const letter = rank === '★' ? 'S' : (rank as Exclude<Rank, '★'>);\\n    c.postcard = def.patients[0]?.postcards[letter] ?? '';\\n    if (c.record) {\\n      c.progress.ranks[c.caseIndex] = rank;\\n      c.progress.scores[c.caseIndex] = score;\\n      c.progress.postcards[c.caseIndex] = c.postcard;\\n    }\\n  }\\n  c.screen = 'debrief';\\n  c.focus = 0;\\n}\\n\\n/** The run the scene should be showing. */\\nexport function desiredRun(c: Campaign): string {\\n  if (c.screen === 'op') return `op:${c.caseId}`;\\n  if (c.screen === 'attract') {\\n    const clip = ATTRACT[c.clip];\\n    if (clip.kind === 'op') return `op:${clip.id}`;\\n  }\\n  return 'title';\\n}\\n\\n/** True while the kiosk is inside an operation. */\\nexport function desiredAttract(c: Campaign): boolean {\\n  return c.screen === 'attract' && ATTRACT[c.clip].kind === 'op';\\n}\\n\\n/** The story box on screen, if this screen has one. */\\nexport function currentBox(c: Campaign): { who: string; text: string; drama: string; where: string } | null {\\n  const id = c.screen === 'attract' && ATTRACT[c.clip].kind === 'story' ? ATTRACT[c.clip].id : c.screen === 'story' ? c.storyId : '';\\n  if (!id) return null;\\n  const scene = sceneById(id);\\n  if (!scene) return null;\\n  const box = scene.boxes[Math.min(c.box, scene.boxes.length - 1)];\\n  return { who: box.who, text: box.text, drama: box.drama ?? '', where: scene.where };\\n}\\n\\n/** Handbook card on the open page. */\\nexport function handbookPage(c: Campaign): { title: string; body: string; index: number; count: number } {\\n  const cards = handbookCards();\\n  const index = ((c.page % cards.length) + cards.length) % cards.length;\\n  return { ...cards[index], index, count: cards.length };\\n}\\n\\nfunction go(c: Campaign, screen: Screen): void {\\n  c.back = c.screen === screen ? c.back : c.screen;\\n  c.screen = screen;\\n  c.focus = 0;\\n  c.page = 0;\\n}\\n\\nfunction startShift(c: Campaign): void {\\n  c.progress.cleared = 0;\\n  c.progress.ranks = [];\\n  c.progress.scores = [];\\n  c.progress.postcards = [];\\n  c.record = true;\\n  openCase(c, 0, 'before');\\n}\\n\\nfunction continueShift(c: Campaign): void {\\n  const index = Math.min(c.progress.cleared, storyCases().length - 1);\\n  const leg = c.progress.ranks[index] ? 'after' : 'before';\\n  c.record = true;\\n  openCase(c, index, leg);\\n}\\n\\nfunction openBoard(c: Campaign): void {\\n  const ids = boardIds(c.progress);\\n  const id = ids[c.board] ?? ids[0];\\n  const index = storyCases().findIndex((item) => item.id === id);\\n  const unlocked = c.progress.free || index <= c.progress.cleared;\\n  if (!unlocked || index < 0) return;\\n  c.record = index === c.progress.cleared;\\n  c.caseIndex = index;\\n  c.caseId = storyCases()[index].id;\\n  c.screen = 'brief';\\n  c.focus = 0;\\n}\\n\\nfunction openCase(c: Campaign, index: number, leg: 'before' | 'after'): void {\\n  const def = storyCases()[index];\\n  if (!def) {\\n    c.screen = 'credits';\\n    return;\\n  }\\n  c.caseIndex = index;\\n  c.caseId = def.id;\\n  c.leg = leg;\\n  c.storyId = leg === 'before' ? def.storyBefore : def.storyAfter;\\n  c.box = 0;\\n  c.lineMs = 0;\\n  c.screen = 'story';\\n}\\n\\nfunction advanceStory(c: Campaign): void {\\n  const scene = sceneById(c.storyId);\\n  if (!scene) return;\\n  if (c.box < scene.boxes.length - 1) {\\n    c.box += 1;\\n    return;\\n  }\\n  finishScene(c);\\n}\\n\\nfunction finishScene(c: Campaign): void {\\n  if (c.leg === 'before') {\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.progress.cleared = Math.max(c.progress.cleared, c.caseIndex + 1);\\n  if (c.progress.cleared >= storyCases().length) {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.screen = 'credits';\\n    c.page = 0;\\n    return;\\n  }\\n  openCase(c, c.progress.cleared, 'before');\\n}\\n\\nfunction afterWin(c: Campaign): void {\\n  c.leg = 'after';\\n  const def = storyCases()[c.caseIndex];\\n  c.storyId = def?.storyAfter ?? 'after-1';\\n  c.box = 0;\\n  c.screen = 'story';\\n}\\n\\nfunction retryCase(c: Campaign): void {\\n  c.screen = 'op';\\n  c.won = false;\\n}\\n\\nfunction enterAttract(c: Campaign): void {\\n  c.screen = 'attract';\\n  c.clip = 0;\\n  c.clipMs = ATTRACT[0].ms;\\n  c.box = 0;\\n  c.record = false;\\n}\\n\\nfunction leaveAttract(c: Campaign): void {\\n  c.screen = 'title';\\n  c.focus = 0;\\n  c.idle = 0;\\n  c.record = true;\\n}\\n\\nfunction cycleSetting(c: Campaign, id: string): void {\\n  const p = c.progress;\\n  const volume = (n: number) => [0, 10, 40, 70, 100][([0, 10, 40, 70, 100].indexOf(n) + 1) % 5] ?? 70;\\n  if (id === 'master') p.master = volume(p.master);\\n  if (id === 'music') p.music = volume(p.music);\\n  if (id === 'effects') p.effects = volume(p.effects);\\n  if (id === 'voice') p.voice = volume(p.voice);\\n  if (id === 'glyphs') p.glyphs = p.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n  if (id === 'difficulty') {\\n    const order: Difficulty[] = ['intern', 'resident', 'attending'];\\n    const next = order[(order.indexOf(p.difficulty) + 1) % 3];\\n    if (next === 'attending' && !p.attending && !p.free) return;\\n    p.difficulty = next;\\n  }\\n  if (id === 'simple') p.simple = !p.simple;\\n  if (id === 'autoText') p.autoText = !p.autoText;\\n  if (id === 'blood') p.blood = p.blood === 'red' ? 'teal' : p.blood === 'teal' ? 'off' : 'red';\\n  if (id === 'hud') c.hideHud = !c.hideHud;\\n}\\n\\n/** Claim a scrub seat. The keyboard claims the first. */\\nexport function claimSeat(c: Campaign, index: number): void {\\n  if (index < 0 || index > 3) return;\\n  c.claimed[index] = true;\\n  c.idle = 0;\\n}\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.ts has been created.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.ts has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.ts\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"/**\\n * @file The shift, with no DOM. Title, story, briefing, operation, debrief, and the menus around them.\\n * The page draws whatever this says and starts the run it names.\\n */\\nimport { storyCases } from '../op/cases';\\nimport { caseById } from '../op/cases';\\nimport { rankFor } from '../op/ratings';\\nimport { sceneById } from '../op/story';\\nimport { handbookCards } from '../op/table';\\nimport type { Difficulty, Rank } from '../op/types';\\n\\n/** Where the player is. */\\nexport type Screen =\\n  | 'title'\\n  | 'board'\\n  | 'story'\\n  | 'brief'\\n  | 'op'\\n  | 'debrief'\\n  | 'pause'\\n  | 'settings'\\n  | 'handbook'\\n  | 'about'\\n  | 'scrub'\\n  | 'credits'\\n  | 'attract'\\n  | 'dev';\\n\\n/** What a finished night remembers. Dev runs and the attract loop do not write it. */\\nexport interface Progress {\\n  cleared: number;\\n  ranks: string[];\\n  scores: number[];\\n  postcards: string[];\\n  free: boolean;\\n  attending: boolean;\\n  difficulty: Difficulty;\\n  simple: boolean;\\n  glyphs: 'playstation' | 'xbox';\\n  blood: 'red' | 'teal' | 'off';\\n  master: number;\\n  music: number;\\n  effects: number;\\n  voice: number;\\n  autoText: boolean;\\n  seats: number;\\n}\\n\\n/** One attract clip. Times add up to about three minutes. */\\nexport interface Clip {\\n  kind: 'logo' | 'op' | 'story' | 'cards';\\n  id: string;\\n  ms: number;\\n}\\n\\n/** The kiosk loop. */\\nexport const ATTRACT: readonly Clip[] = [\\n  { kind: 'logo', id: '', ms: 6000 },\\n  { kind: 'op', id: 'case:first-cut', ms: 24000 },\\n  { kind: 'op', id: 'case:crosstalk', ms: 24000 },\\n  { kind: 'story', id: 'after-2', ms: 18000 },\\n  { kind: 'op', id: 'case:struck-off', ms: 24000 },\\n  { kind: 'op', id: 'case:reverie', ms: 24000 },\\n  { kind: 'op', id: 'case:gala-night', ms: 24000 },\\n  { kind: 'op', id: 'case:mercy', ms: 26000 },\\n  { kind: 'cards', id: '', ms: 16000 },\\n];\\n\\n/** A menu row. */\\nexport interface Item {\\n  id: string;\\n  label: string;\\n}\\n\\n/** The whole front end. */\\nexport interface Campaign {\\n  screen: Screen;\\n  back: Screen;\\n  progress: Progress;\\n  focus: number;\\n  caseId: string;\\n  caseIndex: number;\\n  storyId: string;\\n  leg: 'before' | 'after';\\n  box: number;\\n  board: number;\\n  tab: number;\\n  page: number;\\n  clip: number;\\n  clipMs: number;\\n  idle: number;\\n  lineMs: number;\\n  record: boolean;\\n  won: boolean;\\n  fail: string;\\n  lastRank: string;\\n  lastScore: number;\\n  postcard: string;\\n  devTab: number;\\n  hideHud: boolean;\\n  claimed: boolean[];\\n}\\n\\nconst MENUS: readonly Screen[] = ['title', 'board', 'settings', 'handbook', 'about', 'scrub'];\\n\\n/** A new night, nothing cleared. */\\nexport function blankProgress(): Progress {\\n  return {\\n    cleared: 0,\\n    ranks: [],\\n    scores: [],\\n    postcards: [],\\n    free: false,\\n    attending: false,\\n    difficulty: 'resident',\\n    simple: false,\\n    glyphs: 'playstation',\\n    blood: 'red',\\n    master: 70,\\n    music: 10,\\n    effects: 100,\\n    voice: 100,\\n    autoText: false,\\n    seats: 1,\\n  };\\n}\\n\\n/** The title, over a blank or a loaded night. */\\nexport function createCampaign(progress: Progress = blankProgress()): Campaign {\\n  return {\\n    screen: 'title',\\n    back: 'title',\\n    progress,\\n    focus: 0,\\n    caseId: 'case:first-cut',\\n    caseIndex: 0,\\n    storyId: 'before-1',\\n    leg: 'before',\\n    box: 0,\\n    board: 0,\\n    tab: 0,\\n    page: 0,\\n    clip: 0,\\n    clipMs: ATTRACT[0].ms,\\n    idle: 0,\\n    lineMs: 0,\\n    record: true,\\n    won: false,\\n    fail: '',\\n    lastRank: '',\\n    lastScore: 0,\\n    postcard: '',\\n    devTab: 0,\\n    hideHud: false,\\n    claimed: [true, false, false, false],\\n  };\\n}\\n\\n/** Story cases plus Free Surgery once the night is over. */\\nexport function boardIds(progress: Progress): string[] {\\n  const ids = storyCases().map((item) => item.id);\\n  if (progress.free) ids.push('case:first-cut');\\n  return ids;\\n}\\n\\n/** Rows for the screen the player is on. */\\nexport function items(c: Campaign): Item[] {\\n  if (c.screen === 'title') {\\n    const rows: Item[] = [];\\n    if (c.progress.cleared > 0 && c.progress.cleared < storyCases().length) rows.push({ id: 'continue', label: 'Continue' });\\n    rows.push({ id: 'new', label: 'New Shift' }, { id: 'board', label: 'The Board' }, { id: 'scrub', label: 'Scrub In' });\\n    rows.push({ id: 'settings', label: 'Settings' }, { id: 'about', label: 'About' });\\n    return rows;\\n  }\\n  if (c.screen === 'board') return [{ id: 'play', label: 'Open case' }, { id: 'postcards', label: 'Postcards' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'brief') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'debrief') {\\n    return c.won\\n      ? [{ id: 'next', label: 'Continue' }]\\n      : [{ id: 'retry', label: 'Retry case' }, { id: 'board', label: 'The Board' }];\\n  }\\n  if (c.screen === 'pause') {\\n    return [\\n      { id: 'resume', label: 'Resume' },\\n      { id: 'phase', label: 'Retry phase' },\\n      { id: 'retry', label: 'Retry case' },\\n      { id: 'handbook', label: 'Handbook' },\\n      { id: 'settings', label: 'Settings' },\\n      { id: 'controls', label: 'Controls' },\\n      { id: 'dev', label: 'Dev Mode' },\\n      { id: 'board', label: 'Quit to Board' },\\n    ];\\n  }\\n  if (c.screen === 'settings') return settingsItems(c);\\n  if (c.screen === 'handbook') return [{ id: 'back', label: 'Back' }];\\n  if (c.screen === 'about' || c.screen === 'credits') return [{ id: 'back', label: c.screen === 'credits' ? 'Title' : 'Back' }];\\n  if (c.screen === 'scrub') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'dev') return devItems(c);\\n  return [];\\n}\\n\\n/** Settings rows for the open page. */\\nfunction settingsItems(c: Campaign): Item[] {\\n  const p = c.progress;\\n  const pages = [\\n    [\\n      { id: 'master', label: `Master ${p.master}` },\\n      { id: 'music', label: `Music ${p.music}` },\\n      { id: 'effects', label: `Effects ${p.effects}` },\\n      { id: 'voice', label: `Voice ${p.voice}` },\\n    ],\\n    [\\n      { id: 'glyphs', label: `Glyphs ${p.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'}` },\\n      { id: 'back', label: 'Back' },\\n    ],\\n    [\\n      { id: 'difficulty', label: `Difficulty ${p.difficulty}` },\\n      { id: 'simple', label: `Simple Gift ${p.simple ? 'on' : 'off'}` },\\n      { id: 'autoText', label: `Auto text ${p.autoText ? 'on' : 'off'}` },\\n    ],\\n    [{ id: 'blood', label: `Blood ${p.blood}` }],\\n  ];\\n  return [...pages[c.page]!, { id: 'back', label: 'Back' }];\\n}\\n\\n/** Dev Mode rows for the open tab. */\\nfunction devItems(c: Campaign): Item[] {\\n  const tabs = ['Play', 'Balance', 'View', 'Author', 'Data'];\\n  if (c.devTab === 1) return [{ id: 'reset', label: 'Reset sliders' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 2) return [{ id: 'hud', label: c.hideHud ? 'Show HUD' : 'Hide HUD' }, { id: 'fly', label: 'Free camera' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 4) return [{ id: 'copy', label: 'Copy replay' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 3) return [{ id: 'back', label: 'Back' }];\\n  return [\\n    { id: 'win', label: 'Win phase' },\\n    { id: 'fail', label: 'Fail phase' },\\n    { id: 'heal', label: 'Restore vitals' },\\n    { id: 'freezeVitals', label: 'Freeze vitals' },\\n    { id: 'freezeClock', label: 'Freeze clock' },\\n    { id: 'gift', label: 'Infinite Gift' },\\n    { id: 'oneHit', label: 'One-hit strains' },\\n    { id: 'spawn', label: 'Spawn a Lull' },\\n    { id: 'unlock', label: 'Unlock the board' },\\n    { id: 'auto', label: 'Autoplay' },\\n    { id: 'step', label: 'Frame step' },\\n    { id: 'slow', label: 'Quarter speed' },\\n    { id: 'fast', label: 'Four times' },\\n    { id: 'tab', label: `Tab ${tabs[c.devTab]}` },\\n    { id: 'back', label: 'Back' },\\n  ];\\n}\\n\\n/** Move the highlight. */\\nexport function move(c: Campaign, dir: number): void {\\n  const rows = items(c);\\n  if (!rows.length) return;\\n  c.focus = (c.focus + dir + rows.length) % rows.length;\\n  c.idle = 0;\\n}\\n\\n/** Browse a card, a page, or a dev tab. */\\nexport function browse(c: Campaign, dir: number): void {\\n  c.idle = 0;\\n  if (c.screen === 'board') {\\n    const ids = boardIds(c.progress);\\n    c.board = (c.board + dir + ids.length) % ids.length;\\n    return;\\n  }\\n  if (c.screen === 'settings') {\\n    c.page = (c.page + dir + 4) % 4;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'handbook') {\\n    const n = handbookCards().length;\\n    c.page = (c.page + dir + n) % n;\\n    return;\\n  }\\n  if (c.screen === 'about' || c.screen === 'credits') {\\n    c.page = Math.max(0, c.page + dir);\\n    return;\\n  }\\n  if (c.screen === 'dev') {\\n    c.devTab = (c.devTab + dir + 5) % 5;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'story') c.box = Math.max(0, c.box + dir);\\n}\\n\\n/** Activate the highlighted row, or advance a story box. */\\nexport function accept(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') return advanceStory(c);\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  const row = items(c)[c.focus];\\n  if (!row) return;\\n  act(c, row.id);\\n}\\n\\n/** Activate a row by id. A click uses this. */\\nexport function act(c: Campaign, id: string): void {\\n  c.idle = 0;\\n  if (id === 'back') return cancel(c);\\n  if (id === 'new') return startShift(c);\\n  if (id === 'continue') return continueShift(c);\\n  if (id === 'board') return go(c, 'board');\\n  if (id === 'scrub') return go(c, 'scrub');\\n  if (id === 'settings') return go(c, 'settings');\\n  if (id === 'about') return go(c, 'about');\\n  if (id === 'handbook') return go(c, 'handbook');\\n  if (id === 'controls') {\\n    go(c, 'settings');\\n    c.page = 1;\\n    return;\\n  }\\n  if (id === 'dev') return go(c, 'dev');\\n  if (id === 'play' && c.screen === 'board') return openBoard(c);\\n  if (id === 'postcards') {\\n    c.tab = c.tab === 0 ? 1 : 0;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'brief') {\\n    c.screen = 'op';\\n    c.record = c.caseIndex === c.progress.cleared;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'scrub') {\\n    c.progress.seats = Math.max(1, c.claimed.filter(Boolean).length);\\n    c.screen = 'title';\\n    return;\\n  }\\n  if (id === 'next' && c.won) return afterWin(c);\\n  if (id === 'retry') return retryCase(c);\\n  if (id === 'phase') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'resume') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'unlock') {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.progress.cleared = storyCases().length;\\n    return;\\n  }\\n  cycleSetting(c, id);\\n}\\n\\n/** Circle, or Escape on a menu. */\\nexport function cancel(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') {\\n    finishScene(c);\\n    return;\\n  }\\n  if (c.screen === 'op') {\\n    c.back = 'op';\\n    c.screen = 'pause';\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'pause') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  if (c.screen === 'credits') {\\n    c.screen = 'title';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.screen = c.back === c.screen ? 'title' : c.back;\\n  if (c.screen === 'pause' || c.screen === 'title') c.focus = 0;\\n}\\n\\n/** Any real input. Attract ends. The idle clock starts over. */\\nexport function noteInput(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'attract') leaveAttract(c);\\n}\\n\\n/** Milliseconds since the last input. Menus become the kiosk. A session never does. */\\nexport function tickFront(c: Campaign, dtMs: number, inSession: boolean): void {\\n  if (inSession) return;\\n  if (c.screen === 'attract') {\\n    c.clipMs -= dtMs;\\n    if (c.clipMs <= 0) {\\n      c.clip = (c.clip + 1) % ATTRACT.length;\\n      c.clipMs = ATTRACT[c.clip].ms;\\n      if (ATTRACT[c.clip].kind === 'story') c.box = 0;\\n    }\\n    return;\\n  }\\n  if (c.screen === 'story' && c.progress.autoText) {\\n    c.lineMs += dtMs;\\n    if (c.lineMs > 2500) {\\n      c.lineMs = 0;\\n      advanceStory(c);\\n    }\\n  }\\n  if (!MENUS.includes(c.screen)) return;\\n  c.idle += dtMs;\\n  if (c.idle >= 10000) enterAttract(c);\\n}\\n\\n/** The operation ended. Attract ignores the rank. A recorded win waits for the scene after it. */\\nexport function finishOp(c: Campaign, won: boolean, score: number, slips: number, fail: string): void {\\n  if (c.screen !== 'op') return;\\n  const def = caseById(c.caseId);\\n  c.won = won;\\n  c.fail = won ? '' : fail || 'Called off.';\\n  c.lastScore = score;\\n  if (won) {\\n    const rank = rankFor(score, def.par, slips, c.progress.difficulty);\\n    c.lastRank = rank;\\n    const letter = rank === '★' ? 'S' : (rank as Exclude<Rank, '★'>);\\n    c.postcard = def.patients[0]?.postcards[letter] ?? '';\\n    if (c.record) {\\n      c.progress.ranks[c.caseIndex] = rank;\\n      c.progress.scores[c.caseIndex] = score;\\n      c.progress.postcards[c.caseIndex] = c.postcard;\\n    }\\n  }\\n  c.screen = 'debrief';\\n  c.focus = 0;\\n}\\n\\n/** The run the scene should be showing. */\\nexport function desiredRun(c: Campaign): string {\\n  if (c.screen === 'op') return `op:${c.caseId}`;\\n  if (c.screen === 'attract') {\\n    const clip = ATTRACT[c.clip];\\n    if (clip.kind === 'op') return `op:${clip.id}`;\\n  }\\n  return 'title';\\n}\\n\\n/** True while the kiosk is inside an operation. */\\nexport function desiredAttract(c: Campaign): boolean {\\n  return c.screen === 'attract' && ATTRACT[c.clip].kind === 'op';\\n}\\n\\n/** The story box on screen, if this screen has one. */\\nexport function currentBox(c: Campaign): { who: string; text: string; drama: string; where: string } | null {\\n  const id = c.screen === 'attract' && ATTRACT[c.clip].kind === 'story' ? ATTRACT[c.clip].id : c.screen === 'story' ? c.storyId : '';\\n  if (!id) return null;\\n  const scene = sceneById(id);\\n  if (!scene) return null;\\n  const box = scene.boxes[Math.min(c.box, scene.boxes.length - 1)];\\n  return { who: box.who, text: box.text, drama: box.drama ?? '', where: scene.where };\\n}\\n\\n/** Handbook card on the open page. */\\nexport function handbookPage(c: Campaign): { title: string; body: string; index: number; count: number } {\\n  const cards = handbookCards();\\n  const index = ((c.page % cards.length) + cards.length) % cards.length;\\n  return { ...cards[index], index, count: cards.length };\\n}\\n\\nfunction go(c: Campaign, screen: Screen): void {\\n  c.back = c.screen === screen ? c.back : c.screen;\\n  c.screen = screen;\\n  c.focus = 0;\\n  c.page = 0;\\n}\\n\\nfunction startShift(c: Campaign): void {\\n  c.progress.cleared = 0;\\n  c.progress.ranks = [];\\n  c.progress.scores = [];\\n  c.progress.postcards = [];\\n  c.record = true;\\n  openCase(c, 0, 'before');\\n}\\n\\nfunction continueShift(c: Campaign): void {\\n  const index = Math.min(c.progress.cleared, storyCases().length - 1);\\n  const leg = c.progress.ranks[index] ? 'after' : 'before';\\n  c.record = true;\\n  openCase(c, index, leg);\\n}\\n\\nfunction openBoard(c: Campaign): void {\\n  const ids = boardIds(c.progress);\\n  const id = ids[c.board] ?? ids[0];\\n  const index = storyCases().findIndex((item) => item.id === id);\\n  const unlocked = c.progress.free || index <= c.progress.cleared;\\n  if (!unlocked || index < 0) return;\\n  c.record = index === c.progress.cleared;\\n  c.caseIndex = index;\\n  c.caseId = storyCases()[index].id;\\n  c.screen = 'brief';\\n  c.focus = 0;\\n}\\n\\nfunction openCase(c: Campaign, index: number, leg: 'before' | 'after'): void {\\n  const def = storyCases()[index];\\n  if (!def) {\\n    c.screen = 'credits';\\n    return;\\n  }\\n  c.caseIndex = index;\\n  c.caseId = def.id;\\n  c.leg = leg;\\n  c.storyId = leg === 'before' ? def.storyBefore : def.storyAfter;\\n  c.box = 0;\\n  c.lineMs = 0;\\n  c.screen = 'story';\\n}\\n\\nfunction advanceStory(c: Campaign): void {\\n  const scene = sceneById(c.storyId);\\n  if (!scene) return;\\n  if (c.box < scene.boxes.length - 1) {\\n    c.box += 1;\\n    return;\\n  }\\n  finishScene(c);\\n}\\n\\nfunction finishScene(c: Campaign): void {\\n  if (c.leg === 'before') {\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.progress.cleared = Math.max(c.progress.cleared, c.caseIndex + 1);\\n  if (c.progress.cleared >= storyCases().length) {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.screen = 'credits';\\n    c.page = 0;\\n    return;\\n  }\\n  openCase(c, c.progress.cleared, 'before');\\n}\\n\\nfunction afterWin(c: Campaign): void {\\n  c.leg = 'after';\\n  const def = storyCases()[c.caseIndex];\\n  c.storyId = def?.storyAfter ?? 'after-1';\\n  c.box = 0;\\n  c.screen = 'story';\\n}\\n\\nfunction retryCase(c: Campaign): void {\\n  c.screen = 'op';\\n  c.won = false;\\n}\\n\\nfunction enterAttract(c: Campaign): void {\\n  c.screen = 'attract';\\n  c.clip = 0;\\n  c.clipMs = ATTRACT[0].ms;\\n  c.box = 0;\\n  c.record = false;\\n}\\n\\nfunction leaveAttract(c: Campaign): void {\\n  c.screen = 'title';\\n  c.focus = 0;\\n  c.idle = 0;\\n  c.record = true;\\n}\\n\\nfunction cycleSetting(c: Campaign, id: string): void {\\n  const p = c.progress;\\n  const volume = (n: number) => [0, 10, 40, 70, 100][([0, 10, 40, 70, 100].indexOf(n) + 1) % 5] ?? 70;\\n  if (id === 'master') p.master = volume(p.master);\\n  if (id === 'music') p.music = volume(p.music);\\n  if (id === 'effects') p.effects = volume(p.effects);\\n  if (id === 'voice') p.voice = volume(p.voice);\\n  if (id === 'glyphs') p.glyphs = p.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n  if (id === 'difficulty') {\\n    const order: Difficulty[] = ['intern', 'resident', 'attending'];\\n    const next = order[(order.indexOf(p.difficulty) + 1) % 3];\\n    if (next === 'attending' && !p.attending && !p.free) return;\\n    p.difficulty = next;\\n  }\\n  if (id === 'simple') p.simple = !p.simple;\\n  if (id === 'autoText') p.autoText = !p.autoText;\\n  if (id === 'blood') p.blood = p.blood === 'red' ? 'teal' : p.blood === 'teal' ? 'off' : 'red';\\n  if (id === 'hud') c.hideHud = !c.hideHud;\\n}\\n\\n/** Claim a scrub seat. The keyboard claims the first. */\\nexport function claimSeat(c: Campaign, index: number): void {\\n  if (index < 0 || index > 3) return;\\n  c.claimed[index] = true;\\n  c.idle = 0;\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-80be7d5e-cc2f-4d31-a13b-078ac2b0c30f-143","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"/**\\n * @file The shift with no browser: a new night reaches a briefing, a win reaches the next scene, and ten quiet\\n * seconds on the title become the kiosk.\\n */\\nimport { describe, expect, it } from 'vitest';\\nimport { ATTRACT, accept, act, createCampaign, desiredRun, finishOp, items, tickFront } from './campaign';\\n\\ndescribe('campaign', () => {\\n  it('walks a new shift as far as the first briefing', () => {\\n    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('before-1');\\n    for (let i = 0; i < 40; i++) accept(campaign);\\n    expect(campaign.screen).toBe('brief');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('op');\\n    expect(desiredRun(campaign)).toBe('op:case:first-cut');\\n  });\\n\\n  it('records a win and then the scene after the case', () => {\\n    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    for (let i = 0; i < 40; i++) accept(campaign);\\n    finishOp(campaign, true, 16815, 0, '');\\n    expect(campaign.screen).toBe('debrief');\\n    expect(campaign.lastRank).toBe('S');\\n    expect(campaign.progress.ranks[0]).toBe('S');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('after-1');\\n  });\\n\\n  it('starts the kiosk after ten seconds on the title and leaves it on a press', () => {\\n    const campaign = createCampaign();\\n    tickFront(campaign, 9999, false);\\n    expect(campaign.screen).toBe('title');\\n    tickFront(campaign, 2, false);\\n    expect(campaign.screen).toBe('attract');\\n    expect(ATTRACT.reduce((sum, clip) => sum + clip.ms, 0)).toBeGreaterThan(170000);\\n    const before = items(campaign);\\n    expect(before).toEqual([]);\\n    accept(campaign);\\n    expect(campaign.screen).toBe('title');\\n  });\\n});\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.test.ts has been created.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.test.ts has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.test.ts\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"/**\\n * @file The shift with no browser: a new night reaches a briefing, a win reaches the next scene, and ten quiet\\n * seconds on the title become the kiosk.\\n */\\nimport { describe, expect, it } from 'vitest';\\nimport { ATTRACT, accept, act, createCampaign, desiredRun, finishOp, items, tickFront } from './campaign';\\n\\ndescribe('campaign', () => {\\n  it('walks a new shift as far as the first briefing', () => {\\n    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('before-1');\\n    for (let i = 0; i < 40; i++) accept(campaign);\\n    expect(campaign.screen).toBe('brief');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('op');\\n    expect(desiredRun(campaign)).toBe('op:case:first-cut');\\n  });\\n\\n  it('records a win and then the scene after the case', () => {\\n    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    for (let i = 0; i < 40; i++) accept(campaign);\\n    finishOp(campaign, true, 16815, 0, '');\\n    expect(campaign.screen).toBe('debrief');\\n    expect(campaign.lastRank).toBe('S');\\n    expect(campaign.progress.ranks[0]).toBe('S');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('after-1');\\n  });\\n\\n  it('starts the kiosk after ten seconds on the title and leaves it on a press', () => {\\n    const campaign = createCampaign();\\n    tickFront(campaign, 9999, false);\\n    expect(campaign.screen).toBe('title');\\n    tickFront(campaign, 2, false);\\n    expect(campaign.screen).toBe('attract');\\n    expect(ATTRACT.reduce((sum, clip) => sum + clip.ms, 0)).toBeGreaterThan(170000);\\n    const before = items(campaign);\\n    expect(before).toEqual([]);\\n    accept(campaign);\\n    expect(campaign.screen).toBe('title');\\n  });\\n});\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"e1cc736b-b3ec-48df-9571-cf06d743e9fc"}
