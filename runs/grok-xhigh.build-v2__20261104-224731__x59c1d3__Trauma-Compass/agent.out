h('case:gala-shift');\\n  return ids;\\n}\\n\\n160→export function items(c: Campaign): Item[] {\\n  if (c.screen === 'title') {\\n    const rows: Item[] = [];\\n    if (c.progress.cleared > 0 && c.progress.cleared < storyCases().length)\\n      rows.push({ id: 'continue', label: 'Continue' });\\n    rows.push(\\n      { id: 'new', label: 'New Shift' },\\n      { id: 'board', label: 'The Board' },\\n      { id: 'scrub', label: 'Scrub In' },\\n    );\\n170→    rows.push({ id: 'settings', label: 'Settings' }, { id: 'about', label: 'About' });\\n    return rows;\\n  }\\n  if (c.screen === 'board')\\n    return [\\n      { id: 'play', label: 'Open case' },\\n      { id: 'postcards', label: 'Postcards' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.screen === 'brief')\\n180→    return [\\n      { id: 'start', label: 'Start' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.screen === 'debrief') {\\n    return c.won\\n      ? [{ id: 'next', label: 'Continue' }]\\n      : [\\n          { id: 'retry', label: 'Retry case' },\\n          { id: 'board', label: 'The Board' },\\n190→        ];\\n  }\\n  if (c.screen === 'pause') {\\n    return [\\n      { id: 'resume', label: 'Resume' },\\n      { id: 'phase', label: 'Retry phase' },\\n      { id: 'retry', label: 'Retry case' },\\n      { id: 'handbook', label: 'Handbook' },\\n      { id: 'settings', label: 'Settings' },\\n      { id: 'controls', label: 'Controls' },\\n200→      { id: 'dev', label: 'Dev Mode' },\\n      { id: 'board', label: 'Quit to Board' },\\n    ];\\n  }\\n  if (c.screen === 'settings') return settingsItems(c);\\n  if (c.screen === 'handbook') return [{ id: 'back', label: 'Back' }];\\n  if (c.screen === 'about' || c.screen === 'credits')\\n    return [{ id: 'back', label: c.screen === 'credits' ? 'Title' : 'Back' }];\\n  if (c.screen === 'scrub')\\n    return [\\n210→      { id: 'start', label: 'Start' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.screen === 'dev') return devItems(c);\\n  return [];\\n}\\n\\nfunction settingsItems(c: Campaign): Item[] {\\n  const p = c.progress;\\n  const pages = [\\n220→    [\\n      { id: 'master', label: `Master ${p.master}` },\\n      { id: 'music', label: `Music ${p.music}` },\\n      { id: 'effects', label: `Effects ${p.effects}` },\\n      { id: 'voice', label: `Voice ${p.voice}` },\\n    ],\\n    [{ id: 'glyphs', label: `Glyphs ${p.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'}` }],\\n    [\\n      { id: 'difficulty', label: `Difficulty ${p.difficulty}` },\\n      { id: 'simple', label: `Simple Gift ${p.simple ? 'on' : 'off'}` },\\n230→      { id: 'autoText', label: `Auto text ${p.autoText ? 'on' : 'off'}` },\\n    ],\\n    [{ id: 'blood', label: `Blood ${p.blood}` }],\\n  ];\\n  return [...pages[c.page]!, { id: 'back', label: 'Back' }];\\n}\\n\\nfunction devItems(c: Campaign): Item[] {\\n  const tabs = ['Play', 'Balance', 'View', 'Author', 'Data'];\\n  if (c.devTab === 1)\\n240→    return [\\n      { id: 'reset', label: 'Reset sliders' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.devTab === 2)\\n    return [\\n      { id: 'hud', label: c.hideHud ? 'Show HUD' : 'Hide HUD' },\\n      { id: 'fly', label: 'Free camera' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n250→  if (c.devTab === 4)\\n    return [\\n      { id: 'copy', label: 'Copy replay' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.devTab === 3) return [{ id: 'back', label: 'Back' }];\\n  return [\\n    { id: 'win', label: 'Win phase' },\\n    { id: 'fail', label: 'Fail phase' },\\n    { id: 'heal', label: 'Restore vitals' },\\n260→    { id: 'freezeVitals', label: 'Freeze vitals' },\\n    { id: 'freezeClock', label: 'Freeze clock' },\\n    { id: 'gift', label: 'Infinite Gift' },\\n    { id: 'oneHit', label: 'One-hit strains' },\\n    { id: 'spawn', label: 'Spawn a Lull' },\\n    { id: 'unlock', label: 'Unlock the board' },\\n    { id: 'auto', label: 'Autoplay' },\\n    { id: 'step', label: 'Frame step' },\\n    { id: 'slow', label: 'Quarter speed' },\\n    { id: 'fast', label: 'Four times' },\\n270→    { id: 'tab', label: `Tab ${tabs[c.devTab]}` },\\n    { id: 'back', label: 'Back' },\\n  ];\\n}\\n\\nexport function move(c: Campaign, dir: number): void {\\n  const rows = items(c);\\n  if (!rows.length) return;\\n  c.focus = (c.focus + dir + rows.length) % rows.length;\\n  c.idle = 0;\\n280→}\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.ts\",\"offset\":1,\"limit\":280,\"raw_output\":\"/**\\n * @file The shift, with no DOM. Title, story, briefing, operation, debrief, and the menus around them.\\n * The page draws whatever this says and starts the run it names.\\n */\\nimport { caseById, storyCases } from '../op/cases';\\nimport { rankFor } from '../op/ratings';\\nimport { sceneById } from '../op/story';\\nimport { handbookCards } from '../op/table';\\nimport type { Difficulty, Rank } from '../op/types';\\n\\nexport type Screen =\\n  | 'title'\\n  | 'board'\\n  | 'story'\\n  | 'brief'\\n  | 'op'\\n  | 'debrief'\\n  | 'pause'\\n  | 'settings'\\n  | 'handbook'\\n  | 'about'\\n  | 'scrub'\\n  | 'credits'\\n  | 'attract'\\n  | 'dev';\\n\\nexport interface Progress {\\n  cleared: number;\\n  ranks: string[];\\n  scores: number[];\\n  postcards: string[];\\n  free: boolean;\\n  attending: boolean;\\n  difficulty: Difficulty;\\n  simple: boolean;\\n  glyphs: 'playstation' | 'xbox';\\n  blood: 'red' | 'teal' | 'off';\\n  master: number;\\n  music: number;\\n  effects: number;\\n  voice: number;\\n  autoText: boolean;\\n  seats: number;\\n}\\n\\nexport interface Clip {\\n  kind: 'logo' | 'op' | 'story' | 'cards';\\n  id: string;\\n  ms: number;\\n}\\n\\nexport const ATTRACT: readonly Clip[] = [\\n  { kind: 'logo', id: '', ms: 6000 },\\n  { kind: 'op', id: 'case:first-cut', ms: 24000 },\\n  { kind: 'op', id: 'case:crosstalk', ms: 24000 },\\n  { kind: 'story', id: 'after-2', ms: 18000 },\\n  { kind: 'op', id: 'case:struck-off', ms: 24000 },\\n  { kind: 'op', id: 'case:reverie', ms: 24000 },\\n  { kind: 'op', id: 'case:gala-night', ms: 24000 },\\n  { kind: 'op', id: 'case:mercy', ms: 26000 },\\n  { kind: 'cards', id: '', ms: 16000 },\\n];\\n\\nexport interface Item {\\n  id: string;\\n  label: string;\\n}\\n\\nexport interface Campaign {\\n  screen: Screen;\\n  back: Screen;\\n  progress: Progress;\\n  focus: number;\\n  caseId: string;\\n  caseIndex: number;\\n  storyId: string;\\n  leg: 'before' | 'after';\\n  box: number;\\n  board: number;\\n  tab: number;\\n  page: number;\\n  clip: number;\\n  clipMs: number;\\n  idle: number;\\n  lineMs: number;\\n  record: boolean;\\n  won: boolean;\\n  fail: string;\\n  lastRank: string;\\n  lastScore: number;\\n  postcard: string;\\n  devTab: number;\\n  hideHud: boolean;\\n  claimed: boolean[];\\n  boot: number;\\n  keepPhase: boolean;\\n}\\n\\nconst MENUS: readonly Screen[] = ['title', 'board', 'settings', 'handbook', 'about', 'scrub'];\\n\\nexport function blankProgress(): Progress {\\n  return {\\n    cleared: 0,\\n    ranks: [],\\n    scores: [],\\n    postcards: [],\\n    free: false,\\n    attending: false,\\n    difficulty: 'resident',\\n    simple: false,\\n    glyphs: 'playstation',\\n    blood: 'red',\\n    master: 70,\\n    music: 10,\\n    effects: 100,\\n    voice: 100,\\n    autoText: false,\\n    seats: 1,\\n  };\\n}\\n\\nexport function createCampaign(progress: Progress = blankProgress()): Campaign {\\n  return {\\n    screen: 'title',\\n    back: 'title',\\n    progress,\\n    focus: 0,\\n    caseId: 'case:first-cut',\\n    caseIndex: 0,\\n    storyId: 'before-1',\\n    leg: 'before',\\n    box: 0,\\n    board: 0,\\n    tab: 0,\\n    page: 0,\\n    clip: 0,\\n    clipMs: ATTRACT[0].ms,\\n    idle: 0,\\n    lineMs: 0,\\n    record: true,\\n    won: false,\\n    fail: '',\\n    lastRank: '',\\n    lastScore: 0,\\n    postcard: '',\\n    devTab: 0,\\n    hideHud: false,\\n    claimed: [true, false, false, false],\\n    boot: 0,\\n    keepPhase: false,\\n  };\\n}\\n\\nexport function boardIds(progress: Progress): string[] {\\n  const ids = storyCases().map((item) => item.id);\\n  if (progress.free) ids.push('case:gala-shift');\\n  return ids;\\n}\\n\\nexport function items(c: Campaign): Item[] {\\n  if (c.screen === 'title') {\\n    const rows: Item[] = [];\\n    if (c.progress.cleared > 0 && c.progress.cleared < storyCases().length)\\n      rows.push({ id: 'continue', label: 'Continue' });\\n    rows.push(\\n      { id: 'new', label: 'New Shift' },\\n      { id: 'board', label: 'The Board' },\\n      { id: 'scrub', label: 'Scrub In' },\\n    );\\n    rows.push({ id: 'settings', label: 'Settings' }, { id: 'about', label: 'About' });\\n    return rows;\\n  }\\n  if (c.screen === 'board')\\n    return [\\n      { id: 'play', label: 'Open case' },\\n      { id: 'postcards', label: 'Postcards' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.screen === 'brief')\\n    return [\\n      { id: 'start', label: 'Start' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.screen === 'debrief') {\\n    return c.won\\n      ? [{ id: 'next', label: 'Continue' }]\\n      : [\\n          { id: 'retry', label: 'Retry case' },\\n          { id: 'board', label: 'The Board' },\\n        ];\\n  }\\n  if (c.screen === 'pause') {\\n    return [\\n      { id: 'resume', label: 'Resume' },\\n      { id: 'phase', label: 'Retry phase' },\\n      { id: 'retry', label: 'Retry case' },\\n      { id: 'handbook', label: 'Handbook' },\\n      { id: 'settings', label: 'Settings' },\\n      { id: 'controls', label: 'Controls' },\\n      { id: 'dev', label: 'Dev Mode' },\\n      { id: 'board', label: 'Quit to Board' },\\n    ];\\n  }\\n  if (c.screen === 'settings') return settingsItems(c);\\n  if (c.screen === 'handbook') return [{ id: 'back', label: 'Back' }];\\n  if (c.screen === 'about' || c.screen === 'credits')\\n    return [{ id: 'back', label: c.screen === 'credits' ? 'Title' : 'Back' }];\\n  if (c.screen === 'scrub')\\n    return [\\n      { id: 'start', label: 'Start' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.screen === 'dev') return devItems(c);\\n  return [];\\n}\\n\\nfunction settingsItems(c: Campaign): Item[] {\\n  const p = c.progress;\\n  const pages = [\\n    [\\n      { id: 'master', label: `Master ${p.master}` },\\n      { id: 'music', label: `Music ${p.music}` },\\n      { id: 'effects', label: `Effects ${p.effects}` },\\n      { id: 'voice', label: `Voice ${p.voice}` },\\n    ],\\n    [{ id: 'glyphs', label: `Glyphs ${p.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'}` }],\\n    [\\n      { id: 'difficulty', label: `Difficulty ${p.difficulty}` },\\n      { id: 'simple', label: `Simple Gift ${p.simple ? 'on' : 'off'}` },\\n      { id: 'autoText', label: `Auto text ${p.autoText ? 'on' : 'off'}` },\\n    ],\\n    [{ id: 'blood', label: `Blood ${p.blood}` }],\\n  ];\\n  return [...pages[c.page]!, { id: 'back', label: 'Back' }];\\n}\\n\\nfunction devItems(c: Campaign): Item[] {\\n  const tabs = ['Play', 'Balance', 'View', 'Author', 'Data'];\\n  if (c.devTab === 1)\\n    return [\\n      { id: 'reset', label: 'Reset sliders' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.devTab === 2)\\n    return [\\n      { id: 'hud', label: c.hideHud ? 'Show HUD' : 'Hide HUD' },\\n      { id: 'fly', label: 'Free camera' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.devTab === 4)\\n    return [\\n      { id: 'copy', label: 'Copy replay' },\\n      { id: 'back', label: 'Back' },\\n    ];\\n  if (c.devTab === 3) return [{ id: 'back', label: 'Back' }];\\n  return [\\n    { id: 'win', label: 'Win phase' },\\n    { id: 'fail', label: 'Fail phase' },\\n    { id: 'heal', label: 'Restore vitals' },\\n    { id: 'freezeVitals', label: 'Freeze vitals' },\\n    { id: 'freezeClock', label: 'Freeze clock' },\\n    { id: 'gift', label: 'Infinite Gift' },\\n    { id: 'oneHit', label: 'One-hit strains' },\\n    { id: 'spawn', label: 'Spawn a Lull' },\\n    { id: 'unlock', label: 'Unlock the board' },\\n    { id: 'auto', label: 'Autoplay' },\\n    { id: 'step', label: 'Frame step' },\\n    { id: 'slow', label: 'Quarter speed' },\\n    { id: 'fast', label: 'Four times' },\\n    { id: 'tab', label: `Tab ${tabs[c.devTab]}` },\\n    { id: 'back', label: 'Back' },\\n  ];\\n}\\n\\nexport function move(c: Campaign, dir: number): void {\\n  const rows = items(c);\\n  if (!rows.length) return;\\n  c.focus = (c.focus + dir + rows.length) % rows.length;\\n  c.idle = 0;\\n}\\n\",\"total_lines\":629}}","is_error":false},{"type":"tool_result","tool_use_id":"call-8eec77f8-2bf3-4a30-8861-f7314b3f13c9-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"520→        }\\n        return;\\n      default:\\n        return issue(seat, `unknown message type ${JSON.stringify(msg.type)}`);\\n    }\\n  }\\n\\n  function leave(key, reason = 'left') {\\n    const seat = byKey.get(key);\\n    if (!seat || seat.out || phase === 'ended') return;\\n530→    markOut(seat, reason);\\n    status();\\n    settle();\\n  }\\n\\n  const sitOut = (test) => () => {\\n    if (phase !== 'loading') return;\\n    for (const s of copies) if (test(s) && !s.out) markOut(s, 'not-ready');\\n    status();\\n    settle();\\n540→  };\\n\\n  function startRound() {\\n    // A gated round waits on the hub's splash, however long it holds: only\\n    // release() starts the clock on the games that are still loading.\\n    if (!gate) {\\n      later(\\n        t.helloMs,\\n        sitOut((s) => !s.hello),\\n      );\\n550→      later(\\n        t.readyMs,\\n        sitOut((s) => !s.ready),\\n      );\\n    }\\n    status();\\n  }\\n\\n  /** The splash is over: start as soon as every game has loaded, and wait loadGraceMs at most for the slow ones. */\\n  function release() {\\n560→    if (released || phase !== 'loading') return;\\n    released = true;\\n    later(\\n      t.loadGraceMs,\\n      sitOut((s) => !s.ready),\\n    );\\n    status();\\n    settle();\\n  }\\n\\n570→  startRound();\\n\\n  return {\\n    receive,\\n    leave,\\n    release,\\n    /** Call time now, as the cap would: the host pressed \\\"End round\\\". */\\n    timeUp() {\\n      if (phase === 'countdown' || phase === 'playing') timeUp();\\n    },\\n580→    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\\n    progress(id, score) {\\n      const seat = seats[id];\\n      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\\n    },\\n    /** End the round now: the session ended, or the host skipped this game. */\\n    abort(reason = 'skipped') {\\n      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\\n    },\\n    get phase() {\\n590→      return phase;\\n    },\\n    get released() {\\n      return released;\\n    },\\n    get record() {\\n      return record;\\n    },\\n    get mode() {\\n      return mode;\\n600→    },\\n    seats: () => seats.map((s) => ({ ...s, hidden: undefined })),\\n  };\\n}\\n\",\"content_concise\":\"520→        }\\n        return;\\n      default:\\n        return issue(seat, `unknown message type ${JSON.stringify(msg.type)}`);\\n    }\\n  }\\n\\n  function leave(key, reason = 'left') {\\n    const seat = byKey.get(key);\\n    if (!seat || seat.out || phase === 'ended') return;\\n530→    markOut(seat, reason);\\n    status();\\n    settle();\\n  }\\n\\n  const sitOut = (test) => () => {\\n    if (phase !== 'loading') return;\\n    for (const s of copies) if (test(s) && !s.out) markOut(s, 'not-ready');\\n    status();\\n    settle();\\n540→  };\\n\\n  function startRound() {\\n    // A gated round waits on the hub's splash, however long it holds: only\\n    // release() starts the clock on the games that are still loading.\\n    if (!gate) {\\n      later(\\n        t.helloMs,\\n        sitOut((s) => !s.hello),\\n      );\\n550→      later(\\n        t.readyMs,\\n        sitOut((s) => !s.ready),\\n      );\\n    }\\n    status();\\n  }\\n\\n  /** The splash is over: start as soon as every game has loaded, and wait loadGraceMs at most for the slow ones. */\\n  function release() {\\n560→    if (released || phase !== 'loading') return;\\n    released = true;\\n    later(\\n      t.loadGraceMs,\\n      sitOut((s) => !s.ready),\\n    );\\n    status();\\n    settle();\\n  }\\n\\n570→  startRound();\\n\\n  return {\\n    receive,\\n    leave,\\n    release,\\n    /** Call time now, as the cap would: the host pressed \\\"End round\\\". */\\n    timeUp() {\\n      if (phase === 'countdown' || phase === 'playing') timeUp();\\n    },\\n580→    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\\n    progress(id, score) {\\n      const seat = seats[id];\\n      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\\n    },\\n    /** End the round now: the session ended, or the host skipped this game. */\\n    abort(reason = 'skipped') {\\n      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\\n    },\\n    get phase() {\\n590→      return phase;\\n    },\\n    get released() {\\n      return released;\\n    },\\n    get record() {\\n      return record;\\n    },\\n    get mode() {\\n      return mode;\\n600→    },\\n    seats: () => seats.map((s) => ({ ...s, hidden: undefined })),\\n  };\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/tools/hub/round.js\",\"offset\":520,\"limit\":90,\"raw_output\":\"        }\\n        return;\\n      default:\\n        return issue(seat, `unknown message type ${JSON.stringify(msg.type)}`);\\n    }\\n  }\\n\\n  function leave(key, reason = 'left') {\\n    const seat = byKey.get(key);\\n    if (!seat || seat.out || phase === 'ended') return;\\n    markOut(seat, reason);\\n    status();\\n    settle();\\n  }\\n\\n  const sitOut = (test) => () => {\\n    if (phase !== 'loading') return;\\n    for (const s of copies) if (test(s) && !s.out) markOut(s, 'not-ready');\\n    status();\\n    settle();\\n  };\\n\\n  function startRound() {\\n    // A gated round waits on the hub's splash, however long it holds: only\\n    // release() starts the clock on the games that are still loading.\\n    if (!gate) {\\n      later(\\n        t.helloMs,\\n        sitOut((s) => !s.hello),\\n      );\\n      later(\\n        t.readyMs,\\n        sitOut((s) => !s.ready),\\n      );\\n    }\\n    status();\\n  }\\n\\n  /** The splash is over: start as soon as every game has loaded, and wait loadGraceMs at most for the slow ones. */\\n  function release() {\\n    if (released || phase !== 'loading') return;\\n    released = true;\\n    later(\\n      t.loadGraceMs,\\n      sitOut((s) => !s.ready),\\n    );\\n    status();\\n    settle();\\n  }\\n\\n  startRound();\\n\\n  return {\\n    receive,\\n    leave,\\n    release,\\n    /** Call time now, as the cap would: the host pressed \\\"End round\\\". */\\n    timeUp() {\\n      if (phase === 'countdown' || phase === 'playing') timeUp();\\n    },\\n    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\\n    progress(id, score) {\\n      const seat = seats[id];\\n      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\\n    },\\n    /** End the round now: the session ended, or the host skipped this game. */\\n    abort(reason = 'skipped') {\\n      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\\n    },\\n    get phase() {\\n      return phase;\\n    },\\n    get released() {\\n      return released;\\n    },\\n    get record() {\\n      return record;\\n    },\\n    get mode() {\\n      return mode;\\n    },\\n    seats: () => seats.map((s) => ({ ...s, hidden: undefined })),\\n  };\\n}\\n\",\"total_lines\":603}}","is_error":false},{"type":"tool_result","tool_use_id":"call-8eec77f8-2bf3-4a30-8861-f7314b3f13c9-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The eight story operations, plus the session case. Each case adds one rule from the plan: tools, sites,\\n * a strain, a gift. Numbers are metres and seconds. Postcards are the patient's own words, one line per rank.\\n */\\nimport type { CaseDef, PhaseDef, Postcards, Spawn } from './types';\\n\\n/** Four postcard lines. */\\nfunction cards(s: string, a: string, b: string, c: string): Postcards {\\n  return { S: s, A: a, B: b, C: c };\\n10→}\\n\\n/** A phase row. */\\nfunction phase(id: string, hint: string, until: PhaseDef['until'], spawn: Spawn[], onEnter = '', teach = ''): PhaseDef {\\n  return { id, hint, until, spawn, onEnter, teach };\\n}\\n\\n/** A pool small enough that triage still has a clock. */\\nfunction pool(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'pool', x, z, site, patient, volume: 1.15, bleed: 0.22 };\\n20→}\\n\\n/** A laceration two stitches long. */\\nfunction wound(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'wound', x, z, x2: x + 1.15, z2: z, site, patient, need: 2 };\\n}\\n\\n/** A shard of glass or graft. */\\nfunction shard(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'shard', x, z, site, patient };\\n30→}\\n\\n/** Gel on raw skin. */\\nfunction gel(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'abrasion', x, z, site, patient, coverNeed: 8 };\\n}\\n\\n/** A guide the scalpel can follow. `bow` bends it off the straight line. */\\nfunction curve(x0: number, z0: number, x1: number, z1: number, bow: number, unlock = '', tag = ''): Spawn {\\n  const len = Math.hypot(x1 - x0, z1 - z0);\\n40→  const steps = Math.max(1, Math.round(len / 0.32));\\n  const path: number[] = [];\\n  for (let i = 0; i <= steps; i++) {\\n    const u = i / steps;\\n    path.push(x0 + (x1 - x0) * u, z0 + (z1 - z0) * u + Math.sin(u * Math.PI) * bow);\\n  }\\n  return { kind: 'guide', x: x0, z: z0, path, unlock, tag, spawnBleeders: tag === 'long' ? 2 : 0 };\\n}\\n\\n/** Six motes around the heart. */\\n50→function motes(): Spawn[] {\\n  const out: Spawn[] = [];\\n  for (let i = 0; i < 6; i++) {\\n    const angle = (i / 6) * Math.PI * 2;\\n    out.push({ kind: 'mote', x: Math.cos(angle) * 1.15, z: Math.sin(angle) * 0.7 });\\n  }\\n  return out;\\n}\\n\\n/** The eight story cases, in order, then the session case. */\\n60→export const CASES: readonly CaseDef[] = [\\n  {\\n    id: 'case:first-cut',\\n    title: 'First Cut',\\n    surgeon: 'Wren',\\n    seconds: 240,\\n    gift: 'none',\\n    charges: 0,\\n    colleague: false,\\n    swap: false,\\n70→    roll: false,\",\"content_concise\":\"1→/**\\n * @file The eight story operations, plus the session case. Each case adds one rule from the plan: tools, sites,\\n * a strain, a gift. Numbers are metres and seconds. Postcards are the patient's own words, one line per rank.\\n */\\nimport type { CaseDef, PhaseDef, Postcards, Spawn } from './types';\\n\\n/** Four postcard lines. */\\nfunction cards(s: string, a: string, b: string, c: string): Postcards {\\n  return { S: s, A: a, B: b, C: c };\\n10→}\\n\\n/** A phase row. */\\nfunction phase(id: string, hint: string, until: PhaseDef['until'], spawn: Spawn[], onEnter = '', teach = ''): PhaseDef {\\n  return { id, hint, until, spawn, onEnter, teach };\\n}\\n\\n/** A pool small enough that triage still has a clock. */\\nfunction pool(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'pool', x, z, site, patient, volume: 1.15, bleed: 0.22 };\\n20→}\\n\\n/** A laceration two stitches long. */\\nfunction wound(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'wound', x, z, x2: x + 1.15, z2: z, site, patient, need: 2 };\\n}\\n\\n/** A shard of glass or graft. */\\nfunction shard(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'shard', x, z, site, patient };\\n30→}\\n\\n/** Gel on raw skin. */\\nfunction gel(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'abrasion', x, z, site, patient, coverNeed: 8 };\\n}\\n\\n/** A guide the scalpel can follow. `bow` bends it off the straight line. */\\nfunction curve(x0: number, z0: number, x1: number, z1: number, bow: number, unlock = '', tag = ''): Spawn {\\n  const len = Math.hypot(x1 - x0, z1 - z0);\\n40→  const steps = Math.max(1, Math.round(len / 0.32));\\n  const path: number[] = [];\\n  for (let i = 0; i <= steps; i++) {\\n    const u = i / steps;\\n    path.push(x0 + (x1 - x0) * u, z0 + (z1 - z0) * u + Math.sin(u * Math.PI) * bow);\\n  }\\n  return { kind: 'guide', x: x0, z: z0, path, unlock, tag, spawnBleeders: tag === 'long' ? 2 : 0 };\\n}\\n\\n/** Six motes around the heart. */\\n50→function motes(): Spawn[] {\\n  const out: Spawn[] = [];\\n  for (let i = 0; i < 6; i++) {\\n    const angle = (i / 6) * Math.PI * 2;\\n    out.push({ kind: 'mote', x: Math.cos(angle) * 1.15, z: Math.sin(angle) * 0.7 });\\n  }\\n  return out;\\n}\\n\\n/** The eight story cases, in order, then the session case. */\\n60→export const CASES: readonly CaseDef[] = [\\n  {\\n    id: 'case:first-cut',\\n    title: 'First Cut',\\n    surgeon: 'Wren',\\n    seconds: 240,\\n    gift: 'none',\\n    charges: 0,\\n    colleague: false,\\n    swap: false,\\n70→    roll: false,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/cases.ts\",\"offset\":1,\"limit\":70,\"raw_output\":\"/**\\n * @file The eight story operations, plus the session case. Each case adds one rule from the plan: tools, sites,\\n * a strain, a gift. Numbers are metres and s