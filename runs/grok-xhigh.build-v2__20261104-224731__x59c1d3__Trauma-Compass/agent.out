61,61,61,32,39,115,116,105,108,108,112,111,105,110,116,39,41,32,123,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":1,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/body.ts\",\"matches\":[{\"line_number\":17,\"content\":\"export function applyHands(op: Op, hands: readonly Hand[] | null): void {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-95cc7cad-210c-491f-b39c-cfa13f64b179-47","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The look `look:torch-lit`: the torch-lit hall, the prototype's stress world (PLAN.md WP 7.8): dark but for the\\n * torches on the braziers, each flickering on its own, the nearest casting shadows, and fog from 12 m past the hero. It\\n * is the sky `sky:hall` over the scene's own style with no filter: the light pool lights all the hall's 30 torch\\n * spots on a renderer with tiled lighting (engine/gfx/enhanced/lighting.ts), else the 12 nearest the hero\\n * (engine/gfx/lights.ts), the light following him round the hall; the other box looks are this one with a style or a\\n * filter preset (labs/box/README.md lists them).\\n *\\n * Invariants: data only, the kind's fields (`node x describe look`): the sky `sky:hall` (engine/gfx/sky.ts), which a\\n10→ * page that starts the engine shows (engine/app/look.ts), the scene's own style, and every filter it leaves out off;\\n * levels 0 (off) or 8 and more, so dull colours keep their hue. A page draws it when its setting `post.look` names it;\\n * switching to it from a look with the scene's own lights warms up first (the lights change the shader key), then\\n * builds nothing.\\n *\\n * @example\\n * look.id; // 'look:torch-lit'\\n * look.sky; // 'sky:hall'\\n * @see labs/box/looks/torch-lit.test.ts\\n * @see tests/e2e/box-look.spec.ts\\n20→ */\\nimport { defineLook } from '../../../engine';\\n\\n/** The look `look:torch-lit`: the torch-lit hall: the sky `sky:hall` over the scene's own style, no filter. */\\nexport const look = defineLook('look:torch-lit', {\\n  description:\\n    'The torch-lit hall: dark but for the flickering torches near the hero, the nearest casting shadows; fog past him.',\\n  sky: 'sky:hall',\\n});\\n\",\"content_concise\":\"1→/**\\n * @file The look `look:torch-lit`: the torch-lit hall, the prototype's stress world (PLAN.md WP 7.8): dark but for the\\n * torches on the braziers, each flickering on its own, the nearest casting shadows, and fog from 12 m past the hero. It\\n * is the sky `sky:hall` over the scene's own style with no filter: the light pool lights all the hall's 30 torch\\n * spots on a renderer with tiled lighting (engine/gfx/enhanced/lighting.ts), else the 12 nearest the hero\\n * (engine/gfx/lights.ts), the light following him round the hall; the other box looks are this one with a style or a\\n * filter preset (labs/box/README.md lists them).\\n *\\n * Invariants: data only, the kind's fields (`node x describe look`): the sky `sky:hall` (engine/gfx/sky.ts), which a\\n10→ * page that starts the engine shows (engine/app/look.ts), the scene's own style, and every filter it leaves out off;\\n * levels 0 (off) or 8 and more, so dull colours keep their hue. A page draws it when its setting `post.look` names it;\\n * switching to it from a look with the scene's own lights warms up first (the lights change the shader key), then\\n * builds nothing.\\n *\\n * @example\\n * look.id; // 'look:torch-lit'\\n * look.sky; // 'sky:hall'\\n * @see labs/box/looks/torch-lit.test.ts\\n * @see tests/e2e/box-look.spec.ts\\n20→ */\\nimport { defineLook } from '../../../engine';\\n\\n/** The look `look:torch-lit`: the torch-lit hall: the sky `sky:hall` over the scene's own style, no filter. */\\nexport const look = defineLook('look:torch-lit', {\\n  description:\\n    'The torch-lit hall: dark but for the flickering torches near the hero, the nearest casting shadows; fog past him.',\\n  sky: 'sky:hall',\\n});\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/box/looks/torch-lit.ts\",\"offset\":null,\"limit\":80,\"raw_output\":\"/**\\n * @file The look `look:torch-lit`: the torch-lit hall, the prototype's stress world (PLAN.md WP 7.8): dark but for the\\n * torches on the braziers, each flickering on its own, the nearest casting shadows, and fog from 12 m past the hero. It\\n * is the sky `sky:hall` over the scene's own style with no filter: the light pool lights all the hall's 30 torch\\n * spots on a renderer with tiled lighting (engine/gfx/enhanced/lighting.ts), else the 12 nearest the hero\\n * (engine/gfx/lights.ts), the light following him round the hall; the other box looks are this one with a style or a\\n * filter preset (labs/box/README.md lists them).\\n *\\n * Invariants: data only, the kind's fields (`node x describe look`): the sky `sky:hall` (engine/gfx/sky.ts), which a\\n * page that starts the engine shows (engine/app/look.ts), the scene's own style, and every filter it leaves out off;\\n * levels 0 (off) or 8 and more, so dull colours keep their hue. A page draws it when its setting `post.look` names it;\\n * switching to it from a look with the scene's own lights warms up first (the lights change the shader key), then\\n * builds nothing.\\n *\\n * @example\\n * look.id; // 'look:torch-lit'\\n * look.sky; // 'sky:hall'\\n * @see labs/box/looks/torch-lit.test.ts\\n * @see tests/e2e/box-look.spec.ts\\n */\\nimport { defineLook } from '../../../engine';\\n\\n/** The look `look:torch-lit`: the torch-lit hall: the sky `sky:hall` over the scene's own style, no filter. */\\nexport const look = defineLook('look:torch-lit', {\\n  description:\\n    'The torch-lit hall: dark but for the flickering torches near the hero, the nearest casting shadows; fog past him.',\\n  sky: 'sky:hall',\\n});\\n\",\"total_lines\":28}}","is_error":false},{"type":"tool_result","tool_use_id":"call-95cc7cad-210c-491f-b39c-cfa13f64b179-48","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The `sfx` kind (PLAN.md WP 9.2, I-23; doctrines: Assets, Agent-operable): a sound effect as data, rendered\\n * into samples by the DSP core (engine/audio/dsp/render.ts). The engine's 33 effects (effects.ts), 6 drums (drums.ts)\\n * and its foley (foley.ts) are its entries; a game adds its own with `defineSfx`, and `x new sfx` scaffolds one.\\n *\\n * An entry's fields:\\n * - `voices`: one voice or a list played together, in the chip synth's words (engine/audio/dsp/voice.ts);\\n * - `layers`: other effects mixed in, each `{ sfx, at, vol, pitch }` (a start in seconds, a gain, a pitch ratio), so\\n *   a big hit is a punch over a boom without copying either; layers nest;\\n10→ * - `variants` and `vary`: how many versions the runtime picks between, and how far their pitch spreads either way\\n *   (a fraction), so a sound heard a hundred times does not repeat exactly;\\n * - `bus`: the mixer bus it plays on (`effects`, `ui` or `ambience`; engine/audio/runtime, WP 9.3);\\n * - `loop`: for an effect played looped (a bed of ambience, the wind), the pass it repeats, s: what sounds past it\\n *   folds over its start (engine/audio/runtime/buffers.ts `foldLoop`, WP 13.22), so a voice fading out past the pass\\n *   crossfades into one fading in at its start and the loop has no seam; 0 loops the whole render as it is.\\n *\\n * Invariants:\\n * - Rendering flattens an entry into one voice list: its voices, then each layer's voices (recursively), each layer\\n *   shifted by its `at`, scaled by its `vol` and transposed by its `pitch`. A pitch ratio multiplies every frequency of\\n20→ *   a voice (its pitch, its sweep's end and its filter's), never its timing. A layer's noise is drawn from its place\\n *   in the flattened list, so it differs from the layer rendered alone.\\n * - Variant 0 is the sound as written. Variant k ≥ 1 renders from the seed `derive(seed, 'variant', k)` at the pitch\\n *   ratio `1 + vary · u`, `u` drawn in the k-th of `variants − 1` equal slices of [−1, 1), so the variants spread\\n *   over the whole range instead of bunching. Each is a pure function of the entry, seed, variant and rate: the same\\n *   bits in Node and Chromium.\\n * - The kind's check (`sfxProblems`) refuses voices `render` would refuse, and an entry with neither voices nor\\n *   layers. Layer ids are looked up when the sound renders (a layer may be defined later): an unknown one throws\\n *   `CORE_NO_ENTRY` naming the closest ids, a cycle `AUDIO_LAYER_CYCLE`.\\n *\\n30→ * @example\\n * import { createRegistry } from '../../core/registry';\\n * const registry = createRegistry();\\n * defineSfx('sfx:bigHit', { layers: [{ sfx: 'sfx:punch' }, { sfx: 'sfx:boom', at: 0.03, vol: 0.5 }] }, registry);\\n * sfxVoices('sfx:bigHit', registry).length; // 4: the punch's two voices, then the boom's\\n * renderSfx('sfx:jump', { variant: 2, registry }).length; // 6174: 0.14 s at 44,100 Hz\\n * @see engine/audio/data/sfx.test.ts\\n */\\nimport { codeError, defineCodes } from '../../core/log';\\nimport { registry as sharedRegistry, type Registry } from '../../core/registry';\\n40→import { derive, Rng } from '../../core/rng';\\nimport type { Schema } from '../../core/schema';\\nimport { DEFAULT_RATE, render } from '../dsp/render';\\nimport { normalizeSound, noteFreq, type SoundDef, type Voice } from '../dsp/voice';\\nimport { DRUMS } from './drums';\\nimport { EFFECTS } from './effects';\\nimport { FOLEY } from './foley';\\n\\n/** The codes the effects raise beyond the DSP's own, with their fixes. */\\nexport const SFX_CODES = defineCodes('audio', {\\n50→  AUDIO_LAYER_CYCLE: {\\n    template: '{id} contains itself through its layers: {path}',\\n    fix: 'remove one layer of the cycle: a layer mixes another effect in, which cannot contain the first',\\n    doc: 'Raised by `sfxVoices` and `renderSfx` (engine/audio/data/sfx.ts) when following layers leads back to an effect already on the path.',\\n  },\\n  AUDIO_BAD_VARIANT: {\\n    template: '{id} has variants 0 to {last}; {variant} is not one of them',\\n    fix: 'ask for a whole number from 0 to {last}, or give the effect more variants',\\n    doc: 'Raised by `renderSfx` (engine/audio/data/sfx.ts).',\\n  },\\n60→});\\n\\n/** The mixer buses an effect may play on. */\\nexport const SFX_BUSES = ['effects', 'ui', 'ambience'] as const;\\n\\n/** One of the buses. */\\nexport type SfxBus = (typeof SFX_BUSES)[number];\\n\\n/** Another effect mixed into this one. */\\nexport interface SfxLayer {\\n70→  /** The id of the effect mixed in. */\\n  sfx: string;\\n  /** Seconds after this sound starts; 0 by default. */\\n  at?: number;\\n  /** Its gain; 1 (as written) by default. */\\n  vol?: number;\\n  /** Its pitch ratio (2 is an octave up); 1 by default. */\\n  pitch?: number;\\n}\\n\\n80→/** What `defineSfx` takes: voices, layers or both, and every other field optional. */\",\"content_concise\":\"1→/**\\n * @file The `sfx` kind (PLAN.md WP 9.2, I-23; doctrines: Assets, Agent-operable): a sound effect as data, rendered\\n * into samples by the DSP core (engine/audio/dsp/render.ts). The engine's 33 effects (effects.ts), 6 drums (drums.ts)\\n * and its foley (foley.ts) are its entries; a game adds its own with `defineSfx`, and `x new sfx` scaffolds one.\\n *\\n * An entry's fields:\\n * - `voices`: one voice or a list played together, in the chip synth's words (engine/audio/dsp/voice.ts);\\n * - `layers`: other effects mixed in, each `{ sfx, at, vol, pitch }` (a start in seconds, a gain, a pitch ratio), so\\n *   a big hit is a punch over a boom without copying either; layers nest;\\n10→ * - `variants` and `vary`: how many versions the runtime picks between, and how far their pitch spreads either way\\n *   (a fraction), so a sound heard a hundred times does not repeat exactly;\\n * - `bus`: the mixer bus it plays on (`effects`, `ui` or `ambience`; engine/audio/runtime, WP 9.3);\\n * - `loop`: for an effect played looped (a bed of ambience, the wind), the pass it repeats, s: what sounds past it\\n *   folds over its start (engine/audio/runtime/buffers.ts `foldLoop`, WP 13.22), so a voice fading out past the pass\\n *   crossfades into one fading in at its start and the loop has no seam; 0 loops the whole render as it is.\\n *\\n * Invariants:\\n * - Rendering flattens an entry into one voice list: its voices, then each layer's voices (recursively), each layer\\n *   shifted by its `at`, scaled by its `vol` and transposed by its `pitch`. A pitch ratio multiplies every frequency of\\n20→ *   a voice (its pitch, its sweep's end and its filter's), never its timing. A layer's noise is drawn from its place\\n *   in the flattened list, so it differs from the layer rendered alone.\\n * - Variant 0 is the sound as written. Variant k ≥ 1 renders from the seed `derive(seed, 'variant', k)` at the pitch\\n *   ratio `1 + vary · u`, `u` drawn in the k-th of `variants − 1` equal slices of [−1, 1), so the variants spread\\n *   over the whole range instead of bunching. Each is a pure function of the entry, seed, variant and rate: the same\\n *   bits in Node and Chromium.\\n * - The kind's check (`sfxProblems`) refuses voices `render` would refuse, and an entry with neither voices nor\\n *   layers. Layer ids are looked up when the sound renders (a layer may be defined later): an unknown one throws\\n *   `CORE_NO_ENTRY` naming the closest ids, a cycle `AUDIO_LAYER_CYCLE`.\\n *\\n30→ * @example\\n * import { createRegistry } from '../../core/registry';\\n * const registry = createRegistry();\\n * defineSfx('sfx:bigHit', { layers: [{ sfx: 'sfx:punch' }, { sfx: 'sfx:boom', at: 0.03, vol: 0.5 }] }, registry);\\n * sfxVoices('sfx:bigHit', registry).length; // 4: the punch's two voices, then the boom's\\n * renderSfx('sfx:jump', { variant: 2, registry }).length; // 6174: 0.14 s at 44,100 Hz\\n * @see engine/audio/data/sfx.test.ts\\n */\\nimport { codeError, defineCodes } from '../../core/log';\\nimport { registry as sharedRegistry, type Registry } from '../../core/registry';\\n40→import { derive, Rng } from '../../core/rng';\\nimport type { Schema } from '../../core/schema';\\nimport { DEFAULT_RATE, render } from '../dsp/render';\\nimport { normalizeSound, noteFreq, type SoundDef, type Voice } from '../dsp/voice';\\nimport { DRUMS } from './drums';\\nimport { EFFECTS } from './effects';\\nimport { FOLEY } from './foley';\\n\\n/** The codes the effects raise beyond the DSP's own, with their fixes. */\\nexport const SFX_CODES = defineCodes('audio', {\\n50→  AUDIO_LAYER_CYCLE: {\\n    template: '{id} contains itself through its layers: {path}',\\n    fix: 'remove one layer of the cycle: a layer mixes another effect in, which cannot contain the first',\\n    doc: 'Raised by `sfxVoices` and `renderSfx` (engine/audio/data/sfx.ts) when following layers leads back to an effect already on the path.',\\n  },\\n  AUDIO_BAD_VARIANT: {\\n    template: '{id} has variants 0 to {last}; {variant} is not one of them',\\n    fix: 'ask for a whole number from 0 to {last}, or give the effect more variants',\\n    doc: 'Raised by `renderSfx` (engine/audio/data/sfx.ts).',\\n  },\\n60→});\\n\\n/** The mixer buses an effect may play on. */\\nexport const SFX_BUSES = ['effects', 'ui', 'ambience'] as const;\\n\\n/** One of the buses. */\\nexport type SfxBus = (typeof SFX_BUSES)[number];\\n\\n/** Another effect mixed into this one. */\\nexport interface SfxLayer {\\n70→  /** The id of the effect mixed in. */\\n  sfx: string;\\n  /** Seconds after this sound starts; 0 by default. */\\n  at?: number;\\n  /** Its gain; 1 (as written) by default. */\\n  vol?: number;\\n  /** Its pitch ratio (2 is an octave up); 1 by default. */\\n  pitch?: number;\\n}\\n\\n80→/** What `defineSfx` takes: voices, layers or both, and every other field optional. */\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/audio/data/sfx.ts\",\"offset\":null,\"limit\":80,\"raw_output\":\"/**\\n * @file The `sfx` kind (PLAN.md WP 9.2, I-23; doctrines: Assets, Agent-operable): a sound effect as data, rendered\\n * into samples by the DSP core (engine/audio/dsp/render.ts). The engine's 33 effects (effects.ts), 6 drums (drums.ts)\\n * and its foley (foley.ts) are its entries; a game adds its own with `defineSfx`, and `x new sfx` scaffolds one.\\n *\\n * An entry's fields:\\n * - `voices`: one voice or a list played together, in the chip synth's words (engine/audio/dsp/voice.ts);\\n * - `layers`: other effects mixed in, each `{ sfx, at, vol, pitch }` (a start in seconds, a gain, a pitch ratio), so\\n *   a big hit is a punch over a boom without copying either; layers nest;\\n * - `variants` and `vary`: how many versions the runtime picks between, and how far their pitch spreads either way\\n *   (a fraction), so a sound heard a hundred times does not repeat exactly;\\n * - `bus`: the mixer bus it plays on (`effects`, `ui` or `ambience`; engine/audio/runtime, WP 9.3);\\n * - `loop`: for an effect played looped (a bed of ambience, the wind), the pass it repeats, s: what sounds past it\\n *   folds over its start (engine/audio/runtime/buffers.ts `foldLoop`, WP 13.22), so a voice fading out past the pass\\n *   crossfades into one fading in at its start and the loop has no seam; 0 loops the whole render as it is.\\n *\\n * Invariants:\\n * - Rendering flattens an entry into one voice list: its voices, then each layer's voices (recursively), each layer\\n *   shifted by its `at`, scaled by its `vol` and transposed by its `pitch`. A pitch ratio multiplies every frequency of\\n *   a voice (its pitch, its sweep's end and its filter's), never its timing. A layer's noise is drawn from its place\\n *   in the flattened list, so it differs from the layer rendered alone.\\n * - Variant 0 is the sound as written. Variant k ≥ 1 renders from the seed `derive(seed, 'variant', k)` at the pitch\\n *   ratio `1 + vary · u`, `u` drawn in the k-th of `variants − 1` equal slices of [−1, 1), so the variants spread\\n *   over the whole range instead of bunching. Each is a pure function of the entry, seed, variant and rate: the same\\n *   bits in Node and Chromium.\\n * - The kind's check (`sfxProblems`) refuses voices `render` would refuse, and an entry with neither voices nor\\n *   layers. Layer ids are looked up when the sound renders (a layer may be defined later): an unknown one throws\\n *   `CORE_NO_ENTRY` naming the closest ids, a cycle `AUDIO_LAYER_CYCLE`.\\n *\\n * @example\\n * import { createRegistry } from '../../core/registry';\\n * const registry = createRegistry();\\n * defineSfx('sfx:bigHit', { layers: [{ sfx: 'sfx:punch' }, { sfx: 'sfx:boom', at: 0.03, vol: 0.5 }] }, registry);\\n * sfxVoices('sfx:bigHit', registry).length; // 4: the punch's two voices, then the boom's\\n * renderSfx('sfx:jump', { variant: 2, registry }).length; // 6174: 0.14 s at 44,100 Hz\\n * @see engine/audio/data/sfx.test.ts\\n */\\nimport { codeError, defineCodes } from '../../core/log';\\nimport { registry as sharedRegistry, type Registry } from '../../core/registry';\\nimport { derive, Rng } from '../../core/rng';\\nimport type { Schema } from '../../core/schema';\\nimport { DEFAULT_RATE, render } from '../dsp/render';\\nimport { normalizeSound, noteFreq, type SoundDef, type Voice } from '../dsp/voice';\\nimport { DRUMS } from './drums';\\nimport { EFFECTS } from './effects';\\nimport { FOLEY } from './foley';\\n\\n/** The codes the effects raise beyond the DSP's own, with their fixes. */\\nexport const SFX_CODES = defineCodes('audio', {\\n  AUDIO_LAYER_CYCLE: {\\n    template: '{id} contains itself through its layers: {path}',\\n    fix: 'remove one layer of the cycle: a layer mixes another effect in, which cannot contain the first',\\n    doc: 'Raised by `sfxVoices` and `renderSfx` (engine/audio/data/sfx.ts) when following layers leads back to an effect already on the path.',\\n  },\\n  AUDIO_BAD_VARIANT: {\\n    template: '{id} has variants 0 to {last}; {variant} is not one of them',\\n    fix: 'ask for a whole number from 0 to {last}, or give the effect more variants',\\n    doc: 'Raised by `renderSfx` (engine/audio/data/sfx.ts).',\\n  },\\n});\\n\\n/** The mixer buses an effect may play on. */\\nexport const SFX_BUSES = ['effects', 'ui', 'ambience'] as const;\\n\\n/** One of the buses. */\\nexport type SfxBus = (typeof SFX_BUSES)[number];\\n\\n/** Another effect mixed into this one. */\\nexport interface SfxLayer {\\n  /** The id of the effect mixed in. */\\n  sfx: string;\\n  /** Seconds after this sound starts; 0 by default. */\\n  at?: number;\\n  /** Its gain; 1 (as written) by default. */\\n  vol?: number;\\n  /** Its pitch ratio (2 is an octave up); 1 by default. */\\n  pitch?: number;\\n}\\n\\n/** What `defineSfx` takes: voices, layers or both, and every other field optional. */\\n\",\"total_lines\":286}}","is_error":false},{"type":"tool_result","tool_use_id":"call-95cc7cad-210c-491f-b39c-cfa13f64b179-49","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file Action maps and presets (PLAN.md WP 3.3, I-24; doctrine: Common ground): the registry kind `actionMap`, a set\\n * of named actions with the physical codes bound to each (engine/input/codes.ts), as Unity's action maps and Godot's\\n * InputMap hold them; the presets; and the system layer, which no player rebinds.\\n *\\n * An action is a button the sim reads: held actions arrive as the intents' `b`, pressed ones as `p`\\n * (engine/input/intents.ts). The four actions a map names in `move` (forward, back, left, right) are not buttons:\\n * their strengths make the move axes `[right − left, forward − back]`, so keys walk at full speed and a half-pushed\\n * stick at half, and `fromCamera` turns the axes into a world direction. `values` writes an action's analog strength\\n10→ * (a trigger) as a custom intent. `look: true` (first person, the shooter) adds the camera's view direction as `look`,\\n * `aimWith` names the rule that gives the intents' `aim` its point (engine/input/aim.ts: the screen centre's ray, the\\n * pointer's onto the floor, or none; the action `aim`, where a map has one, raises the sights), and `lock: true` takes\\n * the pointer lock on a click so the mouse turns the view (with the cursor free, it points and aims). The actions a\\n * map names in `view` (a camera switch, a view's turn) are the page's: bound and rebound like the others, never\\n * buttons in the intents (`createEngine({ onView })`). A game with several camera modes gives each its own map\\n * (`createEngine({ actionMap })`, WP 13.9).\\n *\\n * The system layer (`SYSTEM_ACTIONS`): pause, and the menu's accept, cancel and directions. It is always active\\n * beside the map, never rebound, and never part of the intents: the app and the UI read it (`input.pressed('pause')`),\\n20→ * so remapping movement never breaks a menu (the lesson of `my-3d2dge:docs/CONTROLS-AUDIT.md`). `RESERVED_CODES` (the\\n * pause buttons, and keys the browser or system keeps) and a map's own `reserved` codes are refused by rebinding.\\n *\\n * Invariants (`CORE_BAD_SPEC` when broken): every code is valid (`isCode`), action names are lower-case words\\n * (`jump`, `skill2`) and none is a system action, `move` names four actions of the map and `view` others, `values` keys\\n * are namespaced custom intents naming actions of the map, and no action binds a reserved code. The presets are registered on the\\n * shared registry when this module loads.\\n *\\n * Carried from `my-3d2dge:engine/my-3d2dge.js:670-693` (`Input.DEFAULT`, `PLATFORMER`, `SHMUP`, `MENU_KEYS`) with 3D\\n * movement, and shardfall's layer that is never rebound (`shardfall:crates/pav_app/src/input.rs:131-161`).\\n30→ *\\n * @example\\n * const map = getActionMap('actionMap:thirdPerson');\\n * map.actions.jump; // ['Space', 'PadSouth']\\n * map.move; // ['forward', 'back', 'left', 'right']\\n * SYSTEM_ACTIONS.pause; // ['Escape', 'PadStart']\\n * listActionMaps().map((entry) => entry.id); // ['actionMap:firstPerson', 'actionMap:platformer', …]\\n * @see engine/input/bindings.test.ts\\n */\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\\n40→import { show, type Schema } from '../core/schema';\\nimport { AIM_RULES, type AimRule } from './aim';\\nimport { isCode } from './codes';\\n\\n/** The system layer: action → codes. Always active, never rebound, never in the intents. */\\nexport const SYSTEM_ACTIONS: Readonly<Record<string, readonly string[]>> = Object.freeze({\\n  pause: ['Escape', 'PadStart'],\\n  uiAccept: ['Enter', 'NumpadEnter', 'Space', 'PadSouth'],\\n  uiCancel: ['Escape', 'Backspace', 'PadEast'],\\n  uiUp: ['ArrowUp', 'PadUp', 'PadLeftStickUp'],\\n50→  uiDown: ['ArrowDown', 'PadDown', 'PadLeftStickDown'],\\n  uiLeft: ['ArrowLeft', 'PadLeft', 'PadLeftStickLeft'],\\n  uiRight: ['ArrowRight', 'PadRight', 'PadLeftStickRight'],\\n});\\n\\n/** Codes no action map binds: the pause buttons, and keys the browser or the system keeps. */\\nexport const RESERVED_CODES: readonly string[] = Object.freeze([\\n  'Escape',\\n  'PadStart',\\n  'PadHome',\\n60→  'F5',\\n  'F11',\\n  'F12',\\n  'MetaLeft',\\n  'MetaRight',\\n]);\\n\\n/** The fields of an `actionMap` entry. */\\nconst ACTION_MAP_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What the map is for, in plain words.' },\\n70→  actions: {\\n    type: 'object',\\n    required: true,\\n    description:\\n      'Action name → the codes bound to it (KeyboardEvent.code, MouseLeft…, PadSouth…, PadLeftStickUp…): held actions are the intents b, pressed ones p.',\\n  },\\n  move: {\\n    type: 'array',\\n    items: { type: 'string' },\\n    default: ['forward', 'back', 'left', 'right'],\\n80→    description: 'The four actions that walk, as forward, back, left, right: their strengths make the move axes.',\",\"content_concise\":\"1→/**\\n * @file Action maps and presets (PLAN.md WP 3.3, I-24; doctrine: Common ground): the registry kind `actionMap`, a set\\n * of named actions with the physical codes bound to each (engine/input/codes.ts), as Unity's action maps and Godot's\\n * InputMap hold them; the presets; and the system layer, which no player rebinds.\\n *\\n * An action is a button the sim reads: held actions arrive as the intents' `b`, pressed ones as `p`\\n * (engine/input/intents.ts). The four actions a map names in `move` (forward, back, left, right) are not buttons:\\n * their strengths make the move axes `[right − left, forward − back]`, so keys walk at full speed and a half-pushed\\n * stick at half, and `fromCamera` turns the axes into a world direction. `values` writes an action's analog strength\\n10→ * (a trigger) as a custom intent. `look: true` (first person, the shooter) adds the camera's view direction as `look`,\\n * `aimWith` names the rule that gives the intents' `aim` its point (engine/input/aim.ts: the screen centre's ray, the\\n * pointer's onto the floor, or none; the action `aim`, where a map has one, raises the sights), and `lock: true` takes\\n * the pointer lock on a click so the mouse turns the view (with the cursor free, it points and aims). The actions a\\n * map names in `view` (a camera switch, a view's turn) are the page's: bound and rebound like the others, never\\n * buttons in the intents (`createEngine({ onView })`). A game with several camera modes gives each its own map\\n * (`createEngine({ actionMap })`, WP 13.9).\\n *\\n * The system layer (`SYSTEM_ACTIONS`): pause, and the menu's accept, cancel and directions. It is always active\\n * beside the map, never rebound, and never part of the intents: the app and the UI read it (`input.pressed('pause')`),\\n20→ * so remapping movement never breaks a menu (the lesson of `my-3d2dge:docs/CONTROLS-AUDIT.md`). `RESERVED_CODES` (the\\n * pause buttons, and keys the browser or system keeps) and a map's own `reserved` codes are refused by rebinding.\\n *\\n * Invariants (`CORE_BAD_SPEC` when broken): every code is valid (`isCode`), action names are lower-case words\\n * (`jump`, `skill2`) and none is a system action, `move` names four actions of the map and `view` others, `values` keys\\n * are namespaced custom intents naming actions of the map, and no action binds a reserved code. The presets are registered on the\\n * shared registry when this module loads.\\n *\\n * Carried from `my-3d2dge:engine/my-3d2dge.js:670-693` (`Input.DEFAULT`, `PLATFORMER`, `SHMUP`, `MENU_KEYS`) with 3D\\n * movement, and shardfall's layer that is never rebound (`shardfall:crates/pav_app/src/input.rs:131-161`).\\n30→ *\\n * @example\\n * const map = getActionMap('actionMap:thirdPerson');\\n * map.actions.jump; // ['Space', 'PadSouth']\\n * map.move; // ['forward', 'back', 'left', 'right']\\n * SYSTEM_ACTIONS.pause; // ['Escape', 'PadStart']\\n * listActionMaps().map((entry) => entry.id); // ['actionMap:firstPerson', 'actionMap:platformer', …]\\n * @see engine/input/bindings.test.ts\\n */\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\\n40→import { show, type Schema } from '../core/schema';\\nimport { AIM_RULES, type AimRule } from './aim';\\nimport { isCode } from './codes';\\n\\n/** The system layer: action → codes. Always active, never rebound, never in the intents. */\\nexport const SYSTEM_ACTIONS: Readonly<Record<string, readonly string[]>> = Object.freeze({\\n  pause: ['Escape', 'PadStart'],\\n  uiAccept: ['Enter', 'NumpadEnter', 'Space', 'PadSouth'],\\n  uiCancel: ['Escape', 'Backspace', 'PadEast'],\\n  uiUp: ['ArrowUp', 'PadUp', 'PadLeftStickUp'],\\n50→  uiDown: ['ArrowDown', 'PadDown', 'PadLeftStickDown'],\\n  uiLeft: ['ArrowLeft', 'PadLeft', 'PadLeftStickLeft'],\\n  uiRight: ['ArrowRight', 'PadRight', 'PadLeftStickRight'],\\n});\\n\\n/** Codes no action map binds: the pause buttons, and keys the browser or the system keeps. */\\nexport const RESERVED_CODES: readonly string[] = Object.freeze([\\n  'Escape',\\n  'PadStart',\\n  'PadHome',\\n60→  'F5',\\n  'F11',\\n  'F12',\\n  'MetaLeft',\\n  'MetaRight',\\n]);\\n\\n/** The fields of an `actionMap` entry. */\\nconst ACTION_MAP_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What the map is for, in plain words.' },\\n70→  actions: {\\n    type: 'object',\\n    required: true,\\n    description:\\n      'Action name → the codes bound to it (KeyboardEvent.code, MouseLeft…, PadSouth…, PadLeftStickUp…): held actions are the intents b, pressed ones p.',\\n  },\\n  move: {\\n    type: 'array',\\n    items: { type: 'string' },\\n    default: ['forward', 'back', 'left', 'right'],\\n80→    description: 'The four actions that walk, as forward, back, left, right: their strengths make the move axes.',\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/input/actionMaps.ts\",\"offset\":null,\"limit\":80,\"raw_output\":\"/**\\n * @file Action maps and presets (PLAN.md WP 3.3, I-24; doctrine: Common ground): the registry kind `actionMap`, a set\\n * of named actions with the physical codes bound to each (engine/input/codes.ts), as Unity's action maps and Godot's\\n * InputMap hold them; the presets; and the system layer, which no player rebinds.\\n *\\n * An action is a button the sim reads: held actions arrive as the intents' `b`, pressed ones as `p`\\n * (engine/input/intents.ts). The four actions a map names in `move` (forward, back, left, right) are not buttons:\\n * their strengths make the move axes `[right − left, forward − back