'error', { paths, patterns }] },\"},{\"line_number\":147,\"content\":\"        'sim/no-restricted-globals': [\"},{\"line_number\":151,\"content\":\"        'sim/no-restricted-properties': ['error', { object: 'Math', property: 'random', message: RANDOM }],\"},{\"line_number\":152,\"content\":\"        'sim/no-restricted-syntax': [\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/tools/eslint/family.ts\",\"matches\":[{\"line_number\":6,\"content\":\" * `no-restricted-imports` on one file would silently lose one family's list. Each family therefore registers the core\"},{\"line_number\":7,\"content\":\" * rules it uses under its own plugin name (`layer/no-restricted-imports`, `sim/no-restricted-globals`): families never\"},{\"line_number\":9,\"content\":\" * except where `resolvingImports` wraps it: `no-restricted-imports` matches the raw source text, so the families\"},{\"line_number\":17,\"content\":\" * const sim = family('sim', 'no-restricted-globals');\"},{\"line_number\":18,\"content\":\" * // a block: { plugins: { sim }, rules: { 'sim/no-restricted-globals': ['error', { name: 'Date', message: '…' }] } }\"},{\"line_number\":49,\"content\":\"/** `plugin` with its `no-restricted-imports` matching each relative source as resolved from the importing file. */\"},{\"line_number\":51,\"content\":\"  const rule = plugin.rules?.['no-restricted-imports'] as Rule.RuleModule | undefined;\"},{\"line_number\":52,\"content\":\"  if (!rule) throw new Error(`${plugin.meta?.name} has no no-restricted-imports to resolve`);\"},{\"line_number\":83,\"content\":\"  return { ...plugin, rules: { ...plugin.rules, 'no-restricted-imports': resolving } };\"},{\"line_number\":135,\"content\":\"/** Every `message` in a list of blocks' rule options, `no-restricted-imports`'s paths and patterns included. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/tools/eslint/layers.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file The layer rules (PLAN.md §6.1; doctrines: WebGPU only, Reproducible): one `no-restricted-imports` block per\"},{\"line_number\":16,\"content\":\" * `layer/no-restricted-imports`.\"},{\"line_number\":20,\"content\":\" * // → layer/no-restricted-imports: engine/core imports nothing from the other layers: …\"},{\"line_number\":26,\"content\":\"/** The plugin the layer blocks use: core's `no-restricted-imports`, resolving, as `layer/no-restricted-imports`. */\"},{\"line_number\":27,\"content\":\"export const layerPlugin: ESLint.Plugin = resolvingImports(family('layer', 'no-restricted-imports'));\"},{\"line_number\":292,\"content\":\"      rules: { 'layer/no-restricted-imports': ['error', { paths: layer.paths ?? [], patterns }] },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/tools/eslint/publicApi.ts\",\"matches\":[{\"line_number\":13,\"content\":\" * types (`type W = import('…').World`, `typeof import('…')`) never reach `no-restricted-imports`, so\"},{\"line_number\":23,\"content\":\" * // → public-api/no-restricted-imports: 'Vector3' import from … Import it from engine/sim-api.ts …\"},{\"line_number\":39,\"content\":\" * matched like `no-restricted-imports` matches named ones (options `{ patterns: [{ regex, message }] }`).\"},{\"line_number\":78,\"content\":\"/** The plugin the public-API blocks use: core's `no-restricted-imports` (resolving) and `no-unnamed-imports`. */\"},{\"line_number\":80,\"content\":\"  ...resolvingImports(family('public-api', 'no-restricted-imports')),\"},{\"line_number\":82,\"content\":\"    ...resolvingImports(family('public-api', 'no-restricted-imports')).rules,\"},{\"line_number\":125,\"content\":\"        'public-api/no-restricte