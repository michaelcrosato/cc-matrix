'],\"},{\"line_number\":93,\"content\":\"    testTimeout: 30_000,\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-2a8669de-7847-402d-aaa3-1aad89fb9edc-44","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"60→export const LOOK_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What it looks like, in plain sentences.' },\\n  group: {\\n    type: 'string',\\n    enum: LOOK_GROUPS,\\n    default: 'look',\\n    description: \\\"Where a menu lists it: 'look' for a whole look, else the filter it presets ('shading' for a style).\\\",\\n  },\\n  style: {\\n    type: 'string',\\n70→    enum: ['', ...MATERIAL_STYLES],\\n    default: '',\\n    description: \\\"The material style everything is drawn in (lambert, toon, flat, pbr); '' keeps the scene's own.\\\",\\n  },\\n  sky: {\\n    type: 'string',\\n    default: '',\\n    description:\\n      \\\"The sky preset that lights the scene (a 'sky' id: sky:hall, the torch-lit hall); '' keeps the scene's own lights.\\\",\\n  },\\n80→  toon: {\\n    type: 'object',\\n    default: { ...TOON_LOOK },\\n    description: \\\"The toon style's bands, rim, shade and dither, used when the style is 'toon'.\\\",\\n    properties: {\\n      bands: { type: 'integer', default: TOON_LOOK.bands, minimum: 2, maximum: 8, description: 'Bands of light.' },\\n      rim: { type: 'number', default: TOON_LOOK.rim, minimum: 0, maximum: 1, description: \\\"The rim light's strength.\\\" },\\n      shade: {\\n        type: 'number',\\n        default: TOON_LOOK.shade,\\n90→        minimum: 0,\\n        maximum: 1,\\n        description: \\\"How far each material's shadows shift in hue (cooler, more saturated) from its colour darkened.\\\",\\n      },\\n      dither: {\\n        type: 'number',\\n        default: TOON_LOOK.dither,\\n        minimum: 0,\\n        maximum: 1,\\n        description:\\n100→          \\\"The share of each band's step mixed by an ordered dither fixed to the world, edges hard; 0 smooths.\\\",\\n      },\\n    },\\n  },\\n  shells: {\\n    type: 'object',\\n    default: { width: 0, color: '#141018' },\\n    description: 'Outline shells round the props and bodies (engine/gfx/stageShells.ts), drawn in front of the sky.',\\n    properties: {\\n      width: {\\n110→        type: 'number',\\n        default: 0,\\n        minimum: 0,\\n        maximum: 4,\\n        description: 'Their width in pixels at 270 lines, scaled to the picture in whole pixels; 0 draws none.',\\n      },\\n      color: { type: 'string', default: '#141018', description: \\\"The shells' colour, hex.\\\" },\\n    },\\n  },\\n  skyGradient: {\\n120→    type: 'number',\\n    default: 0,\\n    minimum: 0,\\n    maximum: 1,\\n    description: \\\"How much of the sky's dome is a clean gradient, horizon haze to zenith, instead of daylight's model.\\\",\\n  },\\n  perspective: {\\n    type: 'string',\\n    default: '',\\n    description:\\n130→      \\\"The look drawn instead while the camera is a perspective one (its variant: same style, sky, resolution and textures); '' keeps this.\\\",\\n  },\\n  resolution: {\\n    type: 'string',\\n    enum: ['', ...RESOLUTION_MODES],\\n    default: '',\\n    description:\\n      \\\"The resolution mode it is drawn at while gfx.resolution is 'auto' (pixels, balanced or full); '' keeps the engine's pixels.\\\",\\n  },\\n  textures: {\\n140→    type: 'string',\\n    enum: ['', ...TEXTURE_LOOKS],\\n    default: '',\\n    description:\\n      \\\"How every material's textures are filtered: 'smooth' blends their texels, 'pixel' keeps them crisp; '' keeps each texture's own.\\\",\\n  },\\n  filters: {\\n    type: 'object',\\n    default: OFF,\\n    description: 'The filter chain: each filter it names, with its scope and numbers; the rest are off.',\\n150→    properties: FILTER_FIELDS,\\n  },\\n  combine: COMBINE_FIELD,\\n  strength: STRENGTH_FIELD,\\n  gallery: galleryField({ camera: 'cam=iso' }),\\n} as const satisfies Schema;\\n\\n/** A `look` entry. */\\nexport type LookEntry = Entry<typeof LOOK_FIELDS>;\\n\",\"content_concise\":\"60→export const LOOK_FIELDS = {\\n  description: { type: 'string', default: '', description: 'What it looks like, in plain sentences.' },\\n  group: {\\n    type: 'string',\\n    enum: LOOK_GROUPS,\\n    default: 'look',\\n    description: \\\"Where a menu lists it: 'look' for a whole look, else the filter it presets ('shading' for a style).\\\",\\n  },\\n  style: {\\n    type: 'string',\\n70→    enum: ['', ...MATERIAL_STYLES],\\n    default: '',\\n    description: \\\"The material style everything is drawn in (lambert, toon, flat, pbr); '' keeps the scene's own.\\\",\\n  },\\n  sky: {\\n    type: 'string',\\n    default: '',\\n    description:\\n      \\\"The sky preset that lights the scene (a 'sky' id: sky:hall, the torch-lit hall); '' keeps the scene's own lights.\\\",\\n  },\\n80→  toon: {\\n    type: 'object',\\n    default: { ...TOON_LOOK },\\n    description: \\\"The toon style's bands, rim, shade and dither, used when the style is 'toon'.\\\",\\n    properties: {\\n      bands: { type: 'integer', default: TOON_LOOK.bands, minimum: 2, maximum: 8, description: 'Bands of light.' },\\n      rim: { type: 'number', default: TOON_LOOK.rim, minimum: 0, maximum: 1, description: \\\"The rim light's strength.\\\" },\\n      shade: {\\n        type: 'number',\\n        default: TOON_LOOK.shade,\\n90→        minimum: 0,\\n        maximum: 1,\\n        description: \\\"How far each material's shadows shift in hue (cooler, more saturated) from its colour darkened.\\\",\\n      },\\n      dither: {\\n        type: 'number',\\n        default: TOON_LOOK.dither,\\n        minimum: 0,\\n        maximum: 1,\\n        description:\\n100→          \\\"The share of each band's step mixed by an ordered dither fixed to the world, edges hard; 0 smooths.\\\",\\n      },\\n    },\\n  },\\n  shells: {\\n    type: 'object',\\n    default: { width: 0, color: '#141018' },\\n    description: 'Outline shells