here, '../../..');\\nconst gameName = 'Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731.html';\\nconst serve = join(here, 'hub-serve');\\nmkdirSync(serve, { recursive: true });\\ncpSync(join(root, '..', gameName), join(serve, gameName));\\nfor (const file of ['harness.html', 'bridge.js', 'round.js']) {\\n  if (!cpExists(join(here, 'hub', file))) continue;\\n  cpSync(join(here, 'hub', file), join(serve, file));\\n}\\n20→\\n/** True when a downloaded harness file is present. */\\nfunction cpExists(path) {\\n  return existsSync(path);\\n}\\n\\nconst server = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], {\\n  cwd: serve,\\n  stdio: ['ignore', 'pipe', 'pipe'],\\n});\\n30→const port = await new Promise((resolve, reject) => {\\n  const timer = setTimeout(() => reject(new Error('the server did not say its port')), 8000);\\n  server.stderr.on('data', (buf) => {\\n    const found = String(buf).match(/port (\\\\d+)/);\\n    if (!found) return;\\n    clearTimeout(timer);\\n    resolve(Number(found[1]));\\n  });\\n});\\n\\n40→const browser = await chromium.launch({\\n  executablePath: process.env.CHROMIUM_PATH,\\n  headless: true,\\n  args: [\\n    '--enable-unsafe-webgpu',\\n    '--enable-features=Vulkan',\\n    '--use-vulkan=swiftshader',\\n    '--use-angle=swiftshader',\\n    '--use-webgpu-adapter=swiftshader',\\n  ],\\n50→});\\nlet failed = 0;\\n\\n/** One JSON line for verify. */\\nfunction report(name, ok, detail = '') {\\n  if (!ok) failed += 1;\\n  console.log(JSON.stringify({ name, ok, detail: String(detail).slice(0, 400) }));\\n}\\n\\nconst runs = [\\n60→  ['hub 2 players', 'players=2&auto=1&limit=25'],\\n  ['hub 4 players lossy', 'players=4&latency=150&jitter=50&loss=5&auto=1&limit=25'],\\n  ['hub host leaves', 'players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1&limit=25'],\\n  ['hub server copy', 'players=2&scenario=server&auto=1&limit=25'],\\n];\\n\\nfor (const [name, query] of runs) {\\n  const page = await browser.newPage();\\n  const errors = [];\\n  page.on('pageerror', (error) => errors.push(error.message));\\n70→  await page.goto(`http://127.0.0.1:${port}/harness.html?game=${gameName}&${query}`);\\n  let ok = false;\\n  try {\\n    await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 120000 });\\n    ok = await page.evaluate(() => window.__hubCheck?.pass === true);\\n  } catch {\\n    ok = false;\\n  }\\n  const detail = ok ? '' : await page.evaluate(() => document.body.innerText).catch(() => errors.join(' | '));\\n  report(name, ok, detail.slice(0, 400));\\n80→  await page.close();\\n}\\n\\nconst solo = await browser.newPage();\\nawait solo.goto(`http://127.0.0.1:${port}/${gameName}`);\\nlet soloOk = false;\\ntry {\\n  await solo.waitForFunction(\\n    () => window.__engine && window.__engine.ready && window.__compass?.screen === 'title',\\n    null,\\n90→    { timeout: 40000 },\\n  );\\n  soloOk = true;\\n} catch {\\n  soloOk = false;\\n}\\nreport('game with no session', soloOk, soloOk ? '' : 'the title did not come up');\\nawait browser.close();\\nserver.kill('SIGTERM');\\nprocess.exit(failed ? 1 : 0);\\n\",\"content_concise\":\"1→/**\\n * @file The four AI Hub harness runs, then the game opened with no session. Serves the one-file page on 127.0.0.1.\\n */\\nimport { spawn } from 'node:child_process';\\nimport { cpSync, existsSync, mkdirSync } from 'node:fs';\\nimport { dirname, join } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nimport { chromium } from 'playwright';\\n\\n10→const here = dirname(fileURLToPath(import.meta.url));\\nconst root = join(here, '../../..');\\nconst gameName = 'Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731.html';\\nconst serve = join(here, 'hub-serve');\\nmkdirSync(serve, { recursive: true });\\ncpSync(join(root, '..', gameName), join(serve, gameName));\\nfor (const file of ['harness.html', 'bridge.js', 'round.js']) {\\n  if (!cpExists(join(here, 'hub', file))) continue;\\n  cpSync(join(here, 'hub', file), join(serve, file));\\n}\\n20→\\n/** True when a downloaded harness file is present. */\\nfunction cpExists(path) {\\n  return existsSync(path);\\n}\\n\\nconst server = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], {\\n  cwd: serve,\\n  stdio: ['ignore', 'pipe', 'pipe'],\\n});\\n30→const port = await new Promise((resolve, reject) => {\\n  const timer = setTimeout(() => reject(new Error('the server did not say its port')), 8000);\\n  server.stderr.on('data', (buf) => {\\n    const found = String(buf).match(/port (\\\\d+)/);\\n    if (!found) return;\\n    clearTimeout(timer);\\n    resolve(Number(found[1]));\\n  });\\n});\\n\\n40→const browser = await chromium.launch({\\n  executablePath: process.env.CHROMIUM_PATH,\\n  headless: true,\\n  args: [\\n    '--enable-unsafe-webgpu',\\n    '--enable-features=Vulkan',\\n    '--use-vulkan=swiftshader',\\n    '--use-angle=swiftshader',\\n    '--use-webgpu-adapter=swiftshader',\\n  ],\\n50→});\\nlet failed = 0;\\n\\n/** One JSON line for verify. */\\nfunction report(name, ok, detail = '') {\\n  if (!ok) failed += 1;\\n  console.log(JSON.stringify({ name, ok, detail: String(detail).slice(0, 400) }));\\n}\\n\\nconst runs = [\\n60→  ['hub 2 players', 'players=2&auto=1&limit=25'],\\n  ['hub 4 players lossy', 'players=4&latency=150&jitter=50&loss=5&auto=1&limit=25'],\\n  ['hub host leaves', 'players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1&limit=25'],\\n  ['hub server copy', 'players=2&scenario=server&auto=1&limit=25'],\\n];\\n\\nfor (const [name, query] of runs) {\\n  const page = await browser.newPage();\\n  const errors = [];\\n  page.on('pageerror', (error) => errors.push(error.message));\\n70→  await page.goto(`http://127.0.0.1:${port}/harness.html?game=${gameName}&${query}`);\\n  let ok = false;\\n  try {\\n    await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 120000 });\\n    ok = await page.evaluate(() => window.__hubCheck?.pass === true);\\n  } catch {\\n    ok = false;\\n  }\\n  const detail = ok ? '' : await page.evaluate(() => document.body.innerText).catch(() => errors.join(' | '));\\n  report(name, ok, detail.slice(0, 400));\\n80→  await page.close();\\n}\\n\\nconst solo = await browser.newPage();\\nawait solo.goto(`http://127.0.0.1:${port}/${gameName}`);\\nlet soloOk = false;\\ntry {\\n  await solo.waitForFunction(\\n    () => window.__engine && window.__engine.ready && window.__compass?.screen === 'title',\\n    null,\\n90→    { timeout: 40000 },\\n  );\\n  soloOk = true;\\n} catch {\\n  soloOk = false;\\n}\\nreport('game with no session', soloOk, soloOk ? '' : 'the title did not come up');\\nawait browser.close();\\nserver.kill('SIGTERM');\\nprocess.exit(failed ? 1 : 0);\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/tools/hub.mjs\",\"offset\":null,\"limit\":200,\"raw_output\":\"/**\\n * @file The four AI Hub harness runs, then the game opened with no session. Serves the one-file page on 127.0.0.1.\\n */\\nimport { spawn } from 'node:child_process';\\nimport { cpSync, existsSync, mkdirSync } from 'node:fs';\\nimport { dirname, join } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nimport { chromium } from 'playwright';\\n\\nconst here = dirname(fileURLToPath(import.meta.url));\\nconst root = join(here, '../../..');\\nconst gameName = 'Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731.html';\\nconst serve = join(here, 'hub-serve');\\nmkdirSync(serve, { recursive: true });\\ncpSync(join(root, '..', gameName), join(serve, gameName));\\nfor (const file of ['harness.html', 'bridge.js', 'round.js']) {\\n  if (!cpExists(join(here, 'hub', file))) continue;\\n  cpSync(join(here, 'hub', file), join(serve, file));\\n}\\n\\n/** True when a downloaded harness file is present. */\\nfunction cpExists(path) {\\n  return existsSync(path);\\n}\\n\\nconst server = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], {\\n  cwd: serve,\\n  stdio: ['ignore', 'pipe', 'pipe'],\\n});\\nconst port = await new Promise((resolve, reject) => {\\n  const timer = setTimeout(() => reject(new Error('the server did not say its port')), 8000);\\n  server.stderr.on('data', (buf) => {\\n    const found = String(buf).match(/port (\\\\d+)/);\\n    if (!found) return;\\n    clearTimeout(timer);\\n    resolve(Number(found[1]));\\n  });\\n});\\n\\nconst browser = await chromium.launch({\\n  executablePath: process.env.CHROMIUM_PATH,\\n  headless: true,\\n  args: [\\n    '--enable-unsafe-webgpu',\\n    '--enable-features=Vulkan',\\n    '--use-vulkan=swiftshader',\\n    '--use-angle=swiftshader',\\n    '--use-webgpu-adapter=swiftshader',\\n  ],\\n});\\nlet failed = 0;\\n\\n/** One JSON line for verify. */\\nfunction report(name, ok, detail = '') {\\n  if (!ok) failed += 1;\\n  console.log(JSON.stringify({ name, ok, detail: String(detail).slice(0, 400) }));\\n}\\n\\nconst runs = [\\n  ['hub 2 players', 'players=2&auto=1&limit=25'],\\n  ['hub 4 players lossy', 'players=4&latency=150&jitter=50&loss=5&auto=1&limit=25'],\\n  ['hub host leaves', 'players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1&limit=25'],\\n  ['hub server copy', 'players=2&scenario=server&auto=1&limit=25'],\\n];\\n\\nfor (const [name, query] of runs) {\\n  const page = await browser.newPage();\\n  const errors = [];\\n  page.on('pageerror', (error) => errors.push(error.message));\\n  await page.goto(`http://127.0.0.1:${port}/harness.html?game=${gameName}&${query}`);\\n  let ok = false;\\n  try {\\n    await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 120000 });\\n    ok = await page.evaluate(() => window.__hubCheck?.pass === true);\\n  } catch {\\n    ok = false;\\n  }\\n  const detail = ok ? '' : await page.evaluate(()