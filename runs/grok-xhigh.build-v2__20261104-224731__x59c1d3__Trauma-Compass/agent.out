se(): void;\"},{\"line_number\":33,\"content\":\"export function startRound(hub: HubLink, info: HubInfo, engine: Stepper, seats: number): RoundView {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/boot.ts\",\"matches\":[{\"line_number\":39,\"content\":\"import { startRound, type RoundView } from '../net/live';\"},{\"line_number\":43,\"content\":\"  pause(): void;\"},{\"line_number\":47,\"content\":\"  seed(n?: number): number;\"},{\"line_number\":60,\"content\":\"  ready(): void;\"},{\"line_number\":91,\"content\":\"    engine.pause();\"},{\"line_number\":336,\"content\":\"      enginePage.pause();\"},{\"line_number\":337,\"content\":\"      enginePage.seed(roundInfo.seed);\"},{\"line_number\":338,\"content\":\"      enginePage.pause();\"},{\"line_number\":339,\"content\":\"      hub.ready();\"},{\"line_number\":340,\"content\":\"      session.round = startRound(hub, roundInfo, enginePage, Math.max(1, roundInfo.players.length));\"},{\"line_number\":387,\"content\":\"    enginePage.seed(1);\"},{\"line_number\":458,\"content\":\"    if (session || busy) enginePage.pause();\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"d9b82e08-928a-486e-a5a3-dbd498ba02fc"}
