escribe('campaign', () => {\\n  it('walks a new shift as far as the first briefing', () => {\\n10→    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('before-1');\\n    let steps = 0;\\n    while (campaign.screen === 'story' && steps < 40) {\\n      accept(campaign);\\n      steps += 1;\\n    }\\n    expect(steps).toBeLessThanOrEqual(40);\\n20→    expect(campaign.screen).toBe('brief');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('op');\\n    expect(desiredRun(campaign)).toBe('op:case:first-cut');\\n  });\\n\\n  it('records a win and then the scene after the case', () => {\\n    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    for (let i = 0; i < 40 && campaign.screen !== 'op'; i++) accept(campaign);\\n30→    expect(campaign.screen).toBe('op');\\n    finishOp(campaign, true, 16815, 0, '');\\n    expect(campaign.screen).toBe('debrief');\\n    expect(campaign.lastRank).toBe('S');\\n    expect(campaign.progress.ranks[0]).toBe('S');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('after-1');\\n  });\\n\\n40→  it('starts the kiosk after ten seconds on the title and leaves it on a press', () => {\",\"content_concise\":\"1→/**\\n * @file The shift with no browser: a new night reaches a briefing, a win reaches the next scene, and ten quiet\\n * seconds on the title become the kiosk.\\n */\\nimport { describe, expect, it } from 'vitest';\\nimport { ATTRACT, accept, act, createCampaign, desiredRun, finishOp, items, tickFront } from './campaign';\\n\\ndescribe('campaign', () => {\\n  it('walks a new shift as far as the first briefing', () => {\\n10→    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('before-1');\\n    let steps = 0;\\n    while (campaign.screen === 'story' && steps < 40) {\\n      accept(campaign);\\n      steps += 1;\\n    }\\n    expect(steps).toBeLessThanOrEqual(40);\\n20→    expect(campaign.screen).toBe('brief');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('op');\\n    expect(desiredRun(campaign)).toBe('op:case:first-cut');\\n  });\\n\\n  it('records a win and then the scene after the case', () => {\\n    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    for (let i = 0; i < 40 && campaign.screen !== 'op'; i++) accept(campaign);\\n30→    expect(campaign.screen).toBe('op');\\n    finishOp(campaign, true, 16815, 0, '');\\n    expect(campaign.screen).toBe('debrief');\\n    expect(campaign.lastRank).toBe('S');\\n    expect(campaign.progress.ranks[0]).toBe('S');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('after-1');\\n  });\\n\\n40→  it('starts the kiosk after ten seconds on the title and leaves it on a press', () => {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.test.ts\",\"offset\":null,\"limit\":40,\"raw_output\":\"/**\\n * @file The shift with no browser: a new night reaches a briefing, a win reaches the next scene, and ten quiet\\n * seconds on the title become the kiosk.\\n */\\nimport { describe, expect, it } from 'vitest';\\nimport { ATTRACT, accept, act, createCampaign, desiredRun, finishOp, items, tickFront } from './campaign';\\n\\ndescribe('campaign', () => {\\n  it('walks a new shift as far as the first briefing', () => {\\n    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('before-1');\\n    let steps = 0;\\n    while (campaign.screen === 'story' && steps < 40) {\\n      accept(campaign);\\n      steps += 1;\\n    }\\n    expect(steps).toBeLessThanOrEqual(40);\\n    expect(campaign.screen).toBe('brief');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('op');\\n    expect(desiredRun(campaign)).toBe('op:case:first-cut');\\n  });\\n\\n  it('records a win and then the scene after the case', () => {\\n    const campaign = createCampaign();\\n    act(campaign, 'new');\\n    for (let i = 0; i < 40 && campaign.screen !== 'op'; i++) accept(campaign);\\n    expect(campaign.screen).toBe('op');\\n    finishOp(campaign, true, 16815, 0, '');\\n    expect(campaign.screen).toBe('debrief');\\n    expect(campaign.lastRank).toBe('S');\\n    expect(campaign.progress.ranks[0]).toBe('S');\\n    accept(campaign);\\n    expect(campaign.screen).toBe('story');\\n    expect(campaign.storyId).toBe('after-1');\\n  });\\n\\n  it('starts the kiosk after ten seconds on the title and leaves it on a press', () => {\\n\",\"total_lines\":52}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"b2d9e6c6-8ed8-4e0b-b3fe-576b84358a14"}
