"line_number\":38,\"content\":\"export function modeOf(word) {\"},{\"line_number\":45,\"content\":\"/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\"},{\"line_number\":46,\"content\":\"export const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\"},{\"line_number\":48,\"content\":\"/**\"},{\"line_number\":54,\"content\":\"export const seedsRandom = (tag) =>\"},{\"line_number\":61,\"content\":\"const REAL_CLOCK = {\"},{\"line_number\":67,\"content\":\"/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\"},{\"line_number\":68,\"content\":\"export function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\"},{\"line_number\":74,\"content\":\"/**\"},{\"line_number\":79,\"content\":\"export function rankResults(results, ids) {\"},{\"line_number\":102,\"content\":\"/** A time or score as a number: finite, given as a number or as text; NaN for null, '' or true, which Number() would make 0. */\"},{\"line_number\":103,\"content\":\"const asNumber = (v) => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '') ? Number(v) : NaN);\"},{\"line_number\":105,\"content\":\"/** The protocol's limits on a round's highlights (README §10). */\"},{\"line_number\":106,\"content\":\"export const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\"},{\"line_number\":108,\"content\":\"/** One player's stats, trimmed: up to six names, each a finite number or a short text. Null when none survive. */\"},{\"line_number\":109,\"content\":\"export function cleanStats(stats) {\"},{\"line_number\":121,\"content\":\"/**\"},{\"line_number\":125,\"content\":\"export function cleanAwards(awards, ids, self = null) {\"},{\"line_number\":144,\"content\":\"/**\"},{\"line_number\":149,\"content\":\"export function checkStandings(standings, presentIds, allIds) {\"},{\"line_number\":174,\"content\":\"