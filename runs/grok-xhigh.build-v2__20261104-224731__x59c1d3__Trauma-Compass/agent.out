 so `npm run check` does);\"},{\"line_number\":11,\"content\":\" *   replaces the engine's files and leaves the game's alone (`--force` replaces declared patches too). Only when the\"},{\"line_number\":44,\"content\":\"  const patch = `write what you needed in ${FEEDBACK_FILE}; only when no workaround exists, keep the patch and list it there under \\\"Local engine patches\\\"`; // prettier-ignore\"},{\"line_number\":67,\"content\":\"  const patches = found.declared.filter((path) => patched.includes(path));\"},{\"line_number\":71,\"content\":\"      : patches.length > 0\"},{\"line_number\":72,\"content\":\"        ? `as shipped but for ${patches.length} declared local patches`\"},{\"line_number\":80,\"content\":\"      ...patches.map((path) => `local patch (declared in ${FEEDBACK_FILE}): ${path}`),\"},{\"line_number\":89,\"content\":\"      declared: patches.length,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/tools/game/files.mjs\",\"matches\":[{\"line_number\":19,\"content\":\" * game already had); a declared patch is a path in backticks at the start of a list item under ENGINE-FEEDBACK.md's\"},{\"line_number\":20,\"content\":\" * \\\"## Local engine patches\\\", outside comments.\"},{\"line_number\":274,\"content\":\"/** The engine files ENGINE-FEEDBACK.md lists under \\\"Local engine patches\\\", outside comments. */\"},{\"line_number\":279,\"content\":\"  const section = /^## Local engine patches\\\\s*$([\\\\s\\\\S]*?)(?=^## |(?![\\\\s\\\\S]))/m.exec(text)?.[1] ?? '';\"},{\"line_number\":285,\"content\":\" * folders, and the patches it declares; `undeclared` is every one of the first three that the game does not declare.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/tools/game/new-game.mjs\",\"matches\":[{\"li