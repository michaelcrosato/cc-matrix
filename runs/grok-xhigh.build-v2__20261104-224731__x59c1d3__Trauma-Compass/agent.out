5 - G5 -' }],\\n});\\n\\ndefineSong('song:win', {\\n  description: 'The operation holds.',\\n  bpm: 120,\\n  tracks: [{ wave: 'triangle', vol: 0.16, notes: 'C4 E4 G4 C5 | E5 - - -' }],\\n});\\n\\ndefineSong('song:lose', {\\n  description: 'Called off.',\\n  bpm: 70,\\n  tracks: [{ wave: 'saw', vol: 0.08, notes: 'E4 - C4 - | A3 - - -' }],\\n});\",\"new_string\":\"defineSfx('sfx:menu', { voices: { wave: 'square', freq: 660, to: 880, dur: 0.04, vol: 0.12 }, bus: 'ui' });\\n\\n/** One bar is four steps. Every track below fills whole bars. */\\nconst SONG = { steps: 1, beats: 4 } as const;\\n\\ndefineSong('song:title', {\\n  description: 'The harbour at night, under the title.',\\n  bpm: 92,\\n  ...SONG,\\n  tracks: [\\n    { wave: 'triangle', vol: 0.16, notes: 'A3 - C4 - | E4 - C4 - | A3 - D4 - | E4 - C4 -' },\\n    { wave: 'sine', vol: 0.08, notes: 'A2 - - - | A2 - - - | F2 - - - | A2 - - -' },\\n  ],\\n});\\n\\ndefineSong('song:or', {\\n  description: 'Calm under the lamp, while the work is ordinary.',\\n  bpm: 100,\\n  ...SONG,\\n  tracks: [\\n    { wave: 'triangle', vol: 0.14, notes: 'C4 - E4 - | G4 - E4 - | D4 - F4 - | E4 - C4 -' },\\n    { wave: 'sine', vol: 0.07, notes: 'C3 - G3 - | A3 - G3 - | F3 - A3 - | G3 - E3 -' },\\n  ],\\n});\\n\\ndefineSong('song:strain', {\\n  description: 'Something on the sheet is no longer tissue.',\\n  bpm: 128,\\n  ...SONG,\\n  tracks: [\\n    { wave: 'saw', vol: 0.1, notes: 'E4 - G4 - | Bb4 - G4 - | E4 - A4 - | Bb4 - G4 -' },\\n    { wave: 'triangle', vol: 0.12, notes: 'E3 - - - | E3 - - - | F3 - - - | E3 - - -' },\\n  ],\\n});\\n\\ndefineSong('song:mercy', {\\n  description: 'The last case, slow and wide.',\\n  bpm: 72,\\n  ...SONG,\\n  tracks: [\\n    { wave: 'sine', vol: 0.14, notes: 'G4 - - - | B4 - - - | D5 - - - | B4 - - -' },\\n    { wave: 'triangle', vol: 0.1, notes: 'G3 - D4 - | G3 - D4 - | A3 - E4 - | G3 - D4 -' },\\n  ],\\n});\\n\\ndefineSong('song:story', {\\n  description: 'Between operations, in the corridor.',\\n  bp