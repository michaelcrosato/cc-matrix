 void {\\n  const seconds = ft / FIELD_SECOND;\\n  for (const target of op.targets) {\\n    if (target.done || target.kind !== 'pool') continue;\\n    if (op.seats.some((seat) => seat.site === target.site)) continue;\\n    target.volume = Math.min(target.volumeMax + 2, target.volume + 0.18 * seconds);\\n  }\\n}\\n\\n/** A seat the tests can poke. */\\nexport function seatOf(op: Op, id = 0): Seat {\\n  return op.seats[id];\\n}\\n\\n/** Heal hook used by Second Pulse tests through award. Re-export path stays in ratings. */\\nexport function touchHeal(op: Op, seat: Seat, amount: number): void {\\n  heal(op, seat, amount);\\n}\\n\\n/** Spawn helper for a strain that births a lull, a mote, or a tendril. */\\nexport function birth(\\n  op: Op,\\n  kind: 'lull' | 'numb' | 'binder' | 'mote' | 'wound' | 'guide' | 'tendril',\\n  x: number,\\n  z: number,\\n  phase: number,\\n  extra: Partial<Spawn> = {},\\n): void {\\n  addTarget(op, { ...extra, kind, x, z, site: extra.site ?? 0, patient: extra.patient ?? 0 }, phase);\\n}\\n\",\"total_lines\":295}}","is_error":false},{"type":"tool_result","tool_use_id":"call-611902f9-de79-4e18-8d1f-af5388437243-44","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"470→  const jx = jitter(op.seed, op.nextId);\\n  const jz = jitter(op.seed, op.nextId + 17);\\n  return addTarget(\\n    op,\\n    {\\n      ...spawn,\\n      x: spawn.x + jx,\\n      z: spawn.z + jz,\\n      x2: spawn.x2 !== undefined ? spawn.x2 + jx : undefined,\\n      z2: spawn.z2 !== undefined ? spawn.z2 + jz : undefined,\\n480→    },\\n    phase,\\n  );\\n}\\n\\n/** A stable offset in -0.08..0.08. Seed 1 is not zero, so paths still differ. */\\nexport function jitter(seed: number, n: number): number {\\n  const x = Math.sin(seed * 12.9898 + n * 78.233) * 43758.5453;\\n  return (x - Math.floor(x) - 0.5) * 0.16;\\n}\\n490→\\n/** Start the current phase: hint, teach, spawns, entrance. */\\nexport function enterPhase(op: Op): void {\\n  const phase = op.phases[op.phase];\\n  if (!phase) {\\n    return;\\n  }\\n  op.hint = phase.hint;\\n  op.teach = phase.teach;\\n  op.codeCleared = false;\\n500→  spawnPhase(op, phase, op.phase);\\n  if (phase.onEnter === 'dip') {\\n    for (const patient of op.patients) patient.vitals = Math.min(patient.vitals, 40);\\n  }\\n  if (phase.onEnter === 'flatline') {\\n    const patient = op.patients[0];\\n    patient.vitals = 0;\\n    op.events.push({ type: 'flatline', text: 'Flatline.' });\\n  }\\n  if (phase.onEnter === 'mercy-expose') op.mercyExposed = 1;\\n510→  op.events.push({ type: 'phase', text: phase.hint });\\n}\\n\\n/** Hash the gameplay state. Bot memos and event text stay out, so a replay of hands reproduces it. */\\nexport function hashOp(op: Op): string {\\n  const parts: string[] = [\\n    String(op.tick),\\n    String(op.phase),\\n    op.status,\\n    String(q(op.field)),\\n520→    String(q(op.clock)),\\n    String(op.slips),\\n    String(op.score),\\n    op.radial ? 'r' : '-',\\n    op.holdVitals ? 'v' : '-',\\n    op.holdClock ? 'k' : '-',\\n  ];\\n  for (const patient of op.patients) parts.push(String(q(patient.vitals)), patient.alive ? '1' : '0');\\n  for (const seat of op.seats) {\\n    parts.push(String(q(seat.x)), String(q(seat.z)), String(seat.tool), String(seat.score), String(q(seat.chain)));\\n530→  }\\n  for (const target of op.targets) {\\n    parts.push(\\n      String(target.id),\\n      target.kind,\\n      target.done ? '1' : '0',\\n      String(q(target.x)),\\n      String(q(target.z)),\\n      String(q(target.volume)),\\n      String(q(target.burn)),\\n540→      String(target.stitches),\\n      String(target.cut),\\n      String(q(target.hp)),\\n      String(target.gen),\\n      target.hidden ? '1' : '0',\\n      String(target.dose),\\n      String(q(target.lift)),\\n    );\\n  }\\n  if (op.code) parts.push('code', String(op.code.tries), String(q(op.code.left)));\",\"content_concise\":\"470→  const jx = jitter(op.seed, op.nextId);\\n  const jz = jitter(op.seed, op