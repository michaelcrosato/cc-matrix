},\\n110→  'game.attract': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'scene',\\n    description: 'Attract cheats: no failure, vitals floored, the clock frozen.',\\n  },\\n  'game.simple': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'scene',\\n120→    description: 'Simple Gift: one press, no beat lock.',\\n  },\\n  'game.colleague': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'scene',\\n    description: 'Force the AI colleague on, for a lone player in a hub round.',\\n  },\\n  'game.seed': {\\n    type: 'integer',\\n130→    default: 1,\\n    minimum: 0,\\n    maximum: 999999,\\n    when: 'scene',\\n    description: 'The operation seed. The engine seed still restarts the scene.',\\n  },\\n  'game.autoplay': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'now',\\n140→    description: 'The operation plays itself, one fresh bot hand every step. The page uses it to walk the shift.',\\n  },\\n  ...sliderSettings,\\n  ...feelSettings,\\n});\\n\",\"content_concise\":\"100→    when: 'scene',\\n    description: 'How many surgeons scrub in.',\\n  },\\n  'game.difficulty': {\\n    type: 'string',\\n    default: 'resident',\\n    enum: ['intern', 'resident', 'attending'],\\n    when: 'scene',\\n    description: 'Intern, Resident or Attending.',\\n  },\\n110→  'game.attract': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'scene',\\n    description: 'Attract cheats: no failure, vitals floored, the clock frozen.',\\n  },\\n  'game.simple': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'scene',\\n120→    description: 'Simple Gift: one press, no beat lock.',\\n  },\\n  'game.colleague': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'scene',\\n    description: 'Force the AI colleague on, for a lone player in a hub round.',\\n  },\\n  'game.seed': {\\n    type: 'integer',\\n130→    default: 1,\\n    minimum: 0,\\n    maximum: 999999,\\n    when: 'scene',\\n    description: 'The operation seed. The engine seed still restarts the scene.',\\n  },\\n  'game.autoplay': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'now',\\n140→    description: 'The operation plays itself, one fresh bot hand every step. The page uses it to walk the shift.',\\n  },\\n  ...sliderSettings,\\n  ...feelSettings,\\n});\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/scenes/tune.ts\",\"offset\":100,\"limit\":50,\"raw_output\":\"    when: 'scene',\\n    description: 'How many surgeons scrub in.',\\n  },\\n  'game.difficulty': {\\n    type: 'string',\\n    default: 'resident',\\n    enum: ['intern', 'resident', 'attending'],\\n    when: 'scene',\\n    description: 'Intern, Resident or Attending.',\\n  },\\n  'game.attract': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'scene',\\n    description: 'Attract cheats: no failure, vitals floored, the clock frozen.',\\n  },\\n  'game.simple': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'scene',\\n    description: 'Simple Gift: one press, no beat lock.',\\n  },\\n  'game.colleague': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'scene',\\n    description: 'Force the AI colleague on, for a lone player in a hub round.',\\n  },\\n  'game.seed': {\\n    type: 'integer',\\n    default: 1,\\n    minimum: 0,\\n    maximum: 999999,\\n    when: 'scene',\\n    description: 'The operation seed. The engine seed still restarts the scene.',\\n  },\\n  'game.autoplay': {\\n    type: 'boolean',\\n    default: false,\\n    when: 'now',\\n    description: 'The operation plays itself, one fresh bot hand every step. The page uses it to walk the shift.',\\n  },\\n  ...sliderSettings,\\n  ...feelSettings,\\n});\\n\",\"total_lines\":144}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"20705275-d962-4fd5-9c21-9