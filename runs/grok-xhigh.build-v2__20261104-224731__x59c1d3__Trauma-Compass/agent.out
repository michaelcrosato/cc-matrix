{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-0d761c45-a28b-444e-accd-9281c974ef70-33","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"import type { Hand, Op, Seat } from './types';\",\"new_string\":\"import type { Hand, Op, Seat, Spawn } from './types';\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/body.ts has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/body.ts has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/body.ts\",\"edits\":{\"details\":[{\"old_string\":\"import type { Hand, Op, Seat } from './types';\",\"old_line\":6,\"new_string\":\"import type { Hand, Op, Seat, Spawn } from './types';\",\"new_line\":6,\"context_before\":\" * the patient knows. Cursors already moved before this runs.\\n */\\nimport { award, failOp, heal, POINTS, winOp } from './ratings';\\n\",\"context_after\":\"import { addTarget, enterPhase, FIELD_SECOND } from './world';\\n\\n/** Field ticks this step. Stillpoint is a quarter. The pulse-lock minigame is 30 percent. */\\n\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"ee89614a-eace-4a6b-865c-bf3b3720f356"}
{"type":"assistant","message":{"id":"msg_52","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"text","text":"Cases and the bot are next. The bot will only move the same hand fields a player’s pad would send."},{"type":"tool_use","id":"call-4d2a282a-b042-4463-a9df-4bb86e0ffa74-34","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/cases.ts","new_string":"/**\n * @file The eight story operations, plus the session case. Each case adds one rule from the plan: tools, sites,\n * a strain, a gift. Numbers are metres and seconds. Postcards are the patient's own words, one line per rank.\n */\nimport type { CaseDef, PhaseDef, Postcards, Spawn } from './types';\n\n/** Four postcard lines. */\nfunction cards(s: string, a: string, b: string, c: string): Postcards {\n  return { S: s, A: a, B: b, C: c };\n}\n\n/** A phase row. */\nfunction phase(id: string, hint: string, until: PhaseDef['until'], spawn: Spawn[], onEnter = '', teach = ''): PhaseDef {\n  return { id, hint, until, spawn, onEnter, teach };\n}\n\n/** A pool small enough that triage still has a clock. */\nfunction pool(x: number, z: number, site = 0, patient = 0): Spawn {\n  return { kind: 'pool', x, z, site, patient, volume: 1.15, bleed: 0.22 };\n}\n\n/** A laceration two stitches long. */\nfunction wound(x: number, z: number, site = 0, patient = 0): Spawn {\n  return { kind: 'wound', x, z, x2: x + 1.15, z2: z, site, patient, need: 2 };\n}\n\n/** A shard of glass or graft. */\nfunction shard(x: number, z: number, site = 0, patient = 0): Spawn {\n  return { kind: 'shard', x, z, site, patient };\n}\n\n/** Gel on raw skin. */\nfunction gel(x: number, z: number, site = 0, patient = 0): Spawn {\n  return { kind: 'abrasion', x, z, site, patient, coverNeed: 8 };\n}\n\n/** A guide the scalpel can follow. `bow` bends it off the straight line. */\nfunction curve(x0: number, z0: number, x1: number, z1: number, bow: number, unlock = '', tag = ''): Spawn {\n  const len = Math.hypot(x1 - x0, z1 - z0);\n  const steps = Math.max(1, Math.round(len / 0.32));\n  const path: number[] = [];\n  for (let i = 0; i <= steps; i++) {\n    const u = i / steps;\n    path.push(x0 + (x1 - x0) * u, z0 + (z1 - z0) * u + Math.sin(u * Math.PI) * bow);\n  }\n  return { kind: 'guide', x: x0, z: z0, path, unlock, tag, spawnBleeders: tag === 'long' ? 2 : 0 };\n}\n\n/** Six motes around the heart. */\nfunction motes(): Spawn[] {\n  const out: Spawn[] = [];\n  for (let i = 0; i < 6; i++) {\n    const angle = (i / 6) * Math.PI * 2;\n    out.push({ kind: 'mote', x: Math.cos(angle) * 1.15, z: Math.sin(angle) * 0.7 });\n  }\n  return out;\n}\n\n/** The eight story cases, in order, then the session case. */\nexport const CASES: readonly CaseDef[] = [\n  {\n    id: 'case:first-cut',\n    title: 'First Cut',\n    surgeon: 'Wren',\n    seconds: 240,\n    gift: 'none',\n    charges: 0,\n    colleague: false,\n    swap: false,\n    roll: false,\n    code: false,\n    rule: 'Cursor, radial, drain, forceps, suture, syringe, and gel.',\n    patients: [\n      {\n        name: 'Tomás Reyes',\n        age: 52,\n        line: 'Harbor pilot. Glass from a deck hatch. His dog is waiting in the corridor.',\n        vitals: 70,\n        postcards: cards(\n          'Night tide, and the dog slept on my boots. Thank you for letting him stay.',\n          'The hatch is glass again. I am back on the bridge.',\n          'Sore ribs. The dog forgives you.',\n          'They say the glass is out. I still duck the hatch.',\n        ),\n      },\n    ],\n    sites: [{ id: 'chest', name: 'Chest' }],\n    storyBefore: 'before-1',\n    storyAfter: 'after-1',\n    par: 1,\n    phases: [\n      phase('pools', 'Drain the glass-water.', 'clear', [pool(-1.6, 0.2), pool(0, -0.8), pool(1.6, 0.3)], '', 'Hold the drain in a pool until it is gone.'),\n      phase('shards', 'Four shards. Pull, do not yank.', 'clear', [shard(-1.6, 0.6), shard(-0.4, -0.5), shard(0.8, 0.7), shard(1.8, -0.4)], '', 'Forceps: grab, then pull slowly.'),\n      phase('stable', 'He is dropping. Stabiliser.', 'injected', [], 'dip', 'Charge the syringe into the band, then let go.'),\n      phase('stitch', 'Three lacerations.', 'clear', [wound(-1.8, -0.2), wound(0.1, 0.6), wound(1.5, -0.9)], '', 'Cross each cut with the suture.'),\n      phase('gel', 'Seal and close.', 'clear', [gel(-1.2, 1.1), gel(0.3, -1.3), gel(1.6, 0.9)], '', 'Paint gel on the raw skin.'),\n    ],\n  },\n  {\n    id: 'case:quiet-lump',\n    title: 'The Quiet Lump',\n    surgeon: 'Wren',\n    seconds: 270,\n    gift: 'none',\n    charges: 0,\n    colleague: false,\n    swap: false,\n    roll: false,\n    code: false,\n    rule: 'Scalpel along a guide, scanner on what is buried, laser on what should not be there.',\n    patients: [\n      {\n        name: 'Gwen Abara',\n        age: 34,\n        line: 'Trumpet player. An old graft scar, and a joke she has told twice.',\n        vitals: 85,\n        postcards: cards(\n          'Back on the trumpet. I played your name badly on purpose.',\n          'High C is back. The scar is just a scar.',\n          'I can hold a note. Do not ask for pretty.',\n          'They say I will play again. They say you looked very worried.',\n        ),\n      },\n    ],\n    sites: [{ id: 'abdomen', name: 'Abdomen' }],\n    storyBefore: 'before-2',\n    storyAfter: 'after-2',\n    par: 1,\n    phases: [\n      phase('incision', 'A long curve. Stay on the line.', 'clear', [curve(-3.2, 0, 3.4, 0.2, 0.45, '', 'long')], '', 'The scalpel follows the guide.'),\n      phase(\n        'lump',\n        'Find it. Cut around it. Lift it.',\n        'clear',\n        [\n          { kind: 'nodule', x: -1.6, z: 1.1, hidden: true },\n          { kind: 'nodule', x: 1.7, z: 1.2, hidden: true },\n          { kind: 'nodule', x: 1.5, z: -1.3, hidden: true },\n          { kind: 'mass', x: 0, z: -0.2, hidden: true, locked: true, tag: 'lump' },\n          curve(-0.7, -0.2, 0.7, -0.2, 0.55, 'lump', 'flinch'),\n        ],\n        '',\n        'Scan, then laser the nodules. The mass comes out with the forceps.',\n      ),\n      phase('close', 'Stitch and seal.', 'clear', [wound(-1.4, 0.4), wound(0.6, -1), gel(1.8, 0.5)], '', 'Suture, then gel.'),\n    ],\n  },\n  {\n    id: 'case:crosstalk',\n    title: 'Crosstalk',\n    surgeon: 'Wren',\n    seconds: 300,\n    gift: 'stillpoint',\n    charges: 2,\n    colleague: false,\n    swap: false,\n    roll: false,\n    code: true,\n    rule: 'Three sites keep bleeding while you are away. A flatline has a Code. Stillpoint slows the field.',\n    patients: [\n      {\n        name: 'Hal Minsky',\n        age: 58,\n        line: 'Bus driver. Crash on Breakwater Road. He still has the route in his head.',\n        vitals: 60,\n        postcards: cards(\n          'Route 4 is mine again. I waved at the hospital on the way past.',\n          'Both lungs, both hands, one bus. We are even.',\n          'The arm works. The route can wait a week.',\n          'They say I will drive. They did not say when.',\n        ),\n      },\n    ],\n    sites: [\n      { id: 'liver', name: 'Liver' },\n      { id: 'lung', name: 'Lung' },\n      { id: 'arm', name: 'Arm' },\n    ],\n    storyBefore: 'before-3',\n    storyAfter: 'after-3',\n    par: 1,\n    phases: [\n      phase(\n        'triage',\n        'Three sites. The ones you leave keep bleeding.',\n        'clear',\n        [pool(-1.2, 0.4, 0), wound(0.4, -0.6, 0), pool(-1, 0.5, 1), wound(0.5, -0.5, 1), pool(-0.8, 0.3, 2), wound(0.6, -0.4, 2)],\n        '',\n        'Switch sites. Do not let one wait too long.',\n      ),\n      phase('code', 'Flatline. Paddles in the green.', 'code', [], 'flatline', 'Both paddles while the band is green. Two tries.'),\n      phase(\n        'still',\n        'Three arteries. There is no time. There is Stillpoint.',\n        'clear',\n        [\n          { kind: 'bleeder', x: -0.4, z: 0.2, site: 0 },\n          { kind: 'bleeder', x: 0.2, z: -0.3, site: 1 },\n          { kind: 'bleeder', x: 0.8, z: 0.4, site: 2 },\n        ],\n        '',\n        'Three beats on the line. The field slows. Your hands do not.',\n      ),\n      phase('close', 'Close every site.', 'clear', [wound(-1, 0.8, 0), gel(1.2, 0.6, 1), gel(0.2, -0.8, 2)], '', 'Finish the work you left.'),\n    ],\n  },\n  {\n    id: 'case:it-moves',\n    title: 'It Moves',\n    surgeon: 'Wren',\n    seconds: 330,\n    gift: 'stillpoint',\n    charges: 2,\n    colleague: false,\n    swap: false,\n    roll: false,\n    code: true,\n    rule: 'Lull nuzzles, then a cocoon. The Matron only takes a binder dose while she yawns.',\n    patients: [\n      {\n        name: 'Gwen Abara',\n        age: 34,\n        line: 'Back, and the scar is moving. She asked for her trumpet before they put her under.',\n        vitals: 75,\n        postcards: cards(\n          'I felt it stop. That is the whole review.',\n          'The scar is quiet. I slept.',\n          'Hurts less than yesterday, which is a low bar.',\n          'They say it was a twitch. I say you were right.',\n        ),\n      },\n    ],\n    sites: [{ id: 'abdomen', name: 'Abdomen' }],\n    storyBefore: 'before-4',\n    storyAfter: 'after-4',\n    par: 1,\n    phases: [\n      phase('reopen', 'Reopen the scar.', 'clear', [curve(-1.4, 0.2, 1.4, 0, 0.2)], '', 'Same line as last time. She remembers it.'),\n      phase(\n        'lulls',\n        'They are quiet, and that is the bad sign.',\n        'clear',\n        [\n          { kind: 'lull', x: -1.5, z: 0.4 },\n          { kind: 'lull', x: 0.2, z: 1 },\n          { kind: 'lull', x: 1.5, z: -0.3 },\n          { kind: 'matron', x: 0, z: -0.8 },\n        ],\n        '',\n        'Laser a Lull. Forceps on the cocoon. Binder in the yawn.',\n      ),\n      phase('close', 'Close her again.', 'clear', [wound(-0.8, 0.9), gel(1.1, 0.7)], '', 'Suture, then gel.'),\n    ],\n  },\n  {\n    id: 'case:struck-off',\n    title: 'Struck Off',\n    surgeon: 'Sabine',\n    seconds: 330,\n    gift: 'second',\n    charges: 2,\n    colleague: true,\n    swap: false,\n    roll: true,\n    code: true,\n    rule: 'A flap hides Solace. Split it with the scalpel. Laser only the smallest. Second Pulse holds the vitals.',\n    patients: [\n      {\n        name: 'Big Ana Duarte',\n        age: 47,\n        line: 'Stevedore. She went down on the deck and told her crew to keep the winch running.',\n        vitals: 70,\n        postcards: cards(\n          'Crew says I yelled at the winch from the stretcher. Sounds right.',\n          'Back on deck. Do not tell the winch I missed it.',\n          'Walking. The coat was warm. Tell her thanks.',\n          'They say the ship rolled. I say I did not.',\n        ),\n      },\n    ],\n    sites: [{ id: 'deck', name: 'Deck table' }],\n    storyBefore: 'before-5',\n    storyAfter: 'after-5',\n    par: 1,\n    phases: [\n      phase(\n        'cluster',\n        'Solace on the vessel. It likes the warmth. Do not give it the laser yet.',\n        'clear',\n        [{ kind: 'solace', x: 0, z: 0.2, gen: 1 }],\n        '',\n        'A long scalpel stroke splits it. Laser the little ones.',\n      ),\n      phase(\n        'mother',\n        'The storm hits. Mother Solace is under the flap.',\n        'clear',\n        [\n          { kind: 'flap', x: 0, z: -0.2, tag: 'lid' },\n          { kind: 'solace', x: 0.1, z: -0.15, gen: 1, tag: 'under:lid' },\n        ],\n        '',\n        'Hold the flap. Second Pulse: three beats, then vitals cannot fall.',\n      ),\n      phase('close', 'Close, even while the deck rolls.', 'clear', [wound(-1, 0.8), gel(1.2, 0.5)], '', 'The roll is the ship, not your hands.'),\n    ],\n  },\n  {\n    id: 'case:reverie',\n    title: 'Reverie',\n    surgeon: 'Wren',\n    seconds: 360,\n    gift: 'stillpoint',\n    charges: 2,\n    colleague: true,\n    swap: true,\n    roll: false,\n    code: true,\n    rule: 'Reverie hides until the scanner. Laser brings it up, then it sinks. Two surgeons can Consult.',\n    patients: [\n      {\n        name: 'Bram Achterberg',\n        age: 60,\n        line: 'Chief of surgery. He opened his own collar and showed the graft.',\n        vitals: 65,\n        postcards: cards(\n          'I signed the trials. You did not. That is the difference that matters.',\n          'The files are on your desk. Read them angry.',\n          'I am alive enough to be ashamed. Good.',\n          'They will ask for a second opinion. Give them yours.',\n        ),\n      },\n    ],\n    sites: [\n      { id: 'chest', name: 'Chest' },\n      { id: 'abdomen', name: 'Abdomen' },\n    ],\n    storyBefore: 'before-6',\n    storyAfter: 'after-6',\n    par: 1,\n    phases: [\n      phase(\n        'open',\n        'Two incisions. Two sites.',\n        'clear',\n        [curve(-1.2, 0.3, 1.2, 0.2, 0.15, '', ''), curve(-1, -0.2, 1, 0, 0.1, '', '')],\n        '',\n        'One guide on each site.',\n      ),\n      phase(\n        'hunt',\n        'Scan. The decoys pop. The real one keeps the beat.',\n        'clear',\n        [\n          { kind: 'flap', x: -0.2, z: 0.1, tag: 'heart' },\n          { kind: 'reverie', x: 0.15, z: 0.05, tag: 'under:heart' },\n          { kind: 'decoy', x: -1.4, z: 0.8 },\n          { kind: 'decoy', x: 1.3, z: -0.7 },\n        ],\n        '',\n        'Scan, burn while it is up, scan again when it sinks.',\n      ),\n      phase('close', 'Close both sites.', 'clear', [wound(-1, 0.9, 0), wound(-0.6, -0.8, 1), gel(1.2, 0.4, 0)], '', 'He is still the chief. He is also the patient.'),\n    ],\n  },\n  {\n    id: 'case:gala-night',\n    title: 'Gala Night',\n    surgeon: 'Wren',\n    seconds: 390,\n    gift: 'second',\n    charges: 2,\n    colleague: true,\n    swap: true,\n    roll: false,\n    code: true,\n    rule: 'Balm lacquer blocks the suture and the drain. Gel clears a cell. Two binder doses kill the node.',\n    patients: [\n      {\n        name: 'Maris Quell',\n        age: 51,\n        line: 'Donor. She came for the speech and stayed for the floor.',\n        vitals: 80,\n        postcards: cards(\n          'I have cancelled the pledge. Spend it on gloves.',\n          'Awake, and poorer in the useful way.',\n          'The wing can wait. I cannot.',\n          'They say it was the wine. It was not the wine.',\n        ),\n      },\n      {\n        name: 'Owen Peck',\n        age: 44,\n        line: 'Donor. He asked if the chandelier was supposed to do that.',\n        vitals: 80,\n        postcards: cards(\n          'Tell the band they may finish the song. I will be sitting.',\n          'Table B owes you a quiet year.',\n          'Walking. Not dancing. Do not push it.',\n          'I remember the screen going dark. Then you.',\n        ),\n      },\n      {\n        name: 'Safiya Lange',\n        age: 39,\n        line: 'Donor. She was mid-toast when her hands stopped being hers.',\n        vitals: 80,\n        postcards: cards(\n          'The toast can be finished later. The point of it changed.',\n          'Three tables, three of us, one pair of hands that mattered.',\n          'I can hold a glass. I will not raise it to him.',\n          'They say we fainted. We fell. There is a difference.',\n        ),\n      },\n    ],\n    sites: [\n      { id: 'a', name: 'Table A' },\n      { id: 'b', name: 'Table B' },\n      { id: 'c', name: 'Table C' },\n    ],\n    storyBefore: 'before-7',\n    storyAfter: 'after-7',\n    par: 1,\n    phases: [\n      phase(\n        'nodes',\n        'A node on every table. The film spreads from it.',\n        'clear',\n        [\n          { kind: 'balmNode', x: 0, z: 0, site: 0, patient: 0 },\n          { kind: 'balmNode', x: 0.2, z: 0.1, site: 1, patient: 1 },\n          { kind: 'balmNode', x: -0.2, z: -0.1, site: 2, patient: 2 },\n        ],\n        '',\n        'Two binder doses. The film fades. Gel any cell that is still in the way.',\n      ),\n      phase(\n        'race',\n        'Now the bleeding. Losing any of them loses the room.',\n        'clear',\n        [pool(-1, 0.4, 0, 0), wound(0.3, -0.5, 0, 0), pool(-0.8, 0.3, 1, 1), wound(0.4, -0.4, 1, 1), pool(-0.6, 0.2, 2, 2), wound(0.5, -0.3, 2, 2)],\n        '',\n        'One vitals bar each. A Code is allowed once a patient.',\n      ),\n      phase('seal', 'Seal all three and get off the floor.', 'clear', [gel(1, 0.6, 0, 0), gel(0.8, 0.5, 1, 1), gel(0.6, 0.4, 2, 2)], '', 'Gel, then leave the gala to the speech.'),\n    ],\n  },\n  {\n    id: 'case:mercy',\n    title: 'Mercy',\n    surgeon: 'Wren',\n    seconds: 480,\n    gift: 'stillpoint',\n    charges: 3,\n    colleague: true,\n    swap: true,\n    roll: false,\n    code: true,\n    rule: 'Mercy has three phases: Anesthesia, The Kindness, Last Rites. Every tool is on the table.',\n    patients: [\n      {\n        name: 'Lucan Voss',\n        age: 50,\n        line: 'He built Halcyon. Tonight he is the emergency he sold.',\n        vitals: 100,\n        postcards: cards(\n          'You saved me. That is the one thing I could never have sold.',\n          'I woke in cuffs. The heart is mine again. The rest is the court.',\n          'Alive. Unhappy about the company. Correct, on both.',\n          'They will say you hesitated. I was awake for the part where you did not.',\n        ),\n      },\n    ],\n    sites: [{ id: 'heart', name: 'Heart' }],\n    storyBefore: 'before-8',\n    storyAfter: 'after-8',\n    par: 1,\n    phases: [\n      phase('open', 'Open. He does not get a speech.', 'clear', [curve(-1.3, 0.4, 1.3, 0.3, 0.12)], '', 'A short guide, then her.'),\n      phase('mercy-motes', 'Anesthesia. Six motes, then she is open.', 'clear', motes(), '', 'Laser each mote. Binder on the three points when they show.'),\n      phase('mercy-kindness', 'The Kindness. She stops the heart.', 'code', [], 'flatline', 'A Code. Land it. It does not spend him.'),\n      phase('mercy-rakes', 'Three cuts. Close them.', 'clear', [wound(-1.6, 0.2), wound(0, -0.6), wound(1.4, 0.4)], '', 'Suture all three.'),\n      phase('mercy-kindness-2', 'She does it again.', 'code', [], 'flatline', 'Same band. Same two tries.'),\n      phase('mercy-rakes-2', 'Three more.', 'clear', [wound(-1.4, -0.3), wound(0.2, 0.7), wound(1.5, -0.5)], '', 'Close them before she burrows.'),\n      phase('mercy-rites', 'Last Rites. The line moves with the heart.', 'clear', [curve(-1.2, 0, 1.2, 0.15, 0.08, '', 'moving')], '', 'Follow the guide. It drifts.'),\n      phase(\n        'mercy-tendrils',\n        'Five tendrils. All of them out, or they grab back.',\n        'clear',\n        [-0.8, -0.4, 0, 0.4, 0.8].map((x) => ({ kind: 'tendril' as const, x, z: 0.25 })),\n        '',\n        'Forceps. Do not leave one behind.',\n      ),\n      phase(\n        'mercy-bind',\n        'A Gift, then three doses inside it.',\n        'clear',\n        [-0.7, 0, 0.7].map((x) => ({ kind: 'binder' as const, x, z: -0.3, doseNeed: 1, tag: 'gift' })),\n        '',\n        'The doses only land while the Gift is up.',\n      ),\n      phase('mercy-final', 'Restart the heart.', 'code', [], 'flatline', 'Every paddle. Then we are done.'),\n    ],\n  },\n  {\n    id: 'case:gala-shift',\n    title: 'The Gala Shift',\n    surgeon: 'Wren',\n    seconds: 270,\n    gift: 'stillpoint',\n    charges: 2,\n    colleague: false,\n    swap: false,\n    roll: false,\n    code: true,\n    rule: 'A short shared operation: wounds, shards, a Lull, a Balm node, and a flap.',\n    patients: [\n      {\n        name: 'Edda Marlow',\n        age: 46,\n        line: 'Guest. She came down the stairs and did not reach the bottom.',\n        vitals: 78,\n        postcards: cards(\n          'I have the stairs in me now. I will use the lift.',\n          'Home. The shoes did not survive. I did.',\n          'Bruised, closed, grateful.',\n          'They say it was a faint. The stairs disagree.',\n        ),\n      },\n      {\n        name: 'Chris Pinto',\n        age: 33,\n        line: 'Guest. He was holding the door for everyone else.',\n        vitals: 78,\n        postcards: cards(\n          'Door is still open. I am on the other side of it.',\n          'Thanks for the hands. I will get the next one.',\n          'Walking out under my own name.',\n          'Sore. Standing. That will do.',\n        ),\n      },\n    ],\n    sites: [\n      { id: 'left', name: 'Left table' },\n      { id: 'right', name: 'Right table' },\n    ],\n    storyBefore: 'gala-brief',\n    storyAfter: 'gala-after',\n    par: 1,\n    phases: [\n      phase(\n        'open',\n        'Two tables. A flap, a shard, a Lull.',\n        'clear',\n        [\n          { kind: 'flap', x: -0.3, z: 0.2, site: 0, patient: 0, tag: 'cloth' },\n          { kind: 'shard', x: 0, z: 0.15, site: 0, patient: 0, tag: 'under:cloth' },\n          shard(1.2, -0.4, 1, 1),\n          { kind: 'lull', x: -1.2, z: -0.5, site: 0, patient: 0 },\n        ],\n        '',\n        'Lift, pull, burn, pull the cocoon.',\n      ),\n      phase(\n        'film',\n        'Balm on the right-hand table.',\n        'clear',\n        [{ kind: 'balmNode', x: 0.2, z: 0, site: 1, patient: 1 }],\n        '',\n        'Two doses. Wait for the film to fade.',\n      ),\n      phase('close', 'Close them both.', 'clear', [wound(-1, 0.7, 0, 0), wound(0.2, -0.6, 1, 1), gel(1.3, 0.6, 0, 0), gel(1.1, 0.5, 1, 1)], '', 'Neither one gets to leave unfinished.'),\n    ],\n  },\n];\n\n/** The case with this id, or a thrown error when the board names a case we do not have. */\nexport function caseById(id: string): CaseDef {\n  const found = CASES.find((item) => item.id === id);\n  if (!found) throw new Error(`Unknown case ${id}`);\n  return found;\n}\n\n/** Story cases, in campaign order. The session case is not one of them. */\nexport function storyCases(): CaseDef[] {\n  return CASES.filter((item) => item.id !== 'case:gala-shift');\n}\n","old_string":""}},{"type":"tool_use","id":"call-4d2a282a-b042-4463-a9df-4bb86e0ffa74-35","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/bot.ts","new_string":"/**\n * @file The operation bot. It reads the live field and writes the same hand record a pad would.\n * It never sets score, vitals, or `done` itself. `runBot` stops on a win, a loss, or ten seconds with no change.\n */\nimport { codeBand } from './body';\nimport { stepOp } from './step';\nimport { rightTool } from './table';\nimport type { Hand, Op, Seat, Target } from './types';\nimport { flapOpen, idleHand } from './world';\n\n/** Tool ids in radial order, matching `TOOLS`. */\nconst INDEX: Record<string, number> = {\n  scalpel: 0,\n  forceps: 1,\n  suture: 2,\n  drain: 3,\n  laser: 4,\n  syringe: 5,\n  gel: 6,\n  scanner: 7,\n};\n\n/** Hands for every seat, from the operation as it stands before this step. */\nexport function botHands(op: Op): Hand[] {\n  return op.seats.map((seat) => botHand(op, seat));\n}\n\n/** Play until the operation ends. A frozen field for 600 ticks is a stall, not a win. */\nexport function runBot(op: Op, cap = 60 * 60 * 12): Op {\n  let last = '';\n  let same = 0;\n  for (let i = 0; i < cap && op.status === 'playing'; i++) {\n    const sig = signature(op);\n    if (sig === last) same += 1;\n    else {\n      same = 0;\n      last = sig;\n    }\n    if (same > 600) {\n      op.status = 'lost';\n      op.fail = `stalled ${sig.slice(0, 180)}`;\n      break;\n    }\n    stepOp(op, botHands(op));\n  }\n  return op;\n}\n\n/** What changed, so a slow burn does not look like a stall. */\nfunction signature(op: Op): string {\n  const bits = op.targets\n    .filter((target) => !target.done)\n    .map((target) => `${target.id}:${target.cut}:${target.stitches}:${Math.round(target.volume * 5)}:${Math.round(target.burn * 5)}:${Math.round(target.laserDamage * 5)}:${target.dose}:${target.hidden ? 1 : 0}:${target.stroke.toFixed(1)}`)\n    .join(',');\n  return `${op.phase}:${op.code ? 'c' : ''}:${op.injected ? 1 : 0}:${op.mercyKills}:${bits}`;\n}\n\n/** One surgeon's hand for this step. */\nfunction botHand(op: Op, seat: Seat): Hand {\n  const hand = idleHand(seat);\n  if (op.status !== 'playing') return hand;\n  if (op.code) {\n    hand.paddle = codeBand(op);\n    return hand;\n  }\n  if (seat.lock >= 0) {\n    hand.gift = op.tick === seat.lockBeat;\n    return hand;\n  }\n  const phase = op.phases[op.phase];\n  if (phase?.until === 'injected' && !op.injected) return inject(op, seat, hand);\n  if (phase?.until === 'code') return hand;\n  const target = pick(op, seat);\n  if (!target) {\n    const matron = op.targets.find((item) => !item.done && !item.optional && item.phase === op.phase && item.kind === 'matron');\n    if (matron) approach(hand, seat, matron.x, matron.z, op.balance.cursor);\n    return hand;\n  }\n  if (target.site !== seat.site) hand.site = target.site;\n  if (target.kind === 'binder' && target.tag === 'gift' && seat.giftLeft <= 0) {\n    hand.gift = seat.charges > 0;\n    return hand;\n  }\n  work(op, seat, hand, target);\n  return hand;\n}\n\n/** The next thing this seat should touch. Seats split the list so they do not grab the same shard. */\nfunction pick(op: Op, seat: Seat): Target | null {\n  const list = op.targets.filter((target) => open(op, target));\n  list.sort((a, b) => rank(a) - rank(b) || a.id - b.id);\n  if (list.length === 0) return null;\n  if (op.seats.length === 1) return list[0];\n  const mine = list.filter((_, index) => index % op.seats.length === seat.id);\n  return mine[0] ?? null;\n}\n\n/** Whether the bot is allowed to work this target right now. */\nfunction open(op: Op, target: Target): boolean {\n  if (target.done || target.optional || target.phase !== op.phase) return false;\n  if (target.under >= 0 && !flapOpen(op, target.under)) return false;\n  if (target.locked && !target.hidden) return false;\n  if (target.kind === 'matron' && !target.vulnerable) return false;\n  return true;\n}\n\n/** Lower runs first. A yawning Matron outranks the small ones. */\nfunction rank(target: Target): number {\n  if (target.kind === 'flap') return 0;\n  if (target.kind === 'matron' && target.vulnerable) return 1;\n  if (target.hidden) return 2;\n  if (target.kind === 'lull' || target.kind === 'bleeder' || target.kind === 'mote') return 3;\n  if (target.kind === 'pool') return 4;\n  if (target.kind === 'solace') return 5;\n  if (target.kind === 'balmNode') return 6;\n  if (target.kind === 'guide') return 7;\n  if (target.kind === 'nodule') return 8;\n  if (target.kind === 'wound') return 9;\n  if (target.kind === 'shard' || target.kind === 'mass' || target.kind === 'cocoon' || target.kind === 'tendril') return 10;\n  if (target.kind === 'binder') return 11;\n  if (target.kind === 'balmCell') return 12;\n  return 13;\n}\n\n/** Dispatch on the kind. The hand only aims, equips, and holds use. */\nfunction work(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  if (target.hidden) return scan(op, seat, hand, target);\n  if (target.kind === 'solace' && target.gen < 3) return split(op, seat, hand, target);\n  if (target.kind === 'guide') return cut(op, seat, hand, target);\n  if (target.kind === 'wound') return stitch(op, seat, hand, target);\n  if (target.kind === 'shard' || target.kind === 'mass' || target.kind === 'cocoon' || target.kind === 'tendril') return pull(op, seat, hand, target);\n  if (target.kind === 'flap') return pull(op, seat, hand, target);\n  if (target.kind === 'binder' || target.kind === 'matron') return bind(op, seat, hand, target);\n  if (target.kind === 'balmCell' || target.kind === 'abrasion' || target.kind === 'numb') return paint(op, seat, hand, target);\n  const tool = rightTool(target.kind);\n  if (tool === 'drain') return drain(op, seat, hand, target);\n  if (tool === 'laser') return burn(op, seat, hand, target);\n  if (tool === 'gel') return paint(op, seat, hand, target);\n  if (tool) hand.tool = INDEX[tool] ?? 0;\n}\n\n/** Step toward a point at `metres` per second, never past it. */\nfunction approach(hand: Hand, seat: Seat, x: number, z: number, metres: number): void {\n  const dx = x - seat.x;\n  const dz = z - seat.z;\n  const dist = Math.hypot(dx, dz);\n  const step = Math.max(0.5, metres) / 60;\n  if (dist <= step) {\n    hand.x = x;\n    hand.z = z;\n    return;\n  }\n  hand.x = seat.x + (dx / dist) * step;\n  hand.z = seat.z + (dz / dist) * step;\n}\n\n/** Follow the guide vertex the cut has reached. */\nfunction cut(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  const count = target.path.length / 2;\n  const index = Math.min(target.cut, Math.max(0, count - 1));\n  const x = target.path[index * 2] ?? target.x;\n  const z = target.path[index * 2 + 1] ?? target.z;\n  approach(hand, seat, x, z, op.balance.cursor);\n  hand.use = target.cut > 0 || Math.hypot(seat.x - x, seat.z - z) < 0.28;\n  hand.tool = 0;\n}\n\n/** Cross the wound once per stitch, offset to either side. */\nfunction stitch(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  const dx = target.x2 - target.x;\n  const dz = target.z2 - target.z;\n  const length = Math.max(0.5, Math.hypot(dx, dz));\n  const u = (target.stitches + 0.5) / Math.max(1, target.need);\n  const side = seat.sutureSide >= 0 ? -1 : 1;\n  const x = target.x + dx * u + (-dz / length) * 0.36 * side;\n  const z = target.z + dz * u + (dx / length) * 0.36 * side;\n  approach(hand, seat, x, z, op.balance.cursor);\n  hand.use = seat.sutureSide !== 0 || Math.hypot(seat.x - x, seat.z - z) < 0.2;\n  hand.tool = 2;\n}\n\n/** Grab, then back away slowly enough to stay CLEAN. */\nfunction pull(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  hand.tool = 1;\n  if (seat.hold === target.id) {\n    const dx = seat.x - target.ox || 1;\n    const dz = seat.z - target.oz;\n    const len = Math.hypot(dx, dz) || 1;\n    const step = 4 / 60;\n    hand.x = Math.max(-7, Math.min(7, seat.x + (dx / len) * step));\n    hand.z = Math.max(-4.5, Math.min(4.5, seat.z + (dz / len) * step));\n    hand.use = true;\n    return;\n  }\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < 0.48;\n}\n\n/** Sit on a pool. */\nfunction drain(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < 0.6;\n  hand.tool = 3;\n}\n\n/** Sit on something that burns. Let a hot laser cool. */\nfunction burn(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\n  hand.use = seat.laserCool <= 0 && Math.hypot(seat.x - target.x, seat.z - target.z) < 0.32;\n  hand.tool = 4;\n}\n\n/** A long stroke through Solace. Keep moving or the stroke never adds up. */\nfunction split(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  const span = Math.max(0.8, target.radius * 0.9);\n  const leg = Math.floor(op.tick / 18) % 2 === 0 ? -1 : 1;\n  approach(hand, seat, target.x + leg * span, target.z, op.balance.cursor);\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) <= target.radius + 0.25;\n  hand.tool = 0;\n}\n\n/** Hold the syringe on a binder point or a yawning Matron. */\nfunction bind(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < 0.48;\n  hand.tool = 5;\n}\n\n/** Paint gel. Balm cells clear on contact, so this is also how the film comes off. */\nfunction paint(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < op.balance.gel * 0.75;\n  hand.tool = 6;\n}\n\n/** Stand on a buried target and ping. Everything in range comes up. */\nfunction scan(op: Op, seat: Seat, hand: Hand, target: Target): void {\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < 0.4;\n  hand.tool = 7;\n}\n\n/** Charge the stabiliser in clear tissue, then let go inside the band. */\nfunction inject(op: Op, seat: Seat, hand: Hand): Hand {\n  approach(hand, seat, 0, 2.2, op.balance.cursor);\n  const there = Math.hypot(seat.x, seat.z - 2.2) < 0.25;\n  hand.tool = 5;\n  hand.use = there && seat.syringeCd <= 0 && seat.syringe < 0.86;\n  return hand;\n}\n","old_string":""}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":322,"output_tokens":10622,"cache_read_input_tokens":122624,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"6cdc7874-11c2-444a-a76a-7df5fc7c93a1"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-4d2a282a-b042-4463-a9df-4bb86e0ffa74-34","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"/**\\n * @file The eight story operations, plus the session case. Each case adds one rule from the plan: tools, sites,\\n * a strain, a gift. Numbers are metres and seconds. Postcards are the patient's own words, one line per rank.\\n */\\nimport type { CaseDef, PhaseDef, Postcards, Spawn } from './types';\\n\\n/** Four postcard lines. */\\nfunction cards(s: string, a: string, b: string, c: string): Postcards {\\n  return { S: s, A: a, B: b, C: c };\\n}\\n\\n/** A phase row. */\\nfunction phase(id: string, hint: string, until: PhaseDef['until'], spawn: Spawn[], onEnter = '', teach = ''): PhaseDef {\\n  return { id, hint, until, spawn, onEnter, teach };\\n}\\n\\n/** A pool small enough that triage still has a clock. */\\nfunction pool(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'pool', x, z, site, patient, volume: 1.15, bleed: 0.22 };\\n}\\n\\n/** A laceration two stitches long. */\\nfunction wound(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'wound', x, z, x2: x + 1.15, z2: z, site, patient, need: 2 };\\n}\\n\\n/** A shard of glass or graft. */\\nfunction shard(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'shard', x, z, site, patient };\\n}\\n\\n/** Gel on raw skin. */\\nfunction gel(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'abrasion', x, z, site, patient, coverNeed: 8 };\\n}\\n\\n/** A guide the scalpel can follow. `bow` bends it off the straight line. */\\nfunction curve(x0: number, z0: number, x1: number, z1: number, bow: number, unlock = '', tag = ''): Spawn {\\n  const len = Math.hypot(x1 - x0, z1 - z0);\\n  const steps = Math.max(1, Math.round(len / 0.32));\\n  const path: number[] = [];\\n  for (let i = 0; i <= steps; i++) {\\n    const u = i / steps;\\n    path.push(x0 + (x1 - x0) * u, z0 + (z1 - z0) * u + Math.sin(u * Math.PI) * bow);\\n  }\\n  return { kind: 'guide', x: x0, z: z0, path, unlock, tag, spawnBleeders: tag === 'long' ? 2 : 0 };\\n}\\n\\n/** Six motes around the heart. */\\nfunction motes(): Spawn[] {\\n  const out: Spawn[] = [];\\n  for (let i = 0; i < 6; i++) {\\n    const angle = (i / 6) * Math.PI * 2;\\n    out.push({ kind: 'mote', x: Math.cos(angle) * 1.15, z: Math.sin(angle) * 0.7 });\\n  }\\n  return out;\\n}\\n\\n/** The eight story cases, in order, then the session case. */\\nexport const CASES: readonly CaseDef[] = [\\n  {\\n    id: 'case:first-cut',\\n    title: 'First Cut',\\n    surgeon: 'Wren',\\n    seconds: 240,\\n    gift: 'none',\\n    charges: 0,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: false,\\n    rule: 'Cursor, radial, drain, forceps, suture, syringe, and gel.',\\n    patients: [\\n      {\\n        name: 'Tomás Reyes',\\n        age: 52,\\n        line: 'Harbor pilot. Glass from a deck hatch. His dog is waiting in the corridor.',\\n        vitals: 70,\\n        postcards: cards(\\n          'Night tide, and the dog slept on my boots. Thank you for letting him stay.',\\n          'The hatch is glass again. I am back on the bridge.',\\n          'Sore ribs. The dog forgives you.',\\n          'They say the glass is out. I still duck the hatch.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'chest', name: 'Chest' }],\\n    storyBefore: 'before-1',\\n    storyAfter: 'after-1',\\n    par: 1,\\n    phases: [\\n      phase('pools', 'Drain the glass-water.', 'clear', [pool(-1.6, 0.2), pool(0, -0.8), pool(1.6, 0.3)], '', 'Hold the drain in a pool until it is gone.'),\\n      phase('shards', 'Four shards. Pull, do not yank.', 'clear', [shard(-1.6, 0.6), shard(-0.4, -0.5), shard(0.8, 0.7), shard(1.8, -0.4)], '', 'Forceps: grab, then pull slowly.'),\\n      phase('stable', 'He is dropping. Stabiliser.', 'injected', [], 'dip', 'Charge the syringe into the band, then let go.'),\\n      phase('stitch', 'Three lacerations.', 'clear', [wound(-1.8, -0.2), wound(0.1, 0.6), wound(1.5, -0.9)], '', 'Cross each cut with the suture.'),\\n      phase('gel', 'Seal and close.', 'clear', [gel(-1.2, 1.1), gel(0.3, -1.3), gel(1.6, 0.9)], '', 'Paint gel on the raw skin.'),\\n    ],\\n  },\\n  {\\n    id: 'case:quiet-lump',\\n    title: 'The Quiet Lump',\\n    surgeon: 'Wren',\\n    seconds: 270,\\n    gift: 'none',\\n    charges: 0,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: false,\\n    rule: 'Scalpel along a guide, scanner on what is buried, laser on what should not be there.',\\n    patients: [\\n      {\\n        name: 'Gwen Abara',\\n        age: 34,\\n        line: 'Trumpet player. An old graft scar, and a joke she has told twice.',\\n        vitals: 85,\\n        postcards: cards(\\n          'Back on the trumpet. I played your name badly on purpose.',\\n          'High C is back. The scar is just a scar.',\\n          'I can hold a note. Do not ask for pretty.',\\n          'They say I will play again. They say you looked very worried.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'abdomen', name: 'Abdomen' }],\\n    storyBefore: 'before-2',\\n    storyAfter: 'after-2',\\n    par: 1,\\n    phases: [\\n      phase('incision', 'A long curve. Stay on the line.', 'clear', [curve(-3.2, 0, 3.4, 0.2, 0.45, '', 'long')], '', 'The scalpel follows the guide.'),\\n      phase(\\n        'lump',\\n        'Find it. Cut around it. Lift it.',\\n        'clear',\\n        [\\n          { kind: 'nodule', x: -1.6, z: 1.1, hidden: true },\\n          { kind: 'nodule', x: 1.7, z: 1.2, hidden: true },\\n          { kind: 'nodule', x: 1.5, z: -1.3, hidden: true },\\n          { kind: 'mass', x: 0, z: -0.2, hidden: true, locked: true, tag: 'lump' },\\n          curve(-0.7, -0.2, 0.7, -0.2, 0.55, 'lump', 'flinch'),\\n        ],\\n        '',\\n        'Scan, then laser the nodules. The mass comes out with the forceps.',\\n      ),\\n      phase('close', 'Stitch and seal.', 'clear', [wound(-1.4, 0.4), wound(0.6, -1), gel(1.8, 0.5)], '', 'Suture, then gel.'),\\n    ],\\n  },\\n  {\\n    id: 'case:crosstalk',\\n    title: 'Crosstalk',\\n    surgeon: 'Wren',\\n    seconds: 300,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: true,\\n    rule: 'Three sites keep bleeding while you are away. A flatline has a Code. Stillpoint slows the field.',\\n    patients: [\\n      {\\n        name: 'Hal Minsky',\\n        age: 58,\\n        line: 'Bus driver. Crash on Breakwater Road. He still has the route in his head.',\\n        vitals: 60,\\n        postcards: cards(\\n          'Route 4 is mine again. I waved at the hospital on the way past.',\\n          'Both lungs, both hands, one bus. We are even.',\\n          'The arm works. The route can wait a week.',\\n          'They say I will drive. They did not say when.',\\n        ),\\n      },\\n    ],\\n    sites: [\\n      { id: 'liver', name: 'Liver' },\\n      { id: 'lung', name: 'Lung' },\\n      { id: 'arm', name: 'Arm' },\\n    ],\\n    storyBefore: 'before-3',\\n    storyAfter: 'after-3',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'triage',\\n        'Three sites. The ones you leave keep bleeding.',\\n        'clear',\\n        [pool(-1.2, 0.4, 0), wound(0.4, -0.6, 0), pool(-1, 0.5, 1), wound(0.5, -0.5, 1), pool(-0.8, 0.3, 2), wound(0.6, -0.4, 2)],\\n        '',\\n        'Switch sites. Do not let one wait too long.',\\n      ),\\n      phase('code', 'Flatline. Paddles in the green.', 'code', [], 'flatline', 'Both paddles while the band is green. Two tries.'),\\n      phase(\\n        'still',\\n        'Three arteries. There is no time. There is Stillpoint.',\\n        'clear',\\n        [\\n          { kind: 'bleeder', x: -0.4, z: 0.2, site: 0 },\\n          { kind: 'bleeder', x: 0.2, z: -0.3, site: 1 },\\n          { kind: 'bleeder', x: 0.8, z: 0.4, site: 2 },\\n        ],\\n        '',\\n        'Three beats on the line. The field slows. Your hands do not.',\\n      ),\\n      phase('close', 'Close every site.', 'clear', [wound(-1, 0.8, 0), gel(1.2, 0.6, 1), gel(0.2, -0.8, 2)], '', 'Finish the work you left.'),\\n    ],\\n  },\\n  {\\n    id: 'case:it-moves',\\n    title: 'It Moves',\\n    surgeon: 'Wren',\\n    seconds: 330,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: true,\\n    rule: 'Lull nuzzles, then a cocoon. The Matron only takes a binder dose while she yawns.',\\n    patients: [\\n      {\\n        name: 'Gwen Abara',\\n        age: 34,\\n        line: 'Back, and the scar is moving. She asked for her trumpet before they put her under.',\\n        vitals: 75,\\n        postcards: cards(\\n          'I felt it stop. That is the whole review.',\\n          'The scar is quiet. I slept.',\\n          'Hurts less than yesterday, which is a low bar.',\\n          'They say it was a twitch. I say you were right.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'abdomen', name: 'Abdomen' }],\\n    storyBefore: 'before-4',\\n    storyAfter: 'after-4',\\n    par: 1,\\n    phases: [\\n      phase('reopen', 'Reopen the scar.', 'clear', [curve(-1.4, 0.2, 1.4, 0, 0.2)], '', 'Same line as last time. She remembers it.'),\\n      phase(\\n        'lulls',\\n        'They are quiet, and that is the bad sign.',\\n        'clear',\\n        [\\n          { kind: 'lull', x: -1.5, z: 0.4 },\\n          { kind: 'lull', x: 0.2, z: 1 },\\n          { kind: 'lull', x: 1.5, z: -0.3 },\\n          { kind: 'matron', x: 0, z: -0.8 },\\n        ],\\n        '',\\n        'Laser a Lull. Forceps on the cocoon. Binder in the yawn.',\\n      ),\\n      phase('close', 'Close her again.', 'clear', [wound(-0.8, 0.9), gel(1.1, 0.7)], '', 'Suture, then gel.'),\\n    ],\\n  },\\n  {\\n    id: 'case:struck-off',\\n    title: 'Struck Off',\\n    surgeon: 'Sabine',\\n    seconds: 330,\\n    gift: 'second',\\n    charges: 2,\\n    colleague: true,\\n    swap: false,\\n    roll: true,\\n    code: true,\\n    rule: 'A flap hides Solace. Split it with the scalpel. Laser only the smallest. Second Pulse holds the vitals.',\\n    patients: [\\n      {\\n        name: 'Big Ana Duarte',\\n        age: 47,\\n        line: 'Stevedore. She went down on the deck and told her crew to keep the winch running.',\\n        vitals: 70,\\n        postcards: cards(\\n          'Crew says I yelled at the winch from the stretcher. Sounds right.',\\n          'Back on deck. Do not tell the winch I missed it.',\\n          'Walking. The coat was warm. Tell her thanks.',\\n          'They say the ship rolled. I say I did not.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'deck', name: 'Deck table' }],\\n    storyBefore: 'before-5',\\n    storyAfter: 'after-5',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'cluster',\\n        'Solace on the vessel. It likes the warmth. Do not give it the laser yet.',\\n        'clear',\\n        [{ kind: 'solace', x: 0, z: 0.2, gen: 1 }],\\n        '',\\n        'A long scalpel stroke splits it. Laser the little ones.',\\n      ),\\n      phase(\\n        'mother',\\n        'The storm hits. Mother Solace is under the flap.',\\n        'clear',\\n        [\\n          { kind: 'flap', x: 0, z: -0.2, tag: 'lid' },\\n          { kind: 'solace', x: 0.1, z: -0.15, gen: 1, tag: 'under:lid' },\\n        ],\\n        '',\\n        'Hold the flap. Second Pulse: three beats, then vitals cannot fall.',\\n      ),\\n      phase('close', 'Close, even while the deck rolls.', 'clear', [wound(-1, 0.8), gel(1.2, 0.5)], '', 'The roll is the ship, not your hands.'),\\n    ],\\n  },\\n  {\\n    id: 'case:reverie',\\n    title: 'Reverie',\\n    surgeon: 'Wren',\\n    seconds: 360,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: true,\\n    swap: true,\\n    roll: false,\\n    code: true,\\n    rule: 'Reverie hides until the scanner. Laser brings it up, then it sinks. Two surgeons can Consult.',\\n    patients: [\\n      {\\n        name: 'Bram Achterberg',\\n        age: 60,\\n        line: 'Chief of surgery. He opened his own collar and showed the graft.',\\n        vitals: 65,\\n        postcards: cards(\\n          'I signed the trials. You did not. That is the difference that matters.',\\n          'The files are on your desk. Read them angry.',\\n          'I am alive enough to be ashamed. Good.',\\n          'They will ask for a second opinion. Give them yours.',\\n        ),\\n      },\\n    ],\\n    sites: [\\n      { id: 'chest', name: 'Chest' },\\n      { id: 'abdomen', name: 'Abdomen' },\\n    ],\\n    storyBefore: 'before-6',\\n    storyAfter: 'after-6',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'open',\\n        'Two incisions. Two sites.',\\n        'clear',\\n        [curve(-1.2, 0.3, 1.2, 0.2, 0.15, '', ''), curve(-1, -0.2, 1, 0, 0.1, '', '')],\\n        '',\\n        'One guide on each site.',\\n      ),\\n      phase(\\n        'hunt',\\n        'Scan. The decoys pop. The real one keeps the beat.',\\n        'clear',\\n        [\\n          { kind: 'flap', x: -0.2, z: 0.1, tag: 'heart' },\\n          { kind: 'reverie', x: 0.15, z: 0.05, tag: 'under:heart' },\\n          { kind: 'decoy', x: -1.4, z: 0.8 },\\n          { kind: 'decoy', x: 1.3, z: -0.7 },\\n        ],\\n        '',\\n        'Scan, burn while it is up, scan again when it sinks.',\\n      ),\\n      phase('close', 'Close both sites.', 'clear', [wound(-1, 0.9, 0), wound(-0.6, -0.8, 1), gel(1.2, 0.4, 0)], '', 'He is still the chief. He is also the patient.'),\\n    ],\\n  },\\n  {\\n    id: 'case:gala-night',\\n    title: 'Gala Night',\\n    surgeon: 'Wren',\\n    seconds: 390,\\n    gift: 'second',\\n    charges: 2,\\n    colleague: true,\\n    swap: true,\\n    roll: false,\\n    code: true,\\n    rule: 'Balm lacquer blocks the suture and the drain. Gel clears a cell. Two binder doses kill the node.',\\n    patients: [\\n      {\\n        name: 'Maris Quell',\\n        age: 51,\\n        line: 'Donor. She came for the speech and stayed for the floor.',\\n        vitals: 80,\\n        postcards: cards(\\n          'I have cancelled the pledge. Spend it on gloves.',\\n          'Awake, and poorer in the useful way.',\\n          'The wing can wait. I cannot.',\\n          'They say it was the wine. It was not the wine.',\\n        ),\\n      },\\n      {\\n        name: 'Owen Peck',\\n        age: 44,\\n        line: 'Donor. He asked if the chandelier was supposed to do that.',\\n        vitals: 80,\\n        postcards: cards(\\n          'Tell the band they may finish the song. I will be sitting.',\\n          'Table B owes you a quiet year.',\\n          'Walking. Not dancing. Do not push it.',\\n          'I remember the screen going dark. Then you.',\\n        ),\\n      },\\n      {\\n        name: 'Safiya Lange',\\n        age: 39,\\n        line: 'Donor. She was mid-toast when her hands stopped being hers.',\\n        vitals: 80,\\n        postcards: cards(\\n          'The toast can be finished later. The point of it changed.',\\n          'Three tables, three of us, one pair of hands that mattered.',\\n          'I can hold a glass. I will not raise it to him.',\\n          'They say we fainted. We fell. There is a difference.',\\n        ),\\n      },\\n    ],\\n    sites: [\\n      { id: 'a', name: 'Table A' },\\n      { id: 'b', name: 'Table B' },\\n      { id: 'c', name: 'Table C' },\\n    ],\\n    storyBefore: 'before-7',\\n    storyAfter: 'after-7',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'nodes',\\n        'A node on every table. The film spreads from it.',\\n        'clear',\\n        [\\n          { kind: 'balmNode', x: 0, z: 0, site: 0, patient: 0 },\\n          { kind: 'balmNode', x: 0.2, z: 0.1, site: 1, patient: 1 },\\n          { kind: 'balmNode', x: -0.2, z: -0.1, site: 2, patient: 2 },\\n        ],\\n        '',\\n        'Two binder doses. The film fades. Gel any cell that is still in the way.',\\n      ),\\n      phase(\\n        'race',\\n        'Now the bleeding. Losing any of them loses the room.',\\n        'clear',\\n        [pool(-1, 0.4, 0, 0), wound(0.3, -0.5, 0, 0), pool(-0.8, 0.3, 1, 1), wound(0.4, -0.4, 1, 1), pool(-0.6, 0.2, 2, 2), wound(0.5, -0.3, 2, 2)],\\n        '',\\n        'One vitals bar each. A Code is allowed once a patient.',\\n      ),\\n      phase('seal', 'Seal all three and get off the floor.', 'clear', [gel(1, 0.6, 0, 0), gel(0.8, 0.5, 1, 1), gel(0.6, 0.4, 2, 2)], '', 'Gel, then leave the gala to the speech.'),\\n    ],\\n  },\\n  {\\n    id: 'case:mercy',\\n    title: 'Mercy',\\n    surgeon: 'Wren',\\n    seconds: 480,\\n    gift: 'stillpoint',\\n    charges: 3,\\n    colleague: true,\\n    swap: true,\\n    roll: false,\\n    code: true,\\n    rule: 'Mercy has three phases: Anesthesia, The Kindness, Last Rites. Every tool is on the table.',\\n    patients: [\\n      {\\n        name: 'Lucan Voss',\\n        age: 50,\\n        line: 'He built Halcyon. Tonight he is the emergency he sold.',\\n        vitals: 100,\\n        postcards: cards(\\n          'You saved me. That is the one thing I could never have sold.',\\n          'I woke in cuffs. The heart is mine again. The rest is the court.',\\n          'Alive. Unhappy about the company. Correct, on both.',\\n          'They will say you hesitated. I was awake for the part where you did not.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'heart', name: 'Heart' }],\\n    storyBefore: 'before-8',\\n    storyAfter: 'after-8',\\n    par: 1,\\n    phases: [\\n      phase('open', 'Open. He does not get a speech.', 'clear', [curve(-1.3, 0.4, 1.3, 0.3, 0.12)], '', 'A short guide, then her.'),\\n      phase('mercy-motes', 'Anesthesia. Six motes, then she is open.', 'clear', motes(), '', 'Laser each mote. Binder on the three points when they show.'),\\n      phase('mercy-kindness', 'The Kindness. She stops the heart.', 'code', [], 'flatline', 'A Code. Land it. It does not spend him.'),\\n      phase('mercy-rakes', 'Three cuts. Close them.', 'clear', [wound(-1.6, 0.2), wound(0, -0.6), wound(1.4, 0.4)], '', 'Suture all three.'),\\n      phase('mercy-kindness-2', 'She does it again.', 'code', [], 'flatline', 'Same band. Same two tries.'),\\n      phase('mercy-rakes-2', 'Three more.', 'clear', [wound(-1.4, -0.3), wound(0.2, 0.7), wound(1.5, -0.5)], '', 'Close them before she burrows.'),\\n      phase('mercy-rites', 'Last Rites. The line moves with the heart.', 'clear', [curve(-1.2, 0, 1.2, 0.15, 0.08, '', 'moving')], '', 'Follow the guide. It drifts.'),\\n      phase(\\n        'mercy-tendrils',\\n        'Five tendrils. All of them out, or they grab back.',\\n        'clear',\\n        [-0.8, -0.4, 0, 0.4, 0.8].map((x) => ({ kind: 'tendril' as const, x, z: 0.25 })),\\n        '',\\n        'Forceps. Do not leave one behind.',\\n      ),\\n      phase(\\n        'mercy-bind',\\n        'A Gift, then three doses inside it.',\\n        'clear',\\n        [-0.7, 0, 0.7].map((x) => ({ kind: 'binder' as const, x, z: -0.3, doseNeed: 1, tag: 'gift' })),\\n        '',\\n        'The doses only land while the Gift is up.',\\n      ),\\n      phase('mercy-final', 'Restart the heart.', 'code', [], 'flatline', 'Every paddle. Then we are done.'),\\n    ],\\n  },\\n  {\\n    id: 'case:gala-shift',\\n    title: 'The Gala Shift',\\n    surgeon: 'Wren',\\n    seconds: 270,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: true,\\n    rule: 'A short shared operation: wounds, shards, a Lull, a Balm node, and a flap.',\\n    patients: [\\n      {\\n        name: 'Edda Marlow',\\n        age: 46,\\n        line: 'Guest. She came down the stairs and did not reach the bottom.',\\n        vitals: 78,\\n        postcards: cards(\\n          'I have the stairs in me now. I will use the lift.',\\n          'Home. The shoes did not survive. I did.',\\n          'Bruised, closed, grateful.',\\n          'They say it was a faint. The stairs disagree.',\\n        ),\\n      },\\n      {\\n        name: 'Chris Pinto',\\n        age: 33,\\n        line: 'Guest. He was holding the door for everyone else.',\\n        vitals: 78,\\n        postcards: cards(\\n          'Door is still open. I am on the other side of it.',\\n          'Thanks for the hands. I will get the next one.',\\n          'Walking out under my own name.',\\n          'Sore. Standing. That will do.',\\n        ),\\n      },\\n    ],\\n    sites: [\\n      { id: 'left', name: 'Left table' },\\n      { id: 'right', name: 'Right table' },\\n    ],\\n    storyBefore: 'gala-brief',\\n    storyAfter: 'gala-after',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'open',\\n        'Two tables. A flap, a shard, a Lull.',\\n        'clear',\\n        [\\n          { kind: 'flap', x: -0.3, z: 0.2, site: 0, patient: 0, tag: 'cloth' },\\n          { kind: 'shard', x: 0, z: 0.15, site: 0, patient: 0, tag: 'under:cloth' },\\n          shard(1.2, -0.4, 1, 1),\\n          { kind: 'lull', x: -1.2, z: -0.5, site: 0, patient: 0 },\\n        ],\\n        '',\\n        'Lift, pull, burn, pull the cocoon.',\\n      ),\\n      phase(\\n        'film',\\n        'Balm on the right-hand table.',\\n        'clear',\\n        [{ kind: 'balmNode', x: 0.2, z: 0, site: 1, patient: 1 }],\\n        '',\\n        'Two doses. Wait for the film to fade.',\\n      ),\\n      phase('close', 'Close them both.', 'clear', [wound(-1, 0.7, 0, 0), wound(0.2, -0.6, 1, 1), gel(1.3, 0.6, 0, 0), gel(1.1, 0.5, 1, 1)], '', 'Neither one gets to leave unfinished.'),\\n    ],\\n  },\\n];\\n\\n/** The case with this id, or a thrown error when the board names a case we do not have. */\\nexport function caseById(id: string): CaseDef {\\n  const found = CASES.find((item) => item.id === id);\\n  if (!found) throw new Error(`Unknown case ${id}`);\\n  return found;\\n}\\n\\n/** Story cases, in campaign order. The session case is not one of them. */\\nexport function storyCases(): CaseDef[] {\\n  return CASES.filter((item) => item.id !== 'case:gala-shift');\\n}\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/cases.ts has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/cases.ts has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/op/cases.ts\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"/**\\n * @file The eight story operations, plus the session case. Each case adds one rule from the plan: tools, sites,\\n * a strain, a gift. Numbers are metres and seconds. Postcards are the patient's own words, one line per rank.\\n */\\nimport type { CaseDef, PhaseDef, Postcards, Spawn } from './types';\\n\\n/** Four postcard lines. */\\nfunction cards(s: string, a: string, b: string, c: string): Postcards {\\n  return { S: s, A: a, B: b, C: c };\\n}\\n\\n/** A phase row. */\\nfunction phase(id: string, hint: string, until: PhaseDef['until'], spawn: Spawn[], onEnter = '', teach = ''): PhaseDef {\\n  return { id, hint, until, spawn, onEnter, teach };\\n}\\n\\n/** A pool small enough that triage still has a clock. */\\nfunction pool(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'pool', x, z, site, patient, volume: 1.15, bleed: 0.22 };\\n}\\n\\n/** A laceration two stitches long. */\\nfunction wound(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'wound', x, z, x2: x + 1.15, z2: z, site, patient, need: 2 };\\n}\\n\\n/** A shard of glass or graft. */\\nfunction shard(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'shard', x, z, site, patient };\\n}\\n\\n/** Gel on raw skin. */\\nfunction gel(x: number, z: number, site = 0, patient = 0): Spawn {\\n  return { kind: 'abrasion', x, z, site, patient, coverNeed: 8 };\\n}\\n\\n/** A guide the scalpel can follow. `bow` bends it off the straight line. */\\nfunction curve(x0: number, z0: number, x1: number, z1: number, bow: number, unlock = '', tag = ''): Spawn {\\n  const len = Math.hypot(x1 - x0, z1 - z0);\\n  const steps = Math.max(1, Math.round(len / 0.32));\\n  const path: number[] = [];\\n  for (let i = 0; i <= steps; i++) {\\n    const u = i / steps;\\n    path.push(x0 + (x1 - x0) * u, z0 + (z1 - z0) * u + Math.sin(u * Math.PI) * bow);\\n  }\\n  return { kind: 'guide', x: x0, z: z0, path, unlock, tag, spawnBleeders: tag === 'long' ? 2 : 0 };\\n}\\n\\n/** Six motes around the heart. */\\nfunction motes(): Spawn[] {\\n  const out: Spawn[] = [];\\n  for (let i = 0; i < 6; i++) {\\n    const angle = (i / 6) * Math.PI * 2;\\n    out.push({ kind: 'mote', x: Math.cos(angle) * 1.15, z: Math.sin(angle) * 0.7 });\\n  }\\n  return out;\\n}\\n\\n/** The eight story cases, in order, then the session case. */\\nexport const CASES: readonly CaseDef[] = [\\n  {\\n    id: 'case:first-cut',\\n    title: 'First Cut',\\n    surgeon: 'Wren',\\n    seconds: 240,\\n    gift: 'none',\\n    charges: 0,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: false,\\n    rule: 'Cursor, radial, drain, forceps, suture, syringe, and gel.',\\n    patients: [\\n      {\\n        name: 'Tomás Reyes',\\n        age: 52,\\n        line: 'Harbor pilot. Glass from a deck hatch. His dog is waiting in the corridor.',\\n        vitals: 70,\\n        postcards: cards(\\n          'Night tide, and the dog slept on my boots. Thank you for letting him stay.',\\n          'The hatch is glass again. I am back on the bridge.',\\n          'Sore ribs. The dog forgives you.',\\n          'They say the glass is out. I still duck the hatch.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'chest', name: 'Chest' }],\\n    storyBefore: 'before-1',\\n    storyAfter: 'after-1',\\n    par: 1,\\n    phases: [\\n      phase('pools', 'Drain the glass-water.', 'clear', [pool(-1.6, 0.2), pool(0, -0.8), pool(1.6, 0.3)], '', 'Hold the drain in a pool until it is gone.'),\\n      phase('shards', 'Four shards. Pull, do not yank.', 'clear', [shard(-1.6, 0.6), shard(-0.4, -0.5), shard(0.8, 0.7), shard(1.8, -0.4)], '', 'Forceps: grab, then pull slowly.'),\\n      phase('stable', 'He is dropping. Stabiliser.', 'injected', [], 'dip', 'Charge the syringe into the band, then let go.'),\\n      phase('stitch', 'Three lacerations.', 'clear', [wound(-1.8, -0.2), wound(0.1, 0.6), wound(1.5, -0.9)], '', 'Cross each cut with the suture.'),\\n      phase('gel', 'Seal and close.', 'clear', [gel(-1.2, 1.1), gel(0.3, -1.3), gel(1.6, 0.9)], '', 'Paint gel on the raw skin.'),\\n    ],\\n  },\\n  {\\n    id: 'case:quiet-lump',\\n    title: 'The Quiet Lump',\\n    surgeon: 'Wren',\\n    seconds: 270,\\n    gift: 'none',\\n    charges: 0,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: false,\\n    rule: 'Scalpel along a guide, scanner on what is buried, laser on what should not be there.',\\n    patients: [\\n      {\\n        name: 'Gwen Abara',\\n        age: 34,\\n        line: 'Trumpet player. An old graft scar, and a joke she has told twice.',\\n        vitals: 85,\\n        postcards: cards(\\n          'Back on the trumpet. I played your name badly on purpose.',\\n          'High C is back. The scar is just a scar.',\\n          'I can hold a note. Do not ask for pretty.',\\n          'They say I will play again. They say you looked very worried.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'abdomen', name: 'Abdomen' }],\\n    storyBefore: 'before-2',\\n    storyAfter: 'after-2',\\n    par: 1,\\n    phases: [\\n      phase('incision', 'A long curve. Stay on the line.', 'clear', [curve(-3.2, 0, 3.4, 0.2, 0.45, '', 'long')], '', 'The scalpel follows the guide.'),\\n      phase(\\n        'lump',\\n        'Find it. Cut around it. Lift it.',\\n        'clear',\\n        [\\n          { kind: 'nodule', x: -1.6, z: 1.1, hidden: true },\\n          { kind: 'nodule', x: 1.7, z: 1.2, hidden: true },\\n          { kind: 'nodule', x: 1.5, z: -1.3, hidden: true },\\n          { kind: 'mass', x: 0, z: -0.2, hidden: true, locked: true, tag: 'lump' },\\n          curve(-0.7, -0.2, 0.7, -0.2, 0.55, 'lump', 'flinch'),\\n        ],\\n        '',\\n        'Scan, then laser the nodules. The mass comes out with the forceps.',\\n      ),\\n      phase('close', 'Stitch and seal.', 'clear', [wound(-1.4, 0.4), wound(0.6, -1), gel(1.8, 0.5)], '', 'Suture, then gel.'),\\n    ],\\n  },\\n  {\\n    id: 'case:crosstalk',\\n    title: 'Crosstalk',\\n    surgeon: 'Wren',\\n    seconds: 300,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: true,\\n    rule: 'Three sites keep bleeding while you are away. A flatline has a Code. Stillpoint slows the field.',\\n    patients: [\\n      {\\n        name: 'Hal Minsky',\\n        age: 58,\\n        line: 'Bus driver. Crash on Breakwater Road. He still has the route in his head.',\\n        vitals: 60,\\n        postcards: cards(\\n          'Route 4 is mine again. I waved at the hospital on the way past.',\\n          'Both lungs, both hands, one bus. We are even.',\\n          'The arm works. The route can wait a week.',\\n          'They say I will drive. They did not say when.',\\n        ),\\n      },\\n    ],\\n    sites: [\\n      { id: 'liver', name: 'Liver' },\\n      { id: 'lung', name: 'Lung' },\\n      { id: 'arm', name: 'Arm' },\\n    ],\\n    storyBefore: 'before-3',\\n    storyAfter: 'after-3',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'triage',\\n        'Three sites. The ones you leave keep bleeding.',\\n        'clear',\\n        [pool(-1.2, 0.4, 0), wound(0.4, -0.6, 0), pool(-1, 0.5, 1), wound(0.5, -0.5, 1), pool(-0.8, 0.3, 2), wound(0.6, -0.4, 2)],\\n        '',\\n        'Switch sites. Do not let one wait too long.',\\n      ),\\n      phase('code', 'Flatline. Paddles in the green.', 'code', [], 'flatline', 'Both paddles while the band is green. Two tries.'),\\n      phase(\\n        'still',\\n        'Three arteries. There is no time. There is Stillpoint.',\\n        'clear',\\n        [\\n          { kind: 'bleeder', x: -0.4, z: 0.2, site: 0 },\\n          { kind: 'bleeder', x: 0.2, z: -0.3, site: 1 },\\n          { kind: 'bleeder', x: 0.8, z: 0.4, site: 2 },\\n        ],\\n        '',\\n        'Three beats on the line. The field slows. Your hands do not.',\\n      ),\\n      phase('close', 'Close every site.', 'clear', [wound(-1, 0.8, 0), gel(1.2, 0.6, 1), gel(0.2, -0.8, 2)], '', 'Finish the work you left.'),\\n    ],\\n  },\\n  {\\n    id: 'case:it-moves',\\n    title: 'It Moves',\\n    surgeon: 'Wren',\\n    seconds: 330,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: true,\\n    rule: 'Lull nuzzles, then a cocoon. The Matron only takes a binder dose while she yawns.',\\n    patients: [\\n      {\\n        name: 'Gwen Abara',\\n        age: 34,\\n        line: 'Back, and the scar is moving. She asked for her trumpet before they put her under.',\\n        vitals: 75,\\n        postcards: cards(\\n          'I felt it stop. That is the whole review.',\\n          'The scar is quiet. I slept.',\\n          'Hurts less than yesterday, which is a low bar.',\\n          'They say it was a twitch. I say you were right.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'abdomen', name: 'Abdomen' }],\\n    storyBefore: 'before-4',\\n    storyAfter: 'after-4',\\n    par: 1,\\n    phases: [\\n      phase('reopen', 'Reopen the scar.', 'clear', [curve(-1.4, 0.2, 1.4, 0, 0.2)], '', 'Same line as last time. She remembers it.'),\\n      phase(\\n        'lulls',\\n        'They are quiet, and that is the bad sign.',\\n        'clear',\\n        [\\n          { kind: 'lull', x: -1.5, z: 0.4 },\\n          { kind: 'lull', x: 0.2, z: 1 },\\n          { kind: 'lull', x: 1.5, z: -0.3 },\\n          { kind: 'matron', x: 0, z: -0.8 },\\n        ],\\n        '',\\n        'Laser a Lull. Forceps on the cocoon. Binder in the yawn.',\\n      ),\\n      phase('close', 'Close her again.', 'clear', [wound(-0.8, 0.9), gel(1.1, 0.7)], '', 'Suture, then gel.'),\\n    ],\\n  },\\n  {\\n    id: 'case:struck-off',\\n    title: 'Struck Off',\\n    surgeon: 'Sabine',\\n    seconds: 330,\\n    gift: 'second',\\n    charges: 2,\\n    colleague: true,\\n    swap: false,\\n    roll: true,\\n    code: true,\\n    rule: 'A flap hides Solace. Split it with the scalpel. Laser only the smallest. Second Pulse holds the vitals.',\\n    patients: [\\n      {\\n        name: 'Big Ana Duarte',\\n        age: 47,\\n        line: 'Stevedore. She went down on the deck and told her crew to keep the winch running.',\\n        vitals: 70,\\n        postcards: cards(\\n          'Crew says I yelled at the winch from the stretcher. Sounds right.',\\n          'Back on deck. Do not tell the winch I missed it.',\\n          'Walking. The coat was warm. Tell her thanks.',\\n          'They say the ship rolled. I say I did not.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'deck', name: 'Deck table' }],\\n    storyBefore: 'before-5',\\n    storyAfter: 'after-5',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'cluster',\\n        'Solace on the vessel. It likes the warmth. Do not give it the laser yet.',\\n        'clear',\\n        [{ kind: 'solace', x: 0, z: 0.2, gen: 1 }],\\n        '',\\n        'A long scalpel stroke splits it. Laser the little ones.',\\n      ),\\n      phase(\\n        'mother',\\n        'The storm hits. Mother Solace is under the flap.',\\n        'clear',\\n        [\\n          { kind: 'flap', x: 0, z: -0.2, tag: 'lid' },\\n          { kind: 'solace', x: 0.1, z: -0.15, gen: 1, tag: 'under:lid' },\\n        ],\\n        '',\\n        'Hold the flap. Second Pulse: three beats, then vitals cannot fall.',\\n      ),\\n      phase('close', 'Close, even while the deck rolls.', 'clear', [wound(-1, 0.8), gel(1.2, 0.5)], '', 'The roll is the ship, not your hands.'),\\n    ],\\n  },\\n  {\\n    id: 'case:reverie',\\n    title: 'Reverie',\\n    surgeon: 'Wren',\\n    seconds: 360,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: true,\\n    swap: true,\\n    roll: false,\\n    code: true,\\n    rule: 'Reverie hides until the scanner. Laser brings it up, then it sinks. Two surgeons can Consult.',\\n    patients: [\\n      {\\n        name: 'Bram Achterberg',\\n        age: 60,\\n        line: 'Chief of surgery. He opened his own collar and showed the graft.',\\n        vitals: 65,\\n        postcards: cards(\\n          'I signed the trials. You did not. That is the difference that matters.',\\n          'The files are on your desk. Read them angry.',\\n          'I am alive enough to be ashamed. Good.',\\n          'They will ask for a second opinion. Give them yours.',\\n        ),\\n      },\\n    ],\\n    sites: [\\n      { id: 'chest', name: 'Chest' },\\n      { id: 'abdomen', name: 'Abdomen' },\\n    ],\\n    storyBefore: 'before-6',\\n    storyAfter: 'after-6',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'open',\\n        'Two incisions. Two sites.',\\n        'clear',\\n        [curve(-1.2, 0.3, 1.2, 0.2, 0.15, '', ''), curve(-1, -0.2, 1, 0, 0.1, '', '')],\\n        '',\\n        'One guide on each site.',\\n      ),\\n      phase(\\n        'hunt',\\n        'Scan. The decoys pop. The real one keeps the beat.',\\n        'clear',\\n        [\\n          { kind: 'flap', x: -0.2, z: 0.1, tag: 'heart' },\\n          { kind: 'reverie', x: 0.15, z: 0.05, tag: 'under:heart' },\\n          { kind: 'decoy', x: -1.4, z: 0.8 },\\n          { kind: 'decoy', x: 1.3, z: -0.7 },\\n        ],\\n        '',\\n        'Scan, burn while it is up, scan again when it sinks.',\\n      ),\\n      phase('close', 'Close both sites.', 'clear', [wound(-1, 0.9, 0), wound(-0.6, -0.8, 1), gel(1.2, 0.4, 0)], '', 'He is still the chief. He is also the patient.'),\\n    ],\\n  },\\n  {\\n    id: 'case:gala-night',\\n    title: 'Gala Night',\\n    surgeon: 'Wren',\\n    seconds: 390,\\n    gift: 'second',\\n    charges: 2,\\n    colleague: true,\\n    swap: true,\\n    roll: false,\\n    code: true,\\n    rule: 'Balm lacquer blocks the suture and the drain. Gel clears a cell. Two binder doses kill the node.',\\n    patients: [\\n      {\\n        name: 'Maris Quell',\\n        age: 51,\\n        line: 'Donor. She came for the speech and stayed for the floor.',\\n        vitals: 80,\\n        postcards: cards(\\n          'I have cancelled the pledge. Spend it on gloves.',\\n          'Awake, and poorer in the useful way.',\\n          'The wing can wait. I cannot.',\\n          'They say it was the wine. It was not the wine.',\\n        ),\\n      },\\n      {\\n        name: 'Owen Peck',\\n        age: 44,\\n        line: 'Donor. He asked if the chandelier was supposed to do that.',\\n        vitals: 80,\\n        postcards: cards(\\n          'Tell the band they may finish the song. I will be sitting.',\\n          'Table B owes you a quiet year.',\\n          'Walking. Not dancing. Do not push it.',\\n          'I remember the screen going dark. Then you.',\\n        ),\\n      },\\n      {\\n        name: 'Safiya Lange',\\n        age: 39,\\n        line: 'Donor. She was mid-toast when her hands stopped being hers.',\\n        vitals: 80,\\n        postcards: cards(\\n          'The toast can be finished later. The point of it changed.',\\n          'Three tables, three of us, one pair of hands that mattered.',\\n          'I can hold a glass. I will not raise it to him.',\\n          'They say we fainted. We fell. There is a difference.',\\n        ),\\n      },\\n    ],\\n    sites: [\\n      { id: 'a', name: 'Table A' },\\n      { id: 'b', name: 'Table B' },\\n      { id: 'c', name: 'Table C' },\\n    ],\\n    storyBefore: 'before-7',\\n    storyAfter: 'after-7',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'nodes',\\n        'A node on every table. The film spreads from it.',\\n        'clear',\\n        [\\n          { kind: 'balmNode', x: 0, z: 0, site: 0, patient: 0 },\\n          { kind: 'balmNode', x: 0.2, z: 0.1, site: 1, patient: 1 },\\n          { kind: 'balmNode', x: -0.2, z: -0.1, site: 2, patient: 2 },\\n        ],\\n        '',\\n        'Two binder doses. The film fades. Gel any cell that is still in the way.',\\n      ),\\n      phase(\\n        'race',\\n        'Now the bleeding. Losing any of them loses the room.',\\n        'clear',\\n        [pool(-1, 0.4, 0, 0), wound(0.3, -0.5, 0, 0), pool(-0.8, 0.3, 1, 1), wound(0.4, -0.4, 1, 1), pool(-0.6, 0.2, 2, 2), wound(0.5, -0.3, 2, 2)],\\n        '',\\n        'One vitals bar each. A Code is allowed once a patient.',\\n      ),\\n      phase('seal', 'Seal all three and get off the floor.', 'clear', [gel(1, 0.6, 0, 0), gel(0.8, 0.5, 1, 1), gel(0.6, 0.4, 2, 2)], '', 'Gel, then leave the gala to the speech.'),\\n    ],\\n  },\\n  {\\n    id: 'case:mercy',\\n    title: 'Mercy',\\n    surgeon: 'Wren',\\n    seconds: 480,\\n    gift: 'stillpoint',\\n    charges: 3,\\n    colleague: true,\\n    swap: true,\\n    roll: false,\\n    code: true,\\n    rule: 'Mercy has three phases: Anesthesia, The Kindness, Last Rites. Every tool is on the table.',\\n    patients: [\\n      {\\n        name: 'Lucan Voss',\\n        age: 50,\\n        line: 'He built Halcyon. Tonight he is the emergency he sold.',\\n        vitals: 100,\\n        postcards: cards(\\n          'You saved me. That is the one thing I could never have sold.',\\n          'I woke in cuffs. The heart is mine again. The rest is the court.',\\n          'Alive. Unhappy about the company. Correct, on both.',\\n          'They will say you hesitated. I was awake for the part where you did not.',\\n        ),\\n      },\\n    ],\\n    sites: [{ id: 'heart', name: 'Heart' }],\\n    storyBefore: 'before-8',\\n    storyAfter: 'after-8',\\n    par: 1,\\n    phases: [\\n      phase('open', 'Open. He does not get a speech.', 'clear', [curve(-1.3, 0.4, 1.3, 0.3, 0.12)], '', 'A short guide, then her.'),\\n      phase('mercy-motes', 'Anesthesia. Six motes, then she is open.', 'clear', motes(), '', 'Laser each mote. Binder on the three points when they show.'),\\n      phase('mercy-kindness', 'The Kindness. She stops the heart.', 'code', [], 'flatline', 'A Code. Land it. It does not spend him.'),\\n      phase('mercy-rakes', 'Three cuts. Close them.', 'clear', [wound(-1.6, 0.2), wound(0, -0.6), wound(1.4, 0.4)], '', 'Suture all three.'),\\n      phase('mercy-kindness-2', 'She does it again.', 'code', [], 'flatline', 'Same band. Same two tries.'),\\n      phase('mercy-rakes-2', 'Three more.', 'clear', [wound(-1.4, -0.3), wound(0.2, 0.7), wound(1.5, -0.5)], '', 'Close them before she burrows.'),\\n      phase('mercy-rites', 'Last Rites. The line moves with the heart.', 'clear', [curve(-1.2, 0, 1.2, 0.15, 0.08, '', 'moving')], '', 'Follow the guide. It drifts.'),\\n      phase(\\n        'mercy-tendrils',\\n        'Five tendrils. All of them out, or they grab back.',\\n        'clear',\\n        [-0.8, -0.4, 0, 0.4, 0.8].map((x) => ({ kind: 'tendril' as const, x, z: 0.25 })),\\n        '',\\n        'Forceps. Do not leave one behind.',\\n      ),\\n      phase(\\n        'mercy-bind',\\n        'A Gift, then three doses inside it.',\\n        'clear',\\n        [-0.7, 0, 0.7].map((x) => ({ kind: 'binder' as const, x, z: -0.3, doseNeed: 1, tag: 'gift' })),\\n        '',\\n        'The doses only land while the Gift is up.',\\n      ),\\n      phase('mercy-final', 'Restart the heart.', 'code', [], 'flatline', 'Every paddle. Then we are done.'),\\n    ],\\n  },\\n  {\\n    id: 'case:gala-shift',\\n    title: 'The Gala Shift',\\n    surgeon: 'Wren',\\n    seconds: 270,\\n    gift: 'stillpoint',\\n    charges: 2,\\n    colleague: false,\\n    swap: false,\\n    roll: false,\\n    code: true,\\n    rule: 'A short shared operation: wounds, shards, a Lull, a Balm node, and a flap.',\\n    patients: [\\n      {\\n        name: 'Edda Marlow',\\n        age: 46,\\n        line: 'Guest. She came down the stairs and did not reach the bottom.',\\n        vitals: 78,\\n        postcards: cards(\\n          'I have the stairs in me now. I will use the lift.',\\n          'Home. The shoes did not survive. I did.',\\n          'Bruised, closed, grateful.',\\n          'They say it was a faint. The stairs disagree.',\\n        ),\\n      },\\n      {\\n        name: 'Chris Pinto',\\n        age: 33,\\n        line: 'Guest. He was holding the door for everyone else.',\\n        vitals: 78,\\n        postcards: cards(\\n          'Door is still open. I am on the other side of it.',\\n          'Thanks for the hands. I will get the next one.',\\n          'Walking out under my own name.',\\n          'Sore. Standing. That will do.',\\n        ),\\n      },\\n    ],\\n    sites: [\\n      { id: 'left', name: 'Left table' },\\n      { id: 'right', name: 'Right table' },\\n    ],\\n    storyBefore: 'gala-brief',\\n    storyAfter: 'gala-after',\\n    par: 1,\\n    phases: [\\n      phase(\\n        'open',\\n        'Two tables. A flap, a shard, a Lull.',\\n        'clear',\\n        [\\n          { kind: 'flap', x: -0.3, z: 0.2, site: 0, patient: 0, tag: 'cloth' },\\n          { kind: 'shard', x: 0, z: 0.15, site: 0, patient: 0, tag: 'under:cloth' },\\n          shard(1.2, -0.4, 1, 1),\\n          { kind: 'lull', x: -1.2, z: -0.5, site: 0, patient: 0 },\\n        ],\\n        '',\\n        'Lift, pull, burn, pull the cocoon.',\\n      ),\\n      phase(\\n        'film',\\n        'Balm on the right-hand table.',\\n        'clear',\\n        [{ kind: 'balmNode', x: 0.2, z: 0, site: 1, patient: 1 }],\\n        '',\\n        'Two doses. Wait for the film to fade.',\\n      ),\\n      phase('close', 'Close them both.', 'clear', [wound(-1, 0.7, 0, 0), wound(0.2, -0.6, 1, 1), gel(1.3, 0.6, 0, 0), gel(1.1, 0.5, 1, 1)], '', 'Neither one gets to leave unfinished.'),\\n    ],\\n  },\\n];\\n\\n/** The case with this id, or a thrown error when the board names a case we do not have. */\\nexport function caseById(id: string): CaseDef {\\n  const found = CASES.find((item) => item.id === id);\\n  if (!found) throw new Error(`Unknown case ${id}`);\\n  return found;\\n}\\n\\n/** Story cases, in campaign order. The session case is not one of them. */\\nexport function storyCases(): CaseDef[] {\\n  return CASES.filter((item) => item.id !== 'case:gala-shift');\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-4d2a282a-b042-4463-a9df-4bb86e0ffa74-35","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"/**\\n * @file The operation bot. It reads the live field and writes the same hand record a pad would.\\n * It never sets score, vitals, or `done` itself. `runBot` stops on a win, a loss, or ten seconds with no change.\\n */\\nimport { codeBand } from './body';\\nimport { stepOp } from './step';\\nimport { rightTool } from './table';\\nimport type { Hand, Op, Seat, Target } from './types';\\nimport { flapOpen, idleHand } from './world';\\n\\n/** Tool ids in radial order, matching `TOOLS`. */\\nconst INDEX: Record<string, number> = {\\n  scalpel: 0,\\n  forceps: 1,\\n  suture: 2,\\n  drain: 3,\\n  laser: 4,\\n  syringe: 5,\\n  gel: 6,\\n  scanner: 7,\\n};\\n\\n/** Hands for every seat, from the operation as it stands before this step. */\\nexport function botHands(op: Op): Hand[] {\\n  return op.seats.map((seat) => botHand(op, seat));\\n}\\n\\n/** Play until the operation ends. A frozen field for 600 ticks is a stall, not a win. */\\nexport function runBot(op: Op, cap = 60 * 60 * 12): Op {\\n  let last = '';\\n  let same = 0;\\n  for (let i = 0; i < cap && op.status === 'playing'; i++) {\\n    const sig = signature(op);\\n    if (sig === last) same += 1;\\n    else {\\n      same = 0;\\n      last = sig;\\n    }\\n    if (same > 600) {\\n      op.status = 'lost';\\n      op.fail = `stalled ${sig.slice(0, 180)}`;\\n      break;\\n    }\\n    stepOp(op, botHands(op));\\n  }\\n  return op;\\n}\\n\\n/** What changed, so a slow burn does not look like a stall. */\\nfunction signature(op: Op): string {\\n  const bits = op.targets\\n    .filter((target) => !target.done)\\n    .map((target) => `${target.id}:${target.cut}:${target.stitches}:${Math.round(target.volume * 5)}:${Math.round(target.burn * 5)}:${Math.round(target.laserDamage * 5)}:${target.dose}:${target.hidden ? 1 : 0}:${target.stroke.toFixed(1)}`)\\n    .join(',');\\n  return `${op.phase}:${op.code ? 'c' : ''}:${op.injected ? 1 : 0}:${op.mercyKills}:${bits}`;\\n}\\n\\n/** One surgeon's hand for this step. */\\nfunction botHand(op: Op, seat: Seat): Hand {\\n  const hand = idleHand(seat);\\n  if (op.status !== 'playing') return hand;\\n  if (op.code) {\\n    hand.paddle = codeBand(op);\\n    return hand;\\n  }\\n  if (seat.lock >= 0) {\\n    hand.gift = op.tick === seat.lockBeat;\\n    return hand;\\n  }\\n  const phase = op.phases[op.phase];\\n  if (phase?.until === 'injected' && !op.injected) return inject(op, seat, hand);\\n  if (phase?.until === 'code') return hand;\\n  const target = pick(op, seat);\\n  if (!target) {\\n    const matron = op.targets.find((item) => !item.done && !item.optional && item.phase === op.phase && item.kind === 'matron');\\n    if (matron) approach(hand, seat, matron.x, matron.z, op.balance.cursor);\\n    return hand;\\n  }\\n  if (target.site !== seat.site) hand.site = target.site;\\n  if (target.kind === 'binder' && target.tag === 'gift' && seat.giftLeft <= 0) {\\n    hand.gift = seat.charges > 0;\\n    return hand;\\n  }\\n  work(op, seat, hand, target);\\n  return hand;\\n}\\n\\n/** The next thing this seat should touch. Seats split the list so they do not grab the same shard. */\\nfunction pick(op: Op, seat: Seat): Target | null {\\n  const list = op.targets.filter((target) => open(op, target));\\n  list.sort((a, b) => rank(a) - rank(b) || a.id - b.id);\\n  if (list.length === 0) return null;\\n  if (op.seats.length === 1) return list[0];\\n  const mine = list.filter((_, index) => index % op.seats.length === seat.id);\\n  return mine[0] ?? null;\\n}\\n\\n/** Whether the bot is allowed to work this target right now. */\\nfunction open(op: Op, target: Target): boolean {\\n  if (target.done || target.optional || target.phase !== op.phase) return false;\\n  if (target.under >= 0 && !flapOpen(op, target.under)) return false;\\n  if (target.locked && !target.hidden) return false;\\n  if (target.kind === 'matron' && !target.vulnerable) return false;\\n  return true;\\n}\\n\\n/** Lower runs first. A yawning Matron outranks the small ones. */\\nfunction rank(target: Target): number {\\n  if (target.kind === 'flap') return 0;\\n  if (target.kind === 'matron' && target.vulnerable) return 1;\\n  if (target.hidden) return 2;\\n  if (target.kind === 'lull' || target.kind === 'bleeder' || target.kind === 'mote') return 3;\\n  if (target.kind === 'pool') return 4;\\n  if (target.kind === 'solace') return 5;\\n  if (target.kind === 'balmNode') return 6;\\n  if (target.kind === 'guide') return 7;\\n  if (target.kind === 'nodule') return 8;\\n  if (target.kind === 'wound') return 9;\\n  if (target.kind === 'shard' || target.kind === 'mass' || target.kind === 'cocoon' || target.kind === 'tendril') return 10;\\n  if (target.kind === 'binder') return 11;\\n  if (target.kind === 'balmCell') return 12;\\n  return 13;\\n}\\n\\n/** Dispatch on the kind. The hand only aims, equips, and holds use. */\\nfunction work(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  if (target.hidden) return scan(op, seat, hand, target);\\n  if (target.kind === 'solace' && target.gen < 3) return split(op, seat, hand, target);\\n  if (target.kind === 'guide') return cut(op, seat, hand, target);\\n  if (target.kind === 'wound') return stitch(op, seat, hand, target);\\n  if (target.kind === 'shard' || target.kind === 'mass' || target.kind === 'cocoon' || target.kind === 'tendril') return pull(op, seat, hand, target);\\n  if (target.kind === 'flap') return pull(op, seat, hand, target);\\n  if (target.kind === 'binder' || target.kind === 'matron') return bind(op, seat, hand, target);\\n  if (target.kind === 'balmCell' || target.kind === 'abrasion' || target.kind === 'numb') return paint(op, seat, hand, target);\\n  const tool = rightTool(target.kind);\\n  if (tool === 'drain') return drain(op, seat, hand, target);\\n  if (tool === 'laser') return burn(op, seat, hand, target);\\n  if (tool === 'gel') return paint(op, seat, hand, target);\\n  if (tool) hand.tool = INDEX[tool] ?? 0;\\n}\\n\\n/** Step toward a point at `metres` per second, never past it. */\\nfunction approach(hand: Hand, seat: Seat, x: number, z: number, metres: number): void {\\n  const dx = x - seat.x;\\n  const dz = z - seat.z;\\n  const dist = Math.hypot(dx, dz);\\n  const step = Math.max(0.5, metres) / 60;\\n  if (dist <= step) {\\n    hand.x = x;\\n    hand.z = z;\\n    return;\\n  }\\n  hand.x = seat.x + (dx / dist) * step;\\n  hand.z = seat.z + (dz / dist) * step;\\n}\\n\\n/** Follow the guide vertex the cut has reached. */\\nfunction cut(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  const count = target.path.length / 2;\\n  const index = Math.min(target.cut, Math.max(0, count - 1));\\n  const x = target.path[index * 2] ?? target.x;\\n  const z = target.path[index * 2 + 1] ?? target.z;\\n  approach(hand, seat, x, z, op.balance.cursor);\\n  hand.use = target.cut > 0 || Math.hypot(seat.x - x, seat.z - z) < 0.28;\\n  hand.tool = 0;\\n}\\n\\n/** Cross the wound once per stitch, offset to either side. */\\nfunction stitch(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  const dx = target.x2 - target.x;\\n  const dz = target.z2 - target.z;\\n  const length = Math.max(0.5, Math.hypot(dx, dz));\\n  const u = (target.stitches + 0.5) / Math.max(1, target.need);\\n  const side = seat.sutureSide >= 0 ? -1 : 1;\\n  const x = target.x + dx * u + (-dz / length) * 0.36 * side;\\n  const z = target.z + dz * u + (dx / length) * 0.36 * side;\\n  approach(hand, seat, x, z, op.balance.cursor);\\n  hand.use = seat.sutureSide !== 0 || Math.hypot(seat.x - x, seat.z - z) < 0.2;\\n  hand.tool = 2;\\n}\\n\\n/** Grab, then back away slowly enough to stay CLEAN. */\\nfunction pull(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  hand.tool = 1;\\n  if (seat.hold === target.id) {\\n    const dx = seat.x - target.ox || 1;\\n    const dz = seat.z - target.oz;\\n    const len = Math.hypot(dx, dz) || 1;\\n    const step = 4 / 60;\\n    hand.x = Math.max(-7, Math.min(7, seat.x + (dx / len) * step));\\n    hand.z = Math.max(-4.5, Math.min(4.5, seat.z + (dz / len) * step));\\n    hand.use = true;\\n    return;\\n  }\\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < 0.48;\\n}\\n\\n/** Sit on a pool. */\\nfunction drain(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < 0.6;\\n  hand.tool = 3;\\n}\\n\\n/** Sit on something that burns. Let a hot laser cool. */\\nfunction burn(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\\n  hand.use = seat.laserCool <= 0 && Math.hypot(seat.x - target.x, seat.z - target.z) < 0.32;\\n  hand.tool = 4;\\n}\\n\\n/** A long stroke through Solace. Keep moving or the stroke never adds up. */\\nfunction split(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  const span = Math.max(0.8, target.radius * 0.9);\\n  const leg = Math.floor(op.tick / 18) % 2 === 0 ? -1 : 1;\\n  approach(hand, seat, target.x + leg * span, target.z, op.balance.cursor);\\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) <= target.radius + 0.25;\\n  hand.tool = 0;\\n}\\n\\n/** Hold the syringe on a binder point or a yawning Matron. */\\nfunction bind(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < 0.48;\\n  hand.tool = 5;\\n}\\n\\n/** Paint gel. Balm cells clear on contact, so this is also how the film comes off. */\\nfunction paint(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < op.balance.gel * 0.75;\\n  hand.tool = 6;\\n}\\n\\n/** Stand on a buried target and ping. Everything in range comes up. */\\nfunction scan(op: Op, seat: Seat, hand: Hand, target: Target): void {\\n  approach(hand, seat, target.x, target.z, op.balance.cursor);\\n  hand.use = Math.hypot(seat.x - target.x, seat.z - target.z) < 0.4;\\n  hand.tool = 7;\\n}\\n\\n/** Charge the stabiliser in clear tissue, then let go inside the band. */\\nfunction inject(op: Op, seat: Seat, hand: Hand): Hand {\\n  approach(hand, seat, 0, 2.2, op.balance.cursor);\\n  const there = Math.hypot(seat.x, seat.z - 2.2) < 0.25;\\n  hand.tool = 5;\\n  hand.use = there && seat.syringeCd <= 0 && seat.syringe < 0.86;\\n  return hand;\\n}\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.