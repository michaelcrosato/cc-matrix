110,32,114,101,112,108,97,99,101,32,105,116,46,32,83,97,121,32,105,110,32,79,110,108,105,110,101,32,116,104,97,116,32,110,101,116,119,111,114,107,32,112,108,97,121,32,105,115,32,116,104,114,111,117,103,104,32,65,73,32,72,117,98,32,111,110,108,121,44,32,97,110,100,32,99,111,117,99,104,32,99,111,45,111,112,32,111,110,32,111,110,101,32,115,99,114,101,101,110,46,10,57,49,49,58,124,32,83,111,117,114,99,101,32,73,110,102,111,114,109,97,116,105,111,110,44,32,102,101,101,100,98,97,99,107,44,32,65,98,111,117,116,32,115,99,114,101,101,110,44,32,101,120,105,116,32,105,110,116,101,114,118,105,101,119,32,124,32,194,167,49,57,32,105,115,115,117,101,32,108,111,103,44,32,194,167,50,49,32,124,10,57,49,53,58,35,35,32,65,112,112,101,110,100,105,120,32,65,58,32,108,105,118,101,32,115,108,105,100,101,114,115,10,57,53,48,58,35,35,32,65,112,112,101,110,100,105,120,32,66,58,32,119,104,97,116,32,116,104,105,115,32,112,108,97,110,39,115,32,114,101,115,101,97,114,99,104,32,102,111,117,110,100,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":44,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/PLAN.md\",\"matches\":[{\"line_number\":16,\"content\":\"## 1. The game\"},{\"line_number\":71,\"content\":\"## 2. A minute of play\"},{\"line_number\":84,\"content\":\"## 3. Rules of an operation\"},{\"line_number\":136,\"content\":\"## 4. Instruments\"},{\"line_number\":167,\"content\":\"## 5. The Gift\"},{\"line_number\":185,\"content\":\"## 6. Several surgeons, one patient\"},{\"line_number\":206,\"content\":\"## 7. The strains\"},{\"line_number\":243,\"content\":\"## 8. The cases\"},{\"line_number\":287,\"content\":\"## 9. World, cast, story and writing\"},{\"line_number\":350,\"content\":\"## 10. Controls and screens\"},{\"line_number\":400,\"content\":\"- **Title:** 3D lamp-lit OR with the lighthouse beam through rain on the window; the title; Continue / New Shift / The Board / Scrub In / Settings / About. Attract after 10 s idle (§14).\"},{\"line_number\":409,\"content\":\"- **About/Credits:** see §21. Paged cards, one question per card.\"},{\"line_number\":416,\"content\":\"## 11. Art direction\"},{\"line_number\":449,\"content\":\"## 12. Animation\"},{\"line_number\":463,\"content\":\"## 13. Audio\"},{\"line_number\":477,\"content\":\"## 14. Attract mode\"},{\"line_number\":489,\"content\":\"## 15. Dev mode\"},{\"line_number\":503,\"content\":\"## 16. Multiplayer\"},{\"line_number\":505,\"content\":\"Follow the AI Hub Session Protocol v1 (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); read it in full. Client `session.js` is version 1.4.0 at the time of writing. **Mode: `shared-world`.**\"},{\"line_number\":519,\"content\":\"Paste `session.js` unmodified as the first script, right after `<meta charset>`.\"},{\"line_number\":567,\"content\":\"**On its own.** With no hub, the game runs exactly as a normal game: story, Board, solo, and couch co-op for up to four devices (§6). There is no other online mode: outside a session there is no hub network and we add no servers. State this in About.\"},{\"line_number\":573,\"content\":\"## 17. Engine and architecture\"},{\"line_number\":575,\"content\":\"### 17.1 Setup, and traps already hit on this machine\"},{\"line_number\":603,\"content\":\"Measured on the starter: `npm ci` 6 s, `npm run check` 25 s, `npm test` 9 s, `node x shot` 12 s, a one-file build 8 s.\"},{\"line_number\":605,\"content\":\"Tested and working, so build on these: the live mesh of §17.3; one-file build and boot from `file://`; frames still drawing while paused; `step(n, intents)` with custom keys; restart with new settings keeping the page; custom intents recorded in a replay; `cam3=fixed` cuts with `{ blend: true }`; `touch=off`; the boot order and netcode of §16 in all four harness runs. **Not tested:** the game's own card in the harness, a `defineCamera` mode in play, transparent live meshes, the light pool's focus (§17.2), vertex counts past 40,000. Prove these early.\"},{\"line_number\":607,\"content\":\"### 17.2 One scene, many runs\"},{\"line_number\":623,\"content\":\"### 17.3 Live meshes (tested)\"},{\"line_number\":653,\"content\":\"### 17.4 Input: everything is one custom intent\"},{\"line_number\":663,\"content\":\"### 17.5 Data is the designer tool\"},{\"line_number\":691,\"content\":\"### 17.6 Files\"},{\"line_number\":717,\"content\":\"labs/game/tools/                  verify, one-file build, e2e, hub checks\"},{\"line_number\":726,\"content\":\"## 18. Packaging\"},{\"line_number\":728,\"content\":\"The deliverable is one self-contained HTML file: no CDN needed. Write `labs/game/tools/one-file.mts`, modelled on `tools/lib/oneFile.ts`, reusing its exported `inlineBuild` and `externalRefs`: Vite `build` with `configFile: false`, `base: './'`, the alias of `three` to `three/webgpu`, `write: false`, `modulePreload: false`, `cssCodeSplit: false`, `assetsInlineLimit: () => true`, `rollupOptions: { input: <labs/game/index.html>, output: { inlineDynamicImports: true } }`. Tested on the starter: 6.7 MB, no external references, boots from `file://` without errors.\"},{\"line_number\":732,\"content\":\"- Paste `session.js` into `labs/game/index.html` as the first inline script. Through this build it came out byte-identical and first, and the harness accepted it (tested). Keep a test that says so.\"},{\"line_number\":734,\"content\":\"- The build embeds the exit interview's data for the About screen (§21), so they cannot disagree.\"},{\"line_number\":739,\"content\":\"## 19. Testing\"},{\"line_number\":825,\"content\":\"- Every tool and target kind has an effect or a refusal line (§4). The exit interview parses and matches TASK.md's shape, and the About screen's data matches it.\"},{\"line_number\":848,\"content\":\"## 20. Build order\"},{\"line_number\":861,\"content\":\"10. **Tune:** rank thresholds, clock, difficulty, using the bot's numbers. Check no phase has a dead stretch over 8 s for a bot playing at human speed. Then final `verify`, exit interview, About screen.\"},{\"line_number\":867,\"content\":\"## 21. Done\"},{\"line_number\":869,\"content\":\"**About/Credits (in game)**, paged, one card per item, big text. One screen each: Source Information (Date, Source, Plan, Genre and Perspective, Tech, Art Direction, Animation, Audio, Online, Testing, Research, Environment, Model, Usage, with your TASK.md's values for Date, Environment and Model), Testing Feedback, Engine Feedback, Prompt Feedback (every question TASK.md asks, one card each), credits. Use \\\"unknown\\\" for anything you cannot confirm. Plan field: `PLAN.md`. Usage field: exactly `added on import`, in an element marked `data-about=\\\"usage\\\"` so the importer can replace it. Say in Online that network play is through AI Hub only, and couch co-op on one screen.\"},{\"line_number\":911,\"content\":\"| Source Information, feedback, About screen, exit interview | §19 issue log, §21 |\"},{\"line_number\":915,\"content\":\"## Appendix A: live sliders\"},{\"line_number\":950,\"content\":\"## Appendix B: what this plan's research found\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"9ead499e-1c40-43fa-bd46-47cd39b875a0"}
{"type":"assistant","message":{"id":"msg_215","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"This is a massive remaining task.","signature":""},{"type":"tool_use","id":"call-ce134aa1-48f3-4455-a74d-1cc60d170b1f-8","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/PLAN.md","offset":350,"limit":180}},{"type":"tool_use","id":"call-ce134aa1-48f3-4455-a74d-1cc60d170b1f-9","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/PLAN.md","offset":500,"limit":280}},{"type":"tool_use","id":"call-ce134aa1-48f3-4455-a74d-1cc60d170b1f-10","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.ts","limit":200}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":7716,"output_tokens":339,"cache_read_input_tokens":41216,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"80a5711f-4b4a-4c32-a0e7-5eb31ffc2208"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-ce134aa1-48f3-4455-a74d-1cc60d170b1f-8","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"350→## 10. Controls and screens\\n\\n**Pad (DualSense, or any pad in the standard mapping). This is the design target.**\\n\\n| Input | Action | Engine code |\\n|---|---|---|\\n| Left stick | Cursor | read directly (§17.4) |\\n| R2 or Cross | Use tool (hold) | `PadRightTrigger`, `PadSouth` |\\n| Right stick | Radial: push to open, aim at a tool, release to equip. Field time ×0.6 while open | `PadRightStick*` |\\n| L1 / R1 | Previous / next tool | `PadLeftShoulder`, `PadRightShoulder` |\\n360→| L2 | Precision: cursor ×0.4, stronger magnet, slight dolly-in | `PadLeftTrigger` |\\n| Triangle | Gift (and the pulse-lock beats) | `PadNorth` |\\n| Square | Quick Syringe | `PadWest` |\\n| Circle | Drop what forceps hold; cancel the radial | `PadEast` |\\n| D-pad left/right | Switch site | `PadLeft`, `PadRight` |\\n| D-pad up | Hint | `PadUp` |\\n| R3 | Swap surgeon (Cases 6 to 8) | `PadRightStick` |\\n| Options | Pause | `PadStart` |\\n| L2 + R2 | Paddles, in a Code | triggers |\\n\\n370→Menus: D-pad or left stick, Cross accepts, Circle goes back. Both sticks and triggers are analog; use dead zones. In a hub session, ignore\\nOptions while Create is held (that chord belongs to the hub).\\n\\n**Mouse and keyboard. The same game and screens, but native.**\\n\\n- **Mouse** moves the cursor absolutely, 1:1, no pointer lock, with the OS cursor hidden over the field. LMB uses the tool. **Hold RMB** for the\\n  radial at the cursor, flick and release. Wheel cycles tools. Keys **1–8** pick tools directly. The tool bar, site tabs and Board cards are clickable, and hovering a valid target highlights it. Shift: precision. Space:\\n  Gift. F: quick Syringe. R: drop. Q/E: sites. H: hint. Tab: swap. Esc: pause. LMB + RMB: paddles.\\n- **Keyboard-only** still works: WASD or arrows move the cursor, Enter uses the tool.\\n- Every menu: hover moves focus, click picks (`createMenu` already does this; do the same in custom panels). Rebinding in Settings → Controls.\\n380→\\n**Cursor feel on a pad (page-side, tune these).** Speed = `cursorSpeed × lean^2.2`. Within 0.6 m of a valid target for the current tool: velocity ×0.55 and a\\ngentle pull (the magnet). On a scalpel guide while cutting: the across-line part of stick input ×0.4 (rail assist). Suturing on a wound: a soft clamp\\nto ±0.8 m of the wound (sew assist), so you just weave. Mouse gets a light version only, at 0.2 of these strengths.\\n\\n**Prompts** follow the device used last (`input.lastDevice`). Draw your own glyph set in code (SVG/CSS): PlayStation shapes by default for **any** pad; **Settings →\\nControls → Glyphs: PlayStation / Xbox** swaps to A B X Y and LB RB LT RT. Don't use `input.prompt()` text directly, as it reads Xbox for unknown pads. Keyboard\\nshows keycaps; mouse shows mouse icons.\\n\\n**10-foot rules.** Judge every screen at 1920×1080 from a screenshot. Body text at least 32 px; instruments and menu items at least 64 px tall; thick outlines on guides\\n390→and cursor; focus state huge. One idea per screen. No tables, scrolling lists of small rows, or web-style forms.\\n\\n**In-operation HUD (at most these).** Vitals and ECG, top left, big. Clock and phase name, top centre. Score and chain, top right. Tool bar, bottom centre: 8 icons\\nat 72–96 px, current raised. Odie's line, bottom left: name, big caption, no input needed (`createDialog` with `modal: false` and `auto`). Site tabs at the edges. World labels\\nfor ratings (`ui.label`), huge and brief.\\n\\n**Screens.**\\n\\n- **Boot/Loading:** dark, lighthouse beam, status text; the engine's error text stays visible if startup fails for any other reason.\\n- **No WebGPU:** the engine has no fallback, and this cannot be left to game code. Tested: in Firefox here the bundle crashes at import (`APP_START: … \\\"VERTEX\\\", Js is undefined`), before any of your module runs; WebKit shows the engine's technical `GFX_NO_WEBGPU` text. So a **classic inline script** in the head, right after the hub client, checks `navigator.gpu`. If it is missing, it shows a large plain message saying the game needs a browser with WebGPU, adds \\\"Controller or keyboard required\\\" on a touch-only device, calls `AIHub.fail(…)` in a session, and hides the engine's text. Do the same if `__engine.errors` later holds `GFX_NO_WEBGPU` (no adapter).\\n400→- **Title:** 3D lamp-lit OR with the lighthouse beam through rain on the window; the title; Continue / New Shift / The Board / Scrub In / Settings / About. Attract after 10 s idle (§14).\\n- **The Board:** a corkboard wall. One big case card at a time, left/right to browse: patient, one line, rank, tools as icons. Postcards tab.\\n- **Story:** full 3D scene, dialogue box along the bottom third, name plate, gibberish voice; Cross advances; hold Circle to skip the scene; auto mode in Settings.\\n- **Briefing:** patient card and one sentence, tools needed, difficulty, Start.\\n- **Pause:** Resume, Retry phase, Retry case, Handbook, Settings, Controls, **Dev Mode**, Quit to Board.\\n- **Handbook** (from Pause and the Board): big paged cards showing what you can and cannot do. One per instrument (what it does, what it cannot do, its controls in the current glyphs), the Gift, flaps, sites and the Code, and one per strain once met. Built from the data, so it cannot go stale.\\n- **Settings:** pages with few big rows. Audio (Master 70%, **Music 10%**, Effects 100%, Voice 100%). Controls (glyphs, cursor speed, aim assist, rebinding, hold vs toggle for use). Gameplay\\n  (difficulty, Simple Gift, hints, text speed, auto-advance). Display (blood colour: red / teal / off, reduce flashes, text size).\\n- **Scrub In:** four big seat slots; each device claims one by pressing its accept; Start.\\n- **About/Credits:** see §21. Paged cards, one question per card.\\n410→\\n**Touch-only devices.** Detect with `matchMedia('(any-pointer: fine)')` false and no pad seen. No touch controls: put `touch=off` in the `search` you give `createEngine`, always, or the engine shows its touch layer (tested on a phone profile: `touch=off` removes it all). Show exactly **\\\"Controller or keyboard required\\\"** and a large settings button that opens Settings, which accepts taps. Attract mode runs behind it. A pad or\\nkey arriving on such a device clears the message.\\n\\n---\\n\\n## 11. Art direction\\n\\n**Base: the engine's native style.** Everything is procedural shapes from the geometry kit, materials and textures as data, puppet bodies from the body grammar. Draw it the way the engine's own clean playground look does: `resolution: 'full'`, `textures: 'smooth'`, and the `aa` filter with `scope: 'all'`, in your looks. Do **not** use the chunky default `pixels` resolution: thin surgical lines must read at 10 feet. `labs/box/looks/` has worked looks to copy from.\\n\\n420→**Looks** (`defineLook`, in `labs/game/view/looks.ts`).\\n\\n- `look:harbor` for story: clean, soft `ao`, `aa`, a thin `outline` on characters only, warm-teal `grade`, gentle `bloom`.\\n- `look:field` for operations: `style: 'pbr'` for wet highlights, `ao`, `bloom`, `aa`; performance is unlimited, so add `ssr` if it helps the wetness.\\n- Transient overlays through `post.combine`: Stillpoint (teal, desaturated, vignette), Second Pulse (amber, `speedlines`), low vitals (red vignette), Drama Cut.\\n\\n**Detail.** TASK.md's performance budget is unlimited, and FPS targets and optimisation are out of scope. Add as much geometry, effects, lights and shadows as a scene needs.\\n\\n**Palette.** Harbor Light: sea-glass teal walls, brass fittings, amber lamps, rain-blue windows. The field: cherry, salmon, ochre and plum tissue, deliberately stylised and glossy; deep teal drapes around it.\\nEach strain has its own colour that never collides with tissue: lilac, amber, ink-blue, pearl, white-gold. Guides and the cursor: bright cyan with a dark outline. Keep blood dark cherry; the option recolours it.\\n430→\\n**The operating field (the showpiece).** Built as live meshes the page rewrites each frame, tested as described in §17.3.\\n\\n- **Sheet:** a dense grid (start at 320 × 192; performance is out of scope) per site. Height = breath + heartbeat + organ bulges (ellipses from data) + raised vessels (polylines) + wound lips + Reverie's ripple. Vertex colours: organ regions, veins, bruising, numb patches, burns, Balm.\\n- **Thin-things buffers,** one live mesh per material: wet red (incision interiors, pools with wobbling edges), thread, steel and glove (hands and tools, transformed in software from templates), transparent gel and lacquer. Each has a fixed capacity.\\n- **Texture:** one `defineTexture` wet-cell pattern with a height channel, for the normal map on the sheet.\\n- **Around it:** drapes and clamps as ordinary props, framing the window; the surgical lamp's warm white light; visible shadow of your own hand on the tissue.\\n- **Hands:** a gloved right hand with the tool, following the cursor with spring lag and a tremble that grows as vitals fall. In co-op, gloves tinted by seat.\\n\\n**Parasites:** engine rigs where they fit (`crowdBody` blob with its features, and floater with its motes), so they squash, look and hop natively. Reverie and Balm live in the sheet.\\n440→\\n**Characters** (`labs/game/view/bodies/`, `defineBody` on the humanoid skeleton). A custom build, `build:drama`, on `build:adult` proportions with heads about 25% larger for readable faces at 10 feet. Hair from several parts for a strong silhouette per character. Mask, cap and gown variants for the OR. Faces through `Blink`, `LookAt` and glow eye parts.\\n\\n**Sets as prop lists** (`labs/game/data/sets/`): OR (real scale), ward, Chief's office, ship's clinic, gala hall, corridor. Walls and floors are large box props with generated tiles. The engine's library is fine for generic props; make new props for what sells the hospital: operating table, surgical lamp, IV stand, heart monitor (with a live ECG), instrument tray, gurney, corkboard, TV (playing the Halcyon ad), trumpet.\\n\\n**Effects** (`defineEmitter`): blood squirt, goo, laser smoke and sparks, gel shine, stitch snap, rain on windows, sleepy motes.\\n\\n---\\n\\n## 12. Animation\\n450→\\n**Base:** the engine's animator, actions and clip library. `node x anim find <words>` searches 1,218 readable clips; `node x new action` writes a multi-beat action from a template; bundle only the clip sets you use (see `labs/box/library.ts`).\\n\\n**Story actors** are `spawnActor` with their `body` and `anim: { build }`, not player-controlled; they play actions with `actOn` and clips with `playClip`.\\n\\n**New actions** (`labs/game/cast/actions/`), each checked with `actionCheck`: scrub hands, mask up, hand over instrument, clipboard slam, point accusingly, hands on desk (loom), collar open (reveal), collapse, despair on knees, adjust glasses, moustache rage, TV-host smile and gesture, trumpet raise, salute with scalpel, exhale in relief, double fist on the operating table.\\n\\n**Field animation (page-side, springs from the API):** tool swings, needle arcs, stitch pull-tight, heart beats locked to the ECG, breathing, flap hinge, hand tremble, the slap of a tool handed over, tissue parting with lips along an incision, ripple under the sheet.\\n\\n**Camera moves:** lamp-to-field descent at operation start, pull-back on failure, site blends, parallax ±3° with the cursor, precision dolly-in, roll hazard tilt, Drama Cut, tilt under a raised flap.\\n460→\\n---\\n\\n## 13. Audio\\n\\n**Everything is written in code; no audio files, no `<audio>` tags, no data URLs of sound.** Effects and songs are `defineSfx` and `defineSong` data; the runtime is `createAudio`. Music defaults to 10%: `audio.volume('music', 0.10)` at start, and the Settings slider shows 10%. The engine's buses are `effects`, `music`, `ui`, `ambience`; there is no voice bus, so make your own `GainNode` from `audio.context` for voices.\\n\\n**Voices are gibberish**, Animalese/Simlish style, in `labs/game/audio/voice.ts`. At startup, render syllable buffers per character with an `OfflineAudioContext`: 16 syllables from a sawtooth through 2–3 formant filters plus a little noise. For each spoken character, play a syllable chosen by hashing the letter (the same line always sounds the same). Per character: base pitch, formant set, speed, breathiness. `?` rises, `!` is louder and higher, CAPS are louder, commas pause. Mercy's choir and Voss's jingle use the same engine, sung to notes.\\n\\n**Effects.** Every tool has a signature (cut: wet zip; stitch: tug-snip; drain: gurgling suction with pitch following pool size; laser: sizzle hum; syringe: glass tick; gel: squelch; scanner: sonar ping; forceps: click and pull; tool handover: clack). Monitor beep at the real heart rate, pitch falling with vitals; flat tone; alarm. Ratings have rising stingers. Each strain has its 3-note signature. Rain and ship creak as ambience.\\n470→\\n**Music (`defineSong`, with `intensity` layers driven by vitals and danger).** OR calm → OR tension → strain; Mercy's hymn (finale); story soft theme; title theme; Halcyon jingle (comic, played on TVs); success fanfare; failed motif. Energetic, operatic and synth-orchestral, original. Duck music under voices and key alarms.\\n\\n**Check by numbers.** Render effects with `node x audio sfx:<id>`; in a page, read levels from an `AnalyserNode` and confirm music is on at default volume but quiet.\\n\\n---\\n\\n## 14. Attract mode\\n\\nAfter **10 s with no input** on the title or any front-end menu (not in a rebind prompt): fade out and start the looping demo. **Any** input (key, mouse move or click, pad button, or stick past its dead zone) exits at once back to the title. Timer resets on any input.\\n480→\\nThe loop shows as much of the game as it can, about 3 minutes, each clip a real run driven by the bot with `game.attract=true` (cheats on: no failure, infinite Gift, the clock frozen when needed):\\n\\nTitle logo 6 s → Case 1 stitching → Case 3 site triage and Stillpoint → a story scene with a Drama Cut → Case 5 Solace splits under Second Pulse with the ship rolling → Case 6 Scanner and flap, with the AI colleague → Case 7 three tables → Case 8 Mercy's Code → postcards → loop.\\n\\nA \\\"DEMO\\\" banner and a large prompt to press a button. Save nothing during attract (`createStore` mode `demo`). On touch-only devices it just keeps running behind the message. Never in a hub session.\\n\\n---\\n\\n## 15. Dev mode\\n490→\\nFrom the pause menu (\\\"Dev Mode\\\"), always available in this demo, drivable with pad, mouse and keyboard. Big rows, tabs across the top. Dev runs save no scores or ranks.\\n\\n- **Play:** jump to any case and phase; win phase; fail phase; restore vitals; freeze vitals; freeze clock; infinite Gift; one-hit parasites; spawn any target or strain at the cursor; unlock all; autoplay (bot on seat 0); time scale ¼× to 4×; frame step; set seed; add a bot surgeon.\\n- **Balance:** the live sliders of Appendix A, each with its value, and **Reset to defaults** per slider and for all. They write `inspector.set(key, value)`, so replays record them.\\n- **View:** hide HUD; show target and hit shapes; show cursor assist; free camera; look picker; performance counters from `__engine.stats()`.\\n- **Author:** path tool: hold a button and draw on the field, then copy the polyline as data for a case file. Shows cursor coordinates.\\n- **Data:** event log; state hash; copy `input.record()` as a replay.\\n\\nSim-changing tools go through `defineDevAction`, so replays hold them.\\n500→\\n---\\n\\n## 16. Multiplayer\\n\\nFollow the AI Hub Session Protocol v1 (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); read it in full. Client `session.js` is version 1.4.0 at the time of writing. **Mode: `shared-world`.**\\n\\n**Head tags.**\\n\\n```html\\n510→<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"5\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Keep the patient alive and finish the op together\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Aim: stick or mouse · use tool: R2 or click · tools: right stick or 1-8\\\">\\n<meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">\\n```\\n\\nPaste `session.js` unmodified as the first script, right after `<meta charset>`.\\n520→\\n**In a session (`AIHub.active`).**\\n\\n- No title or menus. Boot in the order below; on `connect` giving `null`, run as on its own.\\n- **Own card** (\\\"Pre-op briefing\\\"): a 3D OR team shot with HTML over it, showing the game's name, every player in their colour and who is ready, how to win, this player's controls, and the time left from the `card` event. Ready: Enter, Cross or a click → `AIHub.answer('ready')`. More time: Triangle, T or a click → `AIHub.answer('more')`. Nothing on it changes the round.\\n- `AIHub.ready()` once, with no press, as soon as the sim can run (below). `AIHub.fail(msg)` if WebGPU is missing.\\n- `start` then a 3 s countdown from `AIHub.time()`; play at `time() >= 0`. Run `case:gala-shift` with seed `info.seed` (the same on every copy), seats = players. A lone player gets the AI colleague, added by the host.\\n- Host calls `AIHub.finish({ standings, scores, won, stats, awards })` once, listing every remaining player: best score first, ties grouped. `won` is the team result. On `time-up`, finish within `graceMs` with `won: false`. Each result shows slips, best chain and an award (\\\"Steadiest hands\\\").\\n- On `end`: stop input and sound. On `leave`: that seat's hand drops, and the bot does not take it over. Names only through `textContent`. Pause shows Settings over the running game and never pauses. No quitting. No `alert`, `confirm`, `prompt`, popups, navigation, or network other than the hub's.\\n- `AIHub.server`: the host's copy has no player, camera or input, and draws nothing. The same host code runs the world. Prefer `createHeadless` there, or stop drawing; the prototype passed with the full engine, so this is not a blocker.\",\"content_concise\":\"350→## 10. Controls and screens\\n\\n**Pad (DualSense, or any pad in the standard mapping). This is the design target.**\\n\\n| Input | Action | Engine code |\\n|---|---|---|\\n| Left stick | Cursor | read directly (§17.4) |\\n| R2 or Cross | Use tool (hold) | `PadRightTrigger`, `PadSouth` |\\n| Right stick | Radial: push to open, aim at a tool, release to equip. Field time ×0.6 while open | `PadRightStick*` |\\n| L1 / R1 | Previous / next tool | `PadLeftShoulder`, `PadRightShoulder` |\\n360→| L2 | Precision: cursor ×0.4, stronger magnet, slight dolly-in | `PadLeftTrigger` |\\n| Triangle | Gift (and the pulse-lock beats) | `PadNorth` |\\n| Square | Quick Syringe | `PadWest` |\\n| Circle | Drop what forceps hold; cancel the radial | `PadEast` |\\n| D-pad left/right | Switch site | `PadLeft`, `PadRight` |\\n| D-pad up | Hint | `PadUp` |\\n| R3 | Swap surgeon (Cases 6 to 8) | `PadRightStick` |\\n| Options | Pause | `PadStart` |\\n| L2 + R2 | Paddles, in a Code | triggers |\\n\\n370→Menus: D-pad or left stick, Cross accepts, Circle goes back. Both sticks and triggers are analog; use dead zones. In a hub session, ignore\\nOptions while Create is held (that chord belongs to the hub).\\n\\n**Mouse and keyboard. The same game and screens, but native.**\\n\\n- **Mouse** moves the cursor absolutely, 1:1, no pointer lock, with the OS cursor hidden over the field. LMB uses the tool. **Hold RMB** for the\\n  radial at the cursor, flick and release. Wheel cycles tools. Keys **1–8** pick tools directly. The tool bar, site tabs and Board cards are clickable, and hovering a valid target highlights it. Shift: precision. Space:\\n  Gift. F: quick Syringe. R: drop. Q/E: sites. H: hint. Tab: swap. Esc: pause. LMB + RMB: paddles.\\n- **Keyboard-only** still works: WASD or arrows move the cursor, Enter uses the tool.\\n- Every menu: hover moves focus, click picks (`createMenu` already does this; do the same in custom panels). Rebinding in Settings → Controls.\\n380→\\n**Cursor feel on a pad (page-side, tune these).** Speed = `cursorSpeed × lean^2.2`. Within 0.6 m of a valid target for the current tool: velocity ×0.55 and a\\ngentle pull (the magnet). On a scalpel guide while cutting: the across-line part of stick input ×0.4 (rail assist). Suturing on a wound: a soft clamp\\nto ±0.8 m of the wound (sew assist), so you just weave. Mouse gets a light version only, at 0.2 of these strengths.\\n\\n**Prompts** follow the device used last (`input.lastDevice`). Draw your own glyph set in code (SVG/CSS): PlayStation shapes by default for **any** pad; **Settings →\\nControls → Glyphs: PlayStation / Xbox** swaps to A B X Y and LB RB LT RT. Don't use `input.prompt()` text directly, as it reads Xbox for unknown pads. Keyboard\\nshows keycaps; mouse shows mouse icons.\\n\\n**10-foot rules.** Judge every screen at 1920×1080 from a screenshot. Body text at least 32 px; instruments and menu items at least 64 px tall; thick outlines on guides\\n390→and cursor; focus state huge. One idea per screen. No tables, scrolling lists of small rows, or web-style forms.\\n\\n**In-operation HUD (at most these).** Vitals and ECG, top left, big. Clock and phase name, top centre. Score and chain, top right. Tool bar, bottom centre: 8 icons\\nat 72–96 px, current raised. Odie's line, bottom left: name, big caption, no input needed (`createDialog` with `modal: false` and `auto`). Site tabs at the edges. World labels\\nfor ratings (`ui.label`), huge and brief.\\n\\n**Screens.**\\n\\n- **Boot/Loading:** dark, lighthouse beam, status text; the engine's error text stays visible if startup fails for any other reason.\\n- **No WebGPU:** the engine has no fallback, and this cannot be left to game code. Tested: in Firefox here the bundle crashes at import (`APP_START: … \\\"VERTEX\\\", Js is undefined`), before any of your module runs; WebKit shows the engine's technical `GFX_NO_WEBGPU` text. So a **classic inline script** in the head, right after the hub client, checks `navigator.gpu`. If it is missing, it shows a large plain message saying the game needs a browser with WebGPU, adds \\\"Controller or keyboard required\\\" on a touch-only device, calls `AIHub.fail(…)` in a session, and hides the engine's text. Do the same if `__engine.errors` later holds `GFX_NO_WEBGPU` (no adapter).\\n400→- **Title:** 3D lamp-lit OR with the lighthouse beam through rain on the window; the title; Continue / New Shift / The Board / Scrub In / Settings / About. Attract after 10 s idle (§14).\\n- **The Board:** a corkboard wall. One big case card at a time, left/right to browse: patient, one line, rank, tools as icons. Postcards tab.\\n- **Story:** full 3D scene, dialogue box along the bottom third, name plate, gibberish voice; Cross advances; hold Circle to skip the scene; auto mode in Settings.\\n- **Briefing:** patient card and one sentence, tools needed, difficulty, Start.\\n- **Pause:** Resume, Retry phase, Retry case, Handbook, Settings, Controls, **Dev Mode**, Quit to Board.\\n- **Handbook** (from Pause and the Board): big paged cards showing what you can and cannot do. One per instrument (what it does, what it cannot do, its controls in the current glyphs), the Gift, flaps, sites and the Code, and one per strain once met. Built from the data, so it cannot go stale.\\n- **Settings:** pages with few big rows. Audio (Master 70%, **Music 10%**, Effects 100%, Voice 100%). Controls (glyphs, cursor speed, aim assist, rebinding, hold vs toggle for use). Gameplay\\n  (difficulty, Simple Gift, hints, text speed, auto-advance). Display (blood colour: red / teal / off, reduce flashes, text size).\\n- **Scrub In:** four big seat slots; each device claims one by pressing its accept; Start.\\n- **About/Credits:** see §21. Paged cards, one question per card.\\n410→\\n**Touch-only devices.** Detect with `matchMedia('(any-pointer: fine)')` false and no pad seen. No touch controls: put `touch=off` in the `search` you give `createEngine`, always, or the engine shows its touch layer (tested on a phone profile: `touch=off` removes it all). Show exactly **\\\"Controller or keyboard required\\\"** and a large settings button that opens Settings, which accepts taps. Attract mode runs behind it. A pad or\\nkey arriving on such a device clears the message.\\n\\n---\\n\\n## 11. Art direction\\n\\n**Base: the engine's native style.** Everything is procedural shapes from the geometry kit, materials and textures as data, puppet bodies from the body grammar. Draw it the way the engine's own clean playground look does: `resolution: 'full'`, `textures: 'smooth'`, and the `aa` filter with `scope: 'all'`, in your looks. Do **not** use the chunky default `pixels` resolution: thin surgical lines must read at 10 feet. `labs/box/looks/` has worked looks to copy from.\\n\\n420→**Looks** (`defineLook`, in `labs/game/view/looks.ts`).\\n\\n- `look:harbor` for story: clean, soft `ao`, `aa`, a thin `outline` on characters only, warm-teal `grade`, gentle `bloom`.\\n- `look:field` for operations: `style: 'pbr'` for wet highlights, `ao`, `bloom`, `aa`; performance is unlimited, so add `ssr` if it helps the wetness.\\n- Transient overlays through `post.combine`: Stillpoint (teal, desaturated, vignette), Second Pulse (amber, `speedlines`), low vitals (red vignette), Drama Cut.\\n\\n**Detail.** TASK.md's performance budget is unlimited, and FPS targets and optimisation are out of scope. Add as much geometry, effects, lights and shadows as a scene needs.\\n\\n**Palette.** Harbor Light: sea-glass teal walls, brass fittings, amber lamps, rain-blue windows. The field: cherry, salmon, ochre and plum tissue, deliberately stylised and glossy; deep teal drapes around it.\\nEach strain has its own colour that never collides with tissue: lilac, amber, ink-blue, pearl, white-gold. Guides and the cursor: bright cyan with a dark outline. Keep blood dark cherry; the option recolours it.\\n430→\\n**The operating field (the showpiece).** Built as live meshes the page rewrites each frame, tested as described in §17.3.\\n\\n- **Sheet:** a dense grid (start at 320 × 192; performance is out of scope) per site. Height = breath + heartbeat + organ bulges (ellipses from data) + raised vessels (polylines) + wound lips + Reverie's ripple. Vertex colours: organ regions, veins, bruising, numb patches, burns, Balm.\\n- **Thin-things buffers,** one live mesh per material: wet red (incision interiors, pools with wobbling edges), thread, steel and glove (hands and tools, transformed in software from templates), transparent gel and lacquer. Each has a fixed capacity.\\n- **Texture:** one `defineTexture` wet-cell pattern with a height channel, for the normal map on the sheet.\\n- **Around it:** drapes and clamps as ordinary props, framing the window; the surgical lamp's warm white light; visible shadow of your own hand on the tissue.\\n- **Hands:** a gloved right hand with the tool, following the cursor with spring lag and a tremble that grows as vitals fall. In co-op, gloves tinted by seat.\\n\\n**Parasites:** engine rigs where they fit (`crowdBody` blob with its features, and floater with its motes), so they squash, look and hop natively. Reverie and Balm live in the sheet.\\n440→\\n**Characters** (`labs/game/view/bodies/`, `defineBody` on the humanoid skeleton). A custom build, `build:drama`, on `build:adult` proportions with heads about 25% larger for readable faces at 10 feet. Hair from several parts for a strong silhouette per character. Mask, cap and gown variants for the OR. Faces through `Blink`, `LookAt` and glow eye parts.\\n\\n**Sets as prop lists** (`labs/game/data/sets/`): OR (real scale), ward, Chief's office, ship's clinic, gala hall, corridor. Walls and floors are large box props with generated tiles. The engine's library is fine for generic props; make new props for what sells the hospital: operating table, surgical lamp, IV stand, heart monitor (with a live ECG), instrument tray, gurney, corkboard, TV (playing the Halcyon ad), trumpet.\\n\\n**Effects** (`defineEmitter`): blood squirt, goo, laser smoke and sparks, gel shine, stitch snap, rain on windows, sleepy motes.\\n\\n---\\n\\n## 12. Animation\\n450→\\n**Base:** the engine's animator, actions and clip library. `node x anim find <words>` searches 1,218 readable clips; `node x new action` writes a multi-beat action from a template; bundle only the clip sets you use (see `labs/box/library.ts`).\\n\\n**Story actors** are `spawnActor` with their `body` and `anim: { build }`, not player-controlled; they play actions with `actOn` and clips with `playClip`.\\n\\n**New actions** (`labs/game/cast/actions/`), each checked with `actionCheck`: scrub hands, mask up, hand over instrument, clipboard slam, point accusingly, hands on desk (loom), collar open (reveal), collapse, despair on knees, adjust glasses, moustache rage, TV-host smile and gesture, trumpet raise, salute with scalpel, exhale in relief, double fist on the operating table.\\n\\n**Field animation (page-side, springs from the API):** tool swings, needle arcs, stitch pull-tight, heart beats locked to the ECG, breathing, flap hinge, hand tremble, the slap of a tool handed over, tissue parting with lips along an incision, ripple under the sheet.\\n\\n**Camera moves:** lamp-to-field descent at operation start, pull-back on failure, site blends, parallax ±3° with the cursor, precision dolly-in, roll hazard tilt, Drama Cut, tilt under a raised flap.\\n460→\\n---\\n\\n## 13. Audio\\n\\n**Everything is written in code; no audio files, no `<audio>` tags, no data URLs of sound.** Effects and songs are `defineSfx` and `defineSong` data; the runtime is `createAudio`. Music defaults to 10%: `audio.volume('music', 0.10)` at start, and the Settings slider shows 10%. The engine's buses are `effects`, `music`, `ui`, `ambience`; there is no voice bus, so make your own `GainNode` from `audio.context` for voices.\\n\\n**Voices are gibberish**, Animalese/Simlish style, in `labs/game/audio/voice.ts`. At startup, render syllable buffers per character with an `OfflineAudioContext`: 16 syllables from a sawtooth through 2–3 formant filters plus a little noise. For each spoken character, play a syllable chosen by hashing the letter (the same line always sounds the same). Per character: base pitch, formant set, speed, breathiness. `?` rises, `!` is louder and higher, CAPS are louder, commas pause. Mercy's choir and Voss's jingle use the same engine, sung to notes.\\n\\n**Effects.** Every tool has a signature (cut: wet zip; stitch: tug-snip; drain: gurgling suction with pitch following pool size; laser: sizzle hum; syringe: glass tick; gel: squelch; scanner: sonar ping; forceps: click and pull; tool handover: clack). Monitor beep at the real heart rate, pitch falling with vitals; flat tone; alarm. Ratings have rising stingers. Each strain has its 3-note signature. Rain and ship creak as ambience.\\n470→\\n**Music (`defineSong`, with `intensity` layers driven by vitals and danger).** OR calm → OR tension → strain; Mercy's hymn (finale); story soft theme; title theme; Halcyon jingle (comic, played on TVs); success fanfare; failed motif. Energetic, operatic and synth-orchestral, original. Duck music under voices and key alarms.\\n\\n**Check by numbers.** Render effects with `node x audio sfx:<id>`; in a page, read levels from an `AnalyserNode` and confirm music is on at default volume but quiet.\\n\\n---\\n\\n## 14. Attract mode\\n\\nAfter **10 s with no input** on the title or any front-end menu (not in a rebind prompt): fade out and start the looping demo. **Any** input (key, mouse move or click, pad button, or stick past its dead zone) exits at once back to the title. Timer resets on any input.\\n480→\\nThe loop shows as much of the game as it can, about 3 minutes, each clip a real run driven by the bot with `game.attract=true` (cheats on: no failure, infinite Gift, the clock frozen when needed):\\n\\nTitle logo 6 s → Case 1 stitching → Case 3 site triage and Stillpoint → a story scene with a Drama Cut → Case 5 Solace splits under Second Pulse with the ship rolling → Case 6 Scanner and flap, with the AI colleague → Case 7 three tables → Case 8 Mercy's Code → postcards → loop.\\n\\nA \\\"DEMO\\\" banner and a large prompt to press a button. Save nothing during attract (`createStore` mode `demo`). On touch-only devices it just keeps running behind the message. Never in a hub session.\\n\\n---\\n\\n## 15. Dev mode\\n490→\\nFrom the pause menu (\\\"Dev Mode\\\"), always available in this demo, drivable with pad, mouse and keyboard. Big rows, tabs across the top. Dev runs save no scores or ranks.\\n\\n- **Play:** jump to any case and phase; win phase; fail phase; restore vitals; freeze vitals; freeze clock; infinite Gift; one-hit parasites; spawn any target or strain at the cursor; unlock all; autoplay (bot on seat 0); time scale ¼× to 4×; frame step; set seed; add a bot surgeon.\\n- **Balance:** the live sliders of Appendix A, each with its value, and **Reset to defaults** per slider and for all. They write `inspector.set(key, value)`, so replays record them.\\n- **View:** hide HUD; show target and hit shapes; show cursor assist; free camera; look picker; performance counters from `__engine.stats()`.\\n- **Author:** path tool: hold a button and draw on the field, then copy the polyline as data for a case file. Shows cursor coordinates.\\n- **Data:** event log; state hash; copy `input.record()` as a replay.\\n\\nSim-changing tools go through `defineDevAction`, so replays hold them.\\n500→\\n---\\n\\n## 16. Multiplayer\\n\\nFollow the AI Hub Session Protocol v1 (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); read it in full. Client `session.js` is version 1.4.0 at the time of writing. **Mode: `shared-world`.**\\n\\n**Head tags.**\\n\\n```html\\n510→<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"5\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Keep the patient alive and finish the op together\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Aim: stick or mouse · use tool: R2 or click · tools: right stick or 1-8\\\">\\n<meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">\\n```\\n\\nPaste `session.js` unmodified as the first script, right after `<meta charset>`.\\n520→\\n**In a session (`AIHub.active`).**\\n\\n- No title or menus. Boot in the order below; on `connect` giving `null`, run as on its own.\\n- **Own card** (\\\"Pre-op briefing\\\"): a 3D OR team shot with HTML over it, showing the game's name, every player in their colour and who is ready, how to win, this player's controls, and the time left from the `card` event. Ready: Enter, Cross or a click → `AIHub.answer('ready')`. More time: Triangle, T or a click → `AIHub.answer('more')`. Nothing on it changes the round.\\n- `AIHub.ready()` once, with no press, as soon as the sim can run (below). `AIHub.fail(msg)` if WebGPU is missing.\\n- `start` then a 3 s countdown from `AIHub.time()`; play at `time() >= 0`. Run `case:gala-shift` with seed `info.seed` (the same on every copy), seats = players. A lone player gets the AI colleague, added by the host.\\n- Host calls `AIHub.finish({ standings, scores, won, stats, awards })` once, listing every remaining player: best score first, ties grouped. `won` is the team result. On `time-up`, finish within `graceMs` with `won: false`. Each result shows slips, best chain and an award (\\\"Steadiest hands\\\").\\n- On `end`: stop input and sound. On `leave`: that seat's hand drops, and the bot does not take it over. Names only through `textContent`. Pause shows Settings over the running game and never pauses. No quitting. No `alert`, `confirm`, `prompt`, popups, navigation, or network other than the hub's.\\n- `AIHub.server`: the host's copy has no player, camera or input, and draws nothing. The same host code runs the world. Prefer `createHeadless` there, or stop drawing; the prototype passed with the full engine, so this is not a blocker.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/PLAN.md\",\"offset\":350,\"limit\":180,\"raw_output\":\"## 10. Controls and screens\\n\\n**Pad (DualSense, or any pad in the standard mapping). This is the design target.**\\n\\n| Input | Action | Engine code |\\n|---|---|---|\\n| Left stick | Cursor | read directly (§17.4) |\\n| R2 or Cross | Use tool (hold) | `PadRightTrigger`, `PadSouth` |\\n| Right stick | Radial: push to open, aim at a tool, release to equip. Field time ×0.6 while open | `PadRightStick*` |\\n| L1 / R1 | Previous / next tool | `PadLeftShoulder`, `PadRightShoulder` |\\n| L2 | Precision: cursor ×0.4, stronger magnet, slight dolly-in | `PadLeftTrigger` |\\n| Triangle | Gift (and the pulse-lock beats) | `PadNorth` |\\n| Square | Quick Syringe | `PadWest` |\\n| Circle | Drop what forceps hold; cancel the radial | `PadEast` |\\n| D-pad left/right | Switch site | `PadLeft`, `PadRight` |\\n| D-pad up | Hint | `PadUp` |\\n| R3 | Swap surgeon (Cases 6 to 8) | `PadRightStick` |\\n| Options | Pause | `PadStart` |\\n| L2 + R2 | Paddles, in a Code | triggers |\\n\\nMenus: D-pad or left stick, Cross accepts, Circle goes back. Both sticks and triggers are analog; use dead zones. In a hub session, ignore\\nOptions while Create is held (that chord belongs to the hub).\\n\\n**Mouse and keyboard. The same game and screens, but native.**\\n\\n- **Mouse** moves the cursor absolutely, 1:1, no pointer lock, with the OS cursor hidden over the field. LMB uses the tool. **Hold RMB** for the\\n  radial at the cursor, flick and release. Wheel cycles tools. Keys **1–8** pick tools directly. The tool bar, site tabs and Board cards are clickable, and hovering a valid target highlights it. Shift: precision. Space:\\n  Gift. F: quick Syringe. R: drop. Q/E: sites. H: hint. Tab: swap. Esc: pause. LMB + RMB: paddles.\\n- **Keyboard-only** still works: WASD or arrows move the cursor, Enter uses the tool.\\n- Every menu: hover moves focus, click picks (`createMenu` already does this; do the same in custom panels). Rebinding in Settings → Controls.\\n\\n**Cursor feel on a pad (page-side, tune these).** Speed = `cursorSpeed × lean^2.2`. Within 0.6 m of a valid target for the current tool: velocity ×0.55 and a\\ngentle pull (the magnet). On a scalpel guide while cutting: the across-line part of stick input ×0.4 (rail assist). Suturing on a wound: a soft clamp\\nto ±0.8 m of the wound (sew assist), so you just weave. Mouse gets a light version only, at 0.2 of these strengths.\\n\\n**Prompts** follow the device used last (`input.lastDevice`). Draw your own glyph set in code (SVG/CSS): PlayStation shapes by default for **any** pad; **Settings →\\nControls → Glyphs: PlayStation / Xbox** swaps to A B X Y and LB RB LT RT. Don't use `input.prompt()` text directly, as it reads Xbox for unknown pads. Keyboard\\nshows keycaps; mouse shows mouse icons.\\n\\n**10-foot rules.** Judge every screen at 1920×1080 from a screenshot. Body text at least 32 px; instruments and menu items at least 64 px tall; thick outlines on guides\\nand cursor; focus state huge. One idea per screen. No tables, scrolling lists of small rows, or web-style forms.\\n\\n**In-operation HUD (at most these).** Vitals and ECG, top left, big. Clock and phase name, top centre. Score and chain, top right. Tool bar, bottom centre: 8 icons\\nat 72–96 px, current raised. Odie's line, bottom left: name, big caption, no input needed (`createDialog` with `modal: false` and `auto`). Site tabs at the edges. World labels\\nfor ratings (`ui.label`), huge and brief.\\n\\n**Screens.**\\n\\n- **Boot/Loading:** dark, lighthouse beam, status text; the engine's error text stays visible if startup fails for any other reason.\\n- **No WebGPU:** the engine has no fallback, and this cannot be left to game code. Tested: in Firefox here the bundle crashes at import (`APP_START: … \\\"VERTEX\\\", Js is undefined`), before any of your module runs; WebKit shows the engine's technical `GFX_NO_WEBGPU` text. So a **classic inline script** in the head, right after the hub client, checks `navigator.gpu`. If it is missing, it shows a large plain message saying the game needs a browser with WebGPU, adds \\\"Controller or keyboard required\\\" on a touch-only device, calls `AIHub.fail(…)` in a session, and hides the engine's text. Do the same if `__engine.errors` later holds `GFX_NO_WEBGPU` (no adapter).\\n- **Title:** 3D lamp-lit OR with the lighthouse beam through rain on the window; the title; Continue / New Shift / The Board / Scrub In / Settings / About. Attract after 10 s idle (§14).\\n- **The Board:** a corkboard wall. One big case card at a time, left/right to browse: patient, one line, rank, tools as icons. Postcards tab.\\n- **Story:** full 3D scene, dialogue box along the bottom third, name plate, gibberish voice; Cross advances; hold Circle to skip the scene; auto mode in Settings.\\n- **Briefing:** patient card and one sentence, tools needed, difficulty, Start.\\n- **Pause:** Resume, Retry phase, Retry case, Handbook, Settings, Controls, **Dev Mode**, Quit to Board.\\n- **Handbook** (from Pause and the Board): big paged cards showing what you can and cannot do. One per instrument (what it does, what it cannot do, its controls in the current glyphs), the Gift, flaps, sites and the Code, and one per strain once met. Built from the data, so it cannot go stale.\\n- **Settings:** pages with few big rows. Audio (Master 70%, **Music 10%**, Effects 100%, Voice 100%). Controls (glyphs, cursor speed, aim assist, rebinding, hold vs toggle for use). Gameplay\\n  (difficulty, Simple Gift, hints, text speed, auto-advance). Display (blood colour: red / teal / off, reduce flashes, text size).\\n- **Scrub In:** four big seat slots; each device claims one by pressing its accept; Start.\\n- **About/Credits:** see §21. Paged cards, one question per card.\\n\\n**Touch-only devices.** Detect with `matchMedia('(any-pointer: fine)')` false and no pad seen. No touch controls: put `touch=off` in the `search` you give `createEngine`, always, or the engine shows its touch layer (tested on a phone profile: `touch=off` removes it all). Show exactly **\\\"Controller or keyboard required\\\"** and a large settings button that opens Settings, which accepts taps. Attract mode runs behind it. A pad or\\nkey arriving on such a device clears the message.\\n\\n---\\n\\n## 11. Art direction\\n\\n**Base: the engine's native style.** Everything is procedural shapes from the geometry kit, materials and textures as data, puppet bodies from the body grammar. Draw it the way the engine's own clean playground look does: `resolution: 'full'`, `textures: 'smooth'`, and the `aa` filter with `scope: 'all'`, in your looks. Do **not** use the chunky default `pixels` resolution: thin surgical lines must read at 10 feet. `labs/box/looks/` has worked looks to copy from.\\n\\n**Looks** (`defineLook`, in `labs/game/view/looks.ts`).\\n\\n- `look:harbor` for story: clean, soft `ao`, `aa`, a thin `outline` on characters only, warm-teal `grade`, gentle `bloom`.\\n- `look:field` for operations: `style: 'pbr'` for wet highlights, `ao`, `bloom`, `aa`; performance is unlimited, so add `ssr` if it helps the wetness.\\n- Transient overlays through `post.combine`: Stillpoint (teal, desaturated, vignette), Second Pulse (amber, `speedlines`), low vitals (red vignette), Drama Cut.\\n\\n**Detail.** TASK.md's performance budget is unlimited, and FPS targets and optimisation are out of scope. Add as much geometry, effects, lights and shadows as a scene needs.\\n\\n**Palette.** Harbor Light: sea-glass teal walls, brass fittings, amber lamps, rain-blue windows. The field: cherry, salmon, ochre and plum tissue, deliberately stylised and glossy; deep teal drapes around it.\\nEach strain has its own colour that never collides with tissue: lilac, amber, ink-blue, pearl, white-gold. Guides and the cursor: bright cyan with a dark outline. Keep blood dark cherry; the option recolours it.\\n\\n**The operating field (the showpiece).** Built as live meshes the page rewrites each frame, tested as described in §17.3.\\n\\n- **Sheet:** a dense grid (start at 320 × 192; performance is out of scope) per site. Height = breath + heartbeat + organ bulges (ellipses from data) + raised vessels (polylines) + wound lips + Reverie's ripple. Vertex colours: organ regions, veins, bruising, numb patches, burns, Balm.\\n- **Thin-things buffers,** one live mesh per material: wet red (incision interiors, pools with wobbling edges), thread, steel and glove (hands and tools, transformed in software from templates), transparent gel and lacquer. Each has a fixed capacity.\\n- **Texture:** one `defineTexture` wet-cell pattern with a height channel, for the normal map on the sheet.\\n- **Around it:** drapes and clamps as ordinary props, framing the window; the surgical lamp's warm white light; visible shadow of your own hand on the tissue.\\n- **Hands:** a gloved right hand with the tool, following the cursor with spring lag and a tremble that grows as vitals fall. In co-op, gloves tinted by seat.\\n\\n**Parasites:** engine rigs where they fit (`crowdBody` blob with its features, and floater with its motes), so they squash, look and hop natively. Reverie and Balm live in the sheet.\\n\\n**Characters** (`labs/game/view/bodies/`, `defineBody` on the humanoid skeleton). A custom build, `build:drama`, on `build:adult` proportions with heads about 25% larger for readable faces at 10 feet. Hair from several parts for a strong silhouette per character. Mask, cap and gown variants for the OR. Faces through `Blink`, `LookAt` and glow eye parts.\\n\\n**Sets as prop lists** (`labs/game/data/sets/`): OR (real scale), ward, Chief's office, ship's clinic, gala hall, corridor. Walls and floors are large box props with generated tiles. The engine's library is fine for generic props; make new props for what sells the hospital: operating table, surgical lamp, IV stand, heart monitor (with a live ECG), instrument tray, gurney, corkboard, TV (playing the Halcyon ad), trumpet.\\n\\n**Effects** (`defineEmitter`): blood squirt, goo, laser smoke and sparks, gel shine, stitch snap, rain on windows, sleepy motes.\\n\\n---\\n\\n## 12. Animation\\n\\n**Base:** the engine's animator, actions and clip library. `node x anim find <words>` searches 1,218 readable clips; `node x new action` writes a multi-beat action from a template; bundle only the clip sets you use (see `labs/box/library.ts`).\\n\\n**Story actors** are `spawnActor` with their `body` and `anim: { build }`, not player-controlled; they play actions with `actOn` and clips with `playClip`.\\n\\n**New actions** (`labs/game/cast/actions/`), each checked with `actionCheck`: scrub hands, mask up, hand over instrument, clipboard slam, point accusingly, hands on desk (loom), collar open (reveal), collapse, despair on knees, adjust glasses, moustache rage, TV-host smile and gesture, trumpet raise, salute with scalpel, exhale in relief, double fist on the operating table.\\n\\n**Field animation (page-side, springs from the API):** tool swings, needle arcs, stitch pull-tight, heart beats locked to the ECG, breathing, flap hinge, hand tremble, the slap of a tool handed over, tissue parting with lips along an incision, ripple under the sheet.\\n\\n**Camera moves:** lamp-to-field descent at operation start, pull-back on failure, site blends, parallax ±3° with the cursor, precision dolly-in, roll hazard tilt, Drama Cut, tilt under a raised flap.\\n\\n---\\n\\n## 13. Audio\\n\\n**Everything is written in code; no audio files, no `<audio>` tags, no data URLs of sound.** Effects and songs are `defineSfx` and `defineSong` data; the runtime is `createAudio`. Music defaults to 10%: `audio.volume('music', 0.10)` at start, and the Settings slider shows 10%. The engine's buses are `effects`, `music`, `ui`, `ambience`; there is no voice bus, so make your own `GainNode` from `audio.context` for voices.\\n\\n**Voices are gibberish**, Animalese/Simlish style, in `labs/game/audio/voice.ts`. At startup, render syllable buffers per character with an `OfflineAudioContext`: 16 syllables from a sawtooth through 2–3 formant filters plus a little noise. For each spoken character, play a syllable chosen by hashing the letter (the same line always sounds the same). Per character: base pitch, formant set, speed, breathiness. `?` rises, `!` is louder and higher, CAPS are louder, commas pause. Mercy's choir and Voss's jingle use the same engine, sung to notes.\\n\\n**Effects.** Every tool has a signature (cut: wet zip; stitch: tug-snip; drain: gurgling suction with pitch following pool size; laser: sizzle hum; syringe: glass tick; gel: squelch; scanner: sonar ping; forceps: click and pull; tool handover: clack). Monitor beep at the real heart rate, pitch falling with vitals; flat tone; alarm. Ratings have rising stingers. Each strain has its 3-note signature. Rain and ship creak as ambience.\\n\\n**Music (`defineSong`, with `intensity` layers driven by vitals and danger).** OR calm → OR tension → strain; Mercy's hymn (finale); story soft theme; title theme; Halcyon jingle (comic, played on TVs); success fanfare; failed motif. Energetic, operatic and synth-orchestral, original. Duck music under voices and key alarms.\\n\\n**Check by numbers.** Render effects with `node x audio sfx:<id>`; in a page, read levels from an `AnalyserNode` and confirm music is on at default volume but quiet.\\n\\n---\\n\\n## 14. Attract mode\\n\\nAfter **10 s with no input** on the title or any front-end menu (not in a rebind prompt): fade out and start the looping demo. **Any** input (key, mouse move or click, pad button, or stick past its dead zone) exits at once back to the title. Timer resets on any input.\\n\\nThe loop shows as much of the game as it can, about 3 minutes, each clip a real run driven by the bot with `game.attract=true` (cheats on: no failure, infinite Gift, the clock frozen when needed):\\n\\nTitle logo 6 s → Case 1 stitching → Case 3 site triage and Stillpoint → a story scene with a Drama Cut → Case 5 Solace splits under Second Pulse with the ship rolling → Case 6 Scanner and flap, with the AI colleague → Case 7 three tables → Case 8 Mercy's Code → postcards → loop.\\n\\nA \\\"DEMO\\\" banner and a large prompt to press a button. Save nothing during attract (`createStore` mode `demo`). On touch-only devices it just keeps running behind the message. Never in a hub session.\\n\\n---\\n\\n## 15. Dev mode\\n\\nFrom the pause menu (\\\"Dev Mode\\\"), always available in this demo, drivable with pad, mouse and keyboard. Big rows, tabs across the top. Dev runs save no scores or ranks.\\n\\n- **Play:** jump to any case and phase; win phase; fail phase; restore vitals; freeze vitals; freeze clock; infinite Gift; one-hit parasites; spawn any target or strain at the cursor; unlock all; autoplay (bot on seat 0); time scale ¼× to 4×; frame step; set seed; add a bot surgeon.\\n- **Balance:** the live sliders of Appendix A, each with its value, and **Reset to defaults** per slider and for all. They write `inspector.set(key, value)`, so replays record them.\\n- **View:** hide HUD; show target and hit shapes; show cursor assist; free camera; look picker; performance counters from `__engine.stats()`.\\n- **Author:** path tool: hold a button and draw on the field, then copy the polyline as data for a case file. Shows cursor coordinates.\\n- **Data:** event log; state hash; copy `input.record()` as a replay.\\n\\nSim-changing tools go through `defineDevAction`, so replays hold them.\\n\\n---\\n\\n## 16. Multiplayer\\n\\nFollow the AI Hub Session Protocol v1 (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); read it in full. Client `session.js` is version 1.4.0 at the time of writing. **Mode: `shared-world`.**\\n\\n**Head tags.**\\n\\n```html\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"5\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Keep the patient alive and finish the op together\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Aim: stick or mouse · use tool: R2 or click · tools: right stick or 1-8\\\">\\n<meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">\\n```\\n\\nPaste `session.js` unmodified as the first script, right after `<meta charset>`.\\n\\n**In a session (`AIHub.active`).**\\n\\n- No title or menus. Boot in the order below; on `connect` giving `null`, run as on its own.\\n- **Own card** (\\\"Pre-op briefing\\\"): a 3D OR team shot with HTML over it, showing the game's name, every player in their colour and who is ready, how to win, this player's controls, and the time left from the `card` event. Ready: Enter, Cross or a click → `AIHub.answer('ready')`. More time: Triangle, T or a click → `AIHub.answer('more')`. Nothing on it changes the round.\\n- `AIHub.ready()` once, with no press, as soon as the sim can run (below). `AIHub.fail(msg)` if WebGPU is missing.\\n- `start` then a 3 s countdown from `AIHub.time()`; play at `time() >= 0`. Run `case:gala-shift` with seed `info.seed` (the same on every copy), seats = players. A lone player gets the AI colleague, added by the host.\\n- Host calls `AIHub.finish({ standings, scores, won, stats, awards })` once, listing every remaining player: best score first, ties grouped. `won` is the team result. On `time-up`, finish within `graceMs` with `won: false`. Each result shows slips, best chain and an award (\\\"Steadiest hands\\\").\\n- On `end`: stop input and sound. On `leave`: that seat's hand drops, and the bot does not take it over. Names only through `textContent`. Pause shows Settings over the running game and never pauses. No quitting. No `alert`, `confirm`, `prompt`, popups, navigation, or network other than the hub's.\\n- `AIHub.server`: the host's copy has no player, camera or input, and draws nothing. The same host code runs the world. Prefer `createHeadless` there, or stop drawing; the prototype passed with the full engine, so this is not a blocker.\\n\",\"total_lines\":952}}","is_error":false},{"type":"tool_result","tool_use_id":"call-ce134aa1-48f3-4455-a74d-1cc60d170b1f-9","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"500→\\n---\\n\\n## 16. Multiplayer\\n\\nFollow the AI Hub Session Protocol v1 (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); read it in full. Client `session.js` is version 1.4.0 at the time of writing. **Mode: `shared-world`.**\\n\\n**Head tags.**\\n\\n```html\\n510→<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"5\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Keep the patient alive and finish the op together\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Aim: stick or mouse · use tool: R2 or click · tools: right stick or 1-8\\\">\\n<meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">\\n```\\n\\nPaste `session.js` unmodified as the first script, right after `<meta charset>`.\\n520→\\n**In a session (`AIHub.active`).**\\n\\n- No title or menus. Boot in the order below; on `connect` giving `null`, run as on its own.\\n- **Own card** (\\\"Pre-op briefing\\\"): a 3D OR team shot with HTML over it, showing the game's name, every player in their colour and who is ready, how to win, this player's controls, and the time left from the `card` event. Ready: Enter, Cross or a click → `AIHub.answer('ready')`. More time: Triangle, T or a click → `AIHub.answer('more')`. Nothing on it changes the round.\\n- `AIHub.ready()` once, with no press, as soon as the sim can run (below). `AIHub.fail(msg)` if WebGPU is missing.\\n- `start` then a 3 s countdown from `AIHub.time()`; play at `time() >= 0`. Run `case:gala-shift` with seed `info.seed` (the same on every copy), seats = players. A lone player gets the AI colleague, added by the host.\\n- Host calls `AIHub.finish({ standings, scores, won, stats, awards })` once, listing every remaining player: best score first, ties grouped. `won` is the team result. On `time-up`, finish within `graceMs` with `won: false`. Each result shows slips, best chain and an award (\\\"Steadiest hands\\\").\\n- On `end`: stop input and sound. On `leave`: that seat's hand drops, and the bot does not take it over. Names only through `textContent`. Pause shows Settings over the running game and never pauses. No quitting. No `alert`, `confirm`, `prompt`, popups, navigation, or network other than the hub's.\\n- `AIHub.server`: the host's copy has no player, camera or input, and draws nothing. The same host code runs the world. Prefer `createHeadless` there, or stop drawing; the prototype passed with the full engine, so this is not a blocker.\\n530→\\n**Boot order, tested against the real harness. The comments mark failures seen there.**\\n\\n```ts\\n// labs/game/main.ts, at the very top: nothing heavy before connect, or the hub's 10 s hello window closes\\nconst hub = window.AIHub;\\nconst info = hub?.active ? await hub.connect({ mode: 'shared-world', seats: [1, 4], card: true }) : null;\\nconst search = new URLSearchParams(location.search);\\n// The hub opens the page with ?aihub=1&aihub-seed=…; the engine reads every query key as a setting and REFUSES TO START (CORE_BAD_SETTING).\\nfor (const key of [...search.keys()]) if (key.startsWith('aihub')) search.delete(key);\\n540→if (info) { search.set('seed', String(info.seed)); search.set('gfx.warmUp', 'asked'); search.set('game.run', 'op:gala-shift'); }\\nif (info) void runSession(info);                // beside createEngine, not after it: its warm-up can take 20 s here\\nengine = await createEngine({ canvas, scenes: ['game:main'], search: `?${search}`, /* … */ });\\n\\nasync function runSession(info) {\\n  while (typeof window.__engine?.step !== 'function') await sleep(25);   // about 1 s; long before the warm-up ends\\n  const e = window.__engine;\\n  e.pause();\\n  hub.ready();                                  // the harness waits only 20 s; a four-copy software warm-up reached 21 s on the starter\\n  setInterval(() => (info.isHost ? hostTick(e) : clientTick(e)), 16);   // keeps running in a hidden tab, throttled\\n550→}\\n```\\n\\nThe card is HTML over the 3D shot, so it can show before the first frame. If the countdown ends before `engine.ready`, keep a plain cover up until it is; ticks still run behind it. On real GPUs this should take moments.\\n\\n**Netcode: host-sequenced lockstep.** The engine promises the same seed and intents give the same state, bit for bit. Use it: no snapshot serialisation at all.\\n\\n- Every copy runs the same sim from the same seed. The host decides each tick's intents; everyone else plays the same list.\\n- **Client → host:** `{ t: 'i', x, z, tool, counters }`, unreliable, 15–20 per second, sent to the host. Counters are monotonic press counts, so a lost packet never loses a press.\\n- **Host → everyone:** reliable, about 15 per second: `{ t: 't', from, ticks: [...] }`, the seats' hands per tick, delta-coded; about once a second a state hash. At most 20 messages per second leave each copy, and each is at most 16 KB.\\n560→- **Host tick:** `due = floor(AIHub.time() * 60 / 1000)`; while `next < due`, build the tick's hands, `e.step(1, { 'game:hands': hands })`, and queue it. Flush every 66 ms.\\n- **Client tick:** step one buffered tick each timer pass; two when more than 6 are queued, eight when more than 30. After `end`, a client may drain what it has, sending nothing.\\n- **Your own cursor is always drawn from the local device at once;** the sim's copy follows. Actions take effect after the round trip, which is why sparks appear at the sim's cursor position.\\n- Settings match on every copy; dev sliders are disabled in a session. A hash mismatch logs an error and is a test failure. There is no runtime resync (`restore` refuses another run's capture).\\n- **Tested:** a 70-line prototype of exactly this, on the starter with a 40,000-vertex live mesh and no card, passed all four harness runs below. Every client's hash matched the host's at every check (about one a second), including at `players=4&latency=150&jitter=50&loss=5`.\\n- If software rendering makes the harness too slow with your full scenes, reduce sheet density when the adapter is SwiftShader (`__engine.info()`), in a session only.\\n\\n**On its own.** With no hub, the game runs exactly as a normal game: story, Board, solo, and couch co-op for up to four devices (§6). There is no other online mode: outside a session there is no hub network and we add no servers. State this in About.\\n\\n**Test it** as the protocol's *Test it* section says: download `harness.html`, `bridge.js` and `round.js` into a test folder under `out/` next to a copy of the deliverable, serve with `python3 -m http.server 0 --bind 127.0.0.1` (read the port it prints; confirm the page is your game; stop it by its PID), and pass all of: `?game=<file>&players=2&auto=1`, `&players=4&latency=150&jitter=50&loss=5&auto=1`, the same with `&scenario=host-leave`, and `&players=2&scenario=server`. A game passes when `window.__hubCheck.pass` is true. Use `&limit=` to shorten rounds; expose your hash checks on a debug object so the test can read them from each frame and require zero mismatches. Also open the game with no session to confirm it runs normally.\\n570→\\n---\\n\\n## 17. Engine and architecture\\n\\n### 17.1 Setup, and traps already hit on this machine\\n\\nUse the engine's **full workspace, not the lean** single page: you want its headless tests, replays and `node x` tools. The engine stays read-only: add every system, art asset and animation on top of it, in `labs/game/`. The rest of the stack is what it ships: TypeScript and Vite, with no new npm dependencies. This plan was tested against `my-3dge@e7a1243`. `git clone --depth 1` may give you something newer: `docs/API.md` is the truth.\\n\\n```sh\\n580→# in the empty dev folder\\nexport TMPDIR=$(mktemp -d /tmp/g.XXXXXX)        # trap 1\\nexport CHROMIUM_PATH=$(ls -d ~/.cache/ms-playwright/chromium-*/chrome-linux64/chrome | head -1)   # trap 2\\nsrc=$(mktemp -d) && git clone --depth 1 https://github.com/michaelcrosato/my-3dge \\\"$src\\\" && node \\\"$src/tools/game/new-game.mjs\\\" . --name <your-slug>\\nnpm ci\\n```\\n\\n1. **A long `TMPDIR` breaks tools silently.** The run's `TMPDIR` is too long for a Unix socket path. Chromium dies with `Socket path too long` and `node x shot` then hung for over 4 minutes; `npx tsx` fails with `EINVAL`. Use the short private directory above in every shell (shell state may not persist between tool calls, so put it in your commands or a script), and remove it when you finish. This is the one exception to TASK.md's rule against `/tmp`: no path inside your folder is short enough for the sockets. Keep your real files in your folder.\\n2. **Do not run `bash scripts/setup.sh`** even though the output and `AGENTS.md` suggest it: it would download Node and Chrome for Testing. `npm ci` plus `CHROMIUM_PATH` is enough. The path above is Chromium 153, which the engine targets.\\n3. **Don't use `node x shot --cam3`:** the flag is `--cam` (`node x help shot`).\\n590→4. A running page **cannot switch scenes**; the guide's page reload is not allowed in a hub session. Use §17.2. **Every query key is read as a setting**: an unknown one stops the engine, which is why §16 strips the hub's.\\n5. The engine's `modal` stops intents but not the sim: pause with `inspector.pause()` too.\\n6. The engine's gamepad device gives one active pad, and another pad used can take over. For gameplay, read pads yourself (§17.4). Use engine input for menus, keyboard and mouse.\\n7. Every source file under `labs/` needs a `@file` comment and stays under 400 lines (hard cap 600), `.mjs` tools included. Run the formatter before `npm run check`.\\n8. Game code may not import three.js (`npm run check` refuses it). The recipes below stay legal.\\n9. Golden replays break whenever play changes on purpose: `node x replay labs/game/replays --browser sim --update`.\\n10. The guide cites `labs/playground/`, but a game gets only `labs/game/` and `labs/box/`. To read playground code you would need the engine's repository; this plan does not.\\n11. You share this machine. Stay in your own folder and keep one or two browsers open. Stop only processes you started, by PID: never `pkill`, `killall` or `fuser -k`, and never kill whatever holds a port. The `x` commands pick a free port by themselves. Prefer `file://` and the engine's headless tools; start a server only for the hub harness.\\n12. **The browsers are already downloaded: never run `playwright install`.** The engine's own `@playwright/test` (1.64.1) drives the downloaded Chromium through `executablePath` (tested). TASK.md's `npm install playwright@1.63.0` would change the game's pinned dependencies, so for Firefox and WebKit use the system Python's Playwright instead (tested): `from playwright.sync_api import sync_playwright`.\\n13. Runs have no display, so all of this is headless; a headed browser would need `xvfb-run`. WebGPU needs a secure page: `file://` or `http://127.0.0.1`.\\n600→14. `earlyoom` is on. \\\"Target closed\\\", \\\"page crashed\\\" or \\\"browser has been closed\\\" means memory ran out, not a bug in your game: run fewer browsers rather than retrying, and run the four-copy harness alone.\\n15. The system Python has only Playwright. For anything else: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` if it drives a browser.\\n\\nMeasured on the starter: `npm ci` 6 s, `npm run check` 25 s, `npm test` 9 s, `node x shot` 12 s, a one-file build 8 s.\\n\\nTested and working, so build on these: the live mesh of §17.3; one-file build and boot from `file://`; frames still drawing while paused; `step(n, intents)` with custom keys; restart with new settings keeping the page; custom intents recorded in a replay; `cam3=fixed` cuts with `{ blend: true }`; `touch=off`; the boot order and netcode of §16 in all four harness runs. **Not tested:** the game's own card in the harness, a `defineCamera` mode in play, transparent live meshes, the light pool's focus (§17.2), vertex counts past 40,000. Prove these early.\\n\\n### 17.2 One scene, many runs\\n\\nThe page has one scene, `game:main` (`labs/game/scenes/main.ts`, level: a bare floor big enough for one set). Each **run** is one story scene or one operation:\\n610→\\n```ts\\ninspector.set('game.run', 'op:crosstalk');   // when: 'scene' settings\\ninspector.set('game.phase', 2);              // optional checkpoint\\ninspector.seed(nextSeed);                    // restarts the scene in place: tick 0, settings kept, page and geometry kept\\n```\\n\\n`setup(w)` reads `game.run` and spawns only that set's props and actors. A black HTML fade hides each change. The **Director** (`labs/game/app/director.ts`, plain TypeScript, no DOM, tested in Node) holds the flow: title → story → briefing → op → debrief → next. Settings for a run: `game.run`, `game.phase`, `game.seats`, `game.difficulty`, `game.attract`.\\n\\nKeep a `player: true` actor at the current set (the protagonist in a story; an actor out of sight under the floor in the pit): the light pool and the stage's focus follow it. Check this early.\\n620→\\nCameras: `inspector.camera.set('cam3=fixed,x,y,z,yawDeg,pitchDeg,fov', { blend: true })` for cuts and sites. Parallax: your own mode with `defineCamera` and `followCamera` (`node x new camera`), reading a module-level target the page writes; view state only.\\n\\n### 17.3 Live meshes (tested)\\n\\nGame code cannot import three.js, and cannot reach the stage's scene. But `defineGeometry`'s builder returns a geometry, and you may keep it. A geometry and attribute class can be taken from any kit shape:\\n\\n```ts\\n// page side, before createEngine\\nconst base = boxGeometry({ width: 1, height: 1, depth: 1 });\\n630→const Geometry = base.constructor as new () => typeof base;\\nconst Attribute = base.getAttribute('position').constructor as new (a: Float32Array, n: number) => ReturnType<typeof base.getAttribute>;\\nlet sheet: typeof base | null = null;\\ndefineGeometry('geometry:sheet', { description: '…', budget: 200000, create: () => {\\n  const g = new Geometry();\\n  g.setAttribute('position', new Attribute(positions, 3));   // also normal, color, uv\\n  g.setIndex(indices);\\n  sheet = g;           // keep it\\n  return g;\\n} });\\n640→defineMaterial('material:tissue', { vertexColors: true, roughness: 0.35 });\\n// sim side\\ndefineProp('prop:sheet', { parts: [{ geometry: 'geometry:sheet', material: 'material:tissue' }] });\\nspawnProp(w, { prop: 'prop:sheet', at: [x, 0, z], yaw: 0 });\\n// page side, in onFrame\\nposition.setY(i, h); colour.setXYZ(i, r, g, b);\\nposition.needsUpdate = true; colour.needsUpdate = true; sheet.computeVertexNormals();\\n```\\n\\nTested: a 40,401-vertex grid drawn and rewritten every frame on software WebGPU, with vertex colours, under a lit style; the ID pass names it `prop:sheet/mesh/page0`; the builder ran once and survived a restart. It passes types and lint. Build it at maximum extents first so culling bounds are right. If `node x qa geo` flags it, accept it in `tests/baselines/qa-geo-game.json` with the reason. Put this helper in `labs/game/view/field/liveMesh.ts`, and note the missing public API in `ENGINE-FEEDBACK.md`.\\n650→\\nThe same trick makes static organ and tool shapes: take a kit shape (`limbGeometry`, `pillarGeometry`), write new positions into its array, and call `computeVertexNormals()`.\\n\\n### 17.4 Input: everything is one custom intent\\n\\nThe sim reads one thing: `intents['game:hands']`, an array per seat: `[x, z, tool, useHeld, counters…]`, rounded to 1/256 m. Treat an absent value (a menu, a modal) as \\\"no change.\\\"\\n\\n- **Page:** `labs/game/input/hands.ts` polls every frame. It polls pads directly from `navigator.getGamepads()` (standard indices; use the codes from `input.bindingsFor('actionMap:surgeon')` so rebinding works), reads keyboard and mouse through `input.held / pressed / strength`, integrates the cursor with assist against read-only world data, and converts the mouse to the field with `screenRay(frame.camera, ndc, aspect)` and `onFloor(ray, 0)`.\\n- **Solo and couch:** `(inspector.input).axis('game:hands', hands)` each frame. It merges into each step and is recorded (tested). Attract and autoplay feed the bot's hands the same way.\\n- **Session:** §16's stepping.\\n660→- **Other commands** to the sim use the same route: `axis('game:beat', n)` advances a story beat.\\n- `defineActionMap('actionMap:surgeon', …)` lists the bindings of §10. Names are lower-case words; `move` names four actions; `lock: false`. Mouse codes: `MouseLeft`, `MouseRight`, `WheelUp`, `WheelDown`.\\n\\n### 17.5 Data is the designer tool\\n\\nSo the rest of the game can be built without new code: everything authored is plain data, validated, with hot jump-in through URL or dev mode.\\n\\n```ts\\n// labs/game/data/cases/crosstalk.ts\\nexport default defineCase('case:crosstalk', {\\n670→  title: 'Crosstalk', surgeons: ['wren'], seconds: 300, gift: 1,\\n  patient: { name: 'Hal Minsky', age: 58, line: '…', vitals: 60, postcards: { S: '…', A: '…', B: '…', C: '…' } },\\n  story: { before: 'story:03a', after: 'story:03b' },\\n  sites: [{ id: 'liver', field: 'field:liver', cam: [0, 11, -4, 0, -70, 40] } /* … */],\\n  phases: [{\\n    id: 'triage', hint: 'Stop the worst bleed first.',\\n    spawn: [{ kind: 'wound', site: 'liver', path: [[-3, 1], [0, 2]], deep: true }, { kind: 'pool', site: 'liver', at: [1, 0], volume: 4 }],\\n    timeline: [{ at: 6, say: ['odie', 'The lung, Doctor! Now!'] }],\\n    until: 'clear',\\n  } /* … */],\\n680→  ranks: [/* written by the rank tool */],\\n});\\n```\\n\\n- `labs/game/data/fields/*.ts`: organ ellipses, vessels, palette per field.\\n- `labs/game/data/strains.ts`, `tools.ts`, `balance.ts`.\\n- `labs/game/data/story/*.ts`: beats: `{ set, cam, cast: { wren: { at, act } }, say: { who, text, mood }, drama?: 'IT MOVED.' }`.\\n- `labs/game/data/sets/*.ts`: prop lists and named camera poses.\\n- `validateCase()` and `validateStory()` run in tests and name every bad reference. Jump straight in with `?game.run=op:crosstalk&game.phase=2`.\\n- New target kinds, tools and strains are registry entries (`defineKind`), never `if`s on ids.\\n690→\\n### 17.6 Files\\n\\nSim-side (imports only `engine/sim-api.ts`; no DOM, clocks or `Math.random`; `Math.pow`, not `**`):\\n\\n```\\nlabs/game/scenes/main.ts          the scene, run setup, settings\\nlabs/game/scenes/op/*.ts          vitals, clock, phases, targets, tools, ratings, gift\\nlabs/game/scenes/strains/*.ts     one per strain\\nlabs/game/scenes/story.ts         stage directions from beats\\n700→labs/game/cast/*.ts               actors, actions, crowd bodies\\nlabs/game/data/**                 cases, fields, strains, tools, story, sets, balance\\nlabs/game/bot.ts                  plays any case through game:hands; used by tests, attract, autoplay, AI colleague\\n```\\n\\nPage-side (imports `engine/index.ts`):\\n\\n```\\nlabs/game/main.ts                 boot: hub check, createEngine, onFrame\\nlabs/game/app/                    director, store, settings, idle timer\\n710→labs/game/input/                  hands, seats, glyphs\\nlabs/game/view/field/             liveMesh, sheet, thin things, hands, instruments, field FX\\nlabs/game/view/                   bodies, props, materials, textures, looks, cameras, emitters\\nlabs/game/ui/                     hud, radial, screens, dev mode, about\\nlabs/game/audio/                  sfx, songs, voice, mix\\nlabs/game/net/                    hub session, sequencer (pure logic), card\\nlabs/game/replays/                golden replays\\nlabs/game/tools/                  verify, one-file build, e2e, hub checks\\n```\\n\\n720→Sim order each step: read hands → cursors and tools → targets and strains → bleeding and vitals → clock → phase runner → events. The sim says what happened with events; the page turns them into particles, sound and rating pops. The bot's policy is priorities: vitals low → Stabilizer; open deep bleed → stitch; pool hiding a target → drain; then the current phase's targets, with human-like cursor speed.\\n\\nSaves: `createStore`, passed to `createEngine({ store })`, holds progress, ranks, postcards, settings and bindings. In a session the client gives you empty storage; add no code for that.\\n\\n---\\n\\n## 18. Packaging\\n\\nThe deliverable is one self-contained HTML file: no CDN needed. Write `labs/game/tools/one-file.mts`, modelled on `tools/lib/oneFile.ts`, reusing its exported `inlineBuild` and `externalRefs`: Vite `build` with `configFile: false`, `base: './'`, the alias of `three` to `three/webgpu`, `write: false`, `modulePreload: false`, `cssCodeSplit: false`, `assetsInlineLimit: () => true`, `rollupOptions: { input: <labs/game/index.html>, output: { inlineDynamicImports: true } }`. Tested on the starter: 6.7 MB, no external references, boots from `file://` without errors.\\n\\n730→- Run it with `npx tsx`, and write the file where TASK.md says. It is tested with the short `TMPDIR`.\\n- `inlineBuild`'s note names the playground: `.replace(ONE_FILE_NOTE, '<!-- your note -->')`, also exported from `tools/lib/oneFile.ts` (tested).\\n- Paste `session.js` into `labs/game/index.html` as the first inline script. Through this build it came out byte-identical and first, and the harness accepted it (tested). Keep a test that says so.\\n- A script with `<!--` in it fails the build: write it apart in the source.\\n- The build embeds the exit interview's data for the About screen (§21), so they cannot disagree.\\n- Make all tests that need a browser run against this file, not the dev server, once it exists.\\n\\n---\\n\\n## 19. Testing\\n740→\\n**One command: `npm run verify`** (`labs/game/tools/verify.mjs`; add it with `npm pkg set scripts.verify=\\\"node labs/game/tools/verify.mjs\\\"`). It prints only failures and one final line (`verify: 212 passed, 0 failed`). Rerun it only after changing the code it covers; `--fast` skips browsers. Use one or two browsers at a time. No subagents or workflows to debate, review, judge or audit. Make it the first thing you write, from this skeleton.\\n\\nTested on the starter, under the run's real long `TMPDIR`, with no setup: `verify: 8 passed, 0 failed` in 28 s (14 s with `--fast`). With a broken test, a lint error and a failing browser check, it printed exactly those three `FAIL` lines and `verify: 9 passed, 3 failed`, and exited 1. It passes `npm run check` itself. For a lint failure it prints the summary; run `npm run check` for the details.\\n\\n```js\\n/**\\n * @file The one command, `npm run verify`: runs every check quietly and prints only the failures, then one line with\\n * the count. `--fast` skips what needs a browser. It sets its own short TMPDIR and CHROMIUM_PATH, so it needs no setup,\\n * and removes the temporary folder when done. Exit 0 when nothing failed.\\n750→ */\\nimport { spawnSync } from 'node:child_process';\\nimport { existsSync, globSync, mkdtempSync, readFileSync, rmSync } from 'node:fs';\\nimport { homedir } from 'node:os';\\n\\nconst fast = process.argv.includes('--fast');\\nconst tmp = mkdtempSync('/tmp/g.');\\nconst chrome = globSync(`${homedir()}/.cache/ms-playwright/chromium-*/chrome-linux64/chrome`)[0];\\nconst env = { ...process.env, TMPDIR: tmp, CHROMIUM_PATH: process.env.CHROMIUM_PATH ?? chrome };\\nconst run = (command, ...args) => spawnSync(command, args, { env, encoding: 'utf8', maxBuffer: 2 ** 28 });\\n760→\\nlet passed = 0;\\nconst failed = [];\\nconst note = (name, ok, detail = '') => (ok ? (passed += 1) : failed.push(`${name}${detail ? `: ${detail}` : ''}`));\\nconst tail = (result) => `${result.stdout}${result.stderr}`.trim().split('\\\\n').slice(-6).join(' | ').slice(0, 600);\\n\\n/** A step whose exit status is its verdict. */\\nconst step = (name, command, ...args) => {\\n  const result = run(command, ...args);\\n  note(name, result.status === 0, tail(result));\\n770→};\\n\\n/** Vitest, counted test by test from the JSON report npm test writes. */\\nfunction tests() {\\n  const report = 'out/test/report.json';\\n  rmSync(report, { force: true });\\n  const result = run('npm', 'test', '--silent');\\n  if (!existsSync(report)) return note('npm test', false, tail(result));\\n  for (const file of JSON.parse(readFileSync(report, 'utf8')).testResults) {\\n    for (const test of file.assertionResults) {\",\"content_concise\":\"500→\\n---\\n\\n## 16. Multiplayer\\n\\nFollow the AI Hub Session Protocol v1 (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); read it in full. Client `session.js` is version 1.4.0 at the time of writing. **Mode: `shared-world`.**\\n\\n**Head tags.**\\n\\n```html\\n510→<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"5\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Keep the patient alive and finish the op together\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Aim: stick or mouse · use tool: R2 or click · tools: right stick or 1-8\\\">\\n<meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">\\n```\\n\\nPaste `session.js` unmodified as the first script, right after `<meta charset>`.\\n520→\\n**In a session (`AIHub.active`).**\\n\\n- No title or menus. Boot in the order below; on `connect` giving `null`, run as on its own.\\n- **Own card** (\\\"Pre-op briefing\\\"): a 3D OR team shot with HTML over it, showing the game's name, every player in their colour and who is ready, how to win, this player's controls, and the time left from the `card` event. Ready: Enter, Cross or a click → `AIHub.answer('ready')`. More time: Triangle, T or a click → `AIHub.answer('more')`. Nothing on it changes the round.\\n- `AIHub.ready()` once, with no press, as soon as the sim can run (below). `AIHub.fail(msg)` if WebGPU is missing.\\n- `start` then a 3 s countdown from `AIHub.time()`; play at `time() >= 0`. Run `case:gala-shift` with seed `info.seed` (the same on every copy), seats = players. A lone player gets the AI colleague, added by the host.\\n- Host calls `AIHub.finish({ standings, scores, won, stats, awards })` once, listing every remaining player: best score first, ties grouped. `won` is the team result. On `time-up`, finish within `graceMs` with `won: false`. Each result shows slips, best chain and an award (\\\"Steadiest hands\\\").\\n- On `end`: stop input and sound. On `leave`: that seat's hand drops, and the bot does not take it over. Names only through `textContent`. Pause shows Settings over the running game and never pauses. No quitting. No `alert`, `confirm`, `prompt`, popups, navigation, or network other than the hub's.\\n- `AIHub.server`: the host's copy has no player, camera or input, and draws nothing. The same host code runs the world. Prefer `createHeadless` there, or stop drawing; the prototype passed with the full engine, so this is not a blocker.\\n530→\\n**Boot order, tested against the real harness. The comments mark failures seen there.**\\n\\n```ts\\n// labs/game/main.ts, at the very top: nothing heavy before connect, or the hub's 10 s hello window closes\\nconst hub = window.AIHub;\\nconst info = hub?.active ? await hub.connect({ mode: 'shared-world', seats: [1, 4], card: true }) : null;\\nconst search = new URLSearchParams(location.search);\\n// The hub opens the page with ?aihub=1&aihub-seed=…; the engine reads every query key as a setting and REFUSES TO START (CORE_BAD_SETTING).\\nfor (const key of [...search.keys()]) if (key.startsWith('aihub')) search.delete(key);\\n540→if (info) { search.set('seed', String(info.seed)); search.set('gfx.warmUp', 'asked'); search.set('game.run', 'op:gala-shift'); }\\nif (info) void runSession(info);                // beside createEngine, not after it: its warm-up can take 20 s here\\nengine = await createEngine({ canvas, scenes: ['game:main'], search: `?${search}`, /* … */ });\\n\\nasync function runSession(info) {\\n  while (typeof window.__engine?.step !== 'function') await sleep(25);   // about 1 s; long before the warm-up ends\\n  const e = window.__engine;\\n  e.pause();\\n  hub.ready();                                  // the harness waits only 20 s; a four-copy software warm-up reached 21 s on the starter\\n  setInterval(() => (info.isHost ? hostTick(e) : clientTick(e)), 16);   // keeps running in a hidden tab, throttled\\n550→}\\n```\\n\\nThe card is HTML over the 3D shot, so it can show before the first frame. If the countdown ends before `engine.ready`, keep a plain cover up until it is; ticks still run behind it. On real GPUs this should take moments.\\n\\n**Netcode: host-sequenced lockstep.** The engine promises the same seed and intents give the same state, bit for bit. Use it: no snapshot serialisation at all.\\n\\n- Every copy runs the same sim from the same seed. The host decides each tick's intents; everyone else plays the same list.\\n- **Client → host:** `{ t: 'i', x, z, tool, counters }`, unreliable, 15–20 per second, sent to the host. Counters are monotonic press counts, so a lost packet never loses a press.\\n- **Host → everyone:** reliable, about 15 per second: `{ t: 't', from, ticks: [...] }`, the seats' hands per tick, delta-coded; about once a second a state hash. At most 20 messages per second leave each copy, and each is at most 16 KB.\\n560→- **Host tick:** `due = floor(AIHub.time() * 60 / 1000)`; while `next < due`, build the tick's hands, `e.step(1, { 'game:hands': hands })`, and queue it. Flush every 66 ms.\\n- **Client tick:** step one buffered tick each timer pass; two when more than 6 are queued, eight when more than 30. After `end`, a client may drain what it has, sending nothing.\\n- **Your own cursor is always drawn from the local device at once;** the sim's copy follows. Actions take effect after the round trip, which is why sparks appear at the sim's cursor position.\\n- Settings match on every copy; dev sliders are disabled in a session. A hash mismatch logs an error and is a test failure. There is no runtime resync (`restore` refuses another run's capture).\\n- **Tested:** a 70-line prototype of exactly this, on the starter with a 40,000-vertex live mesh and no card, passed all four harness runs below. Every client's hash matched the host's at every check (about one a second), including at `players=4&latency=150&jitter=50&loss=5`.\\n- If software rendering makes the harness too slow with your full scenes, reduce sheet density when the adapter is SwiftShader (`__engine.info()`), in a session only.\\n\\n**On its own.** With no hub, the game runs exactly as a normal game: story, Board, solo, and couch co-op for up to four devices (§6). There is no other online mode: outside a session there is no hub network and we add no servers. State this in About.\\n\\n**Test it** as the protocol's *Test it* section says: download `harness.html`, `bridge.js` and `round.js` into a test folder under `out/` next to a copy of the deliverable, serve with `python3 -m http.server 0 --bind 127.0.0.1` (read the port it prints; confirm the page is your game; stop it by its PID), and pass all of: `?game=<file>&players=2&auto=1`, `&players=4&latency=150&jitter=50&loss=5&auto=1`, the same with `&scenario=host-leave`, and `&players=2&scenario=server`. A game passes when `window.__hubCheck.pass` is true. Use `&limit=` to shorten rounds; expose your hash checks on a debug object so the test can read them from each frame and require zero mismatches. Also open the game with no session to confirm it runs normally.\\n570→\\n---\\n\\n## 17. Engine and architecture\\n\\n### 17.1 Setup, and traps already hit on this machine\\n\\nUse the engine's **full workspace, not the lean** single page: you want its headless tests, replays and `node x` tools. The engine stays read-only: add every system, art asset and animation on top of it, in `labs/game/`. The rest of the stack is what it ships: TypeScript and Vite, with no new npm dependencies. This plan was tested against `my-3dge@e7a1243`. `git clone --depth 1` may give you something newer: `docs/API.md` is the truth.\\n\\n```sh\\n580→# in the empty dev folder\\nexport TMPDIR=$(mktemp -d /tmp/g.XXXXXX)        # trap 1\\nexport CHROMIUM_PATH=$(ls -d ~/.cache/ms-playwright/chromium-*/chrome-linux64/chrome | head -1)   # trap 2\\nsrc=$(mktemp -d) && git clone --depth 1 https://github.com/michaelcrosato/my-3dge \\\"$src\\\" && node \\\"$src/tools/game/new-game.mjs\\\" . --name <your-slug>\\nnpm ci\\n```\\n\\n1. **A long `TMPDIR` breaks tools silently.** The run's `TMPDIR` is too long for a Unix socket path. Chromium dies with `Socket path too long` and `node x shot` then hung for over 4 minutes; `npx tsx` fails with `EINVAL`. Use the short private directory above in every shell (shell state may not persist between tool calls, so put it in your commands or a script), and remove it when you finish. This is the one exception to TASK.md's rule against `/tmp`: no path inside your folder is short enough for the sockets. Keep your real files in your folder.\\n2. **Do not run `bash scripts/setup.sh`** even though the output and `AGENTS.md` suggest it: it would download Node and Chrome for Testing. `npm ci` plus `CHROMIUM_PATH` is enough. The path above is Chromium 153, which the engine targets.\\n3. **Don't use `node x shot --cam3`:** the flag is `--cam` (`node x help shot`).\\n590→4. A running page **cannot switch scenes**; the guide's page reload is not allowed in a hub session. Use §17.2. **Every query key is read as a setting**: an unknown one stops the engine, which is why §16 strips the hub's.\\n5. The engine's `modal` stops intents but not the sim: pause with `inspector.pause()` too.\\n6. The engine's gamepad device gives one active pad, and another pad used can take over. For gameplay, read pads yourself (§17.4). Use engine input for menus, keyboard and mouse.\\n7. Every source file under `labs/` needs a `@file` comment and stays under 400 lines (hard cap 600), `.mjs` tools included. Run the formatter before `npm run check`.\\n8. Game code may not import three.js (`npm run check` refuses it). The recipes below stay legal.\\n9. Golden replays break whenever play changes on purpose: `node x replay labs/game/replays --browser sim --update`.\\n10. The guide cites `labs/playground/`, but a game gets only `labs/game/` and `labs/box/`. To read playground code you would need the engine's repository; this plan does not.\\n11. You share this machine. Stay in your own folder and keep one or two browsers open. Stop only processes you started, by PID: never `pkill`, `killall` or `fuser -k`, and never kill whatever holds a port. The `x` commands pick a free port by themselves. Prefer `file://` and the engine's headless tools; start a server only for the hub harness.\\n12. **The browsers are already downloaded: never run `playwright install`.** The engine's own `@playwright/test` (1.64.1) drives the downloaded Chromium through `executablePath` (tested). TASK.md's `npm install playwright@1.63.0` would change the game's pinned dependencies, so for Firefox and WebKit use the system Python's Playwright instead (tested): `from playwright.sync_api import sync_playwright`.\\n13. Runs have no display, so all of this is headless; a headed browser would need `xvfb-run`. WebGPU needs a secure page: `file://` or `http://127.0.0.1`.\\n600→14. `earlyoom` is on. \\\"Target closed\\\", \\\"page crashed\\\" or \\\"browser has been closed\\\" means memory ran out, not a bug in your game: run fewer browsers rather than retrying, and run the four-copy harness alone.\\n15. The system Python has only Playwright. For anything else: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` if it drives a browser.\\n\\nMeasured on the starter: `npm ci` 6 s, `npm run check` 25 s, `npm test` 9 s, `node x shot` 12 s, a one-file build 8 s.\\n\\nTested and working, so build on these: the live mesh of §17.3; one-file build and boot from `file://`; frames still drawing while paused; `step(n, intents)` with custom keys; restart with new settings keeping the page; custom intents recorded in a replay; `cam3=fixed` cuts with `{ blend: true }`; `touch=off`; the boot order and netcode of §16 in all four harness runs. **Not tested:** the game's own card in the harness, a `defineCamera` mode in play, transparent live meshes, the light pool's focus (§17.2), vertex counts past 40,000. Prove these early.\\n\\n### 17.2 One scene, many runs\\n\\nThe page has one scene, `game:main` (`labs/game/scenes/main.ts`, level: a bare floor big enough for one set). Each **run** is one story scene or one operation:\\n610→\\n```ts\\ninspector.set('game.run', 'op:crosstalk');   // when: 'scene' settings\\ninspector.set('game.phase', 2);              // optional checkpoint\\ninspector.seed(nextSeed);                    // restarts the scene in place: tick 0, settings kept, page and geometry kept\\n```\\n\\n`setup(w)` reads `game.run` and spawns only that set's props and actors. A black HTML fade hides each change. The **Director** (`labs/game/app/director.ts`, plain TypeScript, no DOM, tested in Node) holds the flow: title → story → briefing → op → debrief → next. Settings for a run: `game.run`, `game.phase`, `game.seats`, `game.difficulty`, `game.attract`.\\n\\nKeep a `player: true` actor at the current set (the protagonist in a story; an actor out of sight under the floor in the pit): the light pool and the stage's focus follow it. Check this early.\\n620→\\nCameras: `inspector.camera.set('cam3=fixed,x,y,z,yawDeg,pitchDeg,fov', { blend: true })` for cuts and sites. Parallax: your own mode with `defineCamera` and `followCamera` (`node x new camera`), reading a module-level target the page writes; view state only.\\n\\n### 17.3 Live meshes (tested)\\n\\nGame code cannot import three.js, and cannot reach the stage's scene. But `defineGeometry`'s builder returns a geometry, and you may keep it. A geometry and attribute class can be taken from any kit shape:\\n\\n```ts\\n// page side, before createEngine\\nconst base = boxGeometry({ width: 1, height: 1, depth: 1 });\\n630→const Geometry = base.constructor as new () => typeof base;\\nconst Attribute = base.getAttribute('position').constructor as new (a: Float32Array, n: number) => ReturnType<typeof base.getAttribute>;\\nlet sheet: typeof base | null = null;\\ndefineGeometry('geometry:sheet', { description: '…', budget: 200000, create: () => {\\n  const g = new Geometry();\\n  g.setAttribute('position', new Attribute(positions, 3));   // also normal, color, uv\\n  g.setIndex(indices);\\n  sheet = g;           // keep it\\n  return g;\\n} });\\n640→defineMaterial('material:tissue', { vertexColors: true, roughness: 0.35 });\\n// sim side\\ndefineProp('prop:sheet', { parts: [{ geometry: 'geometry:sheet', material: 'material:tissue' }] });\\nspawnProp(w, { prop: 'prop:sheet', at: [x, 0, z], yaw: 0 });\\n// page side, in onFrame\\nposition.setY(i, h); colour.setXYZ(i, r, g, b);\\nposition.needsUpdate = true; colour.needsUpdate = true; sheet.computeVertexNormals();\\n```\\n\\nTested: a 40,401-vertex grid drawn and rewritten every frame on software WebGPU, with vertex colours, under a lit style; the ID pass names it `prop:sheet/mesh/page0`; the builder ran once and survived a restart. It passes types and lint. Build it at maximum extents first so culling bounds are right. If `node x qa geo` flags it, accept it in `tests/baselines/qa-geo-game.json` with the reason. Put this helper in `labs/game/view/field/liveMesh.ts`, and note the missing public API in `ENGINE-FEEDBACK.md`.\\n650→\\nThe same trick makes static organ and tool shapes: take a kit shape (`limbGeometry`, `pillarGeometry`), write new positions into its array, and call `computeVertexNormals()`.\\n\\n### 17.4 Input: everything is one custom intent\\n\\nThe sim reads one thing: `intents['game:hands']`, an array per seat: `[x, z, tool, useHeld, counters…]`, rounded to 1/256 m. Treat an absent value (a menu, a modal) as \\\"no change.\\\"\\n\\n- **Page:** `labs/game/input/hands.ts` polls every frame. It polls pads directly from `navigator.getGamepads()` (standard indices; use the codes from `input.bindingsFor('actionMap:surgeon')` so rebinding works), reads keyboard and mouse through `input.held / pressed / strength`, integrates the cursor with assist against read-only world data, and converts the mouse to the field with `screenRay(frame.camera, ndc, aspect)` and `onFloor(ray, 0)`.\\n- **Solo and couch:** `(inspector.input).axis('game:hands', hands)` each frame. It merges into each step and is recorded (tested). Attract and autoplay feed the bot's hands the same way.\\n- **Session:** §16's stepping.\\n660→- **Other commands** to the sim use the same route: `axis('game:beat', n)` advances a story beat.\\n- `defineActionMap('actionMap:surgeon', …)` lists the bindings of §10. Names are lower-case words; `move` names four actions; `lock: false`. Mouse codes: `MouseLeft`, `MouseRight`, `WheelUp`, `WheelDown`.\\n\\n### 17.5 Data is the designer tool\\n\\nSo the rest of the game can be built without new code: everything authored is plain data, validated, with hot jump-in through URL or dev mode.\\n\\n```ts\\n// labs/game/data/cases/crosstalk.ts\\nexport default defineCase('case:crosstalk', {\\n670→  title: 'Crosstalk', surgeons: ['wren'], seconds: 300, gift: 1,\\n  patient: { name: 'Hal Minsky', age: 58, line: '…', vitals: 60, postcards: { S: '…', A: '…', B: '…', C: '…' } },\\n  story: { before: 'story:03a', after: 'story:03b' },\\n  sites: [{ id: 'liver', field: 'field:liver', cam: [0, 11, -4, 0, -70, 40] } /* … */],\\n  phases: [{\\n    id: 'triage', hint: 'Stop the worst bleed first.',\\n    spawn: [{ kind: 'wound', site: 'liver', path: [[-3, 1], [0, 2]], deep: true }, { kind: 'pool', site: 'liver', at: [1, 0], volume: 4 }],\\n    timeline: [{ at: 6, say: ['odie', 'The lung, Doctor! Now!'] }],\\n    until: 'clear',\\n  } /* … */],\\n680→  ranks: [/* written by the rank tool */],\\n});\\n```\\n\\n- `labs/game/data/fields/*.ts`: organ ellipses, vessels, palette per field.\\n- `labs/game/data/strains.ts`, `tools.ts`, `balance.ts`.\\n- `labs/game/data/story/*.ts`: beats: `{ set, cam, cast: { wren: { at, act } }, say: { who, text, mood }, drama?: 'IT MOVED.' }`.\\n- `labs/game/data/sets/*.ts`: prop lists and named camera poses.\\n- `validateCase()` and `validateStory()` run in tests and name every bad reference. Jump straight in with `?game.run=op:crosstalk&game.phase=2`.\\n- New target kinds, tools and strains are registry entries (`defineKind`), never `if`s on ids.\\n690→\\n### 17.6 Files\\n\\nSim-side (imports only `engine/sim-api.ts`; no DOM, clocks or `Math.random`; `Math.pow`, not `**`):\\n\\n```\\nlabs/game/scenes/main.ts          the scene, run setup, settings\\nlabs/game/scenes/op/*.ts          vitals, clock, phases, targets, tools, ratings, gift\\nlabs/game/scenes/strains/*.ts     one per strain\\nlabs/game/scenes/story.ts         stage directions from beats\\n700→labs/game/cast/*.ts               actors, actions, crowd bodies\\nlabs/game/data/**                 cases, fields, strains, tools, story, sets, balance\\nlabs/game/bot.ts                  plays any case through game:hands; used by tests, attract, autoplay, AI colleague\\n```\\n\\nPage-side (imports `engine/index.ts`):\\n\\n```\\nlabs/game/main.ts                 boot: hub check, createEngine, onFrame\\nlabs/game/app/                    director, store, settings, idle timer\\n710→labs/game/input/                  hands, seats, glyphs\\nlabs/game/view/field/             liveMesh, sheet, thin things, hands, instruments, field FX\\nlabs/game/view/                   bodies, props, materials, textures, looks, cameras, emitters\\nlabs/game/ui/                     hud, radial, screens, dev mode, about\\nlabs/game/audio/                  sfx, songs, voice, mix\\nlabs/game/net/                    hub session, sequencer (pure logic), card\\nlabs/game/replays/                golden replays\\nlabs/game/tools/                  verify, one-file build, e2e, hub checks\\n```\\n\\n720→Sim order each step: read hands → cursors and tools → targets and strains → bleeding and vitals → clock → phase runner → events. The sim says what happened with events; the page turns them into particles, sound and rating pops. The bot's policy is priorities: vitals low → Stabilizer; open deep bleed → stitch; pool hiding a target → drain; then the current phase's targets, with human-like cursor speed.\\n\\nSaves: `createStore`, passed to `createEngine({ store })`, holds progress, ranks, postcards, settings and bindings. In a session the client gives you empty storage; add no code for that.\\n\\n---\\n\\n## 18. Packaging\\n\\nThe deliverable is one self-contained HTML file: no CDN needed. Write `labs/game/tools/one-file.mts`, modelled on `tools/lib/oneFile.ts`, reusing its exported `inlineBuild` and `externalRefs`: Vite `build` with `configFile: false`, `base: './'`, the alias of `three` to `three/webgpu`, `write: false`, `modulePreload: false`, `cssCodeSplit: false`, `assetsInlineLimit: () => true`, `rollupOptions: { input: <labs/game/index.html>, output: { inlineDynamicImports: true } }`. Tested on the starter: 6.7 MB, no external references, boots from `file://` without errors.\\n\\n730→- Run it with `npx tsx`, and write the file where TASK.md says. It is tested with the short `TMPDIR`.\\n- `inlineBuild`'s note names the playground: `.replace(ONE_FILE_NOTE, '<!-- your note -->')`, also exported from `tools/lib/oneFile.ts` (tested).\\n- Paste `session.js` into `labs/game/index.html` as the first inline script. Through this build it came out byte-identical and first, and the harness accepted it (tested). Keep a test that says so.\\n- A script with `<!--` in it fails the build: write it apart in the source.\\n- The build embeds the exit interview's data for the About screen (§21), so they cannot disagree.\\n- Make all tests that need a browser run against this file, not the dev server, once it exists.\\n\\n---\\n\\n## 19. Testing\\n740→\\n**One command: `npm run verify`** (`labs/game/tools/verify.mjs`; add it with `npm pkg set scripts.verify=\\\"node labs/game/tools/verify.mjs\\\"`). It prints only failures and one final line (`verify: 212 passed, 0 failed`). Rerun it only after changing the code it covers; `--fast` skips browsers. Use one or two browsers at a time. No subagents or workflows to debate, review, judge or audit. Make it the first thing you write, from this skeleton.\\n\\nTested on the starter, under the run's real long `TMPDIR`, with no setup: `verify: 8 passed, 0 failed` in 28 s (14 s with `--fast`). With a broken test, a lint error and a failing browser check, it printed exactly those three `FAIL` lines and `verify: 9 passed, 3 failed`, and exited 1. It passes `npm run check` itself. For a lint failure it prints the summary; run `npm run check` for the details.\\n\\n```js\\n/**\\n * @file The one command, `npm run verify`: runs every check quietly and prints only the failures, then one line with\\n * the count. `--fast` skips what needs a browser. It sets its own short TMPDIR and CHROMIUM_PATH, so it needs no setup,\\n * and removes the temporary folder when done. Exit 0 when nothing failed.\\n750→ */\\nimport { spawnSync } from 'node:child_process';\\nimport { existsSync, globSync, mkdtempSync, readFileSync, rmSync } from 'node:fs';\\nimport { homedir } from 'node:os';\\n\\nconst fast = process.argv.includes('--fast');\\nconst tmp = mkdtempSync('/tmp/g.');\\nconst chrome = globSync(`${homedir()}/.cache/ms-playwright/chromium-*/chrome-linux64/chrome`)[0];\\nconst env = { ...process.env, TMPDIR: tmp, CHROMIUM_PATH: process.env.CHROMIUM_PATH ?? chrome };\\nconst run = (command, ...args) => spawnSync(command, args, { env, encoding: 'utf8', maxBuffer: 2 ** 28 });\\n760→\\nlet passed = 0;\\nconst failed = [];\\nconst note = (name, ok, detail = '') => (ok ? (passed += 1) : failed.push(`${name}${detail ? `: ${detail}` : ''}`));\\nconst tail = (result) => `${result.stdout}${result.stderr}`.trim().split('\\\\n').slice(-6).join(' | ').slice(0, 600);\\n\\n/** A step whose exit status is its verdict. */\\nconst step = (name, command, ...args) => {\\n  const result = run(command, ...args);\\n  note(name, result.status === 0, tail(result));\\n770→};\\n\\n/** Vitest, counted test by test from the JSON report npm test writes. */\\nfunction tests() {\\n  const report = 'out/test/report.json';\\n  rmSync(report, { force: true });\\n  const result = run('npm', 'test', '--silent');\\n  if (!existsSync(report)) return note('npm test', false, tail(result));\\n  for (const file of JSON.parse(readFileSync(report, 'utf8')).testResults) {\\n    for (const test of file.assertionResults) {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/PLAN.md\",\"offset\":500,\"limit\":280,\"raw_output\":\"\\n---\\n\\n## 16. Multiplayer\\n\\nFollow the AI Hub Session Protocol v1 (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); read it in full. Client `session.js` is version 1.4.0 at the time of writing. **Mode: `shared-world`.**\\n\\n**Head tags.**\\n\\n```html\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"5\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Keep the patient alive and finish the op together\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Aim: stick or mouse · use tool: R2 or click · tools: right stick or 1-8\\\">\\n<meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">\\n```\\n\\nPaste `session.js` unmodified as the first script, right after `<meta charset>`.\\n\\n**In a session (`AIHub.active`).**\\n\\n- No title or menus. Boot in the order below; on `connect` giving `null`, run as on its own.\\n- **Own card** (\\\"Pre-op briefing\\\"): a 3D OR team shot with HTML over it, showing the game's name, every player in their colour and who is ready, how to win, this player's controls, and the time left from the `card` event. Ready: Enter, Cross or a click → `AIHub.answer('ready')`. More time: Triangle, T or a click → `AIHub.answer('more')`. Nothing on it changes the round.\\n- `AIHub.ready()` once, with no press, as soon as the sim can run (below). `AIHub.fail(msg)` if WebGPU is missing.\\n- `start` then a 3 s countdown from `AIHub.time()`; play at `time() >= 0`. Run `case:gala-shift` with seed `info.seed` (the same on every copy), seats = players. A lone player gets the AI colleague, added by the host.\\n- Host calls `AIHub.finish({ standings, scores, won, stats, awards })` once, listing every remaining player: best score first, ties grouped. `won` is the team result. On `time-up`, finish within `graceMs` with `won: false`. Each result shows slips, best chain and an award (\\\"Steadiest hands\\\").\\n- On `end`: stop input and sound. On `leave`: that seat's hand drops, and the bot does not take it over. Names only through `textContent`. Pause shows Settings over the running game and never pauses. No quitting. No `alert`, `confirm`, `prompt`, popups, navigation, or network other than the hub's.\\n- `AIHub.server`: the host's copy has no player, camera or input, and draws nothing. The same host code runs the world. Prefer `createHeadless` there, or stop drawing; the prototype passed with the full engine, so this is not a blocker.\\n\\n**Boot order, tested against the real harness. The comments mark failures seen there.**\\n\\n```ts\\n// labs/game/main.ts, at the very top: nothing heavy before connect, or the hub's 10 s hello window closes\\nconst hub = window.AIHub;\\nconst info = hub?.active ? await hub.connect({ mode: 'shared-world', seats: [1, 4], card: true }) : null;\\nconst search = new URLSearchParams(location.search);\\n// The hub opens the page with ?aihub=1&aihub-seed=…; the engine reads every query key as a setting and REFUSES TO START (CORE_BAD_SETTING).\\nfor (const key of [...search.keys()]) if (key.startsWith('aihub')) search.delete(key);\\nif (info) { search.set('seed', String(info.seed)); search.set('gfx.warmUp', 'asked'); search.set('game.run', 'op:gala-shift'); }\\nif (info) void runSession(info);                // beside createEngine, not after it: its warm-up can take 20 s here\\nengine = await createEngine({ canvas, scenes: ['game:main'], search: `?${search}`, /* … */ });\\n\\nasync function runSession(info) {\\n  while (typeof window.__engine?.step !== 'function') await sleep(25);   // about 1 s; long before the warm-up ends\\n  const e = window.__engine;\\n  e.pause();\\n  hub.ready();                                  // the harness waits only 20 s; a four-copy software warm-up reached 21 s on the starter\\n  setInterval(() => (info.isHost ? hostTick(e) : clientTick(e)), 16);   // keeps running in a hidden tab, throttled\\n}\\n```\\n\\nThe card is HTML over the 3D shot, so it can show before the first frame. If the countdown ends before `engine.ready`, keep a plain cover up until it is; ticks still run behind it. On real GPUs this should take moments.\\n\\n**Netcode: host-sequenced lockstep.** The engine promises the same seed and intents give the same state, bit for bit. Use it: no snapshot serialisation at all.\\n\\n- Every copy runs the same sim from the same seed. The host decides each tick's intents; everyone else plays the same list.\\n- **Client → host:** `{ t: 'i', x, z, tool, counters }`, unreliable, 15–20 per second, sent to the host. Counters are monotonic press counts, so a lost packet never loses a press.\\n- **Host → everyone:** reliable, about 15 per second: `{ t: 't', from, ticks: [...] }`, the seats' hands per tick, delta-coded; about once a second a state hash. At most 20 messages per second leave each copy, and each is at most 16 KB.\\n- **Host tick:** `due = floor(AIHub.time() * 60 / 1000)`; while `next < due`, build the tick's hands, `e.step(1, { 'game:hands': hands })`, and queue it. Flush every 66 ms.\\n- **Client tick:** step one buffered tick each timer pass; two when more than 6 are queued, eight when more than 30. After `end`, a client may drain what it has, sending nothing.\\n- **Your own cursor is always drawn from the local device at once;** the sim's copy follows. Actions take effect after the round trip, which is why sparks appear at the sim's cursor position.\\n- Settings match on every copy; dev sliders are disabled in a session. A hash mismatch logs an error and is a test failure. There is no runtime resync (`restore` refuses another run's capture).\\n- **Tested:** a 70-line prototype of exactly this, on the starter with a 40,000-vertex live mesh and no card, passed all four harness runs below. Every client's hash matched the host's at every check (about one a second), including at `players=4&latency=150&jitter=50&loss=5`.\\n- If software rendering makes the harness too slow with your full scenes, reduce sheet density when the adapter is SwiftShader (`__engine.info()`), in a session only.\\n\\n**On its own.** With no hub, the game runs exactly as a normal game: story, Board, solo, and couch co-op for up to four devices (§6). There is no other online mode: outside a session there is no hub network and we add no servers. State this in About.\\n\\n**Test it** as the protocol's *Test it* section says: download `harness.html`, `bridge.js` and `round.js` into a test folder under `out/` next to a copy of the deliverable, serve with `python3 -m http.server 0 --bind 127.0.0.1` (read the port it prints; confirm the page is your game; stop it by its PID), and pass all of: `?game=<file>&players=2&auto=1`, `&players=4&latency=150&jitter=50&loss=5&auto=1`, the same with `&scenario=host-leave`, and `&players=2&scenario=server`. A game passes when `window.__hubCheck.pass` is true. Use `&limit=` to shorten rounds; expose your hash checks on a debug object so the test can read them from each frame and require zero mismatches. Also open the game with no session to confirm it runs normally.\\n\\n---\\n\\n## 17. Engine and architecture\\n\\n### 17.1 Setup, and traps already hit on this machine\\n\\nUse the engine's **full workspace, not the lean** single page: you want its headless tests, replays and `node x` tools. The engine stays read-only: add every system, art asset and animation on top of it, in `labs/game/`. The rest of the stack is what it ships: TypeScript and Vite, with no new npm dependencies. This plan was tested against `my-3dge@e7a1243`. `git clone --depth 1` may give you something newer: `docs/API.md` is the truth.\\n\\n```sh\\n# in the empty dev folder\\nexport TMPDIR=$(mktemp -d /tmp/g.XXXXXX)        # trap 1\\nexport CHROMIUM_PATH=$(ls -d ~/.cache/ms-playwright/chromium-*/chrome-linux64/chrome | head -1)   # trap 2\\nsrc=$(mktemp -d) && git clone --depth 1 https://github.com/michaelcrosato/my-3dge \\\"$src\\\" && node \\\"$src/tools/game/new-game.mjs\\\" . --name <your-slug>\\nnpm ci\\n```\\n\\n1. **A long `TMPDIR` breaks tools silently.** The run's `TMPDIR` is too long for a Unix socket path. Chromium dies with `Socket path too long` and `node x shot` then hung for over 4 minutes; `npx tsx` fails with `EINVAL`. Use the short private directory above in every shell (shell state may not persist between tool calls, so put it in your commands or a script), and remove it when you finish. This is the one exception to TASK.md's rule against `/tmp`: no path inside your folder is short enough for the sockets. Keep your real files in your folder.\\n2. **Do not run `bash scripts/setup.sh`** even though the output and `AGENTS.md` suggest it: it would download Node and Chrome for Testing. `npm ci` plus `CHROMIUM_PATH` is enough. The path above is Chromium 153, which the engine targets.\\n3. **Don't use `node x shot --cam3`:** the flag is `--cam` (`node x help shot`).\\n4. A running page **cannot switch scenes**; the guide's page reload is not allowed in a hub session. Use §17.2. **Every query key is read as a setting**: an unknown one stops the engine, which is why §16 strips the hub's.\\n5. The engine's `modal` stops intents but not the sim: pause with `inspector.pause()` too.\\n6. The engine's gamepad device gives one active pad, and another pad used can take over. For gameplay, read pads yourself (§17.4). Use engine input for menus, keyboard and mouse.\\n7. Every source file under `labs/` needs a `@file` comment and stays under 400 lines (hard cap 600), `.mjs` tools included. Run the formatter before `npm run check`.\\n8. Game code may not import three.js (`npm run check` refuses it). The recipes below stay legal.\\n9. Golden replays break whenever play changes on purpose: `node x replay labs/game/replays --browser sim --update`.\\n10. The guide cites `labs/playground/`, but a game gets only `labs/game/` and `labs/box/`. To read playground code you would need the engine's repository; this plan does not.\\n11. You share this machine. Stay in your own folder and keep one or two browsers open. Stop only processes you started, by PID: never `pkill`, `killall` or `fuser -k`, and never kill whatever holds a port. The `x` commands pick a free port by themselves. Prefer `file://` and the engine's headless tools; start a server only for the hub harness.\\n12. **The browsers are already downloaded: never run `playwright install`.** The engine's own `@playwright/test` (1.64.1) drives the downloaded Chromium through `executablePath` (tested). TASK.md's `npm install playwright@1.63.0` would change the game's pinned dependencies, so for Firefox and WebKit use the system Python's Playwright instead (tested): `from playwright.sync_api import sync_playwright`.\\n13. Runs have no display, so all of this is headless; a headed browser would need `xvfb-run`. WebGPU needs a secure page: `file://` or `http://127.0.0.1`.\\n14. `earlyoom` is on. \\\"Target closed\\\", \\\"page crashed\\\" or \\\"browser has been closed\\\" means memory ran out, not a bug in your game: run fewer browsers rather than retrying, and run the four-copy harness alone.\\n15. The system Python has only Playwright. For anything else: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` if it drives a browser.\\n\\nMeasured on the starter: `npm ci` 6 s, `npm run check` 25 s, `npm test` 9 s, `node x shot` 12 s, a one-file build 8 s.\\n\\nTested and working, so build on these: the live mesh of §17.3; one-file build and boot from `file://`; frames still drawing while paused; `step(n, intents)` with custom keys; restart with new settings keeping the page; custom intents recorded in a replay; `cam3=fixed` cuts with `{ blend: true }`; `touch=off`; the boot order and netcode of §16 in all four harness runs. **Not tested:** the game's own card in the harness, a `defineCamera` mode in play, transparent live meshes, the light pool's focus (§17.2), vertex counts past 40,000. Prove these early.\\n\\n### 17.2 One scene, many runs\\n\\nThe page has one scene, `game:main` (`labs/game/scenes/main.ts`, level: a bare floor big enough for one set). Each **run** is one story scene or one operation:\\n\\n```ts\\ninspector.set('game.run', 'op:crosstalk');   // when: 'scene' settings\\ninspector.set('game.phase', 2);              // optional checkpoint\\ninspector.seed(nextSeed);                    // restarts the scene in place: tick 0, settings kept, page and geometry kept\\n```\\n\\n`setup(w)` reads `game.run` and spawns only that set's props and actors. A black HTML fade hides each change. The **Director** (`labs/game/app/director.ts`, plain TypeScript, no DOM, tested in Node) holds the flow: title → story → briefing → op → debrief → next. Settings for a run: `game.run`, `game.phase`, `game.seats`, `game.difficulty`, `game.attract`.\\n\\nKeep a `player: true` actor at the current set (the protagonist in a story; an actor out of sight under the floor in the pit): the light pool and the stage's focus follow it. Check this early.\\n\\nCameras: `inspector.camera.set('cam3=fixed,x,y,z,yawDeg,pitchDeg,fov', { blend: true })` for cuts and sites. Parallax: your own mode with `defineCamera` and `followCamera` (`node x new camera`), reading a module-level target the page writes; view state only.\\n\\n### 17.3 Live meshes (tested)\\n\\nGame code cannot import three.js, and cannot reach the stage's scene. But `defineGeometry`'s builder returns a geometry, and you may keep it. A geometry and attribute class can be taken from any kit shape:\\n\\n```ts\\n// page side, before createEngine\\nconst base = boxGeometry({ width: 1, height: 1, depth: 1 });\\nconst Geometry = base.constructor as new () => typeof base;\\nconst Attribute = base.getAttribute('position').constructor as new (a: Float32Array, n: number) => ReturnType<typeof base.getAttribute>;\\nlet sheet: typeof base | null = null;\\ndefineGeometry('geometry:sheet', { description: '…', budget: 200000, create: () => {\\n  const g = new Geometry();\\n  g.setAttribute('position', new Attribute(positions, 3));   // also normal, color, uv\\n  g.setIndex(indices);\\n  sheet = g;           // keep it\\n  return g;\\n} });\\ndefineMaterial('material:tissue', { vertexColors: true, roughness: 0.35 });\\n// sim side\\ndefineProp('prop:sheet', { parts: [{ geometry: 'geometry:sheet', material: 'material:tissue' }] });\\nspawnProp(w, { prop: 'prop:sheet', at: [x, 0, z], yaw: 0 });\\n// page side, in onFrame\\nposition.setY(i, h); colour.setXYZ(i, r, g, b);\\nposition.needsUpdate = true; colour.needsUpdate = true; sheet.computeVertexNormals();\\n```\\n\\nTested: a 40,401-vertex grid drawn and rewritten every frame on software WebGPU, with vertex colours, under a lit style; the ID pass names it `prop:sheet/mesh/page0`; the builder ran once and survived a restart. It passes types and lint. Build it at maximum extents first so culling bounds are right. If `node x qa geo` flags it, accept it in `tests/baselines/qa-geo-game.json` with the reason. Put this helper in `labs/game/view/field/liveMesh.ts`, and note the missing public API in `ENGINE-FEEDBACK.md`.\\n\\nThe same trick makes static organ and tool shapes: take a kit shape (`limbGeometry`, `pillarGeometry`), write new positions into its array, and call `computeVertexNormals()`.\\n\\n### 17.4 Input: everything is one custom intent\\n\\nThe sim reads one thing: `intents['game:hands']`, an array per seat: `[x, z, tool, useHeld, counters…]`, rounded to 1/256 m. Treat an absent value (a menu, a modal) as \\\"no change.\\\"\\n\\n- **Page:** `labs/game/input/hands.ts` polls every frame. It polls pads directly from `navigator.getGamepads()` (standard indices; use the codes from `input.bindingsFor('actionMap:surgeon')` so rebinding works), reads keyboard and mouse through `input.held / pressed / strength`, integrates the cursor with assist against read-only world data, and converts the mouse to the field with `screenRay(frame.camera, ndc, aspect)` and `onFloor(ray, 0)`.\\n- **Solo and couch:** `(inspector.input).axis('game:hands', hands)` each frame. It merges into each step and is recorded (tested). Attract and autoplay feed the bot's hands the same way.\\n- **Session:** §16's stepping.\\n- **Other commands** to the sim use the same route: `axis('game:beat', n)` advances a story beat.\\n- `defineActionMap('actionMap:surgeon', …)` lists the bindings of §10. Names are lower-case words; `move` names four actions; `lock: false`. Mouse codes: `MouseLeft`, `MouseRight`, `WheelUp`, `WheelDown`.\\n\\n### 17.5 Data is the designer tool\\n\\nSo the rest of the game can be built without new code: everything authored is plain data, validated, with hot jump-in through URL or dev mode.\\n\\n```ts\\n// labs/game/data/cases/crosstalk.ts\\nexport default defineCase('case:crosstalk', {\\n  title: 'Crosstalk', surgeons: ['wren'], seconds: 300, gift: 1,\\n  patient: { name: 'Hal Minsky', age: 58, line: '…', vitals: 60, postcards: { S: '…', A: '…', B: '…', C: '…' } },\\n  story: { before: 'story:03a', after: 'story:03b' },\\n  sites: [{ id: 'liver', field: 'field:liver', cam: [0, 11, -4, 0, -70, 40] } /* … */],\\n  phases: [{\\n    id: 'triage', hint: 'Stop the worst bleed first.',\\n    spawn: [{ kind: 'wound', site: 'liver', path: [[-3, 1], [0, 2]], deep: true }, { kind: 'pool', site: 'liver', at: [1, 0], volume: 4 }],\\n    timeline: [{ at: 6, say: ['odie', 'The lung, Doctor! Now!'] }],\\n    until: 'clear',\\n  } /* … */],\\n  ranks: [/* written by the rank tool */],\\n});\\n```\\n\\n- `labs/game/data/fields/*.ts`: organ ellipses, vessels, palette per field.\\n- `labs/game/data/strains.ts`, `tools.ts`, `balance.ts`.\\n- `labs/game/data/story/*.ts`: beats: `{ set, cam, cast: { wren: { at, act } }, say: { who, text, mood }, drama?: 'IT MOVED.' }`.\\n- `labs/game/data/sets/*.ts`: prop lists and named camera poses.\\n- `validateCase()` and `validateStory()` run in tests and name every bad reference. Jump straight in with `?game.run=op:crosstalk&game.phase=2`.\\n- New target kinds, tools and strains are registry entries (`defineKind`), never `if`s on ids.\\n\\n### 17.6 Files\\n\\nSim-side (imports only `engine/sim-api.ts`; no DOM, clocks or `Math.random`; `Math.pow`, not `**`):\\n\\n```\\nlabs/game/scenes/main.ts          the scene, run setup, settings\\nlabs/game/scenes/op/*.ts          vitals, clock, phases, targets, tools, ratings, gift\\nlabs/game/scenes/strains/*.ts     one per strain\\nlabs/game/scenes/story.ts         stage directions from beats\\nlabs/game/cast/*.ts               actors, actions, crowd bodies\\nlabs/game/data/**                 cases, fields, strains, tools, story, sets, balance\\nlabs/game/bot.ts                  plays any case through game:hands; used by tests, attract, autoplay, AI colleague\\n```\\n\\nPage-side (imports `engine/index.ts`):\\n\\n```\\nlabs/game/main.ts                 boot: hub check, createEngine, onFrame\\nlabs/game/app/                    director, store, settings, idle timer\\nlabs/game/input/                  hands, seats, glyphs\\nlabs/game/view/field/             liveMesh, sheet, thin things, hands, instruments, field FX\\nlabs/game/view/                   bodies, props, materials, textures, looks, cameras, emitters\\nlabs/game/ui/                     hud, radial, screens, dev mode, about\\nlabs/game/audio/                  sfx, songs, voice, mix\\nlabs/game/net/                    hub session, sequencer (pure logic), card\\nlabs/game/replays/                golden replays\\nlabs/game/tools/                  verify, one-file build, e2e, hub checks\\n```\\n\\nSim order each step: read hands → cursors and tools → targets and strains → bleeding and vitals → clock → phase runner → events. The sim says what happened with events; the page turns them into particles, sound and rating pops. The bot's policy is priorities: vitals low → Stabilizer; open deep bleed → stitch; pool hiding a target → drain; then the current phase's targets, with human-like cursor speed.\\n\\nSaves: `createStore`, passed to `createEngine({ store })`, holds progress, ranks, postcards, settings and bindings. In a session the client gives you empty storage; add no code for that.\\n\\n---\\n\\n## 18. Packaging\\n\\nThe deliverable is one self-contained HTML file: no CDN needed. Write `labs/game/tools/one-file.mts`, modelled on `tools/lib/oneFile.ts`, reusing its exported `inlineBuild` and `externalRefs`: Vite `build` with `configFile: false`, `base: './'`, the alias of `three` to `three/webgpu`, `write: false`, `modulePreload: false`, `cssCodeSplit: false`, `assetsInlineLimit: () => true`, `rollupOptions: { input: <labs/game/index.html>, output: { inlineDynamicImports: true } }`. Tested on the starter: 6.7 MB, no external references, boots from `file://` without errors.\\n\\n- Run it with `npx tsx`, and write the file where TASK.md says. It is tested with the short `TMPDIR`.\\n- `inlineBuild`'s note names the playground: `.replace(ONE_FILE_NOTE, '<!-- your note -->')`, also exported from `tools/lib/oneFile.ts` (tested).\\n- Paste `session.js` into `labs/game/index.html` as the first inline script. Through this build it came out byte-identical and first, and the harness accepted it (tested). Keep a test that says so.\\n- A script with `<!--` in it fails the build: write it apart in the source.\\n- The build embeds the exit interview's data for the About screen (§21), so they cannot disagree.\\n- Make all tests that need a browser run against this file, not the dev server, once it exists.\\n\\n---\\n\\n## 19. Testing\\n\\n**One command: `npm run verify`** (`labs/game/tools/verify.mjs`; add it with `npm pkg set scripts.verify=\\\"node labs/game/tools/verify.mjs\\\"`). It prints only failures and one final line (`verify: 212 passed, 0 failed`). Rerun it only after changing the code it covers; `--fast` skips browsers. Use one or two browsers at a time. No subagents or workflows to debate, review, judge or audit. Make it the first thing you write, from this skeleton.\\n\\nTested on the starter, under the run's real long `TMPDIR`, with no setup: `verify: 8 passed, 0 failed` in 28 s (14 s with `--fast`). With a broken test, a lint error and a failing browser check, it printed exactly those three `FAIL` lines and `verify: 9 passed, 3 failed`, and exited 1. It passes `npm run check` itself. For a lint failure it prints the summary; run `npm run check` for the details.\\n\\n```js\\n/**\\n * @file The one command, `npm run verify`: runs every check quietly and prints only the failures, then one line with\\n * the count. `--fast` skips what needs a browser. It sets its own short TMPDIR and CHROMIUM_PATH, so it needs no setup,\\n * and removes the temporary folder when done. Exit 0 when nothing failed.\\n */\\nimport { spawnSync } from 'node:child_process';\\nimport { existsSync, globSync, mkdtempSync, readFileSync, rmSync } from 'node:fs';\\nimport { homedir } from 'node:os';\\n\\nconst fast = process.argv.includes('--fast');\\nconst tmp = mkdtempSync('/tmp/g.');\\nconst chrome = globSync(`${homedir()}/.cache/ms-playwright/chromium-*/chrome-linux64/chrome`)[0];\\nconst env = { ...process.env, TMPDIR: tmp, CHROMIUM_PATH: process.env.CHROMIUM_PATH ?? chrome };\\nconst run = (command, ...args) => spawnSync(command, args, { env, encoding: 'utf8', maxBuffer: 2 ** 28 });\\n\\nlet passed = 0;\\nconst failed = [];\\nconst note = (name, ok, detail = '') => (ok ? (passed += 1) : failed.push(`${name}${detail ? `: ${detail}` : ''}`));\\nconst tail = (result) => `${result.stdout}${result.stderr}`.trim().split('\\\\n').slice(-6).join(' | ').slice(0, 600);\\n\\n/** A step whose exit status is its verdict. */\\nconst step = (name, command, ...args) => {\\n  const result = run(command, ...args);\\n  note(name, result.status === 0, tail(result));\\n};\\n\\n/** Vitest, counted test by test from the JSON report npm test writes. */\\nfunction tests() {\\n  const report = 'out/test/report.json';\\n  rmSync(report, { force: true });\\n  const result = run('npm', 'test', '--silent');\\n  if (!existsSync(report)) return note('npm test', false, tail(result));\\n  for (const file of JSON.parse(readFileSync(report, 'utf8')).testResults) {\\n    for (const test of file.assertionResults) {\\n\",\"total_lines\":952}}","is_error":false},{"type":"tool_result","tool_use_id":"call-ce134aa1-48f3-4455-a74d-1cc60d170b1f-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The shift, with no DOM. Title, story, briefing, operation, debrief, and the menus around them.\\n * The page draws whatever this says and starts the run it names.\\n */\\nimport { storyCases } from '../op/cases';\\nimport { caseById } from '../op/cases';\\nimport { rankFor } from '../op/ratings';\\nimport { sceneById } from '../op/story';\\nimport { handbookCards } from '../op/table';\\n10→import type { Difficulty, Rank } from '../op/types';\\n\\n/** Where the player is. */\\nexport type Screen =\\n  | 'title'\\n  | 'board'\\n  | 'story'\\n  | 'brief'\\n  | 'op'\\n  | 'debrief'\\n20→  | 'pause'\\n  | 'settings'\\n  | 'handbook'\\n  | 'about'\\n  | 'scrub'\\n  | 'credits'\\n  | 'attract'\\n  | 'dev';\\n\\n/** What a finished night remembers. Dev runs and the attract loop do not write it. */\\n30→export interface Progress {\\n  cleared: number;\\n  ranks: string[];\\n  scores: number[];\\n  postcards: string[];\\n  free: boolean;\\n  attending: boolean;\\n  difficulty: Difficulty;\\n  simple: boolean;\\n  glyphs: 'playstation' | 'xbox';\\n40→  blood: 'red' | 'teal' | 'off';\\n  master: number;\\n  music: number;\\n  effects: number;\\n  voice: number;\\n  autoText: boolean;\\n  seats: number;\\n}\\n\\n/** One attract clip. Times add up to about three minutes. */\\n50→export interface Clip {\\n  kind: 'logo' | 'op' | 'story' | 'cards';\\n  id: string;\\n  ms: number;\\n}\\n\\n/** The kiosk loop. */\\nexport const ATTRACT: readonly Clip[] = [\\n  { kind: 'logo', id: '', ms: 6000 },\\n  { kind: 'op', id: 'case:first-cut', ms: 24000 },\\n60→  { kind: 'op', id: 'case:crosstalk', ms: 24000 },\\n  { kind: 'story', id: 'after-2', ms: 18000 },\\n  { kind: 'op', id: 'case:struck-off', ms: 24000 },\\n  { kind: 'op', id: 'case:reverie', ms: 24000 },\\n  { kind: 'op', id: 'case:gala-night', ms: 24000 },\\n  { kind: 'op', id: 'case:mercy', ms: 26000 },\\n  { kind: 'cards', id: '', ms: 16000 },\\n];\\n\\n/** A menu row. */\\n70→export interface Item {\\n  id: string;\\n  label: string;\\n}\\n\\n/** The whole front end. */\\nexport interface Campaign {\\n  screen: Screen;\\n  back: Screen;\\n  progress: Progress;\\n80→  focus: number;\\n  caseId: string;\\n  caseIndex: number;\\n  storyId: string;\\n  leg: 'before' | 'after';\\n  box: number;\\n  board: number;\\n  tab: number;\\n  page: number;\\n  clip: number;\\n90→  clipMs: number;\\n  idle: number;\\n  lineMs: number;\\n  record: boolean;\\n  won: boolean;\\n  fail: string;\\n  lastRank: string;\\n  lastScore: number;\\n  postcard: string;\\n  devTab: number;\\n100→  hideHud: boolean;\\n  claimed: boolean[];\\n}\\n\\nconst MENUS: readonly Screen[] = ['title', 'board', 'settings', 'handbook', 'about', 'scrub'];\\n\\n/** A new night, nothing cleared. */\\nexport function blankProgress(): Progress {\\n  return {\\n    cleared: 0,\\n110→    ranks: [],\\n    scores: [],\\n    postcards: [],\\n    free: false,\\n    attending: false,\\n    difficulty: 'resident',\\n    simple: false,\\n    glyphs: 'playstation',\\n    blood: 'red',\\n    master: 70,\\n120→    music: 10,\\n    effects: 100,\\n    voice: 100,\\n    autoText: false,\\n    seats: 1,\\n  };\\n}\\n\\n/** The title, over a blank or a loaded night. */\\nexport function createCampaign(progress: Progress = blankProgress()): Campaign {\\n130→  return {\\n    screen: 'title',\\n    back: 'title',\\n    progress,\\n    focus: 0,\\n    caseId: 'case:first-cut',\\n    caseIndex: 0,\\n    storyId: 'before-1',\\n    leg: 'before',\\n    box: 0,\\n140→    board: 0,\\n    tab: 0,\\n    page: 0,\\n    clip: 0,\\n    clipMs: ATTRACT[0].ms,\\n    idle: 0,\\n    lineMs: 0,\\n    record: true,\\n    won: false,\\n    fail: '',\\n150→    lastRank: '',\\n    lastScore: 0,\\n    postcard: '',\\n    devTab: 0,\\n    hideHud: false,\\n    claimed: [true, false, false, false],\\n  };\\n}\\n\\n/** Story cases plus Free Surgery once the night is over. */\\n160→export function boardIds(progress: Progress): string[] {\\n  const ids = storyCases().map((item) => item.id);\\n  if (progress.free) ids.push('case:first-cut');\\n  return ids;\\n}\\n\\n/** Rows for the screen the player is on. */\\nexport function items(c: Campaign): Item[] {\\n  if (c.screen === 'title') {\\n    const rows: Item[] = [];\\n170→    if (c.progress.cleared > 0 && c.progress.cleared < storyCases().length) rows.push({ id: 'continue', label: 'Continue' });\\n    rows.push({ id: 'new', label: 'New Shift' }, { id: 'board', label: 'The Board' }, { id: 'scrub', label: 'Scrub In' });\\n    rows.push({ id: 'settings', label: 'Settings' }, { id: 'about', label: 'About' });\\n    return rows;\\n  }\\n  if (c.screen === 'board') return [{ id: 'play', label: 'Open case' }, { id: 'postcards', label: 'Postcards' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'brief') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'debrief') {\\n    return c.won\\n      ? [{ id: 'next', label: 'Continue' }]\\n180→      : [{ id: 'retry', label: 'Retry case' }, { id: 'board', label: 'The Board' }];\\n  }\\n  if (c.screen === 'pause') {\\n    return [\\n      { id: 'resume', label: 'Resume' },\\n      { id: 'phase', label: 'Retry phase' },\\n      { id: 'retry', label: 'Retry case' },\\n      { id: 'handbook', label: 'Handbook' },\\n      { id: 'settings', label: 'Settings' },\\n      { id: 'controls', label: 'Controls' },\\n190→      { id: 'dev', label: 'Dev Mode' },\\n      { id: 'board', label: 'Quit to Board' },\\n    ];\\n  }\\n  if (c.screen === 'settings') return settingsItems(c);\\n  if (c.screen === 'handbook') return [{ id: 'back', label: 'Back' }];\\n  if (c.screen === 'about' || c.screen === 'credits') return [{ id: 'back', label: c.screen === 'credits' ? 'Title' : 'Back' }];\\n  if (c.screen === 'scrub') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'dev') return devItems(c);\\n  return [];\\n200→}\",\"content_concise\":\"1→/**\\n * @file The shift, with no DOM. Title, story, briefing, operation, debrief, and the menus around them.\\n * The page draws whatever this says and starts the run it names.\\n */\\nimport { storyCases } from '../op/cases';\\nimport { caseById } from '../op/cases';\\nimport { rankFor } from '../op/ratings';\\nimport { sceneById } from '../op/story';\\nimport { handbookCards } from '../op/table';\\n10→import type { Difficulty, Rank } from '../op/types';\\n\\n/** Where the player is. */\\nexport type Screen =\\n  | 'title'\\n  | 'board'\\n  | 'story'\\n  | 'brief'\\n  | 'op'\\n  | 'debrief'\\n20→  | 'pause'\\n  | 'settings'\\n  | 'handbook'\\n  | 'about'\\n  | 'scrub'\\n  | 'credits'\\n  | 'attract'\\n  | 'dev';\\n\\n/** What a finished night remembers. Dev runs and the attract loop do not write it. */\\n30→export interface Progress {\\n  cleared: number;\\n  ranks: string[];\\n  scores: number[];\\n  postcards: string[];\\n  free: boolean;\\n  attending: boolean;\\n  difficulty: Difficulty;\\n  simple: boolean;\\n  glyphs: 'playstation' | 'xbox';\\n40→  blood: 'red' | 'teal' | 'off';\\n  master: number;\\n  music: number;\\n  effects: number;\\n  voice: number;\\n  autoText: boolean;\\n  seats: number;\\n}\\n\\n/** One attract clip. Times add up to about three minutes. */\\n50→export interface Clip {\\n  kind: 'logo' | 'op' | 'story' | 'cards';\\n  id: string;\\n  ms: number;\\n}\\n\\n/** The kiosk loop. */\\nexport const ATTRACT: readonly Clip[] = [\\n  { kind: 'logo', id: '', ms: 6000 },\\n  { kind: 'op', id: 'case:first-cut', ms: 24000 },\\n60→  { kind: 'op', id: 'case:crosstalk', ms: 24000 },\\n  { kind: 'story', id: 'after-2', ms: 18000 },\\n  { kind: 'op', id: 'case:struck-off', ms: 24000 },\\n  { kind: 'op', id: 'case:reverie', ms: 24000 },\\n  { kind: 'op', id: 'case:gala-night', ms: 24000 },\\n  { kind: 'op', id: 'case:mercy', ms: 26000 },\\n  { kind: 'cards', id: '', ms: 16000 },\\n];\\n\\n/** A menu row. */\\n70→export interface Item {\\n  id: string;\\n  label: string;\\n}\\n\\n/** The whole front end. */\\nexport interface Campaign {\\n  screen: Screen;\\n  back: Screen;\\n  progress: Progress;\\n80→  focus: number;\\n  caseId: string;\\n  caseIndex: number;\\n  storyId: string;\\n  leg: 'before' | 'after';\\n  box: number;\\n  board: number;\\n  tab: number;\\n  page: number;\\n  clip: number;\\n90→  clipMs: number;\\n  idle: number;\\n  lineMs: number;\\n  record: boolean;\\n  won: boolean;\\n  fail: string;\\n  lastRank: string;\\n  lastScore: number;\\n  postcard: string;\\n  devTab: number;\\n100→  hideHud: boolean;\\n  claimed: boolean[];\\n}\\n\\nconst MENUS: readonly Screen[] = ['title', 'board', 'settings', 'handbook', 'about', 'scrub'];\\n\\n/** A new night, nothing cleared. */\\nexport function blankProgress(): Progress {\\n  return {\\n    cleared: 0,\\n110→    ranks: [],\\n    scores: [],\\n    postcards: [],\\n    free: false,\\n    attending: false,\\n    difficulty: 'resident',\\n    simple: false,\\n    glyphs: 'playstation',\\n    blood: 'red',\\n    master: 70,\\n120→    music: 10,\\n    effects: 100,\\n    voice: 100,\\n    autoText: false,\\n    seats: 1,\\n  };\\n}\\n\\n/** The title, over a blank or a loaded night. */\\nexport function createCampaign(progress: Progress = blankProgress()): Campaign {\\n130→  return {\\n    screen: 'title',\\n    back: 'title',\\n    progress,\\n    focus: 0,\\n    caseId: 'case:first-cut',\\n    caseIndex: 0,\\n    storyId: 'before-1',\\n    leg: 'before',\\n    box: 0,\\n140→    board: 0,\\n    tab: 0,\\n    page: 0,\\n    clip: 0,\\n    clipMs: ATTRACT[0].ms,\\n    idle: 0,\\n    lineMs: 0,\\n    record: true,\\n    won: false,\\n    fail: '',\\n150→    lastRank: '',\\n    lastScore: 0,\\n    postcard: '',\\n    devTab: 0,\\n    hideHud: false,\\n    claimed: [true, false, false, false],\\n  };\\n}\\n\\n/** Story cases plus Free Surgery once the night is over. */\\n160→export function boardIds(progress: Progress): string[] {\\n  const ids = storyCases().map((item) => item.id);\\n  if (progress.free) ids.push('case:first-cut');\\n  return ids;\\n}\\n\\n/** Rows for the screen the player is on. */\\nexport function items(c: Campaign): Item[] {\\n  if (c.screen === 'title') {\\n    const rows: Item[] = [];\\n170→    if (c.progress.cleared > 0 && c.progress.cleared < storyCases().length) rows.push({ id: 'continue', label: 'Continue' });\\n    rows.push({ id: 'new', label: 'New Shift' }, { id: 'board', label: 'The Board' }, { id: 'scrub', label: 'Scrub In' });\\n    rows.push({ id: 'settings', label: 'Settings' }, { id: 'about', label: 'About' });\\n    return rows;\\n  }\\n  if (c.screen === 'board') return [{ id: 'play', label: 'Open case' }, { id: 'postcards', label: 'Postcards' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'brief') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'debrief') {\\n    return c.won\\n      ? [{ id: 'next', label: 'Continue' }]\\n180→      : [{ id: 'retry', label: 'Retry case' }, { id: 'board', label: 'The Board' }];\\n  }\\n  if (c.screen === 'pause') {\\n    return [\\n      { id: 'resume', label: 'Resume' },\\n      { id: 'phase', label: 'Retry phase' },\\n      { id: 'retry', label: 'Retry case' },\\n      { id: 'handbook', label: 'Handbook' },\\n      { id: 'settings', label: 'Settings' },\\n      { id: 'controls', label: 'Controls' },\\n190→      { id: 'dev', label: 'Dev Mode' },\\n      { id: 'board', label: 'Quit to Board' },\\n    ];\\n  }\\n  if (c.screen === 'settings') return settingsItems(c);\\n  if (c.screen === 'handbook') return [{ id: 'back', label: 'Back' }];\\n  if (c.screen === 'about' || c.screen === 'credits') return [{ id: 'back', label: c.screen === 'credits' ? 'Title' : 'Back' }];\\n  if (c.screen === 'scrub') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'dev') return devItems(c);\\n  return [];\\n200→}\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.ts\",\"offset\":null,\"limit\":200,\"raw_output\":\"/**\\n * @file The shift, with no DOM. Title, story, briefing, operation, debrief, and the menus around them.\\n * The page draws whatever this says and starts the run it names.\\n */\\nimport { storyCases } from '../op/cases';\\nimport { caseById } from '../op/cases';\\nimport { rankFor } from '../op/ratings';\\nimport { sceneById } from '../op/story';\\nimport { handbookCards } from '../op/table';\\nimport type { Difficulty, Rank } from '../op/types';\\n\\n/** Where the player is. */\\nexport type Screen =\\n  | 'title'\\n  | 'board'\\n  | 'story'\\n  | 'brief'\\n  | 'op'\\n  | 'debrief'\\n  | 'pause'\\n  | 'settings'\\n  | 'handbook'\\n  | 'about'\\n  | 'scrub'\\n  | 'credits'\\n  | 'attract'\\n  | 'dev';\\n\\n/** What a finished night remembers. Dev runs and the attract loop do not write it. */\\nexport interface Progress {\\n  cleared: number;\\n  ranks: string[];\\n  scores: number[];\\n  postcards: string[];\\n  free: boolean;\\n  attending: boolean;\\n  difficulty: Difficulty;\\n  simple: boolean;\\n  glyphs: 'playstation' | 'xbox';\\n  blood: 'red' | 'teal' | 'off';\\n  master: number;\\n  music: number;\\n  effects: number;\\n  voice: number;\\n  autoText: boolean;\\n  seats: number;\\n}\\n\\n/** One attract clip. Times add up to about three minutes. */\\nexport interface Clip {\\n  kind: 'logo' | 'op' | 'story' | 'cards';\\n  id: string;\\n  ms: number;\\n}\\n\\n/** The kiosk loop. */\\nexport const ATTRACT: readonly Clip[] = [\\n  { kind: 'logo', id: '', ms: 6000 },\\n  { kind: 'op', id: 'case:first-cut', ms: 24000 },\\n  { kind: 'op', id: 'case:crosstalk', ms: 24000 },\\n  { kind: 'story', id: 'after-2', ms: 18000 },\\n  { kind: 'op', id: 'case:struck-off', ms: 24000 },\\n  { kind: 'op', id: 'case:reverie', ms: 24000 },\\n  { kind: 'op', id: 'case:gala-night', ms: 24000 },\\n  { kind: 'op', id: 'case:mercy', ms: 26000 },\\n  { kind: 'cards', id: '', ms: 16000 },\\n];\\n\\n/** A menu row. */\\nexport interface Item {\\n  id: string;\\n  label: string;\\n}\\n\\n/** The whole front end. */\\nexport interface Campaign {\\n  screen: Screen;\\n  back: Screen;\\n  progress: Progress;\\n  focus: number;\\n  caseId: string;\\n  caseIndex: number;\\n  storyId: string;\\n  leg: 'before' | 'after';\\n  box: number;\\n  board: number;\\n  tab: number;\\n  page: number;\\n  clip: number;\\n  clipMs: number;\\n  idle: number;\\n  lineMs: number;\\n  record: boolean;\\n  won: boolean;\\n  fail: string;\\n  lastRank: string;\\n  lastScore: number;\\n  postcard: string;\\n  devTab: number;\\n  hideHud: boolean;\\n  claimed: boolean[];\\n}\\n\\nconst MENUS: readonly Screen[] = ['title', 'board', 'settings', 'handbook', 'about', 'scrub'];\\n\\n/** A new night, nothing cleared. */\\nexport function blankProgress(): Progress {\\n  return {\\n    cleared: 0,\\n    ranks: [],\\n    scores: [],\\n    postcards: [],\\n    free: false,\\n    attending: false,\\n    difficulty: 'resident',\\n    simple: false,\\n    glyphs: 'playstation',\\n    blood: 'red',\\n    master: 70,\\n    music: 10,\\n    effects: 100,\\n    voice: 100,\\n    autoText: false,\\n    seats: 1,\\n  };\\n}\\n\\n/** The title, over a blank or a loaded night. */\\nexport function createCampaign(progress: Progress = blankProgress()): Campaign {\\n  return {\\n    screen: 'title',\\n    back: 'title',\\n    progress,\\n    focus: 0,\\n    caseId: 'case:first-cut',\\n    caseIndex: 0,\\n    storyId: 'before-1',\\n    leg: 'before',\\n    box: 0,\\n    board: 0,\\n    tab: 0,\\n    page: 0,\\n    clip: 0,\\n    clipMs: ATTRACT[0].ms,\\n    idle: 0,\\n    lineMs: 0,\\n    record: true,\\n    won: false,\\n    fail: '',\\n    lastRank: '',\\n    lastScore: 0,\\n    postcard: '',\\n    devTab: 0,\\n    hideHud: false,\\n    claimed: [true, false, false, false],\\n  };\\n}\\n\\n/** Story cases plus Free Surgery once the night is over. */\\nexport function boardIds(progress: Progress): string[] {\\n  const ids = storyCases().map((item) => item.id);\\n  if (progress.free) ids.push('case:first-cut');\\n  return ids;\\n}\\n\\n/** Rows for the screen the player is on. */\\nexport function items(c: Campaign): Item[] {\\n  if (c.screen === 'title') {\\n    const rows: Item[] = [];\\n    if (c.progress.cleared > 0 && c.progress.cleared < storyCases().length) rows.push({ id: 'continue', label: 'Continue' });\\n    rows.push({ id: 'new', label: 'New Shift' }, { id: 'board', label: 'The Board' }, { id: 'scrub', label: 'Scrub In' });\\n    rows.push({ id: 'settings', label: 'Settings' }, { id: 'about', label: 'About' });\\n    return rows;\\n  }\\n  if (c.screen === 'board') return [{ id: 'play', label: 'Open case' }, { id: 'postcards', label: 'Postcards' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'brief') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'debrief') {\\n    return c.won\\n      ? [{ id: 'next', label: 'Continue' }]\\n      : [{ id: 'retry', label: 'Retry case' }, { id: 'board', label: 'The Board' }];\\n  }\\n  if (c.screen === 'pause') {\\n    return [\\n      { id: 'resume', label: 'Resume' },\\n      { id: 'phase', label: 'Retry phase' },\\n      { id: 'retry', label: 'Retry case' },\\n      { id: 'handbook', label: 'Handbook' },\\n      { id: 'settings', label: 'Settings' },\\n      { id: 'controls', label: 'Controls' },\\n      { id: 'dev', label: 'Dev Mode' },\\n      { id: 'board', label: 'Quit to Board' },\\n    ];\\n  }\\n  if (c.screen === 'settings') return settingsItems(c);\\n  if (c.screen === 'handbook') return [{ id: 'back', label: 'Back' }];\\n  if (c.screen === 'about' || c.screen === 'credits') return [{ id: 'back', label: c.screen === 'credits' ? 'Title' : 'Back' }];\\n  if (c.screen === 'scrub') return [{ id: 'start', label: 'Start' }, { id: 'back', label: 'Back' }];\\n  if (c.screen === 'dev') return devItems(c);\\n  return [];\\n}\\n\",\"total_lines\":593}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"582db1ef-005c-40dc-842f-394695187ac3"}
{"type":"assistant","message":{"id":"msg_216","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"A large amount of work remains.\n\nThe plan is to build a single HTML page that boots the engine with both scenes. It will render campaign screens as DOM elements, feed hands to the simulation, paint the field, and handle hub navigation.\n\nI will read the remaining campaign.ts logic, scene exports, and engine interfaces to understand hand packing and field painting. Files will stay under 600 lines. I will run campaign tests while reading.","signature":""},{"type":"tool_use","id":"call-3c9accbc-e4df-4582-a491-6cee511e5dfe-11","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.ts","offset":200}},{"type":"tool_use","id":"call-3c9accbc-e4df-4582-a491-6cee511e5dfe-12","name":"grep","input":{"pattern":"export function (packHands|unpackHands|HAND_STRIDE|paintField|followChart|liveOp|desiredRun|openRun)","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game"}},{"type":"tool_use","id":"call-3c9accbc-e4df-4582-a491-6cee511e5dfe-13","name":"grep","input":{"pattern":"export (function|const|type|interface) (createEngine|defineActionMap|createStore|createAudio|screenRay|onFloor|defineEmitter)","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/index.ts"}},{"type":"tool_use","id":"call-3c9accbc-e4df-4582-a491-6cee511e5dfe-14","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/package.json","limit":80}},{"type":"tool_use","id":"call-3c9accbc-e4df-4582-a491-6cee511e5dfe-15","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/PLAN.md","offset":770,"limit":160}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":13375,"output_tokens":754,"cache_read_input_tokens":48896,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"7f84c279-7d55-46fa-aa90-d3240b4b131e"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-3c9accbc-e4df-4582-a491-6cee511e5dfe-11","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"200→}\\n\\n/** Settings rows for the open page. */\\nfunction settingsItems(c: Campaign): Item[] {\\n  const p = c.progress;\\n  const pages = [\\n    [\\n      { id: 'master', label: `Master ${p.master}` },\\n      { id: 'music', label: `Music ${p.music}` },\\n      { id: 'effects', label: `Effects ${p.effects}` },\\n210→      { id: 'voice', label: `Voice ${p.voice}` },\\n    ],\\n    [\\n      { id: 'glyphs', label: `Glyphs ${p.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'}` },\\n      { id: 'back', label: 'Back' },\\n    ],\\n    [\\n      { id: 'difficulty', label: `Difficulty ${p.difficulty}` },\\n      { id: 'simple', label: `Simple Gift ${p.simple ? 'on' : 'off'}` },\\n      { id: 'autoText', label: `Auto text ${p.autoText ? 'on' : 'off'}` },\\n220→    ],\\n    [{ id: 'blood', label: `Blood ${p.blood}` }],\\n  ];\\n  return [...pages[c.page]!, { id: 'back', label: 'Back' }];\\n}\\n\\n/** Dev Mode rows for the open tab. */\\nfunction devItems(c: Campaign): Item[] {\\n  const tabs = ['Play', 'Balance', 'View', 'Author', 'Data'];\\n  if (c.devTab === 1) return [{ id: 'reset', label: 'Reset sliders' }, { id: 'back', label: 'Back' }];\\n230→  if (c.devTab === 2) return [{ id: 'hud', label: c.hideHud ? 'Show HUD' : 'Hide HUD' }, { id: 'fly', label: 'Free camera' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 4) return [{ id: 'copy', label: 'Copy replay' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 3) return [{ id: 'back', label: 'Back' }];\\n  return [\\n    { id: 'win', label: 'Win phase' },\\n    { id: 'fail', label: 'Fail phase' },\\n    { id: 'heal', label: 'Restore vitals' },\\n    { id: 'freezeVitals', label: 'Freeze vitals' },\\n    { id: 'freezeClock', label: 'Freeze clock' },\\n    { id: 'gift', label: 'Infinite Gift' },\\n240→    { id: 'oneHit', label: 'One-hit strains' },\\n    { id: 'spawn', label: 'Spawn a Lull' },\\n    { id: 'unlock', label: 'Unlock the board' },\\n    { id: 'auto', label: 'Autoplay' },\\n    { id: 'step', label: 'Frame step' },\\n    { id: 'slow', label: 'Quarter speed' },\\n    { id: 'fast', label: 'Four times' },\\n    { id: 'tab', label: `Tab ${tabs[c.devTab]}` },\\n    { id: 'back', label: 'Back' },\\n  ];\\n250→}\\n\\n/** Move the highlight. */\\nexport function move(c: Campaign, dir: number): void {\\n  const rows = items(c);\\n  if (!rows.length) return;\\n  c.focus = (c.focus + dir + rows.length) % rows.length;\\n  c.idle = 0;\\n}\\n\\n260→/** Browse a card, a page, or a dev tab. */\\nexport function browse(c: Campaign, dir: number): void {\\n  c.idle = 0;\\n  if (c.screen === 'board') {\\n    const ids = boardIds(c.progress);\\n    c.board = (c.board + dir + ids.length) % ids.length;\\n    return;\\n  }\\n  if (c.screen === 'settings') {\\n    c.page = (c.page + dir + 4) % 4;\\n270→    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'handbook') {\\n    const n = handbookCards().length;\\n    c.page = (c.page + dir + n) % n;\\n    return;\\n  }\\n  if (c.screen === 'about' || c.screen === 'credits') {\\n    c.page = Math.max(0, c.page + dir);\\n280→    return;\\n  }\\n  if (c.screen === 'dev') {\\n    c.devTab = (c.devTab + dir + 5) % 5;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'story') c.box = Math.max(0, c.box + dir);\\n}\\n\\n290→/** Activate the highlighted row, or advance a story box. */\\nexport function accept(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') return advanceStory(c);\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  const row = items(c)[c.focus];\\n  if (!row) return;\\n  act(c, row.id);\\n}\\n\\n300→/** Activate a row by id. A click uses this. */\\nexport function act(c: Campaign, id: string): void {\\n  c.idle = 0;\\n  if (id === 'back') return cancel(c);\\n  if (id === 'new') return startShift(c);\\n  if (id === 'continue') return continueShift(c);\\n  if (id === 'board') return go(c, 'board');\\n  if (id === 'scrub') return go(c, 'scrub');\\n  if (id === 'settings') return go(c, 'settings');\\n  if (id === 'about') return go(c, 'about');\\n310→  if (id === 'handbook') return go(c, 'handbook');\\n  if (id === 'controls') {\\n    go(c, 'settings');\\n    c.page = 1;\\n    return;\\n  }\\n  if (id === 'dev') return go(c, 'dev');\\n  if (id === 'play' && c.screen === 'board') return openBoard(c);\\n  if (id === 'postcards') {\\n    c.tab = c.tab === 0 ? 1 : 0;\\n320→    return;\\n  }\\n  if (id === 'start' && c.screen === 'brief') {\\n    c.screen = 'op';\\n    c.record = c.caseIndex === c.progress.cleared;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'scrub') {\\n    c.progress.seats = Math.max(1, c.claimed.filter(Boolean).length);\\n    c.screen = 'title';\\n330→    return;\\n  }\\n  if (id === 'next' && c.won) return afterWin(c);\\n  if (id === 'retry') return retryCase(c);\\n  if (id === 'phase') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'resume') {\\n    c.screen = 'op';\\n340→    return;\\n  }\\n  if (id === 'unlock') {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.progress.cleared = storyCases().length;\\n    return;\\n  }\\n  cycleSetting(c, id);\\n}\\n350→\\n/** Circle, or Escape on a menu. */\\nexport function cancel(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') {\\n    finishScene(c);\\n    return;\\n  }\\n  if (c.screen === 'op') {\\n    c.back = 'op';\\n360→    c.screen = 'pause';\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'pause') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  if (c.screen === 'credits') {\\n370→    c.screen = 'title';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.screen = c.back === c.screen ? 'title' : c.back;\\n  if (c.screen === 'pause' || c.screen === 'title') c.focus = 0;\\n}\\n\\n/** Any real input. Attract ends. The idle clock starts over. */\\nexport function noteInput(c: Campaign): void {\\n380→  c.idle = 0;\\n  if (c.screen === 'attract') leaveAttract(c);\\n}\\n\\n/** Milliseconds since the last input. Menus become the kiosk. A session never does. */\\nexport function tickFront(c: Campaign, dtMs: number, inSession: boolean): void {\\n  if (inSession) return;\\n  if (c.screen === 'attract') {\\n    c.clipMs -= dtMs;\\n    if (c.clipMs <= 0) {\\n390→      c.clip = (c.clip + 1) % ATTRACT.length;\\n      c.clipMs = ATTRACT[c.clip].ms;\\n      if (ATTRACT[c.clip].kind === 'story') c.box = 0;\\n    }\\n    return;\\n  }\\n  if (c.screen === 'story' && c.progress.autoText) {\\n    c.lineMs += dtMs;\\n    if (c.lineMs > 2500) {\\n      c.lineMs = 0;\\n400→      advanceStory(c);\\n    }\\n  }\\n  if (!MENUS.includes(c.screen)) return;\\n  c.idle += dtMs;\\n  if (c.idle >= 10000) enterAttract(c);\\n}\\n\\n/** The operation ended. Attract ignores the rank. A recorded win waits for the scene after it. */\\nexport function finishOp(c: Campaign, won: boolean, score: number, slips: number, fail: string): void {\\n410→  if (c.screen !== 'op') return;\\n  const def = caseById(c.caseId);\\n  c.won = won;\\n  c.fail = won ? '' : fail || 'Called off.';\\n  c.lastScore = score;\\n  if (won) {\\n    const rank = rankFor(score, def.par, slips, c.progress.difficulty);\\n    c.lastRank = rank;\\n    const letter = rank === '★' ? 'S' : (rank as Exclude<Rank, '★'>);\\n    c.postcard = def.patients[0]?.postcards[letter] ?? '';\\n420→    if (c.record) {\\n      c.progress.ranks[c.caseIndex] = rank;\\n      c.progress.scores[c.caseIndex] = score;\\n      c.progress.postcards[c.caseIndex] = c.postcard;\\n    }\\n  }\\n  c.screen = 'debrief';\\n  c.focus = 0;\\n}\\n\\n430→/** The run the scene should be showing. */\\nexport function desiredRun(c: Campaign): string {\\n  if (c.screen === 'op') return `op:${c.caseId}`;\\n  if (c.screen === 'attract') {\\n    const clip = ATTRACT[c.clip];\\n    if (clip.kind === 'op') return `op:${clip.id}`;\\n  }\\n  return 'title';\\n}\\n\\n440→/** True while the kiosk is inside an operation. */\\nexport function desiredAttract(c: Campaign): boolean {\\n  return c.screen === 'attract' && ATTRACT[c.clip].kind === 'op';\\n}\\n\\n/** The story box on screen, if this screen has one. */\\nexport function currentBox(c: Campaign): { who: string; text: string; drama: string; where: string } | null {\\n  const id = c.screen === 'attract' && ATTRACT[c.clip].kind === 'story' ? ATTRACT[c.clip].id : c.screen === 'story' ? c.storyId : '';\\n  if (!id) return null;\\n  const scene = sceneById(id);\\n450→  if (!scene) return null;\\n  const box = scene.boxes[Math.min(c.box, scene.boxes.length - 1)];\\n  return { who: box.who, text: box.text, drama: box.drama ?? '', where: scene.where };\\n}\\n\\n/** Handbook card on the open page. */\\nexport function handbookPage(c: Campaign): { title: string; body: string; index: number; count: number } {\\n  const cards = handbookCards();\\n  const index = ((c.page % cards.length) + cards.length) % cards.length;\\n  return { ...cards[index], index, count: cards.length };\\n460→}\\n\\nfunction go(c: Campaign, screen: Screen): void {\\n  c.back = c.screen === screen ? c.back : c.screen;\\n  c.screen = screen;\\n  c.focus = 0;\\n  c.page = 0;\\n}\\n\\nfunction startShift(c: Campaign): void {\\n470→  c.progress.cleared = 0;\\n  c.progress.ranks = [];\\n  c.progress.scores = [];\\n  c.progress.postcards = [];\\n  c.record = true;\\n  openCase(c, 0, 'before');\\n}\\n\\nfunction continueShift(c: Campaign): void {\\n  const index = Math.min(c.progress.cleared, storyCases().length - 1);\\n480→  const leg = c.progress.ranks[index] ? 'after' : 'before';\\n  c.record = true;\\n  openCase(c, index, leg);\\n}\\n\\nfunction openBoard(c: Campaign): void {\\n  const ids = boardIds(c.progress);\\n  const id = ids[c.board] ?? ids[0];\\n  const index = storyCases().findIndex((item) => item.id === id);\\n  const unlocked = c.progress.free || index <= c.progress.cleared;\\n490→  if (!unlocked || index < 0) return;\\n  c.record = index === c.progress.cleared;\\n  c.caseIndex = index;\\n  c.caseId = storyCases()[index].id;\\n  c.screen = 'brief';\\n  c.focus = 0;\\n}\\n\\nfunction openCase(c: Campaign, index: number, leg: 'before' | 'after'): void {\\n  const def = storyCases()[index];\\n500→  if (!def) {\\n    c.screen = 'credits';\\n    return;\\n  }\\n  c.caseIndex = index;\\n  c.caseId = def.id;\\n  c.leg = leg;\\n  c.storyId = leg === 'before' ? def.storyBefore : def.storyAfter;\\n  c.box = 0;\\n  c.lineMs = 0;\\n510→  c.screen = 'story';\\n}\\n\\nfunction advanceStory(c: Campaign): void {\\n  const scene = sceneById(c.storyId);\\n  if (!scene) return;\\n  if (c.box < scene.boxes.length - 1) {\\n    c.box += 1;\\n    return;\\n  }\\n520→  finishScene(c);\\n}\\n\\nfunction finishScene(c: Campaign): void {\\n  if (c.leg === 'before') {\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.progress.cleared = Math.max(c.progress.cleared, c.caseIndex + 1);\\n530→  if (c.progress.cleared >= storyCases().length) {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.screen = 'credits';\\n    c.page = 0;\\n    return;\\n  }\\n  openCase(c, c.progress.cleared, 'before');\\n}\\n\\n540→function afterWin(c: Campaign): void {\\n  c.leg = 'after';\\n  const def = storyCases()[c.caseIndex];\\n  c.storyId = def?.storyAfter ?? 'after-1';\\n  c.box = 0;\\n  c.screen = 'story';\\n}\\n\\nfunction retryCase(c: Campaign): void {\\n  c.screen = 'op';\\n550→  c.won = false;\\n}\\n\\nfunction enterAttract(c: Campaign): void {\\n  c.screen = 'attract';\\n  c.clip = 0;\\n  c.clipMs = ATTRACT[0].ms;\\n  c.box = 0;\\n  c.record = false;\\n}\\n560→\\nfunction leaveAttract(c: Campaign): void {\\n  c.screen = 'title';\\n  c.focus = 0;\\n  c.idle = 0;\\n  c.record = true;\\n}\\n\\nfunction cycleSetting(c: Campaign, id: string): void {\\n  const p = c.progress;\\n570→  const volume = (n: number) => [0, 10, 40, 70, 100][([0, 10, 40, 70, 100].indexOf(n) + 1) % 5] ?? 70;\\n  if (id === 'master') p.master = volume(p.master);\\n  if (id === 'music') p.music = volume(p.music);\\n  if (id === 'effects') p.effects = volume(p.effects);\\n  if (id === 'voice') p.voice = volume(p.voice);\\n  if (id === 'glyphs') p.glyphs = p.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n  if (id === 'difficulty') {\\n    const order: Difficulty[] = ['intern', 'resident', 'attending'];\\n    const next = order[(order.indexOf(p.difficulty) + 1) % 3];\\n    if (next === 'attending' && !p.attending && !p.free) return;\\n580→    p.difficulty = next;\\n  }\\n  if (id === 'simple') p.simple = !p.simple;\\n  if (id === 'autoText') p.autoText = !p.autoText;\\n  if (id === 'blood') p.blood = p.blood === 'red' ? 'teal' : p.blood === 'teal' ? 'off' : 'red';\\n  if (id === 'hud') c.hideHud = !c.hideHud;\\n}\\n\\n/** Claim a scrub seat. The keyboard claims the first. */\\nexport function claimSeat(c: Campaign, index: number): void {\\n590→  if (index < 0 || index > 3) return;\\n  c.claimed[index] = true;\\n  c.idle = 0;\\n}\\n\",\"content_concise\":\"200→}\\n\\n/** Settings rows for the open page. */\\nfunction settingsItems(c: Campaign): Item[] {\\n  const p = c.progress;\\n  const pages = [\\n    [\\n      { id: 'master', label: `Master ${p.master}` },\\n      { id: 'music', label: `Music ${p.music}` },\\n      { id: 'effects', label: `Effects ${p.effects}` },\\n210→      { id: 'voice', label: `Voice ${p.voice}` },\\n    ],\\n    [\\n      { id: 'glyphs', label: `Glyphs ${p.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'}` },\\n      { id: 'back', label: 'Back' },\\n    ],\\n    [\\n      { id: 'difficulty', label: `Difficulty ${p.difficulty}` },\\n      { id: 'simple', label: `Simple Gift ${p.simple ? 'on' : 'off'}` },\\n      { id: 'autoText', label: `Auto text ${p.autoText ? 'on' : 'off'}` },\\n220→    ],\\n    [{ id: 'blood', label: `Blood ${p.blood}` }],\\n  ];\\n  return [...pages[c.page]!, { id: 'back', label: 'Back' }];\\n}\\n\\n/** Dev Mode rows for the open tab. */\\nfunction devItems(c: Campaign): Item[] {\\n  const tabs = ['Play', 'Balance', 'View', 'Author', 'Data'];\\n  if (c.devTab === 1) return [{ id: 'reset', label: 'Reset sliders' }, { id: 'back', label: 'Back' }];\\n230→  if (c.devTab === 2) return [{ id: 'hud', label: c.hideHud ? 'Show HUD' : 'Hide HUD' }, { id: 'fly', label: 'Free camera' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 4) return [{ id: 'copy', label: 'Copy replay' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 3) return [{ id: 'back', label: 'Back' }];\\n  return [\\n    { id: 'win', label: 'Win phase' },\\n    { id: 'fail', label: 'Fail phase' },\\n    { id: 'heal', label: 'Restore vitals' },\\n    { id: 'freezeVitals', label: 'Freeze vitals' },\\n    { id: 'freezeClock', label: 'Freeze clock' },\\n    { id: 'gift', label: 'Infinite Gift' },\\n240→    { id: 'oneHit', label: 'One-hit strains' },\\n    { id: 'spawn', label: 'Spawn a Lull' },\\n    { id: 'unlock', label: 'Unlock the board' },\\n    { id: 'auto', label: 'Autoplay' },\\n    { id: 'step', label: 'Frame step' },\\n    { id: 'slow', label: 'Quarter speed' },\\n    { id: 'fast', label: 'Four times' },\\n    { id: 'tab', label: `Tab ${tabs[c.devTab]}` },\\n    { id: 'back', label: 'Back' },\\n  ];\\n250→}\\n\\n/** Move the highlight. */\\nexport function move(c: Campaign, dir: number): void {\\n  const rows = items(c);\\n  if (!rows.length) return;\\n  c.focus = (c.focus + dir + rows.length) % rows.length;\\n  c.idle = 0;\\n}\\n\\n260→/** Browse a card, a page, or a dev tab. */\\nexport function browse(c: Campaign, dir: number): void {\\n  c.idle = 0;\\n  if (c.screen === 'board') {\\n    const ids = boardIds(c.progress);\\n    c.board = (c.board + dir + ids.length) % ids.length;\\n    return;\\n  }\\n  if (c.screen === 'settings') {\\n    c.page = (c.page + dir + 4) % 4;\\n270→    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'handbook') {\\n    const n = handbookCards().length;\\n    c.page = (c.page + dir + n) % n;\\n    return;\\n  }\\n  if (c.screen === 'about' || c.screen === 'credits') {\\n    c.page = Math.max(0, c.page + dir);\\n280→    return;\\n  }\\n  if (c.screen === 'dev') {\\n    c.devTab = (c.devTab + dir + 5) % 5;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'story') c.box = Math.max(0, c.box + dir);\\n}\\n\\n290→/** Activate the highlighted row, or advance a story box. */\\nexport function accept(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') return advanceStory(c);\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  const row = items(c)[c.focus];\\n  if (!row) return;\\n  act(c, row.id);\\n}\\n\\n300→/** Activate a row by id. A click uses this. */\\nexport function act(c: Campaign, id: string): void {\\n  c.idle = 0;\\n  if (id === 'back') return cancel(c);\\n  if (id === 'new') return startShift(c);\\n  if (id === 'continue') return continueShift(c);\\n  if (id === 'board') return go(c, 'board');\\n  if (id === 'scrub') return go(c, 'scrub');\\n  if (id === 'settings') return go(c, 'settings');\\n  if (id === 'about') return go(c, 'about');\\n310→  if (id === 'handbook') return go(c, 'handbook');\\n  if (id === 'controls') {\\n    go(c, 'settings');\\n    c.page = 1;\\n    return;\\n  }\\n  if (id === 'dev') return go(c, 'dev');\\n  if (id === 'play' && c.screen === 'board') return openBoard(c);\\n  if (id === 'postcards') {\\n    c.tab = c.tab === 0 ? 1 : 0;\\n320→    return;\\n  }\\n  if (id === 'start' && c.screen === 'brief') {\\n    c.screen = 'op';\\n    c.record = c.caseIndex === c.progress.cleared;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'scrub') {\\n    c.progress.seats = Math.max(1, c.claimed.filter(Boolean).length);\\n    c.screen = 'title';\\n330→    return;\\n  }\\n  if (id === 'next' && c.won) return afterWin(c);\\n  if (id === 'retry') return retryCase(c);\\n  if (id === 'phase') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'resume') {\\n    c.screen = 'op';\\n340→    return;\\n  }\\n  if (id === 'unlock') {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.progress.cleared = storyCases().length;\\n    return;\\n  }\\n  cycleSetting(c, id);\\n}\\n350→\\n/** Circle, or Escape on a menu. */\\nexport function cancel(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') {\\n    finishScene(c);\\n    return;\\n  }\\n  if (c.screen === 'op') {\\n    c.back = 'op';\\n360→    c.screen = 'pause';\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'pause') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  if (c.screen === 'credits') {\\n370→    c.screen = 'title';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.screen = c.back === c.screen ? 'title' : c.back;\\n  if (c.screen === 'pause' || c.screen === 'title') c.focus = 0;\\n}\\n\\n/** Any real input. Attract ends. The idle clock starts over. */\\nexport function noteInput(c: Campaign): void {\\n380→  c.idle = 0;\\n  if (c.screen === 'attract') leaveAttract(c);\\n}\\n\\n/** Milliseconds since the last input. Menus become the kiosk. A session never does. */\\nexport function tickFront(c: Campaign, dtMs: number, inSession: boolean): void {\\n  if (inSession) return;\\n  if (c.screen === 'attract') {\\n    c.clipMs -= dtMs;\\n    if (c.clipMs <= 0) {\\n390→      c.clip = (c.clip + 1) % ATTRACT.length;\\n      c.clipMs = ATTRACT[c.clip].ms;\\n      if (ATTRACT[c.clip].kind === 'story') c.box = 0;\\n    }\\n    return;\\n  }\\n  if (c.screen === 'story' && c.progress.autoText) {\\n    c.lineMs += dtMs;\\n    if (c.lineMs > 2500) {\\n      c.lineMs = 0;\\n400→      advanceStory(c);\\n    }\\n  }\\n  if (!MENUS.includes(c.screen)) return;\\n  c.idle += dtMs;\\n  if (c.idle >= 10000) enterAttract(c);\\n}\\n\\n/** The operation ended. Attract ignores the rank. A recorded win waits for the scene after it. */\\nexport function finishOp(c: Campaign, won: boolean, score: number, slips: number, fail: string): void {\\n410→  if (c.screen !== 'op') return;\\n  const def = caseById(c.caseId);\\n  c.won = won;\\n  c.fail = won ? '' : fail || 'Called off.';\\n  c.lastScore = score;\\n  if (won) {\\n    const rank = rankFor(score, def.par, slips, c.progress.difficulty);\\n    c.lastRank = rank;\\n    const letter = rank === '★' ? 'S' : (rank as Exclude<Rank, '★'>);\\n    c.postcard = def.patients[0]?.postcards[letter] ?? '';\\n420→    if (c.record) {\\n      c.progress.ranks[c.caseIndex] = rank;\\n      c.progress.scores[c.caseIndex] = score;\\n      c.progress.postcards[c.caseIndex] = c.postcard;\\n    }\\n  }\\n  c.screen = 'debrief';\\n  c.focus = 0;\\n}\\n\\n430→/** The run the scene should be showing. */\\nexport function desiredRun(c: Campaign): string {\\n  if (c.screen === 'op') return `op:${c.caseId}`;\\n  if (c.screen === 'attract') {\\n    const clip = ATTRACT[c.clip];\\n    if (clip.kind === 'op') return `op:${clip.id}`;\\n  }\\n  return 'title';\\n}\\n\\n440→/** True while the kiosk is inside an operation. */\\nexport function desiredAttract(c: Campaign): boolean {\\n  return c.screen === 'attract' && ATTRACT[c.clip].kind === 'op';\\n}\\n\\n/** The story box on screen, if this screen has one. */\\nexport function currentBox(c: Campaign): { who: string; text: string; drama: string; where: string } | null {\\n  const id = c.screen === 'attract' && ATTRACT[c.clip].kind === 'story' ? ATTRACT[c.clip].id : c.screen === 'story' ? c.storyId : '';\\n  if (!id) return null;\\n  const scene = sceneById(id);\\n450→  if (!scene) return null;\\n  const box = scene.boxes[Math.min(c.box, scene.boxes.length - 1)];\\n  return { who: box.who, text: box.text, drama: box.drama ?? '', where: scene.where };\\n}\\n\\n/** Handbook card on the open page. */\\nexport function handbookPage(c: Campaign): { title: string; body: string; index: number; count: number } {\\n  const cards = handbookCards();\\n  const index = ((c.page % cards.length) + cards.length) % cards.length;\\n  return { ...cards[index], index, count: cards.length };\\n460→}\\n\\nfunction go(c: Campaign, screen: Screen): void {\\n  c.back = c.screen === screen ? c.back : c.screen;\\n  c.screen = screen;\\n  c.focus = 0;\\n  c.page = 0;\\n}\\n\\nfunction startShift(c: Campaign): void {\\n470→  c.progress.cleared = 0;\\n  c.progress.ranks = [];\\n  c.progress.scores = [];\\n  c.progress.postcards = [];\\n  c.record = true;\\n  openCase(c, 0, 'before');\\n}\\n\\nfunction continueShift(c: Campaign): void {\\n  const index = Math.min(c.progress.cleared, storyCases().length - 1);\\n480→  const leg = c.progress.ranks[index] ? 'after' : 'before';\\n  c.record = true;\\n  openCase(c, index, leg);\\n}\\n\\nfunction openBoard(c: Campaign): void {\\n  const ids = boardIds(c.progress);\\n  const id = ids[c.board] ?? ids[0];\\n  const index = storyCases().findIndex((item) => item.id === id);\\n  const unlocked = c.progress.free || index <= c.progress.cleared;\\n490→  if (!unlocked || index < 0) return;\\n  c.record = index === c.progress.cleared;\\n  c.caseIndex = index;\\n  c.caseId = storyCases()[index].id;\\n  c.screen = 'brief';\\n  c.focus = 0;\\n}\\n\\nfunction openCase(c: Campaign, index: number, leg: 'before' | 'after'): void {\\n  const def = storyCases()[index];\\n500→  if (!def) {\\n    c.screen = 'credits';\\n    return;\\n  }\\n  c.caseIndex = index;\\n  c.caseId = def.id;\\n  c.leg = leg;\\n  c.storyId = leg === 'before' ? def.storyBefore : def.storyAfter;\\n  c.box = 0;\\n  c.lineMs = 0;\\n510→  c.screen = 'story';\\n}\\n\\nfunction advanceStory(c: Campaign): void {\\n  const scene = sceneById(c.storyId);\\n  if (!scene) return;\\n  if (c.box < scene.boxes.length - 1) {\\n    c.box += 1;\\n    return;\\n  }\\n520→  finishScene(c);\\n}\\n\\nfunction finishScene(c: Campaign): void {\\n  if (c.leg === 'before') {\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.progress.cleared = Math.max(c.progress.cleared, c.caseIndex + 1);\\n530→  if (c.progress.cleared >= storyCases().length) {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.screen = 'credits';\\n    c.page = 0;\\n    return;\\n  }\\n  openCase(c, c.progress.cleared, 'before');\\n}\\n\\n540→function afterWin(c: Campaign): void {\\n  c.leg = 'after';\\n  const def = storyCases()[c.caseIndex];\\n  c.storyId = def?.storyAfter ?? 'after-1';\\n  c.box = 0;\\n  c.screen = 'story';\\n}\\n\\nfunction retryCase(c: Campaign): void {\\n  c.screen = 'op';\\n550→  c.won = false;\\n}\\n\\nfunction enterAttract(c: Campaign): void {\\n  c.screen = 'attract';\\n  c.clip = 0;\\n  c.clipMs = ATTRACT[0].ms;\\n  c.box = 0;\\n  c.record = false;\\n}\\n560→\\nfunction leaveAttract(c: Campaign): void {\\n  c.screen = 'title';\\n  c.focus = 0;\\n  c.idle = 0;\\n  c.record = true;\\n}\\n\\nfunction cycleSetting(c: Campaign, id: string): void {\\n  const p = c.progress;\\n570→  const volume = (n: number) => [0, 10, 40, 70, 100][([0, 10, 40, 70, 100].indexOf(n) + 1) % 5] ?? 70;\\n  if (id === 'master') p.master = volume(p.master);\\n  if (id === 'music') p.music = volume(p.music);\\n  if (id === 'effects') p.effects = volume(p.effects);\\n  if (id === 'voice') p.voice = volume(p.voice);\\n  if (id === 'glyphs') p.glyphs = p.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n  if (id === 'difficulty') {\\n    const order: Difficulty[] = ['intern', 'resident', 'attending'];\\n    const next = order[(order.indexOf(p.difficulty) + 1) % 3];\\n    if (next === 'attending' && !p.attending && !p.free) return;\\n580→    p.difficulty = next;\\n  }\\n  if (id === 'simple') p.simple = !p.simple;\\n  if (id === 'autoText') p.autoText = !p.autoText;\\n  if (id === 'blood') p.blood = p.blood === 'red' ? 'teal' : p.blood === 'teal' ? 'off' : 'red';\\n  if (id === 'hud') c.hideHud = !c.hideHud;\\n}\\n\\n/** Claim a scrub seat. The keyboard claims the first. */\\nexport function claimSeat(c: Campaign, index: number): void {\\n590→  if (index < 0 || index > 3) return;\\n  c.claimed[index] = true;\\n  c.idle = 0;\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/labs/game/app/campaign.ts\",\"offset\":200,\"raw_output\":\"}\\n\\n/** Settings rows for the open page. */\\nfunction settingsItems(c: Campaign): Item[] {\\n  const p = c.progress;\\n  const pages = [\\n    [\\n      { id: 'master', label: `Master ${p.master}` },\\n      { id: 'music', label: `Music ${p.music}` },\\n      { id: 'effects', label: `Effects ${p.effects}` },\\n      { id: 'voice', label: `Voice ${p.voice}` },\\n    ],\\n    [\\n      { id: 'glyphs', label: `Glyphs ${p.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'}` },\\n      { id: 'back', label: 'Back' },\\n    ],\\n    [\\n      { id: 'difficulty', label: `Difficulty ${p.difficulty}` },\\n      { id: 'simple', label: `Simple Gift ${p.simple ? 'on' : 'off'}` },\\n      { id: 'autoText', label: `Auto text ${p.autoText ? 'on' : 'off'}` },\\n    ],\\n    [{ id: 'blood', label: `Blood ${p.blood}` }],\\n  ];\\n  return [...pages[c.page]!, { id: 'back', label: 'Back' }];\\n}\\n\\n/** Dev Mode rows for the open tab. */\\nfunction devItems(c: Campaign): Item[] {\\n  const tabs = ['Play', 'Balance', 'View', 'Author', 'Data'];\\n  if (c.devTab === 1) return [{ id: 'reset', label: 'Reset sliders' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 2) return [{ id: 'hud', label: c.hideHud ? 'Show HUD' : 'Hide HUD' }, { id: 'fly', label: 'Free camera' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 4) return [{ id: 'copy', label: 'Copy replay' }, { id: 'back', label: 'Back' }];\\n  if (c.devTab === 3) return [{ id: 'back', label: 'Back' }];\\n  return [\\n    { id: 'win', label: 'Win phase' },\\n    { id: 'fail', label: 'Fail phase' },\\n    { id: 'heal', label: 'Restore vitals' },\\n    { id: 'freezeVitals', label: 'Freeze vitals' },\\n    { id: 'freezeClock', label: 'Freeze clock' },\\n    { id: 'gift', label: 'Infinite Gift' },\\n    { id: 'oneHit', label: 'One-hit strains' },\\n    { id: 'spawn', label: 'Spawn a Lull' },\\n    { id: 'unlock', label: 'Unlock the board' },\\n    { id: 'auto', label: 'Autoplay' },\\n    { id: 'step', label: 'Frame step' },\\n    { id: 'slow', label: 'Quarter speed' },\\n    { id: 'fast', label: 'Four times' },\\n    { id: 'tab', label: `Tab ${tabs[c.devTab]}` },\\n    { id: 'back', label: 'Back' },\\n  ];\\n}\\n\\n/** Move the highlight. */\\nexport function move(c: Campaign, dir: number): void {\\n  const rows = items(c);\\n  if (!rows.length) return;\\n  c.focus = (c.focus + dir + rows.length) % rows.length;\\n  c.idle = 0;\\n}\\n\\n/** Browse a card, a page, or a dev tab. */\\nexport function browse(c: Campaign, dir: number): void {\\n  c.idle = 0;\\n  if (c.screen === 'board') {\\n    const ids = boardIds(c.progress);\\n    c.board = (c.board + dir + ids.length) % ids.length;\\n    return;\\n  }\\n  if (c.screen === 'settings') {\\n    c.page = (c.page + dir + 4) % 4;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'handbook') {\\n    const n = handbookCards().length;\\n    c.page = (c.page + dir + n) % n;\\n    return;\\n  }\\n  if (c.screen === 'about' || c.screen === 'credits') {\\n    c.page = Math.max(0, c.page + dir);\\n    return;\\n  }\\n  if (c.screen === 'dev') {\\n    c.devTab = (c.devTab + dir + 5) % 5;\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'story') c.box = Math.max(0, c.box + dir);\\n}\\n\\n/** Activate the highlighted row, or advance a story box. */\\nexport function accept(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') return advanceStory(c);\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  const row = items(c)[c.focus];\\n  if (!row) return;\\n  act(c, row.id);\\n}\\n\\n/** Activate a row by id. A click uses this. */\\nexport function act(c: Campaign, id: string): void {\\n  c.idle = 0;\\n  if (id === 'back') return cancel(c);\\n  if (id === 'new') return startShift(c);\\n  if (id === 'continue') return continueShift(c);\\n  if (id === 'board') return go(c, 'board');\\n  if (id === 'scrub') return go(c, 'scrub');\\n  if (id === 'settings') return go(c, 'settings');\\n  if (id === 'about') return go(c, 'about');\\n  if (id === 'handbook') return go(c, 'handbook');\\n  if (id === 'controls') {\\n    go(c, 'settings');\\n    c.page = 1;\\n    return;\\n  }\\n  if (id === 'dev') return go(c, 'dev');\\n  if (id === 'play' && c.screen === 'board') return openBoard(c);\\n  if (id === 'postcards') {\\n    c.tab = c.tab === 0 ? 1 : 0;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'brief') {\\n    c.screen = 'op';\\n    c.record = c.caseIndex === c.progress.cleared;\\n    return;\\n  }\\n  if (id === 'start' && c.screen === 'scrub') {\\n    c.progress.seats = Math.max(1, c.claimed.filter(Boolean).length);\\n    c.screen = 'title';\\n    return;\\n  }\\n  if (id === 'next' && c.won) return afterWin(c);\\n  if (id === 'retry') return retryCase(c);\\n  if (id === 'phase') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'resume') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (id === 'unlock') {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.progress.cleared = storyCases().length;\\n    return;\\n  }\\n  cycleSetting(c, id);\\n}\\n\\n/** Circle, or Escape on a menu. */\\nexport function cancel(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'story') {\\n    finishScene(c);\\n    return;\\n  }\\n  if (c.screen === 'op') {\\n    c.back = 'op';\\n    c.screen = 'pause';\\n    c.focus = 0;\\n    return;\\n  }\\n  if (c.screen === 'pause') {\\n    c.screen = 'op';\\n    return;\\n  }\\n  if (c.screen === 'attract') return leaveAttract(c);\\n  if (c.screen === 'credits') {\\n    c.screen = 'title';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.screen = c.back === c.screen ? 'title' : c.back;\\n  if (c.screen === 'pause' || c.screen === 'title') c.focus = 0;\\n}\\n\\n/** Any real input. Attract ends. The idle clock starts over. */\\nexport function noteInput(c: Campaign): void {\\n  c.idle = 0;\\n  if (c.screen === 'attract') leaveAttract(c);\\n}\\n\\n/** Milliseconds since the last input. Menus become the kiosk. A session never does. */\\nexport function tickFront(c: Campaign, dtMs: number, inSession: boolean): void {\\n  if (inSession) return;\\n  if (c.screen === 'attract') {\\n    c.clipMs -= dtMs;\\n    if (c.clipMs <= 0) {\\n      c.clip = (c.clip + 1) % ATTRACT.length;\\n      c.clipMs = ATTRACT[c.clip].ms;\\n      if (ATTRACT[c.clip].kind === 'story') c.box = 0;\\n    }\\n    return;\\n  }\\n  if (c.screen === 'story' && c.progress.autoText) {\\n    c.lineMs += dtMs;\\n    if (c.lineMs > 2500) {\\n      c.lineMs = 0;\\n      advanceStory(c);\\n    }\\n  }\\n  if (!MENUS.includes(c.screen)) return;\\n  c.idle += dtMs;\\n  if (c.idle >= 10000) enterAttract(c);\\n}\\n\\n/** The operation ended. Attract ignores the rank. A recorded win waits for the scene after it. */\\nexport function finishOp(c: Campaign, won: boolean, score: number, slips: number, fail: string): void {\\n  if (c.screen !== 'op') return;\\n  const def = caseById(c.caseId);\\n  c.won = won;\\n  c.fail = won ? '' : fail || 'Called off.';\\n  c.lastScore = score;\\n  if (won) {\\n    const rank = rankFor(score, def.par, slips, c.progress.difficulty);\\n    c.lastRank = rank;\\n    const letter = rank === '★' ? 'S' : (rank as Exclude<Rank, '★'>);\\n    c.postcard = def.patients[0]?.postcards[letter] ?? '';\\n    if (c.record) {\\n      c.progress.ranks[c.caseIndex] = rank;\\n      c.progress.scores[c.caseIndex] = score;\\n      c.progress.postcards[c.caseIndex] = c.postcard;\\n    }\\n  }\\n  c.screen = 'debrief';\\n  c.focus = 0;\\n}\\n\\n/** The run the scene should be showing. */\\nexport function desiredRun(c: Campaign): string {\\n  if (c.screen === 'op') return `op:${c.caseId}`;\\n  if (c.screen === 'attract') {\\n    const clip = ATTRACT[c.clip];\\n    if (clip.kind === 'op') return `op:${clip.id}`;\\n  }\\n  return 'title';\\n}\\n\\n/** True while the kiosk is inside an operation. */\\nexport function desiredAttract(c: Campaign): boolean {\\n  return c.screen === 'attract' && ATTRACT[c.clip].kind === 'op';\\n}\\n\\n/** The story box on screen, if this screen has one. */\\nexport function currentBox(c: Campaign): { who: string; text: string; drama: string; where: string } | null {\\n  const id = c.screen === 'attract' && ATTRACT[c.clip].kind === 'story' ? ATTRACT[c.clip].id : c.screen === 'story' ? c.storyId : '';\\n  if (!id) return null;\\n  const scene = sceneById(id);\\n  if (!scene) return null;\\n  const box = scene.boxes[Math.min(c.box, scene.boxes.length - 1)];\\n  return { who: box.who, text: box.text, drama: box.drama ?? '', where: scene.where };\\n}\\n\\n/** Handbook card on the open page. */\\nexport function handbookPage(c: Campaign): { title: string; body: string; index: number; count: number } {\\n  const cards = handbookCards();\\n  const index = ((c.page % cards.length) + cards.length) % cards.length;\\n  return { ...cards[index], index, count: cards.length };\\n}\\n\\nfunction go(c: Campaign, screen: Screen): void {\\n  c.back = c.screen === screen ? c.back : c.screen;\\n  c.screen = screen;\\n  c.focus = 0;\\n  c.page = 0;\\n}\\n\\nfunction startShift(c: Campaign): void {\\n  c.progress.cleared = 0;\\n  c.progress.ranks = [];\\n  c.progress.scores = [];\\n  c.progress.postcards = [];\\n  c.record = true;\\n  openCase(c, 0, 'before');\\n}\\n\\nfunction continueShift(c: Campaign): void {\\n  const index = Math.min(c.progress.cleared, storyCases().length - 1);\\n  const leg = c.progress.ranks[index] ? 'after' : 'before';\\n  c.record = true;\\n  openCase(c, index, leg);\\n}\\n\\nfunction openBoard(c: Campaign): void {\\n  const ids = boardIds(c.progress);\\n  const id = ids[c.board] ?? ids[0];\\n  const index = storyCases().findIndex((item) => item.id === id);\\n  const unlocked = c.progress.free || index <= c.progress.cleared;\\n  if (!unlocked || index < 0) return;\\n  c.record = index === c.progress.cleared;\\n  c.caseIndex = index;\\n  c.caseId = storyCases()[index].id;\\n  c.screen = 'brief';\\n  c.focus = 0;\\n}\\n\\nfunction openCase(c: Campaign, index: number, leg: 'before' | 'after'): void {\\n  const def = storyCases()[index];\\n  if (!def) {\\n    c.screen = 'credits';\\n    return;\\n  }\\n  c.caseIndex = index;\\n  c.caseId = def.id;\\n  c.leg = leg;\\n  c.storyId = leg === 'before' ? def.storyBefore : def.storyAfter;\\n  c.box = 0;\\n  c.lineMs = 0;\\n  c.screen = 'story';\\n}\\n\\nfunction advanceStory(c: Campaign): void {\\n  const scene = sceneById(c.storyId);\\n  if (!scene) return;\\n  if (c.box < scene.boxes.length - 1) {\\n    c.box += 1;\\n    return;\\n  }\\n  finishScene(c);\\n}\\n\\nfunction finishScene(c: Campaign): void {\\n  if (c.leg === 'before') {\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  c.progress.cleared = Math.max(c.progress.cleared, c.caseIndex + 1);\\n  if (c.progress.cleared >= storyCases().length) {\\n    c.progress.free = true;\\n    c.progress.attending = true;\\n    c.screen = 'credits';\\n    c.page = 0;\\n    return;\\n  }\\n  openCase(c, c.progress.cleared, 'before');\\n}\\n\\nfunction afterWin(c: Campaign): void {\\n  c.leg = 'after';\\n  const def = storyCases()[c.caseIndex];\\n  c.storyId = def?.storyAfter ?? 'after-1';\\n  c.box = 0;\\n  c.screen = 'story';\\n}\\n\\nfunction retryCase(c: Campaign): void {\\n  c.screen = 'op';\\n  c.won = false;\\n}\\n\\nfunction enterAttract(c: Campaign): void {\\n  c.screen = 'attract';\\n  c.clip = 0;\\n  c.clipMs = ATTRACT[0].ms;\\n  c.box = 0;\\n  c.record = false;\\n}\\n\\nfunction leaveAttract(c: Campaign): void {\\n  c.screen = 'title';\\n  c.focus = 0;\\n  c.idle = 0;\\n  c.record = true;\\n}\\n\\nfunction cycleSetting(c: Campaign, id: string): void {\\n  const p = c.progress;\\n  const volume = (n: number) => [0, 10, 40, 70, 100][([0, 10, 40, 70, 100].indexOf(n) + 1) % 5] ?? 70;\\n  if (id === 'master') p.master = volume(p.master);\\n  if (id === 'music') p.music = volume(p.music);\\n  if (id === 'effects') p.effects = volume(p.effects);\\n  if (id === 'voice') p.voice = volume(p.voice);\\n  if (id === 'glyphs') p.glyphs = p.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n  if (id === 'difficulty') {\\n    const order: Difficulty[] = ['intern', 'resident', 'attending'];\\n    const next = order[(order.indexOf(p.difficulty) + 1) % 3];\\n    if (next === 'attending' && !p.attending && !p.free) return;\\n    p.difficulty = next;\\n  }\\n  if (id === 'simple') p.simple = !p.simple;\\n  if (id === 'autoText') p.autoText = !p.autoText;\\n  if (id === 'blood') p.blood = p.blood === 'red' ? 'teal' : p.blood === 'teal' ? 'off' : 'red';\\n  if (id === 'hud') c.hideHud = !c.hideHud;\\n}\\n\\n/** Claim a scrub seat. The keyboard claims the first. */\\nexport function claimSeat(c: Campaign, index: number): void {\\n  if (index < 0 || index > 3) return;\\n  c.claimed[index] = true;\\n  c.idle = 0;\\n}\\n\",\"total_lines\":593}}","is_error":false},{"type":"tool_result","tool_use_id":"call-3c9accbc-e4df-4582-a491-6cee511e5dfe-12","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,55,51,49,95,95,120,53,57,99,49,100,51,47,119,111,114,107,34,62,10,70,111,117,110,100,32,55,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115