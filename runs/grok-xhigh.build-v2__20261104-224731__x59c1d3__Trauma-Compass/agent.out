cards = handbookCards();\\n  const index = ((c.page % cards.length) + cards.length) % cards.length;\\n  return { ...cards[index], index, count: cards.length };\\n}\\n\\nfunction go(c: Campaign, screen: Screen): void {\\n  c.back = c.screen === screen ? c.back : c.screen;\\n  c.screen = screen;\\n  c.focus = 0;\\n  c.page = 0;\\n}\\n\\nfunction startShift(c: Campaign): void {\\n  c.progress.cleared = 0;\\n  c.progress.ranks = [];\\n  c.progress.scores = [];\\n  c.progress.postcards = [];\\n  c.record = true;\\n  openCase(c, 0, 'before');\\n}\\n\\nfunction continueShift(c: Campaign): void {\\n  const index = Math.min(c.progress.cleared, storyCases().length - 1);\\n  const leg = c.progress.ranks[index] ? 'after' : 'before';\\n  c.record = true;\\n  openCase(c, index, leg);\\n}\\n\\nfunction openBoard(c: Campaign): void {\\n  const ids = boardIds(c.progress);\\n  const id = ids[c.board] ?? ids[0];\\n  if (id === 'case:gala-shift') {\\n    c.caseId = id;\\n    c.caseIndex = -1;\\n    c.record = false;\\n    c.screen = 'brief';\\n    c.focus = 0;\\n    return;\\n  }\\n  const index = storyCases().findIndex((item) => item.id === id);\\n  const unlocked = c.progress.free || index <= c.progress.cleared;\\n\",\"total_lines\":589}}","is_error":false},{"type":"tool_result","tool_use_id":"call-0c63a408-979f-4232-93b1-e8122409b764-31","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,55,51,49,95,95,120,53,57,99,49,100,51,47,119,111,114,107,34,62,10,70,111,117,110,100,32,97,116,32,108,101,97,115,116,32,51,48,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,