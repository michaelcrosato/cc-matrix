1,114,39,32,63,32,109,97,115,116,101,114,32,58,32,40,98,117,115,101,115,46,103,101,116,40,98,117,115,41,32,97,115,32,71,97,105,110,78,111,100,101,41,41,59,10,49,49,51,58,32,32,99,111,110,115,116,32,97,112,112,108,121,32,61,32,40,98,117,115,58,32,65,117,100,105,111,66,117,115,32,124,32,39,109,97,115,116,101,114,39,41,32,61,62,32,123,10,49,49,52,58,32,32,32,32,99,111,110,115,116,32,118,97,108,117,101,32,61,32,98,117,115,32,61,61,61,32,39,109,97,115,116,101,114,39,32,38,38,32,109,117,116,101,100,32,63,32,48,32,58,32,118,111,108,117,109,101,115,91,98,117,115,93,59,10,49,52,53,58,32,32,32,32,32,32,97,112,112,108,121,40,39,109,97,115,116,101,114,39,41,59,10,49,55,51,58,32,32,32,32,32,32,99,111,110,118,111,108,118,101,114,46,99,111,110,110,101,99,116,40,109,97,115,116,101,114,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":20,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224731__x59c1d3/work/Trauma-Compass-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-224731/engine/audio/runtime/mixer.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file The mixer (PLAN.md WP 9.3, I-23): four buses, `effects`, `music`, `ui` and `ambience`, into a master gain,\"},{\"line_number\":6,\"content\":\" * Each bus is a volume gain, then a duck gain, into the master gain (`volume('master')` and `mute`), then the\"},{\"line_number\":7,\"content\":\" * destination. The `effects` and `ambience` buses also feed the room's reverb (engine/audio/runtime/reverb.ts): a send\"},{\"line_number\":8,\"content\":\" * at the room's `wet` level into a `ConvolverNode`, into the master. `ui` and `music` stay dry.\"},{\"line_number\":14,\"content\":\" * Invariants: volumes are clamped to [0, 1]; `BUS_VOLUMES` are the starting levels (the source's: master 0.7, music\"},{\"line_number\":20,\"content\":\" * master, sfx and music buses and their levels, the 0.35 duck; `ui`, `ambience`, timed ducks and the reverb added.\"},{\"line_number\":38,\"content\":\"/** The starting volumes, the master's included. */\"},{\"line_number\":39,\"content\":\"export const BUS_VOLUMES: Readonly<Record<AudioBus | 'master', number>> = Object.freeze({\"},{\"line_number\":40,\"content\":\"  master: 0.7,\"},{\"line_number\":63,\"content\":\"  volumes: Record<AudioBus | 'master', number>;\"},{\"line_number\":75,\"content\":\"  /** The volume of `bus` (or the master), set first when `value` is given (clamped to [0, 1]). */\"},{\"line_number\":76,\"content\":\"  volume(bus: AudioBus | 'master', value?: number): number;\"},{\"line_number\":86,\"content\":\"/** Makes the mixer's graph on `context`, into its destination. */\"},{\"line_number\":95,\"content\":\"  const master = gain(volumes.master, context.destination);\"},{\"line_number\":100,\"content\":\"    const duck = gain(1, master);\"},{\"line_number\":112,\"content\":\"  const level = (bus: AudioBus | 'master') => (bus === 'master' ? master : (buses.get(bus) as GainNode));\"},{\"line_number\":113,\"content\":\"  const apply = (bus: AudioBus | 'master') => {\"},{\"line_number\":114,\"content\":\"    const value = bus === 'master' && muted ? 0 : volumes[bus];\"},{\"line_number\":145,\"content\":\"      apply('master');\"},{\"line_number\":173,\"content\":\"      convolver.connect(master);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa3f-84ea-7700-ba58-234d6f85e151","uuid":"3ab05378-6535-436c-8564-96edeef5f92f"}
