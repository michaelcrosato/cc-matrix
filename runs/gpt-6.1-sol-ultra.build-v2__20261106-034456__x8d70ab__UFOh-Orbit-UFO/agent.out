{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace('app.audio.unlock();\\\\n\\\\t\\\\tapp.applyAudio();','if (\"'!app.audio.unlocked) app.audio.unlock();'\"\\\\n\\\\t\\\\tapp.applyAudio();');open(p,'w').write(s)\np='src/controls.js';s=open(p).read().replace('this.game = game;','this.game = game;\\\\n this.onUnlock=onUnlock;',1).replace('if (meaningful) {\\\\n\\\\t\\\\t\\\\tthis.activity();','if (meaningful) {\\\\n this.onUnlock();\\\\n\\\\t\\\\t\\\\tthis.activity();');open(p,'w').write(s)\nPY\nbiome format --write src/main.js src/controls.js > artifacts/biome-final.log\nnode tools/build.mjs\nrg -n 'padActivity|onUnlock' src/controls.js src/main.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
