d .esh-btns{display:flex;flex-direction:column}.esh .esh-pan{padding:17px!important}.esh .esh-m{font-size:14px!important}#controls-hint{display:none}}\nEOF\ncat > tools/build.mjs <<'\"'EOF'\nimport {build} from 'esbuild';\nimport {readFile,writeFile,mkdir} from 'node:fs/promises';\nimport path from 'node:path';\nconst dir=path.resolve(import.meta.dirname,'..');\nconst id=JSON.parse(await readFile(path.join(dir,'identity.json'),'utf8'));\nconst out=await build({entryPoints:[path.join(dir,'src/main.js')],bundle:true,write:false,format:'esm',target:'es2022',legalComments:'inline',minify:false});\nconst engine=await readFile(path.join(dir,'vendor/engine/my-3d2dge.js'),'utf8');\nconst hub=await readFile(path.join(dir,'vendor/hub/session.js'),'utf8');\nconst css=await readFile(path.join(dir,'style.css'),'utf8');\nconst license=await readFile(path.join(dir,'vendor/engine/LICENSE'),'utf8');\nconst esc=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst html=\"'`<!doctype html>'\"\\\\n<html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\">\\\\n<script>\"'${hub}</script>'\"\\\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\\\"><title>\"'${id.title}</title>'\"\\\\n<meta name=\\\"description\\\" content=\\\"One shot. No shield. Your move. A complete original orbital arcade shooter inspired by UFO\"'! (1981).\"><meta name=\"theme-color\" content=\"#071018\">'\"\\\\n<meta name=\\\"hub:type\\\" content=\\\"Game\\\"><meta name=\\\"hub:players\\\" content=\\\"1-2\\\"><meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-2\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\"><meta name=\\\"hub:session-minutes\\\" content=\\\"12\\\"><meta name=\\\"hub:session-goal\\\" content=\\\"Clear four sectors and defeat the three-phase command craft as a team\\\"><meta name=\\\"hub:session-howto\\\" content=\\\"Left stick/WASD move; right stick/mouse aim; R2/Space/click fire; Options/Esc menu. Fire spends shield; ready shield rams and rescues.\\\">\\\\n<style>\"'${css}</style></head><body><canvas id=\"screen\" aria-label=\"UFOh Orbit orbital combat arena\"></canvas><div id=\"controls-hint\" hidden></div>'\"\\\\n<\"'!-- Engine license'\"\\\\n\"'${license}'\"\\\\n-->\\\\n<script>\"'${esc(engine)}</script>'\"\\\\n<script type=\\\"module\\\">\"'${esc(out.outputFiles[0].text)}</script>'\"\\\\n</body></html>\"'`;\nawait mkdir(path.join(dir,'\"'build'),{recursive:true});\nawait writeFile(path.join(dir,'build/game.html'),html);\nawait writeFile(path.join(dir,'index.html'),html);\nawait writeFile(path.join(dir,'..',id.slug+'.html'),html);\nif(process.argv.includes('--verbose'))console.log(id.slug+'.html');\nEOF\nnode tools/build.mjs\"","aggregated_output":"","exit_code":0,"status":"completed"}}
