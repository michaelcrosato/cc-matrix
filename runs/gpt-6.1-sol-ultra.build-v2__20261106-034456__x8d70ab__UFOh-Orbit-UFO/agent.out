{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"cat > tests/foundation.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport {readFile} from 'node:fs/promises';\nimport vm from 'node:vm';\nimport {createWorld,stepWorld,snapshotWorld,commandWorld,autopilot} from '../src/simulation.js';\nimport {Records} from '../src/storage.js';\nexport async function runFoundationTests(){let passed=0;const failures=[];const test=async(name,fn)=>{try{await fn();passed++;}catch(e){failures.push(name+': '+e.message);}};\n const html=await readFile(new URL('../build/game.html',import.meta.url),'utf8');\n await test('Exact unchanged Hub client is first script immediately after charset',async()=>{const hub=await readFile(new URL('../vendor/hub/session.js',import.meta.url),'utf8');assert.ok(html.startsWith('<\"'!doctype html>'\"'));assert.ok(html.includes('<meta charset=\\\"utf-8\\\">\\\\n<script>'+hub+'</script>'));assert.equal(html.indexOf('<script>'),html.indexOf('<script>'+hub));});\n await test('Package is standalone without local requests',()=>{assert.equal(/<script[\"'^>]+src=/.test(html),false);assert.equal(/<link[''^>]+href=/.test(html),false);assert.equal(/'\"\\\\bfrom\\\\s+[\\\"']\\\\.\\\\.?\\\\//.test(html),false);assert.ok(html.includes('hub:session-mode'));assert.ok(html.includes('shared-world'));});\n await test('Delivery HTML matches tested build exactly',async()=>{const id=JSON.parse(await readFile(new URL('../identity.json',import.meta.url),'utf8'));assert.equal(await readFile(new URL('../../'+id.slug+'.html',import.meta.url),'utf8'),html);});\n await test('All required About and feedback sections are bundled',()=>{for(const s of ['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback','added on import'])assert.ok(html.includes(s),s);});\n await test('Native engine license retained',async()=>{const lic=await readFile(new URL('../vendor/engine/LICENSE',import.meta.url),'utf8');assert.ok(html.includes(lic));});\n const memory={value:null,getItem(){return this.value;},setItem(k,v){this.value=v;}};\n await test('Records round trip mode-specific six-letter names',()=>{const r=new Records(memory);r.add('mission','ORBITAL',120);r.add('score-attack','TEAM42',510);const reload=new Records(memory);assert.equal(reload.best('mission'),120);assert.equal(reload.best('score'),510);assert.equal(reload.data.mission[0].name,'ORBITA');});\n await test('Dev and attract runs cannot write score records',()=>{const r=new Records(memory);const old=memory.value;r.add('mission','CHEAT',9999,{debug:true});r.add('mission','DEMO',9999,{attract:true});assert.equal(memory.value,old);});\n await test('Corrupt or denied storage keeps records playable',()=>{const a=new Records({getItem(){return'{bad json';},setItem(){throw new Error('denied');}});assert.equal(a.best('mission'),0);assert.doesNotThrow(()=>a.add('mission','PILOT',12));assert.equal(a.best('mission'),12);assert.equal(a.available,false);});\n await test('Unrecognized storage versions are ignored',()=>{const r=new Records({getItem(){return JSON.stringify({v:99,mission:[{name:'ALIEN',score:999}]});}});assert.equal(r.best('mission'),0);});\n await test('Native headless renderer validates every actor and animation without changing simulation',async()=>{if(\"'!globalThis.My3D2dge)vm.runInThisContext(await readFile(new URL('\"'../vendor/engine/my-3d2dge.js',import.meta.url),'utf8'));const {Presentation}=await import('../src/presentation.js');const E=globalThis.My3D2dge;const game=new E.Game({headless:true,draw:true,res:[960,540],view:'overhead',menu:false});const p=new Presentation(game);const w=createWorld({players:2});commandWorld(w,'phase',{value:3});commandWorld(w,'spawn',{type:'drifter',count:9,formation:'cluster'});commandWorld(w,'spawn',{type:'hunter',x:220});commandWorld(w,'spawn',{type:'gunship',x:70,y:120});let time=0;game.start({update(dt){time+=dt;p.update(dt,w);},draw(r){p.world(r,w);}});for(let i=0;i<30;i++){stepWorld(w,[autopilot(w),autopilot(w,1)],1/120);game.advance(1/120);}const before=JSON.stringify(snapshotWorld(w));for(let i=0;i<40;i++)game.advance(1/120);assert.equal(JSON.stringify(snapshotWorld(w)),before);assert.deepEqual(game.errors,[]);assert.ok(time>0);game.dispose();});\n return{passed,failed:failures.length,failures};}\nEOF\ncat > tools/test.mjs <<'EOF'\nimport {spawnSync} from 'node:child_process';\nimport {writeFile,mkdir} from 'node:fs/promises';\nimport {runSimulationTests} from '../tests/simulation.mjs';\nimport {runHubTests} from '../tests/hub.mjs';\nimport {runFoundationTests} from '../tests/foundation.mjs';\nconst reports={};let passed=0,failed=0;const failures=[];\nfunction collect(name,r){reports[name]=r;passed+=r.passed||0;failed+=r.failed||0;for(const f of r.failures||[])failures.push(name+': '+f);}\nfor(const [name,fn] of [['simulation',runSimulationTests],['hub-unit',runHubTests],['foundation',runFoundationTests]]){try{collect(name,await fn());}catch(e){collect(name,{passed:0,failed:1,failures:[e.stack||e.message]});}}\nconst python='/home/micha/.local/share/pipx/venvs/playwright/bin/python';\nfor(const [name,file] of [['audio','tests/audio-browser.py'],['ui','tests/ui-browser.py'],['hub-browser','tests/hub-browser.py']]){const r=spawnSync(python,[file],{cwd:new URL('..',import.meta.url),encoding:'utf8',maxBuffer:15*1024*1024,timeout:240000});try{const lines=r.stdout.trim().split('\\\\n');const report=JSON.parse(lines.at(-1));collect(name,report);if(r.status\"'!==0&&!report.failed)throw Error(r.stderr||'\"'Test process failed');}catch(e){collect(name,{passed:0,failed:1,failures:[(r.stderr||r.stdout||e.message).slice(-6000)]});}}\nawait mkdir(new URL('../artifacts',import.meta.url),{recursive:true});await writeFile(new URL('../artifacts/test-report.json',import.meta.url),JSON.stringify({passed,failed,failures,reports},null,2));\nfor(const f of failures)console.error(f);console.log(\"'`${passed} passed, ${failed} failed`);if(failed)process.exitCode=1;\nEOF\nnode --input-type=module - <<'\"'JS'\nimport {runFoundationTests} from './tests/foundation.mjs';\nconst r=await runFoundationTests();for(const f of r.failures)console.error(f);console.log(r.passed+' passed, '+r.failed+' failed');\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
