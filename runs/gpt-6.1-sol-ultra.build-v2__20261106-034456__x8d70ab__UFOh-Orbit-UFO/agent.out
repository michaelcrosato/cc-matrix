{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"rg -n 'pause\\\\(|stop\\\\(|startSong' src/audio.js | tail -16 && sed -n '215,255p' src/audio.js && sed -n '400,452p' src/audio.js && cat tests/simulation.mjs | tail -25 && cat tests/audio-browser.py | tail -16 && cat tests/hub-browser.py | tail -22\"","aggregated_output":"182:\t\tif (!this.paused) this.startSong();\n210:\t\t\tif (this.unlocked && !this.paused) this.startSong();\n214:\tstartSong() {\n299:\t\t\tsrc.stop(at + dur + 0.005);\n314:\tpause(on = true) {\n321:\t\t\tfor (const x of this.handles) x.handle.stop(0);\n323:\t\t} else this.startSong();\n329:\t\t\t\tsrc.stop();\n335:\tstop() {\n339:\t\tfor (const x of this.handles) x.handle.stop(0);\n\t\tif (!this.unlocked || this.paused || this.stopped) return;\n\t\tthis.native.music(MUSIC[this.scene], { sync: true, fade: 0.25 });\n\t}\n\n\tcue(name, opts = {}) {\n\t\tname = ALIASES[name] || name;\n\t\tif (!CUES[name] || !this.unlocked || this.paused || this.stopped)\n\t\t\treturn false;\n\t\tconst gap = name === \"chain\" ? 0.075 : name === \"drifter\" ? 0.035 : 0.025;\n\t\tif (this.elapsed - (this.lastCue.get(name) ?? -100) < gap) return false;\n\t\tthis.lastCue.set(name, this.elapsed);\n\t\tconst pan = Number.isFinite(opts.x)\n\t\t\t? Math.max(-0.7, Math.min(0.7, (opts.x / 960 - 0.5) * 1.4))\n\t\t\t: 0;\n\t\tconst depth = Math.max(1, Math.min(8, opts.depth || 1));\n\t\tconst pitch = name === \"chain\" ? 2 ** ((depth - 1) / 12) : 1;\n\t\tconst handle = this.native.sfx(`orbit:${name}`, { pan, pitch, vary: 0 });\n\t\tthis.handles.push({ handle, until: this.elapsed + 1.4 });\n\t\tthis.played++;\n\t\treturn true;\n\t}\n\n\thandle(events = []) {\n\t\tfor (const event of events) {\n\t\t\tif (!Number.isFinite(event.id) || event.id <= this.lastEvent) continue;\n\t\t\tthis.lastEvent = event.id;\n\t\t\tlet type = ALIASES[event.type] || event.type;\n\t\t\tif (type === \"kill\" || type === \"destroy\")\n\t\t\t\ttype = event.enemyType || event.enemy || \"drifter\";\n\t\t\tif (type === \"boss\") type = \"gunship\";\n\t\t\tthis.cue(type, event);\n\t\t\tif (type === \"shot\" || type === \"shield\")\n\t\t\t\tthis.rechargeAt = this.elapsed + 0.65;\n\t\t\tif (type === \"ready\" || type === \"defeat\") this.rechargeAt = null;\n\t\t\tif (event.type === \"launch\") this.say(\"CONFIDENCE AT MAXIMUM!\", 0);\n\t\t\tif (type === \"rescue\") this.say(\"BACK IN ORBIT!\", 2);\n\t\t\tif (type === \"phase\") this.say(\"COMMAND SIGNAL!\", 3);\n\t\t\tif (type === \"victory\") this.say(\"SPACE IS OURS!\", 1);\n\t\t}\n\t}\n\n\t\treturn seed / 4294967296;\n\t};\n\ta._noise = c.createBuffer(1, 44100, 44100);\n\tconst noise = a._noise.getChannelData(0);\n\tfor (let i = 0; i < noise.length; i++) noise[i] = a._rnd() * 2 - 1;\n\tconst voices = Array.isArray(CUES[name]) ? CUES[name] : [CUES[name]];\n\tfor (const voice of voices) a._voice(voice, bus, 0.01, 1, false);\n\tconst buffer = await c.startRendering(),\n\t\tdata = buffer.getChannelData(0);\n\tlet sum = 0,\n\t\tpeak = 0,\n\t\tfinite = true,\n\t\tzeroCrossings = 0;\n\tfor (let i = 0; i < data.length; i++) {\n\t\tconst v = data[i];\n\t\tfinite &&= Number.isFinite(v);\n\t\tsum += v * v;\n\t\tpeak = Math.max(peak, Math.abs(v));\n\t\tif (i && v * data[i - 1] < 0) zeroCrossings++;\n\t}\n\treturn {\n\t\tavailable: true,\n\t\tname,\n\t\tfinite,\n\t\tpeak,\n\t\trms: Math.sqrt(sum / data.length),\n\t\tzeroCrossings,\n\t\tsamples: data.length,\n\t};\n}\n test('Co-op ready ring rescues a wreck and spends rescuer shield',()=>{const w=fixture(2),a=w.players[0],b=w.players[1];a.x=450;b.x=480;b.down=true;b.hull=0;stepWorld(w,[],DT);assert.equal(b.down,false);assert.equal(b.hull,1);assert.ok(a.shield>0);assert.ok(b.invuln>0);assert.equal(w.stats.rescues,1);});\n test('Exposed pilot cannot rescue',()=>{const w=fixture(2),a=w.players[0],b=w.players[1];a.shield=1;b.down=true;b.hull=0;stepWorld(w,[],DT);assert.equal(b.down,true);assert.equal(w.stats.rescues,0);});\n test('One down pilot does not end co-op',()=>{const w=fixture(2);w.players[1].down=true;w.players[1].hull=0;w.players[1].x=100;advance(w,2);assert.equal(w.status,'running');});\n test('Both down pilots end co-op',()=>{const w=fixture(2);for(const p of w.players){p.down=true;p.hull=0;}advance(w,1.2);assert.equal(w.status,'defeat');});\n test('Disconnected pilot is inactive and cannot shoot',()=>{const w=fixture(2);commandWorld(w,'disconnect',{index:1});advance(w,.5,[{}, {fire:true,mx:1}]);assert.equal(w.players[1].active,false);assert.equal(w.players[1].shots,0);assert.equal(w.status,'running');});\n test('Dev balance values are clamped to sensible ranges',()=>{const w=fixture();commandWorld(w,'balance',{moveSpeed:999999,shieldRecharge:-50});assert.equal(w.balance.moveSpeed,380);assert.equal(w.balance.shieldRecharge,.5);assert.equal(w.debug,true);commandWorld(w,'resetBalance');assert.deepEqual(w.balance,DEFAULT_BALANCE);});\n test('Dev boss health changes clamp running component health',()=>{const w=fixture();commandWorld(w,'phase',{value:2});commandWorld(w,'balance',{bossHealth:18});assert.equal(w.boss.phase,2);assert.ok(w.boss.components.every(c=>c.maxHp===2&&c.hp<=2));});\n test('Encounter restart resets actors but retains debug status',()=>{const w=fixture();spawn(w,'hunter',100,100);commandWorld(w,'restart');assert.equal(w.enemies.length,0);assert.equal(w.players[0].hull,3);assert.equal(w.debug,true);assert.equal(w.waveStarted,false);});\n test('Seed reset reproduces authored random motion',()=>{const a=fixture(),b=fixture();commandWorld(a,'resetSeed',{value:42});commandWorld(b,'resetSeed',{value:42});spawn(a,'drifter',300,200);spawn(b,'drifter',300,200);assert.deepEqual(a.enemies,b.enemies);});\n test('Snapshot is complete render data without functions or content payload',()=>{const w=fixture();spawn(w,'hunter',200,150);const s=snapshotWorld(w);assert.equal(s.players.length,1);assert.equal(s.enemies.length,1);assert.equal(s.enemies[0].type,'hunter');assert.ok(s.arena);assert.equal(s.content,undefined);assert.equal(s._rng,undefined);assert.doesNotThrow(()=>JSON.stringify(s));});\n test('Attract uses separate canonical balance and never mutates real run',()=>{const real=fixture(),demo=createWorld({attract:true});commandWorld(real,'balance',{moveSpeed:360});assert.equal(demo.balance.moveSpeed,DEFAULT_BALANCE.moveSpeed);assert.equal(demo.attract,true);assert.equal(demo.invulnerable,true);advance(demo,8,w=>[autopilot(w)]);assert.equal(real.time,0);});\n test('Boss closed emitters reject cannon damage',()=>{const w=fixture();commandWorld(w,'phase',{value:1});const b=w.boss;stepWorld(w,[],DT);const c=b.components[1],hp=c.hp;shot(w,c.x-40,c.y,6000,0);stepWorld(w,[],DT);assert.equal(c.hp,hp);});\n test('Boss open emitters accept real cannon collision',()=>{const w=fixture();commandWorld(w,'phase',{value:1});advance(w,2);const b=w.boss,c=b.components[1],hp=c.hp;shot(w,c.x-45,c.y,6000,0);stepWorld(w,[],DT);assert.ok(c.hp<hp);});\n test('Boss body ram never deletes command craft',()=>{const w=fixture();commandWorld(w,'phase',{value:1});advance(w,2);const b=w.boss,p=w.players[0];p.x=b.x;p.y=b.y+b.r;p.invuln=0;p.shield=0;stepWorld(w,[],DT);assert.ok(w.boss?.alive);assert.ok(p.shield>0);assert.equal(w.stats.rams,1);});\n test('All projectile actors clean up outside lifetime/bounds',()=>{const w=fixture();shot(w,100,100,-1000,0);shot(w,800,300,1000,0,true,-1);advance(w,6);assert.equal(w.bullets.length,0);});\n test('Defeat and replay create a clean real run',()=>{const a=fixture();a.players[0].down=true;advance(a,1.3);const b=createWorld({seed:a.seed});assert.equal(a.status,'defeat');assert.equal(b.status,'running');assert.equal(b.score,0);assert.equal(b.players[0].hull,3);assert.equal(b.debug,false);});\n let missionSummary;\n test('Legal input completes whole mission with every combat mechanic',()=>{const w=createWorld({seed:7});advance(w,700,w=>[autopilot(w)]);assert.equal(w.status,'victory');assert.equal(w.debug,false);assert.equal(w.invulnerable,false);assert.ok(w.stats.shots>50);assert.ok(w.stats.rams>0);assert.ok(w.stats.fusions>0);assert.ok(w.stats.chainKills>20);assert.ok(w.stats.gunships>5);assert.equal(w.stats.bossPhases,3);assert.equal(w.history['boss-defeated'],1);assert.equal(w.history.extraction,1);assert.equal(w.history.victory,1);assert.equal(w.stats.sectorTimes.length,3);missionSummary={seconds:w.time,score:w.score,stats:w.stats};});\n test('Seed replay gives identical gameplay state',()=>{const states=[];for(let run=0;run<2;run++){const w=createWorld({seed:42});advance(w,70,w=>[autopilot(w)]);states.push(snapshotWorld(w));}assert.deepEqual(states[0],states[1]);});\n test('Additional mission seed remains legally winnable',()=>{const w=createWorld({seed:2026});advance(w,700,w=>[autopilot(w)]);assert.equal(w.status,'victory');assert.equal(w.debug,false);});\n test('Score attack escalates and uses full enemy vocabulary',()=>{const w=createWorld({mode:'score-attack',seed:7});advance(w,500,w=>[autopilot(w)]);assert.ok(w.scoreWave>=7);assert.ok(w.history['boss-arrival']>0);assert.ok(w.stats.kills>40);assert.ok(w.stats.gunships>0);assert.ok(['running','defeat'].includes(w.status));assert.notEqual(w.status,'victory');});\n test('Score attack ends naturally on defeat',()=>{const w=createWorld({mode:'score-attack'});advance(w,400,[]);assert.equal(w.status,'defeat');assert.ok(w.scoreWave>0);});\n return {passed,failed:failures.length,failures,issues:2,missionSummary};\n}\nif(import.meta.url===`file://${process.argv[1]}`){const r=await runSimulationTests();for(const f of r.failures)console.error(f);console.log(`${r.passed} passed, ${r.failed} failed`);if(r.failed)process.exitCode=1;}\n            check(page.evaluate('audio.stopped && game.audio.song===null && audio.voices.size===0'), 'Stop/end cleanup leaves no sources or music')\n            check(not errors, 'No browser audio or draw errors: ' + '; '.join(errors))\n        finally:\n            browser.close()\n    report.update(passed=passed, failed=len(failures), failures=failures)\n    (ROOT / 'artifacts/audio-report.json').write_text(json.dumps(report, indent=2))\n    return report\n\n\nif __name__ == '__main__':\n    try:\n        result = run_audio_tests()\n    except Exception as exc:\n        result = {'passed': 0, 'failed': 1, 'failures': ['Audio test harness: ' + str(exc)]}\n    print(json.dumps({k: result[k] for k in ['passed', 'failed', 'failures']}))\n    raise SystemExit(1 if result['failed'] else 0)\n                            result['failed'] += 1\n                            result['failures'].append(f'Hub {name}: exact artifact identity/client/draw errors: {inspect}')\n                        else:\n                            result['passed'] += 1\n                        (ARTIFACTS / f'hub-{name}-{len(reports)}-snapshot.json').write_text(json.dumps(inspect, indent=2))\n                except Exception:\n                    result['failed'] += 1\n                    result['failures'].append(f'Hub {name}: {traceback.format_exc()}')\n                finally:\n                    page.remove_listener('pageerror', error_listener)\n            context.close()\n            browser.close()\n    finally:\n        server.shutdown()\n        server.server_close()\n        worker.join(timeout=2)\n        (ARTIFACTS / 'hub-browser-report.json').write_text(json.dumps({'result': result, 'cases': reports}, indent=2))\n    return result\n\n\nif __name__ == '__main__':\n    print(json.dumps(run()))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace(\\\"onUnlock:()=>{app.audio.unlock();app.applyAudio();}\\\",\\\"onUnlock:()=>{if(app.hub?.state==='ended')return;app.audio.unlock();app.applyAudio();}\\\")\ns=s.replace(\\\"game.hook('step',dt=>{app.audio.pause(game.paused&&\"'!app.hub.active);app.audio.tick(dt);\",\"game.hook('\"'input',()=>{if(\"'!(app.hub.active&&app.hub.state==='\"'ended'))app.audio.pause(game.paused&&\"'!app.hub.active);});'\"\\\\ngame.hook('step',dt=>{if(\"'!(app.hub.active&&app.hub.state==='\"'ended'))app.audio.tick(dt);\\\")\n# Snapshot replay is explicitly exported separately through debug, no network traffic.\ns=s.replace(\\\"app.download('orbit-snapshot.json',a.snapshot())\\\",\\\"app.download('orbit-snapshot.json',a.snapshot())\\\")\nopen(p,'w').write(s)\np='src/screens.js';s=open(p).read().replace(\\\"a.command('resetSeed',{seed:a.world.seed})\\\",\\\"a.command('resetSeed',{value:a.world.seed})\\\").replace(\\\"['Export content JSON',()=>a.exportContent()]\\\",\\\"['Wave + timeline preview',()=>this.timeline()],['Export content JSON',()=>a.exportContent()]\\\")\ns=s.replace(\\\"this.name=app.records.data.name;this.letter=0;\\\",\\\"this.game.settings.define({key:'dev_seek',label:'Preview time (seconds)',group:'Dev',value:10,min:0,max:90,step:1});this.name=app.records.data.name;this.letter=0;\\\")\ns=s.replace(\\\" tuning(group){\\\", \\\" timeline(){const a=this.app,w=a.world;this.ui.show('timeline',{kicker:'SECTOR '+(w.sector+1)+' / WAVE '+(w.wave+1),title:'Wave + timeline',text:'Preview any authored wave. The seek runs actual combat with the demonstration pilot and marks the flight as Dev.',rows:['dev_seek'],actions:[...(w.content.sectors[w.sector]?.waves||[]).map((wave,i)=>[wave.title,()=>a.command('wave',{value:i})]),['Advance preview',()=>{a.preview(this.game.settings.dev_seek);this.timeline();}],['Single step',()=>a.stepOnce()],['Back',()=>this.ui.back()]]});}\\\\n tuning(group){\\\")\nopen(p,'w').write(s)\np='src/main.js';s=open(p).read().replace(\\\"app.exportContent=()=>\\\", \\\"app.preview=seconds=>{if(app.hub.active)return;app.world.debug=true;for(let t=0;t<seconds;t+=1/120)stepWorld(app.world,app.world.players.map((_,i)=>autopilot(app.world,i)),1/120);app.present.update(0,app.world);};\\\\napp.exportContent=()=>\\\")\nopen(p,'w').write(s)\np='src/presentation.js';s=open(p).read().replace(\\\"const objective=w.objective||'RING READY? RAM. CANNON READY? THINK.';\\\", \\\"let objective=w.objective||'RING READY? RAM. CANNON READY? THINK.';if(w.sector===0&&w.tutorial){const q=w.tutorial;if(\"'!q.moved)objective='\"'STEER THE SAUCER / WASD OR LEFT STICK';else if(\"'!q.fired)objective='\"'POINT AT A DRIFTER / WAIT FOR THE WHITE BEAD / FIRE';else if(\"'!q.recharged)objective='\"'STOP FIRING / LET THE WHOLE RING RETURN';else if(\"'!q.rammed)objective='\"'RING READY / TOUCH A DRIFTER TO RAM IT SAFELY';}\\\")\n# Title animated orbital probe uses native Path. Every position comes from read-only clock.\ns=s.replace(\\\"const stars=\\\", \\\"const probePath=new E.Path([[0,0,0],[50,-15,0],[80,25,0],[35,52,0],[-20,25,0]],{closed:true,smooth:'catmull'});\\\\nconst stars=\\\")\ns=s.replace(\\\"drifter(g,x-85*k,y-76*k,k*.8,t,{id:3});\\\", \\\"const probe=probePath.at((t*12)%probePath.length);drifter(g,x-90*k+probe.x*.35*k,y-80*k+probe.y*.35*k,k*.8,t,{id:3});\\\")\ns=s.replace(\\\"(12+age*75)*L.k\\\", \\\"(12+E.ease.outQuad(Math.min(1,age))*75)*L.k\\\")\n# Extraction is a readable launch corridor with fixed progression.\ns=s.replace(\\\"for(const gate of w.gates||[])\\\", \\\"if(w.extraction){const [ex,ey]=P(w.extraction.x,w.extraction.y);lineRing(g,ex,ey,(60+Math.sin(t*4)*6)*L.k,C.teal,30,2);txt(g,'EXTRACTION CLEAR',ex,ey-75*L.k,C.teal,{align:'center',scale:2});}\\\\n for(const gate of w.gates||[])\\\")\n# Native material/shape registry for station details, outside the collision rectangle.\ns=s.replace(\\\"const palettes=\\\", \\\"E.MATERIALS.orbitAlloy={color:'#607f89',pattern:'metal',rivet:8};E.MATERIALS.orbitGlow={color:'#93e6d4',pattern:'none',glow:1};E.SHAPES.orbitBeacon={about:'Orbital rail beacon with shaded alloy body and emissive antenna',tags:'space station beacon',mats:{m:'orbitAlloy',g:'orbitGlow'},parts:[['cyl','m',[0,0,0],10,5,{seg:6}],['box','m',[0,0,5],[6,8,10]],['box','g',[0,0,15],[12,3,3]],['row',2,[18,0,0],['box','m',[0,0,4],[11,15,2]]]]};\\\\nconst palettes=\\\")\ns=s.replace(\\\"for(const e of w.enemies||[]){if(e.dead)continue;\\\", \\\"for(const [xx,yy] of [[-45,55],[1005,55],[-45,485],[1005,485]])r.shape('orbitBeacon',xx,yy,0,{scale:.9,shadow:false,light:true});\\\\n for(const e of w.enemies||[]){if(e.dead)continue;\\\")\nopen(p,'w').write(s)\nPY\ncat >> style.css <<'EOF'\nbody[data-scene=title] #e3-corner{display:none\"'!important}.esh .esh-ttl>div{padding-left:0!important}.esh .esh-ttl .esh-sub{font-style:normal!important}\nEOF\nnode tools/build.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
