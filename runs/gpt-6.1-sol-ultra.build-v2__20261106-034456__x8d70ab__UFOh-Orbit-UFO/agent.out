fKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /).\n *  A preset's own halves come first: preset.halves = { left: { pass: ['KeyR'] }, right: { pass: ['KeyL'] } } (an action\n *  a menu reads beside confirm would take confirm's F otherwise) */\nInput.halfKeys = (preset, side) => {\n  const P = typeof preset === 'string' ? Input[preset.toUpperCase()] || Input.DEFAULT : preset || Input.DEFAULT, H = KEY_HALVES[side] || KEY_HALVES.left, own = (P.halves && P.halves[side]) || {}, out = {};\n  let k = 0;\n  for (const a in P) if (Array.isArray(P[a])) out[a] = (own[a] || H[a] || H.buttons[k++] || []).concat(P[a].filter(c => padCode(c)));\n  return out;\n};\nconst _pStub = game => Object.create(game.screen, { canvas: { value: null } });   // (another player's input: the screen's sizes, no listeners of its own)\nconst _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\nfunction _pClaim(game) {   // player 1 reads no pad another player holds; the keyboard's codes go to the players sharing it\n  const P = game.players, I = P[0];\n  I._claimed = new Set(P.slice(1).filter(q => typeof q.pad === 'number').map(q => q.pad));\n  I.keysTo = P.slice(1).filter(q => q.half).concat(game._lobby ? [game._lobby] : []);\n  if (!I.keysTo.length) I.keysTo = null;\n}\n/** let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin\n *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\nGame.prototype.allowJoin = function (o = {}) {\n  if (o === false) { this._join = null; this._lobby = null; _pClaim(this); return this; }\n  this._join = { max: clamp(o.max || 2, 2, 4), onJoin: o.onJoin || null, keys: o.keys !== false };\n  this._lobby = this._join.keys && this.screen.canvas ? new Input(_pStub(this), { join: ['Digit2'] }) : null;   // (listens for 2 while player 1 has the whole keyboard)\n  _pClaim(this); return this;\n};\n/** a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the\n *  left). Returns its input (null when four play already) */\nGame.prototype.addPlayer = function (o = {}) {\n  const P = this.players; if (P.length >= 4) return null;\n  const q = new Input(_pStub(this), Input.DEFAULT), n = P.length + 1;\n  Object.assign(q, { player: n, name: 'P' + n, color: E.PLAYER_COLORS[n - 1], pad: typeof o.pad === 'number' ? o.pad : null, half: o.keys ? 'right' : null, device: o.keys ? 'keyboard' : 'gamepad' });\n  for (const k of ['glyphs', 'deadzone', 'invertAimY', 'invertMoveX', 'invertMoveY', 'rumbleScale']) q[k] = this.input[k];   // (the player's settings: button symbols, dead zone, aim, the move stick, vibration)\n  q.lastDevice = q.device; if (q.pad !== null) { q.tick(0); q.consumeAll(); }   // (the buttons held as it joins, its Start among them, are no presses)\n  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\n  q.use(_pPreset(this, q));\n  if (!this.settings.spec('playerBindings')) this.settings.define({ key: 'playerBindings', group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { for (const p of g.players.slice(1)) p.bindings = (v || {})[p.player] || {}; } });\n  q.bindings = (this.settings.playerBindings || {})[n] || {};\n  q._onBindings = b => this.settings.set('playerBindings', Object.assign({}, this.settings.playerBindings, { [n]: b }));\n  P.push(q); _pClaim(this);\n  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\n  this.note(q.name + ' JOINED', 1.5); this.audio.sfx('confirm');\n  return q;\n};\n/** a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it */\nGame.prototype.removePlayer = function (p) {\n  const P = this.players, i = typeof p === 'number' ? p - 1 : P.indexOf(p); if (i < 1 || i >= P.length) return;\n  P.splice(i, 1); P.forEach((q, k) => { q.player = k + 1; q.name = 'P' + (k + 1); q.color = E.PLAYER_COLORS[k]; });\n  const I = P[0]; if (I.half && !P.some(q => q !== I && q.half)) { I.half = null; I.use(I._full || I.preset); I._full = null; }\n  _pClaim(this);\n};\n/** split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide\n *  screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 } */\nGame.prototype.splitScreen = function (n, o = {}) {\n  if (!(n >= 2)) { this._split = null; return this; }\n  const prev = this._split, vps = Array.from({ length: Math.min(4, n) }, (_, i) => (prev && prev.vps[i]) || _vp(i));\n  this._split = { layout: o.layout || 'auto', gap: o.gap === undefined ? 1 : o.gap, vps };\n  if (o.follow) o.follow.forEach((t, i) => vps[i] && vps[i].follow(t, o));\n  _vpLayout(this); return this;\n};\n// a viewport: where it is on the screen, and its camera (as game.cam: a focus it eases to, the bounds of game.cam)\nfunction _vp(i) {\n  const v = { i, x: 0, y: 0, w: 0, h: 0, target: null, z: 16, cam: { tx: 0, ty: 0, tz: 0, x: undefined, y: 0, vx: 0, vy: 0, smooth: .12, snap: true, bounds: null } };\n  const cycle=b.phaseTime%bal.bossAttackInterval;b.open=cycle>=1.6&&cycle<bal.bossAttackInterval-.55;\n  for(let i=0;i<b.components.length;i++){const c=b.components[i];c.angle=b.angle+i*TAU/3+(b.phase===2?Math.PI/3:0);c.x=b.x+Math.cos(c.angle)*82;c.y=b.y+Math.sin(c.angle)*65;c.open=b.open&&c.hp>0;}\n  b.attackTimer-=dt;\n  if(b.attackTimer<=0){b.attackTimer=bal.bossAttackInterval;emit(w,'boss-warning',b.x,b.y,{phase:b.phase});const p=nearestPilot(w,b);if(p){const a=Math.atan2(p.y-b.y,p.x-b.x);for(let i=0;i<3+b.phase;i++)hostileShot(w,b,a+(i-(2+b.phase)/2)*.17,bal.hostileSpeed*(b.phase===3?1.04:.9));}}\n  b.spawnTimer-=dt;\n  if(b.spawnTimer<=0){b.spawnTimer=b.phase===1?14:b.phase===2?16:19;const cx=b.x+Math.sin(b.age)*140,cy=b.y+85;if(b.phase===1)queueFormation(w,{at:0,formation:'line',type:'drifter',cx,cy,count:4,spacing:50,merge:false});else if(b.phase===2)queueFormation(w,{at:0,formation:'pincer',type:'hunter',cx:480,cy:100,count:2,spacing:260});else queueFormation(w,{at:0,formation:'lane',type:'gunship',cx:60,cy:410,count:1,spacing:0,angle:-.32});}\n}\nfunction enemiesStep(w,dt){\n  for(const g of w.gates)g.timer-=dt;\n  const due=w.gates.filter(g=>g.timer<=0);w.gates=w.gates.filter(g=>g.timer>0);for(const g of due)for(const spec of g.spawns)spawnEnemy(w,spec);\n  for(const e of w.enemies){\n    if(!e.alive)continue;e.age+=dt;e.arm=Math.max(0,e.arm-dt);\n    if(e.type==='boss'){updateBoss(w,e,dt);continue;}\n    if(e.mergeWith){const other=w.enemies.find(a=>a.id===e.mergeWith&&a.alive);if(!other){e.mergeWith=0;e.mergeTime=0;}else {e.mergeTime+=dt;const dx=other.x-e.x,dy=other.y-e.y;e.x+=dx*dt*.55;e.y+=dy*dt*.55;e.angle+=e.spin*dt;if(e.mergeTime>=w.balance.fusionTime&&e.id<other.id){e.alive=false;other.alive=false;const h=spawnEnemy(w,{type:'hunter',x:(e.x+other.x)/2,y:(e.y+other.y)/2});w.stats.fusions++;emit(w,'fusion',h.x,h.y,{enemy:h.id});}continue;}}\n    if(e.type==='drifter'){\n      e.angle+=e.spin*dt;let vx=e.vx||Math.cos(e.id*2.3+w.seed*.1)*w.balance.drifterSpeed*e.speed,vy=e.vy||Math.sin(e.id*1.7+w.seed*.2)*w.balance.drifterSpeed*e.speed;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"cat >> ../PROGRESS.md <<'EOF'\n\n## Integrated build milestone\n- Source modules, native E.Game / E.Shell UI, procedural presentation, invisible twin touch controls, native settings/rebindings, co-op pairing, pause/dev screens, records, About pages and build pipeline implemented.\n- Single-file HTML bundles exact Hub client first, full native engine and own ESM game; no runtime external assets. esbuild0.25.12 build-only.\n- Simulation bot has cleared entire real mission with legal inputs: seeded runs ~7–8 minutes for expert bot; all mechanics and3boss phases recorded. Human8–12minute target remains an estimate.\n- Audio35checks pass including actual native offline cue rendering; source historical audio unverified/unknown.\n- Hub17targeted checks pass; official browser harness underway.\n- UI/browser checks underway. Native boot:false left engine._booting true, blocking all scene changes; fixed by starting without that option (critical integration defect1). Native engine remains unmodified.\n- Visual review caught arena background overlay obscuring actors; moved backgrounds to native decals (visual defect).\n- Hub live overlay cached game.live flag corrected; remote P2 aim maps local input0to assigned world pilot. Need include these in final issue ledger.\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"cat >> ../PROGRESS.md <<'EOF'\n\n## Integrated build milestone\n- Source modules, native E.Game / E.Shell UI, procedural presentation, invisible twin touch controls, native settings/rebindings, co-op pairing, pause/dev screens, records, About pages and build pipeline implemented.\n- Single-file HTML bundles exact Hub client first, full native engine and own ESM game; no runtime external assets. esbuild0.25.12 build-only.\n- Simulation bot has cleared entire real mission with legal inputs: seeded runs ~7–8 minutes for expert bot; all mechanics and3boss phases recorded. Human8–12minute target remains an estimate.\n- Audio35checks pass including actual native offline cue rendering; source historical audio unverified/unknown.\n- Hub17targeted checks pass; official browser harness underway.\n- UI/browser checks underway. Native boot:false left engine._booting true, blocking all scene changes; fixed by starting without that option (critical integration defect1). Native engine remains unmodified.\n- Visual review caught arena background overlay obscuring actors; moved backgrounds to native decals (visual defect).\n- Hub live overlay cached game.live flag corrected; remote P2 aim maps local input0to assigned world pilot. Need include these in final issue ledger.\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
