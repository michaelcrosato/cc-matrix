3f5b62!important;box-shadow:8px 8px 0 #020b12a0!important;padding:28px!important}.esh .esh-mod{width:min(800px,90vw)!important;max-height:88vh!important}.esh h2{font-size:clamp(28px,3.1vw,52px)!important;letter-spacing:-.04em;margin-bottom:16px!important}.esh .esh-m{font-size:clamp(14px,1.2vw,20px)!important;line-height:1.5;color:#a7bec2!important}.esh .esh-sec{margin-top:22px!important}.esh .esh-btns{gap:10px!important;margin-top:23px!important}.esh .esh-stats b{font-size:38px!important;color:#eddbad}.esh .esh-stats small{font-size:12px!important}.esh .esh-row{padding:11px 0!important}.esh input[type=range]{accent-color:#9de5d2;min-width:160px;min-height:40px}.esh .esh-nav{min-width:44px!important;padding:9px!important}.esh .esh-grid{font-size:17px!important}.esh .esh-grid kbd{font-size:15px!important}#e3-corner [title=\"Full screen\"]{display:none!important}#e3-corner button{border-radius:0!important;background:#12262bdd!important}\n@media(max-width:850px){.esh .esh-ttl h1{font-size:72px}.esh .esh-ttl>div{max-width:48vw}.esh .esh-ttl .esh-k{font-size:9px}.esh .esh-sub{font-size:14px;margin-bottom:15px}.esh .esh-ttl button{min-height:39px;font-size:15px!important;padding:8px 15px!important}.esh .esh-tags{display:none}.esh .esh-ttl .esh-m{font-size:10px!important}.esh .esh-pan{padding:19px!important}.esh .esh-mod{max-height:91vh!important}.esh h2{font-size:29px!important}}\n@media(orientation:portrait){.esh .esh-ttl{align-items:flex-end;justify-content:center;padding:0 22px 8vh}.esh .esh-ttl>div{width:100%;max-width:520px;text-align:center}.esh .esh-ttl h1{font-size:clamp(60px,17vw,105px);white-space:normal;margin:13px 0 16px}.esh .esh-ttl .esh-btns{align-items:center;width:100%;gap:7px}.esh .esh-ttl button{text-align:center;min-height:44px}.esh .esh-ttl .esh-k{font-size:10px}.esh .esh-sub{font-size:15px;margin-bottom:16px}.esh .esh-ttl .esh-m{font-size:10px!important}.esh .esh-mod{max-width:94vw!important}.esh .esh-stats{grid-template-columns:1fr 1fr}.esh .esh-mod .esh-btns{display:flex;flex-direction:column}.esh .esh-pan{padding:17px!important}.esh .esh-m{font-size:14px!important}#controls-hint{display:none}}\nEOF\ncat > tools/build.mjs <<'\"'EOF'\nimport {build} from 'esbuild';\nimport {readFile,writeFile,mkdir} from 'node:fs/promises';\nimport path from 'node:path';\nconst dir=path.resolve(import.meta.dirname,'..');\nconst id=JSON.parse(await readFile(path.join(dir,'identity.json'),'utf8'));\nconst out=await build({entryPoints:[path.join(dir,'src/main.js')],bundle:true,write:false,format:'esm',target:'es2022',legalComments:'inline',minify:false});\nconst engine=await readFile(path.join(dir,'vendor/engine/my-3d2dge.js'),'utf8');\nconst hub=await readFile(path.join(dir,'vendor/hub/session.js'),'utf8');\nconst css=await readFile(path.join(dir,'style.css'),'utf8');\nconst license=await readFile(path.join(dir,'vendor/engine/LICENSE'),'utf8');\nconst esc=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst html=\"'`<!doctype html>'\"\\\\n<html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\">\\\\n<script>\"'${hub}</script>'\"\\\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\\\"><title>\"'${id.title}</title>'\"\\\\n<meta name=\\\"description\\\" content=\\\"One shot. No shield. Your move. A complete original orbital arcade shooter inspired by UFO\"'! (1981).\"><meta name=\"theme-color\" content=\"#071018\">'\"\\\\n<meta name=\\\"hub:type\\\" content=\\\"Game\\\"><meta name=\\\"hub:players\\\" content=\\\"1-2\\\"><meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-2\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\"><meta name=\\\"hub:session-minutes\\\" content=\\\"12\\\"><meta name=\\\"hub:session-goal\\\" content=\\\"Clear four sectors and defeat the three-phase command craft as a team\\\"><meta name=\\\"hub:session-howto\\\" content=\\\"Left stick/WASD move; right stick/mouse aim; R2/Space/click fire; Options/Esc menu. Fire spends shield; ready shield rams and rescues.\\\">\\\\n<style>\"'${css}</style></head><body><canvas id=\"screen\" aria-label=\"UFOh Orbit orbital combat arena\"></canvas><div id=\"controls-hint\" hidden></div>'\"\\\\n<\"'!-- Engine license'\"\\\\n\"'${license}'\"\\\\n-->\\\\n<script>\"'${esc(engine)}</script>'\"\\\\n<script type=\\\"module\\\">\"'${esc(out.outputFiles[0].text)}</script>'\"\\\\n</body></html>\"'`;\nawait mkdir(path.join(dir,'\"'build'),{recursive:true});\nawait writeFile(path.join(dir,'build/game.html'),html);\nawait writeFile(path.join(dir,'index.html'),html);\nawait writeFile(path.join(dir,'..',id.slug+'.html'),html);\nif(process.argv.includes('--verbose'))console.log(id.slug+'.html');\nEOF\nnode tools/build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\nimport {createWorld,stepWorld,snapshotWorld,commandWorld,autopilot,importContent,exportContent} from './simulation.js';\nimport {DEFAULT_BALANCE,BALANCE_SPECS} from './data/balance.js';\nimport {Presentation,fitArena} from './presentation.js';\nimport {Controls,INPUT,NEUTRAL} from './controls.js';\nimport {Records} from './storage.js';\nimport {Screens} from './screens.js';\nimport {OrbitAudio} from './audio.js';\nimport {HubAdapter} from './net/hub-adapter.js';\nconst E=globalThis.My3D2dge;\nconst app={world:null,attract:false,idle:0,attractTime:0,demoSector:-1,speed:1,recorded:false,ended:false,overrides:new Map(),resultDelay:0};\nconst game=new E.Game({canvas:'screen',id:'ufoh-orbit-v1',res:[768,432],expand:true,view:'overhead',views:['overhead'],input:INPUT,bg:'#071018',fullscreen:'button',autoPause:true,menu:{quit:'title',items:[['Restart flight',()=>{if(\"'!app.hub.active)app.startRun(app.world.mode,app.world.players.length,true);}],['\"'Dev Mode',()=>app.screens.dev()],['About / Credits',()=>app.screens.about(0)]],settings:[{key:'music',value:.10},{key:'glyphs',value:'playstation'},{key:'voiceVolume',label:'Dispatcher voice',group:'Sound',value:.55,min:0,max:1,step:.05}],controls:{fire:'Cannon (spends shield)',bomb:false}}});\napp.game=game;game.fadeTime=.16;game.cam.smooth=0;game.lights.enabled=true;game.lights.ambient=.78;\napp.records=new Records();app.present=new Presentation(game);app.audio=new OrbitAudio(game);\napp.applyAudio=()=>app.audio.setSettings({master:game.settings.volume,music:game.settings.music,sfx:game.settings.effects,voice:game.settings.voiceVolume,muted:\"'!game.settings.sound});app.applyAudio();\napp.controls=new Controls(game,{activity:()=>{app.idle=0;},isPlaying:()=>game.sceneName==='\"'play',isAttract:()=>app.attract,cancelAttract:()=>app.toTitle(),onUnlock:()=>{app.audio.unlock();app.applyAudio();}});\napp.startRun=(mode='mission',players=1,paired=false,attract=false)=>{if(app.hub.active)return;if(\"'!paired)app.controls.pairing('\"'solo');app.screens.ui.hide();game.resume();app.attract=attract;app.attractTime=0;app.demoSector=-1;app.ended=false;app.resultDelay=0;app.recorded=false;app.speed=1;app.overrides.clear();app.world=createWorld({mode,players,seed:7,attract});for(const s of BALANCE_SPECS)game.settings.set('dev_'+s.key,s.value);app.present.reset();app.audio.resetEvents();app.controls.clear();app.controls.blockUntil=game.real+.25;game.go('play',null,{fade:0});game.tween(app.present.titlePose,{lift:1},.8,{ease:'outCubic'});app.audio.setScene('mission');if(\"'!attract)app.audio.say('\"'GOOD NEWS. YOUR SAUCER HAS A SHIELD.');};\napp.toTitle=()=>{if(app.hub?.active)return;app.attract=false;app.idle=0;app.attractTime=0;app.world=null;app.ended=false;app.speed=1;app.overrides.clear();app.controls.clear();app.audio.stop();app.present.reset();app.screens.ui.hide();game.resume();game.go('title',null,{fade:0});};\napp.command=(name,args={})=>{if(app.hub?.active)return false;const out=commandWorld(app.world,name,args);if(['sector','phase','restart','resetSeed','clear'].includes(name)){app.present.reset();app.audio.resetEvents();}return out;};\napp.applyTuning=()=>{if(\"'!app.world||app.hub?.active||!app.world.debug)return;const balance={};for(const s of BALANCE_SPECS)balance[s.key]=game.settings['\"'dev_'+s.key];commandWorld(app.world,'balance',balance);};\napp.snapshot=()=>({title:'UFOh Orbit',scene:game.sceneName,screen:app.screens.ui.screen,attract:app.attract,idle:app.idle,world:app.world?snapshotWorld(app.world):null,hub:app.hub.snapshot(),audio:app.audio.debug(),device:game.input.lastDevice,players:game.players.length,presentation:{layout:app.present.layout},errors:game.errors});\napp.stepOnce=()=>{if(\"'!app.world||app.hub.active)return;app.applyTuning();stepWorld(app.world,[],1/120);app.present.update(1/120,app.world);};\napp.download=(name,value)=>{if(app.hub.act