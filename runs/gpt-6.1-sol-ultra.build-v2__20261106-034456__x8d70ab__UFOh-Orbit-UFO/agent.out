{"type":"item.completed","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -lc \"rg -n 'lastLocalIntent|sendInput|inputClock|tick\\\\(' src/net/hub-adapter.js && sed -n '205,265p' src/net/hub-adapter.js && sed -n '430,485p' src/net/hub-adapter.js && sed -n '335,390p' src/net/hub-adapter.js && sed -n '1,70p' tests/hub.mjs\"","aggregated_output":"79:    this.inputClock = 0;\n91:    this.lastLocalIntent = { ...NEUTRAL };\n255:    this.lastLocalIntent = { ...NEUTRAL };\n261:  tick(dt, localInput = NEUTRAL, options = {}) {\n268:    this.lastLocalIntent = input;\n287:      this.inputClock += dt;\n288:      if (this.inputClock >= .1) {\n289:        this.inputClock %= .1;\n    if (sent === false) { this.stats.dropped++; return false; }\n    this.sentTimes.push(this.elapsed);\n    this.stats.sent++;\n    this.stats.maxRate = Math.max(this.stats.maxRate,this.sentTimes.length);\n    return true;\n  }\n\n  flush() {\n    let sent = 0;\n    while (this.outgoing.length && sent < 2) {\n      if (!this.send(this.outgoing[0])) break;\n      this.outgoing.shift();\n      sent++;\n    }\n    if (this.finishPending && !this.outgoing.length) {\n      const result = this.finishPending;\n      this.finishPending = null;\n      this.hub.finish(result);\n      this.finished = true;\n      this.setState('finished');\n    }\n  }\n\n  finish(won) {\n    if (!this.isHost || this.finished || this.finishPending || this.state === 'ended') return;\n    const world = this.config.getWorld?.();\n    const ids = [...this.liveIds];\n    const score = Math.max(0,Number(world?.score) || 0);\n    this.outgoing.length = 0;\n    this.queueWorld(true);\n    this.finishPending = { standings: ids.length ? [ids] : [], scores:Object.fromEntries(ids.map(id => [id,score])), won:won === true };\n    this.setState('finishing');\n    this.flush();\n  }\n\n  timeUp() {\n    if (!this.isHost || this.finished || this.state === 'ended') return;\n    const world = this.config.getWorld?.();\n    if (world?.status === 'running') {\n      world.status = 'defeat';\n      world.objective = 'TIME UP. THE SPACE MACHINERY WINS THIS ROUND.';\n      this.config.onTimeUp?.(world);\n    }\n    this.finish(world?.status === 'victory');\n  }\n\n  end(detail) {\n    if (this.state === 'ended') return;\n    this.outgoing.length = 0;\n    this.localHistory.length = 0;\n    this.lastLocalIntent = { ...NEUTRAL };\n    for (const entry of this.remote.values()) entry.input = { ...NEUTRAL };\n    this.setState('ended');\n    this.config.onEnd?.(detail);\n  }\n\n  tick(dt, localInput = NEUTRAL, options = {}) {\n    if (!this.active || this.state === 'ended' || this.state === 'finished') return;\n    this.elapsed += dt;\n    if (this.finishPending) { this.flush(); return; }\n    if (!Number.isFinite(this.hub.time()) || this.hub.time() < 0 || !['countdown','running'].includes(this.state)) return;\n        p.targetAngle=target;\n      }\n      p.angle=angle;\n      p.shield=Math.max(0,p.shield-age);\n      if (input.fire || this.localHistory.some(h => h.input.fire)) p.shield=Math.max(p.shield,Number(balance.shieldRecharge ?? 1.6));\n    }\n    this.config.applyWorld?.(world);\n  }\n\n  snapshot() {\n    return { active:this.active,state:this.state,isHost:this.isHost,server:this.server,localIndex:this.localIndex,players:[...this.liveIds],elapsed:round(this.elapsed),sequence:this.sequence,snapshotSequence:this.snapshotSequence,queue:this.outgoing.length,finished:this.finished,stats:{ ...this.stats } };\n  }\n\n  dispose() {\n    for (const unsubscribe of this.unsubscribers) unsubscribe?.();\n    this.unsubscribers.length = 0;\n    this.end({ reason:'disposed' });\n  }\n}\nimport { HubAdapter, cleanIntent, encodeWorld, decodeWorld } from '../src/net/hub-adapter.js';\nimport assert from 'node:assert/strict';\nimport {createWorld,stepWorld,commandWorld,snapshotWorld} from '../src/simulation.js';\n\nconst neutral={mx:0,my:0,ax:0,ay:0,aim:false,fire:false};\nfunction makeNetwork({players=2,server=false,real=false}={}) {\n const net={clock:0,goAt:Infinity,hubs:new Map(),adapters:[],worlds:new Map(),finished:[],ready:[],out:[]};\n const roster=Array.from({length:players},(_,id)=>({id,name:'Pilot '+(id+1),color:'#fff'}));\n const host=server?-1:0;\n for(const id of [...roster.map(p=>p.id),...(server?[-1]:[])]){\n  const listeners=new Map();\n  const info={me:id,players:roster,host,isHost:id===host,server:id===-1,seed:7};\n  const hub={...info,connect:async()=>info,on:(event,fn)=>{const fs=listeners.get(event)||[];fs.push(fn);listeners.set(event,fs);return()=>fs.splice(fs.indexOf(fn),1);},emit:(event,...args)=>{for(const f of listeners.get(event)||[])f(...args);},ready:()=>net.ready.push(id),time:()=>net.clock*1000-net.goAt,rng:()=>()=>.5,send:(data,opts)=>{net.out.push({id,data,opts,time:net.clock});for(const [to,target] of net.hubs)if(to!==id&&(opts.to===undefined||opts.to===to))target.emit('message',structuredClone(data),id);return true;},finish:result=>net.finished.push({id,result})};\n  net.hubs.set(id,hub);\n  const adapter=new HubAdapter({hub,start:({players})=>net.worlds.set(id,real?createWorld({players:players.map(p=>p.id),seed:7}):{time:0,status:'running',players:players.map(p=>({id:p.id,x:200,y:200,vx:0,vy:0,angle:0,targetAngle:0,hull:3,shield:0,down:false})),enemies:[],bullets:[],blasts:[],chains:[],events:[],score:0,sector:0,balance:{moveSpeed:180,shieldRecharge:1.6}}),step:(inputs,dt)=>{const w=net.worlds.get(id);if(real){stepWorld(w,inputs,dt);return;}w.time+=dt;w.players.forEach((p,i)=>{p.x+=inputs[i].mx*180*dt;p.y+=inputs[i].my*180*dt;});},getSnapshot:()=>real?snapshotWorld(net.worlds.get(id)):net.worlds.get(id),getWorld:()=>net.worlds.get(id),applyWorld:w=>net.worlds.set(id,w)});\n  net.adapters.push(adapter);\n }\n net.connect=async()=>{await Promise.all(net.adapters.map(a=>a.connect()));};\n net.start=()=>{net.goAt=net.clock*1000;for(const h of net.hubs.values())h.emit('start',{in:0});};\n net.run=(seconds,inputs={})=>{for(let n=0;n<Math.round(seconds*120);n++){net.clock+=1/120;for(const a of net.adapters)a.tick(1/120,inputs[a.info.me]??neutral);}};\n return net;\n}\n\nexport async function runHubTests(){\n const results={passed:0,failed:0,failures:[]};\n const test=async(name,fn)=>{try{await fn();results.passed++;}catch(error){results.failed++;results.failures.push(name+': '+error.stack);}};\n await test('intent validation and normalization',()=>{assert.deepEqual(cleanIntent(null),neutral);assert.equal(cleanIntent({mx:Infinity,fire:'yes'}).fire,false);const input=cleanIntent({mx:1,my:1,ax:1,ay:0,aim:true,fire:true});assert.ok(Math.abs(Math.hypot(input.mx,input.my)-1)<1e-9);assert.equal(input.aim,true);assert.equal(input.fire,true);const mouse=cleanIntent({ax:300,ay:10,aim:true});assert.ok(Math.abs(mouse.ay/mouse.ax-1/30)<1e-12);});\n await test('packed actors preserve identity and component data',()=>{const world={time:1.123456,enemies:[{id:1,type:'drifter',x:9.123456,y:2},{id:2,type:'boss',x:3,y:4,components:[{id:'a',hp:3},{id:'b',hp:4}]}],players:[{id:0,x:4}],history:[1,2],events:[]};const out=decodeWorld(encodeWorld(world));assert.equal(out.time,1.123);assert.equal(out.enemies.length,2);assert.equal(out.enemies[0].x,9.123);assert.equal(out.boss,out.enemies[1]);assert.equal(out.boss.components[1].hp,4);assert.equal(out.history,undefined);});\n await test('automatic ready and countdown gate',async()=>{const n=makeNetwork();await n.connect();assert.deepEqual(n.ready,[0,1]);n.run(3,{0:{mx:1}});assert.equal(n.worlds.get(0).time,0);n.start();n.run(1,{0:{mx:1}});assert.ok(n.worlds.get(0).players[0].x>300);assert.ok(n.adapters.every(a=>a.state==='running'));});\n await test('host receives neutral heartbeats and snapshots flow both ways',async()=>{const n=makeNetwork();await n.connect();n.start();n.run(2);assert.ok(n.adapters.every(a=>a.stats.sent>0&&a.stats.received>0));assert.ok(n.adapters[1].stats.acknowledged>0);assert.ok(n.adapters.every(a=>a.stats.maxRate<=16&&a.stats.maxBytes<16384));});\n await test('membership and old intent rejection',async()=>{const n=makeNetwork();await n.connect();n.start();const host=n.adapters[0];host.receive({game:'ufoh-orbit-v1',kind:'input',seq:1,input:{mx:1}},99);assert.equal(host.stats.rejected,1);host.receive({game:'ufoh-orbit-v1',kind:'input',seq:10,input:{mx:1}},1);host.receive({game:'ufoh-orbit-v1',kind:'input',seq:9,input:{mx:-1}},1);assert.equal(host.remote.get(1).input.mx,1);assert.equal(host.stats.rejected,2);});\n await test('stale held intent expires',async()=>{const n=makeNetwork();await n.connect();n.start();const host=n.adapters[0];host.receive({game:'ufoh-orbit-v1',kind:'input',seq:1,input:{mx:1}},1);for(let i=0;i<180;i++){n.clock+=1/120;host.tick(1/120,neutral);}const x=n.worlds.get(0).players[1].x;assert.ok(x>260&&x<295);});\n await test('only host can publish world',async()=>{const n=makeNetwork();await n.connect();n.start();n.run(.2);const guest=n.adapters[1];const time=n.worlds.get(1).time;guest.receive({game:'ufoh-orbit-v1',kind:'world',seq:100,part:0,total:1,payload:encodeWorld({...n.worlds.get(0),score:999})},123);assert.notEqual(n.worlds.get(1).score,999);assert.ok(n.worlds.get(1).time>=time);});\n await test('server host has no local pilot but simulates',async()=>{const n=makeNetwork({server:true});await n.connect();n.start();n.run(1,{0:{mx:1}});const server=n.adapters.find(a=>a.server);assert.equal(server.localIndex,-1);assert.ok(n.worlds.get(-1).time>.9);assert.ok(n.worlds.get(-1).players[0].x>300);assert.ok(server.stats.snapshots===0&&server.stats.sent>0&&server.stats.received>0);});\n await test('departing pilot loses held intent and rescue eligibility',async()=>{const n=makeNetwork();await n.connect();n.start();n.run(.2,{1:{mx:1,fire:true}});for(const h of n.hubs.values())h.emit('leave',{id:1});n.run(.2,{1:{mx:1,fire:true}});const host=n.adapters[0];assert.equal(host.liveIds.has(1),false);assert.equal(host.remote.get(1).input.fire,false);assert.equal(n.worlds.get(0).players[1].departed,true);assert.equal(n.worlds.get(0).players[1].active,false);assert.ok(host.stats.rejected>0);});\n await test('time-up sends final world and exactly one finish',async()=>{const n=makeNetwork();await n.connect();n.start();n.run(.2);for(const h of n.hubs.values())h.emit('time-up',{graceMs:2000});n.run(.4);assert.equal(n.finished.length,1);assert.equal(n.finished[0].result.won,false);assert.deepEqual(n.finished[0].result.standings,[[0,1]]);assert.equal(n.worlds.get(1).status,'defeat');for(const h of n.hubs.values())h.emit('time-up',{graceMs:2000});assert.equal(n.finished.length,1);});\n await test('end closes input and outbound traffic',async()=>{const n=makeNetwork();await n.connect();n.start();n.run(.5);for(const h of n.hubs.values())h.emit('end',{reason:'finished'});const sent=n.out.length;const time=n.worlds.get(0).time;n.run(2,{0:{mx:1,fire:true},1:{mx:1,fire:true}});assert.equal(n.out.length,sent);assert.equal(n.worlds.get(0).time,time);assert.ok(n.adapters.every(a=>a.state==='ended'));});\n await test('dense snapshots fragment without losing actors',async()=>{const n=makeNetwork();await n.connect();n.start();const w=n.worlds.get(0);w.enemies=Array.from({length:240},(_,i)=>({id:i+1,type:'drifter',x:i*3.12,y:i*.8,r:14,angle:i*.14,arm:0,warning:0}));w.bullets=Array.from({length:200},(_,i)=>({id:i+500,x:i,y:i,px:i-1,py:i-1,vx:300,vy:300,hostile:true,owner:0}));n.run(1.2);assert.equal(n.worlds.get(1).enemies.length,240);assert.equal(n.worlds.get(1).bullets.length,200);assert.ok(n.adapters[0].stats.maxRate<=16);assert.ok(n.adapters[0].stats.maxBytes<16384);});\n await test('Unicode objective survives bounded fragments',async()=>{const n=makeNetwork();await n.connect();n.start();n.worlds.get(0).objective='星'.repeat(8000);n.run(1.5);assert.equal(n.worlds.get(1).objective,'星'.repeat(8000));assert.ok(n.adapters[0].stats.maxBytes<16384);});\n await test('nonhost held fire does not promise ready shield',async()=>{const n=makeNetwork();await n.connect();n.start();n.run(.3,{1:{mx:1,fire:true}});assert.ok(n.worlds.get(1).players[1].shield>0);});\n await test('real shared cannon cascade and authoritative score reach guest',async()=>{const n=makeNetwork({real:true});await n.connect();n.start();const w=n.worlds.get(0);w.transition=10000;w.players[0].x=200;w.players[0].y=270;w.players[0].angle=0;w.players[0].targetAngle=0;commandWorld(w,'spawn',{type:'drifter',x:340,y:270,count:4,spacing:50,formation:'line',merge:false});for(const e of w.enemies)e.speed=0;n.run(1,{0:{ax:1,ay:0,aim:true,fire:true}});assert.equal(w.stats.kills,4);assert.ok(w.bestChain>=3);assert.ok(w.score>4);assert.equal(n.worlds.get(1).score,w.score);assert.equal(n.worlds.get(1).enemies.length,0);assert.ok(n.worlds.get(1).players[0].shield>0);});\n await test('real shared rescue consumes ready shield and synchronizes hull',async()=>{const n=makeNetwork({real:true});await n.connect();n.start();const w=n.worlds.get(0);w.transition=10000;const [p0,p1]=w.players;p0.x=200;p0.y=270;p0.shield=0;p0.invuln=0;p1.x=245;p1.y=270;p1.hull=0;p1.down=true;n.run(.5,{0:{mx:1}});assert.equal(w.stats.rescues,1);assert.equal(p1.down,false);assert.equal(p1.hull,1);assert.ok(p0.shield>0);assert.equal(n.worlds.get(1).players[1].hull,1);assert.equal(n.worlds.get(1).players[1].down,false);});\n await test('real shared fusion and boss component phases survive serialization',async()=>{const n=makeNetwork({real:true});await n.connect();n.start();const w=n.worlds.get(0);w.transition=10000;commandWorld(w,'spawn',{type:'drifter',x:480,y:100,count:2,spacing:28,formation:'line'});for(const e of w.enemies)e.speed=0;n.run(3);assert.equal(w.stats.fusions,1);assert.ok(n.worlds.get(1).enemies.some(e=>e.type==='hunter'));commandWorld(w,'clear');commandWorld(w,'phase',{value:3});n.run(2);const b=n.worlds.get(1).boss;assert.equal(b.phase,3);assert.equal(b.components.length,3);assert.ok(b.components.every(c=>typeof c.hp==='number'));assert.equal(n.worlds.get(1).arena.w,960);assert.equal(n.worlds.get(1).arena.h,540);});\n await test('real departed pilot cannot be rescued',async()=>{const n=makeNetwork({real:true});await n.connect();n.start();const w=n.worlds.get(0);w.transition=10000;Object.assign(w.players[0],{x:200,y:270,shield:0,invuln:0});Object.assign(w.players[1],{x:240,y:270,down:true,hull:0});for(const h of n.hubs.values())h.emit('leave',{id:1});n.run(.4,{0:{mx:1}});assert.equal(w.stats.rescues,0);assert.equal(w.players[1].active,false);assert.equal(w.players[1].down,true);assert.equal(w.status,'running');});\n return results;\n}\nif(process.argv[1]?.endsWith('/hub.mjs')){const r=await runHubTests();for(const f of r.failures)console.error(f);console.log(`${r.passed} passed, ${r.failed} failed`);process.exitCode=r.failed?1:0;}\n","exit_code":0,"status":"completed"}}
