w.testingFeedback.map((v, i) => [\n\t\t\t\t\t[\n\t\t\t\t\t\t\"Issues caught\",\n\t\t\t\t\t\t\"Critical issues\",\n\t\t\t\t\t\t\"Most helpful test\",\n\t\t\t\t\t\t\"Least helpful test\",\n\t\t\t\t\t][i],\n\t\t\t\t\tv,\n\t\t\t\t]),\n\t\t\t],\n\t\t\t[\n\t\t\t\t\"Engine Feedback\",\n\t\t\t\tinterview.engineFeedback.map((v, i) => [\n\t\t\t\t\t[\n\t\t\t\t\t\t\"Liked most\",\n\t\t\t\t\t\t\"Wrong assumptions\",\n\t\t\t\t\t\t\"Built for this game\",\n\t\t\t\t\t\t\"Hardest part\",\n\t\t\t\t\t\t\"Engine modifications\",\n\t\t\t\t\t\t\"Suggested improvement\",\n\t\t\t\t\t][i],\n\t\t\t\t\tv,\n\t\t\t\t]),\n\t\t\t],\n\t\t\t[\n\t\t\t\t\"Prompt Feedback\",\n\t\t\t\tinterview.promptFeedback.map((v, i) => [\n\t\t\t\t\t[\"Liked most\", \"Confusing\", \"Hardest part\", \"Suggested improvement\"][\n\t\t\t\t\t\ti\n\t\t\t\t\t],\n\t\t\t\t\tv,\n\t\t\t\t]),\n\t\t\t],\n\t\t];\n\t\tconst [title, sections] = all[page];\n\t\tthis.ui.show(\"about\", {\n\t\t\tkicker: `UFOh ORBIT / FIELD RECORD ${page + 1} OF 4`,\n\t\t\ttitle,\n\t\t\ttext: \"An original game inspired by UFO! (1981). Game code and art: OpenAI gpt-6.1-sol. Engine: Michael Crosato (MIT).\",\n\t\t\tsections,\n\t\t\tactions: [\n\t\t\t\t[\"Next page\", () => this.about((page + 1) % 4)],\n\t\t\t\t[\"Previous page\", () => this.about((page + 3) % 4)],\n\t\t\t\t[\"Back\", () => this.ui.back()],\n\t\t\t],\n\t\t\tfooter:\n\t\t\t\t\"Native engine MIT notice: Copyright (c) 2026 Michael Crosato. Permission to use, copy, modify, merge, publish, distribute, sublicense and/or sell copies is granted with notice. Software is provided AS IS without warranty. Full notice is embedded in this HTML.\",\n\t\t});\n\t}\n\tresults() {\n\t\tconst a = this.app,\n\t\t\tw = a.world;\n\t\tthis.ui.hide();\n\t\tthis.ui.show(\"results\", {\n\t\t\tkicker:\ntests/final-browser.py:30:        \"Interview and bundled About data agree\",\ntests/final-browser.py:73:        page.get_by_role(\"button\", name=\"About / Credits\", exact=True).click()\ntests/final-browser.py:77: 