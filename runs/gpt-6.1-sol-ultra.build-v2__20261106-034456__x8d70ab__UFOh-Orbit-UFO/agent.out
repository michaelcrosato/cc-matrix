{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"sed -n '128,207p' src/audio.js && sed -n '9505,9533p' vendor/engine/my-3d2dge.js && rg -n 'SHELL_CSS|esh-ttl' vendor/engine/my-3d2dge.js | head -7 && ls tests\"","aggregated_output":"\tricochet: \"cancel\",\n\twreck: \"damage\",\n\tfusionStart: \"merge\",\n\tfusionComplete: \"hunterCharge\",\n\tlane: \"warning\",\n\tgunshipWarning: \"warning\",\n\tvolley: \"missile\",\n\tchainKill: \"chain\",\n\tbossPhase: \"phase\",\n\trevive: \"rescue\",\n\tdeath: \"defeat\",\n});\nconst bounded = (value, fallback) =>\n\tNumber.isFinite(value) ? Math.min(1, Math.max(0, value)) : fallback;\n\nexport class OrbitAudio {\n\tconstructor(game) {\n\t\tthis.game = game;\n\t\tthis.native = game.audio;\n\t\tthis.settings = {\n\t\t\tmaster: 0.65,\n\t\t\tmusic: 0.1,\n\t\t\tsfx: 0.8,\n\t\t\tvoice: 0.55,\n\t\t\tmuted: false,\n\t\t};\n\t\tthis.unlocked = false;\n\t\tthis.paused = false;\n\t\tthis.stopped = false;\n\t\tthis.scene = \"title\";\n\t\tthis.lastEvent = 0;\n\t\tthis.played = 0;\n\t\tthis.gibberishCount = 0;\n\t\tthis.handles = [];\n\t\tthis.voices = new Set();\n\t\tthis.lastCue = new Map();\n\t\tthis.elapsed = 0;\n\t\tthis.subtitle = \"\";\n\t\tthis.subtitleUntil = 0;\n\t\tthis.rechargeAt = null;\n\t\tfor (const [name, voice] of Object.entries(CUES))\n\t\t\tthis.native.define(`orbit:${name}`, voice);\n\t\tthis.setSettings(this.settings);\n\t}\n\n\tunlock() {\n\t\tif (this.stopped) this.stopped = false;\n\t\tif (this.game.headless) return false;\n\t\tconst bus = this.native.bus(\"sfx\");\n\t\tif (!bus || !this.native.ctx) return false;\n\t\tthis.unlocked = true;\n\t\tif (this.native.ctx.state === \"suspended\")\n\t\t\tthis.native.ctx.resume().catch(() => {});\n\t\tthis.setSettings(this.settings);\n\t\tif (!this.paused) this.startSong();\n\t\treturn true;\n\t}\n\n\tsetSettings(settings = {}) {\n\t\tfor (const k of [\"master\", \"music\", \"sfx\", \"voice\"]) {\n\t\t\tif (Object.hasOwn(settings, k))\n\t\t\t\tthis.settings[k] = bounded(settings[k], this.settings[k]);\n\t\t}\n\t\tif (Object.hasOwn(settings, \"muted\"))\n\t\t\tthis.settings.muted = !!settings.muted;\n\t\tconst a = this.native,\n\t\t\ts = this.settings;\n\t\ta.volume = s.master;\n\t\ta.musicVolume = s.music;\n\t\ta.sfxVolume = s.sfx;\n\t\ta.voiceVolume = s.voice;\n\t\ta.muted = s.muted;\n\t\ta.applyVolume();\n\t}\n\n\tsetScene(scene) {\n\t\tif (!MUSIC[scene]) scene = \"mission\";\n\t\tconst changed = this.scene !== scene;\n\t\tthis.scene = scene;\n\t\tthis.stopped = false;\n  }\n  /** a sideways swipe on a screen goes back: the panel follows the finger and goes back past 70 px (a slider keeps its own) */\n  _swipe(sh, box, title) {\n    if (title) return; let s0 = null, swiped = false;\n    const end = e => { if (!s0 || e.pointerId !== s0.id) return; const dx = e.clientX - s0.x, go = s0.on && Math.abs(dx) > 70 && e.type === 'pointerup'; swiped = s0.on; s0 = null;\n      box.classList.add('esh-sw'); box.style.transform = go ? 'translateX(' + Math.sign(dx) * 110 + '%)' : ''; box.style.opacity = go ? '0' : '';\n      if (go) setTimeout(() => this.back(), 120); };\n    sh.addEventListener('pointerdown', e => { swiped = false; if (e.pointerType === 'mouse' || s0 || (e.target.closest && e.target.closest('input'))) return; s0 = { id: e.pointerId, x: e.clientX, y: e.clientY, on: false }; box.classList.remove('esh-sw'); });\n    sh.addEventListener('click', e => { if (swiped) { e.stopPropagation(); e.preventDefault(); swiped = false; } }, true);   // (the button a swipe began on isn't pressed)\n    sh.addEventListener('pointermove', e => {\n      if (!s0 || e.pointerId !== s0.id) return; const dx = e.clientX - s0.x, dy = e.clientY - s0.y;\n      if (!s0.on && Math.abs(dx) > 14 && Math.abs(dx) > Math.abs(dy) * 1.3) s0.on = true;\n      if (s0.on) { box.style.transform = 'translateX(' + dx + 'px)'; box.style.opacity = String(clamp(1 - Math.abs(dx) / 300, .3, 1)); }\n    });\n    for (const t of ['pointerup', 'pointercancel']) sh.addEventListener(t, end);\n  }\n  /** a message that slides in at the top for a few seconds */\n  toast(title, text = '', seconds = 4) {\n    if (!this.root) return this;\n    const e = this._els.toast; e.replaceChildren(this._el('b', '', title)); if (text) e.appendChild(this._el('p', 'esh-m', text));\n    e.classList.add('on'); this._toastEnd = this._game.real + seconds; return this;\n  }\n  /** a tutorial card (bottom left, dismissable) for some seconds; tutorial(null) takes it away */\n  tutorial(title, text = '', seconds = 15) {\n    if (!this.root) return this;\n    const e = this._els.tut; e.hidden = !title; this._tutEnd = title ? this._game.real + seconds : 0; if (!title) return this;\n    const x = this._el('button', 'esh-x', '×'); x.setAttribute('aria-label', 'Dismiss'); x.onclick = () => this.tutorial(null);\n    e.replaceChildren(this._el('div', 'esh-k', 'Tutorial'), this._el('b', '', title), this._el('p', 'esh-m', text), x); return this;\n  }\n9363:const SHELL_CSS = `.esh{position:fixed;inset:0;pointer-events:none;z-index:20;font:14px/1.45 var(--font);color:var(--ink);--sat:env(safe-area-inset-top,0px);\n9387:.esh-sh{position:absolute;inset:0;display:grid;place-items:center;background:#04060acc;pointer-events:auto;padding:calc(var(--pt) + 46px) var(--pr) var(--pb) var(--pl);animation:esh-in .25s;touch-acti [... omitted end of long line]\n9392:.esh-ttl{place-items:center start;background:linear-gradient(90deg,#04060aee,#04060a99 50%,#04060a00 85%)}.esh-ttl>div{max-width:min(520px,92vw);padding-left:4vw}\n9393:.esh-ttl h1{font-size:clamp(44px,10vw,92px);letter-spacing:.07em}.esh-sub{font:italic 20px var(--title);color:var(--accent);margin-top:6px}\n9446:    if (!document.getElementById('esh-css')) { const st = document.createElement('style'); st.id = 'esh-css'; st.textContent = SHELL_CSS; document.head.appendChild(st); }\n9712:    const sh = this._el('div', 'esh-sh' + (title ? ' esh-ttl' : '')), box = this._el('div', title ? '' : 'esh-pan esh-mod' + (name === 'map' ? ' esh-wide' : ''));\naudio-browser.py\nhub-browser.py\nhub.mjs\nsimulation.mjs\n","exit_code":0,"status":"completed"}}
