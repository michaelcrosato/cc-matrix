{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read();s=s.replace(\\\"items:[['Restart flight',()=>{if(\"'!app.hub.active)app.startRun(app.world.mode,app.world.players.length,true);}],['\"'Dev Mode',()=>app.screens.dev()],['About / Credits',()=>app.screens.about(0)]],\\\", \\\"items:()=>app.hub?.active?[['Link diagnostics',()=>app.screens.dev()],['About / Credits',()=>app.screens.about(0)]]:[['Restart flight',()=>app.startRun(app.world.mode,app.world.players.length,true)],['Dev Mode',()=>app.screens.dev()],['About / Credits',()=>app.screens.about(0)]],\\\")\ns=s.replace(\\\"app.controls=new Controls(game,\\\", \\\"app.controls=new Controls(game,\\\")\ns=s.replace(\\\"app.screens=new Screens(app);\\\", \\\"app.screens=new Screens(app);\\\\nconst rescueButton=document.getElementById('rescue-action');if(rescueButton)rescueButton.onclick=e=>{e.preventDefault();e.stopPropagation();app.controls.rescueUntil=game.real+1.1;};\\\")\ns=s.replace(\\\"if(game.sceneName==='play'&&\"'!app.screens.ui.screen&&!app.attract&&app.world){const hint\", \"if(rescueButton){const p=app.world?.players[app.hub.active?Math.max(0,app.hub.localIndex):0],wreck=app.world?.players.find(q=>q.down&&q.active!==false);rescueButton.hidden=!(game.input.lastDevice==='\"'touch'&&game.sceneName==='play'&&\"'!app.screens.ui.screen&&p&&!p.down&&p.shield<=0&&wreck&&Math.hypot(p.x-wreck.x,p.y-wreck.y)<110);}'\"\\\\n if(game.sceneName==='play'&&\"'!app.screens.ui.screen&&!app.attract&&app.world){const hint\")\nopen(p,'\"'w').write(s)\np='src/controls.js';s=open(p).read().replace(\\\"return{mx,my,ax,ay,aim,fire};}\\\",\\\"if(this.rescueUntil>this.game.real&&p&&p.shield<=0){const q=world.players.find(q=>q.down&&q.active\"'!==false);if(q){const d=Math.hypot(q.x-p.x,q.y-p.y)||1;mx=(q.x-p.x)/d;my=(q.y-p.y)/d;fire=false;}}'\"\\\\n return{mx,my,ax,ay,aim,fire};}\\\")\nopen(p,'w').write(s)\np='tools/build.mjs';s=open(p).read