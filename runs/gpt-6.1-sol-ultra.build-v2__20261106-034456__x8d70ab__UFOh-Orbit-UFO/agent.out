;\nconst _warned = new Set();\n/** one console warning per distinct problem, prefixed so tools (and people) can spot engine advice: warn(key, message) */\nconst warn = (key, msg) => { if (_warned.has(key)) return; _warned.add(key); console.warn('my-3D2dge: ' + msg); };\nE.warn = warn;\n\n/* =============================================================================\n * 1. MATH\n * ============================================================================= */\n/** v kept between a and b */\nconst clamp = (v, a, b) => v < a ? a : v > b ? b : v;\n{\n  \"passed\": 7,\n  \"failed\": 1,\n  \"failures\": [\n    \"Keyboard menu/dev journey after Controls: Locator.click: Timeout 3000ms exceeded.\"\n  ],\n  \"notes\": [],\n  \"artifact\": \"/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-ultra.build-v2__20261106-034456__x8d70ab/work/UFOh-Orbit-UFO-gpt-6.1-sol-ultra-20261106-034456/build/game.html\",\n  \"traces\": [\n    \"Locator.click: Timeout 3000ms exceeded.\\nCall log:\\n  - waiting for get_by_role(\\\"button\\\", name=\\\"Space / Z / J / Left click\\\", exact=True)\\n\"\n  ]\n}{\n  \"passed\": 7,\n  \"failed\": 1,\n  \"failures\": [\n    \"Keyboard menu/dev journey after Controls: Locator.click: Timeout 3000ms exceeded.\"\n  ],\n  \"notes\": [],\n  \"artifact\": \"/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-ultra.build-v2__20261106-034456__x8d70ab/work/UFOh-Orbit-UFO-gpt-6.1-sol-ultra-20261106-034456/build/game.html\",\n  \"traces\": [\n    \"Locator.click: Timeout 3000ms exceeded.\\nCall log:\\n  - waiting for get_by_role(\\\"button\\\", name=\\\"Space / Z / J / Left click\\\", exact=True)\\n\"\n  ]\n}","exit_code":0,"status":"completed"}}
