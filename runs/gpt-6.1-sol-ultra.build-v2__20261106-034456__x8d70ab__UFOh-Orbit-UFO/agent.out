d(w,[autopilot(w),autopilot(w,1)],1/120);game.advance(1/120);}const before=JSON.stringify(snapshotWorld(w));for(let i=0;i<40;i++)game.advance(1/120);assert.equal(JSON.stringify(snapshotWorld(w)),before);assert.deepEqual(game.errors,[]);assert.ok(time>0);game.dispose();});\n return{passed,failed:failures.length,failures};}\nEOF\ncat > tools/test.mjs <<'EOF'\nimport {spawnSync} from 'node:child_process';\nimport {writeFile,mkdir} from 'node:fs/promises';\nimport {runSimulationTests} from '../tests/simulation.mjs';\nimport {runHubTests} from '../tests/hub.mjs';\nimport {runFoundationTests} from '../tests/foundation.mjs';\nconst reports={};let passed=0,failed=0;const failures=[];\nfunction collect(name,r){reports[name]=r;passed+=r.passed||0;failed+=r.failed||0;for(const f of r.failures||[])failures.push(name+': '+f);}\nfor(const [name,fn] of [['simulation',runSimulationTests],['hub-unit',runHubTests],['foundation',runFoundationTests]]){try{collect(name,await fn());}catch(e){collect(name,{passed:0,failed:1,failures:[e.stack||e.message]});}}\nconst python='/home/micha/.local/share/pipx/venvs/playwright/bin/python';\nfor(const [name,file] of [['audio','tests/audio-browser.py'],['ui','tests/ui-browser.py'],['hub-browser','tests/hub-browser.py']]){const r=spawnSync(python,[file],{cwd:new URL('..',import.meta.url),encoding:'utf8',maxBuffer:15*1024*1024,timeout:240000});try{const lines=r.stdout.trim().split('\\\\n');const report=JSON.parse(lines.at(-1));collect(name,report);if(r.status\"'!==0&&!report.failed)throw Error(r.stderr||'\"'Test process failed');}catch(e){collect(name,{passed:0,failed:1,failures:[(r.stderr||r.stdout||e.message).slice(-6000)]});}}\nawait mkdir(new URL('../artifacts',import.meta.url),{recursive:true});await writeFile(new URL('../artifacts/test-report.json',import.meta.url),JSON.stringify({passed,failed,failures,reports},null,2));\nfor(const f of failures)console.error(f);console.log(\"'`${passed} passed, ${failed} failed`);if(failed)process.exitCode=1;\nEOF\nnode --input-type=module - <<'\"'JS'\nimport {runFoundationTests} from './tests/foundation.mjs';\nconst r=await runFoundationTests();for(const f of r.failures)console.error(f);console.log(r.passed+' passed, '+r.failed+' failed');\nJS\"","aggregated_output":"10 passed, 0 failed\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_52","type":"agent_message","text":"The official AI Hub harness passes normal, lossy, host-leave, dedicated-server, and one-player sessions. Audio checks also pass. I’m now checking controller and touch flows, score entry, attract cancellation, and busy combat readability before the final build.\n"}}
{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"git diff --stat -- . && ls -lh build/game.html artifacts && cat docs/network.md | head -65 && sed -n '305,348p' src/audio.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"git diff --stat -- . && ls -lh build/game.html artifacts && cat docs/network.md | head -65 && sed -n '305,348p' src/audio.js\"","aggregated_output":"-rw-r--r-- 1 micha micha 1.4M Nov  6 04:00 build/game.html\n\nartifacts:\ntotal 1.6M\n-rw-r--r-- 1 micha micha  34K Nov  6 03:57 arena-readable.png\n-rw-r--r-- 1 micha micha 1.3M Nov  6 03:53 audio-probe.html\n-rw-r--r-- 1 micha micha 4.3K Nov  6 03:53 audio-report.json\n-rw-r--r-- 1 micha micha  54K Nov  6 04:00 command-busy.png\n-rw-r--r-- 1 micha micha  33K Nov  6 04:00 first-contact.png\n-rw-r--r-- 1 micha micha  15K Nov  6 03:56 hub-browser-report.json\n-rw-r--r-- 1 micha micha  28K Nov  6 04:00 hub-gameplay-harness.html\n-rw-r--r-- 1 micha micha 5.0K Nov  6 03:56 hub-host-leave-3-snapshot.json\n-rw-r--r-- 1 micha micha 5.0K Nov  6 03:56 hub-latency-jitter-loss-2-snapshot.json\n-rw-r--r-- 1 micha micha 5.0K Nov  6 03:56 hub-normal-two-1-snapshot.json\n-rw-r--r-- 1 micha micha 4.6K Nov  6 03:56 hub-one-player-5-snapshot.json\n-rw-r--r-- 1 micha micha 5.1K Nov  6 03:56 hub-server-host-4-snapshot.json\n-rw-r--r-- 1 micha micha  32K Nov  6 03:56 play-first.png\n-rw-r--r-- 1 micha micha  94K Nov  6 03:55 title-first.png\n# Shared-world networking\n\nUFOh Orbit uses AI Hub Session Protocol v1 with the exact, unmodified released client 1.4.0 at revision `35a1047f2067b2af3de3943f0fe452f39105d869`. The client is the first script after the charset in the delivered HTML. `HubAdapter.connect()` calls `AIHub.connect({mode:'shared-world',seats:[1,2]})`, constructs the mission from the Hub seed, installs lifecycle handlers, and calls `ready()` once without a user gesture. A null connection chooses standalone. Session play skips the independent title, records and initials screens.\n\nOnly the authority calls the simulation. Its pilot array follows the Hub roster with stable indices. A dedicated server host has `localIndex=-1`; no phantom pilot is inserted. The same mission simulation runs, readies, sends snapshots and reports results without local input. Clock advancement and combat wait for the start event and `AIHub.time()>=0`.\n\nNonhosts send sequenced movement, aim and fire intent at 10 Hz, including neutral heartbeats. The host accepts intent only from current roster members, rejects old sequences, clamps numeric input, normalizes steering and expires held input after 0.5 seconds. A local overlay sends neutral intent while the world keeps running. The Create+Options reserved chord is handled by the controls layer.\n\nThe authority targets eight complete snapshots per second using reliable Hub delivery. Repeated actor dictionaries are packed as shared-key tables, floats are rounded to three decimals, and simulation-only content, replay and historical counters are omitted. Every gameplay actor and projectile is transmitted. Last 24 simulation events support local audio and visual cues; particles stay local. A snapshot includes the latest accepted sequence for each pilot. A very large snapshot is fragmented into bounded messages and assembled atomically; the previous complete state remains visible until all fragments arrive. Congestion lowers complete-snapshot frequency instead of deleting actors. The adapter sends at most 16 messages in any one-second window, reserving capacity below the client's 20/sec limit. Every message is measured in encoded bytes and stays below 16 KiB. Unicode is included in size calculations.\n\nNonhosts only accept world data from the current `AIHub.host`. Remote actors interpolate between the two latest authority frames. The local pilot predicts bounded movement and clockwise bead motion, reconciles toward the authority, and retains an exposed ring while fire is unacknowledged. Damage, collisions, score, fusion and encounter completion remain authority decisions. Predicted presentation is discarded when a new snapshot arrives.\n\nA departing nonhost is marked departed/down by the authority, its intent is cleared, and later packets are rejected. Remaining pilots continue; no host migration is attempted. Host departure is voided by the Hub. On victory, defeat or time-up, a reliable final snapshot is queued before exactly one `finish({standings:[remainingIds],scores,won})`. Time-up makes an unfinished mission a loss with its earned team score. Every remaining player ties. `end` clears queued traffic and local input; the game stops sound and leaves navigation to the Hub.\n\nNo extra sockets, matchmaking service, chat, names, dialogs or navigation are introduced. Hub names are rendered as text. Standalone couch co-op shares one simulation and does not open a network service.\n\n## Verification\n\n`tests/hub.mjs` exports `runHubTests()` for the single test coordinator. It checks automatic readiness, countdown gating, intent/membership/sequence validation, stale input, bidirectional neutral heartbeats, server authority, departure, time-up/final ordering, single finish, end silence, dense complete snapshots, Unicode size bounds and conservative predicted shield state.\n\n`tests/hub-browser.py` runs the original conformance harness against the actual generated HTML using a temporary localhost server bound to `127.0.0.1` on an OS-selected port. The server and browser are owned and closed by the script. Results and detailed failure evidence are written under `artifacts/`; normal stdout contains only its machine-readable summary for the coordinator. Cases include two players, 150 ms latency/50 ms jitter/5% loss, host departure, server hosting and the supported one-player path. The browser test also observes different viewport sizes and a resize through the authority debug API.\n\nRemaining limitations: browser emulation establishes the tested protocol and authority behavior, not real internet routing or subjective feel on physical controllers. Reliable Hub transport is the baseline; the game does not claim an independent unreliable transport.\n\t\tthis.elapsed += Math.max(0, Number.isFinite(dt) ? dt : 0);\n\t\tthis.handles = this.handles.filter((x) => x.until > this.elapsed);\n\t\tif (this.rechargeAt !== null && this.elapsed >= this.rechargeAt) {\n\t\t\tthis.rechargeAt = null;\n\t\t\tthis.cue(\"charge\");\n\t\t}\n\t\tif (this.subtitleUntil <= this.elapsed) this.subtitle = \"\";\n\t}\n\n\tpause(on = true) {\n\t\ton = !!on;\n\t\tif (on === this.paused) return;\n\t\tthis.paused = on;\n\t\tif (on) {\n\t\t\tthis.native.music(null);\n\t\t\tthis.cancelVoices();\n\t\t\tfor (const x of this.handles) x.handle.stop(0);\n\t\t\tthis.handles.length = 0;\n\t\t} else this.startSong();\n\t}\n\n\tcancelVoices() {\n\t\tfor (const src of this.voices) {\n\t\t\ttry {\n\t\t\t\tsrc.stop();\n\t\t\t} catch {}\n\t\t}\n\t\tthis.voices.clear();\n\t}\n\n\tstop() {\n\t\tthis.stopped = true;\n\t\tthis.native.music(null);\n\t\tthis.cancelVoices();\n\t\tfor (const x of this.handles) x.handle.stop(0);\n\t\tthis.handles.length = 0;\n\t\tthis.subtitle = \"\";\n\t\tthis.rechargeAt = null;\n\t}\n\n\tresetEvents() {\n\t\tthis.lastEvent = 0;\n\t\tthis.rechargeAt = null;\n\t\tthis.lastCue.clear();\n","exit_code":0,"status":"completed"}}
