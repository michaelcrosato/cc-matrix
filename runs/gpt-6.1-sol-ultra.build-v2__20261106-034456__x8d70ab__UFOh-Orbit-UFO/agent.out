{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"cat artifacts/test-report.json | head -22 && ls -l tests tools && cat tools/test.mjs | tail -55 && head -12 artifacts/hub-browser-report.json && head -8 artifacts/ui-report.json && rg -n 'Export input replay|DEFAULT_BALANCE' src/screens.js\"","aggregated_output":"{\n  \"passed\": 359,\n  \"failed\": 0,\n  \"failures\": [],\n  \"reports\": {\n    \"simulation\": {\n      \"passed\": 61,\n      \"failed\": 0,\n      \"failures\": [],\n      \"issues\": 4,\n      \"missionSummary\": {\n        \"seconds\": 415.39999999978653,\n        \"score\": 1086,\n        \"stats\": {\n          \"shots\": 202,\n          \"rams\": 1,\n          \"fusions\": 2,\n          \"kills\": 199,\n          \"chainKills\": 109,\n          \"gunships\": 13,\n          \"rescues\": 0,\n          \"hits\": 1,\ntests:\ntotal 112\ndrwxr-xr-x 2 micha micha  4096 Nov  6 04:07 __pycache__\n-rw-r--r-- 1 micha micha  7788 Nov  6 04:05 audio-browser.py\n-rw-r--r-- 1 micha micha  4893 Nov  6 04:01 foundation.mjs\n-rw-r--r-- 1 micha micha  6742 Nov  6 04:03 hub-browser.py\n-rw-r--r-- 1 micha micha 11521 Nov  6 04:03 hub-gameplay.py\n-rw-r--r-- 1 micha micha 10997 Nov  6 04:05 hub.mjs\n-rw-r--r-- 1 micha micha 18162 Nov  6 04:02 simulation.mjs\n-rw-r--r-- 1 micha micha 39453 Nov  6 04:05 ui-browser.py\n\ntools:\ntotal 8\n-rw-r--r-- 1 micha micha 2430 Nov  6 04:01 build.mjs\n-rw-r--r-- 1 micha micha 1853 Nov  6 04:01 test.mjs\nconst reports = {};\nlet passed = 0,\n\tfailed = 0;\nconst failures = [];\nfunction collect(name, r) {\n\treports[name] = r;\n\tpassed += r.passed || 0;\n\tfailed += r.failed || 0;\n\tfor (const f of r.failures || []) failures.push(name + \": \" + f);\n}\nfor (const [name, fn] of [\n\t[\"simulation\", runSimulationTests],\n\t[\"hub-unit\", runHubTests],\n\t[\"foundation\", runFoundationTests],\n]) {\n\ttry {\n\t\tcollect(name, await fn());\n\t} catch (e) {\n\t\tcollect(name, { passed: 0, failed: 1, failures: [e.stack || e.message] });\n\t}\n}\nconst python = \"/home/micha/.local/share/pipx/venvs/playwright/bin/python\";\nfor (const [name, file] of [\n\t[\"audio\", \"tests/audio-browser.py\"],\n\t[\"ui\", \"tests/ui-browser.py\"],\n\t[\"hub-browser\", \"tests/hub-browser.py\"],\n]) {\n\tconst r = spawnSync(python, [file], {\n\t\tcwd: new URL(\"..\", import.meta.url),\n\t\tencoding: \"utf8\",\n\t\tmaxBuffer: 15 * 1024 * 1024,\n\t\ttimeout: 240000,\n\t});\n\ttry {\n\t\tconst lines = r.stdout.trim().split(\"\\n\");\n\t\tconst report = JSON.parse(lines.at(-1));\n\t\tcollect(name, report);\n\t\tif (r.status !== 0 && !report.failed)\n\t\t\tthrow Error(r.stderr || \"Test process failed\");\n\t} catch (e) {\n\t\tcollect(name, {\n\t\t\tpassed: 0,\n\t\t\tfailed: 1,\n\t\t\tfailures: [(r.stderr || r.stdout || e.message).slice(-6000)],\n\t\t});\n\t}\n}\nawait mkdir(new URL(\"../artifacts\", import.meta.url), { recursive: true });\nawait writeFile(\n\tnew URL(\"../artifacts/test-report.json\", import.meta.url),\n\tJSON.stringify({ passed, failed, failures, reports }, null, 2),\n);\nfor (const f of failures) console.error(f);\nconsole.log(`${passed} passed, ${failed} failed`);\nif (failed) process.exitCode = 1;\n{\n  \"result\": {\n    \"passed\": 99,\n    \"failed\": 0,\n    \"failures\": []\n  },\n  \"cases\": [\n    {\n      \"case\": \"normal-two\",\n      \"done\": true,\n      \"pass\": true,\n      \"game\": \"../../build/game.html\",\n{\n  \"passed\": 136,\n  \"failed\": 0,\n  \"failures\": [],\n  \"notes\": [\n    \"firefox desktop browser smoke passed; emulation is not a real device test.\",\n    \"webkit desktop browser smoke passed; emulation is not a real device test.\"\n  ],\n462:\t\t\t\t\t\"Export input replay\",\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace('{ ease: \\\"outCubic\\\" });','{ ease: \\\"outCubic\\\", keep: true });');open(p,'w').write(s)\nPY\ncat > tests/final-browser.py <<'EOF'\n\\\"\\\"\\\"Exercise an isolated copy of the exact root delivery after its final build.\\\"\\\"\\\"\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parents[1]\n\ndef run():\n    identity = json.loads((ROOT / 'identity.json').read_text())\n    delivery = ROOT.parent / (identity['slug'] + '.html')\n    isolated = ROOT / 'artifacts/standalone/game.html'\n    isolated.parent.mkdir(exist_ok=True)\n    isolated.write_bytes(delivery.read_bytes())\n    passed = 0\n    failures = []\n    def check(ok, name):\n        nonlocal passed\n        if ok:\n            passed += 1\n        else:\n            failures.append(name)\n    interview = json.loads((ROOT.parent / 'exit-interview.json').read_text())\n    check(interview == json.loads((ROOT / 'src/data/interview.json').read_text()), 'Interview and bundled About data agree')\n    check([len(interview[k]) for k in ['testingFeedback','engineFeedback','promptFeedback']] == [4,6,4], 'Interview feedback question counts')\n    check(interview['sourceInformation']['usage'] == 'added on import', 'Usage exact import sentinel')\n    check(all(isinstance(v,str) and v for v in interview['sourceInformation'].values()), 'All source information values filled')\n    check(delivery.read_bytes() == (ROOT / 'build/game.html').read_bytes(), 'Final delivery byte-identical to tested build')\n    check(not any(s in delivery.read_text() for s in ['Verification in progress; final findings','TODO','FIXME']), 'Final build has no unfinished game markers')\n    with sync_playwright() as pw:\n        browser = pw.chromium.launch()\n        page = browser.new_page(viewport={'width':1920,'height':1080})\n        errors = []\n        requests = []\n        page.on('pageerror',lambda e:errors.append(str(e)))\n        page.on('request',lambda r:requests.append(r.url))\n        page.goto(isolated.as_uri())\n        page.wait_for_function(\\\"document.body.dataset.ready==='true'\\\")\n        check(page.title() == identity['title'], 'Isolated exported HTML boots with correct identity')\n        page.screenshot(path=str(ROOT / 'artifacts/title-final.png'))\n        page.get_by_role('button',name='About / Credits',exact=True).click()\n        check('Usage' in page.locator('#orbit-ui').inner_text() and 'added on import' in page.locator('#orbit-ui').inner_text(), 'Final in-game Source Information visible')\n        page.get_by_role('button',name='Next page',exact=True).click()\n        check('Seven defects' in page.locator('#orbit-ui').inner_text(), 'Final testing feedback embedded')\n        page.get_by_role('button',name='Next page',exact=True).click()\n        check('unmodified' in page.locator('#orbit-ui').inner_text(), 'Final engine feedback embedded')\n        page.get_by_role('button',name='Next page',exact=True).click()\n        check('Prioritize' in page.locator('#orbit-ui').inner_text(), 'Final prompt feedback embedded')\n        page.screenshot(path=str(ROOT / 'artifacts/credits-final.png'))\n        page.evaluate('__orbit.toTitle()')\n        page.wait_for_function(\\\"__game.sceneName==='title'\\\")\n        page.get_by_role('button',name='Start Mission',exact=True).click()\n        page.wait_for_function(\\\"__game.sceneName==='play'&&__orbit.world.time>1\\\")\n        check(page.evaluate('__orbit.present.titlePose.lift===1'), 'Native launch tween completes')\n        page.keyboard.down('d')\n        page.wait_for_timeout(150)\n        page.keyboard.up('d')\n        page.mouse.move(1190,380)\n        page.mouse.down()\n        page.wait_for_timeout(350)\n        page.mouse.up()\n        check(page.evaluate('__orbit.world.stats.shots>0&&__orbit.world.players[0].shield>0'), 'Exported artifact accepts movement/aim/fire and spends shield')\n        page.evaluate('__game.stop();__game.advance(3,{draw:true})')\n        page.screenshot(path=str(ROOT / 'artifacts/mission-final.png'))\n        check(not page.evaluate('__game.errors') and not errors, 'Final native/browser drawing has no errors')\n        check(all(url.startswith('file:') for url in requests) and len(requests)==1, 'Isolated copy needs no siblings, external requests or server')\n        browser.close()\n    result={'passed':passed,'failed':len(failures),'failures':failures}\n    (ROOT / 'artifacts/final-artifact-report.json').write_text(json.dumps(result,indent=2))\n    return result\n\nif __name__ == '__main__':\n    try:\n        result=run()\n    except Exception as exc:\n        result={'passed':0,'failed':1,'failures':['Final artifact: '+str(exc)]}\n    print(json.dumps(result))\n    raise SystemExit(1 if result['failed'] else 0)\nEOF\npython3 - <<'PY'\np='tools/test.mjs';s=open(p).read().replace('[\\\"hub-browser\\\", \\\"tests/hub-browser.py\\\"],','[\\\"hub-browser\\\", \\\"tests/hub-browser.py\\\"],\\\\n [\\\"final-artifact\\\", \\\"tests/final-browser.py\\\"],');open(p,'w').write(s)\nPY\nbiome format --write src/main.js tools/test.mjs > artifacts/biome-final.log\nruff check tests/final-browser.py > artifacts/ruff-final.log\nruff format tests/final-browser.py >> artifacts/ruff-final.log\nnode tools/build.mjs\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/final-browser.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
