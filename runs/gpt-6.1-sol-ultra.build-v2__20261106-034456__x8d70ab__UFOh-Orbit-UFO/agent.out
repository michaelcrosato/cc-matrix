 c=e.components.filter(c=>c.open) [... omitted end of long line]\n242:export function stepWorld(w,inputs=[],dt=1/120){\n249:  if(alive(w).length===0){w.deadTimer+=dt;if(w.deadTimer>=1.15){w.status='defeat';emit(w,'defeat',480,270,{score:w.score,text:'A FINE EXPLOSION. TRY AGAIN.'});}}else w.deadTimer=0;\n252:export function snapshotWorld(w){\n254:  return clone({...rest,events:w.events.slice(-40),stats:{...w.stats},boss:w.boss});\n257:export function commandWorld(w,command,args={}){\n280:export function autopilot(w,index=0){\nfunction nextWave(w){\n  if(w.mode==='score-attack'){w.waveStarted=false;w.transition=1.2;return;}\n  w.wave++;w.waveStarted=false;w.transition=1.1;\n  if(w.wave>=w.content.sectors[w.sector].waves.length){\n    w.stats.sectorTimes.push(w.time);w.sector++;w.wave=0;w.transition=3;\n    if(w.sector>=w.content.sectors.length){w.sector=w.content.sectors.length-1;startExtraction(w);return;}\n    if(w.content.sectors[w.sector].repair)for(const p of alive(w)){p.hull=Math.min(w.balance.hull,p.hull+w.balance.sectorRepair);p.shield=0;p.invuln=2;}\n    emit(w,'sector',480,270,{sector:w.sector,text:w.content.sectors[w.sector].subtitle});\n  }\n}\nfunction startExtraction(w){if(w.extraction)return;w.extraction={time:0,x:480,y:270};w.objective='COMMAND SILENCED · EXTRACTION CLEAR';w.bullets=[];w.gates=[];for(const e of w.enemies)if(e.type!=='boss')killEnemy(w,e,-1,null,0);emit(w,'extraction',480,270,{text:'SPACE IS SAFE. TEMPORARILY.'});}\nfunction encounterStep(w,dt){\n  if(w.extraction){w.extraction.time+=dt;if(w.extraction.time>=3){w.status='victory';emit(w,'victory',480,270,{score:w.score,text:'MISSION COMPLETE. NATURALLY.'});}return;}\n  if(w.transition>0){w.transition=Math.max(0,w.transition-dt);if(w.transition>0)return;}\n  if(!w.waveStarted)beginWave(w);\n  w.waveClock+=dt;\n  const enc=w.mode==='score-attack'?w.scoreEncounter:currentWave(w);if(!enc)return;\n  enc.spawns.forEach((sp,i)=>{if(!w.spawned.includes(i)&&w.waveClock>=sp.at){w.spawned.push(i);queueFormation(w,sp);}});\n  if(w.spawned.length===enc.spawns.length&&w.gates.length===0&&w.enemies.filter(e=>e.alive).length===0&&w.waveClock>1)nextWave(w);\n}\nfunction consumeShield(w,p,kind){p.shield=w.balance.shieldRecharge;p.grace=w.balance.contactGrace;emit(w,'shield-spent',p.x,p.y,{player:p.id,cause:kind});}\nfunction fire(w,p){\n  if(p.cooldown>0)return false;p.cooldown=w.balance.shotInterval;p.shield=w.balance.shieldRecharge;p.recoil=1;p.shots++;w.stats.shots++;w.tutorial.fired=true;\n  const c=Math.cos(p.angle),s=Math.sin(p.angle);w.bullets.push({id:id(w),x:p.x+c*30,y:p.y+s*30,px:p.x+c*30,py:p.y+s*30,vx:c*w.balance.bulletSpeed,vy:s*w.balance.bulletSpeed,r:4,life:w.balance.bulletLife,owner:p.id,hostile:false,alive:true});emit(w,'shot',p.x+c*28,p.y+s*28,{player:p.id,angle:p.angle});return true;\n}\nfunction movePilots(w,inputs,dt){\n  for(let i=0;i<w.players.length;i++){\n    const p=w.players[i],b=w.balance;p.cooldown=Math.max(0,p.cooldown-dt);p.invuln=Math.max(0,p.invuln-dt);p.grace=Math.max(0,p.grace-dt);p.recoil=Math.max(0,p.recoil-dt*8);p.damageFlash=Math.max(0,p.damageFlash-dt*4);\n    const previousShield=p.shield;p.shield=Math.max(0,p.shield-dt);if(previousShield>0&&p.shield===0){emit(w,'shield-ready',p.x,p.y,{player:p.id});w.tutorial.recharged=true;}\n    if(p.down||p.active===false){p.vx=0;p.vy=0;continue;}\n    const input=inputs[i]||neutral();let mx=Number.isFinite(input.mx)?clamp(input.mx,-1,1):0,my=Number.isFinite(input.my)?clamp(input.my,-1,1):0;\n    const magnitude=hypot(mx,my);if(magnitude>1){mx/=magnitude;my/=magnitude;}if(magnitude>.08)w.tutorial.moved=true;\n    let ax=input.ax,ay=input.ay;if(input.aim&&Number.isFinite(ax)&&Number.isFinite(ay)&&hypot(ax,ay)>.06)p.targetAngle=norm(Math.atan2(ay,ax));else if(magnitude>.08)p.targetAngle=norm(Math.atan2(my,mx));\n    const angleDiff=norm(p.targetAngle-p.angle);p.angle=norm(p.angle+Math.min(angleDiff,b.aimSpeed*dt));\n    const exposed=p.shield>0,speed=b.moveSpeed*(exposed?b.recoverySpeed:1),smooth=1-Math.exp(-b.acceleration*dt);\n    p.vx+=(mx*speed-p.vx)*smooth;p.vy+=(my*speed-p.vy)*smooth;p.x=clamp(p.x+p.vx*dt,p.r+5,ARENA.w-p.r-5);p.y=clamp(p.y+p.vy*dt,p.r+5,ARENA.h-p.r-5);\n    if(p.x<=p.r+5||p.x>=ARENA.w-p.r-5)p.vx=0;if(p.y<=p.r+5||p.y>=ARENA.h-p.r-5)p.vy=0;\n    if(input.fire)fire(w,p);else if(p.shield===0&&w.tutorial.fired&&magnitude>.1)w.tutorial.escaped=true;\n  }\n}\nfunction hostileShot(w,e,angle,speed=w.balance.hostileSpeed){\n  w.bullets.push({id:id(w),x:e.x+Math.cos(angle)*(e.r+8),y:e.y+Math.sin(angle)*(e.r+8),px:e.x,py:e.y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,r:6,life:5.5,owner:-1,hostile:true,alive:true});emit(w,'missile',e.x,e.y,{enemy:e.id});\n}\nfunction updateBoss(w,b,dt){\n  const bal=w.balance;b.phaseTime+=dt;b.phaseHitGrace=Math.max(0,b.phaseHitGrace-dt);b.x=480+Math.sin(b.age*.22)*(b.phase===3?110:55);b.y=176+Math.sin(b.age*.33)*25;b.angle=b.age*(b.phase===3?.19:.10);\n  const cycle=b.phaseTime%bal.bossAttackInterval;b.open=cycle>=1.6&&cycle<bal.bossAttackInterval-.55;\n  for(let i=0;i<b.components.length;i++){const c=b.components[i];c.angle=b.angle+i*TAU/3+(b.phase===2?Math.PI/3:0);c.x=b.x+Math.cos(c.angle)*82;c.y=b.y+Math.sin(c.angle)*65;c.open=b.open&&c.hp>0;}\n  b.attackTimer-=dt;\n  if(b.attackTimer<=0){b.attackTimer=bal.bossAttackInterval;emit(w,'boss-warning',b.x,b.y,{phase:b.phase});const p=nearestPilot(w,b);if(p){const a=Math.atan2(p.y-b.y,p.x-b.x);for(let i=0;i<3+b.phase;i++)hostileShot(w,b,a+(i-(2+b.phase)/2)*.17,bal.hostileSpeed*(b.phase===3?1.04:.9));}}\n  b.spawnTimer-=dt;\n  if(b.spawnTimer<=0){b.spawnTimer=b.phase===1?14:b.phase===2?16:19;const cx=b.x+Math.sin(b.age)*140,cy=b.y+85;if(b.phase===1)queueFormation(w,{at:0,formation:'line',type:'drifter',cx,cy,count:4,spacing:50,merge:false});else if(b.phase===2)queueFormation(w,{at:0,formation:'pincer',type:'hunter',cx:480,cy:100,count:2,spacing:260});else queueFormation(w,{at:0,formation:'lane',type:'gunship',cx:60,cy:410,count:1,spacing:0,angle:-.32});}\n}\nfunction enemiesStep(w,dt){\n  for(const g of w.gates)g.timer-=dt;\n  const due=w.gates.filter(g=>g.timer<=0);w.gates=w.gates.filter(g=>g.timer>0);for(const g of due)for(const spec of g.spawns)spawnEnemy(w,spec);\n  for(const e of w.enemies){\n    if(!e.alive)continue;e.age+=dt;e.arm=Math.max(0,e.arm-dt);\n    if(e.type==='boss'){updateBoss(w,e,dt);continue;}\n    if(e.mergeWith){const other=w.enemies.find(a=>a.id===e.mergeWith&&a.alive);if(!other){e.mergeWith=0;e.mergeTime=0;}else {e.mergeTime+=dt;const dx=other.x-e.x,dy=other.y-e.y;e.x+=dx*dt*.55;e.y+=dy*dt*.55;e.angle+=e.spin*dt;if(e.mergeTime>=w.balance.fusionTime&&e.id<other.id){e.alive=false;other.alive=false;const h=spawnEnemy(w,{type:'hunter',x:(e.x+other.x)/2,y:(e.y+other.y)/2});w.stats.fusions++;emit(w,'fusion',h.x,h.y,{enemy:h.id});}continue;}}\n    if(e.type==='drifter'){\n      e.angle+=e.spin*dt;let vx=Math.cos(e.id*2.3+w.seed*.1)*w.balance.drifterSpeed*e.speed,vy=Math.sin(e.id*1.7+w.seed*.2)*w.balance.drifterSpeed*e.speed;\n      if(e.x<35)vx=Math.abs(vx);if(e.x>925)vx=-Math.abs(vx);if(e.y<35)vy=Math.abs(vy);if(e.y>505)vy=-Math.abs(vy);\n      if(w.waveClock>20&&w.enemies.filter(a=>a.alive).length<3){const p=nearestPilot(w,e);if(p){const a=Math.atan2(p.y-e.y,p.x-e.x);vx=Math.cos(a)*Math.max(30,w.balance.drifterSpeed);vy=Math.sin(a)*Math.max(30,w.balance.drifterSpeed);}}\n      e.vx=vx;e.vy=vy;\n    }else if(e.type==='hunter'){\n      if(e.arm>0){e.vx=0;e.vy=0;continue;}const p=nearestPilot(w,e);if(p){const target=Math.atan2(p.y-e.y,p.x-e.x),turn=clamp(delta(e.angle,target),-w.balance.hunterTurn*dt,w.balance.hunterTurn*dt);e.angle=norm(e.angle+turn);}\n      e.vx=Math.cos(e.angle)*w.balance.hunterSpeed*e.speed;e.vy=Math.sin(e.angle)*w.balance.hunterSpeed*e.speed;\n    }else if(e.type==='gunship'){\n      if(e.warning>0){e.warning=Math.max(0,e.warning-dt);e.vx=e.vy=0;if(e.warning===0)e.fireTimer=.45;continue;}\n      e.vx=Math.cos(e.angle)*w.balance.gunshipSpeed;e.vy=Math.sin(e.angle)*w.balance.gunshipSpeed;e.fireTimer-=dt;\n      if(e.fireTimer<=0){e.fireTimer=w.balance.gunshipVolley;const p=nearestPilot(w,e);if(p){const a=Math.atan2(p.y-e.y,p.x-e.x);for(const off of [-.11,.11])hostileShot(w,e,a+off);}}\n      if((e.x<32&&e.vx<0)||(e.x>928&&e.vx>0)||(e.y<32&&e.vy<0)||(e.y>508&&e.vy>0)){e.angle=norm(e.angle+Math.PI);e.warning=w.balance.gunshipWarning;e.lane={x1:e.x,y1:e.y,x2:clamp(e.x+Math.cos(e.angle)*1000,0,960),y2:clamp(e.y+Math.sin(e.angle)*1000,0,540)};emit(w,'gunship-warning',e.x,e.y,{enemy:e.id,lane:e.lane});}\n    }\n    e.x=clamp(e.x+e.vx*dt,22,938);e.y=clamp(e.y+e.vy*dt,22,518);\n  }\n  const ds=w.enemies.filter(e=>e.alive&&e.type==='drifter'&&e.merge&&!e.mergeWith&&e.age>.85);\n  for(let i=0;i<ds.length;i++)for(let j=i+1;j<ds.length;j++){const a=ds[i],b=ds[j];if(a.mergeWith||b.mergeWith)continue;if(distance(a,b)<w.balance.fusionRadius){a.mergeWith=b.id;b.mergeWith=a.id;a.mergeTime=b.mergeTime=0;emit(w,'fusion-warning',(a.x+b.x)/2,(a.y+b.y)/2,{a:a.id,b:b.id});}}\n}\nfunction makeChain(w,owner){const c={id:id(w),owner,depth:0,count:0,points:0,x:0,y:0,last:w.time,victims:[]};w.chains.push(c);return c;}\nfunction killEnemy(w,e,owner,chain=null,depth=0){\n  if(!e||!e.alive||e.type==='boss')return false;\n    if(p.shield===0){consumeShield(w,p,'ram');p.rammed++;w.stats.rams++;w.tutorial.rammed=true;emit(w,'ram',e.x,e.y,{player:p.id,enemy:e.id});if(e.type==='boss'){const c=e.components.filter(c=>c.open).sort((a,b)=>distance(a,p)-distance(b,p))[0];if(c&&distance(c,p)<95)hitBoss(w,e,c,p.id,w.balance.ramDamage);const a=Math.atan2(p.y-e.y,p.x-e.x);p.x=clamp(e.x+Math.cos(a)*(e.r+p.r+10),22,938);p.y=clamp(e.y+Math.sin(a)*(e.r+p.r+10),22,518);}else killEnemy(w,e,p.id);}\n    else damagePilot(w,p,e);\n  }\n}\nfunction resolveBlasts(w,dt){\n  // Newly propagated blasts start next tick, producing a visible travelling cascade.\n  const existing=[...w.blasts];\n  for(const b of existing){b.age+=dt;if(b.age<0)continue;b.r=b.maxRadius*clamp(b.age/.16,0,1);const c=w.chains.find(c=>c.id===b.chain);if(!c)continue;\n    for(const e of w.enemies){if(!e.alive)continue;if(e.type==='boss'){for(const comp of e.components)if(distance(b,comp)<b.r+15)hitBoss(w,e,comp,c.owner,2,c);}else if(distance(b,e)<b.r+e.r)killEnemy(w,e,c.owner,c,b.depth+1);}\n  }\n  w.blasts=w.blasts.filter(b=>b.age<b.life);w.chains=w.chains.filter(c=>w.time-c.last<2);\n}\nexport function stepWorld(w,inputs=[],dt=1/120){\n  if(w.status!=='running')return w;if(!Number.isFinite(dt)||dt<=0)return w;\n  // Native engine supplies 1/120 steps. Splitting larger designer/test steps keeps\n  // the same collision contract and never skips shield/merge/telegraph windows.\n  if(dt>1/60+.000001){let remaining=dt;while(remaining>1e-9){const slice=Math.min(1/120,remaining);stepWorld(w,inputs,slice);remaining-=slice;if(w.status!=='running')break;}return w;}\n  w.time+=dt;w.tick++;movePilots(w,inputs,dt);encounterStep(w,dt);enemiesStep(w,dt);resolveBullets(w,dt);resolveContacts(w);resolveBlasts(w,dt);\n  w.enemies=w.enemies.filter(e=>e.alive);w.bullets=w.bullets.filter(s=>s.alive);if(w.boss&&!w.boss.alive)w.boss=null;\n  if(alive(w).length===0){w.deadTimer+=dt;if(w.deadTimer>=1.15){w.status='defeat';emit(w,'defeat',480,270,{score:w.score,text:'A FINE EXPLOSION. TRY AGAIN.'});}}else w.deadTimer=0;\n  return w;\n}\nexport function snapshotWorld(w){\n  const {content,history,scoreEncounter,...rest}=w;\n  return clone({...rest,events:w.events.slice(-40),stats:{...w.stats},boss:w.boss});\n}\nfunction restartEncounter(w){w.enemies=[];w.bullets=[];w.blasts=[];w.chains=[];w.gates=[];w.boss=null;w.waveClock=0;w.waveStarted=false;w.spawned=[];w.transition=.8;w.status='running';w.extraction=null;w.deadTimer=0;for(const p of w.players){p.down=false;p.hull=w.balance.hull;p.shield=0;p.invuln=1.5;p.x=480+(p===w.players[0]?-40:40);p.y=405;p.vx=p.vy=0;}}\nexport function commandWorld(w,command,args={}){\n  const data=typeof args==='number'?{value:args}:args||{};\n  if(command==='snapshot')return snapshotWorld(w);\n  if(command==='exportContent')return exportContent(w);\n  if(command==='importContent')return importContent(w,data.text??args);\n  w.debug=true;\n  if(command==='invuln'||command==='invulnerable'){w.invulnerable=data.value===undefined?!w.invulnerable:!!data.value;return w.invulnerable;}\n  if(command==='refill'){for(const p of w.players){p.down=false;p.hull=w.balance.hull;p.shield=0;p.invuln=1.5;}return true;}\n  if(command==='spawn'){const type=typeof args==='string'?args:data.type||'drifter';if(!ENEMY_DEFS[type])return false;const spec={type,cx:data.x??480,cy:data.y??170,count:clamp(data.count||1,1,24),spacing:data.spacing||55,formation:data.formation||'single',angle:data.angle,merge:data.merge};for(const p of pointsFor(spec))spawnEnemy(w,p);return true;}\n  if(command==='formation'){const sp={at:0,type:'drifter',cx:480,cy:200,count:8,spacing:57,formation:'cluster',...data};if(!FORMATIONS.includes(sp.formation)||!ENEMY_DEFS[sp.type])return false;queueFormation(w,sp);return true;}\n  if(command==='clear'){w.enemies=[];w.bullets=[];w.blasts=[];w.chains=[];w.gates=[];w.boss=null;return true;}\n  if(command==='sector'){w.sector=clamp(Math.round(data.value??data.sector??0),0,w.content.sectors.length-1);w.wave=clamp(Math.round(data.wave??0),0,w.content.sectors[w.sector].waves.length-1);restartEncounter(w);return true;}\n  if(command==='wave'||command==='encounter'){w.wave=clamp(Math.round(data.value??data.wave??0),0,w.content.sectors[w.sector].waves.length-1);restartEncounter(w);return true;}\n  if(command==='phase'){if(!w.boss)spawnEnemy(w,{type:'boss',x:480,y:170});w.boss.phase=clamp(Math.round(data.value??data.phase??1),1,3);initBossPhase(w,w.boss);return true;}\n  if(command==='restart'||command==='restartEncounter'){restartEncounter(w);return true;}\n  if(command==='resetSeed'){w.seed=(data.value??w.seed)>>>0;w._rng=seeded(w.seed);w.rngCalls=0;restartEncounter(w);return true;}\n  if(command==='balance'){w.balance=sanitizeBalance({...w.balance,...data});for(const p of w.players)p.shield=Math.min(p.shield,w.balance.shieldRecharge);if(w.boss){const cap=Math.max(2,Math.round(w.balance.bossHealth/9*(w.players.length===2?1.3:1)));for(const c of w.boss.components){c.maxHp=cap;c.hp=Math.min(c.hp,cap);}w.boss.maxHealth=cap*3;w.boss.health=w.boss.components.reduce((v,c)=>v+c.hp,0);}return true;}\n  if(command==='resetBalance'){w.balance={...DEFAULT_BALANCE};return true;}\n  if(command==='overlays'){w.overlays=data.value===undefined?!w.overlays:!!data.value;return true;}\n  if(command==='disconnect'){const p=pilot(w,data.index??data.value??1);if(p){p.active=false;p.down=true;p.hull=0;}return true;}\n  if(command==='step'){stepWorld(w,[],data.seconds||1/120);return true;}\n  return false;\n}\nexport function autopilot(w,index=0){\nexport const CONTENT_VERSION='orbit-mission-1.0';\nconst spawn=(at,formation,type,cx,cy,count=1,spacing=52,extra={})=>({at,formation,type,cx,cy,count,spacing,...extra});\nconst wave=(id,title,learning,spawns)=>({id,title,learning,spawns,complete:'clear',cleanup:'bounded',delay:1.1});\nexport const MISSION = {\n  version:CONTENT_VERSION,\n  sectors:[\n    {id:'launch',name:'01 · FIRST CONTACT',subtitle:'GOOD NEWS. YOUR SAUCER HAS A SHIELD.',palette:'cyan',repair:true,waves:[\n      wave('launch-bead','Flight clearance','Move. Point. Let the bead catch up.',[spawn(.8,'single','drifter',650,190,1,0,{merge:false,speed:.3}),spawn(5,'single','drifter',260,180,1,0,{merge:false,speed:.35})]),\n      wave('launch-ring','Safety inspection','A full ring can ram. Firing spends it.',[spawn(0,'line','drifter',480,205,4,100,{merge:false,speed:.45}),spawn(7,'single','hunter',800,320,1)]),\n      wave('launch-cascade','One small bang','Explosions invite their neighbours.',[spawn(0,'cluster','drifter',530,170,8,55,{merge:false}),spawn(8,'line','drifter',280,330,4,60,{merge:false})]),\n      wave('launch-escape','Clear the gantry','Stop firing. Recharge. Then show off.',[spawn(0,'cross','drifter',480,270,7,64),spawn(8,'pincer','hunter',480,200,2,270)])\n    ]},\n    {id:'field',name:'02 · THE DRIFTING FIELD',subtitle:'THE SATELLITES ARE MAKING FRIENDS.',palette:'amber',repair:true,waves:[\n      wave('field-fusion','A terrible friendship','Linked satellites become hunters.',[spawn(0,'fusion','drifter',670,140,2,30),spawn(3,'ring','drifter',310,245,6,66,{merge:false})]),\n      wave('field-braid','The golden braid','Lead the hunter into a cluster.',[spawn(0,'cluster','drifter',360,170,8,59),spawn(2,'pincer','hunter',480,320,2,250)]),\n      wave('field-orbit','Unhelpful company','A hunter turns. You turn faster.',[spawn(0,'ring','drifter',650,260,7,72,{merge:false}),spawn(4,'pincer','hunter',300,180,3,120)]),\n      wave('field-stair','Cascade staircase','Choose where the chain begins.',[spawn(0,'line','drifter',450,150,10,60,{angle:.3,merge:false}),spawn(5,'fusion','drifter',690,370,2,30)]),\n      wave('field-twins','Two bad ideas','Wait for a full ring. Then commit.',[spawn(0,'fusion','drifter',270,150,2,30),spawn(0,'fusion','drifter',700,150,2,30),spawn(3,'cluster','drifter',480,300,9,57,{merge:false})]),\n      wave('field-departure','No loitering','Clear the field. Keep your dignity.',[spawn(0,'cross','drifter',480,250,9,62),spawn(7,'pincer','hunter',480,130,4,170)])\n    ]},\n    {id:'signals',name:'03 · CROSSING SIGNALS',subtitle:'FAST CRAFT. VERY POOR MANNERS.',palette:'violet',repair:true,waves:[\n      wave('signals-first','Mind the line','A lane warning comes before missiles.',[spawn(0,'lane','gunship',70,90,1,0,{angle:.36}),spawn(3,'line','drifter',480,300,5,65,{merge:false})]),\n      wave('signals-cover','Borrowed cover','Enemy missiles break satellites too.',[spawn(0,'lane','gunship',870,120,1,0,{angle:2.76}),spawn(0,'cluster','drifter',500,270,9,57,{merge:false})]),\n      wave('signals-cross','Cross traffic','Shoot a gunship. Leave an escape.',[spawn(0,'lane','gunship',70,110,1,0,{angle:.34}),spawn(6,'lane','gunship',870,390,1,0,{angle:3.48}),spawn(3,'fusion','drifter',500,150,2,30)]),\n      wave('signals-rescue','Mutual insurance','Partner down? Touch them with a full ring.',[spawn(0,'ring','drifter',480,270,8,100,{merge:false}),spawn(2,'pincer','hunter',480,150,3,200),spawn(8,'lane','gunship',60,390,1,0,{angle:-.32})]),\n      wave('signals-slalom','Flying paperwork','A small gap is still a gap.',[spawn(0,'line','drifter',480,170,9,70,{angle:.12,merge:false}),spawn(0,'lane','gunship',70,400,1,0,{angle:-.4}),spawn(8,'pincer','hunter',480,140,3,180)]),\n      wave('signals-last','Permission to panic','Clear every signal. Command is next.',[spawn(0,'lane','gunship',70,120,1,0,{angle:.35}),spawn(4,'lane','gunship',890,400,1,0,{angle:3.5}),spawn(1,'cluster','drifter',480,260,10,57),spawn(8,'pincer','hunter',480,160,2,220)])\n    ]},\n    {id:'command',name:'04 · COMMAND PERFORMANCE',subtitle:'THE BIG ONE WOULD LIKE A WORD.',palette:'coral',repair:true,waves:[\n      wave('command-escort','Executive escort','The usual suspects. In management.',[spawn(0,'pincer','hunter',480,140,3,170),spawn(0,'ring','drifter',480,280,8,90,{merge:false}),spawn(5,'lane','gunship',80,120,1,0,{angle:.32})]),\n      wave('command-crown','Command performance','Hit the open emitters. Three phases. No excuses.',[spawn(0,'single','boss',480,170)])\n    ]}\n  ]\n};\nexport const SCORE_DECK=[\n  {formation:'ring',type:'drifter',count:8,spacing:92},\n  {formation:'fusion',type:'drifter',count:6,spacing:30},\n  {formation:'pincer',type:'hunter',count:3,spacing:160},\n  {formation:'lane',type:'gunship',count:2,spacing:170},\n  {formation:'cluster',type:'drifter',count:12,spacing:57}\n];\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\nimport {createWorld,stepWorld,snapshotWorld,commandWorld,autopilot,importContent,exportContent} from './simulation.js';\nimport {DEFAULT_BALANCE,BALANCE_SPECS} from './data/balance.js';\nimport {Presentation,fitArena} from './presentation.js';\nimport {Controls,INPUT,NEUTRAL} from './controls.js';\nimport {Records} from './storage.js';\nimport {Screens} from './screens.js';\nimport {OrbitAudio} from './audio.js';\nimport {HubAdapter} from './net/hub-adapter.js';\nconst E=globalThis.My3D2dge;\nconst app={world:null,attract:false,idle:0,attractTime:0,demoSector:-1,speed:1,recorded:false,ended:false,overrides:new Map(),resultDelay:0};\nconst game=new E.Game({canvas:'screen',id:'ufoh-orbit-v1',res:[768,432],expand:true,view:'overhead',views:['overhead'],input:INPUT,bg:'#071018',fullscreen:'button',autoPause:true,menu:{quit:'title',items:[['Restart flight',()=>{if(\"'!app.hub.active)app.startRun(app.world.mode,app.world.players.length,true);}],['\"'Dev Mode',()=>app.screens.dev()],['About / Credits',()=>app.screens.about(0)]],settings:[{key:'music',value:.10},{key:'glyphs',value:'playstation'},{key:'voiceVolume',label:'Dispatcher voice',group:'Sound',value:.55,min:0,max:1,step:.05}],controls:{fire:'Cannon (spends shield)',bomb:false}}});\napp.game=game;game.fadeTime=.16;game.cam.smooth=0;game.lights.enabled=true;game.lights.ambient=.78;\napp.records=new Records();app.present=new Presentation(game);app.audio=new OrbitAudio(game);\napp.applyAudio=()=>app.audio.setSettings({master:game.settings.volume,music:game.settings.music,sfx:game.settings.effects,voice:game.settings.voiceVolume,muted:\"'!game.settings.sound});app.applyAudio();\napp.controls=new Controls(game,{activity:()=>{app.idle=0;},isPlaying:()=>game.sceneName==='\"'play',isAttract:()=>app.attract,cancelAttract:()=>app.toTitle(),onUnlock:()=>{app.audio.unlock();app.applyAudio();}});\napp.startRun=(mode='mission',players=1,paired=false,attract=false)=>{if(app.hub.active)return;if(\"'!paired)app.controls.pairing('\"'solo');app.screens.ui.hide();game.resume();app.attract=attract;app.attractTime=0;app.demoSector=-1;app.ended=false;app.resultDelay=0;app.recorded=false;app.speed=1;app.overrides.clear();app.world=createWorld({mode,players,seed:7,attract});for(const s of BALANCE_SPECS)game.settings.set('dev_'+s.key,s.value);app.present.reset();app.audio.resetEvents();app.controls.clear();app.controls.blockUntil=game.real+.25;game.go('play',null,{fade:0});game.tween(app.present.titlePose,{lift:1},.8,{ease:'outCubic'});app.audio.setScene('mission');if(\"'!attract)app.audio.say('\"'GOOD NEWS. YOUR SAUCER HAS A SHIELD.');};\napp.toTitle=()=>{if(app.hub?.active)return;app.attract=false;app.idle=0;app.attractTime=0;app.world=null;app.ended=false;app.speed=1;app.overrides.clear();app.controls.clear();app.audio.stop();app.present.reset();app.screens.ui.hide();game.resume();game.go('title',null,{fade:0});};\napp.command=(name,args={})=>{if(app.hub?.active)return false;const out=commandWorld(app.world,name,args);if(['sector','phase','restart','resetSeed','clear'].includes(name)){app.present.reset();app.audio.resetEvents();}return out;};\napp.applyTuning=()=>{if(\"'!app.world||app.hub?.active||!app.world.debug)return;const balance={};for(const s of BALANCE_SPECS)balance[s.key]=game.settings['\"'dev_'+s.key];commandWorld(app.world,'balance',balance);};\napp.snapshot=()=>({title:'UFOh Orbit',scene:game.sceneName,screen:app.screens.ui.screen,attract:app.attract,idle:app.idle,world:app.world?snapshotWorld(app.world):null,hub:app.hub.snapshot(),audio:app.audio.debug(),device:game.input.lastDevice,players:game.players.length,presentation:{layout:app.present.layout},errors:game.errors});\napp.stepOnce=()=>{if(\"'!app.world||app.hub.active)return;app.applyTuning();stepWorld(app.world,[],1/120);app.present.update(1/120,app.world);};\napp.download=(name,value)=>{if(app.hub.active)return;const b=new Blob([typeof value==='\"'string'?value:JSON.stringify(value,null,2)],{type:'application/json'}),url=URL.createObjectURL(b),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),0);};\napp.exportContent=()=>app.download('orbit-content.json',exportContent(app.world));\napp.importContent=()=>{if(app.hub.active)return;const input=document.createElement('input');input.type='file';input.accept='.json,application/json';input.onchange=async()=>{try{const result=importContent(app.world,await input.files[0].text());app.screens.ui.toast(result.ok?'Content accepted':'Content rejected',result.ok?'The working deck is ready. Restart an encounter to preview.':result.errors.join('\\\\n'));}catch{app.screens.ui.toast('Content rejected','Unable to read this JSON. Working deck retained.');}};input.click();};\napp.hub=new HubAdapter({start({players,seed,server,isHost,localIndex}){game.o.live=true;game.o.autoPause=false;game.o.menu.quit=false;app.attract=false;app.world=createWorld({mode:'mission',players:players.length,seed});players.forEach((p,i)=>{app.world.players[i].hubId=p.id;app.world.players[i].name=p.name;});app.ended=false;app.screens.ui.hide();game.resume();game.go('play',null,{fade:0});app.present.reset();app.audio.resetEvents();app.audio.setScene('mission');},step(inputs,dt){stepWorld(app.world,inputs,dt);},getWorld:()=>app.world,getSnapshot:()=>snapshotWorld(app.world),applyWorld:w=>{app.world=w;},onEnd(){app.ended=true;app.controls.clear();app.audio.stop();},onLeave(index){if(app.world&&app.hub.isHost)commandWorld(app.world,'disconnect',{index});}});\napp.screens=new Screens(app);\n// Native shell handles pause/settings/rebindings and every controller screen.\nconst oldSettingsChange=game.settings.onChange;game.settings.onChange=(k,v)=>{oldSettingsChange?.(k,v);if(k.startsWith('dev_'))app.applyTuning();else app.applyAudio();};\naddEventListener('keydown',e=>{if(app.screens.typeName(e)){e.preventDefault();e.stopImmediatePropagation();}},{capture:true,signal:game._abort?.signal});\nconst scenes={\n title:{view:'overhead',views:['overhead'],camera:{zoom:false},enter(){app.attract=false;app.idle=0;app.present.reset();app.screens.title();app.audio.setScene('title');document.body.dataset.scene='title';},update(dt){app.present.time+=dt;app.idle+=dt;if(app.screens.ui.screen==='title'&&app.idle>=10&&\"'!app.hub.active)app.startRun('\"'mission',1,false,true);},draw:r=>app.present.title(r),back(){return true;}},\n play:{view:'overhead',views:['overhead'],pausable:true,camera:{zoom:false},touch:[],enter(){document.body.dataset.scene='play';app.present.update(0,app.world);},update(dt){if(\"'!app.world)return;if(app.hub.active){const idx=Math.max(0,app.hub.localIndex);const local=app.overrides.get(idx)||app.controls.intent(app.world,idx);app.hub.tick(dt,local,{paused:!!app.screens.ui.screen||game.paused});}else if(app.attract){app.attractTime+=dt;const sector=Math.min(3,Math.floor(app.attractTime/18));if(sector!==app.demoSector){app.demoSector=sector;commandWorld(app.world,'\"'sector',{value:sector});app.world.debug=false;app.world.invulnerable=true;if(sector===3)commandWorld(app.world,'phase',{value:2});}stepWorld(app.world,app.world.players.map((_,i)=>autopilot(app.world,i)),dt*1.4);if(app.attractTime>=76)app.startRun('mission',1,false,true);}else if(app.world.status==='running'){app.applyTuning();const input=app.world.players.map((_,i)=>app.overrides.get(i)||app.controls.intent(app.world,i));stepWorld(app.world,input,dt*app.speed);}\n app.present.update(dt,app.world);app.audio.handle(app.world.events);app.audio.setScene(app.world.boss?'boss':'mission');\n if(\"'!app.hub.active&&!app.attract&&app.world.status!=='\"'running'){app.resultDelay+=dt;if(app.resultDelay>1.2&&\"'!app.ended){app.ended=true;app.audio.setScene(app.world.status);game.go('\"'results',null,{fade:'iris',seconds:.45});}}\n },draw(r){if(app.world)app.present.world(r,app.world,{attract:app.attract,hub:app.h