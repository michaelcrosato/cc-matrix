.server\nimport importlib.util\nimport json\nimport os\nimport threading\nimport traceback\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\nBASE = Path(__file__).resolve().parents[1]\nARTIFACTS = BASE / 'artifacts'\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\ndef run():\n    result = {'passed': 0, 'failed': 0, 'failures': []}\n    reports = []\n    ARTIFACTS.mkdir(exist_ok=True)\n    if not (BASE / 'build/game.html').is_file():\n        return {'passed': 0, 'failed': 1, 'failures': ['Hub browser: build/game.html missing']}\n    handler = functools.partial(QuietHandler, directory=str(BASE))\n    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\n    worker = threading.Thread(target=server.serve_forever, daemon=True)\n    worker.start()\n    origin = f'http://127.0.0.1:{server.server_port}'\n    try:\n        with sync_playwright() as p:\n            browser = p.chromium.launch(headless=True)\n            context = browser.new_context(viewport={'width': 1440, 'height': 900})\n            page = context.new_page()\n            cases = [\n                ('normal-two', {'players': 2}),\n                ('latency-jitter-loss', {'players': 2, 'latency': 150, 'jitter': 50, 'loss': 5}),\n                ('host-leave', {'players': 2, 'scenario': 'host-leave'}),\n                ('server-host', {'players': 2, 'scenario': 'server'}),\n                ('one-player', {'players': 1}),\n            ]\n            if os.environ.get('ORBIT_HUB_GAMEPLAY_ONLY') == '1':\n                cases = []\n            for name, options in cases:\n                errors = []\n                error_listener = lambda error: errors.append(str(error))\n                page.on('pageerror', error_listener)\n                try:\n                    query = {'game': '../../build/game.html', 'auto': 1, 'play': 1600, 'seed': 7, 'limit': 30, **options}\n                    page.goto(origin + '/vendor/hub/harness.html?' + urlencode(query), wait_until='load')\n                    page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=50000)\n                    report = page.evaluate('window.__hubCheck')\n                    reports.append({'case': name, **report})\n                    for check in report['checks']:\n                        if check['pass']:\n                            result['passed'] += 1\n                        else:\n                            result['failed'] += 1\n                            result['failures'].append(f\"Hub {name}: {check['name']}: {check.get('detail', '')}\")\n                    if errors:\n                        result['failed'] += 1\n                        result['failures'].append(f'Hub {name}: browser errors: {errors}')\n                    else:\n                        result['passed'] += 1\n                    frames = [f for f in page.frames if '/build/game.html' in f.url]\n                    for frame in frames:\n                        inspect = frame.evaluate(\"\"\"() => {\n                          const game=window.__game;\n                          const data=game?.debug?.snapshot?.();\n                          return {title:document.title,client:window.AIHub?.version,errors:game?.errors||[],data};\n                        }\"\"\")\n                        if inspect['client'] != '1.4.0' or 'UFOh Orbit' not in inspect['title'] or inspect['errors']:\n                            result['failed'] += 1\n                            result['failures'].append(f'Hub {name}: exact artifact identity/client/draw errors: {inspect}')\n                        else:\n                            result['passed'] += 1\n                        (ARTIFACTS / f'hub-{name}-{len(reports)}-snapshot.json').write_text(json.dumps(inspect, indent=2))\n                except Exception:\n                    result['failed'] += 1\n                    result['failures'].append(f'Hub {name}: {traceback.format_exc()}')\n                finally:\n                    page.remove_listener('pageerror', error_listener)\n            try:\n                spec = importlib.util.spec_from_file_location('hub_gameplay', BASE / 'tests/hub-gameplay.py')\n                module = importlib.util.module_from_spec(spec)\n                spec.loader.exec_module(module)\n                extra = module.gameplay(page, origin, BASE)\n                result['passed'] += extra['passed']\n                result['failed'] += extra['failed']\n                result['failures'].extend(extra['failures'])\n            except Exception:\n                result['failed'] += 1\n                result['failures'].append('Hub two-page gameplay: ' + traceback.format_exc())\n                if not (ARTIFACTS / 'hub-gameplay-report.json').is_file():\n25:def run():\n26:    result = {'passed': 0, 'failed': 0, 'failures': []}\n30:        return {'passed': 0, 'failed': 1, 'failures': ['Hub browser: build/game.html missing']}\n48:            if os.environ.get('ORBIT_HUB_GAMEPLAY_ONLY') == '1':\n62:                            result['passed'] += 1\n70:                        result['passed'] += 1\n82:                            result['passed'] += 1\n90:                spec = importlib.util.spec_from_file_location('hub_gameplay', BASE / 'tests/hub-gameplay.py')\n93:                extra = module.gameplay(page, origin, BASE)\n94:                result['passed'] += extra['passed']\n99:                result['failures'].append('Hub two-page gameplay: ' + traceback.format_exc())\n100:                if not (ARTIFACTS / 'hub-gameplay-report.json').is_file():\n108:                    (ARTIFACTS / 'hub-gameplay-failure.json').write_text(json.dumps(snapshots, indent=2))\n","exit_code":0,"status":"completed"}}
