{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"rg -n 'advance\\\\(seconds|advance\\\\(' vendor/engine/my-3d2dge.js | head -10 && sed -n '2820,2850p' vendor/engine/my-3d2dge.js && sed -n '2024,2055p' vendor/engine/my-3d2dge.js\"","aggregated_output":"59: * 11. TESTS. new E.Game({ headless: true }) (the default in Node) runs with no screen: game.advance(1) runs 120 fixed\n2319:   *   scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\n2321:   * - loop: false makes a game in a page that runs only by advance()\n2713:   * by advance().\n2838:   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\n2842:  advance(seconds = this.o.step, o = {}) {\n2843:    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n10870:pc.act('pickup', 'key'); game.advance(8);\n11451:for (let s = 0; s < 300 && m.phase !== 'over'; s++) game.advance(1);\n13162:  game.advance(1 / 120); const s = game.audio.pos.step;\n  /**\n   * end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window,\n   * the document, the canvas and the buttons, the touch controls, the GPU lighting's canvas) and close the sound. Tests and\n   * tools that make many games call it; the canvas stays\n   */\n  dispose() {\n    /** disposed: true after dispose() */\n    this.stop(); this.disposed = true;\n    if (this._abort) this._abort.abort();\n    if (this.shell) this.shell.dispose();\n    const A = this.audio; try { A.stopMusic(); if (A.ctx && A.ctx.close) A.ctx.close(); } catch (e) { /* already closed */ } A.ctx = null; A.failed = 'the game was disposed';\n    const I = this.input; I.stopRumble(); for (const el of [I._touchEl, I._stickEl, I._knobEl, this._corner]) if (el && el.remove) el.remove();\n    this._corner = null;\n    const G = this.gpu; if (G) { try { if (G._cv) G._cv.remove(); if (G._dev && G._dev.destroy) G._dev.destroy(); } catch (e) { /* gone */ } G.enabled = G.ready = false; this.gpu = null; }\n    if (E.current === this) E.current = null;\n  }\n  /**\n   * run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and\n   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\n   * with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test\n   * that catches what a player would see break). Returns the updates run\n   */\n  advance(seconds = this.o.step, o = {}) {\n    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n    this._acc += Math.max(0, seconds);\n    const n = this._steps(); this.stats.steps = n;\n    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n    return n;\n  }\n  /**\n   * the clock: an exact fixed step. Real time (at most 50 ms a frame, so a stall can't run away) fills an accumulator;\n  actor(x, y, z, drawFn, o = {}) {\n    if (o.wrap) { const [ww, wh] = Array.isArray(o.wrap) ? o.wrap : [o.wrap, 0], q = Object.assign({}, o, { wrap: null }); for (const i of [-1, 0, 1]) for (const j of wh ? [-1, 0, 1] : [0]) this.actor(x + i * ww, y + j * wh, z, drawFn, q); return; }\n    const st = this.game.stats;\n    if (!this.visible(x, y, z, o.margin || 60)) { st.culled++; return; }\n    st.actors++;\n    // fast path: nothing needs the offscreen composite, so draw straight into the frame\n    if (o.outline === false && !o.flash && !o.ghost && !o.xray && (o.rim === false || this.gpu) && (o.alpha === undefined || o.alpha >= 1)) {\n      const info = o.emissive ? gI => { gI._mat = this._infoCol(z, 10, o.emissive); gI._c = null; const [a, b] = this.w(x, y, z); drawFn(gI, Math.round(a), Math.round(b)); } : undefined;\n      this.queue(x, y, z, g => { const [a, b] = this.w(x, y, z); drawFn(g, Math.round(a), Math.round(b)); }, { bias: o.bias, info, solid: true, actor: true, hides: o.hides, pick: o.pick });\n      return;\n    }\n    this.queue(x, y, z, g => this._composite(g, x, y, z, drawFn, o), { bias: o.bias, xray: o.xray, info: gI => this._actorInfo(gI, x, y, z, o), solid: o.alpha === undefined || o.alpha > .5, actor: !o.xray, hides: o.hides, top: o.top, pick: o.pick });\n  }\n  /** draw an actor at once, over what is drawn so far, not sorted by depth (a pass of the game's own: a body falling into\n   *  a void painted over the level), with r.actor's options (outline, flash, alpha, ...) */\n  actorNow(x, y, z, drawFn, o = {}) { this._composite(this.ctx, x, y, z, drawFn, o); }\n  _tint(dst, src, color, R = [0, 0, AS, AS]) {\n    const [x0, y0, w, h] = R;\n    dst.globalCompositeOperation = 'source-over'; dst.clearRect(x0, y0, w, h); dst.drawImage(src, x0, y0, w, h, x0, y0, w, h);\n    dst.globalCompositeOperation = 'source-in'; dst.fillStyle = color; dst._c = null; dst.fillRect(x0, y0, w, h);\n    dst.globalCompositeOperation = 'source-over';\n  }\n  _composite(g, x, y, z, drawFn, o) {\n    const keep = o.every > 1 && o.key && g === this.ctx && !this.gpu && !o.flash && !o.ghost && !o.xray ? this._kept || (this._kept = new WeakMap()) : null;\n    let K = keep && keep.get(o.key);\n    if (K && this._frameNo - K.n < o.every) {   // its kept image, where it stands now\n      const [sx, sy] = this.w(x, y, z); g.globalAlpha = o.alpha === undefined ? 1 : o.alpha;\n      const X = Math.round(sx) - AOX + K.x0, Y = Math.round(sy) - AOY + K.y0; g.drawImage(K.cv, 0, 0, K.w, K.h, X, Y, K.w, K.h); g.globalAlpha = 1; this._comp = null; if (g === this.ctx) this._pk = [X + 1, Y + 1, X + K.w - 1, Y + K.h - 1]; return;   // (its pick box the redrawn one's: the kept image has a pixel of margin)\n    }\n    const aG = this._aG, bb = this._bb