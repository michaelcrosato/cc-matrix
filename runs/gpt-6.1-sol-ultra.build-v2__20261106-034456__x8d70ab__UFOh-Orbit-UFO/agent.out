itle action\",\n                )\n                initial = page.evaluate(\"__orbit.world.players[0].x\")\n                page.keyboard.down(\"d\")\n                step(page, 0.5)\n                check(\n                    page.evaluate(\"__orbit.world.balance.shieldRecharge\") > before,\n                    \"Controller adjusts live tuning slider\",\n                )\n                tap_pad(page, 1)\n                tap_pad(page, 1)\n                pad_focus(page, \"About / Credits\")\n                tap_pad(page, 0)\n                check(screen(page) == \"about\", \"Controller reaches About from pause\")\n                pad_focus(page, \"Next page\")\n                tap_pad(page, 0)\n                check(\n                    \"Testing Feedback\" in page.locator(\"#orbit-ui\").inner_text(),\n                    \"Controller turns credits pages\",\n                )\n                tap_pad(page, 1)\n                pad_focus(page, \"Resume\")\n                tap_pad(page, 0)\n        page.goto(isolated.as_uri())\n        page.wait_for_function(\"document.body.dataset.ready==='true'\")\n        check(\n            page.title() == identity[\"title\"],\n            \"Isolated exported HTML boots with correct identity\",\n        )\n        page.screenshot(path=str(ROOT / \"artifacts/title-final.png\"))\n        page.get_by_role(\"button\", name=\"About / Credits\", exact=True).click()\n        check(\n            \"usage\" in page.locator(\"#orbit-ui\").inner_text().lower()\n            and \"added on import\" in page.locator(\"#orbit-ui\").inner_text(),\n            \"Final in-game Source Information visible\",\n        )\n        page.get_by_role(\"button\", name=\"Next page\", exact=True).click()\n        check(\n            \"Seven defects\" in page.locator(\"#orbit-ui\").inner_text(),\n            \"Final testing feedback embedded\",\n        )\n        page.get_by_role(\"button\", name=\"Next page\", exact=True).click()\n        check(\n          