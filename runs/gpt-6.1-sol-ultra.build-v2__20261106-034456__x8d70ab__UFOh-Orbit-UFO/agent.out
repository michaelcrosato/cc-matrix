.hub.active?app.hub:null});},back(){game.pause();return true;}},\n results:{view:'overhead',camera:{zoom:false},enter(){document.body.dataset.scene='results';app.screens.results();},update(dt){app.present.time+=dt;},draw(r){if(app.world)app.present.world(r,app.world);},back(){app.toTitle();return true;}}\n};\ngame.hook('input',()=>{app.controls.padActivity();});\ngame.hook('step',dt=>{app.audio.pause(game.paused&&\"'!app.hub.active);app.audio.tick(dt);const root=app.screens.ui.root;if(root){root.dataset.screen=app.screens.ui.screen||'\"'play';document.body.dataset.input=game.input.lastDevice;}\n if(game.sceneName==='play'&&\"'!app.screens.ui.screen&&!app.attract&&app.world){const hint=document.getElementById('\"'controls-hint');if(hint){hint.textContent=app.controls.prompt();hint.hidden=game.input.lastDevice==='touch';}}else{const hint=document.getElementById('controls-hint');if(hint)hint.hidden=true;}\n});\ngame.debug={snapshot:app.snapshot,world:()=>app.world,rawWorld:()=>app.world,hub:app.hub,input(index,intent){if(intent===null)app.overrides.delete(index);else app.overrides.set(index,{...NEUTRAL,...intent});},start:(mode,players=1)=>app.startRun(mode,players),command:app.command,autopilot:index=>autopilot(app.world,index),advance:seconds=>game.advance(seconds),showAbout:p=>app.screens.about(p),idle:seconds=>{app.idle=seconds;},settings:game.settings,exportContent:()=>exportContent(app.world),importContent:text=>importContent(app.world,text),records:app.records,app};\nglobalThis.__game=game;globalThis.__orbit=app;\ngame.start({scenes,scene:'title',boot:false});\nawait app.hub.connect();\ndocument.body.dataset.ready='true';\nEOF\ncat > style.css <<'EOF'\n:root{color-scheme:dark;background:#071018}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;touch-action:none;overscroll-behavior:none}body{font-family:\\\"Courier New\\\",monospace}#screen{display:block;width:100%;height:100%;image-rendering:pixelated;touch-action:none}#controls-hint{position:fixed;bottom:5px;left:0;width:100%;text-align:center;color:#78949b;pointer-events:none;font-size:clamp(9px,.85vw,16px);letter-spacing:.09em}#controls-hint[hidden]{display:none}.esh{--pt:32px\"'!important;--pl:6.5vw!important;--pr:32px!important;--pb:28px!important;font-size:clamp(16px,1.3vw,24px)!important}.esh .esh-sh{background:#040c1388;backdrop-filter:blur(3px)}.esh .esh-ttl{background:transparent;backdrop-filter:none;align-items:center;justify-content:flex-start;padding-left:7vw}.esh .esh-ttl>div{max-width:43vw;width:640px;text-align:left}.esh .esh-ttl h1{font-size:clamp(66px,7.5vw,158px);line-height:.82;letter-spacing:-.06em;white-space:pre-line;color:#f0ecdc;text-shadow:0 5px 0 #26444a;margin:19px 0 30px;text-transform:uppercase}.esh .esh-k{font-size:clamp(11px,.85vw,16px);letter-spacing:.19em;color:#96e3ce}.esh .esh-sub{color:#dfd6b9;font-size:clamp(15px,1.4vw,24px);margin-bottom:26px}.esh .esh-ttl .esh-btns{display:flex;flex-direction:column;align-items:flex-start;gap:7px;width:min(390px,95%)}.esh button{font-family:inherit!important;font-size:clamp(15px,1.3vw,24px)!important;min-height:46px;border-radius:0!important;letter-spacing:.02em;background:#10232c!important;border:1px solid #3d5960!important;color:#d9e3dc!important;padding:12px 22px!important;cursor:pointer}.esh .esh-ttl button{width:100%;text-align:left;min-height:50px}.esh button:hover,.esh button:focus-visible,.esh button:focus{outline:2px solid #9aefd7!important;outline-offset:3px;color:#f8f3dd!important;background:#1e4146!important}.esh button.pri{background:#b4e7cc!important;color:#122a31!important;border-color:#c0edcf!important;font-weight:bold}.esh .esh-tags{justify-content:flex-start;gap:12px;margin-top:25px;font-size:11px}.esh .esh-tags span{border-color:#435a5d!important;border-radius:0!important;padding:5px 8px!important}.esh .esh-ttl .esh-m{margin-top:17px;font-size:12px;color:#8aabab}.esh .esh-pan{border-radius:1px!important;background:#10212bf5!important;border:1px solid