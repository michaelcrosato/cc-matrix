{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"rg -n 'class View|constructor\\\\(id, label' UFOh-Orbit-UFO-gpt-6.1-sol-ultra-20261106-034456/vendor/engine/my-3d2dge.js && sed -n '1740,1790p' UFOh-Orbit-UFO-gpt-6.1-sol-ultra-20261106-034456/vendor/engine/my-3d2dge.js && sed -n '2453,2492p' UFOh-Orbit-UFO-gpt-6.1-sol-ultra-20261106-034456/vendor/engine/my-3d2dge.js\"","aggregated_output":"558:class View {\n561:  constructor(id, label, yaw, pitch, scale = 1, zBoost = 1) { this.id = id; this.label = label; this.set(yaw, pitch, scale, zBoost); }\n    sc._begin(cx, cy, this.game.o.bg, vp); this._vp = vp || null;\n    if (vp) { const g = this.ctx; g.save(); g.beginPath(); g.rect(vp.x, vp.y, vp.w, vp.h); g.clip(); }   // (a viewport: the scene drawn inside it, the floor too)\n    /** ix, iy: the camera's whole-pixel offset this frame (a world point is at r.w(x, y, z) on the buffer) */\n    this.ix = sc.ix; this.iy = sc.iy; this._items.length = 0; this._decals.length = 0; this._overlays.length = 0; this._map = null; (this._emis || (this._emis = [])).length = 0;\n    const st = this.game.stats; st.actors = 0; st.culled = 0;\n    if (this._xCv.width !== this.bw || this._xCv.height !== this.bh) { this._xCv.width = this._xoCv.width = this._oCv.width = this._eCv.width = this._sCv.width = this.bw; this._xCv.height = this._xoCv.height = this._oCv.height = this._eCv.height = this._sCv.height = this.bh; }\n    this._xrayUsed = false; this._xrayOl = false; this._emOn = false;\n    const gpu = this.game.gpu;\n    this.gpu = !!(gpu && gpu.active(this.view)) && !this.game._split;   // (no GPU lighting on a split screen)\n    if (gpu) gpu._show(this.gpu);\n    if (this.gpu) {\n      if (this._iCv.width !== this.bw || this._iCv.height !== this.bh) { this._iCv.width = this._vCv.width = this.bw; this._iCv.height = this._vCv.height = this.bh; }\n      const iG = this._iG; iG.globalCompositeOperation = 'source-over'; iG.globalAlpha = 1; iG.fillStyle = '#000'; iG.fillRect(0, 0, this.bw, this.bh); iG._c = null; iG._mat = '#000';\n      this._vG.clearRect(0, 0, this.bw, this.bh); this._vG._c = null;\n    }\n  }\n  /** world -> buffer pixel coords */\n  w(x, y, z = 0) { const v = this.game.view; return [v.ax * x + v.ay * y - this.ix, v.bx * x + v.by * y + v.bz * z - this.iy]; }\n  /** queue a depth-sorted draw. fn(g) draws into g. opts: {bias, occluder, hides, xray, emissive, solid (hides a glow behind it), footprint,\n   *  box, top} occluder: a wall (x-ray silhouettes show through it, it sorts as a block). hides: only lets x-ray silhouettes show\n   *  through it (props, sprites, bodies), nothing else changes. box: [x0, y0, x1, y1], what it covers in buffer pixels:\n   *  an occluder joins the x-ray only where its box meets a silhouette (without one, a 48 x 140 box round its foot: give\n   *  a long wall its box, or queue it with queueSpan); top: its top's height (one under the knees hides nothing). It\n   *  sorts by its one point (x, y, z): a long thing that other things stand along sorts wrong somewhere: queueSpan */\n  queue(x, y, z, fn, o) {\n    let k = this.game.view.order(x, y, z) + (o && o.bias || 0);\n    // things standing on top of a TileMap wall block must sort after that block; a footprint ([x0, y0, x1, y1], world units)\n    // lifts a big thing over every block under its base (a canopy over a tower's top, a cart across two cells)\n    if (z > .5 && this._map && !(o && o.occluder)) {\n      const f = o && o.footprint, M = this._map, T = M.T;\n      if (f) { for (let cy = Math.floor(f[1] / T); cy <= Math.floor((f[3] - .01) / T); cy++) for (let cx = Math.floor(f[0] / T); cx <= Math.floor((f[2] - .01) / T); cx++) k = M._liftOrder(this.game.view, (cx + .5) * T, (cy + .5) * T, z, k); }\n      else k = M._liftOrder(this.game.view, x, y, z, k);\n      if (M.solids && M.solids.length) k = M._liftSolids(this.game.view, x, y, z, k);\n    }\n    const it = { k, fn, occ: o && o.occluder, hides: o && o.hides, top: o && o.top, box: o && o.box, actor: o && o.actor, xray: o && o.xray, x, y, z, info: o && o.info, noInfo: o && o.noInfo, em: !!(o && o.emissive), solid: !!(o && (o.solid || o.occluder)), pick: o ? o.pick : undefined, pb: o && o._pb };\n    this._items.push(it);\n    if (it.em) this._emis.push(it);   // glowing things: canvas lighting leaves them out of the darkness (see flush)\n  }\n  /** draw on the floor before the queue. opts.emissive (0..1) makes it glow under GPU lighting */\n  decal(fn, o) { this._decals.push({ fn, e: o && o.emissive || 0 }); }\n  /** draw fn(g) on top of everything, in screen pixels (HUD, dialog, menus) */\n  overlay(fn) { this._overlays.push(fn); }\n  /** what was drawn under a screen point (the HUD's pixels: input.clicked(), input.pointer()) in the last frame, front to\n   *  back: the pick values of the actors, sprites, props and queued draws given one (r.actor(x, y, z, fn, { pick: unit })),\n   *  each where its pixels went (an actor's drawn bounds; others' box, or a body's size round its point). [] for none */\n  pick(sx, sy) { const P = this._picked || [], out = []; for (let i = P.length - 1; i >= 0; i--) { const [v, b] = P[i]; if (sx >= b[0] && sx < b[2] && sy >= b[1] && sy < b[3] && !out.includes(v)) out.push(v); } return out; }\n  // ground helpers (all dithered, correct in every view)\n  /** n screen points round a circle of radius rad on the ground at (x, y), height z: the outline of a ring or a fan */\n  groundPts(x, y, rad, n = 18, z = 0) { const pts = []; for (let i = 0; i < n; i++) { const a = i / n * TAU; pts.push(this.w(x + Math.cos(a) * rad, y + Math.sin(a) * rad, z)); } return pts; }\n  /** a dithered disc lying on the ground (radius in world units, z its height): shadows, auras, area attacks */\n  groundDisc(x, y, rad, color, alpha = 1, z = 0) { px.polyDither(this.tgt, this.groundPts(x, y, rad, 18, z), color, alpha, this.ix, this.iy); }\n  }\n  /** switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn */\n  setView(v) {\n    const w = this._view(v); if (!w) return;\n    this.baseView = w; this._applyView();\n  }\n  /**\n   * camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom\n   * (camera.zoom), theirs multiplies it (game.zoom is the two together). Characters, maps, props, particles and lights are\n   * drawn by code, so they re-rasterize crisply at the new size; HUD text and overlays stay the same.\n   */\n  setZoom(z) { this._zoomBase = clamp(+z || 1, .5, 3); this._zoomApply(true); }\n  /** turn the camera around the vertical axis in ground views: game.rotateView(45) (degrees). Side views never turn */\n  rotateView(deg) { this.yaw = (((this.yaw || 0) + deg) % 360 + 360) % 360; this._applyView(); }\n  /** undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1\n   *  without), no turn. The player's zoom stays (settings.zoom) */\n  resetCamera() { this.yaw = 0; this._zoomBase = this._zoomStart(); this._zoomApply(true); }\n  /**\n   * the player zooms the camera by a factor (1.1: 10% closer, .9: farther), as the wheel, - and = and a pinch do (a zoom\n   * button of the game's own can): within the scene's camera.zoom range, kept as their setting (settings.zoom, on top of\n   * the game's zoom), and noted at the top of the screen ('ZOOM 1.65x': the number a scene's camera.start takes). Does\n   * nothing where the scene doesn't let the player zoom. Returns the zoom\n   */\n  zoomBy(k) {\n    const R = this.zoomRange(), b = this._zoomBase; if (!R || !(k > 0) || !this._zoomStd()) return this.zoom;\n    const lo = Math.max(ZOOM_PLAYER[0], R[0] / b), hi = Math.min(ZOOM_PLAYER[1], R[1] / b); if (lo > hi) return this.zoom;\n    const f = clamp(clamp(+this.settings.zoom || 1, lo, hi) * k, lo, hi); this.settings.set('zoom', f);   // (one carried from a scene with more room starts at this one's end: every step moves it)\n    const z = this._zoomTo || this.zoom; this.note('ZOOM ' + z + 'x' + (f <= lo + 1e-9 && k < 1 ? ' MIN' : f >= hi - 1e-9 && k > 1 ? ' MAX' : ''), 1);\n    return z;\n  }\n  /** the zooms the player may take the camera to here, [min, max] (the scene's camera.zoom, or the game's; a function of\n   *  the game gives one per screen shape or level), or null where they can't (camera.zoom false or none) */\n  zoomRange() {\n    let z = (this._camera() || {}).zoom; if (typeof z === 'function') try { z = z(this); } catch (e) { this.fail('camera.zoom', e); z = null; }\n    return Array.isArray(z) && z.length === 2 && z[0] > 0 && z[1] >= z[0] ? [clamp(z[0], .5, 3), clamp(z[1], .5, 3)] : null;\n  }\n  /** true while the game's screen (r.W x r.H) is upright, taller than 1.3 times its width: a phone held upright, with\n   *  expand: true (a fixed res keeps its own shape on any phone, so it is never upright there). A scene's camera.tall zoom\n   *  applies then: it zooms a tall picture in to fill it */\n  get upright() { return this.H > this.W * 1.3; }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation.js <<'EOF'\n/* Native pixel forms, house palettes and depth-sorted actors. Draw is read-only. */\nconst E = globalThis.My3D2dge;\nconst {px, TAU}=E;\nconst C={ink:'#eceddf',dim:'#8b9ba4',teal:'#8ff4da',gold:'#f6cd7a',red:'#ff836b',blue:'#8fbdf8',space:'#071018'};\nconst palettes=[['#0a1822','#112b34','#75ddcb'],['#121526','#26233e','#bdabef'],['#201721','#3c2630','#f7ad78'],['#111c23','#1a333b','#a3ead4']];\nconst stars=Array.from({length:210},(_,i)=>{const rng=E.rng(91011+i*337);return{x:rng(),y:rng(),r:rng(),p:rng()*TAU};});\nexport function fitArena(game){\n const W=game.W,H=game.H,portrait=H>W*1.15;\n const top=portrait?Math.min(125,H*.19):67,bottom=portrait?Math.min(150,H*.22):56;\n const k=Math.min((W-44)/960,(H-top-bottom)/540);\n const cy=top+540*k/2;\n if(Math.abs((game.baseView.scale||0)-k)>.0001)game.setView(new E.View('overhead','Orbital arena',0,90,k,1));\n game.cam.offset=[0,cy-H/2];game.cam.smooth=0;game.focus(480,270,0);\n return{k,x:(W-960*k)/2,y:top,w:960*k,h:540*k,portrait};\n}\nfunction txt(g,s,x,y,c=C.ink,opt={}){E.font.text(g,String(s),x,y,c,{outline:false,shadow:'#03080d',...opt});}\nfunction lineRing(g,x,y,r,c,n=40,th=1,phase=0){for(let i=0;i<n;i++){const a=phase+i/n*TAU,b=phase+(i+.65)/n*TAU;px.line(g,x+Math.cos(a)*r,y+Math.sin(a)*r,x+Math.cos(b)*r,y+Math.sin(b)*r,c,th);}}\nfunction poly(g,x,y,points,angle,color,k=1){const cs=Math.cos(angle),sn=Math.sin(angle);px.poly(g,points.map(([a,b])=>[x+(a*cs-b*sn)*k,y+(a*sn+b*cs)*k]),color);}\nexport function drawSaucer(g,x,y,k,t,p={}){\n const tns=E.tones(p.pilot===1?'#c5a6d8':'#8badb4'),trim=p.pilot===1?C.gold:C.teal;\n const tilt=E.clamp((p.vx||0)/150,-1,1)*2*k; const bob=Math.sin(t*2.7)*1.4*k;\n y+=bob;px.ell(g,x,y+10*k,20*k,6*k,'#040a10');\n if(p.down){poly(g,x,y,[[-18,-2],[-5,-8],[9,-6],[17,5],[0,9],[-16,6]],.15,tns.deep,k);px.line(g,x-13*k,y+5*k,x+11*k,y-3*k,C.red,2*k);lineRing(g,x,y,29*k,C.gold,14);txt(g,'WRECK',x,y+32*k,C.gold,{align:'center'});return;}\n px.blend(g,.18,'add',()=>px.ell(g,x,y+7*k,27*k,10*k,trim));\n px.ell(g,x,y+4*k+tilt,23*k,11*k,tns.deep);px.ell(g,x,y+tilt,23*k,11*k,tns.sh);\n px.ell(g,x,y-3*k+tilt,21*k,9*k,tns.base);px.ell(g,x-2*k,y-5*k+tilt,18*k,7*k,tns.lt);\n px.ell(g,x,y-7*k,11*k,9*k,'#243e4c');px.ell(g,x-2*k,y-9*k,9*k,7*k,'#78c9cb');px.ell(g,x-4*k,y-11*k,5*k,3*k,'#dafff0');\n px.line(g,x-17*k,y-2*k+tilt,x-10*k,y-5*k+tilt,tns.hi,k);\n for(let i=0;i<7;i++){const a=i/7*TAU+t*.4;px.rect(g,x+Math.cos(a)*18*k-1*k,y+Math.sin(a)*6*k+3*k,3*k,2*k,Math.sin(a+t*3)>0?trim:tns.sh);}\n if(p.pilot===1){poly(g,x,y,[[-23,-4],[-29,-1],[-23,3]],0,C.gold,k);poly(g,x,y,[[23,-4],[29,-1],[23,3]],0,C.gold,k);}else{px.rect(g,x-2*k,y+6*k,4*k,4*k,C.teal);}\n const ready=\"'!(p.shield>0),fill=ready?1:Math.max(0,1-p.shield/(p.recharge||1.6));\n for(let i=0;i<28;i++){const a=i/28*TAU;const filled=i<fill*28;px.disc(g,x+Math.cos(a)*33*k,y+Math.sin(a)*33*k,Math.max(1,k*(ready?1.8:1.2)),ready?trim:filled?'\"'#617a84':'#263b45');}\n if(\"'!ready){lineRing(g,x,y,36*k,'\"'#b46a52',8,Math.max(1,k),t*.2);}\n if(p.invuln>0){lineRing(g,x,y,39*k,'#fff3c9',12,Math.max(1,2*k),t*1.4);}\n if(p.angle\"'!==undefined){const a=p.angle;px.blend(g,.3,'\"'add',()=>px.disc(g,x+Math.cos(a)*34*k,y+Math.sin(a)*34*k,5*k,'#ffffff'));px.disc(g,x+Math.cos(a)*34*k,y+Math.sin(a)*34*k,Math.max(2,3*k),'#ffffff');\n if(Math.abs(Math.atan2(Math.sin(p.targetAngle-a),Math.cos(p.targetAngle-a)))>.08){const b=p.targetAngle;poly(g,x+Math.cos(b)*43*k,y+Math.sin(b)*43*k,[[-3,-3],[3,0],[-3,3]],b,C.gold,k);}}\n}\nfunction drifter(g,x,y,k,t,e){\n const tones=E.tones(e.mergeWith||e.mergeId?'#b6a0e4':'#cf9c78'),a=(e.angle??e.rot??e.id*.4)+t*.36;\n for(let i=0;i<4;i++){const b=a+i*TAU/4;poly(g,x,y,[[5,-4],[19,-5],[19,4],[7,4]],b,tones.deep,k);poly(g,x,y,[[6,-5],[19,-5],[17,1],[6,2]],b,tones.base,k);poly(g,x,y,[[8,-4],[16,-4],[15,-2],[8,-2]],b,tones.lt,k);}\n px.disc(g,x+2*k,y+3*k,9*k,tones.deep);px.disc(g,x,y,8*k,tones.sh);px.disc(g,x-1*k,y-2*k,5*k,tones.lt);px.disc(g,x-1*k,y-2*k,2*k,C.gold);\n}\nfunction hunter(g,x,y,k,t,e){const a=e.angle||Math.atan2(e.vy||0,e.vx||1),c=e.arming>0?'#b6a0e4':'#ff856e';lineRing(g,x,y,23*k,c,8,2*k,t*.5);poly(g,x,y,[[22,0],[-9,-13],[-3,0],[-9,13]],a,'#602a37',k);poly(g,x-1*k,y-2*k,[[18,0],[-10,-11],[-5,0],[-10,11]],a,c,k);px.disc(g,x,y,5*k,'#fce3bb');}\nfunction gunship(g,x,y,k,t,e){const a=e.angle??Math.atan2(e.vy||.4,e.vx||1);poly(g,x,y,[[-32,-8],[0,-14],[35,0],[0,14],[-32,8],[-22,0]],a,'#452e42',k);poly(g,x-1*k,y-3*k,[[-28,-7],[0,-12],[31,0],[0,10],[-28,7],[-18,0]],a,'#c87783',k);poly(g,x-2*k,y-4*k,[[-12,-4],[12,-3],[20,0],[-12,3]],a,'#f4c5a4',k);for(const v of [-1,1])poly(g,x,y,[[-28,v*5],[-38-Math.sin(t*28)*5,v*6],[-28,v*9]],a,C.teal,k);}\nfunction boss(g,x,y,k,t,e){\n const phase=e.phase||1,tones=E.tones('#748b9a');lineRing(g,x,y,82*k,'#47616e',48,k,t*.08);\n for(let i=0;i<6;i++){const a=i*TAU/6+t*.08;poly(g,x,y,[[28,-13],[65,-17],[74,0],[65,17],[28,13]],a,tones.deep,k);poly(g,x,y-4*k,[[28,-12],[63,-15],[70,0],[63,12],[28,10]],a,tones.base,k);}\n px.ell(g,x,y+7*k,48*k,40*k,tones.deep);px.ell(g,x,y,46*k,37*k,tones.sh);px.ell(g,x-4*k,y-6*k,39*k,30*k,tones.lt);px.disc(g,x,y-8*k,22*k,'#1b3a49');px.disc(g,x-4*k,y-12*k,14*k,C.teal);px.disc(g,x-8*k,y-16*k,7*k,'#ebffe6');\n const components=e.components||[{x:x-65,y},{x:x+65,y},{x,y:y+62}];\n for(let i=0;i<components.length;i++){const q=components[i],qx=q.x??x+Math.cos(i*TAU/3)*64,qy=q.y??y+Math.sin(i*TAU/3)*64;const xx=x+(qx-e.x)*k,yy=y+(qy-e.y)*k;const open=q.open??q.vulnerable??e.vulnerable??true;px.disc(g,xx,yy,15*k,'#253a45');lineRing(g,xx,yy,17*k,open?C.gold:'#657481',12,2*k,t*.4);px.disc(g,xx,yy,9*k,open?'#ffc178':'#637b88');px.disc(g,xx-2*k,yy-3*k,4*k,open?'#fff3b8':'#adc0c5');}\n txt(g,'COMMAND / '+phase,x,y-94*k,C.gold,{align:'center'});\n}\nexport class Presentation{\n constructor(game){this.game=game;this.time=0;this.layout=null;this.pulses=[];this.lastEvent=0;this.titlePose={lift:0};this.debugOverlay=false;}\n update(dt,world){this.time+=dt;this.layout=fitArena(this.game);this.pulses=this.pulses.filter(p=>this.time-p.at<1.5);if(world)for(const e of world.events||[])if(e.id>this.lastEvent){this.lastEvent=e.id;if(['kill','chain','merge','fusion','damage','rescue','phase','shield','ready','warning','shot','boss-hit'].includes(e.type))this.pulses.push({...e,at:this.time});} }\n reset(){this.lastEvent=0;this.pulses=[];}\n background(r,sector=0){const t=this.game.reduceMotion?0:this.time,pal=palettes[sector%4];r.sky([pal[0],C.space,'#080f17']);r.overlay(g=>{\n // Soft stepped nebulae, far star layers, and an etched orbital chart.\n for(let i=10;i>0;i--)px.blend(g,.025,'add',()=>px.ell(g,r.W*.75+Math.sin(i)*20,r.H*.36,30+i*19,12+i*12,pal[1]));\n for(const s of stars){const xx=(s.x*r.W+t*(.25+s.r))%r.W,yy=s.y*r.H;px.rect(g,xx,yy,s.r>.88?2:1,1,s.r>.9?'#a8bbb7':s.r>.55?'#526a77':'#253846');if(s.r>.97){px.dot(g,xx,yy-2,'#526a77');px.dot(g,xx,yy+2,'#526a77');}}\n const cx=r.W*.81,cy=r.H*.26,rad=Math.min(r.W,r.H)*.22;\n for(let i=0;i<5;i++)lineRing(g,cx,cy,rad+i*5,'#172c35',72,1,.2);px.disc(g,cx,cy,rad,'#172c35');px.disc(g,cx-rad*.12,cy-rad*.12,rad*.91,'#1a333b');px.disc(g,cx-rad*.26,cy-rad*.2,rad*.69,'#213e43');\n for(let i=0;i<12;i++){const a=i*2.399;px.ell(g,cx+Math.cos(a)*rad*.55,cy+Math.sin(a)*rad*.55,rad*(.08+i%3*.03),rad*.045,'#1c363f');}\n });}\n title(r){this.background(r,0);r.overlay(g=>{const compact=r.H>r.W*1.15;const x=compact?r.W*.72:r.W*.74,y=compact?r.H*.26:r.H*.50,k=Math.min(r.W/630,r.H/380)*(compact?1.1:1.75);const t=this.game.reduceMotion?0:this.time;\n lineRing(g,x,y,95*k,'#37535a',100,k,-.3);lineRing(g,x,y,124*k,'#223b46',110,k,.2);for(let i=0;i<12;i++){const a=i*TAU/12;px.line(g,x+Math.cos(a)*118*k,y+Math.sin(a)*118*k,x+Math.cos(a)*125*k,y+Math.sin(a)*125*k,'#52716e',k);}\n drawSaucer(g,x,y,k*2.1,t,{angle:t*.45,targetAngle:t*.45,shield:0});\n drifter(g,x-85*k,y-76*k,k*.8,t,{id:3});hunter(g,x+94*k,y+55*k,k*.7,t,{angle:3.5});\n txt(g,'01 / ORBITAL DEFENCE DIVISION',compact?18:r.W*.07,25,C.teal,{scale:1});\n txt(g,'A VERY CONFIDENT LITTLE SAUCER.',x,r.H-55,C.dim,{align:'center'});txt(g,'ONE SHOT. NO SHIELD. YOUR MOVE.',x,r.H-39,C.gold,{align:'center'});\n px.rect(g,18,r.H-19,r.W-36,1,'#29424a');txt(g,'AN ARCADE FIELD MANUAL',20,r.H-12,'#6e9294');txt(g,'EST. 1981 / REIMAGINED 2026',r.W-20,r.H-12,'#6e9294',{align:'right'});\n });}\n world(r,w,{attract=false,hub=null}={}){this.background(r,w.sector||0);const L=this.layout||fitArena(this.game),t=this.game.reduceMotion?w.time:this.time,pal=palettes[(w.sector||0)%4],P=(x,y)=>[L.x+x*L.k,L.y+y*L.k];\n r.overlay(g=>{const x=L.x,y=L.y,ww=L.w,hh=L.h;px.blend(g,.83,'normal',()=>px.rect(g,x,y,ww,hh,'#07131b'));\n for(let ix=0;ix<=960;ix+=80)for(let iy=0;iy<=540;iy+=60){const [xx,yy]=P(ix,iy);px.rect(g,xx,yy,1,1,'#24414a');}\n for(let i=0;i<4;i++){const xx=x+(i%2)*ww,yy=y+Math.floor(i/2)*hh,dx=i%2?-1:1,dy=i>1?-1:1;px.line(g,xx,yy,xx+dx*24,yy,pal[2],2);px.line(g,xx,yy,xx,yy+dy*20,pal[2],2);}\n px.line(g,x+27,y,x+ww-27,y,'#2f5358');px.line(g,x+27,y+hh,x+ww-27,y+hh,'#2f5358');px.line(g,x,y+23,x,y+hh-23,'#2f5358');px.line(g,x+ww,y+23,x+ww,y+hh-23,'#2f5358');\n for(let i=0;i<12;i++){const xx=x+ww*i/12;px.rect(g,xx,y-5,8,2,i%3===0?pal[2]:'#294149');px.rect(g,xx,y+hh+4,8,2,i%3===0?pal[2]:'#294149');}\n for(const e of w.enemies||[]){if(e.type==='gunship'&&(e.warning>0||e.warn>0||e.state==='warning')){const [a,b]=P(e.x,e.y),target=(w.players||[]).find(p=>\"'!p.down)||{x:480,y:270},[c,d]=P(target.x,target.y);for(let i=0;i<20;i+=2)px.line(g,a+(c-a)*i/20,b+(d-b)*i/20,a+(c-a)*(i+1)/20,b+(d-b)*(i+1)/20,C.red);}}\n for(const f of w.fusions||[]){const a=(w.enemies||[]).find(e=>e.id===f.a),b=(w.enemies||[]).find(e=>e.id===f.b);if(a&&b)px.line(g,...P(a.x,a.y),...P(b.x,b.y),'\"'#c0a1f7',2);}\n for(const e of w.enemies||[]){const mate=(w.enemies||[]).find(m=>m.id===(e.mergeWith||e.mergeId||e.partner));if(mate)px.line(g,...P(e.x,e.y),...P(mate.x,mate.y),'#ba99ef',2);}\n for(const b of w.blasts||[]){const [xx,yy]=P(b.x,b.y),age=b.age??(w.time-(b.born??w.time)),rad=(b.radius??b.r??55)*L.k;lineRing(g,xx,yy,rad*(.3+Math.min(1,age*4)),C.gold,30,Math.max(1,3*(1-age)*L.k));}\n });\n for(const e of w.enemies||[]){if(e.dead)continue;const fn=e.type==='boss'?boss:e.type==='hunter'||e.type==='pursuer'?hunter:e.type==='gunship'?gunship:drifter;r.actor(e.x,e.y,0,(g,x,y)=>fn(g,x,y,L.k,t,e),{emissive:true});}\n for(const p of w.players||[]){r.actor(p.x,p.y,0,(g,x,y)=>drawSaucer(g,x,y,L.k,t,{...p,pilot:(w.players||[]).indexOf(p),recharge:w.balance?.recharge??w.balance?.shieldRecharge??1.6}),{emissive:true});}\n for(const b of w.bullets||[]){r.actor(b.x,b.y,0,(g,x,y)=>{const c=b.hostile?C.red:'#d6fff0';const v=Math.hypot(b.vx,b.vy)||1;px.line(g,x-b.vx/v*9*L.k,y-b.vy/v*9*L.k,x,y,c,Math.max(1,2*L.k));px.disc(g,x,y,Math.max(1,2*L.k),'#fff5d3');},{emissive:true});}\n r.overlay(g=>{for(const e of this.pulses){const age=this.time-e.at,[x,y]=P(e.x??480,e.y??270),n=e.type==='kill'?14:8;if(['kill','chain','damage','rescue','shield','merge','fusion','ready'].includes(e.type)){for(let i=0;i<n;i++){const a=i*TAU/n+e.id*.5,dist=(15+age*70)*(e.type==='chain'?1.5:1)*L.k;px.rect(g,x+Math.cos(a)*dist,y+Math.sin(a)*dist,Math.max(1,(3-age*2)*L.k),Math.max(1,(3-age*2)*L.k),e.type==='damage'?C.red:e.type==='ready'||e.type==='rescue'?C.teal:C.gold);}if(age<.45)lineRing(g,x,y,(12+age*75)*L.k,e.type==='damage'?C.red:C.gold,22,Math.max(1,3-age*4));}}\n const chains=Array.isArray(w.chains)?w.chains:Object.values(w.chains||{});for(const c of chains){const age=w.time-(c.lastTime??c.born??w.time);if((c.count||c.depth||0)>1&&age<1.5){const [x,y]=P(c.x??480,c.y??270);txt(g,\"'`CHAIN ${c.count??c.depth} / x${Math.min(8,c.depth||1)}`,x,y-30,C.gold,{align:'\"'center',scale:1});}}\n if(this.debugOverlay){for(const e of [...w.enemies,...w.players])lineRing(g,...P(e.x,e.y),(e.r||20)*L.k,'#f081cb',24);for(const p of w.players){px.line(g,...P(p.x,p.y),...P(p.x+Math.cos(p.angle)*90,p.y+Math.sin(p.angle)*90),C.gold);}}\n this.hud(g,r,w,L,attract,hub);\n });}\n hud(g,r,w,L,attract,hub){\n const sectorNames=['FIRST CONTACT','THE DRIFTING FIELD','CROSSING SIGNALS','COMMAND / EXTRACTION'];\n txt(g,'UFOh ORBIT',22,15,C.teal,{scale:2});txt(g,String(w.score||0).padStart(6,'0'),r.W/2,13,C.ink,{scale:3,align:'center'});txt(g,(w.mode==='score' || w.mode==='scoreAttack'?'SCORE ATTACK':\"'`SECTOR ${(w.sector||0)+1} / 4`),r.W-65,17,C.gold,{align:'\"'right'});\n txt(g,sectorNames[w.sector||0],22,37,C.dim);txt(g,\"'`BEST CHAIN ${w.bestChain||0}`,r.W-65,34,C.dim,{align:'\"'right'});\n if(attract){px.rect(g,r.W/2-97,47,194,17,'#e8d8ad');txt(g,'DEMO / ANY INPUT TO PILOT',r.W/2,52,'#172a31',{align:'center'});}\n else if(hub&&hub.state\"'!=='\"'running'){px.rect(g,r.W/2-105,47,210,17,'#d0edd9');txt(g,hub.state==='countdown'?'LINK READY / LAUNCH IN 3':'AI HUB / SYNCHRONISING',r.W/2,52,'#172a31',{align:'center'});}\n const bottom=L.y+L.h+16;\n (w.players||[]).forEach((p,i)=>{const x=i?r.W-188:22,c=i?C.gold:C.teal;txt(g,\"'`P${i+1}`,x,bottom,c);for(let j=0;j<3;j++){poly(g,x+26+j*11,bottom+3,[[0,-3],[4,0],[0,3],[-4,0]],0,j<p.hull?c:'\"'#33444e');}txt(g,p.down?'READY RING TO RESCUE':p.shield>0?'RECHARGING / HALF SPEED':'SHIELD READY / RAM SAFE',x,bottom+13,p.down?C.gold:p.shield>0?C.red:c);});\n const objective=w.objective||'RING READY? RAM. CANNON READY? THINK.';txt(g,objective.length>78?objective.slice(0,76)+'..':objective,r.W/2,r.H-17,C.ink,{align:'center'});\n if(w.boss&&\"'!w.boss.dead){const b=w.boss,hp=b.hp??b.health??1,max=b.maxHp??b.maxHealth??hp;E.ui.bar(g,r.W*.3,49,r.W*.4,5,Math.max(0,hp/max),C.red);}\n if(w.debug)txt(g,'\"'DEV / RECORDS DISABLED',r.W/2,64,C.red,{align:'center'});\n for(const p of w.players||[])if(p.down&&(w.players||[]).some(q=>\"'!q.down&&q.shield<=0&&Math.hypot(p.x-q.x,p.y-q.y)<100)){const [x,y]=[L.x+p.x*L.k,L.y+p.y*L.k];txt(g,'\"'READY RING: TOUCH TO RESCUE',x,y-40,C.gold,{align:'center'});}\n }\n}\nexport {C};\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation.js <<'EOF'\n/* Native pixel forms, house palettes and depth-sorted actors. Draw is read-only. */\nconst E = globalThis.My3D2dge;\nconst {px, TAU}=E;\nconst C={ink:'#eceddf',dim:'#8b9ba4',teal:'#8ff4da',gold:'#f6cd7a',red:'#ff836b',blue:'#8fbdf8',space:'#071018'};\nconst palettes=[['#0a1822','#112b34','#75ddcb'],['#121526','#26233e','#bdabef'],['#201721','#3c2630','#f7ad78'],['#111c23','#1a333b','#a3ead4']];\nconst stars=Array.from({length:210},(_,i)=>{const rng=E.rng(91011+i*337);return{x:rng(),y:rng(),r:rng(),p:rng()*TAU};});\nexport function fitArena(game){\n const W=game.W,H=game.H,portrait=H>W*1.15;\n const top=portrait?Math.min(125,H*.19):67,bottom=portrait?Math.min(150,H*.22):56;\n const k=Math.min((W-44)/960,(H-top-bottom)/540);\n const cy=top+540*k/2;\n if(Math.abs((game.baseView.scale||0)-k)>.0001)game.setView(new E.View('overhead','Orbital arena',0,90,k,1));\n game.cam.offset=[0,cy-H/2];game.cam.smooth=0;game.focus(480,270,0);\n return{k,x:(W-960*k)/2,y:top,w:960*k,h:540*k,portrait};\n}\nfunction txt(g,s,x,y,c=C.ink,opt={}){E.font.text(g,String(s),x,y,c,{outline:false,shadow:'#03080d',...opt});}\nfunction lineRing(g,x,y,r,c,n=40,th=1,phase=0){for(let i=0;i<n;i++){const a=phase+i/n*TAU,b=phase+(i+.65)/n*TAU;px.line(g,x+Math.cos(a)*r,y+Math.sin(a)*r,x+Math.cos(b)*r,y+Math.sin(b)*r,c,th);}}\nfunction poly(g,x,y,points,angle,color,k=1){const cs=Math.cos(angle),sn=Math.sin(angle);px.poly(g,points.map(([a,b])=>[x+(a*cs-b*sn)*k,y+(a*sn+b*cs)*k]),color);}\nexport function drawSaucer(g,x,y,k,t,p={}){\n const tns=E.tones(p.pilot===1?'#c5a6d8':'#8badb4'),trim=p.pilot===1?C.gold:C.teal;\n const tilt=E.clamp((p.vx||0)/150,-1,1)*2*k; const bob=Math.sin(t*2.7)*1.4*k;\n y+=bob;px.ell(g,x,y+10*k,20*k,6*k,'#040a10');\n if(p.down){poly(g,x,y,[[-18,-2],[-5,-8],[9,-6],[17,5],[0,9],[-16,6]],.15,tns.deep,k);px.line(g,x-13*k,y+5*k,x+11*k,y-3*k,C.red,2*k);lineRing(g,x,y,29*k,C.gold,14);txt(g,'WRECK',x,y+32*k,C.gold,{align:'center'});return;}\n px.blend(g,.18,'add',()=>px.ell(g,x,y+7*k,27*k,10*k,trim));\n px.ell(g,x,y+4*k+tilt,23*k,11*k,tns.deep);px.ell(g,x,y+tilt,23*k,11*k,tns.sh);\n px.ell(g,x,y-3*k+tilt,21*k,9*k,tns.base);px.ell(g,x-2*k,y-5*k+tilt,18*k,7*k,tns.lt);\n px.ell(g,x,y-7*k,11*k,9*k,'#243e4c');px.ell(g,x-2*k,y-9*k,9*k,7*k,'#78c9cb');px.ell(g,x-4*k,y-11*k,5*k,3*k,'#dafff0');\n px.line(g,x-17*k,y-2*k+tilt,x-10*k,y-5*k+tilt,tns.hi,k);\n for(let i=0;i<7;i++){const a=i/7*TAU+t*.4;px.rect(g,x+Math.cos(a)*18*k-1*k,y+Math.sin(a)*6*k+3*k,3*k,2*k,Math.sin(a+t*3)>0?trim:tns.sh);}\n if(p.pilot===1){poly(g,x,y,[[-23,-4],[-29,-1],[-23,3]],0,C.gold,k);poly(g,x,y,[[23,-4],[29,-1],[23,3]],0,C.gold,k);}else{px.rect(g,x-2*k,y+6*k,4*k,4*k,C.teal);}\n const ready=\"'!(p.shield>0),fill=ready?1:Math.max(0,1-p.shield/(p.recharge||1.6));\n for(let i=0;i<28;i++){const a=i/28*TAU;const filled=i<fill*28;px.disc(g,x+Math.cos(a)*33*k,y+Math.sin(a)*33*k,Math.max(1,k*(ready?1.8:1.2)),ready?trim:filled?'\"'#617a84':'#263b45');}\n if(\"'!ready){lineRing(g,x,y,36*k,'\"'#b46a52',8,Math.max(1,k),t*.2);}\n if(p.invuln>0){lineRing(g,x,y,39*k,'#fff3c9',12,Math.max(1,2*k),t*1.4);}\n if(p.angle\"'!==undefined){const a=p.angle;px.blend(g,.3,'\"'add',()=>px.disc(g,x+Math.cos(a)*34*k,y+Math.sin(a)*34*k,5*k,'#ffffff'));px.disc(g,x+Math.cos(a)*34*k,y+Math.sin(a)*34*k,Math.max(2,3*k),'#ffffff');\n if(Math.abs(Math.atan2(Math.sin(p.targetAngle-a),Math.cos(p.targetAngle-a)))>.08){const b=p.targetAngle;poly(g,x+Math.cos(b)*43*k,y+Math.sin(b)*43*k,[[-3,-3],[3,0],[-3,3]],b,C.gold,k);}}\n}\nfunction drifter(g,x,y,k,t,e){\n const tones=E.tones(e.mergeWith||e.mergeId?'#b6a0e4':'#cf9c78'),a=(e.angle??e.rot??e.id*.4)+t*.36;\n for(let i=0;i<4;i++){const b=a+i*TAU/4;poly(g,x,y,[[5,-4],[19,-5],[19,4],[7,4]],b,tones.deep,k);poly(g,x,y,[[6,-5],[19,-5],[17,1],[6,2]],b,tones.base,k);poly(g,x,y,[[8,-4],[16,-4],[15,-2],[8,-2]],b,tones.lt,k);}\n px.disc(g,x+2*k,y+3*k,9*k,tones.deep);px.disc(g,x,y,8*k,tones.sh);px.disc(g,x-1*k,y-2*k,5*k,tones.lt);px.disc(g,x-1*k,y-2*k,2*k,C.gold);\n}\nfunction hunter(g,x,y,k,t,e){const a=e.angle||Math.atan2(e.vy||0,e.vx||1),c=e.arming>0?'#b6a0e4':'#ff856e';lineRing(g,x,y,23*k,c,8,2*k,t*.5);poly(g,x,y,[[22,0],[-9,-13],[-3,0],[-9,13]],a,'#602a37',k);poly(g,x-1*k,y-2*k,[[18,0],[-10,-11],[-5,0],[-10,11]],a,c,k);px.disc(g,x,y,5*k,'#fce3bb');}\nfunction gunship(g,x,y,k,t,e){const a=e.angle??Math.atan2(e.vy||.4,e.vx||1);poly(g,x,y,[[-32,-8],[0,-14],[35,0],[0,14],[-32,8],[-22,0]],a,'#452e42',k);poly(g,x-1*k,y-3*k,[[-28,-7],[0,-12],[31,0],[0,10],[-28,7],[-18,0]],a,'#c87783',k);poly(g,x-2*k,y-4*k,[[-12,-4],[12,-3],[20,0],[-12,3]],a,'#f4c5a4',k);for(const v of [-1,1])poly(g,x,y,[[-28,v*5],[-38-Math.sin(t*28)*5,v*6],[-28,v*9]],a,C.teal,k);}\nfunction boss(g,x,y,k,t,e){\n const phase=e.phase||1,tones=E.tones('#748b9a');lineRing(g,x,y,82*k,'#47616e',48,k,t*.08);\n for(let i=0;i<6;i++){const a=i*TAU/6+t*.08;poly(g,x,y,[[28,-13],[65,-17],[74,0],[65,17],[28,13]],a,tones.deep,k);poly(g,x,y-4*k,[[28,-12],[63,-15],[70,0],[63,12],[28,10]],a,tones.base,k);}\n px.ell(g,x,y+7*k,48*k,40*k,tones.deep);px.ell(g,x,y,46*k,37*k,tones.sh);px.ell(g,x-4*k,y-6*k,39*k,30*k,tones.lt);px.disc(g,x,y-8*k,22*k,'#1b3a49');px.disc(g,x-4*k,y-12*k,14*k,C.teal);px.disc(g,x-8*k,y-16*k,7*k,'#ebffe6');\n const components=e.components||[{x:x-65,y},{x:x+65,y},{x,y:y+62}];\n for(let i=0;i<components.length;i++){const q=components[i],qx=q.x??x+Math.cos(i*TAU/3)*64,qy=q.y??y+Math.sin(i*TAU/3)*64;const xx=x+(qx-e.x)*k,yy=y+(qy-e.y)*k;const open=q.open??q.vulnerable??e.vulnerable??true;px.disc(g,xx,yy,15*k,'#253a45');lineRing(g,xx,yy,17*k,open?C.gold:'#657481',12,2*k,t*.4);px.disc(g,xx,yy,9*k,open?'#ffc178':'#637b88');px.disc(g,xx-2*k,yy-3*k,4*k,open?'#fff3b8':'#adc0c5');}\n txt(g,'COMMAND / '+phase,x,y-94*k,C.gold,{align:'center'});\n}\nexport class Presentation{\n constructor(game){this.game=game;this.time=0;this.layout=null;this.pulses=[];this.lastEvent=0;this.titlePose={lift:0};this.debugOverlay=false;}\n update(dt,world){this.time+=dt;this.layout=fitArena(this.game);this.pulses=this.pulses.filter(p=>this.time-p.at<1.5);if(world)for(const e of world.events||[])if(e.id>this.lastEvent){this.lastEvent=e.id;if(['kill','chain','merge','fusion','damage','rescue','phase','shield','ready','warning','shot','boss-hit'].includes(e.type))this.pulses.push({...e,at:this.time});} }\n reset(){this.lastEvent=0;this.pulses=[];}\n background(r,sector=0){const t=this.game.reduceMotion?0:this.time,pal=palettes[sector%4];r.sky([pal[0],C.space,'#080f17']);r.overlay(g=>{\n // Soft stepped nebulae, far star layers, and an etched orbital chart.\n for(let i=10;i>0;i--)px.blend(g,.025,'add',()=>px.ell(g,r.W*.75+Math.sin(i)*20,r.H*.36,30+i*19,12+i*12,pal[1]));\n for(const s of stars){const xx=(s.x*r.W+t*(.25+s.r))%r.W,yy=s.y*r.H;px.rect(g,xx,yy,s.r>.88?2:1,1,s.r>.9?'#a8bbb7':s.r>.55?'#526a77':'#253846');if(s.r>.97){px.dot(g,xx,yy-2,'#526a77');px.dot(g,xx,yy+2,'#526a77');}}\n const cx=r.W*.81,cy=r.H*.26,rad=Math.min(r.W,r.H)*.22;\n for(let i=0;i<5;i++)lineRing(g,cx,cy,rad+i*5,'#172c35',72,1,.2);px.disc(g,cx,cy,rad,'#172c35');px.disc(g,cx-rad*.12,cy-rad*.12,rad*.91,'#1a333b');px.disc(g,cx-rad*.26,cy-rad*.2,rad*.69,'#213e43');\n for(let i=0;i<12;i++){const a=i*2.399;px.ell(g,cx+Math.cos(a)*rad*.55,cy+Math.sin(a)*rad*.55,rad*(.08+i%3*.03),rad*.045,'#1c363f');}\n });}\n title(r){this.background(r,0);r.overlay(g=>{const compact=r.H>r.W*1.15;const x=compact?r.W*.72:r.W*.74,y=compact?r.H*.26:r.H*.50,k=Math.min(r.W/630,r.H/380)*(compact?1.1:1.75);const t=this.game.reduceMotion?0:this.time;\n lineRing(g,x,y,95*k,'#37535a',100,k,-.3);lineRing(g,x,y,124*k,'#223b46',110,k,.2);for(let i=0;i<12;i++){const a=i*TAU/12;px.line(g,x+Math.cos(a)*118*k,y+Math.sin(a)*118*k,x+Math.cos(a)*125*k,y+Math.sin(a)*125*k,'#52716e',k);}\n drawSaucer(g,x,y,k*2.1,t,{angle:t*.45,targetAngle:t*.45,shield:0});\n drifter(g,x-85*k,y-76*k,k*.8,t,{id:3});hunter(g,x+94*k,y+55*k,k*.7,t,{angle:3.5});\n txt(g,'01 / ORBITAL DEFENCE DIVISION',compact?18:r.W*.07,25,C.teal,{scale:1});\n txt(g,'A VERY CONFIDENT LITTLE SAUCER.',x,r.H-55,C.dim,{align:'center'});txt(g,'ONE SHOT. NO SHIELD. YOUR MOVE.',x,r.H-39,C.gold,{align:'center'});\n px.rect(g,18,r.H-19,r.W-36,1,'#29424a');txt(g,'AN ARCADE FIELD MANUAL',20,r.H-12,'#6e9294');txt(g,'EST. 1981 / REIMAGINED 2026',r.W-20,r.H-12,'#6e9294',{align:'right'});\n });}\n world(r,w,{attract=false,hub=null}={}){this.background(r,w.sector||0);const L=this.layout||fitArena(this.game),t=this.game.reduceMotion?w.time:this.time,pal=palettes[(w.sector||0)%4],P=(x,y)=>[L.x+x*L.k,L.y+y*L.k];\n r.overlay(g=>{const x=L.x,y=L.y,ww=L.w,hh=L.h;px.blend(g,.83,'normal',()=>px.rect(g,x,y,ww,hh,'#07131b'));\n for(let ix=0;ix<=960;ix+=80)for(let iy=0;iy<=540;iy+=60){const [xx,yy]=P(ix,iy);px.rect(g,xx,yy,1,1,'#24414a');}\n for(let i=0;i<4;i++){const xx=x+(i%2)*ww,yy=y+Math.floor(i/2)*hh,dx=i%2?-1:1,dy=i>1?-1:1;px.line(g,xx,yy,xx+dx*24,yy,pal[2],2);px.line(g,xx,yy,xx,yy+dy*20,pal[2],2);}\n px.line(g,x+27,y,x+ww-27,y,'#2f5358');px.line(g,x+27,y+hh,x+ww-27,y+hh,'#2f5358');px.line(g,x,y+23,x,y+hh-23,'#2f5358');px.line(g,x+ww,y+23,x+ww,y+hh-23,'#2f5358');\n for(let i=0;i<12;i++){const xx=x+ww*i/12;px.rect(g,xx,y-5,8,2,i%3===0?pal[2]:'#294149');px.rect(g,xx,y+hh+4,8,2,i%3===0?pal[2]:'#294149');}\n for(const e of w.enemies||[]){if(e.type==='gunship'&&(e.warning>0||e.warn>0||e.state==='warning')){const [a,b]=P(e.x,e.y),target=(w.players||[]).find(p=>\"'!p.down)||{x:480,y:270},[c,d]=P(target.x,target.y);for(let i=0;i<20;i+=2)px.line(g,a+(c-a)*i/20,b+(d-b)*i/20,a+(c-a)*(i+1)/20,b+(d-b)*(i+1)/20,C.red);}}\n for(const f of w.fusions||[]){const a=(w.enemies||[]).find(e=>e.id===f.a),b=(w.enemies||[]).find(e=>e.id===f.b);if(a&&b)px.line(g,...P(a.x,a.y),...P(b.x,b.y),'\"'#c0a1f7',2);}\n for(const e of w.enemies||[]){const mate=(w.enemies||[]).find(m=>m.id===(e.mergeWith||e.mergeId||e.partner));if(mate)px.line(g,...P(e.x,e.y),...P(mate.x,mate.y),'#ba99ef',2);}\n for(const b of w.blasts||[]){const [xx,yy]=P(b.x,b.y),age=b.age??(w.time-(b.born??w.time)),rad=(b.radius??b.r??55)*L.k;lineRing(g,xx,yy,rad*(.3+Math.min(1,age*4)),C.gold,30,Math.max(1,3*(1-age)*L.k));}\n });\n for(const e of w.enemies||[]){if(e.dead)continue;const fn=e.type==='boss'?boss:e.type==='hunter'||e.type==='pursuer'?hunter:e.type==='gunship'?gunship:drifter;r.actor(e.x,e.y,0,(g,x,y)=>fn(g,x,y,L.k,t,e),{emissive:true});}\n for(const p of w.players||[]){r.actor(p.x,p.y,0,(g,x,y)=>drawSaucer(g,x,y,L.k,t,{...p,pilot:(w.players||[]).indexOf(p),recharge:w.balance?.recharge??w.balance?.shieldRecharge??1.6}),{emissive:true});}\n for(const b of w.bullets||[]){r.actor(b.x,b.y,0,(g,x,y)=>{const c=b.hostile?C.red:'#d6fff0';const v=Math.hypot(b.vx,b.vy)||1;px.line(g,x-b.vx/v*9*L.k,y-b.vy/v*9*L.k,x,y,c,Math.max(1,2*L.k));px.disc(g,x,y,Math.max(1,2*L.k),'#fff5d3');},{emissive:true});}\n r.overlay(g=>{for(const e of this.pulses){const age=this.time-e.at,[x,y]=P(e.x??480,e.y??270),n=e.type==='kill'?14:8;if(['kill','chain','damage','rescue','shield','merge','fusion','ready'].includes(e.type)){for(let i=0;i<n;i++){const a=i*TAU/n+e.id*.5,dist=(15+age*70)*(e.type==='chain'?1.5:1)*L.k;px.rect(g,x+Math.cos(a)*dist,y+Math.sin(a)*dist,Math.max(1,(3-age*2)*L.k),Math.max(1,(3-age*2)*L.k),e.type==='damage'?C.red:e.type==='ready'||e.type==='rescue'?C.teal:C.gold);}if(age<.45)lineRing(g,x,y,(12+age*75)*L.k,e.type==='damage'?C.red:C.gold,22,Math.max(1,3-age*4));}}\n const chains=Array.isArray(w.chains)?w.chains:Object.values(w.chains||{});for(const c of chains){const age=w.time-(c.lastTime??c.born??w.time);if((c.count||c.depth||0)>1&&age<1.5){const [x,y]=P(c.x??480,c.y??270);txt(g,\"'`CHAIN ${c.count??c.depth} / x${Math.min(8,c.depth||1)}`,x,y-30,C.gold,{align:'\"'center',scale:1});}}\n if(this.debugOverlay){for(const e of [...w.enemies,...w.players])lineRing(g,...P(e.x,e.y),(e.r||20)*L.k,'#f081cb',24);for(const p of w.players){px.line(g,...P(p.x,p.y),...P(p.x+Math.cos(p.angle)*90,p.y+Math.sin(p.angle)*90),C.gold);}}\n this.hud(g,r,w,L,attract,hub);\n });}\n hud(g,r,w,L,attract,hub){\n const sectorNames=['FIRST CONTACT','THE DRIFTING FIELD','CROSSING SIGNALS','COMMAND / EXTRACTION'];\n txt(g,'UFOh ORBIT',22,15,C.teal,{scale:2});txt(g,String(w.score||0).padStart(6,'0'),r.W/2,13,C.ink,{scale:3,align:'center'});txt(g,(w.mode==='score' || w.mode==='scoreAttack'?'SCORE ATTACK':\"'`SECTOR ${(w.sector||0)+1} / 4`),r.W-65,17,C.gold,{align:'\"'right'});\n txt(g,sectorNames[w.sector||0],22,37,C.dim);txt(g,\"'`BEST CHAIN ${w.bestChain||0}`,r.W-65,34,C.dim,{align:'\"'right'});\n if(attract){px.rect(g,r.W/2-97,47,194,17,'#e8d8ad');txt(g,'DEMO / ANY INPUT TO PILOT',r.W/2,52,'#172a31',{align:'center'});}\n else if(hub&&hub.state\"'!=='\"'running'){px.rect(g,r.W/2-105,47,210,17,'#d0edd9');txt(g,hub.state==='countdown'?'LINK READY / LAUNCH IN 3':'AI HUB / SYNCHRONISING',r.W/2,52,'#172a31',{align:'center'});}\n const bottom=L.y+L.h+16;\n (w.players||[]).forEach((p,i)=>{const x=i?r.W-188:22,c=i?C.gold:C.teal;txt(g,\"'`P${i+1}`,x,bottom,c);for(let j=0;j<3;j++){poly(g,x+26+j*11,bottom+3,[[0,-3],[4,0],[0,3],[-4,0]],0,j<p.hull?c:'\"'#33444e');}txt(g,p.down?'READY RING TO RESCUE':p.shield>0?'RECHARGING / HALF SPEED':'SHIELD READY / RAM SAFE',x,bottom+13,p.down?C.gold:p.shield>0?C.red:c);});\n const objective=w.objective||'RING READY? RAM. CANNON READY? THINK.';txt(g,objective.length>78?objective.slice(0,76)+'..':objective,r.W/2,r.H-17,C.ink,{align:'center'});\n if(w.boss&&\"'!w.boss.dead){const b=w.boss,hp=b.hp??b.health??1,max=b.maxHp??b.maxHealth??hp;E.ui.bar(g,r.W*.3,49,r.W*.4,5,Math.max(0,hp/max),C.red);}\n if(w.debug)txt(g,'\"'DEV / RECORDS DISABLED',r.W/2,64,C.red,{align:'center'});\n for(const p of w.players||[])if(p.down&&(w.players||[]).some(q=>\"'!q.down&&q.shield<=0&&Math.hypot(p.x-q.x,p.y-q.y)<100)){const [x,y]=[L.x+p.x*L.k,L.y+p.y*L.k];txt(g,'\"'READY RING: TOUCH TO RESCUE',x,y-40,C.gold,{align:'center'});}\n }\n}\nexport {C};\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > src/controls.js <<'EOF'\nconst E=globalThis.My3D2dge;\nexport const NEUTRAL=Object.freeze({mx:0,my:0,ax:0,ay:0,aim:false,fire:false});\nexport const INPUT={...E.Input.SHMUP,fire:['Space','KeyZ','KeyJ','Mouse0','Pad7','Pad0'],pause:['Escape','KeyP','Pad9'],confirm:['Enter','Space','KeyJ','Pad0'],cancel:['Escape','Backspace','KeyX','Pad1']};\nexport class Controls{\n constructor(game,{activity,cancelAttract,isPlaying,isAttract,onUnlock}){this.game=game;this.activity=activity;this.isPlaying=isPlaying;this.isAttract=isAttract;this.cancelAttract=cancelAttract;this.contacts=new Map();this.touchMove=null;this.touchAim=null;this.blockUntil=0;this.lastTouch=false;\n const signal=game._abort?.signal;\n const raw=e=>{if(e.type==='pointermove'&&e.pointerType==='mouse'&&Math.hypot(e.movementX||0,e.movementY||0)<3)return;this.activity();if(e.type==='keydown'||e.type==='pointerdown')onUnlock();if(isAttract()){e.preventDefault();e.stopImmediatePropagation();this.cancelAttract();this.clear();this.blockUntil=game.real+.18;}};\n for(const t of ['keydown','pointerdown','pointermove','wheel'])window.addEventListener(t,raw,{capture:true,passive:false,signal});\n const canvas=game.screen.canvas;\n const touch=e=>{if(e.pointerType==='mouse'||\"'!isPlaying()||game.shell?.screen)return;if(isAttract())return;e.preventDefault();e.stopImmediatePropagation();this.activity();onUnlock();game.input.lastDevice='\"'touch';this.lastTouch=true;\n const rc=canvas.getBoundingClientRect(),x=e.clientX-rc.left,y=e.clientY-rc.top;\n if(e.type==='pointerdown'){const side=x<rc.width*.5?'move':'aim';if([...this.contacts.values()].some(p=>p.side===side))return;this.contacts.set(e.pointerId,{side,x0:x,y0:y,x,y});canvas.setPointerCapture?.(e.pointerId);}\n else if(e.type==='pointermove'){const p=this.contacts.get(e.pointerId);if(p){p.x=x;p.y=y;}}\n else this.contacts.delete(e.pointerId);\n this.touchMove=[...this.contacts.values()].find(p=>p.side==='move')||null;this.touchAim=[...this.contacts.values()].find(p=>p.side==='aim')||null;\n };\n for(const t of ['pointerdown','pointermove','pointerup','pointercancel','lostpointercapture'])canvas.addEventListener(t,touch,{capture:true,passive:false,signal});\n window.addEventListener('blur',()=>this.clear(),{signal});document.addEventListener('visibilitychange',()=>{if(document.hidden)this.clear();},{signal});\n // Native touch gestures are replaced with two invisible, independently owned sticks.\n game.input.touchEnabled=false;\n }\n clear(){this.contacts.clear();this.touchMove=this.touchAim=null;for(const I of this.game.players||[this.game.input])I.clear();}\n padActivity(){const pads=[...navigator.getGamepads?.()||[]].filter(Boolean);const meaningful=pads.some(p=>p.buttons.some((b,i)=>b.pressed&&i\"'!==16)||p.axes.some(a=>Math.abs(a)>.25));if(meaningful){this.activity();if(this.isAttract()){this.cancelAttract();this.clear();this.blockUntil=this.game.real+.25;return true;}}return false;}\n intent(world,index=0){const I=(this.game.players||[this.game.input])[index]||this.game.input;if(this.game.real<this.blockUntil||this.game.shell?.screen||this.game.paused)return {...NEUTRAL};let [mx,my]=I.move();let ax=0,ay=0,aim=false,fire=I.down('\"'fire');const p=world?.players?.[index];\n if(I.padAim&&Math.hypot(...I.padAim)>.08){[ax,ay]=I.padAim;aim=true;}\n else if(index===0&&I.aimSource==='mouse'&&I.mouse.active&&p){const pos=this.game.mouseGround();if(pos){ax=pos[0]-p.x;ay=pos[1]-p.y;aim=Math.hypot(ax,ay)>4;}}\n if(index===0&&(this.touchMove||this.touchAim||I.lastDevice==='touch')){const vec=p=>{if(\"'!p)return[0,0];const x=(p.x-p.x0)/48,y=(p.y-p.y0)/48,n=Math.max(1,Math.hypot(x,y));return[x/n,y/n];};[mx,my]=vec(this.touchMove);const v=vec(this.touchAim);if(Math.hypot(...v)>.13){[ax,ay]=v;aim=true;fire=world.time%2.35<.40;}else if(p){let best=null,d=Infinity;for(const e of world.enemies||[]){if(e.dead)continue;const dd=Math.hypot(e.x-p.x,e.y-p.y);if(dd<d){d=dd;best=e;}}if(best){ax=best.x-p.x;ay=best.y-p.y;aim=true;fire=d<420&&p.shield<=0&&world.time%2.35<.25;}}}\n return{mx,my,ax,ay,aim,fire};}\n pairing(kind){const g=this.game;for(const I of [...g.players].slice(1))g.removePlayer(I.player);const pads=[...navigator.getGamepads?.()||[]].filter(p=>p&&p.connected);\n if(kind==='\"'two-pad'){if(pads.length<2)return'Two controllers are needed. Connect both and press a face button.';g.input.pad=pads[0].index;g.addPlayer({pad:pads[1].index});}\n else if(kind==='keyboard-pad'){if(\"'!pads.length)return'\"'Connect a controller and press a face button. Pilot 1 uses keyboard and mouse.';g.input.pad=null;g.addPlayer({pad:pads[0].index});}\n else if(kind==='keyboard'){g.input.pad=null;g.addPlayer({keys:'right'});}\n else g.input.pad='any';\n for(const I of g.players){I.touchEnabled=false;I.clear();}return null;}\n prompt(){const I=this.game.input;return I.lastDevice==='touch'?'LEFT THUMB MOVE / RIGHT THUMB AIM':I.lastDevice==='gamepad'?\"'`L MOVE / R AIM / ${I.label('\"'fire')} FIRE / OPTIONS MENU\"'`:'\"'WASD MOVE / MOUSE AIM / CLICK OR SPACE FIRE / ESC MENU';}\n}\nEOF\ncat > src/storage.js <<'EOF'\nconst KEY='ufoh-orbit:records:v1';\nexport class Records{\n constructor(storage){this.storage=storage;this.data={v:1,mission:[],score:[],name:'PILOT '};this.available=true;try{const s=storage??globalThis.localStorage;this.storage=s;const raw=JSON.parse(s?.getItem(KEY)||'null');if(raw?.v===1){for(const m of ['mission','score'])this.data[m]=(Array.isArray(raw[m])?raw[m]:[]).filter(r=>r&&Number.isFinite(r.score)&&r.score>=0&&typeof r.name==='string').slice(0,5);this.data.name=typeof raw.name==='string'?raw.name.slice(0,6).padEnd(6,' '):'PILOT ';}}catch{this.available=false;}}\n best(mode){return this.data[mode==='mission'?'mission':'score'][0]?.score||0;}\n add(mode,name,score,{debug=false,attract=false}={}){if(debug||attract||\"'!Number.isFinite(score))return false;const m=mode==='\"'mission'?'mission':'score',entry={name:String(name).toUpperCase().replace(/[\"'^A-Z0-9 ]/g,'\"'').slice(0,6).padEnd(6,' '),score:Math.max(0,Math.round(score))};this.data.name=entry.name;this.data[m].push(entry);this.data[m].sort((a,b)=>b.score-a.score);this.data[m]=this.data[m].slice(0,5);try{this.storage?.setItem(KEY,JSON.stringify(this.data));}catch{this.available=false;}return true;}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
