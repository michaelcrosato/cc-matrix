e; }\n};\n// text helpers\nG.ui.text = (g, s, x, y, c = '#ffffff', o = {}) => E.font.text(g, s, Math.round(x), Math.round(y), c, Object.assign({ outline: false, shadow: '#000' }, o));\nG.ui.wrapText = (g, s, x, y, w, c = '#e8e4f0', lh = 10, o = {}) => { const lines = E.font.wrap(s, w); lines.forEach((l, i) => G.ui.text(g, l, x, y + i * lh, c, o)); return lines.length * lh; };\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9952,"cache_read_input_tokens":458152,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9952},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ba7a3b6-c05c-41f2-add8-99edaaa21587","uuid":"433e67e8-e572-4180-a2c1-2d2802fec5f3","timestamp":"2026-11-04T12:39:54.997Z","request_id":"req_011CghuEcNuFYss9CmaCfBa4","wire_tool_inputs":{"toolu_01VJDRK7QosPJvVE4N6fQDyZ":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-050223__x7910ab/work/BrigantimeTheLegendOfForseasons-BrigandineTheLegendOfForsena-claude-opus-5-5-medium-20261104-050223/src/50-ui.js","content":"/* ---- UI KIT: 10-foot widgets and the focus model (d-pad, stick, hover, click), glyphs that follow the last device,\n * the input preset, idle tracking (attract) and touch-only detection ---- */\nG.INPUT = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  confirm: ['Enter', 'NumpadEnter', 'Pad0'], cancel: ['Escape', 'Backspace', 'Pad1', 'Mouse2'], command: ['Space', 'Pad2'], info: ['KeyI', 'Pad3', 'Mouse1'],\n  prev: ['PageUp', 'Comma', 'Pad4'], next: ['Tab', 'PageDown', 'Period', 'Pad5'], zoomOut: ['Pad6'], zoomIn: ['Pad7'], danger: ['KeyT', 'Pad10'],\n  turnL: ['Ke