(); }\n    let a, guard = 0;\n    while (!S.over && guard++ < 60 && (a = this.nextAttack())) {\n      if (a.kind === 'open') { log.push({ kind: 'open', castle: a.march.target, realm: a.march.realm }); if (S.realms[a.march.realm].human) evAll('capture', a.march.realm, { castle: a.march.target }); }\n      else {\n        const sim = G.BattleSim.create(this.battleSpec(a, G.Rng.int(S.rng, 1, 1e9))), res = G.BattleAI.resolve(sim, o), out = this.applyBattle(a, res); log.push({ kind: 'battle', out });\n        const h = S.realms[out.attacker].human ? out.attacker : S.realms[out.defender] && S.realms[out.defender].human ? out.defender : null;\n        if (h) { evAll('afterBattle', h, { won: (h === out.attacker) === out.won, sanctum: a.kind === 'sanctum' }); if (out.won && h === out.attacker && a.kind !== 'sanctum') evAll('capture', h, { castle: out.castle }); }\n      }\n      if (S.flags.sanctumPending && !S.over) { const r = S.flags.sanctumPending; S.flags.sanctumPending = null; const ks = S.castles.meridian.knights.filter(k => this.kn(k).realm === r && this.kn(k).hp > 0).slice(0, 3); if (ks.length) S.queue.unshift({ realm: r, target: 'sanctum', knights: ks, from: {} }); }\n    }\n    if (!S.over) this.endSeason();\n    return log;\n  }\n  // the season label\"\"\"\nassert old in s; s=s.replace(old,new,1); open(p,'w').write(s)\nEOF\ncat > tests/t-campaign.mjs <<'EOF'\n// campaign: phases cycle, economy, muster rules, AI-only campaigns reach an end, determinism, save round trip\nexport default async ({ boot, t }) => {\n  const { G } = boot();\n  await t('a new campaign has 25 castles and 36 roads', () => { const s = G.CampaignSim.create({ humans: ['verdance'], seed: 3 }); if (Object.keys(s.state.castles).length !== 25) throw new Error('castles'); if (G.ROADS.length !== 36) throw new Error('roads ' + G.ROADS.length); });\n  await t('summon pays mana and fills the reserve', () => { const s = G.CampaignSim.create({ humans: ['verdance'], seed: 3 }); s.beginSeason(); const m0 