onst a = G.CampaignSim.create({ humans: ['solmark'], seed: 5 }), b = G.CampaignSim.create({ humans: ['solmark'], seed: 5 }); for (let i = 0; i < 6; i++) { a.autoSeason(); b.autoSeason(); } if (a.hash() !== b.hash()) throw new Error('differ'); });\n  await t('save round trip keeps the hash', () => { const a = G.CampaignSim.create({ humans: ['hoarfast'], seed: 8 }); for (let i = 0; i < 5; i++) a.autoSeason(); const b = G.CampaignSim.load(JSON.stringify(a.serialize())); if (a.hash() !== b.hash()) throw new Error('differ'); a.autoSeason(); b.autoSeason(); if (a.hash() !== b.hash()) throw new Error('diverge'); });\n  await t('the Dominion stays home in Year 1', () => { const s = G.CampaignSim.create({ humans: [], seed: 4 }); for (let i = 0; i < 4; i++) { const log = s.autoSeason(); for (const l of log) if (l.kind === 'battle' && l.out.attacker === 'dominion') throw new Error('dominion attacked in year 1'); } });\n  for (const r of ['verdance', 'solmark', 'amberlyn', 'hoarfast']) await t('autoplay ' + r + ' plays to an end', () => { G.tune.aiPlayerBoost = .6; const s = G.CampaignSim.create({ humans: [r], seed: 21 }); let n = 0; while (!s.state.over && n++ < 30) s.autoSeason(); G.tune.aiPlayerBoost = 0; if (!s.state.over) throw new Error('no end'); s._end = s.state.over; });\n};\nEOF\nnode tests/run.mjs campaign","description":"Add autoplay season driver and campaign suite"}}}
